"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn builders_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn builders_one_param(a: Type) -> Array[Type] {\n  let arr = builders_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn builders_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = builders_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn lookup_array_builder_new(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::new\" {\n    Some(CtFn(builders_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_array_builder_push(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::push\" {\n    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_string_builder_new(name: String) -> Option[Type] {\n  if name == \"StringBuilder::new\" {\n    Some(CtFn(builders_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_string_builder_push(name: String) -> Option[Type] {\n  if name == \"StringBuilder::push\" {\n    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_builder_freeze(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::freeze\" {\n    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nexport fn lookup_array_builder(name: String) -> Option[Type] {\n  match lookup_array_builder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_builder_push(name) {\n      Some(t) => Some(t),\n      None => lookup_array_builder_freeze(name)\n    }\n  }\n}\n\nfn lookup_string_builder_freeze(name: String) -> Option[Type] {\n  if name == \"StringBuilder::freeze\" {\n    Some(CtFn(builders_one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nexport fn lookup_string_builder(name: String) -> Option[Type] {\n  match lookup_string_builder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_builder_push(name) {\n      Some(t) => Some(t),\n      None => lookup_string_builder_freeze(name)\n    }\n  }\n}\n")
}

let source_50 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_async.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn async_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn lookup_future(name: String) -> Option[Type] {\n  if name == \"await\" {\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Future::ready\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Future::pending\" {\n    Some(CtFn(async_no_params(), CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"host_future_get\" {\n    Some(CtFn(async_no_params(), CtNamed(\"Future\", [\n      CtInt\n    ]), None))\n  } else if name == \"host_future_named\" {\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"Future\", [\n      CtInt\n    ]), None))\n  } else if name == \"Future::resolve\" {\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtUnit, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_stream(name: String) -> Option[Type] {\n  if name == \"Stream::empty\" {\n    Some(CtFn(async_no_params(), CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::once\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::next\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ])\n    ], CtNamed(\"Future\", [\n      CtOption(CtUnknown)\n    ]), Some(\"Async\")))\n  } else if name == \"host_stream_named\" {\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"HostStream\", array_empty()), None))\n  } else if name == \"host_stream_next\" {\n    Some(CtFn([\n      CtNamed(\"HostStream\", array_empty())\n    ], CtInt, Some(\"Async\")))\n  } else if name == \"host_stream_close\" {\n    Some(CtFn([\n      CtNamed(\"HostStream\", array_empty())\n    ], CtUnit, None))\n  } else if name == \"Stream::map\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::filter\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::fold\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown,\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_concurrency(name: String) -> Option[Type] {\n  let _ = name\n  None\n}\n\nfn lookup_bytestream(name: String) -> Option[Type] {\n  if name == \"String::to_bytes\" {\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"Stream\", [\n      CtInt\n    ]), None))\n  } else if name == \"Stream::to_string\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtInt\n      ])\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_async(name: String) -> Option[Type] {\n  match lookup_future(name) {\n    Some(t) => Some(t),\n    None => match lookup_stream(name) {\n      Some(t) => Some(t),\n      None => match lookup_concurrency(name) {\n        Some(t) => Some(t),\n        None => lookup_bytestream(name)\n      }\n    }\n  }\n}\n")
}

let source_51 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_resolve.vibe",
"\nimport @vibe/compiler/core {\n  Type, TypeDef, TypeExpr, find_typedef, resolve_builtin\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport fn subst_type_params(ty: Type, params: Array[String], args: Array[Type]) -> Type {\n  match ty {\n    CtNamed(name, targs) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(params) {\n        if Array::get(params, i) == name {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        CtNamed(name, for a in targs {\n          subst_type_params(a, params, args)\n        })\n      }\n    },\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      subst_type_params(e, params, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\n    },\n    _ => ty\n  }\n}\n\nexport fn resolve_type_expr(te: TypeExpr, defs: Array[TypeDef]) -> Type {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _, _) => CtEnum(n),\n          TDStruct(n, _, _, _) => CtStruct(n),\n          TDAlias(_, _, t) => t,\n          TDEffect(_, _, _) => CtNamed(name, array_empty())\n        },\n        None => CtNamed(name, array_empty())\n      }\n    },\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else {\n        match find_typedef(defs, name) {\n          Some(td) => match td {\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\n            _ => CtNamed(name, ra)\n          },\n          None => CtNamed(name, ra)\n        }\n      }\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret, effect_name) => {\n      let ret_box = Array::slice([\n        ret\n      ], 0, 1)\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\n    }\n  }\n}\n")
}

let source_52 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_pattern.vibe",
"\nimport @vibe/compiler/core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, env_lookup\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn find_ctor_in_defs(defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\n  let dlen = Array::length(defs)\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, _, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nfn pat_binds_any(pat: Pat) -> Bool {\n  match pat {\n    PBind(_) => true,\n    PCtor(_, pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_binds_any(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_binds_any(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        if pat_binds_any(fpat) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nexport fn pat_has_unsupported_or_binding(pat: Pat) -> Bool {\n  match pat {\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b) || pat_has_unsupported_or_binding(a) || pat_has_unsupported_or_binding(b),\n    PCtor(_, pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        if pat_has_unsupported_or_binding(fpat) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nexport fn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => {\n      match scrutinee_ty {\n        CtInt => (),\n        CtChar => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"integer literal pattern cannot match a non-Int scrutinee\")\n      }\n      env\n    },\n    PFloat(_) => {\n      match scrutinee_ty {\n        CtDouble => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"float literal pattern cannot match a non-Double scrutinee\")\n      }\n      env\n    },\n    PString(_) => {\n      match scrutinee_ty {\n        CtString => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"string literal pattern cannot match a non-String scrutinee\")\n      }\n      env\n    },\n    PBool(_) => {\n      match scrutinee_ty {\n        CtBool => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"boolean literal pattern cannot match a non-Bool scrutinee\")\n      }\n      env\n    },\n    PCtor(name, sub_pats) => {\n      let builtin_payload = match scrutinee_ty {\n        CtOption(elem) => if name == \"Some\" {\n          Some([\n            elem\n          ])\n        } else if name == \"None\" {\n          Some(array_empty())\n        } else {\n          None\n        },\n        _ => None\n      }\n      let ctor_payload = match builtin_payload {\n        Some(types) => Some((\"Option\", types)),\n        None => find_ctor_in_defs(defs, name)\n      }\n      match ctor_payload {\n        Some(info) => {\n          let (enum_name, raw_payload) = info\n          let payload_types = match scrutinee_ty {\n            CtNamed(_, sargs) => if Array::length(sargs) > 0 {\n              match env_lookup(env, name) {\n                Some(scheme) => match scheme {\n                  CtForAll(param_var_ids, _, inner) => if Array::length(param_var_ids) == Array::length(sargs) {\n                    match inner {\n                      CtFn(fn_payload_tys, _, _) => for pt in fn_payload_tys {\n                        send_subst_vars(pt, param_var_ids, sargs)\n                      },\n                      _ => raw_payload\n                    }\n                  } else {\n                    raw_payload\n                  },\n                  _ => raw_payload\n                },\n                None => raw_payload\n              }\n            } else {\n              raw_payload\n            },\n            _ => raw_payload\n          }\n          let splen = Array::length(sub_pats)\n          let ptlen = Array::length(payload_types)\n          let non_enum_scrutinee = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtFn(_, _, _) => true,\n            CtArray(_) => true,\n            CtTuple(_) => true,\n            _ => false\n          }\n          if non_enum_scrutinee {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` (of \", String::concat(enum_name, \") cannot match this scrutinee type\")))))\n          } else {\n            ()\n          }\n          if enum_name != \"Option\" && splen != ptlen {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` expects \", String::concat(__to_string(ptlen), String::concat(\" field(s) but binds \", __to_string(splen)))))))\n          } else {\n            ()\n          }\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                Array::get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          let splen = Array::length(sub_pats)\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          if plen != elen {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), String::concat(\" elements but the value is a \", String::concat(__to_string(elen), \"-tuple\")))))\n          } else {\n            ()\n          }\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let concrete_non_tuple = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtArray(_) => true,\n            CtOption(_) => true,\n            CtFn(_, _, _) => true,\n            CtStruct(_) => true,\n            CtEnum(_) => true,\n            _ => false\n          }\n          if concrete_non_tuple {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), \" elements but the value is not a tuple\")))\n          } else {\n            ()\n          }\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\n    PStruct(_, fields) => {\n      let flen = Array::length(fields)\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n        if i >= flen {\n          acc_env\n        } else {\n          let (_, fpat) = Array::get(fields, i)\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\n          bind_fields(i + 1, next_env)\n        }\n      }\n      bind_fields(0, env)\n    }\n  }\n}\n")
}

let source_53 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_exhaustive.vibe",
"\nimport @vibe/compiler/core {\n  Pat, Type, TypeDef, find_typedef\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\n\nfn exh_empty_pats() -> Array[Pat] {\n  array_empty()\n}\n\nfn exh_empty_strs() -> Array[String] {\n  array_empty()\n}\n\nfn exh_empty_tys() -> Array[Type] {\n  array_empty()\n}\n\nfn exh_empty_ctors() -> Array[(String, Array[Type], Int)] {\n  array_empty()\n}\n\nfn exh_empty_rows() -> Array[Array[Pat]] {\n  array_empty()\n}\n\nfn exh_names_contain(names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) && !found {\n    if Array::get(names, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn exh_pat_catchall(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    POr(l, r) => exh_pat_catchall(l) || exh_pat_catchall(r),\n    _ => false\n  }\n}\n\nfn exh_pat_is_wild(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nfn exh_pat_irrefutable(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(subs) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(subs) {\n        if !exh_pat_irrefutable(Array::get(subs, i)) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    PStruct(_, fields) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if !exh_pat_irrefutable(fp) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    POr(l, r) => exh_pat_irrefutable(l) || exh_pat_irrefutable(r),\n    _ => false\n  }\n}\n\nfn exh_flatten_or(p: Pat, out: Array[Pat]) -> Unit {\n  match p {\n    POr(l, r) => {\n      exh_flatten_or(l, out)\n      exh_flatten_or(r, out)\n    },\n    _ => Array::push(out, p)\n  }\n}\n\nfn exh_all_ground(ts: Array[Type], defs: Array[TypeDef]) -> Bool {\n  let mut ok = true\n  let mut i = 0\n  while i < Array::length(ts) {\n    if !exh_type_ground(Array::get(ts, i), defs) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn exh_type_ground(t: Type, defs: Array[TypeDef]) -> Bool {\n  match t {\n    CtVar(_) => false,\n    CtUnknown => false,\n    CtForAll(_, _, _) => false,\n    CtNamed(n, args) => {\n      if Array::length(args) == 0 {\n        match find_typedef(defs, n) {\n          Some(TDEnum(_, eparams, _)) => Array::length(eparams) == 0,\n          _ => false\n        }\n      } else {\n        exh_all_ground(args, defs)\n      }\n    },\n    CtTuple(items) => exh_all_ground(items, defs),\n    CtArray(e) => exh_type_ground(e, defs),\n    CtOption(e) => exh_type_ground(e, defs),\n    CtFn(ps, r, _) => exh_all_ground(ps, defs) && exh_type_ground(r, defs),\n    _ => true\n  }\n}\n\nfn exh_collect_vids(t: Type, acc: Array[Int]) -> Unit {\n  match t {\n    CtVar(v) => {\n      let mut i = 0\n      let mut seen = false\n      while i < Array::length(acc) {\n        if Array::get(acc, i) == v {\n          seen = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if seen {\n        ()\n      } else {\n        Array::push(acc, v)\n      }\n    },\n    CtTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        exh_collect_vids(Array::get(items, i), acc)\n        i = i + 1\n      }\n    },\n    CtArray(e) => exh_collect_vids(e, acc),\n    CtOption(e) => exh_collect_vids(e, acc),\n    CtNamed(_, nargs) => {\n      let mut i = 0\n      while i < Array::length(nargs) {\n        exh_collect_vids(Array::get(nargs, i), acc)\n        i = i + 1\n      }\n    },\n    CtFn(ps, r, _) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        exh_collect_vids(Array::get(ps, i), acc)\n        i = i + 1\n      }\n      exh_collect_vids(r, acc)\n    },\n    _ => ()\n  }\n}\n\nfn exh_subst_vids(t: Type, vids: Array[Int], args: Array[Type]) -> Type {\n  match t {\n    CtVar(v) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(vids) {\n        if Array::get(vids, i) == v {\n          idx = i\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        t\n      }\n    },\n    CtTuple(items) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(acc, exh_subst_vids(Array::get(items, i), vids, args))\n        i = i + 1\n      }\n      CtTuple(acc)\n    },\n    CtArray(e) => CtArray(exh_subst_vids(e, vids, args)),\n    CtOption(e) => CtOption(exh_subst_vids(e, vids, args)),\n    CtNamed(n, nargs) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(nargs) {\n        Array::push(acc, exh_subst_vids(Array::get(nargs, i), vids, args))\n        i = i + 1\n      }\n      CtNamed(n, acc)\n    },\n    CtFn(ps, r, eff) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(ps) {\n        Array::push(acc, exh_subst_vids(Array::get(ps, i), vids, args))\n        i = i + 1\n      }\n      CtFn(acc, exh_subst_vids(r, vids, args), eff)\n    },\n    _ => t\n  }\n}\n\nfn exh_enum_ctors(en: String, args: Array[Type], defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\n  match find_typedef(defs, en) {\n    Some(TDEnum(_, eparams, variants)) => {\n      let can_subst = Array::length(eparams) > 0 && Array::length(args) == Array::length(eparams)\n      let vids = array_empty()\n      if can_subst {\n        let mut ci = 0\n        while ci < Array::length(variants) {\n          let (_, cptys) = Array::get(variants, ci)\n          let mut cj = 0\n          while cj < Array::length(cptys) {\n            exh_collect_vids(Array::get(cptys, cj), vids)\n            cj = cj + 1\n          }\n          ci = ci + 1\n        }\n        let mut si = 1\n        while si < Array::length(vids) {\n          let v = Array::get(vids, si)\n          let mut sj = si\n          let mut moving = true\n          while sj > 0 && moving {\n            if Array::get(vids, sj - 1) > v {\n              Array::set(vids, sj, Array::get(vids, sj - 1))\n              sj = sj - 1\n            } else {\n              moving = false\n            }\n          }\n          Array::set(vids, sj, v)\n          si = si + 1\n        }\n      } else {\n        ()\n      }\n      let vid_subst = can_subst && Array::length(vids) == Array::length(eparams)\n      let out = exh_empty_ctors()\n      let mut i = 0\n      while i < Array::length(variants) {\n        let (vn, ptys) = Array::get(variants, i)\n        let inst = if can_subst {\n          let acc = exh_empty_tys()\n          let mut j = 0\n          while j < Array::length(ptys) {\n            let named_done = subst_type_params(Array::get(ptys, j), eparams, args)\n            let vt = if vid_subst {\n              exh_subst_vids(named_done, vids, args)\n            } else {\n              named_done\n            }\n            Array::push(acc, vt)\n            j = j + 1\n          }\n          acc\n        } else {\n          ptys\n        }\n        Array::push(out, (vn, inst, 0))\n        i = i + 1\n      }\n      (0, out)\n    },\n    _ => (2, exh_empty_ctors())\n  }\n}\n\nfn exh_column_ctors(t: Type, defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\n  match t {\n    CtBool => (0, [\n      (\"true\", exh_empty_tys(), 2),\n      (\"false\", exh_empty_tys(), 2)\n    ]),\n    CtOption(e) => (0, [\n      (\"Some\", [\n        e\n      ], 0),\n      (\"None\", exh_empty_tys(), 0)\n    ]),\n    CtTuple(items) => (0, [\n      (\"\", items, 1)\n    ]),\n    CtEnum(en) => exh_enum_ctors(en, exh_empty_tys(), defs),\n    CtNamed(en, args) => exh_enum_ctors(en, args, defs),\n    CtInt => (1, exh_empty_ctors()),\n    CtChar => (1, exh_empty_ctors()),\n    CtString => (1, exh_empty_ctors()),\n    CtDouble => (1, exh_empty_ctors()),\n    _ => (2, exh_empty_ctors())\n  }\n}\n\nfn exh_head_subpats(p: Pat, cname: String, ckind: Int) -> Option[Array[Pat]] {\n  match p {\n    PCtor(n, subs) => if ckind == 0 && n == cname {\n      Some(subs)\n    } else {\n      None\n    },\n    PTuple(subs) => if ckind == 1 {\n      Some(subs)\n    } else {\n      None\n    },\n    PBool(b) => if ckind == 2 {\n      let bn = if b {\n        \"true\"\n      } else {\n        \"false\"\n      }\n      if bn == cname {\n        Some(exh_empty_pats())\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn exh_pad_subs(subs: Array[Pat], arity: Int) -> Array[Pat] {\n  let out = exh_empty_pats()\n  let mut i = 0\n  while i < arity {\n    if i < Array::length(subs) {\n      Array::push(out, Array::get(subs, i))\n    } else {\n      Array::push(out, PWild)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn exh_row_with_tail(prefix: Array[Pat], row: Array[Pat]) -> Array[Pat] {\n  let out = exh_empty_pats()\n  let mut i = 0\n  while i < Array::length(prefix) {\n    Array::push(out, Array::get(prefix, i))\n    i = i + 1\n  }\n  let mut j = 1\n  while j < Array::length(row) {\n    Array::push(out, Array::get(row, j))\n    j = j + 1\n  }\n  out\n}\n\nfn exh_default_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\n  let out = exh_empty_rows()\n  let mut i = 0\n  while i < Array::length(xrows) {\n    let row = Array::get(xrows, i)\n    if exh_pat_is_wild(Array::get(row, 0)) {\n      Array::push(out, exh_row_with_tail(exh_empty_pats(), row))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn exh_tail_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\n  let out = exh_empty_rows()\n  let mut i = 0\n  while i < Array::length(xrows) {\n    Array::push(out, exh_row_with_tail(exh_empty_pats(), Array::get(xrows, i)))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_prepend(head: String, rest: Array[String]) -> Array[String] {\n  let out = exh_empty_strs()\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_join(parts: Array[String], sep: String) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(parts) {\n    if i > 0 {\n      out = String::concat(out, sep)\n    } else {\n      ()\n    }\n    out = String::concat(out, Array::get(parts, i))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_format_ctor(cname: String, ckind: Int, args: Array[String]) -> String {\n  if ckind == 1 {\n    String::concat(\"(\", String::concat(exh_join(args, \", \"), \")\"))\n  } else if Array::length(args) == 0 {\n    cname\n  } else {\n    String::concat(cname, String::concat(\"(\", String::concat(exh_join(args, \", \"), \")\")))\n  }\n}\n\nfn exh_wild_strs(arity: Int) -> Array[String] {\n  let out = exh_empty_strs()\n  let mut i = 0\n  while i < arity {\n    Array::push(out, \"_\")\n    i = i + 1\n  }\n  out\n}\n\nfn exh_find(rows: Array[Array[Pat]], tys: Array[Type], defs: Array[TypeDef], budget: Array[Int]) -> Option[Array[String]] {\n  let ncols = Array::length(tys)\n  if ncols == 0 {\n    if Array::length(rows) == 0 {\n      Some(exh_empty_strs())\n    } else {\n      None\n    }\n  } else {\n    let cost = Array::length(rows) * ncols + 1\n    let remaining = Array::get(budget, 0)\n    if remaining < cost {\n      None\n    } else {\n      Array::set(budget, 0, remaining - cost)\n      let xrows = exh_empty_rows()\n      let mut ri = 0\n      while ri < Array::length(rows) {\n        let row = Array::get(rows, ri)\n        let heads = exh_empty_pats()\n        exh_flatten_or(Array::get(row, 0), heads)\n        let mut hi = 0\n        while hi < Array::length(heads) {\n          let pref = exh_empty_pats()\n          Array::push(pref, Array::get(heads, hi))\n          Array::push(xrows, exh_row_with_tail(pref, row))\n          hi = hi + 1\n        }\n        ri = ri + 1\n      }\n      let rest_tys = Array::slice(tys, 1, ncols)\n      let (kind, ctors) = exh_column_ctors(Array::get(tys, 0), defs)\n      if kind == 0 {\n        let used = exh_empty_strs()\n        let mut ui = 0\n        while ui < Array::length(xrows) {\n          match Array::get(Array::get(xrows, ui), 0) {\n            PCtor(n, _) => Array::push(used, n),\n            PBool(b) => if b {\n              Array::push(used, \"true\")\n            } else {\n              Array::push(used, \"false\")\n            },\n            PTuple(_) => Array::push(used, \"\"),\n            _ => ()\n          }\n          ui = ui + 1\n        }\n        let mut complete = true\n        let mut ki = 0\n        while ki < Array::length(ctors) {\n          let (cn0, _, _) = Array::get(ctors, ki)\n          if !exh_names_contain(used, cn0) {\n            complete = false\n          } else {\n            ()\n          }\n          ki = ki + 1\n        }\n        if complete {\n          let mut result: Option[Array[String]] = None\n          let mut done = false\n          let mut ci = 0\n          while ci < Array::length(ctors) && !done {\n            let (cn, ptys, ck) = Array::get(ctors, ci)\n            let arity = Array::length(ptys)\n            let srows = exh_empty_rows()\n            let mut si = 0\n            while si < Array::length(xrows) {\n              let srow = Array::get(xrows, si)\n              let head = Array::get(srow, 0)\n              if exh_pat_is_wild(head) {\n                Array::push(srows, exh_row_with_tail(exh_pad_subs(exh_empty_pats(), arity), srow))\n              } else {\n                match exh_head_subpats(head, cn, ck) {\n                  Some(subs) => Array::push(srows, exh_row_with_tail(exh_pad_subs(subs, arity), srow)),\n                  None => ()\n                }\n              }\n              si = si + 1\n            }\n            let stys = exh_empty_tys()\n            let mut ti = 0\n            while ti < arity {\n              Array::push(stys, Array::get(ptys, ti))\n              ti = ti + 1\n            }\n            let mut ti2 = 0\n            while ti2 < Array::length(rest_tys) {\n              Array::push(stys, Array::get(rest_tys, ti2))\n              ti2 = ti2 + 1\n            }\n            match exh_find(srows, stys, defs, budget) {\n              Some(w) => {\n                let args = Array::slice(w, 0, arity)\n                let restw = Array::slice(w, arity, Array::length(w))\n                result = Some(exh_prepend(exh_format_ctor(cn, ck, args), restw))\n                done = true\n              },\n              None => ()\n            }\n            ci = ci + 1\n          }\n          result\n        } else {\n          match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\n            Some(w) => {\n              let mut head_str = \"_\"\n              let mut found_missing = false\n              let mut mi = 0\n              while mi < Array::length(ctors) && !found_missing {\n                let (mn, mptys, mk) = Array::get(ctors, mi)\n                if !exh_names_contain(used, mn) {\n                  head_str = exh_format_ctor(mn, mk, exh_wild_strs(Array::length(mptys)))\n                  found_missing = true\n                } else {\n                  mi = mi + 1\n                }\n              }\n              Some(exh_prepend(head_str, w))\n            },\n            None => None\n          }\n        }\n      } else if kind == 1 {\n        match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\n          Some(w) => Some(exh_prepend(\"_\", w)),\n          None => None\n        }\n      } else {\n        let mut all_irr = true\n        let mut oi = 0\n        while oi < Array::length(xrows) {\n          if !exh_pat_irrefutable(Array::get(Array::get(xrows, oi), 0)) {\n            all_irr = false\n          } else {\n            ()\n          }\n          oi = oi + 1\n        }\n        if all_irr {\n          match exh_find(exh_tail_rows(xrows), rest_tys, defs, budget) {\n            Some(w) => Some(exh_prepend(\"_\", w)),\n            None => None\n          }\n        } else {\n          None\n        }\n      }\n    }\n  }\n}\n\nexport fn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String] {\n  let mut has_catchall = false\n  let mut i = 0\n  while i < Array::length(pats) {\n    if exh_pat_catchall(Array::get(pats, i)) {\n      has_catchall = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if has_catchall {\n    None\n  } else if !exh_type_ground(scr_ty, defs) {\n    None\n  } else {\n    let rows = exh_empty_rows()\n    let mut j = 0\n    while j < Array::length(pats) {\n      let row = exh_empty_pats()\n      Array::push(row, Array::get(pats, j))\n      Array::push(rows, row)\n      j = j + 1\n    }\n    let budget = [\n      4096\n    ]\n    match exh_find(rows, [\n      scr_ty\n    ], defs, budget) {\n      Some(w) => if Array::length(w) > 0 {\n        Some(Array::get(w, 0))\n      } else {\n        None\n      },\n      None => None\n    }\n  }\n}\n")
}

let source_54 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_trait.vibe",
"\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  env_lookup,\n  find_typedef,\n  impls_overlap_for,\n  subst_apply,\n  trait_defined,\n  type_implements_trait,\n  type_to_string\n}\n\n\n\nfn one_super(name: String) -> Array[String] {\n  [\n    name\n  ]\n}\n\nfn no_trait_methods() -> Array[(String, Array[TypeExpr], TypeExpr)] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn no_type_args() -> Array[Type] {\n  array_empty()\n}\n\nfn empty_strings() -> Array[String] {\n  array_empty()\n}\n\nexport fn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool {\n  type_implements_trait(env, s, ty, bound)\n}\n\nexport fn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool {\n  send_ok_rec(env, s, defs, ty, empty_strings())\n}\n\nfn send_seen_has(seen: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn send_seen_with(seen: Array[String], name: String) -> Array[String] {\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < Array::length(seen) {\n    ArrayBuilder::push(b, Array::get(seen, i))\n    i = i + 1\n  }\n  ArrayBuilder::push(b, name)\n  ArrayBuilder::freeze(b)\n}\n\nfn send_ok_all(env: TypeEnv, s: Subst, defs: Array[TypeDef], tys: Array[Type], seen: Array[String]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(tys) {\n    if not(send_ok_rec(env, s, defs, Array::get(tys, i), seen)) {\n      ok = false\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn send_seen_key(s: Subst, name: String, targs: Array[Type]) -> String {\n  let mut key = name\n  let mut i = 0\n  while i < Array::length(targs) {\n    key = String::concat(key, String::concat(\"|\", type_to_string(subst_apply(s, Array::get(targs, i)))))\n    i = i + 1\n  }\n  key\n}\n\nfn send_ok_named(env: TypeEnv, s: Subst, defs: Array[TypeDef], name: String, targs: Array[Type], seen: Array[String]) -> Bool {\n  let key = send_seen_key(s, name, targs)\n  if send_seen_has(seen, key) {\n    true\n  } else if Array::length(seen) >= 32 {\n    false\n  } else {\n    match find_typedef(defs, name) {\n      Some(td) => match td {\n        TDStruct(_, fields, mut_fields, tparams) => {\n          if Array::length(mut_fields) > 0 {\n            false\n          } else if Array::length(tparams) != Array::length(targs) {\n            false\n          } else {\n            let inner = send_seen_with(seen, key)\n            let mut i = 0\n            let mut ok = true\n            while i < Array::length(fields) {\n              let (_, ft) = Array::get(fields, i)\n              let inst = subst_type_params(ft, tparams, targs)\n              if not(send_ok_rec(env, s, defs, inst, inner)) {\n                ok = false\n              }\n              i = i + 1\n            }\n            ok\n          }\n        },\n        TDEnum(_, tparams, variants) => {\n          if Array::length(tparams) != Array::length(targs) {\n            false\n          } else if Array::length(tparams) == 0 {\n            let inner = send_seen_with(seen, key)\n            let mut vi = 0\n            let mut ok = true\n            while vi < Array::length(variants) {\n              let (_, payloads) = Array::get(variants, vi)\n              let mut pi = 0\n              while pi < Array::length(payloads) {\n                if not(send_ok_rec(env, s, defs, Array::get(payloads, pi), inner)) {\n                  ok = false\n                }\n                pi = pi + 1\n              }\n              vi = vi + 1\n            }\n            ok\n          } else {\n            let inner = send_seen_with(seen, key)\n            let mut vi = 0\n            let mut ok = true\n            while vi < Array::length(variants) {\n              let (vname, payloads) = Array::get(variants, vi)\n              if Array::length(payloads) > 0 {\n                match env_lookup(env, vname) {\n                  Some(cty) => match cty {\n                    CtForAll(vids, _, inner_ty) => match inner_ty {\n                      CtFn(args, _, _) => {\n                        let mut pi = 0\n                        while pi < Array::length(args) {\n                          let inst = send_subst_vars(Array::get(args, pi), vids, targs)\n                          if not(send_ok_rec(env, s, defs, inst, inner)) {\n                            ok = false\n                          }\n                          pi = pi + 1\n                        }\n                      },\n                      _ => {\n                        ok = false\n                      }\n                    },\n                    _ => {\n                      ok = false\n                    }\n                  },\n                  None => {\n                    ok = false\n                  }\n                }\n              } else {\n                ()\n              }\n              vi = vi + 1\n            }\n            ok\n          }\n        },\n        TDAlias(_, params, body) => {\n          if Array::length(params) != Array::length(targs) {\n            false\n          } else {\n            send_ok_rec(env, s, defs, subst_type_params(body, params, targs), send_seen_with(seen, key))\n          }\n        },\n        TDEffect(_, _, _) => false\n      },\n      None => false\n    }\n  }\n}\n\nexport fn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type {\n  match ty {\n    CtVar(v) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(vids) {\n        if Array::get(vids, i) == v {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        ty\n      }\n    },\n    CtArray(e) => CtArray(send_subst_vars(e, vids, args)),\n    CtOption(e) => CtOption(send_subst_vars(e, vids, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      send_subst_vars(e, vids, args)\n    }),\n    CtNamed(nm, targs) => CtNamed(nm, for a in targs {\n      send_subst_vars(a, vids, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let rp = for p in ps {\n        send_subst_vars(p, vids, args)\n      }\n      CtFn(rp, send_subst_vars(ret, vids, args), eff)\n    },\n    _ => ty\n  }\n}\n\nfn send_ok_rec(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, seen: Array[String]) -> Bool {\n  match subst_apply(s, ty) {\n    CtInt => true,\n    CtDouble => true,\n    CtBool => true,\n    CtString => true,\n    CtChar => true,\n    CtUnit => true,\n    CtTuple(ts) => send_ok_all(env, s, defs, ts, seen),\n    CtOption(e) => send_ok_rec(env, s, defs, e, seen),\n    CtArray(_) => false,\n    CtBytes => false,\n    CtFn(_, _, _) => false,\n    CtEnum(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),\n    CtStruct(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),\n    CtNamed(name, targs) => if name == \"FrozenArray\" && Array::length(targs) == 1 {\n      send_ok_rec(env, s, defs, Array::get(targs, 0), seen)\n    } else {\n      send_ok_named(env, s, defs, name, targs, seen)\n    },\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtUnknown => false\n  }\n}\n\nexport fn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String] {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport fn register_builtin_traits(env: TypeEnv) -> TypeEnv {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let nm = no_trait_methods()\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, nm, env, empty_strings())\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, nm, e1, empty_strings())\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, nm, e2, empty_strings())\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, nm, e3, empty_strings())\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, nm, e4, empty_strings())\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, nm, e5, empty_strings())\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  let e58 = EnvTraitDef(\"Send\", no_supers, false, nm, e57, empty_strings())\n  let e59 = EnvTraitImpl(\"Send\", CtInt, e58)\n  let e60 = EnvTraitImpl(\"Send\", CtDouble, e59)\n  let e61 = EnvTraitImpl(\"Send\", CtString, e60)\n  let e62 = EnvTraitImpl(\"Send\", CtBool, e61)\n  let e63 = EnvTraitImpl(\"Send\", CtUnit, e62)\n  let e64 = EnvTraitImpl(\"Send\", CtChar, e63)\n  e64\n}\n\nexport fn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String] {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport fn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool {\n  not(impls_overlap_for(env, trait_name, target))\n}\n")
}

let source_55 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_spawnable.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, env_lookup, subst_apply, type_to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\n\nfn sp_empty_strings() -> Array[String] {\n  array_empty()\n}\n\nfn sp_array_contains_str(arr: Array[String], v: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn sp_add_unique(arr: Array[String], v: String) -> Unit {\n  if sp_array_contains_str(arr, v) {\n    ()\n  } else {\n    Array::push(arr, v)\n  }\n}\n\nfn sp_append_all(dst: Array[String], src: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn sp_clone_strings(items: Array[String]) -> Array[String] {\n  let out = sp_empty_strings()\n  sp_append_all(out, items)\n  out\n}\n\nfn sp_bound_with(bound: Array[String], extras: Array[String]) -> Array[String] {\n  let out = sp_clone_strings(bound)\n  sp_append_all(out, extras)\n  out\n}\n\nfn sp_bound_with_one(bound: Array[String], name: String) -> Array[String] {\n  let out = sp_clone_strings(bound)\n  Array::push(out, name)\n  out\n}\n\nfn sp_collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        sp_collect_pat_bindings(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        sp_collect_pat_bindings(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      sp_collect_pat_bindings(a, out)\n      sp_collect_pat_bindings(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        sp_collect_pat_bindings(fpat, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn sp_collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {\n  let result = sp_empty_strings()\n  match expr {\n    EIdent(name, _) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      result\n    },\n    EInt(_) => result,\n    EFloat(_) => result,\n    EString(_) => result,\n    EBool(_) => result,\n    EUnit => result,\n    ELet(name, val, body, _) => {\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))\n      result\n    },\n    ELetRec(name, val, body) => {\n      let nb = sp_bound_with_one(bound, name)\n      sp_append_all(result, sp_collect_free_vars(val, nb))\n      sp_append_all(result, sp_collect_free_vars(body, nb))\n      result\n    },\n    ELetMut(name, val, body, _) => {\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))\n      result\n    },\n    EAssign(name, val, cont) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(cont, bound))\n      result\n    },\n    EAssignOp(name, _, val, cont) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(cont, bound))\n      result\n    },\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with(bound, pnames)))\n      result\n    },\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(_, _) => (),\n        _ => sp_append_all(result, sp_collect_free_vars(callee, bound))\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(args, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EIf(cond, then_e, else_e) => {\n      sp_append_all(result, sp_collect_free_vars(cond, bound))\n      sp_append_all(result, sp_collect_free_vars(then_e, bound))\n      sp_append_all(result, sp_collect_free_vars(else_e, bound))\n      result\n    },\n    ESeq(a, b) => {\n      sp_append_all(result, sp_collect_free_vars(a, bound))\n      sp_append_all(result, sp_collect_free_vars(b, bound))\n      result\n    },\n    EBinOp(_, left, right) => {\n      sp_append_all(result, sp_collect_free_vars(left, bound))\n      sp_append_all(result, sp_collect_free_vars(right, bound))\n      result\n    },\n    EUnaryOp(_, operand) => {\n      sp_append_all(result, sp_collect_free_vars(operand, bound))\n      result\n    },\n    EWhile(cond, body) => {\n      sp_append_all(result, sp_collect_free_vars(cond, bound))\n      sp_append_all(result, sp_collect_free_vars(body, bound))\n      result\n    },\n    ELoop(params, body) => {\n      let mut b2 = sp_clone_strings(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        sp_append_all(result, sp_collect_free_vars(init, b2))\n        b2 = sp_bound_with_one(b2, name)\n        i = i + 1\n      }\n      sp_append_all(result, sp_collect_free_vars(body, b2))\n      result\n    },\n    EForIn(name, index_name, iter, body) => {\n      sp_append_all(result, sp_collect_free_vars(iter, bound))\n      let b2 = sp_bound_with_one(bound, name)\n      let b3 = match index_name {\n        Some(ixn) => sp_bound_with_one(b2, ixn),\n        None => b2\n      }\n      sp_append_all(result, sp_collect_free_vars(body, b3))\n      result\n    },\n    EMatch(scrut, arms) => {\n      sp_append_all(result, sp_collect_free_vars(scrut, bound))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))\n        ai = ai + 1\n      }\n      result\n    },\n    EHandle(body, arms) => {\n      sp_append_all(result, sp_collect_free_vars(body, bound))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))\n        ai = ai + 1\n      }\n      result\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        sp_append_all(result, sp_collect_free_vars(fval, bound))\n        i = i + 1\n      }\n      result\n    },\n    EDot(obj, _, _, _) => {\n      sp_append_all(result, sp_collect_free_vars(obj, bound))\n      result\n    },\n    EReturn(e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    ELabeledArg(_, _, e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    EBreak(opt) => {\n      match opt {\n        Some(e) => sp_append_all(result, sp_collect_free_vars(e, bound)),\n        None => ()\n      }\n      result\n    },\n    EContinue(exprs) => {\n      let mut i = 0\n      while i < Array::length(exprs) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(exprs, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        sp_append_all(result, sp_collect_free_vars(fval, bound))\n        i = i + 1\n      }\n      result\n    },\n    ESpread(e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    EStringInterp(_) => result\n  }\n}\n\nfn sp_same_region(a: Type, b: Type) -> Bool {\n  match (a, b) {\n    (CtNamed(n1, _), CtNamed(n2, _)) => n1 == n2,\n    (CtVar(v1), CtVar(v2)) => v1 == v2,\n    _ => false\n  }\n}\n\nfn sp_spawnable_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, r_here: Type) -> Bool {\n  if type_send_ok(env, s, defs, ty) {\n    true\n  } else {\n    match ty {\n      CtNamed(n, targs) => if n == \"TaskGroup\" && Array::length(targs) == 2 {\n        sp_same_region(Array::get(targs, 0), r_here)\n      } else if (n == \"TaskHandle\" || n == \"Sender\" || n == \"Receiver\") && Array::length(targs) == 3 {\n        sp_same_region(Array::get(targs, 0), r_here)\n      } else if n == \"Future\" && Array::length(targs) == 1 {\n        true\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\nexport fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String] {\n  match f_expr {\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      let free = sp_collect_free_vars(body, pnames)\n      let out = sp_empty_strings()\n      let mut fi = 0\n      while fi < Array::length(free) {\n        let vname = Array::get(free, fi)\n        match env_lookup(env, vname) {\n          Some(vty) => {\n            let resolved = subst_apply(s, vty)\n            if sp_spawnable_ok(env, s, defs, resolved, r_here) {\n              ()\n            } else {\n              Array::push(out, String::concat(\"no impl `Spawnable` for `\", String::concat(type_to_string(resolved), String::concat(\"`: capture `\", String::concat(vname, \"` is neither Send nor a same-nursery endpoint\")))))\n            }\n          },\n          None => ()\n        }\n        fi = fi + 1\n      }\n      out\n    },\n    _ => sp_empty_strings()\n  }\n}\n\n\nfn sp_remove_name(names: Array[String], name: String) -> Array[String] {\n  let out = sp_empty_strings()\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    if n == name {\n      ()\n    } else {\n      Array::push(out, n)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn sp_remove_names(names: Array[String], to_remove: Array[String]) -> Array[String] {\n  let mut cur = names\n  let mut i = 0\n  while i < Array::length(to_remove) {\n    cur = sp_remove_name(cur, Array::get(to_remove, i))\n    i = i + 1\n  }\n  cur\n}\n\nfn sp_off_marker_len(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\nfn sp_check_spawn_mut_capture(closure_expr: Expr, mut_names: Array[String], call_off: Int, name_len: Int, out: Array[String]) -> Unit {\n  match closure_expr {\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      let free = sp_collect_free_vars(body, pnames)\n      let mut fi = 0\n      while fi < Array::length(free) {\n        let vname = Array::get(free, fi)\n        if sp_array_contains_str(mut_names, vname) {\n          Array::push(out, String::concat(\"no impl `Spawnable` for a `let mut` binding: capture `\", String::concat(vname, String::concat(\"` shares a mutable cell across the spawn boundary\", sp_off_marker_len(call_off, name_len)))))\n        } else {\n          ()\n        }\n        fi = fi + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn sp_walk_spawnable_mut_binary(a: Expr, b: Expr, mut_names: Array[String], out: Array[String]) -> Unit {\n  sp_walk_spawnable_mut(a, mut_names, out)\n  sp_walk_spawnable_mut(b, mut_names, out)\n}\n\nfn sp_walk_spawnable_mut_list(items: Array[Expr], mut_names: Array[String], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    sp_walk_spawnable_mut(Array::get(items, i), mut_names, out)\n    i = i + 1\n  }\n}\n\nfn sp_walk_spawnable_mut_fields(fields: Array[(String, Expr)], mut_names: Array[String], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, fval) = Array::get(fields, i)\n    sp_walk_spawnable_mut(fval, mut_names, out)\n    i = i + 1\n  }\n}\n\nfn sp_walk_spawnable_mut(expr: Expr, mut_names: Array[String], out: Array[String]) -> Unit {\n  match expr {\n    ELetMut(name, val, body, _) => {\n      sp_walk_spawnable_mut(val, mut_names, out)\n      sp_walk_spawnable_mut(body, sp_bound_with_one(mut_names, name), out)\n    },\n    ELet(name, val, body, _) => {\n      sp_walk_spawnable_mut(val, mut_names, out)\n      sp_walk_spawnable_mut(body, sp_remove_name(mut_names, name), out)\n    },\n    ELetRec(name, val, body) => {\n      let nm = sp_remove_name(mut_names, name)\n      sp_walk_spawnable_mut(val, nm, out)\n      sp_walk_spawnable_mut(body, nm, out)\n    },\n    EAssign(_, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),\n    EAssignOp(_, _, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),\n    EFn(_, _, params, _, _, body) => {\n      let mut cur = mut_names\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        cur = sp_remove_name(cur, pname)\n        i = i + 1\n      }\n      sp_walk_spawnable_mut(body, cur, out)\n    },\n    ECall(callee, args, _) => {\n      let spawn_info = match callee {\n        EIdent(name, coff) => if (name == \"TaskGroup::spawn\" || name == \"TaskGroup::spawn_suspend\") && Array::length(args) == 2 {\n          Some((coff, String::length(name)))\n        } else {\n          None\n        },\n        _ => None\n      }\n      match spawn_info {\n        Some((coff, nlen)) => sp_check_spawn_mut_capture(Array::get(args, 1), mut_names, coff, nlen, out),\n        None => ()\n      }\n      match callee {\n        EIdent(_, _) => (),\n        _ => sp_walk_spawnable_mut(callee, mut_names, out)\n      }\n      sp_walk_spawnable_mut_list(args, mut_names, out)\n    },\n    EIf(c, t, e) => {\n      sp_walk_spawnable_mut(c, mut_names, out)\n      sp_walk_spawnable_mut_binary(t, e, mut_names, out)\n    },\n    ESeq(a, b) => sp_walk_spawnable_mut_binary(a, b, mut_names, out),\n    EBinOp(_, l, r) => sp_walk_spawnable_mut_binary(l, r, mut_names, out),\n    EUnaryOp(_, e) => sp_walk_spawnable_mut(e, mut_names, out),\n    EWhile(c, b) => sp_walk_spawnable_mut_binary(c, b, mut_names, out),\n    ELoop(params, body) => {\n      let mut cur = mut_names\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        sp_walk_spawnable_mut(init, cur, out)\n        cur = sp_remove_name(cur, name)\n        i = i + 1\n      }\n      sp_walk_spawnable_mut(body, cur, out)\n    },\n    EForIn(name, index_name, iter, body) => {\n      sp_walk_spawnable_mut(iter, mut_names, out)\n      let m2 = sp_remove_name(mut_names, name)\n      let m3 = match index_name {\n        Some(ixn) => sp_remove_name(m2, ixn),\n        None => m2\n      }\n      sp_walk_spawnable_mut(body, m3, out)\n    },\n    EMatch(scrut, arms) => {\n      sp_walk_spawnable_mut(scrut, mut_names, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)\n        ai = ai + 1\n      }\n    },\n    EHandle(body, arms) => {\n      sp_walk_spawnable_mut(body, mut_names, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)\n        ai = ai + 1\n      }\n    },\n    ETuple(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),\n    EArray(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),\n    ERecord(_, fields, _) => sp_walk_spawnable_mut_fields(fields, mut_names, out),\n    EDot(obj, _, _, _) => sp_walk_spawnable_mut(obj, mut_names, out),\n    EReturn(e) => sp_walk_spawnable_mut(e, mut_names, out),\n    ELabeledArg(_, _, e) => sp_walk_spawnable_mut(e, mut_names, out),\n    EBreak(opt) => match opt {\n      Some(e) => sp_walk_spawnable_mut(e, mut_names, out),\n      None => ()\n    },\n    EContinue(exprs) => sp_walk_spawnable_mut_list(exprs, mut_names, out),\n    EMap(fields) => sp_walk_spawnable_mut_fields(fields, mut_names, out),\n    ESpread(e) => sp_walk_spawnable_mut(e, mut_names, out),\n    _ => ()\n  }\n}\n\nfn check_spawnable_mut_captures_scope(scope_body: Expr) -> Array[String] {\n  let out = sp_empty_strings()\n  sp_walk_spawnable_mut(scope_body, sp_empty_strings(), out)\n  out\n}\n\nexport fn check_spawnable_mut_captures_stmts(stmts: Array[Stmt]) -> Array[String] {\n  let out = sp_empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SLetMut(_, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      STest(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SBench(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SExpr(body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SModule(_, _, inner) => sp_append_all(out, check_spawnable_mut_captures_stmts(inner)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let source_56 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_effects.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  Type,\n  TypeEnv,\n  TypeExpr,\n  canonical_exception_effect_name,\n  env_lookup,\n  exception_effect_labels_equal,\n  exception_kinds_compatible,\n  exception_label_kind,\n  exception_throw_label_for_kind,\n  expr_children,\n  is_exception_effect_name,\n  is_exception_label,\n  is_exception_throw_operation,\n  type_name_has_async_iterator_impl\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen {\n  canonical_builtin_name\n}\n\n\n\nexport enum EffectError {\n  EEEffectfulCallOutsideEffect(String);\n  EEPerformUndeclaredEffect(String, String);\n  EEEffectRowMismatch(String, String, String, String);\n  EEAssignImmutable(String);\n  EEHandleNeverFires(String)\n}\n\n\n\nexport fn effect_error_to_string(err: EffectError) -> String {\n  match err {\n    EEEffectfulCallOutsideEffect(name) => String::concat(\"effectful call outside effectful context: \", name),\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\"use of undeclared effect `\", String::concat(eff, String::concat(\"` (\", String::concat(op, \"); add it to the function's `with { ... }` or wrap in a `handle`\")))),\n    EEEffectRowMismatch(fname, missing, declared, required) => {\n      let head = if String::length(fname) > 0 {\n        String::concat(\"effect row mismatch for '\", String::concat(fname, \"'\"))\n      } else {\n        \"effect row mismatch\"\n      }\n      let detail = if String::length(declared) > 0 {\n        String::concat(\" (declared with { \", String::concat(declared, String::concat(\" }, requires { \", String::concat(required, \" })\"))))\n      } else {\n        String::concat(\" (no 'with' clause, requires { \", String::concat(required, \" })\"))\n      }\n      let hint = if String::length(fname) == 0 {\n        String::concat(\"\\nhint: add 'with { \", String::concat(required, \" }' to the enclosing function\"))\n      } else if String::length(declared) == 0 {\n        String::concat(\"\\nhint: declare 'fn \", String::concat(fname, String::concat(\"(...) -> T with { \", String::concat(required, \" }'\"))))\n      } else {\n        String::concat(\"\\nhint: add 'with { \", String::concat(required, String::concat(\" }' to '\", String::concat(fname, \"'\"))))\n      }\n      String::concat(head, String::concat(\": missing { \", String::concat(missing, String::concat(\" }\", String::concat(detail, hint)))))\n    },\n    EEAssignImmutable(name) => String::concat(\"cannot assign to immutable binding `\", String::concat(name, \"` (declare it with `let mut`)\")),\n    EEHandleNeverFires(eff) => {\n      let tail = String::concat(eff, \"::..` and calls an opaque function value. A continuation captured by another handler carries THAT handler with it, so wrapping its invocation in a new `handle` does not switch handlers (non-scoped resumption is unsupported -- ADR-0089 Part A, #1347). Drive the continuation without the wrapping handle, or handle the effect where it is performed\")\n      String::concat(\"handle of effect '\", String::concat(eff, String::concat(\"' can never fire: this body reaches no `perform \", tail)))\n    }\n  }\n}\n\n\nfn effect_opt_is_async(eff: Option[String]) -> Bool {\n  effect_row_has_label(effect_row_parse(eff), \"Async\")\n}\n\nfn is_async_primitive(name: String, env: TypeEnv) -> Bool {\n  match env_lookup(env, name) {\n    Some(_) => false,\n    None => {\n      let normalized = canonical_builtin_name(name)\n      match lookup_builtin(normalized) {\n        Some(ty) => match ty {\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\n          _ => false\n        },\n        None => false\n      }\n    }\n  }\n}\n\nfn handle_arms_handle_async(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (pat, _) = Array::get(arms, i)\n    match pat {\n      PCtor(name, _) => if String::starts_with(name, \"Async::\") {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\n\nfn afe_no_locals() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn afe_type_head_name(t: Type) -> Option[String] {\n  match t {\n    CtNamed(n, _) => Some(n),\n    CtStruct(n) => Some(n),\n    CtEnum(n) => Some(n),\n    _ => None\n  }\n}\n\nfn afe_texpr_head_name(t: TypeExpr) -> Option[String] {\n  match t {\n    TyName(n) => Some(n),\n    TyApp(n, _) => Some(n),\n    _ => None\n  }\n}\n\nfn afe_lookup_local(locals: Array[(String, String)], name: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(locals) {\n    let entry = Array::get(locals, i)\n    match found {\n      None => if entry.0 == name {\n        found = Some(entry.1)\n      } else {\n        ()\n      },\n      Some(_) => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn afe_bind_local(locals: Array[(String, String)], name: String, head: Option[String]) -> Array[(String, String)] {\n  let out = array_empty()\n  match head {\n    Some(h) => Array::push(out, (name, h)),\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(locals) {\n    let entry = Array::get(locals, i)\n    if entry.0 != name {\n      Array::push(out, entry)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn afe_bind_params(locals: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {\n  let mut cur = locals\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ptype) = Array::get(params, i)\n    let head = match ptype {\n      Some(te) => afe_texpr_head_name(te),\n      None => None\n    }\n    cur = afe_bind_local(cur, pname, head)\n    i = i + 1\n  }\n  cur\n}\n\nlet afe_field_types_cell: Array[(String, String)] = array_empty()\n\nfn afe_field_type_key(struct_name: String, field: String) -> String {\n  String::concat(struct_name, String::concat(\".\", field))\n}\n\nfn afe_collect_field_types(stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _, _) => {\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, fty) = Array::get(fields, j)\n          let head = texpr_head_name_afe(fty)\n          if String::length(head) > 0 {\n            Array::push(afe_field_types_cell, (afe_field_type_key(sname, fname), head))\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      },\n      SModule(_, _, inner) => afe_collect_field_types(inner),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn texpr_head_name_afe(t: TypeExpr) -> String {\n  match t {\n    TyName(n) => n,\n    TyApp(n, _) => n,\n    _ => \"\"\n  }\n}\n\nfn afe_set_field_types(stmts: Array[Stmt]) -> Unit {\n  Array::truncate(afe_field_types_cell, 0)\n  afe_collect_field_types(stmts)\n}\n\nfn afe_lookup_field_type(struct_name: String, field: String) -> Option[String] {\n  let key = afe_field_type_key(struct_name, field)\n  let mut i = 0\n  let mut out = None\n  while i < Array::length(afe_field_types_cell) {\n    let (k, v) = Array::get(afe_field_types_cell, i)\n    if k == key {\n      out = Some(v)\n      i = Array::length(afe_field_types_cell)\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\nfn afe_expr_head_name(e: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {\n  match e {\n    EIdent(n, _) => match afe_lookup_local(locals, n) {\n      Some(h) => Some(h),\n      None => match env_lookup(env, n) {\n        Some(t) => afe_type_head_name(t),\n        None => None\n      }\n    },\n    ERecord(n, _, _) => if String::length(n) > 0 {\n      Some(n)\n    } else {\n      None\n    },\n    EDot(obj, field, _, _) => match afe_expr_head_name(obj, env, locals) {\n      Some(otype) => afe_lookup_field_type(otype, field),\n      None => None\n    },\n    ECall(EIdent(f, _), _, _) => match env_lookup(env, f) {\n      Some(CtFn(_, ret, _)) => afe_type_head_name(ret),\n      _ => match lookup_builtin(f) {\n        Some(CtFn(_, bret, _)) => afe_type_head_name(bret),\n        _ => None\n      }\n    },\n    _ => None\n  }\n}\n\nfn afe_async_iterand(iter: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {\n  match afe_expr_head_name(iter, env, locals) {\n    Some(tn) => if tn == \"HostStream\" || type_name_has_async_iterator_impl(env, tn) {\n      Some(tn)\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nexport fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {\n  check_async_effects_expr_lo(expr, env, in_async, afe_no_locals())\n}\n\nfn check_async_effects_expr_lo(expr: Expr, env: TypeEnv, in_async: Bool, locals: Array[(String, String)]) -> Array[EffectError] {\n  let errors = array_empty()\n  match expr {\n    ECall(EIdent(name, _), _, _) => if !in_async && is_async_primitive(name, env) {\n      Array::push(errors, EEEffectfulCallOutsideEffect(name))\n    } else {\n      ()\n    },\n    EForIn(_, _, iter, _) => match afe_async_iterand(iter, env, locals) {\n      Some(tn) => if !in_async {\n        Array::push(errors, EEEffectfulCallOutsideEffect(String::concat(tn, \"::next (a `for` over an async iterator awaits every step -- add `with { Async }` or wrap the loop in a handler for it)\")))\n      } else {\n        ()\n      },\n      None => ()\n    },\n    _ => ()\n  }\n  match expr {\n    EFn(_, _, params, _, effect, body) => {\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, effect_opt_is_async(effect), afe_bind_params(locals, params)))\n    },\n    EHandle(body, arms) => {\n      let discharges_async = handle_arms_handle_async(arms)\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async || discharges_async, locals))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_async_effects_expr_lo(arm_body, env, in_async, locals))\n        ai = ai + 1\n      }\n    },\n    ELet(name, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, locals))\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))))\n    },\n    ELetMut(name, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, locals))\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))))\n    },\n    ELetRec(name, val, body) => {\n      let rec_locals = afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))\n      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, rec_locals))\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, rec_locals))\n    },\n    EForIn(name, index_name, iter, body) => {\n      append_eff_errs(errors, check_async_effects_expr_lo(iter, env, in_async, locals))\n      let body_locals = match index_name {\n        Some(idx) => afe_bind_local(afe_bind_local(locals, name, None), idx, None),\n        None => afe_bind_local(locals, name, None)\n      }\n      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, body_locals))\n    },\n    _ => {\n      let children = expr_children(expr)\n      let mut i = 0\n      while i < Array::length(children) {\n        append_eff_errs(errors, check_async_effects_expr_lo(Array::get(children, i), env, in_async, locals))\n        i = i + 1\n      }\n    }\n  }\n  errors\n}\n\nfn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\n    _ => false\n  }\n}\n\nfn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {\n  let sig_async = sig_type_is_async(ty)\n  match body {\n    EFn(_, _, params, _, eff, fbody) => check_async_effects_expr_lo(fbody, env, sig_async || effect_opt_is_async(eff), afe_bind_params(afe_no_locals(), merge_param_types_with_sig(ty, params))),\n    _ => check_async_effects_expr(body, env, sig_async)\n  }\n}\n\nexport fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {\n  match stmt {\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\n    STest(_, body) => check_async_effects_expr(body, env, false),\n    SBench(_, body) => check_async_effects_expr(body, env, false),\n    SExpr(e) => check_async_effects_expr(e, env, false),\n    _ => array_empty()\n  }\n}\n\nexport fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\n  afe_set_field_types(stmts)\n  let errors = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\n    i = i + 1\n  }\n  errors\n}\n\n\nfn effect_row_parse(eff: Option[String]) -> Option[Array[String]] {\n  match eff {\n    None => None,\n    Some(s) => {\n      let labels = array_empty()\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = canonical_exception_effect_name(String::trim(Array::get(raw, i)))\n        if String::length(label) > 0 && !effect_row_has_label(Some(labels), label) {\n          Array::push(labels, label)\n        }\n        i = i + 1\n      }\n      Some(labels)\n    }\n  }\n}\n\nfn effect_row_has_label(row: Option[Array[String]], wanted: String) -> Bool {\n  match row {\n    None => false,\n    Some(labels) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(labels) {\n        if Array::get(labels, i) == wanted {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n  }\n}\n\nfn effect_row_labels(row: Option[Array[String]]) -> Array[String] {\n  match row {\n    None => array_empty(),\n    Some(labels) => labels\n  }\n}\n\nfn effect_row_inherit(row: Option[Array[String]], surrounding: Array[String]) -> Array[String] {\n  match row {\n    None => surrounding,\n    Some(labels) => labels\n  }\n}\n\nfn label_is_effect_var(name: String) -> Bool {\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n}\n\nfn row_label_base(label: String) -> String {\n  let bi = String::index_of(label, \"[\")\n  if bi > 0 {\n    label[0: bi]\n  } else {\n    label\n  }\n}\n\nfn row_base_membership(labels: Array[String], eff_name: String) -> Bool {\n  if is_exception_label(eff_name) {\n    false\n  } else {\n    let eb = row_label_base(eff_name)\n    let ehas = String::length(eb) < String::length(eff_name)\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(labels) {\n      let l = Array::get(labels, i)\n      let lb = row_label_base(l)\n      let lhas = String::length(lb) < String::length(l)\n      if (ehas || lhas) && lb == eb && !is_exception_label(l) {\n        found = true\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {\n  if effect_row_has_label(Some(labels), eff_name) {\n    true\n  } else if is_exception_effect_name(eff_name) {\n    let required_kind = exception_label_kind(eff_name)\n    let mut alias_found = false\n    let mut alias_i = 0\n    while alias_i < Array::length(labels) {\n      let declared_label = Array::get(labels, alias_i)\n      if is_exception_label(declared_label) && exception_kinds_compatible(exception_label_kind(declared_label), required_kind) {\n        alias_found = true\n      }\n      alias_i = alias_i + 1\n    }\n    alias_found\n  } else if row_base_membership(labels, eff_name) {\n    true\n  } else {\n    let mut i = 0\n    let mut has_effect_var = false\n    while i < Array::length(labels) {\n      if label_is_effect_var(Array::get(labels, i)) {\n        has_effect_var = true\n      }\n      i = i + 1\n    }\n    has_effect_var\n  }\n}\n\nfn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {\n  if decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name) {\n    true\n  } else {\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(labels) {\n      if exception_effect_labels_equal(Array::get(labels, i), op_name) {\n        found = true\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn effect_name_of_op(op_name: String) -> String {\n  let idx = String::index_of(op_name, \"::\")\n  if idx > 0 {\n    canonical_exception_effect_name(op_name[0: idx])\n  } else {\n    canonical_exception_effect_name(op_name)\n  }\n}\n\n\nfn type_kind_name(t: Type) -> String {\n  match t {\n    CtString => \"String\",\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtChar => \"Char\",\n    CtBytes => \"Bytes\",\n    CtEnum(n) => n,\n    CtStruct(n) => n,\n    CtNamed(n, _) => n,\n    _ => \"\"\n  }\n}\n\nlet throw_kind_cell: Array[(String, String, String)] = array_empty()\n\nfn throw_kind_push(name: String, ty: Type) -> Unit {\n  let fnty = match ty {\n    CtForAll(_, _, body) => body,\n    _ => ty\n  }\n  let value_kind = type_kind_name(fnty)\n  let result_kind = match fnty {\n    CtFn(_, ret, _) => type_kind_name(ret),\n    _ => \"\"\n  }\n  if String::length(value_kind) > 0 || String::length(result_kind) > 0 {\n    Array::push(throw_kind_cell, (name, value_kind, result_kind))\n  } else {\n    ()\n  }\n}\n\nfn set_throw_kind_table(env: TypeEnv) -> Unit {\n  Array::truncate(throw_kind_cell, 0)\n  let mut cur = env\n  let mut looping = true\n  while looping {\n    match cur {\n      EnvBind(name, ty, rest) => {\n        throw_kind_push(name, ty)\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest, _) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvCached(cnames, ctypes, rest) => {\n        let mut ci = 0\n        while ci < Array::length(cnames) && ci < Array::length(ctypes) {\n          throw_kind_push(Array::get(cnames, ci), Array::get(ctypes, ci))\n          ci = ci + 1\n        }\n        cur = rest\n      },\n      EnvFlat(entries) => {\n        let mut ei = 0\n        while ei < Array::length(entries) {\n          let (ename, ety) = Array::get(entries, ei)\n          throw_kind_push(ename, ety)\n          ei = ei + 1\n        }\n        looping = false\n      },\n      EnvEmpty => {\n        looping = false\n      }\n    }\n  }\n}\n\nfn throw_kind_lookup(name: String, want_result: Bool) -> String {\n  let mut i = 0\n  let mut out = \"\"\n  let mut found = false\n  while i < Array::length(throw_kind_cell) && !found {\n    let (n, value_kind, result_kind) = Array::get(throw_kind_cell, i)\n    if n == name {\n      out = if want_result {\n        result_kind\n      } else {\n        value_kind\n      }\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn no_kind_binds() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn throw_kind_bind(binds: Array[(String, String)], name: String, kind: String) -> Array[(String, String)] {\n  let out = Array::slice([\n    (name, kind)\n  ], 0, 1)\n  let mut i = 0\n  while i < Array::length(binds) {\n    Array::push(out, Array::get(binds, i))\n    i = i + 1\n  }\n  out\n}\n\nfn throw_kind_bind_pat(binds: Array[(String, String)], pat: Pat) -> Array[(String, String)] {\n  let names = no_str_labels()\n  collect_pat_binds_into(pat, names)\n  let mut cur = binds\n  let mut i = 0\n  while i < Array::length(names) {\n    cur = throw_kind_bind(cur, Array::get(names, i), \"\")\n    i = i + 1\n  }\n  cur\n}\n\nfn throw_kind_bind_params(binds: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {\n  let mut cur = binds\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ptype) = Array::get(params, i)\n    let kind = match ptype {\n      Some(te) => match afe_texpr_head_name(te) {\n        Some(h) => h,\n        None => \"\"\n      },\n      None => \"\"\n    }\n    cur = throw_kind_bind(cur, pname, kind)\n    i = i + 1\n  }\n  cur\n}\n\nfn throw_payload_kind(payload: Expr, binds: Array[(String, String)]) -> String {\n  match payload {\n    EString(_) => \"String\",\n    EStringInterp(_) => \"String\",\n    EInt(_) => \"Int\",\n    EFloat(_) => \"Double\",\n    EBool(_) => \"Bool\",\n    ERecord(sname, _, _) => sname,\n    EIdent(n, _) => match afe_lookup_local(binds, n) {\n      Some(k) => k,\n      None => throw_kind_lookup(n, false)\n    },\n    ECall(callee, _, _) => match callee {\n      EIdent(f, _) => match afe_lookup_local(binds, f) {\n        Some(_) => \"\",\n        None => throw_kind_lookup(f, true)\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn throw_required_label(op_name: String, opargs: Array[Expr], binds: Array[(String, String)]) -> String {\n  if is_exception_throw_operation(op_name) && Array::length(opargs) == 1 {\n    exception_throw_label_for_kind(throw_payload_kind(Array::get(opargs, 0), binds))\n  } else {\n    op_name\n  }\n}\n\nfn throw_report_label(op_name: String, required: String, declared: Array[String]) -> String {\n  let mut i = 0\n  let mut typed_row = false\n  while i < Array::length(declared) {\n    if is_exception_label(Array::get(declared, i)) {\n      typed_row = true\n    }\n    i = i + 1\n  }\n  if typed_row {\n    required\n  } else {\n    op_name\n  }\n}\n\nfn builtin_call_op_label(name: String, eff: String) -> String {\n  let normalized = canonical_builtin_name(name)\n  if String::index_of(normalized, \"::\") > 0 {\n    normalized\n  } else {\n    eff\n  }\n}\n\nfn builtin_call_effect(name: String) -> Option[String] {\n  if name == \"sh\" || name == \"sh_lines\"\n  || name == \"vibe_sh_capture_raw\"\n  || name == \"vibe_sh_capture_exit_code_raw\"\n  || name == \"vibe_sh_capture_stdout_raw\"\n  || name == \"vibe_sh_capture_stderr_raw\"\n  || name == \"vibe_sh_capture_close_raw\"\n  || name == \"vibe_process_exit_raw\" {\n    Some(\"Process\")\n  } else if String::index_of(name, \"::\") < 0 {\n    None\n  } else {\n    let normalized = canonical_builtin_name(name)\n    match lookup_builtin(normalized) {\n      Some(ty) => match ty {\n        CtFn(_, _, Some(eff)) => if is_exception_effect_name(eff) {\n          None\n        } else if eff == \"Async\" {\n          None\n        } else {\n          Some(eff)\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nfn labels_union(a: Array[String], b: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    let l = Array::get(b, j)\n    let mut seen = false\n    let mut k = 0\n    while k < Array::length(out) {\n      if Array::get(out, k) == l {\n        seen = true\n      }\n      k = k + 1\n    }\n    if !seen {\n      Array::push(out, l)\n    }\n    j = j + 1\n  }\n  out\n}\n\nfn label_lt(a: String, b: String) -> Bool {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let n = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut decided = 0\n  while i < n && decided == 0 {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      decided = 1\n    } else if ca > cb {\n      decided = 2\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if decided == 1 {\n    true\n  } else if decided == 2 {\n    false\n  } else {\n    la < lb\n  }\n}\n\nfn sort_labels(xs: Array[String]) -> Array[String] {\n  let out = Array::slice(xs, 0, Array::length(xs))\n  let mut i = 1\n  while i < Array::length(out) {\n    let key = Array::get(out, i)\n    let mut j = i\n    while j > 0 && label_lt(key, Array::get(out, j - 1)) {\n      Array::set(out, j, Array::get(out, j - 1))\n      j = j - 1\n    }\n    Array::set(out, j, key)\n    i = i + 1\n  }\n  out\n}\n\nfn join_labels(xs: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(xs) {\n    if i == 0 {\n      out = Array::get(xs, i)\n    } else {\n      out = String::concat(out, String::concat(\", \", Array::get(xs, i)))\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String]) -> EffectError {\n  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))\n  let required = sort_labels(labels_union(declared, missing))\n  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(declared), join_labels(required))\n}\n\nfn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, _) = Array::get(arms, i)\n    match pat {\n      PCtor(name, _) => {\n        let idx = String::index_of(name, \"::\")\n        if idx > 0 {\n          let eff = canonical_exception_effect_name(name[0: idx])\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == eff {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, eff)\n          }\n          let mut qseen = false\n          let mut k = 0\n          while k < Array::length(out) {\n            if Array::get(out, k) == name {\n              qseen = true\n            }\n            k = k + 1\n          }\n          if !qseen {\n            Array::push(out, name)\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {\n  let sig = sig_type_effect_labels(ty)\n  match body {\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_row_labels(effect_row_parse(eff))),\n    _ => sig\n  }\n}\n\nfn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(names) {\n    match found {\n      None => if Array::get(names, i) == name {\n        found = Some(Array::get(effs, i))\n      } else {\n        ()\n      },\n      Some(_) => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\n  let mut cur_names = names\n  let mut cur_effs = effs\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, _) = Array::get(params, i)\n    let shadowed = shadow_overlay(cur_names, cur_effs, pname)\n    cur_names = shadowed.0\n    cur_effs = shadowed.1\n    i = i + 1\n  }\n  (cur_names, cur_effs)\n}\n\nfn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {\n  let out_names = array_empty()\n  let out_effs = array_empty()\n  let mut i = 0\n  while i < Array::length(names) {\n    if Array::get(names, i) != name {\n      Array::push(out_names, Array::get(names, i))\n      Array::push(out_effs, Array::get(effs, i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  (out_names, out_effs)\n}\n\nfn local_fn_overlay_labels(val: Expr) -> Array[String] {\n  match val {\n    EFn(_, _, _, _, eff, _) => effect_row_labels(effect_row_parse(eff)),\n    _ => no_str_labels()\n  }\n}\n\nfn overlay_bind_local(names: Array[String], effs: Array[Array[String]], name: String, val: Expr) -> (Array[String], Array[Array[String]]) {\n  let shadowed = shadow_overlay(names, effs, name)\n  let labels = local_fn_overlay_labels(val)\n  if Array::length(labels) == 0 {\n    shadowed\n  } else {\n    let out_names = [\n      name\n    ]\n    let out_effs = [\n      labels\n    ]\n    let (sn, se) = shadowed\n    let mut i = 0\n    while i < Array::length(sn) {\n      Array::push(out_names, Array::get(sn, i))\n      Array::push(out_effs, Array::get(se, i))\n      i = i + 1\n    }\n    (out_names, out_effs)\n  }\n}\n\nfn build_param_overlay(params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\n  let names = array_empty()\n  let effs = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ptype) = Array::get(params, i)\n    match ptype {\n      Some(TyFn(_, _, eff)) => {\n        let labels = effect_row_labels(effect_row_parse(eff))\n        if Array::length(labels) > 0 {\n          Array::push(names, pname)\n          Array::push(effs, labels)\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (names, effs)\n}\n\nfn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  match ty {\n    Some(TyFn(sig_params, _, _)) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, ptype) = Array::get(params, i)\n        let effective = match ptype {\n          Some(_) => ptype,\n          None => if i < Array::length(sig_params) {\n            Some(Array::get(sig_params, i))\n          } else {\n            None\n          }\n        }\n        Array::push(out, (pname, effective))\n        i = i + 1\n      }\n      out\n    },\n    _ => params\n  }\n}\n\nexport fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {\n  check_perform_effects_expr_tx_in(\"\", root, root_declared, root_in_handle, fn_names, fn_effs, root_ov_names, root_ov_effs, no_kind_binds())\n}\n\nfn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]], root_kinds: Array[(String, String)]) -> Array[EffectError] {\n  let errors = array_empty()\n  let stack = Array::slice([\n    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs, root_kinds)\n  ], 0, 1)\n  while Array::length(stack) > 0 {\n    let n = Array::length(stack)\n    let (expr, declared, in_handle, ov_names, ov_effs, kinds) = Array::get(stack, n - 1)\n    Array::truncate(stack, n - 1)\n    match expr {\n      ECall(callee, args, _) => {\n        match callee {\n          EIdent(name, _) => {\n            if name == \"perform\" && Array::length(args) == 1 {\n              match Array::get(args, 0) {\n                ECall(op_callee, opargs, _) => match op_callee {\n                  EIdent(op_name, _) => {\n                    let eff = effect_name_of_op(op_name)\n                    let required_op = throw_required_label(op_name, opargs, kinds)\n                    if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, required_op) {\n                      Array::push(errors, make_row_mismatch(fn_name, declared, [\n                        throw_report_label(op_name, required_op, declared)\n                      ]))\n                    } else {\n                      ()\n                    }\n                  },\n                  _ => ()\n                },\n                EIdent(op_name, _) => {\n                  let eff = effect_name_of_op(op_name)\n                  if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {\n                    Array::push(errors, make_row_mismatch(fn_name, declared, [\n                      op_name\n                    ]))\n                  } else {\n                    ()\n                  }\n                },\n                _ => ()\n              }\n            } else {\n              match builtin_call_effect(name) {\n                Some(eff) => {\n                  let op_label = builtin_call_op_label(name, eff)\n                  if !in_handle && !decl_authorizes_effect(declared, eff) && !decl_authorizes_effect(declared, op_label) {\n                    Array::push(errors, make_row_mismatch(fn_name, declared, [\n                      op_label\n                    ]))\n                  } else {\n                    ()\n                  }\n                },\n                None => ()\n              }\n            }\n            match lookup_fn_effs(fn_names, fn_effs, name) {\n              Some(callee_effs) => {\n                let missing = no_str_labels()\n                let mut ti = 0\n                while ti < Array::length(callee_effs) {\n                  let teff = Array::get(callee_effs, ti)\n                  if String::length(teff) > 0 && (!is_exception_effect_name(teff) || error_row_checked()) && teff != \"Async\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_op(declared, teff) {\n                    Array::push(missing, teff)\n                  } else {\n                    ()\n                  }\n                  ti = ti + 1\n                }\n                if Array::length(missing) > 0 {\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\n                } else {\n                  ()\n                }\n              },\n              None => ()\n            }\n            match lookup_fn_effs(ov_names, ov_effs, name) {\n              Some(param_effs) => {\n                let missing = no_str_labels()\n                let mut pi = 0\n                while pi < Array::length(param_effs) {\n                  let peff = Array::get(param_effs, pi)\n                  if String::length(peff) > 0 && (!is_exception_effect_name(peff) || error_row_checked()) && peff != \"Async\" && !in_handle && !decl_authorizes_op(declared, peff) {\n                    Array::push(missing, peff)\n                  } else {\n                    ()\n                  }\n                  pi = pi + 1\n                }\n                if Array::length(missing) > 0 {\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\n                } else {\n                  ()\n                }\n              },\n              None => ()\n            }\n          },\n          _ => ()\n        }\n        Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs, kinds))\n        let mut ai = 0\n        while ai < Array::length(args) {\n          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs, kinds))\n          ai = ai + 1\n        }\n      },\n      EFn(_, _, params, _, effect, body) => {\n        let body_declared = effect_row_inherit(effect_row_parse(effect), declared)\n        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)\n        let (shadowed_ov_names, shadowed_ov_effs) = shadowed\n        let (local_names, local_effs) = build_param_overlay(params)\n        let body_ov_names = if Array::length(local_names) == 0 {\n          shadowed_ov_names\n        } else {\n          let merged = Array::slice(local_names, 0, Array::length(local_names))\n          let mut oi = 0\n          while oi < Array::length(shadowed_ov_names) {\n            Array::push(merged, Array::get(shadowed_ov_names, oi))\n            oi = oi + 1\n          }\n          merged\n        }\n        let body_ov_effs = if Array::length(local_effs) == 0 {\n          shadowed_ov_effs\n        } else {\n          let merged = Array::slice(local_effs, 0, Array::length(local_effs))\n          let mut oi = 0\n          while oi < Array::length(shadowed_ov_effs) {\n            Array::push(merged, Array::get(shadowed_ov_effs, oi))\n            oi = oi + 1\n          }\n          merged\n        }\n        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs, throw_kind_bind_params(kinds, params)))\n      },\n      EHandle(body, arms) => {\n        let discharged = collect_handle_effects(arms)\n        let body_declared = labels_union(declared, discharged)\n        let body_in_handle = if Array::length(discharged) == 0 {\n          true\n        } else {\n          in_handle\n        }\n        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs, kinds))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (arm_pat, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs, throw_kind_bind_pat(kinds, arm_pat)))\n          ai = ai + 1\n        }\n      },\n      ELet(name, val, body, _) => {\n        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val)\n        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))\n      },\n      ELetRec(name, val, body) => {\n        let (rec_ov_names, rec_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val)\n        let rec_kinds = throw_kind_bind(kinds, name, \"\")\n        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))\n        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))\n      },\n      ELetMut(name, val, body, _) => {\n        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val)\n        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))\n      },\n      ESeq(a, b) => {\n        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      EIf(cond, then_e, else_e) => {\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      EMatch(scrutinee, arms) => {\n        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs, kinds))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (arm_pat, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs, throw_kind_bind_pat(kinds, arm_pat)))\n          ai = ai + 1\n        }\n      },\n      EWhile(cond, body) => {\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      ELoop(params, body) => {\n        let mut body_kinds = kinds\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, init) = Array::get(params, i)\n          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs, kinds))\n          body_kinds = throw_kind_bind(body_kinds, pname, \"\")\n          i = i + 1\n        }\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs, body_kinds))\n      },\n      EForIn(value_name, index_name, iter, body) => {\n        let for_kinds = match index_name {\n          Some(iname) => throw_kind_bind(throw_kind_bind(kinds, value_name, \"\"), iname, \"\"),\n          None => throw_kind_bind(kinds, value_name, \"\")\n        }\n        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs, for_kinds))\n      },\n      EBinOp(_, left, right) => {\n        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs, kinds)),\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs, kinds)),\n      EAssign(_, val, cont) => {\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      EAssignOp(_, _, val, cont) => {\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))\n      },\n      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs, kinds)),\n      ETuple(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))\n          ei = ei + 1\n        }\n      },\n      EArray(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))\n          ei = ei + 1\n        }\n      },\n      ERecord(_, fields, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fval) = Array::get(fields, fi)\n          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs, kinds))\n          fi = fi + 1\n        }\n      },\n      EMap(fields) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fval) = Array::get(fields, fi)\n          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs, kinds))\n          fi = fi + 1\n        }\n      },\n      ELabeledArg(_, _, value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),\n      ESpread(value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),\n      EBreak(Some(value)) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),\n      EBreak(None) => (),\n      EContinue(args) => {\n        let mut ai = 0\n        while ai < Array::length(args) {\n          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs, kinds))\n          ai = ai + 1\n        }\n      },\n      _ => {\n        let children = expr_children(expr)\n        let mut i = 0\n        while i < Array::length(children) {\n          Array::push(stack, (Array::get(children, i), declared, in_handle, ov_names, ov_effs, kinds))\n          i = i + 1\n        }\n      }\n    }\n  }\n  errors\n}\n\nfn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),\n    _ => effect_row_labels(effect_row_parse(None))\n  }\n}\n\nfn no_str_labels() -> Array[String] {\n  array_empty()\n}\n\nfn no_ov_effs() -> Array[Array[String]] {\n  array_empty()\n}\n\nexport fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {\n  set_throw_kind_table(EnvEmpty)\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())\n}\n\nfn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\n  let sig_labels = sig_type_effect_labels(ty)\n  match body {\n    EFn(_, _, params, _, eff, fbody) => {\n      let merged_params = merge_param_types_with_sig(ty, params)\n      let (ov_names, ov_effs) = build_param_overlay(merged_params)\n      check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(sig_labels, effect_row_labels(effect_row_parse(eff))), false, fn_names, fn_effs, ov_names, ov_effs, throw_kind_bind_params(no_kind_binds(), merged_params))\n    },\n    _ => check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, no_str_labels(), no_ov_effs(), no_kind_binds())\n  }\n}\n\nlet error_row_mode_cell = array_empty()\n\nexport fn set_error_row_checked(on: Bool) -> Unit {\n  Array::truncate(error_row_mode_cell, 0)\n  Array::push(error_row_mode_cell, if on {\n    1\n  } else {\n    0\n  })\n}\n\nfn error_row_checked() -> Bool {\n  Array::length(error_row_mode_cell) > 0 && Array::get(error_row_mode_cell, 0) == 1\n}\n\nfn test_bench_ambient_effects() -> Array[String] {\n  [\n    \"Fs\",\n    \"Env\",\n    \"Stdin\",\n    \"Stdout\",\n    \"Stderr\",\n    \"Process\",\n    \"Profiler\",\n    \"Error\"\n  ]\n}\n\nfn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\n  match stmt {\n    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\n    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\n    STest(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\n    SBench(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_row_labels(effect_row_parse(None)), false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n    _ => array_empty()\n  }\n}\n\nexport fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {\n  set_throw_kind_table(EnvEmpty)\n  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs())\n}\n\nfn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let fnty = match ty {\n    CtForAll(_, _, body) => body,\n    _ => ty\n  }\n  match fnty {\n    CtFn(_, _, eff) => {\n      let labels = effect_row_labels(effect_row_parse(eff))\n      if Array::length(labels) > 0 {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, labels)\n      } else {\n        ()\n      }\n    },\n    _ => ()\n  }\n}\n\nfn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let mut cur = env\n  let mut looping = true\n  while looping {\n    match cur {\n      EnvBind(name, ty, rest) => {\n        push_env_fn_eff(name, ty, fn_names, fn_effs)\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest, _) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvCached(_, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(entries) => {\n        let mut ei = 0\n        while ei < Array::length(entries) {\n          let (ename, ety) = Array::get(entries, ei)\n          push_env_fn_eff(ename, ety, fn_names, fn_effs)\n          ei = ei + 1\n        }\n        looping = false\n      },\n      EnvEmpty => {\n        looping = false\n      }\n    }\n  }\n}\n\nfn build_perform_fn_effs(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n}\n\nexport fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\n  check_perform_effects_stmts_env(stmts, EnvEmpty)\n}\n\nexport fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  build_perform_fn_effs(stmts, fn_names, fn_effs)\n  seed_env_fn_effs(env, fn_names, fn_effs)\n  set_throw_kind_table(env)\n  let errors = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\n    i = i + 1\n  }\n  if Array::length(errors) == 0 {\n    append_eff_errs(errors, check_dead_handles_stmts(stmts, fn_names, fn_effs))\n  } else {\n    ()\n  }\n  errors\n}\n\n\nfn dh_effect_of_perform_arg(arg: Expr) -> String {\n  match arg {\n    ECall(EIdent(op_name, _), _, _) => effect_name_of_op(op_name),\n    EIdent(op_name, _) => effect_name_of_op(op_name),\n    _ => \"\"\n  }\n}\n\nfn dh_perform_effect(expr: Expr) -> String {\n  match expr {\n    ECall(EIdent(name, _), args, _) => if name == \"perform\" && Array::length(args) == 1 {\n      dh_effect_of_perform_arg(Array::get(args, 0))\n    } else {\n      \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn dh_collect_performed_into(expr: Expr, acc: Array[String]) -> Unit {\n  let eff = dh_perform_effect(expr)\n  if String::length(eff) > 0 && !effect_row_has_label(Some(acc), eff) {\n    Array::push(acc, eff)\n  } else {\n    ()\n  }\n  let children = expr_children(expr)\n  let mut i = 0\n  while i < Array::length(children) {\n    dh_collect_performed_into(Array::get(children, i), acc)\n    i = i + 1\n  }\n}\n\nfn dh_collect_performed_effects(stmts: Array[Stmt]) -> Array[String] {\n  let acc = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => dh_collect_performed_into(body, acc),\n      SLetMut(_, _, body) => dh_collect_performed_into(body, acc),\n      SExpr(e) => dh_collect_performed_into(e, acc),\n      STest(_, body) => dh_collect_performed_into(body, acc),\n      SBench(_, body) => dh_collect_performed_into(body, acc),\n      _ => ()\n    }\n    i = i + 1\n  }\n  acc\n}\n\nfn dh_declared_effects(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, _) => if effect_row_has_label(Some(out), name) {\n        ()\n      } else {\n        Array::push(out, name)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn dh_labels_may_be(labels: Array[String], ename: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(labels) {\n    let l = Array::get(labels, i)\n    if label_is_effect_var(l) || row_label_base(effect_name_of_op(l)) == ename {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn dh_texpr_may_be(t: TypeExpr, ename: String) -> Bool {\n  match t {\n    TyFn(ps, ret, eff) => if dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) {\n      true\n    } else {\n      dh_texprs_may_be(ps, ename) || dh_texpr_may_be(ret, ename)\n    },\n    TyApp(_, args) => dh_texprs_may_be(args, ename),\n    TyTuple(elems) => dh_texprs_may_be(elems, ename),\n    _ => false\n  }\n}\n\nfn dh_texprs_may_be(ts: Array[TypeExpr], ename: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(ts) && !found {\n    found = dh_texpr_may_be(Array::get(ts, i), ename)\n    i = i + 1\n  }\n  found\n}\n\nfn dh_params_may_be(params: Array[(String, Option[TypeExpr])], ename: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) && !found {\n    let (_, pty) = Array::get(params, i)\n    found = match pty {\n      Some(t) => dh_texpr_may_be(t, ename),\n      None => false\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn dh_may_reach(expr: Expr, ename: String, fn_names: Array[String], fn_effs: Array[Array[String]], ov_names: Array[String], ov_effs: Array[Array[String]]) -> Bool {\n  if dh_perform_effect(expr) == ename {\n    true\n  } else {\n    let direct = match expr {\n      ECall(EIdent(nm, _), _, _) => match lookup_fn_effs(fn_names, fn_effs, nm) {\n        Some(effs) => dh_labels_may_be(effs, ename),\n        None => match lookup_fn_effs(ov_names, ov_effs, nm) {\n          Some(effs) => dh_labels_may_be(effs, ename),\n          None => false\n        }\n      },\n      EFn(_, _, params, ret, eff, _) => dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) || dh_params_may_be(params, ename) || (match ret {\n        Some(rt) => dh_texpr_may_be(rt, ename),\n        None => false\n      }),\n      EHandle(_, _) => true,\n      _ => false\n    }\n    if direct {\n      true\n    } else {\n      let children = expr_children(expr)\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(children) {\n        if !found && dh_may_reach(Array::get(children, i), ename, fn_names, fn_effs, ov_names, ov_effs) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    }\n  }\n}\n\nfn dh_callee_is_opaque(nm: String, fn_names: Array[String]) -> Bool {\n  if String::length(nm) == 0 || nm == \"perform\" || nm == \"resume\" {\n    false\n  } else if String::index_of(nm, \"::\") >= 0 {\n    false\n  } else {\n    let c = String::char_code_at(nm, 0)\n    if c >= 65 && c <= 90 {\n      false\n    } else if effect_row_has_label(Some(fn_names), nm) {\n      false\n    } else {\n      match lookup_builtin(canonical_builtin_name(nm)) {\n        Some(_) => false,\n        None => true\n      }\n    }\n  }\n}\n\nfn dh_has_opaque_call(expr: Expr, fn_names: Array[String]) -> Bool {\n  let direct = match expr {\n    ECall(EIdent(nm, _), _, _) => dh_callee_is_opaque(nm, fn_names),\n    _ => false\n  }\n  if direct {\n    true\n  } else {\n    let children = expr_children(expr)\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(children) {\n      if !found && dh_has_opaque_call(Array::get(children, i), fn_names) {\n        found = true\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn dh_check_expr(expr: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], ov_names: Array[String], ov_effs: Array[Array[String]], errors: Array[EffectError]) -> Unit {\n  match expr {\n    EHandle(body, arms) => {\n      let handled = collect_handle_effects(arms)\n      let mut i = 0\n      while i < Array::length(handled) {\n        let eff = Array::get(handled, i)\n        if effect_row_has_label(Some(declared), eff) && effect_row_has_label(Some(performed), eff) && !dh_may_reach(body, eff, fn_names, fn_effs, ov_names, ov_effs) && dh_has_opaque_call(body, fn_names) {\n          Array::push(errors, EEHandleNeverFires(eff))\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      dh_check_expr(body, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        dh_check_expr(arm_body, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)\n        ai = ai + 1\n      }\n    },\n    EFn(_, _, params, _, _, body) => {\n      let (bn, be) = dh_overlay_with_params(ov_names, ov_effs, params)\n      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)\n    },\n    ELet(name, val, body, _) => {\n      dh_check_expr(val, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)\n      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val)\n      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)\n    },\n    ELetMut(name, val, body, _) => {\n      dh_check_expr(val, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)\n      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val)\n      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)\n    },\n    ELetRec(name, val, body) => {\n      let (rn, re) = overlay_bind_local(ov_names, ov_effs, name, val)\n      dh_check_expr(val, declared, performed, fn_names, fn_effs, rn, re, errors)\n      dh_check_expr(body, declared, performed, fn_names, fn_effs, rn, re, errors)\n    },\n    _ => {\n      let children = expr_children(expr)\n      let mut c = 0\n      while c < Array::length(children) {\n        dh_check_expr(Array::get(children, c), declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)\n        c = c + 1\n      }\n    }\n  }\n}\n\nfn dh_param_base_name(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 {\n    let last = n[ln - 1: ln]\n    if last == \"~\" || last == \"?\" {\n      n[0: ln - 1]\n    } else {\n      n\n    }\n  } else {\n    n\n  }\n}\n\nfn dh_overlay_with_params(ov_names: Array[String], ov_effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\n  let (sn, se) = shadow_overlay_names(ov_names, ov_effs, params)\n  let (raw_ln, le) = build_param_overlay(params)\n  let ln = for n in raw_ln {\n    dh_param_base_name(n)\n  }\n  if Array::length(ln) == 0 {\n    (sn, se)\n  } else {\n    let names = Array::slice(ln, 0, Array::length(ln))\n    let effs = Array::slice(le, 0, Array::length(le))\n    let mut i = 0\n    while i < Array::length(sn) {\n      Array::push(names, Array::get(sn, i))\n      Array::push(effs, Array::get(se, i))\n      i = i + 1\n    }\n    (names, effs)\n  }\n}\n\nfn dh_check_binding(ty: Option[TypeExpr], body: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], errors: Array[EffectError]) -> Unit {\n  match body {\n    EFn(_, _, params, _, _, fbody) => {\n      let (n, e) = dh_overlay_with_params(no_str_labels(), no_ov_effs(), merge_param_types_with_sig(ty, params))\n      dh_check_expr(fbody, declared, performed, fn_names, fn_effs, n, e, errors)\n    },\n    _ => dh_check_expr(body, declared, performed, fn_names, fn_effs, no_str_labels(), no_ov_effs(), errors)\n  }\n}\n\nfn check_dead_handles_stmts(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\n  let errors = array_empty()\n  let declared = dh_declared_effects(stmts)\n  if Array::length(declared) == 0 {\n    errors\n  } else {\n    let performed = dh_collect_performed_effects(stmts)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(_, _, _, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, errors),\n        SLetMut(_, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, errors),\n        SExpr(e) => dh_check_binding(None, e, declared, performed, fn_names, fn_effs, errors),\n        STest(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, errors),\n        SBench(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, errors),\n        _ => ()\n      }\n      i = i + 1\n    }\n    errors\n  }\n}\n\nexport fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n  let empty_decl = array_empty()\n  let mut any_test = false\n  let mut all_ok = true\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(_, body) => {\n        any_test = true\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n        if Array::length(errs) != 0 {\n          all_ok = false\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  any_test && all_ok\n}\n\nexport fn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool {\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  let mut entry_body = None\n  let mut entry_declared = None\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        let effs = fn_binding_effects(ty, body)\n        Array::push(fn_names, name)\n        Array::push(fn_effs, effs)\n        if name == entry_name {\n          entry_body = Some(body)\n          entry_declared = Some(effs)\n        } else {\n          ()\n        }\n      },\n      SLetMut(name, ty, body) => {\n        let effs = fn_binding_effects(ty, body)\n        Array::push(fn_names, name)\n        Array::push(fn_effs, effs)\n        if name == entry_name {\n          entry_body = Some(body)\n          entry_declared = Some(effs)\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n  match entry_body {\n    None => false,\n    Some(body) => {\n      let cache_safe_row = [\n        \"Stdout\",\n        \"Error\",\n        \"Exception\",\n        \"Async\"\n      ]\n      let declared_ok = match entry_declared {\n        None => true,\n        Some(row) => array_is_subset_of_str(row, cache_safe_row)\n      }\n      if !declared_ok {\n        false\n      } else {\n        let exec_body = match body {\n          EFn(_, _, _, _, _, fn_body) => fn_body,\n          _ => body\n        }\n        let errs = check_perform_effects_expr_tx(exec_body, cache_safe_row, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n        Array::length(errs) == 0\n      }\n    }\n  }\n}\n\nfn array_is_subset_of_str(row: Array[String], safe: Array[String]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(row) {\n    let eff = effect_name_of_op(Array::get(row, i))\n    let mut j = 0\n    let mut found = false\n    while j < Array::length(safe) {\n      if Array::get(safe, j) == eff {\n        found = true\n      } else {\n        ()\n      }\n      j = j + 1\n    }\n    if !found {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\n\nfn mut_has(xs: Array[String], n: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(xs) {\n    if Array::get(xs, i) == n {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn mut_with(base: Array[String], name: String) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  Array::push(out, name)\n  out\n}\n\nfn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(acc, name),\n    PCtor(_, subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    PTuple(subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    POr(l, r) => {\n      collect_pat_binds_into(l, acc)\n      collect_pat_binds_into(r, acc)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        collect_pat_binds_into(fp, acc)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  collect_pat_binds_into(pat, out)\n  out\n}\n\nfn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, _) = Array::get(params, i)\n    Array::push(out, pname)\n    i = i + 1\n  }\n  out\n}\n\nexport fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {\n  let errors = array_empty()\n  match expr {\n    ECall(callee, args, _) => {\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\n      let mut ai = 0\n      while ai < Array::length(args) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, params, _, _, body) => {\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\n      errors\n    },\n    EHandle(body, arms) => {\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetRec(_, val, body) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetMut(name, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\n      errors\n    },\n    ESeq(a, b) => {\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELoop(params, body) => {\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\n        Array::push(loopmut, pname)\n        i = i + 1\n      }\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\n      errors\n    },\n    EForIn(name, index_name, iter, body) => {\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\n      let base = mut_with(mutable, name)\n      let formut = match index_name {\n        Some(idx) => mut_with(base, idx),\n        None => base\n      }\n      append_eff_errs(errors, check_mutability_expr(body, formut))\n      errors\n    },\n    EBinOp(_, left, right) => {\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\n      errors\n    },\n    EReturn(e) => check_mutability_expr(e, mutable),\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\n    EAssign(name, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EAssignOp(name, _, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields, _) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\n        fi = fi + 1\n      }\n      errors\n    },\n    EMap(entries) => {\n      let mut mi = 0\n      while mi < Array::length(entries) {\n        let (_, mval) = Array::get(entries, mi)\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\n        mi = mi + 1\n      }\n      errors\n    },\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\n    ESpread(inner) => check_mutability_expr(inner, mutable),\n    EBreak(opt) => match opt {\n      Some(e) => check_mutability_expr(e, mutable),\n      None => errors\n    },\n    EContinue(cargs) => {\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\n        ci = ci + 1\n      }\n      errors\n    },\n    _ => {\n      let children = expr_children(expr)\n      let mut i = 0\n      while i < Array::length(children) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(children, i), mutable))\n        i = i + 1\n      }\n      errors\n    }\n  }\n}\n\nfn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {\n  match body {\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),\n    _ => check_mutability_expr(body, outer)\n  }\n}\n\nexport fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\n  let errors = array_empty()\n  let mut mutable = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),\n      SLetMut(name, _, body) => {\n        append_eff_errs(errors, check_mutability_binding(body, mutable))\n        mutable = mut_with(mutable, name)\n      },\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  errors\n}\n")
}

let source_57 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  env_bind,\n  env_lookup,\n  exception_effect_kind,\n  exception_effect_labels_equal,\n  find_typedef,\n  fresh_var,\n  generalize,\n  instantiate,\n  is_exception_effect_name,\n  is_exception_label,\n  is_exception_throw_handler_name,\n  is_exception_throw_operation,\n  resolve_builtin,\n  subst_add_bound,\n  subst_apply,\n  subst_bounds_for,\n  trait_method_sig_deep,\n  type_implements_trait,\n  type_name_has_iterator_impl,\n  type_to_string,\n  unify\n}\n\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\n\n\n\nfn min_int(a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nfn off_marker(off: Int) -> String {\n  if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\nfn off_marker_len(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else {\n    off_marker(off)\n  }\n}\n\nfn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = array_empty()\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn subst_self_in_type(ty: Type, self_ty: Type) -> Type {\n  match ty {\n    CtNamed(n, args) => if n == \"Self\" {\n      self_ty\n    } else {\n      let ra = for a in args {\n        subst_self_in_type(a, self_ty)\n      }\n      CtNamed(n, ra)\n    },\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_self_in_type(e, self_ty)\n    }),\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\n      subst_self_in_type(p, self_ty)\n    }, subst_self_in_type(ret, self_ty), eff),\n    _ => ty\n  }\n}\n\nfn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {\n  match ty {\n    CtNamed(n, args) => {\n      let known = match find_typedef(defs, n) {\n        Some(_) => true,\n        None => match resolve_builtin(n) {\n          Some(_) => true,\n          None => false\n        }\n      }\n      if known {\n        CtNamed(n, for a in args {\n          relax_unknown_named(a, defs)\n        })\n      } else {\n        CtUnknown\n      }\n    },\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\n    CtTuple(es) => CtTuple(for e in es {\n      relax_unknown_named(e, defs)\n    }),\n    CtFn(ps, r, eff) => CtFn(for p in ps {\n      relax_unknown_named(p, defs)\n    }, relax_unknown_named(r, defs), eff),\n    _ => ty\n  }\n}\n\nfn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let method = String::substring(name, idx + 2, String::length(name))\n    match env_lookup(env, head) {\n      Some(head_ty) => match head_ty {\n        CtVar(vid) => {\n          let bounds = subst_bounds_for(s, vid)\n          let self_ty = CtVar(vid)\n          let mut result = None\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let pending = match result {\n              None => true,\n              _ => false\n            }\n            if pending {\n              let trait_name = Array::get(bounds, bi)\n              match trait_method_sig_deep(env, trait_name, method) {\n                Some(sig) => {\n                  let (params_te, ret_te) = sig\n                  let resolved_params = for pte in params_te {\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\n                  }\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\n                },\n                None => ()\n              }\n            } else {\n              ()\n            }\n            bi = bi + 1\n          }\n          result\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nfn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef]) -> Option[Type] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    match find_typedef(defs, head) {\n      Some(TDEnum(_, _, variants)) => {\n        let mut found = false\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          if vname == member {\n            found = true\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n        if found {\n          env_lookup(env, member)\n        } else {\n          None\n        }\n      },\n      _ => None\n    }\n  }\n}\n\nfn expr_ident_name_or_empty(expr: Expr) -> String {\n  match expr {\n    EIdent(name, _) => name,\n    _ => \"\"\n  }\n}\n\nfn strip_effects(ty: Type) -> Type {\n  match ty {\n    CtFn(params, ret, _) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(out, strip_effects(Array::get(params, i)))\n        i = i + 1\n      }\n      CtFn(out, strip_effects(ret), None)\n    },\n    CtArray(elem) => CtArray(strip_effects(elem)),\n    CtOption(elem) => CtOption(strip_effects(elem)),\n    CtTuple(elems) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, strip_effects(Array::get(elems, i)))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, strip_effects(Array::get(args, i)))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => ty\n  }\n}\n\nfn arm_body_diverges(body: Expr) -> Bool {\n  match body {\n    EReturn(_) => true,\n    ESeq(_, rest) => arm_body_diverges(rest),\n    _ => false\n  }\n}\n\nfn railway_head(t: Type) -> Int {\n  match t {\n    CtOption(_) => 1,\n    CtEnum(n) => if n == \"Result\" {\n      2\n    } else if n == \"Option\" {\n      1\n    } else {\n      0\n    },\n    CtNamed(n, _) => if n == \"Result\" {\n      2\n    } else if n == \"Option\" {\n      1\n    } else {\n      0\n    },\n    _ => 0\n  }\n}\n\nfn railway_heads_conflict(expected: Type, actual: Type) -> Bool {\n  let he = railway_head(expected)\n  let ha = railway_head(actual)\n  he != 0 && ha != 0 && he != ha\n}\n\nfn railway_expr_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      railway_expr_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      railway_expr_off(base)\n    },\n    EBinOp(_, lhs, _) => railway_expr_off(lhs),\n    EMatch(scrut, _) => railway_expr_off(scrut),\n    ESeq(first, _) => railway_expr_off(first),\n    _ => 0 - 1\n  }\n}\n\nfn type_is_ground(t: Type) -> Bool {\n  match t {\n    CtNamed(_, _) => false,\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_is_ground(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_is_ground(e),\n    CtOption(e) => type_is_ground(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_is_ground(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_is_ground(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nfn type_is_ground_except(t: Type, allowed: Array[String]) -> Bool {\n  match t {\n    CtNamed(nm, targs) => if Array::length(targs) == 0 {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(allowed) {\n        if Array::get(allowed, i) == nm {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    } else {\n      false\n    },\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_is_ground_except(Array::get(items, i), allowed) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_is_ground_except(e, allowed),\n    CtOption(e) => type_is_ground_except(e, allowed),\n    CtFn(ps, r, _) => {\n      let mut ok = type_is_ground_except(r, allowed)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_is_ground_except(Array::get(ps, i), allowed) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nfn type_mentions_named(ty: Type, name: String) -> Bool {\n  match ty {\n    CtNamed(n, targs) => if n == name {\n      true\n    } else {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(targs) {\n        if type_mentions_named(Array::get(targs, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtTuple(items) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(items) {\n        if type_mentions_named(Array::get(items, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtArray(e) => type_mentions_named(e, name),\n    CtOption(e) => type_mentions_named(e, name),\n    CtFn(ps, ret, _) => {\n      let mut found = type_mentions_named(ret, name)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if type_mentions_named(Array::get(ps, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtForAll(_, _, body) => type_mentions_named(body, name),\n    _ => false\n  }\n}\n\nfn collect_env_bindings(env: TypeEnv, acc: Array[(String, Type)]) -> Unit {\n  match env {\n    EnvEmpty => (),\n    EnvBind(n, ty, rest) => {\n      Array::push(acc, (n, ty))\n      collect_env_bindings(rest, acc)\n    },\n    EnvTraitDef(_, _, _, _, rest, _) => collect_env_bindings(rest, acc),\n    EnvTraitImpl(_, _, rest) => collect_env_bindings(rest, acc),\n    EnvTraitImplGen(_, _, _, _, rest) => collect_env_bindings(rest, acc),\n    EnvFlat(bindings) => {\n      let mut i = 0\n      while i < Array::length(bindings) {\n        Array::push(acc, Array::get(bindings, i))\n        i = i + 1\n      }\n    },\n    EnvCached(names, types, rest) => {\n      let mut i = 0\n      while i < Array::length(names) {\n        Array::push(acc, (Array::get(names, i), Array::get(types, i)))\n        i = i + 1\n      }\n      collect_env_bindings(rest, acc)\n    }\n  }\n}\n\nfn type_no_named(t: Type) -> Bool {\n  match t {\n    CtNamed(_, _) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_no_named(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_no_named(e),\n    CtOption(e) => type_no_named(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_no_named(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_no_named(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nfn head_kind(t: Type) -> Int {\n  match t {\n    CtInt => 1,\n    CtDouble => 2,\n    CtBool => 3,\n    CtString => 4,\n    CtChar => 5,\n    CtUnit => 6,\n    CtBytes => 7,\n    CtTuple(_) => 8,\n    CtArray(_) => 9,\n    CtOption(_) => 10,\n    CtStruct(_) => 11,\n    CtEnum(_) => 12,\n    CtFn(_, _, _) => 13,\n    _ => 0\n  }\n}\n\nfn is_stream_named_type(t: Type) -> Bool {\n  match t {\n    CtNamed(n, _) => n == \"Stream\",\n    _ => false\n  }\n}\n\nfn struct_fields_ground(dfields: Array[(String, Type)]) -> Bool {\n  let mut ok = true\n  let mut i = 0\n  while i < Array::length(dfields) {\n    let (_, ft) = Array::get(dfields, i)\n    if !type_is_ground(ft) {\n      ok = false\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn effect_label_is_exempt(lbl: String) -> Bool {\n  let len = String::length(lbl)\n  if (is_exception_effect_name(lbl) && String::length(exception_effect_kind(lbl)) == 0) || lbl == \"Async\" {\n    true\n  } else if len == 1 {\n    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122\n  } else if len >= 2 {\n    String::char_code_at(lbl, 0) == 36\n  } else {\n    true\n  }\n}\n\nfn row_labels(row: Option[String]) -> Array[String] {\n  match row {\n    Some(r) => {\n      let parts = String::split(r, \",\")\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(parts) {\n        let t = String::trim(Array::get(parts, i))\n        if String::length(t) > 0 {\n          Array::push(out, t)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      out\n    },\n    None => array_empty()\n  }\n}\n\nfn ck_row_label_base(label: String) -> String {\n  let bi = String::index_of(label, \"[\")\n  if bi > 0 {\n    label[0: bi]\n  } else {\n    label\n  }\n}\n\nfn row_contains_label(row: Option[String], lbl: String) -> Bool {\n  let labels = row_labels(row)\n  let mut i = 0\n  let mut found = false\n  let wanted = ck_row_label_base(lbl)\n  let exc_wanted = is_exception_label(lbl)\n  while i < Array::length(labels) && !found {\n    let have = Array::get(labels, i)\n    let hit = if exc_wanted || is_exception_label(have) {\n      exception_effect_labels_equal(have, lbl)\n    } else {\n      ck_row_label_base(have) == wanted\n    }\n    if hit {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {\n  match expected {\n    CtFn(eparams, eret, eeff) => match actual {\n      CtFn(aparams, aret, aeff) => {\n        let alabels = row_labels(aeff)\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(alabels) && !done {\n          let lbl = Array::get(alabels, i)\n          if !effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl) {\n            dropped = Some(lbl)\n            done = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        if !done && Array::length(eparams) == Array::length(aparams) {\n          let mut pi = 0\n          while pi < Array::length(eparams) && !done {\n            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {\n              Some(pl) => {\n                dropped = Some(pl)\n                done = true\n              },\n              None => ()\n            }\n            pi = pi + 1\n          }\n        } else {\n          ()\n        }\n        match dropped {\n          Some(l) => Some(l),\n          None => effect_row_dropped(eret, aret)\n        }\n      },\n      _ => None\n    },\n    CtArray(ee) => match actual {\n      CtArray(ae) => effect_row_dropped(ee, ae),\n      _ => None\n    },\n    CtOption(ee) => match actual {\n      CtOption(ae) => effect_row_dropped(ee, ae),\n      _ => None\n    },\n    CtTuple(ees) => match actual {\n      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(ees) && !done {\n          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {\n            Some(d) => {\n              dropped = Some(d)\n              done = true\n            },\n            None => ()\n          }\n          i = i + 1\n        }\n        dropped\n      } else {\n        None\n      },\n      _ => None\n    },\n    CtNamed(en, eargs) => match actual {\n      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(eargs) && !done {\n          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {\n            Some(d) => {\n              dropped = Some(d)\n              done = true\n            },\n            None => ()\n          }\n          i = i + 1\n        }\n        dropped\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nexport fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\n  match unify(expected, actual, s) {\n    Some(su) => su,\n    None => {\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\n        Some(_) => true,\n        None => false\n      }\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\n      let eh = head_kind(subst_apply(s, expected))\n      let ah = head_kind(subst_apply(s, actual))\n      let head_differ = eh != 0 && ah != 0 && eh != ah\n      let nominal_conflict = nominal_head_conflict(subst_apply(s, expected), subst_apply(s, actual))\n      if nominal_conflict {\n        Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\", got \", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\n        s\n      } else if structural {\n        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {\n          Some(lbl) => {\n            Array::push(errors, String::concat(what, String::concat(\": effect row mismatch: a value of type \", String::concat(type_to_string(subst_apply(s, actual)), String::concat(\" cannot be used where \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\" is expected (the { \", String::concat(lbl, String::concat(\" } effect would be dropped — no handler could ever run)\", off_marker(off))))))))))\n            s\n          },\n          None => s\n        }\n      } else if !(reportable || head_differ) {\n        if type_fully_concrete(expected) {\n          detect_narrowed_generic_mismatch(expected, actual, s, errors, what, off)\n        } else {\n          s\n        }\n      } else {\n        Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\", got \", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\n        s\n      }\n    }\n  }\n}\n\nfn nominal_name_of(t: Type) -> Option[String] {\n  match t {\n    CtOption(_) => Some(\"Option\"),\n    CtEnum(n) => Some(n),\n    CtStruct(n) => Some(n),\n    CtNamed(n, _) => if type_fully_concrete(t) {\n      Some(n)\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn nominal_head_conflict(expected: Type, actual: Type) -> Bool {\n  let direct_conflict = match nominal_name_of(expected) {\n    Some(en) => match nominal_name_of(actual) {\n      Some(an) => en != an,\n      None => false\n    },\n    None => false\n  }\n  if direct_conflict {\n    true\n  } else {\n    match expected {\n      CtNamed(_, eargs) => match actual {\n        CtNamed(_, aargs) => if Array::length(eargs) == Array::length(aargs) {\n          let mut i = 0\n          let mut conflict = false\n          while i < Array::length(eargs) && !conflict {\n            if nominal_head_conflict(Array::get(eargs, i), Array::get(aargs, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      CtArray(ee) => match actual {\n        CtArray(ae) => nominal_head_conflict(ee, ae),\n        _ => false\n      },\n      CtOption(ee) => match actual {\n        CtOption(ae) => nominal_head_conflict(ee, ae),\n        _ => false\n      },\n      CtTuple(ees) => match actual {\n        CtTuple(aes) => if Array::length(ees) == Array::length(aes) {\n          let mut i = 0\n          let mut conflict = false\n          while i < Array::length(ees) && !conflict {\n            if nominal_head_conflict(Array::get(ees, i), Array::get(aes, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      CtFn(eps, er, _) => match actual {\n        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {\n          let mut i = 0\n          let mut conflict = nominal_head_conflict(er, ar)\n          while i < Array::length(eps) && !conflict {\n            if nominal_head_conflict(Array::get(eps, i), Array::get(aps, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\nfn type_fully_concrete(t: Type) -> Bool {\n  match t {\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtUnknown => false,\n    CtNamed(_, args) => {\n      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {\n        CtUnknown => true,\n        _ => false\n      })\n      if is_sentinel {\n        false\n      } else {\n        let mut ok = true\n        let mut i = 0\n        while i < Array::length(args) {\n          if !type_fully_concrete(Array::get(args, i)) {\n            ok = false\n          }\n          i = i + 1\n        }\n        ok\n      }\n    },\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_fully_concrete(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_fully_concrete(e),\n    CtOption(e) => type_fully_concrete(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_fully_concrete(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_fully_concrete(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nexport fn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\n  let e2 = subst_apply(s, expected)\n  let a2 = subst_apply(s, actual)\n  match e2 {\n    CtNamed(ename, eargs) => match a2 {\n      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {\n        match unify(e2, a2, s) {\n          Some(_) => s,\n          None => {\n            Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(e2), String::concat(\", got \", String::concat(type_to_string(a2), off_marker(off)))))))\n            s\n          }\n        }\n      } else s,\n      _ => s\n    },\n    _ => s\n  }\n}\n\nexport fn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type {\n  match resolved {\n    CtStruct(rname) => match actual {\n      CtNamed(aname, aargs) => if rname == aname && Array::length(aargs) > 0 {\n        actual\n      } else {\n        resolved\n      },\n      _ => resolved\n    },\n    _ => resolved\n  }\n}\n\nfn struct_field_names_match(declared: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\n  if Array::length(declared) != Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(declared) {\n      let (dn, _) = Array::get(declared, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(actual) {\n        let (an, _) = Array::get(actual, j)\n        if an == dn {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn effect_op_sig(defs: Array[TypeDef], qname: String) -> Option[(Array[Type], Type)] {\n  let ci = String::index_of(qname, \"::\")\n  if ci < 0 {\n    None\n  } else {\n    let eff = String::substring(qname, 0, ci)\n    let op = String::substring(qname, ci + 2, String::length(qname))\n    match find_typedef(defs, eff) {\n      Some(td) => match td {\n        TDEffect(_, ops, _) => {\n          let mut oi = 0\n          let mut found = None\n          while oi < Array::length(ops) {\n            let (oname, oparams, oret) = Array::get(ops, oi)\n            if oname == op {\n              found = Some((oparams, oret))\n            } else {\n              ()\n            }\n            oi = oi + 1\n          }\n          found\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nfn effect_tparams(defs: Array[TypeDef], eff: String) -> Array[String] {\n  match find_typedef(defs, eff) {\n    Some(td) => match td {\n      TDEffect(_, _, etps) => etps,\n      _ => array_empty()\n    },\n    None => array_empty()\n  }\n}\n\nfn effect_fresh_targs(etps: Array[String], c: Int) -> (Array[Type], Int) {\n  let out = array_empty()\n  let mut c1 = c\n  let mut i = 0\n  while i < Array::length(etps) {\n    let (tv, nc) = fresh_var(c1)\n    Array::push(out, tv)\n    c1 = nc\n    i = i + 1\n  }\n  (out, c1)\n}\n\nfn effect_inst_env_key(eff: String) -> String {\n  String::concat(\"$einst$\", eff)\n}\n\nfn effect_inst_lookup(env: TypeEnv, eff: String, etps: Array[String]) -> Option[Array[Type]] {\n  match env_lookup(env, effect_inst_env_key(eff)) {\n    Some(t) => match t {\n      CtTuple(targs) => if Array::length(targs) == Array::length(etps) {\n        Some(targs)\n      } else {\n        None\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nfn effect_instantiate(env: TypeEnv, eff: String, etps: Array[String], c: Int) -> (Array[Type], Int) {\n  match effect_inst_lookup(env, eff, etps) {\n    Some(targs) => (targs, c),\n    None => effect_fresh_targs(etps, c)\n  }\n}\n\nfn effect_is_declared(defs: Array[TypeDef], eff: String) -> Bool {\n  match find_typedef(defs, eff) {\n    Some(td) => match td {\n      TDEffect(_, _, _) => true,\n      _ => false\n    },\n    None => false\n  }\n}\n\nfn lookup_actual_field_ty(actual: Array[(String, Type)], name: String) -> Option[Type] {\n  let mut i = 0\n  let mut out = None\n  while i < Array::length(actual) {\n    let (an, at) = Array::get(actual, i)\n    if an == name {\n      out = Some(at)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn struct_is_strict_superset(dfields: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\n  if Array::length(dfields) <= Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut all_in = true\n    while i < Array::length(actual) {\n      let (an, _) = Array::get(actual, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(dfields) {\n        let (dn, _) = Array::get(dfields, j)\n        if dn == an {\n          found = true\n        } else {\n          ()\n        }\n        j = j + 1\n      }\n      if !found {\n        all_in = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    all_in\n  }\n}\n\nfn check_record_fields(defs: Array[TypeDef], actual: Array[(String, Type)], s: Subst, errors: Array[String]) -> Subst {\n  let mut matchct = 0\n  let mut matched_fields = array_empty()\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(_, dfields, _, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        matched_fields = dfields\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 {\n    let mut out = s\n    let mut i = 0\n    while i < Array::length(matched_fields) {\n      let (fname, declared_ty) = Array::get(matched_fields, i)\n      match lookup_actual_field_ty(actual, fname) {\n        Some(actual_ty) => {\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\"struct field type mismatch for \", fname), 0 - 1)\n        },\n        None => ()\n      }\n      i = i + 1\n    }\n    out\n  } else if matchct > 1 {\n    s\n  } else {\n    let mut supct = 0\n    let mut sup_name = \"\"\n    let mut sup_fields = array_empty()\n    let mut dj = 0\n    while dj < Array::length(defs) {\n      match Array::get(defs, dj) {\n        TDStruct(sname, dfields, _, _) => if struct_is_strict_superset(dfields, actual) {\n          supct = supct + 1\n          sup_name = sname\n          sup_fields = dfields\n        },\n        _ => ()\n      }\n      dj = dj + 1\n    }\n    if supct == 1 {\n      let mut fi = 0\n      while fi < Array::length(sup_fields) {\n        let (dn, _) = Array::get(sup_fields, fi)\n        match lookup_actual_field_ty(actual, dn) {\n          Some(_) => (),\n          None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", sup_name))))\n        }\n        fi = fi + 1\n      }\n      s\n    } else {\n      s\n    }\n  }\n}\n\nfn resolve_record_struct_name(defs: Array[TypeDef], actual: Array[(String, Type)]) -> Option[String] {\n  let mut matchct = 0\n  let mut out = None\n  let mut ground = false\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(sname, dfields, _, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        out = Some(sname)\n        ground = struct_fields_ground(dfields)\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 && ground {\n    out\n  } else {\n    None\n  }\n}\n\nfn unify_call_args(param_tys: Array[Type], arg_tys: Array[Type], s: Subst, errors: Array[String], label: String, off: Int) -> Subst {\n  let mut out = s\n  let mut ui = 0\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n  while ui < ul {\n    let pty = Array::get(param_tys, ui)\n    let aty = Array::get(arg_tys, ui)\n    out = if label == \"__to_string\" {\n      match unify(pty, aty, out) {\n        Some(su) => su,\n        None => out\n      }\n    } else {\n      check_assignable(pty, aty, out, errors, String::concat(\"argument type mismatch for \", label), off)\n    }\n    ui = ui + 1\n  }\n  out\n}\n\nfn ascription_lambda_ann(callee: Expr) -> Option[TypeExpr] {\n  match callee {\n    EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {\n      match ret_ty {\n        Some(_) => None,\n        None => match effect {\n          Some(_) => None,\n          None => {\n            let (pname, pann) = Array::get(params, 0)\n            if pname == \"__asc\" {\n              match body {\n                EIdent(bname, _) => if bname == \"__asc\" {\n                  pann\n                } else {\n                  None\n                },\n                _ => None\n              }\n            } else {\n              None\n            }\n          }\n        }\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nexport fn fn_return_env_name(name: String) -> String {\n  String::concat(\"__fn_ret__:\", name)\n}\n\nfn is_array_builder_head(t: Type) -> Bool {\n  match t {\n    CtNamed(n, targs) => n == \"ArrayBuilder\" && Array::length(targs) == 1,\n    _ => false\n  }\n}\n\nexport fn is_region_tagged_ty(t: Type) -> Bool {\n  match t {\n    CtNamed(n, targs) => if n == \"TaskGroup\" && Array::length(targs) == 2 {\n      true\n    } else if (n == \"TaskHandle\" || n == \"Sender\" || n == \"Receiver\") && Array::length(targs) == 3 {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(targs) && !found {\n        found = is_region_tagged_ty(Array::get(targs, i))\n        i = i + 1\n      }\n      found\n    },\n    CtArray(e) => is_region_tagged_ty(e),\n    CtOption(e) => is_region_tagged_ty(e),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) && !found {\n        found = is_region_tagged_ty(Array::get(elems, i))\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nexport fn is_array_builder_ty(t: Type) -> Bool {\n  if is_array_builder_head(t) {\n    true\n  } else {\n    match t {\n      CtArray(e) => is_array_builder_ty(e),\n      CtOption(e) => is_array_builder_ty(e),\n      CtTuple(elems) => {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(elems) && !found {\n          found = is_array_builder_ty(Array::get(elems, i))\n          i = i + 1\n        }\n        found\n      },\n      CtNamed(_, targs) => {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(targs) && !found {\n          found = is_array_builder_ty(Array::get(targs, i))\n          i = i + 1\n        }\n        found\n      },\n      _ => false\n    }\n  }\n}\n\nfn direct_builtin_return(name: String) -> Option[Type] {\n  if name == \"Bytes::length\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_length\" || name == \"String::iter_length\" || name == \"Map::iter_length\" {\n    Some(CtInt)\n  }\n  else if name == \"Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"FixedArray::length\" || name == \"Int64Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"String::length\" {\n    Some(CtInt)\n  }\n  else if name == \"Bytes::get\" || name == \"String::index_of\" || name == \"String::char_code_at\" || name == \"String::last_index_of\" || name == \"Char::to_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" || name == \"Env::args_len\" || name == \"Stdin::read_char\" || name == \"Int64Array::get\" {\n    Some(CtInt)\n  }\n  else if name == \"String::equals\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::contains\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"MapBuilder::has_key\" || name == \"Path::is_absolute\" || name == \"Fs::exists\" || name == \"Fs::is_dir\" || name == \"Fs::is_file\" || name == \"eq\" || name == \"not\" {\n    Some(CtBool)\n  }\n  else if name == \"String::concat\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::join\" || name == \"Array::join\" || name == \"Path::to_string\" || name == \"Path::resolve\" || name == \"PromptText::new\" || name == \"Stdin::read_stream\" || name == \"Env::get\" || name == \"Env::args_get\" || name == \"Fs::read_file\" || name == \"Fs::getcwd\" || name == \"sh\" || name == \"Lines::stringify\" || name == \"Llm::complete\" || name == \"Rlm::run\" || name == \"Rlm::finalize\" || name == \"__to_string\" {\n    Some(CtString)\n  }\n  else if name == \"__len\" {\n    Some(CtInt)\n  }\n  else if name == \"String::iter_get\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_get\" || name == \"Map::iter_get\" || name == \"iter_require\" || name == \"__neg\" {\n    Some(CtUnknown)\n  }\n  else if name == \"Bytes::new\" || name == \"Bytes::concat\" || name == \"Bytes::slice\" || name == \"Bytes::from_array\" || name == \"Fs::read_bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"FixedArray::set\" || name == \"FixedArray::blit\" || name == \"FixedArray::unsafe_set\" || name == \"Int64Array::set\" || name == \"Bytes::set\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"Stdout::write_char\" || name == \"Stdout::write_stream\" || name == \"sleep\" || name == \"Fs::copy\" || name == \"Fs::chdir\" || name == \"Fs::mkdir\" || name == \"Fs::mkdir_p\" || name == \"Fs::append\" || name == \"Fs::remove\" || name == \"Fs::rename\" || name == \"Fs::write_file\" || name == \"Fs::write_bytes\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"assert_eq\" || name == \"__set_field\" {\n    Some(CtUnit)\n  }\n  else if name == \"Double::from_i64_bits\" || name == \"Int::to_double\" || name == \"Double::to_float\" || name == \"Float::to_double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Char::from_int\" {\n    Some(CtChar)\n  }\n  else if name == \"Bytes::to_array\" || name == \"Int64Array::make\" {\n    Some(CtArray(CtInt))\n  }\n  else if name == \"Map::keys\" || name == \"sh_lines\" || name == \"Lines::parse\" {\n    Some(CtArray(CtString))\n  }\n  else if name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::filter\" || name == \"Array::reverse\" || name == \"Array::sort\" || name == \"FixedArray::make\" {\n    Some(CtArray(CtUnknown))\n  }\n  else if name == \"Some\" || name == \"Array::find\" {\n    Some(CtOption(CtUnknown))\n  }\n  else {\n    None\n  }\n}\n\nfn direct_call_return(env: TypeEnv, name: String) -> Option[Type] {\n  match env_lookup(env, name) {\n    Some(_) => None,\n    None => direct_builtin_return(name)\n  }\n}\n\nfn builtin_first_arg_head(name: String) -> Int {\n  if name == \"Array::length\" || name == \"Array::get\" || name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::reverse\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"Array::contains\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::find\" || name == \"Array::filter\" {\n    9\n  } else if name == \"String::length\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::char_code_at\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" || name == \"String::concat\" {\n    4\n  } else if name == \"Bytes::length\" || name == \"Bytes::get\" || name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::to_array\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" {\n    7\n  } else if name == \"Int64Array::make\" || name == \"FixedArray::make\" {\n    1\n  } else {\n    0\n  }\n}\n\nfn builtin_arg_head_rest(name: String, i: Int) -> Int {\n  if name == \"String::concat\" {\n    if i == 1 {\n      4\n    } else {\n      0\n    }\n  } else if name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" {\n    if i == 1 {\n      4\n    } else {\n      0\n    }\n  } else if name == \"String::substring\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"String::char_code_at\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::get\" || name == \"Bytes::push\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::fill\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::blit\" {\n    if i == 1 {\n      7\n    } else if i == 2 || i == 3 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::get\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::set\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::make\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else {\n    0\n  }\n}\n\nfn builtin_fixed_arity(name: String) -> Int {\n  if name == \"Array::length\" || name == \"Array::reverse\" || name == \"String::length\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::iter_length\" || name == \"Bytes::length\" || name == \"Bytes::to_array\" || name == \"Bytes::from_array\" || name == \"Map::keys\" || name == \"Map::iter_length\" || name == \"Char::to_int\" || name == \"Char::from_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::from_i64_bits\" || name == \"Int::to_double\" || name == \"not\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"__to_string\" || name == \"FixedArray::length\" || name == \"Int64Array::length\" {\n    1\n  } else if name == \"Array::get\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::concat\" || name == \"Array::contains\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::find\" || name == \"Array::filter\" || name == \"Array::join\" || name == \"Array::foreach\" || name == \"String::equals\" || name == \"String::concat\" || name == \"String::char_code_at\" || name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" || name == \"String::join\" || name == \"String::iter_get\" || name == \"Bytes::get\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::concat\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"MapBuilder::has_key\" || name == \"MapBuilder::get\" || name == \"eq\" || name == \"assert_eq\" || name == \"FixedArray::get\" || name == \"FixedArray::make\" || name == \"Int64Array::get\" || name == \"Int64Array::make\" {\n    2\n  } else if name == \"Array::set\" || name == \"Array::slice\" || name == \"String::substring\" || name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"FixedArray::set\" || name == \"FixedArray::unsafe_set\" || name == \"Int64Array::set\" {\n    3\n  } else if name == \"Bytes::blit\" {\n    4\n  } else if name == \"FixedArray::blit\" {\n    5\n  } else {\n    0 - 1\n  }\n}\n\nfn check_hof_param_vs_elem(recv_ty: Type, fn_ty: Type, pidx: Int, s: Subst, errors: Array[String], msg: String) -> Subst {\n  match recv_ty {\n    CtArray(elem) => match fn_ty {\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\n      } else {\n        s\n      },\n      _ => s\n    },\n    _ => s\n  }\n}\n\nfn check_two_array_elems(a_app: Type, b_app: Type, s: Subst, errors: Array[String], msg: String) -> Subst {\n  match a_app {\n    CtArray(ea) => match b_app {\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\n      _ => s\n    },\n    _ => s\n  }\n}\n\nfn struct_field_type(defs: Array[TypeDef], sname: String, field: String) -> Option[Type] {\n  match find_typedef(defs, sname) {\n    Some(td) => match td {\n      TDStruct(_, fields, _, _) => {\n        let rec go: (Int) -> Option[Type] = (i) -> {\n          if i >= Array::length(fields) {\n            None\n          } else {\n            let (fname, ftype) = Array::get(fields, i)\n            if fname == field {\n              Some(ftype)\n            } else {\n              go(i + 1)\n            }\n          }\n        }\n        go(0)\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nfn inst_struct_field_ty(ft: Type, tparams: Array[String], targs: Array[Type]) -> Type {\n  if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {\n    subst_type_params(ft, tparams, targs)\n  } else {\n    ft\n  }\n}\n\nfn receiver_struct_field_type(defs: Array[TypeDef], recv: Type, field: String) -> Option[Type] {\n  match recv {\n    CtStruct(sname) => struct_field_type(defs, sname, field),\n    CtNamed(sname, targs) => match find_typedef(defs, sname) {\n      Some(td) => match td {\n        TDStruct(_, _, _, tparams) => match struct_field_type(defs, sname, field) {\n          Some(ft) => Some(inst_struct_field_ty(ft, tparams, targs)),\n          None => None\n        },\n        _ => None\n      },\n      None => None\n    },\n    _ => None\n  }\n}\n\nfn is_logic_binop(op: String) -> Bool {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nfn is_order_binop(op: String) -> Bool {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nfn type_name_prefix(ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nfn is_known_builtin_receiver_prefix(prefix: String) -> Bool {\n  prefix == \"String\"\n  || prefix == \"Bytes\"\n  || prefix == \"Array\"\n  || prefix == \"Map\"\n  || prefix == \"MapBuilder\"\n  || prefix == \"Int64Array\"\n  || prefix == \"FixedArray\"\n  || prefix == \"ArrayBuilder\"\n  || prefix == \"StringBuilder\"\n  || prefix == \"Int\"\n  || prefix == \"Double\"\n  || prefix == \"Char\"\n}\n\nfn is_equality_binop(op: String) -> Bool {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nfn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nfn unify_same_binop_operands(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {\n  match unify(left_ty, right_ty, s) {\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\n    None => None\n  }\n}\n\nfn infer_named_trait_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\n  match unify_same_binop_operands(left_ty, right_ty, s) {\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\n      Some((resolved, s1))\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nfn binop_str_arr_contains(arr: Array[String], val: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn rigid_bound_operand(ty: Type, s: Subst, trait_name: String) -> Bool {\n  match subst_apply(s, ty) {\n    CtVar(id) => binop_str_arr_contains(subst_bounds_for(s, id), trait_name),\n    _ => false\n  }\n}\n\nfn operand_var_bounds(ty: Type, s: Subst) -> Array[String] {\n  match subst_apply(s, ty) {\n    CtVar(id) => subst_bounds_for(s, id),\n    _ => array_empty()\n  }\n}\n\nfn rigid_trait_bound_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\n  if rigid_bound_operand(left_ty, s, trait_name) || rigid_bound_operand(right_ty, s, trait_name) {\n    let lb = operand_var_bounds(left_ty, s)\n    let rb = operand_var_bounds(right_ty, s)\n    match unify_same_binop_operands(left_ty, right_ty, s) {\n      Some((resolved, s1)) => match subst_apply(s1, resolved) {\n        CtVar(id) => {\n          let have = subst_bounds_for(s1, id)\n          let missing = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(lb) + Array::length(rb) {\n            let cand = if i < Array::length(lb) {\n              Array::get(lb, i)\n            } else {\n              Array::get(rb, i - Array::length(lb))\n            }\n            if !binop_str_arr_contains(have, cand) {\n              ArrayBuilder::push(missing, cand)\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          let missing_arr = ArrayBuilder::freeze(missing)\n          if Array::length(missing_arr) > 0 {\n            Some((resolved, subst_add_bound(s1, id, missing_arr)))\n          } else {\n            Some((resolved, s1))\n          }\n        },\n        other => if type_implements_trait(env, s1, other, trait_name) {\n          Some((resolved, s1))\n        } else {\n          None\n        }\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\nfn infer_binop_type(op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst) {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Bool\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        let eq_l = subst_apply(s, left_ty)\n        let eq_r = subst_apply(s, right_ty)\n        let eq_has_named = match eq_l {\n          CtNamed(_, _) => true,\n          _ => match eq_r {\n            CtNamed(_, _) => true,\n            _ => false\n          }\n        }\n        if eq_has_named {\n          (CtBool, s)\n        } else {\n          Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must have same type\")))\n          (CtUnknown, s)\n        }\n      }\n    }\n  }\n  else if is_order_binop(op) {\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \"Ord\", s) {\n      Some((_, s1)) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n        Some(s1) => (CtBool, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n          Some(s1) => (CtBool, s1),\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \"Ord\", s) {\n            Some((_, s1)) => (CtBool, s1),\n            None => {\n              Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n              (CtUnknown, s)\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"+\" {\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \"Add\", s) {\n      Some((resolved, s1)) => (resolved, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n        Some(s1) => (CtInt, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n          Some(s1) => (CtDouble, s1),\n          None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n            Some(s1) => (CtString, s1),\n            None => match infer_named_trait_binop(env, left_ty, right_ty, \"Add\", s) {\n              Some((resolved, s1)) => (resolved, s1),\n              None => {\n                Array::push(errors, \"type mismatch in '+': operands must be Int, Double, or String\")\n                (CtUnknown, s)\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n  || op == \"*\"\n  || op == \"/\" {\n    let trait_name = if op == \"-\" {\n      \"Sub\"\n    } else if op == \"*\" {\n      \"Mul\"\n    } else {\n      \"Div\"\n    }\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\n          Some((resolved, s1)) => (resolved, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, \"type mismatch in '%': operands must be Int\")\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else {\n    Array::push(errors, String::concat(\"unknown operator: \", op))\n    (CtUnknown, s)\n  }\n}\n\nfn resolve_tparams_in(ty: Type, env: TypeEnv) -> Type {\n  match ty {\n    CtNamed(name, args) => {\n      let ra = for a in args {\n        resolve_tparams_in(a, env)\n      }\n      match env_lookup(env, name) {\n        Some(t) => match t {\n          CtVar(_) => t,\n          _ => CtNamed(name, ra)\n        },\n        None => CtNamed(name, ra)\n      }\n    },\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\n    CtTuple(es) => CtTuple(for e in es {\n      resolve_tparams_in(e, env)\n    }),\n    CtFn(ps, ret, eff) => {\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\n    },\n    _ => ty\n  }\n}\n\nfn tab_call_ty(tytab: Array[(Int, Type)], call_off: Int, ty: Type) -> Type {\n  if call_off >= 0 {\n    Array::push(tytab, (call_off, ty))\n  } else {\n    ()\n  }\n  ty\n}\n\nfn check_seq_spine(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) {\n  let mut cur = expr\n  let mut cenv = env\n  let mut s1 = s\n  let mut c1 = c\n  let mut done = false\n  let mut result = (CtUnit, s, c)\n  while !done {\n    match cur {\n      ESeq(left, right) => {\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        cur = right\n      },\n      ELet(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        let vt_resolved = subst_apply(ns, vt)\n        let gen = if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {\n          vt\n        } else {\n          generalize(ns, vt)\n        }\n        cenv = env_bind(cenv, name, gen)\n        s1 = ns\n        c1 = nc\n        cur = body\n      },\n      ELetMut(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        if name == \"__loop_result\" {\n          let (lr_tv, nc2) = fresh_var(nc)\n          cenv = env_bind(cenv, name, lr_tv)\n          c1 = nc2\n        } else {\n          cenv = env_bind(cenv, name, vt)\n          c1 = nc\n        }\n        s1 = ns\n        cur = body\n      },\n      ELetRec(name, val, body) => {\n        let (tv, c1b) = fresh_var(c1)\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\n        let s2 = match unify(tv, vt, ns) {\n          Some(su) => su,\n          None => ns\n        }\n        let gen = generalize(s2, tv)\n        cenv = env_bind(cenv, name, gen)\n        s1 = s2\n        c1 = nc\n        cur = body\n      },\n      _ => {\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\n        done = true\n      }\n    }\n  }\n  result\n}\n\nfn field_write_mut_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\n  if name == \"__set_field\" && Array::length(args) == 3 {\n    match Array::get(args, 1) {\n      EString(field) => {\n        let throwaway = array_empty()\n        let throwtab = array_empty()\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n        let recv_struct = match subst_apply(s, obj_ty) {\n          CtStruct(sn) => Some((sn, array_empty())),\n          CtNamed(sn, sargs) => Some((sn, sargs)),\n          _ => None\n        }\n        match recv_struct {\n          Some(recv_info) => {\n            let (sname, recv_targs) = recv_info\n            match find_typedef(defs, sname) {\n              Some(TDStruct(_, dfields, mut_names, s_tparams)) => {\n                let mut found = false\n                let mut i = 0\n                while i < Array::length(mut_names) {\n                  if Array::get(mut_names, i) == field {\n                    found = true\n                  } else {\n                    ()\n                  }\n                  i = i + 1\n                }\n                if found {\n                  ()\n                } else {\n                  Array::push(errors, String::concat(\"cannot assign to non-`mut` field `\", String::concat(field, String::concat(\"` of struct \", sname))))\n                }\n                let mut fty = CtUnknown\n                let mut has_field = false\n                let mut fi = 0\n                while fi < Array::length(dfields) {\n                  let (fn2, ft) = Array::get(dfields, fi)\n                  if fn2 == field {\n                    fty = ft\n                    has_field = true\n                  } else {\n                    ()\n                  }\n                  fi = fi + 1\n                }\n                if has_field {\n                  let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\n                  let inst_fty = inst_struct_field_ty(fty, s_tparams, recv_targs)\n                  let _ = check_assignable(subst_apply(s, inst_fty), subst_apply(s, val_ty), s, errors, String::concat(\"type mismatch writing field `\", String::concat(field, \"`\")), 0 - 1)\n                  ()\n                } else {\n                  ()\n                }\n              },\n              _ => ()\n            }\n          },\n          None => ()\n        }\n      },\n      _ => ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn index_target_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\n  if name == \"__index\" && Array::length(args) == 2 {\n    let throwaway = array_empty()\n    let throwtab = array_empty()\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n    let resolved_obj = subst_apply(s, obj_ty)\n    let not_indexable = match resolved_obj {\n      CtInt => true,\n      CtDouble => true,\n      CtBool => true,\n      CtChar => true,\n      CtUnit => true,\n      _ => false\n    }\n    if not_indexable {\n      Array::push(errors, \"cannot index a non-indexable value (expected Array, String, or Bytes)\")\n    } else {\n      let indexable = match resolved_obj {\n        CtArray(_) => true,\n        CtString => true,\n        CtBytes => true,\n        _ => false\n      }\n      if indexable {\n        let throwaway2 = array_empty()\n        let throwtab2 = array_empty()\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\n        let bad_index = match subst_apply(s, idx_ty) {\n          CtInt => false,\n          _ => type_is_ground(subst_apply(s, idx_ty))\n        }\n        if bad_index {\n          Array::push(errors, \"index must be an Int\")\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    }\n  } else {\n    ()\n  }\n}\n\nfn pat_is_catchall(pat: Pat) -> Bool {\n  match pat {\n    PWild => true,\n    PBind(_) => true,\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\n    _ => false\n  }\n}\n\nfn collect_bool_pats_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PBool(b) => if b {\n      Array::push(acc, \"true\")\n    } else {\n      Array::push(acc, \"false\")\n    },\n    POr(l, r) => {\n      collect_bool_pats_into(l, acc)\n      collect_bool_pats_into(r, acc)\n    },\n    _ => ()\n  }\n}\n\nfn flat_names_contain(names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) && !found {\n    if Array::get(names, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn collect_ctor_names_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PCtor(name, _) => Array::push(acc, name),\n    POr(l, r) => {\n      collect_ctor_names_into(l, acc)\n      collect_ctor_names_into(r, acc)\n    },\n    _ => ()\n  }\n}\n\nfn parse_tuple_index(s: String) -> Option[Int] {\n  let len = String::length(s)\n  if len == 0 {\n    None\n  } else {\n    let mut i = 0\n    let mut val = 0\n    let mut ok = true\n    while i < len {\n      let cc = String::char_code_at(s, i)\n      if cc >= 48 && cc <= 57 {\n        val = val * 10 + (cc - 48)\n      } else {\n        ok = false\n      }\n      i = i + 1\n    }\n    if ok {\n      Some(val)\n    } else {\n      None\n    }\n  }\n}\n\nfn resume_walk_bind_pat(p: Pat, env: TypeEnv) -> TypeEnv {\n  match p {\n    PBind(n) => env_bind(env, n, CtUnknown),\n    PCtor(_, ps) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(ps) {\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    PTuple(ps) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(ps) {\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    POr(a, b) => resume_walk_bind_pat(b, resume_walk_bind_pat(a, env)),\n    PStruct(_, fields) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(fields) {\n        let (_, fp) = Array::get(fields, pi)\n        env1 = resume_walk_bind_pat(fp, env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    _ => env\n  }\n}\n\nfn reject_resume_in_error_arm(e: Expr, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" {\n          Array::push(errors, String::concat(\"Error is a non-resumable effect (#640); an Error arm's value IS the handle result — remove resume(...)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => reject_resume_in_error_arm(callee, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        reject_resume_in_error_arm(Array::get(args, ri), errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(_, _) => (),\n    ELet(_, v, b, _) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELetMut(_, v, b, _) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELetRec(_, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ESeq(a, b) => {\n      reject_resume_in_error_arm(a, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EIf(cnd, t, el) => {\n      reject_resume_in_error_arm(cnd, errors)\n      reject_resume_in_error_arm(t, errors)\n      reject_resume_in_error_arm(el, errors)\n    },\n    EMatch(scr, marms) => {\n      reject_resume_in_error_arm(scr, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (_, mb) = Array::get(marms, mi)\n        reject_resume_in_error_arm(mb, errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      reject_resume_in_error_arm(cnd, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EForIn(_, _, it, b) => {\n      reject_resume_in_error_arm(it, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EBinOp(_, l, r) => {\n      reject_resume_in_error_arm(l, errors)\n      reject_resume_in_error_arm(r, errors)\n    },\n    EUnaryOp(_, inner) => reject_resume_in_error_arm(inner, errors),\n    EAssign(_, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EFn(_, _, _, _, _, fb) => reject_resume_in_error_arm(fb, errors),\n    EReturn(inner) => reject_resume_in_error_arm(inner, errors),\n    EDot(obj, _, _, _) => reject_resume_in_error_arm(obj, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        reject_resume_in_error_arm(fe, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      while ti < Array::length(binds) {\n        let (_, be) = Array::get(binds, ti)\n        reject_resume_in_error_arm(be, errors)\n        ti = ti + 1\n      }\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELabeledArg(_, _, inner) => reject_resume_in_error_arm(inner, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => reject_resume_in_error_arm(inner, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        reject_resume_in_error_arm(pe, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => reject_resume_in_error_arm(inner, errors),\n    _ => ()\n  }\n}\n\nfn handler_arm_pat_is_error(p: Pat) -> Bool {\n  match p {\n    PCtor(q, _) => {\n      is_exception_throw_handler_name(q)\n    },\n    _ => false\n  }\n}\n\nexport fn pat_binds_resume(p: Pat) -> Bool {\n  match p {\n    PBind(n) => n == \"resume\",\n    PCtor(_, ps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ps) {\n        if pat_binds_resume(Array::get(ps, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ps) {\n        if pat_binds_resume(Array::get(ps, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_binds_resume(a) || pat_binds_resume(b),\n    PStruct(_, fps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fps) {\n        let (_, fp) = Array::get(fps, i)\n        if pat_binds_resume(fp) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn param_base_name(raw_name: String) -> String {\n  let nlen = String::length(raw_name)\n  if nlen > 0 {\n    let lc = String::char_code_at(raw_name, nlen - 1)\n    if lc == '~' || lc == '?' {\n      raw_name[0: nlen - 1]\n    } else raw_name\n  } else raw_name\n}\n\nfn fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    if param_base_name(pn) == \"resume\" {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn check_arm_resume_tail(e: Expr, tail: Bool, sh: Bool, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" && !tail && !sh {\n          Array::push(errors, String::concat(\"resume(...) must be the last expression of the handler arm (tail position) — code after a resume never runs, so a bound or repeated resume is silently dropped (#942, ADR-0050)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => check_arm_resume_tail(callee, false, sh, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        check_arm_resume_tail(Array::get(args, ri), false, sh, errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(body, harms) => {\n      check_arm_resume_tail(body, tail, sh, errors)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hi)\n        if handler_arm_pat_is_error(hpat) {\n          ()\n        } else {\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\n        }\n        hi = hi + 1\n      }\n    },\n    ELet(ln, v, b, _) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ELetMut(ln, v, b, _) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ELetRec(ln, v, b) => {\n      check_arm_resume_tail(v, false, sh || ln == \"resume\", errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ESeq(a, b) => {\n      check_arm_resume_tail(a, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EIf(cnd, t, el) => {\n      check_arm_resume_tail(cnd, false, sh, errors)\n      check_arm_resume_tail(t, tail, sh, errors)\n      check_arm_resume_tail(el, tail, sh, errors)\n    },\n    EMatch(scr, marms) => {\n      check_arm_resume_tail(scr, false, sh, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        check_arm_resume_tail(mb, tail, sh || pat_binds_resume(mp), errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      check_arm_resume_tail(cnd, false, sh, errors)\n      check_arm_resume_tail(b, false, sh, errors)\n    },\n    EForIn(v1, v2, it, b) => {\n      check_arm_resume_tail(it, false, sh, errors)\n      let for_sh = v1 == \"resume\" || (match v2 {\n        Some(v2n) => v2n == \"resume\",\n        None => false\n      })\n      check_arm_resume_tail(b, false, sh || for_sh, errors)\n    },\n    EBinOp(_, l, r) => {\n      check_arm_resume_tail(l, false, sh, errors)\n      check_arm_resume_tail(r, false, sh, errors)\n    },\n    EUnaryOp(_, inner) => check_arm_resume_tail(inner, false, sh, errors),\n    EAssign(_, v, b) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EFn(_, _, _, _, _, _) => (),\n    EReturn(inner) => check_arm_resume_tail(inner, tail, sh, errors),\n    EDot(obj, _, _, _) => check_arm_resume_tail(obj, false, sh, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        check_arm_resume_tail(fe, false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      let mut loop_sh = false\n      while ti < Array::length(binds) {\n        let (bn, be) = Array::get(binds, ti)\n        if bn == \"resume\" {\n          loop_sh = true\n        } else {\n          ()\n        }\n        check_arm_resume_tail(be, false, sh, errors)\n        ti = ti + 1\n      }\n      check_arm_resume_tail(b, false, sh || loop_sh, errors)\n    },\n    ELabeledArg(_, _, inner) => check_arm_resume_tail(inner, false, sh, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => check_arm_resume_tail(inner, false, sh, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        check_arm_resume_tail(pe, false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => check_arm_resume_tail(inner, false, sh, errors),\n    _ => ()\n  }\n}\n\nexport fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" && !sh {\n          Array::push(errors, String::concat(\"resume(...) is only valid inside a handler arm of `handle ... with` — outside one there is no continuation to resume (#942, ADR-0050)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => reject_resume_outside_handler(callee, sh, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        reject_resume_outside_handler(Array::get(args, ri), sh, errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(body, harms) => {\n      reject_resume_outside_handler(body, sh, errors)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hi)\n        if handler_arm_pat_is_error(hpat) {\n          ()\n        } else {\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\n        }\n        hi = hi + 1\n      }\n    },\n    ELet(ln, v, b, _) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ELetMut(ln, v, b, _) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ELetRec(ln, v, b) => {\n      reject_resume_outside_handler(v, sh || ln == \"resume\", errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ESeq(a, b) => {\n      reject_resume_outside_handler(a, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EIf(cnd, t, el) => {\n      reject_resume_outside_handler(cnd, sh, errors)\n      reject_resume_outside_handler(t, sh, errors)\n      reject_resume_outside_handler(el, sh, errors)\n    },\n    EMatch(scr, marms) => {\n      reject_resume_outside_handler(scr, sh, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        reject_resume_outside_handler(mb, sh || pat_binds_resume(mp), errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      reject_resume_outside_handler(cnd, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EForIn(v1, v2, it, b) => {\n      reject_resume_outside_handler(it, sh, errors)\n      let for_sh = v1 == \"resume\" || (match v2 {\n        Some(v2n) => v2n == \"resume\",\n        None => false\n      })\n      reject_resume_outside_handler(b, sh || for_sh, errors)\n    },\n    EBinOp(_, l, r) => {\n      reject_resume_outside_handler(l, sh, errors)\n      reject_resume_outside_handler(r, sh, errors)\n    },\n    EUnaryOp(_, inner) => reject_resume_outside_handler(inner, sh, errors),\n    EAssign(_, v, b) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EFn(_, _, fparams, _, _, fb) => reject_resume_outside_handler(fb, sh || fn_params_bind_resume(fparams), errors),\n    EReturn(inner) => reject_resume_outside_handler(inner, sh, errors),\n    EDot(obj, _, _, _) => reject_resume_outside_handler(obj, sh, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        reject_resume_outside_handler(fe, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      let mut loop_sh = false\n      while ti < Array::length(binds) {\n        let (bn, be) = Array::get(binds, ti)\n        if bn == \"resume\" {\n          loop_sh = true\n        } else {\n          ()\n        }\n        reject_resume_outside_handler(be, sh, errors)\n        ti = ti + 1\n      }\n      reject_resume_outside_handler(b, sh || loop_sh, errors)\n    },\n    ELabeledArg(_, _, inner) => reject_resume_outside_handler(inner, sh, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => reject_resume_outside_handler(inner, sh, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        reject_resume_outside_handler(pe, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => reject_resume_outside_handler(inner, sh, errors),\n    _ => ()\n  }\n}\n\nfn check_resume_values(e: Expr, ret_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> Subst {\n  match e {\n    ECall(callee, args, _) => {\n      let mut s1 = s\n      let resume_shadowed = env_lookup(env, \"resume\") is Some(_)\n      match callee {\n        EIdent(nm, _) => {\n          if nm == \"resume\" && !resume_shadowed && Array::length(args) == 1 && !(ret_ty is CtUnit) {\n            let (aty, ns, _) = check_expr(Array::get(args, 0), env, defs, s1, c, errors, tytab)\n            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, \"resume value type mismatch\", 0 - 1)\n          } else if nm == \"resume\" && !resume_shadowed && Array::length(args) == 0 && !(ret_ty is CtUnit) {\n            Array::push(errors, \"resume expects a value (the operation returns a non-Unit type); resume() with no argument is only valid for Unit-returning operations\")\n          } else {\n            ()\n          }\n        },\n        _ => {\n          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab)\n        }\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab)\n        ri = ri + 1\n      }\n      s1\n    },\n    EHandle(_, _) => s,\n    ELet(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetMut(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetRec(ln, v, b) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env_bind(env, ln, CtUnknown), defs, s, c, errors, tytab), c, errors, tytab),\n    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab), c, errors, tytab),\n    EMatch(scr, marms) => {\n      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        s1 = check_resume_values(mb, ret_ty, resume_walk_bind_pat(mp, env), defs, s1, c, errors, tytab)\n        mi = mi + 1\n      }\n      s1\n    },\n    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EForIn(fname, fidx, it, b) => {\n      let fenv = match fidx {\n        Some(fi) => env_bind(env_bind(env, fname, CtUnknown), fi, CtUnknown),\n        None => env_bind(env, fname, CtUnknown)\n      }\n      check_resume_values(b, ret_ty, fenv, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab)\n    },\n    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab),\n    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab),\n    ETuple(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    EArray(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    _ => s\n  }\n}\n\nexport fn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int) {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name, ident_off) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if Array::length(bounds) != 0 {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        if ident_off >= 0 {\n          Array::push(tytab, (ident_off, ti))\n        } else {\n          ()\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => {\n          if ident_off >= 0 {\n            Array::push(tytab, (ident_off, t))\n          } else {\n            ()\n          }\n          (t, s, c)\n        },\n        None => match resolve_trait_method_ident(name, env, defs, s) {\n          Some(mty) => {\n            if ident_off >= 0 {\n              Array::push(tytab, (ident_off, mty))\n            } else {\n              ()\n            }\n            (mty, s, c)\n          },\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\n            Some(ct) => {\n              let (ti, c1, new_bounds) = instantiate(ct, c)\n              let nblen = Array::length(new_bounds)\n              let mut s1 = s\n              let mut bi = 0\n              while bi < nblen {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s1 = subst_add_bound(s1, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              if ident_off >= 0 {\n                Array::push(tytab, (ident_off, ti))\n              } else {\n                ()\n              }\n              (ti, s1, c1)\n            },\n            None => {\n              Array::push(errors, String::concat(String::concat(\"unknown name: \", name), off_marker_len(ident_off, String::length(name))))\n              (CtUnknown, s, c)\n            }\n          }\n        }\n      }\n    },\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    EIf(cond, then_e, else_e) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"if condition must be Bool\")\n      }\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\n      let rtt = subst_apply(s3, tt)\n      let ret = subst_apply(s3, et)\n      let (s3b, if_ty) = match rtt {\n        CtUnit => (s3, CtUnit),\n        _ => match ret {\n          CtUnit => (s3, CtUnit),\n          _ => (check_assignable(rtt, ret, s3, errors, \"if branches have incompatible types\", 0 - 1), tt)\n        }\n      }\n      (if_ty, s3b, c3)\n    },\n    ECall(callee, args, call_off) => match callee {\n      EIdent(name, callee_off) => {\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\n        if name == \"perform\" {\n          if Array::length(args) == 1 {\n            match Array::get(args, 0) {\n              ECall(op_callee, opargs, _) => {\n                let is_error_throw = match op_callee {\n                  EIdent(op_qname0, _) => is_exception_throw_operation(op_qname0),\n                  _ => false\n                }\n                if is_error_throw {\n                  (CtUnknown, s, c)\n                } else {\n                  let oalen = Array::length(opargs)\n                  let mut s1 = s\n                  let mut c1 = c\n                  let oparg_tys = array_empty()\n                  let mut ai = 0\n                  while ai < oalen {\n                    let (oat, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\n                    Array::push(oparg_tys, oat)\n                    s1 = ns\n                    c1 = nc\n                    ai = ai + 1\n                  }\n                  match op_callee {\n                    EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {\n                      Some(sig) => {\n                        let (sig_params_decl, sig_ret_decl) = sig\n                        let eff_of_op = String::substring(op_qname, 0, String::index_of(op_qname, \"::\"))\n                        let etps = effect_tparams(defs, eff_of_op)\n                        let mut c1b = c1\n                        let (sig_params, sig_ret, ret_usable) = if Array::length(etps) > 0 {\n                          let (ftargs, nc) = effect_instantiate(env, eff_of_op, etps, c1b)\n                          c1b = nc\n                          let ip = for p in sig_params_decl {\n                            subst_type_params(p, etps, ftargs)\n                          }\n                          (ip, subst_type_params(sig_ret_decl, etps, ftargs), type_is_ground_except(sig_ret_decl, etps))\n                        } else {\n                          (sig_params_decl, sig_ret_decl, type_is_ground(sig_ret_decl))\n                        }\n                        if Array::length(sig_params) != oalen {\n                          Array::push(errors, String::concat(\"perform \", String::concat(op_qname, String::concat(\" expects \", String::concat(__to_string(Array::length(sig_params)), String::concat(\" argument(s), got \", String::concat(__to_string(oalen), off_marker(op_off))))))))\n                        } else {\n                          let mut vi = 0\n                          while vi < oalen {\n                            s1 = check_assignable(subst_apply(s1, Array::get(sig_params, vi)), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat(\"perform argument type mismatch for \", op_qname), op_off)\n                            vi = vi + 1\n                          }\n                        }\n                        if ret_usable {\n                          (sig_ret, s1, c1b)\n                        } else {\n                          let (tv, c2) = fresh_var(c1b)\n                          (tv, s1, c2)\n                        }\n                      },\n                      None => {\n                        let ci2 = String::index_of(op_qname, \"::\")\n                        if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {\n                          Array::push(errors, String::concat(\"unknown operation `\", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat(\"` of effect \", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))\n                        } else {\n                          ()\n                        }\n                        let (tv, c2) = fresh_var(c1)\n                        (tv, s1, c2)\n                      }\n                    },\n                    _ => {\n                      let (tv, c2) = fresh_var(c1)\n                      (tv, s1, c2)\n                    }\n                  }\n                }\n              },\n              EIdent(bare_qname, bare_off) => {\n                match effect_op_sig(defs, bare_qname) {\n                  Some(bare_sig) => {\n                    let (bare_params_decl, bare_ret_decl) = bare_sig\n                    let bare_eff = String::substring(bare_qname, 0, String::index_of(bare_qname, \"::\"))\n                    let betps = effect_tparams(defs, bare_eff)\n                    let mut bc1 = c\n                    let (bare_ret, bare_ret_usable) = if Array::length(betps) > 0 {\n                      let (bftargs, bnc) = effect_instantiate(env, bare_eff, betps, bc1)\n                      bc1 = bnc\n                      (subst_type_params(bare_ret_decl, betps, bftargs), type_is_ground_except(bare_ret_decl, betps))\n                    } else {\n                      (bare_ret_decl, type_is_ground(bare_ret_decl))\n                    }\n                    if Array::length(bare_params_decl) != 0 {\n                      Array::push(errors, String::concat(\"perform \", String::concat(bare_qname, String::concat(\" expects \", String::concat(__to_string(Array::length(bare_params_decl)), String::concat(\" argument(s), got 0\", off_marker(bare_off)))))))\n                    } else {\n                      ()\n                    }\n                    if bare_ret_usable {\n                      (bare_ret, s, bc1)\n                    } else {\n                      let (tv, c2) = fresh_var(bc1)\n                      (tv, s, c2)\n                    }\n                  },\n                  None => {\n                    let (tv, c2) = fresh_var(c)\n                    (tv, s, c2)\n                  }\n                }\n              },\n              other => check_expr(other, env, defs, s, c, errors, tytab)\n            }\n          } else {\n            (CtUnknown, s, c)\n          }\n        } else if name == \"resume\" {\n          let alen = Array::length(args)\n          let mut s1 = s\n          let mut c1 = c\n          let mut ai = 0\n          while ai < alen {\n            let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n            s1 = ns\n            c1 = nc\n            ai = ai + 1\n          }\n          let (tv, c2) = fresh_var(c1)\n          (tv, s1, c2)\n        } else if name == \"%wasm\" {\n          let wasm_shape_ok = if Array::length(args) == 1 {\n            match Array::get(args, 0) {\n              EString(_) => true,\n              _ => false\n            }\n          } else {\n            false\n          }\n          if !wasm_shape_ok {\n            Array::push(errors, \"malformed inline wasm marker (expected a single WAT string literal)\")\n          } else {\n            ()\n          }\n          let (tv, c2) = fresh_var(c)\n          (tv, s, c2)\n        } else if name == \"Some\" {\n          if Array::length(args) == 1 {\n            let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n            (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\n          } else {\n            Array::push(errors, String::concat(String::concat(\"Some expects 1 argument, got \", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\n            (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\n          }\n        } else if name == \"__index\" && Array::length(args) == 2 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let result = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => elem,\n            CtString => CtInt,\n            CtBytes => CtInt,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"ArrayBuilder::new\" && Array::length(args) == 0 {\n          let (ev, c1) = fresh_var(c)\n          (tab_call_ty(tytab, call_off, CtNamed(\"ArrayBuilder\", Array::slice([\n            ev\n          ], 0, 1))), s, c1)\n        } else if name == \"ArrayBuilder::push\" && Array::length(args) == 2 {\n          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (v_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = match subst_apply(s2, b_ty) {\n            CtNamed(bn, bargs) => if bn == \"ArrayBuilder\" && Array::length(bargs) == 1 {\n              match unify(Array::get(bargs, 0), v_ty, s2) {\n                Some(su) => su,\n                None => {\n                  Array::push(errors, String::concat(\"ArrayBuilder::push element type mismatch: builder holds \", String::concat(type_to_string(subst_apply(s2, Array::get(bargs, 0))), String::concat(\", got \", String::concat(type_to_string(subst_apply(s2, v_ty)), off_marker_len(callee_off, String::length(name)))))))\n                  s2\n                }\n              }\n            } else {\n              s2\n            },\n            _ => s2\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"ArrayBuilder::freeze\" && Array::length(args) == 1 {\n          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, b_ty) {\n            CtNamed(bn, bargs) => if bn == \"ArrayBuilder\" && Array::length(bargs) == 1 {\n              CtArray(subst_apply(s1, Array::get(bargs, 0)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"FrozenArray::from_array\" && Array::length(args) == 1 {\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, a_ty) {\n            CtArray(e) => e,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"FrozenArray\", Array::slice([\n            elem\n          ], 0, 1))), s1, c1)\n        } else if name == \"FrozenArray::to_array\" && Array::length(args) == 1 {\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, fa_ty) {\n            CtNamed(fn0, fargs) => if fn0 == \"FrozenArray\" && Array::length(fargs) == 1 {\n              CtArray(subst_apply(s1, Array::get(fargs, 0)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"FrozenArray::get\" && Array::length(args) == 2 {\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let result = match subst_apply(s2, fa_ty) {\n            CtNamed(fn1, fargs1) => if fn1 == \"FrozenArray\" && Array::length(fargs1) == 1 {\n              subst_apply(s2, Array::get(fargs1, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"FrozenArray::length\" && Array::length(args) == 1 {\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtInt), s1, c1)\n        } else if name == \"MutList::empty\" && Array::length(args) == 1 {\n          let (r_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let zoned_r = subst_apply(s1, r_ty)\n          let is_region_token = match zoned_r {\n            CtNamed(zr_name, _) => String::length(zr_name) >= 8 && String::substring(zr_name, 0, 8) == \"#region_\",\n            _ => false\n          }\n          if is_region_token {\n            ()\n          } else {\n            Array::push(errors, String::concat(\"MutList::empty requires the region token bound by `region r { ... }` (the token is second-class and cannot be forged or passed through function parameters)\", off_marker_len(callee_off, String::length(name))))\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"MutList\", Array::slice([\n            CtUnknown,\n            zoned_r\n          ], 0, 2))), s1, c1)\n        } else if name == \"MutList::push\" && Array::length(args) == 2 {\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtUnit), s2, c2)\n        } else if name == \"MutList::freeze\" && Array::length(args) == 1 {\n          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, ml_ty) {\n            CtNamed(ml_name, ml_args) => if ml_name == \"MutList\" && Array::length(ml_args) == 2 {\n              subst_apply(s1, Array::get(ml_args, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"FrozenArray\", Array::slice([\n            elem\n          ], 0, 1))), s1, c1)\n        } else if name == \"MutList::to_array\" && Array::length(args) == 1 {\n          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, ml_ty) {\n            CtNamed(ml_name, ml_args) => if ml_name == \"MutList\" && Array::length(ml_args) == 2 {\n              subst_apply(s1, Array::get(ml_args, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtArray(elem)), s1, c1)\n        } else if name == \"FixedArray::make\" && Array::length(args) == 2 {\n          let (len_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let s1b = check_assignable(CtInt, subst_apply(s1, len_ty), s1, errors, \"FixedArray::make length must be Int\", call_off)\n          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1b, c1, errors, tytab)\n          let elem = subst_apply(s2, init_ty)\n          (tab_call_ty(tytab, call_off, CtNamed(\"FixedArray\", Array::slice([\n            elem\n          ], 0, 1))), s2, c2)\n        } else if name == \"FixedArray::get\" && Array::length(args) == 2 {\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty), s2, errors, \"FixedArray::get index must be Int\", call_off)\n          let result = match subst_apply(s2b, fa_ty) {\n            CtNamed(fan, faargs) => if fan == \"FixedArray\" && Array::length(faargs) == 1 {\n              subst_apply(s2b, Array::get(faargs, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2b, c2)\n        } else if (name == \"FixedArray::set\" || name == \"FixedArray::unsafe_set\") && Array::length(args) == 3 {\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty2, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty2), s2, errors, String::concat(\"index must be Int for \", name), call_off)\n          let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)\n          let s4 = match subst_apply(s3, fa_ty) {\n            CtNamed(fan2, faargs2) => if fan2 == \"FixedArray\" && Array::length(faargs2) == 1 {\n              check_assignable(subst_apply(s3, Array::get(faargs2, 0)), subst_apply(s3, v_ty), s3, errors, String::concat(\"value type mismatch for \", name), call_off)\n            } else {\n              s3\n            },\n            _ => s3\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\n        } else if name == \"FixedArray::length\" && Array::length(args) == 1 {\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtInt), s1, c1)\n        } else if name == \"FixedArray::blit\" && Array::length(args) == 5 {\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (dst_off_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, dst_off_ty), s2, errors, \"FixedArray::blit dst_off must be Int\", call_off)\n          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)\n          let (src_off_ty, s4, c4) = check_expr(Array::get(args, 3), env, defs, s3, c3, errors, tytab)\n          let s4b = check_assignable(CtInt, subst_apply(s4, src_off_ty), s4, errors, \"FixedArray::blit src_off must be Int\", call_off)\n          let (len_ty2, s5, c5) = check_expr(Array::get(args, 4), env, defs, s4b, c4, errors, tytab)\n          let s5b = check_assignable(CtInt, subst_apply(s5, len_ty2), s5, errors, \"FixedArray::blit len must be Int\", call_off)\n          (tab_call_ty(tytab, call_off, CtUnit), s5b, c5)\n        } else if name == \"Map