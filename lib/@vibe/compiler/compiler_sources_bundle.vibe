r\\n  // (i64) -> ()` (type 1, like Stdout's pair).\\n  if stderr_write_stream_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stderr_write_stream\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  if stderr_write_char_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stderr_write_char\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  if dbg_break_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"dbg_break\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 2)\\n  }\\n  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import\\n  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its\\n  // reserved import index order. Type index is the appended `(i32) -> ()` type.\\n  if dbg_line_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"dbg_line\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, dbg_line_type_idx)\\n  } else {\\n    ()\\n  }\\n  let mut li_emit = 0\\n  while li_emit < Array::length(linked_imports) {\\n    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)\\n    emit_name(import_content, lmod)\\n    emit_name(import_content, lfn)\\n    bytebuf_push(import_content, 0)\\n    let type_idx = num_base_types + lparams\\n    leb128_encode_u32(import_content, type_idx)\\n    li_emit = li_emit + 1\\n  }\\n  bytebuf_push_section(out, 2, import_content)\\n  let func_type_indices = lc_fresh_int_array()\\n  // #415 B-1: the builtin type indices are declared next to each body push\\n  // (push_builtin above), in the exact bodies order — splice them here where\\n  // a hand-maintained bare number list used to mirror that order from ~1,400\\n  // lines away.\\n  let mut bti = 0\\n  while bti < Array::length(builtin_type_idxs) {\\n    Array::push(func_type_indices, Array::get(builtin_type_idxs, bti))\\n    bti = bti + 1\\n  }\\n  let mut fti = 0\\n  while fti < num_user_funcs {\\n    let upc = Array::get(fn_param_counts, fti)\\n    Array::push(func_type_indices, num_base_types + upc)\\n    fti = fti + 1\\n  }\\n  Array::push(func_type_indices, 2)\\n  Array::push(func_type_indices, 5)\\n  let mut lfi = 0\\n  while lfi < num_lambdas {\\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\\n    Array::push(func_type_indices, num_base_types + lam_user_params)\\n    lfi = lfi + 1\\n  }\\n  if Array::length(func_type_indices) != Array::length(bodies) {\\n    throw(\\\"WASI codegen internal error: function section and code section count mismatch\\\")\\n  }\\n  emit_function_section(out, func_type_indices)\\n  let total_table_entries = num_user_funcs + num_lambdas\\n  if total_table_entries > 0 {\\n    emit_table_section_funcref(out, total_table_entries)\\n  }\\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + (if rc_shadow {\\n    rc_shadow_reserve()\\n  } else {\\n    0\\n  })))\\n  // #721: emit the tag section only when something can reference a tag --\\n  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared\\n  // effect (per-effect tags at index 4+). Pure-compute modules then carry no\\n  // exceptions machinery at all, which keeps V8 off its slower exnref module\\n  // path (~35% wall on call-heavy code; wasmtime is indifferent).\\n  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)\\n  if uses_exceptions {\\n    let tag_content = bytebuf_new()\\n    let num_tags = Array::length(effect_names_list) + 4\\n    bytebuf_push_vec_header(tag_content, num_tags)\\n    let mut tag_emit_i = 0\\n    while tag_emit_i < num_tags {\\n      bytebuf_push(tag_content, 0)\\n      leb128_encode_u32(tag_content, 1)\\n      tag_emit_i = tag_emit_i + 1\\n    }\\n    bytebuf_push_section(out, 13, tag_content)\\n  } else {\\n    ()\\n  }\\n  let global_content = bytebuf_new()\\n  // Base globals (bump ptr, effect state, ..., g_op_index) plus two i64\\n  // globals per module-level thunk (memo value + init flag) appended last —\\n  // see the thunk-body memoization above for the index formula.\\n  let tg_num_thunks = Array::length(thunk_names_list)\\n  if enable_rc {\\n    bytebuf_push_vec_header(global_content, 7 + tg_num_thunks * 2)\\n  } else {\\n    bytebuf_push_vec_header(global_content, 6 + tg_num_thunks * 2)\\n  }\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  if enable_rc {\\n    bytebuf_push(global_content, 127)\\n    bytebuf_push(global_content, 1)\\n    emit_i32_const(global_content, 0)\\n    emit_end(global_content)\\n  }\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start)\\n  emit_end(global_content)\\n  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a\\n  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  let mut tg_gi = 0\\n  while tg_gi < tg_num_thunks * 2 {\\n    bytebuf_push(global_content, 126)\\n    bytebuf_push(global_content, 1)\\n    emit_i64_const(global_content, 0)\\n    emit_end(global_content)\\n    tg_gi = tg_gi + 1\\n  }\\n  bytebuf_push_section(out, 6, global_content)\\n  let start_func_idx = func_offset + num_user_funcs\\n  let run_func_idx = start_func_idx + 1\\n  let all_export_names = lc_fresh_string_array()\\n  let all_export_indices = lc_fresh_int_array()\\n  if !library_mode {\\n    Array::push(all_export_names, \\\"_start\\\")\\n    Array::push(all_export_indices, start_func_idx)\\n  }\\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\\n    Array::push(all_export_names, entry_name)\\n    Array::push(all_export_indices, entry_func_idx)\\n  }\\n  let mut exi = 0\\n  while exi < Array::length(export_fn_names) {\\n    let ename = Array::get(export_fn_names, exi)\\n    let skip_export = library_mode && ename == entry_name\\n    if !skip_export && !array_contains_str(all_export_names, ename) {\\n      Array::push(all_export_names, ename)\\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\\n    }\\n    exi = exi + 1\\n  }\\n  // Per-block bench: export each `__bench_<name>` function so the runner's\\n  // `--bench` mode can time benchmark blocks individually (instead of running the\\n  // whole `_start`). Only `__no_entry__` test/bench builds populate test_fn_names,\\n  // so normal builds (incl. the compiler self-compile) are byte-identical. The\\n  // wasm index of a user function at user-index `j` is `j + func_offset`.\\n  let mut bxi = 0\\n  while bxi < Array::length(test_fn_names) {\\n    let bname = Array::get(test_fn_names, bxi)\\n    if String::starts_with(bname, \\\"__bench_\\\") && !array_contains_str(all_export_names, bname) {\\n      let mut bj = 0\\n      let mut bfound = 0 - 1\\n      while bj < num_user_funcs {\\n        if Array::get(fn_names_list, bj) == bname {\\n          bfound = bj\\n          bj = num_user_funcs\\n        } else {\\n          bj = bj + 1\\n        }\\n      }\\n      if bfound >= 0 {\\n        Array::push(all_export_names, bname)\\n        Array::push(all_export_indices, bfound + func_offset)\\n      }\\n    }\\n    bxi = bxi + 1\\n  }\\n  let export_content = bytebuf_new()\\n  // #721: the \\\"error\\\" tag export exists only when the tag section does.\\n  let export_count = Array::length(all_export_names) + 1 +\\n  (if library_mode {\\n    0\\n  } else {\\n    1 + (if uses_exceptions {\\n      1\\n    } else {\\n      0\\n    })\\n  })\\n  bytebuf_push_vec_header(export_content, export_count)\\n  let mut efi = 0\\n  while efi < Array::length(all_export_names) {\\n    emit_name(export_content, Array::get(all_export_names, efi))\\n    bytebuf_push(export_content, 0)\\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\\n    efi = efi + 1\\n  }\\n  emit_name(export_content, \\\"memory\\\")\\n  bytebuf_push(export_content, 2)\\n  leb128_encode_u32(export_content, 0)\\n  if !library_mode {\\n    emit_name(export_content, \\\"__heap_ptr\\\")\\n    bytebuf_push(export_content, 3)\\n    leb128_encode_u32(export_content, 0)\\n    if uses_exceptions {\\n      emit_name(export_content, \\\"error\\\")\\n      bytebuf_push(export_content, 4)\\n      leb128_encode_u32(export_content, 0)\\n    } else {\\n      ()\\n    }\\n  }\\n  bytebuf_push_section(out, 7, export_content)\\n  if total_table_entries > 0 {\\n    let table_func_indices = lc_fresh_int_array()\\n    let mut tei = 0\\n    while tei < num_user_funcs {\\n      Array::push(table_func_indices, func_offset + tei)\\n      tei = tei + 1\\n    }\\n    let mut tej = 0\\n    while tej < num_lambdas {\\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\\n      tej = tej + 1\\n    }\\n    emit_element_section_active(out, table_func_indices)\\n  }\\n  let code_content = bytebuf_new()\\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\\n  let mut ci = 0\\n  while ci < Array::length(bodies) {\\n    let body = Array::get(bodies, ci)\\n    let func_buf = bytebuf_new()\\n    let ni32 = Array::get(meta_i32, ci)\\n    let ni64 = Array::get(meta_i64, ci)\\n    if ni32 == 0 {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 0)\\n      } else {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    } else {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n      } else {\\n        leb128_encode_u32(func_buf, 2)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(code_content, func_buf)\\n    ci = ci + 1\\n  }\\n  bytebuf_push_section(out, 10, code_content)\\n  if num_strings > 0 {\\n    let data_offsets = lc_fresh_int_array()\\n    let data_bufs = lc_fresh_bytes_array()\\n    let mut di = 0\\n    while di < num_strings {\\n      Array::push(data_offsets, Array::get(str_offsets, di))\\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\\n      di = di + 1\\n    }\\n    emit_data_section_multi(out, data_offsets, data_bufs)\\n  }\\n  // Name section (debugger P0 / ADR-0035): name the user functions so wasm\\n  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.\\n  // User functions occupy consecutive indices starting at `func_offset`.\\n  // #768: emit ONLY the first num_user_funcs entries -- fn_names_list also\\n  // carries the builtin/runtime names appended for call resolution (Env::get,\\n  // Fs::read_file, ...), but those bodies live at LOW indices (below\\n  // func_offset). Emitting the whole list consecutively shifted every\\n  // post-user name: `_start` was labeled `Env::get` in crash stacks, which\\n  // repeatedly sent debugging to functions the trace never touched. `_start`\\n  // and `run` sit right after the user block, so name them explicitly.\\n  // #799: name the GENERATED runtime helpers too. Profilers (node --cpu-prof)\\n  // attributed the hottest samples to anonymous wasm-function[N] frames\\n  // because only user functions carried name-section entries; the generated\\n  // string/array/bytes helpers occupy the consecutive index range\\n  // [num_imported_funcs, func_offset). Unassigned slots (lambda-arity pads\\n  // etc.) keep the generic \\\"__rt_gen\\\" label.\\n  let gen_sec_names = lc_fresh_string_array()\\n  let mut gsn_i = 0\\n  while gsn_i < num_generated {\\n    Array::push(gen_sec_names, \\\"__rt_gen\\\")\\n    gsn_i = gsn_i + 1\\n  }\\n  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, \\\"__rt_print_int\\\")\\n  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, \\\"__rt_print_str\\\")\\n  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, \\\"__rt_str_len\\\")\\n  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, \\\"__rt_str_eq\\\")\\n  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, \\\"__rt_str_concat\\\")\\n  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, \\\"__rt_arr_new\\\")\\n  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, \\\"__rt_arr_len\\\")\\n  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, \\\"__rt_arr_get\\\")\\n  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, \\\"__rt_arr_push\\\")\\n  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, \\\"__rt_arr_set\\\")\\n  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, \\\"__rt_double_to_int\\\")\\n  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, \\\"__rt_int_to_double\\\")\\n  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, \\\"__rt_str_char_code_at\\\")\\n  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, \\\"__rt_str_from_char_code\\\")\\n  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, \\\"__rt_str_substring\\\")\\n  Array::set(gen_sec_names, identity_idx - num_imported_funcs, \\\"__rt_identity\\\")\\n  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, \\\"__rt_arr_slice\\\")\\n  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, \\\"__rt_arr_concat\\\")\\n  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, \\\"__rt_arr_truncate\\\")\\n  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, \\\"__rt_string_join\\\")\\n  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, \\\"__rt_stub_a\\\")\\n  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, \\\"__rt_stub_b\\\")\\n  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, \\\"__rt_stub_c\\\")\\n  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, \\\"__rt_stub_d\\\")\\n  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, \\\"__rt_stub_e\\\")\\n  Array::set(gen_sec_names, eq_idx - num_imported_funcs, \\\"__rt_eq\\\")\\n  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, \\\"__rt_string_ends_with\\\")\\n  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, \\\"__rt_string_last_index_of\\\")\\n  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, \\\"__rt_arr_push_all\\\")\\n  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, \\\"__rt_string_index_of\\\")\\n  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, \\\"__rt_string_contains\\\")\\n  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, \\\"__rt_string_starts_with\\\")\\n  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, \\\"__rt_string_split\\\")\\n  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, \\\"__rt_string_trim\\\")\\n  Array::set(gen_sec_names, selfhost_sources_idx - num_imported_funcs, \\\"__rt_selfhost_sources\\\")\\n  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, \\\"__rt_bytes_new\\\")\\n  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, \\\"__rt_bytes_len\\\")\\n  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, \\\"__rt_bytes_get\\\")\\n  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, \\\"__rt_bytes_set\\\")\\n  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, \\\"__rt_bytes_push\\\")\\n  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, \\\"__rt_bytes_append\\\")\\n  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, \\\"__rt_bytes_concat\\\")\\n  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, \\\"__rt_bytes_slice\\\")\\n  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, \\\"__rt_bytes_from_array\\\")\\n  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, \\\"__rt_bytes_to_array\\\")\\n  if enable_rc {\\n    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, \\\"__rt_rc_drop\\\")\\n    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, \\\"__rt_rc_alloc\\\")\\n  } else {\\n    ()\\n  }\\n  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, \\\"__rt_heap_grow_check\\\")\\n  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, \\\"__rt_simd_skip_ws\\\")\\n  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, \\\"__rt_simd_scan_alnum\\\")\\n  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, \\\"__rt_simd_scan_alnum_str\\\")\\n  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, \\\"__rt_str_lex_diff\\\")\\n  let name_sec_names = gen_sec_names\\n  let mut usn_i = 0\\n  while usn_i < num_user_funcs {\\n    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))\\n    usn_i = usn_i + 1\\n  }\\n  Array::push(name_sec_names, \\\"_start\\\")\\n  Array::push(name_sec_names, \\\"run\\\")\\n  emit_function_name_section(out, name_sec_names, num_imported_funcs)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, false, empty_dbg_prov())\\n}\\n\\n// #715 recurrence guard: RC + shadow-liveness instrumentation (VIBE_RC=shadow).\\nexport fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, true, empty_dbg_prov())\\n}\\n\\nexport fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, false, false, false, false, false, empty_dbg_prov())\\n}\\n\\n// Coverage build (#cov): compile with function-level hit instrumentation +\\n// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but\\n// with coverage enabled.\\nexport fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, true, false, false, false, empty_dbg_prov())\\n}\\n\\n// Trace build (debugger / DAP P1 groundwork): compile with function-call\\n// execution-trace instrumentation + `vibe.trace` custom section. Same as\\n// compile_wasi_module_with_sources_impl but with debug_trace enabled.\\nexport fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, true, false, false, empty_dbg_prov())\\n}\\n\\n// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook\\n// instrumentation at each user function entry. Same as\\n// compile_wasi_module_with_sources_impl but with debug_break enabled.\\nexport fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error } {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, true, false, prov)\\n}\\n\")\n}\n\nlet cli_adapter_source_90 = () -> (String, String) {\n  (\"lib/@vibe/compiler/component_codegen.vibe\",\n\"//# Imports\\n\\nimport ./bytebuf.vibe {\\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ./codegen/wasm_emit {\\n  emit_code_section, emit_export_section, emit_func_type_raw, emit_function_section, emit_header, emit_i32_add, emit_i32_const, emit_i32_store, emit_i64_const, emit_local_get, emit_local_set, emit_name\\n}\\n\\n//# Functions\\n\\nfn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {\\n  let mut value = 0\\n  let mut shift = 0\\n  let mut i = start\\n  let len = Bytes::length(bytes)\\n  let mut done = false\\n  while (i < len) && (done == false) {\\n    let b = Bytes::get(bytes, i)\\n    value = value|((b&127)<<shift)\\n    i = i + 1\\n    if (b&128) == 0 {\\n      done = true\\n    } else {\\n      shift = shift + 7\\n    }\\n  }\\n  (value, i)\\n}\\n\\nlet section_type = 7\\n\\nlet core_sort_mem = 2\\n\\nfn new_int_array() -> Array[Int] {\\n  Array::slice([\\n    0\\n  ], 0, 0)\\n}\\n\\nlet section_alias = 6\\n\\nlet section_canon = 8\\n\\nlet core_sort_func = 0\\n\\nfn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {\\n  read_uleb(bytes, start)\\n}\\n\\nfn skip_name(bytes: Bytes, start: Int) -> Int {\\n  let (name_len, after_len) = read_name_info(bytes, start)\\n  after_len + name_len\\n}\\n\\nlet section_export = 11\\n\\nlet section_import = 10\\n\\nlet section_module = 1\\n\\nfn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {\\n  let mut j = sec_start\\n  let (type_count, next_j) = read_uleb(bytes, j)\\n  j = next_j\\n  let mut t = 0\\n  while t < type_count {\\n    if j >= sec_end {\\n      t = type_count\\n    }\\n    else {\\n      let form = Bytes::get(bytes, j)\\n      j = j + 1\\n      if form != 96 {\\n        t = type_count\\n      }\\n      else {\\n        let sig = new_int_array()\\n        let (param_count, next_j2) = read_uleb(bytes, j)\\n        j = next_j2\\n        Array::push(sig, param_count)\\n        let mut p = 0\\n        while p < param_count {\\n          if j >= sec_end {\\n            p = param_count\\n          }\\n          else {\\n            Array::push(sig, Bytes::get(bytes, j))\\n            j = j + 1\\n            p = p + 1\\n          }\\n        }\\n        let (result_count, next_j3) = read_uleb(bytes, j)\\n        j = next_j3\\n        Array::push(sig, result_count)\\n        let mut rv = 0\\n        while rv < result_count {\\n          if j >= sec_end {\\n            rv = result_count\\n          }\\n          else {\\n            Array::push(sig, Bytes::get(bytes, j))\\n            j = j + 1\\n            rv = rv + 1\\n          }\\n        }\\n        Array::push(out_sigs, sig)\\n        t = t + 1\\n      }\\n    }\\n  }\\n}\\n\\nlet comp_extern_func = 1\\n\\nlet comp_valtype_f32 = 118\\n\\nlet comp_valtype_f64 = 117\\n\\nlet comp_valtype_s32 = 122\\n\\nlet comp_valtype_s64 = 120\\n\\nfn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {\\n  leb128_encode_u32(buf, Bytes::length(content))\\n  bytebuf_push_buf(buf, content)\\n}\\n\\nfn read_name_string(bytes: Bytes, start: Int) -> String {\\n  let (name_len, after_len) = read_name_info(bytes, start)\\n  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on\\n  // the name length (which can be hundreds of chars for mangled\\n  // identifiers).\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < name_len {\\n    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nfn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {\\n  let mut i = start\\n  if i >= end_pos {\\n    end_pos\\n  }\\n  else {\\n    let flags = Bytes::get(bytes, i)\\n    i = i + 1\\n    let (min_limit, next_i1) = read_uleb(bytes, i)\\n    let _ = min_limit\\n    i = next_i1\\n    if (flags&1) != 0 {\\n      let (max_limit, next_i2) = read_uleb(bytes, i)\\n      let _ = max_limit\\n      i = next_i2\\n    }\\n    if (flags&4) != 0 {\\n      let (page_size, next_i3) = read_uleb(bytes, i)\\n      let _ = page_size\\n      i = next_i3\\n    }\\n    if i > end_pos {\\n      end_pos\\n    } else {\\n      i\\n    }\\n  }\\n}\\n\\nlet component_magic_0 = 0\\n\\nlet component_magic_1 = 97\\n\\nlet component_magic_2 = 115\\n\\nlet component_magic_3 = 109\\n\\nfn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {\\n  let count = Array::length(names)\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_alias)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 0)\\n      bytebuf_push(content, Array::get(sorts, i))\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, core_instance_idx)\\n      emit_name(content, Array::get(names, i))\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet comp_valtype_string = 115\\n\\nlet component_version_0 = 13\\n\\nlet component_version_1 = 0\\n\\nlet component_version_2 = 1\\n\\nlet component_version_3 = 0\\n\\nfn core_to_comp_valtype(v: Int) -> Int {\\n  if v == 127 {\\n    comp_valtype_s32\\n  }\\n  else {\\n    if v == 126 {\\n      comp_valtype_s64\\n    }\\n    else {\\n      if v == 125 {\\n        comp_valtype_f32\\n      }\\n      else {\\n        if v == 124 {\\n          comp_valtype_f64\\n        }\\n        else {\\n          0 - 1\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, core_func_idx)\\n  if need_string != 0 {\\n    leb128_encode_u32(content, 3)\\n    bytebuf_push(content, 0)\\n    bytebuf_push(content, 3)\\n    leb128_encode_u32(content, memory_idx)\\n    bytebuf_push(content, 4)\\n    leb128_encode_u32(content, realloc_idx)\\n  } else {\\n    leb128_encode_u32(content, 0)\\n  }\\n  leb128_encode_u32(content, type_idx)\\n}\\n\\nfn emit_component_header(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, component_magic_0)\\n  bytebuf_push(buf, component_magic_1)\\n  bytebuf_push(buf, component_magic_2)\\n  bytebuf_push(buf, component_magic_3)\\n  bytebuf_push(buf, component_version_0)\\n  bytebuf_push(buf, component_version_1)\\n  bytebuf_push(buf, component_version_2)\\n  bytebuf_push(buf, component_version_3)\\n}\\n\\nlet section_core_instance = 2\\n\\nfn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {\\n  let mut i = start\\n  if kind == 1 {\\n    if i < end_pos {\\n      i = i + 1\\n    }\\n    i = skip_wasm_limits(bytes, i, end_pos)\\n  } else {\\n    if kind == 2 {\\n      i = skip_wasm_limits(bytes, i, end_pos)\\n    } else {\\n      if kind == 3 {\\n        if (i + 2) <= end_pos {\\n          i = i + 2\\n        } else {\\n          i = end_pos\\n        }\\n      } else {\\n        if kind == 4 {\\n          if i < end_pos {\\n            i = i + 1\\n          }\\n          let (type_idx, next_i) = read_uleb(bytes, i)\\n          let _ = type_idx\\n          i = next_i\\n        } else {\\n          i = end_pos\\n        }\\n      }\\n    }\\n  }\\n  if i > end_pos {\\n    end_pos\\n  } else {\\n    i\\n  }\\n}\\n\\nfn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\\n  let len = Bytes::length(core_wasm)\\n  if len < 8 {\\n    0\\n  }\\n  else {\\n    let type_sigs = Array::slice([\\n      [\\n        0\\n      ]\\n    ], 0, 0)\\n    let func_type_indices = new_int_array()\\n    let mut import_func_count = 0\\n    let mut i = 8\\n    let mut export_count = 0\\n    while i < len {\\n      let sec_id = Bytes::get(core_wasm, i)\\n      i = i + 1\\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\\n      i = next_i\\n      let sec_end = i + sec_size\\n      if sec_end > len {\\n        i = len\\n      }\\n      else {\\n        if sec_id == 1 {\\n          parse_type_sigs(core_wasm, i, sec_end, type_sigs)\\n        } else {\\n          if sec_id == 2 {\\n            let mut j = i\\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\\n            j = next_j\\n            let mut imp = 0\\n            while imp < imp_count {\\n              if j >= sec_end {\\n                imp = imp_count\\n              }\\n              else {\\n                j = skip_name(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                if j >= sec_end {\\n                  imp = imp_count\\n                }\\n                else {\\n                  let kind = Bytes::get(core_wasm, j)\\n                  j = j + 1\\n                  if kind == 0 {\\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                    let _ = type_idx\\n                    j = next_j2\\n                    import_func_count = import_func_count + 1\\n                  } else {\\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\\n                  }\\n                  imp = imp + 1\\n                }\\n              }\\n            }\\n          } else {\\n            if sec_id == 3 {\\n              let mut j = i\\n              let (func_count, next_j) = read_uleb(core_wasm, j)\\n              j = next_j\\n              let mut f = 0\\n              while f < func_count {\\n                if j >= sec_end {\\n                  f = func_count\\n                }\\n                else {\\n                  let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                  Array::push(func_type_indices, type_idx)\\n                  j = next_j2\\n                  f = f + 1\\n                }\\n              }\\n            } else {\\n              if sec_id == 7 {\\n                let mut j = i\\n                let (exp_count, next_j) = read_uleb(core_wasm, j)\\n                j = next_j\\n                let mut e = 0\\n                while e < exp_count {\\n                  if j >= sec_end {\\n                    e = exp_count\\n                  }\\n                  else {\\n                    let name = read_name_string(core_wasm, j)\\n                    j = skip_name(core_wasm, j)\\n                    if j >= sec_end {\\n                      e = exp_count\\n                    }\\n                    else {\\n                      let kind = Bytes::get(core_wasm, j)\\n                      j = j + 1\\n                      let (index, next_j2) = read_uleb(core_wasm, j)\\n                      j = next_j2\\n                      if kind == 0 {\\n                        let type_idx = if index < import_func_count {\\n                          0 - 1\\n                        }\\n                        else {\\n                          let local_idx = index - import_func_count\\n                          if local_idx < Array::length(func_type_indices) {\\n                            Array::get(func_type_indices, local_idx)\\n                          } else {\\n                            0 - 1\\n                          }\\n                        }\\n                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {\\n                          Array::push(out_names, name)\\n                          Array::push(out_func_indices, index)\\n                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))\\n                          export_count = export_count + 1\\n                        }\\n                      }\\n                      e = e + 1\\n                    }\\n                  }\\n                }\\n              }\\n            }\\n          }\\n        }\\n        i = sec_end\\n      }\\n    }\\n    export_count\\n  }\\n}\\n\\nfn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\\n  let len = Bytes::length(core_wasm)\\n  if len < 8 {\\n    0\\n  }\\n  else {\\n    let mut i = 8\\n    let mut import_count = 0\\n    while i < len {\\n      let sec_id = Bytes::get(core_wasm, i)\\n      i = i + 1\\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\\n      i = next_i\\n      let sec_end = i + sec_size\\n      if sec_end > len {\\n        i = len\\n      }\\n      else {\\n        if sec_id == 1 {\\n          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)\\n        } else {\\n          if sec_id == 2 {\\n            let mut j = i\\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\\n            j = next_j\\n            let mut imp = 0\\n            while imp < imp_count {\\n              if j >= sec_end {\\n                imp = imp_count\\n              }\\n              else {\\n                let mod_name = read_name_string(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                let fn_name = read_name_string(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                if j >= sec_end {\\n                  imp = imp_count\\n                }\\n                else {\\n                  let kind = Bytes::get(core_wasm, j)\\n                  j = j + 1\\n                  if kind == 0 {\\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                    j = next_j2\\n                    Array::push(out_module_names, mod_name)\\n                    Array::push(out_func_names, fn_name)\\n                    Array::push(out_type_indices, type_idx)\\n                    import_count = import_count + 1\\n                  } else {\\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\\n                  }\\n                  imp = imp + 1\\n                }\\n              }\\n            }\\n          }\\n        }\\n        i = sec_end\\n      }\\n    }\\n    import_count\\n  }\\n}\\n\\nfn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {\\n  let imp_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_type_indices = new_int_array()\\n  let type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)\\n  let seen_keys = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_idx_map_keys = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_idx_map_vals = new_int_array()\\n  let mut binding_count = 0\\n  let mut i = 0\\n  while i < Array::length(imp_module_names) {\\n    let mod_name = Array::get(imp_module_names, i)\\n    let fn_name = Array::get(imp_func_names, i)\\n    let key = \\\"\\\\{mod_name}||\\\\{fn_name}\\\"\\n    let mut already = false\\n    let mut s = 0\\n    while s < Array::length(seen_keys) {\\n      if Array::get(seen_keys, s) == key {\\n        already = true\\n      }\\n      s = s + 1\\n    }\\n    if already == false {\\n      Array::push(seen_keys, key)\\n      let type_idx = Array::get(imp_type_indices, i)\\n      if type_idx < Array::length(type_sigs) {\\n        let sig = Array::get(type_sigs, type_idx)\\n        let param_count = Array::get(sig, 0)\\n        let result_count_index = 1 + param_count\\n        let result_count = Array::get(sig, result_count_index)\\n        let comp_params = new_int_array()\\n        let mut valid = true\\n        let mut p = 0\\n        while p < param_count {\\n          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))\\n          if cv < 0 {\\n            valid = false\\n          }\\n          else {\\n            Array::push(comp_params, cv)\\n          }\\n          p = p + 1\\n        }\\n        let comp_results = new_int_array()\\n        let mut r = 0\\n        while r < result_count {\\n          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))\\n          if cv < 0 {\\n            valid = false\\n          }\\n          else {\\n            Array::push(comp_results, cv)\\n          }\\n          r = r + 1\\n        }\\n        if valid {\\n          let mut mod_idx = 0 - 1\\n          let mut mi = 0\\n          while mi < Array::length(module_idx_map_keys) {\\n            if Array::get(module_idx_map_keys, mi) == mod_name {\\n              mod_idx = Array::get(module_idx_map_vals, mi)\\n            }\\n            mi = mi + 1\\n          }\\n          if mod_idx < 0 {\\n            mod_idx = Array::length(out_unique_module_names)\\n            Array::push(out_unique_module_names, mod_name)\\n            Array::push(out_module_binding_counts, 0)\\n            Array::push(module_idx_map_keys, mod_name)\\n            Array::push(module_idx_map_vals, mod_idx)\\n          }\\n          let import_name = \\\"import-\\\\{binding_count}\\\"\\n          Array::push(out_import_names, import_name)\\n          Array::push(out_binding_func_names, fn_name)\\n          Array::push(out_binding_func_indices, binding_count)\\n          Array::push(out_comp_params, comp_params)\\n          let empty_names = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          Array::push(out_comp_param_names, empty_names)\\n          Array::push(out_comp_results, comp_results)\\n          let cur = Array::get(out_module_binding_counts, mod_idx)\\n          Array::set(out_module_binding_counts, mod_idx, cur + 1)\\n          binding_count = binding_count + 1\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  binding_count\\n}\\n\\nlet comp_inst_arg_instance = 18\\n\\nfn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nfn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_canon)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 1)\\n      bytebuf_push(content, 0)\\n      leb128_encode_u32(content, i)\\n      leb128_encode_u32(content, 0)\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nfn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_import)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 0)\\n      emit_name(content, Array::get(import_names, i))\\n      bytebuf_push(content, comp_extern_func)\\n      leb128_encode_u32(content, i)\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nfn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {\\n  bytebuf_push(buf, section_module)\\n  let wasm_len = Bytes::length(core_wasm)\\n  leb128_encode_u32(buf, wasm_len)\\n  bytebuf_push_buf(buf, core_wasm)\\n}\\n\\nfn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {\\n  emit_alias_section(buf, core_instance_idx, [\\n    \\\"_start\\\",\\n    \\\"memory\\\"\\n  ], [\\n    core_sort_func,\\n    core_sort_mem\\n  ])\\n}\\n\\n// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the\\n// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file\\n// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).\\nfn comp_underscores_to_dashes(name: String) -> String {\\n  let len = String::length(name)\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(name, i)\\n    if c == 95 {\\n      out = String::concat(out, \\\"-\\\")\\n    } else {\\n      out = String::concat(out, String::from_char_code(c))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn normalize_comp_param_name(name: String) -> String {\\n  comp_underscores_to_dashes(name)\\n}\\n\\nfn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {\\n  if is_async != 0 {\\n    bytebuf_push(content, 67)\\n  } else {\\n    bytebuf_push(content, 64)\\n  }\\n  leb128_encode_u32(content, Array::length(param_types))\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    let name = if i < Array::length(param_names) {\\n      normalize_comp_param_name(Array::get(param_names, i))\\n    }\\n    else {\\n      \\\"p\\\\{i}\\\"\\n    }\\n    emit_name(content, name)\\n    bytebuf_push(content, Array::get(param_types, i))\\n    i = i + 1\\n  }\\n  if Array::length(result_types) == 0 {\\n    bytebuf_push(content, 1)\\n    leb128_encode_u32(content, 0)\\n  } else {\\n    if Array::length(result_types) == 1 {\\n      bytebuf_push(content, 0)\\n      bytebuf_push(content, Array::get(result_types, 0))\\n    } else {\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, Array::length(result_types))\\n      let mut r = 0\\n      while r < Array::length(result_types) {\\n        emit_name(content, \\\"r\\\\{r}\\\")\\n        bytebuf_push(content, Array::get(result_types, r))\\n        r = r + 1\\n      }\\n    }\\n  }\\n}\\n\\nfn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {\\n  let count = Array::length(sigs_params)\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_type)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nfn emit_comp_type_section_run(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, section_type)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  emit_comp_func_type(content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), [\\n    comp_valtype_s64\\n  ], 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nfn normalize_comp_export_name(name: String) -> String {\\n  comp_underscores_to_dashes(name)\\n}\\n\\nfn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {\\n  let export_name = normalize_comp_export_name(name)\\n  bytebuf_push(buf, section_export)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_name(content, export_name)\\n  bytebuf_push(content, comp_extern_func)\\n  leb128_encode_u32(content, func_idx)\\n  leb128_encode_u32(content, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nexport fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {\\n  let buf = bytebuf_new()\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 97)\\n  bytebuf_push(buf, 115)\\n  bytebuf_push(buf, 109)\\n  bytebuf_push(buf, 1)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n  let body = bytebuf_new()\\n  let type_sec = bytebuf_new()\\n  leb128_encode_u32(type_sec, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, string_param_count + 1)\\n  let mut ti = 0\\n  while ti < string_param_count {\\n    bytebuf_push(type_sec, 126)\\n    ti = ti + 1\\n  }\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 126)\\n  bytebuf_push(type_sec, 96)\\n  bytebuf_push(type_sec, 4)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, string_param_count * 2)\\n  let mut ci = 0\\n  while ci < (string_param_count * 2) {\\n    bytebuf_push(type_sec, 127)\\n    ci = ci + 1\\n  }\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 126)\\n  if call_run_init != 0 {\\n    bytebuf_push(type_sec, 96)\\n    leb128_encode_u32(type_sec, 0)\\n    bytebuf_push(type_sec, 1)\\n    bytebuf_push(type_sec, 126)\\n  }\\n  bytebuf_push_section(body, 1, type_sec)\\n  let import_sec = bytebuf_new()\\n  leb128_encode_u32(import_sec, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"target_func\\\")\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"cabi_realloc\\\")\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 1)\\n  if call_run_init != 0 {\\n    emit_name(import_sec, \\\"env\\\")\\n    emit_name(import_sec, \\\"run_init\\\")\\n    bytebuf_push(import_sec, 0)\\n    leb128_encode_u32(import_sec, 3)\\n  }\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"memory\\\")\\n  bytebuf_push(import_sec, 2)\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  bytebuf_push_section(body, 2, import_sec)\\n  let func_sec = bytebuf_new()\\n  leb128_encode_u32(func_sec, 1)\\n  leb128_encode_u32(func_sec, 2)\\n  bytebuf_push_section(body, 3, func_sec)\\n  let export_sec = bytebuf_new()\\n  leb128_encode_u32(export_sec, 1)\\n  emit_name(export_sec, \\\"canon_func\\\")\\n  bytebuf_push(export_sec, 0)\\n  leb128_encode_u32(export_sec, if call_run_init != 0 {\\n    3\\n  } else {\\n    2\\n  })\\n  bytebuf_push_section(body, 7, export_sec)\\n  let code_sec = bytebuf_new()\\n  leb128_encode_u32(code_sec, 1)\\n  let func_body = bytebuf_new()\\n  leb128_encode_u32(func_body, 2)\\n  leb128_encode_u32(func_body, string_param_count)\\n  bytebuf_push(func_body, 126)\\n  leb128_encode_u32(func_body, string_param_count)\\n  bytebuf_push(func_body, 127)\\n  if call_run_init != 0 {\\n    bytebuf_push(func_body, 16)\\n    leb128_encode_u32(func_body, 2)\\n    bytebuf_push(func_body, 26)\\n  }\\n  let tagged_base = string_param_count * 2\\n  let obj_base = tagged_base + string_param_count\\n  let mut si = 0\\n  while si < string_param_count {\\n    let ptr_local = si * 2\\n    let len_local = (si * 2) + 1\\n    let tagged_local = tagged_base + si\\n    let obj_local = obj_base + si\\n    emit_i32_const(func_body, 0)\\n    emit_i32_const(func_body, 0)\\n    emit_i32_const(func_body, 4)\\n    emit_local_get(func_body, len_local)\\n    emit_i32_const(func_body, 8)\\n    emit_i32_add(func_body)\\n    bytebuf_push(func_body, 16)\\n    leb128_encode_u32(func_body, 1)\\n    emit_local_set(func_body, obj_local)\\n    emit_local_get(func_body, obj_local)\\n    emit_i32_const(func_body, 1)\\n    emit_i32_store(func_body, 0, 0)\\n    emit_local_get(func_body, obj_local)\\n    emit_local_get(func_body, len_local)\\n    emit_i32_store(func_body, 0, 4)\\n    emit_local_get(func_body, obj_local)\\n    emit_i32_const(func_body, 8)\\n    emit_i32_add(func_body)\\n    emit_local_get(func_body, ptr_local)\\n    emit_local_get(func_body, len_local)\\n    bytebuf_push(func_body, 252)\\n    leb128_encode_u32(func_body, 10)\\n    bytebuf_push(func_body, 0)\\n    bytebuf_push(func_body, 0)\\n    emit_local_get(func_body, obj_local)\\n    bytebuf_push(func_body, 173)\\n    bytebuf_push(func_body, 66)\\n    leb128_encode_s64(func_body, 1)\\n    bytebuf_push(func_body, 132)\\n    emit_local_set(func_body, tagged_local)\\n    si = si + 1\\n  }\\n  let mut ci2 = 0\\n  while ci2 < string_param_count {\\n    emit_local_get(func_body, tagged_base + ci2)\\n    ci2 = ci2 + 1\\n  }\\n  emit_i32_const(func_body, 0)\\n  bytebuf_push(func_body, 16)\\n  leb128_encode_u32(func_body, 0)\\n  bytebuf_push(func_body, 11)\\n  leb128_encode_u32(code_sec, Bytes::length(func_body))\\n  bytebuf_push_buf(code_sec, func_body)\\n  bytebuf_push_section(body, 10, code_sec)\\n  bytebuf_push_buf(buf, body)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nfn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {\\n  if num_modules == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_core_instance)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, num_modules)\\n    let mut offset = 0\\n    let mut m = 0\\n    while m < num_modules {\\n      let count = Array::get(module_binding_counts, m)\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, count)\\n      let mut b = 0\\n      while b < count {\\n        emit_name(content, Array::get(binding_func_names, offset + b))\\n        bytebuf_push(content, core_sort_func)\\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\\n        b = b + 1\\n      }\\n      offset = offset + count\\n      m = m + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nfn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(module_names))\\n  let mut i = 0\\n  while i < Array::length(module_names) {\\n    emit_name(content, Array::get(module_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, i)\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\n\\nexport fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_core_instance_instantiate_section(buf, 0, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_alias_run_and_memory(buf, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nexport fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {\\n  let import_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_indices = new_int_array()\\n  let unique_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_binding_counts = new_int_array()\\n  let comp_params = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let comp_param_names = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let comp_results = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\\n  let main_instance_idx = Array::length(unique_module_names)\\n  let run_core_func_idx = import_func_count\\n  let run_type_idx = import_func_count\\n  let run_func_idx = import_func_count\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  let async_flags = new_int_array()\\n  let mut af = 0\\n  while af < import_func_count {\\n    Array::push(async_flags, 0)\\n    af = af + 1\\n  }\\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\\n  emit_comp_import_section(buf, import_names, import_func_count)\\n  emit_canon_lower_section(buf, import_func_count)\\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\\n  emit_alias_run_and_memory(buf, main_instance_idx)\\n  emit_comp_type_section_run(buf)\\n  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)\\n  emit_comp_export_section(buf, export_name, run_func_idx)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nexport fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {\\n  let import_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_indices = new_int_array()\\n  let unique_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_binding_counts = new_int_array()\\n  let comp_params = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let comp_param_names = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let comp_results = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let export_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let export_func_indices = new_int_array()\\n  let export_type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\\n  let mut call_run_init = 0\\n  let mut ei = 0\\n  while ei < Array::length(export_names) {\\n    if Array::get(export_names, ei) == \\\"_start\\\" {\\n      call_run_init = 1\\n      ei = Array::length(export_names)\\n    } else {\\n      ei = ei + 1\\n    }\\n  }\\n  let has_distinct_run_alias =\\n  if (call_run_init != 0) && (target_func_name != \\\"_start\\\") {\\n    1\\n  } else {\\n    0\\n  }\\n  let main_instance_idx = Array::length(unique_module_names)\\n  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_core_module_section(buf, trampoline_wasm)\\n  let async_flags = new_int_array()\\n  let mut af = 0\\n  while af < import_func_count {\\n    Array::push(async_flags, 0)\\n    af = af + 1\\n  }\\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\\n  emit_comp_import_section(buf, import_names, import_func_count)\\n  emit_canon_lower_section(buf, import_func_count)\\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\\n  let alias_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let alias_sorts = new_int_array()\\n  Array::push(alias_names, target_func_name)\\n  Array::push(alias_sorts, core_sort_func)\\n  Array::push(alias_names, \\\"cabi_realloc\\\")\\n  Array::push(alias_sorts, core_sort_func)\\n  if has_distinct_run_alias != 0 {\\n    Array::push(alias_names, \\\"_start\\\")\\n    Array::push(alias_sorts, core_sort_func)\\n  }\\n  Array::push(alias_names, \\\"memory\\\")\\n  Array::push(alias_sorts, core_sort_mem)\\n  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)\\n  let target_func_core_idx = import_func_count\\n  let cabi_realloc_core_idx = import_func_count + 1\\n  let run_init_core_idx =\\n  if call_run_init != 0 {\\n    if has_distinct_run_alias != 0 {\\n      import_func_count + 2\\n    } else {\\n      target_func_core_idx\\n    }\\n  } else {\\n    0 - 1\\n  }\\n  bytebuf_push(buf, section_core_instance)\\n  let tramp_env = bytebuf_new()\\n  leb128_encode_u32(tramp_env, 1)\\n  bytebuf_push(tramp_env, 1)\\n  leb128_encode_u32(tramp_env, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  emit_name(tramp_env, \\\"target_func\\\")\\n  bytebuf_push(tramp_env, core_sort_func)\\n  leb128_encode_u32(tramp_env, target_func_core_idx)\\n  emit_name(tramp_env, \\\"cabi_realloc\\\")\\n  bytebuf_push(tramp_env, core_sort_func)\\n  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)\\n  if call_run_init != 0 {\\n    emit_name(tramp_env, \\\"run_init\\\")\\n    bytebuf_push(tramp_env, core_sort_func)\\n    leb128_encode_u32(tramp_env, run_init_core_idx)\\n  }\\n  emit_name(tramp_env, \\\"memory\\\")\\n  bytebuf_push(tramp_env, core_sort_mem)\\n  leb128_encode_u32(tramp_env, 0)\\n  emit_raw_content(buf, tramp_env)\\n  let env_instance_idx = main_instance_idx + 1\\n  bytebuf_push(buf, section_core_instance)\\n  let tramp_inst = bytebuf_new()\\n  leb128_encode_u32(tramp_inst, 1)\\n  bytebuf_push(tramp_inst, 0)\\n  leb128_encode_u32(tramp_inst, 1)\\n  leb128_encode_u32(tramp_inst, 1)\\n  emit_name(tramp_inst, \\\"env\\\")\\n  bytebuf_push(tramp_inst, comp_inst_arg_instance)\\n  leb128_encode_u32(tramp_inst, env_instance_idx)\\n  emit_raw_content(buf, tramp_inst)\\n  let trampoline_instance_idx = env_instance_idx + 1\\n  emit_alias_section(buf, trampoline_instance_idx, [\\n    \\\"canon_func\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  let alias_func_count = if has_distinct_run_alias != 0 {\\n    3\\n  } else {\\n    2\\n  }\\n  let canon_func_core_idx = import_func_count + alias_func_count\\n  bytebuf_push(buf, section_type)\\n  let type_content = bytebuf_new()\\n  leb128_encode_u32(type_content, 1)\\n  if is_async != 0 {\\n    bytebuf_push(type_content, 67)\\n  } else {\\n    bytebuf_push(type_content, 64)\\n  }\\n  leb128_encode_u32(type_content, string_param_count)\\n  let mut pi = 0\\n  while pi < string_param_count {\\n    let pname = if pi < Array::length(param_names) {\\n      normalize_comp_param_name(Array::get(param_names, pi))\\n    }\\n    else {\\n      \\\"p\\\\{pi}\\\"\\n    }\\n    emit_name(type_content, pname)\\n    bytebuf_push(type_content, comp_valtype_string)\\n    pi = pi + 1\\n  }\\n  bytebuf_push(type_content, 0)\\n  bytebuf_push(type_content, comp_valtype_s64)\\n  emit_raw_content(buf, type_content)\\n  let component_type_idx = import_func_count\\n  bytebuf_push(buf, section_canon)\\n  let canon_content = bytebuf_new()\\n  leb128_encode_u32(canon_content, 1)\\n  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)\\n  emit_raw_content(buf, canon_content)\\n  let lifted_func_idx = import_func_count\\n  emit_comp_export_section(buf, export_name, lifted_func_idx)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// WASI 0.3 async (M1b, docs/spec/wasi-p3-async.md §3.2). The `task.return`\\n// canonical built-in lowers to a core func `(param <result>) -> ()` that\\n// delivers an async-lifted export's result. Encoding verified byte-for-byte\\n// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):\\n// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result\\n// Some(valtype); empty options).\\nfn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 9)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  bytebuf_push(content, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it\\n// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>\\n// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).\\nfn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, core_func_idx)\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 6)\\n  leb128_encode_u32(content, type_idx)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Component type section with a single async func type `() -> <result>`.\\n// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;\\n// 0 params; result-form 0x00 + valtype).\\nfn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {\\n  bytebuf_push(buf, section_type)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 67)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Wrap a core module that imports (\\\"cm\\\",\\\"task-return\\\") and exports a void `run`\\n// into an async-lifted component export. Section order mirrors\\n// cm_async_lift_probe.wat (verified to run on wasmtime 45 with\\n// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).\\n// `result_valtype` is the component valtype of the lifted result (e.g.\\n// comp_valtype_s64 for vibe Int).\\nexport fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_canon_task_return(buf, result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_core_instance_instantiate_section(buf, 0, [\\n    \\\"cm\\\"\\n  ])\\n  emit_comp_async_functype_section(buf, result_valtype)\\n  emit_alias_section(buf, 1, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 1, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// Map a component valtype to the core valtype it lowers from (inverse of\\n// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.\\nfn comp_valtype_to_core(v: Int) -> Int {\\n  if v == comp_valtype_s64 {\\n    126\\n  }\\n  else {\\n    if v == comp_valtype_s32 {\\n      127\\n    }\\n    else {\\n      if v == comp_valtype_f32 {\\n        125\\n      }\\n      else {\\n        if v == comp_valtype_f64 {\\n          124\\n        }\\n        else {\\n          127\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// M1b-2 (docs/spec/wasi-p3-async.md §3.4). Async trampoline core module: imports\\n// the normally-compiled entry (\\\"main\\\",\\\"run\\\" : () -> <core_valtype>) and\\n// (\\\"cm\\\",\\\"task-return\\\" : (<core_valtype>) -> ()), and exports a void `run` that\\n// calls the entry and forwards its result to task.return. Byte template verified\\n// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).\\nfn comp_generate_async_trampoline(core_valtype: Int) -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 3)\\n  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result\\n  // (the i64 is the unit argument), so the trampoline passes a dummy i64.\\n  emit_func_type_raw(tc, [\\n    126\\n  ], [\\n    core_valtype\\n  ])\\n  emit_func_type_raw(tc, [\\n    core_valtype\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(tc, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, 1, tc)\\n  let ic = bytebuf_new()\\n  bytebuf_push_vec_header(ic, 2)\\n  emit_name(ic, \\\"main\\\")\\n  emit_name(ic, \\\"run\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 0)\\n  emit_name(ic, \\\"cm\\\")\\n  emit_name(ic, \\\"task-return\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 1)\\n  bytebuf_push_section(out, 2, ic)\\n  emit_function_section(out, [\\n    2\\n  ])\\n  emit_export_section(out, \\\"run\\\", 2)\\n  let body = bytebuf_new()\\n  emit_i64_const(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 1)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\n\\n// Instantiate a core module with explicit (arg-name -> core-instance-index) args.\\n// Unlike emit_core_instance_instantiate_section, the arg instance indices need\\n// not be sequential.\\nfn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(arg_names))\\n  let mut i = 0\\n  while i < Array::length(arg_names) {\\n    emit_name(content, Array::get(arg_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\n\\n// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value\\n// returned directly) into an async-lifted component export via the trampoline\\n// (two-module) approach — no change to the core module / linked_compile needed.\\n// `comp_result_valtype` is the component valtype of the lifted result\\n// (comp_valtype_s64 for vibe Int). Section order mirrors\\n// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).\\nexport fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, main_core_wasm)\\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\\n  emit_core_instance_instantiate_section(buf, 0, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_canon_task_return(buf, comp_result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_alias_section(buf, 0, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"run\\\"\\n  ], [\\n    1\\n  ])\\n  emit_core_instance_instantiate_args(buf, 1, [\\n    \\\"main\\\",\\n    \\\"cm\\\"\\n  ], [\\n    2,\\n    1\\n  ])\\n  emit_comp_async_functype_section(buf, comp_result_valtype)\\n  emit_alias_section(buf, 3, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 2, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module\\n// (`(i32,i32,i32,i32) -> i32` returning 0). selfhost-compiled core modules\\n// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the\\n// stub satisfies that import so the async component is self-contained and\\n// instantiable without an external preview1 adapter.\\nfn comp_generate_wasi_fd_write_stub() -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 1)\\n  emit_func_type_raw(tc, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  bytebuf_push_section(out, 1, tc)\\n  emit_function_section(out, [\\n    0\\n  ])\\n  emit_export_section(out, \\\"fd_write\\\", 0)\\n  let body = bytebuf_new()\\n  emit_i32_const(body, 0)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\n\\n// Like comp_emit_component_wasm_async_trampolined, but for a main core module\\n// that imports `wasi_snapshot_preview1.fd_write` (every selfhost core does). A\\n// fd_write stub module is instantiated first and supplied to the main module's\\n// instantiation, making the async component fully self-contained / runnable.\\n// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),\\n// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.\\nexport fn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, main_core_wasm)\\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\\n  emit_core_instance_instantiate_section(buf, 2, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_core_instance_instantiate_args(buf, 0, [\\n    \\\"wasi_snapshot_preview1\\\"\\n  ], [\\n    0\\n  ])\\n  emit_canon_task_return(buf, comp_result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_alias_section(buf, 1, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"run\\\"\\n  ], [\\n    1\\n  ])\\n  emit_core_instance_instantiate_args(buf, 1, [\\n    \\\"main\\\",\\n    \\\"cm\\\"\\n  ], [\\n    3,\\n    2\\n  ])\\n  emit_comp_async_functype_section(buf, comp_result_valtype)\\n  emit_alias_section(buf, 4, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 2, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// #537: core:sort for globals (func=0, table=1, mem=2, global=3).\\nlet core_sort_global = 3\\n\\n// #537: from-exports core instance with per-item sorts (the older\\n// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string\\n// env instance also carries the main memory and the __heap_ptr global).\\nfn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 1)\\n  leb128_encode_u32(content, Array::length(names))\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    emit_name(content, Array::get(names, i))\\n    bytebuf_push(content, Array::get(sorts, i))\\n    leb128_encode_u32(content, Array::get(indices, i))\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\n\\n// #537: string trampoline for the CURRENT selfhost wasi linear backend ABI.\\n// A vibe string value is the packed i64 `(byte_offset << 32) | byte_len`\\n// (mode-invariant: identical under bump and RC; see gen_str_len_body /\\n// gen_str_char_code_at_body). The legacy comp_generate_string_trampoline\\n// predates this and builds retired-host heap-object strings, so it cannot\\n// call today's core modules.\\n//\\n// Imports (module \\\"env\\\", all supplied from the main core instance):\\n//   target_func : (i64 x N) -> i64      the exported vibe handler\\n//   memory      : the main linear memory\\n//   __heap_ptr  : mut i32 global        the main module's bump frontier\\n// Exports:\\n//   cabi_realloc : (i32,i32,i32,i32) -> i32\\n//     Canonical-ABI allocator used by the host to lower string params into\\n//     the main memory (and by canon_func for the string-result ret area).\\n//     Bumps __heap_ptr (align-adjusted) and memory.grows as needed. Fresh\\n//     allocations only (old_ptr is ignored) — the canonical lowering of\\n//     bare string params/results never reallocates.\\n//   canon_func : (i32 x 2N) -> i32\\n//     Canonical-ABI core shape of `(string x N) -> string`: N (ptr,len)\\n//     pairs in, retptr out. Packs each pair into a vibe string value, calls\\n//     target_func, unpacks the returned value into an 8-byte (ptr,len)\\n//     return area allocated via cabi_realloc.\\nexport fn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes {\\n  let buf = bytebuf_new()\\n  emit_header(buf)\\n  // types: 0 = target_func (i64 x N) -> i64; 1 = canon_func (i32 x 2N) -> i32;\\n  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32\\n  let type_sec = bytebuf_new()\\n  bytebuf_push_vec_header(type_sec, 3)\\n  bytebuf_push(type_sec, 96)\\n  // +1: top-level vibe functions carry a trailing closure-env i64 param\\n  // (callers pass 0); see linked_compile's entry invocation.\\n  leb128_encode_u32(type_sec, string_param_count + 1)\\n  let mut ti = 0\\n  while ti < (string_param_count + 1) {\\n    bytebuf_push(type_sec, 126)\\n    ti = ti + 1\\n  }\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 126)\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, string_param_count * 2)\\n  let mut ci = 0\\n  while ci < (string_param_count * 2) {\\n    bytebuf_push(type_sec, 127)\\n    ci = ci + 1\\n  }\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, 4)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push_section(buf, 1, type_sec)\\n  // imports: env.target_func (func 0), env.__heap_ptr (mut i32 global), env.memory\\n  let import_sec = bytebuf_new()\\n  leb128_encode_u32(import_sec, 3)\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"target_func\\\")\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"__heap_ptr\\\")\\n  bytebuf_push(import_sec, 3)\\n  bytebuf_push(import_sec, 127)\\n  bytebuf_push(import_sec, 1)\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"memory\\\")\\n  bytebuf_push(import_sec, 2)\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  bytebuf_push_section(buf, 2, import_sec)\\n  // funcs: 1 = canon_func (type 1), 2 = cabi_realloc (type 2)\\n  let func_sec = bytebuf_new()\\n  leb128_encode_u32(func_sec, 2)\\n  leb128_encode_u32(func_sec, 1)\\n  leb128_encode_u32(func_sec, 2)\\n  bytebuf_push_section(buf, 3, func_sec)\\n  let export_sec = bytebuf_new()\\n  leb128_encode_u32(export_sec, 2)\\n  emit_name(export_sec, \\\"canon_func\\\")\\n  bytebuf_push(export_sec, 0)\\n  leb128_encode_u32(export_sec, 1)\\n  emit_name(export_sec, \\\"cabi_realloc\\\")\\n  bytebuf_push(export_sec, 0)\\n  leb128_encode_u32(export_sec, 2)\\n  bytebuf_push_section(buf, 7, export_sec)\\n  let code_sec = bytebuf_new()\\n  leb128_encode_u32(code_sec, 2)\\n  // canon_func body. locals: params 0..2N-1 (i32); 2N = result i64; 2N+1 = retptr i32\\n  let canon_body = bytebuf_new()\\n  leb128_encode_u32(canon_body, 2)\\n  leb128_encode_u32(canon_body, 1)\\n  bytebuf_push(canon_body, 126)\\n  leb128_encode_u32(canon_body, 1)\\n  bytebuf_push(canon_body, 127)\\n  let result_local = string_param_count * 2\\n  let retptr_local = result_local + 1\\n  let mut si = 0\\n  while si < string_param_count {\\n    // (extend_u(ptr) << 32) | extend_u(len)\\n    emit_local_get(canon_body, si * 2)\\n    bytebuf_push(canon_body, 173)\\n    emit_i64_const(canon_body, 32)\\n    bytebuf_push(canon_body, 134)\\n    emit_local_get(canon_body, (si * 2) + 1)\\n    bytebuf_push(canon_body, 173)\\n    bytebuf_push(canon_body, 132)\\n    si = si + 1\\n  }\\n  // Trailing closure-env argument (0 for a top-level function).\\n  emit_i64_const(canon_body, 0)\\n  bytebuf_push(canon_body, 16)\\n  leb128_encode_u32(canon_body, 0)\\n  emit_local_set(canon_body, result_local)\\n  // retptr = cabi_realloc(0, 0, 4, 8)\\n  emit_i32_const(canon_body, 0)\\n  emit_i32_const(canon_body, 0)\\n  emit_i32_const(canon_body, 4)\\n  emit_i32_const(canon_body, 8)\\n  bytebuf_push(canon_body, 16)\\n  leb128_encode_u32(canon_body, 2)\\n  emit_local_set(canon_body, retptr_local)\\n  // [retptr] = wrap(result >> 32); [retptr+4] = wrap(result & 0xFFFFFFFF)\\n  emit_local_get(canon_body, retptr_local)\\n  emit_local_get(canon_body, result_local)\\n  emit_i64_const(canon_body, 32)\\n  bytebuf_push(canon_body, 136)\\n  bytebuf_push(canon_body, 167)\\n  emit_i32_store(canon_body, 2, 0)\\n  emit_local_get(canon_body, retptr_local)\\n  emit_local_get(canon_body, result_local)\\n  bytebuf_push(canon_body, 167)\\n  emit_i32_store(canon_body, 2, 4)\\n  emit_local_get(canon_body, retptr_local)\\n  bytebuf_push(canon_body, 11)\\n  leb128_encode_u32(code_sec, Bytes::length(canon_body))\\n  bytebuf_push_buf(code_sec, canon_body)\\n  // cabi_realloc body. params: 0=old_ptr 1=old_size 2=align 3=new_size;\\n  // local 4 = aligned ptr.\\n  let realloc_body = bytebuf_new()\\n  leb128_encode_u32(realloc_body, 1)\\n  leb128_encode_u32(realloc_body, 1)\\n  bytebuf_push(realloc_body, 127)\\n  // p = (heap + align - 1) & (0 - align)\\n  bytebuf_push(realloc_body, 35)\\n  leb128_encode_u32(realloc_body, 0)\\n  emit_local_get(realloc_body, 2)\\n  emit_i32_add(realloc_body)\\n  emit_i32_const(realloc_body, 1)\\n  bytebuf_push(realloc_body, 107)\\n  emit_i32_const(realloc_body, 0)\\n  emit_local_get(realloc_body, 2)\\n  bytebuf_push(realloc_body, 107)\\n  bytebuf_push(realloc_body, 113)\\n  emit_local_set(realloc_body, 4)\\n  // __heap_ptr = p + new_size\\n  emit_local_get(realloc_body, 4)\\n  emit_local_get(realloc_body, 3)\\n  emit_i32_add(realloc_body)\\n  bytebuf_push(realloc_body, 36)\\n  leb128_encode_u32(realloc_body, 0)\\n  // if (__heap_ptr > memory.size << 16) memory.grow(pages needed)\\n  bytebuf_push(realloc_body, 35)\\n  leb128_encode_u32(realloc_body, 0)\\n  bytebuf_push(realloc_body, 63)\\n  bytebuf_push(realloc_body, 0)\\n  emit_i32_const(realloc_body, 16)\\n  bytebuf_push(realloc_body, 116)\\n  bytebuf_push(realloc_body, 75)\\n  bytebuf_push(realloc_body, 4)\\n  bytebuf_push(realloc_body, 64)\\n  bytebuf_push(realloc_body, 35)\\n  leb128_encode_u32(realloc_body, 0)\\n  emit_i32_const(realloc_body, 65535)\\n  emit_i32_add(realloc_body)\\n  emit_i32_const(realloc_body, 16)\\n  bytebuf_push(realloc_body, 118)\\n  bytebuf_push(realloc_body, 63)\\n  bytebuf_push(realloc_body, 0)\\n  bytebuf_push(realloc_body, 107)\\n  bytebuf_push(realloc_body, 64)\\n  bytebuf_push(realloc_body, 0)\\n  bytebuf_push(realloc_body, 26)\\n  bytebuf_push(realloc_body, 11)\\n  emit_local_get(realloc_body, 4)\\n  bytebuf_push(realloc_body, 11)\\n  leb128_encode_u32(code_sec, Bytes::length(realloc_body))\\n  bytebuf_push_buf(code_sec, realloc_body)\\n  bytebuf_push_section(buf, 10, code_sec)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// #537: wrap a selfhost-compiled core module into a component exporting\\n//   <export_name> : func(<param_names>: string, ...) -> string\\n// via the packed-string trampoline above. This is the selfhost replacement\\n// for the retired host's `--compose-p3` handler-side componentization: the\\n// result plugs into the P3 HTTP adapter's `import handler: func(method, url,\\n// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).\\n//\\n// The core module must export `target_func_name` with signature\\n// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and\\n// `__heap_ptr` (any normal non-library selfhost compile does). Host imports\\n// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are\\n// rejected: a serve handler must be a pure function of its request params.\\nexport fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\\n  let string_param_count = Array::length(param_names)\\n  // Validate the target export exists with the packed-string core signature.\\n  let export_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let export_func_indices = new_int_array()\\n  let export_type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\\n  let mut target_sig_ok = false\\n  let mut target_found = false\\n  let mut ei = 0\\n  while ei < Array::length(export_names) {\\n    if Array::get(export_names, ei) == target_func_name {\\n      target_found = true\\n      let sig = Array::get(export_type_sigs, ei)\\n      // sig = [param_count, params..., result_count, results...]. Core shape\\n      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.\\n      let core_param_count = string_param_count + 1\\n      if Array::length(sig) == (core_param_count + 3) {\\n        let mut ok = Array::get(sig, 0) == core_param_count\\n        let mut pi = 0\\n        while pi < core_param_count {\\n          if Array::get(sig, 1 + pi) != 126 {\\n            ok = false\\n          }\\n          pi = pi + 1\\n        }\\n        if Array::get(sig, 1 + core_param_count) != 1 {\\n          ok = false\\n        }\\n        if Array::get(sig, 2 + core_param_count) != 126 {\\n          ok = false\\n        }\\n        target_sig_ok = ok\\n      }\\n      ei = Array::length(export_names)\\n    } else {\\n      ei = ei + 1\\n    }\\n  }\\n  if !target_found {\\n    throw(\\\"component: core module does not export '\\\\{target_func_name}'\\\")\\n  }\\n  if !target_sig_ok {\\n    throw(\\\"component: '\\\\{target_func_name}' must take \\\\{string_param_count} String params and return String\\\")\\n  }\\n  // Reject host imports the stub cannot satisfy.\\n  let imp_modules = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_type_indices = new_int_array()\\n  let imp_type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\\n  let mut ii = 0\\n  while ii < import_count {\\n    let im = Array::get(imp_modules, ii)\\n    let ifn = Array::get(imp_names, ii)\\n    if im == \\\"wasi_snapshot_preview1\\\" && ifn == \\\"fd_write\\\" {\\n      ()\\n    } else {\\n      throw(\\\"component: handler uses host import '\\\\{im}.\\\\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)\\\")\\n    }\\n    ii = ii + 1\\n  }\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\\n  // core instance 0: fd_write stub (module 2)\\n  emit_core_instance_instantiate_section(buf, 2, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  // core instance 1: main (module 0), wasi_snapshot_preview1 satisfied by the\\n  // stub when the core imports it (an argument for an import the module does\\n  // not declare is legal and ignored).\\n  emit_core_instance_instantiate_args(buf, 0, [\\n    \\\"wasi_snapshot_preview1\\\"\\n  ], [\\n    0\\n  ])\\n  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr\\n  emit_alias_section(buf, 1, [\\n    target_func_name\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_alias_section(buf, 1, [\\n    \\\"memory\\\"\\n  ], [\\n    core_sort_mem\\n  ])\\n  emit_alias_section(buf, 1, [\\n    \\\"__heap_ptr\\\"\\n  ], [\\n    core_sort_global\\n  ])\\n  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases\\n  emit_core_instance_from_exports_sorted(buf, [\\n    \\\"target_func\\\",\\n    \\\"__heap_ptr\\\",\\n    \\\"memory\\\"\\n  ], [\\n    core_sort_func,\\n    core_sort_global,\\n    core_sort_mem\\n  ], [\\n    0,\\n    0,\\n    0\\n  ])\\n  // core instance 3: trampoline (module 1) with env\\n  emit_core_instance_instantiate_args(buf, 1, [\\n    \\\"env\\\"\\n  ], [\\n    2\\n  ])\\n  // core func 1 = canon_func, core func 2 = cabi_realloc\\n  emit_alias_section(buf, 3, [\\n    \\\"canon_func\\\",\\n    \\\"cabi_realloc\\\"\\n  ], [\\n    core_sort_func,\\n    core_sort_func\\n  ])\\n  // component type 0: (param_names: string...) -> string\\n  bytebuf_push(buf, section_type)\\n  let type_content = bytebuf_new()\\n  leb128_encode_u32(type_content, 1)\\n  let comp_param_types = new_int_array()\\n  let mut pt = 0\\n  while pt < string_param_count {\\n    Array::push(comp_param_types, comp_valtype_string)\\n    pt = pt + 1\\n  }\\n  emit_comp_func_type(type_content, comp_param_types, param_names, [\\n    comp_valtype_string\\n  ], 0)\\n  emit_raw_content(buf, type_content)\\n  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)\\n  bytebuf_push(buf, section_canon)\\n  let canon_content = bytebuf_new()\\n  leb128_encode_u32(canon_content, 1)\\n  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)\\n  emit_raw_content(buf, canon_content)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\")\n}\n\nlet cli_adapter_source_91 = () -> (String, String) {\n  (\"lib/@vibe/compiler/wit_gen.vibe\",\n\"//# Imports\\n\\nimport ./core {\\n  Expr, Stmt, TypeExpr\\n}\\n\\n//# WIT text generation (#537)\\n//\\n// Maps a vibe program's EFFECT SURFACE to a WIT world:\\n//\\n//   - Each *exported* top-level function with a full type annotation becomes a\\n//     world `export <kebab-name>: func(...)`.\\n//   - The union of the effects named in those exported signatures' `with { E }`\\n//     rows becomes the world's imports. An effect declared in the program via\\n//     `effect E { Op(Args) -> Ret; ... }` is emitted as an inline interface\\n//     import: `import <kebab-E>: interface { <kebab-op>: func(...) -> ...; }`.\\n//   - `Error` never surfaces (it is vibe-internal control flow: an escaping\\n//     throw is a component trap, not a capability).\\n//   - Effect names WITHOUT a matching `effect` declaration (host capabilities\\n//     such as Fs / Env / Async) get a comment marker: they are provided by the\\n//     vibe runtime's host imports and have no WIT mapping yet.\\n//\\n// Type mapping (vibe -> WIT): Int -> s64, Double -> f64, Bool -> bool,\\n// String -> string, Char -> char, Unit -> (no result), Bytes -> list<u8>,\\n// Array[T] -> list<T>, Option[T] -> option<T>, Result[T, E] -> result<T, E>,\\n// Map[K, V] -> list<tuple<K, V>>, tuples -> tuple<...>. Anything else\\n// (named user types, function types) is rejected with a clear error — the\\n// golden output never silently mis-declares a boundary type.\\n//\\n// The full contract lives in docs/effect-wit-mapping.md; the generated text is\\n// pinned by fixtures/wit_gen_http.golden.wit (gate step) and round-trips\\n// through vibe/wasm/wit_parser (wit_gen_test.vibe).\\n\\n// Lowercase a single ASCII char code, else identity.\\nfn wit_lower_char(c: Int) -> Int {\\n  if c >= 65 && c <= 90 {\\n    c + 32\\n  } else {\\n    c\\n  }\\n}\\n\\n// vibe identifier (CamelCase / snake_case) -> WIT kebab-case word list.\\n// `HttpReq` -> `http-req`, `now_us` -> `now-us`, `Fs` -> `fs`. Consecutive\\n// uppercase letters split per letter (`URL` -> `u-r-l`) — vibe convention is\\n// strict CamelCase, so this stays predictable.\\nexport fn wit_kebab_ident(name: String) -> String {\\n  let sb = StringBuilder::new()\\n  let len = String::length(name)\\n  let mut i = 0\\n  let mut prev_dash = true\\n  while i < len {\\n    let c = String::char_code_at(name, i)\\n    if c == 95 {\\n      if !prev_dash {\\n        StringBuilder::push(sb, \\\"-\\\")\\n      }\\n      prev_dash = true\\n    } else if c >= 65 && c <= 90 {\\n      if !prev_dash {\\n        StringBuilder::push(sb, \\\"-\\\")\\n      }\\n      StringBuilder::push(sb, String::from_char_code(wit_lower_char(c)))\\n      prev_dash = false\\n    } else {\\n      StringBuilder::push(sb, String::from_char_code(c))\\n      prev_dash = false\\n    }\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(sb)\\n}\\n\\nfn wit_is_unit_type(ty: TypeExpr) -> Bool {\\n  match ty {\\n    TyUnit => true,\\n    TyName(name) => name == \\\"Unit\\\",\\n    _ => false\\n  }\\n}\\n\\n// vibe TypeExpr -> WIT type text. Throws on types with no WIT mapping.\\nexport fn wit_type_text(ty: TypeExpr) -> String with { Error } {\\n  match ty {\\n    TyName(name) => {\\n      if name == \\\"Int\\\" {\\n        \\\"s64\\\"\\n      } else if name == \\\"Double\\\" {\\n        \\\"f64\\\"\\n      } else if name == \\\"Bool\\\" {\\n        \\\"bool\\\"\\n      } else if name == \\\"String\\\" {\\n        \\\"string\\\"\\n      } else if name == \\\"Char\\\" {\\n        \\\"char\\\"\\n      } else if name == \\\"Bytes\\\" {\\n        \\\"list<u8>\\\"\\n      } else {\\n        throw(\\\"wit: no WIT mapping for type '\\\\{name}' (supported: Int, Double, Bool, String, Char, Bytes, Unit, Array, Option, Result, Map, tuples)\\\")\\n      }\\n    },\\n    TyApp(head, args) => {\\n      if head == \\\"Array\\\" && Array::length(args) == 1 {\\n        \\\"list<\\\\{wit_type_text(Array::get(args, 0))}>\\\"\\n      } else if head == \\\"Option\\\" && Array::length(args) == 1 {\\n        \\\"option<\\\\{wit_type_text(Array::get(args, 0))}>\\\"\\n      } else if head == \\\"Result\\\" && Array::length(args) == 2 {\\n        \\\"result<\\\\{wit_type_text(Array::get(args, 0))}, \\\\{wit_type_text(Array::get(args, 1))}>\\\"\\n      } else if head == \\\"Map\\\" && Array::length(args) == 2 {\\n        \\\"list<tuple<\\\\{wit_type_text(Array::get(args, 0))}, \\\\{wit_type_text(Array::get(args, 1))}>>\\\"\\n      } else {\\n        throw(\\\"wit: no WIT mapping for type '\\\\{head}[..]'\\\")\\n      }\\n    },\\n    TyTuple(items) => {\\n      let sb = StringBuilder::new()\\n      StringBuilder::push(sb, \\\"tuple<\\\")\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if i > 0 {\\n          StringBuilder::push(sb, \\\", \\\")\\n        }\\n        StringBuilder::push(sb, wit_type_text(Array::get(items, i)))\\n        i = i + 1\\n      }\\n      StringBuilder::push(sb, \\\">\\\")\\n      StringBuilder::freeze(sb)\\n    },\\n    TyFn(_, _, _) => throw(\\\"wit: function types cannot cross the WIT boundary\\\"),\\n    TyUnit => throw(\\\"wit: Unit is only valid as a return type\\\")\\n  }\\n}\\n\\n// `func(name: ty, ...) -> ret` text for a signature. Unit return omits `->`.\\nfn wit_func_text(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr) -> String with { Error } {\\n  let sb = StringBuilder::new()\\n  StringBuilder::push(sb, \\\"func(\\\")\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    if i > 0 {\\n      StringBuilder::push(sb, \\\", \\\")\\n    }\\n    let pname = if i < Array::length(param_names) {\\n      wit_kebab_ident(Array::get(param_names, i))\\n    } else {\\n      \\\"arg\\\\{i}\\\"\\n    }\\n    StringBuilder::push(sb, pname)\\n    StringBuilder::push(sb, \\\": \\\")\\n    StringBuilder::push(sb, wit_type_text(Array::get(param_types, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::push(sb, \\\")\\\")\\n  if !wit_is_unit_type(ret) {\\n    StringBuilder::push(sb, \\\" -> \\\")\\n    StringBuilder::push(sb, wit_type_text(ret))\\n  }\\n  StringBuilder::freeze(sb)\\n}\\n\\n// Split a parsed effect row (\\\"A, B\\\") into names. The parser joins the\\n// `with { A, B }` list with \\\", \\\" (parser_base.vibe collect_effect_names).\\nfn wit_split_effect_row(row: String) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let len = String::length(row)\\n  let mut piece = \\\"\\\"\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(row, i)\\n    if c == 44 {\\n      if String::length(piece) > 0 {\\n        Array::push(out, piece)\\n      }\\n      piece = \\\"\\\"\\n    } else if c == 32 {\\n      ()\\n    } else {\\n      piece = String::concat(piece, String::from_char_code(c))\\n    }\\n    i = i + 1\\n  }\\n  if String::length(piece) > 0 {\\n    Array::push(out, piece)\\n  }\\n  out\\n}\\n\\nfn wit_array_contains(items: Array[String], needle: String) -> Bool {\\n  let mut found = false\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    if Array::get(items, i) == needle {\\n      found = true\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// One exported function surface as a tuple:\\n//   (name, param_names, param_types, ret, effects)\\n// A plain tuple, not a struct: struct values crossing function boundaries\\n// miscompile in the flat-bundle lane today (#537 follow-up filed), while\\n// tuples are battle-tested everywhere in the compiler.\\n\\n// Extract the boundary signature of `SLet(true, _, name, ann, body)`.\\n// Priority: TyFn annotation (param names from the EFn body when available),\\n// else fully-annotated EFn params/ret. Non-function exports and unannotated\\n// functions return None (they have no declarable WIT surface).\\nfn wit_export_of_slet(name: String, ann: Option[TypeExpr], body: Expr) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\\n  let efn_param_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let efn_param_types = Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n  let mut efn_params_ok = true\\n  let mut efn_ret = None\\n  let mut efn_eff = None\\n  match body {\\n    EFn(_, _, params, ret_opt, eff_opt, _) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, pty_opt) = Array::get(params, i)\\n        Array::push(efn_param_names, pname)\\n        match pty_opt {\\n          Some(pty) => Array::push(efn_param_types, pty),\\n          None => {\\n            efn_params_ok = false\\n          }\\n        }\\n        i = i + 1\\n      }\\n      efn_ret = ret_opt\\n      efn_eff = eff_opt\\n    },\\n    _ => {\\n      efn_params_ok = false\\n    }\\n  }\\n  let mut ann_fn = None\\n  match ann {\\n    Some(ty) => match ty {\\n      TyFn(ptys, rty, eff) => {\\n        ann_fn = Some((ptys, rty, eff))\\n      },\\n      _ => ()\\n    },\\n    None => ()\\n  }\\n  match ann_fn {\\n    Some(fn_parts) => {\\n      let (ptys, rty, eff) = fn_parts\\n      let effects = match eff {\\n        Some(row) => wit_split_effect_row(row),\\n        None => Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n      }\\n      Some((name, efn_param_names, ptys, rty, effects))\\n    },\\n    None => {\\n      if efn_params_ok {\\n        match efn_ret {\\n          Some(rty) => {\\n            let effects = match efn_eff {\\n              Some(row) => wit_split_effect_row(row),\\n              None => Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n            }\\n            Some((name, efn_param_names, Array::slice(efn_param_types, 0, Array::length(efn_param_types)), rty, effects))\\n          },\\n          None => None\\n        }\\n      } else {\\n        None\\n      }\\n    }\\n  }\\n}\\n\\n//# vibe serve handler contract (#537)\\n\\n// The wasi-http P3 full-adapter handler contract\\n// (scripts/build_wasi_http_p3_full_adapter.sh):\\n//   export let handler = (method: String, url: String, headers: String, body: String) -> String\\n// returning \\\"STATUS\\\\n<Header: value lines>\\\\n\\\\n<body>\\\".\\nexport fn serve_handler_param_names() -> Array[String] {\\n  [\\n    \\\"method\\\",\\n    \\\"url\\\",\\n    \\\"headers\\\",\\n    \\\"body\\\"\\n  ]\\n}\\n\\nfn wit_type_is_string(ty: TypeExpr) -> Bool {\\n  match ty {\\n    TyName(name) => name == \\\"String\\\",\\n    _ => false\\n  }\\n}\\n\\n// Validate the entry file's `handler` export against the serve contract,\\n// with a teaching error when it does not fit.\\nexport fn validate_serve_handler(entry_stmts: Array[Stmt]) -> Unit with { Error } {\\n  let contract = \\\"serve: expected `export let handler = (method: String, url: String, headers: String, body: String) -> String`\\\"\\n  match wit_boundary_signature(entry_stmts, \\\"handler\\\") {\\n    None => throw(String::concat(contract, \\\" (no exported `handler` with a full type annotation found)\\\")),\\n    Some(sig) => {\\n      let (_sname, _spnames, sig_param_types, sig_ret, sig_effects) = sig\\n      if Array::length(sig_param_types) != 4 {\\n        throw(String::concat(contract, \\\" (found \\\\{Array::length(sig_param_types)} params)\\\"))\\n      }\\n      let mut pi = 0\\n      while pi < Array::length(sig_param_types) {\\n        if !wit_type_is_string(Array::get(sig_param_types, pi)) {\\n          throw(String::concat(contract, \\\" (param \\\\{pi} is not String)\\\"))\\n        }\\n        pi = pi + 1\\n      }\\n      if !wit_type_is_string(sig_ret) {\\n        throw(String::concat(contract, \\\" (return type is not String)\\\"))\\n      }\\n      let mut ei = 0\\n      while ei < Array::length(sig_effects) {\\n        let ename = Array::get(sig_effects, ei)\\n        if ename != \\\"Error\\\" {\\n          throw(\\\"serve: handler requires capability effect '\\\\{ename}'; a serve handler must be a pure function of its request params (discharge the effect with `handle` inside the file)\\\")\\n        }\\n        ei = ei + 1\\n      }\\n    }\\n  }\\n}\\n\\n// Boundary signature of one exported top-level function, by name. Used by\\n// `vibe serve` to validate the handler contract before componentizing.\\nexport fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\\n  let mut found = None\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exported, _, sname, ann, body) => {\\n        if exported && sname == name {\\n          found = wit_export_of_slet(sname, ann, body)\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Collect `effect` declarations (recursing into module blocks) as parallel\\n// name/ops arrays.\\nfn wit_collect_effect_defs(stmts: Array[Stmt], out_names: Array[String], out_ops: Array[Array[(String, Array[TypeExpr], TypeExpr)]]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEffectDef(_, name, _, ops) => {\\n        if !wit_array_contains(out_names, name) {\\n          Array::push(out_names, name)\\n          Array::push(out_ops, ops)\\n        }\\n      },\\n      SModule(_, _, inner) => wit_collect_effect_defs(inner, out_names, out_ops),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Generate the WIT world text for a program.\\n//   export_stmts: statements scanned for *exported* function surfaces\\n//                 (normally the entry file's own statements).\\n//   effect_stmts: statements scanned for `effect` declarations (may be the\\n//                 same array, or entry + resolved import type decls).\\n//   world_name:   raw name; kebab-cased into the world header.\\nexport fn wit_from_program(export_stmts: Array[Stmt], effect_stmts: Array[Stmt], world_name: String) -> String with { Error } {\\n  let eff_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let eff_ops = Array::slice([\\n    Array::slice([\\n      (\\\"\\\", Array::slice([\\n        TyUnit\\n      ], 0, 0), TyUnit)\\n    ], 0, 0)\\n  ], 0, 0)\\n  wit_collect_effect_defs(effect_stmts, eff_names, eff_ops)\\n  wit_collect_effect_defs(export_stmts, eff_names, eff_ops)\\n  let exports = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), Array::slice([\\n      TyUnit\\n    ], 0, 0), TyUnit, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(export_stmts) {\\n    match Array::get(export_stmts, i) {\\n      SLet(exported, _, name, ann, body) => {\\n        if exported {\\n          match wit_export_of_slet(name, ann, body) {\\n            Some(ex) => Array::push(exports, ex),\\n            None => ()\\n          }\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  // Imports: effects referenced by exported signatures, in first-use order.\\n  let used_effects = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut xi = 0\\n  while xi < Array::length(exports) {\\n    let (_xn, _xp, _xt, _xr, ex_effects) = Array::get(exports, xi)\\n    let mut ei = 0\\n    while ei < Array::length(ex_effects) {\\n      let ename = Array::get(ex_effects, ei)\\n      if ename != \\\"Error\\\" && !wit_array_contains(used_effects, ename) {\\n        Array::push(used_effects, ename)\\n      }\\n      ei = ei + 1\\n    }\\n    xi = xi + 1\\n  }\\n  let sb = StringBuilder::new()\\n  StringBuilder::push(sb, \\\"package vibe:app;\\\\n\\\\nworld \\\")\\n  StringBuilder::push(sb, wit_kebab_ident(world_name))\\n  StringBuilder::push(sb, \\\" {\\\\n\\\")\\n  let mut ui = 0\\n  while ui < Array::length(used_effects) {\\n    let ename = Array::get(used_effects, ui)\\n    let mut def_idx = 0 - 1\\n    let mut di = 0\\n    while di < Array::length(eff_names) {\\n      if Array::get(eff_names, di) == ename {\\n        def_idx = di\\n      }\\n      di = di + 1\\n    }\\n    if def_idx >= 0 {\\n      StringBuilder::push(sb, \\\"  import \\\")\\n      StringBuilder::push(sb, wit_kebab_ident(ename))\\n      StringBuilder::push(sb, \\\": interface {\\\\n\\\")\\n      let ops = Array::get(eff_ops, def_idx)\\n      let mut oi = 0\\n      while oi < Array::length(ops) {\\n        let (op_name, op_args, op_ret) = Array::get(ops, oi)\\n        StringBuilder::push(sb, \\\"    \\\")\\n        StringBuilder::push(sb, wit_kebab_ident(op_name))\\n        StringBuilder::push(sb, \\\": \\\")\\n        StringBuilder::push(sb, wit_func_text(Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), op_args, op_ret))\\n        StringBuilder::push(sb, \\\";\\\\n\\\")\\n        oi = oi + 1\\n      }\\n      StringBuilder::push(sb, \\\"  }\\\\n\\\")\\n    } else {\\n      // Host capability effect (Fs / Env / Async / ...): provided by the vibe\\n      // runtime's host imports; no declared operations to surface.\\n      StringBuilder::push(sb, \\\"  // host capability effect '\\\")\\n      StringBuilder::push(sb, ename)\\n      StringBuilder::push(sb, \\\"' (provided by the vibe runtime; no WIT mapping yet)\\\\n\\\")\\n    }\\n    ui = ui + 1\\n  }\\n  let mut xo = 0\\n  while xo < Array::length(exports) {\\n    let (ex_name, ex_param_names, ex_param_types, ex_ret, _ex_effects) = Array::get(exports, xo)\\n    StringBuilder::push(sb, \\\"  export \\\")\\n    StringBuilder::push(sb, wit_kebab_ident(ex_name))\\n    StringBuilder::push(sb, \\\": \\\")\\n    StringBuilder::push(sb, wit_func_text(ex_param_names, ex_param_types, ex_ret))\\n    StringBuilder::push(sb, \\\";\\\\n\\\")\\n    xo = xo + 1\\n  }\\n  StringBuilder::push(sb, \\\"}\\\\n\\\")\\n  StringBuilder::freeze(sb)\\n}\\n\")\n}\n\nlet cli_adapter_source_92 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_eq.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\n// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.\\nfn emit_mem_size_bytes(b: Bytes) -> Unit {\\n  bytebuf_push(b, 63)\\n  bytebuf_push(b, 0)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 65536)\\n  emit_i64_mul(b)\\n}\\n\\n// Push an i32 bool: could `v` (the i64 in local `slot`) be safely byte-compared\\n// as a string fat-pointer `(ptr << 32) | len` WITHOUT reading out of bounds —\\n// i.e. `ptr + len <= memory_size`, where ptr is the UNSIGNED high word (a value\\n// whose high bit is set yields a huge ptr that exceeds memory_size, so it is\\n// rejected rather than wrapping to a low in-bounds address). This is the OOB\\n// guard from #664; it deliberately does NOT require `ptr >= 64`, because a\\n// genuine empty string can have a low pointer (e.g. a 0-length name read from a\\n// custom section) and must still compare equal — requiring `ptr >= 64` regressed\\n// such comparisons to \\\"not equal\\\". The residual it gives up on (two distinct\\n// integers with equal low words comparing equal) is the accepted #678 hole.\\nfn emit_looks_like_string(b: Bytes, slot: Int) -> Unit {\\n  emit_local_get(b, slot)\\n  emit_i64_const(b, 32)\\n  bytebuf_push(b, 136)\\n  emit_local_get(b, slot)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i64_add(b)\\n  emit_mem_size_bytes(b)\\n  emit_i64_le_s(b)\\n}\\n\\nexport fn gen_eq_body(str_eq_idx: Int) -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_i64_eq(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 1)\\n  emit_else(b)\\n  // The operands are bit-different. Falling back to `str_eq` here is only valid\\n  // when both are genuine string fat-pointers; a raw integer (e.g. a 61-bit\\n  // value) whose bits resemble `(ptr << 32) | len` would otherwise be misread —\\n  // a low word of 0 makes two unequal ints compare EQUAL, and a large low word\\n  // makes `str_eq`'s byte loop read out of bounds (the #664 class of bug, here\\n  // surfacing for `==`/`!=` on Int >= 2^32). Gate the fallback on both operands\\n  // looking like real strings; otherwise the values are simply not equal.\\n  emit_looks_like_string(b, 0)\\n  emit_looks_like_string(b, 1)\\n  bytebuf_push(b, 113)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_call(b, str_eq_idx)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_93 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_str_eq.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_v128_load, emit_i8x16_eq, emit_i8x16_all_true, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\n// ADR-0054 (#748): byte-content equality with a 16-byte SIMD fast path.\\n// After the length check, whole chunks are compared with `v128.load` x2 +\\n// `i8x16.eq` + `i8x16.all_true` (v128 stays on the operand stack — no v128\\n// locals); any unequal chunk answers 0 immediately (equality needs no\\n// differing-byte position). A scalar byte loop finishes the < 16-byte tail.\\n// Params 0=a 1=b (packed (ptr<<32)|len i64). Locals (all i32, meta_i32=6):\\n// 2=len_a 3=len_b 4=ptr_a 5=ptr_b 6=i 7=chunk_limit (len-15, or 0 when\\n// len < 16 so the unsigned loop guard skips the chunk phase entirely).\\nexport fn gen_str_eq_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 3)\\n  emit_i32_ne(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 0)\\n  emit_else(b)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 4)\\n  emit_local_get(b, 1)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 5)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 6)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 7)\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 16)\\n  emit_i32_ge_u(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 15)\\n  emit_i32_sub(b)\\n  emit_local_set(b, 7)\\n  emit_end(b)\\n  emit_block_i64(b)\\n  // Scalar first-byte precheck: a mismatch at byte 0 answers without the\\n  // 16-byte chunk work. index_of probes str_eq once per haystack position\\n  // and ~all probes mismatch immediately — the chunk-first version made\\n  // index_of 2x SLOWER than the old byte loop; this restores that fast path\\n  // for one extra byte-compare on the (rarer) equal/long-prefix cases.\\n  emit_block_void(b)\\n  emit_local_get(b, 2)\\n  emit_i32_eqz(b)\\n  emit_br_if(b, 0)\\n  emit_local_get(b, 4)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i32_ne(b)\\n  emit_i32_eqz(b)\\n  emit_br_if(b, 0)\\n  emit_i64_const(b, 0)\\n  emit_br(b, 1)\\n  emit_end(b)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 6)\\n  emit_local_get(b, 7)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_v128_load(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_v128_load(b, 0, 0)\\n  emit_i8x16_eq(b)\\n  emit_i8x16_all_true(b)\\n  emit_i32_eqz(b)\\n  emit_if_void(b)\\n  emit_i64_const(b, 0)\\n  emit_br(b, 3)\\n  emit_end(b)\\n  emit_local_get(b, 6)\\n  emit_i32_const(b, 16)\\n  emit_i32_add(b)\\n  emit_local_set(b, 6)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 6)\\n  emit_local_get(b, 2)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i32_ne(b)\\n  emit_if_void(b)\\n  emit_i64_const(b, 0)\\n  emit_br(b, 3)\\n  emit_end(b)\\n  emit_local_get(b, 6)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 6)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_i64_const(b, 1)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\\n// #746/#748: lexicographic byte comparison for String `<` `>` `<=` `>=`.\\n// Returns a sign-carrying diff (NOT normalized to -1/0/1): the first\\n// differing byte's `a[i] - b[i]`, or `len_a - len_b` when one string is a\\n// prefix of the other, 0 when equal. Callers only ever compare the result\\n// against 0 (desugar rewrites `a < b` to `str_lex_diff(a, b) < 0`), so the\\n// magnitude is irrelevant and the extra signum normalization is skipped.\\n// Tagged (<<1) under RC like every value-world int return; shifting\\n// preserves sign so `< 0` stays correct either way.\\n// A 16-byte SIMD chunk loop skips the common prefix: equal chunks advance\\n// by 16; the first UNEQUAL chunk breaks WITHOUT advancing so the scalar\\n// loop locates the differing byte within <= 16 steps. Params 0=a 1=b\\n// (packed (ptr<<32)|len i64). Locals (all i32, meta_i32=7): 2=len_a\\n// 3=len_b 4=ptr_a 5=ptr_b 6=i 7=min_len 8=chunk_limit (min_len-15, or 0\\n// when min_len < 16 so the unsigned guard skips the chunk phase).\\nexport fn gen_str_lex_diff_body(enable_rc: Bool) -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 4)\\n  emit_local_get(b, 1)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 5)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 3)\\n  emit_i32_ge_u(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 3)\\n  emit_local_set(b, 7)\\n  emit_else(b)\\n  emit_local_get(b, 2)\\n  emit_local_set(b, 7)\\n  emit_end(b)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 8)\\n  emit_local_get(b, 7)\\n  emit_i32_const(b, 16)\\n  emit_i32_ge_u(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 7)\\n  emit_i32_const(b, 15)\\n  emit_i32_sub(b)\\n  emit_local_set(b, 8)\\n  emit_end(b)\\n  emit_block_i64(b)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 6)\\n  emit_local_get(b, 8)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_v128_load(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_v128_load(b, 0, 0)\\n  emit_i8x16_eq(b)\\n  emit_i8x16_all_true(b)\\n  emit_i32_eqz(b)\\n  emit_if_void(b)\\n  emit_br(b, 2)\\n  emit_end(b)\\n  emit_local_get(b, 6)\\n  emit_i32_const(b, 16)\\n  emit_i32_add(b)\\n  emit_local_set(b, 6)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 6)\\n  emit_local_get(b, 7)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i32_ne(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 6)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i32_sub(b)\\n  emit_i64_extend_i32_s(b)\\n  emit_br(b, 3)\\n  emit_end(b)\\n  emit_local_get(b, 6)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 6)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 3)\\n  emit_i32_sub(b)\\n  emit_i64_extend_i32_s(b)\\n  emit_end(b)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  } else {\\n    ()\\n  }\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_94 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1.vibe\",\n\"//# Imports\\n\\nexport ./bodies_core_a1a1_eq.vibe {\\n  gen_eq_body\\n}\\n\\nexport ./bodies_core_a1a1_str_eq.vibe {\\n  gen_str_eq_body, gen_str_lex_diff_body\\n}\\n\\n//# Misc\\n\\nexport {\\n  gen_eq_body, gen_str_eq_body, gen_str_lex_diff_body\\n}\\n\")\n}\n\nlet cli_adapter_source_95 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a2.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  rc_shadow_base, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is