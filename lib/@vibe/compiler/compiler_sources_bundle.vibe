name)\n  } else {\n    String::concat(dir, String::concat(\"/\", name))\n  }\n}\n\nexport fn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs } {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let scan_dir = if dir == \"\" { \".\" } else { dir }\n  let names = Fs::readdir(scan_dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if name != \"index.vibei\" && name != \"index.vibe\" && name != \"index.vpkg\" && String::ends_with(name, \".vibe\") && !String::ends_with(name, \"_test.vibe\") && !String::ends_with(name, \"_bench.vibe\") && !String::ends_with(name, \".draft.vibe\") && !String::starts_with(name, \"_\") {\n      let full = directory_entry_path(dir, name)\n      ensure_regular_source_fs(full)\n      Array::push(out, String::concat(\"./\", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(explicit) {\n    Array::push(out, Array::get(explicit, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(discovered) {\n    let d = Array::get(discovered, j)\n    let mut k = 0\n    let mut found = false\n    while k < Array::length(out) && !found {\n      if Array::get(out, k) == d {\n        found = true\n      } else {\n        k = k + 1\n      }\n    }\n    if !found {\n      Array::push(out, d)\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  out\n}\n\nexport fn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  let mut warm_deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut warm_exports = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut warm_ok = false\n  if Fs::