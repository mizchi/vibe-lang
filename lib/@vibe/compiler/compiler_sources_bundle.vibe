nt_array()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let builtin_names_list = lc_fresh_string_array()\n  let builtin_param_counts = lc_fresh_int_array()\n  let builtin_needs_env_list = lc_fresh_bool_array()\n  let builtin_indices_list = lc_fresh_int_array()\n  let builtin_returns_list = lc_fresh_int_array()\n  let registry_rows = builtin_registry()\n  let mut reg_i = 0\n  while reg_i < Array::length(registry_rows) {\n    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)\n    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, \"vibe_rc_\"))\n    if reg_include {\n      let reg_idx = match reg_name {\n        \"Env::get\" => env_get_idx,\n        \"Env::args_len\" => env_args_len_idx,\n        \"Env::args_get\" => env_args_get_idx,\n        \"Fs::read_file\" => fs_read_file_idx,\n        \"Fs::exists\" => fs_exists_idx,\n        \"Fs::stat_token\" => fs_stat_token_idx,\n        \"vibe_fs_stat_token_raw\" => fs_stat_token_idx,\n        \"Fs::write_file\" => fs_write_file_idx,\n        \"Fs::write_bytes\" => fs_write_bytes_idx,\n        \"Fs::read_bytes\" => fs_read_bytes_idx,\n        \"vibe_fs_read_dir_raw\" => fs_read_dir_idx,\n        \"Fs::remove\" => fs_remove_idx,\n        \"Fs::mkdir_p\" => fs_mkdir_p_idx,\n        \"Fs::mkdir\" => fs_mkdir_idx,\n        \"Fs::chdir\" => fs_chdir_idx,\n        \"Fs::copy\" => fs_copy_idx,\n        \"Fs::append\" => fs_append_idx,\n        \"Fs::rename\" => fs_rename_idx,\n        \"Fs::is_dir\" => fs_is_dir_idx,\n        \"Fs::is_file\" => fs_is_file_idx,\n        \"Fs::getcwd\" => fs_getcwd_idx,\n        \"vibe_http_request_raw\" => http_request_idx,\n        \"vibe_http_response_status_raw\" => http_response_status_idx,\n        \"vibe_http_response_header_raw\" => http_response_header_idx,\n        \"vibe_http_response_body_raw\" => http_resp