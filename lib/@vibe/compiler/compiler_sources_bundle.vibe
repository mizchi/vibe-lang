mbda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error }\nfn collect_lambda_captures_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int)\nfn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with { Error }\nfn record_lambda_meta_gc(ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int) -> Int\n")
}

