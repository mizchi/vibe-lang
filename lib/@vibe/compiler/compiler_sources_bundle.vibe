let source_6 = () -> (String, String) {
  ("lib/@vibe/parser/lexer.vibe",
"\n\n\n\nfn is_ws(c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nfn is_alpha(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nfn is_digit(c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nfn is_alnum(c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nfn utf8_seq_len(c: Int) -> Int {\n  if c >= 0xF0 && c <= 0xF7 {\n    4\n  } else if c >= 0xE0 && c <= 0xEF {\n    3\n  } else if c >= 0xC2 && c <= 0xDF {\n    2\n  } else {\n    1\n  }\n}\n\nfn skip_bom(source: String, len: Int) -> Int {\n  if len >= 3 && String::char_code_at(source, 0) == 0xEF && String::char_code_at(source, 1) == 0xBB && String::char_code_at(source, 2) == 0xBF {\n    3\n  } else {\n    0\n  }\n}\n\nfn utf8_char_text(source: String, len: Int, pos: Int) -> String {\n  let c = String::char_code_at(source, pos)\n  let seq_len = utf8_seq_len(c)\n  let clamp_end = if pos + seq_len <= len { pos + seq_len } else { len }\n  String::substring(source, pos, clamp_end)\n}\n\nfn lex_char(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nfn slice_eq(source: String, start: Int, end: Int, text: String) -> Bool {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn is_hex_digit(c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nfn keyword_lookup(source: String, start: Int, end: Int) -> Option[Token] {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else if slice_eq(source, start, end, \"is\") {\n        Some(TIs)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nfn scan_ident_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nfn lex_ident(s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nfn scan_digits_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nfn scan_interp_end(s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nfn located_prefix(s: String, pos: Int) -> String {\n  let mut eline = 1\n  let mut ecol = 1\n  let mut ei = 0\n  while ei < pos {\n    if String::char_code_at(s, ei) == '\\n' {\n      eline = eline + 1\n      ecol = 1\n    } else {\n      ecol = ecol + 1\n    }\n    ei = ei + 1\n  }\n  String::concat(\"line \", String::concat(__to_string(eline), String::concat(\":\", String::concat(__to_string(ecol), \": \"))))\n}\n\nfn check_no_scientific_suffix(s: String, len: Int, pos: Int) -> Unit with { Error } {\n  if pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == 'e' || c == 'E' {\n      let has_sign = pos + 1 < len && (String::char_code_at(s, pos + 1) == '+' || String::char_code_at(s, pos + 1) == '-')\n      let digits_start = if has_sign {\n        pos + 2\n      } else {\n        pos + 1\n      }\n      let has_digits = digits_start < len && is_digit(String::char_code_at(s, digits_start))\n      if has_digits {\n        throw(String::concat(located_prefix(s, pos), \"scientific notation is not supported; write the digits out or compute the value\"))\n      } else if has_sign {\n        throw(String::concat(located_prefix(s, pos), \"incomplete exponent: expected digit(s) after the sign in scientific notation\"))\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn empty_string_array() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn skip_until_newline(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nfn skip_ws_with_newline(s: String, len: Int, i: Int) -> (Int, Bool) {\n  let mut out = i\n  let mut saw_newline = false\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      if c == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      let next = skip_until_newline(s, len, out + 2)\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = next\n    } else {\n      skipping = false\n    }\n  }\n  (out, saw_newline)\n}\n\nfn concat_string_parts(parts: Array[String], tail: String) -> String {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(parts) {\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::push(out, tail)\n  StringBuilder::freeze(out)\n}\n\nfn lex_string_go(s: String, len: Int, idx: Int, start: Int, parts_acc: Array[String], has_interp: Bool, parts: ArrayBuilder[String], offsets: ArrayBuilder[Int]) -> (Token, Int) with { Error } {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        ArrayBuilder::push(offsets, -1)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts), ArrayBuilder::freeze(offsets))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '(' {\n        let mut eline = 1\n        let mut ecol = 1\n        let mut ei = 0\n        while ei < current_idx {\n          if String::char_code_at(s, ei) == '\\n' {\n            eline = eline + 1\n            ecol = 1\n          } else {\n            ecol = ecol + 1\n          }\n          ei = ei + 1\n        }\n        let eloc = String::concat(\"line \", String::concat(__to_string(eline), String::concat(\":\", String::concat(__to_string(ecol), \": \"))))\n        throw(String::concat(eloc, \"string interpolation \\\\(expr) was removed in 0.3.0; use \\\\{expr}\"))\n      } else if esc == '{' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        ArrayBuilder::push(offsets, -1)\n        let interp_end = scan_interp_end(s, len, next + 1, 1)\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        ArrayBuilder::push(offsets, next + 1)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nfn lex_string(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new(), ArrayBuilder::new())\n}\n\nfn scan_hex_digits_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\n\nfn parse_hex_from_string(s: String) -> Int with { Error } {\n  let len = String::length(s)\n  let max_div_16 = 144115188075855871\n  let max_mod_16 = 15\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    if acc > max_div_16 || (acc == max_div_16 && digit > max_mod_16) {\n      throw(\"IntLiteralOverflow: hex integer literal exceeds Int::max_value (2305843009213693951)\")\n    } else {\n      ()\n    }\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nfn parse_int_from_string(s: String) -> Int with { Error } {\n  let len = String::length(s)\n  let max_div_10 = 230584300921369395\n  let max_mod_10 = 1\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = c - 48\n    if acc > max_div_10 || (acc == max_div_10 && digit > max_mod_10) {\n      throw(\"IntLiteralOverflow: integer literal exceeds Int::max_value (2305843009213693951)\")\n    } else {\n      ()\n    }\n    acc = acc * 10 + digit\n    i = i + 1\n  }\n  acc\n}\n\nfn lex_decimal(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let frac_end = scan_digits_end(s, len, int_end + 1)\n      let value = parse_decimal_float(s[i: int_end], s[int_end + 1: frac_end])\n      check_no_scientific_suffix(s, len, frac_end)\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(value), frac_end + 1)\n      } else {\n        (TFloat(value), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\n    let value = parse_decimal_float(s[i: int_end], \"\")\n    (TFloat(value), int_end + 1)\n  } else {\n    check_no_scientific_suffix(s, len, int_end)\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nfn lex_number(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nfn is_expr_ending_tok(t: Token) -> Bool {\n  match t {\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    TIdent(_) => true,\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    _ => false\n  }\n}\n\nfn lex_one_token(source: String, len: Int, pos: Int) -> (Token, Int) with { Error } {\n  let c = String::char_code_at(source, pos)\n  if is_alpha(c) {\n    lex_ident(source, len, pos)\n  } else if is_digit(c) {\n    lex_number(source, len, pos)\n  } else if c == '\"' {\n    lex_string(source, len, pos)\n  } else if c == '+' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPlusEq, pos + 2)\n    } else (TPlus, pos + 1)\n  } else if c == '-' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TThinArrow, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TMinusEq, pos + 2)\n    } else (TMinus, pos + 1)\n  } else if c == '*' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TStarEq, pos + 2)\n    } else (TStar, pos + 1)\n  } else if c == '/' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TSlashEq, pos + 2)\n    } else (TSlash, pos + 1)\n  } else if c == '%' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPercentEq, pos + 2)\n    } else (TPercent, pos + 1)\n  } else if c == '=' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TEqEq, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TArrow, pos + 2)\n    } else (TEq, pos + 1)\n  } else if c == '!' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TNeq, pos + 2)\n    } else (TNot, pos + 1)\n  } else if c == '<' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TLte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n      (TLShift, pos + 2)\n    } else (TLt, pos + 1)\n  } else if c == '>' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TGte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TRShift, pos + 2)\n    } else (TGt, pos + 1)\n  } else if c == '&' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n      (TAnd, pos + 2)\n    } else (TBitAnd, pos + 1)\n  } else if c == '|' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n      (TOr, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TPipeGt, pos + 2)\n    } else (TBitOr, pos + 1)\n  } else if c == '^' {\n    (TBitXor, pos + 1)\n  } else if c == '(' {\n    (TLParen, pos + 1)\n  } else if c == ')' {\n    (TRParen, pos + 1)\n  } else if c == '{' {\n    (TLBrace, pos + 1)\n  } else if c == '}' {\n    (TRBrace, pos + 1)\n  } else if c == '[' {\n    (TLBracket, pos + 1)\n  } else if c == ']' {\n    (TRBracket, pos + 1)\n  } else if c == ',' {\n    (TComma, pos + 1)\n  } else if c == ';' {\n    (TSemicolon, pos + 1)\n  } else if c == '.' {\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n      (TDotDotDot, pos + 3)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n      (TDotDot, pos + 2)\n    } else (TDot, pos + 1)\n  } else if c == ':' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n      (TDoubleColon, pos + 2)\n    } else (TColon, pos + 1)\n  } else if c == '#' {\n    (THash, pos + 1)\n  } else if c == '~' {\n    (TTilde, pos + 1)\n  } else if c == '?' {\n    (TQuestion, pos + 1)\n  } else if c == '@' {\n    let mut end = pos + 1\n    while end < len {\n      let ec = String::char_code_at(source, end)\n      if is_alnum(ec) || ec == '_' || ec == '-' {\n        end = end + 1\n      } else if ec == '/' && end + 1 < len && is_alnum(String::char_code_at(source, end + 1)) {\n        end = end + 1\n      } else {\n        break\n      }\n    }\n    if end > pos + 1 {\n      (TIdent(String::substring(source, pos, end)), end)\n    } else {\n      throw(\"unexpected '@' without identifier\")\n    }\n  } else if c == '\\'' {\n    lex_char(source, len, pos)\n  } else {\n    let ch_text = if c >= 128 {\n      utf8_char_text(source, len, pos)\n    } else {\n      String::from_char_code(c)\n    }\n    throw(String::concat(\"unexpected character: \", ch_text))\n  }\n}\n\nexport fn lex_with_offsets(source: String) -> (Array[Token], Array[Int], Array[Int]) with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let starts = ArrayBuilder::new()\n    let ends = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, pos)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      ArrayBuilder::push(starts, pos)\n      ArrayBuilder::push(ends, next)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::push(starts, len)\n    ArrayBuilder::push(ends, len)\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\n  }\n}\n\nexport fn lex_with_offsets_recovering(source: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String]) {\n  let len = String::length(source)\n  let b = ArrayBuilder::new()\n  let starts = ArrayBuilder::new()\n  let ends = ArrayBuilder::new()\n  let err_offsets = ArrayBuilder::new()\n  let err_msgs = ArrayBuilder::new()\n  let mut prev_tok = TEof\n  let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n  let mut pos = first_skip.0\n  let mut nl_before = first_skip.1\n  while pos < len {\n    let c = String::char_code_at(source, pos)\n    let res = handle {\n      let (tok, next) = lex_one_token(source, len, pos)\n      Some((tok, next))\n    } with Error {\n      Throw(msg) => {\n        ArrayBuilder::push(err_offsets, pos)\n        ArrayBuilder::push(err_msgs, msg)\n        None\n      }\n    }\n    match res {\n      Some((tok, next)) => {\n        if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n          ArrayBuilder::push(b, TSemicolon)\n          ArrayBuilder::push(starts, pos)\n          ArrayBuilder::push(ends, pos)\n        } else {\n          ()\n        }\n        ArrayBuilder::push(b, tok)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, next)\n        prev_tok = tok\n        let skipped = skip_ws_with_newline(source, len, next)\n        pos = skipped.0\n        nl_before = skipped.1\n      },\n      None => {\n        let resume = if c == '\"' || c == '\\'' {\n          let mut j = pos + 1\n          let mut stop = false\n          while !stop {\n            if j >= len {\n              stop = true\n            } else {\n              let cc = String::char_code_at(source, j)\n              if cc == c {\n                j = j + 1\n                stop = true\n              } else if cc == 10 {\n                stop = true\n              } else if cc == 92 && j + 1 < len {\n                j = j + 2\n              } else {\n                j = j + 1\n              }\n            }\n          }\n          j\n        } else if c >= 128 {\n          let seq_len = utf8_seq_len(c)\n          if pos + seq_len <= len {\n            pos + seq_len\n          } else {\n            len\n          }\n        } else {\n          pos + 1\n        }\n        let skipped = skip_ws_with_newline(source, len, resume)\n        pos = skipped.0\n        nl_before = skipped.1\n      }\n    }\n  }\n  ArrayBuilder::push(b, TEof)\n  ArrayBuilder::push(starts, len)\n  ArrayBuilder::push(ends, len)\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends), ArrayBuilder::freeze(err_offsets), ArrayBuilder::freeze(err_msgs))\n}\n\nexport fn offset_to_line_col(source: String, offset: Int) -> (Int, Int) {\n  let len = String::length(source)\n  let bound = if offset < len { offset } else { len }\n  let mut i = 0\n  let mut line = 1\n  let mut col = 1\n  while i < bound {\n    if String::char_code_at(source, i) == 10 {\n      line = line + 1\n      col = 1\n    } else {\n      col = col + 1\n    }\n    i = i + 1\n  }\n  (line, col)\n}\n\nexport fn lex(source: String) -> Array[Token] with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport fn lex_ok(source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n")
}

let source_7 = () -> (String, String) {
  ("lib/@vibe/parser/parser_base.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\n\nexport fn peek(tokens: Array[Token], pos: Int) -> Token {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nfn _no_tp() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn _no_tb() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nexport fn tk_name(tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_, _) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TIs => \"is\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_, _) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nfn is_tk(tok: Token, name: String) -> Bool {\n  tk_name(tok) == name\n}\n\nfn expect_tk(tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"expected \\{expected} but got \\{actual} at #\\{pos}\")\n  }\n}\n\nexport fn skip_semi(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nfn empty_arms() -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nfn empty_pats() -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nfn empty_ctors() -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nfn empty_exprs() -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nexport fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let names = Array::slice([\n    \"\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TDerive => match peek(tokens, pos + 1) {\n      TLParen => {\n        let mut dp = pos + 2\n        let mut dd = true\n        while dd {\n          match peek(tokens, dp) {\n            TRParen => {\n              dd = false\n              dp = dp + 1\n            },\n            TComma => {\n              dp = dp + 1\n            },\n            TIdent(name) => {\n              Array::push(names, name)\n              dp = dp + 1\n            },\n            _ => throw(\"expected derive identifier\")\n          }\n        }\n        (names, dp)\n      },\n      _ => (names, pos)\n    },\n    _ => (names, pos)\n  }\n}\n\nexport fn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error } {\n  let (_, next) = parse_derive_names(tokens, pos)\n  next\n}\n\nfn empty_fields() -> Array[(String, TypeExpr)] {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nfn empty_params() -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nfn parse_pattern(tokens: Array[Token], pos: Int) -> (Pat, Int) with { Error } {\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TMinus => match peek(tokens, pos + 1) {\n      TInt(n) => (PInt(0 - n), pos + 2),\n      TFloat(n) => (PFloat(0.0 - n), pos + 2),\n      _ => throw(\"expected number literal after '-' in pattern\")\n    },\n    TFloat(n) => (PFloat(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              TIdent(vname) => {\n                let vc = String::char_code_at(vname, 0)\n                if vc >= 65 && vc <= 90 {\n                  match peek(tokens, pos + 3) {\n                    TLParen => {\n                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);\n                      (PCtor(vname, args), end)\n                    },\n                    _ => (PCtor(vname, empty_pats()), pos + 3)\n                  }\n                } else {\n                  (PCtor(name, empty_pats()), pos + 1)\n                }\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected in pattern: \\{actual}\")\n    }\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nfn empty_type_exprs() -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nexport fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBrace => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nfn parse_method_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_method_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in method type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_trait_methods(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let sigs_b = ArrayBuilder::new()\n      let gens_b = ArrayBuilder::new()\n      let mut p = pos + 1\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(method_name) => {\n            let after_colon = match peek(tokens, p + 1) {\n              TColon => p + 2,\n              _ => p + 1\n            }\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\n              _ => (_no_tp(), _no_tb(), after_colon)\n            }\n            let (params, after_method_params) = match peek(tokens, after_binder) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), after_binder)\n            }\n            let arrow_pos = expect_tk(tokens, after_method_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected trait method signature or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\n    },\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\n  }\n}\n\nfn parse_trait_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      match peek(tokens, after_name) {\n        TColon => {\n          let supers = empty_strings\n          let mut p = after_name + 1\n          let mut done = false\n          while !done {\n            match peek(tokens, p) {\n              TIdent(sname) => match peek(tokens, p + 1) {\n                TPlus => {\n                  Array::push(supers, sname)\n                  p = p + 2\n                },\n                _ => {\n                  Array::push(supers, sname)\n                  p = p + 1\n                  done = true\n                }\n              },\n              _ => {\n                done = true\n              }\n            }\n          }\n          let np = p\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\n          (STrait(exported, name, supers, methods, method_gens), body_end)\n        },\n        _ => {\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\n        }\n      }\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nfn is_expr_end_token(tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_, _) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nfn is_non_pipe_infix(tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nfn parse_import_item(tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int) with { Error } {\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\n    match peek(tokens, name_pos) {\n      TIdent(name) => {\n        let (base, after) = match peek(tokens, name_pos + 1) {\n          TDoubleColon => match peek(tokens, name_pos + 2) {\n            TIdent(member) =>\n            (String::concat(name, String::concat(\"::\", member)), name_pos + 3),\n            _ => throw(\"expected qualified member name after '::'\")\n          },\n          _ => (name, name_pos + 1)\n        }\n        match peek(tokens, after) {\n          TAs => match peek(tokens, after + 1) {\n            TIdent(alias) => ((base, Some(alias)), after + 2),\n            _ => throw(\"expected alias name after 'as'\")\n          },\n          _ => ((base, None), after)\n        }\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nfn empty_import_items() -> Array[(String, Option[String])] {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nfn parse_binding_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nexport fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TAs => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \".\")),\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \"..\")),\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \"/\")),\n    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, 0) == '@' && !String::ends_with(acc, \"/\") {\n      (acc, pos)\n    } else {\n      collect_import_path(tokens, pos + 1, String::concat(acc, name))\n    },\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \"-\")),\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \"module\")),\n    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, \"impl\")),\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \"type\")),\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \"match\")),\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \"test\")),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(String::concat(\"unexpected token in import path: \", actual))\n    }\n  }\n}\n\nfn skip_bracketed_args(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBracket => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nfn parse_tparam_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let b = ArrayBuilder::new()\n      let mut skip = pos + 1\n      let mut depth = 1\n      let mut expect_name = true\n      while depth > 0 {\n        match peek(tokens, skip) {\n          TLBracket => {\n            depth = depth + 1; skip = skip + 1\n          },\n          TRBracket => {\n            depth = depth - 1; skip = skip + 1\n          },\n          TComma => {\n            if depth == 1 {\n              expect_name = true\n            }\n            skip = skip + 1\n          },\n          TIdent(nm) => {\n            if depth == 1 && expect_name {\n              ArrayBuilder::push(b, nm)\n              expect_name = false\n            }\n            skip = skip + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            skip = skip + 1\n          }\n        }\n      }\n      (ArrayBuilder::freeze(b), skip)\n    },\n    _ => (Array::slice([\n      \"\"\n    ], 0, 0), pos)\n  }\n}\n\nfn collect_effect_names(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let (item, after_item) = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n          _ => throw(\"expected qualified operation name after '::' in effect list\")\n        },\n        _ => (name, pos + 1)\n      }\n      let new_acc = if String::length(acc) == 0 {\n        item\n      } else \"\\{acc}, \\{item}\"\n      match peek(tokens, after_item) {\n        TComma => collect_effect_names(tokens, after_item + 1, new_acc),\n        TRBrace => (new_acc, after_item + 1),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nfn parse_type_impl(tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int) with { Error } {\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let ts = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\n          ArrayBuilder::push(b, ty)\n          type_list_rest(tokens, next, b)\n        }\n      }\n      ,\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\n    match peek(tokens, rn) {\n      TWith => {\n        let with_pos = expect_tk(tokens, rn + 1, \"{\")\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n        (Some(effect_name_pair.0), effect_name_pair.1)\n      },\n      _ => (None, rn)\n    }\n  }\n  if mode == 0 {\n    match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => {\n          let after = pos + 2\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\n            },\n            _ => (TyUnit, after)\n          }\n        },\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          let (elems, after) = match peek(tokens, n1) {\n            TRParen => ([\n              first\n            ], n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (rest, en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(elems, ret, eff.0), eff.1)\n            },\n            _ => {\n              let atom = if Array::length(elems) == 1 {\n                Array::get(elems, 0)\n              } else {\n                TyTuple(elems)\n              }\n              match peek(tokens, after) {\n                TQuestion => (TyApp(\"Option\", [\n                  atom\n                ]), after + 1),\n                _ => (atom, after)\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n        match peek(tokens, atom_next) {\n          TThinArrow => {\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n            let eff = parse_effect_suffix(tokens, rn)\n            (TyFn([\n              atom_ty\n            ], ret, eff.0), eff.1)\n          },\n          _ => (atom_ty, atom_next)\n        }\n      }\n    }\n  } else {\n    let (base_ty, base_next) = match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => (TyUnit, pos + 2),\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          match peek(tokens, n1) {\n            TRParen => (first, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (TyTuple(rest), en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n        }\n      },\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TLBracket => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          match peek(tokens, n1) {\n            TRBracket => (TyApp(name, [\n              first\n            ]), n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \"]\");\n              (TyApp(name, rest), en)\n            },\n            _ => throw(\"expected ']' or ',' in type application\")\n          }\n        },\n        _ => (TyName(name), pos + 1)\n      },\n      _ => {\n        let actual = tk_name(peek(tokens, pos))\n        throw(\"expected type but got \\{actual}\")\n      }\n    }\n    match peek(tokens, base_next) {\n      TQuestion => (TyApp(\"Option\", [\n        base_ty\n      ]), base_next + 1),\n      _ => (base_ty, base_next)\n    }\n  }\n}\n\nexport fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nfn parse_one_param(tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected parameter name at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nfn parse_param_cont(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected ',' or ')' in param list at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nfn parse_param_list(tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nfn parse_struct_field(tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Bool, Int) with { Error } {\n  let (is_mut, p) = match peek(tokens, pos) {\n    TMut => (true, pos + 1),\n    _ => (false, pos)\n  }\n  match peek(tokens, p) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, p + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), is_mut, next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nfn is_lambda_start_impl(tokens: Array[Token], pos: Int, depth: Int, bdepth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 && bdepth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),\n    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),\n    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)\n  }\n}\n\nfn is_lambda_start(tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, 0, false)\n}\n\nfn parse_ctor_types_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nfn parse_enum_ctor(tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nfn parse_enum_ctors_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => throw(\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\{pos}\"),\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';' or '}' in enum at #\\{pos}\")\n  }\n}\n\nfn parse_enum_ctors(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nfn parse_enum_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let b = ArrayBuilder::new()\n          let mut skip = pos + 2\n          let mut depth = 1\n          let mut expect_name = true\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TComma => {\n                if depth == 1 {\n                  expect_name = true\n                }\n                skip = skip + 1\n              },\n              TIdent(nm) => {\n                if depth == 1 && expect_name {\n                  ArrayBuilder::push(b, nm)\n                  expect_name = false\n                }\n                skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          (ArrayBuilder::freeze(b), skip)\n        },\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SEnum(exported, name, params, ctors, derives), final_pos)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nfn parse_suberror_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nfn parse_impl_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_impl_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in impl type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_impl_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\n    _ => (_no_tp(), _no_tb(), pos)\n  }\n  match peek(tokens, after_tp) {\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, after_tp + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => {\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\n        },\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nfn parse_type_params_list(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_effect_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nfn parse_type_alias_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let ep = expect_tk(tokens, after_name, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, params, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nfn parse_impl_stmt_dispatch(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nfn push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nfn parse_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => throw(\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\{pos}\"),\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';' or '}' in struct at #\\{pos}\")\n  }\n}\n\nfn parse_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      push_mut_name(mb, first, is_mut)\n      parse_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nfn parse_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_tparam_names, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let source_8 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_primary.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, TypeExpr\n}\n\n\n\n\n\nfn map_located_off(off: Int, f: (Int) -> Int) -> Int {\n  if off < 0 {\n    off\n  } else {\n    f(off)\n  }\n}\n\nfn map_expr_offsets(expr: Expr, f: (Int) -> Int) -> Expr {\n  {\n    match expr {\n      EInt(_) => expr,\n      EFloat(_) => expr,\n      EString(_) => expr,\n      EBool(_) => expr,\n      EUnit => expr,\n      EIdent(name, off) => EIdent(name, map_located_off(off, f)),\n      ETuple(items) => ETuple(map_exprs(items, f)),\n      EArray(items) => EArray(map_exprs(items, f)),\n      ERecord(rn, fields, targs) => ERecord(rn, map_field_exprs(fields, f), targs),\n      EIf(c, t, e) => EIf(map_expr_offsets(c, f), map_expr_offsets(t, f), map_expr_offsets(e, f)),\n      ELet(n, v, b, soff) => ELet(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\n      ELetRec(n, v, b) => ELetRec(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      ELetMut(n, v, b, soff) => ELetMut(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\n      EAssign(n, v, b) => EAssign(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      EAssignOp(n, op, v, b) => EAssignOp(n, op, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      ESeq(a, b) => ESeq(map_expr_offsets(a, f), map_expr_offsets(b, f)),\n      EMatch(s, arms) => EMatch(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\n      EHandle(s, arms) => EHandle(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\n      EWhile(c, b) => EWhile(map_expr_offsets(c, f), map_expr_offsets(b, f)),\n      ELoop(params, b) => ELoop(map_loop_param_exprs(params, f), map_expr_offsets(b, f)),\n      EForIn(n, idx, it, b) => EForIn(n, idx, map_expr_offsets(it, f), map_expr_offsets(b, f)),\n      ECall(callee, args, off) => ECall(map_expr_offsets(callee, f), map_exprs(args, f), map_located_off(off, f)),\n      EBinOp(op, l, r) => EBinOp(op, map_expr_offsets(l, f), map_expr_offsets(r, f)),\n      EUnaryOp(op, e) => EUnaryOp(op, map_expr_offsets(e, f)),\n      EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, map_expr_offsets(body, f)),\n      EDot(e, field, off, fdoff) => EDot(map_expr_offsets(e, f), field, map_located_off(off, f), map_located_off(fdoff, f)),\n      ELabeledArg(l, n, v) => ELabeledArg(l, n, map_expr_offsets(v, f)),\n      EReturn(e) => EReturn(map_expr_offsets(e, f)),\n      EBreak(opt) => match opt {\n        Some(v) => EBreak(Some(map_expr_offsets(v, f))),\n        None => expr\n      },\n      EContinue(args) => EContinue(map_exprs(args, f)),\n      EMap(fields) => EMap(map_field_exprs(fields, f)),\n      ESpread(e) => ESpread(map_expr_offsets(e, f)),\n      EStringInterp(_) => expr\n    }\n  }\n}\n\nfn map_exprs(items: Array[Expr], f: (Int) -> Int) -> Array[Expr] {\n  for it in items {\n    map_expr_offsets(it, f)\n  }\n}\n\nfn map_field_exprs(fields: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\n  for fld in fields {\n    let (n, v) = fld\n    (n, map_expr_offsets(v, f))\n  }\n}\n\nfn map_arm_exprs(arms: Array[(Pat, Expr)], f: (Int) -> Int) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, e) = a\n    (p, map_expr_offsets(e, f))\n  }\n}\n\nfn map_loop_param_exprs(params: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\n  for p in params {\n    let (n, init) = p\n    (n, map_expr_offsets(init, f))\n  }\n}\n\nfn remap_frag_off(off: Int, outer_starts: Array[Int], frag_starts: Array[Int], frag_base: Int) -> Int {\n  let n = Array::length(outer_starts)\n  let mut lo = 0\n  let mut hi = n - 1\n  let mut found = -1\n  while lo <= hi {\n    let mid = (lo + hi) / 2\n    let v = Array::get(outer_starts, mid)\n    if v < off {\n      lo = mid + 1\n    } else {\n      if v == off {\n        found = mid\n      } else {\n        ()\n      }\n      hi = mid - 1\n    }\n  }\n  if found >= 0 && found < Array::length(frag_starts) {\n    frag_base + Array::get(frag_starts, found)\n  } else {\n    -1\n  }\n}\n\nfn build_interp_expr(parts: Array[String], offsets: Array[Int], outer_starts: Array[Int], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } {\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\n    ECall(EIdent(\"String::concat\", -1), [\n      a,\n      b\n    ], -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut i = 0\n  while i < plen {\n    let part = Array::get(parts, i)\n    if i % 2 == 0 {\n      if String::length(part) > 0 {\n        let piece = EString(part)\n        result = if has_val {\n          concat_expr(result, piece)\n        } else {\n          piece\n        }\n        has_val = true\n      } else {\n        ()\n      }\n    } else {\n      let (ftoks, fstarts, _fends) = lex_with_offsets(part)\n      let (pe0, _) = parse_recur(ftoks, 0, 0)\n      let frag_off = if i < Array::length(offsets) { Array::get(offsets, i) } else { -1 }\n      let pe = if frag_off >= 0 {\n        map_expr_offsets(pe0, (o) -> remap_frag_off(o, outer_starts, fstarts, frag_off))\n      } else {\n        pe0\n      }\n      let piece = ECall(EIdent(\"__to_string\", -1), [\n        pe\n      ], -1)\n      result = if has_val {\n        concat_expr(result, piece)\n      } else {\n        piece\n      }\n      has_val = true\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn desugar_loop_body(expr: Expr, param_names: Array[String]) -> Expr {\n  match expr {\n    EBreak(opt) => match opt {\n      Some(val) => EAssign(\"__loop_result\", desugar_loop_body(val, param_names), EBreak(None)),\n      None => EBreak(None)\n    },\n    EContinue(args) => {\n      if Array::length(args) == 0 {\n        EContinue(args)\n      } else {\n        let nargs = Array::length(args)\n        let nparams = Array::length(param_names)\n        if nargs > nparams {\n          EContinue(args)\n        } else {\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\n        let mut ci = nargs - 1\n        while ci >= 0 {\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\"__lt\", __to_string(ci)), -1), result)\n          ci = ci - 1\n        }\n        let mut ci2 = nargs - 1\n        while ci2 >= 0 {\n          result = ELet(String::concat(\"__lt\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result, -1)\n          ci2 = ci2 - 1\n        }\n        result\n        }\n      }\n    },\n    EWhile(_, _) => expr,\n    ELoop(_, _) => expr,\n    EFn(_, _, _, _, _, _) => expr,\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\n    ELet(n, v, b, soff) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    EMatch(s, arms) => EMatch(desugar_loop_body(s, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EHandle(body, arms) => EHandle(desugar_loop_body(body, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\n    ECall(_, _, _) => expr,\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\n    EDot(obj, field, off, fdoff) => EDot(desugar_loop_body(obj, param_names), field, off, fdoff),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    _ => expr\n  }\n}\n\n\nfn parse_loop_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let param_names_b = ArrayBuilder::new()\n      let param_inits_b = ArrayBuilder::new()\n      let mut cur = pos + 2\n      let mut done = false\n      while !done {\n        match peek(tokens, cur) {\n          TRParen => {\n            cur = cur + 1\n            done = true\n          },\n          TIdent(name) => {\n            let eq_pos = expect_tk(tokens, cur + 1, \"=\")\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\n            ArrayBuilder::push(param_names_b, name)\n            ArrayBuilder::push(param_inits_b, init)\n            match peek(tokens, next_pos) {\n              TComma => {\n                cur = next_pos + 1\n              },\n              TRParen => {\n                cur = next_pos + 1\n                done = true\n              },\n              _ => throw(\"expected ',' or ')' in loop params\")\n            }\n          },\n          _ => throw(\"expected loop parameter name or ')'\")\n        }\n      }\n      let body_pos = expect_tk(tokens, cur, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      let pnames = ArrayBuilder::freeze(param_names_b)\n      let pinits = ArrayBuilder::freeze(param_inits_b)\n      let transformed_body = desugar_loop_body(body, pnames)\n      let while_expr = EWhile(EBool(true), transformed_body)\n      let result = ELetMut(\"__loop_result\", EInt(0),\n        ESeq(while_expr, EIdent(\"__loop_result\", -1)), -1)\n      let mut wrapped = result\n      let mut wi = Array::length(pnames) - 1\n      while wi >= 0 {\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped, -1)\n        wi = wi - 1\n      }\n      (wrapped, end_pos)\n    },\n    _ => {\n      let body_pos = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EWhile(EBool(true), body), end_pos)\n    }\n  }\n}\n\nfn parse_break_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EBreak(None), pos + 1),\n    TSemicolon => (EBreak(None), pos + 1),\n    TEof => (EBreak(None), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EBreak(Some(expr)), next_pos)\n    }\n  }\n}\n\nfn parse_throw_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let open_pos = expect_tk(tokens, pos + 1, \"(\")\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\n  let close_pos = expect_tk(tokens, next_pos, \")\")\n  let off = offset_at(starts, pos)\n  (ECall(EIdent(\"perform\", off), [\n    ECall(EIdent(\"Error::Throw\", off), [\n      expr\n    ], off)\n  ], off), close_pos)\n}\n\nfn parse_return_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EReturn(EUnit), pos + 1),\n    TSemicolon => (EReturn(EUnit), pos + 1),\n    TEof => (EReturn(EUnit), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EReturn(expr), next_pos)\n    }\n  }\n}\n\nfn parse_perform_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRParen => (EIdent(\"perform\", -1), pos + 1),\n    TRBracket => (EIdent(\"perform\", -1), pos + 1),\n    TRBrace => (EIdent(\"perform\", -1), pos + 1),\n    TComma => (EIdent(\"perform\", -1), pos + 1),\n    TSemicolon => (EIdent(\"perform\", -1), pos + 1),\n    TEof => (EIdent(\"perform\", -1), pos + 1),\n    _ => {\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\n      (ECall(EIdent(\"perform\", -1), [\n        arg\n      ], offset_at(starts, pos)), next_pos)\n    }\n  }\n}\n\nfn parse_array_elems_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let next_pos = pos + 1\n      match peek(tokens, next_pos) {\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\n        TDotDotDot => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\n          ArrayBuilder::push(b, ESpread(expr))\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        },\n        _ => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\n          ArrayBuilder::push(b, expr)\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nfn parse_array_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBracket => (EArray(empty_exprs()), pos + 2),\n    TDotDotDot => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n      ArrayBuilder::push(b, ESpread(first))\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    },\n    _ => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, first)\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    }\n  }\n}\n\nfn parse_comma_exprs_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      match peek(tokens, pos + 1) {\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\n          ArrayBuilder::push(b, e)\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nfn parse_continue_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let b = ArrayBuilder::new()\n      match peek(tokens, pos + 2) {\n        TRParen => (EContinue(empty_exprs()), pos + 3),\n        _ => {\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n          ArrayBuilder::push(b, first)\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (EContinue(args), close_pos)\n        }\n      }\n    },\n    _ => (EContinue(empty_exprs()), pos + 1)\n  }\n}\n\nfn parse_control_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => parse_recur(tokens, pos + 1, 20),\n    TIf => parse_recur(tokens, pos + 1, 21),\n    TMatch => parse_recur(tokens, pos + 1, 22),\n    THandle => parse_recur(tokens, pos + 1, 24),\n    TWhile => parse_recur(tokens, pos + 1, 23),\n    TFor => parse_recur(tokens, pos + 1, 25),\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\n    TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\n    TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\n    TYield => throw(\"'yield' is not supported\"),\n    TDeclare => throw(\"'declare' is not supported\"),\n    _ => {\n      let prev_name = if pos > 0 {\n        tk_name(peek(tokens, pos - 1))\n      } else {\n        \"start\"\n      }\n      let actual = tk_name(peek(tokens, pos))\n      let next_name = tk_name(peek(tokens, pos + 1))\n      throw(\"unexpected token at #\\{pos}: \\{actual} (prev=\\{prev_name}, next=\\{next_name})\")\n    }\n  }\n}\n\nfn parse_ctor_record_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nfn parse_generic_fn_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let mut skip_pos = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, skip_pos) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      _ => ()\n    }\n    skip_pos = skip_pos + 1\n  }\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\n      let effect_pair = match peek(tokens, ret_pos) {\n        TWith => {\n          let with_pos = expect_tk(tokens, ret_pos + 1, \"{\")\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n          let effect_name = effect_name_pair.0\n          let end_pos = effect_name_pair.1\n          (Some(effect_name), end_pos)\n        },\n        _ => (None, ret_pos)\n      }\n      let effect = effect_pair.0\n      let effect_next = effect_pair.1\n      let body_pos = expect_tk(tokens, effect_next, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\n    },\n    TLBrace => {\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\n    },\n    _ => throw(\"expected '->' or '{' after generic function params\")\n  }\n}\n\nfn is_generic_fn_start(tokens: Array[Token], pos: Int) -> Bool {\n  match peek(tokens, pos + 1) {\n    TIdent(_) => {\n      let mut p = pos + 2\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, p) {\n          TLBracket => {\n            depth = depth + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => ()\n        }\n        p = p + 1\n      }\n      match peek(tokens, p) {\n        TLParen => true,\n        _ => false\n      }\n    },\n    _ => false\n  }\n}\n\nfn parse_bracket_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if is_generic_fn_start(tokens, pos) {\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_array_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nfn parse_paren_tuple_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRParen => (EUnit, pos + 2),\n    _ => {\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      match peek(tokens, next_pos) {\n        TRParen => (first, next_pos + 1),\n        TComma => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (ETuple(items), close_pos)\n        },\n        _ => throw(\"expected ')' or ','\")\n      }\n    }\n  }\n}\n\n\nfn parse_paren_lambda_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let after_arrow = after_params + 1\n      match peek(tokens, after_arrow) {\n        TIdent(_) => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        TLParen => {\n          let ty_opt = handle {\n            let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n            Some((ty, ty_pos))\n          } with Error {\n            Throw(_) => None\n          }\n          match ty_opt {\n            Some(pair) => {\n              let (ty, ty_pos) = pair\n              match peek(tokens, ty_pos) {\n                TLBrace => {\n                  let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n                },\n                TWith => {\n                  let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n                  let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n                  let effect_name = effect_pair.0\n                  let effect_next = effect_pair.1\n                  let body_pos = expect_tk(tokens, effect_next, \"{\")\n                  let (body, end) = parse_recur(tokens, body_pos, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n                },\n                _ => {\n                  let (body, end) = parse_recur(tokens, after_arrow, 0)\n                  (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n                }\n              }\n            },\n            None => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        _ => {\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n        }\n      }\n    },\n    TLBrace => {\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n    },\n    _ => throw(\"expected '->' or '{' after fn params\")\n  }\n}\n\nfn parse_paren_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if is_lambda_start(tokens, pos + 1) {\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nfn parse_record_literal_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nfn offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nfn is_struct_targs_ctor_start(tokens: Array[Token], pos: Int) -> Bool {\n  let mut p = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, p) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      TEof => {\n        depth = 0\n      },\n      _ => ()\n    }\n    p = p + 1\n  }\n  match peek(tokens, p) {\n    TDoubleColon => match peek(tokens, p + 1) {\n      TLBrace => true,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn parse_struct_ctor_targs(tokens: Array[Token], pos: Int, name: String) -> (Array[TypeExpr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBracket => throw(\"expected at least one type argument in `\\{name}[...]::{ ... }` at #\\{pos}: write `\\{name}::{ ... }` to infer the type arguments from the field values\"),\n    _ => {\n      let (first, after_first) = parse_type_impl(tokens, pos, 0)\n      let targs = [\n        first\n      ]\n      let mut p = after_first\n      while tk_name(peek(tokens, p)) == \",\" {\n        let (next, after_next) = parse_type_impl(tokens, p + 1, 0)\n        Array::push(targs, next)\n        p = after_next\n      }\n      let end_pos = expect_tk(tokens, p, \"]\")\n      (targs, end_pos)\n    }\n  }\n}\n\nfn parse_ident_primary(tokens: Array[Token], starts: Array[Int], pos: Int, name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if name == \"true\" {\n    (EBool(true), pos + 1)\n  } else if name == \"false\" {\n    (EBool(false), pos + 1)\n  } else if name == \"perform\" {\n    parse_perform_primary(tokens, starts, pos, parse_recur)\n  } else if name == \"record\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (ERecord(\"\", fields, empty_type_exprs()), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else if name == \"map\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => throw(\"the `map { ... }` literal was removed (#960): use Map::from_pairs([(\\\"key\\\", value), ...]) or Map::new() at #\\{pos}\"),\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else {\n    match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member)), offset_at(starts, pos)), pos + 3),\n        TLBrace => {\n          let b = ArrayBuilder::new()\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\n          (ERecord(name, fields, empty_type_exprs()), end_pos)\n        },\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      TLBracket => if is_struct_targs_ctor_start(tokens, pos + 1) {\n        let (targs, after_targs) = parse_struct_ctor_targs(tokens, pos + 2, name)\n        let dc_pos = expect_tk(tokens, after_targs, \"::\")\n        let brace_pos = expect_tk(tokens, dc_pos, \"{\")\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, brace_pos, b, parse_recur)\n        (ERecord(name, fields, targs), end_pos)\n      } else {\n        (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  }\n}\n\nexport fn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TInt(n) => (EInt(n), pos + 1),\n    TFloat(n) => (EFloat(n), pos + 1),\n    TString(s) => (EString(s), pos + 1),\n    TStringInterp(parts, offs) => (build_interp_expr(parts, offs, starts, parse_recur), pos + 1),\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\n  }\n}\n")
}

let source_9 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_core.vibe",
"\nimport @vibe/ast {\n  Expr, Pat\n}\n\n\n\n\n\nfn binop_op(tok: Token) -> String with { Error } {\n  match tok {\n    TOr => \"||\",\n    TAnd => \"&&\",\n    TPipeGt => \"|>\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TBitAnd => \"&\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    _ => throw(\"internal parser error: not a binary operator\")\n  }\n}\n\nfn binop_prec(tok: Token) -> Int {\n  match tok {\n    TOr => 0,\n    TAnd => 1,\n    TPipeGt => 2,\n    TEqEq => 3,\n    TNeq => 3,\n    TLt => 3,\n    TLte => 3,\n    TGt => 3,\n    TGte => 3,\n    TBitOr => 4,\n    TBitXor => 5,\n    TBitAnd => 6,\n    TLShift => 7,\n    TRShift => 7,\n    TPlus => 8,\n    TMinus => 8,\n    TStar => 9,\n    TSlash => 9,\n    TPercent => 9,\n    _ => -1\n  }\n}\n\nfn callee_offset(callee: Expr) -> Int {\n  match callee {\n    EIdent(_, off) => off,\n    EDot(inner, _, off, _) => if off >= 0 { off } else { callee_offset(inner) },\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\n    _ => -1\n  }\n}\n\nfn field_offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nfn index_expr(cur_expr: Expr, idx: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  ECall(EIdent(\"__index\", -1), args, -1)\n}\n\nfn pipe_arg_is_hole(arg: Expr) -> Bool {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    _ => false\n  }\n}\n\nfn pipe_desugar(lhs: Expr, rhs: Expr) -> Expr {\n  match rhs {\n    ECall(callee, args, off) => {\n      let mut has_hole = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if pipe_arg_is_hole(Array::get(args, i)) {\n          has_hole = true\n          i = Array::length(args)\n        } else {\n          i = i + 1\n        }\n      }\n      if has_hole {\n        let out = empty_exprs()\n        let mut j = 0\n        while j < Array::length(args) {\n          let a = Array::get(args, j)\n          if pipe_arg_is_hole(a) {\n            Array::push(out, lhs)\n          } else {\n            Array::push(out, a)\n          }\n          j = j + 1\n        }\n        ECall(callee, out, off)\n      } else {\n        ECall(callee, Array::concat([\n          lhs\n        ], args), off)\n      }\n    },\n    _ => {\n      let off = callee_offset(rhs)\n      ECall(rhs, Array::concat([\n        lhs\n      ], empty_exprs()), off)\n    }\n  }\n}\n\nfn parse_call_arg(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TThinArrow => {\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\n        (EFn(_no_tp(), _no_tb(), [\n          (name, None)\n        ], None, None, body), end)\n      },\n      TTilde => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TQuestion => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"?\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TEq => {\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\n        (ELabeledArg(name, \"~\", val), end)\n      },\n      _ => parse_recur(tokens, pos, 0)\n    },\n    _ => parse_recur(tokens, pos, 0)\n  }\n}\n\nfn has_placeholder_arg(arg: Expr) -> Bool {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    EBinOp(_, l, r) => has_placeholder_arg(l) || has_placeholder_arg(r),\n    _ => false\n  }\n}\n\nfn slice_from_idx_expr(cur_expr: Expr, idx: Expr, end_expr: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nfn has_placeholder_args(args: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) {\n    if has_placeholder_arg(Array::get(args, i)) {\n      found = true\n      i = Array::length(args)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn parse_call_args_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TComma => match peek(tokens, p + 1) {\n        TRParen => {\n          p = p + 1\n          done = true\n        },\n        _ => {\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\n          ArrayBuilder::push(b, e)\n          p = next\n        }\n      }\n      ,\n      _ => {\n        done = true\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn slice_from_zero_expr(cur_expr: Expr, end_expr: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, EInt(0))\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nfn wrap_placeholder_arg(arg: Expr) -> Expr {\n  let mut pc = 0\n  let params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let rec replace_placeholders: (Expr) -> Expr = (e) -> {\n    match e {\n      EIdent(n, _) => if n == \"_\" {\n        let pn = String::concat(\"__ph\", __to_string(pc))\n        Array::push(params, (pn, None))\n        pc = pc + 1\n        EIdent(pn, -1)\n      } else {\n        e\n      }\n      ,\n      EBinOp(op, l, r) => {\n        let nl = replace_placeholders(l)\n        let nr = replace_placeholders(r)\n        EBinOp(op, nl, nr)\n      },\n      _ => e\n    }\n  }\n  let replaced = replace_placeholders(arg)\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\n}\n\nfn has_non_pipe_infix_top(tokens: Array[Token], start: Int, end: Int) -> Bool {\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else {\n            go(i + 1, 0, false)\n          }\n        } else {\n          match tok {\n            TLParen => go(i + 1, 1, false),\n            TLBracket => go(i + 1, 1, false),\n            TLBrace => go(i + 1, 1, false),\n            _ => go(i + 1, 0, is_expr_end_token(tok))\n          }\n        }\n      } else {\n        match tok {\n          TLParen => go(i + 1, depth + 1, prev_top_end),\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\n          TRParen => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBracket => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBrace => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          _ => go(i + 1, depth, prev_top_end)\n        }\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nfn desugar_placeholder_args(args: Array[Expr]) -> Array[Expr] {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    if pipe_arg_is_hole(arg) {\n      Array::push(out, arg)\n    } else if has_placeholder_arg(arg) {\n      Array::push(out, wrap_placeholder_arg(arg))\n    } else {\n      Array::push(out, arg)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn empty_map_fields() -> Array[(String, Expr)] {\n  Array::slice([\n    (\"\", EUnit)\n  ], 0, 0)\n}\n\nfn map_from_pairs_fields(args: Array[Expr], pos: Int) -> Array[(String, Expr)] with { Error } {\n  if Array::length(args) != 1 {\n    throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\{pos}\")\n  }\n  match Array::get(args, 0) {\n    EArray(elems) => {\n      let b = ArrayBuilder::new()\n      let mut i = 0\n      while i < Array::length(elems) {\n        match Array::get(elems, i) {\n          ETuple(kv) => if Array::length(kv) == 2 {\n            match Array::get(kv, 0) {\n              EString(k) => ArrayBuilder::push(b, (k, Array::get(kv, 1))),\n              _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): pair key is not a string literal at #\\{pos}\")\n            }\n          } else {\n            throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each pair must be a 2-tuple literal at #\\{pos}\")\n          },\n          _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each element must be a tuple literal at #\\{pos}\")\n        }\n        i = i + 1\n      }\n      ArrayBuilder::freeze(b)\n    },\n    _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\{pos}\")\n  }\n}\n\nfn build_call_expr(expr: Expr, args: Array[Expr], pos: Int) -> Expr with { Error } {\n  let ctor_name = match expr {\n    EIdent(name, _) => name,\n    _ => \"\"\n  }\n  if ctor_name == \"Map::new\" {\n    if Array::length(args) == 0 {\n      EMap(empty_map_fields())\n    } else {\n      throw(\"Map::new takes no arguments (#960): use Map::from_pairs([(\\\"key\\\", value), ...]) to build a non-empty map at #\\{pos}\")\n    }\n  } else if ctor_name == \"Map::from_pairs\" {\n    EMap(map_from_pairs_fields(args, pos))\n  } else {\n    ECall(expr, args, callee_offset(expr))\n  }\n}\n\nfn parse_postfix(tokens: Array[Token], starts: Array[Int], pos: Int, expr: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLParen => match expr {\n      EArray(_) => (expr, pos),\n      ETuple(_) => (expr, pos),\n      ERecord(_, _, _) => (expr, pos),\n      EMap(_) => (expr, pos),\n      EInt(_) => (expr, pos),\n      EFloat(_) => (expr, pos),\n      EString(_) => (expr, pos),\n      EStringInterp(_) => (expr, pos),\n      EBool(_) => (expr, pos),\n      EUnit => (expr, pos),\n      EWhile(_, _) => (expr, pos),\n      EIf(_, _, _) => (expr, pos),\n      EMatch(_, _) => (expr, pos),\n      ELoop(_, _) => (expr, pos),\n      EForIn(_, _, _, _) => (expr, pos),\n      EHandle(_, _) => (expr, pos),\n      _ => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, starts, pos + 2, build_call_expr(expr, empty_exprs(), pos), parse_recur),\n        _ => {\n          let b = ArrayBuilder::new()\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\n          ArrayBuilder::push(b, first_arg)\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          let call_args = if has_placeholder_args(args) {\n            desugar_placeholder_args(args)\n          } else {\n            args\n          }\n          parse_postfix(tokens, starts, close_pos, build_call_expr(expr, call_args, pos), parse_recur)\n        }\n      },\n    },\n    TLBracket => match peek(tokens, pos + 1) {\n      TColon => match peek(tokens, pos + 2) {\n        TRBracket => {\n          let end_expr = ECall(EIdent(\"__len\", -1), [\n            expr\n          ], -1)\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\n        },\n        _ => {\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\n          let close_pos = match peek(tokens, end_next) {\n            TRBracket => end_next + 1,\n            _ => throw(\"expected ']'\")\n          }\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\n        }\n      },\n      _ => {\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\n        match peek(tokens, idx_next) {\n          TColon => match peek(tokens, idx_next + 1) {\n            TRBracket => {\n              let end_expr = ECall(EIdent(\"__len\", -1), [\n                expr\n              ], -1)\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            },\n            _ => {\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\n              let close_pos = match peek(tokens, end_next) {\n                TRBracket => end_next + 1,\n                _ => throw(\"expected ']'\")\n              }\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            }\n          },\n          _ => {\n            let close_pos = match peek(tokens, idx_next) {\n              TRBracket => idx_next + 1,\n              _ => throw(\"expected ']'\")\n            }\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\n          }\n        }\n      }\n    },\n    TDot => match peek(tokens, pos + 1) {\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      _ => (expr, pos)\n    },\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\"__try_op\", -1), [\n      expr\n    ], -1), parse_recur),\n    _ => (expr, pos)\n  }\n}\n\nfn parse_prefix(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TMinus => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"-\", e), next)\n    },\n    TNot => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"!\", e), next)\n    },\n    _ => {\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\n      parse_postfix(tokens, starts, next, e, parse_recur)\n    }\n  }\n}\n\nfn left_is_stmt_form(e: Expr) -> Bool {\n  match e {\n    EWhile(_, _) => true,\n    ELoop(_, _) => true,\n    EForIn(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn is_is_token(tok: Token) -> Bool {\n  match tok {\n    TIs => true,\n    TIdent(kw) => kw == \"is\",\n    _ => false\n  }\n}\n\nfn parse_infix_loop(tokens: Array[Token], starts: Array[Int], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool, consume_is: Bool, is_top_atom: Bool, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let tok = peek(tokens, next)\n  if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) && is_top_atom {\n    (left, next)\n  } else if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) {\n    let (pat, pn) = parse_pattern(tokens, next + 1)\n    let combined = EMatch(left, [\n      (pat, EBool(true)),\n      (PWild, EBool(false))\n    ])\n    parse_infix_loop(tokens, starts, combined, pn, min_prec, expr_start, true, consume_is, false, parse_recur)\n  } else {\n    let prec = binop_prec(tok)\n    let should_stop = if prec < min_prec {\n      true\n    } else if cmp_locked {\n      prec == 3\n    } else if left_is_stmt_form(left) {\n      match tok {\n        TPlus => true,\n        TMinus => true,\n        _ => false\n      }\n    } else {\n      false\n    }\n    if should_stop {\n      (left, next)\n    } else {\n      let is_pipe = match tok {\n        TPipeGt => true,\n        _ => false\n      }\n      let op = binop_op(tok)\n      if is_pipe {\n        if has_non_pipe_infix_top(tokens, expr_start, next) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        }\n      }\n      let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\n      let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, consume_is, false, parse_recur)\n      if is_pipe {\n        if has_non_pipe_infix_top(tokens, next + 1, rn) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        }\n      }\n      let combined = if is_pipe {\n        pipe_desugar(left, right)\n      } else {\n        EBinOp(op, left, right)\n      }\n      let next_cmp_locked = if prec == 3 {\n        true\n      } else {\n        cmp_locked\n      }\n      parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, consume_is, false, parse_recur)\n    }\n  }\n}\n\nexport fn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, true, parse_recur)\n}\n\nexport fn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, false, parse_recur)\n}\n")
}

let source_10 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_dispatch.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, TypeExpr\n}\n\n\n\n\n\nfn ascribe_wrap(val: Expr, ty: TypeExpr) -> Expr {\n  let tparams = Array::slice([\n    \"\"\n  ], 0, 0)\n  let tbounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let params = [\n    (\"__asc\", Some(ty))\n  ]\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\"__asc\", 0 - 1))\n  ECall(lam, [\n    val\n  ], 0 - 1)\n}\n\nfn distribute_local_fn_ann(ann_ty: TypeExpr, val: Expr) -> Option[Expr] {\n  match ann_ty {\n    TyFn(param_types, ret_ty, effect_name) => match val {\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\n        if Array::length(params) != Array::length(param_types) {\n          None\n        } else {\n          let out = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(params) {\n            let (pname, pann) = Array::get(params, i)\n            let next_ann = match pann {\n              Some(_) => pann,\n              None => Some(Array::get(param_types, i))\n            }\n            ArrayBuilder::push(out, (pname, next_ann))\n            i = i + 1\n          }\n          let next_ret = match ret_opt {\n            Some(_) => ret_opt,\n            None => Some(ret_ty)\n          }\n          let next_eff = match effect_opt {\n            Some(_) => effect_opt,\n            None => effect_name\n          }\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\n        }\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nfn dispatch_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(bname) => {\n        ArrayBuilder::push(b, bname)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn dispatch_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        done = true\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = dispatch_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            done = true\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_local_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (tps, tbs, after_binder) = dispatch_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_binder, 0)\n      (tps, tbs, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      let no_tp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let no_tb = Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      (no_tp, no_tb, ty, next)\n    }\n  }\n}\n\nfn apply_local_let_tp(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {\n  if Array::length(tps) > 0 {\n    match val {\n      EFn(_, _, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, body),\n      _ => val\n    }\n  } else {\n    val\n  }\n}\n\nfn blk_offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nenum BlockStep {\n  StepSeq(Expr);\n  StepValue(Expr);\n  StepLet(String, Expr, Int);\n  StepLetMut(String, Expr, Int);\n  StepLetRec(String, Expr);\n  StepAssign(String, Expr);\n  StepAssignOp(String, String, Expr);\n  StepPattern(Pat, Expr);\n  StepPatternElse(Pat, Expr, Expr);\n  StepStructDestr(Pat, Expr);\n  StepRecordDestr(Pat, Expr);\n  StepBind(String, Expr)\n}\n\nfn desugar_guarded(arms: Array[(Pat, Expr, Expr)], i: Int, scrut: Expr) -> Array[(Pat, Expr)] {\n  if i >= Array::length(arms) {\n    empty_arms()\n  } else {\n    let (pat, guard, body) = Array::get(arms, i)\n    let rest = desugar_guarded(arms, i + 1, scrut)\n    let no_guard = match guard {\n      EBool(bv) => bv,\n      _ => false\n    }\n    let arm_body = if no_guard {\n      body\n    } else {\n      EIf(guard, body, EMatch(scrut, rest))\n    }\n    let out = ArrayBuilder::new()\n    ArrayBuilder::push(out, (pat, arm_body))\n    let mut j = 0\n    while j < Array::length(rest) {\n      ArrayBuilder::push(out, Array::get(rest, j))\n      j = j + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nfn collect_match_arms(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(Pat, Expr, Expr)], hg: Array[Bool], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\n  let (pat, pa) = parse_pattern(tokens, pos)\n  let (guard, after_g) = match peek(tokens, pa) {\n    TIf => {\n      Array::set(hg, 0, true)\n      parse_recur(tokens, pa + 1, 0)\n    },\n    _ => (EBool(true), pa)\n  }\n  let arrow = expect_tk(tokens, after_g, \"=>\")\n  let (body, bn) = parse_recur(tokens, arrow, 0)\n  ArrayBuilder::push(b, (pat, guard, body))\n  match peek(tokens, bn) {\n    TComma => match peek(tokens, bn + 1) {\n      TRBrace => bn + 2,\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\n    },\n    TRBrace => bn + 1,\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\n  }\n}\n\nfn qualify_handle_arm_pattern(effect_name: String, pat: Pat) -> Pat {\n  match pat {\n    PCtor(name, args) => if String::contains(name, \"::\") {\n      PCtor(name, args)\n    } else {\n      PCtor(String::concat(effect_name, String::concat(\"::\", name)), args)\n    },\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\n    _ => pat\n  }\n}\n\nfn parse_handle_arm(tokens: Array[Token], starts: Array[Int], pos: Int, effect_name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } {\n  let (pat, pat_next) = parse_pattern(tokens, pos)\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\n  let arrow_pos = expect_tk(tokens, pat_next, \"=>\")\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\n  ((qualified_pat, expr), next)\n}\n\nfn parse_handle_rest(tokens: Array[Token], starts: Array[Int], pos: Int, body: Expr, effect_name: String, b: ArrayBuilder[(Pat, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    },\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n    _ => throw(\"expected ';' or '}' in handle arm list\")\n  }\n}\n\nfn parse_block_after_expr(tokens: Array[Token], pos: Int, e: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (e, pos + 1),\n    TSemicolon => {\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\n      (ESeq(e, rest), end)\n    },\n    TEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssign(name, val, rest), end)\n      },\n      EDot(obj, field, _, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        let set_args = empty_exprs()\n        Array::push(set_args, obj)\n        Array::push(set_args, EString(field))\n        Array::push(set_args, val)\n        (ESeq(ECall(EIdent(\"__set_field\", -1), set_args, -1), rest), end)\n      },\n      ECall(idx_callee, idx_args, _) => {\n        let is_index = match idx_callee {\n          EIdent(icn, _) => icn == \"__index\",\n          _ => false\n        }\n        if is_index && Array::length(idx_args) == 2 {\n          let val_pair = parse_recur(tokens, pos + 1, 0)\n          let val = val_pair.0\n          let val_next = val_pair.1\n          let a = skip_semi(tokens, val_next)\n          let (rest, end) = parse_recur(tokens, a, 20)\n          let set_args = empty_exprs()\n          Array::push(set_args, Array::get(idx_args, 0))\n          Array::push(set_args, Array::get(idx_args, 1))\n          Array::push(set_args, val)\n          (ESeq(ECall(EIdent(\"Array::set\", -1), set_args, -1), rest), end)\n        } else {\n          throw(\"invalid assignment target\")\n        }\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPlusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"+\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TMinusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"-\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TStarEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"*\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TSlashEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"/\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPercentEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"%\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    _ => {\n      let (rest, end) = parse_recur(tokens, pos, 20)\n      if end <= pos {\n        throw(\"internal parser error: block continuation did not advance\")\n      } else {\n        (ESeq(e, rest), end)\n      }\n    }\n  }\n}\n\nfn parse_block_value_body(tokens: Array[Token], eq: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } {\n  let val_pair = parse_recur(tokens, eq, 0)\n  let val = val_pair.0\n  let val_next = val_pair.1\n  let a = skip_semi(tokens, val_next)\n  let (body, end) = parse_recur(tokens, a, 20)\n  (val, body, end, a)\n}\n\nfn parse_block_value_only(tokens: Array[Token], value_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let val_pair = parse_recur(tokens, value_pos, 0)\n  (val_pair.0, skip_semi(tokens, val_pair.1))\n}\n\nfn apply_struct_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\n  let val_name = \"__struct_destr\"\n  let mut desugar = rest\n  match pat {\n    PStruct(_, fields) => {\n      let mut di = Array::length(fields) - 1\n      while di >= 0 {\n        let (fname, fpat) = Array::get(fields, di)\n        match fpat {\n          PBind(bname) => {\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1, -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nfn apply_record_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\n  let val_name = \"__rec_destr\"\n  let mut desugar = rest\n  match pat {\n    PTuple(field_pats) => {\n      let mut di = Array::length(field_pats) - 1\n      while di >= 0 {\n        let fp = Array::get(field_pats, di)\n        match fp {\n          PBind(bname) => {\n            desugar = ELet(bname, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          PTuple(sub_pats) => {\n            let sub_name = String::concat(\"__rec_sub_\", __to_string(di))\n            let mut si = Array::length(sub_pats) - 1\n            while si >= 0 {\n              match Array::get(sub_pats, si) {\n                PBind(sname) => {\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1, -1), desugar, -1)\n                },\n                _ => ()\n              }\n              si = si - 1\n            }\n            desugar = ELet(sub_name, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nfn apply_block_step(step: BlockStep, rest: Expr) -> Expr {\n  match step {\n    StepSeq(expr) => ESeq(expr, rest),\n    StepValue(expr) => expr,\n    StepLet(name, val, soff) => ELet(name, val, rest, soff),\n    StepLetMut(name, val, soff) => ELetMut(name, val, rest, soff),\n    StepLetRec(name, val) => ELetRec(name, val, rest),\n    StepAssign(name, val) => EAssign(name, val, rest),\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\n    StepPattern(pat, val) => EMatch(val, [\n      (pat, rest)\n    ]),\n    StepPatternElse(pat, val, alt) => EMatch(val, [\n      (pat, rest),\n      (PWild, alt)\n    ]),\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\n    StepBind(name, val) => ECall(EIdent(\"__try_bind\", -1), [\n      val,\n      EFn(Array::slice([\n        \"\"\n      ], 0, 0), Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0), [\n        (name, None)\n      ], None, None, rest)\n    ], -1)\n  }\n}\n\nfn fold_block_steps(steps: Array[BlockStep]) -> Expr {\n  let mut result = EUnit\n  let mut i = Array::length(steps) - 1\n  while i >= 0 {\n    result = apply_block_step(Array::get(steps, i), result)\n    i = i - 1\n  }\n  result\n}\n\nfn parse_optional_let_else(tokens: Array[Token], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Option[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TElse => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_recur(tokens, br, 20)\n      (Some(body), end)\n    },\n    _ => (None, pos)\n  }\n}\n\nfn push_pattern_let_step(tokens: Array[Token], steps: ArrayBuilder[BlockStep], pat: Pat, val: Expr, next_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\n  let (else_body, after) = parse_optional_let_else(tokens, next_pos, parse_recur)\n  match else_body {\n    Some(alt) => ArrayBuilder::push(steps, StepPatternElse(pat, val, alt)),\n    None => ArrayBuilder::push(steps, StepPattern(pat, val))\n  }\n  after\n}\n\nfn parse_impl_block(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let steps = ArrayBuilder::new()\n  let mut p = pos\n  let mut end_pos = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBrace => {\n        end_pos = p + 1\n        done = true\n      },\n      TEof => throw(\"unexpected eof in block\"),\n      TEnum => {\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\n        match enum_stmt {\n          SEnum(_, _, _, variants, _) => {\n            let mut vi = 0\n            while vi < Array::length(variants) {\n              let (vname, vfields) = Array::get(variants, vi)\n              if Array::length(vfields) == 0 {\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi), -1))\n              }\n              vi = vi + 1\n            }\n          },\n          _ => ()\n        }\n        p = enum_end\n      },\n      TStruct => {\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\n        p = struct_end\n      },\n      TLet => {\n        let next = p + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (rtps, rtbs, rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (tps, tbs, rty, tp) = parse_local_let_annotation(tokens, next + 3)\n                  (tps, tbs, Some(rty), tp)\n                },\n                _ => {\n                  let no_tp = Array::slice([\n                    \"\"\n                  ], 0, 0)\n                  let no_tb = Array::slice([\n                    (\"\", Array::slice([\n                      \"\"\n                    ], 0, 0))\n                  ], 0, 0)\n                  (no_tp, no_tb, None, next + 2)\n                }\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else {\n                let val2 = match rec_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => apply_local_let_tp(rtps, rtbs, distributed),\n                    None => val\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (m_ann, eq_pos_m) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (mty, tp) = parse_type_impl(tokens, next + 3, 0)\n                  (Some(mty), tp)\n                },\n                _ => (None, next + 2)\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else {\n                let val2 = match m_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => distributed,\n                    None => ascribe_wrap(val, the_type)\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetMut(name, val2, blk_offset_at(starts, next - 1)))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TStar => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let* parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepBind(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let*'\")\n          },\n          TIdent(name) => {\n            let after_name = peek(tokens, next + 1)\n            let next_is_struct_destr = match after_name {\n              TDoubleColon => {\n                let fc = String::char_code_at(name, 0)\n                if fc >= 65 && fc <= 90 {\n                  match peek(tokens, next + 2) {\n                    TLBrace => true,\n                    _ => false\n                  }\n                } else {\n                  false\n                }\n              },\n              _ => false\n            }\n            let next_is_record_destr = match after_name {\n              TLBrace => name == \"record\",\n              _ => false\n            }\n            if next_is_struct_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\n              p = next_pos\n            } else if next_is_record_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\n              p = next_pos\n            } else {\n              match after_name {\n                TLParen => {\n                  let (pat, pn) = parse_pattern(tokens, next)\n                  let eq = expect_tk(tokens, pn, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n                  } else {\n                    p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n                  }\n                },\n                _ => {\n                  let (ltps, ltbs, ann_type, eq_pos) = match after_name {\n                    TColon => {\n                      let (tps, tbs, the_type, tp) = parse_local_let_annotation(tokens, next + 2)\n                      (tps, tbs, Some(the_type), tp)\n                    },\n                    _ => {\n                      let no_tp = Array::slice([\n                        \"\"\n                      ], 0, 0)\n                      let no_tb = Array::slice([\n                        (\"\", Array::slice([\n                          \"\"\n                        ], 0, 0))\n                      ], 0, 0)\n                      (no_tp, no_tb, None, next + 1)\n                    }\n                  }\n                  let eq = expect_tk(tokens, eq_pos, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let parser did not advance\")\n                  } else {\n                    let val2 = match ann_type {\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                        Some(distributed) => apply_local_let_tp(ltps, ltbs, distributed),\n                        None => ascribe_wrap(val, the_type)\n                      },\n                      None => val\n                    }\n                    ArrayBuilder::push(steps, StepLet(name, val2, blk_offset_at(starts, next - 1)))\n                    p = next_pos\n                  }\n                }\n              }\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n            if next_pos <= eq {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_recur(tokens, p, 0)\n        if next <= p {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else {\n          match peek(tokens, next) {\n            TRBrace => {\n              ArrayBuilder::push(steps, StepValue(e))\n              end_pos = next + 1\n              done = true\n            },\n            TSemicolon => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next + 1\n            },\n            TEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssign(name, val))\n                p = next_pos\n              },\n              EDot(obj, field, _, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                let set_args = empty_exprs()\n                Array::push(set_args, obj)\n                Array::push(set_args, EString(field))\n                Array::push(set_args, val)\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"__set_field\", -1), set_args, -1)))\n                p = next_pos\n              },\n              ECall(sidx_callee, sidx_args, _) => {\n                let s_is_index = match sidx_callee {\n                  EIdent(sicn, _) => sicn == \"__index\",\n                  _ => false\n                }\n                if s_is_index && Array::length(sidx_args) == 2 {\n                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                  let set_args = empty_exprs()\n                  Array::push(set_args, Array::get(sidx_args, 0))\n                  Array::push(set_args, Array::get(sidx_args, 1))\n                  Array::push(set_args, val)\n                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"Array::set\", -1), set_args, -1)))\n                  p = next_pos\n                } else {\n                  throw(\"invalid assignment target\")\n                }\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPlusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"+\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TMinusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"-\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TStarEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"*\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TSlashEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"/\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPercentEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"%\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            _ => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next\n            }\n          }\n        }\n      }\n    }\n  }\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\n}\n\n\nexport fn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if mode == 20 {\n    parse_impl_block(tokens, starts, pos, parse_recur)\n  } else if mode == 21 {\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIs => {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_recur(tokens, br, 20)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_recur(tokens, tn + 2, 21),\n        TLBrace => parse_recur(tokens, tn + 2, 20),\n        _ => parse_recur(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [\n        (is_pat_val, then_e),\n        (PWild, else_e)\n      ]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == 22 {\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let ab = ArrayBuilder::new()\n        let hg = [false]\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\n        let arms3 = ArrayBuilder::freeze(ab)\n        if Array::get(hg, 0) {\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\"__mg\", 0 - 1))\n          (ELet(\"__mg\", scrutinee, EMatch(EIdent(\"__mg\", 0 - 1), final_arms), -1), endpos)\n        } else {\n          let plain = ArrayBuilder::new()\n          let mut k = 0\n          while k < Array::length(arms3) {\n            let (p, _, bd) = Array::get(arms3, k)\n            ArrayBuilder::push(plain, (p, bd))\n            k = k + 1\n          }\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\n        }\n      }\n    }\n  } else if mode == 23 {\n    let (cond, cn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_recur(tokens, br, 20)\n    (EWhile(cond, body), end)\n  } else if mode == 24 {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_recur(tokens, br, 20)\n    let wp = expect_tk(tokens, bn, \"with\")\n    let (effect_name, effect_next) = match peek(tokens, wp) {\n      TIdent(name) => (name, wp + 1),\n      _ => throw(\"expected effect name after 'with'\")\n    }\n    let hb = expect_tk(tokens, effect_next, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    }\n  } else if mode == 25 {\n    let mut start = pos\n    let mut is_await = false\n    match peek(tokens, pos) {\n      TIdent(marker) => if marker == \"await\" {\n        match peek(tokens, pos + 1) {\n          TIdent(_) => { start = pos + 1; is_await = true },\n          _ => ()\n        }\n      } else (),\n      _ => ()\n    }\n    match peek(tokens, start) {\n      TIdent(first_name) => match peek(tokens, start + 1) {\n        TComma => match peek(tokens, start + 2) {\n          TIdent(second_name) => {\n            let ip = expect_tk(tokens, start + 3, \"in\")\n            match parse_recur(tokens, ip, 0) {\n              (iterable, after_iter) => {\n                let bb = expect_tk(tokens, after_iter, \"{\")\n                let (body, end) = parse_recur(tokens, bb, 20)\n                let loop_expr = if is_await {\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\"__await_iter\", -1), [\n                    iterable\n                  ], -1), body)\n                } else {\n                  EForIn(second_name, Some(first_name), iterable, body)\n                }\n                (loop_expr, end)\n              },\n              _ => throw(\"unreachable: parse_recur for for-in\")\n            }\n          },\n          _ => throw(\"expected value binding name after ','\")\n        },\n        _ => {\n          let ip = expect_tk(tokens, start + 1, \"in\")\n          match parse_recur(tokens, ip, 0) {\n            (iterable, after_iter) => {\n              let bb = expect_tk(tokens, after_iter, \"{\")\n              let (body, end) = parse_recur(tokens, bb, 20)\n              let loop_expr = if is_await {\n                EForIn(first_name, None, ECall(EIdent(\"__await_iter\", -1), [\n                  iterable\n                ], -1), body)\n              } else {\n                EForIn(first_name, None, iterable, body)\n              }\n              (loop_expr, end)\n            },\n            _ => throw(\"unreachable: parse_recur for for-in\")\n          }\n        }\n      }\n      ,\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"internal parser error: unknown parse mode \\{mode} at #\\{pos} token=\\{actual}\")\n  }\n}\n")
}

let source_11 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr.vibe",
"\nimport @vibe/ast {\n  Expr, Stmt, TypeExpr\n}\n\n\n\n\n\n\nexport fn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int) -> (Expr, Int) with { Error } {\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\n    if rmode >= 0 && rmode <= 10 {\n      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)\n    } else {\n      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)\n    }\n  }\n  parse_recur(tokens, pos, mode)\n}\n\nexport fn parse(tokens: Array[Token]) -> Expr with { Error } {\n  let (e, next) = parse_impl(tokens, [], 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => {\n      let actual = tk_name(peek(tokens, next))\n      throw(\"unexpected after expression: \\{actual}\")\n    }\n  }\n}\n\nexport fn parse_ok(tokens: Array[Token]) -> Bool {\n  handle {\n    let _ = parse(tokens)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n\nexport fn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error } {\n  parse_impl(tokens, [], pos, 0)\n}\n\nfn parse_type_param_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_let_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\n      (type_params, type_bounds, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      (_no_tp(), _no_tb(), ty, next)\n    }\n  }\n}\n\nfn apply_fn_annotation_params(params: Array[(String, Option[TypeExpr])], param_types: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {\n  if Array::length(params) != Array::length(param_types) {\n    params\n  } else {\n    let out = ArrayBuilder::new()\n    let mut i = 0\n    while i < Array::length(params) {\n      let (name, ann) = Array::get(params, i)\n      let next_ann = match ann {\n        Some(_) => ann,\n        None => Some(Array::get(param_types, i))\n      }\n      ArrayBuilder::push(out, (name, next_ann))\n      i = i + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nfn apply_generic_fn_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr, param_types: Array[TypeExpr], ret_ty: TypeExpr, effect_name: Option[String]) -> (Option[TypeExpr], Expr) {\n  match val {\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\n      let next_params = apply_fn_annotation_params(params, param_types)\n      let next_ret = match ret_opt {\n        Some(_) => ret_opt,\n        None => Some(ret_ty)\n      }\n      let next_effect = match effect_opt {\n        Some(_) => effect_opt,\n        None => effect_name\n      }\n      let next_type_params = if Array::length(type_params) > 0 {\n        type_params\n      } else existing_type_params\n      let next_type_bounds = if Array::length(type_params) > 0 {\n        type_bounds\n      } else existing_type_bounds\n      let next_ann = if Array::length(type_params) > 0 {\n        None\n      } else ann\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\n    },\n    _ => (ann, val)\n  }\n}\n\nfn apply_generic_let_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr) -> (Option[TypeExpr], Expr) {\n  match ann {\n    Some(ann_ty) => match ann_ty {\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\n      _ => (ann, val)\n    },\n    _ => (ann, val)\n  }\n}\n\nfn apply_value_bracket_type_params(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {\n  if Array::length(tps) == 0 {\n    val\n  } else {\n    match val {\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\n        let next_tp = if Array::length(existing_tp) > 0 {\n          existing_tp\n        } else tps\n        let next_tb = if Array::length(existing_tp) > 0 {\n          existing_tb\n        } else tbs\n        EFn(next_tp, next_tb, params, ret, eff, body)\n      },\n      _ => val\n    }\n  }\n}\n\nfn skip_generic_value_start(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBracket => match peek(tokens, pos + 1) {\n      TIdent(_) => {\n        let maybe_generic = match peek(tokens, pos + 2) {\n          TRBracket => match peek(tokens, pos + 3) {\n            TLParen => true,\n            _ => false\n          },\n          TColon => true,\n          TComma => true,\n          _ => false\n        }\n        if maybe_generic {\n          let mut scan_pos = pos + 1\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, scan_pos) {\n              TLBracket => {\n                depth = depth + 1\n              },\n              TRBracket => {\n                depth = depth - 1\n              },\n              _ => ()\n            }\n            scan_pos = scan_pos + 1\n          }\n          scan_pos\n        } else {\n          pos\n        }\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\nfn parse_value_bracket_header(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let skipped = skip_generic_value_start(tokens, pos)\n  if skipped == pos {\n    (_no_tp(), _no_tb(), pos)\n  } else {\n    match peek(tokens, pos) {\n      TLBracket => {\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\n        (tps, tbs, skipped)\n      },\n      _ => (_no_tp(), _no_tb(), skipped)\n    }\n  }\n}\n\nfn parse_let_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n          (tparams, tbounds, Some(ty), tp)\n        },\n        _ => (_no_tp(), _no_tb(), None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\n      let val_pair = parse_impl(tokens, starts, val_start_r, 0)\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n      let val_next = val_pair.1\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let val_pair = parse_impl(tokens, starts, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetMut(name, ty_opt, val), val_next)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TLParen => {\n      throw(\"top-level 'let (..) = <expr>' tuple destructuring is not supported (#859); move it into a function body (e.g. 'fn main() { let (a, b) = <expr>; .. }')\")\n    },\n    TIdent(_name0) => {\n      let is_top_level_record_destr = match peek(tokens, pos + 1) {\n        TLBrace => _name0 == \"record\",\n        _ => false\n      }\n      if is_top_level_record_destr {\n        throw(\"top-level 'let record { .. } = <expr>' destructuring is not supported (#830); move it into a function body (e.g. 'fn main() { let record { .. } = <expr>; .. }')\")\n      }\n      let is_struct_destructure = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TLBrace => true,\n          _ => false\n        },\n        _ => false\n      }\n      if is_struct_destructure {\n        throw(\"top-level 'let Name::{ .. } = <expr>' struct destructuring is not supported (#859); move it into a function body (e.g. 'fn main() { let Name::{ x, y } = <expr>; .. }')\")\n      } else {\n        let (name, name_next) = parse_binding_name(tokens, pos)\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n          TColon => {\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n            (tparams, tbounds, Some(ty), tp)\n          },\n          _ => (_no_tp(), _no_tb(), None, name_next)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\n        let val_pair = parse_impl(tokens, starts, val_start, 0)\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n        let val_next = val_pair.1\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\n      }\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nexport fn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error } {\n  let (name, name_next) = parse_binding_name(tokens, pos)\n  let (tps, tbs, after_gen) = parse_value_bracket_header(tokens, name_next)\n  let lp = expect_tk(tokens, after_gen, \"(\")\n  let (params, after_params) = parse_param_list(tokens, lp)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let param = Array::get(params, pi)\n    let pty = param.1\n    match pty {\n      Some(_) => (),\n      None => throw(\"fn parameter '\\{param.0}' requires a type annotation\")\n    }\n    pi = pi + 1\n  }\n  let arrow = expect_tk(tokens, after_params, \"->\")\n  let (ret_ty, ret_next) = parse_type_impl(tokens, arrow, 0)\n  let (eff_opt, eff_next) = match peek(tokens, ret_next) {\n    TWith => {\n      let wb = expect_tk(tokens, ret_next + 1, \"{\")\n      let (eff_names, en) = collect_effect_names(tokens, wb, \"\")\n      (Some(eff_names), en)\n    },\n    _ => (None, ret_next)\n  }\n  let reqs = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let enss = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let where_next = match peek(tokens, eff_next) {\n    TIdent(w) => if w == \"where\" {\n      let mut wp = expect_tk(tokens, eff_next + 1, \"{\")\n      let mut wdone = false\n      while !wdone {\n        match peek(tokens, wp) {\n          TRBrace => {\n            wp = wp + 1\n            wdone = true\n          },\n          TIdent(kind) => {\n            let cp = expect_tk(tokens, wp + 1, \":\")\n            let (cond, cnext) = parse_impl(tokens, [], cp, 0)\n            if kind == \"requires\" {\n              Array::push(reqs, cond)\n            } else if kind == \"ensures\" {\n              Array::push(enss, cond)\n            } else {\n              throw(\"expected 'requires' or 'ensures' in where clause, got '\\{kind}'\")\n            }\n            wp = match peek(tokens, cnext) {\n              TComma => cnext + 1,\n              _ => cnext\n            }\n          },\n          _ => throw(\"expected 'requires', 'ensures', or '}' in where clause\")\n        }\n      }\n      wp\n    } else eff_next,\n    _ => eff_next\n  }\n  ((name, tps, tbs), (params, ret_ty, eff_opt), (reqs, enss), where_next)\n}\n\nfn parse_fn_main_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let (eff_opt, body_start) = match peek(tokens, pos + 1) {\n    TWith => {\n      let wb = expect_tk(tokens, pos + 2, \"{\")\n      let (eff_names, en) = collect_effect_names(tokens, wb, \"\")\n      (Some(eff_names), en)\n    },\n    _ => (None, pos + 1)\n  }\n  let br = expect_tk(tokens, body_start, \"{\")\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\n  (SFnDecl(exported, \"main\", EFn(_no_tp(), _no_tb(), empty_params(), Some(TyName(\"Unit\")), eff_opt, body), empty_exprs(), empty_exprs()), end)\n}\n\nfn parse_fn_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let is_main_special = match peek(tokens, pos) {\n    TIdent(n0) => if n0 == \"main\" {\n      match peek(tokens, pos + 1) {\n        TLBrace => true,\n        TWith => true,\n        _ => false\n      }\n    } else {\n      false\n    },\n    _ => false\n  }\n  if is_main_special {\n    parse_fn_main_stmt(tokens, starts, pos, exported)\n  } else {\n    parse_fn_stmt_general(tokens, starts, pos, exported)\n  }\n}\n\nfn parse_fn_wasm_body(tokens: Array[Token], pos: Int, exported: Bool, name: String, tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String], reqs: Array[Expr], enss: Array[Expr]) -> (Stmt, Int) with { Error } {\n  if Array::length(tps) > 0 {\n    throw(\"inline wasm fn '\\{name}' cannot take type parameters (v0.3: monomorphic only) at #\\{pos}\")\n  } else {\n    ()\n  }\n  match eff_opt {\n    Some(_) => throw(\"inline wasm fn '\\{name}' must have an empty effect row (remove the 'with { ... }' clause) at #\\{pos}\"),\n    None => ()\n  }\n  if Array::length(reqs) > 0 || Array::length(enss) > 0 {\n    throw(\"inline wasm fn '\\{name}' cannot declare where-contracts at #\\{pos}\")\n  } else {\n    ()\n  }\n  let mut wi = 0\n  while wi < Array::length(params) {\n    let (pn, pt) = Array::get(params, wi)\n    let ok = match pt {\n      Some(TyName(tn)) => tn == \"Int\",\n      _ => false\n    }\n    if !ok {\n      throw(\"inline wasm fn '\\{name}': param '\\{pn}' must be typed Int (v0.3 slice: raw tagged i64 params only) at #\\{pos}\")\n    } else {\n      ()\n    }\n    wi = wi + 1\n  }\n  let ret_ok = match ret_ty {\n    TyName(rn) => rn == \"Int\",\n    _ => false\n  }\n  if !ret_ok {\n    throw(\"inline wasm fn '\\{name}': return type must be Int (v0.3 slice: raw tagged i64 result only) at #\\{pos}\")\n  } else {\n    ()\n  }\n  match peek(tokens, pos) {\n    TString(first) => {\n      let mut text = first\n      let mut sp = pos + 1\n      let mut more = true\n      while more {\n        match peek(tokens, sp) {\n          TString(nxt) => {\n            text = String::concat(text, String::concat(\"\\n\", nxt))\n            sp = sp + 1\n          },\n          _ => {\n            more = false\n          }\n        }\n      }\n      let marker = ECall(EIdent(\"%wasm\", -1), [\n        EString(text)\n      ], -1);\n      (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), None, marker), reqs, enss), sp)\n    },\n    _ => throw(\"expected WAT string literal after '= wasm' in fn '\\{name}' at #\\{pos}\")\n  }\n}\n\nfn parse_fn_stmt_general(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let (head, sig, contracts, where_next) = parse_fn_signature(tokens, pos)\n  let (name, tps, tbs) = head\n  let (params, ret_ty, eff_opt) = sig\n  let (reqs, enss) = contracts\n  let is_wasm_body = match peek(tokens, where_next) {\n    TEq => match peek(tokens, where_next + 1) {\n      TIdent(kw) => kw == \"wasm\",\n      _ => false\n    },\n    _ => false\n  }\n  if is_wasm_body {\n    parse_fn_wasm_body(tokens, where_next + 2, exported, name, tps, tbs, params, ret_ty, eff_opt, reqs, enss)\n  } else {\n  let br = expect_tk(tokens, where_next, \"{\")\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\n  (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), eff_opt, body), reqs, enss), end)\n  }\n}\n\nexport fn lower_fn_decl_stmt(stmt: Stmt) -> Stmt {\n  match stmt {\n    SFnDecl(exported, name, fn_value, reqs, enss) => match fn_value {\n      EFn(tps, tbs, params, ret_opt, eff_opt, body) => {\n        let body_with_ensures = if Array::length(enss) == 0 {\n          body\n        } else {\n          let mut exit_expr = EIdent(\"result\", 0 - 1)\n          let mut ei = Array::length(enss)\n          while ei > 0 {\n            ei = ei - 1\n            exit_expr = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n              Array::get(enss, ei)\n            ], 0 - 1), exit_expr)\n          }\n          ELet(\"result\", body, exit_expr, -1)\n        }\n        let mut guarded = body_with_ensures\n        let mut qi = Array::length(reqs)\n        while qi > 0 {\n          qi = qi - 1\n          guarded = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n            Array::get(reqs, qi)\n          ], 0 - 1), guarded)\n        }\n        SLet(exported, true, name, None, EFn(tps, tbs, params, ret_opt, eff_opt, guarded))\n      },\n      _ => SLet(exported, true, name, None, fn_value)\n    },\n    _ => stmt\n  }\n}\n\nexport fn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\n  for s in stmts {\n    lower_fn_decl_stmt(s)\n  }\n}\n\n\nexport {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, lower_fn_decl_stmt, lower_fn_decl_stmts, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_fn_stmt, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\n}\n\nexport {\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_fn_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch, lower_fn_decl_stmt, lower_fn_decl_stmts\n}\n")
}

let source_12 = () -> (String, String) {
  ("lib/@vibe/parser/parser.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\n\n\n\n\nlet parser_mode_block = 20\n\nfn empty_names() -> Array[String] {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nfn parse_test_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nfn parse_bench_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nfn parse_export_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) =>\n          (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name in export list\")\n  }\n}\n\nfn parse_export_names_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(_) => {\n        let (nm, after) = parse_export_name(tokens, pos + 1)\n        ArrayBuilder::push(b, nm)\n        parse_export_names_rest(tokens, after, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nfn parse_import_items_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nfn parse_import_items(tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nfn qualify_import_items(mod_name: String, items: Array[(String, Option[String])]) -> Array[(String, Option[String])] {\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < Array::length(items) {\n    let (name, alias_opt) = Array::get(items, i)\n    let local = match alias_opt {\n      Some(alias) => alias,\n      None => name\n    }\n    ArrayBuilder::push(b, (name, Some(String::concat(mod_name, String::concat(\".\", local)))))\n    i = i + 1\n  }\n  ArrayBuilder::freeze(b)\n}\n\nfn parse_qualified_import_tail(tokens: Array[Token], pos: Int, path: String, mod_name: String) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(only_kw) => if only_kw == \"only\" {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, qualify_import_items(mod_name, items)), end)\n    } else {\n      throw(\"expected 'only' after 'as <name>' in qualified import\")\n    },\n    _ => throw(\"expected 'only' after 'as <name>' in qualified import\")\n  }\n}\n\nfn reject_executable_import_path(path: String) -> Unit with { Error } {\n  if String::ends_with(path, \".vibex\") {\n    throw(\".vibex is an executable root and cannot be imported: \\{path}\")\n  } else {\n    ()\n  }\n}\n\nfn parse_import_path_tail(tokens: Array[Token], bp: Int, path: String) -> (Stmt, Int) with { Error } {\n  match peek(tokens, bp) {\n    TAs => match peek(tokens, bp + 1) {\n      TIdent(mod_name) => parse_qualified_import_tail(tokens, bp + 2, path, mod_name),\n      _ => throw(\"expected namespace name after 'as' in import\")\n    },\n    TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\n      let alias_str = String::substring(alias_name, 1, String::length(alias_name))\n      (SAliasDecl(alias_str, path), bp + 1)\n    } else {\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    },\n    _ => {\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    }\n  }\n}\n\nfn parse_import_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\n      parse_import_path_tail(tokens, pos + 1, name)\n    } else {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      reject_executable_import_path(path)\n      parse_import_path_tail(tokens, bp, path)\n    },\n    _ => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      reject_executable_import_path(path)\n      parse_import_path_tail(tokens, bp, path)\n    }\n  }\n}\n\nfn tl_push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nfn parse_toplevel_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        tl_push_mut_name(mb, field, is_mut)\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => throw(\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\{pos}\"),\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';' or '}' in struct at #\\{pos}\")\n  }\n}\n\nfn parse_toplevel_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      tl_push_mut_name(mb, first, is_mut)\n      parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nfn parse_toplevel_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nfn parse_effectset_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let (name, after_name) = parse_binding_name(tokens, pos)\n  let ep = expect_tk(tokens, after_name, \"=\")\n  let bp = expect_tk(tokens, ep, \"{\")\n  let (joined, next) = collect_effect_names(tokens, bp, \"\")\n  let members = if String::length(joined) == 0 {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    String::split(joined, \", \")\n  }\n  (SEffectSet(exported, name, members), next)\n}\n\nfn parse_export_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\n    TIdent(ident_name) => if ident_name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, true)\n    } else if ident_name == \"effectset\" {\n      parse_effectset_stmt(tokens, pos + 1, true)\n    } else if ident_name == \"fn\" {\n      parse_fn_stmt(tokens, starts, pos + 1, true)\n    } else {\n      throw(String::concat(\"unexpected token in export: \", ident_name))\n    },\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(_) => {\n        let (first, after) = parse_export_name(tokens, pos + 1)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, first)\n        let (names, end) = parse_export_names_rest(tokens, after, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      reject_executable_import_path(path)\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    TDotDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      reject_executable_import_path(path)\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected after 'export': \\{actual}\")\n    }\n  }\n}\n\nfn parse_percent_symbol_name(tokens: Array[Token], pos: Int, label: String) -> (String, Int) with { Error } {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nfn parse_extern_let_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type(tokens, cp);\n  (SExternLet(name, ty), end)\n}\n\nexport fn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n      _ => parse_export_stmt(tokens, starts, pos + 1)\n    },\n    TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, starts, pos + 1),\n    TBench => parse_bench_stmt(tokens, starts, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => match name {\n      \"effect\" => parse_effect_stmt(tokens, pos + 1, false),\n      \"effectset\" => parse_effectset_stmt(tokens, pos + 1, false),\n      \"extern\" => parse_extern_let_stmt(tokens, pos + 1),\n      \"fn\" => parse_fn_stmt(tokens, starts, pos + 1, false),\n      \"use\" => throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\"),\n      _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0)\n      match peek(tokens, next) {\n        TEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssign(name, val, EUnit)), vn)\n          },\n          ECall(idx_callee, idx_args, _) => {\n            let is_index = match idx_callee {\n              EIdent(icn, _) => icn == \"__index\",\n              _ => false\n            }\n            if is_index && Array::length(idx_args) == 2 {\n              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n              let set_args = Array::slice([\n                EUnit\n              ], 0, 0)\n              Array::push(set_args, Array::get(idx_args, 0))\n              Array::push(set_args, Array::get(idx_args, 1))\n              Array::push(set_args, val)\n              (SExpr(ECall(EIdent(\"Array::set\", -1), set_args, -1)), vn)\n            } else {\n              (SExpr(e), next)\n            }\n          },\n          _ => (SExpr(e), next)\n        },\n        TPlusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"+\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TMinusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"-\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TStarEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"*\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TSlashEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"/\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        _ => (SExpr(e), next)\n      }\n      }\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport fn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\n  let (stmt, next) = parse_stmt_preserving(tokens, starts, pos)\n  (lower_fn_decl_stmt(stmt), next)\n}\n\nfn parse_impl_methods(tokens: Array[Token], pos: Int, simpl: Stmt) -> (Array[Stmt], Int) with { Error } {\n  let out = ArrayBuilder::new()\n  ArrayBuilder::push(out, simpl)\n  match peek(tokens, pos) {\n    TLBrace => {\n      let type_name = match simpl {\n        SImpl(_, _, _, tn) => tn,\n        _ => \"\"\n      }\n      let impl_tparams = match simpl {\n        SImpl(tp, _, _, _) => tp,\n        _ => Array::slice([\n          \"\"\n        ], 0, 0)\n      }\n      let impl_tbounds = match simpl {\n        SImpl(_, tb, _, _) => tb,\n        _ => Array::slice([\n          (\"\", Array::slice([\n            \"\"\n          ], 0, 0))\n        ], 0, 0)\n      }\n      let mut p = pos + 1\n      let mut done = false\n      while !done {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            done = true\n          },\n          TIdent(mname) => {\n            let (efn, p2) = parse_expr(tokens, p + 1)\n            let efn2 = if Array::length(impl_tparams) > 0 {\n              match efn {\n                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),\n                _ => efn\n              }\n            } else {\n              efn\n            }\n            let qname = String::concat(type_name, String::concat(\"::\", mname))\n            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))\n            p = match peek(tokens, p2) {\n              TSemicolon => p2 + 1,\n              _ => p2\n            }\n          },\n          _ => throw(\"expected impl method name or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(out), p)\n    },\n    _ => (ArrayBuilder::freeze(out), pos)\n  }\n}\n\n\nfn parse_cfg_directive(tokens: Array[Token], pos: Int) -> (String, String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(dname) => {\n      if dname == \"cfg\" || dname == \"cfg_enable\" {\n        match peek(tokens, pos + 1) {\n          TLParen => match peek(tokens, pos + 2) {\n            TIdent(flag) => match peek(tokens, pos + 3) {\n              TRParen => (dname, flag, pos + 4),\n              _ => throw(\"expected ')' after #cfg flag name\")\n            },\n            _ => throw(\"expected flag name in #cfg(...)\")\n          },\n          _ => throw(\"expected '(' after #cfg\")\n        }\n      } else {\n        throw(String::concat(\"unknown # directive: \", dname))\n      }\n    },\n    _ => throw(\"expected directive name after '#'\")\n  }\n}\n\nfn cfg_scan_enabled(tokens: Array[Token]) -> Array[String] with { Error } {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  let n = Array::length(tokens)\n  while i < n {\n    match Array::get(tokens, i) {\n      THash => {\n        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)\n        if dname == \"cfg_enable\" {\n          Array::push(out, flag)\n        } else {\n          ()\n        }\n        i = next\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  out\n}\n\nfn cfg_flag_active(active: Array[String], flag: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(active) {\n    if Array::get(active, i) == flag {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          pos = dnext\n        } else {\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt_preserving(tokens, [], dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      TImpl => {\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)\n        let mut ii = 0\n        while ii < Array::length(impl_stmts) {\n          ArrayBuilder::push(b, Array::get(impl_stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt_preserving(tokens, [], pos)\n        ArrayBuilder::push(b, stmt)\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\nexport fn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  lower_fn_decl_stmts(parse_program_preserving(tokens))\n}\n\nfn extract_err_token_pos(msg: String, fallback_pos: Int) -> (Int, String) {\n  let mi = String::index_of(msg, \" at #\")\n  if mi < 0 {\n    (fallback_pos, msg)\n  } else {\n    let mlen = String::length(msg)\n    let mut di = mi + 5\n    let mut n = 0\n    let mut any = false\n    let mut scanning = true\n    while scanning {\n      if di < mlen {\n        let ch = String::char_code_at(msg, di)\n        if ch >= 48 && ch <= 57 {\n          n = n * 10 + (ch - 48)\n          any = true\n          di = di + 1\n        } else {\n          scanning = false\n        }\n      } else {\n        scanning = false\n      }\n    }\n    if !any {\n      (fallback_pos, msg)\n    } else {\n      let head = String::substring(msg, 0, mi)\n      let tail = String::substring(msg, di, mlen)\n      let joined = String::concat(head, tail)\n      let pi = String::index_of(joined, \" (prev=\")\n      let cleaned = if pi >= 0 {\n        String::substring(joined, 0, pi)\n      } else {\n        joined\n      }\n      (n, cleaned)\n    }\n  }\n}\n\nexport fn parse_program_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with { Error } {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          pos = dnext\n        } else {\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let (stmts, next) = handle {\n          match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n        } with Error {\n          Throw(msg) => {\n            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)\n            let anchor_pos = if err_pos < Array::length(starts) {\n              err_pos\n            } else {\n              start_pos\n            }\n            let off = if anchor_pos < Array::length(starts) {\n              Array::get(starts, anchor_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            throw(String::concat(loc, cleaned_msg))\n          }\n        }\n        let mut ii = 0\n        while ii < Array::length(stmts) {\n          ArrayBuilder::push(b, Array::get(stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\nfn is_recovery_point(t: Token) -> Bool {\n  match t {\n    TLet => true,\n    TExport => true,\n    TModule => true,\n    TEnum => true,\n    TSuberror => true,\n    TStruct => true,\n    TType => true,\n    TTrait => true,\n    TTest => true,\n    TBench => true,\n    TImport => true,\n    TImpl => true,\n    TDeclare => true,\n    TOpen => true,\n    TSemicolon => true,\n    TEof => true,\n    _ => false\n  }\n}\n\nexport fn parse_program_recovering(tokens: Array[Token], starts: Array[Int], source: String) -> (Array[Stmt], Array[String]) with { Error } {\n  let cfg_active = handle {\n    cfg_scan_enabled(tokens)\n  } with Error {\n    Throw(_) => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let b = ArrayBuilder::new()\n  let diags = ArrayBuilder::new()\n  let n = Array::length(tokens)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let cfg_res = handle {\n          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n          if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n            dnext\n          } else {\n            match peek(tokens, dnext) {\n              TImpl => {\n                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n                dn\n              },\n              _ => {\n                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n                dn\n              }\n            }\n          }\n        } with Error {\n          Throw(_) => 0 - 1\n        }\n        if cfg_res >= 0 {\n          pos = cfg_res\n        } else {\n          let mut rp = pos + 1\n          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {\n            rp = rp + 1\n          }\n          pos = rp\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let res = handle {\n          let (stmts, next) = match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n          Some((stmts, next))\n        } with Error {\n          Throw(msg) => {\n            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)\n            let anchor_pos = if err_pos >= start_pos && err_pos < Array::length(starts) {\n              err_pos\n            } else {\n              start_pos\n            }\n            let off = if anchor_pos < Array::length(starts) {\n              Array::get(starts, anchor_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            ArrayBuilder::push(diags, String::concat(loc, cleaned_msg))\n            let resync_pos = if anchor_pos > start_pos && is_recovery_point(peek(tokens, anchor_pos)) {\n              anchor_pos\n            } else {\n              let mut rp = anchor_pos + 1\n              let mut sync = false\n              while !sync {\n                if rp >= n {\n                  sync = true\n                } else {\n                  let t = peek(tokens, rp)\n                  if is_recovery_point(t) {\n                    sync = true\n                  } else {\n                    rp = rp + 1\n                  }\n                }\n              }\n              rp\n            }\n            Some((Array::slice([\n              SExport(empty_names())\n            ], 0, 0), resync_pos))\n          }\n        }\n        match res {\n          Some((stmts, next)) => {\n            let mut ii = 0\n            while ii < Array::length(stmts) {\n              ArrayBuilder::push(b, Array::get(stmts, ii))\n              ii = ii + 1\n            }\n            pos = next\n          },\n          None => {\n            pos = start_pos + 1\n          }\n        }\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))\n}\n\nexport fn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } {\n  let b = ArrayBuilder::new()\n  let span_start = ArrayBuilder::new()\n  let span_end = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        throw(\"#cfg directives are not supported in module-source emission\")\n      },\n      TImpl => {\n        let st = Array::get(starts, pos)\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let next = skip_braced_body(tokens, hp)\n        ArrayBuilder::push(b, simpl)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      },\n      _ => {\n        let st = Array::get(starts, pos)\n        let (stmt, next) = parse_stmt(tokens, starts, pos)\n        ArrayBuilder::push(b, stmt)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))\n}\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_stmt_preserving, parse_type, parse_program, parse_program_preserving\n}\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_stmt_preserving, parse_type, parse_program, parse_program_preserving\n}\n")
}

let source_13 = () -> (String, String) {
  ("lib/@vibe/parser/expand_interp.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\n\n\n\nfn resolve_expr(e: Expr) -> Expr with { Error } {\n  let desugar_parts: (Array[String]) -> Expr with { Error } = (parts) -> {\n    let plen = Array::length(parts)\n    let exprs = ArrayBuilder::new()\n    let mut i = 0\n    while i < plen {\n      let lit = Array::get(parts, i)\n      if String::length(lit) > 0 {\n        ArrayBuilder::push(exprs, EString(lit))\n      }\n      if i + 1 < plen {\n        let expr_src = Array::get(parts, i + 1)\n        let expr_tokens = lex(expr_src)\n        let parsed = parse(expr_tokens)\n        let resolved = resolve_expr(parsed)\n        ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n          resolved\n        ], -1))\n      }\n      i = i + 2\n    }\n    let result_arr = ArrayBuilder::freeze(exprs)\n    let result_len = Array::length(result_arr)\n    if result_len == 0 {\n      EString(\"\")\n    } else {\n      let mut result = Array::get(result_arr, 0)\n      let mut j = 1\n      while j < result_len {\n        result = ECall(EIdent(\"String::concat\", -1), [\n          result,\n          Array::get(result_arr, j)\n        ], -1)\n        j = j + 1\n      }\n      result\n    }\n  }\n  let resolve_arr: (Array[Expr]) -> Array[Expr] with { Error } = (exprs) -> {\n    for ex in exprs {\n      resolve_expr(ex)\n    }\n  }\n  match e {\n    EStringInterp(parts) => desugar_parts(parts),\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EUnit => e,\n    EIdent(_, _) => e,\n    ETuple(elems) => ETuple(resolve_arr(elems)),\n    EArray(elems) => EArray(resolve_arr(elems)),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }, targs),\n    EMap(fields) => EMap(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\n    ELet(n, v, b, soff) => ELet(n, resolve_expr(v), resolve_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, resolve_expr(v), resolve_expr(b), soff),\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_expr(init))\n    }, resolve_expr(body)),\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\n    ECall(callee, args, off) => ECall(resolve_expr(callee), resolve_arr(args), off),\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\n    EDot(inner, field, off, fdoff) => EDot(resolve_expr(inner), field, off, fdoff),\n    EReturn(inner) => EReturn(resolve_expr(inner)),\n    EBreak(opt) => match opt {\n      None => e,\n      Some(v) => EBreak(Some(resolve_expr(v)))\n    },\n    EContinue(args) => EContinue(resolve_arr(args)),\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\n    ESpread(inner) => ESpread(resolve_expr(inner))\n  }\n}\n\nfn resolve_stmt(s: Stmt) -> Stmt with { Error } {\n  match s {\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\n    STest(name, body) => STest(name, resolve_expr(body)),\n    SBench(name, body) => SBench(name, resolve_expr(body)),\n    SExpr(e) => SExpr(resolve_expr(e)),\n    _ => s\n  }\n}\n\nexport fn resolve_interp_expr(e: Expr) -> Expr with { Error } {\n  resolve_expr(e)\n}\n\nexport fn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error } {\n  for s in stmts {\n    resolve_stmt(s)\n  }\n}\n")
}

let source_14 = () -> (String, String) {
  ("lib/@vibe/parser/printer.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\n\n\nfn join(arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = ArrayBuilder::new()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        ArrayBuilder::push(b, sep)\n      }\n      ArrayBuilder::push(b, Array::get(arr, i))\n      i = i + 1\n    }\n    String::join(ArrayBuilder::freeze(b), \"\")\n  }\n}\n\nfn is_keyword_name(name: String) -> Bool {\n  name == \"fn\" || name == \"if\" || name == \"in\" || name == \"is\" || name == \"do\" ||\n  name == \"as\" || name == \"let\" || name == \"rec\" || name == \"mut\" || name == \"for\" ||\n  name == \"else\" || name == \"enum\" || name == \"true\" || name == \"type\" || name == \"test\" ||\n  name == \"with\" || name == \"loop\" || name == \"open\" || name == \"impl\" || name == \"false\" ||\n  name == \"match\" || name == \"trait\" || name == \"throw\" || name == \"while\" || name == \"break\" ||\n  name == \"bench\" || name == \"raise\" || name == \"yield\" || name == \"struct\" || name == \"export\" ||\n  name == \"return\" || name == \"handle\" || name == \"module\" || name == \"derive\" || name == \"import\" ||\n  name == \"declare\" || name == \"continue\" || name == \"suberror\"\n}\n\nfn print_name(name: String) -> String {\n  if is_keyword_name(name) {\n    String::concat(\"r#\", name)\n  } else name\n}\n\nfn escape_string(s: String) -> String {\n  let len = String::length(s)\n  let b = ArrayBuilder::new()\n  let push_chunk: (Int, Int) -> Unit = (start, end) -> {\n    if end > start {\n      ArrayBuilder::push(b, s[start: end])\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nexport fn print_pat(p: Pat) -> String {\n  match p {\n    PWild => \"_\",\n    PBind(name) => print_name(name),\n    PInt(n) => __to_string(n),\n    PFloat(v) => {\n      let fs = double_to_string_compiler(v)\n      if String::contains(fs, \".\") || fs == \"nan\" {\n        fs\n      } else {\n        String::concat(fs, \".0\")\n      }\n    },\n    PString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => String::concat(print_pat(left), String::concat(\" | \", print_pat(right))),\n    PStruct(name, _) => String::concat(name, \"::{...}\")\n  }\n}\n\nfn handle_effect_name_from_ctor(name: String) -> Option[String] {\n  let idx = String::last_index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    Some(name[0: idx])\n  }\n}\n\nfn infer_handle_effect_name_from_pat(pat: Pat) -> Option[String] {\n  match pat {\n    PCtor(name, _) => handle_effect_name_from_ctor(name),\n    POr(left, right) => match infer_handle_effect_name_from_pat(left) {\n      Some(name) => Some(name),\n      None => infer_handle_effect_name_from_pat(right)\n    },\n    _ => None\n  }\n}\n\nfn infer_handle_effect_name(arms: Array[(Pat, Expr)]) -> String {\n  let mut i = 0\n  let mut effect_name = \"Error\"\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (pat, _) = Array::get(arms, i)\n    match infer_handle_effect_name_from_pat(pat) {\n      Some(name) => {\n        effect_name = name\n        found = true\n      },\n      None => {\n        i = i + 1\n      }\n    }\n  }\n  effect_name\n}\n\nfn strip_handle_effect_ctor(effect_name: String, ctor_name: String) -> String {\n  let prefix = String::concat(effect_name, \"::\")\n  if String::starts_with(ctor_name, prefix) {\n    let prefix_len = String::length(prefix)\n    let ctor_len = String::length(ctor_name)\n    ctor_name[prefix_len: ctor_len]\n  } else {\n    ctor_name\n  }\n}\n\nfn print_handle_pat(effect_name: String, pat: Pat) -> String {\n  match pat {\n    PCtor(name, args) => {\n      let short_name = strip_handle_effect_ctor(effect_name, name)\n      if Array::length(args) == 0 {\n        short_name\n      } else {\n        let parts = for arg in args {\n          print_pat(arg)\n        }\n        String::concat(short_name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n      }\n    },\n    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(\" | \", print_handle_pat(effect_name, right))),\n    _ => print_pat(pat)\n  }\n}\n\nfn map_to_strings(exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport fn print_type_expr(ty: TypeExpr) -> String {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      String::concat(name, String::concat(\"[\", String::concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret, effect_name) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      let base = String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", print_type_expr(ret))))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with { \", String::concat(name, \" }\"))),\n        None => base\n      }\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nfn print_ctor(name: String, args: Array[TypeExpr]) -> String {\n  if Array::length(args) == 0 {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n  }\n}\n\nfn print_fn_type_params(type_params: Array[String], bounds: Array[(String, Array[String])]) -> String {\n  if Array::length(type_params) == 0 {\n    \"\"\n  } else {\n    let parts = for tp in type_params {\n      let mut found = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bi = 0\n      while bi < Array::length(bounds) {\n        let (bname, blist) = Array::get(bounds, bi)\n        if bname == tp {\n          found = blist\n        }\n        bi = bi + 1\n      }\n      if Array::length(found) == 0 {\n        tp\n      } else {\n        String::concat(tp, String::concat(\": \", join(found, \" + \")))\n      }\n    }\n    String::concat(\"[\", String::concat(join(parts, \", \"), \"]\"))\n  }\n}\n\nexport fn print_expr(e: Expr) -> String {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => {\n      let s = double_to_string_compiler(n)\n      if String::contains(s, \".\") || s == \"nan\" {\n        s\n      } else {\n        String::concat(s, \".0\")\n      }\n    },\n    EString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name, _) => print_name(name),\n    EUnit => \"()\",\n    ETuple(elems) => String::concat(\"(\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => String::concat(\"[\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(rn, fields, targs) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        String::concat(name, String::concat(\": \", print_expr(val)))\n      }\n      let head = if Array::length(targs) > 0 {\n        String::concat(rn, String::concat(\"[\", String::concat(join(for ta in targs {\n          print_type_expr(ta)\n        }, \", \"), \"]\")))\n      } else {\n        rn\n      }\n      let prefix = if rn == \"\" {\n        \"record { \"\n      } else String::concat(head, \"::{ \")\n      String::concat(prefix, String::concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), \" }\")))),\n      _ => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), String::concat(\" } else { \", String::concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body, _) => String::concat(\"{ let \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => String::concat(\"{ let rec \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body, _) => String::concat(\"{ let mut \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" \", String::concat(op, String::concat(\"= \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => String::concat(\"{ \", String::concat(print_expr(a), String::concat(\"; \", String::concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"match \", String::concat(print_expr(scrutinee), String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let effect_name = infer_handle_effect_name(arms)\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_handle_pat(effect_name, pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"handle { \", String::concat(print_expr(body), String::concat(\" } with \", String::concat(effect_name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\"))))))\n    },\n    EWhile(cond, body) => String::concat(\"while \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(body), \" }\")))),\n    ELoop(params, body) => {\n      let parts = for param in params {\n        let (name, init) = param\n        String::concat(print_name(name), String::concat(\" = \", print_expr(init)))\n      }\n      String::concat(\"loop (\", String::concat(join(parts, \", \"), String::concat(\") { \", String::concat(print_expr(body), \" }\"))))\n    },\n    EForIn(value_name, index_name, iterable, body) => {\n      let binding = match index_name {\n        Some(index_name) => String::concat(print_name(index_name), String::concat(\", \", print_name(value_name))),\n        None => print_name(value_name)\n      }\n      String::concat(\"for \", String::concat(binding, String::concat(\" in \", String::concat(print_expr(iterable), String::concat(\" { \", String::concat(print_expr(body), \" }\"))))))\n    },\n    ECall(callee, args, _) => match callee {\n      EIdent(\"perform\", _) => if Array::length(args) == 1 {\n        let resugar = match Array::get(args, 0) {\n          ECall(op_callee, op_args, _) => match op_callee {\n            EIdent(op_name, _) => if op_name == \"Error::Throw\" && Array::length(op_args) == 1 {\n              Some(Array::get(op_args, 0))\n            } else {\n              None\n            },\n            _ => None\n          },\n          _ => None\n        }\n        match resugar {\n          Some(payload) => String::concat(\"throw(\", String::concat(print_expr(payload), \")\")),\n          None => String::concat(\"perform \", print_expr(Array::get(args, 0)))\n        }\n      } else {\n        String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n      },\n      EFn(_, _, _, _, _, _) => String::concat(\"(\", String::concat(print_expr(callee), String::concat(\")(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))),\n      _ => String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n    },\n    EBinOp(op, left, right) => String::concat(\"(\", String::concat(print_expr(left), String::concat(\" \", String::concat(op, String::concat(\" \", String::concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => String::concat(\"(\", String::concat(op, String::concat(print_expr(expr), \")\"))),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => {\n      let tp_str = print_fn_type_params(type_params, bounds)\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => String::concat(print_name(name), String::concat(\": \", print_type_expr(ty))),\n          None => print_name(name)\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with { \", String::concat(e, \" }\")),\n            None => \"\"\n          }\n          String::concat(\") -> \", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\" { \", String::concat(print_expr(body), \" }\")))))\n        },\n        None => String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n      }\n      String::concat(tp_str, String::concat(\"(\", String::concat(join(parts, \", \"), ret_str)))\n    },\n    EDot(expr, field, _, _) => String::concat(print_expr(expr), String::concat(\".\", field)),\n    EReturn(e) => String::concat(\"return \", print_expr(e)),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => String::concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if Array::length(args) == 0 {\n      \"continue\"\n    } else String::concat(\"continue(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\"=\", print_expr(val))),\n    EMap(fields) => if Array::length(fields) == 0 {\n      \"Map::new()\"\n    } else {\n      let parts = for field in fields {\n        let (k, v) = field\n        String::concat(\"(\\\"\", String::concat(escape_string(k), String::concat(\"\\\", \", String::concat(print_expr(v), \")\"))))\n      }\n      String::concat(\"Map::from_pairs([\", String::concat(join(parts, \", \"), \"])\"))\n    },\n    ESpread(inner) => String::concat(\"...\", print_expr(inner)),\n    EStringInterp(parts) => String::concat(\"\\\"\", String::concat(join(parts, \"\"), \"\\\"\"))\n  }\n}\n\nfn print_annotated_let_value(ty_opt: Option[TypeExpr], val: Expr) -> String {\n  match ty_opt {\n    Some(TyFn(_, _, _)) => match val {\n      EFn(type_params, bounds, params, _, _, body) => {\n        let tp_str = print_fn_type_params(type_params, bounds)\n        let parts = for param in params {\n          let (name, _) = param\n          print_name(name)\n        }\n        String::concat(\n          tp_str,\n          String::concat(\n            \"(\",\n            String::concat(\n              join(parts, \", \"),\n              String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n            )\n          )\n        )\n      },\n      _ => print_expr(val)\n    },\n    _ => print_expr(val)\n  }\n}\n\nfn print_ctor_list(ctors: Array[(String, Array[TypeExpr])]) -> String {\n  let parts = for ctor in ctors {\n    let (name, args) = ctor\n    print_ctor(name, args)\n  }\n  join(parts, \"; \")\n}\n\nexport fn print_stmt(s: Stmt) -> String {\n  let prefix: (Bool) -> String = (exported) -> {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(p, String::concat(r, String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_annotated_let_value(ty_opt, val))))))\n    },\n    SFnDecl(exported, name, fn_value, reqs, enss) => {\n      let p = prefix(exported)\n      match fn_value {\n        EFn(type_params, bounds, params, ret_ty, effect, body) => {\n          let tp_str = print_fn_type_params(type_params, bounds)\n          let parts = for param in params {\n            let (pn, ty_opt) = param\n            match ty_opt {\n              Some(ty) => String::concat(print_name(pn), String::concat(\": \", print_type_expr(ty))),\n              None => print_name(pn)\n            }\n          }\n          let ret_str = match ret_ty {\n            Some(rt) => print_type_expr(rt),\n            None => \"()\"\n          }\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with { \", String::concat(e, \" }\")),\n            None => \"\"\n          }\n          let where_str = if Array::length(reqs) == 0 && Array::length(enss) == 0 {\n            \"\"\n          } else {\n            let conds = ArrayBuilder::new()\n            let mut qi = 0\n            while qi < Array::length(reqs) {\n              ArrayBuilder::push(conds, String::concat(\"requires: \", print_expr(Array::get(reqs, qi))))\n              qi = qi + 1\n            }\n            let mut ei = 0\n            while ei < Array::length(enss) {\n              ArrayBuilder::push(conds, String::concat(\"ensures: \", print_expr(Array::get(enss, ei))))\n              ei = ei + 1\n            }\n            String::concat(\" where { \", String::concat(join(ArrayBuilder::freeze(conds), \", \"), \" }\"))\n          }\n          let head = String::concat(p, String::concat(\"fn \", String::concat(print_name(name), tp_str)))\n          let sig = String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", String::concat(ret_str, String::concat(eff_str, where_str)))))\n          let wasm_text = match body {\n            ECall(wcal, wargs, _) => match wcal {\n              EIdent(wname, _) => if wname == \"%wasm\" && Array::length(wargs) == 1 {\n                match Array::get(wargs, 0) {\n                  EString(wt) => Some(wt),\n                  _ => None\n                }\n              } else {\n                None\n              },\n              _ => None\n            },\n            _ => None\n          }\n          match wasm_text {\n            Some(wt) => String::concat(head, String::concat(sig, String::concat(\" = wasm \\\"\", String::concat(escape_string(wt), \"\\\"\")))),\n            None => String::concat(head, String::concat(sig, String::concat(\" { \", String::concat(print_expr(body), \" }\"))))\n          }\n        },\n        _ => String::concat(p, String::concat(\"let rec \", String::concat(print_name(name), String::concat(\" = \", print_expr(fn_value)))))\n      }\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(\"let mut \", String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, params, ctors, derives) => {\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"enum \", String::concat(name, String::concat(tp, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\"))))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if Array::length(ctors) == 1 {\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\n        if ctor_name == name {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))))\n        }\n        else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n      } else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields, derives, mut_names, tparams) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        let mut is_mut = false\n        let mut mi = 0\n        while mi < Array::length(mut_names) {\n          if Array::get(mut_names, mi) == fn1 {\n            is_mut = true\n          }\n          mi = mi + 1\n        }\n        let mp = if is_mut {\n          \"mut \"\n        } else {\n          \"\"\n        }\n        String::concat(mp, String::concat(fn1, String::concat(\": \", print_type_expr(ty))))\n      }\n      let tp = if Array::length(tparams) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(tparams, \", \"), \"]\"))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"struct \", String::concat(name, String::concat(tp, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\"))))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    STypeAlias(exported, name, params, ty) => {\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      String::concat(prefix(exported), String::concat(\"type \", String::concat(name, String::concat(tp, String::concat(\" = \", print_type_expr(ty))))))\n    },\n    STrait(exported, name, supers, methods, _) => {\n      let base = String::concat(prefix(exported), String::concat(\"trait \", name))\n      let head = if Array::length(supers) == 0 {\n        base\n      }\n      else String::concat(base, String::concat(\": \", join(supers, \" + \")))\n      if Array::length(methods) == 0 {\n        head\n      } else {\n        let method_parts = for m in methods {\n          let (method_name, params, ret) = m\n          let params_str = if Array::length(params) > 0 {\n            String::concat(\"(\", String::concat(join(for pt in params {\n              print_type_expr(pt)\n            }, \", \"), \")\"))\n          } else \"\"\n          String::concat(\"  \", String::concat(method_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n        }\n        String::concat(head, String::concat(\" {\\n\", String::concat(join(method_parts, \";\\n\"), \"\\n}\")))\n      }\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let head = if Array::length(tparams) == 0 {\n        \"impl \"\n      } else {\n        String::concat(\"impl [\", String::concat(join(tparams, \", \"), \"] \"))\n      }\n      String::concat(head, String::concat(trait_name, String::concat(\" for \", type_name)))\n    },\n    SExternLet(name, ty) => String::concat(\"extern let \", String::concat(name, String::concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"import \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => String::concat(\"test \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SBench(name, body) => String::concat(\"bench \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => String::concat(\"export { \", String::concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"export \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    SAliasDecl(alias_name, source_path) => String::concat(\"import \", String::concat(source_path, String::concat(\" @\", alias_name))),\n    SLetPat(pat, expr) => String::concat(\"let \", String::concat(print_pat(pat), String::concat(\" = \", print_expr(expr)))),\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"module \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"\\n\"), \" }\")))))\n    },\n    SEffectDef(exported, name, type_params, ops) => {\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      let tp = if Array::length(type_params) > 0 {\n        String::concat(\"[\", String::concat(join(type_params, \", \"), \"]\"))\n      } else \"\"\n      let op_parts = for op in ops {\n        let (op_name, params, ret) = op\n        let params_str = if Array::length(params) > 0 {\n          String::concat(\"(\", String::concat(join(for pt in params {\n            print_type_expr(pt)\n          }, \", \"), \")\"))\n        } else \"\"\n        String::concat(\"  \", String::concat(op_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n      }\n      String::concat(p, String::concat(\"effect \", String::concat(name, String::concat(tp, String::concat(\" {\\n\", String::concat(join(op_parts, \";\\n\"), \"\\n}\"))))))\n    },\n    SEffectSet(exported, name, members) => {\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"effectset \", String::concat(name, String::concat(\" = { \", String::concat(join(members, \", \"), \" }\")))))\n    }\n  }\n}\n\nfn needs_program_separator(stmt_text: String) -> Bool {\n  if String::length(stmt_text) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(stmt_text, 0)\n    c == '(' || c == '['\n  }\n}\n\nexport fn print_program(stmts: Array[Stmt]) -> String {\n  let len = Array::length(stmts)\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < len {\n    let stmt_text = print_stmt(Array::get(stmts, i))\n    if i > 0 {\n      let sep = if needs_program_separator(stmt_text) {\n        \";\\n\"\n      } else \"\\n\"\n      ArrayBuilder::push(b, sep)\n    }\n    ArrayBuilder::push(b, stmt_text)\n    i = i + 1\n  }\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n")
}

let source_15 = () -> (String, String) {
  ("lib/@vibe/compiler/core/polyfill.vibe",
"import @vibe/core {\n  array_empty\n}\n\n\nexport fn __to_string(n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = array_empty()\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")
}

let source_16 = () -> (String, String) {
  ("lib/@vibe/compiler/core/bytebuf.vibe",
"\nexport fn bytebuf_new() -> Bytes {\n  Bytes::new()\n}\n\nexport fn bytebuf_push(buf: Bytes, byte: Int) -> Unit {\n  Bytes::push(buf, byte)\n}\n\nexport fn bytebuf_push2(buf: Bytes, b1: Int, b2: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport fn bytebuf_push3(buf: Bytes, b1: Int, b2: Int, b3: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport fn bytebuf_push9(buf: Bytes, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n\nexport fn bytebuf_length(buf: Bytes) -> Int {\n  Bytes::length(buf)\n}\n\nexport fn bytebuf_push_buf(dst: Bytes, src: Bytes) -> Unit {\n  Bytes::append(dst, src)\n}\n\nexport fn bytebuf_to_bytes(buf: Bytes) -> Bytes {\n  buf\n}\n\nexport fn leb128_encode_s32(buf: Bytes, value: Int) -> Unit {\n  if value >= (0 - 64) && value < 64 {\n    Bytes::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && (byte&64) == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && (byte&64) != 0 {\n            Bytes::push(buf, byte)\n            more = false\n          } else {\n            Bytes::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn leb128_encode_s64(buf: Bytes, value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport fn leb128_encode_u32(buf: Bytes, value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          Bytes::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport fn bytebuf_push_string(buf: Bytes, s: String) -> Unit {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport fn bytebuf_push_section(out: Bytes, section_id: Int, content: Bytes) -> Unit {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport fn bytebuf_push_opcode_s64(buf: Bytes, opcode: Int, value: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport fn bytebuf_push_opcode_u32(buf: Bytes, opcode: Int, value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, opcode)\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, opcode)\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      Bytes::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport fn bytebuf_push_vec_header(buf: Bytes, count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n\nexport fn bytebuf_push_opcode_u32_u32(buf: Bytes, opcode: Int, a: Int, b: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n")
}

let source_17 = () -> (String, String) {
  ("lib/@vibe/compiler/core/ast.vibe",
"\n")
}

let source_18 = () -> (String, String) {
  ("lib/@vibe/compiler/core/types.vibe",
"\n\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Option[String]);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[String], Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)], Array[String], Array[String]);\n  TDAlias(String, Array[String], Type);\n  TDEffect(String, Array[(String, Array[Type], Type)])\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, Array[(String, Array[TypeExpr], TypeExpr)], TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\n  EnvFlat(Array[(String, Type)]);\n  EnvCached(Array[String], Array[Type], TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst);\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst);\n  SubstEffBind(String, String, Subst)\n}\n\n\nexport fn env_bind(env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  match env {\n    EnvCached(names_sorted, types_sorted, rest) => EnvCached(names_sorted, types_sorted, EnvBind(name, ty, rest)),\n    _ => EnvBind(name, ty, env)\n  }\n}\n\nexport fn env_cache(env: TypeEnv) -> TypeEnv {\n  let is_empty = match env {\n    EnvEmpty => true,\n    _ => false\n  }\n  if is_empty {\n    EnvEmpty\n  } else {\n    let names = ArrayBuilder::new()\n    let types = ArrayBuilder::new()\n    let mut cur = env\n    let mut done = false\n    while !done {\n      match cur {\n        EnvEmpty => {\n          done = true\n        },\n        EnvBind(n, ty, rest) => {\n          ArrayBuilder::push(names, n)\n          ArrayBuilder::push(types, ty)\n          cur = rest\n        },\n        EnvTraitDef(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImpl(_, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImplGen(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvFlat(bindings) => {\n          let mut j = 0\n          while j < Array::length(bindings) {\n            let (n, ty) = Array::get(bindings, j)\n            ArrayBuilder::push(names, n)\n            ArrayBuilder::push(types, ty)\n            j = j + 1\n          }\n          done = true\n        },\n        EnvCached(_, _, rest) => {\n          cur = rest\n        }\n      }\n    }\n    let na = ArrayBuilder::freeze(names)\n    let ta = ArrayBuilder::freeze(types)\n    let perm = sort_perm_by_names(na)\n    let names_sorted = apply_perm_strings(na, perm)\n    let types_sorted = array_empty()\n    let mut i = 0\n    while i < Array::length(perm) {\n      Array::push(types_sorted, Array::get(ta, Array::get(perm, i)))\n      i = i + 1\n    }\n    EnvCached(names_sorted, types_sorted, env)\n  }\n}\n\nexport fn fresh_var(c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport fn occurs_in(id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport fn env_lookup(env: TypeEnv, name: String) -> Option[Type] {\n  let mut cur = env\n  let mut result = None\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(n, ty, rest) => if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(bindings) => {\n        let mut j = 0\n        while j < Array::length(bindings) && !done {\n          let (n, ty) = Array::get(bindings, j)\n          if n == name {\n            result = Some(ty)\n            done = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !done {\n          done = true\n        }\n      },\n      EnvCached(names_sorted, types_sorted, rest) => {\n        let slot = bsearch_leftmost(names_sorted, name)\n        if slot >= 0 {\n          result = Some(Array::get(types_sorted, slot))\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n  }\n  result\n}\n\nexport fn env_bind_all(env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while i < len {\n    let (name, ty) = Array::get(bindings, i)\n    acc = env_bind(acc, name, ty)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn find_typedef(defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _, _) => n,\n        TDStruct(n, _, _, _) => n,\n        TDAlias(n, _, _) => n,\n        TDEffect(n, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport fn subst_lookup(s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  let key = __to_string(id)\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => if i == id {\n        out = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\n        out = Some(Map::get(cache, key))\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport fn trait_supers(env: TypeEnv, name: String) -> Array[String] {\n  let empty = array_empty()\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\n    EnvFlat(_) => empty,\n    EnvCached(_, _, rest) => trait_supers(rest, name)\n  }\n}\n\nexport fn trait_method_sig(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {\n  match env {\n    EnvEmpty => None,\n    EnvBind(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      let mlen = Array::length(methods)\n      let mut i = 0\n      let mut found = None\n      while i < mlen {\n        let (mname, params, ret) = Array::get(methods, i)\n        if mname == method_name {\n          found = Some((params, ret))\n          i = mlen\n        } else {\n          i = i + 1\n        }\n      }\n      match found {\n        Some(sig) => Some(sig),\n        None => trait_method_sig(rest, trait_name, method_name)\n      }\n    } else trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImpl(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvFlat(_) => None,\n    EnvCached(_, _, rest) => trait_method_sig(rest, trait_name, method_name)\n  }\n}\n\nfn trait_target_head_name(ty: Type) -> String {\n  match ty {\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\nfn type_name_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitDef(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitImpl(tname, target, rest) => {\n      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(full, tname, \"next\") {\n        Some(_) => true,\n        None => false\n      })\n      if hit {\n        true\n      } else type_name_iterator_impl_scan(rest, full, type_name)\n    },\n    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name)\n  }\n}\n\nexport fn type_name_has_iterator_impl(env: TypeEnv, type_name: String) -> Bool {\n  type_name_iterator_impl_scan(env, env, type_name)\n}\n\nexport fn trait_method_sig_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {\n  match trait_method_sig(env, trait_name, method_name) {\n    Some(sig) => Some(sig),\n    None => {\n      let supers = trait_supers(env, trait_name)\n      let mut i = 0\n      let mut result = None\n      while i < Array::length(supers) {\n        let pending = match result {\n          None => true,\n          _ => false\n        }\n        if pending {\n          match trait_method_sig_deep(env, Array::get(supers, i), method_name) {\n            Some(sig) => {\n              result = Some(sig)\n            },\n            None => ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      result\n    }\n  }\n}\n\nexport fn subst_bounds_for(s: Subst, id: Int) -> Array[String] {\n  let out = ArrayBuilder::new()\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if bid == id {\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstCached(_, bounds_cache, rest) => {\n        let key = __to_string(id)\n        if Map::has_key(bounds_cache, key) {\n          let bounds = Map::get(bounds_cache, key)\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  ArrayBuilder::freeze(out)\n}\n\nfn array_has_int(arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if Array::get(arr, i) == val {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nfn int_array_has(arr: Array[Int], v: Int) -> Bool {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while !sdone {\n    if si >= slen {\n      sdone = true\n    } else if Array::get(arr, si) == v {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nfn is_effect_var_name(name: String) -> Bool {\n  let len = String::length(name)\n  if len == 1 {\n    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n  } else if len >= 2 {\n    String::char_code_at(name, 0) == 36\n  } else {\n    false\n  }\n}\n\nfn subst_eff_lookup(s: Subst, name: String) -> Option[String] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(v, val, rest) => if v == name {\n        out = Some(val)\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  match out {\n    Some(val) => if is_effect_var_name(val) {\n      match subst_eff_lookup(s, val) {\n        Some(v2) => Some(v2),\n        None => Some(val)\n      }\n    } else {\n      Some(val)\n    },\n    None => None\n  }\n}\n\nfn resolve_effect_opt(s: Subst, eff: Option[String]) -> Option[String] {\n  match eff {\n    None => None,\n    Some(name) => if is_effect_var_name(name) {\n      match subst_eff_lookup(s, name) {\n        Some(val) => if String::length(val) == 0 {\n          None\n        } else {\n          Some(val)\n        },\n        None => eff\n      }\n    } else {\n      eff\n    }\n  }\n}\n\nexport fn subst_apply(s: Subst, ty: Type) -> Type {\n  match ty {\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = array_empty()\n      while !done {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          },\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, effect_name) => {\n      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(items) {\n          Array::push(out, subst_apply(s, Array::get(items, i)))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(apply_params(params), subst_apply(s, ret), resolve_effect_opt(s, effect_name))\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtNamed(name, args) => CtNamed(name, for arg in args {\n      subst_apply(s, arg)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport fn trait_defined(env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => trait_defined(rest, name)\n  }\n}\n\nexport fn type_to_string(ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while vi < vlen {\n        let v = String::concat(\"?t\", __to_string(Array::get(vars, vi)))\n        let next = if vi > 0 {\n          String::concat(vacc, String::concat(\" \", v))\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      String::concat(\"forall \", String::concat(vacc, String::concat(\". \", type_to_string(body))))\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => String::concat(\"Array[\", String::concat(type_to_string(elem), \"]\")),\n    CtOption(elem) => String::concat(\"Option[\", String::concat(type_to_string(elem), \"]\")),\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(name, String::concat(\"[\", String::concat(joined, \"]\")))\n    },\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(\"(\", String::concat(joined, \")\"))\n    },\n    CtFn(params, ret, effect_name) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      let ret_text = type_to_string(ret)\n      let base = String::concat(\"(\", String::concat(joined, String::concat(\") -> \", ret_text)))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with {\", String::concat(name, \"}\"))),\n        None => base\n      }\n    }\n  }\n}\n\nfn empty_type_args() -> Array[Type] {\n  array_empty()\n}\n\nexport fn env_lookup_flat(bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport fn resolve_builtin(name: String) -> Option[Type] {\n  if name == \"Int\" || name == \"i32\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" || name == \"f64\" || name == \"Float\" || name == \"f32\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"V128\" {\n    Some(CtNamed(\"V128\", empty_type_args()))\n  }\n  else if name == \"i64\"\n  || name == \"u8\"\n  || name == \"u16\"\n  || name == \"u32\"\n  || name == \"u64\"\n  || name == \"i16\"\n  || name == \"v128\" {\n    Some(CtNamed(name, empty_type_args()))\n  }\n  else None\n}\n\nexport fn subst_add_bound(s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nfn empty_var_bounds() -> Array[(Int, Array[String])] {\n  array_empty()\n}\n\nfn int_bounds_has_id(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if pid == id {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nfn int_bounds_lookup(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= Array::length(pairs) {\n    array_empty()\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if pid == id {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nfn int_int_lookup_or(pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if k == key {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nfn collect_effect_vars_walk(t: Type, out: Array[String]) -> Int {\n  match t {\n    CtFn(params, ret, eff) => {\n      match eff {\n        Some(name) => if is_effect_var_name(name) {\n          let mut seen = false\n          let mut k = 0\n          while k < Array::length(out) {\n            if Array::get(out, k) == name {\n              seen = true\n            }\n            k = k + 1\n          }\n          if !seen {\n            Array::push(out, name)\n          }\n        },\n        None => ()\n      }\n      for p in params {\n        let _ = collect_effect_vars_walk(p, out)\n      }\n      collect_effect_vars_walk(ret, out)\n    },\n    CtArray(elem) => collect_effect_vars_walk(elem, out),\n    CtOption(elem) => collect_effect_vars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_effect_vars_walk(e, out)\n      }\n      0\n    },\n    CtNamed(_, args) => {\n      for a in args {\n        let _ = collect_effect_vars_walk(a, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_effect_vars_walk(body, out),\n    _ => 0\n  }\n}\n\nfn rename_eff_name(name: String, pairs: Array[(String, String)]) -> String {\n  let mut i = 0\n  let mut out = name\n  while i < Array::length(pairs) {\n    let (k, v) = Array::get(pairs, i)\n    if k == name {\n      out = v\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn rename_effect_vars(t: Type, pairs: Array[(String, String)]) -> Type {\n  match t {\n    CtFn(params, ret, eff) => {\n      let new_params = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(new_params, rename_effect_vars(Array::get(params, i), pairs))\n        i = i + 1\n      }\n      let new_eff = match eff {\n        Some(name) => Some(rename_eff_name(name, pairs)),\n        None => None\n      }\n      CtFn(new_params, rename_effect_vars(ret, pairs), new_eff)\n    },\n    CtArray(elem) => CtArray(rename_effect_vars(elem, pairs)),\n    CtOption(elem) => CtOption(rename_effect_vars(elem, pairs)),\n    CtTuple(elems) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, rename_effect_vars(Array::get(elems, i), pairs))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, rename_effect_vars(Array::get(args, i), pairs))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => t\n  }\n}\n\nexport fn instantiate(ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = array_empty()\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      let mut bmax_i = 0\n      while bmax_i < blen {\n        let bold = Array::get(bound_vars, bmax_i)\n        if bold >= bnc {\n          bnc = bold + 1\n        } else {\n          ()\n        }\n        bmax_i = bmax_i + 1\n      }\n      while bi < blen {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      let new_bounds = array_empty()\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      let inst_body = subst_apply(inst_s, body)\n      let eff_vars = array_empty()\n      let _ = collect_effect_vars_walk(inst_body, eff_vars)\n      let eff_pairs = array_empty()\n      let mut ev_i = 0\n      let mut ev_c = c1\n      while ev_i < Array::length(eff_vars) {\n        let ev = Array::get(eff_vars, ev_i)\n        Array::push(eff_pairs, (ev, String::concat(\"$\", __to_string(ev_c))))\n        ev_c = ev_c + 1\n        ev_i = ev_i + 1\n      }\n      let final_body = if Array::length(eff_pairs) == 0 {\n        inst_body\n      } else {\n        rename_effect_vars(inst_body, eff_pairs)\n      }\n      (final_body, ev_c, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport fn trait_is_subtrait(env: TypeEnv, sub: String, super_name: String) -> Bool {\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while !sdone {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nfn collect_tvars_walk(t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if !array_has_int(out, id, 0) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtNamed(_, args) => {\n      for a in args {\n        let _ = collect_tvars_walk(a, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport fn collect_tvars(ty: Type) -> Array[Int] {\n  let out = array_empty()\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nfn empty_env_bindings() -> Array[(String, Type)] {\n  array_empty()\n}\n\nexport fn env_flat_bindings(env: TypeEnv) -> Array[(String, Type)] {\n  match env {\n    EnvFlat(bindings) => bindings,\n    _ => {\n      let out = empty_env_bindings()\n      let mut cur = env\n      let mut done = false\n      while !done {\n        match cur {\n          EnvEmpty => {\n            done = true\n          },\n          EnvBind(name, ty, rest) => {\n            Array::push(out, (name, ty))\n            cur = rest\n          },\n          EnvTraitDef(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImpl(_, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImplGen(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvFlat(bindings) => {\n            let mut j = 0\n            while j < Array::length(bindings) {\n              Array::push(out, Array::get(bindings, j))\n              j = j + 1\n            }\n            done = true\n          },\n          EnvCached(_, _, rest) => {\n            cur = rest\n          }\n        }\n      }\n      out\n    }\n  }\n}\n\nfn string_array_equal(left: Array[String], right: Array[String]) -> Bool {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else if Array::get(left, i) != Array::get(right, i) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn option_string_equal(left: Option[String], right: Option[String]) -> Bool {\n  match left {\n    Some(left_name) => match right {\n      Some(right_name) => left_name == right_name,\n      None => false\n    },\n    None => match right {\n      Some(_) => false,\n      None => true\n    }\n  }\n}\n\nfn effect_label_list(eff: Option[String]) -> Array[String] {\n  let out = array_empty()\n  match eff {\n    None => out,\n    Some(s) => {\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        if String::length(label) > 0 {\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == label {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, label)\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\nfn effect_label_sets_equal(left: Option[String], right: Option[String]) -> Bool {\n  let ls = effect_label_list(left)\n  let rs = effect_label_list(right)\n  if Array::length(ls) != Array::length(rs) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(ls) {\n      let label = Array::get(ls, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(rs) {\n        if Array::get(rs, j) == label {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn effect_opt_is_var(eff: Option[String]) -> Bool {\n  match eff {\n    Some(name) => is_effect_var_name(name),\n    None => false\n  }\n}\n\nfn effect_names_compatible(left: Option[String], right: Option[String]) -> Bool {\n  if option_string_equal(left, right) {\n    true\n  } else if effect_opt_is_var(left) {\n    false\n  } else if effect_opt_is_var(right) {\n    false\n  } else {\n    effect_label_sets_equal(left, right)\n  }\n}\n\nfn unify_effects(ea: Option[String], eb: Option[String], s: Subst) -> Option[Subst] {\n  let ra = resolve_effect_opt(s, ea)\n  let rb = resolve_effect_opt(s, eb)\n  let a_is_var = match ra {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  let b_is_var = match rb {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  if a_is_var {\n    match ra {\n      Some(av) => if Some(av) == rb {\n        Some(s)\n      } else {\n        let bval = match rb {\n          Some(bv) => bv,\n          None => \"\"\n        }\n        Some(SubstEffBind(av, bval, s))\n      },\n      None => Some(s)\n    }\n  } else if b_is_var {\n    match rb {\n      Some(bv) => {\n        let aval = match ra {\n          Some(av) => av,\n          None => \"\"\n        }\n        Some(SubstEffBind(bv, aval, s))\n      },\n      None => Some(s)\n    }\n  } else if effect_names_compatible(ra, rb) {\n    Some(s)\n  } else {\n    None\n  }\n}\n\nexport fn types_equal(a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,\n      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,\n      CtNamed(bname, bargs) =>\n      if aname != bname {\n        false\n      } else if Array::length(aargs) != Array::length(bargs) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while !tae_done {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else {\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\n              tae_i = tae_i + 1\n            } else {\n              tae_result = false\n              tae_done = true\n            }\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if Array::length(aelems) != Array::length(belems) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while !tae_done2 {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else {\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\n              tae_i2 = tae_i2 + 1\n            } else {\n              tae_result2 = false\n              tae_done2 = true\n            }\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, aeffect) => match b {\n      CtFn(bparams, bret, beffect) =>\n      if Array::length(aparams) != Array::length(bparams) {\n        false\n      } else if effect_names_compatible(aeffect, beffect) {\n        let tae_len3 = Array::length(aparams)\n        let mut tae_i3 = 0\n        let mut tae_result3 = true\n        let mut tae_done3 = false\n        while !tae_done3 {\n          if tae_i3 >= tae_len3 {\n            tae_done3 = true\n          } else {\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\n              tae_i3 = tae_i3 + 1\n            } else {\n              tae_result3 = false\n              tae_done3 = true\n            }\n          }\n        }\n        if tae_result3 {\n          types_equal(aret, bret)\n        } else {\n          false\n        }\n      } else {\n        false\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\n        false\n      } else if Array::length(abounds) != Array::length(bbounds) {\n        false\n      } else {\n        let vlen = Array::length(avars)\n        let mut vi = 0\n        let mut vresult = true\n        let mut vdone = false\n        while !vdone {\n          if vi >= vlen {\n            vdone = true\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\n            vresult = false\n            vdone = true\n          } else {\n            vi = vi + 1\n          }\n        }\n        if vresult {\n          let fbe_len = Array::length(abounds)\n          let mut fbe_i = 0\n          let mut fbe_result = true\n          let mut fbe_done = false\n          while !fbe_done {\n            if fbe_i >= fbe_len {\n              fbe_done = true\n            } else {\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n              if lvar != rvar {\n                fbe_result = false\n                fbe_done = true\n              } else if Array::length(lbounds) != Array::length(rbounds) {\n                fbe_result = false\n                fbe_done = true\n              } else {\n                if string_array_equal(lbounds, rbounds) {\n                  fbe_i = fbe_i + 1\n                } else {\n                  fbe_result = false\n                  fbe_done = true\n                }\n              }\n            }\n          }\n          if fbe_result {\n            types_equal(abody, bbody)\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      }\n      ,\n      _ => false\n    }\n  }\n}\n\nfn char_int_compatible(ta: Type, tb: Type) -> Bool {\n  match ta {\n    CtChar => match tb {\n      CtInt => true,\n      _ => false\n    },\n    CtInt => match tb {\n      CtChar => true,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nexport fn unify(a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else if char_int_compatible(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, aeffect) => match tb {\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while !ul_done {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => match unify(ra, rb, s2) {\n                        Some(s3) => unify_effects(aeffect, beffect, s3),\n                        None => None\n                      },\n                      None => None\n                    }\n                  },\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while !ul_done2 {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  },\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, _) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, _) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name != b_name {\n                    None\n                  }\n                  else if Array::length(a_args) != Array::length(b_args) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while !ul_done3 {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  },\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn types_compatible(expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport fn impls_overlap_for(env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nfn struct_impl_target_matches(target: Type, resolved: Type) -> Bool {\n  match resolved {\n    CtNamed(rname, rargs) => if Array::length(rargs) > 0 {\n      match target {\n        CtStruct(tname) => tname == rname,\n        CtNamed(tname, targs) => tname == rname && Array::length(targs) == 0,\n        _ => false\n      }\n    } else {\n      false\n    },\n    _ => false\n  }\n}\n\nfn type_implements_check_env(e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport fn collect_subst_bounds_pairs(s: Subst) -> Array[(Int, Array[String])] {\n  let out = array_empty()\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if !int_bounds_has_id(out, id, 0) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport fn generalize(s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if Array::length(tvars) == 0 {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = array_empty()\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if Array::length(bounds) != 0 {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nfn type_implements_check_super(e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nfn type_constructor_name(ty: Type) -> String {\n  match ty {\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\nfn trait_is_method_bearing(env: TypeEnv, trait_name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      Array::length(methods) > 0\n    } else trait_is_method_bearing(rest, trait_name),\n    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => trait_is_method_bearing(rest, trait_name)\n  }\n}\n\n\nfn type_args_of(ty: Type) -> Array[Type] {\n  match ty {\n    CtArray(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtOption(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtNamed(_, args) => args,\n    _ => array_empty()\n  }\n}\n\nfn generic_impl_satisfies(scan: TypeEnv, full: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImplGen(itrait, _tparams, bounds, target, rest) => {\n      let head = type_constructor_name(resolved)\n      let shape_ok = itrait == trait_name && head != \"\" && type_constructor_name(target) == head && trait_is_method_bearing(full, trait_name)\n      if shape_ok && generic_bounds_hold(full, s, bounds, type_args_of(resolved)) {\n        true\n      } else generic_impl_satisfies(rest, full, s, trait_name, resolved)\n    },\n    EnvFlat(_) => false,\n    EnvCached(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved)\n  }\n}\n\nfn generic_bounds_hold(full: TypeEnv, s: Subst, bounds: Array[(String, Array[String])], args: Array[Type]) -> Bool {\n  let mut bi = 0\n  let mut ok = true\n  while bi < Array::length(bounds) {\n    let (_, btraits) = Array::get(bounds, bi)\n    let mut ti = 0\n    while ti < Array::length(btraits) {\n      let bt = Array::get(btraits, ti)\n      if bt != \"\" {\n        let mut ai = 0\n        while ai < Array::length(args) {\n          match subst_apply(s, Array::get(args, ai)) {\n            CtUnknown => (),\n            _ => if not(type_implements_trait(full, s, Array::get(args, ai), bt)) {\n              ok = false\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    bi = bi + 1\n  }\n  ok\n}\n\nexport fn type_implements_trait(env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else if generic_impl_satisfies(env, env, s, trait_name, resolved) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if slen == 0 {\n      false\n    }\n    else {\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")
}

let source_19 = () -> (String, String) {
  ("lib/@vibe/compiler/core/dce.vibe",
"\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn clone_arr(arr: Array[String]) -> Array[String] {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nfn stmt_name(stmt: Stmt) -> Option[String] {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SFnDecl(_, name, _, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nfn dce_array_contains_str(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let rec search: (Int) -> Bool = (i) -> {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nfn add_ref(out: Array[String], bound: Array[String], name: String) -> Int {\n  if not(dce_array_contains_str(bound, name)) {\n    if not(dce_array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nfn collect_pat_bindings(pat: Pat, bound: Array[String]) -> Int {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PFloat(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    },\n    PStruct(_, _) => 0\n  }\n}\n\nfn collect_refs_into(expr: Expr, bound: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name, _) => add_ref(out, bound, name),\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(e) => collect_refs_into(e, bound, out),\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body, _) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body, _) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _, _, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nfn collect_refs(expr: Expr, bound: Array[String]) -> Array[String] {\n  let out = array_empty()\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nfn enqueue_reachable(reachable: Array[String], queue: Array[String], name: String) -> Unit {\n  if not(dce_array_contains_str(reachable, name)) {\n    Array::push(reachable, name)\n    Array::push(queue, name)\n  }\n}\n\nfn collect_structural_refs_into_queue(stmt: Stmt, bound: Array[String], reachable: Array[String], queue: Array[String]) -> Unit {\n  let refs = match stmt {\n    STest(_, expr) => collect_refs(expr, bound),\n    SBench(_, expr) => collect_refs(expr, bound),\n    SExpr(expr) => collect_refs(expr, bound),\n    _ => array_empty()\n  }\n  let mut i = 0\n  while i < Array::length(refs) {\n    enqueue_reachable(reachable, queue, Array::get(refs, i))\n    i = i + 1\n  }\n}\n\nfn is_type_or_structural(stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SEffectDef(_, _, _, _) => true,\n    SStruct(_, _, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    STrait(_, _, _, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    SAliasDecl(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn dce_stmts(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\n  if Array::length(stmts) == 0 {\n    Array::slice(stmts, 0, 0)\n  } else {\n  let empty_bound = array_empty()\n  let def_names = array_empty()\n  let def_refs = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SFnDecl(_, _, fn_value, reqs, enss) => {\n            let out = collect_refs(fn_value, empty_bound)\n            let mut cri = 0\n            while cri < Array::length(reqs) {\n              let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)\n              cri = cri + 1\n            }\n            let mut cei = 0\n            while cei < Array::length(enss) {\n              let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)\n              cei = cei + 1\n            }\n            out\n          },\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => array_empty()\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = array_empty()\n  let queue = array_empty()\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = array_empty()\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if dce_array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        },\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n  }\n}\n\nfn dce_reachable_names(stmts: Array[Stmt], entry_names: Array[String]) -> Array[String] {\n  let empty_bound = array_empty()\n  let def_names = array_empty()\n  let def_refs = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SFnDecl(_, _, fn_value, reqs, enss) => {\n            let out = collect_refs(fn_value, empty_bound)\n            let mut cri = 0\n            while cri < Array::length(reqs) {\n              let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)\n              cri = cri + 1\n            }\n            let mut cei = 0\n            while cei < Array::length(enss) {\n              let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)\n              cei = cei + 1\n            }\n            out\n          },\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => array_empty()\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = array_empty()\n  let queue = array_empty()\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  reachable\n}\n\nfn dce_keep_stmt(stmt: Stmt, reachable: Array[String]) -> Bool {\n  if is_type_or_structural(stmt) {\n    true\n  } else {\n    match stmt_name(stmt) {\n      Some(name) => dce_array_contains_str(reachable, name),\n      None => true\n    }\n  }\n}\n\nexport fn dce_keep_flags(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {\n  let flags = array_empty()\n  if Array::length(stmts) == 0 {\n    flags\n  } else {\n    let reachable = dce_reachable_names(stmts, entry_names)\n    let mut m = 0\n    while m < Array::length(stmts) {\n      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable))\n      m = m + 1\n    }\n    flags\n  }\n}\n")
}

let source_20 = () -> (String, String) {
  ("lib/@vibe/compiler/core/sorted_index.vibe",
"import @vibe/core {\n  array_empty\n}\n\n\n\nexport fn str_lt(a: String, b: String) -> Bool {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let lim = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut res = la < lb\n  let mut done = false\n  while i < lim && !done {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      res = true\n      done = true\n    } else if ca > cb {\n      res = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  res\n}\n\nexport fn sort_perm_by_names(names: Array[String]) -> Array[Int] {\n  let n = Array::length(names)\n  let mut src = array_empty()\n  let mut i = 0\n  while i < n {\n    Array::push(src, i)\n    i = i + 1\n  }\n  let mut buf = Array::slice(src, 0, n)\n  let mut width = 1\n  while width < n {\n    let mut lo = 0\n    while lo < n {\n      let mid = if lo + width < n {\n        lo + width\n      } else {\n        n\n      }\n      let hi = if lo + width + width < n {\n        lo + width + width\n      } else {\n        n\n      }\n      let mut a = lo\n      let mut b = mid\n      let mut k = lo\n      while k < hi {\n        let take_left = if a >= mid {\n          false\n        } else if b >= hi {\n          true\n        } else {\n          !str_lt(Array::get(names, Array::get(src, b)), Array::get(names, Array::get(src, a)))\n        }\n        if take_left {\n          Array::set(buf, k, Array::get(src, a))\n          a = a + 1\n        } else {\n          Array::set(buf, k, Array::get(src, b))\n          b = b + 1\n        }\n        k = k + 1\n      }\n      lo = hi\n    }\n    let tmp = src\n    src = buf\n    buf = tmp\n    width = width + width\n  }\n  src\n}\n\nexport fn apply_perm_strings(names: Array[String], perm: Array[Int]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(perm) {\n    Array::push(out, Array::get(names, Array::get(perm, i)))\n    i = i + 1\n  }\n  out\n}\n\nexport fn sorted_names_of(names: Array[String]) -> Array[String] {\n  apply_perm_strings(names, sort_perm_by_names(names))\n}\n\nexport fn bsearch_leftmost(sorted: Array[String], name: String) -> Int {\n  let mut lo = 0\n  let mut hi = Array::length(sorted)\n  while lo < hi {\n    let mid = (lo + hi) / 2\n    if str_lt(Array::get(sorted, mid), name) {\n      lo = mid + 1\n    } else {\n      hi = mid\n    }\n  }\n  if lo < Array::length(sorted) && Array::get(sorted, lo) == name {\n    lo\n  } else {\n    -1\n  }\n}\n")
}

let source_21 = () -> (String, String) {
  ("lib/@vibe/compiler/core/import_alias_rewrite.vibe",
"\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn empty_aliases() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn empty_strings() -> Array[String] {\n  array_empty()\n}\n\nfn empty_import_refs() -> Array[(String, String, String)] {\n  array_empty()\n}\n\nfn string_array_contains(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn import_ref_array_contains_local(items: Array[(String, String, String)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (_, _, local) = Array::get(items, i)\n    if local == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn import_ref_has_other_path_for_original(items: Array[(String, String, String)], raw_path: String, original: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (other_path, other_original, _) = Array::get(items, i)\n    if other_original == original && other_path != raw_path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn lookup_alias(aliases: Array[(String, String)], name: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if alias == name {\n      found = Some(original)\n      i = Array::length(aliases)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn alias_is_shadowed(alias: String, name: String) -> Bool {\n  alias == name || (String::starts_with(alias, name) && String::length(alias) > String::length(name) && String::char_code_at(alias, String::length(name)) == '.')\n}\n\nfn alias_map_has_name(aliases: Array[(String, String)], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(aliases) && !found {\n    let (alias, _) = Array::get(aliases, i)\n    if alias_is_shadowed(alias, name) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn alias_map_without_name(aliases: Array[(String, String)], name: String) -> Array[(String, String)] {\n  if !alias_map_has_name(aliases, name) {\n    aliases\n  } else {\n    let out = empty_aliases()\n    let mut i = 0\n    while i < Array::length(aliases) {\n      let (alias, original) = Array::get(aliases, i)\n      if !alias_is_shadowed(alias, name) {\n        Array::push(out, (alias, original))\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn names_shadow_alias(names: Array[String], alias: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) && !found {\n    if alias_is_shadowed(alias, Array::get(names, i)) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn alias_map_without_names(aliases: Array[(String, String)], names: Array[String]) -> Array[(String, String)] {\n  let mut any = false\n  let mut j = 0\n  while j < Array::length(aliases) && !any {\n    let (alias, _) = Array::get(aliases, j)\n    if names_shadow_alias(names, alias) {\n      any = true\n    } else {\n      j = j + 1\n    }\n  }\n  if !any {\n    aliases\n  } else {\n    let out = empty_aliases()\n    let mut i = 0\n    while i < Array::length(aliases) {\n      let (alias, original) = Array::get(aliases, i)\n      if !names_shadow_alias(names, alias) {\n        Array::push(out, (alias, original))\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn pat_binds_name(pat: Pat, name: String) -> Bool {\n  match pat {\n    PBind(bound) => bound == name,\n    PCtor(_, pats) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(pats) && !found {\n        if pat_binds_name(Array::get(pats, i), name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(pats) && !found {\n        if pat_binds_name(Array::get(pats, i), name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),\n    PStruct(_, fields) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) && !found {\n        let (_, field_pat) = Array::get(fields, i)\n        if pat_binds_name(field_pat, name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn alias_namespace_prefix(alias: String) -> Option[String] {\n  let dot = String::index_of(alias, \".\")\n  if dot < 0 {\n    None\n  } else {\n    Some(String::substring(alias, 0, dot))\n  }\n}\n\nfn pat_shadows_alias(pat: Pat, alias: String) -> Bool {\n  pat_binds_name(pat, alias) || match alias_namespace_prefix(alias) {\n    Some(ns) => pat_binds_name(pat, ns),\n    None => false\n  }\n}\n\nfn alias_map_without_pat(aliases: Array[(String, String)], pat: Pat) -> Array[(String, String)] {\n  let mut any = false\n  let mut j = 0\n  while j < Array::length(aliases) && !any {\n    let (alias, _) = Array::get(aliases, j)\n    if pat_shadows_alias(pat, alias) {\n      any = true\n    } else {\n      j = j + 1\n    }\n  }\n  if !any {\n    aliases\n  } else {\n    let out = empty_aliases()\n    let mut i = 0\n    while i < Array::length(aliases) {\n      let (alias, original) = Array::get(aliases, i)\n      if !pat_shadows_alias(pat, alias) {\n        Array::push(out, (alias, original))\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn param_binds_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(params) && !found {\n    let (param_name, _) = Array::get(params, i)\n    if param_name == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn params_shadow_alias(params: Array[(String, Option[TypeExpr])], alias: String) -> Bool {\n  param_binds_name(params, alias) || match alias_namespace_prefix(alias) {\n    Some(ns) => param_binds_name(params, ns),\n    None => false\n  }\n}\n\nfn alias_map_without_params(aliases: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {\n  let mut any = false\n  let mut j = 0\n  while j < Array::length(aliases) && !any {\n    let (alias, _) = Array::get(aliases, j)\n    if params_shadow_alias(params, alias) {\n      any = true\n    } else {\n      j = j + 1\n    }\n  }\n  if !any {\n    aliases\n  } else {\n    let out = empty_aliases()\n    let mut i = 0\n    while i < Array::length(aliases) {\n      let (alias, original) = Array::get(aliases, i)\n      if !params_shadow_alias(params, alias) {\n        Array::push(out, (alias, original))\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport fn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr {\n  if Array::length(aliases) == 0 {\n    expr\n  } else {\n  match expr {\n    EIdent(name, _) => match lookup_alias(aliases, name) {\n      Some(original) => EIdent(original, -1),\n      None => expr\n    },\n    ETuple(items) => ETuple(for item in items {\n      rewrite_import_alias_expr(item, aliases)\n    }),\n    EArray(items) => EArray(for item in items {\n      rewrite_import_alias_expr(item, aliases)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields {\n      let (name, value) = field\n      (name, rewrite_import_alias_expr(value, aliases))\n    }, targs),\n    EIf(cond, then_expr, else_expr) => EIf(\n      rewrite_import_alias_expr(cond, aliases),\n      rewrite_import_alias_expr(then_expr, aliases),\n      rewrite_import_alias_expr(else_expr, aliases)\n    ),\n    ELet(name, value, body, soff) => ELet(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name)),\n      soff\n    ),\n    ELetRec(name, value, body) => {\n      let body_aliases = alias_map_without_name(aliases, name)\n      ELetRec(\n        name,\n        rewrite_import_alias_expr(value, body_aliases),\n        rewrite_import_alias_expr(body, body_aliases)\n      )\n    },\n    ELetMut(name, value, body, soff) => ELetMut(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name)),\n      soff\n    ),\n    EAssign(name, value, body) => EAssign(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    EAssignOp(name, op, value, body) => EAssignOp(\n      name,\n      op,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    ESeq(left, right) => ESeq(\n      rewrite_import_alias_expr(left, aliases),\n      rewrite_import_alias_expr(right, aliases)\n    ),\n    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {\n      let (pat, body) = arm\n      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))\n    }),\n    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {\n      let (pat, arm_body) = arm\n      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))\n    }),\n    EWhile(cond, body) => EWhile(\n      rewrite_import_alias_expr(cond, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    ELoop(params, body) => {\n      let out_params = for param in params {\n        let (name, init) = param\n        (name, rewrite_import_alias_expr(init, aliases))\n      }\n      let mut body_aliases = aliases\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, _) = Array::get(params, i)\n        body_aliases = alias_map_without_name(body_aliases, name)\n        i = i + 1\n      }\n      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))\n    },\n    EForIn(name, index_name, iter, body) => {\n      let body_aliases = match index_name {\n        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),\n        None => alias_map_without_name(aliases, name)\n      }\n      EForIn(\n        name,\n        index_name,\n        rewrite_import_alias_expr(iter, aliases),\n        rewrite_import_alias_expr(body, body_aliases)\n      )\n    },\n    ECall(callee, args, off) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {\n      rewrite_import_alias_expr(arg, aliases)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(\n      op,\n      rewrite_import_alias_expr(left, aliases),\n      rewrite_import_alias_expr(right, aliases)\n    ),\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\n      type_params,\n      bounds,\n      params,\n      ret_ty,\n      effect,\n      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))\n    ),\n    EDot(obj, field, off, fdoff) => match obj {\n      EIdent(ns, _) => match lookup_alias(aliases, String::concat(ns, String::concat(\".\", field))) {\n        Some(original) => EIdent(original, -1),\n        None => EDot(rewrite_import_alias_expr(obj, aliases), field, off, fdoff)\n      },\n      _ => EDot(rewrite_import_alias_expr(obj, aliases), field, off, fdoff)\n    },\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),\n    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),\n    EBreak(value) => match value {\n      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),\n      None => expr\n    },\n    EContinue(values) => EContinue(for value in values {\n      rewrite_import_alias_expr(value, aliases)\n    }),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field\n      (name, rewrite_import_alias_expr(value, aliases))\n    }),\n    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),\n    _ => expr\n  }\n  }\n}\n\nexport fn collect_import_aliases(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let aliases = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(_, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (original, alias_opt) = Array::get(items, j)\n          match alias_opt {\n            Some(alias) => if alias != original {\n              Array::push(aliases, (alias, original))\n            },\n            None => ()\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  aliases\n}\n\nfn collect_import_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {\n  let refs = empty_import_refs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (original, alias_opt) = Array::get(items, j)\n          let local = match alias_opt {\n            Some(alias) => alias,\n            None => original\n          }\n          Array::push(refs, (raw_path, original, local))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  refs\n}\n\nexport fn collect_import_alias_collision_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {\n  let refs = collect_import_refs(stmts)\n  let out = empty_import_refs()\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {\n      Array::push(out, (raw_path, original, local))\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn collect_import_alias_collision_locals(stmts: Array[Stmt]) -> Array[String] {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let out = empty_strings()\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (_, _, local) = Array::get(refs, i)\n    if !string_array_contains(out, local) {\n      Array::push(out, local)\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(\n      exported,\n      is_rec,\n      name,\n      ty,\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    SLetMut(name, ty, body) => SLetMut(\n      name,\n      ty,\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),\n    SModule(exported, name, stmts) => {\n      let module_aliases = collect_import_aliases(stmts)\n      SModule(exported, name, for inner_stmt in stmts {\n        rewrite_import_alias_stmt(inner_stmt, module_aliases)\n      })\n    },\n    _ => stmt\n  }\n}\n\nexport fn stmts_have_import_deep(stmts: Array[Stmt]) -> Bool {\n  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {\n    match stmt {\n      SImport(_, _) => true,\n      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),\n      _ => false\n    }\n  }\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) && !found {\n    if stmt_has_import_deep(Array::get(stmts, i)) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      _ => Array::push(merged, stmt)\n    }\n    i = i + 1\n  }\n}\n\nexport fn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit {\n  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)\n  let should_rewrite = Array::length(aliases) > 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),\n      _ => if should_rewrite {\n        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))\n      } else {\n        Array::push(merged, stmt)\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport fn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {\n  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())\n}\n\nexport fn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt] {\n  let aliases = Array::slice([\n    (original, local)\n  ], 0, 1)\n  let rewrite_value: (Expr) -> Expr = (expr) -> {\n    if original == local {\n      expr\n    } else {\n      rewrite_import_alias_expr(expr, aliases)\n    }\n  }\n  match stmt {\n    SLet(_, is_rec, name, ty, body) => if name == original {\n      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))\n    } else {\n      None\n    },\n    SLetMut(name, ty, body) => if name == original {\n      Some(SLetMut(local, ty, rewrite_value(body)))\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn sanitize_namespace_char(code: Int) -> String {\n  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {\n    String::from_char_code(code)\n  } else {\n    \"_\"\n  }\n}\n\nfn sanitize_namespace_path(path: String) -> String {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(path) {\n    StringBuilder::push(out, sanitize_namespace_char(String::char_code_at(path, i)))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nfn namespace_private_name(path: String, name: String) -> String {\n  String::concat(name, String::concat(\"_dep_\", sanitize_namespace_path(path)))\n}\n\nfn namespace_private_name_with_suffix(namespace_suffix: String, name: String) -> String {\n  String::concat(name, String::concat(\"_dep_\", namespace_suffix))\n}\n\nfn namespace_private_name_lazy(path: String, name: String, suffix_box: Array[String]) -> String {\n  let current = Array::get(suffix_box, 0)\n  let suffix = if String::length(current) == 0 {\n    let sanitized = sanitize_namespace_path(path)\n    Array::set(suffix_box, 0, sanitized)\n    sanitized\n  } else {\n    current\n  }\n  namespace_private_name_with_suffix(suffix, name)\n}\n\nfn collect_exported_value_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {\n        Array::push(names, name)\n      },\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let name = Array::get(items, j)\n          if !string_array_contains(names, name) {\n            Array::push(names, name)\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\nfn collect_exported_type_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(true, name, _, _, _, _) => Array::push(names, name),\n      SEnum(true, name, _, _, _) => Array::push(names, name),\n      STrait(true, name, _, _, _) => Array::push(names, name),\n      STypeAlias(true, name, _, _) => Array::push(names, name),\n      SSuberror(true, name, _) => Array::push(names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\nfn collect_declared_type_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _, _) => Array::push(names, name),\n      SEnum(_, name, _, _, _) => Array::push(names, name),\n      STrait(_, name, _, _, _) => Array::push(names, name),\n      STypeAlias(_, name, _, _) => Array::push(names, name),\n      SSuberror(_, name, _) => Array::push(names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\nfn qualified_method_of_exported_type(name: String, exported_types: Array[String], declared_types: Array[String]) -> Bool {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    false\n  } else {\n    let head = String::substring(name, 0, idx)\n    if string_array_contains(exported_types, head) {\n      true\n    } else {\n      !string_array_contains(declared_types, head)\n    }\n  }\n}\n\nfn collect_private_value_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\n  let renames = empty_aliases()\n  let exported_types = collect_exported_type_names(stmts)\n  let declared_types = collect_declared_type_names(stmts)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types, declared_types) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SLetMut(name, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  renames\n}\n\nfn rewrite_private_type_expr(ty: TypeExpr, renames: Array[(String, String)]) -> TypeExpr {\n  match ty {\n    TyName(name) => match lookup_alias(renames, name) {\n      Some(renamed) => TyName(renamed),\n      None => ty\n    },\n    TyApp(name, args) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      TyApp(next_name, for arg in args {\n        rewrite_private_type_expr(arg, renames)\n      })\n    },\n    TyFn(params, ret, effect_name) => TyFn(\n      for param in params {\n        rewrite_private_type_expr(param, renames)\n      },\n      rewrite_private_type_expr(ret, renames),\n      effect_name\n    ),\n    TyTuple(items) => TyTuple(for item in items {\n      rewrite_private_type_expr(item, renames)\n    }),\n    TyUnit => ty\n  }\n}\n\nfn rewrite_private_type_opt(ty: Option[TypeExpr], renames: Array[(String, String)]) -> Option[TypeExpr] {\n  match ty {\n    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),\n    None => None\n  }\n}\n\nfn rewrite_private_params(params: Array[(String, Option[TypeExpr])], type_renames: Array[(String, String)]) -> Array[(String, Option[TypeExpr])] {\n  for param in params {\n    let (name, ty) = param\n    (name, rewrite_private_type_opt(ty, type_renames))\n  }\n}\n\nfn rewrite_private_type_ctor_pat(pat: Pat, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Pat {\n  match pat {\n    PCtor(name, pats) => {\n      let next_name = match lookup_alias(ctor_renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      PCtor(next_name, for item in pats {\n        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\n      })\n    },\n    PTuple(pats) => PTuple(for item in pats {\n      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\n    }),\n    POr(left, right) => POr(\n      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)\n    ),\n    PStruct(name, fields) => {\n      let next_name = match lookup_alias(type_renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      PStruct(next_name, for field in fields {\n        let (field_name, field_pat) = field\n        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))\n      })\n    },\n    _ => pat\n  }\n}\n\nfn rewrite_private_type_ctor_expr(expr: Expr, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Expr {\n  match expr {\n    EIdent(name, _) => match lookup_alias(ctor_renames, name) {\n      Some(renamed) => EIdent(renamed, -1),\n      None => expr\n    },\n    ETuple(items) => ETuple(for item in items {\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\n    }),\n    EArray(items) => EArray(for item in items {\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\n    }),\n    ERecord(rn, fields, targs) => {\n      let next_rn = match lookup_alias(type_renames, rn) {\n        Some(renamed) => renamed,\n        None => rn\n      }\n      ERecord(next_rn, for field in fields {\n        let (name, value) = field\n        (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\n      }, for ta in targs {\n        rewrite_private_type_expr(ta, type_renames)\n      })\n    },\n    EIf(cond, then_expr, else_expr) => EIf(\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)\n    ),\n    ELet(name, value, body, soff) => ELet(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)),\n      soff\n    ),\n    ELetRec(name, value, body) => {\n      let body_ctors = alias_map_without_name(ctor_renames, name)\n      ELetRec(\n        name,\n        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\n      )\n    },\n    ELetMut(name, value, body, soff) => ELetMut(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)),\n      soff\n    ),\n    EAssign(name, value, body) => EAssign(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    EAssignOp(name, op, value, body) => EAssignOp(\n      name,\n      op,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    ESeq(left, right) => ESeq(\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\n    ),\n    EMatch(scrutinee, arms) => EMatch(\n      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),\n      for arm in arms {\n        let (pat, body) = arm\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      }\n    ),\n    EHandle(body, arms) => EHandle(\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),\n      for arm in arms {\n        let (pat, arm_body) = arm\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      }\n    ),\n    EWhile(cond, body) => EWhile(\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    ELoop(params, body) => {\n      let out_params = for param in params {\n        let (name, init) = param\n        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))\n      }\n      let mut body_ctors = ctor_renames\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, _) = Array::get(params, i)\n        body_ctors = alias_map_without_name(body_ctors, name)\n        i = i + 1\n      }\n      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))\n    },\n    EForIn(name, index_name, iter, body) => {\n      let body_ctors = match index_name {\n        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),\n        None => alias_map_without_name(ctor_renames, name)\n      }\n      EForIn(\n        name,\n        index_name,\n        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\n      )\n    },\n    ECall(callee, args, off) => ECall(\n      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),\n      for arg in args {\n        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)\n      },\n      off\n    ),\n    EBinOp(op, left, right) => EBinOp(\n      op,\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\n    ),\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\n      type_params,\n      bounds,\n      rewrite_private_params(params, type_renames),\n      rewrite_private_type_opt(ret_ty, type_renames),\n      effect,\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))\n    ),\n    EDot(obj, field, off, fdoff) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off, fdoff),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    EBreak(value) => match value {\n      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),\n      None => expr\n    },\n    EContinue(values) => EContinue(for value in values {\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)\n    }),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\n    }),\n    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    _ => expr\n  }\n}\n\nfn collect_private_type_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\n  let renames = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(false, name, _, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SStruct(false, name, _, _, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SSuberror(false, name, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  renames\n}\n\nfn collect_private_ctor_renames(path: String, stmts: Array[Stmt], type_renames: Array[(String, String)], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\n  let renames = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(false, type_name, _, ctors, _) => if !string_array_contains(exported, type_name) {\n        let mut j = 0\n        while j < Array::length(ctors) {\n          let (ctor_name, _) = Array::get(ctors, j)\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\n          j = j + 1\n        }\n      },\n      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {\n        let mut j = 0\n        while j < Array::length(ctors) {\n          let (ctor_name, _) = Array::get(ctors, j)\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  type_renames\n  renames\n}\n\nexport fn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt] {\n  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\n    match stmt {\n      SLet(exported, is_rec, name, ty, body) => SLet(\n        exported,\n        is_rec,\n        name,\n        rewrite_private_type_opt(ty, type_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n      ),\n      SLetMut(name, ty, body) => SLetMut(\n        name,\n        rewrite_private_type_opt(ty, type_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n      ),\n      SEnum(exported, name, params, ctors, derives) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SEnum(exported, next_name, params, for ctor in ctors {\n          let (ctor_name, args) = ctor\n          let next_ctor = if exported {\n            ctor_name\n          } else {\n            match lookup_alias(ctor_renames, ctor_name) {\n              Some(renamed) => renamed,\n              None => ctor_name\n            }\n          }\n          (next_ctor, for arg in args {\n            rewrite_private_type_expr(arg, type_renames)\n          })\n        }, derives)\n      },\n      SSuberror(exported, name, ctors) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SSuberror(exported, next_name, for ctor in ctors {\n          let (ctor_name, args) = ctor\n          let next_ctor = if exported {\n            ctor_name\n          } else {\n            match lookup_alias(ctor_renames, ctor_name) {\n              Some(renamed) => renamed,\n              None => ctor_name\n            }\n          }\n          (next_ctor, for arg in args {\n            rewrite_private_type_expr(arg, type_renames)\n          })\n        })\n      },\n      SStruct(exported, name, fields, derives, mut_fields, tparams) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SStruct(exported, next_name, for field in fields {\n          let (field_name, field_ty) = field\n          (field_name, rewrite_private_type_expr(field_ty, type_renames))\n        }, derives, mut_fields, tparams)\n      },\n      STypeAlias(exported, name, params, target) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\n      },\n      SImpl(tparams, bounds, trait_name, target_name) => {\n        let next_target = match lookup_alias(type_renames, target_name) {\n          Some(renamed) => renamed,\n          None => target_name\n        }\n        SImpl(tparams, bounds, trait_name, next_target)\n      },\n      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\n      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SLetPat(pat, body) => {\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      },\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\n      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\n        let (op_name, op_params, ret_ty) = op\n        (op_name, for param in op_params {\n          rewrite_private_type_expr(param, type_renames)\n        }, rewrite_private_type_expr(ret_ty, type_renames))\n      }),\n      _ => stmt\n    }\n  }\n  let namespace_private_stmt_local: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\n    match stmt {\n      SLet(exported, is_rec, name, ty, body) => {\n        let next_name = match lookup_alias(renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n        SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n      },\n      SLetMut(name, ty, body) => {\n        let next_name = match lookup_alias(renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n        SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\n      },\n      STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n      SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n      SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n      SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\n      _ => stmt\n    }\n  }\n  let namespace_suffix_box = [\"\"]\n  let exported = collect_exported_value_names(stmts)\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\n  let value_renamed = if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      namespace_private_stmt_local(stmt, renames)\n    }\n  }\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\n    value_renamed\n  } else {\n    for stmt in value_renamed {\n      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)\n    }\n  }\n}\n\nfn namespace_private_type_ctor_stmt(stmt: Stmt, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Stmt {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(\n      exported,\n      is_rec,\n      name,\n      rewrite_private_type_opt(ty, type_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    SLetMut(name, ty, body) => SLetMut(\n      name,\n      rewrite_private_type_opt(ty, type_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    SEnum(exported, name, params, ctors, derives) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SEnum(exported, next_name, params, for ctor in ctors {\n        let (ctor_name, args) = ctor\n        let next_ctor = if exported {\n          ctor_name\n        } else {\n          match lookup_alias(ctor_renames, ctor_name) {\n            Some(renamed) => renamed,\n            None => ctor_name\n          }\n        }\n        (next_ctor, for arg in args {\n          rewrite_private_type_expr(arg, type_renames)\n        })\n      }, derives)\n    },\n    SSuberror(exported, name, ctors) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SSuberror(exported, next_name, for ctor in ctors {\n        let (ctor_name, args) = ctor\n        let next_ctor = if exported {\n          ctor_name\n        } else {\n          match lookup_alias(ctor_renames, ctor_name) {\n            Some(renamed) => renamed,\n            None => ctor_name\n          }\n        }\n        (next_ctor, for arg in args {\n          rewrite_private_type_expr(arg, type_renames)\n        })\n      })\n    },\n    SStruct(exported, name, fields, derives, mut_fields, tparams) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SStruct(exported, next_name, for field in fields {\n        let (field_name, field_ty) = field\n        (field_name, rewrite_private_type_expr(field_ty, type_renames))\n      }, derives, mut_fields, tparams)\n    },\n    STypeAlias(exported, name, params, target) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\n    },\n    SImpl(tparams, bounds, trait_name, target_name) => {\n      let next_target = match lookup_alias(type_renames, target_name) {\n        Some(renamed) => renamed,\n        None => target_name\n      }\n      SImpl(tparams, bounds, trait_name, next_target)\n    },\n    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\n    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SLetPat(pat, body) => {\n      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n    },\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\n    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\n      let (op_name, op_params, ret_ty) = op\n      (op_name, for param in op_params {\n        rewrite_private_type_expr(param, type_renames)\n      }, rewrite_private_type_expr(ret_ty, type_renames))\n    }),\n    _ => stmt\n  }\n}\n\nfn namespace_private_stmt(stmt: Stmt, renames: Array[(String, String)]) -> Stmt {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n    },\n    SLetMut(name, ty, body) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\n    },\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\n    _ => stmt\n  }\n}\n\nfn namespace_private_value_stmts_legacy_ordered(path: String, stmts: Array[Stmt]) -> Array[Stmt] {\n  let namespace_suffix_box = [\"\"]\n  let exported = collect_exported_value_names(stmts)\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\n  let value_renamed = if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      namespace_private_stmt(stmt, renames)\n    }\n  }\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\n    value_renamed\n  } else {\n    for stmt in value_renamed {\n      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)\n    }\n  }\n}\n\n\n\nexport fn namespace_exported_name(path: String, name: String) -> String {\n  String::concat(name, String::concat(\"_exp_\", sanitize_namespace_path(path)))\n}\n\nexport fn collect_export_def_value_names(stmts: Array[Stmt]) -> Array[String] {\n  let extern_names = empty_strings()\n  let let_names = empty_strings()\n  let exported_lets = empty_strings()\n  let export_items = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, _, _) => {\n        Array::push(let_names, name)\n        if exported {\n          Array::push(exported_lets, name)\n        } else {\n          ()\n        }\n      },\n      SExternLet(name, _) => Array::push(extern_names, name),\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          Array::push(export_items, Array::get(items, j))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let out = empty_strings()\n  let push_def_name: (String) -> Unit = (name) -> {\n    if String::index_of(name, \"::\") < 0 && !string_array_contains(extern_names, name) && !string_array_contains(out, name) {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n  }\n  let mut k = 0\n  while k < Array::length(exported_lets) {\n    push_def_name(Array::get(exported_lets, k))\n    k = k + 1\n  }\n  let mut m = 0\n  while m < Array::length(export_items) {\n    let name = Array::get(export_items, m)\n    if string_array_contains(let_names, name) {\n      push_def_name(name)\n    } else {\n      ()\n    }\n    m = m + 1\n  }\n  out\n}\n\nexport struct ExportRenamePlan {\n  plan_paths: Array[String];\n  rename_paths: Array[String];\n  rename_names: Array[String];\n  rename_mangled: Array[String]\n}\n\nfn resolve_known_import_path(known_paths: Array[String], base_dir: String, raw_path: String, self_path: String) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut chosen = \"\"\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(candidates) && !found {\n    let candidate = Array::get(candidates, i)\n    if candidate == self_path {\n      i = i + 1\n    } else {\n      if chosen == \"\" {\n        chosen = candidate\n      } else {\n        ()\n      }\n      if string_array_contains(known_paths, candidate) {\n        chosen = candidate\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  if chosen == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    chosen\n  }\n}\n\nfn plan_triple_lookup(tpaths: Array[String], tnames: Array[String], tvalues: Array[String], path: String, name: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tpaths) {\n    if Array::get(tpaths, i) == path && Array::get(tnames, i) == name {\n      found = Some(Array::get(tvalues, i))\n      i = Array::length(tpaths)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn collect_reexport_edges_into(path: String, stmts: Array[Stmt], known_paths: Array[String], edge_from: Array[String], edge_pub: Array[String], edge_tpath: Array[String], edge_tname: Array[String]) -> Unit {\n  let base_dir = dir_of_path(path)\n  let let_names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => Array::push(let_names, name),\n      SLetMut(name, _, _) => Array::push(let_names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let import_refs = collect_import_refs(stmts)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SReExport(raw_path, items) => {\n        let target = resolve_known_import_path(known_paths, base_dir, raw_path, path)\n        let mut j = 0\n        while j < Array::length(items) {\n          let (iname, alias_opt) = Array::get(items, j)\n          let public_name = match alias_opt {\n            Some(alias) => alias,\n            None => iname\n          }\n          Array::push(edge_from, path)\n          Array::push(edge_pub, public_name)\n          Array::push(edge_tpath, target)\n          Array::push(edge_tname, iname)\n          j = j + 1\n        }\n      },\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let name = Array::get(items, j)\n          if !string_array_contains(let_names, name) {\n            let mut ri = 0\n            let mut done = false\n            while ri < Array::length(import_refs) && !done {\n              let (raw_path, original, local) = Array::get(import_refs, ri)\n              if local == name {\n                Array::push(edge_from, path)\n                Array::push(edge_pub, name)\n                Array::push(edge_tpath, resolve_known_import_path(known_paths, base_dir, raw_path, path))\n                Array::push(edge_tname, original)\n                done = true\n              } else {\n                ri = ri + 1\n              }\n            }\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n}\n\nexport fn build_export_rename_plan(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String) -> ExportRenamePlan {\n  let file_count = Array::length(paths)\n  let def_names_list = array_empty()\n  let mut fi = 0\n  while fi < file_count {\n    Array::push(def_names_list, collect_export_def_value_names(Array::get(stmts_list, fi)))\n    fi = fi + 1\n  }\n  let edge_from = empty_strings()\n  let edge_pub = empty_strings()\n  let edge_tpath = empty_strings()\n  let edge_tname = empty_strings()\n  let mut ei = 0\n  while ei < file_count {\n    collect_reexport_edges_into(Array::get(paths, ei), Array::get(stmts_list, ei), paths, edge_from, edge_pub, edge_tpath, edge_tname)\n    ei = ei + 1\n  }\n  let excluded_paths = empty_strings()\n  let excluded_names = empty_strings()\n  let file_idx_of: (String) -> Int = (path) -> {\n    let mut i = 0\n    let mut found = -1\n    while i < file_count {\n      if Array::get(paths, i) == path {\n        found = i\n        i = file_count\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n  let mut xi = 0\n  while xi < Array::length(edge_from) {\n    if Array::get(edge_from, xi) == entry_path {\n      let mut cur_path = Array::get(edge_tpath, xi)\n      let mut cur_name = Array::get(edge_tname, xi)\n      let mut depth = 0\n      while depth < 16 {\n        let idx = file_idx_of(cur_path)\n        let is_def = if idx < 0 {\n          false\n        } else {\n          string_array_contains(Array::get(def_names_list, idx), cur_name)\n        }\n        if is_def {\n          Array::push(excluded_paths, cur_path)\n          Array::push(excluded_names, cur_name)\n          depth = 16\n        } else {\n          match plan_triple_lookup(edge_from, edge_pub, edge_tpath, cur_path, cur_name) {\n            Some(next_path) => {\n              match plan_triple_lookup(edge_from, edge_pub, edge_tname, cur_path, cur_name) {\n                Some(next_name) => {\n                  cur_path = next_path\n                  cur_name = next_name\n                  depth = depth + 1\n                },\n                None => {\n                  depth = 16\n                }\n              }\n            },\n            None => {\n              depth = 16\n            }\n          }\n        }\n      }\n    } else {\n      ()\n    }\n    xi = xi + 1\n  }\n  let rename_paths = empty_strings()\n  let rename_names = empty_strings()\n  let rename_mangled = empty_strings()\n  let mut ri = 0\n  while ri < file_count {\n    let path = Array::get(paths, ri)\n    if path == entry_path {\n      ()\n    } else {\n      let def_names = Array::get(def_names_list, ri)\n      let mut ni = 0\n      while ni < Array::length(def_names) {\n        let name = Array::get(def_names, ni)\n        let excluded = match plan_triple_lookup(excluded_paths, excluded_names, excluded_names, path, name) {\n          Some(_) => true,\n          None => false\n        }\n        if excluded {\n          ()\n        } else {\n          Array::push(rename_paths, path)\n          Array::push(rename_names, name)\n          Array::push(rename_mangled, namespace_exported_name(path, name))\n        }\n        ni = ni + 1\n      }\n    }\n    ri = ri + 1\n  }\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut ci = 0\n    while ci < Array::length(edge_from) {\n      let from = Array::get(edge_from, ci)\n      let pub_name = Array::get(edge_pub, ci)\n      if from == entry_path {\n        ()\n      } else {\n        match plan_triple_lookup(rename_paths, rename_names, rename_mangled, Array::get(edge_tpath, ci), Array::get(edge_tname, ci)) {\n          Some(mangled) => {\n            match plan_triple_lookup(rename_paths, rename_names, rename_mangled, from, pub_name) {\n              Some(_) => (),\n              None => {\n                Array::push(rename_paths, from)\n                Array::push(rename_names, pub_name)\n                Array::push(rename_mangled, mangled)\n                changed = true\n              }\n            }\n          },\n          None => ()\n        }\n      }\n      ci = ci + 1\n    }\n  }\n  ExportRenamePlan::{\n    plan_paths: paths,\n    rename_paths: rename_paths,\n    rename_names: rename_names,\n    rename_mangled: rename_mangled\n  }\n}\n\nexport fn export_plan_rename_count(plan: ExportRenamePlan) -> Int {\n  Array::length(plan.rename_paths)\n}\n\nexport fn export_plan_renames_for(plan: ExportRenamePlan, path: String) -> Array[(String, String)] {\n  let out = empty_aliases()\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  let mut i = 0\n  while i < Array::length(rename_paths) {\n    if Array::get(rename_paths, i) == path {\n      Array::push(out, (Array::get(rename_names, i), Array::get(rename_mangled, i)))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn export_plan_fingerprint_text(plan: ExportRenamePlan) -> String {\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"export-renames\")\n  let mut i = 0\n  while i < Array::length(rename_paths) {\n    StringBuilder::push(buf, \"|\")\n    StringBuilder::push(buf, Array::get(rename_paths, i))\n    StringBuilder::push(buf, \">\")\n    StringBuilder::push(buf, Array::get(rename_names, i))\n    StringBuilder::push(buf, \">\")\n    StringBuilder::push(buf, Array::get(rename_mangled, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn collect_import_value_renames(plan: ExportRenamePlan, path: String, stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = empty_aliases()\n  let locals_seen = empty_strings()\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  if Array::length(rename_paths) == 0 {\n    out\n  } else {\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, items) => {\n          let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, path)\n          let mut j = 0\n          while j < Array::length(items) {\n            let (original, alias_opt) = Array::get(items, j)\n            let local = match alias_opt {\n              Some(alias) => alias,\n              None => original\n            }\n            if String::index_of(original, \"::\") < 0 && !string_array_contains(locals_seen, local) {\n              match plan_triple_lookup(rename_paths, rename_names, rename_mangled, target, original) {\n                Some(mangled) => {\n                  Array::push(out, (local, mangled))\n                  Array::push(locals_seen, local)\n                },\n                None => ()\n              }\n            } else {\n              ()\n            }\n            j = j + 1\n          }\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport fn import_value_rename_locals(renames: Array[(String, String)]) -> Array[String] {\n  let out = empty_strings()\n  let mut i = 0\n  while i < Array::length(renames) {\n    let (local, _) = Array::get(renames, i)\n    Array::push(out, local)\n    i = i + 1\n  }\n  out\n}\n\nexport fn apply_export_renames_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt] {\n  if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      match stmt {\n        SLet(exported, is_rec, name, ty, body) => {\n          let next_name = match lookup_alias(renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n          SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n        },\n        SLetMut(name, ty, body) => SLetMut(name, ty, rewrite_import_alias_expr(body, renames)),\n        SExport(items) => SExport(for item in items {\n          match lookup_alias(renames, item) {\n            Some(renamed) => renamed,\n            None => item\n          }\n        }),\n        STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n        SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n        SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n        SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n        _ => stmt\n      }\n    }\n  }\n}\n\nexport fn rewrite_top_level_fn_alias_refs(stmts: Array[Stmt]) -> Unit {\n  let fn_names = empty_strings()\n  let alias_names = empty_strings()\n  let alias_targets = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => Array::push(fn_names, name),\n        EIdent(target, _) => {\n          Array::push(alias_names, name)\n          Array::push(alias_targets, target)\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if Array::length(alias_names) == 0 {\n    ()\n  } else {\n    let renames = empty_aliases()\n    let mut ai = 0\n    while ai < Array::length(alias_names) {\n      let mut target = Array::get(alias_targets, ai)\n      let mut final_target = \"\"\n      let mut depth = 0\n      while depth < 16 {\n        if string_array_contains(fn_names, target) {\n          final_target = target\n          depth = 16\n        } else {\n          let mut hop = false\n          let mut aj = 0\n          while aj < Array::length(alias_names) && !hop {\n            if Array::get(alias_names, aj) == target {\n              target = Array::get(alias_targets, aj)\n              hop = true\n            } else {\n              aj = aj + 1\n            }\n          }\n          if hop {\n            depth = depth + 1\n          } else {\n            depth = 16\n          }\n        }\n      }\n      if final_target != \"\" && final_target != Array::get(alias_names, ai) {\n        Array::push(renames, (Array::get(alias_names, ai), final_target))\n      } else {\n        ()\n      }\n      ai = ai + 1\n    }\n    if Array::length(renames) == 0 {\n      ()\n    } else {\n      let mut si = 0\n      while si < Array::length(stmts) {\n        match Array::get(stmts, si) {\n          SLet(exported, is_rec, name, ty, body) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, rewrite_import_alias_expr(body, renames))),\n          SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_import_alias_expr(body, renames))),\n          STest(name, body) => Array::set(stmts, si, STest(name, rewrite_import_alias_expr(body, renames))),\n          SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_import_alias_expr(body, renames))),\n          SExpr(body) => Array::set(stmts, si, SExpr(rewrite_import_alias_expr(body, renames))),\n          SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_import_alias_expr(body, renames))),\n          _ => ()\n        }\n        si = si + 1\n      }\n    }\n  }\n}\n\nexport fn append_import_alias_rewritten_non_import_stmts_with_renames(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String], extra_renames: Array[(String, String)]) -> Unit {\n  let legacy = alias_map_without_names(\n    alias_map_without_names(collect_import_aliases(stmts), skipped_locals),\n    import_value_rename_locals(extra_renames)\n  )\n  let combined = empty_aliases()\n  let mut li = 0\n  while li < Array::length(legacy) {\n    Array::push(combined, Array::get(legacy, li))\n    li = li + 1\n  }\n  let mut xi = 0\n  while xi < Array::length(extra_renames) {\n    Array::push(combined, Array::get(extra_renames, xi))\n    xi = xi + 1\n  }\n  let should_rewrite = Array::length(combined) > 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, combined)),\n      _ => if should_rewrite {\n        Array::push(merged, rewrite_import_alias_stmt(stmt, combined))\n      } else {\n        Array::push(merged, stmt)\n      }\n    }\n    i = i + 1\n  }\n}\n")
}

let source_22 = () -> (String, String) {
  ("lib/@vibe/compiler/core/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/core — ADR-0070 / #897 compiler-internal contract. This is\n// the LAST plain directory under lib/@vibe/compiler/ and the highest-risk\n// one: it owns the central type-system enums (`Type`/`TypeDef`/`TypeEnv`/\n// `Subst`, types.vibe) and re-exports the surface-syntax AST enums\n// (`Expr`/`Pat`/`Stmt`/`TypeExpr`) from the external @vibe/ast contract\n// package. All eight enums are pattern-matched and constructed EVERYWHERE\n// across the compiler (checker, codegen, normalize, perceus, every other\n// already-migrated package), so this header documents the type-declaration\n// reasoning in more depth than usual.\n//\n// Directory-shared-scope package (7 impl files + the facade): ast.vibe\n// (cross-package re-export shim, see below), bytebuf.vibe (wasm\n// bytecode-buffer / leb128 helpers), dce.vibe (dead-code elimination over\n// Stmt), polyfill.vibe (__to_string), sorted_index.vibe (sorted-name-table\n// binary search helpers), import_alias_rewrite.vibe (import-alias rewriting\n// + the whole-program export-rename plan), types.vibe (the type-system\n// core: unification, generalization, trait resolution, ...).\n//\n// -- Two-tier type-declaration strategy --\n//\n// (1) Expr/Pat/Stmt/TypeExpr: ast.vibe re-exports these from the EXTERNAL\n// @vibe/ast package (`export ../../../../lib/@vibe/ast { Expr, Pat, Stmt,\n// TypeExpr }`, rewritten from a bare `import {...}` + `export {...}`\n// two-step that does NOT satisfy check_contract as an implementation --\n// only a real local `export fn`/`export type` body or an SReExport counts).\n// They are declared BODYLESS here (`type Expr`, not a transparent copy of\n// @vibe/ast/index.vpkg's full enum bodies), mirroring syntax/index.vpkg's\n// identical `type Token` declaration for its own cross-package re-export of\n// @vibe/parser's Token. check_contract trusts a re-exported name at face\n// value (no body/arity comparison at all, see check_contract's `reexported`\n// handling in contract/contract.vibe) -- @vibe/ast/index.vpkg is what\n// actually pins Expr/Pat/Stmt/TypeExpr's shape, this contract only needs to\n// vouch that core/ makes the name available.\n//\n// (2) Type/TypeDef/TypeEnv/Subst: these are core/'s OWN definitions (real\n// `export enum` bodies in types.vibe, not a re-export), yet they are ALSO\n// declared BODYLESS here (`type Type`, not transparent), NOT full enum\n// bodies. This looks counterintuitive for a type this heavily pattern\n// -matched, but it is the established, triple-precedented pattern for\n// exactly this shape (\"transparent enum with a REAL body already living in\n// a sibling impl file\"):\n//   - @vibe/parser/index.vpkg's `type Token`: \"a transparent contract\n//     definition would hit the impl-before-facade check order, #752 rule\"\n//   - checker/index.vpkg's `type EffectError`: bodyless despite\n//     checker_effects.vibe constructing/matching it constantly\n//   - perceus/index.vpkg's `opaque type PerceusActionKind`: \"enum VARIANTS\n//     do not resolve across units from a facade-only definition (@vibe/json\n//     precedent -- 'unknown name: JNull')... consumers keep full variant\n//     visibility through the same #716 re-export machinery as before\"\n// A FULL transparent body is only correct when the contract IS the sole\n// source of the definition (@vibe/ast/index.vpkg's own Pat/Expr/Stmt/\n// TypeExpr: their impl file, ast.vibe, is an empty stub). Since types.vibe\n// independently carries the real `export enum Type { ... }` etc. bodies,\n// putting the same bodies here too would duplicate the definition through\n// the generated facade (the impl-before-facade hazard above) rather than\n// widen or change the surface. Bodyless declarations here do not narrow\n// what downstream consumers can do: check_contract/collect_impl_type_defs\n// still validates arity (0 for all four) against types.vibe's real defs,\n// and actual pattern-matching/construction resolves through the ordinary\n// dependency closure to types.vibe's real bodies -- proven by contract.vibe\n// itself already pattern-matching @vibe/parser's Token (also bodyless in\n// its origin contract) today.\n//\n// ExportRenamePlan (import_alias_rewrite.vibe) is declared fully `opaque`\n// (not even bodyless-transparent): no external caller accesses its fields\n// via dot-notation, every consumer goes through the accessor fns\n// (export_plan_renames_for, export_plan_rename_count,\n// export_plan_fingerprint_text, collect_import_value_renames), so the\n// struct's field layout is not part of the public surface (@vibe/compiler/\n// perceus's `PCtx`-not-declared caution: do not widen the surface beyond\n// what was already reachable through the old plain index.vibe facade).\n//\n// Naming: no collision on the established `git mv index.vibe <dirname>.vibe`\n// convention -- core/core.vibe did not exist, so the old facade moved\n// verbatim to core.vibe (its own re-export blocks, including the pre-#897\n// `export ./ast.vibe { Expr, Pat, Stmt, TypeExpr }` line, are left\n// untouched and are no longer load-bearing for outside importers now that\n// this contract's generated facade is the source of truth -- same\n// non-load-bearing-old-facade shape as checker_facade.vibe). ast.vibe is\n// listed BEFORE core.vibe below so ast.vibe's own re-export claims\n// Expr/Pat/Stmt/TypeExpr first in facade generation; core.vibe's\n// already-redundant re-export of the same names is simply skipped (already\n// allocated), exactly like checker_facade.vibe's redundant re-export block.\n//\n// No import cycle: core/'s only compiler-internal dependency (beyond its\n// own siblings) is ../module_graph_path.vibe (a top-level compiler file,\n// imported by import_alias_rewrite.vibe), which itself only imports the\n// external @vibe/core package -- it does not import core/ back.\n\n// --- ast (cross-package re-export from @vibe/ast, see header)\ntype Expr\ntype Pat\ntype Stmt\ntype TypeExpr\n\n// --- types (core/'s own type-system enums, see header)\ntype Type\ntype TypeDef\ntype TypeEnv\ntype Subst\n\n// --- core (facade)\n\n// --- polyfill\nfn __to_string(n: Int) -> String\n\n// --- bytebuf\nfn bytebuf_new() -> Bytes\nfn bytebuf_push(buf: Bytes, byte: Int) -> Unit\nfn bytebuf_push2(buf: Bytes, b1: Int, b2: Int) -> Unit\nfn bytebuf_push3(buf: Bytes, b1: Int, b2: Int, b3: Int) -> Unit\nfn bytebuf_push9(buf: Bytes, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit\nfn bytebuf_length(buf: Bytes) -> Int\nfn bytebuf_push_buf(dst: Bytes, src: Bytes) -> Unit\nfn bytebuf_to_bytes(buf: Bytes) -> Bytes\nfn leb128_encode_s32(buf: Bytes, value: Int) -> Unit\nfn leb128_encode_s64(buf: Bytes, value: Int) -> Unit\nfn leb128_encode_u32(buf: Bytes, value: Int) -> Unit\nfn bytebuf_push_string(buf: Bytes, s: String) -> Unit\nfn bytebuf_push_section(out: Bytes, section_id: Int, content: Bytes) -> Unit\nfn bytebuf_push_opcode_s64(buf: Bytes, opcode: Int, value: Int) -> Unit\nfn bytebuf_push_opcode_u32(buf: Bytes, opcode: Int, value: Int) -> Unit\nfn bytebuf_push_vec_header(buf: Bytes, count: Int) -> Unit\nfn bytebuf_push_opcode_u32_u32(buf: Bytes, opcode: Int, a: Int, b: Int) -> Unit\n\n// --- dce\nfn dce_stmts(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt]\nfn dce_keep_flags(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool]\n\n// --- types\nfn env_bind(env: TypeEnv, name: String, ty: Type) -> TypeEnv\nfn env_cache(env: TypeEnv) -> TypeEnv\nfn fresh_var(c: Int) -> (Type, Int)\nfn occurs_in(id: Int, ty: Type) -> Bool\nfn env_lookup(env: TypeEnv, name: String) -> Option[Type]\nfn env_bind_all(env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv\nfn find_typedef(defs: Array[TypeDef], name: String) -> Option[TypeDef]\nfn subst_lookup(s: Subst, id: Int) -> Option[Type]\nfn trait_supers(env: TypeEnv, name: String) -> Array[String]\nfn trait_method_sig(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)]\nfn type_name_has_iterator_impl(env: TypeEnv, type_name: String) -> Bool\nfn trait_method_sig_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)]\nfn subst_bounds_for(s: Subst, id: Int) -> Array[String]\nfn subst_apply(s: Subst, ty: Type) -> Type\nfn trait_defined(env: TypeEnv, name: String) -> Bool\nfn type_to_string(ty: Type) -> String\nfn env_lookup_flat(bindings: Array[(String, Type)], name: String) -> Option[Type]\nfn resolve_builtin(name: String) -> Option[Type]\nfn subst_add_bound(s: Subst, id: Int, bounds: Array[String]) -> Subst\nfn instantiate(ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])])\nfn trait_is_subtrait(env: TypeEnv, sub: String, super_name: String) -> Bool\nfn collect_tvars(ty: Type) -> Array[Int]\nfn env_flat_bindings(env: TypeEnv) -> Array[(String, Type)]\nfn types_equal(a: Type, b: Type) -> Bool\nfn unify(a: Type, b: Type, s: Subst) -> Option[Subst]\nfn types_compatible(expected: Type, actual: Type) -> Bool\nfn impls_overlap_for(env: TypeEnv, trait_name: String, new_target: Type) -> Bool\nfn collect_subst_bounds_pairs(s: Subst) -> Array[(Int, Array[String])]\nfn generalize(s: Subst, ty: Type) -> Type\nfn type_implements_trait(env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool\n\n// --- import_alias_rewrite\nopaque type ExportRenamePlan\n\nfn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr\nfn collect_import_aliases(stmts: Array[Stmt]) -> Array[(String, String)]\nfn collect_import_alias_collision_refs(stmts: Array[Stmt]) -> Array[(String, String, String)]\nfn collect_import_alias_collision_locals(stmts: Array[Stmt]) -> Array[String]\nfn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt\nfn stmts_have_import_deep(stmts: Array[Stmt]) -> Bool\nfn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit\nfn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit\nfn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit\nfn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt]\nfn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt]\nfn namespace_exported_name(path: String, name: String) -> String\nfn collect_export_def_value_names(stmts: Array[Stmt]) -> Array[String]\nfn build_export_rename_plan(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String) -> ExportRenamePlan\nfn export_plan_rename_count(plan: ExportRenamePlan) -> Int\nfn export_plan_renames_for(plan: ExportRenamePlan, path: String) -> Array[(String, String)]\nfn export_plan_fingerprint_text(plan: ExportRenamePlan) -> String\nfn collect_import_value_renames(plan: ExportRenamePlan, path: String, stmts: Array[Stmt]) -> Array[(String, String)]\nfn import_value_rename_locals(renames: Array[(String, String)]) -> Array[String]\nfn apply_export_renames_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt]\nfn rewrite_top_level_fn_alias_refs(stmts: Array[Stmt]) -> Unit\nfn append_import_alias_rewritten_non_import_stmts_with_renames(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String], extra_renames: Array[(String, String)]) -> Unit\n\n// --- sorted_index\nfn str_lt(a: String, b: String) -> Bool\nfn sort_perm_by_names(names: Array[String]) -> Array[Int]\nfn apply_perm_strings(names: Array[String], perm: Array[Int]) -> Array[String]\nfn sorted_names_of(names: Array[String]) -> Array[String]\nfn bsearch_leftmost(sorted: Array[String], name: String) -> Int\n\n// --- module_graph_path (relocated here from compiler/ top level, #897\n// batch; needed leaf-directly by loader/, runtime/, entry/'s FS-compile\n// files, and cache/ -- see this batch's PR description for the full\n// consumer list)\nfn is_contract_ext(path: String) -> Bool\nfn dir_of_path(file_path: String) -> String\nfn ensure_regular_source_fs(path: String) -> Unit with { Error, Fs }\nfn path_in_dir(dir: String, basename: String) -> String\nfn vpkg_path_in_dir(dir: String) -> String\nfn nearest_vpkg_path_fs(path: String) -> String with { Error, Fs }\nfn contains_name(items: Array[String], name: String) -> Bool\nfn contains_path(visited: Array[String], path: String) -> Bool\nfn path_set_new() -> Array[Array[String]]\nfn path_set_contains(set: Array[Array[String]], path: String) -> Bool\nfn path_set_add(set: Array[Array[String]], path: String) -> Unit\nfn normalize_path(path: String) -> String\nfn get_export_name(items: Array[(String, Option[String])], name: String) -> String\nfn path_to_module_name(path: String) -> String\nfn path_has_relative_prefix(raw_path: String, len: Int) -> Bool\nfn resolve_import_path(base_dir: String, raw_path: String) -> String\nfn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String]\nfn external_lib_roots() -> Array[String]\nfn vibe_env_flag(name: String) -> Bool\nfn resolution_env_seed() -> String\nfn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String]\n")
}

