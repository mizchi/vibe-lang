n  let exp_names = array_empty()\n  let exp_idxs = new_int_array()\n  Array::push(exp_names, \"fd_write\")\n  Array::push(exp_idxs, 0)\n  let mut ei = 0\n  while ei < n {\n    Array::push(exp_names, Array::get(vibe_names, ei))\n    Array::push(exp_idxs, ei + 1)\n    ei = ei + 1\n  }\n  emit_export_section_multi(out, exp_names, exp_idxs)\n  let bodies = Array::slice([\n    (bytebuf_new())\n  ], 0, 0)\n  let fd_body = bytebuf_new()\n  emit_i32_const(fd_body, 0)\n  Array::push(bodies, fd_body)\n  let mut bi = 0\n  while bi < n {\n    let body = bytebuf_new()\n    let sn = Array::get(vibe_names, bi)\n    if sn == \"env-get\" || sn == \"fs_write_file\" || sn == \"fs_write_bytes\" || sn == \"profile-now-us\" {\n      let sig = Array::get(vibe_sigs, bi)\n      let pc = Array::get(sig, 0)\n      let rc = Array::get(sig, 1 + pc)\n      if rc >= 1 {\n        if Array::get(sig, 2 + pc) == 127 {\n          emit_i32_const(body, 0)\n        } else {\n          emit_i64_const(body, 0)\n        }\n      } else {\n        ()\n      }\n    } else {\n      bytebuf_push(body, 0)\n    }\n    Array::push(bodies, body)\n    bi = bi + 1\n  }\n  emit_code_section(out, bodies)\n  bytebuf_to_bytes(out)\n}\n\nfn comp_emit_string_handler_impl(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String], stub_vibe: Bool) -> Bytes with { Error } {\n  let string_param_count = Array::length(param_names)\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut target_sig_ok = false\n  let mut target_found = false\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == target_func_name {\n      target_found = true\n      let sig = Array::get(export_type_sigs, ei)\n      let core_param_count = string_param_count + 1\n      if Array::length(sig) == (core_param_count + 3) {\n        let mut ok = Array::get(sig, 0) == core_param_count\n        let mut pi = 0\n        while pi < core_param_count {\n          if Array::get(sig, 1 + pi) != 126 {\n            ok = false\n          }\n          pi = pi + 1\n        }\n        if Array::get(sig, 1 + core_param_count) != 1 {\n          ok = false\n        }\n        if Array::get(sig, 2 + core_param_count) != 126 {\n          ok = false\n        }\n        target_sig_ok = ok\n      }\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  if !target_found {\n    throw(\"component: core module does not export '\\{target_func_name}'\")\n  }\n  if !target_sig_ok {\n    throw(\"component: '\\{target_func_name}' must take \\{string_param_count} String params and return String\")\n  }\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let vibe_stub_names = array_empty()\n  let vibe_stub_sigs = array_empty()\n  let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else if stub_vibe && im == \"vibe\" {\n      Array::push(vibe_stub_names, ifn)\n      Array::push(vibe_stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))\n    } else {\n      throw(\"component: handler uses host import '\\{im}.\\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)\")\n    }\n    ii = ii + 1\n  }\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\n  emit_core_module_section(buf, comp_generate_host_stub_module(vibe_stub_names, vibe_stub_sigs)