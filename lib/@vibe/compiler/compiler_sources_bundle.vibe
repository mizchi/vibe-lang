uf_new()\n  bytebuf_push_vec_header(tc, 5)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    126\n  ])\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 7)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"read-file\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"exists\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 1)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"read-dir\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"stat-token\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 2)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"cabi_realloc\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 4)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"t\")\n  bytebuf_push(import_sec, 1)\n  bytebuf_push(import_sec, 112)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 4)\n  bytebuf_push_section(out, 2, import_sec)\n  emit_function_section(out, [\n    3,\n    3,\n    3,\n    3\n  ])\n  let elem_sec = bytebuf_new()\n  leb128_encode_u32(elem_sec, 1)\n  bytebuf_push(elem_sec, 0)\n  emit_i32_const(elem_sec, 0)\n  bytebuf_push(elem_sec, 11)\n  leb128_encode_u32(elem_sec, 4)\n  leb128_encode_u32(elem_sec, 5)\n  leb128_encode_u32(elem_sec, 6)\n  leb128_encode_u32(elem_sec, 7)\n  leb128_encode_u32(elem_sec, 8)\n  bytebuf_push_section(out, 9, elem_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 4)\n  let mut sri = 0\n  while sri < 2 {\n    let body = bytebuf_new()\n    leb128_encode_u32(body, 1)\n    leb128_encode_u32(body, 1)\n    bytebuf_push(body, 127)\n    emit_i32_const(body, 0)\n    emit_i32_const(body, 0)\n    emit_i32_const(body, 4)\n    emit_i32_const(body, 8)\n    bytebuf_push(body, 16)\n    leb128_encode_u32(body, 4)\n    emit_local_set(body, 1)\n    emit_local_get(body, 0)\n    emit_i64_const(body, 32)\n    bytebuf_push(body, 136)\n    bytebuf_push(body, 167)\n    emit_local_get(body, 0)\n    bytebuf_push(body, 167)\n    emit_local_get(body, 1)\n    bytebuf_push(body, 16)\n    leb128_encode_u32(body, if sri == 0 {\n      0\n    } else {\n      2\n    })\n    emit_local_get(body, 1)\n    bytebuf_push(body, 40)\n    leb128_encode_u32(body, 2)\n    leb128_encode_u32(body, 0)\n    bytebuf_push(body, 173)\n    emit_i64_const(body, 32)\n    bytebuf_push(body, 134)\n    emit_local_get(body, 1)\n    bytebuf_push(body, 40)\n    leb128_encode_u32(body, 2)\n    leb128_encode_u32(body, 4)\n    bytebuf_push(body, 173)\n    bytebuf_push(body, 132)\n    bytebuf_push(body, 11)\n    if sri == 0 {\n      leb128_encode_u32(code_sec, Bytes::length(body))\n      bytebuf_push_buf(code_sec, body)\n      let exists_body = bytebuf_new()\n      leb128_encode_u32(exists_body, 0)\n      emit_local_get(exists_body, 0)\n      emit_i64_const(exists_body, 32)\n      bytebuf_push(exists_body, 136)\n      bytebuf_push(exists_body, 167)\n      emit_local_get(exists_body, 0)\n      bytebuf_push(exists_body, 167)\n      bytebuf_push(exists_body, 16)\n      leb128_encode_u32(exists_body, 1)\n      bytebuf_push(exists_body, 173)\n      bytebuf_push(exists_body, 11)\n      leb128_encode_u32(code_sec, Bytes::length(exists_body))\n      bytebuf_push_buf(code_sec, exists_body)\n    } else {\n      leb128_encode_u32(code_sec, Bytes::length(body))\n      bytebuf_push_buf(code_sec, body)\n      let stat_body = bytebuf_new()\n      leb128_encode_u32(stat_body, 0)\n      emit_local_get(stat_body, 0)\n      emit_i64_const(stat_body, 32)\n      bytebuf_push(stat_body, 136)\n      bytebuf_push(stat_body, 167)\n      emit_local_get(stat_body, 0)\n      bytebuf_push(stat_body, 167)\n      bytebuf_push(stat_body, 16)\n      leb128_encode_u32(stat_body, 3)\n      bytebuf_push(stat_body, 11)\n      leb128_encode_u32(code_sec, Bytes::length(stat_body))\n      bytebuf_push_buf(code_sec, stat_body)\n    }\n    sri = sri + 1\n  }\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\nexport fn comp_emit_component_wasm_string_handler_vfs(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\n  let string_param_count = Array::length(param_names)\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut target_sig_ok = false\n  let mut target_found = false\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == target_func_name {\n      target_found = true\n      let sig = Array::get(export_type_sigs, ei)\n      let core_param_count = string_param_count + 1\n      if Array::length(sig) == (core_param_count + 3) {\n        let mut ok = Array::get(sig, 0) == core_param_count\n        let mut pi = 0\n        while pi < core_param_count {\n          if Array::get(sig, 1 + pi) != 126 {\n            ok = false\n          }\n          pi = pi + 1\n        }\n        if Array::get(sig, 1 + core_param_count) != 1 {\n          ok = false\n        }\n        if Array::get(sig, 2 + core_param_count) != 126 {\n          ok = false\n        }\n        target_sig_ok = ok\n      }\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  if !target_found {\n    throw(\"component(vfs): core module does not export '\\{target_func_name}'\")\n  }\n  if !target_sig_ok {\n    throw(\"component(vfs): '\\{target_func_name}' must take \\{string_param_count} String params and return String\")\n  }\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let vibe_import_names = array_empty()\n  let stub_names = array_empty()\n  let stub_sigs = array_empty()\n  let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else if im == \"vibe\" {\n      Array::push(vibe_import_names, ifn)\n      if ifn == \"fs_read_file\" || ifn == \"fs_exists\" || ifn == \"fs_read_dir\" || ifn == \"fs_stat_token\" {\n        ()\n      } else {\n        Array::push(stub_names, ifn)\n        Array::push(stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))\n      }\n    } else {\n      throw(\"component(vfs): unsupported host import '\\{im}.\\{ifn}'\")\n    }\n    ii = ii + 1\n  }\n  let stub_count = Array::length(stub_names)\n  let f_target = 4 + stub_count\n  let f_realloc = 5 + stub_count\n  let f_lower0 = 6 + stub_count\n  let f_canon = 10 + stub_count\n  let f_tramp_realloc = 11 + stub_count\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  bytebuf_push(buf, section_type)\n  let vfs_types = bytebuf_new()\n  leb128_encode_u32(vfs_types, 4)\n  let path_param = array_empty()\n  Array::push(path_param, \"path\")\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_string\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_bool\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_string\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_s64\n  ], 0)\n  emit_raw_content(buf, vfs_types)\n  let vfs_import_names = array_empty()\n  Array::push(vfs_import_names, \"read-file\")\n  Array::push(vfs_import_names, \"exists\")\n  Array::push(vfs_import_names, \"read-dir\")\n  Array::push(vfs_import_names, \"stat-token\")\n  emit_comp_import_section(buf, vfs_import_names, 4)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\n  emit_core_module_section(buf, comp_generate_host_stub_module(stub_names, stub_sigs))\n  emit_core_module_section(buf, comp_generate_vfs_shim())\n  emit_core_module_section(buf, comp_generate_vfs_realloc())\n  emit_core_module_section(buf, comp_generate_vfs_adapter())\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  emit_core_instance_instantiate_section(buf, 3, array_empty())\n  let shim_fn_names = array_empty()\n  Array::push(shim_fn_names, \"fs_read_file\")\n  Array::push(shim_fn_names, \"fs_exists\")\n  Array::push(shim_fn_names, \"fs_read_dir\")\n  Array::push(shim_fn_names, \"fs_stat_token\")\n  emit_alias_section(buf, 1, shim_fn_names, [\n    core_sort_func,\n    core_sort_func,\n    core_sort_func,\n    core_sort_func\n  ])\n  let stub_sorts = new_int_array()\n  let mut ssi = 0\n  while ssi < stub_count {\n    Array::push(stub_sorts, core_sort_func)\n    ssi = ssi + 1\n  }\n  emit_alias_section(buf, 0, stub_names, stub_sorts)\n  let vibe_inst_names = array_empty()\n  let vibe_inst_sorts = new_int_array()\n  let vibe_inst_indices = new_int_array()\n  let mut vi = 0\n  while vi < Array::length(vibe_import_names) {\n    let vn = Array::get(vibe_import_names, vi)\n    Array::push(vibe_inst_names, vn)\n    Array::push(vibe_inst_sorts, core_sort_func)\n    if vn == \"fs_read_file\" {\n      Array::push(vibe_inst_indices, 0)\n    } else if vn == \"fs_exists\" {\n      Array::push(vibe_inst_indices, 1)\n    } else if vn == \"fs_read_dir\" {\n      Array::push(vibe_inst_indices, 2)\n    } else if vn == \"fs_stat_token\" {\n      Array::push(vibe_inst_indices, 3)\n    } else {\n      let mut sj = 0\n      let mut found_at = -1\n      while sj < stub_count {\n        if Array::get(stub_names, sj) == vn && found_at == -1 {\n          found_at = sj\n        }\n        sj = sj + 1\n      }\n      Array::push(vibe_inst_indices, 4 + found_at)\n    }\n    vi = vi + 1\n  }\n  emit_core_instance_from_exports_sorted(buf, vibe_inst_names, vibe_inst_sorts, vibe_inst_indices)\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\",\n    \"vibe\"\n  ], [\n    0,\n    2\n  ])\n  let main_alias_names = array_empty()\n  Array::push(main_alias_names, target_func_name)\n  Array::push(main_alias_names, \"memory\")\n  Array::push(main_alias_names, \"__heap_ptr\")\n  emit_alias_section(buf, 3, main_alias_names, [\n    core_sort_func,\n    core_sort_mem,\n    core_sort_global\n  ])\n  let renv_names = array_empty()\n  Array::push(renv_names, \"__heap_ptr\")\n  Array::push(renv_names, \"memory\")\n  emit_core_instance_from_exports_sorted(buf, renv_names, [\n    core_sort_global,\n    core_sort_mem\n  ], [\n    0,\n    0\n  ])\n  emit_core_instance_instantiate_args(buf, 4, [\n    \"env\"\n  ], [\n    4\n  ])\n  let realloc_names = array_empty()\n  Array::push(realloc_names, \"cabi_realloc\")\n  emit_alias_section(buf, 5, realloc_names, [\n    core_sort_func\n  ])\n  bytebuf_push(buf, section_canon)\n  let lower_content = bytebuf_new()\n  leb128_encode_u32(lower_content, 4)\n  let mut li = 0\n  while li < 4 {\n    bytebuf_push(lower_content, 1)\n    bytebuf_push(lower_content, 0)\n    leb128_encode_u32(lower_content, li)\n    if li == 0 || li == 2 {\n      leb128_encode_u32(lower_content, 3)\n      bytebuf_push(lower_content, 0)\n      bytebuf_push(lower_content, 3)\n      leb128_encode_u32(lower_content, 0)\n      bytebuf_push(lower_content, 4)\n      leb128_encode_u32(lower_content, f_realloc)\n    } else {\n      leb128_encode_u32(lower_content, 2)\n      bytebuf_push(lower_content, 0)\n      bytebuf_push(lower_content, 3)\n      leb128_encode_u32(lower_content, 0)\n    }\n    li = li + 1\n  }\n  emit_raw_content(buf, lower_content)\n  let table_names = array_empty()\n  Array::push(table_names, \"t\")\n  emit_alias_section(buf, 1, table_names, [\n    1\n  ])\n  let vfs_inst_names = array_empty()\n  Array::push(vfs_inst_names, \"read-file\")\n  Array::push(vfs_inst_names, \"exists\")\n  Array::push(vfs_inst_names, \"read-dir\")\n  Array::push(vfs_inst_names, \"stat-token\")\n  emit_core_instance_from_exports_sorted(buf, vfs_inst_names, [\n    core_sort_func,\n    core_sort_func,\n    core_sort_func,\n    core_sort_func\n  ], [\n    f_lower0,\n    f_lower0 + 1,\n    f_lower0 + 2,\n    f_lower0 + 3\n  ])\n  let aenv_names = array_empty()\n  Array::push(aenv_names, \"cabi_realloc\")\n  Array::push(aenv_names, \"memory\")\n  Array::push(aenv_names, \"t\")\n  emit_core_instance_from_exports_sorted(buf, aenv_names, [\n    core_sort_func,\n    core_sort_mem,\n    1\n  ], [\n    f_realloc,\n    0,\n    0\n  ])\n  emit_core_instance_instantiate_args(buf, 5, [\n    \"vfs\",\n    \"env\"\n  ], [\n    6,\n    7\n  ])\n  let tenv_names = array_empty()\n  Array::push(tenv_names, \"target_func\")\n  Array::push(tenv_names, \"__heap_ptr\")\n  Array::push(tenv_names, \"memory\")\n  emit_core_instance_from_exports_sorted(buf, tenv_names, [\n    core_sort_func,\n    core_sort_global,\n    core_sort_mem\n  ], [\n    f_target,\n    0,\n    0\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"env\"\n  ], [\n    9\n  ])\n  let tramp_names = array_empty()\n  Array::push(tramp_names, \"canon_func\")\n  Array::push(tramp_names, \"cabi_realloc\")\n  emit_alias_section(buf, 10, tramp_names, [\n    core_sort_func,\n    core_sort_func\n  ])\n  bytebuf_push(buf, section_type)\n  let export_type = bytebuf_new()\n  leb128_encode_u32(export_type, 1)\n  let comp_param_types = new_int_array()\n  let mut pt = 0\n  while pt < string_param_count {\n    Array::push(comp_param_types, comp_valtype_string)\n    pt = pt + 1\n  }\n  emit_comp_func_type(export_type, comp_param_types, param_names, [\n    comp_valtype_string\n  ], 0)\n  emit_raw_content(buf, export_type)\n  bytebuf_push(buf, section_canon)\n  let lift_content = bytebuf_new()\n  leb128_encode_u32(lift_content, 1)\n  emit_canon_lift_func(lift_content, f_canon, 4, 1, 0, f_tramp_realloc)\n  emit_raw_content(buf, lift_content)\n  emit_comp_export_section(buf, export_name, 4)\n  bytebuf_to_bytes(buf)\n}\n")
}

let source_111 = () -> (String, String) {
  ("lib/@vibe/compiler/wit_gen.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Stmt, TypeExpr, is_exception_effect_name\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn wit_lower_char(c: Int) -> Int {\n  if c >= 65 && c <= 90 {\n    c + 32\n  } else {\n    c\n  }\n}\n\nexport fn wit_kebab_ident(name: String) -> String {\n  let sb = StringBuilder::new()\n  let len = String::length(name)\n  let mut i = 0\n  let mut prev_dash = true\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      prev_dash = true\n    } else if c >= 65 && c <= 90 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      StringBuilder::push(sb, String::from_char_code(wit_lower_char(c)))\n      prev_dash = false\n    } else {\n      StringBuilder::push(sb, String::from_char_code(c))\n      prev_dash = false\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn wit_is_unit_type(ty: TypeExpr) -> Bool {\n  match ty {\n    TyUnit => true,\n    TyName(name) => name == \"Unit\",\n    _ => false\n  }\n}\n\nexport fn wit_type_text(ty: TypeExpr) -> String with { Error } {\n  match ty {\n    TyName(name) => {\n      if name == \"Int\" {\n        \"s64\"\n      } else if name == \"Double\" {\n        \"f64\"\n      } else if name == \"Bool\" {\n        \"bool\"\n      } else if name == \"String\" {\n        \"string\"\n      } else if name == \"Char\" {\n        \"char\"\n      } else if name == \"Bytes\" {\n        \"list<u8>\"\n      } else if name == \"ByteStream\" {\n        \"stream<u8>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{name}' (supported: Int, Double, Bool, String, Char, Bytes, Unit, Array, Option, Result, Map, tuples, Future[T], ByteStream)\")\n      }\n    },\n    TyApp(head, args) => {\n      if head == \"Array\" && Array::length(args) == 1 {\n        \"list<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Option\" && Array::length(args) == 1 {\n        \"option<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Result\" && Array::length(args) == 2 {\n        \"result<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>\"\n      } else if head == \"Map\" && Array::length(args) == 2 {\n        \"list<tuple<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>>\"\n      } else if head == \"Future\" && Array::length(args) == 1 {\n        \"future<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{head}[..]'\")\n      }\n    },\n    TyTuple(items) => {\n      let sb = StringBuilder::new()\n      StringBuilder::push(sb, \"tuple<\")\n      let mut i = 0\n      while i < Array::length(items) {\n        if i > 0 {\n          StringBuilder::push(sb, \", \")\n        }\n        StringBuilder::push(sb, wit_type_text(Array::get(items, i)))\n        i = i + 1\n      }\n      StringBuilder::push(sb, \">\")\n      StringBuilder::freeze(sb)\n    },\n    TyFn(_, _, _) => throw(\"wit: function types cannot cross the WIT boundary\"),\n    TyUnit => throw(\"wit: Unit is only valid as a return type\")\n  }\n}\n\nfn wit_func_text_of(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr, is_async: Bool) -> String with { Error } {\n  let sb = StringBuilder::new()\n  if is_async {\n    StringBuilder::push(sb, \"async \")\n  } else {\n    ()\n  }\n  StringBuilder::push(sb, \"func(\")\n  let mut i = 0\n  while i < Array::length(param_types) {\n    if i > 0 {\n      StringBuilder::push(sb, \", \")\n    }\n    let pname = if i < Array::length(param_names) {\n      wit_kebab_ident(Array::get(param_names, i))\n    } else {\n      \"arg\\{i}\"\n    }\n    StringBuilder::push(sb, pname)\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_type_text(Array::get(param_types, i)))\n    i = i + 1\n  }\n  StringBuilder::push(sb, \")\")\n  if !wit_is_unit_type(ret) {\n    StringBuilder::push(sb, \" -> \")\n    StringBuilder::push(sb, wit_type_text(ret))\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn wit_func_text(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr) -> String with { Error } {\n  wit_func_text_of(param_names, param_types, ret, false)\n}\n\nfn wit_split_effect_row(row: String) -> Array[String] {\n  let out = array_empty()\n  let len = String::length(row)\n  let mut piece = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(row, i)\n    if c == 44 {\n      if String::length(piece) > 0 {\n        Array::push(out, piece)\n      }\n      piece = \"\"\n    } else if c == 32 {\n      ()\n    } else {\n      piece = String::concat(piece, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  if String::length(piece) > 0 {\n    Array::push(out, piece)\n  }\n  out\n}\n\nfn wit_array_contains(items: Array[String], needle: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(items) {\n    if Array::get(items, i) == needle {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn wit_export_of_slet(name: String, ann: Option[TypeExpr], body: Expr) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let efn_param_names = array_empty()\n  let efn_param_types = array_empty()\n  let mut efn_params_ok = true\n  let mut efn_ret = None\n  let mut efn_eff = None\n  match body {\n    EFn(_, _, params, ret_opt, eff_opt, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, pty_opt) = Array::get(params, i)\n        Array::push(efn_param_names, pname)\n        match pty_opt {\n          Some(pty) => Array::push(efn_param_types, pty),\n          None => {\n            efn_params_ok = false\n          }\n        }\n        i = i + 1\n      }\n      efn_ret = ret_opt\n      efn_eff = eff_opt\n    },\n    _ => {\n      efn_params_ok = false\n    }\n  }\n  let mut ann_fn = None\n  match ann {\n    Some(ty) => match ty {\n      TyFn(ptys, rty, eff) => {\n        ann_fn = Some((ptys, rty, eff))\n      },\n      _ => ()\n    },\n    None => ()\n  }\n  match ann_fn {\n    Some(fn_parts) => {\n      let (ptys, rty, eff) = fn_parts\n      let effects = match eff {\n        Some(row) => wit_split_effect_row(row),\n        None => array_empty()\n      }\n      Some((name, efn_param_names, ptys, rty, effects))\n    },\n    None => {\n      if efn_params_ok {\n        match efn_ret {\n          Some(rty) => {\n            let effects = match efn_eff {\n              Some(row) => wit_split_effect_row(row),\n              None => array_empty()\n            }\n            Some((name, efn_param_names, Array::slice(efn_param_types, 0, Array::length(efn_param_types)), rty, effects))\n          },\n          None => None\n        }\n      } else {\n        None\n      }\n    }\n  }\n}\n\n\nexport fn serve_handler_param_names() -> Array[String] {\n  [\n    \"method\",\n    \"url\",\n    \"headers\",\n    \"body\"\n  ]\n}\n\nfn wit_type_is_string(ty: TypeExpr) -> Bool {\n  match ty {\n    TyName(name) => name == \"String\",\n    _ => false\n  }\n}\n\nexport fn validate_serve_handler(entry_stmts: Array[Stmt]) -> Unit with { Error } {\n  let contract = \"serve: expected `export let handler = (method: String, url: String, headers: String, body: String) -> String`\"\n  match wit_boundary_signature(entry_stmts, \"handler\") {\n    None => throw(String::concat(contract, \" (no exported `handler` with a full type annotation found)\")),\n    Some(sig) => {\n      let (_sname, _spnames, sig_param_types, sig_ret, sig_effects) = sig\n      if Array::length(sig_param_types) != 4 {\n        throw(String::concat(contract, \" (found \\{Array::length(sig_param_types)} params)\"))\n      }\n      let mut pi = 0\n      while pi < Array::length(sig_param_types) {\n        if !wit_type_is_string(Array::get(sig_param_types, pi)) {\n          throw(String::concat(contract, \" (param \\{pi} is not String)\"))\n        }\n        pi = pi + 1\n      }\n      if !wit_type_is_string(sig_ret) {\n        throw(String::concat(contract, \" (return type is not String)\"))\n      }\n      let mut ei = 0\n      while ei < Array::length(sig_effects) {\n        let ename = Array::get(sig_effects, ei)\n        if !is_exception_effect_name(ename) {\n          throw(\"serve: handler requires capability effect '\\{ename}'; a serve handler must be a pure function of its request params (discharge the effect with `handle` inside the file)\")\n        }\n        ei = ei + 1\n      }\n    }\n  }\n}\n\nexport fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, sname, ann, body) => {\n        if exported && sname == name {\n          found = wit_export_of_slet(sname, ann, body)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn wit_collect_effect_defs(stmts: Array[Stmt], out_names: Array[String], out_ops: Array[Array[(String, Array[TypeExpr], TypeExpr)]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, ops) => {\n        if !wit_array_contains(out_names, name) {\n          Array::push(out_names, name)\n          Array::push(out_ops, ops)\n        }\n      },\n      SModule(_, _, inner) => wit_collect_effect_defs(inner, out_names, out_ops),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn wit_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      SModule(_, _, inner) => wit_es_collect_into(inner, es_names, es_members_list),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn wit_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if wit_array_contains(path, name) {\n    ()\n  } else {\n    let idx_of = {\n      let mut i = 0\n      let mut found = -1\n      while i < Array::length(es_names) {\n        if Array::get(es_names, i) == name {\n          found = i\n        }\n        i = i + 1\n      }\n      found\n    }\n    if idx_of < 0 {\n      if wit_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx_of)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        wit_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn wit_effect_name_of(label: String) -> String {\n  let idx = String::index_of(label, \"::\")\n  if idx > 0 {\n    String::substring(label, 0, idx)\n  } else {\n    label\n  }\n}\n\nfn wit_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {\n  let is_effectset = {\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(es_names) {\n      if Array::get(es_names, i) == label {\n        found = true\n      }\n      i = i + 1\n    }\n    found\n  }\n  if is_effectset {\n    let leaves = array_empty()\n    wit_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)\n    let mut li = 0\n    while li < Array::length(leaves) {\n      let ename = wit_effect_name_of(Array::get(leaves, li))\n      if wit_array_contains(out, ename) {\n        ()\n      } else {\n        Array::push(out, ename)\n      }\n      li = li + 1\n    }\n  } else {\n    let ename = wit_effect_name_of(label)\n    if wit_array_contains(out, ename) {\n      ()\n    } else {\n      Array::push(out, ename)\n    }\n  }\n}\n\nexport fn wit_from_program(export_stmts: Array[Stmt], effect_stmts: Array[Stmt], world_name: String) -> String with { Error } {\n  let eff_names = array_empty()\n  let eff_ops = array_empty()\n  wit_collect_effect_defs(effect_stmts, eff_names, eff_ops)\n  wit_collect_effect_defs(export_stmts, eff_names, eff_ops)\n  let wit_es_names = array_empty()\n  let wit_es_members_list = array_empty()\n  wit_es_collect_into(effect_stmts, wit_es_names, wit_es_members_list)\n  wit_es_collect_into(export_stmts, wit_es_names, wit_es_members_list)\n  let exports = array_empty()\n  let mut i = 0\n  while i < Array::length(export_stmts) {\n    match Array::get(export_stmts, i) {\n      SLet(exported, _, name, ann, body) => {\n        if exported {\n          match wit_export_of_slet(name, ann, body) {\n            Some(ex) => Array::push(exports, ex),\n            None => ()\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let used_effects = array_empty()\n  let mut xi = 0\n  while xi < Array::length(exports) {\n    let (_xn, _xp, _xt, _xr, ex_effects) = Array::get(exports, xi)\n    let mut ei = 0\n    while ei < Array::length(ex_effects) {\n      let ename = Array::get(ex_effects, ei)\n      if !is_exception_effect_name(ename) {\n        let resolved = array_empty()\n        wit_resolve_effect_names_into(ename, wit_es_names, wit_es_members_list, resolved)\n        let mut ri = 0\n        while ri < Array::length(resolved) {\n          let rname = Array::get(resolved, ri)\n          if rname == \"Async\" {\n            ()\n          } else if !is_exception_effect_name(rname) && !wit_array_contains(used_effects, rname) {\n            Array::push(used_effects, rname)\n          } else {\n            ()\n          }\n          ri = ri + 1\n        }\n      } else {\n        ()\n      }\n      ei = ei + 1\n    }\n    xi = xi + 1\n  }\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"package vibe:app;\\n\\nworld \")\n  StringBuilder::push(sb, wit_kebab_ident(world_name))\n  StringBuilder::push(sb, \" {\\n\")\n  let mut ui = 0\n  while ui < Array::length(used_effects) {\n    let ename = Array::get(used_effects, ui)\n    let mut def_idx = 0 - 1\n    let mut di = 0\n    while di < Array::length(eff_names) {\n      if Array::get(eff_names, di) == ename {\n        def_idx = di\n      }\n      di = di + 1\n    }\n    if def_idx >= 0 {\n      StringBuilder::push(sb, \"  import \")\n      StringBuilder::push(sb, wit_kebab_ident(ename))\n      StringBuilder::push(sb, \": interface {\\n\")\n      let ops = Array::get(eff_ops, def_idx)\n      let mut oi = 0\n      while oi < Array::length(ops) {\n        let (op_name, op_args, op_ret) = Array::get(ops, oi)\n        StringBuilder::push(sb, \"    \")\n        StringBuilder::push(sb, wit_kebab_ident(op_name))\n        StringBuilder::push(sb, \": \")\n        StringBuilder::push(sb, wit_func_text(array_empty(), op_args, op_ret))\n        StringBuilder::push(sb, \";\\n\")\n        oi = oi + 1\n      }\n      StringBuilder::push(sb, \"  }\\n\")\n    } else {\n      StringBuilder::push(sb, \"  // host capability effect '\")\n      StringBuilder::push(sb, ename)\n      StringBuilder::push(sb, \"' (provided by the vibe runtime; no WIT mapping yet)\\n\")\n    }\n    ui = ui + 1\n  }\n  let mut xo = 0\n  while xo < Array::length(exports) {\n    let (ex_name, ex_param_names, ex_param_types, ex_ret, ex_effects) = Array::get(exports, xo)\n    let mut is_async = false\n    let mut ai = 0\n    while ai < Array::length(ex_effects) {\n      let alabel = Array::get(ex_effects, ai)\n      let aresolved = array_empty()\n      wit_resolve_effect_names_into(alabel, wit_es_names, wit_es_members_list, aresolved)\n      if wit_array_contains(aresolved, \"Async\") {\n        is_async = true\n      } else {\n        ()\n      }\n      ai = ai + 1\n    }\n    StringBuilder::push(sb, \"  export \")\n    StringBuilder::push(sb, wit_kebab_ident(ex_name))\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_func_text_of(ex_param_names, ex_param_types, ex_ret, is_async))\n    StringBuilder::push(sb, \";\\n\")\n    xo = xo + 1\n  }\n  StringBuilder::push(sb, \"}\\n\")\n  StringBuilder::freeze(sb)\n}\n")
}

