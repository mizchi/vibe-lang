it\", init_expr, ELetMut(\"__fam_arr\", EArray(array_empty()), ELetMut(\"__fam_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fam_i\", -1), EIdent(\"__fam_n\", -1)), loop_body), EIdent(\"__fam_arr\", -1)), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::blit\" {\n      let dst_expr = Array::get(args, 0)\n      let doff_expr = Array::get(args, 1)\n      let src_expr = Array::get(args, 2)\n      let soff_expr = Array::get(args, 3)\n      let len_expr = Array::get(args, 4)\n      let loop_body = ESeq(ECall(EIdent(\"Array::set\", -1), [\n        EIdent(\"__fb_dst\", -1),\n        EBinOp(\"+\", EIdent(\"__fb_doff\", -1), EIdent(\"__fb_i\", -1)),\n        ECall(EIdent(\"Array::get\", -1), [\n          EIdent(\"__fb_src\", -1),\n          EBinOp(\"+\", EIdent(\"__fb_soff\", -1), EIdent(\"__fb_i\", -1))\n        ], -1)\n      ], -1), EAssign(\"__fb_i\", EBinOp(\"+\", EIdent(\"__fb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__fb_dst\", dst_expr, ELet(\"__fb_doff\", doff_expr, ELet(\"__fb_src\", src_expr, ELet(\"__fb_soff\", soff_expr, ELet(\"__fb_len\", len_expr, ELetMut(\"__fb_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fb_i\", -1), EIdent(\"__fb_len\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::blit\" {\n      let dst_expr = Array::get(args, 0)\n      let src_expr = Array::get(args, 1)\n      let start_expr = Array::get(args, 2)\n      let end_expr = Array::get(args, 3)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bb_dst\", -1),\n        ECall(EIdent(\"Bytes::get\", -1), [\n          EIdent(\"__bb_src\", -1),\n          EIdent(\"__bb_i\", -1)\n        ], -1)\n      ], -1), EAssign(\"__bb_i\", EBinOp(\"+\", EIdent(\"__bb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bb_dst\", dst_expr, ELet(\"__bb_src\", src_expr, ELet(\"__bb_start\", start_expr, ELet(\"__bb_end\", end_expr, ELetMut(\"__bb_i\", EIdent(\"__bb_start\", -1), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bb_i\", -1), EIdent(\"__bb_end\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::fill\" {\n      let dst_expr = Array::get(args, 0)\n      let val_expr = Array::get(args, 1)\n      let count_expr = Array::get(args, 2)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bf2_dst\", -1),\n        EIdent(\"__bf2_val\", -1)\n      ], -1), EAssign(\"__bf2_i\", EBinOp(\"+\", EIdent(\"__bf2_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bf2_dst\", dst_expr, ELet(\"__bf2_val\", val_expr, ELet(\"__bf2_count\", count_expr, ELetMut(\"__bf2_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bf2_i\", -1), EIdent(\"__bf2_count\", -1)), loop_body), EUnit), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::new\" && Array::length(args) == 1 {\n      let n_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bn_b\", -1),\n        EInt(0)\n      ], -1), EAssign(\"__bn_i\", EBinOp(\"+\", EIdent(\"__bn_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bn_n\", n_expr, ELet(\"__bn_b\", ECall(EIdent(\"Bytes::new\", -1), array_empty(), -1), ELetMut(\"__bn_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bn_i\", -1), EIdent(\"__bn_n\", -1)), loop_body), EIdent(\"__bn_b\", -1)), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else {\n      if fn_idx_in_list >= 0 && local_idx_hint < 0 {\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let needs_env = Array::get(ctx.func_table.needs_env, fn_idx_in_list)\n        let mut nl = next_local\n        let cc_bmask = cc_borrow_mask(ctx, fname)\n        let mut ci = 0\n        while ci < Array::length(args) {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          let borrows_this = cc_bmask_has(cc_bmask, ci)\n          let is_loop_borrow1 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx) && !borrows_this\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow1) && !borrows_this {\n            if is_loop_borrow1 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if needs_env {\n          emit_i64_const(buf, 0)\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = if local_idx_hint >= 0 {\n          local_idx_hint\n        } else {\n          resolve_local(local_names, fname, \"call\")\n        }\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          let is_loop_borrow2 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow2) {\n            if is_loop_borrow2 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n    }\n  } else {\n    let num_args = Array::length(args)\n    let fn_val_local = next_local\n    let slot_local = next_local + 1\n    let env_local = next_local + 2\n    let mut nl = next_local + 3\n    Array::push(local_names, \"__fn_val\")\n    Array::push(local_names, \"__slot\")\n    Array::push(local_names, \"__env\")\n    nl = ce(buf, callee, local_names, nl, ctx, ld)\n    emit_local_set(buf, fn_val_local)\n    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n    let mut ci = 0\n    while ci < num_args {\n      let carg = Array::get(args, ci)\n      nl = ce(buf, carg, local_names, nl, ctx, ld)\n      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n      if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow3) {\n        if is_loop_borrow3 {\n          Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n        } else {\n          ()\n        }\n        Array::push(local_names, \"__argdup\")\n        emit_local_tee(buf, nl)\n        emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n        nl = nl + 1\n      } else {\n        ()\n      }\n      ci = ci + 1\n    }\n    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n    nl\n  }\n}\n")
}

