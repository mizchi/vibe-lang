eq\", 65), (\"f32x4.ne\", 66), (\"f32x4.lt\", 67), (\"f32x4.gt\", 68), (\"f32x4.le\", 69), (\"f32x4.ge\", 70),\n    (\"f64x2.eq\", 71), (\"f64x2.ne\", 72), (\"f64x2.lt\", 73), (\"f64x2.gt\", 74), (\"f64x2.le\", 75), (\"f64x2.ge\", 76),\n    (\"v128.not\", 77), (\"v128.and\", 78), (\"v128.andnot\", 79), (\"v128.or\", 80), (\"v128.xor\", 81),\n    (\"v128.bitselect\", 82), (\"v128.any_true\", 83),\n    (\"i8x16.abs\", 96), (\"i8x16.neg\", 97), (\"i8x16.popcnt\", 98), (\"i8x16.all_true\", 99), (\"i8x16.bitmask\", 100),\n    (\"i8x16.shl\", 107), (\"i8x16.shr_s\", 108), (\"i8x16.shr_u\", 109),\n    (\"i8x16.add\", 110), (\"i8x16.add_sat_s\", 111), (\"i8x16.add_sat_u\", 112),\n    (\"i8x16.sub\", 113), (\"i8x16.sub_sat_s\", 114), (\"i8x16.sub_sat_u\", 115),\n    (\"i8x16.min_s\", 118), (\"i8x16.min_u\", 119), (\"i8x16.max_s\", 120), (\"i8x16.max_u\", 121), (\"i8x16.avgr_u\", 123),\n    (\"i16x8.abs\", 128), (\"i16x8.neg\", 129), (\"i16x8.all_true\", 131), (\"i16x8.bitmask\", 132),\n    (\"i16x8.shl\", 139), (\"i16x8.shr_s\", 140), (\"i16x8.shr_u\", 141),\n    (\"i16x8.add\", 142), (\"i16x8.sub\", 145), (\"i16x8.mul\", 149),\n    (\"i16x8.min_s\", 150), (\"i16x8.min_u\", 151), (\"i16x8.max_s\", 152), (\"i16x8.max_u\", 153), (\"i16x8.avgr_u\", 155),\n    (\"i32x4.abs\", 160), (\"i32x4.neg\", 161), (\"i32x4.all_true\", 163), (\"i32x4.bitmask\", 164),\n    (\"i32x4.shl\", 171), (\"i32x4.shr_s\", 172), (\"i32x4.shr_u\", 173),\n    (\"i32x4.add\", 174), (\"i32x4.sub\", 177), (\"i32x4.mul\", 181),\n    (\"i32x4.min_s\", 182), (\"i32x4.min_u\", 183), (\"i32x4.max_s\", 184), (\"i32x4.max_u\", 185),\n    (\"i32x4.dot_i16x8_s\", 186),\n    (\"i64x2.abs\", 192), (\"i64x2.neg\", 193), (\"i64x2.all_true\", 195), (\"i64x2.bitmask\", 196),\n    (\"i64x2.shl\", 203), (\"i64x2.shr_s\", 204), (\"i64x2.shr_u\", 205),\n    (\"i64x2.add\", 206), (\"i64x2.sub\", 209), (\"i64x2.mul\", 213),\n    (\"i64x2.eq\", 214), (\"i64x2.ne\", 215), (\"i64x2.lt_s\", 216), (\"i64x2.gt_s\", 217), (\"i64x2.le_s\", 218), (\"i64x2.ge_s\", 219),\n    (\"f32x4.abs\", 224), (\"f32x4.neg\", 225), (\"f32x4.sqrt\", 227),\n    (\"f32x4.add\", 228), (\"f32x4.sub\", 229), (\"f32x4.mul\", 230), (\"f32x4.div\", 231), (\"f32x4.min\", 232), (\"f32x4.max\", 233),\n    (\"f64x2.abs\", 236), (\"f64x2.neg\", 237), (\"f64x2.sqrt\", 239),\n    (\"f64x2.add\", 240), (\"f64x2.sub\", 241), (\"f64x2.mul\", 242), (\"f64x2.div\", 243), (\"f64x2.min\", 244), (\"f64x2.max\", 245)\n  ]\n}\n\nfn iw_lane_count(name: String) -> Int {\n  if String::starts_with(name, \"i8x16.\") {\n    16\n  } else if String::starts_with(name, \"i16x8.\") {\n    8\n  } else if String::starts_with(name, \"i32x4.\") || String::starts_with(name, \"f32x4.\") {\n    4\n  } else {\n    2\n  }\n}\n\nfn iw_simd_lane_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.extract_lane_s\", 21), (\"i8x16.extract_lane_u\", 22), (\"i8x16.replace_lane\", 23),\n    (\"i16x8.extract_lane_s\", 24), (\"i16x8.extract_lane_u\", 25), (\"i16x8.replace_lane\", 26),\n    (\"i32x4.extract_lane\", 27), (\"i32x4.replace_lane\", 28),\n    (\"i64x2.extract_lane\", 29), (\"i64x2.replace_lane\", 30),\n    (\"f32x4.extract_lane\", 31), (\"f32x4.replace_lane\", 32),\n    (\"f64x2.extract_lane\", 33), (\"f64x2.replace_lane\", 34)\n  ]\n}\n\nfn iw_mem_table() -> Array[(String, Int, Int)] {\n  [\n    (\"i32.load\", 0x28, 2), (\"i64.load\", 0x29, 3), (\"f32.load\", 0x2A, 2), (\"f64.load\", 0x2B, 3),\n    (\"i32.load8_s\", 0x2C, 0), (\"i32.load8_u\", 0x2D, 0), (\"i32.load16_s\", 0x2E, 1), (\"i32.load16_u\", 0x2F, 1),\n    (\"i64.load8_s\", 0x30, 0), (\"i64.load8_u\", 0x31, 0), (\"i64.load16_s\", 0x32, 1), (\"i64.load16_u\", 0x33, 1),\n    (\"i64.load32_s\", 0x34, 2), (\"i64.load32_u\", 0x35, 2),\n    (\"i32.store\", 0x36, 2), (\"i64.store\", 0x37, 3), (\"f32.store\", 0x38, 2), (\"f64.store\", 0x39, 3),\n    (\"i32.store8\", 0x3A, 0), (\"i32.store16\", 0x3B, 1),\n    (\"i64.store8\", 0x3C, 0), (\"i64.store16\", 0x3D, 1), (\"i64.store32\", 0x3E, 2)\n  ]\n}\n\nfn iw_lookup(table: Array[(String, Int)], name: String) -> Int {\n  let n = Array::length(table)\n  let mut i = 0\n  let mut found = 0 - 1\n  while i < n {\n    let (tn, tv) = Array::get(table, i)\n    if tn == name {\n      found = tv\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn iw_mem_lookup(name: String) -> (Int, Int) {\n  let table = iw_mem_table()\n  let n = Array::length(table)\n  let mut i = 0\n  let mut op = 0 - 1\n  let mut al = 0\n  while i < n {\n    let (tn, tv, ta) = Array::get(table, i)\n    if tn == name {\n      op = tv\n      al = ta\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  (op, al)\n}\n\nfn iw_local_idx(fn_name: String, params: Array[String], tok: String, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let want = String::substring(tok, 1, String::length(tok))\n    let n = Array::length(params)\n    let mut i = 0\n    let mut found = 0 - 1\n    while i < n {\n      if Array::get(params, i) == want {\n        found = i\n        i = n\n      } else {\n        i = i + 1\n      }\n    }\n    if found < 0 {\n      throw(iw_err(fn_name, \"unknown local '\\{tok}' — inline wasm locals are the fn's own params\", off))\n    } else {\n      found\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_label_rel(fn_name: String, lbl_names: Array[String], lbl_depths: Array[Int], tok: String, depth: Int, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let n = Array::length(lbl_names)\n    let mut i = n\n    let mut bound = 0 - 1\n    while i > 0 {\n      i = i - 1\n      if Array::get(lbl_names, i) == tok {\n        bound = Array::get(lbl_depths, i)\n        i = 0\n      } else {\n        ()\n      }\n    }\n    if bound < 0 {\n      throw(iw_err(fn_name, \"unknown label '\\{tok}'\", off))\n    } else {\n      depth - bound - 1\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_valtype_code(fn_name: String, name: String, off: Int) -> Int with { Error } {\n  match name {\n    \"i32\" => 0x7F,\n    \"i64\" => 0x7E,\n    \"f32\" => 0x7D,\n    \"f64\" => 0x7C,\n    \"v128\" => 0x7B,\n    _ => throw(iw_err(fn_name, \"unknown value type '\\{name}'\", off))\n  }\n}\n\nfn iw_blocktype(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> (Int, Int) with { Error } {\n  if pos + 1 < end && Array::get(kinds, pos) == 1 && Array::get(kinds, pos + 1) == 3 && Array::get(texts, pos + 1) == \"result\" {\n    if pos + 3 < end && Array::get(kinds, pos + 2) == 3 && Array::get(kinds, pos + 3) == 2 {\n      let vt = iw_valtype_code(fn_name, Array::get(texts, pos + 2), Array::get(offs, pos + 2));\n      (vt, pos + 4)\n    } else {\n      throw(iw_err(fn_name, \"malformed (result T) clause\", Array::get(offs, pos)))\n    }\n  } else {\n    (0x40, pos)\n  }\n}\n\nfn iw_memarg(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, default_align: Int) -> (Int, Int, Int) with { Error } {\n  let mut align = default_align\n  let mut offset = 0\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p < end && Array::get(kinds, p) == 3 {\n      let t = Array::get(texts, p)\n      if String::starts_with(t, \"offset=\") {\n        offset = iw_parse_int(fn_name, String::substring(t, 7, String::length(t)), Array::get(offs, p))\n        p = p + 1\n      } else if String::starts_with(t, \"align=\") {\n        let a = iw_parse_int(fn_name, String::substring(t, 6, String::length(t)), Array::get(offs, p))\n        if a <= 0 || (a & (a - 1)) != 0 {\n          throw(iw_err(fn_name, \"align=\\{a} is invalid (must be a positive power of two)\", Array::get(offs, p)))\n        }\n        let mut e = 0\n        let mut av = a\n        while av > 1 {\n          e = e + 1\n          av = av / 2\n        }\n        if e > default_align {\n          throw(iw_err(fn_name, \"align=\\{a} exceeds the instruction's natural alignment (\\{1 << default_align})\", Array::get(offs, p)))\n        }\n        align = e\n        p = p + 1\n      } else {\n        done = true\n      }\n    } else {\n      done = true\n    }\n  }\n  (align, offset, p)\n}\n\nfn iw_want_word(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, opname: String) -> String with { Error } {\n  if pos < end && Array::get(kinds, pos) == 3 {\n    Array::get(texts, pos)\n  } else {\n    let off = if pos < Array::length(offs) {\n      Array::get(offs, pos)\n    } else {\n      0 - 1\n    }\n    throw(iw_err(fn_name, \"'\\{opname}' expects an immediate operand\", off))\n  }\n}\n\nfn iw_v128_const(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> Int with { Error } {\n  let shape = iw_want_word(fn_name, kinds, texts, offs, pos, end, \"v128.const\")\n  let (lane_count, lane_bytes) = match shape {\n    \"i8x16\" => (16, 1),\n    \"i16x8\" => (8, 2),\n    \"i32x4\" => (4, 4),\n    \"i64x2\" => (2, 8),\n    _ => throw(iw_err(fn_name, \"v128.const shape must be i8x16/i16x8/i32x4/i64x2, got '\\{shape}'\", Array::get(offs, pos)))\n  }\n  bytebuf_push(buf, 0xFD)\n  leb128_encode_u32(buf, 12)\n  let mut p = pos + 1\n  let mut li = 0\n  while li < lane_count {\n    let t = iw_want_word(fn_name, kinds, texts, offs, p, end, \"v128.const\")\n    let v = iw_parse_int(fn_name, t, Array::get(offs, p))\n    let mut bi = 0\n    while bi < lane_bytes {\n      bytebuf_push(buf, (v >> (bi * 8)) & 255)\n      bi = bi + 1\n    }\n    p = p + 1\n    li = li + 1\n  }\n  p\n}\n\nfn iw_plain_op(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let name = Array::get(texts, pos)\n  let off = Array::get(offs, pos)\n  if name == \"block\" || name == \"loop\" || name == \"if\" || name == \"else\" || name == \"end\" || name == \"then\" {\n    throw(iw_err(fn_name, \"structured control must use the folded form: (block ...) / (loop ...) / (if <cond> (then ...) (else ...))\", off))\n  } else if name == \"local.get\" || name == \"local.set\" || name == \"local.tee\" {\n    let opc = if name == \"local.get\" {\n      0x20\n    } else if name == \"local.set\" {\n      0x21\n    } else {\n      0x22\n    }\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let idx = iw_local_idx(fn_name, params, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, opc)\n    leb128_encode_u32(buf, idx)\n    pos + 2\n  } else if name == \"br\" || name == \"br_if\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let rel = iw_label_rel(fn_name, lbl_names, lbl_depths, t, depth, Array::get(offs, pos + 1))\n    if rel < 0 {\n      throw(iw_err(fn_name, \"label '\\{t}' is not visible from this branch\", Array::get(offs, pos + 1)))\n    } else {\n      ()\n    }\n    bytebuf_push(buf, if name == \"br\" {\n      0x0C\n    } else {\n      0x0D\n    })\n    leb128_encode_u32(buf, rel)\n    pos + 2\n  } else if name == \"i32.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x41)\n    leb128_encode_s32(buf, v)\n    pos + 2\n  } else if name == \"i64.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x42)\n    leb128_encode_s64(buf, v)\n    pos + 2\n  } else if name == \"f32.const\" || name == \"f64.const\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice); build the bit pattern with i64.const + f64.reinterpret_i64\", off))\n  } else if name == \"memory.size\" || name == \"memory.grow\" {\n    bytebuf_push(buf, if name == \"memory.size\" {\n      0x3F\n    } else {\n      0x40\n    })\n    bytebuf_push(buf, 0x00)\n    pos + 1\n  } else if name == \"v128.const\" {\n    iw_v128_const(buf, fn_name, kinds, texts, offs, pos + 1, end)\n  } else if name == \"v128.load\" || name == \"v128.store\" {\n    let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, 4)\n    bytebuf_push(buf, 0xFD)\n    leb128_encode_u32(buf, if name == \"v128.load\" {\n      0\n    } else {\n      11\n    })\n    leb128_encode_u32(buf, align)\n    leb128_encode_u32(buf, offset)\n    next\n  } else if name == \"call\" || name == \"call_indirect\" || name == \"return_call\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: bodies cannot reference other functions)\", off))\n  } else if name == \"global.get\" || name == \"global.set\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: runtime globals are not addressable)\", off))\n  } else if name == \"br_table\" {\n    throw(iw_err(fn_name, \"'br_table' is not supported in inline wasm (v0.3 slice)\", off))\n  } else if name == \"local\" {\n    throw(iw_err(fn_name, \"'(local ...)' declarations are not supported in inline wasm (v0.3 slice); use the fn's params as scratch locals\", off))\n  } else {\n    let core_opc = iw_lookup(iw_core_table(), name)\n    if core_opc >= 0 {\n      bytebuf_push(buf, core_opc)\n      pos + 1\n    } else {\n      let lane_sub = iw_lookup(iw_simd_lane_table(), name)\n      if lane_sub >= 0 {\n        let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n        let lane = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n        let lane_cnt = iw_lane_count(name)\n        if lane < 0 || lane >= lane_cnt {\n          throw(iw_err(fn_name, \"lane index \\{lane} is out of range for '\\{name}' (0..\\{lane_cnt - 1})\", Array::get(offs, pos + 1)))\n        }\n        bytebuf_push(buf, 0xFD)\n        leb128_encode_u32(buf, lane_sub)\n        bytebuf_push(buf, lane & 255)\n        pos + 2\n      } else {\n        let (mem_opc, mem_align) = iw_mem_lookup(name)\n        if mem_opc >= 0 {\n          let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, mem_align)\n          bytebuf_push(buf, mem_opc)\n          leb128_encode_u32(buf, align)\n          leb128_encode_u32(buf, offset)\n          next\n        } else {\n          let simd_sub = iw_lookup(iw_simd_table(), name)\n          if simd_sub >= 0 {\n            bytebuf_push(buf, 0xFD)\n            leb128_encode_u32(buf, simd_sub)\n            pos + 1\n          } else {\n            throw(iw_err(fn_name, \"unknown or unsupported instruction '\\{name}'\", off))\n          }\n        }\n      }\n    }\n  }\n}\n\nfn iw_item(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let k = Array::get(kinds, pos)\n  if k == 3 {\n    iw_plain_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n  } else if k == 1 {\n    if pos + 1 >= end || Array::get(kinds, pos + 1) != 3 {\n      throw(iw_err(fn_name, \"expected an instruction name after '('\", Array::get(offs, pos)))\n    } else {\n      ()\n    }\n    let head = Array::get(texts, pos + 1)\n    if head == \"block\" || head == \"loop\" {\n      iw_folded_block(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"if\" {\n      iw_folded_if(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"then\" || head == \"else\" || head == \"result\" {\n      throw(iw_err(fn_name, \"misplaced '(\\{head} ...)' clause\", Array::get(offs, pos)))\n    } else {\n      iw_folded_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    }\n  } else {\n    throw(iw_err(fn_name, \"unexpected ')'\", Array::get(offs, pos)))\n  }\n}\n\nfn iw_seq(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p >= end {\n      done = true\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    }\n  }\n  p\n}\n\nfn iw_folded_op(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let opb = bytebuf_new()\n  let after_imm = iw_plain_op(opb, fn_name, kinds, texts, offs, pos + 1, end, params, lbl_names, lbl_depths, depth)\n  let mut p = after_imm\n  let mut done = false\n  while !done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing ')' closing folded '\\{Array::get(texts, pos + 1)}'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected '\\{Array::get(texts, p)}' inside folded '\\{Array::get(texts, pos + 1)}' — operands must be parenthesized\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push_buf(out, opb)\n  p + 1\n}\n\nfn iw_folded_block(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let head = Array::get(texts, pos + 1)\n  bytebuf_push(out, if head == \"loop\" {\n    0x03\n  } else {\n    0x02\n  })\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  bytebuf_push(out, bt)\n  let bq = iw_seq(out, fn_name, kinds, texts, offs, after_bt, end, params, lbl_names, lbl_depths, depth + 1)\n  if bq >= end || Array::get(kinds, bq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '\\{head}'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  bq + 1\n}\n\nfn iw_folded_if(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  let mut p = after_bt\n  let mut cond_done = false\n  while !cond_done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing '(then ...)' clause in folded 'if'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 1 && p + 1 < end && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \"then\" {\n      cond_done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected token in folded 'if' condition (condition operands must be parenthesized)\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push(out, 0x04)\n  bytebuf_push(out, bt)\n  let tq = iw_seq(out, fn_name, kinds, texts, offs, p + 2, end, params, lbl_names, lbl_depths, depth + 1)\n  if tq >= end || Array::get(kinds, tq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '(then ...)'\", Array::get(offs, p)))\n  } else {\n    ()\n  }\n  let mut r = tq + 1\n  if r + 1 < end && Array::get(kinds, r) == 1 && Array::get(kinds, r + 1) == 3 && Array::get(texts, r + 1) == \"else\" {\n    bytebuf_push(out, 0x05)\n    let eq = iw_seq(out, fn_name, kinds, texts, offs, r + 2, end, params, lbl_names, lbl_depths, depth + 1)\n    if eq >= end || Array::get(kinds, eq) != 2 {\n      throw(iw_err(fn_name, \"missing ')' closing '(else ...)'\", Array::get(offs, r)))\n    } else {\n      ()\n    }\n    r = eq + 1\n  } else {\n    ()\n  }\n  if r >= end || Array::get(kinds, r) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing folded 'if'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  r + 1\n}\n\nexport fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error } {\n  let (kinds, texts, offs) = iw_tokenize(fn_name, wat)\n  let out = bytebuf_new()\n  let lbl_names = iw_fresh_strings()\n  let lbl_depths = iw_fresh_ints()\n  let end = Array::length(kinds)\n  if end == 0 {\n    throw(iw_err(fn_name, \"empty inline wasm body\", 0))\n  } else {\n    ()\n  }\n  let final_pos = iw_seq(out, fn_name, kinds, texts, offs, 0, end, param_names, lbl_names, lbl_depths, 0)\n  if final_pos != end {\n    throw(iw_err(fn_name, \"unbalanced ')'\", Array::get(offs, final_pos)))\n  } else {\n    ()\n  }\n  out\n}\n\n\nexport {\n  compile_inline_wat\n}\n")
}

let selfhost_source_89 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_helpers.vibe",
"\n\n\n\n\n\nfn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let fvs = collect_free_vars_indexed(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_name_index)\n  let mut j = 0\n  while j < Array::length(fvs) {\n    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))\n    j = j + 1\n  }\n}\n\nexport fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),\n      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n\nexport fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {\n  let fn_name_index = sorted_names_of(fn_names)\n  let sink = Array::slice([\n    (\"\", false)\n  ], 0, 0)\n  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)\n  let set_b = MapBuilder::new()\n  let mut k = 0\n  while k < Array::length(sink) {\n    let (nm, _) = Array::get(sink, k)\n    MapBuilder::set(set_b, nm, true)\n    k = k + 1\n  }\n  MapBuilder::freeze(set_b)\n}\n")
}

let selfhost_source_90 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_compile.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet wasm_page_size = 65536\n\nfn lc_fresh_int_array() -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bool_array() -> Array[Bool] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bytes_array() -> Array[Bytes] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_expr_array() -> Array[Expr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n\nfn lc_fresh_string_matrix() -> Array[Array[String]] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn gen_heap_grow_check_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\nfn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {\n        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  Array::push(names, iw_name)\n                  Array::push(wats, iw_wat)\n                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\nfn linked_type_expr_is_unit(t: TypeExpr) -> Bool {\n  match t {\n    TyUnit => true,\n    TyName(n) => n == \"Unit\",\n    _ => false\n  }\n}\n\nexport fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv) -> Bytes with { Error } {\n  desugar_trait_dicts(stmts)\n  rewrite_top_level_fn_alias_refs(stmts)\n  let iw_names = lc_fresh_string_array()\n  let iw_wats = lc_fresh_string_array()\n  lc_extract_inline_wasm(stmts, iw_names, iw_wats)\n  let lc_borrow_ret_names = compute_borrow_returning_names(stmts)\n  let lc_scalar_ret_names = compute_scalar_returning_names(stmts)\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      let __sf_etag = expr_tag(expr)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (__sf_etag == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          let __sf_thunk_expr = expr\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      SSuberror(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  let lc_agg_ret_names = lc_fresh_string_array()\n  let lc_agg_ret_infos = lc_fresh_int_array()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n  }, lc_agg_ret_names, lc_agg_ret_infos)\n  let lc_heap_ret_names = compute_heap_returning(stmts)\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 && !library_mode && entry_name != \"__no_entry__\" {\n    throw(\"entry `\\{entry_name}` not found: no exported function named `\\{entry_name}` (use __no_entry__ to build a test runner)\")\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args, _) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = Array::slice([\n    0\n  ], 0, 0)\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if eff_name != \"Error\" && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\n  le