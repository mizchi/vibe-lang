"\n\n\n\n\n\nexport {\n  compact_string_fingerprint,\n  build_source_groups_fingerprint,\n  normalize_persistent_cache_text,\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_wasi_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_module_artifact_fingerprint,\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint\n}\n\n\nfn persistent_cache_version_tag() -> String {\n  String::concat(\"v12|cg-\", selfhost_codegen_fingerprint())\n}\n\nexport fn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String {\n  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)\n}\n\nexport fn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_type_env_cache_path(fingerprint: String) -> String {\n  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)\n}\n\nexport fn persistent_source_list_cache_path(entry_path: String) -> String {\n  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_source_group_cache_path(entry_path: String) -> String {\n  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_manifest_header_cache_path(entry_path: String) -> String {\n  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)\n}\n\nexport fn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)\n}\n\nfn package_ref_of_index_dep(dep: String) -> Option[String] {\n  if is_contract_ext(dep) {\n    let parts = String::split(dep, \"/\")\n    let n = Array::length(parts)\n    if n >= 3 && String::starts_with(Array::get(parts, n - 3), \"@\") {\n      Some(String::concat(Array::get(parts, n - 3), String::concat(\"/\", Array::get(parts, n - 2))))\n    } else {\n      None\n    }\n  } else {\n    None\n  }\n}\n\nexport fn package_index_dep_is_current(dep: String) -> Bool with { Fs } {\n  match package_ref_of_index_dep(dep) {\n    None => true,\n    Some(pkg_ref) => {\n      let candidates = resolve_import_path_candidates(\"\", pkg_ref)\n      let mut i = 0\n      let mut winner = \"\"\n      while i < Array::length(candidates) {\n        if winner == \"\" {\n          let candidate = Array::get(candidates, i)\n          if Fs::exists(candidate) {\n            winner = candidate\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if winner == \"\" {\n        Array::get(candidates, 0) == dep\n      } else {\n        winner == dep\n      }\n    }\n  }\n}\n\nexport fn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs } {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(deps) {\n    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let selfhost_source_141 = () -> (String, String) {
  ("lib/@vibe/compiler/module_graph_path.vibe",
"\nexport fn is_contract_ext(path: String) -> Bool {\n  String::ends_with(path, \".vibei\") || String::ends_with(path, \".vpkg\")\n}\n\nexport fn dir_of_path(file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nexport fn ensure_regular_source_fs(path: String) -> Unit with { Error, Fs } {\n  if Fs::stat_token(path) == -1 {\n    throw(\"symlink module source is not allowed: \\{path}\")\n  } else {\n    ()\n  }\n}\n\nexport fn contains_name(items: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn contains_path(visited: Array[String], path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet path_set_bucket_count = 64\n\nfn path_set_hash(s: String) -> Int {\n  let len = String::length(s)\n  let mut h = 5381\n  let mut i = 0\n  while i < len {\n    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF\n    i = i + 1\n  }\n  h\n}\n\nexport fn path_set_new() -> Array[Array[String]] {\n  let buckets = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < path_set_bucket_count {\n    Array::push(buckets, Array::slice([\n      \"\"\n    ], 0, 0))\n    i = i + 1\n  }\n  buckets\n}\n\nexport fn path_set_contains(set: Array[Array[String]], path: String) -> Bool {\n  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bucket) && !found {\n    if Array::get(bucket, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn path_set_add(set: Array[Array[String]], path: String) -> Unit {\n  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)\n}\n\nexport fn normalize_path(path: String) -> String {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn get_export_name(items: Array[(String, Option[String])], name: String) -> String {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn join_relative_path(base_dir: String, raw_path: String) -> String {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport fn path_to_module_name(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport fn path_has_relative_prefix(raw_path: String, len: Int) -> Bool {\n  if raw_path == \".\" || raw_path == \"..\" {\n    true\n  } else if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn resolve_import_path(base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\neffect Env {\n  Get(String) -> String\n}\n\nfn env_get_raw(name: String) -> String with { Env } {\n  Env::get(name)\n}\n\nfn read_env_discharged(name: String) -> String {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\nfn strip_trailing_slash(p: String) -> String {\n  let len = String::length(p)\n  if len > 1 && String::ends_with(p, \"/\") {\n    p[0: len - 1]\n  } else {\n    p\n  }\n}\n\nexport fn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String] {\n  let roots = Array::slice([\n    \"\"\n  ], 0, 0)\n  if String::length(vibe_lib) > 0 {\n    let parts = String::split(vibe_lib, \":\")\n    let mut i = 0\n    while i < Array::length(parts) {\n      let part = Array::get(parts, i)\n      if String::length(part) > 0 {\n        Array::push(roots, strip_trailing_slash(part))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else if String::length(vibe_home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), \"/lib\"))\n  } else if String::length(home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(home), \"/.vibe/lib\"))\n  } else {\n    ()\n  }\n  roots\n}\n\nexport fn external_lib_roots() -> Array[String] {\n  parse_vibe_lib_roots(read_env_discharged(\"VIBE_LIB\"), read_env_discharged(\"VIBE_HOME\"), read_env_discharged(\"HOME\"))\n}\n\nexport fn vibe_env_flag(name: String) -> Bool {\n  read_env_discharged(name) == \"1\"\n}\n\nexport fn resolution_env_seed() -> String {\n  let roots = external_lib_roots()\n  let pins = if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n    \"1\"\n  } else {\n    \"0\"\n  }\n  String::concat(\"|roots=\", String::concat(String::join(roots, \":\"), String::concat(\"|pins=\", pins)))\n}\n\nexport fn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String] {\n  if String::starts_with(raw_path, \"@\") {\n    let candidates = Array::slice([\n      \"\"\n    ], 0, 0)\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vibei\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vibei\")))\n    let roots = external_lib_roots()\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vpkg\"))))\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vibei\"))))\n      ri = ri + 1\n    }\n    return candidates\n  } else ()\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vpkg\"),\n      String::concat(normalized, \"/index.vibei\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
