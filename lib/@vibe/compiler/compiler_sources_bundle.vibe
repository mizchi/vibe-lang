"\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\n\nlet builders_vt_i32 = 127\n\nlet builders_sec_data = 11\n\nlet sec_type = 1\n\nexport fn string_to_data(s: String) -> Bytes {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\nfn empty_int_array() -> Array[Int] {\n  array_empty()\n}\n\nfn pair_int_array(v0: Int, v1: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nfn quad_int_array(v0: Int, v1: Int, v2: Int, v3: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  Array::push(values, v3)\n  values\n}\n\nfn triple_int_array(v0: Int, v1: Int, v2: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn empty_bytes_array() -> Array[Bytes] {\n  array_empty()\n}\n\nfn pair_bytes_array(v0: Bytes, v1: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nfn builders_empty_string_array() -> Array[String] {\n  array_empty()\n}\n\nfn pair_string_array(v0: String, v1: String) -> Array[String] {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nexport fn build_call_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\n  emit_function_section(out, pair_int_array(0, 1))\n  emit_export_section_multi(out, pair_string_array(\"square\", \"sum_sq\"), pair_int_array(0, 1))\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)\n  emit_i64_add(ss_body)\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\n  bytebuf_to_bytes(out)\n}\n\nfn triple_bytes_array(v0: Bytes, v1: Bytes, v2: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn singleton_int_array(v0: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  values\n}\n\nfn triple_string_array(v0: String, v1: String, v2: String) -> Array[String] {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn singleton_bytes_array(v0: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  values\n}\n\nexport fn build_add_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, singleton_bytes_array(body))\n  bytebuf_to_bytes(out)\n}\n\nexport fn build_factorial_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fact\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_mul(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local