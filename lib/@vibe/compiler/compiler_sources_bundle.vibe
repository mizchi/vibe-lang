"\n\n\n\nfn reg_p0() -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nfn reg_p1(a: Type) -> Array[Type] {\n  let arr = reg_p0()\n  Array::push(arr, a)\n  arr\n}\n\nfn reg_p2(a: Type, b: Type) -> Array[Type] {\n  let arr = reg_p1(a)\n  Array::push(arr, b)\n  arr\n}\n\nfn reg_p3(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = reg_p2(a, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn reg_p4(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {\n  let arr = reg_p3(a, b, c)\n  Array::push(arr, d)\n  arr\n}\n\nfn reg_p5(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {\n  let arr = reg_p4(a, b, c, d)\n  Array::push(arr, e)\n  arr\n}\n\nlet registry_typed_rows: Array[(String, Type, Bool, Bool, Bool)] = [\n    (\"Env::get\", CtFn(reg_p1(CtString), CtString, Some(\"Env\")), true, false, true),\n    (\"Env::args_len\", CtFn(reg_p0(), CtInt, Some(\"Env\")), true, false, true),\n    (\"Env::args_get\", CtFn(reg_p1(CtInt), CtString, Some(\"Env\")), true, false, true),\n    (\"Fs::read_file\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, true),\n    (\"Fs::exists\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n    (\"Fs::stat_token\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n    (\"vibe_fs_stat_token_raw\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n    (\"Fs::write_file\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n    (\"Fs::write_bytes\", CtFn(reg_p2(CtString, CtBytes), CtUnit, Some(\"Fs\")), true, false, true),\n    (\"Fs::read_bytes\", CtFn(reg_p1(CtString), CtBytes, Some(\"Fs\")), true, false, true),\n    (\"vibe_fs_read_dir_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, false),\n    (\"sh\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, true),\n    (\"vibe_sh_lines_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, false),\n    (\"vibe_sh_capture_raw\", CtFn(re