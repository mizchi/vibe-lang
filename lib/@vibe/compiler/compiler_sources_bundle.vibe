let source_6 = () -> (String, String) {
  ("lib/@vibe/parser/lexer.vibe",
"\n\n\n\nfn is_ws(c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nfn is_alpha(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nfn is_digit(c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nfn is_alnum(c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nfn utf8_seq_len(c: Int) -> Int {\n  if c >= 0xF0 && c <= 0xF7 {\n    4\n  } else if c >= 0xE0 && c <= 0xEF {\n    3\n  } else if c >= 0xC2 && c <= 0xDF {\n    2\n  } else {\n    1\n  }\n}\n\nfn skip_bom(source: String, len: Int) -> Int {\n  if len >= 3 && String::char_code_at(source, 0) == 0xEF && String::char_code_at(source, 1) == 0xBB && String::char_code_at(source, 2) == 0xBF {\n    3\n  } else {\n    0\n  }\n}\n\nfn utf8_char_text(source: String, len: Int, pos: Int) -> String {\n  let c = String::char_code_at(source, pos)\n  let seq_len = utf8_seq_len(c)\n  let clamp_end = if pos + seq_len <= len { pos + seq_len } else { len }\n  String::substring(source, pos, clamp_end)\n}\n\nfn lex_char(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nfn slice_eq(source: String, start: Int, end: Int, text: String) -> Bool {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn is_hex_digit(c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nfn keyword_lookup(source: String, start: Int, end: Int) -> Option[Token] {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else if slice_eq(source, start, end, \"is\") {\n        Some(TIs)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nfn scan_ident_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nfn lex_ident(s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nfn scan_digits_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nfn scan_interp_end(s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nfn located_prefix(s: String, pos: Int) -> String {\n  let mut eline = 1\n  let mut ecol = 1\n  let mut ei = 0\n  while ei < pos {\n    if String::char_code_at(s, ei) == '\\n' {\n      eline = eline + 1\n      ecol = 1\n    } else {\n      ecol = ecol + 1\n    }\n    ei = ei + 1\n  }\n  String::concat(\"line \", String::concat(__to_string(eline), String::concat(\":\", String::concat(__to_string(ecol), \": \"))))\n}\n\nfn check_no_scientific_suffix(s: String, len: Int, pos: Int) -> Unit with { Error } {\n  if pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == 'e' || c == 'E' {\n      let has_sign = pos + 1 < len && (String::char_code_at(s, pos + 1) == '+' || String::char_code_at(s, pos + 1) == '-')\n      let digits_start = if has_sign {\n        pos + 2\n      } else {\n        pos + 1\n      }\n      let has_digits = digits_start < len && is_digit(String::char_code_at(s, digits_start))\n      if has_digits {\n        throw(String::concat(located_prefix(s, pos), \"scientific notation is not supported; write the digits out or compute the value\"))\n      } else if has_sign {\n        throw(String::concat(located_prefix(s, pos), \"incomplete exponent: expected digit(s) after the sign in scientific notation\"))\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn empty_string_array() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn skip_until_newline(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nfn skip_ws_with_newline(s: String, len: Int, i: Int) -> (Int, Bool) {\n  let mut out = i\n  let mut saw_newline = false\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      if c == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      let next = skip_until_newline(s, len, out + 2)\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = next\n    } else {\n      skipping = false\n    }\n  }\n  (out, saw_newline)\n}\n\nfn concat_string_parts(parts: Array[String], tail: String) -> String {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(parts) {\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::push(out, tail)\n  StringBuilder::freeze(out)\n}\n\nfn lex_string_go(s: String, len: Int, idx: Int, start: Int, parts_acc: Array[String], has_interp: Bool, parts: ArrayBuilder[String], offsets: ArrayBuilder[Int]) -> (Token, Int) with { Error } {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        ArrayBuilder::push(offsets, -1)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts), ArrayBuilder::freeze(offsets))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '(' {\n        let mut eline = 1\n        let mut ecol = 1\n        let mut ei = 0\n        while ei < current_idx {\n          if String::char_code_at(s, ei) == '\\n' {\n            eline = eline + 1\n            ecol = 1\n          } else {\n            ecol = ecol + 1\n          }\n          ei = ei + 1\n        }\n        let eloc = String::concat(\"line \", String::concat(__to_string(eline), String::concat(\":\", String::concat(__to_string(ecol), \": \"))))\n        throw(String::concat(eloc, \"string interpolation \\\\(expr) was removed in 0.3.0; use \\\\{expr}\"))\n      } else if esc == '{' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        ArrayBuilder::push(offsets, -1)\n        let interp_end = scan_interp_end(s, len, next + 1, 1)\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        ArrayBuilder::push(offsets, next + 1)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nfn lex_string(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new(), ArrayBuilder::new())\n}\n\nfn scan_hex_digits_end(s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\n\nfn parse_hex_from_string(s: String) -> Int with { Error } {\n  let len = String::length(s)\n  let max_div_16 = 144115188075855871\n  let max_mod_16 = 15\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    if acc > max_div_16 || (acc == max_div_16 && digit > max_mod_16) {\n      throw(\"IntLiteralOverflow: hex integer literal exceeds Int::max_value (2305843009213693951)\")\n    } else {\n      ()\n    }\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nfn parse_int_from_string(s: String) -> Int with { Error } {\n  let len = String::length(s)\n  let max_div_10 = 230584300921369395\n  let max_mod_10 = 1\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = c - 48\n    if acc > max_div_10 || (acc == max_div_10 && digit > max_mod_10) {\n      throw(\"IntLiteralOverflow: integer literal exceeds Int::max_value (2305843009213693951)\")\n    } else {\n      ()\n    }\n    acc = acc * 10 + digit\n    i = i + 1\n  }\n  acc\n}\n\nfn lex_decimal(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let frac_end = scan_digits_end(s, len, int_end + 1)\n      let value = parse_decimal_float(s[i: int_end], s[int_end + 1: frac_end])\n      check_no_scientific_suffix(s, len, frac_end)\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(value), frac_end + 1)\n      } else {\n        (TFloat(value), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\n    let value = parse_decimal_float(s[i: int_end], \"\")\n    (TFloat(value), int_end + 1)\n  } else {\n    check_no_scientific_suffix(s, len, int_end)\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nfn lex_number(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nfn is_expr_ending_tok(t: Token) -> Bool {\n  match t {\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    TIdent(_) => true,\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    _ => false\n  }\n}\n\nfn lex_one_token(source: String, len: Int, pos: Int) -> (Token, Int) with { Error } {\n  let c = String::char_code_at(source, pos)\n  if is_alpha(c) {\n    lex_ident(source, len, pos)\n  } else if is_digit(c) {\n    lex_number(source, len, pos)\n  } else if c == '\"' {\n    lex_string(source, len, pos)\n  } else if c == '+' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPlusEq, pos + 2)\n    } else (TPlus, pos + 1)\n  } else if c == '-' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TThinArrow, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TMinusEq, pos + 2)\n    } else (TMinus, pos + 1)\n  } else if c == '*' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TStarEq, pos + 2)\n    } else (TStar, pos + 1)\n  } else if c == '/' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TSlashEq, pos + 2)\n    } else (TSlash, pos + 1)\n  } else if c == '%' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPercentEq, pos + 2)\n    } else (TPercent, pos + 1)\n  } else if c == '=' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TEqEq, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TArrow, pos + 2)\n    } else (TEq, pos + 1)\n  } else if c == '!' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TNeq, pos + 2)\n    } else (TNot, pos + 1)\n  } else if c == '<' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TLte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n      (TLShift, pos + 2)\n    } else (TLt, pos + 1)\n  } else if c == '>' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TGte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TRShift, pos + 2)\n    } else (TGt, pos + 1)\n  } else if c == '&' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n      (TAnd, pos + 2)\n    } else (TBitAnd, pos + 1)\n  } else if c == '|' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n      (TOr, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TPipeGt, pos + 2)\n    } else (TBitOr, pos + 1)\n  } else if c == '^' {\n    (TBitXor, pos + 1)\n  } else if c == '(' {\n    (TLParen, pos + 1)\n  } else if c == ')' {\n    (TRParen, pos + 1)\n  } else if c == '{' {\n    (TLBrace, pos + 1)\n  } else if c == '}' {\n    (TRBrace, pos + 1)\n  } else if c == '[' {\n    (TLBracket, pos + 1)\n  } else if c == ']' {\n    (TRBracket, pos + 1)\n  } else if c == ',' {\n    (TComma, pos + 1)\n  } else if c == ';' {\n    (TSemicolon, pos + 1)\n  } else if c == '.' {\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n      (TDotDotDot, pos + 3)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n      (TDotDot, pos + 2)\n    } else (TDot, pos + 1)\n  } else if c == ':' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n      (TDoubleColon, pos + 2)\n    } else (TColon, pos + 1)\n  } else if c == '#' {\n    (THash, pos + 1)\n  } else if c == '~' {\n    (TTilde, pos + 1)\n  } else if c == '?' {\n    (TQuestion, pos + 1)\n  } else if c == '@' {\n    let mut end = pos + 1\n    while end < len {\n      let ec = String::char_code_at(source, end)\n      if is_alnum(ec) || ec == '_' || ec == '-' {\n        end = end + 1\n      } else if ec == '/' && end + 1 < len && is_alnum(String::char_code_at(source, end + 1)) {\n        end = end + 1\n      } else {\n        break\n      }\n    }\n    if end > pos + 1 {\n      (TIdent(String::substring(source, pos, end)), end)\n    } else {\n      throw(\"unexpected '@' without identifier\")\n    }\n  } else if c == '\\'' {\n    lex_char(source, len, pos)\n  } else {\n    let ch_text = if c >= 128 {\n      utf8_char_text(source, len, pos)\n    } else {\n      String::from_char_code(c)\n    }\n    throw(String::concat(\"unexpected character: \", ch_text))\n  }\n}\n\nexport fn lex_with_offsets(source: String) -> (Array[Token], Array[Int], Array[Int]) with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let starts = ArrayBuilder::new()\n    let ends = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, pos)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      ArrayBuilder::push(starts, pos)\n      ArrayBuilder::push(ends, next)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::push(starts, len)\n    ArrayBuilder::push(ends, len)\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\n  }\n}\n\nexport fn lex_with_offsets_recovering(source: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String]) {\n  let len = String::length(source)\n  let b = ArrayBuilder::new()\n  let starts = ArrayBuilder::new()\n  let ends = ArrayBuilder::new()\n  let err_offsets = ArrayBuilder::new()\n  let err_msgs = ArrayBuilder::new()\n  let mut prev_tok = TEof\n  let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n  let mut pos = first_skip.0\n  let mut nl_before = first_skip.1\n  while pos < len {\n    let c = String::char_code_at(source, pos)\n    let res = handle {\n      let (tok, next) = lex_one_token(source, len, pos)\n      Some((tok, next))\n    } with Error {\n      Throw(msg) => {\n        ArrayBuilder::push(err_offsets, pos)\n        ArrayBuilder::push(err_msgs, msg)\n        None\n      }\n    }\n    match res {\n      Some((tok, next)) => {\n        if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n          ArrayBuilder::push(b, TSemicolon)\n          ArrayBuilder::push(starts, pos)\n          ArrayBuilder::push(ends, pos)\n        } else {\n          ()\n        }\n        ArrayBuilder::push(b, tok)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, next)\n        prev_tok = tok\n        let skipped = skip_ws_with_newline(source, len, next)\n        pos = skipped.0\n        nl_before = skipped.1\n      },\n      None => {\n        let resume = if c == '\"' || c == '\\'' {\n          let mut j = pos + 1\n          let mut stop = false\n          while !stop {\n            if j >= len {\n              stop = true\n            } else {\n              let cc = String::char_code_at(source, j)\n              if cc == c {\n                j = j + 1\n                stop = true\n              } else if cc == 10 {\n                stop = true\n              } else if cc == 92 && j + 1 < len {\n                j = j + 2\n              } else {\n                j = j + 1\n              }\n            }\n          }\n          j\n        } else if c >= 128 {\n          let seq_len = utf8_seq_len(c)\n          if pos + seq_len <= len {\n            pos + seq_len\n          } else {\n            len\n          }\n        } else {\n          pos + 1\n        }\n        let skipped = skip_ws_with_newline(source, len, resume)\n        pos = skipped.0\n        nl_before = skipped.1\n      }\n    }\n  }\n  ArrayBuilder::push(b, TEof)\n  ArrayBuilder::push(starts, len)\n  ArrayBuilder::push(ends, len)\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends), ArrayBuilder::freeze(err_offsets), ArrayBuilder::freeze(err_msgs))\n}\n\nexport fn offset_to_line_col(source: String, offset: Int) -> (Int, Int) {\n  let len = String::length(source)\n  let bound = if offset < len { offset } else { len }\n  let mut i = 0\n  let mut line = 1\n  let mut col = 1\n  while i < bound {\n    if String::char_code_at(source, i) == 10 {\n      line = line + 1\n      col = 1\n    } else {\n      col = col + 1\n    }\n    i = i + 1\n  }\n  (line, col)\n}\n\nexport fn lex(source: String) -> Array[Token] with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, skip_bom(source, len))\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport fn lex_ok(source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n")
}

let source_7 = () -> (String, String) {
  ("lib/@vibe/parser/parser_base.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\n\nexport fn peek(tokens: Array[Token], pos: Int) -> Token {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nfn _no_tp() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn _no_tb() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nexport fn tk_name(tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_, _) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TIs => \"is\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_, _) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nfn is_tk(tok: Token, name: String) -> Bool {\n  tk_name(tok) == name\n}\n\nfn expect_tk(tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"expected \\{expected} but got \\{actual} at #\\{pos}\")\n  }\n}\n\nexport fn skip_semi(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nfn empty_arms() -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nfn empty_pats() -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nfn empty_ctors() -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nfn empty_exprs() -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nexport fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let names = Array::slice([\n    \"\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TDerive => match peek(tokens, pos + 1) {\n      TLParen => {\n        let mut dp = pos + 2\n        let mut dd = true\n        while dd {\n          match peek(tokens, dp) {\n            TRParen => {\n              dd = false\n              dp = dp + 1\n            },\n            TComma => {\n              dp = dp + 1\n            },\n            TIdent(name) => {\n              Array::push(names, name)\n              dp = dp + 1\n            },\n            _ => throw(\"expected derive identifier\")\n          }\n        }\n        (names, dp)\n      },\n      _ => (names, pos)\n    },\n    _ => (names, pos)\n  }\n}\n\nexport fn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error } {\n  let (_, next) = parse_derive_names(tokens, pos)\n  next\n}\n\nfn empty_fields() -> Array[(String, TypeExpr)] {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nfn empty_params() -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nfn parse_pattern(tokens: Array[Token], pos: Int) -> (Pat, Int) with { Error } {\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TMinus => match peek(tokens, pos + 1) {\n      TInt(n) => (PInt(0 - n), pos + 2),\n      TFloat(n) => (PFloat(0.0 - n), pos + 2),\n      _ => throw(\"expected number literal after '-' in pattern\")\n    },\n    TFloat(n) => (PFloat(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              TIdent(vname) => {\n                let vc = String::char_code_at(vname, 0)\n                if vc >= 65 && vc <= 90 {\n                  match peek(tokens, pos + 3) {\n                    TLParen => {\n                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);\n                      (PCtor(vname, args), end)\n                    },\n                    _ => (PCtor(vname, empty_pats()), pos + 3)\n                  }\n                } else {\n                  (PCtor(name, empty_pats()), pos + 1)\n                }\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected in pattern: \\{actual}\")\n    }\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nfn empty_type_exprs() -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nexport fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBrace => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nfn parse_method_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_method_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in method type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_trait_methods(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let sigs_b = ArrayBuilder::new()\n      let gens_b = ArrayBuilder::new()\n      let mut p = pos + 1\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(method_name) => {\n            let after_colon = match peek(tokens, p + 1) {\n              TColon => p + 2,\n              _ => p + 1\n            }\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\n              _ => (_no_tp(), _no_tb(), after_colon)\n            }\n            let (params, after_method_params) = match peek(tokens, after_binder) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), after_binder)\n            }\n            let arrow_pos = expect_tk(tokens, after_method_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected trait method signature or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\n    },\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\n  }\n}\n\nfn parse_trait_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      match peek(tokens, after_name) {\n        TColon => {\n          let supers = empty_strings\n          let mut p = after_name + 1\n          let mut done = false\n          while !done {\n            match peek(tokens, p) {\n              TIdent(sname) => match peek(tokens, p + 1) {\n                TPlus => {\n                  Array::push(supers, sname)\n                  p = p + 2\n                },\n                _ => {\n                  Array::push(supers, sname)\n                  p = p + 1\n                  done = true\n                }\n              },\n              _ => {\n                done = true\n              }\n            }\n          }\n          let np = p\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\n          (STrait(exported, name, supers, methods, method_gens), body_end)\n        },\n        _ => {\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\n        }\n      }\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nfn is_expr_end_token(tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_, _) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nfn is_non_pipe_infix(tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nfn parse_import_item(tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int) with { Error } {\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\n    match peek(tokens, name_pos) {\n      TIdent(name) => {\n        let (base, after) = match peek(tokens, name_pos + 1) {\n          TDoubleColon => match peek(tokens, name_pos + 2) {\n            TIdent(member) =>\n            (String::concat(name, String::concat(\"::\", member)), name_pos + 3),\n            _ => throw(\"expected qualified member name after '::'\")\n          },\n          _ => (name, name_pos + 1)\n        }\n        match peek(tokens, after) {\n          TAs => match peek(tokens, after + 1) {\n            TIdent(alias) => ((base, Some(alias)), after + 2),\n            _ => throw(\"expected alias name after 'as'\")\n          },\n          _ => ((base, None), after)\n        }\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nfn empty_import_items() -> Array[(String, Option[String])] {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nfn parse_binding_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nexport fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TAs => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \".\")),\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \"..\")),\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \"/\")),\n    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, 0) == '@' && !String::ends_with(acc, \"/\") {\n      (acc, pos)\n    } else {\n      collect_import_path(tokens, pos + 1, String::concat(acc, name))\n    },\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \"-\")),\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \"module\")),\n    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, \"impl\")),\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \"type\")),\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \"match\")),\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \"test\")),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(String::concat(\"unexpected token in import path: \", actual))\n    }\n  }\n}\n\nfn skip_bracketed_args(tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBracket => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nfn parse_tparam_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let b = ArrayBuilder::new()\n      let mut skip = pos + 1\n      let mut depth = 1\n      let mut expect_name = true\n      while depth > 0 {\n        match peek(tokens, skip) {\n          TLBracket => {\n            depth = depth + 1; skip = skip + 1\n          },\n          TRBracket => {\n            depth = depth - 1; skip = skip + 1\n          },\n          TComma => {\n            if depth == 1 {\n              expect_name = true\n            }\n            skip = skip + 1\n          },\n          TIdent(nm) => {\n            if depth == 1 && expect_name {\n              ArrayBuilder::push(b, nm)\n              expect_name = false\n            }\n            skip = skip + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            skip = skip + 1\n          }\n        }\n      }\n      (ArrayBuilder::freeze(b), skip)\n    },\n    _ => (Array::slice([\n      \"\"\n    ], 0, 0), pos)\n  }\n}\n\nfn collect_effect_names(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let (item, after_item) = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n          _ => throw(\"expected qualified operation name after '::' in effect list\")\n        },\n        _ => (name, pos + 1)\n      }\n      let new_acc = if String::length(acc) == 0 {\n        item\n      } else \"\\{acc}, \\{item}\"\n      match peek(tokens, after_item) {\n        TComma => collect_effect_names(tokens, after_item + 1, new_acc),\n        TRBrace => (new_acc, after_item + 1),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nfn parse_type_impl(tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int) with { Error } {\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let ts = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\n          ArrayBuilder::push(b, ty)\n          type_list_rest(tokens, next, b)\n        }\n      }\n      ,\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\n    match peek(tokens, rn) {\n      TWith => {\n        let with_pos = expect_tk(tokens, rn + 1, \"{\")\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n        (Some(effect_name_pair.0), effect_name_pair.1)\n      },\n      _ => (None, rn)\n    }\n  }\n  if mode == 0 {\n    match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => {\n          let after = pos + 2\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\n            },\n            _ => (TyUnit, after)\n          }\n        },\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          let (elems, after) = match peek(tokens, n1) {\n            TRParen => ([\n              first\n            ], n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (rest, en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(elems, ret, eff.0), eff.1)\n            },\n            _ => {\n              let atom = if Array::length(elems) == 1 {\n                Array::get(elems, 0)\n              } else {\n                TyTuple(elems)\n              }\n              match peek(tokens, after) {\n                TQuestion => (TyApp(\"Option\", [\n                  atom\n                ]), after + 1),\n                _ => (atom, after)\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n        match peek(tokens, atom_next) {\n          TThinArrow => {\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n            let eff = parse_effect_suffix(tokens, rn)\n            (TyFn([\n              atom_ty\n            ], ret, eff.0), eff.1)\n          },\n          _ => (atom_ty, atom_next)\n        }\n      }\n    }\n  } else {\n    let (base_ty, base_next) = match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => (TyUnit, pos + 2),\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          match peek(tokens, n1) {\n            TRParen => (first, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (TyTuple(rest), en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n        }\n      },\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TLBracket => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          match peek(tokens, n1) {\n            TRBracket => (TyApp(name, [\n              first\n            ]), n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \"]\");\n              (TyApp(name, rest), en)\n            },\n            _ => throw(\"expected ']' or ',' in type application\")\n          }\n        },\n        _ => (TyName(name), pos + 1)\n      },\n      _ => {\n        let actual = tk_name(peek(tokens, pos))\n        throw(\"expected type but got \\{actual}\")\n      }\n    }\n    match peek(tokens, base_next) {\n      TQuestion => (TyApp(\"Option\", [\n        base_ty\n      ]), base_next + 1),\n      _ => (base_ty, base_next)\n    }\n  }\n}\n\nexport fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nfn parse_one_param(tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected parameter name at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nfn parse_param_cont(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected ',' or ')' in param list at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nfn parse_param_list(tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nfn parse_struct_field(tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Bool, Int) with { Error } {\n  let (is_mut, p) = match peek(tokens, pos) {\n    TMut => (true, pos + 1),\n    _ => (false, pos)\n  }\n  match peek(tokens, p) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, p + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), is_mut, next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nfn is_lambda_start_impl(tokens: Array[Token], pos: Int, depth: Int, bdepth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 && bdepth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),\n    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),\n    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)\n  }\n}\n\nfn is_lambda_start(tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, 0, false)\n}\n\nfn parse_ctor_types_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nfn parse_enum_ctor(tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nfn parse_enum_ctors_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => throw(\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\{pos}\"),\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';' or '}' in enum at #\\{pos}\")\n  }\n}\n\nfn parse_enum_ctors(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nfn parse_enum_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let b = ArrayBuilder::new()\n          let mut skip = pos + 2\n          let mut depth = 1\n          let mut expect_name = true\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TComma => {\n                if depth == 1 {\n                  expect_name = true\n                }\n                skip = skip + 1\n              },\n              TIdent(nm) => {\n                if depth == 1 && expect_name {\n                  ArrayBuilder::push(b, nm)\n                  expect_name = false\n                }\n                skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          (ArrayBuilder::freeze(b), skip)\n        },\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SEnum(exported, name, params, ctors, derives), final_pos)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nfn parse_suberror_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nfn parse_impl_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_impl_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in impl type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_impl_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\n    _ => (_no_tp(), _no_tb(), pos)\n  }\n  match peek(tokens, after_tp) {\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, after_tp + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => {\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\n        },\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nfn parse_type_params_list(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn parse_effect_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nfn parse_type_alias_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let ep = expect_tk(tokens, after_name, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, params, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nfn parse_impl_stmt_dispatch(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nfn push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nfn parse_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => throw(\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\{pos}\"),\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';' or '}' in struct at #\\{pos}\")\n  }\n}\n\nfn parse_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      push_mut_name(mb, first, is_mut)\n      parse_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nfn parse_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_tparam_names, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let source_8 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_primary.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, TypeExpr\n}\n\n\n\n\n\nfn map_located_off(off: Int, f: (Int) -> Int) -> Int {\n  if off < 0 {\n    off\n  } else {\n    f(off)\n  }\n}\n\nfn map_expr_offsets(expr: Expr, f: (Int) -> Int) -> Expr {\n  {\n    match expr {\n      EInt(_) => expr,\n      EFloat(_) => expr,\n      EString(_) => expr,\n      EBool(_) => expr,\n      EUnit => expr,\n      EIdent(name, off) => EIdent(name, map_located_off(off, f)),\n      ETuple(items) => ETuple(map_exprs(items, f)),\n      EArray(items) => EArray(map_exprs(items, f)),\n      ERecord(rn, fields, targs) => ERecord(rn, map_field_exprs(fields, f), targs),\n      EIf(c, t, e) => EIf(map_expr_offsets(c, f), map_expr_offsets(t, f), map_expr_offsets(e, f)),\n      ELet(n, v, b, soff) => ELet(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\n      ELetRec(n, v, b) => ELetRec(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      ELetMut(n, v, b, soff) => ELetMut(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\n      EAssign(n, v, b) => EAssign(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      EAssignOp(n, op, v, b) => EAssignOp(n, op, map_expr_offsets(v, f), map_expr_offsets(b, f)),\n      ESeq(a, b) => ESeq(map_expr_offsets(a, f), map_expr_offsets(b, f)),\n      EMatch(s, arms) => EMatch(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\n      EHandle(s, arms) => EHandle(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\n      EWhile(c, b) => EWhile(map_expr_offsets(c, f), map_expr_offsets(b, f)),\n      ELoop(params, b) => ELoop(map_loop_param_exprs(params, f), map_expr_offsets(b, f)),\n      EForIn(n, idx, it, b) => EForIn(n, idx, map_expr_offsets(it, f), map_expr_offsets(b, f)),\n      ECall(callee, args, off) => ECall(map_expr_offsets(callee, f), map_exprs(args, f), map_located_off(off, f)),\n      EBinOp(op, l, r) => EBinOp(op, map_expr_offsets(l, f), map_expr_offsets(r, f)),\n      EUnaryOp(op, e) => EUnaryOp(op, map_expr_offsets(e, f)),\n      EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, map_expr_offsets(body, f)),\n      EDot(e, field, off, fdoff) => EDot(map_expr_offsets(e, f), field, map_located_off(off, f), map_located_off(fdoff, f)),\n      ELabeledArg(l, n, v) => ELabeledArg(l, n, map_expr_offsets(v, f)),\n      EReturn(e) => EReturn(map_expr_offsets(e, f)),\n      EBreak(opt) => match opt {\n        Some(v) => EBreak(Some(map_expr_offsets(v, f))),\n        None => expr\n      },\n      EContinue(args) => EContinue(map_exprs(args, f)),\n      EMap(fields) => EMap(map_field_exprs(fields, f)),\n      ESpread(e) => ESpread(map_expr_offsets(e, f)),\n      EStringInterp(_) => expr\n    }\n  }\n}\n\nfn map_exprs(items: Array[Expr], f: (Int) -> Int) -> Array[Expr] {\n  for it in items {\n    map_expr_offsets(it, f)\n  }\n}\n\nfn map_field_exprs(fields: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\n  for fld in fields {\n    let (n, v) = fld\n    (n, map_expr_offsets(v, f))\n  }\n}\n\nfn map_arm_exprs(arms: Array[(Pat, Expr)], f: (Int) -> Int) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, e) = a\n    (p, map_expr_offsets(e, f))\n  }\n}\n\nfn map_loop_param_exprs(params: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\n  for p in params {\n    let (n, init) = p\n    (n, map_expr_offsets(init, f))\n  }\n}\n\nfn remap_frag_off(off: Int, outer_starts: Array[Int], frag_starts: Array[Int], frag_base: Int) -> Int {\n  let n = Array::length(outer_starts)\n  let mut lo = 0\n  let mut hi = n - 1\n  let mut found = -1\n  while lo <= hi {\n    let mid = (lo + hi) / 2\n    let v = Array::get(outer_starts, mid)\n    if v < off {\n      lo = mid + 1\n    } else {\n      if v == off {\n        found = mid\n      } else {\n        ()\n      }\n      hi = mid - 1\n    }\n  }\n  if found >= 0 && found < Array::length(frag_starts) {\n    frag_base + Array::get(frag_starts, found)\n  } else {\n    -1\n  }\n}\n\nfn build_interp_expr(parts: Array[String], offsets: Array[Int], outer_starts: Array[Int], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } {\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\n    ECall(EIdent(\"String::concat\", -1), [\n      a,\n      b\n    ], -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut i = 0\n  while i < plen {\n    let part = Array::get(parts, i)\n    if i % 2 == 0 {\n      if String::length(part) > 0 {\n        let piece = EString(part)\n        result = if has_val {\n          concat_expr(result, piece)\n        } else {\n          piece\n        }\n        has_val = true\n      } else {\n        ()\n      }\n    } else {\n      let (ftoks, fstarts, _fends) = lex_with_offsets(part)\n      let (pe0, _) = parse_recur(ftoks, 0, 0)\n      let frag_off = if i < Array::length(offsets) { Array::get(offsets, i) } else { -1 }\n      let pe = if frag_off >= 0 {\n        map_expr_offsets(pe0, (o) -> remap_frag_off(o, outer_starts, fstarts, frag_off))\n      } else {\n        pe0\n      }\n      let piece = ECall(EIdent(\"__to_string\", -1), [\n        pe\n      ], -1)\n      result = if has_val {\n        concat_expr(result, piece)\n      } else {\n        piece\n      }\n      has_val = true\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn desugar_loop_body(expr: Expr, param_names: Array[String]) -> Expr {\n  match expr {\n    EBreak(opt) => match opt {\n      Some(val) => EAssign(\"__loop_result\", desugar_loop_body(val, param_names), EBreak(None)),\n      None => EBreak(None)\n    },\n    EContinue(args) => {\n      if Array::length(args) == 0 {\n        EContinue(args)\n      } else {\n        let nargs = Array::length(args)\n        let nparams = Array::length(param_names)\n        if nargs > nparams {\n          EContinue(args)\n        } else {\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\n        let mut ci = nargs - 1\n        while ci >= 0 {\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\"__lt\", __to_string(ci)), -1), result)\n          ci = ci - 1\n        }\n        let mut ci2 = nargs - 1\n        while ci2 >= 0 {\n          result = ELet(String::concat(\"__lt\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result, -1)\n          ci2 = ci2 - 1\n        }\n        result\n        }\n      }\n    },\n    EWhile(_, _) => expr,\n    ELoop(_, _) => expr,\n    EFn(_, _, _, _, _, _) => expr,\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\n    ELet(n, v, b, soff) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    EMatch(s, arms) => EMatch(desugar_loop_body(s, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EHandle(body, arms) => EHandle(desugar_loop_body(body, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\n    ECall(_, _, _) => expr,\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\n    EDot(obj, field, off, fdoff) => EDot(desugar_loop_body(obj, param_names), field, off, fdoff),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    _ => expr\n  }\n}\n\n\nfn parse_loop_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let param_names_b = ArrayBuilder::new()\n      let param_inits_b = ArrayBuilder::new()\n      let mut cur = pos + 2\n      let mut done = false\n      while !done {\n        match peek(tokens, cur) {\n          TRParen => {\n            cur = cur + 1\n            done = true\n          },\n          TIdent(name) => {\n            let eq_pos = expect_tk(tokens, cur + 1, \"=\")\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\n            ArrayBuilder::push(param_names_b, name)\n            ArrayBuilder::push(param_inits_b, init)\n            match peek(tokens, next_pos) {\n              TComma => {\n                cur = next_pos + 1\n              },\n              TRParen => {\n                cur = next_pos + 1\n                done = true\n              },\n              _ => throw(\"expected ',' or ')' in loop params\")\n            }\n          },\n          _ => throw(\"expected loop parameter name or ')'\")\n        }\n      }\n      let body_pos = expect_tk(tokens, cur, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      let pnames = ArrayBuilder::freeze(param_names_b)\n      let pinits = ArrayBuilder::freeze(param_inits_b)\n      let transformed_body = desugar_loop_body(body, pnames)\n      let while_expr = EWhile(EBool(true), transformed_body)\n      let result = ELetMut(\"__loop_result\", EInt(0),\n        ESeq(while_expr, EIdent(\"__loop_result\", -1)), -1)\n      let mut wrapped = result\n      let mut wi = Array::length(pnames) - 1\n      while wi >= 0 {\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped, -1)\n        wi = wi - 1\n      }\n      (wrapped, end_pos)\n    },\n    _ => {\n      let body_pos = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EWhile(EBool(true), body), end_pos)\n    }\n  }\n}\n\nfn parse_break_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EBreak(None), pos + 1),\n    TSemicolon => (EBreak(None), pos + 1),\n    TEof => (EBreak(None), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EBreak(Some(expr)), next_pos)\n    }\n  }\n}\n\nfn parse_throw_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let open_pos = expect_tk(tokens, pos + 1, \"(\")\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\n  let close_pos = expect_tk(tokens, next_pos, \")\")\n  let off = offset_at(starts, pos)\n  (ECall(EIdent(\"perform\", off), [\n    ECall(EIdent(\"Error::Throw\", off), [\n      expr\n    ], off)\n  ], off), close_pos)\n}\n\nfn parse_return_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EReturn(EUnit), pos + 1),\n    TSemicolon => (EReturn(EUnit), pos + 1),\n    TEof => (EReturn(EUnit), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EReturn(expr), next_pos)\n    }\n  }\n}\n\nfn parse_perform_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRParen => (EIdent(\"perform\", -1), pos + 1),\n    TRBracket => (EIdent(\"perform\", -1), pos + 1),\n    TRBrace => (EIdent(\"perform\", -1), pos + 1),\n    TComma => (EIdent(\"perform\", -1), pos + 1),\n    TSemicolon => (EIdent(\"perform\", -1), pos + 1),\n    TEof => (EIdent(\"perform\", -1), pos + 1),\n    _ => {\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\n      (ECall(EIdent(\"perform\", -1), [\n        arg\n      ], offset_at(starts, pos)), next_pos)\n    }\n  }\n}\n\nfn parse_array_elems_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let next_pos = pos + 1\n      match peek(tokens, next_pos) {\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\n        TDotDotDot => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\n          ArrayBuilder::push(b, ESpread(expr))\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        },\n        _ => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\n          ArrayBuilder::push(b, expr)\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nfn parse_array_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRBracket => (EArray(empty_exprs()), pos + 2),\n    TDotDotDot => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n      ArrayBuilder::push(b, ESpread(first))\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    },\n    _ => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, first)\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    }\n  }\n}\n\nfn parse_comma_exprs_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      match peek(tokens, pos + 1) {\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\n          ArrayBuilder::push(b, e)\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nfn parse_continue_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let b = ArrayBuilder::new()\n      match peek(tokens, pos + 2) {\n        TRParen => (EContinue(empty_exprs()), pos + 3),\n        _ => {\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n          ArrayBuilder::push(b, first)\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (EContinue(args), close_pos)\n        }\n      }\n    },\n    _ => (EContinue(empty_exprs()), pos + 1)\n  }\n}\n\nfn parse_control_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => parse_recur(tokens, pos + 1, 20),\n    TIf => parse_recur(tokens, pos + 1, 21),\n    TMatch => parse_recur(tokens, pos + 1, 22),\n    THandle => parse_recur(tokens, pos + 1, 24),\n    TWhile => parse_recur(tokens, pos + 1, 23),\n    TFor => parse_recur(tokens, pos + 1, 25),\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\n    TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\n    TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\n    TYield => throw(\"'yield' is not supported\"),\n    TDeclare => throw(\"'declare' is not supported\"),\n    _ => {\n      let prev_name = if pos > 0 {\n        tk_name(peek(tokens, pos - 1))\n      } else {\n        \"start\"\n      }\n      let actual = tk_name(peek(tokens, pos))\n      let next_name = tk_name(peek(tokens, pos + 1))\n      throw(\"unexpected token at #\\{pos}: \\{actual} (prev=\\{prev_name}, next=\\{next_name})\")\n    }\n  }\n}\n\nfn parse_ctor_record_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nfn parse_generic_fn_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let mut skip_pos = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, skip_pos) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      _ => ()\n    }\n    skip_pos = skip_pos + 1\n  }\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\n      let effect_pair = match peek(tokens, ret_pos) {\n        TWith => {\n          let with_pos = expect_tk(tokens, ret_pos + 1, \"{\")\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n          let effect_name = effect_name_pair.0\n          let end_pos = effect_name_pair.1\n          (Some(effect_name), end_pos)\n        },\n        _ => (None, ret_pos)\n      }\n      let effect = effect_pair.0\n      let effect_next = effect_pair.1\n      let body_pos = expect_tk(tokens, effect_next, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\n    },\n    TLBrace => {\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\n    },\n    _ => throw(\"expected '->' or '{' after generic function params\")\n  }\n}\n\nfn is_generic_fn_start(tokens: Array[Token], pos: Int) -> Bool {\n  match peek(tokens, pos + 1) {\n    TIdent(_) => {\n      let mut p = pos + 2\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, p) {\n          TLBracket => {\n            depth = depth + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => ()\n        }\n        p = p + 1\n      }\n      match peek(tokens, p) {\n        TLParen => true,\n        _ => false\n      }\n    },\n    _ => false\n  }\n}\n\nfn parse_bracket_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if is_generic_fn_start(tokens, pos) {\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_array_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nfn parse_paren_tuple_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos + 1) {\n    TRParen => (EUnit, pos + 2),\n    _ => {\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      match peek(tokens, next_pos) {\n        TRParen => (first, next_pos + 1),\n        TComma => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (ETuple(items), close_pos)\n        },\n        _ => throw(\"expected ')' or ','\")\n      }\n    }\n  }\n}\n\n\nfn parse_paren_lambda_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let after_arrow = after_params + 1\n      match peek(tokens, after_arrow) {\n        TIdent(_) => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        TLParen => {\n          let ty_opt = handle {\n            let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n            Some((ty, ty_pos))\n          } with Error {\n            Throw(_) => None\n          }\n          match ty_opt {\n            Some(pair) => {\n              let (ty, ty_pos) = pair\n              match peek(tokens, ty_pos) {\n                TLBrace => {\n                  let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n                },\n                TWith => {\n                  let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n                  let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n                  let effect_name = effect_pair.0\n                  let effect_next = effect_pair.1\n                  let body_pos = expect_tk(tokens, effect_next, \"{\")\n                  let (body, end) = parse_recur(tokens, body_pos, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n                },\n                _ => {\n                  let (body, end) = parse_recur(tokens, after_arrow, 0)\n                  (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n                }\n              }\n            },\n            None => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        _ => {\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n        }\n      }\n    },\n    TLBrace => {\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n    },\n    _ => throw(\"expected '->' or '{' after fn params\")\n  }\n}\n\nfn parse_paren_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if is_lambda_start(tokens, pos + 1) {\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nfn parse_record_literal_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nfn offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nfn is_struct_targs_ctor_start(tokens: Array[Token], pos: Int) -> Bool {\n  let mut p = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, p) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      TEof => {\n        depth = 0\n      },\n      _ => ()\n    }\n    p = p + 1\n  }\n  match peek(tokens, p) {\n    TDoubleColon => match peek(tokens, p + 1) {\n      TLBrace => true,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn parse_struct_ctor_targs(tokens: Array[Token], pos: Int, name: String) -> (Array[TypeExpr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBracket => throw(\"expected at least one type argument in `\\{name}[...]::{ ... }` at #\\{pos}: write `\\{name}::{ ... }` to infer the type arguments from the field values\"),\n    _ => {\n      let (first, after_first) = parse_type_impl(tokens, pos, 0)\n      let targs = [\n        first\n      ]\n      let mut p = after_first\n      while tk_name(peek(tokens, p)) == \",\" {\n        let (next, after_next) = parse_type_impl(tokens, p + 1, 0)\n        Array::push(targs, next)\n        p = after_next\n      }\n      let end_pos = expect_tk(tokens, p, \"]\")\n      (targs, end_pos)\n    }\n  }\n}\n\nfn parse_ident_primary(tokens: Array[Token], starts: Array[Int], pos: Int, name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if name == \"true\" {\n    (EBool(true), pos + 1)\n  } else if name == \"false\" {\n    (EBool(false), pos + 1)\n  } else if name == \"perform\" {\n    parse_perform_primary(tokens, starts, pos, parse_recur)\n  } else if name == \"record\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (ERecord(\"\", fields, empty_type_exprs()), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else if name == \"map\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => throw(\"the `map { ... }` literal was removed (#960): use Map::from_pairs([(\\\"key\\\", value), ...]) or Map::new() at #\\{pos}\"),\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else {\n    match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member)), offset_at(starts, pos)), pos + 3),\n        TLBrace => {\n          let b = ArrayBuilder::new()\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\n          (ERecord(name, fields, empty_type_exprs()), end_pos)\n        },\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      TLBracket => if is_struct_targs_ctor_start(tokens, pos + 1) {\n        let (targs, after_targs) = parse_struct_ctor_targs(tokens, pos + 2, name)\n        let dc_pos = expect_tk(tokens, after_targs, \"::\")\n        let brace_pos = expect_tk(tokens, dc_pos, \"{\")\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, brace_pos, b, parse_recur)\n        (ERecord(name, fields, targs), end_pos)\n      } else {\n        (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  }\n}\n\nexport fn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TInt(n) => (EInt(n), pos + 1),\n    TFloat(n) => (EFloat(n), pos + 1),\n    TString(s) => (EString(s), pos + 1),\n    TStringInterp(parts, offs) => (build_interp_expr(parts, offs, starts, parse_recur), pos + 1),\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\n  }\n}\n")
}

let source_9 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_core.vibe",
"\nimport @vibe/ast {\n  Expr, Pat\n}\n\n\n\n\n\nfn binop_op(tok: Token) -> String with { Error } {\n  match tok {\n    TOr => \"||\",\n    TAnd => \"&&\",\n    TPipeGt => \"|>\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TBitAnd => \"&\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    _ => throw(\"internal parser error: not a binary operator\")\n  }\n}\n\nfn binop_prec(tok: Token) -> Int {\n  match tok {\n    TOr => 0,\n    TAnd => 1,\n    TPipeGt => 2,\n    TEqEq => 3,\n    TNeq => 3,\n    TLt => 3,\n    TLte => 3,\n    TGt => 3,\n    TGte => 3,\n    TBitOr => 4,\n    TBitXor => 5,\n    TBitAnd => 6,\n    TLShift => 7,\n    TRShift => 7,\n    TPlus => 8,\n    TMinus => 8,\n    TStar => 9,\n    TSlash => 9,\n    TPercent => 9,\n    _ => -1\n  }\n}\n\nfn callee_offset(callee: Expr) -> Int {\n  match callee {\n    EIdent(_, off) => off,\n    EDot(inner, _, off, _) => if off >= 0 { off } else { callee_offset(inner) },\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\n    _ => -1\n  }\n}\n\nfn field_offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nfn index_expr(cur_expr: Expr, idx: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  ECall(EIdent(\"__index\", -1), args, -1)\n}\n\nfn pipe_arg_is_hole(arg: Expr) -> Bool {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    _ => false\n  }\n}\n\nfn pipe_desugar(lhs: Expr, rhs: Expr) -> Expr {\n  match rhs {\n    ECall(callee, args, off) => {\n      let mut has_hole = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if pipe_arg_is_hole(Array::get(args, i)) {\n          has_hole = true\n          i = Array::length(args)\n        } else {\n          i = i + 1\n        }\n      }\n      if has_hole {\n        let out = empty_exprs()\n        let mut j = 0\n        while j < Array::length(args) {\n          let a = Array::get(args, j)\n          if pipe_arg_is_hole(a) {\n            Array::push(out, lhs)\n          } else {\n            Array::push(out, a)\n          }\n          j = j + 1\n        }\n        ECall(callee, out, off)\n      } else {\n        ECall(callee, Array::concat([\n          lhs\n        ], args), off)\n      }\n    },\n    _ => {\n      let off = callee_offset(rhs)\n      ECall(rhs, Array::concat([\n        lhs\n      ], empty_exprs()), off)\n    }\n  }\n}\n\nfn parse_call_arg(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TThinArrow => {\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\n        (EFn(_no_tp(), _no_tb(), [\n          (name, None)\n        ], None, None, body), end)\n      },\n      TTilde => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TQuestion => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"?\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TEq => {\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\n        (ELabeledArg(name, \"~\", val), end)\n      },\n      _ => parse_recur(tokens, pos, 0)\n    },\n    _ => parse_recur(tokens, pos, 0)\n  }\n}\n\nfn has_placeholder_arg(arg: Expr) -> Bool {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    EBinOp(_, l, r) => has_placeholder_arg(l) || has_placeholder_arg(r),\n    _ => false\n  }\n}\n\nfn slice_from_idx_expr(cur_expr: Expr, idx: Expr, end_expr: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nfn has_placeholder_args(args: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) {\n    if has_placeholder_arg(Array::get(args, i)) {\n      found = true\n      i = Array::length(args)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn parse_call_args_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TComma => match peek(tokens, p + 1) {\n        TRParen => {\n          p = p + 1\n          done = true\n        },\n        _ => {\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\n          ArrayBuilder::push(b, e)\n          p = next\n        }\n      }\n      ,\n      _ => {\n        done = true\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn slice_from_zero_expr(cur_expr: Expr, end_expr: Expr) -> Expr {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, EInt(0))\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nfn wrap_placeholder_arg(arg: Expr) -> Expr {\n  let mut pc = 0\n  let params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let rec replace_placeholders: (Expr) -> Expr = (e) -> {\n    match e {\n      EIdent(n, _) => if n == \"_\" {\n        let pn = String::concat(\"__ph\", __to_string(pc))\n        Array::push(params, (pn, None))\n        pc = pc + 1\n        EIdent(pn, -1)\n      } else {\n        e\n      }\n      ,\n      EBinOp(op, l, r) => {\n        let nl = replace_placeholders(l)\n        let nr = replace_placeholders(r)\n        EBinOp(op, nl, nr)\n      },\n      _ => e\n    }\n  }\n  let replaced = replace_placeholders(arg)\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\n}\n\nfn has_non_pipe_infix_top(tokens: Array[Token], start: Int, end: Int) -> Bool {\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else {\n            go(i + 1, 0, false)\n          }\n        } else {\n          match tok {\n            TLParen => go(i + 1, 1, false),\n            TLBracket => go(i + 1, 1, false),\n            TLBrace => go(i + 1, 1, false),\n            _ => go(i + 1, 0, is_expr_end_token(tok))\n          }\n        }\n      } else {\n        match tok {\n          TLParen => go(i + 1, depth + 1, prev_top_end),\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\n          TRParen => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBracket => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBrace => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          _ => go(i + 1, depth, prev_top_end)\n        }\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nfn desugar_placeholder_args(args: Array[Expr]) -> Array[Expr] {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    if pipe_arg_is_hole(arg) {\n      Array::push(out, arg)\n    } else if has_placeholder_arg(arg) {\n      Array::push(out, wrap_placeholder_arg(arg))\n    } else {\n      Array::push(out, arg)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn empty_map_fields() -> Array[(String, Expr)] {\n  Array::slice([\n    (\"\", EUnit)\n  ], 0, 0)\n}\n\nfn map_from_pairs_fields(args: Array[Expr], pos: Int) -> Array[(String, Expr)] with { Error } {\n  if Array::length(args) != 1 {\n    throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\{pos}\")\n  }\n  match Array::get(args, 0) {\n    EArray(elems) => {\n      let b = ArrayBuilder::new()\n      let mut i = 0\n      while i < Array::length(elems) {\n        match Array::get(elems, i) {\n          ETuple(kv) => if Array::length(kv) == 2 {\n            match Array::get(kv, 0) {\n              EString(k) => ArrayBuilder::push(b, (k, Array::get(kv, 1))),\n              _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): pair key is not a string literal at #\\{pos}\")\n            }\n          } else {\n            throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each pair must be a 2-tuple literal at #\\{pos}\")\n          },\n          _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each element must be a tuple literal at #\\{pos}\")\n        }\n        i = i + 1\n      }\n      ArrayBuilder::freeze(b)\n    },\n    _ => throw(\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\{pos}\")\n  }\n}\n\nfn build_call_expr(expr: Expr, args: Array[Expr], pos: Int) -> Expr with { Error } {\n  let ctor_name = match expr {\n    EIdent(name, _) => name,\n    _ => \"\"\n  }\n  if ctor_name == \"Map::new\" {\n    if Array::length(args) == 0 {\n      EMap(empty_map_fields())\n    } else {\n      throw(\"Map::new takes no arguments (#960): use Map::from_pairs([(\\\"key\\\", value), ...]) to build a non-empty map at #\\{pos}\")\n    }\n  } else if ctor_name == \"Map::from_pairs\" {\n    EMap(map_from_pairs_fields(args, pos))\n  } else {\n    ECall(expr, args, callee_offset(expr))\n  }\n}\n\nfn parse_postfix(tokens: Array[Token], starts: Array[Int], pos: Int, expr: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLParen => match expr {\n      EArray(_) => (expr, pos),\n      ETuple(_) => (expr, pos),\n      ERecord(_, _, _) => (expr, pos),\n      EMap(_) => (expr, pos),\n      EInt(_) => (expr, pos),\n      EFloat(_) => (expr, pos),\n      EString(_) => (expr, pos),\n      EStringInterp(_) => (expr, pos),\n      EBool(_) => (expr, pos),\n      EUnit => (expr, pos),\n      EWhile(_, _) => (expr, pos),\n      EIf(_, _, _) => (expr, pos),\n      EMatch(_, _) => (expr, pos),\n      ELoop(_, _) => (expr, pos),\n      EForIn(_, _, _, _) => (expr, pos),\n      EHandle(_, _) => (expr, pos),\n      _ => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, starts, pos + 2, build_call_expr(expr, empty_exprs(), pos), parse_recur),\n        _ => {\n          let b = ArrayBuilder::new()\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\n          ArrayBuilder::push(b, first_arg)\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          let call_args = if has_placeholder_args(args) {\n            desugar_placeholder_args(args)\n          } else {\n            args\n          }\n          parse_postfix(tokens, starts, close_pos, build_call_expr(expr, call_args, pos), parse_recur)\n        }\n      },\n    },\n    TLBracket => match peek(tokens, pos + 1) {\n      TColon => match peek(tokens, pos + 2) {\n        TRBracket => {\n          let end_expr = ECall(EIdent(\"__len\", -1), [\n            expr\n          ], -1)\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\n        },\n        _ => {\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\n          let close_pos = match peek(tokens, end_next) {\n            TRBracket => end_next + 1,\n            _ => throw(\"expected ']'\")\n          }\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\n        }\n      },\n      _ => {\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\n        match peek(tokens, idx_next) {\n          TColon => match peek(tokens, idx_next + 1) {\n            TRBracket => {\n              let end_expr = ECall(EIdent(\"__len\", -1), [\n                expr\n              ], -1)\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            },\n            _ => {\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\n              let close_pos = match peek(tokens, end_next) {\n                TRBracket => end_next + 1,\n                _ => throw(\"expected ']'\")\n              }\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            }\n          },\n          _ => {\n            let close_pos = match peek(tokens, idx_next) {\n              TRBracket => idx_next + 1,\n              _ => throw(\"expected ']'\")\n            }\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\n          }\n        }\n      }\n    },\n    TDot => match peek(tokens, pos + 1) {\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      _ => (expr, pos)\n    },\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\"__try_op\", -1), [\n      expr\n    ], -1), parse_recur),\n    _ => (expr, pos)\n  }\n}\n\nfn parse_prefix(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TMinus => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"-\", e), next)\n    },\n    TNot => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"!\", e), next)\n    },\n    _ => {\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\n      parse_postfix(tokens, starts, next, e, parse_recur)\n    }\n  }\n}\n\nfn left_is_stmt_form(e: Expr) -> Bool {\n  match e {\n    EWhile(_, _) => true,\n    ELoop(_, _) => true,\n    EForIn(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn is_is_token(tok: Token) -> Bool {\n  match tok {\n    TIs => true,\n    TIdent(kw) => kw == \"is\",\n    _ => false\n  }\n}\n\nfn parse_infix_loop(tokens: Array[Token], starts: Array[Int], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool, consume_is: Bool, is_top_atom: Bool, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let tok = peek(tokens, next)\n  if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) && is_top_atom {\n    (left, next)\n  } else if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) {\n    let (pat, pn) = parse_pattern(tokens, next + 1)\n    let combined = EMatch(left, [\n      (pat, EBool(true)),\n      (PWild, EBool(false))\n    ])\n    parse_infix_loop(tokens, starts, combined, pn, min_prec, expr_start, true, consume_is, false, parse_recur)\n  } else {\n    let prec = binop_prec(tok)\n    let should_stop = if prec < min_prec {\n      true\n    } else if cmp_locked {\n      prec == 3\n    } else if left_is_stmt_form(left) {\n      match tok {\n        TPlus => true,\n        TMinus => true,\n        _ => false\n      }\n    } else {\n      false\n    }\n    if should_stop {\n      (left, next)\n    } else {\n      let is_pipe = match tok {\n        TPipeGt => true,\n        _ => false\n      }\n      let op = binop_op(tok)\n      if is_pipe {\n        if has_non_pipe_infix_top(tokens, expr_start, next) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        }\n      }\n      let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\n      let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, consume_is, false, parse_recur)\n      if is_pipe {\n        if has_non_pipe_infix_top(tokens, next + 1, rn) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        }\n      }\n      let combined = if is_pipe {\n        pipe_desugar(left, right)\n      } else {\n        EBinOp(op, left, right)\n      }\n      let next_cmp_locked = if prec == 3 {\n        true\n      } else {\n        cmp_locked\n      }\n      parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, consume_is, false, parse_recur)\n    }\n  }\n}\n\nexport fn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, true, parse_recur)\n}\n\nexport fn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, false, parse_recur)\n}\n")
}

let source_10 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_dispatch.vibe",
"\nimport @vibe/ast {\n  Expr, Pat, TypeExpr\n}\n\n\n\n\n\nfn ascribe_wrap(val: Expr, ty: TypeExpr) -> Expr {\n  let tparams = Array::slice([\n    \"\"\n  ], 0, 0)\n  let tbounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let params = [\n    (\"__asc\", Some(ty))\n  ]\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\"__asc\", 0 - 1))\n  ECall(lam, [\n    val\n  ], 0 - 1)\n}\n\nfn distribute_local_fn_ann(ann_ty: TypeExpr, val: Expr) -> Option[Expr] {\n  match ann_ty {\n    TyFn(param_types, ret_ty, effect_name) => match val {\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\n        if Array::length(params) != Array::length(param_types) {\n          None\n        } else {\n          let out = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(params) {\n            let (pname, pann) = Array::get(params, i)\n            let next_ann = match pann {\n              Some(_) => pann,\n              None => Some(Array::get(param_types, i))\n            }\n            ArrayBuilder::push(out, (pname, next_ann))\n            i = i + 1\n          }\n          let next_ret = match ret_opt {\n            Some(_) => ret_opt,\n            None => Some(ret_ty)\n          }\n          let next_eff = match effect_opt {\n            Some(_) => effect_opt,\n            None => effect_name\n          }\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\n        }\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nfn dispatch_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(bname) => {\n        ArrayBuilder::push(b, bname)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nfn dispatch_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        done = true\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = dispatch_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            done = true\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nfn parse_local_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (tps, tbs, after_binder) = dispatch_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_binder, 0)\n      (tps, tbs, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      let no_tp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let no_tb = Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      (no_tp, no_tb, ty, next)\n    }\n  }\n}\n\nfn apply_local_let_tp(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {\n  if Array::length(tps) > 0 {\n    match val {\n      EFn(_, _, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, body),\n      _ => val\n    }\n  } else {\n    val\n  }\n}\n\nfn blk_offset_at(starts: Array[Int], p: Int) -> Int {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nenum BlockStep {\n  StepSeq(Expr);\n  StepValue(Expr);\n  StepLet(String, Expr, Int);\n  StepLetMut(String, Expr, Int);\n  StepLetRec(String, Expr);\n  StepAssign(String, Expr);\n  StepAssignOp(String, String, Expr);\n  StepPattern(Pat, Expr);\n  StepPatternElse(Pat, Expr, Expr);\n  StepStructDestr(Pat, Expr);\n  StepRecordDestr(Pat, Expr);\n  StepBind(String, Expr)\n}\n\nfn desugar_guarded(arms: Array[(Pat, Expr, Expr)], i: Int, scrut: Expr) -> Array[(Pat, Expr)] {\n  if i >= Array::length(arms) {\n    empty_arms()\n  } else {\n    let (pat, guard, body) = Array::get(arms, i)\n    let rest = desugar_guarded(arms, i + 1, scrut)\n    let no_guard = match guard {\n      EBool(bv) => bv,\n      _ => false\n    }\n    let arm_body = if no_guard {\n      body\n    } else {\n      EIf(guard, body, EMatch(scrut, rest))\n    }\n    let out = ArrayBuilder::new()\n    ArrayBuilder::push(out, (pat, arm_body))\n    let mut j = 0\n    while j < Array::length(rest) {\n      ArrayBuilder::push(out, Array::get(rest, j))\n      j = j + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nfn collect_match_arms(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(Pat, Expr, Expr)], hg: Array[Bool], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\n  let (pat, pa) = parse_pattern(tokens, pos)\n  let (guard, after_g) = match peek(tokens, pa) {\n    TIf => {\n      Array::set(hg, 0, true)\n      parse_recur(tokens, pa + 1, 0)\n    },\n    _ => (EBool(true), pa)\n  }\n  let arrow = expect_tk(tokens, after_g, \"=>\")\n  let (body, bn) = parse_recur(tokens, arrow, 0)\n  ArrayBuilder::push(b, (pat, guard, body))\n  match peek(tokens, bn) {\n    TComma => match peek(tokens, bn + 1) {\n      TRBrace => bn + 2,\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\n    },\n    TRBrace => bn + 1,\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\n  }\n}\n\nfn qualify_handle_arm_pattern(effect_name: String, pat: Pat) -> Pat {\n  match pat {\n    PCtor(name, args) => if String::contains(name, \"::\") {\n      PCtor(name, args)\n    } else {\n      PCtor(String::concat(effect_name, String::concat(\"::\", name)), args)\n    },\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\n    _ => pat\n  }\n}\n\nfn parse_handle_arm(tokens: Array[Token], starts: Array[Int], pos: Int, effect_name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } {\n  let (pat, pat_next) = parse_pattern(tokens, pos)\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\n  let arrow_pos = expect_tk(tokens, pat_next, \"=>\")\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\n  ((qualified_pat, expr), next)\n}\n\nfn parse_handle_rest(tokens: Array[Token], starts: Array[Int], pos: Int, body: Expr, effect_name: String, b: ArrayBuilder[(Pat, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    },\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n    _ => throw(\"expected ';' or '}' in handle arm list\")\n  }\n}\n\nfn parse_block_after_expr(tokens: Array[Token], pos: Int, e: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (e, pos + 1),\n    TSemicolon => {\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\n      (ESeq(e, rest), end)\n    },\n    TEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssign(name, val, rest), end)\n      },\n      EDot(obj, field, _, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        let set_args = empty_exprs()\n        Array::push(set_args, obj)\n        Array::push(set_args, EString(field))\n        Array::push(set_args, val)\n        (ESeq(ECall(EIdent(\"__set_field\", -1), set_args, -1), rest), end)\n      },\n      ECall(idx_callee, idx_args, _) => {\n        let is_index = match idx_callee {\n          EIdent(icn, _) => icn == \"__index\",\n          _ => false\n        }\n        if is_index && Array::length(idx_args) == 2 {\n          let val_pair = parse_recur(tokens, pos + 1, 0)\n          let val = val_pair.0\n          let val_next = val_pair.1\n          let a = skip_semi(tokens, val_next)\n          let (rest, end) = parse_recur(tokens, a, 20)\n          let set_args = empty_exprs()\n          Array::push(set_args, Array::get(idx_args, 0))\n          Array::push(set_args, Array::get(idx_args, 1))\n          Array::push(set_args, val)\n          (ESeq(ECall(EIdent(\"Array::set\", -1), set_args, -1), rest), end)\n        } else {\n          throw(\"invalid assignment target\")\n        }\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPlusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"+\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TMinusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"-\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TStarEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"*\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TSlashEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"/\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPercentEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"%\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    _ => {\n      let (rest, end) = parse_recur(tokens, pos, 20)\n      if end <= pos {\n        throw(\"internal parser error: block continuation did not advance\")\n      } else {\n        (ESeq(e, rest), end)\n      }\n    }\n  }\n}\n\nfn parse_block_value_body(tokens: Array[Token], eq: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } {\n  let val_pair = parse_recur(tokens, eq, 0)\n  let val = val_pair.0\n  let val_next = val_pair.1\n  let a = skip_semi(tokens, val_next)\n  let (body, end) = parse_recur(tokens, a, 20)\n  (val, body, end, a)\n}\n\nfn parse_block_value_only(tokens: Array[Token], value_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let val_pair = parse_recur(tokens, value_pos, 0)\n  (val_pair.0, skip_semi(tokens, val_pair.1))\n}\n\nfn apply_struct_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\n  let val_name = \"__struct_destr\"\n  let mut desugar = rest\n  match pat {\n    PStruct(_, fields) => {\n      let mut di = Array::length(fields) - 1\n      while di >= 0 {\n        let (fname, fpat) = Array::get(fields, di)\n        match fpat {\n          PBind(bname) => {\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1, -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nfn apply_record_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\n  let val_name = \"__rec_destr\"\n  let mut desugar = rest\n  match pat {\n    PTuple(field_pats) => {\n      let mut di = Array::length(field_pats) - 1\n      while di >= 0 {\n        let fp = Array::get(field_pats, di)\n        match fp {\n          PBind(bname) => {\n            desugar = ELet(bname, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          PTuple(sub_pats) => {\n            let sub_name = String::concat(\"__rec_sub_\", __to_string(di))\n            let mut si = Array::length(sub_pats) - 1\n            while si >= 0 {\n              match Array::get(sub_pats, si) {\n                PBind(sname) => {\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1, -1), desugar, -1)\n                },\n                _ => ()\n              }\n              si = si - 1\n            }\n            desugar = ELet(sub_name, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nfn apply_block_step(step: BlockStep, rest: Expr) -> Expr {\n  match step {\n    StepSeq(expr) => ESeq(expr, rest),\n    StepValue(expr) => expr,\n    StepLet(name, val, soff) => ELet(name, val, rest, soff),\n    StepLetMut(name, val, soff) => ELetMut(name, val, rest, soff),\n    StepLetRec(name, val) => ELetRec(name, val, rest),\n    StepAssign(name, val) => EAssign(name, val, rest),\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\n    StepPattern(pat, val) => EMatch(val, [\n      (pat, rest)\n    ]),\n    StepPatternElse(pat, val, alt) => EMatch(val, [\n      (pat, rest),\n      (PWild, alt)\n    ]),\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\n    StepBind(name, val) => ECall(EIdent(\"__try_bind\", -1), [\n      val,\n      EFn(Array::slice([\n        \"\"\n      ], 0, 0), Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0), [\n        (name, None)\n      ], None, None, rest)\n    ], -1)\n  }\n}\n\nfn fold_block_steps(steps: Array[BlockStep]) -> Expr {\n  let mut result = EUnit\n  let mut i = Array::length(steps) - 1\n  while i >= 0 {\n    result = apply_block_step(Array::get(steps, i), result)\n    i = i - 1\n  }\n  result\n}\n\nfn parse_optional_let_else(tokens: Array[Token], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Option[Expr], Int) with { Error } {\n  match peek(tokens, pos) {\n    TElse => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_recur(tokens, br, 20)\n      (Some(body), end)\n    },\n    _ => (None, pos)\n  }\n}\n\nfn push_pattern_let_step(tokens: Array[Token], steps: ArrayBuilder[BlockStep], pat: Pat, val: Expr, next_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\n  let (else_body, after) = parse_optional_let_else(tokens, next_pos, parse_recur)\n  match else_body {\n    Some(alt) => ArrayBuilder::push(steps, StepPatternElse(pat, val, alt)),\n    None => ArrayBuilder::push(steps, StepPattern(pat, val))\n  }\n  after\n}\n\nfn parse_impl_block(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  let steps = ArrayBuilder::new()\n  let mut p = pos\n  let mut end_pos = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBrace => {\n        end_pos = p + 1\n        done = true\n      },\n      TEof => throw(\"unexpected eof in block\"),\n      TEnum => {\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\n        match enum_stmt {\n          SEnum(_, _, _, variants, _) => {\n            let mut vi = 0\n            while vi < Array::length(variants) {\n              let (vname, vfields) = Array::get(variants, vi)\n              if Array::length(vfields) == 0 {\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi), -1))\n              }\n              vi = vi + 1\n            }\n          },\n          _ => ()\n        }\n        p = enum_end\n      },\n      TStruct => {\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\n        p = struct_end\n      },\n      TLet => {\n        let next = p + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (rtps, rtbs, rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (tps, tbs, rty, tp) = parse_local_let_annotation(tokens, next + 3)\n                  (tps, tbs, Some(rty), tp)\n                },\n                _ => {\n                  let no_tp = Array::slice([\n                    \"\"\n                  ], 0, 0)\n                  let no_tb = Array::slice([\n                    (\"\", Array::slice([\n                      \"\"\n                    ], 0, 0))\n                  ], 0, 0)\n                  (no_tp, no_tb, None, next + 2)\n                }\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else {\n                let val2 = match rec_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => apply_local_let_tp(rtps, rtbs, distributed),\n                    None => val\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (m_ann, eq_pos_m) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (mty, tp) = parse_type_impl(tokens, next + 3, 0)\n                  (Some(mty), tp)\n                },\n                _ => (None, next + 2)\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else {\n                let val2 = match m_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => distributed,\n                    None => ascribe_wrap(val, the_type)\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetMut(name, val2, blk_offset_at(starts, next - 1)))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TStar => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let* parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepBind(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let*'\")\n          },\n          TIdent(name) => {\n            let after_name = peek(tokens, next + 1)\n            let next_is_struct_destr = match after_name {\n              TDoubleColon => {\n                let fc = String::char_code_at(name, 0)\n                if fc >= 65 && fc <= 90 {\n                  match peek(tokens, next + 2) {\n                    TLBrace => true,\n                    _ => false\n                  }\n                } else {\n                  false\n                }\n              },\n              _ => false\n            }\n            let next_is_record_destr = match after_name {\n              TLBrace => name == \"record\",\n              _ => false\n            }\n            if next_is_struct_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\n              p = next_pos\n            } else if next_is_record_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\n              p = next_pos\n            } else {\n              match after_name {\n                TLParen => {\n                  let (pat, pn) = parse_pattern(tokens, next)\n                  let eq = expect_tk(tokens, pn, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n                  } else {\n                    p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n                  }\n                },\n                _ => {\n                  let (ltps, ltbs, ann_type, eq_pos) = match after_name {\n                    TColon => {\n                      let (tps, tbs, the_type, tp) = parse_local_let_annotation(tokens, next + 2)\n                      (tps, tbs, Some(the_type), tp)\n                    },\n                    _ => {\n                      let no_tp = Array::slice([\n                        \"\"\n                      ], 0, 0)\n                      let no_tb = Array::slice([\n                        (\"\", Array::slice([\n                          \"\"\n                        ], 0, 0))\n                      ], 0, 0)\n                      (no_tp, no_tb, None, next + 1)\n                    }\n                  }\n                  let eq = expect_tk(tokens, eq_pos, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let parser did not advance\")\n                  } else {\n                    let val2 = match ann_type {\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                        Some(distributed) => apply_local_let_tp(ltps, ltbs, distributed),\n                        None => ascribe_wrap(val, the_type)\n                      },\n                      None => val\n                    }\n                    ArrayBuilder::push(steps, StepLet(name, val2, blk_offset_at(starts, next - 1)))\n                    p = next_pos\n                  }\n                }\n              }\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n            if next_pos <= eq {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_recur(tokens, p, 0)\n        if next <= p {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else {\n          match peek(tokens, next) {\n            TRBrace => {\n              ArrayBuilder::push(steps, StepValue(e))\n              end_pos = next + 1\n              done = true\n            },\n            TSemicolon => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next + 1\n            },\n            TEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssign(name, val))\n                p = next_pos\n              },\n              EDot(obj, field, _, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                let set_args = empty_exprs()\n                Array::push(set_args, obj)\n                Array::push(set_args, EString(field))\n                Array::push(set_args, val)\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"__set_field\", -1), set_args, -1)))\n                p = next_pos\n              },\n              ECall(sidx_callee, sidx_args, _) => {\n                let s_is_index = match sidx_callee {\n                  EIdent(sicn, _) => sicn == \"__index\",\n                  _ => false\n                }\n                if s_is_index && Array::length(sidx_args) == 2 {\n                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                  let set_args = empty_exprs()\n                  Array::push(set_args, Array::get(sidx_args, 0))\n                  Array::push(set_args, Array::get(sidx_args, 1))\n                  Array::push(set_args, val)\n                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"Array::set\", -1), set_args, -1)))\n                  p = next_pos\n                } else {\n                  throw(\"invalid assignment target\")\n                }\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPlusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"+\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TMinusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"-\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TStarEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"*\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TSlashEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"/\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPercentEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"%\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            _ => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next\n            }\n          }\n        }\n      }\n    }\n  }\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\n}\n\n\nexport fn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\n  if mode == 20 {\n    parse_impl_block(tokens, starts, pos, parse_recur)\n  } else if mode == 21 {\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIs => {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_recur(tokens, br, 20)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_recur(tokens, tn + 2, 21),\n        TLBrace => parse_recur(tokens, tn + 2, 20),\n        _ => parse_recur(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [\n        (is_pat_val, then_e),\n        (PWild, else_e)\n      ]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == 22 {\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let ab = ArrayBuilder::new()\n        let hg = [false]\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\n        let arms3 = ArrayBuilder::freeze(ab)\n        if Array::get(hg, 0) {\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\"__mg\", 0 - 1))\n          (ELet(\"__mg\", scrutinee, EMatch(EIdent(\"__mg\", 0 - 1), final_arms), -1), endpos)\n        } else {\n          let plain = ArrayBuilder::new()\n          let mut k = 0\n          while k < Array::length(arms3) {\n            let (p, _, bd) = Array::get(arms3, k)\n            ArrayBuilder::push(plain, (p, bd))\n            k = k + 1\n          }\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\n        }\n      }\n    }\n  } else if mode == 23 {\n    let (cond, cn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_recur(tokens, br, 20)\n    (EWhile(cond, body), end)\n  } else if mode == 24 {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_recur(tokens, br, 20)\n    let wp = expect_tk(tokens, bn, \"with\")\n    let (effect_name, effect_next) = match peek(tokens, wp) {\n      TIdent(name) => (name, wp + 1),\n      _ => throw(\"expected effect name after 'with'\")\n    }\n    let hb = expect_tk(tokens, effect_next, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    }\n  } else if mode == 25 {\n    let mut start = pos\n    let mut is_await = false\n    match peek(tokens, pos) {\n      TIdent(marker) => if marker == \"await\" {\n        match peek(tokens, pos + 1) {\n          TIdent(_) => { start = pos + 1; is_await = true },\n          _ => ()\n        }\n      } else (),\n      _ => ()\n    }\n    match peek(tokens, start) {\n      TIdent(first_name) => match peek(tokens, start + 1) {\n        TComma => match peek(tokens, start + 2) {\n          TIdent(second_name) => {\n            let ip = expect_tk(tokens, start + 3, \"in\")\n            match parse_recur(tokens, ip, 0) {\n              (iterable, after_iter) => {\n                let bb = expect_tk(tokens, after_iter, \"{\")\n                let (body, end) = parse_recur(tokens, bb, 20)\n                let loop_expr = if is_await {\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\"__await_iter\", -1), [\n                    iterable\n                  ], -1), body)\n                } else {\n                  EForIn(second_name, Some(first_name), iterable, body)\n                }\n                (loop_expr, end)\n              },\n              _ => throw(\"unreachable: parse_recur for for-in\")\n            }\n          },\n          _ => throw(\"expected value binding name after ','\")\n        },\n        _ => {\n          let ip = expect_tk(tokens, start + 1, \"in\")\n          match parse_recur(tokens, ip, 0) {\n            (iterable, after_iter) => {\n              let bb = expect_tk(tokens, after_iter, \"{\")\n              let (body, end) = parse_recur(tokens, bb, 20)\n              let loop_expr = if is_await {\n                EForIn(first_name, None, ECall(EIdent(\"__await_iter\", -1), [\n                  iterable\n                ], -1), body)\n              } else {\n                EForIn(first_name, None, iterable, body)\n              }\n              (loop_expr, end)\n            },\n            _ => throw(\"unreachable: parse_recur for for-in\")\n          }\n        }\n      }\n      ,\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"internal parser error: unknown parse mode \\{mode} at #\\{pos} token=\\{actual}\")\n  }\n}\n")
}

let source_11 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr.vibe",
