all_true_i8x16\\\" {\\n    // v128_all_true_i8x16(V128) -> Bool\\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn lookup_simd(name: String) -> Option[Type] {\\n  match lookup_simd_mem(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_simd_lane_a(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_simd_lane_b(name) {\\n        Some(t) => Some(t),\\n        None => lookup_simd_reduce(name)\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_37 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_string1.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nfn string1_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn string1_one_param(a: Type) -> Array[Type] {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn string1_two_params(a: Type, b: Type) -> Array[Type] {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn string1_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nfn lookup_string_concat(name: String) -> Option[Type] {\\n  if name == \\\"String::concat\\\" {\\n    Some(CtFn(string1_two_params(CtString, CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_equals(name: String) -> Option[Type] {\\n  if name == \\\"String::equals\\\" {\\n    Some(CtFn(string1_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_length(name: String) -> Option[Type] {\\n  if name == \\\"String::length\\\" {\\n    Some(CtFn(string1_one_param(CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_char_at(name: String) -> Option[Type] {\\n  if name == \\\"string_char_at\\\" {\\n    Some(CtFn(string1_two_params(CtString, C