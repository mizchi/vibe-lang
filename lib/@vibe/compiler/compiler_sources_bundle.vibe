   ]), None))\n  }\n  else None\n}\n\nfn lookup_map_group_c(name: String) -> Option[Type] {\n  match lookup_map_size(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_values(name) {\n      Some(t) => Some(t),\n      None => lookup_map_delete(name)\n    }\n  }\n}\n\nfn lookup_map_group_b(name: String) -> Option[Type] {\n  match lookup_map_has(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_keys(name) {\n      Some(t) => Some(t),\n      None => match lookup_map_has_key(name) {\n        Some(t) => Some(t),\n        None => match lookup_map_set(name) {\n          Some(t) => Some(t),\n          None => lookup_map_group_c(name)\n        }\n      }\n    }\n  }\n}\n\nfn lookup_mapbuilder_new(name: String) -> Option[Type] {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(map_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_set(name: String) -> Option[Type] {\n  if name == \"MapBuilder::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_freeze(name: String) -> Option[Type] {\n  if name == \"MapBuilder::freeze\" {\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_group_a(name: String) -> Option[Type] {\n  match lookup_mapbuilder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_mapbuilder_set(name) {\n      Some(t) => Some(t),\n      None => match lookup_mapbuilder_freeze(name) {\n        Some(t) => Some(t),\n        None => lookup_map_get(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_map(name: String) -> Option[Type] {\n  match lookup_map_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_map_group_b(name)\n  }\n}\n")
