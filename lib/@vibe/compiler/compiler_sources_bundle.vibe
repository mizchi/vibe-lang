let source_62 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/builtin_name.vibe",
"\nexport fn canonical_builtin_name(name: String) -> String {\n  match name {\n    \"Fs::ReadFile\" => \"Fs::read_file\",\n    \"Fs::WriteFile\" => \"Fs::write_file\",\n    \"Fs::ReadBytes\" => \"Fs::read_bytes\",\n    \"Fs::WriteBytes\" => \"Fs::write_bytes\",\n    \"Fs::Exists\" => \"Fs::exists\",\n    \"Fs::StatToken\" => \"Fs::stat_token\",\n    \"Fs::ReadDir\" => \"Fs::readdir\",\n    \"Fs::IsDir\" => \"Fs::is_dir\",\n    \"Fs::IsFile\" => \"Fs::is_file\",\n    \"Fs::Mkdir\" => \"Fs::mkdir\",\n    \"Fs::MkdirP\" => \"Fs::mkdir_p\",\n    \"Fs::Getcwd\" => \"Fs::getcwd\",\n    \"Fs::Chdir\" => \"Fs::chdir\",\n    \"Fs::Remove\" => \"Fs::remove\",\n    \"Fs::Copy\" => \"Fs::copy\",\n    \"Fs::Append\" => \"Fs::append\",\n    \"Fs::Rename\" => \"Fs::rename\",\n    \"Env::Get\" => \"Env::get\",\n    \"Env::ArgsLen\" => \"Env::args_len\",\n    \"Env::ArgsGet\" => \"Env::args_get\",\n    \"Profiler::NowUs\" => \"Profiler::now_us\",\n    \"Profiler::HeapBytes\" => \"Profiler::heap_bytes\",\n    _ => name\n  }\n}\n")
}

let source_63 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/index.vpkg",
"name = @vibe/compiler/codegen/wasm_emit\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/wasm_emit — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/wasm_emit — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package: wasm_emit.vibe (facade, re-exports the bulk\n// of the surface via sections.vibe/instructions.vibe/builders.vibe/simd.vibe/\n// simd_patterns.vibe) plus the directory's other members that the facade\n// re-export chain passes through or that carry their own top-level exports\n// not surfaced by the facade: sections.vibe -> base.vibe -> {code_helpers.vibe,\n// header_types.vibe -> {header_core.vibe -> {header_magic.vibe,\n// header_type_sections.vibe}, header_exports.vibe}} (pure re-export shims,\n// no signatures of their own) and extra.vibe / metadata.vibe (leaf\n// definitions reached only via the sections.vibe re-export chain). Every\n// top-level `export fn` across every file in this directory is declared\n// below, per the directory-membership rule (not just wasm_emit.vibe's own\n// re-exports) — including emit_simd_skip_whitespace_16 /\n// emit_simd_is_identifier_char_16 in simd_patterns.vibe, which are directory\n// members but are NOT re-exported through the facade.\n\n// -- code_helpers.vibe (via base.vibe <- sections.vibe) --\nfn emit_end(buf: Bytes) -> Unit\nfn emit_i32_const(buf: Bytes, value: Int) -> Unit\nfn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit\nfn emit_memory_section(out: Bytes, min_pages: Int) -> Unit\nfn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit\n\n// -- header_magic.vibe (via header_core.vibe <- header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_header(buf: Bytes) -> Unit\n\n// -- header_type_sections.vibe (via header_core.vibe <- header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit\nfn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit\nfn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit\n\n// -- header_exports.vibe (via header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_name(buf: Bytes, name: String) -> Unit\nfn emit_function_section(out: Bytes, type_indices: Array[Int]) -> Unit\nfn emit_export_section_multi(out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit\nfn emit_export_section(out: Bytes, name: String, func_idx: Int) -> Unit\n\n// -- extra.vibe (via sections.vibe) --\nfn emit_global_get(buf: Bytes, idx: Int) -> Unit\nfn emit_heap_memory_grow_check(buf: Bytes) -> Unit\nfn emit_global_set(buf: Bytes, idx: Int) -> Unit\nfn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit\nfn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit\nfn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit\nfn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit\nfn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit\nfn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit\nfn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit\n\n// -- metadata.vibe (via sections.vibe) --\nfn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit\nfn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit\n\n// -- instructions.vibe (direct facade re-export) --\nfn emit_local_get(buf: Bytes, idx: Int) -> Unit\nfn emit_local_set(buf: Bytes, idx: Int) -> Unit\nfn emit_local_tee(buf: Bytes, idx: Int) -> Unit\nfn emit_i64_const(buf: Bytes, value: Int) -> Unit\nfn emit_i64_add(buf: Bytes) -> Unit\nfn emit_i64_sub(buf: Bytes) -> Unit\nfn emit_i64_mul(buf: Bytes) -> Unit\nfn emit_i64_div_s(buf: Bytes) -> Unit\nfn emit_i64_rem_s(buf: Bytes) -> Unit\nfn emit_i64_and(buf: Bytes) -> Unit\nfn emit_i64_or(buf: Bytes) -> Unit\nfn emit_i64_xor(buf: Bytes) -> Unit\nfn emit_i64_shl(buf: Bytes) -> Unit\nfn emit_i64_shr_s(buf: Bytes) -> Unit\nfn emit_i64_eq(buf: Bytes) -> Unit\nfn emit_i64_ne(buf: Bytes) -> Unit\nfn emit_i64_lt_s(buf: Bytes) -> Unit\nfn emit_i64_gt_s(buf: Bytes) -> Unit\nfn emit_i64_le_s(buf: Bytes) -> Unit\nfn emit_i64_ge_s(buf: Bytes) -> Unit\nfn emit_i64_eqz(buf: Bytes) -> Unit\nfn emit_call(buf: Bytes, func_idx: Int) -> Unit\nfn emit_drop(buf: Bytes) -> Unit\nfn emit_return(buf: Bytes) -> Unit\nfn emit_block_void(buf: Bytes) -> Unit\nfn emit_block_i64(buf: Bytes) -> Unit\nfn emit_loop_void(buf: Bytes) -> Unit\nfn emit_if_void(buf: Bytes) -> Unit\nfn emit_if_i64(buf: Bytes) -> Unit\nfn emit_else(buf: Bytes) -> Unit\nfn emit_br(buf: Bytes, label: Int) -> Unit\nfn emit_br_if(buf: Bytes, label: Int) -> Unit\nfn emit_i64_extend_i32_s(buf: Bytes) -> Unit\nfn emit_i32_wrap_i64(buf: Bytes) -> Unit\nfn emit_i32_add(buf: Bytes) -> Unit\nfn emit_i32_and(buf: Bytes) -> Unit\nfn emit_i32_eq(buf: Bytes) -> Unit\nfn emit_i32_ne(buf: Bytes) -> Unit\nfn emit_i32_sub(buf: Bytes) -> Unit\nfn emit_i32_gt_u(buf: Bytes) -> Unit\nfn emit_i32_eqz(buf: Bytes) -> Unit\nfn emit_i32_shr_u(buf: Bytes) -> Unit\nfn emit_i32_shl(buf: Bytes) -> Unit\nfn emit_i32_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_store8(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_load8_u(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_f64_const_bits(buf: Bytes, bits: Int) -> Unit\nfn emit_f64_const_lohi(buf: Bytes, lo: Int, hi: Int) -> Unit\nfn emit_f64_add(buf: Bytes) -> Unit\nfn emit_f64_sub(buf: Bytes) -> Unit\nfn emit_f64_mul(buf: Bytes) -> Unit\nfn emit_f64_div(buf: Bytes) -> Unit\nfn emit_f64_eq(buf: Bytes) -> Unit\nfn emit_f64_ne(buf: Bytes) -> Unit\nfn emit_f64_lt(buf: Bytes) -> Unit\nfn emit_f64_gt(buf: Bytes) -> Unit\nfn emit_f64_le(buf: Bytes) -> Unit\nfn emit_f64_ge(buf: Bytes) -> Unit\nfn emit_f64_neg(buf: Bytes) -> Unit\nfn emit_f64_abs(buf: Bytes) -> Unit\nfn emit_f64_ceil(buf: Bytes) -> Unit\nfn emit_f64_floor(buf: Bytes) -> Unit\nfn emit_f64_max(buf: Bytes) -> Unit\nfn emit_f64_min(buf: Bytes) -> Unit\nfn emit_i64_reinterpret_f64(buf: Bytes) -> Unit\nfn emit_f64_reinterpret_i64(buf: Bytes) -> Unit\nfn emit_i64_trunc_f64_s(buf: Bytes) -> Unit\nfn emit_f64_convert_i64_s(buf: Bytes) -> Unit\nfn emit_call_indirect(buf: Bytes, type_idx: Int) -> Unit\nfn emit_table_section_funcref(out: Bytes, num_entries: Int) -> Unit\nfn emit_element_section_active(out: Bytes, func_indices: Array[Int]) -> Unit\nfn emit_element_section_active_runs(out: Bytes, slots: Array[Int], func_indices: Array[Int]) -> Unit\nfn emit_struct_type_raw(buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit\nfn emit_array_type_raw(buf: Bytes, elem_type: Int, is_mut: Int) -> Unit\nfn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit\nfn emit_array_new(buf: Bytes, type_idx: Int) -> Unit\nfn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit\nfn emit_struct_set(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit\nfn emit_ref_func(buf: Bytes, func_idx: Int) -> Unit\nfn emit_call_ref(buf: Bytes, type_idx: Int) -> Unit\nfn emit_ref_null(buf: Bytes, heap_type_byte: Int) -> Unit\n\n// -- builders.vibe (direct facade re-export) --\nfn build_add_module() -> Bytes\nfn build_call_module() -> Bytes\nfn build_arithmetic_module() -> Bytes\nfn build_fibonacci_module() -> Bytes\nfn build_factorial_module() -> Bytes\nfn build_hello_module() -> Bytes\nfn string_to_data(s: String) -> Bytes\nfn emit_data_section_multi(out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit\nfn build_print_string_module(msg: String) -> Bytes\n\n// -- simd.vibe (direct facade re-export) --\nfn emit_v128_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_v128_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i8x16_splat(buf: Bytes) -> Unit\nfn emit_i8x16_eq(buf: Bytes) -> Unit\nfn emit_i8x16_le_u(buf: Bytes) -> Unit\nfn emit_i8x16_ge_u(buf: Bytes) -> Unit\nfn emit_i8x16_swizzle(buf: Bytes) -> Unit\nfn emit_i8x16_sub(buf: Bytes) -> Unit\nfn emit_i8x16_min_u(buf: Bytes) -> Unit\nfn emit_v128_any_true(buf: Bytes) -> Unit\nfn emit_i8x16_all_true(buf: Bytes) -> Unit\nfn emit_i8x16_bitmask(buf: Bytes) -> Unit\nfn emit_v128_and(buf: Bytes) -> Unit\nfn emit_v128_or(buf: Bytes) -> Unit\nfn emit_v128_not(buf: Bytes) -> Unit\nfn emit_v128_const(buf: Bytes, lanes: Array[Int]) -> Unit\nfn emit_v128_const_zero(buf: Bytes) -> Unit\nfn emit_v128_const_splat_byte(buf: Bytes, byte_val: Int) -> Unit\n\n// -- simd_patterns.vibe (facade re-export: emit_simd_memcmp_16,\n// emit_simd_find_byte_16, emit_scalar_memcmp_16_unrolled,\n// emit_scalar_find_byte_16_unrolled; directory-member-only, NOT re-exported\n// through wasm_emit.vibe: emit_simd_skip_whitespace_16,\n// emit_simd_is_identifier_char_16) --\nfn emit_simd_memcmp_16(buf: Bytes) -> Unit\nfn emit_simd_find_byte_16(buf: Bytes) -> Unit\nfn emit_simd_skip_whitespace_16(buf: Bytes) -> Unit\nfn emit_simd_is_identifier_char_16(buf: Bytes) -> Unit\nfn emit_scalar_memcmp_16_unrolled(buf: Bytes) -> Unit\nfn emit_scalar_find_byte_16_unrolled(buf: Bytes) -> Unit\n")
