"\nimport @vibe/compiler/core {\n  Expr\n}\n\n\n\n\nexport fn rewrite_interp_string(parts: Array[String]) -> Expr with { Error } {\n  let result_arr = collect_interp_exprs(parts)\n  fold_interp_exprs(result_arr)\n}\n")
