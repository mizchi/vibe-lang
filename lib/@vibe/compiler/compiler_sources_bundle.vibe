g, e.g. separate arms with the same body, or bind after matching)\", off_marker(or_off)))\n          } else {\n            ()\n          }\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\n          si = ns\n          ci = nc\n          if ai == 0 {\n            result_ty = arm_ty\n            let r0 = subst_apply(si, arm_ty)\n            check_arms = match r0 {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            }\n            railway_arms = railway_head(r0) != 0\n          } else {\n            if check_arms {\n              let r2 = subst_apply(si, arm_ty)\n              si = if arm_body_diverges(body) {\n                si\n              } else {\n                match r2 {\n                  CtUnit => si,\n                  _ => check_assignable(result_ty, r2, si, errors, \"match arms have incompatible types\", 0 - 1)\n                }\n              }\n            } else if railway_arms {\n              if arm_body_diverges(body) {\n                ()\n              } else {\n                let rr0 = subst_apply(si, result_ty)\n                let rr2 = subst_apply(si, arm_ty)\n                if railway_heads_conflict(rr0, rr2) {\n                  Array::push(errors, String::concat(\"match arms have incompatible types\", String::concat(\": expected \", String::concat(type_to_string(rr0), String::concat(\", got \", String::concat(type_to_string(rr2), off_marker(railway_expr_off(scrutinee))))))))\n                } else {\n                  ()\n                }\n              }\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n        let enum_name_opt = match subst_apply(si, scr_ty) {\n          CtEnum(en) => Some(en),\n          CtNamed(en, _) => Some(