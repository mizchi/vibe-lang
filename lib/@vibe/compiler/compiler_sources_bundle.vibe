"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_gt_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\nfn emit_mem_size_bytes(b: Bytes) -> Unit {\n  bytebuf_push(b, 63)\n  bytebuf_push(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 65536)\n  emit_i64_mul(b)\n}\n\nfn emit_looks_like_string(b: Bytes, slot: Int) -> Unit {\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i64_add(b)\n  emit_mem_size_bytes(b)\n  emit_i64_le_s(b)\n}\n\nexport fn gen_eq_body(str_eq_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  emit_looks_like_string(b, 0)\n  emit_looks_like_string(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nfn emit_looks_like_string_strict(b: Bytes, slot: Int) -> Unit {\n  emit_looks_like_string(b, slot)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_i64_const(b, 64)\n  emit_i64_ge_s(b)\n  bytebuf_push(b, 113)\n}\n\nexport fn gen_generic_rel_diff_body(enable_rc: Bool, str_lex_diff_idx: Int) -> Bytes {\n  let neg1 = if enable_rc {\n    0 - 2\n  } else {\n    0 - 1\n  }\n  let pos1 = if enable_rc {\n    2\n  } else {\n    1\n  }\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_lex_diff_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, neg1)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, pos1)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_generic_add_body(str_concat_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_concat_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_add(b)\n  emit_end(b)\n  b\n}\n")
}

