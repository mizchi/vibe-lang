let source_34 = () -> (String, String) {
  ("lib/@vibe/compiler/syntax/index.vpkg",
"name = @vibe/compiler/syntax\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/syntax — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/core : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/syntax — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package: syntax.vibe (facade) plus the directory's\n// other pure re-export-shim members (token.vibe, float_format.vibe,\n// lexer.vibe, parser.vibe, parser_base.vibe, parser_expr.vibe, printer.vibe)\n// -- all of them re-export a subset of syntax.vibe's own surface from the\n// already-vpkg'd @vibe/parser package, so every name below is already\n// declared by @vibe/parser/index.vpkg. Token is a bodyless type declaration\n// for the same reason @vibe/parser's own contract declares it bodyless (the\n// enum ctors live in @vibe/parser/token.vibe). parser_recur_effect.vibe is a\n// directory member whose ParseRecur effect the facade does not itself\n// re-export (nothing outside this directory currently imports it directly),\n// but the directory-membership rule still requires the contract to account\n// for it (see codegen/gc/index.vpkg's `opaque type CompileLambdaGcFn` for\n// the same \"member the facade doesn't re-export\" shape, though ParseRecur is\n// an effect, not a type).\n\ntype Token\n\neffect ParseRecur {\n  Call(Array[Token], Int, Int) -> (Expr, Int)\n}\n\n// --- token\nfn token_to_string(t: Token) -> String\n\n// --- float_format\nfn double_to_string_compiler(d: Double) -> String\n\n// --- lexer\nfn lex(src: String) -> Array[Token] with { Error }\nfn lex_ok(src: String) -> Bool\nfn lex_with_offsets(src: String) -> (Array[Token], Array[Int], Array[Int]) with { Error }\nfn lex_with_offsets_recovering(src: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String])\nfn offset_to_line_col(src: String, offset: Int) -> (Int, Int)\nfn collect_doc_comments(src: String) -> Array[(Int, String)]\n\n// --- parser_base\nfn peek(tokens: Array[Token], pos: Int) -> Token\nfn tk_name(t: Token) -> String\nfn skip_semi(tokens: Array[Token], pos: Int) -> Int\nfn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error }\nfn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error }\n\n// --- parser_expr\nfn parse(tokens: Array[Token]) -> Expr with { Error }\nfn parse_ok(tokens: Array[Token]) -> Bool\nfn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error }\nfn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error }\n\n// --- parser\nfn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\nfn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\nfn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error }\nfn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error }\nfn parse_program_located(tokens: Array[Token], starts: Array[Int], src: String) -> Array[Stmt] with { Error }\nfn parse_program_recovering(tokens: Array[Token], starts: Array[Int], src: String) -> (Array[Stmt], Array[String]) with { Error }\nfn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error }\n\n// --- printer\nfn print_pat(p: Pat) -> String\nfn print_type_expr(t: TypeExpr) -> String\nfn print_expr(e: Expr) -> String\nfn print_stmt(s: Stmt) -> String\nfn print_program(stmts: Array[Stmt]) -> String\n")
}

