tring) -> Int with { Error, Fs } {\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nlet selfhost_cli_trigger_path = \"_build/bench/selfhost_cli_adapter/.compile_cli_trigger\"\nlet selfhost_cli_stage1_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_stage1.wasm\"\nlet selfhost_cli_merged_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_merged_dump.vibe\"\nlet selfhost_cli_module_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_module_dump.vibe\"\n\n\nexport fn selfbuild_entry() -> Int with { Error, Fs } {\n  handle {\n    if Fs::exists(selfhost_cli_trigger_path) {\n      compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n    } else {\n      0\n    }\n  } with Error {\n    Throw(_) => 0\n  }\n}\n\nexport fn selfbuild_write_cli_adapter() -> Int with { Error, Fs } {\n  compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n}\n\nexport fn selfbuild_dump_cli_adapter_merged_source() -> Int with { Error, Fs } {\n  Fs::write_bytes(\n    selfhost_cli_merged_dump_path,\n    string_to_bytes(selfhost_cli_adapter_merged_source())\n  )\n  0\n}\n\nexport fn selfbuild_dump_cli_adapter_module_source() -> Int with { Error, Fs } {\n  Fs::write_bytes(\n    selfhost_cli_module_dump_path,\n    string_to_bytes(selfhost_cli_adapter_module_source())\n  )\n  0\n}\n\nexport fn selfbuild_dump_cli_adapter_merged_source_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport fn selfbuild_dump_cli_adapter_module_source_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport fn probe_dump_cli_adapter_merged_source_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport fn probe_dump_cli_adapter_module_source_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport fn probe_write_bytes_smoke() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(\"ok\\n\"))\n  0\n}\n\nexport fn selfbuild_cli_env_entry() -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else if entry_name == \"\" {\n    1\n  }\n  else {\n    let source = Fs::read_file(input_path)\n    let bytes = compile_source_wasi_only(source, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport fn selfbuild_probe_cli_env_read_len() -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let source = Fs::read_file(input_path)\n  String::length(source)\n}\n\nexport fn selfbuild_probe_cli_env_compile_len() -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_probe_cli_args_read_len() -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let source = Fs::read_file(input_path)\n  String::length(source)\n}\n\nexport fn selfbuild_probe_cli_args_compile_len() -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let entry_name = if Env::args_len() > 2 { Env::args_get(2) } else { \"\" }\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_cli_args_entry() -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let output_path = if Env::args_len() > 1 { Env::args_get(1) } else { \"\" }\n  let entry_name = if Env::args_len() > 2 { Env::args_get(2) } else { \"\" }\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else if entry_name == \"\" {\n    1\n  }\n  else {\n    let source = Fs::read_file(input_path)\n    let bytes = if Env::get(\"VIBE_RC\") != \"0\" {\n      compile_source_wasi_only_rc(source, entry_name)\n    } else {\n      compile_source_wasi_only(source, entry_name)\n    }\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport fn selfbuild_cli_entry() -> Int with { Error, Fs, Env } {\n  let input_path = \"_build/bench/selfhost_cli_adapter/adapter_input.vibe\"\n  let output_path = \"_build/bench/selfhost_cli_adapter/adapter_output.wasm\"\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else {\n    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, \"main\")\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport fn selfbuild_compile_stage2() -> Bytes with { Error } {\n  let main_source = selfbuild_runtime_entry_source()\n  if main_source == \"\" { throw(\"selfbuild_runtime_entry_source is empty\") }\n  compile_source_wasi_only(main_source, \"selfbuild_entry\")\n}\n\nexport fn selfbuild_compile_cli_adapter() -> Bytes with { Error } {\n  build_selfhost_cli_adapter_bytes()\n}\n\nexport fn selfbuild_compile_cli_adapter_rc_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes_rc()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport fn selfbuild_compile_cli_adapter_env() -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport fn selfbuild_probe_compile_cli_adapter_embedded_module_len() -> Int with { Error } {\n  let bytes = build_selfhost_cli_adapter_bytes()\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_probe_compile_env_get_len() -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { let _x = perform Env::Get(\\\"VIBE_INPUT\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_probe_compile_fs_read_file_len() -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { let _x = perform Fs::ReadFile(\\\"/tmp/in.txt\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_probe_compile_fs_write_bytes_len() -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { Fs::write_bytes(\\\"/tmp/out.wasm\\\", Bytes::from_array([1])); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport fn selfbuild_stage1_probe_cli_cache_counts() -> Int with { Error, Fs } {\n  selfbuild_probe_cli_cache_counts()\n}\n\nexport fn selfbuild_stage1_probe_cli_file_cache_counts() -> Int with { Error, Fs } {\n  selfbuild_probe_cli_file_cache_counts()\n}\n\nexport fn selfbuild_stage1_probe_type_db_cache_counts() -> Int with { Error } {\n  selfbuild_probe_type_db_cache_counts()\n}\n\nexport fn selfbuild_stage1_probe_type_db_fs_parse_counts() -> Int with { Error, Fs } {\n  let helper_path = \"_build/persistent_type_env_probe_helper.vibe\"\n  let main_path = \"_build/persistent_type_env_probe_main.vibe\"\n  let helper_source = \"export let add: () -> Int = () -> { 1 }\"\n  let main_source = \"import ./persistent_type_env_probe_helper.vibe { add }\\nlet run: () -> Int = () -> { add() }\"\n  Fs::write_bytes(helper_path, string_to_bytes(helper_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let db1 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_stage1_probe_type_db_group_merge_counts() -> Int with { Error } {\n  selfbuild_probe_type_db_group_merge_counts()\n}\n\nexport fn selfbuild_stage1_probe_type_db_module_source_counts() -> Int with { Error } {\n  selfbuild_probe_type_db_module_source_counts()\n}\n\nexport fn selfbuild_stage1_probe_type_db_codegen_counts() -> Int with { Error } {\n  selfbuild_probe_type_db_codegen_counts()\n}\n\nexport fn selfbuild_probe_lex() -> Int with { Error } {\n  let tokens = lex(\"let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  Array::length(tokens)\n}\n\nexport fn selfbuild_probe_parse() -> Int with { Error } {\n  let tokens = lex(\"let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  let stmts = parse_program(tokens)\n  Array::length(stmts)\n}\n\nexport {\n  Pat, lex, Expr, Stmt, Token, Type, TypeEnv, Subst, TypeDef, TypeDb,\n  parse, version, TypeExpr, parse_ok, print_pat, parse_expr, parse_stmt, parse_type,\n  print_expr, print_stmt, compiler_lex, parse_program, print_program, compiler_parse,\n  print_type_expr, token_to_string, compiler_parse_ok, compiler_print_pat,\n  compiler_parse_expr, compiler_parse_stmt, compiler_parse_type, compiler_print_expr,\n  compiler_print_stmt, compiler_parse_program, compiler_print_program,\n  compiler_print_type_expr,\n  check_program, check_program_with_env, check_stmts,\n  db_new, db_set_source, db_check_env, db_typecheck, db_typecheck_count,\n  db_parse_count, db_merge_count, db_module_source_count, db_codegen_count,\n  db_program_source, db_merged_source, db_grouped_merged_source, db_module_source,\n  db_load_artifact, db_store_artifact,\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources,\n  compile_source, compile_source_wasi,\n  compile_with_modules, compile_with_modules_wasi, prepare_modules_cached,\n  compile_with_modules_cached, compile_with_modules_wasi_cached,\n  compile_file_fs, compile_file_fs_module, prepare_file_fs_cached,\n  compile_file_fs_cached, compile_file_fs_module_cached,\n  parse_batch_jobs_tsv, prepare_jobs_cached, compile_jobs_cached,\n  selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_file_cache_counts,\n  selfbuild_probe_type_db_cache_counts, selfbuild_probe_type_db_fs_parse_counts,\n  selfbuild_probe_type_db_group_merge_counts,\n  selfbuild_probe_type_db_module_source_counts, selfbuild_probe_type_db_codegen_counts,\n  selfbuild_compile_stage2, selfbuild_compile_cli_adapter, selfbuild_entry,\n  selfbuild_write_cli_adapter, selfbuild_cli_env_entry,\n  selfbuild_cli_args_entry\n}\n")
}

