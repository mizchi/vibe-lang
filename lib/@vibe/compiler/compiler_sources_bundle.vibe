   None\n  }\n}\n\nfn lookup_simd_reduce(name: String) -> Option[Type] {\n  if name == \"v128_bitmask_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))\n  } else if name == \"v128_any_true\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else if name == \"v128_all_true_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_simd(name: String) -> Option[Type] {\n  match lookup_simd_mem(name) {\n    Some(t) => Some(t),\n    None => match lookup_simd_lane_a(name) {\n      Some(t) => Some(t),\n      None => match lookup_simd_lane_b(name) {\n        Some(t) => Some(t),\n        None => lookup_simd_reduce(name)\n      }\n    }\n  }\n}\n")
