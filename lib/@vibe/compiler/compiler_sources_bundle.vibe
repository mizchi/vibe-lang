l_get(b, 5)\\n  emit_memory_copy(b)\\n  emit_local_get(b, 8)\\n  emit_local_get(b, 5)\\n  emit_i32_add(b)\\n  emit_local_set(b, 8)\\n  emit_end(b)\\n  // cur = arr[i]; cur_ptr = hi32(cur); cur_len = lo32(cur)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 3)\\n  emit_i64_extend_i32_u(b)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  } else {\\n    ()\\n  }\\n  emit_call(b, arr_get_idx)\\n  emit_local_set(b, 11)\\n  emit_local_get(b, 11)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 9)\\n  emit_local_get(b, 11)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 10)\\n  // memcpy(pos, cur_ptr, cur_len); pos += cur_len\\n  emit_local_get(b, 8)\\n  emit_local_get(b, 9)\\n  emit_local_get(b, 10)\\n  emit_memory_copy(b)\\n  emit_local_get(b, 8)\\n  emit_local_get(b, 10)\\n  emit_i32_add(b)\\n  emit_local_set(b, 8)\\n  emit_local_get(b, 3)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 3)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  // result = (base << 32) | total\\n  emit_local_get(b, 7)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 32)\\n  emit_i64_shl(b)\\n  emit_local_get(b, 4)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_or(b)\\n  emit_end(b)\\n  b\\n}\\n\\nexport fn gen_string_trim_body(enable_rc: Bool, str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_call(b, str_len_idx)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 1)\\n  emit_local_set(b, 3)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 2)\\n  emit_i64_extend_i32_u(b)\\n  // ADR-0055: ch