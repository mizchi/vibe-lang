"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn gc_reject_inline_wasm(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\n        EFn(_, _, _, _, _, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              throw(\"inline wasm fn '\\{iw_name}' (= wasm \\\"...\\\") is linear-backend only; the wasm-gc backend does not support it (#805)\")\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  gc_reject_inline_wasm(stmts)\n  rewrite_top_level_fn_alias_refs(stmts)\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_needs_env_list = Array::slice([\n    true\n  ], 0, 0)\n  let user_func_stmts = Array::slice([\n    SExpr(EUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, _) => {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_needs_env_list, true)\n          Array::push(user_func_stmts, stmt)\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let (gc_ctor_names_sorted, gc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  let gc_const_names_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_const_kinds_l = Array::slice([\n    0\n  ], 0, 0)\n  let gc_const_ivals_l = Array::slice([\n    0\n  ], 0, 0)\n  let gc_const_svals_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_global_names_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_global_exprs_l = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut gci = 0\n  while gci < Array::length(stmts) {\n    match Array::get(stmts, gci) {\n      SLet(_, _, cname, _, cval) => match cval {\n        EInt(iv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, iv)\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EBool(bv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals