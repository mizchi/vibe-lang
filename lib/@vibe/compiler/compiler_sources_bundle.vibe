h lookup_builtin(name) {\n                  Some(_) => false,\n                  None => true\n                }\n              }\n            } else {\n              false\n            }\n            let recv_method = if method_form {\n              let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n              let recv_ty = subst_apply(sa, a0_ty)\n              let qual = String::concat(type_name_prefix(recv_ty), String::concat(\"::\", name))\n              let has_qual = match env_lookup(env, qual) {\n                Some(_) => true,\n                None => match lookup_builtin(qual) {\n                  Some(_) => true,\n                  None => false\n                }\n              }\n              let user_recv = match recv_ty {\n                CtEnum(_) => true,\n                CtStruct(_) => true,\n                CtNamed(_, _) => true,\n                _ => false\n              }\n              if has_qual || user_recv {\n                Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))\n              } else {\n                None\n              }\n            } else {\n              None\n            }\n            match recv_method {\n            Some(rm) => rm,\n            None => {\n            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\n            let alen = Array::length(args)\n            let arg_tys = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            let mut s2 = s1\n            let mut c2 = c1\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n              Array::push(arg_tys, at)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\n                let call_ret = Array::get(ret_box, 0)\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n              },\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n              other => {\n                let not_callable = match other {\n                  CtInt => true,\n                  CtDouble => true,\n                  CtBool => true,\n                  CtString => true,\n                  CtChar => true,\n                  CtUnit => true,\n                  CtBytes => true,\n                  CtTuple(_) => true,\n                  CtArray(_) => true,\n                  CtOption(_) => true,\n                  CtEnum(_) => true,\n                  _ => false\n                }\n                if not_callable {\n                  Array::push(errors, String::concat(String::concat(\"calling a non-function value: \", name), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n              }\n            }\n            }\n            }\n          }\n        }\n        }\n      },\n      EDot(obj, method, _, qcall_field_off) => {\n        let qualified_key = match obj {\n          EIdent(ns, _) => match env_lookup(env, ns) {\n            Some(_) => None,\n            None => Some(String::concat(ns, String::concat(\".\", method)))\n          },\n          _ => None\n        }\n        let qualified_hit = match qualified_key {\n          Some(k) => env_lookup(env, k),\n          None => None\n        }\n        match qualified_hit {\n        Some(_) => match qualified_key {\n          Some(k) => check_expr(ECall(EIdent(k, qcall_field_off), args, call_off), env, defs, s, c, errors, tytab),\n          None => (CtUnknown, s, c)\n        },\n        None => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let has_real_fn_binding = match env_lookup(env, qualified) {\n          Some(_) => true,\n          None => false\n        }\n        if !has_real_fn_binding && is_known_builtin_receiver_prefix(type_prefix) {\n        match lookup_builtin(qualified) {\n          Some(_) => {\n            Array::push(errors, String::concat(\"dot-call syntax is not supported for the builtin method `\", String::concat(qualified, String::concat(\"` -- call it as `\", String::concat(qualified, String::concat(\"(...)`\", off_marker_len(qcall_field_off, String::length(method))))))))\n            (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n          },\n          None => {\n            let bare_hint = match env_lookup(env, method) {\n              Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n              None => \"(...)`\"\n            }\n            Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n            (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n          }\n        }\n        } else {\n        let direct_ret = direct_call_return(env, qualified)\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        let applied_method_ty = match mt {\n          CtFn(_, _, _) => mt,\n          _ => subst_apply(s3, mt)\n        }\n        match applied_method_ty {\n          CtFn(param_tys, ret, _) => {\n            let ret_box = Array::slice([\n              ret\n            ], 0, 1)\n            let call_param_tys = param_tys\n            let plen = Array::length(param_tys)\n            let alen2 = Array::length(arg_tys)\n            if alen2 != plen {\n              Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\n            }\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\n            let call_ret = Array::get(ret_box, 0)\n            let selected_ret = match direct_ret {\n              Some(t) => t,\n              None => call_ret\n            }\n            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\n          },\n          _ => {\n            let field_fn = receiver_struct_field_type(defs, subst_apply(s3, obj_ty), method)\n            match field_fn {\n              Some(CtFn(fpts, fret, _)) => {\n                let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\n                if Array::length(fpts) != Array::length(explicit) {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(Array::length(fpts)), String::concat(\" args, got \", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\n                }\n                let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\n                (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\n              },\n              _ => match direct_ret {\n                Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\n                None => {\n                  let no_field = match field_fn {\n                    None => true,\n                    _ => false\n                  }\n                  let local_user_ty = if type_prefix == \"\" {\n                    false\n                  } else {\n                    match find_typedef(defs, type_prefix) {\n                      Some(_) => true,\n                      None => false\n                    }\n                  }\n                  let has_method_binding = match env_lookup(env, qualified) {\n                    Some(_) => true,\n                    None => match lookup_builtin(qualified) {\n                      Some(_) => true,\n                      None => false\n                    }\n                  }\n                  if no_field && local_user_ty && !has_method_binding {\n                    let bare_hint = match env_lookup(env, method) {\n                      Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n                      None => \"(...)`\"\n                    }\n                    Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n                  } else {\n                    ()\n                  }\n                  (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\n                }\n              }\n            }\n          }\n        }\n        }\n        }\n        }\n      },\n      _ => {\n        let asc_ann = if Array::length(args) == 1 {\n          ascription_lambda_ann(callee)\n        } else {\n          None\n        }\n        match asc_ann {\n          Some(ann_te) => {\n            let (at, ns0, nc0) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n            let resolved = resolve_type_expr(ann_te, defs)\n            let actual = subst_apply(ns0, at)\n            let ns2 = check_assignable(resolved, actual, ns0, errors, \"binding type mismatch for a local let\", call_off)\n            let bound_ty = preserve_generic_instantiation(resolved, subst_apply(ns2, actual))\n            (tab_call_ty(tytab, cal