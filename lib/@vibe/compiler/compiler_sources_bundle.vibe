me(t) => Some(t),\\n      None => lookup_io_c(name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_30 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_map.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nfn map_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn map_one_param(a: Type) -> Array[Type] {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn map_two_params(a: Type, b: Type) -> Array[Type] {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nfn lookup_map_get(name: String) -> Option[Type] {\\n  if name == \\\"Map::get\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_map_has(name: String) -> Option[Type] {\\n  if name == \\\"map_has\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_map_set(name: String) -> Option[Type] {\\n  if name == \\\"Map::set\\\" {\\n    // Functional update: returns the (new) map, matching the host checker\\n    // (src/checker typecheck_call_builtin \\\"Map::set\\\"), not Unit.\\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed(\\\"Map\\\", [\\n      CtString,\\n      CtUnknown\\n    ]), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_map_keys(name: String) -> Option[Type] {\\n  if name == \\\"Map::keys\\\" {\\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_map_has_key(name: String) -> Option[Type] {\\n  if name == \\\"Map::has_key\\\" || name == \\\"Map::has\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_map_size