t_body, gc_native_alloc_probe_array_type_idx)\n  emit_drop(start_body)\n  emit_i64_const(start_body, 0)\n  emit_call(start_body, entry_func_idx)\n  if entry_returns_unit {\n    emit_drop(start_body)\n  } else {\n    emit_call(start_body, 1 + hbo)\n  }\n  let num_lambdas = Array::length(lt_w.bodies)\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, start_extra_locals)\n  Array::push(user_ref_local_indices_all, array_empty())\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    Array::push(user_ref_local_indices_all, array_empty())\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai2 = 0\n  while uai2 < num_user_funcs {\n    let upc = Array::get(ft_params, uai2)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai2 = uai2 + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  let num_base_types = 12\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(type_content, [\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, array_empty(), [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_struct_type_raw(type_content, [\n    126\n  ], [\n    1\n  ])\n  emit_array_type_raw(type_content, 126, 0)\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    let ct_params = array_empty()\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  if use_host {\n    let imp_content = bytebuf_new()\n    bytebuf_push_vec_header(imp_content, 11)\n    emit_name(imp_content, \"wasi_snapshot_preview1\")\n    emit_name(imp_content, \"fd_write\")\n    bytebuf_push(imp_content, 0)\n    leb128_encode_u32(imp_content, 0)\n    let host_imports = [\n      (\"env-get\", 3),\n      (\"args-len\", 5),\n      (\"args-get\", 3),\n      (\"fs_read_file\", 3),\n      (\"fs_exists\", 3),\n      (\"fs_stat_token\", 3),\n      (\"fs_write_file\", 6),\n      (\"fs_write_bytes\", 6),\n      (\"fs_read_bytes\", 3),\n      (\"profile-now-us\", 5)\n    ]\n    let mut __hi = 0\n    while __hi < Array::length(host_imports) {\n      let (hin, hit) = Array::get(host_imports, __hi)\n      emit_name(imp_content, \"vibe\")\n      emit_name(imp_content, hin)\n      bytebuf_push(imp_content, 0)\n      leb128_encode_u32(imp_content, hit)\n      __hi = __hi + 1\n    }\n    bytebuf_push_section(out, 2, imp_content)\n  } else {\n    emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  }\n  let func_type_indices = array_empty()\n  let mut gbti = 0\n  while gbti < Array::length(gc_builtin_type_idxs) {\n    Array::push(func_type_indices, Array::get(gc_builtin_type_idxs, gbti))\n    gbti = gbti + 1\n  }\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(ft_params, fti)\n    Array::push(func_type_indices, closure_type_base + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, closure_type_base + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"gc codegen internal error: function section and code section count mismatch\")\n  } else {\n    ()\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, 1)\n  if stmts_contain_exceptions(stmts) {\n    let tag_content = bytebuf_new()\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push(tag_content, 0)\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  if Array::length(gc_global_names_l) == 0 {\n    emit_global_section_i32_mut(out, heap_start)\n  } else {\n    let g_content = bytebuf_new()\n    bytebuf_push_vec_header(g_content, 1 + Array::length(gc_global_names_l))\n    bytebuf_push(g_content, 127)\n    bytebuf_push(g_content, 1)\n    emit_i32_const(g_content, heap_start)\n    emit_end(g_content)\n    let mut ggi = 0\n    while ggi < Array::length(gc_global_names_l) {\n      bytebuf_push(g_content, 126)\n      bytebuf_push(g_content, 1)\n      emit_i64_const(g_content, 0)\n      emit_end(g_content)\n      ggi = ggi + 1\n    }\n    bytebuf_push_section(out, 6, g_content)\n  }\n  let start_func_idx = func_offset + num_user_funcs\n  let export_content = bytebuf_new()\n  let export_entry_too = entry_name != \"_start\"\n  bytebuf_push_vec_header(export_content, if export_entry_too {\n    4\n  } else {\n    3\n  })\n  emit_name(export_content, \"_start\")\n  bytebuf_push(export_content, 0)\n  leb128_encode_u32(export_content, start_func_idx)\n  if export_entry_too {\n    emit_name(export_content, entry_name)\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, entry_func_idx)\n  } else {\n    ()\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"__heap_ptr\")\n  bytebuf_push(export_content, 3)\n  leb128_encode_u32(export_content, 0)\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let slot_used_flags = array_empty()\n    let mut sfi = 0\n    while sfi < total_table_entries {\n      Array::push(slot_used_flags, false)\n      sfi = sfi + 1\n    }\n    let mut tsu = 0\n    while tsu < Array::length(table_slots_used) {\n      let ts = Array::get(table_slots_used, tsu)\n      if ts >= 0 && ts < total_table_entries {\n        Array::set(slot_used_flags, ts, true)\n      } else {\n        ()\n      }\n      tsu = tsu + 1\n    }\n    let table_slots = array_empty()\n    let table_func_indices = array_empty()\n    let mut tei = 0\n    while tei < total_table_entries {\n      if Array::get(slot_used_flags, tei) {\n        Array::push(table_slots, tei)\n        Array::push(table_func_indices, if tei < num_user_funcs {\n          func_offset + tei\n        } else {\n          start_func_idx + 1 + (tei - num_user_funcs)\n        })\n      } else {\n        ()\n      }\n      tei = tei + 1\n    }\n    if Array::length(table_slots) > 0 {\n      emit_element_section_active_runs(out, table_slots, table_func_indices)\n    } else {\n      ()\n    }\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\n    let num_ref_locals = Array::length(ref_indices)\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      }\n    } else {\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        let _ = is_ref\n        bytebuf_push(func_buf, 126)\n        rli = rli + 1\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = array_empty()\n    let data_bufs = fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n")
}

let source_147 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_expr.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  is_exception_throw_handler_name,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  agg_info_of_ident,\n  agg_log_reset_above,\n  agg_ret_lookup,\n  agg_slot_lookup,\n  ctor_table_index_of,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  find_func_stmt,\n  find_local_slot,\n  gc_slot_log_reset_above,\n  resolve_func,\n  resolve_local,\n  struct_field_candidates,\n  struct_field_dispatch_cases,\n  struct_index_by_field_set,\n  struct_tag_by_index\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_int, array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_struct_get,\n  emit_struct_new,\n  emit_struct_set,\n  emit_struct_type_raw,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn gc_expr_is_intish(e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EBinOp(op, _, _) => op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" || op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\nfn gc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_float_locals, slot)\n    },\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(l, local_names, ctx) || gc_expr_is_floatish(r, local_names, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && gc_expr_is_floatish(x, local_names, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn gc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EBool(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_bool_locals, slot)\n    },\n    EBinOp(op, _, _) => op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\nfn gc_is_ctor_expr(e: Expr, ctx: CompileCtxGc) -> Bool {\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(cname, _) => ctor_table_index_of(ctx.gc_ctor_table, cname) >= 0,\n      _ => false\n    },\n    EIdent(iname, _) => ctor_table_index_of(ctx.gc_ctor_table, iname) >= 0,\n    _ => false\n  }\n}\n\nfn emit_gc_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\nfn emit_gc_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gcceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gcceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__gcceq_res\")\n    Array::push(local_names, \"__gcceq_cnt\")\n    Array::push(local_names, \"__gcceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\nfn emit_gc_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let lhs_is_tuple = match lhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let rhs_is_tuple = match rhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let lhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, rhs, local_names)\n  if lhs_is_tuple || rhs_is_tuple {\n    let num = match lhs {\n      ETuple(les) => Array::length(les),\n      _ => match rhs {\n        ETuple(res) => Array::length(res),\n        _ => 0\n      }\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    let tn = if lhs_agg / 64 == 1 {\n      lhs_agg % 64\n    } else {\n      rhs_agg % 64\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, cefn)\n  } else if gc_is_ctor_expr(lhs, ctx) || gc_is_ctor_expr(rhs, ctx) {\n    let clit = if gc_is_ctor_expr(lhs, ctx) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = match clit {\n      ECall(_, cargs, _) => Array::length(cargs),\n      _ => 0\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    let lfc = if lhs_agg / 64 == 2 {\n      lhs_agg % 64\n    } else {\n      0\n    }\n    let rfc = if rhs_agg / 64 == 2 {\n      rhs_agg % 64\n    } else {\n      0\n    }\n    let cfc = if lfc > rfc {\n      lfc\n    } else {\n      rfc\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if gc_expr_is_intish(lhs) || gc_expr_is_intish(rhs) {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nfn compile_expr_gc(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with { Error } {\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name, _) => {\n      let len = Array::length(local_names)\n      let rec try_local: (Int) -> Int = (i) -> {\n        if i < 0 {\n          -1\n        }\n        else if Array::get(local_names, i) == name {\n          i\n        }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          emit_local_get(buf, local_idx)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = ctor_table_index_of(ctx.gc_ctor_table, name)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.gc_ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_heap_memory_grow_check(buf)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          let mut const_i = -1\n          let mut __gc = 0\n          while __gc < Array::length(ctx.gc_const_names) {\n            if Array::get(ctx.gc_const_names, __gc) == name {\n              const_i = __gc\n              __gc = Array::length(ctx.gc_const_names)\n            } else {\n              __gc = __gc + 1\n            }\n          }\n          if const_i >= 0 {\n            if Array::get(ctx.gc_const_kinds, const_i) == 1 {\n              let cs = Array::get(ctx.gc_const_svals, const_i)\n              let csi = str_table_lookup(ctx.str_table.strs, cs)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, csi), Array::get(ctx.str_table.lengths, csi))\n            } else {\n              emit_i64_const(buf, Array::get(ctx.gc_const_ivals, const_i))\n            }\n            return next_local\n          }\n          let mut glob_i = -1\n          let mut __gg = 0\n          while __gg < Array::length(ctx.gc_global_names) {\n            if Array::get(ctx.gc_global_names, __gg) == name {\n              glob_i = __gg\n              __gg = Array::length(ctx.gc_global_names)\n            } else {\n              __gg = __gg + 1\n            }\n          }\n          if glob_i >= 0 {\n            emit_global_get(buf, 1 + glob_i)\n            return next_local\n          }\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut fni = -1\n          let mut __fj = 0\n          while __fj < fn_len {\n            if Array::get(ctx.func_table.names, __fj) == name {\n              fni = __fj\n              __fj = fn_len\n            } else {\n              __fj = __fj + 1\n            }\n          }\n          if fni < 0 {\n            throw(String::concat(\"undefined variable: \", name))\n          }\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          let table_slot = fidx - ctx.func_offset\n          Array::push(ctx.table_slots_used, table_slot)\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => if op == \"&&\" || op == \"||\" {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_else(buf)\n        emit_i64_const(buf, 1)\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" {\n      emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n    } else if op == \"!=\" {\n      let nle = emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nle\n    } else if (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" {\n        emit_f64_add(buf)\n      } else if op == \"-\" {\n        emit_f64_sub(buf)\n      } else if op == \"*\" {\n        emit_f64_mul(buf)\n      } else {\n        emit_f64_div(buf)\n      }\n      emit_i64_reinterpret_f64(buf)\n      nl2\n    } else if (op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"<\" {\n        emit_f64_lt(buf)\n      } else if op == \">\" {\n        emit_f64_gt(buf)\n      } else if op == \"<=\" {\n        emit_f64_le(buf)\n      } else {\n        emit_f64_ge(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      nl2\n    } else {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => if op == \"-\" && gc_expr_is_floatish(operand, local_names, ctx) {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_neg(buf)\n      emit_i64_reinterpret_f64(buf)\n      nl\n    } else if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n    ,\n    EIf(cond, then_e, else_e) => {\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if cop == \"==\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          cnl\n        } else if cop == \"!=\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i64_eqz(buf)\n          cnl\n        } else if (cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\") && (gc_expr_is_floatish(clhs, local_names, ctx) || gc_expr_is_floatish(crhs, local_names, ctx)) {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else if cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val {\n            1\n          } else {\n            0\n          })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 {\n        ld + 1\n      } else {\n        -1\n      }\n      let names_len_before = Array::length(local_names)\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)\n      let max_nl = if nl_then > nl_else {\n        nl_then\n      } else {\n        nl_else\n      }\n      while Array::length(local_names) < max_nl {\n        Array::push(local_names, \"\")\n      }\n      max_nl\n    },\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body, _) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if gc_expr_is_floatish(value, local_names, ctx) {\n        Array::push(ctx.gc_float_locals, local_idx)\n      } else if gc_expr_is_boolish(value, local_names, ctx) {\n        Array::push(ctx.gc_bool_locals, local_idx)\n      } else {\n        ()\n      }\n      let agg_entry = match value {\n        ETuple(tels) => 64 + Array::length(tels),\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\n        _ => if gc_is_ctor_expr(value, ctx) {\n          match value {\n            ECall(_, cargs, _) => {\n              let fcnt = if Array::length(cargs) == 1 {\n                match Array::get(cargs, 0) {\n                  ERecord(_, crf, _) => Array::length(crf),\n                  _ => Array::length(cargs)\n                }\n              } else {\n                Array::length(cargs)\n              }\n              128 + fcnt\n            },\n            _ => 128\n          }\n        } else {\n          match value {\n            EIdent(src_nm, _) => {\n              let src_slot = find_local_slot(local_names, src_nm)\n              if src_slot >= 0 {\n                let src_info = agg_slot_lookup(ctx.gc_agg_local_slots, src_slot)\n                if src_info > 0 {\n                  src_info\n                } else {\n                  0\n                }\n              } else {\n                0\n              }\n            },\n            ECall(vcal, _, _) => match vcal {\n              EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n                let rinfo = agg_ret_lookup(ctx.gc_agg_ret_names, ctx.gc_agg_ret_infos, cfn)\n                if rinfo > 0 {\n                  rinfo\n                } else {\n                  0\n                }\n              } else {\n                0\n         