let source_123 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/builtin_bodies/index.vpkg",
"name = @vibe/compiler/codegen/builtin_bodies\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/builtin_bodies — WASM bytecode bodies for the\ndeps = {\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/builtin_bodies — WASM bytecode bodies for the\n// linear-backend builtin functions (array/bytes/string/rc primitives, plus\n// their `static_*` no-table variants and the wasi `gen_sources_*` embedders)\n// (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into the\n// compiler itself via compiler_sources_manifest.tsv (group `codegen`,\n// dual-row: this contract + builtin_bodies.vibe).\n//\n// The old index.vibe was not the whole implementation: it re-exports all 77\n// functions from the sibling bodies_impl.vibe (`export ./bodies_impl.vibe {\n// .. }`), which itself is a re-export-only chain down through\n// bodies_core_a.vibe/bodies_core_b.vibe -> bodies_core_a1.vibe/a2.vibe ->\n// bodies_core_a1a.vibe -> bodies_core_a1a1.vibe -> bodies_core_a1a1_eq.vibe/\n// bodies_core_a1a1_str_eq.vibe (plus bodies_core_a1b.vibe) to where the\n// functions are actually defined. All 77 leaf signatures are declared here;\n// no external file imports any of the bodies_core_*.vibe/bodies_impl.vibe\n// siblings directly (verified repo-wide — only the directory form `import\n// ../builtin_bodies { .. }` is used), so this directory has no boundary\n// spillover the way entry/source_compile and entry/compiler/fs_compile do.\n// No exported types (all signatures are Bool/Int/Bytes/Array).\n\nfn gen_eq_body(str_eq_idx: Int) -> Bytes\nfn gen_str_eq_body() -> Bytes\nfn gen_str_lex_diff_body(enable_rc: Bool) -> Bytes\nfn gen_arr_get_body(enable_rc: Bool) -> Bytes\nfn gen_arr_len_body(enable_rc: Bool) -> Bytes\nfn gen_arr_new_body(enable_rc: Bool, rc_alloc_idx: Int) -> Bytes\nfn gen_arr_set_body(enable_rc: Bool) -> Bytes\nfn gen_rc_drop_body(self_idx: Int, rc_shadow: Bool, bins_base: Int) -> Bytes\nfn gen_rc_alloc_body(rc_shadow: Bool, bins_base: Int) -> Bytes\nfn gen_str_len_body(enable_rc: Bool) -> Bytes\nfn gen_arr_push_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes\nfn gen_bytes_new_body() -> Bytes\nfn gen_bytes_len_body(enable_rc: Bool) -> Bytes\nfn gen_simd_skip_ws_body(enable_rc: Bool) -> Bytes\nfn gen_simd_scan_alnum_body(enable_rc: Bool, is_string: Bool) -> Bytes\nfn gen_bytes_get_body(enable_rc: Bool) -> Bytes\nfn gen_bytes_set_body(enable_rc: Bool) -> Bytes\nfn gen_bytes_push_body(enable_rc: Bool) -> Bytes\nfn gen_bytes_append_body(enable_rc: Bool, bytes_len_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes\nfn gen_bytes_concat_body(bytes_new_idx: Int, bytes_append_idx: Int) -> Bytes\nfn gen_bytes_slice_body(enable_rc: Bool, bytes_new_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes\nfn gen_bytes_from_array_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, bytes_new_idx: Int, bytes_push_idx: Int) -> Bytes\nfn gen_bytes_to_array_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, bytes_len_idx: Int, bytes_get_idx: Int) -> Bytes\nfn gen_bytes_blit_body(enable_rc: Bool, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes\nfn gen_bytes_fill_body(enable_rc: Bool, bytes_push_idx: Int) -> Bytes\nfn gen_arr_push_all_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes\nfn gen_identity_body() -> Bytes\nfn gen_arr_slice_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes\nfn gen_print_i64_body() -> Bytes\nfn gen_print_str_body() -> Bytes\nfn gen_arr_concat_body() -> Bytes\nfn gen_str_concat_body() -> Bytes\nfn gen_string_join_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, str_concat_idx: Int) -> Bytes\nfn gen_arr_truncate_body(enable_rc: Bool) -> Bytes\nfn gen_double_to_int_body() -> Bytes\nfn gen_int_to_double_body() -> Bytes\nfn gen_str_substring_body(enable_rc: Bool) -> Bytes\nfn gen_str_char_code_at_body(enable_rc: Bool) -> Bytes\nfn gen_string_ends_with_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes\nfn gen_fs_read_file_stub_body() -> Bytes\nfn gen_fs_exists_stub_body() -> Bytes\nfn gen_fs_stat_token_stub_body() -> Bytes\nfn gen_str_from_char_code_body(enable_rc: Bool) -> Bytes\nfn gen_fs_write_bytes_stub_body() -> Bytes\nfn gen_string_last_index_of_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes\nfn gen_sources_stub_body(arr_new_idx: Int) -> Bytes\nfn static_eq_body() -> Bytes\nfn static_str_eq_body() -> Bytes\nfn static_arr_get_body() -> Bytes\nfn static_arr_len_body() -> Bytes\nfn static_arr_new_body() -> Bytes\nfn static_arr_set_body() -> Bytes\nfn static_str_len_body() -> Bytes\nfn static_arr_push_body() -> Bytes\nfn static_arr_push_all_body() -> Bytes\nfn static_identity_body() -> Bytes\nfn static_arr_slice_body() -> Bytes\nfn static_print_i64_body() -> Bytes\nfn static_print_str_body() -> Bytes\nfn static_arr_concat_body() -> Bytes\nfn static_str_concat_body() -> Bytes\nfn static_arr_truncate_body() -> Bytes\nfn static_double_to_int_body() -> Bytes\nfn static_int_to_double_body() -> Bytes\nfn static_str_substring_body() -> Bytes\nfn static_str_char_code_at_body() -> Bytes\nfn static_fs_stub_body() -> Bytes\nfn static_str_from_char_code_body() -> Bytes\nfn static_fs_write_bytes_stub_body() -> Bytes\nfn gen_string_index_of_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes\nfn gen_string_contains_body(enable_rc: Bool, string_index_of_idx: Int) -> Bytes\nfn gen_string_starts_with_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes\nfn gen_string_split_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Bytes\nfn gen_string_trim_body(enable_rc: Bool, str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes\nfn gen_sources_proper_body(num_sources: Int, str_offsets: Array[Int], str_lengths: Array[Int], src_str_base: Int, arr_new_idx: Int, arr_push_idx: Int) -> Bytes\nfn gen_generic_rel_diff_body(enable_rc: Bool, str_lex_diff_idx: Int) -> Bytes\nfn gen_generic_add_body(str_concat_idx: Int) -> Bytes\nfn gen_map_hash_body() -> Bytes\nfn gen_map_cap_body() -> Bytes\nfn gen_map_index_insert_body() -> Bytes\nfn gen_map_build_index_body(hash_fn_idx: Int, cap_fn_idx: Int, insert_fn_idx: Int, heap_grow_check_idx: Int) -> Bytes\nfn gen_map_probe_index_body(hash_fn_idx: Int, eq_fn_idx: Int) -> Bytes\n")
