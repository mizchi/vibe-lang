0\", c1(\"Double::to_int\", EBinOp(\"+\", EBinOp(\"*\", frac, EFloat(1000000000000000.0)), EFloat(0.5))), ELet(\"__dts_ip2\", EIf(EBinOp(\">=\", s0, scale_int), EBinOp(\"+\", ip, EInt(1)), ip), ELet(\"__dts_sc\", EIf(EBinOp(\">=\", s0, scale_int), EInt(0), s0), ELet(\"__dts_istr\", c1(\"__to_string\", ip2), ELet(\"__dts_signed\", signed_val, EIf(EBinOp(\"==\", sc, EInt(0)), signed, frac_tail), -1), -1), -1), -1), -1), -1), -1)\n  let big_case = ELet(\"__dts_big\", c1(\"__to_string\", c1(\"Double::to_int\", a)), EIf(neg, c2(\"String::concat\", ch_minus, big), big), -1)\n  ELet(\"__dts_n\", arg, ELet(\"__dts_neg\", EBinOp(\"<\", n, EFloat(0.0)), ELet(\"__dts_a\", EIf(neg, EBinOp(\"-\", EFloat(0.0), n), n), EIf(EBinOp(\">=\", a, EFloat(900000000000000.0)), big_case, small), -1), -1), -1)\n}\n")
