let source_36 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins.vibe",
"\nimport @vibe/compiler/codegen {\n  canonical_builtin_name, lookup_registry_builtin\n}\n\nimport @vibe/compiler/core {\n  Type\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport fn lookup_builtin(name: String) -> Option[Type] {\n  let normalized = canonical_builtin_name(name)\n  match lookup_registry_builtin(normalized) {\n    Some(t) => Some(t),\n    None => match lookup_array(normalized) {\n      Some(t) => Some(t),\n      None => match lookup_fixed_array(normalized) {\n        Some(t) => Some(t),\n        None => match lookup_frozen_array(normalized) {\n          Some(t) => Some(t),\n          None => match lookup_array_builder(normalized) {\n            Some(t) => Some(t),\n            None => match lookup_string1(normalized) {\n              Some(t) => Some(t),\n              None => match lookup_string2(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_string_builder(normalized) {\n                  Some(t) => Some(t),\n                  None => match lookup_bytes(normalized) {\n                    Some(t) => Some(t),\n                    None => match lookup_simd(normalized) {\n                      Some(t) => Some(t),\n                      None => match lookup_map(normalized) {\n                        Some(t) => Some(t),\n                        None => match lookup_io(normalized) {\n                          Some(t) => Some(t),\n                          None => match lookup_fs(normalized) {\n                            Some(t) => Some(t),\n                            None => match lookup_net(normalized) {\n                              Some(t) => Some(t),\n                              None => match lookup_misc(normalized) {\n                                Some(t) => Some(t),\n                                None => lookup_async(normalized)\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")
}

let source_37 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_fs.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn fs_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn fs_one_param(a: Type) -> Array[Type] {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nexport fn lookup_fs(name: String) -> Option[Type] {\n  if name == \"Fs::readdir\" {\n    Some(CtFn(fs_one_param(CtString), CtArray(CtString), Some(\"Fs\")))\n  }\n  else None\n}\n")
}

let source_38 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_system.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn system_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn lookup_io_a(name: String) -> Option[Type] {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Process\")))\n  } else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), Some(\"Process\")))\n  } else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, None))\n  } else if name == \"Path::ref\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, None))\n  } else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, None))\n  } else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Stdin::read_char\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Stdin\")))\n  } else if name == \"Stdin::read_stream\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Stdin\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_b(name: String) -> Option[Type] {\n  if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Env::args_len\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Env\")))\n  } else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Profiler::now_us\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Profiler\")))\n  } else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"sleep_blocking\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, None))\n  } else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_c(name: String) -> Option[Type] {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_io(name: String) -> Option[Type] {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
}

let source_39 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_map.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn map_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn map_one_param(a: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn map_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_map_get(name: String) -> Option[Type] {\n  if name == \"Map::get\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_has(name: String) -> Option[Type] {\n  if name == \"map_has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_set(name: String) -> Option[Type] {\n  if name == \"Map::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_keys(name: String) -> Option[Type] {\n  if name == \"Map::keys\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))\n  }\n  else None\n}\n\nfn lookup_map_has_key(name: String) -> Option[Type] {\n  if name == \"Map::has_key\" || name == \"Map::has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_size(name: String) -> Option[Type] {\n  if name == \"Map::size\" {\n    Some(CtFn(map_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_map_values(name: String) -> Option[Type] {\n  if name == \"Map::values\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_map_delete(name: String) -> Option[Type] {\n  if name == \"Map::delete\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_group_c(name: String) -> Option[Type] {\n  match lookup_map_size(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_values(name) {\n      Some(t) => Some(t),\n      None => lookup_map_delete(name)\n    }\n  }\n}\n\nfn lookup_map_group_b(name: String) -> Option[Type] {\n  match lookup_map_has(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_keys(name) {\n      Some(t) => Some(t),\n      None => match lookup_map_has_key(name) {\n        Some(t) => Some(t),\n        None => match lookup_map_set(name) {\n          Some(t) => Some(t),\n          None => lookup_map_group_c(name)\n        }\n      }\n    }\n  }\n}\n\nfn lookup_mapbuilder_new(name: String) -> Option[Type] {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(map_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_set(name: String) -> Option[Type] {\n  if name == \"MapBuilder::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_freeze(name: String) -> Option[Type] {\n  if name == \"MapBuilder::freeze\" {\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_group_a(name: String) -> Option[Type] {\n  match lookup_mapbuilder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_mapbuilder_set(name) {\n      Some(t) => Some(t),\n      None => match lookup_mapbuilder_freeze(name) {\n        Some(t) => Some(t),\n        None => lookup_map_get(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_map(name: String) -> Option[Type] {\n  match lookup_map_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_map_group_b(name)\n  }\n}\n")
}

let source_40 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_net.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn net_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn net_one_param(a: Type) -> Array[Type] {\n  let arr = net_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn net_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = net_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn net_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = net_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_http_close(name: String) -> Option[Type] {\n  if name == \"Http::close\" {\n    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_accept(name: String) -> Option[Type] {\n  if name == \"Http::accept\" {\n    Some(CtFn(net_one_param(CtUnknown), CtUnknown, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_listen(name: String) -> Option[Type] {\n  if name == \"Http::listen\" {\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_request(name: String) -> Option[Type] {\n  if name == \"Http::request\" {\n    Some(CtFn(net_two_params(CtString, CtString), CtUnknown, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_respond(name: String) -> Option[Type] {\n  if name == \"Http::respond\" {\n    Some(CtFn(net_three_params(CtUnknown, CtInt, CtString), CtUnit, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_response_body(name: String) -> Option[Type] {\n  if name == \"Http::response_body\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_request_header(name: String) -> Option[Type] {\n  if name == \"Http::request_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_net_group_d(name: String) -> Option[Type] {\n  match lookup_http_request_header(name) {\n    Some(t) => Some(t),\n    None => lookup_http_respond(name)\n  }\n}\n\nfn lookup_http_request_method(name: String) -> Option[Type] {\n  if name == \"Http::request_method\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_net_group_c(name: String) -> Option[Type] {\n  match lookup_http_close(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_listen(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_accept(name) {\n        Some(t) => Some(t),\n        None => lookup_http_request_method(name)\n      }\n    }\n  }\n}\n\nfn lookup_http_response_header(name: String) -> Option[Type] {\n  if name == \"Http::response_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_http_response_status(name: String) -> Option[Type] {\n  if name == \"Http::response_status\" {\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\"Http\")))\n  }\n  else None\n}\n\nfn lookup_net_group_b(name: String) -> Option[Type] {\n  match lookup_http_request(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_response_status(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_response_header(name) {\n        Some(t) => Some(t),\n        None => lookup_http_response_body(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_net(name: String) -> Option[Type] {\n  match lookup_net_group_b(name) {\n    Some(t) => Some(t),\n    None => match lookup_net_group_c(name) {\n      Some(t) => Some(t),\n      None => lookup_net_group_d(name)\n    }\n  }\n}\n")
}

let source_41 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_misc.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn misc_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn misc_one_param(a: Type) -> Array[Type] {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn lookup_not(name: String) -> Option[Type] {\n  if name == \"not\" {\n    Some(CtFn(misc_one_param(CtBool), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_neg(name: String) -> Option[Type] {\n  if name == \"__neg\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nfn misc_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn lookup_eq(name: String) -> Option[Type] {\n  if name == \"eq\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_arithmetic_helper(name: String) -> Option[Type] {\n  if name == \"add\" || name == \"sub\" || name == \"mul\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtInt, None))\n  } else if name == \"lt\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_none(name: String) -> Option[Type] {\n  if name == \"None\" {\n    Some(CtOption(CtUnknown))\n  }\n  else None\n}\n\nfn lookup_some(name: String) -> Option[Type] {\n  if name == \"Some\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_index(name: String) -> Option[Type] {\n  if name == \"__index\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtUnknown, None))\n  }\n  else if name == \"__set_field\" {\n    let set_field_params = misc_no_params()\n    Array::push(set_field_params, CtUnknown)\n    Array::push(set_field_params, CtString)\n    Array::push(set_field_params, CtUnknown)\n    Some(CtFn(set_field_params, CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_print(name: String) -> Option[Type] {\n  if name == \"print\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_throw(name: String) -> Option[Type] {\n  if name == \"throw\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, Some(\"Error\")))\n  }\n  else None\n}\n\nfn misc_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_slice(name: String) -> Option[Type] {\n  if name == \"__slice\" {\n    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_assert(name: String) -> Option[Type] {\n  if name == \"assert\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_true\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_eq\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_println(name: String) -> Option[Type] {\n  if name == \"println\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_to_string(name: String) -> Option[Type] {\n  if name == \"__to_string\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nfn lookup_exn_kind(name: String) -> Option[Type] {\n  if name == \"__exn_kind\" || name == \"__exn_message\" {\n    Some(CtFn(misc_no_params(), CtString, None))\n  }\n  else None\n}\n\nfn lookup_len(name: String) -> Option[Type] {\n  if name == \"__len\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_iter_intrinsic(name: String) -> Option[Type] {\n  if name == \"iter_require\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\n  } else if name == \"iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else if name == \"String::iter_length\" {\n    Some(CtFn(misc_one_param(CtString), CtInt, None))\n  } else if name == \"String::iter_get\" {\n    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))\n  } else if name == \"Map::iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"Map::iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_char_to_int(name: String) -> Option[Type] {\n  if name == \"Char::to_int\" {\n    Some(CtFn(misc_one_param(CtChar), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_misc_group_a(name: String) -> Option[Type] {\n  match lookup_arithmetic_helper(name) {\n    Some(t) => Some(t),\n    None => match lookup_eq(name) {\n      Some(t) => Some(t),\n      None => match lookup_not(name) {\n        Some(t) => Some(t),\n        None => match lookup_neg(name) {\n          Some(t) => Some(t),\n          None => match lookup_to_string(name) {\n            Some(t) => Some(t),\n            None => match lookup_exn_kind(name) {\n              Some(t) => Some(t),\n              None => match lookup_len(name) {\n                Some(t) => Some(t),\n                None => lookup_index(name)\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nfn lookup_misc_group_b(name: String) -> Option[Type] {\n  match lookup_slice(name) {\n    Some(t) => Some(t),\n    None => match lookup_print(name) {\n      Some(t) => Some(t),\n      None => match lookup_println(name) {\n        Some(t) => Some(t),\n        None => lookup_assert(name)\n      }\n    }\n  }\n}\n\nfn lookup_misc_group_e(name: String) -> Option[Type] {\n  if name == \"String::join\" {\n    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))\n  } else if name == \"__rec_field\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    match lookup_iter_intrinsic(name) {\n      Some(t) => Some(t),\n      None => lookup_none(name)\n    }\n  }\n}\n\nfn lookup_char_from_int(name: String) -> Option[Type] {\n  if name == \"Char::from_int\" {\n    Some(CtFn(misc_one_param(CtInt), CtChar, None))\n  }\n  else None\n}\n\nfn lookup_double_to_int(name: String) -> Option[Type] {\n  if name == \"Double::to_int\" || name == \"Float::to_int\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_int_to_double(name: String) -> Option[Type] {\n  if name == \"Int::to_double\" || name == \"Int::to_float\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else if name == \"Int::to_string\" {\n    Some(CtFn(misc_one_param(CtInt), CtString, None))\n  }\n  else None\n}\n\nfn lookup_double_to_i64_bits(name: String) -> Option[Type] {\n  if name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_misc_group_c(name: String) -> Option[Type] {\n  match lookup_throw(name) {\n    Some(t) => Some(t),\n    None => match lookup_int_to_double(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_to_int(name) {\n        Some(t) => Some(t),\n        None => lookup_double_to_i64_bits(name)\n      }\n    }\n  }\n}\n\nfn lookup_double_from_i64_bits(name: String) -> Option[Type] {\n  if name == \"Double::from_i64_bits\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nfn lookup_misc_group_d(name: String) -> Option[Type] {\n  match lookup_double_from_i64_bits(name) {\n    Some(t) => Some(t),\n    None => match lookup_char_to_int(name) {\n      Some(t) => Some(t),\n      None => match lookup_char_from_int(name) {\n        Some(t) => Some(t),\n        None => lookup_some(name)\n      }\n    }\n  }\n}\n\nfn lookup_double_to_string(name: String) -> Option[Type] {\n  if name == \"Double::to_string\" || name == \"Float::to_string\" {\n    Some(CtFn(misc_one_param(CtDouble), CtString, None))\n  }\n  else None\n}\n\nfn lookup_double_unary_op(name: String) -> Option[Type] {\n  if name == \"Double::abs\" || name == \"Double::floor\" || name == \"Double::ceil\" {\n    Some(CtFn(misc_one_param(CtDouble), CtDouble, None))\n  }\n  else None\n}\n\nfn lookup_double_binary_op(name: String) -> Option[Type] {\n  if name == \"Double::max\" || name == \"Double::min\" {\n    Some(CtFn(misc_two_params(CtDouble, CtDouble), CtDouble, None))\n  }\n  else None\n}\n\nfn lookup_int_parse(name: String) -> Option[Type] {\n  if name == \"Int::parse\" {\n    Some(CtFn(misc_one_param(CtString), CtOption(CtInt), None))\n  }\n  else if name == \"Double::parse\" {\n    Some(CtFn(misc_one_param(CtString), CtOption(CtDouble), None))\n  }\n  else None\n}\n\nfn lookup_misc_group_f(name: String) -> Option[Type] {\n  match lookup_double_to_string(name) {\n    Some(t) => Some(t),\n    None => match lookup_double_unary_op(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_binary_op(name) {\n        Some(t) => Some(t),\n        None => lookup_int_parse(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_misc(name: String) -> Option[Type] {\n  match lookup_misc_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_misc_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_misc_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_misc_group_d(name) {\n          Some(t) => Some(t),\n          None => match lookup_misc_group_e(name) {\n            Some(t) => Some(t),\n            None => lookup_misc_group_f(name)\n          }\n        }\n      }\n    }\n  }\n}\n")
}

