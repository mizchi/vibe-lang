"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn array_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn array_one_param(a: Type) -> Array[Type] {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn array_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_array_get(name: String) -> Option[Type] {\n  if name == \"Array::get\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_array_new(name: String) -> Option[Type] {\n  if name == \"array_new\" {\n    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_set(name: String) -> Option[Type] {\n  if name == \"Array::set\" {\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_push(name: String) -> Option[Type] {\n  if name == \"Array::push\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_slice(name: String) -> Option[Type] {\n  if name == \"Array::slice\" {\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_concat(name: String) -> Option[Type] {\n  if name == \"Array::concat\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_map(name: String) -> Option[Type] {\n  if name == \"Array::map\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_fold(name: String) -> Option[Type] {\n  if name == \"Array::fold\" {\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtUnknown, CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_array_filter(name: String) -> Option[Type] {\n  if name == \"Array::filter\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_foreach(name: String) -> Option[Type] {\n  if name == \"Array::foreach\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnit, None)), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_reverse(name: String) -> Option[Type] {\n  if name == \"Array::reverse\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_any(name: String) -> Option[Type] {\n  if name == \"Array::any\" || name == \"Array::all\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_array_find(name: String) -> Option[Type] {\n  if name == \"Array::find\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtOption(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_sort(name: String) -> Option[Type] {\n  if name == \"Array::sort\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_array_contains(name: String) -> Option[Type] {\n  if name == \"Array::contains\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_array_join(name: String) -> Option[Type] {\n  if name == \"Array::join\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtString), CtString, None))\n  }\n  else None\n}\n\nfn lookup_array_length(name: String) -> Option[Type] {\n  if name == \"Array::length\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_array_group_a(name: String) -> Option[Type] {\n  match lookup_array_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_get(name) {\n        Some(t) => Some(t),\n        None => lookup_array_set(name)\n      }\n    }\n  }\n}\n\nfn lookup_array_push_all(name: String) -> Option[Type] {\n  if name == \"Array::push_all\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_truncate(name: String) -> Option[Type] {\n  if name == \"Array::truncate\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_group_b(name: String) -> Option[Type] {\n  match lookup_array_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_slice(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_push_all(name) {\n        Some(t) => Some(t),\n        None => match lookup_array_truncate(name) {\n          Some(t) => Some(t),\n          None => match lookup_array_concat(name) {\n            Some(t) => Some(t),\n            None => match lookup_array_map(name) {\n              Some(t) => Some(t),\n              None => match lookup_array_fold(name) {\n                Some(t) => Some(t),\n                None => match lookup_array_filter(name) {\n                  Some(t) => Some(t),\n                  None => match lookup_array_foreach(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_array_reverse(name) {\n                      Some(t) => Some(t),\n                      None => match lookup_array_any(name) {\n                        Some(t) => Some(t),\n                        None => match lookup_array_find(name) {\n                          Some(t) => Some(t),\n                          None => match lookup_array_sort(name) {\n                            Some(t) => Some(t),\n                            None => match lookup_array_contains(name) {\n                              Some(t) => Some(t),\n                              None => lookup_array_join(name)\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn lookup_array(name: String) -> Option[Type] {\n  match lookup_array_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_array_group_b(name)\n  }\n}\n")
