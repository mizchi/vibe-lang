let source_245 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_rewrite_impl.vibe",
"\nimport @vibe/compiler/core {\n  Expr\n}\n\n\n\nexport fn rewrite_interp(e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body, soff) => ELet(name, rewrite_interp(val), rewrite_interp(body), soff),\n    ELetMut(name, val, body, soff) => ELetMut(name, rewrite_interp(val), rewrite_interp(body), soff),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args, off) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }, off),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n")
}

let source_246 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_compile.vibe",
"\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_coverage_impl, compile_wasi_module_impl, compile_wasi_module_rc_impl, compile_wasi_module_rc_shadow_impl\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\n\nimport @vibe/compiler/core {\n  Stmt, TypeExpr\n}\n\n\n\nfn entry_declares_async_int(stmts: Array[Stmt], entry_name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, opt_ty, _) => if name == entry_name {\n        match opt_ty {\n          Some(ty) => match ty {\n            TyFn(params, ret, opt_eff) => match opt_eff {\n              Some(eff) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n                match ret {\n                  TyName(rn) => if rn == \"Int\" {\n                    found = true\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              } else {\n                ()\n              },\n              None => ()\n            },\n            _ => ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn maybe_wrap_async_component(bytes: Bytes, wrap_async: Bool) -> Bytes with { Error } {\n  if wrap_async {\n    if comp_core_imports_host_future(bytes) || comp_core_imports_host_stream(bytes) {\n      comp_emit_component_wasm_async_hostfuture(bytes, \"run\")\n    } else {\n      comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n    }\n  } else {\n    bytes\n  }\n}\n\nexport fn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\nexport fn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\nexport fn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n\nexport fn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_shadow_impl(stmts, entry_name), wrap_async)\n}\n")
}

let source_247 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/path_utils.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn empty_stmt_array() -> Array[Stmt] {\n  array_empty()\n}\n\n\nexport {\n  empty_stmt_array\n}\n")
