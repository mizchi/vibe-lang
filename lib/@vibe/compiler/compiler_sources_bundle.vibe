"\n\n\n\n\n\n\n\nexport fn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with { Error } {\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_ref_local_indices = Array::slice([\n    0\n  ], 0, 0)\n  let num_captures = Array::length(captures)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (lfs_name, lfs_ann) = Array::get(params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_ctx.gc_float_locals, lfs_name)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\n  (lam_buf, final_lam_nl)\n}\n")
}

