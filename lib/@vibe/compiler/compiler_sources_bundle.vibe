"\n\n\n\n\n\n\n\n\n\nexport fn compile_expr_tail7(buf: Bytes, parts: Array[String], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let make_concat_expr: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, lhs)\n    Array::push(args, rhs)\n    ECall(EIdent(\"String::concat\", -1), args, -1)\n  }\n  let make_to_string_expr: (String) -> Expr = (name) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, EIdent(name, -1))\n    ECall(EIdent(\"__to_string\", -1), args, -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut si2 = 0\n  while si2 < plen {\n    let part = Array::get(parts, si2)\n    if si2 % 2 == 0 {\n      if String::length(part) > 0 {\n        if has_val {\n          result = make_concat_expr(result, EString(part))\n        } else {\n          result = EString(part)\n          has_val = true\n        }\n      }\n    } else {\n      let ep = make_to_string_expr(part)\n      if has_val {\n        result = make_concat_expr(result, ep)\n      } else {\n        result = ep\n        has_val = true\n      }\n    }\n    si2 = si2 + 1\n  }\n  compile_expr(buf, result, local_names, next_local, ctx, ld)\n}\n")
}

