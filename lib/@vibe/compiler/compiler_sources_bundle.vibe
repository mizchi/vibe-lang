let selfhost_source_127 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/eval_loader/index.vibe",
"\n\n\n\nfn resolve_interp_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n            resolved\n          ], -1))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\", -1), [\n            acc,\n            Array::get(out, j)\n          ], -1)\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }, targs),\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body, soff) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body, soff) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field, off, fdoff) => EDot(resolve_interp_expr(inner), field, off, fdoff),\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nfn resolve_interp_stmt(stmt: Stmt) -> Stmt with { Error } {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport fn contains_str(arr: Array[String], target: String) -> Bool {\n  let rec go: (Int) -> Bool = (i) -> {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if Array::get(arr, i) == target {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if p == path_key {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn load_and_parse(source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport fn collect_exports(stmts: Array[Stmt]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => Array::push(out, name),\n      SEnum(true, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (cname, _) = Array::get(variants, j)\n          Array::push(out, cname)\n          j = j + 1\n        }\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(out, Array::get(names, j))\n          j = j + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          let (name, _) = Array::get(names, j)\n          Array::push(out, name)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let selfhost_source_128 = () -> (String, String) {
  ("lib/@vibe/graph/index.vpkg",
"version 0.0.1\n\n// @vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\n// Phase 3, #897): maps module path -> source, path -> fingerprint, path ->\n// dependency list, plus an eval counter, as one fixed-bucket hash-map-backed\n// linear value (callers must thread the returned db, not reuse a stale one\n// -- see graph.vibe's header comment). `RippleDb` is declared `opaque`: no\n// consumer (in-repo, including the compiler's own runtime/index.vibe,\n// confirmed via repo-wide grep) ever constructs or pattern-matches it\n// directly, only through ripple_new/ripple_get_*/ripple_set_source/\n// ripple_record_eval. `StrMap`/`DepsMap` (graph.vibe's internal bucket-map\n// representation, used only inside RippleDb's own variant payload) are\n// likewise never referenced outside graph.vibe -- but `check_contract`\n// still requires every exported type declared regardless of external\n// usage (same rule as fns; confirmed by a real conformance-check failure\n// when they were first left undeclared), so they're declared `opaque`\n// here too. `version` was `export let\n// version = \"0.0.1\"` directly in the old index.vibe facade -- a real\n// importable binding, not just contract metadata -- so it is preserved\n// verbatim as an implementation-file value (graph.vibe) with a matching\n// bodyless declaration here (Codex review precedent, PR #914).\n\nimport ./graph.vibe {}\n\nlet version: String\n\nopaque type StrMap\nopaque type DepsMap\nopaque type RippleDb\n\nfn ripple_new() -> RippleDb\nfn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb\nfn ripple_get_source(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]]\nfn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb\nfn ripple_eval_count(db: RippleDb) -> Int\n")
}

let selfhost_source_129 = () -> (String, String) {
  ("lib/@vibe/graph/graph.vibe",
"\n\n\nexport let version: String = \"0.0.1\"\n\n\nexport enum StrMap {\n  StrMap(Array[Array[(String, String)]])\n}\n\nexport enum DepsMap {\n  DepsMap(Array[Array[(String, Array[String])]])\n}\n\nexport enum RippleDb {\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\n}\n\n\nfn nbuckets() -> Int {\n  256\n}\n\nfn bucket_mask() -> Int {\n  255\n}\n\nfn hash_bucket(key: String) -> Int {\n  let len = String::length(key)\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let c = String::char_code_at(key, i)\n      let mixed = (acc ^ c) * 16777619\n      let bounded = mixed & 1073741823\n      go(i + 1, bounded)\n    }\n  }\n  let h = go(0, 2166136261 & 1073741823)\n  h & bucket_mask()\n}\n\nfn empty_strings() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_deps_pairs() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\nfn new_string_buckets() -> Array[Array[(String, String)]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_string_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn new_deps_buckets() -> Array[Array[(String, Array[String])]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_deps_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn strmap_new() -> StrMap {\n  StrMap(new_string_buckets())\n}\n\nfn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_string(bucket, key, i + 1)\n    }\n  }\n}\n\nfn strmap_get(m: StrMap, key: String) -> Option[String] {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_string(bucket, key, 0)\n    }\n  }\n}\n\nfn strmap_set(m: StrMap, key: String, value: String) -> Unit {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, value))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, value))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nfn depsmap_new() -> DepsMap {\n  DepsMap(new_deps_buckets())\n}\n\nfn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_deps(bucket, key, i + 1)\n    }\n  }\n}\n\nfn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_deps(bucket, key, 0)\n    }\n  }\n}\n\nfn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, deps))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, deps))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nexport fn ripple_new() -> RippleDb {\n  let count = ArrayBuilder::new()\n  ArrayBuilder::push(count, 0)\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\n}\n\nexport fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\n  }\n}\n\nexport fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\n  }\n}\n\nexport fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {\n  match db {\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\n  }\n}\n\nexport fn ripple_eval_count(db: RippleDb) -> Int {\n  match db {\n    RippleDb(_, _, _, count) => Array::get(count, 0)\n  }\n}\n\nexport fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {\n  match db {\n    RippleDb(sources, _, _, _) => {\n      strmap_set(sources, path, source)\n      db\n    }\n  }\n}\n\nexport fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\n  match db {\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\n      Some(prev_fp) => if prev_fp == fingerprint {\n        db\n      } else {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      },\n      None => {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      }\n    }\n  }\n}\n")
}

let selfhost_source_130 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/typecheck_fs.vibe",
"\n\n\n\n\n\n\n\n\n\n\nfn empty_stack() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        result = Some(env)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (p, _) = Array::get(cache, i)\n    if p == path {\n      Array::set(cache, i, (path, env))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(cache, (path, env))\n  }\n  cache\n}\n\nfn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  match lookup_env_cache(env_cache, path) {\n    Some(_) => env_cache,\n    None =>\n    match ripple_get_fingerprint(rdb, path) {\n      Some(fingerprint) =>\n      match load_persistent_type_env(fingerprint) {\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\n        None => env_cache\n      },\n      None => env_cache\n    }\n  }\n}\n\nfn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  let mut cache = env_cache\n  let mut i = 0\n  while i < Array::length(paths) {\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\n    i = i + 1\n  }\n  cache\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn copy_string_array(items: Array[String]) -> Array[String] {\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(items)\n  while i < len {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        result = Some(v)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (k, _) = Array::get(pairs, i)\n    if k == key {\n      Array::set(pairs, i, (key, value))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(pairs, (key, value))\n  }\n  pairs\n}\n\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nfn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with { Fs } {\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(dep_cache_path)) {\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\n  } else {\n    ()\n  }\n}\n\nfn typecheck_ident_run(s: String, start: Int) -> Int {\n  let len = String::length(s)\n  let mut e = start\n  let mut go = true\n  while go && e < len {\n    let c = String::char_code_at(s, e)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    if is_id {\n      e = e + 1\n    } else {\n      go = false\n    }\n  }\n  e\n}\n\nfn locate_by_marker(source: String, msg: String, marker: String) -> String {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    msg\n  } else {\n    let sstart = mi + String::length(marker)\n    let send = typecheck_ident_run(msg, sstart)\n    if send <= sstart {\n      msg\n    } else {\n      let sym = String::substring(msg, sstart, send)\n      let off = String::index_of(source, sym)\n      if off < 0 {\n        msg\n      } else {\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n    }\n  }\n}\n\nfn locate_type_error_heuristic(source: String, msg: String) -> String {\n  if String::index_of(msg, \"line \") == 0 {\n    msg\n  } else {\n    let with_name = locate_by_marker(source, msg, \"unknown name: \")\n    if with_name != msg {\n      with_name\n    } else {\n      let with_arity = locate_by_marker(source, msg, \"function arity mismatch for \")\n      if with_arity != msg {\n        with_arity\n      } else {\n        let with_field = locate_by_marker(source, msg, \"unknown field \")\n        if with_field != msg {\n          with_field\n        } else {\n          locate_by_marker(source, msg, \"unknown constructor \")\n        }\n      }\n    }\n  }\n}\n\nfn offset_line_col_prefix(source: String, off: Int) -> String {\n  let (line, col) = offset_to_line_col(source, off)\n  String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n}\n\nfn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {\n  let (l1, c1) = offset_to_line_col(source, start)\n  let (l2, c2) = offset_to_line_col(source, endo)\n  if l1 == l2 && endo > start {\n    String::concat(\"line \", String::concat(__to_string(l1), String::concat(\":\", String::concat(__to_string(c1), String::concat(\"-\", String::concat(__to_string(c2), \": \"))))))\n  } else {\n    offset_line_col_prefix(source, start)\n  }\n}\n\nfn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {\n  if end <= start {\n    -1\n  } else {\n    let mut i = start\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < end {\n      let c = String::char_code_at(msg, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      -1\n    }\n  }\n}\n\nfn locate_type_error(source: String, msg: String) -> String {\n  let marker = \" [@off=\"\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    locate_type_error_heuristic(source, msg)\n  } else {\n    let inner_start = mi + String::length(marker)\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \"]\")\n    if rel_end < 0 {\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\n    } else {\n      let close = inner_start + rel_end\n      let inner = String::substring(msg, inner_start, close)\n      let colon = String::index_of(inner, \":\")\n      let n = if colon < 0 {\n        parse_offset_digits(inner, 0, String::length(inner))\n      } else {\n        parse_offset_digits(inner, 0, colon)\n      }\n      let m = if colon < 0 {\n        -1\n      } else {\n        parse_offset_digits(inner, colon + 1, String::length(inner))\n      }\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\n      let slen = String::length(source)\n      if n >= 0 && n < slen {\n        if m > n && m <= slen {\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\n        } else {\n          String::concat(offset_line_col_prefix(source, n), stripped)\n        }\n      } else {\n        locate_type_error_heuristic(source, stripped)\n      }\n    }\n  }\n}\n\nfn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\n  } else {\n    let stmts = parse_program_with_path(path, source)\n    let final_parse_count = parse_count + 1\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\n    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)\n    let checked_env = handle {\n      match import_env {\n        EnvEmpty => check_program(stmts),\n        _ => check_program_with_env(stmts, import_env)\n      }\n    } with Error {\n      Throw(msg) => throw(String::concat(String::concat(path, \": \"), locate_type_error(source, msg)))\n    }\n    store_persistent_type_env(fingerprint, checked_env)\n    if Array::length(deps) == 0 {\n      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\n    } else {\n      ()\n    }\n    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\n  }\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(stmts)\n  while i < len {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n}\n\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nfn ensure_fingerprint_fs_go(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => match lookup_string_pair(dep_source_cache, path) {\n        Some(cached_source) => if cached_source == source {\n          match ripple_get_fingerprint(rdb, path) {\n            Some(cached_fingerprint) =>\n            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\n            None => match load_persistent_leaf_fingerprint(path, source) {\n              Some(leaf_fingerprint) => {\n                write_persistent_dep_list_if_missing(path, source, empty_stack())\n                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n              },\n              None => {\n                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n                let deps = copy_string_array(deps_raw)\n                write_persistent_dep_list_if_missing(path, source, deps)\n                let dlen = Array::length(deps)\n                let saved_stack_len = Array::length(stack)\n                Array::push(stack, path)\n                let mut i = 0\n                let mut db_after_deps = rdb\n                let mut env_cache_after_deps = env_cache\n                let mut dep_source_cache_after_deps = next_dep_source_cache\n                let mut parse_count_after_deps = initial_parse_count\n                let dep_fps = empty_dep_fps()\n                while i < dlen {\n                  let dep_path = Array::get(deps, i)\n                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n                  db_after_deps = next_db\n                  env_cache_after_deps = next_env_cache\n                  dep_source_cache_after_deps = next_dep_source_cache2\n                  parse_count_after_deps = next_parse_count\n                  Array::push(dep_fps, (dep_path, dep_fp))\n                  i = i + 1\n                }\n                Array::truncate(stack, saved_stack_len)\n                let fingerprint = build_fingerprint(source, dep_fps)\n                match ripple_get_fingerprint(db_after_deps, path) {\n                  Some(cached_fp) =>\n                  if cached_fp == fingerprint {\n                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n                  } else {\n                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                  },\n                  None =>\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                }\n              }\n            }\n          }\n        } else {\n          match load_persistent_leaf_fingerprint(path, source) {\n            Some(leaf_fingerprint) => {\n              write_persistent_dep_list_if_missing(path, source, empty_stack())\n              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n            },\n            None => {\n              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n              let deps = copy_string_array(deps_raw)\n              write_persistent_dep_list_if_missing(path, source, deps)\n              let dlen = Array::length(deps)\n              let saved_stack_len = Array::length(stack)\n              Array::push(stack, path)\n              let mut i = 0\n              let mut db_after_deps = rdb\n              let mut env_cache_after_deps = env_cache\n              let mut dep_source_cache_after_deps = next_dep_source_cache\n              let mut parse_count_after_deps = initial_parse_count\n              let dep_fps = empty_dep_fps()\n              while i < dlen {\n                let dep_path = Array::get(deps, i)\n                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n                db_after_deps = next_db\n                env_cache_after_deps = next_env_cache\n                dep_source_cache_after_deps = next_dep_source_cache2\n                parse_count_after_deps = next_parse_count\n                Array::push(dep_fps, (dep_path, dep_fp))\n                i = i + 1\n              }\n              Array::truncate(stack, saved_stack_len)\n              let fingerprint = build_fingerprint(source, dep_fps)\n              match ripple_get_fingerprint(db_after_deps, path) {\n                Some(cached_fp) =>\n                if cached_fp == fingerprint {\n                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n                } else {\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                },\n                None =>\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n              }\n            }\n          }\n        },\n        None =>\n        match load_persistent_leaf_fingerprint(path, source) {\n          Some(leaf_fingerprint) => {\n            write_persistent_dep_list_if_missing(path, source, empty_stack())\n            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n          },\n          None => {\n            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n            let deps = copy_string_array(deps_raw)\n            write_persistent_dep_list_if_missing(path, source, deps)\n            let dlen = Array::length(deps)\n            let saved_stack_len = Array::length(stack)\n            Array::push(stack, path)\n            let mut i = 0\n            let mut db_after_deps = rdb\n            let mut env_cache_after_deps = env_cache\n            let mut dep_source_cache_after_deps = next_dep_source_cache\n            let mut parse_count_after_deps = initial_parse_count\n            let dep_fps = empty_dep_fps()\n            while i < dlen {\n              let dep_path = Array::get(deps, i)\n              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n              db_after_deps = next_db\n              env_cache_after_deps = next_env_cache\n              dep_source_cache_after_deps = next_dep_source_cache2\n              parse_count_after_deps = next_parse_count\n              Array::push(dep_fps, (dep_path, dep_fp))\n              i = i + 1\n            }\n            Array::truncate(stack, saved_stack_len)\n            let fingerprint = build_fingerprint(source, dep_fps)\n            match ripple_get_fingerprint(db_after_deps, path) {\n              Some(cached_fp) =>\n              if cached_fp == fingerprint {\n                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n              } else {\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n              },\n              None =>\n              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\n  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)\n  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)\n}\n\nfn dedupe_diagnostics(diags: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(diags) {\n    let d = Array::get(diags, i)\n    if contains_str(out, d) {\n      ()\n    } else {\n      Array::push(out, d)\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn collect_all_diagnostics(source: String) -> Array[String] with { Error } {\n  let (tokens, starts, _ends, lex_err_offsets, lex_err_msgs) = lex_with_offsets_recovering(source)\n  if Array::length(lex_err_msgs) > 0 {\n    let located = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut i = 0\n    while i < Array::length(lex_err_msgs) {\n      let off = Array::get(lex_err_offsets, i)\n      let (line, col) = offset_to_line_col(source, off)\n      let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n      Array::push(located, String::concat(loc, Array::get(lex_err_msgs, i)))\n      i = i + 1\n    }\n    dedupe_diagnostics(located)\n  } else {\n    let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\n    if Array::length(parse_diags) > 0 {\n      dedupe_diagnostics(parse_diags)\n    } else {\n      handle {\n        let _env = check_program(stmts)\n        Array::slice([\n          \"_\"\n        ], 0, 0)\n      } with Error {\n        Throw(msg) => [\n          locate_type_error(source, msg)\n        ]\n      }\n    }\n  }\n}\n")
}

let selfhost_source_131 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/type_at.vibe",
"\n\n\n\n\n\nfn line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      -1\n    } else {\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\nenum IdentHit {\n  IdentHit(String, Int)\n}\n\nfn empty_hits() -> Array[IdentHit] {\n  Array::slice([\n    IdentHit(\"\", -1)\n  ], 0, 0)\n}\n\nfn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => {\n      if off >= 0 {\n        Array::push(acc, IdentHit(name, off))\n      } else {\n        ()\n      }\n    },\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => collect_exprs(items, acc),\n    EArray(items) => collect_exprs(items, acc),\n    ERecord(_, fields, _) => collect_field_exprs(fields, acc),\n    EIf(c, t, e) => {\n      collect_expr(c, acc)\n      collect_expr(t, acc)\n      collect_expr(e, acc)\n    },\n    ELet(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetRec(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetMut(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssign(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssignOp(_, _, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ESeq(a, b) => {\n      collect_expr(a, acc)\n      collect_expr(b, acc)\n    },\n    EMatch(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EHandle(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EWhile(c, b) => {\n      collect_expr(c, acc)\n      collect_expr(b, acc)\n    },\n    ELoop(params, b) => {\n      collect_loop_param_exprs(params, acc)\n      collect_expr(b, acc)\n    },\n    EForIn(_, _, it, b) => {\n      collect_expr(it, acc)\n      collect_expr(b, acc)\n    },\n    ECall(callee, args, _) => {\n      collect_expr(callee, acc)\n      collect_exprs(args, acc)\n    },\n    EBinOp(_, l, r) => {\n      collect_expr(l, acc)\n      collect_expr(r, acc)\n    },\n    EUnaryOp(_, e) => collect_expr(e, acc),\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\n    EDot(e, field, _, field_off) => {\n      if field_off >= 0 {\n        Array::push(acc, IdentHit(field, field_off))\n      } else {\n        ()\n      }\n      collect_expr(e, acc)\n    },\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\n    EReturn(e) => collect_expr(e, acc),\n    EBreak(opt) => match opt {\n      Some(v) => collect_expr(v, acc),\n      None => ()\n    },\n    EContinue(args) => collect_exprs(args, acc),\n    EMap(fields) => collect_field_exprs(fields, acc),\n    ESpread(e) => collect_expr(e, acc)\n  }\n}\n\nfn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    collect_expr(Array::get(items, i), acc)\n    i = i + 1\n  }\n}\n\nfn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    collect_expr(v, acc)\n    i = i + 1\n  }\n}\n\nfn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, e) = Array::get(arms, i)\n    collect_expr(e, acc)\n    i = i + 1\n  }\n}\n\nfn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, init) = Array::get(params, i)\n    collect_expr(init, acc)\n    i = i + 1\n  }\n}\n\nfn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {\n  match stmt {\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\n    SLetMut(_, _, body) => collect_expr(body, acc),\n    STest(_, body) => collect_expr(body, acc),\n    SBench(_, body) => collect_expr(body, acc),\n    SExpr(e) => collect_expr(e, acc),\n    SLetPat(_, body) => collect_expr(body, acc),\n    SModule(_, _, body) => collect_stmts(body, acc),\n    _ => ()\n  }\n}\n\nfn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    collect_stmt(Array::get(stmts, i), acc)\n    i = i + 1\n  }\n}\n\nfn is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if end > String::length(source) { String::length(source) } else { end }\n    let mut i = if start < 0 { 0 } else { start }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\n        Array::push(acc, IdentHit(name, i))\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\n    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {\n  let mut best_name = \"\"\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_name\n}\n\nfn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_off\n}\n\nfn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(table) {\n    let (toff, tty) = Array::get(table, i)\n    if toff == off {\n      found = Some(tty)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn type_at_source(source: String, line: Int, col: Int) -> String {\n  handle {\n    let tgt = line_col_to_offset(source, line, col)\n    if tgt < 0 {\n      \"\"\n    } else {\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let stmts = parse_program_located(tokens, starts, source)\n    let hits = empty_hits()\n    collect_stmts(stmts, hits)\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\n    let name = pick_ident_at(hits, tgt)\n    if name == \"\" {\n      \"\"\n    } else {\n      let chosen_off = pick_ident_off(hits, tgt)\n      let (table, final_s) = check_program_type_table(stmts)\n      let table_hit = if chosen_off >= 0 {\n        tytab_lookup(table, chosen_off)\n      } else {\n        None\n      }\n      match table_hit {\n        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\n        None => {\n          let env = check_program(stmts)\n          match env_lookup(env, name) {\n            Some(t) => type_to_string(t),\n            None => \"\"\n          }\n        }\n      }\n    }\n    }\n  } with Error {\n    Throw(_) => \"\"\n  }\n}\n")
}

let selfhost_source_132 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/binding_at.vibe",
"\n\n\n\n\nfn bind_line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      -1\n    } else {\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\nenum BindHit {\n  BindHit(String, Int, Int)\n}\n\nfn bind_empty_hits() -> Array[BindHit] {\n  Array::slice([\n    BindHit(\"\", -1, 0)\n  ], 0, 0)\n}\n\nfn bind_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn bind_find_word(source: String, name: String, from: Int) -> Int {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    -1\n  } else {\n    let limit = String::length(source)\n    let mut i = if from < 0 { 0 } else { from }\n    let mut found = -1\n    while found < 0 && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\n        found = i\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n}\n\nstruct BindState {\n  hits: Array[BindHit];\n  scope_names: Array[String];\n  scope_ids: Array[Int];\n  floor: Array[Int];\n  source: String\n}\n\nfn bind_box_int(v: Int) -> Array[Int] {\n  let arr = Array::slice([0], 0, 0)\n  Array::push(arr, v)\n  arr\n}\n\nfn bind_new_state(source: String) -> BindState {\n  BindState::{\n    hits: bind_empty_hits(),\n    scope_names: Array::slice([\"\"], 0, 0),\n    scope_ids: Array::slice([0], 0, 0),\n    floor: bind_box_int(0),\n    source: source\n  }\n}\n\nfn bind_resolve(st: BindState, name: String) -> Int {\n  let n = Array::length(st.scope_names)\n  let mut i = n - 1\n  let mut found = 0\n  while i >= 0 && found == 0 {\n    if Array::get(st.scope_names, i) == name {\n      found = Array::get(st.scope_ids, i)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  found\n}\n\nfn bind_pop_scope(st: BindState, mark: Int) -> Unit {\n  Array::truncate(st.scope_names, mark)\n  Array::truncate(st.scope_ids, mark)\n}\n\nfn bind_recover_binder(st: BindState, name: String) -> Int {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  let id = if off >= 0 { off + 1 } else { 0 }\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, id))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n  id\n}\n\nfn bind_push_binder(st: BindState, name: String, id: Int) -> Unit {\n  Array::push(st.scope_names, name)\n  Array::push(st.scope_ids, id)\n}\n\nfn bind_introduce(st: BindState, name: String) -> Unit {\n  let id = bind_recover_binder(st, name)\n  bind_push_binder(st, name, id)\n}\n\nfn bind_record_ref(st: BindState, name: String, off: Int) -> Unit {\n  if off >= 0 {\n    let key = bind_resolve(st, name)\n    Array::push(st.hits, BindHit(name, off, key))\n    if off >= Array::get(st.floor, 0) {\n      Array::set(st.floor, 0, off + String::length(name))\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn bind_record_assign_target(st: BindState, name: String) -> Unit {\n  let key = bind_resolve(st, name)\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, key))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\nfn bind_introduce_pat(st: BindState, pat: Pat) -> Unit {\n  match pat {\n    PWild => (),\n    PBind(name) => bind_introduce(st, name),\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\n    PTuple(sub) => bind_introduce_pats(st, sub),\n    POr(a, b) => {\n      bind_introduce_pat(st, a)\n      bind_introduce_pat(st, b)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        bind_introduce_pat(st, fp)\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn bind_introduce_pats(st: BindState, sub: Array[Pat]) -> Unit {\n  let mut i = 0\n  while i < Array::length(sub) {\n    bind_introduce_pat(st, Array::get(sub, i))\n    i = i + 1\n  }\n}\n\nfn bind_walk_expr(st: BindState, expr: Expr) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => bind_record_ref(st, name, off),\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => bind_walk_exprs(st, items),\n    EArray(items) => bind_walk_exprs(st, items),\n    ERecord(_, fields, _) => bind_walk_field_exprs(st, fields),\n    EIf(c, t, e) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, t)\n      bind_walk_expr(st, e)\n    },\n    ELet(name, v, b, _) => {\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetMut(name, v, b, _) => {\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EAssign(name, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    EAssignOp(name, _, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    ESeq(a, b) => {\n      bind_walk_expr(st, a)\n      bind_walk_expr(st, b)\n    },\n    EMatch(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EHandle(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EWhile(c, b) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, b)\n    },\n    ELoop(params, b) => {\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        bind_walk_expr(st, init)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EForIn(name, idx_opt, it, b) => {\n      bind_walk_expr(st, it)\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      match idx_opt {\n        Some(idx) => bind_introduce(st, idx),\n        None => ()\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ECall(callee, args, _) => {\n      bind_walk_expr(st, callee)\n      bind_walk_exprs(st, args)\n    },\n    EBinOp(_, l, r) => {\n      bind_walk_expr(st, l)\n      bind_walk_expr(st, r)\n    },\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\n    EFn(_, _, params, _, _, body) => {\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, body)\n      bind_pop_scope(st, mark)\n    },\n    EDot(e, _, _, _) => bind_walk_expr(st, e),\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\n    EReturn(e) => bind_walk_expr(st, e),\n    EBreak(opt) => match opt {\n      Some(v) => bind_walk_expr(st, v),\n      None => ()\n    },\n    EContinue(args) => bind_walk_exprs(st, args),\n    EMap(fields) => bind_walk_field_exprs(st, fields),\n    ESpread(e) => bind_walk_expr(st, e)\n  }\n}\n\nfn bind_walk_exprs(st: BindState, items: Array[Expr]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    bind_walk_expr(st, Array::get(items, i))\n    i = i + 1\n  }\n}\n\nfn bind_walk_field_exprs(st: BindState, fields: Array[(String, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    bind_walk_expr(st, v)\n    i = i + 1\n  }\n}\n\nfn bind_walk_arms(st: BindState, arms: Array[(Pat, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, e) = Array::get(arms, i)\n    let mark = Array::length(st.scope_names)\n    bind_introduce_pat(st, pat)\n    bind_walk_expr(st, e)\n    bind_pop_scope(st, mark)\n    i = i + 1\n  }\n}\n\nfn bind_record_module_binder(st: BindState, name: String) -> Unit {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, 0))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\nfn bind_walk_stmt(st: BindState, stmt: Stmt) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    SLetMut(name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    STest(_, body) => bind_walk_expr(st, body),\n    SBench(_, body) => bind_walk_expr(st, body),\n    SExpr(e) => bind_walk_expr(st, e),\n    SLetPat(_, body) => bind_walk_expr(st, body),\n    SModule(_, _, body) => bind_walk_stmts(st, body),\n    _ => ()\n  }\n}\n\nfn bind_walk_stmts(st: BindState, stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    bind_walk_stmt(st, Array::get(stmts, i))\n    i = i + 1\n  }\n}\n\nfn bind_pick_at(hits: Array[BindHit], tgt: Int) -> (String, Int) {\n  let mut best_name = \"\"\n  let mut best_key = 0\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      BindHit(name, off, key) => {\n        let span_end = off + String::length(name)\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_key = key\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  (best_name, best_key)\n}\n\nfn bind_insert_sorted_unique(out: Array[(Int, Int)], start: Int, end: Int) -> Unit {\n  let n = Array::length(out)\n  let mut dup = false\n  let mut idx = n\n  let mut j = 0\n  while j < n {\n    let (s, _) = Array::get(out, j)\n    if s == start {\n      dup = true\n    } else {\n      ()\n    }\n    if s > start && idx == n {\n      idx = j\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  if dup {\n    ()\n  } else if idx == n {\n    Array::push(out, (start, end))\n  } else {\n    Array::push(out, Array::get(out, n - 1))\n    let mut k = n - 1\n    while k > idx {\n      Array::set(out, k, Array::get(out, k - 1))\n      k = k - 1\n    }\n    Array::set(out, idx, (start, end))\n  }\n}\n\nfn binding_occurrences_impl(source: String, line: Int, col: Int) -> Array[(Int, Int)] with { Error } {\n  {\n    let tgt = bind_line_col_to_offset(source, line, col)\n    let empty_out = Array::slice([\n      (0, 0)\n    ], 0, 0)\n    if tgt < 0 {\n      empty_out\n    } else {\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    let stmts = parse_program_located(tokens, starts, source)\n    let st = bind_new_state(source)\n    bind_walk_stmts(st, stmts)\n    let hits = st.hits\n    let (name, key) = bind_pick_at(hits, tgt)\n    let out = Array::slice([\n      (0, 0)\n    ], 0, 0)\n    if name == \"\" {\n      out\n    } else {\n      let mut i = 0\n      while i < Array::length(hits) {\n        match Array::get(hits, i) {\n          BindHit(hname, hoff, hkey) => {\n            if hname == name && hkey == key && hoff >= 0 {\n              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\n            } else {\n              ()\n            }\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n    }\n  }\n}\n\nexport fn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)] {\n  handle {\n    binding_occurrences_impl(source, line, col)\n  } with Error {\n    Throw(_) => Array::slice([\n      (0, 0)\n    ], 0, 0)\n  }\n}\n")
}

let selfhost_source_133 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/symbol_spans.vibe",
"\n\n\n\n\nfn sym_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn sym_box_int(v: Int) -> Array[Int] {\n  let arr = Array::slice([0], 0, 0)\n  Array::push(arr, v)\n  arr\n}\n\nfn sym_empty_items() -> Array[(String, Int, Int, Int)] {\n  Array::slice([\n    (\"\", 0, 0, 0)\n  ], 0, 0)\n}\n\nfn sym_emit(out: Array[(String, Int, Int, Int)], source: String, name: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if hi > String::length(source) { String::length(source) } else { hi }\n    let mut i = Array::get(floor, 0)\n    if i < 0 {\n      i = 0\n    } else {\n      ()\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\n        Array::push(out, (name, kind, i, i + nlen))\n        Array::set(floor, 0, i + nlen)\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn sym_let_kind(body: Expr) -> Int {\n  match body {\n    EFn(_, _, _, _, _, _) => 12,\n    _ => 13\n  }\n}\n\nfn sym_walk_stmt(out: Array[(String, Int, Int, Int)], source: String, stmt: Stmt, floor: Array[Int], hi: Int) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\n    SStruct(_, name, _, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\n    SModule(_, name, body) => {\n      sym_emit(out, source, name, 2, floor, hi)\n      let mut j = 0\n      while j < Array::length(body) {\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\n        j = j + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn symbol_spans_impl(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\n  {\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    let out = sym_empty_items()\n    let mut i = 0\n    while i < Array::length(span_stmts) {\n      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\n      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\n      let floor = sym_box_int(lo)\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport fn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] {\n  handle {\n    symbol_spans_impl(source)\n  } with Error {\n    Throw(_) => Array::slice([\n      (\"\", 0, 0, 0)\n    ], 0, 0)\n  }\n}\n")
}

let selfhost_source_134 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/persistent_env_codec.vibe",
"\n\n\n\nfn parse_int_unwrap(raw: String, fallback: Int) -> Int {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  let mut neg = false\n  let mut valid = true\n  if len == 0 { valid = false }\n  if valid {\n    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }\n  }\n  while valid {\n    if i >= len { break }\n    let c = String::char_code_at(raw, i)\n    if c < 48 { valid = false }\n    else if c > 57 { valid = false }\n    else {\n      result = result * 10 + (c - 48)\n      i = i + 1\n    }\n  }\n  if valid {\n    if neg { 0 - result } else result\n  } else fallback\n}\n\nfn serialize_segment(text: String) -> String {\n  let len = String::length(text)\n  let len_str = __to_string(len)\n  let colon_text = String::concat(\":\", text)\n  String::concat(len_str, colon_text)\n}\n\nfn decode_effect_name(raw: String) -> String {\n  if raw == \"\" || raw == \"0\" {\n    \"\"\n  } else if raw == \"1\" {\n    \"Error\"\n  } else {\n    raw\n  }\n}\n\nfn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {\n  let len = String::length(text)\n  let mut i = pos\n  while i < len && String::char_code_at(text, i) != terminator {\n    i = i + 1\n  }\n  if i >= len {\n    throw(\"invalid persistent type env payload\")\n  } else {\n    let parsed = parse_int_unwrap(text[pos: i], 0)\n    (parsed, i + 1)\n  }\n}\n\nfn parse_segment(text: String, pos: Int) -> (String, Int) with { Error } {\n  let (seg_len, start) = parse_count_header(text, pos, 58)\n  let end = start + seg_len\n  if end > String::length(text) {\n    throw(\"invalid persistent type env segment\")\n  } else {\n    (text[start: end], end)\n  }\n}\n\nfn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    0\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    let parsed_val = parse_int_unwrap(raw, 0)\n    Array::push(items, parsed_val)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env int array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (item, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, item)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env string array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\n    let parsed_id = parse_int_unwrap(raw_id, 0)\n    Array::push(items, (parsed_id, bounds))\n    cursor = next_cursor2\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env bounds array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_cached_type(source: String, pos: Int) -> (Type, Int) with { Error } {\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\n    let (count, start) = parse_count_header(text, pos, 91)\n    let items = Array::slice([\n      CtUnknown\n    ], 0, 0)\n    let mut i = 0\n    let mut cursor = start\n    while i < count {\n      let (raw, next_cursor) = parse_segment(text, cursor)\n      let (item, end_cursor) = parse_cached_type(raw, 0)\n      if end_cursor != String::length(raw) {\n        throw(\"invalid persistent type env nested type\")\n      } else {\n        Array::push(items, item)\n        cursor = next_cursor\n        i = i + 1\n      }\n    }\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n      throw(\"invalid persistent type env type array\")\n    } else {\n      (items, cursor + 1)\n    }\n  }\n  if pos >= String::length(source) {\n    throw(\"invalid persistent type env type\")\n  } else {\n    let tag = String::char_code_at(source, pos)\n    match tag {\n      73 => (CtInt, pos + 1),\n      68 => (CtDouble, pos + 1),\n      66 => (CtBool, pos + 1),\n      71 => (CtString, pos + 1),\n      72 => (CtChar, pos + 1),\n      85 => (CtUnit, pos + 1),\n      89 => (CtBytes, pos + 1),\n      88 => (CtUnknown, pos + 1),\n      86 => {\n        let (raw, next_pos) = parse_segment(source, pos + 1)\n        let var_id = parse_int_unwrap(raw, 0)\n        (CtVar(var_id), next_pos)\n      },\n      69 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtEnum(name), next_pos)\n      },\n      82 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtStruct(name), next_pos)\n      },\n      65 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtArray(elem), next_pos)\n      },\n      79 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtOption(elem), next_pos)\n      },\n      84 => {\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\n        (CtTuple(elems), next_pos)\n      },\n      70 => {\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\n        let eff_raw = decode_effect_name(raw_effect)\n        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }\n        (CtFn(params, ret, eff_name), next_pos3)\n      },\n      78 => {\n        let (name, next_pos1) = parse_segment(source, pos + 1)\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\n        (CtNamed(name, args), next_pos2)\n      },\n      81 => {\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtForAll(vars, bounds, body), next_pos3)\n      },\n      _ => throw(\"invalid persistent type env type tag\")\n    }\n  }\n}\n\nfn serialize_int_array(items: Array[Int]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_effect_name_str(effect_name: String) -> String {\n  effect_name\n}\n\nfn serialize_string_array(items: Array[String]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_bounds_array(items: Array[(Int, Array[String])]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    let (id, bounds) = Array::get(items, i)\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\n    StringBuilder::push(buf, serialize_string_array(bounds))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_type(ty: Type) -> String {\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\n    let buf = StringBuilder::new()\n    StringBuilder::push(buf, __to_string(Array::length(items)))\n    StringBuilder::push(buf, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\n      i = i + 1\n    }\n    StringBuilder::push(buf, \"]\")\n    StringBuilder::freeze(buf)\n  }\n  match ty {\n    CtInt => \"I\",\n    CtDouble => \"D\",\n    CtBool => \"B\",\n    CtString => \"G\",\n    CtChar => \"H\",\n    CtUnit => \"U\",\n    CtBytes => \"Y\",\n    CtUnknown => \"X\",\n    CtVar(id) => String::concat(\"V\", serialize_segment(__to_string(id))),\n    CtEnum(name) => String::concat(\"E\", serialize_segment(name)),\n    CtStruct(name) => String::concat(\"R\", serialize_segment(name)),\n    CtArray(elem) => String::concat(\"A\", serialize_type(elem)),\n    CtOption(elem) => String::concat(\"O\", serialize_type(elem)),\n    CtTuple(elems) => String::concat(\"T\", serialize_type_array(elems)),\n    CtFn(params, ret, effect_name) => {\n      let eff_str = if effect_name is Some(n) { n } else { \"\" }\n      String::concat(\"F\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\n    },\n    CtNamed(name, args) =>\n    String::concat(\"N\", String::concat(serialize_segment(name), serialize_type_array(args))),\n    CtForAll(vars, bounds, body) =>\n    String::concat(\"Q\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\n  }\n}\n\nexport fn persistent_dep_list_text(deps: Array[String]) -> String {\n  if Array::length(deps) == 0 {\n    \"\"\n  } else if Array::length(deps) == 1 {\n    String::concat(\"version\\t3\\n\", Array::get(deps, 0))\n  } else {\n    String::concat(\"version\\t2\\n\", serialize_string_array(deps))\n  }\n}\n\nexport fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs } {\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    if String::length(text) == 0 {\n      Some(Array::slice([\n        \"\"\n      ], 0, 0))\n    } else {\n      let v2_prefix = \"version\\t2\\n\"\n      let v3_prefix = \"version\\t3\\n\"\n      let text_len = String::length(text)\n      let v2_len = String::length(v2_prefix)\n      let v3_len = String::length(v3_prefix)\n      if text_len >= v2_len &&\n      text[0: v2_len] == v2_prefix {\n        let body = text[v2_len: text_len]\n        let (deps, end_pos) = parse_string_array(body, 0)\n        if end_pos == String::length(body) {\n          if package_index_deps_are_current(deps) {\n            Some(deps)\n          } else {\n            None\n          }\n        } else {\n          throw(String::concat(\"invalid persistent dep list body: \", cache_path))\n        }\n      } else if text_len >= v3_len &&\n      text[0: v3_len] == v3_prefix {\n        let dep = text[v3_len: text_len]\n        if String::length(dep) == 0 {\n          Some(Array::slice([\n            \"\"\n          ], 0, 0))\n        } else {\n          if package_index_deps_are_current([dep]) {\n            Some([dep])\n          } else {\n            None\n          }\n        }\n      } else {\n        throw(String::concat(\"invalid persistent dep list header: \", cache_path))\n      }\n    }\n  }\n}\n\nfn rebuild_persistent_type_env(bindings: Array[(String, Type)]) -> TypeEnv {\n  EnvFlat(bindings)\n}\n\nexport fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {\n  let path = persistent_type_env_cache_path(fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \"\\n\")\n    let len = Array::length(lines)\n    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\n      if index >= len {\n        if version_ok {\n          Some(rebuild_persistent_type_env(bindings))\n        } else {\n          None\n        }\n      } else {\n        let line = Array::get(lines, index)\n        if String::length(line) == 0 {\n          go(index + 1, version_ok, bindings)\n        } else {\n          let parts = String::split(line, \"\\t\")\n          if !version_ok {\n            if Array::length(parts) == 2 &&\n            Array::get(parts, 0) == \"version\" &&\n            Array::get(parts, 1) == \"1\" {\n              go(index + 1, true, bindings)\n            } else {\n              throw(String::concat(\"invalid persistent type env header: \", line))\n            }\n          } else if Array::length(parts) == 3 && Array::get(parts, 0) == \"bind\" {\n            let raw_type = Array::get(parts, 2)\n            let (ty, end_pos) = parse_cached_type(raw_type, 0)\n            if end_pos != String::length(raw_type) {\n              throw(String::concat(\"invalid persistent type env bind row: \", line))\n            } else {\n              Array::push(bindings, (Array::get(parts, 1), ty))\n              go(index + 1, true, bindings)\n            }\n          } else {\n            throw(String::concat(\"invalid persistent type env row: \", line))\n          }\n        }\n      }\n    }\n    go(0, false, Array::slice([\n      (\"\", CtUnknown)\n    ], 0, 0))\n  }\n}\n\nexport fn persistent_type_env_cache_text(env: TypeEnv) -> String {\n  let bindings = env_flat_bindings(env)\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    StringBuilder::push(buf, \"bind\\t\")\n    StringBuilder::push(buf, name)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, serialize_type(ty))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t1\\n\"\n    if String::length(text) > String::length(prefix) &&\n    text[0: String::length(prefix)] == prefix {\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\n    } else {\n      None\n    }\n  }\n}\n\nexport fn persistent_leaf_fingerprint_text(fingerprint: String) -> String {\n  String::concat(\"version\\t1\\n\", String::concat(fingerprint, \"\\n\"))\n}\n")
}

let selfhost_source_135 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/module_source.vibe",
"\n\n\n\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let span_end = parsed.2\n  let keep = dce_keep_flags(stmts, [entry_name])\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    if Array::get(keep, i) {\n      let s = Array::get(span_start, i)\n      let e = Array::get(span_end, i)\n      if e > s {\n        let snippet = String::substring(source, s, e)\n        StringBuilder::push(buf, snippet)\n        let n = String::length(snippet)\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\n' {\n          StringBuilder::push(buf, \"\\n\")\n        }\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let entry = match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => {\n          let off = Array::get(span_start, i)\n          let lc = offset_to_line_col(source, off)\n          let line = lc.0\n          String::concat(name, String::concat(\"\\t\", String::concat(__to_string(line), \"\\n\")))\n        },\n        _ => \"\"\n      },\n      _ => \"\"\n    }\n    StringBuilder::push(buf, entry)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n")
}

let selfhost_source_136 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(\n    RippleDb,\n    Array[(String, TypeEnv)],\n    Array[(String, String)],\n    Array[StringTriple],\n    Array[StringTriple],\n    Array[StringTriple],\n    Int,\n    Int,\n    Int,\n    Int\n  )\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n\nfn unwrap_db(db: TypeDb) -> TypeDbState {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nfn wrap_db(state: TypeDbState) -> TypeDb {\n  TypeDb(state)\n}\n\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nfn add_dep(acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_import_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::push(acc, resolved)\n      acc\n    }\n  }\n}\n\nfn empty_strings() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_env_cache() -> Array[(String, TypeEnv)] {\n  Array::slice([\n    (\"\", EnvEmpty)\n  ], 0, 0)\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_string_triples() -> Array[StringTriple] {\n  Array::slice([\n    StringTriple(\"\", \"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_stmt_array() -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nexport fn db_new() -> TypeDb {\n  wrap_db(\n    TypeDbState(\n      ripple_new(),\n      empty_env_cache(),\n      empty_string_pairs(),\n      empty_string_triples(),\n      empty_string_triples(),\n      empty_string_triples(),\n      0,\n      0,\n      0,\n      0\n    )\n  )\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn lookup_source_cache(cache: Array[StringTriple], path: String, fingerprint: String) -> Option[String] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n          if p == path && fp == fingerprint {\n            Some(source)\n          } else {\n            go(i + 1)\n          }\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_source_cache(cache: Array[StringTriple], path: String, fingerprint: String, source: String) -> Array[StringTriple] {\n  let out = empty_string_triples()\n  let mut i = 0\n  let len = Array::length(cache)\n  while i < len {\n    match Array::get(cache, i) {\n      StringTriple(p, fp, existing) =>\n        if p == path && fp == fingerprint {\n          ()\n        } else {\n          Array::push(out, StringTriple(p, fp, existing))\n        }\n    }\n    i = i + 1\n  }\n  Array::push(out, StringTriple(path, fingerprint, source))\n  out\n}\n\nfn append_source_cache_entries(cache: Array[StringTriple], entries: Array[StringTriple]) -> Array[StringTriple] {\n  if Array::length(entries) == 0 {\n    cache\n  } else {\n    let out = empty_string_triples()\n    let mut i = 0\n    while i < Array::length(cache) {\n      Array::push(out, Array::get(cache, i))\n      i = i + 1\n    }\n    let mut j = 0\n    while j < Array::length(entries) {\n      Array::push(out, Array::get(entries, j))\n      j = j + 1\n    }\n    out\n  }\n}\n\nexport fn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          ripple_set_source(rdb, path, source),\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n  }\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nexport fn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv] {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn compact_string_fingerprint(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_type_env_cache_path(fingerprint),\n    persistent_type_env_cache_text(env)\n  )\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn db_typecheck_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport fn db_parse_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport fn db_merge_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport fn db_module_source_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport fn db_codegen_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_strings())\n}\n\nfn resolve_deps_for_source(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n            (\n              deps,\n              upsert_string_pair(dep_source_cache, path, source),\n              parse_count + 1\n            )\n          }\n        }\n      } else {\n        let stmts = parse_program_with_path(path, source)\n        let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n        (\n          deps,\n          upsert_string_pair(dep_source_cache, path, source),\n          parse_count + 1\n        )\n      },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        parse_count + 1\n      )\n    }\n  }\n}\n\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (\n      deps,\n      upsert_string_pair(dep_source_cache, path, source),\n      parse_count\n    ),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        next_parse_count\n      )\n    }\n  }\n}\n\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n        }\n      } else {\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nfn ensure_fingerprint(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\n          rdb,\n          dep_source_cache,\n          path,\n          source,\n          parse_count\n        )\n        let dlen = Array::length(deps)\n        let saved_stack_len = Array::length(stack)\n        Array::push(stack, path)\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (\n              dep_fp,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            ) = ensure_fingerprint(\n              dep_db,\n              dep_env_cache,\n              dep_source_cache2,\n              dep_parse_count,\n              dep_path,\n              stack\n            )\n            Array::push(dep_acc, (dep_path, dep_fp))\n            resolve_nested(\n              i + 1,\n              dep_acc,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            )\n          }\n        }\n        let resolved_nested = resolve_nested(\n          0,\n          empty_dep_fps(),\n          rdb,\n          env_cache,\n          next_dep_source_cache,\n          initial_parse_count\n        )\n        Array::truncate(stack, saved_stack_len)\n        let dep_fps = resolved_nested.0\n        let db_after_deps = resolved_nested.1\n        let env_cache_after_deps = resolved_nested.2\n        let dep_source_cache_after_deps = resolved_nested.3\n        let parse_count_after_deps = resolved_nested.4\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n            if cached_fp == fingerprint {\n              (\n                fingerprint,\n                db_after_deps,\n                env_cache_after_deps,\n                dep_source_cache_after_deps,\n                parse_count_after_deps\n              )\n            } else {\n              let stmts = parse_program_with_path(path, source)\n              let final_parse_count = parse_count_after_deps + 1\n              let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n              let checked_env = check_program_with_env(stmts, import_env)\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n              (\n                fingerprint,\n                next_db,\n                next_env_cache,\n                dep_source_cache_after_deps,\n                final_parse_count\n              )\n            },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (\n              fingerprint,\n              next_db,\n              next_env_cache,\n              dep_source_cache_after_deps,\n              final_parse_count\n            )\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_strings()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport fn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint_fs_impl(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_strings()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport fn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n      match ripple_get_source(rdb, path) {\n        None => throw(String::concat(\"missing:\", path)),\n        Some(source) =>\n          match ripple_get_fingerprint(rdb, path) {\n            Some(fingerprint) => (source, fingerprint, checked),\n            None => (source, source, checked)\n          }\n      }\n  }\n}\n\nfn build_merge_fingerprint(sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !contains_str(emitted, local) && !contains_str(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            apply_export_renames_stmts(\n              parse_program_with_path(resolved, source),\n              export_plan_renames_for(plan, resolved)\n            )\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn parse_merge_sources(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_with_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\nfn build_merged_source_with_plan(entry_path: String, sources: Array[(String, String)], file_paths: Array[String], file_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, collision_sources: Array[(String, String)]) -> String with { Error } {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let stmts = Array::get(file_stmts, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    let export_renamed = if is_entry_source {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if is_entry_source {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, collision_sources, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nfn build_merged_source(entry_path: String, sources: Array[(String, String)]) -> String with { Error } {\n  let (file_paths, file_stmts) = parse_merge_sources(sources)\n  let plan_entry = if entry_path == \"\" {\n    if Array::length(file_paths) > 0 {\n      Array::get(file_paths, Array::length(file_paths) - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  build_merged_source_with_plan(entry_path, sources, file_paths, file_stmts, plan, sources)\n}\n\nfn join_group_sources(group_sources: Array[String]) -> String {\n  let len = Array::length(group_sources)\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let source = Array::get(group_sources, i)\n    if i > 0 {\n      StringBuilder::push(buf, \"\\n\")\n    }\n    StringBuilder::push(buf, source)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(_entry_path, sources)\n          let next_merged_cache = upsert_source_cache(\n            merged_cache,\n            merge_cache_key,\n            merge_fingerprint,\n            merged_source\n          )\n          (\n            merged_source,\n            merge_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nexport fn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let group_sources = empty_strings()\n      let mut grouped_fingerprint = \"merged-groups\"\n      let new_group_cache_entries = empty_string_triples()\n      let mut merge_count_acc = merge_count\n      let flat_sources = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut fgi = 0\n      while fgi < Array::length(groups) {\n        let (_, gsources) = Array::get(groups, fgi)\n        let mut fsi = 0\n        while fsi < Array::length(gsources) {\n          Array::push(flat_sources, Array::get(gsources, fsi))\n          fsi = fsi + 1\n        }\n        fgi = fgi + 1\n      }\n      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)\n      let plan_entry = if Array::length(flat_paths) > 0 {\n        Array::get(flat_paths, Array::length(flat_paths) - 1)\n      } else {\n        \"\"\n      }\n      let plan = build_export_rename_plan(flat_paths, flat_stmts, plan_entry)\n      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))\n      let mut flat_idx = 0\n      let mut i = 0\n      while i < Array::length(groups) {\n        let (group_name, sources) = Array::get(groups, i)\n        let group_start = flat_idx\n        flat_idx = flat_idx + Array::length(sources)\n        let fingerprint = compact_string_fingerprint(\n          String::concat(build_merge_fingerprint(sources), String::concat(\"#\", plan_fp))\n        )\n        let grouped_next = String::concat(\n          grouped_fingerprint,\n          String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n        )\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\n        let cache_key = String::concat(\"merged-group|\", group_name)\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\n          Some(source) => {\n            Array::push(group_sources, source)\n          },\n          None =>\n            match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\n              Some(source) => {\n                Array::push(group_sources, source)\n              },\n              None => {\n                let group_paths = Array::slice(flat_paths, group_start, group_start + Array::length(sources))\n                let group_stmts = Array::slice(flat_stmts, group_start, group_start + Array::length(sources))\n                let source = build_merged_source_with_plan(plan_entry, sources, group_paths, group_stmts, plan, flat_sources)\n                Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\n                merge_count_acc = merge_count_acc + 1\n                Array::push(group_sources, source)\n              }\n            }\n        }\n        i = i + 1\n      }\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\n      let next_merge_count = merge_count_acc\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count,\n                module_source_count,\n                codegen_count\n              )\n            )\n          ),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(\n            next_merged_cache,\n            grouped_cache_key,\n            grouped_fingerprint,\n            source\n          )\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                final_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nfn build_module_source(source: String) -> String with { Error } {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport fn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(\n            module_source_cache,\n            module_cache_key,\n            fingerprint,\n            module_source\n          )\n          (\n            module_source,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                merged_cache,\n                next_module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count,\n                module_source_count + 1,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nfn artifact_cache_key(kind: String, entry_name: String) -> String {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nfn bytes_to_hex_digit(n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nfn nibble_from_hex_char(c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nfn bytes_to_hex(bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let buf = StringBuilder::new()\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn hex_to_bytes(hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport fn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n        Some(hex) => Some(hex_to_bytes(hex)),\n        None => None\n      }\n  }\n}\n\nexport fn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          rdb,\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          upsert_source_cache(\n            artifact_cache,\n            artifact_cache_key(kind, entry_name),\n            fingerprint,\n            bytes_to_hex(bytes)\n          ),\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count + 1\n        )\n      )\n  }\n}\n")
}

