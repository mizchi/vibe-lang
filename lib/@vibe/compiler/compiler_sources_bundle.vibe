losure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  let num_base_types = 11\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(type_content, [\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  emit_struct_type_raw(type_content, [\n    126\n  ], [\n    1\n  ])\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    let ct_params = Array::slice([\n      0\n    ], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  if use_host {\n    let imp_content = bytebuf_new()\n    bytebuf_push_vec_header(imp_content, 11)\n    emit_name(imp_content, \"wasi_snapshot_preview1\")\n    emit_name(imp_content, \"fd_write\")\n    bytebuf_push(imp_content, 0)\n    leb128_encode_u32(imp_content, 0)\n    let host_imports = [\n      (\"env-get\", 3),\n      (\"args-len\", 5),\n      (\"args-get\", 3),\n      (\"fs_read_file\", 3),\n      (\"fs_exists\", 3),\n      (\"fs_stat_token\", 3),\n      (\"fs_write_file\", 6),\n      (\"fs_write_bytes\", 6),\n      (\"fs_read_bytes\", 3),\n      (\"profile-now-us\", 5)\n    ]\n    let mut __hi = 0\n    while __hi < Array::length(host_imports) {\n      let (hin, hit) = Array::get(host_imports, __hi)\n      emit_name(imp_content, \"vibe\")\n      emit_name(imp_content, hin)\n      bytebuf_push(imp_content, 0)\n      leb128_encode_u32(imp_content, hit)\n      __hi = __hi + 1\n    }\n    bytebuf_push_section(out, 2, imp_content)\n  } else {\n    emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  }\n  let func_type_indices = Array::slice([\n    0\n  ], 0, 0)\n  let mut gbti = 0\n  while gbti < Array::length(gc_builtin_type_idxs) {\n    Array::push(func_type_indices, Array::get(gc_builtin_type_idxs, gbti))\n    gbti = gbti + 1\n  }\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(ft_params, fti)\n    Array::push(func_type_indices, closure_type_base + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, closure_type_base + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"gc codegen internal error: function section and code section count mismatch\")\n  } else {\n    ()\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, 1)\n  if stmts_contain_exceptions(stmts) {\n    let tag_content = bytebuf_new()\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push(tag_content, 0)\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  if Array::length(gc_global_names_l) == 0 {\n    emit_global_section_i32_mut(out, heap_start)\n  } else {\n    let g_content = bytebuf_new()\n    bytebuf_push_vec_header(g_content, 1 + Array::length(gc_global_names_l))\n    bytebuf_push(g_content, 127)\n    bytebuf_push(g_content, 1)\n    emit_i32_const(g_content, heap_start)\n    emit_end(g_content)\n    let mut ggi = 0\n    while ggi < Array::length(gc_global_names_l) {\n      bytebuf_push(g_content, 126)\n      bytebuf_push(g_content, 1)\n      emit_i64_const(g_content, 0)\n      emit_end(g_content)\n      ggi = ggi + 1\n    }\n    bytebuf_push_section(out, 6, g_content)\n  }\n  let start_func_idx = func_offset + num_user_funcs\n  let export_content = bytebuf_new()\n  let export_entry_too = entry_name != \"_start\"\n  bytebuf_push_vec_header(export_content, if export_entry_too {\n    4\n  } else {\n    3\n  })\n  emit_name(export_content, \"_start\")\n  bytebuf_push(export_content, 0)\n  leb128_encode_u32(export_content, start_func_idx)\n  if export_entry_too {\n    emit_name(export_content, entry_name)\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, entry_func_idx)\n  } else {\n    ()\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"__heap_ptr\")\n  bytebuf_push(export_content, 3)\n  leb128_encode_u32(export_content, 0)\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = Array::slice([\n      0\n    ], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, start_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\n    let num_ref_locals = Array::length(ref_indices)\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      }\n    } else {\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        let _ = is_ref\n        bytebuf_push(func_buf, 126)\n        rli = rli + 1\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = Array::slice([\n      0\n    ], 0, 0)\n    let data_bufs = fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n")
}

let selfhost_source_116 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_expr.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn gc_expr_is_intish(e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EBinOp(op, _, _) => op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" || op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\nfn gc_expr_is_floatish(e: Expr, ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(l, ctx) || gc_expr_is_floatish(r, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && gc_expr_is_floatish(x, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn gc_is_ctor_expr(e: Expr, ctx: CompileCtxGc) -> Bool {\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(cname, _) => ctor_table_index_of(ctx.gc_ctor_table, cname) >= 0,\n      _ => false\n    },\n    EIdent(iname, _) => ctor_table_index_of(ctx.gc_ctor_table, iname) >= 0,\n    _ => false\n  }\n}\n\nfn emit_gc_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\nfn emit_gc_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gcceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gcceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__gcceq_res\")\n    Array::push(local_names, \"__gcceq_cnt\")\n    Array::push(local_names, \"__gcceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\nfn emit_gc_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let lhs_is_tuple = match lhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let rhs_is_tuple = match rhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let lhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, rhs, local_names)\n  if lhs_is_tuple || rhs_is_tuple {\n    let num = match lhs {\n      ETuple(les) => Array::length(les),\n      _ => match rhs {\n        ETuple(res) => Array::length(res),\n        _ => 0\n      }\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    let tn = if lhs_agg / 64 == 1 {\n      lhs_agg % 64\n    } else {\n      rhs_agg % 64\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, cefn)\n  } else if gc_is_ctor_expr(lhs, ctx) || gc_is_ctor_expr(rhs, ctx) {\n    let clit = if gc_is_ctor_expr(lhs, ctx) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = match clit {\n      ECall(_, cargs, _) => Array::length(cargs),\n      _ => 0\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    let lfc = if lhs_agg / 64 == 2 {\n      lhs_agg % 64\n    } else {\n      0\n    }\n    let rfc = if rhs_agg / 64 == 2 {\n      rhs_agg % 64\n    } else {\n      0\n    }\n    let cfc = if lfc > rfc {\n      lfc\n    } else {\n      rfc\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if gc_expr_is_intish(lhs) || gc_expr_is_intish(rhs) {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nfn compile_expr_gc(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with { Error } {\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name, _) => {\n      let len = Array::length(local_names)\n      let rec try_local: (Int) -> Int = (i) -> {\n        if i < 0 {\n          -1\n        }\n        else if Array::get(local_names, i) == name {\n          i\n        }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          emit_local_get(buf, local_idx)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = ctor_table_index_of(ctx.gc_ctor_table, name)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.gc_ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_heap_memory_grow_check(buf)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          let mut const_i = -1\n          let mut __gc = 0\n          while __gc < Array::length(ctx.gc_const_names) {\n            if Array::get(ctx.gc_const_names, __gc) == name {\n              const_i = __gc\n              __gc = Array::length(ctx.gc_const_names)\n            } else {\n              __gc = __gc + 1\n            }\n          }\n          if const_i >= 0 {\n            if Array::get(ctx.gc_const_kinds, const_i) == 1 {\n              let cs = Array::get(ctx.gc_const_svals, const_i)\n              let csi = str_table_lookup(ctx.str_table.strs, cs)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, csi), Array::get(ctx.str_table.lengths, csi))\n            } else {\n              emit_i64_const(buf, Array::get(ctx.gc_const_ivals, const_i))\n            }\n            return next_local\n          }\n          let mut glob_i = -1\n          let mut __gg = 0\n          while __gg < Array::length(ctx.gc_global_names) {\n            if Array::get(ctx.gc_global_names, __gg) == name {\n              glob_i = __gg\n              __gg = Array::length(ctx.gc_global_names)\n            } else {\n              __gg = __gg + 1\n            }\n          }\n          if glob_i >= 0 {\n            emit_global_get(buf, 1 + glob_i)\n            return next_local\n          }\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut fni = -1\n          let mut __fj = 0\n          while __fj < fn_len {\n            if Array::get(ctx.func_table.names, __fj) == name {\n              fni = __fj\n              __fj = fn_len\n            } else {\n              __fj = __fj + 1\n            }\n          }\n          if fni < 0 {\n            throw(String::concat(\"undefined variable: \", name))\n          }\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => if op == \"&&\" || op == \"||\" {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_else(buf)\n        emit_i64_const(buf, 1)\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" {\n      emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n    } else if op == \"!=\" {\n      let nle = emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nle\n    } else if (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(lhs, ctx) || gc_expr_is_floatish(rhs, ctx)) {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" {\n        emit_f64_add(buf)\n      } else if op == \"-\" {\n        emit_f64_sub(buf)\n      } else if op == \"*\" {\n        emit_f64_mul(buf)\n      } else {\n        emit_f64_div(buf)\n      }\n      emit_i64_reinterpret_f64(buf)\n      nl2\n    } else if (op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\") && (gc_expr_is_floatish(lhs, ctx) || gc_expr_is_floatish(rhs, ctx)) {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"<\" {\n        emit_f64_lt(buf)\n      } else if op == \">\" {\n        emit_f64_gt(buf)\n      } else if op == \"<=\" {\n        emit_f64_le(buf)\n      } else {\n        emit_f64_ge(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      nl2\n    } else {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => if op == \"-\" && gc_expr_is_floatish(operand, ctx) {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_neg(buf)\n      emit_i64_reinterpret_f64(buf)\n      nl\n    } else if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n    ,\n    EIf(cond, then_e, else_e) => {\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if cop == \"==\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          cnl\n        } else if cop == \"!=\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i64_eqz(buf)\n          cnl\n        } else if (cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\") && (gc_expr_is_floatish(clhs, ctx) || gc_expr_is_floatish(crhs, ctx)) {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else if cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val {\n            1\n          } else {\n            0\n          })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 {\n        ld + 1\n      } else {\n        -1\n      }\n      let names_len_before = Array::length(local_names)\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      let max_nl = if nl_then > nl_else {\n        nl_then\n      } else {\n        nl_else\n      }\n      while Array::length(local_names) < max_nl {\n        Array::push(local_names, \"\")\n      }\n      max_nl\n    },\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body, _) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if gc_expr_is_floatish(value, ctx) {\n        Array::push(ctx.gc_float_locals, name)\n      } else {\n        ()\n      }\n      let agg_entry = match value {\n        ETuple(tels) => 64 + Array::length(tels),\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\n        _ => if gc_is_ctor_expr(value, ctx) {\n          match value {\n            ECall(_, cargs, _) => {\n              let fcnt = if Array::length(cargs) == 1 {\n                match Array::get(cargs, 0) {\n                  ERecord(_, crf, _) => Array::length(crf),\n                  _ => Array::length(cargs)\n                }\n              } else {\n                Array::length(cargs)\n              }\n              128 + fcnt\n            },\n            _ => 128\n          }\n        } else {\n          match value {\n            EIdent(src_nm, _) => {\n              let src_slot = find_local_slot(local_names, src_nm)\n              if src_slot >= 0 {\n                let src_info = agg_slot_lookup(ctx.gc_agg_local_slots, src_slot)\n                if src_info > 0 {\n                  src_info\n                } else {\n                  0\n                }\n              } else {\n                0\n              }\n            },\n            ECall(vcal, _, _) => match vcal {\n              EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n                let rinfo = agg_ret_lookup(ctx.gc_agg_ret_names, ctx.gc_agg_ret_infos, cfn)\n                if rinfo > 0 {\n                  rinfo\n                } else {\n                  0\n                }\n              } else {\n                0\n              },\n              _ => 0\n            },\n            _ => 0\n          }\n        }\n      }\n      Array::push(ctx.gc_agg_local_slots, local_idx * 256 + agg_entry)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = Array::slice([\n            \"\"\n          ], 0, 0)\n          let mut bpi = 0\n          while bpi < Array::length(params) {\n            let (pn, _) = Array::get(params, bpi)\n            Array::push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.gc_ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < Array::length(caps) {\n            if Array::get(caps, bci) == name {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetMut(name, value, body, _) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if mut_needs_ref_cell(body, name) {\n        Array::push(ctx.ref_cell_names, name)\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, local_idx)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_i64_store(buf, 3, 0)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        if gc_expr_is_floatish(value, ctx) {\n          Array::push(ctx.gc_float_locals, name)\n        } else {\n          ()\n        }\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl_s = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl_s, ld)\n    },\n    ETuple(elems) => {\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let names_len_at_forin = Array::length(local_names)\n      let result_local = next_local\n      let arr_local = next_local + 1\n      let i_local = next_local + 2\n      Array::push(local_names, \"__forin_res\")\n      Array::push(local_names, \"__forin_arr\")\n      Array::push(local_names, \"__forin_i\")\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, result_local)\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 3, ld)\n      emit_local_set(buf, arr_local)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_local)\n      emit_local_get(buf, arr_local)\n      if ctx.func_offset > 0 && arr_len_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_len_idx)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      let var_local = match index_name {\n        Some(idx_name) => {\n          emit_local_get(buf, i_local)\n          emit_local_set(buf, nl1)\n          Array::push(local_names, idx_name)\n          nl1 + 1\n        },\n        None => nl1\n      }\n      emit_local_get(buf, arr_local)\n      emit_local_get(buf, i_local)\n      if ctx.func_offset > 0 && arr_get_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_get_idx)\n      emit_local_set(buf, var_local)\n      Array::push(local_names, var_name)\n      let nl3 = var_local + 1\n      let nl4 = ce(buf, body, local_names, nl3, 0)\n      let body_val = nl4\n      Array::push(local_names, \"__forin_val\")\n      emit_local_set(buf, body_val)\n      emit_local_get(buf, result_local)\n      emit_local_get(buf, body_val)\n      if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n      emit_local_get(buf, i_local)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_local)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, result_local)\n      let final_nl = nl4 + 1\n      Array::truncate(local_names, names_len_at_forin)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_forin)\n      while Array::length(local_names) < final_nl {\n        Array::push(local_names, \"\")\n      }\n      final_nl\n    },\n    EWhile(cond, body) => {\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      let nl1 = match cond {\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \"==\" {\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if wcop == \"!=\" {\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i64_eqz(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if (wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\") && (gc_expr_is_floatish(wlhs, ctx) || gc_expr_is_floatish(wrhs, ctx)) {\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          emit_f64_reinterpret_i64(buf)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          emit_f64_reinterpret_i64(buf)\n          if wcop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if wcop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          if wcop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if wcop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        },\n        _ => {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        }\n      }\n      emit_br_if(buf, 1)\n      let nl2 = ce(buf, body, local_names, nl1, 0)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EReturn(ret_expr) => {\n      let nl = ce(buf, ret_expr, local_names, next_local, ld)\n      emit_return(buf)\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field, _, _) => {\n      let fc0 = String::char_code_at(field, 0)\n      if fc0 >= 48 && fc0 <= 57 {\n        let mut tidx = 0\n        let mut tp = 0\n        while tp < String::length(field) {\n          tidx = tidx * 10 + (String::char_code_at(field, tp) - 48)\n          tp = tp + 1\n        }\n        let nl_t = ce(buf, obj, local_names, next_local, ld)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, tidx * 8)\n        return nl_t\n      }\n      let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n      if Array::length(cands) == 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let (_, idx0) = Array::get(cands, 0)\n      let dispatch = struct_field_dispatch_cases(cands)\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      if Array::length(dispatch) == 0 {\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        nl1\n      } else {\n        let obj_l = nl1\n        Array::push(local_names, \"__dot_obj\")\n        emit_local_set(buf, obj_l)\n        let mut di = 0\n        while di < Array::length(dispatch) {\n          let (dtag, didx) = Array::get(dispatch, di)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, dtag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + didx * 8)\n          emit_else(buf)\n          di = di + 1\n        }\n        emit_local_get(buf, obj_l)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        let mut de = 0\n        while de < Array::length(dispatch) {\n          emit_end(buf)\n          de = de + 1\n        }\n        nl1 + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let flen = Array::length(fields)\n      let lit_names = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.gc_ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.gc_ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)\n        let ordered = Array::slice([\n          (\"\", EUnit)\n        ], 0, 0)\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, rec_tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(rec_fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, harms) => {\n      if Array::length(harms) == 0 {\n        ce(buf, body, local_names, next_local, ld)\n      } else {\n        let (hpat, hexpr) = Array::get(harms, 0)\n        let mut hpat_ok = false\n        match hpat {\n          PCtor(hname, _) => {\n            if hname == \"Error::Throw\" || hname == \"Throw\" {\n              hpat_ok = true\n            }\n          },\n          _ => ()\n        }\n        if !hpat_ok {\n          throw(\"GC codegen: only `with Error { Throw(..) => .. }` handlers are supported (algebraic effect handlers need the linear backend)\")\n        }\n        emit_block_i64(buf)\n        emit_block_i64(buf)\n        bytebuf_push(buf, 31)\n        bytebuf_push(buf, 126)\n        leb128_encode_u32(buf, 1)\n        bytebuf_push(buf, 0)\n        leb128_encode_u32(buf, 0)\n        leb128_encode_u32(buf, 0)\n        let body_ld = if ld >= 0 {\n          ld + 3\n        } else {\n          -1\n        }\n        let nl_b = ce(buf, body, local_names, next_local, body_ld)\n        emit_end(buf)\n        emit_br(buf, 1)\n        emit_end(buf)\n        let names_before_h = Array::length(local_names)\n        let mut nl_h = nl_b\n        match hpat {\n          PCtor(_, hargs) => {\n            if Array::length(hargs) > 0 {\n              match Array::get(hargs, 0) {\n                PBind(hbname) => {\n                  let hb_l = Array::length(local_names)\n                  emit_local_set(buf, hb_l)\n                  Array::push(local_names, hbname)\n                  if hb_l + 1 > nl_h {\n                    nl_h = hb_l + 1\n                  }\n                },\n                _ => emit_drop(buf)\n              }\n            } else {\n              emit_drop(buf)\n            }\n          },\n          _ => emit_drop(buf)\n        }\n        let harm_ld = if ld >= 0 {\n          ld + 1\n        } else {\n          -1\n        }\n        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)\n        emit_end(buf)\n        Array::truncate(local_names, names_before_h)\n        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\n        if nl_h2 > nl_h {\n          nl_h = nl_h2\n        }\n        nl_h\n      }\n    },\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\n    EMap(mfields) => {\n      let mflen = Array::length(mfields)\n      let mcap = if mflen > 32 {\n        mflen\n      } else {\n        32\n      }\n      let malloc_size = 8 + mcap * 16\n      let mptr = next_local\n      Array::push(local_names, \"__maplit_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mptr)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, malloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mflen)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mcap)\n      emit_i32_store(buf, 2, 4)\n      let mut mnl = next_local + 1\n      let mut mi = 0\n      while mi < mflen {\n        let (mkey, mval) = Array::get(mfields, mi)\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        mnl = ce(buf, mval, local_names, mnl, ld)\n        emit_i64_store(buf, 3, 16 + mi * 16)\n        mi = mi + 1\n      }\n      emit_local_get(buf, mptr)\n      mnl\n    },\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(String::concat(\"unsupported expression in gc codegen: tag \", __to_string(expr_tag(expr))))\n  }\n}\n\n\nexport {\n  compile_expr_gc\n}\n")
}

let selfhost_source_117 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_call.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nfn emit_call_resolved(buf: Bytes, ctx: CompileCtxGc, fidx: Int) -> Unit {\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\n    emit_i64_const(buf, 0)\n  } else {\n    ()\n  }\n  emit_call(buf, fidx)\n}\n\nfn gc_resolve_builtin_last(ft: FuncTable, name: String) -> Int {\n  let mut i = Array::length(ft.names) - 1\n  let mut found = -1\n  while i >= 0 {\n    if found < 0 && Array::get(ft.names, i) == name {\n      found = Array::get(ft.indices, i)\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  found\n}\n\nfn bc_expr_is_floatish(e: Expr, ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (bc_expr_is_floatish(l, ctx) || bc_expr_is_floatish(r, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && bc_expr_is_floatish(x, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn compile_call_gc(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  match callee {\n    EIdent(fname, _) => {\n      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global