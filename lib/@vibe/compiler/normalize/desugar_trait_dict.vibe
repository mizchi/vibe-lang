//# Functions

enum StoredNormalizedBinderAuthority {
  StoredNormalizedAuthorityNil;
  StoredNormalizedAuthoritySlot(BinderAuthoritySlot, StoredNormalizedBinderAuthority);
  StoredNormalizedAuthorityNode(BinderAuthorityNodeKind, StoredNormalizedBinderAuthority, StoredNormalizedBinderAuthority);
  StoredNormalizedAuthorityChild(StoredNormalizedBinderAuthority, StoredNormalizedBinderAuthority)
}

export struct NormalizedProgramBinderAuthority {
  nodes: StoredNormalizedBinderAuthority
}

enum StoredLabeledArgBinderAuthorityNormalization {
  StoredLabeledArgBinderAuthorityNormalizationValue(Array[Stmt], Option[NormalizedProgramBinderAuthority])
}

export struct LabeledArgBinderAuthorityNormalization {
  stored: StoredLabeledArgBinderAuthorityNormalization
}

struct GenericImplInfo {
  owner: String;
  trait_name: String;
  type_params: Array[String];
  target: TypeExpr
}

struct DictGen {
  name: String;
  threaded: Array[(String, String, Int)];
  return_constructor_param: String;
  impl_trait: String;
  impl_params: Array[String];
  impl_target: Option[TypeExpr];
  constructor_recvs: Array[(String, Int)]
}

fn paired_poison(poisoned: Array[Bool]) -> Unit {
  Array::set(poisoned, 0, true)
}

fn paired_child_or_self(node: BinderAuthorityNode, index: Int, poisoned: Array[Bool]) -> BinderAuthorityNode {
  let children = binder_authority_node_children(node)
  if index < 0 || index >= Array::length(children) {
    paired_poison(poisoned)
    node
  } else {
    Array::get(children, index)
  }
}

fn paired_expect_node(node: BinderAuthorityNode, kind: BinderAuthorityNodeKind, slots: Int, children: Int, poisoned: Array[Bool]) -> Unit {
  let actual_slots = binder_authority_node_slots(node)
  let actual_children = binder_authority_node_children(node)
  if binder_authority_node_kind(node) != kind || Array::length(actual_slots) != slots || Array::length(actual_children) != children {
    paired_poison(poisoned)
  } else {
    ()
  }
  for slot in actual_slots {
    match binder_authority_slot_binder(slot) {
      Synthetic(_, _) => paired_poison(poisoned),
      SourceToken(_, _, _) => ()
    }
  }
  ()
}

fn paired_expect_slot(node: BinderAuthorityNode, index: Int, role: BinderSemanticRole, name: String, poisoned: Array[Bool]) -> Unit {
  let slots = binder_authority_node_slots(node)
  if index < 0 || index >= Array::length(slots) {
    paired_poison(poisoned)
  } else {
    let slot = Array::get(slots, index)
    let actual_name = match binder_authority_slot_binder(slot) {
      SourceToken(n, _, _) => n,
      Synthetic(n, _) => {
        paired_poison(poisoned)
        n
      }
    }
    if binder_authority_slot_role(slot) != role || actual_name != name {
      paired_poison(poisoned)
    } else {
      ()
    }
  }
}

fn stored_normalized_authority_slots(slots: Array[BinderAuthoritySlot], at: Int) -> StoredNormalizedBinderAuthority {
  if at >= Array::length(slots) {
    StoredNormalizedAuthorityNil
  } else {
    StoredNormalizedAuthoritySlot(Array::get(slots, at), stored_normalized_authority_slots(slots, at + 1))
  }
}

fn stored_normalized_authority_node(node: BinderAuthorityNode) -> StoredNormalizedBinderAuthority {
  StoredNormalizedAuthorityNode(binder_authority_node_kind(node), stored_normalized_authority_slots(binder_authority_node_slots(node), 0), stored_normalized_authority_nodes(binder_authority_node_children(node), 0))
}

fn stored_normalized_authority_nodes(nodes: Array[BinderAuthorityNode], at: Int) -> StoredNormalizedBinderAuthority {
  if at >= Array::length(nodes) {
    StoredNormalizedAuthorityNil
  } else {
    StoredNormalizedAuthorityChild(stored_normalized_authority_node(Array::get(nodes, at)), stored_normalized_authority_nodes(nodes, at + 1))
  }
}

fn append_normalized_materialized_slots(stored: StoredNormalizedBinderAuthority, out: ArrayBuilder[BinderAuthoritySlot]) -> Unit {
  match stored {
    StoredNormalizedAuthoritySlot(slot, rest) => {
      ArrayBuilder::push(out, slot)
      append_normalized_materialized_slots(rest, out)
    },
    _ => ()
  }
}

fn normalized_materialize_authority_node(stored: StoredNormalizedBinderAuthority) -> BinderAuthorityNode {
  match stored {
    StoredNormalizedAuthorityNode(kind, slots, children) => {
      let slot_out = ArrayBuilder::new()
      append_normalized_materialized_slots(slots, slot_out)
      let child_out = ArrayBuilder::new()
      append_normalized_materialized_nodes(children, child_out)
      BinderAuthorityNode::{
        kind,
        slots: ArrayBuilder::freeze(slot_out),
        children: ArrayBuilder::freeze(child_out)
      }
    },
    _ => BinderAuthorityNode::{
      kind: AuthorityExprUnit,
      slots: ArrayBuilder::freeze(ArrayBuilder::new()),
      children: ArrayBuilder::freeze(ArrayBuilder::new())
    }
  }
}

fn append_normalized_materialized_nodes(stored: StoredNormalizedBinderAuthority, out: ArrayBuilder[BinderAuthorityNode]) -> Unit {
  match stored {
    StoredNormalizedAuthorityChild(node, rest) => {
      ArrayBuilder::push(out, normalized_materialize_authority_node(node))
      append_normalized_materialized_nodes(rest, out)
    },
    _ => ()
  }
}

export fn labeled_arg_binder_authority_normalization_program(result: LabeledArgBinderAuthorityNormalization) -> Array[Stmt] {
  match result.stored {
    StoredLabeledArgBinderAuthorityNormalizationValue(program, _) => detach_stmts(program)
  }
}

export fn labeled_arg_binder_authority_normalization_authority(result: LabeledArgBinderAuthorityNormalization) -> Option[NormalizedProgramBinderAuthority] {
  match result.stored {
    StoredLabeledArgBinderAuthorityNormalizationValue(_, authority) => authority
  }
}

export fn normalized_program_binder_authority_nodes(authority: NormalizedProgramBinderAuthority) -> Array[BinderAuthorityNode] {
  let out = ArrayBuilder::new()
  append_normalized_materialized_nodes(authority.nodes, out)
  ArrayBuilder::freeze(out)
}

// Dictionary-passing desugaring for method-bearing traits (#641 PR-3
// components 3+4). Runs pre-check, after string-interpolation expansion. It is
// INERT unless the program declares a trait with method signatures, so all
// existing code (and the compiler's own selfbuild) is untouched.
//
// For a method-bearing `trait Tr { m(Self) -> R; ... }` it:
//   1. synthesizes a witness struct `TrDict { m: (Self) -> R; ... }`,
//   2. for each top-level generic `f = [T: Tr](.. x: T ..) -> Ret { body }`
//      that is bounded by `Tr`, prepends a hidden dict parameter
//      `__dict_Tr_T: TrDict[T]` and rewrites `T::m(args)` in the body to
//      `(__dict_Tr_T.m)(args)`,
//   3. at every call site `f(.. recv ..)` synthesizes the witness
//      `TrDict::{ m: C::m, ... }` from the concrete receiver type C (the impl's
//      `C::m` free functions from PR-1) and threads it in.
//
// First slice (#641 PR-3; the plan document was deleted once it landed —
// see the issue thread for the staging): single type parameter
// per bound that appears directly as a parameter type (`x: T`), concrete call
// sites whose receiver type is syntactically determinable (primitive literals
// and struct literals). Anything outside this leaves the call unrewritten, so a
// missing dictionary surfaces as a loud arity error rather than a miscompile.

fn empty_expr_array() -> Array[Expr] {
  array_empty()
}

fn empty_str_array() -> Array[String] {
  array_empty()
}

/// #2128: empty environments for `arm_binder_var_types`'s environment-free
/// entry point. Not "no answer" -- `infer_arg_type_name` still resolves
/// literals and names already recorded in `var_types` from them.
fn empty_struct_sets() -> Array[(String, Array[String])] {
  array_empty()
}

fn empty_fn_returns() -> Array[(String, String)] {
  array_empty()
}

fn local_fn_return_key(name: String) -> String {
  String::concat("__local_fn_return$", name)
}

/// #886: empty explicit-type-argument list for constructed ERecord nodes
/// (dict witnesses / trait defaults never carry explicit struct type args).
fn empty_ty_args() -> Array[TypeExpr] {
  array_empty()
}

fn empty_type_exprs() -> Array[TypeExpr] {
  array_empty()
}

/// Method names declared by a trait, in declaration order.
fn method_names_of_sigs(methods: Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(methods) {
    let (mname, _, _) = Array::get(methods, i)
    Array::push(out, mname)
    i = i + 1
  }
  out
}

fn str_array_contains(arr: Array[String], val: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

fn is_residual_eager_for_type(name: String) -> Bool {
  str_array_contains(["Array", "String", "Map"], name)
}

/// Split a qualified `Head::member` into Some((head, member)) on the FIRST `::`.
fn split_qualified(name: String) -> Option[(String, String)] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    Some((head, member))
  }
}

/// The dict struct name for a trait, e.g. `Measurable` -> `MeasurableDict`.
fn dict_struct_name(trait_name: String) -> String {
  String::concat(trait_ref_name(trait_name), "Dict")
}

/// #2286: which dict structs THIS program's desugar actually synthesized, and
/// for which trait. `(struct name, trait name)`.
///
/// A diagnostic on a dict field used to name the synthesized struct -- ``field
/// `lookup` of struct `StoreDict` `` -- which is a declaration the author never
/// wrote and cannot act on. The trait label exists (`fapp_decl_label`) and is
/// what `vibe check` reports, but the whole-program lane re-checks the desugar
/// output as ordinary source, and by then the trait statement is gone: the
/// compile lane emits exactly ONE diagnostic and it is the struct-shaped one.
/// So this is not a duplicate to suppress -- suppressing it would lose the
/// error -- it is a label that has to be recoverable.
///
/// Recorded at the synthesis site rather than inferred from the name. That
/// distinction is the whole point: `collect_trait_dict_erasures` identifies
/// dict structs by the `+ "Dict"` convention, and a program may legitimately
/// declare its own struct with that name (`unknown_type_name_enforced_test`
/// does). Relabelling on the convention reports a real user struct as a trait
/// signature, which is what killed the attempt in #2276.
///
/// The synthesis site is already guarded by `struct_decl_exists`, so a
/// hand-written `StoreDict` means no struct is synthesized and nothing is
/// recorded -- the user's declaration keeps the field label by construction,
/// not by a name test.
/// Keyed by FIELD, not by struct. `flatten_traits` copies a supertrait's
/// methods into the child's dict, so `ChildDict` holds fields `Child` does not
/// declare. Recording only the dict's owner reported ``the signature of
/// `Child::lookup` `` for a method only `Base` declares -- a name the reader
/// cannot find anywhere in their source, and order-dependent on top: with
/// `Base` declared first the walk stops on `BaseDict` and the label happened
/// to be right (Codex review on #2313, measured both orders).
let dtd_synth_dict_fields: Array[(String, String, String)] = array_empty()
let dtd_constructor_tracking = [false]
let dtd_constructor_local_returns: Array[String] = empty_str_array()

fn dtd_synth_dict_reset() -> Unit {
  Array::truncate(dtd_synth_dict_fields, 0)
}

/// The trait that DECLARES `field_name` in the synthesized dict struct
/// `struct_name`, or "" when `struct_name` is not one this program's desugar
/// produced (or has no such field).
export fn synthesized_dict_field_trait(struct_name: String, field_name: String) -> String {
  let mut i = 0
  let mut found = ""
  while i < Array::length(dtd_synth_dict_fields) {
    let (sname, fname, tname) = Array::get(dtd_synth_dict_fields, i)
    if sname == struct_name && fname == field_name {
      found = tname
      i = Array::length(dtd_synth_dict_fields)
    } else {
      i = i + 1
    }
  }
  found
}

/// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.
fn dict_param_name(trait_name: String, tparam: String) -> String {
  let applied = match trait_ref_from_key(trait_name) {
    Some(reference) => match reference {
      TyApp(_, _) => String::concat("_", impl_target_key(reference)),
      _ => ""
    },
    None => ""
  }
  String::concat("__dict_", String::concat(trait_ref_name(trait_name), String::concat(applied, String::concat("_", tparam))))
}

/// Collect method-bearing traits (name -> signatures). Marker-only traits
/// (no method signatures) are skipped, which is what keeps this pass inert on
/// existing code.
fn collect_method_traits(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, methods, _, _) => if Array::length(methods) > 0 {
        Array::push(out, (tname, methods))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Trait header parameters keyed by the source trait name. Dictionary structs
/// mirror these binders so a field such as `F[A]` remains well-kinded after
/// the trait declaration itself has been erased.
fn collect_trait_type_params(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, _, _, tparams) => Array::push(out, (tname, tparams)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_trait_type_params(entries: Array[(String, Array[String])], trait_name: String) -> Array[String] {
  let mut i = 0
  let mut result = empty_str_array()
  while i < Array::length(entries) {
    let (name, params) = Array::get(entries, i)
    if name == trait_ref_name(trait_name) {
      result = params
      i = Array::length(entries)
    } else {
      i = i + 1
    }
  }
  result
}

/// #1445 原因2 (#1392 slice 3): the SYNTHETIC `Show` witness trait.
///
/// `Show` is a marker trait in source. `lib/@vibe/builtin/builtin_traits.vibe`
/// spells `to_string[T: Show](x: T)`, but no `trait Show { .. }` declaration
/// exists anywhere and `register_builtin_traits` (checker_trait.vibe) does not
/// register one, so the bound is vacuous. That has to STAY vacuous: the moment
/// a trait carries a method the checker enforces its impls, and `to_string` is
/// a universal function -- a real `trait Show { to_string(Self) -> String }`
/// turns `to_string(5)` into a hard `no impl 'Show' for 'Int'` (measured).
///
/// So the trait is injected HERE and nowhere else. This pass collects traits
/// from the STATEMENT LIST (`collect_method_traits`); the checker enforces
/// impls from its OWN env. Injecting into the former and not the latter buys
/// the dictionary threading with none of the enforcement.
///
/// The witness is total by construction -- `build_concrete_dict` falls back to
/// the ADR-0058 `__to_string` heuristic for a type with no `C::to_string` --
/// so nothing that compiles today stops compiling, and a value whose type this
/// pass cannot resolve renders exactly as it does now.
fn synthetic_show_sigs() -> Array[(String, Array[TypeExpr], TypeExpr)] {
  [("to_string", [TyName("Self")], TyName("String"))]
}

fn bounds_mention_show(bounds: Array[(String, Array[String])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) {
    let (_, trait_list) = Array::get(bounds, i)
    if str_array_contains(trait_list, "Show") {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Whether this program has a `[T: Show]` bound worth threading a witness for.
///
/// The `__to_string` pass-through shims are excluded (`collect_show_shims` must
/// have run first): they never render THROUGH the witness -- their whole body
/// is the heuristic -- and threading them would put a hidden dict parameter on
/// `to_string` itself, i.e. on every one of its call sites in the program.
/// Without that exclusion the prelude alone would activate this for every
/// compilation unit.
fn program_wants_show_dict(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut want = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, bounds, _, _, _, _) => if bounds_mention_show(bounds) && !str_array_contains(dtd_show_shims, fname) {
          want = true
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  want
}

/// `collect_method_traits` plus the synthetic `Show` entry when this program
/// wants it. A program that declares its own method-bearing `trait Show` keeps
/// that one verbatim -- the injection must never shadow a real declaration.
fn collect_method_traits_with_show(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let declared = collect_method_traits(stmts)
  match lookup_trait_sigs(declared, "Show") {
    Some(_) => declared,
    None => if program_wants_show_dict(stmts) {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(declared) {
        Array::push(out, Array::get(declared, i))
        i = i + 1
      }
      Array::push(out, ("Show", synthetic_show_sigs()))
      out
    } else {
      declared
    }
  }
}

// ---- rank-1 method generics (#684) ----
//
// A trait method may declare its own type parameters, `m: [X: Show](Self, X) ->
// R`. The binder lives on the TRAIT method only (STrait's 5th field); the impl
// `impl Tr for C { m = (self, x) -> {..} }` does NOT repeat it and parses to a
// top-level `SLet(_, _, "C::m", _, EFn([], [], [(self,None),(x,None)], ..))`.
// `inject_method_generics` re-attaches the trait method's `[X: Show]` binder to
// the impl's free function and annotates the unannotated params with the trait
// method's declared param types. After injection `build_gens` sees `x: X`,
// registers `C::m` as a Show-bounded generic, and the existing dict-passing
// machinery threads/synthesizes the `Show` witness at qualified call sites.

fn empty_method_gens() -> Array[(String, Array[String], Array[(String, Array[String])])] {
  array_empty()
}

/// Collect every trait's per-method generic binders (name -> [(method,
/// type_params, bounds)]) from STrait's 5th field. Only traits that declare a
/// non-empty binder on at least one method are kept, so this stays inert.
fn collect_trait_method_gens(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, _, method_gens, _) => {
        let mut any = false
        let mut j = 0
        while j < Array::length(method_gens) {
          let (_, tps, _) = Array::get(method_gens, j)
          if Array::length(tps) > 0 {
            any = true
          } else {
            ()
          }
          j = j + 1
        }
        if any {
          Array::push(out, (tname, method_gens))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Look up a method's `(type_params, bounds)` in a trait's method-gen table.
/// Returns None when the method has no binder (empty type_params).
fn lookup_method_gen(table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], trait_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(table) {
    let (tn, gens) = Array::get(table, i)
    if tn == trait_ref_name(trait_name) {
      let mut j = 0
      while j < Array::length(gens) {
        let (mname, tps, bounds) = Array::get(gens, j)
        if mname == method && Array::length(tps) > 0 {
          result = Some((tps, bounds))
          j = Array::length(gens)
        } else {
          j = j + 1
        }
      }
      i = Array::length(table)
    } else {
      i = i + 1
    }
  }
  result
}

/// Map each impl method owner to the trait it implements. Concrete applied
/// targets have a specialization-specific internal owner; generic and bare
/// targets keep their constructor owner.
fn collect_impl_trait_map(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, _, trait_name, target) => Array::push(out, (impl_method_owner(tparams, trait_name, target), trait_name)),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple
/// signature). Used to annotate the impl method's unannotated params so the
/// per-method type parameter `X` appears as `x: X`.
fn lookup_trait_method_param_types(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], trait_name: String, method: String) -> Option[Array[TypeExpr]] {
  match lookup_trait_sigs(traits, trait_name) {
    Some(sigs) => {
      let mut j = 0
      let mut result = None
      while j < Array::length(sigs) {
        let (mname, ptypes, _) = Array::get(sigs, j)
        if mname == method {
          result = Some(ptypes)
          j = Array::length(sigs)
        } else {
          j = j + 1
        }
      }
      result
    },
    None => None
  }
}

/// Find the trait, among those `type_name` implements, that declares a
/// method-level binder for `method`. Returns its (type_params, bounds, param
/// types) so the impl method can be re-typed.
fn find_method_generic_for_impl(impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], type_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(impl_map) {
    let (tn, trait_name) = Array::get(impl_map, i)
    if tn == type_name {
      match lookup_method_gen(gen_table, trait_name, method) {
        Some(g) => {
          let (tps, bounds) = g
          match lookup_trait_method_param_types(traits, trait_name, method) {
            Some(ptypes) => {
              result = Some((tps, bounds, ptypes))
              i = Array::length(impl_map)
            },
            None => {
              i = i + 1
            }
          }
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  result
}

/// Annotate each parameter whose annotation is None with the trait method's
/// declared param type (when one exists at that index). Already-annotated params
/// keep their annotation.
fn annotate_params_from_sig(params: Array[(String, Option[TypeExpr])], ptypes: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    let new_ann = match ann {
      Some(_) => ann,
      None => if i < Array::length(ptypes) {
        Some(Array::get(ptypes, i))
      } else {
        None
      }
    }
    Array::push(out, (pname, new_ann))
    i = i + 1
  }
  out
}

/// In-place: for each impl method `C::m` whose trait declares a method-level
/// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params
/// with the trait method's declared types. Idempotent: an EFn that already
/// carries type_params was injected on a prior run and is skipped.
fn inject_method_generics_reporting_change(stmts: Array[Stmt], impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Bool {
  let mut changed = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, isrec, qname, ann, body) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {
          match split_qualified(qname) {
            Some(parts) => {
              let (cname, method) = parts
              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {
                Some(g) => {
                  let (mtparams, mtbounds, ptypes) = g
                  let new_params = annotate_params_from_sig(params, ptypes)
                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)
                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))
                  changed = true
                },
                None => ()
              }
            },
            None => ()
          }
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  changed
}

/// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a
/// (possibly flattened) method-trait table for param-type lookup. Inert and
/// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`
/// (so the FS-compile path, which type-checks before the desugar runs, also sees
/// the binder and can resolve `X::method`).
fn inject_trait_method_generics_with_reporting_change(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Bool {
  let method_gen_table = collect_trait_method_gens(stmts)
  if Array::length(method_gen_table) > 0 {
    let impl_map = collect_impl_trait_map(stmts)
    inject_method_generics_reporting_change(stmts, impl_map, method_gen_table, traits)
  } else {
    false
  }
}

/// Whether a value parameter can carry the witness for `name` through the
/// dictionary lowerer's supported receiver shapes. Keep this aligned with
/// find_recv_index / find_constructor_recv_index / find_array_elem_recv_index:
/// a nested occurrence (for example `(Int) -> Self`) is not recoverable.
fn trait_operation_type_is_carrier(ty: TypeExpr, name: String, stmts: Array[Stmt]) -> Bool {
  let expanded = expand_constructor_alias(ty, stmts, Array::length(stmts) + 1)
  match expanded {
    TyName(current) => current == name,
    TyApp(head, args) => if head == name {
      true
    } else if head == "Array" && Array::length(args) == 1 {
      match Array::get(args, 0) {
        TyName(current) => current == name,
        _ => false
      }
    } else {
      false
    },
    TyFn(_, _, _) => false,
    TyTuple(_) => false,
    TyUnit => false
  }
}

fn trait_operation_params_have_carrier(params: Array[TypeExpr], name: String, stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) && !found {
    found = trait_operation_type_is_carrier(Array::get(params, i), name, stmts); i = i + 1
  }
  found
}

fn trait_operation_type_mentions(ty: TypeExpr, name: String) -> Bool {
  match ty {
    TyName(current) => current == name,
    TyApp(head, args) => {
      let mut found = head == name
      let mut i = 0
      while i < Array::length(args) && !found {
        found = trait_operation_type_mentions(Array::get(args, i), name)
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = trait_operation_type_mentions(ret, name)
      let mut i = 0
      while i < Array::length(params) && !found {
        found = trait_operation_type_mentions(Array::get(params, i), name)
        i = i + 1
      }
      found
    },
    TyTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) && !found {
        found = trait_operation_type_mentions(Array::get(items, i), name)
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

fn trait_operation_surface_mentions(params: Array[TypeExpr], ret: TypeExpr, name: String) -> Bool {
  let mut found = trait_operation_type_mentions(ret, name)
  let mut i = 0
  while i < Array::length(params) && !found {
    found = trait_operation_type_mentions(Array::get(params, i), name)
    i = i + 1
  }
  found
}

fn trait_operation_method_shadows(method_params: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(method_params) && !found {
    found = type_param_name(Array::get(method_params, i)) == name
    i = i + 1
  }
  found
}

fn trait_operation_fresh_self_param(base: String, header_params: Array[String], method_params: Array[String]) -> String {
  let mut candidate = base
  let mut suffix = 1
  while trait_operation_method_shadows(header_params, candidate) || trait_operation_method_shadows(method_params, candidate) {
    candidate = String::concat(base, String::concat("_", __to_string(suffix)))
    suffix = suffix + 1
  }
  candidate
}

fn trait_operation_shadows_header(method_params: Array[String], header_params: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(header_params) && !found {
    found = trait_operation_method_shadows(method_params, type_param_name(Array::get(header_params, i)))
    i = i + 1
  }
  found
}

fn trait_operation_substitute_self(ty: TypeExpr, replacement: String) -> TypeExpr {
  match ty {
    TyName(name) => if name == "Self" {
      TyName(replacement)
    } else {
      ty
    },
    TyApp(head, args) => TyApp(if head == "Self" {
      replacement
    } else {
      head
    }, for arg in args {
      trait_operation_substitute_self(arg, replacement)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      trait_operation_substitute_self(param, replacement)
    }, trait_operation_substitute_self(ret, replacement), effect),
    TyTuple(items) => TyTuple(for item in items {
      trait_operation_substitute_self(item, replacement)
    }),
    TyUnit => TyUnit
  }
}

fn trait_operation_binding_exists(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, i) {
      SLet(_, _, current, _, _) => if current == name {
        found = true
      } else {
        ()
      },
      SFnDecl(_, current, _, _, _) => if current == name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_dict_already_materialized(stmts: Array[Stmt], trait_name: String) -> Bool {
  let dict_name = String::concat(trait_name, "Dict")
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => if name == dict_name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_method_generics(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], method_index: Int, method_name: String) -> (Array[String], Array[(String, Array[String])]) {
  if method_index < Array::length(method_gens) {
    let (source_name, params, bounds) = Array::get(method_gens, method_index)
    if source_name == method_name {
      (params, bounds)
    } else {
      (array_empty(), array_empty())
    }
  } else {
    (array_empty(), array_empty())
  }
}

fn trait_operation_bound_key(trait_name: String, header_params: Array[String]) -> String {
  if Array::length(header_params) == 0 {
    trait_ref_key(TyName(trait_name))
  } else {
    trait_ref_key(TyApp(trait_name, for param in header_params {
      TyName(type_param_name(param))
    }))
  }
}

fn trait_operation_param_name(ty: TypeExpr, index: Int, dispatch: String) -> String {
  if index == 0 {
    match ty {
      TyName(name) => if name == dispatch {
        "self"
      } else {
        "arg_0"
      },
      TyApp(head, _) => if head == dispatch {
        "xs"
      } else {
        "arg_0"
      },
      _ => "arg_0"
    }
  } else match ty {
    TyFn(_, _, _) => String::concat("f_", __to_string(index)),
    _ => String::concat("arg_", __to_string(index))
  }
}

/// Derive public `Trait::operation` wrappers without introducing bare names.
export fn derive_trait_namespace_operations(stmts: Array[Stmt]) -> Unit {
  let additions = array_empty()
  let original_len = Array::length(stmts)
  let mut i = 0
  while i < original_len {
    match Array::get(stmts, i) {
      STrait(exported, trait_name, _, methods, method_gens, header_params) => {
        let mut mi = 0
        while mi < Array::length(methods) {
          let (method_name, raw_params, raw_ret) = Array::get(methods, mi)
          let operation_name = String::concat(trait_name, String::concat("::", method_name))
          if !trait_operation_binding_exists(stmts, operation_name) && !trait_operation_dict_already_materialized(stmts, trait_name) {
            let (method_params, method_bounds) = trait_operation_method_generics(method_gens, mi, method_name)
            let self_param = trait_operation_fresh_self_param(String::concat("__trait_operation_self_", String::concat(trait_name, String::concat("_", method_name))), header_params, method_params)
            let shadows_header = trait_operation_shadows_header(method_params, header_params)
            let uses_self = !shadows_header && trait_operation_params_have_carrier(raw_params, "Self", stmts)
            let surface_mentions_self = trait_operation_surface_mentions(raw_params, raw_ret, "Self")
            let mut dispatch = if uses_self {
              self_param
            } else {
              ""
            }
            let mut dispatch_key = dispatch
            let mut hi = 0
            // A trait parameter can dispatch an operation whose entire surface
            // is independent of the implementation target (`Mappable::map`).
            // It must never stand in for `Self`: `impl Factory[Int] for Box`
            // does not make `Int` the receiver of `Factory::build`.
            while hi < Array::length(header_params) && dispatch == "" && !shadows_header && !surface_mentions_self {
              let candidate_key = Array::get(header_params, hi)
              let candidate = type_param_name(candidate_key)
              if trait_operation_params_have_carrier(raw_params, candidate, stmts) {
                dispatch = candidate; dispatch_key = candidate_key
              } else {
                ()
              }
              hi = hi + 1
            }
            if dispatch != "" {
              let synthetic_off = 2000000000 - i * 1000 - mi * 10
              let extra_params = if uses_self {
                [self_param]
              } else {
                array_empty()
              }
              let type_params = Array::concat(Array::concat(header_params, method_params), extra_params)
              let bounds = Array::concat(method_bounds, [
                (dispatch_key, [
                  trait_operation_bound_key(trait_name, header_params)
                ])
              ])
              let value_params = array_empty()
              let call_args = array_empty()
              let mut pi = 0
              while pi < Array::length(raw_params) {
                let param_ty = trait_operation_substitute_self(Array::get(raw_params, pi), dispatch)
                let param_name = trait_operation_param_name(param_ty, pi, dispatch)
                Array::push(value_params, (param_name, Some(param_ty)))
                Array::push(call_args, EIdent(param_name, synthetic_off + pi + 1))
                pi = pi + 1
              }
              let ret = trait_operation_substitute_self(raw_ret, dispatch)
              let body = ECall(EIdent(String::concat(dispatch, String::concat("::", method_name)), synthetic_off), call_args, synthetic_off)
              Array::push(additions, SLet(exported, true, operation_name, None, EFn(type_params, bounds, value_params, Some(ret), None, body)))
            } else {
              ()
            }
          } else {
            ()
          }
          mi = mi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let mut insertion = 0
  let mut si = 0
  while si < original_len {
    match Array::get(stmts, si) {
      STrait(_, _, _, _, _, _) => {
        insertion = si + 1
      },
      SImpl(_, _, _, _) => {
        insertion = si + 1
      },
      _ => ()
    }
    si = si + 1
  }
  while insertion < original_len {
    match Array::get(stmts, insertion) {
      SLet(_, _, _, _, _) => {
        insertion = insertion + 1
      },
      SFnDecl(_, _, _, _, _) => {
        insertion = insertion + 1
      },
      _ => break
    }
  }
  let ordered = array_empty()
  si = 0
  while si < original_len {
    if si == insertion {
      let mut ai = 0; while ai < Array::length(additions) {
        Array::push(ordered, Array::get(additions, ai)); ai = ai + 1
      }
    } else {
      ()
    }
    Array::push(ordered, Array::get(stmts, si))
    si = si + 1
  }
  if insertion == original_len {
    let mut ai = 0; while ai < Array::length(additions) {
      Array::push(ordered, Array::get(additions, ai)); ai = ai + 1
    }
  } else {
    ()
  }
  let mut oi = 0
  while oi < Array::length(ordered) {
    if oi < original_len {
      Array::set(stmts, oi, Array::get(ordered, oi))
    } else {
      Array::push(stmts, Array::get(ordered, oi))
    }; oi = oi + 1
  }
}

fn imported_trait_operation_additions(items: Array[ImportItem], env: TypeEnv, stmts: Array[Stmt], additions: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    let local_name = match item.alias {
      Some(alias) => alias,
      None => item.name
    }
    match trait_definition(env, local_name) {
      Some((supers, methods, params, method_gens)) => {
        let probe = [
          STrait(false, local_name, supers, methods, method_gens, params)
        ]
        derive_trait_namespace_operations(probe)
        let mut pi = 1
        while pi < Array::length(probe) {
          match Array::get(probe, pi) {
            SLet(_, _, operation_name, _, _) => if !trait_operation_binding_exists(stmts, operation_name) && !trait_operation_binding_exists(additions, operation_name) {
              Array::push(additions, Array::get(probe, pi))
            } else {
              ()
            },
            _ => ()
          }
          pi = pi + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
}

/// Materialize non-exported `Trait::operation` wrappers from the trait
/// declarations selected by this module's imports. The trait is the authority:
/// callers import only `trait Trait`, while bare operation names stay absent.
export fn derive_imported_trait_namespace_operations(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let additions = array_empty()
  let original_len = Array::length(stmts)
  let mut i = 0
  while i < original_len {
    match Array::get(stmts, i) {
      SImport(_, items) => imported_trait_operation_additions(items, env, stmts, additions),
      SReExport(_, items) => imported_trait_operation_additions(items, env, stmts, additions),
      SModule(_, _, body) => derive_imported_trait_namespace_operations(body, env),
      _ => ()
    }
    i = i + 1
  }
  let ordered = array_empty()
  let mut ai = 0
  while ai < Array::length(additions) {
    Array::push(ordered, Array::get(additions, ai))
    ai = ai + 1
  }
  i = 0
  while i < original_len {
    Array::push(ordered, Array::get(stmts, i))
    i = i + 1
  }
  i = 0
  while i < Array::length(ordered) {
    if i < original_len {
      Array::set(stmts, i, Array::get(ordered, i))
    } else {
      Array::push(stmts, Array::get(ordered, i))
    }
    i = i + 1
  }
}

fn inject_trait_method_generics_with(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {
  let _changed = inject_trait_method_generics_with_reporting_change(stmts, traits)
  ()
}

/// Self-contained entry for callers that have not flattened the trait table
/// (the checker). Builds its own (flattened) method-trait table from `stmts`.
export fn inject_trait_method_generics_reporting_change(stmts: Array[Stmt]) -> Bool {
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw, supers_map)
  inject_trait_method_generics_with_reporting_change(stmts, traits)
}

export fn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit {
  let _changed = inject_trait_method_generics_reporting_change(stmts)
  ()
}

// #1324 removed the #760(2) `inject_prelude_result` pass (and its
// `*_mentions_result` walkers). `Result` was never a built-in type
// constructor -- it was the ordinary user enum `enum Result[T, E] { Ok(T);
// Err(E) }`, appended here to any program that mentioned `Ok`/`Err`/
// `Result[..]` and did not declare or import its own. With the prelude
// definition gone (slice 4) and `Exception[E]` rows carrying failure
// instead, a program that wants that enum now declares it like any other.

//# #1374: the runtime exception-kind side channel
//
// ADR-0085 lowers EVERY exception spelling to one abortive Wasm tag with no
// kind discriminator, and the erased `Error` spelling is deliberately
// compatible with every kind (that is what kept #1344 additive over #786's
// suberror throws). So `handle { .. } with Exception { Throw(m) => .. }` also
// catches a typed `Exception[E]` throw, and `m`'s static type there is
// `CtUnknown` -- using it as a String type-checks, then misreads an enum
// pointer as a packed `(ptr<<32)|len` string. Measured on #1372: a whole data
// segment written to stderr, and a `String::length` of 2129 on a `Closed`
// payload. PR #1375 stopped the arbitrary-memory read by routing both sinks
// through `__to_string`; it could not tell the two cases apart, so a non-String
// payload printed as a bare decimal.
//
// The channel: a one-slot module-level cell, written immediately before every
// `perform <Exception>::Throw(v)` with the payload's statically resolved type
// name, read back by `__exn_kind()`. The payload's representation is untouched,
// so every existing handler keeps working unchanged -- purely additive.
//
// Why a module-level `let` array rather than a new wasm global or a new pair of
// builtins: the cell is ordinary vibe AST, so it rides the already-verified
// module-let path (initialized once, one shared identity, mutations visible
// across accesses -- fixtures/module_let_memo_test.vibe pins exactly these
// three properties) and needs no new emission in EITHER backend, so the linear
// and wasm-gc lanes cannot desynchronize on it.
//
// Why ONE slot is enough. The window between the write and the handler's read
// is a single abortive unwind, and nothing else runs inside it:
//   - `Error` is non-resumable (#640), so the unwind never returns to the throw
//     site and no code after the write executes before the handler.
//   - the ADR-0076 task pump re-enters a task only at a suspend point, never
//     mid-unwind, so a sibling task cannot interleave a write.
//   - a nested throw (a throw inside a handler arm) writes before it unwinds
//     and is read by ITS handler first, which is the correct innermost-wins
//     order.
// A handler that stores the payload and inspects the kind LATER is outside that
// window and must read `__exn_kind()` in the arm itself. Both sinks below do.

fn exn_kind_cell_name() -> String {
  "__exn_kind_cell"
}

/// The two-slot cell, appended to the program on demand.
///
/// `[0]` = the payload's static TYPE name (#1374). `[1]` = the payload
/// RENDERED at the throw site (#1392 slice 3): the kind alone tells an erased
/// arm that the payload is not text, but not what it says, and the arm cannot
/// recover that itself -- its binder's static type is `CtUnknown`, so neither a
/// `T::to_string` call nor a `[T: Show]` witness can be resolved there. The
/// throw site is the one place the type IS known, so it renders there and the
/// arm reads the string.
fn exn_kind_cell_stmt() -> Stmt {
  SLet(false, false, exn_kind_cell_name(), None, EArray([
    EString(""),
    EString("")
  ]))
}

/// What `__exn_kind()` lowers to. Exported because the compiler-synthesized
/// entry boundary (`wrap_entry_exception_boundary`) is built AFTER this pass and
/// so has to spell the lowered form itself.
export fn exn_kind_read_expr() -> Expr {
  ECall(EIdent("Array::get", -1), [EIdent(exn_kind_cell_name(), -1), EInt(0)], -1)
}

fn exn_kind_write_expr(kind: String) -> Expr {
  ECall(EIdent("Array::set", -1), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(0),
    EString(kind)
  ], -1)
}

/// What `__exn_message()` lowers to. Exported for the same reason
/// `exn_kind_read_expr` is: the entry boundary is synthesized after this pass.
export fn exn_msg_read_expr() -> Expr {
  ECall(EIdent("Array::get", -1), [EIdent(exn_kind_cell_name(), -1), EInt(1)], -1)
}

fn exn_msg_write_expr(rendered: Expr) -> Expr {
  ECall(EIdent("Array::set", -1), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(1),
    rendered
  ], -1)
}

/// Append the cell unless the program already declares it. Idempotent, and
/// callable from any pass that needs the cell to exist (the entry boundary
/// synthesizes a reader after this pass has already run).
export fn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit {
  if exn_kind_cell_present(stmts) {
    ()
  } else {
    Array::push(stmts, exn_kind_cell_stmt())
  }
}

/// Install the process boundary for an entry whose declared row carries
/// `Exception` (including the legacy `Error` alias and typed exceptions).
///
/// An escaping throw is not an ordinary return value. The old boundary
/// diagnosed it and returned `1`, which worked only for hosts that invoked the
/// entry export directly. Hosts that execute the conventional result-less
/// `_start` dropped that value and reported success. Trap after emitting the
/// diagnostic instead: every core/component launcher already maps a wasm trap
/// to a non-zero process status, while an inner handler still prevents this
/// boundary from running.
export fn wrap_entry_exception_boundary(stmts: Array[Stmt], entry_name: String) -> Unit {
  let mut i = 0
  let mut wrapped_any = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name && entry_row_has_exception(eff) {
        let payload_name = dinsp_fresh_name("__entry_err_msg", body, body)
        let kind_name = dinsp_fresh_name("__entry_err_kind", body, body)
        let rendered_name = dinsp_fresh_name("__entry_err_rendered", body, body)
        let kind_ident = EIdent(kind_name, -1)
        let msg_ident = EIdent(rendered_name, -1)
        let printable = EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("")
        ], -1), EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("String")
        ], -1), ECall(EIdent("String::equals", -1), [kind_ident, EString("Int")], -1)))
        let rendered_ok = EBinOp("!=", ECall(EIdent("String::length", -1), [
          msg_ident
        ], -1), EInt(0))
        let text = EIf(printable, ECall(EIdent("__to_string", -1), [
          EIdent(payload_name, -1)
        ], -1), EIf(rendered_ok, msg_ident, ECall(EIdent("String::concat", -1), [
          EString("<"),
          ECall(EIdent("String::concat", -1), [kind_ident, EString(">")], -1)
        ], -1)))
        let fail = ECall(EIdent("assert_true", -1), [EBool(false)], -1)
        let diag = ELet(kind_name, exn_kind_read_expr(), ELet(rendered_name, exn_msg_read_expr(), ESeq(ECall(EIdent("Stderr::write_stream", -1), [
          EString("vibe: uncaught error: ")
        ], -1), ESeq(ECall(EIdent("Stderr::write_stream", -1), [text], -1), ESeq(ECall(EIdent("Stderr::write_stream", -1), [
          EString("\n")
        ], -1), fail))), -1), -1)
        let wrapped = EHandle(body, [
          (PCtor("Exception::Throw", [PBind(payload_name)]), diag)
        ])
        Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))
        wrapped_any = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if wrapped_any {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
}

fn entry_row_has_exception(eff: Option[String]) -> Bool {
  match eff {
    Some(row) => {
      let mut found = false
      let mut start = 0
      let n = String::length(row)
      let mut i = 0
      while i <= n {
        let at_sep = if i == n {
          true
        } else {
          String::char_code_at(row, i) == 44
        }
        if at_sep {
          if is_exception_effect_name(String::trim(String::substring(row, start, i))) {
            found = true
          }
          start = i + 1
        }
        i = i + 1
      }
      found
    },
    None => false
  }
}

fn exn_kind_cell_present(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => if n == exn_kind_cell_name() {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Pass state for the rewrite below, reset at every `desugar_trait_dicts`
/// entry (the same discipline `set_throw_kind_table` uses in the checker, and
/// for the same reason -- state must never survive into the next program).
///
/// `[0]` = suppressed: the cell is already declared, so an earlier run of this
/// pass on the same program already wrapped every throw. Re-wrapping would nest
/// a second, redundant write inside the first one's `ESeq`. `[1]` = used: at
/// least one throw was wrapped or one `__exn_kind()` was lowered, so the cell
/// has to be appended once the rewrite loop finishes. `[2]` = the payload-temp
/// counter, so each wrapped throw binds its payload under a name of its own.
let dtd_exn_kind_state = [0, 0, 0]

fn exn_kind_suppressed() -> Bool {
  Array::get(dtd_exn_kind_state, 0) == 1
}

fn exn_kind_mark_used() -> Unit {
  Array::set(dtd_exn_kind_state, 1, 1)
}

/// A payload-temp name no other throw site shares. Lexical scoping alone would
/// make one fixed name correct (an inner throw's binding closes before the
/// outer one binds), but a distinct name per site keeps that from being a fact
/// the reader has to re-derive, and keeps the nesting legible in dumped IR.
fn exn_kind_fresh_payload_name() -> String {
  let n = Array::get(dtd_exn_kind_state, 2)
  Array::set(dtd_exn_kind_state, 2, n + 1)
  String::concat("__exn_payload", __to_string(n))
}

/// `perform <Error|Exception[K]>::Throw(payload)` -- the ONLY shape `throw(x)`
/// lowers to (#640 Stage 2), and the only one that reaches the abortive tag.
fn is_perform_throw_shape(callee: Expr, args: Array[Expr]) -> Bool {
  let head = match callee {
    EIdent(n, _) => n == "perform",
    _ => false
  }
  if head && Array::length(args) == 1 {
    match Array::get(args, 0) {
      ECall(op_callee, oargs, _) => match op_callee {
        EIdent(op_n, _) => is_exception_throw_operation(op_n) && Array::length(oargs) == 1,
        _ => false
      },
      _ => false
    }
  } else {
    false
  }
}

/// A nullary `__exn_kind()` call.
fn is_exception_kind_read(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__exn_kind" && Array::length(args) == 0,
    _ => false
  }
}

/// A nullary `__exn_message()` call.
fn is_exception_message_read(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__exn_message" && Array::length(args) == 0,
    _ => false
  }
}

fn perform_throw_payload(args: Array[Expr]) -> Expr {
  match Array::get(args, 0) {
    ECall(_, oargs, _) => Array::get(oargs, 0),
    _ => EUnit
  }
}

/// `perform_throw_payload`'s inverse: the same `perform Throw(..)` shape with
/// the payload swapped for `payload`. Used to hoist the payload into a `let`
/// so the kind write happens after it is evaluated (#1374).
fn perform_throw_with_payload(args: Array[Expr], payload: Expr) -> Array[Expr] {
  match Array::get(args, 0) {
    ECall(op_callee, _, ooff) => [ECall(op_callee, [payload], ooff)],
    _ => args
  }
}

/// Collect each trait's declared supertraits (`trait B: A + ...`), for all
/// traits (method-bearing or not), so a method-bearing trait can inherit its
/// supertraits' methods.
fn collect_trait_supers(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, supers, _, _, _) => Array::push(out, (tname, supers)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_supers(supers_map: Array[(String, Array[String])], name: String) -> Array[String] {
  let mut i = 0
  let mut result = empty_str_array()
  while i < Array::length(supers_map) {
    let (tname, supers) = Array::get(supers_map, i)
    if tname == trait_ref_name(name) {
      result = supers
      i = Array::length(supers_map)
    } else {
      i = i + 1
    }
  }
  result
}

/// Flatten a trait's method signatures with those of its (transitive) method-
/// bearing supertraits, deduplicating by method name, so `[T: B]` for
/// `trait B: A` can dispatch both B's and A's methods through one flat witness
/// dictionary. `acc_names` / `out` accumulate across the recursion.
///
/// Supertrait methods are emitted BEFORE the trait's own, so an inherited method
/// keeps the same field index in every dict that contains it (e.g. `measure`
/// is index 0 in both `MeasurableDict` and `SizedDict`). This matters because
/// codegen resolves `dict.field` by a global first-match field-name search
/// (compile_expr_tail4.vibe), not by the object's static type — so a shared
/// field name must sit at a consistent index across structs. (Single supertrait
/// chains only; multiple-supertrait ordering is a deferred slice.)
/// `owners` records `(method name, the trait that DECLARES it)` in lockstep
/// with `out`. A flattened list copies a supertrait's methods into the child,
/// so the dict struct's owner is not the declaring trait of every field --
/// see `synthesized_dict_field_trait` (#2286, Codex review on #2313).
fn flatten_trait_sigs_into(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])], acc_names: Array[String], out: Array[(String, Array[TypeExpr], TypeExpr)], owners: Array[(String, String)]) -> Unit {
  let supers = lookup_supers(supers_map, tname)
  let mut s = 0
  while s < Array::length(supers) {
    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out, owners)
    s = s + 1
  }
  match lookup_trait_sigs(traits_raw, tname) {
    Some(sigs) => {
      let mut i = 0
      while i < Array::length(sigs) {
        let (mname, params, ret) = Array::get(sigs, i)
        if str_array_contains(acc_names, mname) {
          ()
        } else {
          Array::push(acc_names, mname)
          Array::push(out, (mname, params, ret))
          Array::push(owners, (mname, tname))
        }
        i = i + 1
      }
    },
    None => ()
  }
}

/// Produce a method-trait table whose signatures are flattened across
/// supertraits, so all downstream code (dict struct, dispatch names, witness
/// materialization) sees one flat method set per trait.
fn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(traits_raw) {
    let (tname, _) = Array::get(traits_raw, i)
    let acc_names = empty_str_array()
    let flat = array_empty()
    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat, array_empty())
    Array::push(out, (tname, flat))
    i = i + 1
  }
  out
}

/// First `value` for `key`, or `fallback`. `owners` is built in lockstep with
/// the flattened sigs, so a miss means the two went out of step -- falling back
/// to the dict's own trait keeps the label a real trait name either way.
fn lookup_str_pair(pairs: Array[(String, String)], key: String, fallback: String) -> String {
  let mut i = 0
  let mut found = fallback
  while i < Array::length(pairs) {
    let (k, v) = Array::get(pairs, i)
    if k == key {
      found = v
      i = Array::length(pairs)
    } else {
      i = i + 1
    }
  }
  found
}

/// Which trait DECLARES each method of `tname`'s flattened set.
///
/// Not a second implementation of the flattening rule: it runs
/// `flatten_trait_sigs_into`, the same recursion `flatten_traits` runs, and
/// reads the owner list it fills. A mirror of the rule would drift the first
/// time an override or a diamond changed which declaration wins.
fn flatten_trait_owners(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, String)] {
  let owners = array_empty()
  flatten_trait_sigs_into(tname, traits_raw, supers_map, empty_str_array(), array_empty(), owners)
  owners
}

fn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] {
  let mut i = 0
  let mut result = None
  while i < Array::length(traits) {
    let (tname, sigs) = Array::get(traits, i)
    if tname == trait_ref_name(name) {
      result = Some(sigs)
      i = Array::length(traits)
    } else {
      i = i + 1
    }
  }
  result
}

/// Collect user struct field-name sets, for inferring a struct-literal's type
/// (the parser discards the `Name::` prefix of `Name::{ ... }`).
fn collect_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let names = empty_str_array()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, j)
          Array::push(names, fname)
          j = j + 1
        }
        Array::push(out, (sname, names))
      },
      // #672: also record enum names (with an EMPTY field set, so the ERecord
      // field-set match never confuses an enum with a struct literal) so the
      // `==` dispatch's `struct_set_has` gate accepts enum operands too.
      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Build the witness struct `TrDict { m: (Self) -> R; ... }` for a trait. The
/// `Self` placeholder in the signatures stays verbatim — struct type params are
/// erased, so the field-access typing is structural (proven in spike G-3).
fn make_dict_struct_stmt(trait_name: String, sigs: Array[(String, Array[TypeExpr], TypeExpr)], tparams: Array[String]) -> Stmt {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(sigs) {
    let (mname, params, ret) = Array::get(sigs, i)
    Array::push(fields, (mname, TyFn(params, ret, None)))
    i = i + 1
  }
  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array(), tparams)
}

/// Two field-name sets describe the same struct shape when they have equal
/// length and every name in one appears in the other.
fn field_sets_match(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(a) {
      if str_array_contains(b, Array::get(a, i)) {
        i = i + 1
      } else {
        ok = false
        i = Array::length(a)
      }
    }
    ok
  }
}

/// Is `name` a known struct (a key in struct_sets)? Gates the #672 `==` dispatch.
fn struct_set_has(struct_sets: Array[(String, Array[String])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, _) = Array::get(struct_sets, i)
    if sname == name {
      found = true
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

/// Whether type `name` declares a field/variant called `member` (struct_sets
/// maps struct AND enum names to their field/variant name lists). Used to keep
/// a field-stored-function call `b.f(args)` as an EDot when the struct also
/// has a same-named `T::f` method candidate.
fn struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, members) = Array::get(struct_sets, i)
    if sname == name {
      let mut j = 0
      while j < Array::length(members) {
        if Array::get(members, j) == member {
          found = true
          j = Array::length(members)
        } else {
          j = j + 1
        }
      }
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

/// [robj, arg1, arg2, ...] — receiver prepended to the rewritten args for a
/// method-call rewrite (`xs.m(a)` -> `T::m(xs, a)`).
fn prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

fn lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {
  // `extend_var_types` APPENDS on each `let`, so a shadowing rebind adds a second
  // entry for the same name. Return the LAST match (the innermost binding in
  // scope) so `let r = record { a }; ...; let r = record { c }; r.c` resolves
  // against the inner shape rather than the stale outer one (#760(4)).
  let mut i = 0
  let mut result = None
  while i < Array::length(var_types) {
    let (vn, vt) = Array::get(var_types, i)
    if vn == name {
      result = Some(vt)
    } else {
      ()
    }
    i = i + 1
  }
  result
}

/// Best-effort syntactic inference of a call argument's concrete type, enough to
/// pick the trait impl at a concrete call site. Consults `var_types` (locals
/// bound to inferable values and parameters with concrete annotations). Returns
/// None when the type is not determinable (the call is then left unrewritten).
/// Resolve a (possibly qualified) constructor name to its enum/return type.
/// Bare `Green` -> `Color` via fn_returns; qualified `Color::Green` first tries
/// the whole name (no match) then the member `Green` confirming its enum equals
/// the head — so `let a = Color::Green` seeds `a -> Color` for `==` dispatch.
fn ctor_enum_of_name(fn_returns: Array[(String, String)], name: String) -> Option[String] {
  match fn_return_type(fn_returns, name) {
    Some(t) => Some(t),
    None => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        // #1491 (second site): ask whether `member` is a constructor of THIS
        // enum, not what `member`'s FIRST fn_returns entry returns.
        // Constructor names collide across enums, so the first-match form
        // answered about whichever enum sorted first and returned None for a
        // perfectly good `Color::Green` -- leaving the binding untyped, which
        // downstream means synth_dicts finds no witness and emits a call short
        // its dictionary argument. Same defect as `qual_ctor_member`, same
        // table, same fix.
        if fn_returns_has_type(fn_returns, member, head) {
          Some(head)
        } else {
          None
        }
      },
      None => None
    }
  }
}

/// #2128: `<name>.<i>` on a name whose tuple shape `tuple_shape_bind` recorded
/// -> element `i`'s type name. `None` when the field is not an index, the name
/// has no recorded tuple shape, the index is out of range, or the element's
/// type was not inferable (recorded as an EMPTY entry -- see
/// `tuple_shape_parts`, which preserves those so the entry count equals the
/// arity).
fn dtd_tuple_elem_type_name(obj: Expr, field: String, var_types: Array[(String, String)]) -> Option[String] {
  match obj {
    EIdent(n, _) => if constructor_binding_is_masked(var_types, n) {
      None
    } else match dtd_tuple_index_of(field) {
      Some(idx) => {
        let parts = match lookup_var_type(var_types, tuple_shape_key(n)) {
          Some(sentinel) => tuple_shape_parts(sentinel),
          // The recursive record answers for a name the per-tuple sentinel
          // never covered (one bound from an array element, say); the equality
          // sentinel answers for a tuple PARAMETER, which seeds only that one.
          None => {
            let from_shape = dtd_tuple_parts_of_shape(lookup_var_type(var_types, shape_key(n)))
            if Array::length(from_shape) > 0 {
              from_shape
            } else {
              dtd_tuple_parts_of_shape(lookup_var_type(var_types, eq_shape_key(n)))
            }
          }
        }
        {
          if idx >= 0 && idx < Array::length(parts) {
            let elem = Array::get(parts, idx)
            // A composite element is a SHAPE, not a type name -- `t.0.1` is not
            // a spelling this resolves, and handing a shape to the `<` rewrite
            // would name a type that does not exist.
            if String::length(elem) == 0 || dtd_shape_is_tuple(elem) {
              None
            } else {
              Some(elem)
            }
          } else {
            None
          }
        }
      },
      None => None
    },
    _ => None
  }
}

/// A tuple field is spelled as decimal digits (`t.0`). A struct field never is,
/// so digits-only is the whole test -- and it must be digits ONLY, or `.0x` on
/// a struct would read as index 0.
fn dtd_tuple_index_of(field: String) -> Option[Int] {
  let n = String::length(field)
  if n == 0 {
    None
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while i < n {
      let c = String::char_code_at(field, i)
      if c >= 48 && c <= 57 {
        acc = acc * 10 + (c - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(acc)
    } else {
      None
    }
  }
}

fn infer_arg_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arg {
    EInt(_) => Some("Int"),
    EBool(_) => Some("Bool"),
    EString(_) => Some("String"),
    EFloat(_) => Some("Double"),
    // String `+` chains: `"a" + b + "c"` infers String when EITHER side does
    // (the checker enforces both sides are String when one is). This both
    // types the concat rewrite below and lets a `let u = a + "x"` binding
    // record u -> String for downstream `u + ...`. Other `+` operands stay
    // None (no behavior change for numeric/unknown).
    EBinOp(bop, bl, br) => if bop == "+" {
      let lstr = match infer_arg_type_name(bl, struct_sets, var_types, fn_returns) {
        Some(t) => t == "String",
        None => false
      }
      let rstr = match infer_arg_type_name(br, struct_sets, var_types, fn_returns) {
        Some(t) => t == "String",
        None => false
      }
      if lstr || rstr {
        Some("String")
      } else {
        None
      }
    } else {
      None
    },
    // An array literal dispatches to an `impl [T] Trait for Array` witness
    // (#5 generic impls): its constructor is "Array" regardless of element type.
    EArray(_) => Some("Array"),
    // Same for a `map { ... }` literal: constructor "Map" (lets a let-bound
    // map resolve an `impl ... for Map` witness at a generic call site).
    EMap(_) => Some("Map"),
    // A variable's recorded type, else a (possibly qualified) nullary
    // constructor's enum name (`Green`/`Color::Green` -> `Color`) so that a
    // `let a = Green` / `let a = Color::Green` binding resolves for `==`. The
    // builtin nullary `None` resolves to the structural shape "Option" so a
    // `let a = None; ... a == b` dispatches structurally (#695).
    EIdent(name, _) => if name == "None" {
      Some("Option")
    } else {
      match lookup_var_type(var_types, name) {
        Some(t) => Some(t),
        None => ctor_enum_of_name(fn_returns, name)
      }
    },
    // #1341 (Codex P1 on #1369): a PROJECTION (`h.s`). The object's type name
    // plus the field name give the field's declared type head, via the
    // reserved fn_returns key seeded by collect_struct_field_types. Without
    // this, `for b in h.s` over a host stream fell through to the array loop
    // and iterated the 2-word `[state, handle]` cell -- returning 4 instead of
    // the body's bytes, with no diagnostic. It also makes `let s = h.s`
    // record `s -> HostStream` (extend_var_types runs infer_arg_type_name on
    // the bound value), so the bind-then-loop spelling works too.
    // #2128: a TUPLE projection (`t.0`) first. `struct_field_type_key` only
    // knows declared struct fields, so a tuple element fell through to None --
    // and an untyped operand is exactly what makes `<` compile to a raw i64
    // compare on the (ptr<<32)|len string repr, i.e. an ADDRESS comparison.
    // Measured: `let t = ("bbb", "aaa"); t.0 < t.1` answered by address, so
    // `a == b` and `a < b` could both be true for the same pair. The element
    // type is already recorded by `tuple_shape_bind`; this is the read side.
    EDot(obj, field, _, _) => match dtd_tuple_elem_type_name(obj, field, var_types) {
      Some(elem) => Some(elem),
      None => match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {
        Some(otype) => fn_return_type(fn_returns, struct_field_type_key(otype, field)),
        None => None
      }
    },
    // A call-valued iterable (`for x in lazy_iter_arr([..])`) or data ctor
    // (`Sh::Circle(5)`): its type is the head of the callee's return type. The
    // builtin `Some`/`Ok`/`Err` constructors resolve to "Option"/"Result" so a
    // bare `==` on them dispatches structurally (#695).
    ECall(callee, cargs, _) => match callee {
      EIdent("Some", _) => Some("Option"),
      EIdent("Ok", _) => Some("Result"),
      EIdent("Err", _) => Some("Result"),
      // #1199 bug 1: `Array::get(arr, i)` / `arr[i]` (parses to `__index(arr,
      // i)`, #760(3)) on an Array-typed PARAMETER whose element type
      // seed_var_types recorded (array_elem_key) resolves to that element
      // type -- so `let v = Array::get(values, 0); some_hash_bounded_call(v)`
      // can find v's type the same way a direct `f[T: Hash](v: T)` parameter
      // already could. Without this, infer_arg_type_name fell through to the
      // generic EIdent(fname,_) => ctor_enum_of_name arm below, which knows
      // nothing about "Array::get"/"__index" and returns None -- silently
      // failing synth_dicts and emitting a call short its dictionary
      // argument(s) (invalid wasm) instead of a resolved or forwarded dict.
      EIdent("Array::get", _) => if Array::length(cargs) == 2 {
        match Array::get(cargs, 0) {
          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),
          _ => None
        }
      } else {
        None
      },
      EIdent("__index", _) => if Array::length(cargs) == 2 {
        match Array::get(cargs, 0) {
          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),
          _ => None
        }
      } else {
        None
      },
      // String-returning builtins (not in fn_returns): lets a
      // `String::concat(a, b) + c` / `__to_string(n) + s` operand type as
      // String for the concat rewrite.
      // #1341: the p3 host stream. Not in fn_returns (it is a builtin), and
      // its nominal type is what routes `for b in s` to the host read below
      // instead of to the array loop -- which used to iterate the 2-word cell.
      //
      // Codex P1 on #1369: projections (`for b in h.s`) are covered too --
      // see the EDot arm above, which reads the field's declared head from
      // the `Struct.field` entries collect_struct_field_types seeds into
      // fn_returns. Before that they fell back to the array loop and summed
      // the 2-word cell (measured: 4).
      //
      // Still true, and NOT closed here: the nominal type is a ROUTING KEY,
      // not an enforced barrier. `take_int(s)` with `s: HostStream`
      // type-checks (a `CtNamed` head is tolerated at argument positions,
      // nominal_head_conflict's concreteness gate), so applying an eager
      // Stream combinator to a host stream is not itself a type error.
      // Tightening argument-position nominal checking is cross-cutting work
      // beyond HostStream. Tracked on #1341.
      EIdent("host_stream_named", _) => Some("HostStream"),
      EIdent("String::concat", _) => Some("String"),
      EIdent("String::join", _) => Some("String"),
      EIdent("String::substring", _) => Some("String"),
      EIdent("String::trim", _) => Some("String"),
      EIdent("String::replace", _) => Some("String"),
      EIdent("String::from_char_code", _) => Some("String"),
      EIdent("__to_string", _) => Some("String"),
      // Bytes-returning builtins (not in fn_returns): Bytes has no literal
      // syntax, so `let b = Bytes::new()` is how every Bytes value is born --
      // recording b -> Bytes is what lets a bare `b1 == b2` dispatch to the
      // structural `__bytes_equals` (#1526) instead of the identity `eq`.
      EIdent("Bytes::new", _) => Some("Bytes"),
      EIdent("Bytes::concat", _) => Some("Bytes"),
      EIdent("Bytes::slice", _) => Some("Bytes"),
      // Map-returning builtins (not in fn_returns): lets `let m2 = Map::set(m,
      // k, v)` record m2 -> Map so a later `m2[k]` takes the #760(3) Map::get
      // rewrite. (A `map { }` literal is already classified as Map above.)
      EIdent("Map::set", _) => Some("Map"),
      EIdent("Map::remove", _) => Some("Map"),
      EIdent("Map::insert", _) => Some("Map"),
      EIdent("Map::delete", _) => Some("Map"),
      EIdent("MapBuilder::freeze", _) => Some("Map"),
      // Nominal ByteStream values retain an internal materialized lowering on
      // the linear backend. Classify them separately from guest AsyncIter so the
      // for-loop classification lowers it to the plain array loop instead of
      // the pull-closure loop (#822: the pull desugar called the stream value
      // as a closure — call_indirect on an array pointer = table OOB trap).
      EIdent("String::to_bytes", _) => Some("ByteStream"),
      EIdent(fname, _) => match lookup_var_type(var_types, local_fn_return_key(fname)) {
        Some(head) => Some(head),
        None => if constructor_binding_is_masked(var_types, fname) {
          None
        } else {
          ctor_enum_of_name(fn_returns, fname)
        }
      },
      // `let x: T = e` is desugared to `((__asc: T) -> __asc)(e)` (ascribe_wrap);
      // recover the operand's type head from the annotation so an annotated
      // `let a: Option[Int] = None` records `a -> "Option"` for `==` dispatch.
      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {
        let (_, ann) = Array::get(params, 0)
        match ann {
          Some(TyName(n)) => Some(n),
          Some(TyApp(n, _)) => Some(n),
          _ => None
        }
      } else {
        None
      },
      // #864: a UFCS method-chain call `x.method(args)` as the callee here means
      // `arg` itself IS `x.method(args)` (e.g. the receiver of an outer
      // `.and_then(...)` in `x.and_then(f).and_then(g)`, or a `let`-bound
      // `let b = x.and_then(f)` whose type feeds a later `b.is_ok()`). Without
      // this case the match fell through to `_ => None`, so the result type of
      // ANY UFCS call went untracked -- the EDot call-position rewrite below
      // (see the `as_recv_method` match on `EDot(obj, m, ...)`) then can't
      // infer the OUTER call's receiver type either, leaves the outer
      // `.method(...)` as a bare EDot, and codegen's EDot fallback (which only
      // understands genuine struct-field projections) throws "unknown struct
      // field: <method>" even though the checker -- which performs proper
      // type-directed `T::method` resolution independently in checker.vibe's
      // `EDot(obj, method, ...)` arm -- already accepted the same expression
      // as type-correct. Mirror that checker resolution here: infer the
      // receiver's type, then look up the qualified `Type::method` return
      // type, falling back to the bare method name (prelude functions like
      // `Result::and_then` / `and_then` register both forms in `fn_returns`).
      EDot(dobj, dmethod, _, _) => {
        let recv_tn = infer_arg_type_name(dobj, struct_sets, var_types, fn_returns)
        let qual_rt = match recv_tn {
          Some(tn) => fn_return_type(fn_returns, String::concat(tn, String::concat("::", dmethod))),
          None => None
        }
        match qual_rt {
          Some(rt) => Some(rt),
          None => fn_return_type(fn_returns, dmethod)
        }
      },
      _ => None
    },
    // #1529: when the literal NAMES its struct (`IntBox::{ v: 7 }`), that name
    // IS the answer. Re-deriving it from the field set picks the first struct
    // with a matching shape, which is a DIFFERENT type as soon as two structs
    // share a field set (`struct Plain { v: Int }` next to `struct IntBox
    // { v: Int }`). The wrong name found no `impl` for the trait, synth_dicts
    // silently produced nothing, and the call went out one argument short --
    // surfacing only at instantiate as `not enough arguments on the stack for
    // call`, naming neither the struct nor the call. Declaration order looked
    // like the trigger because it decides which same-shaped struct is first.
    //
    // #1839: the ANONYMOUS form (`ERecord("", ..)` — the explicit `record`
    // keyword) is structural and no longer captured by a same-field-set
    // struct anywhere (checker / codegen keep it literal-order, tag 0), so
    // reporting a struct NAME for it here would route `==` / to_string /
    // UFCS dispatch to that struct's methods, which would read the wrong
    // slots. Shape matching remains only for a NAMED literal whose name the
    // merged defs no longer contain (merge-layer private-struct rename).
    // #2266: `-999999` is EUnaryOp("-", EInt), not EInt. Without this arm the
    // expected side of `assert_eq(s, -999999)` rendered `<unprintable>`.
    EUnaryOp(op, inner) => if op == "-" || op == "+" {
      infer_arg_type_name(inner, struct_sets, var_types, fn_returns)
    } else {
      None
    },
    ERecord(rn, fields, _) => if String::length(rn) == 0 {
      None
    } else if struct_set_has(struct_sets, rn) {
      Some(rn)
    } else {
      let names = empty_str_array()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      let mut j = 0
      let mut result = None
      while j < Array::length(struct_sets) {
        let (sname, sfields) = Array::get(struct_sets, j)
        if field_sets_match(names, sfields) {
          result = Some(sname)
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      result
    },
    _ => None
  }
}

/// #973: known concrete/struct-like type names `infer_arg_type_name` can
/// report, for which the EXISTING per-type rewrites (String concat/relational,
/// struct `==`, Option/Result structural eq, ...) already apply, or correctly
/// do not. Anything else it returns `Some` for is, by construction, the bare
/// name of an in-scope generic type parameter: `seed_var_types` (and the `EFn`
/// arm of `rewrite_expr`) seed a parameter's own `[T]` annotation verbatim as
/// its "type name" — see #931's `as_tparam_dict`, which reuses the same
/// inference for method calls — and no other path in `infer_arg_type_name`
/// produces a non-concrete `Some`.
fn is_concrete_or_known_type_name(t: String, struct_sets: Array[(String, Array[String])]) -> Bool {
  t == "Int" || t == "Bool" || t == "String" || t == "Double" || t == "Float" || t == "Array" || t == "Map" || t == "Option" || t == "Result" || t == "ByteStream" || struct_set_has(struct_sets, t)
}

/// #973: does either operand's inferred static type look like an ERASED
/// generic type parameter (`[T: Ord]` / `[T: Add]`) rather than a concrete
/// type `infer_arg_type_name` already has type-specific handling for? Routes
/// `<`/`>`/`<=`/`>=`/`+` through a runtime tag-check dispatch instead of the
/// hardcoded numeric binop when the checker (#952) lets a bound-but-unresolved
/// `T` survive to codegen with NO monomorphization and NO witness dict — Ord
/// and Add are method-less marker traits (`export trait Ord` with an empty
/// body; see builtin_traits.vibe), so `build_gens` never threads either one a
/// dict (only method-bearing bounds get one), leaving nothing concrete to key
/// a String-vs-Int rewrite off at this site. Without this, `x < lo` inside a
/// `fn ord_clamp[T: Ord](x: T, lo: T, ..)` body compiled a raw signed i64
/// compare, which orders a heap String's packed `(ptr<<32)|len` value by
/// POINTER, not content (#973's `ord_clamp("m", "a", "z")` repro).
fn is_erased_generic_operand(l: Expr, r: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool {
  // #2141: an enclosing binder's formal is erased even when the (merged)
  // program declares a same-spelled type -- the formal shadows it, so the
  // concrete-name fast paths must not fire.
  let lg = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
    Some(t) => formal_in_scope(t) || !is_concrete_or_known_type_name(t, struct_sets),
    None => false
  }
  let rg = match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
    Some(t) => formal_in_scope(t) || !is_concrete_or_known_type_name(t, struct_sets),
    None => false
  }
  lg || rg
}

/// #760(3): `m[k]` parses to `__index(m, k)`, whose codegen array-indexes the
/// receiver — on a Map that reads its backing store as a positional array and
/// traps. Rewrite to `Map::get(m, k)` ONLY when the receiver is determinably
/// Map-typed (a `map { }` literal, or a binding/param annotated `Map[..]`,
/// which `infer_arg_type_name` reports as "Map"). A non-Map receiver — an
/// Array/Bytes/String, or an unknown — is left as `__index`, so array indexing
/// (and the type checker's rejection of e.g. `a["x"]` on an Array) is unchanged.
/// `rwargs` are the already-rewritten arguments to carry into the new call.
fn map_index_rewrite(callee: Expr, args: Array[Expr], rwargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] {
  match callee {
    EIdent(nm, _) => if nm == "__index" && Array::length(args) == 2 {
      let recv_map = match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
        Some(t) => t == "Map",
        None => false
      }
      if recv_map {
        Some(ECall(EIdent("Map::get", -1), rwargs, -1))
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #760(4): anonymous-record dot access `r.name`. A `record { .. }` literal whose
/// field-set matches NO declared struct is stored in LITERAL field order with tag
/// 0 (see compile_expr_tail4 ERecord); its `.field` reads reach codegen's EDot,
/// which resolves the slot only through declared structs (`struct_field_candidates`)
/// and therefore throws "unknown struct field". The record-pattern destructure
/// (`let record { name: n } = r`) already works because the parser lowers it to
/// positional `__rec_field(r, i)` reads (parser_expr_dispatch). This mirrors that:
/// we thread each anonymous-record binding's ordered field list through `var_types`
/// (as a `__anonrec:` sentinel) and rewrite `binding.field` to the same
/// `__rec_field(binding, slot)` positional read. A struct-matching record is left
/// alone — its literal is reordered to the struct's declared order and the EDot
/// struct-tag-dispatch path resolves it correctly.
fn anon_record_prefix() -> String {
  "__anonrec:"
}

/// #1878: compound sentinel for a TUPLE whose elements include anonymous
/// records — `__anontup:` + ';'-joined element entries, each either a full
/// `__anonrec:` sentinel or "" (untracked element). Record sentinels join
/// fields with ',', so ';' is unambiguous. One level only: a tuple nested
/// inside a tuple stays untracked, same scope as the parser's positional
/// sub-tuple destructure support.
fn anon_tuple_prefix() -> String {
  "__anontup:"
}

/// The `__anontup:` sentinel for a tuple literal's elements, or None when no
/// element is an anonymous record (nothing to track).
fn tuple_sentinel_from_exprs(items: Array[Expr]) -> Option[String] {
  let parts = empty_str_array()
  let mut any = false
  let mut i = 0
  while i < Array::length(items) {
    match Array::get(items, i) {
      ERecord(rn, fields, _) => if String::length(rn) == 0 {
        let names = empty_str_array()
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, _) = Array::get(fields, fi)
          Array::push(names, fname)
          fi = fi + 1
        }
        Array::push(parts, anon_record_sentinel(names))
        any = true
      } else {
        Array::push(parts, "")
      },
      _ => Array::push(parts, "")
    }
    i = i + 1
  }
  if any {
    Some(String::concat(anon_tuple_prefix(), String::join(parts, ";")))
  } else {
    None
  }
}

/// Split a `__anontup:` sentinel back into its per-element entries.
fn anon_tuple_elems(sentinel: String) -> Array[String] {
  String::split(sentinel[String::length(anon_tuple_prefix()): String::length(sentinel)], ";")
}

/// Encode an ordered field-name list as a `var_types` sentinel value.
fn anon_record_sentinel(names: Array[String]) -> String {
  let mut s = anon_record_prefix()
  let mut i = 0
  while i < Array::length(names) {
    if i > 0 {
      s = String::concat(s, ",")
    } else {
      ()
    }
    s = String::concat(s, Array::get(names, i))
    i = i + 1
  }
  s
}

/// The slot of `field` within a `__anonrec:` sentinel, or -1 if the string is not
/// a sentinel or does not carry `field`. Splits on `,` so a field name that is a
/// prefix of another (e.g. `ver` vs `version`) does not false-match.
fn anon_field_index(sentinel: String, field: String) -> Int {
  let prefix = anon_record_prefix()
  if !String::starts_with(sentinel, prefix) {
    -1
  } else {
    let mut rest = String::substring(sentinel, String::length(prefix), String::length(sentinel))
    let mut idx = 0
    let mut found = -1
    let mut go = true
    while go {
      let comma = String::index_of(rest, ",")
      let tok = if comma < 0 {
        rest
      } else {
        String::substring(rest, 0, comma)
      }
      if tok == field {
        found = idx
        go = false
      } else if comma < 0 {
        go = false
      } else {
        rest = String::substring(rest, comma + 1, String::length(rest))
        idx = idx + 1
      }
    }
    found
  }
}

/// If `val` is an explicit anonymous `record { .. }` literal (rn == ""), the
/// `__anonrec:` sentinel recording its literal field order; else None.
/// Threaded into `var_types` at `let`/`let mut` so a later `binding.field` on the
/// same name resolves positionally.
///
/// #1839: EVERY rn == "" literal gets the sentinel — it used to be withheld
/// when the field set matched a declared struct (leaving `.field` to the EDot
/// struct-table path), which was consistent only because codegen also
/// reordered such literals to the struct's declared order. That capture made
/// the parser's POSITIONAL record destructure read swapped values
/// (`let record { start: a, end: b } = record { start: 3, end: 9 }` bound
/// a = 9 whenever a same-field-set struct declared its fields in another
/// order). Anonymous records now stay in literal order end-to-end, so dot
/// access must resolve positionally against that order too.
fn anon_record_inferred(val: Expr, struct_sets: Array[(String, Array[String])]) -> Option[String] {
  match val {
    ERecord(rn, fields, _) => if String::length(rn) > 0 {
      None
    } else {
      let names = empty_str_array()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      Some(anon_record_sentinel(names))
    },
    // #1878: a tuple literal carrying anonymous records gets the compound
    // `__anontup:` sentinel, so a later tuple destructure of the binding
    // (`let (r, n) = t` — an EMatch with a PTuple pattern) can hand each
    // element's record sentinel to its binder. Sentinel entries are inert
    // for every other var_types consumer (no struct name ever matches).
    ETuple(items) => tuple_sentinel_from_exprs(items),
    _ => None
  }
}

/// Prefer the anonymous-record sentinel for a `let` value, falling back to the
/// ordinary type inference used for trait dispatch / `==` / the Map-index rewrite.
fn anon_or_infer(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match anon_record_inferred(val, struct_sets) {
    Some(s) => Some(s),
    None => infer_arg_type_name(val, struct_sets, var_types, fn_returns)
  }
}

/// Binding-time variant used after constructor-indexed generics are known.
/// A call such as `map([1], f)` has the declared return head `F`, but the
/// concrete constructor is recovered from the callee's `F[A]` receiver. Keep
/// that answer on the local so a later, non-nested `map(ys, g)` can synthesize
/// the same witness as a directly nested pipeline.
fn anon_or_constructor_infer(val: Expr, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match anon_record_inferred(val, struct_sets) {
    Some(s) => Some(s),
    // EHandle recovery exists for a constructor-polymorphic CALL RECEIVER.
    // Do not publish its ordinary result head into the shared var_types table:
    // that table also controls rendering, and an otherwise-untyped handled
    // Bool historically stays erased there. A direct
    // `Mappable::map(handle { .. }, f)`
    // still enters infer_constructor_arg_type_name from synth_dicts.
    None => match val {
      EHandle(_, _) => infer_arg_type_name(val, struct_sets, var_types, fn_returns),
      _ => infer_constructor_arg_type_name(val, gens, struct_sets, var_types, fn_returns)
    }
  }
}

fn constructor_return_head_of(ret: Option[TypeExpr], body: Expr) -> String {
  match ret {
    Some(te) => match eq_expand_alias_ty(te) {
      TyName(n) => n,
      TyApp(n, _) => n,
      TyFn(_, _, _) => fn_type_return_head(),
      _ => ""
    },
    None => fn_return_head_of(ret, body)
  }
}

fn extend_local_fn_return(var_types: Array[(String, String)], name: String, value: Expr) -> Array[(String, String)] {
  if !Array::get(dtd_constructor_tracking, 0) || !str_array_contains(dtd_constructor_local_returns, name) {
    var_types
  } else {
    let key = local_fn_return_key(name)
    match value {
      EFn(_, _, _, ret, _, body) => {
        let head = constructor_return_head_of(ret, body)
        if String::length(head) == 0 {
          extend_constructor_var_types(var_types, key, None)
        } else {
          extend_constructor_var_types(var_types, key, Some(head))
        }
      },
      _ => extend_constructor_var_types(var_types, key, None)
    }
  }
}

/// `binding.field` -> `__rec_field(binding, slot)` when `binding` is an
/// anonymous-record binding (a `__anonrec:` var_types entry) that carries `field`.
/// `robj` is the already-rewritten receiver. None leaves the EDot untouched (a
/// declared-struct field, a tuple index, or an unknown receiver).
fn anon_dot_rewrite(obj: Expr, field: String, off: Int, robj: Expr, var_types: Array[(String, String)]) -> Option[Expr] {
  match obj {
    EIdent(vn, _) => match lookup_var_type(var_types, vn) {
      Some(t) => {
        let idx = anon_field_index(t, field)
        if idx >= 0 {
          Some(ECall(EIdent("__rec_field", off), [robj, EInt(idx)], off))
        } else {
          None
        }
      },
      None => None
    },
    _ => None
  }
}

/// The hidden bounds threaded into a generic: (type-param, trait, receiver
/// parameter index). Empty registry sentinel for arrays of these.
fn empty_threaded() -> Array[(String, String, Int)] {
  array_empty()
}

fn empty_dict_binds() -> Array[(String, String, String, Array[String])] {
  array_empty()
}

/// Whether this EFn was already transformed by a prior run of this pass
/// (idempotency guard against desugaring the same stmts twice while bounds
/// are still present).
///
/// Codex P1 on #1869 (twice): a bare `starts_with(pname, "__dict_")` prefix
/// test let a USER-WRITTEN parameter that merely borrows the prefix
/// (`__dict_dummy: Int` is a legal identifier) exempt the whole function from
/// threading AND from the #1858 witness-carrier validation — and a name-only
/// exact match still left the same hole for a parameter spelled exactly
/// `__dict_<Trait>_<Tparam>`. So the guard now demands the FULL generated
/// shape from `thread_dict_params`: first parameter named
/// `__dict_<Trait>_<Tparam>` AND annotated `<Trait>Dict[<Tparam>]`, for one
/// of THIS function's own bound pairs (the transform preserves `bounds`, see
/// rewrite_stmt's SLet arm). User source cannot pass this at check time: the
/// `<Trait>Dict` witness struct is synthesized by this pass, which runs after
/// checking, so a hand-written `x: DefaultDict[T]` annotation is an unknown
/// type to the checker while the genuinely generated shape (re-checked or
/// re-desugared downstream) matches exactly.
fn type_expr_arrays_equal(left: Array[TypeExpr], right: Array[TypeExpr]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut equal = true
    while i < Array::length(left) && equal {
      equal = impl_target_key(Array::get(left, i)) == impl_target_key(Array::get(right, i))
      i = i + 1
    }
    equal
  }
}

fn already_threaded(bounds: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])]) -> Bool {
  if Array::length(params) == 0 {
    false
  } else {
    let (pname, ann) = Array::get(params, 0)
    match ann {
      Some(TyApp(dname, targs)) => {
        let mut found = false
        let mut bi = 0
        while bi < Array::length(bounds) {
          let (tp, trait_list) = Array::get(bounds, bi)
          let tpname = type_param_name(tp)
          let mut ti = 0
          while ti < Array::length(trait_list) {
            let tr = Array::get(trait_list, ti)
            let trait_args = trait_ref_args(tr)
            let args_match = if Array::length(trait_args) > 0 {
              type_expr_arrays_equal(targs, trait_args)
            } else if Array::length(targs) == 1 {
              match Array::get(targs, 0) {
                TyName(tn) => tn == tpname,
                _ => false
              }
            } else {
              false
            }
            if tr != "" && args_match && pname == dict_param_name(tr, tpname) && dname == dict_struct_name(tr) {
              found = true
              ti = Array::length(trait_list)
              bi = Array::length(bounds) - 1
            } else {
              ti = ti + 1
            }
          }
          bi = bi + 1
        }
        found
      },
      _ => false
    }
  }
}

/// Index of the first parameter whose annotation is exactly the type parameter
/// `tp` (`x: T`). -1 when `T` does not appear directly as a parameter type.
fn find_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyName(n)) => if n == tp {
        idx = i
        i = Array::length(params)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// #1199 bug 1: index of the first parameter whose annotation is `Array[tp]`
/// (`x: Array[T]`) -- the sibling of find_recv_index for a type param that
/// appears as an Array's element rather than directly. -1 when `T` doesn't
/// appear that way either. build_gens tries this ONLY after find_recv_index
/// fails, so a function with BOTH a direct `x: T` param and an `xs: Array[T]`
/// param keeps preferring the direct (cheaper, unambiguous) receiver.
fn find_array_elem_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyApp("Array", targs)) => if Array::length(targs) == 1 {
        match Array::get(targs, 0) {
          TyName(n) => if n == tp {
            idx = i
            i = Array::length(params)
          } else {
            i = i + 1
          },
          _ => {
            i = i + 1
          }
        }
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// Index of the first parameter whose annotation applies constructor `tp`,
/// for example `xs: F[A]` for a kinded `F[_]` binder.
fn find_constructor_recv_index(params: Array[(String, Option[TypeExpr])], tp: String, stmts: Array[Stmt]) -> Int {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(raw_ann) => match expand_constructor_alias(raw_ann, stmts, Array::length(stmts) + 1) {
        TyApp(head, _) => if head == tp {
          idx = i
          i = Array::length(params)
        } else {
          i = i + 1
        },
        _ => {
          i = i + 1
        }
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// #1199 bug 1: `threaded`'s recv_idx field packs TWO distinct receiver kinds
/// into one Int rather than widening the tuple everywhere it's threaded
/// (9 call sites across this file): `idx >= 0` is a DIRECT receiver
/// (`x: T`, unchanged, existing behavior) and `idx <= -2` is an
/// ARRAY-ELEMENT receiver (`xs: Array[T]`) with the real param index encoded
/// as `-idx - 2` (index 0 -> -2, 1 -> -3, ...) -- -1 stays reserved for the
/// pre-existing "no inferable receiver, dict supplied via a generic-impl
/// witness" sentinel (build_gens' gimpl_types branch). Only synth_dicts
/// (the sole recv_idx consumer that reads more than the trait name) needs
/// to decode this.
fn encode_array_elem_recv_index(idx: Int) -> Int {
  0 - idx - 2
}

fn is_array_elem_recv_index(idx: Int) -> Bool {
  idx <= (0 - 2) && idx > (0 - 1000000)
}

fn decode_array_elem_recv_index(idx: Int) -> Int {
  0 - idx - 2
}

/// Constructor receivers use a disjoint negative range. `-1` remains the
/// generic-impl sentinel and the small negative range remains Array-element
/// receivers for compatibility with the existing packed representation.
fn encode_constructor_recv_index(idx: Int) -> Int {
  0 - 1000000 - idx
}

fn is_constructor_recv_index(idx: Int) -> Bool {
  idx <= (0 - 1000000)
}

fn decode_constructor_recv_index(idx: Int) -> Int {
  0 - 1000000 - idx
}

fn constructor_alias_arg(params: Array[String], args: Array[TypeExpr], name: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut result = None
  while i < Array::length(params) && i < Array::length(args) {
    if type_param_name(Array::get(params, i)) == name {
      result = Some(Array::get(args, i))
      i = Array::length(params)
    } else {
      i = i + 1
    }
  }
  result
}

fn substitute_constructor_alias_target(target: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match target {
    TyName(name) => match constructor_alias_arg(params, args, name) {
      Some(arg) => arg,
      None => target
    },
    TyApp(head, items) => {
      let substituted_items = for item in items {
        substitute_constructor_alias_target(item, params, args)
      }
      match constructor_alias_arg(params, args, head) {
        Some(TyName(actual_head)) => TyApp(actual_head, substituted_items),
        _ => TyApp(head, substituted_items)
      }
    },
    TyFn(fn_params, result, effect) => TyFn(for param in fn_params {
      substitute_constructor_alias_target(param, params, args)
    }, substitute_constructor_alias_target(result, params, args), effect),
    TyTuple(items) => TyTuple(for item in items {
      substitute_constructor_alias_target(item, params, args)
    }),
    TyUnit => target
  }
}

/// Expand aliases until a constructor-bearing parameter or result exposes its
/// outer constructor. The fuel bound makes cyclic aliases fail closed.
fn expand_constructor_alias(ret: TypeExpr, stmts: Array[Stmt], fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    ret
  } else match ret {
    TyName(head) => {
      let mut i = 0
      let mut result = ret
      let mut found = false
      while i < Array::length(stmts) {
        match Array::get(stmts, i) {
          STypeAlias(_, name, params, target) => if !found && name == head && Array::length(params) == 0 {
            result = expand_constructor_alias(target, stmts, fuel - 1)
            found = true
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      result
    },
    TyApp(head, args) => {
      let mut i = 0
      let mut result = ret
      let mut found = false
      while i < Array::length(stmts) {
        match Array::get(stmts, i) {
          STypeAlias(_, name, params, target) => if !found && name == head && Array::length(params) == Array::length(args) {
            let expanded = substitute_constructor_alias_target(target, params, args)
            result = expand_constructor_alias(expanded, stmts, fuel - 1)
            found = true
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      result
    },
    _ => ret
  }
}

/// The constructor formal that owns a generic function's result, after
/// expanding aliases such as `Apply[F, A] = F[A]`. Nested-call witness
/// recovery must follow this formal's receiver rather than whichever
/// constructor bound was declared first.
fn return_constructor_param(ret: Option[TypeExpr], threaded: Array[(String, String, Int)], stmts: Array[Stmt]) -> String {
  match ret {
    Some(raw_ret) => match expand_constructor_alias(raw_ret, stmts, Array::length(stmts) + 1) {
      TyApp(head, _) => {
        let mut i = 0
        let mut result = ""
        while i < Array::length(threaded) {
          let (type_param, _, recv_idx) = Array::get(threaded, i)
          if type_param == head && is_constructor_recv_index(recv_idx) {
            result = head
            i = Array::length(threaded)
          } else {
            i = i + 1
          }
        }
        result
      },
      _ => ""
    },
    None => ""
  }
}

/// Build the registry of top-level generics that need dictionary threading:
/// each is a (function name, threaded-bounds) pair. A bound is threaded only
/// when its trait is method-bearing and the type parameter appears directly as
/// a parameter type.
/// The type-constructor head of a qualified name (`Array::show2` -> "Array"),
/// or "" if unqualified.
fn qualified_head(name: String) -> String {
  match split_qualified(name) {
    Some(parts) => {
      let (head, _) = parts
      head
    },
    None => ""
  }
}

/// Method owners of bounded generic impls (`impl [T: Bound] Trait for C[T]`).
/// Their methods carry the bound `T` even though it appears nested in the
/// receiver (`self: C[T]`), so they must be threaded a witness dict (the normal
/// "type param is a direct parameter" rule misses them).
fn collect_generic_impl_owners(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, tbounds, trait_name, target) => if Array::length(tparams) > 0 {
        let mut has_bound = false
        let mut bi = 0
        while bi < Array::length(tbounds) {
          let (_, bs) = Array::get(tbounds, bi)
          let mut bj = 0
          while bj < Array::length(bs) {
            if Array::get(bs, bj) != "" {
              has_bound = true
            } else {
              ()
            }
            bj = bj + 1
          }
          bi = bi + 1
        }
        if has_bound {
          Array::push(out, impl_method_owner(tparams, trait_name, target))
        } else {
          ()
        }
      } else (),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn collect_generic_impl_infos(stmts: Array[Stmt]) -> Array[GenericImplInfo] {
  let out = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, _, trait_name, target) => if Array::length(tparams) > 0 {
        let dispatch_target = match target {
          TyName(name) => TyApp(name, for tparam in tparams {
            TyName(tparam)
          }),
          _ => target
        }
        Array::push(out, GenericImplInfo::{
          owner: impl_method_owner(tparams, trait_name, target),
          trait_name,
          type_params: tparams,
          target: dispatch_target
        })
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn generic_impl_info_for_owner(infos: Array[GenericImplInfo], owner: String) -> Option[GenericImplInfo] {
  let mut i = 0
  let mut result = None
  while i < Array::length(infos) {
    let info = Array::get(infos, i)
    if info.owner == owner {
      result = Some(info)
      i = Array::length(infos)
    } else {
      i = i + 1
    }
  }
  result
}

fn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_infos: Array[GenericImplInfo]) -> Array[DictGen] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(tparams, bounds, params, ret, _, _) => if already_threaded(bounds, params) {
          ()
        } else {
          let impl_info = generic_impl_info_for_owner(gimpl_infos, qualified_head(fname))
          let is_impl_method = match impl_info {
            Some(_) => true,
            None => false
          }
          let constructor_recvs = collect_constructor_recvs(tparams, params, stmts)
          let threaded = empty_threaded()
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, bi)
            let tpname = type_param_name(tp)
            let mut ti = 0
            while ti < Array::length(trait_list) {
              let tr = Array::get(trait_list, ti)
              match lookup_trait_sigs(traits, tr) {
                Some(_) => {
                  let ridx = find_recv_index(params, tpname)
                  if ridx >= 0 {
                    Array::push(threaded, (tpname, tr, ridx))
                  } else if is_impl_method {
                    // bounded generic-impl method: T is nested in `self: C[T]`,
                    // so there is no inferable receiver argument — the witness
                    // dict is supplied when C's witness is built. Thread with -1.
                    Array::push(threaded, (tpname, tr, 0 - 1))
                  } else {
                    let cidx = find_constructor_recv_index(params, tpname, stmts)
                    if cidx >= 0 {
                      Array::push(threaded, (tpname, tr, encode_constructor_recv_index(cidx)))
                    } else {
                      // #1199 bug 1: T may still appear, just wrapped one level
                      // in an `Array[T]` param (`fn f[T: Hash](xs: Array[T])`)
                      // rather than bare `x: T` -- find_recv_index alone missed
                      // this, so f was silently left un-threaded: no dict param
                      // on its own signature, `no_binds` for its body (see
                      // rewrite_stmt's `lookup_gen` miss), and any Hash-bounded
                      // call inside f on a value pulled out of `xs` had no dict
                      // to forward, however it was written -- synth_dicts fails
                      // and the call site was emitted short its dict arg
                      // (invalid wasm), not merely "less generic than it could
                      // be" as the direct-receiver miss would read.
                      let widx = find_array_elem_recv_index(params, tpname)
                      if widx >= 0 {
                        Array::push(threaded, (tpname, tr, encode_array_elem_recv_index(widx)))
                      } else {
                        ()
                      }
                    }
                  }
                },
                None => ()
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if Array::length(threaded) > 0 || is_impl_method {
            let result_constructor = return_constructor_param(ret, threaded, stmts)
            match impl_info {
              Some(info) => Array::push(out, DictGen::{
                name: fname,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: info.trait_name,
                impl_params: info.type_params,
                impl_target: Some(info.target),
                constructor_recvs
              }),
              None => Array::push(out, DictGen::{
                name: fname,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: "",
                impl_params: [],
                impl_target: None,
                constructor_recvs
              })
            }
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #1858: definition-side witness-carrier validation, run by the CHECKER (both
/// check_program pipelines) so `vibe check` reports what would otherwise
/// surface as a codegen ICE ("`T::default` reached code generation
/// unresolved").
///
/// A top-level generic `f = [T: Tr](params)` whose body references `T::m` (a
/// method of the method-bearing trait `Tr`) can only be dispatched when this
/// pass can thread a witness dictionary for `T` — and build_gens above derives
/// that ability purely from the signature: a parameter of type `T`
/// (find_recv_index), a parameter of type `Array[T]`
/// (find_array_elem_recv_index, #1199), or the function being a bounded
/// generic-impl method (collect_generic_impl_owners — its dict arrives with the
/// impl witness instead). A bounded generic with NONE of those is never
/// registered in `gens`, its body is never rewritten, and `T::m` reaches
/// codegen unresolved. This function is the checker-facing mirror of exactly
/// that condition — if build_gens grows a new receiver kind, this must learn
/// it too, which is why it lives next to build_gens rather than in the
/// checker.
///
/// `env` supplies the trait method tables (trait_method_sig_binders_deep), so
/// traits imported from another module (e.g. @vibe/core's `Default`) are
/// covered, not just same-file declarations. Marker traits have no methods, so
/// no `T::m` can name one and the scan stays inert for them — same reason the
/// checker's own `resolve_trait_method_ident` never resolves through a marker
/// bound.
export fn collect_undispatchable_trait_method_errors(stmts: Array[Stmt], env: TypeEnv) -> Array[String] {
  let out = empty_str_array()
  let gimpl_owners = collect_generic_impl_owners(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, bounds, params, _, _, fbody) => {
          // Codex P1 on #1869 (round 2): the `__dict_` parameter-name prefix
          // is RESERVED for the dict-passing desugar's generated witness
          // parameters. Genuinely generated parameters never reach the
          // checker (desugar_trait_dicts runs post-check, and the printed
          // bundles carry no threaded params — verified), so at check time
          // any such name is user-written. Rejecting it outright is what
          // makes already_threaded's shape test sound: without this, a
          // parameter spelled exactly `__dict_<Trait>_<T>` (any annotation —
          // the checker tolerates unknown annotation types, measured) would
          // fake threading, skip both build_gens and this validation, and
          // resurrect the check-clean/codegen-ICE hole.
          let mut pi = 0
          while pi < Array::length(params) {
            let (pname, _) = Array::get(params, pi)
            if String::starts_with(pname, "__dict_") {
              let rmsg = String::concat(fname, String::concat(": parameter `", String::concat(pname, "` uses the reserved `__dict_` prefix (compiler-generated witness dictionaries) — rename the parameter.")))
              if str_array_contains(out, rmsg) {
                ()
              } else {
                Array::push(out, rmsg)
              }
            } else {
              ()
            }
            pi = pi + 1
          }
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, bi)
            let tpname = type_param_name(tp)
            let has_carrier = find_recv_index(params, tpname) >= 0 || find_constructor_recv_index(params, tpname, stmts) >= 0 || find_array_elem_recv_index(params, tpname) >= 0 || str_array_contains(gimpl_owners, qualified_head(fname))
            if has_carrier {
              ()
            } else {
              push_undispatchable_refs(fbody, fname, tpname, trait_list, env, out)
            }
            bi = bi + 1
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Scan one carrier-less bound's function body for `tp::member` references
/// that name a method of one of the bound traits, pushing one actionable
/// diagnostic per distinct reference. Values and calls are both caught — an
/// unrewritten `T::m` is equally unresolvable either way.
fn push_undispatchable_refs(e: Expr, fname: String, tp: String, trait_list: Array[String], env: TypeEnv, out: Array[String]) -> Unit {
  match e {
    EIdent(nm, _) => match split_qualified(nm) {
      Some(parts) => {
        let (head, member) = parts
        if head == tp {
          let mut ti = 0
          let mut reported = false
          while ti < Array::length(trait_list) {
            let tr = Array::get(trait_list, ti)
            if !reported && tr != "" {
              match trait_method_sig_binders_deep(env, tr, member) {
                Some(_) => {
                  reported = true
                  let msg = String::concat(fname, String::concat(": `", String::concat(nm, String::concat("` cannot be dispatched here: no parameter of `", String::concat(fname, String::concat("` carries the `[", String::concat(tp, String::concat(": ", String::concat(tr, String::concat("]` witness. Add a parameter of type `", String::concat(tp, String::concat("` (or `Array[", String::concat(tp, String::concat("]`) so call sites can supply the impl, or call `", String::concat(member, "` on a concrete type instead.")))))))))))))))
                  if str_array_contains(out, msg) {
                    ()
                  } else {
                    Array::push(out, msg)
                  }
                },
                None => ()
              }
            }
            ti = ti + 1
          }
        } else {
          ()
        }
      },
      None => ()
    },
    _ => ()
  }
  let kids = expr_children(e)
  let mut ki = 0
  while ki < Array::length(kids) {
    push_undispatchable_refs(Array::get(kids, ki), fname, tp, trait_list, env, out)
    ki = ki + 1
  }
}

fn lookup_gen_entry(gens: Array[DictGen], name: String) -> Option[DictGen] {
  let mut i = 0
  let mut result = None
  while i < Array::length(gens) {
    let gen = Array::get(gens, i)
    if gen.name == name {
      result = Some(gen)
      i = Array::length(gens)
    } else {
      i = i + 1
    }
  }
  result
}

fn lookup_gen(gens: Array[DictGen], name: String) -> Option[Array[(String, String, Int)]] {
  match lookup_gen_entry(gens, name) {
    Some(gen) => Some(gen.threaded),
    None => None
  }
}

fn impl_pattern_binding(bindings: Array[(String, TypeExpr)], name: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut result = None
  while i < Array::length(bindings) {
    let (bound_name, bound_type) = Array::get(bindings, i)
    if bound_name == name {
      result = Some(bound_type)
      i = Array::length(bindings)
    } else {
      i = i + 1
    }
  }
  result
}

fn impl_pattern_param(params: Array[String], name: String) -> Bool {
  str_array_contains(params, name)
}

fn impl_target_pattern_matches(pattern: TypeExpr, actual: TypeExpr, params: Array[String], bindings: Array[(String, TypeExpr)]) -> Bool {
  match pattern {
    TyName(name) => if impl_pattern_param(params, name) {
      match impl_pattern_binding(bindings, name) {
        Some(bound) => impl_target_key(bound) == impl_target_key(actual),
        None => {
          Array::push(bindings, (name, actual))
          true
        }
      }
    } else {
      match actual {
        TyName(actual_name) => name == actual_name,
        _ => false
      }
    },
    TyApp(name, args) => match actual {
      TyApp(actual_name, actual_args) => if name == actual_name && Array::length(args) == Array::length(actual_args) {
        let mut i = 0
        let mut ok = true
        while i < Array::length(args) && ok {
          ok = impl_target_pattern_matches(Array::get(args, i), Array::get(actual_args, i), params, bindings)
          i = i + 1
        }
        ok
      } else {
        false
      },
      _ => false
    },
    TyFn(fn_params, ret, effect) => match actual {
      TyFn(actual_params, actual_ret, actual_effect) => if effect == actual_effect && Array::length(fn_params) == Array::length(actual_params) {
        let mut i = 0
        let mut ok = true
        while i < Array::length(fn_params) && ok {
          ok = impl_target_pattern_matches(Array::get(fn_params, i), Array::get(actual_params, i), params, bindings)
          i = i + 1
        }
        ok && impl_target_pattern_matches(ret, actual_ret, params, bindings)
      } else {
        false
      },
      _ => false
    },
    TyTuple(items) => match actual {
      TyTuple(actual_items) => if Array::length(items) == Array::length(actual_items) {
        let mut i = 0
        let mut ok = true
        while i < Array::length(items) && ok {
          ok = impl_target_pattern_matches(Array::get(items, i), Array::get(actual_items, i), params, bindings)
          i = i + 1
        }
        ok
      } else {
        false
      },
      _ => false
    },
    TyUnit => match actual {
      TyUnit => true,
      _ => false
    }
  }
}

/// Whether erasing this target's arguments leaves a sound match for every
/// application of its constructor head. This is limited to a permutation of
/// the impl formals: constrained or repeated patterns must retain their full
/// applied target before they can dispatch.
fn generic_impl_target_is_total(target: TypeExpr, params: Array[String]) -> Bool {
  match target {
    TyApp(_, args) => if Array::length(args) != Array::length(params) {
      false
    } else {
      let seen = empty_str_array()
      let mut i = 0
      let mut total = true
      while i < Array::length(args) && total {
        match Array::get(args, i) {
          TyName(name) => if impl_pattern_param(params, name) && !str_array_contains(seen, name) {
            Array::push(seen, name)
          } else {
            total = false
          },
          _ => {
            total = false
          }
        }
        i = i + 1
      }
      total && Array::length(seen) == Array::length(params)
    },
    _ => false
  }
}

fn impl_trait_pattern_matches(template_key: String, actual_key: String, params: Array[String], bindings: Array[(String, TypeExpr)]) -> Bool {
  if template_key == actual_key {
    true
  } else if trait_ref_name(template_key) != trait_ref_name(actual_key) {
    false
  } else {
    match trait_ref_from_key(template_key) {
      Some(template) => match trait_ref_from_key(actual_key) {
        Some(actual) => impl_target_pattern_matches(template, actual, params, bindings),
        None => false
      },
      None => false
    }
  }
}

fn matching_generic_impl_method(gens: Array[DictGen], cname: String, trait_name: String, method: String, actual: TypeExpr) -> Option[String] {
  let mut i = 0
  let mut result = None
  let mut erased_result = None
  let mut erased_count = 0
  while i < Array::length(gens) {
    let gen = Array::get(gens, i)
    let bindings = []
    if impl_target_head(match gen.impl_target {
      Some(target) => target,
      None => TyName("")
    }) == cname && String::ends_with(gen.name, String::concat("::", method)) {
      match gen.impl_target {
        Some(target) => if impl_target_pattern_matches(target, actual, gen.impl_params, bindings) && impl_trait_pattern_matches(gen.impl_trait, trait_name, gen.impl_params, bindings) {
          result = Some(gen.name)
          i = Array::length(gens)
        } else {
          match actual {
            TyName(actual_head) => if actual_head == cname && generic_impl_target_is_total(target, gen.impl_params) && impl_trait_pattern_matches(gen.impl_trait, trait_name, gen.impl_params, bindings) {
              erased_result = Some(gen.name)
              erased_count = erased_count + 1
            } else (),
            _ => ()
          }
          i = i + 1
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  match result {
    Some(_) => result,
    None => if erased_count == 1 {
      erased_result
    } else {
      None
    }
  }
}

fn generic_impl_bound_target(gens: Array[DictGen], method_name: String, type_param: String, actual: TypeExpr) -> Option[TypeExpr] {
  match lookup_gen_entry(gens, method_name) {
    Some(gen) => match gen.impl_target {
      Some(target) => {
        let bindings = []
        if impl_target_pattern_matches(target, actual, gen.impl_params, bindings) {
          impl_pattern_binding(bindings, type_param)
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}

/// Find the dict parameter to dispatch a `head::member` call against, given the
/// dict bindings in scope: the binding whose type-param is `head` and whose
/// trait declares `member`.
fn find_dict_for_method(dict_binds: Array[(String, String, String, Array[String])], head: String, member: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)
    if tp == head && str_array_contains(methods, member) {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}

/// Find the in-scope dict parameter bound to type-param `tparam` for `trait_name`
/// (used to forward a caller's own witness into a generic->generic call).
fn find_dict_for_trait(dict_binds: Array[(String, String, String, Array[String])], tparam: String, trait_name: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)
    if tp == tparam && tr == trait_name {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}

fn collect_constructor_recvs(tparams: Array[String], params: Array[(String, Option[TypeExpr])], stmts: Array[Stmt]) -> Array[(String, Int)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(tparams) {
    let tp = Array::get(tparams, i)
    if type_param_arity(tp) > 0 {
      let name = type_param_name(tp)
      let cidx = find_constructor_recv_index(params, name, stmts)
      if cidx >= 0 {
        Array::push(out, (name, encode_constructor_recv_index(cidx)))
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn constructor_substs_from_recvs(recvs: Array[(String, Int)], orig_args: Array[Expr], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(recvs) {
    let (formal, recv_idx_raw) = Array::get(recvs, i)
    if is_constructor_recv_index(recv_idx_raw) {
      let recv_idx = decode_constructor_recv_index(recv_idx_raw)
      if recv_idx >= 0 && recv_idx < Array::length(orig_args) {
        match infer_constructor_arg_type_name(Array::get(orig_args, recv_idx), gens, struct_sets, var_types, fn_returns) {
          Some(actual) => Array::push(out, (formal, actual)),
          None => ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn push_constructor_subst(substs: Array[(String, String)], formal: String, actual: String) -> Unit {
  Array::push(substs, (formal, actual))
}

fn replace_trait_constructor_arg(te: TypeExpr, formal: String, actual: String) -> TypeExpr {
  match te {
    TyName(name) => if name == formal {
      TyName(actual)
    } else {
      te
    },
    TyApp(name, args) => TyApp(if name == formal {
      actual
    } else {
      name
    }, for arg in args {
      replace_trait_constructor_arg(arg, formal, actual)
    }),
    TyTuple(items) => TyTuple(for item in items {
      replace_trait_constructor_arg(item, formal, actual)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      replace_trait_constructor_arg(param, formal, actual)
    }, replace_trait_constructor_arg(ret, formal, actual), effect),
    TyUnit => TyUnit
  }
}

/// Resolve constructor formals in an applied bound (`Mappable[F]` ->
/// `Mappable[Array]`, `Accepts[Apply[F, Int]]` -> `Accepts[Array[Int]]`)
/// once call-site receivers identify them.
fn specialize_trait_constructors(trait_name: String, substs: Array[(String, String)]) -> String {
  match trait_ref_from_key(trait_name) {
    Some(reference) => {
      let mut out = reference
      let mut i = 0
      while i < Array::length(substs) {
        let (formal, actual) = Array::get(substs, i)
        out = replace_trait_constructor_arg(out, formal, actual)
        i = i + 1
      }
      trait_ref_key(eq_expand_alias_ty(out))
    },
    None => trait_name
  }
}

fn specialize_trait_constructor(trait_name: String, formal: String, actual: String) -> String {
  let substs = array_empty()
  Array::push(substs, (formal, actual))
  specialize_trait_constructors(trait_name, substs)
}

/// #1445: `(__w) -> String { __to_string(__w) }` -- the total fallback member
/// of a synthetic `Show` witness (see synthetic_show_sigs). Same closure shape
/// build_concrete_dict already synthesizes for a bounded generic-impl method.
fn show_fallback_closure() -> Expr {
  EFn(empty_str_array(), array_empty(), Array::slice([("__w", None)], 0, 1), None, None, ECall(EIdent("__to_string", -1), [
    EIdent("__w", -1)
  ], -1))
}

/// The first element of an array-literal receiver (for a bounded generic impl
/// `impl [T: Bound] Trait for Array`, the element determines T's witness).
fn first_array_elem(e: Expr) -> Option[Expr] {
  match e {
    EArray(elems) => if Array::length(elems) > 0 {
      Some(Array::get(elems, 0))
    } else None,
    _ => None
  }
}

fn impl_target_var_key(name: String) -> String {
  String::concat("$impl_target$", name)
}

fn impl_target_fn_key(name: String) -> String {
  String::concat("$impl_return$", name)
}

fn infer_impl_target_expr(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[TypeExpr] {
  match dtd_ascribed_type(arg) {
    Some(ascribed) => Some(ascribed),
    None => match arg {
      EInt(_) => Some(TyName("Int")),
      EBool(_) => Some(TyName("Bool")),
      EString(_) => Some(TyName("String")),
      EFloat(_) => Some(TyName("Double")),
      EArray(items) => if Array::length(items) == 0 {
        None
      } else {
        match infer_impl_target_expr(Array::get(items, 0), struct_sets, var_types, fn_returns) {
          Some(elem_type) => {
            let mut i = 1
            let mut same = true
            while i < Array::length(items) && same {
              same = match infer_impl_target_expr(Array::get(items, i), struct_sets, var_types, fn_returns) {
                Some(next) => impl_target_key(next) == impl_target_key(elem_type),
                None => false
              }
              i = i + 1
            }
            if same {
              Some(TyApp("Array", [elem_type]))
            } else {
              None
            }
          },
          None => None
        }
      },
      ERecord(name, _, type_args) => if name != "" {
        if Array::length(type_args) > 0 {
          Some(TyApp(name, type_args))
        } else {
          Some(TyName(name))
        }
      } else {
        None
      },
      EIdent(name, _) => match lookup_var_type(var_types, impl_target_var_key(name)) {
        Some(key) => impl_target_from_key(key),
        None => match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
          Some(head) => Some(TyName(head)),
          None => None
        }
      },
      ECall(EIdent("Some", _), args, _) => if Array::length(args) == 1 {
        match infer_impl_target_expr(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          Some(payload) => Some(TyApp("Option", [payload])),
          None => None
        }
      } else {
        None
      },
      ECall(EIdent(name, _), _, _) => match fn_return_type(fn_returns, impl_target_fn_key(name)) {
        Some(key) => impl_target_from_key(key),
        None => match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
          Some(head) => Some(TyName(head)),
          None => None
        }
      },
      _ => match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
        Some(head) => Some(TyName(head)),
        None => None
      }
    }
  }
}

fn infer_impl_target_key(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match infer_impl_target_expr(arg, struct_sets, var_types, fn_returns) {
    Some(target) => Some(impl_target_key(target)),
    None => None
  }
}

fn bind_impl_target_key(var_types: Array[(String, String)], name: String, value: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  match infer_impl_target_key(value, struct_sets, var_types, fn_returns) {
    Some(key) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, Array::get(var_types, i))
        i = i + 1
      }
      Array::push(out, (impl_target_var_key(name), key))
      out
    },
    None => var_types
  }
}

/// Build the witness `ERecord` for a concrete type `cname` implementing
/// `trait_name`. Codegen resolves it to the dict struct structurally by field
/// names.
///
/// For a plain impl each method field is the free function `C::method`. For a
/// BOUNDED generic impl (`impl [T: Bound] Trait for C`) the method
/// `C::method` was threaded to take its own `Bound` dictionary for the element
/// type, so the field is instead a closure that supplies that nested dictionary:
///   { method: (__w) -> C::method(<element Bound dict>, __w) }
/// The element dict is built recursively from the array literal's first element
/// (`arg_expr`) — a dictionary-of-dictionaries (#5 Increment B). If the element
/// type / dict cannot be determined the whole witness fails to build (returns
/// None), so the call is left unrewritten (a loud arity error, never a silent
/// miscompile).
fn build_concrete_dict_for_target(actual_target: TypeExpr, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Option[Expr]) -> Option[Expr] {
  let cname = impl_target_head(actual_target)
  match lookup_trait_sigs(traits, trait_ref_name(trait_name)) {
    Some(sigs) => {
      let mnames = method_names_of_sigs(sigs)
      let recfields = array_empty()
      let mut mi = 0
      let mut failed = false
      while mi < Array::length(mnames) {
        let m = Array::get(mnames, mi)
        let plain_qm = String::concat(cname, String::concat("::", m))
        let specialized_qm = impl_specialized_method_binding_name(cname, trait_name, impl_target_key(actual_target), m)
        let qm = if specialized_qm != "" && fn_exists(fn_returns, specialized_qm) {
          specialized_qm
        } else match matching_generic_impl_method(gens, cname, trait_name, m, actual_target) {
          Some(generic_qm) => generic_qm,
          None => plain_qm
        }
        if not(fn_exists(fn_returns, qm)) {
          // #1445: the SYNTHETIC `Show` witness is total. A type with no
          // `C::to_string` renders through the ADR-0058 heuristic -- exactly
          // what it does outside a generic today -- so threading a witness
          // never turns a compiling program into a failing one. This is the
          // one trait allowed a fabricated member, and only because its
          // fallback is the status quo rather than a guess at an impl.
          if trait_ref_name(trait_name) == "Show" && m == "to_string" {
            Array::push(recfields, (m, show_fallback_closure()))
          } else {
            // No `cname::m` free function exists — `cname` does not actually
            // implement `trait_name`. Refuse to fabricate a witness (which would
            // otherwise silently dispatch to a same-shaped function), so the call
            // is left unrewritten and fails loudly instead of miscompiling.
            failed = true
          }
        } else {
          match lookup_gen(gens, qm) {
            Some(threaded) => if Array::length(threaded) == 0 {
              Array::push(recfields, (m, EIdent(qm, -1)))
            } else {
              let callargs = empty_expr_array()
              let mut bi = 0
              let mut subok = true
              while bi < Array::length(threaded) {
                let (type_param, btrait, _) = Array::get(threaded, bi)
                let nested_target = match generic_impl_bound_target(gens, qm, type_param, actual_target) {
                  Some(target) => Some(target),
                  None => match arg_expr {
                    Some(value) => match first_array_elem(value) {
                      Some(elem) => infer_impl_target_expr(elem, struct_sets, var_types, fn_returns),
                      None => None
                    },
                    None => None
                  }
                }
                match nested_target {
                  Some(target) => match build_concrete_dict_for_target(target, btrait, traits, gens, struct_sets, var_types, fn_returns, None) {
                    Some(sd) => Array::push(callargs, sd),
                    None => {
                      subok = false
                    }
                  },
                  None => {
                    subok = false
                  }
                }
                bi = bi + 1
              }
              if subok {
                Array::push(callargs, EIdent("__w", -1))
                let closure = EFn(empty_str_array(), array_empty(), Array::slice([
                  ("__w", None)
                ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))
                Array::push(recfields, (m, closure))
              } else {
                failed = true
              }
            },
            None => Array::push(recfields, (m, EIdent(qm, -1)))
          }
        }
        mi = mi + 1
      }
      if failed {
        None
      } else {
        let dict_args = trait_ref_args(trait_name)
        if Array::length(dict_args) > 0 {
          Some(ERecord(dict_struct_name(trait_name), recfields, dict_args))
        } else {
          Some(ERecord("", recfields, empty_ty_args()))
        }
      }
    },
    None => None
  }
}

fn build_concrete_dict(cname: String, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Expr) -> Option[Expr] {
  let target = match infer_impl_target_expr(arg_expr, struct_sets, var_types, fn_returns) {
    Some(inferred) => inferred,
    None => TyName(cname)
  }
  build_concrete_dict_for_target(target, trait_name, traits, gens, struct_sets, var_types, fn_returns, Some(arg_expr))
}

/// Synthesize the witness dictionaries for a call to a transformed generic, or
/// #1199 bug 1: the call-site counterpart of array_elem_type_of, for an
/// ARRAY-ELEMENT receiver (see encode_array_elem_recv_index) whose call-site
/// argument expression is the array itself, not a plain identifier already
/// carrying a recorded element type. Handles the two shapes that actually
/// occur at a call site: a variable naming an Array-typed parameter
/// (array_elem_type_of's existing sentinel lookup), or an inline array
/// literal (infer the element type from its own first element — an empty
/// literal has nothing to infer FROM and is left unresolved, same
/// conservative stance as every other best-effort case in this file).
fn infer_arg_elem_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arg {
    EIdent(name, _) => array_elem_type_of(var_types, name),
    EArray(elems) => if Array::length(elems) > 0 {
      infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns)
    } else {
      None
    },
    _ => None
  }
}

/// Recover the concrete constructor carried through a nested generic call.
/// A pipeline chain parses as `map(map([..], f), g)`: the inner call's
/// declared return head is the formal `F`, so ordinary return-type inference
/// cannot tell the outer call that the value is still an Array. Follow the
/// callee's own constructor receiver back to its concrete argument instead.
fn infer_constructor_arg_type_name(arg: Expr, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arg {
    EIdent(name, _) => if constructor_binding_is_masked(var_types, name) {
      None
    } else match lookup_var_type(var_types, constructor_head_key(name)) {
      Some(head) => Some(head),
      None => match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
        Some(head) => Some(head),
        None => match lookup_var_type(var_types, shape_key(name)) {
          Some(shape) => if String::starts_with(shape, "[") {
            Some("Array")
          } else {
            None
          },
          None => None
        }
      }
    },
    EReturn(inner) => infer_constructor_arg_type_name(inner, gens, struct_sets, var_types, fn_returns),
    EDot(obj, field, _, _) => match obj {
      EIdent(name, _) => if constructor_binding_is_masked(var_types, name) {
        None
      } else {
        infer_arg_type_name(arg, struct_sets, var_types, fn_returns)
      },
      ETuple(elems) => match dtd_tuple_index_of(field) {
        Some(idx) => if idx >= 0 && idx < Array::length(elems) {
          infer_constructor_arg_type_name(Array::get(elems, idx), gens, struct_sets, var_types, fn_returns)
        } else {
          None
        },
        None => infer_arg_type_name(arg, struct_sets, var_types, fn_returns)
      },
      _ => infer_arg_type_name(arg, struct_sets, var_types, fn_returns)
    },
    ELet(name, val, body, _) => {
      let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
      infer_constructor_arg_type_name(body, gens, struct_sets, body_vars, fn_returns)
    },
    ELetMut(name, val, body, _) => {
      if name == "__loop_result" {
        infer_parameterized_loop_constructor(body, gens, struct_sets, var_types, fn_returns)
      } else {
        let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
        infer_constructor_arg_type_name(body, gens, struct_sets, body_vars, fn_returns)
      }
    },
    ELetRec(name, value, body) => {
      let body_vars = extend_local_fn_return(var_types, name, value)
      infer_constructor_arg_type_name(body, gens, struct_sets, body_vars, fn_returns)
    },
    EAssign(_, _, continuation) => infer_constructor_arg_type_name(continuation, gens, struct_sets, var_types, fn_returns),
    EAssignOp(_, _, _, continuation) => infer_constructor_arg_type_name(continuation, gens, struct_sets, var_types, fn_returns),
    ESeq(_, result) => infer_constructor_arg_type_name(result, gens, struct_sets, var_types, fn_returns),
    EMatch(scrut, arms) => infer_constructor_match_arm_type_name(scrut, arms, gens, struct_sets, var_types, fn_returns),
    EHandle(body, arms) => infer_constructor_handle_type_name(body, arms, gens, struct_sets, var_types, fn_returns),
    EIf(_, then_branch, else_branch) => {
      let then_constructor = infer_constructor_arg_type_name(then_branch, gens, struct_sets, var_types, fn_returns)
      let else_constructor = infer_constructor_arg_type_name(else_branch, gens, struct_sets, var_types, fn_returns)
      match then_constructor {
        Some(name) => match else_constructor {
          Some(other) => {
            let branches_agree = name == other
            if branches_agree {
              Some(name)
            } else {
              None
            }
          },
          None => None
        },
        None => None
      }
    },
    ECall(EFn(_, _, params, _, _, body), args, _) => {
      let mut body_vars = var_types
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        let inferred = if i < Array::length(args) {
          infer_constructor_arg_type_name(Array::get(args, i), gens, struct_sets, var_types, fn_returns)
        } else {
          None
        }
        body_vars = extend_constructor_var_types(body_vars, name, inferred)
        i = i + 1
      }
      infer_constructor_arg_type_name(body, gens, struct_sets, body_vars, fn_returns)
    },
    ECall(EIdent(name, _), args, _) => infer_constructor_generic_call_type_name(name, args, arg, gens, struct_sets, var_types, fn_returns),
    ECall(EDot(obj, method, _, _), args, _) => {
      let resolved = match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {
        Some(receiver) => {
          let qualified = String::concat(receiver, String::concat("::", method))
          if !struct_set_member(struct_sets, receiver, method) && fn_exists(fn_returns, qualified) {
            Some(qualified)
          } else {
            None
          }
        },
        None => None
      }
      match resolved {
        Some(name) => infer_constructor_generic_call_type_name(name, prepend_expr(obj, args), arg, gens, struct_sets, var_types, fn_returns),
        None => infer_arg_type_name(arg, struct_sets, var_types, fn_returns)
      }
    },
    _ => infer_arg_type_name(arg, struct_sets, var_types, fn_returns)
  }
}

/// Collect the constructor assigned by the parser's parameterized-loop
/// lowering. Every reachable `break value` must resolve to the same
/// constructor; one unknown or disagreement leaves dictionary selection
/// unresolved. Nested control scopes are boundaries because they own their
/// own break/loop result, and a nested `__loop_result` binding shadows this
/// synthetic slot.
fn collect_parameterized_loop_constructors(expr: Expr, expected: Array[String], valid: Array[Bool], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Unit {
  if !Array::get(valid, 0) {
    ()
  } else {
    match expr {
      EAssign("__loop_result", value, continuation) => {
        match infer_constructor_arg_type_name(value, gens, struct_sets, var_types, fn_returns) {
          Some(actual) => if Array::length(expected) == 0 {
            Array::push(expected, actual)
          } else if Array::get(expected, 0) != actual {
            Array::set(valid, 0, false)
          } else {
            ()
          },
          None => Array::set(valid, 0, false)
        }
        collect_parameterized_loop_constructors(continuation, expected, valid, gens, struct_sets, var_types, fn_returns)
      },
      ELetMut("__loop_result", _, _, _) => (),
      ELet(name, value, body, _) => {
        collect_parameterized_loop_constructors(value, expected, valid, gens, struct_sets, var_types, fn_returns)
        let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(value, gens, struct_sets, var_types, fn_returns)), name, value)
        collect_parameterized_loop_constructors(body, expected, valid, gens, struct_sets, body_vars, fn_returns)
      },
      ELetMut(name, value, body, _) => {
        collect_parameterized_loop_constructors(value, expected, valid, gens, struct_sets, var_types, fn_returns)
        let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(value, gens, struct_sets, var_types, fn_returns)), name, value)
        collect_parameterized_loop_constructors(body, expected, valid, gens, struct_sets, body_vars, fn_returns)
      },
      ELetRec(name, value, body) => {
        let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, None), name, value)
        collect_parameterized_loop_constructors(value, expected, valid, gens, struct_sets, body_vars, fn_returns)
        collect_parameterized_loop_constructors(body, expected, valid, gens, struct_sets, body_vars, fn_returns)
      },
      EMatch(scrut, arms) => {
        collect_parameterized_loop_constructors(scrut, expected, valid, gens, struct_sets, var_types, fn_returns)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (pat, body) = Array::get(arms, i)
          let arm_vars = constructor_match_arm_var_types(scrut, pat, gens, struct_sets, var_types, fn_returns)
          collect_parameterized_loop_constructors(body, expected, valid, gens, struct_sets, arm_vars, fn_returns)
          i = i + 1
        }
      },
      EHandle(body, arms) => {
        collect_parameterized_loop_constructors(body, expected, valid, gens, struct_sets, var_types, fn_returns)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (pat, arm_body) = Array::get(arms, i)
          let arm_vars = constructor_handler_arm_var_types(body, pat, gens, struct_sets, var_types, fn_returns)
          collect_parameterized_loop_constructors(arm_body, expected, valid, gens, struct_sets, arm_vars, fn_returns)
          i = i + 1
        }
      },
      EFn(_, _, _, _, _, _) => (),
      ELoop(_, _) => (),
      EWhile(_, _) => (),
      EForIn(_, _, _, _) => (),
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) && Array::get(valid, 0) {
          collect_parameterized_loop_constructors(Array::get(children, i), expected, valid, gens, struct_sets, var_types, fn_returns)
          i = i + 1
        }
      }
    }
  }
}

/// Recognize only the exact result-bearing spine emitted by
/// `parse_loop_primary`: `while ...; __loop_result`. Starting at the while
/// body avoids confusing a nested while's assignments with this loop.
fn infer_parameterized_loop_constructor(body: Expr, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match body {
    ESeq(EWhile(_, loop_body), EIdent("__loop_result", _)) => {
      let expected = empty_str_array()
      let valid = [true]
      collect_parameterized_loop_constructors(loop_body, expected, valid, gens, struct_sets, var_types, fn_returns)
      if Array::get(valid, 0) && Array::length(expected) == 1 {
        Some(Array::get(expected, 0))
      } else {
        None
      }
    },
    _ => None
  }
}

/// Follow the constructor receiver recorded for a transformed generic call.
/// `args` is already in the callee's declared order; method-style callers
/// prepend their receiver before entering this helper.
fn infer_constructor_generic_call_type_name(name: String, args: Array[Expr], whole: Expr, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match lookup_gen_entry(gens, name) {
    Some(gen) => {
      let mut i = 0
      let mut result = None
      while i < Array::length(gen.threaded) {
        let (type_param, _, recv_idx_raw) = Array::get(gen.threaded, i)
        if type_param == gen.return_constructor_param && is_constructor_recv_index(recv_idx_raw) {
          let recv_idx = decode_constructor_recv_index(recv_idx_raw)
          if recv_idx >= 0 && recv_idx < Array::length(args) {
            result = infer_constructor_arg_type_name(Array::get(args, recv_idx), gens, struct_sets, var_types, fn_returns)
          } else {
            ()
          }
          i = Array::length(gen.threaded)
        } else {
          i = i + 1
        }
      }
      match result {
        Some(_) => result,
        None => infer_arg_type_name(whole, struct_sets, var_types, fn_returns)
      }
    },
    None => infer_arg_type_name(whole, struct_sets, var_types, fn_returns)
  }
}

/// Recover the result of a handler arm while treating `resume` as the handled
/// continuation. Follow the result-bearing spine so a block or local binding
/// around the resume call does not erase the body's constructor.
fn infer_constructor_handler_arm_type_name(arm_body: Expr, expected: String, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arm_body {
    ECall(EIdent("resume", _), resume_args, _) => if Array::length(resume_args) == 1 {
      Some(expected)
    } else {
      None
    },
    ELet(name, val, body, _) => {
      let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
      infer_constructor_handler_arm_type_name(body, expected, gens, struct_sets, body_vars, fn_returns)
    },
    ELetMut(name, val, body, _) => {
      let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
      infer_constructor_handler_arm_type_name(body, expected, gens, struct_sets, body_vars, fn_returns)
    },
    EReturn(inner) => infer_constructor_handler_arm_type_name(inner, expected, gens, struct_sets, var_types, fn_returns),
    ELetRec(name, value, body) => {
      let body_vars = extend_local_fn_return(var_types, name, value)
      infer_constructor_handler_arm_type_name(body, expected, gens, struct_sets, body_vars, fn_returns)
    },
    EAssign(_, _, continuation) => infer_constructor_handler_arm_type_name(continuation, expected, gens, struct_sets, var_types, fn_returns),
    EAssignOp(_, _, _, continuation) => infer_constructor_handler_arm_type_name(continuation, expected, gens, struct_sets, var_types, fn_returns),
    ESeq(_, result) => infer_constructor_handler_arm_type_name(result, expected, gens, struct_sets, var_types, fn_returns),
    EIf(_, then_branch, else_branch) => {
      let then_constructor = infer_constructor_handler_arm_type_name(then_branch, expected, gens, struct_sets, var_types, fn_returns)
      let else_constructor = infer_constructor_handler_arm_type_name(else_branch, expected, gens, struct_sets, var_types, fn_returns)
      match then_constructor {
        Some(name) => match else_constructor {
          Some(other) => {
            let same = name == other
            if same {
              Some(name)
            } else {
              None
            }
          },
          None => None
        },
        None => None
      }
    },
    EMatch(scrut, match_arms) => if Array::length(match_arms) == 0 {
      None
    } else {
      let mut i = 0
      let mut result = Some(expected)
      while i < Array::length(match_arms) {
        let (pat, body) = Array::get(match_arms, i)
        let arm_vars = constructor_match_arm_var_types(scrut, pat, gens, struct_sets, var_types, fn_returns)
        match infer_constructor_handler_arm_type_name(body, expected, gens, struct_sets, arm_vars, fn_returns) {
          Some(actual) => {
            let same = actual == expected
            if same {
              ()
            } else {
              result = None
              i = Array::length(match_arms)
            }
          },
          None => {
            result = None
            i = Array::length(match_arms)
          }
        }
        i = i + 1
      }
      result
    },
    _ => infer_constructor_arg_type_name(arm_body, gens, struct_sets, var_types, fn_returns)
  }
}

fn constructor_op_name_matches(name: String, op: String) -> Bool {
  if String::contains(name, "::") && String::contains(op, "::") {
    name == op
  } else {
    name == op || member_of(name) == member_of(op)
  }
}

fn constructor_handler_consumes_op(arms: Array[(Pat, Expr)], op: String) -> Bool {
  let mut i = 0
  let mut consumes = false
  while i < Array::length(arms) && !consumes {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => {
        consumes = constructor_op_name_matches(name, op)
      },
      _ => ()
    }
    i = i + 1
  }
  consumes
}

// Direct calls can carry a performed constructor payload across a function
// boundary. Handler lifting turns an immediately invoked effectful lambda into
// exactly such a top-level helper before dictionary lowering, so retain the
// callable bodies for the payload scan instead of treating the helper name as
// opaque. The active stack makes recursive call graphs terminate.
let dtd_constructor_callable_bodies: Array[(String, Array[String], Array[(String, Option[TypeExpr])], Expr)] = array_empty()
let dtd_constructor_payload_call_stack: Array[String] = array_empty()

fn collect_constructor_callable_bodies(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(tparams, _, params, _, _, body)) => {
        Array::push(dtd_constructor_callable_bodies, (name, tparams, params, body))
      },
      SFnDecl(_, name, EFn(tparams, _, params, _, _, body), _, _) => {
        Array::push(dtd_constructor_callable_bodies, (name, tparams, params, body))
      },
      SModule(_, _, body) => collect_constructor_callable_bodies(body),
      _ => ()
    }
    i = i + 1
  }
}

fn lookup_constructor_callable_body(name: String) -> Option[(Array[String], Array[(String, Option[TypeExpr])], Expr)] {
  let mut i = Array::length(dtd_constructor_callable_bodies) - 1
  let mut out = None
  let mut found = false
  let mut ambiguous = false
  while i >= 0 {
    let (current, tparams, params, body) = Array::get(dtd_constructor_callable_bodies, i)
    if current == name {
      if found {
        ambiguous = true
      } else {
        out = Some((tparams, params, body))
        found = true
      }
    } else {
      ()
    }
    i = i - 1
  }
  if ambiguous {
    None
  } else {
    out
  }
}

fn constructor_payload_call_is_active(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(dtd_constructor_payload_call_stack) && !found {
    found = Array::get(dtd_constructor_payload_call_stack, i) == name
    i = i + 1
  }
  found
}

fn constructor_callable_body_var_types(tparams: Array[String], params: Array[(String, Option[TypeExpr])], args: Array[Expr], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let mut masked = var_types
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    masked = extend_constructor_var_types(masked, name, None)
    i = i + 1
  }
  let mut body_vars = seed_var_types(params, tparams, masked)
  i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    let inferred = if i < Array::length(args) {
      infer_constructor_arg_type_name(Array::get(args, i), gens, struct_sets, var_types, fn_returns)
    } else {
      None
    }
    match inferred {
      Some(head) => {
        body_vars = extend_constructor_var_types(body_vars, name, Some(head))
      },
      None => ()
    }
    i = i + 1
  }
  body_vars
}

fn collect_constructor_perform_payloads(expr: Expr, op: String, payload_index: Int, out: Array[Option[String]], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      // A nested handler is a boundary only for operations it actually
      // consumes. Unhandled operations propagate to the enclosing handler,
      // so their constructor payload evidence must cross this scope too.
      if constructor_handler_consumes_op(arms, op) {
        ()
      } else {
        collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, var_types, fn_returns)
      }
      // Operations performed by a handler clause are outside the handled
      // body and can still reach an enclosing handler.
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_vars = constructor_handler_arm_var_types(body, pat, gens, struct_sets, var_types, fn_returns)
        collect_constructor_perform_payloads(arm_body, op, payload_index, out, gens, struct_sets, arm_vars, fn_returns)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, _) => (),
    ELet(name, val, body, _) => {
      collect_constructor_perform_payloads(val, op, payload_index, out, gens, struct_sets, var_types, fn_returns)
      let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
      collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
    },
    ELetMut(name, val, body, _) => {
      collect_constructor_perform_payloads(val, op, payload_index, out, gens, struct_sets, var_types, fn_returns)
      let body_vars = extend_local_fn_return(extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)), name, val)
      collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
    },
    ELetRec(name, val, body) => {
      let body_vars = extend_local_fn_return(var_types, name, val)
      collect_constructor_perform_payloads(val, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
      collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
    },
    EAssign(name, val, continuation) => {
      collect_constructor_perform_payloads(val, op, payload_index, out, gens, struct_sets, var_types, fn_returns)
      let continuation_vars = extend_constructor_var_types(var_types, name, anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns))
      collect_constructor_perform_payloads(continuation, op, payload_index, out, gens, struct_sets, continuation_vars, fn_returns)
    },
    EMatch(scrut, arms) => {
      collect_constructor_perform_payloads(scrut, op, payload_index, out, gens, struct_sets, var_types, fn_returns)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let arm_vars = constructor_match_arm_var_types(scrut, pat, gens, struct_sets, var_types, fn_returns)
        collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, arm_vars, fn_returns)
        i = i + 1
      }
    },
    ECall(callee, args, _) => {
      // A lambda in callee position executes now, so its performed operations
      // can reach an enclosing handler. A standalone lambda remains a scope
      // boundary, but treating an IIFE the same way loses the payload
      // constructor used to seed that handler's pattern binders.
      match callee {
        EFn(tparams, _, params, _, _, body) => {
          let body_vars = constructor_callable_body_var_types(tparams, params, args, gens, struct_sets, var_types, fn_returns)
          collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
        },
        EIdent(name, _) => if name == "perform" || constructor_payload_call_is_active(name) {
          ()
        } else match lookup_constructor_callable_body(name) {
          Some((tparams, params, body)) => {
            let stack_len = Array::length(dtd_constructor_payload_call_stack)
            Array::push(dtd_constructor_payload_call_stack, name)
            let body_vars = constructor_callable_body_var_types(tparams, params, args, gens, struct_sets, var_types, fn_returns)
            collect_constructor_perform_payloads(body, op, payload_index, out, gens, struct_sets, body_vars, fn_returns)
            Array::truncate(dtd_constructor_payload_call_stack, stack_len)
          },
          None => ()
        },
        _ => ()
      }
      match callee {
        EIdent(name, _) => if name == "perform" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(EIdent(op_name, _), oargs, _) => if constructor_op_name_matches(op_name, op) && payload_index >= 0 && payload_index < Array::length(oargs) {
              Array::push(out, infer_constructor_arg_type_name(Array::get(oargs, payload_index), gens, struct_sets, var_types, fn_returns))
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      let mut i = 0
      while i < Array::length(args) {
        collect_constructor_perform_payloads(Array::get(args, i), op, payload_index, out, gens, struct_sets, var_types, fn_returns)
        i = i + 1
      }
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        collect_constructor_perform_payloads(Array::get(children, i), op, payload_index, out, gens, struct_sets, var_types, fn_returns)
        i = i + 1
      }
    }
  }
}

fn infer_constructor_perform_payload(body: Expr, op: String, payload_index: Int, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  let payloads = array_empty()
  Array::truncate(dtd_constructor_payload_call_stack, 0)
  collect_constructor_perform_payloads(body, op, payload_index, payloads, gens, struct_sets, var_types, fn_returns)
  if Array::length(payloads) == 0 {
    None
  } else {
    let mut i = 1
    let mut result = Array::get(payloads, 0)
    while i < Array::length(payloads) {
      match result {
        Some(expected) => match Array::get(payloads, i) {
          Some(actual) => if actual != expected {
            result = None
          } else {
            ()
          },
          None => {
            result = None
          }
        },
        None => {
          i = Array::length(payloads)
        }
      }
      i = i + 1
    }
    result
  }
}

fn constructor_handler_arm_var_types(body: Expr, pat: Pat, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let masked = mask_constructor_pat_binders(var_types, pat, fn_returns)
  match pat {
    PCtor(cn, sub) => {
      let mut out = masked
      let mut i = 0
      while i < Array::length(sub) {
        match Array::get(sub, i) {
          PBind(name) => {
            out = extend_constructor_var_types(out, name, infer_constructor_perform_payload(body, cn, i, gens, struct_sets, var_types, fn_returns))
          },
          _ => ()
        }
        i = i + 1
      }
      out
    },
    _ => masked
  }
}

fn constructor_payload_pattern_var_types(value: Expr, pat: Pat, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Array[(String, String)]] {
  match pat {
    PBind(name) => Some(extend_constructor_var_types(var_types, name, infer_constructor_arg_type_name(value, gens, struct_sets, var_types, fn_returns))),
    PCtor(cn, sub) => match value {
      ECall(EIdent(name, _), args, _) => if constructor_op_name_matches(name, cn) && Array::length(args) == Array::length(sub) {
        let mut acc = var_types
        let mut i = 0
        let mut valid = true
        while i < Array::length(sub) && valid {
          match constructor_payload_pattern_var_types(Array::get(args, i), Array::get(sub, i), gens, struct_sets, acc, fn_returns) {
            Some(next) => {
              acc = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if valid {
          Some(acc)
        } else {
          None
        }
      } else {
        None
      },
      _ => None
    },
    _ => Some(var_types)
  }
}

fn constructor_call_payload_var_types(scrut: Expr, cn: String, sub: Array[Pat], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Array[(String, String)]] {
  constructor_payload_pattern_var_types(scrut, PCtor(cn, sub), gens, struct_sets, var_types, fn_returns)
}

/// Recover a handled result only when the body and every handler arm agree.
/// Handler patterns describe effects rather than the handled value, so their
/// binders do not refine the result constructor unless the arm returns a
/// recovered operation payload.
fn infer_constructor_handle_type_name(body: Expr, arms: Array[(Pat, Expr)], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match infer_constructor_arg_type_name(body, gens, struct_sets, var_types, fn_returns) {
    None => None,
    Some(expected) => {
      let mut i = 0
      let mut agrees = true
      while i < Array::length(arms) && agrees {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_vars = constructor_handler_arm_var_types(body, pat, gens, struct_sets, var_types, fn_returns)
        let arm_constructor = infer_constructor_handler_arm_type_name(arm_body, expected, gens, struct_sets, arm_vars, fn_returns)
        match arm_constructor {
          Some(actual) => {
            let same = actual == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            agrees = false
          }
        }
        i = i + 1
      }
      if agrees {
        Some(expected)
      } else {
        None
      }
    }
  }
}

/// Recover a constructor from a typed match result only when every arm agrees.
/// An empty match has no result witness, and one unresolved or differing arm
/// makes the whole answer unknown rather than guessing a dictionary.
fn infer_constructor_match_arm_type_name(scrut: Expr, arms: Array[(Pat, Expr)], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  if Array::length(arms) == 0 {
    None
  } else {
    let (first_pat, first_body) = Array::get(arms, 0)
    let first_vars = constructor_match_arm_var_types(scrut, first_pat, gens, struct_sets, var_types, fn_returns)
    match infer_constructor_arg_type_name(first_body, gens, struct_sets, first_vars, fn_returns) {
      None => None,
      Some(expected) => {
        let mut i = 1
        let mut agrees = true
        while i < Array::length(arms) && agrees {
          let (pat, body) = Array::get(arms, i)
          let arm_vars = constructor_match_arm_var_types(scrut, pat, gens, struct_sets, var_types, fn_returns)
          match infer_constructor_arg_type_name(body, gens, struct_sets, arm_vars, fn_returns) {
            Some(actual) => {
              let same = actual == expected
              if !same {
                agrees = false
              } else {
                ()
              }
            },
            None => {
              agrees = false
            }
          }
          i = i + 1
        }
        if agrees {
          Some(expected)
        } else {
          None
        }
      }
    }
  }
}

/// None when any receiver's witness cannot be determined (the call is then left
/// unrewritten). Each bound is satisfied either by a concrete dict literal (the
/// receiver type is syntactically known) or by forwarding the caller's own dict
/// parameter (the receiver is a type parameter bound by the same trait in the
/// enclosing generic — the generic->generic case).
fn synth_dicts(threaded: Array[(String, String, Int)], constructor_recvs: Array[(String, Int)], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Option[Array[Expr]] {
  let dicts = empty_expr_array()
  let mut ok = true
  let mut bi = 0
  while bi < Array::length(threaded) {
    let (type_param, trait_name, recv_idx_raw) = Array::get(threaded, bi)
    // #1199 bug 1: decode the packed receiver kind (see
    // encode_array_elem_recv_index's doc comment) once, up front, so the rest
    // of this loop body works from a plain non-negative index + the right
    // inference function either way.
    let is_constructor_recv = is_constructor_recv_index(recv_idx_raw)
    let is_elem_recv = is_array_elem_recv_index(recv_idx_raw)
    let recv_idx = if is_constructor_recv {
      decode_constructor_recv_index(recv_idx_raw)
    } else if is_elem_recv {
      decode_array_elem_recv_index(recv_idx_raw)
    } else {
      recv_idx_raw
    }
    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {
      let recv_arg = Array::get(orig_args, recv_idx)
      let inferred = if is_constructor_recv {
        infer_constructor_arg_type_name(recv_arg, gens, struct_sets, var_types, fn_returns)
      } else if is_elem_recv {
        infer_arg_elem_type_name(recv_arg, struct_sets, var_types, fn_returns)
      } else {
        infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns)
      }
      match inferred {
        Some(nm) => {
          let resolved_trait = if is_constructor_recv {
            let substs = constructor_substs_from_recvs(constructor_recvs, orig_args, gens, struct_sets, var_types, fn_returns)
            push_constructor_subst(substs, type_param, nm)
            specialize_trait_constructors(trait_name, substs)
          } else {
            trait_name
          }
          match find_dict_for_trait(dict_binds, nm, resolved_trait) {
            Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),
            None => {
              let target = if is_elem_recv || is_constructor_recv {
                // The receiver carries `Array[T]`, but this witness is for T.
                // A constructor receiver similarly carries `F[A]`, while its
                // witness target is the constructor F rather than F[A].
                TyName(nm)
              } else match infer_impl_target_expr(recv_arg, struct_sets, var_types, fn_returns) {
                Some(inferred) => inferred,
                None => TyName(nm)
              }
              match build_concrete_dict_for_target(target, resolved_trait, traits, gens, struct_sets, var_types, fn_returns, Some(recv_arg)) {
                Some(dict) => Array::push(dicts, dict),
                None => {
                  ok = false
                }
              }
            }
          }
        },
        None => {
          ok = false
        }
      }
    } else {
      ok = false
    }
    bi = bi + 1
  }
  if ok {
    Some(dicts)
  } else {
    None
  }
}

fn concat_expr_arrays(a: Array[Expr], b: Array[Expr]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    Array::push(out, Array::get(b, j))
    j = j + 1
  }
  out
}

/// #1199 bug 1: sentinel key prefix recording a parameter's ARRAY ELEMENT type,
/// keyed off the parameter name so `array_elem_type_of` below can recover it
/// without a second table threaded through every caller. Reuses the existing
/// `var_types: Array[(String, String)]` association list -- same trick as the
/// anonymous-record `__anonrec:` sentinel (anon_record_prefix above): a
/// synthetic KEY (not value) that no real source identifier can collide with,
/// since `$` isn't a valid identifier character.
fn array_elem_key(pname: String) -> String {
  String::concat("__arrelem$", pname)
}

/// #1199 bug 1: look up the element type recorded for an Array-typed variable
/// by `seed_var_types` (function parameters) or `array_elem_bind` (let-bound
/// array literals).
///
/// A recorded EMPTY is a masking entry written by `mask_stale_array_elem`, not
/// an element type: it means "an inner binding of this name shadowed whatever
/// the outer one held, and this pass cannot type the new one". Same answer as
/// no record at all.
fn array_elem_type_of(var_types: Array[(String, String)], name: String) -> Option[String] {
  match lookup_var_type(var_types, array_elem_key(name)) {
    Some(t) => if String::length(t) == 0 {
      None
    } else {
      Some(t)
    },
    None => None
  }
}

/// Codex P2 on PR #1565: a rebinding this pass cannot type must still MASK the
/// outer binding's recorded element type. `lookup_var_type` returns the LAST
/// match, so leaving the shadowed entry as the live answer is a real
/// miscompile, not just imprecision -- measured before this:
///
///   let xs = [P::{ n: 1 }]      // records __arrelem$xs -> "P"
///   let xs = mk(7)              // Array[Int] from a call: nothing recorded
///   let ys = mk(9)
///   xs == ys                    // true (!) -- dispatched __arr_equals__P,
///                               // whose body reads a `.n` field off raw Ints
///
/// This is the same staleness `shape_bind` fixed for `__shape$` (it records
/// even a non-composite binding for exactly this reason) and explicitly did
/// NOT rewrite here at the time. #1526 made the entry load-bearing at `==`
/// sites, so it has to be masked now.
///
/// Only writes when there IS a live entry to mask, so the common binding pays
/// nothing.
fn mask_stale_array_elem(var_types: Array[(String, String)], name: String) -> Array[(String, String)] {
  match array_elem_type_of(var_types, name) {
    Some(_) => {
      let out = array_empty()
      push_all_var_types(out, var_types)
      Array::push(out, (array_elem_key(name), ""))
      out
    },
    None => var_types
  }
}

/// #1199 follow-up (Codex review on the original fix): the let-bound sibling
/// of `seed_var_types`' Array[T]-parameter element tracking. Without this,
/// `let xs = [1, 2]; Set::from_array(xs)` left `xs`'s element type
/// unrecoverable at the call site -- `extend_var_types` only records the
/// coarse "Array" head (via `infer_arg_type_name`'s `EArray(_) => Some
/// ("Array")` case), so `infer_arg_elem_type_name`'s `EIdent` arm had nothing
/// to look up, `synth_dicts` failed, and the call was emitted without its
/// Hash dict argument(s) -- invalid wasm, the same failure shape bug 1's
/// `Array::get` case had. Only a bare (unannotated) array literal RHS with a
/// syntactically inferable first-element type is handled here, matching the
/// rest of this file's syntax-directed (not full type-inference) approach;
/// an empty literal (`let xs = []`) or an already-Array-typed variable RHS
/// stays untracked -- recovering those needs the RHS's *expected* type
/// flowing in from an enclosing annotation, which this bottom-up pass does
/// not thread.
/// #1880: a LOCAL `let x: T = v` is not annotation-free just because `ELet` has
/// no annotation field. The parser rewrites it to `((__asc: T) -> __asc)(v)`
/// (`ascribe_wrap` in parser_expr_dispatch.vibe), so `T` is right there in the
/// AST -- this recognizes that exact shape and hands it back. Same recognizer
/// the checker already runs (`ascription_lambda_ann`), kept local because this
/// package does not import the checker.
///
/// The shape is precise: `__asc` is a dedicated internal name, and a real user
/// IIFE will not have a single param literally named `__asc` whose body is
/// exactly `EIdent("__asc", _)`.
fn dtd_ascribed_type(val: Expr) -> Option[TypeExpr] {
  match val {
    ECall(callee, _args, _) => match callee {
      EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {
        match ret_ty {
          Some(_) => None,
          None => match effect {
            Some(_) => None,
            None => {
              let (pname, pann) = Array::get(params, 0)
              if pname == "__asc" {
                match body {
                  EIdent(bname, _) => if bname == "__asc" {
                    pann
                  } else {
                    None
                  },
                  _ => None
                }
              } else {
                None
              }
            }
          }
        }
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// The element type named by an `Array[T]` annotation, when T is a bare name.
/// Same single-bare-type-arg scope as `seed_var_types`' parameter handling --
/// a nested element type stays untracked rather than recorded imprecisely.
fn dtd_array_elem_of_ann(ty: TypeExpr) -> Option[String] {
  match ty {
    TyApp(head, targs) => if head == "Array" && Array::length(targs) == 1 {
      match Array::get(targs, 0) {
        TyName(elem) => Some(elem),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn array_elem_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  // #1880: an explicit `Array[T]` annotation is the most reliable element type
  // there is, so it is consulted before the value's shape. `array_elem_key` is
  // the older sentinel -- `shape_bind` runs after this and its record wins for
  // rendering -- but this one is read by call-site dict synthesis (#1199), so
  // an annotated binding has to reach it too.
  match dtd_array_elem_of_ann_opt(dtd_ascribed_type(val)) {
    Some(elem) => {
      let out = array_empty()
      push_all_var_types(out, var_types)
      Array::push(out, (array_elem_key(name), elem))
      out
    },
    None => array_elem_bind_by_shape(var_types, name, val, struct_sets, fn_returns)
  }
}

fn dtd_array_elem_of_ann_opt(ann: Option[TypeExpr]) -> Option[String] {
  match ann {
    Some(t) => dtd_array_elem_of_ann(t),
    None => None
  }
}

fn array_elem_bind_by_shape(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  match val {
    EArray(elems) => if Array::length(elems) > 0 {
      match infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns) {
        Some(elemty) => {
          let out = array_empty()
          let mut i = 0
          while i < Array::length(var_types) {
            Array::push(out, Array::get(var_types, i))
            i = i + 1
          }
          Array::push(out, (array_elem_key(name), elemty))
          out
        },
        None => mask_stale_array_elem(var_types, name)
      }
    } else {
      mask_stale_array_elem(var_types, name)
    },
    _ => mask_stale_array_elem(var_types, name)
  }
}

// ---- #1445: shapes that survive a BINDING ----
//
// #1392 slice 2 rendered a tuple/array/Option/Result written literally at the
// interpolation site, and slice 1 rendered a `derive(Show)` value. What stayed
// broken is the same value reached through a NAME:
//
//   "\{(1, 2)}"                 -> "(1, 2)"     already worked
//   let t = (1, 2); "\{t}"      -> "228"        the raw pointer, #1445
//
// The head name alone (`infer_arg_type_name` returns "Tuple"/"Array") gives
// neither arity nor element types, and a local `let`'s type annotation is not
// in the AST (`ELet` has no annotation field, only `SLet` does), so there is no
// TypeExpr to hand `show_for_typed`. But the BINDING SITE has the shape in
// front of it -- `let t = (1, 2)` is a tuple literal right there -- so the
// shape is recorded then and looked up at the interpolation site, exactly the
// way `array_elem_bind` already records a let-bound array's element type.
//
// Two sentinel KEYS (not values), same `$`-in-the-key trick as
// `array_elem_key`: `$` is not a valid identifier character, so no real source
// name can collide.

/// `__tupshape$<name>` -> the tuple's per-element type names, comma-joined.
/// An element whose type this pass could not infer contributes an EMPTY entry,
/// so arity is always exactly `commas + 1` and a partially-inferable tuple
/// still renders (the unknown elements just fall back to `__to_string`).
fn tuple_shape_key(pname: String) -> String {
  String::concat("__tupshape$", pname)
}

/// A constructor name, by the language's own convention: vibe functions and
/// variables are snake_case (lowercase), so an uppercase first letter is what
/// distinguishes `B(p)` from `helper(p)` without a constructor table.
fn starts_upper(sname: String) -> Bool {
  if String::length(sname) == 0 {
    false
  } else {
    let c = String::char_code_at(sname, 0)
    c >= 65 && c <= 90
  }
}

/// `__ctorpayi$<Ctor>$<i>$<name>` -> the shape of slot `i` of `<name>`'s
/// multi-field `<Ctor>` payload (#139). Arity 1 keeps the unindexed key below.
fn ctor_payload_idx_key(pname: String, ctor: String, idx: Int) -> String {
  String::concat("__ctorpayi$", String::concat(ctor, String::concat("$", String::concat(__to_string(idx), String::concat("$", pname)))))
}

/// `__ctorpay$<Ctor>$<name>` -> the payload type of `<name>`'s `<Ctor>` arm.
/// `Option[P]` records `Some -> P`; `Result[T, E]` records `Ok -> T` and
/// `Err -> E`. Read when a `match` scrutinises that variable, so the arm's
/// binder gets a type (#1445 cause 3: a pattern binder is otherwise absent
/// from `var_types` entirely).
fn ctor_payload_key(pname: String, ctor: String) -> String {
  String::concat("__ctorpay$", String::concat(ctor, String::concat("$", pname)))
}

fn push_all_var_types(out: Array[(String, String)], var_types: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(var_types) {
    Array::push(out, Array::get(var_types, i))
    i = i + 1
  }
}

/// Split a `tuple_shape_key` value back into its per-element type names.
/// Written by hand rather than via `String::split` because an EMPTY element
/// (an uninferable one) must survive as an empty entry -- it is what keeps the
/// entry count equal to the tuple's arity.
fn tuple_shape_parts(sentinel: String) -> Array[String] {
  let out = empty_str_array()
  let mut rest = sentinel
  let mut go = true
  while go {
    let comma = String::index_of(rest, ",")
    if comma < 0 {
      Array::push(out, rest)
      go = false
    } else {
      Array::push(out, String::substring(rest, 0, comma))
      rest = String::substring(rest, comma + 1, String::length(rest))
    }
  }
  out
}

/// #2128: a `(A, B, ..)` annotation -> the `tuple_shape_key` sentinel (the
/// element type NAMES, comma-joined). `None` when the annotation is absent or
/// is not a tuple. An element the shape language cannot spell as a bare name
/// contributes an EMPTY entry, exactly like `tuple_shape_bind`'s value path, so
/// the entry count still equals the arity.
fn dtd_tuple_elem_names_of_ann(ann: Option[TypeExpr]) -> Option[String] {
  match ann {
    Some(t) => match t {
      TyTuple(elems) => if Array::length(elems) == 0 {
        None
      } else {
        let mut acc = ""
        let mut i = 0
        while i < Array::length(elems) {
          let tn = match Array::get(elems, i) {
            TyName(n) => n,
            _ => ""
          }
          acc = if i == 0 {
            tn
          } else {
            String::concat(acc, String::concat(",", tn))
          }
          i = i + 1
        }
        Some(acc)
      },
      _ => None
    },
    None => None
  }
}

/// #2128: `Array::get(ps, i)` / `ps[i]` where `ps`'s recorded shape is an array
/// of tuples -> the element's `tuple_shape_key` sentinel. "" when the value is
/// not an array read, the array has no recorded shape, or its element is not a
/// tuple.
fn dtd_tuple_elem_names_of_array_get(val: Expr, var_types: Array[(String, String)]) -> String {
  match val {
    ECall(callee, cargs, _) => match callee {
      EIdent(cn, _) => if (cn == "Array::get" || cn == "__index") && Array::length(cargs) == 2 {
        match Array::get(cargs, 0) {
          EIdent(arrname, _) => match lookup_var_type(var_types, shape_key(arrname)) {
            Some(sh) => if String::starts_with(sh, "[") {
              let inner = shape_inner(sh)
              if dtd_shape_is_tuple(inner) {
                dtd_join_shape_parts(shape_split(shape_inner(inner)))
              } else {
                ""
              }
            } else {
              ""
            },
            None => ""
          },
          _ => ""
        }
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// #1445: record a let-bound TUPLE literal's shape. Sibling of
/// `array_elem_bind` -- same "only a bare literal RHS" scope, for the same
/// reason (this is a syntax-directed pass, not type inference).
fn tuple_shape_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  // #2128: an explicit `(A, B)` annotation is the most reliable element list
  // there is -- the same reason `array_elem_bind` consults one first (#1880).
  // A local `let t: (String, String) = (..)` is NOT annotation-free: the
  // parser rewrites it to `((__asc: T) -> __asc)(v)`, which also hides the
  // `ETuple` from the match below, so before this an annotated tuple recorded
  // NOTHING and `t.0 < t.1` stayed an address comparison.
  match dtd_tuple_elem_names_of_ann(dtd_ascribed_type(val)) {
    Some(sentinel) => {
      let out = array_empty()
      push_all_var_types(out, var_types)
      Array::push(out, (tuple_shape_key(name), sentinel))
      return out
    },
    None => ()
  }
  // #2128: `let p = Array::get(ps, i)` where `ps` is an array OF tuples.
  // `infer_shape` does not project an array element, so `shape_bind` records a
  // non-composite shape for `p` and `p.0` had nothing to read. The element
  // types are in the ARRAY's own `__shape$` record.
  let from_elem = dtd_tuple_elem_names_of_array_get(val, var_types)
  if String::length(from_elem) > 0 {
    let out = array_empty()
    push_all_var_types(out, var_types)
    Array::push(out, (tuple_shape_key(name), from_elem))
    return out
  } else {
    ()
  }
  match val {
    ETuple(items) => if Array::length(items) > 0 {
      let mut acc = ""
      let mut i = 0
      while i < Array::length(items) {
        let tn = match infer_arg_type_name(Array::get(items, i), struct_sets, var_types, fn_returns) {
          Some(t) => t,
          None => ""
        }
        acc = if i == 0 {
          tn
        } else {
          String::concat(acc, String::concat(",", tn))
        }
        i = i + 1
      }
      let out = array_empty()
      push_all_var_types(out, var_types)
      Array::push(out, (tuple_shape_key(name), acc))
      out
    } else {
      var_types
    },
    _ => var_types
  }
}

/// #1445: record a let-bound `Some(e)` / `Ok(e)` / `Err(e)`'s payload type, so
/// a later `match` on that variable can type its binder. The parameter-side
/// counterpart lives in `seed_var_types`, which has a real `TypeExpr`
/// (`Option[P]`) to read the payload off.
fn ctor_payload_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  match val {
    ECall(callee, cargs, _) => match callee {
      EIdent(cn, _) => if Array::length(cargs) >= 1 && starts_upper(cn) {
        let out = array_empty()
        push_all_var_types(out, var_types)
        let mut i = 0
        let mut wrote = false
        while i < Array::length(cargs) {
          let sh = infer_shape(Array::get(cargs, i), struct_sets, var_types, fn_returns)
          if String::length(sh) == 0 {
            ()
          } else {
            // Arity 1 keeps the plain key, so the `Option`/`Result` entries
            // seed_var_types writes from a real TypeExpr stay interchangeable
            // with these.
            let key = if Array::length(cargs) == 1 {
              ctor_payload_key(name, cn)
            } else {
              ctor_payload_idx_key(name, cn, i)
            }
            Array::push(out, (key, sh))
            wrote = true
          }
          i = i + 1
        }
        if wrote {
          out
        } else {
          var_types
        }
      } else {
        var_types
      },
      _ => var_types
    },
    _ => var_types
  }
}

// ---- #1445 (#139): shapes that NEST ----
//
// Recursive shape grammar: Name, (s1,s2,...), [s], or "" for unknown.

fn shape_key(pname: String) -> String {
  String::concat("__shape$", pname)
}

fn constructor_mask_key(pname: String) -> String {
  String::concat("__ctormask$", pname)
}

fn constructor_head_key(pname: String) -> String {
  String::concat("__ctorhead$", pname)
}

fn constructor_binding_is_masked(var_types: Array[(String, String)], name: String) -> Bool {
  match lookup_var_type(var_types, constructor_mask_key(name)) {
    Some(_) => true,
    None => false
  }
}

fn constructor_binding_has_evidence(var_types: Array[(String, String)], name: String) -> Bool {
  let head_key = constructor_head_key(name)
  let return_key = local_fn_return_key(name)
  let value_shape_key = shape_key(name)
  let tuple_key = tuple_shape_key(name)
  let mut i = 0
  let mut found = false
  while i < Array::length(var_types) && !found {
    let (entry_name, _) = Array::get(var_types, i)
    found = entry_name == name || entry_name == head_key || entry_name == return_key || entry_name == value_shape_key || entry_name == tuple_key
    i = i + 1
  }
  found
}

fn shape_is_composite(sh: String) -> Bool {
  sh == "{u}" || String::starts_with(sh, "(") || String::starts_with(sh, "[") || String::starts_with(sh, "{o:") || String::starts_with(sh, "{r:") || String::starts_with(sh, "{m:") || String::starts_with(sh, "{g:")
}

/// Equality's shape grammar is a strict superset of interpolation's. Reuse the
/// already-recorded function result shape, but only admit the tuple/array forms
/// the interpolation renderer knows how to expand.
fn interp_shape(sh: String) -> String {
  if String::starts_with(sh, "(") || String::starts_with(sh, "[") {
    sh
  } else {
    ""
  }
}

/// Split a tuple shape's INNER text (`s1,s2,...`, no outer parens) on
/// top-level commas only.
fn shape_split(inner: String) -> Array[String] {
  let out = empty_str_array()
  let n = String::length(inner)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::char_code_at(inner, i)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      Array::push(out, String::substring(inner, start, i))
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::push(out, String::substring(inner, start, n))
  out
}

/// The text between a composite shape's outer brackets.
fn shape_inner(sh: String) -> String {
  String::substring(sh, 1, String::length(sh) - 1)
}

/// The shape of an expression, as deep as this syntax-directed pass can see.
/// A literal tuple/array recurses; a NAME resolves through whatever the
/// binding site recorded for it (its own shape first, then the older
/// per-element / per-tuple sentinels, so a value bound before this function
/// existed still resolves); anything else falls back to the head type name.
fn infer_shape(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  // #1880: an ANNOTATION outranks anything guessed from the value's syntax.
  //
  // Everything below infers a shape from the shape of the expression, so only
  // a value written literally at the binding site ever produced one. An array
  // that came out of a builtin callsite lowering (`Array::map`, `Array::slice`)
  // or out of `for x in ..` produced "" -- and shape_bind ALWAYS records, with
  // "" meaning "not composite, stop". So `"\{ys}"` printed the raw heap
  // pointer, and `let ys: Array[Int] = ..` did not help: the annotation was
  // never consulted. No spelling a user could write produced correct output,
  // which is what made it P0 rather than imprecision.
  //
  // The annotation is in the AST even for a LOCAL let -- `ELet` has no
  // annotation field, but the parser rewrites `let x: T = v` into
  // `((__asc: T) -> __asc)(v)` (ascribe_wrap). `ty_to_eq_shape` renders a
  // TypeExpr into exactly the encoding this function produces (`Array[Int]` ->
  // "[Int]", same as the literal path), so the two answers are interchangeable
  // and everything downstream is unchanged.
  //
  // `interp_shape` is REQUIRED here, not decoration. `ty_to_eq_shape` speaks
  // equality's grammar, which is a strict superset of the renderer's: it also
  // emits `{o:..}` / `{r:..}` for Option / Result. `interp_expand_shape`
  // distinguishes only tuples (leading `(`) and treats every other composite as
  // an ARRAY, so letting a `{o:Int}` through would emit `Array::length` /
  // `Array::get` against an Option -- a trap or a wrong render, i.e. a worse
  // version of the bug being fixed. `interp_shape` admits only the tuple and
  // array forms the renderer can expand. (Codex review on this PR.)
  //
  // A shape it rejects falls THROUGH to the syntax path rather than becoming
  // "": an annotated `let p: Point = mk()` must still reach the head name that
  // `interp_show_target` dispatches `Point::to_string` on. So this is strictly
  // additive -- no annotated binding renders worse than it did.
  //
  // Option / Result annotations therefore keep today's rendering. Making those
  // work means teaching interp_expand_shape their encodings, which is a
  // separate change.
  match dtd_ascribed_type(e) {
    Some(ann) => {
      let sh = interp_shape(ty_to_eq_shape(ann))
      if String::length(sh) > 0 {
        sh
      } else {
        infer_shape_by_syntax(e, struct_sets, var_types, fn_returns)
      }
    },
    None => infer_shape_by_syntax(e, struct_sets, var_types, fn_returns)
  }
}

/// #1880: Array builtins that RETURN an array whose element type is their first
/// argument's, so the shape propagates without any inference.
///
/// Two exclusions, both deliberate:
///
///   - `Array::map` -- its element type is the CALLBACK's return type, not the
///     argument's, so reusing the argument's shape would render confidently and
///     wrongly. Worse than saying nothing. An annotation covers it.
///   - `Array::truncate` -- it MUTATES its first argument and returns Unit
///     (`declare Array::truncate(Array[T], Int) -> Unit`, builtins/
///     declarations.vibe:35). Giving it `[T]` would rewrite the render into
///     array operations against a Unit. It was in this list until a Codex
///     review on this PR caught it; "takes an array first" is not the
///     predicate, "returns that array's element type" is.
///
/// Returns "" for "no answer", which the caller treats as fall-through. The
/// `[` guard keeps a non-array first argument (a user binding of the same
/// spelling that reached here, a wrong-arity call) from being reported as an
/// array shape.
fn dtd_elem_preserving_shape(fname: String, cargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let preserves = fname == "Array::filter" || fname == "Array::slice" || fname == "Array::reverse" || fname == "Array::concat"
  if preserves && Array::length(cargs) >= 1 {
    let sh = infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns)
    if String::starts_with(sh, "[") {
      sh
    } else {
      ""
    }
  } else {
    ""
  }
}

/// #2128: `Array::get(xs, i)` / `xs[i]` -> the shape of the array's ELEMENT.
///
/// The sibling of `dtd_elem_preserving_shape`: that one answers for calls whose
/// result is another array of the same element (`filter`, `slice`, `reverse`,
/// `concat`), this one for the call that takes an element OUT. Without it a
/// binding of an array read recorded "" -- "not composite, stop" -- which is
/// why two container hops (`Array[Array[(String, String)]]`) fell back to an
/// address comparison: the outer name's shape was one level too deep to be read
/// and the inner name had no shape at all.
///
/// One hop per call, so it composes: each `Array::get` peels one `[..]`, and a
/// chain of them peels a chain. Nothing here walks a chain itself.
fn dtd_elem_projecting_shape(fname: String, cargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let projects = fname == "Array::get" || fname == "__index"
  if projects && Array::length(cargs) == 2 {
    let sh = infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns)
    if String::starts_with(sh, "[") {
      shape_inner(sh)
    } else {
      ""
    }
  } else {
    ""
  }
}

/// #1880: the scalar type of an arithmetic/literal expression, for a `for-in`
/// BODY only.
///
/// `infer_arg_type_name` deliberately answers only for `+` on strings, and that
/// restraint is correct there: it also drives witness-dictionary synthesis
/// (#1199), where a confident wrong answer emits a wrong dict and produces
/// invalid wasm rather than a diagnostic. This one feeds the RENDERER, where
/// the cost of a wrong answer is a wrong string, and the cost of no answer is
/// the heap pointer #1880 is about. Kept separate rather than widening that
/// function, so the two risk profiles do not get merged by accident.
///
/// Scope is deliberately small: literals, a bound name, and arithmetic over
/// them. Anything else is "" -- no claim.
/// Shadow any outer binding of `name` with an explicit UNKNOWN.
///
/// `extend_var_types(.., None)` cannot do this -- it returns `var_types`
/// unchanged, which is the behaviour being fixed. An empty-string entry is the
/// masking convention this file already uses (`mask_stale_array_elem`), and it
/// reads back as unknown here because `dtd_scalar_shape`'s `EIdent` arm returns
/// the looked-up string as-is.
fn dtd_mask_var_type(var_types: Array[(String, String)], name: String) -> Array[(String, String)] {
  let out = array_empty()
  push_all_var_types(out, var_types)
  Array::push(out, (name, ""))
  out
}

fn dtd_scalar_shape(e: Expr, var_types: Array[(String, String)]) -> String {
  match e {
    EInt(_) => "Int",
    EFloat(_) => "Double",
    EString(_) => "String",
    EBool(_) => "Bool",
    EIdent(n, _) => match lookup_var_type(var_types, n) {
      Some(t) => t,
      None => ""
    },
    EBinOp(bop, bl, br) => if bop == "+" || bop == "-" || bop == "*" || bop == "/" || bop == "%" {
      let l = dtd_scalar_shape(bl, var_types)
      let r = dtd_scalar_shape(br, var_types)
      // Both sides must agree. A mixed or unknown pair says nothing rather
      // than picking a side.
      if String::length(l) > 0 && l == r {
        l
      } else {
        ""
      }
    } else if bop == "==" || bop == "!=" || bop == "<" || bop == ">" || bop == "<=" || bop == ">=" || bop == "&&" || bop == "||" {
      "Bool"
    } else {
      ""
    },
    // A body with statements before its value (`{ if .. { break } else { }
    // x * 10 }`, fixtures/for_in_break.vibe) -- the loop's element is the LAST
    // expression, same rule `fn_body_tail_expr` already uses for function
    // bodies.
    ESeq(_, rest) => dtd_scalar_shape(rest, var_types),
    // The binding has to be RECORDED, not just stepped over: the tail usually
    // refers to it (`{ let y = x + 1  y * 2 }`), and an unrecorded `y` makes
    // the tail unknown, which is the same as not walking in at all.
    ELet(lname, lval, rest, _) => {
      let lty = dtd_scalar_shape(lval, var_types)
      let inner = if String::length(lty) > 0 {
        extend_var_types(var_types, lname, Some(lty))
      } else {
        // A value this pass cannot classify must MASK any outer binding of the
        // same name, not leave it visible. Passing `var_types` through was
        // strictly worse than claiming nothing (Codex review on PR #1896):
        //
        //   let y = "outer"
        //   for x in [1, 2] { let y = Some(x)
        //     y }
        //
        // resolved the tail `y` to the OUTER String, so the loop got shape
        // `[String]` and the renderer printed each `Some` as a string --
        // `[276, 288]`, pointers laid out inside a structurally-rendered
        // array. Without the outer binding the same body renders `192`, the
        // old bare pointer. The stale answer is the more dangerous one: it
        // looks like real output.
        //
        // Same hazard `mask_stale_array_elem` handles for the array sentinel,
        // and the same reason `shape_bind` records even a non-composite: with
        // `lookup_var_type` returning the LAST match, a shadowed entry stays
        // the live answer unless something overwrites it.
        dtd_mask_var_type(var_types, lname)
      }
      dtd_scalar_shape(rest, inner)
    },
    ECall(callee, _, _) => match callee {
      EIdent(fname, _) => dtd_scalar_builtin_return(fname),
      _ => ""
    },
    _ => ""
  }
}

/// The scalar return type of a builtin, for the same renderer-only purpose as
/// `dtd_scalar_shape`. Deliberately a short list of the length/measure builtins
/// a `for-in` body actually ends in (`for s in names { String::length(s) }`,
/// fixtures/for_in_string.vibe) rather than a mirror of the checker's tables --
/// a name missing from here costs the old rendering, a WRONG entry costs a
/// wrong render, so it only carries entries whose return type is unambiguous.
fn dtd_scalar_builtin_return(fname: String) -> String {
  if fname == "String::length" || fname == "Array::length" || fname == "Bytes::length" || fname == "Map::size" || fname == "String::iter_length" || fname == "Map::iter_length" || fname == "Char::to_int" || fname == "Double::to_int" || fname == "String::char_code_at" || fname == "String::index_of" {
    "Int"
  } else if fname == "Int::to_double" {
    "Double"
  } else if fname == "String::concat" || fname == "String::substring" || fname == "String::trim" || fname == "String::to_lower" || fname == "String::to_upper" || fname == "Int::to_string" || fname == "__to_string" {
    "String"
  } else if fname == "String::contains" || fname == "String::starts_with" || fname == "String::ends_with" || fname == "not" {
    "Bool"
  } else {
    ""
  }
}

fn infer_shape_by_syntax(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match e {
    ETuple(items) => if Array::length(items) == 0 {
      ""
    } else {
      let mut acc = "("
      let mut i = 0
      while i < Array::length(items) {
        let sub = infer_shape(Array::get(items, i), struct_sets, var_types, fn_returns)
        acc = if i == 0 {
          String::concat(acc, sub)
        } else {
          String::concat(acc, String::concat(",", sub))
        }
        i = i + 1
      }
      String::concat(acc, ")")
    },
    // The first element stands for all of them: this pass has no unifier, and
    // a heterogeneous array literal does not type-check anyway.
    EArray(items) => if Array::length(items) == 0 {
      ""
    } else {
      String::concat("[", String::concat(infer_shape(Array::get(items, 0), struct_sets, var_types, fn_returns), "]"))
    },
    // #1880: `for x in xs { .. }` is an EXPRESSION that evaluates to the mapped
    // array, and it was the single most common way to reach the bug -- the
    // form `fixtures/for_in_*.vibe` are written in, and the one place an
    // annotation cannot be attached because the value is rendered inline
    // (`"\{for x in xs { .. }}"`).
    //
    // The element type is the BODY's, with the loop variable bound to the
    // source's element type. Both halves come from this same function, so a
    // source whose shape is unknown, or a body this pass cannot type, yields
    // "" and nothing is claimed.
    EForIn(vname, kname, iter, body) => {
      let src = infer_shape(iter, struct_sets, var_types, fn_returns)
      if String::starts_with(src, "[") {
        let elem = shape_inner(src)
        let with_v = extend_var_types(var_types, vname, Some(elem))
        // `for x, i in xs` binds the index too, and a body that uses it is
        // exactly the `fixtures/for_in_index.vibe` shape.
        let inner_vars = match kname {
          Some(k) => extend_var_types(with_v, k, Some("Int")),
          None => with_v
        }
        let bsh = infer_shape(body, struct_sets, inner_vars, fn_returns)
        let resolved = if String::length(bsh) > 0 {
          bsh
        } else {
          dtd_scalar_shape(body, inner_vars)
        }
        if String::length(resolved) > 0 {
          String::concat("[", String::concat(resolved, "]"))
        } else {
          ""
        }
      } else {
        ""
      }
    },
    EIdent(n, _) => match lookup_var_type(var_types, shape_key(n)) {
      // Same rule as interp_expand's: a recorded empty is an answer ("not
      // composite"), so fall through to the head name rather than to the
      // older sentinels.
      Some(sh) => if String::length(sh) == 0 {
        match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
          Some(t) => t,
          None => ""
        }
      } else {
        sh
      },
      None => match lookup_var_type(var_types, tuple_shape_key(n)) {
        Some(sentinel) => String::concat("(", String::concat(sentinel, ")")),
        None => match array_elem_type_of(var_types, n) {
          Some(elem) => String::concat("[", String::concat(elem, "]")),
          None => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
            Some(t) => t,
            None => ""
          }
        }
      }
    },
    ECall(callee, cargs, _) => match callee {
      EIdent(fname, _) => match lookup_var_type(var_types, eq_shape_key(fname)) {
        Some(sh) => interp_shape(sh),
        None => match fn_return_type(fn_returns, fn_eq_shape_key(fname)) {
          Some(sh) => interp_shape(sh),
          None => {
            // #1880: checked AFTER the two lookups above, so a user binding
            // with one of these names still wins.
            let preserved = dtd_elem_preserving_shape(fname, cargs, struct_sets, var_types, fn_returns)
            let projected = if String::length(preserved) > 0 {
              ""
            } else {
              dtd_elem_projecting_shape(fname, cargs, struct_sets, var_types, fn_returns)
            }
            if String::length(preserved) > 0 {
              preserved
            } else if String::length(projected) > 0 {
              projected
            } else {
              match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
                Some(t) => t,
                None => ""
              }
            }
          }
        }
      },
      _ => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
        Some(t) => t,
        None => ""
      }
    },
    _ => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
      Some(t) => t,
      None => ""
    }
  }
}

/// Record a binding's recursive shape, when there is one worth recording. A
/// plain name adds nothing the existing entries do not already carry, so only
/// composites are stored.
fn shape_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let sh = infer_shape(val, struct_sets, var_types, fn_returns)
  let out = array_empty()
  push_all_var_types(out, var_types)
  // ALWAYS record, even for a non-composite binding (recording ""). Skipping
  // those would leave a SHADOWED name's old shape as the live answer:
  // `extend_var_types` appends and `lookup_var_type` returns the LAST match
  // (#760(4)), but `__shape$x` is a different KEY from `x`, so rebinding `x`
  // never overwrote it. Measured before this: `let x = (1, 2); let x = 3;
  // "\{x}"` printed `(0, 0)`, and the array case printed `[]` -- silently
  // wrong output, no trap (Codex review on PR #1465).
  //
  // The empty entry is not just "no shape": interp_expand treats a RECORDED
  // empty as "this binding is not composite, stop" rather than falling
  // through to the older per-tuple / per-element sentinels, which have the
  // same staleness and which this pass does not rewrite (they are read by
  // call-site dict synthesis too, so appending empties there would change
  // #1199's behaviour).
  Array::push(out, (shape_key(name), sh))
  out
}

/// #1445: every binding-site shape record, applied in one place so `ELet` and
/// `ELetMut` cannot drift apart.
fn bind_shapes(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let a = array_elem_bind(var_types, name, val, struct_sets, fn_returns)
  let b = tuple_shape_bind(a, name, val, struct_sets, fn_returns)
  let c = ctor_payload_bind(b, name, val, struct_sets, fn_returns)
  // LAST: infer_shape reads the sentinels the three above just wrote, so a
  // binding whose elements are themselves named bindings resolves in one pass.
  shape_bind(c, name, val, struct_sets, fn_returns)
}

/// Equality keeps a deeper type shape than the general rendering/type-head
/// environment. In particular constructor payloads and function result type
/// arguments must survive binding. Empty literals are recorded as a dedicated
/// shape for both `let` and `let mut`; their contents may still mutate, so
/// comparison has a runtime fail-closed guard below. Empty entries are answers
/// too: they mask an outer binding's equality/call-result shape on shadowing.
fn eq_shape_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  // #2218: read a LOCAL annotation directly. `let m: Map[String, Int] = mk()`
  // is parsed as `((__asc: Map[String, Int]) -> __asc)(mk())`, so the type is
  // in the AST -- but the arms below see the ascription WRAPPER, not the call,
  // and `infer_shape`'s own ascription arm narrows through `interp_shape`,
  // which admits only the tuple and array forms the interpolation renderer
  // knows. Equality's shape grammar is a strict superset, so the eq path has
  // to read the annotation itself.
  //
  // Measured before this: `let m: Map[String, Int] = mk()` compared by
  // reference while the UNANNOTATED `let m = mk()` compared by content -- the
  // annotation, which can only add information, made the answer worse.
  //
  // Falls through to the arms below when the annotation yields no shape, so
  // this is strictly additive.
  let ann_sh = match dtd_ascribed_type(val) {
    Some(ann) => ty_to_eq_shape(ann),
    None => ""
  }
  let sh = if String::length(ann_sh) > 0 {
    ann_sh
  } else {
    match val {
      EFn(tparams, _, _, ret, _, fbody) => match ret {
        Some(rt) => if ty_mentions_name_in(rt, tparams) {
          ""
        } else {
          ty_to_eq_shape(rt)
        },
        None => if Array::length(tparams) > 0 {
          ""
        } else {
          infer_shape(fn_body_tail_expr(fbody), struct_sets, var_types, fn_returns)
        }
      },
      EArray(items) => if Array::length(items) == 0 {
        "[__EqEmpty]"
      } else {
        infer_eq_shape(val, struct_sets, var_types, fn_returns)
      },
      _ => infer_eq_shape(val, struct_sets, var_types, fn_returns)
    }
  }
  let out = array_empty()
  push_all_var_types(out, var_types)
  Array::push(out, (eq_shape_key(name), if shape_is_composite(sh) {
    sh
  } else {
    ""
  }))
  out
}

// ---- #2157: an unannotated `let xs = []` gets its element type from a push ----
//
// `eq_shape_bind` records `[__EqEmpty]` for an empty array literal: no element
// type, so `==` on that binding compiled to a length check guarded by a runtime
// trap (an array that has since grown can be compared neither by length nor by
// identity). The element type is not missing, though -- it is written at the
// `Array::push(xs, v)` that made the array non-empty, and the `let`'s own body
// is exactly the region where such a push has to live. Reading it there gives
// the unannotated binding the same static shape the annotated form gets from
// `let xs: Array[Int] = []`, so it answers instead of trapping.
//
// Conservative on three counts, each of which would otherwise trade a trap for
// a WRONG answer -- the worse failure under the triage order:
//
//   - the walk stops at every construct that re-binds the spelling (a
//     shadowing `let`, a lambda parameter, a loop or pattern binder), so an
//     inner binding's element type can never be attributed to this one;
//   - every push it can still see must agree on one shape;
//   - every leaf of that shape must be a type `eq_for_typed` compares by
//     content (see `adoptable_pushed_elem_shape`).
//
// It answers "" -- keep `[__EqEmpty]`, keep today's behaviour -- for everything
// else, including a push this pass cannot type and a push made through a
// function this binding is merely passed to.

/// The eq-shape an unannotated empty-array binding should adopt from the pushes
/// in its body, or "" for "no answer, keep the empty shape".
fn pushed_empty_elem_shape(name: String, body: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let shapes = empty_str_array()
  collect_push_elem_shapes(name, body, struct_sets, var_types, fn_returns, shapes)
  if Array::length(shapes) == 0 {
    ""
  } else {
    let first = Array::get(shapes, 0)
    let mut i = 1
    let mut agreed = true
    while i < Array::length(shapes) {
      if Array::get(shapes, i) != first {
        agreed = false
      } else {
        ()
      }
      i = i + 1
    }
    if agreed && adoptable_pushed_elem_shape(first) {
      first
    } else {
      ""
    }
  }
}

/// Element shapes this pass will adopt from a push: scalars, declared
/// struct/enum names, and arrays and tuples built out of those. The whole shape
/// has to be adoptable, because `eq_for_typed` descends into all of it and an
/// unknown leaf would be compared with the raw word `==` -- the identity
/// comparison this whole area exists to keep out.
///
/// A declared name is admitted because `desugar_derives` generates a `::equals`
/// for EVERY declared struct/enum, not only `derive(Eq)` ones -- which is the
/// same fact `dtd_eq_known_types` records for the shape dispatch below.
/// `Option` / `Result` shapes are left out: their `__EqUnknown` positions would
/// re-introduce exactly that raw `==`.
fn adoptable_pushed_elem_shape(sh: String) -> Bool {
  if shape_is_composite(sh) {
    adoptable_eq_ty(shape_to_eq_ty(sh))
  } else {
    adoptable_eq_name(sh)
  }
}

fn adoptable_eq_ty(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => adoptable_eq_name(n),
    TyUnit => true,
    TyApp(head, args) => if head == "Array" && Array::length(args) == 1 {
      adoptable_eq_ty(Array::get(args, 0))
    } else if generic_eq_struct_declared(head) && !str_array_contains(dtd_eq_unsafe_types, head) && Array::length(args) > 0 {
      generic_eq_instantiation_adoptable(head, args)
    } else {
      false
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut ok = Array::length(ts) > 0
      while i < Array::length(ts) {
        if !adoptable_eq_ty(Array::get(ts, i)) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    _ => false
  }
}

/// Whether the specialized comparator for this generic struct reads only
/// content-comparable fields. An unused argument is irrelevant: `Phantom[F]`
/// with only an `Int` field is safe even when `F` itself contains a function.
fn generic_eq_instantiation_adoptable(head: String, args: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut found = false
  let mut ok = false
  while i < Array::length(dtd_eq_generic_structs) {
    let decl = Array::get(dtd_eq_generic_structs, i)
    if decl.0 == head && Array::length(decl.1) == Array::length(args) {
      found = true
      ok = true
      let mut fi = 0
      while fi < Array::length(decl.2) {
        let field_ty = eq_subst_ty(Array::get(decl.2, fi).1, decl.1, args)
        if !eq_ty_field_is_content_comparable(field_ty, empty_str_array()) {
          ok = false
        } else {
          ()
        }
        fi = fi + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found && ok
}

/// #2141: a spelling that is a type parameter of an enclosing binder names no
/// concrete type here, whatever else the merged program declares under it.
fn adoptable_eq_name(n: String) -> Bool {
  if formal_in_scope(n) {
    false
  } else {
    // `dtd_eq_unsafe_types` retains the fail-closed boundary for declared
    // fields whose type has no structural comparator (currently #2218 Map).
    if str_array_contains(dtd_eq_unsafe_types, n) {
      false
    } else {
      is_scalar_type_name(n) || str_array_contains(dtd_eq_known_types, n)
    }
  }
}

/// Every `Array::push(<name>, v)` in `e` that still refers to THIS binding, as
/// the eq-shape of the pushed value.
///
/// The descent is scope-aware: a sub-expression under a construct that re-binds
/// the spelling is skipped, because a push in there is a push onto a different
/// array. `EAssign` is deliberately not a stop -- `let mut xs = []; xs = other`
/// rebinds the same NAME to an array the checker has already unified with this
/// one, so the element type is unchanged.
///
/// The environment is carried the way `rewrite_expr` carries it, so a push of a
/// value bound BETWEEN this binding and the push (`let mut i = 0; ...
/// Array::push(xs, i)`) still resolves -- the binding site's own environment
/// knows nothing about names introduced after it.
fn collect_push_elem_shapes(name: String, e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], out: Array[String]) -> Unit {
  match pushed_value_for_name(e, name) {
    Some(v) => Array::push(out, pushed_value_shape(v, struct_sets, var_types, fn_returns)),
    None => ()
  }
  match e {
    ELet(n, val, body, _) => {
      collect_push_elem_shapes(name, val, struct_sets, var_types, fn_returns, out)
      if n != name {
        collect_push_elem_shapes(name, body, struct_sets, bound_var_types(var_types, n, val, struct_sets, fn_returns), fn_returns, out)
      } else {
        ()
      }
    },
    ELetMut(n, val, body, _) => {
      collect_push_elem_shapes(name, val, struct_sets, var_types, fn_returns, out)
      if n != name {
        collect_push_elem_shapes(name, body, struct_sets, bound_var_types(var_types, n, val, struct_sets, fn_returns), fn_returns, out)
      } else {
        ()
      }
    },
    ELetRec(n, val, body) => if n != name {
      collect_push_elem_shapes(name, val, struct_sets, var_types, fn_returns, out)
      collect_push_elem_shapes(name, body, struct_sets, var_types, fn_returns, out)
    } else {
      ()
    },
    EFn(_, _, params, _, _, fbody) => if fn_params_bind_name(params, name) {
      ()
    } else {
      collect_push_elem_shapes(name, fbody, struct_sets, var_types, fn_returns, out)
    },
    EForIn(v, k, iter, body) => {
      collect_push_elem_shapes(name, iter, struct_sets, var_types, fn_returns, out)
      let shadowed = v == name || match k {
        Some(kn) => kn == name,
        None => false
      }
      if shadowed {
        ()
      } else {
        collect_push_elem_shapes(name, body, struct_sets, var_types, fn_returns, out)
      }
    },
    ELoop(binds, body) => {
      let mut i = 0
      while i < Array::length(binds) {
        let (_, init) = Array::get(binds, i)
        collect_push_elem_shapes(name, init, struct_sets, var_types, fn_returns, out)
        i = i + 1
      }
      if loop_binds_bind_name(binds, name) {
        ()
      } else {
        collect_push_elem_shapes(name, body, struct_sets, var_types, fn_returns, out)
      }
    },
    EMatch(scrut, arms) => {
      collect_push_elem_shapes(name, scrut, struct_sets, var_types, fn_returns, out)
      collect_push_elem_shapes_in_arms(name, arms, struct_sets, var_types, fn_returns, out)
    },
    EHandle(hbody, arms) => {
      collect_push_elem_shapes(name, hbody, struct_sets, var_types, fn_returns, out)
      collect_push_elem_shapes_in_arms(name, arms, struct_sets, var_types, fn_returns, out)
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        collect_push_elem_shapes(name, Array::get(kids, i), struct_sets, var_types, fn_returns, out)
        i = i + 1
      }
    }
  }
}

fn collect_push_elem_shapes_in_arms(name: String, arms: Array[(Pat, Expr)], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    if pat_binds_name(p, name) {
      ()
    } else {
      collect_push_elem_shapes(name, body, struct_sets, var_types, fn_returns, out)
    }
    i = i + 1
  }
}

/// The shape of one pushed value. `infer_eq_shape` answers "" for a plain
/// scalar binding (it records only composites), and "" is indistinguishable
/// from "no idea" here, so the ordinary shape answers second.
/// The shape of a pushed value, taken ONLY from the value's own syntax.
///
/// `var_types` and `fn_returns` are deliberately NOT threaded in: both
/// inference calls get empty environments. That is the whole safety argument,
/// and it is structural rather than a list of cases.
///
/// Reading an environment here means re-deciding what the type checker already
/// decided -- which binder is in scope, which annotation applies, which name a
/// closure parameter or a match arm shadows, which spellings are a nested
/// function's type formals. Every one of those was got wrong (#2192 review, six
/// findings), and the first was silently wrong: an outer `let v = 1` was read
/// for an inner `v` of another type, so `==` answered `false` for two equal
/// `[1, 2]` arrays -- a fail-closed trap turned into a wrong answer. Patching
/// them one at a time is the treadmill #2166 describes for the float-returning
/// names table: a syntactic stand-in for the checker's types, where each added
/// spelling makes the stand-in harder to replace.
///
/// With no environment, an identifier and a call resolve to nothing and the
/// binding keeps the `[__EqEmpty]` sentinel -- the pre-#2157 trap. So the
/// classification can be absent, never wrong. What still resolves is a value
/// that describes itself: a literal, an array / tuple / struct of such values,
/// and a conditional whose branches agree.
///
/// The typed replacement is not available yet. #2158 built it and measured the
/// FS lane -- the one `vibe test` and `vibe run` use -- at 6.12s -> 77.55s on a
/// compiler-sized closure, so it ships only where a whole-program check already
/// runs. Until that is affordable here, this stays syntactic and narrow.
fn pushed_value_shape(v: Expr, struct_sets: Array[(String, Array[String])], _var_types: Array[(String, String)], _fn_returns: Array[(String, String)]) -> String {
  let no_env = array_empty()
  let no_fns = array_empty()
  let sh = infer_eq_shape(v, struct_sets, no_env, no_fns)
  if String::length(sh) > 0 && !shape_has_unknown_slot(sh) && !shape_has_generic_leaf(sh) {
    sh
  } else {
    let ordinary = infer_shape(v, struct_sets, no_env, no_fns)
    if String::length(ordinary) > 0 && !shape_has_unknown_slot(ordinary) && !shape_has_generic_leaf(ordinary) {
      ordinary
    } else {
      self_describing_fallback(v, struct_sets)
    }
  }
}

/// `[]` inside a shape is an element slot the inference could not fill, and a
/// shape carrying one is not usable: `[1]` resolved while `[-1]` produced the
/// INCOMPLETE `"[]"` and was accepted before the fallback could classify the
/// child, so the comparison trapped on a value the contract says resolves
/// (#2192 review). Treating an incomplete shape as unresolved sends it to
/// `self_describing_fallback`, which recurses with the same classifier.
///
/// An empty array literal pushed as a value (`Array::push(xs, [])`) also
/// produces `"[]"`, and it genuinely has no element type -- unresolved is the
/// right answer for it too.
fn shape_has_unknown_slot(sh: String) -> Bool {
  String::contains(sh, "[]") || String::contains(sh, "(,") || String::contains(sh, ",)") || String::contains(sh, ",,")
}

/// A bare generic head has lost the arguments required to select its concrete
/// comparator. Fully encoded `{g:Head,...}` shapes do not reach this predicate;
/// only the old lossy spelling is rejected here.
fn shape_has_generic_leaf(sh: String) -> Bool {
  if shape_is_composite(sh) {
    eq_ty_has_generic_leaf(shape_to_eq_ty(sh))
  } else {
    str_array_contains(dtd_eq_generic_types, sh)
  }
}

fn eq_ty_has_generic_leaf(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => str_array_contains(dtd_eq_generic_types, n),
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if eq_ty_has_generic_leaf(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if eq_ty_has_generic_leaf(Array::get(ts, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// The two self-describing shapes neither inference call reads, kept HERE
/// rather than in `infer_shape`, which the rest of the file consults for other
/// purposes.
///
/// `()` is a literal like any other and `Unit` is already a scalar element type
/// (`is_scalar_type_name`), so the comparator side needed nothing -- only the
/// shape was never produced, and `Array::push(xs, ())` fell to the trap while
/// the contract said a literal resolves (#2192 review).
///
/// A conditional describes itself when both arms do and they agree: the value
/// has that shape on every path, so adopting it invents nothing.
/// `Array::push(xs, if f { 1 } else { 2 })` is an ordinary direct push, not the
/// residual where the mutation hides behind a helper.
fn self_describing_fallback(v: Expr, struct_sets: Array[(String, Array[String])]) -> String {
  match v {
    EUnit => "Unit",
    // Preserve generic arguments in the equality shape so `Box[Int]` and
    // `Box[Array[Int]]` select distinct concrete comparators (#2195).
    ERecord(rname, fields, targs) => if generic_eq_struct_declared(rname) {
      let inferred = if Array::length(targs) > 0 {
        Some(TyApp(rname, targs))
      } else {
        infer_generic_record_static(rname, fields, 0)
      }
      match inferred {
        Some(t) => ty_to_eq_shape(t),
        None => ""
      }
    } else {
      ""
    },
    EUnaryOp("-", inner) => match inner {
      // The parser gives `-1` as EUnaryOp over the literal, and neither
      // inference call reads that, so a negative literal took the trap while
      // the contract said a literal resolves (#2192 review).
      EInt(_) => "Int",
      EFloat(_) => "Double",
      _ => ""
    },
    EArray(items) => if Array::length(items) == 0 {
      ""
    } else {
      // Recurse with THIS classifier so a child only the fallback recognises
      // (a negative literal, `()`, a conditional) resolves at any depth, and
      // every element must agree.
      let no_env = array_empty()
      let no_fns = array_empty()
      let first = pushed_value_shape(Array::get(items, 0), struct_sets, no_env, no_fns)
      let mut agreed = String::length(first) > 0
      let mut i = 1
      while i < Array::length(items) {
        if pushed_value_shape(Array::get(items, i), struct_sets, no_env, no_fns) != first {
          agreed = false
        } else {
          ()
        }
        i = i + 1
      }
      if agreed {
        String::concat("[", String::concat(first, "]"))
      } else {
        ""
      }
    },
    ETuple(items) => if Array::length(items) == 0 {
      ""
    } else {
      // Same recursion as EArray above: the contract names arrays AND tuples
      // of self-describing values, so leaving one out would be an arbitrary
      // seam -- `(1, "a")` resolved while `(-1, ())` did not (#2192 review).
      // Every element must resolve; unlike an array they need not agree.
      let no_env = array_empty()
      let no_fns = array_empty()
      let out = StringBuilder::new()
      StringBuilder::push(out, "(")
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        let es = pushed_value_shape(Array::get(items, i), struct_sets, no_env, no_fns)
        if String::length(es) == 0 {
          ok = false
        } else {
          ()
        }
        if i > 0 {
          StringBuilder::push(out, ",")
        } else {
          ()
        }
        StringBuilder::push(out, es)
        i = i + 1
      }
      StringBuilder::push(out, ")")
      if ok {
        StringBuilder::freeze(out)
      } else {
        ""
      }
    },
    EIf(_, t, f) => {
      let no_env = array_empty()
      let no_fns = array_empty()
      let ts = pushed_value_shape(t, struct_sets, no_env, no_fns)
      let fs = pushed_value_shape(f, struct_sets, no_env, no_fns)
      if String::length(ts) > 0 && ts == fs {
        ts
      } else {
        ""
      }
    },
    _ => ""
  }
}

/// The same binding-site records `rewrite_expr` makes at an `ELet`/`ELetMut`,
/// so the walk above reads names the way the comparison site will.
fn bound_var_types(var_types: Array[(String, String)], n: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let inferred = extend_var_types(var_types, n, anon_or_infer(val, struct_sets, var_types, fn_returns))
  let base = bind_impl_target_key(inferred, n, val, struct_sets, fn_returns)
  eq_shape_bind(bind_shapes(base, n, val, struct_sets, fn_returns), n, val, struct_sets, fn_returns)
}

/// The value `e` pushes onto the array bound to `name`. Only the qualified
/// spelling exists -- the checker rejects `xs.push(v)` for a builtin method
/// ("dot-call syntax is not supported for the builtin method `Array::push`"),
/// so there is no second form to match.
fn pushed_value_for_name(e: Expr, name: String) -> Option[Expr] {
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(fname, _) => if fname == "Array::push" && Array::length(args) == 2 && expr_is_ident(Array::get(args, 0), name) {
        Some(Array::get(args, 1))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

fn opt_ty_is_some(t: Option[TypeExpr]) -> Bool {
  match t {
    Some(_) => true,
    None => false
  }
}

fn expr_is_ident(e: Expr, name: String) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    _ => false
  }
}

/// `strip_label_tilde`, like every other scope helper in this file: a labeled
/// parameter is stored as `xs~` while its body spells it `xs`, so a raw
/// comparison misses the shadow and the scan attributes an inner
/// `Array::push(xs, ...)` to the OUTER array of that name (#2192 review).
fn fn_params_bind_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if strip_label_tilde(pn) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn loop_binds_bind_name(binds: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(binds) {
    let (bn, _) = Array::get(binds, i)
    if bn == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #2157: replace the `[__EqEmpty]` shape `eq_shape_bind` just recorded for
/// `name` with the element shape its own body pushes, when there is one. A
/// no-op for every other binding.
fn empty_array_shape_from_body(var_types: Array[(String, String)], name: String, body: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let is_untyped_empty = match lookup_var_type(var_types, eq_shape_key(name)) {
    Some(sh) => sh == "[__EqEmpty]",
    None => false
  }
  if !is_untyped_empty {
    var_types
  } else {
    let elem = pushed_empty_elem_shape(name, body, struct_sets, var_types, fn_returns)
    if String::length(elem) == 0 {
      var_types
    } else {
      let out = array_empty()
      push_all_var_types(out, var_types)
      Array::push(out, (eq_shape_key(name), String::concat("[", String::concat(elem, "]"))))
      out
    }
  }
}

/// #1445 cause 3: the var-type environment for ONE match arm's body.
///
/// A pattern binder never entered `var_types`, so anything reached through one
/// fell to the pointer heuristic. When the scrutinee is a bare NAME whose
/// `<Ctor>` payload type was recorded -- by `seed_var_types` off an
/// `Option[P]` / `Result[T, E]` annotation, or by `ctor_payload_bind` off a
/// let-bound `Some(..)` -- a single-binder `PCtor` arm gives that type to its
/// binder.
///
/// Deliberately narrow: only `PCtor(c, [PBind(v)])` over a named scrutinee.
/// Nested patterns, tuple payloads and multi-field constructors would each
/// need their own payload decomposition, and this pass has one type name per
/// (variable, ctor) to work with -- widening it is what a real typed AST is
/// for, not more sentinels. Everything not matched here behaves exactly as
/// before.
/// #2128: the per-element TYPE NAMES of a tuple-valued scrutinee, or an empty
/// array when they are not knowable. Two sources, both already maintained: a
/// tuple LITERAL of scalars, and a NAME whose `tuple_shape_bind` record holds
/// them. The literal case runs the ordinary `infer_arg_type_name`, so a tuple
/// of CALLS (`(mk(..), mk(..))`) types too -- which is the common spelling.
///
/// An element this cannot type is an EMPTY entry, preserved so the count equals
/// the arity; callers skip those rather than bind a name to "".
fn dtd_tuple_elem_type_names(scrut: Expr, var_types: Array[(String, String)], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[String] {
  // `infer_shape` is the one answer that covers every source at once: a tuple
  // literal, a name (through `__shape$` or the older sentinels), a call whose
  // result shape was recorded, and an annotated binding. Asking it directly is
  // what makes `Array::get(ps, i)` and a tuple-returning call resolve without a
  // per-source arm here.
  let parts = dtd_tuple_parts_of_shape(Some(infer_shape(scrut, struct_sets, var_types, fn_returns)))
  if Array::length(parts) > 0 {
    parts
  } else {
    match scrut {
      // The older per-tuple sentinel still answers for a binding `shape_bind`
      // declined to record -- a PARAMETER annotation, which `seed_var_types`
      // seeds directly and which never goes through `bind_shapes`.
      EIdent(n, _) => match lookup_var_type(var_types, tuple_shape_key(n)) {
        Some(sentinel) => tuple_shape_parts(sentinel),
        // A tuple PARAMETER seeds only the equality sentinel: `seed_var_types`
        // deliberately records no render shape for one, because rendering has
        // a better path through the real TypeExpr (see its TyTuple arm). The
        // eq shape carries the element list all the same, and reading it here
        // changes nothing about what is recorded.
        None => dtd_tuple_parts_of_shape(lookup_var_type(var_types, eq_shape_key(n)))
      },
      // `Array::get(ps, i)` / `ps[i]` on a name whose shape is an array OF
      // tuples. `infer_shape` does not project an array element, and
      // `array_elem_key` cannot answer either: it stores a bare head name, so
      // an `Array[(String, String)]` records just "Tuple" and the element types
      // are gone. `__shape$` keeps them.
      ECall(callee, cargs, _) => match callee {
        EIdent(cn, _) => if (cn == "Array::get" || cn == "__index") && Array::length(cargs) == 2 {
          match Array::get(cargs, 0) {
            EIdent(arrname, _) => match lookup_var_type(var_types, shape_key(arrname)) {
              Some(sh) => if String::starts_with(sh, "[") {
                dtd_tuple_parts_of_shape(Some(shape_inner(sh)))
              } else {
                empty_str_array()
              },
              None => empty_str_array()
            },
            _ => empty_str_array()
          }
        } else {
          empty_str_array()
        },
        _ => empty_str_array()
      },
      _ => empty_str_array()
    }
  }
}

/// A recorded `__shape$` value -> its tuple element shapes, or empty when it is
/// not a tuple shape. Unlike `tuple_shape_parts` the entries may themselves be
/// composite (`(String,String)` inside `((String,String),Int)`), which is what
/// lets a nested binder keep its own tuple record.
fn dtd_tuple_parts_of_shape(sh: Option[String]) -> Array[String] {
  match sh {
    Some(t) => if String::starts_with(t, "(") && String::ends_with(t, ")") {
      shape_split(shape_inner(t))
    } else {
      empty_str_array()
    },
    None => empty_str_array()
  }
}

/// Is this shape entry itself a tuple (rather than a bare type name)? Such an
/// entry belongs in the binder's `tuple_shape_key` record, not in its type
/// slot -- a shape is not a type name and would resolve to nothing downstream.
fn dtd_shape_is_tuple(sh: String) -> Bool {
  String::starts_with(sh, "(") && String::ends_with(sh, ")")
}

/// Comma-join shape parts back into the `tuple_shape_key` sentinel encoding.
/// A part that is itself composite is kept verbatim -- `tuple_shape_parts`
/// splits on top-level commas only, so a nested `(A,B)` round-trips.
fn dtd_join_shape_parts(parts: Array[String]) -> String {
  let mut acc = ""
  let mut i = 0
  while i < Array::length(parts) {
    acc = if i == 0 {
      Array::get(parts, i)
    } else {
      String::concat(acc, String::concat(",", Array::get(parts, i)))
    }
    i = i + 1
  }
  acc
}

/// The environment-free entry point, kept for `interp_ctor_arm_var_types`,
/// whose caller carries no `struct_sets`/`fn_returns`. Empty environments cost
/// nothing there: that path only ever asks about a `PCtor` arm, which reads
/// recorded payload keys out of `var_types` alone.
fn arm_binder_var_types(scrut: Expr, p: Pat, var_types: Array[(String, String)]) -> Array[(String, String)] {
  arm_binder_var_types_env(scrut, p, var_types, empty_struct_sets(), empty_fn_returns())
}

fn arm_binder_var_types_env(scrut: Expr, p: Pat, var_types: Array[(String, String)], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  // #1878: a PTuple arm over a tuple that carries anonymous records — either
  // a NAME whose var_types entry is the compound `__anontup:` sentinel, or a
  // literal tuple scrutinee — hands each element's `__anonrec:` sentinel to
  // its positional binder, so `let (r, n) = t` followed by `r.a` lowers to
  // the positional `__rec_field` read instead of dying in codegen's
  // struct-table EDot path ("unknown struct field", no location).
  match p {
    PTuple(tup_pats) => {
      let tup_sent = match scrut {
        EIdent(tsn, _) => match lookup_var_type(var_types, tsn) {
          Some(ts) => ts,
          None => ""
        },
        ETuple(titems) => match tuple_sentinel_from_exprs(titems) {
          Some(ts) => ts,
          None => ""
        },
        _ => ""
      }
      if String::starts_with(tup_sent, anon_tuple_prefix()) {
        let elems = anon_tuple_elems(tup_sent)
        let mut tacc = var_types
        let mut tpi = 0
        while tpi < Array::length(tup_pats) {
          if tpi < Array::length(elems) {
            match Array::get(tup_pats, tpi) {
              PBind(tv) => {
                let esent = Array::get(elems, tpi)
                if String::starts_with(esent, anon_record_prefix()) {
                  tacc = extend_var_types(tacc, tv, Some(esent))
                } else {
                  ()
                }
              },
              _ => ()
            }
          } else {
            ()
          }
          tpi = tpi + 1
        }
        return tacc
      } else {
        ()
      }
      // #2128: no anonymous records involved, but the element TYPES may still
      // be knowable -- and `let (a, b) = (..)` IS a PTuple arm, since the
      // parser lowers a pattern let to `EMatch(val, [(pat, rest)])`
      // (`push_pattern_let_step`). Without this the binders are absent from
      // `var_types`, so `a < b` on two Strings keeps the raw i64 compare on
      // the (ptr<<32)|len repr -- an ADDRESS comparison, under which `a == b`
      // and `a < b` can both be true for the same pair.
      let tup_elems = dtd_tuple_elem_type_names(scrut, var_types, struct_sets, fn_returns)
      if Array::length(tup_elems) > 0 {
        let mut eacc = var_types
        let mut epi = 0
        while epi < Array::length(tup_pats) {
          if epi < Array::length(tup_elems) {
            match Array::get(tup_pats, epi) {
              PBind(ev) => {
                let ety = Array::get(tup_elems, epi)
                if String::length(ety) == 0 {
                  ()
                } else if dtd_shape_is_tuple(ety) {
                  // A NESTED tuple: record it under the binder's own tuple key
                  // so `inner.0` resolves, instead of putting a shape where a
                  // type name belongs.
                  let nested = array_empty()
                  push_all_var_types(nested, eacc)
                  Array::push(nested, (tuple_shape_key(ev), dtd_join_shape_parts(shape_split(shape_inner(ety)))))
                  eacc = nested
                } else {
                  eacc = extend_var_types(eacc, ev, Some(ety))
                }
              },
              _ => ()
            }
          } else {
            ()
          }
          epi = epi + 1
        }
        return eacc
      } else {
        ()
      }
    },
    _ => ()
  }
  match scrut {
    EIdent(sname, _) => match p {
      PCtor(cn, sub) => {
        let n = Array::length(sub)
        let mut acc = var_types
        let mut i = 0
        while i < n {
          match Array::get(sub, i) {
            PBind(v) => {
              let key = if n == 1 {
                ctor_payload_key(sname, cn)
              } else {
                ctor_payload_idx_key(sname, cn, i)
              }
              match lookup_var_type(acc, key) {
                Some(sh) => if shape_is_composite(sh) {
                  // A composite payload goes in as a SHAPE, so the arm body's
                  // interpolation takes the recursive path rather than the
                  // head-name one.
                  let out = array_empty()
                  push_all_var_types(out, acc)
                  Array::push(out, (shape_key(v), sh))
                  acc = out
                } else {
                  acc = extend_var_types(acc, v, Some(sh))
                },
                None => ()
              }
            },
            _ => ()
          }
          i = i + 1
        }
        acc
      },
      _ => var_types
    },
    _ => var_types
  }
}

/// #1445 残件: a TypeExpr rendered in the SHAPE language documented above
/// `shape_key` (`Name` / `(s1,s2)` / `[s]`). Returns "" for anything the shape
/// language cannot spell -- `Option[P]` and `Result[T, E]` among them, which is
/// correct: those resolve through the per-ctor payload entries instead, and a
/// bogus shape would divert them to a renderer that cannot handle a wrapper.
fn texpr_shape(te: TypeExpr) -> String {
  match te {
    TyName(n) => n,
    TyApp(tn, targs) => if tn == "Array" && Array::length(targs) == 1 {
      let inner = texpr_shape(Array::get(targs, 0))
      if String::length(inner) == 0 {
        ""
      } else {
        String::concat("[", String::concat(inner, "]"))
      }
    } else {
      ""
    },
    TyTuple(elems) => if Array::length(elems) == 0 {
      ""
    } else {
      let mut acc = "("
      let mut i = 0
      let mut ok = true
      while i < Array::length(elems) {
        let sub = texpr_shape(Array::get(elems, i))
        if String::length(sub) == 0 {
          ok = false
        } else {
          ()
        }
        acc = if i == 0 {
          String::concat(acc, sub)
        } else {
          String::concat(acc, String::concat(",", sub))
        }
        i = i + 1
      }
      if ok {
        String::concat(acc, ")")
      } else {
        ""
      }
    },
    _ => ""
  }
}

/// Record one constructor payload's shape against `pname`, skipping the entry
/// entirely when the payload type has no shape (rather than recording "", which
/// downstream reads as a definite "not composite").
fn seed_ctor_payload(out: Array[(String, String)], pname: String, ctor: String, payload: TypeExpr) -> Unit {
  let sh = texpr_shape(payload)
  if String::length(sh) == 0 {
    ()
  } else {
    Array::push(out, (ctor_payload_key(pname, ctor), sh))
  }
}

fn constructor_formal_name_in(tparams: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(tparams) {
    if type_param_name(Array::get(tparams, i)) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Parameter seeding runs after `eq_known_types_reset` has collected this
/// program's aliases. Expand only an annotation's alias spine, stopping at a
/// locally bound constructor formal so a same-spelled global alias cannot
/// capture `F` in `Apply[F, A]`.
fn expand_seed_constructor_alias(ty: TypeExpr, tparams: Array[String], fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    ty
  } else match ty {
    TyName(head) => if constructor_formal_name_in(tparams, head) {
      ty
    } else {
      let mut i = 0
      let mut result = ty
      let mut found = false
      while i < Array::length(dtd_eq_type_aliases) {
        let (name, params, target) = Array::get(dtd_eq_type_aliases, i)
        if !found && name == head && Array::length(params) == 0 {
          result = expand_seed_constructor_alias(target, tparams, fuel - 1)
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      result
    },
    TyApp(head, args) => if constructor_formal_name_in(tparams, head) {
      ty
    } else {
      let mut i = 0
      let mut result = ty
      let mut found = false
      while i < Array::length(dtd_eq_type_aliases) {
        let (name, params, target) = Array::get(dtd_eq_type_aliases, i)
        if !found && name == head && Array::length(params) == Array::length(args) {
          let expanded = substitute_constructor_alias_target(target, params, args)
          result = expand_seed_constructor_alias(expanded, tparams, fuel - 1)
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      result
    },
    _ => ty
  }
}

/// Seed a var-type environment from a function's parameters whose annotation is
/// a bare type name `T` — concrete (`Point`) for call-site dict synthesis, or a
/// type parameter (`T`) for generic->generic dict forwarding. The distinction is
/// made at use time against the in-scope dict bindings. Both kinds are tracked;
/// `tparams` prevents a same-spelled formal from expanding through a global alias.
fn seed_var_types(params: Array[(String, Option[TypeExpr])], tparams: Array[String], base: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let mut b = 0
  while b < Array::length(base) {
    Array::push(out, Array::get(base, b))
    b = b + 1
  }
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    match ann {
      Some(TyName(tn)) => {
        Array::push(out, (pname, tn))
        // A nullary alias can hide a structural parameter type just as a
        // TyApp annotation can. Preserve a same-spelled in-scope formal before
        // expanding through the global alias table.
        if !ty_mentions_name_in(TyName(tn), tparams) {
          let esh = ty_to_eq_shape(TyName(tn))
          if shape_is_composite(esh) {
            Array::push(out, (eq_shape_key(pname), esh))
          } else {
            ()
          }
        } else {
          ()
        }
      },
      // A generic struct annotation `x: LazyIter[T]` -> track the head name so
      // `for x in <param>` over a generic iterator type resolves (#636).
      // #1199 bug 1: for `x: Array[T]` specifically, ALSO record T under the
      // array_elem_key sentinel -- without it, `Array::get(x, i)` /
      // `x[i]` has no recorded type (infer_arg_type_name has nothing to look
      // up), so a downstream `[K: Hash]`-bounded call fed that value can't
      // resolve or forward a witness dictionary and synth_dicts fails,
      // silently emitting a call short the dict argument(s) -- invalid wasm
      // ("not enough arguments on the stack"), not a compile error. Only the
      // single-bare-type-arg shape is handled (matches every other bare-name
      // inference in this file); nested/nested-generic element types are
      // left untracked, same conservative scope as the rest of
      // infer_arg_type_name.
      Some(TyApp(tn, targs)) => {
        let constructor_head = match expand_seed_constructor_alias(TyApp(tn, targs), tparams, Array::length(dtd_eq_type_aliases) + 1) {
          TyApp(head, _) => head,
          TyName(head) => head,
          _ => tn
        }
        // Keep the exact annotation head for equality, rendering, and operator
        // lowering. Constructor dispatch gets a dedicated canonical alias head.
        Array::push(out, (pname, tn))
        if constructor_head != tn {
          Array::push(out, (constructor_head_key(pname), constructor_head))
        } else {
          ()
        }
        if !ty_mentions_name_in(TyApp(tn, targs), tparams) {
          Array::push(out, (impl_target_var_key(pname), impl_target_key(TyApp(tn, targs))))
        } else {
          ()
        }
        // Equality needs the complete annotation, not only its head. Keep the
        // recursive shape for every monomorphic aggregate parameter so nested
        // Array/Option/Result paths do not fall back to word identity.
        if !ty_mentions_name_in(TyApp(tn, targs), tparams) {
          let esh = ty_to_eq_shape(TyApp(tn, targs))
          if shape_is_composite(esh) {
            Array::push(out, (eq_shape_key(pname), esh))
          } else {
            ()
          }
        } else {
          ()
        }
        if tn == "Array" && Array::length(targs) == 1 {
          match Array::get(targs, 0) {
            TyName(elem) => Array::push(out, (array_elem_key(pname), elem)),
            _ => ()
          }
        } else if tn == "Option" && Array::length(targs) == 1 {
          // #1445 cause 3: `o: Option[P]` -- the HEAD alone ("Option") is what
          // reaches `var_types`, so a `match o { Some(v) => "\{v}" }` had no
          // type for `v` at all and fell to the ADR-0058 pointer heuristic.
          // The annotation still has `P` right here; record it against the
          // ctor so the match arm can bind it.
          //
          // #1445 残件: recorded as a SHAPE, not a bare name, so a payload that
          // is itself a container resolves too. `o: Option[Array[P]]` records
          // `[P]`; `arm_binder_var_types` already routes a composite payload to
          // the recursive renderer. Measured before this: that binder printed a
          // pointer decimal while `Option[P]` rendered fine -- the `TyName`-only
          // match silently recorded nothing for the nested case.
          seed_ctor_payload(out, pname, "Some", Array::get(targs, 0))
        } else if tn == "Result" && Array::length(targs) == 2 {
          seed_ctor_payload(out, pname, "Ok", Array::get(targs, 0))
          seed_ctor_payload(out, pname, "Err", Array::get(targs, 1))
        } else {
          ()
        }
      },
      // #1445: a tuple ANNOTATION (`t: (Int, P)`) deliberately records
      // NOTHING here for the RENDER sentinels. Measured: an annotated tuple
      // parameter already renders structurally, and it renders NESTED tuples
      // too (`(Int, (Int, P))` -> `(5, (7, P { x: 6 }))`) -- it goes through
      // a real TypeExpr, so it beats the flat per-element name list this
      // pass's sentinel can carry. Recording those would only divert renders
      // to a weaker path.
      //
      // #1526 (ADR-0097): the `==` dispatch is a different consumer with no
      // such better path -- a tuple PARAMETER compared with `==` fell to the
      // codegen's FLAT depth-1 walk (no literal in scope), whose Array
      // elements identity-compare. Record the annotation's shape under the
      // eq-only `__eqshape$` sentinel; interp_expand never reads it, so the
      // measured render behavior above is untouched.
      // A shape naming one of the fn's own TYPE PARAMETERS is not seeded: it
      // would key a monomorphic `__arr_equals__<tyvar>` helper on the
      // parameter's NAME (the Codex P1 class on the bare-`==` path), and the
      // erased comparison it would compile to is the status quo anyway.
      Some(TyTuple(tts)) => if ty_mentions_name_in(TyTuple(tts), tparams) {
        ()
      } else {
        let esh = ty_to_eq_shape(TyTuple(tts))
        if String::length(esh) > 0 {
          Array::push(out, (eq_shape_key(pname), esh))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Collect the return-type name of every top-level `let f = (..) -> R { .. }`
/// (R only when it is a bare type name), so the `for` desugar can tell an
/// iterator (`C::next` exists) from an iterable (`C::iter` returns an iterator).
/// The tail expression a function body evaluates to, walking the binding
/// spine (`let` / `let mut` / `letrec` / sequencing) to its final position.
/// Used to infer a return head when the annotation is omitted.
fn fn_body_tail_expr(e: Expr) -> Expr {
  match e {
    ELet(_, _, rest, _) => fn_body_tail_expr(rest),
    ELetMut(_, _, rest, _) => fn_body_tail_expr(rest),
    ELetRec(_, _, rest) => fn_body_tail_expr(rest),
    ESeq(_, rest) => fn_body_tail_expr(rest),
    other => other
  }
}

/// Record the head name of a function's return type: `TyName(n)` -> n,
/// `TyApp(n, _)` -> n (so a generic `iter() -> LazyIter[T]` resolves to
/// `LazyIter`, and an async `next() -> Future[Option[..]]` resolves to
/// `Future` so the for-loop desugar can tell async from sync).
///
/// #1350 (Codex P1, twice): a FUNCTION-typed return gets its own head
/// sentinel instead of collapsing into the empty "unknown" head, because
/// `for x in f()` may only classify as a pull-closure loop when `f`
/// positively returns a function -- otherwise an unannotated
/// `let values = () -> { [40, 2] }` is indistinguishable from
/// `stdin_stream : (Int) -> (() -> Option[String])` and the array gets
/// called as a closure (call_indirect trap).
///
/// When the annotation is OMITTED the head is inferred from the body's tail
/// expression: a body that evaluates to a lambda is a closure factory, so it
/// gets the same sentinel. Without this, tightening the annotated case alone
/// just moved the trap to the other side -- an unannotated
/// `let make_pull = () -> { () -> { .. } }` lost its pull loop and iterated a
/// function value as an array. Only the lambda shape is inferred; every other
/// tail keeps the empty head, so nothing that used to classify by NAME
/// changes. fn_return_type maps the sentinel to None, so every consumer that
/// reads type NAMES sees exactly what it saw before.
fn fn_return_head_of(ret: Option[TypeExpr], body: Expr) -> String {
  match ret {
    Some(te) => match te {
      TyName(n) => n,
      TyApp(n, _) => n,
      TyFn(_, _, _) => fn_type_return_head(),
      _ => ""
    },
    None => match fn_body_tail_expr(body) {
      EFn(_, _, _, _, _, _) => fn_type_return_head(),
      _ => ""
    }
  }
}

/// #1341 (Codex P1 on #1369): the key under which a struct FIELD's declared
/// type head rides in the fn_returns table. `.` cannot appear in a vibe
/// binding or function name (qualified names use `::`), so this can never
/// collide with a real entry -- the same reserved-key trick array_elem_key
/// already uses for var_types.
///
/// fn_returns is threaded through every infer_arg_type_name caller already,
/// and struct_sets carries field NAMES only, so this is the cheapest place to
/// put field types without adding a parameter to a dozen signatures.
fn struct_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

/// #1502: reserved `fn_returns` key carrying `type C = Color` as `C -> Color`.
/// Same trick as `struct_field_type_key` -- this pass has no `TypeDef` table, so
/// the alias map rides along in the one table every consumer already has. The
/// `type ` prefix cannot collide with a function or variant name (a space is not
/// an identifier character).
fn type_alias_key(alias_name: String) -> String {
  String::concat("type ", alias_name)
}

/// Follow `type_alias_key` hops to the name a qualifier ultimately denotes, so
/// an alias works as a constructor qualifier. `fuel` bounds a cyclic chain
/// (rejected by the checker; here we only need to not spin).
fn resolve_alias_head(fn_returns: Array[(String, String)], head: String) -> String {
  let mut cur = head
  let mut fuel = 16
  let mut done = false
  while !done {
    if fuel <= 0 {
      done = true
    } else {
      fuel = fuel - 1
      match fn_return_type(fn_returns, type_alias_key(cur)) {
        Some(target) => {
          cur = target
        },
        None => {
          done = true
        }
      }
    }
  }
  cur
}

/// (`Holder.s` -> `HostStream`) for every declared struct field whose
/// annotation has a head name. Appended to fn_returns so `infer_arg_type_name`
/// can type a projection (`h.s`).
fn collect_struct_field_types(stmts: Array[Stmt], out: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          let head = match fty {
            TyName(n) => n,
            TyApp(n, _) => n,
            _ => ""
          }
          if String::length(head) > 0 {
            Array::push(out, (struct_field_type_key(sname, fname), head))
          } else {
            ()
          }
          j = j + 1
        }
      },
      SModule(_, _, inner) => collect_struct_field_types(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

fn collect_fn_eq_return_shape(out: Array[(String, String)], fname: String, tparams: Array[String], ret: Option[TypeExpr], fbody: Expr) -> Unit {
  let sh = match ret {
    Some(rt) => if ty_mentions_name_in(rt, tparams) {
      ""
    } else {
      ty_to_eq_shape(rt)
    },
    None => if Array::length(tparams) > 0 {
      ""
    } else {
      infer_shape(fn_body_tail_expr(fbody), array_empty(), array_empty(), out)
    }
  }
  if shape_is_composite(sh) {
    Array::push(out, (fn_eq_shape_key(fname), sh))
  } else {
    ()
  }
}

fn collect_fn_impl_return_key(out: Array[(String, String)], fname: String, tparams: Array[String], ret: Option[TypeExpr]) -> Unit {
  match ret {
    Some(te) => if !ty_mentions_name_in(te, tparams) {
      Array::push(out, (impl_target_fn_key(fname), impl_target_key(te)))
    } else {
      ()
    },
    None => ()
  }
}

fn collect_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(tparams, _, _, ret, _, fbody) => {
          // #2141: a return head naming the fn's OWN formal is an erased
          // value at every call site -- record it re-spelled so a same-spelled
          // (merged-in) declared type can never claim the call's result for
          // struct dispatch or a struct renderer (see subst_formals_ty).
          let head = fn_return_head_of(ret, fbody)
          let head2 = if str_array_contains(tparams, head) {
            mark_formal_name(head)
          } else {
            head
          }
          Array::push(out, (fname, head2))
          collect_fn_impl_return_key(out, fname, tparams, ret)
          collect_fn_eq_return_shape(out, fname, tparams, ret, fbody)
        },
        _ => ()
      },
      // `fn name(..) -> R { .. }` declares parse to SFnDecl, not SLet (see
      // parse_fn_stmt_general) -- without this case every `fn`-declared
      // function (the more common spelling) was invisible here, silently
      // missing from the `for`/async-vs-sync desugar and other fn_returns
      // consumers below.
      SFnDecl(_, fname, body, _, _) => match body {
        EFn(tparams, _, _, ret, _, fbody) => {
          // #2141: same re-spelling as the SLet arm above.
          let head = fn_return_head_of(ret, fbody)
          let head2 = if str_array_contains(tparams, head) {
            mark_formal_name(head)
          } else {
            head
          }
          Array::push(out, (fname, head2))
          collect_fn_impl_return_key(out, fname, tparams, ret)
          collect_fn_eq_return_shape(out, fname, tparams, ret, fbody)
        },
        _ => ()
      },
      // #672: map each enum variant constructor to its enum name, so a
      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch
      // (infer_arg_type_name reads ctor calls through fn_returns).
      SEnum(_, ename, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          Array::push(out, (vname, ename))
          vi = vi + 1
        }
      },
      // #1502: `type C = Color` under the reserved `type C` key, so
      // `qual_ctor_member` can normalize an alias qualifier to the enum it
      // names. Only a head-bearing target is recorded -- a tuple/fn alias can
      // never name an enum.
      STypeAlias(_, aname, _, te) => match te {
        TyName(n) => {
          Array::push(out, (type_alias_key(aname), n))
        },
        TyApp(n, _) => {
          Array::push(out, (type_alias_key(aname), n))
        },
        _ => ()
      },
      // #1502: `import ./m { E as F }` is the same renaming from the other
      // direction. A BACKSTOP, not the primary path: in the lanes that run
      // import_alias_rewrite.vibe the head is already rewritten to `E` before
      // this pass, and the merged stmt list has no `SImport` left to read. It
      // earns its place for the lanes that skip that rewrite (gc_only.vibe),
      // where the alias does still reach here.
      SImport(_, items) => {
        let mut ii = 0
        while ii < Array::length(items) {
          let item = Array::get(items, ii)
          let orig = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => {
              Array::push(out, (type_alias_key(alias), orig))
            },
            None => ()
          }
          ii = ii + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // #1341: struct FIELD type heads ride along under the reserved
  // `Struct.field` key (struct_field_type_key). Must be pushed BEFORE the
  // sort below -- fn_exists/fn_return_type binary-search this table, so an
  // entry appended afterwards would be invisible. (That is exactly how the
  // first cut of this failed: the seeding call landed in a different
  // collector whose result is not what infer_arg_type_name reads.)
  collect_struct_field_types(stmts, out)
  // Perf: this table holds every top-level fn + enum variant of the merged
  // compile (thousands of entries) and fn_exists/fn_return_type consulted it
  // LINEARLY per expression during the rewrite. Sort once (STABLE, so the
  // leftmost duplicate stays the linear scan's "first match") and let the
  // helpers below binary-search. Nothing outside those helpers reads the
  // table positionally, so the order change is invisible.
  let names = array_empty()
  let mut ni = 0
  while ni < Array::length(out) {
    let (n, _) = Array::get(out, ni)
    Array::push(names, n)
    ni = ni + 1
  }
  let perm = sort_perm_by_names(names)
  let sorted = array_empty()
  let mut pi = 0
  while pi < Array::length(perm) {
    Array::push(sorted, Array::get(out, Array::get(perm, pi)))
    pi = pi + 1
  }
  sorted
}

/// Leftmost binary search over the SORTED fn_returns table (see
/// collect_fn_returns). Leftmost-of-run preserves first-match-wins for
/// duplicate names.
fn fn_returns_find(fn_returns: Array[(String, String)], fname: String) -> Int {
  let mut lo = 0
  let mut hi = Array::length(fn_returns)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (n, _) = Array::get(fn_returns, mid)
    if str_lt(n, fname) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  let mut res = -1
  if lo < Array::length(fn_returns) {
    let (n2, _) = Array::get(fn_returns, lo)
    if n2 == fname {
      res = lo
    }
  }
  res
}

fn fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {
  fn_returns_find(fn_returns, fname) >= 0
}

/// #1350 (Codex P1): the recorded return-type head for a FUNCTION-typed
/// return. Not a legal type name, so it can never collide with a real head.
/// Only fn_return_is_fn_type reads it; fn_return_type maps it to None so the
/// type-name consumers (infer_arg_type_name and everything downstream of it)
/// behave exactly as they did when function returns had an empty head.
fn fn_type_return_head() -> String {
  "->"
}

/// Does the fn_returns table record `fname` with return head `want` ANYWHERE,
/// not just at its leftmost entry?
///
/// #1491: `fn_return_type` answers "what does the FIRST `fname` entry return",
/// which silently loses every later duplicate. Constructor names are not
/// unique across enums -- two enums in one merged compile can both declare
/// `Red` -- so asking "is `Red` a variant of `Color`" through the first-match
/// helper answers about whichever enum happened to sort first (`Paint`), and
/// `Color::Red` fails the `qual_ctor_member` gate. The table already holds
/// BOTH entries; only the lookup was lossy. Duplicates are adjacent because
/// the table is sorted by name, so the run scan below is O(#duplicates).
fn fn_returns_has_type(fn_returns: Array[(String, String)], fname: String, want: String) -> Bool {
  let start = fn_returns_find(fn_returns, fname)
  if start < 0 {
    false
  } else {
    let mut i = start
    let mut found = false
    let mut done = false
    while !done && i < Array::length(fn_returns) {
      let (n, rt) = Array::get(fn_returns, i)
      if n == fname {
        if rt == want {
          found = true
          done = true
        } else {
          i = i + 1
        }
      } else {
        done = true
      }
    }
    found
  }
}

fn fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {
  let idx = fn_returns_find(fn_returns, fname)
  if idx < 0 {
    None
  } else {
    let (_, rt) = Array::get(fn_returns, idx)
    if String::length(rt) == 0 || rt == fn_type_return_head() {
      None
    } else {
      Some(rt)
    }
  }
}

/// Does `fname` positively RETURN A FUNCTION (an annotated function type)?
/// This is the pull-closure classification's real question -- distinct from
/// "the return annotation was omitted", which records an empty head.
fn fn_return_is_fn_type(fn_returns: Array[(String, String)], fname: String) -> Bool {
  let idx = fn_returns_find(fn_returns, fname)
  if idx < 0 {
    false
  } else {
    let (_, rt) = Array::get(fn_returns, idx)
    rt == fn_type_return_head()
  }
}

/// Desugar `for x in it { body }` over a struct iterator type `C` into a loop
/// driven by the functional `C::next(self) -> Option[(T, Self)]`:
///
///   let mut __iter_cur = it
///   let mut __iter_go = true
///   while __iter_go {
///     match C::next(__iter_cur) {
///       Some((x, __iter_rest)) => { __iter_cur = __iter_rest; body },
///       None => { __iter_go = false }
///     }
///   }
///
/// Nested loops shadow the `__iter_*` names correctly (ELetMut scoping). The
/// optional index binding is not supported for iterators (first slice).
///
/// `ctype` supplies the `C::next` namespace and `should_await` selects whether
/// that call is wrapped in `await`. All internal binders are minted fresh
/// against the iterand and body so user names that resemble lowering details
/// cannot be captured.
fn build_iter_for_with(name: String, ctype: String, should_await: Bool, iter: Expr, body: Expr) -> Expr {
  let src_name = dinsp_fresh_name("__iter_src", iter, body)
  let cur_name = dinsp_fresh_name("__iter_cur", iter, body)
  let go_name = dinsp_fresh_name("__iter_go", iter, body)
  let rest_name = dinsp_fresh_name("__iter_rest", iter, body)
  let raw_next = ECall(EIdent(String::concat(ctype, "::next"), -1), [
    EIdent(cur_name, -1)
  ], -1)
  let nextcall = if should_await {
    ECall(EIdent("await", -1), [raw_next], -1)
  } else {
    raw_next
  }
  let some_arm = (PCtor("Some", [PTuple([PBind(name), PBind(rest_name)])]), EAssign(cur_name, EIdent(rest_name, -1), body))
  let none_arm = (PCtor("None", array_empty()), EAssign(go_name, EBool(false), EUnit))
  let loop_body = EMatch(nextcall, [some_arm, none_arm])
  // Bind the iterand through an immutable `__iter_src` and initialize the
  // mutable cursor from that ident, rather than from `iter` directly. The
  // cursor is consumed by `C::next(__iter_cur)` and then reassigned each
  // iteration; initializing it from a fresh heap value (e.g. a struct literal
  // `for x in Range::{..}`) made that consume-then-reassign double-free the
  // initial value under RC. Seeding from a stable binding mirrors the working
  // `let r = ..; for x in r` shape so the ownership accounting balances (#704).
  ELet(src_name, iter, ELetMut(cur_name, EIdent(src_name, -1), ELetMut(go_name, EBool(true), EWhile(EIdent(go_name, -1), loop_body), -1), -1), -1)
}

fn build_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {
  build_iter_for_with(name, ctype, false, iter, body)
}

/// #736: `for x in xs` over a USER type implementing the indexed Iterable
/// protocol (`C::iter_length(Self) -> Int` + `C::iter_get(Self, Int) -> T`,
/// e.g. @vibe/core's List) desugars to an index-driven loop:
///
///   let __iter_src = xs
///   let __iter_n = C::iter_length(__iter_src)
///   let mut __iter_i = 0
///   while __iter_i < __iter_n {
///     let x = C::iter_get(__iter_src, __iter_i)
///     body
///     __iter_i = __iter_i + 1
///   }
///
/// The iterand is seeded through an immutable `__iter_src` for the same RC
/// ownership reason as build_iter_for_with (#704). Unlike the next-protocol
/// desugar, the optional index binding IS supported here (the loop counter is
/// the index): `for x, i in xs` binds `i` to the current `__iter_i`. The loop
/// is a statement (no per-iteration result collection).
fn build_indexed_iter_for(name: String, idx: Option[String], ctype: String, iter: Expr, body: Expr) -> Expr {
  let src_name = dinsp_fresh_name("__iter_src", iter, body)
  let len_name = dinsp_fresh_name("__iter_n", iter, body)
  let index_name = dinsp_fresh_name("__iter_i", iter, body)
  let get_call = ECall(EIdent(String::concat(ctype, "::iter_get"), -1), [
    EIdent(src_name, -1),
    EIdent(index_name, -1)
  ], -1)
  let len_call = ECall(EIdent(String::concat(ctype, "::iter_length"), -1), [
    EIdent(src_name, -1)
  ], -1)
  let incr = EAssign(index_name, EBinOp("+", EIdent(index_name, -1), EInt(1)), EUnit)
  let bound_body = match idx {
    Some(iname) => ELet(iname, EIdent(index_name, -1), body, -1),
    None => body
  }
  let loop_body = ELet(name, get_call, ESeq(bound_body, incr), -1)
  ELet(src_name, iter, ELet(len_name, len_call, ELetMut(index_name, EInt(0), EWhile(EBinOp("<", EIdent(index_name, -1), EIdent(len_name, -1)), loop_body), -1), -1), -1)
}

/// `for` over an async iterator type `C` whose
/// `C::next(self) -> Future[Option[(T, Self)]] with Async`: identical to the
/// sync loop but each step `await`s the next-future. `await` is the M1a builtin
/// (`await(Future[T]) -> T`); on the synchronous ready-future codegen it unwraps
/// in place, so this also runs on the linear backend today.
/// #1341 (ADR-0089 D3): `for b in <host stream>`. The p3 host stream has no
/// `next` returning `Future[Option[T]]` -- its read primitive is the scalar
/// `host_stream_next(s) -> Int with Async`, which yields the next byte or
/// -1 once the writer is gone (spec §3.18). So this loop is built directly on
/// that read rather than on the AsyncIter protocol:
///
///   let __hs_src = <iter>
///   let mut __hs_b = host_stream_next(__hs_src)
///   while 0 <= __hs_b {
///     let <name> = __hs_b
///     <body>
///     __hs_b = host_stream_next(__hs_src)
///   }
///
/// which is exactly the hand-written while loop the named-hoststreams gate has
/// been running since #1339 -- so this introduces no new codegen, only the
/// surface. Each read parks and resumes on its own (`Suspend(handle + 2048)`),
/// which is why the enclosing row must carry `Async`; the checker requires
/// that separately (checker_effects, #1358/#1341).
///
/// No index binding: `for b, i in s` over a host stream would have to count
/// reads, and a byte offset is not the same thing as a position in a
/// re-iterable collection. Left unsupported rather than given a plausible
/// wrong meaning.
fn build_host_stream_for(name: String, iter: Expr, body: Expr) -> Expr {
  let src_name = dinsp_fresh_name("__hs_src", iter, body)
  let byte_name = dinsp_fresh_name("__hs_b", iter, body)
  let read_call = ECall(EIdent("host_stream_next", -1), [EIdent(src_name, -1)], -1)
  let advance = EAssign(byte_name, read_call, EUnit)
  let loop_body = ELet(name, EIdent(byte_name, -1), ESeq(body, advance), -1)
  ELet(src_name, iter, ELetMut(byte_name, read_call, EWhile(EBinOp("<=", EInt(0), EIdent(byte_name, -1)), loop_body), -1), -1)
}

fn build_await_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {
  build_iter_for_with(name, ctype, true, iter, body)
}

/// `for x in pull { body }` over a pull closure `pull : () -> Option[T]`
/// (host-state async iterator, e.g. `stdin_stream`): drive `pull()` to `None`.
/// This is the M2c-3 pull model, moved here from the parser so `for` shares
/// one type-directed desugar with the trait iterators (a struct `C` with a
/// `C::next` drives the iterator loop above; anything else — a pull closure or a
/// call whose return type is unknown — falls back to this).
fn build_pull_for_in(value_name: String, index_name: Option[String], iterable: Expr, body: Expr) -> Expr {
  let continue_name = dinsp_fresh_name("__pull_continue", iterable, body)
  let next_name = dinsp_fresh_name("__pull_next", iterable, body)
  let some_arm = match index_name {
    Some(ix) => ESeq(body, EAssign(ix, EBinOp("+", EIdent(ix, -1), EInt(1)), EUnit)),
    None => ESeq(body, EUnit)
  }
  let loop_body = EMatch(ECall(EIdent(next_name, -1), array_empty(), -1), [
    (PCtor("Some", [PBind(value_name)]), some_arm),
    (PCtor("None", array_empty()), EAssign(continue_name, EBool(false), EUnit))
  ])
  let core_loop = ELetMut(continue_name, EBool(true), EWhile(EIdent(continue_name, -1), loop_body), -1)
  let with_index = match index_name {
    Some(ix) => ELetMut(ix, EInt(0), core_loop, -1),
    None => core_loop
  }
  ELet(next_name, iterable, with_index, -1)
}

/// Does `fname`'s recorded return-type head indicate an async iterator
/// (`next() -> Future[Option[..]]`)? Drives the `await`-wrapped loop choice.
fn fn_return_is_future(fn_returns: Array[(String, String)], fname: String) -> Bool {
  match fn_return_type(fn_returns, fname) {
    Some(head) => head == "Future",
    None => false
  }
}

/// #827: is `inner` positively a pull-closure source? The pull loop binds the
/// iteratee as `__pull_next` and CALLS it, so lowering anything that is not a
/// function value that way is a call_indirect on a non-function pointer — an
/// out-of-bounds table trap at runtime. Only two shapes are accepted: a lambda
/// literal, and a call to a known function that positively RETURNS A FUNCTION
/// (the closure-returning sources like
/// `stdin_stream: (Int) -> (() -> Option[String])`).
///
/// #1350 (Codex P1) tightened the second shape. It used to accept any known
/// function reaching this point, on the reasoning that a named return head
/// would have classified in the Some branch instead -- true while only
/// `for await` could get here, but wrong once plain `for` shares the path: an
/// UNANNOTATED `let values = () -> { [40, 2] }` also has no head, and its
/// array was then called as a closure. Requiring the recorded head to be the
/// function-type sentinel separates "returns a function" from "return
/// annotation omitted"; the latter falls back to the array loop, as it did
/// before this classification was shared.
fn for_await_is_pull_source(inner: Expr, fn_returns: Array[(String, String)]) -> Bool {
  match inner {
    EFn(_, _, _, _, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(fname, _) => fn_return_is_fn_type(fn_returns, fname),
      _ => false
    },
    _ => false
  }
}

/// #1350: the trait-free arm of the for-loop classification. Without a
/// declared trait there are no `impl ::next` methods to dispatch, so a plain
/// `for x in e` keeps its EForIn (array) lowering -- but the two ASYNC shapes
/// still classify here, because they never needed the trait machinery and
/// their consumers are trait-free files (the prelude's AsyncIter terminals,
/// @vibe/console's pull streams). This is the `for await` path's old
/// "runs regardless of whether a trait is declared" property, kept after the
/// syntax went away.
///
/// #827's hazard is gone by construction rather than by diagnostic: the
/// UNCLASSIFIED fallback is now the array loop (correct for the eager
/// Array-backed `Stream`, ADR-0012), not the pull loop that used to
/// call_indirect an array pointer. The pull loop fires only on a POSITIVE
/// function-shaped classification.
fn classify_trait_free_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if tn == "HostStream" {
      build_host_stream_for(name, riter, rbody)
    } else if fn_exists(fn_returns, String::concat(tn, "::next")) && fn_return_is_future(fn_returns, String::concat(tn, "::next")) {
      build_await_iter_for(name, tn, riter, rbody)
    } else {
      classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
    },
    None => if for_await_is_pull_source(iter, fn_returns) {
      build_pull_for_in(name, idx, riter, rbody)
    } else {
      EForIn(name, idx, riter, rbody)
    }
  }
}

/// `for x in iter { body }`: iterator (`::next`) / iterable (`::iter`) / array
/// classification. `riter` / `rbody` are already rewritten.
/// #736: the indexed-Iterable slice of for-loop classification, USER types only
/// (struct_sets gate — Array/String/Map keep the builtin EForIn lowering even
/// though the prelude's Iterable impls define e.g. `Array::iter_length`). Split
/// out of classify_sync_for_loop because it needs no declared trait (the
/// protocol is plain named `C::iter_length`/`C::iter_get` functions, e.g.
/// @vibe/core's List), so it also runs for trait-free programs where the
/// next/iter classification stays gated off.
fn classify_indexed_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if struct_set_has(struct_sets, tn) {
      if fn_exists(fn_returns, String::concat(tn, "::iter_length")) && fn_exists(fn_returns, String::concat(tn, "::iter_get")) {
        build_indexed_iter_for(name, idx, tn, riter, rbody)
      } else {
        // #2152: a declared struct/enum with NO iteration protocol used to
        // fall through to the residual EForIn array loop, which read the
        // value as an array pointer -- one iteration binding garbage, no
        // diagnostic. The checker cannot own this rejection: its env may
        // not see an `impl Iterator` living in a dependency (the classifier
        // comment at its `for` arm says why it answers `CtStruct => 0`
        // without a protocol check). THIS pass runs on the merged sources,
        // so every protocol function the program has is in `fn_returns` --
        // a miss here is a real miss, and it throws instead of iterating
        // garbage.
        throw(String::concat(for_no_protocol_msg(tn), for_iterand_off_marker(iter)))
      }
    } else {
      EForIn(name, idx, riter, rbody)
    },
    None => EForIn(name, idx, riter, rbody)
  }
}

/// #2152: the rejection message for a `for` over a declared type with no
/// iteration protocol. Leads with the edits that make the loop work.
fn for_no_protocol_msg(tn: String) -> String {
  String::concat("cannot iterate a `", String::concat(tn, String::concat("` value in `for`: define `", String::concat(tn, String::concat("::iter_length` + `", String::concat(tn, String::concat("::iter_get`, or `impl Iterator for ", String::concat(tn, String::concat("` with a `next` method, or loop over an Array of its elements -- `", String::concat(tn, "` declares no iteration protocol, so the loop has nothing to draw elements from (#2152)"))))))))))
}

/// #2152 (Codex P2 on the PR): transport the iterand's source offset as the
/// standard ` [@off=N]` side-channel marker when the AST carries one.
/// Measured 2026-08-21: the compile entries parse with the PLAIN
/// `parse_program(lex(..))` (no starts array => every node's offset is -1,
/// the pitfall cli_support.vibe documents for read_program), so in those
/// lanes this is a no-op today -- the marker resolves as soon as a lane
/// parses located (the check walk already does; wiring compile is #1514 /
/// #1567's job). Safe by construction either way: emit_compile_diag strips
/// an unresolved marker, so it can never leak (#1445's failure mode) or name
/// a wrong position against merged module text (#1596's fail-closed rule).
fn for_iterand_off_marker(iter: Expr) -> String {
  let off = match iter {
    EIdent(_, o) => o,
    ECall(_, _, o) => o,
    EDot(_, _, o, _) => o,
    _ => 0 - 1
  }
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// `for x in iter { body }` -- the ONE for-loop classification (#1350 folded
/// the `for await` variant in here).
///
/// The async/sync choice is made from the iterand's type, exactly as the old
/// `for await` path made it: a `C::next` returning `Future[..]` drives the
/// await-wrapped loop, a plain `C::next` the sync one. That is why the
/// syntactic marker could go -- it never carried information this pass did
/// not already have, it only duplicated what the effect row states.
///
/// One shape is admitted here that the old sync path rejected: a PULL CLOSURE
/// (`() -> Option[T]`, e.g. `stdin_stream(4)`), which the `for await` path
/// classified via for_await_is_pull_source. The classification is positive
/// (lambda literal, or a call to a known top-level fn with a non-named return
/// head) and it only fires where the sync path used to emit `EForIn` over a
/// function value -- a call_indirect on a non-array pointer, i.e. a runtime
/// trap. So this strictly turns a trap into a working loop (#827's own
/// reasoning, now applied to the single surface).
fn classify_sync_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if is_residual_eager_for_type(tn) {
      // These eager builtins own the residual EForIn lowering. A public
      // conversion such as `Array::iter(xs) -> AsyncIter[T]` must only run
      // when it is called explicitly; its mere presence must not change every
      // `for x in xs` into the named `C::iter` protocol.
      classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
    } else if tn == "HostStream" {
      build_host_stream_for(name, riter, rbody)
    } else if fn_exists(fn_returns, String::concat(tn, "::next")) {
      if fn_return_is_future(fn_returns, String::concat(tn, "::next")) {
        build_await_iter_for(name, tn, riter, rbody)
      } else {
        build_iter_for(name, tn, riter, rbody)
      }
    } else {
      match fn_return_type(fn_returns, String::concat(tn, "::iter")) {
        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, "::iter"), -1), [
          riter
        ], -1), rbody),
        None => classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      }
    },
    None => if for_await_is_pull_source(iter, fn_returns) {
      build_pull_for_in(name, idx, riter, rbody)
    } else {
      EForIn(name, idx, riter, rbody)
    }
  }
}

/// #1064 (Codex review on the original fix): a railway-bound name's real type
/// is `val`'s PAYLOAD, not `val`'s own wrapper type -- conflating them broke
/// plain scalar payloads (the common case: `let* rv = half(x)`, `half: Int ->
/// Option[Int]`, `rv: Int`). But when `val` is a LITERAL nested constructor
/// (`let* outer = Some(Some(1))`), the payload genuinely IS an Option/Result
/// value, so `outer` DOES need a var_types entry -- otherwise a follow-up
/// `let* inner = outer` chaining through the bare identifier can't tell it
/// apart from a Result and defaults to the wrong (Ok/Err) arms. Recurse ONE
/// level into a literal `Some(x)`/`Ok(x)` (never `Err(x)` -- Err's own
/// payload is the error value, never itself railway-chained) to recover the
/// payload's head type for exactly this literal-nesting shape; every other
/// `val` shape (a call to a user function, a bare identifier, ...) has no
/// recoverable payload type here (`fn_returns` only carries a call's return
/// head, not its type arguments) and stays untracked, same as the plain
/// scalar fix.
fn railway_bind_payload_type(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match val {
    ECall(callee, inner_args, _) => match callee {
      EIdent(cname, _) => if (cname == "Some" || cname == "Ok") && Array::length(inner_args) == 1 {
        infer_arg_type_name(Array::get(inner_args, 0), struct_sets, var_types, fn_returns)
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

fn constructor_env_entry_belongs_to(entry_name: String, name: String) -> Bool {
  // This environment is shared with equality, rendering, tuple projection,
  // array-element, and impl-target inference. Shadow only constructor-owned
  // evidence here; those other consumers rebind their metadata in rewrite_expr.
  if entry_name == name || entry_name == constructor_mask_key(name) || entry_name == constructor_head_key(name) || entry_name == local_fn_return_key(name) {
    true
  } else {
    let suffix = String::concat("$", name)
    String::ends_with(entry_name, suffix) && (String::starts_with(entry_name, "__ctorpay$") || String::starts_with(entry_name, "__ctorpayi$"))
  }
}

fn constructor_env_has_binding(var_types: Array[(String, String)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(var_types) && !found {
    let (entry_name, _) = Array::get(var_types, i)
    if constructor_env_entry_belongs_to(entry_name, name) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn constructor_env_copy_without(var_types: Array[(String, String)], name: String) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(var_types) {
    let entry = Array::get(var_types, i)
    let (entry_name, _) = entry
    if constructor_env_entry_belongs_to(entry_name, name) {
      ()
    } else {
      Array::push(out, entry)
    }
    i = i + 1
  }
  out
}

/// Constructor recovery has a stricter shadowing contract than the shared
/// rewrite environment: an unresolved inner binding must still mask both the
/// nominal and every per-binding sentinel carried by an outer binding of the
/// same name. A fresh name has nothing to mask, so reuse the parent array —
/// copying on every `let` of a large function is what moved selfcompile heap
/// +27% on the constructor-witness branch.
fn extend_constructor_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => if constructor_env_has_binding(var_types, name) {
      let out = constructor_env_copy_without(var_types, name)
      Array::push(out, (name, tname))
      out
    } else {
      extend_var_types(var_types, name, Some(tname))
    },
    None => if constructor_binding_has_evidence(var_types, name) || constructor_env_has_binding(var_types, name) {
      let out = constructor_env_copy_without(var_types, name)
      Array::push(out, (constructor_mask_key(name), ""))
      out
    } else {
      var_types
    }
  }
}

/// Shared rewrite env keeps a historical name fallback for rendering; constructor
/// recovery still sees the mask so a stale outer witness cannot be selected.
fn constructor_rewrite_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => extend_constructor_var_types(var_types, name, Some(tname)),
    None => if !constructor_binding_has_evidence(var_types, name) && !constructor_env_has_binding(var_types, name) {
      var_types
    } else {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        let entry = Array::get(var_types, i)
        let (entry_name, _) = entry
        if entry_name == constructor_mask_key(name) || entry_name == constructor_head_key(name) || entry_name == local_fn_return_key(name) {
          ()
        } else {
          Array::push(out, entry)
        }
        i = i + 1
      }
      Array::push(out, (constructor_mask_key(name), ""))
      out
    }
  }
}

fn constructor_for_body_var_types(iter: Expr, value_name: String, index_name: Option[String], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let value_vars = constructor_rewrite_var_types(var_types, value_name, infer_arg_elem_type_name(iter, struct_sets, var_types, fn_returns))
  match index_name {
    Some(name) => constructor_rewrite_var_types(value_vars, name, Some("Int")),
    None => value_vars
  }
}

fn gen_uses_constructor_receiver(gen: DictGen) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(gen.threaded) && !found {
    let (_, _, recv_idx) = Array::get(gen.threaded, i)
    found = is_constructor_recv_index(recv_idx)
    i = i + 1
  }
  found
}

/// Whether a binding directly stores a constructor-indexed generic call. Only
/// these values need extended constructor inference; block/match/handler results
/// are inferred when they are used directly as witness receivers.
fn result_uses_constructor_witness(expr: Expr, gens: Array[DictGen]) -> Bool {
  Array::get(dtd_constructor_tracking, 0) && match expr {
    ECall(EIdent(name, _), _, _) => match lookup_gen_entry(gens, name) {
      Some(gen) => gen_uses_constructor_receiver(gen),
      None => false
    },
    _ => false
  }
}

fn collect_constructor_receiver_names(expr: Expr) -> Unit {
  match expr {
    EIdent(name, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      ()
    } else {
      Array::push(dtd_constructor_local_returns, name)
    },
    _ => ()
  }
  let children = expr_children(expr)
  let mut i = 0
  while i < Array::length(children) {
    collect_constructor_receiver_names(Array::get(children, i))
    i = i + 1
  }
}

fn record_constructor_receiver_names(gen: DictGen, args: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(gen.constructor_recvs) {
    let (_, encoded_index) = Array::get(gen.constructor_recvs, i)
    let index = decode_constructor_recv_index(encoded_index)
    if index >= 0 && index < Array::length(args) {
      collect_constructor_receiver_names(Array::get(args, index))
    } else {
      ()
    }
    i = i + 1
  }
}

fn expr_uses_constructor_witness(expr: Expr, gens: Array[DictGen]) -> Bool {
  let here = match expr {
    ECall(EIdent(name, _), args, _) => match lookup_gen_entry(gens, name) {
      Some(gen) => if gen_uses_constructor_receiver(gen) {
        record_constructor_receiver_names(gen, args)
        true
      } else {
        false
      },
      None => false
    },
    _ => false
  }
  let children = expr_children(expr)
  let mut i = 0
  let mut found = here
  while i < Array::length(children) {
    if expr_uses_constructor_witness(Array::get(children, i), gens) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn stmts_use_constructor_witness(stmts: Array[Stmt], gens: Array[DictGen]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    let current = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => expr_uses_constructor_witness(expr, gens),
      SLetMut(_, _, expr) => expr_uses_constructor_witness(expr, gens),
      SLetPat(_, expr) => expr_uses_constructor_witness(expr, gens),
      STest(_, expr) => expr_uses_constructor_witness(expr, gens),
      SBench(_, expr) => expr_uses_constructor_witness(expr, gens),
      SExample(_, expr) => expr_uses_constructor_witness(expr, gens),
      SExpr(expr) => expr_uses_constructor_witness(expr, gens),
      SFnDecl(_, _, expr, requires, ensures) => expr_uses_constructor_witness(expr, gens) || expr_list_uses_constructor_witness(requires, gens) || expr_list_uses_constructor_witness(ensures, gens),
      SModule(_, _, body) => stmts_use_constructor_witness(body, gens),
      _ => false
    }
    if current {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn expr_list_uses_constructor_witness(exprs: Array[Expr], gens: Array[DictGen]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(exprs) {
    if expr_uses_constructor_witness(Array::get(exprs, i), gens) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn constructor_receiver_pattern_is_needed(pat: Pat) -> Bool {
  let binders = empty_str_array()
  collect_pat_binders(pat, binders)
  let mut i = 0
  let mut needed = false
  while i < Array::length(binders) && !needed {
    needed = str_array_contains(dtd_constructor_local_returns, Array::get(binders, i))
    i = i + 1
  }
  needed
}

fn constructor_receiver_arms_need_scrutinee(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut needed = false
  while i < Array::length(arms) && !needed {
    let (pat, _) = Array::get(arms, i)
    needed = constructor_receiver_pattern_is_needed(pat)
    i = i + 1
  }
  needed
}

fn propagate_constructor_receiver_names_expr(expr: Expr) -> Unit {
  match expr {
    ELet(name, value, _, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      collect_constructor_receiver_names(value)
    } else {
      ()
    },
    ELetRec(name, value, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      collect_constructor_receiver_names(value)
    } else {
      ()
    },
    ELetMut(name, value, _, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      collect_constructor_receiver_names(value)
    } else {
      ()
    },
    EAssign(name, value, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      collect_constructor_receiver_names(value)
    } else {
      ()
    },
    EAssignOp(name, _, value, _) => if str_array_contains(dtd_constructor_local_returns, name) {
      collect_constructor_receiver_names(value)
    } else {
      ()
    },
    EForIn(value_name, key_name, iter, _) => if str_array_contains(dtd_constructor_local_returns, value_name) || match key_name {
      Some(name) => str_array_contains(dtd_constructor_local_returns, name),
      None => false
    } {
      collect_constructor_receiver_names(iter)
    } else {
      ()
    },
    ELoop(params, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (name, initial) = Array::get(params, i)
        if str_array_contains(dtd_constructor_local_returns, name) {
          collect_constructor_receiver_names(initial)
        } else {
          ()
        }
        i = i + 1
      }
    },
    EMatch(scrutinee, arms) => if constructor_receiver_arms_need_scrutinee(arms) {
      collect_constructor_receiver_names(scrutinee)
    } else {
      ()
    },
    EHandle(body, arms) => if constructor_receiver_arms_need_scrutinee(arms) {
      collect_constructor_receiver_names(body)
    } else {
      ()
    },
    _ => ()
  }
  let children = expr_children(expr)
  let mut i = 0
  while i < Array::length(children) {
    propagate_constructor_receiver_names_expr(Array::get(children, i))
    i = i + 1
  }
}

fn propagate_constructor_receiver_names(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, expr) => {
        if str_array_contains(dtd_constructor_local_returns, name) {
          collect_constructor_receiver_names(expr)
        } else {
          ()
        }
        propagate_constructor_receiver_names_expr(expr)
      },
      SLetMut(name, _, expr) => {
        if str_array_contains(dtd_constructor_local_returns, name) {
          collect_constructor_receiver_names(expr)
        } else {
          ()
        }
        propagate_constructor_receiver_names_expr(expr)
      },
      SLetPat(pat, expr) => {
        if constructor_receiver_pattern_is_needed(pat) {
          collect_constructor_receiver_names(expr)
        } else {
          ()
        }
        propagate_constructor_receiver_names_expr(expr)
      },
      STest(_, expr) => propagate_constructor_receiver_names_expr(expr),
      SBench(_, expr) => propagate_constructor_receiver_names_expr(expr),
      SExample(_, expr) => propagate_constructor_receiver_names_expr(expr),
      SExpr(expr) => propagate_constructor_receiver_names_expr(expr),
      SFnDecl(_, _, expr, requires, ensures) => {
        propagate_constructor_receiver_names_expr(expr)
        let mut ri = 0
        while ri < Array::length(requires) {
          propagate_constructor_receiver_names_expr(Array::get(requires, ri))
          ri = ri + 1
        }
        let mut ei = 0
        while ei < Array::length(ensures) {
          propagate_constructor_receiver_names_expr(Array::get(ensures, ei))
          ei = ei + 1
        }
      },
      SModule(_, _, body) => propagate_constructor_receiver_names(body),
      _ => ()
    }
    i = i + 1
  }
}

/// Remove every name introduced by a pattern before adding any constructor
/// evidence recoverable from its scrutinee. Unknown pattern payloads still
/// shadow outer bindings; retaining them can select a stale witness.
fn mask_constructor_pat_binders(var_types: Array[(String, String)], pat: Pat, fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let binders = empty_str_array()
  collect_pat_binders(pat, binders)
  if Array::length(binders) == 0 {
    var_types
  } else {
    let mut needed = false
    let mut bi = 0
    while bi < Array::length(binders) {
      let name = Array::get(binders, bi)
      if constructor_binding_has_evidence(var_types, name) || constructor_env_has_binding(var_types, name) || fn_return_type(fn_returns, name) != None {
        needed = true
      } else {
        ()
      }
      bi = bi + 1
    }
    if !needed {
      var_types
    } else {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        let entry = Array::get(var_types, i)
        let (entry_name, _) = entry
        let mut drop = false
        let mut j = 0
        while j < Array::length(binders) && !drop {
          if constructor_env_entry_belongs_to(entry_name, Array::get(binders, j)) {
            drop = true
          } else {
            j = j + 1
          }
        }
        if drop {
          ()
        } else {
          Array::push(out, entry)
        }
        i = i + 1
      }
      let mut k = 0
      while k < Array::length(binders) {
        let name = Array::get(binders, k)
        if constructor_binding_has_evidence(var_types, name) || constructor_env_has_binding(var_types, name) || fn_return_type(fn_returns, name) != None {
          Array::push(out, (constructor_mask_key(name), ""))
        } else {
          ()
        }
        k = k + 1
      }
      out
    }
  }
}

/// Build a match arm's constructor environment without retaining shadowed
/// evidence. A bare binding receives the scrutinee constructor directly;
/// structured patterns reuse the payload/shape recovery shared by lowering.
fn constructor_match_arm_var_types(scrut: Expr, pat: Pat, gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let masked = mask_constructor_pat_binders(var_types, pat, fn_returns)
  match pat {
    PBind(name) => {
      let bound = extend_constructor_var_types(masked, name, infer_constructor_arg_type_name(scrut, gens, struct_sets, var_types, fn_returns))
      let with_return = extend_local_fn_return(bound, name, scrut)
      match lookup_var_type(with_return, local_fn_return_key(name)) {
        Some(_) => with_return,
        None => match scrut {
          EFn(_, _, _, _, _, body) => extend_constructor_var_types(with_return, local_fn_return_key(name), infer_constructor_arg_type_name(body, gens, struct_sets, var_types, fn_returns)),
          _ => with_return
        }
      }
    },
    PCtor(cn, sub) => {
      match constructor_call_payload_var_types(scrut, cn, sub, gens, struct_sets, masked, fn_returns) {
        Some(env) => env,
        None => arm_binder_var_types_env(scrut, pat, masked, struct_sets, fn_returns)
      }
    },
    _ => arm_binder_var_types_env(scrut, pat, masked, struct_sets, fn_returns)
  }
}

/// Extend the shared rewrite environment when the binding's type is known.
/// Unknown bindings retain the historical best-effort environment because
/// shape/rendering consumers have separate conservative fallbacks.
fn extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, Array::get(var_types, i))
        i = i + 1
      }
      Array::push(out, (name, tname))
      out
    },
    None => var_types
  }
}

/// #672: a qualified constructor `Enum::Variant` -> the unqualified variant
/// `Variant`, when `member` is a constructor of enum `head` (variants are bound
/// unqualified, and codegen's ctor table is keyed unqualified). `head` MUST be a
/// known user enum/struct (`struct_sets` includes enum names) — this is the gate
/// that keeps builtin qualified calls like `String::join` / `Array::map` alone
/// even when a same-named function (`join`/`map`) happens to return that type.
fn qual_ctor_member(head: String, member: String, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Option[String] {
  // #1502: an alias qualifier (`type C = Color` -> `C::Red`) is normalized to
  // the enum it names before the gate. Without this the checker accepts
  // `C::Red` (it follows `TDAlias`) while this pass leaves the name qualified,
  // and codegen -- whose ctor table is keyed unqualified -- dies with
  // `undefined variable (ident): C::Red`. A non-alias head resolves to itself.
  let head = resolve_alias_head(fn_returns, head)
  if struct_set_has(struct_sets, head) {
    // #1491: ask whether `member` is recorded as a constructor of THIS enum,
    // not what `member`'s first table entry returns. Constructor names collide
    // across enums (`enum Color { Red }` next to an imported `enum Paint
    // { Red }`), and the first-match form answered about the wrong enum, left
    // the name qualified, and handed codegen -- whose ctor table is keyed
    // unqualified -- `undefined variable (ident): Color::Red`.
    if fn_returns_has_type(fn_returns, member, head) {
      Some(member)
    } else {
      None
    }
  } else {
    None
  }
}

/// #635: classify a call as a railway-bind/op sentinel. Returns
///   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1
///       a 1-param closure),
///   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),
///   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the
///       name but with a different arity/shape).
fn try_sentinel(callee: Expr, args: Array[Expr]) -> Int {
  match callee {
    EIdent(n, _) => if n == "__try_bind" {
      if Array::length(args) == 2 {
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {
            0
          } else {
            2
          },
          _ => 2
        }
      } else {
        2
      }
    } else if n == "__try_op" {
      if Array::length(args) == 1 {
        1
      } else {
        2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// #941: best-effort char offset of a railway operand, so the desugar-generated
/// failure-track nodes (`Err(e)` / `None`) carry the `?`/`let*` operand's own
/// source position — the checker's Option⇔Result mixing diagnostics anchor on
/// it. -1 (unlocated) when the operand carries no offset.
fn railway_val_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      railway_val_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_val_off(base)
    },
    EBinOp(_, lhs, _) => railway_val_off(lhs),
    _ => -1
  }
}

/// #635/#1324: lower the `let* name = val <rest>` sentinel to the Option
/// railway — `match val { Some(name) => rest, None => None }`.
///
/// `Result` used to be the OTHER railway monad (and the default when this
/// pass could not name `val`'s type), but #1324 removed it from the language,
/// leaving `Option` as the only short-circuit monad — so the lowering no
/// longer needs to type-direct at all. A scrutinee that is not an `Option`
/// is reported by the checker's ordinary unification against these arms.
fn lower_try_bind(val: Expr, name: String, rest: Expr) -> Expr {
  let voff = railway_val_off(val)
  // `__try_none` is the origin marker, the same role `__try_v` plays for
  // postfix `?`. A user-written `None => None` is `EIdent("None")` and
  // must not be classified as `let*` — especially on the unlocated
  // `parse_program` path, where every offset is -1. Check remaps the
  // name for typing; `erase_railway_origin_markers` turns it back into
  // `None` after a clean check so codegen does not see a synthetic ident.
  EMatch(val, [
    (PCtor("Some", [PBind(name)]), rest),
    (PCtor("None", array_empty()), EIdent("__try_none", voff))
  ])
}

/// #635/#1324: lower the `val?` sentinel to the Option railway — yield the
/// inner value on `Some`, early-`return None` on `None`. Uses `EReturn`, so
/// the enclosing function short-circuits. See `lower_try_bind` for why
/// `Option` is now the only monad this lowers to.
fn lower_try_op(val: Expr) -> Expr {
  let voff = railway_val_off(val)
  EMatch(val, [
    (PCtor("Some", [PBind("__try_v")]), EIdent("__try_v", -1)),
    (PCtor("None", array_empty()), EReturn(EIdent("None", voff)))
  ])
}

/// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only
/// the `__try_bind`/`__try_op` sentinels (everything else is recursed
/// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs
/// from BOTH the checker (`check_program`, where the heavy dict-passing pass does
/// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert
/// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks
/// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.
fn railway_rw(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], changed: Option[Array[Bool]]) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      let k = try_sentinel(callee, args)
      if k == 0 {
        match changed {
          Some(cell) => {
            Array::set(cell, 0, true)
          },
          None => {
            ()
          }
        }
        let val = Array::get(args, 0)
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, 0)
            let rwval = railway_rw(val, struct_sets, var_types, fn_returns, changed)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))
            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns, changed)
            lower_try_bind(rwval, name, rwrest)
          },
          _ => EUnit
        }
      } else if k == 1 {
        match changed {
          Some(cell) => {
            Array::set(cell, 0, true)
          },
          None => {
            ()
          }
        }
        let val = Array::get(args, 0)
        let rwval = railway_rw(val, struct_sets, var_types, fn_returns, changed)
        lower_try_op(rwval)
      } else {
        let rwargs = for a in args {
          railway_rw(a, struct_sets, var_types, fn_returns, changed)
        }
        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {
          Some(map_get) => {
            match changed {
              Some(cell) => {
                Array::set(cell, 0, true)
              },
              None => {
                ()
              }
            }
            map_get
          },
          None => ECall(railway_rw(callee, struct_sets, var_types, fn_returns, changed), rwargs, off)
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns, changed)),
    EStringInterp(_) => expr,
    EIdent(_, _) => expr,
    ETuple(elems) => ETuple(for e in elems {
      railway_rw(e, struct_sets, var_types, fn_returns, changed)
    }),
    EArray(elems) => EArray(for e in elems {
      railway_rw(e, struct_sets, var_types, fn_returns, changed)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns, changed)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns, changed)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns, changed), railway_rw(t, struct_sets, var_types, fn_returns, changed), railway_rw(e, struct_sets, var_types, fn_returns, changed)),
    ELet(name, val, body, soff) => {
      let new_val = railway_rw(val, struct_sets, var_types, fn_returns, changed)
      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns, changed), soff)
    },
    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns, changed), railway_rw(body, struct_sets, var_types, fn_returns, changed)),
    ELetMut(name, val, body, soff) => {
      let new_val = railway_rw(val, struct_sets, var_types, fn_returns, changed)
      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns, changed), soff)
    },
    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns, changed), railway_rw(cont, struct_sets, var_types, fn_returns, changed)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns, changed), railway_rw(cont, struct_sets, var_types, fn_returns, changed)),
    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns, changed), railway_rw(b, struct_sets, var_types, fn_returns, changed)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        // #1878: tuple-destructure arms hand record sentinels to their
        // binders (see arm_binder_var_types) — this walk runs BEFORE the
        // checker, so the arm body's `binding.field` reads rewrite to
        // positional `__rec_field` here too.
        let arm_vars = arm_binder_var_types_env(scrut, p, var_types, struct_sets, fn_returns)
        Array::push(out, (p, railway_rw(b, struct_sets, arm_vars, fn_returns, changed)))
        i = i + 1
      }
      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns, changed), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns, changed)))
        i = i + 1
      }
      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns, changed), out)
    },
    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns, changed), railway_rw(b, struct_sets, var_types, fn_returns, changed)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, railway_rw(init, struct_sets, var_types, fn_returns, changed))
    }, railway_rw(body, struct_sets, var_types, fn_returns, changed)),
    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns, changed), railway_rw(body, struct_sets, var_types, fn_returns, changed)),
    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns, changed), railway_rw(r, struct_sets, var_types, fn_returns, changed)),
    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns, changed)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns, changed)),
    EDot(obj, field, off, fdoff) => {
      let robj = railway_rw(obj, struct_sets, var_types, fn_returns, changed)
      match anon_dot_rewrite(obj, field, off, robj, var_types) {
        Some(rw) => {
          match changed {
            Some(cell) => {
              Array::set(cell, 0, true)
            },
            None => {
              ()
            }
          }
          rw
        },
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns, changed)),
    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns, changed)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns, changed))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      railway_rw(e, struct_sets, var_types, fn_returns, changed)
    })
  }
}

/// #839: every top-level `let name = record { .. }` whose field-set matches no
/// declared struct, collected as `__anonrec:` var_types entries UP FRONT (same
/// encoding `anon_record_inferred`/`anon_dot_rewrite` use for a local `let`).
/// Threaded as the BASE var_types into every top-level statement's own
/// `railway_rw` pass below (instead of starting each statement fresh from
/// empty), so `name.field` resolves whether it appears in a LATER top-level
/// statement or inside a function/test body that merely closes over a
/// top-level binding — not just within the same statement's own expression
/// tree (#839: previously the only working position was a bare top-level
/// expression statement in the SAME statement as the record literal, which
/// ADR-0069 now rejects outright). Consistent with `collect_struct_field_sets`
/// / `collect_fn_returns`, this does not recurse into `SModule` bodies — a
/// module-nested anonymous-record `let` is a fresh scope of its own, same as
/// module-nested struct/fn declarations are already scoped in those passes.
fn collect_toplevel_anon_records(stmts: Array[Stmt], struct_sets: Array[(String, Array[String])]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, val) => match anon_record_inferred(val, struct_sets) {
        Some(sentinel) => Array::push(out, (name, sentinel)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn can_be_toplevel_constructor(name: String) -> Bool {
  name != "Int" && name != "Bool" && name != "String" && name != "Double" && name != "Float" && name != "Unit" && name != "ByteStream"
}

fn collect_toplevel_constructor_vars(stmts: Array[Stmt], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let mut out = collect_toplevel_anon_records(stmts, struct_sets)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, val) => {
        let inferred = if result_uses_constructor_witness(val, gens) {
          anon_or_constructor_infer(val, gens, struct_sets, out, fn_returns)
        } else {
          anon_or_infer(val, struct_sets, out, fn_returns)
        }
        match inferred {
          Some(inferred) => if can_be_toplevel_constructor(inferred) {
            out = extend_constructor_var_types(out, name, Some(inferred))
          } else {
            ()
          },
          None => ()
        }
      },
      SLetMut(name, _, val) => {
        let inferred = if result_uses_constructor_witness(val, gens) {
          anon_or_constructor_infer(val, gens, struct_sets, out, fn_returns)
        } else {
          anon_or_infer(val, struct_sets, out, fn_returns)
        }
        match inferred {
          Some(inferred) => if can_be_toplevel_constructor(inferred) {
            out = extend_constructor_var_types(out, name, Some(inferred))
          } else {
            ()
          },
          None => ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #635: lower the `let*`/`?` sentinels across a whole program. In-place,
/// idempotent (a second run finds no sentinels), and inert for programs that use
/// neither. Exported so the checker path can lower before type-checking.
/// `toplevel_vars` (#839) seeds every top-level statement's var_types with the
/// program's top-level anonymous-record bindings — see
/// `collect_toplevel_anon_records` — so `EFn`/`ELet`'s existing var_types
/// threading (which already covers a SINGLE statement's own nested scopes)
/// extends across top-level statement boundaries too.
fn railway_rw_stmt(s: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)], changed: Option[Array[Bool]]) -> Stmt {
  match s {
    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, toplevel_vars, fn_returns, changed)),
    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, toplevel_vars, fn_returns, changed)),
    STest(name, body) => STest(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns, changed)),
    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns, changed)),
    SExpr(e) => SExpr(railway_rw(e, struct_sets, toplevel_vars, fn_returns, changed)),
    SModule(exp, name, body) => SModule(exp, name, for inner in body {
      railway_rw_stmt(inner, struct_sets, fn_returns, toplevel_vars, changed)
    }),
    _ => s
  }
}

fn desugar_railway_binds_impl(stmts: Array[Stmt], changed: Option[Array[Bool]]) -> Unit {
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns, toplevel_vars, changed))
    i = i + 1
  }
}

export fn desugar_railway_binds_reporting_change(stmts: Array[Stmt]) -> Bool {
  let changed = [false]
  desugar_railway_binds_impl(stmts, Some(changed))
  Array::get(changed, 0)
}

export fn desugar_railway_binds(stmts: Array[Stmt]) -> Unit {
  desugar_railway_binds_impl(stmts, None)
}

/// After check has classified lowered `let*` via `__try_none`, rewrite that
/// origin marker back to the prelude `None` constructor so codegen does not
/// see an unresolved name. Must not run before check — the marker is what
/// distinguishes `let*` from a user-written `None => None` on the unlocated
/// `parse_program` path (every offset is -1).
fn erase_try_none_expr(expr: Expr, changed: Option[Array[Bool]]) -> Expr {
  match expr {
    EIdent(name, off) => {
      if name == "__try_none" {
        match changed {
          Some(cell) => {
            Array::set(cell, 0, true)
          },
          None => {
            ()
          }
        }
        EIdent("None", off)
      } else {
        expr
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ESpread(e) => ESpread(erase_try_none_expr(e, changed)),
    ETuple(elems) => ETuple(for e in elems {
      erase_try_none_expr(e, changed)
    }),
    EArray(elems) => EArray(for e in elems {
      erase_try_none_expr(e, changed)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, erase_try_none_expr(fval, changed)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, erase_try_none_expr(v, changed)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(erase_try_none_expr(c, changed), erase_try_none_expr(t, changed), erase_try_none_expr(e, changed)),
    ELet(name, val, body, soff) => ELet(name, erase_try_none_expr(val, changed), erase_try_none_expr(body, changed), soff),
    ELetRec(name, val, body) => ELetRec(name, erase_try_none_expr(val, changed), erase_try_none_expr(body, changed)),
    ELetMut(name, val, body, soff) => ELetMut(name, erase_try_none_expr(val, changed), erase_try_none_expr(body, changed), soff),
    EAssign(name, val, cont) => EAssign(name, erase_try_none_expr(val, changed), erase_try_none_expr(cont, changed)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, erase_try_none_expr(val, changed), erase_try_none_expr(cont, changed)),
    ESeq(a, b) => ESeq(erase_try_none_expr(a, changed), erase_try_none_expr(b, changed)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, erase_try_none_expr(b, changed)))
        i = i + 1
      }
      EMatch(erase_try_none_expr(scrut, changed), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, erase_try_none_expr(b, changed)))
        i = i + 1
      }
      EHandle(erase_try_none_expr(scrut, changed), out)
    },
    EWhile(c, b) => EWhile(erase_try_none_expr(c, changed), erase_try_none_expr(b, changed)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, erase_try_none_expr(init, changed))
    }, erase_try_none_expr(body, changed)),
    EForIn(name, idx, iter, body) => EForIn(name, idx, erase_try_none_expr(iter, changed), erase_try_none_expr(body, changed)),
    ECall(callee, args, off) => ECall(erase_try_none_expr(callee, changed), for a in args {
      erase_try_none_expr(a, changed)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, erase_try_none_expr(l, changed), erase_try_none_expr(r, changed)),
    EUnaryOp(op, e) => EUnaryOp(op, erase_try_none_expr(e, changed)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, erase_try_none_expr(body, changed)),
    EDot(obj, field, off, fdoff) => EDot(erase_try_none_expr(obj, changed), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, erase_try_none_expr(body, changed)),
    EReturn(e) => EReturn(erase_try_none_expr(e, changed)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(erase_try_none_expr(e, changed))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      erase_try_none_expr(e, changed)
    })
  }
}

fn erase_try_none_stmt(s: Stmt, changed: Option[Array[Bool]]) -> Stmt {
  match s {
    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, erase_try_none_expr(body, changed)),
    SLetMut(name, ty, e) => SLetMut(name, ty, erase_try_none_expr(e, changed)),
    STest(name, body) => STest(name, erase_try_none_expr(body, changed)),
    SBench(name, body) => SBench(name, erase_try_none_expr(body, changed)),
    SExpr(e) => SExpr(erase_try_none_expr(e, changed)),
    SModule(exp, name, body) => SModule(exp, name, for inner in body {
      erase_try_none_stmt(inner, changed)
    }),
    _ => s
  }
}

fn erase_railway_origin_markers_impl(stmts: Array[Stmt], changed: Option[Array[Bool]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, i, erase_try_none_stmt(Array::get(stmts, i), changed))
    i = i + 1
  }
}

export fn erase_railway_origin_markers_reporting_change(stmts: Array[Stmt]) -> Bool {
  let changed = [false]
  erase_railway_origin_markers_impl(stmts, Some(changed))
  Array::get(changed, 0)
}

export fn erase_railway_origin_markers(stmts: Array[Stmt]) -> Unit {
  erase_railway_origin_markers_impl(stmts, None)
}

// ---- #1392: string interpolation renders a derive(Show) value structurally ----
//
// `"\{v}"` lowers in the PARSER (build_interp_expr, parser_expr_primary.vibe)
// to `__to_string(v)`, i.e. before any type is known. `__to_string` is the
// ADR-0058 runtime heuristic -- "a tagged i64 that looks like a string
// pointer, else a decimal integer" -- so every aggregate reached it as a raw
// pointer rendered in decimal (`"\{P::{ x: 1, y: 2 }}"` measured as `208`),
// `derive(Show)` or not. docs/effect-evidence-passing.md 追記23 recorded that
// as needing "a new dispatch mechanism"; since then `derive(Show)` generates a
// concrete `T::to_string`, so for a value whose type this pass can resolve the
// dispatch is just a name.
//
// Scope of THIS slice (#1392 lists the rest): only a type that both resolves
// through `infer_arg_type_name` and already has a top-level `T::to_string` is
// rewritten, so nothing new has to be generated. `Option`/`Result`/tuple/
// `Array[T]` interpolation still renders as a pointer -- `show_for_typed`
// handles those shapes, but `Array[T]` needs its `__arr_to_string__<key>`
// helper emitted, which means driving that collection from interpolation
// sites too.
//
// The resolver is the same `infer_arg_type_name` the #1374 throw-kind write
// uses, with the same precision: an annotated parameter, a `let` whose value
// this pass can type, a struct literal, a constructor call. A pattern binding
// stays unresolved and keeps today's rendering -- no site gets WORSE.

/// The top-level binding `rewrite_stmt` is currently rewriting. Read only by
/// `interp_show_target`, to keep the interpolation rewrite from turning a
/// hand-written `T::to_string`'s own `"\{self}"` into an infinite self-call.
/// (The DERIVED `T::to_string` never spells that -- `show_for_typed` already
/// emits `n::to_string` for a known field type and `__to_string` only for
/// scalars -- so this guards user-written renderers.)
let dtd_show_self_fn = [""]

fn show_self_fn_set(name: String) -> Unit {
  Array::set(dtd_show_self_fn, 0, name)
}

/// #1398 review (Codex P1): the type names whose `T::to_string` THIS PASS
/// generated, recorded by `desugar_derives` as it emits them.
///
/// It exists to keep the SYNTHESIZED render at a throw site from calling a
/// user-written formatter. An interpolation `"\{v}"` is the user asking for
/// the call, so any `T::to_string` is fair game there. A throw site is not:
/// the call is inserted after type checking, runs on EVERY throw even when no
/// handler reads the message, and its effects are absent from the throwing
/// function's checked row. A formatter that itself throws would recurse during
/// formatting or silently replace the original exception; one that mutates or
/// performs would do so invisibly. Measured before this fix: a `Boom::to_string`
/// containing `println` printed on a `throw(Bang(1))` whose handler ignored the
/// payload entirely.
///
/// The derived renderers are structural, total, and effect-free by
/// construction, so restricting the eager path to them removes the hazard
/// rather than narrowing it.
///
/// Reset at each `desugar_trait_dicts` entry, BEFORE `desugar_derives` runs.
/// The second run of the pass over one program regenerates nothing (the
/// functions already exist) and leaves this empty, which is harmless: that run
/// also has `exn_kind_suppressed()` set, so it rewrites no throw site.
let dtd_derived_renderers: Array[String] = array_empty()

fn derived_renderers_reset() -> Unit {
  Array::truncate(dtd_derived_renderers, 0)
}

fn derived_renderer_record(tname: String) -> Unit {
  Array::push(dtd_derived_renderers, tname)
}

fn has_derived_renderer(tname: String) -> Bool {
  str_array_contains(dtd_derived_renderers, tname)
}

/// `__to_string(x)`: the single-argument shape string interpolation lowers to.
fn is_interp_to_string_call(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__to_string" && Array::length(args) == 1,
    _ => false
  }
}

// ---- #1392: the same rendering for an explicit `to_string(v)` ----
//
// prelude's `to_string[T: Show](x: T) -> String { __to_string(x) }`
// (builtin_traits.vibe) requires the bound and then calls the ADR-0058 runtime
// heuristic unconditionally -- there is nothing to dispatch on, so it rendered
// every aggregate as a pointer decimal exactly as bare interpolation used to.
// That left #1392's asymmetry: after slices 1 and 2, `"\{v}"` renders
// structurally but the spelled-out `to_string(v)` still does not.
//
// Its body IS `__to_string(x)`, so treating a call to it as that call is
// INLINING, not a semantic change -- which makes both slices apply to
// `to_string(v)` for free. What it is NOT is `Show` dispatch: inside a generic
// `f[T: Show](x: T) { to_string(x) }` the argument's type is a variable,
// nothing resolves, and the call stands as it does today. Real dispatch needs
// `Show` to become a method-bearing trait AND this pass to see impls across
// module boundaries (`collect_method_traits` reads only THIS program's stmts,
// and prelude is a separate module), which is #1392's own remaining slice.
//
// The shim is recognized BY ITS BODY, not by the name `to_string` and not by
// the `Show` bound, because neither survives to this point: the module merge
// renames imported bindings (import_alias_rewrite.vibe) and
// `strip_generic_type_params` erases every type parameter AND bound before
// codegen, so the merged prelude shim arrives here as a plain one-parameter
// `(x) -> { __to_string(x) }`.
//
// The body is also the whole soundness argument, which is why losing the bound
// costs nothing: a function whose entire body is `__to_string` of its own sole
// parameter computes exactly what `__to_string` computes, so replacing a call
// to it with that call is an identity. That holds for a user-written
// `fn dump(x) { __to_string(x) }` as much as for prelude's, and both should
// render the same -- #1392's point is that the pointer decimal was never the
// intent. A user `to_string` that does anything else has a different body, is
// never in this set, and keeps its call sites untouched.
let dtd_show_shims: Array[String] = array_empty()

/// `__to_string(<pname>)` and nothing else -- the shim's whole body.
fn is_bare_to_string_of(body: Expr, pname: String) -> Bool {
  match body {
    ECall(bc, ba, _) => if Array::length(ba) == 1 {
      match bc {
        EIdent(cn, _) => if cn == "__to_string" {
          match Array::get(ba, 0) {
            EIdent(an, _) => an == pname,
            _ => false
          }
        } else {
          false
        },
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// A one-parameter function whose body is just `__to_string` of that
/// parameter -- i.e. a pass-through whose call is interchangeable with the
/// call it wraps.
fn is_show_shim_value(v: Expr) -> Bool {
  match v {
    EFn(_, _, ps, _, _, body) => if Array::length(ps) == 1 {
      let (pn, _) = Array::get(ps, 0)
      is_bare_to_string_of(body, pn)
    } else {
      false
    },
    _ => false
  }
}

/// Every name this program binds LOCALLY, anywhere: `let`, `let mut`, `let rec`,
/// lambda parameters, `for` binders, loop parameters, and pattern binders in
/// `match`/`handle`/`let`-pattern arms.
///
/// #1443 review (Codex P2): the shim set is matched by NAME at a call site, and
/// a name is not a binding. A local that SHADOWS a top-level shim -- a
/// parameter `dump: (Int) -> String` where the module also defines
/// `dump(x) { __to_string(x) }` -- would have its calls rewritten to
/// `T::to_string(..)`, silently bypassing the function the caller passed in.
///
/// Discriminating properly means threading scope through `rewrite_expr`, which
/// has dozens of recursive call sites. This is the conservative alternative: a
/// shim whose name is bound locally ANYWHERE in the program is dropped from the
/// set entirely, so no call site of that name is touched. It costs the rewrite
/// in a program that happens to bind the name elsewhere (nothing renders worse
/// than before), and it cannot mis-target one. The merged prelude shim is
/// unaffected -- `import_alias_rewrite` gives it a suffixed name
/// (`to_string_exp_lib__vibe_prelude_builtin_traits_vibe`) that no local binds.
fn collect_pat_binders(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_pat_binders(Array::get(args, i), out)
        i = i + 1
      }
    },
    PTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_pat_binders(Array::get(elems, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      collect_pat_binders(a, out)
      collect_pat_binders(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binders(fp, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn collect_arm_binders(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, i)
    collect_pat_binders(p, out)
    i = i + 1
  }
}

/// Binder names introduced by THIS node. Recursion is `expr_children`, which
/// already covers every sub-expression of every form (including match/handle
/// arm bodies and loop initializers), so a new binding form added to `Expr`
/// shows up here as a missing case rather than as a silently skipped subtree.
fn collect_expr_binders(e: Expr, out: Array[String]) -> Unit {
  match e {
    ELet(n, _, _, _) => Array::push(out, n),
    ELetRec(n, _, _) => Array::push(out, n),
    ELetMut(n, _, _, _) => Array::push(out, n),
    EForIn(n, idx, _, _) => {
      Array::push(out, n)
      match idx {
        Some(iname) => Array::push(out, iname),
        None => ()
      }
    },
    ELoop(params, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        Array::push(out, pn)
        i = i + 1
      }
    },
    EFn(_, _, params, _, _, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        Array::push(out, pn)
        i = i + 1
      }
    },
    EMatch(_, arms) => collect_arm_binders(arms, out),
    EHandle(_, arms) => collect_arm_binders(arms, out),
    _ => ()
  }
  let kids = expr_children(e)
  let mut i = 0
  while i < Array::length(kids) {
    collect_expr_binders(Array::get(kids, i), out)
    i = i + 1
  }
}

fn collect_local_binder_names(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, value) => collect_expr_binders(value, out),
      SLetMut(_, _, value) => collect_expr_binders(value, out),
      SLetPat(p, value) => {
        collect_pat_binders(p, out)
        collect_expr_binders(value, out)
      },
      SExpr(e) => collect_expr_binders(e, out),
      STest(_, e) => collect_expr_binders(e, out),
      SBench(_, e) => collect_expr_binders(e, out),
      SExample(_, e) => collect_expr_binders(e, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Refreshed at each `desugar_trait_dicts` entry. Empty (so nothing is
/// rewritten) whenever the shim's own definition is not part of the program
/// being compiled -- the conservative direction.
fn collect_show_shims(stmts: Array[Stmt]) -> Unit {
  Array::truncate(dtd_show_shims, 0)
  let shadowed = collect_local_binder_names(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => if is_show_shim_value(value) && !str_array_contains(shadowed, name) {
        Array::push(dtd_show_shims, name)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}

fn is_show_shim_call(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => Array::length(args) == 1 && str_array_contains(dtd_show_shims, n),
    _ => false
  }
}

/// The `T::to_string` that should render `arg`, or "" when this pass cannot
/// resolve one and the `__to_string` call must stay as it is.
///
/// The `fn_exists` gate is what keeps this from naming a function that is not
/// there: `fn_returns` holds the program's top-level bindings AFTER
/// `desugar_derives` has appended the generated renderers, so a hit means
/// `derive(Show)`, `derive(Hash)`, or a hand-written `T::to_string`. Scalars
/// are excluded outright -- `__to_string` is already faithful for them, and
/// they are the shapes a `T::to_string` name could plausibly collide with.
fn interp_show_target(arg: Expr, derived_only: Bool, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
    Some(tn) => {
      let target = String::concat(tn, "::to_string")
      // `derived_only` (#1398 review, Codex P1) restricts this to renderers
      // THIS PASS generated -- see dtd_derived_renderers. Set at a throw site,
      // where the call is synthesized; clear at an interpolation, where the
      // user wrote it.
      // #2141: an enclosing binder's formal shadows a same-spelled declared
      // type -- its values are NOT that struct, so its renderer must not fire.
      if !is_scalar_type_name(tn) && !formal_in_scope(tn) && fn_exists(fn_returns, target) && target != Array::get(dtd_show_self_fn, 0) && (!derived_only || has_derived_renderer(tn)) {
        target
      } else {
        ""
      }
    },
    None => ""
  }
}

/// #1445: the type name of an interpolated value that is a DECLARED aggregate
/// with no `Show` renderer, or "" when this site is not that case.
///
/// Such a value used to fall through to the ADR-0058 pointer heuristic and print
/// a decimal -- `enum F { C(Int); D }` (no `derive(Show)`) interpolated as
/// `"\{f}"` printed `288`. The type is KNOWN here, so this is a missing
/// `derive(Show)`, not an unknowable shape: silently printing an address is the
/// worst of the three options (#1445 owner decision: make it an error).
///
/// Deliberately narrow -- it fires ONLY when this pass can name a declared
/// struct/enum (`struct_sets` carries both, #672). An unresolved head, a type
/// parameter, and every builtin shape keep the old behaviour, because at those
/// the pass genuinely cannot tell a missing renderer from a shape it simply
/// cannot see. The `fn_exists` check also keeps the self-recursion case quiet:
/// inside a generated `T::to_string`, `interp_show_target` suppresses the target
/// by name, and that is not a missing renderer.
fn interp_missing_show_type(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
    // #2141: an enclosing binder's formal shadows a same-spelled declared
    // type. Its values are erased, not renderless-struct-shaped -- keep the
    // old fallback rendering instead of throwing a false "missing Show".
    Some(tn) => if !is_scalar_type_name(tn) && !formal_in_scope(tn) && struct_set_has(struct_sets, tn) && !fn_exists(fn_returns, String::concat(tn, "::to_string")) {
      tn
    } else {
      ""
    },
    None => ""
  }
}

/// #2198: the synthesized `__to_string` call has no offset (the interp
/// snippet is re-lexed without offsets), so `[@off=]` cannot help -- but the
/// enclosing top-level binding's name is in `dtd_show_self_fn`, so the
/// message carries `[@fn=name]` and `locate_type_error` recovers the
/// `fn name` / `let name` token in both check lanes. The compile lane
/// strips unresolved side markers (`strip_side_marker` via
/// `emit_compile_diag`), so nothing leaks there; wiring a real position
/// through the compile path stays #1514's job. An interpolation inside a
/// `test { }` block has no self_fn and stays positionless. Known accepted
/// hazard (same as every `[@fn=]` use, #1941/#1596): a dep-file culprit
/// whose binder name also exists in the entry text anchors on the entry's
/// spelling.
fn interp_missing_show_msg(tn: String) -> String {
  let base = String::concat("cannot interpolate a value of type `", String::concat(tn, String::concat("`: it has no Show renderer -- add `derive(Show)` to `", String::concat(tn, String::concat("`, or define `fn ", String::concat(tn, "::to_string(v) -> String` (#1445)"))))))
  let self_fn = Array::get(dtd_show_self_fn, 0)
  if String::length(self_fn) > 0 {
    String::concat(base, String::concat(" [@fn=", String::concat(self_fn, "]")))
  } else {
    base
  }
}

// ---- #1392: structural interpolation ----
// Literals render from syntax; names and annotated function calls render from
// the recursive shape environment. Option/Result use their inferred head.
// Nested elements re-enter `rewrite_expr` on a smaller `__to_string` call.

/// A fresh binder for the structural expansions below. Lexical scoping alone
/// would make one fixed name correct, but a distinct name per site keeps
/// nesting legible in dumped IR -- same rationale as
/// `exn_kind_fresh_payload_name`.
let dtd_show_tmp = [0]

fn show_tmp_name() -> String {
  let n = Array::get(dtd_show_tmp, 0)
  Array::set(dtd_show_tmp, 0, n + 1)
  String::concat("__show_v", __to_string(n))
}

/// Render one sub-expression by re-entering the interpolation rewrite on a
/// synthetic `__to_string(sub)`, so a nested wrapper or a derive(Show) value
/// inside one is rendered too.
fn interp_render_sub(sub: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  rewrite_expr(ECall(EIdent("__to_string", -1), Array::slice([sub], 0, 1), -1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
}

/// `open_s ++ e0 ++ sep ++ e1 ++ .. ++ close_s`, each element rendered.
/// (`open` is a reserved word in vibe, hence the suffixed names.)
fn interp_join(items: Array[Expr], open_s: String, sep: String, close_s: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let mut acc = EString(open_s)
  let mut i = 0
  while i < Array::length(items) {
    let piece = interp_render_sub(Array::get(items, i), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    acc = if i == 0 {
      concat2(acc, piece)
    } else {
      concat2(concat2(acc, EString(sep)), piece)
    }
    i = i + 1
  }
  concat2(acc, EString(close_s))
}

/// #1445: render a variable whose binding site recorded a TUPLE shape
/// (`tuple_shape_key`). The expansion destructures the variable rather than
/// re-evaluating any element expression -- the tuple is already built, and
/// the binding's RHS may not even be in scope here.
///
///   let t = (1, p)   ->   match t { (a, b) => "(" ++ show(a) ++ ", " ++ show(b) ++ ")" }
///
/// Each binder is rendered through `interp_render_sub`, with its recorded
/// element type pushed into `var_types` first -- that is what lets a
/// `derive(Show)` struct inside the tuple render structurally instead of
/// falling to the pointer heuristic. An element whose type was not inferable
/// at the binding site carries an empty entry and simply renders through the
/// ordinary `__to_string`, exactly as it does today.
fn interp_expand_var_tuple(name: String, elem_types: Array[String], derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let n = Array::length(elem_types)
  let pats = array_empty()
  let binders = empty_str_array()
  let mut i = 0
  while i < n {
    let v = show_tmp_name()
    Array::push(pats, PBind(v))
    Array::push(binders, v)
    i = i + 1
  }
  let mut acc = EString("(")
  let mut k = 0
  while k < n {
    let v = Array::get(binders, k)
    let et = Array::get(elem_types, k)
    let vt = if String::length(et) == 0 {
      var_types
    } else {
      extend_var_types(var_types, v, Some(et))
    }
    let piece = interp_render_sub(EIdent(v, -1), derived_only, gens, traits, struct_sets, dict_binds, vt, fn_returns)
    acc = if k == 0 {
      concat2(acc, piece)
    } else {
      concat2(concat2(acc, EString(", ")), piece)
    }
    k = k + 1
  }
  EMatch(EIdent(name, -1), Array::slice([
    (PTuple(pats), concat2(acc, EString(")")))
  ], 0, 1))
}

/// #1445: render a variable known to hold an `Array[T]` (its element type was
/// recorded under `array_elem_key` by `array_elem_bind` or `seed_var_types`).
///
/// The loop is emitted INLINE rather than as a call to a monomorphic
/// `__arr_to_string__<key>` helper. `gen_arr_to_string_fn` builds that helper
/// for `derive`d fields, but emitting one from here would mean driving helper
/// COLLECTION from interpolation sites in `desugar_derives` -- a second pass
/// has to have already decided which helpers exist by the time this one runs.
/// The loop body is the same shape as that helper's, so nothing is duplicated
/// conceptually; it is just placed where the type is known.
///
/// The element is rendered by re-entering the rewrite on `Array::get(name, i)`
/// -- `infer_arg_type_name` already resolves that shape through
/// `array_elem_type_of`, so a `derive(Show)` element renders structurally
/// without any extra plumbing here.
fn interp_expand_var_array(name: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let iv = String::concat(show_tmp_name(), "_i")
  let av = String::concat(show_tmp_name(), "_acc")
  let elem_piece = interp_render_sub(ECall(EIdent("Array::get", -1), Array::slice([
    EIdent(name, -1),
    EIdent(iv, -1)
  ], 0, 2), -1), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0)), EString(""), EString(", "))
  let append = concat2(concat2(EIdent(av, -1), sep), elem_piece)
  let body = ESeq(EAssign(av, append, EUnit), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1)), EUnit))
  let len_call = ECall(EIdent("Array::length", -1), Array::slice([
    EIdent(name, -1)
  ], 0, 1), -1)
  let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call), body)
  ELetMut(iv, EInt(0), ELetMut(av, EString("["), ESeq(loop_e, concat2(EIdent(av, -1), EString("]"))), -1), -1)
}

/// #1445 (#139): render `sub` given its recursive SHAPE.
///
/// The tuple case destructures with a `match` so no element expression is
/// re-evaluated; the array case binds each element to a name inside the loop,
/// which is what lets a NESTED composite element recurse (an element reached
/// as `Array::get(a, i)` has no name for `var_types` to key on).
fn interp_render_shaped(sub: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if shape_is_composite(sh) {
    interp_expand_shape(sub, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  } else if String::length(sh) == 0 {
    interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  } else {
    match sub {
      EIdent(v, _) => interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, extend_var_types(var_types, v, Some(sh)), fn_returns),
      _ => interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  }
}

/// #1445 (#139): the tuple / array expansion for a composite shape. Supersedes
/// interp_expand_var_tuple / interp_expand_var_array for anything that nests;
/// those two stay for the shapes recorded by the older sentinels alone.
fn interp_expand_shape(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if String::starts_with(sh, "(") {
    let parts = shape_split(shape_inner(sh))
    let n = Array::length(parts)
    let pats = array_empty()
    let binders = empty_str_array()
    let mut i = 0
    while i < n {
      let v = show_tmp_name()
      Array::push(pats, PBind(v))
      Array::push(binders, v)
      i = i + 1
    }
    let mut acc = EString("(")
    let mut k = 0
    while k < n {
      let piece = interp_render_shaped(EIdent(Array::get(binders, k), -1), Array::get(parts, k), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      acc = if k == 0 {
        concat2(acc, piece)
      } else {
        concat2(concat2(acc, EString(", ")), piece)
      }
      k = k + 1
    }
    EMatch(subject, Array::slice([(PTuple(pats), concat2(acc, EString(")")))], 0, 1))
  } else {
    // Array. The subject is read twice (length + per-index get), so it must be
    // a name; anything else is bound once first.
    let elem_sh = shape_inner(sh)
    let nm = match subject {
      EIdent(n, _) => n,
      _ => show_tmp_name()
    }
    let iv = String::concat(show_tmp_name(), "_i")
    let av = String::concat(show_tmp_name(), "_acc")
    let ev = show_tmp_name()
    let elem_piece = ELet(ev, ECall(EIdent("Array::get", -1), Array::slice([
      EIdent(nm, -1),
      EIdent(iv, -1)
    ], 0, 2), -1), interp_render_shaped(EIdent(ev, -1), elem_sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns), -1)
    let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0)), EString(""), EString(", "))
    let append = concat2(concat2(EIdent(av, -1), sep), elem_piece)
    let body = ESeq(EAssign(av, append, EUnit), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1)), EUnit))
    let len_call = ECall(EIdent("Array::length", -1), Array::slice([
      EIdent(nm, -1)
    ], 0, 1), -1)
    let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call), body)
    let inner = ELetMut(iv, EInt(0), ELetMut(av, EString("["), ESeq(loop_e, concat2(EIdent(av, -1), EString("]"))), -1), -1)
    match subject {
      EIdent(_, _) => inner,
      _ => ELet(nm, subject, inner, -1)
    }
  }
}

/// `ctor_name(<rendered payload>)`.
fn interp_wrap1(ctor: String, payload: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  concat2(EString(String::concat(ctor, "(")), concat2(interp_render_sub(payload, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns), EString(")")))
}

/// The head-only fallback: a value this pass knows is an `Option`/`Result` but
/// whose payload type it does not know. The match is emitted over the REWRITTEN
/// argument (evaluated once, as the scrutinee), and the payload is rendered by
/// the ordinary path.
/// #1445 残件: the payload binder of a SYNTHESIZED `Option`/`Result` arm.
///
/// `interp_expand_by_head` builds `match x { Some(v) => .. }` itself, so `v` is
/// a fresh temp that appears in no binding site and had no entry in
/// `var_types` -- the payload fell to the ADR-0058 pointer heuristic even
/// though the payload TYPE was recorded against `x` (`let op = Some(p)` ->
/// `ctor_payload_bind`, or `o: Option[P]` -> `seed_var_types`). Measured:
/// `let op = Some(p); "\{op}"` printed `Some(260)` while the inline
/// `"\{Some(p)}"` printed `Some(P { x: 1 })`.
///
/// A USER-written `match op { Some(v) => "\{v}" }` already resolved, through
/// `arm_binder_var_types`. This is the same shape -- a `PCtor` arm over a named
/// scrutinee -- so it reuses that function verbatim rather than restating the
/// lookup, and inherits its composite-payload handling for free.
fn interp_ctor_arm_var_types(arg: Expr, ctor: String, binder: String, var_types: Array[(String, String)]) -> Array[(String, String)] {
  arm_binder_var_types(arg, PCtor(ctor, Array::slice([PBind(binder)], 0, 1)), var_types)
}

fn interp_expand_by_head(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  if head == "Option" {
    let v = show_tmp_name()
    let vt_some = interp_ctor_arm_var_types(arg, "Some", v, var_types)
    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([
      (PCtor("Some", Array::slice([PBind(v)], 0, 1)), interp_wrap1("Some", EIdent(v, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_some, fn_returns)),
      (PCtor("None", array_empty()), EString("None"))
    ], 0, 2)))
  } else if head == "Result" {
    let ov = show_tmp_name()
    let ev = show_tmp_name()
    let vt_ok = interp_ctor_arm_var_types(arg, "Ok", ov, var_types)
    let vt_err = interp_ctor_arm_var_types(arg, "Err", ev, var_types)
    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([
      (PCtor("Ok", Array::slice([PBind(ov)], 0, 1)), interp_wrap1("Ok", EIdent(ov, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_ok, fn_returns)),
      (PCtor("Err", Array::slice([PBind(ev)], 0, 1)), interp_wrap1("Err", EIdent(ev, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_err, fn_returns))
    ], 0, 2)))
  } else {
    None
  }
}

/// #1527: is the interpolated argument a Bool this pass can PROVE from
/// recorded/declared types? Deliberately excludes the Bool LITERAL (the
/// codegen classifiers already format it, and skipping it keeps the common
/// case's lowering untouched); everything else asks `infer_arg_type_name`,
/// which covers calls to `-> Bool` functions (fn_returns), names bound to
/// them (var_types), and Bool-typed struct-field projections.
fn interp_arg_is_bool(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool {
  match arg {
    EBool(_) => false,
    _ => match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
      Some(t) => t == "Bool",
      None => false
    }
  }
}

/// The structural rendering for an interpolated wrapper value, or None when
/// this pass has no shape to work from and the `__to_string` call must stand.
fn interp_expand(arg: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  let head = match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
    Some(h) => h,
    None => ""
  }
  let sh = interp_shape(infer_shape(arg, struct_sets, var_types, fn_returns))
  if String::length(sh) > 0 {
    Some(interp_expand_shape(arg, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
  } else {
    match find_dict_for_method(dict_binds, head, "to_string") {
      Some(dict_pname) => Some(ECall(EDot(EIdent(dict_pname, -1), "to_string", -1, -1), [
        arg
      ], -1)),
      None => interp_expand_local(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  }
}

fn interp_expand_local(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  match arg {
    ETuple(items) => Some(interp_join(items, "(", ", ", ")", derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EArray(items) => Some(interp_join(items, "[", ", ", "]", derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EIdent(n, _) => if n == "None" && head == "Option" {
      Some(EString("None"))
    } else {
      // #1445: a tuple or array reached through a NAME. The shape came from
      // the binding site (tuple_shape_bind / array_elem_bind) or from a
      // parameter annotation (seed_var_types), which is what the head name
      // alone could never supply.
      // #139: the recursive shape first -- it is the only one that can carry
      // a nested tuple/array. The two older sentinels still answer for a
      // binding shape_bind declined to record (a PARAMETER annotation, which
      // seeds them directly and never goes through bind_shapes).
      match lookup_var_type(var_types, shape_key(n)) {
        // A RECORDED shape is the binding site's answer, empty or not: an
        // empty one means the innermost binding of `n` is not a tuple/array,
        // so the older sentinels (which a shadowing rebind does not clear)
        // must NOT be consulted. Only a name with no record at all -- a
        // parameter, seeded directly by seed_var_types -- falls through.
        Some(sh) => if shape_is_composite(sh) {
          Some(interp_expand_shape(EIdent(n, -1), sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
        } else {
          interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        },
        None => match lookup_var_type(var_types, tuple_shape_key(n)) {
          Some(sentinel) => Some(interp_expand_var_tuple(n, tuple_shape_parts(sentinel), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
          None => match array_elem_type_of(var_types, n) {
            Some(_) => Some(interp_expand_var_array(n, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
            None => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          }
        }
      }
    },
    ECall(callee, cargs, _) => match callee {
      EIdent(cn, _) => if Array::length(cargs) == 1 && ((head == "Option" && cn == "Some") || (head == "Result" && (cn == "Ok" || cn == "Err"))) {
        Some(interp_wrap1(cn, Array::get(cargs, 0), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
      } else {
        interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      },
      _ => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    },
    _ => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  }
}

/// Whether the interpolation rewrite produced a replacement. Split from
/// `interp_take_repl` because the decision is made in an else-if chain, which
/// cannot bind the payload.
fn interp_has_repl(r: Option[Expr]) -> Bool {
  match r {
    Some(_) => true,
    None => false
  }
}

/// The replacement, given `interp_has_repl` already said there is one.
fn interp_take_repl(r: Option[Expr]) -> Expr {
  match r {
    Some(e) => e,
    None => EUnit
  }
}

/// #1946 leftover: a two-argument `assert_eq` call. The builtin is still
/// what the checker sees (effect-free); this pass rewrites it after check so
/// a failure can print both sides without adding Stderr/Exception to the
/// source row.
/// A program that DEFINES `assert_eq` itself gets its own function, not this
/// lowering. Measured before the guard: `fn assert_eq(a: Int, b: Int) -> Int {
/// a + b }` plus `assert_eq(1, 2)` compiled clean and trapped with `assert_eq
/// failed` instead of returning 3, with no diagnostic naming the conflict
/// anywhere (#2283).
fn is_assert_eq_call(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "assert_eq" && Array::length(args) == 2 && !user_assert_eq_bound(),
    _ => false
  }
}

/// Pass state, reset at every `desugar_trait_dicts` entry like the exn-kind
/// cell above: whether THIS program binds `assert_eq` itself.
///
/// For an ordinary source array this is program-wide. The FS merge inserts an
/// `SReExportSourceBoundary` marker before each source unit; the final rewrite
/// loop resets the cached answer and active range at every marker, so a
/// dependency's blocker cannot suppress an unrelated entry builtin (#2287).
///
/// COMPUTED LAZILY (#2285). The scan now descends into every expression, and
/// paying for a whole-program AST walk on every compile is not free -- an
/// earlier round of this work measured a 1.1% self-compile heap regression
/// from one extra traversal and blew the KPI ceiling. Nothing asks this
/// question unless the program actually spells `assert_eq(a, b)`, because
/// `is_assert_eq_call` tests the name and the arity first, so a program with
/// no such call never runs the walk at all -- which is every file in the
/// compiler's own closure.
///
/// Slot 0 is the answer: -1 not computed yet, 0 no, 1 yes.
let dtd_user_assert_eq = [-1]

/// The program to answer that question from, held until something asks. One
/// element or none; `Array::truncate` on reset is what makes a torn run
/// (a throw mid-rewrite) unable to leave a previous program behind.
let dtd_user_assert_eq_program: Array[Array[Stmt]] = array_empty()

/// Half-open source-unit range within the retained program. `end < 0` means
/// the entire array (the ordinary non-merged path).
let dtd_user_assert_eq_range = [0, -1]

/// Whether the current FS source boundary carries an aliased re-export named
/// `assert_eq`. Kept separate so the expensive expression walk stays lazy.
let dtd_user_assert_eq_alias_blocker = [0]

fn user_assert_eq_reset(stmts: Array[Stmt]) -> Unit {
  Array::set(dtd_user_assert_eq, 0, -1)
  Array::set(dtd_user_assert_eq_range, 0, 0)
  Array::set(dtd_user_assert_eq_range, 1, -1)
  Array::set(dtd_user_assert_eq_alias_blocker, 0, 0)
  Array::truncate(dtd_user_assert_eq_program, 0)
  Array::push(dtd_user_assert_eq_program, stmts)
}

fn user_assert_eq_bound() -> Bool {
  let cached = Array::get(dtd_user_assert_eq, 0)
  if cached >= 0 {
    cached == 1
  } else if Array::length(dtd_user_assert_eq_program) == 0 {
    // Nothing handed us a program. Answer "not bound", which is the shipped
    // lowering -- the same thing a caller that never reset would have got.
    false
  } else {
    let program = Array::get(dtd_user_assert_eq_program, 0)
    let range_end = Array::get(dtd_user_assert_eq_range, 1)
    let answer = Array::get(dtd_user_assert_eq_alias_blocker, 0) == 1 || if range_end < 0 {
      stmts_define_assert_eq(program)
    } else {
      stmts_range_define_assert_eq(program, Array::get(dtd_user_assert_eq_range, 0), range_end)
    }
    Array::set(dtd_user_assert_eq, 0, if answer {
      1
    } else {
      0
    })
    answer
  }
}

/// Whether this program BINDS `assert_eq` anywhere -- a top-level definition,
/// an import that lands under that name, or a local binder at any depth: a
/// `let`, a `for` binder, a function or lambda parameter, a `match` or
/// `handle` pattern.
///
/// The local half is #2285, and it could not be turned on until codegen could
/// honor a local. Standing the lowering down is only half the answer: codegen
/// has its own `assert_eq` arm, and while that arm tested `fn_idx_in_list`
/// alone it claimed the call regardless, so suppressing here only traded the
/// builtin's message for a bare `unreachable`. Measured on
/// `match make_cmp() { assert_eq => assert_eq(1, 2) }`: the builtin assertion
/// before, a trap with no message after. Both halves now hold -- the three
/// assert arms in `compile_call.vibe` test `!prefer_bound_call`, and
/// `assert_eq`/`assert_true` are registered in `is_inlined_scalar_builtin` so
/// a free use inside a lambda is no longer recorded as the #1095 capture
/// artifact that made `local_idx_hint` unreadable.
///
/// UNSCOPED within one source unit: one binder anywhere in that unit stands
/// the lowering down even for call sites the binder does not reach. A scoped
/// answer would have to thread a binder set through `rewrite_expr`, which
/// carries nine parameters already. `SReExportSourceBoundary` still separates
/// FS-merged units, so this conservative answer does not leak across modules.
fn stmts_define_assert_eq(stmts: Array[Stmt]) -> Bool {
  stmts_range_define_assert_eq(stmts, 0, Array::length(stmts))
}

fn import_binds_assert_eq(items: Array[ImportItem]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, i)
    let local = match item.alias {
      Some(a) => a,
      None => item.name
    }
    if local == "assert_eq" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// A pattern that binds the bare name. `PBind` is the binder; every other
/// arm is a container to look through. A `PCtor` name is a constructor, not a
/// binder, so only its sub-patterns are asked.
fn pat_binds_assert_eq(p: Pat) -> Bool {
  match p {
    PBind(name) => name == "assert_eq",
    PCtor(_, subs) => pats_bind_assert_eq(subs),
    PTuple(subs) => pats_bind_assert_eq(subs),
    POr(a, b) => pat_binds_assert_eq(a) || pat_binds_assert_eq(b),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) && !found {
        let (_, sub) = Array::get(fields, i)
        if pat_binds_assert_eq(sub) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn pats_bind_assert_eq(ps: Array[Pat]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ps) && !found {
    if pat_binds_assert_eq(Array::get(ps, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Every binding form an expression can carry, then the children.
///
/// The recursion goes through `expr_children` on purpose: it is the AST edge's
/// exhaustive structural traversal, so a new `Expr` variant fails to compile
/// there rather than silently going unvisited here. Only the arms that BIND
/// are spelled out below; everything else falls through to the walk.
fn expr_binds_assert_eq(e: Expr) -> Bool {
  let here = match e {
    ELet(name, _, _, _) => name == "assert_eq",
    ELetRec(name, _, _) => name == "assert_eq",
    ELetMut(name, _, _, _) => name == "assert_eq",
    EForIn(value_name, key_name, _, _) => value_name == "assert_eq" || match key_name {
      Some(k) => k == "assert_eq",
      None => false
    },
    EFn(_, _, params, _, _, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pname, _) = Array::get(params, i)
        if pname == "assert_eq" {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELoop(params, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pname, _) = Array::get(params, i)
        if pname == "assert_eq" {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMatch(_, arms) => arms_bind_assert_eq(arms),
    EHandle(_, arms) => arms_bind_assert_eq(arms),
    _ => false
  }
  if here {
    true
  } else {
    let kids = expr_children(e)
    let mut i = 0
    let mut found = false
    while i < Array::length(kids) && !found {
      if expr_binds_assert_eq(Array::get(kids, i)) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

fn arms_bind_assert_eq(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, _) = Array::get(arms, i)
    if pat_binds_assert_eq(pat) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn plain_reexport_binds(items: Array[ImportItem], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, i)
    if item.name == wanted && item.alias == None {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn stmt_binds_assert_eq(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, name, _, value) => name == "assert_eq" || expr_binds_assert_eq(value),
    SLetMut(name, _, value) => name == "assert_eq" || expr_binds_assert_eq(value),
    SLetPat(pat, value) => pat_binds_assert_eq(pat) || expr_binds_assert_eq(value),
    SExpr(e) => expr_binds_assert_eq(e),
    STest(_, e) => expr_binds_assert_eq(e),
    SBench(_, e) => expr_binds_assert_eq(e),
    SExample(_, e) => expr_binds_assert_eq(e),
    SFnDecl(_, name, e, _, _) => name == "assert_eq" || expr_binds_assert_eq(e),
    // NO `SModule` recursion. A member would declare `M::assert_eq`, not the
    // bare prelude name; see the #2296 review measurement above.
    SImport(_, items) => import_binds_assert_eq(items),
    // Direct/single-source checking still sees the original re-export. The FS
    // merge carries re-export locals separately in SReExportSourceBoundary (#2287).
    SReExport(_, items) => import_binds_assert_eq(items),
    _ => false
  }
}

fn stmts_range_define_assert_eq(stmts: Array[Stmt], start: Int, end: Int) -> Bool {
  let mut i = start
  let mut found = false
  while !found && i < end {
    found = stmt_binds_assert_eq(Array::get(stmts, i))
    i = i + 1
  }
  found
}

fn reexport_blockers_bind_assert_eq(names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = Array::get(names, i) == "assert_eq"
    i = i + 1
  }
  found
}

fn merged_source_range_end(stmts: Array[Stmt], start: Int) -> Int {
  let mut end = start
  while end < Array::length(stmts) && !(Array::get(stmts, end) is SReExportSourceBoundary(_, _)) {
    end = end + 1
  }
  end
}

fn user_assert_eq_set_merged_source(stmts: Array[Stmt], start: Int, names: Array[String]) -> Unit {
  Array::set(dtd_user_assert_eq, 0, -1)
  Array::set(dtd_user_assert_eq_range, 0, start)
  Array::set(dtd_user_assert_eq_range, 1, merged_source_range_end(stmts, start))
  Array::set(dtd_user_assert_eq_alias_blocker, 0, if reexport_blockers_bind_assert_eq(names) {
    1
  } else {
    0
  })
}

fn assert_eq_concat(a: Expr, b: Expr) -> Expr {
  ECall(EIdent("String::concat", -1), [a, b], -1)
}

/// Render one `assert_eq` operand. Reuses the throw-site renderer
/// (`derived_only`) so a missing Show becomes `<unprintable>` instead of a
/// pointer decimal or a compile error.
fn assert_eq_render(arg: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let target = interp_show_target(arg, true, struct_sets, var_types, fn_returns)
  if target != "" {
    ECall(EIdent(target, -1), Array::slice([arg], 0, 1), -1)
  } else {
    let expanded = interp_expand(arg, true, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    if interp_has_repl(expanded) {
      interp_take_repl(expanded)
    } else {
      match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
        Some(tn) => if is_scalar_type_name(tn) {
          ECall(EIdent("__to_string", -1), Array::slice([arg], 0, 1), -1)
        } else {
          EString("<unprintable>")
        },
        None => {
          let as_scalar = match arg {
            EInt(_) => true,
            EBool(_) => true,
            EString(_) => true,
            EFloat(_) => true,
            _ => false
          }
          if as_scalar {
            ECall(EIdent("__to_string", -1), Array::slice([arg], 0, 1), -1)
          } else {
            EString("<unprintable>")
          }
        }
      }
    }
  }
}

fn lower_assert_eq(args: Array[Expr], call_off: Int, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let a2 = rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let b2 = rewrite_expr(Array::get(args, 1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let an = dinsp_fresh_name("__assert_eq_actual", a2, b2)
  let en = dinsp_fresh_name("__assert_eq_expected", a2, b2)
  let vars1 = bind_shapes(extend_var_types(var_types, an, infer_arg_type_name(a2, struct_sets, var_types, fn_returns)), an, a2, struct_sets, fn_returns)
  let vars2 = bind_shapes(extend_var_types(vars1, en, infer_arg_type_name(b2, struct_sets, vars1, fn_returns)), en, b2, struct_sets, fn_returns)
  let actual = EIdent(an, -1)
  let expected = EIdent(en, -1)
  let actual_s = assert_eq_render(actual, gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  let expected_s = assert_eq_render(expected, gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  // The trailing `assert failed: aborting` line closes the diagnostic and
  // says what happens next -- the trap that follows is this assert's own
  // deliberate abort, not a second failure. It doubles as the marker the
  // test condensers (scripts/vibe_test.sh / runtime/vibe) key on to
  // suppress the trap echo (#2202, Codex rounds 2-3 on #2213): rendered
  // values may contain newlines and a test's own output may imitate the
  // block, so the block text alone cannot identify the abort. The
  // condensers hide the line; in a plain `vibe run` it reads as ordinary
  // diagnostic prose rather than harness protocol.
  // #2202: bake the call's source offset so `vibe test` can print a line
  // number. The condenser maps `at off=N` using the source file.
  let msg = assert_eq_concat(EString(String::concat("assert_eq failed\n  at off=", String::concat(__to_string(call_off), "\n  expected: "))), assert_eq_concat(expected_s, assert_eq_concat(EString("\n  actual:   "), assert_eq_concat(actual_s, EString("\nassert failed: aborting")))))
  // stdout, not Stderr::write_stream: the gc lane only reserves host
  // imports when the source already used one, and flipping that on a
  // SIMD-only file shifts every generated-body index (gc-gate
  // simd_skip_ws_test). `vibe test` now keeps stdout on FAIL so the
  // diagnostic still reaches vt_fail_detail.
  //
  // #2107: `println` here means `assert_eq` REQUIRES `Stdout` in the
  // function containing it -- this expansion runs before the checker, so the
  // row lands on the caller. That is the honest reading (the branch really
  // does write to the console) and it is the same rule `inspect` follows.
  // In practice it costs nothing: a `test` / `bench` block is granted the
  // standard test effect set, which includes Stdout, and that is where
  // assertions live. A plain function asserting outside a test block declares
  // `with Stdout`, as `fixtures/gc_backend_smoke_test.vibe` now does.
  //
  // The internal printer `print_str` looks like the way to avoid that and is
  // not: its wasm signature takes two params (the string as a pair), it is
  // `checker_visible=false`, and codegen only ever emits it with that ABI
  // from a lowering -- a vibe-level call to it is `unknown name` at the
  // checker and a broken module past it. Introducing a rowless vibe-callable
  // printer just to keep this branch quiet would re-open the exact escape
  // #2107 closed, one dunder away.
  let fail = ESeq(ECall(EIdent("println", -1), [msg], -1), ECall(EIdent("assert_true", -1), [
    EBool(false)
  ], -1))
  let cmp = rewrite_expr(EBinOp("==", actual, expected), gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  ELet(an, a2, ELet(en, b2, EIf(cmp, EUnit, fail), -1), -1)
}

/// The core rewriter. `dict_binds` is non-empty only inside a transformed
/// generic's body (so `T::method` resolves to a dict field); call-site dict
/// threading applies everywhere a transformed generic is called. `var_types`
/// tracks locals/params whose concrete type is known, for call-site dict
/// synthesis when the receiver is a variable.
fn rewrite_expr(expr: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match expr {
    EIdent(name, off) => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        match find_dict_for_method(dict_binds, head, member) {
          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1, -1),
          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {
            Some(m) => EIdent(m, off),
            None => expr
          }
        }
      },
      None => expr
    },
    ECall(callee, args, off) => {
      // #635: type-directed lowering of the railway sentinels emitted by the
      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type
      // info from the parser; here `infer_arg_type_name(val)` picks Option vs
      // Result (default Result when undeterminable — today's behavior). A user
      // function literally named `__try_bind`/`__try_op` with the wrong shape
      // (handled by `try_sentinel` returning None) takes the generic path.
      let try_kind = try_sentinel(callee, args)
      // #1392: the interpolation replacement, computed once here rather than
      // inside the else-if chain below so the resolvers run at most once per
      // call site. Slice 1 (the argument's type names a `T::to_string`) wins
      // over slice 2 (the argument is, or is headed by, a wrapper).
      let interp_repl = if is_interp_to_string_call(callee, args) || is_show_shim_call(callee, args) {
        let show_target = interp_show_target(Array::get(args, 0), false, struct_sets, var_types, fn_returns)
        if show_target != "" {
          Some(ECall(EIdent(show_target, -1), Array::slice([
            rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          ], 0, 1), off))
        } else if interp_arg_is_bool(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          // #1527: a Bool that reaches `"\{...}"` through a CALL or a NAME
          // whose recorded type is Bool printed `1`/`0` — Bool and Int share
          // the tagged-int representation, and codegen's boolish classifiers
          // (cc_expr_is_boolish and its per-backend twins) are syntactic:
          // they know literals, comparisons and bool-returning BUILTINS, but
          // not a user fn's declared `-> Bool`. This pass has that type
          // (fn_returns / var_types / struct field heads), so rewrite the
          // rendering here, once, for every backend: the `__to_string(arg)`
          // becomes `if arg { "true" } else { "false" }`. A Bool LITERAL is
          // excluded — every classifier already answers it, and skipping it
          // keeps the common case's lowering untouched.
          Some(EIf(rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns), EString("true"), EString("false")))
        } else {
          let expanded = interp_expand(Array::get(args, 0), false, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          // #1445: nothing rendered it structurally AND the type is a declared
          // aggregate with no renderer -- that is a missing `derive(Show)`, and
          // falling through here would print a pointer decimal.
          if interp_has_repl(expanded) {
            expanded
          } else {
            let missing = interp_missing_show_type(Array::get(args, 0), struct_sets, var_types, fn_returns)
            if missing == "" {
              expanded
            } else {
              throw(interp_missing_show_msg(missing))
            }
          }
        }
      } else {
        None
      }
      if try_kind == 0 {
        // __try_bind(val, (name) -> rest)
        let val = Array::get(args, 0)
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, 0)
            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))
            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)
            lower_try_bind(rwval, name, rwrest)
          },
          _ => EUnit
        }
      } else if try_kind == 1 {
        // __try_op(val)
        let val = Array::get(args, 0)
        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        lower_try_op(rwval)
      } else if interp_has_repl(interp_repl) {
        // #1392: the interpolation of a value this pass can render.
        interp_take_repl(interp_repl)
      } else if is_assert_eq_call(callee, args) {
        lower_assert_eq(args, off, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      } else if !exn_kind_suppressed() && is_exception_kind_read(callee, args) {
        // #1374: `__exn_kind()` is a checker-only intrinsic (typed
        // `() -> String` in checker/builtins_misc.vibe, no wasm body) -- it
        // exists so a handler arm can spell the read, and it is gone by the
        // time either backend sees the program.
        exn_kind_mark_used()
        exn_kind_read_expr()
      } else if !exn_kind_suppressed() && is_exception_message_read(callee, args) {
        // #1392 slice 3: the companion read. Same checker-only intrinsic shape
        // as `__exn_kind()`.
        exn_kind_mark_used()
        exn_msg_read_expr()
      } else if !exn_kind_suppressed() && is_perform_throw_shape(callee, args) {
        // #1374: record the payload's static type name for the handler. The
        // write is UNCONDITIONAL, including the empty name for a payload this
        // pass cannot resolve -- leaving the slot alone there would let an
        // earlier throw's kind be read as this one's.
        //
        // The resolver is codegen's own `infer_arg_type_name`, not the
        // checker's `throw_payload_kind`: both answer the same question from
        // the same syntax, but the checker's table is TypeEnv-derived state
        // that does not reach codegen, and this pass already carries
        // `var_types`/`fn_returns` for every expression it visits. They can
        // disagree only by one being MORE conservative (an unresolved name is
        // ""), which costs a kind here and a row precision there, never
        // soundness.
        // #1878 (Codex review on #1892): `infer_arg_type_name` can answer
        // with an internal shape sentinel (`__anonrec:` for a record
        // binding, `__anontup:` for a tuple carrying one) — inert for every
        // dispatch consumer, but THIS site publishes the string as the
        // user-facing exception kind, where a sentinel would render as
        // `<__anontup:__anonrec:a;>`. Publish "" instead, the same value an
        // unresolved payload gets (the erased sink then falls back to the
        // safely rendered payload).
        let kind0 = match infer_arg_type_name(perform_throw_payload(args), struct_sets, var_types, fn_returns) {
          Some(k) => k,
          None => ""
        }
        let kind = if String::starts_with(kind0, anon_record_prefix()) || String::starts_with(kind0, anon_tuple_prefix()) {
          ""
        } else {
          kind0
        }
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        exn_kind_mark_used()
        // The write has to land AFTER the payload is evaluated, not before.
        // There is ONE slot, so anything the payload expression does that
        // reaches a throw -- even one it handles itself -- overwrites the kind
        // this site just recorded. `throw(payload())` where `payload()`
        // internally catches a `throw(Bang(1))` and returns a String would
        // otherwise leave `Boom` in the slot and be reported as `<Boom>`
        // instead of its own message. Binding the payload first makes the
        // write the last thing before the perform.
        let pname = exn_kind_fresh_payload_name()
        // #1392 slice 3: render the payload HERE, where its type is known, and
        // carry the string alongside the kind. The erased arm cannot do this
        // itself at any later point -- see exn_kind_cell_stmt's comment.
        //
        // The renderer is the ordinary interpolation path, run against the
        // payload TEMP with `kind` injected into var_types. Rendering the
        // original payload expression instead would evaluate it twice; the
        // temp is exactly the same value and `kind` is exactly the type
        // `infer_arg_type_name` just derived from that expression.
        //
        // The slot is written ONLY when a STRUCTURAL renderer was found, and
        // is cleared otherwise. The reader cannot make that distinction
        // itself: `__to_string`'s pointer decimal is a perfectly ordinary
        // non-empty string, so a reader that trusted any non-empty slot would
        // print `192` for an enum without `derive(Show)` -- strictly worse
        // than the `<Kind>` #1374 already prints there. Faithfulness is a
        // static property of this site, so it is decided here.
        //
        // #1398 review (Codex P2): "" is therefore a sentinel, and it is a
        // sound one only because every renderer reachable from here produces a
        // NON-EMPTY string by construction. `derived_only` (Codex P1, above)
        // is what makes that true: a derived struct renderer opens with the
        // type name (`P { ..`), a derived enum renderer IS a variant name, and
        // the wrapper expansions are `Some(..)`/`Ok(..)`/`Err(..)`/`None`. A
        // user-written formatter could legitimately return "" -- and is no
        // longer called from here at all.
        let render_vars = if kind == "" {
          var_types
        } else {
          extend_var_types(var_types, pname, Some(kind))
        }
        let render_target = interp_show_target(EIdent(pname, -1), true, struct_sets, render_vars, fn_returns)
        let rendered = if render_target != "" {
          Some(ECall(EIdent(render_target, -1), Array::slice([
            EIdent(pname, -1)
          ], 0, 1), -1))
        } else {
          interp_expand(EIdent(pname, -1), true, gens, traits, struct_sets, dict_binds, render_vars, fn_returns)
        }
        let msg_write = exn_msg_write_expr(if interp_has_repl(rendered) {
          interp_take_repl(rendered)
        } else {
          EString("")
        })
        ELet(pname, perform_throw_payload(rwargs), ESeq(exn_kind_write_expr(kind), ESeq(msg_write, ECall(callee, perform_throw_with_payload(rwargs, EIdent(pname, -1)), off))), -1)
      } else {
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {
          Some(map_get) => map_get,
          None =>
          match callee {
            EIdent(name0, coff) => {
              // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->
              // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.
              let name_ctor = match split_qualified(name0) {
                Some(parts0) => {
                  let (h0, m0) = parts0
                  match qual_ctor_member(h0, m0, struct_sets, fn_returns) {
                    Some(mm) => mm,
                    None => name0
                  }
                },
                None => name0
              }
              // #736 residual: bare method-style callee — `xs |> length` is
              // `length(xs)`; with only the receiver TYPE imported there is no
              // top-level `length`, so resolve to `<type-of-arg0>::length` (USER
              // types only, and only when no top-level fn of the bare name exists
              // — a lexically visible `length` keeps normal call semantics). The
              // checker applies the same rule, so typing and codegen agree.
              let name = if String::index_of(name_ctor, "::") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {
                match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", name_ctor))
                    if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {
                      qual
                    } else {
                      name_ctor
                    }
                  },
                  None => name_ctor
                }
              } else {
                name_ctor
              }
              // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.
              let as_method = match split_qualified(name) {
                Some(parts) => {
                  let (head, member) = parts
                  find_dict_for_method(dict_binds, head, member)
                },
                None => None
              }
              match as_method {
                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), rwargs, off),
                None => match lookup_gen_entry(gens, name) {
                  Some(gen) => match synth_dicts(gen.threaded, gen.constructor_recvs, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                    Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),
                    None => ECall(EIdent(name, coff), rwargs, off)
                  },
                  None => ECall(EIdent(name, coff), rwargs, off)
                }
              }
            },
            EDot(obj, m, doff, fdoff) => {
              // #736 residual: method-style call `xs.length()` on a USER type —
              // codegen compiles a called EDot as struct-field access, so a
              // receiver method (`List::length`) failed with "unknown struct
              // field". Rewrite to the qualified call when the receiver's type is
              // inferable and declares the method as a top-level fn. A struct
              // FIELD of the same name keeps the field-stored-function call (the
              // field is the closer binding), and unknown receivers keep the EDot
              // (codegen's existing paths).
              let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              // #931: UFCS on a trait-BOUNDED TYPE PARAMETER — `k.probe_key()`
              // where `k: K` and `[K: Hash]` is in scope. The receiver's inferred
              // "type name" is the tparam itself ("K"), which is neither a struct
              // nor a concrete `K::method` top-level fn, so the concrete-method
              // rewrite below missed it and the call stayed a bare EDot — codegen
              // compiles a called EDot as a struct-field read, yielding a
              // null-function call at runtime. Route it through the SAME threaded
              // witness dict as the qualified spelling `K::probe_key(k)` (the
              // EIdent arm above): `(dict.method)(k, args)`. Checked FIRST so both
              // spellings resolve identically (the qualified path also consults
              // find_dict_for_method before any concrete fallback).
              let recv_tn = infer_arg_type_name(obj, struct_sets, var_types, fn_returns)
              let as_tparam_dict = match recv_tn {
                Some(tn) => find_dict_for_method(dict_binds, tn, m),
                None => None
              }
              let as_recv_method = match as_tparam_dict {
                Some(_) => None,
                None => match recv_tn {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", m))
                    let is_field = struct_set_member(struct_sets, tn, m)
                    if !is_field && fn_exists(fn_returns, qual) {
                      Some(qual)
                    } else {
                      None
                    }
                  },
                  None => None
                }
              }
              match as_tparam_dict {
                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), m, -1, -1), prepend_expr(robj, rwargs), off),
                None => match as_recv_method {
                  // #1199 bug 2: `qual` (e.g. "Box::describe") can be a
                  // THREADED generic itself (`Box::describe[T: Hash](b:
                  // Box[T], value: T)`) exactly like a directly-written
                  // `Box::describe(b, value)` call reaching the EIdent arm
                  // above -- but until this fix, this EDot rewrite only ever
                  // built `ECall(EIdent(qual), [receiver, ...args])`,
                  // NEVER consulting lookup_gen/synth_dicts the way the
                  // EIdent arm does. So the qualified spelling of a call
                  // correctly prepended its witness dictionary argument(s)
                  // while the identical call written as dot-call sugar
                  // silently dropped them -- the callee's (already
                  // dict-threaded) signature and the dot-call's rewritten
                  // arg count then disagreed, and codegen emitted a call
                  // short its dict argument(s) (invalid wasm), not two
                  // notations of the same, both-valid call. Mirror the
                  // EIdent arm exactly: synth_dicts against the ORIGINAL
                  // (pre-rewrite) receiver + args, prepending the resolved
                  // dicts ahead of the rewritten receiver + args on success,
                  // falling back to the un-dicted call (same as the EIdent
                  // arm's own fallback) when synth_dicts can't resolve one.
                  Some(qual) => match lookup_gen_entry(gens, qual) {
                    Some(gen) => match synth_dicts(gen.threaded, gen.constructor_recvs, prepend_expr(obj, args), traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                      Some(dicts) => ECall(EIdent(qual, doff), concat_expr_arrays(dicts, prepend_expr(robj, rwargs)), off),
                      None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)
                    },
                    None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)
                  },
                  None => ECall(EDot(robj, m, doff, fdoff), rwargs, off)
                }
              }
            },
            _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)
          }
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(_) => expr,
    EStringInterp(_) => expr,
    ETuple(elems) => ETuple(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    EArray(elems) => EArray(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELet(name, val, body, soff) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let inferred = if result_uses_constructor_witness(val, gens) {
        anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)
      } else {
        anon_or_infer(val, struct_sets, var_types, fn_returns)
      }
      let inferred_vars = if Array::get(dtd_constructor_tracking, 0) && inferred == None && constructor_binding_has_evidence(var_types, name) {
        constructor_rewrite_var_types(var_types, name, inferred)
      } else {
        extend_var_types(var_types, name, inferred)
      }
      let body_vars0 = bind_impl_target_key(inferred_vars, name, val, struct_sets, fn_returns)
      let body_vars1 = bind_shapes(body_vars0, name, val, struct_sets, fn_returns)
      let body_vars2 = eq_shape_bind(body_vars1, name, val, struct_sets, fn_returns)
      // #2157: an unannotated `let xs = []` reads its element type off the
      // pushes in its own body, so it compares like the annotated form.
      let body_vars3 = empty_array_shape_from_body(body_vars2, name, body, struct_sets, fn_returns)
      let body_vars = extend_local_fn_return(body_vars3, name, val)
      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)
    },
    ELetRec(name, val, body) => {
      let rec_vars = if Array::get(dtd_constructor_tracking, 0) {
        extend_local_fn_return(extend_constructor_var_types(var_types, name, None), name, val)
      } else {
        var_types
      }
      ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, rec_vars, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, rec_vars, fn_returns))
    },
    ELetMut(name, val, body, soff) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let inferred = if result_uses_constructor_witness(val, gens) {
        anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)
      } else {
        anon_or_infer(val, struct_sets, var_types, fn_returns)
      }
      let inferred_vars = if Array::get(dtd_constructor_tracking, 0) && inferred == None && constructor_binding_has_evidence(var_types, name) {
        constructor_rewrite_var_types(var_types, name, inferred)
      } else {
        extend_var_types(var_types, name, inferred)
      }
      let body_vars0 = bind_impl_target_key(inferred_vars, name, val, struct_sets, fn_returns)
      let body_vars1 = bind_shapes(body_vars0, name, val, struct_sets, fn_returns)
      let body_vars2 = eq_shape_bind(body_vars1, name, val, struct_sets, fn_returns)
      let body_vars3 = empty_array_shape_from_body(body_vars2, name, body, struct_sets, fn_returns)
      let body_vars = extend_local_fn_return(body_vars3, name, val)
      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)
    },
    EAssign(name, val, cont) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let inferred = if result_uses_constructor_witness(val, gens) {
        anon_or_constructor_infer(val, gens, struct_sets, var_types, fn_returns)
      } else {
        anon_or_infer(val, struct_sets, var_types, fn_returns)
      }
      let continuation_vars = if Array::get(dtd_constructor_tracking, 0) {
        extend_local_fn_return(constructor_rewrite_var_types(var_types, name, inferred), name, val)
      } else {
        var_types
      }
      EAssign(name, new_val, rewrite_expr(cont, gens, traits, struct_sets, dict_binds, continuation_vars, fn_returns))
    },
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        // #1445 cause 3: a pattern binder was absent from `var_types`
        // entirely, so `match o { Some(v) => "\{v}" }` rendered `v` through
        // the ADR-0058 pointer heuristic even when `o`'s payload type was
        // known. When the scrutinee is a NAME whose payload type was recorded
        // (`ctor_payload_key`, from a parameter annotation or a let-bound
        // `Some(..)`), the arm's binder gets that type for its body.
        let arm_vars0 = arm_binder_var_types_env(scrut, p, var_types, struct_sets, fn_returns)
        let arm_vars = if Array::get(dtd_constructor_tracking, 0) {
          constructor_match_arm_var_types(scrut, p, gens, struct_sets, arm_vars0, fn_returns)
        } else {
          arm_vars0
        }
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, arm_vars, fn_returns)))
        i = i + 1
      }
      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        let arm_vars = if Array::get(dtd_constructor_tracking, 0) {
          constructor_handler_arm_var_types(scrut, p, gens, struct_sets, var_types, fn_returns)
        } else {
          var_types
        }
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, arm_vars, fn_returns)))
        i = i + 1
      }
      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EForIn(name, idx, iter, body) => {
      let body_vars = if Array::get(dtd_constructor_tracking, 0) {
        constructor_for_body_var_types(iter, name, idx, struct_sets, var_types, fn_returns)
      } else {
        var_types
      }
      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)
      // #1350: one surface, one classification. A plain `for x in e` is
      // iterator/iterable/array-classified only when a method-bearing trait is
      // present (without one there are no `impl ::next` methods to dispatch),
      // so trait-free programs' `for` loops keep their EForIn lowering -- with
      // the two ASYNC shapes as the exception, exactly as `for await` was the
      // exception before: they are plain named functions / closures, need no
      // trait machinery, and their consumers (the prelude's AsyncIter
      // terminals, @vibe/console's pull streams) are trait-free files.
      let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      if Array::length(traits) == 0 {
        classify_trait_free_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      } else {
        classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      }
    },
    EBinOp(op, l, r) => {
      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      // #672: dispatch `a == b` / `a != b` on a struct type to the generated
      // structural `T::equals`. The operand's type is resolved best-effort via
      // `infer_arg_type_name` (var_types for variables, field-set match for
      // struct literals); a struct type whose `equals` we generated is rewritten
      // to a call. Non-struct / unresolved operands keep the scalar binop.
      if op == "==" || op == "!=" {
        // #695: an empty array LITERAL on either side reduces `==` to a length
        // check on the other operand (an array equals `[]` iff its length is 0),
        // which is exact and needs no element type. This also covers `[] == []`,
        // whose element type is otherwise undeterminable.
        let empty_bound_l = is_untyped_empty_array_name(l, var_types)
        let empty_bound_r = is_untyped_empty_array_name(r, var_types)
        let empty_lit_l = is_empty_array_lit(l)
        let empty_lit_r = is_empty_array_lit(r)
        // #695: a bare array `==` (operand is an array literal whose element type
        // is statically determinable) dispatches to the monomorphic
        // `__arr_equals__<key>` helper (emitted by desugar_derives), since the
        // runtime `eq` would identity-compare the array. Opaque array-typed
        // operands (no literal in scope) are left as `==` (documented residual).
        // #1526: a literal on either side answers first (it is exact and needs
        // no environment); an operand reached through a NAME answers next, from
        // the element type recorded at its binding site. The helper this
        // resolves to is generated because the emission was RECORDED, not
        // because a second walk predicted the same thing -- see
        // `arr_eq_needed_record`.
        // #2141: an element type that names an enclosing binder's formal is
        // re-spelled before it keys/records a helper -- see subst_formals_ty.
        let arr_elem = match (match infer_earray_elem_type(l) {
          Some(t) => Some(t),
          None => match infer_earray_elem_type(r) {
            Some(t) => Some(t),
            None => eq_var_array_elem(l, r, var_types)
          }
        }) {
          Some(t) => Some(subst_scope_formals_ty(t)),
          None => None
        }
        if empty_lit_l || empty_lit_r {
          // An empty LITERAL decides the answer on its own: the array it is
          // compared against is equal to it exactly when that array is empty.
          // Exact for any element type, so no guard and no comparator.
          let other = if empty_lit_l {
            rr
          } else {
            rl
          }
          let lencmp = EBinOp("==", ECall(EIdent("Array::length", -1), [other], -1), EInt(0))
          if op == "==" {
            lencmp
          } else {
            ECall(EIdent("not", -1), [lencmp], -1)
          }
        } else if (empty_bound_l || empty_bound_r) && !opt_ty_is_some(arr_elem) {
          // An unannotated `let xs = []` whose element type #2157's push scan
          // could not recover, and whose PARTNER supplies none either (an
          // operand with a known element type takes the monomorphic comparator
          // below, which handles an empty array like any other).
          //
          // The lengths still decide the answer whenever EITHER side is empty:
          // two arrays cannot be equal unless their lengths are, and a length
          // of zero on one side leaves nothing to compare element-wise. That
          // covers every program in which one of the two never grew, which is
          // the shape this residual is usually reached by.
          //
          // Only two arrays that BOTH grew, with no element type on either
          // side, are genuinely undecidable here, and that case still traps
          // rather than falling back to length-only or identity equality --
          // answering wrongly is worse than falling over. An annotation
          // (`let xs: Array[Int] = []`) supplies the missing static shape.
          //
          // The lengths are bound rather than re-spelled: an operand may be an
          // arbitrary expression, and it must be evaluated exactly once.
          // Minted FRESH against both operands, the way assert_eq and inspect
          // mint theirs: an operand is arbitrary user code, and a fixed name is
          // capturable. `let __eqempty_ln = []; xs == __eqempty_ln` bound the
          // outer temporary over the right operand while the inner one was
          // still being initialized, so `Array::length` was applied to the left
          // LENGTH rather than to the second array (#2192 review).
          let ln = dinsp_fresh_name("__eqempty_l", rl, rr)
          let rn = dinsp_fresh_name("__eqempty_r", rl, rr)
          let either_empty = EBinOp("||", EBinOp("==", EIdent(ln, -1), EInt(0)), EBinOp("==", EIdent(rn, -1), EInt(0)))
          let decided = EIf(either_empty, EBinOp("==", EIdent(ln, -1), EIdent(rn, -1)), ESeq(ECall(EIdent("assert_true", -1), [
            EBool(false)
          ], -1), EBool(false)))
          let guarded = ELet(ln, ECall(EIdent("Array::length", -1), [rl], -1), ELet(rn, ECall(EIdent("Array::length", -1), [
            rr
          ], -1), decided, -1), -1)
          if op == "==" {
            guarded
          } else {
            ECall(EIdent("not", -1), [guarded], -1)
          }
        } else {
          match arr_elem {
            Some(elem) => {
              // #1526: record before emitting -- this is one of the two sites
              // that can reference a `__arr_equals__<key>` helper, and the
              // recorded set is what generates them (see arr_eq_needed_record).
              arr_eq_needed_record(elem)
              let call = ECall(EIdent(arr_equals_name(elem), -1), [rl, rr], -1)
              if op == "==" {
                call
              } else {
                ECall(EIdent("not", -1), [call], -1)
              }
            },
            None => {
              // #825: full static-shape dispatch. When either operand's complete
              // TypeExpr is inferable from literal syntax (Some/Ok/Err ctor
              // literals, tuple literals, array literals with non-scalar
              // elements), route through the fully-recursive `eq_for_typed` so
              // aggregate payloads (`Some([1,2])`, `Ok([1,2])`, `Some(Some(1))`,
              // `([1,2], 0)`) compare structurally instead of by word identity.
              // `known_types` is empty: this inference only ever yields builtin
              // shapes (never user struct/enum names), and unknown positions
              // carry the `__EqUnknown` marker which `eq_for_typed` compares
              // with raw `==` (status quo for that position).
              let sty = infer_static_eq_type_binop(l, r)
              let dty = match sty {
                Some(t) => if static_eq_dispatchable(t) {
                  Some(t)
                } else {
                  None
                },
                None => None
              }
              match dty {
                Some(dt) => {
                  let call = eq_for_typed(dt, rl, rr, empty_str_array())
                  if op == "==" {
                    call
                  } else {
                    ECall(EIdent("not", -1), [call], -1)
                  }
                },
                None => match eq_var_shape_dispatch(l, r, struct_sets, var_types, fn_returns) {
                  // #1526 (ADR-0097): a NAME whose recorded shape mentions an
                  // Array/Bytes — the tuple-through-a-name comparison whose
                  // Array elements the codegen walk identity-compared. Any
                  // other shape stays on the paths below (see
                  // eq_operand_shape_ty's trigger condition).
                  Some(st) => {
                    let call = eq_for_typed(st, rl, rr, dtd_eq_known_types)
                    if op == "==" {
                      call
                    } else {
                      ECall(EIdent("not", -1), [call], -1)
                    }
                  },
                  None => {
                    let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
                      Some(t) => Some(t),
                      None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)
                    }
                    match ty {
                      // #2141: a spelling that is a type parameter of an
                      // enclosing binder is a FORMAL here, whatever else the
                      // (merged) program declares under that name -- the
                      // struct dispatch would call `T::equals` on erased
                      // operands and read garbage.
                      Some(t) => if struct_set_has(struct_sets, t) && !formal_in_scope(t) {
                        let call = ECall(EIdent(String::concat(t, "::equals"), -1), [
                          rl,
                          rr
                        ], -1)
                        if op == "==" {
                          call
                        } else {
                          ECall(EIdent("not", -1), [call], -1)
                        }
                      } else if t == "Option" {
                        // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)
                        // dispatches to a structural match; the runtime would otherwise
                        // identity-compare the heap-allocated nullary `None`. Payloads
                        // compare with `==` — correct for scalar payloads (the common
                        // case); an aggregate-payload bare-Option variable is a #695
                        // residual (route it through a struct field for full recursion).
                        let eqm = opt_eq_match(rl, rr)
                        if op == "==" {
                          eqm
                        } else {
                          ECall(EIdent("not", -1), [eqm], -1)
                        }
                      } else if t == "Result" {
                        let eqm = result_eq_match(rl, rr)
                        if op == "==" {
                          eqm
                        } else {
                          ECall(EIdent("not", -1), [eqm], -1)
                        }
                      } else if t == "Bytes" {
                        // #1526 (ADR-0097): a Bytes-typed operand (annotation or
                        // recorded binding) — content equality, same helper the
                        // typed contexts dispatch to.
                        bytes_eq_needed_record()
                        let call = ECall(EIdent(bytes_equals_name(), -1), [
                          rl,
                          rr
                        ], -1)
                        if op == "==" {
                          call
                        } else {
                          ECall(EIdent("not", -1), [call], -1)
                        }
                      } else {
                        EBinOp(op, rl, rr)
                      },
                      None => EBinOp(op, rl, rr)
                    }
                  }
                }
              }
            }
          }
        }
      } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
        // #746: String relational lowering. The backends compile a bare
        // `<`/`>`/`<=`/`>=` as signed i64 compare — on the (ptr<<32)|len
        // string repr that orders by POINTER, not content. Rewrite to
        // `str_lex_diff(l, r) <op> 0` (a builtin returning a sign-carrying
        // lexicographic diff with length tie-break) when either ORIGINAL
        // operand is determinably String — same inference and residual
        // class as the `+` -> String::concat rewrite below.
        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if rel_stringish {
          EBinOp(op, ECall(EIdent("str_lex_diff", -1), [rl, rr], -1), EInt(0))
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: neither operand is determinably String, but at least one is
          // the bare name of an in-scope generic type parameter — the
          // concrete runtime type is erased, so dispatch at runtime instead
          // (see is_erased_generic_operand / gen_generic_rel_diff_body).
          EBinOp(op, ECall(EIdent("__generic_rel_diff", -1), [rl, rr], -1), EInt(0))
        } else {
          EBinOp(op, rl, rr)
        }
      } else if op == "+" {
        // String `+` lowering: the checker types `String + String` as String,
        // but the backends compile a bare `+` as numeric i64.add — on the
        // (ptr<<32)|len string repr that adds the lengths and garbles the
        // pointer. Rewrite to String::concat when either ORIGINAL operand is
        // determinably String (literal, tracked var, string-returning call,
        // or a nested `+` chain of those). Undeterminable operands (e.g. two
        // untracked call results) keep the raw binop — same residual class
        // as #695's opaque `==`.
        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if stringish {
          ECall(EIdent("String::concat", -1), [rl, rr], -1)
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: same erased-`[T: Add]` case as the relational branch above.
          ECall(EIdent("__generic_add", -1), [rl, rr], -1)
        } else {
          EBinOp(op, rl, rr)
        }
      } else {
        EBinOp(op, rl, rr)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EFn(tp, bs, ps, ret, eff, body) => {
      // #2141: the binder frame scopes the body -- see dtd_scope_formals.
      scope_formals_push(tp)
      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)
      scope_formals_pop()
      EFn(tp, bs, ps, ret, eff, rbody)
    },
    EDot(obj, field, off, fdoff) => {
      let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      match anon_dot_rewrite(obj, field, off, robj, var_types) {
        Some(rw) => rw,
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    })
  }
}

/// Extract the member of a qualified `Head::member` name (the part after `::`).
fn member_of(name: String) -> String {
  match split_qualified(name) {
    Some(parts) => {
      let (_, member) = parts
      member
    },
    None => name
  }
}

/// Build the dict bindings in scope for a transformed generic's body.
fn dict_binds_of(threaded: Array[(String, String, Int)], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] {
  let out = empty_dict_binds()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let methods = match lookup_trait_sigs(traits, trait_name) {
      Some(sigs) => method_names_of_sigs(sigs),
      None => empty_str_array()
    }
    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))
    i = i + 1
  }
  out
}

/// Prepend the hidden dict parameters to a transformed generic's parameter list.
fn thread_dict_params(threaded: Array[(String, String, Int)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  let result = array_empty()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let trait_args = trait_ref_args(trait_name)
    let dty = TyApp(dict_struct_name(trait_name), if Array::length(trait_args) > 0 {
      trait_args
    } else {
      [TyName(tp)]
    })
    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(params) {
    Array::push(result, Array::get(params, j))
    j = j + 1
  }
  result
}

/// `toplevel_vars` (#839): the program's top-level anonymous-record bindings
/// (see `collect_toplevel_anon_records`), seeded as the base var_types for
/// every top-level statement's own `rewrite_expr` pass — mirrors the
/// `railway_rw_stmt` fix for the SAME `anon_dot_rewrite` call below, since this
/// is the SECOND, independent pass (the "heavy dict-passing" pass driving
/// `desugar_trait_dicts`, used by the RC/FS-compile codegen entries) that also
/// lowers `record{}.field` dot access — without this it inherited the exact
/// same "only resolves within a single top-level statement's own expression
/// tree" gap.
fn rewrite_stmt(stmt: Stmt, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt with Exception {
  let no_binds = empty_dict_binds()
  // #1392: which top-level binding's body is about to be walked, so the
  // interpolation rewrite can decline to make `T::to_string` call itself.
  show_self_fn_set(match stmt {
    SLet(_, _, sname, _, _) => sname,
    _ => ""
  })
  match stmt {
    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {
      Some(threaded) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          let binds = dict_binds_of(threaded, traits)
          let new_params = thread_dict_params(threaded, params)
          let seeded = seed_var_types(params, tparams, toplevel_vars)
          // #2141 (Codex P1 on #2183): this dict-threaded path unwraps the
          // EFn itself, so rewrite_expr's EFn arm never pushes the binder
          // frame for it -- a `[T: Trait]` formal colliding with an imported
          // `struct T` still dispatched `T::equals` on erased operands.
          scope_formals_push(tparams)
          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)
          scope_formals_pop()
          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))
        },
        _ => stmt
      },
      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns))
    },
    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SLetPat(pat, e) => SLetPat(pat, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SModule(exp, name, body) => SModule(exp, name, for s in body {
      rewrite_stmt(s, gens, traits, struct_sets, fn_returns, toplevel_vars)
    }),
    _ => stmt
  }
}

// ---- derive(...) structural function generation (#638) ----
//
// For a `struct P { x; y } derive(Show, Ord)` this generates the structural
// free functions `P::to_string` and `P::compare` (concrete `Type::method`,
// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural
// `==` is a runtime builtin). Hash / Default and enums are deferred slices.

fn qualified_name(tname: String, method: String) -> String {
  String::concat(tname, String::concat("::", method))
}

fn top_level_fn_exists(stmts: Array[Stmt], fname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => if name == fname {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

fn concat2(a: Expr, b: Expr) -> Expr {
  ECall(EIdent("String::concat", -1), [a, b], -1)
}

/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array
/// to-string helper `__arr_to_string__<key>` so distinct element types get
/// distinct helpers. `Int` -> "Int", `Array[Int]` -> "Array_Int",
/// `Option[Int]` -> "Option_Int", `(Int,Bool)` -> "Tup_Int_Bool", else "Any".
/// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into
/// `Array[t]` fields produces a structural — not pointer-heuristic — string.)
fn ts_type_key(ty: TypeExpr) -> String {
  match ty {
    TyName(n) => n,
    TyApp(n, args) => {
      let mut s = n
      let mut i = 0
      while i < Array::length(args) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(args, i))))
        i = i + 1
      }
      s
    },
    TyTuple(ts) => {
      let mut s = "Tup"
      let mut i = 0
      while i < Array::length(ts) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(ts, i))))
        i = i + 1
      }
      s
    },
    TyUnit => "Unit",
    _ => "Any"
  }
}

/// The generated monomorphic array-to-string helper name for element type `t`.
fn arr_to_string_name(t: TypeExpr) -> String {
  String::concat("__arr_to_string__", ts_type_key(t))
}

/// Produce a String expression for a value `val` whose declared type is `fty`.
/// Fully type-directed and recursive (#694 Layer 2):
///   - `String` -> verbatim
///   - scalar `TyName` -> `__to_string(val)`
///   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`
///   - `Option[t]` -> `match val { Some(x) => "Some(" ++ show(x) ++ ")", None => "None" }`
///   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match
///   - tuple `(t0,..,tn)` -> `"(" ++ show(t0) ++ ", " ++ .. ++ ")"`
///   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`
///   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)
/// The structural `Type::to_string` (and the derived `Type::hash_key` that
/// delegates to it) is therefore stable for two distinct-but-equal aggregates,
/// no matter how deeply nested.
fn show_for_typed(fty: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {
  match fty {
    TyName("String") => val,
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "to_string"), -1), Array::slice([val], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let t = Array::get(args, 0)
      let inner = show_for_typed(t, EIdent("__os_v", -1), known_types)
      let some_body = concat2(EString("Some("), concat2(inner, EString(")")))
      EMatch(val, Array::slice([
        (PCtor("Some", Array::slice([PBind("__os_v")], 0, 1)), some_body),
        (PCtor("None", array_empty()), EString("None"))
      ], 0, 2))
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let t = Array::get(args, 0)
      let e = Array::get(args, 1)
      let ok_inner = show_for_typed(t, EIdent("__rs_v", -1), known_types)
      let err_inner = show_for_typed(e, EIdent("__rs_v", -1), known_types)
      let ok_body = concat2(EString("Ok("), concat2(ok_inner, EString(")")))
      let err_body = concat2(EString("Err("), concat2(err_inner, EString(")")))
      EMatch(val, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__rs_v")], 0, 1)), ok_body),
        (PCtor("Err", Array::slice([PBind("__rs_v")], 0, 1)), err_body)
      ], 0, 2))
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
    },
    TyTuple(ts) => {
      let n = Array::length(ts)
      let pats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(pats, PBind(String::concat("__ts_t", idx_str(i))))
        i = i + 1
      }
      let segs = empty_expr_array()
      Array::push(segs, EString("("))
      let mut k = 0
      while k < n {
        if k > 0 {
          Array::push(segs, EString(", "))
        } else {
          ()
        }
        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat("__ts_t", idx_str(k)), -1), known_types))
        k = k + 1
      }
      Array::push(segs, EString(")"))
      let mut acc = Array::get(segs, Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(Array::get(segs, j), acc)
        j = j - 1
      }
      EMatch(val, Array::slice([(PTuple(pats), acc)], 0, 1))
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([
        val
      ], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
    },
    TyApp(n, _) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "to_string"), -1), Array::slice([val], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
    },
    _ => ECall(EIdent("__to_string", -1), Array::slice([val], 0, 1), -1)
  }
}

/// Show a single struct field value as a String expression, by its declared type
/// (#694: type-directed and recursive — aggregate fields recurse structurally
/// instead of falling into the `__to_string` pointer heuristic).
fn field_show_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty, EDot(EIdent("self", -1), fname, -1, -1), known_types)
}

// ---- #2136: a synthesized helper binds the type variables it mentions ----
//
// The `Array[e]` helpers below are described as MONOMORPHIC, and for a concrete
// element type they are. But `e` is read off a declaration (`struct Box[T] { xs:
// Array[T] }`) or off a generic function's `==` operand, so it can be a TYPE
// VARIABLE — and the synthesized `let __arr_equals__T = (a: Array[T], b:
// Array[T]) -> Bool { .. }` then names a `T` that NOTHING in the generated
// declaration binds. It only type-checks because an unknown type name silently
// becomes a rigid type constructor (#2125); the moment that hole closes, the
// compiler's own generated code stops checking.
//
// So the helper binds them: `[T](a: Array[T], b: Array[T]) -> Bool`. Which names
// are variables is not a guess — `dtd_type_param_names` holds the names the
// program itself binds as type parameters, and a name that is ALSO a declared
// struct/enum name is left alone (there it denotes the declared type, and
// binding it would change a working program).
let dtd_type_param_names: Array[String] = empty_str_array()

// ---- #2141: the LEXICAL type-parameter scope during the rewrite ----
//
// `dtd_type_param_names` is a program-wide UNION minus declared type names, so
// it cannot say "the `T` HERE is a formal" when the same spelling is also a
// declared type. The #2141 guard rejects that collision for a LOCALLY declared
// type, but an IMPORTED `struct T` next to a formal `T` is legal (pinned by
// derive_array_helper_interference_test) -- and at the merged codegen run the
// import IS in `struct_sets`, so spelling-keyed dispatch sent a formal-typed
// `a == b` to `T::equals` and read garbage (measured: `eqv[T](1, 2)` answered
// true).
//
// This stack is the scope-precise answer: `rewrite_expr`'s EFn arm pushes the
// binder frame around the body and pops it after, so a decision site can ask
// whether a spelling is a type parameter OF AN ENCLOSING BINDER -- where the
// formal shadows any same-spelled declared type, exactly like a value binding
// would.
let dtd_scope_formals: Array[String] = empty_str_array()

let dtd_scope_formal_marks: Array[Int] = [0]

fn scope_formals_reset() -> Unit {
  Array::truncate(dtd_scope_formals, 0)
  Array::truncate(dtd_scope_formal_marks, 0)
}

fn scope_formals_push(tparams: Array[String]) -> Unit {
  Array::push(dtd_scope_formal_marks, Array::length(dtd_scope_formals))
  let mut i = 0
  while i < Array::length(tparams) {
    Array::push(dtd_scope_formals, Array::get(tparams, i))
    i = i + 1
  }
}

fn scope_formals_pop() -> Unit {
  if Array::length(dtd_scope_formal_marks) == 0 {
    ()
  } else {
    let mark = Array::get(dtd_scope_formal_marks, Array::length(dtd_scope_formal_marks) - 1)
    Array::truncate(dtd_scope_formal_marks, Array::length(dtd_scope_formal_marks) - 1)
    Array::truncate(dtd_scope_formals, mark)
  }
}

fn formal_in_scope(n: String) -> Bool {
  str_array_contains(dtd_scope_formals, n)
}

// #2141: a formal's spelling, re-spelled so no declared type can collide with
// it. A generated helper's KEY, BINDER and element semantics all derive from
// the element TypeExpr's spellings -- `Array[T]` where `T` is a formal next to
// a (merged-in) `struct T` used to key the CONCRETE helper `__arr_equals__T`,
// lose its binder to the #2136 subtraction, and compare elements with
// `T::equals` (measured: `same[T]([1,2], [1,3])` answered true). Re-spelling
// the formal at the classification site makes every downstream decision
// follow: distinct key, bound binder (collect_ty_var_names recognizes the
// prefix), and the raw `==` element compare a variable requires.
let scope_formal_mark_prefix: String = "__Vfp_"

fn mark_formal_name(n: String) -> String {
  String::concat(scope_formal_mark_prefix, n)
}

fn is_marked_formal_name(n: String) -> Bool {
  String::starts_with(n, scope_formal_mark_prefix)
}

/// Re-spell every name in `ty` that `is_formal` answers true for. Used with
/// `formal_in_scope` at rewrite sites (the lexical stack is live there) and
/// with a declaration's own tparams at the derive-generation sites (where the
/// declaration IS the scope).
fn subst_formals_ty(ty: TypeExpr, formals: Array[String]) -> TypeExpr {
  if Array::length(formals) == 0 {
    ty
  } else {
    subst_formals_ty_body(ty, formals)
  }
}

fn formals_contain_source_name(formals: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(formals) {
    if type_param_name(Array::get(formals, i)) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn subst_formals_ty_body(ty: TypeExpr, formals: Array[String]) -> TypeExpr {
  match ty {
    TyName(n) => if formals_contain_source_name(formals, n) {
      TyName(mark_formal_name(n))
    } else {
      ty
    },
    TyApp(n, args) => {
      let out = empty_type_exprs()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, subst_formals_ty(Array::get(args, i), formals))
        i = i + 1
      }
      if formals_contain_source_name(formals, n) {
        TyApp(mark_formal_name(n), out)
      } else {
        TyApp(n, out)
      }
    },
    TyTuple(ts) => {
      let out = empty_type_exprs()
      let mut i = 0
      while i < Array::length(ts) {
        Array::push(out, subst_formals_ty(Array::get(ts, i), formals))
        i = i + 1
      }
      TyTuple(out)
    },
    _ => ty
  }
}

fn subst_scope_formals_ty(ty: TypeExpr) -> TypeExpr {
  subst_formals_ty(ty, dtd_scope_formals)
}

/// #2141, derive side: a declaration's OWN tparams are the scope its field
/// types were written in. Re-spell them before any generator reads the field
/// types, so a `struct Box[T]` next to a same-spelled (merged-in) declared
/// type generates variable-semantics helpers for `T`, not struct-semantics.
fn subst_field_formals(fields: Array[(String, TypeExpr)], formals: Array[String]) -> Array[(String, TypeExpr)] {
  if Array::length(formals) == 0 {
    fields
  } else {
    let out = array_empty()
    let mut i = 0
    while i < Array::length(fields) {
      let (fname, fty) = Array::get(fields, i)
      Array::push(out, (fname, subst_formals_ty(fty, formals)))
      i = i + 1
    }
    out
  }
}

fn subst_variant_formals(variants: Array[(String, Array[TypeExpr])], formals: Array[String]) -> Array[(String, Array[TypeExpr])] {
  if Array::length(formals) == 0 {
    variants
  } else {
    let out = array_empty()
    let mut i = 0
    while i < Array::length(variants) {
      let (vname, ftypes) = Array::get(variants, i)
      let tys = empty_type_exprs()
      let mut j = 0
      while j < Array::length(ftypes) {
        Array::push(tys, subst_formals_ty(Array::get(ftypes, j), formals))
        j = j + 1
      }
      Array::push(out, (vname, tys))
      i = i + 1
    }
    out
  }
}

fn push_name_once(acc: Array[String], name: String) -> Unit {
  if str_array_contains(acc, name) {
    ()
  } else {
    Array::push(acc, name)
  }
}

fn push_names_once(acc: Array[String], names: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(names) {
    push_name_once(acc, Array::get(names, i))
    i = i + 1
  }
}

fn collect_expr_type_param_names(e: Expr, acc: Array[String]) -> Unit {
  match e {
    EFn(tparams, _, _, _, _, _) => push_names_once(acc, tparams),
    _ => ()
  }
  let kids = expr_children(e)
  let mut i = 0
  while i < Array::length(kids) {
    collect_expr_type_param_names(Array::get(kids, i), acc)
    i = i + 1
  }
}

/// Fill `dtd_type_param_names` with every type-parameter name this program
/// binds — `struct Box[T]`, `enum Tree[T]`, and every `[T](..) -> ..` function
/// or lambda — minus any that is also a declared struct/enum name. Called from
/// `desugar_derives`, which runs before every site that generates an array
/// helper. (#2136.)
fn type_param_names_reset(stmts: Array[Stmt], known_types: Array[String]) -> Unit {
  Array::truncate(dtd_type_param_names, 0)
  let found = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, _, _, _, _, tparams) => push_names_once(found, tparams),
      SEnum(_, _, tparams, _, _) => push_names_once(found, tparams),
      SLet(_, _, _, _, e) => collect_expr_type_param_names(e, found),
      SLetMut(_, _, e) => collect_expr_type_param_names(e, found),
      SLetPat(_, e) => collect_expr_type_param_names(e, found),
      SExpr(e) => collect_expr_type_param_names(e, found),
      STest(_, e) => collect_expr_type_param_names(e, found),
      SBench(_, e) => collect_expr_type_param_names(e, found),
      _ => ()
    }
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(found) {
    let n = Array::get(found, j)
    if str_array_contains(known_types, n) {
      ()
    } else {
      Array::push(dtd_type_param_names, n)
    }
    j = j + 1
  }
}

/// The type variables `ty` mentions, appended to `acc` in first-occurrence
/// order. (#2136.)
fn collect_ty_var_names(ty: TypeExpr, acc: Array[String]) -> Unit {
  match ty {
    // #2141: a `__Vfp_`-marked name IS a formal by construction (see
    // subst_formals_ty) -- the program-wide set cannot know it, since the
    // marked spelling never appears in source.
    TyName(n) => if str_array_contains(dtd_type_param_names, n) || is_marked_formal_name(n) {
      push_name_once(acc, n)
    } else {
      ()
    },
    TyApp(n, args) => {
      if str_array_contains(dtd_type_param_names, n) || is_marked_formal_name(n) {
        push_name_once(acc, n)
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(args) {
        collect_ty_var_names(Array::get(args, i), acc)
        i = i + 1
      }
    },
    TyTuple(ts) => {
      let mut i = 0
      while i < Array::length(ts) {
        collect_ty_var_names(Array::get(ts, i), acc)
        i = i + 1
      }
    },
    TyFn(ps, ret, _) => {
      let mut i = 0
      while i < Array::length(ps) {
        collect_ty_var_names(Array::get(ps, i), acc)
        i = i + 1
      }
      collect_ty_var_names(ret, acc)
    },
    _ => ()
  }
}

/// The type-parameter list a synthesized `Array[elem_ty]` helper must carry:
/// empty for a concrete element type (the helper stays monomorphic), and the
/// mentioned type variables otherwise. (#2136.)
fn arr_helper_tparams(elem_ty: TypeExpr) -> Array[String] {
  let out = empty_str_array()
  collect_ty_var_names(elem_ty, out)
  out
}

/// `let __arr_to_string__<key> = (a: Array[t]) -> String {
///    "[" ++ join(show(a[0]), ", ", show(a[1]), ...) ++ "]" }` — a monomorphic,
/// fully-recursive array to-string. Element rendering goes through
/// `show_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse structurally
/// instead of pointer-stringifying aggregate elements. (#694 Layer 2.) When the
/// element type is a type variable the helper is generic over it instead —
/// see the `dtd_type_param_names` block above (#2136).
fn gen_arr_to_string_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {
  let elem_get = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("a", -1),
    EIdent("__as_i", -1)
  ], 0, 2), -1)
  let elem_show = show_for_typed(elem_ty, elem_get, known_types)
  // `__as_acc = __as_acc ++ (if i == 0 { "" } else { ", " }) ++ show(a[i])`
  let sep = EIf(EBinOp("==", EIdent("__as_i", -1), EInt(0)), EString(""), EString(", "))
  let append = concat2(concat2(EIdent("__as_acc", -1), sep), elem_show)
  let set_acc = EAssign("__as_acc", append, EUnit)
  let incr = EAssign("__as_i", EBinOp("+", EIdent("__as_i", -1), EInt(1)), EUnit)
  let loop_body = ESeq(set_acc, incr)
  let while_loop = EWhile(EBinOp("<", EIdent("__as_i", -1), ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1)), loop_body)
  let closed = concat2(EIdent("__as_acc", -1), EString("]"))
  let body = ELetMut("__as_i", EInt(0), ELetMut("__as_acc", EString("["), ESeq(while_loop, closed), -1), -1)
  let arr_ty = TyApp("Array", Array::slice([elem_ty], 0, 1))
  let params = Array::slice([("a", Some(arr_ty))], 0, 1)
  let tparams = arr_helper_tparams(elem_ty)
  let no_tb = array_empty()
  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(tparams, no_tb, params, Some(TyName("String")), None, body))
}

/// `let P::to_string = (self: P) -> String { "P { x: " ++ show(x) ++ ", ... }" }`
fn gen_show_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let segs = empty_expr_array()
  // #2205: this pass runs after the module-merge rename, so `tname` may be
  // the mangled `Point_dep_<path>` spelling -- render the SOURCE name (the
  // generated fn's own name stays mangled; only the string the user sees
  // recovers the original).
  Array::push(segs, EString(String::concat(namespace_rename_original(tname), " { ")))
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, i)
    let sep = if i == 0 {
      ""
    } else ", "
    Array::push(segs, EString(String::concat(sep, String::concat(fname, ": "))))
    Array::push(segs, field_show_expr(fname, fty, known_types))
    i = i + 1
  }
  Array::push(segs, EString(" }"))
  // fold right: concat(seg0, concat(seg1, ... segN))
  let mut body = Array::get(segs, Array::length(segs) - 1)
  let mut j = Array::length(segs) - 2
  while j >= 0 {
    body = concat2(Array::get(segs, j), body)
    j = j - 1
  }
  let params = Array::slice([("self", Some(TyName(tname)))], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}

/// A type name that the runtime compares as a flat scalar (no structural
/// `equals` needed). Everything else named is a user struct/enum and recurses
/// through its generated `T::equals`.
fn is_scalar_type_name(n: String) -> Bool {
  n == "Int" || n == "Double" || n == "Float" || n == "Bool" || n == "String" || n == "Char" || n == "Unit" || n == "Bytes"
}

/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array
/// helper `__arr_equals__<key>` so distinct element types get distinct helpers.
/// `Int` -> "Int", `Array[Int]` -> "Array_Int", `Option[Int]` -> "Option_Int",
/// `(Int,Bool)` -> "Tup_Int_Bool", unknown shapes -> "Any".
/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic
/// array/map helpers so distinct types get distinct helpers.
///
/// The encoding is LENGTH-PREFIXED and CONSTRUCTOR-TAGGED, which is what makes
/// it injective. Two rounds of #2235 review found collisions in the old
/// `join components with _` form, and each patch left another:
///
///   - a NAME containing `_` collided with an application: `type_key(Array[Int])`
///     and `type_key(Array_Int)` were both `Array_Int`, so a program declaring
///     `struct Array_Int` compared two `Array[Array_Int]` values with different
///     fields as EQUAL. Measured on main.
///   - doubling the underscores inside names fixed that one and left the
///     CONSTRUCTOR untagged: a tuple `(Int, Int)` and an application
///     `Tup[Int, Int]` both keyed `Tup_Int_Int`, and nothing recorded the
///     ARITY either -- `A[B[C]]` and `A[B, C]` keyed the same.
///
/// Both classes are silent-wrong, so the fix is an encoding that can be read
/// back rather than a longer list of escapes. Each node carries its tag, its
/// arity where it has one, and a length before every raw name -- so no name,
/// however spelled, can be mistaken for structure:
///
///   Int              -> N3_Int
///   Array[Int]       -> A1_N5_ArrayN3_Int
///   (Int, Bool)      -> T2_N3_IntN4_Bool
///   Tup[Int, Bool]   -> A2_N3_TupN3_IntN4_Bool
///
/// The names are longer and are not meant to be read; they appear only in
/// generated symbols and in the wasm name section.
fn type_key(ty: TypeExpr) -> String {
  match ty {
    TyName(n) => type_key_name(n),
    TyApp(n, args) => {
      let mut s = String::concat(String::concat("A", idx_str(Array::length(args))), "_")
      s = String::concat(s, type_key_name(n))
      let mut i = 0
      while i < Array::length(args) {
        s = String::concat(s, type_key(Array::get(args, i)))
        i = i + 1
      }
      s
    },
    TyTuple(ts) => {
      let mut s = String::concat(String::concat("T", idx_str(Array::length(ts))), "_")
      let mut i = 0
      while i < Array::length(ts) {
        s = String::concat(s, type_key(Array::get(ts, i)))
        i = i + 1
      }
      s
    },
    TyUnit => "U",
    _ => "X"
  }
}

/// `N<len>_<name>`: the length is what lets a reader (and any future decoder)
/// know where the raw name ends, so a name containing `_`, a digit, or the
/// spelling of a tag cannot be confused for structure.
fn type_key_name(n: String) -> String {
  String::concat(String::concat("N", idx_str(String::length(n))), String::concat("_", n))
}

/// The generated monomorphic array-equality helper name for element type `t`.
fn arr_equals_name(t: TypeExpr) -> String {
  String::concat("__arr_equals__", type_key(t))
}

// ---- #1526: the emitted set of `__arr_equals__<key>` helpers ----
//
// Which helpers a program needs is decided TWICE, by two separate walks:
//
//   1. `collect_bare_array_eq_keys` (run from `desugar_derives`) PREDICTS the
//      set and generates the helpers.
//   2. the `==` rewrite in `rewrite_expr` (and `eq_for_typed`) EMITS the calls.
//
// The two agreed only because they ran the same literal-only inference. (1) is
// handed nothing but `stmts` -- no `var_types` -- so it cannot see an operand's
// element type when the operand is reached through a NAME; (2) runs inside the
// rewrite, where the binding environment IS available, and it stayed
// deliberately blind to it to keep the two in step. That is the coupling that
// made `let a = [1, 2]; let c = [1, 2]; a == c` compare by identity: teaching
// the rewrite to use `var_types` (which it can) would have emitted calls the
// prediction never generated -- `undefined variable (local):
// __arr_equals__Int @call` -- so neither half could move alone.
//
// So generation stops being a prediction. The two sites that BUILD a call
// record what they built, and `emit_recorded_arr_equals` generates exactly that
// set after the rewrite has run. `desugar_derives`' own generation stays as a
// head start (it also covers struct/enum fields, which no `==` site mentions);
// the post-rewrite pass skips anything already produced. With emission as the
// source of truth, the rewrite is free to resolve element types however well it
// can -- see `eq_var_array_elem`.
let dtd_arr_eq_needed: Array[TypeExpr] = empty_type_exprs()

let dtd_arr_eq_needed_keys: Array[String] = empty_str_array()

/// Reset at each `desugar_trait_dicts` entry, BEFORE `desugar_derives` runs.
fn arr_eq_needed_reset() -> Unit {
  Array::truncate(dtd_arr_eq_needed, 0)
  Array::truncate(dtd_arr_eq_needed_keys, 0)
}

/// Record that a call to `__arr_equals__<key>` for element type `t` was emitted.
/// Called from the two (only) sites that build such a call, so the recorded set
/// is by construction the set the output references.
fn arr_eq_needed_record(t: TypeExpr) -> Unit {
  let k = type_key(t)
  if str_array_contains(dtd_arr_eq_needed_keys, k) {
    ()
  } else {
    Array::push(dtd_arr_eq_needed_keys, k)
    Array::push(dtd_arr_eq_needed, t)
  }
}

/// #1526: generate every recorded `__arr_equals__<key>` helper that does not
/// already exist. Runs AFTER the rewrite loop, since that is what produces the
/// calls.
///
/// The loop re-reads `Array::length` each turn on purpose: `gen_arr_equals_fn`
/// builds its body through `eq_for_typed`, which records the nested element
/// types it in turn calls (`Array[Array[Int]]` -> `Array[Int]`), so appending
/// to the list while walking it IS the worklist closure. It terminates because
/// `arr_eq_needed_record` dedups by type key and each nested type is strictly
/// shallower.
///
/// The generated statements are appended after the rewrite and so are not
/// themselves rewritten. They need no rewriting: `gen_arr_equals_fn` emits
/// already-lowered code (`Array::get` / `Array::length` / a type-directed
/// element comparison), which is what the pre-existing helpers reduce to as
/// well.
fn emit_recorded_arr_equals(stmts: Array[Stmt]) -> Unit {
  let known_types = collect_decl_type_names(stmts)
  let mut i = 0
  while i < Array::length(dtd_arr_eq_needed) {
    let et = Array::get(dtd_arr_eq_needed, i)
    if top_level_fn_exists(stmts, arr_equals_name(et)) {
      ()
    } else {
      Array::push(stmts, gen_arr_equals_fn(et, known_types))
    }
    i = i + 1
  }
}

// ---- #1526 (ADR-0097): structural `Bytes` equality ----
//
// `Bytes` has no literal syntax, so a `Bytes` operand ALWAYS reaches `==`
// through a name/call and the runtime `eq` identity-compared it. Same
// record-then-emit contract as `__arr_equals__<key>`: the sites that build a
// call record the need, and the helper is generated after the rewrite. One
// helper suffices (no element-type key: the element is always a byte).
let dtd_bytes_eq_needed: Array[String] = empty_str_array()

// #1526: per-expansion uid for `eq_for_typed`'s tuple binders (see the TyTuple
// arm). Deterministic — a counter over a deterministic walk — so the selfhost
// fixpoint (stage2 == stage3) is unaffected; reset per run anyway so a
// program's generated names never depend on what compiled before it.
let dtd_eq_tuple_uid = [0]

fn eq_tuple_uid_reset() -> Unit {
  Array::set(dtd_eq_tuple_uid, 0, 0)
}

fn eq_tuple_uid_next() -> Int {
  let v = Array::get(dtd_eq_tuple_uid, 0)
  Array::set(dtd_eq_tuple_uid, 0, v + 1)
  v
}

fn map_equals_name(k_ty: TypeExpr, v_ty: TypeExpr) -> String {
  String::concat(String::concat(String::concat("__map_equals__", type_key(k_ty)), "__"), type_key(v_ty))
}

// ---- #2218: structural `Map` equality ----
//
// `eq_for_typed` had no `Map` arm, so a `Map` reached the raw `==` and compared
// by reference. Measured before this: a `struct W { f: Map[String, Int] }` was
// the SINGLE outlier in a row of eleven declared field types -- `Int`,
// `String`, `Double`, `Bytes`, `Array[Int]`, `Array[Double]`, `Option[Int]`, a
// tuple and a declared struct all compared by content, and only `Map` answered
// `false` for two separately built equal maps. Nothing at the call site
// distinguished it.
//
// Same record-then-emit contract as `__arr_equals__<key>`: the site that BUILDS
// a call records the need, and `emit_recorded_map_equals` generates exactly the
// set the output references. Keyed by both type arguments because a program can
// hold `Map[String, Int]` and `Map[String, Array[Int]]` at once and they need
// different value comparisons.
let dtd_map_eq_needed: Array[TypeExpr] = empty_type_exprs()

let dtd_map_eq_needed_keys: Array[String] = empty_str_array()

fn map_eq_needed_reset() -> Unit {
  Array::truncate(dtd_map_eq_needed, 0)
  Array::truncate(dtd_map_eq_needed_keys, 0)
}

fn map_eq_needed_record(k_ty: TypeExpr, v_ty: TypeExpr) -> Unit {
  let nm = map_equals_name(k_ty, v_ty)
  if str_array_contains(dtd_map_eq_needed_keys, nm) {
    ()
  } else {
    Array::push(dtd_map_eq_needed_keys, nm)
    Array::push(dtd_map_eq_needed, TyTuple(Array::slice([k_ty, v_ty], 0, 2)))
  }
}

/// Generate every recorded `__map_equals__<k>__<v>` helper that does not
/// already exist. Runs after the rewrite loop, like `emit_recorded_arr_equals`,
/// and re-reads `Array::length` each turn for the same reason: a value type
/// that is itself a Map or an Array records ITS helper while this body is
/// built, so appending while walking is the worklist closure. It terminates
/// because the record dedups by name and each nested type is strictly
/// shallower.
fn emit_recorded_map_equals(stmts: Array[Stmt]) -> Unit {
  let known_types = collect_decl_type_names(stmts)
  let mut i = 0
  while i < Array::length(dtd_map_eq_needed) {
    let pair = Array::get(dtd_map_eq_needed, i)
    match pair {
      TyTuple(kv) => if Array::length(kv) == 2 {
        let k_ty = Array::get(kv, 0)
        let v_ty = Array::get(kv, 1)
        if top_level_fn_exists(stmts, map_equals_name(k_ty, v_ty)) {
          ()
        } else {
          Array::push(stmts, gen_map_equals_fn(k_ty, v_ty, known_types))
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// `let __map_equals__<k>__<v> = (a: Map[k, v], b: Map[k, v]) -> Bool { ... }`
///
/// Equal size plus "every key of `a` is in `b` with an equal value" is set
/// equality: with the sizes equal, a key of `b` missing from `a` would force a
/// key of `a` missing from `b`, which the loop catches.  The value comparison
/// goes through `eq_for_typed`, so `Map[String, Array[Int]]` and
/// `Map[String, SomeStruct]` recurse instead of identity-comparing.
///
/// The value compare is nested INSIDE the `has_key` test on purpose: `Map::get`
/// returns the raw stored value and `0` on a miss (see its checker comment), so
/// handing that `0` to a generated `V::equals` would read a non-value.
fn gen_map_equals_fn(k_ty: TypeExpr, v_ty: TypeExpr, known_types: Array[String]) -> Stmt {
  // Per-expansion binder names, from the counter the tuple arm already uses.
  // Fixed synthetic binders are what `scripts/review_lint.vibex` rejects, and
  // it is right to: the tuple arm carried fixed ones until a NESTED expansion
  // rebound them and the linear backend's match binding reused the shadowed
  // local, so the outer elements compared against clobbered slots (#1526). A
  // map body cannot nest inside another one today -- a Map-valued Map emits a
  // CALL to the inner helper, not an inline body -- but "cannot nest today" is
  // exactly the reasoning that was wrong before, and a unique name costs
  // nothing.
  let uid = idx_str(eq_tuple_uid_next())
  let n_k = String::concat("__me_k", uid)
  let n_ks = String::concat("__me_ks", uid)
  let n_i = String::concat("__me_i", uid)
  let n_ok = String::concat("__me_ok", uid)
  let size_a = ECall(EIdent("Map::size", -1), Array::slice([EIdent("a", -1)], 0, 1), -1)
  let size_b = ECall(EIdent("Map::size", -1), Array::slice([EIdent("b", -1)], 0, 1), -1)
  let val_a = ECall(EIdent("Map::get", -1), Array::slice([
    EIdent("a", -1),
    EIdent(n_k, -1)
  ], 0, 2), -1)
  let val_b = ECall(EIdent("Map::get", -1), Array::slice([
    EIdent("b", -1),
    EIdent(n_k, -1)
  ], 0, 2), -1)
  let val_eq = eq_for_typed(v_ty, val_a, val_b, known_types)
  let val_bad = EIf(ECall(EIdent("not", -1), Array::slice([val_eq], 0, 1), -1), EAssign(n_ok, EBool(false), EUnit), EUnit)
  let has_b = ECall(EIdent("Map::has_key", -1), Array::slice([
    EIdent("b", -1),
    EIdent(n_k, -1)
  ], 0, 2), -1)
  let check_one = EIf(ECall(EIdent("not", -1), Array::slice([has_b], 0, 1), -1), EAssign(n_ok, EBool(false), EUnit), val_bad)
  let incr = EAssign(n_i, EBinOp("+", EIdent(n_i, -1), EInt(1)), EUnit)
  let loop_body = ELet(n_k, ECall(EIdent("Array::get", -1), Array::slice([
    EIdent(n_ks, -1),
    EIdent(n_i, -1)
  ], 0, 2), -1), ESeq(check_one, incr), -1)
  let while_loop = EWhile(EBinOp("<", EIdent(n_i, -1), ECall(EIdent("Array::length", -1), Array::slice([
    EIdent(n_ks, -1)
  ], 0, 1), -1)), loop_body)
  let body_eq = ELet(n_ks, ECall(EIdent("Map::keys", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1), ELetMut(n_i, EInt(0), ELetMut(n_ok, EBool(true), ESeq(while_loop, EIdent(n_ok, -1)), -1), -1), -1)
  let body = EIf(EBinOp("!=", size_a, size_b), EBool(false), body_eq)
  let map_ty = TyApp("Map", Array::slice([k_ty, v_ty], 0, 2))
  let params = Array::slice([("a", Some(map_ty)), ("b", Some(map_ty))], 0, 2)
  let tparams = empty_str_array()
  collect_ty_var_names(k_ty, tparams)
  collect_ty_var_names(v_ty, tparams)
  let no_tb = array_empty()
  SLet(false, false, map_equals_name(k_ty, v_ty), None, EFn(tparams, no_tb, params, Some(TyName("Bool")), None, body))
}

fn bytes_equals_name() -> String {
  "__bytes_equals"
}

fn bytes_eq_needed_reset() -> Unit {
  Array::truncate(dtd_bytes_eq_needed, 0)
}

fn bytes_eq_needed_record() -> Unit {
  if Array::length(dtd_bytes_eq_needed) == 0 {
    Array::push(dtd_bytes_eq_needed, "Bytes")
  } else {
    ()
  }
}

/// `let __bytes_equals = (a: Bytes, b: Bytes) -> Bool { ... }` — length check
/// plus a byte loop, the `gen_arr_equals_fn` shape minus the element-type
/// recursion (a byte is an Int). Runs after `emit_recorded_arr_equals`, whose
/// generated bodies can themselves record this need (`Array[Bytes]` elements);
/// this body records nothing, so one pass closes the worklist.
fn emit_recorded_bytes_equals(stmts: Array[Stmt]) -> Unit {
  if Array::length(dtd_bytes_eq_needed) > 0 && !top_level_fn_exists(stmts, bytes_equals_name()) {
    let len_a = ECall(EIdent("Bytes::length", -1), Array::slice([
      EIdent("a", -1)
    ], 0, 1), -1)
    let len_b = ECall(EIdent("Bytes::length", -1), Array::slice([
      EIdent("b", -1)
    ], 0, 1), -1)
    let byte_a = ECall(EIdent("Bytes::get", -1), Array::slice([
      EIdent("a", -1),
      EIdent("__be_i", -1)
    ], 0, 2), -1)
    let byte_b = ECall(EIdent("Bytes::get", -1), Array::slice([
      EIdent("b", -1),
      EIdent("__be_i", -1)
    ], 0, 2), -1)
    let set_false = EIf(EBinOp("!=", byte_a, byte_b), EAssign("__be_ok", EBool(false), EUnit), EUnit)
    let incr = EAssign("__be_i", EBinOp("+", EIdent("__be_i", -1), EInt(1)), EUnit)
    let while_loop = EWhile(EBinOp("<", EIdent("__be_i", -1), ECall(EIdent("Bytes::length", -1), Array::slice([
      EIdent("a", -1)
    ], 0, 1), -1)), ESeq(set_false, incr))
    let body_eq = ELetMut("__be_i", EInt(0), ELetMut("__be_ok", EBool(true), ESeq(while_loop, EIdent("__be_ok", -1)), -1), -1)
    let body = EIf(EBinOp("!=", len_a, len_b), EBool(false), body_eq)
    let params = Array::slice([
      ("a", Some(TyName("Bytes"))),
      ("b", Some(TyName("Bytes")))
    ], 0, 2)
    let no_tp = array_empty()
    let no_tb = array_empty()
    Array::push(stmts, SLet(false, false, bytes_equals_name(), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, body)))
  } else {
    ()
  }
}

// ---- #1526 (ADR-0097): the `==` rewrite's declared-type list ----
//
// The bare-`==` shape dispatch below (`eq_var_shape_dispatch`) can surface
// USER type names (a struct/enum element of a let-bound tuple), unlike the
// #825 literal-only inference whose shapes never carry one — so it cannot
// pass `eq_for_typed` an empty `known_types` (that would identity-compare a
// struct element the codegen's own tuple walk compares structurally today).
// Filled once per `desugar_trait_dicts` run; every declared struct/enum has a
// generated `::equals` (see desugar_derives), so membership here is exactly
// "a direct `T::equals` call resolves".
let dtd_eq_known_types: Array[String] = empty_str_array()

/// Declared types that take type parameters. Membership identifies a type whose
/// concrete equality must preserve its arguments and use a specialized helper.
let dtd_eq_generic_types: Array[String] = empty_str_array()

// Concrete instantiations whose generated equality must retain type arguments.
// A single erased `Box::equals` cannot compare `T` structurally when `T` is an
// aggregate, so call sites record `Box[... ]` and a typed comparator is emitted
// after the rewrite, like the recorded Array comparators.
let dtd_eq_generic_structs: Array[(String, Array[String], Array[(String, TypeExpr)])] = array_empty()
let dtd_eq_type_aliases: Array[(String, Array[String], TypeExpr)] = array_empty()
// Source declarations that own a type spelling. This is deliberately
// separate from `dtd_eq_known_types`: effects do not have generated
// `T::equals` functions, but they still prevent a same-named compiler builtin
// from claiming their representation.
let dtd_eq_type_owners: Array[String] = empty_str_array()
let dtd_eq_specializations: Array[TypeExpr] = empty_type_exprs()
let dtd_eq_specialization_ancestries: Array[Array[TypeExpr]] = array_empty()
let dtd_eq_specialization_stack: Array[TypeExpr] = empty_type_exprs()

fn generic_eq_struct_declared(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(dtd_eq_generic_structs) {
    if Array::get(dtd_eq_generic_structs, i).0 == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The compiler-owned spelling applies only when source does not own the name.
fn builtin_string_map_applied(name: String, args: Array[TypeExpr]) -> Bool {
  name == "StringMap" && Array::length(args) == 1 && !str_array_contains(dtd_eq_type_owners, name)
}

/// Declared types with a field this pass cannot show is compared by content,
/// transitively. Generic instantiations now use concrete specialized
/// comparators (#2195), and Map has a structural arm (#2218). A nominal opaque
/// type such as `StringBuilder` still lands here.
///
/// Both are pre-existing and reachable without any array; what this table
/// prevents is an unannotated binding ADOPTING such a name and arriving there
/// Type aliases take part so an unsupported target cannot be laundered past a
/// field. Conservative in one direction only: an unproved name costs a trap.
let dtd_eq_unsafe_types: Array[String] = empty_str_array()

fn eq_known_types_reset(stmts: Array[Stmt]) -> Unit {
  Array::truncate(dtd_eq_known_types, 0)
  Array::truncate(dtd_eq_generic_types, 0)
  Array::truncate(dtd_eq_unsafe_types, 0)
  Array::truncate(dtd_eq_generic_structs, 0)
  Array::truncate(dtd_eq_type_aliases, 0)
  Array::truncate(dtd_eq_type_owners, 0)
  Array::truncate(dtd_eq_specializations, 0)
  Array::truncate(dtd_eq_specialization_ancestries, 0)
  Array::truncate(dtd_eq_specialization_stack, 0)
  let names = collect_decl_type_names(stmts)
  let mut i = 0
  while i < Array::length(names) {
    Array::push(dtd_eq_known_types, Array::get(names, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(stmts) {
    match Array::get(stmts, j) {
      SStruct(_, sname, fields, _, _, decl_tparams) => {
        Array::push(dtd_eq_type_owners, sname)
        if Array::length(decl_tparams) > 0 {
          Array::push(dtd_eq_generic_types, sname)
          Array::push(dtd_eq_generic_structs, (sname, decl_tparams, fields))
        } else {
          ()
        }
      },
      SEnum(_, ename, decl_tparams, _, _) => {
        Array::push(dtd_eq_type_owners, ename)
        if Array::length(decl_tparams) > 0 {
          Array::push(dtd_eq_generic_types, ename)
        } else {
          ()
        }
      },
      SSuberror(_, name, _) => Array::push(dtd_eq_type_owners, name),
      STypeAlias(_, aname, alias_tparams, target) => {
        Array::push(dtd_eq_type_owners, aname)
        Array::push(dtd_eq_type_aliases, (aname, alias_tparams, target))
      },
      SEffectDef(_, name, _, _) => Array::push(dtd_eq_type_owners, name),
      _ => ()
    }
    j = j + 1
  }
  eq_unsafe_types_fill(stmts)
}

/// Least fixpoint of "this declared name has a field this pass cannot show is
/// compared by content". One pass can only see the names
/// already marked, so `struct Deep { o: Outer }` needs a second one; the loop
/// runs until a pass adds nothing, bounded by the number of declarations
/// because each pass that changes anything adds at least one name.
fn eq_unsafe_types_fill(stmts: Array[Stmt]) -> Unit {
  let mut rounds = 0
  let mut changed = true
  while changed && rounds <= Array::length(stmts) {
    changed = false
    let mut j = 0
    while j < Array::length(stmts) {
      match Array::get(stmts, j) {
        SStruct(_, sname, fields, _, _, decl_tparams) => if !str_array_contains(dtd_eq_unsafe_types, sname) {
          let mut fi = 0
          let mut bad = false
          while fi < Array::length(fields) {
            if !eq_ty_field_is_content_comparable(Array::get(fields, fi).1, decl_tparams) {
              bad = true
            } else {
              ()
            }
            fi = fi + 1
          }
          if bad {
            Array::push(dtd_eq_unsafe_types, sname)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        SEnum(_, ename, enum_tparams, variants, _) => if !str_array_contains(dtd_eq_unsafe_types, ename) {
          let mut vi = 0
          let mut bad = false
          while vi < Array::length(variants) {
            let payload = Array::get(variants, vi).1
            let mut pi = 0
            while pi < Array::length(payload) {
              if !eq_ty_field_is_content_comparable(Array::get(payload, pi), enum_tparams) {
                bad = true
              } else {
                ()
              }
              pi = pi + 1
            }
            vi = vi + 1
          }
          if bad {
            Array::push(dtd_eq_unsafe_types, ename)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        STypeAlias(_, aname, alias_tparams, target) => if !str_array_contains(dtd_eq_unsafe_types, aname) {
          if !eq_ty_field_is_content_comparable(target, alias_tparams) {
            Array::push(dtd_eq_unsafe_types, aname)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        _ => ()
      }
      j = j + 1
    }
    rounds = rounds + 1
  }
}

/// Does the comparator generated for a field of this DECLARED type compare
/// content? The walk that fills `dtd_eq_unsafe_types` asks this of every field,
/// and it is an allow-list on purpose: a head this pass has not measured
/// answers `false` and costs its owner a trap, which is the direction the
/// triage order wants. It started as a deny-list naming the generic heads, and
/// `Map` walked straight through it (#2192 review) -- `eq_for_typed` has no
/// structural `Map` arm, so it falls back to a raw `==` and two equal maps
/// answer `false`.
///
/// Measured on one build, a `struct W { f: T } derive (Eq)` pushed onto two
/// unannotated empty bindings, values built separately so identity and content
/// disagree:
///
///   | field type | `==` |
///   |---|---|
///   | `Int` / `String` / `Double` / `Bytes` | true |
///   | `Array[Int]` / `Array[Double]` | true |
///   | `Option[Int]` | true |
///   | `(Int, String)` | true |
///   | a declared struct | true |
///   | `Map[String, Int]` | true, since #2218 |
///
/// A declared or concretely-specialized `Double` or `Bytes` field is fine --
/// both generate a type-directed comparison. Generic fields retain their
/// concrete arguments through specialized comparators (#2195). A nominal
/// opaque type still reaches the raw-`==` fallback and is rejected
/// by the same clause -- a `StringBuilder` field is neither scalar nor a
/// declared struct here, so its owner is unsafe.
///
/// `Map` was the single outlier in that table until #2218 gave `eq_for_typed`
/// a `Map` arm. It is admitted here for the same reason `Array` is: there is
/// now a generated comparator that descends into it.
fn eq_tparams_contain_name(tparams: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(tparams) && !found {
    if type_param_name(Array::get(tparams, i)) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn eq_ty_field_is_content_comparable(t: TypeExpr, tparams: Array[String]) -> Bool {
  // A field written as the owner's own parameter is not the same-spelled
  // alias, even when one exists in the program (#2281).
  match t {
    TyName(n) => if eq_tparams_contain_name(tparams, n) {
      true
    } else {
      eq_ty_field_is_content_comparable_expanded(eq_expand_alias_ty(t), tparams)
    },
    _ => eq_ty_field_is_content_comparable_expanded(eq_expand_alias_ty(t), tparams)
  }
}

fn eq_ty_field_is_content_comparable_expanded(t: TypeExpr, tparams: Array[String]) -> Bool {
  match t {
    TyName(n) => if eq_tparams_contain_name(tparams, n) {
      // The owner's own type parameter is resolved by the concrete specialized
      // comparator, so it is not a declaration-level failure.
      true
    } else if str_array_contains(dtd_eq_generic_types, n) || str_array_contains(dtd_eq_unsafe_types, n) {
      // A bare generic name says nothing about its arguments.
      false
    } else {
      is_scalar_type_name(n) || str_array_contains(dtd_eq_known_types, n)
    },
    TyApp(head, args) => if str_array_contains(dtd_eq_unsafe_types, head) {
      false
    } else {
      let args_ok = eq_tys_all_content_comparable(args, tparams)
      if eq_tparams_contain_name(tparams, head) {
        args_ok
      } else if head == "Array" && Array::length(args) == 1 || head == "Option" && Array::length(args) == 1 || head == "Result" && Array::length(args) == 2 || head == "Map" && Array::length(args) == 2 || builtin_string_map_applied(head, args) {
        // The heads `eq_for_typed` has a structural arm for. The arity is part
        // of the condition: a head applied to the wrong number of arguments is
        // not the builtin this admits.
        args_ok
      } else if str_array_contains(dtd_eq_known_types, head) && !str_array_contains(dtd_eq_generic_types, head) {
        args_ok
      } else {
        // Concrete declared generic instantiations get a comparator specialized
        // with these arguments. Unknown heads (Map included) remain fail-closed.
        generic_eq_struct_declared(head) && generic_eq_observed_args_content_comparable(head, args, tparams)
      }
    },
    TyTuple(ts) => eq_tys_all_content_comparable(ts, tparams),
    // `()` and `Unit` name the same type and must answer the same. They do not
    // arrive the same way: `u: Unit` is a `TyName` the arm above already
    // admits, `u: ()` is `TyUnit`, and while it fell to a catch-all the second
    // spelling trapped where the first answered (#2192 review, measured -- the
    // annotated `Array[U]` answers `true` for both).
    TyUnit => true,
    // A closure field is compared by identity, which is the only equality a
    // function has. Rejecting it costs a trap on a shape nobody writes; the
    // alternative is adopting a name whose `::equals` answers by reference,
    // and the caller cannot tell the two apart from the outside.
    TyFn(_, _, _) => false
  }
}

fn generic_eq_formal_is_observed(head: String, formal: String, visiting: Array[String]) -> Bool {
  let key = String::concat(head, String::concat("::", formal))
  if str_array_contains(visiting, key) {
    false
  } else {
    Array::push(visiting, key)
    let mut observed = false
    let mut i = 0
    while i < Array::length(dtd_eq_generic_structs) {
      let decl = Array::get(dtd_eq_generic_structs, i)
      if decl.0 == head {
        let mut fi = 0
        while fi < Array::length(decl.2) {
          if generic_eq_type_observes_formal(Array::get(decl.2, fi).1, formal, visiting) {
            observed = true
          } else {
            ()
          }
          fi = fi + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
    Array::truncate(visiting, Array::length(visiting) - 1)
    observed
  }
}

fn generic_eq_type_observes_formal(ty: TypeExpr, formal: String, visiting: Array[String]) -> Bool {
  match ty {
    TyName(name) => name == formal || name == type_param_name(formal),
    TyApp(head, args) => if head == type_param_name(formal) {
      true
    } else if generic_eq_struct_declared(head) {
      let mut observed = false
      let mut i = 0
      while i < Array::length(dtd_eq_generic_structs) {
        let decl = Array::get(dtd_eq_generic_structs, i)
        if decl.0 == head && Array::length(decl.1) == Array::length(args) {
          let mut ai = 0
          while ai < Array::length(args) {
            if generic_eq_formal_is_observed(head, Array::get(decl.1, ai), visiting) && generic_eq_type_observes_formal(Array::get(args, ai), formal, visiting) {
              observed = true
            } else {
              ()
            }
            ai = ai + 1
          }
        } else {
          ()
        }
        i = i + 1
      }
      observed
    } else {
      ty_mentions_name_in(ty, Array::slice([formal], 0, 1))
    },
    TyFn(_, _, _) => ty_mentions_name_in(ty, Array::slice([formal], 0, 1)),
    TyTuple(_) => ty_mentions_name_in(ty, Array::slice([formal], 0, 1)),
    TyUnit => false
  }
}

fn generic_eq_observed_args_content_comparable(head: String, args: Array[TypeExpr], tparams: Array[String]) -> Bool {
  let mut ok = false
  let mut i = 0
  while i < Array::length(dtd_eq_generic_structs) {
    let decl = Array::get(dtd_eq_generic_structs, i)
    if decl.0 == head && Array::length(decl.1) == Array::length(args) {
      ok = true
      let mut ai = 0
      while ai < Array::length(args) {
        if generic_eq_formal_is_observed(head, Array::get(decl.1, ai), empty_str_array()) && !eq_ty_field_is_content_comparable(Array::get(args, ai), tparams) {
          ok = false
        } else {
          ()
        }
        ai = ai + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn eq_tys_all_content_comparable(ts: Array[TypeExpr], tparams: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(ts) {
    if !eq_ty_field_is_content_comparable(Array::get(ts, i), tparams) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Structural equality match for two Option operands whose element type is NOT
/// statically known here (bare `==` dispatch on Option-typed variables). Some
/// payloads compare with `==` (correct for scalars); a None matches a None.
/// (#695.)
fn opt_eq_match(lhs: Expr, rhs: Expr) -> Expr {
  let some_inner = EMatch(rhs, Array::slice([
    (PCtor("Some", Array::slice([PBind("__oeq_r")], 0, 1)), EBinOp("==", EIdent("__oeq_l", -1), EIdent("__oeq_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  let none_inner = EMatch(rhs, Array::slice([
    (PCtor("None", array_empty()), EBool(true)),
    (PWild, EBool(false))
  ], 0, 2))
  EMatch(lhs, Array::slice([
    (PCtor("Some", Array::slice([PBind("__oeq_l")], 0, 1)), some_inner),
    (PCtor("None", array_empty()), none_inner)
  ], 0, 2))
}

/// Structural equality match for two Result operands of statically-unknown
/// element types (bare `==` dispatch). (#695.)
fn result_eq_match(lhs: Expr, rhs: Expr) -> Expr {
  let ok_inner = EMatch(rhs, Array::slice([
    (PCtor("Ok", Array::slice([PBind("__req_r")], 0, 1)), EBinOp("==", EIdent("__req_l", -1), EIdent("__req_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  let err_inner = EMatch(rhs, Array::slice([
    (PCtor("Err", Array::slice([PBind("__req_r")], 0, 1)), EBinOp("==", EIdent("__req_l", -1), EIdent("__req_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  EMatch(lhs, Array::slice([
    (PCtor("Ok", Array::slice([PBind("__req_l")], 0, 1)), ok_inner),
    (PCtor("Err", Array::slice([PBind("__req_l")], 0, 1)), err_inner)
  ], 0, 2))
}

fn generic_eq_key_part(value: String) -> String {
  String::concat(idx_str(String::length(value)), String::concat("_", value))
}

/// An injective, fn-name-safe structural encoding for generic equality
/// specializations. Length prefixes keep names such as `Array_Int` distinct
/// from applications such as `Array[Int]`.
fn generic_eq_type_key(ty: TypeExpr) -> String {
  match ty {
    TyName(name) => String::concat("N", generic_eq_key_part(name)),
    TyApp(head, args) => {
      let mut key = String::concat("A", generic_eq_key_part(head))
      key = String::concat(key, String::concat("C", idx_str(Array::length(args))))
      let mut i = 0
      while i < Array::length(args) {
        key = String::concat(key, generic_eq_type_key(Array::get(args, i)))
        i = i + 1
      }
      key
    },
    TyFn(params, result, effect) => {
      let mut key = String::concat("F", idx_str(Array::length(params)))
      let mut i = 0
      while i < Array::length(params) {
        key = String::concat(key, generic_eq_type_key(Array::get(params, i)))
        i = i + 1
      }
      key = String::concat(key, String::concat("R", generic_eq_type_key(result)))
      match effect {
        Some(name) => String::concat(key, String::concat("E", generic_eq_key_part(name))),
        None => String::concat(key, "Z")
      }
    },
    TyTuple(items) => {
      let mut key = String::concat("T", idx_str(Array::length(items)))
      let mut i = 0
      while i < Array::length(items) {
        key = String::concat(key, generic_eq_type_key(Array::get(items, i)))
        i = i + 1
      }
      key
    },
    TyUnit => "U"
  }
}

fn generic_eq_name(head: String, args: Array[TypeExpr]) -> String {
  let mut name = String::concat(head, "::equals")
  let mut i = 0
  while i < Array::length(args) {
    name = String::concat(name, String::concat("__", generic_eq_type_key(Array::get(args, i))))
    i = i + 1
  }
  name
}

fn generic_eq_type_size(ty: TypeExpr) -> Int {
  match ty {
    TyName(_) => 1,
    TyApp(_, args) => 1 + generic_eq_types_size(args),
    TyFn(params, result, _) => 1 + generic_eq_types_size(params) + generic_eq_type_size(result),
    TyTuple(items) => 1 + generic_eq_types_size(items),
    TyUnit => 1
  }
}

fn generic_eq_types_size(types: Array[TypeExpr]) -> Int {
  let mut size = 0
  let mut i = 0
  while i < Array::length(types) {
    size = size + generic_eq_type_size(Array::get(types, i))
    i = i + 1
  }
  size
}

fn generic_eq_graph_types_are_finite(types: Array[TypeExpr], visiting: Array[TypeExpr], done: Array[String]) -> Bool {
  let mut i = 0
  let mut finite = true
  while i < Array::length(types) {
    if !generic_eq_graph_type_is_finite(Array::get(types, i), visiting, done) {
      finite = false
    } else {
      ()
    }
    i = i + 1
  }
  finite
}

fn generic_eq_graph_type_is_finite(ty: TypeExpr, visiting: Array[TypeExpr], done: Array[String]) -> Bool {
  match ty {
    TyName(_) => true,
    TyApp(head, args) => if generic_eq_struct_declared(head) && Array::length(args) > 0 {
      let canonical_args = for arg in args {
        eq_expand_alias_ty(arg)
      }
      generic_eq_graph_node_is_finite(head, canonical_args, visiting, done)
    } else {
      generic_eq_graph_types_are_finite(args, visiting, done)
    },
    TyFn(params, result, _) => generic_eq_graph_types_are_finite(params, visiting, done) && generic_eq_graph_type_is_finite(result, visiting, done),
    TyTuple(items) => generic_eq_graph_types_are_finite(items, visiting, done),
    TyUnit => true
  }
}

/// Prove that every specialized-comparator edge reachable from this node is
/// finite. Exact cycles are valid; revisiting a head with larger arguments on
/// the active path proves non-regular growth. Walking every field prevents a
/// regular self-edge from hiding a growing edge through this or another head.
fn generic_eq_graph_node_is_finite(head: String, args: Array[TypeExpr], visiting: Array[TypeExpr], done: Array[String]) -> Bool {
  let key = generic_eq_name(head, args)
  let mut i = 0
  let mut exact = false
  let mut growing = false
  while i < Array::length(visiting) {
    match Array::get(visiting, i) {
      TyApp(active_head, active_args) => if generic_eq_name(active_head, active_args) == key {
        exact = true
      } else if active_head == head && generic_eq_types_size(args) > generic_eq_types_size(active_args) {
        growing = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if exact {
    true
  } else if growing {
    false
  } else if str_array_contains(done, key) {
    true
  } else {
    Array::push(visiting, TyApp(head, args))
    let mut finite = true
    let mut di = 0
    while di < Array::length(dtd_eq_generic_structs) {
      let decl = Array::get(dtd_eq_generic_structs, di)
      if decl.0 == head && Array::length(decl.1) == Array::length(args) {
        let mut fi = 0
        while fi < Array::length(decl.2) {
          let field_ty = eq_expand_alias_ty(eq_subst_ty(Array::get(decl.2, fi).1, decl.1, args))
          if !generic_eq_graph_type_is_finite(field_ty, visiting, done) {
            finite = false
          } else {
            ()
          }
          fi = fi + 1
        }
      } else {
        ()
      }
      di = di + 1
    }
    Array::truncate(visiting, Array::length(visiting) - 1)
    if finite {
      Array::push(done, key)
    } else {
      ()
    }
    finite
  }
}

fn generic_eq_specialization_graph_is_finite(head: String, args: Array[TypeExpr]) -> Bool {
  generic_eq_graph_node_is_finite(head, args, empty_type_exprs(), empty_str_array())
}

/// Non-regular recursion such as `Loop[T] -> Loop[Array[T]]` grows the
/// specialization worklist forever. A larger specialization is allowed only
/// when its own fields close back over that exact specialization, as in
/// `Stable[T] -> Stable[Array[Int]]`. An exact active specialization also
/// proves that the worklist is finite.
fn generic_eq_is_expanding_recursion(head: String, args: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut exact = false
  let mut has_active = false
  while i < Array::length(dtd_eq_specialization_stack) {
    has_active = true
    match Array::get(dtd_eq_specialization_stack, i) {
      TyApp(active_head, active_args) => if active_head == head {
        if generic_eq_name(active_head, active_args) == generic_eq_name(head, args) {
          exact = true
        } else {
          ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  has_active && !exact && !generic_eq_specialization_graph_is_finite(head, args)
}

fn generic_eq_record(head: String, args: Array[TypeExpr]) -> Unit {
  let key = generic_eq_name(head, args)
  let mut i = 0
  let mut found = false
  while i < Array::length(dtd_eq_specializations) {
    match Array::get(dtd_eq_specializations, i) {
      TyApp(h, as_) => if generic_eq_name(h, as_) == key {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if !found {
    Array::push(dtd_eq_specializations, TyApp(head, args))
    Array::push(dtd_eq_specialization_ancestries, for item in dtd_eq_specialization_stack {
      item
    })
  } else {
    ()
  }
}

fn eq_ty_has_formal(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => is_marked_formal_name(n) || formal_in_scope(n),
    TyApp(_, xs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(xs) {
        if eq_ty_has_formal(Array::get(xs, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(xs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(xs) {
        if eq_ty_has_formal(Array::get(xs, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// Equality of two operands whose declared type is `fty`. Fully type-directed:
///   - scalar `TyName` -> raw `==`
///   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`
///   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads
///   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs
///   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`
///   - anything else -> raw `==` (status quo fallback)
/// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so
/// structural equality MUST be resolved here at the AST level where the static
/// type is known. (#695.)
fn eq_for_typed(fty0: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  // #2141 (Codex round on #2183): re-spell in-scope formals for the WHOLE
  // type at the entry, not per-arm -- a composite shape reaching typed-eq
  // dispatch at rewrite time must never leave a sibling `TyName(<formal>)`
  // unmarked for the `known_types` arm below. Measured: no current channel
  // feeds such a shape (annotation shapes mentioning tparams are skipped at
  // seed_var_types / collect_fn_eq_return_shape), so today this subsumes the
  // Array-arm re-spelling; at generation time the scope stack is empty and
  // this is the identity.
  let fty = eq_expand_alias_ty(subst_scope_formals_ty(fty0))
  match fty {
    TyName(n) => if n == "__EqAliasCycle" {
      ESeq(ECall(EIdent("assert_true", -1), Array::slice([EBool(false)], 0, 1), -1), EBool(false))
    } else if n == "Double" || n == "Float" {
      // Under RC a Double is a BOXED heap value, so a raw `==` between two
      // Double fields compares box identity (always false) instead of the f64
      // payload. Wrap each operand in the identity `Double::to_float` so the
      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and
      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where
      // the wrapper is identity and the float branch compares raw bits (#704).
      EBinOp("==", ECall(EIdent("Double::to_float", -1), Array::slice([lhs], 0, 1), -1), ECall(EIdent("Double::to_float", -1), Array::slice([
        rhs
      ], 0, 1), -1))
    } else if n == "Bytes" {
      // #1526 (ADR-0097): `Bytes` is byte content, not an address — compare it
      // structurally wherever a declared type says Bytes (struct/enum fields,
      // tuple elements, Array[Bytes] elements). `is_scalar_type_name` lists
      // "Bytes", so this must answer before the scalar fallthrough below.
      bytes_eq_needed_record()
      ECall(EIdent(bytes_equals_name(), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let t = Array::get(args, 0)
      let inner_eq = eq_for_typed(t, EIdent("__oeq_l", -1), EIdent("__oeq_r", -1), known_types)
      let some_inner = EMatch(rhs, Array::slice([
        (PCtor("Some", Array::slice([PBind("__oeq_r")], 0, 1)), inner_eq),
        (PWild, EBool(false))
      ], 0, 2))
      let none_inner = EMatch(rhs, Array::slice([
        (PCtor("None", array_empty()), EBool(true)),
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Some", Array::slice([PBind("__oeq_l")], 0, 1)), some_inner),
        (PCtor("None", array_empty()), none_inner)
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let t = Array::get(args, 0)
      let e = Array::get(args, 1)
      let ok_eq = eq_for_typed(t, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let err_eq = eq_for_typed(e, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let ok_inner = EMatch(rhs, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__req_r")], 0, 1)), ok_eq),
        (PWild, EBool(false))
      ], 0, 2))
      let err_inner = EMatch(rhs, Array::slice([
        (PCtor("Err", Array::slice([PBind("__req_r")], 0, 1)), err_eq),
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__req_l")], 0, 1)), ok_inner),
        (PCtor("Err", Array::slice([PBind("__req_l")], 0, 1)), err_inner)
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyTuple(ts) => {
      // #1526: binder names carry a per-expansion uid. A NESTED tuple used to
      // rebind the same `__teq_l<j>` names, and the outer elements compared
      // AFTER the nested one then read the clobbered slots on the linear
      // backend (its match-binding reuses the local of a shadowed name — the
      // shadow-clobber bug, filed separately): `((1,[2,3]),"x")` compared its
      // own inner elements against each other and answered false. Unique names
      // make the emitted compare independent of shadowing semantics.
      let uid = eq_tuple_uid_next()
      let lpfx = String::concat(String::concat("__teq_l", idx_str(uid)), "_")
      let rpfx = String::concat(String::concat("__teq_r", idx_str(uid)), "_")
      let n = Array::length(ts)
      let lpats = array_empty()
      let rpats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(lpats, PBind(String::concat(lpfx, idx_str(i))))
        Array::push(rpats, PBind(String::concat(rpfx, idx_str(i))))
        i = i + 1
      }
      let mut conj = EBool(true)
      let mut j = n - 1
      while j >= 0 {
        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(lpfx, idx_str(j)), -1), EIdent(String::concat(rpfx, idx_str(j)), -1), known_types)
        conj = EBinOp("&&", cmp, conj)
        j = j - 1
      }
      let inner = EMatch(rhs, Array::slice([(PTuple(rpats), conj)], 0, 1))
      EMatch(lhs, Array::slice([(PTuple(lpats), inner)], 0, 1))
    },
    TyApp("StringMap", args) => if builtin_string_map_applied("StringMap", args) {
      let value_ty = Array::get(args, 0)
      map_eq_needed_record(TyName("String"), value_ty)
      ECall(EIdent(map_equals_name(TyName("String"), value_ty), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Map", args) => if Array::length(args) == 2 {
      // #2218: the only site that builds a `__map_equals__` call.
      map_eq_needed_record(Array::get(args, 0), Array::get(args, 1))
      ECall(EIdent(map_equals_name(Array::get(args, 0), Array::get(args, 1)), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      // #1526: the second (and last) site that references a helper.
      // #2141: the entry re-spelling above already marked any in-scope formal
      // in this element type.
      arr_eq_needed_record(Array::get(args, 0))
      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp(n, args) => if generic_eq_struct_declared(n) && Array::length(args) > 0 && !eq_ty_has_formal(fty) {
      let canonical_args = for arg in args {
        eq_expand_alias_ty(arg)
      }
      if generic_eq_is_expanding_recursion(n, canonical_args) {
        ESeq(ECall(EIdent("assert_true", -1), Array::slice([EBool(false)], 0, 1), -1), EBool(false))
      } else {
        generic_eq_record(n, canonical_args)
        ECall(EIdent(generic_eq_name(n, canonical_args), -1), Array::slice([
          lhs,
          rhs
        ], 0, 2), -1)
      }
    } else if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    _ => EBinOp("==", lhs, rhs)
  }
}

/// `let __arr_equals__<key> = (a: Array[t], b: Array[t]) -> Bool { ... }` — a
/// monomorphic, fully-recursive array structural equality. Element compare goes
/// through `eq_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse
/// correctly instead of identity-comparing aggregate elements. (#695.) When `t`
/// is a type variable the helper is generic over it — `[T](a: Array[T], b:
/// Array[T])` — instead of naming a `T` nothing binds; see the
/// `dtd_type_param_names` block above (#2136).
fn gen_arr_equals_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {
  let len_a = ECall(EIdent("Array::length", -1), Array::slice([EIdent("a", -1)], 0, 1), -1)
  let len_b = ECall(EIdent("Array::length", -1), Array::slice([EIdent("b", -1)], 0, 1), -1)
  let elem_a = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("a", -1),
    EIdent("__ae_i", -1)
  ], 0, 2), -1)
  let elem_b = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("b", -1),
    EIdent("__ae_i", -1)
  ], 0, 2), -1)
  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)
  let not_eq = ECall(EIdent("not", -1), Array::slice([elem_eq], 0, 1), -1)
  let set_false = EIf(not_eq, EAssign("__ae_ok", EBool(false), EUnit), EUnit)
  let incr = EAssign("__ae_i", EBinOp("+", EIdent("__ae_i", -1), EInt(1)), EUnit)
  let loop_body = ESeq(set_false, incr)
  let while_loop = EWhile(EBinOp("<", EIdent("__ae_i", -1), ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1)), loop_body)
  let body_eq = ELetMut("__ae_i", EInt(0), ELetMut("__ae_ok", EBool(true), ESeq(while_loop, EIdent("__ae_ok", -1)), -1), -1)
  let body = EIf(EBinOp("!=", len_a, len_b), EBool(false), body_eq)
  let arr_ty = TyApp("Array", Array::slice([elem_ty], 0, 1))
  let params = Array::slice([("a", Some(arr_ty)), ("b", Some(arr_ty))], 0, 2)
  let tparams = arr_helper_tparams(elem_ty)
  let no_tb = array_empty()
  SLet(false, false, arr_equals_name(elem_ty), None, EFn(tparams, no_tb, params, Some(TyName("Bool")), None, body))
}

/// One field's equality expression: `a.f == b.f` for scalar/param fields, or a
/// direct `FieldType::equals(a.f, b.f)` for aggregate (declared struct/enum)
/// fields so nested/recursive structs compare structurally. (#672 recursion.)
fn field_eq_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {
  eq_for_typed(fty, EDot(EIdent("a", -1), fname, -1, -1), EDot(EIdent("b", -1), fname, -1, -1), known_types)
}

/// `let P::equals = (a: P, b: P) -> Bool { a.x == b.x && a.y == b.y && ... }`
/// Mirrors gen_compare_fn. Primitive fields compare with `==`; aggregate fields
/// recurse through the field type's generated `equals`. An empty struct is `true`.
fn gen_eq_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let mut body = EBool(true)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, fty) = Array::get(fields, i)
    body = EBinOp("&&", field_eq_expr(fname, fty, known_types), body)
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "equals"), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, body))
}

fn eq_subst_lookup(params: Array[String], args: Array[TypeExpr], n: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut found = None
  while i < Array::length(params) && i < Array::length(args) {
    if type_param_name(Array::get(params, i)) == type_param_name(n) {
      found = Some(Array::get(args, i))
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn eq_subst_ty(ty: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match ty {
    TyName(n) => match eq_subst_lookup(params, args, n) {
      Some(arg) => arg,
      None => ty
    },
    TyApp(n, xs) => {
      let subst_xs = for x in xs {
        eq_subst_ty(x, params, args)
      }
      match eq_subst_lookup(params, args, n) {
        Some(TyName(hn)) => TyApp(hn, subst_xs),
        Some(TyApp(hn, _)) => TyApp(hn, subst_xs),
        Some(_) => TyApp(n, subst_xs),
        None => TyApp(n, subst_xs)
      }
    },
    TyFn(ps, result, effect) => TyFn(for p in ps {
      eq_subst_ty(p, params, args)
    }, eq_subst_ty(result, params, args), effect),
    TyTuple(xs) => TyTuple(for x in xs {
      eq_subst_ty(x, params, args)
    }),
    _ => ty
  }
}

fn eq_alias_name_exists(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(dtd_eq_type_aliases) {
    if Array::get(dtd_eq_type_aliases, i).0 == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn eq_ty_mentions_alias(ty: TypeExpr) -> Bool {
  match ty {
    TyName(name) => eq_alias_name_exists(name),
    TyApp(head, args) => if eq_alias_name_exists(head) {
      true
    } else {
      eq_tys_mention_alias(args)
    },
    TyFn(params, result, _) => if eq_tys_mention_alias(params) {
      true
    } else {
      eq_ty_mentions_alias(result)
    },
    TyTuple(items) => eq_tys_mention_alias(items),
    TyUnit => false
  }
}

fn eq_tys_mention_alias(ts: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) {
    if eq_ty_mentions_alias(Array::get(ts, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn eq_expand_alias_ty(ty: TypeExpr) -> TypeExpr {
  if Array::length(dtd_eq_type_aliases) == 0 {
    ty
  } else if !eq_ty_mentions_alias(ty) {
    ty
  } else {
    eq_expand_alias_ty_seen(ty, array_empty())
  }
}

fn eq_expand_alias_ty_seen(ty: TypeExpr, seen: Array[String]) -> TypeExpr {
  match ty {
    TyName(name) => eq_expand_alias_app(name, array_empty(), ty, seen),
    TyApp(head, args) => {
      let expanded_args = for arg in args {
        eq_expand_alias_ty_seen(arg, seen)
      }
      eq_expand_alias_app(head, expanded_args, TyApp(head, expanded_args), seen)
    },
    TyFn(params, result, effect) => TyFn(for param in params {
      eq_expand_alias_ty_seen(param, seen)
    }, eq_expand_alias_ty_seen(result, seen), effect),
    TyTuple(items) => TyTuple(for item in items {
      eq_expand_alias_ty_seen(item, seen)
    }),
    TyUnit => TyUnit
  }
}

fn eq_expand_alias_app(head: String, args: Array[TypeExpr], fallback: TypeExpr, seen: Array[String]) -> TypeExpr {
  let mut i = 0
  let mut out = fallback
  let mut found = false
  while i < Array::length(dtd_eq_type_aliases) {
    let alias = Array::get(dtd_eq_type_aliases, i)
    if !found && alias.0 == head && Array::length(alias.1) == Array::length(args) {
      if str_array_contains(seen, head) {
        out = TyName("__EqAliasCycle")
      } else {
        let next_seen = for item in seen {
          item
        }
        Array::push(next_seen, head)
        out = eq_expand_alias_ty_seen(eq_subst_ty(alias.2, alias.1, args), next_seen)
      }
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn gen_specialized_eq_fn(head: String, args: Array[TypeExpr], params0: Array[String], fields0: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let fields = for field in fields0 {
    (field.0, eq_expand_alias_ty(eq_subst_ty(field.1, params0, args)))
  }
  Array::push(dtd_eq_specialization_stack, TyApp(head, args))
  let mut body = EBool(true)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let field = Array::get(fields, i)
    body = EBinOp("&&", field_eq_expr(field.0, field.1, known_types), body)
    i = i - 1
  }
  let inst = TyApp(head, args)
  let ps = Array::slice([("a", Some(inst)), ("b", Some(inst))], 0, 2)
  let stmt = SLet(false, false, generic_eq_name(head, args), None, EFn(array_empty(), array_empty(), ps, Some(TyName("Bool")), None, body))
  Array::truncate(dtd_eq_specialization_stack, Array::length(dtd_eq_specialization_stack) - 1)
  stmt
}

fn emit_recorded_generic_eq(stmts: Array[Stmt]) -> Unit {
  let known = collect_decl_type_names(stmts)
  let mut i = 0
  // Generation can record nested generic instantiations, so re-read length.
  while i < Array::length(dtd_eq_specializations) {
    match Array::get(dtd_eq_specializations, i) {
      TyApp(head, args) => {
        let mut j = 0
        while j < Array::length(dtd_eq_generic_structs) {
          let decl = Array::get(dtd_eq_generic_structs, j)
          if decl.0 == head && !top_level_fn_exists(stmts, generic_eq_name(head, args)) {
            Array::truncate(dtd_eq_specialization_stack, 0)
            if i < Array::length(dtd_eq_specialization_ancestries) {
              for ancestor in Array::get(dtd_eq_specialization_ancestries, i) {
                Array::push(dtd_eq_specialization_stack, ancestor)
              }
            } else {
              ()
            }
            Array::push(stmts, gen_specialized_eq_fn(head, args, decl.1, decl.2, known))
            Array::truncate(dtd_eq_specialization_stack, 0)
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn emit_recorded_structural_eq(stmts: Array[Stmt]) -> Unit {
  let mut prev_arrays = 0 - 1
  let mut prev_maps = 0 - 1
  let mut prev_generics = 0 - 1
  while prev_arrays != Array::length(dtd_arr_eq_needed) || prev_maps != Array::length(dtd_map_eq_needed) || prev_generics != Array::length(dtd_eq_specializations) {
    prev_arrays = Array::length(dtd_arr_eq_needed)
    prev_maps = Array::length(dtd_map_eq_needed)
    prev_generics = Array::length(dtd_eq_specializations)
    emit_recorded_arr_equals(stmts)
    emit_recorded_map_equals(stmts)
    emit_recorded_generic_eq(stmts)
  }
}

/// Small non-negative Int -> decimal String (Int::to_string is not in scope in
/// this module). Used only to make unique enum-field binder names.
fn digit_str(d: Int) -> String {
  if d == 0 {
    "0"
  } else if d == 1 {
    "1"
  } else if d == 2 {
    "2"
  } else if d == 3 {
    "3"
  } else if d == 4 {
    "4"
  } else if d == 5 {
    "5"
  } else if d == 6 {
    "6"
  } else if d == 7 {
    "7"
  } else if d == 8 {
    "8"
  } else {
    "9"
  }
}

fn idx_str(n: Int) -> String {
  if n < 10 {
    digit_str(n)
  } else {
    String::concat(idx_str(n / 10), digit_str(n % 10))
  }
}

/// `let E::equals = (a: E, b: E) -> Bool {
///    match a {
///      V1(_a0, _a1) => match b { V1(_b0, _b1) => _a0 == _b0 && _a1 == _b1, _ => false },
///      V2          => match b { V2 => true, _ => false }, ... } }`
/// Tag mismatch falls to the inner `_ => false`; payload `==` is itself
/// dispatched, so aggregate payloads recurse into their own `equals`.
fn gen_enum_eq_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let outer_arms = array_empty()
  let mut vi = 0
  while vi < Array::length(variants) {
    let (vname, ftypes) = Array::get(variants, vi)
    let nf = Array::length(ftypes)
    let abinds = array_empty()
    let bbinds = array_empty()
    let mut fi = 0
    while fi < nf {
      Array::push(abinds, PBind(String::concat("__a", idx_str(fi))))
      Array::push(bbinds, PBind(String::concat("__b", idx_str(fi))))
      fi = fi + 1
    }
    let mut body = EBool(true)
    let mut bi = nf - 1
    while bi >= 0 {
      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat("__a", idx_str(bi)), -1), EIdent(String::concat("__b", idx_str(bi)), -1), known_types)
      body = EBinOp("&&", cmp, body)
      bi = bi - 1
    }
    let inner_arms = Array::slice([
      (PCtor(vname, bbinds), body),
      (PWild, EBool(false))
    ], 0, 2)
    let inner = EMatch(EIdent("b", -1), inner_arms)
    Array::push(outer_arms, (PCtor(vname, abinds), inner))
    vi = vi + 1
  }
  let params = Array::slice([
    ("a", Some(TyName(ename))),
    ("b", Some(TyName(ename)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "equals"), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, EMatch(EIdent("a", -1), outer_arms)))
}

/// `let P::compare = (a: P, b: P) -> Int { lexicographic over fields -> -1/0/1 }`
fn gen_compare_fn(tname: String, fields: Array[(String, TypeExpr)]) -> Stmt {
  let neg_one = 0 - 1
  let mut body = EInt(0)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, _) = Array::get(fields, i)
    let af = EDot(EIdent("a", -1), fname, -1, -1)
    let bf = EDot(EIdent("b", -1), fname, -1, -1)
    body = EIf(EBinOp("<", af, bf), EInt(neg_one), EIf(EBinOp(">", af, bf), EInt(1), body))
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Int")), None, body))
}

/// Show an arbitrary value expression by its declared type (#694: type-directed
/// and recursive via `show_for_typed`, so aggregate enum payloads — nested
/// struct/enum, Option, Result, tuple, Array — render structurally instead of
/// through the `__to_string` pointer heuristic).
fn show_expr_typed(val: Expr, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty, val, known_types)
}

/// `let E::to_string = (self: E) -> String {
///    match self { V0(_a0, _a1) => "V0(" ++ show(_a0) ++ ", " ++ show(_a1) ++ ")",
///                 V1 => "V1", ... } }`
/// A nullary variant shows as its bare name; a payload variant shows as
/// `Name(p0, p1, ...)` with each payload shown structurally.
fn gen_enum_show_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let arms = array_empty()
  let mut vi = 0
  while vi < Array::length(variants) {
    let (vname, ftypes) = Array::get(variants, vi)
    let nf = Array::length(ftypes)
    let binds = array_empty()
    let mut fi = 0
    while fi < nf {
      Array::push(binds, PBind(String::concat("__s", idx_str(fi))))
      fi = fi + 1
    }
    let body = if nf == 0 {
      // #2205: render the source constructor name, not the merge-renamed one
      // (same as gen_show_fn above; the PCtor pattern below keeps `vname`).
      EString(namespace_rename_original(vname))
    } else {
      let segs = empty_expr_array()
      Array::push(segs, EString(String::concat(namespace_rename_original(vname), "(")))
      let mut si = 0
      while si < nf {
        let sep = if si == 0 {
          ""
        } else ", "
        if sep != "" {
          Array::push(segs, EString(sep))
        } else {
          ()
        }
        Array::push(segs, show_expr_typed(EIdent(String::concat("__s", idx_str(si)), -1), Array::get(ftypes, si), known_types))
        si = si + 1
      }
      Array::push(segs, EString(")"))
      let mut acc = Array::get(segs, Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(Array::get(segs, j), acc)
        j = j - 1
      }
      acc
    }
    Array::push(arms, (PCtor(vname, binds), body))
    vi = vi + 1
  }
  let params = Array::slice([("self", Some(TyName(ename)))], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, EMatch(EIdent("self", -1), arms)))
}

/// `let T::hash_key = (self: T) -> String { T::to_string(self) }` (#694 Layer 1).
/// `derive(Hash)` makes a type usable as a Map key via the method-bearing `Hash`
/// trait (`hash_key(Self) -> String`): `map_key_to_string = [K: Hash](key) ->
/// K::hash_key(key)` threads the witness (#684), and at a concrete call site
/// `get_by(m, T::{..})` the synthesized `HashDict::{ hash_key: T::hash_key }`
/// resolves here. The key is the structural `to_string` (now fully recursive via
/// `show_for_typed`), so two distinct-but-field-equal values hash to one entry.
fn gen_hash_key_fn(tname: String) -> Stmt {
  let body = ECall(EIdent(qualified_name(tname, "to_string"), -1), Array::slice([
    EIdent("self", -1)
  ], 0, 1), -1)
  let params = Array::slice([("self", Some(TyName(tname)))], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "hash_key"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}

/// Append any `Array[e]` element types referenced by a TypeExpr to `acc`
/// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or
/// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)
fn collect_show_array_elems(ty: TypeExpr, acc: Array[TypeExpr], keys: Array[String]) -> Unit {
  match ty {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let et = Array::get(args, 0)
      let k = ts_type_key(et)
      if str_array_contains(keys, k) {
        ()
      } else {
        Array::push(keys, k)
        Array::push(acc, et)
      }
    } else {
      ()
    },
    _ => ()
  }
}

/// Compare two operands of declared type `fty`, returning -1/0/1. Aggregate
/// (declared struct/enum) operands recurse through `T::compare`; scalars and type
/// parameters use the runtime structural `<` / `>` (codegen handles them).
fn compare_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  let neg_one = 0 - 1
  match fty {
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "compare"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      EIf(EBinOp("<", lhs, rhs), EInt(neg_one), EIf(EBinOp(">", lhs, rhs), EInt(1), EInt(0)))
    },
    _ => EIf(EBinOp("<", lhs, rhs), EInt(neg_one), EIf(EBinOp(">", lhs, rhs), EInt(1), EInt(0)))
  }
}

/// `let E::compare = (a: E, b: E) -> Int { ... }`
/// Lexicographic: first by variant order (a's tag index vs b's tag index), then
/// (same variant) by payload, recursively. The variant index of `a` is computed
/// by matching `a`; for each `a` variant the inner match on `b` either compares
/// payloads (same variant) or returns the sign of (a_index - b_index).
fn gen_enum_compare_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let neg_one = 0 - 1
  let outer_arms = array_empty()
  let mut ai = 0
  while ai < Array::length(variants) {
    let (avname, aftypes) = Array::get(variants, ai)
    let anf = Array::length(aftypes)
    let abinds = array_empty()
    let mut afi = 0
    while afi < anf {
      Array::push(abinds, PBind(String::concat("__a", idx_str(afi))))
      afi = afi + 1
    }
    // inner match over b: for the same variant compare payloads; otherwise the
    // sign comes from the variant order (a before b -> -1, after -> 1).
    let inner_arms = array_empty()
    let mut bi = 0
    while bi < Array::length(variants) {
      let (bvname, bftypes) = Array::get(variants, bi)
      let bnf = Array::length(bftypes)
      let bbinds = array_empty()
      let mut bfi = 0
      while bfi < bnf {
        Array::push(bbinds, PBind(String::concat("__b", idx_str(bfi))))
        bfi = bfi + 1
      }
      let arm_body = if ai == bi {
        // same variant: lexicographic over payloads, 0 if no payload.
        let mut body = EInt(0)
        let mut pi = anf - 1
        while pi >= 0 {
          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat("__a", idx_str(pi)), -1), EIdent(String::concat("__b", idx_str(pi)), -1), known_types)
          let prev = body
          body = EIf(EBinOp("<", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(">", cmp, EInt(0)), EInt(1), prev))
          pi = pi - 1
        }
        body
      } else if ai < bi {
        EInt(neg_one)
      } else {
        EInt(1)
      }
      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))
      bi = bi + 1
    }
    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent("b", -1), inner_arms)))
    ai = ai + 1
  }
  let params = Array::slice([
    ("a", Some(TyName(ename))),
    ("b", Some(TyName(ename)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Int")), None, EMatch(EIdent("a", -1), outer_arms)))
}

/// The default value expression for a declared field type. Per-type rules:
///   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> "", Unit -> (),
///   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum
///   (in `known_types`) -> `T::default()`. A type with no sensible default (a
///   bare type parameter, a function/tuple type, an unknown name) falls back to
///   `()` — codegen will then flag the literal against the field's real type, so
///   the limitation surfaces as a type error rather than silently wrong data.
fn default_for_type(fty: TypeExpr, known_types: Array[String]) -> Expr {
  match fty {
    TyName("Int") => EInt(0),
    TyName("Double") => EFloat(0.0),
    TyName("Float") => EFloat(0.0),
    TyName("Bool") => EBool(false),
    TyName("String") => EString(""),
    TyName("Unit") => EUnit,
    TyName(n) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "default"), -1), empty_expr_array(), -1)
    } else {
      EUnit
    },
    TyApp("Option", _) => EIdent("None", -1),
    TyApp("Array", _) => EArray(empty_expr_array()),
    TyApp(n, _) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "default"), -1), empty_expr_array(), -1)
    } else {
      EUnit
    },
    TyUnit => EUnit,
    _ => EUnit
  }
}

/// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal
/// (ERecord; the struct type is recovered from the field set) with each field at
/// its type's default.
fn gen_default_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let rec_fields = array_empty()
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, i)
    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))
    i = i + 1
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord("", rec_fields, empty_ty_args())))
}

/// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with
/// each payload slot at its type's default (nullary -> bare constructor name).
fn gen_enum_default_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let (vname, ftypes) = Array::get(variants, 0)
  let body = if Array::length(ftypes) == 0 {
    EIdent(vname, -1)
  } else {
    let args = empty_expr_array()
    let mut i = 0
    while i < Array::length(ftypes) {
      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))
      i = i + 1
    }
    ECall(EIdent(vname, -1), args, -1)
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))
}

/// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the
/// element type `e` to `acc` (deduped by `type_key`). Only the immediate element
/// types are added here; transitive nesting (`Array[Array[Int]]` needs the
/// `Array[Int]` helper too) is closed by the worklist loop in the caller, which
/// re-scans every element type it collects. (#695.)
fn collect_array_elem_types(ty: TypeExpr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  match ty {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let e = Array::get(args, 0)
      let k = type_key(e)
      if !str_array_contains(acc_keys, k) {
        Array::push(acc, e)
        Array::push(acc_keys, k)
      } else {
        ()
      }
      collect_array_elem_types(e, acc, acc_keys)
    } else {
      ()
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_array_elem_types(Array::get(args, i), acc, acc_keys)
        i = i + 1
      }
    },
    TyTuple(ts) => {
      let mut i = 0
      while i < Array::length(ts) {
        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Best-effort element TypeExpr of an array LITERAL, inferred from its first
/// element: scalars and nested array literals only. An empty array, or a first
/// element whose type is not statically obvious here (variables, struct records,
/// calls), yields `None` — the caller then leaves a bare-array `==` as the
/// status-quo scalar binop (documented #695 residual) rather than guessing.
/// Is `e` an empty array literal `[]`? Used to reduce `[] == x` to a length check.
fn is_empty_array_lit(e: Expr) -> Bool {
  match e {
    EArray(elems) => Array::length(elems) == 0,
    _ => false
  }
}

fn is_untyped_empty_array_name(e: Expr, var_types: Array[(String, String)]) -> Bool {
  match e {
    EIdent(name, _) => match lookup_var_type(var_types, eq_shape_key(name)) {
      Some(sh) => sh == "[__EqEmpty]",
      None => false
    },
    _ => false
  }
}

/// #1526: the element type of an array operand reached through a NAME.
///
/// `infer_earray_elem_type` below only reads an array LITERAL, so the moment an
/// array was bound to a name the bare `==` fell back to the runtime `eq`, which
/// identity-compares -- `let a = [1, 2]; let c = [1, 2]; a == c` was `false`.
/// The element type is not missing, though: `array_elem_bind` already records
/// it for a let-bound array literal and `seed_var_types` for an `Array[T]`
/// parameter, both under `array_elem_key` (#1199, for call-site dict
/// synthesis). This just reads that back at the comparison site.
///
/// Scope is exactly what those two record -- a name whose element type this
/// pass never inferred (an array returned by a function, an empty literal)
/// still gets the identity `eq`, the documented #695 residual.
fn eq_var_array_elem(l: Expr, r: Expr, var_types: Array[(String, String)]) -> Option[TypeExpr] {
  match eq_operand_elem_name(l, var_types) {
    Some(n) => Some(TyName(n)),
    None => match eq_operand_elem_name(r, var_types) {
      Some(n) => Some(TyName(n)),
      None => None
    }
  }
}

fn eq_operand_elem_name(e: Expr, var_types: Array[(String, String)]) -> Option[String] {
  match e {
    EIdent(name, _) => match array_elem_type_of(var_types, name) {
      Some(n) => if eq_elem_name_dispatchable(n) {
        Some(n)
      } else {
        None
      },
      None => None
    },
    _ => None
  }
}

// ---- #1526 (ADR-0097): tuple-through-a-NAME `==`, the Array/Bytes arm ----
//
// A let-bound tuple already compares structurally at the CODEGEN level: the
// `==` there drives a recursive walk over the binding's recorded shape
// literal (compile_expr.vibe, #672/#724), which is why `(P::{x:1}, 0)` /
// `(1, 2)` bound to names answer correctly in every backend. That walk's
// Array leaf is the generic runtime `eq`, though — an identity compare — so
// exactly the tuples that CONTAIN an Array (or Bytes) answered `false` for
// equal values while the same tuple written as a literal answered `true`
// (the #825 static dispatch catches literals before codegen ever sees them).
//
// So this dispatch deliberately triggers ONLY when the operand's recorded
// shape mentions an Array or Bytes anywhere: everything else keeps the
// codegen walk, whose per-element precision (ctor payloads, tracked
// aliases) a flattened shape string cannot match. Where it does trigger, the
// comparison routes through `eq_for_typed` with the declared-type list
// (`dtd_eq_known_types`), so struct/enum elements still take their
// `::equals` and only genuinely unknown positions fall to raw `==`.

fn eq_shape_key(pname: String) -> String {
  String::concat("__eqshape$", pname)
}

/// Full equality shape of a function result. The space makes this key
/// impossible to collide with a source-level function name.
fn fn_eq_shape_key(fname: String) -> String {
  String::concat("eq return ", fname)
}

/// Does the type mention any of `names` as a bare TyName (a fn's own type
/// parameters, for the seeding guard below)?
fn ty_mentions_name_in(t: TypeExpr, names: Array[String]) -> Bool {
  match t {
    TyName(n) => str_array_contains(names, n),
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_mentions_name_in(Array::get(args, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if ty_mentions_name_in(Array::get(ts, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// A parameter ANNOTATION rendered into the recursive shape grammar
/// (`shape_key`'s: Name / `(s1,..)` / `[s]` / "" unknown). Only shapes this
/// pass can compare are produced; anything else collapses to "" (unknown).
fn ty_to_eq_shape(t: TypeExpr) -> String {
  ty_to_eq_shape_expanded(eq_expand_alias_ty(subst_scope_formals_ty(t)))
}

fn ty_to_eq_shape_expanded(t: TypeExpr) -> String {
  match t {
    TyName(n) => n,
    TyUnit => "{u}",
    TyTuple(ts) => if Array::length(ts) == 0 {
      ""
    } else {
      let mut acc = "("
      let mut i = 0
      while i < Array::length(ts) {
        let sub = ty_to_eq_shape_expanded(Array::get(ts, i))
        acc = if i == 0 {
          String::concat(acc, sub)
        } else {
          String::concat(acc, String::concat(",", sub))
        }
        i = i + 1
      }
      String::concat(acc, ")")
    },
    TyApp(n, args) => if n == "Array" && Array::length(args) == 1 {
      String::concat("[", String::concat(ty_to_eq_shape_expanded(Array::get(args, 0)), "]"))
    } else if n == "Option" && Array::length(args) == 1 {
      String::concat("{o:", String::concat(ty_to_eq_shape_expanded(Array::get(args, 0)), "}"))
    } else if n == "Result" && Array::length(args) == 2 {
      String::concat("{r:", String::concat(ty_to_eq_shape_expanded(Array::get(args, 0)), String::concat(",", String::concat(ty_to_eq_shape_expanded(Array::get(args, 1)), "}"))))
    } else if builtin_string_map_applied(n, args) {
      String::concat("{m:String,", String::concat(ty_to_eq_shape_expanded(Array::get(args, 0)), "}"))
    } else if n == "Map" && Array::length(args) == 2 {
      // #2218: a Map shape, so an ANNOTATED binding (`let m: Map[String, Int]`)
      // or a typed parameter reaches `eq_for_typed`'s Map arm the same way an
      // `Array[T]` one reaches its Array arm. Without this the type is known
      // and the answer still came from the raw `==`.
      String::concat("{m:", String::concat(ty_to_eq_shape_expanded(Array::get(args, 0)), String::concat(",", String::concat(ty_to_eq_shape_expanded(Array::get(args, 1)), "}"))))
    } else if Array::length(args) > 0 {
      let mut acc = String::concat("{g:", n)
      let mut i = 0
      while i < Array::length(args) {
        acc = String::concat(acc, String::concat(",", ty_to_eq_shape_expanded(Array::get(args, i))))
        i = i + 1
      }
      String::concat(acc, "}")
    } else {
      n
    },
    _ => ""
  }
}

/// A constructor argument inside `{g:Head,...}`. Bare `Array`/`Map`/`Tuple`
/// here are type constructors (`KBox[Array, Int]`), not complete values, so
/// they must round-trip as `TyName` rather than the `__EqUnknown` marker
/// `shape_to_eq_ty` uses for an element-free array binding.
fn shape_to_eq_ctor_arg(sh: String) -> TypeExpr {
  if sh == "Array" || sh == "Map" || sh == "Tuple" {
    TyName(sh)
  } else {
    shape_to_eq_ty(sh)
  }
}

/// A shape string back into the TypeExpr `eq_for_typed` dispatches on. An
/// unknown position becomes the `__EqUnknown` marker (raw `==`, the status
/// quo for that position). A bare "Option"/"Result" head keeps its
/// structural match with unknown payloads — the same upgrade the bare-`==`
/// name path applies via `opt_eq_match` — while a bare "Array"/"Tuple"/"Map"
/// head carries nothing to dispatch on and stays unknown.
fn shape_to_eq_ty(sh: String) -> TypeExpr {
  if String::length(sh) == 0 {
    TyName("__EqUnknown")
  } else if sh == "{u}" {
    TyUnit
  } else if String::starts_with(sh, "(") {
    let parts = shape_split(shape_inner(sh))
    let ts = empty_type_exprs()
    let mut i = 0
    while i < Array::length(parts) {
      Array::push(ts, shape_to_eq_ty(Array::get(parts, i)))
      i = i + 1
    }
    TyTuple(ts)
  } else if String::starts_with(sh, "[") {
    TyApp("Array", Array::slice([shape_to_eq_ty(shape_inner(sh))], 0, 1))
  } else if String::starts_with(sh, "{o:") {
    TyApp("Option", Array::slice([
      shape_to_eq_ty(String::substring(sh, 3, String::length(sh) - 1))
    ], 0, 1))
  } else if String::starts_with(sh, "{m:") {
    let parts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
    if Array::length(parts) == 2 {
      TyApp("Map", Array::slice([
        shape_to_eq_ty(Array::get(parts, 0)),
        shape_to_eq_ty(Array::get(parts, 1))
      ], 0, 2))
    } else {
      TyName("__EqUnknown")
    }
  } else if String::starts_with(sh, "{r:") {
    let parts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
    if Array::length(parts) == 2 {
      TyApp("Result", Array::slice([
        shape_to_eq_ty(Array::get(parts, 0)),
        shape_to_eq_ty(Array::get(parts, 1))
      ], 0, 2))
    } else {
      TyName("__EqUnknown")
    }
  } else if String::starts_with(sh, "{g:") {
    let parts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
    if Array::length(parts) > 1 {
      let args = empty_type_exprs()
      let mut i = 0
      while i + 1 < Array::length(parts) {
        Array::push(args, shape_to_eq_ctor_arg(Array::get(parts, i + 1)))
        i = i + 1
      }
      TyApp(Array::get(parts, 0), args)
    } else {
      TyName("__EqUnknown")
    }
  } else if sh == "Option" {
    TyApp("Option", Array::slice([TyName("__EqUnknown")], 0, 1))
  } else if sh == "Result" {
    TyApp("Result", Array::slice([TyName("__EqUnknown"), TyName("__EqUnknown")], 0, 2))
  } else if sh == "Array" || sh == "Tuple" || sh == "Map" {
    TyName("__EqUnknown")
  } else {
    TyName(sh)
  }
}

/// Does the dispatch type mention a head the codegen walk gets WRONG anywhere?
/// This is the trigger condition: a composite shape without one is already
/// compared correctly by that walk, and re-routing it here could only lose
/// precision.
///
/// `Array` and `Bytes` were the original two. `Map` joined them in #2218 -- it
/// has the same property (the raw `==` compares the reference) and it now has
/// the same remedy (a generated `__map_equals__` helper). The name kept its
/// two original heads for one release too long and said something false about
/// the third; it is spelled by intent now.
fn ty_needs_typed_eq(t: TypeExpr) -> Bool {
  ty_needs_typed_eq_expanded(eq_expand_alias_ty(subst_scope_formals_ty(t)))
}

fn ty_needs_typed_eq_expanded(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "Bytes",
    TyApp(n, args) => if n == "Array" || n == "Map" || builtin_string_map_applied(n, args) || generic_eq_struct_declared(n) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_needs_typed_eq_expanded(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if ty_needs_typed_eq_expanded(Array::get(ts, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// The dispatchable shape type of ONE bare-`==` operand reached through a
/// NAME, or None. Precedence mirrors interp_expand's: the recorded recursive
/// shape answers first (a recorded EMPTY means "innermost binding is not
/// composite" and must not fall through to a stale parameter shape — the
/// shadowing rule from #1465); a parameter's `__eqshape$` (seed_var_types)
/// answers next; the older per-element sentinels resolve via `infer_shape`
/// last.
fn infer_eq_shape(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match e {
    EIdent(n, _) => {
      match lookup_var_type(var_types, eq_shape_key(n)) {
        Some(s) => s,
        None => infer_shape(e, struct_sets, var_types, fn_returns)
      }
    },
    // #2234: `Map::from_pairs` is normalized by the parser into EMap before
    // this pass, so looking for the source-level call can never fire. Keys are
    // string literals by the EMap contract; the first value stands for every
    // value just as the EArray arm does for its elements (heterogeneous maps
    // are rejected by the checker). An empty map still says nothing about V.
    EMap(fields) => if Array::length(fields) == 0 {
      ""
    } else {
      let (_, first_value) = Array::get(fields, 0)
      String::concat("{m:String,", String::concat(infer_eq_shape(first_value, struct_sets, var_types, fn_returns), "}"))
    },
    ECall(EIdent(fname, _), args, _) => if (fname == "Some" || fname == "Option::Some") && Array::length(args) == 1 {
      String::concat("{o:", String::concat(infer_eq_shape(Array::get(args, 0), struct_sets, var_types, fn_returns), "}"))
    } else if (fname == "Ok" || fname == "Result::Ok") && Array::length(args) == 1 {
      String::concat("{r:", String::concat(infer_eq_shape(Array::get(args, 0), struct_sets, var_types, fn_returns), ",__EqUnknown}"))
    } else if (fname == "Err" || fname == "Result::Err") && Array::length(args) == 1 {
      String::concat("{r:__EqUnknown,", String::concat(infer_eq_shape(Array::get(args, 0), struct_sets, var_types, fn_returns), "}"))
    } else {
      let local_shape = lookup_var_type(var_types, eq_shape_key(fname))
      match local_shape {
        Some(s) => s,
        None => match fn_return_type(fn_returns, fn_eq_shape_key(fname)) {
          Some(s) => s,
          None => {
            let ordinary = infer_shape(e, struct_sets, var_types, fn_returns)
            if shape_is_composite(ordinary) {
              ordinary
            } else {
              match infer_static_eq_type(e) {
                Some(t) => ty_to_eq_shape(t),
                None => ordinary
              }
            }
          }
        }
      }
    },
    _ => {
      let ordinary = infer_shape(e, struct_sets, var_types, fn_returns)
      if shape_is_composite(ordinary) {
        ordinary
      } else {
        match infer_static_eq_type(e) {
          Some(t) => ty_to_eq_shape(t),
          None => ordinary
        }
      }
    }
  }
}

fn eq_operand_shape_ty(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[TypeExpr] {
  let sh = infer_eq_shape(e, struct_sets, var_types, fn_returns)
  if shape_is_composite(sh) {
    let t = shape_to_eq_ty(sh)
    // A partial operand must not win merely because its container head is
    // dispatchable. In particular `{m:String,}` becomes
    // `Map[String, __EqUnknown]`; accepting it here hides a complete shape on
    // the other operand and makes aggregate values fall back to identity.
    if ty_needs_typed_eq(t) && !ty_contains_eq_unknown(t) {
      Some(t)
    } else {
      None
    }
  } else {
    None
  }
}

fn eq_var_shape_dispatch(l: Expr, r: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[TypeExpr] {
  match eq_operand_shape_ty(l, struct_sets, var_types, fn_returns) {
    Some(t) => Some(t),
    None => eq_operand_shape_ty(r, struct_sets, var_types, fn_returns)
  }
}

/// Codex P1 on PR #1565: what `array_elem_key` stores is a bare HEAD NAME, not
/// a TypeExpr, so it cannot be wrapped in `TyName` and trusted. Two kinds of
/// entry are not element types at all:
///
///   - a head that lost its arguments: a let-bound `[[1, 2]]` records just
///     "Array", a `[(1, 2)]` just "Tuple". `TyName("Array")` would name a
///     helper `__arr_equals__Array` whose element comparison degrades to a raw
///     `==` -- no worse than the identity fallback, but it spends a generated
///     function to buy nothing.
///   - an in-scope TYPE VARIABLE: `fn same[T](x: Array[T], y: Array[T])`
///     records "T". The concrete type is erased, so nothing type-directed can
///     be resolved from it.
///
/// A declared struct/enum name is excluded too, deliberately: `eq_for_typed`
/// would emit `N::equals`, which only exists when N derives Eq. Routing a
/// name-reached array there would turn a program that compiles today into an
/// `undefined variable` -- so this stays at the scalars, which are exactly the
/// ones `eq_for_typed` compares correctly with no generated dependency. An
/// array of structs reached through a name keeps the identity `eq` it has
/// always had.
fn eq_elem_name_dispatchable(n: String) -> Bool {
  is_scalar_type_name(n)
}

fn infer_earray_elem_type(arr: Expr) -> Option[TypeExpr] {
  match arr {
    EArray(elems) => if Array::length(elems) == 0 {
      None
    } else {
      match Array::get(elems, 0) {
        EInt(_) => Some(TyName("Int")),
        EBool(_) => Some(TyName("Bool")),
        EString(_) => Some(TyName("String")),
        EFloat(_) => Some(TyName("Double")),
        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {
          Some(inner) => Some(TyApp("Array", Array::slice([inner], 0, 1))),
          None => None
        },
        _ => None
      }
    },
    _ => None
  }
}

/// #825: does `t` contain the `__EqUnknown` marker anywhere? Used to keep the
/// marker out of generated `__arr_equals__<key>` helper names/annotations (an
/// Array element type must be fully concrete to be usable).
fn ty_contains_eq_unknown(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "__EqUnknown",
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_contains_eq_unknown(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if ty_contains_eq_unknown(Array::get(ts, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn generic_record_direct_arg(fields: Array[(String, Expr)], decl_fields: Array[(String, TypeExpr)], param: String, i: Int) -> Option[TypeExpr] {
  if i >= Array::length(decl_fields) {
    None
  } else {
    let (decl_name, decl_ty) = Array::get(decl_fields, i)
    match decl_ty {
      TyName(n) => if n == param {
        let mut j = 0
        let mut out: Option[TypeExpr] = None
        while j < Array::length(fields) {
          let (value_name, value_expr) = Array::get(fields, j)
          if value_name == decl_name {
            out = infer_static_eq_type(value_expr)
          } else {
            ()
          }
          j = j + 1
        }
        out
      } else {
        generic_record_direct_arg(fields, decl_fields, param, i + 1)
      },
      _ => generic_record_direct_arg(fields, decl_fields, param, i + 1)
    }
  }
}

fn infer_generic_record_static(name: String, fields: Array[(String, Expr)], i: Int) -> Option[TypeExpr] {
  if i >= Array::length(dtd_eq_generic_structs) {
    None
  } else {
    let (decl_name, params, decl_fields) = Array::get(dtd_eq_generic_structs, i)
    if decl_name == name && Array::length(params) == 1 {
      match generic_record_direct_arg(fields, decl_fields, Array::get(params, 0), 0) {
        Some(arg) => Some(TyApp(name, Array::slice([arg], 0, 1))),
        None => infer_generic_record_static(name, fields, i + 1)
      }
    } else {
      infer_generic_record_static(name, fields, i + 1)
    }
  }
}

/// #825: best-effort full STATIC TypeExpr of a bare `==` operand, inferred from
/// literal syntax alone (no environment). Where the name-based `==` dispatch
/// only recovers a head name ("Option"/"Result") and compares payloads with a
/// raw word `==`, this recovers the payload SHAPE too, so
/// `Some([1,2]) == Some([1,2])` / `Ok([1,2]) == Ok([1,2])` /
/// `Some(Some(1)) == Some(Some(1))` / `([1,2], 0) == ([1,2], 0)` route through
/// the fully-recursive `eq_for_typed` instead of identity-comparing aggregate
/// payloads. A position whose type is not statically obvious yields the marker
/// `TyName("__EqUnknown")` — never a scalar or declared type, so `eq_for_typed`
/// falls back to raw `==` there (exactly the status-quo behavior for that
/// position). An Array element type must be marker-free (else the whole array
/// is uninferable): the element type names the generated `__arr_equals__<key>`
/// helper and appears in its parameter annotations, where the marker would not
/// resolve.
fn infer_static_eq_type(e: Expr) -> Option[TypeExpr] {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Double")),
    EUnit => Some(TyUnit),
    ERecord(name, fields, targs) => if generic_eq_struct_declared(name) && Array::length(targs) > 0 {
      Some(TyApp(name, targs))
    } else if generic_eq_struct_declared(name) {
      infer_generic_record_static(name, fields, 0)
    } else {
      None
    },
    EArray(elems) => if Array::length(elems) == 0 {
      None
    } else {
      match infer_static_eq_type(Array::get(elems, 0)) {
        Some(t) => if ty_contains_eq_unknown(t) {
          None
        } else {
          Some(TyApp("Array", Array::slice([t], 0, 1)))
        },
        None => None
      }
    },
    ETuple(es) => {
      let ts = empty_type_exprs()
      let mut i = 0
      while i < Array::length(es) {
        match infer_static_eq_type(Array::get(es, i)) {
          Some(t) => Array::push(ts, t),
          None => Array::push(ts, TyName("__EqUnknown"))
        }
        i = i + 1
      }
      Some(TyTuple(ts))
    },
    EIdent(n, _) => if n == "None" {
      Some(TyApp("Option", Array::slice([TyName("__EqUnknown")], 0, 1)))
    } else {
      None
    },
    ECall(callee, args, _) => match callee {
      // #825 review follow-up: the docs' qualified ctor spellings
      // (`Option::Some` / `Result::Ok` / `Result::Err`) must infer the same
      // shape as the bare forms — they fell through to the name-only path
      // where aggregate payloads word-compare.
      EIdent("Option::Some", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Option", Array::slice([pt], 0, 1)))
      } else {
        None
      },
      EIdent("Result::Ok", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([pt, TyName("__EqUnknown")], 0, 2)))
      } else {
        None
      },
      EIdent("Result::Err", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([TyName("__EqUnknown"), pt], 0, 2)))
      } else {
        None
      },
      EIdent("Some", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Option", Array::slice([pt], 0, 1)))
      } else {
        None
      },
      EIdent("Ok", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([pt, TyName("__EqUnknown")], 0, 2)))
      } else {
        None
      },
      EIdent("Err", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([TyName("__EqUnknown"), pt], 0, 2)))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// #825 review follow-up: pick the static shape for `l == r` from whichever
/// side is MORE concrete. A left-first choice masked a fully concrete right
/// shape — `let xs = [1, 2]; Some(xs) == Some([1, 2])` inferred the left as
/// `Option[__EqUnknown]` and the payload fell back to raw word `==`. Prefer a
/// marker-free shape; between two partial shapes keep the left one.
fn infer_static_eq_type_binop(l: Expr, r: Expr) -> Option[TypeExpr] {
  let lt = infer_static_eq_type(l)
  let rt = infer_static_eq_type(r)
  match lt {
    Some(lty) => if ty_contains_eq_unknown(lty) {
      match rt {
        Some(rty) => if ty_contains_eq_unknown(rty) {
          Some(lty)
        } else {
          Some(rty)
        },
        None => Some(lty)
      }
    } else {
      Some(lty)
    },
    None => rt
  }
}

/// #825: shapes worth dispatching through `eq_for_typed` at a bare `==` site.
/// Only the aggregate shapes the runtime word-compare gets wrong; scalars keep
/// the raw binop and anything unrecognized falls back to the name-based
/// dispatch (which preserves the pre-#825 behavior).
fn static_eq_dispatchable(t: TypeExpr) -> Bool {
  match t {
    TyApp(n, args) => (n == "Option" && Array::length(args) == 1) || (n == "Result" && Array::length(args) == 2) || (n == "Array" && Array::length(args) == 1) || (generic_eq_struct_declared(n) && Array::length(args) > 0),
    TyTuple(_) => true,
    _ => false
  }
}

/// Walk an expression and, for every `a == b` / `a != b` whose operand is an
/// array LITERAL with a determinable element type, collect that element type so a
/// `__arr_equals__<key>` helper is generated for the dispatch rewrite to call.
fn collect_bare_array_eq_keys(e: Expr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  match e {
    EBinOp(op, l, r) => {
      if op == "==" || op == "!=" {
        let et = match infer_earray_elem_type(l) {
          Some(t) => Some(t),
          None => infer_earray_elem_type(r)
        }
        match et {
          Some(t) => {
            let k = type_key(t)
            if !str_array_contains(acc_keys, k) {
              Array::push(acc, t)
              Array::push(acc_keys, k)
            } else {
              ()
            }
            collect_array_elem_types(t, acc, acc_keys)
          },
          None => ()
        }
        // #825: the full static-shape dispatch can surface Array element types
        // nested inside Option/Result/tuple literals (`Some([1,2]) == ...`,
        // `([1,2], 0) == ...`, `[Some(1)] == ...`) — collect them so their
        // `__arr_equals__<key>` helpers exist for `eq_for_typed`'s calls.
        let sty = infer_static_eq_type_binop(l, r)
        match sty {
          Some(t2) => collect_array_elem_types(t2, acc, acc_keys),
          None => ()
        }
      } else {
        ()
      }
      collect_bare_array_eq_keys(l, acc, acc_keys)
      collect_bare_array_eq_keys(r, acc, acc_keys)
    },
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(_, _) => (),
    EUnit => (),
    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fe) = Array::get(fs, i)
        collect_bare_array_eq_keys(fe, acc, acc_keys)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fe) = Array::get(fs, i)
        collect_bare_array_eq_keys(fe, acc, acc_keys)
        i = i + 1
      }
    },
    EIf(c, t, el) => {
      collect_bare_array_eq_keys(c, acc, acc_keys)
      collect_bare_array_eq_keys(t, acc, acc_keys)
      collect_bare_array_eq_keys(el, acc, acc_keys)
    },
    ELet(_, v, b, _) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELetRec(_, v, b) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELetMut(_, v, b, _) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EAssign(_, v, c) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(c, acc, acc_keys)
    },
    EAssignOp(_, _, v, c) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(c, acc, acc_keys)
    },
    ESeq(a, b) => {
      collect_bare_array_eq_keys(a, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EMatch(s, arms) => {
      collect_bare_array_eq_keys(s, acc, acc_keys)
      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)
    },
    EHandle(s, arms) => {
      collect_bare_array_eq_keys(s, acc, acc_keys)
      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)
    },
    EWhile(c, b) => {
      collect_bare_array_eq_keys(c, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        collect_bare_array_eq_keys(init, acc, acc_keys)
        i = i + 1
      }
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EForIn(_, _, it, b) => {
      collect_bare_array_eq_keys(it, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ECall(callee, args, _) => {
      collect_bare_array_eq_keys(callee, acc, acc_keys)
      collect_bare_array_eq_keys_list(args, acc, acc_keys)
    },
    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),
    EDot(o, _, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),
    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),
    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    EBreak(opt) => match opt {
      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
      None => ()
    },
    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    _ => ()
  }
}

fn collect_bare_array_eq_keys_list(es: Array[Expr], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)
    i = i + 1
  }
}

fn collect_bare_array_eq_keys_arms(arms: Array[(Pat, Expr)], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    collect_bare_array_eq_keys(b, acc, acc_keys)
    i = i + 1
  }
}

/// In-place: for each struct with `derive(Show/Ord)`, append the structural
/// function if not already present (idempotent across the double-run pipeline).
/// The set of concrete struct/enum names declared in the program — the gate for
/// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose
/// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to
/// scalar `==`, since there is no `T::equals` to call).
fn collect_decl_type_names(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => Array::push(out, name),
      SEnum(_, ename, _, _, _) => Array::push(out, ename),
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn desugar_derives(stmts: Array[Stmt]) -> Unit {
  let gen = empty_stmt_list()
  let known_types = collect_decl_type_names(stmts)
  // #2136: the type variables a generated `Array[e]` helper has to bind. Filled
  // here because this is the first pass that generates one, and read again by
  // `emit_recorded_arr_equals`, which runs later in the same
  // `desugar_trait_dicts` call.
  type_param_names_reset(stmts, known_types)
  // #694 Layer 2: collect `Array[e]` element types referenced by Show/Hash-
  // deriving types' fields/payloads, so each gets a `__arr_to_string__<key>`
  // helper. A worklist closes nesting (`Array[Array[Int]]` -> `Array[Int]`).
  let arr_elems = empty_type_exprs()
  let arr_keys = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, fields0, derives, _, decl_tparams) => {
        // #2141: the declaration's tparams scope its field types -- re-spell
        // them before any generator reads them (see subst_field_formals).
        let fields = subst_field_formals(fields0, decl_tparams)
        // `derive(Hash)` also needs the structural `to_string`: a Hash type's
        // stable Map-key string is its structural representation (#638), so
        // generate `to_string` for Show OR Hash.
        if (str_array_contains(derives, "Show") || str_array_contains(derives, "Hash")) && !top_level_fn_exists(stmts, qualified_name(name, "to_string")) {
          Array::push(gen, gen_show_fn(name, fields, known_types))
          derived_renderer_record(name)
        } else {
          ()
        }
        // #694 Layer 1: `derive(Hash)` -> structural `T::hash_key` (delegates to
        // the recursive `to_string`), so the method-bearing `Hash` witness at a
        // `get_by(m, T::{..})` call site resolves to a stable structural key.
        if str_array_contains(derives, "Hash") && !top_level_fn_exists(stmts, qualified_name(name, "hash_key")) {
          Array::push(gen, gen_hash_key_fn(name))
        } else {
          ()
        }
        if str_array_contains(derives, "Show") || str_array_contains(derives, "Hash") {
          let mut fi = 0
          while fi < Array::length(fields) {
            let (_, fty) = Array::get(fields, fi)
            collect_show_array_elems(fty, arr_elems, arr_keys)
            fi = fi + 1
          }
        } else {
          ()
        }
        if str_array_contains(derives, "Ord") && !top_level_fn_exists(stmts, qualified_name(name, "compare")) {
          Array::push(gen, gen_compare_fn(name, fields))
        } else {
          ()
        }
        if str_array_contains(derives, "Default") && !top_level_fn_exists(stmts, qualified_name(name, "default")) {
          Array::push(gen, gen_default_fn(name, fields, known_types))
        } else {
          ()
        }
        // Generate `T::equals` for every struct (not just derive(Eq)) so the
        // `==` dispatch below always resolves; structural equality is the
        // sensible default for any struct, and a struct never relied on the old
        // pointer-identity `==` (which was silently always-false).
        if !top_level_fn_exists(stmts, qualified_name(name, "equals")) {
          Array::push(gen, gen_eq_fn(name, fields, known_types))
        } else {
          ()
        }
      },
      SEnum(_, ename, decl_tparams, variants0, derives) => {
        // #2141: same re-spelling as the SStruct arm, for payload types.
        let variants = subst_variant_formals(variants0, decl_tparams)
        if (str_array_contains(derives, "Show") || str_array_contains(derives, "Hash")) && !top_level_fn_exists(stmts, qualified_name(ename, "to_string")) {
          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))
          derived_renderer_record(ename)
        } else {
          ()
        }
        if str_array_contains(derives, "Hash") && !top_level_fn_exists(stmts, qualified_name(ename, "hash_key")) {
          Array::push(gen, gen_hash_key_fn(ename))
        } else {
          ()
        }
        if str_array_contains(derives, "Show") || str_array_contains(derives, "Hash") {
          let mut vi = 0
          while vi < Array::length(variants) {
            let (_, ftypes) = Array::get(variants, vi)
            let mut ti = 0
            while ti < Array::length(ftypes) {
              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)
              ti = ti + 1
            }
            vi = vi + 1
          }
        } else {
          ()
        }
        if str_array_contains(derives, "Ord") && !top_level_fn_exists(stmts, qualified_name(ename, "compare")) {
          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))
        } else {
          ()
        }
        if str_array_contains(derives, "Default") && !top_level_fn_exists(stmts, qualified_name(ename, "default")) {
          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))
        } else {
          ()
        }
        // Generate `E::equals` for every enum (same rationale as structs), so
        // the `==` dispatch resolves enum operands too.
        if !top_level_fn_exists(stmts, qualified_name(ename, "equals")) {
          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // #695: collect every `Array[e]` element type referenced by struct fields /
  // enum payloads (transitively) plus those surfaced by bare-array `==` sites in
  // user code, then emit one monomorphic `__arr_equals__<key>` helper per
  // distinct key. The worklist closes nesting: scanning element type `e` may
  // surface a further `Array[u]` whose helper is also required. Idempotent:
  // guarded by `top_level_fn_exists` so re-running the pass is inert.
  let elem_types = empty_type_exprs()
  let elem_keys = empty_str_array()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      // #2141: read the fields/payloads through the same decl-tparams
      // re-spelling the generator arms use, or this walk predicts an
      // unsubstituted DUPLICATE helper next to the substituted one the
      // generated `equals` actually calls.
      SStruct(_, _, fields, _, _, decl_tparams) => {
        let sfields = subst_field_formals(fields, decl_tparams)
        let mut fi = 0
        while fi < Array::length(sfields) {
          let (_, fty) = Array::get(sfields, fi)
          collect_array_elem_types(fty, elem_types, elem_keys)
          fi = fi + 1
        }
      },
      SEnum(_, _, decl_tparams, variants, _) => {
        let svariants = subst_variant_formals(variants, decl_tparams)
        let mut vi = 0
        while vi < Array::length(svariants) {
          let (_, ftypes) = Array::get(svariants, vi)
          let mut ti = 0
          while ti < Array::length(ftypes) {
            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)
            ti = ti + 1
          }
          vi = vi + 1
        }
      },
      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      _ => ()
    }
    si = si + 1
  }
  // Worklist closure: scanning each collected element type can surface further
  // nested array element types (e.g. `Array[Array[Int]]` -> `Array[Int]`).
  let mut wi = 0
  while wi < Array::length(elem_types) {
    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)
    wi = wi + 1
  }
  let mut ei = 0
  while ei < Array::length(elem_types) {
    let et = Array::get(elem_types, ei)
    if !top_level_fn_exists(stmts, arr_equals_name(et)) {
      Array::push(gen, gen_arr_equals_fn(et, known_types))
    } else {
      ()
    }
    ei = ei + 1
  }
  // #694: emit `__arr_to_string__<key>` helpers for Array element types
  // referenced by Show/Hash-deriving fields/payloads (`arr_elems` populated in
  // the struct/enum arms above). Independent of the #695 `__arr_equals__` set.
  let mut wi2 = 0
  while wi2 < Array::length(arr_elems) {
    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)
    wi2 = wi2 + 1
  }
  let mut ei2 = 0
  while ei2 < Array::length(arr_elems) {
    let et2 = Array::get(arr_elems, ei2)
    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {
      Array::push(gen, gen_arr_to_string_fn(et2, known_types))
    } else {
      ()
    }
    ei2 = ei2 + 1
  }
  let mut g = 0
  while g < Array::length(gen) {
    Array::push(stmts, Array::get(gen, g))
    g = g + 1
  }
}

fn empty_stmt_list() -> Array[Stmt] {
  array_empty()
}

fn struct_decl_exists(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, _, _, _, _) => if sname == name {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

///|
/// ===== #786: hoist non-capturing effectful local lambdas to top-level =====
/// A `let f = () -> { perform ... }` bound INSIDE a block compiles to a closure
/// value; calling it inside `handle` drives a miscompiled effect+closure lowering
/// (unregistered arity-1 closure type / infinite recursion, #786). The identical
/// function at TOP LEVEL compiles to a direct call and works. So hoist a local
/// `let`-bound lambda whose body performs/throws and that provably captures NO
/// enclosing local, to a fresh top-level `let`, rewriting its call sites.
///
/// Safety: hoisted only when EVERY free identifier (used, not bound inside the
/// lambda) is an effect keyword (perform/throw/resume), a qualified name (`A::b`),
/// or a constructor (Uppercase-initial). Locals are snake_case (lowercase,
/// unqualified) by convention, so any captured local fails the test -- the pass
/// can never hoist a capturing lambda. Bare lowercase top-level helpers also fail,
/// so such lambdas are left alone (a safe miss, not a miscompile).
fn dlh_name_ok(n: String) -> Bool {
  if n == "perform" || n == "throw" || n == "resume" {
    true
  } else if String::index_of(n, "::") >= 0 {
    true
  } else if String::length(n) > 0 {
    let c = String::char_code_at(n, 0)
    c >= 65 && c <= 90
  } else {
    false
  }
}

///|
fn dlh_with(arr: Array[String], name: String) -> Array[String] {
  let out = Array::slice(arr, 0, Array::length(arr))
  Array::push(out, name)
  out
}

///|
fn dlh_strip_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 && n[ln - 1: ln] == "~" {
    n[0: ln - 1]
  } else {
    n
  }
}

///|
/// #786 targets `perform` inside a local lambda that is later called under a
/// `handle`. Hoisting is gated on the body containing a `perform` specifically —
/// NOT `throw`. A `throw(SubErr(..))` lambda (see effect_handler_test) has no
/// closure bug and compiled fine as a local closure; hoisting it to top-level
/// would relocate its bare suberror-ctor references (`KeyInvalid`) out of the
/// scope that resolves them (`undefined variable (local): KeyInvalid @call`).
fn dlh_has_perform(expr: Expr) -> Bool {
  match expr {
    ECall(callee, args, _) => {
      let head = match callee {
        EIdent(n, _) => n == "perform",
        _ => false
      }
      // #640 Stage 2: `throw(x)` now parses to `perform Exception::Throw(x)`, but
      // the hoist gate must keep treating it as a THROW, not a perform — the
      // comment above this function documents exactly why hoisting a
      // `throw(SubErr(..))` lambda breaks (bare suberror-ctor references get
      // relocated out of resolving scope). Recurse into the payload so a real
      // perform nested inside a throw payload still triggers.
      let is_throw_shape = if head && Array::length(args) == 1 {
        match Array::get(args, 0) {
          ECall(op_callee, _, _) => match op_callee {
            EIdent(op_n, _) => is_exception_throw_operation(op_n),
            _ => false
          },
          _ => false
        }
      } else {
        false
      }
      if head && !is_throw_shape {
        true
      } else {
        let mut i = 0
        let mut found = dlh_has_perform(callee)
        while i < Array::length(args) {
          if dlh_has_perform(Array::get(args, i)) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    EBinOp(_, l, r) => dlh_has_perform(l) || dlh_has_perform(r),
    EUnaryOp(_, e) => dlh_has_perform(e),
    EIf(c, t, e) => dlh_has_perform(c) || dlh_has_perform(t) || dlh_has_perform(e),
    ELet(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),
    ELetRec(_, v, b) => dlh_has_perform(v) || dlh_has_perform(b),
    ELetMut(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),
    EAssign(_, v, c) => dlh_has_perform(v) || dlh_has_perform(c),
    EAssignOp(_, _, v, c) => dlh_has_perform(v) || dlh_has_perform(c),
    ESeq(a, b) => dlh_has_perform(a) || dlh_has_perform(b),
    EWhile(c, b) => dlh_has_perform(c) || dlh_has_perform(b),
    EForIn(_, _, it, b) => dlh_has_perform(it) || dlh_has_perform(b),
    EDot(o, _, _, _) => dlh_has_perform(o),
    ELabeledArg(_, _, e) => dlh_has_perform(e),
    EReturn(e) => dlh_has_perform(e),
    EMatch(s, arms) => dlh_has_perform(s) || dlh_has_perform_arms(arms),
    EHandle(s, _) => dlh_has_perform(s),
    _ => false
  }
}

/// Collect the effect-name prefix (`split_qualified`'s head, or the bare
/// operand name if unqualified) of every `perform <qname>`/`perform
/// <qname>(args)` found in `expr`, deduped, into `out`. Mirrors
/// dlh_has_perform's exact traversal shape (same `Exception::Throw` exclusion,
/// same set of recursed-into node kinds -- deliberately NOT into a nested
/// EFn, matching dlh_has_perform's own scope: a perform inside a DEEPER
/// nested closure is that closure's own concern when/if IT is separately
/// hoisted, not this one's).
///
/// Exists to fix a real bug found via gc-backend coverage testing
/// (2026-07-23): a local closure with NO explicit `with <row>` annotation
/// (its `eff` field is `None` in the AST -- the checker infers its
/// effect row internally but never writes it back onto the node) that
/// performs an effect and gets lambda-lifted to a fresh top-level binding
/// by dlh_hoist_expr (the capture-free case) used to keep `eff = None` on
/// the hoisted definition too. `evidence_dict_pass` classifies TOP-LEVEL
/// functions as "needing" an effect purely by reading this row string
/// (codegen/common_base/inline_direct_perform.vibe's edp_collect_fn_defs),
/// so the hoisted function was silently never recognized as needing
/// anything, and its `perform` was never migrated -- harmless on the
/// linear backend (an un-rewritten perform just falls back to replay
/// codegen, still correct) but a hard "unsupported perform" compile error
/// on the gc backend, which has no such fallback. See
/// fixtures/effect_handle_call_evidence_closure_literal.vibe's
/// `never_called` for the exact shape that surfaced this.
fn dlh_collect_performed_effect_names(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      let head = match callee {
        EIdent(n, _) => n == "perform",
        _ => false
      }
      if head && Array::length(args) == 1 {
        let operand = Array::get(args, 0)
        let qname = match operand {
          EIdent(qn, _) => Some(qn),
          ECall(op_callee, _, _) => match op_callee {
            EIdent(qn, _) => Some(qn),
            _ => None
          },
          _ => None
        }
        match qname {
          Some(qn) => if !is_exception_throw_operation(qn) {
            let ename = match split_qualified(qn) {
              Some((h, _)) => h,
              None => qn
            }
            if str_array_contains(out, ename) {
              ()
            } else {
              Array::push(out, ename)
            }
          } else {
            ()
          },
          None => ()
        }
      } else {
        ()
      }
      dlh_collect_performed_effect_names(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        dlh_collect_performed_effect_names(Array::get(args, i), out)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      dlh_collect_performed_effect_names(l, out)
      dlh_collect_performed_effect_names(r, out)
    },
    EUnaryOp(_, e) => dlh_collect_performed_effect_names(e, out),
    EIf(c, t, e) => {
      dlh_collect_performed_effect_names(c, out)
      dlh_collect_performed_effect_names(t, out)
      dlh_collect_performed_effect_names(e, out)
    },
    ELet(_, v, b, _) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    ELetRec(_, v, b) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    ELetMut(_, v, b, _) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EAssign(_, v, c) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(c, out)
    },
    EAssignOp(_, _, v, c) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(c, out)
    },
    ESeq(a, b) => {
      dlh_collect_performed_effect_names(a, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EWhile(c, b) => {
      dlh_collect_performed_effect_names(c, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EForIn(_, _, it, b) => {
      dlh_collect_performed_effect_names(it, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EDot(o, _, _, _) => dlh_collect_performed_effect_names(o, out),
    ELabeledArg(_, _, e) => dlh_collect_performed_effect_names(e, out),
    EReturn(e) => dlh_collect_performed_effect_names(e, out),
    EMatch(s, arms) => {
      dlh_collect_performed_effect_names(s, out)
      dlh_collect_performed_effect_names_arms(arms, out)
    },
    EHandle(s, _) => dlh_collect_performed_effect_names(s, out),
    _ => ()
  }
}

fn dlh_collect_performed_effect_names_arms(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    dlh_collect_performed_effect_names(b, out)
    i = i + 1
  }
}

fn dlh_join_comma(names: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(names) {
    if i == 0 {
      out = Array::get(names, i)
    } else {
      out = String::concat(String::concat(out, ", "), Array::get(names, i))
    }
    i = i + 1
  }
  out
}

///|
fn dlh_has_perform_arms(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    if dlh_has_perform(b) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

///|
/// Append to `bad` any free identifier of `expr` that is not `dlh_name_ok` and
/// not in `bound`. Non-empty `bad` => the lambda references a bare lowercase
/// non-top-level name (capture or bare-helper call) and must not be hoisted.
fn dlh_scan_free(expr: Expr, bound: Array[String], bad: Array[String]) -> Unit {
  match expr {
    EIdent(n, _) => if dlh_name_ok(n) || str_array_contains(bound, n) {
      ()
    } else {
      Array::push(bad, n)
    },
    EBinOp(_, l, r) => {
      dlh_scan_free(l, bound, bad)
      dlh_scan_free(r, bound, bad)
    },
    EUnaryOp(_, e) => dlh_scan_free(e, bound, bad),
    ECall(callee, args, _) => {
      dlh_scan_free(callee, bound, bad)
      let mut i = 0
      while i < Array::length(args) {
        dlh_scan_free(Array::get(args, i), bound, bad)
        i = i + 1
      }
    },
    ETuple(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    EArray(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    ESpread(e) => dlh_scan_free(e, bound, bad),
    EContinue(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_scan_free(v, bound, bad)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_scan_free(v, bound, bad)
        i = i + 1
      }
    },
    EIf(c, t, e) => {
      dlh_scan_free(c, bound, bad)
      dlh_scan_free(t, bound, bad)
      dlh_scan_free(e, bound, bad)
    },
    ELet(name, v, b, _) => {
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(b, dlh_with(bound, name), bad)
    },
    ELetRec(name, v, b) => {
      let b2 = dlh_with(bound, name)
      dlh_scan_free(v, b2, bad)
      dlh_scan_free(b, b2, bad)
    },
    ELetMut(name, v, b, _) => {
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(b, dlh_with(bound, name), bad)
    },
    EAssign(name, v, c) => {
      if dlh_name_ok(name) || str_array_contains(bound, name) {
        ()
      } else {
        Array::push(bad, name)
      }
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(c, bound, bad)
    },
    EAssignOp(name, _, v, c) => {
      if dlh_name_ok(name) || str_array_contains(bound, name) {
        ()
      } else {
        Array::push(bad, name)
      }
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(c, bound, bad)
    },
    ESeq(a, b) => {
      dlh_scan_free(a, bound, bad)
      dlh_scan_free(b, bound, bad)
    },
    EWhile(c, b) => {
      dlh_scan_free(c, bound, bad)
      dlh_scan_free(b, bound, bad)
    },
    EForIn(name, idxn, it, b) => {
      dlh_scan_free(it, bound, bad)
      let mut b2 = dlh_with(bound, name)
      b2 = match idxn {
        Some(inm) => dlh_with(b2, inm),
        None => b2
      }
      dlh_scan_free(b, b2, bad)
    },
    EDot(o, _, _, _) => dlh_scan_free(o, bound, bad),
    ELabeledArg(_, _, e) => dlh_scan_free(e, bound, bad),
    EReturn(e) => dlh_scan_free(e, bound, bad),
    EBreak(opt) => match opt {
      Some(e) => dlh_scan_free(e, bound, bad),
      None => ()
    },
    EFn(_, _, params, _, _, body) => {
      let mut inner = bound
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        inner = dlh_with(inner, dlh_strip_tilde(pn))
        i = i + 1
      }
      dlh_scan_free(body, inner, bad)
    },
    EMatch(s, arms) => {
      dlh_scan_free(s, bound, bad)
      dlh_scan_arms(arms, bound, bad)
    },
    EHandle(s, arms) => {
      dlh_scan_free(s, bound, bad)
      dlh_scan_arms(arms, bound, bad)
    },
    ELoop(params, b) => {
      let mut b2 = bound
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        dlh_scan_free(init, bound, bad)
        b2 = dlh_with(b2, pn)
        i = i + 1
      }
      dlh_scan_free(b, b2, bad)
    },
    _ => ()
  }
}

///|
fn dlh_scan_arms(arms: Array[(Pat, Expr)], bound: Array[String], bad: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    let mut ab = bound
    let pb = empty_str_array()
    collect_pat_binders(p, pb)
    let mut j = 0
    while j < Array::length(pb) {
      ab = dlh_with(ab, Array::get(pb, j))
      j = j + 1
    }
    dlh_scan_free(b, ab, bad)
    i = i + 1
  }
}

///|
/// Capture-safe substitution: EIdent(from) -> EIdent(to), stopping in subtrees
/// that rebind `from`.
fn dlh_subst(expr: Expr, from: String, to: String) -> Expr {
  match expr {
    EIdent(n, off) => if n == from {
      EIdent(to, off)
    } else {
      expr
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_subst(l, from, to), dlh_subst(r, from, to)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_subst(e, from, to)),
    ECall(callee, args, off) => ECall(dlh_subst(callee, from, to), for a in args {
      dlh_subst(a, from, to)
    }, off),
    ETuple(es) => ETuple(for e in es {
      dlh_subst(e, from, to)
    }),
    EArray(es) => EArray(for e in es {
      dlh_subst(e, from, to)
    }),
    ESpread(e) => ESpread(dlh_subst(e, from, to)),
    EContinue(es) => EContinue(for e in es {
      dlh_subst(e, from, to)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_subst(v, from, to)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_subst(v, from, to)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_subst(c, from, to), dlh_subst(t, from, to), dlh_subst(e, from, to)),
    ELet(name, v, b, soff) => ELet(name, dlh_subst(v, from, to), if name == from {
      b
    } else {
      dlh_subst(b, from, to)
    }, soff),
    ELetRec(name, v, b) => if name == from {
      ELetRec(name, v, b)
    } else {
      ELetRec(name, dlh_subst(v, from, to), dlh_subst(b, from, to))
    },
    ELetMut(name, v, b, soff) => ELetMut(name, dlh_subst(v, from, to), if name == from {
      b
    } else {
      dlh_subst(b, from, to)
    }, soff),
    EAssign(name, v, c) => EAssign(name, dlh_subst(v, from, to), dlh_subst(c, from, to)),
    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_subst(v, from, to), dlh_subst(c, from, to)),
    ESeq(a, b) => ESeq(dlh_subst(a, from, to), dlh_subst(b, from, to)),
    EWhile(c, b) => EWhile(dlh_subst(c, from, to), dlh_subst(b, from, to)),
    EForIn(name, idxn, it, b) => {
      let shadow = name == from || (match idxn {
        Some(inm) => inm == from,
        None => false
      })
      EForIn(name, idxn, dlh_subst(it, from, to), if shadow {
        b
      } else {
        dlh_subst(b, from, to)
      })
    },
    EDot(o, f, off, fdoff) => EDot(dlh_subst(o, from, to), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_subst(e, from, to)),
    EReturn(e) => EReturn(dlh_subst(e, from, to)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(dlh_subst(e, from, to))),
      None => expr
    },
    EFn(tp, bnds, params, rt, eff, body) => {
      let mut shadow = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if dlh_strip_tilde(pn) == from {
          shadow = true
        } else {
          ()
        }
        i = i + 1
      }
      if shadow {
        expr
      } else {
        EFn(tp, bnds, params, rt, eff, dlh_subst(body, from, to))
      }
    },
    EMatch(s, arms) => EMatch(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),
    EHandle(s, arms) => EHandle(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),
    ELoop(params, b) => {
      let mut shadow = false
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        if pn == from {
          shadow = true
        } else {
          ()
        }
        Array::push(out, (pn, dlh_subst(init, from, to)))
        i = i + 1
      }
      ELoop(out, if shadow {
        b
      } else {
        dlh_subst(b, from, to)
      })
    },
    _ => expr
  }
}

///|
fn dlh_subst_arms(arms: Array[(Pat, Expr)], from: String, to: String) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    let pb = empty_str_array()
    collect_pat_binders(p, pb)
    let shadow = str_array_contains(pb, from)
    Array::push(out, (p, if shadow {
      b
    } else {
      dlh_subst(b, from, to)
    }))
    i = i + 1
  }
  out
}

///|
/// #1069 follow-up: closure-conversion for a CAPTURING local effectful
/// lambda (`dlh_scan_free` found a non-empty `bad`). The plain rename
/// dlh_hoist_expr already does for the non-capturing case (dlh_subst,
/// `name` -> `fresh`) isn't enough here: every remaining occurrence of
/// `name` also needs the captured values threaded in as extra arguments,
/// which only makes sense at a CALL site -- `name` used as a bare value
/// anywhere else (passed on, stored, returned) has no sound rewrite once
/// hoisted (the hoisted top-level function now expects the captures as
/// its own leading parameters, not something a bare reference could
/// supply). Detecting "used only as a direct call target" needs the SAME
/// shadow-awareness dlh_scan_free/dlh_subst already have -- rather than
/// duplicate that scope-tracking a third time, reuse dlh_subst itself:
/// substitute `name` for a freshly-minted, globally-unique marker name
/// first (dlh_subst is already proven correct about not touching a
/// SHADOWED occurrence), then scan the marker's occurrences with a
/// deliberately simple, non-shadow-aware walk -- safe, because a fresh
/// unique marker can never collide with an unrelated binding the way
/// `name` itself could.

fn dlh_marker_only_called_directly(expr: Expr, marker: String) -> Bool {
  !dinsp_scan(expr, 4, marker)
}

/// Rewrite every `ECall(EIdent(marker), args, off)` into `ECall(EIdent(fresh),
/// extra_names_as_idents ++ args, off)` -- the captured-value arguments the
/// newly-hoisted top-level function now expects as its leading parameters,
/// each just a bare reference to the SAME name it had in the original
/// (unshadowed, per dlh_marker_only_called_directly's guarantee) enclosing
/// scope, still valid at the call site since hoisting doesn't move the call
/// site itself, only the closure's OWN body. Full traversal (marker is
/// fresh/unique, no shadowing concern, so no bound-tracking needed here).
fn dlh_prepend_and_rename_calls(expr: Expr, marker: String, fresh: String, extra_names: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(n, coff) => if n == marker {
        let extra_args = for en in extra_names {
          EIdent(en, coff)
        }
        ECall(EIdent(fresh, coff), Array::concat(extra_args, for a in args {
          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
        }), off)
      } else {
        ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {
          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
        }, off)
      },
      _ => ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {
        dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
      }, off)
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_prepend_and_rename_calls(l, marker, fresh, extra_names), dlh_prepend_and_rename_calls(r, marker, fresh, extra_names)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    ETuple(es) => ETuple(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    EArray(es) => EArray(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    ESpread(e) => ESpread(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EContinue(es) => EContinue(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(t, marker, fresh, extra_names), dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    ELet(n, v, b, soff) => ELet(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),
    ELetRec(n, v, b) => ELetRec(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    ELetMut(n, v, b, soff) => ELetMut(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),
    EAssign(n, v, c) => EAssign(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),
    ESeq(a, b) => ESeq(dlh_prepend_and_rename_calls(a, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EWhile(c, b) => EWhile(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, dlh_prepend_and_rename_calls(it, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EDot(o, f, off, fdoff) => EDot(dlh_prepend_and_rename_calls(o, marker, fresh, extra_names), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EReturn(e) => EReturn(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EBreak(opt) => EBreak(match opt {
      Some(e) => Some(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
      None => None
    }),
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_prepend_and_rename_calls(body, marker, fresh, extra_names)),
    EMatch(s, arms) => EMatch(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {
      let (p, b) = a
      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))
    }),
    EHandle(s, arms) => EHandle(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {
      let (p, b) = a
      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))
    }),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, dlh_prepend_and_rename_calls(init, marker, fresh, extra_names))
    }, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    _ => expr
  }
}

fn dlh_dedup_names(names: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, i)
    if str_array_contains(out, n) {
      ()
    } else {
      Array::push(out, n)
    }
    i = i + 1
  }
  out
}

/// Closure conversion passes each captured name's CURRENT VALUE at the call
/// site as a plain argument -- correct only if that value can never diverge
/// from what a genuine reference-capturing closure would have seen, i.e.
/// the captured name is never reassigned anywhere the conversion could
/// observe (`let mut base = ...` captured and later mutated, or mutated
/// again inside the closure's OWN body such that the mutation should be
/// visible to code after the call, would silently do the WRONG thing under
/// pass-by-value). Deliberately conservative: flags `names` as unsafe if
/// EITHER `fbody` (the closure's own body) or `rest` (everything after the
/// closure definition, where call sites live) reassigns any of them via
/// `EAssign`/`EAssignOp`, regardless of whether the original declaration
/// was `let` or `let mut` -- simpler than tracking declaration-site
/// mutability precisely, and every bit as safe: nothing to observe
/// diverging means pass-by-value and capture-by-reference are behaviorally
/// identical for this specific program, whatever the declaration said.
fn dlh_names_ever_assigned(expr: Expr, names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = dinsp_scan(expr, 5, Array::get(names, i))
    i = i + 1
  }
  found
}

/// A closure literal's DECLARED effect row is non-empty.
///
/// #1385: the IIFE normalization below used `dlh_has_perform` alone to
/// decide "is this literal effectful enough to deserve a name". That asks
/// whether the body performs DIRECTLY, so a literal that carries a row but
/// discharges it by CALLING a row-carrying function (`() -> Int with E
/// { helper(1) }`) answered no and kept its anonymous IIFE shape. The
/// evidence-dict pass then rejected the whole effect, because
/// edp_has_unsafe_construct treats every call whose callee is not a bare
/// identifier as opaque -- an IIFE is exactly that. Reading the declared
/// row instead of the body catches the delegating case while leaving the
/// derive(Eq)/derive(Ord) comparator closures that motivated the narrow
/// gate (see dlh_args_have_literal_efn's doc comment) untouched: those are
/// pure and carry no row at all.
///
/// Deliberately NOT used for the ELet hoist decision, which stays on
/// `dlh_has_perform`. Naming a literal is semantics-preserving; RELOCATING
/// one to the top level is not (that gate's own comment records a
/// suberror-ctor scoping break), so widening this must not widen that.
fn dlh_row_is_effectful(eff: Option[String]) -> Bool {
  match eff {
    Some(s) => String::trim(s) != "",
    None => false
  }
}

///|
/// Only ever matches an EFFECTFUL literal (dlh_has_perform on its body) --
/// found via a live regression (2026-07-23, fixtures/eq_array_option_fields_test.vibe
/// trapping "unreachable" in a derive(Eq)-generated equality helper, bisected
/// to this fix's own introducing commit): the original unguarded version
/// matched ANY literal EFn argument, including the PURE comparator closures
/// derive(Eq)/derive(Ord) generate for Array/Option/tuple field comparisons.
/// Wrapping a pure closure in a synthetic let-binding was assumed harmless
/// (closure construction has no side effects), but something downstream
/// (likely type inference/monomorphization for the generic higher-order
/// comparator call) broke when the literal stopped appearing directly at
/// the call site. Scoping this to effectful literals only -- exactly
/// mirroring dlh_hoist_expr's own ELet branch, which has always required
/// dlh_has_perform before touching a closure at all -- keeps every pure
/// closure completely untouched by this pass, restoring the pre-existing
/// (working) behavior for that case while keeping the IIFE/HOF-arg fix
/// for genuinely effectful literals.
fn dlh_args_have_literal_efn(args: Array[Expr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(args) && !found {
    match Array::get(args, i) {
      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
        found = true
      } else {
        ()
      },
      // A labeled argument (`with_log(f = () -> ... { perform ... })`,
      // cheatsheet "Labeled arguments") wraps the literal in ELabeledArg --
      // found via testing this exact syntax against the IIFE/HOF-arg fix
      // above (2026-07-23): it still crashed, since this check only
      // matched a BARE EFn, not one hiding one layer deeper inside a label
      // wrapper. Recurse one layer to catch it too.
      ELabeledArg(_, _, inner) => match inner {
        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
          found = true
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

///|
/// Rewrites `callee(args...)` so every DIRECT `EFn` literal in `args` --
/// bare, or one layer inside an `ELabeledArg` wrapper (`f = () -> ...`) --
/// is let-bound immediately before the call, left-to-right (same evaluation
/// order as the literal appearing inline): `callee(a, <lit>, b)` becomes
/// `let __dlh_arglit_N = <lit>; callee(a, __dlh_arglit_N, b)`; a labeled
/// literal `callee(f = <lit>)` becomes
/// `let __dlh_arglit_N = <lit>; callee(f = __dlh_arglit_N)` (the label
/// wrapper is preserved, only its inner value is replaced). Non-literal
/// args are left untouched. See dlh_args_have_literal_efn's call site
/// (dlh_hoist_expr's ECall case) for why this exists.
fn dlh_letbind_literal_args(callee: Expr, args: Array[Expr], off: Int, ctr: Array[Int]) -> Expr {
  let new_args = array_empty()
  let lits = array_empty()
  let mut i = 0
  while i < Array::length(args) {
    let a = Array::get(args, i)
    match a {
      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
        let idx = Array::get(ctr, 0)
        Array::set(ctr, 0, idx + 1)
        let nm = "__dlh_arglit_\{idx}"
        Array::push(lits, (nm, a))
        Array::push(new_args, EIdent(nm, off))
      } else {
        Array::push(new_args, a)
      },
      ELabeledArg(lbl, mname, inner) => match inner {
        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let nm = "__dlh_arglit_\{idx}"
          Array::push(lits, (nm, inner))
          Array::push(new_args, ELabeledArg(lbl, mname, EIdent(nm, off)))
        } else {
          Array::push(new_args, a)
        },
        _ => Array::push(new_args, a)
      },
      other => Array::push(new_args, other)
    }
    i = i + 1
  }
  let mut wrapped = ECall(callee, new_args, off)
  let mut k = Array::length(lits) - 1
  while k >= 0 {
    let (nm, lit) = Array::get(lits, k)
    wrapped = ELet(nm, lit, wrapped, off)
    k = k - 1
  }
  wrapped
}

///|
fn dlh_hoist_expr(expr: Expr, hoisted: Array[Stmt], ctr: Array[Int]) -> Expr {
  match expr {
    ELet(name, v, b, soff) => match v {
      EFn(tp, bnds, params, rt, eff, fbody) => {
        // Backfill a missing (unannotated) effect row from what the body
        // actually performs BEFORE hoisting: a hoisted top-level function's
        // row is what evidence_dict_pass's needing-classification reads
        // (codegen/common_base/inline_direct_perform.vibe's
        // edp_collect_fn_defs), so silently keeping `eff = None` here made
        // an effect-performing hoisted closure invisible to that pass --
        // see dlh_collect_performed_effect_names' doc comment for the full
        // history (found via gc-backend coverage testing, 2026-07-23).
        // Only fires when `eff` is genuinely absent; an explicit user-
        // written row (however it's spelled) is left untouched.
        let eff_is_blank = match eff {
          None => true,
          Some(es) => String::trim(es) == ""
        }
        let eff_fixed = if eff_is_blank {
          let performed = empty_str_array()
          dlh_collect_performed_effect_names(fbody, performed)
          if Array::length(performed) == 0 {
            eff
          } else {
            Some(dlh_join_comma(performed))
          }
        } else {
          eff
        }
        let hoisted_fn = dlh_hoist_expr(EFn(tp, bnds, params, rt, eff_fixed, fbody), hoisted, ctr)
        let rest = dlh_hoist_expr(b, hoisted, ctr)
        let bad = empty_str_array()
        let mut pb = empty_str_array()
        let mut i = 0
        while i < Array::length(params) {
          let (pn, _) = Array::get(params, i)
          pb = dlh_with(pb, dlh_strip_tilde(pn))
          i = i + 1
        }
        match hoisted_fn {
          EFn(_, _, _, _, _, hb) => dlh_scan_free(hb, pb, bad),
          _ => ()
        }
        let hoistable = dlh_has_perform(fbody) && Array::length(bad) == 0
        if hoistable {
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let fresh = "__hoisted_lam_\{idx}_\{name}"
          Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn))
          dlh_subst(rest, name, fresh)
        } else if dlh_has_perform(fbody) && Array::length(bad) > 0 {
          // #1069: `bad` is non-empty (the lambda captures at least one
          // ordinary enclosing local) but it still performs -- the exact
          // shape #786's own landed fix declined to touch, still hitting
          // the original unregistered-closure-type/broken-combinator bug
          // unless something else routes it around that path. Attempt
          // closure conversion (see dlh_prepend_and_rename_calls' doc
          // comment) rather than leaving it on the broken path
          // unconditionally: only when every call site can be proven safe
          // to rewrite (dlh_marker_only_called_directly, via dlh_subst's
          // already-proven shadow-correctness). Falls through to the
          // ORIGINAL (unchanged, currently-broken-for-this-shape) local-let
          // behavior when it can't -- never worse than before this change,
          // only sometimes better.
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let marker = "__dlh_cc_marker_\{idx}"
          let rest_marked = dlh_subst(rest, name, marker)
          let captured = dlh_dedup_names(bad)
          if dlh_marker_only_called_directly(rest_marked, marker) && !dlh_names_ever_assigned(fbody, captured) && !dlh_names_ever_assigned(rest, captured) {
            let extra_params = for cn in captured {
              (cn, None)
            }
            let new_params = Array::concat(extra_params, params)
            let hoisted_fn2 = match hoisted_fn {
              EFn(tp2, bnds2, _, rt2, eff2, hb2) => EFn(tp2, bnds2, new_params, rt2, eff2, hb2),
              _ => hoisted_fn
            }
            let fresh = "__hoisted_lam_\{idx}_\{name}"
            Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn2))
            dlh_prepend_and_rename_calls(rest_marked, marker, fresh, captured)
          } else {
            ELet(name, hoisted_fn, rest, soff)
          }
        } else {
          ELet(name, hoisted_fn, rest, soff)
        }
      },
      _ => ELet(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff)
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_hoist_expr(l, hoisted, ctr), dlh_hoist_expr(r, hoisted, ctr)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_hoist_expr(e, hoisted, ctr)),
    // A bare IIFE -- `(() -> ... { perform ... })()` -- calls an `EFn`
    // literal directly with NO enclosing `ELet` at all. Every hoist/
    // closure-conversion rule above (capture-free hoist, #1069's
    // capturing-closure conversion) pattern-matches specifically on
    // `ELet(name, EFn(...), body)`, so this shape evaded all of them and
    // fell straight through to the pre-#786 broken local-closure+effect
    // combinator path -- an effectful IIFE with ZERO captures produced
    // invalid wasm ("invalid signature index") at compile time, found via
    // testing effect_row_open.vibe-adjacent higher-order-function shapes
    // (2026-07-23). Fix: desugar the IIFE into the ALREADY-handled
    // `ELet(fresh, EFn(...), fresh())` shape and re-enter this same
    // function -- reuses 100% of the existing, separately-verified
    // ELet/EFn logic above with no new closure-conversion code.
    ECall(callee, args, off) => match callee {
      EFn(_, _, _, _, ceff, cfbody) => if dlh_has_perform(cfbody) || dlh_row_is_effectful(ceff) {
        let idx = Array::get(ctr, 0)
        Array::set(ctr, 0, idx + 1)
        let iife_name = "__dlh_iife_\{idx}"
        dlh_hoist_expr(ELet(iife_name, callee, ECall(EIdent(iife_name, off), args, off), off), hoisted, ctr)
      } else {
        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {
          dlh_hoist_expr(a, hoisted, ctr)
        }, off)
      },
      _ => if dlh_args_have_literal_efn(args) {
        // An inline `EFn` literal passed as a CALL ARGUMENT (not the
        // callee) to an ordinary (non-trivial-wrapper) named function --
        // `with_log(() -> Int with Log { perform ...; 42 })` where
        // `with_log`'s own body genuinely calls its parameter internally
        // (`handle { f() } with Log { .. }`), not merely a same-arity
        // forward `dtpw_inline_trivial_wrappers` (#1070) would already
        // reduce to an IIFE. Verified via direct A/B testing (2026-07-23)
        // that a NAMED closure (top-level, or already hoisted) passed the
        // exact same way to the exact same `with_log` already works fine
        // -- confirming the crash is specific to the literal itself
        // having no name for any hoist/closure-conversion rule to latch
        // onto, not to anything about `with_log`. Fix: synthesize a let-
        // binding for each literal-EFn argument immediately before this
        // call (semantics-preserving -- same left-to-right evaluation
        // order as the literal appearing inline) so the existing ELet/EFn
        // hoist logic above turns it into an ordinary named function
        // reference, exactly like the already-working named-closure case.
        dlh_hoist_expr(dlh_letbind_literal_args(callee, args, off, ctr), hoisted, ctr)
      } else {
        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {
          dlh_hoist_expr(a, hoisted, ctr)
        }, off)
      }
    },
    ETuple(es) => ETuple(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    EArray(es) => EArray(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    ESpread(e) => ESpread(dlh_hoist_expr(e, hoisted, ctr)),
    EContinue(es) => EContinue(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(t, hoisted, ctr), dlh_hoist_expr(e, hoisted, ctr)),
    ELetRec(name, v, b) => ELetRec(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    ELetMut(name, v, b, soff) => ELetMut(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff),
    EAssign(name, v, c) => EAssign(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),
    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),
    ESeq(a, b) => ESeq(dlh_hoist_expr(a, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EWhile(c, b) => EWhile(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EForIn(name, idxn, it, b) => EForIn(name, idxn, dlh_hoist_expr(it, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EDot(o, f, off, fdoff) => EDot(dlh_hoist_expr(o, hoisted, ctr), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_hoist_expr(e, hoisted, ctr)),
    EReturn(e) => EReturn(dlh_hoist_expr(e, hoisted, ctr)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(dlh_hoist_expr(e, hoisted, ctr))),
      None => expr
    },
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_hoist_expr(body, hoisted, ctr)),
    EMatch(s, arms) => EMatch(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),
    EHandle(s, arms) => EHandle(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),
    ELoop(params, b) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        Array::push(out, (pn, dlh_hoist_expr(init, hoisted, ctr)))
        i = i + 1
      }
      ELoop(out, dlh_hoist_expr(b, hoisted, ctr))
    },
    _ => expr
  }
}

///|
fn dlh_hoist_arms(arms: Array[(Pat, Expr)], hoisted: Array[Stmt], ctr: Array[Int]) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    Array::push(out, (p, dlh_hoist_expr(b, hoisted, ctr)))
    i = i + 1
  }
  out
}

///|
fn dlh_hoist_stmt(stmt: Stmt, hoisted: Array[Stmt], ctr: Array[Int]) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, dlh_hoist_expr(body, hoisted, ctr)),
    SLetMut(name, ty, body) => SLetMut(name, ty, dlh_hoist_expr(body, hoisted, ctr)),
    STest(name, body) => STest(name, dlh_hoist_expr(body, hoisted, ctr)),
    SBench(name, body) => SBench(name, dlh_hoist_expr(body, hoisted, ctr)),
    SExpr(e) => SExpr(dlh_hoist_expr(e, hoisted, ctr)),
    SLetPat(pat, e) => SLetPat(pat, dlh_hoist_expr(e, hoisted, ctr)),
    _ => stmt
  }
}

///|
/// In-place hoisting of non-capturing effectful local lambdas across the program.
export fn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit {
  let hoisted = array_empty()
  let ctr = [0]
  let n = Array::length(stmts)
  let mut i = 0
  while i < n {
    Array::set(stmts, i, dlh_hoist_stmt(Array::get(stmts, i), hoisted, ctr))
    i = i + 1
  }
  let mut h = 0
  while h < Array::length(hoisted) {
    Array::push(stmts, Array::get(hoisted, h))
    h = h + 1
  }
}

///|
/// Labeled-argument reordering. Named args are order-independent — `f(y=2, x=1)`
/// binds x=1, y=2 (cheatsheet "Labeled arguments"). Codegen strips ELabeledArg
/// labels and binds positionally, so a call given out of declared order used to
/// bind by position (silently wrong; `add`-style commutative calls masked it).
/// This pass reorders a FULLY-labeled call's args into the callee's declared
/// parameter order. It fires when the callee is a top-level let-bound function
/// (#986: ANY such function — a plain `fn add(x: Int, y: Int)` too, not just
/// `~`-labeled declarations; `fn` decls lower to `SLet` + `EFn` before this
/// pass, and a fully-labeled call names the parameters either way) and every
/// arg is an ELabeledArg naming one of its params; any other shape (positional,
/// partial, unknown callee) is left untouched, so positional binding is
/// unchanged.
fn strip_label_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

///|
/// fname -> ordered param base names, for every top-level `let f = (..) -> ..`
/// (#986: labeled or not — see the pass comment above).
fn collect_fn_param_labels(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, params, _, _, _) => {
          let labels = empty_str_array()
          let mut pi = 0
          while pi < Array::length(params) {
            let (pn, _) = Array::get(params, pi)
            Array::push(labels, strip_label_tilde(pn))
            pi = pi + 1
          }
          Array::push(out, (fname, labels))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

///|
/// #1500: `fname -> per-parameter "is optional"` flags, consulted by the ECall
/// arm of `relabel_expr`. A module cell rather than another threaded parameter
/// because `relabel_expr` recurses from ~30 sites; same shape as the other
/// per-program tables in this file (`afe_field_types_cell`, `throw_kind_cell`).
let optional_param_tbl_cell: Array[Array[(String, Array[Bool])]] = array_empty()

///|
fn optional_param_tbl_set(tbl: Array[(String, Array[Bool])]) -> Unit {
  Array::truncate(optional_param_tbl_cell, 0)
  Array::push(optional_param_tbl_cell, tbl)
}

///|
fn optional_param_flags(fname: String) -> Option[Array[Bool]] {
  if Array::length(optional_param_tbl_cell) == 0 {
    None
  } else {
    let tbl = Array::get(optional_param_tbl_cell, 0)
    let mut i = 0
    let mut found = None
    while i < Array::length(tbl) {
      let (n, flags) = Array::get(tbl, i)
      if n == fname {
        found = Some(flags)
        i = Array::length(tbl)
      } else {
        i = i + 1
      }
    }
    found
  }
}

// #1952: block-local `let o = (a, b?) -> ...` is in `shadows`, so the
// top-level table must not apply — but the local function still needs fill.
// Innermost binding wins; leave pops with the matching `shadows` mark.
let optional_param_local_cell: Array[(String, Array[Bool])] = array_empty()

fn efn_optional_flags(e: Expr) -> Option[Array[Bool]] {
  match e {
    EFn(_, _, params, _, _, _) => {
      let flags = array_empty()
      let mut any = false
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, _) = Array::get(params, pi)
        let pl = String::length(pn)
        let is_opt = pl > 0 && pn[pl - 1: pl] == "?"
        if is_opt {
          any = true
        } else {
          ()
        }
        Array::push(flags, is_opt)
        pi = pi + 1
      }
      if any {
        Some(flags)
      } else {
        None
      }
    },
    _ => None
  }
}

fn optional_flags_any(flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut any = false
  while i < Array::length(flags) {
    if Array::get(flags, i) {
      any = true
    } else {
      ()
    }
    i = i + 1
  }
  any
}

fn optional_local_enter(name: String, v: Expr) -> Int {
  let mark = Array::length(optional_param_local_cell)
  match efn_optional_flags(v) {
    Some(flags) => Array::push(optional_param_local_cell, (name, flags)),
    None => Array::push(optional_param_local_cell, (name, array_empty()))
  }
  mark
}

fn optional_local_enter_names(shadows: Array[String], from: Int) -> Int {
  let mark = Array::length(optional_param_local_cell)
  let mut i = from
  while i < Array::length(shadows) {
    Array::push(optional_param_local_cell, (Array::get(shadows, i), array_empty()))
    i = i + 1
  }
  mark
}

fn optional_local_replace(name: String, v: Expr) -> Unit {
  let mut i = Array::length(optional_param_local_cell)
  while i > 0 {
    i = i - 1
    let (n, _) = Array::get(optional_param_local_cell, i)
    if n == name {
      match efn_optional_flags(v) {
        Some(flags) => Array::set(optional_param_local_cell, i, (name, flags)),
        None => Array::set(optional_param_local_cell, i, (name, array_empty()))
      }
      i = 0
    } else {
      ()
    }
  }
}

fn optional_local_leave(mark: Int) -> Unit {
  Array::truncate(optional_param_local_cell, mark)
}

fn optional_local_flags(fname: String) -> Option[Array[Bool]] {
  let mut i = Array::length(optional_param_local_cell)
  let mut found = None
  while i > 0 {
    i = i - 1
    let (n, flags) = Array::get(optional_param_local_cell, i)
    if n == fname {
      found = Some(flags)
      i = 0
    } else {
      ()
    }
  }
  found
}

fn optional_flags_for_call(fname: String, shadows: Array[String]) -> Option[Array[Bool]] {
  match optional_local_flags(fname) {
    Some(flags) => if optional_flags_any(flags) {
      Some(flags)
    } else {
      None
    },
    None => if str_array_contains(shadows, fname) {
      None
    } else {
      optional_param_flags(fname)
    }
  }
}

fn stmts_have_optional_fn(_stmts: Array[Stmt]) -> Bool {
  // Nested `let o = (a, b?) ->` leaves no top-level table entry. Walking
  // every statement is cheap next to typecheck and is what makes #1952
  // work in a file that has no top-level optional fn.
  true
}

///|
/// #1899/#1952: the labels and optional flags of lambdas bound by a `let`
/// INSIDE a block, which the two top-level tables above cannot see.
///
/// `collect_fn_param_labels` and `collect_optional_param_fns` both index
/// top-level statements only, and the `ECall` arm of `relabel_expr` bails out
/// for any callee found in `shadows`. That bail-out is right as far as it goes
/// -- do not apply a top-level function's labels to a local binding that
/// merely shares its name -- but it left a local labeled lambda with no table
/// at all, so nothing reordered its arguments and nothing filled in its
/// omitted optionals. Both failed silently at first: written-order arguments
/// compiled and ran (#1899, P0), and an omitted optional reached the checker
/// as `function arity mismatch` (#1952, P1).
///
/// A module cell for the same reason `optional_param_tbl_cell` is one:
/// `relabel_expr` recurses from ~30 sites.
///
/// Each entry records the index its name occupies in `shadows`, and that is
/// what makes shadowing work. A later binding of the same name -- `let s = 5`
/// after `let s = (x~: Int) -> ...`, a parameter, a match binder -- pushes
/// onto `shadows` at a higher index, so this entry is no longer the innermost
/// binding of that name, the lookup below rejects it, and the old bail-out
/// stands. Without the index a local lambda's labels would leak onto a
/// completely unrelated value that happens to reuse its name.
let local_fn_tbl_cell: Array[(String, Array[String], Array[Bool], Int)] = array_empty()

///|
/// Record a `let`-bound lambda's parameter shape. Non-lambda bindings are
/// deliberately not recorded: they have no labels, and their presence in
/// `shadows` is what masks any outer entry.
fn local_fn_tbl_shape(v: Expr) -> Option[(Array[String], Array[Bool])] {
  match v {
    EFn(_, _, params, _, _, _) => {
      let labels = empty_str_array()
      let flags = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        // strip_label_tilde removes a trailing `~` OR `?`, so an optional
        // parameter contributes its bare name as a label as well as its flag.
        Array::push(labels, strip_label_tilde(pn))
        let pl = String::length(pn)
        Array::push(flags, pl > 0 && __slice(pn, pl - 1, pl) == "?")
        i = i + 1
      }
      Some((labels, flags))
    },
    _ => None
  }
}

fn local_fn_tbl_push(name: String, v: Expr, at: Int) -> Unit {
  match local_fn_tbl_shape(v) {
    Some((labels, flags)) => Array::push(local_fn_tbl_cell, (name, labels, flags, at)),
    None => ()
  }
}

/// #1994: sequential `g = (y~, x~) -> ...` updates the entry for the
/// innermost `g`. A non-lambda RHS invalidates it. Assignment inside a
/// branch still only reaches that branch's continuation.
fn local_fn_tbl_replace(name: String, v: Expr, shadows: Array[String]) -> Unit {
  let innermost = innermost_shadow_index(name, shadows)
  if innermost < 0 {
    ()
  } else if unstable_mut_tbl_lookup(name, shadows) {
    // Already unresolvable (a branch, loop or closure re-labelled it). Putting
    // an entry back would hand a labeled call the labels of whichever
    // assignment the WALK reached last.
    ()
  } else {
    let mut j = Array::length(local_fn_tbl_cell) - 1
    let mut found = false
    let mut changed = false
    while j >= 0 {
      let (n, old_labels, _, at) = Array::get(local_fn_tbl_cell, j)
      if n == name && at == innermost {
        match local_fn_tbl_shape(v) {
          Some((labels, flags)) => {
            changed = !labels_equal(labels, old_labels)
            Array::set(local_fn_tbl_cell, j, (name, labels, flags, at))
          },
          None => {
            changed = Array::length(old_labels) > 0
            Array::set(local_fn_tbl_cell, j, (name, empty_str_array(), array_empty(), at))
          }
        }
        found = true
        j = 0 - 1
      } else {
        j = j - 1
      }
    }
    if !found {
      local_fn_tbl_push(name, v, innermost)
      // Whatever labels the binding has now came from here, so a subtree that
      // does not dominate the rest must not keep them either.
      changed = true
    } else {
      ()
    }
    if changed {
      Array::push(relabel_assigned_cell, (name, innermost))
    } else {
      ()
    }
  }
}

///|
fn local_fn_tbl_truncate(mark: Int) -> Unit {
  Array::truncate(local_fn_tbl_cell, mark)
}

///|
/// A lambda's parameter labels, in declared order, or None for anything else.
fn efn_param_labels(v: Expr) -> Option[Array[String]] {
  match v {
    EFn(_, _, params, _, _, _) => {
      let labels = empty_str_array()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        Array::push(labels, strip_label_tilde(pn))
        i = i + 1
      }
      Some(labels)
    },
    _ => None
  }
}

///|
fn str_arrays_equal(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(a) {
      if Array::get(a, i) != Array::get(b, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

///|
fn params_bind_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if strip_label_tilde(pn) == name {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

///|
fn pat_binds_name(p: Pat, name: String) -> Bool {
  let binders = empty_str_array()
  collect_pat_binders(p, binders)
  str_array_contains(binders, name)
}

///|
/// The arms whose pattern does NOT take `name` over -- the only ones whose body
/// can still assign to the binding being scanned.
fn arms_not_binding(arms: Array[(Pat, Expr)], name: String, labels: Array[String]) -> Bool {
  let mut i = 0
  let mut broken = false
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    if !broken && !pat_binds_name(p, name) && mut_binding_labels_broken(body, name, labels) {
      broken = true
    } else {
      ()
    }
    i = i + 1
  }
  broken
}

///|
fn loop_binds_broken(binds: Array[(String, Expr)], name: String, labels: Array[String]) -> Bool {
  let mut i = 0
  let mut broken = false
  while i < Array::length(binds) {
    let (_, init) = Array::get(binds, i)
    if !broken && mut_binding_labels_broken(init, name, labels) {
      broken = true
    } else {
      ()
    }
    i = i + 1
  }
  broken
}

///|
fn loop_binds_name(binds: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(binds) {
    let (bn, _) = Array::get(binds, i)
    if bn == name {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

///|
/// #1994: can every value `name` holds inside `body` be described by `labels`?
///
/// A `let mut` binding is the one local shape whose value is not its
/// initializer, so the reason #1899/#1952 could register an immutable `let`
/// from its initializer alone does not carry over: reassigning a lambda with
/// DIFFERENT parameter names would leave a table that reorders a later call by
/// stale names. Tracking that per call site needs flow analysis, since an
/// assignment inside a branch or a loop reaches only its own continuation while
/// a later call sits in a sibling subtree.
///
/// This asks the flow-INSENSITIVE question instead, which needs no analysis and
/// is sound under every control flow: does the whole scope agree on the labels?
/// It does when every assignment to `name` binds a lambda declaring the same
/// parameter names in the same order -- reassignment is then invisible to
/// argument reordering, and the initializer's labels describe every value the
/// binding can hold. A non-lambda assigned, different names, or a compound
/// assignment answers false, and the caller leaves the binding unregistered
/// exactly as before.
///
/// An inner binding that takes the name over is NOT a break: an assignment
/// inside its scope names the inner binding, not this one. The walk skips those
/// subtrees rather than giving up on the whole scope, which is the difference
/// between resolving and rejecting `let mut g = ..; g(x = 1, y = 2); let g = 5`.
fn mut_binding_labels_stable(body: Expr, name: String, labels: Array[String]) -> Bool {
  !mut_binding_labels_broken(body, name, labels)
}

///|
fn mut_binding_labels_broken(e: Expr, name: String, labels: Array[String]) -> Bool {
  match e {
    // A binder's initializer is evaluated in the OUTER scope, so it is still
    // scanned; only the subtree the new binding covers is skipped.
    ELet(n, val, body, _) => mut_binding_labels_broken(val, name, labels) || (n != name && mut_binding_labels_broken(body, name, labels)),
    ELetMut(n, val, body, _) => mut_binding_labels_broken(val, name, labels) || (n != name && mut_binding_labels_broken(body, name, labels)),
    // `let rec` is in scope inside its own value, so both children are covered.
    ELetRec(n, val, body) => n != name && (mut_binding_labels_broken(val, name, labels) || mut_binding_labels_broken(body, name, labels)),
    EFn(_, _, params, _, _, body) => !params_bind_name(params, name) && mut_binding_labels_broken(body, name, labels),
    EForIn(n, idx, iter, body) => {
      let shadowed = n == name || match idx {
        Some(ix) => ix == name,
        None => false
      }
      mut_binding_labels_broken(iter, name, labels) || (!shadowed && mut_binding_labels_broken(body, name, labels))
    },
    ELoop(binds, body) => loop_binds_broken(binds, name, labels) || (!loop_binds_name(binds, name) && mut_binding_labels_broken(body, name, labels)),
    EMatch(scrut, arms) => mut_binding_labels_broken(scrut, name, labels) || arms_not_binding(arms, name, labels),
    EHandle(body, arms) => mut_binding_labels_broken(body, name, labels) || arms_not_binding(arms, name, labels),
    EAssign(n, v, cont) => {
      let here = if n == name {
        match efn_param_labels(v) {
          Some(assigned) => !str_arrays_equal(assigned, labels),
          None => true
        }
      } else {
        false
      }
      here || mut_binding_labels_broken(v, name, labels) || mut_binding_labels_broken(cont, name, labels)
    },
    EAssignOp(n, _, v, cont) => n == name || mut_binding_labels_broken(v, name, labels) || mut_binding_labels_broken(cont, name, labels),
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      let mut broken = false
      while i < Array::length(kids) {
        if broken {
          i = Array::length(kids)
        } else {
          if mut_binding_labels_broken(Array::get(kids, i), name, labels) {
            broken = true
          } else {
            ()
          }
          i = i + 1
        }
      }
      broken
    }
  }
}

///|
/// #1994: `let mut` lambda bindings whose scope does NOT agree on the labels,
/// with the index the name occupies in `shadows` -- same innermost-binding
/// discipline as `local_fn_tbl_cell` above. A labeled call to one of these has
/// no resolution at all, so it must be reported rather than left to bind in
/// written order, which is right only by luck.
let unstable_mut_tbl_cell: Array[(String, Int)] = array_empty()

///|
/// Every assignment that CHANGED a binding's labels, as (name, index in
/// `shadows`). A subtree whose walk does not dominate what follows notes the
/// length on entry and hands what its walk appended to
/// `poison_branch_assignments` on the way out. An assignment that re-binds the
/// same parameter names is not recorded: it changes nothing a labeled call can
/// observe, so it must not cost the binding its labels.
let relabel_assigned_cell: Array[(String, Int)] = array_empty()

///|
fn innermost_shadow_index(name: String, shadows: Array[String]) -> Int {
  let mut innermost = 0 - 1
  let mut i = 0
  while i < Array::length(shadows) {
    if Array::get(shadows, i) == name {
      innermost = i
    }
    i = i + 1
  }
  innermost
}

///|
fn labels_equal(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(a) {
      if Array::get(a, i) != Array::get(b, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

///|
fn local_fn_tbl_remove(name: String, at: Int) -> Unit {
  let kept = array_empty()
  let mut i = 0
  while i < Array::length(local_fn_tbl_cell) {
    let entry = Array::get(local_fn_tbl_cell, i)
    let (n, _, _, a) = entry
    if n == name && a == at {
      ()
    } else {
      Array::push(kept, entry)
    }
    i = i + 1
  }
  Array::truncate(local_fn_tbl_cell, 0)
  let mut j = 0
  while j < Array::length(kept) {
    Array::push(local_fn_tbl_cell, Array::get(kept, j))
    j = j + 1
  }
}

///|
/// Leaving a subtree whose walk does not dominate what follows -- an `if` arm,
/// a loop body, a closure body. Every binding it re-labelled and did not itself
/// introduce (`at < mark`, the length of `shadows` on entry) loses its entry,
/// because from here on nothing knows which lambda the binding holds. The
/// continuation-only update `local_fn_tbl_replace` performs is exact while the
/// assignment dominates what follows; this is where that stops being true.
fn poison_branch_assignments(from: Int, mark: Int) -> Unit {
  let mut i = from
  while i < Array::length(relabel_assigned_cell) {
    let (n, at) = Array::get(relabel_assigned_cell, i)
    if at < mark {
      local_fn_tbl_remove(n, at)
      unstable_mut_tbl_push(n, at)
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(relabel_assigned_cell, from)
}

///|
fn unstable_mut_tbl_push(name: String, at: Int) -> Unit {
  Array::push(unstable_mut_tbl_cell, (name, at))
}

///|
fn unstable_mut_tbl_truncate(mark: Int) -> Unit {
  Array::truncate(unstable_mut_tbl_cell, mark)
}

///|
/// Call sites drained by the checker (`unresolved_mut_labeled_calls`), as
/// (callee name, callee offset).
let unresolved_mut_labeled_cell: Array[(String, Int)] = array_empty()

///|
/// The labeled calls this pass could not resolve because their callee is a
/// `let mut` binding whose scope disagrees about its parameter names. Drained
/// by `check_program` right after `desugar_labeled_args`, which is the only
/// caller that owns a diagnostics channel; every other caller re-runs the pass
/// and clears the cell at entry.
export fn unresolved_mut_labeled_calls() -> Array[(String, Int)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(unresolved_mut_labeled_cell) {
    Array::push(out, Array::get(unresolved_mut_labeled_cell, i))
    i = i + 1
  }
  out
}

///|
/// Is `fname`'s innermost binding an unstable `let mut` lambda?
fn unstable_mut_tbl_lookup(fname: String, shadows: Array[String]) -> Bool {
  let mut innermost = 0 - 1
  let mut i = 0
  while i < Array::length(shadows) {
    if Array::get(shadows, i) == fname {
      innermost = i
    }
    i = i + 1
  }
  if innermost < 0 {
    false
  } else {
    let mut j = Array::length(unstable_mut_tbl_cell) - 1
    let mut found = false
    while j >= 0 {
      let (n, at) = Array::get(unstable_mut_tbl_cell, j)
      if n == fname && at == innermost {
        found = true
        j = 0 - 1
      } else {
        j = j - 1
      }
    }
    found
  }
}

///|
/// The entry for `fname`, but only when it is still the innermost binding of
/// that name. Returns (labels, optional flags).
fn local_fn_tbl_lookup(fname: String, shadows: Array[String]) -> Option[(Array[String], Array[Bool])] {
  let mut innermost = 0 - 1
  let mut i = 0
  while i < Array::length(shadows) {
    if Array::get(shadows, i) == fname {
      innermost = i
    }
    i = i + 1
  }
  if innermost < 0 {
    None
  } else {
    let mut j = Array::length(local_fn_tbl_cell) - 1
    let mut found = None
    while j >= 0 {
      let (n, labels, flags, at) = Array::get(local_fn_tbl_cell, j)
      if n == fname && at == innermost {
        found = Some((labels, flags))
        j = 0 - 1
      } else {
        j = j - 1
      }
    }
    found
  }
}

///|
/// Every top-level function that declares at least one optional (`z?`)
/// parameter, with one flag per parameter. Functions with no optional
/// parameter are left out so the ECall arm's lookup misses immediately for
/// the entire rest of the program.
fn collect_optional_param_fns(stmts: Array[Stmt]) -> Array[(String, Array[Bool])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, params, _, _, _) => {
          let flags = array_empty()
          let mut any = false
          let mut pi = 0
          while pi < Array::length(params) {
            let (pn, _) = Array::get(params, pi)
            let pl = String::length(pn)
            let is_opt = pl > 0 && pn[pl - 1: pl] == "?"
            if is_opt {
              any = true
            } else {
              ()
            }
            Array::push(flags, is_opt)
            pi = pi + 1
          }
          if any {
            Array::push(out, (fname, flags))
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

///|
/// True when `e` already denotes an `Option` at the syntax level, so a second
/// run of this pass would not double-wrap. The pass is called exactly once
/// (checker_stmt.vibe, right after desugar_labeled_args) -- this is a belt for
/// the case where a future caller adds a second run, matching the "in-place and
/// idempotent" property the neighbouring desugars document. The cost is that
/// `f(z = Some(1))` for a `z?: Int?` parameter (an OPTIONAL parameter whose own
/// type is an Option) is passed through unwrapped; that shape needs an explicit
/// `Some(Some(1))` today.
fn opt_arg_already_option(e: Expr) -> Bool {
  match e {
    EIdent(n, _) => n == "None",
    ECall(callee, args, _) => match callee {
      EIdent(n, _) => n == "Some" && Array::length(args) == 1,
      _ => false
    },
    _ => false
  }
}

///|
/// #1500 call-site lowering: an optional parameter is declared `Option[T]`, so
/// a supplied argument becomes `Some(v)` and an omitted trailing one becomes
/// `None`. After this the call has exactly as many arguments as the function
/// has parameters, which is what makes the ordinary arity check pass -- the
/// checker never learns about optionality at all.
///
/// Leaves the call untouched when the missing arguments are NOT all optional
/// (a genuinely short call), so the arity diagnostic still fires and still
/// names the real count.
fn optional_fill_args(args: Array[Expr], flags: Array[Bool]) -> Array[Expr] {
  let np = Array::length(flags)
  let na = Array::length(args)
  if na > np {
    args
  } else {
    let mut fillable = true
    let mut k = na
    while k < np {
      if Array::get(flags, k) {
        ()
      } else {
        fillable = false
      }
      k = k + 1
    }
    if !fillable {
      args
    } else {
      let out = array_empty()
      let mut i = 0
      while i < np {
        if i < na {
          let a = Array::get(args, i)
          if Array::get(flags, i) && !opt_arg_already_option(a) {
            Array::push(out, ECall(EIdent("Some", 0 - 1), [a], 0 - 1))
          } else {
            Array::push(out, a)
          }
        } else {
          Array::push(out, EIdent("None", 0 - 1))
        }
        i = i + 1
      }
      out
    }
  }
}

fn lookup_param_labels(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(tbl) {
    let (n, labels) = Array::get(tbl, i)
    if n == fname {
      found = Some(labels)
      i = Array::length(tbl)
    } else {
      i = i + 1
    }
  }
  found
}

fn labeled_reorder_candidate(args: Array[Expr], param_labels: Array[String]) -> Bool {
  if Array::length(args) != Array::length(param_labels) {
    false
  } else {
    let mut all_labeled = true
    let mut i = 0
    while i < Array::length(args) {
      match Array::get(args, i) {
        ELabeledArg(_, _, _) => (),
        _ => {
          all_labeled = false
        }
      }
      i = i + 1
    }
    all_labeled
  }
}

fn labeled_source_index(args: Array[Expr], wanted: String) -> Int {
  let mut found = -1
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(label, _, _) => if label == wanted && found < 0 {
        found = i
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn label_matches_position(arg: Expr, labels: Array[String], index: Int) -> Bool {
  match arg {
    ELabeledArg(label, _, _) => index < Array::length(labels) && Array::get(labels, index) == label,
    _ => false
  }
}

fn reorder_labeled_args(args: Array[Expr], param_labels: Array[String]) -> Option[Array[Expr]] {
  if !labeled_reorder_candidate(args, param_labels) {
    None
  } else {
    let out = empty_expr_array()
    let mut ok = true
    let mut pj = 0
    while pj < Array::length(param_labels) {
      let fk = labeled_source_index(args, Array::get(param_labels, pj))
      if fk < 0 {
        ok = false
        pj = Array::length(param_labels)
      } else {
        Array::push(out, Array::get(args, fk))
        pj = pj + 1
      }
    }
    if ok {
      Some(out)
    } else {
      None
    }
  }
}

fn strip_labeled_wrappers(args: Array[Expr]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(_, _, v) => Array::push(out, v),
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

fn strip_in_position_labels(args: Array[Expr], labels: Array[String]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    match arg {
      ELabeledArg(lbl, m, v) => if label_matches_position(arg, labels, i) {
        Array::push(out, v)
      } else {
        Array::push(out, ELabeledArg(lbl, m, v))
      },
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

fn paired_expect_pat(pat: Pat, node: BinderAuthorityNode, poisoned: Array[Bool]) -> Unit {
  match pat {
    PBind(name) => {
      paired_expect_node(node, AuthorityPatBind, 1, 0, poisoned)
      paired_expect_slot(node, 0, PatternBinder, name, poisoned)
    },
    PCtor(_, pats) => {
      paired_expect_node(node, AuthorityPatCtor, 0, Array::length(pats), poisoned)
      let mut i = 0
      while i < Array::length(pats) {
        paired_expect_pat(Array::get(pats, i), paired_child_or_self(node, i, poisoned), poisoned)
        i = i + 1
      }
    },
    PTuple(pats) => {
      paired_expect_node(node, AuthorityPatTuple, 0, Array::length(pats), poisoned)
      let mut i = 0
      while i < Array::length(pats) {
        paired_expect_pat(Array::get(pats, i), paired_child_or_self(node, i, poisoned), poisoned)
        i = i + 1
      }
    },
    PStruct(_, fields) => {
      paired_expect_node(node, AuthorityPatStruct, 0, Array::length(fields), poisoned)
      let mut i = 0
      while i < Array::length(fields) {
        let (_, child) = Array::get(fields, i)
        paired_expect_pat(child, paired_child_or_self(node, i, poisoned), poisoned)
        i = i + 1
      }
    },
    POr(_, _) => paired_poison(poisoned),
    PWild => paired_expect_node(node, AuthorityPatWild, 0, 0, poisoned),
    PInt(_) => paired_expect_node(node, AuthorityPatInt, 0, 0, poisoned),
    PFloat(_) => paired_expect_node(node, AuthorityPatFloat, 0, 0, poisoned),
    PString(_) => paired_expect_node(node, AuthorityPatString, 0, 0, poisoned),
    PBool(_) => paired_expect_node(node, AuthorityPatBool, 0, 0, poisoned)
  }
}

fn paired_promote_wrapper(parent: BinderAuthorityNode, index: Int, poisoned: Array[Bool]) -> Unit {
  let wrapper = paired_child_or_self(parent, index, poisoned)
  paired_expect_node(wrapper, AuthorityExprLabeledArg, 0, 1, poisoned)
  let children = binder_authority_node_children(wrapper)
  if binder_authority_node_kind(wrapper) == AuthorityExprLabeledArg && Array::length(binder_authority_node_slots(wrapper)) == 0 && Array::length(children) == 1 {
    Array::set(parent.children, index, Array::get(children, 0))
  } else {
    paired_poison(poisoned)
  }
}

fn strip_labeled_wrappers_paired(args: Array[Expr], node: BinderAuthorityNode, poisoned: Array[Bool]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(_, _, value) => {
        paired_promote_wrapper(node, i + 1, poisoned)
        Array::push(out, value)
      },
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

fn strip_in_position_labels_paired(args: Array[Expr], labels: Array[String], node: BinderAuthorityNode, poisoned: Array[Bool]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    match arg {
      ELabeledArg(label, marker, value) => if label_matches_position(arg, labels, i) {
        paired_promote_wrapper(node, i + 1, poisoned)
        Array::push(out, value)
      } else {
        Array::push(out, ELabeledArg(label, marker, value))
      },
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

fn paired_poison_surviving_labels(args: Array[Expr], poisoned: Array[Bool]) -> Unit {
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(_, _, _) => paired_poison(poisoned),
      _ => ()
    }
    i = i + 1
  }
}

fn optional_fill_args_paired(args: Array[Expr], flags: Array[Bool], poisoned: Array[Bool]) -> Array[Expr] {
  let np = Array::length(flags)
  let na = Array::length(args)
  if na > np {
    args
  } else {
    let mut fillable = true
    let mut k = na
    while k < np {
      if !Array::get(flags, k) {
        fillable = false
      } else {
        ()
      }
      k = k + 1
    }
    if !fillable {
      args
    } else {
      let out = empty_expr_array()
      let mut i = 0
      while i < np {
        if i < na {
          let arg = Array::get(args, i)
          if Array::get(flags, i) && !opt_arg_already_option(arg) {
            paired_poison(poisoned)
            Array::push(out, ECall(EIdent("Some", 0 - 1), [arg], 0 - 1))
          } else {
            Array::push(out, arg)
          }
        } else {
          paired_poison(poisoned)
          Array::push(out, EIdent("None", 0 - 1))
        }
        i = i + 1
      }
      out
    }
  }
}

fn relabel_expr(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      let rargs = for a in args {
        relabel_expr(a, tbl, shadows)
      }
      let rcallee = relabel_expr(callee, tbl, shadows)
      let mut any_labeled_arg = false
      let mut la_i = 0
      while la_i < Array::length(rargs) {
        match Array::get(rargs, la_i) {
          ELabeledArg(_, _, _) => {
            any_labeled_arg = true
          },
          _ => ()
        }
        la_i = la_i + 1
      }
      let final_args = if any_labeled_arg {
        match callee {
          EIdent(fname, foff) => {
            // Where the labels come from is the ONLY thing shadowing changes
            // (#1899). A locally bound callee must not take the top-level
            // table -- but if the local binding is itself a labeled lambda, it
            // has labels of its own, and before this it got none at all.
            let labels_opt = if str_array_contains(shadows, fname) {
              match local_fn_tbl_lookup(fname, shadows) {
                Some((labels, _)) => Some(labels),
                None => {
                  // #1994: a `let mut` lambda whose scope disagrees about its
                  // parameter names. There is no order to reorder into, so
                  // record the site for the checker instead of letting the
                  // arguments bind in written order.
                  if unstable_mut_tbl_lookup(fname, shadows) {
                    Array::push(unresolved_mut_labeled_cell, (fname, foff))
                  } else {
                    ()
                  }
                  None
                }
              }
            } else {
              lookup_param_labels(tbl, fname)
            }
            match labels_opt {
              Some(labels) => match reorder_labeled_args(rargs, labels) {
                Some(reordered) => strip_labeled_wrappers(reordered),
                None => strip_in_position_labels(rargs, labels)
              },
              None => rargs
            }
          },
          _ => rargs
        }
      } else {
        rargs
      }
      let opt_args = match callee {
        EIdent(fname, _) => match optional_flags_for_call(fname, shadows) {
          Some(flags) => optional_fill_args(final_args, flags),
          None => final_args
        },
        _ => final_args
      }
      ECall(rcallee, opt_args, off)
    },
    EBinOp(op, l, r) => EBinOp(op, relabel_expr(l, tbl, shadows), relabel_expr(r, tbl, shadows)),
    EUnaryOp(op, e) => EUnaryOp(op, relabel_expr(e, tbl, shadows)),
    ETuple(elems) => ETuple(for e in elems {
      relabel_expr(e, tbl, shadows)
    }),
    EArray(elems) => EArray(for e in elems {
      relabel_expr(e, tbl, shadows)
    }),
    ESpread(e) => ESpread(relabel_expr(e, tbl, shadows)),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, relabel_expr(fval, tbl, shadows)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, relabel_expr(v, tbl, shadows)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => {
      let rc = relabel_expr(c, tbl, shadows)
      // #1994: the arms are WALKED, not executed. Whatever they re-label must
      // not go on describing the binding after the `if`.
      let amark = Array::length(relabel_assigned_cell)
      let rt = relabel_expr(t, tbl, shadows)
      let re = relabel_expr(e, tbl, shadows)
      poison_branch_assignments(amark, Array::length(shadows))
      EIf(rc, rt, re)
    },
    // The three binding arms keep local_fn_tbl_cell in step with `shadows`
    // (#1899/#1952): push the lambda's parameter shape at the index `name`
    // takes in `shadows`, and drop it again on the same scope exit.
    ELet(name, v, b, soff) => {
      let rv = relabel_expr(v, tbl, shadows)
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, v)
      Array::push(shadows, name)
      local_fn_tbl_push(name, v, mark)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELet(name, rv, rb, soff)
    },
    ELetRec(name, v, b) => {
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, v)
      Array::push(shadows, name)
      // Pushed before `v` is walked, not after: the binding is in scope inside
      // its own body, so a recursive labeled call has to see the entry too.
      local_fn_tbl_push(name, v, mark)
      let rv = relabel_expr(v, tbl, shadows)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELetRec(name, rv, rb)
    },
    ELetMut(name, v, b, soff) => {
      let rv = relabel_expr(v, tbl, shadows)
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, v)
      Array::push(shadows, name)
      // #1994: register the initializer. Sequential `g = (y~, x~) -> ...`
      // updates the table in `local_fn_tbl_replace` (continuation-only, no
      // flow). A flow-insensitive "any disagreeing assign rejects every
      // labeled call" breaks existing sequential-update fixtures
      // (`labeled_local_lambda_scope_test` / binder-authority).
      local_fn_tbl_push(name, v, mark)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELetMut(name, rv, rb, soff)
    },
    EAssign(name, v, c) => {
      optional_local_replace(name, v)
      let rv = relabel_expr(v, tbl, shadows)
      local_fn_tbl_replace(name, v, shadows)
      EAssign(name, rv, relabel_expr(c, tbl, shadows))
    },
    EAssignOp(name, op, v, c) => {
      optional_local_replace(name, v)
      let rv = relabel_expr(v, tbl, shadows)
      local_fn_tbl_replace(name, v, shadows)
      EAssignOp(name, op, rv, relabel_expr(c, tbl, shadows))
    },
    ESeq(a, b) => ESeq(relabel_expr(a, tbl, shadows), relabel_expr(b, tbl, shadows)),
    EMatch(scrut, arms) => {
      let rscrut = relabel_expr(scrut, tbl, shadows)
      // #1994: one arm runs; every arm is walked. See the EIf arm.
      let amark = Array::length(relabel_assigned_cell)
      let arms_mark = Array::length(shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        let mark = Array::length(shadows)
        let local_mark = Array::length(optional_param_local_cell)
        collect_pat_binders(p, shadows)
        let _entered = optional_local_enter_names(shadows, mark)
        Array::push(out, (p, relabel_expr(b, tbl, shadows)))
        Array::truncate(shadows, mark)
        optional_local_leave(local_mark)
        i = i + 1
      }
      poison_branch_assignments(amark, arms_mark)
      EMatch(rscrut, out)
    },
    EHandle(scrut, arms) => {
      let rscrut = relabel_expr(scrut, tbl, shadows)
      // #1994: a handler arm runs only when its operation is performed.
      let amark = Array::length(relabel_assigned_cell)
      let arms_mark = Array::length(shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        let mark = Array::length(shadows)
        let local_mark = Array::length(optional_param_local_cell)
        collect_pat_binders(p, shadows)
        let _entered = optional_local_enter_names(shadows, mark)
        Array::push(out, (p, relabel_expr(b, tbl, shadows)))
        Array::truncate(shadows, mark)
        optional_local_leave(local_mark)
        i = i + 1
      }
      poison_branch_assignments(amark, arms_mark)
      EHandle(rscrut, out)
    },
    EWhile(c, b) => {
      // #1994: the body runs zero or more times, so an assignment inside it
      // describes the binding neither after the loop nor on the next round.
      let amark = Array::length(relabel_assigned_cell)
      let rc = relabel_expr(c, tbl, shadows)
      let rb = relabel_expr(b, tbl, shadows)
      poison_branch_assignments(amark, Array::length(shadows))
      EWhile(rc, rb)
    },
    ELoop(params, b) => {
      let rinits = for param in params {
        let (name, init) = param
        (name, relabel_expr(init, tbl, shadows))
      }
      let mark = Array::length(shadows)
      let local_mark = Array::length(optional_param_local_cell)
      // #1994: see the EWhile arm.
      let amark = Array::length(relabel_assigned_cell)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        Array::push(shadows, pname)
        pi = pi + 1
      }
      let _entered = optional_local_enter_names(shadows, mark)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      optional_local_leave(local_mark)
      poison_branch_assignments(amark, mark)
      ELoop(rinits, rb)
    },
    EForIn(name, idx, iter, b) => {
      let riter = relabel_expr(iter, tbl, shadows)
      let mark = Array::length(shadows)
      let local_mark = Array::length(optional_param_local_cell)
      // #1994: see the EWhile arm.
      let amark = Array::length(relabel_assigned_cell)
      Array::push(shadows, name)
      match idx {
        Some(ix) => Array::push(shadows, ix),
        None => ()
      }
      let _entered = optional_local_enter_names(shadows, mark)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      optional_local_leave(local_mark)
      poison_branch_assignments(amark, mark)
      EForIn(name, idx, riter, rb)
    },
    EFn(tp, bnds, params, rt, eff, b) => {
      let mark = Array::length(shadows)
      let local_mark = Array::length(optional_param_local_cell)
      // #1994: a closure body is walked here and runs somewhere else, if ever.
      let amark = Array::length(relabel_assigned_cell)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, _) = Array::get(params, pi)
        Array::push(shadows, strip_label_tilde(pn))
        pi = pi + 1
      }
      let _entered = optional_local_enter_names(shadows, mark)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      optional_local_leave(local_mark)
      poison_branch_assignments(amark, mark)
      EFn(tp, bnds, params, rt, eff, rb)
    },
    EDot(obj, field, off, fdoff) => EDot(relabel_expr(obj, tbl, shadows), field, off, fdoff),
    ELabeledArg(label, name, b) => ELabeledArg(label, name, relabel_expr(b, tbl, shadows)),
    EReturn(e) => EReturn(relabel_expr(e, tbl, shadows)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(relabel_expr(e, tbl, shadows))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      relabel_expr(e, tbl, shadows)
    }),
    _ => expr
  }
}

fn relabel_stmt(stmt: Stmt, tbl: Array[(String, Array[String])]) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, relabel_expr(body, tbl, empty_str_array())),
    // `fn name(..) { .. }` is SFnDecl, not SLet. Skipping it left every
    // labeled call inside a `fn` body un-reordered, including the #1994
    // `let mut` cases the diagnostic test writes as `fn main()`.
    SFnDecl(ex, name, body, reqs, enss) => SFnDecl(ex, name, relabel_expr(body, tbl, empty_str_array()), reqs, enss),
    SLetMut(name, ty, body) => SLetMut(name, ty, relabel_expr(body, tbl, empty_str_array())),
    STest(name, body) => STest(name, relabel_expr(body, tbl, empty_str_array())),
    SBench(name, body) => SBench(name, relabel_expr(body, tbl, empty_str_array())),
    SExpr(e) => SExpr(relabel_expr(e, tbl, empty_str_array())),
    SLetPat(pat, e) => SLetPat(pat, relabel_expr(e, tbl, empty_str_array())),
    SModule(ex, name, stmts) => SModule(ex, name, for s in stmts {
      relabel_stmt(s, tbl)
    }),
    _ => stmt
  }
}

fn relabel_expr_paired_child(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], node: BinderAuthorityNode, index: Int, poisoned: Array[Bool]) -> Expr {
  relabel_expr_paired(expr, tbl, shadows, paired_child_or_self(node, index, poisoned), poisoned)
}

fn relabel_expr_paired(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], node: BinderAuthorityNode, poisoned: Array[Bool]) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      paired_expect_node(node, AuthorityExprCall, 0, Array::length(args) + 1, poisoned)
      let original_children = binder_authority_node_children(node)
      let mut ai = 0
      let rargs = for arg in args {
        let child = paired_child_or_self(node, ai + 1, poisoned)
        ai = ai + 1
        relabel_expr_paired(arg, tbl, shadows, child, poisoned)
      }
      let rcallee = relabel_expr_paired_child(callee, tbl, shadows, node, 0, poisoned)
      let mut any_labeled = false
      let mut li = 0
      while li < Array::length(rargs) {
        match Array::get(rargs, li) {
          ELabeledArg(_, _, _) => {
            any_labeled = true
          },
          _ => ()
        }
        li = li + 1
      }
      let resolved = if any_labeled {
        match callee {
          EIdent(fname, _) => {
            // Must agree with relabel_expr's ECall arm exactly: the two lanes
            // relabel the same programs, and a disagreement is a difference in
            // meaning between them. Only the SOURCE of the labels is
            // shadow-dependent (#1899); the reorder below, including the
            // binder-authority child remapping, is unchanged.
            // The #1994 call-site record is deliberately not mirrored here: it
            // is a diagnostics side channel drained by check_program, which
            // runs the non-paired lane, and it changes no relabeling decision.
            let labels_opt = if str_array_contains(shadows, fname) {
              match local_fn_tbl_lookup(fname, shadows) {
                Some((labels, _)) => Some(labels),
                None => None
              }
            } else {
              lookup_param_labels(tbl, fname)
            }
            match labels_opt {
              Some(labels) => if labeled_reorder_candidate(rargs, labels) {
                let reordered = empty_expr_array()
                let used = for _ in rargs {
                  false
                }
                let mut ok = true
                let mut pi = 0
                while pi < Array::length(labels) {
                  let source = labeled_source_index(rargs, Array::get(labels, pi))
                  if source < 0 {
                    paired_poison(poisoned)
                    ok = false
                    pi = Array::length(labels)
                  } else {
                    Array::push(reordered, Array::get(rargs, source))
                    if Array::get(used, source) || source + 1 >= Array::length(original_children) {
                      paired_poison(poisoned)
                    } else {
                      Array::set(used, source, true)
                      Array::set(node.children, pi + 1, Array::get(original_children, source + 1))
                    }
                    pi = pi + 1
                  }
                }
                if ok {
                  strip_labeled_wrappers_paired(reordered, node, poisoned)
                } else {
                  strip_in_position_labels_paired(rargs, labels, node, poisoned)
                }
              } else {
                paired_poison(poisoned)
                strip_in_position_labels_paired(rargs, labels, node, poisoned)
              },
              None => rargs
            }
          },
          _ => rargs
        }
      } else {
        rargs
      }
      let final_args = match callee {
        EIdent(fname, _) => match optional_flags_for_call(fname, shadows) {
          Some(flags) => optional_fill_args_paired(resolved, flags, poisoned),
          None => resolved
        },
        _ => resolved
      }
      paired_poison_surviving_labels(final_args, poisoned)
      ECall(rcallee, final_args, off)
    },
    EBinOp(op, left, right) => {
      paired_expect_node(node, AuthorityExprBinOp, 0, 2, poisoned)
      EBinOp(op, relabel_expr_paired_child(left, tbl, shadows, node, 0, poisoned), relabel_expr_paired_child(right, tbl, shadows, node, 1, poisoned))
    },
    EUnaryOp(op, value) => {
      paired_expect_node(node, AuthorityExprUnaryOp, 0, 1, poisoned)
      EUnaryOp(op, relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned))
    },
    ETuple(items) => {
      paired_expect_node(node, AuthorityExprTuple, 0, Array::length(items), poisoned)
      let mut i = 0
      ETuple(for item in items {
        let child = paired_child_or_self(node, i, poisoned)
        i = i + 1
        relabel_expr_paired(item, tbl, shadows, child, poisoned)
      })
    },
    EArray(items) => {
      paired_expect_node(node, AuthorityExprArray, 0, Array::length(items), poisoned)
      let mut i = 0
      EArray(for item in items {
        let child = paired_child_or_self(node, i, poisoned)
        i = i + 1
        relabel_expr_paired(item, tbl, shadows, child, poisoned)
      })
    },
    ESpread(value) => {
      paired_expect_node(node, AuthorityExprSpread, 0, 1, poisoned)
      ESpread(relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned))
    },
    ERecord(name, fields, types) => {
      paired_expect_node(node, AuthorityExprRecord, 0, Array::length(fields), poisoned)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (field, value) = Array::get(fields, i)
        Array::push(out, (field, relabel_expr_paired_child(value, tbl, shadows, node, i, poisoned)))
        i = i + 1
      }
      ERecord(name, out, types)
    },
    EMap(fields) => {
      paired_expect_node(node, AuthorityExprMap, 0, Array::length(fields), poisoned)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (key, value) = Array::get(fields, i)
        Array::push(out, (key, relabel_expr_paired_child(value, tbl, shadows, node, i, poisoned)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(cond, yes, no) => {
      paired_expect_node(node, AuthorityExprIf, 0, 3, poisoned)
      let rcond = relabel_expr_paired_child(cond, tbl, shadows, node, 0, poisoned)
      // #1994: kept in step with relabel_expr's EIf arm.
      let amark = Array::length(relabel_assigned_cell)
      let ryes = relabel_expr_paired_child(yes, tbl, shadows, node, 1, poisoned)
      let rno = relabel_expr_paired_child(no, tbl, shadows, node, 2, poisoned)
      poison_branch_assignments(amark, Array::length(shadows))
      EIf(rcond, ryes, rno)
    },
    // Kept in step with relabel_expr's binding arms (#1899/#1952): the two
    // lanes must agree about which local lambdas are in scope.
    ELet(name, value, body, offset) => {
      paired_expect_node(node, AuthorityExprLet, 1, 2, poisoned)
      paired_expect_slot(node, 0, ExpressionLetBinder, name, poisoned)
      let rvalue = relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned)
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, value)
      Array::push(shadows, name)
      local_fn_tbl_push(name, value, mark)
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 1, poisoned)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELet(name, rvalue, rbody, offset)
    },
    ELetRec(name, value, body) => {
      paired_expect_node(node, AuthorityExprLetRec, 1, 2, poisoned)
      paired_expect_slot(node, 0, ExpressionLetRecBinder, name, poisoned)
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, value)
      Array::push(shadows, name)
      local_fn_tbl_push(name, value, mark)
      let rvalue = relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned)
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 1, poisoned)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELetRec(name, rvalue, rbody)
    },
    ELetMut(name, value, body, offset) => {
      paired_expect_node(node, AuthorityExprLetMut, 1, 2, poisoned)
      paired_expect_slot(node, 0, ExpressionLetMutBinder, name, poisoned)
      let rvalue = relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned)
      let mark = Array::length(shadows)
      let lmark = Array::length(local_fn_tbl_cell)
      let local_mark = optional_local_enter(name, value)
      Array::push(shadows, name)
      local_fn_tbl_push(name, value, mark)
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 1, poisoned)
      Array::truncate(shadows, mark)
      local_fn_tbl_truncate(lmark)
      optional_local_leave(local_mark)
      ELetMut(name, rvalue, rbody, offset)
    },
    EAssign(name, value, cont) => {
      paired_expect_node(node, AuthorityExprAssign, 0, 2, poisoned)
      optional_local_replace(name, value)
      let rvalue = relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned)
      local_fn_tbl_replace(name, value, shadows)
      EAssign(name, rvalue, relabel_expr_paired_child(cont, tbl, shadows, node, 1, poisoned))
    },
    EAssignOp(name, op, value, cont) => {
      paired_expect_node(node, AuthorityExprAssignOp, 0, 2, poisoned)
      optional_local_replace(name, value)
      let rvalue = relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned)
      local_fn_tbl_replace(name, value, shadows)
      EAssignOp(name, op, rvalue, relabel_expr_paired_child(cont, tbl, shadows, node, 1, poisoned))
    },
    ESeq(first, second) => {
      paired_expect_node(node, AuthorityExprSeq, 0, 2, poisoned)
      ESeq(relabel_expr_paired_child(first, tbl, shadows, node, 0, poisoned), relabel_expr_paired_child(second, tbl, shadows, node, 1, poisoned))
    },
    EMatch(scrutinee, arms) => {
      paired_expect_node(node, AuthorityExprMatch, 0, 1 + Array::length(arms) * 2, poisoned)
      let rscrutinee = relabel_expr_paired_child(scrutinee, tbl, shadows, node, 0, poisoned)
      // #1994: kept in step with relabel_expr's EMatch arm.
      let amark = Array::length(relabel_assigned_cell)
      let arms_mark = Array::length(shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        paired_expect_pat(pat, paired_child_or_self(node, 1 + i * 2, poisoned), poisoned)
        let mark = Array::length(shadows)
        collect_pat_binders(pat, shadows)
        Array::push(out, (pat, relabel_expr_paired_child(body, tbl, shadows, node, 2 + i * 2, poisoned)))
        Array::truncate(shadows, mark)
        i = i + 1
      }
      poison_branch_assignments(amark, arms_mark)
      EMatch(rscrutinee, out)
    },
    EHandle(scrutinee, arms) => {
      paired_expect_node(node, AuthorityExprHandle, 0, 1 + Array::length(arms) * 2, poisoned)
      let rscrutinee = relabel_expr_paired_child(scrutinee, tbl, shadows, node, 0, poisoned)
      // #1994: kept in step with relabel_expr's EHandle arm.
      let amark = Array::length(relabel_assigned_cell)
      let arms_mark = Array::length(shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        paired_expect_pat(pat, paired_child_or_self(node, 1 + i * 2, poisoned), poisoned)
        let mark = Array::length(shadows)
        collect_pat_binders(pat, shadows)
        Array::push(out, (pat, relabel_expr_paired_child(body, tbl, shadows, node, 2 + i * 2, poisoned)))
        Array::truncate(shadows, mark)
        i = i + 1
      }
      poison_branch_assignments(amark, arms_mark)
      EHandle(rscrutinee, out)
    },
    EWhile(cond, body) => {
      paired_expect_node(node, AuthorityExprWhile, 0, 2, poisoned)
      // #1994: kept in step with relabel_expr's EWhile arm.
      let amark = Array::length(relabel_assigned_cell)
      let rcond = relabel_expr_paired_child(cond, tbl, shadows, node, 0, poisoned)
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 1, poisoned)
      poison_branch_assignments(amark, Array::length(shadows))
      EWhile(rcond, rbody)
    },
    ELoop(_, _) => {
      paired_poison(poisoned)
      relabel_expr(expr, tbl, shadows)
    },
    EForIn(name, index, iterable, body) => {
      let slot_count = match index {
        Some(_) => 2,
        None => 1
      }
      paired_expect_node(node, AuthorityExprForIn, slot_count, 2, poisoned)
      paired_expect_slot(node, 0, ExpressionForValueBinder, name, poisoned)
      match index {
        Some(index_name) => paired_expect_slot(node, 1, ExpressionForIndexBinder, index_name, poisoned),
        None => ()
      }
      let riterable = relabel_expr_paired_child(iterable, tbl, shadows, node, 0, poisoned)
      let mark = Array::length(shadows)
      // #1994: kept in step with relabel_expr's EForIn arm.
      let amark = Array::length(relabel_assigned_cell)
      Array::push(shadows, name)
      match index {
        Some(index_name) => Array::push(shadows, index_name),
        None => ()
      }
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 1, poisoned)
      Array::truncate(shadows, mark)
      poison_branch_assignments(amark, mark)
      EForIn(name, index, riterable, rbody)
    },
    EFn(type_params, bounds, params, ret, effects, body) => {
      paired_expect_node(node, AuthorityExprFn, Array::length(type_params) + Array::length(params), 1, poisoned)
      let mut ti = 0
      while ti < Array::length(type_params) {
        paired_expect_slot(node, ti, ExpressionFunctionTypeParameterBinder, type_param_name(Array::get(type_params, ti)), poisoned)
        ti = ti + 1
      }
      let mark = Array::length(shadows)
      // #1994: kept in step with relabel_expr's EFn arm.
      let amark = Array::length(relabel_assigned_cell)
      let mut pi = 0
      while pi < Array::length(params) {
        let (name, _) = Array::get(params, pi)
        paired_expect_slot(node, Array::length(type_params) + pi, ExpressionFunctionParameterBinder, name, poisoned)
        Array::push(shadows, strip_label_tilde(name))
        pi = pi + 1
      }
      let rbody = relabel_expr_paired_child(body, tbl, shadows, node, 0, poisoned)
      Array::truncate(shadows, mark)
      poison_branch_assignments(amark, mark)
      EFn(type_params, bounds, params, ret, effects, rbody)
    },
    EDot(object, field, offset, field_offset) => {
      paired_expect_node(node, AuthorityExprDot, 0, 1, poisoned)
      EDot(relabel_expr_paired_child(object, tbl, shadows, node, 0, poisoned), field, offset, field_offset)
    },
    ELabeledArg(label, marker, value) => {
      paired_expect_node(node, AuthorityExprLabeledArg, 0, 1, poisoned)
      ELabeledArg(label, marker, relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned))
    },
    EReturn(value) => {
      paired_expect_node(node, AuthorityExprReturn, 0, 1, poisoned)
      EReturn(relabel_expr_paired_child(value, tbl, shadows, node, 0, poisoned))
    },
    EBreak(value) => match value {
      Some(inner) => {
        paired_expect_node(node, AuthorityExprBreak, 0, 1, poisoned)
        EBreak(Some(relabel_expr_paired_child(inner, tbl, shadows, node, 0, poisoned)))
      },
      None => {
        paired_expect_node(node, AuthorityExprBreak, 0, 0, poisoned)
        expr
      }
    },
    EContinue(values) => {
      paired_expect_node(node, AuthorityExprContinue, 0, Array::length(values), poisoned)
      let mut i = 0
      EContinue(for value in values {
        let child = paired_child_or_self(node, i, poisoned)
        i = i + 1
        relabel_expr_paired(value, tbl, shadows, child, poisoned)
      })
    },
    EInt(_) => {
      paired_expect_node(node, AuthorityExprInt, 0, 0, poisoned)
      expr
    },
    EFloat(_) => {
      paired_expect_node(node, AuthorityExprFloat, 0, 0, poisoned)
      expr
    },
    EString(_) => {
      paired_expect_node(node, AuthorityExprString, 0, 0, poisoned)
      expr
    },
    EBool(_) => {
      paired_expect_node(node, AuthorityExprBool, 0, 0, poisoned)
      expr
    },
    EIdent(_, _) => {
      paired_expect_node(node, AuthorityExprIdent, 0, 0, poisoned)
      expr
    },
    EStringInterp(_) => {
      paired_expect_node(node, AuthorityExprStringInterp, 0, 0, poisoned)
      expr
    },
    EUnit => {
      paired_expect_node(node, AuthorityExprUnit, 0, 0, poisoned)
      expr
    }
  }
}

fn relabel_stmt_paired(stmt: Stmt, tbl: Array[(String, Array[String])], node: BinderAuthorityNode, poisoned: Array[Bool]) -> Stmt {
  match stmt {
    SLet(exported, recursive, name, ty, body) => {
      paired_expect_node(node, AuthorityStmtLet, 1, 1, poisoned)
      paired_expect_slot(node, 0, StatementLetBinder, name, poisoned)
      SLet(exported, recursive, name, ty, relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    SLetMut(name, ty, body) => {
      paired_expect_node(node, AuthorityStmtLetMut, 1, 1, poisoned)
      paired_expect_slot(node, 0, StatementLetMutBinder, name, poisoned)
      SLetMut(name, ty, relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    STest(name, body) => {
      paired_expect_node(node, AuthorityStmtTest, 0, 1, poisoned)
      STest(name, relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    SBench(name, body) => {
      paired_expect_node(node, AuthorityStmtBench, 0, 1, poisoned)
      SBench(name, relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    SExample(name, body) => {
      paired_expect_node(node, AuthorityStmtExample, 0, 1, poisoned)
      SExample(name, relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    SExpr(body) => {
      paired_expect_node(node, AuthorityStmtExpr, 0, 1, poisoned)
      SExpr(relabel_expr_paired_child(body, tbl, empty_str_array(), node, 0, poisoned))
    },
    SExternLet(name, _) => {
      paired_expect_node(node, AuthorityStmtExternLet, 1, 0, poisoned)
      paired_expect_slot(node, 0, StatementExternBinder, name, poisoned)
      stmt
    },
    SImport(_, items) => {
      paired_expect_node(node, AuthorityStmtImport, Array::length(items), 0, poisoned)
      let mut i = 0
      while i < Array::length(items) {
        let item = Array::get(items, i)
        let local = match item.alias {
          Some(alias) => alias,
          None => item.name
        }
        paired_expect_slot(node, i, StatementImportBinder, local, poisoned)
        i = i + 1
      }
      stmt
    },
    SAliasDecl(name, _) => {
      paired_expect_node(node, AuthorityStmtAliasDecl, 1, 0, poisoned)
      paired_expect_slot(node, 0, StatementAliasBinder, name, poisoned)
      stmt
    },
    STypeAlias(_, name, params, _) => {
      paired_expect_node(node, AuthorityStmtTypeAlias, 1 + Array::length(params), 0, poisoned)
      paired_expect_slot(node, 0, StatementTypeBinder, name, poisoned)
      let mut i = 0
      while i < Array::length(params) {
        paired_expect_slot(node, i + 1, StatementTypeParameterBinder, type_param_name(Array::get(params, i)), poisoned)
        i = i + 1
      }
      stmt
    },
    SEffectSet(_, name, _) => {
      paired_expect_node(node, AuthorityStmtEffectSet, 1, 0, poisoned)
      paired_expect_slot(node, 0, StatementEffectSetBinder, name, poisoned)
      stmt
    },
    SResource(name, _) => {
      paired_expect_node(node, AuthorityStmtResource, 1, 0, poisoned)
      paired_expect_slot(node, 0, StatementResourceBinder, name, poisoned)
      stmt
    },
    SExport(_) => {
      paired_expect_node(node, AuthorityStmtExport, 0, 0, poisoned)
      stmt
    },
    SReExport(_, _) => {
      paired_expect_node(node, AuthorityStmtReExport, 0, 0, poisoned)
      stmt
    },
    SQualifiedPatternRefs(_) => {
      paired_expect_node(node, AuthorityStmtQualifiedPatternRefs, 0, 0, poisoned)
      stmt
    },
    STestEffectRows(_) => {
      paired_expect_node(node, AuthorityStmtTestEffectRows, 0, 0, poisoned)
      stmt
    },
    _ => {
      paired_poison(poisoned)
      relabel_stmt(stmt, tbl)
    }
  }
}

///|
/// #986: allocation-free containment scan used to gate the allocating
/// relabel_stmt rebuild per top-level statement,
/// since collect_fn_param_labels now indexes EVERY top-level function and the
/// old `tbl empty -> skip` fast path no longer fires for ordinary programs.
fn stmt_has_labeled_arg(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, body) => dinsp_scan(body, 3, ""),
    SFnDecl(_, _, body, _, _) => dinsp_scan(body, 3, ""),
    SLetMut(_, _, body) => dinsp_scan(body, 3, ""),
    STest(_, body) => dinsp_scan(body, 3, ""),
    SBench(_, body) => dinsp_scan(body, 3, ""),
    SExpr(e) => dinsp_scan(e, 3, ""),
    SLetPat(_, e) => dinsp_scan(e, 3, ""),
    SModule(_, _, ms) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(ms) {
        if found {
          i = Array::length(ms)
        } else {
          found = stmt_has_labeled_arg(Array::get(ms, i))
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}

/// Read-only scan for one of six questions, in ONE explicit-variant walk:
///   mode 0 -- does this contain a two-argument `inspect(..)` call?
///   mode 1 -- does this BIND the name `inspect` (a let / for / fn parameter)?
///   mode 2 -- does this mention `name` at all, as a reference or a binder?
///   mode 3 -- does this contain a labeled-argument wrapper?
///   mode 4 -- is `name` used anywhere except as a direct call callee?
///   mode 5 -- is `name` targeted by an assignment or assignment-op?
///
/// The variants are enumerated by hand rather than recursed through
/// `expr_children`, and that is the whole point: `expr_children` ALLOCATES a
/// fresh array per node, so using it for a "read-only" pre-check cost more
/// allocation than the rebuild the pre-check exists to avoid. Measured on the
/// perf gate's deterministic axis: the expr_children version put
/// `selfcompile heap_ptr_bytes` +2.61% over main; this one is allocation-free.
///
/// Enumerated (no `_ =>` catch-all for the recursive shapes) so a new `Expr`
/// variant is a compile error here instead of a silently unscanned subtree.
///|
/// True when any parameter is declared optional (`z?`). The marker survives on
/// the parameter NAME at this stage -- see parse_one_param_with_binder_context.
fn dinsp_params_optional(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    let pl = String::length(pn)
    if pl > 0 && __slice(pn, pl - 1, pl) == "?" {
      found = true
    }
    i = i + 1
  }
  found
}

fn dinsp_scan(expr: Expr, mode: Int, name: String) -> Bool {
  let here = if mode == 0 {
    match expr {
      ECall(callee, args, _) => match callee {
        EIdent(n, _) => n == "inspect" && Array::length(args) == 2,
        _ => false
      },
      _ => false
    }
  } else if mode == 1 {
    match expr {
      ELet(n, _, _, _) => n == "inspect",
      ELetRec(n, _, _) => n == "inspect",
      ELetMut(n, _, _, _) => n == "inspect",
      EForIn(v, _, _, _) => v == "inspect",
      EFn(_, _, params, _, _, _) => dinsp_params_bind(params, "inspect"),
      EMatch(_, arms) => dinsp_arms_bind(arms, "inspect"),
      EHandle(_, arms) => dinsp_arms_bind(arms, "inspect"),
      _ => false
    }
  } else if mode == 2 {
    match expr {
      EIdent(n, _) => n == name,
      ELet(n, _, _, _) => n == name,
      ELetRec(n, _, _) => n == name,
      ELetMut(n, _, _, _) => n == name,
      EAssign(n, _, _) => n == name,
      EAssignOp(n, _, _, _) => n == name,
      EForIn(v, _, _, _) => v == name,
      EFn(_, _, params, _, _, _) => dinsp_params_bind(params, name),
      EMatch(_, arms) => dinsp_arms_bind(arms, name),
      EHandle(_, arms) => dinsp_arms_bind(arms, name),
      _ => false
    }
  } else if mode == 3 {
    // "Does this statement need the relabel walk?" -- the only user is
    // stmt_has_labeled_arg. A labeled argument is one reason; a lambda that
    // declares an optional parameter is the other (#1952). Without the second,
    // a statement whose only feature is a block-local `(a: Int, b?: Int)` was
    // skipped outright, and the omitted argument reached the checker as an
    // arity error. The top-level equivalent is handled by `walk_all`, which is
    // computed from collect_optional_param_fns and so cannot see this one.
    match expr {
      ELabeledArg(_, _, _) => true,
      EFn(_, _, params, _, _, _) => dinsp_params_optional(params),
      _ => false
    }
  } else if mode == 4 {
    match expr {
      EIdent(n, _) => n == name,
      EAssign(n, _, _) => n == name,
      EAssignOp(n, _, _, _) => n == name,
      _ => false
    }
  } else {
    match expr {
      EAssign(n, _, _) => n == name,
      EAssignOp(n, _, _, _) => n == name,
      _ => false
    }
  }
  if here {
    true
  } else {
    match expr {
      EInt(_) => false,
      EFloat(_) => false,
      EString(_) => false,
      EBool(_) => false,
      EUnit => false,
      EIdent(_, _) => false,
      EStringInterp(_) => false,
      ETuple(items) => dinsp_scan_list(items, mode, name),
      EArray(items) => dinsp_scan_list(items, mode, name),
      ERecord(_, fields, _) => dinsp_scan_fields(fields, mode, name),
      EMap(fields) => dinsp_scan_fields(fields, mode, name),
      EIf(c, t, f) => dinsp_scan(c, mode, name) || dinsp_scan(t, mode, name) || dinsp_scan(f, mode, name),
      ELet(_, v, b, _) => dinsp_scan(v, mode, name) || dinsp_scan(b, mode, name),
      ELetRec(_, v, b) => dinsp_scan(v, mode, name) || dinsp_scan(b, mode, name),
      ELetMut(_, v, b, _) => dinsp_scan(v, mode, name) || dinsp_scan(b, mode, name),
      EAssign(_, v, b) => dinsp_scan(v, mode, name) || dinsp_scan(b, mode, name),
      EAssignOp(_, _, v, b) => dinsp_scan(v, mode, name) || dinsp_scan(b, mode, name),
      ESeq(a, b) => dinsp_scan(a, mode, name) || dinsp_scan(b, mode, name),
      EMatch(sc, arms) => dinsp_scan(sc, mode, name) || dinsp_scan_arms(arms, mode, name),
      EHandle(sc, arms) => dinsp_scan(sc, mode, name) || dinsp_scan_arms(arms, mode, name),
      EWhile(c, b) => dinsp_scan(c, mode, name) || dinsp_scan(b, mode, name),
      ELoop(params, b) => dinsp_scan_fields(params, mode, name) || dinsp_scan(b, mode, name),
      EForIn(_, _, it, b) => dinsp_scan(it, mode, name) || dinsp_scan(b, mode, name),
      ECall(callee, args, _) => if mode == 4 {
        match callee {
          EIdent(n, _) => if n == name {
            dinsp_scan_list(args, mode, name)
          } else {
            dinsp_scan(callee, mode, name) || dinsp_scan_list(args, mode, name)
          },
          _ => dinsp_scan(callee, mode, name) || dinsp_scan_list(args, mode, name)
        }
      } else {
        dinsp_scan(callee, mode, name) || dinsp_scan_list(args, mode, name)
      },
      EBinOp(_, l, r) => dinsp_scan(l, mode, name) || dinsp_scan(r, mode, name),
      EUnaryOp(_, v) => dinsp_scan(v, mode, name),
      EFn(_, _, _, _, _, body) => dinsp_scan(body, mode, name),
      EDot(inner, _, _, _) => dinsp_scan(inner, mode, name),
      ELabeledArg(_, _, v) => dinsp_scan(v, mode, name),
      EReturn(v) => dinsp_scan(v, mode, name),
      EBreak(opt) => match opt {
        Some(v) => dinsp_scan(v, mode, name),
        None => false
      },
      EContinue(args) => dinsp_scan_list(args, mode, name),
      ESpread(v) => dinsp_scan(v, mode, name)
    }
  }
}

fn dinsp_scan_list(items: Array[Expr], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(items) {
    found = dinsp_scan(Array::get(items, i), mode, name)
    i = i + 1
  }
  found
}

fn dinsp_scan_fields(fields: Array[(String, Expr)], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    found = dinsp_scan(v, mode, name)
    i = i + 1
  }
  found
}

/// A binder named `name` in PATTERN position -- `let (inspect, x) = ..`, a
/// match/handle arm's `Some(inspect)`, a struct-pattern field bound to it.
///
/// Codex review on #1622 (P1): without this the shadow guard only saw binders
/// spelled in expression position, so a `inspect` introduced by destructuring
/// left `dinsp_binds_inspect` false and the rewrite went ahead and replaced the
/// user's own call with snapshot-assertion behaviour -- silently, since the
/// program still compiled.
fn dinsp_pat_binds(pat: Pat, name: String) -> Bool {
  match pat {
    PWild => false,
    PBind(n) => n == name,
    PInt(_) => false,
    PFloat(_) => false,
    PString(_) => false,
    PBool(_) => false,
    PCtor(_, args) => dinsp_pat_list_binds(args, name),
    PTuple(items) => dinsp_pat_list_binds(items, name),
    POr(a, b) => dinsp_pat_binds(a, name) || dinsp_pat_binds(b, name),
    PStruct(_, fields) => dinsp_pat_fields_bind(fields, name)
  }
}

fn dinsp_pat_list_binds(pats: Array[Pat], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(pats) {
    found = dinsp_pat_binds(Array::get(pats, i), name)
    i = i + 1
  }
  found
}

fn dinsp_pat_fields_bind(fields: Array[(String, Pat)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(fields) {
    let (_, p) = Array::get(fields, i)
    found = dinsp_pat_binds(p, name)
    i = i + 1
  }
  found
}

fn dinsp_arms_bind(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(arms) {
    let (p, _) = Array::get(arms, i)
    found = dinsp_pat_binds(p, name)
    i = i + 1
  }
  found
}

fn dinsp_scan_arms(arms: Array[(Pat, Expr)], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(arms) {
    let (_, v) = Array::get(arms, i)
    found = dinsp_scan(v, mode, name)
    i = i + 1
  }
  found
}

/// Every name `expr` MENTIONS -- as a reference or as a binder. Used to mint
/// temporaries that cannot capture anything in the expressions being moved.
/// Over-approximates (a shadowed inner binder counts too), which only ever
/// costs a suffix.
fn dinsp_mentions(expr: Expr, name: String) -> Bool {
  dinsp_scan(expr, 2, name)
}

fn dinsp_params_bind(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    found = pn == name
    i = i + 1
  }
  found
}

/// `base`, or `base` with the smallest numeric suffix that neither argument
/// mentions. Bounded by an occurrence check rather than a global counter so the
/// expansion stays a pure function of its inputs (two identical `inspect` calls
/// lower identically, which keeps the pass idempotent).
fn dinsp_fresh_name(base: String, value: Expr, content: Expr) -> String {
  let mut candidate = base
  let mut n = 0
  while dinsp_mentions(value, candidate) || dinsp_mentions(content, candidate) {
    n = n + 1
    candidate = String::concat(base, String::concat("_", __to_string(n)))
  }
  candidate
}

/// #1571: the desugared form of `inspect(value, content)`.
///
/// WHY A BUILTIN AT ALL. `inspect` was deliberately a plain library function in
/// `@vibe/core` -- it needs no codegen support, only `__to_string` + `println`
/// + `assert_true`, so adding it there cost nothing (see assert.vibe's header).
/// #1571 changed the constraint: migrating the `__DATA__` fixtures to inline
/// snapshots means `inspect` must be callable from a fixture compiled in the
/// SINGLE-FILE lane, which resolves no imports at all, so a library function
/// cannot be reached from one. Registering it alongside `assert` /
/// `assert_true` / `assert_eq` -- import-free for exactly this reason -- is
/// what unblocks the rest of that migration.
///
/// WHY A REWRITE AND NOT A CODEGEN LOWERING. The first cut lowered `inspect` at
/// the callsite in both backends, the way `assert_eq` is lowered. That builds
/// an invalid module: everything a call needs is decided by passes that run
/// BEFORE codegen and walk the AST, so an expression conjured during emission
/// is invisible to them. Measured, in order: the message literals were absent
/// from the string table (`string not in table: inspect mismatch:`), and once
/// those were seeded by hand, the synthesized `println` still had no gated-in
/// `Stdout::write_stream` import and produced `expected 1 elements on the stack
/// for fallthru, found 3`. Expanding here instead -- before checking, before
/// every scan -- means each of those passes sees ordinary calls and needs no
/// knowledge of `inspect` at all. It also gives both backends the same
/// expansion by construction rather than by two lowerings agreeing.
///
/// Both arguments are let-bound because each is referenced more than once.
/// Re-evaluating them would make `inspect(next(), ..)` consume two values and
/// report a different one than it compared.
///
/// The temporaries are minted FRESH against both arguments (dinsp_fresh_name).
/// A fixed name captures: with `let __vibe_inspect_actual = "wrong"`,
/// `inspect(1, __vibe_inspect_actual)` would move that reference under the new
/// binding and compare the stringified value against ITSELF -- a failing
/// assertion that silently passes, which is the worst way this could break
/// (Codex review on #1621).
fn inspect_lowering_expr(value: Expr, content: Expr) -> Expr {
  let actual_name = dinsp_fresh_name("__vibe_inspect_actual", value, content)
  let expected_name = dinsp_fresh_name("__vibe_inspect_expected", value, content)
  let actual = EIdent(actual_name, 0 - 1)
  let expected = EIdent(expected_name, 0 - 1)
  // Nested String::concat rather than one variadic call: `concat` is binary.
  let tail = ECall(EIdent("String::concat", 0 - 1), [
    EString("\n  expected: "),
    expected
  ], 0 - 1)
  let body_msg = ECall(EIdent("String::concat", 0 - 1), [actual, tail], 0 - 1)
  let msg = ECall(EIdent("String::concat", 0 - 1), [
    EString("inspect mismatch:\n  actual:   "),
    body_msg
  ], 0 - 1)
  // The message must print BEFORE the trap: `vibe test --update` reads exactly
  // this "actual/expected" text off stdout to rewrite the stale literal.
  let on_mismatch = ESeq(ECall(EIdent("println", 0 - 1), [msg], 0 - 1), ECall(EIdent("assert_true", 0 - 1), [
    EBool(false)
  ], 0 - 1))
  let check = EIf(EBinOp("==", actual, expected), EUnit, on_mismatch)
  ELet(actual_name, ECall(EIdent("__to_string", 0 - 1), [value], 0 - 1), ELet(expected_name, content, check, 0 - 1), 0 - 1)
}

/// Rewrite every two-argument `inspect(value, content)` call to its expansion.
///
/// Only reached when the file binds NOTHING named `inspect` (see
/// desugar_inspect_calls). A file that declares, imports or takes a parameter
/// named `inspect` keeps calling that one, exactly as it did before this pass
/// existed -- rewriting there would silently swap a user function's body for
/// snapshot-assertion behaviour (Codex review on #1621).
fn dinsp_expr(expr: Expr) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      let rewritten = for a in args {
        dinsp_expr(a)
      }
      match callee {
        EIdent(name, _) => if name == "inspect" && Array::length(rewritten) == 2 {
          inspect_lowering_expr(Array::get(rewritten, 0), Array::get(rewritten, 1))
        } else {
          ECall(dinsp_expr(callee), rewritten, off)
        },
        _ => ECall(dinsp_expr(callee), rewritten, off)
      }
    },
    _ => dinsp_children(expr)
  }
}

fn dinsp_exprs(items: Array[Expr]) -> Array[Expr] {
  for item in items {
    dinsp_expr(item)
  }
}

fn dinsp_fields(fields: Array[(String, Expr)]) -> Array[(String, Expr)] {
  for f in fields {
    (f.0, dinsp_expr(f.1))
  }
}

fn dinsp_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  for arm in arms {
    (arm.0, dinsp_expr(arm.1))
  }
}

fn dinsp_opt(opt: Option[Expr]) -> Option[Expr] {
  match opt {
    Some(v) => Some(dinsp_expr(v)),
    None => None
  }
}

/// Structural recursion for every non-ECall node. Enumerated rather than
/// `_ => expr` so a new `Expr` variant is a compile error here instead of a
/// silently un-rewritten subtree.
fn dinsp_children(expr: Expr) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EIdent(_, _) => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(dinsp_exprs(items)),
    EArray(items) => EArray(dinsp_exprs(items)),
    ERecord(n, fields, tys) => ERecord(n, dinsp_fields(fields), tys),
    EMap(fields) => EMap(dinsp_fields(fields)),
    EIf(c, t, f) => EIf(dinsp_expr(c), dinsp_expr(t), dinsp_expr(f)),
    ELet(n, v, b, off) => ELet(n, dinsp_expr(v), dinsp_expr(b), off),
    ELetRec(n, v, b) => ELetRec(n, dinsp_expr(v), dinsp_expr(b)),
    ELetMut(n, v, b, off) => ELetMut(n, dinsp_expr(v), dinsp_expr(b), off),
    EAssign(n, v, b) => EAssign(n, dinsp_expr(v), dinsp_expr(b)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, dinsp_expr(v), dinsp_expr(b)),
    ESeq(a, b) => ESeq(dinsp_expr(a), dinsp_expr(b)),
    EMatch(s, arms) => EMatch(dinsp_expr(s), dinsp_arms(arms)),
    EHandle(s, arms) => EHandle(dinsp_expr(s), dinsp_arms(arms)),
    EWhile(c, b) => EWhile(dinsp_expr(c), dinsp_expr(b)),
    ELoop(params, b) => ELoop(dinsp_fields(params), dinsp_expr(b)),
    EForIn(v, k, it, b) => EForIn(v, k, dinsp_expr(it), dinsp_expr(b)),
    ECall(callee, args, off) => ECall(dinsp_expr(callee), dinsp_exprs(args), off),
    EBinOp(op, l, r) => EBinOp(op, dinsp_expr(l), dinsp_expr(r)),
    EUnaryOp(op, v) => EUnaryOp(op, dinsp_expr(v)),
    EFn(g, bs, ps, ret, row, body) => EFn(g, bs, ps, ret, row, dinsp_expr(body)),
    EDot(inner, f, off, foff) => EDot(dinsp_expr(inner), f, off, foff),
    ELabeledArg(l, sfx, v) => ELabeledArg(l, sfx, dinsp_expr(v)),
    EReturn(v) => EReturn(dinsp_expr(v)),
    EBreak(opt) => EBreak(dinsp_opt(opt)),
    EContinue(args) => EContinue(dinsp_exprs(args)),
    ESpread(v) => ESpread(dinsp_expr(v))
  }
}

fn dinsp_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(e, r, n, t, body) => SLet(e, r, n, t, dinsp_expr(body)),
    SLetMut(n, t, body) => SLetMut(n, t, dinsp_expr(body)),
    SLetPat(p, body) => SLetPat(p, dinsp_expr(body)),
    STest(n, body) => STest(n, dinsp_expr(body)),
    SBench(n, body) => SBench(n, dinsp_expr(body)),
    SExample(n, body) => SExample(n, dinsp_expr(body)),
    SExpr(body) => SExpr(dinsp_expr(body)),
    SFnDecl(e, n, body, req, ens) => SFnDecl(e, n, dinsp_expr(body), req, ens),
    SModule(e, n, body) => SModule(e, n, dinsp_stmts_copy(body)),
    _ => stmt
  }
}

fn dinsp_stmts_copy(stmts: Array[Stmt]) -> Array[Stmt] {
  for s in stmts {
    dinsp_stmt(s)
  }
}

/// True when `expr` contains a two-argument `inspect(..)` call anywhere.
///
/// This is a READ-ONLY walk, and the reason it exists is measured, not
/// speculative: `dinsp_children` rebuilds every node it visits, so running the
/// rewrite unconditionally allocated a fresh copy of the whole AST for every
/// file -- +1.34% on `selfcompile heap_ptr_bytes`, which the perf gate reports
/// in its deterministic section where "any drift is real". Almost no file
/// calls `inspect`, and no file in the compiler's own source does, so checking
/// first and rebuilding only what needs it makes the pass free for them.
/// `rewrite_alias_expr_ix` (core/import_alias_rewrite.vibe) carries the same
/// guard for the same reason.
fn dinsp_uses(expr: Expr) -> Bool {
  dinsp_scan(expr, 0, "")
}

fn dinsp_stmt_uses(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, body) => dinsp_uses(body),
    SLetMut(_, _, body) => dinsp_uses(body),
    SLetPat(_, body) => dinsp_uses(body),
    STest(_, body) => dinsp_uses(body),
    SBench(_, body) => dinsp_uses(body),
    SExample(_, body) => dinsp_uses(body),
    SExpr(body) => dinsp_uses(body),
    SFnDecl(_, _, body, _, _) => dinsp_uses(body),
    SModule(_, _, body) => dinsp_stmts_use(body),
    _ => false
  }
}

fn import_items_bind_name(items: Array[ImportItem], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, i)
    let local = match item.alias {
      Some(alias) => alias,
      None => item.name
    }
    found = local == name
    i = i + 1
  }
  found
}

/// A declaration that gives `name` real source-local meaning. Top-level value
/// declarations are preclaimed by the checker, so their order within the
/// source unit does not change this answer. An aliased re-export is omitted on
/// purpose: its alias is publication-only and is exactly what this validation
/// protects from becoming a local after serialization.
fn stmt_top_level_binds_name(stmt: Stmt, name: String) -> Bool {
  match stmt {
    SLet(_, _, local, _, _) => local == name,
    SLetMut(local, _, _) => local == name,
    SLetPat(pat, _) => pat_binds_name(pat, name),
    SFnDecl(_, local, _, _, _) => local == name,
    SExternLet(local, _) => local == name,
    SImport(_, items) => import_items_bind_name(items, name),
    SReExport(_, items) => plain_reexport_binds(items, name),
    _ => false
  }
}

fn range_top_level_binds_name(stmts: Array[Stmt], start: Int, end: Int, name: String) -> Bool {
  let mut i = start
  let mut found = false
  while i < end && !found {
    found = stmt_top_level_binds_name(Array::get(stmts, i), name)
    i = i + 1
  }
  found
}

fn expr_list_has_free_name(items: Array[Expr], name: String) -> Bool with Exception {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    found = expr_has_free_name(Array::get(items, i), name)
    i = i + 1
  }
  found
}

fn arm_list_has_free_name(arms: Array[(Pat, Expr)], name: String) -> Bool with Exception {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, body) = Array::get(arms, i)
    if !pat_binds_name(pat, name) {
      found = expr_has_free_name(body, name)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Whether `name` occurs free in this expression. Binding forms stop only the
/// body region they govern; a same-spelled parameter in one nested function
/// must not hide an unrelated reference elsewhere in the source unit.
fn expr_has_free_name(expr: Expr, name: String) -> Bool with Exception {
  match expr {
    EIdent(local, _) => local == name,
    EStringInterp(_) => expr_has_free_name(resolve_interp_expr(expr), name),
    ELet(local, value, body, _) => expr_has_free_name(value, name) || if local == name {
      false
    } else {
      expr_has_free_name(body, name)
    },
    ELetRec(local, value, body) => if local == name {
      false
    } else {
      expr_has_free_name(value, name) || expr_has_free_name(body, name)
    },
    ELetMut(local, value, body, _) => expr_has_free_name(value, name) || if local == name {
      false
    } else {
      expr_has_free_name(body, name)
    },
    EAssign(local, value, body) => local == name || expr_has_free_name(value, name) || expr_has_free_name(body, name),
    EAssignOp(local, _, value, body) => local == name || expr_has_free_name(value, name) || expr_has_free_name(body, name),
    EForIn(value_name, key_name, iter, body) => expr_has_free_name(iter, name) || if value_name == name || match key_name {
      Some(key) => key == name,
      None => false
    } {
      false
    } else {
      expr_has_free_name(body, name)
    },
    EFn(_, _, params, _, _, body) => if params_bind_name(params, name) {
      false
    } else {
      expr_has_free_name(body, name)
    },
    ELoop(params, body) => {
      let mut i = 0
      let mut found = false
      let mut shadowed = false
      while i < Array::length(params) {
        let (local, initial) = Array::get(params, i)
        if !found {
          found = expr_has_free_name(initial, name)
        } else {
          ()
        }
        if local == name {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      found || if shadowed {
        false
      } else {
        expr_has_free_name(body, name)
      }
    },
    EMatch(scrutinee, arms) => expr_has_free_name(scrutinee, name) || arm_list_has_free_name(arms, name),
    EHandle(body, arms) => expr_has_free_name(body, name) || arm_list_has_free_name(arms, name),
    _ => expr_list_has_free_name(expr_children(expr), name)
  }
}

fn stmt_has_free_name(stmt: Stmt, name: String) -> Bool with Exception {
  match stmt {
    SLet(_, _, _, _, expr) => expr_has_free_name(expr, name),
    SLetMut(_, _, expr) => expr_has_free_name(expr, name),
    SLetPat(_, expr) => expr_has_free_name(expr, name),
    STest(_, expr) => expr_has_free_name(expr, name),
    SBench(_, expr) => expr_has_free_name(expr, name),
    SExample(_, expr) => expr_has_free_name(expr, name),
    SExpr(expr) => expr_has_free_name(expr, name),
    SFnDecl(_, _, expr, requires, ensures) => expr_has_free_name(expr, name) || expr_list_has_free_name(requires, name) || expr_list_has_free_name(ensures, name),
    SModule(_, _, body) => range_has_free_name(body, 0, Array::length(body), name),
    _ => false
  }
}

fn range_has_free_name(stmts: Array[Stmt], start: Int, end: Int, name: String) -> Bool with Exception {
  if range_top_level_binds_name(stmts, start, end, name) {
    false
  } else {
    let mut i = start
    let mut found = false
    while i < end && !found {
      found = stmt_has_free_name(Array::get(stmts, i), name)
      i = i + 1
    }
    found
  }
}

/// Reject every free reference to a publication-only re-export alias before
/// source-boundary metadata is removed. Without this check, reparsing the
/// printed program can silently reinterpret names such as `println`,
/// `assert_eq`, or `inspect` as compiler builtins. A real top-level binding or
/// a lexical binding that governs the particular reference remains valid.
export fn validate_serializable_reexport_references(stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SReExportSourceBoundary(_, surface_only_names) => {
        let start = i + 1
        let end = merged_source_range_end(stmts, start)
        let mut n = 0
        let mut invalid = ""
        while n < Array::length(surface_only_names) && String::length(invalid) == 0 {
          let name = Array::get(surface_only_names, n)
          if range_has_free_name(stmts, start, end, name) {
            invalid = name
          } else {
            ()
          }
          n = n + 1
        }
        if String::length(invalid) > 0 {
          throw(String::concat("unknown name: ", invalid))
        } else {
          ()
        }
        i = end
      },
      _ => {
        i = i + 1
      }
    }
  }
}

fn dinsp_stmts_use(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(stmts) {
    found = dinsp_stmt_uses(Array::get(stmts, i))
    i = i + 1
  }
  found
}

/// True when the file binds the name `inspect` anywhere -- an import (under
/// either spelling), a declaration, or any local binder or parameter.
///
/// The whole rewrite stands down for such a file. `inspect` is meant to be
/// reachable when nothing DEFINES it; where something does, that definition is
/// what the program meant, and quietly replacing a user function's body with
/// snapshot-assertion behaviour would be a silent change of meaning. This is
/// deliberately whole-file rather than scope-accurate: it is the conservative
/// direction (it can only decline to rewrite), and a file that binds `inspect`
/// at all is rare enough not to be worth a scope tracker that could get the
/// direction wrong.
///
/// It also puts `@vibe/core`'s library `inspect` and its importers back on
/// their original path -- assert.vibe binds the name, so its body is live
/// again, and `import @vibe/core { inspect }` still calls it.
fn dinsp_binds_inspect(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(stmts) {
    found = dinsp_stmt_binds(Array::get(stmts, i))
    i = i + 1
  }
  found
}

fn dinsp_blocker_names_inspect(names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = Array::get(names, i) == "inspect"
    i = i + 1
  }
  found
}

fn dinsp_range_binds_inspect(stmts: Array[Stmt], start: Int, end: Int) -> Bool {
  let mut i = start
  let mut found = false
  while !found && i < end {
    found = dinsp_stmt_binds(Array::get(stmts, i))
    i = i + 1
  }
  found
}

fn dinsp_rewrite_range(stmts: Array[Stmt], start: Int, end: Int) -> Bool {
  let mut changed = false
  let mut i = start
  while i < end {
    let stmt = Array::get(stmts, i)
    if dinsp_stmt_uses(stmt) {
      Array::set(stmts, i, dinsp_stmt(stmt))
      changed = true
    } else {
      ()
    }
    i = i + 1
  }
  changed
}

fn dinsp_has_reexport_source_boundaries(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(stmts) {
    found = Array::get(stmts, i) is SReExportSourceBoundary(_, _)
    i = i + 1
  }
  found
}

fn dinsp_rewrite_merged_source_ranges(stmts: Array[Stmt]) -> Bool {
  let mut changed = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SReExportSourceBoundary(local_names, _) => {
        let start = i + 1
        let mut end = start
        while end < Array::length(stmts) && !(Array::get(stmts, end) is SReExportSourceBoundary(_, _)) {
          end = end + 1
        }
        if !dinsp_blocker_names_inspect(local_names) && !dinsp_range_binds_inspect(stmts, start, end) {
          if dinsp_rewrite_range(stmts, start, end) {
            changed = true
          } else {
            ()
          }
        } else {
          ()
        }
        i = end
      },
      _ => {
        i = i + 1
      }
    }
  }
  changed
}

fn dinsp_import_binds(items: Array[ImportItem]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(items) {
    let item = Array::get(items, i)
    let original = item.name
    let alias = item.alias
    found = match alias {
      Some(a) => a == "inspect",
      None => original == "inspect"
    }
    i = i + 1
  }
  found
}

fn dinsp_stmt_binds(stmt: Stmt) -> Bool {
  match stmt {
    SImport(_, items) => dinsp_import_binds(items),
    // Direct/single-source checking sees the original re-export. The FS merge
    // replaces it with a source-boundary marker consumed by the range-aware
    // path above, so unrelated modules keep their builtin (#2287).
    SReExport(_, items) => dinsp_import_binds(items),
    SLet(_, _, name, _, body) => name == "inspect" || dinsp_mentions_binder(body),
    SLetMut(name, _, body) => name == "inspect" || dinsp_mentions_binder(body),
    SLetPat(pat, body) => dinsp_pat_binds(pat, "inspect") || dinsp_mentions_binder(body),
    SFnDecl(_, name, body, _, _) => name == "inspect" || dinsp_mentions_binder(body),
    STest(_, body) => dinsp_mentions_binder(body),
    SBench(_, body) => dinsp_mentions_binder(body),
    SExample(_, body) => dinsp_mentions_binder(body),
    SExpr(body) => dinsp_mentions_binder(body),
    SModule(_, _, body) => dinsp_binds_inspect(body),
    _ => false
  }
}

/// A binder named `inspect` INSIDE an expression (a `let`, a lambda parameter,
/// a `for` variable, or a match/handle arm's pattern). A bare reference does
/// not count -- that is the call this pass exists to rewrite.
fn dinsp_mentions_binder(expr: Expr) -> Bool {
  dinsp_scan(expr, 1, "")
}

/// In-place, like the other desugars in this file: `check_program` hands the
/// SAME array to the checker and then on to codegen, so a fresh array would be
/// dropped on the floor.
///
/// Only statements that actually contain an `inspect(..)` call are rebuilt --
/// see dinsp_uses for why that guard is load-bearing rather than cosmetic.
export fn desugar_inspect_calls_reporting_change(stmts: Array[Stmt]) -> Bool {
  let mut changed = false
  if dinsp_has_reexport_source_boundaries(stmts) {
    changed = dinsp_rewrite_merged_source_ranges(stmts)
  } else if dinsp_binds_inspect(stmts) {
    ()
  } else {
    changed = dinsp_rewrite_range(stmts, 0, Array::length(stmts))
  }
  changed
}

export fn desugar_inspect_calls(stmts: Array[Stmt]) -> Unit {
  let _changed = desugar_inspect_calls_reporting_change(stmts)
  ()
}

/// In-place labeled-argument reordering over a whole program. Rebuilds only the
/// top-level statements that the allocation-free scalar scan finds contain a
/// labeled argument.
export fn desugar_labeled_args(stmts: Array[Stmt]) -> Unit {
  Array::truncate(optional_param_local_cell, 0)
  Array::truncate(local_fn_tbl_cell, 0)
  Array::truncate(unstable_mut_tbl_cell, 0)
  Array::truncate(relabel_assigned_cell, 0)
  Array::truncate(unresolved_mut_labeled_cell, 0)
  let tbl = collect_fn_param_labels(stmts)
  // #1500: optional-parameter call sites are rewritten by the same walk (see
  // the ECall arm of relabel_expr). Unlike labeled arguments, an omitted
  // optional argument leaves NO syntactic trace at the call site -- `d(1)` for
  // `fn d(x: Int, z?: Int)` looks like any other call -- so when the program
  // declares one, every statement has to be walked, not just the ones
  // stmt_has_labeled_arg finds.
  let opt_tbl = collect_optional_param_fns(stmts)
  optional_param_tbl_set(opt_tbl)
  let walk_all = Array::length(opt_tbl) > 0 || stmts_have_optional_fn(stmts)
  // No `if Array::length(tbl) == 0` early-out. It was an optimisation that had
  // become a correctness hole once local lambdas got labels of their own
  // (#1899/#1952): collect_fn_param_labels indexes `SLet`s, so a file whose
  // only top-level statements are `test` blocks has an EMPTY table, and the
  // whole walk was skipped -- including the block-local labeled lambdas inside
  // those tests. stmt_has_labeled_arg already gates each statement, so
  // dropping the early-out costs one scalar scan per statement in the case
  // where nothing needs relabelling.
  let mut i = 0
  while i < Array::length(stmts) {
    if walk_all || stmt_has_labeled_arg(Array::get(stmts, i)) {
      Array::set(stmts, i, relabel_stmt(Array::get(stmts, i), tbl))
    } else {
      ()
    }
    i = i + 1
  }
  optional_param_tbl_set(array_empty())
  Array::truncate(optional_param_local_cell, 0)
  Array::truncate(local_fn_tbl_cell, 0)
  Array::truncate(unstable_mut_tbl_cell, 0)
  Array::truncate(relabel_assigned_cell, 0)
}

fn desugar_labeled_args_paired(stmts: Array[Stmt], roots: Array[BinderAuthorityNode], poisoned: Array[Bool]) -> Unit {
  Array::truncate(optional_param_local_cell, 0)
  Array::truncate(local_fn_tbl_cell, 0)
  Array::truncate(unstable_mut_tbl_cell, 0)
  Array::truncate(relabel_assigned_cell, 0)
  Array::truncate(unresolved_mut_labeled_cell, 0)
  let tbl = collect_fn_param_labels(stmts)
  let opt_tbl = collect_optional_param_fns(stmts)
  optional_param_tbl_set(opt_tbl)
  if Array::length(roots) != Array::length(stmts) {
    paired_poison(poisoned)
  } else {
    ()
  }
  let sentinel = BinderAuthorityNode::{
    kind: AuthorityExprUnit,
    slots: [],
    children: []
  }
  let mut i = 0
  while i < Array::length(stmts) {
    let root = if i < Array::length(roots) {
      Array::get(roots, i)
    } else {
      sentinel
    }
    Array::set(stmts, i, relabel_stmt_paired(Array::get(stmts, i), tbl, root, poisoned))
    i = i + 1
  }
  optional_param_tbl_set(array_empty())
  Array::truncate(optional_param_local_cell, 0)
  Array::truncate(local_fn_tbl_cell, 0)
  Array::truncate(unstable_mut_tbl_cell, 0)
  Array::truncate(relabel_assigned_cell, 0)
}

export fn normalize_labeled_args_with_binder_authority(source: LocatedProgramBinderAuthority) -> LabeledArgBinderAuthorityNormalization {
  let program = located_program_binder_authority_program(source)
  let roots = located_program_binder_authority_nodes(source)
  let poisoned = [false]
  desugar_labeled_args_paired(program, roots, poisoned)
  let normalized = if Array::get(poisoned, 0) {
    None
  } else {
    Some(NormalizedProgramBinderAuthority::{
      nodes: stored_normalized_authority_nodes(roots, 0)
    })
  }
  LabeledArgBinderAuthorityNormalization::{
    stored: StoredLabeledArgBinderAuthorityNormalizationValue(program, normalized)
  }
}

///|
/// #790: lower array-literal spreads `[a, ...xs, b]` into an `Array::concat` chain
/// of segments (`Array::concat(Array::concat([a], xs), [b])`). The parser accepts
/// `...expr` inside an array literal (ESpread), but the active desugar pipeline
/// never lowered it, so codegen reached ESpread and threw "unsupported expression
/// in codegen". Ported from the legacy desugar.vibe (spread-only; no other legacy
/// transforms). `das_arms` is mutually recursive with `das_expr`.
fn das_expr(expr: Expr) -> Expr {
  match expr {
    EArray(elems) => {
      let mut has_spread = false
      let mut si0 = 0
      while si0 < Array::length(elems) {
        match Array::get(elems, si0) {
          ESpread(_) => {
            has_spread = true
          },
          _ => ()
        }
        si0 = si0 + 1
      }
      if has_spread {
        let segments = array_empty()
        let mut buf = empty_expr_array()
        let mut si = 0
        while si < Array::length(elems) {
          let elem = Array::get(elems, si)
          match elem {
            ESpread(inner) => {
              if Array::length(buf) > 0 {
                Array::push(segments, EArray(for e in buf {
                  das_expr(e)
                }))
                buf = empty_expr_array()
              } else {
                ()
              }
              Array::push(segments, das_expr(inner))
            },
            _ => Array::push(buf, elem)
          }
          si = si + 1
        }
        if Array::length(buf) > 0 {
          Array::push(segments, EArray(for e in buf {
            das_expr(e)
          }))
        } else {
          ()
        }
        let mut acc = Array::get(segments, 0)
        let mut fi = 1
        while fi < Array::length(segments) {
          acc = ECall(EIdent("Array::concat", 0 - 1), [
            acc,
            Array::get(segments, fi)
          ], 0 - 1)
          fi = fi + 1
        }
        acc
      } else {
        EArray(for e in elems {
          das_expr(e)
        })
      }
    },
    ETuple(es) => ETuple(for e in es {
      das_expr(e)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, das_expr(v)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, das_expr(v)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(das_expr(c), das_expr(t), das_expr(e)),
    ELet(n, v, b, soff) => ELet(n, das_expr(v), das_expr(b), soff),
    ELetRec(n, v, b) => ELetRec(n, das_expr(v), das_expr(b)),
    ELetMut(n, v, b, soff) => ELetMut(n, das_expr(v), das_expr(b), soff),
    EAssign(n, v, c) => EAssign(n, das_expr(v), das_expr(c)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, das_expr(v), das_expr(c)),
    ESeq(a, b) => ESeq(das_expr(a), das_expr(b)),
    EMatch(s, arms) => EMatch(das_expr(s), das_arms(arms)),
    EHandle(s, arms) => EHandle(das_expr(s), das_arms(arms)),
    EWhile(c, b) => EWhile(das_expr(c), das_expr(b)),
    ELoop(params, b) => ELoop(for param in params {
      let (name, init) = param
      (name, das_expr(init))
    }, das_expr(b)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, das_expr(it), das_expr(b)),
    ECall(callee, args, off) => ECall(das_expr(callee), for a in args {
      das_expr(a)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, das_expr(l), das_expr(r)),
    EUnaryOp(op, e) => EUnaryOp(op, das_expr(e)),
    EFn(tp, tb, params, rt, eff, body) => EFn(tp, tb, params, rt, eff, das_expr(body)),
    EDot(o, f, off, fdoff) => EDot(das_expr(o), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, das_expr(e)),
    EReturn(e) => EReturn(das_expr(e)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(das_expr(e))),
      None => expr
    },
    EContinue(es) => EContinue(for e in es {
      das_expr(e)
    }),
    ESpread(inner) => ESpread(das_expr(inner)),
    _ => expr
  }
}

///|
fn das_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    Array::push(out, (p, das_expr(b)))
    i = i + 1
  }
  out
}

///|
fn das_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, das_expr(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, das_expr(body)),
    STest(name, body) => STest(name, das_expr(body)),
    SBench(name, body) => SBench(name, das_expr(body)),
    SExpr(e) => SExpr(das_expr(e)),
    SLetPat(pat, e) => SLetPat(pat, das_expr(e)),
    _ => stmt
  }
}

///|
/// In-place lowering of array-literal spreads across the whole program (#790).
export fn desugar_array_spread(stmts: Array[Stmt]) -> Unit {
  let n = Array::length(stmts)
  let mut i = 0
  while i < n {
    Array::set(stmts, i, das_stmt(Array::get(stmts, i)))
    i = i + 1
  }
}

///|
fn dtpw_exprs_bind_name(es: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    if dtpw_expr_binds_name(Array::get(es, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

///|
/// Does `expr` bind (shadow) `name` ANYWHERE within it -- as an EFn
/// parameter, a `let`/`let mut`/`let rec` name, a match/handle arm's
/// pattern binder, a for-loop's item/index name, or a `loop` parameter?
/// Full-coverage traversal mirroring dtpw_inline_expr's own node coverage.
/// See dtpw_collect_wrappers' call site for why this exists (#1074 review,
/// chatgpt-codex-connector P1: "Respect lexical shadowing in wrapper
/// inlining").
fn dtpw_expr_binds_name(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, _) = Array::get(params, i)
        if dlh_strip_tilde(pn) == name {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(body, name)
    },
    ELet(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    ELetRec(n, v, b) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    ELetMut(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    EForIn(n, idxn, it, b) => {
      let idx_hit = match idxn {
        Some(i2) => i2 == name,
        None => false
      }
      n == name || idx_hit || dtpw_expr_binds_name(it, name) || dtpw_expr_binds_name(b, name)
    },
    ELoop(params, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, init) = Array::get(params, i)
        if pn == name || dtpw_expr_binds_name(init, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(b, name)
    },
    EMatch(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(s, name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, i)
        let bound = array_empty()
        collect_pat_binders(p, bound)
        if str_array_contains(bound, name) || dtpw_expr_binds_name(b, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(s, name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, i)
        let bound = array_empty()
        collect_pat_binders(p, bound)
        if str_array_contains(bound, name) || dtpw_expr_binds_name(b, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ECall(callee, args, _) => dtpw_expr_binds_name(callee, name) || dtpw_exprs_bind_name(args, name),
    EBinOp(_, l, r) => dtpw_expr_binds_name(l, name) || dtpw_expr_binds_name(r, name),
    EUnaryOp(_, e) => dtpw_expr_binds_name(e, name),
    ETuple(es) => dtpw_exprs_bind_name(es, name),
    EArray(es) => dtpw_exprs_bind_name(es, name),
    ESpread(e) => dtpw_expr_binds_name(e, name),
    EContinue(es) => dtpw_exprs_bind_name(es, name),
    ERecord(_, fs, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, i)
        if dtpw_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, i)
        if dtpw_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, e) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(t, name) || dtpw_expr_binds_name(e, name),
    EAssign(_, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),
    EAssignOp(_, _, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),
    ESeq(a, b) => dtpw_expr_binds_name(a, name) || dtpw_expr_binds_name(b, name),
    EWhile(c, b) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(b, name),
    EDot(o, _, _, _) => dtpw_expr_binds_name(o, name),
    ELabeledArg(_, _, e) => dtpw_expr_binds_name(e, name),
    EReturn(e) => dtpw_expr_binds_name(e, name),
    EBreak(opt) => match opt {
      Some(e) => dtpw_expr_binds_name(e, name),
      None => false
    },
    _ => false
  }
}

///|
/// #1070 (narrow slice): a "trivial pass-through wrapper" is a top-level
/// `let name = (param) -> T with <row> { param() }` -- exactly one
/// parameter, body is EXACTLY a zero-arg call to that same parameter and
/// nothing else. Collects (wrapper_name, needed) pairs; `needed` is always
/// true here (arity always matches: the wrapper always takes exactly 1 arg
/// and calls its param with exactly 0), kept as a tuple only for symmetry
/// with how this file's other collector helpers are shaped.
///
/// A collected name is DROPPED again if it's shadowed ANYWHERE in the
/// program (any nested `let`/`let mut`/EFn parameter/match-or-handle-arm
/// binder/for-loop name/loop parameter reusing the same identifier) --
/// dtpw_inline_expr's rewrite matches call sites by NAME ONLY with no
/// scope tracking, so a shadowed name would otherwise get inlined at the
/// WRONG (shadowing) binding's call sites too, changing real program
/// behavior (#1074 review, chatgpt-codex-connector P1). This is
/// deliberately whole-program-conservative rather than precisely
/// scope-threaded: losing the optimization on the rare program that
/// happens to reuse a wrapper's name as a binder elsewhere is an
/// acceptable trade for guaranteed correctness, matching this file's
/// established "bail out entirely when it can't be proven safe" pattern
/// (see dlh_marker_only_called_directly's own doc comment).
fn dtpw_collect_wrappers(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {
        let (pname, _) = Array::get(params, 0)
        let stripped = dlh_strip_tilde(pname)
        match body {
          ECall(callee, args, _) => match callee {
            EIdent(cn, _) => if cn == stripped && Array::length(args) == 0 {
              Array::push(out, name)
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  let safe = array_empty()
  let mut j = 0
  while j < Array::length(out) {
    let wn = Array::get(out, j)
    let mut shadowed = false
    let mut k = 0
    while k < Array::length(stmts) && !shadowed {
      match Array::get(stmts, k) {
        SLet(_, _, _, _, sv) => if dtpw_expr_binds_name(sv, wn) {
          shadowed = true
        } else {
          ()
        },
        _ => ()
      }
      k = k + 1
    }
    if !shadowed {
      Array::push(safe, wn)
    } else {
      ()
    }
    j = j + 1
  }
  safe
}

/// Rewrite every `ECall(EIdent(wname), [single_arg], off)` where `wname` is a
/// collected trivial wrapper into `ECall(single_arg, [], off)` -- calling the
/// argument directly instead of routing through the identity wrapper. Full
/// traversal (mirrors this file's other full-coverage passes); the wrapper's
/// own top-level definition is left completely untouched, so it remains
/// valid wherever else it's referenced (as a value, or with a different
/// arity that wouldn't match here anyway).
fn dtpw_inline_expr(expr: Expr, wrappers: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(wn, _) => if str_array_contains(wrappers, wn) && Array::length(args) == 1 {
        ECall(dtpw_inline_expr(Array::get(args, 0), wrappers), array_empty(), off)
      } else {
        ECall(dtpw_inline_expr(callee, wrappers), for a in args {
          dtpw_inline_expr(a, wrappers)
        }, off)
      },
      _ => ECall(dtpw_inline_expr(callee, wrappers), for a in args {
        dtpw_inline_expr(a, wrappers)
      }, off)
    },
    EBinOp(op, l, r) => EBinOp(op, dtpw_inline_expr(l, wrappers), dtpw_inline_expr(r, wrappers)),
    EUnaryOp(op, e) => EUnaryOp(op, dtpw_inline_expr(e, wrappers)),
    ETuple(es) => ETuple(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    EArray(es) => EArray(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    ESpread(e) => ESpread(dtpw_inline_expr(e, wrappers)),
    EContinue(es) => EContinue(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(t, wrappers), dtpw_inline_expr(e, wrappers)),
    ELet(n, v, b, soff) => ELet(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),
    ELetRec(n, v, b) => ELetRec(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers)),
    ELetMut(n, v, b, soff) => ELetMut(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),
    EAssign(n, v, c) => EAssign(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),
    ESeq(a, b) => ESeq(dtpw_inline_expr(a, wrappers), dtpw_inline_expr(b, wrappers)),
    EWhile(c, b) => EWhile(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(b, wrappers)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, dtpw_inline_expr(it, wrappers), dtpw_inline_expr(b, wrappers)),
    EDot(o, f, off, fdoff) => EDot(dtpw_inline_expr(o, wrappers), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dtpw_inline_expr(e, wrappers)),
    EReturn(e) => EReturn(dtpw_inline_expr(e, wrappers)),
    EBreak(opt) => EBreak(match opt {
      Some(e) => Some(dtpw_inline_expr(e, wrappers)),
      None => None
    }),
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dtpw_inline_expr(body, wrappers)),
    EMatch(s, arms) => EMatch(dtpw_inline_expr(s, wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(b, wrappers))
    }),
    EHandle(s, arms) => EHandle(dtpw_inline_expr(s, wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(b, wrappers))
    }),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, dtpw_inline_expr(init, wrappers))
    }, dtpw_inline_expr(b, wrappers)),
    _ => expr
  }
}

fn dtpw_inline_trivial_wrappers(stmts: Array[Stmt]) -> Unit {
  let wrappers = dtpw_collect_wrappers(stmts)
  if Array::length(wrappers) == 0 {
    ()
  } else {
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, dtpw_inline_expr(expr, wrappers))),
        _ => ()
      }
      i = i + 1
    }
  }
}

///|
/// Entry point: in-place dictionary-passing desugaring. No-op unless the program
/// declares at least one method-bearing trait. Idempotent: re-running (the
/// single-file pipeline desugars before generic-stripping and codegen re-runs on
/// the same stmts after) finds the bounds already stripped (so no function is
/// re-threaded) and skips dict structs that already exist.
export fn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit with Exception {
  // #2286: the record describes THIS program. The unit-test batch compiles
  // many files in one long-lived daemon, so a table left standing would
  // relabel a later program's struct after an earlier program's trait.
  dtd_synth_dict_reset()
  // #790: lower array-literal spreads first, so no downstream pass or codegen
  // ever sees a raw ESpread.
  desugar_array_spread(stmts)
  // #1070 (narrow slice): inline a trivial pass-through wrapper
  // (`let apply = (f) -> { f() }`, body EXACTLY a same-arity direct call to
  // its own sole parameter, nothing else) at each matching call site
  // (`apply(x)` -> `x()`), before #786's hoist below. A capturing effectful
  // closure PASSED BY VALUE through such a wrapper (`apply(inner)` where
  // `inner` captures a local) crashes independent of #1069's closure-
  // conversion fix -- #1069 only rewrites provably-direct call sites, and
  // `inner` used as a bare argument to `apply` is exactly the "used as a
  // value" shape it correctly declines to touch. This doesn't attempt the
  // general problem (#1070's own analysis: real closure-conversion-to-
  // value semantics, or fixing #786's still-unlocated deeper combinator
  // bug) -- it only recognizes the specific case where the "value use" is
  // itself immediately, trivially, and unconditionally a direct call one
  // level removed, and short-circuits it back into an ordinary direct
  // call BEFORE #786/#1069's hoist+conversion logic runs, so THAT already-
  // verified machinery picks it up exactly as if the caller had written
  // `inner()` directly. Always sound regardless of what the argument does
  // (identity-wrapper inlining never changes observable behavior -- the
  // wrapper's own row already required whatever effects the checker
  // already validated at the original `apply(inner)` call site, and
  // `inner()` requires the identical row by construction), and leaves the
  // wrapper's own top-level definition untouched (usable as a value
  // wherever else it's referenced) -- only matching call sites are
  // rewritten, so a wrapper used BOTH as a value AND as a direct call
  // elsewhere is still handled safely either way.
  dtpw_inline_trivial_wrappers(stmts)
  // #786: hoist non-capturing effectful local lambdas to top-level functions
  // before any other pass. A local `let f = (x) -> { perform ... }` that captures
  // nothing gets promoted to a top-level `let f = ...`, so codegen emits a direct
  // function (with its `$read` effect param) instead of a local closure whose
  // arity-1 type may go unregistered. Runs first so the hoisted top-level SLets
  // are processed by every downstream pass (labeled args, dict rewrite, codegen).
  desugar_hoist_local_lambdas(stmts)
  // Labeled-argument reordering runs first so downstream passes and codegen see
  // args already in declared parameter order.
  desugar_labeled_args(stmts)
  // derive(...) structural function generation (#638) — independent of traits,
  // idempotent, so it runs unconditionally here at the shared pre-check points.
  // #1398 review (Codex P1): reset before desugar_derives repopulates it, so
  // the throw-site render can only ever name a renderer generated for THIS
  // program.
  derived_renderers_reset()
  // #1526: same reason -- the recorded set must describe THIS run's output.
  arr_eq_needed_reset()
  map_eq_needed_reset()
  bytes_eq_needed_reset()
  // #2141: a throw mid-rewrite leaves frames on the lexical binder stack;
  // reset so a later run on another program cannot see them.
  scope_formals_reset()
  // #2283: same discipline -- whether the assert lowering must stand down for
  // THIS program, because the program defines the name itself.
  user_assert_eq_reset(stmts)
  eq_tuple_uid_reset()
  eq_known_types_reset(stmts)
  desugar_derives(stmts)
  // #2205: the derive generators above are the only readers of the merge
  // rename table; clear it so a LATER compilation in this process (e.g. a
  // single-file lane, which runs no merge and therefore no reset) cannot see
  // stale entries. A second run of this pass over the same program
  // regenerates nothing and never reads the table.
  namespace_rename_originals_reset()
  derive_trait_namespace_operations(stmts)
  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)
  // dispatches both B's and A's methods through one witness dictionary. When the
  // program declares no method-bearing trait `traits` is empty, the dict-passing
  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),
  // and the rewrite pass only classifies the ASYNC for-loop shapes — so it must
  // still run unconditionally (those shapes need no trait machinery, #1350).
  // #1392: the `Show`-bounded `__to_string` pass-throughs in THIS program, so a
  // spelled-out `to_string(v)` renders like `"\{v}"` does. See dtd_show_shims.
  // #1445: must run BEFORE collect_method_traits_with_show, whose gate excludes
  // the shims -- see program_wants_show_dict.
  collect_show_shims(stmts)
  let traits_raw = collect_method_traits_with_show(stmts)
  let trait_type_params = collect_trait_type_params(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw, supers_map)
  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`
  // binder to its impl free functions (and annotate their params) BEFORE
  // build_gens, so `C::m` is registered as a bounded generic and the existing
  // dict-passing threads the witness at qualified call sites. Inert (and
  // idempotent) when no trait declares a method-level binder. Also run from
  // `check_program` so the FS-compile path (which type-checks before this pass)
  // sees the `X` binding and can resolve `X::method` in the impl body.
  inject_trait_method_generics_with(stmts, traits)
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let gimpl_infos = collect_generic_impl_infos(stmts)
  let gens = build_gens(stmts, traits, gimpl_infos)
  Array::truncate(dtd_constructor_local_returns, 0)
  Array::truncate(dtd_constructor_callable_bodies, 0)
  Array::set(dtd_constructor_tracking, 0, stmts_use_constructor_witness(stmts, gens))
  if Array::get(dtd_constructor_tracking, 0) {
    collect_constructor_callable_bodies(stmts)
    let mut previous_count = -1
    while previous_count != Array::length(dtd_constructor_local_returns) {
      previous_count = Array::length(dtd_constructor_local_returns)
      propagate_constructor_receiver_names(stmts)
    }
  } else {
    ()
  }
  // #839: see `collect_toplevel_anon_records` / the `rewrite_stmt` doc comment.
  let toplevel_vars = if Array::get(dtd_constructor_tracking, 0) {
    collect_toplevel_constructor_vars(stmts, gens, struct_sets, fn_returns)
  } else {
    collect_toplevel_anon_records(stmts, struct_sets)
  }
  // #1374: reset the exception-kind pass state. An already-declared cell means
  // an earlier run of this pass on this same program already wrapped every
  // throw, so the rewrite below stays off.
  Array::set(dtd_exn_kind_state, 0, if exn_kind_cell_present(stmts) {
    1
  } else {
    0
  })
  Array::set(dtd_exn_kind_state, 1, 0)
  Array::set(dtd_exn_kind_state, 2, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SReExportSourceBoundary(local_names, _) => user_assert_eq_set_merged_source(stmts, i + 1, local_names),
      stmt => Array::set(stmts, i, rewrite_stmt(stmt, gens, traits, struct_sets, fn_returns, toplevel_vars))
    }
    i = i + 1
  }
  // #1526: the rewrite above is what emits `__arr_equals__<key>` calls, so it
  // is what decides which helpers exist. Anything `desugar_derives` could not
  // predict (an operand reached through a name) is generated here. Bytes
  // second: generating an `__arr_equals__` body can record the Bytes need
  // (`Array[Bytes]` elements), and `__bytes_equals` records nothing back.
  // Array, Map, and specialized generic comparator bodies can record needs
  // into one another. Alternate all three emitters to a mutual fixpoint.
  emit_recorded_structural_eq(stmts)
  emit_recorded_bytes_equals(stmts)
  // #1374: append the cell only for a program that actually reads or writes it,
  // so a throw-free program's output is unchanged.
  if Array::get(dtd_exn_kind_state, 1) == 1 {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
  // Witness dict structs are only needed when method-bearing traits exist.
  if Array::length(traits_raw) == 0 {
    ()
  } else {
    let mut ti = 0
    while ti < Array::length(traits) {
      let (trait_name, sigs) = Array::get(traits, ti)
      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {
        ()
      } else {
        // #2286: record the provenance at the ONE point a dict struct is
        // actually synthesized -- one row per field, carrying the trait that
        // DECLARES it, which for an inherited method is a supertrait rather
        // than `trait_name`.
        let dict_name = dict_struct_name(trait_name)
        let owners = flatten_trait_owners(trait_name, traits_raw, supers_map)
        let mut si = 0
        while si < Array::length(sigs) {
          let (mname, _mparams, _mret) = Array::get(sigs, si)
          Array::push(dtd_synth_dict_fields, (dict_name, mname, lookup_str_pair(owners, mname, trait_name)))
          si = si + 1
        }
        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs, lookup_trait_type_params(trait_type_params, trait_name)))
      }
      ti = ti + 1
    }
  }
}
