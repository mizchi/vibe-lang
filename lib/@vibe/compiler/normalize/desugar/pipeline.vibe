/// In-place lowering of array-literal spreads across the whole program (#790).
export fn desugar_array_spread(_ stmts: Array[Stmt]) -> Unit {
  lower_array_spreads(stmts = stmts, end = dtd_own_end(stmts))
}

/// Entry point: in-place dictionary-passing desugaring. No-op unless the program
/// declares at least one method-bearing trait. Idempotent: re-running (the
/// single-file pipeline desugars before generic-stripping and codegen re-runs on
/// the same stmts after) finds the bounds already stripped (so no function is
/// re-threaded) and skips dict structs that already exist.
export fn desugar_trait_dicts(_ stmts: Array[Stmt]) -> Unit with Exception {
  desugar_trait_dicts_with_typed_eq(stmts = stmts, typed_eq_offsets = array_empty(), typed_eq_keys = array_empty())
}

export fn desugar_trait_dicts_with_typed_eq(stmts: Array[Stmt], typed_eq_offsets: Array[Int], typed_eq_keys: Array[String]) -> Unit with Exception {
  dtd_whole_program(stmts = stmts, typed_eq_offsets = typed_eq_offsets, typed_eq_keys = typed_eq_keys, rowless_build = false)
}

/// #3456: the whole-program entry for a BUILD lane with no checker rows for
/// its program. Since #3625 every build lane parses located; what is left is
/// a linked entry that no import-resolving check answered for in exactly the
/// text it compiles (`compile_file_wasi_linked_artifacts` on its own, or a
/// `vibe build --debug` entry whose checked text is not the text it parsed --
/// see `desugar_linked_entry`). An interpolated untyped `let` that shadows a
/// typed name has no type here but the OUTER binding's, which renders the
/// value as the wrong type when the shadow changes it. Such a site is refused
/// with the edit (annotate the shadowing `let`) rather than answered.
export fn desugar_trait_dicts_rowless_build(_ stmts: Array[Stmt]) -> Unit with Exception {
  dtd_whole_program(stmts = stmts, typed_eq_offsets = array_empty(), typed_eq_keys = array_empty(), rowless_build = true)
}

fn dtd_whole_program(stmts: Array[Stmt], typed_eq_offsets: Array[Int], typed_eq_keys: Array[String], rowless_build: Bool) -> Unit with Exception {
  // #3543: no rows, so no `Float` arithmetic could be rounded -- refuse a
  // program that can hold a Float rather than compute it in f64.
  if rowless_build {
    refuse_rowless_float_program(stmts)
    // #3730: nor could an `Int32` / `UInt32` result be wrapped to 32 bits.
    refuse_rowless_int32_program(stmts)
    // #2334: nor could a scalar-keyed map's calls get the scalar operations.
    refuse_rowless_scalar_map_program(stmts)
  } else {
    ()
  }
  // #3730: an impl or a method owned by `Int32` / `UInt32` cannot survive
  // their erasure to `Int`.
  refuse_int32_owned_decls(stmts)
  Array::set(dtd_rowless_build, at = 0, value = rowless_build)
  // #3132: this pass synthesizes `Array::get` / `Array::length` / ... calls
  // (interpolation, structural `==`, iteration), which must reach the
  // builtin. Every entry pipeline reaches here before its first such
  // synthesis; a program's own definition of one of those names is moved
  // aside first. A no-op when the linked prelude already ran it.
  rename_builtin_shadow_defs(stmts)
  Array::set(dtd_own_limit, at = 0, value = 0 - 1)
  Array::set(dtd_ctx_len, at = 0, value = 0)
  Array::set(dlh_module_tag, at = 0, value = "")
  // A whole program carries no per-module facts (#2647 Codex round 8). Cleared
  // on ENTRY rather than trusted to have been cleared on the way out, because
  // `dtd_run` ends in `eq_refusals_report`, which THROWS: a module lowering
  // that hits a structural-`==` refusal skips the per-module entry's own clear
  // and leaves these cells populated. Since both entries now set them before
  // any reader runs, no exceptional-exit cleanup is needed anywhere -- there is
  // no path into `dtpw_collect_wrappers` or `dtd_source_op_defined` that does
  // not pass through one of the two. Left stale, a wrapper name from a FAILED
  // compile rewrites `apply(pick)` in the next program to `pick()`.
  dtd_facts_set(module_trait_facts_none())
  // One program per call, so this call's deferrals and refusals are this
  // program's. The per-module entry deliberately does NOT reset: its caller
  // wants the union across the modules of one split run, and resets once at
  // that boundary (#2642 review, Codex P2).
  eq_deferred_reset()
  dtd_run(stmts = stmts, rows = desugar_typed_rows(typed_eq_offsets = typed_eq_offsets, typed_eq_keys = typed_eq_keys), ctx_int32_free = false, report = true)
  // #3144 round 4: a witness field is named by COMPUTING `<Type>::<method>`,
  // which for an impl method at a listed name (`impl Measured for String {
  // length(..) }`) is the source spelling of a definition renamed above.
  // This run points those references at the definition; the builtin calls
  // this pass wrote carry `builtin_ref` and stay on the builtin.
  rename_builtin_shadow_defs(stmts)
  // The lane is over: clear the merge rename table so a later compilation in
  // this process cannot see stale entries (#2205, moved here in #2647 round 6).
  namespace_rename_originals_reset()
}

/// #2388: the per-module entry. `own` is the module's statements, rewritten in
/// place; `ctx` is its dependency interface -- the type / trait declarations,
/// bounded-generic function definitions and explicit `T::op` definitions it
/// can see through its imports, in their pre-pass (contract) form -- read for
/// lookups and never emitted. Returns the statements the pass appended: the
/// derived operations of the module's own types (`T::equals`, …) and the
/// program-level helpers they and the module's `==` sites need
/// (`__arr_equals__*`, `__map_equals__*`, the exn-kind cell). A caller links
/// them once per name across modules; a `T::op` for a type this module
/// declares is this module's definition. Only the trait namespace operations
/// are placed inside `own` (right after their trait, as the whole-program
/// entry does), which is why the entry tracks how much the own region grew.
///
/// `module_tag` names this module for the one generated top-level name that
/// cannot be derived from a declaration -- a lambda hoisted out of a bare
/// expression statement (see `dlh_owner_name`). Every other hoisted name comes from
/// the declaration that owns it and so is already module-unique; pass "" to
/// number the nameless ones by position, as the whole-program entry does.
export fn desugar_trait_dicts_module(own: Array[Stmt], ctx: Array[Stmt], module_tag: String, typed_eq_offsets: Array[Int], typed_eq_keys: Array[String]) -> Array[Stmt] with Exception {
  desugar_trait_dicts_module_with_facts(own = own, ctx = ctx, module_tag = module_tag, typed_eq_offsets = typed_eq_offsets, typed_eq_keys = typed_eq_keys, facts = module_trait_facts_none())
}

/// The same entry given the whole-program facts a partition cannot derive
/// (#2647 Codex rounds 6-7). See `ModuleTraitFacts`. The five-argument form
/// above passes none, which is right for a MEASUREMENT and wrong for a
/// production driver -- a caller that means to compile passes real ones.
export fn desugar_trait_dicts_module_with_facts(own: Array[Stmt], ctx: Array[Stmt], module_tag: String, typed_eq_offsets: Array[Int], typed_eq_keys: Array[String], facts: ModuleTraitFacts) -> Array[Stmt] with Exception {
  desugar_trait_dicts_module_impl(own = own, ctx = ctx, module_tag = module_tag, rows = desugar_typed_rows(typed_eq_offsets = typed_eq_offsets, typed_eq_keys = typed_eq_keys), ctx_int32_free = false, facts = facts, report = true)
}

/// #2826: the same entry for a driver that lowers EVERY module of one program
/// and reports once. This module's refusals are filed with the program's
/// (`desugar_module_reports_begin` / `_flush`) instead of thrown here. A
/// refusal the pass throws while it runs still throws at once, as it does on
/// the whole program.
///
/// Thrown per module, the refusals were a different answer from the whole
/// program's whenever a second module had one: the first module's report ended
/// the compile, so a later module's `==` refusal went missing, a later
/// module's refusal of an earlier-reported family lost to an earlier module's
/// refusal of a later one, and a 32-bit `Add` row -- filed for the whole
/// program, consumed only by the module holding the call -- refused a valid
/// program from every other module's run.
///
/// #3976: such a driver lowers every module against the same typed rows, so it
/// sorts them once (`desugar_typed_rows`) and passes the result here. It also
/// reads each dependency interface once, where every importer used to read it
/// again: `ctx_int32_free` vouches that no statement of `ctx` spells `Int32` /
/// `UInt32` (`desugar_stmts_spell_int32` over the interfaces it was drawn
/// from), and false is always safe.
export fn desugar_trait_dicts_module_deferring(own: Array[Stmt], ctx: Array[Stmt], module_tag: String, rows: DtdTypedRows, ctx_int32_free: Bool, facts: ModuleTraitFacts) -> Array[Stmt] with Exception {
  desugar_trait_dicts_module_impl(own = own, ctx = ctx, module_tag = module_tag, rows = rows, ctx_int32_free = ctx_int32_free, facts = facts, report = false)
}

/// #3976: whether some statement of `stmts` spells `Int32` or `UInt32` in a
/// type or a qualified name -- the question the trait-dict pass asks before
/// its 32-bit rewrite, for a driver that answers it once per interface.
export fn desugar_stmts_spell_int32(_ stmts: Array[Stmt]) -> Bool {
  program_mentions_int32(stmts)
}

fn desugar_trait_dicts_module_impl(own: Array[Stmt], ctx: Array[Stmt], module_tag: String, rows: DtdTypedRows, ctx_int32_free: Bool, facts: ModuleTraitFacts, report: Bool) -> Array[Stmt] with Exception {
  Array::set(dtd_rowless_build, at = 0, value = false)
  dtd_facts_set(facts)
  let stmts: Array[Stmt] = []
  let mut i = 0
  while i < Array::length(own) {
    Array::push(stmts, value = Array::get(own, at = i))
    i = i + 1
  }
  let mut ci = 0
  while ci < Array::length(ctx) {
    Array::push(stmts, value = Array::get(ctx, at = ci))
    ci = ci + 1
  }
  Array::set(dtd_own_limit, at = 0, value = Array::length(own))
  Array::set(dtd_ctx_len, at = 0, value = Array::length(ctx))
  Array::set(dtd_own_growth, at = 0, value = 0)
  Array::set(dlh_module_tag, at = 0, value = module_tag)
  dtd_run(stmts = stmts, rows = rows, ctx_int32_free = ctx_int32_free, report = report)
  // #3144 round 4: as in the whole-program entry. The module's own
  // definitions and its context's are both in `stmts`, so a witness naming
  // either is pointed at the renamed definition.
  rename_builtin_shadow_defs(stmts)
  let own_n = Array::length(own)
  let own_end = own_n + Array::get(dtd_own_growth, at = 0)
  let mut wi = 0
  while wi < own_end {
    if wi < own_n {
      Array::set(own, at = wi, value = Array::get(stmts, at = wi))
    } else {
      Array::push(own, value = Array::get(stmts, at = wi))
    }
    wi = wi + 1
  }
  let synthesized: Array[Stmt] = []
  let mut si = own_end + Array::length(ctx)
  while si < Array::length(stmts) {
    Array::push(synthesized, value = Array::get(stmts, at = si))
    si = si + 1
  }
  Array::set(dtd_own_limit, at = 0, value = 0 - 1)
  Array::set(dtd_ctx_len, at = 0, value = 0)
  Array::set(dlh_module_tag, at = 0, value = "")
  dtd_facts_set(module_trait_facts_none())
  synthesized
}

/// #3042 (ADR-0118): append the prelude `enum Ordering { Less; Equal;
/// Greater } derive (Eq, Ord, Show)` to a program that builds an `Ordering`
/// -- one that derives `Ord`, or names one of its constructors as a value or a
/// pattern (`stmts_use_prelude_ordering`) -- and does not
/// declare those names itself. The checker checked every module against the
/// same declaration (`seed_prelude_ordering`); this is the one copy the merged
/// program is compiled with, so every module's `Less` is the same constructor.
/// A program that already carries a declaration (a second run of this pass,
/// or `@vibe/builtin`'s `ordering.vibe` linked in) is left as it is.
///
/// A program that derives `Ord` while one of its modules declares an
/// `Ordering`, or a `Less` / `Equal` / `Greater` constructor or value, of
/// another shape has no constructor the derived `compare` may build, so it is
/// refused. The checker refuses the module-local and imported-constructor
/// shapes first; this catches a foreign `Ordering` that reached a module only
/// through an imported signature, whose declaration that module never saw.
///
/// An exact-shaped `enum Ordering { Less; Equal; Greater }` declared by some
/// module IS the prelude for the modules that import a signature mentioning
/// it, and the checker binds the prelude's `equals` / `compare` /
/// `to_string` for them. A declaration written without those derives gains
/// them here; one that defines such an operation by hand instead is refused,
/// since its signature need not be the one the importers were checked against.
fn dtd_append_prelude_ordering(_ stmts: Array[Stmt]) -> Unit with Exception {
  if dtd_stmts_derive_ord(stmts) && dtd_ordering_foreign_shadow(stmts) {
    throw("`derive (Ord)` generates `compare` returning the prelude `Ordering` (`Less` / `Equal` / `Greater`), but a module in this program declares its own `Ordering` or one of those constructors; rename that declaration")
  } else if !stmts_shadow_prelude_ordering(stmts) {
    if stmts_use_prelude_ordering(stmts) {
      Array::push(stmts, value = prelude_ordering_stmt())
    }
  } else {
    dtd_complete_prelude_ordering_derives(stmts)
  }
}

/// Does some top-level statement shadow the prelude `Ordering` other than an
/// exact-shaped `enum Ordering { Less; Equal; Greater }` declaration?
fn dtd_ordering_foreign_shadow(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  for stmt in stmts {
    let one = [stmt]
    if stmts_shadow_prelude_ordering(one) && !stmts_declare_prelude_ordering_shape(one) {
      found = true
    }
  }
  found
}

/// Give an exact-shaped `Ordering` declaration the prelude's `Eq` / `Ord` /
/// `Show` derives it lacks, refusing one whose operation the program defines.
fn dtd_complete_prelude_ordering_derives(_ stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    if stmts_declare_prelude_ordering_shape([stmt]) {
      match stmt {
        SEnum(exported, name, params, variants, derives) => {
          let completed = array_empty()
          for d in derives {
            Array::push(completed, value = d)
          }
          for pair in [
            ("Eq", "Ordering::equals"),
            ("Ord", "Ordering::compare"),
            ("Show", "Ordering::to_string")
          ] {
            let (wanted, op) = pair
            let mut present = false
            for d in completed {
              if d == wanted {
                present = true
              }
            }
            // A hand-written operation is refused whether or not the derive is
            // listed: `desugar_derives` lets a source definition replace the
            // generated one, and its signature need not be the prelude's.
            if dtd_stmts_define_value(stmts = stmts, wanted = op) {
              throw(String::concat("`enum Ordering { Less; Equal; Greater }` is spelled exactly like the prelude, so it carries the prelude's `derive (Eq, Ord, Show)`; `", String::concat(op, "` is also written by hand -- remove it and derive it, or rename the type")))
            }
            if !present {
              Array::push(completed, value = wanted)
            }
          }
          Array::set(stmts, at = i, value = SEnum(exported, name, params, variants, completed))
        },
        _ => ()
      }
    }
    i = i + 1
  }
}

fn dtd_stmts_define_value(stmts: Array[Stmt], wanted: String) -> Bool {
  let mut found = false
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, _) => if name == wanted {
        found = true
      },
      _ => ()
    }
  }
  found
}

/// Does any struct or enum in `stmts` derive `Ord`?
fn dtd_stmts_derive_ord(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  for stmt in stmts {
    let derives = match stmt {
      SStruct(_, _, _, ds, _, _) => ds,
      SEnum(_, _, _, _, ds) => ds,
      _ => array_empty()
    }
    for d in derives {
      if d == "Ord" {
        found = true
      }
    }
  }
  found
}

/// #3976: sort the checker's typed rows into the tables `dtd_run` reads, by
/// row kind. This reads the rows and nothing else -- not the program, and no
/// table a run writes -- so one set of rows always sorts the same way. The
/// per-module driver lowers every module of a program against the same rows,
/// and used to repeat this sort for each of them: 722 modules times about
/// 16,000 rows on the CLI closure. It now sorts once and passes the result to
/// every module (`desugar_trait_dicts_module_deferring`).
export fn desugar_typed_rows(typed_eq_offsets: Array[Int], typed_eq_keys: Array[String]) -> DtdTypedRows {
  // #3066: the render rows ride the same channel under the
  // `typed_render_row_head` wrapper; they are split off here so a `==` lookup
  // never reads one.
  let eq_offs: Array[Int] = []
  let eq_keys: Array[String] = []
  let render_offs: Array[Int] = []
  let render_keys: Array[String] = []
  let render_prefix = impl_target_key(TyApp(typed_render_row_head(), [
    TyName("Int")
  ]))
  let render_head_len = String::index_of(render_prefix, needle = impl_target_key(TyName("Int")))
  let render_head = String::substring(render_prefix, start = 0, end = render_head_len)
  // #3133: the index-receiver rows, split off the same way.
  let index_offs: Array[Int] = []
  let index_verdicts: Array[String] = []
  let forin_offs: Array[Int] = []
  let forin_verdicts: Array[String] = []
  let forin_map_key = impl_target_key(TyApp(typed_forin_row_head(), [
    TyName(typed_index_map_verdict())
  ]))
  let forin_open_key = impl_target_key(TyApp(typed_forin_row_head(), [
    TyName(typed_index_open_verdict())
  ]))
  let index_map_key = impl_target_key(TyApp(typed_index_row_head(), [
    TyName(typed_index_map_verdict())
  ]))
  let index_open_key = impl_target_key(TyApp(typed_index_row_head(), [
    TyName(typed_index_open_verdict())
  ]))
  // #2501: a settled, non-Map receiver, so a row rather than the receiver's
  // spelling answers there.
  let forin_seq_key = impl_target_key(TyApp(typed_forin_row_head(), [
    TyName(typed_index_seq_verdict())
  ]))
  let index_seq_key = impl_target_key(TyApp(typed_index_row_head(), [
    TyName(typed_index_seq_verdict())
  ]))
  // #3543: the Float arithmetic rows, split off the same way and consumed by
  // `rewrite_float_arith_stmts` below.
  let f32_binop_key = impl_target_key(TyApp(typed_f32_row_head(), [
    TyName(typed_f32_binop_verdict())
  ]))
  let f32_assign_key = impl_target_key(TyApp(typed_f32_row_head(), [
    TyName(typed_f32_assign_verdict())
  ]))
  let f32_binop_offs: Array[Int] = []
  let f32_assign_offs: Array[Int] = []
  // #3629: the float-operand rows, consumed by the same rewrite.
  let fop_binop_key = impl_target_key(TyApp(typed_float_operand_row_head(), [
    TyName(typed_f32_binop_verdict())
  ]))
  let fop_assign_key = impl_target_key(TyApp(typed_float_operand_row_head(), [
    TyName(typed_f32_assign_verdict())
  ]))
  // #3653: the float-negation rows, keyed by the negated operand.
  let fop_negation_key = impl_target_key(TyApp(typed_float_operand_row_head(), [
    TyName(typed_f32_negation_verdict())
  ]))
  let fop_binop_offs: Array[Int] = []
  let fop_assign_offs: Array[Int] = []
  let fop_negation_offs: Array[Int] = []
  let f32_negation_key = impl_target_key(TyApp(typed_f32_row_head(), [
    TyName(typed_f32_negation_verdict())
  ]))
  let f32_negation_offs: Array[Int] = []
  // #2334: the scalar-keyed map calls, consumed by
  // `rewrite_map_scalar_key_stmts` below.
  let map_scalar_key = impl_target_key(TyApp(typed_map_key_row_head(), [
    TyName(typed_map_scalar_key_verdict())
  ]))
  let map_scalar_offs: Array[Int] = []
  // #3730: the 32-bit integer wrap rows, consumed by `rewrite_int32_stmts`.
  let i32_key = (verdict: String) -> impl_target_key(TyApp(typed_int32_row_head(), [
    TyName(verdict)
  ]))
  let i32_binop_key = i32_key("Binop32")
  let u32_binop_key = i32_key("BinopU32")
  let i32_assign_key = i32_key("Assign32")
  let u32_assign_key = i32_key("AssignU32")
  let i32_neg_key = i32_key("Neg32")
  let u32_not_key = i32_key("NotU32")
  let i32_binop_offs: Array[Int] = []
  let u32_binop_offs: Array[Int] = []
  let i32_assign_offs: Array[Int] = []
  let u32_assign_offs: Array[Int] = []
  let i32_neg_offs: Array[Int] = []
  let u32_not_offs: Array[Int] = []
  let scalar_local_key = impl_target_key(TyName(typed_scalar_local_row_head()))
  let add32_keys = [
    impl_target_key(TyApp(typed_add32_call_row_head(), [TyName("Int32")])),
    impl_target_key(TyApp(typed_add32_call_row_head(), [TyName("UInt32")])),
    impl_target_key(TyApp(typed_add32_call_row_head(), [TyName("mixed")]))
  ]
  let add32_types = ["Int32", "UInt32", "mixed"]
  let add32_offs: Array[Int] = []
  let add32_row_types: Array[String] = []
  let scalar_local_offs: Array[Int] = []
  let mut teq_i = 0
  while teq_i < Array::length(typed_eq_offsets) {
    let tkey = Array::get(typed_eq_keys, at = teq_i)
    let add32_at = add32_key_index(keys = add32_keys, key = tkey)
    if add32_at >= 0 {
      Array::push(add32_offs, value = Array::get(typed_eq_offsets, at = teq_i))
      Array::push(add32_row_types, value = Array::get(add32_types, at = add32_at))
    } else if tkey == f32_binop_key {
      Array::push(f32_binop_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == f32_assign_key {
      Array::push(f32_assign_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == fop_binop_key {
      Array::push(fop_binop_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == fop_assign_key {
      Array::push(fop_assign_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == fop_negation_key {
      Array::push(fop_negation_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == f32_negation_key {
      Array::push(f32_negation_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == i32_binop_key {
      Array::push(i32_binop_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == u32_binop_key {
      Array::push(u32_binop_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == i32_assign_key {
      Array::push(i32_assign_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == u32_assign_key {
      Array::push(u32_assign_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == i32_neg_key {
      Array::push(i32_neg_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == u32_not_key {
      Array::push(u32_not_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == scalar_local_key {
      Array::push(scalar_local_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == map_scalar_key {
      Array::push(map_scalar_offs, value = Array::get(typed_eq_offsets, at = teq_i))
    } else if tkey == forin_map_key {
      dtd_typed_row_insert(dtd_typed_index_offs = forin_offs, dtd_typed_index_verdicts = forin_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_map_verdict())
    } else if tkey == forin_open_key {
      dtd_typed_row_insert(dtd_typed_index_offs = forin_offs, dtd_typed_index_verdicts = forin_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_open_verdict())
    } else if tkey == index_map_key {
      dtd_typed_row_insert(dtd_typed_index_offs = index_offs, dtd_typed_index_verdicts = index_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_map_verdict())
    } else if tkey == index_open_key {
      dtd_typed_row_insert(dtd_typed_index_offs = index_offs, dtd_typed_index_verdicts = index_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_open_verdict())
    } else if tkey == forin_seq_key {
      dtd_typed_row_insert(dtd_typed_index_offs = forin_offs, dtd_typed_index_verdicts = forin_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_seq_verdict())
    } else if tkey == index_seq_key {
      dtd_typed_row_insert(dtd_typed_index_offs = index_offs, dtd_typed_index_verdicts = index_verdicts, off = Array::get(typed_eq_offsets, at = teq_i), verdict = typed_index_seq_verdict())
    } else if render_head_len > 0 && String::starts_with(tkey, prefix = render_head) {
      dtd_typed_render_insert_into(offs = render_offs, keys = render_keys, off = Array::get(typed_eq_offsets, at = teq_i), key = tkey)
    } else {
      Array::push(eq_offs, value = Array::get(typed_eq_offsets, at = teq_i))
      Array::push(eq_keys, value = tkey)
    }
    teq_i = teq_i + 1
  }
  DtdTypedRows::{
    eq_offs: eq_offs,
    eq_keys: eq_keys,
    render_offs: render_offs,
    render_keys: render_keys,
    index_offs: index_offs,
    index_verdicts: index_verdicts,
    forin_offs: forin_offs,
    forin_verdicts: forin_verdicts,
    add32_offs: add32_offs,
    add32_types: add32_row_types,
    f32_binop: f32_binop_offs,
    f32_assign: f32_assign_offs,
    f32_negation: f32_negation_offs,
    fop_binop: fop_binop_offs,
    fop_assign: fop_assign_offs,
    fop_negation: fop_negation_offs,
    i32_binop: i32_binop_offs,
    u32_binop: u32_binop_offs,
    i32_assign: i32_assign_offs,
    u32_assign: u32_assign_offs,
    i32_neg: i32_neg_offs,
    u32_not: u32_not_offs,
    scalar_local: scalar_local_offs,
    map_scalar: map_scalar_offs
  }
}

/// #3976: make `rows` this run's lookup tables, as the sort used to fill them
/// in place: every table cleared first, then refilled from a copy, with no
/// 32-bit `Add` row consumed yet and no index refusal filed.
fn dtd_typed_rows_install(_ rows: DtdTypedRows) -> Unit {
  // #2441: (re)populate the typed-`==` table for THIS program before any
  // rewrite can read it.
  Array::truncate(dtd_typed_eq_offs, length = 0)
  Array::truncate(dtd_typed_eq_keys, length = 0)
  dtd_append_ints(dst = dtd_typed_eq_offs, src = rows.eq_offs)
  dtd_append_strings(dst = dtd_typed_eq_keys, src = rows.eq_keys)
  dtd_typed_render_install(offs = rows.render_offs, keys = rows.render_keys)
  Array::truncate(dtd_typed_index_offs, length = 0)
  Array::truncate(dtd_typed_index_verdicts, length = 0)
  Array::truncate(dtd_index_refusals, length = 0)
  Array::truncate(dtd_typed_forin_offs, length = 0)
  Array::truncate(dtd_typed_forin_verdicts, length = 0)
  dtd_append_ints(dst = dtd_typed_index_offs, src = rows.index_offs)
  dtd_append_strings(dst = dtd_typed_index_verdicts, src = rows.index_verdicts)
  dtd_append_ints(dst = dtd_typed_forin_offs, src = rows.forin_offs)
  dtd_append_strings(dst = dtd_typed_forin_verdicts, src = rows.forin_verdicts)
  dtd_add32_reset()
  let mut i = 0
  while i < Array::length(rows.add32_offs) {
    dtd_add32_insert(off = Array::get(rows.add32_offs, at = i), ty = Array::get(rows.add32_types, at = i))
    i = i + 1
  }
}

fn dtd_append_ints(dst: Array[Int], src: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, value = Array::get(src, at = i))
    i = i + 1
  }
}

fn dtd_append_strings(dst: Array[String], src: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, value = Array::get(src, at = i))
    i = i + 1
  }
}

fn dtd_ints_copy(_ src: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  dtd_append_ints(dst = out, src = src)
  out
}

/// `ctx_int32_free`: the caller vouches that no statement of the module's
/// dependency interface spells `Int32` / `UInt32`, so the test for whether
/// the rewrite below must run skips them (`rewrite_int32_stmts_vouched`).
/// False reads them, as the whole program does.
fn dtd_run(stmts: Array[Stmt], rows: DtdTypedRows, ctx_int32_free: Bool, report: Bool) -> Unit with Exception {
  dtd_typed_rows_install(rows)
  // `rewrite_float_arith_stmts` sorts its rows in place, so each run gets its
  // own copy of every row array a rewrite consumes.
  let f32_binop_offs = dtd_ints_copy(rows.f32_binop)
  let f32_assign_offs = dtd_ints_copy(rows.f32_assign)
  let f32_negation_offs = dtd_ints_copy(rows.f32_negation)
  let fop_binop_offs = dtd_ints_copy(rows.fop_binop)
  let fop_assign_offs = dtd_ints_copy(rows.fop_assign)
  let fop_negation_offs = dtd_ints_copy(rows.fop_negation)
  let i32_binop_offs = dtd_ints_copy(rows.i32_binop)
  let u32_binop_offs = dtd_ints_copy(rows.u32_binop)
  let i32_assign_offs = dtd_ints_copy(rows.i32_assign)
  let u32_assign_offs = dtd_ints_copy(rows.u32_assign)
  let i32_neg_offs = dtd_ints_copy(rows.i32_neg)
  let u32_not_offs = dtd_ints_copy(rows.u32_not)
  let scalar_local_offs = dtd_ints_copy(rows.scalar_local)
  let map_scalar_offs = dtd_ints_copy(rows.map_scalar)
  // #2286: the record describes THIS program. The unit-test batch compiles
  // many files in one long-lived daemon, so a table left standing would
  // relabel a later program's struct after an earlier program's trait.
  dtd_synth_dict_reset()
  // Compare source calls before optimizers can replace their callees or add
  // hoisted capture arguments. Their subsequent positional calls are already
  // canonical and must not be interpreted as fresh written arguments.
  lower_checked_call_placements(stmts = stmts, require_checked = true)
  // #3543: round every `Float` arithmetic result to f32 before any pass
  // below copies or hoists the expressions that hold one. #3629: and mark
  // every float operation's operands, before the `+` / `<` rewrite below
  // can read a generic call's result as a type formal.
  rewrite_float_arith_stmts(stmts = stmts, binop_offs = f32_binop_offs, assign_offs = f32_assign_offs, operand_offs = fop_binop_offs, operand_assign_offs = fop_assign_offs, negation_offs = fop_negation_offs, f32_negation_offs = f32_negation_offs)
  // #3730: wrap every `Int32` / `UInt32` result to 32 bits and erase both
  // types to `Int`, before any pass below reads a type or copies a site.
  // #3976: a module's context sits at own_limit .. own_limit + ctx_len until
  // the trait namespace operations below grow the own region.
  let own_lim = Array::get(dtd_own_limit, at = 0)
  let i32_free_from = if ctx_int32_free && own_lim >= 0 {
    own_lim
  } else {
    0
  }
  let i32_free_to = if ctx_int32_free && own_lim >= 0 {
    own_lim + Array::get(dtd_ctx_len, at = 0)
  } else {
    0
  }
  rewrite_int32_stmts_vouched(stmts = stmts, binop32 = i32_binop_offs, binopu32 = u32_binop_offs, assign32 = i32_assign_offs, assignu32 = u32_assign_offs, neg32 = i32_neg_offs, notu32 = u32_not_offs, free_from = i32_free_from, free_to = i32_free_to)
  // #2334: and every scalar-keyed map call to its scalar operation, before a
  // pass below copies or inlines the call.
  rewrite_map_scalar_key_stmts(stmts = stmts, offs = map_scalar_offs)
  // #790: lower array-literal spreads first, so no downstream pass or codegen
  // ever sees a raw ESpread.
  desugar_array_spread(stmts)
  // #3042: the prelude `Ordering` joins a program that builds one, before
  // any pass below collects the program's declared types.
  dtd_append_prelude_ordering(stmts)
  // #1070 (narrow slice): inline a trivial pass-through wrapper
  // (`let apply = (f) -> { f() }`, body EXACTLY a same-arity direct call to
  // its own sole parameter, nothing else) at each matching call site
  // (`apply(x)` -> `x()`), before #786's hoist below. A capturing effectful
  // closure PASSED BY VALUE through such a wrapper (`apply(inner)` where
  // `inner` captures a local) crashes independent of #1069's closure-
  // conversion fix -- #1069 only rewrites provably-direct call sites, and
  // `inner` used as a bare argument to `apply` is exactly the "used as a
  // value" shape it correctly declines to touch. This doesn't attempt the
  // general problem (#1070's own analysis: real closure-conversion-to-
  // value semantics, or fixing #786's still-unlocated deeper combinator
  // bug) -- it only recognizes the specific case where the "value use" is
  // itself immediately, trivially, and unconditionally a direct call one
  // level removed, and short-circuits it back into an ordinary direct
  // call BEFORE #786/#1069's hoist+conversion logic runs, so THAT already-
  // verified machinery picks it up exactly as if the caller had written
  // `inner()` directly. Always sound regardless of what the argument does
  // (identity-wrapper inlining never changes observable behavior -- the
  // wrapper's own row already required whatever effects the checker
  // already validated at the original `apply(inner)` call site, and
  // `inner()` requires the identical row by construction), and leaves the
  // wrapper's own top-level definition untouched (usable as a value
  // wherever else it's referenced) -- only matching call sites are
  // rewritten, so a wrapper used BOTH as a value AND as a direct call
  // elsewhere is still handled safely either way.
  dtpw_inline_trivial_wrappers(stmts)
  // #786: hoist non-capturing effectful local lambdas to top-level functions
  // before dictionary rewriting. A local `let f = (x) -> { perform ... }` that captures
  // nothing gets promoted to a top-level `let f = ...`, so codegen emits a direct
  // function (with its `$read` effect param) instead of a local closure whose
  // arity-1 type may go unregistered. The hoisted top-level SLets
  // are processed by downstream dictionary rewriting and codegen.
  desugar_hoist_local_lambdas(stmts)
  // derive(...) structural function generation (#638) — independent of traits,
  // idempotent, so it runs unconditionally here at the shared pre-check points.
  // #1398 review (Codex P1): reset before desugar_derives repopulates it, so
  // the throw-site render can only ever name a renderer generated for THIS
  // program.
  derived_renderers_reset()
  // #1526: same reason -- the recorded set must describe THIS run's output.
  arr_eq_needed_reset()
  map_eq_needed_reset()
  bytes_eq_needed_reset()
  // #2141: a throw mid-rewrite leaves frames on the lexical binder stack;
  // reset so a later run on another program cannot see them.
  scope_formals_reset()
  // #2283: same discipline -- whether the assert lowering must stand down for
  // THIS program, because the program defines the name itself.
  user_assert_eq_reset(stmts)
  dtd_builtin_iterator_reset(stmts)
  eq_tuple_uid_reset()
  eq_known_types_reset(stmts)
  // #3947: before any collector reads an impl's key or a bound.
  expand_trait_key_aliases(stmts)
  desugar_derives(stmts)
  // #2205's reset used to be HERE and is now at the LANE boundary
  // (`desugar_trait_dicts_with_typed_eq`, and the per-module driver after its
  // last module). Its purpose is unchanged -- the derive generators above are
  // the only readers of the merge rename table, and a LATER compilation in this
  // process must not see stale entries.
  //
  // What changed is granularity (#2647 Codex round 6). `dtd_run` runs ONCE
  // whole-program but once PER MODULE on the split lane, so clearing here meant
  // module 0 read the table and every module after it found it empty --
  // rendering `Point_dep_<path>` instead of `Point` in derived `Show` / `Hash`
  // output. The table is built by `record_namespace_rename_originals_for_file`
  // during the MERGE, before any of this runs, so no module can rebuild it.
  //
  // This is the same defect as the deferral registries in round 1 of the same
  // review: a process-global registry reset at per-run granularity, where the
  // split lane needs lane granularity.
  //
  // #3947: the checker matched impls with the same canonical keys.
  canonicalize_trait_ref_aliases(stmts)
  derive_trait_namespace_operations(stmts)
  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)
  // dispatches both B's and A's methods through one witness dictionary. When the
  // program declares no method-bearing trait `traits` is empty, the dict-passing
  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),
  // and the rewrite pass only classifies the ASYNC for-loop shapes — so it must
  // still run unconditionally (those shapes need no trait machinery, #1350).
  // #1392: the `Show`-bounded `__to_string` pass-throughs in THIS program, so a
  // spelled-out `to_string(v)` renders like `"\{v}"` does. See dtd_show_shims.
  collect_show_shims(stmts)
  local_show_shim_reset()
  // #2523: BEFORE the trait table is built, so every downstream collector --
  // collect_method_traits, collect_trait_supers, build_gens, impl target
  // resolution -- sees the prelude's `Eq` the same way it sees a program's
  // own. Injecting only the SIGNATURES left the impls missing and the dict
  // record was built without its field: `unknown struct field: equals` on
  // `bare[T: Eq](1, 1)`, measured. The two halves have to arrive together.
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  // #2523: the `==` rung's entailment test reads the same graph the flattening
  // walked -- see dtd_bound_entails_eq.
  //
  // #3312: set it BEFORE the injection, whose scan asks the same question of
  // every bound. Set after, the scan read the previous run's graph (or none):
  // with `trait Key: Eq` and only `[T: Key]` in the program, the scan saw no
  // bound entailing `Eq`, injected nothing, and `x == y` compared two equal
  // `Double`s raw (`false`).
  dtd_trait_supers_set(supers_map)
  // #3580: read with the supers graph when a call through a trait bound
  // passes the witnesses of the method's own bounded formals.
  dtd_inject_builtin_eq_and_add(stmts = stmts, traits_raw = traits_raw)
  dtd_trait_method_binders_set(stmts = stmts, traits_raw = traits_raw)
  let trait_type_params = collect_trait_type_params(stmts)
  let traits = flatten_traits(traits_raw = traits_raw, supers_map = supers_map)
  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`
  // binder to its impl free functions (and annotate their params) BEFORE
  // build_gens, so `C::m` is registered as a bounded generic and the existing
  // dict-passing threads the witness at qualified call sites. Inert (and
  // idempotent) when no trait declares a method-level binder. Also run from
  // `check_program` so the FS-compile path (which type-checks before this pass)
  // sees the `X` binding and can resolve `X::method` in the impl body.
  inject_trait_method_generics_with(stmts = stmts, traits = traits)
  let struct_sets = collect_struct_field_sets(stmts)
  rewrite_scalar_local_stmts(stmts = stmts, offs = scalar_local_offs, shapes = struct_sets)
  let fn_returns = collect_fn_returns(stmts)
  add_context_renderer_returns(fn_returns)
  let gimpl_infos = collect_impl_infos(stmts)
  let gens = build_gens(stmts = stmts, traits = traits, gimpl_infos = gimpl_infos)
  Array::truncate(dtd_constructor_local_returns, length = 0)
  Array::truncate(dtd_constructor_callable_bodies, length = 0)
  Array::set(dtd_constructor_tracking, at = 0, value = gens_use_constructor_receiver(gens) && stmts_use_constructor_witness(stmts = stmts, gens = gens))
  if Array::get(dtd_constructor_tracking, at = 0) {
    collect_constructor_callable_bodies(stmts)
    let mut previous_count = -1
    while previous_count != Array::length(dtd_constructor_local_returns) {
      previous_count = Array::length(dtd_constructor_local_returns)
      propagate_constructor_receiver_names(stmts)
    }
  } else {
    ()
  }
  // #839: see `collect_toplevel_anon_records` / the `rewrite_stmt` doc comment.
  let toplevel_vars = if Array::get(dtd_constructor_tracking, at = 0) {
    collect_toplevel_constructor_vars(stmts = stmts, gens = gens, struct_sets = struct_sets, fn_returns = fn_returns)
  } else {
    collect_toplevel_anon_records(stmts = stmts, struct_sets = struct_sets)
  }
  // #1374: reset the exception-kind pass state. An already-declared cell means
  // an earlier run of this pass on this same program already wrapped every
  // throw, so the rewrite below stays off.
  Array::set(dtd_exn_kind_state, at = 0, value = if exn_kind_cell_present(stmts) {
    1
  } else {
    0
  })
  Array::set(dtd_exn_kind_state, at = 1, value = 0)
  Array::set(dtd_exn_kind_state, at = 2, value = 0)
  exn_rethrow_reset()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    if !dtd_is_own_index(i) {
      ()
    } else {
      dtd_fresh_reset_for_decl()
      match merged_source_boundary_local_names(stmt) {
        Some(local_names) => {
          user_assert_eq_set_merged_source(stmts = stmts, start = i + 1, names = local_names)
          dtd_builtin_iterator_set_boundary(local_names)
        },
        None => Array::set(stmts, at = i, value = rewrite_stmt(stmt = stmt, gens = gens, traits = traits, struct_sets = struct_sets, fn_returns = fn_returns, toplevel_vars = toplevel_vars))
      }
    }
    i = i + 1
  }
  // #1526: the rewrite above is what emits `__arr_equals__<key>` calls, so it
  // is what decides which helpers exist. Anything `desugar_derives` could not
  // predict (an operand reached through a name) is generated here. Bytes
  // second: generating an `__arr_equals__` body can record the Bytes need
  // (`Array[Bytes]` elements), and `__bytes_equals` records nothing back.
  // Array, Map, and specialized generic comparator bodies can record needs
  // into one another. Alternate all three emitters to a mutual fixpoint.
  emit_recorded_structural_eq(stmts)
  emit_recorded_bytes_equals(stmts)
  // #1374: append the cell only for a program that actually reads or writes it,
  // so a throw-free program's output is unchanged.
  if Array::get(dtd_exn_kind_state, at = 1) == 1 {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
  // Witness dict structs are only needed when method-bearing traits exist.
  if Array::length(traits_raw) == 0 {
    ()
  } else {
    let mut ti = 0
    while ti < Array::length(traits) {
      let (trait_name, sigs) = Array::get(traits, at = ti)
      // #2523: the builtin `Eq` is injected as SIGNATURES (dtd_inject_builtin_eq),
      // never as a statement, so `dtd_trait_declared_here` is false for it and
      // this guard skipped its dict struct -- which is exactly why a
      // signatures-only injection produced `unknown struct field: equals` on
      // `bare[T: Eq](1, 1)`. Declaring it as a statement instead is what made
      // `Int::next` reach codegen unresolved and the module-split oracles
      // diverge: a trait DECLARATION feeds collect_method_traits, the supers
      // map and the trait-namespace machinery, and an injection performed once
      // per run makes a whole-program run and a per-module run disagree.
      //
      // The dict struct is this pass's OWN output -- it appends one for every
      // method-bearing trait already -- so emitting it for the injected trait
      // adds nothing the pass does not otherwise produce.
      let injected_builtin = (trait_name == dtd_eq_witness_trait() || trait_name == "Add") && !dtd_trait_declared_anywhere(stmts = stmts, trait_name = trait_name)
      if struct_decl_exists(stmts = stmts, name = dict_struct_name(trait_name)) || (!dtd_trait_declared_here(stmts = stmts, trait_name = trait_name) && !injected_builtin) {
        ()
      } else {
        // #2286: record the provenance at the ONE point a dict struct is
        // actually synthesized -- one row per field, carrying the trait that
        // DECLARES it, which for an inherited method is a supertrait rather
        // than `trait_name`.
        let dict_name = dict_struct_name(trait_name)
        let owners = flatten_trait_owners(tname = trait_name, traits_raw = traits_raw, supers_map = supers_map)
        let mut si = 0
        while si < Array::length(sigs) {
          let (mname, _mparams, _mret) = Array::get(sigs, at = si)
          Array::push(dtd_synth_dict_fields, value = (dict_name, mname, lookup_str_pair(pairs = owners, key = mname, fallback = trait_name)))
          si = si + 1
        }
        // #2523: `make_dict_struct_stmt` keeps `Self` verbatim in the field
        // types, on the documented reasoning that struct type params are
        // erased so the field-access typing is structural. That holds for a
        // DECLARED trait, whose declaration puts `Self` in scope. The injected
        // builtin has no declaration, so `Self` resolved to nothing:
        // `unknown type `Self` in field `equals` of struct `EqDict``,
        // measured. Bind it as an (erased) type parameter of the dict struct
        // instead, which is the same erasure the comment already relies on.
        let dict_tparams = if injected_builtin {
          let tp: Array[String] = ["Self"]
          tp
        } else {
          lookup_trait_type_params(entries = trait_type_params, trait_name = trait_name)
        }
        Array::push(stmts, value = make_dict_struct_stmt(trait_name = trait_name, sigs = method_witness_dict_sigs(traits = traits, trait_name = trait_name, sigs = sigs), tparams = dict_tparams))
      }
      ti = ti + 1
    }
  }
  if report {
    eq_refusals_report()
    show_refusals_report()
    index_refusals_report()
    dtd_add32_report()
  } else {
    dtd_module_reports_collect()
  }
}

/// #3825: which `#add32[..]` row `key` is, or -1.
fn add32_key_index(keys: Array[String], key: String) -> Int {
  let mut found = 0 - 1
  let mut i = 0
  while i < Array::length(keys) {
    if found < 0 && Array::get(keys, at = i) == key {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #2475: a structural-equality refusal is a COMPILE error, not a runtime trap.
///
/// Every one of these used to be emitted as a bare `assert_true(false)`, so the
/// program compiled clean and died with `trap: RuntimeError: unreachable` -- no
/// message, no position, nothing to act on. There is no way to attach a message
/// at run time: `assert_eq` lowers to `println` and so requires `Console` on the
/// containing function (#2107), which breaks a derived `::equals` outright and
/// would reject user code with an effect-row error about the wrong thing.
///
/// So it is reported here, at the end of the rewrite, where the pass already
/// carries `with Exception`. The refusal itself is unchanged -- these sites
/// were never going to answer -- but the program now fails to build, saying
/// which comparison and what to write instead, and NO guard is emitted for it.
///
/// The cost, accepted deliberately: a comparison that is written but never
/// executed used to compile and run, and no longer does. `vibe check` does not
/// run this pass, so it stays clean; the refusal lands on `vibe build` /
/// `vibe run` / `vibe test`.
///
/// A refusal may carry its site as a ` [@off=N]` marker (#3297). The driver
/// locates only the FIRST marker of a message, at its start, so a marker on a
/// later line is stripped rather than shown raw or used to place the first.
fn eq_refusals_report() -> Unit with Exception {
  let out = eq_refusals_text(dtd_eq_refusals)
  if out == "" {
    ()
  } else {
    throw(out)
  }
}

/// The one diagnostic `refusals` make, or "" when there are none.
fn eq_refusals_text(_ refusals: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(refusals) {
    let reason = if i == 0 {
      Array::get(refusals, at = i)
    } else {
      eq_strip_off_marker(Array::get(refusals, at = i))
    }
    out = String::concat(out, String::concat(if i == 0 {
      ""
    } else {
      "\n"
    }, String::concat("structural `==` cannot be decided here: ", reason)))
    i = i + 1
  }
  out
}

//# One report for a program lowered module by module (#2826)

/// The refusals of the modules a `desugar_trait_dicts_module_deferring` driver
/// has lowered so far, in module order, deduplicated as one run deduplicates
/// them. The 32-bit `Add` rows are kept by `add32_rows.vibe`.
let dtd_split_eq_refusals: Array[String] = []
let dtd_split_show_refusals: Array[String] = []
let dtd_split_index_refusals: Array[String] = []

/// Start one program's reports. Called before its first module is lowered, so
/// a previous program's refusals -- one that threw part-way, say -- are gone.
export fn desugar_module_reports_begin() -> Unit {
  Array::truncate(dtd_split_eq_refusals, length = 0)
  Array::truncate(dtd_split_show_refusals, length = 0)
  Array::truncate(dtd_split_index_refusals, length = 0)
  dtd_add32_split_reset()
}

/// Has a module lowered so far been refused? Then the program is: the flush
/// throws, and the passes the whole program runs after this one never run
/// there. An unconsumed 32-bit row is not a refusal yet -- a later module may
/// hold its call.
export fn desugar_module_reports_pending() -> Bool {
  Array::length(dtd_split_eq_refusals) > 0 || Array::length(dtd_split_show_refusals) > 0 || Array::length(dtd_split_index_refusals) > 0
}

/// Report the program's refusals exactly as one whole-program run reports
/// them: every `==` refusal in one diagnostic, then the first renderer
/// refusal, then the first index refusal, then the first 32-bit row no module
/// consumed.
export fn desugar_module_reports_flush() -> Unit with Exception {
  let eq = eq_refusals_text(dtd_split_eq_refusals)
  if eq != "" {
    throw(eq)
  } else if Array::length(dtd_split_show_refusals) > 0 {
    throw(Array::get(dtd_split_show_refusals, at = 0))
  } else if Array::length(dtd_split_index_refusals) > 0 {
    throw(Array::get(dtd_split_index_refusals, at = 0))
  } else {
    dtd_add32_split_report()
  }
}

/// A copy of the refusals filed since `desugar_module_reports_begin`. A
/// worker that lowers one module of a program calls `begin`, lowers it with
/// `desugar_trait_dicts_module_deferring`, and sends this back, so that its
/// coordinator can file the module with the program's
/// (`desugar_module_reports_merge`).
export fn desugar_module_reports_take() -> DesugarModuleReports {
  let (offs, types, used) = dtd_add32_split_rows()
  DesugarModuleReports::{
    eq: dtd_split_strings_copy(dtd_split_eq_refusals),
    show: dtd_split_strings_copy(dtd_split_show_refusals),
    index: dtd_split_strings_copy(dtd_split_index_refusals),
    add32_offs: offs,
    add32_types: types,
    add32_used: used
  }
}

/// File refusals another run took (`desugar_module_reports_take`) with the
/// program's, exactly as that run's own module would have been filed:
/// deduplicated, in order, and a 32-bit `Add` row consumed when either side
/// consumed it. Merging each module's reports in module order gives the
/// program the reports one in-process driver would have collected.
export fn desugar_module_reports_merge(_ reports: DesugarModuleReports) -> Unit {
  dtd_split_collect_into(dst = dtd_split_eq_refusals, src = reports.eq)
  dtd_split_collect_into(dst = dtd_split_show_refusals, src = reports.show)
  dtd_split_collect_into(dst = dtd_split_index_refusals, src = reports.index)
  dtd_add32_split_merge(offs = reports.add32_offs, types = reports.add32_types, used = reports.add32_used)
}

/// No refusals: what a module that was not refused sends back.
export fn desugar_module_reports_none() -> DesugarModuleReports {
  DesugarModuleReports::{
    eq: [],
    show: [],
    index: [],
    add32_offs: [],
    add32_types: [],
    add32_used: []
  }
}

/// Do `reports` hold a refusal? Then so does the program, and -- as
/// `desugar_module_reports_pending` says -- the module they came from runs
/// none of the passes after this one. Rows alone are not a refusal.
export fn desugar_module_reports_refused(_ reports: DesugarModuleReports) -> Bool {
  Array::length(reports.eq) > 0 || Array::length(reports.show) > 0 || Array::length(reports.index) > 0
}

fn dtd_split_strings_copy(_ src: Array[String]) -> Array[String] {
  let out: Array[String] = []
  for s in src {
    Array::push(out, value = s)
  }
  out
}

/// File this module's refusals with the program's.
fn dtd_module_reports_collect() -> Unit {
  dtd_split_collect_into(dst = dtd_split_eq_refusals, src = dtd_eq_refusals)
  dtd_split_collect_into(dst = dtd_split_show_refusals, src = dtd_show_refusals)
  dtd_split_collect_into(dst = dtd_split_index_refusals, src = dtd_index_refusals)
  dtd_add32_split_collect()
}

/// Append each of `src` that `dst` does not hold yet. A module's context
/// carries bodies another module also lowers, so the same refusal, at the
/// same offset, can come from both runs.
fn dtd_split_collect_into(dst: Array[String], src: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    let r = Array::get(src, at = i)
    if !str_array_contains(arr = dst, val = r) {
      Array::push(dst, value = r)
    } else ()
    i = i + 1
  }
}

/// `msg` without its ` [@off=N]` site marker, if it has one.
fn eq_strip_off_marker(_ msg: String) -> String {
  let mi = String::index_of(msg, needle = " [@off=")
  if mi < 0 {
    msg
  } else {
    let rest = String::substring(msg, start = mi, end = String::length(msg))
    let close = String::index_of(rest, needle = "]")
    if close < 0 {
      String::substring(msg, start = 0, end = mi)
    } else {
      String::concat(String::substring(msg, start = 0, end = mi), String::substring(rest, start = close + 1, end = String::length(rest)))
    }
  }
}
