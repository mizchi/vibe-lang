// ---- derive(...) structural function generation (#638) ----
//
// For a `struct P { x; y } derive(Show, Ord)` this generates the structural
// free functions `P::to_string` and `P::compare` (concrete `Type::method`,
// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural
// `==` is a runtime builtin). Hash / Default and enums are deferred slices.

export fn qualified_name(tname: String, method: String) -> String {
  String::concat(tname, String::concat("::", method))
}

export fn module_trait_facts_none() -> ModuleTraitFacts {
  ModuleTraitFacts::{
    wrapper_names: array_empty(),
    explicit_ops: array_empty()
  }
}

export fn dtd_facts_set(_ facts: ModuleTraitFacts) -> Unit {
  Array::truncate(dtd_facts_wrappers, length = 0)
  Array::truncate(dtd_facts_explicit_ops, length = 0)
  let mut i = 0
  while i < Array::length(facts.wrapper_names) {
    Array::push(dtd_facts_wrappers, value = Array::get(facts.wrapper_names, at = i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(facts.explicit_ops) {
    Array::push(dtd_facts_explicit_ops, value = Array::get(facts.explicit_ops, at = j))
    j = j + 1
  }
}

/// Does the SOURCE define this derived operation -- here or anywhere in the
/// program? Distinct from `top_level_fn_exists`, which also answers "have we
/// already emitted this generated helper"; widening THAT would suppress a
/// helper the module genuinely needs, so only the derive-suppression sites
/// consult the whole-program set.
export fn dtd_source_op_defined(stmts: Array[Stmt], fname: String) -> Bool {
  top_level_fn_exists(stmts = stmts, fname = fname) || str_array_contains(arr = dtd_facts_explicit_ops, val = fname)
}

/// Every trivial identity wrapper in `stmts`, with no own-region limit -- the
/// whole-program half of `dtpw_collect_wrappers`.
export fn collect_trivial_wrapper_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {
        let (pname, _) = Array::get(params, at = 0)
        let stripped = dlh_strip_tilde(pname)
        match body {
          ECall(callee, args, _, _) => match callee {
            EIdent(cn, _) => if cn == stripped && Array::length(args) == 0 {
              Array::push(out, value = name)
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Every top-level `T::op` the SOURCE defines, for the derived operations the
/// suppression checks ask about.
export fn collect_explicit_derived_op_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EFn(_, _, _, _, _, _)) => if String::contains(name, needle = "::") {
        Array::push(out, value = name)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  // #3551: a module that derives `Hash` over another module's type sees that
  // type's written `hash_key` only by this name, so what the definition takes
  // rides along -- the parameter of a callable one, which may be one
  // application (`Box[Int]`), and why an unusable one cannot be called
  // (`hash_key_signature.vibe`).
  let (written, unusable) = hash_key_definitions(stmts)
  for row in written {
    let (owner, vars, param) = row
    Array::push(out, value = hash_key_fact_pattern(owner = owner, vars = vars, param = param))
  }
  for row in unusable {
    let (owner, problem) = row
    Array::push(out, value = hash_key_fact_marker(owner = owner, problem = problem))
  }
  out
}

export fn top_level_fn_exists(stmts: Array[Stmt], fname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => if name == fname {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array
/// to-string helper `__arr_to_string__<key>` so distinct element types get
/// distinct helpers. `Int` -> "Int", `Array[Int]` -> "Array_Int",
/// `Option[Int]` -> "Option_Int", `(Int,Bool)` -> "Tup_Int_Bool", else "Any".
/// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into
/// `Array[t]` fields produces a structural — not pointer-heuristic — string.)
fn ts_type_key(_ ty: TypeExpr) -> String {
  match ty {
    TyName(n) => n,
    TyApp(n, args) => {
      let mut s = n
      let mut i = 0
      while i < Array::length(args) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(args, at = i))))
        i = i + 1
      }
      s
    },
    TyTuple(ts) => {
      let mut s = "Tup"
      let mut i = 0
      while i < Array::length(ts) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(ts, at = i))))
        i = i + 1
      }
      s
    },
    TyUnit => "Unit",
    _ => "Any"
  }
}

/// The generated monomorphic array-to-string helper name for element type `t`.
export fn arr_to_string_name(_ t: TypeExpr) -> String {
  String::concat("__arr_to_string__", ts_type_key(t))
}

/// Produce a String expression for a value `val` whose declared type is `fty`.
/// Fully type-directed and recursive (#694 Layer 2):
///   - `String` -> verbatim
///   - scalar `TyName` -> `__to_string(val)`
///   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`
///   - `Option[t]` -> `match val { Some(x) => "Some(" ++ show(x) ++ ")", None => "None" }`
///   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match
///   - tuple `(t0,..,tn)` -> `"(" ++ show(t0) ++ ", " ++ .. ++ ")"`
///   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`
///   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)
/// The structural `Type::to_string` (and the derived `Type::hash_key` that
/// delegates to it) is therefore stable for two distinct-but-equal aggregates,
/// no matter how deeply nested.
export fn show_for_typed(fty0: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {
  // #3564: a field spelled through a type alias (`v: Values` with `type
  // Values = Array[Int]`) is rendered as the type the alias names. Matched
  // as written, it fell to `__to_string`, which printed the array's address.
  let fty = eq_expand_alias_ty(fty0)
  show_note_unrenderable(fty)
  match fty {
    TyName("String") => val,
    // #3075: a `Char` / `Unit` field or payload shares the Int
    // representation, so `__to_string` printed `97` / `0`.
    TyName("Char") => char_render_expr(val),
    TyUnit => unit_render_expr(val),
    // #3082: a substituted formal reaches here as its argument (`v: Bool` in a
    // `Box[Bool]`), where codegen sees only the erased field; name the
    // renderer rather than leave it to the representation.
    TyName("Bool") => EIf(val, EString("true", -1), EString("false", -1)),
    TyName("Double") => ECall(builtin_ref("Double::to_string"), [val], -1, []),
    // #3542: the checker's other spellings of `Double` (`resolve_builtin`).
    // A `Float` field fell to `__to_string`, which printed the box address.
    TyName("Float") => ECall(builtin_ref("Float::to_string"), [val], -1, []),
    TyName("f64") => ECall(builtin_ref("Double::to_string"), [val], -1, []),
    // `f32` resolves to `Float` too (#3543): its field prints as an f32.
    TyName("f32") => ECall(builtin_ref("Float::to_string"), [val], -1, []),
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(arr = known_types, val = n) {
      ECall(EIdent(qualified_name(tname = n, method = "to_string"), -1), Array::slice([val], start = 0, end = 1), -1, [
      ])
    } else {
      ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let t = Array::get(args, at = 0)
      let inner = show_for_typed(fty0 = t, val = EIdent("__os_v", -1), known_types = known_types)
      let some_body = concat2(a = EString("Some(", -1), b = concat2(a = inner, b = EString(")", -1)))
      EMatch(val, Array::slice([
        (PCtor("Some", Array::slice([PBind("__os_v")], start = 0, end = 1)), some_body),
        // review-lint: allow-fixed-synthetic-name -- existing generated derived renderer payload binder preserved by the module split
        (PCtor("None", array_empty()), EString("None", -1))
      ], start = 0, end = 2))
    } else {
      ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let t = Array::get(args, at = 0)
      let e = Array::get(args, at = 1)
      let ok_inner = show_for_typed(fty0 = t, val = EIdent("__rs_v", -1), known_types = known_types)
      let err_inner = show_for_typed(fty0 = e, val = EIdent("__rs_v", -1), known_types = known_types)
      let ok_body = concat2(a = EString("Ok(", -1), b = concat2(a = ok_inner, b = EString(")", -1)))
      let err_body = concat2(a = EString("Err(", -1), b = concat2(a = err_inner, b = EString(")", -1)))
      EMatch(val, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__rs_v")], start = 0, end = 1)), ok_body),
        // review-lint: allow-fixed-synthetic-name -- existing generated derived renderer payload binder preserved by the module split
        (PCtor("Err", Array::slice([PBind("__rs_v")], start = 0, end = 1)), err_body)
        // review-lint: allow-fixed-synthetic-name -- existing generated derived renderer payload binder preserved by the module split
      ], start = 0, end = 2))
    } else {
      ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
    },
    TyTuple(ts) => {
      let n = Array::length(ts)
      let pats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(pats, value = PBind(String::concat("__ts_t", idx_str(i))))
        i = i + 1
      }
      let segs = empty_expr_array()
      Array::push(segs, value = EString("(", -1))
      let mut k = 0
      while k < n {
        if k > 0 {
          Array::push(segs, value = EString(", ", -1))
        } else {
          ()
        }
        Array::push(segs, value = show_for_typed(fty0 = Array::get(ts, at = k), val = EIdent(String::concat("__ts_t", idx_str(k)), -1), known_types = known_types))
        k = k + 1
      }
      Array::push(segs, value = EString(")", -1))
      let mut acc = Array::get(segs, at = Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(a = Array::get(segs, at = j), b = acc)
        j = j - 1
      }
      EMatch(val, Array::slice([(PTuple(pats), acc)], start = 0, end = 1))
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      if show_array_elem_is_bare_formal(Array::get(args, at = 0)) {
        show_array_inline(elem_ty = Array::get(args, at = 0), val = val, known_types = known_types)
      } else {
        // #3564: record the helper this call names wherever the array sits
        // (`Option[Array[Int]]`, a tuple, an alias); `desugar_derives` collects
        // only a field's own top-level `Array`, and a helper nothing generated
        // reached code generation unresolved.
        Array::push(dtd_show_inline_arr_elems, value = Array::get(args, at = 0))
        ECall(EIdent(arr_to_string_name(Array::get(args, at = 0)), -1), Array::slice([
          val
        ], start = 0, end = 1), -1, [])
      }
    } else {
      ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
    },
    TyApp(n, targs) => if show_generic_known(n) && show_ty_args_concrete(targs = targs, known_types = known_types) {
      // #3082: a derived renderer's field or payload of a `derive (Show)`
      // generic type at a concrete instantiation (`b: Box[Bool]`). Its own
      // `to_string` erases the formal (`Outer { b: Box { v: 1 } }`), so the
      // value is rendered here with the arguments substituted.
      show_generic_inline(n = n, targs = targs, val = val, known_types = known_types)
    } else if str_array_contains(arr = known_types, val = n) {
      ECall(EIdent(qualified_name(tname = n, method = "to_string"), -1), Array::slice([val], start = 0, end = 1), -1, [
      ])
    } else {
      ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
    },
    _ => ECall(builtin_ref("__to_string"), Array::slice([val], start = 0, end = 1), -1, [])
  }
}

/// Is `elem`, after peeling `Array` layers, a bare type parameter of the
/// declaration being derived (`T` of `xs: Array[T]` or `Array[Array[T]]`)?
fn show_array_elem_is_bare_formal(_ elem: TypeExpr) -> Bool {
  match elem {
    TyApp("Array", inner) => if Array::length(inner) == 1 {
      show_array_elem_is_bare_formal(Array::get(inner, at = 0))
    } else {
      false
    },
    TyName(n) => Array::length(arr_helper_tparams(TyName(n))) > 0,
    _ => false
  }
}

/// #3547: `Array[T]` of a declaration's own formal, rendered in place:
/// `"[" ++ show(a[0]) ++ ", " ++ .. ++ "]"`. A `__arr_to_string__` helper
/// would have to be generic over `T` and render an erased formal, which the
/// checker refuses, so a `derive (Show)` type with such a field failed to
/// build even when it was never rendered. In place, the elements render the
/// way a bare `v: T` field does; a site that knows the instantiation renders
/// the substituted `Array[Int]` / `Array[Bool]` through its own helper
/// (`show_generic_inline`).
fn show_array_inline(elem_ty: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {
  let arr = show_tmp_name()
  let idx = show_tmp_name()
  let acc = show_tmp_name()
  let elem = ECall(builtin_ref("Array::get"), [
    EIdent(arr, -1),
    EIdent(idx, -1)
  ], -1, [])
  let elem_show = show_for_typed(fty0 = elem_ty, val = elem, known_types = known_types)
  let sep = EIf(EBinOp("==", EIdent(idx, -1), EInt(0), -1), EString("", -1), EString(", ", -1))
  let set_acc = EAssign(acc, concat2(a = concat2(a = EIdent(acc, -1), b = sep), b = elem_show), EUnit, -1)
  let incr = EAssign(idx, EBinOp("+", EIdent(idx, -1), EInt(1), -1), EUnit, -1)
  let length = ECall(builtin_ref("Array::length"), [EIdent(arr, -1)], -1, [])
  let walk = EWhile(EBinOp("<", EIdent(idx, -1), length, -1), ESeq(set_acc, incr))
  let closed = concat2(a = EIdent(acc, -1), b = EString("]", -1))
  ELet(arr, val, ELetMut(idx, EInt(0), ELetMut(acc, EString("[", -1), ESeq(walk, closed), -1), -1), -1)
}

/// #3092: a derived renderer's field or payload that is, or carries through
/// type arguments, a function or `Bytes` has no text form; the renderer fell
/// back to `__to_string` and printed a table index or an address
/// (`C { f: 1 }`). Refused where the pass can throw, naming the edit.
fn show_note_unrenderable(_ fty: TypeExpr) -> Unit {
  let what = show_unrenderable_kind(fty)
  if String::length(what) > 0 {
    let msg = String::concat("a derived renderer contains ", String::concat(what, ", which has no text form and would print a memory address -- write the type's `to_string` yourself, or keep that field out of a `derive (Show)` type (#3092)"))
    if !str_array_contains(arr = dtd_show_refusals, val = msg) {
      Array::push(dtd_show_refusals, value = msg)
    } else {
      ()
    }
  } else {
    ()
  }
}

fn show_unrenderable_kind(_ t: TypeExpr) -> String {
  show_unrenderable_kind_seen(t0 = t, seen = [])
}

/// Inspect the values structural rendering reads. A phantom argument
/// contributes no stored field or payload.
/// Recursive generic rendering has its own expansion guard below.
fn show_unrenderable_kind_seen(t0: TypeExpr, seen: Array[String]) -> String {
  match eq_expand_alias_ty(t0) {
    TyFn(_, _, _) => "a function value",
    TyName("Bytes") => "a `Bytes` value",
    TyApp(head, args) => if head == "Array" || head == "Option" || head == "Result" {
      show_unrenderable_kind_of(ts = args, seen = seen)
    } else if str_array_contains(arr = seen, val = head) {
      ""
    } else if !show_generic_known(head) || str_array_contains(arr = dtd_show_generic_source_renderers, val = head) {
      show_unrenderable_kind_of(ts = args, seen = seen)
    } else {
      let next = for name in seen {
        name
      }
      Array::push(next, value = head)
      let parts: Array[TypeExpr] = []
      match show_generic_struct_decl(head) {
        Some((_, params, fields)) => {
          for field in fields {
            Array::push(parts, value = eq_subst_ty(ty = field.1, params = params, args = args))
          }
          ()
        },
        None => match show_generic_enum_decl(head) {
          Some((_, params, variants)) => {
            for variant in variants {
              for payload in variant.1 {
                Array::push(parts, value = eq_subst_ty(ty = payload, params = params, args = args))
              }
            }
            ()
          },
          None => ()
        }
      }
      show_unrenderable_kind_of(ts = parts, seen = next)
    },
    TyTuple(ts) => show_unrenderable_kind_of(ts = ts, seen = seen),
    _ => ""
  }
}

fn show_unrenderable_kind_of(ts: Array[TypeExpr], seen: Array[String]) -> String {
  let mut found = ""
  let mut i = 0
  while i < Array::length(ts) && String::length(found) == 0 {
    found = show_unrenderable_kind_seen(t0 = Array::get(ts, at = i), seen = seen)
    i = i + 1
  }
  found
}

/// #3082: every type argument names no type parameter, so substituting it
/// yields a fully concrete type.
fn show_ty_args_concrete(targs: Array[TypeExpr], known_types: Array[String]) -> Bool {
  let mut ok = Array::length(targs) > 0
  let mut i = 0
  while i < Array::length(targs) && ok {
    ok = show_ty_concrete(t = Array::get(targs, at = i), known_types = known_types)
    i = i + 1
  }
  ok
}

fn show_ty_concrete(t: TypeExpr, known_types: Array[String]) -> Bool {
  match t {
    TyName(n) => is_scalar_type_name(n) || (str_array_contains(arr = known_types, val = n) && !str_array_contains(arr = dtd_type_param_names, val = n)),
    TyUnit => true,
    TyTuple(ts) => show_ty_args_concrete(targs = ts, known_types = known_types),
    TyApp(n, args) => (n == "Array" || n == "Option" || n == "Result" || n == "Map" || (str_array_contains(arr = known_types, val = n) && !str_array_contains(arr = dtd_type_param_names, val = n))) && show_ty_args_concrete(targs = args, known_types = known_types),
    _ => false
  }
}

/// #3082: render `val`, a `derive (Show)` generic struct or enum at the
/// concrete instantiation `n[targs]`, in its derived renderer's text with the
/// arguments substituted into each field / payload type.
fn show_generic_inline(n: String, targs: Array[TypeExpr], val: Expr, known_types: Array[String]) -> Expr {
  let key = ts_type_key(TyApp(n, targs))
  let mut same_head = 0
  let mut si = 0
  while si < Array::length(dtd_show_inline_stack) {
    if String::starts_with(Array::get(dtd_show_inline_stack, at = si), prefix = String::concat(n, "_")) {
      same_head = same_head + 1
    } else {
      ()
    }
    si = si + 1
  }
  if str_array_contains(arr = dtd_show_inline_stack, val = key) || same_head >= 8 {
    // Recursive. The erased renderer is exact only at `Int` / `String`.
    let mut safe = true
    let mut ai = 0
    while ai < Array::length(targs) {
      match Array::get(targs, at = ai) {
        TyName(a) => if a != "Int" && a != "String" {
          safe = false
        } else {
          ()
        },
        _ => {
          safe = false
        }
      }
      ai = ai + 1
    }
    if !safe {
      let msg = String::concat("a derived renderer contains a recursive `", String::concat(namespace_rename_original(n), "` whose type arguments are not `Int` or `String`: its own renderer erases the type parameter, so a nested value would print through it -- write the containing type's `to_string` yourself (#3082)"))
      if !str_array_contains(arr = dtd_show_refusals, val = msg) {
        Array::push(dtd_show_refusals, value = msg)
      } else {
        ()
      }
    } else {
      ()
    }
    ECall(EIdent(qualified_name(tname = n, method = "to_string"), -1), [val], -1, [])
  } else {
    Array::push(dtd_show_inline_stack, value = key)
    let tmp = show_tmp_name()
    let tv = EIdent(tmp, -1)
    let body = match show_generic_struct_decl(n) {
      Some((_, formals, fields)) => {
        let mut acc = EString(String::concat(namespace_rename_original(n), " { "), -1)
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fty) = Array::get(fields, at = fi)
          let sty = eq_subst_ty(ty = fty, params = formals, args = targs)
          show_inline_note_arrays(sty)
          let label = if fi == 0 {
            String::concat(fname, ": ")
          } else {
            String::concat(", ", String::concat(fname, ": "))
          }
          acc = concat2(a = acc, b = concat2(a = EString(label, -1), b = show_for_typed(fty0 = sty, val = EDot(tv, fname, -1, -1), known_types = known_types)))
          fi = fi + 1
        }
        concat2(a = acc, b = EString(" }", -1))
      },
      None => match show_generic_enum_decl(n) {
        Some((_, formals, variants)) => {
          let arms = array_empty()
          let mut vi = 0
          while vi < Array::length(variants) {
            let (vname, ptys) = Array::get(variants, at = vi)
            let pats = array_empty()
            let mut vbody = EString(namespace_rename_original(vname), -1)
            if Array::length(ptys) > 0 {
              vbody = EString(String::concat(namespace_rename_original(vname), "("), -1)
              let mut pi = 0
              while pi < Array::length(ptys) {
                let pv = show_tmp_name()
                Array::push(pats, value = PBind(pv))
                let sty = eq_subst_ty(ty = Array::get(ptys, at = pi), params = formals, args = targs)
                show_inline_note_arrays(sty)
                let piece = show_for_typed(fty0 = sty, val = EIdent(pv, -1), known_types = known_types)
                vbody = if pi == 0 {
                  concat2(a = vbody, b = piece)
                } else {
                  concat2(a = concat2(a = vbody, b = EString(", ", -1)), b = piece)
                }
                pi = pi + 1
              }
              vbody = concat2(a = vbody, b = EString(")", -1))
            } else {
              ()
            }
            Array::push(arms, value = (PCtor(vname, pats), vbody))
            vi = vi + 1
          }
          EMatch(tv, arms)
        },
        None => ECall(EIdent(qualified_name(tname = n, method = "to_string"), -1), [tv], -1, [])
      }
    }
    Array::truncate(dtd_show_inline_stack, length = Array::length(dtd_show_inline_stack) - 1)
    ELet(tmp, val, body, -1)
  }
}

/// Move the recorded element types into `desugar_derives`' helper list, with
/// its dedup and nesting closure.
export fn show_inline_merge_arr_elems(arr_elems: Array[TypeExpr], arr_keys: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(dtd_show_inline_arr_elems) {
    collect_show_array_elems(ty = TyApp("Array", [
      Array::get(dtd_show_inline_arr_elems, at = i)
    ]), acc = arr_elems, keys = arr_keys)
    i = i + 1
  }
  Array::truncate(dtd_show_inline_arr_elems, length = 0)
}

/// Record the `Array[e]` element types a substituted type mentions.
/// Walks the whole type: `show_for_typed` reaches an `Array` inside an
/// `Option` / `Result` / tuple too, and each needs its helper.
fn show_inline_note_arrays(_ t0: TypeExpr) -> Unit {
  match eq_expand_alias_ty(t0) {
    TyApp(n, args) => {
      if n == "Array" && Array::length(args) == 1 {
        Array::push(dtd_show_inline_arr_elems, value = Array::get(args, at = 0))
      } else {
        ()
      }
      if n == "Array" || n == "Option" || n == "Result" {
        let mut i = 0
        while i < Array::length(args) {
          show_inline_note_arrays(Array::get(args, at = i))
          i = i + 1
        }
      } else {
        ()
      }
    },
    TyTuple(ts) => {
      let mut i = 0
      while i < Array::length(ts) {
        show_inline_note_arrays(Array::get(ts, at = i))
        i = i + 1
      }
    },
    _ => ()
  }
}

/// #3082: a recursive generic value inside a derived renderer cannot be
/// rendered by content; the refusal is a build error naming the edit.
export fn show_refusals_report() -> Unit with Exception {
  if Array::length(dtd_show_refusals) == 0 {
    ()
  } else {
    throw(Array::get(dtd_show_refusals, at = 0))
  }
}

/// Show a single struct field value as a String expression, by its declared type
/// (#694: type-directed and recursive — aggregate fields recurse structurally
/// instead of falling into the `__to_string` pointer heuristic).
export fn field_show_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty0 = fty, val = EDot(EIdent("self", -1), fname, -1, -1), known_types = known_types)
}

/// `let P::compare = (a: P, b: P) -> Ordering { lexicographic over fields }`
/// (#3042, ADR-0118). The first field that is not `Equal` decides; a struct
/// with no fields, or with every field `Equal`, answers `Equal`.
export fn gen_compare_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let mut body = ordering_ctor("Equal")
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, fty) = Array::get(fields, at = i)
    let af = EDot(EIdent("a", -1), fname, -1, -1)
    let bf = EDot(EIdent("b", -1), fname, -1, -1)
    body = compare_then_typed(fty0 = fty, lhs = af, rhs = bf, rest = body, known_types = known_types)
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], start = 0, end = 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname = tname, method = "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Ordering")), None, body))
}

/// #3042: a reference to one of the prelude `Ordering`'s constructors.
fn ordering_ctor(_ name: String) -> Expr {
  EIdent(name, -1)
}

/// Show an arbitrary value expression by its declared type (#694: type-directed
/// and recursive via `show_for_typed`, so aggregate enum payloads — nested
/// struct/enum, Option, Result, tuple, Array — render structurally instead of
/// through the `__to_string` pointer heuristic).
fn show_expr_typed(val: Expr, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty0 = fty, val = val, known_types = known_types)
}

/// `let E::to_string = (self: E) -> String {
///    match self { V0(_a0, _a1) => "V0(" ++ show(_a0) ++ ", " ++ show(_a1) ++ ")",
///                 V1 => "V1", ... } }`
/// A nullary variant shows as its bare name; a payload variant shows as
/// `Name(p0, p1, ...)` with each payload shown structurally.
export fn gen_enum_show_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let arms = array_empty()
  let mut vi = 0
  while vi < Array::length(variants) {
    let (vname, ftypes) = Array::get(variants, at = vi)
    let nf = Array::length(ftypes)
    let binds = array_empty()
    let mut fi = 0
    while fi < nf {
      Array::push(binds, value = PBind(String::concat("__s", idx_str(fi))))
      fi = fi + 1
    }
    let body = if nf == 0 {
      // #2205: render the source constructor name, not the merge-renamed one
      // (same as gen_show_fn above; the PCtor pattern below keeps `vname`).
      EString(namespace_rename_original(vname), -1)
    } else {
      let segs = empty_expr_array()
      Array::push(segs, value = EString(String::concat(namespace_rename_original(vname), "("), -1))
      let mut si = 0
      while si < nf {
        let sep = if si == 0 {
          ""
        } else ", "
        if sep != "" {
          Array::push(segs, value = EString(sep, -1))
        } else {
          ()
        }
        Array::push(segs, value = show_expr_typed(val = EIdent(String::concat("__s", idx_str(si)), -1), fty = Array::get(ftypes, at = si), known_types = known_types))
        si = si + 1
      }
      Array::push(segs, value = EString(")", -1))
      let mut acc = Array::get(segs, at = Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(a = Array::get(segs, at = j), b = acc)
        j = j - 1
      }
      acc
    }
    Array::push(arms, value = (PCtor(vname, binds), body))
    vi = vi + 1
  }
  let params = Array::slice([("self", Some(TyName(ename)))], start = 0, end = 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname = ename, method = "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, EMatch(EIdent("self", -1), arms)))
}

/// Append any `Array[e]` element types referenced by a TypeExpr to `acc`
/// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or
/// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)
export fn collect_show_array_elems(ty: TypeExpr, acc: Array[TypeExpr], keys: Array[String]) -> Unit {
  // #3564: an alias of an array needs the helper its expansion names.
  match eq_expand_alias_ty(ty) {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let et = Array::get(args, at = 0)
      let k = ts_type_key(et)
      if str_array_contains(arr = keys, val = k) {
        ()
      } else {
        Array::push(keys, value = k)
        Array::push(acc, value = et)
      }
    } else {
      ()
    },
    _ => ()
  }
}

/// A field or payload binder in a generated `compare` is a bare name whose
/// type does not reach the `<` lowering, so a raw `<` on a boxed `Double` or a
/// `String` compared the two references: equal values answered `Less` and the
/// order of unequal ones followed allocation order. Mark the operand the way
/// typed equality does (`Float::to_double`, the identity at code generation,
/// makes it floatish -- not `Double::to_float`, which rounds to f32), and give a
/// `String` an operand the lowering classifies as a string. The checker
/// refuses `derive (Ord)` over every other non-nominal field type
/// (`collect_derive_field_errors`), so no other shape reaches the operator.
/// Every spelling the checker resolves to `Double` (`resolve_builtin`) is
/// boxed the same way, so `f64` and `f32` are marked as well.
fn ord_operand(fty: TypeExpr, e: Expr) -> Expr {
  if ord_is_double(fty) {
    ECall(builtin_ref("Float::to_double"), [e], -1, [])
  } else {
    match fty {
      TyName("String") => ECall(builtin_ref("String::concat"), [
        e,
        EString("", -1)
      ], -1, []),
      _ => e
    }
  }
}

/// Every spelling the checker resolves to `Double` (`resolve_builtin`).
fn ord_is_double(_ fty: TypeExpr) -> Bool {
  match fty {
    TyName(n) => n == "Double" || n == "Float" || n == "f64" || n == "f32",
    _ => false
  }
}

/// What a `Double` field answers when neither `<` nor `>` holds. For two
/// numbers that is equality, so `rest` decides. A NaN is neither less nor
/// greater than anything, so without this arm `compare` answered `Equal` for
/// NaN against any number and let a later field decide. The derived order is
/// total instead: NaN sorts after every number and is `Equal` to another NaN
/// (the order of Java's `Double.compare`, without its `-0.0 < 0.0`, so the
/// two zeros stay `Equal` as they are under `==`). `x == x` is false exactly
/// for NaN; the operands are the marked ones, so it is the float comparison.
fn ord_nan_last(l: Expr, r: Expr, rest: Expr) -> Expr {
  let l_num = EBinOp("==", l, l, -1)
  let r_num = EBinOp("==", r, r, -1)
  EIf(EBinOp("==", l, r, -1), rest, EIf(l_num, ordering_ctor("Less"), EIf(r_num, ordering_ctor("Greater"), rest)))
}

/// Compare two operands of declared type `fty` and answer `rest` when they are
/// `Equal`, otherwise their `Ordering` (#3042). Aggregate (declared
/// struct/enum) operands recurse through `T::compare`, applied (`Box[Int]`)
/// or not; scalars use the runtime structural `<` / `>` (codegen handles
/// them). A type alias is expanded first: its name reaches neither
/// `known_types` nor `ord_operand`, so `type Score = Double` compared the two
/// boxes by address.
fn compare_then_typed(fty0: TypeExpr, lhs: Expr, rhs: Expr, rest: Expr, known_types: Array[String]) -> Expr {
  let fty = eq_expand_alias_ty(fty0)
  let l = ord_operand(fty = fty, e = lhs)
  let r = ord_operand(fty = fty, e = rhs)
  let undecided = if ord_is_double(fty) {
    ord_nan_last(l = l, r = r, rest = rest)
  } else rest
  let by_operator = EIf(EBinOp("<", l, r, -1), ordering_ctor("Less"), EIf(EBinOp(">", l, r, -1), ordering_ctor("Greater"), undecided))
  match fty {
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(arr = known_types, val = n) {
      compare_through_nominal(n = n, lhs = lhs, rhs = rhs, rest = rest)
    } else by_operator,
    TyApp(n, _) => if str_array_contains(arr = known_types, val = n) {
      compare_through_nominal(n = n, lhs = lhs, rhs = rhs, rest = rest)
    } else by_operator,
    _ => by_operator
  }
}

/// `match T::compare(lhs, rhs) { Equal => rest, decided => decided }`: a
/// declared struct or enum field is ordered by its own `compare`, never by
/// the `<` lowering, which would compare the two references.
fn compare_through_nominal(n: String, lhs: Expr, rhs: Expr, rest: Expr) -> Expr {
  let arms = array_empty()
  let equal_binds = array_empty()
  Array::push(arms, value = (PCtor("Equal", equal_binds), rest))
  // Fresh per comparison: a nested field's arm must not capture an
  // enclosing field's binder.
  let decided = String::concat("__ord", idx_str(eq_tuple_uid_next()))
  Array::push(arms, value = (PBind(decided), EIdent(decided, -1)))
  EMatch(ECall(EIdent(qualified_name(tname = n, method = "compare"), -1), Array::slice([lhs, rhs], start = 0, end = 2), -1, [
  ]), arms)
}

/// `let E::compare = (a: E, b: E) -> Ordering { ... }` (#3042, ADR-0118)
/// Lexicographic: first by variant order (a's tag index vs b's tag index), then
/// (same variant) by payload, recursively. The variant index of `a` is computed
/// by matching `a`; for each `a` variant the inner match on `b` either compares
/// payloads (same variant) or answers `Less` / `Greater` from the two indices.
export fn gen_enum_compare_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let outer_arms = array_empty()
  let mut ai = 0
  while ai < Array::length(variants) {
    let (avname, aftypes) = Array::get(variants, at = ai)
    let anf = Array::length(aftypes)
    let abinds = array_empty()
    let mut afi = 0
    while afi < anf {
      Array::push(abinds, value = PBind(String::concat("__a", idx_str(afi))))
      afi = afi + 1
    }
    // inner match over b: for the same variant compare payloads; otherwise the
    // sign comes from the variant order (a before b -> -1, after -> 1).
    let inner_arms = array_empty()
    let mut bi = 0
    while bi < Array::length(variants) {
      let (bvname, bftypes) = Array::get(variants, at = bi)
      let bnf = Array::length(bftypes)
      let bbinds = array_empty()
      let mut bfi = 0
      while bfi < bnf {
        Array::push(bbinds, value = PBind(String::concat("__b", idx_str(bfi))))
        bfi = bfi + 1
      }
      let arm_body = if ai == bi {
        // same variant: lexicographic over payloads, `Equal` if no payload.
        let mut body = ordering_ctor("Equal")
        let mut pi = anf - 1
        while pi >= 0 {
          body = compare_then_typed(fty0 = Array::get(aftypes, at = pi), lhs = EIdent(String::concat("__a", idx_str(pi)), -1), rhs = EIdent(String::concat("__b", idx_str(pi)), -1), rest = body, known_types = known_types)
          pi = pi - 1
        }
        body
      } else if ai < bi {
        ordering_ctor("Less")
      } else {
        ordering_ctor("Greater")
      }
      Array::push(inner_arms, value = (PCtor(bvname, bbinds), arm_body))
      bi = bi + 1
    }
    Array::push(outer_arms, value = (PCtor(avname, abinds), EMatch(EIdent("b", -1), inner_arms)))
    ai = ai + 1
  }
  let params = Array::slice([
    ("a", Some(TyName(ename))),
    ("b", Some(TyName(ename)))
  ], start = 0, end = 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname = ename, method = "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Ordering")), None, EMatch(EIdent("a", -1), outer_arms)))
}

/// The default value expression for a declared field type. Per-type rules:
///   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> "", Unit -> (),
///   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum
///   (in `known_types`) -> `T::default()`. A type with no sensible default (a
///   bare type parameter, a function/tuple type, an unknown name) falls back to
///   `()` — codegen will then flag the literal against the field's real type, so
///   the limitation surfaces as a type error rather than silently wrong data.
fn default_for_type(fty: TypeExpr, known_types: Array[String]) -> Expr {
  match fty {
    TyName("Int") => EInt(0),
    TyName("Double") => EFloat(0.0),
    TyName("Float") => EFloat(0.0),
    TyName("Bool") => EBool(false),
    TyName("String") => EString("", -1),
    TyName("Unit") => EUnit,
    TyName(n) => if str_array_contains(arr = known_types, val = n) {
      ECall(EIdent(qualified_name(tname = n, method = "default"), -1), empty_expr_array(), -1, [])
    } else {
      EUnit
    },
    TyApp("Option", _) => EIdent("None", -1),
    TyApp("Array", _) => EArray(empty_expr_array()),
    TyApp(n, _) => if str_array_contains(arr = known_types, val = n) {
      ECall(EIdent(qualified_name(tname = n, method = "default"), -1), empty_expr_array(), -1, [])
    } else {
      EUnit
    },
    TyUnit => EUnit,
    _ => EUnit
  }
}

/// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal
/// (ERecord; the struct type is recovered from the field set) with each field at
/// its type's default.
export fn gen_default_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let rec_fields = array_empty()
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, at = i)
    Array::push(rec_fields, value = (fname, default_for_type(fty = fty, known_types = known_types)))
    i = i + 1
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname = tname, method = "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord("", rec_fields, empty_ty_args())))
}

/// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with
/// each payload slot at its type's default (nullary -> bare constructor name).
export fn gen_enum_default_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let (vname, ftypes) = Array::get(variants, at = 0)
  let body = if Array::length(ftypes) == 0 {
    EIdent(vname, -1)
  } else {
    let args = empty_expr_array()
    let mut i = 0
    while i < Array::length(ftypes) {
      Array::push(args, value = default_for_type(fty = Array::get(ftypes, at = i), known_types = known_types))
      i = i + 1
    }
    ECall(EIdent(vname, -1), args, -1, [])
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname = ename, method = "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))
}

/// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the
/// element type `e` to `acc` (deduped by `type_key`). Only the immediate element
/// types are added here; transitive nesting (`Array[Array[Int]]` needs the
/// `Array[Int]` helper too) is closed by the worklist loop in the caller, which
/// re-scans every element type it collects. (#695.)
export fn collect_array_elem_types(ty: TypeExpr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  match ty {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let e = Array::get(args, at = 0)
      let k = type_key(e)
      if !str_array_contains(arr = acc_keys, val = k) {
        Array::push(acc, value = e)
        Array::push(acc_keys, value = k)
      } else {
        ()
      }
      collect_array_elem_types(ty = e, acc = acc, acc_keys = acc_keys)
    } else {
      ()
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_array_elem_types(ty = Array::get(args, at = i), acc = acc, acc_keys = acc_keys)
        i = i + 1
      }
    },
    TyTuple(ts) => {
      let mut i = 0
      while i < Array::length(ts) {
        collect_array_elem_types(ty = Array::get(ts, at = i), acc = acc, acc_keys = acc_keys)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// In-place: for each struct with `derive(Show/Ord)`, append the structural
/// function if not already present (idempotent across the double-run pipeline).
/// The set of concrete struct/enum names declared in the program — the gate for
/// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose
/// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to
/// scalar `==`, since there is no `T::equals` to call).
export fn collect_decl_type_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, _) => Array::push(out, value = name),
      SEnum(_, ename, _, _, _) => Array::push(out, value = ename),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #3567: the types whose `derive (Hash)` renderer is withheld.
///
/// A `derive (Hash)` type with neither `Show` nor a written `to_string` also
/// gets a derived renderer, so that interpolating it works. That renderer
/// renders a field of a declared type through the field type's `to_string`
/// (`show_for_typed`). When the field's type has none, the call named no
/// function. The key never calls the renderer (#3544), so the key compiled.
/// But a lane that kept the unused renderer (`vibe test`) stopped with an
/// internal compiler error (`Inner::to_string` reached code generation
/// unresolved), and interpolating the value did so on every lane.
///
/// Such a type keeps its key and gets no renderer, like a type that derives
/// nothing. Interpolating it is refused with the edit (`derive (Show)`). The
/// checker withholds the same `T::to_string` (`dfe_hash_renderless`), so an
/// explicit call or a `derive (Show)` type holding one is refused at check
/// time.
///
/// The result is a least fixpoint: a field whose type is another withheld
/// type has no renderer either.
export fn hash_renderless_types(_ stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = array_empty()
  let candidates: Array[(String, Array[String], Array[TypeExpr])] = array_empty()
  for st in stmts {
    match st {
      SStruct(_, name, fields, derives, _, tparams) => if hr_renderer_is_hash_only(stmts = stmts, name = name, derives = derives) {
        Array::push(candidates, value = (name, tparams, for field in fields {
          field.1
        }))
      } else {
        ()
      },
      SEnum(_, name, tparams, variants, derives) => if hr_renderer_is_hash_only(stmts = stmts, name = name, derives = derives) {
        let parts: Array[TypeExpr] = array_empty()
        for variant in variants {
          for payload in variant.1 {
            Array::push(parts, value = payload)
          }
        }
        Array::push(candidates, value = (name, tparams, parts))
      } else {
        ()
      },
      _ => ()
    }
  }
  let mut changed = Array::length(candidates) > 0
  while changed {
    changed = false
    for candidate in candidates {
      let (name, tparams, parts) = candidate
      if !str_array_contains(arr = out, val = name) && hr_any_missing(stmts = stmts, owner = name, tparams = tparams, ts = parts, renderless = out, seen = array_empty(), depth = 0) {
        Array::push(out, value = name)
        changed = true
      } else {
        ()
      }
    }
  }
  out
}

/// Is `name`'s renderer generated only because it derives `Hash`?
fn hr_renderer_is_hash_only(stmts: Array[Stmt], name: String, derives: Array[String]) -> Bool {
  str_array_contains(arr = derives, val = "Hash") && !str_array_contains(arr = derives, val = "Show") && !dtd_source_op_defined(stmts = stmts, fname = qualified_name(tname = name, method = "to_string"))
}

fn hr_any_missing(stmts: Array[Stmt], owner: String, tparams: Array[String], ts: Array[TypeExpr], renderless: Array[String], seen: Array[String], depth: Int) -> Bool {
  let mut found = false
  for t in ts {
    if !found && hr_missing_renderer(stmts = stmts, owner = owner, tparams = tparams, t0 = t, renderless = renderless, seen = seen, depth = depth) {
      found = true
    } else {
      ()
    }
  }
  found
}

/// Does the derived renderer of `owner` reach, for a field of type `t0`, a
/// declared type that has no renderer? Walks what `show_for_typed` renders:
/// `Option` / `Array` / `Result` arguments and tuples open; a declared type is
/// rendered through its own renderer, and a generic one that derives its
/// renderer is rendered inline at its instantiation.
fn hr_missing_renderer(stmts: Array[Stmt], owner: String, tparams: Array[String], t0: TypeExpr, renderless: Array[String], seen: Array[String], depth: Int) -> Bool {
  let t = eq_expand_alias_ty(t0)
  match t {
    TyName(n) => if n == owner || str_array_contains(arr = tparams, val = n) || is_scalar_type_name(n) {
      false
    } else {
      hr_head_missing(stmts = stmts, owner = owner, tparams = tparams, n = n, args = array_empty(), renderless = renderless, seen = seen, depth = depth)
    },
    TyApp(n, args) => if ((n == "Option" || n == "Array") && Array::length(args) == 1) || (n == "Result" && Array::length(args) == 2) {
      hr_any_missing(stmts = stmts, owner = owner, tparams = tparams, ts = args, renderless = renderless, seen = seen, depth = depth)
    } else if n == owner {
      false
    } else {
      hr_head_missing(stmts = stmts, owner = owner, tparams = tparams, n = n, args = args, renderless = renderless, seen = seen, depth = depth)
    },
    TyTuple(ts) => hr_any_missing(stmts = stmts, owner = owner, tparams = tparams, ts = ts, renderless = renderless, seen = seen, depth = depth),
    _ => false
  }
}

fn hr_head_missing(stmts: Array[Stmt], owner: String, tparams: Array[String], n: String, args: Array[TypeExpr], renderless: Array[String], seen: Array[String], depth: Int) -> Bool {
  let key = type_key(TyApp(n, args))
  if depth >= 16 || str_array_contains(arr = seen, val = key) || dtd_source_op_defined(stmts = stmts, fname = qualified_name(tname = n, method = "to_string")) {
    false
  } else {
    Array::push(seen, value = key)
    match hr_find_decl(stmts = stmts, n = n) {
      // Not a declaration here: the renderer does not call `n::to_string`.
      None => false,
      Some((derives, formals, parts)) => if str_array_contains(arr = derives, val = "Show") || (str_array_contains(arr = derives, val = "Hash") && !str_array_contains(arr = renderless, val = n)) {
        if Array::length(formals) > 0 && Array::length(formals) == Array::length(args) {
          hr_any_missing(stmts = stmts, owner = owner, tparams = tparams, ts = for p in parts {
            eq_subst_ty(ty = p, params = formals, args = args)
          }, renderless = renderless, seen = seen, depth = depth + 1)
        } else {
          false
        }
      } else {
        true
      }
    }
  }
}

/// The derives, type parameters and field / payload types of the struct or
/// enum `n` declared in `stmts`.
fn hr_find_decl(stmts: Array[Stmt], n: String) -> Option[(Array[String], Array[String], Array[TypeExpr])] {
  let mut found: Option[(Array[String], Array[String], Array[TypeExpr])] = None
  for st in stmts {
    if found is None {
      match st {
        SStruct(_, name, fields, derives, _, tparams) => if name == n {
          found = Some((derives, tparams, for field in fields {
            field.1
          }))
        } else {
          ()
        },
        SEnum(_, name, tparams, variants, derives) => if name == n {
          let parts: Array[TypeExpr] = array_empty()
          for variant in variants {
            for payload in variant.1 {
              Array::push(parts, value = payload)
            }
          }
          found = Some((derives, tparams, parts))
        } else {
          ()
        },
        _ => ()
      }
    } else {
      ()
    }
  }
  found
}

export fn empty_stmt_list() -> Array[Stmt] {
  array_empty()
}

export fn struct_decl_exists(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, sname, _, _, _, _) => if sname == name {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}
