// Deferred equality requests.

import @vibe/compiler/core {
  TypeExpr
}

import ./equality_requests.vibe {
  type_key
}

import ./state.vibe {
  dtd_eq_deferred_requests, dtd_eq_deferred_types
}

import ./utilities.vibe {
  str_array_contains
}

/// The deferral key for a type: the same spelling `eq_synthesis_requests_list`
/// uses, so the two sets are directly comparable. A shape with no key spells
/// "" and is not recorded -- there would be nothing for a link to mint.
export fn eq_deferred_key_for_ty(t: TypeExpr) -> String {
  match t {
    TyApp("Array", args) => if Array::length(args) == 1 {
      type_key(Array::get(args, 0))
    } else {
      ""
    },
    TyApp(_, _) => String::concat("spec:", type_key(t)),
    _ => ""
  }
}

export fn eq_deferred_request_record_ty(key: String, t: TypeExpr) -> Unit {
  if String::length(key) == 0 || str_array_contains(dtd_eq_deferred_requests, key) {
    ()
  } else {
    Array::push(dtd_eq_deferred_requests, key)
    Array::push(dtd_eq_deferred_types, t)
  }
}
