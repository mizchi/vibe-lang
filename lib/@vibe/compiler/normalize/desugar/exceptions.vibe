// Exceptions.

import @vibe/compiler/core {
  Expr, Pat, Stmt, __to_string, is_exception_effect_name, is_exception_throw_operation
}

import @vibe/ast {
  builtin_ref
}

import @vibe/core {
  array_empty
}

import ./inspect_rewrite.vibe {
  dinsp_fresh_name
}

import ./state.vibe {
  dtd_exn_kind_state
}

import ./utilities.vibe {
  empty_str_array
}

// #1324 removed the #760(2) `inject_prelude_result` pass (and its
// `*_mentions_result` walkers). `Result` was never a built-in type
// constructor -- it was the ordinary user enum `enum Result[T, E] { Ok(T);
// Err(E) }`, appended here to any program that mentioned `Ok`/`Err`/
// `Result[..]` and did not declare or import its own. With the prelude
// definition gone (slice 4) and `Exception[E]` rows carrying failure
// instead, a program that wants that enum now declares it like any other.

//# #1374: the runtime exception-kind side channel
//
// ADR-0085 lowers EVERY exception spelling to one abortive Wasm tag with no
// kind discriminator, and the erased `Error` spelling is deliberately
// compatible with every kind (that is what kept #1344 additive over #786's
// suberror throws). So `handle { .. } with Exception { Throw(m) => .. }` also
// catches a typed `Exception[E]` throw, and `m`'s static type there is
// `CtUnknown` -- using it as a String type-checks, then misreads an enum
// pointer as a packed `(ptr<<32)|len` string. Measured on #1372: a whole data
// segment written to stderr, and a `String::length` of 2129 on a `Closed`
// payload. PR #1375 stopped the arbitrary-memory read by routing both sinks
// through `__to_string`; it could not tell the two cases apart, so a non-String
// payload printed as a bare decimal.
//
// The channel: a one-slot module-level cell, written immediately before every
// `perform <Exception>::Throw(v)` with the payload's statically resolved type
// name, read back by `__exn_kind()`. The payload's representation is untouched,
// so every existing handler keeps working unchanged -- purely additive.
//
// Why a module-level `let` array rather than a new wasm global or a new pair of
// builtins: the cell is ordinary vibe AST, so it rides the already-verified
// module-let path (initialized once, one shared identity, mutations visible
// across accesses -- fixtures/module_let_memo_test.vibe pins exactly these
// three properties) and needs no new emission in EITHER backend, so the linear
// and wasm-gc lanes cannot desynchronize on it.
//
// Why ONE slot is enough. The window between the write and the handler's read
// is a single abortive unwind, and nothing else runs inside it:
//   - `Error` is non-resumable (#640), so the unwind never returns to the throw
//     site and no code after the write executes before the handler.
//   - the ADR-0076 task pump re-enters a task only at a suspend point, never
//     mid-unwind, so a sibling task cannot interleave a write.
//   - a nested throw (a throw inside a handler arm) writes before it unwinds
//     and is read by ITS handler first, which is the correct innermost-wins
//     order.
// A handler that stores the payload and inspects the kind LATER is outside that
// window and must read `__exn_kind()` in the arm itself. Both sinks below do.

fn exn_kind_cell_name() -> String {
  "__exn_kind_cell"
}

/// The two-slot cell, appended to the program on demand.
///
/// `[0]` = the payload's static TYPE name (#1374). `[1]` = the payload
/// RENDERED at the throw site (#1392 slice 3): the kind alone tells an erased
/// arm that the payload is not text, but not what it says, and the arm cannot
/// recover that itself -- its binder's static type is `CtUnknown`, so neither a
/// `T::to_string` call nor a `[T: Show]` witness can be resolved there. The
/// throw site is the one place the type IS known, so it renders there and the
/// arm reads the string.
fn exn_kind_cell_stmt() -> Stmt {
  SLet(false, false, exn_kind_cell_name(), None, EArray([
    EString("", -1),
    EString("", -1)
  ]))
}

/// What `__exn_kind()` lowers to. Exported because the compiler-synthesized
/// entry boundary (`wrap_entry_exception_boundary`) is built AFTER this pass and
/// so has to spell the lowered form itself.
export fn exn_kind_read_expr() -> Expr {
  ECall(builtin_ref("Array::get"), [EIdent(exn_kind_cell_name(), -1), EInt(0)], -1, [
  ])
}

export fn exn_kind_write_expr(kind: String) -> Expr {
  ECall(builtin_ref("Array::set"), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(0),
    EString(kind, -1)
  ], -1, [])
}

/// What `__exn_message()` lowers to. Exported for the same reason
/// `exn_kind_read_expr` is: the entry boundary is synthesized after this pass.
export fn exn_msg_read_expr() -> Expr {
  ECall(builtin_ref("Array::get"), [EIdent(exn_kind_cell_name(), -1), EInt(1)], -1, [
  ])
}

export fn exn_msg_write_expr(rendered: Expr) -> Expr {
  ECall(builtin_ref("Array::set"), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(1),
    rendered
  ], -1, [])
}

/// Append the cell unless the program already declares it. Idempotent, and
/// callable from any pass that needs the cell to exist (the entry boundary
/// synthesizes a reader after this pass has already run).
export fn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit {
  if exn_kind_cell_present(stmts) {
    ()
  } else {
    Array::push(stmts, exn_kind_cell_stmt())
  }
}

/// Install the process boundary for an entry whose declared row carries
/// `Exception` (including the legacy `Error` alias and typed exceptions).
///
/// An escaping throw is not an ordinary return value. The old boundary
/// diagnosed it and returned `1`, which worked only for hosts that invoked the
/// entry export directly. Hosts that execute the conventional result-less
/// `_start` dropped that value and reported success. Trap after emitting the
/// diagnostic instead: every core/component launcher already maps a wasm trap
/// to a non-zero process status, while an inner handler still prevents this
/// boundary from running.
export fn wrap_entry_exception_boundary(stmts: Array[Stmt], entry_name: String) -> Unit {
  let mut i = 0
  let mut wrapped_any = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name && entry_row_has_exception(eff) {
        let payload_name = dinsp_fresh_name("__entry_err_msg", body, body)
        let kind_name = dinsp_fresh_name("__entry_err_kind", body, body)
        let rendered_name = dinsp_fresh_name("__entry_err_rendered", body, body)
        let kind_ident = EIdent(kind_name, -1)
        let msg_ident = EIdent(rendered_name, -1)
        let printable = EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("", -1)
        ], -1, []), EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("String", -1)
        ], -1, []), ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("Int", -1)
        ], -1, []), -1), -1)
        let rendered_ok = EBinOp("!=", ECall(builtin_ref("String::length"), [
          msg_ident
        ], -1, []), EInt(0), -1)
        let text = EIf(printable, ECall(builtin_ref("__to_string"), [
          EIdent(payload_name, -1)
        ], -1, []), EIf(rendered_ok, msg_ident, ECall(builtin_ref("String::concat"), [
          EString("<", -1),
          ECall(builtin_ref("String::concat"), [kind_ident, EString(">", -1)], -1, [
          ])
        ], -1, [])))
        // #2976: leave through the host's exit call with status 1, so the run
        // ends on the diagnosis instead of a second report of the trap that
        // used to follow it. The trap stays as the fallback for a host whose
        // exit call returns.
        let fail = ESeq(ECall(builtin_ref("vibe_process_exit_raw"), [EInt(1)], -1, [
        ]), ECall(EIdent("assert_true", -1), [EBool(false)], -1, []))
        let diag = ELet(kind_name, exn_kind_read_expr(), ELet(rendered_name, exn_msg_read_expr(), ESeq(ECall(builtin_ref("Stderr::write_stream"), [
          EString("vibe: uncaught error: ", -1)
        ], -1, []), ESeq(ECall(builtin_ref("Stderr::write_stream"), [text], -1, [
        ]), ESeq(ECall(builtin_ref("Stderr::write_stream"), [EString("\n", -1)], -1, [
        ]), fail))), -1), -1)
        let wrapped = EHandle(body, [
          (PCtor("Exception::Throw", [PBind(payload_name)]), diag)
        ])
        Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))
        wrapped_any = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if wrapped_any {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
}

fn entry_row_has_exception(eff: Option[String]) -> Bool {
  match eff {
    Some(row) => {
      let mut found = false
      let mut start = 0
      let n = String::length(row)
      let mut i = 0
      while i <= n {
        let at_sep = if i == n {
          true
        } else {
          String::char_code_at(row, i) == 44
        }
        if at_sep {
          if is_exception_effect_name(String::trim(String::substring(row, start, i))) {
            found = true
          }
          start = i + 1
        }
        i = i + 1
      }
      found
    },
    None => false
  }
}

export fn exn_kind_cell_present(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => if n == exn_kind_cell_name() {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn exn_kind_suppressed() -> Bool {
  Array::get(dtd_exn_kind_state, 0) == 1
}

export fn exn_kind_mark_used() -> Unit {
  Array::set(dtd_exn_kind_state, 1, 1)
}

/// A payload-temp name no other throw site shares. Lexical scoping alone would
/// make one fixed name correct (an inner throw's binding closes before the
/// outer one binds), but a distinct name per site keeps that from being a fact
/// the reader has to re-derive, and keeps the nesting legible in dumped IR.
export fn exn_kind_fresh_payload_name() -> String {
  let n = Array::get(dtd_exn_kind_state, 2)
  Array::set(dtd_exn_kind_state, 2, n + 1)
  String::concat("__exn_payload", __to_string(n))
}

/// `perform <Error|Exception[K]>::Throw(payload)` -- the ONLY shape `throw(x)`
/// lowers to (#640 Stage 2), and the only one that reaches the abortive tag.
export fn is_perform_throw_shape(callee: Expr, args: Array[Expr]) -> Bool {
  let head = match callee {
    EIdent(n, _) => n == "perform",
    _ => false
  }
  if head && Array::length(args) == 1 {
    match Array::get(args, 0) {
      ECall(op_callee, oargs, _, _) => match op_callee {
        EIdent(op_n, _) => is_exception_throw_operation(op_n) && Array::length(oargs) == 1,
        _ => false
      },
      _ => false
    }
  } else {
    false
  }
}

/// A nullary `__exn_kind()` call.
export fn is_exception_kind_read(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__exn_kind" && Array::length(args) == 0,
    _ => false
  }
}

/// A nullary `__exn_message()` call.
export fn is_exception_message_read(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__exn_message" && Array::length(args) == 0,
    _ => false
  }
}

export fn perform_throw_payload(args: Array[Expr]) -> Expr {
  match Array::get(args, 0) {
    ECall(_, oargs, _, _) => Array::get(oargs, 0),
    _ => EUnit
  }
}

/// `perform_throw_payload`'s inverse: the same `perform Throw(..)` shape with
/// the payload swapped for `payload`. Used to hoist the payload into a `let`
/// so the kind write happens after it is evaluated (#1374).
export fn perform_throw_with_payload(args: Array[Expr], payload: Expr) -> Array[Expr] {
  match Array::get(args, 0) {
    ECall(op_callee, _, ooff, callee_resolution) => [
      ECall(op_callee, [payload], ooff, callee_resolution)
    ],
    _ => args
  }
}

/// First `value` for `key`, or `fallback`. `owners` is built in lockstep with
/// the flattened sigs, so a miss means the two went out of step -- falling back
/// to the dict's own trait keeps the label a real trait name either way.
export fn lookup_str_pair(pairs: Array[(String, String)], key: String, fallback: String) -> String {
  let mut i = 0
  let mut found = fallback
  while i < Array::length(pairs) {
    let (k, v) = Array::get(pairs, i)
    if k == key {
      found = v
      i = Array::length(pairs)
    } else {
      i = i + 1
    }
  }
  found
}

/// Collect user struct field-name sets, for inferring a struct-literal's type
/// (the parser discards the `Name::` prefix of `Name::{ ... }`).
export fn collect_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let names = empty_str_array()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, j)
          Array::push(names, fname)
          j = j + 1
        }
        Array::push(out, (sname, names))
      },
      // #672: also record enum names (with an EMPTY field set, so the ERecord
      // field-set match never confuses an enum with a struct literal) so the
      // `==` dispatch's `struct_set_has` gate accepts enum operands too.
      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),
      _ => ()
    }
    i = i + 1
  }
  out
}
