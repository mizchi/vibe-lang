// Pure binder spelling helpers shared by structural normalization passes.
import @vibe/compiler/core {
  Pat, TypeExpr
}
import ./renderer_scope.vibe {
  collect_pat_binders
}
import ./utilities.vibe {
  empty_str_array, str_array_contains
}

export fn strip_label_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

export fn params_bind_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if strip_label_tilde(pn) == name {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

export fn pat_binds_name(p: Pat, name: String) -> Bool {
  let binders = empty_str_array()
  collect_pat_binders(p, binders)
  str_array_contains(binders, name)
}
