// Lambda return shapes.

import @vibe/compiler/lowering/trait_namespaces {
  lookup_trait_sigs
}

import @vibe/compiler/core {
  Expr, TypeExpr
}

import ./name_encoding.vibe {
  idx_str
}

import ./renderer_scope.vibe {
  collect_pat_binders
}

import ./utilities.vibe {
  empty_str_array, str_array_contains
}

export fn dtd_interp_lamret_key(name: String) -> String {
  String::concat("__Vlamret$", name)
}

fn dtd_interp_lamret_any() -> String {
  "*"
}

export fn dtd_interp_fn_lamret_key(n: String) -> String {
  String::concat("__Vfnlamret$", n)
}

export fn dtd_interp_lamret_elem(src: String) -> String {
  String::concat("a", src)
}

/// The marker for "returns a TUPLE of `arity` whose position `p` holds `src`",
/// written `u<arity>:<p>=<src>[,<p>=<src>...]`.
///
/// #2745 (Codex, P1 round 21 on #2761): round 17 handled `-> Array[U]` and
/// said a deeper shape "would need a type language here, and this pass has
/// none". A tuple needs only which POSITIONS carry a formal -- so `-> (U, Int)`
/// is recorded, and `{ let p = pack(a); p.0 }` resolves through the ordinary
/// tuple machinery instead of a rule of its own. Positions no source names stay
/// blank, so `p.1` still renders.
///
/// Round 23 (Codex, P1): each position carries its OWN source. The first cut
/// stored one argument index for the whole tuple and kept only the positions
/// that agreed with it, so `[U, V](u: U, v: V) -> (U, V)` recorded position 0
/// and SILENTLY DROPPED position 1 -- `p.1` was unknown and a struct `V`
/// printed its tagged pointer. One index per tuple was never the fact; it was
/// the fact the case that prompted the arm happened to have.
export fn dtd_interp_lamret_tuple(arity: Int, pairs: String) -> String {
  String::concat("u", String::concat(idx_str(arity), String::concat(":", pairs)))
}

/// One `<p>=<src>` entry of a `dtd_interp_lamret_tuple` marker.
export fn dtd_interp_lamret_pair(pos: Int, src: String) -> String {
  String::concat(idx_str(pos), String::concat("=", src))
}

export fn dtd_interp_lamret_type(name: String) -> String {
  String::concat("t", name)
}

fn dtd_interp_param_named(params: Array[(String, Option[TypeExpr])], n: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if pn == n {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// The index of the parameter declared at type `rh`, or `dtd_interp_lamret_any`.
fn dtd_interp_param_at_type(params: Array[(String, Option[TypeExpr])], rh: String) -> String {
  let mut i = 0
  let mut found = dtd_interp_lamret_any()
  while i < Array::length(params) {
    let (_, pt) = Array::get(params, i)
    match pt {
      Some(TyName(ph)) => if ph == rh && found == dtd_interp_lamret_any() {
        found = idx_str(i)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// The parameter index a lambda's return formal is spelled at, "" when the
/// return is not one of the lambda's own type parameters.
export fn dtd_interp_lamret_of(tps: Array[String], params: Array[(String, Option[TypeExpr])], ret: Option[TypeExpr], body: Expr) -> String {
  let from_ret = match ret {
    Some(TyName(rh)) => if str_array_contains(tps, rh) {
      dtd_interp_param_at_type(params, rh)
    } else {
      ""
    },
    // #2745 (Codex, P1 round 17 on #2761): a formal nested in the return TYPE.
    // `[U](u: U) -> Array[U]` records nothing under the rule above, because the
    // return is a `TyApp`, so `Array::get(pack(a), 0)` lost `T`. The result is
    // not itself erased -- it is an Array -- so this records a different fact:
    // the ELEMENT is argument k. Kept to `Array` of a bare formal deliberately:
    // a deeper shape would need a type language here, and this pass has none.
    Some(TyApp(rc, rargs)) => if rc == "Array" && Array::length(rargs) == 1 {
      match Array::get(rargs, 0) {
        TyName(eh) => if str_array_contains(tps, eh) {
          let at = dtd_interp_param_at_type(params, eh)
          if at == dtd_interp_lamret_any() {
            ""
          } else {
            dtd_interp_lamret_elem(at)
          }
        } else {
          ""
        },
        _ => ""
      }
    } else {
      ""
    },
    // Round 21: a TUPLE return. Which positions carry the formal is all this
    // needs, and that is three numbers rather than a type language.
    // Round 23: each position keeps its OWN argument index. The first cut kept
    // one for the whole tuple and dropped every position that disagreed, so
    // `[U, V](u: U, v: V) -> (U, V)` recorded `U` and lost `V` -- a formal the
    // caller can read back out of `p.1`.
    Some(TyTuple(rts)) => {
      let mut ti = 0
      let mut pairs = ""
      while ti < Array::length(rts) {
        match Array::get(rts, ti) {
          TyName(eh) => if str_array_contains(tps, eh) {
            let here = dtd_interp_param_at_type(params, eh)
            if here != dtd_interp_lamret_any() {
              let entry = dtd_interp_lamret_pair(ti, here)
              pairs = if String::length(pairs) == 0 {
                entry
              } else {
                String::concat(pairs, String::concat(",", entry))
              }
            } else {
              ()
            }
          } else {
            ()
          },
          _ => ()
        }
        ti = ti + 1
      }
      if String::length(pairs) > 0 {
        dtd_interp_lamret_tuple(Array::length(rts), pairs)
      } else {
        ""
      }
    },
    _ => ""
  }
  if String::length(from_ret) > 0 {
    from_ret
  } else {
    // Self-probed while fixing round 15: the annotation is not what makes the
    // answer available. `let opq = [U](u: U) { u }` -- the same lambda with the
    // return type left off -- still printed a 3-digit pointer decimal, because
    // the rule above reads `ret` and there is none.
    //
    // A body that IS a parameter returns that parameter's value, so the call's
    // classification is that argument's, whatever the types are. This needs no
    // tparam check: it is not an inference about the return TYPE, it is the
    // observation that the value is the argument. That also makes it narrow --
    // one syntactic shape, no environment consulted.
    dtd_interp_lamret_body_param(params, body)
  }
}

/// The index of the parameter a lambda's body EVALUATES TO, or "" when it does
/// not evaluate to one.
///
/// #2745 (Codex, P1 round 17 on #2761): this matched a bare `EIdent` only, so
/// `[U](u: U) { if true { u } else { u } }` -- which the checker types `U`
/// exactly as the bare form -- recorded nothing and printed a pointer. The
/// walk descends the same VALUE positions the rest of this file does, because
/// "the value of an `if` is the value of a branch" holds for a lambda's return
/// exactly as it did for the erased-formal walk #2773 removed.
///
/// A binding that SHADOWS a parameter stops the walk: past it the name no
/// longer means the parameter, and answering from the parameter would be the
/// round-3 stale-binding mistake in a new place.
fn dtd_interp_lamret_body_param(params: Array[(String, Option[TypeExpr])], body: Expr) -> String {
  match body {
    EIdent(bn, _) => {
      let mut i = 0
      let mut found = ""
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == bn && String::length(found) == 0 {
          found = idx_str(i)
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(_, conseq, alt) => {
      let ft = dtd_interp_lamret_body_param(params, conseq)
      if String::length(ft) > 0 {
        ft
      } else {
        dtd_interp_lamret_body_param(params, alt)
      }
    },
    ESeq(_, last) => dtd_interp_lamret_body_param(params, last),
    ELet(n, _, b, _) => if dtd_interp_param_named(params, n) {
      ""
    } else {
      dtd_interp_lamret_body_param(params, b)
    },
    ELetMut(n, _, b, _) => if dtd_interp_param_named(params, n) {
      ""
    } else {
      dtd_interp_lamret_body_param(params, b)
    },
    EMatch(_, arms) => {
      let mut i = 0
      let mut found = ""
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let names = empty_str_array()
        collect_pat_binders(ap, names)
        let mut shadows = false
        let mut ni = 0
        while ni < Array::length(names) {
          if dtd_interp_param_named(params, Array::get(names, ni)) {
            shadows = true
          } else {
            ()
          }
          ni = ni + 1
        }
        if !shadows && String::length(found) == 0 {
          found = dtd_interp_lamret_body_param(params, ab)
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => ""
  }
}

// A callable renderer must accept Self and return String. The method name
// alone would permit a bound whose to_string accepts an unrelated type.
//
// #2778: a formal whose spelling an ENCLOSING binder also bound used to be
// declined here, via `dtd_formal_is_shadowed`. That guard predates the overlay.
// It was written when a nested binder got no dictionary at all, so the only
// dictionary reachable for a shadowed spelling was the WRONG one -- the
// enclosing binder's -- and declining was the fail-closed reading of "never be
// silently wrong". Measured then: `fn outer[T: Show]` at `Pt` containing
// `let inner = [T: Show](a: T) { "\{a}" }` applied to a `Qt` printed `Pt!`, a
// `Qt` rendered through `Pt::to_string`, and `284` -- a tagged pointer -- with
// the dictionary withheld instead. A lie, or nothing.
//
// The EFn arm now overlays the lambda's own dictionaries on the enclosing ones
// and DROPS the rows this binder rebinds, so a shadowed spelling has exactly
// one reachable dictionary and it is the inner one. Re-measured on that
// compiler, the same program prints `Qt!`, and with the outer formal
// interpolated as well it prints `Qt!Pt!` -- each binder through its own
// witness. The guard is answering a question the overlay no longer poses, and
// "refuse until someone measures it" ends when someone measures it. The answers
// are pinned in `fixtures/lambda_bound_nested_witness_test.vibe`.
//
// `dtd_eq_witness_dict` keeps its own `dtd_formal_is_shadowed` check. That is
// the `==` path, and it is NOT the same question: `Eq` is a marker trait with
// no methods, so there is no witness to dispatch through however the formal is
// spelled. Retiring it is #2523's, and it has to move as one change (#2612).
export fn dtd_show_witness_dict(dict_binds: Array[(String, String, String, Array[String])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], head: String) -> Option[String] {
  let mut result = None
  let mut i = 0
  while i < Array::length(dict_binds) {
    let (tp, trait_name, pname, methods) = Array::get(dict_binds, i)
    if tp == head && str_array_contains(methods, "to_string") {
      match lookup_trait_sigs(traits, trait_name) {
        Some(sigs) => {
          let mut j = 0
          while j < Array::length(sigs) {
            let (method, params, ret) = Array::get(sigs, j)
            if method == "to_string" && Array::length(params) == 1 {
              match (Array::get(params, 0), ret) {
                (TyName("Self"), TyName("String")) => {
                  result = Some(pname)
                  i = Array::length(dict_binds)
                  j = Array::length(sigs)
                },
                _ => ()
              }
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  result
}
