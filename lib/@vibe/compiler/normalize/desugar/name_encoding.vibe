// Name encoding.

import @vibe/compiler/core {
  Expr
}

import @vibe/ast {
  builtin_ref
}

export fn concat2(a: Expr, b: Expr) -> Expr {
  ECall(builtin_ref("String::concat"), [a, b], -1, [])
}

/// Small non-negative Int -> decimal String (Int::to_string is not in scope in
/// this module). Used only to make unique enum-field binder names.
fn digit_str(d: Int) -> String {
  if d == 0 {
    "0"
  } else if d == 1 {
    "1"
  } else if d == 2 {
    "2"
  } else if d == 3 {
    "3"
  } else if d == 4 {
    "4"
  } else if d == 5 {
    "5"
  } else if d == 6 {
    "6"
  } else if d == 7 {
    "7"
  } else if d == 8 {
    "8"
  } else {
    "9"
  }
}

export fn idx_str(n: Int) -> String {
  if n < 10 {
    digit_str(n)
  } else {
    String::concat(idx_str(n / 10), digit_str(n % 10))
  }
}
