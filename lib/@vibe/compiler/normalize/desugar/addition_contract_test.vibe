// #3625: a bound's first retained method is the operator's static contract.
import @vibe/compiler/core {
  Expr, TypeEnv, TypeExpr
}
import @vibe/compiler/checker/traits {
  bound_entails_trait
}

import @vibe/compiler/checker {
  check_program
}
import @vibe/compiler/syntax {
  lex, parse_program
}
import ./lambda_return_shapes.vibe {
  dtd_interp_fn_lamret_key
}
import ./witness_targets.vibe {
  infer_impl_target_expr
}

import ./pipeline.vibe {
  desugar_trait_dicts
}
import ./method_witnesses.vibe {
  trait_method_declaring_owner
}

fn diagnostics(_ source: String) -> String {
  handle {
    let _ = check_program(parse_program(lex(source)), checked_error_row = false)
    ""
  } with { Exception::Throw(msg) => msg }
}

fn sum_call() -> String {
  "fn sum[T: Add](a: T, b: T) -> T { a + b }\nlet value = sum(0.1f, 0.2f)\n"
}

test "an Add with differently typed operands is refused at Float" {
  let src = "trait Add { add(Int, Int) -> Int }\nimpl Add for Float32 { add(a: Int, b: Int) -> Int { a + b } }\n" + sum_call()
  inspect(String::contains(diagnostics(src), needle = "no impl `Add` for `Float32`"), content = "true")
}

test "an Add returning a different type is refused at Float32" {
  let src = "trait Add { add(Self, Self) -> Int }\nimpl Add for Float32 { add(a: Float32, b: Float32) -> Int { 0 } }\n" + sum_call()
  inspect(String::contains(diagnostics(src), needle = "no impl `Add` for `Float32`"), content = "true")
}

test "an operator cannot supply a method's additional type parameter" {
  let src = "trait Add { add: [U: Eq](Self, Self) -> Self }\nimpl Add for Float32 { add[U: Eq](a: Float32, b: Float32) -> Float32 { a + b } }\n" + sum_call()
  inspect(String::contains(diagnostics(src), needle = "no impl `Add` for `Float32`"), content = "true")
}

test "a wrong first inherited add cannot authorize boxed arithmetic" {
  let src = "trait Bad { add(Int, Int) -> Int }\ntrait Key: Bad + Add\nimpl Key for Float32 { add(a: Int, b: Int) -> Int { a + b } }\nfn sum[T: Key](a: T, b: T) -> T { a + b }\nlet value = sum(0.1f, 0.2f)\n"
  inspect(String::contains(diagnostics(src), needle = "no impl `Add` for `Float32`"), content = "true")
}

fn inherited_owner(_ supers: String) -> String with Exception {
  let src = "trait Add { add(Self, Self) -> Self }\ntrait Weird { add(Self, Self) -> Self }\ntrait Key: " + supers + "\nfn sum[T: Key](a: T, b: T) -> T { a + b }\n"
  let stmts = parse_program(lex(src))
  desugar_trait_dicts(stmts)
  trait_method_declaring_owner(trait_name = "Key", method = "add")
}

test "declaring-owner cache belongs to one program" {
  inspect(inherited_owner("Add + Weird"), content = "Add")
  inspect(inherited_owner("Weird + Add"), content = "Weird")
  inspect(inherited_owner("Add + Weird"), content = "Add")
}

test "operator bound reachability terminates on cycles" {
  let env = EnvTraitDef("Loop", ["Loop"], true, [], EnvEmpty, [], [])
  inspect(bound_entails_trait(env = env, bound = "Loop", wanted = "Add"), content = "false")
  inspect(bound_entails_trait(env = env, bound = "Loop", wanted = "Ord"), content = "false")
  let linked = EnvTraitDef("Key", ["Loop", "Add"], true, [], env, [], [])
  inspect(bound_entails_trait(env = linked, bound = "Key", wanted = "Add"), content = "true")
}

test "bare result correspondence does not authorize nested witnesses" {
  let returns = [(dtd_interp_fn_lamret_key("pick"), "0")]
  let scalar = ECall(EIdent("pick", -1), [EInt(1)], -1, [])
  let nested = ECall(EIdent("pick", -1), [
    ECall(EIdent("Some", -1), [EInt(1)], -1, [])
  ], -1, [])
  inspect(match infer_impl_target_expr(arg = scalar, struct_sets = [], var_types = [
  ], fn_returns = returns) {
    Some(TyName(name)) => name == "Int",
    _ => false
  }, content = "true")
  inspect(infer_impl_target_expr(arg = nested, struct_sets = [], var_types = [], fn_returns = returns) is None, content = "true")
}
