// Inspect rewrite.

import @vibe/compiler/core {
  Expr, ImportItem, Pat, Stmt, TypeExpr, __to_string, call_placement_note_positional, expr_children
}

import @vibe/ast {
  builtin_ref
}

import @vibe/parser {
  resolve_interp_expr
}

import ./binding_names.vibe {
  params_bind_name, pat_binds_name
}

import ./state.vibe {
  dinsp_census_cell, dinsp_census_row
}

/// Read-only scan for one of six questions, in ONE explicit-variant walk:
///   mode 0 -- does this contain a two-argument `inspect(..)` call?
///   mode 1 -- does this BIND the name `inspect` (a let / for / fn parameter)?
///   mode 2 -- does this mention `name` at all, as a reference or a binder?
///   mode 3 -- does this contain a labeled-argument wrapper?
///   mode 4 -- is `name` used anywhere except as a direct call callee?
///   mode 5 -- is `name` targeted by an assignment or assignment-op?
///   mode 8 -- does this BIND `name` anywhere (any binder form, any depth)?
///
/// The variants are enumerated by hand rather than recursed through
/// `expr_children`, and that is the whole point: `expr_children` ALLOCATES a
/// fresh array per node, so using it for a "read-only" pre-check cost more
/// allocation than the rebuild the pre-check exists to avoid. Measured on the
/// perf gate's deterministic axis: the expr_children version put
/// `selfcompile heap_ptr_bytes` +2.61% over main; this one is allocation-free.
///
/// Enumerated (no `_ =>` catch-all for the recursive shapes) so a new `Expr`
/// variant is a compile error here instead of a silently unscanned subtree.
/// Mode 0's predicate: this node is an `inspect(value, content)` call.
fn dinsp_here_uses(_ expr: Expr) -> Bool {
  match expr {
    ECall(callee, args, _, _) => match callee {
      EIdent(n, _) => n == "inspect" && Array::length(args) == 2,
      _ => false
    },
    _ => false
  }
}

/// Mode 1's predicate: this node binds the name `inspect`.
fn dinsp_here_binds(_ expr: Expr) -> Bool {
  match expr {
    ELet(n, _, _, _) => n == "inspect",
    ELetRec(n, _, _) => n == "inspect",
    ELetMut(n, _, _, _) => n == "inspect",
    EForIn(v, _, _, _, _) => v == "inspect",
    EFn(_, _, params, _, _, _) => dinsp_params_bind(params = params, name = "inspect"),
    EMatch(_, arms) => dinsp_arms_bind(arms = arms, name = "inspect"),
    EHandle(_, arms) => dinsp_arms_bind(arms = arms, name = "inspect"),
    _ => false
  }
}

export fn dinsp_scan(expr: Expr, mode: Int, name: String) -> Bool {
  let here = if mode == 0 {
    dinsp_here_uses(expr)
  } else if mode == 1 {
    dinsp_here_binds(expr)
  } else if mode == 7 {
    if dinsp_here_uses(expr) {
      Array::set(dinsp_census_cell, at = 0, value = 1)
    } else {
      ()
    }
    if dinsp_here_binds(expr) {
      Array::set(dinsp_census_cell, at = 1, value = 1)
    } else {
      ()
    }
    Array::get(dinsp_census_cell, at = 0) != 0 && Array::get(dinsp_census_cell, at = 1) != 0
  } else if mode == 2 {
    match expr {
      EIdent(n, _) => n == name,
      ELet(n, _, _, _) => n == name,
      ELetRec(n, _, _) => n == name,
      ELetMut(n, _, _, _) => n == name,
      EAssign(n, _, _, _) => n == name,
      EAssignOp(n, _, _, _, _) => n == name,
      EForIn(v, _, _, _, _) => v == name,
      EFn(_, _, params, _, _, _) => dinsp_params_bind(params = params, name = name),
      EMatch(_, arms) => dinsp_arms_bind(arms = arms, name = name),
      EHandle(_, arms) => dinsp_arms_bind(arms = arms, name = name),
      _ => false
    }
  } else if mode == 8 {
    // #3532: the re-throw guard (`exn_rethrow_enter`) asks whether every
    // `name` inside an arm body still means the arm's own binder. Unlike mode
    // 2 it ignores references, and it counts every binder spelling: a `for`
    // index, a `loop` parameter, an optional parameter (`name?`), and the `resume` an operation arm binds. Over-approximating
    // only costs the guard its restore; it never makes a binder look free.
    match expr {
      ELet(n, _, _, _) => n == name,
      ELetRec(n, _, _) => n == name,
      ELetMut(n, _, _, _) => n == name,
      EForIn(v, idx, _, _, _) => v == name || dinsp_opt_is(opt = idx, name = name),
      EFn(_, _, params, _, _, _) => dinsp_params_bind_spelled(params = params, name = name),
      EMatch(_, arms) => dinsp_arms_bind(arms = arms, name = name),
      EHandle(_, arms) => name == "resume" || dinsp_arms_bind(arms = arms, name = name),
      ELoop(params, _) => dinsp_loop_params_bind(params = params, name = name),
      _ => false
    }
  } else if mode == 4 {
    match expr {
      EIdent(n, _) => n == name,
      EAssign(n, _, _, _) => n == name,
      EAssignOp(n, _, _, _, _) => n == name,
      _ => false
    }
  } else {
    match expr {
      EAssign(n, _, _, _) => n == name,
      EAssignOp(n, _, _, _, _) => n == name,
      _ => false
    }
  }
  if here {
    true
  } else {
    match expr {
      EInt(_) => false,
      EFloat(_) => false,
      EString(_, _) => false,
      EBool(_) => false,
      EUnit => false,
      EIdent(_, _) => false,
      EStringInterp(_) => false,
      ETuple(items) => dinsp_scan_list(items = items, mode = mode, name = name),
      EArray(items) => dinsp_scan_list(items = items, mode = mode, name = name),
      ERecord(_, fields, _) => dinsp_scan_fields(fields = fields, mode = mode, name = name),
      EMap(fields) => dinsp_scan_fields(fields = fields, mode = mode, name = name),
      EIf(c, t, f) => dinsp_scan(expr = c, mode = mode, name = name) || dinsp_scan(expr = t, mode = mode, name = name) || dinsp_scan(expr = f, mode = mode, name = name),
      ELet(_, v, b, _) => dinsp_scan(expr = v, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      ELetRec(_, v, b) => dinsp_scan(expr = v, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      ELetMut(_, v, b, _) => dinsp_scan(expr = v, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      EAssign(_, v, b, _) => dinsp_scan(expr = v, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      EAssignOp(_, _, v, b, _) => dinsp_scan(expr = v, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      ESeq(a, b) => dinsp_scan(expr = a, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      EMatch(sc, arms) => dinsp_scan(expr = sc, mode = mode, name = name) || dinsp_scan_arms(arms = arms, mode = mode, name = name),
      EHandle(sc, arms) => dinsp_scan(expr = sc, mode = mode, name = name) || dinsp_scan_arms(arms = arms, mode = mode, name = name),
      EWhile(c, b) => dinsp_scan(expr = c, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      ELoop(params, b) => dinsp_scan_fields(fields = params, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      EForIn(_, _, it, b, _) => dinsp_scan(expr = it, mode = mode, name = name) || dinsp_scan(expr = b, mode = mode, name = name),
      ECall(callee, args, _, _) => if mode == 4 {
        match callee {
          EIdent(n, _) => if n == name {
            dinsp_scan_list(items = args, mode = mode, name = name)
          } else {
            dinsp_scan(expr = callee, mode = mode, name = name) || dinsp_scan_list(items = args, mode = mode, name = name)
          },
          _ => dinsp_scan(expr = callee, mode = mode, name = name) || dinsp_scan_list(items = args, mode = mode, name = name)
        }
      } else {
        dinsp_scan(expr = callee, mode = mode, name = name) || dinsp_scan_list(items = args, mode = mode, name = name)
      },
      EBinOp(_, l, r, _) => dinsp_scan(expr = l, mode = mode, name = name) || dinsp_scan(expr = r, mode = mode, name = name),
      EUnaryOp(_, v) => dinsp_scan(expr = v, mode = mode, name = name),
      EFn(_, _, _, _, _, body) => dinsp_scan(expr = body, mode = mode, name = name),
      EDot(inner, _, _, _) => dinsp_scan(expr = inner, mode = mode, name = name),
      ELabeledArg(_, _, v) => dinsp_scan(expr = v, mode = mode, name = name),
      EReturn(v) => dinsp_scan(expr = v, mode = mode, name = name),
      EBreak(opt) => match opt {
        Some(v) => dinsp_scan(expr = v, mode = mode, name = name),
        None => false
      },
      EContinue(args) => dinsp_scan_list(items = args, mode = mode, name = name),
      ESpread(v) => dinsp_scan(expr = v, mode = mode, name = name)
    }
  }
}

fn dinsp_scan_list(items: Array[Expr], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(items) {
    found = dinsp_scan(expr = Array::get(items, at = i), mode = mode, name = name)
    i = i + 1
  }
  found
}

fn dinsp_scan_fields(fields: Array[(String, Expr)], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(fields) {
    let (_, v) = Array::get(fields, at = i)
    found = dinsp_scan(expr = v, mode = mode, name = name)
    i = i + 1
  }
  found
}

/// A binder named `name` in PATTERN position -- `let (inspect, x) = ..`, a
/// match/handle arm's `Some(inspect)`, a struct-pattern field bound to it.
///
/// Codex review on #1622 (P1): without this the shadow guard only saw binders
/// spelled in expression position, so a `inspect` introduced by destructuring
/// left the range's binder check false and the rewrite went ahead and replaced the
/// user's own call with snapshot-assertion behaviour -- silently, since the
/// program still compiled.
fn dinsp_pat_binds(pat: Pat, name: String) -> Bool {
  match pat {
    PWild => false,
    PBind(n) => n == name,
    PInt(_) => false,
    PFloat(_) => false,
    PString(_) => false,
    PBool(_) => false,
    PCtor(_, args) => dinsp_pat_list_binds(pats = args, name = name),
    PTuple(items) => dinsp_pat_list_binds(pats = items, name = name),
    POr(a, b) => dinsp_pat_binds(pat = a, name = name) || dinsp_pat_binds(pat = b, name = name),
    PStruct(_, fields) => dinsp_pat_fields_bind(fields = fields, name = name)
  }
}

fn dinsp_pat_list_binds(pats: Array[Pat], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(pats) {
    found = dinsp_pat_binds(pat = Array::get(pats, at = i), name = name)
    i = i + 1
  }
  found
}

fn dinsp_pat_fields_bind(fields: Array[(String, Pat)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(fields) {
    let (_, p) = Array::get(fields, at = i)
    found = dinsp_pat_binds(pat = p, name = name)
    i = i + 1
  }
  found
}

fn dinsp_arms_bind(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(arms) {
    let (p, _) = Array::get(arms, at = i)
    found = dinsp_pat_binds(pat = p, name = name)
    i = i + 1
  }
  found
}

fn dinsp_scan_arms(arms: Array[(Pat, Expr)], mode: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(arms) {
    let (_, v) = Array::get(arms, at = i)
    found = dinsp_scan(expr = v, mode = mode, name = name)
    i = i + 1
  }
  found
}

/// Every name `expr` MENTIONS -- as a reference or as a binder. Used to mint
/// temporaries that cannot capture anything in the expressions being moved.
/// Over-approximates (a shadowed inner binder counts too), which only ever
/// costs a suffix.
fn dinsp_mentions(expr: Expr, name: String) -> Bool {
  dinsp_scan(expr = expr, mode = 2, name = name)
}

fn dinsp_params_bind(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(params) {
    let (pn, _) = Array::get(params, at = i)
    found = pn == name
    i = i + 1
  }
  found
}

/// A parameter binds `name` under any spelling the parser leaves on it: bare
/// or optional (`name?`).
fn dinsp_params_bind_spelled(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(params) {
    let (pn, _) = Array::get(params, at = i)
    found = pn == name || pn == String::concat(name, "?")
    i = i + 1
  }
  found
}

fn dinsp_loop_params_bind(params: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(params) {
    let (pn, _) = Array::get(params, at = i)
    found = pn == name
    i = i + 1
  }
  found
}

fn dinsp_opt_is(opt: Option[String], name: String) -> Bool {
  match opt {
    Some(n) => n == name,
    None => false
  }
}

/// `base`, or `base` with the smallest numeric suffix that neither argument
/// mentions. Bounded by an occurrence check rather than a global counter so the
/// expansion stays a pure function of its inputs (two identical `inspect` calls
/// lower identically, which keeps the pass idempotent).
export fn dinsp_fresh_name(base: String, value: Expr, content: Expr) -> String {
  let mut candidate = base
  let mut n = 0
  while dinsp_mentions(expr = value, name = candidate) || dinsp_mentions(expr = content, name = candidate) {
    n = n + 1
    candidate = String::concat(base, String::concat("_", __to_string(n)))
  }
  candidate
}

/// #1571: the desugared form of `inspect(value, content)`.
///
/// WHY A BUILTIN AT ALL. `inspect` was deliberately a plain library function in
/// `@vibe/core` -- it needs no codegen support, only `__to_string` + `println`
/// + `assert_true`, so adding it there cost nothing (see assert.vibe's header).
/// #1571 changed the constraint: migrating the `__DATA__` fixtures to inline
/// snapshots means `inspect` must be callable from a fixture compiled in the
/// SINGLE-FILE lane, which resolves no imports at all, so a library function
/// cannot be reached from one. Registering it alongside `assert` /
/// `assert_true` / `assert_eq` -- import-free for exactly this reason -- is
/// what unblocks the rest of that migration.
///
/// WHY A REWRITE AND NOT A CODEGEN LOWERING. The first cut lowered `inspect` at
/// the callsite in both backends, the way `assert_eq` is lowered. That builds
/// an invalid module: everything a call needs is decided by passes that run
/// BEFORE codegen and walk the AST, so an expression conjured during emission
/// is invisible to them. Measured, in order: the message literals were absent
/// from the string table (`string not in table: inspect mismatch:`), and once
/// those were seeded by hand, the synthesized `println` still had no gated-in
/// `Stdout::write_stream` import and produced `expected 1 elements on the stack
/// for fallthru, found 3`. Expanding here instead -- before checking, before
/// every scan -- means each of those passes sees ordinary calls and needs no
/// knowledge of `inspect` at all. It also gives both backends the same
/// expansion by construction rather than by two lowerings agreeing.
///
/// Both arguments are let-bound because each is referenced more than once.
/// Re-evaluating them would make `inspect(next(), ..)` consume two values and
/// report a different one than it compared.
///
/// The temporaries are minted FRESH against both arguments (dinsp_fresh_name).
/// A fixed name captures: with `let __vibe_inspect_actual = "wrong"`,
/// `inspect(1, __vibe_inspect_actual)` would move that reference under the new
/// binding and compare the stringified value against ITSELF -- a failing
/// assertion that silently passes, which is the worst way this could break
/// (Codex review on #1621).
fn inspect_lowering_expr(value: Expr, content: Expr, cell: Array[Int]) -> Expr {
  let actual_name = dinsp_fresh_name(base = "__vibe_inspect_actual", value = value, content = content)
  let expected_name = dinsp_fresh_name(base = "__vibe_inspect_expected", value = value, content = content)
  let actual = EIdent(actual_name, 0 - 1)
  let expected = EIdent(expected_name, 0 - 1)
  // Nested String::concat rather than one variadic call: `concat` is binary.
  let tail = ECall(builtin_ref("String::concat"), [
    EString("\n  expected: ", -1),
    expected
  ], 0 - 1, [])
  let body_msg = ECall(builtin_ref("String::concat"), [actual, tail], 0 - 1, [])
  let msg = ECall(builtin_ref("String::concat"), [
    EString("inspect mismatch:\n  actual:   ", -1),
    body_msg
  ], 0 - 1, [])
  // The message must print BEFORE the trap: `vibe test --update` reads exactly
  // this "actual/expected" text off stdout to rewrite the stale literal.
  let on_mismatch = ESeq(ECall(EIdent("println", 0 - 1), [msg], 0 - 1, []), ECall(EIdent("assert_true", 0 - 1), [
    EBool(false)
  ], 0 - 1, []))
  let check = EIf(EBinOp("==", actual, expected, -1), EUnit, on_mismatch)
  ELet(actual_name, ECall(builtin_ref("__to_string"), [value], 0 - 1, cell), ELet(expected_name, content, check, 0 - 1), 0 - 1)
}

/// Rewrite every two-argument `inspect(value, content)` call to its expansion.
///
/// Only reached when the file binds NOTHING named `inspect` (see
/// desugar_inspect_calls). A file that declares, imports or takes a parameter
/// named `inspect` keeps calling that one, exactly as it did before this pass
/// existed -- rewriting there would silently swap a user function's body for
/// snapshot-assertion behaviour (Codex review on #1621).
fn dinsp_expr(_ expr: Expr) -> Expr {
  match expr {
    ECall(callee, args, off, callee_resolution) => {
      let rewritten = for a in args {
        dinsp_expr(a)
      }
      match callee {
        EIdent(name, _) => if name == "inspect" && Array::length(rewritten) == 2 {
          call_placement_note_positional(callee = callee, args = args, offset = off, cell = callee_resolution)
          inspect_lowering_expr(value = Array::get(rewritten, at = 0), content = Array::get(rewritten, at = 1), cell = callee_resolution)
        } else {
          ECall(dinsp_expr(callee), rewritten, off, callee_resolution)
        },
        _ => ECall(dinsp_expr(callee), rewritten, off, callee_resolution)
      }
    },
    _ => dinsp_children(expr)
  }
}

fn dinsp_exprs(_ items: Array[Expr]) -> Array[Expr] {
  for item in items {
    dinsp_expr(item)
  }
}

fn dinsp_fields(_ fields: Array[(String, Expr)]) -> Array[(String, Expr)] {
  for f in fields {
    (f.0, dinsp_expr(f.1))
  }
}

fn dinsp_arms(_ arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  for arm in arms {
    (arm.0, dinsp_expr(arm.1))
  }
}

fn dinsp_opt(_ opt: Option[Expr]) -> Option[Expr] {
  match opt {
    Some(v) => Some(dinsp_expr(v)),
    None => None
  }
}

/// Structural recursion for every non-ECall node. Enumerated rather than
/// `_ => expr` so a new `Expr` variant is a compile error here instead of a
/// silently un-rewritten subtree.
fn dinsp_children(_ expr: Expr) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EIdent(_, _) => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(dinsp_exprs(items)),
    EArray(items) => EArray(dinsp_exprs(items)),
    ERecord(n, fields, tys) => ERecord(n, dinsp_fields(fields), tys),
    EMap(fields) => EMap(dinsp_fields(fields)),
    EIf(c, t, f) => EIf(dinsp_expr(c), dinsp_expr(t), dinsp_expr(f)),
    ELet(n, v, b, off) => ELet(n, dinsp_expr(v), dinsp_expr(b), off),
    ELetRec(n, v, b) => ELetRec(n, dinsp_expr(v), dinsp_expr(b)),
    ELetMut(n, v, b, off) => ELetMut(n, dinsp_expr(v), dinsp_expr(b), off),
    EAssign(n, v, b, target_off) => EAssign(n, dinsp_expr(v), dinsp_expr(b), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, dinsp_expr(v), dinsp_expr(b), target_off),
    ESeq(a, b) => ESeq(dinsp_expr(a), dinsp_expr(b)),
    EMatch(s, arms) => EMatch(dinsp_expr(s), dinsp_arms(arms)),
    EHandle(s, arms) => EHandle(dinsp_expr(s), dinsp_arms(arms)),
    EWhile(c, b) => EWhile(dinsp_expr(c), dinsp_expr(b)),
    ELoop(params, b) => ELoop(dinsp_fields(params), dinsp_expr(b)),
    EForIn(v, k, it, b, for_off) => EForIn(v, k, dinsp_expr(it), dinsp_expr(b), for_off),
    ECall(callee, args, off, callee_resolution) => ECall(dinsp_expr(callee), dinsp_exprs(args), off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, dinsp_expr(l), dinsp_expr(r), boff),
    EUnaryOp(op, v) => EUnaryOp(op, dinsp_expr(v)),
    EFn(g, bs, ps, ret, row, body) => EFn(g, bs, ps, ret, row, dinsp_expr(body)),
    EDot(inner, f, off, foff) => EDot(dinsp_expr(inner), f, off, foff),
    ELabeledArg(l, sfx, v) => ELabeledArg(l, sfx, dinsp_expr(v)),
    EReturn(v) => EReturn(dinsp_expr(v)),
    EBreak(opt) => EBreak(dinsp_opt(opt)),
    EContinue(args) => EContinue(dinsp_exprs(args)),
    ESpread(v) => ESpread(dinsp_expr(v))
  }
}

fn dinsp_stmt(_ stmt: Stmt) -> Stmt {
  match stmt {
    SLet(e, r, n, t, body) => SLet(e, r, n, t, dinsp_expr(body)),
    SLetMut(n, t, body) => SLetMut(n, t, dinsp_expr(body)),
    SLetPat(p, body) => SLetPat(p, dinsp_expr(body)),
    STest(n, body) => STest(n, dinsp_expr(body)),
    SBench(n, body) => SBench(n, dinsp_expr(body)),
    SExample(n, body) => SExample(n, dinsp_expr(body)),
    SExpr(body) => SExpr(dinsp_expr(body)),
    SFnDecl(e, n, body, req, ens) => SFnDecl(e, n, dinsp_expr(body), req, ens),
    SModule(e, n, body) => SModule(e, n, dinsp_stmts_copy(body)),
    _ => stmt
  }
}

fn dinsp_stmts_copy(_ stmts: Array[Stmt]) -> Array[Stmt] {
  for s in stmts {
    dinsp_stmt(s)
  }
}

/// Bit 1: the expression contains an `inspect(..)` call (mode 0); bit 2: it
/// binds the name `inspect` somewhere (mode 1). One walk answers both.
fn dinsp_expr_census(_ expr: Expr) -> Int {
  Array::set(dinsp_census_cell, at = 0, value = 0)
  Array::set(dinsp_census_cell, at = 1, value = 0)
  let _ = dinsp_scan(expr = expr, mode = 7, name = "")
  let uses = if Array::get(dinsp_census_cell, at = 0) != 0 {
    1
  } else {
    0
  }
  let binds = if Array::get(dinsp_census_cell, at = 1) != 0 {
    2
  } else {
    0
  }
  uses|binds
}

/// The same bits for a statement: exactly dinsp_stmt_uses (bit 1) and
/// dinsp_stmt_binds (bit 2), computed together.
fn dinsp_stmt_census(_ stmt: Stmt) -> Int {
  match stmt {
    SImport(_, items) => if dinsp_import_binds(items) {
      2
    } else {
      0
    },
    SReExport(_, items) => if dinsp_import_binds(items) {
      2
    } else {
      0
    },
    SLet(_, _, name, _, body) => dinsp_expr_census(body)|dinsp_name_binds_bit(name),
    SLetMut(name, _, body) => dinsp_expr_census(body)|dinsp_name_binds_bit(name),
    SLetPat(pat, body) => dinsp_expr_census(body)|(if dinsp_pat_binds(pat = pat, name = "inspect") {
      2
    } else {
      0
    }),
    SFnDecl(_, name, body, _, _) => dinsp_expr_census(body)|dinsp_name_binds_bit(name),
    STest(_, body) => dinsp_expr_census(body),
    SBench(_, body) => dinsp_expr_census(body),
    SExample(_, body) => dinsp_expr_census(body),
    SExpr(body) => dinsp_expr_census(body),
    SModule(_, _, body) => dinsp_stmts_census(body),
    _ => 0
  }
}

fn dinsp_name_binds_bit(_ name: String) -> Int {
  if name == "inspect" {
    2
  } else {
    0
  }
}

fn dinsp_stmts_census(_ stmts: Array[Stmt]) -> Int {
  let mut bits = 0
  let mut i = 0
  while bits != 3 && i < Array::length(stmts) {
    bits = bits|dinsp_stmt_census(Array::get(stmts, at = i))
    i = i + 1
  }
  bits
}

export fn import_items_bind_name(items: Array[ImportItem], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, at = i)
    let local = match item.alias {
      Some(alias) => alias,
      None => item.name
    }
    found = local == name
    i = i + 1
  }
  found
}

export fn expr_list_has_free_name(items: Array[Expr], name: String) -> Bool with Exception {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    found = expr_has_free_name(expr = Array::get(items, at = i), name = name)
    i = i + 1
  }
  found
}

fn arm_list_has_free_name(arms: Array[(Pat, Expr)], name: String) -> Bool with Exception {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, body) = Array::get(arms, at = i)
    if !pat_binds_name(p = pat, name = name) {
      found = expr_has_free_name(expr = body, name = name)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Whether `name` occurs free in this expression. Binding forms stop only the
/// body region they govern; a same-spelled parameter in one nested function
/// must not hide an unrelated reference elsewhere in the source unit.
export fn expr_has_free_name(expr: Expr, name: String) -> Bool with Exception {
  match expr {
    EIdent(local, _) => local == name,
    EStringInterp(_) => expr_has_free_name(expr = resolve_interp_expr(expr), name = name),
    ELet(local, value, body, _) => expr_has_free_name(expr = value, name = name) || if local == name {
      false
    } else {
      expr_has_free_name(expr = body, name = name)
    },
    ELetRec(local, value, body) => if local == name {
      false
    } else {
      expr_has_free_name(expr = value, name = name) || expr_has_free_name(expr = body, name = name)
    },
    ELetMut(local, value, body, _) => expr_has_free_name(expr = value, name = name) || if local == name {
      false
    } else {
      expr_has_free_name(expr = body, name = name)
    },
    EAssign(local, value, body, _) => local == name || expr_has_free_name(expr = value, name = name) || expr_has_free_name(expr = body, name = name),
    EAssignOp(local, _, value, body, _) => local == name || expr_has_free_name(expr = value, name = name) || expr_has_free_name(expr = body, name = name),
    EForIn(value_name, key_name, iter, body, _) => expr_has_free_name(expr = iter, name = name) || if value_name == name || match key_name {
      Some(key) => key == name,
      None => false
    } {
      false
    } else {
      expr_has_free_name(expr = body, name = name)
    },
    EFn(_, _, params, _, _, body) => if params_bind_name(params = params, name = name) {
      false
    } else {
      expr_has_free_name(expr = body, name = name)
    },
    ELoop(params, body) => {
      let mut i = 0
      let mut found = false
      let mut shadowed = false
      while i < Array::length(params) {
        let (local, initial) = Array::get(params, at = i)
        if !found {
          found = expr_has_free_name(expr = initial, name = name)
        } else {
          ()
        }
        if local == name {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      found || if shadowed {
        false
      } else {
        expr_has_free_name(expr = body, name = name)
      }
    },
    EMatch(scrutinee, arms) => expr_has_free_name(expr = scrutinee, name = name) || arm_list_has_free_name(arms = arms, name = name),
    EHandle(body, arms) => expr_has_free_name(expr = body, name = name) || arm_list_has_free_name(arms = arms, name = name),
    _ => expr_list_has_free_name(items = expr_children(expr), name = name)
  }
}

export fn dinsp_blocker_names_inspect(_ names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = Array::get(names, at = i) == "inspect"
    i = i + 1
  }
  found
}

export fn dinsp_rewrite_range(stmts: Array[Stmt], start: Int, end: Int) -> Bool {
  Array::truncate(dinsp_census_row, length = 0)
  let mut binds = false
  let mut i = start
  while i < end {
    let bits = dinsp_stmt_census(Array::get(stmts, at = i))
    Array::push(dinsp_census_row, value = bits)
    if (bits&2) != 0 {
      binds = true
    } else {
      ()
    }
    i = i + 1
  }
  let mut changed = false
  if binds {
    ()
  } else {
    i = start
    while i < end {
      if (Array::get(dinsp_census_row, at = i - start)&1) != 0 {
        Array::set(stmts, at = i, value = dinsp_stmt(Array::get(stmts, at = i)))
        changed = true
      } else {
        ()
      }
      i = i + 1
    }
  }
  changed
}

fn dinsp_import_binds(_ items: Array[ImportItem]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(items) {
    let item = Array::get(items, at = i)
    let original = item.name
    let alias = item.alias
    found = match alias {
      Some(a) => a == "inspect",
      None => original == "inspect"
    }
    i = i + 1
  }
  found
}
