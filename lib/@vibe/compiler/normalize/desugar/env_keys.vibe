// Var-type environment keys.
//
// The desugar's var-type environment is one list of (key, value) rows. A
// binding's derived facts sit under keys spelled `<prefix><name>`. The
// prefixes live here so a key can be matched without building it: a hot
// lookup used to concatenate its key once per question (#3900).

export fn shape_key_prefix() -> String {
  "__shape$"
}

export fn tuple_shape_key_prefix() -> String {
  "__tupshape$"
}

export fn eq_shape_key_prefix() -> String {
  "__eqshape$"
}

export fn eq_formal_shape_key_prefix() -> String {
  "__eqformalshape$"
}

export fn eq_fn_result_key_prefix() -> String {
  "__eqfnresult$"
}

export fn constructor_head_key_prefix() -> String {
  "__ctorhead$"
}

export fn constructor_mask_key_prefix() -> String {
  "__ctormask$"
}

export fn array_elem_key_prefix() -> String {
  "__arrelem$"
}

export fn impl_target_var_key_prefix() -> String {
  "$impl_target$"
}

export fn local_fn_return_key_prefix() -> String {
  "__local_fn_return$"
}

export fn lamret_key_prefix() -> String {
  "__Vlamret$"
}

/// Whether `key` is `prefix` followed by `name`, without building that string.
export fn env_key_is(key: String, prefix: String, name: String) -> Bool {
  String::length(key) == String::length(prefix) + String::length(name) && String::ends_with(key, suffix = name) && String::starts_with(key, prefix = prefix)
}

/// `lookup_var_type(var_types, prefix + name)`, without building the key: the
/// value of the LAST row keyed `<prefix><name>`, or None.
export fn lookup_var_type_keyed(var_types: Array[(String, String)], prefix: String, name: String) -> Option[String] {
  // `env_key_is`, inlined: this loop runs once per row of the environment.
  let want = String::length(prefix) + String::length(name)
  let mut i = Array::length(var_types) - 1
  let mut result = None
  while i >= 0 {
    let (vn, vt) = Array::get(var_types, at = i)
    if String::length(vn) == want && String::ends_with(vn, suffix = name) && String::starts_with(vn, prefix = prefix) {
      result = Some(vt)
      i = -1
    } else {
      i = i - 1
    }
  }
  result
}
