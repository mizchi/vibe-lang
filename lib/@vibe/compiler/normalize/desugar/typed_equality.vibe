/// Equality of two operands whose declared type is `fty`. Fully type-directed:
///   - scalar `TyName` -> raw `==`
///   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`
///   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads
///   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs
///   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`
///   - anything else -> raw `==` (status quo fallback)
/// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so
/// structural equality MUST be resolved here at the AST level where the static
/// type is known. (#695.)
export fn eq_for_typed(fty0: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  // #2141 (Codex round on #2183): re-spell in-scope formals for the WHOLE
  // type at the entry, not per-arm -- a composite shape reaching typed-eq
  // dispatch at rewrite time must never leave a sibling `TyName(<formal>)`
  // unmarked for the `known_types` arm below. Measured: no current channel
  // feeds such a shape (annotation shapes mentioning tparams are skipped at
  // seed_var_types / collect_fn_eq_return_shape), so today this subsumes the
  // Array-arm re-spelling; at generation time the scope stack is empty and
  // this is the identity.
  let fty = eq_expand_alias_ty(subst_scope_formals_ty(fty0))
  match fty {
    TyName(n) => if n == "__EqAliasCycle" {
      eq_trap()
    } else if str_array_contains(dtd_eq_type_owners, n) && str_array_contains(known_types, n) {
      // Codex round 17 on #2456: a source-owned spelling takes its declared
      // comparator BEFORE any builtin arm below can claim it. Measured: with
      // `struct Int { value: String }`, an untyped-empty `Array[Int]` filled
      // by name reached the `Int` arm and compared the reference words
      // (`+ 0`), answering `false` for equal content.
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else if str_array_contains(dtd_eq_type_owners, n) {
      // Owned by an alias or an effect: no comparator to call. Fail closed
      // rather than fall to a builtin arm for a name that is not the builtin.
      eq_trap()
    } else if n == "Double" || n == "Float" {
      // Under RC a Double is a BOXED heap value, so a raw `==` between two
      // Double fields compares box identity (always false) instead of the f64
      // payload. Wrap each operand in the identity `Double::to_float` so the
      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and
      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where
      // the wrapper is identity and the float branch compares raw bits (#704).
      EBinOp("==", ECall(builtin_ref("Double::to_float"), Array::slice([lhs], 0, 1), -1), ECall(builtin_ref("Double::to_float"), Array::slice([
        rhs
      ], 0, 1), -1), -1)
    } else if n == "Bytes" {
      // #1526 (ADR-0097): `Bytes` is byte content, not an address — compare it
      // structurally wherever a declared type says Bytes (struct/enum fields,
      // tuple elements, Array[Bytes] elements). `is_scalar_type_name` lists
      // "Bytes", so this must answer before the scalar fallthrough below.
      bytes_eq_needed_record()
      ECall(EIdent(bytes_equals_name(), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else if n == "Int" || n == "Char" {
      // Codex round 6 on #2456: an `Int` slot reached through a generated
      // comparator (an `Option` payload binder, a tuple element, an array
      // element, a generic struct's field) is a bare name codegen cannot
      // classify, so a raw `==` took the generic `eq` builtin -- whose
      // string fallback reads a word with a zero low half as a zero-length
      // string and answered `true` for `64 << 32` vs `65 << 32` (measured on
      // `Option[Int]`, `Box[Int]` and `Array[Option[Int]]`). `x + 0` is the
      // identity on both lanes and marks the operand intish for both
      // classifiers (`expr_is_intish`, `gc_expr_is_intish`), so the compare
      // is a plain i64 equality of the tagged words -- exact. `Bool` and
      // `Unit` need no marker: their words are 0/1-sized, and a bit-different
      // pair can only be `false` vs `true`, which the fallback keeps unequal.
      EBinOp("==", EBinOp("+", lhs, EInt(0), -1), EBinOp("+", rhs, EInt(0), -1), -1)
    } else if eq_name_needs_unmintable_trap(n) {
      // #2851: the arm below emits `<n>::equals` as a reference the LINK
      // resolves against the module that DECLARES `n`. That is sound for a
      // declared struct or enum this statement list cannot see -- some module
      // declares it, so some module mints the body. It is not sound for a name
      // the COMPILER owns: no module declares `HostStream`, so nothing can
      // ever mint `HostStream::equals` and the reference dies unresolved.
      //
      // Measured on `8c966c3`, `struct Holder { s: HostStream }` ALONE --
      // never instantiated, never compared, no `==` in the program -- failed
      // to compile with `unknown name: HostStream::equals`, because the
      // comparator every struct gets walked the field into the arm below.
      // `ByteStream`, `StringBuilder` and `Future[Int]` failed the same way;
      // `Array[Int]` is the control that has a real arm and compiles. That is
      // what makes `wasi-p3-gate`'s `stream_for_proj` probe red on main.
      //
      // The comparator is still SYNTHESIZED, and that matters: #2631/#2634
      // require the body a module emits not to depend on how much of the
      // field's type it can see, so that two modules cannot mint one name for
      // two bodies (`desugar_trait_dicts_module_test` pins it). Only the
      // unmintable leaf changes, and it fails closed -- a `HostStream` has no
      // content to compare, so a comparison that reaches it traps rather than
      // answering by reference.
      eq_trap()
    } else if eq_name_is_invisible_nominal(n) {
      if str_array_contains(dtd_eq_invisible_nominals, n) {
        ()
      } else {
        Array::push(dtd_eq_invisible_nominals, n)
      }
      // #2631: a declared struct or enum this statement list cannot see still
      // gets the STRUCTURAL call, not a raw `==` on an aggregate. The name is
      // the comparator's identity at the link, so the body a module emits must
      // not depend on how much of the field's type that module happens to see
      // -- otherwise two modules mint one name for two bodies and a link that
      // concatenates keeps whichever came first.
      //
      // On the whole-program lane this arm is UNREACHABLE: measured on the
      // compiler's own CLI closure, `invisible_whole=0`, because a program
      // that type-checks whole can see every nominal it compares. It is the
      // per-module lane that reaches it, and there the emitted call is a
      // reference the link resolves against the module that declares the type
      // -- the same shape as any other cross-module call.
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs, -1)
    },
    TyApp("Option", args) => if eq_builtin_head_owned_by_nonenum("Option") {
      eq_for_typed_declared_app(fty, "Option", args, lhs, rhs, known_types)
    } else if Array::length(args) == 1 && !eq_builtin_enum_arm_applies("Option") {
      eq_for_typed_nonstandard_enum("Option", args, lhs, rhs)
    } else if Array::length(args) == 1 {
      let t = Array::get(args, 0)
      let inner_eq = eq_for_typed(t, EIdent("__oeq_l", -1), EIdent("__oeq_r", -1), known_types)
      let some_inner = EMatch(rhs, Array::slice([
        (PCtor("Some", Array::slice([PBind("__oeq_r")], 0, 1)), inner_eq),
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
        (PWild, EBool(false))
      ], 0, 2))
      let none_inner = EMatch(rhs, Array::slice([
        (PCtor("None", array_empty()), EBool(true)),
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Some", Array::slice([PBind("__oeq_l")], 0, 1)), some_inner),
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
        (PCtor("None", array_empty()), none_inner)
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs, -1)
    },
    // `Result` is always a declared enum (#1324) and this arm is ITS
    // comparator: a constructor match over `Ok`/`Err` whose payloads recurse
    // through eq_for_typed (#825 -- an aggregate payload compares by content,
    // which a derived `::equals` does not give). Gated on the declared
    // constructor SHAPE rather than on ownership for that reason (Codex round
    // 3: a `Success`/`Failure` declaration must not meet an `Ok`/`Err` match);
    // `Map` below is ownership-gated, because `__map_equals__` reads runtime
    // map internals that a declared struct does not have.
    TyApp("Result", args) => if eq_builtin_head_owned_by_nonenum("Result") {
      eq_for_typed_declared_app(fty, "Result", args, lhs, rhs, known_types)
    } else if Array::length(args) == 2 && !eq_builtin_enum_arm_applies("Result") {
      eq_for_typed_nonstandard_enum("Result", args, lhs, rhs)
    } else if Array::length(args) == 2 {
      let t = Array::get(args, 0)
      let e = Array::get(args, 1)
      let ok_eq = eq_for_typed(t, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let err_eq = eq_for_typed(e, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let ok_inner = EMatch(rhs, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__req_r")], 0, 1)), ok_eq),
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
        (PWild, EBool(false))
      ], 0, 2))
      let err_inner = EMatch(rhs, Array::slice([
        (PCtor("Err", Array::slice([PBind("__req_r")], 0, 1)), err_eq),
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Ok", Array::slice([PBind("__req_l")], 0, 1)), ok_inner),
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
        (PCtor("Err", Array::slice([PBind("__req_l")], 0, 1)), err_inner)
        // review-lint: allow-fixed-synthetic-name -- existing generated comparator payload binder preserved by the module split
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs, -1)
    },
    TyTuple(ts) => {
      // #1526: binder names carry a per-expansion uid. A NESTED tuple used to
      // rebind the same `__teq_l<j>` names, and the outer elements compared
      // AFTER the nested one then read the clobbered slots on the linear
      // backend (its match-binding reuses the local of a shadowed name — the
      // shadow-clobber bug, filed separately): `((1,[2,3]),"x")` compared its
      // own inner elements against each other and answered false. Unique names
      // make the emitted compare independent of shadowing semantics.
      let uid = eq_tuple_uid_next()
      let lpfx = String::concat(String::concat("__teq_l", idx_str(uid)), "_")
      let rpfx = String::concat(String::concat("__teq_r", idx_str(uid)), "_")
      let n = Array::length(ts)
      let lpats = array_empty()
      let rpats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(lpats, PBind(String::concat(lpfx, idx_str(i))))
        Array::push(rpats, PBind(String::concat(rpfx, idx_str(i))))
        i = i + 1
      }
      let mut conj = EBool(true)
      let mut j = n - 1
      while j >= 0 {
        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(lpfx, idx_str(j)), -1), EIdent(String::concat(rpfx, idx_str(j)), -1), known_types)
        conj = EBinOp("&&", cmp, conj, -1)
        j = j - 1
      }
      let inner = EMatch(rhs, Array::slice([(PTuple(rpats), conj)], 0, 1))
      EMatch(lhs, Array::slice([(PTuple(lpats), inner)], 0, 1))
    },
    TyApp("StringMap", args) => if builtin_string_map_applied("StringMap", args) {
      let value_ty = Array::get(args, 0)
      map_eq_needed_record(TyName("String"), value_ty)
      ECall(EIdent(map_equals_name(TyName("String"), value_ty), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      eq_for_typed_declared_app(fty, "StringMap", args, lhs, rhs, known_types)
    },
    // Codex round 2 on #2456: a source declaration owns the `Map` spelling
    // (#2263, `fixtures/typecheck/map_local_shadow_ok.vibe`). The builtin
    // `__map_equals__` reads its operands as runtime maps, so handing it a
    // program-declared `Map[K, V]` struct read past the value (measured:
    // `memory access out of bounds`). Same ownership rule as StringMap above.
    TyApp("Map", args) => if Array::length(args) == 2 && !str_array_contains(dtd_eq_type_owners, "Map") {
      // #2218: the only site that builds a `__map_equals__` call.
      map_eq_needed_record(Array::get(args, 0), Array::get(args, 1))
      ECall(EIdent(map_equals_name(Array::get(args, 0), Array::get(args, 1)), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      eq_for_typed_declared_app(fty, "Map", args, lhs, rhs, known_types)
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      // #1526: the second (and last) site that references a helper.
      // #2141: the entry re-spelling above already marked any in-scope formal
      // in this element type.
      arr_eq_needed_record(Array::get(args, 0))
      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs, -1)
    },
    TyApp(n, args) => eq_for_typed_declared_app(fty, n, args, lhs, rhs, known_types),
    _ => EBinOp("==", lhs, rhs, -1)
  }
}

/// Codex rounds 3-7 on #2456: a source-owned generic ENUM -- a `Result` /
/// `Option` declared with constructors other than the special arm's shape,
/// an `enum Map[K, V]`, any `enum Wrap[T]`.
///
/// #2467: a concrete instantiation gets a comparator specialized with its
/// arguments, exactly as a generic struct does (#2195, `gen_specialized_eq_fn`):
/// `Wrap::equals__<key>` substitutes the arguments into every payload and
/// compares each through `eq_for_typed`, so `Wrap[Int]` compares its `Int`
/// payload exactly (the derived `Wrap::equals` read it through the erased
/// `==`, where `64 << 32` and `65 << 32` compared equal -- #2457 row 4) and
/// `Wrap[Array[Int]]` compares by content where the derived comparator
/// compared by reference. What stays on the derived `::equals`: a program's
/// own `::equals` for exactly this instantiation (rounds 11-16), and an
/// instantiation whose argument is a FORMAL of an enclosing binder, which is
/// admitted only when no payload reads a formal (a phantom parameter, round
/// 7) -- there is nothing concrete to specialize on. Everything else fails
/// closed, as does a non-regular recursion whose specializations never
/// close (`generic_eq_is_expanding_recursion`).
fn eq_for_typed_nonstandard_enum(head: String, args: Array[TypeExpr], lhs: Expr, rhs: Expr) -> Expr {
  let fail_closed = eq_trap()
  if eq_has_explicit_equals(head) {
    if eq_explicit_equals_matches(head, args) {
      ECall(EIdent(qualified_name(head, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      fail_closed
    }
  } else if eq_ty_has_formal(TyApp(head, args)) {
    if eq_generic_enum_payloads_concrete_comparable(head) {
      ECall(EIdent(qualified_name(head, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
    } else {
      fail_closed
    }
  } else {
    let canonical_args = for arg in args {
      eq_expand_alias_ty(arg)
    }
    if generic_eq_is_expanding_recursion(head, canonical_args) {
      fail_closed
    } else {
      generic_eq_record(head, canonical_args)
      ECall(EIdent(generic_eq_name(head, canonical_args), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    }
  }
}

/// The declared-type dispatch of `eq_for_typed` for an applied head: a
/// generic struct's per-instantiation comparator, else a declared name's
/// `::equals`, else the raw binop. Also the fallback of every builtin-head
/// arm above whose spelling a source declaration owns (Codex round 2 on
/// #2456), so a program-declared `Map` / `StringMap` is compared by ITS
/// comparator and never by the builtin's.
export fn eq_for_typed_declared_app(fty: TypeExpr, n: String, args: Array[TypeExpr], lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  if eq_generic_enum_declared(n) && Array::length(args) > 0 {
    // A source-owned generic ENUM (`enum Map[K, V] { Entry(K, V) }`, or any
    // `enum Wrap[T]`): a concrete instantiation takes its specialized
    // comparator (#2467), the rest is decided in eq_for_typed_nonstandard_enum.
    eq_for_typed_nonstandard_enum(n, args, lhs, rhs)
  } else if generic_eq_struct_declared(n) && Array::length(args) > 0 && !eq_ty_has_formal(fty) {
    let canonical_args = for arg in args {
      eq_expand_alias_ty(arg)
    }
    if generic_eq_is_expanding_recursion(n, canonical_args) {
      eq_trap()
    } else {
      generic_eq_record(n, canonical_args)
      ECall(EIdent(generic_eq_name(n, canonical_args), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    }
  } else if str_array_contains(known_types, n) {
    ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([lhs, rhs], 0, 2), -1)
  } else {
    // #2634: the `TyApp` twin of the `TyName` fallthrough this pass records
    // above -- a GENERIC HEAD the statement list cannot see, declining
    // silently. Recorded with a `[]` suffix so the two are distinguishable.
    //
    // Not recording it is what made `MutMap[String, Int]` look like a
    // different mechanism from `PerceusActionKind`: both are `opaque` in a
    // `.vpkg` contract and concrete in a sibling implementation, but only the
    // non-generic one reached a recorder, so `invisible_split` listed one and
    // not the other and the two sets looked disjoint. A measurement that
    // covers one arm of a dispatch reports the arm it does not cover as
    // absence.
    if eq_name_is_invisible_nominal(n) && !eq_name_needs_unmintable_trap(n) && !str_array_contains(dtd_eq_invisible_nominals, String::concat(n, "[]")) {
      Array::push(dtd_eq_invisible_nominals, String::concat(n, "[]"))
    } else {
      ()
    }
    eq_deferred_request_record_ty(eq_deferred_key_for_ty(fty), fty)
    // #2634: emit the REFERENCE, and let the link mint the definition.
    //
    // This is the `TyApp` counterpart of #2631's fix, and it needed the link's
    // minting step to exist first. #2631 could emit `n::equals` because that
    // comparator already existed under that name; a generic instantiation's
    // comparator is a SPECIALIZATION whose body this module cannot generate --
    // it would need the head's fields, which is exactly what it cannot see. So
    // the deferral above and this reference are two halves of one move: the
    // module says what it needs, the link builds it from the concatenated
    // program.
    //
    // The raw `==` this replaces compared an AGGREGATE BY REFERENCE, measured
    // on the compiler's own closure as `(a.idx == b.idx)` where the whole
    // program emitted `MutMap::equals__N6_String__N3_Int(a.idx, b.idx)`. Same
    // name, two bodies -- the invariant a synthesized definition's name must
    // determine its body, failing at a site #2631's fix did not reach.
    //
    // Unreachable on the whole-program lane (`invisible_whole=0` measured at
    // this arm), so the rule is unconditional rather than lane-dependent.
    //
    // Guarded by the SAME predicate that decides whether to record, and the
    // gate is why. The first cut guarded only on `args` being non-empty, so a
    // marked FORMAL head applied to arguments (`__Vfp_F[Int]`) emitted
    // `__Vfp_F::equals__N3_Int` -- a name nothing binds, which reached codegen
    // as an internal compiler error on
    // `fixtures/typecheck/formal_application_struct_field_reject.vibe`. A
    // formal has no declaration to be invisible TO, so it must not take this
    // arm; recording and emitting have to agree about that or the reference is
    // minted for something the link cannot build either.
    if eq_name_needs_unmintable_trap(n) {
      // #2851, the `TyApp` twin. The paragraph above records that a marked
      // FORMAL head applied to arguments emitted `__Vfp_F::equals__N3_Int` --
      // "a name nothing binds, which reached codegen as an internal compiler
      // error" -- and that recording and emitting must agree about excluding
      // it. A head the COMPILER owns is the same case for the same reason: no
      // module declares `Future`, so no link can mint
      // `Future::equals__N3_Int`. Measured on `8c966c3`, `struct Holder { s:
      // Future[Int] }` alone failed to compile with exactly that name.
      //
      // `eq_trap()` rather than the raw `==` below, because falling through
      // would compare the aggregate BY REFERENCE -- the silent answer this
      // whole area exists to keep out, and worse than the trap.
      eq_trap()
    } else if eq_name_is_invisible_nominal(n) && Array::length(args) > 0 {
      let canonical_args = for arg in args {
        eq_expand_alias_ty(arg)
      }
      ECall(EIdent(generic_eq_name(n, canonical_args), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs, -1)
    }
  }
}
