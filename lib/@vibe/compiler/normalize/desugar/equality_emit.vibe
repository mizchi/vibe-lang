// Equality emit.

import @vibe/compiler/core {
  Stmt
}

import ./collection_equality_generation.vibe {
  emit_recorded_arr_equals, emit_recorded_map_equals
}

import ./derive_operations.vibe {
  top_level_fn_names
}

import ./equality_generation.vibe {
  emit_recorded_generic_eq
}

import ./state.vibe {
  dtd_arr_eq_needed, dtd_eq_specializations, dtd_map_eq_needed
}

export fn emit_recorded_structural_eq(_ stmts: Array[Stmt]) -> Unit {
  // Every recorded helper is emitted only when the program does not define it
  // yet. One set of the program's names answers that for all three emitters
  // and every round; each adds the helpers it appends, and nothing else
  // writes `stmts` in this loop (#3900).
  let defined = top_level_fn_names(stmts)
  let mut prev_arrays = 0 - 1
  let mut prev_maps = 0 - 1
  let mut prev_generics = 0 - 1
  while prev_arrays != Array::length(dtd_arr_eq_needed) || prev_maps != Array::length(dtd_map_eq_needed) || prev_generics != Array::length(dtd_eq_specializations) {
    prev_arrays = Array::length(dtd_arr_eq_needed)
    prev_maps = Array::length(dtd_map_eq_needed)
    prev_generics = Array::length(dtd_eq_specializations)
    emit_recorded_arr_equals(stmts = stmts, defined = defined)
    emit_recorded_map_equals(stmts = stmts, defined = defined)
    emit_recorded_generic_eq(stmts = stmts, defined = defined)
  }
}
