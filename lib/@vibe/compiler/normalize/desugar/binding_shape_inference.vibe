fn array_elem_bind_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  // #1880: an explicit `Array[T]` annotation is the most reliable element type
  // there is, so it is consulted before the value's shape. `array_elem_key` is
  // the older sentinel -- `shape_bind_into` runs after this and its record wins
  // for rendering -- but this one is read by call-site dict synthesis (#1199),
  // so an annotated binding has to reach it too.
  match dtd_array_elem_of_ann_opt(dtd_ascribed_type(val)) {
    Some(elem) => Array::push(out, (array_elem_key(name), elem)),
    None => array_elem_bind_by_shape_into(out, name, val, struct_sets, fn_returns)
  }
}

fn array_elem_bind_by_shape_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  match val {
    EArray(elems) => if Array::length(elems) > 0 {
      match infer_arg_type_name(Array::get(elems, 0), struct_sets, out, fn_returns) {
        Some(elemty) => Array::push(out, (array_elem_key(name), elemty)),
        None => mask_stale_array_elem_into(out, name)
      }
    } else {
      mask_stale_array_elem_into(out, name)
    },
    _ => mask_stale_array_elem_into(out, name)
  }
}

/// #1445: record a let-bound TUPLE literal's shape. Sibling of
/// `array_elem_bind` -- same "only a bare literal RHS" scope, for the same
/// reason (this is a syntax-directed pass, not type inference).
fn tuple_shape_bind_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  // #2128: an explicit `(A, B)` annotation is the most reliable element list
  // there is -- the same reason `array_elem_bind_into` consults one first
  // (#1880). A local `let t: (String, String) = (..)` is NOT annotation-free:
  // the parser rewrites it to `((__asc: T) -> __asc)(v)`, which also hides the
  // `ETuple` from the match below, so before this an annotated tuple recorded
  // NOTHING and `t.0 < t.1` stayed an address comparison.
  match dtd_tuple_elem_names_of_ann(dtd_ascribed_type(val)) {
    Some(sentinel) => Array::push(out, (tuple_shape_key(name), sentinel)),
    None => {
      // #2128: `let p = Array::get(ps, i)` where `ps` is an array OF tuples.
      // `infer_shape` does not project an array element, so `shape_bind_into`
      // records a non-composite shape for `p` and `p.0` had nothing to read.
      // The element types are in the ARRAY's own `__shape$` record.
      let from_elem = dtd_tuple_elem_names_of_array_get(val, out)
      if String::length(from_elem) > 0 {
        Array::push(out, (tuple_shape_key(name), from_elem))
      } else {
        match val {
          ETuple(items) => if Array::length(items) > 0 {
            let mut acc = ""
            let mut i = 0
            while i < Array::length(items) {
              let tn = match infer_arg_type_name(Array::get(items, i), struct_sets, out, fn_returns) {
                Some(t) => t,
                None => ""
              }
              acc = if i == 0 {
                tn
              } else {
                String::concat(acc, String::concat(",", tn))
              }
              i = i + 1
            }
            Array::push(out, (tuple_shape_key(name), acc))
          } else {
            ()
          },
          _ => ()
        }
      }
    }
  }
}

/// #1445: record a let-bound `Some(e)` / `Ok(e)` / `Err(e)`'s payload type, so
/// a later `match` on that variable can type its binder. The parameter-side
/// counterpart lives in `seed_var_types`, which has a real `TypeExpr`
/// (`Option[P]`) to read the payload off.
fn ctor_payload_bind_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  match val {
    ECall(callee, cargs, _, _) => match callee {
      EIdent(cn, _) => if Array::length(cargs) >= 1 && starts_upper(cn) {
        // Every payload shape is read off the environment BEFORE any payload
        // key is appended, exactly as the chained form read them off its
        // input, so a later slot cannot observe an earlier slot's record.
        let shapes = empty_str_array()
        let mut i = 0
        while i < Array::length(cargs) {
          Array::push(shapes, infer_shape(Array::get(cargs, i), struct_sets, out, fn_returns))
          i = i + 1
        }
        i = 0
        while i < Array::length(cargs) {
          let sh = Array::get(shapes, i)
          if String::length(sh) == 0 {
            ()
          } else {
            // Arity 1 keeps the plain key, so the `Option`/`Result` entries
            // seed_var_types writes from a real TypeExpr stay interchangeable
            // with these.
            let key = if Array::length(cargs) == 1 {
              ctor_payload_key(name, cn)
            } else {
              ctor_payload_idx_key(name, cn, i)
            }
            Array::push(out, (key, sh))
          }
          i = i + 1
        }
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
}

/// The shape of an expression, as deep as this syntax-directed pass can see.
/// A literal tuple/array recurses; a NAME resolves through whatever the
/// binding site recorded for it (its own shape first, then the older
/// per-element / per-tuple sentinels, so a value bound before this function
/// existed still resolves); anything else falls back to the head type name.
export fn infer_shape(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  // #1880: an ANNOTATION outranks anything guessed from the value's syntax.
  //
  // Everything below infers a shape from the shape of the expression, so only
  // a value written literally at the binding site ever produced one. An array
  // that came out of a builtin callsite lowering (`Array::map`, `Array::slice`)
  // or out of `for x in ..` produced "" -- and shape_bind ALWAYS records, with
  // "" meaning "not composite, stop". So `"\{ys}"` printed the raw heap
  // pointer, and `let ys: Array[Int] = ..` did not help: the annotation was
  // never consulted. No spelling a user could write produced correct output,
  // which is what made it P0 rather than imprecision.
  //
  // The annotation is in the AST even for a LOCAL let -- `ELet` has no
  // annotation field, but the parser rewrites `let x: T = v` into
  // `((__asc: T) -> __asc)(v)` (ascribe_wrap). `ty_to_eq_shape` renders a
  // TypeExpr into exactly the encoding this function produces (`Array[Int]` ->
  // "[Int]", same as the literal path), so the two answers are interchangeable
  // and everything downstream is unchanged.
  //
  // `interp_shape` is REQUIRED here, not decoration. `ty_to_eq_shape` speaks
  // equality's grammar, which is a strict superset of the renderer's: it also
  // emits `{o:..}` / `{r:..}` for Option / Result. `interp_expand_shape`
  // distinguishes only tuples (leading `(`) and treats every other composite as
  // an ARRAY, so letting a `{o:Int}` through would emit `Array::length` /
  // `Array::get` against an Option -- a trap or a wrong render, i.e. a worse
  // version of the bug being fixed. `interp_shape` admits only the tuple and
  // array forms the renderer can expand. (Codex review on this PR.)
  //
  // A shape it rejects falls THROUGH to the syntax path rather than becoming
  // "": an annotated `let p: Point = mk()` must still reach the head name that
  // `interp_show_target` dispatches `Point::to_string` on. So this is strictly
  // additive -- no annotated binding renders worse than it did.
  //
  // Option / Result annotations therefore keep today's rendering. Making those
  // work means teaching interp_expand_shape their encodings, which is a
  // separate change.
  match dtd_ascribed_type(e) {
    Some(ann) => {
      let sh = interp_shape(ty_to_eq_shape(ann))
      if String::length(sh) > 0 {
        sh
      } else {
        infer_shape_by_syntax(e, struct_sets, var_types, fn_returns)
      }
    },
    None => infer_shape_by_syntax(e, struct_sets, var_types, fn_returns)
  }
}

/// #1880: Array builtins that RETURN an array whose element type is their first
/// argument's, so the shape propagates without any inference.
///
/// Two exclusions, both deliberate:
///
///   - `Array::map` -- its element type is the CALLBACK's return type, not the
///     argument's, so reusing the argument's shape would render confidently and
///     wrongly. Worse than saying nothing. An annotation covers it.
///   - `Array::truncate` -- it MUTATES its first argument and returns Unit
///     (`declare Array::truncate(Array[T], Int) -> Unit`, builtins/
///     declarations.vibe:35). Giving it `[T]` would rewrite the render into
///     array operations against a Unit. It was in this list until a Codex
///     review on this PR caught it; "takes an array first" is not the
///     predicate, "returns that array's element type" is.
///
/// Returns "" for "no answer", which the caller treats as fall-through. The
/// `[` guard keeps a non-array first argument (a user binding of the same
/// spelling that reached here, a wrong-arity call) from being reported as an
/// array shape.
export fn dtd_elem_preserving_shape(fname: String, cargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  // #3080: `xs[a:b]` parses to `__slice(xs, a, b)`, the same operation as
  // `Array::slice` on an array subject, but only the spelled-out call was
  // listed, so the slice syntax resolved no shape and its render printed a
  // heap address. The `[` guard below keeps a `String` / `Bytes` subject out.
  // It is NOT added to `dtd_names_an_array_builtin`: `__slice` also slices
  // strings, so an unresolved one is not known to be an array.
  let preserves = fname == "Array::filter" || fname == "Array::slice" || fname == "__slice" || fname == "Array::reverse" || fname == "Array::concat"
  if preserves && Array::length(cargs) >= 1 {
    let sh = infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns)
    if String::starts_with(sh, "[") {
      sh
    } else {
      ""
    }
  } else {
    ""
  }
}

/// #2128: `Array::get(xs, i)` / `xs[i]` -> the shape of the array's ELEMENT.
///
/// The sibling of `dtd_elem_preserving_shape`: that one answers for calls whose
/// result is another array of the same element (`filter`, `slice`, `reverse`,
/// `concat`), this one for the call that takes an element OUT. Without it a
/// binding of an array read recorded "" -- "not composite, stop" -- which is
/// why two container hops (`Array[Array[(String, String)]]`) fell back to an
/// address comparison: the outer name's shape was one level too deep to be read
/// and the inner name had no shape at all.
///
/// One hop per call, so it composes: each `Array::get` peels one `[..]`, and a
/// chain of them peels a chain. Nothing here walks a chain itself.
fn dtd_elem_projecting_shape(fname: String, cargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let projects = fname == "Array::get" || fname == "__index"
  if projects && Array::length(cargs) == 2 {
    let sh = infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns)
    if String::starts_with(sh, "[") {
      shape_inner(sh)
    } else {
      ""
    }
  } else {
    ""
  }
}

fn infer_shape_by_syntax(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match e {
    ETuple(items) => if Array::length(items) == 0 {
      ""
    } else {
      let mut acc = "("
      let mut i = 0
      while i < Array::length(items) {
        let sub = infer_item_shape(Array::get(items, i), struct_sets, var_types, fn_returns)
        acc = if i == 0 {
          String::concat(acc, sub)
        } else {
          String::concat(acc, String::concat(",", sub))
        }
        i = i + 1
      }
      String::concat(acc, ")")
    },
    // #3007: a `derive (Show)` generic struct literal. Its arguments come from
    // the explicit `Box[..]::{ }` list, else from a field whose declared type
    // is exactly the formal. A formal neither answers leaves the literal
    // unclaimed, which is what it was before.
    ERecord(rname, rfields, rtargs) => match show_generic_struct_decl(rname) {
      Some((_, formals, dfields)) => {
        let mut acc = String::concat("{g:", rname)
        let mut ok = true
        let mut ti = 0
        while ti < Array::length(formals) {
          let arg_sh = if Array::length(rtargs) == Array::length(formals) {
            ty_to_eq_shape(Array::get(rtargs, ti))
          } else {
            record_formal_shape(Array::get(formals, ti), dfields, rfields, struct_sets, var_types, fn_returns)
          }
          if String::length(arg_sh) == 0 {
            ok = false
          } else {
            ()
          }
          acc = String::concat(acc, String::concat(",", arg_sh))
          ti = ti + 1
        }
        if ok {
          String::concat(acc, "}")
        } else {
          rname
        }
      },
      None => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
        Some(t) => t,
        None => ""
      }
    },
    // The first element stands for all of them: this pass has no unifier, and
    // a heterogeneous array literal does not type-check anyway.
    // #3066: except when the first element says nothing about the payload --
    // a `None` (head `Option`, no payload) or an element this pass cannot
    // type -- and a later one does: `[None, Some(true)]` is an
    // `Array[Option[Bool]]`, and reading only the `None` rendered the `true`
    // through the pointer heuristic as `1`. Every element has the same type
    // (the checker rejects anything else), so the first COMPOSITE shape is
    // the element type. The scan runs only for those two heads, so a large
    // literal of scalars costs what it did.
    EArray(items) => if Array::length(items) == 0 {
      ""
    } else {
      let first = infer_item_shape(Array::get(items, 0), struct_sets, var_types, fn_returns)
      let mut best = first
      if String::length(first) == 0 || first == "Option" {
        let mut i = 1
        while i < Array::length(items) && !shape_is_composite(best) {
          let later = infer_item_shape(Array::get(items, i), struct_sets, var_types, fn_returns)
          if shape_is_composite(later) {
            best = later
          } else {
            ()
          }
          i = i + 1
        }
      } else {
        ()
      }
      String::concat("[", String::concat(best, "]"))
    },
    // #1880: `for x in xs { .. }` is an EXPRESSION that evaluates to the mapped
    // array, and it was the single most common way to reach the bug -- the
    // form `fixtures/for_in_*.vibe` are written in, and the one place an
    // annotation cannot be attached because the value is rendered inline
    // (`"\{for x in xs { .. }}"`).
    //
    // The element type is the BODY's, with the loop variable bound to the
    // source's element type. Both halves come from this same function, so a
    // source whose shape is unknown, or a body this pass cannot type, yields
    // "" and nothing is claimed.
    EForIn(vname, kname, iter, body) => {
      let src = infer_shape(iter, struct_sets, var_types, fn_returns)
      if String::starts_with(src, "[") {
        let elem = shape_inner(src)
        let with_v = extend_var_types(var_types, vname, Some(elem))
        // `for x, i in xs` binds the index too, and a body that uses it is
        // exactly the `fixtures/for_in_index_test.vibe` shape.
        let inner_vars = match kname {
          Some(k) => extend_var_types(with_v, k, Some("Int")),
          None => with_v
        }
        let bsh = infer_shape(body, struct_sets, inner_vars, fn_returns)
        let resolved = if String::length(bsh) > 0 {
          bsh
        } else {
          dtd_scalar_shape(body, inner_vars)
        }
        if String::length(resolved) > 0 {
          String::concat("[", String::concat(resolved, "]"))
        } else {
          ""
        }
      } else {
        ""
      }
    },
    EIdent(n, _) => match lookup_var_type(var_types, shape_key(n)) {
      // Same rule as interp_expand's: a recorded empty is an answer ("not
      // composite"), so fall through to the head name rather than to the
      // older sentinels.
      Some(sh) => if String::length(sh) == 0 {
        match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
          Some(t) => t,
          None => ""
        }
      } else {
        sh
      },
      None => match lookup_var_type(var_types, tuple_shape_key(n)) {
        Some(sentinel) => String::concat("(", String::concat(sentinel, ")")),
        None => match array_elem_type_of(var_types, n) {
          Some(elem) => String::concat("[", String::concat(elem, "]")),
          // #3074: a PARAMETER annotated with a `derive (Show)` generic type
          // (`k: G[Bool]`) records its instantiation only as its equality
          // shape; without reading it the render fell to the erased renderer.
          // #3083: a tuple parameter (`t: (Int, String)`) likewise: its
          // annotation is recorded only there, so the render reached codegen
          // unexpanded, where #2987 refuses it.
          None => match lookup_var_type(var_types, eq_shape_key(n)) {
            Some(esh) => if (String::starts_with(esh, "{g:") || String::starts_with(esh, "(")) && String::length(interp_shape(esh)) > 0 {
              esh
            } else {
              match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
                Some(t) => t,
                None => ""
              }
            },
            None => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
              Some(t) => t,
              None => ""
            }
          }
        }
      }
    },
    // #3066: `Some(x)` describes its own type, `Option[<x's type>]`. With no
    // arm here it answered the bare head `Option`, so the payload of a NESTED
    // literal was rendered by the pointer heuristic: `Some(Some(false))`
    // printed `Some(Some(0))`, `[Some(true)]` printed `[Some(1)]`, and
    // `[Some([1]), None]` printed an address. Equality's `infer_eq_shape`
    // already spells the same encoding. A payload this pass cannot type keeps
    // the old answer (the head), never a guessed shape.
    // #3074: a `derive (Show)` generic enum constructor describes its own
    // instantiation the same way, `GA(true)` -> `{g:G,Bool}`.
    ECall(callee, cargs, _, _) => match callee {
      EIdent(fname, _) => if (fname == "Some" || fname == "Option::Some") && Array::length(cargs) == 1 && String::length(infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns)) > 0 {
        String::concat("{o:", String::concat(infer_shape(Array::get(cargs, 0), struct_sets, var_types, fn_returns), "}"))
      } else if String::length(show_generic_enum_ctor_shape(fname, cargs, struct_sets, var_types, fn_returns)) > 0 {
        show_generic_enum_ctor_shape(fname, cargs, struct_sets, var_types, fn_returns)
      } else match lookup_var_type(var_types, eq_shape_key(fname)) {
        Some(sh) => interp_shape(sh),
        None => match fn_return_type(fn_returns, fn_eq_shape_key(fname)) {
          Some(sh) => interp_shape(sh),
          None => {
            // #1880: checked AFTER the two lookups above, so a user binding
            // with one of these names still wins.
            let preserved = dtd_elem_preserving_shape(fname, cargs, struct_sets, var_types, fn_returns)
            let projected = if String::length(preserved) > 0 {
              ""
            } else {
              dtd_elem_projecting_shape(fname, cargs, struct_sets, var_types, fn_returns)
            }
            // #2912: the third source, after the two that read an argument's
            // shape. `Array::map` is deliberately absent from both -- its
            // element type comes from the callback -- so without this the call
            // resolved to nothing and `__to_string` fell through to the
            // string-pointer heuristic, printing a heap address.
            let mapped = if String::length(preserved) > 0 || String::length(projected) > 0 {
              ""
            } else {
              dtd_map_callback_shape(fname, cargs)
            }
            if String::length(preserved) > 0 {
              preserved
            } else if String::length(projected) > 0 {
              projected
            } else if String::length(mapped) > 0 {
              mapped
            } else {
              match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
                Some(t) => t,
                None => ""
              }
            }
          }
        }
      },
      _ => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
        Some(t) => t,
        None => ""
      }
    },
    // #3088: a field declared as a `derive (Show)` generic at concrete
    // arguments (`o.b` with `b: Box[Bool]`) describes its instantiation.
    EDot(dobj, dfield, _, _) => {
      let fsh = dtd_field_generic_shape(dobj, dfield, struct_sets, var_types, fn_returns)
      if String::length(fsh) > 0 {
        fsh
      } else {
        match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
          Some(t) => t,
          None => ""
        }
      }
    },
    _ => match infer_arg_type_name(e, struct_sets, var_types, fn_returns) {
      Some(t) => t,
      None => ""
    }
  }
}

/// #3008: the type arguments of a generic struct literal written without
/// them, or None when any formal is not read off a field declared exactly that
/// formal.
export fn generic_record_inferred_args(name: String, rfields: Array[(String, Expr)], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Array[TypeExpr]] {
  let mut out: Option[Array[TypeExpr]] = None
  let mut i = 0
  while i < Array::length(dtd_eq_generic_structs) {
    let decl = Array::get(dtd_eq_generic_structs, i)
    if decl.0 == name {
      let args = empty_type_exprs()
      let mut ok = true
      let mut fi = 0
      while fi < Array::length(decl.1) {
        let sh = record_formal_shape(Array::get(decl.1, fi), decl.2, rfields, struct_sets, var_types, fn_returns)
        if String::length(sh) == 0 {
          ok = false
        } else {
          Array::push(args, shape_to_eq_ty(sh))
        }
        fi = fi + 1
      }
      out = if ok {
        Some(args)
      } else {
        None
      }
      i = Array::length(dtd_eq_generic_structs)
    } else {
      i = i + 1
    }
  }
  out
}

/// #3007: the shape of formal `f` in a generic struct literal, read from the
/// first field declared exactly `f`, or "".
fn record_formal_shape(f: String, dfields: Array[(String, TypeExpr)], rfields: Array[(String, Expr)], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(dfields) && String::length(out) == 0 {
    let (dname, dty) = Array::get(dfields, i)
    match dty {
      TyName(tn) => if tn == f {
        let mut j = 0
        while j < Array::length(rfields) {
          let (rn, rv) = Array::get(rfields, j)
          if rn == dname {
            out = infer_shape(rv, struct_sets, var_types, fn_returns)
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Record a binding's recursive shape, when there is one worth recording. A
/// plain name adds nothing the existing entries do not already carry, so only
/// composites are stored.
fn shape_bind_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  let sh = infer_shape(val, struct_sets, out, fn_returns)
  // ALWAYS record, even for a non-composite binding (recording ""). Skipping
  // those would leave a SHADOWED name's old shape as the live answer:
  // `extend_var_types` appends and `lookup_var_type` returns the LAST match
  // (#760(4)), but `__shape$x` is a different KEY from `x`, so rebinding `x`
  // never overwrote it. Measured before this: `let x = (1, 2); let x = 3;
  // "\{x}"` printed `(0, 0)`, and the array case printed `[]` -- silently
  // wrong output, no trap (Codex review on PR #1465).
  //
  // The empty entry is not just "no shape": interp_expand treats a RECORDED
  // empty as "this binding is not composite, stop" rather than falling
  // through to the older per-tuple / per-element sentinels, which have the
  // same staleness and which this pass does not rewrite (they are read by
  // call-site dict synthesis too, so appending empties there would change
  // #1199's behaviour).
  Array::push(out, (shape_key(name), sh))
}

/// #1445: every binding-site shape record, applied in one place so `ELet` and
/// `ELetMut` cannot drift apart.
export fn bind_shapes(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let out = clone_var_types(var_types)
  bind_shapes_into(out, name, val, struct_sets, fn_returns)
  out
}

/// The four records appended in place. `out` is a private copy of the
/// environment the binding extends; each stage reads `out` as it stands, which
/// is exactly the environment the previous stage returned when every stage
/// cloned for itself (#2386: those copies were up to six per `let`, all but
/// the first redundant).
export fn bind_shapes_into(out: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Unit {
  array_elem_bind_into(out, name, val, struct_sets, fn_returns)
  tuple_shape_bind_into(out, name, val, struct_sets, fn_returns)
  ctor_payload_bind_into(out, name, val, struct_sets, fn_returns)
  // LAST: infer_shape reads the sentinels the three above just wrote, so a
  // binding whose elements are themselves named bindings resolves in one pass.
  shape_bind_into(out, name, val, struct_sets, fn_returns)
}

/// #3088: the `{g:G,..}` shape of `obj.field` when the field's declared type is
/// a `derive (Show)` generic at concrete arguments, or "". The receiver is a
/// non-generic struct (`o.b` with `b: Box[Bool]`), or a generic one whose
/// instantiation this pass already knows (its `{g:` shape), whose arguments
/// are substituted into the field type.
///
/// The checker files no render row for such a projection (measured: the
/// program's rows held the neighbouring `k()` argument's and none at the
/// field's offset), so the render fell to the refusal a type annotation
/// avoids. The declared type answers it exactly. Only a generic Show type is
/// answered: an `Array` or tuple field keeps reaching codegen, where #2987's
/// refusal is what its gate row pins.
fn dtd_field_generic_shape(obj: Expr, field: String, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  // A program with no generic Show type (the compiler's own closure, for one)
  // pays nothing for this per-projection question.
  if Array::length(dtd_show_generic_structs) == 0 && Array::length(dtd_show_generic_enums) == 0 {
    ""
  } else {
    dtd_field_generic_shape_scan(obj, field, struct_sets, var_types, fn_returns)
  }
}

fn dtd_field_generic_shape_scan(obj: Expr, field: String, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let recv_sh = interp_shape(infer_shape(obj, struct_sets, var_types, fn_returns))
  let recv_head = if String::starts_with(recv_sh, "{g:") {
    generic_shape_head(recv_sh)
  } else {
    match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {
      Some(h) => h,
      None => ""
    }
  }
  let mut out = ""
  let mut i = 0
  while i < Array::length(dtd_struct_field_decls) {
    let (sname, formals, fields) = Array::get(dtd_struct_field_decls, i)
    if sname == recv_head && !formal_in_scope(sname) {
      let targs = empty_type_exprs()
      if String::starts_with(recv_sh, "{g:") {
        let gparts = shape_split(String::substring(recv_sh, 3, String::length(recv_sh) - 1))
        let mut ai = 1
        while ai < Array::length(gparts) {
          Array::push(targs, shape_to_eq_ty(Array::get(gparts, ai)))
          ai = ai + 1
        }
      } else {
        ()
      }
      if Array::length(targs) == Array::length(formals) {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fty) = Array::get(fields, fi)
          if fname == field {
            let sh = ty_to_eq_shape(eq_subst_ty(fty, formals, targs))
            out = if String::starts_with(sh, "{g:") && show_generic_known(generic_shape_head(sh)) {
              sh
            } else {
              ""
            }
          } else {
            ()
          }
          fi = fi + 1
        }
      } else {
        ()
      }
      i = Array::length(dtd_struct_field_decls)
    } else {
      i = i + 1
    }
  }
  out
}

/// #3074: the `{g:G,..}` shape of a generic enum constructor call written
/// without type arguments, reading each formal off a payload declared exactly
/// that formal. "" when this is not such a call or a formal is not answered.
fn show_generic_enum_ctor_shape(fname: String, cargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  match show_generic_enum_ctor(fname) {
    Some((ename, formals, ptys)) => if Array::length(ptys) != Array::length(cargs) {
      ""
    } else {
      let mut acc = String::concat("{g:", ename)
      let mut ok = true
      let mut fi = 0
      while fi < Array::length(formals) && ok {
        let f = Array::get(formals, fi)
        let mut sh = ""
        let mut pi = 0
        while pi < Array::length(ptys) && String::length(sh) == 0 {
          match Array::get(ptys, pi) {
            TyName(tn) => if tn == f {
              sh = infer_shape(Array::get(cargs, pi), struct_sets, var_types, fn_returns)
            } else {
              ()
            },
            _ => ()
          }
          pi = pi + 1
        }
        if String::length(sh) == 0 {
          ok = false
        } else {
          acc = String::concat(acc, String::concat(",", sh))
        }
        fi = fi + 1
      }
      if ok {
        String::concat(acc, "}")
      } else {
        ""
      }
    },
    None => ""
  }
}

export fn infer_item_shape(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {
  let typed = dtd_typed_item_shape_for(e)
  if String::length(typed) > 0 {
    typed
  } else {
    infer_shape(e, struct_sets, var_types, fn_returns)
  }
}
