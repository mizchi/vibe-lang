// Function returns.

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr, __to_string, collect_top_level_fn_alias_renames, sort_perm_by_names
}

import @vibe/core {
  array_empty, struct MutMap
}

import ./binding_shape_inference.vibe {
  infer_shape
}

import ./binding_shape_queries.vibe {
  shape_is_composite
}

import ./callable_names.vibe {
  receiver_alias_key
}

import ./typed_row_queries.vibe {
  dtd_is_own_index
}

import ./equality_shape_queries.vibe {
  fn_eq_shape_key
}

import ./equality_type_shapes.vibe {
  ty_to_eq_shape
}

import ./formal_scope.vibe {
  mark_formal_name
}

import ./type_name_occurrences.vibe {
  ty_mentions_name_in
}

import ./type_names.vibe {
  collect_fn_impl_return_key, collect_fn_return_marker, collect_struct_field_types, fn_body_tail_expr, fn_return_head_of, type_alias_key
}

import ./utilities.vibe {
  str_array_contains
}

fn collect_fn_eq_return_shape(out: Array[(String, String)], fname: String, tparams: Array[String], ret: Option[TypeExpr], fbody: Expr) -> Unit {
  let sh = match ret {
    Some(rt) => if ty_mentions_name_in(t = rt, names = tparams) {
      ""
    } else {
      ty_to_eq_shape(rt)
    },
    None => if Array::length(tparams) > 0 {
      ""
    } else {
      infer_shape(e = fn_body_tail_expr(fbody), struct_sets = array_empty(), var_types = array_empty(), fn_returns = out)
    }
  }
  if shape_is_composite(sh) {
    Array::push(out, value = (fn_eq_shape_key(fname), sh))
  } else {
    ()
  }
}

export fn collect_fn_returns(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(tparams, _, fparams, ret, _, fbody) => {
          // #2141: a return head naming the fn's OWN formal is an erased
          // value at every call site -- record it re-spelled so a same-spelled
          // (merged-in) declared type can never claim the call's result for
          // struct dispatch or a struct renderer (see subst_formals_ty).
          let head = fn_return_head_of(ret = ret, body = fbody)
          let head2 = if str_array_contains(arr = tparams, val = head) {
            mark_formal_name(head)
          } else {
            head
          }
          Array::push(out, value = (fname, head2))
          collect_fn_return_marker(out = out, fname = fname, tparams = tparams, fparams = fparams, ret = ret, fbody = fbody)
          collect_fn_impl_return_key(out = out, fname = fname, tparams = tparams, ret = ret)
          collect_fn_eq_return_shape(out = out, fname = fname, tparams = tparams, ret = ret, fbody = fbody)
        },
        _ => ()
      },
      // `fn name(..) -> R { .. }` declares parse to SFnDecl, not SLet (see
      // parse_fn_stmt_general) -- without this case every `fn`-declared
      // function (the more common spelling) was invisible here, silently
      // missing from the `for`/async-vs-sync desugar and other fn_returns
      // consumers below.
      SFnDecl(_, fname, body, _, _) => match body {
        EFn(tparams, _, fparams, ret, _, fbody) => {
          // #2141: same re-spelling as the SLet arm above.
          let head = fn_return_head_of(ret = ret, body = fbody)
          let head2 = if str_array_contains(arr = tparams, val = head) {
            mark_formal_name(head)
          } else {
            head
          }
          Array::push(out, value = (fname, head2))
          collect_fn_return_marker(out = out, fname = fname, tparams = tparams, fparams = fparams, ret = ret, fbody = fbody)
          collect_fn_impl_return_key(out = out, fname = fname, tparams = tparams, ret = ret)
          collect_fn_eq_return_shape(out = out, fname = fname, tparams = tparams, ret = ret, fbody = fbody)
        },
        _ => ()
      },
      // #672: map each enum variant constructor to its enum name, so a
      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch
      // (infer_arg_type_name reads ctor calls through fn_returns).
      SEnum(_, ename, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = vi)
          Array::push(out, value = (vname, ename))
          vi = vi + 1
        }
      },
      // #1502: `type C = Color` under the reserved `type C` key, so
      // `qual_ctor_member` can normalize an alias qualifier to the enum it
      // names. Only a head-bearing target is recorded -- a tuple/fn alias can
      // never name an enum.
      STypeAlias(_, aname, _, te) => match te {
        TyName(n) => {
          Array::push(out, value = (type_alias_key(aname), n))
        },
        TyApp(n, _) => {
          Array::push(out, value = (type_alias_key(aname), n))
        },
        _ => ()
      },
      // #1502: `import ./m { E as F }` is the same renaming from the other
      // direction. A BACKSTOP, not the primary path: in the lanes that run
      // import_alias_rewrite.vibe the head is already rewritten to `E` before
      // this pass, and the merged stmt list has no `SImport` left to read. It
      // earns its place for the lanes that skip that rewrite (gc_only.vibe),
      // where the alias does still reach here.
      SImport(_, items) => {
        let mut ii = 0
        while ii < Array::length(items) {
          let item = Array::get(items, at = ii)
          let orig = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => {
              Array::push(out, value = (type_alias_key(alias), orig))
            },
            None => ()
          }
          ii = ii + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // #1341: struct FIELD type heads ride along under the reserved
  // `Struct.field` key (struct_field_type_key). Must be pushed BEFORE the
  // sort below -- fn_exists/fn_return_type binary-search this table, so an
  // entry appended afterwards would be invisible. (That is exactly how the
  // first cut of this failed: the seeding call landed in a different
  // collector whose result is not what infer_arg_type_name reads.)
  collect_struct_field_types(stmts = stmts, out = out)
  // Perf: this table holds every top-level fn + enum variant of the merged
  // compile (thousands of entries) and fn_exists/fn_return_type consulted it
  // LINEARLY per expression during the rewrite. Sort once (STABLE, so the
  // leftmost duplicate stays the linear scan's "first match") and let the
  // helpers below binary-search. Nothing outside those helpers reads the
  // table positionally, so the order change is invisible.
  let names = array_empty()
  let mut ni = 0
  while ni < Array::length(out) {
    let (n, _) = Array::get(out, at = ni)
    Array::push(names, value = n)
    ni = ni + 1
  }
  let perm = sort_perm_by_names(names)
  let sorted = array_empty()
  let mut pi = 0
  while pi < Array::length(perm) {
    Array::push(sorted, value = Array::get(out, at = Array::get(perm, at = pi)))
    pi = pi + 1
  }
  sorted
}

struct ReceiverAliasEntry {
  site: Int;
  alias: String;
  signature: Stmt;
  forward: Stmt
}

/// Lower receiver aliases through a top-level forwarder. Substituting an alias's
/// unqualified target at a call site would capture a local of the same name.
/// The alias itself remains a value for explicit references and host operations.
fn receiver_alias_entries(_ stmts: Array[Stmt]) -> Array[ReceiverAliasEntry] {
  let entries: Array[ReceiverAliasEntry] = []
  let sites: MutMap[String, Int] = MutMap::new_string()
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EIdent(_, _)) => if String::index_of(name, needle = "::") >= 0 {
        MutMap::set(sites, k = name, v = i)
        found = true
      },
      _ => ()
    }
    i = i + 1
  }
  if !found {
    return entries
  }
  let bodies: MutMap[String, Expr] = MutMap::new_string()
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, body) => if body is EFn(_, _, _, _, _, _) {
        MutMap::set(bodies, k = name, v = body)
      },
      _ => ()
    }
  }
  for pair in collect_top_level_fn_alias_renames(stmts) {
    let (alias, target) = pair
    match MutMap::get(sites, k = alias) {
      Some(site) => {
        let entry = receiver_alias_key(alias)
        if !MutMap::has(bodies, k = entry) {
          match MutMap::get(bodies, k = target) {
            Some(EFn(formals, bounds, params, ret, eff, body)) => {
              let inputs: Array[(String, Option[TypeExpr])] = []
              let args: Array[Expr] = []
              let mut j = 0
              while j < Array::length(params) {
                let (_, ty) = Array::get(params, at = j)
                let arg = "$receiver_arg$" + __to_string(j)
                Array::push(inputs, value = (arg, ty))
                Array::push(args, value = EIdent(arg, -1))
                j = j + 1
              }
              let forward = SLet(false, false, entry, None, EFn(formals, bounds, inputs, ret, eff, ECall(EIdent(target, -1), args, -1, [
              ])))
              // Only the return classification crosses an interface. A lambda
              // tail exposes its signature, never its executable body.
              let tail = match ret {
                Some(_) => EUnit,
                None => match fn_body_tail_expr(body) {
                  EFn(tp, bs, ps, result, effects, _) => EFn(tp, bs, ps, result, effects, EUnit),
                  _ => EUnit
                }
              }
              let signature = SLet(false, false, entry, None, EFn(formals, bounds, inputs, ret, eff, tail))
              Array::push(entries, value = ReceiverAliasEntry::{
                site: site,
                alias: alias,
                signature: signature,
                forward: forward
              })
            },
            _ => ()
          }
        }
      },
      None => ()
    }
  }
  entries
}

/// Project exported receiver aliases in their owner's scope, where private
/// targets and multi-hop bindings are still visible. Consumers need only the
/// callable signature, including an inferred closure return.
export fn receiver_alias_interface(stmts: Array[Stmt], exports: MutMap[String, Int]) -> Array[Stmt] {
  let out: Array[Stmt] = []
  for entry in receiver_alias_entries(stmts) {
    match Array::get(stmts, at = entry.site) {
      SLet(exported, _, _, _, _) => if exported || MutMap::has(exports, k = entry.alias) {
        Array::push(out, value = entry.signature)
      },
      _ => ()
    }
  }
  out
}

/// Infer return shapes from the same signatures consumed by dependent modules.
/// Install executable forwarding bodies only in the module that owns the alias.
export fn collect_fn_returns_with_receiver_entries(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let entries = receiver_alias_entries(stmts)
  let start = Array::length(stmts)
  for entry in entries {
    if dtd_is_own_index(entry.site) {
      Array::push(stmts, value = entry.signature)
    } else {
      Array::set(stmts, at = entry.site, value = entry.signature)
    }
  }
  let returns = collect_fn_returns(stmts)
  let mut at = start
  for entry in entries {
    if dtd_is_own_index(entry.site) {
      Array::set(stmts, at = at, value = entry.forward)
      at = at + 1
    }
  }
  returns
}
