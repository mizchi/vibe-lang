/// #635: classify a call as a railway-bind/op sentinel. Returns
///   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1
///       a 1-param closure),
///   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),
///   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the
///       name but with a different arity/shape).
export fn try_sentinel(callee: Expr, args: Array[Expr]) -> Int {
  match callee {
    EIdent(n, _) => if n == "__try_bind" {
      if Array::length(args) == 2 {
        match Array::get(args, at = 1) {
          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {
            0
          } else {
            2
          },
          _ => 2
        }
      } else {
        2
      }
    } else if n == "__try_op" {
      if Array::length(args) == 1 {
        1
      } else {
        2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// #941: best-effort char offset of a railway operand, so the desugar-generated
/// failure-track nodes (`Err(e)` / `None`) carry the `?`/`let*` operand's own
/// source position — the checker's Option⇔Result mixing diagnostics anchor on
/// it. -1 (unlocated) when the operand carries no offset.
fn railway_val_off(_ e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off, _) => if off >= 0 {
      off
    } else {
      railway_val_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_val_off(base)
    },
    EBinOp(_, lhs, _, _) => railway_val_off(lhs),
    _ => -1
  }
}

/// #635/#1324: lower the `let* name = val <rest>` sentinel to the Option
/// railway — `match val { Some(name) => rest, None => None }`.
///
/// `Result` used to be the OTHER railway monad (and the default when this
/// pass could not name `val`'s type), but #1324 removed it from the language,
/// leaving `Option` as the only short-circuit monad — so the lowering no
/// longer needs to type-direct at all. A scrutinee that is not an `Option`
/// is reported by the checker's ordinary unification against these arms.
export fn lower_try_bind(val: Expr, name: String, rest: Expr) -> Expr {
  let voff = railway_val_off(val)
  // `__try_none` is the origin marker, the same role `__try_v` plays for
  // postfix `?`. A user-written `None => None` is `EIdent("None")` and
  // must not be classified as `let*` — especially on the unlocated
  // `parse_program` path, where every offset is -1. Check remaps the
  // name for typing; `erase_railway_origin_markers` turns it back into
  // `None` after a clean check so codegen does not see a synthetic ident.
  EMatch(val, [
    (PCtor("Some", [PBind(name)]), rest),
    (PCtor("None", array_empty()), EIdent("__try_none", voff))
  ])
}

/// #635/#1324: lower the `val?` sentinel to the Option railway — yield the
/// inner value on `Some`, early-`return None` on `None`. Uses `EReturn`, so
/// the enclosing function short-circuits. See `lower_try_bind` for why
/// `Option` is now the only monad this lowers to.
export fn lower_try_op(_ val: Expr) -> Expr {
  let voff = railway_val_off(val)
  EMatch(val, [
    (PCtor("Some", [PBind("__try_v")]), EIdent("__try_v", -1)),
    // review-lint: allow-fixed-synthetic-name -- existing generated railway result binder preserved by the module split
    (PCtor("None", array_empty()), EReturn(EIdent("None", voff)))
  ])
}

/// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only
/// the `__try_bind`/`__try_op` sentinels (everything else is recursed
/// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs
/// from BOTH the checker (`check_program`, where the heavy dict-passing pass does
/// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert
/// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks
/// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.
/// #2501: the environment for one `match` arm's body in this pass. Every name
/// the pattern binds shadows the outer bindings of that name -- the way a
/// lambda parameter does (`seed_var_types`) -- before the binders the arm
/// recovers (`arm_binder_var_types_env`) are added. Without the mask an arm
/// binder `m` settled as an Array kept an outer `m: StringMap[V]`'s spelling,
/// and this pass, which runs before the check and so has no row to ask,
/// rewrote `m[k]` to `Map::get`. The arm's binders are read against the
/// unmasked environment, because the scrutinee may share a binder's name
/// (`match m { Some(m) => .. }`); `arm_binder_var_types_env` only appends to
/// what it is given, so its own rows are the ones past `var_types`.
fn railway_arm_var_types(scrut: Expr, p: Pat, var_types: Array[(String, String)], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let names = dtd_pat_binder_names(p)
  let arm_vars = arm_binder_var_types_env(scrut = scrut, p = p, var_types = var_types, struct_sets = struct_sets, fn_returns = fn_returns)
  let masked = if Array::length(names) == 0 {
    var_types
  } else {
    mask_shadowed_names(base = var_types, names = names)
  }
  if Array::length(masked) == Array::length(var_types) {
    // Nothing outer is shadowed (`masked` may be `var_types` itself).
    arm_vars
  } else {
    // `masked` is a fresh copy here, so it takes the arm's own rows.
    let mut i = Array::length(var_types)
    while i < Array::length(arm_vars) {
      Array::push(masked, value = Array::get(arm_vars, at = i))
      i = i + 1
    }
    masked
  }
}

fn railway_rw(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], changed: Option[Array[Bool]]) -> Expr {
  match expr {
    ECall(callee, args, off, callee_resolution) => {
      let k = try_sentinel(callee = callee, args = args)
      if k == 0 {
        match changed {
          Some(cell) => {
            Array::set(cell, at = 0, value = true)
          },
          None => {
            ()
          }
        }
        let val = Array::get(args, at = 0)
        match Array::get(args, at = 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, at = 0)
            let rwval = railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types = var_types, name = name, inferred = railway_bind_payload_type(val = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
            let rwrest = railway_rw(expr = rest, struct_sets = struct_sets, var_types = body_vars, fn_returns = fn_returns, changed = changed)
            lower_try_bind(val = rwval, name = name, rest = rwrest)
          },
          _ => EUnit
        }
      } else if k == 1 {
        match changed {
          Some(cell) => {
            Array::set(cell, at = 0, value = true)
          },
          None => {
            ()
          }
        }
        let val = Array::get(args, at = 0)
        let rwval = railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
        lower_try_op(rwval)
      } else {
        let rwargs = for a in args {
          railway_rw(expr = a, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
        }
        match map_index_rewrite(callee = callee, args = args, rwargs = rwargs, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, typed = false, call_off = off) {
          Some(map_get) => {
            match changed {
              Some(cell) => {
                Array::set(cell, at = 0, value = true)
              },
              None => {
                ()
              }
            }
            map_get
          },
          None => ECall(railway_rw(expr = callee, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), rwargs, off, callee_resolution)
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(e) => ESpread(railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EStringInterp(_) => expr,
    EIdent(_, _) => expr,
    ETuple(elems) => ETuple(for e in elems {
      railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
    }),
    EArray(elems) => EArray(for e in elems {
      railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, at = i)
        Array::push(out, value = (fname, railway_rw(expr = fval, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, at = i)
        Array::push(out, value = (k, railway_rw(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(railway_rw(expr = c, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = t, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    ELet(name, val, body, soff) => {
      let new_val = railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
      let body_vars = extend_var_types(var_types = var_types, name = name, inferred = anon_or_infer(val = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
      ELet(name, new_val, railway_rw(expr = body, struct_sets = struct_sets, var_types = body_vars, fn_returns = fn_returns, changed = changed), soff)
    },
    ELetRec(name, val, body) => ELetRec(name, railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = body, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    ELetMut(name, val, body, soff) => {
      let new_val = railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
      let body_vars = extend_var_types(var_types = var_types, name = name, inferred = anon_or_infer(val = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
      ELetMut(name, new_val, railway_rw(expr = body, struct_sets = struct_sets, var_types = body_vars, fn_returns = fn_returns, changed = changed), soff)
    },
    EAssign(name, val, cont, target_off) => EAssign(name, railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = cont, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), target_off),
    EAssignOp(name, op, val, cont, target_off) => EAssignOp(name, op, railway_rw(expr = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = cont, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), target_off),
    ESeq(a, b) => ESeq(railway_rw(expr = a, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, at = i)
        // #1878: tuple-destructure arms hand record sentinels to their
        // binders (see arm_binder_var_types) — this walk runs BEFORE the
        // checker, so the arm body's `binding.field` reads rewrite to
        // positional `__rec_field` here too.
        let arm_vars = railway_arm_var_types(scrut = scrut, p = p, var_types = var_types, struct_sets = struct_sets, fn_returns = fn_returns)
        Array::push(out, value = (p, railway_rw(expr = b, struct_sets = struct_sets, var_types = arm_vars, fn_returns = fn_returns, changed = changed)))
        i = i + 1
      }
      EMatch(railway_rw(expr = scrut, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, at = i)
        Array::push(out, value = (p, railway_rw(expr = b, struct_sets = struct_sets, var_types = mask_shadowed_names(base = var_types, names = dtd_pat_binder_names(p)), fn_returns = fn_returns, changed = changed)))
        i = i + 1
      }
      EHandle(railway_rw(expr = scrut, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), out)
    },
    EWhile(c, b) => EWhile(railway_rw(expr = c, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, railway_rw(expr = init, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed))
    }, railway_rw(expr = body, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(expr = iter, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = body, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EBinOp(op, l, r, boff) => EBinOp(op, railway_rw(expr = l, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), railway_rw(expr = r, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed), boff),
    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(expr = body, struct_sets = struct_sets, var_types = dtd_mask_shadowed_params(var_types = seed_var_types(params = ps, tparams = tp, base = var_types), ps = ps, fn_returns = fn_returns), fn_returns = fn_returns, changed = changed)),
    EDot(obj, field, off, fdoff) => {
      let robj = railway_rw(expr = obj, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
      match anon_dot_rewrite(obj = obj, field = field, off = off, robj = robj, var_types = var_types) {
        Some(rw) => {
          match changed {
            Some(cell) => {
              Array::set(cell, at = 0, value = true)
            },
            None => {
              ()
            }
          }
          rw
        },
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(expr = body, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EReturn(e) => EReturn(railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      railway_rw(expr = e, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, changed = changed)
    })
  }
}

/// #839: every top-level `let name = record { .. }` whose field-set matches no
/// declared struct, collected as `__anonrec:` var_types entries UP FRONT (same
/// encoding `anon_record_inferred`/`anon_dot_rewrite` use for a local `let`).
/// Threaded as the BASE var_types into every top-level statement's own
/// `railway_rw` pass below (instead of starting each statement fresh from
/// empty), so `name.field` resolves whether it appears in a LATER top-level
/// statement or inside a function/test body that merely closes over a
/// top-level binding — not just within the same statement's own expression
/// tree (#839: previously the only working position was a bare top-level
/// expression statement in the SAME statement as the record literal, which
/// ADR-0069 now rejects outright). Consistent with `collect_struct_field_sets`
/// / `collect_fn_returns`, this does not recurse into `SModule` bodies — a
/// module-nested anonymous-record `let` is a fresh scope of its own, same as
/// module-nested struct/fn declarations are already scoped in those passes.
export fn collect_toplevel_anon_records(stmts: Array[Stmt], struct_sets: Array[(String, Array[String])]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, val) => match anon_record_inferred(val = val, struct_sets = struct_sets) {
        Some(sentinel) => Array::push(out, value = (name, sentinel)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn can_be_toplevel_constructor(_ name: String) -> Bool {
  name != "Int" && name != "Bool" && name != "String" && name != "Float64" && name != "Float32" && name != "Unit" && name != "ByteStream"
}

export fn collect_toplevel_constructor_vars(stmts: Array[Stmt], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let mut out = collect_toplevel_anon_records(stmts = stmts, struct_sets = struct_sets)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, val) => {
        let inferred = if result_uses_constructor_witness(expr = val, gens = gens) {
          anon_or_constructor_infer(val = val, gens = gens, struct_sets = struct_sets, var_types = out, fn_returns = fn_returns)
        } else {
          anon_or_infer(val = val, struct_sets = struct_sets, var_types = out, fn_returns = fn_returns)
        }
        match inferred {
          Some(inferred) => if can_be_toplevel_constructor(inferred) {
            out = extend_constructor_var_types(var_types = out, name = name, inferred = Some(inferred))
          } else {
            ()
          },
          None => ()
        }
      },
      SLetMut(name, _, val) => {
        let inferred = if result_uses_constructor_witness(expr = val, gens = gens) {
          anon_or_constructor_infer(val = val, gens = gens, struct_sets = struct_sets, var_types = out, fn_returns = fn_returns)
        } else {
          anon_or_infer(val = val, struct_sets = struct_sets, var_types = out, fn_returns = fn_returns)
        }
        match inferred {
          Some(inferred) => if can_be_toplevel_constructor(inferred) {
            out = extend_constructor_var_types(var_types = out, name = name, inferred = Some(inferred))
          } else {
            ()
          },
          None => ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #635: lower the `let*`/`?` sentinels across a whole program. In-place,
/// idempotent (a second run finds no sentinels), and inert for programs that use
/// neither. Exported so the checker path can lower before type-checking.
/// `toplevel_vars` (#839) seeds every top-level statement's var_types with the
/// program's top-level anonymous-record bindings — see
/// `collect_toplevel_anon_records` — so `EFn`/`ELet`'s existing var_types
/// threading (which already covers a SINGLE statement's own nested scopes)
/// extends across top-level statement boundaries too.
fn railway_rw_stmt(s: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)], changed: Option[Array[Bool]]) -> Stmt {
  match s {
    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(expr = body, struct_sets = struct_sets, var_types = toplevel_vars, fn_returns = fn_returns, changed = changed)),
    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(expr = e, struct_sets = struct_sets, var_types = toplevel_vars, fn_returns = fn_returns, changed = changed)),
    STest(name, body) => STest(name, railway_rw(expr = body, struct_sets = struct_sets, var_types = toplevel_vars, fn_returns = fn_returns, changed = changed)),
    SBench(name, body) => SBench(name, railway_rw(expr = body, struct_sets = struct_sets, var_types = toplevel_vars, fn_returns = fn_returns, changed = changed)),
    SExpr(e) => SExpr(railway_rw(expr = e, struct_sets = struct_sets, var_types = toplevel_vars, fn_returns = fn_returns, changed = changed)),
    SModule(exp, name, body) => SModule(exp, name, for inner in body {
      railway_rw_stmt(s = inner, struct_sets = struct_sets, fn_returns = fn_returns, toplevel_vars = toplevel_vars, changed = changed)
    }),
    _ => s
  }
}

fn desugar_railway_binds_impl(stmts: Array[Stmt], changed: Option[Array[Bool]]) -> Unit {
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let toplevel_vars = collect_toplevel_anon_records(stmts = stmts, struct_sets = struct_sets)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, at = i, value = railway_rw_stmt(s = Array::get(stmts, at = i), struct_sets = struct_sets, fn_returns = fn_returns, toplevel_vars = toplevel_vars, changed = changed))
    i = i + 1
  }
}

export fn desugar_railway_binds_reporting_change(_ stmts: Array[Stmt]) -> Bool {
  let changed = [false]
  desugar_railway_binds_impl(stmts = stmts, changed = Some(changed))
  Array::get(changed, at = 0)
}

export fn desugar_railway_binds(_ stmts: Array[Stmt]) -> Unit {
  desugar_railway_binds_impl(stmts = stmts, changed = None)
}
