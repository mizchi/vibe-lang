              // to infer `Option[?EqUnknown]` (a shift is not a literal this
              // inference named), and the unknown payload position compared
              // with the raw `==` -- the generic `eq`, whose string fall-back
              // equated the two words. With the row, `Option[Int]` compares
              // the payload exactly; a lane with no rows keeps the syntactic
              // shape, whose leaf inference now names such an expression too.
              let sty = match dtd_typed_eq_admitted_ty(boff) {
                Some(te) => Some(te),
                None => infer_static_eq_type_binop(l, r)
              }
              let dty = match sty {
                Some(t) => if static_eq_dispatchable(t) {
                  Some(t)
                } else {
                  None
                },
                None => None
              }
              match dty {
                Some(dt) => if ty_mentions_owned_scalar(dt) {
                  // Codex round 4 on #2471: see ty_mentions_owned_scalar.
                  eq_fail_closed(op, owned_scalar_name_in(dt))
                } else {
                  let call = eq_for_typed(dt, rl, rr, dtd_eq_known_types)
                  if op == "==" {
                    call
                  } else {
                    ECall(EIdent("not", -1), [call], -1, [])
                  }
                },
                None => match eq_var_shape_dispatch(l, r, struct_sets, var_types, fn_returns) {
                  // #1526 (ADR-0097): a NAME whose recorded shape mentions an
                  // Array/Bytes — the tuple-through-a-name comparison whose
                  // Array elements the codegen walk identity-compared. Any
                  // other shape stays on the paths below (see
                  // eq_operand_shape_ty's trigger condition).
                  Some(st) => {
                    let call = eq_for_typed(st, rl, rr, dtd_eq_known_types)
                    if op == "==" {
                      call
                    } else {
                      ECall(EIdent("not", -1), [call], -1, [])
                    }
                  },
                  None => {
                    let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
                      Some(t) => Some(t),
                      None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)
                    }
                    match ty {
                      Some(t) => match dtd_eq_witness_dict(dict_binds, traits, t) {
                        // #2523: the operand is a formal carrying a witness --
                        // dispatch through the threaded dictionary, the way the
                        // qualified spelling `T::equals(x, y)` and the UFCS
                        // spelling `x.equals(y)` already do. Everything else in
                        // this ladder is a CONCRETE operand type and is
                        // unaffected.
                        Some(dict_pname) => {
                          let call = ECall(EDot(EIdent(dict_pname, -1), dtd_eq_witness_method(), -1, -1), [
                            rl,
                            rr
                          ], -1, [])
                          if op == "==" {
                            call
                          } else {
                            ECall(EIdent("not", -1), [call], -1, [])
                          }
                        },
                        // #2141: a spelling that is a type parameter of an
                        // enclosing binder is a FORMAL here, whatever else the
                        // (merged) program declares under that name -- the
                        // struct dispatch would call `T::equals` on erased
                        // operands and read garbage.
                        None => if struct_set_has(struct_sets, t) && !formal_in_scope(t) {
                          let call = ECall(EIdent(String::concat(t, "::equals"), -1), [
                            rl,
                            rr
                          ], -1, [])
                          if op == "==" {
                            call
                          } else {
                            ECall(EIdent("not", -1), [call], -1, [])
                          }
                        } else if t == "Option" {
                          // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)
                          // dispatches to a structural match; the runtime would otherwise
                          // identity-compare the heap-allocated nullary `None`. Payloads
                          // compare with `==` — correct for scalar payloads (the common
                          // case); an aggregate-payload bare-Option variable is a #695
                          // residual (route it through a struct field for full recursion).
                          // #2457: the structural match compares each payload
                          // with a raw `==`, which codegen cannot classify (a
                          // match binder), so an `Int` payload went through the
                          // generic `eq` and `mk(64 << 32) == mk(65 << 32)`
                          // answered `true`. When the checker's row for this
                          // site names an admitted type (`Option[Int]`), the
                          // typed comparator compares that payload exactly;
                          // with no row, or a type the allow-list refuses, the
                          // match stays as it was.
                          // Codex round 4 on #2471: a row spelling a scalar the
                          // source also declares is ambiguous (see
                          // ty_mentions_owned_scalar) and fails closed.
                          let eqm = match dtd_typed_eq_admitted_ty(boff) {
                            Some(te) => if ty_mentions_owned_scalar(te) {
                              eq_fail_closed("==", owned_scalar_name_in(te))
                            } else {
                              eq_for_typed(te, rl, rr, dtd_eq_known_types)
                            },
                            None => opt_eq_match(rl, rr)
                          }
                          if op == "==" {
                            eqm
                          } else {
                            ECall(EIdent("not", -1), [eqm], -1, [])
                          }
                        } else if t == "Result" {
                          let eqm = match dtd_typed_eq_admitted_ty(boff) {
                            Some(te) => if ty_mentions_owned_scalar(te) {
                              eq_fail_closed("==", owned_scalar_name_in(te))
                            } else {
                              eq_for_typed(te, rl, rr, dtd_eq_known_types)
                            },
                            None => result_eq_match(rl, rr)
                          }
                          if op == "==" {
                            eqm
                          } else {
                            ECall(EIdent("not", -1), [eqm], -1, [])
                          }
                        } else if t == "Bytes" {
                          // #1526 (ADR-0097): a Bytes-typed operand (annotation or
                          // recorded binding) — content equality, same helper the
                          // typed contexts dispatch to.
                          bytes_eq_needed_record()
                          let call = ECall(EIdent(bytes_equals_name(), -1), [
                            rl,
                            rr
                          ], -1, [])
                          if op == "==" {
                            call
                          } else {
                            ECall(EIdent("not", -1), [call], -1, [])
                          }
                        } else {
                          // #2441: an inferred head name with no actionable
                          // rung (e.g. `Array` with an unknown element) falls
                          // to the typed channel before staying raw.
                          dtd_typed_eq_residual(op, rl, rr, boff)
                        }
                      },
                      None => dtd_typed_eq_residual(op, rl, rr, boff)
                    }
                  }
                }
              }
            }
          }
        }
      } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
        // #746: String relational lowering. The backends compile a bare
        // `<`/`>`/`<=`/`>=` as signed i64 compare — on the (ptr<<32)|len
        // string repr that orders by POINTER, not content. Rewrite to
        // `str_lex_diff(l, r) <op> 0` (a builtin returning a sign-carrying
        // lexicographic diff with length tie-break) when either ORIGINAL
        // operand is determinably String — same inference and residual
        // class as the `+` -> String::concat rewrite below.
        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if rel_stringish {
          EBinOp(op, ECall(EIdent("str_lex_diff", -1), [rl, rr], -1, []), EInt(0), -1)
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: neither operand is determinably String, but at least one is
          // the bare name of an in-scope generic type parameter — the
          // concrete runtime type is erased, so dispatch at runtime instead
          // (see is_erased_generic_operand / gen_generic_rel_diff_body).
          EBinOp(op, ECall(builtin_ref("__generic_rel_diff"), [rl, rr], -1, []), EInt(0), -1)
        } else {
          EBinOp(op, rl, rr, boff)
        }
      } else if op == "+" {
        // String `+` lowering: the checker types `String + String` as String,
        // but the backends compile a bare `+` as numeric i64.add — on the
        // (ptr<<32)|len string repr that adds the lengths and garbles the
        // pointer. Rewrite to String::concat when either ORIGINAL operand is
        // determinably String (literal, tracked var, string-returning call,
        // or a nested `+` chain of those). Undeterminable operands (e.g. two
        // untracked call results) keep the raw binop — same residual class
        // as #695's opaque `==`.
        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if stringish {
          ECall(builtin_ref("String::concat"), [rl, rr], -1, [])
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: same erased-`[T: Add]` case as the relational branch above.
          ECall(builtin_ref("__generic_add"), [rl, rr], -1, [])
        } else {
          EBinOp(op, rl, rr, boff)
        }
      } else {
        EBinOp(op, rl, rr, boff)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EFn(tp, bs, ps, ret, eff, body) => {
      // #2141: the binder frame scopes the body -- see dtd_scope_formals.
      // #2737: the frame carries `bs` so a dispatch inside the body can tell
      // this binder's own bound from an enclosing one's.
      // #2778: a nested lambda with bounds is a generic of its own. Overlay
      // its dictionaries on the enclosing ones, dropping only formals this
      // binder rebinds -- an inner `[U]` must still see outer `[T: Show]`.
      if Array::length(tp) > 0 {
        let own = if already_threaded(bs, ps) {
          empty_threaded()
        } else {
          threaded_from_lambda_sig(bs, ps, traits)
        }
        // What to ADD, which is nothing when the parameters already carry
        // their dicts -- not the same question lambda_threaded_sig answers.
        let threaded = if already_threaded(bs, ps) {
          empty_threaded()
        } else {
          concat_threaded(threaded_from_outer_binds(dict_binds, tp), own)
        }
        let binds = dict_binds_overlay(dict_binds, tp, dict_binds_of(own, traits))
        let new_params = if Array::length(threaded) > 0 {
          thread_dict_params(threaded, ps)
        } else {
          ps
        }
        let shim_body = is_show_shim_value(expr)
        if shim_body {
          show_shim_body_enter()
        } else {
          ()
        }
        scope_formals_push(tp, bs, true)
        let rbody = rewrite_expr(body, gens_masked_by(gens, param_names(ps)), traits, struct_sets, binds, dtd_mask_shadowed_params(seed_var_types(ps, tp, var_types), ps, fn_returns), fn_returns)
        scope_formals_pop()
        if shim_body {
          show_shim_body_leave()
        } else {
          ()
        }
        EFn(tp, bs, new_params, ret, eff, rbody)
      } else {
        scope_formals_push(tp, bs, true)
        let rbody = rewrite_expr(body, gens_masked_by(gens, param_names(ps)), traits, struct_sets, dict_binds, dtd_mask_shadowed_params(seed_var_types(ps, tp, var_types), ps, fn_returns), fn_returns)
        scope_formals_pop()
        EFn(tp, bs, ps, ret, eff, rbody)
      }
    },
    EDot(obj, field, off, fdoff) => {
      let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      match anon_dot_rewrite(obj, field, off, robj, var_types) {
        Some(rw) => rw,
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    })
  }
}

/// Build the dict bindings in scope for a transformed generic's body.
fn concat_threaded(a: Array[(String, String, Int)], b: Array[(String, String, Int)]) -> Array[(String, String, Int)] {
  let out = empty_threaded()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    Array::push(out, Array::get(b, j))
    j = j + 1
  }
  out
}

/// `synth_dicts` when the callee actually declares dict parameters, None when
/// it does not -- see gen_prepends_dicts.
fn synth_dicts_if(prepend: Bool, callee_type_params: Array[String], threaded: Array[(String, String, Int)], constructor_recvs: Array[(String, Int)], args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Option[Array[Expr]] with Exception {
  if prepend {
    synth_dicts(callee_type_params, threaded, constructor_recvs, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens)
  } else {
    None
  }
}

/// Whether a resolved gen's dictionaries are PASSED at its call sites.
///
/// A lambda that binds no type parameters of its own takes no dict parameter:
/// `rewrite_expr`'s EFn arm threads only when `tp` is non-empty, and the
/// enclosing dictionaries reach such a body by CAPTURE, not by argument. Its
/// gen still lists them -- the interpolation expander reads that to resolve a
/// renderer -- so the question of what to pass is answered here instead.
///
/// Measured without this: `Set::from_array[T: Hash]`'s inner
/// `let rec go = (i, acc) -> ...` takes two parameters and was called with
/// three, which is a `null function or function signature mismatch` at run
/// time. A plain local lambda inside a bounded generic is everywhere, which is
/// why the failure looked unrelated to nested bounds.
fn gen_prepends_dicts(gen: DictGen) -> Bool {
  if gen.impl_trait == lambda_gen_marker() {
    Array::length(gen.type_params) > 0
  } else {
    // `build_gens` derives `threaded` from BOUNDS, and a generic impl method
    // can carry them with an empty `type_params` (its formals live in
    // `impl_params`). Testing the arity alone therefore suppressed dictionaries
    // those methods really do take -- measured, that is what stopped
    // `s5_wasm_test` self-compiling the compiler.
    true
  }
}

/// A generic whose call sites receive witness dictionaries, named as a VALUE.
///
/// The reference carries no dictionary, so the lowered function takes more
/// parameters than any call through the value supplies. Measured on main at
/// 618951a: `let g = f` for `fn f[T: Eq](x: T, y: T)` followed by
/// `g(1.5, 1.5)` compiled clean and produced a module the wasm validator
/// rejected (`not enough arguments on the stack for call (need 4, got 3)`).
/// A local binding of the same spelling masks the function
/// (`constructor_binding_is_masked`), so only the top-level generic, or a
/// bounded local lambda's own gen, is refused.
fn dtd_check_threaded_generic_value(name: String, gens: Array[DictGen], var_types: Array[(String, String)]) -> Unit with Exception {
  match lookup_gen_entry(gens, name) {
    // The LATEST gen answers. A local lambda's own gen is the binding in
    // scope even where a top-level function of the same spelling set the
    // mask (Codex on #3299); only a top-level gen yields to a local that
    // shadows it.
    Some(gen) => if gen.impl_trait != lambda_gen_marker() && constructor_binding_is_masked(var_types, name) {
      ()
    } else if gen_prepends_dicts(gen) && Array::length(gen.threaded) > 0 {
      let (tp, trait_name, _) = Array::get(gen.threaded, 0)
      throw("wrap `" + name + "` in a lambda that takes concrete parameter types and calls it: its `[" + tp + ": " + trait_ref_name(trait_name) + "]` bound is supplied at each call, so it cannot be passed as a value")
    } else {
      ()
    },
    None => ()
  }
}

/// `gens` with every name in `names` that a gen binds masked by a gen that
/// threads nothing, the way `gens_after_let` masks one for a `let`. A lambda
/// or `loop` parameter, or a `for` binder, of a generic's spelling is a local
/// value, not that generic: its calls take no dictionary, and naming it as a
/// value is not a reference to the generic (Codex on #3299).
fn gens_masked_by(gens: Array[DictGen], names: Array[String]) -> Array[DictGen] {
  let mut out = gens
  for n in names {
    if gens_name_bound(out, n) {
      out = gens_plus(out, dict_gen_of_lambda(n, [], empty_threaded()))
    } else {
      ()
    }
  }
  out
}

fn param_names(ps: Array[(String, Option[TypeExpr])]) -> Array[String] {
  for p in ps {
    strip_label_tilde(p.0)
  }
}

/// The dict parameters a lambda's rewritten signature CARRIES (#2778).
///
/// `threaded_from_outer_binds` drops only the formals the binder REBINDS, so
/// with `tp` empty it returns every enclosing dictionary -- while the `EFn`
/// rewrite arm threads nothing at all unless `tp` is non-empty. Reading that
/// difference off two separately written expressions is what let them drift:
/// `Set::from_array[T: Hash]`'s inner `let rec go = (i, acc) -> ...` takes two
/// parameters and was called with three, because the call site claimed the
/// enclosing `T: Hash` dictionary for a lambda that binds nothing. A plain
/// local lambda inside a bounded generic is everywhere, which is why the
/// failure looked unrelated to nested bounds.
///
/// This answers for the CALL SITES, which is not the same question the rewrite
/// arm asks. The arm asks what to ADD, and adds nothing when `already_threaded`
/// reports the parameters already carry their dicts -- but a signature that
/// already carries them still has to be CALLED with them. Those two answers
/// differ exactly there, so the arm keeps its own expression and this one does
/// not mention `already_threaded`. Collapsing them cost a round: it made every
/// `already_threaded` lambda's gen vanish and refused `add_by` in
/// `s5_wasm_test`.
fn lambda_threaded_sig(tp: Array[String], bounds: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], dict_binds: Array[(String, String, String, Array[String])]) -> Array[(String, String, Int)] {
  if Array::length(tp) > 0 {
    concat_threaded(threaded_from_outer_binds(dict_binds, tp), threaded_from_lambda_sig(bounds, params, traits))
  } else {
    empty_threaded()
  }
}

fn threaded_from_outer_binds(outer: Array[(String, String, String, Array[String])], inner_tp: Array[String]) -> Array[(String, String, Int)] {
  let out = empty_threaded()
  let mut i = 0
  while i < Array::length(outer) {
    let row = Array::get(outer, i)
    if dict_bind_shadowed_by(row, inner_tp) {
      ()
    } else {
      let (tp, trait_name, _, _) = row
      Array::push(out, (tp, trait_name, 0 - 1))
    }
    i = i + 1
  }
  out
}

fn dict_binds_overlay(outer: Array[(String, String, String, Array[String])], inner_tp: Array[String], inner: Array[(String, String, String, Array[String])]) -> Array[(String, String, String, Array[String])] {
  let out = empty_dict_binds()
  let mut i = 0
  while i < Array::length(outer) {
    let row = Array::get(outer, i)
    if dict_bind_shadowed_by(row, inner_tp) {
      ()
    } else {
      Array::push(out, row)
    }
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(inner) {
    Array::push(out, Array::get(inner, j))
    j = j + 1
  }
  out
}

fn dict_bind_shadowed_by(row: (String, String, String, Array[String]), inner_tp: Array[String]) -> Bool {
  let (tp, _, _, _) = row
  let mut i = 0
  let mut hit = false
  while i < Array::length(inner_tp) && !hit {
    let raw = Array::get(inner_tp, i)
    hit = raw == tp || type_param_name(raw) == tp
    i = i + 1
  }
  hit
}

fn dict_binds_of(threaded: Array[(String, String, Int)], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] {
  let out = empty_dict_binds()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let methods = match lookup_trait_sigs(traits, trait_name) {
      Some(sigs) => method_names_of_sigs(sigs),
      None => empty_str_array()
    }
    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))
    i = i + 1
  }
  out
}

/// Prepend the hidden dict parameters to a transformed generic's parameter list.
fn thread_dict_params(threaded: Array[(String, String, Int)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  let result = array_empty()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let trait_args = trait_ref_args(trait_name)
    let dty = TyApp(dict_struct_name(trait_name), if Array::length(trait_args) > 0 {
      trait_args
    } else {
      [TyName(tp)]
    })
    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(params) {
    Array::push(result, Array::get(params, j))
    j = j + 1
  }
  result
}

/// #2778: index of a parameter whose annotation is `F[..]` for constructor
/// formal `F`, without walking the enclosing program's alias table. Nested
/// lambdas have no statement array here; a `TyApp` head is enough for the
/// four rungs and for `F[_]: Mappable[F]`.
fn lambda_constructor_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {
  let mut i = 0
  let mut idx = 0 - 1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyApp(head, _)) => if head == tp {
        idx = i
        i = Array::length(params)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// #2778: the dictionaries a nested generic lambda needs, derived from its
/// own bounds the way `build_gens` derives them for a top-level binder.
fn threaded_from_lambda_sig(bounds: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, Int)] {
  let threaded = empty_threaded()
  let mut bi = 0
  while bi < Array::length(bounds) {
    let (tp, trait_list) = Array::get(bounds, bi)
    let tpname = type_param_name(tp)
    let mut ti = 0
    while ti < Array::length(trait_list) {
      let tr = Array::get(trait_list, ti)
      match lookup_trait_sigs(traits, tr) {
        Some(_) => {
          let ridx = find_recv_index(params, tpname)
          if ridx >= 0 {
            Array::push(threaded, (tpname, tr, ridx))
          } else {
            let cidx = lambda_constructor_recv_index(params, tpname)
            if cidx >= 0 {
              Array::push(threaded, (tpname, tr, encode_constructor_recv_index(cidx)))
            } else {
              let widx = find_array_elem_recv_index(params, tpname)
              if widx >= 0 {
                Array::push(threaded, (tpname, tr, encode_array_elem_recv_index(widx)))
              } else {
                ()
              }
            }
          }
        },
        None => ()
      }
      ti = ti + 1
    }
    bi = bi + 1
  }
  threaded
}

/// The marker that separates a LAMBDA binder's gen from `build_gens`'s.
///
/// `impl_trait` is read only under `match gen.impl_target { Some(target) =>`,
/// and a lambda gen's target is always None, so the field is free here and
/// the two producers stay distinguishable without widening `DictGen`.
fn lambda_gen_marker() -> String {
  "__lambda_binder"
}

fn dict_gen_of_lambda(name: String, tparams: Array[String], threaded: Array[(String, String, Int)]) -> DictGen {
  DictGen::{
    name: name,
    type_params: tparams,
    threaded: threaded,
    return_constructor_param: "",
    impl_trait: lambda_gen_marker(),
    impl_params: [],
    impl_target: None,
    constructor_recvs: []
  }
}

fn gens_plus(gens: Array[DictGen], extra: DictGen) -> Array[DictGen] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(gens) {
    Array::push(out, Array::get(gens, i))
    i = i + 1
  }
  Array::push(out, extra)
  out
}

fn gens_name_bound(gens: Array[DictGen], name: String) -> Bool {
  match lookup_gen_entry(gens, name) {
    Some(_) => true,
    None => false
  }
}

fn gens_after_let(gens: Array[DictGen], name: String, val: Expr, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], dict_binds: Array[(String, String, String, Array[String])]) -> Array[DictGen] {
  match lambda_dict_gen(name, val, traits, dict_binds) {
    Some(g) => gens_plus(gens, g),
    None => if gens_name_bound(gens, name) {
      gens_plus(gens, dict_gen_of_lambda(name, [], empty_threaded()))
    } else {
      gens
    }
  }
}

fn lambda_dict_gen(name: String, val: Expr, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], dict_binds: Array[(String, String, String, Array[String])]) -> Option[DictGen] {
  match val {
    // The entry keeps DESCRIBING the enclosing dictionaries even for a binder
    // that declares none: the interpolation expander reads `gens` to resolve a
    // formal's renderer, and narrowing this to what the signature carries
    // refused `add_by` in `s5_wasm_test`'s self-compile of the whole compiler.
    // Whether those dicts are PASSED is the call site's question, and
    // `gen_prepends_dicts` answers it there.
    EFn(tparams, bounds, params, _, _, _) => {
      let own = threaded_from_lambda_sig(bounds, params, traits)
      let threaded = concat_threaded(threaded_from_outer_binds(dict_binds, tparams), own)
      if Array::length(threaded) > 0 {
        Some(dict_gen_of_lambda(name, tparams, threaded))
      } else {
        None
      }
    },
    _ => None
  }
}

/// `toplevel_vars` (#839): the program's top-level anonymous-record bindings
/// (see `collect_toplevel_anon_records`), seeded as the base var_types for
/// every top-level statement's own `rewrite_expr` pass — mirrors the
/// `railway_rw_stmt` fix for the SAME `anon_dot_rewrite` call below, since this
/// is the SECOND, independent pass (the "heavy dict-passing" pass driving
/// `desugar_trait_dicts`, used by the RC/FS-compile codegen entries) that also
/// lowers `record{}.field` dot access — without this it inherited the exact
/// same "only resolves within a single top-level statement's own expression
/// tree" gap.
export fn rewrite_stmt(stmt: Stmt, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt with Exception {
  let no_binds = empty_dict_binds()
  // #1392: which top-level binding's body is about to be walked, so the
  // interpolation rewrite can decline to make `T::to_string` call itself.
  show_self_fn_set(match stmt {
    SLet(_, _, sname, _, _) => sname,
    _ => ""
  })
  match stmt {
    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {
      Some(threaded) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          let binds = dict_binds_of(threaded, traits)
          let new_params = thread_dict_params(threaded, params)
          let seeded = dtd_mask_shadowed_params(seed_var_types(params, tparams, toplevel_vars), params, fn_returns)
          // #2141 (Codex P1 on #2183): this dict-threaded path unwraps the
          // EFn itself, so rewrite_expr's EFn arm never pushes the binder
          // frame for it -- a `[T: Trait]` formal colliding with an imported
          // `struct T` still dispatched `T::equals` on erased operands.
          scope_formals_push(tparams, bounds, false)
          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)
          scope_formals_pop()
          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))
        },
        _ => stmt
      },
      // #2745: a TOP-LEVEL generic that `build_gens` did not thread -- an
      // unbounded one, `fn show_any[T](a: T)` -- reached here and let
      // `rewrite_expr`'s EFn arm push its binder frame, which marks the frame as
      // a LAMBDA's. That made `dtd_formal_innermost_is_nested` answer "nested"
      // for a top-level declaration. #2737's uses never saw it (they also require
      // the binder's bound to promise the method, and an unbounded binder
      // promises nothing), but it is wrong on its own terms, and #2745's refusal
      // reads that marker alone -- measured: the whole compiler was rejected,
      // because its own top-level unbounded generics interpolate their formals.
      //
      // Unwrapping the EFn here is what the threaded path above already does, for
      // the same reason: the frame belongs to the DECLARATION, so this arm must
      // push it rather than leave it to the arm that cannot tell the two apart.
      None => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          scope_formals_push(tparams, bounds, false)
          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, no_binds, dtd_mask_shadowed_params(seed_var_types(params, tparams, toplevel_vars), params, fn_returns), fn_returns)
          scope_formals_pop()
          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, params, ret, eff, new_body))
        },
        _ => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns))
      }
    },
    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SLetPat(pat, e) => SLetPat(pat, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SModule(exp, name, body) => SModule(exp, name, for s in body {
      rewrite_stmt(s, gens, traits, struct_sets, fn_returns, toplevel_vars)
    }),
    _ => stmt
  }
}
