/// Render one sub-expression by re-entering the interpolation rewrite on a
/// synthetic `__to_string(sub)`, so a nested wrapper or a derive(Show) value
/// inside one is rendered too.
fn interp_render_sub(sub: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  rewrite_expr(expr = ECall(builtin_ref("__to_string"), Array::slice([sub], start = 0, end = 1), -1, [
  ]), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
}

/// `open_s ++ e0 ++ sep ++ e1 ++ .. ++ close_s`, each element rendered.
/// (`open` is a reserved word in vibe, hence the suffixed names.)
fn interp_join(items: Array[Expr], open_s: String, sep: String, close_s: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let mut acc = EString(open_s, -1)
  let mut i = 0
  while i < Array::length(items) {
    let piece = interp_render_sub(sub = Array::get(items, at = i), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    acc = if i == 0 {
      concat2(a = acc, b = piece)
    } else {
      concat2(a = concat2(a = acc, b = EString(sep, -1)), b = piece)
    }
    i = i + 1
  }
  concat2(a = acc, b = EString(close_s, -1))
}

/// #1445: render a variable whose binding site recorded a TUPLE shape
/// (`tuple_shape_key`). The expansion destructures the variable rather than
/// re-evaluating any element expression -- the tuple is already built, and
/// the binding's RHS may not even be in scope here.
///
///   let t = (1, p)   ->   match t { (a, b) => "(" ++ show(a) ++ ", " ++ show(b) ++ ")" }
///
/// Each binder is rendered through `interp_render_sub`, with its recorded
/// element type pushed into `var_types` first -- that is what lets a
/// `derive(Show)` struct inside the tuple render structurally instead of
/// falling to the pointer heuristic. An element whose type was not inferable
/// at the binding site carries an empty entry and simply renders through the
/// ordinary `__to_string`, exactly as it does today.
fn interp_expand_var_tuple(name: String, elem_types: Array[String], derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let n = Array::length(elem_types)
  let pats = array_empty()
  let binders = empty_str_array()
  let mut i = 0
  while i < n {
    let v = show_tmp_name()
    Array::push(pats, value = PBind(v))
    Array::push(binders, value = v)
    i = i + 1
  }
  let mut acc = EString("(", -1)
  let mut k = 0
  while k < n {
    let v = Array::get(binders, at = k)
    let et = Array::get(elem_types, at = k)
    let vt = if String::length(et) == 0 {
      var_types
    } else {
      extend_var_types(var_types = var_types, name = v, inferred = Some(et))
    }
    let piece = interp_render_sub(sub = EIdent(v, -1), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vt, fn_returns = fn_returns)
    acc = if k == 0 {
      concat2(a = acc, b = piece)
    } else {
      concat2(a = concat2(a = acc, b = EString(", ", -1)), b = piece)
    }
    k = k + 1
  }
  EMatch(EIdent(name, -1), Array::slice([
    (PTuple(pats), concat2(a = acc, b = EString(")", -1)))
  ], start = 0, end = 1))
}

/// #1445: render a variable known to hold an `Array[T]` (its element type was
/// recorded under `array_elem_key` by `array_elem_bind` or `seed_var_types`).
///
/// The loop is emitted INLINE rather than as a call to a monomorphic
/// `__arr_to_string__<key>` helper. `gen_arr_to_string_fn` builds that helper
/// for `derive`d fields, but emitting one from here would mean driving helper
/// COLLECTION from interpolation sites in `desugar_derives` -- a second pass
/// has to have already decided which helpers exist by the time this one runs.
/// The loop body is the same shape as that helper's, so nothing is duplicated
/// conceptually; it is just placed where the type is known.
///
/// The element is rendered by re-entering the rewrite on `Array::get(name, i)`
/// -- `infer_arg_type_name` already resolves that shape through
/// `array_elem_type_of`, so a `derive(Show)` element renders structurally
/// without any extra plumbing here.
fn interp_expand_var_array(name: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let iv = String::concat(show_tmp_name(), "_i")
  let av = String::concat(show_tmp_name(), "_acc")
  let elem_piece = interp_render_sub(sub = ECall(builtin_ref("Array::get"), Array::slice([
    EIdent(name, -1),
    EIdent(iv, -1)
  ], start = 0, end = 2), -1, []), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0), -1), EString("", -1), EString(", ", -1))
  let append = concat2(a = concat2(a = EIdent(av, -1), b = sep), b = elem_piece)
  let body = ESeq(EAssign(av, append, EUnit, -1), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1), -1), EUnit, -1))
  let len_call = ECall(builtin_ref("Array::length"), Array::slice([
    EIdent(name, -1)
  ], start = 0, end = 1), -1, [])
  let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call, -1), body)
  ELetMut(iv, EInt(0), ELetMut(av, EString("[", -1), ESeq(loop_e, concat2(a = EIdent(av, -1), b = EString("]", -1))), -1), -1)
}

/// #1445 (#139): render `sub` given its recursive SHAPE.
///
/// The tuple case destructures with a `match` so no element expression is
/// re-evaluated; the array case binds each element to a name inside the loop,
/// which is what lets a NESTED composite element recurse (an element reached
/// as `Array::get(a, i)` has no name for `var_types` to key on).
fn interp_render_shaped(sub: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if shape_is_composite(sh) {
    interp_expand_shape(subject = sub, sh = sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  } else if String::length(sh) == 0 {
    interp_render_sub(sub = sub, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  } else {
    match sub {
      EIdent(v, _) => interp_render_sub(sub = sub, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = extend_var_types(var_types = var_types, name = v, inferred = Some(sh)), fn_returns = fn_returns),
      _ => interp_render_sub(sub = sub, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    }
  }
}

/// #3570: the subject a shape expansion places in its output as written (a
/// `match` scrutinee, a `let` initializer). It is user code, so it takes the
/// rewrite every other expression gets: a call to a bounded generic gains its
/// witness argument there. Left raw, `"\{get_by(m, k)}"` reached codegen one
/// argument short and the module was invalid wasm. A name is already final.
fn interp_shape_subject(subject: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match subject {
    EIdent(_, _) => subject,
    _ => rewrite_expr(expr = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  }
}

/// #1445 (#139): the tuple / array expansion for a composite shape. Supersedes
/// interp_expand_var_tuple / interp_expand_var_array for anything that nests;
/// those two stay for the shapes recorded by the older sentinels alone.
fn interp_expand_shape(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if sh == "{u}" {
    // #3075: a Unit position (`Option[Unit]`) printed `0`.
    unit_render_expr(interp_shape_subject(subject = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns))
  } else if String::starts_with(sh, prefix = "(") {
    let parts = shape_split(shape_inner(sh))
    let n = Array::length(parts)
    let pats = array_empty()
    let binders = empty_str_array()
    let mut i = 0
    while i < n {
      let v = show_tmp_name()
      Array::push(pats, value = PBind(v))
      Array::push(binders, value = v)
      i = i + 1
    }
    let mut acc = EString("(", -1)
    let mut k = 0
    while k < n {
      let piece = interp_render_shaped(sub = EIdent(Array::get(binders, at = k), -1), sh = Array::get(parts, at = k), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
      acc = if k == 0 {
        concat2(a = acc, b = piece)
      } else {
        concat2(a = concat2(a = acc, b = EString(", ", -1)), b = piece)
      }
      k = k + 1
    }
    EMatch(interp_shape_subject(subject = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), Array::slice([
      (PTuple(pats), concat2(a = acc, b = EString(")", -1)))
    ], start = 0, end = 1))
  } else if String::starts_with(sh, prefix = "{o:") {
    // #2971: an Option. Every non-tuple composite used to take the ARRAY arm
    // below, so the `{o:Int}` element of an `Array[Option[Int]]` was walked
    // with `Array::length` / `Array::get` and `[None, Some(0), Some(1)]`
    // rendered `[[], [0], [0]]`.
    let v = show_tmp_name()
    let payload = interp_render_shaped(sub = EIdent(v, -1), sh = String::substring(sh, start = 3, end = String::length(sh) - 1), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    EMatch(interp_shape_subject(subject = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), Array::slice([
      (PCtor("Some", Array::slice([PBind(v)], start = 0, end = 1)), concat2(a = EString("Some(", -1), b = concat2(a = payload, b = EString(")", -1)))),
      (PCtor("None", array_empty()), EString("None", -1))
    ], start = 0, end = 2))
  } else if String::starts_with(sh, prefix = "{r:") {
    let parts = shape_split(String::substring(sh, start = 3, end = String::length(sh) - 1))
    let ok_sh = if Array::length(parts) == 2 {
      Array::get(parts, at = 0)
    } else {
      ""
    }
    let err_sh = if Array::length(parts) == 2 {
      Array::get(parts, at = 1)
    } else {
      ""
    }
    let ov = show_tmp_name()
    let ev = show_tmp_name()
    let ok_piece = interp_render_shaped(sub = EIdent(ov, -1), sh = ok_sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    let err_piece = interp_render_shaped(sub = EIdent(ev, -1), sh = err_sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    EMatch(interp_shape_subject(subject = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), Array::slice([
      (PCtor("Ok", Array::slice([PBind(ov)], start = 0, end = 1)), concat2(a = EString("Ok(", -1), b = concat2(a = ok_piece, b = EString(")", -1)))),
      (PCtor("Err", Array::slice([PBind(ev)], start = 0, end = 1)), concat2(a = EString("Err(", -1), b = concat2(a = err_piece, b = EString(")", -1))))
    ], start = 0, end = 2))
  } else if String::starts_with(sh, prefix = "{g:") && show_generic_enum_known(generic_shape_head(sh)) {
    interp_expand_generic_enum(subject = subject, sh = sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  } else if String::starts_with(sh, prefix = "{g:") && show_generic_struct_known(generic_shape_head(sh)) {
    // #3007: a `derive (Show)` generic struct at a known instantiation. The
    // field types get the arguments substituted, so each field renders at its
    // real type; the text matches `gen_show_fn`'s (`Box { v: 1.5 }`).
    // #3082: a field naming the struct again (`rest: Option[L[T]]`) recursed
    // here until the stack overflowed; the recursion guard is the enum arm's.
    let gparts = shape_split(String::substring(sh, start = 3, end = String::length(sh) - 1))
    match show_generic_struct_decl(Array::get(gparts, at = 0)) {
      Some(_) => if show_generic_recurs(sh = sh, head = Array::get(gparts, at = 0)) {
        show_generic_recursive_render(subject = subject, sh = sh, head = Array::get(gparts, at = 0))
      } else {
        Array::push(dtd_show_generic_enum_stack, value = sh)
        let out = interp_expand_generic_struct(subject = subject, sh = sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
        Array::truncate(dtd_show_generic_enum_stack, length = Array::length(dtd_show_generic_enum_stack) - 1)
        out
      },
      None => interp_render_sub(sub = subject, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    }
  } else if !String::starts_with(sh, prefix = "[") {
    // #2971: an encoding this renderer does not expand (`{u}`, `{m:..}`,
    // `{g:..}`). Treating it as an array was the bug above; the ordinary path
    // is the honest answer, and a `{g:Head,..}` keeps its head so a
    // `Head::to_string` renderer is still found.
    let head_vt = if String::starts_with(sh, prefix = "{g:") {
      let gparts = shape_split(String::substring(sh, start = 3, end = String::length(sh) - 1))
      match subject {
        EIdent(sv, _) => extend_var_types(var_types = var_types, name = sv, inferred = Some(Array::get(gparts, at = 0))),
        _ => var_types
      }
    } else {
      var_types
    }
    interp_render_sub(sub = subject, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = head_vt, fn_returns = fn_returns)
  } else {
    // Array. The subject is read twice (length + per-index get), so it must be
    // a name; anything else is bound once first.
    let elem_sh = shape_inner(sh)
    let nm = match subject {
      EIdent(n, _) => n,
      _ => show_tmp_name()
    }
    let iv = String::concat(show_tmp_name(), "_i")
    let av = String::concat(show_tmp_name(), "_acc")
    let ev = show_tmp_name()
    let elem_piece = ELet(ev, ECall(builtin_ref("Array::get"), Array::slice([
      EIdent(nm, -1),
      EIdent(iv, -1)
    ], start = 0, end = 2), -1, []), interp_render_shaped(sub = EIdent(ev, -1), sh = elem_sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), -1)
    let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0), -1), EString("", -1), EString(", ", -1))
    let append = concat2(a = concat2(a = EIdent(av, -1), b = sep), b = elem_piece)
    let body = ESeq(EAssign(av, append, EUnit, -1), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1), -1), EUnit, -1))
    let len_call = ECall(builtin_ref("Array::length"), Array::slice([
      EIdent(nm, -1)
    ], start = 0, end = 1), -1, [])
    let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call, -1), body)
    let inner = ELetMut(iv, EInt(0), ELetMut(av, EString("[", -1), ESeq(loop_e, concat2(a = EIdent(av, -1), b = EString("]", -1))), -1), -1)
    match subject {
      EIdent(_, _) => inner,
      _ => ELet(nm, interp_shape_subject(subject = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), inner, -1)
    }
  }
}

/// #3007: the field-by-field expansion of a `derive (Show)` generic struct at
/// a known instantiation (see `interp_expand_shape`'s `{g:` arm).
fn interp_expand_generic_struct(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let gparts = shape_split(String::substring(sh, start = 3, end = String::length(sh) - 1))
  match show_generic_struct_decl(Array::get(gparts, at = 0)) {
    Some((sname, formals, fields)) => {
      let targs = empty_type_exprs()
      let mut ai = 1
      while ai < Array::length(gparts) {
        Array::push(targs, value = shape_to_eq_ty(Array::get(gparts, at = ai)))
        ai = ai + 1
      }
      let nm = match subject {
        EIdent(n, _) => n,
        _ => show_tmp_name()
      }
      let mut acc = EString(String::concat(namespace_rename_original(sname), " { "), -1)
      let mut fi = 0
      while fi < Array::length(fields) {
        let (fname, fty) = Array::get(fields, at = fi)
        let fsh = if Array::length(targs) == Array::length(formals) {
          ty_to_eq_shape(eq_subst_ty(ty = fty, params = formals, args = targs))
        } else {
          ""
        }
        let fv = show_tmp_name()
        let piece = ELet(fv, EDot(EIdent(nm, -1), fname, -1, -1), interp_render_shaped(sub = EIdent(fv, -1), sh = fsh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), -1)
        let label = if fi == 0 {
          String::concat(fname, ": ")
        } else {
          String::concat(", ", String::concat(fname, ": "))
        }
        acc = concat2(a = acc, b = concat2(a = EString(label, -1), b = piece))
        fi = fi + 1
      }
      let rendered = concat2(a = acc, b = EString(" }", -1))
      match subject {
        EIdent(_, _) => rendered,
        // Normalize the source value before binding it: constructor
        // qualification and witness arguments must survive specialization.
        _ => ELet(nm, rewrite_expr(expr = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), rendered, -1)
      }
    },
    None => interp_render_sub(sub = subject, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  }
}

/// #3074: a `derive (Show)` generic enum at a known instantiation, rendered
/// variant by variant with the arguments substituted into the payload types.
/// The text matches `gen_enum_show_fn`'s (`GA(true)`, `GB`).
///
/// A payload that names an enum already being expanded is recursive. Its
/// erased `to_string` is exact only when every type argument renders the same
/// erased as typed (`Int`, `String`); any other argument is refused rather than
/// printed through the erased formal.
fn interp_expand_generic_enum(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let gparts = shape_split(String::substring(sh, start = 3, end = String::length(sh) - 1))
  let head = Array::get(gparts, at = 0)
  if show_generic_recurs(sh = sh, head = head) {
    show_generic_recursive_render(subject = subject, sh = sh, head = head)
  } else {
    match show_generic_enum_decl(head) {
      Some((_, formals, variants)) => {
        let targs = empty_type_exprs()
        let mut ai = 1
        while ai < Array::length(gparts) {
          Array::push(targs, value = shape_to_eq_ty(Array::get(gparts, at = ai)))
          ai = ai + 1
        }
        Array::push(dtd_show_generic_enum_stack, value = sh)
        let arms = array_empty()
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, ptys) = Array::get(variants, at = vi)
          let pats = array_empty()
          let mut body = EString(namespace_rename_original(vname), -1)
          if Array::length(ptys) > 0 {
            body = EString(String::concat(namespace_rename_original(vname), "("), -1)
            let mut pi = 0
            while pi < Array::length(ptys) {
              let pv = show_tmp_name()
              Array::push(pats, value = PBind(pv))
              let psh = if Array::length(targs) == Array::length(formals) {
                ty_to_eq_shape(eq_subst_ty(ty = Array::get(ptys, at = pi), params = formals, args = targs))
              } else {
                ""
              }
              let piece = interp_render_shaped(sub = EIdent(pv, -1), sh = psh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
              body = if pi == 0 {
                concat2(a = body, b = piece)
              } else {
                concat2(a = concat2(a = body, b = EString(", ", -1)), b = piece)
              }
              pi = pi + 1
            }
            body = concat2(a = body, b = EString(")", -1))
          } else {
            ()
          }
          Array::push(arms, value = (PCtor(vname, pats), body))
          vi = vi + 1
        }
        Array::truncate(dtd_show_generic_enum_stack, length = Array::length(dtd_show_generic_enum_stack) - 1)
        EMatch(rewrite_expr(expr = subject, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), arms)
      },
      None => interp_render_sub(sub = subject, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    }
  }
}

/// `ctor_name(<rendered payload>)`.
fn interp_wrap1(ctor: String, payload: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  concat2(a = EString(String::concat(ctor, "("), -1), b = concat2(a = interp_render_sub(sub = payload, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), b = EString(")", -1)))
}

fn interp_expand_by_head(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  if head == "Option" {
    let v = show_tmp_name()
    let vt_some = interp_ctor_arm_var_types(arg = arg, ctor = "Some", binder = v, var_types = var_types)
    Some(EMatch(rewrite_expr(expr = arg, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), Array::slice([
      (PCtor("Some", Array::slice([PBind(v)], start = 0, end = 1)), interp_wrap1(ctor = "Some", payload = EIdent(v, -1), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vt_some, fn_returns = fn_returns)),
      (PCtor("None", array_empty()), EString("None", -1))
    ], start = 0, end = 2)))
  } else if head == "Result" {
    let ov = show_tmp_name()
    let ev = show_tmp_name()
    let vt_ok = interp_ctor_arm_var_types(arg = arg, ctor = "Ok", binder = ov, var_types = var_types)
    let vt_err = interp_ctor_arm_var_types(arg = arg, ctor = "Err", binder = ev, var_types = var_types)
    Some(EMatch(rewrite_expr(expr = arg, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), Array::slice([
      (PCtor("Ok", Array::slice([PBind(ov)], start = 0, end = 1)), interp_wrap1(ctor = "Ok", payload = EIdent(ov, -1), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vt_ok, fn_returns = fn_returns)),
      (PCtor("Err", Array::slice([PBind(ev)], start = 0, end = 1)), interp_wrap1(ctor = "Err", payload = EIdent(ev, -1), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vt_err, fn_returns = fn_returns))
    ], start = 0, end = 2)))
  } else {
    None
  }
}

/// The structural rendering for an interpolated wrapper value, or None when
/// this pass has no shape to work from and the `__to_string` call must stand.
fn interp_expand(arg: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  let erased_throw_head = if derived_only {
    dtd_erased_top_formal_head(arg = arg, dict_binds = dict_binds, traits = traits, struct_sets = struct_sets, var_types = render_classify_var_types(var_types = var_types, arg = arg), fn_returns = fn_returns)
  } else {
    ""
  }
  if String::length(erased_throw_head) > 0 {
    // #3003: `derived_only` is a THROW site's synthesized render (the message an
    // erased `Exception::Throw(m)` arm reads), not an interpolation the user
    // wrote. Refusing it with the interpolation message told `throw(x)` to
    // "interpolate at a concrete type", while `throw([x])` compiled and
    // rendered `<Array>`. Both render a placeholder naming the type now.
    Some(EString(String::concat("<", String::concat(erased_throw_head, ">")), -1))
  } else {
    interp_expand_checked(arg = arg, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  }
}

/// #3434: the environment the renderer reads for `arg`. A masked name -- a
/// shadow this pass could not type -- is seeded the way a parameter annotated
/// with the checker's type for this render argument is (`seed_var_types`):
/// the outer binding's entries are dropped and the row's head and shapes are
/// recorded, formals included. So every reader sees the binding in scope,
/// exactly as `let x: T = ..` would show it: the Bool / Double / Char / Unit
/// classifiers, the show-target lookup, a nominal's renderer, a formal's
/// witness, and a composite that holds one (Codex on #3453). Anything else
/// gets the environment itself, without allocating.
///
/// #3456: the checker files a row for every name it types, scalars included,
/// and one naming `typed_render_unknown_name` for a type no row can spell
/// (a closure, a record), which seeds the name as fresh. So a missing row is
/// no answer at all: a lane that passes no rows, or an unlocated name. Such a
/// name keeps the outer binding's entries, as before #3434; a lane that wants
/// the shadow's own type must hand the rows over (`vibe check` does). Reading
/// a missing row as a fresh name instead rendered a same-type `Char` shadow as
/// its code point and an `Option` one as an address, and let a `Raw` without
/// `Show` past the missing-Show refusal.
/// #3559: `H::to_string(x)` names the one renderer `derive (Show)` generates
/// for a generic `H`, and that renderer erases the formals: `H::{ v: [1, 2] }`
/// printed `H { v: 280 }` while `"\{x}"` printed the content. Where this pass
/// knows the argument's instantiation, the call renders the way interpolation
/// does, field by field at the real types.
fn derived_generic_show_call(callee: Expr, args: Array[Expr], off: Int, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool with Exception {
  match callee {
    EIdent(n, _) => if Array::length(args) == 1 && String::ends_with(n, suffix = "::to_string") && n != Array::get(dtd_show_self_fn, at = 0) {
      let head = String::substring(n, start = 0, end = String::length(n) - 11)
      if show_generic_known(head) && has_derived_renderer(head) {
        let arg = Array::get(args, at = 0)
        let syn_sh = interp_shape(infer_shape(e = arg, struct_sets = struct_sets, var_types = render_classify_var_types(var_types = var_types, arg = arg), fn_returns = fn_returns))
        let sh = if String::starts_with(syn_sh, prefix = "{g:") {
          syn_sh
        } else {
          dtd_typed_render_shape_for(arg)
        }
        if String::starts_with(sh, prefix = "{g:") && generic_shape_head(sh) == head {
          true
        } else if !in_derived_renderer() && infer_arg_type_name(arg = arg, struct_sets = struct_sets, var_types = render_classify_var_types(var_types = var_types, arg = arg), fn_returns = fn_returns) == Some(head) {
          // An `H` whose type arguments are not known here (a generic
          // function's parameter): the derived renderer would print a field
          // through the erased formal, so refuse, as `"\{x}"` does (#3082).
          throw(derived_generic_show_unknown_msg(head = namespace_rename_original(head), off = off))
        } else {
          false
        }
      } else {
        false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #3559: the body being walked is a renderer `derive` generated (`X::to_string`
/// / `X::hash_key` of a derived type, or a `__` helper). Those render a field
/// through its own type's derived renderer by design.
fn in_derived_renderer() -> Bool {
  let cur = Array::get(dtd_show_self_fn, at = 0)
  if String::starts_with(cur, prefix = "__") {
    true
  } else if String::ends_with(cur, suffix = "::to_string") {
    has_derived_renderer(String::substring(cur, start = 0, end = String::length(cur) - 11))
  } else if String::ends_with(cur, suffix = "::hash_key") {
    has_derived_renderer(String::substring(cur, start = 0, end = String::length(cur) - 10))
  } else {
    false
  }
}

/// #3559: the refusal for `H::to_string(x)` where `x`'s type arguments are not
/// known, naming the edit.
fn derived_generic_show_unknown_msg(head: String, off: Int) -> String {
  let lead = String::concat("cannot call `", String::concat(head, "::to_string` here: the type arguments of this `"))
  let why = String::concat(head, "` are not known, and its derived renderer would print a field through an erased type parameter (an address for a `Double` or an array) -- call it where the type is concrete (e.g. `let v: ")
  let edit = String::concat(head, String::concat("[Double] = ...`, then `", String::concat(head, "::to_string(v)`), or write the renderer yourself (#3559)")))
  let base = String::concat(lead, String::concat(why, edit))
  if off >= 0 {
    String::concat(base, String::concat(" [@off=", String::concat(__to_string(off), "]")))
  } else {
    base
  }
}

fn render_classify_var_types(var_types: Array[(String, String)], arg: Expr) -> Array[(String, String)] {
  match arg {
    EIdent(n, off) => if off >= 0 && render_masked(var_types = var_types, name = n) {
      match dtd_typed_render_row_arg(arg) {
        // An annotation spells `Unit` by name, and that is what the Unit
        // classifier reads.
        Some(TyUnit) => seed_var_types(params = [(n, Some(TyName("Unit")))], tparams = dtd_scope_formals, base = var_types),
        // Typed, but as nothing a row spells (a closure, a record): a fresh
        // name, never the outer binding's type (Codex on #3458).
        Some(ty) => if dtd_typed_render_row_is_unknown(ty) {
          seed_var_types(params = [(n, None)], tparams = dtd_scope_formals, base = var_types)
        } else {
          seed_var_types(params = [(n, Some(ty))], tparams = dtd_scope_formals, base = var_types)
        },
        None => var_types
      }
    } else if off >= 0 && !has_var_entry(var_types = var_types, n = n) {
      // #3455: a FRESH name this pass could not type (`let q = match .. { true
      // => p, false => Pt::{ x: 1 } }`) had no entry, so nothing found its
      // renderer: a `Pt` rendered as an address. Read it through the
      // checker's row, as a masked name is. A row the default rendering
      // already answers (an `Int`, `String`, `Bool` or `Double`, which the
      // codegen channels type) needs no seeding, and an unknown one names no
      // renderer to seed.
      match dtd_typed_render_row_arg(arg) {
        Some(TyUnit) => seed_var_types(params = [(n, Some(TyName("Unit")))], tparams = dtd_scope_formals, base = var_types),
        Some(ty) => if fresh_render_row_needs_seeding(ty) {
          seed_var_types(params = [(n, Some(ty))], tparams = dtd_scope_formals, base = var_types)
        } else {
          var_types
        },
        None => var_types
      }
    } else {
      var_types
    },
    _ => var_types
  }
}

/// #3456: an untyped shadowing `let` (a masked name) whose row says the runtime
/// renderer cannot print its type. `render_classify_var_types` reads it as a
/// fresh name, and nothing in this pass renders that, so the build refuses it
/// in codegen (#2987), which no check lane runs. Refused here with the same
/// message, so `vibe check` answers what the build does (Codex on #3458).
///
/// Only a masked name: an entry-less one may be a constructor the pass renders
/// itself (`"\{None}"` is typed `Option[t]`, which the renderer cannot print,
/// and renders as `None`).
fn refuse_unrenderable_render_row(var_types: Array[(String, String)], arg: Expr) -> Unit with Exception {
  match arg {
    EIdent(n, off) => if off >= 0 && render_masked(var_types = var_types, name = n) {
      match dtd_typed_render_row_arg(arg) {
        Some(ty) => if dtd_typed_render_row_is_unrenderable(ty) {
          throw(unrenderable_render_message(arg))
        } else {
          ()
        },
        None => ()
      }
    } else {
      ()
    },
    _ => ()
  }
}

/// #3456: on a build lane with no checker rows (`dtd_rowless_build`), a
/// masked name -- an untyped `let` that shadows a typed one -- has only the
/// outer binding's type to render through, which is wrong whenever the shadow
/// changes the type (`let b = if c { 5 } else { 6 }` over `b: Option[Int]`
/// printed as an `Option`). Refused with the edit instead of answered.
fn refuse_rowless_masked_render(var_types: Array[(String, String)], arg: Expr) -> Unit with Exception {
  match arg {
    EIdent(n, off) => if Array::get(dtd_rowless_build, at = 0) && render_masked(var_types = var_types, name = n) {
      let at = if off >= 0 {
        String::concat(" [@off=", String::concat(Int::to_string(off), "]"))
      } else {
        ""
      }
      throw(String::concat("annotate the `let` that rebinds `", String::concat(n, String::concat("` with its type (`let ", String::concat(n, String::concat(": T = ...`): this build has no type for an unannotated `let` that shadows a typed name, so it cannot tell how to render `\\{", String::concat(n, String::concat("}`", at))))))))
    } else {
      ()
    },
    _ => ()
  }
}

fn has_var_entry(var_types: Array[(String, String)], n: String) -> Bool {
  match lookup_var_type(var_types = var_types, name = n) {
    Some(_) => true,
    None => false
  }
}

/// #3455: does a fresh name's render row name a type whose rendering the
/// entry-less default gets wrong? Everything but the scalars the codegen
/// channels already type, and the row that names no type at all.
fn fresh_render_row_needs_seeding(_ ty: TypeExpr) -> Bool {
  match ty {
    TyName(n) => !(n == "Int" || n == "String" || n == "Bool" || n == "Double" || dtd_typed_render_row_is_unknown(ty)),
    _ => true
  }
}

fn interp_expand_checked(arg: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  refuse_rowless_masked_render(var_types = var_types, arg = arg)
  refuse_unrenderable_render_row(var_types = var_types, arg = arg)
  // #3434: a masked name is read as the binding in scope, not through the
  // stale entries of an outer one it shadows (`render_classify_var_types`).
  let var_types = render_classify_var_types(var_types = var_types, arg = arg)
  dtd_check_top_interp(arg = arg, dict_binds = dict_binds, traits = traits, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
  let head = match infer_arg_type_name(arg = arg, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
    Some(h) => h,
    None => ""
  }
  let syn_sh = interp_shape(infer_shape(e = arg, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
  // #3066: where this pass expands the argument itself, the checker's type
  // (a render row) outranks the syntactic shape. The syntax is exact for a
  // literal, but a payload it cannot type -- `Some(k())` through a local
  // lambda -- was rendered by the pointer heuristic (`Some(0)` for
  // `Some(false)`); the checker knows it.
  // #3081 review: an argument with no offset (an `if`, a `match`, a block)
  // has no syntactic head either, so the gate below would never ask; it is
  // shaped from its arms (`dtd_offsetless_shape`), and `interp_shape` keeps
  // only a composite answer.
  let typed_sh = if typed_lowering_arg_offset(arg) < 0 {
    interp_shape(dtd_offsetless_shape(e = arg, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
  } else if dtd_interp_expands_itself(sh = syn_sh, head = head) {
    dtd_typed_render_shape_for(arg)
  } else if String::length(head) == 0 || dtd_head_is_leaked_formal(head) {
    // #3074: a value this pass cannot name at all (`pair.0` holding a
    // `G[Bool]`) takes the checker's row: the erased renderer, or an
    // address, is all that is left for it otherwise. #3084: so does a head
    // that names nothing here -- a generic function's result, typed by the
    // callee's own formal (`pass(Some(true))` answers `T`); the gc lane
    // printed its address.
    dtd_unnamed_head_row(arg = arg, head = head)
  } else {
    ""
  }
  let sh = if String::length(typed_sh) > 0 {
    typed_sh
  } else {
    syn_sh
  }
  if String::length(sh) > 0 {
    Some(interp_expand_shape(subject = arg, sh = sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns))
  } else {
    let as_show = dtd_show_witness_dict(dict_binds = dict_binds, traits = traits, head = head)
    // #2737: a promised `Show` witness with no dictionary renders the value's
    // representation rather than the value, so it is refused here too.
    dtd_check_unthreaded_interp(resolved = as_show, head = head, traits = traits, fn_returns = fn_returns)
    match as_show {
      Some(dict_pname) => Some(ECall(EDot(EIdent(dict_pname, -1), "to_string", -1, -1), [
        arg
      ], -1, [])),
      None => interp_expand_local(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    }
  }
}

fn interp_expand_local(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  match arg {
    ETuple(items) => Some(interp_join(items = items, open_s = "(", sep = ", ", close_s = ")", derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)),
    EArray(items) => Some(interp_join(items = items, open_s = "[", sep = ", ", close_s = "]", derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)),
    EIdent(n, _) => if n == "None" && head == "Option" {
      Some(EString("None", -1))
    } else {
      // #1445: a tuple or array reached through a NAME. The shape came from
      // the binding site (tuple_shape_bind / array_elem_bind) or from a
      // parameter annotation (seed_var_types), which is what the head name
      // alone could never supply.
      // #139: the recursive shape first -- it is the only one that can carry
      // a nested tuple/array. The two older sentinels still answer for a
      // binding shape_bind declined to record (a PARAMETER annotation, which
      // seeds them directly and never goes through bind_shapes).
      match lookup_var_type(var_types = var_types, name = shape_key(n)) {
        // A RECORDED shape is the binding site's answer, empty or not: an
        // empty one means the innermost binding of `n` is not a tuple/array,
        // so the older sentinels (which a shadowing rebind does not clear)
        // must NOT be consulted. Only a name with no record at all -- a
        // parameter, seeded directly by seed_var_types -- falls through.
        Some(sh) => if shape_is_composite(sh) {
          Some(interp_expand_shape(subject = EIdent(n, -1), sh = sh, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns))
        } else {
          interp_expand_by_head(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
        },
        None => match lookup_var_type(var_types = var_types, name = tuple_shape_key(n)) {
          Some(sentinel) => Some(interp_expand_var_tuple(name = n, elem_types = tuple_shape_parts(sentinel), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)),
          None => match array_elem_type_of(var_types = var_types, name = n) {
            Some(_) => Some(interp_expand_var_array(name = n, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)),
            None => interp_expand_by_head(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
          }
        }
      }
    },
    ECall(callee, cargs, _, _) => match callee {
      EIdent(cn, _) => if Array::length(cargs) == 1 && ((head == "Option" && cn == "Some") || (head == "Result" && (cn == "Ok" || cn == "Err"))) {
        Some(interp_wrap1(ctor = cn, payload = Array::get(cargs, at = 0), derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns))
      } else {
        interp_expand_by_head(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
      },
      _ => interp_expand_by_head(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    },
    _ => interp_expand_by_head(arg = arg, head = head, derived_only = derived_only, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  }
}

export fn user_assert_eq_reset(_ stmts: Array[Stmt]) -> Unit {
  Array::set(dtd_user_assert_eq, at = 0, value = -1)
  Array::set(dtd_user_assert_eq_range, at = 0, value = 0)
  Array::set(dtd_user_assert_eq_range, at = 1, value = -1)
  Array::set(dtd_user_assert_eq_alias_blocker, at = 0, value = 0)
  Array::truncate(dtd_user_assert_eq_program, length = 0)
  Array::push(dtd_user_assert_eq_program, value = stmts)
}

export fn plain_reexport_binds(items: Array[ImportItem], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, at = i)
    if item.name == wanted && item.alias == None {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn reexport_blockers_bind_assert_eq(_ names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = Array::get(names, at = i) == "assert_eq"
    i = i + 1
  }
  found
}

export fn merged_source_range_end(stmts: Array[Stmt], start: Int) -> Int {
  let mut end = start
  while end < Array::length(stmts) && merged_source_boundary_local_names(Array::get(stmts, at = end)) == None {
    end = end + 1
  }
  end
}

export fn merged_source_boundary_local_names(_ stmt: Stmt) -> Option[Array[String]] {
  match builtin_iterator_serialized_boundary_markers(stmt) {
    Some(local_names) => Some(local_names),
    None => match stmt {
      SReExportSourceBoundary(local_names, _) => Some(local_names),
      _ => None
    }
  }
}

export fn user_assert_eq_set_merged_source(stmts: Array[Stmt], start: Int, names: Array[String]) -> Unit {
  Array::set(dtd_user_assert_eq, at = 0, value = -1)
  Array::set(dtd_user_assert_eq_range, at = 0, value = start)
  Array::set(dtd_user_assert_eq_range, at = 1, value = merged_source_range_end(stmts = stmts, start = start))
  Array::set(dtd_user_assert_eq_alias_blocker, at = 0, value = if reexport_blockers_bind_assert_eq(names) {
    1
  } else {
    0
  })
}

fn assert_eq_concat(a: Expr, b: Expr) -> Expr {
  ECall(builtin_ref("String::concat"), [a, b], -1, [])
}

/// Render one `assert_eq` operand. Reuses the throw-site renderer
/// (`derived_only`) so a missing Show becomes `<unprintable>` instead of a
/// pointer decimal or a compile error.
fn assert_eq_render(arg: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let target = interp_show_target(arg = arg, derived_only = true, struct_sets = struct_sets, var_types = render_classify_var_types(var_types = var_types, arg = arg), fn_returns = fn_returns)
  if target != "" {
    ECall(EIdent(target, -1), Array::slice([arg], start = 0, end = 1), -1, [])
  } else {
    let expanded = interp_expand(arg = arg, derived_only = true, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
    if interp_has_repl(expanded) {
      interp_take_repl(expanded)
    } else {
      match infer_arg_type_name(arg = arg, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
        Some(tn) => if is_scalar_type_name(tn) {
          ECall(builtin_ref("__to_string"), Array::slice([arg], start = 0, end = 1), -1, [])
        } else {
          EString("<unprintable>", -1)
        },
        None => {
          let as_scalar = match arg {
            EInt(_) => true,
            EBool(_) => true,
            EString(_, _) => true,
            EFloat(_) => true,
            _ => false
          }
          if as_scalar {
            ECall(builtin_ref("__to_string"), Array::slice([arg], start = 0, end = 1), -1, [])
          } else {
            EString("<unprintable>", -1)
          }
        }
      }
    }
  }
}

fn lower_assert_eq(args: Array[Expr], call_off: Int, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let a2 = rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  let b2 = rewrite_expr(expr = Array::get(args, at = 1), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
  let an = dinsp_fresh_name(base = "__assert_eq_actual", value = a2, content = b2)
  let en = dinsp_fresh_name(base = "__assert_eq_expected", value = a2, content = b2)
  let vars1 = bind_shapes(var_types = extend_var_types(var_types = var_types, name = an, inferred = infer_arg_type_name(arg = a2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)), name = an, val = a2, struct_sets = struct_sets, fn_returns = fn_returns)
  let vars2 = bind_shapes(var_types = extend_var_types(var_types = vars1, name = en, inferred = infer_arg_type_name(arg = b2, struct_sets = struct_sets, var_types = vars1, fn_returns = fn_returns)), name = en, val = b2, struct_sets = struct_sets, fn_returns = fn_returns)
  let actual = EIdent(an, -1)
  let expected = EIdent(en, -1)
  let actual_s = assert_eq_render(arg = actual, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vars2, fn_returns = fn_returns)
  let expected_s = assert_eq_render(arg = expected, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vars2, fn_returns = fn_returns)
  // The trailing `assert failed: aborting` line closes the diagnostic and
  // says what happens next -- the trap that follows is this assert's own
  // deliberate abort, not a second failure. It doubles as the marker the
  // test condensers (scripts/vibe_test.sh / runtime/vibe) key on to
  // suppress the trap echo (#2202, Codex rounds 2-3 on #2213): rendered
  // values may contain newlines and a test's own output may imitate the
  // block, so the block text alone cannot identify the abort. The
  // condensers hide the line; in a plain `vibe run` it reads as ordinary
  // diagnostic prose rather than harness protocol.
  // #2202: bake the call's source offset so `vibe test` can print a line
  // number. The condenser maps `at off=N` using the source file.
  let msg = assert_eq_concat(a = EString(String::concat("assert_eq failed\n  at off=", String::concat(__to_string(call_off), "\n  expected: ")), -1), b = assert_eq_concat(a = expected_s, b = assert_eq_concat(a = EString("\n  actual:   ", -1), b = assert_eq_concat(a = actual_s, b = EString("\nassert failed: aborting", -1)))))
  // stdout, not Stderr::write_stream: the gc lane only reserves host
  // imports when the source already used one, and flipping that on a
  // SIMD-only file shifts every generated-body index (gc-gate
  // simd_skip_ws_test). `vibe test` now keeps stdout on FAIL so the
  // diagnostic still reaches vt_fail_detail.
  //
  // #2107: `println` here means `assert_eq` REQUIRES `Console` in the
  // function containing it -- this expansion runs before the checker, so the
  // row lands on the caller. That is the honest reading (the branch really
  // does write to the console) and it is the same rule `inspect` follows.
  // In practice it costs nothing: a `test` / `bench` block is granted the
  // standard test effect set, which includes Console, and that is where
  // assertions live. A plain function asserting outside a test block declares
  // `with Console`, as `fixtures/gc_backend_smoke_test.vibe` now does.
  //
  // The internal printer `print_str` looks like the way to avoid that and is
  // not: its wasm signature takes two params (the string as a pair), it is
  // `checker_visible=false`, and codegen only ever emits it with that ABI
  // from a lowering -- a vibe-level call to it is `unknown name` at the
  // checker and a broken module past it. Introducing a rowless vibe-callable
  // printer just to keep this branch quiet would re-open the exact escape
  // #2107 closed, one dunder away.
  let fail = ESeq(ECall(EIdent("println", -1), [msg], -1, []), ECall(EIdent("assert_true", -1), [
    EBool(false)
  ], -1, []))
  let cmp = rewrite_expr(expr = EBinOp("==", actual, expected, -1), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = vars2, fn_returns = fn_returns)
  ELet(an, a2, ELet(en, b2, EIf(cmp, EUnit, fail), -1), -1)
}

/// The core rewriter. `dict_binds` is non-empty only inside a transformed
/// generic's body (so `T::method` resolves to a dict field); call-site dict
/// threading applies everywhere a transformed generic is called. `var_types`
/// tracks locals/params whose concrete type is known, for call-site dict
/// synthesis when the receiver is a variable.
fn rewrite_expr(expr: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match expr {
    EIdent(name, _) => if str_array_contains(arr = dtd_generic_show_shims, val = name) {
      throw("wrap the renderer in a lambda with a concrete parameter type: a generic rendering shim must be called directly so its argument type remains available")
    },
    _ => ()
  }
  match expr {
    EIdent(name, off) => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        let as_method = find_dict_for_method(dict_binds = dict_binds, head = head, member = member)
        match as_method {
          Some(dict_pname) => {
            // #3580: a method with a bounded binder of its own takes those
            // witnesses ahead of its arguments, from the call; a value has no
            // call to read them from.
            if Array::length(trait_method_witness_slots(traits = traits, trait_name = dict_binds_trait(dict_binds = dict_binds, dict_pname = dict_pname), method = member)) > 0 {
              throw("call `" + name + "(..)` directly instead of taking it as a value, or wrap it in a lambda with concrete parameter types: `" + member + "` has bounded type parameters of its own, whose witnesses a call through the trait reads from its arguments")
            } else {
              ()
            }
            EDot(EIdent(dict_pname, -1), member, -1, -1)
          },
          None => match qual_ctor_member(head = head, member = member, struct_sets = struct_sets, fn_returns = fn_returns) {
            Some(m) => EIdent(m, off),
            None => {
              // Codex on #3627: a derived generic renderer named as a value.
              if member == "to_string" && name != Array::get(dtd_show_self_fn, at = 0) && !in_derived_renderer() && has_derived_renderer(head) && show_generic_reads_formal(head) {
                throw(derived_generic_show_value_msg(head = namespace_rename_original(head), off = off))
              }
              // #2737 (Codex, P1 on the first commit): a trait method taken as a
              // VALUE -- `let cmp = T::equals` -- is a fourth route into the same
              // hole, and it reaches this arm rather than either call site. Left
              // alone the name stayed unresolved exactly as the qualified CALL
              // did: measured, `cmp(a, b)` for `7, 8` inside a shadowing
              // `[T: Eq]` lambda answered `true` through `Pt::equals`, both
              // before this pass's guard and after it.
              //
              // Placed on the LAST branch, after the constructor lookup: a
              // formal's spelling can collide with an enum whose
              // `Enum::Variant` this arm resolves, and that is a real
              // resolution, not a missing witness.
              dtd_check_unthreaded_dispatch(resolved = as_method, head = head, member = member, qualified = name, traits = traits, fn_returns = fn_returns)
              // A qualified generic (`fn Util::same[T: Eq]`) named as a value
              // loses its witness the same way an unqualified one does.
              dtd_check_threaded_generic_value(name = name, gens = gens, var_types = var_types)
              expr
            }
          }
        }
      },
      None => {
        dtd_check_threaded_generic_value(name = name, gens = gens, var_types = var_types)
        expr
      }
    },
    ECall(callee, args, off, callee_resolution) => {
      // #635: type-directed lowering of the railway sentinels emitted by the
      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type
      // info from the parser; here `infer_arg_type_name(val)` picks Option vs
      // Result (default Result when undeterminable — today's behavior). A user
      // function literally named `__try_bind`/`__try_op` with the wrong shape
      // (handled by `try_sentinel` returning None) takes the generic path.
      let try_kind = try_sentinel(callee = callee, args = args)
      // #1392: the interpolation replacement, computed once here rather than
      // inside the else-if chain below so the resolvers run at most once per
      // call site. Slice 1 (the argument's type names a `T::to_string`) wins
      // over slice 2 (the argument is, or is headed by, a wrapper).
      let interp_repl = if is_interp_to_string_call(callee = callee, args = args) || is_show_shim_call(callee = callee, args = args) || derived_generic_show_call(callee = callee, args = args, off = off, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
        // #2745 (Codex, P1 on #2761): FIRST, ahead of every rendering path below.
        // All of them key on the argument's type NAME, and a nested formal is a
        // NAME -- so a binder spelled like a type they recognise takes that
        // type's rendering on an erased value.
        //
        // Measured on the first cut of this fix, which ran the check after them:
        // `let inner = [Bool](a: Bool) -> String { "\{a}" }` applied to a struct
        // printed `true`, the struct's pointer read as a Bool by
        // `interp_arg_is_bool`; `[Option]` reached the wrapper arm and trapped.
        //
        // The BUILTIN spellings are what leak, and only they: a formal named
        // after a DECLARED type is refused upstream by #2141's shadowing guard
        // (measured -- `[Qt]` where `struct Qt` exists gives "type parameter `Qt`
        // ... shadows the declared type"), which never sees `Bool` / `Option` /
        // `Result` because they are not declarations. Rather than enumerate them
        // here -- the enumeration is the bug, a condition applied through
        // whichever spelling happened to be in front of it -- this asks about the
        // BINDER before any spelling is consulted.
        // WHICH message, decided here rather than by which check happens to run
        // first. Hoisting this above the rendering paths also lifted it above
        // #2737's interp refusal, and a `[T: Show]` lambda is BOTH -- erased, and
        // carrying a bound nothing honours. #2737 offers the more specific edit
        // of lifting the bounded lambda and diagnosis (the bound you wrote is not threaded),
        // so it wins when the binder's bound promised a renderer. Choosing on the
        // FACT keeps that true no matter where either check sits.
        // #2773: the erased-formal REFUSAL used to live here, driven by
        // `dtd_erased_interp_formal` -- a walk that answered "is this
        // interpolated value an erased formal?" from syntax, in a pass with no
        // types, carrying an ad-hoc environment. Twenty-six review rounds found
        // sixty-three routes past it and the rate did not fall.
        //
        // The checker refuses these now, including the one shape that was
        // load-bearing here (`shim(if c { a } else { a })`, where a top-level
        // rendering shim's body exemption had no call-site counterpart). It has
        // types, so it answers the question instead of approximating it, and
        // its refusal carries a location this one never did.
        //
        // Measured before removing it: with the walk stubbed to answer "",
        // every one of the 65 `lambda_bound_*_refused.vibe` fixtures still
        // refused, so did all three routes #2773 listed as open, and the
        // 1315-file unit corpus kept both programs refused -- what changed was
        // only WHICH channel reports them.
        // #3007: a `derive (Show)` generic struct whose instantiation this pass
        // can see renders field by field (`interp_expand_shape`'s `{g:` arm);
        // its one derived `to_string` erases the formals.
        // #3434: the type queries below read a masked name as unknown.
        let cvt = render_classify_var_types(var_types = var_types, arg = Array::get(args, at = 0))
        let generic_syn_sh = interp_shape(infer_shape(e = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns))
        // #3074: the checker's render row supplies the instantiation where the
        // syntax does not (a call result, a binder it never recorded).
        let generic_head = match infer_arg_type_name(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          Some(h) => h,
          None => ""
        }
        // #3084: a head that names nothing here -- a generic function's
        // result is typed by its declared return, the callee's own formal
        // (`pass(Pt::{ x: 1 })` answers `T`) -- takes the checker's row, which
        // has the call site's instantiation.
        let head_leaked = dtd_head_is_leaked_formal(generic_head)
        let leaked_row = if head_leaked && !String::starts_with(generic_syn_sh, prefix = "{g:") {
          dtd_typed_render_raw_shape_for(Array::get(args, at = 0))
        } else {
          ""
        }
        let generic_show_sh = if String::starts_with(generic_syn_sh, prefix = "{g:") {
          generic_syn_sh
        } else if head_leaked {
          let admitted = interp_shape(leaked_row)
          if String::length(admitted) > 0 {
            admitted
          } else {
            generic_syn_sh
          }
        } else if show_generic_known(generic_head) {
          let row_sh = dtd_typed_render_shape_for(Array::get(args, at = 0))
          if String::starts_with(row_sh, prefix = "{g:") {
            row_sh
          } else {
            generic_syn_sh
          }
        } else {
          generic_syn_sh
        }
        // #3084: the row names a plain nominal (`Pt`, a non-generic enum):
        // its renderer, as if the value had been annotated. A `derive (Show)`
        // generic named without its arguments is refused below.
        let leaked_nominal = if head_leaked && String::length(interp_shape(leaked_row)) == 0 && dtd_row_is_bare_nominal(leaked_row) {
          leaked_row
        } else {
          ""
        }
        if String::length(leaked_nominal) > 0 && show_generic_known(leaked_nominal) {
          throw(interp_generic_enum_unknown_msg(ename = namespace_rename_original(leaked_nominal), off = off))
        } else if String::length(leaked_nominal) > 0 && !is_scalar_type_name(leaked_nominal) && struct_set_has(struct_sets = struct_sets, name = leaked_nominal) && !fn_exists(fn_returns = fn_returns, fname = String::concat(leaked_nominal, "::to_string")) {
          throw(interp_missing_show_msg(tn = namespace_rename_original(leaked_nominal), off = off))
        } else {
          ()
        }
        let show_target = if String::starts_with(generic_show_sh, prefix = "{g:") {
          ""
        } else if String::length(leaked_nominal) > 0 && !is_scalar_type_name(leaked_nominal) && fn_exists(fn_returns = fn_returns, fname = String::concat(leaked_nominal, "::to_string")) && String::concat(leaked_nominal, "::to_string") != Array::get(dtd_show_self_fn, at = 0) {
          String::concat(leaked_nominal, "::to_string")
        } else {
          interp_show_target(arg = Array::get(args, at = 0), derived_only = false, struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns)
        }
        // #3074: the only renderer left is the derived one, which erases the
        // enum's formals -- `G[Bool]` printed `GA(1)`. A payload-free
        // constructor renders its name at any instantiation; anything else is
        // refused rather than printed through the erased formal. #3082: a
        // generic struct the same way (`o.b` holding a `Box[Bool]` printed
        // `Box { v: 1 }`).
        if show_target != "" && show_generic_known(generic_head) && !show_generic_enum_nullary(Array::get(args, at = 0)) {
          throw(interp_generic_enum_unknown_msg(ename = namespace_rename_original(generic_head), off = off))
        } else {
          ()
        }
        if show_target != "" {
          Some(ECall(EIdent(show_target, -1), Array::slice([
            rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
          ], start = 0, end = 1), off, callee_resolution))
        } else if interp_arg_is_bool(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          // #1527: a Bool that reaches `"\{...}"` through a CALL or a NAME
          // whose recorded type is Bool printed `1`/`0` — Bool and Int share
          // the tagged-int representation, and codegen's boolish classifiers
          // (cc_expr_is_boolish and its per-backend twins) are syntactic:
          // they know literals, comparisons and bool-returning BUILTINS, but
          // not a user fn's declared `-> Bool`. This pass has that type
          // (fn_returns / var_types / struct field heads), so rewrite the
          // rendering here, once, for every backend: the `__to_string(arg)`
          // becomes `if arg { "true" } else { "false" }`. A Bool LITERAL is
          // excluded — every classifier already answers it, and skipping it
          // keeps the common case's lowering untouched.
          Some(EIf(rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns), EString("true", -1), EString("false", -1)))
        } else if interp_arg_is_float(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          // #3543: a Float renders as the shortest f32 decimal.
          Some(ECall(builtin_ref("Float::to_string"), Array::slice([
            rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
          ], start = 0, end = 1), off, callee_resolution))
        } else if interp_arg_is_double(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          // #2993: the same gap for a Double. A container's element reaches
          // here as a synthesized binder (`let __show_vN = Array::get(xs, i)`)
          // whose recorded type is Double, but codegen's floatish classifiers
          // cannot see that binder's type, so `[1.5, 2.25]` rendered the boxed
          // Doubles' addresses (`[352, 360]`). This pass knows the type, so it
          // names the renderer.
          Some(ECall(builtin_ref("Double::to_string"), Array::slice([
            rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
          ], start = 0, end = 1), off, callee_resolution))
        } else if interp_arg_is_char(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          // #3075: a `Char` printed its code point (`97` for `'a'`).
          Some(char_render_expr(rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)))
        } else if interp_arg_is_unit(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns) {
          // #3075: a `Unit` printed `0` (`Some(())` -> `Some(0)`).
          Some(unit_render_expr(rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)))
        } else {
          let saved_site_off = Array::get(dtd_interp_site_off, at = 0)
          Array::set(dtd_interp_site_off, at = 0, value = off)
          let expanded = interp_expand(arg = Array::get(args, at = 0), derived_only = false, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
          Array::set(dtd_interp_site_off, at = 0, value = saved_site_off)
          // #1445: nothing rendered it structurally AND the type is a declared
          // aggregate with no renderer -- that is a missing `derive(Show)`, and
          // falling through here would print a pointer decimal.
          if interp_has_repl(expanded) {
            expanded
          } else {
            let missing = interp_missing_show_type(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns)
            let unresolved_array = interp_unresolved_array_call(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = cvt, fn_returns = fn_returns)
            if missing != "" {
              throw(interp_missing_show_msg(tn = missing, off = off))
            } else if String::length(unresolved_array) > 0 {
              // #2912: the same reasoning as #1445 one line up, for an array
              // instead of a declared aggregate. Both reach here having failed
              // to render, and both would otherwise print a pointer decimal.
              throw(interp_unresolved_array_msg(unresolved_array))
            } else if is_show_shim_call(callee = callee, args = args) {
              // #2468: nothing HERE resolved it, and for a shim call leaving
              // the call standing is not the same as leaving a `__to_string`
              // standing. A shim is by definition `fn s(x) { __to_string(x) }`,
              // so `s(arg)` and `__to_string(arg)` are one lowering -- but only
              // the second is a render call to CODEGEN, which is where the
              // typed-lowering channel (#2424/#2462) and the syntactic boolish
              // classifiers get their turn. Left as `s(arg)` the argument was
              // never classified and the two spellings of one render disagreed:
              //
              //   __to_string(l())  ->  "true"      to_string(l())  ->  "1"
              //
              // Rewriting to the direct spelling, at the SAME call offset, is
              // what makes them one answer again. The callee is unreachable
              // afterwards only if nothing else calls it; that is DCE's
              // business, not this pass's.
              Some(ECall(builtin_ref("__to_string"), Array::slice([
                rewrite_expr(expr = Array::get(args, at = 0), gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
              ], start = 0, end = 1), off, callee_resolution))
            } else {
              expanded
            }
          }
        }
      } else {
        None
      }
      if try_kind == 0 {
        // __try_bind(val, (name) -> rest)
        let val = Array::get(args, at = 0)
        match Array::get(args, at = 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, at = 0)
            let rwval = rewrite_expr(expr = val, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            // `name` is a local binding in `rest`, so it masks a function of
            // the same spelling the way any other binder does: in the gens, so
            // a threaded generic's dictionary is not handed to it, and in
            // `var_types`, so a call through it is not typed by that
            // function's declared result (Codex on #3299).
            let body_vars = dtd_mask_shadowed_params(var_types = extend_var_types(var_types = var_types, name = name, inferred = railway_bind_payload_type(val = val, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)), ps = [
              (name, None)
            ], fn_returns = fn_returns)
            let rwrest = rewrite_expr(expr = rest, gens = gens_masked_by(gens = gens, names = [name]), traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = body_vars, fn_returns = fn_returns)
            lower_try_bind(val = rwval, name = name, rest = rwrest)
          },
          _ => EUnit
        }
      } else if try_kind == 1 {
        // __try_op(val)
        let val = Array::get(args, at = 0)
        let rwval = rewrite_expr(expr = val, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
        lower_try_op(rwval)
      } else if interp_has_repl(interp_repl) {
        // #1392: the interpolation of a value this pass can render.
        interp_take_repl(interp_repl)
      } else if is_assert_eq_call(callee = callee, args = args) {
        lower_assert_eq(args = args, call_off = off, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
      } else if !exn_kind_suppressed() && is_exception_kind_read(callee = callee, args = args) {
        // #1374: `__exn_kind()` is a checker-only intrinsic (typed
        // `() -> String` in checker/builtin_sigs/builtins_misc.vibe, no wasm body) -- it
        // exists so a handler arm can spell the read, and it is gone by the
        // time either backend sees the program.
        exn_kind_mark_used()
        exn_kind_read_expr()
      } else if !exn_kind_suppressed() && is_exception_message_read(callee = callee, args = args) {
        // #1392 slice 3: the companion read. Same checker-only intrinsic shape
        // as `__exn_kind()`.
        exn_kind_mark_used()
        exn_msg_read_expr()
      } else if !exn_kind_suppressed() && is_perform_throw_shape(callee = callee, args = args) {
        // #1374: record the payload's static type name for the handler. The
        // write is UNCONDITIONAL, including the empty name for a payload this
        // pass cannot resolve -- leaving the slot alone there would let an
        // earlier throw's kind be read as this one's.
        //
        // The resolver is codegen's own `infer_arg_type_name`, not the
        // checker's `throw_payload_kind`: both answer the same question from
        // the same syntax, but the checker's table is TypeEnv-derived state
        // that does not reach codegen, and this pass already carries
        // `var_types`/`fn_returns` for every expression it visits. They can
        // disagree only by one being MORE conservative (an unresolved name is
        // ""), which costs a kind here and a row precision there, never
        // soundness.
        // #1878 (Codex review on #1892): `infer_arg_type_name` can answer
        // with an internal shape sentinel (`__anonrec:` for a record
        // binding, `__anontup:` for a tuple carrying one) — inert for every
        // dispatch consumer, but THIS site publishes the string as the
        // user-facing exception kind, where a sentinel would render as
        // `<__anontup:__anonrec:a;>`. Publish "" instead, the same value an
        // unresolved payload gets (the erased sink then falls back to the
        // safely rendered payload).
        let kind0 = match infer_arg_type_name(arg = perform_throw_payload(args), struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
          Some(k) => k,
          None => ""
        }
        let kind = if String::starts_with(kind0, prefix = anon_record_prefix()) || String::starts_with(kind0, prefix = anon_tuple_prefix()) {
          ""
        } else {
          kind0
        }
        let rwargs = for a in args {
          rewrite_expr(expr = a, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
        }
        exn_kind_mark_used()
        // The write has to land AFTER the payload is evaluated, not before.
        // There is ONE slot, so anything the payload expression does that
        // reaches a throw -- even one it handles itself -- overwrites the kind
        // this site just recorded. `throw(payload())` where `payload()`
        // internally catches a `throw(Bang(1))` and returns a String would
        // otherwise leave `Boom` in the slot and be reported as `<Boom>`
        // instead of its own message. Binding the payload first makes the
        // write the last thing before the perform.
        let pname = exn_kind_fresh_payload_name()
        // #1392 slice 3: render the payload HERE, where its type is known, and
        // carry the string alongside the kind. The erased arm cannot do this
        // itself at any later point -- see exn_kind_cell_stmt's comment.
        //
        // The renderer is the ordinary interpolation path, run against the
        // payload TEMP with `kind` injected into var_types. Rendering the
        // original payload expression instead would evaluate it twice; the
        // temp is exactly the same value and `kind` is exactly the type
        // `infer_arg_type_name` just derived from that expression.
        //
        // The slot is written ONLY when a STRUCTURAL renderer was found, and
        // is cleared otherwise. The reader cannot make that distinction
        // itself: `__to_string`'s pointer decimal is a perfectly ordinary
        // non-empty string, so a reader that trusted any non-empty slot would
        // print `192` for an enum without `derive(Show)` -- strictly worse
        // than the `<Kind>` #1374 already prints there. Faithfulness is a
        // static property of this site, so it is decided here.
        //
        // #1398 review (Codex P2): "" is therefore a sentinel, and it is a
        // sound one only because every renderer reachable from here produces a
        // NON-EMPTY string by construction. `derived_only` (Codex P1, above)
        // is what makes that true: a derived struct renderer opens with the
        // type name (`P { ..`), a derived enum renderer IS a variant name, and
        // the wrapper expansions are `Some(..)`/`Ok(..)`/`Err(..)`/`None`. A
        // user-written formatter could legitimately return "" -- and is no
        // longer called from here at all.
        //
        // #3532: a payload that is an enclosing exception arm's own binder is
        // a re-throw. Its arm saved what the original throw published
        // (`exn_rethrow_enter`), so it writes that back instead of rendering
        // the binder here, where an erased arm leaves it with no type.
        let rethrow = exn_rethrow_restore(perform_throw_payload(args))
        let (kind_write, msg_write) = if rethrow >= 0 {
          (exn_kind_write_value(EIdent(exn_rethrow_saved_kind_name(rethrow), -1)), exn_msg_write_expr(EIdent(exn_rethrow_saved_msg_name(rethrow), -1)))
        } else {
          let render_vars = if kind == "" {
            var_types
          } else {
            extend_var_types(var_types = var_types, name = pname, inferred = Some(kind))
          }
          let render_target = interp_show_target(arg = EIdent(pname, -1), derived_only = true, struct_sets = struct_sets, var_types = render_vars, fn_returns = fn_returns)
          let rendered = if render_target != "" {
            Some(ECall(EIdent(render_target, -1), Array::slice([
              EIdent(pname, -1)
            ], start = 0, end = 1), -1, []))
          } else {
            interp_expand(arg = EIdent(pname, -1), derived_only = true, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = render_vars, fn_returns = fn_returns)
          }
          (exn_kind_write_expr(kind), exn_msg_write_expr(if interp_has_repl(rendered) {
            interp_take_repl(rendered)
          } else {
            EString("", -1)
          }))
        }
        ELet(pname, perform_throw_payload(rwargs), ESeq(kind_write, ESeq(msg_write, ECall(callee, perform_throw_with_payload(args = rwargs, payload = EIdent(pname, -1)), off, callee_resolution))), -1)
      } else {
        let rwargs = for a in args {
          rewrite_expr(expr = a, gens = gens, traits = traits, struct_sets = struct_sets, dict_binds = dict_binds, var_types = var_types, fn_returns = fn_returns)
        }
        match map_index_rewrite(callee = callee, args = args, rwargs = rwargs, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, typed = true) {
          Some(map_get) => map_get,
          None =>
          match callee {
            EIdent(name0, coff) => {
              // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->
              // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.
              let name_ctor = match split_qualified(name0) {
                Some(parts0) => {
                  let (h0, m0) = parts0
                  match qual_ctor_member(head = h0, member = m0, struct_sets = struct_sets, fn_returns = fn_returns) {
                    Some(mm) => mm,
                    None => name0
                  }
                },
                None => name0
              }
              // #736 residual: bare method-style callee — `xs |> length` is
              // `length(xs)`; with only the receiver TYPE imported there is no
              // top-level `length`, so resolve to `<type-of-arg0>::length` (USER
              // types only, and only when no top-level fn of the bare name exists
              // — a lexically visible `length` keeps normal call semantics). The
              // checker applies the same rule, so typing and codegen agree.
              let name = if String::index_of(name_ctor, needle = "::") < 0 && !fn_exists(fn_returns = fn_returns, fname = name_ctor) && Array::length(args) >= 1 {
                match infer_arg_type_name(arg = Array::get(args, at = 0), struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", name_ctor))
                    if struct_set_has(struct_sets = struct_sets, name = tn) && fn_exists(fn_returns = fn_returns, fname = qual) {
                      qual
                    } else {
                      name_ctor
                    }
                  },
                  None => name_ctor
                }
              } else {
                name_ctor
              }
              // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.
              let as_method = match split_qualified(name) {
                Some(parts) => {
                  let (head, member) = parts
                  find_dict_for_method(dict_binds = dict_binds, head = head, member = member)
                },
                None => None
              }
              // #2737: a promised witness with no dictionary is refused here
              // rather than left to codegen, which lowers the unresolved name to
              // a table call on a bogus index.
              match split_qualified(name) {
                Some(promised) => {
                  let (phead, pmember) = promised
                  dtd_check_unthreaded_dispatch(resolved = as_method, head = phead, member = pmember, qualified = name, traits = traits, fn_returns = fn_returns)
                },
                None => ()
              }
              let array_intrinsic = iterator_array_intrinsic(name = name, args = args, gens = gens, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
              match array_intrinsic {
                Some(intrinsic) => ECall(iterator_array_intrinsic_callee(intrinsic = intrinsic, coff = coff), rwargs, off, callee_resolution),
                None => match as_method {
                  Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), concat_expr_arrays(a = method_witness_call_dicts(dict_binds = dict_binds, dict_pname = dict_pname, member = member_of(name), orig_args = args, traits = traits, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns, gens = gens), b = rwargs), off, callee_resolution),
                  None => match lookup_gen_entry(gens = gens, name = name) {
                    Some(gen) => match synth_dicts_if(prepend = gen_prepends_dicts(gen), callee_type_params = gen.type_params, threaded = gen.threaded, constructor_recvs = gen.constructor_recvs, nested_recvs = gen.nested_recvs, param_types = gen.param_types, args = args, traits = traits, struct_sets = struct_sets, var_types = var_types, dict_binds = dict_binds, fn_returns = fn_returns, gens = gens) {
                      Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(a = dicts, b = rwargs), off, callee_resolution),
                      None => ECall(EIdent(name, coff), rwargs, off, callee_resolution)
                    },
                    None => ECall(EIdent(name, coff), rwargs, off, callee_resolution)
                  }
                }
              }
            },
            EDot(obj, m, doff, fdoff) => {
              // #736 residual: method-style call `xs.length()` on a USER type —
              // codegen compiles a called EDot as struct-field access, so a
              // receiver method (`List::length`) failed with "unknown struct
              // field". Rewrite to the qualified call when the receiver's type is
