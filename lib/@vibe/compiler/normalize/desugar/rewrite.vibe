/// Render one sub-expression by re-entering the interpolation rewrite on a
/// synthetic `__to_string(sub)`, so a nested wrapper or a derive(Show) value
/// inside one is rendered too.
fn interp_render_sub(sub: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  rewrite_expr(ECall(builtin_ref("__to_string"), Array::slice([sub], 0, 1), -1, [
  ]), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
}

/// `open_s ++ e0 ++ sep ++ e1 ++ .. ++ close_s`, each element rendered.
/// (`open` is a reserved word in vibe, hence the suffixed names.)
fn interp_join(items: Array[Expr], open_s: String, sep: String, close_s: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let mut acc = EString(open_s, -1)
  let mut i = 0
  while i < Array::length(items) {
    let piece = interp_render_sub(Array::get(items, i), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    acc = if i == 0 {
      concat2(acc, piece)
    } else {
      concat2(concat2(acc, EString(sep, -1)), piece)
    }
    i = i + 1
  }
  concat2(acc, EString(close_s, -1))
}

/// #1445: render a variable whose binding site recorded a TUPLE shape
/// (`tuple_shape_key`). The expansion destructures the variable rather than
/// re-evaluating any element expression -- the tuple is already built, and
/// the binding's RHS may not even be in scope here.
///
///   let t = (1, p)   ->   match t { (a, b) => "(" ++ show(a) ++ ", " ++ show(b) ++ ")" }
///
/// Each binder is rendered through `interp_render_sub`, with its recorded
/// element type pushed into `var_types` first -- that is what lets a
/// `derive(Show)` struct inside the tuple render structurally instead of
/// falling to the pointer heuristic. An element whose type was not inferable
/// at the binding site carries an empty entry and simply renders through the
/// ordinary `__to_string`, exactly as it does today.
fn interp_expand_var_tuple(name: String, elem_types: Array[String], derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let n = Array::length(elem_types)
  let pats = array_empty()
  let binders = empty_str_array()
  let mut i = 0
  while i < n {
    let v = show_tmp_name()
    Array::push(pats, PBind(v))
    Array::push(binders, v)
    i = i + 1
  }
  let mut acc = EString("(", -1)
  let mut k = 0
  while k < n {
    let v = Array::get(binders, k)
    let et = Array::get(elem_types, k)
    let vt = if String::length(et) == 0 {
      var_types
    } else {
      extend_var_types(var_types, v, Some(et))
    }
    let piece = interp_render_sub(EIdent(v, -1), derived_only, gens, traits, struct_sets, dict_binds, vt, fn_returns)
    acc = if k == 0 {
      concat2(acc, piece)
    } else {
      concat2(concat2(acc, EString(", ", -1)), piece)
    }
    k = k + 1
  }
  EMatch(EIdent(name, -1), Array::slice([
    (PTuple(pats), concat2(acc, EString(")", -1)))
  ], 0, 1))
}

/// #1445: render a variable known to hold an `Array[T]` (its element type was
/// recorded under `array_elem_key` by `array_elem_bind` or `seed_var_types`).
///
/// The loop is emitted INLINE rather than as a call to a monomorphic
/// `__arr_to_string__<key>` helper. `gen_arr_to_string_fn` builds that helper
/// for `derive`d fields, but emitting one from here would mean driving helper
/// COLLECTION from interpolation sites in `desugar_derives` -- a second pass
/// has to have already decided which helpers exist by the time this one runs.
/// The loop body is the same shape as that helper's, so nothing is duplicated
/// conceptually; it is just placed where the type is known.
///
/// The element is rendered by re-entering the rewrite on `Array::get(name, i)`
/// -- `infer_arg_type_name` already resolves that shape through
/// `array_elem_type_of`, so a `derive(Show)` element renders structurally
/// without any extra plumbing here.
fn interp_expand_var_array(name: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let iv = String::concat(show_tmp_name(), "_i")
  let av = String::concat(show_tmp_name(), "_acc")
  let elem_piece = interp_render_sub(ECall(builtin_ref("Array::get"), Array::slice([
    EIdent(name, -1),
    EIdent(iv, -1)
  ], 0, 2), -1, []), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0), -1), EString("", -1), EString(", ", -1))
  let append = concat2(concat2(EIdent(av, -1), sep), elem_piece)
  let body = ESeq(EAssign(av, append, EUnit), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1), -1), EUnit))
  let len_call = ECall(builtin_ref("Array::length"), Array::slice([
    EIdent(name, -1)
  ], 0, 1), -1, [])
  let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call, -1), body)
  ELetMut(iv, EInt(0), ELetMut(av, EString("[", -1), ESeq(loop_e, concat2(EIdent(av, -1), EString("]", -1))), -1), -1)
}

/// #1445 (#139): render `sub` given its recursive SHAPE.
///
/// The tuple case destructures with a `match` so no element expression is
/// re-evaluated; the array case binds each element to a name inside the loop,
/// which is what lets a NESTED composite element recurse (an element reached
/// as `Array::get(a, i)` has no name for `var_types` to key on).
fn interp_render_shaped(sub: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if shape_is_composite(sh) {
    interp_expand_shape(sub, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  } else if String::length(sh) == 0 {
    interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  } else {
    match sub {
      EIdent(v, _) => interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, extend_var_types(var_types, v, Some(sh)), fn_returns),
      _ => interp_render_sub(sub, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  }
}

/// #1445 (#139): the tuple / array expansion for a composite shape. Supersedes
/// interp_expand_var_tuple / interp_expand_var_array for anything that nests;
/// those two stay for the shapes recorded by the older sentinels alone.
fn interp_expand_shape(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  if sh == "{u}" {
    // #3075: a Unit position (`Option[Unit]`) printed `0`.
    unit_render_expr(subject)
  } else if String::starts_with(sh, "(") {
    let parts = shape_split(shape_inner(sh))
    let n = Array::length(parts)
    let pats = array_empty()
    let binders = empty_str_array()
    let mut i = 0
    while i < n {
      let v = show_tmp_name()
      Array::push(pats, PBind(v))
      Array::push(binders, v)
      i = i + 1
    }
    let mut acc = EString("(", -1)
    let mut k = 0
    while k < n {
      let piece = interp_render_shaped(EIdent(Array::get(binders, k), -1), Array::get(parts, k), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      acc = if k == 0 {
        concat2(acc, piece)
      } else {
        concat2(concat2(acc, EString(", ", -1)), piece)
      }
      k = k + 1
    }
    EMatch(subject, Array::slice([
      (PTuple(pats), concat2(acc, EString(")", -1)))
    ], 0, 1))
  } else if String::starts_with(sh, "{o:") {
    // #2971: an Option. Every non-tuple composite used to take the ARRAY arm
    // below, so the `{o:Int}` element of an `Array[Option[Int]]` was walked
    // with `Array::length` / `Array::get` and `[None, Some(0), Some(1)]`
    // rendered `[[], [0], [0]]`.
    let v = show_tmp_name()
    let payload = interp_render_shaped(EIdent(v, -1), String::substring(sh, 3, String::length(sh) - 1), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    EMatch(subject, Array::slice([
      (PCtor("Some", Array::slice([PBind(v)], 0, 1)), concat2(EString("Some(", -1), concat2(payload, EString(")", -1)))),
      (PCtor("None", array_empty()), EString("None", -1))
    ], 0, 2))
  } else if String::starts_with(sh, "{r:") {
    let parts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
    let ok_sh = if Array::length(parts) == 2 {
      Array::get(parts, 0)
    } else {
      ""
    }
    let err_sh = if Array::length(parts) == 2 {
      Array::get(parts, 1)
    } else {
      ""
    }
    let ov = show_tmp_name()
    let ev = show_tmp_name()
    let ok_piece = interp_render_shaped(EIdent(ov, -1), ok_sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    let err_piece = interp_render_shaped(EIdent(ev, -1), err_sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    EMatch(subject, Array::slice([
      (PCtor("Ok", Array::slice([PBind(ov)], 0, 1)), concat2(EString("Ok(", -1), concat2(ok_piece, EString(")", -1)))),
      (PCtor("Err", Array::slice([PBind(ev)], 0, 1)), concat2(EString("Err(", -1), concat2(err_piece, EString(")", -1))))
    ], 0, 2))
  } else if String::starts_with(sh, "{g:") && show_generic_enum_known(generic_shape_head(sh)) {
    interp_expand_generic_enum(subject, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  } else if String::starts_with(sh, "{g:") && show_generic_struct_known(generic_shape_head(sh)) {
    // #3007: a `derive (Show)` generic struct at a known instantiation. The
    // field types get the arguments substituted, so each field renders at its
    // real type; the text matches `gen_show_fn`'s (`Box { v: 1.5 }`).
    // #3082: a field naming the struct again (`rest: Option[L[T]]`) recursed
    // here until the stack overflowed; the recursion guard is the enum arm's.
    let gparts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
    match show_generic_struct_decl(Array::get(gparts, 0)) {
      Some(_) => if show_generic_recurs(sh, Array::get(gparts, 0)) {
        show_generic_recursive_render(subject, sh, Array::get(gparts, 0))
      } else {
        Array::push(dtd_show_generic_enum_stack, sh)
        let out = interp_expand_generic_struct(subject, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        Array::truncate(dtd_show_generic_enum_stack, Array::length(dtd_show_generic_enum_stack) - 1)
        out
      },
      None => interp_render_sub(subject, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  } else if !String::starts_with(sh, "[") {
    // #2971: an encoding this renderer does not expand (`{u}`, `{m:..}`,
    // `{g:..}`). Treating it as an array was the bug above; the ordinary path
    // is the honest answer, and a `{g:Head,..}` keeps its head so a
    // `Head::to_string` renderer is still found.
    let head_vt = if String::starts_with(sh, "{g:") {
      let gparts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
      match subject {
        EIdent(sv, _) => extend_var_types(var_types, sv, Some(Array::get(gparts, 0))),
        _ => var_types
      }
    } else {
      var_types
    }
    interp_render_sub(subject, derived_only, gens, traits, struct_sets, dict_binds, head_vt, fn_returns)
  } else {
    // Array. The subject is read twice (length + per-index get), so it must be
    // a name; anything else is bound once first.
    let elem_sh = shape_inner(sh)
    let nm = match subject {
      EIdent(n, _) => n,
      _ => show_tmp_name()
    }
    let iv = String::concat(show_tmp_name(), "_i")
    let av = String::concat(show_tmp_name(), "_acc")
    let ev = show_tmp_name()
    let elem_piece = ELet(ev, ECall(builtin_ref("Array::get"), Array::slice([
      EIdent(nm, -1),
      EIdent(iv, -1)
    ], 0, 2), -1, []), interp_render_shaped(EIdent(ev, -1), elem_sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns), -1)
    let sep = EIf(EBinOp("==", EIdent(iv, -1), EInt(0), -1), EString("", -1), EString(", ", -1))
    let append = concat2(concat2(EIdent(av, -1), sep), elem_piece)
    let body = ESeq(EAssign(av, append, EUnit), EAssign(iv, EBinOp("+", EIdent(iv, -1), EInt(1), -1), EUnit))
    let len_call = ECall(builtin_ref("Array::length"), Array::slice([
      EIdent(nm, -1)
    ], 0, 1), -1, [])
    let loop_e = EWhile(EBinOp("<", EIdent(iv, -1), len_call, -1), body)
    let inner = ELetMut(iv, EInt(0), ELetMut(av, EString("[", -1), ESeq(loop_e, concat2(EIdent(av, -1), EString("]", -1))), -1), -1)
    match subject {
      EIdent(_, _) => inner,
      _ => ELet(nm, subject, inner, -1)
    }
  }
}

/// #3007: the field-by-field expansion of a `derive (Show)` generic struct at
/// a known instantiation (see `interp_expand_shape`'s `{g:` arm).
fn interp_expand_generic_struct(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let gparts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
  match show_generic_struct_decl(Array::get(gparts, 0)) {
    Some((sname, formals, fields)) => {
      let targs = empty_type_exprs()
      let mut ai = 1
      while ai < Array::length(gparts) {
        Array::push(targs, shape_to_eq_ty(Array::get(gparts, ai)))
        ai = ai + 1
      }
      let nm = match subject {
        EIdent(n, _) => n,
        _ => show_tmp_name()
      }
      let mut acc = EString(String::concat(namespace_rename_original(sname), " { "), -1)
      let mut fi = 0
      while fi < Array::length(fields) {
        let (fname, fty) = Array::get(fields, fi)
        let fsh = if Array::length(targs) == Array::length(formals) {
          ty_to_eq_shape(eq_subst_ty(fty, formals, targs))
        } else {
          ""
        }
        let fv = show_tmp_name()
        let piece = ELet(fv, EDot(EIdent(nm, -1), fname, -1, -1), interp_render_shaped(EIdent(fv, -1), fsh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns), -1)
        let label = if fi == 0 {
          String::concat(fname, ": ")
        } else {
          String::concat(", ", String::concat(fname, ": "))
        }
        acc = concat2(acc, concat2(EString(label, -1), piece))
        fi = fi + 1
      }
      let rendered = concat2(acc, EString(" }", -1))
      match subject {
        EIdent(_, _) => rendered,
        _ => ELet(nm, subject, rendered, -1)
      }
    },
    None => interp_render_sub(subject, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  }
}

/// #3074: a `derive (Show)` generic enum at a known instantiation, rendered
/// variant by variant with the arguments substituted into the payload types.
/// The text matches `gen_enum_show_fn`'s (`GA(true)`, `GB`).
///
/// A payload that names an enum already being expanded is recursive. Its
/// erased `to_string` is exact only when every type argument renders the same
/// erased as typed (`Int`, `String`); any other argument is refused rather than
/// printed through the erased formal.
fn interp_expand_generic_enum(subject: Expr, sh: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let gparts = shape_split(String::substring(sh, 3, String::length(sh) - 1))
  let head = Array::get(gparts, 0)
  if show_generic_recurs(sh, head) {
    show_generic_recursive_render(subject, sh, head)
  } else {
    match show_generic_enum_decl(head) {
      Some((_, formals, variants)) => {
        let targs = empty_type_exprs()
        let mut ai = 1
        while ai < Array::length(gparts) {
          Array::push(targs, shape_to_eq_ty(Array::get(gparts, ai)))
          ai = ai + 1
        }
        Array::push(dtd_show_generic_enum_stack, sh)
        let arms = array_empty()
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, ptys) = Array::get(variants, vi)
          let pats = array_empty()
          let mut body = EString(namespace_rename_original(vname), -1)
          if Array::length(ptys) > 0 {
            body = EString(String::concat(namespace_rename_original(vname), "("), -1)
            let mut pi = 0
            while pi < Array::length(ptys) {
              let pv = show_tmp_name()
              Array::push(pats, PBind(pv))
              let psh = if Array::length(targs) == Array::length(formals) {
                ty_to_eq_shape(eq_subst_ty(Array::get(ptys, pi), formals, targs))
              } else {
                ""
              }
              let piece = interp_render_shaped(EIdent(pv, -1), psh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              body = if pi == 0 {
                concat2(body, piece)
              } else {
                concat2(concat2(body, EString(", ", -1)), piece)
              }
              pi = pi + 1
            }
            body = concat2(body, EString(")", -1))
          } else {
            ()
          }
          Array::push(arms, (PCtor(vname, pats), body))
          vi = vi + 1
        }
        Array::truncate(dtd_show_generic_enum_stack, Array::length(dtd_show_generic_enum_stack) - 1)
        EMatch(subject, arms)
      },
      None => interp_render_sub(subject, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  }
}

/// `ctor_name(<rendered payload>)`.
fn interp_wrap1(ctor: String, payload: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  concat2(EString(String::concat(ctor, "("), -1), concat2(interp_render_sub(payload, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns), EString(")", -1)))
}

fn interp_expand_by_head(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  if head == "Option" {
    let v = show_tmp_name()
    let vt_some = interp_ctor_arm_var_types(arg, "Some", v, var_types)
    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([
      (PCtor("Some", Array::slice([PBind(v)], 0, 1)), interp_wrap1("Some", EIdent(v, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_some, fn_returns)),
      (PCtor("None", array_empty()), EString("None", -1))
    ], 0, 2)))
  } else if head == "Result" {
    let ov = show_tmp_name()
    let ev = show_tmp_name()
    let vt_ok = interp_ctor_arm_var_types(arg, "Ok", ov, var_types)
    let vt_err = interp_ctor_arm_var_types(arg, "Err", ev, var_types)
    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([
      (PCtor("Ok", Array::slice([PBind(ov)], 0, 1)), interp_wrap1("Ok", EIdent(ov, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_ok, fn_returns)),
      (PCtor("Err", Array::slice([PBind(ev)], 0, 1)), interp_wrap1("Err", EIdent(ev, -1), derived_only, gens, traits, struct_sets, dict_binds, vt_err, fn_returns))
    ], 0, 2)))
  } else {
    None
  }
}

/// The structural rendering for an interpolated wrapper value, or None when
/// this pass has no shape to work from and the `__to_string` call must stand.
fn interp_expand(arg: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  let erased_throw_head = if derived_only {
    dtd_erased_top_formal_head(arg, dict_binds, traits, struct_sets, var_types, fn_returns)
  } else {
    ""
  }
  if String::length(erased_throw_head) > 0 {
    // #3003: `derived_only` is a THROW site's synthesized render (the message an
    // erased `Exception::Throw(m)` arm reads), not an interpolation the user
    // wrote. Refusing it with the interpolation message told `throw(x)` to
    // "interpolate at a concrete type", while `throw([x])` compiled and
    // rendered `<Array>`. Both render a placeholder naming the type now.
    Some(EString(String::concat("<", String::concat(erased_throw_head, ">")), -1))
  } else {
    interp_expand_checked(arg, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  }
}

fn interp_expand_checked(arg: Expr, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  dtd_check_top_interp(arg, dict_binds, traits, struct_sets, var_types, fn_returns)
  let head = match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
    Some(h) => h,
    None => ""
  }
  let syn_sh = interp_shape(infer_shape(arg, struct_sets, var_types, fn_returns))
  // #3066: where this pass expands the argument itself, the checker's type
  // (a render row) outranks the syntactic shape. The syntax is exact for a
  // literal, but a payload it cannot type -- `Some(k())` through a local
  // lambda -- was rendered by the pointer heuristic (`Some(0)` for
  // `Some(false)`); the checker knows it.
  // #3081 review: an argument with no offset (an `if`, a `match`, a block)
  // has no syntactic head either, so the gate below would never ask; it is
  // shaped from its arms (`dtd_offsetless_shape`), and `interp_shape` keeps
  // only a composite answer.
  let typed_sh = if typed_lowering_arg_offset(arg) < 0 {
    interp_shape(dtd_offsetless_shape(arg, struct_sets, var_types, fn_returns))
  } else if dtd_interp_expands_itself(syn_sh, head) {
    dtd_typed_render_shape_for(arg)
  } else if String::length(head) == 0 || dtd_head_is_leaked_formal(head) {
    // #3074: a value this pass cannot name at all (`pair.0` holding a
    // `G[Bool]`) takes the checker's row: the erased renderer, or an
    // address, is all that is left for it otherwise. #3084: so does a head
    // that names nothing here -- a generic function's result, typed by the
    // callee's own formal (`pass(Some(true))` answers `T`); the gc lane
    // printed its address.
    dtd_unnamed_head_row(arg, head)
  } else {
    ""
  }
  let sh = if String::length(typed_sh) > 0 {
    typed_sh
  } else {
    syn_sh
  }
  if String::length(sh) > 0 {
    Some(interp_expand_shape(arg, sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
  } else {
    let as_show = dtd_show_witness_dict(dict_binds, traits, head)
    // #2737: a promised `Show` witness with no dictionary renders the value's
    // representation rather than the value, so it is refused here too.
    dtd_check_unthreaded_interp(as_show, head, traits, fn_returns)
    match as_show {
      Some(dict_pname) => Some(ECall(EDot(EIdent(dict_pname, -1), "to_string", -1, -1), [
        arg
      ], -1, [])),
      None => interp_expand_local(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }
  }
}

fn interp_expand_local(arg: Expr, head: String, derived_only: Bool, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with Exception {
  match arg {
    ETuple(items) => Some(interp_join(items, "(", ", ", ")", derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EArray(items) => Some(interp_join(items, "[", ", ", "]", derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EIdent(n, _) => if n == "None" && head == "Option" {
      Some(EString("None", -1))
    } else {
      // #1445: a tuple or array reached through a NAME. The shape came from
      // the binding site (tuple_shape_bind / array_elem_bind) or from a
      // parameter annotation (seed_var_types), which is what the head name
      // alone could never supply.
      // #139: the recursive shape first -- it is the only one that can carry
      // a nested tuple/array. The two older sentinels still answer for a
      // binding shape_bind declined to record (a PARAMETER annotation, which
      // seeds them directly and never goes through bind_shapes).
      match lookup_var_type(var_types, shape_key(n)) {
        // A RECORDED shape is the binding site's answer, empty or not: an
        // empty one means the innermost binding of `n` is not a tuple/array,
        // so the older sentinels (which a shadowing rebind does not clear)
        // must NOT be consulted. Only a name with no record at all -- a
        // parameter, seeded directly by seed_var_types -- falls through.
        Some(sh) => if shape_is_composite(sh) {
          Some(interp_expand_shape(EIdent(n, -1), sh, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
        } else {
          interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        },
        None => match lookup_var_type(var_types, tuple_shape_key(n)) {
          Some(sentinel) => Some(interp_expand_var_tuple(n, tuple_shape_parts(sentinel), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
          None => match array_elem_type_of(var_types, n) {
            Some(_) => Some(interp_expand_var_array(n, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
            None => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          }
        }
      }
    },
    ECall(callee, cargs, _, _) => match callee {
      EIdent(cn, _) => if Array::length(cargs) == 1 && ((head == "Option" && cn == "Some") || (head == "Result" && (cn == "Ok" || cn == "Err"))) {
        Some(interp_wrap1(cn, Array::get(cargs, 0), derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
      } else {
        interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      },
      _ => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    },
    _ => interp_expand_by_head(arg, head, derived_only, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  }
}

export fn user_assert_eq_reset(stmts: Array[Stmt]) -> Unit {
  Array::set(dtd_user_assert_eq, 0, -1)
  Array::set(dtd_user_assert_eq_range, 0, 0)
  Array::set(dtd_user_assert_eq_range, 1, -1)
  Array::set(dtd_user_assert_eq_alias_blocker, 0, 0)
  Array::truncate(dtd_user_assert_eq_program, 0)
  Array::push(dtd_user_assert_eq_program, stmts)
}

export fn plain_reexport_binds(items: Array[ImportItem], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let item = Array::get(items, i)
    if item.name == wanted && item.alias == None {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn reexport_blockers_bind_assert_eq(names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    found = Array::get(names, i) == "assert_eq"
    i = i + 1
  }
  found
}

export fn merged_source_range_end(stmts: Array[Stmt], start: Int) -> Int {
  let mut end = start
  while end < Array::length(stmts) && merged_source_boundary_local_names(Array::get(stmts, end)) == None {
    end = end + 1
  }
  end
}

export fn merged_source_boundary_local_names(stmt: Stmt) -> Option[Array[String]] {
  match builtin_iterator_serialized_boundary_markers(stmt) {
    Some(local_names) => Some(local_names),
    None => match stmt {
      SReExportSourceBoundary(local_names, _) => Some(local_names),
      _ => None
    }
  }
}

export fn user_assert_eq_set_merged_source(stmts: Array[Stmt], start: Int, names: Array[String]) -> Unit {
  Array::set(dtd_user_assert_eq, 0, -1)
  Array::set(dtd_user_assert_eq_range, 0, start)
  Array::set(dtd_user_assert_eq_range, 1, merged_source_range_end(stmts, start))
  Array::set(dtd_user_assert_eq_alias_blocker, 0, if reexport_blockers_bind_assert_eq(names) {
    1
  } else {
    0
  })
}

fn assert_eq_concat(a: Expr, b: Expr) -> Expr {
  ECall(builtin_ref("String::concat"), [a, b], -1, [])
}

/// Render one `assert_eq` operand. Reuses the throw-site renderer
/// (`derived_only`) so a missing Show becomes `<unprintable>` instead of a
/// pointer decimal or a compile error.
fn assert_eq_render(arg: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let target = interp_show_target(arg, true, struct_sets, var_types, fn_returns)
  if target != "" {
    ECall(EIdent(target, -1), Array::slice([arg], 0, 1), -1, [])
  } else {
    let expanded = interp_expand(arg, true, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    if interp_has_repl(expanded) {
      interp_take_repl(expanded)
    } else {
      match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {
        Some(tn) => if is_scalar_type_name(tn) {
          ECall(builtin_ref("__to_string"), Array::slice([arg], 0, 1), -1, [])
        } else {
          EString("<unprintable>", -1)
        },
        None => {
          let as_scalar = match arg {
            EInt(_) => true,
            EBool(_) => true,
            EString(_, _) => true,
            EFloat(_) => true,
            _ => false
          }
          if as_scalar {
            ECall(builtin_ref("__to_string"), Array::slice([arg], 0, 1), -1, [])
          } else {
            EString("<unprintable>", -1)
          }
        }
      }
    }
  }
}

fn lower_assert_eq(args: Array[Expr], call_off: Int, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  let a2 = rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let b2 = rewrite_expr(Array::get(args, 1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
  let an = dinsp_fresh_name("__assert_eq_actual", a2, b2)
  let en = dinsp_fresh_name("__assert_eq_expected", a2, b2)
  let vars1 = bind_shapes(extend_var_types(var_types, an, infer_arg_type_name(a2, struct_sets, var_types, fn_returns)), an, a2, struct_sets, fn_returns)
  let vars2 = bind_shapes(extend_var_types(vars1, en, infer_arg_type_name(b2, struct_sets, vars1, fn_returns)), en, b2, struct_sets, fn_returns)
  let actual = EIdent(an, -1)
  let expected = EIdent(en, -1)
  let actual_s = assert_eq_render(actual, gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  let expected_s = assert_eq_render(expected, gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  // The trailing `assert failed: aborting` line closes the diagnostic and
  // says what happens next -- the trap that follows is this assert's own
  // deliberate abort, not a second failure. It doubles as the marker the
  // test condensers (scripts/vibe_test.sh / runtime/vibe) key on to
  // suppress the trap echo (#2202, Codex rounds 2-3 on #2213): rendered
  // values may contain newlines and a test's own output may imitate the
  // block, so the block text alone cannot identify the abort. The
  // condensers hide the line; in a plain `vibe run` it reads as ordinary
  // diagnostic prose rather than harness protocol.
  // #2202: bake the call's source offset so `vibe test` can print a line
  // number. The condenser maps `at off=N` using the source file.
  let msg = assert_eq_concat(EString(String::concat("assert_eq failed\n  at off=", String::concat(__to_string(call_off), "\n  expected: ")), -1), assert_eq_concat(expected_s, assert_eq_concat(EString("\n  actual:   ", -1), assert_eq_concat(actual_s, EString("\nassert failed: aborting", -1)))))
  // stdout, not Stderr::write_stream: the gc lane only reserves host
  // imports when the source already used one, and flipping that on a
  // SIMD-only file shifts every generated-body index (gc-gate
  // simd_skip_ws_test). `vibe test` now keeps stdout on FAIL so the
  // diagnostic still reaches vt_fail_detail.
  //
  // #2107: `println` here means `assert_eq` REQUIRES `Console` in the
  // function containing it -- this expansion runs before the checker, so the
  // row lands on the caller. That is the honest reading (the branch really
  // does write to the console) and it is the same rule `inspect` follows.
  // In practice it costs nothing: a `test` / `bench` block is granted the
  // standard test effect set, which includes Console, and that is where
  // assertions live. A plain function asserting outside a test block declares
  // `with Console`, as `fixtures/gc_backend_smoke_test.vibe` now does.
  //
  // The internal printer `print_str` looks like the way to avoid that and is
  // not: its wasm signature takes two params (the string as a pair), it is
  // `checker_visible=false`, and codegen only ever emits it with that ABI
  // from a lowering -- a vibe-level call to it is `unknown name` at the
  // checker and a broken module past it. Introducing a rowless vibe-callable
  // printer just to keep this branch quiet would re-open the exact escape
  // #2107 closed, one dunder away.
  let fail = ESeq(ECall(EIdent("println", -1), [msg], -1, []), ECall(EIdent("assert_true", -1), [
    EBool(false)
  ], -1, []))
  let cmp = rewrite_expr(EBinOp("==", actual, expected, -1), gens, traits, struct_sets, dict_binds, vars2, fn_returns)
  ELet(an, a2, ELet(en, b2, EIf(cmp, EUnit, fail), -1), -1)
}

/// The core rewriter. `dict_binds` is non-empty only inside a transformed
/// generic's body (so `T::method` resolves to a dict field); call-site dict
/// threading applies everywhere a transformed generic is called. `var_types`
/// tracks locals/params whose concrete type is known, for call-site dict
/// synthesis when the receiver is a variable.
fn rewrite_expr(expr: Expr, gens: Array[DictGen], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with Exception {
  match expr {
    EIdent(name, _) => if str_array_contains(dtd_generic_show_shims, name) {
      throw("wrap the renderer in a lambda with a concrete parameter type: a generic rendering shim must be called directly so its argument type remains available")
    },
    _ => ()
  }
  match expr {
    EIdent(name, off) => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        let as_method = find_dict_for_method(dict_binds, head, member)
        match as_method {
          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1, -1),
          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {
            Some(m) => EIdent(m, off),
            None => {
              // #2737 (Codex, P1 on the first commit): a trait method taken as a
              // VALUE -- `let cmp = T::equals` -- is a fourth route into the same
              // hole, and it reaches this arm rather than either call site. Left
              // alone the name stayed unresolved exactly as the qualified CALL
              // did: measured, `cmp(a, b)` for `7, 8` inside a shadowing
              // `[T: Eq]` lambda answered `true` through `Pt::equals`, both
              // before this pass's guard and after it.
              //
              // Placed on the LAST branch, after the constructor lookup: a
              // formal's spelling can collide with an enum whose
              // `Enum::Variant` this arm resolves, and that is a real
              // resolution, not a missing witness.
              dtd_check_unthreaded_dispatch(as_method, head, member, name, traits, fn_returns)
              // A qualified generic (`fn Util::same[T: Eq]`) named as a value
              // loses its witness the same way an unqualified one does.
              dtd_check_threaded_generic_value(name, gens, var_types)
              expr
            }
          }
        }
      },
      None => {
        dtd_check_threaded_generic_value(name, gens, var_types)
        expr
      }
    },
    ECall(callee, args, off, callee_resolution) => {
      // #635: type-directed lowering of the railway sentinels emitted by the
      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type
      // info from the parser; here `infer_arg_type_name(val)` picks Option vs
      // Result (default Result when undeterminable — today's behavior). A user
      // function literally named `__try_bind`/`__try_op` with the wrong shape
      // (handled by `try_sentinel` returning None) takes the generic path.
      let try_kind = try_sentinel(callee, args)
      // #1392: the interpolation replacement, computed once here rather than
      // inside the else-if chain below so the resolvers run at most once per
      // call site. Slice 1 (the argument's type names a `T::to_string`) wins
      // over slice 2 (the argument is, or is headed by, a wrapper).
      let interp_repl = if is_interp_to_string_call(callee, args) || is_show_shim_call(callee, args) {
        // #2745 (Codex, P1 on #2761): FIRST, ahead of every rendering path below.
        // All of them key on the argument's type NAME, and a nested formal is a
        // NAME -- so a binder spelled like a type they recognise takes that
        // type's rendering on an erased value.
        //
        // Measured on the first cut of this fix, which ran the check after them:
        // `let inner = [Bool](a: Bool) -> String { "\{a}" }` applied to a struct
        // printed `true`, the struct's pointer read as a Bool by
        // `interp_arg_is_bool`; `[Option]` reached the wrapper arm and trapped.
        //
        // The BUILTIN spellings are what leak, and only they: a formal named
        // after a DECLARED type is refused upstream by #2141's shadowing guard
        // (measured -- `[Qt]` where `struct Qt` exists gives "type parameter `Qt`
        // ... shadows the declared type"), which never sees `Bool` / `Option` /
        // `Result` because they are not declarations. Rather than enumerate them
        // here -- the enumeration is the bug, a condition applied through
        // whichever spelling happened to be in front of it -- this asks about the
        // BINDER before any spelling is consulted.
        // WHICH message, decided here rather than by which check happens to run
        // first. Hoisting this above the rendering paths also lifted it above
        // #2737's interp refusal, and a `[T: Show]` lambda is BOTH -- erased, and
        // carrying a bound nothing honours. #2737 offers the more specific edit
        // of lifting the bounded lambda and diagnosis (the bound you wrote is not threaded),
        // so it wins when the binder's bound promised a renderer. Choosing on the
        // FACT keeps that true no matter where either check sits.
        // #2773: the erased-formal REFUSAL used to live here, driven by
        // `dtd_erased_interp_formal` -- a walk that answered "is this
        // interpolated value an erased formal?" from syntax, in a pass with no
        // types, carrying an ad-hoc environment. Twenty-six review rounds found
        // sixty-three routes past it and the rate did not fall.
        //
        // The checker refuses these now, including the one shape that was
        // load-bearing here (`shim(if c { a } else { a })`, where a top-level
        // rendering shim's body exemption had no call-site counterpart). It has
        // types, so it answers the question instead of approximating it, and
        // its refusal carries a location this one never did.
        //
        // Measured before removing it: with the walk stubbed to answer "",
        // every one of the 65 `lambda_bound_*_refused.vibe` fixtures still
        // refused, so did all three routes #2773 listed as open, and the
        // 1315-file unit corpus kept both programs refused -- what changed was
        // only WHICH channel reports them.
        // #3007: a `derive (Show)` generic struct whose instantiation this pass
        // can see renders field by field (`interp_expand_shape`'s `{g:` arm);
        // its one derived `to_string` erases the formals.
        let generic_syn_sh = interp_shape(infer_shape(Array::get(args, 0), struct_sets, var_types, fn_returns))
        // #3074: the checker's render row supplies the instantiation where the
        // syntax does not (a call result, a binder it never recorded).
        let generic_head = match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          Some(h) => h,
          None => ""
        }
        // #3084: a head that names nothing here -- a generic function's
        // result is typed by its declared return, the callee's own formal
        // (`pass(Pt::{ x: 1 })` answers `T`) -- takes the checker's row, which
        // has the call site's instantiation.
        let head_leaked = dtd_head_is_leaked_formal(generic_head)
        let leaked_row = if head_leaked && !String::starts_with(generic_syn_sh, "{g:") {
          dtd_typed_render_raw_shape_for(Array::get(args, 0))
        } else {
          ""
        }
        let generic_show_sh = if String::starts_with(generic_syn_sh, "{g:") {
          generic_syn_sh
        } else if head_leaked {
          let admitted = interp_shape(leaked_row)
          if String::length(admitted) > 0 {
            admitted
          } else {
            generic_syn_sh
          }
        } else if show_generic_known(generic_head) {
          let row_sh = dtd_typed_render_shape_for(Array::get(args, 0))
          if String::starts_with(row_sh, "{g:") {
            row_sh
          } else {
            generic_syn_sh
          }
        } else {
          generic_syn_sh
        }
        // #3084: the row names a plain nominal (`Pt`, a non-generic enum):
        // its renderer, as if the value had been annotated. A `derive (Show)`
        // generic named without its arguments is refused below.
        let leaked_nominal = if head_leaked && String::length(interp_shape(leaked_row)) == 0 && dtd_row_is_bare_nominal(leaked_row) {
          leaked_row
        } else {
          ""
        }
        if String::length(leaked_nominal) > 0 && show_generic_known(leaked_nominal) {
          throw(interp_generic_enum_unknown_msg(namespace_rename_original(leaked_nominal), off))
        } else if String::length(leaked_nominal) > 0 && !is_scalar_type_name(leaked_nominal) && struct_set_has(struct_sets, leaked_nominal) && !fn_exists(fn_returns, String::concat(leaked_nominal, "::to_string")) {
          throw(interp_missing_show_msg(namespace_rename_original(leaked_nominal), off))
        } else {
          ()
        }
        let show_target = if String::starts_with(generic_show_sh, "{g:") {
          ""
        } else if String::length(leaked_nominal) > 0 && !is_scalar_type_name(leaked_nominal) && fn_exists(fn_returns, String::concat(leaked_nominal, "::to_string")) && String::concat(leaked_nominal, "::to_string") != Array::get(dtd_show_self_fn, 0) {
          String::concat(leaked_nominal, "::to_string")
        } else {
          interp_show_target(Array::get(args, 0), false, struct_sets, var_types, fn_returns)
        }
        // #3074: the only renderer left is the derived one, which erases the
        // enum's formals -- `G[Bool]` printed `GA(1)`. A payload-free
        // constructor renders its name at any instantiation; anything else is
        // refused rather than printed through the erased formal. #3082: a
        // generic struct the same way (`o.b` holding a `Box[Bool]` printed
        // `Box { v: 1 }`).
        if show_target != "" && show_generic_known(generic_head) && !show_generic_enum_nullary(Array::get(args, 0)) {
          throw(interp_generic_enum_unknown_msg(namespace_rename_original(generic_head), off))
        } else {
          ()
        }
        if show_target != "" {
          Some(ECall(EIdent(show_target, -1), Array::slice([
            rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          ], 0, 1), off, callee_resolution))
        } else if interp_arg_is_bool(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          // #1527: a Bool that reaches `"\{...}"` through a CALL or a NAME
          // whose recorded type is Bool printed `1`/`0` — Bool and Int share
          // the tagged-int representation, and codegen's boolish classifiers
          // (cc_expr_is_boolish and its per-backend twins) are syntactic:
          // they know literals, comparisons and bool-returning BUILTINS, but
          // not a user fn's declared `-> Bool`. This pass has that type
          // (fn_returns / var_types / struct field heads), so rewrite the
          // rendering here, once, for every backend: the `__to_string(arg)`
          // becomes `if arg { "true" } else { "false" }`. A Bool LITERAL is
          // excluded — every classifier already answers it, and skipping it
          // keeps the common case's lowering untouched.
          Some(EIf(rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns), EString("true", -1), EString("false", -1)))
        } else if interp_arg_is_double(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          // #2993: the same gap for a Double. A container's element reaches
          // here as a synthesized binder (`let __show_vN = Array::get(xs, i)`)
          // whose recorded type is Double, but codegen's floatish classifiers
          // cannot see that binder's type, so `[1.5, 2.25]` rendered the boxed
          // Doubles' addresses (`[352, 360]`). This pass knows the type, so it
          // names the renderer.
          Some(ECall(builtin_ref("Double::to_string"), Array::slice([
            rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          ], 0, 1), off, callee_resolution))
        } else if interp_arg_is_char(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          // #3075: a `Char` printed its code point (`97` for `'a'`).
          Some(char_render_expr(rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        } else if interp_arg_is_unit(Array::get(args, 0), struct_sets, var_types, fn_returns) {
          // #3075: a `Unit` printed `0` (`Some(())` -> `Some(0)`).
          Some(unit_render_expr(rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        } else {
          let saved_site_off = Array::get(dtd_interp_site_off, 0)
          Array::set(dtd_interp_site_off, 0, off)
          let expanded = interp_expand(Array::get(args, 0), false, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          Array::set(dtd_interp_site_off, 0, saved_site_off)
          // #1445: nothing rendered it structurally AND the type is a declared
          // aggregate with no renderer -- that is a missing `derive(Show)`, and
          // falling through here would print a pointer decimal.
          if interp_has_repl(expanded) {
            expanded
          } else {
            let missing = interp_missing_show_type(Array::get(args, 0), struct_sets, var_types, fn_returns)
            let unresolved_array = interp_unresolved_array_call(Array::get(args, 0), struct_sets, var_types, fn_returns)
            if missing != "" {
              throw(interp_missing_show_msg(missing, off))
            } else if String::length(unresolved_array) > 0 {
              // #2912: the same reasoning as #1445 one line up, for an array
              // instead of a declared aggregate. Both reach here having failed
              // to render, and both would otherwise print a pointer decimal.
              throw(interp_unresolved_array_msg(unresolved_array))
            } else if is_show_shim_call(callee, args) {
              // #2468: nothing HERE resolved it, and for a shim call leaving
              // the call standing is not the same as leaving a `__to_string`
              // standing. A shim is by definition `fn s(x) { __to_string(x) }`,
              // so `s(arg)` and `__to_string(arg)` are one lowering -- but only
              // the second is a render call to CODEGEN, which is where the
              // typed-lowering channel (#2424/#2462) and the syntactic boolish
              // classifiers get their turn. Left as `s(arg)` the argument was
              // never classified and the two spellings of one render disagreed:
              //
              //   __to_string(l())  ->  "true"      to_string(l())  ->  "1"
              //
              // Rewriting to the direct spelling, at the SAME call offset, is
              // what makes them one answer again. The callee is unreachable
              // afterwards only if nothing else calls it; that is DCE's
              // business, not this pass's.
              Some(ECall(builtin_ref("__to_string"), Array::slice([
                rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              ], 0, 1), off, callee_resolution))
            } else {
              expanded
            }
          }
        }
      } else {
        None
      }
      if try_kind == 0 {
        // __try_bind(val, (name) -> rest)
        let val = Array::get(args, 0)
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, 0)
            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))
            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)
            lower_try_bind(rwval, name, rwrest)
          },
          _ => EUnit
        }
      } else if try_kind == 1 {
        // __try_op(val)
        let val = Array::get(args, 0)
        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        lower_try_op(rwval)
      } else if interp_has_repl(interp_repl) {
        // #1392: the interpolation of a value this pass can render.
        interp_take_repl(interp_repl)
      } else if is_assert_eq_call(callee, args) {
        lower_assert_eq(args, off, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      } else if !exn_kind_suppressed() && is_exception_kind_read(callee, args) {
        // #1374: `__exn_kind()` is a checker-only intrinsic (typed
        // `() -> String` in checker/builtins_misc.vibe, no wasm body) -- it
        // exists so a handler arm can spell the read, and it is gone by the
        // time either backend sees the program.
        exn_kind_mark_used()
        exn_kind_read_expr()
      } else if !exn_kind_suppressed() && is_exception_message_read(callee, args) {
        // #1392 slice 3: the companion read. Same checker-only intrinsic shape
        // as `__exn_kind()`.
        exn_kind_mark_used()
        exn_msg_read_expr()
      } else if !exn_kind_suppressed() && is_perform_throw_shape(callee, args) {
        // #1374: record the payload's static type name for the handler. The
        // write is UNCONDITIONAL, including the empty name for a payload this
        // pass cannot resolve -- leaving the slot alone there would let an
        // earlier throw's kind be read as this one's.
        //
        // The resolver is codegen's own `infer_arg_type_name`, not the
        // checker's `throw_payload_kind`: both answer the same question from
        // the same syntax, but the checker's table is TypeEnv-derived state
        // that does not reach codegen, and this pass already carries
        // `var_types`/`fn_returns` for every expression it visits. They can
        // disagree only by one being MORE conservative (an unresolved name is
        // ""), which costs a kind here and a row precision there, never
        // soundness.
        // #1878 (Codex review on #1892): `infer_arg_type_name` can answer
        // with an internal shape sentinel (`__anonrec:` for a record
        // binding, `__anontup:` for a tuple carrying one) — inert for every
        // dispatch consumer, but THIS site publishes the string as the
        // user-facing exception kind, where a sentinel would render as
        // `<__anontup:__anonrec:a;>`. Publish "" instead, the same value an
        // unresolved payload gets (the erased sink then falls back to the
        // safely rendered payload).
        let kind0 = match infer_arg_type_name(perform_throw_payload(args), struct_sets, var_types, fn_returns) {
          Some(k) => k,
          None => ""
        }
        let kind = if String::starts_with(kind0, anon_record_prefix()) || String::starts_with(kind0, anon_tuple_prefix()) {
          ""
        } else {
          kind0
        }
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        exn_kind_mark_used()
        // The write has to land AFTER the payload is evaluated, not before.
        // There is ONE slot, so anything the payload expression does that
        // reaches a throw -- even one it handles itself -- overwrites the kind
        // this site just recorded. `throw(payload())` where `payload()`
        // internally catches a `throw(Bang(1))` and returns a String would
        // otherwise leave `Boom` in the slot and be reported as `<Boom>`
        // instead of its own message. Binding the payload first makes the
        // write the last thing before the perform.
        let pname = exn_kind_fresh_payload_name()
        // #1392 slice 3: render the payload HERE, where its type is known, and
        // carry the string alongside the kind. The erased arm cannot do this
        // itself at any later point -- see exn_kind_cell_stmt's comment.
        //
        // The renderer is the ordinary interpolation path, run against the
        // payload TEMP with `kind` injected into var_types. Rendering the
        // original payload expression instead would evaluate it twice; the
        // temp is exactly the same value and `kind` is exactly the type
        // `infer_arg_type_name` just derived from that expression.
        //
        // The slot is written ONLY when a STRUCTURAL renderer was found, and
        // is cleared otherwise. The reader cannot make that distinction
        // itself: `__to_string`'s pointer decimal is a perfectly ordinary
        // non-empty string, so a reader that trusted any non-empty slot would
        // print `192` for an enum without `derive(Show)` -- strictly worse
        // than the `<Kind>` #1374 already prints there. Faithfulness is a
        // static property of this site, so it is decided here.
        //
        // #1398 review (Codex P2): "" is therefore a sentinel, and it is a
        // sound one only because every renderer reachable from here produces a
        // NON-EMPTY string by construction. `derived_only` (Codex P1, above)
        // is what makes that true: a derived struct renderer opens with the
        // type name (`P { ..`), a derived enum renderer IS a variant name, and
        // the wrapper expansions are `Some(..)`/`Ok(..)`/`Err(..)`/`None`. A
        // user-written formatter could legitimately return "" -- and is no
        // longer called from here at all.
        let render_vars = if kind == "" {
          var_types
        } else {
          extend_var_types(var_types, pname, Some(kind))
        }
        let render_target = interp_show_target(EIdent(pname, -1), true, struct_sets, render_vars, fn_returns)
        let rendered = if render_target != "" {
          Some(ECall(EIdent(render_target, -1), Array::slice([
            EIdent(pname, -1)
          ], 0, 1), -1, []))
        } else {
          interp_expand(EIdent(pname, -1), true, gens, traits, struct_sets, dict_binds, render_vars, fn_returns)
        }
        let msg_write = exn_msg_write_expr(if interp_has_repl(rendered) {
          interp_take_repl(rendered)
        } else {
          EString("", -1)
        })
        ELet(pname, perform_throw_payload(rwargs), ESeq(exn_kind_write_expr(kind), ESeq(msg_write, ECall(callee, perform_throw_with_payload(rwargs, EIdent(pname, -1)), off, callee_resolution))), -1)
      } else {
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns, true) {
          Some(map_get) => map_get,
          None =>
          match callee {
            EIdent(name0, coff) => {
              // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->
              // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.
              let name_ctor = match split_qualified(name0) {
                Some(parts0) => {
                  let (h0, m0) = parts0
                  match qual_ctor_member(h0, m0, struct_sets, fn_returns) {
                    Some(mm) => mm,
                    None => name0
                  }
                },
                None => name0
              }
              // #736 residual: bare method-style callee — `xs |> length` is
              // `length(xs)`; with only the receiver TYPE imported there is no
              // top-level `length`, so resolve to `<type-of-arg0>::length` (USER
              // types only, and only when no top-level fn of the bare name exists
              // — a lexically visible `length` keeps normal call semantics). The
              // checker applies the same rule, so typing and codegen agree.
              let name = if String::index_of(name_ctor, "::") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {
                match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", name_ctor))
                    if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {
                      qual
                    } else {
                      name_ctor
                    }
                  },
                  None => name_ctor
                }
              } else {
                name_ctor
              }
              // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.
              let as_method = match split_qualified(name) {
                Some(parts) => {
                  let (head, member) = parts
                  find_dict_for_method(dict_binds, head, member)
                },
                None => None
              }
              // #2737: a promised witness with no dictionary is refused here
              // rather than left to codegen, which lowers the unresolved name to
              // a table call on a bogus index.
              match split_qualified(name) {
                Some(promised) => {
                  let (phead, pmember) = promised
                  dtd_check_unthreaded_dispatch(as_method, phead, pmember, name, traits, fn_returns)
                },
                None => ()
              }
              let array_intrinsic = iterator_array_intrinsic(name, args, gens, struct_sets, var_types, fn_returns)
              match array_intrinsic {
                Some(intrinsic) => ECall(iterator_array_intrinsic_callee(intrinsic, coff), rwargs, off, callee_resolution),
                None => match as_method {
                  Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), rwargs, off, callee_resolution),
                  None => match lookup_gen_entry(gens, name) {
                    Some(gen) => match synth_dicts_if(gen_prepends_dicts(gen), gen.type_params, gen.threaded, gen.constructor_recvs, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                      Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off, callee_resolution),
                      None => ECall(EIdent(name, coff), rwargs, off, callee_resolution)
                    },
                    None => ECall(EIdent(name, coff), rwargs, off, callee_resolution)
                  }
                }
              }
            },
            EDot(obj, m, doff, fdoff) => {
              // #736 residual: method-style call `xs.length()` on a USER type —
              // codegen compiles a called EDot as struct-field access, so a
              // receiver method (`List::length`) failed with "unknown struct
              // field". Rewrite to the qualified call when the receiver's type is
              // inferable and declares the method as a top-level fn. A struct
              // FIELD of the same name keeps the field-stored-function call (the
              // field is the closer binding), and unknown receivers keep the EDot
              // (codegen's existing paths).
              let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              // #931: UFCS on a trait-BOUNDED TYPE PARAMETER — `k.probe_key()`
              // where `k: K` and `[K: Hash]` is in scope. The receiver's inferred
              // "type name" is the tparam itself ("K"), which is neither a struct
              // nor a concrete `K::method` top-level fn, so the concrete-method
              // rewrite below missed it and the call stayed a bare EDot — codegen
              // compiles a called EDot as a struct-field read, yielding a
              // null-function call at runtime. Route it through the SAME threaded
              // witness dict as the qualified spelling `K::probe_key(k)` (the
              // EIdent arm above): `(dict.method)(k, args)`. Checked FIRST so both
              // spellings resolve identically (the qualified path also consults
              // find_dict_for_method before any concrete fallback).
              let recv_tn = infer_arg_type_name(obj, struct_sets, var_types, fn_returns)
              let as_tparam_dict = match recv_tn {
                Some(tn) => find_dict_for_method(dict_binds, tn, m),
                None => None
              }
              let as_recv_method = match as_tparam_dict {
                Some(_) => None,
                None => match recv_tn {
                  Some(tn) => {
                    let qual = dtd_program_fn_name(fn_returns, String::concat(tn, String::concat("::", m)))
                    let is_field = struct_set_member(struct_sets, tn, m)
                    if !is_field && fn_exists(fn_returns, qual) {
                      Some(qual)
                    } else {
                      None
                    }
                  },
                  None => None
                }
              }
              // #2737: same refusal as the qualified spelling -- an EDot that
              // resolves to neither a dictionary nor a concrete method is
              // compiled as a struct-field read, so the fallthrough is a
              // null-function call rather than an error.
              match recv_tn {
                Some(rtn) => dtd_check_unthreaded_dispatch(match as_tparam_dict {
                  Some(d) => Some(d),
                  None => as_recv_method
                }, rtn, m, String::concat(rtn, String::concat("::", m)), traits, fn_returns),
                None => ()
              }
              match as_tparam_dict {
                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), m, -1, -1), prepend_expr(robj, rwargs), off, callee_resolution),
                None => match as_recv_method {
                  // #1199 bug 2: `qual` (e.g. "Box::describe") can be a
                  // THREADED generic itself (`Box::describe[T: Hash](b:
                  // Box[T], value: T)`) exactly like a directly-written
                  // `Box::describe(b, value)` call reaching the EIdent arm
                  // above -- but until this fix, this EDot rewrite only ever
                  // built `ECall(EIdent(qual), [receiver, ...args])`,
                  // NEVER consulting lookup_gen/synth_dicts the way the
                  // EIdent arm does. So the qualified spelling of a call
                  // correctly prepended its witness dictionary argument(s)
                  // while the identical call written as dot-call sugar
                  // silently dropped them -- the callee's (already
                  // dict-threaded) signature and the dot-call's rewritten
                  // arg count then disagreed, and codegen emitted a call
                  // short its dict argument(s) (invalid wasm), not two
                  // notations of the same, both-valid call. Mirror the
                  // EIdent arm exactly: synth_dicts against the ORIGINAL
                  // (pre-rewrite) receiver + args, prepending the resolved
                  // dicts ahead of the rewritten receiver + args on success,
                  // falling back to the un-dicted call (same as the EIdent
                  // arm's own fallback) when synth_dicts can't resolve one.
                  Some(qual) => match lookup_gen_entry(gens, qual) {
                    Some(gen) => match synth_dicts_if(gen_prepends_dicts(gen), gen.type_params, gen.threaded, gen.constructor_recvs, prepend_expr(obj, args), traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                      Some(dicts) => ECall(EIdent(qual, doff), concat_expr_arrays(dicts, prepend_expr(robj, rwargs)), off, callee_resolution),
                      None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off, callee_resolution)
                    },
                    None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off, callee_resolution)
                  },
                  None => ECall(EDot(robj, m, doff, fdoff), rwargs, off, callee_resolution)
                }
              }
            },
            EFn(tp, bs, ps, _, _, _) => {
              let rewritten = rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              // Codex review of #2868: this synthesized the lambda's OWN bounds
              // only, so an immediately-invoked inner lambda referencing an
              // enclosing formal got no dictionary at all.
              let threaded = lambda_threaded_sig(tp, bs, ps, traits, dict_binds)
              if Array::length(threaded) > 0 {
                match synth_dicts(tp, threaded, array_empty(), args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                  Some(dicts) => ECall(rewritten, concat_expr_arrays(dicts, rwargs), off, callee_resolution),
                  None => ECall(rewritten, rwargs, off, callee_resolution)
                }
              } else {
                ECall(rewritten, rwargs, off, callee_resolution)
              }
            },
            _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off, callee_resolution)
          }
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(_) => expr,
    EStringInterp(_) => expr,
