// `derive (Hash)` key generation (#3544).
//
// A derived `T::hash_key` used to be `T::to_string(self)`. That rendering is
// for people, not for keys: it is not injective. A `String` field prints
// verbatim, so `S { a: "p, b: q", b: "r" }` and `S { a: "p", b: "q, b: r" }`
// both rendered `S { a: p, b: q, b: r }` -- two values `==` calls different
// shared one Map entry -- and `0.0 == -0.0` rendered `0` and `-0`, so two
// values `==` calls equal landed in two entries.
//
// The key is now its own encoding. Every component is SELF-DELIMITING --
// `<byte length>:<text>` -- so a concatenation of components reads back one
// way only; a variant is keyed by its name the same way; an `Option` /
// `Result` carries a one-letter tag before its payload; an `Array` carries its
// element count before its elements. A `Double` is keyed after adding `0.0`,
// which folds `-0.0` into `0.0` (IEEE: `-0 + 0 == +0`), so the two zeros that
// `==` equates share a key.
//
// The key identifies values as `==` does, with one exception: a `Double` is
// keyed as derived `compare` orders it, so EVERY NaN shares one key (`3:NaN`;
// `Double::to_string` spells every NaN bit pattern `NaN`). IEEE `==` calls a
// NaN unequal even to itself, and a key that followed it could never be read
// back -- `set_by(m, D::{ v: nan }, 1)` then `get_by(m, D::{ v: nan })` would
// miss. Derived `compare` calls two NaNs `Equal` (and `0.0` / `-0.0`), so for
// a `Double` "same key" is exactly "`compare` answers `Equal`". Pinned by
// `fixtures/derive_hash_key_injective_test.vibe`.
//
// A nested type that has a `hash_key` (derived or
// written) contributes that key. A field spelled through a type alias is
// keyed as the type the alias names.
//
// Every other field shape has no key and is REFUSED at the derive
// (`hash_note_unkeyed_field`, #3551), naming the edit; the judgement is an
// allow-list of what the encoding above covers. Refused: a declared struct /
// enum with no `hash_key` -- its `to_string` is not injective, so `Inner {
// a: "p, b: q", b: "r" }` and `Inner { a: "p", b: "q, b: r" }` rendered alike
// and two different enclosing values shared one key; a written `hash_key`
// that does not take that field's type (`hash_key_signature.vibe`); a type
// parameter of the declaration -- the derived key is one function for every
// instantiation, so the value is erased there and was keyed by its address:
// two equal `Box[Array[Int]]` values got two keys; and any other type, such
// as a `Map` or a function, which the key could only read by address.
//
// `to_string` (Show) is untouched; it is still generated for a `Hash` type.

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, namespace_rename_original
}

import ./equality_aliases.vibe {
  eq_expand_alias_ty
}

import ./hash_key_signature.vibe {
  hash_key_definitions, hash_key_fact_marker_read, hash_key_fact_pattern_read, hash_key_problem_row, hash_key_takes
}

import @vibe/ast {
  builtin_ref, impl_method_owner_head
}

import @vibe/core {
  array_empty
}

import ./derive_operations.vibe {
  qualified_name, show_for_typed
}

import ./formal_scope.vibe {
  is_marked_formal_name, is_scalar_type_name
}

import ./name_encoding.vibe {
  concat2, idx_str
}

import ./state.vibe {
  dtd_facts_explicit_ops, dtd_show_refusals
}

import ./utilities.vibe {
  str_array_contains
}

/// The written `hash_key` definitions the derived key may call, as `(T,
/// type variables, parameter type)`, and the ones it may not, as `(T, what is
/// wrong)` -- both filled by `collect_hash_key_types` for this program.
let hk_written: Array[(String, Array[String], TypeExpr)] = []

let hk_unusable: Array[(String, String)] = []

/// The types here or in the context that derive `Hash`.
let hk_derived: Array[String] = []

/// The types whose values have a `hash_key` this program can call: every
/// struct / enum here that derives `Hash`, every `T::hash_key` written here
/// that takes a `T` and returns a `String` (`hash_key_signature.vibe`), and
/// every one the program's other modules define that the whole-program scan
/// judged callable (`dtd_facts_explicit_ops`), with the parameter it recorded,
/// so a definition for `Box[Int]` keys only `Box[Int]` fields here too.
export fn collect_hash_key_types(stmts: Array[Stmt]) -> Array[String] {
  Array::truncate(hk_written, 0)
  Array::truncate(hk_unusable, 0)
  Array::truncate(hk_derived, 0)
  let out: Array[String] = array_empty()
  for stmt in stmts {
    match stmt {
      SStruct(_, name, _, derives, _, _) => if str_array_contains(derives, "Hash") {
        hk_push_unique(out, name)
        hk_push_unique(hk_derived, name)
      } else {
        ()
      },
      SEnum(_, name, _, _, derives) => if str_array_contains(derives, "Hash") {
        hk_push_unique(out, name)
        hk_push_unique(hk_derived, name)
      } else {
        ()
      },
      _ => ()
    }
  }
  let (good, bad) = hash_key_definitions(stmts)
  for row in good {
    let (owner, _, _) = row
    Array::push(hk_written, row)
    hk_push_unique(out, impl_method_owner_head(owner))
  }
  for row in bad {
    Array::push(hk_unusable, row)
  }
  // Another module's definition, which this module sees only through the
  // whole-program scan's rows: the parameter of a callable one, or why one is
  // not callable. A bare `T::hash_key` name says neither, so it keys nothing.
  let marked: Array[(String, String)] = array_empty()
  let patterned: Array[(String, Array[String], TypeExpr)] = array_empty()
  for name in dtd_facts_explicit_ops {
    match hash_key_fact_marker_read(name) {
      Some(row) => {
        let (owner, _) = row
        if !hk_judged_here(owner) {
          Array::push(marked, row)
        } else {
          ()
        }
      },
      None => ()
    }
    match hash_key_fact_pattern_read(name) {
      Some((owner, decoded)) => if !hk_judged_here(owner) {
        match decoded {
          Some((vars, param)) => Array::push(patterned, (owner, vars, param)),
          None => Array::push(marked, (owner, "has a signature this module could not read"))
        }
      } else {
        ()
      },
      None => ()
    }
  }
  for row in patterned {
    let (owner, _, _) = row
    if !hk_marked(marked, owner) {
      Array::push(hk_written, row)
      hk_push_unique(out, impl_method_owner_head(owner))
    } else {
      ()
    }
  }
  for row in marked {
    Array::push(hk_unusable, row)
  }
  out
}

fn hk_push_unique(out: Array[String], name: String) -> Unit {
  if !str_array_contains(out, name) {
    Array::push(out, name)
  } else {
    ()
  }
}

fn hk_marked(rows: Array[(String, String)], owner: String) -> Bool {
  let mut found = false
  for row in rows {
    let (o, _) = row
    if o == owner {
      found = true
    } else {
      ()
    }
  }
  found
}

/// Was a `T::hash_key` of this program's own statements judged?
fn hk_judged_here(owner: String) -> Bool {
  let mut found = hk_marked(hk_unusable, owner)
  for row in hk_written {
    let (o, _, _) = row
    if o == owner {
      found = true
    } else {
      ()
    }
  }
  found
}

/// Why the written `T::hash_key` cannot be called, or "". `head` is a type's
/// nominal head; an applied impl's method (`Box$impl$..`) counts for `Box`.
fn hk_unusable_reason(head: String) -> String {
  let mut out = ""
  for row in hk_unusable {
    let (o, why) = row
    if out == "" && impl_method_owner_head(o) == head {
      out = why
    } else {
      ()
    }
  }
  out
}

/// Is there a key the derived key can call for a field of type `ty` and head
/// `head`? A written definition, here or in another module, whose parameter
/// matches `ty` -- the methods of impls for single applications
/// (`impl Hash for Box[Int]`, `Box[Bool]`) are all `Box`'s, and one taking
/// `ty` is enough -- or `head`'s derived key, which takes every application.
fn hk_callable(head: String, ty: TypeExpr) -> Bool {
  let mut out = hk_derived_key(head)
  for row in hk_written {
    let (o, vars, param) = row
    if !out && impl_method_owner_head(o) == head && hash_key_takes(param, vars, ty) {
      out = true
    } else {
      ()
    }
  }
  out
}

/// Does `head` derive its key? It does when it derives `Hash` and no
/// `head::hash_key` is written: a written one, callable or not, takes the
/// derived key's place (`dtd_source_op_defined`).
fn hk_derived_key(head: String) -> Bool {
  let mut written = false
  for row in hk_written {
    let (o, _, _) = row
    if o == head {
      written = true
    } else {
      ()
    }
  }
  for row in hk_unusable {
    let (o, _) = row
    if o == head {
      written = true
    } else {
      ()
    }
  }
  str_array_contains(hk_derived, head) && !written
}

/// The owner whose `hash_key` a field of type `ty` and head `head` is keyed
/// by: the written definition that takes `ty` -- an applied impl's method is
/// named for its target (`Box$impl$..::hash_key`) -- or `head` itself.
fn hk_key_owner(head: String, ty: TypeExpr) -> String {
  let mut out = ""
  for row in hk_written {
    let (o, vars, param) = row
    if out == "" && impl_method_owner_head(o) == head && hash_key_takes(param, vars, ty) {
      out = o
    } else {
      ()
    }
  }
  if out == "" {
    head
  } else {
    out
  }
}

/// Are all the written `hash_key` definitions of head `T` methods of impls for
/// single applications (`impl Hash for Box[Int]`)?
fn hk_only_applied_impls(head: String) -> Bool {
  let mut out = true
  for row in hk_written {
    let (o, _, _) = row
    if impl_method_owner_head(o) == head && o == head {
      out = false
    } else {
      ()
    }
  }
  out
}

/// The parameter types of the written `T::hash_key` definitions of head `T`,
/// as the message shows them.
fn hk_written_param(head: String) -> String {
  let params: Array[String] = array_empty()
  for row in hk_written {
    let (o, _, param) = row
    if impl_method_owner_head(o) == head {
      Array::push(params, hk_type_text(param))
    } else {
      ()
    }
  }
  String::join(params, "` or `")
}

/// A fresh binder for the generated body. Each derived function owns one
/// counter, so nested Option / tuple / Array encodings never shadow each other.
fn hk_fresh(counter: Array[Int], stem: String) -> String {
  let n = Array::get(counter, 0)
  Array::set(counter, 0, n + 1)
  String::concat("__hk_", String::concat(stem, idx_str(n)))
}

fn hk_str(text: String) -> Expr {
  EString(text, -1)
}

/// `<byte length>:<text>`. The text is bound once so it is evaluated once.
fn hk_length_prefixed(text: Expr, counter: Array[Int]) -> Expr {
  let name = hk_fresh(counter, "s")
  let length = ECall(builtin_ref("String::length"), [EIdent(name, -1)], -1, [])
  let prefix = concat2(ECall(builtin_ref("Int::to_string"), [length], -1, []), hk_str(":"))
  ELet(name, text, concat2(prefix, EIdent(name, -1)), -1)
}

/// The key component for a value `val` of declared type `fty`.
fn hk_component(fty: TypeExpr, val: Expr, known_types: Array[String], hash_types: Array[String], counter: Array[Int]) -> Expr {
  match fty {
    TyName("String") => hk_length_prefixed(val, counter),
    TyName(n) => if n == "Double" || n == "Float" || n == "f64" || n == "f32" {
      // `-0.0 + 0.0` is `+0.0`, so the zeros `==` equates share one key;
      // every NaN renders `NaN` and shares one too, as `compare` calls them
      // `Equal` (see the header).
      // `Float::to_double` is the floatish identity marker (a `Float` is held
      // as the f64 of its f32 value); `Double::to_float` would round (#3543).
      let folded = EBinOp("+", ECall(builtin_ref("Float::to_double"), [val], -1, [
      ]), EFloat(0.0), -1)
      hk_length_prefixed(ECall(builtin_ref("Double::to_string"), [folded], -1, [
      ]), counter)
    } else if !is_scalar_type_name(n) && str_array_contains(hash_types, n) {
      hk_length_prefixed(ECall(EIdent(qualified_name(hk_key_owner(n, fty), "hash_key"), -1), [
        val
      ], -1, []), counter)
    } else {
      hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let bind = hk_fresh(counter, "o")
      let inner = hk_component(Array::get(args, 0), EIdent(bind, -1), known_types, hash_types, counter)
      EMatch(val, [
        (PCtor("Some", [PBind(bind)]), concat2(hk_str("S"), inner)),
        (PCtor("None", array_empty()), hk_str("N"))
      ])
    } else {
      hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let ok_bind = hk_fresh(counter, "r")
      let err_bind = hk_fresh(counter, "r")
      let ok_inner = hk_component(Array::get(args, 0), EIdent(ok_bind, -1), known_types, hash_types, counter)
      let err_inner = hk_component(Array::get(args, 1), EIdent(err_bind, -1), known_types, hash_types, counter)
      EMatch(val, [
        (PCtor("Ok", [PBind(ok_bind)]), concat2(hk_str("O"), ok_inner)),
        (PCtor("Err", [PBind(err_bind)]), concat2(hk_str("E"), err_inner))
      ])
    } else {
      hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
    },
    TyTuple(ts) => {
      let pats: Array[Pat] = array_empty()
      let parts: Array[Expr] = array_empty()
      for t in ts {
        let bind = hk_fresh(counter, "t")
        Array::push(pats, PBind(bind))
        Array::push(parts, hk_component(t, EIdent(bind, -1), known_types, hash_types, counter))
      }
      EMatch(val, [(PTuple(pats), hk_concat_all(parts))])
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      hk_array_component(Array::get(args, 0), val, known_types, hash_types, counter)
    } else {
      hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
    },
    TyApp(n, _) => if str_array_contains(hash_types, n) {
      hk_length_prefixed(ECall(EIdent(qualified_name(hk_key_owner(n, fty), "hash_key"), -1), [
        val
      ], -1, []), counter)
    } else {
      hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
    },
    _ => hk_length_prefixed(show_for_typed(fty, val, known_types), counter)
  }
}

/// `#<count>:` followed by each element's component.
fn hk_array_component(elem_ty: TypeExpr, val: Expr, known_types: Array[String], hash_types: Array[String], counter: Array[Int]) -> Expr {
  let arr = hk_fresh(counter, "a")
  let idx = hk_fresh(counter, "i")
  let acc = hk_fresh(counter, "acc")
  let length = ECall(builtin_ref("Array::length"), [EIdent(arr, -1)], -1, [])
  let elem = ECall(builtin_ref("Array::get"), [
    EIdent(arr, -1),
    EIdent(idx, -1)
  ], -1, [])
  let elem_key = hk_component(elem_ty, elem, known_types, hash_types, counter)
  let set_acc = EAssign(acc, concat2(EIdent(acc, -1), elem_key), EUnit, -1)
  let incr = EAssign(idx, EBinOp("+", EIdent(idx, -1), EInt(1), -1), EUnit, -1)
  let walk = EWhile(EBinOp("<", EIdent(idx, -1), length, -1), ESeq(set_acc, incr))
  let header = concat2(hk_str("#"), concat2(ECall(builtin_ref("Int::to_string"), [
    length
  ], -1, []), hk_str(":")))
  ELet(arr, val, ELetMut(idx, EInt(0), ELetMut(acc, header, ESeq(walk, EIdent(acc, -1)), -1), -1), -1)
}

fn hk_concat_all(parts: Array[Expr]) -> Expr {
  let n = Array::length(parts)
  if n == 0 {
    hk_str("")
  } else {
    let mut acc = Array::get(parts, n - 1)
    let mut j = n - 2
    while j >= 0 {
      acc = concat2(Array::get(parts, j), acc)
      j = j - 1
    }
    acc
  }
}

fn hk_fn(tname: String, body: Expr) -> Stmt {
  let params = [("self", Some(TyName(tname)))]
  SLet(false, false, qualified_name(tname, "hash_key"), None, EFn(array_empty(), array_empty(), params, Some(TyName("String")), None, body))
}

/// `let S::hash_key = (self: S) -> String { <component of each field> }`.
export fn gen_struct_hash_key_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String], hash_types: Array[String]) -> Stmt {
  let counter = [0]
  let parts: Array[Expr] = array_empty()
  for field in fields {
    let (fname, fty) = field
    Array::push(parts, hk_component(eq_expand_alias_ty(fty), EDot(EIdent("self", -1), fname, -1, -1), known_types, hash_types, counter))
  }
  hk_fn(tname, hk_concat_all(parts))
}

/// `let E::hash_key = (self: E) -> String { match self { V(p..) =>
/// <variant name, length-prefixed> ++ <component of each payload> } }`.
export fn gen_enum_hash_key_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String], hash_types: Array[String]) -> Stmt {
  let counter = [0]
  let arms: Array[(Pat, Expr)] = array_empty()
  for variant in variants {
    let (vname, ftypes) = variant
    let binds: Array[Pat] = array_empty()
    let parts: Array[Expr] = array_empty()
    Array::push(parts, hk_length_prefixed(hk_str(vname), counter))
    for fty in ftypes {
      let bind = hk_fresh(counter, "p")
      Array::push(binds, PBind(bind))
      Array::push(parts, hk_component(eq_expand_alias_ty(fty), EIdent(bind, -1), known_types, hash_types, counter))
    }
    Array::push(arms, (PCtor(vname, binds), hk_concat_all(parts)))
  }
  hk_fn(ename, EMatch(EIdent("self", -1), arms))
}

/// The first position in a field of type `fty` (aliases expanded) that a
/// derived `hash_key` cannot key, as `(kind, name, detail)`; `None` when every
/// position is keyed. The judgement is an allow-list of what `hk_component`
/// encodes: the scalars, `Option` / `Result` / `Array` / tuples of keyed
/// types, and a type whose `hash_key` takes it. The kinds:
///
///   `formal`     a type parameter of the declaration (`name`)
///   `declared`   a declared struct / enum with no `hash_key` (`name`)
///   `unusable`   a written `name::hash_key` the key cannot call (`detail`
///                says why)
///   `mismatch`   a written `name::hash_key` that takes another application
///                (`detail` is the type it takes)
///   `applied`    the type's only keys are impls for other applications
///                (`impl Hash for Box[Int]`; `name` is the field's type,
///                `detail` the applications that have one)
///   `opaque`     anything else -- a `Map`, a function, an opaque builtin --
///                which the key could only read by address (`name` is the
///                type)
fn hash_unkeyed_position(fty: TypeExpr, known_types: Array[String], hash_types: Array[String]) -> Option[(String, String, String)] {
  match fty {
    TyName(n) => if hk_is_keyed_scalar(n) {
      None
    } else {
      hash_unkeyed_head(n, fty, known_types, hash_types)
    },
    TyApp(n, args) => if (n == "Option" || n == "Array") && Array::length(args) == 1 {
      hash_unkeyed_first(args, known_types, hash_types)
    } else if n == "Result" && Array::length(args) == 2 {
      hash_unkeyed_first(args, known_types, hash_types)
    } else {
      hash_unkeyed_head(n, fty, known_types, hash_types)
    },
    TyTuple(ts) => hash_unkeyed_first(ts, known_types, hash_types),
    TyUnit => None,
    TyFn(_, _, _) => Some(("opaque", hk_type_text(fty), ""))
  }
}

/// The scalars `hk_component` keys by value: every spelling the checker
/// resolves to one (`resolve_builtin`). `Bytes` is not one -- it has no text.
fn hk_is_keyed_scalar(n: String) -> Bool {
  n == "Int" || n == "i32" || n == "Bool" || n == "Char" || n == "Unit" || n == "String" || n == "Double" || n == "Float" || n == "f64" || n == "f32"
}

/// A named type `n` (`fty` is the whole application), keyed only through its
/// own `hash_key`.
fn hash_unkeyed_head(n: String, fty: TypeExpr, known_types: Array[String], hash_types: Array[String]) -> Option[(String, String, String)] {
  let unusable = hk_unusable_reason(n)
  if is_marked_formal_name(n) {
    Some(("formal", n, ""))
  } else if hk_callable(n, fty) {
    // A definition that takes the field keys it, whatever else is written
    // for `n`: an unusable `fn Box::hash_key(x: Int)` is another binding
    // than `impl Hash for Box[Int]`'s method, which `hk_key_owner` calls.
    None
  } else if unusable != "" {
    Some(("unusable", n, unusable))
  } else if str_array_contains(hash_types, n) {
    if hk_only_applied_impls(n) {
      Some(("applied", hk_type_text(fty), hk_written_param(n)))
    } else {
      Some(("mismatch", n, hk_written_param(n)))
    }
  } else if str_array_contains(known_types, n) {
    Some(("declared", n, ""))
  } else {
    Some(("opaque", hk_type_text(fty), ""))
  }
}

fn hash_unkeyed_first(ts: Array[TypeExpr], known_types: Array[String], hash_types: Array[String]) -> Option[(String, String, String)] {
  let mut out: Option[(String, String, String)] = None
  for t in ts {
    if out is None {
      out = hash_unkeyed_position(t, known_types, hash_types)
    } else {
      ()
    }
  }
  out
}

/// The source spelling of a re-spelled declaration formal (`__Vfp_T` -> `T`).
fn hash_formal_source_name(n: String) -> String {
  if String::starts_with(n, "__Vfp_") {
    n[6: String::length(n)]
  } else {
    n
  }
}

/// A type as its source spells it: formals and merged names restored.
export fn hk_type_text(t: TypeExpr) -> String {
  match t {
    TyName(n) => namespace_rename_original(hash_formal_source_name(n)),
    TyApp(h, args) => namespace_rename_original(hash_formal_source_name(h)) + "[" + String::join(for a in args {
      hk_type_text(a)
    }, ", ") + "]",
    TyTuple(items) => "(" + String::join(for a in items {
      hk_type_text(a)
    }, ", ") + ")",
    TyUnit => "Unit",
    TyFn(ps, r, _) => "(" + String::join(for a in ps {
      hk_type_text(a)
    }, ", ") + ") -> " + hk_type_text(r)
  }
}

/// #3551: refuse a `derive (Hash)` field (or enum payload, `fname` = `V.0`)
/// that the derived key cannot key, leading with the edit. Before, such a
/// field was keyed by its rendering or its address: a declared type's
/// `to_string` is not injective; an erased type parameter, a `Map` and a field
/// spelled through an alias rendered as an address; and a written `hash_key`
/// of another signature was called with the field regardless, as was one
/// that declares an effect row, from a key that declares none.
export fn hash_note_unkeyed_field(tname: String, fname: String, fty: TypeExpr, known_types: Array[String], hash_types: Array[String]) -> Unit {
  let shown = namespace_rename_original(tname)
  let yourself = "write `" + shown + "::hash_key` yourself"
  let msg = match hash_unkeyed_position(eq_expand_alias_ty(fty), known_types, hash_types) {
    Some((kind, n, detail)) => if kind == "formal" {
      let formal = hash_formal_source_name(n)
      yourself + ", or remove `Hash` from the `derive` of `" + shown + "`: its derived key is one function for every instantiation, so field `" + fname + "` holds `" + formal + "` (a type parameter of `" + shown + "`), which has no key there [@fn=" + shown + "]"
    } else if kind == "declared" {
      let inner = namespace_rename_original(n)
      "add `Hash` to the `derive` of `" + inner + "` (or write `" + inner + "::hash_key`), or " + yourself + ": the derived key of `" + shown + "` keys field `" + fname + "` by the key of `" + inner + "`, which has none -- its rendering is not a key, since two different values can render alike [@fn=" + shown + "]"
    } else if kind == "unusable" && hash_key_problem_row(detail) != "" {
      let inner = namespace_rename_original(n)
      let row = hash_key_problem_row(detail)
      "remove `with " + row + "` from `" + inner + "::hash_key`, or " + yourself + ": the derived key of `" + shown + "` calls `" + inner + "::hash_key` with field `" + fname + "` and declares no effects, so a caller with none in its row (a pure helper, `Map::set_by`) would perform `" + row + "` unchecked [@fn=" + shown + "]"
    } else if kind == "unusable" {
      let inner = namespace_rename_original(n)
      "write `" + inner + "::hash_key` as `fn " + inner + "::hash_key(x: " + inner + ") -> String`, or " + yourself + ": the derived key of `" + shown + "` calls `" + inner + "::hash_key` with field `" + fname + "`, but `" + inner + "::hash_key` " + detail + " [@fn=" + shown + "]"
    } else if kind == "applied" {
      "add `impl Hash for " + n + "`, or " + yourself + ": the derived key of `" + shown + "` keys field `" + fname + "` by an impl of `Hash` for `" + n + "`, and there is one only for `" + detail + "` [@fn=" + shown + "]"
    } else if kind == "mismatch" {
      let inner = namespace_rename_original(n)
      "make `" + inner + "::hash_key` take every `" + inner + "` (`fn " + inner + "::hash_key[T](x: " + inner + "[T]) -> String`), or " + yourself + ": the derived key of `" + shown + "` calls `" + inner + "::hash_key` with field `" + fname + "`, which it does not take -- it takes only `" + detail + "` [@fn=" + shown + "]"
    } else {
      yourself + ", or remove `Hash` from the `derive` of `" + shown + "`: field `" + fname + "` holds `" + n + "`, which has no key -- the derived key could only read it by its address, so two equal values would get different keys [@fn=" + shown + "]"
    },
    None => ""
  }
  if msg != "" && !str_array_contains(dtd_show_refusals, msg) {
    Array::push(dtd_show_refusals, msg)
  } else {
    ()
  }
}
