fn constructor_substs_from_recvs(recvs: Array[(String, Int)], orig_args: Array[Expr], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(recvs) {
    let (formal, recv_idx_raw) = Array::get(recvs, i)
    if is_constructor_recv_index(recv_idx_raw) {
      let recv_idx = decode_constructor_recv_index(recv_idx_raw)
      if recv_idx >= 0 && recv_idx < Array::length(orig_args) {
        match infer_constructor_arg_type_name(Array::get(orig_args, recv_idx), gens, struct_sets, var_types, fn_returns) {
          Some(actual) => Array::push(out, (formal, actual)),
          None => ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #3365: how many value parameters the trait declares for `method` -- the
/// arity of the dictionary slot that holds it. The first signature of that
/// name wins, as in the flattened table the dictionary struct is built from.
fn trait_method_arity(sigs: Array[(String, Array[TypeExpr], TypeExpr)], method: String) -> Int {
  Array::length(trait_method_params(sigs, method))
}

/// The value parameters the trait declares for `method`; the first signature
/// of that name wins, as for `trait_method_arity`.
fn trait_method_params(sigs: Array[(String, Array[TypeExpr], TypeExpr)], method: String) -> Array[TypeExpr] {
  let mut out: Array[TypeExpr] = []
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(sigs) {
    let (m, params, _) = Array::get(sigs, i)
    if m == method {
      out = params
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `field` behind a closure that first takes the slot witnesses, which it does
/// not read, then the method's `arity` value parameters.
fn method_witness_slot_closure(slots: Array[(String, String)], arity: Int, field: Expr) -> Expr {
  let wparams: Array[(String, Option[TypeExpr])] = array_empty()
  let callargs = empty_expr_array()
  let mut si = 0
  while si < Array::length(slots) {
    Array::push(wparams, (method_witness_param(si), None))
    si = si + 1
  }
  let mut wi = 0
  while wi < arity {
    let wname = String::concat("__w", __to_string(wi))
    Array::push(wparams, (wname, None))
    Array::push(callargs, EIdent(wname, -1))
    wi = wi + 1
  }
  EFn(empty_str_array(), array_empty(), wparams, None, None, ECall(field, callargs, -1, [
  ]))
}

fn build_concrete_dict_for_target(actual_target: TypeExpr, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Option[Expr]) -> Option[Expr] with Exception {
  let cname = impl_target_head(actual_target)
  match lookup_trait_sigs(traits, trait_ref_name(trait_name)) {
    Some(sigs) => {
      let mnames = method_names_of_sigs(sigs)
      let recfields = array_empty()
      let mut mi = 0
      let mut failed = false
      while mi < Array::length(mnames) {
        let m = Array::get(mnames, mi)
        // #3580: the witnesses for the method's own bounded formals arrive
        // with each call, ahead of its arguments (see method_witnesses.vibe).
        let slots = trait_method_witness_slots(traits, trait_name, m)
        let slot_binds = method_witness_binds(traits, slots)
        let method_formals = match trait_method_binder(trait_name, m) {
          Some(binder) => for tp in binder.0 {
            type_param_name(tp)
          },
          None => empty_str_array()
        }
        // Whether this method's field already takes the slot witnesses.
        let mut slotted = false
        let fields_before = Array::length(recfields)
        let plain_qm = dtd_program_fn_name(fn_returns, String::concat(cname, String::concat("::", m)))
        let specialized_qm = impl_specialized_method_binding_name(cname, trait_name, impl_target_key(actual_target), m)
        let qm = if specialized_qm != "" && fn_exists(fn_returns, specialized_qm) {
          specialized_qm
        } else match matching_generic_impl_method(gens, cname, trait_name, m, actual_target) {
          Some(generic_qm) => generic_qm,
          None => plain_qm
        }
        // #2523: for the INJECTED builtin `Eq` at a scalar the witness is the
        // builtin comparison, NOT whatever top-level function happens to be
        // named `<Type>::equals`. Measured: with `trait Weird { equals(Self,
        // Self) -> Bool }` and `impl Weird for Int { equals(a, b) { false } }`
        // in the program, that impl DEFINES `Int::equals`, so this `fn_exists`
        // fallback picked it up and `same[T: Eq + Weird](1, 1)` answered
        // `false`. `fixtures/eq_bound_witness_trait_test.vibe` exists to pin
        // exactly that hijack from the other direction: the witness is keyed
        // by `<Type>::<method>`, which any trait with an `equals` for that
        // type can occupy. Skipping `fn_exists` drops through to the builtin
        // and scalar arms below, where the right answer is.
        let injected_eq_scalar = dtd_eq_was_injected() && trait_ref_name(trait_name) == dtd_eq_witness_trait() && (dtd_scalar_eq_witness(cname, m) is Some)
        let specialized_generic_eq = match actual_target {
          TyApp(ghead, gargs) => if trait_ref_name(trait_name) == dtd_eq_witness_trait() && m == "equals" && Array::length(gargs) > 0 && str_array_contains(dtd_eq_derived_generic, ghead) && !eq_ty_has_formal(actual_target) {
            // #3008: see `dtd_eq_derived_generic`. The closure body is exactly
            // what a direct `a == b` at this type lowers to.
            let gparams: Array[(String, Option[TypeExpr])] = [
              ("__geq_a", Some(actual_target)),
              ("__geq_b", Some(actual_target))
            ]
            Some(EFn(array_empty(), array_empty(), gparams, Some(TyName("Bool")), None, eq_for_typed_declared_app(actual_target, ghead, gargs, EIdent("__geq_a", -1), EIdent("__geq_b", -1), dtd_eq_known_types)))
          } else {
            None
          },
          _ => None
        }
        if specialized_generic_eq is Some {
          match specialized_generic_eq {
            Some(closure) => Array::push(recfields, (m, closure)),
            None => ()
          }
        } else if injected_eq_scalar || not(fn_exists(fn_returns, qm)) {
          // #2872: the name may still be a BUILTIN -- `fn_exists` knows only
          // user functions, and `String::equals` is a real builtin that a
          // bodyless `impl Eq for String` should be able to resolve to.
          // Eta-expanded, because a witness slot holds a value.
          //
          // A renderer witness still needs an actual implementation, like
          // every other method: `builtin_value_form_arity` refuses an
          // effectful or unconstrained row, so falling back to erased
          // __to_string cannot happen here and the pointer-as-text defect
          // (#2840) stays closed.
          match dtd_builtin_witness(qm) {
            Some(closure) => Array::push(recfields, (m, closure)),
            None => match dtd_scalar_eq_witness(cname, m) {
              // #2523: `Int` / `Double` / `Bool` / `Char` have no
              // `<Type>::equals` builtin the way `String` does, and the
              // prelude's impls cannot carry a body without colliding with a
              // program's own. Synthesize the annotated comparison instead.
              Some(closure) => Array::push(recfields, (m, closure)),
              None => {
                // #2872 case (1): the impl declares no body for `m` and there
                // is no `<Type>::<m>` of any kind to stand in. Leaving the
                // dictionary with a hole emitted the call one argument short,
                // which the wasm VALIDATOR rejected -- after `vibe check`
                // certified the program. Refuse here instead, naming the edit
                // (#2475's shape: a build error, not a bare trap).
                throw(String::concat("add a body for `", String::concat(m, String::concat("` to `impl ", String::concat(trait_ref_name(trait_name), String::concat(" for ", String::concat(cname, String::concat("`: a method-bearing trait's impl must implement every method, and there is no `", String::concat(qm, "` to fall back to")))))))))
              }
            }
          }
        } else {
          match lookup_gen(gens, qm) {
            Some(threaded) => if Array::length(threaded) == 0 {
              Array::push(recfields, (m, EIdent(qm, -1)))
            } else {
              let callargs = empty_expr_array()
              let mut bi = 0
              let mut subok = true
              while bi < Array::length(threaded) {
                let (type_param, btrait, _) = Array::get(threaded, bi)
                let own_formal = if Array::length(method_formals) == 0 {
                  None
                } else match lookup_gen_entry(gens, qm) {
                  Some(gen) => match impl_formal_method_formal(gen, type_param, trait_method_params(sigs, m), method_formals) {
                    Some(formal) => Some(formal),
                    None => if impl_method_declares_formal(gen, type_param) {
                      // The method's own formal, in no parameter: only the
                      // result names it, and a call through the trait has
                      // no argument to read its witness from.
                      throw("call `" + cname + "::" + m + "(..)` at its concrete type, or give `" + trait_ref_name(trait_name) + "::" + m + "` a parameter of type `" + type_param + "`: a call through the trait reads the `" + trait_ref_name(btrait) + "` witness for the method's own type parameter `" + type_param + "` from an argument, and no parameter carries it")
                    } else {
                      None
                    }
                  },
                  None => None
                }
                match own_formal {
                  Some(formal) => match dict_for_trait_in_scope(slot_binds, traits, formal, btrait) {
                    Some(dict) => Array::push(callargs, dict),
                    None => throw("add `" + trait_ref_name(btrait) + "` to the bound on `" + formal + "` in `" + trait_ref_name(trait_name) + "::" + m + "`, or remove it from `" + type_param + "` in the impl's `" + m + "` for `" + cname + "`: a call through `" + trait_ref_name(trait_name) + "` passes only the witnesses the trait method's own binder names")
                  },
                  None => {
                    let nested_target = match generic_impl_bound_target(gens, qm, type_param, trait_method_params(sigs, m), actual_target) {
                      Some(target) => Some(target),
                      None => match arg_expr {
                        Some(value) => match first_array_elem(value) {
                          Some(elem) => infer_impl_target_expr(elem, struct_sets, var_types, fn_returns),
                          None => None
                        },
                        None => None
                      }
                    }
                    match nested_target {
                      Some(target) => match build_concrete_dict_for_target(target, btrait, traits, gens, struct_sets, var_types, fn_returns, None) {
                        Some(sd) => Array::push(callargs, sd),
                        None => {
                          subok = false
                        }
                      },
                      None => {
                        match actual_target {
                          TyName("Array") => throw(String::concat("add an explicit `Array[Element]` annotation to the array binding or parameter before this trait call: the element type needed for `", String::concat(btrait, "` is not available here"))),
                          // #3547: a bounded generic impl's own witness needs
                          // the type argument. Returning None here left the
                          // call one dictionary short, which the wasm validator
                          // rejected after a clean check.
                          TyName(head) => throw("annotate the argument's full type before this trait call (for example `let x: " + head + "[Int] = ..`): the type argument `" + type_param + "` of `" + head + "` needed for its `" + trait_ref_name(btrait) + "` witness is not available here"),
                          // #3569: the type is known, but no `Self` position of
                          // the method spells `type_param` (nor the impl target),
                          // so nothing says which part of it the formal is.
                          // Leaving the dictionary out emitted the call short.
                          TyApp(head, _) => throw("spell `" + type_param + "` in the type of `" + qm + "`'s `Self` parameter (for example `self: " + head + "[" + type_param + "]`), or replace `" + type_param + "` with the concrete type it stands for: the trait calls `" + qm + "` with a `" + head + "`, and the `" + trait_ref_name(btrait) + "` witness for `" + type_param + "` is read only from that parameter"),
                          _ => ()
                        }
                        subok = false
                      }
                    }
                  }
                }
                bi = bi + 1
              }
              if subok {
                // #3365: the slot holds the impl method with its own
                // dictionaries applied, so the closure takes exactly the
                // method's value parameters. It used to take one (`(__w) ->
                // qm(dicts, __w)`), right for `show(Self)` and one argument
                // short for `same(Self, Self)`: the call failed wasm
                // validation ("not enough arguments on the stack").
                let wparams: Array[(String, Option[TypeExpr])] = array_empty()
                let mut si = 0
                while si < Array::length(slots) {
                  Array::push(wparams, (method_witness_param(si), None))
                  si = si + 1
                }
                slotted = true
                let mut wi = 0
                while wi < trait_method_arity(sigs, m) {
                  let wname = String::concat("__w", __to_string(wi))
                  Array::push(wparams, (wname, None))
                  Array::push(callargs, EIdent(wname, -1))
                  wi = wi + 1
                }
                let closure = EFn(empty_str_array(), array_empty(), wparams, None, None, ECall(EIdent(qm, -1), callargs, -1, [
                ]))
                Array::push(recfields, (m, closure))
              } else {
                failed = true
              }
            },
            None => Array::push(recfields, (m, EIdent(qm, -1)))
          }
        }
        if Array::length(slots) > 0 && !slotted && Array::length(recfields) == fields_before + 1 {
          // An impl method that reads none of the slot witnesses still
          // receives them: the call through the trait always passes them.
          let (_, field) = Array::get(recfields, fields_before)
          Array::set(recfields, fields_before, (m, method_witness_slot_closure(slots, trait_method_arity(sigs, m), field)))
        } else {
          ()
        }
        mi = mi + 1
      }
      if failed {
        None
      } else {
        let dict_args = trait_ref_args(trait_name)
        if Array::length(dict_args) > 0 {
          Some(ERecord(dict_struct_name(trait_name), recfields, dict_args))
        } else {
          Some(ERecord("", recfields, empty_ty_args()))
        }
      }
    },
    None => None
  }
}

fn build_concrete_dict(cname: String, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[DictGen], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Expr) -> Option[Expr] with Exception {
  let target = match infer_impl_target_expr(arg_expr, struct_sets, var_types, fn_returns) {
    Some(inferred) => inferred,
    None => TyName(cname)
  }
  build_concrete_dict_for_target(target, trait_name, traits, gens, struct_sets, var_types, fn_returns, Some(arg_expr))
}

/// The in-scope witness of `tparam` for `trait_name`: the caller's own
/// dictionary parameter for that trait, or -- #3547 -- one projected out of
/// the dictionary of a SUB-trait bound. Under `[T: Loud]` with `trait Loud:
/// Name`, `Name::name(x)` asks for `T`'s `Name` witness; `Loud`'s dictionary
/// carries every `Name` method (the sigs are flattened down), so the `Name`
/// dictionary is a record of those fields read from it. Before this the
/// lookup missed and the pass tried to build a concrete `Name` dictionary for
/// the formal `T`, refusing a program the checker accepted. A trait with type
/// arguments is not projected: its dictionary struct is named by them.
fn dict_for_trait_in_scope(dict_binds: Array[(String, String, String, Array[String])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], tparam: String, trait_name: String) -> Option[Expr] {
  match find_dict_for_trait(dict_binds, tparam, trait_name) {
    Some(dict_pname) => Some(EIdent(dict_pname, -1)),
    None => if Array::length(trait_ref_args(trait_name)) > 0 {
      None
    } else match lookup_trait_sigs(traits, trait_ref_name(trait_name)) {
      None => None,
      Some(sigs) => {
        let mut out: Option[Expr] = None
        for bind in dict_binds {
          let (tp, tr, dict_pname, methods) = bind
          if (out is None) && tp == tparam && trait_ref_name(tr) != trait_ref_name(trait_name) && dtd_trait_entails(tr, trait_name) {
            let fields: Array[(String, Expr)] = []
            let mut complete = true
            for m in method_names_of_sigs(sigs) {
              if str_array_contains(methods, m) {
                Array::push(fields, (m, EDot(EIdent(dict_pname, -1), m, -1, -1)))
              } else {
                complete = false
              }
            }
            if complete {
              out = Some(ERecord("", fields, empty_ty_args()))
            } else {
              ()
            }
          } else {
            ()
          }
        }
        out
      }
    }
  }
}

/// #3287: the dictionary for a formal the callee receives NESTED
/// (`a: Option[T]`). The formal's type is read by matching each carrying
/// parameter's annotation against the argument (`nested_recv_binding`).
///
/// When every carrying argument is a constructor literal whose variant holds
/// no value of the formal (`None`, or `Ok(..)` of `Res[A, T]` read for `T`),
/// no value of it reaches the callee, and the `Eq` witness -- whose one method
/// consumes values and produces none -- is never applied; any `Eq` dictionary
/// is sound there, and `Int`'s is used. Any other trait could build a value
/// from its dictionary, so it still needs the type. An argument whose type
/// cannot be read is refused with the edit, rather than emitting the call
/// short its dictionary, which fails wasm validation.
fn synth_nested_dict(type_param: String, trait_name: String, callee_type_params: Array[String], nested_recvs: Array[(String, Int, TypeExpr)], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Option[Expr] with Exception {
  let binding = nested_recv_binding(type_param, nested_recvs, orig_args, struct_sets, var_types, fn_returns)
  let target = match binding {
    NestedFound(t) => Some(t),
    NestedAbsent => if trait_ref_name(trait_name) == dtd_eq_witness_trait() {
      Some(TyName("Int"))
    } else {
      None
    },
    NestedUnknown => None
  }
  match target {
    Some(t) => {
      let nm = impl_target_head(t)
      let concrete_trait = specialize_applied_trait_for_target(trait_name, callee_type_params, t, gens)
      match dict_for_trait_in_scope(dict_binds, traits, nm, concrete_trait) {
        Some(dict) => Some(dict),
        None => build_concrete_dict_for_target(t, concrete_trait, traits, gens, struct_sets, var_types, fn_returns, None)
      }
    },
    None => throw("annotate the argument this call reads `" + type_param + "` from (for example `let a: Option[Int] = None`, or a lambda's result type: `() -> Int { .. }`): the type `" + type_param + "` stands for is needed for its `" + trait_ref_name(trait_name) + "` witness and is not available here")
  }
}

/// #3616: the in-scope bounds of the formal `tparam` that instantiate the
/// applied bound `trait_name` (which mentions the callee's formals). Under
/// `[T: It[Int]]`, `It::pass(x, 2)` requests `It[A]` of `T`, and the witness is
/// the caller's own `It[Int]` dictionary.
fn bound_applied_trait_candidates(dict_binds: Array[(String, String, String, Array[String])], tparam: String, trait_name: String, callee_type_params: Array[String]) -> Array[String] {
  let out = empty_str_array()
  if trait_ref_mentions_param(trait_name, callee_type_params) {
    match trait_ref_from_key(trait_name) {
      Some(requested) => for bind in dict_binds {
        let (tp, tr, _, _) = bind
        if tp == tparam && trait_ref_name(tr) == trait_ref_name(trait_name) && !str_array_contains(out, tr) {
          match trait_ref_from_key(tr) {
            Some(bound_ref) => {
              let scratch = []
              if impl_target_pattern_matches(requested, bound_ref, callee_type_params, scratch) {
                Array::push(out, tr)
              } else {
                ()
              }
            },
            None => ()
          }
        } else {
          ()
        }
      },
      None => ()
    }
  } else {
    ()
  }
  out
}

/// #3616: the instantiation of the applied bound `trait_name` this call
/// dispatches through; when more than one still fits, those candidates; and
/// whether they are the receiver formal `nm`'s in-scope bounds rather than
/// impls for `target`. One candidate is taken as it is. With several
/// (`impl It[Int] for P` and `impl It[String] for P`), the formals the other
/// arguments fix (`It::pass(p, 2)` reads `A = Int`) narrow them. A call they
/// do not narrow to one is ambiguous, and the caller refuses it rather than
/// guess.
fn resolve_applied_trait_for_call(trait_name: String, callee_type_params: Array[String], target: TypeExpr, nm: String, dict_binds: Array[(String, String, String, Array[String])], gens: Array[DictGen], param_types: Array[Option[TypeExpr]], orig_args: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> (String, Array[String], Bool) {
  let bound_candidates = bound_applied_trait_candidates(dict_binds, nm, trait_name, callee_type_params)
  let from_bounds = Array::length(bound_candidates) > 0
  let candidates = if from_bounds {
    bound_candidates
  } else {
    applied_trait_candidates(trait_name, callee_type_params, target, gens)
  }
  if Array::length(candidates) == 1 {
    (Array::get(candidates, 0), empty_str_array(), from_bounds)
  } else if Array::length(candidates) == 0 {
    (trait_name, empty_str_array(), from_bounds)
  } else {
    let bindings = call_arg_formal_bindings(param_types, orig_args, callee_type_params, struct_sets, var_types, fn_returns)
    let narrowed = narrow_applied_trait_candidates(trait_name, callee_type_params, candidates, bindings)
    if Array::length(narrowed) == 1 {
      (Array::get(narrowed, 0), empty_str_array(), from_bounds)
    } else if Array::length(narrowed) == 0 {
      (trait_name, candidates, from_bounds)
    } else {
      (trait_name, narrowed, from_bounds)
    }
  }
}

/// `a`, `a and b`, `a, b and c`.
fn join_with_and(items: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(items) {
    let sep = if i == 0 {
      ""
    } else if i + 1 == Array::length(items) {
      " and "
    } else {
      ", "
    }
    out = out + sep + Array::get(items, i)
    i = i + 1
  }
  out
}

/// A trait reference key (`trait_ref_key`) as the source spells it.
fn trait_ref_text(key: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => hk_type_text(reference),
    None => key
  }
}

/// #3616: the refusal for a call `resolve_applied_trait_for_call` could not
/// narrow to one candidate. It leads with the edit: annotate the argument that
/// fixes the trait's argument when one of the method's parameters carries it,
/// and otherwise name the trait's argument in a bound.

fn ambiguous_applied_trait_msg(trait_name: String, callee_type_params: Array[String], param_types: Array[Option[TypeExpr]], target: TypeExpr, candidates: Array[String], from_bounds: Bool) -> String {
  let head = hk_type_text(target)
  let trait_text = trait_ref_text(trait_name)
  let formals = empty_str_array()
  for formal in callee_type_params {
    if trait_ref_mentions_param(trait_name, [formal]) {
      Array::push(formals, formal)
    } else {
      ()
    }
  }
  let fixes = join_with_and(for f in formals {
    "`" + hk_type_text(TyName(f)) + "`"
  }) + " in `" + trait_text + "`"
  let mut readable = false
  for ann in param_types {
    match ann {
      Some(ty) => if type_expr_mentions_param(ty, formals) {
        readable = true
      } else {
        ()
      },
      None => ()
    }
  }
  let quoted = for c in candidates {
    "`" + trait_ref_text(c) + "`"
  }
  let impls = for c in candidates {
    "`impl " + trait_ref_text(c) + " for " + head + "`"
  }
  let sample = trait_ref_text(Array::get(candidates, 0))
  let annotate = "annotate the argument of this call that fixes " + fixes + " (for example `let a: Int = ..`)"
  if from_bounds {
    let edit = if readable {
      annotate + ", or keep one `" + trait_ref_name(trait_name) + "` bound on `" + head + "`"
    } else {
      "keep one `" + trait_ref_name(trait_name) + "` bound on `" + head + "`"
    }
    edit + ": `" + head + "` is bound by " + join_with_and(quoted) + ", and this call's arguments do not say which one it means"
  } else {
    let bound = "call the method through a bound that names the trait's argument, such as `fn via[T: " + sample + "](x: T)`"
    let edit = if readable {
      annotate + ", or " + bound
    } else {
      bound
    }
    edit + ": `" + head + "` has " + join_with_and(impls) + ", and this call's arguments do not say which one it means"
  }
}

/// None when any receiver's witness cannot be determined (the call is then left
/// unrewritten). Each bound is satisfied either by a concrete dict literal (the
/// receiver type is syntactically known) or by forwarding the caller's own dict
/// parameter (the receiver is a type parameter bound by the same trait in the
/// enclosing generic — the generic->generic case).
export fn synth_dicts(callee_type_params: Array[String], threaded: Array[(String, String, Int)], constructor_recvs: Array[(String, Int)], nested_recvs: Array[(String, Int, TypeExpr)], param_types: Array[Option[TypeExpr]], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Option[Array[Expr]] with Exception {
  let dicts = empty_expr_array()
  let mut ok = true
  let mut bi = 0
  while bi < Array::length(threaded) {
    let (type_param, trait_name, recv_idx_raw) = Array::get(threaded, bi)
    // #1199 bug 1: decode the packed receiver kind (see
    // encode_array_elem_recv_index's doc comment) once, up front, so the rest
    // of this loop body works from a plain non-negative index + the right
    // inference function either way.
    let is_constructor_recv = is_constructor_recv_index(recv_idx_raw)
    let is_elem_recv = is_array_elem_recv_index(recv_idx_raw)
    let recv_idx = if is_constructor_recv {
      decode_constructor_recv_index(recv_idx_raw)
    } else if is_elem_recv {
      decode_array_elem_recv_index(recv_idx_raw)
    } else {
      recv_idx_raw
    }
    if ok && is_nested_recv_index(recv_idx_raw) {
      match synth_nested_dict(type_param, trait_name, callee_type_params, nested_recvs, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
        Some(dict) => Array::push(dicts, dict),
        None => {
          ok = false
        }
      }
    } else if ok && recv_idx < 0 {
      // Enclosing formal forwarded into a nested lambda: the witness is
      // already in `dict_binds` under the outer spelling, not inferred from
      // this call's arguments.
      match dict_for_trait_in_scope(dict_binds, traits, type_param, trait_name) {
        Some(dict) => Array::push(dicts, dict),
        None => {
          ok = false
        }
      }
    } else if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {
      let recv_arg = Array::get(orig_args, recv_idx)
      let inferred = if is_constructor_recv {
        infer_constructor_arg_type_name(recv_arg, gens, struct_sets, var_types, fn_returns)
      } else if is_elem_recv {
        infer_arg_elem_type_name(recv_arg, struct_sets, var_types, fn_returns)
      } else {
        infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns)
      }
      match inferred {
        Some(nm) => {
          let resolved_trait = if is_constructor_recv {
            let substs = constructor_substs_from_recvs(constructor_recvs, orig_args, gens, struct_sets, var_types, fn_returns)
            push_constructor_subst(substs, type_param, nm)
            specialize_trait_constructors(trait_name, substs)
          } else {
            trait_name
          }
          let target = if is_elem_recv || is_constructor_recv {
            // The receiver carries `Array[T]`, but this witness is for T.
            // A constructor receiver similarly carries `F[A]`, while its
            // witness target is the constructor F rather than F[A].
            TyName(nm)
          } else match infer_impl_target_expr(recv_arg, struct_sets, var_types, fn_returns) {
            Some(inferred) => inferred,
            None => TyName(nm)
          }
          let (concrete_trait, ambiguous, from_bounds) = resolve_applied_trait_for_call(resolved_trait, callee_type_params, target, nm, dict_binds, gens, param_types, orig_args, struct_sets, var_types, fn_returns)
          match dict_for_trait_in_scope(dict_binds, traits, nm, concrete_trait) {
            Some(dict) => Array::push(dicts, dict),
            None => {
              if Array::length(ambiguous) > 0 {
                throw(ambiguous_applied_trait_msg(concrete_trait, callee_type_params, param_types, target, ambiguous, from_bounds))
              } else {
                ()
              }
              match build_concrete_dict_for_target(target, concrete_trait, traits, gens, struct_sets, var_types, fn_returns, Some(recv_arg)) {
                Some(dict) => Array::push(dicts, dict),
                None => {
                  ok = false
                }
              }
            }
          }
        },
        None => if is_constructor_recv || trait_ref_mentions_param(trait_name, callee_type_params) {
          // Constructor proofs and bounds still mentioning the callee's
          // formals can be unresolved while rewriting a generic body.
          ok = false
        } else {
          // An ordinary receiver needs a dictionary here. Omitting it emits
          // an invalid call, including for unresolved builtin value aliases.
          throw("add an explicit type annotation to the argument binding before this trait call: the type needed for `" + trait_ref_name(trait_name) + "` is not available here")
        }
      }
    } else {
      ok = false
    }
    bi = bi + 1
  }
  if ok {
    Some(dicts)
  } else {
    None
  }
}

/// The trait `dict_pname` (a dictionary in `dict_binds`) is a witness of, or
/// "" when no row names it.
export fn dict_binds_trait(dict_binds: Array[(String, String, String, Array[String])], dict_pname: String) -> String {
  let mut out = ""
  let mut i = 0
  while out == "" && i < Array::length(dict_binds) {
    let (_, tr, pname, _) = Array::get(dict_binds, i)
    if pname == dict_pname {
      out = tr
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #3580: the witnesses a call of `member` through the dictionary `dict_pname`
/// passes ahead of its arguments -- one per slot of the trait method's own
/// binder (`trait_method_witness_slots`), each read from the argument the
/// trait's signature puts that formal in, exactly as a call of a bounded
/// generic function reads it. `orig_args` include the receiver. Empty for a
/// method without a binder of its own. A formal no argument carries (one only
/// the result type mentions) is refused with the edit: the dictionary slot
/// takes the witness, and leaving it out emits the call short, which the wasm
/// validator rejects.
export fn method_witness_call_dicts(dict_binds: Array[(String, String, String, Array[String])], dict_pname: String, member: String, orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Array[Expr] with Exception {
  let trait_name = dict_binds_trait(dict_binds, dict_pname)
  let slots: Array[(String, String)] = if trait_name == "" {
    []
  } else {
    trait_method_witness_slots(traits, trait_name, member)
  }
  if Array::length(slots) == 0 {
    empty_expr_array()
  } else {
    let sig_params = match lookup_trait_sigs(traits, trait_ref_name(trait_name)) {
      Some(sigs) => trait_method_params(sigs, member),
      None => array_empty()
    }
    let params: Array[(String, Option[TypeExpr])] = []
    let mut pi = 0
    while pi < Array::length(sig_params) {
      Array::push(params, ("__mwarg" + __to_string(pi), Some(Array::get(sig_params, pi))))
      pi = pi + 1
    }
    let display = trait_ref_name(trait_name) + "::" + member
    let formals = empty_str_array()
    let threaded: Array[(String, String, Int)] = []
    let nested_recvs: Array[(String, Int, TypeExpr)] = []
    let mut si = 0
    while si < Array::length(slots) {
      let (formal, tr) = Array::get(slots, si)
      if !str_array_contains(formals, formal) {
        Array::push(formals, formal)
      } else {
        ()
      }
      let ridx = find_recv_index(params, formal)
      let widx = find_array_elem_recv_index(params, formal)
      let nested = find_nested_recv_indices(params, formal)
      if ridx >= 0 {
        Array::push(threaded, (formal, tr, ridx))
      } else if widx >= 0 {
        Array::push(threaded, (formal, tr, encode_array_elem_recv_index(widx)))
      } else if Array::length(nested) > 0 {
        Array::push(threaded, (formal, tr, encode_nested_recv_index(Array::get(nested, 0))))
        let mut ni = 0
        while ni < Array::length(nested) {
          let at = Array::get(nested, ni)
          Array::push(nested_recvs, (formal, at, Array::get(sig_params, at)))
          ni = ni + 1
        }
      } else {
        throw("call the impl method at its concrete type (`<Type>::" + member + "(..)`), or give `" + display + "` a parameter of type `" + formal + "`: a call through the trait reads the `" + trait_ref_name(tr) + "` witness for the method's own type parameter `" + formal + "` from an argument, and no parameter carries it")
      }
      si = si + 1
    }
    let param_types: Array[Option[TypeExpr]] = []
    for t in sig_params {
      Array::push(param_types, Some(t))
    }
    match synth_dicts(formals, threaded, array_empty(), nested_recvs, param_types, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
      Some(dicts) => dicts,
      None => throw("annotate the argument `" + display + "` reads its own type parameter from (for example `let v: Int = ..`): a call through the trait needs that argument's type for the witness, and it is not available here")
    }
  }
}
