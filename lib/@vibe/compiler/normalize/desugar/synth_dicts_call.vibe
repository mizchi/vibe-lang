// The dictionaries a call to a generic passes, built for that call (#3825).

import @vibe/compiler/core {
  Expr, TypeExpr
}
import ./add32_rows.vibe {
  dtd_add32_enter
}
import ./models.vibe {
  DictGen
}
import ./witness_generation.vibe {
  synth_dicts
}

/// `synth_dicts` when the callee actually declares dict parameters, None when
/// it does not -- see gen_prepends_dicts. `call_off` is the callee's offset,
/// at which the checker files the row that makes an `Int32` / `UInt32`
/// instantiation's `Add` witness wrap (-1 when the call has none).
export fn synth_dicts_if(prepend: Bool, call_off: Int, callee_type_params: Array[String], threaded: Array[(String, String, Int)], constructor_recvs: Array[(String, Int)], nested_recvs: Array[(String, Int, TypeExpr)], param_types: Array[Option[TypeExpr]], args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[DictGen]) -> Option[Array[Expr]] with Exception {
  if prepend {
    dtd_add32_enter(call_off)
    let out = synth_dicts(callee_type_params = callee_type_params, threaded = threaded, constructor_recvs = constructor_recvs, nested_recvs = nested_recvs, param_types = param_types, orig_args = args, traits = traits, struct_sets = struct_sets, var_types = var_types, dict_binds = dict_binds, fn_returns = fn_returns, gens = gens)
    dtd_add32_enter(0 - 1)
    out
  } else {
    None
  }
}
