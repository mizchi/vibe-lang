}

import @vibe/ast {
  builtin_ref, impl_target_key
}

import @vibe/core {
  array_empty
}

import ./callable_names.vibe {
  impl_target_fn_key
}

import ./constructor_environments.vibe {
  extend_constructor_var_types
}

import ./equality_aliases.vibe {
  eq_expand_alias_ty
}

import ./lambda_return_shapes.vibe {
  dtd_interp_fn_lamret_key, dtd_interp_lamret_of
}

