// Generic dispatch.

import @vibe/compiler/lowering/trait_namespaces {
  lookup_trait_sigs
}

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import @vibe/ast {
  impl_method_owner, impl_target_head, trait_ref_from_key, trait_ref_key, trait_ref_name, type_param_name
}

import @vibe/core {
  array_empty
}

import ./models.vibe {
  DictGen, GenericImplInfo
}

import ./trait_bounds.vibe {
  already_threaded,
  dtd_trait_entails,
  empty_threaded,
  encode_array_elem_recv_index,
  encode_constructor_recv_index,
  find_array_elem_recv_index,
  find_constructor_recv_index,
  find_recv_index,
  generic_impl_target_is_total,
  impl_pattern_binding,
  impl_target_pattern_matches,
  impl_trait_pattern_matches,
  qualified_head,
  return_constructor_param,
  substitute_impl_bindings,
  trait_ref_mentions_param,
  type_expr_mentions_param
}

import ./utilities.vibe {
  empty_str_array, str_array_contains
}

import ./witness_targets.vibe {
  collect_constructor_recvs
}

export fn collect_impl_infos(stmts: Array[Stmt]) -> Array[GenericImplInfo] {
  let out = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, _, trait_name, target) => {
        let dispatch_target = match target {
          TyName(name) => if Array::length(tparams) > 0 {
            TyApp(name, for tparam in tparams {
              TyName(tparam)
            })
          } else {
            target
          },
          _ => target
        }
        Array::push(out, GenericImplInfo::{
          owner: impl_method_owner(tparams, trait_name, target),
          trait_name,
          type_params: tparams,
          target: dispatch_target
        })
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn generic_impl_info_for_owner(infos: Array[GenericImplInfo], owner: String) -> Option[GenericImplInfo] {
  let mut i = 0
  let mut result = None
  while i < Array::length(infos) {
    let info = Array::get(infos, i)
    if info.owner == owner {
      result = Some(info)
      i = Array::length(infos)
    } else {
      i = i + 1
    }
  }
  result
}

export fn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_infos: Array[GenericImplInfo]) -> Array[DictGen] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(tparams, bounds, params, ret, _, _) => if already_threaded(bounds, params) {
          ()
        } else {
          let impl_info = generic_impl_info_for_owner(gimpl_infos, qualified_head(fname))
          let is_impl_method = match impl_info {
            Some(_) => true,
            None => false
          }
          let constructor_recvs = collect_constructor_recvs(tparams, params, stmts)
          let threaded = empty_threaded()
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, bi)
            let tpname = type_param_name(tp)
            let mut ti = 0
            while ti < Array::length(trait_list) {
              let tr = Array::get(trait_list, ti)
              match lookup_trait_sigs(traits, tr) {
                Some(_) => {
                  let ridx = find_recv_index(params, tpname)
                  if ridx >= 0 {
                    Array::push(threaded, (tpname, tr, ridx))
                  } else if is_impl_method {
                    // bounded generic-impl method: T is nested in `self: C[T]`,
                    // so there is no inferable receiver argument — the witness
                    // dict is supplied when C's witness is built. Thread with -1.
                    Array::push(threaded, (tpname, tr, 0 - 1))
                  } else {
                    let cidx = find_constructor_recv_index(params, tpname, stmts)
                    if cidx >= 0 {
                      Array::push(threaded, (tpname, tr, encode_constructor_recv_index(cidx)))
                    } else {
                      // #1199 bug 1: T may still appear, just wrapped one level
                      // in an `Array[T]` param (`fn f[T: Hash](xs: Array[T])`)
                      // rather than bare `x: T` -- find_recv_index alone missed
                      // this, so f was silently left un-threaded: no dict param
                      // on its own signature, `no_binds` for its body (see
                      // rewrite_stmt's `lookup_gen` miss), and any Hash-bounded
                      // call inside f on a value pulled out of `xs` had no dict
                      // to forward, however it was written -- synth_dicts fails
                      // and the call site was emitted short its dict arg
                      // (invalid wasm), not merely "less generic than it could
                      // be" as the direct-receiver miss would read.
                      let widx = find_array_elem_recv_index(params, tpname)
                      if widx >= 0 {
                        Array::push(threaded, (tpname, tr, encode_array_elem_recv_index(widx)))
                      } else {
                        ()
                      }
                    }
                  }
                },
                None => ()
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if Array::length(threaded) > 0 || is_impl_method {
            let result_constructor = return_constructor_param(ret, threaded, stmts)
            match impl_info {
              Some(info) => Array::push(out, DictGen::{
                name: fname,
                type_params: tparams,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: info.trait_name,
                impl_params: info.type_params,
                impl_target: Some(info.target),
                constructor_recvs
              }),
              None => Array::push(out, DictGen::{
                name: fname,
                type_params: tparams,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: "",
                impl_params: [],
                impl_target: None,
                constructor_recvs
              })
            }
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn lookup_gen_entry(gens: Array[DictGen], name: String) -> Option[DictGen] {
  let mut i = Array::length(gens)
  let mut result = None
  while i > 0 && result is None {
    i = i - 1
    let gen = Array::get(gens, i)
    if gen.name == name {
      result = Some(gen)
    } else {
      ()
    }
  }
  result
}

export fn lookup_gen(gens: Array[DictGen], name: String) -> Option[Array[(String, String, Int)]] {
  match lookup_gen_entry(gens, name) {
    Some(gen) => Some(gen.threaded),
    None => None
  }
}

/// #2872: the witness for a SUPER-trait's method, supplied by a generic impl of
/// a SUB-trait.
///
/// `trait Child: Base` with `impl [T] Child for Array[T]` declaring both
/// `base_m` and `child_m` is a complete implementation of `Base` for
/// `Array[T]` -- `flatten_traits` copies the inherited sigs down, and the impl
/// block writes the bodies. But the dictionary for `Base` looked for a gen
/// whose `impl_trait` IS `Base`, found none, fell through to the plain
/// `Array::base_m` (which no impl generates), and left the dictionary with a
/// hole. Measured against a stage2 built from main at 3017a67 on
/// `fixtures/typecheck/trait_supertrait_bound_param_type.vibe`: `vibe check`
/// clean, and a module the wasm validator rejected
/// (`failed to compile: wasm[0]::function[5]::v`) because the call was emitted
/// one argument short. The typecheck lane asserted the CHECKER's verdict only,
/// so nothing saw it.
///
/// Counted, not taken on sight: two distinct sub-traits of the same super-trait
/// implemented for the same target would each carry a candidate, and picking
/// one of them is a guess. Ambiguity falls through to the caller, which refuses
/// with a message rather than emitting a short call.
export fn matching_generic_impl_method(gens: Array[DictGen], cname: String, trait_name: String, method: String, actual: TypeExpr) -> Option[String] {
  let mut i = 0
  let mut result = None
  let mut erased_result = None
  let mut erased_count = 0
  let mut super_result = None
  let mut super_count = 0
  while i < Array::length(gens) {
    let gen = Array::get(gens, i)
    let bindings = []
    if impl_target_head(match gen.impl_target {
      Some(target) => target,
      None => TyName("")
    }) == cname && String::ends_with(gen.name, String::concat("::", method)) {
      match gen.impl_target {
        Some(target) => if impl_target_pattern_matches(target, actual, gen.impl_params, bindings) && impl_trait_pattern_matches(gen.impl_trait, trait_name, gen.impl_params, bindings) {
          result = Some(gen.name)
          i = Array::length(gens)
        } else {
          let super_bindings = []
          if impl_target_pattern_matches(target, actual, gen.impl_params, super_bindings) && trait_ref_name(gen.impl_trait) != trait_ref_name(trait_name) && dtd_trait_entails(gen.impl_trait, trait_name) {
            super_result = Some(gen.name)
            super_count = super_count + 1
          } else {
            ()
          }
          match actual {
            TyName(actual_head) => if actual_head == cname && generic_impl_target_is_total(target, gen.impl_params) && impl_trait_pattern_matches(gen.impl_trait, trait_name, gen.impl_params, bindings) {
              erased_result = Some(gen.name)
              erased_count = erased_count + 1
            } else (),
            _ => ()
          }
          i = i + 1
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  match result {
    Some(_) => result,
    None => if erased_count == 1 {
      erased_result
    } else if super_count == 1 {
      super_result
    } else {
      None
    }
  }
}

fn instantiate_impl_trait(gen: DictGen, bindings: Array[(String, TypeExpr)]) -> Option[String] {
  match trait_ref_from_key(gen.impl_trait) {
    Some(reference) => {
      let instantiated = substitute_impl_bindings(reference, bindings)
      if type_expr_mentions_param(instantiated, gen.impl_params) {
        None
      } else {
        Some(trait_ref_key(instantiated))
      }
    },
    None => None
  }
}

/// Resolve a callee-generic applied bound (`C: Iterator[A]`) from the unique
/// generic impl selected by the concrete receiver (`Triple[Int]`). The checker
/// has already established the call's type relation; this recovery exists so
/// the syntax-only dictionary pass does not emit `Iterator[A]` after `A` has
/// been inferred. Multiple compatible impl families remain unresolved rather
/// than choosing one and silently dispatching to the wrong implementation.
export fn specialize_applied_trait_for_target(trait_name: String, callee_params: Array[String], actual_target: TypeExpr, gens: Array[DictGen]) -> String {
  if !trait_ref_mentions_param(trait_name, callee_params) {
    trait_name
  } else match trait_ref_from_key(trait_name) {
    None => trait_name,
    Some(requested) => {
      let candidates = empty_str_array()
      let mut i = 0
      while i < Array::length(gens) {
        let gen = Array::get(gens, i)
        match gen.impl_target {
          Some(target) => if trait_ref_name(gen.impl_trait) == trait_ref_name(trait_name) {
            let bindings = []
            let target_matches = if impl_target_pattern_matches(target, actual_target, gen.impl_params, bindings) {
              true
            } else match actual_target {
              TyName(actual_head) => actual_head == impl_target_head(target) && generic_impl_target_is_total(target, gen.impl_params),
              _ => false
            }
            if target_matches {
              match instantiate_impl_trait(gen, bindings) {
                Some(candidate) => match trait_ref_from_key(candidate) {
                  Some(candidate_ref) => {
                    let requested_bindings = []
                    if impl_target_pattern_matches(requested, candidate_ref, callee_params, requested_bindings) && !str_array_contains(candidates, candidate) {
                      Array::push(candidates, candidate)
                    } else {
                      ()
                    }
                  },
                  None => ()
                },
                None => ()
              }
            } else {
              ()
            }
          } else {
            ()
          },
          None => ()
        }
        i = i + 1
      }
      if Array::length(candidates) == 1 {
        Array::get(candidates, 0)
      } else {
        trait_name
      }
    }
  }
}

export fn generic_impl_bound_target(gens: Array[DictGen], method_name: String, type_param: String, actual: TypeExpr) -> Option[TypeExpr] {
  match lookup_gen_entry(gens, method_name) {
    Some(gen) => match gen.impl_target {
      Some(target) => {
        let bindings = []
        if impl_target_pattern_matches(target, actual, gen.impl_params, bindings) {
          impl_pattern_binding(bindings, type_param)
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}
