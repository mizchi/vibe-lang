export fn collect_impl_infos(_ stmts: Array[Stmt]) -> Array[GenericImplInfo] {
  let out = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, _, trait_name, target) => {
        let dispatch_target = match target {
          TyName(name) => if Array::length(tparams) > 0 {
            TyApp(name, for tparam in tparams {
              TyName(tparam)
            })
          } else {
            target
          },
          _ => target
        }
        Array::push(out, value = GenericImplInfo::{
          owner: impl_method_owner(tparams = tparams, trait_name = trait_name, target = target),
          trait_name,
          type_params: tparams,
          target: dispatch_target
        })
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

// Read the parser's marker/method sequence, as the checker does for impl
// provenance. Several scalar traits have the same owner (`Float`), so the
// first SImpl for that owner cannot identify Float::add or Float::to_string.
fn impl_info_for_binding(stmts: Array[Stmt], at: Int, owner: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], infos: Array[GenericImplInfo]) -> Option[GenericImplInfo] {
  if owner == "" {
    return None
  }
  let mut j = at - 1
  let mut active_trait = ""
  let mut done = false
  while j >= 0 && !done {
    match Array::get(stmts, at = j) {
      SImpl(tps, _, tr, target) => {
        if impl_method_owner(tparams = tps, trait_name = tr, target = target) == owner {
          active_trait = tr
        }
        done = true
      },
      SLet(_, _, name, _, _) => {
        let head = qualified_head(builtin_shadow_source_name(name))
        if head != owner && (lookup_trait_sigs(traits = traits, name = head) is None) {
          done = true
        }
      },
      _ => {
        done = true
      }
    }
    j = j - 1
  }
  let mut result = None
  let mut matches = 0
  for info in infos {
    if info.owner == owner && (active_trait == "" || info.trait_name == active_trait) {
      result = Some(info)
      matches = matches + 1
    }
  }
  if matches == 1 {
    result
  } else {
    None
  }
}

export fn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_infos: Array[GenericImplInfo]) -> Array[DictGen] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(tparams, bounds, params, ret, _, _) => if already_threaded(bounds = bounds, params = params) {
          ()
        } else {
          let impl_info = impl_info_for_binding(stmts = stmts, at = i, owner = qualified_head(builtin_shadow_source_name(fname)), traits = traits, infos = gimpl_infos)
          let is_impl_method = match impl_info {
            Some(_) => true,
            None => false
          }
          let constructor_recvs = collect_constructor_recvs(tparams = tparams, params = params, stmts = stmts)
          let threaded = empty_threaded()
          let nested_recvs: Array[(String, Int, TypeExpr)] = []
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, at = bi)
            let tpname = type_param_name(tp)
            let mut ti = 0
            while ti < Array::length(trait_list) {
              let tr = Array::get(trait_list, at = ti)
              match lookup_trait_sigs(traits = traits, name = tr) {
                Some(sigs) => {
                  let ridx = find_recv_index(params = params, tp = tpname)
                  if ridx >= 0 {
                    Array::push(threaded, value = (tpname, tr, ridx))
                  } else if is_impl_method {
                    // bounded generic-impl method: T is nested in `self: C[T]`,
                    // so there is no inferable receiver argument — the witness
                    // dict is supplied when C's witness is built. Thread with -1.
                    Array::push(threaded, value = (tpname, tr, 0 - 1))
                  } else {
                    let cidx = find_constructor_recv_index(params = params, tp = tpname, stmts = stmts)
                    if cidx >= 0 {
                      Array::push(threaded, value = (tpname, tr, encode_constructor_recv_index(cidx)))
                    } else {
                      // #1199 bug 1: T may still appear, just wrapped one level
                      // in an `Array[T]` param (`fn f[T: Hash](xs: Array[T])`)
                      // rather than bare `x: T` -- find_recv_index alone missed
                      // this, so f was silently left un-threaded: no dict param
                      // on its own signature, `no_binds` for its body (see
                      // rewrite_stmt's `lookup_gen` miss), and any Hash-bounded
                      // call inside f on a value pulled out of `xs` had no dict
                      // to forward, however it was written -- synth_dicts fails
                      // and the call site was emitted short its dict arg
                      // (invalid wasm), not merely "less generic than it could
                      // be" as the direct-receiver miss would read.
                      let widx = find_array_elem_recv_index(params = params, tp = tpname)
                      if widx >= 0 {
                        Array::push(threaded, value = (tpname, tr, encode_array_elem_recv_index(widx)))
                      } else {
                        // #3287: `T` only nested (`a: Option[T]`). A marker
                        // trait has no dictionary to pass, so it threads
                        // nothing, as before.
                        let nested = find_nested_recv_indices(params = params, tp = tpname)
                        if Array::length(nested) > 0 && Array::length(sigs) > 0 {
                          Array::push(threaded, value = (tpname, tr, encode_nested_recv_index(Array::get(nested, at = 0))))
                          for ni in nested {
                            match Array::get(params, at = ni).1 {
                              Some(ann) => Array::push(nested_recvs, value = (tpname, ni, ann)),
                              None => ()
                            }
                          }
                        } else {
                          ()
                        }
                      }
                    }
                  }
                },
                None => ()
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if Array::length(threaded) > 0 || is_impl_method {
            let result_constructor = return_constructor_param(ret = ret, threaded = threaded, stmts = stmts)
            match impl_info {
              Some(info) => Array::push(out, value = DictGen::{
                name: fname,
                type_params: tparams,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: info.trait_name,
                impl_params: info.type_params,
                impl_target: Some(info.target),
                constructor_recvs,
                nested_recvs,
                param_types: for p in params {
                  p.1
                }
              }),
              None => Array::push(out, value = DictGen::{
                name: fname,
                type_params: tparams,
                threaded,
                return_constructor_param: result_constructor,
                impl_trait: "",
                impl_params: [],
                impl_target: None,
                constructor_recvs,
                nested_recvs,
                param_types: for p in params {
                  p.1
                }
              })
            }
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn lookup_gen_entry(gens: Array[DictGen], name: String) -> Option[DictGen] {
  let mut i = Array::length(gens)
  let mut result = None
  while i > 0 && result is None {
    i = i - 1
    let gen = Array::get(gens, at = i)
    if gen.name == name {
      result = Some(gen)
    } else {
      ()
    }
  }
  result
}

export fn lookup_gen(gens: Array[DictGen], name: String) -> Option[Array[(String, String, Int)]] {
  match lookup_gen_entry(gens = gens, name = name) {
    Some(gen) => Some(gen.threaded),
    None => None
  }
}

/// #2872: the witness for a SUPER-trait's method, supplied by a generic impl of
/// a SUB-trait.
///
/// `trait Child: Base` with `impl [T] Child for Array[T]` declaring both
/// `base_m` and `child_m` is a complete implementation of `Base` for
/// `Array[T]` -- `flatten_traits` copies the inherited sigs down, and the impl
/// block writes the bodies. But the dictionary for `Base` looked for a gen
/// whose `impl_trait` IS `Base`, found none, fell through to the plain
/// `Array::base_m` (which no impl generates), and left the dictionary with a
/// hole. Measured against a stage2 built from main at 3017a67 on
/// `fixtures/typecheck/trait_supertrait_bound_param_type.vibe`: `vibe check`
/// clean, and a module the wasm validator rejected
/// (`failed to compile: wasm[0]::function[5]::v`) because the call was emitted
/// one argument short. The typecheck lane asserted the CHECKER's verdict only,
/// so nothing saw it.
///
/// Counted, not taken on sight: two distinct sub-traits of the same super-trait
/// implemented for the same target would each carry a candidate, and picking
/// one of them is a guess. Ambiguity falls through to the caller, which refuses
/// with a message rather than emitting a short call.
export fn matching_generic_impl_method(gens: Array[DictGen], cname: String, trait_name: String, method: String, actual: TypeExpr) -> Option[String] {
  let mut i = 0
  let mut result = None
  let mut erased_result = None
  let mut erased_count = 0
  let mut super_result = None
  let mut super_count = 0
  while i < Array::length(gens) {
    let gen = Array::get(gens, at = i)
    let bindings = []
    if impl_target_head(match gen.impl_target {
      Some(target) => target,
      None => TyName("")
    }) == cname && String::ends_with(builtin_shadow_source_name(gen.name), suffix = String::concat("::", method)) {
      match gen.impl_target {
        Some(target) => if impl_target_pattern_matches(pattern = target, actual = actual, params = gen.impl_params, bindings = bindings) && impl_trait_pattern_matches(template_key = gen.impl_trait, actual_key = trait_name, params = gen.impl_params, bindings = bindings) {
          result = Some(gen.name)
          i = Array::length(gens)
        } else {
          let super_bindings = []
          if impl_target_pattern_matches(pattern = target, actual = actual, params = gen.impl_params, bindings = super_bindings) && trait_ref_name(gen.impl_trait) != trait_ref_name(trait_name) && dtd_trait_entails(sub = gen.impl_trait, super_name = trait_name) {
            super_result = Some(gen.name)
            super_count = super_count + 1
          } else {
            ()
          }
          match actual {
            TyName(actual_head) => if actual_head == cname && generic_impl_target_is_total(target = target, params = gen.impl_params) && impl_trait_pattern_matches(template_key = gen.impl_trait, actual_key = trait_name, params = gen.impl_params, bindings = bindings) {
              erased_result = Some(gen.name)
              erased_count = erased_count + 1
            } else (),
            _ => ()
          }
          i = i + 1
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  match result {
    Some(_) => result,
    None => if erased_count == 1 {
      erased_result
    } else if super_count == 1 {
      super_result
    } else {
      None
    }
  }
}

fn instantiate_impl_trait(gen: DictGen, bindings: Array[(String, TypeExpr)]) -> Option[String] {
  match trait_ref_from_key(gen.impl_trait) {
    Some(reference) => {
      let instantiated = substitute_impl_bindings(ty = reference, bindings = bindings)
      if type_expr_mentions_param(ty = instantiated, params = gen.impl_params) {
        None
      } else {
        Some(trait_ref_key(instantiated))
      }
    },
    None => None
  }
}

/// Resolve a callee-generic applied bound (`C: Iterator[A]`) from the unique
/// generic impl selected by the concrete receiver (`Triple[Int]`). The checker
/// has already established the call's type relation; this recovery exists so
/// the syntax-only dictionary pass does not emit `Iterator[A]` after `A` has
/// been inferred. Multiple compatible impl families remain unresolved rather
/// than choosing one and silently dispatching to the wrong implementation.
export fn specialize_applied_trait_for_target(trait_name: String, callee_params: Array[String], actual_target: TypeExpr, gens: Array[DictGen]) -> String {
  let candidates = applied_trait_candidates(trait_name = trait_name, callee_params = callee_params, actual_target = actual_target, gens = gens)
  if Array::length(candidates) == 1 {
    Array::get(candidates, at = 0)
  } else {
    trait_name
  }
}

/// Every instantiation of the applied bound `trait_name` (which mentions the
/// callee's formals `callee_params`) that an impl for `actual_target` provides,
/// without duplicates. Empty when the bound mentions no callee formal.
export fn applied_trait_candidates(trait_name: String, callee_params: Array[String], actual_target: TypeExpr, gens: Array[DictGen]) -> Array[String] {
  let candidates = empty_str_array()
  if !trait_ref_mentions_param(trait_name = trait_name, params = callee_params) {
    candidates
  } else match trait_ref_from_key(trait_name) {
    None => candidates,
    Some(requested) => {
      let mut i = 0
      while i < Array::length(gens) {
        let gen = Array::get(gens, at = i)
        match gen.impl_target {
          Some(target) => if trait_ref_name(gen.impl_trait) == trait_ref_name(trait_name) {
            let bindings = []
            let target_matches = if impl_target_pattern_matches(pattern = target, actual = actual_target, params = gen.impl_params, bindings = bindings) {
              true
            } else match actual_target {
              TyName(actual_head) => actual_head == impl_target_head(target) && generic_impl_target_is_total(target = target, params = gen.impl_params),
              _ => false
            }
            if target_matches {
              match instantiate_impl_trait(gen = gen, bindings = bindings) {
                Some(candidate) => match trait_ref_from_key(candidate) {
                  Some(candidate_ref) => {
                    let requested_bindings = []
                    if impl_target_pattern_matches(pattern = requested, actual = candidate_ref, params = callee_params, bindings = requested_bindings) && !str_array_contains(arr = candidates, val = candidate) {
                      Array::push(candidates, value = candidate)
                    } else {
                      ()
                    }
                  },
                  None => ()
                },
                None => ()
              }
            } else {
              ()
            }
          } else {
            ()
          },
          None => ()
        }
        i = i + 1
      }
      candidates
    }
  }
}

/// #3616: the callee formals a call's own arguments fix, read by matching each
/// value parameter's annotation (`a: A`) against the argument's syntactic type
/// (`2` is an `Int`). An argument whose type is not readable contributes
/// nothing. Two arguments that disagree about a formal mean the reading is not
/// trustworthy, so the answer is then empty: narrowing on it could pick the
/// wrong impl, and an empty answer only leaves the call ambiguous.
export fn call_arg_formal_bindings(param_types: Array[Option[TypeExpr]], args: Array[Expr], callee_params: Array[String], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Array[(String, TypeExpr)] {
  let out: Array[(String, TypeExpr)] = []
  let mut conflict = false
  let mut i = 0
  while i < Array::length(param_types) && i < Array::length(args) && !conflict {
    match Array::get(param_types, at = i) {
      Some(ann) => if type_expr_mentions_param(ty = ann, params = callee_params) {
        match infer_impl_target_expr(arg = Array::get(args, at = i), struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
          Some(actual) => {
            let local: Array[(String, TypeExpr)] = []
            if impl_target_pattern_matches(pattern = ann, actual = actual, params = callee_params, bindings = local) {
              for binding in local {
                let (formal, ty) = binding
                match impl_pattern_binding(bindings = out, name = formal) {
                  Some(prior) => if impl_target_key(prior) != impl_target_key(ty) {
                    conflict = true
                  } else {
                    ()
                  },
                  None => Array::push(out, value = binding)
                }
              }
            } else {
              ()
            }
          },
          None => ()
        }
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  if conflict {
    []
  } else {
    out
  }
}

/// #3616: the candidates (from `applied_trait_candidates`) that remain once the
/// formals `bindings` fixes are substituted into the requested bound. With
/// `impl It[Int] for P` and `impl It[String] for P`, `It::pass(p, 2)` requests
/// `It[A]`, which both match; `A = Int` leaves only `It[Int]`.
export fn narrow_applied_trait_candidates(trait_name: String, callee_params: Array[String], candidates: Array[String], bindings: Array[(String, TypeExpr)]) -> Array[String] {
  match trait_ref_from_key(trait_name) {
    None => candidates,
    Some(requested) => {
      let narrowed_request = substitute_impl_bindings(ty = requested, bindings = bindings)
      let out = empty_str_array()
      for candidate in candidates {
        match trait_ref_from_key(candidate) {
          Some(candidate_ref) => {
            let scratch = []
            if impl_target_pattern_matches(pattern = narrowed_request, actual = candidate_ref, params = callee_params, bindings = scratch) {
              Array::push(out, value = candidate)
            } else {
              ()
            }
          },
          None => ()
        }
      }
      out
    }
  }
}

/// The type the witness method `method_name`'s threaded formal `type_param`
/// stands for when the trait dispatches it at `actual`. `sig_params` are the
/// trait method's declared value parameters.
///
/// #3569: the method's OWN annotations answer first. A bodyless impl's
/// fallback (`impl [T: Eq] Name for Tag[T]` with `fn Tag::name[U: Eq](self:
/// Tag[U])`) is an ordinary function: it carries no impl target, and its
/// formals need not be spelled, or ordered, like the impl's
/// (`fn Duo::same[B, A: Eq](self: Duo[B, A])` for `impl [A, B: Eq] .. for
/// Duo[A, B]`). Answering None here left the dictionary unbuilt and the call
/// through the trait one argument short, which the wasm validator rejected.
/// Every parameter the trait declares as `Self` carries `actual`, so matching
/// the method's annotation there against `actual` binds the method's own
/// formals. (Only parameters: a formal that only the result carries is not
/// threaded at all, and is refused where it is dispatched.) An impl method
/// with a body binds the impl's formals, and falls back to the impl target as
/// before.
export fn generic_impl_bound_target(gens: Array[DictGen], method_name: String, type_param: String, sig_params: Array[TypeExpr], actual: TypeExpr) -> Option[TypeExpr] {
  match lookup_gen_entry(gens = gens, name = method_name) {
    Some(gen) => match own_formal_target(gen = gen, type_param = type_param, sig_params = sig_params, actual = actual) {
      Some(found) => Some(found),
      None => match gen.impl_target {
        Some(target) => {
          let bindings = []
          if impl_target_pattern_matches(pattern = target, actual = actual, params = gen.impl_params, bindings = bindings) {
            impl_pattern_binding(bindings = bindings, name = type_param)
          } else {
            None
          }
        },
        None => None
      }
    },
    None => None
  }
}

fn is_self_type(_ t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "Self",
    _ => false
  }
}

/// `type_param`'s binding from matching a `Self`-position annotation of `gen`
/// against `actual`, with `gen`'s own formals as the pattern variables.
fn own_formal_target(gen: DictGen, type_param: String, sig_params: Array[TypeExpr], actual: TypeExpr) -> Option[TypeExpr] {
  let formals = for tp in gen.type_params {
    type_param_name(tp)
  }
  let anns: Array[TypeExpr] = []
  let mut i = 0
  while i < Array::length(sig_params) && i < Array::length(gen.param_types) {
    if is_self_type(Array::get(sig_params, at = i)) {
      match Array::get(gen.param_types, at = i) {
        Some(ann) => Array::push(anns, value = ann),
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  let mut out = None
  for ann in anns {
    if out is None {
      let bindings = []
      if impl_target_pattern_matches(pattern = ann, actual = actual, params = formals, bindings = bindings) {
        out = impl_pattern_binding(bindings = bindings, name = type_param)
      } else {
        ()
      }
    } else {
      ()
    }
  }
  out
}
