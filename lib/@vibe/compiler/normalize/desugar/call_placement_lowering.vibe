import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  call_placement_error,
  call_placement_get,
  call_placement_is_canonical,
  call_placement_is_pending,
  call_placement_mark_applied,
  call_placement_payload_valid,
  call_placement_refuse,
  expr_any_node
}

let cpl_require_checked: Array[Bool] = [false]

fn cpl_value(_ arg: Expr) -> Expr {
  match arg {
    ELabeledArg(_, _, value) => value,
    _ => arg
  }
}

// ADR-0120 D2: a declaration call's labels are in declared order and a call
// through a value is positional, so every placed argument keeps its written
// position relative to the others. A placement that would move one past
// another would evaluate them out of written order; refuse it rather than
// reorder silently.
fn cpl_in_written_order(_ slots: Array[Int]) -> Bool {
  let mut last = -1
  let mut ok = true
  for slot in slots {
    let source = slot / 2 - 1
    if source >= 0 {
      if source <= last {
        ok = false
      } else {
        last = source
      }
    } else {
      ()
    }
  }
  ok
}

fn cpl_call(callee: Expr, args: Array[Expr], offset: Int, cell: Array[Int]) -> Expr with Exception {
  if call_placement_is_canonical(cell) {
    let known = match call_placement_get(cell) {
      Some((_, mode, _)) => mode == 0,
      None => false
    }
    ECall(callee, if known {
      for arg in args {
        cpl_value(arg)
      }
    } else {
      args
    }, offset, cell)
  } else {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => {
        if written != Array::length(args) || !call_placement_payload_valid(written = written, mode = mode, slots = slots) || !cpl_in_written_order(slots) {
          // The cell holds a payload, not a refusal: mark it refused so the
          // message names this call instead of decoding the slots as one.
          call_placement_refuse(cell = cell, invalid = true)
          throw(call_placement_error(cell = cell, callee = callee, offset = offset))
        } else {
          ()
        }
        let placed: Array[Expr] = []
        for slot in slots {
          if slot == 0 {
            Array::push(placed, value = EIdent("None", -1))
          } else {
            let source = slot / 2 - 1
            let value = if mode == 0 {
              cpl_value(Array::get(args, at = source))
            } else {
              Array::get(args, at = source)
            }
            Array::push(placed, value = if slot % 2 == 1 {
              ECall(EIdent("Some", -1), [value], -1, [])
            } else {
              value
            })
          }
        }
        call_placement_mark_applied(cell)
        ECall(callee, placed, offset, cell)
      },
      None => {
        let mut labeled = false
        for arg in args {
          match arg {
            ELabeledArg(_, _, _) => labeled = true,
            _ => ()
          }
        }
        if call_placement_is_pending(cell) || (labeled && Array::get(cpl_require_checked, at = 0)) {
          throw(call_placement_error(cell = cell, callee = callee, offset = offset))
        } else {
          ECall(callee, args, offset, cell)
        }
      }
    }
  }
}

fn cpl_exprs(_ items: Array[Expr]) -> Array[Expr] with Exception {
  for item in items {
    cpl_expr(item)
  }
}
fn cpl_fields(_ items: Array[(String, Expr)]) -> Array[(String, Expr)] with Exception {
  for item in items {
    (item.0, cpl_expr(item.1))
  }
}
fn cpl_arms(_ items: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] with Exception {
  for item in items {
    (item.0, cpl_expr(item.1))
  }
}
fn cpl_opt(_ item: Option[Expr]) -> Option[Expr] with Exception {
  match item {
    Some(expr) => Some(cpl_expr(expr)),
    None => None
  }
}

fn cpl_expr(_ expr: Expr) -> Expr with Exception {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EIdent(_, _) => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(cpl_exprs(items)),
    EArray(items) => EArray(cpl_exprs(items)),
    ERecord(n, fields, tys) => ERecord(n, cpl_fields(fields), tys),
    EMap(fields) => EMap(cpl_fields(fields)),
    EIf(c, t, f) => EIf(cpl_expr(c), cpl_expr(t), cpl_expr(f)),
    ELet(n, v, b, off) => ELet(n, cpl_expr(v), cpl_expr(b), off),
    ELetRec(n, v, b) => ELetRec(n, cpl_expr(v), cpl_expr(b)),
    ELetMut(n, v, b, off) => ELetMut(n, cpl_expr(v), cpl_expr(b), off),
    EAssign(n, v, b, target_off) => EAssign(n, cpl_expr(v), cpl_expr(b), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, cpl_expr(v), cpl_expr(b), target_off),
    ESeq(a, b) => ESeq(cpl_expr(a), cpl_expr(b)),
    EMatch(s, arms) => EMatch(cpl_expr(s), cpl_arms(arms)),
    EHandle(s, arms) => EHandle(cpl_expr(s), cpl_arms(arms)),
    EWhile(c, b) => EWhile(cpl_expr(c), cpl_expr(b)),
    ELoop(params, b) => ELoop(cpl_fields(params), cpl_expr(b)),
    EForIn(v, k, it, b) => EForIn(v, k, cpl_expr(it), cpl_expr(b)),
    ECall(callee, args, off, callee_resolution) => cpl_call(callee = cpl_expr(callee), args = cpl_exprs(args), offset = off, cell = callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, cpl_expr(l), cpl_expr(r), boff),
    EUnaryOp(op, v) => EUnaryOp(op, cpl_expr(v)),
    EFn(g, bs, ps, ret, row, body) => EFn(g, bs, ps, ret, row, cpl_expr(body)),
    EDot(inner, f, off, foff) => EDot(cpl_expr(inner), f, off, foff),
    ELabeledArg(l, sfx, v) => ELabeledArg(l, sfx, cpl_expr(v)),
    EReturn(v) => EReturn(cpl_expr(v)),
    EBreak(opt) => EBreak(cpl_opt(opt)),
    EContinue(args) => EContinue(cpl_exprs(args)),
    ESpread(v) => ESpread(cpl_expr(v))
  }
}

fn cpl_here(_ expr: Expr) -> Bool {
  match expr {
    ECall(_, _, _, cell) => call_placement_is_pending(cell),
    ELabeledArg(_, _, _) => true,
    _ => false
  }
}

fn cpl_body(_ expr: Expr) -> Expr with Exception {
  if expr_any_node(expr = expr, pred = cpl_here) {
    cpl_expr(expr)
  } else {
    expr
  }
}

fn cpl_stmt(_ stmt: Stmt) -> Stmt with Exception {
  match stmt {
    SLet(ex, is_rec, name, ty, body) => SLet(ex, is_rec, name, ty, cpl_body(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, cpl_body(body)),
    SLetPat(pat, body) => SLetPat(pat, cpl_body(body)),
    STest(name, body) => STest(name, cpl_body(body)),
    SBench(name, body) => SBench(name, cpl_body(body)),
    SExample(name, body) => SExample(name, cpl_body(body)),
    SExpr(body) => SExpr(cpl_body(body)),
    SFnDecl(ex, name, body, requires, ensures) => SFnDecl(ex, name, cpl_body(body), cpl_exprs(requires), cpl_exprs(ensures)),
    SModule(ex, name, children) => SModule(ex, name, for child in children {
      cpl_stmt(child)
    }),
    _ => stmt
  }
}

/// Construct call arguments from checker-owned source indices. No binding or
/// parameter-name lookup occurs here. Strict lanes refuse unchecked labels.
export fn lower_checked_call_placements(stmts: Array[Stmt], require_checked: Bool) -> Unit with Exception {
  Array::set(cpl_require_checked, at = 0, value = require_checked)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, at = i, value = cpl_stmt(Array::get(stmts, at = i)))
    i = i + 1
  }
}
