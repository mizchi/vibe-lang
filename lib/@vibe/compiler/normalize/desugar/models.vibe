// Models.

import @vibe/compiler/core {
  TypeExpr
}

import ./trait_bounds.vibe {
  return_constructor_param
}

export struct GenericImplInfo {
  owner: String;
  trait_name: String;
  type_params: Array[String];
  target: TypeExpr
}

export struct DictGen {
  name: String;
  type_params: Array[String];
  threaded: Array[(String, String, Int)];
  return_constructor_param: String;
  impl_trait: String;
  impl_params: Array[String];
  impl_target: Option[TypeExpr];
  constructor_recvs: Array[(String, Int)];
  // #3287: (formal, parameter index, annotation) for every parameter that
  // carries the formal nested (`Option[T]`, `(T, Int)`), read at call sites.
  nested_recvs: Array[(String, Int, TypeExpr)]
}

/// Whole-program facts a per-module `desugar_trait_dicts_module` cannot derive
/// from its own partition (#2647 Codex rounds 6-7).
///
///   `wrapper_names`   trivial identity wrappers (`apply(f) { f() }`). The
///                     whole-program pass rewrites `apply(inner)` to `inner()`,
///                     which `dtd_run` documents as the required workaround for
///                     a closure crash path. `dtpw_collect_wrappers` scans only
///                     the module's OWN bodies, and the dependency context is
///                     bodyless by construction, so a caller partition would
///                     leave the wrapper call intact and reach the crash.
///   `explicit_ops`    `T::equals` / `T::to_string` / … a module DOWNSTREAM of
///                     the type's owner defines explicitly. The owner sees
///                     neither the definition nor the dependent, derives a
///                     default, and the link reports a collision against a
///                     program the whole-program lane accepts.
export struct ModuleTraitFacts {
  wrapper_names: Array[String];
  explicit_ops: Array[String]
}
