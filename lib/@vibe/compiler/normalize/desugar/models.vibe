// Models.

import @vibe/compiler/core {
  TypeExpr
}

import ./trait_bounds.vibe {
  return_constructor_param
}

export struct GenericImplInfo {
  owner: String;
  trait_name: String;
  type_params: Array[String];
  target: TypeExpr
}

export struct DictGen {
  name: String;
  type_params: Array[String];
  threaded: Array[(String, String, Int)];
  return_constructor_param: String;
  impl_trait: String;
  impl_params: Array[String];
  impl_target: Option[TypeExpr];
  constructor_recvs: Array[(String, Int)];
  // #3287: (formal, parameter index, annotation) for every parameter that
  // carries the formal nested (`Option[T]`, `(T, Int)`), read at call sites.
  nested_recvs: Array[(String, Int, TypeExpr)];
  // #3569: each value parameter's annotation, positionally. A bodyless impl's
  // fallback (`fn Tag::name[U: Eq](self: Tag[U])`) names its formals
  // independently of the impl, so its witness reads them off these rather
  // than off the impl's target pattern.
  param_types: Array[Option[TypeExpr]]
}

/// Whole-program facts a per-module `desugar_trait_dicts_module` cannot derive
/// from its own partition (#2647 Codex rounds 6-7).
///
///   `wrapper_names`   trivial identity wrappers (`apply(f) { f() }`). The
///                     whole-program pass rewrites `apply(inner)` to `inner()`,
///                     which `dtd_run` documents as the required workaround for
///                     a closure crash path. `dtpw_collect_wrappers` scans only
///                     the module's OWN bodies, and the dependency context is
///                     bodyless by construction, so a caller partition would
///                     leave the wrapper call intact and reach the crash.
///   `explicit_ops`    `T::equals` / `T::to_string` / … a module DOWNSTREAM of
///                     the type's owner defines explicitly. The owner sees
///                     neither the definition nor the dependent, derives a
///                     default, and the link reports a collision against a
///                     program the whole-program lane accepts.
export struct ModuleTraitFacts {
  wrapper_names: Array[String];
  explicit_ops: Array[String]
}

/// #2826: the trait-dict refusals one or more modules of a program filed,
/// for a driver that lowers each module elsewhere -- in a worker instance, or
/// behind a module executor -- and reports once for the program
/// (`desugar_module_reports_take` / `_merge`). The order is the order the
/// runs filed them; the 32-bit `Add` rows carry whether some run consumed
/// each.
export struct DesugarModuleReports {
  eq: Array[String];
  show: Array[String];
  index: Array[String];
  add32_offs: Array[Int];
  add32_types: Array[String];
  add32_used: Array[Bool]
}

/// #3976: the checker's typed rows, sorted by kind into the tables the
/// trait-dict pass reads (`desugar_typed_rows`). The sort reads the rows and
/// nothing else, so a driver that lowers every module of one program against
/// the same rows sorts them once and hands the result to each module's run.
///
/// The `==` / render / index / `for in` tables are installed into the pass's
/// lookup tables at the start of each run; the other rows are passed to the
/// rewrite that consumes them. Each run receives copies, so nothing a run
/// does to them reaches the next.
export struct DtdTypedRows {
  eq_offs: Array[Int];
  eq_keys: Array[String];
  render_offs: Array[Int];
  render_keys: Array[String];
  index_offs: Array[Int];
  index_verdicts: Array[String];
  forin_offs: Array[Int];
  forin_verdicts: Array[String];
  add32_offs: Array[Int];
  add32_types: Array[String];
  f32_binop: Array[Int];
  f32_assign: Array[Int];
  f32_negation: Array[Int];
  fop_binop: Array[Int];
  fop_assign: Array[Int];
  fop_negation: Array[Int];
  i32_binop: Array[Int];
  u32_binop: Array[Int];
  i32_assign: Array[Int];
  u32_assign: Array[Int];
  i32_neg: Array[Int];
  u32_not: Array[Int];
  scalar_local: Array[Int];
  map_scalar: Array[Int];
  method_offs: Array[Int];
  method_heads: Array[String]
}
