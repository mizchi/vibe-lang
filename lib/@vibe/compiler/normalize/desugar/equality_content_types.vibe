/// #3074: the `derive (Show)` generic enum declaring constructor `fname`
/// (bare `GA` or qualified `G::GA`), with that variant's payload types.
export fn show_generic_enum_ctor(fname: String) -> Option[(String, Array[String], Array[TypeExpr])] {
  let mut found: Option[(String, Array[String], Array[TypeExpr])] = None
  let mut i = 0
  while i < Array::length(dtd_show_generic_enums) {
    let (ename, formals, variants) = Array::get(dtd_show_generic_enums, i)
    let mut vi = 0
    while vi < Array::length(variants) {
      let (vname, ptys) = Array::get(variants, vi)
      if fname == vname || fname == qualified_name(ename, vname) {
        found = Some((ename, formals, ptys))
        vi = Array::length(variants)
        i = Array::length(dtd_show_generic_enums)
      } else {
        vi = vi + 1
      }
    }
    i = i + 1
  }
  found
}

/// #3074: is `arg` a payload-free constructor of a `derive (Show)` generic
/// enum? Its erased rendering is its name, which is exact at any
/// instantiation, so it needs no type arguments.
export fn show_generic_enum_nullary(arg: Expr) -> Bool {
  match arg {
    EIdent(n, _) => match show_generic_enum_ctor(n) {
      Some((_, _, ptys)) => Array::length(ptys) == 0,
      None => false
    },
    _ => false
  }
}

/// Record an explicit `<ename>::equals` and, when it is monomorphic, takes
/// two parameters annotated with one instantiation and returns `Bool`, that
/// instantiation.
fn eq_record_explicit_equals(stmts: Array[Stmt], ename: String) -> Unit {
  let fname = qualified_name(ename, "equals")
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => if name == fname {
        Array::push(dtd_eq_explicit_equals, ename)
        match value {
          EFn(tps, _, params, ret_ty, eff, _) => if Array::length(tps) == 0 && Array::length(params) == 2 && eq_effect_row_is_empty(eff) {
            match eq_explicit_equals_signature_ty(Array::get(params, 0).1, Array::get(params, 1).1, ret_ty) {
              Some(t) => Array::push(dtd_eq_explicit_equals_param, (ename, t)),
              None => ()
            }
          } else {
            ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// A `Result` / `Option` head admitted by the allow-list as an ENUM: the
/// special arm's exact shape (see `dtd_eq_nonstandard_builtin_enums`), or a
/// nonstandard shape that is an ordinary generic enum and is decided like
/// every other one (no payload typed by a formal). A struct-owned spelling
/// is not admitted here at all -- it is a generic struct and the declared
/// branch of the predicate decides it.
fn eq_nonstandard_enum_admitted(head: String, args: Array[TypeExpr]) -> Bool {
  if eq_builtin_head_owned_by_nonenum(head) {
    false
  } else {
    eq_builtin_enum_arm_applies(head) || eq_generic_enum_instantiation_content_comparable(head, args, empty_str_array())
  }
}

export fn eq_known_types_reset(stmts: Array[Stmt]) -> Unit {
  Array::truncate(dtd_eq_known_types, 0)
  Array::truncate(dtd_eq_generic_types, 0)
  Array::truncate(dtd_eq_unsafe_types, 0)
  Array::truncate(dtd_eq_generic_structs, 0)
  Array::truncate(dtd_show_generic_structs, 0)
  Array::truncate(dtd_show_generic_enums, 0)
  Array::truncate(dtd_struct_field_decls, 0)
  Array::truncate(dtd_show_generic_enum_stack, 0)
  Array::truncate(dtd_show_inline_stack, 0)
  Array::truncate(dtd_show_inline_arr_elems, 0)
  Array::truncate(dtd_show_refusals, 0)
  Array::truncate(dtd_eq_derived_generic, 0)
  Array::truncate(dtd_eq_enum_decls, 0)
  Array::truncate(dtd_eq_enum_payload_check_stack, 0)
  Array::truncate(dtd_eq_enum_formal_visit_stack, 0)
  Array::truncate(dtd_eq_explicit_equals, 0)
  Array::truncate(dtd_eq_explicit_equals_param, 0)
  Array::truncate(dtd_eq_type_aliases, 0)
  Array::truncate(dtd_eq_type_owners, 0)
  Array::truncate(dtd_eq_refusals, 0)
  Array::truncate(dtd_eq_nonstandard_builtin_enums, 0)
  Array::truncate(dtd_eq_nonenum_builtin_heads, 0)
  Array::truncate(dtd_eq_specializations, 0)
  Array::truncate(dtd_eq_specialization_ancestries, 0)
  Array::truncate(dtd_eq_specialization_stack, 0)
  let names = collect_decl_type_names(stmts)
  let mut i = 0
  while i < Array::length(names) {
    Array::push(dtd_eq_known_types, Array::get(names, i))
    i = i + 1
  }
  // Codex round 14 on #2456: an explicit comparator's signature is validated
  // through `eq_expand_alias_ty`, so the enums are collected here and their
  // comparators recorded only AFTER this scan has entered every alias --
  // `-> Truth` with `type Truth = Bool` declared below the enum used to be
  // validated against a half-filled alias table and fail closed.
  let enum_names = empty_str_array()
  let mut j = 0
  while j < Array::length(stmts) {
    match Array::get(stmts, j) {
      SStruct(_, sname, fields, derives, _, decl_tparams) => {
        Array::push(dtd_eq_type_owners, sname)
        Array::push(dtd_struct_field_decls, (sname, decl_tparams, fields))
        if Array::length(decl_tparams) > 0 {
          Array::push(dtd_eq_generic_types, sname)
          Array::push(dtd_eq_generic_structs, (sname, decl_tparams, fields))
          if str_array_contains(derives, "Show") {
            Array::push(dtd_show_generic_structs, (sname, decl_tparams, fields))
          } else {
            ()
          }
          if str_array_contains(derives, "Eq") {
            Array::push(dtd_eq_derived_generic, sname)
          } else {
            ()
          }
        } else {
          ()
        }
        if sname == "Result" || sname == "Option" {
          Array::push(dtd_eq_nonenum_builtin_heads, sname)
        } else {
          ()
        }
      },
      SEnum(_, ename, decl_tparams, variants, enum_derives) => {
        Array::push(dtd_eq_type_owners, ename)
        Array::push(dtd_eq_enum_decls, (ename, decl_tparams, variants))
        Array::push(enum_names, ename)
        if Array::length(decl_tparams) > 0 {
          Array::push(dtd_eq_generic_types, ename)
          if str_array_contains(enum_derives, "Eq") {
            Array::push(dtd_eq_derived_generic, ename)
          } else {
            ()
          }
          if str_array_contains(enum_derives, "Show") && ename != "Option" && ename != "Result" {
            Array::push(dtd_show_generic_enums, (ename, decl_tparams, variants))
          } else {
            ()
          }
        } else {
          ()
        }
        // The special arm's shape, payload by payload against THIS
        // declaration's own formals (see eq_enum_shape_is).
        let standard = if ename == "Result" {
          Array::length(decl_tparams) == 2 && eq_enum_shape_is(variants, [
            ("Ok", [Array::get(decl_tparams, 0)]),
            ("Err", [Array::get(decl_tparams, 1)])
          ])
        } else if ename == "Option" {
          Array::length(decl_tparams) == 1 && eq_enum_shape_is(variants, [
            ("Some", [Array::get(decl_tparams, 0)]),
            ("None", [])
          ])
        } else {
          true
        }
        if !standard {
          Array::push(dtd_eq_nonstandard_builtin_enums, ename)
        } else {
          ()
        }
      },
      SSuberror(_, name, _) => Array::push(dtd_eq_type_owners, name),
      STypeAlias(_, aname, alias_tparams, target) => {
        Array::push(dtd_eq_type_owners, aname)
        Array::push(dtd_eq_type_aliases, (aname, alias_tparams, target))
        if aname == "Result" || aname == "Option" {
          Array::push(dtd_eq_nonenum_builtin_heads, aname)
        } else {
          ()
        }
      },
      SEffectDef(_, name, _, _) => Array::push(dtd_eq_type_owners, name),
      _ => ()
    }
    j = j + 1
  }
  let mut ei = 0
  while ei < Array::length(enum_names) {
    eq_record_explicit_equals(stmts, Array::get(enum_names, ei))
    ei = ei + 1
  }
  eq_unsafe_types_fill(stmts)
}

/// Least fixpoint of "this declared name has a field this pass cannot show is
/// compared by content". One pass can only see the names
/// already marked, so `struct Deep { o: Outer }` needs a second one; the loop
/// runs until a pass adds nothing, bounded by the number of declarations
/// because each pass that changes anything adds at least one name.
fn eq_unsafe_types_fill(stmts: Array[Stmt]) -> Unit {
  let mut rounds = 0
  let mut changed = true
  while changed && rounds <= Array::length(stmts) {
    changed = false
    let mut j = 0
    while j < Array::length(stmts) {
      match Array::get(stmts, j) {
        SStruct(_, sname, fields, _, _, decl_tparams) => if !str_array_contains(dtd_eq_unsafe_types, sname) {
          let mut fi = 0
          let mut bad = false
          while fi < Array::length(fields) {
            if !eq_ty_field_is_content_comparable(Array::get(fields, fi).1, decl_tparams) {
              bad = true
            } else {
              ()
            }
            fi = fi + 1
          }
          if bad {
            Array::push(dtd_eq_unsafe_types, sname)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        SEnum(_, ename, enum_tparams, variants, _) => if !str_array_contains(dtd_eq_unsafe_types, ename) {
          let mut vi = 0
          let mut bad = false
          while vi < Array::length(variants) {
            let payload = Array::get(variants, vi).1
            let mut pi = 0
            while pi < Array::length(payload) {
              if !eq_ty_field_is_content_comparable(Array::get(payload, pi), enum_tparams) {
                bad = true
              } else {
                ()
              }
              pi = pi + 1
            }
            vi = vi + 1
          }
          if bad {
            Array::push(dtd_eq_unsafe_types, ename)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        STypeAlias(_, aname, alias_tparams, target) => if !str_array_contains(dtd_eq_unsafe_types, aname) {
          if !eq_ty_field_is_content_comparable(target, alias_tparams) {
            Array::push(dtd_eq_unsafe_types, aname)
            changed = true
          } else {
            ()
          }
        } else {
          ()
        },
        _ => ()
      }
      j = j + 1
    }
    rounds = rounds + 1
  }
}

export fn eq_ty_field_is_content_comparable(t: TypeExpr, tparams: Array[String]) -> Bool {
  // A field written as the owner's own parameter is not the same-spelled
  // alias, even when one exists in the program (#2281).
  match t {
    TyName(n) => if eq_tparams_contain_name(tparams, n) {
      true
    } else {
      eq_ty_field_is_content_comparable_expanded(eq_expand_alias_ty(t), tparams)
    },
    _ => eq_ty_field_is_content_comparable_expanded(eq_expand_alias_ty(t), tparams)
  }
}

fn eq_ty_field_is_content_comparable_expanded(t: TypeExpr, tparams: Array[String]) -> Bool {
  match t {
    TyName(n) => if eq_tparams_contain_name(tparams, n) {
      // The owner's own type parameter is resolved by the concrete specialized
      // comparator, so it is not a declaration-level failure.
      true
    } else if str_array_contains(dtd_eq_generic_types, n) || str_array_contains(dtd_eq_unsafe_types, n) {
      // A bare generic name says nothing about its arguments.
      false
    } else if str_array_contains(dtd_eq_type_owners, n) {
      // Codex round 17 on #2456: a source declaration owns this spelling,
      // scalar-looking or not (`struct Int { value: String }`). It is
      // content-comparable exactly when it is a declared struct / enum the
      // unsafe walk above admitted; an alias or an effect wearing a scalar
      // name has no comparator and fails closed. `eq_for_typed` dispatches
      // the same name to its declared comparator, never the scalar arm.
      str_array_contains(dtd_eq_known_types, n)
    } else {
      is_scalar_type_name(n) || str_array_contains(dtd_eq_known_types, n)
    },
    TyApp(head, args) => if str_array_contains(dtd_eq_unsafe_types, head) {
      false
    } else {
      let args_ok = eq_tys_all_content_comparable(args, tparams)
      // Codex round 2 on #2456: a source declaration owns the `Map` spelling
      // (`dtd_eq_type_owners`, the rule `builtin_string_map_applied` already
      // applies). A program-declared `Map[K, V]` is a generic struct and takes
      // the declared branch below, never the builtin arm -- `eq_for_typed`
      // makes the same decision, so this predicate and that dispatch agree.
      // `Option` / `Result` are gated on the declared constructor SHAPE, not
      // on ownership: their `eq_for_typed` arms are constructor matches over
      // `Some`/`None` and `Ok`/`Err` that hold for a declared enum of that
      // shape (`Result` is always declared, #1324; its aggregate payloads
      // compare structurally through that arm, #825). A declaration of
      // another shape is an ordinary generic enum and is decided like every
      // other one (Codex rounds 3-7; see eq_for_typed_nonstandard_enum).
      // Codex round 15 on #2456: a source-owned `Option` / `Result` of another
      // shape is decided in the generic-enum branch below, which reads only
      // the positions the derived comparator observes -- `enum Option[T] {
      // Mark(Int); Empty }` applied to an opaque argument trapped here on
      // `args_ok` while the same-shaped `enum Marker[T]` answered.
      let shadowed_nonstandard = str_array_contains(dtd_eq_nonstandard_builtin_enums, head)
      let builtin_head = head == "Array" && Array::length(args) == 1 || head == "Option" && Array::length(args) == 1 && !shadowed_nonstandard && eq_nonstandard_enum_admitted(head, args) || head == "Result" && Array::length(args) == 2 && !shadowed_nonstandard && eq_nonstandard_enum_admitted(head, args) || head == "Map" && Array::length(args) == 2 && !str_array_contains(dtd_eq_type_owners, head)
      if eq_tparams_contain_name(tparams, head) {
        args_ok
      } else if builtin_head || builtin_string_map_applied(head, args) {
        // The heads `eq_for_typed` has a structural arm for. The arity is part
        // of the condition: a head applied to the wrong number of arguments is
        // not the builtin this admits.
        args_ok
      } else if str_array_contains(dtd_eq_known_types, head) && !str_array_contains(dtd_eq_generic_types, head) {
        args_ok
      } else if eq_generic_enum_declared(head) {
        // #2467: a generic ENUM is decided per instantiation, the way
        // `eq_for_typed_nonstandard_enum` dispatches it -- the arguments
        // substituted into every payload, each payload then held to this
        // same allow-list.
        eq_generic_enum_instantiation_content_comparable(head, args, tparams)
      } else {
        // Concrete declared generic instantiations get a comparator specialized
        // with these arguments. Unknown heads (Map included) remain fail-closed.
        generic_eq_struct_declared(head) && generic_eq_observed_args_content_comparable(head, args, tparams)
      }
    },
    TyTuple(ts) => eq_tys_all_content_comparable(ts, tparams),
    // `()` and `Unit` name the same type and must answer the same. They do not
    // arrive the same way: `u: Unit` is a `TyName` the arm above already
    // admits, `u: ()` is `TyUnit`, and while it fell to a catch-all the second
    // spelling trapped where the first answered (#2192 review, measured -- the
    // annotated `Array[U]` answers `true` for both).
    TyUnit => true,
    // A closure field is compared by identity, which is the only equality a
    // function has. Rejecting it costs a trap on a shape nobody writes; the
    // alternative is adopting a name whose `::equals` answers by reference,
    // and the caller cannot tell the two apart from the outside.
    TyFn(_, _, _) => false
  }
}

fn generic_eq_observed_args_content_comparable(head: String, args: Array[TypeExpr], tparams: Array[String]) -> Bool {
  let mut ok = false
  let mut i = 0
  while i < Array::length(dtd_eq_generic_structs) {
    let decl = Array::get(dtd_eq_generic_structs, i)
    if decl.0 == head && Array::length(decl.1) == Array::length(args) {
      ok = true
      let mut ai = 0
      while ai < Array::length(args) {
        if generic_eq_formal_is_observed(head, Array::get(decl.1, ai), empty_str_array()) && !eq_ty_field_is_content_comparable(Array::get(args, ai), tparams) {
          ok = false
        } else {
          ()
        }
        ai = ai + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn eq_tys_all_content_comparable(ts: Array[TypeExpr], tparams: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(ts) {
    if !eq_ty_field_is_content_comparable(Array::get(ts, i), tparams) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

export fn eq_generic_enum_payloads_concrete_comparable(name: String) -> Bool {
  if str_array_contains(dtd_eq_enum_payload_check_stack, name) {
    // Codex round 18 on #2456: an enum met again inside its own payload walk
    // (`Next(Loop[T])`) is compared by the comparator under examination, so
    // the recursive occurrence is as good as that comparator's other payloads
    // -- which this walk still checks. Answering `false` here made every
    // recursive generic enum fail closed, phantom formal or not.
    true
  } else {
    Array::push(dtd_eq_enum_payload_check_stack, name)
    let mut found = false
    let mut ok = true
    let mut i = 0
    while i < Array::length(dtd_eq_enum_decls) {
      let decl = Array::get(dtd_eq_enum_decls, i)
      if decl.0 == name {
        found = true
        let mut vi = 0
        while vi < Array::length(decl.2) {
          let payload = Array::get(decl.2, vi).1
          let mut pi = 0
          while pi < Array::length(payload) {
            // Rename the declaration's formals to sentinels FIRST, then expand
            // aliases (Codex round 9): an alias that ignores its argument
            // erases the formal, one that uses it keeps the sentinel.
            let pty = eq_expand_alias_ty(eq_ty_rename_formals(Array::get(payload, pi), decl.1))
            let sentinels = for f in decl.1 {
              eq_formal_sentinel(f)
            }
            if eq_ty_mentions_formal(pty, sentinels) || !eq_ty_field_is_content_comparable(pty, empty_str_array()) {
              ok = false
            } else {
              ()
            }
            pi = pi + 1
          }
          vi = vi + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
    Array::truncate(dtd_eq_enum_payload_check_stack, Array::length(dtd_eq_enum_payload_check_stack) - 1)
    found && ok
  }
}

/// #2467: is this INSTANTIATION of a declared generic enum compared by
/// content? Mirrors `eq_for_typed_nonstandard_enum` decision for decision: a
/// program's own `::equals` counts for exactly the instantiation it names;
/// an argument that is a formal of an enclosing binder leaves only the
/// declaration-level answer (a phantom parameter's payloads never read it);
/// otherwise the arguments are substituted into every payload -- before
/// alias expansion, so a formal shadowing a declared spelling is never read
/// as that declaration (round 8) -- and each payload is held to the field
/// allow-list. An instantiation met again inside its own payload walk
/// (`enum Loop[T] { End(Int); Next(Loop[T]) }` at `Int`) is compared by the
/// specialized comparator under examination, whose other payloads this walk
/// still checks (round 18's coinductive answer).
fn eq_generic_enum_instantiation_content_comparable(head: String, args: Array[TypeExpr], tparams: Array[String]) -> Bool {
  if eq_has_explicit_equals(head) {
    eq_explicit_equals_matches(head, args)
  } else if eq_ty_has_formal(TyApp(head, args)) {
    eq_generic_enum_payloads_concrete_comparable(head)
  } else {
    let verdict = eq_enum_inst_stack_verdict(head, args)
    if verdict == 1 {
      true
    } else if verdict < 0 {
      false
    } else {
      Array::push(dtd_eq_enum_inst_check_stack, TyApp(head, args))
      let mut found = false
      let mut ok = true
      let mut i = 0
      while i < Array::length(dtd_eq_enum_decls) {
        let decl = Array::get(dtd_eq_enum_decls, i)
        if decl.0 == head && Array::length(decl.1) == Array::length(args) && Array::length(decl.1) > 0 {
          found = true
          let mut vi = 0
          while vi < Array::length(decl.2) {
            let payload = Array::get(decl.2, vi).1
            let mut pi = 0
            while pi < Array::length(payload) {
              let pty = eq_expand_alias_ty(eq_subst_ty(Array::get(payload, pi), decl.1, args))
              if !eq_ty_field_is_content_comparable(pty, tparams) {
                ok = false
              } else {
                ()
              }
              pi = pi + 1
            }
            vi = vi + 1
          }
        } else {
          ()
        }
        i = i + 1
      }
      Array::truncate(dtd_eq_enum_inst_check_stack, Array::length(dtd_eq_enum_inst_check_stack) - 1)
      found && ok
    }
  }
}
