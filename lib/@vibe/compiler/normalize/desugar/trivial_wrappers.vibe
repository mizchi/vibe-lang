// Trivial wrappers.

import @vibe/compiler/core {
  Expr, Stmt
}

import @vibe/core {
  array_empty
}

import ./renderer_scope.vibe {
  collect_pat_binders
}

import ./state.vibe {
  dtd_facts_wrappers
}

import ./typed_row_queries.vibe {
  dtd_own_end
}

import ./utilities.vibe {
  str_array_contains
}

fn dtpw_exprs_bind_name(es: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    if dtpw_expr_binds_name(expr = Array::get(es, at = i), name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does `expr` bind (shadow) `name` ANYWHERE within it -- as an EFn
/// parameter, a `let`/`let mut`/`let rec` name, a match/handle arm's
/// pattern binder, a for-loop's item/index name, or a `loop` parameter?
/// Full-coverage traversal mirroring dtpw_inline_expr's own node coverage.
/// See dtpw_collect_wrappers' call site for why this exists (#1074 review,
/// chatgpt-codex-connector P1: "Respect lexical shadowing in wrapper
/// inlining").
fn dtpw_expr_binds_name(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, _) = Array::get(params, at = i)
        if pn == name {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(expr = body, name = name)
    },
    ELet(n, v, b, _) => n == name || dtpw_expr_binds_name(expr = v, name = name) || dtpw_expr_binds_name(expr = b, name = name),
    ELetRec(n, v, b) => n == name || dtpw_expr_binds_name(expr = v, name = name) || dtpw_expr_binds_name(expr = b, name = name),
    ELetMut(n, v, b, _) => n == name || dtpw_expr_binds_name(expr = v, name = name) || dtpw_expr_binds_name(expr = b, name = name),
    EForIn(n, idxn, it, b, _) => {
      let idx_hit = match idxn {
        Some(i2) => i2 == name,
        None => false
      }
      n == name || idx_hit || dtpw_expr_binds_name(expr = it, name = name) || dtpw_expr_binds_name(expr = b, name = name)
    },
    ELoop(params, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, init) = Array::get(params, at = i)
        if pn == name || dtpw_expr_binds_name(expr = init, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(expr = b, name = name)
    },
    EMatch(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(expr = s, name = name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, at = i)
        let bound = array_empty()
        collect_pat_binders(p = p, out = bound)
        if str_array_contains(arr = bound, val = name) || dtpw_expr_binds_name(expr = b, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(expr = s, name = name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, at = i)
        let bound = array_empty()
        collect_pat_binders(p = p, out = bound)
        if str_array_contains(arr = bound, val = name) || dtpw_expr_binds_name(expr = b, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ECall(callee, args, _, _) => dtpw_expr_binds_name(expr = callee, name = name) || dtpw_exprs_bind_name(es = args, name = name),
    EBinOp(_, l, r, _) => dtpw_expr_binds_name(expr = l, name = name) || dtpw_expr_binds_name(expr = r, name = name),
    EUnaryOp(_, e) => dtpw_expr_binds_name(expr = e, name = name),
    ETuple(es) => dtpw_exprs_bind_name(es = es, name = name),
    EArray(es) => dtpw_exprs_bind_name(es = es, name = name),
    ESpread(e) => dtpw_expr_binds_name(expr = e, name = name),
    EContinue(es) => dtpw_exprs_bind_name(es = es, name = name),
    ERecord(_, fs, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, at = i)
        if dtpw_expr_binds_name(expr = v, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, at = i)
        if dtpw_expr_binds_name(expr = v, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, e) => dtpw_expr_binds_name(expr = c, name = name) || dtpw_expr_binds_name(expr = t, name = name) || dtpw_expr_binds_name(expr = e, name = name),
    EAssign(_, v, c, _) => dtpw_expr_binds_name(expr = v, name = name) || dtpw_expr_binds_name(expr = c, name = name),
    EAssignOp(_, _, v, c, _) => dtpw_expr_binds_name(expr = v, name = name) || dtpw_expr_binds_name(expr = c, name = name),
    ESeq(a, b) => dtpw_expr_binds_name(expr = a, name = name) || dtpw_expr_binds_name(expr = b, name = name),
    EWhile(c, b) => dtpw_expr_binds_name(expr = c, name = name) || dtpw_expr_binds_name(expr = b, name = name),
    EDot(o, _, _, _) => dtpw_expr_binds_name(expr = o, name = name),
    ELabeledArg(_, _, e) => dtpw_expr_binds_name(expr = e, name = name),
    EReturn(e) => dtpw_expr_binds_name(expr = e, name = name),
    EBreak(opt) => match opt {
      Some(e) => dtpw_expr_binds_name(expr = e, name = name),
      None => false
    },
    _ => false
  }
}

/// #1070 (narrow slice): a "trivial pass-through wrapper" is a top-level
/// `let name = (param) -> T with <row> { param() }` -- exactly one
/// parameter, body is EXACTLY a zero-arg call to that same parameter and
/// nothing else. Collects (wrapper_name, needed) pairs; `needed` is always
/// true here (arity always matches: the wrapper always takes exactly 1 arg
/// and calls its param with exactly 0), kept as a tuple only for symmetry
/// with how this file's other collector helpers are shaped.
///
/// A collected name is DROPPED again if it's shadowed ANYWHERE in the
/// program (any nested `let`/`let mut`/EFn parameter/match-or-handle-arm
/// binder/for-loop name/loop parameter reusing the same identifier) --
/// dtpw_inline_expr's rewrite matches call sites by NAME ONLY with no
/// scope tracking, so a shadowed name would otherwise get inlined at the
/// WRONG (shadowing) binding's call sites too, changing real program
/// behavior (#1074 review, chatgpt-codex-connector P1). This is
/// deliberately whole-program-conservative rather than precisely
/// scope-threaded: losing the optimization on the rare program that
/// happens to reuse a wrapper's name as a binder elsewhere is an
/// acceptable trade for guaranteed correctness, matching this file's
/// established "bail out entirely when it can't be proven safe" pattern
/// (see dlh_marker_only_called_directly's own doc comment).
/// The trivial pass-through wrappers this run may inline. #2388: a
/// per-module run reads the module's own definitions only -- a dependency
/// interface carries signatures, not bodies, so a wrapper defined in another
/// module is not inlinable there and must not be inlined here either; the
/// shadowing scan below is bounded the same way for the same reason.
fn dtpw_collect_wrappers(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  // The whole-program set first (#2647 Codex round 7). The scan below is
  // limited to the module's OWN bodies, and a dependency's interface is
  // bodyless, so an imported wrapper is invisible here -- and leaving its call
  // un-inlined reaches the closure crash `dtd_run` documents this rewrite as
  // the workaround for.
  let mut wi = 0
  while wi < Array::length(dtd_facts_wrappers) {
    Array::push(out, value = Array::get(dtd_facts_wrappers, at = wi))
    wi = wi + 1
  }
  let own_end = dtd_own_end(stmts)
  let mut i = 0
  while i < own_end {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {
        let (pname, _) = Array::get(params, at = 0)
        match body {
          ECall(callee, args, _, _) => match callee {
            EIdent(cn, _) => if cn == pname && Array::length(args) == 0 {
              Array::push(out, value = name)
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  let safe = array_empty()
  let mut j = 0
  while j < Array::length(out) {
    let wn = Array::get(out, at = j)
    let mut shadowed = false
    let mut k = 0
    while k < own_end && !shadowed {
      match Array::get(stmts, at = k) {
        SLet(_, _, _, _, sv) => if dtpw_expr_binds_name(expr = sv, name = wn) {
          shadowed = true
        } else {
          ()
        },
        _ => ()
      }
      k = k + 1
    }
    if !shadowed {
      Array::push(safe, value = wn)
    } else {
      ()
    }
    j = j + 1
  }
  safe
}

/// Rewrite every `ECall(EIdent(wname), [single_arg], off)` where `wname` is a
/// collected trivial wrapper into `ECall(single_arg, [], off)` -- calling the
/// argument directly instead of routing through the identity wrapper. Full
/// traversal (mirrors this file's other full-coverage passes); the wrapper's
/// own top-level definition is left completely untouched, so it remains
/// valid wherever else it's referenced (as a value, or with a different
/// arity that wouldn't match here anyway).
fn dtpw_inline_expr(expr: Expr, wrappers: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off, callee_resolution) => match callee {
      EIdent(wn, _) => if str_array_contains(arr = wrappers, val = wn) && Array::length(args) == 1 {
        ECall(dtpw_inline_expr(expr = Array::get(args, at = 0), wrappers = wrappers), array_empty(), off, callee_resolution)
      } else {
        ECall(dtpw_inline_expr(expr = callee, wrappers = wrappers), for a in args {
          dtpw_inline_expr(expr = a, wrappers = wrappers)
        }, off, callee_resolution)
      },
      _ => ECall(dtpw_inline_expr(expr = callee, wrappers = wrappers), for a in args {
        dtpw_inline_expr(expr = a, wrappers = wrappers)
      }, off, callee_resolution)
    },
    EBinOp(op, l, r, boff) => EBinOp(op, dtpw_inline_expr(expr = l, wrappers = wrappers), dtpw_inline_expr(expr = r, wrappers = wrappers), boff),
    EUnaryOp(op, e) => EUnaryOp(op, dtpw_inline_expr(expr = e, wrappers = wrappers)),
    ETuple(es) => ETuple(for e in es {
      dtpw_inline_expr(expr = e, wrappers = wrappers)
    }),
    EArray(es) => EArray(for e in es {
      dtpw_inline_expr(expr = e, wrappers = wrappers)
    }),
    ESpread(e) => ESpread(dtpw_inline_expr(expr = e, wrappers = wrappers)),
    EContinue(es) => EContinue(for e in es {
      dtpw_inline_expr(expr = e, wrappers = wrappers)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, at = i)
        Array::push(out, value = (k, dtpw_inline_expr(expr = v, wrappers = wrappers)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, at = i)
        Array::push(out, value = (k, dtpw_inline_expr(expr = v, wrappers = wrappers)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dtpw_inline_expr(expr = c, wrappers = wrappers), dtpw_inline_expr(expr = t, wrappers = wrappers), dtpw_inline_expr(expr = e, wrappers = wrappers)),
    ELet(n, v, b, soff) => ELet(n, dtpw_inline_expr(expr = v, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers), soff),
    ELetRec(n, v, b) => ELetRec(n, dtpw_inline_expr(expr = v, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers)),
    ELetMut(n, v, b, soff) => ELetMut(n, dtpw_inline_expr(expr = v, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers), soff),
    EAssign(n, v, c, target_off) => EAssign(n, dtpw_inline_expr(expr = v, wrappers = wrappers), dtpw_inline_expr(expr = c, wrappers = wrappers), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, dtpw_inline_expr(expr = v, wrappers = wrappers), dtpw_inline_expr(expr = c, wrappers = wrappers), target_off),
    ESeq(a, b) => ESeq(dtpw_inline_expr(expr = a, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers)),
    EWhile(c, b) => EWhile(dtpw_inline_expr(expr = c, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers)),
    EForIn(n, idxn, it, b, for_off) => EForIn(n, idxn, dtpw_inline_expr(expr = it, wrappers = wrappers), dtpw_inline_expr(expr = b, wrappers = wrappers), for_off),
    EDot(o, f, off, fdoff) => EDot(dtpw_inline_expr(expr = o, wrappers = wrappers), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dtpw_inline_expr(expr = e, wrappers = wrappers)),
    EReturn(e) => EReturn(dtpw_inline_expr(expr = e, wrappers = wrappers)),
    EBreak(opt) => EBreak(match opt {
      Some(e) => Some(dtpw_inline_expr(expr = e, wrappers = wrappers)),
      None => None
    }),
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dtpw_inline_expr(expr = body, wrappers = wrappers)),
    EMatch(s, arms) => EMatch(dtpw_inline_expr(expr = s, wrappers = wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(expr = b, wrappers = wrappers))
    }),
    EHandle(s, arms) => EHandle(dtpw_inline_expr(expr = s, wrappers = wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(expr = b, wrappers = wrappers))
    }),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, dtpw_inline_expr(expr = init, wrappers = wrappers))
    }, dtpw_inline_expr(expr = b, wrappers = wrappers)),
    _ => expr
  }
}

export fn dtpw_inline_trivial_wrappers(_ stmts: Array[Stmt]) -> Unit {
  let wrappers = dtpw_collect_wrappers(stmts)
  if Array::length(wrappers) == 0 {
    ()
  } else {
    let own_end = dtd_own_end(stmts)
    let mut i = 0
    while i < own_end {
      match Array::get(stmts, at = i) {
        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, at = i, value = SLet(exported, is_rec, name, ty, dtpw_inline_expr(expr = expr, wrappers = wrappers))),
        _ => ()
      }
      i = i + 1
    }
  }
}
