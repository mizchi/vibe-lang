// Type name occurrences.

import @vibe/compiler/core {
  TypeExpr
}

import ./utilities.vibe {
  str_array_contains
}

/// Does the type mention any of `names` as a bare TyName (a fn's own type
/// parameters, for the seeding guard below)?
export fn ty_mentions_name_in(t: TypeExpr, names: Array[String]) -> Bool {
  match t {
    TyName(n) => str_array_contains(names, n),
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_mentions_name_in(Array::get(args, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if ty_mentions_name_in(Array::get(ts, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}
