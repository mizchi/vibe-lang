// Applied trait keys through type aliases (#3947).
import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeDef, TypeExpr, canonical_trait_arg_type_expr, resolve_type_expr_core_shadowed
}

import @vibe/ast {
  impl_method_owner, trait_ref_from_key, trait_ref_key, type_param_name
}

import ./state.vibe {
  dtd_eq_type_aliases
}

//# Functions

/// #3947: spell every applied trait key with its type aliases expanded: an
/// impl's head (`impl Value[Alias] for Note`) and bounds, a top-level
/// function's bounds (`[V: Value[Alias]]`), and a trait method binder's
/// bounds. Witness lookup matches a bound to
/// an impl by the key's spelling, and so does the name the parser gives an
/// impl's methods (`impl_method_owner`), so `Value[Alias]` and `Value[Int]`
/// named two different impls once `type Alias = Int`. The checker judges both
/// as `Value[Int]` (`canonical_impl_trait_key`), and this makes the lowering
/// agree. Method bindings whose owner was spelled from a rewritten key are
/// renamed with it. An argument that names one of the declaration's own type
/// parameters is left as written.
///
/// Each argument is resolved and written back the way the checker's
/// `canonical_impl_trait_key` does it (`resolve_type_expr_core_shadowed`,
/// then `canonical_trait_arg_type_expr`), not expanded syntactically: every
/// spelling the resolver identifies (`Unit` and `()`, `StringMap[V]` and
/// `Map[String, V]`) then encodes as one key on both sides. That is also why
/// it runs whether or not the program declares an alias.
///
/// Reads the alias table `eq_known_types_reset` fills, so it runs after it.
export fn expand_trait_key_aliases(_ stmts: Array[Stmt]) -> Unit {
  tka_defs_reset()
  expand_trait_key_aliases_in(stmts)
}

/// The program's type aliases as the checker's resolver reads them, so a key
/// is resolved here exactly as `canonical_impl_trait_key` resolves it. An
/// alias naming a later one resolves on a later round; one round per alias
/// closes every chain.
let tka_defs: Array[TypeDef] = []

fn tka_defs_reset() -> Unit {
  let rounds = Array::length(dtd_eq_type_aliases)
  let mut r = 0
  while r < rounds {
    let next: Array[TypeDef] = []
    for row in dtd_eq_type_aliases {
      let (name, params, target) = row
      Array::push(next, value = TDAlias(name, params, resolve_type_expr_core_shadowed(te = target, defs = tka_defs, shadow = params)))
    }
    Array::truncate(tka_defs, length = 0)
    for d in next {
      Array::push(tka_defs, value = d)
    }
    r = r + 1
  }
  if rounds == 0 {
    Array::truncate(tka_defs, length = 0)
  }
}

fn expand_trait_key_aliases_in(_ stmts: Array[Stmt]) -> Unit {
  let owner_renames: Array[(String, String)] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, bounds, trait_name, target) => {
        let names = for t in tparams {
          type_param_name(t)
        }
        let next_key = expand_key_aliases(key = trait_name, names = names)
        let next_bounds = expand_bound_aliases(bounds = bounds, names = names)
        if next_key != trait_name || next_bounds != bounds {
          Array::set(stmts, at = i, value = SImpl(tparams, next_bounds, next_key, target))
        } else {
          ()
        }
        if next_key != trait_name {
          let before = impl_method_owner(tparams = tparams, trait_name = trait_name, target = target)
          let after = impl_method_owner(tparams = tparams, trait_name = next_key, target = target)
          if before != after {
            Array::push(owner_renames, value = (String::concat(before, "::"), String::concat(after, "::")))
          } else {
            ()
          }
        } else {
          ()
        }
      },
      // A trait method's own binder bounds (`run[T: Value[Alias]](Self, T)`)
      // are matched against the same impls, so they are spelled the same way.
      STrait(exported, name, supers, methods, method_tparams, tparams) => {
        let next_rows = for row in method_tparams {
          let (mname, mtparams, mbounds) = row
          let names = for t in tparams {
            type_param_name(t)
          }
          for t in mtparams {
            Array::push(names, value = type_param_name(t))
          }
          (mname, mtparams, expand_bound_aliases(bounds = mbounds, names = names))
        }
        if next_rows != method_tparams {
          Array::set(stmts, at = i, value = STrait(exported, name, supers, methods, next_rows, tparams))
        } else {
          ()
        }
      },
      // A function's bounds, and those of every lambda nested in a body
      // (`let inner = [V: Value[Alias]](v: V) -> ..`, Codex on #3956).
      SLet(exported, is_rec, name, ty, body) => match tka_expr(e = body, names = [
      ]) {
        Some(next) => Array::set(stmts, at = i, value = SLet(exported, is_rec, name, ty, next)),
        None => ()
      },
      SFnDecl(exported, name, body, attrs, off) => match tka_expr(e = body, names = [
      ]) {
        Some(next) => Array::set(stmts, at = i, value = SFnDecl(exported, name, next, attrs, off)),
        None => ()
      },
      STest(label, body) => match tka_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = STest(label, next)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  if Array::length(owner_renames) > 0 {
    rename_impl_method_bindings(stmts = stmts, renames = owner_renames)
  } else {
    ()
  }
}

/// `e` with every lambda's bounds spelled with aliases expanded, or None when
/// nothing changed. `names` are the binders in scope, which shadow an alias
/// of their spelling.
fn tka_expr(e: Expr, names: Array[String]) -> Option[Expr] {
  match e {
    EFn(tp, bs, ps, ret, eff, body) => if Array::length(tp) == 0 && Array::length(bs) == 0 {
      // An ordinary lambda binds no type and asks for no witness: only its
      // body can change, under the same binders.
      match tka_expr(e = body, names = names) {
        Some(next) => Some(EFn(tp, bs, ps, ret, eff, next)),
        None => None
      }
    } else {
      let inner: Array[String] = []
      for n in names {
        Array::push(inner, value = n)
      }
      for t in tp {
        Array::push(inner, value = type_param_name(t))
      }
      let nb = expand_bound_aliases(bounds = bs, names = inner)
      let nbody = tka_expr(e = body, names = inner)
      if nb != bs || tka_changed(nbody) {
        Some(EFn(tp, nb, ps, ret, eff, tka_or(o = nbody, e = body)))
      } else {
        None
      }
    },
    ETuple(items) => match tka_list(es = items, names = names) {
      Some(next) => Some(ETuple(next)),
      None => None
    },
    EArray(items) => match tka_list(es = items, names = names) {
      Some(next) => Some(EArray(next)),
      None => None
    },
    EContinue(items) => match tka_list(es = items, names = names) {
      Some(next) => Some(EContinue(next)),
      None => None
    },
    ERecord(n, fields, tas) => match tka_fields(fields = fields, names = names) {
      Some(next) => Some(ERecord(n, next, tas)),
      None => None
    },
    EMap(fields) => match tka_fields(fields = fields, names = names) {
      Some(next) => Some(EMap(next)),
      None => None
    },
    ELoop(binds, body) => {
      let nbinds = tka_fields(fields = binds, names = names)
      let nbody = tka_expr(e = body, names = names)
      if tka_changed(nbinds) || tka_changed(nbody) {
        Some(ELoop(match nbinds {
          Some(x) => x,
          None => binds
        }, tka_or(o = nbody, e = body)))
      } else {
        None
      }
    },
    EIf(c, t, el) => {
      let a = tka_expr(e = c, names = names)
      let b = tka_expr(e = t, names = names)
      let d = tka_expr(e = el, names = names)
      if tka_changed(a) || tka_changed(b) || tka_changed(d) {
        Some(EIf(tka_or(o = a, e = c), tka_or(o = b, e = t), tka_or(o = d, e = el)))
      } else {
        None
      }
    },
    ELet(n, v, b, off) => match tka_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELet(n, x, y, off)),
      None => None
    },
    ELetRec(n, v, b) => match tka_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELetRec(n, x, y)),
      None => None
    },
    ELetMut(n, v, b, off) => match tka_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELetMut(n, x, y, off)),
      None => None
    },
    EAssign(n, v, c, off) => match tka_pair(a = v, b = c, names = names) {
      Some((x, y)) => Some(EAssign(n, x, y, off)),
      None => None
    },
    EAssignOp(n, op, v, c, off) => match tka_pair(a = v, b = c, names = names) {
      Some((x, y)) => Some(EAssignOp(n, op, x, y, off)),
      None => None
    },
    ESeq(a, b) => match tka_pair(a = a, b = b, names = names) {
      Some((x, y)) => Some(ESeq(x, y)),
      None => None
    },
    EWhile(c, b) => match tka_pair(a = c, b = b, names = names) {
      Some((x, y)) => Some(EWhile(x, y)),
      None => None
    },
    EBinOp(op, l, r, off) => match tka_pair(a = l, b = r, names = names) {
      Some((x, y)) => Some(EBinOp(op, x, y, off)),
      None => None
    },
    EForIn(n, idx, it, b) => match tka_pair(a = it, b = b, names = names) {
      Some((x, y)) => Some(EForIn(n, idx, x, y)),
      None => None
    },
    EMatch(sc, arms) => {
      let a = tka_expr(e = sc, names = names)
      let narms = tka_arms(arms = arms, names = names)
      if tka_changed(a) || tka_changed(narms) {
        Some(EMatch(tka_or(o = a, e = sc), match narms {
          Some(x) => x,
          None => arms
        }))
      } else {
        None
      }
    },
    EHandle(body, arms) => {
      let a = tka_expr(e = body, names = names)
      let narms = tka_arms(arms = arms, names = names)
      if tka_changed(a) || tka_changed(narms) {
        Some(EHandle(tka_or(o = a, e = body), match narms {
          Some(x) => x,
          None => arms
        }))
      } else {
        None
      }
    },
    ECall(callee, args, off, cell) => {
      let a = tka_expr(e = callee, names = names)
      let nargs = tka_list(es = args, names = names)
      if tka_changed(a) || tka_changed(nargs) {
        Some(ECall(tka_or(o = a, e = callee), match nargs {
          Some(x) => x,
          None => args
        }, off, cell))
      } else {
        None
      }
    },
    EUnaryOp(op, x) => match tka_expr(e = x, names = names) {
      Some(next) => Some(EUnaryOp(op, next)),
      None => None
    },
    EDot(o, f, o1, o2) => match tka_expr(e = o, names = names) {
      Some(next) => Some(EDot(next, f, o1, o2)),
      None => None
    },
    ELabeledArg(l, n, v) => match tka_expr(e = v, names = names) {
      Some(next) => Some(ELabeledArg(l, n, next)),
      None => None
    },
    EReturn(x) => match tka_expr(e = x, names = names) {
      Some(next) => Some(EReturn(next)),
      None => None
    },
    ESpread(x) => match tka_expr(e = x, names = names) {
      Some(next) => Some(ESpread(next)),
      None => None
    },
    EBreak(Some(x)) => match tka_expr(e = x, names = names) {
      Some(next) => Some(EBreak(Some(next))),
      None => None
    },
    _ => None
  }
}

fn tka_changed[X](_ o: Option[X]) -> Bool {
  match o {
    Some(_) => true,
    None => false
  }
}

fn tka_or(o: Option[Expr], e: Expr) -> Expr {
  match o {
    Some(x) => x,
    None => e
  }
}

fn tka_pair(a: Expr, b: Expr, names: Array[String]) -> Option[(Expr, Expr)] {
  let na = tka_expr(e = a, names = names)
  let nb = tka_expr(e = b, names = names)
  if tka_changed(na) || tka_changed(nb) {
    Some((tka_or(o = na, e = a), tka_or(o = nb, e = b)))
  } else {
    None
  }
}

fn tka_list(es: Array[Expr], names: Array[String]) -> Option[Array[Expr]] {
  // Allocates only from the first element that changes.
  let n = Array::length(es)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !tka_changed(first) {
    first = tka_expr(e = Array::get(es, at = i), names = names)
    if !tka_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[Expr] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(es, at = j))
        j = j + 1
      }
      Array::push(out, value = changed)
      j = i + 1
      while j < n {
        let x = Array::get(es, at = j)
        Array::push(out, value = tka_or(o = tka_expr(e = x, names = names), e = x))
        j = j + 1
      }
      Some(out)
    }
  }
}

fn tka_fields(fields: Array[(String, Expr)], names: Array[String]) -> Option[Array[(String, Expr)]] {
  let n = Array::length(fields)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !tka_changed(first) {
    let (_, x) = Array::get(fields, at = i)
    first = tka_expr(e = x, names = names)
    if !tka_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[(String, Expr)] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(fields, at = j))
        j = j + 1
      }
      let (name_i, _) = Array::get(fields, at = i)
      Array::push(out, value = (name_i, changed))
      j = i + 1
      while j < n {
        let (fname, x) = Array::get(fields, at = j)
        Array::push(out, value = (fname, tka_or(o = tka_expr(e = x, names = names), e = x)))
        j = j + 1
      }
      Some(out)
    }
  }
}

fn tka_arms(arms: Array[(Pat, Expr)], names: Array[String]) -> Option[Array[(Pat, Expr)]] {
  let n = Array::length(arms)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !tka_changed(first) {
    let (_, x) = Array::get(arms, at = i)
    first = tka_expr(e = x, names = names)
    if !tka_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[(Pat, Expr)] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(arms, at = j))
        j = j + 1
      }
      let (pat_i, _) = Array::get(arms, at = i)
      Array::push(out, value = (pat_i, changed))
      j = i + 1
      while j < n {
        let (p, x) = Array::get(arms, at = j)
        Array::push(out, value = (p, tka_or(o = tka_expr(e = x, names = names), e = x)))
        j = j + 1
      }
      Some(out)
    }
  }
}

fn expand_key_aliases(key: String, names: Array[String]) -> String {
  match trait_ref_from_key(key) {
    Some(TyApp(head, args)) => {
      let mut changed = false
      let mapped = for arg in args {
        let next = if type_expr_names_any(ty = arg, names = names) {
          arg
        } else {
          match canonical_trait_arg_type_expr(resolve_type_expr_core_shadowed(te = arg, defs = tka_defs, shadow = names)) {
            Some(written) => written,
            None => arg
          }
        }
        if next != arg {
          changed = true
        } else {
          ()
        }
        next
      }
      if changed {
        trait_ref_key(TyApp(head, mapped))
      } else {
        key
      }
    },
    _ => key
  }
}

fn expand_bound_aliases(bounds: Array[(String, Array[String])], names: Array[String]) -> Array[(String, Array[String])] {
  if Array::length(bounds) == 0 {
    bounds
  } else {
    expand_bound_aliases_in(bounds = bounds, names = names)
  }
}

fn expand_bound_aliases_in(bounds: Array[(String, Array[String])], names: Array[String]) -> Array[(String, Array[String])] {
  for bound in bounds {
    let (param, traits) = bound
    (param, for trait_ref in traits {
      expand_key_aliases(key = trait_ref, names = names)
    })
  }
}

fn rename_impl_method_bindings(stmts: Array[Stmt], renames: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, is_rec, name, ty, body) => match renamed_owner(name = name, renames = renames) {
        Some(next) => Array::set(stmts, at = i, value = SLet(exported, is_rec, next, ty, body)),
        None => ()
      },
      SFnDecl(exported, name, body, attrs, off) => match renamed_owner(name = name, renames = renames) {
        Some(next) => Array::set(stmts, at = i, value = SFnDecl(exported, next, body, attrs, off)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

fn renamed_owner(name: String, renames: Array[(String, String)]) -> Option[String] {
  let mut out = None
  for row in renames {
    let (before, after) = row
    if out == None && String::starts_with(name, prefix = before) {
      out = Some(String::concat(after, String::substring(name, start = String::length(before), end = String::length(name))))
    } else {
      ()
    }
  }
  out
}

fn type_expr_names_any(ty: TypeExpr, names: Array[String]) -> Bool {
  match ty {
    TyName(name) => {
      let mut found = false
      for n in names {
        if n == name {
          found = true
        } else {
          ()
        }
      }
      found
    },
    TyApp(name, args) => type_expr_names_any(ty = TyName(name), names = names) || type_exprs_name_any(tys = args, names = names),
    TyTuple(items) => type_exprs_name_any(tys = items, names = names),
    TyFn(params, ret, _) => type_expr_names_any(ty = ret, names = names) || type_exprs_name_any(tys = params, names = names),
    TyUnit => false
  }
}

fn type_exprs_name_any(tys: Array[TypeExpr], names: Array[String]) -> Bool {
  let mut found = false
  for t in tys {
    if !found && type_expr_names_any(ty = t, names = names) {
      found = true
    } else {
      ()
    }
  }
  found
}
