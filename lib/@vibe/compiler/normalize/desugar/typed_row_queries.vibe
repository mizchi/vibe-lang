// Typed row queries.

import @vibe/compiler/core {
  Stmt, TypeExpr, typed_render_row_head
}

import @vibe/ast {
  impl_target_from_key
}

import ./state.vibe {
  dtd_ctx_len,
  dtd_eq_deferred_requests,
  dtd_eq_deferred_types,
  dtd_eq_typed_refusals,
  dtd_own_limit,
  dtd_typed_eq_keys,
  dtd_typed_eq_offs,
  dtd_typed_render_keys,
  dtd_typed_render_offs,
  dtd_typed_render_parsed,
  dtd_typed_render_tys
}

/// End (exclusive) of the module's own statements; the whole array when no
/// module boundary is set.
export fn dtd_own_end(_ stmts: Array[Stmt]) -> Int {
  let lim = Array::get(dtd_own_limit, at = 0)
  if lim < 0 || lim > Array::length(stmts) {
    Array::length(stmts)
  } else {
    lim
  }
}

/// Whether index `i` is a module-owned statement: everything before the
/// boundary, plus everything appended after the context block (the pass's
/// own synthesized statements).
export fn dtd_is_own_index(_ i: Int) -> Bool {
  let lim = Array::get(dtd_own_limit, at = 0)
  lim < 0 || i < lim || i >= lim + Array::get(dtd_ctx_len, at = 0)
}

/// Whether `trait_name` is declared among the module's own statements.
export fn dtd_trait_declared_here(stmts: Array[Stmt], trait_name: String) -> Bool {
  let own_end = dtd_own_end(stmts)
  let mut i = 0
  let mut found = false
  while i < own_end && !found {
    match Array::get(stmts, at = i) {
      STrait(_, n, _, _, _, _) => if n == trait_name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Two arms' answers: the one that answered when only one did, the shared one
/// when both agree, "" when they disagree.
export fn dtd_typed_item_shape_join(a: String, b: String) -> String {
  if String::length(a) == 0 {
    b
  } else if String::length(b) == 0 || a == b {
    a
  } else {
    ""
  }
}

/// #3084: a row shape that is a bare declared name (`Pt`), not a composite
/// encoding.
export fn dtd_row_is_bare_nominal(_ sh: String) -> Bool {
  if String::length(sh) == 0 {
    false
  } else {
    let c = String::char_code_at(sh, at = 0)
    // Not `(`, `[`, `{`.
    c != 40 && c != 91 && c != 123
  }
}

export fn dtd_typed_eq_key_for(_ boff: Int) -> String {
  if boff < 0 {
    ""
  } else {
    let n = Array::length(dtd_typed_eq_offs)
    let mut i = 0
    let mut found = ""
    while i < n {
      if Array::get(dtd_typed_eq_offs, at = i) == boff {
        found = Array::get(dtd_typed_eq_keys, at = i)
        i = n
      } else {
        i = i + 1
      }
    }
    found
  }
}

/// #3900: forget the render rows, before `dtd_run` files this program's.
export fn dtd_typed_render_reset() -> Unit {
  Array::truncate(dtd_typed_render_offs, length = 0)
  Array::truncate(dtd_typed_render_keys, length = 0)
  Array::truncate(dtd_typed_render_tys, length = 0)
  Array::truncate(dtd_typed_render_parsed, length = 0)
}

/// #3900: file a render row, keeping the rows sorted by offset. A row goes
/// after every row already filed for its offset, so the first row for an
/// offset is still the first that arrived. Rows arrive in source order, so
/// this is an append in the common case.
export fn dtd_typed_render_insert(off: Int, key: String) -> Unit {
  let at = dtd_typed_render_upper(off)
  Array::push(dtd_typed_render_offs, value = off)
  Array::push(dtd_typed_render_keys, value = key)
  Array::push(dtd_typed_render_tys, value = None)
  Array::push(dtd_typed_render_parsed, value = false)
  let mut j = Array::length(dtd_typed_render_offs) - 1
  while j > at {
    Array::set(dtd_typed_render_offs, at = j, value = Array::get(dtd_typed_render_offs, at = j - 1))
    Array::set(dtd_typed_render_keys, at = j, value = Array::get(dtd_typed_render_keys, at = j - 1))
    Array::set(dtd_typed_render_tys, at = j, value = Array::get(dtd_typed_render_tys, at = j - 1))
    Array::set(dtd_typed_render_parsed, at = j, value = Array::get(dtd_typed_render_parsed, at = j - 1))
    j = j - 1
  }
  Array::set(dtd_typed_render_offs, at = at, value = off)
  Array::set(dtd_typed_render_keys, at = at, value = key)
  Array::set(dtd_typed_render_tys, at = at, value = None)
  Array::set(dtd_typed_render_parsed, at = at, value = false)
}

/// The first row index whose offset is greater than `off`.
fn dtd_typed_render_upper(_ off: Int) -> Int {
  let mut lo = 0
  let mut hi = Array::length(dtd_typed_render_offs)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(dtd_typed_render_offs, at = mid) <= off {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

/// #3900: the `T` of the first render row filed for `off` (its key is
/// `impl_target_key(__render[T])`), or None when no row was filed there or
/// its key does not read as one. Each row's key is parsed once.
export fn dtd_typed_render_row_ty(_ off: Int) -> Option[TypeExpr] {
  if off < 0 {
    None
  } else {
    let mut lo = 0
    let mut hi = Array::length(dtd_typed_render_offs)
    while lo < hi {
      let mid = (lo + hi) / 2
      if Array::get(dtd_typed_render_offs, at = mid) < off {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo < Array::length(dtd_typed_render_offs) && Array::get(dtd_typed_render_offs, at = lo) == off {
      if !Array::get(dtd_typed_render_parsed, at = lo) {
        let ty = match impl_target_from_key(Array::get(dtd_typed_render_keys, at = lo)) {
          Some(TyApp(head, args)) => if head == typed_render_row_head() && Array::length(args) == 1 {
            Some(Array::get(args, at = 0))
          } else {
            None
          },
          _ => None
        }
        Array::set(dtd_typed_render_tys, at = lo, value = ty)
        Array::set(dtd_typed_render_parsed, at = lo, value = true)
      } else {
        ()
      }
      Array::get(dtd_typed_render_tys, at = lo)
    } else {
      None
    }
  }
}

/// #2642 review (Codex P2): clear what a LANE recorded, at that lane's
/// boundary.
///
/// These three arrays are process-global and nothing cleared them, while their
/// own doc comments said "since the last reset". The other synthesis registries
/// (`dtd_arr_eq_needed_keys`, `dtd_map_eq_needed_keys`,
/// `dtd_eq_specializations`) are reset by `dtd_run` on every call, so they
/// describe one run; a caller that wants the union over several modules unions
/// the per-run lists itself. These cannot do that, because `eq_mint_deferred_into`
/// reads the REGISTRY at the link and so needs it to accumulate across the
/// modules of one split run -- which also means every earlier program's
/// deferrals were still in it. A second oracle report in the same process
/// therefore replayed the first program's instantiations against the second
/// program's statements, and `deferred` / `minted` depended on test order.
///
/// So the reset is at the lane boundary rather than per run: the whole-program
/// entry (`desugar_trait_dicts_with_typed_eq`, one program per call) and the
/// per-module driver, before its first module.
export fn eq_deferred_reset() -> Unit {
  Array::truncate(dtd_eq_deferred_requests, length = 0)
  Array::truncate(dtd_eq_deferred_types, length = 0)
  Array::truncate(dtd_eq_typed_refusals, length = 0)
}
