// Derive pass.

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import ./derive_operations.vibe {
  arr_to_string_name,
  collect_array_elem_types,
  collect_decl_type_names,
  collect_show_array_elems,
  dtd_source_op_defined,
  empty_stmt_list,
  gen_compare_fn,
  gen_default_fn,
  gen_enum_compare_fn,
  gen_enum_default_fn,
  gen_enum_show_fn,
  gen_hash_key_fn,
  qualified_name,
  show_inline_merge_arr_elems,
  top_level_fn_exists
}

import ./equality_generation.vibe {
  gen_arr_equals_fn, gen_eq_fn
}

import ./equality_requests.vibe {
  arr_equals_name, dtd_fresh_reset_for_decl
}

import ./equality_shape_queries.vibe {
  collect_bare_array_eq_keys
}

import ./formal_scope.vibe {
  subst_field_formals, subst_variant_formals, type_param_names_reset
}

import ./name_encoding.vibe {
  idx_str
}

import ./renderer_scope.vibe {
  derived_renderer_record
}

import ./show_generation.vibe {
  gen_arr_to_string_fn, gen_show_fn
}

