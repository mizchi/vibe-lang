// Host-provided effects (ADR-0124, #2656).

import @vibe/compiler/core {
  EffectOwner, Stmt, set_program_extern_effects
}

/// ADR-0124 (#2656): record the program's `extern effect` names. No lowering
/// binds an operation of one yet, so code generation refuses a call that
/// reaches it (`refuse_extern_effect_operation`); `vibe check`, which runs
/// this pass too, still accepts the program.
export fn note_extern_effects(_ stmts: Array[Stmt]) -> Unit {
  let hosts: Array[String] = []
  xe_collect_hosts(stmts = stmts, out = hosts)
  set_program_extern_effects(hosts)
}

fn xe_collect_hosts(stmts: Array[Stmt], out: Array[String]) -> Unit {
  for stmt in stmts {
    match stmt {
      SEffectDef(_, name, _, _, HostProvided) => Array::push(out, value = name),
      SModule(_, _, inner) => xe_collect_hosts(stmts = inner, out = out),
      _ => ()
    }
  }
  ()
}
