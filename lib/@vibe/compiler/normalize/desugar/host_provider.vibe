// Host provider.

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import ./handled_host_calls.vibe {
  dhhc_expr, dhhc_note_shadowed_names, dhhc_rewrite_stmts
}

import ./host_operations.vibe {
  ehp_bound_builtin_names,
  ehp_collect_stmts,
  ehp_declare_missing_effects,
  ehp_declared_incompatibly,
  ehp_entry_row,
  ehp_move_aside_aliases,
  ehp_row_grants,
  ehp_test_grants,
  ehp_unshadowed,
  ehp_wrap,
  ihc_arm_ops_stmts,
  ihc_granted_everywhere,
  ihc_widen_row
}

import ./state.vibe {
  dhhc_forward_only, dhhc_forward_ops
}

import ./utilities.vibe {
  str_array_contains
}

/// In place, over the whole program. `entry_name` is the artifact's entry
/// (`__no_entry__` on the unit-test lane, which has only test blocks).
export fn intercept_handled_host_calls_everywhere(stmts: Array[Stmt], entry_name: String) -> Unit {
  dhhc_note_shadowed_names(stmts)
  let named: Array[String] = []
  ihc_arm_ops_stmts(stmts, named)
  let ops: Array[String] = []
  let mut i = 0
  while i < Array::length(named) {
    let op = Array::get(named, i)
    if ihc_granted_everywhere(stmts, entry_name, op) && !ehp_declared_incompatibly(stmts, op) && !str_array_contains(ops, op) {
      Array::push(ops, op)
    } else {
      ()
    }
    i = i + 1
  }
  if Array::length(ops) == 0 {
    ()
  } else {
    let mut s = 0
    while s < Array::length(stmts) {
      Array::set(stmts, s, ihc_rewrite_stmt(Array::get(stmts, s), ops))
      s = s + 1
    }
  }
}

/// One statement of `intercept_handled_host_calls_everywhere`'s rewrite. A
/// source `module M { .. }` is walked like the top level: a handled helper
/// inside it is still reached through `M::reader()` (Codex on #3059).
fn ihc_rewrite_stmt(stmt: Stmt, ops: Array[String]) -> Stmt {
  match stmt {
    SLet(e, r, n, t, EFn(tps, tbs, params, ret, eff, body)) => {
      // The signature may sit on the BINDING instead (`let read: () -> String
      // with Fs::read_file = () -> ..`); the checker reads that annotation as
      // the row, and the evidence pass reads only the EFn slot. So the
      // annotation is widened too, and its widened row is materialized into
      // an empty EFn slot -- else the helper gets no handler dictionary and a
      // caller's handler is bypassed (Codex on #3059).
      let widened_ty = match t {
        Some(TyFn(pts, rt, Some(row))) => Some(TyFn(pts, rt, Some(ihc_widen_row(row, ops)))),
        _ => t
      }
      let widened = match eff {
        Some(row) => Some(ihc_widen_row(row, ops)),
        None => match widened_ty {
          Some(TyFn(_, _, Some(row))) => Some(row),
          _ => None
        }
      }
      SLet(e, r, n, widened_ty, EFn(tps, tbs, params, ret, widened, dhhc_expr(body, ops)))
    },
    SLet(e, r, n, t, body) => SLet(e, r, n, t, dhhc_expr(body, ops)),
    SLetMut(n, t, body) => SLetMut(n, t, dhhc_expr(body, ops)),
    SLetPat(p, body) => SLetPat(p, dhhc_expr(body, ops)),
    STest(n, body) => STest(n, dhhc_expr(body, ops)),
    SBench(n, body) => SBench(n, dhhc_expr(body, ops)),
    SExample(n, body) => SExample(n, dhhc_expr(body, ops)),
    SExpr(body) => SExpr(dhhc_expr(body, ops)),
    SModule(exported, name, body) => {
      let inner: Array[Stmt] = []
      let mut i = 0
      while i < Array::length(body) {
        Array::push(inner, ihc_rewrite_stmt(Array::get(body, i), ops))
        i = i + 1
      }
      SModule(exported, name, inner)
    },
    other => other
  }
}

/// Install the standard host provider around every entry: `entry_name`'s
/// body, and each `test` / `bench` body (the unit-test lane compiles those as
/// entries of their own). Then declare any host effect the provider now
/// handles but the program never declared. A no-op for a program that
/// performs no host operation. See the section comment above.
///
/// Only a PROVIDED effect is declared. Declaring one merely because a user
/// `handle` names its operation would be a wider change than this pass makes:
/// the compiler's own sources carry two such handlers
/// (`core/module_graph_path.vibe`, `cache/cache_underlying.vibe`), and a
/// declared `Env` sends every `Env`-row closure in the CLI through evidence
/// migration -- measured, the stage1 -> stage2 self-compile then fails. A
/// handler for an undeclared host effect keeps today's refusal.
export fn wrap_entry_host_provider(stmts: Array[Stmt], entry_name: String) -> Unit {
  // The provider is what makes the callee interception sound: every direct
  // call it turns into a perform is caught here when no user handler is.
  intercept_handled_host_calls_everywhere(stmts, entry_name)
  let performed: Array[(String, Int)] = []
  let handled: Array[(String, Int)] = []
  ehp_collect_stmts(stmts, performed, handled)
  if Array::length(performed) == 0 {
    ()
  } else {
    // A top-level FUNCTION already named like the builtin would capture the
    // provider's call; leave that operation unprovided (today's behaviour).
    let fn_bound: Array[String] = []
    ehp_bound_builtin_names(stmts, performed, false, fn_bound)
    let effects: Array[String] = []
    let provided_ops: Array[String] = []
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name {
          let row = ehp_entry_row(stmts, ty, eff)
          let wrapped = ehp_wrap(body, performed, (op) -> {
            ehp_row_grants(row, op) && !ehp_declared_incompatibly(stmts, op) && ehp_unshadowed(fn_bound, op, provided_ops)
          }, effects)
          Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))
        } else {
          ()
        },
        STest(tname, body) => {
          Array::set(stmts, i, STest(tname, ehp_wrap(body, performed, (op) -> {
            ehp_test_grants(op) && !ehp_declared_incompatibly(stmts, op) && ehp_unshadowed(fn_bound, op, provided_ops)
          }, effects)))
        },
        SBench(bname, body) => {
          Array::set(stmts, i, SBench(bname, ehp_wrap(body, performed, (op) -> {
            ehp_test_grants(op) && !ehp_declared_incompatibly(stmts, op) && ehp_unshadowed(fn_bound, op, provided_ops)
          }, effects)))
        },
        _ => ()
      }
      i = i + 1
    }
    ehp_move_aside_aliases(stmts, provided_ops)
    Array::truncate(dhhc_forward_ops, 0)
    ehp_declare_missing_effects(stmts, effects, performed, handled)
    if Array::length(dhhc_forward_ops) > 0 {
      // A user handler of an effect the declaration just grew answers only
      // the operations it names; give it a forwarding arm for each new one.
      Array::set(dhhc_forward_only, 0, true)
      dhhc_rewrite_stmts(stmts)
      Array::set(dhhc_forward_only, 0, false)
      Array::truncate(dhhc_forward_ops, 0)
    } else {
      ()
    }
  }
}
