// Float rounding (#3543).

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, expr_child_at, expr_children, expr_children_pop, expr_children_push, expr_children_top
}

import @vibe/ast {
  builtin_ref
}

//# Functions

/// #3543: `Float` is a 32-bit type held in the f64 representation `Double`
/// uses, so code generation computes `a + b` on two Floats in f64. Every
/// arithmetic result the checker typed `Float` therefore has to be rounded to
/// f32 before anything reads it; otherwise `16777217.0f == 16777216.0f` would
/// be `false` and `1.0f / 3.0f` would print 16 digits.
///
/// The checker files one typed-`==` channel row per such site
/// (`float_arith_rows_from_capture`): an arithmetic binop under its operator
/// offset (`binop_offs`), a compound assignment under its target offset
/// (`assign_offs`). This pass wraps each hit in `Double::to_float`, whose
/// lowering is `f32.demote_f64` + `f64.promote_f32` on every lane. Rounding
/// the exact f64 result of `+ - * /` on two f32 values gives the correctly
/// rounded f32 result: f64 has 53 >= 2 * 24 + 2 significand bits, so the
/// double rounding is innocuous for these four operations.
///
/// A binop the compiler synthesized (offset -1) is never a hit; the checker
/// files no row for one either. Negation needs no row: `-x` of an f32 value
/// is exactly an f32 value.
///
/// #3629: the same walk marks the operands of every `Double` / `Float`
/// operation the checker filed a float-operand row for
/// (`typed_float_operand_row_head`): `operand_offs` are binops keyed by their
/// operator offset, `operand_assign_offs` compound assignments keyed by their
/// target offset. See `fr_mark`. A statement holding no hit is left as it is:
/// the walk rebuilds every node it visits, and nearly every program has a
/// float operation somewhere, so rebuilding them all grew the self-compile's
/// heap by 11 MB.
export fn rewrite_float_arith_stmts(stmts: Array[Stmt], binop_offs: Array[Int], assign_offs: Array[Int], operand_offs: Array[Int], operand_assign_offs: Array[Int]) -> Unit {
  if Array::length(binop_offs) > 0 || Array::length(assign_offs) > 0 || Array::length(operand_offs) > 0 || Array::length(operand_assign_offs) > 0 {
    let mut i = 0
    while i < Array::length(stmts) {
      let stmt = Array::get(stmts, i)
      if fr_stmt_hits(stmt, binop_offs, assign_offs, operand_offs, operand_assign_offs) {
        Array::set(stmts, i, fr_stmt(stmt, binop_offs, assign_offs, operand_offs, operand_assign_offs))
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
}

fn fr_stmt_hits(stmt: Stmt, bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Bool {
  match stmt {
    SLet(_, _, _, _, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SLetMut(_, _, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    STest(_, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SBench(_, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SExample(_, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SExpr(expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SLetPat(_, expr) => fr_expr_hits(expr, bo, ao, fo, fa),
    SModule(_, _, _) => true,
    SFnDecl(_, _, expr, requires, ensures) => {
      let mut found = fr_expr_hits(expr, bo, ao, fo, fa)
      for e in requires {
        if !found && fr_expr_hits(e, bo, ao, fo, fa) {
          found = true
        }
      }
      for e in ensures {
        if !found && fr_expr_hits(e, bo, ao, fo, fa) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

/// Whether `e` holds a binop or compound assignment the rewrite changes.
/// Walks the shared child stack, so a statement with no hit allocates nothing.
fn fr_expr_hits(e: Expr, bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Bool {
  let here = match e {
    EBinOp(_, _, _, boff) => fr_has(bo, boff) || fr_has(fo, boff),
    EAssignOp(_, _, _, _, target_off) => fr_has(ao, target_off) || fr_has(fa, target_off),
    _ => false
  }
  if here {
    true
  } else {
    let mark = expr_children_push(e)
    let end = expr_children_top()
    let mut found = false
    let mut i = mark
    while i < end && !found {
      found = fr_expr_hits(expr_child_at(i), bo, ao, fo, fa)
      i = i + 1
    }
    expr_children_pop(mark)
    found
  }
}

/// #3543: the refusal a build lane WITHOUT typed rows gives a program that
/// can hold a `Float`. Since #3625 every build lane parses with offsets; what
/// remains rowless is a linked entry (`compile_file_wasi_linked_artifacts`,
/// or the `--debug` entry) that no import-resolving check answered for in
/// exactly the text it compiles. Its own check binds imported names to an
/// unknown type, so it cannot file the rows `rewrite_float_arith_stmts` keys
/// on, and a Float sum would be left as its f64 value -- silently not an f32.
/// A program that never spells `Float` (or `f32`), an `f` literal or a
/// `Float` conversion cannot hold one, so only those are refused, with the
/// edit.
export fn refuse_rowless_float_program(stmts: Array[Stmt]) -> Unit with Exception {
  if program_mentions_float(stmts) {
    throw("build without `--debug`: this linked build has no type check of the exact text it compiles, so it cannot round `Float` arithmetic to f32 (#3543); the default build, `vibe run` and `vibe test` can")
  } else {
    ()
  }
}

/// Whether `stmts` spell `Float` / `f32` in a type, an `f` literal, or a
/// call that produces or consumes a Float (`Double::to_float`,
/// `Int::to_float`, any `Float::*`).
export fn program_mentions_float(stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    found = fr_stmt_mentions(Array::get(stmts, i))
    i = i + 1
  }
  found
}

fn fr_stmt_mentions(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, ty, body) => fr_opt_ty(ty) || fr_expr_mentions(body),
    SLetMut(_, ty, body) => fr_opt_ty(ty) || fr_expr_mentions(body),
    SLetPat(_, body) => fr_expr_mentions(body),
    STest(_, body) => fr_expr_mentions(body),
    SBench(_, body) => fr_expr_mentions(body),
    SExample(_, body) => fr_expr_mentions(body),
    SExpr(body) => fr_expr_mentions(body),
    SFnDecl(_, _, body, _, _) => fr_expr_mentions(body),
    SStruct(_, _, fields, _, _, _) => {
      let mut found = false
      for f in fields {
        let (_, fty) = f
        if fr_ty(fty) {
          found = true
        }
      }
      found
    },
    SEnum(_, _, _, variants, _) => fr_variants(variants),
    SSuberror(_, _, variants) => fr_variants(variants),
    STypeAlias(_, _, _, ty) => fr_ty(ty),
    STrait(_, _, _, methods, _, _) => fr_sigs(methods),
    SEffectDef(_, _, _, ops) => fr_sigs(ops),
    SImpl(_, _, _, target) => fr_ty(target),
    SExternLet(_, ty) => fr_ty(ty),
    SModule(_, _, inner) => program_mentions_float(inner),
    _ => false
  }
}

fn fr_variants(variants: Array[(String, Array[TypeExpr])]) -> Bool {
  let mut found = false
  for v in variants {
    let (_, payload) = v
    if fr_tys(payload) {
      found = true
    }
  }
  found
}

fn fr_sigs(sigs: Array[(String, Array[TypeExpr], TypeExpr)]) -> Bool {
  let mut found = false
  for sg in sigs {
    let (_, params, ret) = sg
    if fr_tys(params) || fr_ty(ret) {
      found = true
    }
  }
  found
}

fn fr_opt_ty(ty: Option[TypeExpr]) -> Bool {
  match ty {
    Some(t) => fr_ty(t),
    None => false
  }
}

fn fr_tys(tys: Array[TypeExpr]) -> Bool {
  let mut found = false
  for t in tys {
    if fr_ty(t) {
      found = true
    }
  }
  found
}

fn fr_ty(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "Float" || n == "f32",
    TyApp(n, args) => n == "Float" || n == "f32" || fr_tys(args),
    TyFn(params, ret, _) => fr_tys(params) || fr_ty(ret),
    TyTuple(items) => fr_tys(items),
    TyUnit => false
  }
}

fn fr_expr_mentions(e: Expr) -> Bool {
  let here = match e {
    EIdent(name, _) => name == "Double::to_float" || name == "Int::to_float" || String::starts_with(name, "Float::"),
    EFn(_, _, params, ret, _, _) => {
      let mut found = fr_opt_ty(ret)
      for p in params {
        let (_, pty) = p
        if fr_opt_ty(pty) {
          found = true
        }
      }
      found
    },
    ERecord(_, _, targs) => fr_tys(targs),
    _ => false
  }
  if here {
    true
  } else {
    let mut found = false
    for c in expr_children(e) {
      if !found && fr_expr_mentions(c) {
        found = true
      }
    }
    found
  }
}

fn fr_has(offs: Array[Int], off: Int) -> Bool {
  if off < 0 {
    false
  } else {
    let mut found = false
    let mut i = 0
    while i < Array::length(offs) && !found {
      if Array::get(offs, i) == off {
        found = true
      } else {
        i = i + 1
      }
    }
    found
  }
}

fn fr_round(e: Expr) -> Expr {
  ECall(builtin_ref("Double::to_float"), [e], -1, [])
}

/// #3629: mark `e`, an operand of a `Double` / `Float` operation, as a float
/// for both lowerings. Code generation chooses float arithmetic from an
/// operand's syntax, and the desugar sends `+` / `<` on an operand it types
/// as a type formal -- which is what a generic call's result reads as -- to
/// the runtime Int/String dispatch: `pick(2.5) + 1.0` added the Double's box
/// as an Int. `Float::to_double` is the identity at code generation (a
/// `Float` already is the f64 of its value), the desugar types it `Double`,
/// and the float-operand readers look through it, so the mark costs no
/// instruction. A literal or a conversion is already a float to both, and a
/// nested arithmetic operator or negation is marked inside, so the lowering
/// still computes a chain on bits without boxing each step.
fn fr_mark(e: Expr) -> Expr {
  match e {
    EFloat(_) => e,
    ECall(EIdent(f, _), _, _, _) => if f == "Float::to_double" || f == "Double::to_float" || f == "Int::to_double" || f == "Int::to_float" {
      e
    } else {
      fr_wrap_double(e)
    },
    EBinOp(op, l, r, boff) => if op == "+" || op == "-" || op == "*" || op == "/" {
      EBinOp(op, fr_mark(l), fr_mark(r), boff)
    } else {
      fr_wrap_double(e)
    },
    EUnaryOp(op, inner) => if op == "-" {
      EUnaryOp(op, fr_mark(inner))
    } else {
      fr_wrap_double(e)
    },
    _ => fr_wrap_double(e)
  }
}

fn fr_wrap_double(e: Expr) -> Expr {
  ECall(builtin_ref("Float::to_double"), [e], -1, [])
}

fn fr_stmt(stmt: Stmt, bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Stmt {
  match stmt {
    SLet(exported, recursive, name, annotation, expr) => SLet(exported, recursive, name, annotation, fr_expr(expr, bo, ao, fo, fa)),
    SLetMut(name, annotation, expr) => SLetMut(name, annotation, fr_expr(expr, bo, ao, fo, fa)),
    STest(name, expr) => STest(name, fr_expr(expr, bo, ao, fo, fa)),
    SBench(name, expr) => SBench(name, fr_expr(expr, bo, ao, fo, fa)),
    SExample(name, expr) => SExample(name, fr_expr(expr, bo, ao, fo, fa)),
    SExpr(expr) => SExpr(fr_expr(expr, bo, ao, fo, fa)),
    SLetPat(pattern, expr) => SLetPat(pattern, fr_expr(expr, bo, ao, fo, fa)),
    SModule(exported, name, inner) => {
      let copy = for s in inner {
        s
      }
      rewrite_float_arith_stmts(copy, bo, ao, fo, fa)
      SModule(exported, name, copy)
    },
    SFnDecl(exported, name, expr, requires, ensures) => SFnDecl(exported, name, fr_expr(expr, bo, ao, fo, fa), fr_exprs(requires, bo, ao, fo, fa), fr_exprs(ensures, bo, ao, fo, fa)),
    _ => stmt
  }
}

fn fr_exprs(items: Array[Expr], bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Array[Expr] {
  for it in items {
    fr_expr(it, bo, ao, fo, fa)
  }
}

fn fr_named(fields: Array[(String, Expr)], bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Array[(String, Expr)] {
  for fld in fields {
    let (n, v) = fld
    (n, fr_expr(v, bo, ao, fo, fa))
  }
}

fn fr_arms(arms: Array[(Pat, Expr)], bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, e) = a
    (p, fr_expr(e, bo, ao, fo, fa))
  }
}

fn fr_expr(expr: Expr, bo: Array[Int], ao: Array[Int], fo: Array[Int], fa: Array[Int]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EIdent(_, _) => expr,
    ETuple(items) => ETuple(fr_exprs(items, bo, ao, fo, fa)),
    EArray(items) => EArray(fr_exprs(items, bo, ao, fo, fa)),
    ERecord(rn, fields, targs) => ERecord(rn, fr_named(fields, bo, ao, fo, fa), targs),
    EIf(c, t, e) => EIf(fr_expr(c, bo, ao, fo, fa), fr_expr(t, bo, ao, fo, fa), fr_expr(e, bo, ao, fo, fa)),
    ELet(n, v, b, soff) => ELet(n, fr_expr(v, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa), soff),
    ELetRec(n, v, b) => ELetRec(n, fr_expr(v, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa)),
    ELetMut(n, v, b, soff) => ELetMut(n, fr_expr(v, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa), soff),
    EAssign(n, v, b, target_off) => EAssign(n, fr_expr(v, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa), target_off),
    EAssignOp(n, op, v, b, target_off) => {
      // #3629: a float compound assignment's value is marked, so the
      // lowering takes its float path whatever the value's syntax.
      let rv = if fr_has(fa, target_off) {
        fr_mark(fr_expr(v, bo, ao, fo, fa))
      } else {
        fr_expr(v, bo, ao, fo, fa)
      }
      if fr_has(ao, target_off) {
        // `x op= v` is `x = x op v`, which is how every backend lowers it; the
        // sum is rounded before it is stored.
        let target = if fr_has(fa, target_off) {
          fr_mark(EIdent(n, -1))
        } else {
          EIdent(n, -1)
        }
        EAssign(n, fr_round(EBinOp(op, target, rv, -1)), fr_expr(b, bo, ao, fo, fa), target_off)
      } else {
        EAssignOp(n, op, rv, fr_expr(b, bo, ao, fo, fa), target_off)
      }
    },
    ESeq(a, b) => ESeq(fr_expr(a, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa)),
    EMatch(s, arms) => EMatch(fr_expr(s, bo, ao, fo, fa), fr_arms(arms, bo, ao, fo, fa)),
    EHandle(s, arms) => EHandle(fr_expr(s, bo, ao, fo, fa), fr_arms(arms, bo, ao, fo, fa)),
    EWhile(c, b) => EWhile(fr_expr(c, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa)),
    ELoop(params, b) => ELoop(fr_named(params, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa)),
    EForIn(n, idx, it, b) => EForIn(n, idx, fr_expr(it, bo, ao, fo, fa), fr_expr(b, bo, ao, fo, fa)),
    ECall(callee, args, off, callee_resolution) => ECall(fr_expr(callee, bo, ao, fo, fa), fr_exprs(args, bo, ao, fo, fa), off, callee_resolution),
    EBinOp(op, l, r, boff) => {
      let rl = fr_expr(l, bo, ao, fo, fa)
      let rr = fr_expr(r, bo, ao, fo, fa)
      let rebuilt = if fr_has(fo, boff) {
        EBinOp(op, fr_mark(rl), fr_mark(rr), boff)
      } else {
        EBinOp(op, rl, rr, boff)
      }
      if fr_has(bo, boff) {
        fr_round(rebuilt)
      } else {
        rebuilt
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, fr_expr(e, bo, ao, fo, fa)),
    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, fr_expr(body, bo, ao, fo, fa)),
    EDot(e, field, off, fdoff) => EDot(fr_expr(e, bo, ao, fo, fa), field, off, fdoff),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, fr_expr(v, bo, ao, fo, fa)),
    EReturn(e) => EReturn(fr_expr(e, bo, ao, fo, fa)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(fr_expr(v, bo, ao, fo, fa))),
      None => expr
    },
    EContinue(args) => EContinue(fr_exprs(args, bo, ao, fo, fa)),
    EMap(fields) => EMap(fr_named(fields, bo, ao, fo, fa)),
    ESpread(e) => ESpread(fr_expr(e, bo, ao, fo, fa)),
    EStringInterp(_) => expr
  }
}
