// Tuple shape encoding.

/// Is this shape entry itself a tuple (rather than a bare type name)? Such an
/// entry belongs in the binder's `tuple_shape_key` record, not in its type
/// slot -- a shape is not a type name and would resolve to nothing downstream.
export fn dtd_shape_is_tuple(_ sh: String) -> Bool {
  String::starts_with(sh, prefix = "(") && String::ends_with(sh, suffix = ")")
}

/// Comma-join shape parts back into the `tuple_shape_key` sentinel encoding.
/// A part that is itself composite is kept verbatim -- `tuple_shape_parts`
/// splits on top-level commas only, so a nested `(A,B)` round-trips.
export fn dtd_join_shape_parts(_ parts: Array[String]) -> String {
  let mut acc = ""
  let mut i = 0
  while i < Array::length(parts) {
    acc = if i == 0 {
      Array::get(parts, at = i)
    } else {
      String::concat(acc, String::concat(",", Array::get(parts, at = i)))
    }
    i = i + 1
  }
  acc
}
