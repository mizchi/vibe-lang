// Callable names.

export fn impl_target_fn_key(name: String) -> String {
  String::concat("$impl_return$", name)
}

/// The reserved `var_types` key that carries a binding's complete type,
/// encoded with `impl_target_key`.
export fn impl_target_var_key(name: String) -> String {
  String::concat("$impl_target$", name)
}
