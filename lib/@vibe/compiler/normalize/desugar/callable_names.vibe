// Callable names.

import ./env_keys.vibe {
  impl_target_var_key_prefix
}

export fn impl_target_fn_key(_ name: String) -> String {
  String::concat("$impl_return$", name)
}

/// The reserved `var_types` key that carries a binding's complete type,
/// encoded with `impl_target_key`.
export fn impl_target_var_key(_ name: String) -> String {
  String::concat(impl_target_var_key_prefix(), name)
}
