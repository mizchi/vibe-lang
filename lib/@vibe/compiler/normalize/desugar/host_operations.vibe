// Host operations.

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  Type,
  TypeExpr,
  __to_string,
  canonical_builtin_name,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  has_standard_host_provider,
  lookup_registry_builtin,
  resolve_builtin,
  test_bench_default_effects
}

import @vibe/ast {
  builtin_ref, impl_target_key
}

import @vibe/parser {
  source_pat
}

import ./equality_aliases.vibe {
  eq_subst_ty
}

import ./inspect_rewrite.vibe {
  dinsp_fresh_name
}

import ./state.vibe {
  dhhc_forward_ops
}

import ./utilities.vibe {
  str_array_contains
}

//# #1962: the standard host provider at the entry boundary
//
// `perform Fs::Exists(p)` names the host OPERATION; `Fs::exists(p)` is the
// capability builtin that carries it out. A `handle` naming the operation
// intercepts the perform -- and, since #2918, a direct call lexically inside
// it -- which is what makes `@vibe/fs` a mockable wrapper. But nothing
// handled the operation when no user handler was installed: the entry row
// admits `Fs` (`is_entry_admitted_effect` -- "host-provider effects are
// supplied by the process host"), so the program checked clean, and at run
// time the perform unwound to the top as a raw `WebAssembly.Exception`.
// Measured on a stage1 from main at 0f0ba36:
//
//   fn reader() -> Bool with Fs { perform Fs::Exists("nope") }
//   fn main() -> Unit allows Console + Fs { println("before")
//                                           println("after \{reader()}") }
//   (the row was Stdout when this was measured; println requires Console)
//
//   before
//   [object WebAssembly.Exception]        (exit 1, "after" never printed)
//
// The process host IS the provider the policy promises, so the entry installs
// it: a tail-resumptive `handle` around the entry body whose arm for each
// operation resumes with the direct builtin --
// `Fs::Exists(a) => resume(Fs::exists(a))`. An inner user handler still wins,
// because it is nearer; the provider only answers what nothing else did.
//
// WHAT IT IS KEYED ON. Only operations the program actually PERFORMS get an
// arm, so a program with no host perform -- the compiler's own sources, and
// every program that calls the builtins directly -- is untouched: no new
// handle, no new host import, no evidence threading. And only operations the
// entry is GRANTED get one: `fn main` must name the effect (or the operation)
// in its `allows` row, and a `test` / `bench` block's ambient row is
// `test_bench_default_effects`, which carries every provider with CamelCase
// operations (`Fs`, `Env`, `Profiler`). An ungranted operation keeps today's
// behaviour rather than silently acquiring authority: the arm would be the
// only reference to that host import, so installing it would widen what the
// artifact can do.
//
// This runs AFTER `desugar_handled_host_calls`, so the provider's own direct
// calls are never rewritten into performs of the handler they belong to.

/// `(operation, arity)` for every host operation the program performs, and
/// separately for every one a `handle` arm names, each in first-seen order.
export fn ehp_collect_stmts(stmts: Array[Stmt], performed: Array[(String, Int)], handled: Array[(String, Int)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, _, _, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SLetMut(_, _, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SLetPat(_, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      STest(_, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SBench(_, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SExample(_, body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SExpr(body) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SFnDecl(_, _, body, _, _) => ehp_collect_expr(e = body, performed = performed, handled = handled),
      SModule(_, _, body) => ehp_collect_stmts(stmts = body, performed = performed, handled = handled),
      _ => ()
    }
    i = i + 1
  }
}

/// A host OPERATION spelling: a standard host provider's name that
/// `canonical_builtin_name` maps to a different (builtin) spelling. That is
/// exactly the CamelCase operations of `Fs` / `Env` / `Profiler`; a user
/// effect that happens to share a provider's name declares operations the
/// mapping does not know, and is left alone.
fn ehp_is_host_operation(_ name: String) -> Bool {
  String::index_of(name, needle = "::") > 0 && has_standard_host_provider(name) && canonical_builtin_name(name) != name
}

export fn ehp_effect_of(_ op: String) -> String {
  String::substring(op, start = 0, end = String::index_of(op, needle = "::"))
}

fn ehp_note(out: Array[(String, Int)], op: String, arity: Int) -> Unit {
  let mut i = 0
  let mut seen = false
  while i < Array::length(out) {
    if Array::get(out, at = i).0 == op {
      seen = true
    } else {
      ()
    }
    i = i + 1
  }
  if seen {
    ()
  } else {
    Array::push(out, value = (op, arity))
  }
}

fn ehp_collect_expr(e: Expr, performed: Array[(String, Int)], handled: Array[(String, Int)]) -> Unit {
  match e {
    ECall(EIdent(head, _), args, _, _) => {
      if head == "perform" && Array::length(args) == 1 {
        match Array::get(args, at = 0) {
          ECall(EIdent(op, _), op_args, _, _) => if ehp_is_host_operation(op) {
            ehp_note(out = performed, op = op, arity = Array::length(op_args))
          } else {
            ()
          },
          // The bare spelling of a zero-argument operation:
          // `perform Env::ArgsLen`, `perform Profiler::NowUs`.
          EIdent(op, _) => if ehp_is_host_operation(op) {
            ehp_note(out = performed, op = op, arity = 0)
          } else {
            ()
          },
          _ => ()
        }
      } else {
        ()
      }
      ehp_collect_children(e = e, performed = performed, handled = handled)
    },
    // The generic child walk does not descend into ARM bodies (see
    // `dhhc_expr_has_host_handler`), and an arm can perform too.
    EHandle(body, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        // Arm patterns carry a source-span wrapper (`source_pat`).
        match source_pat(Array::get(arms, at = i).0) {
          PCtor(op, binders) => if ehp_is_host_operation(op) {
            ehp_note(out = handled, op = op, arity = Array::length(binders))
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      ehp_collect_expr(e = body, performed = performed, handled = handled)
      ehp_collect_arms(arms = arms, performed = performed, handled = handled)
    },
    EMatch(scrut, arms) => {
      ehp_collect_expr(e = scrut, performed = performed, handled = handled)
      ehp_collect_arms(arms = arms, performed = performed, handled = handled)
    },
    _ => ehp_collect_children(e = e, performed = performed, handled = handled)
  }
}

fn ehp_collect_arms(arms: Array[(Pat, Expr)], performed: Array[(String, Int)], handled: Array[(String, Int)]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    ehp_collect_expr(e = Array::get(arms, at = i).1, performed = performed, handled = handled)
    i = i + 1
  }
}

fn ehp_collect_children(e: Expr, performed: Array[(String, Int)], handled: Array[(String, Int)]) -> Unit {
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    ehp_collect_expr(e = expr_child_at(i), performed = performed, handled = handled)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// Does an `allows` row (comma-separated, as the parser stores it) grant
/// `op`? The effect itself (`Fs`), the operation (`Fs::Exists`) or its
/// capability spelling (`Fs::exists`) each do. An OPTIONAL label
/// (`Fs::exists?`) does not: whether it is granted is decided later, by the
/// optional-capability resolution, and the provider must not pre-empt it.
export fn ehp_row_grants(row: String, op: String) -> Bool {
  let effect = ehp_effect_of(op)
  let capability = canonical_builtin_name(op)
  let parts = String::split(row, sep = ",")
  let mut i = 0
  let mut found = false
  while i < Array::length(parts) {
    let label = String::trim(Array::get(parts, at = i))
    if label == effect || label == op || label == capability {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn ehp_test_grants(_ op: String) -> Bool {
  str_array_contains(arr = test_bench_default_effects(), val = ehp_effect_of(op))
}

/// The provider around `body`, or `body` itself when no performed operation
/// is granted. Each effect that gets arms is noted in `provided`.
///
/// ONE `handle` PER EFFECT, nested in first-seen order. A single handle whose
/// arms span two effects is not what the effect passes lower: measured on a
/// program performing both `Fs::Exists` and `Env::Get`, the combined handle
/// answered the `Fs` perform and left the `Env` one to fail, while either
/// effect alone passed.
export fn ehp_wrap(body: Expr, performed: Array[(String, Int)], granted: (String) -> Bool, provided: Array[String]) -> Expr {
  let order: Array[String] = []
  let mut i = 0
  while i < Array::length(performed) {
    let (op, _) = Array::get(performed, at = i)
    if granted(op) && !str_array_contains(arr = order, val = ehp_effect_of(op)) {
      Array::push(order, value = ehp_effect_of(op))
    } else {
      ()
    }
    i = i + 1
  }
  let mut out = body
  let mut ei = 0
  while ei < Array::length(order) {
    let effect = Array::get(order, at = ei)
    let arms: Array[(Pat, Expr)] = []
    let mut j = 0
    while j < Array::length(performed) {
      let (op, arity) = Array::get(performed, at = j)
      if ehp_effect_of(op) == effect && granted(op) {
        let binders: Array[Pat] = []
        let actuals: Array[Expr] = []
        let mut a = 0
        while a < arity {
          let pname = dinsp_fresh_name(base = String::concat("__host_arg", __to_string(a)), value = body, content = body)
          Array::push(binders, value = PBind(pname))
          Array::push(actuals, value = EIdent(pname, -1))
          a = a + 1
        }
        // #3185: the host builtin itself, whatever the program defines under its
        // spelling (a pure program `Fs::exists` must not answer a real perform).
        let direct = ECall(builtin_ref(canonical_builtin_name(op)), actuals, -1, [
        ])
        Array::push(arms, value = (PCtor(op, binders), ECall(EIdent("resume", -1), [
          direct
        ], -1, [])))
      } else {
        ()
      }
      j = j + 1
    }
    out = EHandle(out, arms)
    if !str_array_contains(arr = provided, val = effect) {
      Array::push(provided, value = effect)
    } else {
      ()
    }
    ei = ei + 1
  }
  out
}

/// The source spelling of a registry type, for the handful of types host
/// operations traffic in; `None` for anything else.
fn ehp_type_expr(_ t: Type) -> Option[TypeExpr] {
  match t {
    CtInt => Some(TyName("Int")),
    // #3730: rows describe the runtime value, which is an `Int`.
    CtInt32 => Some(TyName("Int")),
    CtUInt32 => Some(TyName("Int")),
    CtDouble => Some(TyName("Float64")),
    CtFloat => Some(TyName("Float32")),
    CtBool => Some(TyName("Bool")),
    CtString => Some(TyName("String")),
    CtUnit => Some(TyName("Unit")),
    CtBytes => Some(TyName("Bytes")),
    CtArray(el) => match ehp_type_expr(el) {
      Some(te) => Some(TyApp("Array", [te])),
      None => None
    },
    CtOption(el) => match ehp_type_expr(el) {
      Some(te) => Some(TyApp("Option", [te])),
      None => None
    },
    _ => None
  }
}

/// `(short op name, params, result)` read off the builtin registry row the
/// operation lowers to.
fn ehp_op_signature(_ op: String) -> Option[(String, Array[TypeExpr], TypeExpr)] {
  // `Fs::readdir` is typed by the checker and lowered by codegen as a special
  // case (a `String::split` over the raw host import), so the registry has no
  // row for it -- the only registered host operation without one, measured
  // over every CamelCase operation `canonical_builtin_name` knows. Without
  // this, `perform Fs::ReadDir(p)` got a provider arm but no declared slot
  // (Codex on #3059).
  if canonical_builtin_name(op) == "Fs::readdir" {
    return Some(("ReadDir", [TyName("String")], TyApp("Array", [
      TyName("String")
    ])))
  }
  match lookup_registry_builtin(canonical_builtin_name(op)) {
    Some(CtFn(params, ret, _)) => {
      let ptes: Array[TypeExpr] = []
      let mut ok = true
      let mut i = 0
      while i < Array::length(params) {
        match ehp_type_expr(Array::get(params, at = i)) {
          Some(te) => Array::push(ptes, value = te),
          None => {
            ok = false
          }
        }
        i = i + 1
      }
      match ehp_type_expr(ret) {
        Some(rte) => if ok {
          Some((String::substring(op, start = String::index_of(op, needle = "::") + 2, end = String::length(op)), ptes, rte))
        } else {
          None
        },
        None => None
      }
    },
    _ => None
  }
}

/// A host effect is a builtin: a program can perform `Fs::Exists` without
/// importing `@vibe/fs`, which is where `effect Fs { .. }` is declared. The
/// effect passes only lower a `handle` for an effect the program DECLARES --
/// for any other they refuse it, naming an unrelated call (`println`) -- so
/// the provider's own handle needs the declaration. Declare it from the
/// registry, with exactly the operations the program performs or handles.
export fn ehp_declare_missing_effects(stmts: Array[Stmt], effects: Array[String], performed: Array[(String, Int)], handled: Array[(String, Int)]) -> Unit {
  let mut ei = 0
  while ei < Array::length(effects) {
    let effect = Array::get(effects, at = ei)
    // The operations this program performs or handles, each once.
    let wanted: Array[(String, Array[TypeExpr], TypeExpr)] = []
    let names: Array[String] = []
    let mut pass = 0
    while pass < 2 {
      let src = if pass == 0 {
        performed
      } else {
        handled
      }
      let mut i = 0
      while i < Array::length(src) {
        let (op, _) = Array::get(src, at = i)
        if ehp_effect_of(op) == effect && !str_array_contains(arr = names, val = op) {
          match ehp_op_signature(op) {
            Some(sig) => {
              Array::push(names, value = op)
              Array::push(wanted, value = sig)
            },
            None => ()
          }
        } else {
          ()
        }
        i = i + 1
      }
      pass = pass + 1
    }
    let slots = ehp_effect_decl_indices(stmts = stmts, effect = effect)
    if Array::length(slots) == 0 {
      if Array::length(wanted) > 0 {
        let no_params: Array[String] = []
        Array::push(stmts, value = SEffectDef(false, effect, no_params, wanted))
      } else {
        ()
      }
    } else {
      // A declaration that omits an operation the provider now handles --
      // `@vibe/fs` declares four `Fs` operations, and a program may perform any
      // registered one (`Fs::Remove`). The evidence dictionary is built from
      // the declaration, so the missing operation would have no slot
      // (measured: `unknown struct field: Remove`). Append it to every
      // declaration of the effect, keeping the program's own operations and
      // their order.
      let mut si = 0
      while si < Array::length(slots) {
        let slot = Array::get(slots, at = si)
        match Array::get(stmts, at = slot) {
          SEffectDef(exported, name, tparams, ops) => {
            let merged: Array[(String, Array[TypeExpr], TypeExpr)] = []
            let mut k = 0
            while k < Array::length(ops) {
              Array::push(merged, value = Array::get(ops, at = k))
              k = k + 1
            }
            let mut w = 0
            while w < Array::length(wanted) {
              let (short, _, _) = Array::get(wanted, at = w)
              let mut present = false
              let mut j = 0
              while j < Array::length(ops) {
                let (have, _, _) = Array::get(ops, at = j)
                if have == short {
                  present = true
                } else {
                  ()
                }
                j = j + 1
              }
              if !present {
                Array::push(merged, value = Array::get(wanted, at = w))
                let (_, added_params, _) = Array::get(wanted, at = w)
                let qualified = String::concat(String::concat(effect, "::"), short)
                let mut known = false
                let mut q = 0
                while q < Array::length(dhhc_forward_ops) {
                  if Array::get(dhhc_forward_ops, at = q).0 == qualified {
                    known = true
                  } else {
                    ()
                  }
                  q = q + 1
                }
                if !known {
                  Array::push(dhhc_forward_ops, value = (qualified, Array::length(added_params)))
                } else {
                  ()
                }
              } else {
                ()
              }
              w = w + 1
            }
            Array::set(stmts, at = slot, value = SEffectDef(exported, name, tparams, merged))
          },
          _ => ()
        }
        si = si + 1
      }
    }
    ei = ei + 1
  }
}

/// The indices of every top-level declaration of `effect`.
/// Does a declaration in the program give `op` a signature other than the
/// host's (`effect Fs { Exists(Int, Int) -> Bool }`)? Such an operation is the
/// program's own, whatever its spelling: the provider must not answer it with
/// the builtin, and a direct builtin call must not be rewritten into it --
/// both run after checking, so the mismatched call would never be type
/// checked (Codex on #3059).
export fn ehp_declared_incompatibly(stmts: Array[Stmt], op: String) -> Bool {
  let effect = ehp_effect_of(op)
  let short = String::substring(op, start = String::index_of(op, needle = "::") + 2, end = String::length(op))
  let host = ehp_op_signature(op)
  let mut bad = false
  let slots = ehp_effect_decl_indices(stmts = stmts, effect = effect)
  let mut si = 0
  while si < Array::length(slots) {
    match Array::get(stmts, at = Array::get(slots, at = si)) {
      SEffectDef(_, _, _, ops) => {
        let mut k = 0
        while k < Array::length(ops) {
          let (name, params, ret) = Array::get(ops, at = k)
          if name == short {
            let same = match host {
              Some((_, hparams, hret)) => Array::length(hparams) == Array::length(params) && ehp_type_key(stmts = stmts, ty = hret) == ehp_type_key(stmts = stmts, ty = ret) && {
                let mut eq = true
                let mut j = 0
                while j < Array::length(params) {
                  if ehp_type_key(stmts = stmts, ty = Array::get(params, at = j)) != ehp_type_key(stmts = stmts, ty = Array::get(hparams, at = j)) {
                    eq = false
                  } else {
                    ()
                  }
                  j = j + 1
                }
                eq
              },
              None => false
            }
            if !same {
              bad = true
            } else {
              ()
            }
          } else {
            ()
          }
          k = k + 1
        }
      },
      _ => ()
    }
    si = si + 1
  }
  bad
}

/// `impl_target_key` of `ty` with the program's type aliases expanded, so a
/// transparent `type Path = String` in a host operation's declaration still
/// matches the host's `String` (Codex on #3059).
fn ehp_type_key(stmts: Array[Stmt], ty: TypeExpr) -> String {
  impl_target_key(ehp_expand_aliases(stmts = stmts, ty = ty, fuel = 32))
}

fn ehp_expand_aliases(stmts: Array[Stmt], ty: TypeExpr, fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    ty
  } else {
    match ty {
      // A builtin has several spellings the checker resolves to one type
      // (`()` / `Unit`, `i32` / `Int`, `Float` / `Double`), so each is
      // compared under the registry's spelling (Codex on #3059).
      TyName(name) => match ehp_find_alias(stmts = stmts, name = name, arity = 0) {
        Some((_, target)) => ehp_expand_aliases(stmts = stmts, ty = target, fuel = fuel - 1),
        None => match resolve_builtin(name) {
          Some(t) => match ehp_type_expr(t) {
            Some(canonical) => canonical,
            None => ty
          },
          None => ty
        }
      },
      TyApp(head, args) => {
        let expanded = for arg in args {
          ehp_expand_aliases(stmts = stmts, ty = arg, fuel = fuel - 1)
        }
        match ehp_find_alias(stmts = stmts, name = head, arity = Array::length(args)) {
          Some((formals, target)) => ehp_expand_aliases(stmts = stmts, ty = eq_subst_ty(ty = target, params = formals, args = expanded), fuel = fuel - 1),
          None => TyApp(head, expanded)
        }
      },
      TyFn(params, result, row) => TyFn(for param in params {
        ehp_expand_aliases(stmts = stmts, ty = param, fuel = fuel - 1)
      }, ehp_expand_aliases(stmts = stmts, ty = result, fuel = fuel - 1), row),
      TyTuple(items) => TyTuple(for item in items {
        ehp_expand_aliases(stmts = stmts, ty = item, fuel = fuel - 1)
      }),
      TyUnit => TyName("Unit")
    }
  }
}

fn ehp_find_alias(stmts: Array[Stmt], name: String, arity: Int) -> Option[(Array[String], TypeExpr)] {
  let mut found: Option[(Array[String], TypeExpr)] = None
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STypeAlias(_, n, formals, target) => if n == name && Array::length(formals) == arity {
        found = Some((formals, target))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn ehp_effect_decl_indices(stmts: Array[Stmt], effect: String) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEffectDef(_, name, _, _) => if name == effect {
        Array::push(out, value = i)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Does the program perform, or handle, a host operation anywhere -- i.e. could
/// `wrap_entry_host_provider` change it? The module-split prelude asks this
/// before partitioning: the provider needs the WHOLE program's performs (an
/// entry's partition sees an imported helper only through its interface), so
/// such a program takes the whole-program prelude instead.
export fn program_performs_host_operation(_ stmts: Array[Stmt]) -> Bool {
  let performed: Array[(String, Int)] = []
  let handled: Array[(String, Int)] = []
  ehp_collect_stmts(stmts = stmts, performed = performed, handled = handled)
  // A handle naming a host operation counts too: the callee interception
  // (`intercept_handled_host_calls_everywhere`) rewrites direct calls in
  // OTHER modules into performs, so it must see the whole program.
  Array::length(performed) > 0 || Array::length(handled) > 0
}

//# #1962: a handler for a host operation sees the direct spelling in CALLEES
//
// `desugar_handled_host_calls` rewrites a direct `Fs::read_file(p)` into
// `perform Fs::ReadFile(p)` only where a `handle` naming the operation is
// LEXICALLY around it. A direct call in a function the handled body merely
// calls still reached the host, while a `perform` in that same position was
// intercepted -- the split this issue says must not be retained. Measured on
// a stage2 from main at 0f0ba36:
//
//   fn inner() -> String with Fs::read_file { Fs::read_file("data.txt") }
//   test { handle { inner() } with { Fs::ReadFile(_p) => resume("MOCKED") } }
//
//   actual: REAL   (the file's contents; the handler never ran)
//
// That rewrite could not be widened before the entry had a provider: an
// unhandled host perform threw, so turning every direct call into one would
// have broken every call site no handler covers. `wrap_entry_host_provider`
// removed that obstacle, and this pass is the rest of it.
//
// WHEN IT FIRES. Only for an operation some `handle` in the program names --
// a program that never handles a host operation (the compiler's own sources,
// and most programs) is untouched. And only when EVERY entry in the artifact
// is granted the operation, so the provider is guaranteed to catch whatever
// no user handler does; otherwise the direct spelling is left alone rather
// than turned into a perform nothing may handle.
//
// WHAT IT DOES. Every direct call of the operation becomes the perform --
// handler arm bodies included: an arm runs outside its own handler, so its
// perform reaches the next one out, which is exactly where the direct call
// was going. Every top-level function whose declared row names the operation
// (its capability spelling, its operation spelling) gains the effect itself,
// so evidence passing threads the handler down to it. The checker already
// required every function that reaches the call to carry that label, so the
// widened rows are exactly the call chain.
//
// It runs after checking: the rows it widens are the checked rows, and the
// checker keeps seeing the program as written.

export fn ihc_arm_ops_stmts(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let performed: Array[(String, Int)] = []
  let handled: Array[(String, Int)] = []
  ehp_collect_stmts(stmts = stmts, performed = performed, handled = handled)
  let mut i = 0
  while i < Array::length(handled) {
    Array::push(out, value = Array::get(handled, at = i).0)
    i = i + 1
  }
}

/// Is `op` granted at every entry this artifact has -- `entry_name`'s
/// function, and every `test` / `bench` block -- and are those ALL of its
/// entries?
///
/// The second half is what makes the rewrite sound. The provider is installed
/// only around those entries, so a direct call turned into a perform must be
/// unreachable from anywhere else. With no `entry_name` function
/// (`__no_entry__`), an exported declaration is an entry the host may call
/// directly, outside every provider, so the program is left alone. With no
/// entry at all, it is left alone too.
export fn ihc_granted_everywhere(stmts: Array[Stmt], entry_name: String, op: String) -> Bool {
  let mut ok = true
  let mut has_entry_fn = false
  let mut has_block = false
  let mut has_export = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, _, name, binding_ty, value) => {
        if exported {
          has_export = true
        } else {
          ()
        }
        match value {
          EFn(_, _, _, _, eff, _) => if name == entry_name {
            has_entry_fn = true
            let row = ehp_entry_row(stmts = stmts, ty = binding_ty, eff = eff)
            if !ehp_row_grants(row = row, op = op) {
              ok = false
            } else {
              ()
            }
          } else {
            ()
          },
          _ => ()
        }
      },
      // An exported module's exported functions are entries the host may
      // call too, outside every provider.
      SModule(true, _, _) => {
        has_export = true
      },
      STest(_, _) => {
        has_block = true
        if !ehp_test_grants(op) {
          ok = false
        } else {
          ()
        }
      },
      SBench(_, _) => {
        has_block = true
        if !ehp_test_grants(op) {
          ok = false
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  ok && (has_entry_fn || (has_block && !has_export))
}

/// `row` with `effect` appended when one of its labels names an operation in
/// `ops` (either spelling) and the effect itself is absent.
export fn ihc_widen_row(row: String, ops: Array[String]) -> String {
  let parts = String::split(row, sep = ",")
  let labels: Array[String] = []
  let mut i = 0
  while i < Array::length(parts) {
    Array::push(labels, value = String::trim(Array::get(parts, at = i)))
    i = i + 1
  }
  let mut out = row
  let mut j = 0
  while j < Array::length(ops) {
    let op = Array::get(ops, at = j)
    let effect = ehp_effect_of(op)
    let names_op = str_array_contains(arr = labels, val = op) || str_array_contains(arr = labels, val = canonical_builtin_name(op))
    if names_op && !str_array_contains(arr = labels, val = effect) {
      Array::push(labels, value = effect)
      out = if String::length(String::trim(out)) == 0 {
        effect
      } else {
        String::concat(out, String::concat(", ", effect))
      }
    } else {
      ()
    }
    j = j + 1
  }
  out
}

/// The entry's granted row: its `EFn` row joined with the row a binding
/// annotation carries (`let main: () -> Unit with Fs = () -> { .. }`). The
/// checker treats the annotation's row as the grant too (`fn_binding_effects`),
/// so reading only the `EFn` row left such an entry's performs unprovided
/// (Codex on #3059).
export fn ehp_entry_row(stmts: Array[Stmt], ty: Option[TypeExpr], eff: Option[String]) -> String {
  let own = match eff {
    Some(r) => r,
    None => ""
  }
  let annotated = match ty {
    Some(TyFn(_, _, Some(r))) => r,
    _ => ""
  }
  let row = if String::length(String::trim(annotated)) == 0 {
    own
  } else if String::length(String::trim(own)) == 0 {
    annotated
  } else {
    String::concat(own, String::concat(", ", annotated))
  }
  ehp_expand_effectsets(stmts = stmts, row = row)
}

/// `row` with every label that names an `effectset` replaced by its members,
/// transitively. The checker expands `allows AppCaps` the same way, so an
/// entry granted `Fs` through a set must get the provider an entry granted
/// `Fs` directly gets (Codex on #3059).
fn ehp_expand_effectsets(stmts: Array[Stmt], row: String) -> String {
  let pending: Array[String] = []
  let parts = String::split(row, sep = ",")
  let mut i = 0
  while i < Array::length(parts) {
    let label = String::trim(Array::get(parts, at = i))
    if String::length(label) > 0 {
      Array::push(pending, value = label)
    } else {
      ()
    }
    i = i + 1
  }
  let seen_sets: Array[String] = []
  let out: Array[String] = []
  let mut k = 0
  while k < Array::length(pending) {
    let label = Array::get(pending, at = k)
    let members = ehp_effectset_members(stmts = stmts, name = label)
    match members {
      Some(ms) => if !str_array_contains(arr = seen_sets, val = label) {
        Array::push(seen_sets, value = label)
        let mut m = 0
        while m < Array::length(ms) {
          Array::push(pending, value = String::trim(Array::get(ms, at = m)))
          m = m + 1
        }
      } else {
        ()
      },
      None => if !str_array_contains(arr = out, val = label) {
        Array::push(out, value = label)
      } else {
        ()
      }
    }
    k = k + 1
  }
  String::join(out, sep = ", ")
}

fn ehp_effectset_members(stmts: Array[Stmt], name: String) -> Option[Array[String]] {
  let mut found: Option[Array[String]] = None
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEffectSet(_, n, members) => if n == name {
        found = Some(members)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// True when no top-level function occupies `op`'s builtin name; notes the
/// operation as provided.
export fn ehp_unshadowed(fn_bound: Array[String], op: String, provided_ops: Array[String]) -> Bool {
  if str_array_contains(arr = fn_bound, val = canonical_builtin_name(op)) {
    false
  } else {
    if !str_array_contains(arr = provided_ops, val = op) {
      Array::push(provided_ops, value = op)
    } else {
      ()
    }
    true
  }
}

/// The builtin names of `performed` that a top-level binding occupies:
/// value aliases (`let Fs::exists = exists`) when `aliases`, other bindings
/// (a real `fn`) otherwise.
export fn ehp_bound_builtin_names(stmts: Array[Stmt], performed: Array[(String, Int)], aliases: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let (bound, is_alias) = match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EIdent(_, _)) => (name, true),
      SLet(_, _, name, _, _) => (name, false),
      SFnDecl(_, name, _, _, _) => (name, false),
      _ => ("", false)
    }
    if String::length(bound) > 0 && is_alias == aliases {
      let mut j = 0
      while j < Array::length(performed) {
        if canonical_builtin_name(Array::get(performed, at = j).0) == bound && !str_array_contains(arr = out, val = bound) {
          Array::push(out, value = bound)
        } else {
          ()
        }
        j = j + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
}

/// `@vibe/fs` binds `export let Fs::exists = exists` (#795) -- a VALUE ALIAS
/// occupying the builtin's name. `rewrite_top_level_fn_alias_refs` has
/// already retargeted every reference the source made to it, so the only
/// call still naming `Fs::exists` is the provider's own arm, and codegen
/// resolves a name to the first binding it finds: the alias, i.e. the
/// perform-based wrapper, called from inside its own provider. Measured:
/// `null function or function signature mismatch`. The alias is dead at this
/// point, so move it to a name nothing spells, and the arm reaches the
/// builtin. Executables do not export these bindings (measured: `_start main
/// memory __heap_ptr error __exception_throw_tag`), and a library build has no
/// entry for the provider to wrap.
export fn ehp_move_aside_aliases(stmts: Array[Stmt], provided_ops: Array[String]) -> Unit {
  let as_pairs: Array[(String, Int)] = []
  let mut k = 0
  while k < Array::length(provided_ops) {
    Array::push(as_pairs, value = (Array::get(provided_ops, at = k), 0))
    k = k + 1
  }
  let aliased: Array[String] = []
  ehp_bound_builtin_names(stmts = stmts, performed = as_pairs, aliases = true, out = aliased)
  if Array::length(aliased) == 0 {
    ()
  } else {
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, at = i) {
        SLet(e, r, name, t, EIdent(target, off)) => if str_array_contains(arr = aliased, val = name) {
          Array::set(stmts, at = i, value = SLet(e, r, String::concat("__host_provider_moved_alias$", name), t, EIdent(target, off)))
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
  }
}
