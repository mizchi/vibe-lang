description =
  #|@vibe/compiler/normalize — the `vibe normalize` canonicalizing source
deps = {
  @vibe/compiler/contract : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/compiler/syntax : 0.0.1
