//# `vibe normalize` engine (vertical slice, #594)
//#
//# A canonicalizing source transform built on the compiler's own AST. The first
//# slice implements the structural pipeline:
//#
//#   parse -> flatten modules (`module m { let f }` => `let m::f`)
//#         -> dead-code elimination from exported roots
//#         -> drop redundant aggregate `export { .. }` statements
//#         -> constant-fold, then normalize `recv.method(args)` to
//#            `Type::method(recv, args)` where locally recoverable (#1194,
//#            ADR-0081; see the section comment near normalize_dot_calls)
//#         -> categorize into Imports / Types / Functions / Tests sections
//#         -> render via the AST printer with section headers + blank lines
//#
//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,
//# inferred type annotations, decl-separator / labeled-arg quickfixes, and
//# semver dependency `latest` resolution.

//# Imports

import @vibe/compiler/contract {
  extract_require_pins
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/syntax {
  Token, lex, parse_program_preserving, print_stmt
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, dce_stmts, make_import_alias_rewriter
}

//# Module flattening

fn empty_stmts() -> Array[Stmt] {
  array_empty()
}

fn empty_strs() -> Array[String] {
  array_empty()
}

/// Prefix a binding name with the enclosing module path (`math` + `helper` =>
/// `math::helper`). Empty prefix leaves the name unchanged.
fn join_module_name(prefix: String, name: String) -> String {
  if prefix == "" {
    name
  } else {
    String::concat(prefix, String::concat("::", name))
  }
}

/// Alias map (short name -> `prefix::name`) for the value members of a module
/// body, so intra-module references can be qualified to match the renamed decls.
fn module_value_aliases(body: Array[Stmt], prefix: String, out: Array[(String, String)]) -> Int {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(_, _, name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SLetMut(name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SExternLet(name, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)
        0
      },
      _ => 0
    }
    i = i + 1
  }
  0
}

/// Flatten a (DCE'd) module body to top-level decls: rename each value binding to
/// `prefix::name` AND qualify intra-module value references in its body, so the
/// flattened source typechecks without the enclosing module scope (a sibling call
/// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).
fn flatten_module_body(body: Array[Stmt], prefix: String, rewrite_aliases: (Expr) -> Expr, out: Array[Stmt]) -> Int {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(exp, is_rec, name, ty, b) => {
        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_aliases(b)))
        0
      },
      SLetMut(name, ty, b) => {
        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_aliases(b)))
        0
      },
      SExternLet(name, ty) => {
        Array::push(out, SExternLet(join_module_name(prefix, name), ty))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), rewrite_aliases, out)
        0
      },
      other => {
        Array::push(out, other)
        0
      }
    }
    i = i + 1
  }
  0
}

fn is_module_stmt(stmt: Stmt) -> Bool {
  match stmt {
    SModule(_, _, _) => true,
    _ => false
  }
}

//# Exported roots for DCE

/// Roots for top-level DCE: exported value bindings, plus any already
/// module-qualified binding (a `m::f` name). Flattening renames a kept module
/// member to `m::f` while leaving its body referencing the short `f`, so a
/// second normalize pass must not drop those by name — keeping all `::` names
/// (module members are live by construction) makes normalize idempotent.
fn exported_value_names(stmts: Array[Stmt]) -> Array[String] {
  let roots = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, _, name, _, _) => if exp || String::contains(name, "::") {
        Array::push(roots, name)
      },
      // Preserved fn decl (ADR-0064 #727): same root rule as SLet.
      SFnDecl(exp, name, _, _, _) => if exp || String::contains(name, "::") {
        Array::push(roots, name)
      },
      SLetMut(name, _, _) => if String::contains(name, "::") {
        Array::push(roots, name)
      },
      // Aggregate `export { a, b }` also marks an exported API; without this a
      // file whose only export is `export { run }` would DCE everything away.
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(roots, Array::get(names, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  roots
}

/// Names that an aggregate `export { .. }` re-exports (the renderer drops the
/// `SExport` statement, so the underlying bindings must be promoted to keep the
/// public API).
fn aggregate_export_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SExport(exported) => {
        let mut j = 0
        while j < Array::length(exported) {
          Array::push(names, Array::get(exported, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  names
}

fn str_array_has(arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) && !found {
    if Array::get(arr, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn promote_aggregate_exports(stmts: Array[Stmt], agg: Array[String]) -> Array[Stmt] {
  let result = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let promoted = match stmt {
      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {
        SLet(true, is_rec, name, ty, body)
      } else {
        stmt
      },
      SFnDecl(exp, name, fn_value, reqs, enss) => if !exp && str_array_has(agg, name) {
        SFnDecl(true, name, fn_value, reqs, enss)
      } else {
        stmt
      },
      _ => stmt
    }
    Array::push(result, promoted)
    i = i + 1
  }
  result
}

//# Type-alias DCE: drop non-exported aliases whose name is never referenced.

fn collect_type_names_into(ty: TypeExpr, out: Array[String]) -> Int {
  match ty {
    TyName(n) => {
      Array::push(out, n)
      0
    },
    TyApp(n, args) => {
      Array::push(out, n)
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_type_names_into(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let _ = collect_type_names_into(Array::get(params, i), out)
        i = i + 1
      }
      let _ = collect_type_names_into(ret, out)
      0
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = collect_type_names_into(Array::get(items, i), out)
        i = i + 1
      }
      0
    },
    TyUnit => 0
  }
}

fn collect_opt_type_into(ty_opt: Option[TypeExpr], out: Array[String]) -> Int {
  match ty_opt {
    Some(ty) => collect_type_names_into(ty, out),
    None => 0
  }
}

/// Collect every type-name referenced by a statement.
fn collect_stmt_type_refs_into(stmt: Stmt, out: Array[String]) -> Int {
  match stmt {
    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),
    // Preserved fn decl: its types live on the EFn params/return (there is
    // no let-annotation), so collect them there — otherwise a type alias
    // referenced only by an fn signature would be dropped as unused.
    SFnDecl(_, _, fn_value, _, _) => match fn_value {
      EFn(_, _, params, ret_opt, _, _) => {
        let mut fpi = 0
        while fpi < Array::length(params) {
          let (_, pty) = Array::get(params, fpi)
          let _ = collect_opt_type_into(pty, out)
          fpi = fpi + 1
        }
        collect_opt_type_into(ret_opt, out)
      },
      _ => 0
    },
    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),
    SExternLet(_, ty) => collect_type_names_into(ty, out),
    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),
    SStruct(_, _, fields, _, _, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, i)
        let _ = collect_type_names_into(fty, out)
        i = i + 1
      }
      0
    },
    SEnum(_, _, _, ctors, _) => {
      let mut i = 0
      while i < Array::length(ctors) {
        let (_, args) = Array::get(ctors, i)
        let mut j = 0
        while j < Array::length(args) {
          let _ = collect_type_names_into(Array::get(args, j), out)
          j = j + 1
        }
        i = i + 1
      }
      0
    },
    SImpl(_, _, _, type_name) => {
      Array::push(out, type_name)
      0
    },
    _ => 0
  }
}

fn drop_unused_type_aliases(stmts: Array[Stmt]) -> Array[Stmt] {
  let referenced = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)
    i = i + 1
  }
  let result = empty_stmts()
  let mut k = 0
  while k < Array::length(stmts) {
    let stmt = Array::get(stmts, k)
    let keep = match stmt {
      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),
      _ => true
    }
    if keep {
      Array::push(result, stmt)
    }
    k = k + 1
  }
  result
}

//# Categorize + render

/// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,
/// 9 = drop (aggregate export / bare expression).
fn stmt_section(stmt: Stmt) -> Int {
  match stmt {
    SImport(_, _) => 0,
    SReExport(_, _) => 0,
    SAliasDecl(_, _) => 0,
    SEnum(_, _, _, _, _) => 1,
    SSuberror(_, _, _) => 1,
    SStruct(_, _, _, _, _, _) => 1,
    STypeAlias(_, _, _, _) => 1,
    STrait(_, _, _, _, _, _) => 1,
    SImpl(_, _, _, _) => 1,
    SEffectDef(_, _, _, _) => 1,
    SExternLet(_, _) => 1,
    // ADR-0075 Phase 2 (#1343): a declaration, so it sorts with the other
    // declarations rather than falling to the trailing section via `_`.
    SResource(_, _) => 1,
    SLet(_, _, _, _, _) => 2,
    SFnDecl(_, _, _, _, _) => 2,
    SLetMut(_, _, _) => 2,
    SLetPat(_, _) => 2,
    STest(_, _) => 3,
    SBench(_, _) => 3,
    SExport(_) => 9,
    SExpr(_) => 9,
    _ => 9
  }
}

fn section_header(section: Int) -> String {
  if section == 0 {
    "//# Imports"
  } else if section == 1 {
    "//# Types"
  } else if section == 2 {
    "//# Functions"
  } else {
    "//# Tests"
  }
}

/// Render all statements in one section (already filtered) joined by blank lines,
/// prefixed by the section header. Returns "" when the section is empty.
fn render_section(stmts: Array[Stmt], section: Int) -> String {
  let parts = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if stmt_section(stmt) == section {
      Array::push(parts, print_stmt(stmt))
    }
    i = i + 1
  }
  if Array::length(parts) == 0 {
    ""
  } else {
    let body = String::join(parts, "\n\n")
    String::concat(section_header(section), String::concat("\n\n", body))
  }
}

//# Lambda-annotation hoisting

fn normalize_empty_type_exprs() -> Array[TypeExpr] {
  array_empty()
}

fn all_params_typed(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(_) => 0,
      None => {
        ok = false
        0
      }
    }
    i = i + 1
  }
  ok
}

fn param_type_list(params: Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] {
  let out = normalize_empty_type_exprs()
  let mut i = 0
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(ty) => Array::push(out, ty),
      None => 0
    }
    i = i + 1
  }
  out
}

fn strip_param_types(params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    Array::push(out, (name, None))
    i = i + 1
  }
  out
}

/// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to
/// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter
/// types + return type into a `TyFn` let-annotation and strip them from the
/// lambda. Only when the let has no annotation yet, the value is a return-type
/// annotated lambda, and every parameter carries a type (full type recoverable).
fn hoist_lambda_let(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, value) => match ty {
      Some(_) => stmt,
      None => match value {
        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {
          None => stmt,
          // Skip generic lambdas: their `[T]` type params scope the lambda, not
          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =
          // [T](x) -> {...}` would leave `T` unbound in the annotation and the
          // normalized output would not compile.
          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {
            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))
          } else {
            stmt
          }
        },
        _ => stmt
      }
    },
    _ => stmt
  }
}

fn hoist_lambda_lets(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

//# Constant folding

/// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,
/// which are total and wrap identically at compile time and runtime (both use
/// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped
/// (a literal `x / 0` must keep trapping at runtime, not at fold time).
fn fold_int_binop(op: String, a: Int, b: Int) -> Option[Int] {
  if op == "+" {
    Some(a + b)
  } else if op == "-" {
    Some(a - b)
  } else if op == "*" {
    Some(a * b)
  } else {
    None
  }
}

fn fold_expr(expr: Expr) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      fold_expr(it)
    }),
    EArray(items) => EArray(for it in items {
      fold_expr(it)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, fold_expr(v))
    }, targs),
    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),
    ELet(n, v, b, soff) => ELet(n, fold_expr(v), fold_expr(b), soff),
    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),
    ELetMut(n, v, b, soff) => ELetMut(n, fold_expr(v), fold_expr(b), soff),
    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, fold_expr(v), fold_expr(b)),
    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),
    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, fold_expr(init))
    }, fold_expr(b)),
    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),
    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {
      fold_expr(a)
    }, off),
    EBinOp(op, l, r) => {
      let fl = fold_expr(l)
      let fr = fold_expr(r)
      match fl {
        EInt(a) => match fr {
          EInt(b) => match fold_int_binop(op, a, b) {
            Some(v) => EInt(v),
            None => EBinOp(op, fl, fr)
          },
          _ => EBinOp(op, fl, fr)
        },
        _ => EBinOp(op, fl, fr)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),
    EDot(e, field, off, fdoff) => EDot(fold_expr(e), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),
    EReturn(e) => EReturn(fold_expr(e)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(fold_expr(v))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      fold_expr(a)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, fold_expr(v))
    }),
    ESpread(e) => ESpread(fold_expr(e))
  }
}

/// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`
/// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it
/// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match
/// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a
/// binding the fresh owned heap value the scrutinee produces (`match foo() {
/// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.
///
/// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a
/// counter cell threaded through every recursive call). A single non-unique
/// name shared by every lift in a function is not just an RC-drop-scheduling
/// hazard (the original #708 fix) — when two lifts NEST (a match whose
/// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match
/// <call> { .. }`, which the parser also desugars through a match-over-a-
/// match), the OUTER lift's own body-compile resolves the identifier by
/// searching local slots most-recent-first. Since the INNER lift (compiled
/// while evaluating the outer lift's OWN value) pushes the identical name
/// *after* the outer one, that search finds the inner (already out-of-scope)
/// binding instead of the outer one it meant to reference — reading whatever
/// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it
/// were the outer's freshly-built tuple, and misinterpreting its raw memory
/// as tuple fields. This produced garbage values (not a crash) for a `let
/// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a
/// minimal repro and fixed by this uniqueness change (see #708 follow-up
/// investigation notes). Modeled on fold_expr's complete walk; only the
/// EMatch case differs. EHandle is left as-is (effect handlers are not the
/// same ownership shape). Pure rewrite (aside from the counter cell) —
/// applied to each function body before build_perceus_plan so the plan and
/// codegen agree; running it on the non-RC backend would be harmless but it is
/// gated at the call site to keep that backend byte-identical.
/// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,
/// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,
/// etc., and the Perceus plan itself) all key on the bare identifier NAME, not
/// binding identity. When an inner scope shadows an outer binding of the same
/// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding
/// a name the loop already loop-borrows), those name-keyed lookups cannot tell
/// the two `x`s apart -- an action meant for one binding can fire at the other's
/// site instead (spurious/missing rc_dup, premature/missing rc_drop).
///
/// Rather than retrofit every name-keyed consumer with binding identity (a
/// larger, more invasive change -- see #712), this eliminates the ambiguity at
/// the source: alpha-rename every binding that shadows an enclosing one to a
/// fresh, globally-unique name before the Perceus plan is built, so no two live
/// bindings in one function ever share a name. Modeled on lift_match_scrutinees
/// (#708) -- same shared-counter-cell technique for uniqueness, same complete
/// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with
/// their original name (so debugging/argument-inspection output is unaffected
/// outside the rare shadowing case). Pure rewrite.
///
/// Runs in BOTH lanes since the shadow-clobber fix: the bump backend never
/// restores `local_names` when an inner binding scope closes mid-function (a
/// match catch-all arm's binders, a block-valued `let`'s inner lets), so its
/// most-recent-first local resolution read a DEAD shadowing slot's value for
/// a later same-name reference — silently wrong, no diagnostic. With every
/// shadowing binding renamed, that stale entry can never capture a live name.
fn fresh_shadow_name(counter: Array[Int], name: String) -> String {
  let n = Array::get(counter, 0)
  Array::set(counter, 0, n + 1)
  String::concat(String::concat("__shadow_", __to_string(n)), String::concat("_", name))
}

/// Renamed reference for `name` under `env`, or `name` unchanged if it is not a
/// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.
fn uq_lookup(env: Map[String, String], name: String) -> String {
  if Map::has_key(env, name) {
    Map::get(env, name)
  } else {
    name
  }
}

/// #715: has `name` been bound ANYWHERE in this function already (including a
/// sibling scope that has since closed)? `seen` is a shared mutable array, one
/// per top-level function, appended by uq_bind_name's first-binder path.
fn uq_seen_contains(seen: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(seen) {
    if Array::get(seen, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Introduce binding `name` into `env`. If `name` is already tracked (bound by
/// an enclosing scope, shadowed or not), this occurrence shadows it: mint a
/// fresh unique name and map `name` to it for the extent of the inner scope.
///
/// #715: ALSO rename when `name` was bound anywhere EARLIER in this same
/// function, even in an already-closed sibling scope (two match arms both
/// declaring `let resolved = ...`). The Perceus plan's actions and codegen's
/// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,
/// name-keyed, whole-function lists, so two same-named sibling bindings
/// receive each other's planned dups/drops -- confirmed as the #715 checker
/// crash: check_expr declares `let resolved` in four sibling scopes; a
/// scope-end PaDrop planned for one fired at another whose reference had
/// already been consumed through resolve_tparams_in, freeing the block a
/// still-live tuple pointed at (use-after-free at the `pt` destructure dup).
///
/// Otherwise this is the first binder for `name` in this function; keep it
/// as-is but still record the identity mapping, so a DEEPER shadow of the same
/// name is detected against this occurrence.
fn uq_bind_name(name: String, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (String, Map[String, String]) {
  // A labeled/optional param (`a~`/`a?`) is declared with its suffix but its
  // body references use the STRIPPED name. Keep the declaration spelling, but
  // register that base name as occupied. Otherwise an inner heap-valued
  // `let a` is not alpha-renamed, and name-keyed RC epilogue bookkeeping can
  // mistake the local's retained drop for the borrowed parameter's drop.
  let nlen = String::length(name)
  let lastc = if nlen > 0 {
    String::char_code_at(name, nlen - 1)
  } else {
    0
  }
  if lastc == '~' || lastc == '?' {
    let base = name[0: nlen - 1]
    if !uq_seen_contains(seen, base) {
      Array::push(seen, base)
    } else {
      ()
    }
    (name, Map::set(env, base, base))
  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {
    let fresh = fresh_shadow_name(counter, name)
    (fresh, Map::set(env, name, fresh))
  } else {
    Array::push(seen, name)
    (name, Map::set(env, name, name))
  }
}

fn uq_pat_names(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        uq_pat_names(Array::get(args, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        uq_pat_names(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(l, _r) => uq_pat_names(l, out),
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        uq_pat_names(fp, out)
        i = i + 1
      }
    },
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PWild => ()
  }
}

fn uq_pat_rewrite(pat: Pat, env: Map[String, String]) -> Pat {
  match pat {
    PBind(name) => PBind(uq_lookup(env, name)),
    PCtor(name, args) => PCtor(name, for a in args {
      uq_pat_rewrite(a, env)
    }),
    PTuple(pats) => PTuple(for a in pats {
      uq_pat_rewrite(a, env)
    }),
    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),
    PStruct(name, fields) => PStruct(name, for f in fields {
      let (fname, fp) = f
      (fname, uq_pat_rewrite(fp, env))
    }),
    _ => pat
  }
}

/// Binds every name in `pat` (shadow-checked against `env`) and returns the
/// rewritten pattern together with the extended env for the pattern's own
/// scope (the arm body).
fn uq_bind_pat(pat: Pat, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (Pat, Map[String, String]) {
  let names: Array[String] = [
  ]
  uq_pat_names(pat, names)
  let mut env2 = env
  let mut i = 0
  while i < Array::length(names) {
    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)
    env2 = env3
    i = i + 1
  }
  (uq_pat_rewrite(pat, env2), env2)
}

export fn uniquify_shadowed_bindings(expr: Expr, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(name, off) => EIdent(uq_lookup(env, name), off),
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      uniquify_shadowed_bindings(it, env, counter, seen)
    }),
    EArray(items) => EArray(for it in items {
      uniquify_shadowed_bindings(it, env, counter, seen)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, uniquify_shadowed_bindings(v, env, counter, seen))
    }, targs),
    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),
    ELet(n, v, b, soff) => {
      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)
    },
    ELetRec(n, v, b) => {
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)
      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    ELetMut(n, v, b, soff) => {
      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)
    },
    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {
      let (p, e) = a
      let (p2, env2) = uq_bind_pat(p, env, counter, seen)
      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))
    }),
    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {
      let (p, e) = a
      let (p2, env2) = uq_bind_pat(p, env, counter, seen)
      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))
    }),
    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    ELoop(params, b) => {
      let mut env2 = env
      let zipped: Array[(String, Expr)] = [
      ]
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, init) = Array::get(params, pi)
        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)
        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)
        env2 = envN
        Array::push(zipped, (pn2, init2))
        pi = pi + 1
      }
      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    EForIn(n, idx, it, b) => {
      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      let (idx2, env3) = match idx {
        Some(iname) => {
          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)
          (Some(iname2), envI)
        },
        None => (None, env2)
      }
      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))
    },
    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {
      uniquify_shadowed_bindings(a, env, counter, seen)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),
    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),
    EFn(tp, bounds, params, ret, eff, body) => {
      let mut env2 = env
      let params2: Array[(String, Option[TypeExpr])] = [
      ]
      let mut fi = 0
      while fi < Array::length(params) {
        let (pn, pty) = Array::get(params, fi)
        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)
        env2 = envN
        Array::push(params2, (pn2, pty))
        fi = fi + 1
      }
      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))
    },
    EDot(e, field, off, fdoff) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),
    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      uniquify_shadowed_bindings(a, env, counter, seen)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, uniquify_shadowed_bindings(v, env, counter, seen))
    }),
    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))
  }
}

fn fresh_m_scrut_name(counter: Array[Int]) -> String {
  let n = Array::get(counter, 0)
  Array::set(counter, 0, n + 1)
  String::concat("__m_scrut_", __to_string(n))
}

export fn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      lift_match_scrutinees(it, counter)
    }),
    EArray(items) => EArray(for it in items {
      lift_match_scrutinees(it, counter)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, lift_match_scrutinees(v, counter))
    }, targs),
    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),
    ELet(n, v, b, soff) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),
    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    ELetMut(n, v, b, soff) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),
    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),
    EMatch(s, arms) => {
      let lifted_arms = for a in arms {
        let (p, e) = a
        (p, lift_match_scrutinees(e, counter))
      }
      let ls = lift_match_scrutinees(s, counter)
      match ls {
        EIdent(_, _) => EMatch(ls, lifted_arms),
        _ => {
          let fresh = fresh_m_scrut_name(counter)
          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms), -1)
        }
      }
    },
    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {
      let (p, e) = a
      (p, lift_match_scrutinees(e, counter))
    }),
    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, lift_match_scrutinees(init, counter))
    }, lift_match_scrutinees(b, counter)),
    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),
    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {
      lift_match_scrutinees(a, counter)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),
    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),
    EDot(e, field, off, fdoff) => EDot(lift_match_scrutinees(e, counter), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),
    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      lift_match_scrutinees(a, counter)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, lift_match_scrutinees(v, counter))
    }),
    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))
  }
}

fn fold_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),
    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, fold_expr(fn_value), reqs, enss),
    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),
    STest(n, body) => STest(n, fold_expr(body)),
    SBench(n, body) => SBench(n, fold_expr(body)),
    SExpr(e) => SExpr(fold_expr(e)),
    SLetPat(p, body) => SLetPat(p, fold_expr(body)),
    _ => stmt
  }
}

fn fold_stmts(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, fold_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

//# Literal type annotation

/// The type of a value binding whose initializer is a literal of an obvious
/// type. Only these self-evident cases are annotated; anything needing real
/// inference (a call result, an identifier, arithmetic over non-literals) is
/// left unannotated so normalize never asserts a type it cannot prove.
fn literal_type(e: Expr) -> Option[TypeExpr] {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Double")),
    _ => None
  }
}

/// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.
/// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda
/// values are handled by hoisting, not here (a literal is never an `EFn`).
fn annotate_literal_let(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => match ty {
      Some(_) => stmt,
      None => match literal_type(body) {
        Some(t) => SLet(exp, is_rec, name, Some(t), body),
        None => stmt
      }
    },
    _ => stmt
  }
}

fn annotate_literal_lets(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, annotate_literal_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

//# #1194 (ADR-0081): dot-call -> qualified-call normalization
//#
//# `recv.method(args)` normalizes to `Type::method(recv, args)` in the
//# rendered output when the receiver's type is recoverable from THIS FILE
//# alone (param annotations, `let x: T = ...`, or an immediate `T::ctor(..)`
//# call whose return type is declared here) and `Type::method` is declared
//# as a top-level fn in this file. Anything else -- including a receiver
//# whose type comes from an IMPORTED module rather than a local declaration
//# -- is left as dot form untouched; this pass never guesses (a false
//# rewrite would change runtime semantics, not just style). Mirrors (a
//# conservative subset of) the real dot-call resolution rule in
//# normalize/desugar_trait_dict.vibe's `ECall(EDot(...))` arm, kept
//# as an independent copy rather than a shared import: that pass runs on the
//# whole merged, post-import compile deep in the codegen pipeline (so it
//# sees cross-file declarations), while normalize is single-file and sits
//# BELOW codegen in the package layering (codegen calls INTO normalize for
//# lift_match_scrutinees/uniquify_shadowed_bindings, so the reverse import
//# would cycle). KNOWN LIMITATION: because of the single-file scope, a
//# receiver whose type is declared in a DIFFERENT file (the common case for
//# real library code) is never rewritten here -- this only covers a
//# struct/enum and its methods declared in the same file being normalized.
//# If desugar_trait_dict.vibe's resolution rule changes, check here too.

fn ndc_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let names = empty_strs()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, j)
          Array::push(names, fname)
          j = j + 1
        }
        Array::push(out, (sname, names))
      },
      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_strs())),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, members) = Array::get(struct_sets, i)
    if sname == name {
      found = str_array_has(members, member)
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

fn ndc_ret_name(ret: Option[TypeExpr]) -> String {
  match ret {
    Some(te) => match te {
      TyName(n) => n,
      TyApp(n, _) => n,
      _ => ""
    },
    None => ""
  }
}

/// Top-level fn name -> return-type head name, so a call to a locally
/// declared `T::ctor(..) -> T` seeds the caller's inferred receiver type.
/// Also maps each enum variant ctor to its enum name. Single-file scope
/// (see the section comment above).
fn ndc_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, _, ret, _, _) => Array::push(out, (fname, ndc_ret_name(ret))),
        _ => ()
      },
      SFnDecl(_, fname, body, _, _) => match body {
        EFn(_, _, _, ret, _, _) => Array::push(out, (fname, ndc_ret_name(ret))),
        _ => ()
      },
      SEnum(_, ename, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          Array::push(out, (vname, ename))
          vi = vi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fn_returns) {
    let (n, _) = Array::get(fn_returns, i)
    if n == fname {
      found = true
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  found
}

fn ndc_fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_returns) {
    let (n, rt) = Array::get(fn_returns, i)
    if n == fname {
      result = if String::length(rt) == 0 {
        None
      } else {
        Some(rt)
      }
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  result
}

fn ndc_lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {
  // Last match wins (a shadowing rebind appends a second entry for the same
  // name) -- same rule as desugar_trait_dict.vibe's lookup_var_type.
  let mut i = 0
  let mut result = None
  while i < Array::length(var_types) {
    let (vn, vt) = Array::get(var_types, i)
    if vn == name {
      result = Some(vt)
    } else {
      ()
    }
    i = i + 1
  }
  result
}

fn ndc_extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, Array::get(var_types, i))
        i = i + 1
      }
      Array::push(out, (name, tname))
      out
    },
    None => var_types
  }
}

fn ndc_seed_var_types(params: Array[(String, Option[TypeExpr])], base: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let mut b = 0
  while b < Array::length(base) {
    Array::push(out, Array::get(base, b))
    b = b + 1
  }
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    match ann {
      Some(TyName(tn)) => Array::push(out, (pname, tn)),
      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_field_sets_match(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(a) {
      if str_array_has(b, Array::get(a, i)) {
        i = i + 1
      } else {
        ok = false
        i = Array::length(a)
      }
    }
    ok
  }
}

/// Pared-down, conservative twin of desugar_trait_dict.vibe's
/// infer_arg_type_name -- covers literals, a var's recorded type, the bare
/// nullary `None` ctor (-> "Option"), a call whose callee is a known
/// top-level fn (`T::new()` -> its declared return type) or an ascribe-wrap
/// (a single-param lambda application -- the parse-time desugar of a local
/// `let x: T = e` annotation), and a record literal matched to a struct's
/// field set. Deliberately omits infer_arg_type_name's string-concat and
/// chained-`.method()`-result-type cases: skipping them only leaves MORE
/// dot-calls unrewritten, never produces a wrong rewrite.
fn ndc_infer_type_name(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match e {
    EInt(_) => Some("Int"),
    EBool(_) => Some("Bool"),
    EString(_) => Some("String"),
    EFloat(_) => Some("Double"),
    EArray(_) => Some("Array"),
    EMap(_) => Some("Map"),
    EIdent(name, _) => if name == "None" {
      Some("Option")
    } else {
      match ndc_lookup_var_type(var_types, name) {
        Some(t) => Some(t),
        None => ndc_fn_return_type(fn_returns, name)
      }
    },
    ECall(callee, _, _) => match callee {
      EIdent("Some", _) => Some("Option"),
      EIdent("Ok", _) => Some("Result"),
      EIdent("Err", _) => Some("Result"),
      EIdent(fname, _) => ndc_fn_return_type(fn_returns, fname),
      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {
        let (_, ann) = Array::get(params, 0)
        match ann {
          Some(TyName(n)) => Some(n),
          Some(TyApp(n, _)) => Some(n),
          _ => None
        }
      } else {
        None
      },
      _ => None
    },
    ERecord(_, fields, _) => {
      let names = empty_strs()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      let mut j = 0
      let mut result = None
      while j < Array::length(struct_sets) {
        let (sname, sfields) = Array::get(struct_sets, j)
        if ndc_field_sets_match(names, sfields) {
          result = Some(sname)
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      result
    },
    _ => None
  }
}

fn ndc_prepend(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// `Some("Type::method")` when the receiver's type is inferable, isn't a
/// same-named struct field on that type (a field-stored closure call keeps
/// dot form -- the field is the closer binding, mirrors
/// desugar_trait_dict.vibe's rule), and `Type::method` is declared as a
/// top-level fn in this file.
fn ndc_qualified_call(robj: Expr, method: String, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match ndc_infer_type_name(robj, struct_sets, var_types, fn_returns) {
    Some(tn) => {
      let qual = String::concat(tn, String::concat("::", method))
      let is_field = ndc_struct_set_member(struct_sets, tn, method)
      if !is_field && ndc_fn_exists(fn_returns, qual) {
        Some(qual)
      } else {
        None
      }
    },
    None => None
  }
}

fn normalize_dot_calls_expr(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns)
    }),
    EArray(items) => EArray(for it in items {
      normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))
    }, targs),
    EIf(c, t, el) => EIf(normalize_dot_calls_expr(c, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(t, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(el, struct_sets, var_types, fn_returns)),
    ELet(n, v, b, soff) => {
      let v2 = normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)
      let inferred = ndc_infer_type_name(v2, struct_sets, var_types, fn_returns)
      let var_types2 = ndc_extend_var_types(var_types, n, inferred)
      ELet(n, v2, normalize_dot_calls_expr(b, struct_sets, var_types2, fn_returns), soff)
    },
    ELetRec(n, v, b) => {
      let v2 = normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)
      let inferred = ndc_infer_type_name(v2, struct_sets, var_types, fn_returns)
      let var_types2 = ndc_extend_var_types(var_types, n, inferred)
      ELetRec(n, v2, normalize_dot_calls_expr(b, struct_sets, var_types2, fn_returns))
    },
    ELetMut(n, v, b, soff) => ELetMut(n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns), soff),
    EAssign(n, v, b) => EAssign(n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    ESeq(a, b) => ESeq(normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    EMatch(s, arms) => EMatch(normalize_dot_calls_expr(s, struct_sets, var_types, fn_returns), for a in arms {
      let (p, e2) = a
      (p, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))
    }),
    EHandle(s, arms) => EHandle(normalize_dot_calls_expr(s, struct_sets, var_types, fn_returns), for a in arms {
      let (p, e2) = a
      (p, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))
    }),
    EWhile(c, b) => EWhile(normalize_dot_calls_expr(c, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, normalize_dot_calls_expr(init, struct_sets, var_types, fn_returns))
    }, normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    EForIn(n, idx, it, b) => EForIn(n, idx, normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),
    ECall(callee, args, off) => {
      let rargs = for a in args {
        normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns)
      }
      match callee {
        EDot(obj, m, doff, fdoff) => {
          let robj = normalize_dot_calls_expr(obj, struct_sets, var_types, fn_returns)
          match ndc_qualified_call(robj, m, struct_sets, var_types, fn_returns) {
            Some(qual) => ECall(EIdent(qual, doff), ndc_prepend(robj, rargs), off),
            None => ECall(EDot(robj, m, doff, fdoff), rargs, off)
          }
        },
        _ => ECall(normalize_dot_calls_expr(callee, struct_sets, var_types, fn_returns), rargs, off)
      }
    },
    EBinOp(op, l, r) => EBinOp(op, normalize_dot_calls_expr(l, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(r, struct_sets, var_types, fn_returns)),
    EUnaryOp(op, e2) => EUnaryOp(op, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns)),
    EFn(tp, bounds, params, ret, eff, body) => {
      let var_types2 = ndc_seed_var_types(params, var_types)
      EFn(tp, bounds, params, ret, eff, normalize_dot_calls_expr(body, struct_sets, var_types2, fn_returns))
    },
    EDot(e2, field, off, fdoff) => EDot(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)),
    EReturn(e2) => EReturn(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))
    }),
    ESpread(e2) => ESpread(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))
  }
}

fn normalize_dot_calls_stmt(stmt: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),
    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, normalize_dot_calls_expr(fn_value, struct_sets, array_empty(), fn_returns), reqs, enss),
    SLetMut(name, ty, body) => SLetMut(name, ty, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),
    STest(n, body) => STest(n, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),
    SBench(n, body) => SBench(n, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),
    SExpr(e) => SExpr(normalize_dot_calls_expr(e, struct_sets, array_empty(), fn_returns)),
    SLetPat(p, body) => SLetPat(p, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),
    _ => stmt
  }
}

/// #1194 (ADR-0081) entry point: rewrite `recv.method(args)` to
/// `Type::method(recv, args)` wherever this file's own declarations make the
/// receiver's type and the method's existence recoverable. See the section
/// comment above for exactly what's covered and what's deliberately left
/// alone.
export fn normalize_dot_calls(stmts: Array[Stmt]) -> Array[Stmt] {
  let struct_sets = ndc_struct_field_sets(stmts)
  let fn_returns = ndc_fn_returns(stmts)
  for s in stmts {
    normalize_dot_calls_stmt(s, struct_sets, fn_returns)
  }
}

/// DCE is name-based, so it must run while module members still carry their
/// short names (a body says `helper()`, not `math::helper()`). We therefore DCE
/// each scope before flattening renames its bindings:
///   - top-level non-module decls are DCE'd against the exported top-level roots;
///   - each module body is DCE'd against its own exported members, then renamed.
export fn normalize_stmts(stmts: Array[Stmt]) -> Array[Stmt] {
  let nonmods = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if !is_module_stmt(stmt) {
      Array::push(nonmods, stmt)
    }
    i = i + 1
  }
  let result = empty_stmts()
  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))
  Array::push_all(result, live_top)
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SModule(_, name, body) => {
        let live_body = dce_stmts(body, exported_value_names(body))
        let aliases = array_empty()
        let _ = module_value_aliases(live_body, name, aliases)
        let _ = flatten_module_body(live_body, name, make_import_alias_rewriter(aliases), result)
        0
      },
      _ => 0
    }
    m = m + 1
  }
  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))
  hoist_lambda_lets(annotate_literal_lets(normalize_dot_calls(fold_stmts(drop_unused_type_aliases(promoted)))))
}

export fn normalize_source(src: String) -> String with Exception {
  // #730 (D-3): require pin lines are a leading directive, not statement
  // grammar — extract them, normalize the remainder, and re-emit them in
  // canonical single-space form above the output. Pin FILLING is the
  // Fs-mode wrapper's job (VIBE_FILL_PINS); this pure engine re-emits
  // pinned and unpinned lines as they are.
  let (req_pins, src_wo_requires) = extract_require_pins(src)
  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting
  // a #cfg-bearing source would silently delete the disabled code from the
  // re-printed output. Refuse instead.
  let toks_cfg = lex(src_wo_requires)
  let mut ci = 0
  while ci < Array::length(toks_cfg) {
    match Array::get(toks_cfg, ci) {
      THash => throw("cannot normalize a source containing #cfg directives"),
      _ => ()
    }
    ci = ci + 1
  }
  // #727 (ADR-0064): parse with the fn-PRESERVING entry so `fn` declarations
  // (and their where-contracts) survive as SFnDecl and re-print in fn form
  // instead of being rewritten to `let rec` + inlined asserts.
  let stmts = parse_program_preserving(toks_cfg)
  let kept = normalize_stmts(stmts)
  let sections = empty_strs()
  if Array::length(req_pins) > 0 {
    let req_lines = empty_strs()
    let mut ri = 0
    while ri < Array::length(req_pins) {
      let (rname, rver, rpin) = Array::get(req_pins, ri)
      if rpin == "" {
        Array::push(req_lines, "require \{rname} \{rver}")
      } else {
        Array::push(req_lines, "require \{rname} \{rver} = #\{rpin}")
      }
      ri = ri + 1
    }
    Array::push(sections, String::join(req_lines, "\n"))
  } else ()
  let mut s = 0
  while s <= 3 {
    let rendered = render_section(kept, s)
    if rendered != "" {
      Array::push(sections, rendered)
    }
    s = s + 1
  }
  String::concat(String::join(sections, "\n\n"), "\n")
}
