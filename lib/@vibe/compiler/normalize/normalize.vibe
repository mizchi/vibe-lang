//# `vibe normalize` engine (vertical slice, #594)
//#
//# A canonicalizing source transform built on the compiler's own AST. The first
//# slice implements the structural pipeline:
//#
//#   parse -> flatten modules (`module m { let f }` => `let m::f`)
//#         -> dead-code elimination from exported roots
//#         -> drop redundant aggregate `export { .. }` statements
//#         -> constant-fold, then normalize `recv.method(args)` to
//#            `Type::method(recv, args)` where locally recoverable (#1194,
//#            ADR-0081; see the section comment near normalize_dot_calls)
//#         -> categorize into Imports / Types / Functions / Tests sections
//#         -> render via the AST printer with section headers + blank lines
//#
//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,
//# inferred type annotations, decl-separator / labeled-arg quickfixes, and
//# semver dependency `latest` resolution.

//# Imports

import @vibe/compiler/contract {
  extract_require_pins
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/syntax {
  Token, lex, parse_program_preserving, print_stmt, register_block_rows
}

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  TypeExpr,
  dce_stmts,
  expr_any_node,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  make_import_alias_rewriter
}

//# Module flattening

fn empty_stmts() -> Array[Stmt] {
  array_empty()
}

fn empty_strs() -> Array[String] {
  array_empty()
}

/// Prefix a binding name with the enclosing module path (`math` + `helper` =>
/// `math::helper`). Empty prefix leaves the name unchanged.
fn join_module_name(prefix: String, name: String) -> String {
  if prefix == "" {
    name
  } else {
    String::concat(prefix, String::concat("::", name))
  }
}

/// Alias map (short name -> `prefix::name`) for the value members of a module
/// body, so intra-module references can be qualified to match the renamed decls.
fn module_value_aliases(body: Array[Stmt], prefix: String, out: Array[(String, String)]) -> Int {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, at = i) {
      SLet(_, _, name, _, _) => {
        Array::push(out, value = (name, join_module_name(prefix = prefix, name = name)))
        0
      },
      SLetMut(name, _, _) => {
        Array::push(out, value = (name, join_module_name(prefix = prefix, name = name)))
        0
      },
      SExternLet(name, _) => {
        Array::push(out, value = (name, join_module_name(prefix = prefix, name = name)))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = module_value_aliases(body = inner_body, prefix = join_module_name(prefix = prefix, name = inner), out = out)
        0
      },
      _ => 0
    }
    i = i + 1
  }
  0
}

/// Flatten a (DCE'd) module body to top-level decls: rename each value binding to
/// `prefix::name` AND qualify intra-module value references in its body, so the
/// flattened source typechecks without the enclosing module scope (a sibling call
/// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).
fn flatten_module_body(body: Array[Stmt], prefix: String, rewrite_aliases: (Expr) -> Expr, out: Array[Stmt]) -> Int {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, at = i) {
      SLet(exp, is_rec, name, ty, b) => {
        Array::push(out, value = SLet(exp, is_rec, join_module_name(prefix = prefix, name = name), ty, rewrite_aliases(b)))
        0
      },
      SLetMut(name, ty, b) => {
        Array::push(out, value = SLetMut(join_module_name(prefix = prefix, name = name), ty, rewrite_aliases(b)))
        0
      },
      SExternLet(name, ty) => {
        Array::push(out, value = SExternLet(join_module_name(prefix = prefix, name = name), ty))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = flatten_module_body(body = inner_body, prefix = join_module_name(prefix = prefix, name = inner), rewrite_aliases = rewrite_aliases, out = out)
        0
      },
      other => {
        Array::push(out, value = other)
        0
      }
    }
    i = i + 1
  }
  0
}

fn is_module_stmt(_ stmt: Stmt) -> Bool {
  match stmt {
    SModule(_, _, _) => true,
    _ => false
  }
}

//# Exported roots for DCE

/// Roots for top-level DCE: exported value bindings, plus any already
/// module-qualified binding (a `m::f` name). Flattening renames a kept module
/// member to `m::f` while leaving its body referencing the short `f`, so a
/// second normalize pass must not drop those by name — keeping all `::` names
/// (module members are live by construction) makes normalize idempotent.
fn exported_value_names(_ stmts: Array[Stmt]) -> Array[String] {
  let roots = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exp, _, name, _, _) => if exp || String::contains(name, needle = "::") {
        Array::push(roots, value = name)
      },
      // Preserved fn decl (ADR-0064 #727): same root rule as SLet.
      SFnDecl(exp, name, _, _, _) => if exp || String::contains(name, needle = "::") {
        Array::push(roots, value = name)
      },
      SLetMut(name, _, _) => if String::contains(name, needle = "::") {
        Array::push(roots, value = name)
      },
      // Aggregate `export { a, b }` also marks an exported API; without this a
      // file whose only export is `export { run }` would DCE everything away.
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(roots, value = Array::get(names, at = j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  roots
}

/// Names that an aggregate `export { .. }` re-exports (the renderer drops the
/// `SExport` statement, so the underlying bindings must be promoted to keep the
/// public API).
fn aggregate_export_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SExport(exported) => {
        let mut j = 0
        while j < Array::length(exported) {
          Array::push(names, value = Array::get(exported, at = j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  names
}

fn str_array_has(arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) && !found {
    if Array::get(arr, at = i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn promote_aggregate_exports(stmts: Array[Stmt], agg: Array[String]) -> Array[Stmt] {
  let result = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    let promoted = match stmt {
      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(arr = agg, target = name) {
        SLet(true, is_rec, name, ty, body)
      } else {
        stmt
      },
      SFnDecl(exp, name, fn_value, reqs, enss) => if !exp && str_array_has(arr = agg, target = name) {
        SFnDecl(true, name, fn_value, reqs, enss)
      } else {
        stmt
      },
      _ => stmt
    }
    Array::push(result, value = promoted)
    i = i + 1
  }
  result
}

//# Type-alias DCE: drop non-exported aliases whose name is never referenced.

fn collect_type_names_into(ty: TypeExpr, out: Array[String]) -> Int {
  match ty {
    TyName(n) => {
      Array::push(out, value = n)
      0
    },
    TyApp(n, args) => {
      Array::push(out, value = n)
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_type_names_into(ty = Array::get(args, at = i), out = out)
        i = i + 1
      }
      0
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let _ = collect_type_names_into(ty = Array::get(params, at = i), out = out)
        i = i + 1
      }
      let _ = collect_type_names_into(ty = ret, out = out)
      0
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = collect_type_names_into(ty = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    TyUnit => 0
  }
}

fn collect_opt_type_into(ty_opt: Option[TypeExpr], out: Array[String]) -> Int {
  match ty_opt {
    Some(ty) => collect_type_names_into(ty = ty, out = out),
    None => 0
  }
}

/// Collect every type-name referenced by a statement.
fn collect_stmt_type_refs_into(stmt: Stmt, out: Array[String]) -> Int {
  match stmt {
    SLet(_, _, _, ty, _) => collect_opt_type_into(ty_opt = ty, out = out),
    // Preserved fn decl: its types live on the EFn params/return (there is
    // no let-annotation), so collect them there — otherwise a type alias
    // referenced only by an fn signature would be dropped as unused.
    SFnDecl(_, _, fn_value, _, _) => match fn_value {
      EFn(_, _, params, ret_opt, _, _) => {
        let mut fpi = 0
        while fpi < Array::length(params) {
          let (_, pty) = Array::get(params, at = fpi)
          let _ = collect_opt_type_into(ty_opt = pty, out = out)
          fpi = fpi + 1
        }
        collect_opt_type_into(ty_opt = ret_opt, out = out)
      },
      _ => 0
    },
    SLetMut(_, ty, _) => collect_opt_type_into(ty_opt = ty, out = out),
    SExternLet(_, ty) => collect_type_names_into(ty = ty, out = out),
    STypeAlias(_, _, _, rhs) => collect_type_names_into(ty = rhs, out = out),
    SStruct(_, _, fields, _, _, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, at = i)
        let _ = collect_type_names_into(ty = fty, out = out)
        i = i + 1
      }
      0
    },
    SEnum(_, _, _, ctors, _) => {
      let mut i = 0
      while i < Array::length(ctors) {
        let (_, args) = Array::get(ctors, at = i)
        let mut j = 0
        while j < Array::length(args) {
          let _ = collect_type_names_into(ty = Array::get(args, at = j), out = out)
          j = j + 1
        }
        i = i + 1
      }
      0
    },
    SImpl(_, _, _, target) => collect_type_names_into(ty = target, out = out),
    _ => 0
  }
}

fn drop_unused_type_aliases(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let referenced = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let _ = collect_stmt_type_refs_into(stmt = Array::get(stmts, at = i), out = referenced)
    i = i + 1
  }
  let result = empty_stmts()
  let mut k = 0
  while k < Array::length(stmts) {
    let stmt = Array::get(stmts, at = k)
    let keep = match stmt {
      STypeAlias(exp, name, _, _) => exp || str_array_has(arr = referenced, target = name),
      _ => true
    }
    if keep {
      Array::push(result, value = stmt)
    }
    k = k + 1
  }
  result
}

//# Categorize + render

/// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,
/// 9 = drop (aggregate export / bare expression).
fn stmt_section(_ stmt: Stmt) -> Int {
  match stmt {
    SImport(_, _) => 0,
    SReExport(_, _) => 0,
    SAliasDecl(_, _) => 0,
    SEnum(_, _, _, _, _) => 1,
    SSuberror(_, _, _) => 1,
    SStruct(_, _, _, _, _, _) => 1,
    STypeAlias(_, _, _, _) => 1,
    STrait(_, _, _, _, _, _) => 1,
    SImpl(_, _, _, _) => 1,
    SEffectDef(_, _, _, _, _) => 1,
    SExternLet(_, _) => 1,
    // ADR-0075 Phase 2 (#1343): a declaration, so it sorts with the other
    // declarations rather than falling to the trailing section via `_`.
    SResource(_, _) => 1,
    SLet(_, _, _, _, _) => 2,
    SFnDecl(_, _, _, _, _) => 2,
    SLetMut(_, _, _) => 2,
    SLetPat(_, _) => 2,
    STest(_, _) => 3,
    SBench(_, _) => 3,
    // An example is a test that documents (#819); the preserving parse keeps
    // the node, and without a section it fell to `_` and vanished from the
    // normalized source (Codex review on PR #2653).
    SExample(_, _) => 3,
    SExport(_) => 9,
    SExpr(_) => 9,
    _ => 9
  }
}

fn section_header(_ section: Int) -> String {
  if section == 0 {
    "//# Imports"
  } else if section == 1 {
    "//# Types"
  } else if section == 2 {
    "//# Functions"
  } else {
    "//# Tests"
  }
}

/// Render all statements in one section (already filtered) joined by blank lines,
/// prefixed by the section header. Returns "" when the section is empty.
fn render_section(stmts: Array[Stmt], section: Int) -> String {
  let parts = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    if stmt_section(stmt) == section {
      Array::push(parts, value = print_stmt(stmt))
    }
    i = i + 1
  }
  if Array::length(parts) == 0 {
    ""
  } else {
    let body = String::join(parts, sep = "\n\n")
    String::concat(section_header(section), String::concat("\n\n", body))
  }
}

//# Lambda-annotation hoisting

fn normalize_empty_type_exprs() -> Array[TypeExpr] {
  array_empty()
}

fn all_params_typed(_ params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, at = i)
    match ty_opt {
      Some(_) => 0,
      None => {
        ok = false
        0
      }
    }
    i = i + 1
  }
  ok
}

fn param_type_list(_ params: Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] {
  let out = normalize_empty_type_exprs()
  let mut i = 0
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, at = i)
    match ty_opt {
      Some(ty) => Array::push(out, value = ty),
      None => 0
    }
    i = i + 1
  }
  out
}

fn strip_param_types(_ params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, at = i)
    Array::push(out, value = (name, None))
    i = i + 1
  }
  out
}

/// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to
/// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter
/// types + return type into a `TyFn` let-annotation and strip them from the
/// lambda. Only when the let has no annotation yet, the value is a return-type
/// annotated lambda, and every parameter carries a type (full type recoverable).
fn hoist_lambda_let(_ stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, value) => match ty {
      Some(_) => stmt,
      None => match value {
        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {
          None => stmt,
          // Skip generic lambdas: their `[T]` type params scope the lambda, not
          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =
          // [T](x) -> {...}` would leave `T` unbound in the annotation and the
          // normalized output would not compile.
          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {
            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))
          } else {
            stmt
          }
        },
        _ => stmt
      }
    },
    _ => stmt
  }
}

fn hoist_lambda_lets(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, value = hoist_lambda_let(Array::get(stmts, at = i)))
    i = i + 1
  }
  out
}

//# Constant folding

/// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,
/// which are total and wrap identically at compile time and runtime (both use
/// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped
/// (a literal `x / 0` must keep trapping at runtime, not at fold time).
fn fold_int_binop(op: String, a: Int, b: Int) -> Option[Int] {
  if op == "+" {
    Some(a + b)
  } else if op == "-" {
    Some(a - b)
  } else if op == "*" {
    Some(a * b)
  } else {
    None
  }
}

fn fold_expr(_ expr: Expr) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      fold_expr(it)
    }),
    EArray(items) => EArray(for it in items {
      fold_expr(it)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, fold_expr(v))
    }, targs),
    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),
    ELet(n, v, b, soff) => ELet(n, fold_expr(v), fold_expr(b), soff),
    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),
    ELetMut(n, v, b, soff) => ELetMut(n, fold_expr(v), fold_expr(b), soff),
    EAssign(n, v, b, target_off) => EAssign(n, fold_expr(v), fold_expr(b), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, fold_expr(v), fold_expr(b), target_off),
    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),
    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, fold_expr(init))
    }, fold_expr(b)),
    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),
    ECall(callee, args, off, callee_resolution) => ECall(fold_expr(callee), for a in args {
      fold_expr(a)
    }, off, callee_resolution),
    EBinOp(op, l, r, boff) => {
      let fl = fold_expr(l)
      let fr = fold_expr(r)
      match fl {
        EInt(a) => match fr {
          EInt(b) => match fold_int_binop(op = op, a = a, b = b) {
            Some(v) => EInt(v),
            None => EBinOp(op, fl, fr, boff)
          },
          _ => EBinOp(op, fl, fr, boff)
        },
        _ => EBinOp(op, fl, fr, boff)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),
    EDot(e, field, off, fdoff) => EDot(fold_expr(e), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),
    EReturn(e) => EReturn(fold_expr(e)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(fold_expr(v))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      fold_expr(a)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, fold_expr(v))
    }),
    ESpread(e) => ESpread(fold_expr(e))
  }
}

/// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`
/// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it
/// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match
/// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a
/// binding the fresh owned heap value the scrutinee produces (`match foo() {
/// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.
///
/// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a
/// counter cell threaded through every recursive call). A single non-unique
/// name shared by every lift in a function is not just an RC-drop-scheduling
/// hazard (the original #708 fix) — when two lifts NEST (a match whose
/// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match
/// <call> { .. }`, which the parser also desugars through a match-over-a-
/// match), the OUTER lift's own body-compile resolves the identifier by
/// searching local slots most-recent-first. Since the INNER lift (compiled
/// while evaluating the outer lift's OWN value) pushes the identical name
/// *after* the outer one, that search finds the inner (already out-of-scope)
/// binding instead of the outer one it meant to reference — reading whatever
/// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it
/// were the outer's freshly-built tuple, and misinterpreting its raw memory
/// as tuple fields. This produced garbage values (not a crash) for a `let
/// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a
/// minimal repro and fixed by this uniqueness change (see #708 follow-up
/// investigation notes). Modeled on fold_expr's complete walk; only the
/// EMatch case differs. EHandle is left as-is (effect handlers are not the
/// same ownership shape). Pure rewrite (aside from the counter cell) —
/// applied to each function body before build_perceus_plan so the plan and
/// codegen agree; running it on the non-RC backend would be harmless but it is
/// gated at the call site to keep that backend byte-identical.
/// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,
/// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,
/// etc., and the Perceus plan itself) all key on the bare identifier NAME, not
/// binding identity. When an inner scope shadows an outer binding of the same
/// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding
/// a name the loop already loop-borrows), those name-keyed lookups cannot tell
/// the two `x`s apart -- an action meant for one binding can fire at the other's
/// site instead (spurious/missing rc_dup, premature/missing rc_drop).
///
/// Rather than retrofit every name-keyed consumer with binding identity (a
/// larger, more invasive change -- see #712), this eliminates the ambiguity at
/// the source: alpha-rename every binding that shadows an enclosing one to a
/// fresh, globally-unique name before the Perceus plan is built, so no two live
/// bindings in one function ever share a name. Modeled on lift_match_scrutinees
/// (#708) -- same shared-counter-cell technique for uniqueness, same complete
/// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with
/// their original name (so debugging/argument-inspection output is unaffected
/// outside the rare shadowing case). Pure rewrite.
///
/// Runs in BOTH lanes since the shadow-clobber fix: the bump backend never
/// restores `local_names` when an inner binding scope closes mid-function (a
/// match catch-all arm's binders, a block-valued `let`'s inner lets), so its
/// most-recent-first local resolution read a DEAD shadowing slot's value for
/// a later same-name reference — silently wrong, no diagnostic. With every
/// shadowing binding renamed, that stale entry can never capture a live name.
struct UqEnv {
  names: Array[String];
  values: Array[String];
  source: Expr;
  reserved: Array[String];
  mut reserved_ready: Bool
}

fn uq_env_new(_ source: Expr) -> UqEnv {
  UqEnv::{
    names: array_empty(),
    values: array_empty(),
    source: source,
    reserved: array_empty(),
    reserved_ready: false
  }
}

fn uq_reserve_name(name: String, out: Array[String]) -> Unit {
  if String::starts_with(name, prefix = "__shadow_") {
    let n = String::length(name)
    let last = String::char_code_at(name, at = n - 1)
    Array::push(out, value = if last == '?' {
      name[0: n - 1]
    } else {
      name
    })
  } else {
    ()
  }
}

fn uq_reserve_patterns(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, at = i)
    uq_pat_names(pat = pat, out = out)
    i = i + 1
  }
}

/// Reserve source spellings before choosing the first generated name. Include
/// future/unused binders and free references: avoiding only names already seen
/// still lets a fresh local capture a later declaration or a global reference.
fn uq_reserve_source(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    EIdent(n, _) => uq_reserve_name(name = n, out = out),
    ELet(n, _, _, _) => uq_reserve_name(name = n, out = out),
    ELetMut(n, _, _, _) => uq_reserve_name(name = n, out = out),
    ELetRec(n, _, _) => uq_reserve_name(name = n, out = out),
    EAssign(n, _, _, _) => uq_reserve_name(name = n, out = out),
    EAssignOp(n, _, _, _, _) => uq_reserve_name(name = n, out = out),
    EFn(_, _, params, _, _, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (n, _) = Array::get(params, at = i)
        uq_reserve_name(name = n, out = out)
        i = i + 1
      }
    },
    ELoop(params, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (n, _) = Array::get(params, at = i)
        uq_reserve_name(name = n, out = out)
        i = i + 1
      }
    },
    EForIn(n, idx, _, _) => {
      uq_reserve_name(name = n, out = out)
      match idx {
        Some(n) => uq_reserve_name(name = n, out = out),
        None => ()
      }
    },
    EMatch(_, arms) => uq_reserve_patterns(arms = arms, out = out),
    EHandle(_, arms) => uq_reserve_patterns(arms = arms, out = out),
    _ => ()
  }
  let mark = expr_children_push(expr)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    uq_reserve_source(expr = expr_child_at(i), out = out)
    i = i + 1
  }
  expr_children_pop(mark)
}

fn fresh_shadow_name(counter: Array[Int], name: String, env: UqEnv, seen: Array[String]) -> String {
  // Most functions need no rename. Scan once, lazily, and retain only the
  // synthetic-looking names rather than growing another whole-function index.
  if !env.reserved_ready {
    uq_reserve_source(expr = env.source, out = env.reserved)
    let mut i = 0
    let mut w = 0
    while i < Array::length(env.reserved) {
      let n = Array::get(env.reserved, at = i)
      if String::starts_with(n, prefix = "__shadow_") {
        Array::set(env.reserved, at = w, value = n)
        w = w + 1
      } else {
        ()
      }
      i = i + 1
    }
    Array::truncate(env.reserved, length = w)
    env.reserved_ready = true
  } else {
    ()
  }
  let mut n = Array::get(counter, at = 0)
  let mut fresh = String::concat(String::concat("__shadow_", __to_string(n)), String::concat("_", name))
  while uq_seen_contains(seen = env.reserved, name = fresh) || uq_seen_contains(seen = seen, name = fresh) {
    n = n + 1
    fresh = String::concat(String::concat("__shadow_", __to_string(n)), String::concat("_", name))
  }
  Array::set(counter, at = 0, value = n + 1)
  Array::push(seen, value = fresh)
  fresh
}

fn uq_env_restore(env: UqEnv, mark: Int) -> Unit {
  Array::truncate(env.names, length = mark)
  Array::truncate(env.values, length = mark)
}

// #2386: how many renames the walk has made so far -- a reference or a binder
// that left the walk under a different name. An arm rebuilds its node only
// when the count moved while its children were walked, and hands back the node
// it was given otherwise (AST nodes are immutable). The count only grows, so a
// rename anywhere below an arm is seen by every arm above it.
let uq_marks: Array[Int] = [0]

fn uq_mark() -> Unit {
  Array::set(uq_marks, at = 0, value = Array::get(uq_marks, at = 0) + 1)
}

fn uq_marks_now() -> Int {
  Array::get(uq_marks, at = 0)
}

/// Classify a region for splitting one immediate store: 0 = no use of the
/// slot, 1 = used without further writes/captures, 2 = ineligible.
/// Decline every lambda here: a
/// closure created by the RHS can escape and observe the slot AFTER the store.
/// Shadowed writes also decline conservatively; the input is not renamed yet.
fn uq_rebind_region(expr: Expr, name: String) -> Int {
  let own = match expr {
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    EFn(_, _, _, _, _, _) => 2,
    EAssign(n, _, _, _) => if n == name {
      2
    } else {
      0
    },
    EAssignOp(n, _, _, _, _) => if n == name {
      2
    } else {
      0
    },
    _ => 0
  }
  if own == 2 {
    2
  } else {
    let mark = expr_children_push(expr)
    let end = expr_children_top()
    let mut i = mark
    let mut result = own
    while result < 2 && i < end {
      let child = uq_rebind_region(expr = expr_child_at(i), name = name)
      if child > result {
        result = child
      } else {
        ()
      }
      i = i + 1
    }
    expr_children_pop(mark)
    result
  }
}

fn uq_single_rebind(name: String, body: Expr) -> Bool {
  match body {
    // Only split when uses actually span the store. Besides avoiding needless
    // rewrites, this preserves the old slot's eager release on an overwrite
    // that never reads it.
    EAssign(n, value, rest, _) => n == name && uq_rebind_region(expr = value, name = name) == 1 && uq_rebind_region(expr = rest, name = name) == 1,
    _ => false
  }
}

/// Renamed reference for `name` under `env`, or `name` unchanged if it is not a
/// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.
fn uq_lookup(env: UqEnv, name: String) -> String {
  let mut i = Array::length(env.names) - 1
  let mut found = name
  let mut done = false
  while i >= 0 && !done {
    if Array::get(env.names, at = i) == name {
      found = Array::get(env.values, at = i)
      done = true
    } else {
      ()
    }
    i = i - 1
  }
  if String::equals(found, name) {
    ()
  } else {
    uq_mark()
  }
  found
}

fn uq_env_has(env: UqEnv, name: String) -> Bool {
  let mut i = Array::length(env.names) - 1
  let mut found = false
  while i >= 0 && !found {
    if Array::get(env.names, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i - 1
  }
  found
}

/// #715: has `name` been bound ANYWHERE in this function already (including a
/// sibling scope that has since closed)? `seen` is a shared mutable array, one
/// per top-level function, appended by uq_bind_name's first-binder path.
fn uq_seen_contains(seen: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(seen) {
    if Array::get(seen, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Introduce binding `name` into `env`. If `name` is already tracked (bound by
/// an enclosing scope, shadowed or not), this occurrence shadows it: mint a
/// fresh unique name and map `name` to it for the extent of the inner scope.
///
/// #715: ALSO rename when `name` was bound anywhere EARLIER in this same
/// function, even in an already-closed sibling scope (two match arms both
/// declaring `let resolved = ...`). The Perceus plan's actions and codegen's
/// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,
/// name-keyed, whole-function lists, so two same-named sibling bindings
/// receive each other's planned dups/drops -- confirmed as the #715 checker
/// crash: check_expr declares `let resolved` in four sibling scopes; a
/// scope-end PaDrop planned for one fired at another whose reference had
/// already been consumed through resolve_tparams_in, freeing the block a
/// still-live tuple pointed at (use-after-free at the `pt` destructure dup).
///
/// Otherwise this is the first binder for `name` in this function; keep it
/// as-is but still record the identity mapping, so a DEEPER shadow of the same
/// name is detected against this occurrence. Both cases are one question to
/// the seen index: a name bound by an enclosing scope is in it too (#2386).
fn uq_bind_name(name: String, env: UqEnv, counter: Array[Int], seen: Array[String]) -> String {
  // An optional param (`a?`) is declared with its suffix but its
  // body references use the STRIPPED name. Keep the declaration spelling, but
  // register that base name as occupied. Otherwise an inner heap-valued
  // `let a` is not alpha-renamed, and name-keyed RC epilogue bookkeeping can
  // mistake the local's retained drop for the borrowed parameter's drop.
  let nlen = String::length(name)
  let lastc = if nlen > 0 {
    String::char_code_at(name, at = nlen - 1)
  } else {
    0
  }
  if lastc == '?' {
    let base = name[0: nlen - 1]
    if !uq_seen_contains(seen = seen, name = base) {
      Array::push(seen, value = base)
    } else {
      ()
    }
    Array::push(env.names, value = base)
    Array::push(env.values, value = base)
    name
  } else if uq_env_has(env = env, name = name) || uq_seen_contains(seen = seen, name = name) {
    let fresh = fresh_shadow_name(counter = counter, name = name, env = env, seen = seen)
    Array::push(env.names, value = name)
    Array::push(env.values, value = fresh)
    uq_mark()
    fresh
  } else {
    Array::push(seen, value = name)
    Array::push(env.names, value = name)
    Array::push(env.values, value = name)
    name
  }
}

fn uq_pat_names(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, value = name),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        uq_pat_names(pat = Array::get(args, at = i), out = out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        uq_pat_names(pat = Array::get(pats, at = i), out = out)
        i = i + 1
      }
    },
    POr(l, _r) => uq_pat_names(pat = l, out = out),
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        uq_pat_names(pat = fp, out = out)
        i = i + 1
      }
    },
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PWild => ()
  }
}

/// The patterns of `pats` rewritten under `env`; the given array when no
/// pattern changed (#2386), a copy that shares the unchanged ones otherwise.
fn uq_pats_rewrite(pats: Array[Pat], env: UqEnv) -> Array[Pat] {
  let mut out = pats
  let mut copied = false
  let mut i = 0
  while i < Array::length(pats) {
    let before = uq_marks_now()
    let p2 = uq_pat_rewrite(pat = Array::get(pats, at = i), env = env)
    if uq_marks_now() == before {
      if copied {
        Array::push(out, value = Array::get(pats, at = i))
      } else {
        ()
      }
    } else {
      if copied {
        ()
      } else {
        out = Array::slice(pats, start = 0, end = i)
        copied = true
      }
      Array::push(out, value = p2)
    }
    i = i + 1
  }
  out
}

fn uq_pat_fields_rewrite(fields: Array[(String, Pat)], env: UqEnv) -> Array[(String, Pat)] {
  let mut out = fields
  let mut copied = false
  let mut i = 0
  while i < Array::length(fields) {
    let f = Array::get(fields, at = i)
    let (fname, fp) = f
    let before = uq_marks_now()
    let fp2 = uq_pat_rewrite(pat = fp, env = env)
    if uq_marks_now() == before {
      if copied {
        Array::push(out, value = f)
      } else {
        ()
      }
    } else {
      if copied {
        ()
      } else {
        out = Array::slice(fields, start = 0, end = i)
        copied = true
      }
      Array::push(out, value = (fname, fp2))
    }
    i = i + 1
  }
  out
}

fn uq_pat_rewrite(pat: Pat, env: UqEnv) -> Pat {
  match pat {
    PBind(name) => {
      let before = uq_marks_now()
      let n2 = uq_lookup(env = env, name = name)
      if uq_marks_now() == before {
        pat
      } else {
        PBind(n2)
      }
    },
    PCtor(name, args) => {
      let before = uq_marks_now()
      let args2 = uq_pats_rewrite(pats = args, env = env)
      if uq_marks_now() == before {
        pat
      } else {
        PCtor(name, args2)
      }
    },
    PTuple(pats) => {
      let before = uq_marks_now()
      let pats2 = uq_pats_rewrite(pats = pats, env = env)
      if uq_marks_now() == before {
        pat
      } else {
        PTuple(pats2)
      }
    },
    POr(l, r) => {
      let before = uq_marks_now()
      let l2 = uq_pat_rewrite(pat = l, env = env)
      let r2 = uq_pat_rewrite(pat = r, env = env)
      if uq_marks_now() == before {
        pat
      } else {
        POr(l2, r2)
      }
    },
    PStruct(name, fields) => {
      let before = uq_marks_now()
      let fields2 = uq_pat_fields_rewrite(fields = fields, env = env)
      if uq_marks_now() == before {
        pat
      } else {
        PStruct(name, fields2)
      }
    },
    _ => pat
  }
}

/// Binds every name in `pat` (shadow-checked against `env`) and returns the
/// rewritten pattern together with the extended env for the pattern's own
/// scope (the arm body).
fn uq_bind_pat(pat: Pat, env: UqEnv, counter: Array[Int], seen: Array[String]) -> Pat {
  let names: Array[String] = []
  uq_pat_names(pat = pat, out = names)
  let mut i = 0
  while i < Array::length(names) {
    let _ = uq_bind_name(name = Array::get(names, at = i), env = env, counter = counter, seen = seen)
    i = i + 1
  }
  uq_pat_rewrite(pat = pat, env = env)
}

/// `items` walked in order; the given array when no item changed (#2386), a
/// copy that shares the unchanged items otherwise.
fn uq_exprs(items: Array[Expr], env: UqEnv, counter: Array[Int], seen: Array[String]) -> Array[Expr] {
  let mut out = items
  let mut copied = false
  let mut i = 0
  while i < Array::length(items) {
    let before = uq_marks_now()
    let it2 = uniquify_shadowed_bindings(expr = Array::get(items, at = i), env = env, counter = counter, seen = seen)
    if uq_marks_now() == before {
      if copied {
        Array::push(out, value = Array::get(items, at = i))
      } else {
        ()
      }
    } else {
      if copied {
        ()
      } else {
        out = Array::slice(items, start = 0, end = i)
        copied = true
      }
      Array::push(out, value = it2)
    }
    i = i + 1
  }
  out
}

/// The `(pattern, body)` arms of a match or handle, each bound and walked in
/// its own scope as before; the given array when no arm changed.
fn uq_arms(arms: Array[(Pat, Expr)], env: UqEnv, counter: Array[Int], seen: Array[String]) -> Array[(Pat, Expr)] {
  let mut out = arms
  let mut copied = false
  let mut i = 0
  while i < Array::length(arms) {
    let a = Array::get(arms, at = i)
    let (p, e) = a
    let before = uq_marks_now()
    let mark = Array::length(env.names)
    let p2 = uq_bind_pat(pat = p, env = env, counter = counter, seen = seen)
    let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
    uq_env_restore(env = env, mark = mark)
    if uq_marks_now() == before {
      if copied {
        Array::push(out, value = a)
      } else {
        ()
      }
    } else {
      if copied {
        ()
      } else {
        out = Array::slice(arms, start = 0, end = i)
        copied = true
      }
      Array::push(out, value = (p2, e2))
    }
    i = i + 1
  }
  out
}

fn uniquify_shadowed_bindings(expr: Expr, env: UqEnv, counter: Array[Int], seen: Array[String]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(name, off) => {
      let before = uq_marks_now()
      let n2 = uq_lookup(env = env, name = name)
      if uq_marks_now() == before {
        expr
      } else {
        EIdent(n2, off)
      }
    },
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => {
      let before = uq_marks_now()
      let items2 = uq_exprs(items = items, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        ETuple(items2)
      }
    },
    EArray(items) => {
      let before = uq_marks_now()
      let items2 = uq_exprs(items = items, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EArray(items2)
      }
    },
    ERecord(rn, fields, targs) => {
      let before = uq_marks_now()
      let mut out = fields
      let mut copied = false
      let mut i = 0
      while i < Array::length(fields) {
        let f = Array::get(fields, at = i)
        let (n, v) = f
        let fb = uq_marks_now()
        let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
        if uq_marks_now() == fb {
          if copied {
            Array::push(out, value = f)
          } else {
            ()
          }
        } else {
          if copied {
            ()
          } else {
            out = Array::slice(fields, start = 0, end = i)
            copied = true
          }
          Array::push(out, value = (n, v2))
        }
        i = i + 1
      }
      if uq_marks_now() == before {
        expr
      } else {
        ERecord(rn, out, targs)
      }
    },
    EIf(c, t, e) => {
      let before = uq_marks_now()
      let c2 = uniquify_shadowed_bindings(expr = c, env = env, counter = counter, seen = seen)
      let t2 = uniquify_shadowed_bindings(expr = t, env = env, counter = counter, seen = seen)
      let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EIf(c2, t2, e2)
      }
    },
    ELet(n, v, b, soff) => {
      let before = uq_marks_now()
      let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
      let mark = Array::length(env.names)
      let n2 = uq_bind_name(name = n, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      uq_env_restore(env = env, mark = mark)
      if uq_marks_now() == before {
        expr
      } else {
        ELet(n2, v2, b2, soff)
      }
    },
    ELetRec(n, v, b) => {
      let before = uq_marks_now()
      let mark = Array::length(env.names)
      let n2 = uq_bind_name(name = n, env = env, counter = counter, seen = seen)
      let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      uq_env_restore(env = env, mark = mark)
      if uq_marks_now() == before {
        expr
      } else {
        ELetRec(n2, v2, b2)
      }
    },
    ELetMut(n, v, b, soff) => {
      // #2803: `let mut x = initial; x = replacement; rest` has two value
      // lifetimes. Naming them separately lets Perceus budget each one rather
      // than retaining `initial` for uses that actually consume `replacement`.
      // Reuse the ordinary let/shadow walk so the RHS still reads the old x,
      // the continuation reads the new x, and every parent sees the change.
      // Keep ELetMut's owning-initializer contract for BOTH slots. A plain let
      // may be a view; a wrapper that promotes its own local source has already
      // handed us an owned reference, which that view classification can lose.
      if uq_single_rebind(name = n, body = b) {
        match b {
          EAssign(_, replacement, rest, _) => {
            uq_mark()
            uniquify_shadowed_bindings(expr = ELetMut(n, v, ELetMut(n, replacement, rest, -1), soff), env = env, counter = counter, seen = seen)
          },
          _ => expr
        }
      } else {
        let before = uq_marks_now()
        let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
        let mark = Array::length(env.names)
        let n2 = uq_bind_name(name = n, env = env, counter = counter, seen = seen)
        let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
        uq_env_restore(env = env, mark = mark)
        if uq_marks_now() == before {
          expr
        } else {
          ELetMut(n2, v2, b2, soff)
        }
      }
    },
    EAssign(n, v, b, target_off) => {
      let before = uq_marks_now()
      let n2 = uq_lookup(env = env, name = n)
      let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EAssign(n2, v2, b2, target_off)
      }
    },
    EAssignOp(n, op, v, b, target_off) => {
      let before = uq_marks_now()
      let n2 = uq_lookup(env = env, name = n)
      let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EAssignOp(n2, op, v2, b2, target_off)
      }
    },
    ESeq(a, b) => {
      let before = uq_marks_now()
      let a2 = uniquify_shadowed_bindings(expr = a, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        ESeq(a2, b2)
      }
    },
    EMatch(s, arms) => {
      let before = uq_marks_now()
      let s2 = uniquify_shadowed_bindings(expr = s, env = env, counter = counter, seen = seen)
      let arms2 = uq_arms(arms = arms, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EMatch(s2, arms2)
      }
    },
    EHandle(s, arms) => {
      let before = uq_marks_now()
      let s2 = uniquify_shadowed_bindings(expr = s, env = env, counter = counter, seen = seen)
      let arms2 = uq_arms(arms = arms, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EHandle(s2, arms2)
      }
    },
    EWhile(c, b) => {
      let before = uq_marks_now()
      let c2 = uniquify_shadowed_bindings(expr = c, env = env, counter = counter, seen = seen)
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EWhile(c2, b2)
      }
    },
    ELoop(params, b) => {
      let before = uq_marks_now()
      let mark = Array::length(env.names)
      let initialized: Array[(String, Expr)] = []
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, init) = Array::get(params, at = pi)
        let init2 = uniquify_shadowed_bindings(expr = init, env = env, counter = counter, seen = seen)
        Array::push(initialized, value = (pn, init2))
        pi = pi + 1
      }
      let zipped: Array[(String, Expr)] = []
      pi = 0
      while pi < Array::length(initialized) {
        let (pn, init2) = Array::get(initialized, at = pi)
        let pn2 = uq_bind_name(name = pn, env = env, counter = counter, seen = seen)
        Array::push(zipped, value = (pn2, init2))
        pi = pi + 1
      }
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      uq_env_restore(env = env, mark = mark)
      if uq_marks_now() == before {
        expr
      } else {
        ELoop(zipped, b2)
      }
    },
    EForIn(n, idx, it, b) => {
      let before = uq_marks_now()
      let it2 = uniquify_shadowed_bindings(expr = it, env = env, counter = counter, seen = seen)
      let mark = Array::length(env.names)
      let n2 = uq_bind_name(name = n, env = env, counter = counter, seen = seen)
      let idx2 = match idx {
        Some(iname) => {
          Some(uq_bind_name(name = iname, env = env, counter = counter, seen = seen))
        },
        None => None
      }
      let b2 = uniquify_shadowed_bindings(expr = b, env = env, counter = counter, seen = seen)
      uq_env_restore(env = env, mark = mark)
      if uq_marks_now() == before {
        expr
      } else {
        EForIn(n2, idx2, it2, b2)
      }
    },
    ECall(callee, args, off, callee_resolution) => {
      let before = uq_marks_now()
      let callee2 = uniquify_shadowed_bindings(expr = callee, env = env, counter = counter, seen = seen)
      let args2 = uq_exprs(items = args, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        ECall(callee2, args2, off, callee_resolution)
      }
    },
    EBinOp(op, l, r, boff) => {
      let before = uq_marks_now()
      let l2 = uniquify_shadowed_bindings(expr = l, env = env, counter = counter, seen = seen)
      let r2 = uniquify_shadowed_bindings(expr = r, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EBinOp(op, l2, r2, boff)
      }
    },
    EUnaryOp(op, e) => {
      let before = uq_marks_now()
      let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EUnaryOp(op, e2)
      }
    },
    EFn(tp, bounds, params, ret, eff, body) => {
      let before = uq_marks_now()
      let mark = Array::length(env.names)
      let params2: Array[(String, Option[TypeExpr])] = []
      let mut fi = 0
      while fi < Array::length(params) {
        let (pn, pty) = Array::get(params, at = fi)
        let pn2 = uq_bind_name(name = pn, env = env, counter = counter, seen = seen)
        Array::push(params2, value = (pn2, pty))
        fi = fi + 1
      }
      let body2 = uniquify_shadowed_bindings(expr = body, env = env, counter = counter, seen = seen)
      uq_env_restore(env = env, mark = mark)
      if uq_marks_now() == before {
        expr
      } else {
        EFn(tp, bounds, params2, ret, eff, body2)
      }
    },
    EDot(e, field, off, fdoff) => {
      let before = uq_marks_now()
      let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EDot(e2, field, off, fdoff)
      }
    },
    ELabeledArg(label, modifier, v) => {
      let before = uq_marks_now()
      let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        ELabeledArg(label, modifier, v2)
      }
    },
    EReturn(e) => {
      let before = uq_marks_now()
      let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EReturn(e2)
      }
    },
    EBreak(opt) => match opt {
      Some(v) => {
        let before = uq_marks_now()
        let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
        if uq_marks_now() == before {
          expr
        } else {
          EBreak(Some(v2))
        }
      },
      None => expr
    },
    EContinue(args) => {
      let before = uq_marks_now()
      let args2 = uq_exprs(items = args, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        EContinue(args2)
      }
    },
    EMap(fields) => {
      let before = uq_marks_now()
      let mut out = fields
      let mut copied = false
      let mut i = 0
      while i < Array::length(fields) {
        let f = Array::get(fields, at = i)
        let (k, v) = f
        let fb = uq_marks_now()
        let v2 = uniquify_shadowed_bindings(expr = v, env = env, counter = counter, seen = seen)
        if uq_marks_now() == fb {
          if copied {
            Array::push(out, value = f)
          } else {
            ()
          }
        } else {
          if copied {
            ()
          } else {
            out = Array::slice(fields, start = 0, end = i)
            copied = true
          }
          Array::push(out, value = (k, v2))
        }
        i = i + 1
      }
      if uq_marks_now() == before {
        expr
      } else {
        EMap(out)
      }
    },
    ESpread(e) => {
      let before = uq_marks_now()
      let e2 = uniquify_shadowed_bindings(expr = e, env = env, counter = counter, seen = seen)
      if uq_marks_now() == before {
        expr
      } else {
        ESpread(e2)
      }
    }
  }
}

export fn uniquify_shadowed_bindings_fresh(expr: Expr, counter: Array[Int], seen: Array[String]) -> Expr {
  uniquify_shadowed_bindings(expr = expr, env = uq_env_new(expr), counter = counter, seen = seen)
}

fn fresh_m_scrut_name(_ counter: Array[Int]) -> String {
  let n = Array::get(counter, at = 0)
  Array::set(counter, at = 0, value = n + 1)
  String::concat("__m_scrut_", __to_string(n))
}

fn match_needs_scrutinee_lift(_ e: Expr) -> Bool {
  match e {
    EMatch(EIdent(_, _), _) => false,
    EMatch(_, _) => true,
    _ => false
  }
}

export fn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr {
  if expr_any_node(expr = expr, pred = match_needs_scrutinee_lift) {
    lift_match_scrutinees_impl(expr = expr, counter = counter)
  } else {
    expr
  }
}

fn lift_match_scrutinees_impl(expr: Expr, counter: Array[Int]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      lift_match_scrutinees_impl(expr = it, counter = counter)
    }),
    EArray(items) => EArray(for it in items {
      lift_match_scrutinees_impl(expr = it, counter = counter)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, lift_match_scrutinees_impl(expr = v, counter = counter))
    }, targs),
    EIf(c, t, e) => EIf(lift_match_scrutinees_impl(expr = c, counter = counter), lift_match_scrutinees_impl(expr = t, counter = counter), lift_match_scrutinees_impl(expr = e, counter = counter)),
    ELet(n, v, b, soff) => ELet(n, lift_match_scrutinees_impl(expr = v, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter), soff),
    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees_impl(expr = v, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter)),
    ELetMut(n, v, b, soff) => ELetMut(n, lift_match_scrutinees_impl(expr = v, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter), soff),
    EAssign(n, v, b, target_off) => EAssign(n, lift_match_scrutinees_impl(expr = v, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, lift_match_scrutinees_impl(expr = v, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter), target_off),
    ESeq(a, b) => ESeq(lift_match_scrutinees_impl(expr = a, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter)),
    EMatch(s, arms) => {
      let lifted_arms = for a in arms {
        let (p, e) = a
        (p, lift_match_scrutinees_impl(expr = e, counter = counter))
      }
      let ls = lift_match_scrutinees_impl(expr = s, counter = counter)
      match ls {
        EIdent(_, _) => EMatch(ls, lifted_arms),
        _ => {
          let fresh = fresh_m_scrut_name(counter)
          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms), -1)
        }
      }
    },
    EHandle(s, arms) => EHandle(lift_match_scrutinees_impl(expr = s, counter = counter), for a in arms {
      let (p, e) = a
      (p, lift_match_scrutinees_impl(expr = e, counter = counter))
    }),
    EWhile(c, b) => EWhile(lift_match_scrutinees_impl(expr = c, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, lift_match_scrutinees_impl(expr = init, counter = counter))
    }, lift_match_scrutinees_impl(expr = b, counter = counter)),
    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees_impl(expr = it, counter = counter), lift_match_scrutinees_impl(expr = b, counter = counter)),
    ECall(callee, args, off, callee_resolution) => ECall(lift_match_scrutinees_impl(expr = callee, counter = counter), for a in args {
      lift_match_scrutinees_impl(expr = a, counter = counter)
    }, off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, lift_match_scrutinees_impl(expr = l, counter = counter), lift_match_scrutinees_impl(expr = r, counter = counter), boff),
    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees_impl(expr = e, counter = counter)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees_impl(expr = body, counter = counter)),
    EDot(e, field, off, fdoff) => EDot(lift_match_scrutinees_impl(expr = e, counter = counter), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees_impl(expr = v, counter = counter)),
    EReturn(e) => EReturn(lift_match_scrutinees_impl(expr = e, counter = counter)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(lift_match_scrutinees_impl(expr = v, counter = counter))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      lift_match_scrutinees_impl(expr = a, counter = counter)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, lift_match_scrutinees_impl(expr = v, counter = counter))
    }),
    ESpread(e) => ESpread(lift_match_scrutinees_impl(expr = e, counter = counter))
  }
}

fn fold_stmt(_ stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),
    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, fold_expr(fn_value), reqs, enss),
    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),
    STest(n, body) => STest(n, fold_expr(body)),
    SBench(n, body) => SBench(n, fold_expr(body)),
    SExample(n, body) => SExample(n, fold_expr(body)),
    SExpr(e) => SExpr(fold_expr(e)),
    SLetPat(p, body) => SLetPat(p, fold_expr(body)),
    _ => stmt
  }
}

fn fold_stmts(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, value = fold_stmt(Array::get(stmts, at = i)))
    i = i + 1
  }
  out
}

//# Literal type annotation

/// The type of a value binding whose initializer is a literal of an obvious
/// type. Only these self-evident cases are annotated; anything needing real
/// inference (a call result, an identifier, arithmetic over non-literals) is
/// left unannotated so normalize never asserts a type it cannot prove.
fn literal_type(_ e: Expr) -> Option[TypeExpr] {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_, _) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Float64")),
    _ => None
  }
}

/// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.
/// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda
/// values are handled by hoisting, not here (a literal is never an `EFn`).
fn annotate_literal_let(_ stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => match ty {
      Some(_) => stmt,
      None => match literal_type(body) {
        Some(t) => SLet(exp, is_rec, name, Some(t), body),
        None => stmt
      }
    },
    _ => stmt
  }
}

fn annotate_literal_lets(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, value = annotate_literal_let(Array::get(stmts, at = i)))
    i = i + 1
  }
  out
}

//# #1194 (ADR-0081): dot-call -> qualified-call normalization
//#
//# `recv.method(args)` normalizes to `Type::method(recv, args)` in the
//# rendered output when the receiver's type is recoverable from THIS FILE
//# alone (param annotations, `let x: T = ...`, or an immediate `T::ctor(..)`
//# call whose return type is declared here) and `Type::method` is declared
//# as a top-level fn in this file. Anything else -- including a receiver
//# whose type comes from an IMPORTED module rather than a local declaration
//# -- is left as dot form untouched; this pass never guesses (a false
//# rewrite would change runtime semantics, not just style). Mirrors (a
//# conservative subset of) the real dot-call resolution rule in
//# normalize/desugar_trait_dict.vibe's `ECall(EDot(...))` arm, kept
//# as an independent copy rather than a shared import: that pass runs on the
//# whole merged, post-import compile deep in the codegen pipeline (so it
//# sees cross-file declarations), while normalize is single-file and sits
//# BELOW codegen in the package layering (codegen calls INTO normalize for
//# lift_match_scrutinees/uniquify_shadowed_bindings, so the reverse import
//# would cycle). KNOWN LIMITATION: because of the single-file scope, a
//# receiver whose type is declared in a DIFFERENT file (the common case for
//# real library code) is never rewritten here -- this only covers a
//# struct/enum and its methods declared in the same file being normalized.
//# If desugar_trait_dict.vibe's resolution rule changes, check here too.

fn ndc_struct_field_sets(_ stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, sname, fields, _, _, _) => {
        let names = empty_strs()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, at = j)
          Array::push(names, value = fname)
          j = j + 1
        }
        Array::push(out, value = (sname, names))
      },
      SEnum(_, ename, _, _, _) => Array::push(out, value = (ename, empty_strs())),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, members) = Array::get(struct_sets, at = i)
    if sname == name {
      found = str_array_has(arr = members, target = member)
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

fn ndc_ret_name(_ ret: Option[TypeExpr]) -> String {
  match ret {
    Some(te) => match te {
      TyName(n) => n,
      TyApp(n, _) => n,
      _ => ""
    },
    None => ""
  }
}

/// Top-level fn name -> return-type head name, so a call to a locally
/// declared `T::ctor(..) -> T` seeds the caller's inferred receiver type.
/// Also maps each enum variant ctor to its enum name. Single-file scope
/// (see the section comment above).
fn ndc_fn_returns(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, _, ret, _, _) => Array::push(out, value = (fname, ndc_ret_name(ret))),
        _ => ()
      },
      SFnDecl(_, fname, body, _, _) => match body {
        EFn(_, _, _, ret, _, _) => Array::push(out, value = (fname, ndc_ret_name(ret))),
        _ => ()
      },
      SEnum(_, ename, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = vi)
          Array::push(out, value = (vname, ename))
          vi = vi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fn_returns) {
    let (n, _) = Array::get(fn_returns, at = i)
    if n == fname {
      found = true
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  found
}

fn ndc_fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_returns) {
    let (n, rt) = Array::get(fn_returns, at = i)
    if n == fname {
      result = if String::length(rt) == 0 {
        None
      } else {
        Some(rt)
      }
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  result
}

fn ndc_lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {
  // Last match wins (a shadowing rebind appends a second entry for the same
  // name) -- same rule as desugar_trait_dict.vibe's lookup_var_type.
  let mut i = 0
  let mut result = None
  while i < Array::length(var_types) {
    let (vn, vt) = Array::get(var_types, at = i)
    if vn == name {
      result = Some(vt)
    } else {
      ()
    }
    i = i + 1
  }
  result
}

fn ndc_extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, value = Array::get(var_types, at = i))
        i = i + 1
      }
      Array::push(out, value = (name, tname))
      out
    },
    None => var_types
  }
}

fn ndc_seed_var_types(params: Array[(String, Option[TypeExpr])], base: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let mut b = 0
  while b < Array::length(base) {
    Array::push(out, value = Array::get(base, at = b))
    b = b + 1
  }
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, at = i)
    match ann {
      Some(TyName(tn)) => Array::push(out, value = (pname, tn)),
      Some(TyApp(tn, _)) => Array::push(out, value = (pname, tn)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn ndc_field_sets_match(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(a) {
      if str_array_has(arr = b, target = Array::get(a, at = i)) {
        i = i + 1
      } else {
        ok = false
        i = Array::length(a)
      }
    }
    ok
  }
}

/// Pared-down, conservative twin of desugar_trait_dict.vibe's
/// infer_arg_type_name -- covers literals, a var's recorded type, the bare
/// nullary `None` ctor (-> "Option"), a call whose callee is a known
/// top-level fn (`T::new()` -> its declared return type) or an ascribe-wrap
/// (a single-param lambda application -- the parse-time desugar of a local
/// `let x: T = e` annotation), and a record literal matched to a struct's
/// field set. Deliberately omits infer_arg_type_name's string-concat and
/// chained-`.method()`-result-type cases: skipping them only leaves MORE
/// dot-calls unrewritten, never produces a wrong rewrite.
fn ndc_infer_type_name(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match e {
    EInt(_) => Some("Int"),
    EBool(_) => Some("Bool"),
    EString(_, _) => Some("String"),
    EFloat(_) => Some("Float64"),
    EArray(_) => Some("Array"),
    EMap(_) => Some("Map"),
    EIdent(name, _) => if name == "None" {
      Some("Option")
    } else {
      match ndc_lookup_var_type(var_types = var_types, name = name) {
        Some(t) => Some(t),
        None => ndc_fn_return_type(fn_returns = fn_returns, fname = name)
      }
    },
    ECall(callee, _, _, _) => match callee {
      EIdent("Some", _) => Some("Option"),
      EIdent("Ok", _) => Some("Result"),
      EIdent("Err", _) => Some("Result"),
      EIdent(fname, _) => ndc_fn_return_type(fn_returns = fn_returns, fname = fname),
      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {
        let (_, ann) = Array::get(params, at = 0)
        match ann {
          Some(TyName(n)) => Some(n),
          Some(TyApp(n, _)) => Some(n),
          _ => None
        }
      } else {
        None
      },
      _ => None
    },
    ERecord(_, fields, _) => {
      let names = empty_strs()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, at = i)
        Array::push(names, value = fname)
        i = i + 1
      }
      let mut j = 0
      let mut result = None
      while j < Array::length(struct_sets) {
        let (sname, sfields) = Array::get(struct_sets, at = j)
        if ndc_field_sets_match(a = names, b = sfields) {
          result = Some(sname)
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      result
    },
    _ => None
  }
}

fn ndc_prepend(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, value = head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, value = Array::get(rest, at = i))
    i = i + 1
  }
  out
}

/// `Some("Type::method")` when the receiver's type is inferable, isn't a
/// same-named struct field on that type (a field-stored closure call keeps
/// dot form -- the field is the closer binding, mirrors
/// desugar_trait_dict.vibe's rule), and `Type::method` is declared as a
/// top-level fn in this file.
fn ndc_qualified_call(robj: Expr, method: String, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match ndc_infer_type_name(e = robj, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
    Some(tn) => {
      let qual = String::concat(tn, String::concat("::", method))
      let is_field = ndc_struct_set_member(struct_sets = struct_sets, name = tn, member = method)
      if !is_field && ndc_fn_exists(fn_returns = fn_returns, fname = qual) {
        Some(qual)
      } else {
        None
      }
    },
    None => None
  }
}

fn normalize_dot_calls_expr(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      normalize_dot_calls_expr(expr = it, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
    }),
    EArray(items) => EArray(for it in items {
      normalize_dot_calls_expr(expr = it, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (n, v) = f
      (n, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
    }, targs),
    EIf(c, t, el) => EIf(normalize_dot_calls_expr(expr = c, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = t, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = el, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    ELet(n, v, b, soff) => {
      let v2 = normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
      let inferred = ndc_infer_type_name(e = v2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
      let var_types2 = ndc_extend_var_types(var_types = var_types, name = n, inferred = inferred)
      ELet(n, v2, normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types2, fn_returns = fn_returns), soff)
    },
    ELetRec(n, v, b) => {
      let v2 = normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
      let inferred = ndc_infer_type_name(e = v2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
      let var_types2 = ndc_extend_var_types(var_types = var_types, name = n, inferred = inferred)
      ELetRec(n, v2, normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types2, fn_returns = fn_returns))
    },
    ELetMut(n, v, b, soff) => ELetMut(n, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), soff),
    EAssign(n, v, b, target_off) => EAssign(n, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), target_off),
    ESeq(a, b) => ESeq(normalize_dot_calls_expr(expr = a, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    EMatch(s, arms) => EMatch(normalize_dot_calls_expr(expr = s, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), for a in arms {
      let (p, e2) = a
      (p, normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
    }),
    EHandle(s, arms) => EHandle(normalize_dot_calls_expr(expr = s, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), for a in arms {
      let (p, e2) = a
      (p, normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
    }),
    EWhile(c, b) => EWhile(normalize_dot_calls_expr(expr = c, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, normalize_dot_calls_expr(expr = init, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
    }, normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    EForIn(n, idx, it, b) => EForIn(n, idx, normalize_dot_calls_expr(expr = it, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = b, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    ECall(callee, args, off, callee_resolution) => {
      let rargs = for a in args {
        normalize_dot_calls_expr(expr = a, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
      }
      match callee {
        EDot(obj, m, doff, fdoff) => {
          let robj = normalize_dot_calls_expr(expr = obj, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
          match ndc_qualified_call(robj = robj, method = m, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns) {
            Some(qual) => ECall(EIdent(qual, doff), ndc_prepend(head = robj, rest = rargs), off, callee_resolution),
            None => ECall(EDot(robj, m, doff, fdoff), rargs, off, callee_resolution)
          }
        },
        _ => ECall(normalize_dot_calls_expr(expr = callee, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), rargs, off, callee_resolution)
      }
    },
    EBinOp(op, l, r, boff) => EBinOp(op, normalize_dot_calls_expr(expr = l, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), normalize_dot_calls_expr(expr = r, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), boff),
    EUnaryOp(op, e2) => EUnaryOp(op, normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    EFn(tp, bounds, params, ret, eff, body) => {
      let var_types2 = ndc_seed_var_types(params = params, base = var_types)
      EFn(tp, bounds, params, ret, eff, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = var_types2, fn_returns = fn_returns))
    },
    EDot(e2, field, off, fdoff) => EDot(normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns), field, off, fdoff),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    EReturn(e2) => EReturn(normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      normalize_dot_calls_expr(expr = a, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, normalize_dot_calls_expr(expr = v, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
    }),
    ESpread(e2) => ESpread(normalize_dot_calls_expr(expr = e2, struct_sets = struct_sets, var_types = var_types, fn_returns = fn_returns))
  }
}

fn normalize_dot_calls_stmt(stmt: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Stmt {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, normalize_dot_calls_expr(expr = fn_value, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns), reqs, enss),
    SLetMut(name, ty, body) => SLetMut(name, ty, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    STest(n, body) => STest(n, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    SBench(n, body) => SBench(n, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    SExample(n, body) => SExample(n, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    SExpr(e) => SExpr(normalize_dot_calls_expr(expr = e, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    SLetPat(p, body) => SLetPat(p, normalize_dot_calls_expr(expr = body, struct_sets = struct_sets, var_types = array_empty(), fn_returns = fn_returns)),
    _ => stmt
  }
}

/// #1194 (ADR-0081) entry point: rewrite `recv.method(args)` to
/// `Type::method(recv, args)` wherever this file's own declarations make the
/// receiver's type and the method's existence recoverable. See the section
/// comment above for exactly what's covered and what's deliberately left
/// alone.
export fn normalize_dot_calls(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let struct_sets = ndc_struct_field_sets(stmts)
  let fn_returns = ndc_fn_returns(stmts)
  for s in stmts {
    normalize_dot_calls_stmt(stmt = s, struct_sets = struct_sets, fn_returns = fn_returns)
  }
}

/// DCE is name-based, so it must run while module members still carry their
/// short names (a body says `helper()`, not `math::helper()`). We therefore DCE
/// each scope before flattening renames its bindings:
///   - top-level non-module decls are DCE'd against the exported top-level roots;
///   - each module body is DCE'd against its own exported members, then renamed.
export fn normalize_stmts(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let nonmods = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    if !is_module_stmt(stmt) {
      Array::push(nonmods, value = stmt)
    }
    i = i + 1
  }
  let result = empty_stmts()
  let live_top = dce_stmts(stmts = nonmods, entry_names = exported_value_names(nonmods))
  Array::push_all(result, values = live_top)
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, at = m) {
      SModule(_, name, body) => {
        let live_body = dce_stmts(stmts = body, entry_names = exported_value_names(body))
        let aliases = array_empty()
        let _ = module_value_aliases(body = live_body, prefix = name, out = aliases)
        let _ = flatten_module_body(body = live_body, prefix = name, rewrite_aliases = make_import_alias_rewriter(aliases), out = result)
        0
      },
      _ => 0
    }
    m = m + 1
  }
  let promoted = promote_aggregate_exports(stmts = result, agg = aggregate_export_names(stmts))
  hoist_lambda_lets(annotate_literal_lets(normalize_dot_calls(fold_stmts(drop_unused_type_aliases(promoted)))))
}

export fn normalize_source(_ src: String) -> String with Exception {
  // #730 (D-3): require pin lines are a leading directive, not statement
  // grammar — extract them, normalize the remainder, and re-emit them in
  // canonical single-space form above the output. Pin FILLING is the
  // Fs-mode wrapper's job (VIBE_FILL_PINS); this pure engine re-emits
  // pinned and unpinned lines as they are.
  let (req_pins, src_wo_requires) = extract_require_pins(src)
  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting
  // a #cfg-bearing source would silently delete the disabled code from the
  // re-printed output. Refuse instead.
  let toks_cfg = lex(src_wo_requires)
  let mut ci = 0
  while ci < Array::length(toks_cfg) {
    match Array::get(toks_cfg, at = ci) {
      THash => throw("cannot normalize a source containing #cfg directives"),
      _ => ()
    }
    ci = ci + 1
  }
  // #727 (ADR-0064): parse with the fn-PRESERVING entry so `fn` declarations
  // (and their where-contracts) survive as SFnDecl and re-print in fn form
  // instead of being rewritten to `let rec` + inlined asserts.
  let stmts = parse_program_preserving(toks_cfg)
  // ADR-0088: the rows of `test` / `bench` / `example` blocks travel in the
  // program's trailing marker, and this renderer prints statement by
  // statement -- register them so a block prints its `allows` row rather than
  // silently dropping the authority it declared (Codex review on PR #2653).
  register_block_rows(stmts)
  let kept = normalize_stmts(stmts)
  let sections = empty_strs()
  if Array::length(req_pins) > 0 {
    let req_lines = empty_strs()
    let mut ri = 0
    while ri < Array::length(req_pins) {
      let (rname, rver, rpin) = Array::get(req_pins, at = ri)
      if rpin == "" {
        Array::push(req_lines, value = "require \{rname} \{rver}")
      } else {
        Array::push(req_lines, value = "require \{rname} \{rver} = #\{rpin}")
      }
      ri = ri + 1
    }
    Array::push(sections, value = String::join(req_lines, sep = "\n"))
  } else ()
  let mut s = 0
  while s <= 3 {
    let rendered = render_section(stmts = kept, section = s)
    if rendered != "" {
      Array::push(sections, value = rendered)
    }
    s = s + 1
  }
  let out = String::concat(String::join(sections, sep = "\n\n"), "\n")
  // Leave no rows behind for an unrelated statement printed later.
  register_block_rows(Array::slice(stmts, start = 0, end = 0))
  out
}
