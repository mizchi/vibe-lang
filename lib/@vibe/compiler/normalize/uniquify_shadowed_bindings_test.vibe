import @vibe/compiler/core {
  Expr, Pat
}

import ./normalize.vibe {
  uniquify_shadowed_bindings_fresh
}

fn fresh_counter() -> Array[Int] {
  [0]
}

test "a single immediate reassignment separates old and replacement lifetimes" {
  let rhs = ECall(EIdent("replace", 1), [EIdent("x", 2)], 3)
  let expr = ELetMut("x", EInt(1), EAssign("x", rhs, EIdent("x", 4)), 5)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    ELetMut(old, _, ELetMut(replacement, value, EIdent(use_name, 4), _), 5) => {
      assert(old != replacement)
      assert_eq(use_name, replacement)
      match value {
        ECall(_, args, 3) => match Array::get(args, 0) {
          EIdent(rhs_name, 2) => assert_eq(rhs_name, old),
          _ => assert(false)
        },
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "reassignment keeps a mutable slot when another write can observe it" {
  let writes = [
    EAssign("x", EInt(3), EIdent("x", 0)),
    EAssignOp("x", "+", EInt(3), EIdent("x", 0)),
    EIf(EBool(true), EAssign("x", EInt(3), EIdent("x", 0)), EIdent("x", 0))
  ]
  for write in writes {
    let rhs = ECall(EIdent("replace", 0), [EIdent("x", 0)], 0)
    let expr = ELetMut("x", EInt(1), EAssign("x", rhs, write), 0)
    match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
      ELetMut(_, _, EAssign(_, _, _), _) => assert(true),
      _ => assert(false)
    }
    let rhs_write = ELetMut("x", EInt(1), EAssign("x", write, EIdent("x", 0)), 0)
    match uniquify_shadowed_bindings_fresh(rhs_write, fresh_counter(), []) {
      ELetMut(_, _, EAssign(_, _, _), _) => assert(true),
      _ => assert(false)
    }
  }
}

test "a closure made before the store must keep observing the mutable slot" {
  let closure = EFn([], [], [], None, None, EIdent("x", 0))
  let rhs = ELet("saved", closure, EInt(2), 0)
  let expr = ELetMut("x", EInt(1), EAssign("x", rhs, EIdent("x", 0)), 0)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    ELetMut(_, _, EAssign(_, _, _), _) => assert(true),
    _ => assert(false)
  }
}

test "an overwrite without uses on both sides keeps its original lifetime" {
  let bodies = [
    EAssign("x", EInt(2), EIdent("x", 0)),
    EAssign("x", EIdent("x", 0), EUnit)
  ]
  for body in bodies {
    let expr = ELetMut("x", EInt(1), body, 0)
    match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
      ELetMut(_, _, EAssign(_, _, _), _) => assert(true),
      _ => assert(false)
    }
  }
}

test "conditional and repeated assignments keep their mutable slot" {
  let assignment = EAssign("x", EInt(2), EUnit)
  let bodies = [
    EIf(EBool(true), assignment, EUnit),
    EWhile(EBool(false), assignment)
  ]
  for body in bodies {
    let expr = ELetMut("x", EInt(1), body, 0)
    match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
      ELetMut(_, _, _, _) => assert(true),
      _ => assert(false)
    }
  }
}

test "nested binding shadows through the lexical stack" {
  let expr = ELet("x", EInt(1), ELet("x", EInt(2), EIdent("x", 0), 0), 0)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    ELet("x", _, ELet(inner, _, EIdent(use_name, _), _), _) => {
      assert(inner != "x")
      assert_eq(use_name, inner)
    },
    _ => assert(false)
  }
}

test "same-named sibling pattern binders remain globally unique" {
  let arms: Array[(Pat, Expr)] = [
    (PBind("x"), EIdent("x", 0)),
    (PBind("x"), EIdent("x", 0))
  ]
  match uniquify_shadowed_bindings_fresh(EMatch(EInt(0), arms), fresh_counter(), [
  ]) {
    EMatch(_, rewritten) => {
      let (p0, e0) = Array::get(rewritten, 0)
      let (p1, e1) = Array::get(rewritten, 1)
      match (p0, e0, p1, e1) {
        (PBind(n0), EIdent(u0, _), PBind(n1), EIdent(u1, _)) => {
          assert_eq(n0, "x")
          assert_eq(u0, n0)
          assert(n1 != n0)
          assert_eq(u1, n1)
        },
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "labeled parameter base name is occupied for inner bindings" {
  let body = ELet("arg", EInt(1), EIdent("arg", 0), 0)
  let expr = EFn([], [], [("arg~", None)], None, None, body)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    EFn(_, _, _, _, _, ELet(inner, _, EIdent(use_name, _), _)) => {
      assert(inner != "arg")
      assert_eq(use_name, inner)
    },
    _ => assert(false)
  }
}

test "let rec self reference resolves to its rewritten binding" {
  let expr = ELet("f", EInt(0), ELetRec("f", EIdent("f", 0), EIdent("f", 0)), 0)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    ELet(_, _, ELetRec(inner, EIdent(value_name, _), EIdent(body_name, _)), _) => {
      assert(inner != "f")
      assert_eq(value_name, inner)
      assert_eq(body_name, inner)
    },
    _ => assert(false)
  }
}

test "loop initializers all read the outer scope" {
  let expr = ELet("x", EInt(7), ELoop([("x", EInt(0)), ("y", EIdent("x", 0))], EIdent("y", 0)), 0)
  match uniquify_shadowed_bindings_fresh(expr, fresh_counter(), []) {
    ELet(outer, _, ELoop(params, EIdent(body_name, _)), _) => {
      let (inner, _) = Array::get(params, 0)
      let (y_name, y_init) = Array::get(params, 1)
      assert(inner != outer)
      match y_init {
        EIdent(init_name, _) => assert_eq(init_name, outer),
        _ => assert(false)
      }
      assert_eq(body_name, y_name)
    },
    _ => assert(false)
  }
}
