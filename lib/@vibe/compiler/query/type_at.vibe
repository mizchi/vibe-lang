//# Imports

// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source
// offsets. Given a (line, col), locate the identifier node whose source span
// covers that position, typecheck the program, and return the inferred type of
// that name via env_lookup + type_to_string.
//
// Locals and parameters resolve through the checker's per-node type table; a
// binder's DECLARATION site (a match / handler arm pattern, a `let`
// destructuring, a `for` header, a parameter), which the AST stores as a bare
// String, is located by binding_at's scope walk and answers with the type of a
// use of the same binding (#3000). "" means no identifier at the position, or
// one with no known type; `type_at_ident_at` tells the two apart for the CLI.
//
// `vibe type-at` answers through `type_at_fs` (type_at_fs.vibe), which types
// the file on `vibe check`'s import-resolving lane and hands the result in as
// a `TypeAtTyped` (#3834); this file alone types the source as one module.
//
// All strings are built with String::concat only (never `+`, never "\{x}"
// interpolation): both mis-codegen to NUL here. Ints stringify via
// __to_string.

import @vibe/compiler/core {
  Expr, Pat, Stmt, Subst, Type, TypeEnv, env_lookup, subst_apply, type_to_string
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_program, check_program_type_table, local_let_rec_types, local_let_types
}

import ./binding_at.vibe {
  binding_occurrences, let_rec_anchor_at, local_binder_sites
}

import @vibe/compiler/syntax {
  Token, lex_with_offsets, offset_to_line_col, parse_program_located, parse_program_spans
}

/// The checker's answer for the whole file, typed with its imports resolved
/// (#3834): the per-node table, the final substitution and the final
/// environment. With none, the source is typed as a single module.
///
/// `lets` is the local `let` / `let rec` rows of that check (#3050, #3106).
/// `None` reads them from the checker's global tables, which hold the rows
/// of the LAST check of any source -- right only when the hover is answered
/// immediately after this check. A typing kept across requests (#1960) holds
/// its own copy.
export struct TypeAtTyped {
  table: Array[(Int, Type)];
  subst: Subst;
  env: TypeEnv;
  lets: Option[(Array[(Int, Type)], Array[(Int, Type)])];
  checked_error_row: Bool
}

//# Functions

export fn type_at_typed(table: Array[(Int, Type)], subst: Subst, env: TypeEnv, checked_error_row: Bool) -> TypeAtTyped {
  TypeAtTyped::{
    table: table,
    subst: subst,
    env: env,
    lets: None,
    checked_error_row: checked_error_row
  }
}

/// `type_at_typed` for a typing that outlives the next check: copies the
/// local `let` and `let rec` rows that check just recorded.
export fn type_at_typed_kept(table: Array[(Int, Type)], subst: Subst, env: TypeEnv, checked_error_row: Bool) -> TypeAtTyped {
  let lets = local_let_types()
  let recs = local_let_rec_types()
  TypeAtTyped::{
    table: table,
    subst: subst,
    env: env,
    lets: Some((Array::slice(lets, start = 0, end = Array::length(lets)), Array::slice(recs, start = 0, end = Array::length(recs)))),
    checked_error_row: checked_error_row
  }
}

enum TypeAtEnvCell {
  EnvReady(TypeEnv);
  EnvFailed(String)
}

/// The per-node table check, with the local `let` / `let rec` rows it
/// recorded COPIED out of the checker's global side tables, and the env a
/// name with no row of its own falls back to. A cold hover checks that env
/// from the statements the table check just mutated, immediately after it;
/// the memo does the same, in the same order, rather than later and after
/// some other buffer's check. A failed check keeps its message so a later
/// read fails the same way.
enum TypeAtTableCell {
  TableReady(Array[(Int, Type)], Subst, Array[(Int, Type)], Array[(Int, Type)], TypeAtEnvCell);
  TableFailed(String)
}

enum TypeAtHitsCell {
  HitsReady(Array[IdentHit]);
  HitsFailed(String)
}

/// One exact source revision's single-file typing, computed on first use and
/// kept (#1960). A cold `type_at_source` re-parses and re-checks the whole
/// buffer for every hover; a resident editor session asks many positions of
/// one revision, so this keeps each check the cold path would run -- the
/// per-node table (with its local `let` rows), the env of a fresh parse, and
/// the env of the table's own statements -- and answers every later position
/// from them. Each cell is filled by exactly the calls the cold path makes,
/// in the same order, so an answer equals `type_at_source` on the same text
/// (pinned position by position in `type_at_memo_test.vibe`).
///
/// The identity is the source text and checked Exception-row policy. The
/// single-file lane resolves no imports. A buffer edit or policy change gets
/// a fresh answer. The local `let` rows are
/// copied out of the checker's global tables, which the next check of ANY
/// source overwrites -- reading them later from there would answer for
/// whichever buffer was checked last.
export struct TypeAtMemo {
  source: String;
  checked_error_row: Bool;
  hits: Array[Option[TypeAtHitsCell]];
  table: Array[Option[TypeAtTableCell]];
  env_fresh: Array[Option[TypeAtEnvCell]];
  checks: Array[Int]
}

export fn type_at_memo_new(_ source: String, checked_error_row: Bool) -> TypeAtMemo {
  TypeAtMemo::{
    source: source,
    checked_error_row: checked_error_row,
    hits: [None],
    table: [None],
    env_fresh: [None],
    checks: [0]
  }
}

/// The exact text this memo types.
export fn type_at_memo_source(_ memo: TypeAtMemo) -> String {
  memo.source
}

/// The immutable policy under which this memo's checked tables were made.
export fn type_at_memo_error_row_checked(_ memo: TypeAtMemo) -> Bool {
  memo.checked_error_row
}

/// How many checker runs this memo has made: at most three per revision, however
/// many positions are asked.
export fn type_at_memo_checks(_ memo: TypeAtMemo) -> Int {
  Array::get(memo.checks, at = 0)
}

fn type_at_memo_count_check(_ memo: TypeAtMemo) -> Unit {
  Array::set(memo.checks, at = 0, value = Array::get(memo.checks, at = 0) + 1)
}

fn type_at_fresh_stmts(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

fn type_at_memo_hits(_ memo: TypeAtMemo) -> Array[IdentHit] with Exception {
  let cell = match Array::get(memo.hits, at = 0) {
    Some(c) => c,
    None => {
      let c = handle {
        let (_, hits) = type_at_collect(memo.source)
        HitsReady(hits)
      } with { Exception::Throw(message) => HitsFailed(message) }
      Array::set(memo.hits, at = 0, value = Some(c))
      c
    }
  }
  match cell {
    HitsReady(hits) => hits,
    HitsFailed(message) => throw(message)
  }
}

fn type_at_memo_table_cell(_ memo: TypeAtMemo, checked_error_row: Bool) -> TypeAtTableCell {
  match Array::get(memo.table, at = 0) {
    Some(c) => c,
    None => {
      let c = handle {
        let stmts = type_at_fresh_stmts(memo.source)
        type_at_memo_count_check(memo)
        let (table, subst) = check_program_type_table(stmts, checked_error_row = checked_error_row)
        let lets = local_let_types()
        let recs = local_let_rec_types()
        let lets_copy = Array::slice(lets, start = 0, end = Array::length(lets))
        let recs_copy = Array::slice(recs, start = 0, end = Array::length(recs))
        let env_after = handle {
          type_at_memo_count_check(memo)
          EnvReady(check_program(stmts, checked_error_row = checked_error_row))
        } with { Exception::Throw(message) => EnvFailed(message) }
        TableReady(table, subst, lets_copy, recs_copy, env_after)
      } with { Exception::Throw(message) => TableFailed(message) }
      Array::set(memo.table, at = 0, value = Some(c))
      c
    }
  }
}

fn type_at_memo_table(_ memo: TypeAtMemo, checked_error_row: Bool) -> (Array[(Int, Type)], Subst) with Exception {
  match type_at_memo_table_cell(memo, checked_error_row = checked_error_row) {
    TableReady(table, subst, _, _, _) => (table, subst),
    TableFailed(message) => throw(message)
  }
}

fn type_at_memo_let_rows(memo: TypeAtMemo, recursive: Bool, checked_error_row: Bool) -> Array[(Int, Type)] with Exception {
  match type_at_memo_table_cell(memo, checked_error_row = checked_error_row) {
    TableReady(_, _, lets, recs, _) => if recursive {
      recs
    } else {
      lets
    },
    TableFailed(message) => throw(message)
  }
}

fn type_at_env_cell_read(_ cell: TypeAtEnvCell) -> TypeEnv with Exception {
  match cell {
    EnvReady(env) => env,
    EnvFailed(message) => throw(message)
  }
}

/// The env a local callee with no `let` binder answers from: `check_program`
/// of a fresh parse.
fn type_at_memo_env_fresh(_ memo: TypeAtMemo, checked_error_row: Bool) -> TypeEnv with Exception {
  match Array::get(memo.env_fresh, at = 0) {
    Some(c) => type_at_env_cell_read(c),
    None => {
      let c = handle {
        let stmts = type_at_fresh_stmts(memo.source)
        type_at_memo_count_check(memo)
        EnvReady(check_program(stmts, checked_error_row = checked_error_row))
      } with { Exception::Throw(message) => EnvFailed(message) }
      Array::set(memo.env_fresh, at = 0, value = Some(c))
      type_at_env_cell_read(c)
    }
  }
}

/// The env a name with no row of its own falls back to: `check_program` of the
/// statements the per-node table was checked on, run right after that check.
fn type_at_memo_env_after_table(_ memo: TypeAtMemo, checked_error_row: Bool) -> TypeEnv with Exception {
  match type_at_memo_table_cell(memo, checked_error_row = checked_error_row) {
    TableReady(_, _, _, _, env_cell) => type_at_env_cell_read(env_cell),
    TableFailed(message) => throw(message)
  }
}

/// Where a hover's typing comes from: checked now (`TatCold`), handed in by the
/// import-resolving lane (`TatFs`, #3834), or kept for this exact revision
/// (`TatMemo`, #1960).
enum TypeAtTyping {
  TatCold;
  TatFs(TypeAtTyped);
  TatMemo(TypeAtMemo)
}

fn tat_table(typing: TypeAtTyping, stmts: Array[Stmt], checked_error_row: Bool) -> (Array[(Int, Type)], Subst) with Exception {
  match typing {
    TatCold => check_program_type_table(stmts, checked_error_row = checked_error_row),
    TatFs(t) => (t.table, t.subst),
    TatMemo(m) => type_at_memo_table(m, checked_error_row = checked_error_row)
  }
}

fn tat_env_fresh(typing: TypeAtTyping, stmts: Array[Stmt], checked_error_row: Bool) -> TypeEnv with Exception {
  match typing {
    TatCold => check_program(stmts, checked_error_row = checked_error_row),
    TatFs(t) => t.env,
    TatMemo(m) => type_at_memo_env_fresh(m, checked_error_row = checked_error_row)
  }
}

fn tat_env_after_table(typing: TypeAtTyping, stmts: Array[Stmt], checked_error_row: Bool) -> TypeEnv with Exception {
  match typing {
    TatCold => check_program(stmts, checked_error_row = checked_error_row),
    TatFs(t) => t.env,
    TatMemo(m) => type_at_memo_env_after_table(m, checked_error_row = checked_error_row)
  }
}

/// The local `let` rows (`recursive = false`) or `let rec` rows (`recursive = true`) of
/// the table check this hover read. Cold and import-resolved hovers read the
/// checker's global tables right after that check; a memo, and a kept
/// import-resolved typing, read their copy.
fn tat_let_rows(typing: TypeAtTyping, recursive: Bool, checked_error_row: Bool) -> Array[(Int, Type)] with Exception {
  match typing {
    TatMemo(m) => type_at_memo_let_rows(memo = m, recursive = recursive, checked_error_row = checked_error_row),
    TatFs(t) => match t.lets {
      Some((lets, recs)) => if recursive {
        recs
      } else {
        lets
      },
      None => if recursive {
        local_let_rec_types()
      } else {
        local_let_types()
      }
    },
    TatCold => if recursive {
      local_let_rec_types()
    } else {
      local_let_types()
    }
  }
}

/// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.
/// `col` is the position WITHIN a line (col 1 = first char of the line, col
/// length+1 = just past the last char — a valid cursor position). We count
/// newlines: the offset of the start of line L is just past the (L-1)th
/// newline, then add (col - 1).
///
/// Returns -1 (invalid / no position) for anything out of range, rather than
/// silently clamping (#947):
///   - `line < 1` or `col < 1`: never valid (1-based).
///   - `line` beyond the last line in `source`.
///   - `col` past the END of that line's content — previously this fell
///     through to `linestart + col - 1` unclamped, which for a large enough
///     `col` landed on/inside the NEXT line (a col-past-EOL query silently
///     resolved to an unrelated identifier a line down).
/// CRLF (#947): a line's addressable content excludes a trailing '\r' before
/// the '\n' — otherwise every query position (and reported span) on a CRLF
/// file drifts by one byte per preceding CRLF line, since the line's `\r` was
/// being counted as ordinary content here but not consistently elsewhere.
fn line_col_to_offset(source: String, line: Int, col: Int) -> Int {
  if line < 1 || col < 1 {
    -1
  } else {
    let len = String::length(source)
    let mut i = 0
    let mut cur_line = 1
    // Advance to the first char of the target line.
    while cur_line < line && i < len {
      if String::char_code_at(source, at = i) == 10 {
        cur_line = cur_line + 1
      } else {
        ()
      }
      i = i + 1
    }
    if cur_line < line {
      // `line` is past the last line in `source`.
      -1
    } else {
      // i is the start of line `line`. Find the end of its content: the
      // offset of the terminating '\n' (or `len` for the final line), then
      // exclude a preceding '\r' (CRLF) so it isn't counted as content.
      let mut line_end = i
      while line_end < len && String::char_code_at(source, at = line_end) != 10 {
        line_end = line_end + 1
      }
      let content_end = if line_end > i && String::char_code_at(source, at = line_end - 1) == 13 {
        line_end - 1
      } else {
        line_end
      }
      let off = i + (col - 1)
      if off > content_end {
        -1
      } else {
        off
      }
    }
  }
}

/// A located identifier hit: name + source span [off, off + length(name)).
/// `off` is -1 for synthetic / non-located idents (those are ignored).
/// `CalleeHit` is an `EIdent` that is the callee of an `ECall` — the type
/// table records CallResult at that same offset (`callee_offset`), so hover
/// must not last-win the call result (#1941).
/// `BinderHit` is the declaration site of a LOCAL binder (pattern binder,
/// parameter, local `let`, `for` / `loop` binder), recovered by the scope walk
/// in binding_at.vibe because the AST stores it as a bare String (#3000).
enum IdentHit {
  IdentHit(String, Int);
  CalleeHit(String, Int);
  BinderHit(String, Int)
}

fn empty_hits() -> Array[IdentHit] {
  array_empty()
}

/// Read-only walker over the Expr structure (templated on normalize/index.vibe's
/// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the
/// tree). Every variant is enumerated so a new Expr arm is a compile error here,
/// keeping the collector in sync with the AST.
fn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {
  match expr {
    EInt(_) => (),
    EFloat(_) => (),
    EString(_, _) => (),
    EBool(_) => (),
    EIdent(name, off) => {
      if off >= 0 {
        Array::push(acc, value = IdentHit(name, off))
      } else {
        ()
      }
    },
    EUnit => (),
    EStringInterp(_) => (),
    ETuple(items) => collect_exprs(items = items, acc = acc),
    EArray(items) => collect_exprs(items = items, acc = acc),
    ERecord(_, fields, _) => collect_field_exprs(fields = fields, acc = acc),
    EIf(c, t, e) => {
      collect_expr(expr = c, acc = acc)
      collect_expr(expr = t, acc = acc)
      collect_expr(expr = e, acc = acc)
    },
    ELet(_, v, b, _) => {
      collect_expr(expr = v, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    ELetRec(_, v, b) => {
      collect_expr(expr = v, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    ELetMut(_, v, b, _) => {
      collect_expr(expr = v, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    EAssign(_, v, b, _) => {
      collect_expr(expr = v, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    EAssignOp(_, _, v, b, _) => {
      collect_expr(expr = v, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    ESeq(a, b) => {
      collect_expr(expr = a, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    EMatch(s, arms) => {
      collect_expr(expr = s, acc = acc)
      collect_arm_exprs(arms = arms, acc = acc)
    },
    EHandle(s, arms) => {
      collect_expr(expr = s, acc = acc)
      collect_arm_exprs(arms = arms, acc = acc)
    },
    EWhile(c, b) => {
      collect_expr(expr = c, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    ELoop(params, b) => {
      collect_loop_param_exprs(params = params, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    EForIn(_, _, it, b, _) => {
      collect_expr(expr = it, acc = acc)
      collect_expr(expr = b, acc = acc)
    },
    ECall(callee, args, _, _) => {
      // Named callees share their EIdent offset with the ECall (`callee_offset`
      // in the parser). Mark them so type-at can prefer the function type
      // over the CallResult the checker records at that offset (#1941).
      match callee {
        EIdent(name, off) => if off >= 0 {
          Array::push(acc, value = CalleeHit(name, off))
        } else {
          ()
        },
        _ => collect_expr(expr = callee, acc = acc)
      }
      collect_exprs(items = args, acc = acc)
    },
    EBinOp(_, l, r, _) => {
      collect_expr(expr = l, acc = acc)
      collect_expr(expr = r, acc = acc)
    },
    EUnaryOp(_, e) => collect_expr(expr = e, acc = acc),
    EFn(_, _, _, _, _, body) => collect_expr(expr = body, acc = acc),
    EDot(e, field, _, field_off) => {
      // #645: the field name is hoverable — EDot carries the field token's
      // offset, and the checker records the projection type at that offset.
      if field_off >= 0 {
        Array::push(acc, value = IdentHit(field, field_off))
      } else {
        ()
      }
      collect_expr(expr = e, acc = acc)
    },
    ELabeledArg(_, _, v) => collect_expr(expr = v, acc = acc),
    EReturn(e) => collect_expr(expr = e, acc = acc),
    EBreak(opt) => match opt {
      Some(v) => collect_expr(expr = v, acc = acc),
      None => ()
    },
    EContinue(args) => collect_exprs(items = args, acc = acc),
    EMap(fields) => collect_field_exprs(fields = fields, acc = acc),
    ESpread(e) => collect_expr(expr = e, acc = acc)
  }
}

fn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    collect_expr(expr = Array::get(items, at = i), acc = acc)
    i = i + 1
  }
}

fn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, at = i)
    collect_expr(expr = v, acc = acc)
    i = i + 1
  }
}

fn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, e) = Array::get(arms, at = i)
    collect_expr(expr = e, acc = acc)
    i = i + 1
  }
}

fn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(params) {
    let (_, init) = Array::get(params, at = i)
    collect_expr(expr = init, acc = acc)
    i = i + 1
  }
}

fn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {
  match stmt {
    SLet(_, _, _, _, body) => collect_expr(expr = body, acc = acc),
    SLetMut(_, _, body) => collect_expr(expr = body, acc = acc),
    SFnDecl(_, _, body, _, _) => collect_expr(expr = body, acc = acc),
    STest(_, body) => collect_expr(expr = body, acc = acc),
    SBench(_, body) => collect_expr(expr = body, acc = acc),
    SExpr(e) => collect_expr(expr = e, acc = acc),
    SLetPat(_, body) => collect_expr(expr = body, acc = acc),
    SModule(_, _, body) => collect_stmts(stmts = body, acc = acc),
    _ => ()
  }
}

fn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    collect_stmt(stmt = Array::get(stmts, at = i), acc = acc)
    i = i + 1
  }
}

/// True when `source[off]` is NOT an identifier char (or off is out of range) —
/// i.e. a valid word boundary. Used to match a binding name as a whole word.
fn is_boundary_at(source: String, off: Int) -> Bool {
  if off < 0 || off >= String::length(source) {
    true
  } else {
    let c = String::char_code_at(source, at = off)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    !is_id
  }
}

/// Find the first whole-word occurrence of `name` in `source[start..end)` and, if
/// found, push a located IdentHit for it. This recovers a source offset for a
/// let-binding NAME, which the parser stores only as a String on the Stmt (it is
/// not an EIdent and so carries no offset). Binding names are exactly the
/// env-visible top-level names, so making their definition site hoverable is the
/// useful case for this MVP.
fn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {
  let nlen = String::length(name)
  if nlen == 0 {
    ()
  } else {
    let limit = if end > String::length(source) {
      String::length(source)
    } else {
      end
    }
    let mut i = if start < 0 {
      0
    } else {
      start
    }
    let mut found = false
    while !found && i + nlen <= limit {
      if String::substring(source, start = i, end = i + nlen) == name && is_boundary_at(source = source, off = i - 1) && is_boundary_at(source = source, off = i + nlen) {
        Array::push(acc, value = IdentHit(name, i))
        found = true
      } else {
        i = i + 1
      }
    }
  }
}

/// Add located hits for the NAMES of top-level (and module-body) value bindings,
/// using each statement's source span (from parse_program_spans) to scope the
/// whole-word search. SLet / SLetMut / SFnDecl names are env-visible value
/// bindings (`fn f` is SFnDecl; the default parse entry lowers it to SLet, but
/// a preserving parse still hands out SFnDecl — recover both, #1941).
fn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let start = if i < Array::length(span_start) {
      Array::get(span_start, at = i)
    } else {
      0
    }
    let end = if i < Array::length(span_end) {
      Array::get(span_end, at = i)
    } else {
      String::length(source)
    }
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => push_binding_name_hit(source = source, start = start, end = end, name = name, acc = acc),
      SLetMut(name, _, _) => push_binding_name_hit(source = source, start = start, end = end, name = name, acc = acc),
      SFnDecl(_, name, _, _, _) => push_binding_name_hit(source = source, start = start, end = end, name = name, acc = acc),
      SLetPat(pat, _) => {
        // A top-level `let (a, b) = e` binds env-visible names too (#3000).
        let names = array_empty()
        pat_binder_names(pat = pat, out = names)
        let mut j = 0
        while j < Array::length(names) {
          push_binding_name_hit(source = source, start = start, end = end, name = Array::get(names, at = j), acc = acc)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// The names a pattern binds, in source order.
fn pat_binder_names(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PWild => (),
    PBind(name) => Array::push(out, value = name),
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PCtor(_, sub) => pats_binder_names(sub = sub, out = out),
    PTuple(sub) => pats_binder_names(sub = sub, out = out),
    POr(a, b) => {
      pat_binder_names(pat = a, out = out)
      pat_binder_names(pat = b, out = out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        pat_binder_names(pat = fp, out = out)
        i = i + 1
      }
    }
  }
}

fn pats_binder_names(sub: Array[Pat], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(sub) {
    pat_binder_names(pat = Array::get(sub, at = i), out = out)
    i = i + 1
  }
}

fn hit_name_off(_ hit: IdentHit) -> (String, Int) {
  match hit {
    IdentHit(name, off) => (name, off),
    CalleeHit(name, off) => (name, off),
    BinderHit(name, off) => (name, off)
  }
}

fn hit_is_callee(_ hit: IdentHit) -> Bool {
  match hit {
    CalleeHit(_, _) => true,
    IdentHit(_, _) => false,
    BinderHit(_, _) => false
  }
}

fn hit_is_local_binder(_ hit: IdentHit) -> Bool {
  match hit {
    BinderHit(_, _) => true,
    IdentHit(_, _) => false,
    CalleeHit(_, _) => false
  }
}

/// True when the innermost hit covering `tgt` is a local binder's declaration.
fn pick_ident_is_local_binder(hits: Array[IdentHit], tgt: Int) -> Bool {
  let mut best_off = -1
  let mut best_binder = false
  let mut i = 0
  while i < Array::length(hits) {
    let hit = Array::get(hits, at = i)
    let (name, off) = hit_name_off(hit)
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_off = off
      best_binder = hit_is_local_binder(hit)
    } else {
      ()
    }
    i = i + 1
  }
  best_binder
}

/// Among all collected idents whose span [off, off+len(name)) contains `tgt`,
/// pick the one with the largest `off` (innermost / closest start). Returns ""
/// when no ident covers the position.
fn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {
  let mut best_name = ""
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    let (name, off) = hit_name_off(Array::get(hits, at = i))
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_name = name
      best_off = off
    } else {
      ()
    }
    i = i + 1
  }
  best_name
}

/// Same selection as pick_ident_at, but returns the chosen ident's source
/// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.
/// Used to query the per-node type table by the hovered EIdent's offset.
fn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    let (name, off) = hit_name_off(Array::get(hits, at = i))
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_off = off
    } else {
      ()
    }
    i = i + 1
  }
  best_off
}

/// True when the innermost hit covering `tgt` is a named call callee.
fn pick_ident_is_callee(hits: Array[IdentHit], tgt: Int) -> Bool {
  let mut best_off = -1
  let mut best_callee = false
  let mut i = 0
  while i < Array::length(hits) {
    let hit = Array::get(hits, at = i)
    let (name, off) = hit_name_off(hit)
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_off = off
      best_callee = hit_is_callee(hit)
    } else {
      ()
    }
    i = i + 1
  }
  best_callee
}

/// Look up the recorded type for source offset `off` in the per-node type table
/// produced by check_program_type_table. Returns None when no node recorded that
/// exact offset. When multiple entries share an offset (re-checked node), the
/// last recorded one wins (closest to the final inference state).
fn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {
  let mut found = None
  let mut i = 0
  while i < Array::length(table) {
    let (toff, tty) = Array::get(table, at = i)
    if toff == off {
      found = Some(tty)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Locate the identifier at (line, col), typecheck the program, and return its
/// inferred type as a string. Resolution order:
///   1. named call callee: env lookup of the function. The checker records
///      CallResult at the callee EIdent's own offset (`callee_offset` ==
///      ident off), so a type-table last-wins would report `Int` for `add` in
///      `add(1, 2)` instead of `(Int, Int) -> Int` (#1941). Same reason
///      `vibe grep` never consults the offset table for a callee.
///   2. per-node type table (covers LOCALS and PARAMETERS — names that live in
///      nested inference scopes and are gone from the returned TypeEnv);
///   3. fall back to the top-level TypeEnv lookup (top-level / imported names,
///      and let/fn-binding definition sites whose offset is not an EIdent node).
/// Returns "" when the position is not over a located identifier, or the name
/// resolves nowhere. Any failure is swallowed and yields "".
fn type_at_off_in_occ(occ: Array[(Int, Int)], off: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(occ) {
    let (s, e) = Array::get(occ, at = i)
    if off >= s && off < e {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #3050: the offset of the `let` keyword that introduces the binder written
/// at `boff` (`let f` or `let mut f`), or -1 when that binder is not a `let`'s.
/// The checker keys a local `let`'s value type by this offset, which is the one
/// the parser gives `ELet` / `ELetMut`. Read from the token stream, so a
/// comment between the keyword and the name is skipped the way the parser
/// skips it (#3104 review).
fn type_at_let_keyword_before(source: String, boff: Int) -> Int with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let mut k = -1
  let mut i = 0
  while i < Array::length(starts) && k < 0 {
    if Array::get(starts, at = i) == boff {
      k = i
    } else {
      ()
    }
    i = i + 1
  }
  let prev = if k > 0 {
    match Array::get(tokens, at = k - 1) {
      TMut => k - 2,
      _ => k - 1
    }
  } else {
    -1
  }
  if prev >= 0 {
    match Array::get(tokens, at = prev) {
      TLet => Array::get(starts, at = prev),
      _ => -1
    }
  } else {
    -1
  }
}

/// The declaration offset of the LOCAL binder that `occ` (the scope walk's
/// occurrences of one binding) resolves to, or -1 when the binding is not a
/// local one (a top-level or imported name).
fn type_at_local_binder_off(hits: Array[IdentHit], name: String, occ: Array[(Int, Int)]) -> Int {
  let mut found = -1
  let mut i = 0
  while i < Array::length(hits) {
    let hit = Array::get(hits, at = i)
    let (hname, hoff) = hit_name_off(hit)
    if hname == name && hit_is_local_binder(hit) && type_at_off_in_occ(occ = occ, off = hoff) {
      found = hoff
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #3050: the value type of the local `let` whose binder is declared at
/// `boff`, from the rows `check_program_type_table` recorded per `let`; "" when
/// the binder is not a `let`'s (a parameter, a pattern binder) or has no row.
/// Read it right after `check_program_type_table`, which is what fills it.
///
/// A `let rec` (#3106) has no `let` offset in the AST, so its row is keyed by
/// its value or continuation (`let_rec_binding_anchor`), and binding_at's walk
/// says which binding at `boff` introduces that key.
fn type_at_local_let(source: String, boff: Int, final_s: Subst, typing: TypeAtTyping, checked_error_row: Bool) -> String with Exception {
  let let_off = type_at_let_keyword_before(source = source, boff = boff)
  if let_off >= 0 {
    match tytab_lookup(table = tat_let_rows(typing = typing, recursive = false, checked_error_row = checked_error_row), off = let_off) {
      Some(CtUnknown) => "",
      Some(t) => type_to_string(subst_apply(s = final_s, ty = t)),
      None => ""
    }
  } else {
    let anchor = let_rec_anchor_at(source = source, boff = boff)
    if anchor < 0 {
      ""
    } else {
      match tytab_lookup(table = tat_let_rows(typing = typing, recursive = true, checked_error_row = checked_error_row), off = anchor) {
        Some(CtUnknown) => "",
        Some(t) => type_to_string(subst_apply(s = final_s, ty = t)),
        None => ""
      }
    }
  }
}

/// A name with no row of its own in the type table answers with the type of a
/// USE that resolves to the same binding (`occ`, from the scope walk). Only a
/// name that is not a local binder may then fall back to the top-level env: a
/// local binder with no use has no recorded type, and looking its spelling up
/// in the module env would answer for an unrelated top-level name.
///
/// A local `let` binder with no such use -- a closure that is only ever
/// called, whose callee rows are call results -- answers with the value type
/// the checker recorded for that `let` (#3050).
fn type_at_use_or_env(source: String, table: Array[(Int, Type)], hits: Array[IdentHit], name: String, chosen_off: Int, final_s: Subst, stmts: Array[Stmt], occ: Array[(Int, Int)], local_binder: Bool, typing: TypeAtTyping, checked_error_row: Bool) -> String with Exception {
  let mut use_ty = ""
  let mut unknown_use = false
  let mut u = 0
  while u < Array::length(hits) {
    let (hname, hoff) = hit_name_off(Array::get(hits, at = u))
    if hname == name && hoff != chosen_off && !hit_is_callee(Array::get(hits, at = u)) && type_at_off_in_occ(occ = occ, off = hoff) {
      match tytab_lookup(table = table, off = hoff) {
        Some(CtUnknown) => {
          unknown_use = true
        },
        Some(t) => {
          use_ty = type_to_string(subst_apply(s = final_s, ty = t))
        },
        None => ()
      }
    } else {
      ()
    }
    u = u + 1
  }
  if unknown_use {
    ""
  } else if use_ty != "" {
    use_ty
  } else if local_binder {
    type_at_local_let(source = source, boff = chosen_off, final_s = final_s, typing = typing, checked_error_row = checked_error_row)
  } else {
    let env = tat_env_after_table(typing = typing, stmts = stmts, checked_error_row = checked_error_row)
    match env_lookup(env = env, name = name) {
      Some(t) => type_to_string(t),
      None => ""
    }
  }
}

/// Every located identifier the hover can land on: EIdent uses, `let*`
/// binders, top-level binding names and LOCAL binder declaration sites. Returns
/// the located parse alongside, since type resolution re-reads it.
fn type_at_collect(_ source: String) -> (Array[Stmt], Array[IdentHit]) with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  let hits = empty_hits()
  // Identifier USES carry real offsets on their EIdent nodes.
  collect_stmts(stmts = stmts, acc = hits)
  let mut lsi = 0
  let ls_ntok = Array::length(tokens)
  while lsi + 2 < ls_ntok {
    match Array::get(tokens, at = lsi) {
      TLet => match Array::get(tokens, at = lsi + 1) {
        TStar => match Array::get(tokens, at = lsi + 2) {
          TIdent(ls_name) => {
            let ls_off = Array::get(starts, at = lsi + 2)
            if ls_off >= 0 {
              Array::push(hits, value = IdentHit(ls_name, ls_off))
            } else {
              ()
            }
            lsi = lsi + 3
          },
          _ => {
            lsi = lsi + 1
          }
        },
        _ => {
          lsi = lsi + 1
        }
      },
      _ => {
        lsi = lsi + 1
      }
    }
  }
  // Identifier DEFINITIONS (let / fn binding names) carry none, so recover
  // their source offset from each statement's span and the source text.
  let (span_stmts, span_start, span_end) = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
  collect_binding_name_hits(stmts = span_stmts, span_start = span_start, span_end = span_end, source = source, acc = hits)
  // LOCAL binder declaration sites (pattern binders, parameters, local
  // `let`s, `for` / `loop` binders) carry no offset either, and are not
  // statements, so take them from binding_at's scope walk (#3000).
  let binder_sites = local_binder_sites(source)
  let mut bsi = 0
  while bsi < Array::length(binder_sites) {
    let (b_name, b_off) = Array::get(binder_sites, at = bsi)
    Array::push(hits, value = BinderHit(b_name, b_off))
    bsi = bsi + 1
  }
  (stmts, hits)
}

export fn type_at_source(source: String, line: Int, col: Int, checked_error_row: Bool) -> String {
  type_at_answer(source = source, line = line, col = col, typing = TatCold, checked_error_row = checked_error_row)
}

/// `type_at_source` answered from `typed` when the caller already typed the
/// file (with its imports, #3834); with `None` the source is typed alone.
export fn type_at_source_typed(source: String, line: Int, col: Int, typed: Option[TypeAtTyped], checked_error_row: Bool) -> String {
  match typed {
    Some(t) => if t.checked_error_row == checked_error_row {
      type_at_answer(source = source, line = line, col = col, typing = TatFs(t), checked_error_row = checked_error_row)
    } else {
      type_at_answer(source = source, line = line, col = col, typing = TatCold, checked_error_row = checked_error_row)
    },
    None => type_at_answer(source = source, line = line, col = col, typing = TatCold, checked_error_row = checked_error_row)
  }
}

/// `type_at_source` for `type_at_memo_source(memo)`, from the checks `memo`
/// already ran for that text (#1960). `source` must be that same text -- a
/// caller holding a memo for another revision gets a fresh answer instead
/// of a stale one, at the cost of a cold check.
export fn type_at_source_memo(source: String, line: Int, col: Int, memo: TypeAtMemo, checked_error_row: Bool) -> String {
  if memo.source == source && memo.checked_error_row == checked_error_row {
    type_at_answer(source = source, line = line, col = col, typing = TatMemo(memo), checked_error_row = checked_error_row)
  } else {
    type_at_answer(source = source, line = line, col = col, typing = TatCold, checked_error_row = checked_error_row)
  }
}

fn type_at_answer(source: String, line: Int, col: Int, typing: TypeAtTyping, checked_error_row: Bool) -> String {
  handle {
    let tgt = line_col_to_offset(source = source, line = line, col = col)
    if tgt < 0 {
      // Out-of-range (line, col): invalid `line`/`col` (< 1), `line` beyond
      // EOF, or `col` past the end of that line's content (#947). No position
      // to resolve, so no hover — matches the "position not over a located
      // identifier" empty-result convention below.
      ""
    } else {
      let (stmts, hits) = match typing {
        TatMemo(m) => (array_empty(), type_at_memo_hits(m)),
        _ => type_at_collect(source)
      }
      let name = pick_ident_at(hits = hits, tgt = tgt)
      if name == "" {
        ""
      } else {
        let chosen_off = pick_ident_off(hits = hits, tgt = tgt)
        let on_callee = pick_ident_is_callee(hits = hits, tgt = tgt)
        if on_callee {
          // A LOCAL callee is answered by its own binding, never by the
          // module env: the env holds only top-level names, so a local that
          // shadows one would be answered with the other's type. The table's
          // last-wins entry at a callee is the CallResult, the wrong type for
          // the name, so a local `let` answers with the value type the
          // checker recorded for it (#3050), and any other local binder
          // (a parameter, a pattern binder) prefers empty over a confident
          // wrong answer.
          let callee_binder = type_at_local_binder_off(hits = hits, name = name, occ = binding_occurrences(source = source, line = line, col = col))
          if callee_binder >= 0 {
            let (_, callee_s) = tat_table(typing = typing, stmts = stmts, checked_error_row = checked_error_row)
            type_at_local_let(source = source, boff = callee_binder, final_s = callee_s, typing = typing, checked_error_row = checked_error_row)
          } else {
            let env = tat_env_fresh(typing = typing, stmts = stmts, checked_error_row = checked_error_row)
            match env_lookup(env = env, name = name) {
              Some(t) => type_to_string(t),
              None => ""
            }
          }
        } else {
          // 2. per-node type table (locals + parameters).
          let (table, final_s) = tat_table(typing = typing, stmts = stmts, checked_error_row = checked_error_row)
          let table_hit = if chosen_off >= 0 {
            tytab_lookup(table = table, off = chosen_off)
          } else {
            None
          }
          match table_hit {
            // A contradictory split-arm type is explicitly unknown. Do not
            // fall back to an outer binding with the same spelling.
            Some(CtUnknown) => "",
            Some(rec_ty) => type_to_string(subst_apply(s = final_s, ty = rec_ty)),
            None => type_at_use_or_env(source = source, table = table, hits = hits, name = name, chosen_off = chosen_off, final_s = final_s, stmts = stmts, occ = binding_occurrences(source = source, line = line, col = col), local_binder = pick_ident_is_local_binder(hits = hits, tgt = tgt), typing = typing, checked_error_row = checked_error_row)
          }
        }
      }
    }
  } with { Exception::Throw(_) => "" }
}

/// The identifier under 1-based (line, col), or "" when there is none -- the
/// position is out of range, or over whitespace, a keyword, a literal or
/// punctuation. `vibe type-at` uses it to tell "no identifier here" (an error
/// the caller should hear about) from "an identifier whose type is unknown"
/// (#3000); both make type_at_source answer "".
export fn type_at_ident_at(source: String, line: Int, col: Int) -> String {
  handle {
    let tgt = line_col_to_offset(source = source, line = line, col = col)
    if tgt < 0 {
      ""
    } else {
      let (_, hits) = type_at_collect(source)
      pick_ident_at(hits = hits, tgt = tgt)
    }
  } with { Exception::Throw(_) => "" }
}
