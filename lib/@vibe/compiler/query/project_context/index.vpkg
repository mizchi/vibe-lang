generated_hash =

import @vibe/compiler/core {
  TypeEnv
}

// One sweep owns all three caches. Thread the returned state into the next
// query; its mutable per-module rows also remain valid after a thrown walk.
opaque type QueryProjectState

// The query supplies its own refusal text; preparation owns source validation.
struct QueryProjectEdit {
  replacement: String;
  mismatch_message: String
}

/// `entry_fingerprint` identifies everything the entry's typing depends on:
/// the walk's Merkle fingerprint over the ingested entry text, every
/// transitive dependency's fingerprint, the target configuration and the
/// checker semantics (`typecheck_fs_build_fingerprint_with_config`). Two
/// contexts with equal fingerprints type the entry identically (#1960).
///
/// `closure_tokens` is the stat token each module of the closure other than
/// the entry was read under, and the token (or absence) of every
/// `index.vpkg` that could own one of them or the entry, for
/// `query_project_tokens_unchanged`.
struct QueryProjectContext {
  entry_source: String;
  entry_fingerprint: String;
  closure_tokens: Array[(String, Int)];
  import_env: TypeEnv;
  state: QueryProjectState
}

fn query_project_state_new() -> QueryProjectState
// Prepare the current source's imports through the production walk. Unedited
// disk queries keep the FS closure-cache path. A replacement requires a fresh
// reading of the original disk bytes to match source, then is ingested before
// imports are collected. The caller owns the final check and error presentation.
fn query_project_tokens_unchanged(_ tokens: Array[(String, Int)]) -> Bool with Fs
fn query_project_context_fs(path: String, source: String, replacement: Option[QueryProjectEdit], state: QueryProjectState) -> QueryProjectContext with Env + Exception + Fs
