// Shared source ingestion and dependency typing for grep and label queries.
// Keep the final parse/check in each consumer: they record different answers.
import @vibe/compiler/core {
  TypeEnv, dir_of_path, ensure_regular_source_fs, normalize_path, vpkg_path_in_dir
}
import @vibe/core {
  array_empty, struct MutSet
}
import @vibe/compiler/incremental {
  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_new, ripple_set_source
}
import @vibe/compiler/loader {
  collect_source_groups_fs_with_config, collect_source_groups_fs_with_entry_source
}
import @vibe/compiler/runtime {
  ensure_fingerprint_fs_impl_with_config, load_persistent_type_env, projected_import_env_for_test
}
import @vibe/compiler/config {
  target_cfg_ambient
}
import @vibe/compiler/cache {
  cache_read_source_fs, cache_source_memo_token
}

// These caches are keyed by dependency path, never by the current entry.
// Sharing only the RippleDb is insufficient: reuse also checks the previously
// walked source, and a persistent hit may need its environment hydrated.
export struct QueryProjectState {
  env_cache: Array[(String, TypeEnv)];
  rdb: RippleDb;
  dep_sources: Array[(String, String)]
}

/// Start a query sweep without retained module environments or source rows.
export fn query_project_state_new() -> QueryProjectState {
  QueryProjectState::{
    env_cache: array_empty(),
    rdb: ripple_new(),
    dep_sources: array_empty()
  }
}

/// Collect and seed every reachable module's ingested source before walking.
/// Omitting a source makes the walk lose the imported module's types. Warm
/// walks need the same environment projection as cold ones, including modules
/// whose fingerprint hit the persistent cache instead of re-checking.
///
/// Failures propagate to the query's own error result, never to single-file
/// typing. Callers retain their incoming state on failure: array-backed rows
/// already published for a complete module remain reusable on the next file.
export fn query_project_context_fs(path: String, source: String, replacement: Option[QueryProjectEdit], state: QueryProjectState) -> QueryProjectContext with Env + Exception + Fs {
  if Fs::exists(path) {
    ensure_regular_source_fs(path)
  } else ()
  if Fs::is_dir(path) {
    throw("module source is a directory: \{path}")
  } else ()
  let is_edit = match replacement {
    Some(_) => true,
    None => false
  }
  let disk_source = if Fs::exists(path) {
    // Authorizing an edit needs current bytes, even under a preserved stat
    // token. Ordinary queries share the loader's reading to avoid a full copy.
    Some(if is_edit {
      Fs::read_file(path)
    } else {
      cache_read_source_fs(path)
    })
  } else {
    None
  }
  let current = match replacement {
    None => source,
    Some(edit) => {
      if disk_source != Some(source) {
        throw(edit.mismatch_message)
      } else ()
      edit.replacement
    }
  }
  let cfg = target_cfg_ambient()
  // An edit always collects its own text, including a no-op replacement: the
  // FS closure cache can still hold an older same-token disk reading.
  let groups = if !is_edit && disk_source == Some(current) {
    collect_source_groups_fs_with_config(path, cfg = cfg)
  } else {
    collect_source_groups_fs_with_entry_source(entry_path = path, source = current, cfg = cfg)
  }
  let mut rdb = state.rdb
  let mut entry_source = current
  let closure_tokens: Array[(String, Int)] = []
  let contract_dirs: MutSet[String] = MutSet::new_string()
  query_project_note_contracts(path = path, seen = contract_dirs, tokens = closure_tokens)
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (p, text) = Array::get(sources, at = si)
      rdb = ripple_set_source(db = rdb, path = p, source = text)
      if p == path {
        entry_source = text
      } else {
        Array::push(closure_tokens, value = (p, query_project_source_token(p)))
      }
      query_project_note_contracts(path = p, seen = contract_dirs, tokens = closure_tokens)
      si = si + 1
    }
    gi = gi + 1
  }
  let (entry_fingerprint, walked, env_cache, dep_sources, _) = ensure_fingerprint_fs_impl_with_config(rdb = rdb, env_cache = state.env_cache, dep_source_cache = state.dep_sources, parse_count = 0, path = path, cfg = cfg)
  let deps = match ripple_get_deps(db = walked, path = path) {
    Some(d) => d,
    None => array_empty()
  }
  let import_env = projected_import_env_for_test(source = entry_source, path = path, deps = deps, full_cache = query_project_fill_dep_envs(rdb = walked, env_cache = env_cache, deps = deps))
  QueryProjectContext::{
    entry_source: entry_source,
    entry_fingerprint: entry_fingerprint,
    closure_tokens: closure_tokens,
    import_env: import_env,
    state: QueryProjectState::{
      env_cache: env_cache,
      rdb: walked,
      dep_sources: dep_sources
    }
  }
}

/// The stat token `path`'s text was read under: the one the loader's source
/// memo stored before reading it, or the current one when the memo holds no
/// text for `path` (a module this walk did not read through the memo).
fn query_project_source_token(_ path: String) -> Int with Fs {
  let token = cache_source_memo_token(path)
  if token >= 0 {
    token
  } else {
    query_project_path_token(path)
  }
}

/// `path`'s current stat token, or `query_project_absent_token()` when no file
/// is there. The existence test comes first: the node runner raises a guest
/// error for the stat of a missing path, where viberun answers 0, so a
/// dependency deleted after it was read must be asked about this way.
fn query_project_path_token(_ path: String) -> Int with Fs {
  if Fs::exists(path) {
    Fs::stat_token(path)
  } else {
    query_project_absent_token()
  }
}

/// The token of a path with no file: no stat token takes this value
/// (viberun's are 61-bit non-negative, -1 marks a symlink, 0 a failed stat).
fn query_project_absent_token() -> Int {
  0 - 2
}

/// Record the token of every `index.vpkg` that could own `path`: the one in
/// its directory and in each directory above it. The owning contract is an
/// input to the typing although no import names it -- it is where a file's
/// directory-shared imports come from (`vpkg_shared_prefix_owner`, which looks
/// in the file's directory and, for some files, up the tree) -- and creating
/// one changes the owner, so a contract that is absent is recorded too.
fn query_project_note_contracts(path: String, seen: MutSet[String], tokens: Array[(String, Int)]) -> Unit with Fs {
  let mut dir = dir_of_path(normalize_path(path))
  let mut going = true
  while going {
    if MutSet::has(seen, x = dir) {
      going = false
    } else {
      MutSet::add(seen, x = dir)
      let candidate = vpkg_path_in_dir(dir)
      Array::push(tokens, value = (candidate, query_project_path_token(candidate)))
      let parent = dir_of_path(dir)
      if parent == dir {
        going = false
      } else {
        dir = parent
      }
    }
  }
}

/// Whether every module of a context's closure, and every contract that could
/// own one, still has the stat token it was read under -- the test the
/// loader's own source memo applies before it trusts a text it holds (#3577).
/// False as soon as one was written, replaced, removed or created.
export fn query_project_tokens_unchanged(_ tokens: Array[(String, Int)]) -> Bool with Fs {
  let mut same = true
  let mut i = 0
  while same && i < Array::length(tokens) {
    let (p, token) = Array::get(tokens, at = i)
    if query_project_path_token(p) != token {
      same = false
    } else ()
    i = i + 1
  }
  same
}

/// Persistent hits need hydration only when this exact module has no env row.
fn query_project_cache_has(cache: Array[(String, TypeEnv)], path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(cache) {
    let (p, _) = Array::get(cache, at = i)
    if p == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Fill in the dependency environments the walk did NOT return in-memory.
///
/// `ensure_fingerprint_fs_impl` only adds a module to its env cache when it
/// actually re-checks it; a module whose persistent environment was already on
/// disk is recorded in the ripple db and skipped. That is the normal (warm)
/// case, so without this step a repeat run resolves imports against an empty
/// cache -- `projected_import_env_for_test` then throws and every imported name
/// types as `CtUnknown`. Reading each missing dependency back from the same
/// persistent store the walk published to is what makes the typed tier behave
/// the same warm as cold.
fn query_project_fill_dep_envs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], deps: Array[String]) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  let mut i = 0
  while i < Array::length(deps) {
    let dep = Array::get(deps, at = i)
    if !query_project_cache_has(cache = env_cache, path = dep) {
      match ripple_get_fingerprint(db = rdb, path = dep) {
        Some(fingerprint) => match load_persistent_type_env(fingerprint) {
          Some(dep_env) => Array::push(env_cache, value = (dep, dep_env)),
          None => ()
        },
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  env_cache
}
