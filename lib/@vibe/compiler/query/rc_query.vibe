//# `vibe rc-classify` / `vibe rc-plan` (issue 1981).
//#
//# The compile pipeline already answers two questions on every build:
//# which classifier sets a function is in, and what Perceus dup/drop
//# plan it gets. Those answers lived only inside linked_compile. This
//# query runs the SAME prelude + the SAME compute_* / planner functions
//# and prints the result as line-oriented text. Empty output means
//# nothing special (no classifier membership / no plan actions).

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars_used_builtins, compute_borrow_param_user_fns, compute_may_return_view_fns
}

import @vibe/compiler/codegen/expr {
  cl_own_return_stmts
}

import @vibe/compiler/perceus {
  PerceusAction,
  build_perceus_plan_with_params,
  compute_borrow_returning_names,
  compute_scalar_returning_names,
  pa_is_alias_dup,
  pa_is_consume_mark,
  pa_is_drop,
  pa_is_dup,
  pa_is_exit_drop,
  pa_is_exit_site,
  pa_is_field_release,
  pa_is_path_drop,
  pa_is_reuse_alloc,
  pa_is_reuse_token,
  pa_is_store_dup,
  pa_is_trunc_release,
  pa_is_view_pin
}

fn rcq_contains(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn rcq_nonzero_mask(names: Array[String], masks: Array[Int], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, at = i) == name && i < Array::length(masks) && Array::get(masks, at = i) != 0 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn rcq_user_fn_names(_ stmts: Array[Stmt]) -> Array[String] {
  let raw: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => Array::push(raw, value = name),
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  sorted_names_of(raw)
}

fn rcq_run_prelude(_ stmts: Array[Stmt]) -> Unit with Exception {
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts = stmts, entry_name = "main", linked_imports = linked, iw_names = iw_names, iw_wats = iw_wats, checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, at = 0))
  } else {
    ()
  }
  let _ = cl_own_return_stmts(stmts)
}

fn rcq_join_tags(_ tags: Array[String]) -> String {
  let acc = StringBuilder::new()
  let mut i = 0
  while i < Array::length(tags) {
    if i > 0 {
      StringBuilder::push(acc, value = ",")
    } else {
      ()
    }
    StringBuilder::push(acc, value = Array::get(tags, at = i))
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn rcq_action_name(_ a: PerceusAction) -> String {
  if pa_is_dup(a) {
    "dup"
  } else if pa_is_drop(a) {
    "drop"
  } else if pa_is_alias_dup(a) {
    "alias_dup"
  } else if pa_is_reuse_token(a) {
    // ADR-0092 / #2389 pairing candidates; the RC codegen re-validates
    // against the ctor table before staging anything. The codegen
    // authorizes by (name, arity), so the arity (`extra`) rides the action
    // name -- `reuse_token:2` -- and thereby the collapse key too;
    // without it, same-scrutinee rows of different arities would print
    // indistinguishably (#2411 review).
    String::concat("reuse_token:", __to_string(a.extra))
  } else if pa_is_reuse_alloc(a) {
    String::concat("reuse_alloc:", __to_string(a.extra))
  } else if pa_is_path_drop(a) {
    // #2389 per-path release: the scope-end drop a branch merge planned
    // away, given back guarded by a runtime flag, plus the occurrences that
    // set that flag. The mark's source offset rides the action name, since
    // it is what tells two occurrences of one binding apart.
    "path_drop"
  } else if pa_is_consume_mark(a) {
    String::concat("consume_mark:", __to_string(a.use_offset))
  } else if pa_is_trunc_release(a) {
    // #2837: a truncate of this local array releases what it removes. The
    // `:1` form is sound only in an Int/Bool/Unit-returning function, which
    // codegen checks.
    String::concat("truncate_release:", __to_string(a.extra))
  } else if pa_is_view_pin(a) {
    String::concat("view_pin:", __to_string(a.extra))
  } else if pa_is_field_release(a) {
    // #3140: a field assignment of this local struct releases the value it
    // overwrites.
    "field_release"
  } else if pa_is_exit_site(a) {
    // #3141: exit `use_offset` of kind `binding_id` (0 return, 1 break,
    // 2 continue, 3 throw); the row's name is its innermost `let`.
    String::concat("exit_site:", String::concat(__to_string(a.use_offset), String::concat(":", __to_string(a.binding_id))))
  } else if pa_is_exit_drop(a) {
    // #3141: exit `use_offset` releases this binding `extra` times.
    String::concat("exit_drop:", String::concat(__to_string(a.use_offset), String::concat(":", __to_string(a.extra))))
  } else if pa_is_store_dup(a) {
    // #3184: the store of this binding at source offset `use_offset` takes a
    // reference of its own; the offset tells two stores of one binding apart.
    String::concat("store_dup:", __to_string(a.use_offset))
  } else {
    "other"
  }
}

fn rcq_push_line(acc: StringBuilder, first: Array[Bool], line: String) -> Unit {
  if Array::get(first, at = 0) {
    StringBuilder::push(acc, value = line)
    Array::set(first, at = 0, value = false)
  } else {
    StringBuilder::push(acc, value = "\n")
    StringBuilder::push(acc, value = line)
  }
}

/// NAME SET[,SET...] per user function that is in at least one classifier
/// set. Empty string = no special sets. Sets are the same four
/// linked_compile threads into every Perceus plan: borrow_ret,
/// borrow_param, view_ret, scalar_ret.
fn rcq_entry_exclude() -> Array[String] {
  ["main", "_start", "cli_main"]
}

/// Same classifier sets linked_compile threads into every Perceus plan,
/// including the sorted_names_of wrapping the planner bsearch_leftmosts.
fn rcq_borrow_ret(_ stmts: Array[Stmt]) -> Array[String] {
  sorted_names_of(compute_borrow_returning_names(stmts))
}

fn rcq_view_ret(_ stmts: Array[Stmt]) -> Array[String] {
  sorted_names_of(compute_may_return_view_fns(stmts))
}

/// Parse the way the compile lane does -- WITH source offsets. The
/// offset-less `parse_program` leaves every `EIdent` at -1, which is what a
/// per-use plan action is keyed by (#2257), so these reports used to print
/// `dup` rows the codegen could not have matched and could not show a
/// per-path release pair at all (#2389).
fn rcq_parse(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

fn rcq_scalar_ret(_ stmts: Array[Stmt]) -> Array[String] {
  sorted_names_of(compute_scalar_returning_names(stmts))
}

export fn rc_classify_source(_ source: String) -> String with Exception {
  let stmts = rcq_parse(source)
  rcq_run_prelude(stmts)
  let borrow_ret = rcq_borrow_ret(stmts)
  let masks: Array[Int] = []
  let borrow_param = compute_borrow_param_user_fns(stmts = stmts, exclude = rcq_entry_exclude(), out_masks = masks)
  let view_ret = rcq_view_ret(stmts)
  let scalar_ret = rcq_scalar_ret(stmts)
  let names = rcq_user_fn_names(stmts)
  let acc = StringBuilder::new()
  let first: Array[Bool] = [true]
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    let tags: Array[String] = []
    if rcq_contains(names = borrow_ret, name = name) {
      Array::push(tags, value = "borrow_ret")
    } else {
      ()
    }
    if rcq_nonzero_mask(names = borrow_param, masks = masks, name = name) {
      Array::push(tags, value = "borrow_param")
    } else {
      ()
    }
    if rcq_contains(names = view_ret, name = name) {
      Array::push(tags, value = "view_ret")
    } else {
      ()
    }
    if rcq_contains(names = scalar_ret, name = name) {
      Array::push(tags, value = "scalar_ret")
    } else {
      ()
    }
    if Array::length(tags) > 0 {
      rcq_push_line(acc = acc, first = first, line = String::concat(name, String::concat(" ", rcq_join_tags(tags))))
    } else {
      ()
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn rcq_emit_fn_plan(acc: StringBuilder, first: Array[Bool], fname: String, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret: Array[String], borrow_param: Array[String], masks: Array[Int], view_ret: Array[String]) -> Unit {
  let plan = build_perceus_plan_with_params(params = params, body = body, borrow_ret_names = borrow_ret, borrow_param_fns = borrow_param, borrow_param_masks = masks, view_ret_fns = view_ret)
  let mut i = 0
  while i < Array::length(plan) {
    let a = Array::get(plan, at = i)
    let action = rcq_action_name(a)
    let binding = a.name
    let mut count = 1
    let mut j = i + 1
    while j < Array::length(plan) {
      let b = Array::get(plan, at = j)
      if b.name == binding && rcq_action_name(b) == action {
        count = count + 1
        j = j + 1
      } else {
        j = Array::length(plan)
      }
    }
    // An exit outside every `let` names none; keep the field count fixed.
    let shown = if binding == "" {
      "-"
    } else {
      binding
    }
    let line = String::concat(fname, String::concat(" ", String::concat(shown, String::concat(" ", String::concat(action, String::concat(" ", __to_string(count)))))))
    rcq_push_line(acc = acc, first = first, line = line)
    i = i + count
  }
}

/// #3355: the shadow uniquify's starting `seen` set, the same one
/// linked_compile_function_bodies.vibe's `lc_body_free_names` hands it: every
/// name the function reads that nothing inside it binds. A local binder of
/// such a name is renamed there, so it is renamed here, or this surface would
/// print a binding name the compiler no longer uses.
fn rcq_body_free_names(_ e: Expr) -> Array[String] {
  match e {
    EFn(_, _, params, _, _, body) => {
      let pnames: Array[String] = []
      for p in params {
        let (pn, _) = p
        let n = String::length(pn)
        let last = if n > 0 {
          String::char_code_at(pn, at = n - 1)
        } else {
          0
        }
        Array::push(pnames, value = if last == '~' || last == '?' {
          pn[0: n - 1]
        } else {
          pn
        })
      }
      collect_free_vars_used_builtins(body = body, param_names = pnames, fn_name_index = [
      ])
    },
    _ => collect_free_vars_used_builtins(body = e, param_names = [], fn_name_index = [
    ])
  }
}

/// FN BINDING ACTION COUNT per collapsed Perceus action. `fn_filter` empty
/// means every user function; a non-empty filter that names no function
/// throws so "the query broke" stays distinguishable from an empty plan.
export fn rc_plan_source(source: String, fn_filter: String) -> String with Exception {
  let stmts = rcq_parse(source)
  rcq_run_prelude(stmts)
  let borrow_ret = rcq_borrow_ret(stmts)
  let masks: Array[Int] = []
  let borrow_param = compute_borrow_param_user_fns(stmts = stmts, exclude = rcq_entry_exclude(), out_masks = masks)
  let view_ret = rcq_view_ret(stmts)
  let acc = StringBuilder::new()
  let first: Array[Bool] = [true]
  // #2411 review: the RC codegen plans the NORMALIZED body -- shadow
  // uniquify, then scrutinee lift (`match f() {..}` becomes
  // `let __m_scrut_N = f(); match __m_scrut_N {..}`), with one counter cell
  // each shared across the file's functions in declaration order, exactly
  // as linked_compile's planned-bodies loop does. Planning the raw body
  // here made this surface omit rows the compiler actually acts on --
  // reuse pairs on lifted scrutinees most visibly.
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut matched = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          // Normalize EVERY function (not only the filtered one): the two
          // counters are shared across the file, so the fresh names a
          // function receives depend on every function before it. A filter
          // that skipped the transform for non-emitted functions would
          // print `__m_scrut_N` numbers the codegen never uses.
          let seen = rcq_body_free_names(value)
          let norm = lift_match_scrutinees(expr = uniquify_shadowed_bindings_fresh(expr = value, counter = uq_shadow_counter, seen = seen), counter = m_scrut_counter)
          let take = fn_filter == "" || fn_filter == name
          if take {
            matched = true
            match norm {
              EFn(_, _, nparams, _, _, nbody) => rcq_emit_fn_plan(acc = acc, first = first, fname = name, params = nparams, body = nbody, borrow_ret = borrow_ret, borrow_param = borrow_param, masks = masks, view_ret = view_ret),
              _ => ()
            }
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  if fn_filter != "" && !matched {
    throw(String::concat("rc-plan: function not found: ", fn_filter))
  } else {
    ()
  }
  StringBuilder::freeze(acc)
}
