//# Imports

// ADR-0120 Phase 2a (#3679): the FS sweep behind `vibe refactor add-labels`
// and the recheck every edit must pass before it is reported or written.

import ./label_sites_fs.vibe {
  query_label_sites_fs, query_label_sites_recheck_fs
}

//# Tests

test "the recheck types a replacement through the file's imports" {
  let dir = "_build/vibe_label_sites_fs"
  Fs::mkdir_p(dir)
  Fs::write_file(dir + "/dep.vibe", contents = "export fn sub(x: Int, y: Int) -> Int {\n  x - y\n}\n")
  let path = dir + "/main.vibe"
  let source = "import ./dep.vibe { sub }\n\nfn main() -> Int {\n  sub(10, 3)\n}\n"
  Fs::write_file(path, contents = source)
  let answers = query_label_sites_fs([path])
  inspect(Array::length(answers), content = "1")
  inspect(Array::get(answers, at = 0).error, content = "")
  // The imported `sub` resolves, so its labels check...
  inspect(query_label_sites_recheck_fs(path = path, source = source, edited = "import ./dep.vibe { sub }\n\nfn main() -> Int {\n  sub(x = 10, y = 3)\n}\n"), content = "")
  // ...and an edit that no longer checks is refused with the checker's answer.
  let broken = query_label_sites_recheck_fs(path = path, source = source, edited = "import ./dep.vibe { sub }\n\nfn main() -> Int {\n  sub(x = 10, z = 3)\n}\n")
  inspect(String::length(broken) > 0, content = "true")
  // The file itself is never written.
  inspect(Fs::read_file(path) == source, content = "true")
}

test "the recheck types the edit, not the original, under a require head" {
  // The loader may hand the file over with its `require` head blanked, so the
  // replacement is matched and written blanked too. Typing the unedited file
  // instead would let a broken edit through.
  let dir = "_build/vibe_label_sites_fs_pinned"
  Fs::mkdir_p(dir)
  let path = dir + "/main.vibe"
  let head = "require @vibe/core 0.2.0 = #pkg:sha1:0000000000000000000000000000000000000000\n\n"
  let body = "fn sub(x: Int, y: Int) -> Int {\n  x - y\n}\n\nfn main() -> Int {\n  sub(10, 3)\n}\n"
  let source = head + body
  Fs::write_file(path, contents = source)
  inspect(Array::get(query_label_sites_fs([path]), at = 0).error, content = "")
  inspect(query_label_sites_recheck_fs(path = path, source = source, edited = head + "fn sub(x: Int, y: Int) -> Int {\n  x - y\n}\n\nfn main() -> Int {\n  sub(x = 10, y = 3)\n}\n"), content = "")
  let broken = query_label_sites_recheck_fs(path = path, source = source, edited = head + "fn sub(x: Int, y: Int) -> Int {\n  x - y\n}\n\nfn main() -> Int {\n  sub(x = 10, z = 3)\n}\n")
  inspect(String::length(broken) > 0, content = "true")
}

test "a failed import has no label sites and does not abort the next file" {
  let dir = "_build/vibe_label_sites_failed_project_context"
  Fs::mkdir_p(dir)
  let broken = dir + "/broken.vibe"
  let good = dir + "/good.vibe"
  Fs::write_file(broken, contents = "import ./missing.vibe { nope }\nfn main() -> Int { nope() }\n")
  Fs::write_file(good, contents = "fn sub(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { sub(10, 3) }\n")
  let answers = query_label_sites_fs([broken, good])
  inspect(Array::length(answers), content = "2")
  let failed = Array::get(answers, at = 0)
  inspect(String::length(failed.error) > 0, content = "true")
  inspect(Array::length(failed.sites), content = "0")
  let checked = Array::get(answers, at = 1)
  inspect(checked.error, content = "")
  inspect(Array::length(checked.sites) > 0, content = "true")
}

test "the recheck collects imports added by the replacement without writing it" {
  let dir = "_build/vibe_label_sites_current_imports_1960"
  Fs::mkdir_p(dir)
  let path = dir + "/main.vibe"
  let source = "fn main() -> Int { 7 }\n"
  let edited = "import ./dep.vibe { sub }\nfn main() -> Int { sub(x = 10, y = 3) }\n"
  Fs::write_file(path, contents = source)
  Fs::write_file(dir + "/dep.vibe", contents = "export fn sub(x: Int, y: Int) -> Int { x - y }\n")
  inspect(query_label_sites_recheck_fs(path = path, source = source, edited = edited), content = "")
  inspect(Fs::read_file(path), content = source)
}

test "a replacement can remove a missing import and reports its own broken import" {
  let dir = "_build/vibe_label_sites_remove_import_1960"
  Fs::mkdir_p(dir)
  let path = dir + "/main.vibe"
  let source = "import ./old_missing.vibe { old }\nfn main() -> Int { old() }\n"
  Fs::write_file(path, contents = source)
  inspect(query_label_sites_recheck_fs(path = path, source = source, edited = "fn main() -> Int { 7 }\n"), content = "")
  let broken = query_label_sites_recheck_fs(path = path, source = source, edited = "// moved\n\nimport ./new_missing.vibe { new }\nfn main() -> Int { new() }\n")
  inspect(String::starts_with(broken, prefix = "line 3:8: cannot resolve import './new_missing.vibe'"), content = "true")
  inspect(Fs::read_file(path), content = source)
}
