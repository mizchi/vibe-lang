//# Imports

// ADR-0120 Phase 2a (#3679): the resolved call sites of each file, typed the
// way `vibe check` types it. The label codemod (`vibe refactor add-labels`)
// reads these rows; it never resolves a callee itself.
//
// The project_context package also prepares grep's typed tier: every reachable
// module's ingested source is seeded into the ripple db, the walk publishes
// each dependency's environment, and the entry is checked against the
// projected import environment. The three caches are threaded through the
// sweep for the same reason grep threads them (#2914).

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  LabelSite, check_program_with_projected_import_env_result, checker_required_labels_suspend, label_sites_begin, label_sites_end
}

import @vibe/parser {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/core {
  TypeEnv
}
import @vibe/compiler/query/project_context {
  QueryProjectEdit, QueryProjectState, query_project_context_fs, query_project_state_new
}

//# Model

/// One file's answer. `source` is the file as written; the checker typed the
/// ingested source, which may carry a prepended directory-shared import, so a
/// site's offset minus `offset_delta` is its offset in `source`. `error` is ""
/// when the file checked cleanly, and otherwise the checker's message (the
/// file then has no sites: a codemod must not edit a program it could not
/// type).
// `LabelSiteFile` is defined in the package contract (index.vpkg), its single
// definition site.

//# Functions

fn label_sites_failed(path: String, source: String, message: String) -> LabelSiteFile {
  LabelSiteFile::{
    path: path,
    source: source,
    offset_delta: 0,
    sites: array_empty(),
    error: message
  }
}

/// Query-specific checking and failure presentation. The same project state
/// flows through the sweep, including the complete per-module rows retained
/// when a dependency walk throws. The replacement is never written to disk.
fn label_sites_file(path: String, source: String, replacement: Option[String], state: QueryProjectState) -> (LabelSiteFile, QueryProjectState) with Env + Fs {
  // ADR-0120 Phase 4: the labels the codemod writes are not errors while it
  // types the program, its import walk included. A dependency the walk
  // publishes to the persistent cache meanwhile is stored without its
  // missing-label errors; they cost no wrong answer (a positional argument is
  // placed by position), and checking that dependency itself reports them.
  checker_required_labels_suspend(true)
  let answer = label_sites_file_typed(path = path, source = source, replacement = replacement, state = state)
  checker_required_labels_suspend(false)
  answer
}

fn label_sites_file_typed(path: String, source: String, replacement: Option[String], state: QueryProjectState) -> (LabelSiteFile, QueryProjectState) with Env + Fs {
  handle {
    let edit = match replacement {
      None => None,
      Some(r) => Some(QueryProjectEdit::{
        replacement: r,
        mismatch_message: "add-labels: the edited file cannot stand in for the ingested one; leaving it alone"
      })
    }
    let context = query_project_context_fs(path = path, source = source, replacement = edit, state = state)
    let written = match replacement {
      Some(r) => r,
      None => source
    }
    (label_sites_typed(path = path, source = written, entry_source = context.entry_source, import_env = context.import_env), context.state)
  } with { Exception::Throw(message) => (label_sites_failed(path = path, source = source, message = message), state) }
}

/// Check the ingested `entry_source` against `import_env` with the site
/// capture on.
fn label_sites_typed(path: String, source: String, entry_source: String, import_env: TypeEnv) -> LabelSiteFile {
  let delta = String::length(entry_source) - String::length(source)
  if delta < 0 {
    label_sites_failed(path = path, source = source, message = "add-labels: refusing to edit this file -- its ingested source is not the file plus a prefix")
  } else {
    label_sites_begin()
    let checked = handle {
      // A fresh parse: the checker mutates the statements it is handed.
      let (tokens, starts, _) = lex_with_offsets(entry_source)
      let stmts = parse_program_located(tokens = tokens, starts = starts, source = entry_source)
      let _ = check_program_with_projected_import_env_result(stmts = stmts, initial_env = import_env)
      ""
    } with { Exception::Throw(message) => message }
    let sites = label_sites_end()
    if String::length(checked) > 0 {
      label_sites_failed(path = path, source = source, message = checked)
    } else {
      LabelSiteFile::{
        path: path,
        source: source,
        offset_delta: delta,
        sites: sites,
        error: ""
      }
    }
  }
}

/// Type every file in `files` (paths to `.vibe` sources) and record its
/// resolved call sites.
export fn query_label_sites_fs(_ files: Array[String]) -> Array[LabelSiteFile] with Env + Exception + Fs {
  let out: Array[LabelSiteFile] = []
  let mut state = query_project_state_new()
  let mut i = 0
  while i < Array::length(files) {
    let path = Array::get(files, at = i)
    let (answer, next_state) = label_sites_file(path = path, source = Fs::read_file(path), replacement = None, state = state)
    state = next_state
    Array::push(out, value = answer)
    i = i + 1
  }
  out
}

/// Does `edited`, standing in for the file at `path` (which reads `source`),
/// still check? "" when it does, else the checker's message. The codemod asks
/// this of every edit before it reports or writes it.
export fn query_label_sites_recheck_fs(path: String, source: String, edited: String) -> String with Env + Fs {
  let (answer, _) = label_sites_file(path = path, source = source, replacement = Some(edited), state = query_project_state_new())
  answer.error
}
