//# Imports

// ADR-0120 Phase 2a (#3679): the resolved call sites of each file, typed the
// way `vibe check` types it. The label codemod (`vibe refactor add-labels`)
// reads these rows; it never resolves a callee itself.
//
// The import walk is grep's typed tier (grep_fs.vibe): every reachable
// module's ingested source is seeded into the ripple db, the walk publishes
// each dependency's environment, and the entry is checked against the
// projected import environment. The three caches are threaded through the
// sweep for the same reason grep threads them (#2914).

import @vibe/compiler/core {
  TypeEnv
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/loader {
  collect_source_groups_fs
}

import @vibe/compiler/incremental {
  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_new, ripple_set_source
}

import @vibe/compiler/runtime {
  ensure_fingerprint_fs_impl, load_persistent_type_env, projected_import_env_for_test
}

import @vibe/compiler/checker {
  LabelSite, check_program_with_projected_import_env_result, label_sites_begin, label_sites_end
}

import @vibe/parser {
  lex_with_offsets, parse_program_located
}

//# Model

/// One file's answer. `source` is the file as written; the checker typed the
/// ingested source, which may carry a prepended directory-shared import, so a
/// site's offset minus `offset_delta` is its offset in `source`. `error` is ""
/// when the file checked cleanly, and otherwise the checker's message (the
/// file then has no sites: a codemod must not edit a program it could not
/// type).
// `LabelSiteFile` is defined in the package contract (index.vpkg), its single
// definition site.

//# Functions

fn label_sites_cache_has(cache: Array[(String, TypeEnv)], path: String) -> Bool {
  let mut found = false
  for entry in cache {
    let (p, _) = entry
    found = found || p == path
  }
  found
}

fn label_sites_fill_dep_envs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], deps: Array[String]) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  for dep in deps {
    if !label_sites_cache_has(env_cache, dep) {
      match ripple_get_fingerprint(rdb, dep) {
        Some(fingerprint) => match load_persistent_type_env(fingerprint) {
          Some(dep_env) => Array::push(env_cache, (dep, dep_env)),
          None => ()
        },
        None => ()
      }
    } else {
      ()
    }
  }
  env_cache
}

fn label_sites_failed(path: String, source: String, message: String) -> LabelSiteFile {
  LabelSiteFile::{
    path: path,
    source: source,
    offset_delta: 0,
    sites: array_empty(),
    error: message
  }
}

/// Type every file in `files` (paths to `.vibe` sources) and record its
/// resolved call sites.
export fn query_label_sites_fs(files: Array[String]) -> Array[LabelSiteFile] with Env + Exception + Fs {
  let out: Array[LabelSiteFile] = []
  let mut env_cache: Array[(String, TypeEnv)] = array_empty()
  let mut rdb = ripple_new()
  let mut dep_sources: Array[(String, String)] = array_empty()
  for path in files {
    let source = Fs::read_file(path)
    let answer = handle {
      let groups = collect_source_groups_fs(path)
      let mut entry_source = source
      for group in groups {
        let (_, sources) = group
        for pair in sources {
          let (p, text) = pair
          rdb = ripple_set_source(rdb, p, text)
          if p == path {
            entry_source = text
          } else {
            ()
          }
        }
      }
      let (_, walked, next_cache, next_dep_sources, _) = ensure_fingerprint_fs_impl(rdb, env_cache, dep_sources, 0, path)
      rdb = walked
      env_cache = next_cache
      dep_sources = next_dep_sources
      let deps = match ripple_get_deps(walked, path) {
        Some(d) => d,
        None => array_empty()
      }
      let import_env = projected_import_env_for_test(entry_source, path, deps, label_sites_fill_dep_envs(walked, env_cache, deps))
      let delta = String::length(entry_source) - String::length(source)
      if delta < 0 {
        label_sites_failed(path, source, "add-labels: refusing to edit this file -- its ingested source is not the file plus a prefix")
      } else {
        // A fresh parse: the checker mutates the statements it is handed.
        let (tokens, starts, _) = lex_with_offsets(entry_source)
        let stmts = parse_program_located(tokens, starts, entry_source)
        label_sites_begin()
        let checked = handle {
          let _ = check_program_with_projected_import_env_result(stmts, import_env)
          ""
        } with { Exception::Throw(message) => message }
        let sites = label_sites_end()
        if String::length(checked) > 0 {
          label_sites_failed(path, source, checked)
        } else {
          LabelSiteFile::{
            path: path,
            source: source,
            offset_delta: delta,
            sites: sites,
            error: ""
          }
        }
      }
    } with { Exception::Throw(message) => label_sites_failed(path, source, message) }
    Array::push(out, answer)
  }
  out
}
