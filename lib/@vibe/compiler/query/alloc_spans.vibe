//# `vibe allocs` — every site in a function that puts something on the heap.
//#
//# ADR-0091 (#1262), and the allocation-site instrumentation
//# docs/profiling.md already asked for. `#zero_alloc` needs to name the sites
//# it rejects, and a `bytes_per_op == 0` bench needs to say WHERE the bytes
//# came from when it is not 0; both want the same list, so it is built once
//# here and observable on its own.
//#
//# The value of this query is mostly in what it makes visible that the source
//# does not say out loud. An allocating builtin call is easy to see; a closure
//# literal quietly allocating its environment, a `let mut` becoming a heap ref
//# cell because something captured it, or a growable `push` reallocating on the
//# one call that crosses capacity are the ones people miss. Those are exactly
//# the "implicit allocation" ADR-0091 lists as the reason to build this.
//#
//# DIRECTION. Over-report, never under-report. This shares
//# `builtin_allocates`' polarity (core/builtin_registry.vibe): an unclassified
//# builtin counts as allocating. A site listed here that turns out to be free
//# costs the reader one line; a site NOT listed lets `#zero_alloc` certify
//# something untrue, silently.
//#
//# `push` is reported at every call, not just the ones that regrow. Whether a
//# given `Array::push` reallocates is a runtime property of that array's
//# capacity, so a static query cannot say; saying nothing would call an append
//# loop zero-alloc, which is the wrong direction.
//#
//# Output: one `FN KIND OFFSET` line per site, in source order within each
//# function, functions in declaration order. KIND is one of
//# `builtin:<name>` / `constructor:<name>` / `closure` / `array` / `tuple` /
//# `record` / `map` / `interp` / `float` / `handler` / `mut-cell` /
//# `operator:<type>:<op>`. Empty
//# output = this file allocates nothing, i.e. every function in it is already
//# zero-alloc.

//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, builtin_allocates, builtin_registry, expr_children, sorted_names_of
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_spans
}

import @vibe/compiler/codegen/common_analysis {
  is_mut_captured_in, lambda_has_captures, typed_operator_alloc_kind
}

//# Functions

fn alloc_empty_items() -> Array[(String, String, Int)] {
  array_empty()
}

fn alloc_empty_strings() -> Array[String] {
  array_empty()
}

struct AllocWalkContext {
  ctors: Array[String];
  global_index: Array[String];
  lambda_counter: Array[Int];
  names: Array[String];
  kinds: Array[String]
}

fn alloc_annotation_kind(_ annotation: Option[TypeExpr]) -> String {
  match annotation {
    Some(TyName(name)) => if name == "Int" || name == "Float64" || name == "String" || name == "Bool" {
      name
    } else {
      ""
    },
    _ => ""
  }
}

fn alloc_add_params(names: Array[String], kinds: Array[String], params: Array[(String, Option[TypeExpr])]) -> Unit {
  let mut i = 0
  while i < Array::length(params) {
    let (raw_name, annotation) = Array::get(params, at = i)
    let len = String::length(raw_name)
    let name = if len > 0 && String::char_code_at(raw_name, at = len - 1) == 63 {
      String::substring(raw_name, start = 0, end = len - 1)
    } else {
      raw_name
    }
    Array::push(names, value = name)
    Array::push(kinds, value = alloc_annotation_kind(annotation))
    i = i + 1
  }
}

fn alloc_context(ctors: Array[String], global_index: Array[String], params: Array[(String, Option[TypeExpr])]) -> AllocWalkContext {
  let names = alloc_empty_strings()
  let kinds = alloc_empty_strings()
  alloc_add_params(names = names, kinds = kinds, params = params)
  AllocWalkContext::{
    ctors: ctors,
    global_index: global_index,
    lambda_counter: [0],
    names: names,
    kinds: kinds
  }
}

fn alloc_context_for_lambda(ctx: AllocWalkContext, params: Array[(String, Option[TypeExpr])]) -> AllocWalkContext {
  let names = Array::slice(ctx.names, start = 0, end = Array::length(ctx.names))
  let kinds = Array::slice(ctx.kinds, start = 0, end = Array::length(ctx.kinds))
  alloc_add_params(names = names, kinds = kinds, params = params)
  AllocWalkContext::{
    ctors: ctx.ctors,
    global_index: ctx.global_index,
    lambda_counter: ctx.lambda_counter,
    names: names,
    kinds: kinds
  }
}

fn alloc_name_kind(ctx: AllocWalkContext, name: String) -> String {
  let mut i = Array::length(ctx.names) - 1
  let mut found = ""
  while i >= 0 && found == "" {
    if Array::get(ctx.names, at = i) == name {
      found = Array::get(ctx.kinds, at = i)
    } else {
      ()
    }
    i = i - 1
  }
  found
}

fn alloc_expr_kind(expr: Expr, ctx: AllocWalkContext) -> String {
  match expr {
    EInt(_) => "Int",
    EFloat(_) => "Float64",
    EString(_, _) => "String",
    EBool(_) => "Bool",
    EIdent(name, _) => alloc_name_kind(ctx = ctx, name = name),
    EBinOp(op, lhs, _, _) => if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
      "Bool"
    } else {
      alloc_expr_kind(expr = lhs, ctx = ctx)
    },
    EUnaryOp(op, operand) => if op == "!" {
      "Bool"
    } else {
      alloc_expr_kind(expr = operand, ctx = ctx)
    },
    _ => ""
  }
}

fn alloc_context_with_binding(ctx: AllocWalkContext, name: String, value: Expr) -> AllocWalkContext {
  let names = Array::slice(ctx.names, start = 0, end = Array::length(ctx.names))
  let kinds = Array::slice(ctx.kinds, start = 0, end = Array::length(ctx.kinds))
  Array::push(names, value = name)
  Array::push(kinds, value = alloc_expr_kind(expr = value, ctx = ctx))
  AllocWalkContext::{
    ctors: ctx.ctors,
    global_index: ctx.global_index,
    lambda_counter: ctx.lambda_counter,
    names: names,
    kinds: kinds
  }
}

fn alloc_context_with_name(ctx: AllocWalkContext, name: String) -> AllocWalkContext {
  alloc_context_with_binding(ctx = ctx, name = name, value = EUnit)
}

fn alloc_context_with_pattern(ctx: AllocWalkContext, pat: Pat) -> AllocWalkContext {
  match pat {
    PBind(name) => alloc_context_with_name(ctx = ctx, name = name),
    PCtor(_, args) => {
      let mut out = ctx
      let mut i = 0
      while i < Array::length(args) {
        out = alloc_context_with_pattern(ctx = out, pat = Array::get(args, at = i))
        i = i + 1
      }
      out
    },
    PTuple(items) => {
      let mut out = ctx
      let mut i = 0
      while i < Array::length(items) {
        out = alloc_context_with_pattern(ctx = out, pat = Array::get(items, at = i))
        i = i + 1
      }
      out
    },
    POr(left, _) => alloc_context_with_pattern(ctx = ctx, pat = left),
    PStruct(_, fields) => {
      let mut out = ctx
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_pat) = Array::get(fields, at = i)
        out = alloc_context_with_pattern(ctx = out, pat = field_pat)
        i = i + 1
      }
      out
    },
    _ => ctx
  }
}

fn alloc_contains_name(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(names) {
    if Array::get(names, at = i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn alloc_hex_nibble(_ n: Int) -> String {
  String::substring("0123456789ABCDEF", start = n, end = n + 1)
}

/// Encode an owner as one whitespace-free output field. Test and bench names
/// are arbitrary string literals, so they may contain spaces, newlines, tabs,
/// or `%` itself. Percent-encoding those bytes keeps `FN KIND OFFSET` exactly
/// three fields and remains reversible.
fn alloc_encode_owner(_ name: String) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < String::length(name) {
    let c = String::char_code_at(name, at = i)
    if c <= 32 || c == 37 || c == 127 {
      StringBuilder::push(out, value = "%")
      StringBuilder::push(out, value = alloc_hex_nibble((c / 16) % 16))
      StringBuilder::push(out, value = alloc_hex_nibble(c % 16))
    } else {
      StringBuilder::push(out, value = String::substring(name, start = i, end = i + 1))
    }
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// Source owner for a test/bench: the quoted name, or the keyword when the
/// parser handed back an empty string (same stand-in as symbols #2038).
fn alloc_block_owner(name: String, keyword: String) -> String {
  if String::length(name) == 0 {
    alloc_encode_owner(keyword)
  } else {
    alloc_encode_owner(name)
  }
}

/// The allocating-call name for `expr`, or "" when the call is not one.
/// Only direct `EIdent` callees are classified: an indirect call through a
/// value cannot be resolved here, and it is reported as a site anyway by the
/// closure rule (something had to build the closure).
fn alloc_call_kind(expr: Expr, ctors: Array[String]) -> String {
  match expr {
    ECall(callee, _, _, _) => match callee {
      // The callee EIdent is visited as a child and owns the constructor
      // record. Do not also mislabel the same source site as an unknown
      // builtin merely because constructors are absent from that registry.
      EIdent(name, _) => if alloc_contains_name(names = ctors, name = name) {
        ""
      } else if builtin_allocates(name) {
        String::concat("builtin:", name)
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// The site kind for `expr` itself (not its children), or "" when this node
/// allocates nothing on its own.
fn alloc_site_kind(expr: Expr, ctx: AllocWalkContext) -> String {
  let typed_operator = typed_operator_alloc_kind(expr = expr, names = ctx.names, kinds = ctx.kinds)
  if typed_operator != "" {
    typed_operator
  } else {
    match expr {
      EFloat(_) => "float",
      EIdent(name, _) => if alloc_contains_name(names = ctx.ctors, name = name) {
        String::concat("constructor:", name)
      } else {
        ""
      },
      EArray(_) => "array",
      ETuple(_) => "tuple",
      ERecord(_, _, _) => "record",
      EMap(_) => "map",
      EStringInterp(_) => "interp",
      EHandle(_, _) => "handler",
      _ => alloc_call_kind(expr = expr, ctors = ctx.ctors)
    }
  }
}

fn alloc_lambda_has_captures(expr: Expr, ctx: AllocWalkContext, self_name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => lambda_has_captures(body = body, params = params, fn_name_index = ctx.global_index, self_name = self_name, encl = ctx.names),
    _ => false
  }
}

fn alloc_lambda_owner(fname: String, hint: String, ordinal: Int) -> String {
  if hint != "" {
    String::concat(fname, String::concat("::", String::concat(alloc_encode_owner(hint), String::concat("@", __to_string(ordinal)))))
  } else {
    String::concat(fname, String::concat("::lambda@", __to_string(ordinal)))
  }
}

fn alloc_walk_lambda(out: Array[(String, String, Int)], fname: String, expr: Expr, fn_off: Int, ctx: AllocWalkContext, self_name: String, owner_hint: String) -> Unit {
  let here = alloc_site_offset(expr = expr, fallback = fn_off)
  let ordinal = Array::get(ctx.lambda_counter, at = 0)
  Array::set(ctx.lambda_counter, at = 0, value = ordinal + 1)
  if alloc_lambda_has_captures(expr = expr, ctx = ctx, self_name = self_name) {
    Array::push(out, value = (fname, "closure", here))
  } else {
    ()
  }
  match expr {
    EFn(_, _, params, _, _, body) => alloc_walk_expr(out = out, fname = alloc_lambda_owner(fname = fname, hint = owner_hint, ordinal = ordinal), expr = body, fn_off = here, ctx = alloc_context_for_lambda(ctx = ctx, params = params)),
    _ => ()
  }
}

/// The offset to report a site at. Only some Expr forms carry one -- `EFn`
/// notably does not -- so the rest fall back to the NEAREST ENCLOSING node
/// that did, threaded down by the walk. Without that inheritance a closure
/// site reports offset 0, which reads as "top of file" rather than "no span
/// here"; a site is never dropped for want of a span, but it should not lie
/// about where it is either.
fn alloc_site_offset(expr: Expr, fallback: Int) -> Int {
  let candidate = match expr {
    ECall(_, _, off, _) => off,
    EIdent(_, off) => off,
    ELet(_, _, _, off) => off,
    ELetMut(_, _, _, off) => off,
    _ => fallback
  }
  if candidate >= 0 {
    candidate
  } else {
    fallback
  }
}

fn alloc_walk_expr(out: Array[(String, String, Int)], fname: String, expr: Expr, fn_off: Int, ctx: AllocWalkContext) -> Unit {
  match expr {
    EFn(_, _, _, _, _, _) => alloc_walk_lambda(out = out, fname = fname, expr = expr, fn_off = fn_off, ctx = ctx, self_name = "", owner_hint = ""),
    _ => alloc_walk_non_lambda(out = out, fname = fname, expr = expr, fn_off = fn_off, ctx = ctx)
  }
}

fn alloc_walk_non_lambda(out: Array[(String, String, Int)], fname: String, expr: Expr, fn_off: Int, ctx: AllocWalkContext) -> Unit {
  let kind = alloc_site_kind(expr = expr, ctx = ctx)
  if String::length(kind) > 0 {
    Array::push(out, value = (fname, kind, alloc_site_offset(expr = expr, fallback = fn_off)))
  } else {
    ()
  }
  // A captured `let mut` is lowered to a heap ref cell, so the BINDING is an
  // allocation site even though nothing in the source looks like one. Asked
  // through codegen's own predicate, the same one `vibe escapes` reports, so
  // the two queries cannot disagree about which bindings those are.
  //
  // The scope handed to the predicate is the binding's OWN rest, not the
  // enclosing function body: given a body that still contains `let mut c`
  // itself, `is_mut_captured_in` reads `c` as locally bound and answers false.
  // `vibe escapes` asks it the same way, which is what keeps the two queries
  // from disagreeing about which bindings get boxed.
  match expr {
    ELetMut(n, _, rest, off) => if is_mut_captured_in(expr = rest, name = n) {
      Array::push(out, value = (fname, "mut-cell", off))
    } else {
      ()
    },
    _ => ()
  }
  let here = alloc_site_offset(expr = expr, fallback = fn_off)
  match expr {
    ELet(name, value, rest, _) => {
      match value {
        EFn(_, _, _, _, _, _) => alloc_walk_lambda(out = out, fname = fname, expr = value, fn_off = here, ctx = ctx, self_name = "", owner_hint = name),
        _ => alloc_walk_expr(out = out, fname = fname, expr = value, fn_off = here, ctx = ctx)
      }
      alloc_walk_expr(out = out, fname = fname, expr = rest, fn_off = here, ctx = alloc_context_with_binding(ctx = ctx, name = name, value = value))
    },
    ELetRec(name, value, rest) => {
      let body_ctx = alloc_context_with_binding(ctx = ctx, name = name, value = value)
      match value {
        EFn(_, _, _, _, _, _) => alloc_walk_lambda(out = out, fname = fname, expr = value, fn_off = here, ctx = body_ctx, self_name = name, owner_hint = name),
        _ => alloc_walk_expr(out = out, fname = fname, expr = value, fn_off = here, ctx = body_ctx)
      }
      alloc_walk_expr(out = out, fname = fname, expr = rest, fn_off = here, ctx = body_ctx)
    },
    ELetMut(name, value, rest, _) => {
      match value {
        EFn(_, _, _, _, _, _) => alloc_walk_lambda(out = out, fname = fname, expr = value, fn_off = here, ctx = ctx, self_name = "", owner_hint = name),
        _ => alloc_walk_expr(out = out, fname = fname, expr = value, fn_off = here, ctx = ctx)
      }
      alloc_walk_expr(out = out, fname = fname, expr = rest, fn_off = here, ctx = alloc_context_with_binding(ctx = ctx, name = name, value = value))
    },
    EMatch(scrutinee, arms) => {
      alloc_walk_expr(out = out, fname = fname, expr = scrutinee, fn_off = here, ctx = ctx)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, at = i)
        alloc_walk_expr(out = out, fname = fname, expr = body, fn_off = here, ctx = alloc_context_with_pattern(ctx = ctx, pat = pat))
        i = i + 1
      }
    },
    EHandle(scrutinee, arms) => {
      alloc_walk_expr(out = out, fname = fname, expr = scrutinee, fn_off = here, ctx = ctx)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, at = i)
        alloc_walk_expr(out = out, fname = fname, expr = body, fn_off = here, ctx = alloc_context_with_pattern(ctx = ctx, pat = pat))
        i = i + 1
      }
    },
    ELoop(params, body) => {
      let mut body_ctx = ctx
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, at = i)
        alloc_walk_expr(out = out, fname = fname, expr = init, fn_off = here, ctx = ctx)
        body_ctx = alloc_context_with_name(ctx = body_ctx, name = name)
        i = i + 1
      }
      alloc_walk_expr(out = out, fname = fname, expr = body, fn_off = here, ctx = body_ctx)
    },
    EForIn(name, index, iterable, body) => {
      alloc_walk_expr(out = out, fname = fname, expr = iterable, fn_off = here, ctx = ctx)
      let item_ctx = alloc_context_with_name(ctx = ctx, name = name)
      let body_ctx = match index {
        Some(index_name) => alloc_context_with_name(ctx = item_ctx, name = index_name),
        None => item_ctx
      }
      alloc_walk_expr(out = out, fname = fname, expr = body, fn_off = here, ctx = body_ctx)
    },
    _ => {
      let kids = expr_children(expr)
      let mut i = 0
      while i < Array::length(kids) {
        alloc_walk_expr(out = out, fname = fname, expr = Array::get(kids, at = i), fn_off = here, ctx = ctx)
        i = i + 1
      }
    }
  }
}

/// `parse_program_spans` resolves `#cfg` against the active flag set (#2497
/// step 0), which is the right answer for module-source emission and the
/// editor queries but not for this one: it is a source inventory whose
/// contract is never to under-report a possible allocation site, so it must
/// count both active and inactive guarded declarations. Blanking recognized
/// directive lines byte-for-byte keeps every declaration in the parse and
/// every offset in the ORIGINAL source.
fn alloc_blank_directives(_ source: String) -> String {
  let out = StringBuilder::new()
  let len = String::length(source)
  let mut pos = 0
  while pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, at = nl) != 10 {
      nl = nl + 1
    }
    let line = String::substring(source, start = pos, end = nl)
    let trimmed = String::trim(line)
    let recognized = trimmed == "#deprecated" || trimmed == "#zero_alloc" || String::starts_with(trimmed, prefix = "#deprecated(") || String::starts_with(trimmed, prefix = "#zero_alloc(") || String::starts_with(trimmed, prefix = "#cfg(") || String::starts_with(trimmed, prefix = "#cfg_enable(")
    if recognized {
      let mut i = 0
      while i < String::length(line) {
        StringBuilder::push(out, value = " ")
        i = i + 1
      }
    } else {
      StringBuilder::push(out, value = line)
    }
    if nl < len {
      StringBuilder::push(out, value = "\n")
    } else {
      ()
    }
    pos = nl + 1
  }
  StringBuilder::freeze(out)
}

/// Every heap-allocating site in `source`, as `(fn_name, kind, offset)`.
///
/// Propagates a lex/parse Error rather than swallowing it into an empty list:
/// the caller routes it to the `.diag` sidecar, so "the query failed" stays
/// distinguishable from "this file allocates nothing" (the `symbol_spans`
/// convention, #946 — and here the two would otherwise be the same output for
/// opposite facts).
export fn alloc_spans(_ source: String) -> Array[(String, String, Int)] with Exception {
  let parse_source = alloc_blank_directives(source)
  let (tokens, starts, ends) = lex_with_offsets(parse_source)
  let (stmts, span_start, _span_end) = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
  let out = alloc_empty_items()
  let ctors = alloc_empty_strings()
  let globals = alloc_empty_strings()
  let registry = builtin_registry()
  let mut bi = 0
  while bi < Array::length(registry) {
    let (name, _, _, _, _) = Array::get(registry, at = bi)
    Array::push(globals, value = name)
    bi = bi + 1
  }
  let mut ci = 0
  while ci < Array::length(stmts) {
    match Array::get(stmts, at = ci) {
      SEnum(_, _, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = vi)
          Array::push(ctors, value = vname)
          Array::push(globals, value = vname)
          vi = vi + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = vi)
          Array::push(ctors, value = vname)
          Array::push(globals, value = vname)
          vi = vi + 1
        }
      },
      SStruct(_, name, _, _, _, _) => {
        Array::push(ctors, value = name)
        Array::push(globals, value = name)
      },
      SLet(_, _, name, _, EFn(_, _, _, _, _, _)) => Array::push(globals, value = name),
      _ => ()
    }
    ci = ci + 1
  }
  let global_index = sorted_names_of(globals)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt_off = if i < Array::length(span_start) {
      Array::get(span_start, at = i)
    } else {
      0
    }
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, params, _, _, fbody) => alloc_walk_expr(out = out, fname = name, expr = fbody, fn_off = stmt_off, ctx = alloc_context(ctors = ctors, global_index = global_index, params = params)),
        _ => ()
      },
      // Tests and benches lower to real executable functions. In particular,
      // a bytes-per-op regression asks about the bench body itself, so
      // skipping SBench would turn an allocating benchmark into false-clean
      // output. Owner is the source name (empty → keyword, same as symbols
      // #2038), still percent-encoded so FN stays one field (#1944).
      STest(test_name, test_body) => alloc_walk_expr(out = out, fname = alloc_block_owner(name = test_name, keyword = "test"), expr = test_body, fn_off = stmt_off, ctx = alloc_context(ctors = ctors, global_index = global_index, params = array_empty())),
      SBench(bench_name, bench_body) => alloc_walk_expr(out = out, fname = alloc_block_owner(name = bench_name, keyword = "bench"), expr = bench_body, fn_off = stmt_off, ctx = alloc_context(ctors = ctors, global_index = global_index, params = array_empty())),
      _ => ()
    }
    i = i + 1
  }
  out
}
