//# Imports

// #946: `symbol_spans` used to swallow every failure (a lex/parse error on
// the source) into a bare empty list -- indistinguishable from "this file
// legitimately declares no symbols". It now propagates the Error instead, so
// the CLI adapter's `.diag` sidecar (cli_adapter.vibe's
// VIBE_SYMBOLS handling) can report the real cause instead of a silent empty
// outline.

import ./symbol_spans.vibe {
  symbol_spans, symbol_spans_with_docs
}

//# Functions

fn sym_has(syms: Array[(String, Int, Int, Int)], name: String, kind: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(syms) {
    let (n, k, _, _) = Array::get(syms, i)
    if n == name && k == kind {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn sym_fmt(syms: Array[(String, Int, Int, Int)]) -> String {
  let acc = StringBuilder::new()
  let mut i = 0
  while i < Array::length(syms) {
    let (n, k, _, _) = Array::get(syms, i)
    if i > 0 {
      StringBuilder::push(acc, ", ")
    } else {
      ()
    }
    StringBuilder::push(acc, n)
    StringBuilder::push(acc, " ")
    StringBuilder::push(acc, __to_string(k))
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

//# Misc

/// `NAME=DOC` per symbol that carries one, so a test can assert the pairing
/// without depending on offsets.
fn sym_doc_fmt(syms: Array[(String, Int, Int, Int, String)]) -> String {
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < Array::length(syms) {
    let (name, _kind, _s, _e, doc) = Array::get(syms, i)
    if String::length(doc) == 0 {
      ()
    } else {
      if first {
        first = false
      } else {
        StringBuilder::push(acc, ", ")
      }
      StringBuilder::push(acc, name)
      StringBuilder::push(acc, "=")
      StringBuilder::push(acc, doc)
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

test "symbol_spans_with_docs: a `///` block attaches to the declaration below it" {
  let src = "/// Doubles it.\nfn twice(x: Int) -> Int { x * 2 }\nfn plain(y: Int) -> Int { y }\n"
  let syms = symbol_spans_with_docs(src)
  // Both declarations are outlined; only the documented one carries text.
  assert(Array::length(syms) == 2)
  inspect(sym_doc_fmt(syms), "twice=Doubles it.")
}

test "symbol_spans_with_docs: a multi-line doc keeps its newlines here" {
  // The CLI escapes them to keep one record on one line; this layer is the
  // structured answer and hands back the real text.
  let src = "/// One.\n/// Two.\nfn f() -> Int { 1 }\n"
  let syms = symbol_spans_with_docs(src)
  let (_n, _k, _s, _e, doc) = Array::get(syms, 0)
  assert(doc == "One.\nTwo.")
}

test "symbol_spans_with_docs: the outline matches symbol_spans exactly" {
  // Both go through symbol_spans_impl, so a doc comment must never add,
  // drop, or move a symbol -- only annotate one.
  let src = "/// Doc.\nfn a() -> Int { 1 }\nstruct P { x: Int }\n/// Doc2.\nfn b() -> Int { 2 }\n"
  let plain = symbol_spans(src)
  let withd = symbol_spans_with_docs(src)
  assert(Array::length(plain) == Array::length(withd))
  let mut i = 0
  while i < Array::length(plain) {
    let (pn, pk, ps, pe) = Array::get(plain, i)
    let (dn, dk, ds, de, _doc) = Array::get(withd, i)
    assert(pn == dn)
    assert(pk == dk)
    assert(ps == ds)
    assert(pe == de)
    i = i + 1
  }
}

test "symbol_spans: a clean file returns its declarations" {
  let syms = symbol_spans("export fn f(x: Int) -> Int { x + 1 }\n")
  assert(Array::length(syms) == 1)
  assert(sym_has(syms, "f", 12))
}

test "symbol_spans: fn, named test, and named bench are outlined (#1944, kinds 27/28 since #2632)" {
  let src = "fn add(a: Int, b: Int) -> Int { a + b }\ntest \"adds\" { let _ = add(1, 2) }\nbench \"once\" { let _ = add(1, 1) }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "add 12, adds 27, once 28")
  assert(sym_has(syms, "add", 12))
  assert(sym_has(syms, "adds", 27))
  assert(sym_has(syms, "once", 28))
}

test "symbol_spans: a block label and a declaration of the same spelling differ by kind (#2632)" {
  let src = "fn not() -> Bool {\n  true\n}\n\ntest \"not\" {\n  let _ = 1\n}\n"
  inspect(sym_fmt(symbol_spans(src)), "not 12, not 27")
}

test "symbol_spans: a label's span is the text inside the quotes" {
  // `test "adds"` -- the label starts at byte 6, after `test "`.
  let syms = symbol_spans("test \"adds\" {\n  let _ = 1\n}\n")
  let (name, kind, s, e) = Array::get(syms, 0)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))))), "adds 27 6 10")
}

test "symbol_spans: a raw-string label starts after the r and the quote (Codex on #2708)" {
  // `test r"adds"` -- the TString token starts at the `r` (byte 5), so the
  // label's own bytes are 7..11, not 6..11.
  let syms = symbol_spans("test r\"adds\" {\n  let _ = 1\n}\n")
  let (name, kind, s, e) = Array::get(syms, 0)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))))), "adds 27 7 11")
}

test "symbol_spans: a #| block label starts after the delimiter (Codex on #2708)" {
  // `test #|adds` with the block on the next line: the token starts at the
  // `#` (byte 5) and ends at the line end (11); the label is 7..11.
  let syms = symbol_spans("test #|adds\n{\n  let _ = 1\n}\n")
  let (name, kind, s, e) = Array::get(syms, 0)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))))), "adds 27 7 11")
}

test "symbol_spans: a multi-line #| label reports the whole literal token (Codex on #2718)" {
  // `test #|one` continued by `     #|two` at the same column. The lexer
  // joins the two lines as "one\ntwo" and drops the indentation and the
  // second `#|`, so NO interval holds the content and nothing else: bytes
  // 7..21 would read `one\n     #|two`, presenting the delimiters as label
  // text. The literal token (5..21) is reported instead.
  let src = "test #|one\n     #|two\n{\n  let _ = 1\n}\n"
  let syms = symbol_spans(src)
  let (_, kind, s, e) = Array::get(syms, 0)
  assert(sym_has(syms, "one\ntwo", 27))
  inspect(String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))), "27 5 21")
}

test "symbol_spans: a #| label's span stops before a CRLF's carriage return (Codex on #2718)" {
  // The lexer strips the `\r` from each line's content but ends the token at
  // the `\n`, so the byte before the token's end is not label text.
  let syms = symbol_spans("test #|adds\r\n{\n  let _ = 1\n}\n")
  let (name, kind, s, e) = Array::get(syms, 0)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))))), "adds 27 7 11")
}

test "symbol_spans: a declaration is located at its token, never at a copy inside a comment (#2632)" {
  // The #2626 counterexample: the comment carries the name first (bytes
  // 14..28, quoted on both sides); the declaration's own token is at 30.
  let src = "export fn // \"String::length\"\nString::length(s: String) -> Int {\n  0 - 1\n}\n"
  let syms = symbol_spans(src)
  let (name, kind, s, e) = Array::get(syms, 0)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e))))))), "String::length 12 30 44")
}

test "symbol_spans: a string literal holding the name is not the declaration either (#2632)" {
  // The binder's own token is at byte 4; the literal after it spells the
  // same name and is one TString token, which the scan never takes.
  let src = "let greet = (\"greet\", 1)\nlet after = 2\n"
  inspect(sym_fmt(symbol_spans(src)), "greet 13, after 13")
  let (_, _, s, _) = Array::get(symbol_spans(src), 0)
  inspect(__to_string(s), "4")
}

test "symbol_spans: an impl is located after `for`, so `impl T for T` names the target (#2632)" {
  // Syntax only (parse_program_spans does not check), so a trait and a struct
  // may share a spelling here: `impl Show for Show` -- the Method symbol is
  // the target after `for` (byte 52), not the trait mention (byte 43) the
  // first-occurrence scan used to take.
  let src = "trait Show { }\nstruct Show { x: Int }\nimpl Show for Show { }\n"
  let syms = symbol_spans(src)
  let (name, kind, s, _) = Array::get(syms, 2)
  inspect(String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", __to_string(s))))), "Show 6 52")
}

test "symbol_spans: empty test/bench names emit the keyword so outline is not empty (#1944)" {
  // The parser rejects unnamed `test { }` / `bench { }` (needs a string
  // literal). An empty string is the stable stand-in for that missing name.
  let src = "test \"\" { let _ = 1 }\nbench \"\" { let _ = 1 }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "test 27, bench 28")
}

test "symbol_spans: impl is one Method symbol named after the target type (#1944)" {
  let src = "trait Show { }\nstruct Point { x: Int }\nimpl Show for Point { }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "Show 11, Point 23, Point 6")
}

test "symbol_spans: a genuinely empty (comments-only) file returns an empty list, not an error" {
  let syms = symbol_spans("// just a comment\n")
  assert(Array::length(syms) == 0)
}

test "symbol_spans: a lex error propagates instead of silently returning empty (#946)" {
  let msg = handle {
    let _ = symbol_spans("export fn f() -> Int {\n  1 $ 2\n}\n")
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "unexpected character"))
}
