//# `mutation_sites`: the edits `vibe mutate` applies, and the ones it must not.
//#
//# Every row is `START-END KIND ORIGINAL->REPLACEMENT`, rendered from the real
//# sites so a wrong offset shows up as a wrong number, not as a passing count.

//# Imports

import ./mutants.vibe {
  mutation_apply, mutation_sites
}

//# Functions

fn mt_render(source: String) -> String with Exception {
  let sites = mutation_sites(source)
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(sites) {
    let (start, end, kind, original, replacement) = Array::get(sites, i)
    Array::push(out, "\{start}-\{end} \{kind} \{original}->\{replacement}")
    i = i + 1
  }
  String::join(out, "\n")
}

/// Each site, applied, as the edited source's text at the site.
fn mt_applied(source: String) -> String with Exception {
  let sites = mutation_sites(source)
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(sites) {
    let (start, end, _, _, replacement) = Array::get(sites, i)
    Array::push(out, mutation_apply(source, start, end, replacement))
    i = i + 1
  }
  String::join(out, "\n")
}

//# Tests

test "operators get boundary, negation and swap sites at the operator token" {
  let src = "fn f(x: Int, y: Int) -> Bool { x < y && x + 1 != y }\n"
  inspect(mt_render(src), "33-34 boundary <-><=\n33-34 negate <->>=\n37-39 logic &&->||\n42-43 arith +->-\n44-45 const 1->0\n46-48 negate !=->==")
}

test "the replacement lands exactly on the original text" {
  inspect(mt_applied("fn f(a: Int) -> Int { a * 2 }\n"), "fn f(a: Int) -> Int { a / 2 }\n\nfn f(a: Int) -> Int { a * 3 }\n")
}

test "literals: bools flip, 0 and 1 swap, other integers move by one" {
  let src = "fn f() -> (Bool, Int, Int, Int) { (false, 0, 1, 41) }\n"
  inspect(mt_render(src), "35-40 bool false->true\n42-43 const 0->1\n45-46 const 1->0\n48-50 const 41->42")
}

test "a `!` is deleted, and a unary minus is not an arithmetic site" {
  let src = "fn f(b: Bool, n: Int) -> Bool { !b && -n > 0 }\n"
  inspect(mt_render(src), "32-33 not !->\n35-37 logic &&->||\n41-42 boundary >->>=\n41-42 negate >-><=\n43-44 const 0->1")
}

test "test, bench and example blocks are the oracle and are never mutated" {
  let src = "fn id(x: Int) -> Int { x }\ntest \"t\" { assert(id(1) < 2) }\nbench \"b\" { let _ = id(3) + 4 }\n"
  inspect(mt_render(src), "")
}

test "a hex literal reads back as another spelling and is left alone" {
  inspect(mt_render("fn f() -> Int { 0xFF }\n"), "")
}

test "top-level lets, impl methods and nested lambdas are all code under test" {
  let src = "let k = 2\nstruct P { x: Int }\ntrait Twice {\n  twice(Self) -> Int\n}\nimpl Twice for P {\n  twice(p: P) -> Int { p.x * k }\n}\nfn g() -> (Int) -> Bool { (v) -> v == 3 }\n"
  inspect(mt_render(src), "8-9 const 2->3\n113-114 arith *->/\n156-158 negate ==->!=\n159-160 const 3->4")
}

test "sites come back in source order with no duplicates" {
  let src = "fn f(a: Int, b: Int) -> Int { (a + b) - (a - b) }\n"
  inspect(mt_render(src), "33-34 arith +->-\n38-39 arith -->+\n43-44 arith -->+")
}

test "a where-contract's conditions are code under test" {
  let src = "fn f(x: Int) -> Int\n  where { requires: x >= 0, ensures: result < 9 } { x }\n"
  inspect(mt_render(src), "42-44 boundary >=->>\n42-44 negate >=-><\n45-46 const 0->1\n64-65 boundary <-><=\n64-65 negate <->>=\n66-67 const 9->10")
}

test "an interpolation hole is code under test" {
  // The `+` and the literals inside the holes, at their offsets in the file;
  // the brace inside the nested string literal does not end the hole.
  let src = "fn f(x: Int) -> String { \"v=\\{x + 1} w=\\{g(\"}\", x * 2)}\" }\n"
  inspect(mt_render(src), "32-33 arith +->-\n34-35 const 1->0\n50-51 arith *->/\n52-53 const 2->3")
}

test "an interpolation hole ends where the lexer ends it" {
  // A char literal `'}'` and a line comment holding a `}` are inside the
  // hole: the `-` and the `3` after them are still sites.
  let src = "fn f(x: Int) -> String { \"\\{g('}', x // }\n - 3)}\" }\n"
  inspect(mt_render(src), "43-44 arith -->+\n45-46 const 3->4")
}

test "an if condition is forced each way, even with no operator in it" {
  // `is_zero(d)` holds nothing the operator kinds rewrite; forcing it is
  // what tells a test that pins the branch from one that never reaches it.
  let src = "fn f(d: Int) -> Int { if is_zero(d) { 1 } else { 2 } }\n"
  inspect(mt_render(src), "25-35 cond is_zero(d)->true\n25-35 cond is_zero(d)->false\n38-39 const 1->0\n49-50 const 2->3")
}

test "a while condition is only forced false, and a literal condition is left to the bool kind" {
  let src = "fn g(n: Int) -> Int {\n  let mut i = 0\n  while i < n {\n    i = i + 1\n  }\n  if true { i } else { 0 }\n}\n"
  inspect(mt_render(src), "36-37 const 0->1\n46-51 cond i\\s<\\sn->false\n48-49 boundary <-><=\n48-49 negate <->>=\n64-65 arith +->-\n66-67 const 1->0\n77-81 bool true->false\n95-96 const 0->1")
}

test "a condition with spaces is one field, escaped like a test label" {
  inspect(mt_render("fn f(d: Int) -> Bool { if d == 0 { true } else { false } }\n"), "26-32 cond d\\s==\\s0->true\n26-32 cond d\\s==\\s0->false\n28-30 negate ==->!=\n31-32 const 0->1\n35-39 bool true->false\n49-54 bool false->true")
}

test "an `if x is P` decision is forced when P binds nothing" {
  // `is None` reads no binder, so the condition becomes a plain bool; the
  // `Some(v)` branch reads `v` and has no viable forced form.
  let src = "fn f(o: Option[Int]) -> Int { if o is None { 0 } else { 1 } }\nfn g(o: Option[Int]) -> Int { if o is Some(v) { v } else { 2 } }\n"
  inspect(mt_render(src), "33-42 cond o\\sis\\sNone->true\n33-42 cond o\\sis\\sNone->false\n45-46 const 0->1\n56-57 const 1->0\n121-122 const 2->3")
}

test "a grouped scrutinee is replaced from its opening parenthesis" {
  inspect(mt_applied("fn f(o: Option[Int]) -> Int { if (o) is None { 0 } else { 1 } }\n"), "fn f(o: Option[Int]) -> Int { if true { 0 } else { 1 } }\n\nfn f(o: Option[Int]) -> Int { if false { 0 } else { 1 } }\n\nfn f(o: Option[Int]) -> Int { if (o) is None { 1 } else { 1 } }\n\nfn f(o: Option[Int]) -> Int { if (o) is None { 0 } else { 0 } }\n")
}
