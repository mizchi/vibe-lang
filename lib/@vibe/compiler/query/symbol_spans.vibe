//# Imports

// `vibe symbols` — AST-accurate top-level (and module-nested) declaration spans:
// the foundation for scope-precision document outline / go-to-definition
// (テーマ4 LSP). Given a source string, return one record per declared symbol:
//   (name, kind, start, end)
// where `kind` is an LSP SymbolKind number and [start, end) is the source span
// of the declaration NAME (char offsets).
//
// SymbolKind legend v1 (2026-08-17). KIND integers are LSP SymbolKind.
// Machine-readable copy: `vibe symbols --legend` (one `KIND NAME` per line).
//   2  Module         `module`
//   6  Method         `impl Trait for T` (named after T)
//   10 Enum           `enum`, `suberror`
//   11 Interface      `trait`
//   12 Function       `fn`, let-bound functions
//   13 Variable       other `let` / `let mut`
//   23 Struct         `struct`
//   24 Event          `effect`
//   26 TypeParameter  `type` alias
//   27 Test           a `test "X"` block (v2, #2632 -- not an LSP kind)
//   28 Bench          a `bench "X"` block (v2, #2632 -- not an LSP kind)
//
// Legend v2 (2026-09-12, #2632): a `test` / `bench` block used to be reported
// under its quoted label as Function (12), which left no consumer able to
// tell a block label from a real declaration of the same spelling
// (`test "Int::popcount"` read as a definition of `Int::popcount` to
// scripts/check_builtin_shadowing.sh). 27 and 28 are outside LSP's SymbolKind
// range on purpose; `lib/@vibe/lsp` maps them back to Function (12) at the
// protocol boundary, where the client has no Test kind either.
//
// Why this beats the LSP server's previous line-regex scan: declarations are
// taken from the real parsed AST, so multi-line declarations, declarations not
// starting at column 0, and names that merely look like keywords inside strings
// or comments are handled correctly — only actual declaration nodes count. The
// name's source offset is the TOKEN that spells it -- the identifier token, or
// the `A::b` identifier run, scanned from the statement's own parse span (from
// parse_program_spans) -- so a copy of the name inside a comment or a string
// literal, which the lexer never tokenizes as an identifier, cannot win
// (#2632: `export fn // "String::length"` on one line and `String::length(..)`
// on the next used to report the copy inside the comment).
//
// FALLBACK (honest): a name whose offset cannot be recovered within its span is
// simply omitted (never a crash). A genuine lex/parse failure on the source
// itself, though, is NOT swallowed here (#946) -- it propagates as an Error so
// the caller can tell "this file has no symbols" apart from "resolution
// failed"; see cli_adapter.vibe's VIBE_SYMBOLS handling.
//
// All strings are built with String::concat only (never `+`, never "\{x}"
// interpolation): both mis-codegen to NUL here.

import @vibe/compiler/core {
  Expr, Stmt, is_contract_ext
}

import @vibe/compiler/contract {
  contract_parse_error_offset, extract_require_pins, parse_contract_program_spans_opaque_at
}

import @vibe/core {
  array_empty
}

import @vibe/parser {
  float_width_alias, intern_qualified
}

import @vibe/compiler/syntax {
  Token, collect_doc_comments, lex_with_offsets, line_start_offsets, offset_to_line_col, offset_to_line_col_indexed, parse_program_spans
}

//# Functions

/// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box),
/// built via slice+push so the cell is a heap array supporting Array::set.
fn sym_box_int(_ v: Int) -> Array[Int] {
  let arr = array_empty()
  Array::push(arr, value = v)
  arr
}

fn sym_empty_items() -> Array[(String, Int, Int, Int)] {
  array_empty()
}

/// Lower bound over the (sorted) token start offsets: the first token index
/// whose start is >= `off`.
fn sym_first_token_at(starts: Array[Int], off: Int) -> Int {
  let mut lo = 0
  let mut hi = Array::length(starts)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(starts, at = mid) < off {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

/// Does the identifier at `at` spell part `j` of `parts`? Literally, or by
/// the canonical spelling the parser gave the declaration (ADR-0122):
/// `impl Hash for Double` names `Float64`, and `fn Double::to_float` names
/// `Float64::to_float32`, so the token the name was read from says `Double` /
/// `to_float`.
fn sym_ident_spells(tokens: Array[Token], at: Int, j: Int, parts: Array[String]) -> Bool {
  let part = Array::get(parts, at = j)
  match Array::get(tokens, at = at) {
    TIdent(s) => if s == part {
      true
    } else if j == 0 {
      float_width_alias(s) == part
    } else if j == 1 && at >= 2 {
      match Array::get(tokens, at = at - 2) {
        TIdent(ns) => intern_qualified(ns = ns, member = s) == String::concat(Array::get(parts, at = 0), String::concat("::", part)),
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

fn sym_is_double_colon(_ t: Token) -> Bool {
  match t {
    TDoubleColon => true,
    _ => false
  }
}

/// Does the token run starting at `k` spell `parts`, the `::`-split name --
/// `TIdent(p0)`, then `TDoubleColon TIdent(p1)` per further part? The index
/// of the run's last token when it does, -1 otherwise.
fn sym_match_name_at(tokens: Array[Token], k: Int, parts: Array[String]) -> Int {
  let n = Array::length(tokens)
  let nparts = Array::length(parts)
  let mut at = k
  let mut j = 0
  let mut ok = true
  while ok && j < nparts {
    if j > 0 {
      if at < n && sym_is_double_colon(Array::get(tokens, at = at)) {
        at = at + 1
      } else {
        ok = false
      }
    } else {
      ()
    }
    if ok {
      if at < n && sym_ident_spells(tokens = tokens, at = at, j = j, parts = parts) {
        j = j + 1
        if j < nparts {
          at = at + 1
        } else {
          ()
        }
      } else {
        ok = false
      }
    } else {
      ()
    }
  }
  if ok {
    at
  } else {
    -1
  }
}

/// Find the first TOKEN occurrence of `name` in [floor, hi) -- the identifier
/// token, or the `A::b` identifier run, that spells it -- and, when found,
/// push `(name, kind, start, end)` and advance `floor` past it (so a later
/// sibling declaration in the same window keeps scanning forward). No-op
/// when the name cannot be located in the window. A comment or a string
/// literal holding the same spelling is one token of another kind, so it
/// can never be the match (#2632).
fn sym_emit(out: Array[(String, Int, Int, Int)], tokens: Array[Token], starts: Array[Int], ends: Array[Int], name: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {
  if String::length(name) == 0 {
    ()
  } else {
    let parts = String::split(name, sep = "::")
    let ntok = Array::length(tokens)
    let mut k = sym_first_token_at(starts = starts, off = Array::get(floor, at = 0))
    let mut found = false
    while !found && k < ntok && Array::get(starts, at = k) < hi {
      let last = sym_match_name_at(tokens = tokens, k = k, parts = parts)
      if last >= 0 && Array::get(ends, at = last) <= hi {
        Array::push(out, value = (name, kind, Array::get(starts, at = k), Array::get(ends, at = last)))
        Array::set(floor, at = 0, value = Array::get(ends, at = last))
        found = true
      } else {
        k = k + 1
      }
    }
  }
}

fn sym_is_block_keyword(t: Token, keyword: String) -> Bool {
  match t {
    TTest => keyword == "test",
    TBench => keyword == "bench",
    _ => false
  }
}

fn sym_string_is(t: Token, text: String) -> Bool {
  match t {
    TString(s) => s == text,
    _ => false
  }
}

/// Does the source slice `[s, e)` cross a line boundary? Only a `#|` block
/// can, and only by continuing on the next physical line.
fn sym_span_has_newline(source: String, s: Int, e: Int) -> Bool {
  let n = String::length(source)
  let hi = if e < n {
    e
  } else {
    n
  }
  let mut i = s
  let mut found = false
  while i < hi && !found {
    if String::char_code_at(source, at = i) == '\n' {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The bytes of a string literal token's CONTENT, read from its delimiters
/// in the source: a plain `"…"` is one byte in on each side, a raw `r"…"`
/// two in and one back, and a single-line `#|…` block starts two in and runs
/// to the token's end. An unrecognised spelling keeps the whole token rather
/// than guessing. All three lex to one `TString`, so the token alone cannot
/// say which (Codex on #2708: `test r"name"` reported the opening quote as
/// the label's first byte).
///
/// A `#|` block that CONTINUES over several physical lines is the one
/// spelling whose content is not contiguous in the source: the lexer joins
/// each line's text with "\n" and drops the indentation and the continuation
/// `#|`, so no single interval holds the content and nothing else. There the
/// whole literal token is returned instead of a range that would present
/// those delimiters as label text (Codex on #2718). A trailing `\r` is not
/// content either way: the lexer strips it per line but ends the token at
/// the `\n`, so a CRLF source would otherwise carry it inside the span.
fn sym_string_content_span(source: String, s: Int, e: Int) -> (Int, Int) {
  let n = String::length(source)
  let c0 = if s < n {
    String::char_code_at(source, at = s)
  } else {
    0
  }
  let c1 = if s + 1 < n {
    String::char_code_at(source, at = s + 1)
  } else {
    0
  }
  if c0 == '"' {
    (s + 1, if e - 1 > s + 1 {
      e - 1
    } else {
      s + 1
    })
  } else if c0 == 'r' && c1 == '"' {
    (s + 2, if e - 1 > s + 2 {
      e - 1
    } else {
      s + 2
    })
  } else if c0 == '#' && c1 == '|' {
    let stop = if e > s && e <= n && String::char_code_at(source, at = e - 1) == '\r' {
      e - 1
    } else {
      e
    }
    if sym_span_has_newline(source = source, s = s, e = stop) {
      (s, stop)
    } else {
      (s + 2, if stop > s + 2 {
        stop
      } else {
        s + 2
      })
    }
  } else {
    (s, e)
  }
}

/// A `test "X"` / `bench "X"` block: its span is the label's text inside its
/// delimiters (the string literal token after the keyword --
/// `sym_string_content_span`), or the keyword itself when the label is empty
/// (the parser rejects an unnamed block; `test ""` is the stand-in, and the
/// keyword is the stable outline name for it, #1944). Kind 27 / 28, not
/// Function: a block label is not a declaration of the spelling it carries
/// (#2632).
fn sym_emit_block(out: Array[(String, Int, Int, Int)], source: String, tokens: Array[Token], starts: Array[Int], ends: Array[Int], label: String, keyword: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {
  let ntok = Array::length(tokens)
  let mut k = sym_first_token_at(starts = starts, off = Array::get(floor, at = 0))
  let mut found = false
  while !found && k < ntok && Array::get(starts, at = k) < hi {
    if sym_is_block_keyword(t = Array::get(tokens, at = k), keyword = keyword) {
      if String::length(label) == 0 {
        Array::push(out, value = (keyword, kind, Array::get(starts, at = k), Array::get(ends, at = k)))
        Array::set(floor, at = 0, value = Array::get(ends, at = k))
        found = true
      } else if k + 1 < ntok && sym_string_is(t = Array::get(tokens, at = k + 1), text = label) {
        let s = Array::get(starts, at = k + 1)
        let e = Array::get(ends, at = k + 1)
        let (cs, ce) = sym_string_content_span(source = source, s = s, e = e)
        Array::push(out, value = (label, kind, cs, ce))
        Array::set(floor, at = 0, value = e)
        found = true
      } else {
        k = k + 1
      }
    } else {
      k = k + 1
    }
  }
}

/// Advance `floor` past the first `for` keyword token in [floor, hi): an
/// `impl Trait for T` is named after `T`, and the token after `for` is where
/// `T` is spelled -- so a trait that happens to share the target's name
/// (`impl T for T`) cannot be mistaken for it.
fn sym_skip_past_for(tokens: Array[Token], starts: Array[Int], ends: Array[Int], floor: Array[Int], hi: Int) -> Unit {
  let ntok = Array::length(tokens)
  let mut k = sym_first_token_at(starts = starts, off = Array::get(floor, at = 0))
  let mut done = false
  while !done && k < ntok && Array::get(starts, at = k) < hi {
    match Array::get(tokens, at = k) {
      TFor => {
        Array::set(floor, at = 0, value = Array::get(ends, at = k))
        done = true
      },
      _ => k = k + 1
    }
  }
}

/// LSP SymbolKind for a top-level value binding: Function (12) when its body is a
/// lambda, else Variable (13).
fn sym_let_kind(_ body: Expr) -> Int {
  match body {
    EFn(_, _, _, _, _, _) => 12,
    _ => 13
  }
}

/// Emit the symbol for one statement within the window [floor, hi). SModule emits
/// the module name (kind 2 = Module) then recurses into its body, threading the
/// SAME advancing floor so nested declarations are located in source order.
/// Tests/benches are 27 / 28 (see the header). An `impl Trait for T` is one
/// Method (6) named after T, located after the `for` token: SImpl carries no
/// method children (`parse_program_spans` skips the body).
fn sym_walk_stmt(out: Array[(String, Int, Int, Int)], source: String, tokens: Array[Token], starts: Array[Int], ends: Array[Int], stmt: Stmt, floor: Array[Int], hi: Int) -> Unit {
  match stmt {
    SLet(_, _, name, _, body) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = sym_let_kind(body), floor = floor, hi = hi),
    SFnDecl(_, name, _, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 12, floor = floor, hi = hi),
    SLetMut(name, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 13, floor = floor, hi = hi),
    SEnum(_, name, _, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 10, floor = floor, hi = hi),
    SSuberror(_, name, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 10, floor = floor, hi = hi),
    SStruct(_, name, _, _, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 23, floor = floor, hi = hi),
    STypeAlias(_, name, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 26, floor = floor, hi = hi),
    STrait(_, name, _, _, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 11, floor = floor, hi = hi),
    SImpl(_, _, _, target) => {
      let type_name = match target {
        TyName(name) => name,
        TyApp(name, _) => name,
        _ => ""
      }
      sym_skip_past_for(tokens = tokens, starts = starts, ends = ends, floor = floor, hi = hi)
      sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = type_name, kind = 6, floor = floor, hi = hi)
    },
    SEffectDef(_, name, _, _) => sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 24, floor = floor, hi = hi),
    STest(name, _) => sym_emit_block(out = out, source = source, tokens = tokens, starts = starts, ends = ends, label = name, keyword = "test", kind = 27, floor = floor, hi = hi),
    SBench(name, _) => sym_emit_block(out = out, source = source, tokens = tokens, starts = starts, ends = ends, label = name, keyword = "bench", kind = 28, floor = floor, hi = hi),
    SModule(_, name, body) => {
      sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = name, kind = 2, floor = floor, hi = hi)
      let mut j = 0
      while j < Array::length(body) {
        sym_walk_stmt(out = out, source = source, tokens = tokens, starts = starts, ends = ends, stmt = Array::get(body, at = j), floor = floor, hi = hi)
        j = j + 1
      }
    },
    _ => ()
  }
}

/// Collect declaration symbols. Steps:
///   1. lex + parse with per-statement spans (parse_program_spans).
///   2. for each top-level statement, scan the TOKENS of its own [start, end)
///      span for the declaration name and emit (name, kind, start, end);
///      SModule recurses.
/// AST-accurate (see file header).
fn symbol_spans_impl(_ source: String) -> Array[(String, Int, Int, Int)] with Exception {
  {
    let (tokens, starts, ends) = lex_with_offsets(source)
    let (span_stmts, span_start, span_end) = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
    let out = sym_empty_items()
    let mut i = 0
    while i < Array::length(span_stmts) {
      let lo = if i < Array::length(span_start) {
        Array::get(span_start, at = i)
      } else {
        0
      }
      let hi = if i < Array::length(span_end) {
        Array::get(span_end, at = i)
      } else {
        String::length(source)
      }
      let floor = sym_box_int(lo)
      sym_walk_stmt(out = out, source = source, tokens = tokens, starts = starts, ends = ends, stmt = Array::get(span_stmts, at = i), floor = floor, hi = hi)
      i = i + 1
    }
    out
  }
}

/// #946: this used to swallow every failure (lex error, parse error) into a
/// bare empty list, making a genuine failure indistinguishable from "the file
/// legitimately declares no symbols" — the CLI adapter's `.diag` sidecar
/// convention (VIBE_SYMBOLS in cli_adapter.vibe) can only report the
/// difference if the Error actually reaches it. Propagate instead of
/// catching; the sole caller now routes it to that sidecar.
export fn symbol_spans(_ source: String) -> Array[(String, Int, Int, Int)] with Exception {
  symbol_spans_impl(source)
}

/// The `///` doc comment attached to the declaration on `line`, or "" when
/// there is none. `collect_doc_comments` keys a block by the line of the item
/// it attaches to, and a declaration's NAME sits on that same line (`fn f`,
/// `struct P`, ...), so the symbol's own start offset resolves the lookup.
fn sym_doc_for_line(docs: Array[(Int, String)], line: Int) -> String {
  let mut i = 0
  let mut found = ""
  while i < Array::length(docs) {
    let (doc_line, text) = Array::get(docs, at = i)
    if doc_line == line {
      found = text
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `symbol_spans` plus each declaration's `///` doc comment ("" when it has
/// none). Doc text keeps its real newlines here -- this is the structured
/// answer, for LSP document-symbol detail and for `vibe symbols`, which
/// escapes them itself to keep one record per line.
///
/// Separate from `symbol_spans` rather than replacing it: existing callers
/// destructure the 4-tuple, and a doc comment is information they did not ask
/// for. Both go through `symbol_spans_impl`, so the outline can never differ
/// between them.
export fn symbol_spans_with_docs(_ source: String) -> Array[(String, Int, Int, Int, String)] with Exception {
  sym_attach_docs(source = source, syms = symbol_spans_impl(source))
}

/// Attach each declaration's `///` doc comment to its outline row. Shared by
/// both grammars (#2898): the script lane and the contract lane differ in how
/// declarations are FOUND, never in how a doc comment attaches to one.
fn sym_attach_docs(source: String, syms: Array[(String, Int, Int, Int)]) -> Array[(String, Int, Int, Int, String)] {
  let docs = collect_doc_comments(source)
  let out = ArrayBuilder::new()
  // #2670: ONE pass for the line index, then a binary search per declaration.
  // `offset_to_line_col` counts newlines from offset 0 on every call, so this
  // loop was O(declarations x file length) -- measured at 41.3s of a 49.35s
  // `vibe symbols lib` sweep (83.7%), against 3.3% for all lexing and parsing.
  let line_starts = line_start_offsets(source)
  let mut i = 0
  while i < Array::length(syms) {
    let (name, kind, start, end) = Array::get(syms, at = i)
    let (line, _col) = offset_to_line_col_indexed(line_starts = line_starts, source = source, offset = start)
    ArrayBuilder::push(out, value = (name, kind, start, end, sym_doc_for_line(docs = docs, line = line)))
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

/// The kind for a contract `fn` / `let` declaration, read from the signature
/// text the contract parser produced: a bodyless value declaration is
/// fingerprinted as `val <type>` (#752), everything else in `decls` is a `fn`.
fn sym_contract_decl_kind(_ sig: String) -> Int {
  if String::starts_with(sig, prefix = "val ") {
    13
  } else {
    12
  }
}

/// Symbols for a package CONTRACT (`.vpkg`), which is not statement grammar.
///
/// #2898: `index.vpkg` IS a package's public API (ADR-0070) and `vibe symbols`
/// is the documented way to discover an API -- so the one file that is the API
/// was the one file the outline could not read. It answered `unexpected token:
/// type` for `lib/@vibe/core/index.vpkg`, because a bodyless `type List[T]` is
/// contract grammar and `parse_program_spans` only knows script grammar.
///
/// Three streams come back from the contract parser, each already in source
/// order and each carrying the TOKEN INDEX its entry started at: fn/val
/// declarations, opaque and bodyless types, and the ordinary statements a
/// contract may also hold (type aliases, impl markers). They are merged by
/// that index so the result is one source-ordered outline, which is what makes
/// `sym_emit`'s advancing floor correct.
///
/// The floor for each entry is set to the DECLARATION's own first token, not
/// left where the previous entry ended: the first token run spelling the name
/// at or after `fn` / `let` / `type` / `opaque` is the declaration's name for
/// every contract shape, so the anchor is exact rather than a search over the
/// whole file. Without it, `fn f(x: Int)` followed by `let x: Int` would
/// anchor the second declaration on the first one's PARAMETER.
///
/// The header (`name = @vibe/core`, `deps = { .. }`) is not vibe syntax, so it
/// is blanked first -- `extract_require_pins` preserves byte length, so every
/// offset here is an offset into the file the caller passed in.
///
/// A bodyless `type Name[T]` reports kind 26, the same kind the `type` keyword
/// gets in script grammar. It is not an alias, but one keyword answering with
/// two kinds depending on the file it sits in is the drift `--legend` exists
/// to prevent.
fn contract_symbol_spans_impl(_ source: String) -> Array[(String, Int, Int, Int)] with Exception {
  let (_pins, blanked) = extract_require_pins(source)
  let (tokens, starts, ends) = lex_with_offsets(blanked)
  let (decls, opaques, stmts, stmt_at, decl_at, opaque_at) = parse_contract_program_spans_opaque_at(tokens)
  let out = sym_empty_items()
  let hi = String::length(blanked)
  let ntok = Array::length(tokens)
  let mut di = 0
  let mut oi = 0
  let mut si = 0
  while di < Array::length(decls) || oi < Array::length(opaques) || si < Array::length(stmts) {
    let dtok = if di < Array::length(decl_at) {
      Array::get(decl_at, at = di)
    } else {
      ntok + 1
    }
    let otok = if oi < Array::length(opaque_at) {
      Array::get(opaque_at, at = oi)
    } else {
      ntok + 1
    }
    let stok = if si < Array::length(stmt_at) {
      Array::get(stmt_at, at = si)
    } else {
      ntok + 1
    }
    let pick = if dtok <= otok && dtok <= stok {
      0
    } else if otok <= stok {
      1
    } else {
      2
    }
    let tok = if pick == 0 {
      dtok
    } else if pick == 1 {
      otok
    } else {
      stok
    }
    let floor = sym_box_int(if tok >= 0 && tok < Array::length(starts) {
      Array::get(starts, at = tok)
    } else {
      0
    })
    if pick == 0 {
      let (dname, dsig) = Array::get(decls, at = di)
      sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = dname, kind = sym_contract_decl_kind(dsig), floor = floor, hi = hi)
      di = di + 1
    } else if pick == 1 {
      let (oname, _params) = Array::get(opaques, at = oi)
      sym_emit(out = out, tokens = tokens, starts = starts, ends = ends, name = oname, kind = 26, floor = floor, hi = hi)
      oi = oi + 1
    } else {
      sym_walk_stmt(out = out, source = blanked, tokens = tokens, starts = starts, ends = ends, stmt = Array::get(stmts, at = si), floor = floor, hi = hi)
      si = si + 1
    }
  }
  out
}

/// `symbol_spans_with_docs`, told which FILE the source came from -- the only
/// thing that decides whether it is script grammar or contract grammar
/// (#2898). Both lanes return the same five fields, so a caller cannot tell
/// them apart except by the rows it gets.
///
/// A path with no contract extension takes the script lane unchanged, so this
/// is a strict extension of the previous answer for every file that had one.
export fn symbol_spans_with_docs_for_path(path: String, source: String) -> Array[(String, Int, Int, Int, String)] with Exception {
  if is_contract_ext(path) {
    sym_attach_docs(source = source, syms = contract_symbol_spans_impl(source))
  } else {
    symbol_spans_with_docs(source)
  }
}

/// The message a failed outline should carry for `path`: the thrown text with
/// a `line L:col C:` prefix when the contract parser can say which token it
/// stopped on, and the bare text when it cannot.
///
/// #2898 defect 2: `unexpected token: type` with no line, no column and no
/// path is not actionable, which is the property AGENTS.md asks these queries
/// for. The offset comes from the contract grammar's own binary search over
/// token prefixes (`contract_parse_error_offset`), not from a scan of the
/// message -- an unlocatable failure stays bare rather than being placed
/// somewhere plausible.
export fn symbol_spans_locate_failure(path: String, source: String, msg: String) -> String {
  if !is_contract_ext(path) {
    return msg
  } else {
    ()
  }
  let off = handle {
    let (_pins, blanked) = extract_require_pins(source)
    let (tokens, starts, _ends) = lex_with_offsets(blanked)
    contract_parse_error_offset(tokens = tokens, starts = starts, msg = msg)
  } with { Exception::Throw(_) => 0 - 1 }
  if off < 0 {
    msg
  } else {
    let (line, col) = offset_to_line_col(source = source, offset = off)
    String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), String::concat(": ", msg)))))
  }
}
