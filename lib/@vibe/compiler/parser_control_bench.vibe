//# Imports

import ./parser_hotspot_probe.vibe {
  probe_parse_expr_tokens_repeat_count, probe_parse_stmt_tokens_repeat_count, probe_parse_wide_match
}

import @vibe/compiler/syntax {
  Token, lex
}
//# Setup

let empty_tokens: Array[Token] = [
  TEof
]

let stmt_let_literal_tokens: Array[Array[Token]] = [
  empty_tokens
]
let stmt_let_if_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_block_literal_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_block_let_literal_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_block_assign_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_block_assign_op_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_if_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_match_tokens: Array[Array[Token]] = [
  empty_tokens
]

fn ensure_source_tokens(box: Array[Array[Token]], source: String) -> Array[Token] with Exception {
  let current = box[0]
  if Array::length(current) == 1 {
    let tokens = lex(source)
    box[0] = tokens
    tokens
  } else {
    current
  }
}

//# Benches

bench "parser-control/stmt_let_literal" {
  let _ = handle {
    probe_parse_stmt_tokens_repeat_count(ensure_source_tokens(stmt_let_literal_tokens, "let x = 1\n"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/stmt_let_if" {
  let _ = handle {
    probe_parse_stmt_tokens_repeat_count(ensure_source_tokens(stmt_let_if_tokens, "let x = if 1 < 2 { 3 } else { 4 }\n"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_block_literal" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_block_literal_tokens, "{ 1 }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_block_let_literal" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_block_let_literal_tokens, "{ let x = 1; x }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_block_assign" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_block_assign_tokens, "{ let mut x = 1; x = 2; x }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_block_assign_op" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_block_assign_op_tokens, "{ let mut x = 1; x += 2; x }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_if" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_if_tokens, "if 1 < 2 { 3 } else { 4 }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/expr_match" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_match_tokens, "match 0 { 0 => 100, 1 => 101, 2 => 102, _ => 999 }"), 64)
  } with Exception {
    Throw(_) => 0
  }
}

bench "parser-control/wide_match" {
  let _ = handle {
    probe_parse_wide_match()
  } with Exception {
    Throw(_) => 0
  }
}
