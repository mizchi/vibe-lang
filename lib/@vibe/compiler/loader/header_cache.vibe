//# Functions

fn resolve_path_fs(base_dir: String, raw_path: String, self_path: String) -> String with Fs {
  // #1872 pilot: probe loop unified in core (resolve_import_path_probe,
  // `with Source` -- carries this copy's self-import skip and first-non-self
  // fallback); this wrapper only discharges Source with the real builtins.
  handle {
    resolve_import_path_probe(base_dir, raw_path, self_path)
  } with { Source::Read(p) => resume(Fs::read_file(p)); Source::Exists(p) => resume(Fs::exists(p)) }
}

fn is_special_bundle_path(path: String) -> Bool {
  String::ends_with(path, "compiler_sources_bundle.vibe") || String::ends_with(path, "cli_adapter_bundle.vibe") || String::ends_with(path, "selfbuild_runtime_entry_bundle.vibe")
}

fn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {
  if String::ends_with(path, "compiler_sources_bundle.vibe") {
    Some((array_empty(), ["compiler_sources", "compiler_source_groups"]))
  } else if String::ends_with(path, "cli_adapter_bundle.vibe") {
    Some((array_empty(), [
      "cli_adapter_sources",
      "cli_adapter_source_groups",
      "cli_adapter_ordered_sources",
      "cli_adapter_merged_source",
      "cli_adapter_module_source"
    ]))
  } else if String::ends_with(path, "selfbuild_runtime_entry_bundle.vibe") {
    Some((array_empty(), ["selfbuild_runtime_entry_source"]))
  } else {
    None
  }
}

/// #831: a plain relative/workspace-absolute import (`import ./x.vibe { .. }`,
/// `export ./x.vibe { .. }`) whose resolved candidate does not exist on disk
/// used to reach `Fs::read_file` unguarded further down the pipeline
/// (`collect_sources_rec`), which is a raw host primitive -- a missing file
/// there is a JS-level throw from the host runner, NOT a guest `Error` effect,
/// so it crosses the wasm/JS boundary uncaught and prints a "[crash debug]"
/// dump instead of a located diagnostic. Catch it HERE, at the import
/// resolution call site, where the raw import spelling and the importing
/// module's source text (for a line:col lookup) are still both in scope.
/// `@scope/name` package refs are exempt: their resolution has its own,
/// more specific existence + pin checks downstream (`verify_store_package_fs`,
/// `verify_lib_package_fs` in loader/index.vibe), which report a better
/// message (pin/store-install guidance) than a generic "cannot resolve
/// import" would.
fn located_missing_import_error(source: String, keyword: String, raw_path: String, resolved: String) -> String {
  let base_msg = String::concat("cannot resolve import '", String::concat(raw_path, String::concat("' (resolved to ", String::concat(resolved, ")"))))
  let needle = String::concat(keyword, String::concat(" ", raw_path))
  let needle_off = String::index_of(source, needle)
  let off = if needle_off >= 0 {
    needle_off + String::length(keyword) + 1
  } else {
    String::index_of(source, raw_path)
  }
  if off < 0 {
    base_msg
  } else {
    let (line, col) = offset_to_line_col(source, off)
    String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), String::concat(": ", base_msg)))))
  }
}

/// The `@scope/name...` spelling a relative-import-boundary error should
/// suggest instead, derived from the resolved package owner's contract path
/// (`lib/@vibe/compiler/core/index.vpkg` -> `@vibe/compiler/core`,
/// `.vibe/store/@vibe/json/index.vpkg` -> `@vibe/json`). Unlike
/// `import_display_name` above (a short display label, truncated to the
/// first two `@scope/name` segments), this must reproduce the FULL lib/-
/// relative path so a compiler-internal nested package (no separate `@`
/// identity of its own) still gets a spelling that actually resolves.
fn qualified_package_name_from_owner(owner: String) -> String {
  let without_suffix = if String::ends_with(owner, "/index.vpkg") {
    owner[0: String::length(owner) - String::length("/index.vpkg")]
  } else if String::ends_with(owner, "/index.vibei") {
    owner[0: String::length(owner) - String::length("/index.vibei")]
  } else {
    owner
  }
  if String::starts_with(without_suffix, "lib/") {
    without_suffix[String::length("lib/"): String::length(without_suffix)]
  } else if String::starts_with(without_suffix, ".vibe/store/") {
    without_suffix[String::length(".vibe/store/"): String::length(without_suffix)]
  } else {
    without_suffix
  }
}

/// The message must contain the literal phrase "package boundary" and the
/// target owner's path: `enforce_incoming_boundary_fs`'s established
/// "cannot import ... across a package boundary" wording (loader.vibe,
/// #729) is what tests/fixtures across this tree assert on
/// (contract_vpkg_test.vibe's "nested package cannot import parent
/// internals" / "parent package cannot import nested package internals").
fn located_package_boundary_error(source: String, keyword: String, raw_path: String, suggestion: String) -> String {
  let base_msg = String::concat("relative ", String::concat(keyword, String::concat(" '", String::concat(raw_path, String::concat("' crosses a package boundary; use `", String::concat(keyword, String::concat(" ", String::concat(suggestion, "` instead"))))))))
  let needle = String::concat(keyword, String::concat(" ", raw_path))
  let needle_off = String::index_of(source, needle)
  let off = if needle_off >= 0 {
    needle_off + String::length(keyword) + 1
  } else {
    String::index_of(source, raw_path)
  }
  if off < 0 {
    base_msg
  } else {
    let (line, col) = offset_to_line_col(source, off)
    String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), String::concat(": ", base_msg)))))
  }
}

/// A relative (`./`, `../`) import must stay within the importing file's own
/// nearest `index.vpkg`-owned package -- reaching a DIFFERENT package,
/// including the neighbor's own facade, is only allowed via a qualified
/// `@scope/name` (or compiler-internal `@scope/name/...`) import. This closes
/// the loophole `enforce_incoming_boundary_fs` (loader.vibe) deliberately
/// leaves open for `@`-qualified imports of a neighbor's facade: that
/// exception is for the CORRECT spelling, not the relative one.
///
/// `export` (re-export, SReExport) is exempt: the parser's export-statement
/// grammar has no `@scope/name` production at all (only `.`/`..`-prefixed
/// paths), so a boundary-crossing re-export has no alternative spelling to
/// migrate to yet -- enforcing this on `export` would just break working
/// facades with no fix available.
fn enforce_relative_import_package_boundary_fs(raw_path: String, self_path: String, resolved: String, source: String, keyword: String) -> Unit with Exception + Fs {
  if keyword == "import" && path_has_relative_prefix(raw_path, String::length(raw_path)) {
    let importer_owner = nearest_vpkg_path_fs(self_path)
    let target_owner = nearest_vpkg_path_fs(resolved)
    if importer_owner == "" || target_owner == "" || importer_owner == target_owner {
      ()
    } else {
      throw(located_package_boundary_error(source, keyword, raw_path, qualified_package_name_from_owner(target_owner)))
    }
  } else ()
}

fn resolve_checked_path_fs(base_dir: String, raw_path: String, self_path: String, source: String, keyword: String) -> String with Exception + Fs {
  let resolved = resolve_path_fs(base_dir, raw_path, self_path)
  if String::starts_with(raw_path, "@") || Fs::exists(resolved) {
    enforce_relative_import_package_boundary_fs(raw_path, self_path, resolved, source, keyword)
    resolved
  } else {
    throw(located_missing_import_error(source, keyword, raw_path, resolved))
  }
}

/// #943: `import <pkg> { a, b }` / `export <pkg> { a, b }` names used to bind
/// blindly against whatever the resolved module's CHECKED env happened to
/// contain (runtime/index.vibe's `bind_import_names_from_cache` does a flat,
/// export-UNAWARE lookup): a nonexistent name silently became `CtUnknown` (no
/// error unless later used somewhere that needed a real type), and a
/// genuinely PRIVATE name silently bound its REAL type (every top-level def
/// is present in a checked module's env, exported or not) and only failed
/// much later, UNLOCATED, deep inside the codegen merge's export-aware
/// private-namespacing pass ("undefined variable (local): <name>", no
/// file/line, no mention of the import). Catch it HERE instead, at the same
/// call site that already resolves the raw import path and has the
/// importing module's own source text in scope for a line:col lookup
/// (mirrors `located_missing_import_error` above).
///
/// Scope (deliberately conservative -- see #943 discussion): only checked
/// when the import target is a CONTRACT package boundary (`.../index.vpkg`
/// or `.../index.vibei` -- ADR-0063/ADR-0070's declared-surface packages,
/// the same shape #729/#847's boundary-enforcement machinery treats as the
/// sole authoritative entry point), and only for plain lowercase-leading
/// value names (see `is_lowercase_leading_plain_ident`). Shapes left
/// UNVALIDATED on purpose:
///   - plain `index.vibe` facade directories: their effective surface is
///     historically LEAKIER than the facade's own re-export list --
///     fixtures/import_visibility_float_eq_test.vibe (#716) deliberately
///     imports `eq` through prelude/index.vibe even though the facade only
///     lists `Float::eq` (the merge-level export of float.vibe's `export
///     let eq` is what actually binds). A facade's collect_exports list is
///     therefore not a positive proof of absence.
///   - direct-file imports (`import ../checker_effects.vibe { ... }`, the
///     common compiler-internal shape): same-package edges are not a
///     package-contract question at all.
///   - a package whose store/lib copy is not materialized (unresolved
///     `@scope/name` pin) -- the `Fs::exists` guard below.
fn is_contract_boundary_path(path: String) -> Bool {
  String::ends_with(path, "/index.vibei") || String::ends_with(path, "/index.vpkg")
}

/// Type names, enum-variant constructors, and `Type::member` qualified items
/// (`import ../ast { enum Json, Json::method }`) are excluded on purpose:
/// `collect_exports` (reused below for the VALUE namespace) enumerates enum
/// VARIANT constructors but never the enum/struct/alias/trait NAME itself, so
/// a routine, entirely legitimate `import ../core { Stmt, Expr,
/// TypeEnv, ... }` (used all over this compiler) would false-positive as "not
/// exported" if type-shaped names were checked against the same list. The
/// vibe convention is snake_case values / UpperCamelCase types (CLAUDE.md),
/// so a lowercase first letter reliably selects the VALUE namespace this
/// check can actually speak to.
fn is_lowercase_leading_plain_ident(name: String) -> Bool {
  if String::length(name) == 0 {
    false
  } else if String::index_of(name, "::") >= 0 {
    false
  } else {
    let c = String::char_code_at(name, 0)
    c >= 97 && c <= 122
  }
}

fn string_array_contains_hc(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// The target's OWN export surface only -- deliberately NOT recursive (never
/// walks the target's own imports/deps). Reusing
/// `load_or_parse_module_header_fs_impl(resolved, ..)` here would recurse
/// into this same validation for the target's own import list, which
/// recurses again for ITS deps, and so on -- effectively re-validating the
/// whole transitive import graph from every single edge. This reads +
/// (contract-)parses `resolved` exactly once instead, mirroring the same
/// decls/opaques/collect_exports combination the contract-header branch above
/// already uses for its own `exports` result.
fn resolved_export_names_fs(resolved: String) -> Array[String] with Exception + Fs {
  let source = Fs::read_file(resolved)
  if is_contract_ext(resolved) && !String::starts_with(source, contract_facade_marker) {
    let (_, pin_blanked) = extract_require_pins(source)
    let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))
    let names = collect_exports(cextra)
    let mut cdi = 0
    while cdi < Array::length(cdecls) {
      let (cdname, _) = Array::get(cdecls, cdi)
      Array::push(names, cdname)
      cdi = cdi + 1
    }
    let mut coi = 0
    while coi < Array::length(copaques) {
      let (coname, _) = Array::get(copaques, coi)
      Array::push(names, coname)
      coi = coi + 1
    }
    // `version` is synthesized into the facade from the package's own
    // `version x.y.z` directive (see desugar_contract_source_fs) rather than
    // requiring a `let version: String` contract decl -- mirror that here so
    // this header-only export list agrees with the actual generated facade.
    if extract_package_version(source) == "" || string_array_contains_hc(names, "version") {
      ()
    } else {
      Array::push(names, "version")
    }
    names
  } else {
    collect_exports(parse_program(lex(source)))
  }
}

fn located_import_name_error(source: String, keyword: String, raw_path: String, name: String, display: String) -> String {
  let base_msg = String::concat("\"", String::concat(name, String::concat("\" is not exported by ", display)))
  let needle = String::concat(keyword, String::concat(" ", raw_path))
  let needle_off = String::index_of(source, needle)
  let off = if needle_off >= 0 {
    needle_off + String::length(keyword) + 1
  } else {
    String::index_of(source, raw_path)
  }
  if off < 0 {
    base_msg
  } else {
    let (line, col) = offset_to_line_col(source, off)
    String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), String::concat(": ", base_msg)))))
  }
}

/// A friendly `@scope/name` label for the error message when derivable from
/// the resolved on-disk path (`.../lib/@vibe/json/index.vpkg` -> `@vibe/json`);
/// falls back to the raw import spelling otherwise.
fn import_display_name(raw_path: String, resolved: String) -> String {
  if String::starts_with(raw_path, "@") {
    raw_path
  } else {
    let at = String::last_index_of(resolved, "@")
    if at < 0 {
      raw_path
    } else {
      let rest = String::substring(resolved, at, String::length(resolved))
      let slash1 = String::index_of(rest, "/")
      if slash1 < 0 {
        raw_path
      } else {
        let after_scope = String::substring(rest, slash1 + 1, String::length(rest))
        let slash2 = String::index_of(after_scope, "/")
        if slash2 < 0 {
          rest
        } else {
          String::substring(rest, 0, slash1 + 1 + slash2)
        }
      }
    }
  }
}

fn validate_import_names_fs(source: String, keyword: String, raw_path: String, resolved: String, names: Array[ImportItem]) -> Unit with Exception + Fs {
  if is_contract_boundary_path(resolved) && Fs::exists(resolved) {
    let mut dep_exports = array_empty()
    let mut loaded = false
    let mut i = 0
    while i < Array::length(names) {
      let name = Array::get(names, i).name
      if is_lowercase_leading_plain_ident(name) {
        if !loaded {
          dep_exports = resolved_export_names_fs(resolved)
          loaded = true
        } else ()
        if string_array_contains_hc(dep_exports, name) {
          ()
        } else {
          throw(located_import_name_error(source, keyword, raw_path, name, import_display_name(raw_path, resolved)))
        }
      } else ()
      i = i + 1
    }
  } else ()
}

fn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String, self_path: String, source: String) -> Array[String] with Exception + Fs {
  let deps = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, names) => if is_builtin_iterator_serialized_boundary_path(raw_path) {
        ()
      } else {
        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, "import")
        validate_import_names_fs(source, "import", raw_path, resolved, names)
        Array::push(deps, resolved)
      },
      SReExport(raw_path, names) => {
        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, "export")
        validate_import_names_fs(source, "export", raw_path, resolved, names)
        Array::push(deps, resolved)
      },
      _ => ()
    }
    i = i + 1
  }
  deps
}

/// Direct production siblings of a contract package, as raw import spellings
/// (`./<name>`). Subdirectories are never scanned implicitly: their sources
/// enter the graph only through an explicit relative import from a direct root.
/// Fs::readdir is byte-sorted, so facade, hash, and dependency order remain
/// deterministic.
fn directory_entry_path(dir: String, name: String) -> String {
  if dir == "" {
    name
  } else if dir == "/" {
    String::concat("/", name)
  } else {
    String::concat(dir, String::concat("/", name))
  }
}

export fn contract_sibling_impl_raws(dir: String) -> Array[String] with Exception + Fs {
  let out = array_empty()
  let scan_dir = if dir == "" {
    "."
  } else {
    dir
  }
  let names = Fs::readdir(scan_dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if name != "index.vibei" && name != "index.vibe" && name != "index.vpkg" && String::ends_with(name, ".vibe") && !String::ends_with(name, "_test.vibe") && !String::ends_with(name, "_bench.vibe") && !String::ends_with(name, ".draft.vibe") && !String::starts_with(name, "_") {
      let full = directory_entry_path(dir, name)
      ensure_regular_source_fs(full)
      Array::push(out, String::concat("./", name))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #897/#855 (ADR-0070 Phase 1): a .vpkg contract gets implicit membership
/// unconditionally (unlike .vibei's legacy all-or-nothing gate) -- explicit
/// `import ./x.vibe {}` declarations are merged with auto-discovered
/// siblings rather than suppressing discovery. `explicit` wins ordering (its
/// declared spelling is part of the package hash); newly-discovered names
/// are appended after, de-duplicated, preserving contract_sibling_impl_raws'
/// deterministic byte-sorted discovery order for anything not already listed.
export fn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(explicit) {
    Array::push(out, Array::get(explicit, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(discovered) {
    let d = Array::get(discovered, j)
    let mut k = 0
    let mut found = false
    while k < Array::length(out) && !found {
      if Array::get(out, k) == d {
        found = true
      } else {
        k = k + 1
      }
    }
    if !found {
      Array::push(out, d)
    } else {
      ()
    }
    j = j + 1
  }
  out
}

export fn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with Exception + Fs {
  ingestion_pipeline_telemetry_add(10, 1)
  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))
  // #801 follow-up: a warm header whose package-index deps no longer match
  // the current resolution winners was written under a different resolution
  // context (a store copy appeared or vanished) — fall through to the cold
  // lane and re-resolve. Plain Bool dispatch (mut flag), NOT an Option match
  // wrapping the parser calls below — see the #708 note in the cold lane.
  let mut warm_deps = array_empty()
  let mut warm_exports = array_empty()
  let mut warm_ok = false
  if Fs::exists(cache_path) {
    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    // #943 review (Codex P2): the cache key only covers the IMPORTER's
    // source, so editing a target contract (dropping/renaming an export)
    // while the importer is unchanged used to replay the stale header and
    // skip import-name validation entirely. v2 entries record each
    // contract-boundary dep's content fingerprint at build time; any
    // mismatch (or a pre-v2 entry, which recorded none) falls through to
    // the cold lane, which re-validates the import list against the
    // CURRENT contract surface.
    if parsed.3 && package_index_deps_are_current(parsed.0) && contract_dep_fingerprints_current(parsed.2) {
      warm_deps = parsed.0
      warm_exports = parsed.1
      warm_ok = true
    } else {
      ()
    }
  } else {
    ()
  }
  if warm_ok {
    ingestion_pipeline_telemetry_add(11, 1)
    (warm_deps, warm_exports, parse_count)
  } else {
    ingestion_pipeline_telemetry_add(12, 1)
    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than
    // matching `special_bundle_header(path)`'s Option result directly here,
    // and never nest the `Some((deps, exports))` tuple-in-option pattern in
    // the same match as the `None` arm's parse call. A compiler that is
    // itself self-hosted under RC traps ("wasm unreachable" in `tk_name`,
    // reached via `parse_stmt`) reading a corrupted Token tag when
    // `load_or_parse_module_header_fs_impl` is compiled with the call chain
    // that reaches `tk_name` (lex_with_starts/parse_program_located, or
    // even the plain lex/parse_program pair) sitting inside ONE arm of a
    // `match` on `special_bundle_header(path)`'s `Option` result — even
    // though that arm is never taken for ordinary (non-bundle-file) input.
    // Splitting the dispatch into this Bool `if` (special_bundle_header is
    // then only ever called, and only ever `match`ed, inside the branch that
    // does NOT also reach the parser) reproducibly avoids the trap for the
    // simplest repro. NOT a full fix for #708: a structurally similar crash
    // still reproduces one level deeper (`parse_type_impl`, reached once the
    // input has a type annotation) -- root cause remains uncharacterized, and
    // this workaround likely needs to be repeated at that/other call sites.
    // #753: an already-desugared facade can reach this parse under its
    // .vibei path (type_db re-reads COLLECTED sources, and collection
    // replaces a contract's text with its facade). A facade is ordinary
    // program syntax — re-parsing it as contract grammar mis-reads its
    // surface (a facade with only type defs has zero impl imports, which
    // would trigger sibling auto-discovery below and pull `_test.vibe`
    // neighbors into the package's dep set — "import cycle detected" for
    // any `import .` test). Route it to the ordinary branch instead.
    let is_contract_source = is_contract_ext(path) && !String::starts_with(source, contract_facade_marker)
    let header_result = if is_contract_source {
      // #740 fallout: a .vibei contract is not ordinary program syntax
      // (bodyless fn/type declarations), so the full-program parse below
      // threw "expected = but got type". Only the COLD-cache lane reaches
      // this parse (warm runs read the cached header), which is why it
      // survived until the whole-graph cold repro. Parse with the contract
      // grammar instead: deps come from the implementation imports, the
      // export surface from decls + opaques + transparent type stmts.
      let (_, pin_blanked) = extract_require_pins(source)
      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))
      let cexports = collect_exports(cextra)
      let mut cdi = 0
      while cdi < Array::length(cdecls) {
        let (cdname, _) = Array::get(cdecls, cdi)
        Array::push(cexports, cdname)
        cdi = cdi + 1
      }
      let mut coi = 0
      while coi < Array::length(copaques) {
        let (coname, _) = Array::get(copaques, coi)
        Array::push(cexports, coname)
        coi = coi + 1
      }
      // Mirror resolved_export_names_fs: `version` is synthesized into the
      // facade from the package's own `version x.y.z` directive rather than
      // requiring a `let version: String` contract decl.
      if extract_package_version(source) == "" || string_array_contains_hc(cexports, "version") {
        ()
      } else {
        Array::push(cexports, "version")
      }
      // #730: a contract with no implementation imports auto-discovers its
      // siblings — those files are deps of the header too, or an impl edit
      // would not invalidate this cache entry.
      // #897/#855: a .vpkg contract always merges discovered siblings with
      // its explicit deps (implicit membership is unconditional for .vpkg),
      // so its header deps must include both, not just whichever won under
      // the old either/or gate.
      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path, pin_blanked)
      let is_vpkg_contract = String::ends_with(path, ".vpkg")
      let cdeps2 = if is_vpkg_contract || Array::length(cdeps) == 0 {
        let craws = if is_vpkg_contract {
          let (craws0, _) = classify_contract_stmts(cextra)
          merge_impl_raws_dedupe(craws0, contract_sibling_impl_raws(dir_of_path(path)))
        } else {
          contract_sibling_impl_raws(dir_of_path(path))
        }
        let resolved = array_empty()
        let mut cri = 0
        while cri < Array::length(craws) {
          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))
          cri = cri + 1
        }
        resolved
      } else {
        cdeps
      }
      (cdeps2, cexports, parse_count + 1)
    } else if is_special_bundle_path(path) {
      match special_bundle_header(path) {
        Some(pair) => {
          let deps = pair.0
          let exports = pair.1
          (deps, exports, parse_count)
        },
        None => (array_empty(), array_empty(), parse_count)
      }
    } else {
      let (tokens, starts) = lex_with_starts(source)
      let stmts = handle {
        parse_program_located(tokens, starts, source)
      } with { Exception::Throw(msg) => throw(String::concat(path, String::concat(": ", msg))) }
      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path, source), collect_exports(stmts), parse_count + 1)
    }
    let deps = header_result.0
    let exports = header_result.1
    let next_parse_count = header_result.2
    if next_parse_count > parse_count {
      ingestion_pipeline_telemetry_add(13, 1)
    } else {
      ()
    }
    Fs::write_file(cache_path, persistent_module_header_text(deps, exports, contract_dep_fingerprints_now(deps)))
    (deps, exports, next_parse_count)
  }
}

/// Snapshot each contract-boundary dep's content fingerprint for the v2
/// header entry (#943 review). A dep that is not a contract boundary — or
/// whose file is not materialized — records nothing: the warm gate only
/// compares what was recorded, and a contract that APPEARS later changes
/// resolution winners, which the #801 package_index_deps_are_current gate
/// already catches.
fn contract_dep_fingerprints_now(deps: Array[String]) -> Array[(String, String)] with Fs {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(deps) {
    let d = Array::get(deps, i)
    if is_contract_boundary_path(d) && Fs::exists(d) {
      Array::push(out, (d, fingerprint_file_fs(d)))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Warm-gate check: every recorded contract fingerprint must still match the
/// on-disk contract text. A vanished or edited contract fails the gate and
/// forces a cold re-parse + re-validation of the importer's names.
fn contract_dep_fingerprints_current(cdeps: Array[(String, String)]) -> Bool with Fs {
  let mut i = 0
  let mut ok = true
  while i < Array::length(cdeps) {
    let (cpath, cfp) = Array::get(cdeps, i)
    if ok {
      if Fs::exists(cpath) {
        ok = fingerprint_file_fs(cpath) == cfp
      } else {
        ok = false
      }
    } else {
      ()
    }
    i = i + 1
  }
  ok
}
