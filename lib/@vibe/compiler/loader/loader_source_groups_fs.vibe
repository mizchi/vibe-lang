fn store_persistent_sources_cache(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)], cfg: TargetCfg) -> Unit with Env + Exception + Fs {
  Fs::write_file(persistent_source_list_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg)), contents = build_persistent_sources_cache_text(entry_path = entry_path, manifest_path = manifest_path, sources = sources))
}

fn store_persistent_source_groups_cache(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])], cfg: TargetCfg) -> Unit with Env + Exception + Fs {
  Fs::write_file(persistent_source_group_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg)), contents = build_persistent_source_groups_cache_text(entry_path = entry_path, manifest_path = manifest_path, groups = groups))
}

fn copy_grouped_sources(_ groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] {
  let out = loader_empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, at = gi)
    let copied_sources = copy_source_specs(sources)
    Array::push(out, value = (group_name, copied_sources))
    gi = gi + 1
  }
  out
}

/// Flatten in group order, preserving every repeated source seat in a fresh array.
export fn flatten_group_sources(_ groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {
  let out = empty_source_specs()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(out, value = Array::get(sources, at = si))
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

fn special_manifest_sources(_ entry_path: String) -> Option[(String, Array[(String, String)])] {
  let _ = entry_path
  None
}

fn special_manifest_source_groups(_ entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] {
  let _ = entry_path
  None
}

//# Helper functions

/// Cache lookup helper
fn cache_lookup(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while i < len {
    if done {
      i = len
    } else {
      let (p, e) = Array::get(cache, at = i)
      if p == path {
        result = Some(e)
        done = true
      }
      i = i + 1
    }
  }
  result
}

fn export_marker_name(_ name: String) -> String {
  String::concat("__vibe_internal_export__:", name)
}

fn env_has_export_marker(env: TypeEnv, name: String) -> Bool {
  match env_lookup(env = env, name = export_marker_name(name)) {
    Some(_) => true,
    None => false
  }
}

fn bind_export_markers(env: TypeEnv, exports: Array[String]) -> TypeEnv {
  let mut acc = env
  let mut i = 0
  while i < Array::length(exports) {
    acc = env_bind(env = acc, name = export_marker_name(Array::get(exports, at = i)), ty = CtUnit)
    i = i + 1
  }
  acc
}

/// Bind imported names from a checked module's env
fn bind_checked_imports(names: Array[ImportItem], i: Int, env: TypeEnv, mod_env: TypeEnv) -> TypeEnv {
  if i >= Array::length(names) {
    env
  } else {
    let item = Array::get(names, at = i)
    let name = item.name
    let alias = item.alias
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let new_env = if env_has_export_marker(env = mod_env, name = name) {
      match env_lookup(env = mod_env, name = name) {
        Some(ty) => env_bind(env = env, name = bound_name, ty = ty),
        None => env
      }
    } else {
      env
    }
    bind_checked_imports(names = names, i = i + 1, env = new_env, mod_env = mod_env)
  }
}

//# Module Loader

/// Check a module and return its TypeEnv, resolving imports recursively.
/// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).
export fn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with Env + Exception {
  check_module_with_config(source = source, path = path, sources = sources, loading = loading, checked_cache = checked_cache, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn check_module_with_config(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)], cfg: TargetCfg) -> TypeEnv with Env + Exception {
  // Check cache first
  let cached = cache_lookup(cache = checked_cache, path = path)
  match cached {
    Some(env) => env,
    None => {
      // Cycle detection
      if contains_path(visited = loading, path = path) {
        throw(String::concat("import cycle detected: ", path))
      }
      let tokens = lex(source)
      let stmts = parse_program_with_cfg(tokens, cfg_flags = target_cfg_flags(cfg))
      let base_dir = dir_of_path(path)
      // Cycle-detection stack: push self before recursing through this
      // module's imports, truncate back when done. O(1) per frame vs.
      // the previous `Array::concat(loading, [path])`, which copied the
      // entire ancestor stack on every recursion and made nested module
      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`
      // (#366 truncate cutover).
      let saved_loading_len = Array::length(loading)
      Array::push(loading, value = path)
      // Resolve imports using while loop
      let mut import_env = EnvEmpty
      let mut ri = 0
      while ri < Array::length(stmts) {
        let stmt = Array::get(stmts, at = ri)
        import_env = match stmt {
          SImport(raw_path, names) => if is_builtin_iterator_serialized_boundary_path(raw_path) {
            import_env
          } else {
            match resolve_path_in_sources(base_dir = base_dir, raw_path = raw_path, sources = sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir = base_dir, raw_path = raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module_with_config(source = mod_source, path = resolved, sources = sources, loading = loading, checked_cache = checked_cache, cfg = cfg)
                bind_checked_imports(names = names, i = 0, env = import_env, mod_env = mod_env)
              }
            }
          },
          SReExport(raw_path, names) => {
            match resolve_path_in_sources(base_dir = base_dir, raw_path = raw_path, sources = sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir = base_dir, raw_path = raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module_with_config(source = mod_source, path = resolved, sources = sources, loading = loading, checked_cache = checked_cache, cfg = cfg)
                bind_checked_imports(names = names, i = 0, env = import_env, mod_env = mod_env)
              }
            }
          },
          _ => import_env
        }
        ri = ri + 1
      }
      Array::truncate(loading, length = saved_loading_len)
      // Type-check with imported env
      let empty_defs = array_empty()
      let check_errors = array_empty()
      // (8th arg: the typed-hover tytab — unused in this lane. The stale
      // 7-arg call only surfaced under the cold-cache whole-graph check,
      // #740 fallout.)
      let check_tytab = array_empty()
      let (env, _, _) = check_stmts(raw_stmts = stmts, i = 0, env = import_env, defs = empty_defs, s = SubstEmpty, c = 0, errors = check_errors, tytab = check_tytab)
      // Cache result
      let cached_env = bind_export_markers(env = env, exports = collect_exports(stmts))
      Array::push(checked_cache, value = (path, cached_env))
      cached_env
    }
  }
}

/// #730 (D-2): both content-addressing hashes of a contract package, from its
/// ORIGINAL on-disk texts (require lines included — they are part of the
/// hashed content, which is what makes a direct pin fix the transitive
/// closure). Paths in the package hash are package-relative ("index.vibei" +
/// each impl's raw import spelling), so the hash is location-independent —
/// the same function serves `vibe hash` on a working directory and store
/// verification of an installed copy.
fn collect_package_hash_inputs(_ path: String) -> (Array[(String, String)], Array[(String, String)], Array[(String, Array[String])], Array[Stmt]) with Env + Exception + Source + SourceIngest {
  validate_index_layout(path)
  let raw = perform Source::Read(path)
  let (_, blanked) = extract_require_pins(raw)
  let (decls, opaques, extra) = parse_contract_program(lex(blanked))
  let (impl_raws0, type_defs) = classify_contract_stmts(extra)
  let package_contract = normalize_path(path)
  let dir = dir_of_path(package_contract)
  // #730: mirror the ingestion's auto-discovery — the package hash must cover
  // the same impl files the facade is built from. Discovered raws are
  // "./<name>" and byte-sorted, so the hash stays location-independent and
  // deterministic.
  // #897/#855: mirror desugar_contract_source_fs's .vpkg implicit-membership
  // merge exactly, so the hash always covers the same impl set the facade
  // was built from (a mismatch here would make the content-addressed hash
  // silently stale relative to what actually got conformance-checked).
  let impl_raws = if String::ends_with(path, suffix = ".vpkg") {
    merge_impl_raws_dedupe(explicit = impl_raws0, discovered = contract_sibling_impl_raws_source(dir))
  } else if Array::length(impl_raws0) == 0 {
    contract_sibling_impl_raws_source(dir)
  } else {
    impl_raws0
  }
  let sources = array_empty()
  // #897 (ADR-0070 Phase 1): the package-hash key names the contract file by
  // its OWN on-disk suffix rather than assuming "index.vibei" — `path` is
  // already the resolved contract file (whichever of .vibei/.vpkg won), so
  // its basename is read off directly instead of re-probing the filesystem.
  // A directory that migrates from index.vibei to index.vpkg intentionally
  // gets a different hash (the rename is a real content/identity change).
  // `path_basename`, not an inline slice: the committed seed refuses a
  // `Source`-row body that slices. #3707 put `__slice` / `__len` on the
  // pure-builtin table; the inline form is available once a seed carries it.
  let contract_basename = path_basename(path)
  // #1145 follow-up 3: `generated_hash` stores this package's own content
  // hash -- feed it back into what gets hashed and the hash would depend on
  // hash-writing history instead of on the file, so it's always blanked to
  // empty here (a no-op for the common case where it's already empty; see
  // canonicalize_for_hash's own comment).
  Array::push(sources, value = (contract_basename, canonicalize_for_hash(raw)))
  let mut ri = 0
  if String::ends_with(package_contract, suffix = ".vpkg") {
    let visited = path_set_new()
    while ri < Array::length(impl_raws) {
      let resolved = resolve_import_path_probe(base_dir = dir, raw_path = Array::get(impl_raws, at = ri), self_path = "")
      collect_package_hash_source_closure(package_contract = package_contract, package_dir = dir, source_path = resolved, sources = sources, visited = visited)
      ri = ri + 1
    }
  } else {
    // Legacy .vibei hashing preserves its declared/direct implementation set.
    while ri < Array::length(impl_raws) {
      let iraw = Array::get(impl_raws, at = ri)
      let resolved = resolve_import_path_probe(base_dir = dir, raw_path = iraw, self_path = "")
      ensure_regular_source(resolved)
      let itext = perform Source::Read(resolved)
      Array::push(sources, value = (iraw, itext))
      ri = ri + 1
    }
  }
  (sources, decls, opaques, type_defs)
}

fn collect_package_hash_inputs_fs(_ path: String, cfg: TargetCfg) -> (Array[(String, String)], Array[(String, String)], Array[(String, Array[String])], Array[Stmt]) with Env + Exception + Fs {
  handle {
    collect_package_hash_inputs(path)
  } with { SourceIngest::Header(p, text) => resume(ingest_header_answer_fs(path = p, source = text, cfg = cfg)); SourceIngest::DesugarContract(p, text) => resume(ingest_contract_answer_fs(path = p, pin_blanked = text, cfg = cfg)); SourceIngest::ShareImports(p, text) => resume(ingest_shared_imports_answer_fs(path = p, pin_blanked = text, cfg = cfg)); Source::Read(p) => resume(cache_read_source_fs(p)); Source::Exists(p) => resume(Fs::exists(p)); Source::List(p) => resume(Fs::readdir(p)); Source::StatToken(p) => resume(Fs::stat_token(p)) }
}

export fn contract_package_hashes_fs(_ path: String) -> (String, String) with Env + Exception + Fs {
  contract_package_hashes_fs_with_config(path, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn contract_package_hashes_fs_with_config(_ path: String, cfg: TargetCfg) -> (String, String) with Env + Exception + Fs {
  contract_package_hashes_fs_algo_with_config(path = path, algo = "b3", cfg = cfg)
}

/// #1872: both content-addressing hashes of the package whose contract is
/// at `path`, over any provider (`contract_package_hashes_fs_algo` is the
/// filesystem one).
export fn contract_package_hashes_source(path: String, algo: String) -> (String, String) with Env + Exception + Source + SourceIngest {
  let (sources, decls, opaques, type_defs) = collect_package_hash_inputs(path)
  (package_hash_from_sources_with(algo = algo, sources = sources), contract_hash_with(algo = algo, fn_decls = decls, opaque_names = opaques, type_defs = type_defs))
}

export fn contract_package_hashes_fs_algo(path: String, algo: String) -> (String, String) with Env + Exception + Fs {
  contract_package_hashes_fs_algo_with_config(path = path, algo = algo, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn contract_package_hashes_fs_algo_with_config(path: String, algo: String, cfg: TargetCfg) -> (String, String) with Env + Exception + Fs {
  let (sources, decls, opaques, type_defs) = collect_package_hash_inputs_fs(path, cfg = cfg)
  (package_hash_from_sources_with(algo = algo, sources = sources), contract_hash_with(algo = algo, fn_decls = decls, opaque_names = opaques, type_defs = type_defs))
}

fn verify_recorded_package_id(importer: String, name: String, pin_hash: String, index_path: String, copy_kind: String) -> Unit with Env + Exception + Source + SourceIngest {
  let (sources, _, _, _) = collect_package_hash_inputs(index_path)
  if package_id_matches(id = pin_hash, sources = sources) {
    ()
  } else {
    let actual = package_hash_from_sources(sources)
    throw("pin mismatch for \{name}: \{importer} requires #\{pin_hash} but the \{copy_kind} copy is #\{actual}")
  }
}

/// #1145 follow-up 3: computes this package's content hash the same way
/// `vibe hash` does (contract_package_hashes_fs blanks the file's own
/// `generated_hash` before hashing, so a stale value here never leaks into
/// its own hash -- see that function's comment) and returns the file's full
/// text with `generated_hash = ` rewritten to the computed pin. Read-only
/// like every other fs-mode adapter entry point: the caller writes the
/// result back wherever it wants (same convention as VIBE_FILL_PINS).
/// Idempotent: re-running against the written-back file recomputes and
/// returns the identical hash.
export fn write_generated_hash_fs(_ path: String) -> String with Env + Exception + Fs {
  write_generated_hash_fs_with_config(path, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn write_generated_hash_fs_with_config(_ path: String, cfg: TargetCfg) -> String with Env + Exception + Fs {
  let (pkg_hash, _ct_hash) = contract_package_hashes_fs_with_config(path, cfg = cfg)
  replace_generated_hash_directive(source = Fs::read_file(path), new_value = "#\{pkg_hash}")
}

/// #730 (D-3): fill missing require pins OFFLINE from the workspace store.
/// `require @x/y 1.2.3` becomes `require @x/y 1.2.3 = #pkg:b3:<hex>` when
/// .vibe/store/@x/y/ is installed; a package absent from the store is an
/// error (network fetch belongs to `vibe add`/`update`, never to fmt).
/// Pinned lines pass through untouched, so the rewrite is idempotent.
export fn fill_require_pins_fs(_ source: String) -> String with Env + Exception + Fs {
  fill_require_pins_fs_with_config(source, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn fill_require_pins_fs_with_config(_ source: String, cfg: TargetCfg) -> String with Env + Exception + Fs {
  fill_require_pins_fs_mode_with_config(source = source, repin = false, cfg = cfg)
}

/// repin=true rewrites EVERY require line to the store's current hash —
/// `vibe dedupe --apply` (#730 D-4): after updating a store package, one
/// pass re-points all pins in a file at the installed copies. With the
/// by-name store there is one installed version per package, so repinning
/// IS conflict resolution.
export fn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with Env + Exception + Fs {
  fill_require_pins_fs_mode_with_config(source = source, repin = repin, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn fill_require_pins_fs_mode_with_config(source: String, repin: Bool, cfg: TargetCfg) -> String with Env + Exception + Fs {
  fill_require_pins_impl(source = source, repin = repin, lenient = false, cfg = cfg)
}

/// The `vibe fmt` lane's fill (#730 D-3): the same offline store lookup as
/// fill_require_pins_fs, but TOTAL. fmt must format the body whatever the
/// state of the store, so a package absent from the store leaves its
/// require line verbatim instead of failing the run, and any error along
/// the way (a malformed require line the head classifier will refuse
/// anyway, a store copy the hasher rejects) returns the source unchanged.
/// Not filling is not wrong -- the build still refuses to resolve an
/// unpinned require -- whereas aborting the format over it would be; the
/// strict lane (VIBE_FILL_PINS, above) keeps the loud answer for callers
/// who asked for pins specifically.
export fn fill_require_pins_lenient(_ source: String) -> String with Env + Fs {
  fill_require_pins_lenient_with_config(source, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn fill_require_pins_lenient_with_config(_ source: String, cfg: TargetCfg) -> String with Env + Fs {
  handle {
    fill_require_pins_impl(source = source, repin = false, lenient = true, cfg = cfg)
  } with { Exception::Throw(_) => source }
}

/// digits_to_int (behind semver_parts) folds digit runs with the wrapping
/// 63-bit arithmetic every Int operation has (#1877), so a long-enough
/// component wraps -- `^0.1.4611686018427387904` gets a NEGATIVE patch
/// bound and an installed 0.1.0 "satisfies" it (#2260 round 6, measured).
/// 18 decimal digits max out below 2^62-1, so components up to that length
/// convert exactly; anything longer is unverifiable and never fills.
fn semver_components_convert_exactly(_ v: String) -> Bool {
  let start = if String::starts_with(v, prefix = "^") {
    1
  } else {
    0
  }
  let parts = String::split(String::substring(v, start = start, end = String::length(v)), sep = ".")
  if Array::length(parts) != 3 {
    false
  } else {
    String::length(Array::get(parts, at = 0)) <= 18 && String::length(Array::get(parts, at = 1)) <= 18 && String::length(Array::get(parts, at = 2)) <= 18
  }
}

/// Does the store copy's declared version satisfy a require constraint?
/// The grammar (ADR-0063 §6) has exactly two operators: none (exact match)
/// and `^` (compatible range, npm caret semantics: the leftmost non-zero
/// digit is the compatibility line -- same major and >= the triple; for
/// major 0 same minor and >= patch; for 0.0.z the patch itself, so only
/// the exact triple satisfies, #2260 round 5). An empty or non-triple
/// declared version satisfies nothing -- unverifiable never fills.
fn require_constraint_satisfied(constraint: String, version: String) -> Bool {
  if !semver_components_convert_exactly(constraint) || !semver_components_convert_exactly(version) {
    return false
  }
  match semver_parts(version) {
    None => false,
    Some(vparts) => {
      let (vmaj, vmin, vpat) = vparts
      if String::starts_with(constraint, prefix = "^") {
        match semver_parts(String::substring(constraint, start = 1, end = String::length(constraint))) {
          None => false,
          Some(cparts) => {
            let (cmaj, cmin, cpat) = cparts
            if vmaj != cmaj {
              false
            } else if cmaj == 0 && cmin == 0 {
              vmin == 0 && vpat == cpat
            } else if cmaj == 0 {
              vmin == cmin && vpat >= cpat
            } else if vmin != cmin {
              vmin > cmin
            } else {
              vpat >= cpat
            }
          }
        }
      } else {
        constraint == version
      }
    }
  }
}

// Which lines are require directives is decided by the loader's own header
// scanner, not by a second region scan here (#2260 Codex round 3): the
// scanner blanks every recognized directive line to spaces with byte length
// preserved, so a line that starts with `require ` in the source and is
// all-blank in the blanked output IS a recognized require directive --
// including one sitting after `name =`/`version =`/`deps = { .. }` in an
// `index.vpkg` header, which a "stop at the first non-require line" scan
// (this function's previous shape) never reached. A `require`-looking line
// the scanner did NOT blank (i.e. body text) is left alone.
fn fill_require_pins_impl(source: String, repin: Bool, lenient: Bool, cfg: TargetCfg) -> String with Env + Exception + Fs {
  let (_, blanked) = extract_require_pins(source)
  let sb = StringBuilder::new()
  let len = String::length(source)
  let mut pos = 0
  while pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, at = nl) != 10 {
      nl = nl + 1
    }
    let line = String::substring(source, start = pos, end = nl)
    let trimmed = String::trim(line)
    let mut emitted = false
    if String::starts_with(trimmed, prefix = "require ") && String::length(String::trim(String::substring(blanked, start = pos, end = nl))) == 0 {
      let (pins_one, _) = extract_require_pins(String::concat(trimmed, "\n"))
      if Array::length(pins_one) == 1 {
        let (pname, pver, ppin) = Array::get(pins_one, at = 0)
        if ppin == "" || repin {
          // #897: try the target spelling (.vpkg) first, then legacy
          // .vibei, mirroring resolve_import_path_candidates' root ordering.
          let store_index_vpkg = String::concat(".vibe/store/", String::concat(pname, "/index.vpkg"))
          let store_index_vibei = String::concat(".vibe/store/", String::concat(pname, "/index.vibei"))
          let store_index = if Fs::exists(store_index_vpkg) {
            store_index_vpkg
          } else {
            store_index_vibei
          }
          if Fs::exists(store_index) {
            // #2260 Codex round 4: the pin is the truth the build verifies,
            // so writing the installed copy's hash beside a version it does
            // not satisfy would make the build accept and run a release the
            // source never asked for -- silently. Fill only when the store
            // copy DECLARES a version and it satisfies the constraint; a
            // versionless or mismatched copy leaves the line for `vibe
            // add`/`update` (lenient) or reports both versions (strict).
            let store_version = extract_package_version(Fs::read_file(store_index))
            if require_constraint_satisfied(constraint = pver, version = store_version) {
              let (pkg_hash, _) = contract_package_hashes_fs_with_config(store_index, cfg = cfg)
              // #2676: keep the `from <source>` clause `vibe add` recorded.
              StringBuilder::push(sb, value = String::concat("require \{pname} \{pver} = #\{pkg_hash}", require_line_source_clause(trimmed)))
              emitted = true
            } else if lenient {
              ()
            } else {
              throw("cannot pin \{pname}: the store copy declares version '\{store_version}' which does not satisfy the required \{pver} (install the matching release with `vibe add`/`update`, or fix the require line)")
            }
          } else if lenient {
            // fmt lane: leave the unpinned line for the build to reject;
            // fetching belongs to `vibe add`/`update`, never to fmt.
            ()
          } else {
            throw("cannot pin \{pname} offline: not installed in the store (.vibe/store/\{pname}/)")
          }
        } else ()
      } else ()
    } else ()
    if emitted {
      ()
    } else {
      StringBuilder::push(sb, value = line)
    }
    if nl < len {
      StringBuilder::push(sb, value = "\n")
    } else ()
    pos = nl + 1
  }
  StringBuilder::freeze(sb)
}

/// #732 (Phase F): publish gate. Parse the previous and next contract
/// surfaces and verify the claimed version bump is exactly what the diff
/// requires (Elm-style machine-checked semver). Returns error strings;
/// empty = the release claim is honest.
export fn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with Exception + Fs {
  let prev_raw = Fs::read_file(prev_contract_path)
  let (_, prev_blanked) = extract_require_pins(prev_raw)
  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))
  let (_, ptypes) = classify_contract_stmts(pextra)
  let next_raw = Fs::read_file(next_contract_path)
  let (_, next_blanked) = extract_require_pins(next_raw)
  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))
  let (_, ntypes) = classify_contract_stmts(nextra)
  // #754: versions come from the PACKAGE-side `version x.y.z` directive when
  // the caller does not pass them; a caller-passed version that contradicts
  // the directive is its own error (a publish must not claim a version the
  // package does not declare).
  let prev_directive = extract_package_version(prev_raw)
  let next_directive = extract_package_version(next_raw)
  let errors = array_empty()
  if prev_version != "" && prev_directive != "" && prev_version != prev_directive {
    Array::push(errors, value = "previous version \{prev_version} contradicts the contract's version directive \{prev_directive}")
  } else ()
  if next_version != "" && next_directive != "" && next_version != next_directive {
    Array::push(errors, value = "claimed version \{next_version} contradicts the contract's version directive \{next_directive}")
  } else ()
  let pv = if prev_version != "" {
    prev_version
  } else {
    prev_directive
  }
  let nv = if next_version != "" {
    next_version
  } else {
    next_directive
  }
  if pv == "" || nv == "" {
    Array::push(errors, value = "publish versions unavailable: pass them explicitly or add a `version x.y.z` directive to the contract (#754)")
    errors
  } else if Array::length(errors) > 0 {
    errors
  } else {
    // Rows sorted: `with { Fs, Console }` and `with { Console, Fs }` require
    // the same authority, so reordering one is not a breaking change (#3673).
    verify_publish_bump(prev_version = pv, next_version = nv, old_lines = contract_surface_rows_sorted(contract_surface_lines(fn_decls = pd, opaque_names = po, type_defs = ptypes)), new_lines = contract_surface_rows_sorted(contract_surface_lines(fn_decls = nd, opaque_names = no, type_defs = ntypes)))
  }
}

/// The canonical surface of the contract at `path`, as `contract_surface_lines`
/// reads it (the lines `contract_hash` is computed over, before sorting):
/// what `vibe pkg update` compares, so a reordered contract is unchanged.
export fn contract_surface_lines_fs(_ path: String) -> Array[String] with Exception + Fs {
  let (_, blanked) = extract_require_pins(Fs::read_file(path))
  let (d, o, extra) = parse_contract_program(lex(blanked))
  let (_, types) = classify_contract_stmts(extra)
  contract_surface_lines(fn_decls = d, opaque_names = o, type_defs = types)
}

/// `contract_surface_effects` of the contract at `path`, with every effectset
/// alias expanded through the contract's own `effectset` definitions, the
/// way conformance expands them: `fn fetch() -> String with Network` under
/// `effectset Network = { Http }` requires Http, and a report keyed on the
/// alias would miss it.
export fn contract_surface_effects_fs(_ path: String) -> Array[String] with Exception + Fs {
  let (_, blanked) = extract_require_pins(Fs::read_file(path))
  let (d, o, extra) = parse_contract_program(lex(blanked))
  let (_, types) = classify_contract_stmts(extra)
  let (es_names, es_members) = ctr_es_collect_tables(types)
  let effects = contract_surface_effects(contract_surface_lines(fn_decls = d, opaque_names = o, type_defs = types))
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(effects) {
    let entry = Array::get(effects, at = i)
    let tab = String::index_of(entry, needle = "\t")
    let name = String::substring(entry, start = 0, end = tab)
    let labels = String::split(ctr_es_expand_row_string(row = String::substring(entry, start = tab + 1, end = String::length(entry)), es_names = es_names, es_members_list = es_members), sep = ", ")
    let mut j = 0
    while j < Array::length(labels) {
      Array::push(out, value = "\{name}\t\{Array::get(labels, at = j)}")
      j = j + 1
    }
    i = i + 1
  }
  out
}

/// #2676: the require pins that apply to `path`: those of its owning
/// contract (the nearest enclosing index.vpkg -- the project's manifest, or
/// a store package's own contract for its impl files) followed by the
/// importer's own head. The verifiers keep the LAST match for a name, so a
/// pin the importer spells itself still wins over the manifest's. A
/// contract is its own owner and contributes nothing twice; a file with no
/// enclosing index.vpkg keeps exactly its own pins.
fn with_owner_pins(path: String, own: Array[(String, String, String)]) -> Array[(String, String, String)] with Exception + Source {
  let owner = nearest_vpkg_path(path)
  if owner == "" || owner == path {
    own
  } else {
    let (owner_pins, _) = extract_require_pins(perform Source::Read(owner))
    let merged = array_empty()
    let mut i = 0
    while i < Array::length(owner_pins) {
      Array::push(merged, value = Array::get(owner_pins, at = i))
      i = i + 1
    }
    let mut j = 0
    while j < Array::length(own) {
      Array::push(merged, value = Array::get(own, at = j))
      j = j + 1
    }
    merged
  }
}

/// #730 (D-2): verify a store-resolved package against the importer's require
/// pin. The store is laid out BY NAME (.vibe/store/@scope/name/) and trusted
/// only through this hash check, so any mirror/copy mechanism is fine.
fn verify_store_package(importer: String, pins: Array[(String, String, String)], store_index_path: String) -> Unit with Env + Exception + Source + SourceIngest {
  let prefix = ".vibe/store/"
  // #897: `store_index_path` is already the RESOLVED dep (the caller reads
  // it off the collected import graph), so its own suffix tells us which
  // spelling won without re-probing the filesystem.
  let suffix = if String::ends_with(store_index_path, suffix = "/index.vpkg") {
    "/index.vpkg"
  } else {
    "/index.vibei"
  }
  let name = String::substring(store_index_path, start = String::length(prefix), end = String::length(store_index_path) - String::length(suffix))
  let mut pin_hash = ""
  let mut pin_found = false
  let mut pi = 0
  while pi < Array::length(pins) {
    let (pname, _, phash) = Array::get(pins, at = pi)
    if pname == name {
      pin_hash = phash
      pin_found = true
    } else ()
    pi = pi + 1
  }
  if pin_found {
    ()
  } else {
    throw("no require pin for \{name} in \{importer} or its index.vpkg (add: require \{name} <x.y.z> = #<pkg-hash> to the project's index.vpkg; `vibe add` writes it, `vibe hash` computes it)")
  }
  if pin_hash == "" {
    throw("unpinned require for \{name} in \{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store")
  } else ()
  let installed = perform Source::Exists(store_index_path)
  if installed {
    ()
  } else {
    throw("package \{name} is not installed in the store (.vibe/store/\{name}/)")
  }
  verify_recorded_package_id(importer = importer, name = name, pin_hash = pin_hash, index_path = store_index_path, copy_kind = "store")
}

/// #751 (ADR-0065): a `lib/`-resolved package is the dev-mode lane — no
/// require pin is demanded (that stays a store/release rule). But a pin is
/// the truth WHEREVER resolution lands: when the importer does pin the name,
/// the lib/ (or VIBE_LIB external root) copy must match it, or a stale
/// checkout silently diverges from what the pin promises. Under
/// VIBE_REQUIRE_PINS=1 (the release/publish freeze switch; `vibe run
/// --freeze` maps to it) the pin stops being optional: dev-mode name
/// resolution without a pin is an error.
fn verify_lib_package(importer: String, pins: Array[(String, String, String)], lib_index_path: String) -> Unit with Env + Exception + Source + SourceIngest {
  // The package name starts at the "@" — works for both the workspace
  // spelling ("lib/@scope/name/index.vibei") and an absolute VIBE_LIB root
  // ("/home/u/.vibe/lib/@scope/name/index.vibei"), and (#897) either's
  // `.vpkg`-suffixed alternate spelling. `lib_index_path` is already the
  // RESOLVED dep, so its own suffix tells us which spelling won.
  let suffix = if String::ends_with(lib_index_path, suffix = "/index.vpkg") {
    "/index.vpkg"
  } else {
    "/index.vibei"
  }
  let at = String::last_index_of(lib_index_path, needle = "@")
  let name = String::substring(lib_index_path, start = at, end = String::length(lib_index_path) - String::length(suffix))
  let mut pin_hash = ""
  let mut pi = 0
  while pi < Array::length(pins) {
    let (pname, _, phash) = Array::get(pins, at = pi)
    if pname == name {
      pin_hash = phash
    } else ()
    pi = pi + 1
  }
  if pin_hash == "" {
    if vibe_env_flag("VIBE_REQUIRE_PINS") {
      throw("pin required for \{name} (VIBE_REQUIRE_PINS=1): \{importer} resolves it via the dev-mode lib lane; add `require \{name} <version> = #pkg:b3:<hash>` (or a legacy #pkg:sha1:<hash>)")
    } else if !(perform Source::Exists(lib_index_path)) {
      // #831: an unpinned lib/VIBE_LIB package reference with no installed
      // copy used to fall through here silently and only fail later, deep
      // inside the raw `Fs::read_file` primitive in the collection walk
      // (an uncaught host-level crash, not a diagnostic). Catch it here,
      // at resolution time, with the same guidance shape as the pin-mismatch
      // and store-install errors below/above.
      throw("cannot resolve import \{name}: not found via lib/ or VIBE_LIB (looked for \{lib_index_path})")
    } else ()
  } else {
    verify_recorded_package_id(importer = importer, name = name, pin_hash = pin_hash, index_path = lib_index_path, copy_kind = "lib/")
  }
}

/// Package-owner boundary enforcement. `index.vpkg` is the sole boundary
/// marker, and the nearest enclosing one owns a source. A contract itself is a
/// public facade. Sources without an owner form a public compatibility space.
/// Every owned implementation target requires the importer to have that same
/// nearest owner, so nested -> parent and parent -> nested internal imports are
/// both rejected.
fn enforce_incoming_boundary(importer: String, target: String) -> Unit with Exception + Source {
  if is_vpkg_companion_basename(path_basename(target)) {
    throw("cannot import test/bench companion as a module target: \{target}")
  } else ()
  // #2676: a contract path is its own owner by construction. Asking the
  // filesystem instead answers the ENCLOSING owner while the contract does
  // not exist yet -- for `import @acme/base` in a package hashed before its
  // dependency is in the store, that is the project's root index.vpkg -- and
  // the import was refused here as a boundary crossing ("target owner is
  // index.vpkg") instead of reaching the resolution-time "not found" / pin
  // diagnostics that name the edit.
  let target_owner = if is_contract_ext(target) {
    target
  } else {
    nearest_vpkg_path(target)
  }
  if target_owner == "" {
    ()
  } else if target == target_owner {
    ()
  } else {
    let importer_owner = nearest_vpkg_path(importer)
    if importer_owner == target_owner {
      ()
    } else {
      throw("cannot import \{target} across a package boundary; target owner is \{target_owner} (#729); import the owner contract instead")
    }
  }
}

/// The filesystem adapter for `enforce_incoming_boundary`.
fn enforce_incoming_boundary_fs(importer: String, target: String) -> Unit with Exception + Fs {
  handle {
    enforce_incoming_boundary(importer = importer, target = target)
  } with { Source::Read(p) => resume(Fs::read_file(p)); Source::Exists(p) => resume(Fs::exists(p)); Source::List(p) => resume(Fs::readdir(p)); Source::StatToken(p) => resume(Fs::stat_token(p)) }
}

fn package_relative_hash_key(package_dir: String, source_path: String) -> String with Exception {
  let prefix = if package_dir == "" {
    ""
  } else if package_dir == "/" {
    "/"
  } else {
    String::concat(package_dir, "/")
  }
  let relative = if prefix == "" {
    source_path
  } else if String::starts_with(source_path, prefix = prefix) {
    source_path[String::length(prefix): String::length(source_path)]
  } else {
    throw("package hash source \{source_path} is outside package directory \{package_dir}")
  }
  String::concat("./", relative)
}

/// Collect the same-owner dependency closure rooted at direct production
/// siblings. Explicit-only `_*.vibe` / `*.draft.vibe` sources are absent from
/// discovery, but enter this closure when a production source imports them.
/// Cross-package contracts remain represented by the importing source's text
/// and require pin; their implementation bytes belong to their own hash.
fn collect_package_hash_source_closure(package_contract: String, package_dir: String, source_path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with Env + Exception + Source + SourceIngest {
  if path_set_contains(set = visited, path = source_path) {
    ()
  } else {
    path_set_add(set = visited, path = source_path)
    validate_index_layout(source_path)
    let source = perform Source::Read(source_path)
    Array::push(sources, value = (package_relative_hash_key(package_dir = package_dir, source_path = source_path), source))
    let deps = source_answer(perform SourceIngest::Header(source_path, source))
    let mut i = 0
    while i < Array::length(deps) {
      let dep = Array::get(deps, at = i)
      enforce_incoming_boundary(importer = source_path, target = dep)
      let dep_owner = nearest_vpkg_path(dep)
      if dep_owner == package_contract && dep != package_contract {
        collect_package_hash_source_closure(package_contract = package_contract, package_dir = package_dir, source_path = dep, sources = sources, visited = visited)
      } else {
        ()
      }
      i = i + 1
    }
  }
}

/// #1872: the cache-backed steps of source collection. The collection core
/// (`collect_sources_source`) decides WHAT to read, in which order, and which
/// rules a module must pass; a provider answers these requests, which on the
/// filesystem lane are served from persistent caches (module headers,
/// contract facades, directory-shared import prefixes). Cache writes
/// therefore happen in the provider, at the filesystem boundary, never in the
/// core. Pin verification is the core's own: it hashes the package's
/// sources over `Source` (`verify_recorded_package_id`).
///
/// Each answer carries its failure as `Some(message)` and the core rethrows
/// it (`source_answer`; see `ModuleParse` for why an arm must not throw).
export effect SourceIngest {
  // The resolved dependency paths of `path` whose ingested text is the
  // second argument (`module_header_source_with_config`'s deps).
  Header(String, String) -> (Array[String], Option[String])
  // A contract's facade, from its pin-blanked text (without the facade
  // marker, which the core adds).
  DesugarContract(String, String) -> (String, Option[String])
  // An ordinary module's text with its directory-shared vpkg imports applied.
  ShareImports(String, String) -> (String, Option[String])
}

/// #1872: the recursive source-collection walk, over `Source` and
/// `SourceIngest` only -- no ambient filesystem authority. Dependencies come
/// before their importer; every module passes the existence, regular-entry
/// and one-index checks, the package-boundary rule, and pin verification of
/// the packages it imports, in the same order on every provider.
fn collect_sources_rec_source(path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with Env + Exception + Source + SourceIngest {
  if path_set_contains(set = visited, path = path) {
    ()
  }
  else {
    path_set_add(set = visited, path = path)
    // #831: safety net. `path` normally already passed the located,
    // raw-import-spelling-aware existence check in header_cache.vibe's
    // `resolve_checked_path` before it ever became a dep here -- but this
    // recursion is also entered directly for the top-level entry path (no
    // importer, no located import site) and can replay a WARM persistent
    // header cache written before that check existed (stale fallback dep).
    // On the filesystem provider `Fs::read_file` is a raw host primitive: a
    // missing file there is a JS-level throw from the host runner, not a
    // guest `Error` effect, so it crosses the wasm/JS boundary uncaught and
    // prints a low-level crash dump instead of a diagnostic. Guard it here
    // too so no path through this recursion can still reach that raw read
    // with a nonexistent file.
    let exists = perform Source::Exists(path)
    if !exists {
      throw("cannot resolve module: \{path} does not exist")
    } else ()
    validate_index_layout(path)
    let raw_source = perform Source::Read(path)
    refuse_failed_wasm_import(raw_source)
    // #730 (D-2): require pin lines are a leading directive, extracted and
    // blanked (offset-preserving) before anything parses the source.
    let (own_pins, pin_blanked) = extract_require_pins(raw_source)
    // #2676: the pins a store import is verified against are the importer's
    // own head PLUS those of its owning contract (the nearest enclosing
    // index.vpkg, ADR-0070): a project's root index.vpkg is its manifest,
    // and `vibe add` writes the pin there, not into every file that
    // imports the package.
    let pins = with_owner_pins(path = path, own = own_pins)
    // #749: the facade MUST carry contract_facade_marker — every collected
    // source is re-ingested at the collect_source_groups_fs chokepoint, and
    // an unmarked facade re-enters desugar_contract_source_fs as if it were
    // raw contract grammar (classify_contract_stmts rejects its re-export
    // lines). This walk used to emit the bare facade; only the cold first
    // pass reaches it, so the failure hid behind the runner's module-init
    // re-run (#749).
    let source = if is_contract_ext(path) {
      let facade = source_answer(perform SourceIngest::DesugarContract(path, pin_blanked))
      String::concat(contract_facade_marker, facade)
    } else {
      // #897: directory-shared vpkg imports (see
      // `apply_vpkg_directory_shared_imports_fs`) apply here too -- this
      // cold walk builds `source` independently of `ingest_source_text_fs`
      // (it needs `pins` separately, for pin verification below), so it must
      // repeat the same ingestion step rather than silently skip it.
      source_answer(perform SourceIngest::ShareImports(path, pin_blanked))
    }
    let deps = source_answer(perform SourceIngest::Header(path, source))
    // First, recurse into dependencies (imports and re-exports)
    let mut i = 0
    while i < Array::length(deps) {
      let dep = Array::get(deps, at = i)
      enforce_incoming_boundary(importer = path, target = dep)
      // Only a store PACKAGE reference (its contract) is pin-verified;
      // paths inside an already-verified store package (its impl files)
      // are covered by that package's hash.
      if String::starts_with(dep, prefix = ".vibe/store/") && is_contract_ext(dep) {
        verify_store_package(importer = path, pins = pins, store_index_path = dep)
      } else if is_contract_ext(dep) && String::last_index_of(dep, needle = "@") >= 0 {
        // #751: dev-mode lane (workspace lib/ OR a VIBE_LIB external root —
        // any @-named package contract that is not the store) — pin
        // optional but verified when present; VIBE_REQUIRE_PINS=1 demands it.
        verify_lib_package(importer = path, pins = pins, lib_index_path = dep)
      } else ()
      collect_sources_rec_source(path = dep, sources = sources, visited = visited)
      i = i + 1
    }
    // Then add this module (dependencies come first)
    Array::push(sources, value = (path, source))
  }
}

/// #1872: every source reachable from `entry_path`, in dependency order
/// (dependencies first), as (path, ingested text). The read-only collection
/// core: a provider supplies `Source` and `SourceIngest`.
export fn collect_sources_source(_ entry_path: String) -> Array[(String, String)] with Env + Exception + Source + SourceIngest {
  let sources = array_empty()
  let visited = path_set_new()
  collect_sources_rec_source(path = entry_path, sources = sources, visited = visited)
  sources
}

/// The filesystem provider of `SourceIngest` for the collection walk: each
/// request is the cache-backed filesystem step the walk used to call
/// directly, with its failure handed back rather than thrown.
fn ingest_header_answer_fs(path: String, source: String, cfg: TargetCfg) -> (Array[String], Option[String]) with Env + Fs {
  handle {
    let (deps, _, _) = load_or_parse_module_header_fs_with_config(path = path, source = source, parse_count = 0, cfg = cfg)
    (deps, None)
  } with { Exception::Throw(message) => (array_empty(), Some(message)) }
}

fn ingest_contract_answer_fs(path: String, pin_blanked: String, cfg: TargetCfg) -> (String, Option[String]) with Env + Fs {
  handle {
    (desugar_contract_source_fs_with_config(path = path, source = pin_blanked, cfg = cfg), None)
  } with { Exception::Throw(message) => ("", Some(message)) }
}

fn ingest_shared_imports_answer_fs(path: String, pin_blanked: String, cfg: TargetCfg) -> (String, Option[String]) with Env + Fs {
  handle {
    (apply_vpkg_directory_shared_imports_fs_with_config(path = path, pin_blanked = pin_blanked, cfg = cfg), None)
  } with { Exception::Throw(message) => ("", Some(message)) }
}

/// The filesystem adapter of the collection core. Source reads take the
/// stat-token text memo (`cache_read_source_fs`), as the walk always did.
fn collect_sources_walk_fs(_ entry_path: String, cfg: TargetCfg) -> Array[(String, String)] with Env + Exception + Fs {
  handle {
    collect_sources_source(entry_path)
  } with { SourceIngest::Header(p, text) => resume(ingest_header_answer_fs(path = p, source = text, cfg = cfg)); SourceIngest::DesugarContract(p, text) => resume(ingest_contract_answer_fs(path = p, pin_blanked = text, cfg = cfg)); SourceIngest::ShareImports(p, text) => resume(ingest_shared_imports_answer_fs(path = p, pin_blanked = text, cfg = cfg)); Source::Read(p) => resume(cache_read_source_fs(p)); Source::Exists(p) => resume(Fs::exists(p)); Source::List(p) => resume(Fs::readdir(p)); Source::StatToken(p) => resume(Fs::stat_token(p)) }
}

/// `exists` follows symlinks. Inspect an absent path's directory entry before
/// treating it as virtual, so a dangling symlink still reaches the lstat-based
/// regular-source policy. A genuinely new buffer has no stat token to reuse.
fn query_entry_stat_token_fs(_ path: String) -> Int with Fs {
  if Fs::exists(path) {
    Fs::stat_token(path)
  } else {
    let parent = dir_of_path(path)
    let directory = if parent == "" {
      "."
    } else {
      parent
    }
    if Fs::exists(directory) && contains_path(visited = Fs::readdir(directory), path = path_basename(path)) {
      Fs::stat_token(path)
    } else {
      0
    }
  }
}

/// Prepare an ordinary query entry from its current text before discovering
/// imports. Other files still come from disk. Keep the original entry path:
/// resolving a temporary sibling instead changes package and module identity.
/// Do not read or publish whole-closure caches stamped with the disk entry.
/// An entry before its first save has a neutral stat token for the regular-file
/// policy; existing entries still pass the real symlink check.
export fn collect_source_groups_fs_with_entry_source(entry_path: String, source: String, cfg: TargetCfg) -> Array[(String, Array[(String, String)])] with Env + Exception + Fs {
  let entry_token = query_entry_stat_token_fs(entry_path)
  ensure_regular_source_token(path = entry_path, token = entry_token)
  if Fs::is_dir(entry_path) {
    throw("module source is a directory: \{entry_path}")
  } else ()
  if !String::ends_with(entry_path, suffix = ".vibe") && !String::ends_with(entry_path, suffix = ".vibex") {
    throw("current-buffer project queries require a .vibe or .vibex entry; save the package contract before querying it")
  } else ()
  if String::ends_with(entry_path, suffix = ".vibex") {
    validate_vibex_entry_source_with_config(path = entry_path, source = source, cfg = cfg)
  } else ()
  let sources = handle {
    collect_sources_source(entry_path)
  } with { SourceIngest::Header(p, text) => resume(ingest_header_answer_fs(path = p, source = text, cfg = cfg)); SourceIngest::DesugarContract(p, text) => resume(ingest_contract_answer_fs(path = p, pin_blanked = text, cfg = cfg)); SourceIngest::ShareImports(p, text) => resume(ingest_shared_imports_answer_fs(path = p, pin_blanked = text, cfg = cfg)); Source::Read(p) => resume(if p == entry_path {
    source
  } else {
    cache_read_source_fs(p)
  }); Source::Exists(p) => resume(p == entry_path || Fs::exists(p)); Source::List(p) => resume(Fs::readdir(p)); Source::StatToken(p) => resume(if p == entry_path {
    entry_token
  } else {
    Fs::stat_token(p)
  }) }
  move_entry_last_grouped(groups = ingest_grouped_sources_fs([
    ("query", sources)
  ], cfg = cfg), entry_path = entry_path)
}

/// Recursively collect all source files from filesystem, following imports and re-exports.
/// Returns Array[(path, source)] in dependency order (dependencies first).
export fn collect_all_sources_fs(_ entry_path: String) -> Array[(String, String)] with Env + Exception + Fs {
  collect_all_sources_fs_with_config(entry_path, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn collect_all_sources_fs_with_config(_ entry_path: String, cfg: TargetCfg) -> Array[(String, String)] with Env + Exception + Fs {
  match special_manifest_sources(entry_path) {
    Some((manifest_path, sources)) => {
      let _ = manifest_path
      copy_source_specs(sources)
    },
    None => {
      ingestion_pipeline_telemetry_add(index = 0, amount = 1)
      match load_persistent_sources_cache_if_valid(entry_path, cfg = cfg) {
        Some(sources) => {
          ingestion_pipeline_telemetry_add(index = 1, amount = 1)
          sources
        },
        None => {
          ingestion_pipeline_telemetry_add(index = 2, amount = 1)
          // Every source-list miss enters exactly one cold collection attempt,
          // whether a fresh manifest wins or recursion is ultimately required.
          ingestion_pipeline_telemetry_add(index = 9, amount = 1)
          match try_collect_manifest_sources_fs_with_config(entry_path, cfg = cfg) {
            Some((manifest_path, sources)) => {
              store_persistent_sources_cache(entry_path = entry_path, manifest_path = Some(manifest_path), sources = sources, cfg = cfg)
              sources
            },
            None => {
              match try_load_manifest_rows(entry_path) {
                Some((base_dir, rows)) => {
                  let manifest_path = loader_join_path(base_dir = base_dir, rel_path = "compiler_sources_manifest.tsv")
                  let preloaded_sources = load_manifest_full_sources(base_dir = base_dir, rows = rows)
                  store_persistent_sources_cache(entry_path = entry_path, manifest_path = Some(manifest_path), sources = preloaded_sources, cfg = cfg)
                  preloaded_sources
                },
                None => {
                  let sources = collect_sources_walk_fs(entry_path, cfg = cfg)
                  store_persistent_sources_cache(entry_path = entry_path, manifest_path = None, sources = sources, cfg = cfg)
                  sources
                }
              }
            }
          }
        }
      }
    }
  }
}

/// #740: the grouped merge (db_grouped_merged_source) treats the LAST
/// flattened source as the export-rename plan entry — its exports stay
/// UNRENAMED. Manifest collection returns sources in MANIFEST ROW ORDER, so a
/// manifest-listed entry that is not the last needed row left some LATER dep
/// exempt from renames instead of the entry: callers were rewritten to that
/// dep's `_exp_<path>` names whose defs were never emitted ("undefined
/// variable (local): ripple_get_fingerprint_exp_..." when FS-compiling
/// runtime/typecheck_fs.vibe, row 152, whose ripple deps sit at rows 150-151).
/// Centralized here (rather than in each collection branch) so groups
/// reconstructed from PERSISTENT CACHES get the same ordering guarantee.
/// No-op when the entry is already last (the plain recursive walk).
fn move_entry_last_grouped(groups: Array[(String, Array[(String, String)])], entry_path: String) -> Array[(String, Array[(String, String)])] {
  let glen = Array::length(groups)
  let mut total = 0
  let mut gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, at = gi)
    total = total + Array::length(gsources)
    gi = gi + 1
  }
  let mut seen = 0
  let mut entry_is_last = false
  let mut entry_found = false
  let mut entry_source = ""
  gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(gsources) {
      seen = seen + 1
      let (spath, stext) = Array::get(gsources, at = si)
      if spath == entry_path {
        entry_found = true
        entry_source = stext
        if seen == total {
          entry_is_last = true
        } else {
          ()
        }
      } else {
        ()
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if !entry_found || entry_is_last {
    groups
  } else {
    let out = loader_empty_grouped_sources()
    gi = 0
    while gi < glen {
      let (gname, gsources) = Array::get(groups, at = gi)
      let mut si = 0
      while si < Array::length(gsources) {
        let (spath, stext) = Array::get(gsources, at = si)
        if spath == entry_path {
          ()
        } else {
          push_grouped_source(groups = out, group_name = gname, path = spath, source = stext)
        }
        si = si + 1
      }
      gi = gi + 1
    }
    push_grouped_source(groups = out, group_name = "entry_last", path = entry_path, source = entry_source)
    out
  }
}

export fn collect_source_groups_fs(_ entry_path: String) -> Array[(String, Array[(String, String)])] with Env + Exception + Fs {
  collect_source_groups_fs_with_config(entry_path, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn collect_source_groups_fs_with_config(_ entry_path: String, cfg: TargetCfg) -> Array[(String, Array[(String, String)])] with Env + Exception + Fs {
  if String::ends_with(entry_path, suffix = ".vibex") {
    ensure_regular_source_fs(entry_path)
    validate_vibex_entry_source_with_config(path = entry_path, source = Fs::read_file(entry_path), cfg = cfg)
  } else {
    ()
  }
  let collected = match special_manifest_source_groups(entry_path) {
    Some((manifest_path, groups)) => {
      let _ = manifest_path
      copy_grouped_sources(groups)
    },
    None => {
      ingestion_pipeline_telemetry_add(index = 3, amount = 1)
      match load_persistent_source_groups_cache_if_valid(entry_path, cfg = cfg) {
        Some(groups) => {
          ingestion_pipeline_telemetry_add(index = 4, amount = 1)
          groups
        },
        None => {
          ingestion_pipeline_telemetry_add(index = 5, amount = 1)
          ingestion_pipeline_telemetry_add(index = 6, amount = 1)
          ingestion_pipeline_telemetry_add(index = 0, amount = 1)
          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path, cfg = cfg) {
            Some((manifest_path, groups)) => {
              ingestion_pipeline_telemetry_add(index = 1, amount = 1)
              ingestion_pipeline_telemetry_add(index = 7, amount = 1)
              store_persistent_source_groups_cache(entry_path = entry_path, manifest_path = manifest_path, groups = groups, cfg = cfg)
              groups
            },
            None => {
              ingestion_pipeline_telemetry_add(index = 2, amount = 1)
              ingestion_pipeline_telemetry_add(index = 8, amount = 1)
              match try_collect_manifest_source_groups_fs_with_config(entry_path, cfg = cfg) {
                Some((manifest_path, groups)) => {
                  store_persistent_source_groups_cache(entry_path = entry_path, manifest_path = Some(manifest_path), groups = groups, cfg = cfg)
                  groups
                },
                None =>
                match try_load_manifest_rows(entry_path) {
                  Some((base_dir, rows)) => {
                    let manifest_path = loader_join_path(base_dir = base_dir, rel_path = "compiler_sources_manifest.tsv")
                    let preloaded_sources = load_manifest_full_sources(base_dir = base_dir, rows = rows)
                    let groups = loader_empty_grouped_sources()
                    let mut j = 0
                    while j < Array::length(rows) {
                      let (group_name, rel_path) = Array::get(rows, at = j)
                      let path = loader_join_path(base_dir = base_dir, rel_path = rel_path)
                      let mut found = ""
                      let mut k = 0
                      while k < Array::length(preloaded_sources) {
                        if found == "" {
                          let (source_path, source_text) = Array::get(preloaded_sources, at = k)
                          if source_path == path {
                            found = source_text
                          }
                        }
                        k = k + 1
                      }
                      if found == "" {
                        ()
                      } else {
                        push_grouped_source(groups = groups, group_name = group_name, path = path, source = found)
                      }
                      j = j + 1
                    }
                    store_persistent_source_groups_cache(entry_path = entry_path, manifest_path = Some(manifest_path), groups = groups, cfg = cfg)
                    groups
                  },
                  None => {
                    let groups = loader_empty_grouped_sources()
                    let recursive_sources = collect_all_sources_fs_with_config(entry_path, cfg = cfg)
                    Array::push(groups, value = ("recursive", recursive_sources))
                    store_persistent_source_groups_cache(entry_path = entry_path, manifest_path = None, groups = groups, cfg = cfg)
                    groups
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  move_entry_last_grouped(groups = ingest_grouped_sources_fs(collected, cfg = cfg), entry_path = entry_path)
}

//# Module bundling — merge stmts from all modules in dependency order
/// Given all sources (in dependency order), parse and merge their statements.
/// Skips SImport, SReExport (already resolved). Keeps all definitions.
/// #1584: an `import { x as y }` alias must be rewritten back to the
/// original name before the import statement is dropped — the merged flat
/// program only defines `x`, so a surviving `y` reference resolves to
/// nothing and traps at runtime. append_import_alias_rewritten_* is the
/// same shadow-aware rewrite the production FS merge applies; a file with
/// no aliases takes its share-the-input fast path. A top-level `let`/`fn`
/// whose name matches an alias shadows the import for the WHOLE file (the
/// per-statement rewrite only suppresses the map inside the declaring
/// statement), so those aliases are dropped from the map up front.
export fn collect_merged_stmts(_ sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  collect_merged_stmts_with_config(sources, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn collect_merged_stmts_with_config(_ sources: Array[(String, String)], cfg: TargetCfg) -> Array[Stmt] with Exception {
  // #1840: a fixed source set that contains an ingested contract's FACADE
  // but not its materialized types module would lose the contract's type
  // family entirely (the facade re-exports it; this merge skips
  // import-family statements). Re-inject each registered types module whose
  // originating contract is in THIS set and whose own path is not already a
  // source (the FS-walk lanes collect the file itself — no duplication).
  let sources_all = array_empty()
  let mut ci = 0
  while ci < Array::length(sources) {
    Array::push(sources_all, value = Array::get(sources, at = ci))
    ci = ci + 1
  }
  let mut ri = 0
  while ri < Array::length(vpkg_types_registry_paths) {
    let r_contract = Array::get(vpkg_types_registry_contracts, at = ri)
    let r_path = Array::get(vpkg_types_registry_paths, at = ri)
    let mut has_contract = false
    let mut has_types = false
    let mut pi = 0
    while pi < Array::length(sources) {
      let (sp, _) = Array::get(sources, at = pi)
      if sp == r_contract {
        has_contract = true
      } else {
        ()
      }
      if sp == r_path {
        has_types = true
      } else {
        ()
      }
      pi = pi + 1
    }
    if has_contract && !has_types && Array::get(vpkg_types_registry_cfgs, at = ri) == target_cfg_identity(cfg) {
      Array::push(sources_all, value = (r_path, Array::get(vpkg_types_registry_texts, at = ri)))
    } else {
      ()
    }
    ri = ri + 1
  }
  let merged = array_empty()
  let mut si = 0
  while si < Array::length(sources_all) {
    let (_, src) = Array::get(sources_all, at = si)
    // Use lex+parse_program_with_cfg directly (skip resolve_interp_stmt to reduce heap pressure)
    let stmts = parse_program_with_cfg(lex(src), cfg_flags = target_cfg_flags(cfg))
    let top_level_value_names = array_empty()
    let mut ti = 0
    while ti < Array::length(stmts) {
      match Array::get(stmts, at = ti) {
        SLet(_, _, name, _, _) => Array::push(top_level_value_names, value = name),
        SLetMut(name, _, _) => Array::push(top_level_value_names, value = name),
        _ => ()
      }
      ti = ti + 1
    }
    append_import_alias_rewritten_non_import_stmts_skipping(merged = merged, stmts = stmts, skipped_locals = top_level_value_names)
    si = si + 1
  }
  merged
}
/// #847-style trap-free directory probe (see loader/header_cache.vibe's
/// fs_is_directory for the full rationale): `Fs::readdir` TRAPS the whole
/// wasm instance on a non-directory, so a real directory test is required
/// before ever calling it speculatively. Appending "/." and testing with
/// `Fs::exists` is safe on the frozen bootstrap seed (predates `Fs::is_dir`).
fn vpkg_scan_is_directory(_ path: String) -> Bool with Fs {
  Fs::exists(String::concat(path, "/."))
}
/// #897 (ADR-0070): directories this scan skips entirely -- not source, or
/// not part of this repo's own migration surface (vendored/fetched content,
/// build output, VCS metadata). Anything starting with "." already covers
/// `.git`/`.vibe` (the content-addressed store lives under `.vibe/store/`).
fn vpkg_scan_skip_dir(_ name: String) -> Bool {
  (String::length(name) > 0 && String::char_code_at(name, at = 0) == '.') || name == "_build" || name == "node_modules" || name == "target" || name == "deps"
}
/// #897 (ADR-0070): recurse into every non-skipped directory under `root`,
/// recording any directory that has `index.vibei` or plain `index.vibe` but
/// NOT YET `index.vpkg` -- exactly the 76-directory migration surface ADR-
/// 0070 counts. A directory with none of the three index files is not a
/// package boundary and is out of scope. Unlike contract_sibling_impl_raws_
/// rec (which stops at a nested boundary because its job is to list PLAIN
/// impl files), this must recurse THROUGH boundaries too, since nested
/// sub-packages are themselves part of the migration surface.
fn vpkg_scan_rec(dir: String, out: Array[String]) -> Unit with Exception + Fs {
  let has_vpkg = Fs::exists(String::concat(dir, "/index.vpkg"))
  let has_vibei = Fs::exists(String::concat(dir, "/index.vibei"))
  let has_vibe = Fs::exists(String::concat(dir, "/index.vibe"))
  if !has_vpkg && (has_vibei || has_vibe) {
    Array::push(out, value = dir)
  } else {
    ()
  }
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    if !vpkg_scan_skip_dir(name) {
      let full = String::concat(dir, String::concat("/", name))
      if vpkg_scan_is_directory(full) {
        vpkg_scan_rec(dir = full, out = out)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}
/// find_missing_vpkg_dirs: (String) -> Array[String] with Exception + Fs
export fn find_missing_vpkg_dirs(_ root: String) -> Array[String] with Exception + Fs {
  let out = array_empty()
  vpkg_scan_rec(dir = root, out = out)
  out
}
/// check_missing_vpkg_dirs: (String) -> Int with Exception + Fs
/// #897/ADR-0070: `vibe check --missing-vpkg <root>` diagnostic. Reports (via
/// throw, matching every other `vibe check` diagnostic's error-surfacing
/// convention) every directory under `root` still on the old `index.vibei`
/// or bare `index.vibe` spelling, so the migration's remaining scope is a
/// single command away instead of manual auditing.
export fn check_missing_vpkg_dirs(_ root: String) -> Int with Exception + Fs {
  let missing = find_missing_vpkg_dirs(root)
  if Array::length(missing) == 0 {
    0
  } else {
    throw(String::concat("missing index.vpkg (#897) in: ", String::join(missing, sep = ", ")))
  }
}
/// #1145 follow-up 2: for the `index.vpkg` at `dir` (if any), checks that
/// every external (`@scope/pkg`) import in its own production impl files
/// (the same discovery `contract_package_hashes_fs` uses: explicit
/// `import ./x.vibe {}` entries plus contract_sibling_impl_raws' auto-
/// discovered siblings -- tests/benches excluded) has a matching `deps`
/// entry. A package that predates the #1128 migration (no `name = `
/// directive) has nothing to check yet -- `deps` declarations are opt-in
/// until the bootstrap-bump migrates the remaining closure (#1145
/// follow-up 1).
fn package_deps_missing(_ dir: String) -> Array[String] with Env + Exception + Fs {
  let vpkg_path = String::concat(dir, "/index.vpkg")
  if !Fs::exists(vpkg_path) {
    array_empty()
  } else {
    let raw = cache_read_source_fs(vpkg_path)
    let name = extract_package_name(raw)
    if name == "" {
      array_empty()
    } else {
      let deps = extract_package_deps(raw)
      let (_pins, blanked) = extract_require_pins(raw)
      let (_decls, _opaques, extra) = parse_contract_program(lex(blanked))
      let (impl_raws0, _type_defs) = classify_contract_stmts(extra)
      let impl_raws = merge_impl_raws_dedupe(explicit = impl_raws0, discovered = contract_sibling_impl_raws(dir))
      let impl_sources = array_empty()
      let mut i = 0
      while i < Array::length(impl_raws) {
        let resolved = loader_resolve_path_fs(base_dir = dir, raw_path = Array::get(impl_raws, at = i))
        Array::push(impl_sources, value = cache_read_source_fs(resolved))
        i = i + 1
      }
      let missing = deps_missing_for_imports(deps = deps, impl_sources = impl_sources)
      let out = array_empty()
      let mut mi = 0
      while mi < Array::length(missing) {
        Array::push(out, value = "\{dir}: import of \{Array::get(missing, at = mi)} not declared in deps")
        mi = mi + 1
      }
      out
    }
  }
}
fn deps_missing_scan_rec(dir: String, out: Array[String]) -> Unit with Env + Exception + Fs {
  let here = package_deps_missing(dir)
  let mut hi = 0
  while hi < Array::length(here) {
    Array::push(out, value = Array::get(here, at = hi))
    hi = hi + 1
  }
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    if !vpkg_scan_skip_dir(name) {
      let full = String::concat(dir, String::concat("/", name))
      if vpkg_scan_is_directory(full) {
        deps_missing_scan_rec(dir = full, out = out)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}
/// find_deps_missing: (String) -> Array[String] with Exception + Fs
/// #1145 follow-up 2: recursively scans every `index.vpkg` under `root` for
/// deps declarations missing an entry that its own imports require.
export fn find_deps_missing(_ root: String) -> Array[String] with Env + Exception + Fs {
  let out = array_empty()
  deps_missing_scan_rec(dir = root, out = out)
  out
}
/// check_deps_missing: (String) -> Int with Exception + Fs
/// #1145 follow-up 2: `vibe check --deps-missing <root>` diagnostic.
export fn check_deps_missing(_ root: String) -> Int with Env + Exception + Fs {
  let missing = find_deps_missing(root)
  if Array::length(missing) == 0 {
    0
  } else {
    throw(String::concat("deps missing for imports (#1128/#1145): ", String::join(missing, sep = "; ")))
  }
}

/// Collect the complete source closure under one invocation's target flags.
export fn collect_all_sources_fs_configured(_ entry_path: String) -> Array[(String, String)] with Config + Env + Exception + Fs {
  let cfg = target_cfg_capture()
  collect_all_sources_fs_with_config(entry_path, cfg = cfg)
}

/// Source groups, ingestion and their persistent caches share this snapshot.
export fn collect_source_groups_fs_configured(_ entry_path: String) -> Array[(String, Array[(String, String)])] with Config + Env + Exception + Fs {
  let cfg = target_cfg_capture()
  collect_source_groups_fs_with_config(entry_path, cfg = cfg)
}
