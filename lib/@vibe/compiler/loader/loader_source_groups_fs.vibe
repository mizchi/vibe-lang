/// #740: manifest source loaders (manifest_sources.vibe) read RAW disk bytes;
/// a .vibei contract reaching the grouped merge un-desugared left its imports
/// unresolvable ("undefined variable (local): sha1 @call" — contract/index.vibe's
/// @vibe/core import never rewrote). Ingest every collected source once here,
/// the single point all collection branches (manifest, caches, recursive walk)
/// flow through.
fn grouped_sources_group_for_path(groups: Array[(String, Array[(String, String)])], path: String) -> String {
  let mut found = ""
  let mut gi = 0
  while gi < Array::length(groups) && found == "" {
    let (gname, sources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) && found == "" {
      let (sp, _) = Array::get(sources, at = si)
      if sp == path {
        found = gname
      } else {
        si = si + 1
      }
    }
    gi = gi + 1
  }
  found
}

/// #1840/#1921: collect_merged_stmts already re-injects materialized vpkg
/// types modules into a fixed source set. The typecheck walk seeds only
/// what collect_source_groups_fs returns, so a compiler_sources_manifest
/// that lists the contract but not `.vibe/build/vpkg_types/` left the stub
/// in header deps and missing from the coordinator env cache.
/// Attach the stub to the contract's existing group so manifest group order
/// (entry last) stays intact.
fn append_registered_vpkg_types_sources(_ groups: Array[(String, Array[(String, String)])], cfg: TargetCfg) -> Unit {
  let mut ri = 0
  while ri < Array::length(vpkg_types_registry_paths) {
    let r_contract = Array::get(vpkg_types_registry_contracts, at = ri)
    let r_path = Array::get(vpkg_types_registry_paths, at = ri)
    let contract_group = grouped_sources_group_for_path(groups = groups, path = r_contract)
    let types_group = grouped_sources_group_for_path(groups = groups, path = r_path)
    if contract_group != "" && types_group == "" && Array::get(vpkg_types_registry_cfgs, at = ri) == target_cfg_identity(cfg) {
      push_grouped_source(groups = groups, group_name = contract_group, path = r_path, source = Array::get(vpkg_types_registry_texts, at = ri))
    } else {
      ()
    }
    ri = ri + 1
  }
}

fn ingest_grouped_sources_fs(_ groups: Array[(String, Array[(String, String)])], cfg: TargetCfg) -> Array[(String, Array[(String, String)])] with Env + Exception + Fs {
  let out = loader_empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (gname, gsources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(gsources) {
      let (spath, stext) = Array::get(gsources, at = si)
      push_grouped_source(groups = out, group_name = gname, path = spath, source = ingest_source_text_fs_with_config(path = spath, raw = stext, cfg = cfg))
      si = si + 1
    }
    gi = gi + 1
  }
  append_registered_vpkg_types_sources(out, cfg = cfg)
  out
}

fn load_cached_sources_rec(specs: Array[(String, String, String)], index: Int, out: Array[(String, String)], cfg: TargetCfg) -> Option[Array[(String, String)]] with Env + Exception + Fs {
  if index >= Array::length(specs) {
    Some(out)
  } else {
    let (path, stat_token_text, source_fingerprint) = Array::get(specs, at = index)
    match load_source_if_cached_file_spec_matches(path = path, stat_token_text = stat_token_text, source_fingerprint = source_fingerprint) {
      Some(source) => {
        Array::push(out, value = (path, ingest_source_text_fs_with_config(path = path, raw = source, cfg = cfg)))
        load_cached_sources_rec(specs = specs, index = index + 1, out = out, cfg = cfg)
      },
      None => None
    }
  }
}

fn load_cached_grouped_sources_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])], cfg: TargetCfg) -> Option[Array[(String, Array[(String, String)])]] with Env + Exception + Fs {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, at = index)
    match load_source_if_cached_file_spec_matches(path = path, stat_token_text = stat_token_text, source_fingerprint = source_fingerprint) {
      Some(source) => {
        push_grouped_source(groups = out, group_name = group_name, path = path, source = ingest_source_text_fs_with_config(path = path, raw = source, cfg = cfg))
        load_cached_grouped_sources_rec(rows = rows, index = index + 1, out = out, cfg = cfg)
      },
      None => None
    }
  }
}

fn load_cached_group_fingerprint_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with Env + Exception + Fs {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, at = index)
    if !(loader_matches_cached_file_spec(path = path, stat_token_text = stat_token_text, source_fingerprint = source_fingerprint)) {
      None
    } else {
      push_grouped_source_fingerprint(groups = out, group_name = group_name, path = path, source_fingerprint = source_fingerprint)
      load_cached_group_fingerprint_rec(rows = rows, index = index + 1, out = out)
    }
  }
}

fn manifest_cache_is_valid(_ manifest: Option[(String, String, String)]) -> Bool with Env + Exception + Fs {
  match manifest {
    Some((path, stat_token_text, source_fingerprint)) =>
    loader_matches_cached_file_spec(path = path, stat_token_text = stat_token_text, source_fingerprint = source_fingerprint),
    None => true
  }
}

fn load_persistent_sources_cache_if_valid(_ entry_path: String, cfg: TargetCfg) -> Option[Array[(String, String)]] with Env + Exception + Fs {
  let cache_path = persistent_source_list_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx = resctx, entry_path = entry_path, paths = source_cache_spec_paths(specs))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_sources_rec(specs = specs, index = 0, out = empty_source_specs(), cfg = cfg)
    }
  }
}

fn load_persistent_source_groups_cache_if_valid(_ entry_path: String, cfg: TargetCfg) -> Option[Array[(String, Array[(String, String)])]] with Env + Exception + Fs {
  let cache_path = persistent_source_group_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx = resctx, entry_path = entry_path, paths = group_cache_row_paths(rows))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_grouped_sources_rec(rows = rows, index = 0, out = loader_empty_grouped_sources(), cfg = cfg)
    }
  }
}

fn manifest_path_of(_ manifest: Option[(String, String, String)]) -> Option[String] {
  match manifest {
    Some((path, _, _)) => Some(path),
    None => None
  }
}

fn load_persistent_source_groups_from_source_list_cache_if_valid(_ entry_path: String, cfg: TargetCfg) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with Env + Exception + Fs {
  let cache_path = persistent_source_list_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx = resctx, entry_path = entry_path, paths = source_cache_spec_paths(specs))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_sources_rec(specs = specs, index = 0, out = empty_source_specs(), cfg = cfg) {
        Some(sources) =>
        match try_load_manifest_rows(entry_path) {
          Some((base_dir, rows)) => {
            let groups = build_grouped_sources_from_manifest_rows(base_dir = base_dir, rows = rows, sources = sources)
            // #801 bug 2: `sources` comes from the source-LIST cache, a
            // SEPARATE persistent cache from the group cache being rebuilt
            // here. Each cache independently passes its own resctx/manifest
            // validity check, but that does not guarantee the two enumerate
            // the SAME file set -- e.g. the list cache may have been seeded
            // via a plain recursive walk (or an older manifest snapshot)
            // that never reached every manifest-listed group.
            // build_grouped_sources_from_manifest_rows silently drops any
            // manifest row with no matching path in `sources`, so a
            // stale/narrower list cache can make an entire group vanish
            // with no signal (observed: lib/@vibe/core's vibe_core /
            // index.vibei group dropped wholesale, 50/51 rows survived).
            // Cross-validate the reconstruction against the manifest's own
            // row count before trusting (and persisting) it: a short count
            // means rows were dropped, so refuse this lane and let the
            // caller fall through to a fresh manifest collection
            // (try_collect_manifest_source_groups_fs) that rebuilds the
            // correct groups directly from disk instead of silently
            // caching/returning the incomplete graph.
            if Array::length(flatten_group_sources(groups)) != Array::length(rows) {
              None
            } else {
              Some((manifest_path_of(manifest), groups))
            }
          },
          None => {
            let groups = loader_empty_grouped_sources()
            Array::push(groups, value = ("recursive", sources))
            Some((None, groups))
          }
        },
        None => None
      }
    }
  }
}

export fn load_persistent_source_group_fingerprint_if_valid(_ entry_path: String) -> Option[String] with Env + Exception + Fs {
  load_persistent_source_group_fingerprint_if_valid_with_config(entry_path, cfg = target_cfg_ambient())
}

/// The same operation with caller-owned target flags and cache identity.
export fn load_persistent_source_group_fingerprint_if_valid_with_config(_ entry_path: String, cfg: TargetCfg) -> Option[String] with Env + Exception + Fs {
  let cache_path = persistent_source_group_cache_path_in_namespace(entry_path, namespace = target_cfg_namespace(cfg))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx = resctx, entry_path = entry_path, paths = group_cache_row_paths(rows))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_group_fingerprint_rec(rows = rows, index = 0, out = loader_empty_grouped_sources()) {
        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),
        None => None
      }
    }
  }
}

/// #769: O(N) build via StringBuilder. The previous `out = String::concat(out,
/// row)` per row was O(N^2) over the row count -- on the heaviest standalone
/// closures (cache_probe_cli_prepare_batch_bench_test pulls the whole compiler)
/// the bump-allocated concat garbage blew past the 4GB wasm32 address space in
/// ~3s (peak RSS 3.6GB measured) and memory.grow's ignored failure surfaced as
/// a "memory access out of bounds" inside String::concat's memory.copy. Same
/// fix and issue class as stable_cache_path's #366 note (lib/@vibe/cache).
export fn build_persistent_sources_cache_text(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> String with Env + Exception + Fs {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, value = "version\t4\n")
  StringBuilder::push(sb, value = "resctx\t")
  StringBuilder::push(sb, value = persistent_resolution_context_fingerprint_fs(entry_path = entry_path, paths = source_paths(sources)))
  StringBuilder::push(sb, value = "\n")
  match manifest_path {
    Some(path) => {
      StringBuilder::push(sb, value = "manifest\t")
      StringBuilder::push(sb, value = hex_encode(path))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = fingerprint_file_fs(path))
      StringBuilder::push(sb, value = "\n")
    },
    None => ()
  }
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, at = i)
    // #769: skip empty-path rows -- `Fs::stat_token("")` throws in the host
    // (ENOENT stat ''), and a pathless row could never be validated on reload
    // anyway. Empty paths have been observed reaching this writer through the
    // recursive-collection lane (cache_probe_loader_manifest_groups_bench /
    // collect_source_groups_fs_with_config on some entries); the row origin is tracked
    // separately, but the writer must never crash the whole compile over it.
    if String::length(path) == 0 {
      ()
    } else {
      StringBuilder::push(sb, value = "source\t")
      StringBuilder::push(sb, value = hex_encode(path))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = compact_source_fingerprint_memo(path = path, source = source))
      StringBuilder::push(sb, value = "\n")
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// #769: O(N) via StringBuilder, same rationale as
/// build_persistent_sources_cache_text above.
fn build_persistent_source_groups_cache_text(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> String with Env + Exception + Fs {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, value = "version\t4\n")
  StringBuilder::push(sb, value = "resctx\t")
  StringBuilder::push(sb, value = persistent_resolution_context_fingerprint_fs(entry_path = entry_path, paths = grouped_source_paths(groups)))
  StringBuilder::push(sb, value = "\n")
  match manifest_path {
    Some(path) => {
      StringBuilder::push(sb, value = "manifest\t")
      StringBuilder::push(sb, value = hex_encode(path))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, value = "\t")
      StringBuilder::push(sb, value = fingerprint_file_fs(path))
      StringBuilder::push(sb, value = "\n")
    },
    None => ()
  }
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, at = si)
      // #769: skip empty-path rows (see build_persistent_sources_cache_text).
      if String::length(path) == 0 {
        ()
      } else {
        StringBuilder::push(sb, value = "group\t")
        StringBuilder::push(sb, value = hex_encode(group_name))
        StringBuilder::push(sb, value = "\t")
        StringBuilder::push(sb, value = hex_encode(path))
        StringBuilder::push(sb, value = "\t")
        StringBuilder::push(sb, value = __to_string(Fs::stat_token(path)))
        StringBuilder::push(sb, value = "\t")
        StringBuilder::push(sb, value = compact_source_fingerprint_memo(path = path, source = source))
        StringBuilder::push(sb, value = "\n")
      }
      si = si + 1
    }
    gi = gi + 1
  }
  StringBuilder::freeze(sb)
}

