/// ADR-0075 Phase 1: `.vibex` is a language-level executable root, not a
/// launcher convention. Validate the preserving AST before fn declarations
/// are lowered to SLet so a value-bound main cannot masquerade as canonical
/// `fn main`. Exact operation-row equality is wired in a later phase; this
/// slice fixes the file/entry shape and requires an explicit row.
fn validate_vibex_entry_source(path: String, source: String) -> Unit with Exception {
  if !String::ends_with(path, ".vibex") {
    ()
  } else {
    // #2227: a `require ... = #pkg:sha1:` pin head is a header directive,
    // not statement grammar -- blank it exactly as every build-lane
    // ingestion does (offset-preserving), or the parse below reads the
    // pin's `#pkg` as a `#` directive and rejects a file the loader
    // otherwise accepts.
    let (_, pin_blanked) = extract_require_pins(source)
    let stmts = parse_program_preserving(lex(pin_blanked))
    let mut main_count = 0
    let mut saw_value_main = false
    let mut invalid_shape = false
    let mut missing_effect_row = false
    let mut exported_main = false
    let mut export_display = ""
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SFnDecl(exported, name, value, _, _) => if name != "main" {
          // #2229 (ADR-0075): an executable root has no export surface --
          // nothing can import a .vibex, so an export in one is a promise
          // no consumer can ever reach. Record the first one; the throw
          // is below with the other shape rules.
          if exported && export_display == "" {
            export_display = "export fn \{name}"
          } else {
            ()
          }
        } else {
          main_count = main_count + 1
          if exported {
            exported_main = true
          } else {
            ()
          }
          match value {
            EFn(type_params, _, params, ret, effects, _) => {
              let returns_unit = match ret {
                Some(TyName(name)) => name == "Unit",
                _ => false
              }
              if Array::length(type_params) != 0 || Array::length(params) != 0 || !returns_unit {
                invalid_shape = true
              } else {
                ()
              }
              match effects {
                Some(_) => (),
                None => {
                  missing_effect_row = true
                }
              }
            },
            _ => {
              invalid_shape = true
            }
          }
        },
        SLet(exported, _, name, _, _) => if name == "main" {
          saw_value_main = true
        } else {
          if exported && export_display == "" {
            export_display = "export let \{name}"
          } else {
            ()
          }
        },
        SEnum(exported, name, _, _, _) => if exported && export_display == "" {
          export_display = "export enum \{name}"
        } else {
          ()
        },
        SSuberror(exported, name, _) => if exported && export_display == "" {
          export_display = "export suberror \{name}"
        } else {
          ()
        },
        SStruct(exported, name, _, _, _, _) => if exported && export_display == "" {
          export_display = "export struct \{name}"
        } else {
          ()
        },
        STypeAlias(exported, name, _, _) => if exported && export_display == "" {
          export_display = "export type \{name}"
        } else {
          ()
        },
        STrait(exported, name, _, _, _, _) => if exported && export_display == "" {
          export_display = "export trait \{name}"
        } else {
          ()
        },
        SModule(exported, name, _) => if exported && export_display == "" {
          export_display = "export module \{name}"
        } else {
          ()
        },
        SEffectDef(exported, name, _, _) => if exported && export_display == "" {
          export_display = "export effect \{name}"
        } else {
          ()
        },
        SEffectSet(exported, name, _) => if exported && export_display == "" {
          export_display = "export effectset \{name}"
        } else {
          ()
        },
        SExport(names) => if export_display == "" {
          if Array::length(names) > 0 {
            export_display = "export { \{Array::get(names, 0)} }"
          } else {
            export_display = "export { }"
          }
        } else {
          ()
        },
        SReExport(from_path, _) => if export_display == "" {
          export_display = "export \{from_path} { ... }"
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
    if saw_value_main {
      throw("\{path}: value-bound main is not allowed in .vibex; use 'fn main with <row> { ... }'")
    } else if main_count != 1 {
      throw("\{path}: .vibex executable requires exactly one fn main")
    } else if exported_main {
      throw("\{path}: .vibex fn main is an entry declaration and cannot be exported")
    } else if export_display != "" {
      // #2229 (ADR-0075): nothing can import a .vibex, so an export in one
      // is unreachable by construction -- reject it and name the move.
      throw("\{path}: .vibex is an executable root and has no export surface; move '\{export_display}' to a .vibe module and import it from main")
    } else if invalid_shape {
      throw("\{path}: .vibex fn main must have type () -> Unit")
    } else if missing_effect_row {
      throw("\{path}: .vibex fn main requires an explicit effect row; write 'with ()' for a pure entry")
    } else {
      ()
    }
  }
}

//# Path helpers

fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    match found {
      Some(_) => (),
      None => {
        let (p, src) = Array::get(sources, i)
        if p == path_key {
          found = Some(src)
        }
      }
    }
    i = i + 1
  }
  found
}

fn resolve_path_in_sources(base_dir: String, raw_path: String, sources: Array[(String, String)]) -> Option[(String, String)] {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = None
  while i < Array::length(candidates) {
    match found {
      Some(_) => (),
      None => {
        let candidate = Array::get(candidates, i)
        match source_lookup(sources, candidate) {
          Some(source) => {
            found = Some((candidate, source))
          }
          None => ()
        }
      }
    }
    i = i + 1
  }
  found
}

fn resolve_path_fs(base_dir: String, raw_path: String) -> String with Fs {
  // #1872 pilot: the probe loop lives once in core (resolve_import_path_probe,
  // `with Source`); this wrapper only discharges Source with the real
  // capability builtins. self_path = "" -- this call site never needed the
  // self-import skip (no candidate equals ""). The old #768/#778 direct-call
  // retreat is deliberately revisited here: `perform Source::Exists` inside
  // the probe is the pilot's live test of perform in this compiled unit,
  // pinned by fixtures/effect_source_pilot_test.vibe and the bootstrap gate.
  handle {
    resolve_import_path_probe(base_dir, raw_path, "")
  } with { Source::Read(p) => resume(Fs::read_file(p)); Source::Exists(p) => resume(Fs::exists(p)) }
}

/// #740: normalized for the same reason as manifest_sources' join_path —
/// manifest rows outside the compiler dir must key under the import-resolved
/// spelling.
fn join_path(base_dir: String, rel_path: String) -> String {
  if base_dir == "" {
    normalize_path(rel_path)
  } else {
    normalize_path(String::concat(base_dir, String::concat("/", rel_path)))
  }
}

fn strip_trailing_cr(line: String) -> String {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0: len - 1]
    } else {
      line
    }
  } else {
    line
  }
}

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {
  if String::ends_with(path, "compiler_sources_bundle.vibe") {
    Some((array_empty(), ["compiler_sources", "compiler_source_groups"]))
  } else {
    None
  }
}

fn split_tsv_fields(line: String) -> Array[String] {
  let fields = array_empty()
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start: i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}

let header_value_separator = String::from_char_code(31)

fn join_header_values(values: Array[String]) -> String {
  // O(N) via StringBuilder (previous accumulator was O(N^2)).
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      StringBuilder::push(sb, header_value_separator)
    }
    StringBuilder::push(sb, Array::get(values, i))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn split_header_values(text: String) -> Array[String] {
  let values = array_empty()
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start: i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}

fn empty_source_specs() -> Array[(String, String)] {
  array_empty()
}

fn copy_source_specs(sources: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_source_specs()
  let mut i = 0
  while i < Array::length(sources) {
    Array::push(out, Array::get(sources, i))
    i = i + 1
  }
  out
}

fn empty_group_specs() -> Array[(String, String, String)] {
  array_empty()
}

fn empty_source_cache_specs() -> Array[(String, String, String)] {
  array_empty()
}

fn empty_group_cache_specs() -> Array[(String, String, String, String)] {
  array_empty()
}

fn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {
  array_empty()
}

fn source_paths(sources: Array[(String, String)]) -> Array[String] {
  let paths = array_empty()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    if path != "" {
      Array::push(paths, path)
    } else ()
    i = i + 1
  }
  paths
}

fn source_cache_spec_paths(specs: Array[(String, String, String)]) -> Array[String] {
  let paths = array_empty()
  let mut i = 0
  while i < Array::length(specs) {
    let (path, _, _) = Array::get(specs, i)
    if path != "" {
      Array::push(paths, path)
    } else ()
    i = i + 1
  }
  paths
}

fn grouped_source_paths(groups: Array[(String, Array[(String, String)])]) -> Array[String] {
  let paths = array_empty()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, _) = Array::get(sources, si)
      if path != "" {
        Array::push(paths, path)
      } else ()
      si = si + 1
    }
    gi = gi + 1
  }
  paths
}

fn group_cache_row_paths(rows: Array[(String, String, String, String)]) -> Array[String] {
  let paths = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, path, _, _) = Array::get(rows, i)
    if path != "" {
      Array::push(paths, path)
    } else ()
    i = i + 1
  }
  paths
}

fn push_grouped_source(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source: String) -> Unit {
  let group_count = Array::length(groups)
  let handled_by_tail = if group_count > 0 {
    let (last_name, last_sources) = Array::get(groups, group_count - 1)
    if last_name == group_name {
      Array::push(last_sources, (path, source))
      true
    } else {
      false
    }
  } else {
    false
  }
  if !handled_by_tail {
    let mut i = 0
    let mut found_index = -1
    while i < group_count {
      if found_index == -1 {
        let (name, sources) = Array::get(groups, i)
        if name == group_name {
          Array::push(sources, (path, source))
          found_index = i
        }
      }
      i = i + 1
    }
    if found_index == -1 {
      let sources = array_empty()
      Array::push(sources, (path, source))
      Array::push(groups, (group_name, sources))
    }
  }
}

fn push_grouped_source_fingerprint(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source_fingerprint: String) -> Unit {
  let group_count = Array::length(groups)
  let handled_by_tail = if group_count > 0 {
    let (last_name, last_specs) = Array::get(groups, group_count - 1)
    if last_name == group_name {
      Array::push(last_specs, (path, source_fingerprint))
      true
    } else {
      false
    }
  } else {
    false
  }
  if !handled_by_tail {
    let mut i = 0
    let mut found_index = -1
    while i < group_count {
      if found_index == -1 {
        let (name, specs) = Array::get(groups, i)
        if name == group_name {
          Array::push(specs, (path, source_fingerprint))
          found_index = i
        }
      }
      i = i + 1
    }
    if found_index == -1 {
      let specs = array_empty()
      Array::push(specs, (path, source_fingerprint))
      Array::push(groups, (group_name, specs))
    }
  }
}

fn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {
  array_empty()
}

/// #801: the source list/group caches store a RESOLVED graph, and `@scope/name`
/// resolution depends on which packages EXIST under `.vibe/store`, `lib/`, and
/// the external roots at resolve time — not just on the root list (#758's env
/// seed covers the latter only). A graph collected while `.vibe/store/@vibe/core`
/// existed (store install gates/tests create and delete it) can lack the
/// lib/-resolved vibe_core group entirely; every row such a cache DOES list
/// still validates, so row-level checks can never notice the missing package.
/// The visible package set itself must therefore be part of the validity check:
/// writers record its fingerprint (`resctx` row) and validators refuse the
/// cache when the current set differs.
/// NOTE: no Fs::is_dir guards here — the fixed seed compiler predates that
/// builtin (bootstrap bump required first). Scope/package levels are
/// directories by layout convention (resolver assumes the same).
fn push_context_packages_under(sb: StringBuilder, root: String) -> Unit with Exception + Fs {
  if Fs::exists(root) {
    let scopes = Fs::readdir(root)
    let mut i = 0
    while i < Array::length(scopes) {
      let scope = Array::get(scopes, i)
      if String::starts_with(scope, "@") {
        let scope_dir = String::concat(root, String::concat("/", scope))
        let names = Fs::readdir(scope_dir)
        let mut j = 0
        while j < Array::length(names) {
          let name = Array::get(names, j)
          let pkg_dir = String::concat(scope_dir, String::concat("/", name))
          if Fs::exists(String::concat(pkg_dir, "/index.vpkg")) || Fs::exists(String::concat(pkg_dir, "/index.vibei")) {
            StringBuilder::push(sb, root)
            StringBuilder::push(sb, "|")
            StringBuilder::push(sb, scope)
            StringBuilder::push(sb, "/")
            StringBuilder::push(sb, name)
            StringBuilder::push(sb, "\n")
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
}

export fn resolution_context_fingerprint_fs() -> String with Exception + Fs {
  let sb = StringBuilder::new()
  push_context_packages_under(sb, ".vibe/store")
  push_context_packages_under(sb, "lib")
  let roots = external_lib_roots()
  let mut i = 0
  while i < Array::length(roots) {
    push_context_packages_under(sb, Array::get(roots, i))
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(sb))
}

/// Persistent source caches contain a resolved graph, so local package policy is
/// also part of their context. Per-source owner state detects a newly inserted
/// nested boundary; owner contract content detects changed shared imports; and
/// the direct-root listing detects production siblings added after a cache was
/// written. This keeps cache hits observationally equivalent to a cold walk.
fn module_policy_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with Exception + Fs {
  let sb = StringBuilder::new()
  let owners = array_empty()
  let all_paths = array_empty()
  if entry_path != "" {
    Array::push(all_paths, entry_path)
  } else ()
  let mut pi = 0
  while pi < Array::length(paths) {
    let path = Array::get(paths, pi)
    if path != "" && !contains_path(all_paths, path) {
      Array::push(all_paths, path)
    } else ()
    pi = pi + 1
  }
  let mut i = 0
  while i < Array::length(all_paths) {
    let path = Array::get(all_paths, i)
    StringBuilder::push(sb, "source|")
    StringBuilder::push(sb, path)
    if Fs::exists(path) {
      validate_index_layout_fs(path)
      let owner = nearest_vpkg_path_fs(path)
      StringBuilder::push(sb, "|owner|")
      StringBuilder::push(sb, owner)
      if owner != "" && !contains_path(owners, owner) {
        Array::push(owners, owner)
      } else ()
    } else {
      StringBuilder::push(sb, "|missing")
    }
    StringBuilder::push(sb, "\n")
    i = i + 1
  }
  let mut oi = 0
  while oi < Array::length(owners) {
    let owner = Array::get(owners, oi)
    validate_index_layout_fs(owner)
    StringBuilder::push(sb, "contract|")
    StringBuilder::push(sb, owner)
    StringBuilder::push(sb, "|")
    StringBuilder::push(sb, fingerprint_file_fs(owner))
    StringBuilder::push(sb, "\n")
    let roots = contract_sibling_impl_raws(dir_of_path(owner))
    let mut ri = 0
    while ri < Array::length(roots) {
      StringBuilder::push(sb, "root|")
      StringBuilder::push(sb, owner)
      StringBuilder::push(sb, "|")
      StringBuilder::push(sb, Array::get(roots, ri))
      StringBuilder::push(sb, "\n")
      ri = ri + 1
    }
    oi = oi + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(sb))
}

fn persistent_resolution_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with Exception + Fs {
  String::concat(resolution_context_fingerprint_fs(), String::concat(":", module_policy_context_fingerprint_fs(entry_path, paths)))
}

/// Narrow trace-only access to the exact loader resolution-context authority
/// used by persistent source-group validation. The trace caller supplies a
/// post-compile source-group recollection; this performs no reuse and does not
/// claim an atomic snapshot with the production compile.
export fn artifact_input_trace_resolution_context_fingerprint_fs(entry_path: String, groups: Array[(String, Array[(String, String)])]) -> String with Exception + Fs {
  persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(groups))
}

fn resolution_context_is_valid(resctx: Option[String], entry_path: String, paths: Array[String]) -> Bool with Exception + Fs {
  match resctx {
    Some(fp) => fp == persistent_resolution_context_fingerprint_fs(entry_path, paths),
    // No resctx row = written before #801 (or by a foreign writer): the
    // context it resolved under is unknown, so it cannot be trusted.
    None => false
  }
}

fn parse_persistent_source_list_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String)], Option[String]) with Exception {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let mut resctx = None
  let sources = empty_source_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start: i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source list cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else if version_text == "3" {
            version = 3
          } else if version_text == "4" {
            version = 4
          } else {
            throw("invalid persistent source list cache version")
          }
        } else if tag == "resctx" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source list cache resctx row")
          }
          resctx = Some(Array::get(fields, 1))
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache manifest row")
            }
            let path = if version == 4 {
              hex_decode(Array::get(fields, 1))
            } else {
              Array::get(fields, 1)
            }
            manifest = Some((path, Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "source" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache source row")
            }
            let path = if version == 4 {
              hex_decode(Array::get(fields, 1))
            } else {
              Array::get(fields, 1)
            }
            Array::push(sources, (path, Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else {
          throw(String::concat("invalid persistent source list cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, sources, resctx)
}

fn parse_persistent_source_group_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)], Option[String]) with Exception {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let mut resctx = None
  let rows = empty_group_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start: i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source group cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else if version_text == "3" {
            version = 3
          } else if version_text == "4" {
            version = 4
          } else {
            throw("invalid persistent source group cache version")
          }
        } else if tag == "resctx" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source group cache resctx row")
          }
          resctx = Some(Array::get(fields, 1))
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache manifest row")
            }
            let path = if version == 4 {
              hex_decode(Array::get(fields, 1))
            } else {
              Array::get(fields, 1)
            }
            manifest = Some((path, Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "group" {
          if version == 1 {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), "", Array::get(fields, 3)))
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent source group cache group row")
            }
            let group_name = if version == 4 {
              hex_decode(Array::get(fields, 1))
            } else {
              Array::get(fields, 1)
            }
            let path = if version == 4 {
              hex_decode(Array::get(fields, 2))
            } else {
              Array::get(fields, 2)
            }
            Array::push(rows, (group_name, path, Array::get(fields, 3), Array::get(fields, 4)))
          }
        } else {
          throw(String::concat("invalid persistent source group cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows, resctx)
}

fn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with Exception + Fs {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        fingerprint_file_fs(path) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      fingerprint_file_fs(path) == source_fingerprint
    } else {
      false
    }
  }
}

fn load_source_if_cached_file_spec_matches(path: String, stat_token_text: String, source_fingerprint: String) -> Option[String] with Exception + Fs {
  if !(Fs::exists(path)) {
    None
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        Some(Fs::read_file(path))
      } else if String::length(source_fingerprint) > 0 {
        let source = Fs::read_file(path)
        if compact_string_fingerprint(source) == source_fingerprint {
          Some(source)
        } else {
          None
        }
      } else {
        None
      }
    } else if String::length(source_fingerprint) > 0 {
      let source = Fs::read_file(path)
      if compact_string_fingerprint(source) == source_fingerprint {
        Some(source)
      } else {
        None
      }
    } else {
      None
    }
  }
}

// #729/#730: EVERY path that turns an on-disk file into an in-memory source
// must apply the same ingestion transform — require-pin blanking, and for
// index.vibei contracts the conformance-checked facade desugar. The cold
// walk (collect_sources_rec) did; the persistent-cache reconstruction lanes
// below re-read RAW disk bytes, so a warm cache leaked undesugared contracts
// into the merge (masked until now because every compiler-bundle change
// invalidated the caches). Cache validity stays keyed on the RAW file.
// Exported (#741): the wasi_only MERGE lane (merge_sources.vibe) applies the
// same ingestion when collecting its import graph, so contract packages
// (.vibei) resolve in that lane too.
// #740: the facade output is marked so a second ingestion pass (the
// collect_source_groups_fs chokepoint below re-ingests EVERY collected
// source, including ones a cache-reconstruction branch already ingested)
// recognizes an already-desugared contract instead of re-parsing the facade
// as contract grammar (which would fail conformance with empty decls).
// #753: the marker constant moved to contract/index.vibe so the
// persistent-header lane (header_cache.vibe) applies the same check.

fn path_basename(path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    path
  } else {
    path[idx + 1: String::length(path)]
  }
}

fn is_vpkg_companion_basename(name: String) -> Bool {
  String::ends_with(name, "_test.vibe") || String::ends_with(name, "_bench.vibe")
}

fn is_vpkg_explicit_only_basename(name: String) -> Bool {
  String::ends_with(name, ".vibe") && (String::starts_with(name, "_") || String::ends_with(name, ".draft.vibe"))
}

/// This is intentionally the same direct-production filter used by implicit
/// `.vpkg` discovery. Companions are handled separately: they are not package
/// members, but an explicitly-run companion inherits the nearest package scope.
fn is_vpkg_direct_production_basename(name: String) -> Bool {
  name != "index.vibei" && name != "index.vibe" && name != "index.vpkg" && String::ends_with(name, ".vibe") && !is_vpkg_companion_basename(name) && !String::ends_with(name, ".draft.vibe") && !String::starts_with(name, "_")
}

fn validate_index_layout_fs(path: String) -> Unit with Exception + Fs {
  ensure_regular_source_fs(path)
  let dir = dir_of_path(path)
  let present = array_empty()
  if Fs::exists(path_in_dir(dir, "index.vibe")) {
    Array::push(present, "index.vibe")
  } else ()
  if Fs::exists(path_in_dir(dir, "index.vibei")) {
    Array::push(present, "index.vibei")
  } else ()
  if Fs::exists(vpkg_path_in_dir(dir)) {
    Array::push(present, "index.vpkg")
  } else ()
  if Array::length(present) > 1 {
    throw("\{String::join(present, " and ")} exist in \{dir} (#729/#897): a boundary has exactly one index")
  } else ()
}

/// #897: the directory-shared `import @user/mod { x, y }` text to PREPEND to
/// `path`'s own source. Direct production siblings use their directory's vpkg;
/// explicitly-run test/bench companions and explicitly-reached private/draft
/// sources use their nearest enclosing vpkg. These sources remain excluded from
/// implicit build roots; explicit-only sources enter the hash only when reached.
/// "" when `path` doesn't qualify or the vpkg declares no shared imports.
/// Reads `index.vpkg` FRESH from disk on every
/// call rather than caching anything about it here — every caller already
/// keys its OWN cache off a fingerprint of this function's return value baked
/// into the ingested source text (`compact_string_fingerprint`, throughout
/// runtime/index.vibe and header_cache.vibe's `load_or_parse_module_header_fs_impl`),
/// so a live re-read is what makes a change to `index.vpkg`'s shared imports
/// correctly invalidate every sibling's downstream caches — no separate
/// invalidation bookkeeping needed (the #801 stale-cache bug class this
/// avoids: caching a derived value under a key that does not depend on
/// everything the value was derived from).
/// Scoped to `.vpkg` only (#897 issue comments: `.vibei`'s legacy either/or
/// import behavior is deliberately left unchanged by this feature).
/// #1840: materialize a vpkg contract's type-family definitions (struct /
/// enum / type alias) as a real source file under the build cache. The type
/// family needs exactly ONE definition site (a second identity for the same
/// enum traps at runtime, #1879) that BOTH the facade (re-export) and every
/// sibling impl unit (shared-prefix import) can reach through ordinary
/// import machinery — the facade itself cannot be that site for siblings,
/// because facade → impl is already an edge and the reverse import would be
/// a cycle. The path is content-keyed (package identity + text), so a
/// contract edit that changes the type family moves the path and every
/// dependent header invalidates naturally; the write is idempotent.
/// #1840: process-local registry of materialized types modules —
/// (contract path, types-module path, types-module text). Fixed-source-set
/// merge consumers (the s5 selfbuild bundle, any lane that hands
/// collect_merged_stmts a pre-collected list) have no FS walk to pick the
/// materialized file up, so the merge would silently LOSE the contract's
/// type family (the facade only re-exports it now). collect_merged_stmts
/// re-injects from this registry, gated on "this compile's source set
/// contains the originating contract" so a long-lived process (test daemon)
/// never leaks another package's types into an unrelated merge.
let vpkg_types_registry_contracts: Array[String] = [] let vpkg_types_registry_paths: Array[String] = [
] let vpkg_types_registry_texts: Array[String] = [] fn vpkg_types_registry_note(contract_path: String, types_path: String, text: String) -> Unit {
  let mut i = 0
  let mut seen = false
  while i < Array::length(vpkg_types_registry_paths) {
    if Array::get(vpkg_types_registry_paths, i) == types_path {
      seen = true
      i = Array::length(vpkg_types_registry_paths)
    } else {
      i = i + 1
    }
  }
  if seen {
    ()
  } else {
    Array::push(vpkg_types_registry_contracts, contract_path)
    Array::push(vpkg_types_registry_paths, types_path)
    Array::push(vpkg_types_registry_texts, text)
  }
}

/// Returns "" when the contract declares no type-family definitions, or when
/// the package lives outside the repo-relative tree (an absolute VIBE_LIB
/// external root — the relative import spelling below cannot reach _build
/// from there, so those packages keep the verbatim-facade behavior).
fn ensure_vpkg_types_module_fs(vpkg_path: String, extra: Array[Stmt]) -> String with Exception + Fs {
  if String::starts_with(vpkg_path, "/") {
    return ""
  } else {
    ()
  }
  let (_, type_defs) = classify_contract_stmts(extra)
  let tds = contract_type_family_defs(type_defs)
  if Array::length(tds) == 0 {
    ""
  } else {
    // #2125: `uniq` keeps the deferred-names sentinel binding (see
    // contract_types_module_text) collision-free across contracts whose
    // modules meet in one whole-program merge. Fingerprint of the contract
    // path, not a sanitized spelling of it -- character replacement is not
    // injective (`a/b` and `a_b` collapse, Codex on #2162), and two equal
    // binding names would be duplicate declarations in the merge.
    let uniq_fp = compact_string_fingerprint(vpkg_path)
    let uniq_sb = StringBuilder::new()
    let mut uci = 0
    while uci < String::length(uniq_fp) {
      let uc = String::char_code_at(uniq_fp, uci)
      let u_ident = (uc >= '0' && uc <= '9') || (uc >= 'a' && uc <= 'z') || (uc >= 'A' && uc <= 'Z') || uc == '_'
      if u_ident {
        StringBuilder::push(uniq_sb, uniq_fp[uci: uci + 1])
      } else {
        StringBuilder::push(uniq_sb, "_")
      }
      uci = uci + 1
    }
    let text = contract_types_module_text(tds, StringBuilder::freeze(uniq_sb), vpkg_path)
    let raw_key = compact_string_fingerprint(String::concat(vpkg_path, String::concat("|", text)))
    // Identifier-safe basename: the import-path grammar (parser_base.vibe's
    // collect_import_path) lexes path segments as identifier/keyword tokens,
    // so a digit-leading segment lexes as TInt and the fingerprint's ':'
    // separators are not path tokens at all — both fail with "unexpected
    // token in import path". `types_` + [a-z0-9_] keeps the whole basename
    // one TIdent.
    let key_sb = StringBuilder::new()
    let mut kci = 0
    while kci < String::length(raw_key) {
      let kc = String::char_code_at(raw_key, kci)
      let is_ident_char = (kc >= '0' && kc <= '9') || (kc >= 'a' && kc <= 'z') || (kc >= 'A' && kc <= 'Z') || kc == '_'
      if is_ident_char {
        StringBuilder::push(key_sb, raw_key[kci: kci + 1])
      } else {
        StringBuilder::push(key_sb, "_")
      }
      kci = kci + 1
    }
    let types_path = String::concat("_build/vibe_vpkg_types/types_", String::concat(StringBuilder::freeze(key_sb), ".vibe"))
    if Fs::exists(types_path) {
      ()
    } else {
      Fs::write_file(types_path, text)
    }
    vpkg_types_registry_note(vpkg_path, types_path, text)
    types_path
  }
}

/// #1840: the RELATIVE spelling of `canonical` (a repo-root-relative path)
/// as seen from `dir` (also repo-root-relative) — `../` per path segment of
/// `dir`, then the canonical path. Both the facade re-export and the sibling
/// prefix import need this: the import-path grammar accepts a leading `../`
/// chain, while a bare root-relative `_build/...` fails the export
/// statement's head-token check.
fn relative_spelling_from_dir(dir: String, canonical: String) -> String {
  let mut segments = if dir == "" {
    0
  } else {
    1
  }
  let mut si = 0
  while si < String::length(dir) {
    if String::char_code_at(dir, si) == '/' {
      segments = segments + 1
    } else {
      ()
    }
    si = si + 1
  }
  let sb = StringBuilder::new()
  let mut ui = 0
  while ui < segments {
    StringBuilder::push(sb, "../")
    ui = ui + 1
  }
  StringBuilder::push(sb, canonical)
  StringBuilder::freeze(sb)
}

fn vpkg_directory_shared_import_prefix_fs(path: String) -> String with Exception + Fs {
  if is_contract_ext(path) {
    ""
  } else {
    let basename = path_basename(path)
    let vpkg_path = if is_vpkg_companion_basename(basename) || is_vpkg_explicit_only_basename(basename) {
      nearest_vpkg_path_fs(path)
    } else if is_vpkg_direct_production_basename(basename) {
      let direct = vpkg_path_in_dir(dir_of_path(path))
      if Fs::exists(direct) {
        direct
      } else {
        ""
      }
    } else {
      ""
    }
    if vpkg_path == "" {
      ""
    } else {
      ensure_regular_source_fs(vpkg_path)
      // #1100: this runs once per MEMBER file of the directory package, and
      // used to re-lex + re-parse the same index.vpkg contract every time
      // (20 members = 20 contract parses; ~14% of the cold collect walk's
      // parse time). The prefix text is a pure function of the vpkg's
      // content, so memoize it in a persistent text cache keyed by
      // (path, content fingerprint): the first member pays one parse, every
      // other member (and every later cold compile of an unchanged vpkg)
      // reads the one-line cache file instead.
      // #1308: key the cache probe off the memoized file fingerprint and
      // defer the raw read to the miss branch — the hit path (every member
      // after the first) previously re-read + re-hashed the whole contract
      // just to compute the cache key.
      let prefix_cache_path = persistent_vpkg_prefix_cache_path(vpkg_path, fingerprint_file_fs(vpkg_path))
      let cached_prefix = if Fs::exists(prefix_cache_path) {
        normalize_persistent_cache_text(Fs::read_file(prefix_cache_path))
      } else {
        ""
      }
      // #1840: v2 rows carry the materialized types-module path on their
      // second line (empty when the contract has no type-family defs) so a
      // hit can verify the file still exists — the prefix cache and the
      // types module live under different roots when VIBE_BUILD_CACHE_DIR
      // rebases the caches, so one can survive a clean of the other. A
      // missing file falls through to full regeneration (idempotent write).
      let cached_hit = if String::starts_with(cached_prefix, "v3\n") {
        let rest = cached_prefix[3: String::length(cached_prefix)]
        let nl = String::index_of(rest, "\n")
        if nl < 0 {
          ""
        } else {
          let cached_types_path = rest[0: nl]
          // #2324: a stub written before the provenance marker existed is
          // STALE, not merely present. This branch skips regeneration on
          // mere existence, so a workspace warmed by an older compiler
          // would keep serving a marker-less stub and the diagnostic would
          // go on naming the generated file after the upgrade. Reading the
          // text once folds the missing-file case in: absent reads as "",
          // which has no marker, so both fall through to the same
          // idempotent regeneration below.
          let cached_types_text = if cached_types_path != "" && Fs::exists(cached_types_path) {
            Fs::read_file(cached_types_path)
          } else {
            ""
          }
          let cached_types_fresh = if cached_types_path == "" {
            true
          } else {
            vpkg_types_contract_of_source(cached_types_text) != ""
          }
          if cached_types_fresh {
            // Same registry note as the facade-cache hit: a warm prefix
            // used to skip ensure_vpkg_types_module_fs, so collect_merged
            // and the typecheck source set never saw the stub (#1921).
            if cached_types_path == "" {
              ()
            } else {
              vpkg_types_registry_note(vpkg_path, cached_types_path, cached_types_text)
            }
            rest[nl + 1: String::length(rest)]
          } else {
            ""
          }
        }
      } else {
        ""
      }
      if cached_hit != "" || String::starts_with(cached_prefix, "v3\n\n") {
        cached_hit
      } else {
        let vpkg_raw = Fs::read_file(vpkg_path)
        let (_, vpkg_pin_blanked) = extract_require_pins(vpkg_raw)
        let (_, _, vpkg_extra) = parse_contract_program(lex(vpkg_pin_blanked))
        let shared_text = contract_directory_shared_import_prefix_text(vpkg_extra)
        // #1840: siblings import the contract's type family from the
        // materialized types module — this is what gives enum constructors
        // real value bindings inside impl units (the facade cannot be
        // imported from a sibling: facade → impl is already an edge).
        let types_path = ensure_vpkg_types_module_fs(vpkg_path, vpkg_extra)
        let prefix_text = if types_path == "" {
          shared_text
        } else {
          let (_, vpkg_type_defs) = classify_contract_stmts(vpkg_extra)
          let types_rel = relative_spelling_from_dir(dir_of_path(vpkg_path), types_path)
          String::concat(contract_types_module_line("import", types_rel, contract_type_family_defs(vpkg_type_defs)), shared_text)
        }
        Fs::write_file(prefix_cache_path, String::concat("v3\n", String::concat(types_path, String::concat("\n", prefix_text))))
        prefix_text
      }
    }
  }
}

/// #897: applies `vpkg_directory_shared_import_prefix_fs`, guarded by
/// `vpkg_shared_import_marker` so re-ingesting an already-ingested source
/// (routine: `collect_source_groups_fs` re-ingests every source it collects,
/// #740) does not prepend the inherited imports a second time.
fn apply_vpkg_directory_shared_imports_fs(path: String, pin_blanked: String) -> String with Exception + Fs {
  if String::starts_with(pin_blanked, vpkg_shared_import_marker) {
    pin_blanked
  } else {
    let prefix = vpkg_directory_shared_import_prefix_fs(path)
    if prefix == "" {
      pin_blanked
    } else {
      String::concat(vpkg_shared_import_marker, String::concat(prefix, pin_blanked))
    }
  }
}

/// #2284: every on-disk module of the resolved closure passes through
/// `ingest_source_text_fs`, so this is the one place the WHOLE closure can be
/// observed without a second traversal. The ADR-0068 gate used to read the
/// entry file alone, which meant moving `import @vibe/concurrent` into a
/// sibling bypassed it -- and `main.vibe` calling `./worker.vibe` is the
/// normal shape of a project, so the boundary was missing for exactly the
/// structure it most needed to cover.
///
/// Only a cheap substring test happens here; the VERDICT is the token scan's,
/// in `cli_support.vibe`. Over-matching is fine and expected -- roughly ten
/// compiler files merely MENTION the package in a comment -- because a
/// candidate that carries no real `SImport` produces no diagnostic.
///
/// Reset per compilation by the adapter. That matters: the unit-test batch
/// compiles many files in one long-lived daemon, so a record left standing
/// would report a previous file's dependency against the next one.
let unstable_candidate_cell: Array[(String, String)] = array_empty()

export fn unstable_candidates_reset() -> Unit {
  Array::truncate(unstable_candidate_cell, 0)
}

export fn unstable_candidates() -> Array[(String, String)] {
  unstable_candidate_cell
}

fn record_unstable_candidate(path: String, ingested: String) -> Unit {
  if text_mentions_unstable_package(ingested) {
    Array::push(unstable_candidate_cell, (path, ingested))
  } else {
    ()
  }
}

export fn ingest_source_text_fs(path: String, raw: String) -> String with Exception + Fs {
  let (_, pin_blanked) = extract_require_pins(raw)
  let ingested = if is_contract_ext(path) {
    if String::starts_with(pin_blanked, contract_facade_marker) {
      pin_blanked
    } else {
      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))
    }
  } else {
    apply_vpkg_directory_shared_imports_fs(path, pin_blanked)
  }
  record_unstable_candidate(path, ingested)
  ingested
}

/// #740: manifest source loaders (manifest_sources.vibe) read RAW disk bytes;
/// a .vibei contract reaching the grouped merge un-desugared left its imports
/// unresolvable ("undefined variable (local): sha1 @call" — contract/index.vibe's
/// @vibe/core import never rewrote). Ingest every collected source once here,
/// the single point all collection branches (manifest, caches, recursive walk)
/// flow through.
fn grouped_sources_group_for_path(groups: Array[(String, Array[(String, String)])], path: String) -> String {
  let mut found = ""
  let mut gi = 0
  while gi < Array::length(groups) && found == "" {
    let (gname, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) && found == "" {
      let (sp, _) = Array::get(sources, si)
      if sp == path {
        found = gname
      } else {
        si = si + 1
      }
    }
    gi = gi + 1
  }
  found
}

/// #1840/#1921: collect_merged_stmts already re-injects materialized vpkg
/// types modules into a fixed source set. The typecheck walk seeds only
/// what collect_source_groups_fs returns, so a compiler_sources_manifest
/// that lists the contract but not `_build/vibe_vpkg_types/` left the stub
/// in header deps and missing from the coordinator env cache.
/// Attach the stub to the contract's existing group so manifest group order
/// (entry last) stays intact.
fn append_registered_vpkg_types_sources(groups: Array[(String, Array[(String, String)])]) -> Unit {
  let mut ri = 0
  while ri < Array::length(vpkg_types_registry_paths) {
    let r_contract = Array::get(vpkg_types_registry_contracts, ri)
    let r_path = Array::get(vpkg_types_registry_paths, ri)
    let contract_group = grouped_sources_group_for_path(groups, r_contract)
    let types_group = grouped_sources_group_for_path(groups, r_path)
    if contract_group != "" && types_group == "" {
      push_grouped_source(groups, contract_group, r_path, Array::get(vpkg_types_registry_texts, ri))
    } else {
      ()
    }
    ri = ri + 1
  }
}

fn ingest_grouped_sources_fs(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] with Exception + Fs {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (gname, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      let (spath, stext) = Array::get(gsources, si)
      push_grouped_source(out, gname, spath, ingest_source_text_fs(spath, stext))
      si = si + 1
    }
    gi = gi + 1
  }
  append_registered_vpkg_types_sources(out)
  out
}

fn load_cached_sources_rec(specs: Array[(String, String, String)], index: Int, out: Array[(String, String)]) -> Option[Array[(String, String)]] with Exception + Fs {
  if index >= Array::length(specs) {
    Some(out)
  } else {
    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        Array::push(out, (path, ingest_source_text_fs(path, source)))
        load_cached_sources_rec(specs, index + 1, out)
      },
      None => None
    }
  }
}

fn load_cached_grouped_sources_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with Exception + Fs {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        push_grouped_source(out, group_name, path, ingest_source_text_fs(path, source))
        load_cached_grouped_sources_rec(rows, index + 1, out)
      },
      None => None
    }
  }
}

fn load_cached_group_fingerprint_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with Exception + Fs {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
      None
    } else {
      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)
      load_cached_group_fingerprint_rec(rows, index + 1, out)
    }
  }
}

fn manifest_cache_is_valid(manifest: Option[(String, String, String)]) -> Bool with Exception + Fs {
  match manifest {
    Some((path, stat_token_text, source_fingerprint)) =>
    matches_cached_file_spec(path, stat_token_text, source_fingerprint),
    None => true
  }
}

fn load_persistent_sources_cache_if_valid(entry_path: String) -> Option[Array[(String, String)]] with Exception + Fs {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_sources_rec(specs, 0, empty_source_specs())
    }
  }
}

fn load_persistent_source_groups_cache_if_valid(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] with Exception + Fs {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())
    }
  }
}

fn manifest_path_of(manifest: Option[(String, String, String)]) -> Option[String] {
  match manifest {
    Some((path, _, _)) => Some(path),
    None => None
  }
}

fn load_persistent_sources_from_group_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, String)])] with Exception + Fs {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      let specs = empty_source_cache_specs()
      let mut i = 0
      while i < Array::length(rows) {
        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)
        Array::push(specs, (path, stat_token_text, source_fingerprint))
        i = i + 1
      }
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) => Some((manifest_path_of(manifest), sources)),
        None => None
      }
    }
  }
}

fn load_persistent_source_groups_from_source_list_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with Exception + Fs {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) =>
        match try_load_manifest_rows(entry_path) {
          Some((base_dir, rows)) => {
            let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)
            // #801 bug 2: `sources` comes from the source-LIST cache, a
            // SEPARATE persistent cache from the group cache being rebuilt
            // here. Each cache independently passes its own resctx/manifest
            // validity check, but that does not guarantee the two enumerate
            // the SAME file set -- e.g. the list cache may have been seeded
            // via a plain recursive walk (or an older manifest snapshot)
            // that never reached every manifest-listed group.
            // build_grouped_sources_from_manifest_rows silently drops any
            // manifest row with no matching path in `sources`, so a
            // stale/narrower list cache can make an entire group vanish
            // with no signal (observed: lib/@vibe/core's vibe_core /
            // index.vibei group dropped wholesale, 50/51 rows survived).
            // Cross-validate the reconstruction against the manifest's own
            // row count before trusting (and persisting) it: a short count
            // means rows were dropped, so refuse this lane and let the
            // caller fall through to a fresh manifest collection
            // (try_collect_manifest_source_groups_fs) that rebuilds the
            // correct groups directly from disk instead of silently
            // caching/returning the incomplete graph.
            if Array::length(flatten_group_sources(groups)) != Array::length(rows) {
              None
            } else {
              Some((manifest_path_of(manifest), groups))
            }
          },
          None => {
            let groups = empty_grouped_sources()
            Array::push(groups, ("recursive", sources))
            Some((None, groups))
          }
        },
        None => None
      }
    }
  }
}

export fn load_persistent_source_group_fingerprint_if_valid(entry_path: String) -> Option[String] with Exception + Fs {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {
      None
    } else if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {
        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),
        None => None
      }
    }
  }
}

/// #769: O(N) build via StringBuilder. The previous `out = String::concat(out,
/// row)` per row was O(N^2) over the row count -- on the heaviest standalone
/// closures (cache_probe_cli_prepare_batch_bench_test pulls the whole compiler)
/// the bump-allocated concat garbage blew past the 4GB wasm32 address space in
/// ~3s (peak RSS 3.6GB measured) and memory.grow's ignored failure surfaced as
/// a "memory access out of bounds" inside String::concat's memory.copy. Same
/// fix and issue class as stable_cache_path's #366 note (lib/@vibe/cache).
fn build_persistent_sources_cache_text(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> String with Exception + Fs {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "version\t4\n")
  StringBuilder::push(sb, "resctx\t")
  StringBuilder::push(sb, persistent_resolution_context_fingerprint_fs(entry_path, source_paths(sources)))
  StringBuilder::push(sb, "\n")
  match manifest_path {
    Some(path) => {
      StringBuilder::push(sb, "manifest\t")
      StringBuilder::push(sb, hex_encode(path))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, fingerprint_file_fs(path))
      StringBuilder::push(sb, "\n")
    },
    None => ()
  }
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    // #769: skip empty-path rows -- `Fs::stat_token("")` throws in the host
    // (ENOENT stat ''), and a pathless row could never be validated on reload
    // anyway. Empty paths have been observed reaching this writer through the
    // recursive-collection lane (cache_probe_loader_manifest_groups_bench /
    // collect_source_groups_fs on some entries); the row origin is tracked
    // separately, but the writer must never crash the whole compile over it.
    if String::length(path) == 0 {
      ()
    } else {
      StringBuilder::push(sb, "source\t")
      StringBuilder::push(sb, hex_encode(path))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, compact_string_fingerprint(source))
      StringBuilder::push(sb, "\n")
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// #769: O(N) via StringBuilder, same rationale as
/// build_persistent_sources_cache_text above.
fn build_persistent_source_groups_cache_text(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> String with Exception + Fs {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "version\t4\n")
  StringBuilder::push(sb, "resctx\t")
  StringBuilder::push(sb, persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(groups)))
  StringBuilder::push(sb, "\n")
  match manifest_path {
    Some(path) => {
      StringBuilder::push(sb, "manifest\t")
      StringBuilder::push(sb, hex_encode(path))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))
      StringBuilder::push(sb, "\t")
      StringBuilder::push(sb, fingerprint_file_fs(path))
      StringBuilder::push(sb, "\n")
    },
    None => ()
  }
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      // #769: skip empty-path rows (see build_persistent_sources_cache_text).
      if String::length(path) == 0 {
        ()
      } else {
        StringBuilder::push(sb, "group\t")
        StringBuilder::push(sb, hex_encode(group_name))
        StringBuilder::push(sb, "\t")
        StringBuilder::push(sb, hex_encode(path))
        StringBuilder::push(sb, "\t")
        StringBuilder::push(sb, __to_string(Fs::stat_token(path)))
        StringBuilder::push(sb, "\t")
        StringBuilder::push(sb, compact_string_fingerprint(source))
        StringBuilder::push(sb, "\n")
      }
      si = si + 1
    }
    gi = gi + 1
  }
  StringBuilder::freeze(sb)
}

fn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] with Fs {
  let deps = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}

export fn load_or_parse_module_header_fs(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with Exception + Fs {
  load_or_parse_module_header_fs_impl(path, source, parse_count)
}

fn store_persistent_sources_cache(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> Unit with Exception + Fs {
  Fs::write_file(persistent_source_list_cache_path(entry_path), build_persistent_sources_cache_text(entry_path, manifest_path, sources))
}

fn store_persistent_source_groups_cache(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> Unit with Exception + Fs {
  Fs::write_file(persistent_source_group_cache_path(entry_path), build_persistent_source_groups_cache_text(entry_path, manifest_path, groups))
}

fn copy_grouped_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let copied_sources = copy_source_specs(sources)
    Array::push(out, (group_name, copied_sources))
    gi = gi + 1
  }
  out
}

fn flatten_group_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {
  let out = empty_source_specs()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(out, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

fn filter_group_sources(groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {
  let filtered = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let next_sources = empty_source_specs()
    let mut si = 0
    while si < Array::length(sources) {
      let pair = Array::get(sources, si)
      let (path, _) = pair
      match source_lookup(ordered_sources, path) {
        Some(_) => Array::push(next_sources, pair),
        None => ()
      }
      si = si + 1
    }
    if Array::length(next_sources) > 0 {
      Array::push(filtered, (group_name, next_sources))
    }
    gi = gi + 1
  }
  filtered
}

fn special_bundle_source_groups(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] {
  let _ = entry_path
  None
}

fn normalize_bundle_source_groups(groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {
  let normalized = empty_grouped_sources()
  let mut found = false
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let next_sources = empty_source_specs()
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == main_path {
        Array::push(next_sources, (path, main_source))
        found = true
      } else {
        Array::push(next_sources, (path, source))
      }
      si = si + 1
    }
    Array::push(normalized, (group_name, next_sources))
    gi = gi + 1
  }
  if !found {
    let entry_sources = empty_source_specs()
    Array::push(entry_sources, (main_path, main_source))
    Array::push(normalized, ("entry", entry_sources))
  }
  normalized
}

fn special_manifest_sources(entry_path: String) -> Option[(String, Array[(String, String)])] {
  let _ = entry_path
  None
}

fn special_manifest_source_groups(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] {
  let _ = entry_path
  None
}

//# Helper functions

/// Cache lookup helper
fn cache_lookup(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while i < len {
    if done {
      i = len
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        result = Some(e)
        done = true
      }
      i = i + 1
    }
  }
  result
}

fn export_marker_name(name: String) -> String {
  String::concat("__vibe_internal_export__:", name)
}

fn env_has_export_marker(env: TypeEnv, name: String) -> Bool {
  match env_lookup(env, export_marker_name(name)) {
    Some(_) => true,
    None => false
  }
}

fn bind_export_markers(env: TypeEnv, exports: Array[String]) -> TypeEnv {
  let mut acc = env
  let mut i = 0
  while i < Array::length(exports) {
    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)
    i = i + 1
  }
  acc
}

/// Bind imported names from a checked module's env
fn bind_checked_imports(names: Array[ImportItem], i: Int, env: TypeEnv, mod_env: TypeEnv) -> TypeEnv {
  if i >= Array::length(names) {
    env
  } else {
    let item = Array::get(names, i)
    let name = item.name
    let alias = item.alias
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let new_env = if env_has_export_marker(mod_env, name) {
      match env_lookup(mod_env, name) {
        Some(ty) => env_bind(env, bound_name, ty),
        None => env
      }
    } else {
      env
    }
    bind_checked_imports(names, i + 1, new_env, mod_env)
  }
}

//# Module Loader

/// Check a module and return its TypeEnv, resolving imports recursively.
/// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).
export fn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with Exception {
  // Check cache first
  let cached = cache_lookup(checked_cache, path)
  match cached {
    Some(env) => env,
    None => {
      // Cycle detection
      if contains_path(loading, path) {
        throw(String::concat("import cycle detected: ", path))
      }
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let base_dir = dir_of_path(path)
      // Cycle-detection stack: push self before recursing through this
      // module's imports, truncate back when done. O(1) per frame vs.
      // the previous `Array::concat(loading, [path])`, which copied the
      // entire ancestor stack on every recursion and made nested module
      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`
      // (#366 truncate cutover).
      let saved_loading_len = Array::length(loading)
      Array::push(loading, path)
      // Resolve imports using while loop
      let mut import_env = EnvEmpty
      let mut ri = 0
      while ri < Array::length(stmts) {
        let stmt = Array::get(stmts, ri)
        import_env = match stmt {
          SImport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          SReExport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          _ => import_env
        }
        ri = ri + 1
      }
      Array::truncate(loading, saved_loading_len)
      // Type-check with imported env
      let empty_defs = array_empty()
      let check_errors = array_empty()
      // (8th arg: the typed-hover tytab — unused in this lane. The stale
      // 7-arg call only surfaced under the cold-cache whole-graph check,
      // #740 fallout.)
      let check_tytab = array_empty()
      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors, check_tytab)
      // Cache result
      let cached_env = bind_export_markers(env, collect_exports(stmts))
      Array::push(checked_cache, (path, cached_env))
      cached_env
    }
  }
}

//# FS-based source collection

/// `visited` is a `path_set` (#533): this recursion runs once per import
/// EDGE and the visited set grows to every module of the program, so the
/// previous linear `contains_path` scan was O(edges × modules). The set is
/// membership-only — `sources` keeps its own dependency-first order from
/// the recursion, which is what callers consume.
/// #729 (ADR-0063 Phase C-2): ingest an index.vibei contract. The contract is
/// conformance-checked against its declared implementation files and desugared
/// to plain facade source (re-export lines), so everything downstream of the
/// loader — type db, merge plan, codegen — sees ordinary vibe source and needs
/// no .vibei awareness. Implementation files are DECLARED by the contract
/// (`import ./impl.vibe {}`) rather than discovered: the Fs effect has no
/// directory listing yet (auto-discovery arrives with Fs::ReadDir, #730).
fn desugar_contract_source_fs(path: String, source: String) -> String with Exception + Fs {
  let dir = dir_of_path(path)
  validate_index_layout_fs(path)
  let (decls_raw, opaque_names, extra) = parse_contract_program(lex(source))
  // `source` here has already had its leading directive region blanked by
  // extract_require_pins (see ingest_source_text_fs), so the directive must
  // be read back from the ORIGINAL on-disk text via `path`.
  let pkg_version = extract_package_version(Fs::read_file(path))
  // #<version-synthesis>: `version` is already carried by the package's own
  // leading `version x.y.z` directive (ADR-0065/#754) -- a contract no
  // longer needs to also declare `let version: String`, nor does any impl
  // file need to define it. Drop it from `decls` (so `check_contract` stops
  // demanding an implementation for it) and synthesize the binding directly
  // into the facade instead. Only do this when a directive actually exists
  // (Codex review on #1054): a contract with a bare `let version: String`
  // decl and NO `version x.y.z` directive is the pre-existing legacy shape
  // (declared + hand-implemented, no synthesis) -- dropping it there too
  // would strip the declaration out from under a real implementation with
  // nothing to replace it, turning a legitimate impl into an undeclared
  // export. A contract that still spells the old bodyless `let version:
  // String` line alongside a real directive keeps parsing (this filter just
  // makes it a no-op) so existing packages migrate at their own pace.
  let decls = array_empty()
  let mut dvi = 0
  while dvi < Array::length(decls_raw) {
    let (dname, dsig) = Array::get(decls_raw, dvi)
    if dname == "version" && dsig == "val String" && pkg_version != "" {
      ()
    } else {
      Array::push(decls, (dname, dsig))
    }
    dvi = dvi + 1
  }
  let (impl_raws0, type_defs) = classify_contract_stmts(extra)
  // #730: explicit `import ./impl.vibe {}` declarations win; a contract that
  // declares none auto-discovers its sibling *.vibe files (Fs::readdir,
  // byte-sorted by the host so the facade is deterministic).
  // #897/#855 (ADR-0070 Phase 1): .vpkg gets implicit membership
  // unconditionally -- explicit declarations (if any) are MERGED with
  // discovery rather than suppressing it, replacing the empty-import idiom.
  let impl_raws = if String::ends_with(path, ".vpkg") {
    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))
  } else if Array::length(impl_raws0) == 0 {
    contract_sibling_impl_raws(dir)
  } else {
    impl_raws0
  }
  // #1100 (selfcompile-heap): everything below this point — per-member
  // ingest + full parse, conformance check, facade generation — is a pure
  // function of the contract's original on-disk text plus every resolved
  // member's path and content. On the compiler's own tree this member-parse
  // loop was ~24% of the cold collect walk's parse time (and each member's
  // ingest re-enters the vpkg-prefix path on top). Fingerprint the closure
  // first (reads + rolling hashes only, no parsing) and serve the finished
  // facade text from the persistent cache when nothing changed; a hit also
  // implies the cached conformance check passed for these exact inputs.
  let contract_fp = fingerprint_file_fs(path)
  let closure_fp_sb = StringBuilder::new()
  StringBuilder::push(closure_fp_sb, contract_fp)
  let member_paths = array_empty()
  let member_raws = array_empty()
  let mut fpi = 0
  while fpi < Array::length(impl_raws) {
    let fp_raw = Array::get(impl_raws, fpi)
    // #842: probe directory/contract candidates the same way the regular
    // loader does (resolve_path_fs) instead of assuming the plain-file form
    // — a bare `import ../pkg { ... }` inside a .vibei must resolve to
    // `../pkg/index.vibei` (or `/index.vibe`) when `../pkg.vibe` does not
    // exist, exactly like the same import spelled inside a .vibe impl file.
    let fp_resolved = resolve_path_fs(dir, fp_raw)
    ensure_regular_source_fs(fp_resolved)
    // #1308: fingerprint via the stat-token memo and don't read the member
    // body here — on a facade-cache hit (the common case) every member's
    // content was read only to be thrown away with the hit's early return.
    StringBuilder::push(closure_fp_sb, "|")
    StringBuilder::push(closure_fp_sb, fp_resolved)
    StringBuilder::push(closure_fp_sb, ":")
    StringBuilder::push(closure_fp_sb, fingerprint_file_fs(fp_resolved))
    Array::push(member_paths, fp_resolved)
    Array::push(member_raws, fp_raw)
    fpi = fpi + 1
  }
  let closure_fp = compact_string_fingerprint(StringBuilder::freeze(closure_fp_sb))
  let facade_cache_path = persistent_contract_facade_cache_path(path, closure_fp)
  let cached_facade = if Fs::exists(facade_cache_path) {
    normalize_persistent_cache_text(Fs::read_file(facade_cache_path))
  } else {
    ""
  }
  // #1840: v2 rows carry the materialized types-module path on their second
  // line (empty when the contract has no type-family defs) so a hit can
  // verify the file still exists (see the prefix cache's twin comment). A
  // missing file falls through to full regeneration, which re-materializes
  // it idempotently.
  if String::starts_with(cached_facade, "v3\n") {
    let fc_rest = cached_facade[3: String::length(cached_facade)]
    let fc_nl = String::index_of(fc_rest, "\n")
    if fc_nl >= 0 {
      let fc_types_path = fc_rest[0: fc_nl]
      // #2324: stale-not-merely-absent, exactly as in the prefix cache above.
      let fc_types_text = if fc_types_path != "" && Fs::exists(fc_types_path) {
        Fs::read_file(fc_types_path)
      } else {
        ""
      }
      let fc_types_fresh = if fc_types_path == "" {
        true
      } else {
        vpkg_types_contract_of_source(fc_types_text) != ""
      }
      if fc_types_fresh {
        // #1840: the registry note must happen on the HIT path too —
        // collect_merged_stmts' fixed-source-set re-injection reads the
        // process-local registry, and a warm facade cache would otherwise
        // skip ensure_vpkg_types_module_fs entirely (found the hard way:
        // the s5 bundle merge lost the AST enums, `PInt ... reached code
        // generation unresolved`).
        if fc_types_path == "" {
          ()
        } else {
          vpkg_types_registry_note(path, fc_types_path, fc_types_text)
        }
        return fc_rest[fc_nl + 1: String::length(fc_rest)]
      } else {
        ()
      }
    } else {
      ()
    }
  } else {
    ()
  }
  // #1308/Codex P2: the probe key above pairs member FINGERPRINTS taken
  // before this point with member BODIES read below — a member rewritten in
  // between would get its new body persisted under the old closure key, and
  // a later revert of the file would then serve that mismatched facade with
  // conformance skipped. Rebuild the closure fingerprint from the bodies
  // actually read (same row format as the probe key) and publish the cache
  // entry under THAT key: in the no-race case the two keys are equal, and
  // under a mid-compile rewrite the entry lands under a key no stale probe
  // can hit. Costs one extra rolling hash per member on cache MISSES only.
  let fresh_fp_sb = StringBuilder::new()
  StringBuilder::push(fresh_fp_sb, contract_fp)
  let impl_units = array_empty()
  let union_stmts = array_empty()
  let mut ri = 0
  while ri < Array::length(member_raws) {
    let raw = Array::get(member_raws, ri)
    let resolved = Array::get(member_paths, ri)
    let resolved_content = Fs::read_file(resolved)
    StringBuilder::push(fresh_fp_sb, "|")
    StringBuilder::push(fresh_fp_sb, resolved)
    StringBuilder::push(fresh_fp_sb, ":")
    StringBuilder::push(fresh_fp_sb, compact_string_fingerprint(resolved_content))
    // #842: an impl raw may itself resolve to ANOTHER package's contract
    // (a cross-package `import ../pkg { ... }`, not just this package's own
    // sibling impl files) — route it through the same ingestion transform
    // every other on-disk source goes through (ingest_source_text_fs), so a
    // `.vibei` target is recursively desugared to its facade text instead of
    // being handed to parse_program as raw (bodyless) contract grammar.
    let impl_ingested = ingest_source_text_fs(resolved, resolved_content)
    let impl_stmts = parse_program(lex(impl_ingested))
    Array::push(impl_units, (raw, impl_stmts))
    // #847: a raw resolving to ANOTHER package's own index.vibei/index.vibe
    // (a cross-package or nested-boundary reference, e.g. `import ../pkgb
    // { X }` written purely so the contract's own bodyless signatures
    // can NAME `X`) is that OTHER package's already-conformance-checked
    // facade, not this package's own implementation surface. Its stmts are
    // excluded from `union_stmts` (this package's own conformance input) —
    // otherwise pkgb's synthetic `export ./impl.vibe { X, make, value }`
    // facade line reads as pkga re-exporting undeclared symbols, a false
    // positive `check_contract`'s SReExport check would otherwise raise.
    // `impl_units` (facade generation) is unaffected: a boundary unit's defs
    // are already invisible to `collect_impl_fn_defs`/`collect_impl_type_defs`
    // (a facade is SReExport-only, no SLet/SStruct), so it never allocates a
    // re-export line under this package's own name anyway.
    let is_boundary_unit = String::ends_with(resolved, "/index.vibei") || String::ends_with(resolved, "/index.vpkg") || String::ends_with(resolved, "/index.vibe")
    if is_boundary_unit {
      ()
    } else {
      let mut si = 0
      while si < Array::length(impl_stmts) {
        Array::push(union_stmts, Array::get(impl_stmts, si))
        si = si + 1
      }
    }
    ri = ri + 1
  }
  let errors = check_contract(decls, opaque_names, union_stmts, type_defs)
  if Array::length(errors) > 0 {
    throw("\{path}: contract violation: \{String::join(errors, "; ")}")
  } else ()
  // #1840: materialize the type family once and hand the facade its path —
  // the facade re-exports it, siblings import it (shared prefix). The facade
  // text needs the package-dir-RELATIVE spelling (the export grammar rejects
  // a bare root-relative head token); the cache row below keeps the
  // canonical root-relative path for its existence re-check.
  let facade_types_path = ensure_vpkg_types_module_fs(path, extra)
  let facade_types_rel = if facade_types_path == "" {
    ""
  } else {
    relative_spelling_from_dir(dir_of_path(path), facade_types_path)
  }
  let facade = contract_facade_source(decls, opaque_names, type_defs, impl_units, facade_types_rel)
  let facade_final = if pkg_version == "" {
    facade
  } else {
    String::concat(facade, "\nexport let version: String = \"\{pkg_version}\"\n")
  }
  // #1100: publish the finished facade under the closure fingerprint
  // computed above — the next desugar of this unchanged package (same run
  // or a later cold compile) skips the whole member-parse + conformance
  // pass. Only a PASSING conformance result ever reaches this line (the
  // throw above aborts first), so a hit can never mask a violation.
  // #1308/Codex P2: publish under the fingerprint of the bodies actually
  // used (equal to the probed closure_fp unless a member changed between
  // the fingerprint pass and the reads above — see the comment at
  // fresh_fp_sb's construction).
  let fresh_closure_fp = compact_string_fingerprint(StringBuilder::freeze(fresh_fp_sb))
  Fs::write_file(persistent_contract_facade_cache_path(path, fresh_closure_fp), String::concat("v3\n", String::concat(facade_types_path, String::concat("\n", facade_final))))
  facade_final
}

/// #730 (D-2): both content-addressing hashes of a contract package, from its
/// ORIGINAL on-disk texts (require lines included — they are part of the
/// hashed content, which is what makes a direct pin fix the transitive
/// closure). Paths in the package hash are package-relative ("index.vibei" +
/// each impl's raw import spelling), so the hash is location-independent —
/// the same function serves `vibe hash` on a working directory and store
/// verification of an installed copy.
export fn contract_package_hashes_fs(path: String) -> (String, String) with Exception + Fs {
  validate_index_layout_fs(path)
  let raw = Fs::read_file(path)
  let (_, blanked) = extract_require_pins(raw)
  let (decls, opaques, extra) = parse_contract_program(lex(blanked))
  let (impl_raws0, type_defs) = classify_contract_stmts(extra)
  let package_contract = normalize_path(path)
  let dir = dir_of_path(package_contract)
  // #730: mirror the ingestion's auto-discovery — the package hash must cover
  // the same impl files the facade is built from. Discovered raws are
  // "./<name>" and byte-sorted, so the hash stays location-independent and
  // deterministic.
  // #897/#855: mirror desugar_contract_source_fs's .vpkg implicit-membership
  // merge exactly, so the hash always covers the same impl set the facade
  // was built from (a mismatch here would make the content-addressed hash
  // silently stale relative to what actually got conformance-checked).
  let impl_raws = if String::ends_with(path, ".vpkg") {
    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))
  } else if Array::length(impl_raws0) == 0 {
    contract_sibling_impl_raws(dir)
  } else {
    impl_raws0
  }
  let sources = array_empty()
  // #897 (ADR-0070 Phase 1): the package-hash key names the contract file by
  // its OWN on-disk suffix rather than assuming "index.vibei" — `path` is
  // already the resolved contract file (whichever of .vibei/.vpkg won), so
  // its basename is read off directly instead of re-probing the filesystem.
  // A directory that migrates from index.vibei to index.vpkg intentionally
  // gets a different hash (the rename is a real content/identity change).
  let contract_last_slash = String::last_index_of(path, "/")
  let contract_basename = if contract_last_slash < 0 {
    path
  } else {
    path[contract_last_slash + 1: String::length(path)]
  }
  // #1145 follow-up 3: `generated_hash` stores this package's own content
  // hash -- feed it back into what gets hashed and the hash would depend on
  // hash-writing history instead of on the file, so it's always blanked to
  // empty here (a no-op for the common case where it's already empty; see
  // canonicalize_for_hash's own comment).
  Array::push(sources, (contract_basename, canonicalize_for_hash(raw)))
  let mut ri = 0
  if String::ends_with(package_contract, ".vpkg") {
    let visited = path_set_new()
    while ri < Array::length(impl_raws) {
      let resolved = resolve_path_fs(dir, Array::get(impl_raws, ri))
      collect_package_hash_source_closure_fs(package_contract, dir, resolved, sources, visited)
      ri = ri + 1
    }
  } else {
    // Legacy .vibei hashing preserves its declared/direct implementation set.
    while ri < Array::length(impl_raws) {
      let iraw = Array::get(impl_raws, ri)
      let resolved = resolve_path_fs(dir, iraw)
      ensure_regular_source_fs(resolved)
      let itext = Fs::read_file(resolved)
      Array::push(sources, (iraw, itext))
      ri = ri + 1
    }
  }
  (package_hash_from_sources(sources), contract_hash(decls, opaques, type_defs))
}

/// #1145 follow-up 3: computes this package's content hash the same way
/// `vibe hash` does (contract_package_hashes_fs blanks the file's own
/// `generated_hash` before hashing, so a stale value here never leaks into
/// its own hash -- see that function's comment) and returns the file's full
/// text with `generated_hash = ` rewritten to the computed pin. Read-only
/// like every other fs-mode adapter entry point: the caller writes the
/// result back wherever it wants (same convention as VIBE_FILL_PINS).
/// Idempotent: re-running against the written-back file recomputes and
/// returns the identical hash.
export fn write_generated_hash_fs(path: String) -> String with Exception + Fs {
  let (pkg_hash, _ct_hash) = contract_package_hashes_fs(path)
  replace_generated_hash_directive(Fs::read_file(path), "#\{pkg_hash}")
}

/// #730 (D-3): fill missing require pins OFFLINE from the workspace store.
/// `require @x/y 1.2.3` becomes `require @x/y 1.2.3 = #pkg:sha1:<hex>` when
/// .vibe/store/@x/y/ is installed; a package absent from the store is an
/// error (network fetch belongs to `vibe add`/`update`, never to fmt).
/// Pinned lines pass through untouched, so the rewrite is idempotent.
export fn fill_require_pins_fs(source: String) -> String with Exception + Fs {
  fill_require_pins_fs_mode(source, false)
}

/// repin=true rewrites EVERY require line to the store's current hash —
/// `vibe dedupe --apply` (#730 D-4): after updating a store package, one
/// pass re-points all pins in a file at the installed copies. With the
/// by-name store there is one installed version per package, so repinning
/// IS conflict resolution.
export fn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with Exception + Fs {
  fill_require_pins_impl(source, repin, false)
}

/// The `vibe fmt` lane's fill (#730 D-3): the same offline store lookup as
/// fill_require_pins_fs, but TOTAL. fmt must format the body whatever the
/// state of the store, so a package absent from the store leaves its
/// require line verbatim instead of failing the run, and any error along
/// the way (a malformed require line the head classifier will refuse
/// anyway, a store copy the hasher rejects) returns the source unchanged.
/// Not filling is not wrong -- the build still refuses to resolve an
/// unpinned require -- whereas aborting the format over it would be; the
/// strict lane (VIBE_FILL_PINS, above) keeps the loud answer for callers
/// who asked for pins specifically.
export fn fill_require_pins_lenient(source: String) -> String with Fs {
  handle {
    fill_require_pins_impl(source, false, true)
  } with { Exception::Throw(_) => source }
}

/// digits_to_int (behind semver_parts) folds digit runs with the wrapping
/// 63-bit arithmetic every Int operation has (#1877), so a long-enough
/// component wraps -- `^0.1.4611686018427387904` gets a NEGATIVE patch
/// bound and an installed 0.1.0 "satisfies" it (#2260 round 6, measured).
/// 18 decimal digits max out below 2^62-1, so components up to that length
/// convert exactly; anything longer is unverifiable and never fills.
fn semver_components_convert_exactly(v: String) -> Bool {
  let start = if String::starts_with(v, "^") {
    1
  } else {
    0
  }
  let parts = String::split(String::substring(v, start, String::length(v)), ".")
  if Array::length(parts) != 3 {
    false
  } else {
    String::length(Array::get(parts, 0)) <= 18 && String::length(Array::get(parts, 1)) <= 18 && String::length(Array::get(parts, 2)) <= 18
  }
}

/// Does the store copy's declared version satisfy a require constraint?
/// The grammar (ADR-0063 §6) has exactly two operators: none (exact match)
/// and `^` (compatible range, npm caret semantics: the leftmost non-zero
/// digit is the compatibility line -- same major and >= the triple; for
/// major 0 same minor and >= patch; for 0.0.z the patch itself, so only
/// the exact triple satisfies, #2260 round 5). An empty or non-triple
/// declared version satisfies nothing -- unverifiable never fills.
fn require_constraint_satisfied(constraint: String, version: String) -> Bool {
  if !semver_components_convert_exactly(constraint) || !semver_components_convert_exactly(version) {
    return false
  }
  match semver_parts(version) {
    None => false,
    Some(vparts) => {
      let (vmaj, vmin, vpat) = vparts
      if String::starts_with(constraint, "^") {
        match semver_parts(String::substring(constraint, 1, String::length(constraint))) {
          None => false,
          Some(cparts) => {
            let (cmaj, cmin, cpat) = cparts
            if vmaj != cmaj {
              false
            } else if cmaj == 0 && cmin == 0 {
              vmin == 0 && vpat == cpat
            } else if cmaj == 0 {
              vmin == cmin && vpat >= cpat
            } else if vmin != cmin {
              vmin > cmin
            } else {
              vpat >= cpat
            }
          }
        }
      } else {
        constraint == version
      }
    }
  }
}

// Which lines are require directives is decided by the loader's own header
// scanner, not by a second region scan here (#2260 Codex round 3): the
// scanner blanks every recognized directive line to spaces with byte length
// preserved, so a line that starts with `require ` in the source and is
// all-blank in the blanked output IS a recognized require directive --
// including one sitting after `name =`/`version =`/`deps = { .. }` in an
// `index.vpkg` header, which a "stop at the first non-require line" scan
// (this function's previous shape) never reached. A `require`-looking line
// the scanner did NOT blank (i.e. body text) is left alone.
fn fill_require_pins_impl(source: String, repin: Bool, lenient: Bool) -> String with Exception + Fs {
  let (_, blanked) = extract_require_pins(source)
  let sb = StringBuilder::new()
  let len = String::length(source)
  let mut pos = 0
  while pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, nl) != 10 {
      nl = nl + 1
    }
    let line = String::substring(source, pos, nl)
    let trimmed = String::trim(line)
    let mut emitted = false
    if String::starts_with(trimmed, "require ") && String::length(String::trim(String::substring(blanked, pos, nl))) == 0 {
      let (pins_one, _) = extract_require_pins(String::concat(trimmed, "\n"))
      if Array::length(pins_one) == 1 {
        let (pname, pver, ppin) = Array::get(pins_one, 0)
        if ppin == "" || repin {
          // #897: try the target spelling (.vpkg) first, then legacy
          // .vibei, mirroring resolve_import_path_candidates' root ordering.
          let store_index_vpkg = String::concat(".vibe/store/", String::concat(pname, "/index.vpkg"))
          let store_index_vibei = String::concat(".vibe/store/", String::concat(pname, "/index.vibei"))
          let store_index = if Fs::exists(store_index_vpkg) {
            store_index_vpkg
          } else {
            store_index_vibei
          }
          if Fs::exists(store_index) {
            // #2260 Codex round 4: the pin is the truth the build verifies,
            // so writing the installed copy's hash beside a version it does
            // not satisfy would make the build accept and run a release the
            // source never asked for -- silently. Fill only when the store
            // copy DECLARES a version and it satisfies the constraint; a
            // versionless or mismatched copy leaves the line for `vibe
            // add`/`update` (lenient) or reports both versions (strict).
            let store_version = extract_package_version(Fs::read_file(store_index))
            if require_constraint_satisfied(pver, store_version) {
              let (pkg_hash, _) = contract_package_hashes_fs(store_index)
              StringBuilder::push(sb, "require \{pname} \{pver} = #\{pkg_hash}")
              emitted = true
            } else if lenient {
              ()
            } else {
              throw("cannot pin \{pname}: the store copy declares version '\{store_version}' which does not satisfy the required \{pver} (install the matching release with `vibe add`/`update`, or fix the require line)")
            }
          } else if lenient {
            // fmt lane: leave the unpinned line for the build to reject;
            // fetching belongs to `vibe add`/`update`, never to fmt.
            ()
          } else {
            throw("cannot pin \{pname} offline: not installed in the store (.vibe/store/\{pname}/)")
          }
        } else ()
      } else ()
    } else ()
    if emitted {
      ()
    } else {
      StringBuilder::push(sb, line)
    }
    if nl < len {
      StringBuilder::push(sb, "\n")
    } else ()
    pos = nl + 1
  }
  StringBuilder::freeze(sb)
}

/// #732 (Phase F): publish gate. Parse the previous and next contract
/// surfaces and verify the claimed version bump is exactly what the diff
/// requires (Elm-style machine-checked semver). Returns error strings;
/// empty = the release claim is honest.
export fn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with Exception + Fs {
  let prev_raw = Fs::read_file(prev_contract_path)
  let (_, prev_blanked) = extract_require_pins(prev_raw)
  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))
  let (_, ptypes) = classify_contract_stmts(pextra)
  let next_raw = Fs::read_file(next_contract_path)
  let (_, next_blanked) = extract_require_pins(next_raw)
  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))
  let (_, ntypes) = classify_contract_stmts(nextra)
  // #754: versions come from the PACKAGE-side `version x.y.z` directive when
  // the caller does not pass them; a caller-passed version that contradicts
  // the directive is its own error (a publish must not claim a version the
  // package does not declare).
  let prev_directive = extract_package_version(prev_raw)
  let next_directive = extract_package_version(next_raw)
  let errors = array_empty()
  if prev_version != "" && prev_directive != "" && prev_version != prev_directive {
    Array::push(errors, "previous version \{prev_version} contradicts the contract's version directive \{prev_directive}")
  } else ()
  if next_version != "" && next_directive != "" && next_version != next_directive {
    Array::push(errors, "claimed version \{next_version} contradicts the contract's version directive \{next_directive}")
  } else ()
  let pv = if prev_version != "" {
    prev_version
  } else {
    prev_directive
  }
  let nv = if next_version != "" {
    next_version
  } else {
    next_directive
  }
  if pv == "" || nv == "" {
    Array::push(errors, "publish versions unavailable: pass them explicitly or add a `version x.y.z` directive to the contract (#754)")
    errors
  } else if Array::length(errors) > 0 {
    errors
  } else {
    verify_publish_bump(pv, nv, contract_surface_lines(pd, po, ptypes), contract_surface_lines(nd, no, ntypes))
  }
}

/// #730 (D-2): verify a store-resolved package against the importer's require
/// pin. The store is laid out BY NAME (.vibe/store/@scope/name/) and trusted
/// only through this hash check, so any mirror/copy mechanism is fine.
fn verify_store_package_fs(importer: String, pins: Array[(String, String, String)], store_index_path: String) -> Unit with Exception + Fs {
  let prefix = ".vibe/store/"
  // #897: `store_index_path` is already the RESOLVED dep (the caller reads
  // it off the collected import graph), so its own suffix tells us which
  // spelling won without re-probing the filesystem.
  let suffix = if String::ends_with(store_index_path, "/index.vpkg") {
    "/index.vpkg"
  } else {
    "/index.vibei"
  }
  let name = String::substring(store_index_path, String::length(prefix), String::length(store_index_path) - String::length(suffix))
  let mut pin_hash = ""
  let mut pin_found = false
  let mut pi = 0
  while pi < Array::length(pins) {
    let (pname, _, phash) = Array::get(pins, pi)
    if pname == name {
      pin_hash = phash
      pin_found = true
    } else ()
    pi = pi + 1
  }
  if pin_found {
    ()
  } else {
    throw("no require pin for \{name} in \{importer} (add: require \{name} <x.y.z> = #<pkg-hash>; compute with `vibe hash`)")
  }
  if pin_hash == "" {
    throw("unpinned require for \{name} in \{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store")
  } else ()
  if Fs::exists(store_index_path) {
    ()
  } else {
    throw("package \{name} is not installed in the store (.vibe/store/\{name}/)")
  }
  let (actual, _) = contract_package_hashes_fs(store_index_path)
  if actual == pin_hash {
    ()
  } else {
    throw("pin mismatch for \{name}: \{importer} requires #\{pin_hash} but the store copy is #\{actual}")
  }
}

/// #751 (ADR-0065): a `lib/`-resolved package is the dev-mode lane — no
/// require pin is demanded (that stays a store/release rule). But a pin is
/// the truth WHEREVER resolution lands: when the importer does pin the name,
/// the lib/ (or VIBE_LIB external root) copy must match it, or a stale
/// checkout silently diverges from what the pin promises. Under
/// VIBE_REQUIRE_PINS=1 (the release/publish freeze switch; `vibe run
/// --freeze` maps to it) the pin stops being optional: dev-mode name
/// resolution without a pin is an error.
fn verify_lib_package_fs(importer: String, pins: Array[(String, String, String)], lib_index_path: String) -> Unit with Exception + Fs {
  // The package name starts at the "@" — works for both the workspace
  // spelling ("lib/@scope/name/index.vibei") and an absolute VIBE_LIB root
  // ("/home/u/.vibe/lib/@scope/name/index.vibei"), and (#897) either's
  // `.vpkg`-suffixed alternate spelling. `lib_index_path` is already the
  // RESOLVED dep, so its own suffix tells us which spelling won.
  let suffix = if String::ends_with(lib_index_path, "/index.vpkg") {
    "/index.vpkg"
  } else {
    "/index.vibei"
  }
  let at = String::last_index_of(lib_index_path, "@")
  let name = String::substring(lib_index_path, at, String::length(lib_index_path) - String::length(suffix))
  let mut pin_hash = ""
  let mut pi = 0
  while pi < Array::length(pins) {
    let (pname, _, phash) = Array::get(pins, pi)
    if pname == name {
      pin_hash = phash
    } else ()
    pi = pi + 1
  }
  if pin_hash == "" {
    if vibe_env_flag("VIBE_REQUIRE_PINS") {
      throw("pin required for \{name} (VIBE_REQUIRE_PINS=1): \{importer} resolves it via the dev-mode lib lane; add `require \{name} <version> = #pkg:sha1:<hash>` (ADR-0065)")
    } else if !(Fs::exists(lib_index_path)) {
      // #831: an unpinned lib/VIBE_LIB package reference with no installed
      // copy used to fall through here silently and only fail later, deep
      // inside the raw `Fs::read_file` primitive in `collect_sources_rec`
      // (an uncaught host-level crash, not a diagnostic). Catch it here,
      // at resolution time, with the same guidance shape as the pin-mismatch
      // and store-install errors below/above.
      throw("cannot resolve import \{name}: not found via lib/ or VIBE_LIB (looked for \{lib_index_path})")
    } else ()
  } else {
    let (actual, _) = contract_package_hashes_fs(lib_index_path)
    if actual == pin_hash {
      ()
    } else {
      throw("pin mismatch for \{name}: \{importer} requires #\{pin_hash} but the lib/ copy is #\{actual}")
    }
  }
}

/// Package-owner boundary enforcement. `index.vpkg` is the sole boundary
/// marker, and the nearest enclosing one owns a source. A contract itself is a
/// public facade. Sources without an owner form a public compatibility space.
/// Every owned implementation target requires the importer to have that same
/// nearest owner, so nested -> parent and parent -> nested internal imports are
/// both rejected.
fn enforce_incoming_boundary_fs(importer: String, target: String) -> Unit with Exception + Fs {
  if is_vpkg_companion_basename(path_basename(target)) {
    throw("cannot import test/bench companion as a module target: \{target}")
  } else ()
  let target_owner = nearest_vpkg_path_fs(target)
  if target_owner == "" {
    ()
  } else if target == target_owner {
    ()
  } else {
    let importer_owner = nearest_vpkg_path_fs(importer)
    if importer_owner == target_owner {
      ()
    } else {
      throw("cannot import \{target} across a package boundary; target owner is \{target_owner} (#729); import the owner contract instead")
    }
  }
}

fn package_relative_hash_key(package_dir: String, source_path: String) -> String with Exception {
  let prefix = if package_dir == "" {
    ""
  } else if package_dir == "/" {
    "/"
  } else {
    String::concat(package_dir, "/")
  }
  let relative = if prefix == "" {
    source_path
  } else if String::starts_with(source_path, prefix) {
    source_path[String::length(prefix): String::length(source_path)]
  } else {
    throw("package hash source \{source_path} is outside package directory \{package_dir}")
  }
  String::concat("./", relative)
}

/// Collect the same-owner dependency closure rooted at direct production
/// siblings. Explicit-only `_*.vibe` / `*.draft.vibe` sources are absent from
/// discovery, but enter this closure when a production source imports them.
/// Cross-package contracts remain represented by the importing source's text
/// and require pin; their implementation bytes belong to their own hash.
fn collect_package_hash_source_closure_fs(package_contract: String, package_dir: String, source_path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with Exception + Fs {
  if path_set_contains(visited, source_path) {
    ()
  } else {
    path_set_add(visited, source_path)
    validate_index_layout_fs(source_path)
    let source = Fs::read_file(source_path)
    Array::push(sources, (package_relative_hash_key(package_dir, source_path), source))
    let (deps, _, _) = load_or_parse_module_header_fs(source_path, source, 0)
    let mut i = 0
    while i < Array::length(deps) {
      let dep = Array::get(deps, i)
      enforce_incoming_boundary_fs(source_path, dep)
      let dep_owner = nearest_vpkg_path_fs(dep)
      if dep_owner == package_contract && dep != package_contract {
        collect_package_hash_source_closure_fs(package_contract, package_dir, dep, sources, visited)
      } else {
        ()
      }
      i = i + 1
    }
  }
}

fn collect_sources_rec(path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with Exception + Fs {
  if path_set_contains(visited, path) {
    ()
  }
  else {
    path_set_add(visited, path)
    // #831: safety net. `path` normally already passed the located,
    // raw-import-spelling-aware existence check in
    // header_cache.vibe's `resolve_checked_path_fs` before it ever became a
    // dep here -- but this recursion is also entered directly for the
    // top-level entry path (no importer, no located import site) and can
    // replay a WARM persistent header cache written before that check
    // existed (stale fallback dep). `Fs::read_file` is a raw host
    // primitive: a missing file there is a JS-level throw from the host
    // runner, not a guest `Error` effect, so it crosses the wasm/JS
    // boundary uncaught and prints a low-level crash dump instead of a
    // diagnostic. Guard it here too so no path through this recursion can
    // still reach that raw primitive with a nonexistent file.
    if !(Fs::exists(path)) {
      throw("cannot resolve module: \{path} does not exist")
    } else ()
    validate_index_layout_fs(path)
    let raw_source = Fs::read_file(path)
    // #730 (D-2): require pin lines are a leading directive, extracted and
    // blanked (offset-preserving) before anything parses the source.
    let (pins, pin_blanked) = extract_require_pins(raw_source)
    // #749: the facade MUST carry contract_facade_marker — every collected
    // source is re-ingested at the collect_source_groups_fs chokepoint, and
    // an unmarked facade re-enters desugar_contract_source_fs as if it were
    // raw contract grammar (classify_contract_stmts rejects its re-export
    // lines). This walk used to emit the bare facade; only the cold first
    // pass reaches it, so the failure hid behind the runner's module-init
    // re-run (#749).
    let source = if is_contract_ext(path) {
      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))
    } else {
      // #897: directory-shared vpkg imports (see
      // `apply_vpkg_directory_shared_imports_fs` above) apply here too --
      // this cold walk builds `source` independently of `ingest_source_text_fs`
      // (it needs `pins` separately, for pin verification below), so it must
      // repeat the same ingestion step rather than silently skip it.
      apply_vpkg_directory_shared_imports_fs(path, pin_blanked)
    }
    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)
    // First, recurse into dependencies (imports and re-exports)
    let mut i = 0
    while i < Array::length(deps) {
      let dep = Array::get(deps, i)
      enforce_incoming_boundary_fs(path, dep)
      // Only a store PACKAGE reference (its contract) is pin-verified;
      // paths inside an already-verified store package (its impl files)
      // are covered by that package's hash.
      if String::starts_with(dep, ".vibe/store/") && is_contract_ext(dep) {
        verify_store_package_fs(path, pins, dep)
      } else if is_contract_ext(dep) && String::last_index_of(dep, "@") >= 0 {
        // #751: dev-mode lane (workspace lib/ OR a VIBE_LIB external root —
        // any @-named package contract that is not the store) — pin
        // optional but verified when present; VIBE_REQUIRE_PINS=1 demands it.
        verify_lib_package_fs(path, pins, dep)
      } else ()
      collect_sources_rec(dep, sources, visited)
      i = i + 1
    }
    // Then add this module (dependencies come first)
    Array::push(sources, (path, source))
  }
}

/// Recursively collect all source files from filesystem, following imports and re-exports.
/// Returns Array[(path, source)] in dependency order (dependencies first).
export fn collect_all_sources_fs(entry_path: String) -> Array[(String, String)] with Exception + Fs {
  match special_manifest_sources(entry_path) {
    Some((manifest_path, sources)) => {
      let _ = manifest_path
      copy_source_specs(sources)
    },
    None => {
      ingestion_pipeline_telemetry_add(0, 1)
      match load_persistent_sources_cache_if_valid(entry_path) {
        Some(sources) => {
          ingestion_pipeline_telemetry_add(1, 1)
          sources
        },
        None => {
          ingestion_pipeline_telemetry_add(2, 1)
          // Every source-list miss enters exactly one cold collection attempt,
          // whether a fresh manifest wins or recursion is ultimately required.
          ingestion_pipeline_telemetry_add(9, 1)
          match try_collect_manifest_sources_fs(entry_path) {
            Some((manifest_path, sources)) => {
              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)
              sources
            },
            None => {
              match try_load_manifest_rows(entry_path) {
                Some((base_dir, rows)) => {
                  let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)
                  preloaded_sources
                },
                None => {
                  let sources = array_empty()
                  let visited = path_set_new()
                  collect_sources_rec(entry_path, sources, visited)
                  store_persistent_sources_cache(entry_path, None, sources)
                  sources
                }
              }
            }
          }
        }
      }
    }
  }
}

/// #740: the grouped merge (db_grouped_merged_source) treats the LAST
/// flattened source as the export-rename plan entry — its exports stay
/// UNRENAMED. Manifest collection returns sources in MANIFEST ROW ORDER, so a
/// manifest-listed entry that is not the last needed row left some LATER dep
/// exempt from renames instead of the entry: callers were rewritten to that
/// dep's `_exp_<path>` names whose defs were never emitted ("undefined
/// variable (local): ripple_get_fingerprint_exp_..." when FS-compiling
/// runtime/typecheck_fs.vibe, row 152, whose ripple deps sit at rows 150-151).
/// Centralized here (rather than in each collection branch) so groups
/// reconstructed from PERSISTENT CACHES get the same ordering guarantee.
/// No-op when the entry is already last (the plain recursive walk).
fn move_entry_last_grouped(groups: Array[(String, Array[(String, String)])], entry_path: String) -> Array[(String, Array[(String, String)])] {
  let glen = Array::length(groups)
  let mut total = 0
  let mut gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, gi)
    total = total + Array::length(gsources)
    gi = gi + 1
  }
  let mut seen = 0
  let mut entry_is_last = false
  let mut entry_found = false
  let mut entry_source = ""
  gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      seen = seen + 1
      let (spath, stext) = Array::get(gsources, si)
      if spath == entry_path {
        entry_found = true
        entry_source = stext
        if seen == total {
          entry_is_last = true
        } else {
          ()
        }
      } else {
        ()
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if !entry_found || entry_is_last {
    groups
  } else {
    let out = empty_grouped_sources()
    gi = 0
    while gi < glen {
      let (gname, gsources) = Array::get(groups, gi)
      let mut si = 0
      while si < Array::length(gsources) {
        let (spath, stext) = Array::get(gsources, si)
        if spath == entry_path {
          ()
        } else {
          push_grouped_source(out, gname, spath, stext)
        }
        si = si + 1
      }
      gi = gi + 1
    }
    push_grouped_source(out, "entry_last", entry_path, entry_source)
    out
  }
}

export fn collect_source_groups_fs(entry_path: String) -> Array[(String, Array[(String, String)])] with Exception + Fs {
  if String::ends_with(entry_path, ".vibex") {
    ensure_regular_source_fs(entry_path)
    validate_vibex_entry_source(entry_path, Fs::read_file(entry_path))
  } else {
    ()
  }
  let collected = match special_manifest_source_groups(entry_path) {
    Some((manifest_path, groups)) => {
      let _ = manifest_path
      copy_grouped_sources(groups)
    },
    None => {
      ingestion_pipeline_telemetry_add(3, 1)
      match load_persistent_source_groups_cache_if_valid(entry_path) {
        Some(groups) => {
          ingestion_pipeline_telemetry_add(4, 1)
          groups
        },
        None => {
          ingestion_pipeline_telemetry_add(5, 1)
          ingestion_pipeline_telemetry_add(6, 1)
          ingestion_pipeline_telemetry_add(0, 1)
          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {
            Some((manifest_path, groups)) => {
              ingestion_pipeline_telemetry_add(1, 1)
              ingestion_pipeline_telemetry_add(7, 1)
              store_persistent_source_groups_cache(entry_path, manifest_path, groups)
              groups
            },
            None => {
              ingestion_pipeline_telemetry_add(2, 1)
              ingestion_pipeline_telemetry_add(8, 1)
              match try_collect_manifest_source_groups_fs(entry_path) {
                Some((manifest_path, groups)) => {
                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                  groups
                },
                None =>
                match try_load_manifest_rows(entry_path) {
                  Some((base_dir, rows)) => {
                    let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
                    let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                    let groups = empty_grouped_sources()
                    let mut j = 0
                    while j < Array::length(rows) {
                      let (group_name, rel_path) = Array::get(rows, j)
                      let path = join_path(base_dir, rel_path)
                      let mut found = ""
                      let mut k = 0
                      while k < Array::length(preloaded_sources) {
                        if found == "" {
                          let (source_path, source_text) = Array::get(preloaded_sources, k)
                          if source_path == path {
                            found = source_text
                          }
                        }
                        k = k + 1
                      }
                      if found == "" {
                        ()
                      } else {
                        push_grouped_source(groups, group_name, path, found)
                      }
                      j = j + 1
                    }
                    store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                    groups
                  },
                  None => {
                    let groups = empty_grouped_sources()
                    let recursive_sources = collect_all_sources_fs(entry_path)
                    Array::push(groups, ("recursive", recursive_sources))
                    store_persistent_source_groups_cache(entry_path, None, groups)
                    groups
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  move_entry_last_grouped(ingest_grouped_sources_fs(collected), entry_path)
}

//# Module bundling — merge stmts from all modules in dependency order
/// Given all sources (in dependency order), parse and merge their statements.
/// Skips SImport, SReExport (already resolved). Keeps all definitions.
/// #1584: an `import { x as y }` alias must be rewritten back to the
/// original name before the import statement is dropped — the merged flat
/// program only defines `x`, so a surviving `y` reference resolves to
/// nothing and traps at runtime. append_import_alias_rewritten_* is the
/// same shadow-aware rewrite the production FS merge applies; a file with
/// no aliases takes its share-the-input fast path. A top-level `let`/`fn`
/// whose name matches an alias shadows the import for the WHOLE file (the
/// per-statement rewrite only suppresses the map inside the declaring
/// statement), so those aliases are dropped from the map up front.
export fn collect_merged_stmts(sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  // #1840: a fixed source set that contains an ingested contract's FACADE
  // but not its materialized types module would lose the contract's type
  // family entirely (the facade re-exports it; this merge skips
  // import-family statements). Re-inject each registered types module whose
  // originating contract is in THIS set and whose own path is not already a
  // source (the FS-walk lanes collect the file itself — no duplication).
  let sources_all = array_empty()
  let mut ci = 0
  while ci < Array::length(sources) {
    Array::push(sources_all, Array::get(sources, ci))
    ci = ci + 1
  }
  let mut ri = 0
  while ri < Array::length(vpkg_types_registry_paths) {
    let r_contract = Array::get(vpkg_types_registry_contracts, ri)
    let r_path = Array::get(vpkg_types_registry_paths, ri)
    let mut has_contract = false
    let mut has_types = false
    let mut pi = 0
    while pi < Array::length(sources) {
      let (sp, _) = Array::get(sources, pi)
      if sp == r_contract {
        has_contract = true
      } else {
        ()
      }
      if sp == r_path {
        has_types = true
      } else {
        ()
      }
      pi = pi + 1
    }
    if has_contract && !has_types {
      Array::push(sources_all, (r_path, Array::get(vpkg_types_registry_texts, ri)))
    } else {
      ()
    }
    ri = ri + 1
  }
  let merged = array_empty()
  let mut si = 0
  while si < Array::length(sources_all) {
    let (_, src) = Array::get(sources_all, si)
    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)
    let stmts = parse_program(lex(src))
    let top_level_value_names = array_empty()
    let mut ti = 0
    while ti < Array::length(stmts) {
      match Array::get(stmts, ti) {
        SLet(_, _, name, _, _) => Array::push(top_level_value_names, name),
        SLetMut(name, _, _) => Array::push(top_level_value_names, name),
        _ => ()
      }
      ti = ti + 1
    }
    append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, top_level_value_names)
    si = si + 1
  }
  merged
}
/// #847-style trap-free directory probe (see loader/header_cache.vibe's
/// fs_is_directory for the full rationale): `Fs::readdir` TRAPS the whole
/// wasm instance on a non-directory, so a real directory test is required
/// before ever calling it speculatively. Appending "/." and testing with
/// `Fs::exists` is safe on the frozen bootstrap seed (predates `Fs::is_dir`).
fn vpkg_scan_is_directory(path: String) -> Bool with Fs {
  Fs::exists(String::concat(path, "/."))
}
/// #897 (ADR-0070): directories this scan skips entirely -- not source, or
/// not part of this repo's own migration surface (vendored/fetched content,
/// build output, VCS metadata). Anything starting with "." already covers
/// `.git`/`.vibe` (the content-addressed store lives under `.vibe/store/`).
fn vpkg_scan_skip_dir(name: String) -> Bool {
  (String::length(name) > 0 && String::char_code_at(name, 0) == '.') || name == "_build" || name == "node_modules" || name == "target" || name == "deps"
}
/// #897 (ADR-0070): recurse into every non-skipped directory under `root`,
/// recording any directory that has `index.vibei` or plain `index.vibe` but
/// NOT YET `index.vpkg` -- exactly the 76-directory migration surface ADR-
/// 0070 counts. A directory with none of the three index files is not a
/// package boundary and is out of scope. Unlike contract_sibling_impl_raws_
/// rec (which stops at a nested boundary because its job is to list PLAIN
/// impl files), this must recurse THROUGH boundaries too, since nested
/// sub-packages are themselves part of the migration surface.
fn vpkg_scan_rec(dir: String, out: Array[String]) -> Unit with Exception + Fs {
  let has_vpkg = Fs::exists(String::concat(dir, "/index.vpkg"))
  let has_vibei = Fs::exists(String::concat(dir, "/index.vibei"))
  let has_vibe = Fs::exists(String::concat(dir, "/index.vibe"))
  if !has_vpkg && (has_vibei || has_vibe) {
    Array::push(out, dir)
  } else {
    ()
  }
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if !vpkg_scan_skip_dir(name) {
      let full = String::concat(dir, String::concat("/", name))
      if vpkg_scan_is_directory(full) {
        vpkg_scan_rec(full, out)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}
/// find_missing_vpkg_dirs: (String) -> Array[String] with Exception + Fs
export fn find_missing_vpkg_dirs(root: String) -> Array[String] with Exception + Fs {
  let out = array_empty()
  vpkg_scan_rec(root, out)
  out
}
/// check_missing_vpkg_dirs: (String) -> Int with Exception + Fs
/// #897/ADR-0070: `vibe check --missing-vpkg <root>` diagnostic. Reports (via
/// throw, matching every other `vibe check` diagnostic's error-surfacing
/// convention) every directory under `root` still on the old `index.vibei`
/// or bare `index.vibe` spelling, so the migration's remaining scope is a
/// single command away instead of manual auditing.
export fn check_missing_vpkg_dirs(root: String) -> Int with Exception + Fs {
  let missing = find_missing_vpkg_dirs(root)
  if Array::length(missing) == 0 {
    0
  } else {
    throw(String::concat("missing index.vpkg (#897) in: ", String::join(missing, ", ")))
  }
}
/// #1145 follow-up 2: for the `index.vpkg` at `dir` (if any), checks that
/// every external (`@scope/pkg`) import in its own production impl files
/// (the same discovery `contract_package_hashes_fs` uses: explicit
/// `import ./x.vibe {}` entries plus contract_sibling_impl_raws' auto-
/// discovered siblings -- tests/benches excluded) has a matching `deps`
/// entry. A package that predates the #1128 migration (no `name = `
/// directive) has nothing to check yet -- `deps` declarations are opt-in
/// until the bootstrap-bump migrates the remaining closure (#1145
/// follow-up 1).
fn package_deps_missing(dir: String) -> Array[String] with Exception + Fs {
  let vpkg_path = String::concat(dir, "/index.vpkg")
  if !Fs::exists(vpkg_path) {
    array_empty()
  } else {
    let raw = Fs::read_file(vpkg_path)
    let name = extract_package_name(raw)
    if name == "" {
      array_empty()
    } else {
      let deps = extract_package_deps(raw)
      let (_pins, blanked) = extract_require_pins(raw)
      let (_decls, _opaques, extra) = parse_contract_program(lex(blanked))
      let (impl_raws0, _type_defs) = classify_contract_stmts(extra)
      let impl_raws = merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))
      let impl_sources = array_empty()
      let mut i = 0
      while i < Array::length(impl_raws) {
        let resolved = resolve_path_fs(dir, Array::get(impl_raws, i))
        Array::push(impl_sources, Fs::read_file(resolved))
        i = i + 1
      }
      let missing = deps_missing_for_imports(deps, impl_sources)
      let out = array_empty()
      let mut mi = 0
      while mi < Array::length(missing) {
        Array::push(out, "\{dir}: import of \{Array::get(missing, mi)} not declared in deps")
        mi = mi + 1
      }
      out
    }
  }
}
fn deps_missing_scan_rec(dir: String, out: Array[String]) -> Unit with Exception + Fs {
  let here = package_deps_missing(dir)
  let mut hi = 0
  while hi < Array::length(here) {
    Array::push(out, Array::get(here, hi))
    hi = hi + 1
  }
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if !vpkg_scan_skip_dir(name) {
      let full = String::concat(dir, String::concat("/", name))
      if vpkg_scan_is_directory(full) {
        deps_missing_scan_rec(full, out)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}
/// find_deps_missing: (String) -> Array[String] with Exception + Fs
/// #1145 follow-up 2: recursively scans every `index.vpkg` under `root` for
/// deps declarations missing an entry that its own imports require.
export fn find_deps_missing(root: String) -> Array[String] with Exception + Fs {
  let out = array_empty()
  deps_missing_scan_rec(root, out)
  out
}
/// check_deps_missing: (String) -> Int with Exception + Fs
/// #1145 follow-up 2: `vibe check --deps-missing <root>` diagnostic.
export fn check_deps_missing(root: String) -> Int with Exception + Fs {
  let missing = find_deps_missing(root)
  if Array::length(missing) == 0 {
    0
  } else {
    throw(String::concat("deps missing for imports (#1128/#1145): ", String::join(missing, "; ")))
  }
}
