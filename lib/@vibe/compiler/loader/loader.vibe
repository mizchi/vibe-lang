// #847: `loader/` has no index.vibei boundary of its own, so outside callers
// have historically reached straight into `loader/manifest_sources.vibe`
// (bench scripts, tests) instead of going through `loader/index.vibe`. Since
// this module already imports several of manifest_sources' functions for its
// own use above, re-export the full set those outside callers need so they
// can route through the index instead (ADR-0063's "index is the only entry
// point" rule, generalized to plain-index.vibe directories per #847).
export ./manifest_sources.vibe {
  build_grouped_sources_from_manifest_row_source_index,
  build_grouped_sources_from_manifest_rows,
  build_manifest_path_index,
  build_manifest_source_index,
  filter_manifest_sources_by_path_index,
  filter_manifest_sources_by_paths,
  filter_manifest_sources_by_paths_linear,
  filter_manifest_sources_by_source_index,
  load_manifest_full_sources,
  try_collect_manifest_source_groups_fs,
  try_collect_manifest_sources_fs,
  try_load_manifest_rows
}

