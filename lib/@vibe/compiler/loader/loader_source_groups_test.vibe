import @vibe/compiler/loader {
  flatten_group_sources
}

test "flattening preserves source seats and does not alias group storage" {
  let first = [("same.vibe", "first"), ("same.vibe", "second")]
  let last = [("tail.vibe", "last")]
  let flat = flatten_group_sources([
    ("first", first),
    ("empty", []),
    ("last", last)
  ])
  assert_eq(Array::length(flat), 3)
  assert_eq(Array::get(flat, 0), ("same.vibe", "first"))
  assert_eq(Array::get(flat, 1), ("same.vibe", "second"))
  assert_eq(Array::get(flat, 2), ("tail.vibe", "last"))
  Array::set(flat, 0, ("changed.vibe", "changed"))
  Array::push(flat, ("extra.vibe", "extra"))
  assert_eq(Array::length(first), 2)
  assert_eq(Array::get(first, 0), ("same.vibe", "first"))
  Array::set(last, 0, ("new-tail.vibe", "new"))
  assert_eq(Array::get(flat, 2), ("tail.vibe", "last"))
}
