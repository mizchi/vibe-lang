}

import @vibe/core {
  array_empty
}

import @vibe/compiler/cache {
  compact_string_fingerprint, fingerprint_file_fs, normalize_persistent_cache_text, persistent_manifest_header_cache_path
}

import @vibe/compiler/core {
  contains_path, dir_of_path, is_contract_ext, normalize_path, path_set_add, path_set_contains, path_set_new, resolve_import_path_candidates
