//# Path helpers

/// #740: NORMALIZED join. Manifest rows may point outside the compiler dir
/// ("../../lib/@vibe/core/..."); the joined spelling must match what import
/// resolution produces (resolve_import_path normalizes), or the merge plan
/// keys the file under one spelling while importers resolve the other and
/// every cross-reference silently misses (bare `sha1 @call` in the merge).
/// #769: exported for loader_hotspot_probe's linear baseline -- it must build
/// row paths with the SAME `../` normalization the real builders apply, or the
/// manifest's `../../../lib/@vibe/...` rows never match the collected sources.
export fn join_path(base_dir: String, rel_path: String) -> String {
  if base_dir == "" {
    normalize_path(rel_path)
  } else {
    normalize_path(String::concat(base_dir, String::concat("/", rel_path)))
  }
}

fn resolve_manifest_dep_path(base_dir: String, raw_path: String, manifest_path_index: Map[String, Bool]) -> String with Exception + Fs {
  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {
    // A `@scope/name[...]` import used to mean "genuinely external package,
    // not manifest-tracked" -- returning the raw spelling unresolved was
    // harmless since manifest_path_index/should_schedule_manifest_dep never
    // matched it either way. Now that a compiler-internal cross-package
    // import ALSO uses `@vibe/compiler/<sub>` (loader/header_cache.vibe's
    // relative-import package-boundary check requires it), the raw string
    // must actually be resolved for those -- otherwise the dependency edge
    // to that manifest-tracked sub-package silently vanishes from the fast
    // manifest-based collection closure. Try real resolution first; fall
    // back to the raw spelling (old behavior) only when no candidate is
    // manifest-tracked, i.e. it really is external.
    let candidates = resolve_import_path_candidates(base_dir, raw_path)
    let mut i = 0
    let mut found = ""
    while i < Array::length(candidates) {
      if found == "" {
        let candidate = Array::get(candidates, i)
        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {
          found = candidate
        } else ()
      } else ()
      i = i + 1
    }
    if found == "" {
      raw_path
    } else {
      found
    }
  } else {
    let candidates = resolve_import_path_candidates(base_dir, raw_path)
    let mut i = 0
    let mut found = ""
    while i < Array::length(candidates) {
      if found == "" {
        let candidate = Array::get(candidates, i)
        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {
          found = candidate
        }
      }
      i = i + 1
    }
    if found == "" {
      Array::get(candidates, 0)
    } else {
      found
    }
  }
}

/// #1027: an `export <path> { names }` re-export's path can start with either
/// `./` (TDot, same-dir) or `../` (TDotDot, parent-dir) -- `../` lexes as a
/// SINGLE TDotDot token (see @vibe/parser's lexer.vibe / token.vibe / CLAUDE.md
/// "62-bit tagged" section notwithstanding, this is a lexer-level fact:
/// `collect_import_path` in @vibe/parser/parser_base.vibe treats TDot and
/// TDotDot as two distinct path-continuation tokens), NOT a repeated TDot.
/// Checking only TDot here silently treated any `export ../../foo { .. }`
/// statement in a manifest-tracked file (this is the fast hand-rolled scanner
/// used for files listed in compiler_sources_manifest.tsv, NOT the full
/// AST-based collect_import_deps_from_stmts in header_cache.vibe, which
/// already matches SReExport structurally and was unaffected) as a BARE
/// re-export of previously-imported names (no path, no dependency edge) --
/// every `../`-rooted export dependency was silently dropped from the
/// header-based transitive walk (collect_needed_paths_and_manifest_headers /
/// try_collect_manifest_sources_fs / collect_all_sources_fs). Every existing
/// facade in this tree happened to reexport via `./` only, so the gap was
/// latent until lib/@vibe/compiler/syntax/*.vibe (#897 batch 5) became the
/// first manifest-tracked files whose ENTIRE content is a single
/// `export ../../../../lib/@vibe/parser { .. }` statement -- collect_all_sources_fs
/// then silently dropped lib/@vibe/parser/index.vpkg (and everything only
/// reachable through it) from the compiler's own source closure.
fn starts_with_reexport_path_token(tok: Token) -> Bool {
  match tok {
    TDot => true,
    TDotDot => true,
    _ => false
  }
}

fn is_ident_char(c: Int) -> Bool {
  (c >= 'a' && c <= 'z') ||
  (c >= 'A' && c <= 'Z') ||
  (c >= '0' && c <= '9') ||
  c == '_'
}

fn slice_eq_text(s: String, start: Int, text: String) -> Bool {
  let text_len = String::length(text)
  if start + text_len > String::length(s) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < text_len {
      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)
      i = i + 1
    }
    ok
  }
}

fn starts_with_keyword_at(s: String, pos: Int, keyword: String) -> Bool {
  let keyword_len = String::length(keyword)
  if !(slice_eq_text(s, pos, keyword)) {
    false
  } else {
    let before_ok = if pos == 0 {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, pos - 1)))
    }
    let after_pos = pos + keyword_len
    let after_ok = if after_pos >= String::length(s) {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, after_pos)))
    }
    before_ok && after_ok
  }
}

fn skip_header_ws_and_comments(s: String, len: Int, start: Int) -> Int {
  let mut pos = start
  let mut done = false
  while !done && pos < len {
    let c = String::char_code_at(s, pos)
    if c == ' ' || c == '\n' || c == '\t' || c == '\r' || c == ';' {
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      pos = pos + 2
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else {
      done = true
    }
  }
  pos
}

fn scan_header_stmt_end(s: String, len: Int, start: Int) -> Int with Exception {
  let mut pos = start
  let mut brace_depth = 0
  let mut in_string = false
  let mut string_quote = 0
  let mut escape = false
  let mut done = false
  while pos < len && !done {
    let c = String::char_code_at(s, pos)
    if in_string {
      if escape {
        escape = false
      } else if c == '\\' {
        escape = true
      } else if c == string_quote {
        in_string = false
      }
      pos = pos + 1
    } else if c == '"' || c == '\'' {
      in_string = true
      string_quote = c
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else if c == '{' {
      brace_depth = brace_depth + 1
      pos = pos + 1
    } else if c == '}' {
      if brace_depth > 0 {
        brace_depth = brace_depth - 1
      }
      pos = pos + 1
    } else if brace_depth == 0 && (c == '\n' || c == ';') {
      done = true
    } else {
      pos = pos + 1
    }
  }
  pos
}

fn skip_brace_list(tokens: Array[Token], pos: Int) -> Int with Exception {
  match peek(tokens, pos) {
    TLBrace => {
      let mut depth = 1
      let mut i = pos + 1
      while depth > 0 {
        match peek(tokens, i) {
          TLBrace => {
            depth = depth + 1
          },
          TRBrace => {
            depth = depth - 1
          },
          TEof => throw("unterminated brace list in manifest import scanner"),
          _ => ()
        }
        i = i + 1
      }
      i
    }
    _ => throw("expected '{' in manifest import scanner")
  }
}

fn scan_header_import_dep(tokens: Array[Token], pos: Int, base_dir: String, manifest_path_index: Map[String, Bool]) -> (String, Int) with Exception + Fs {
  let (raw_path, next_pos) = match peek(tokens, pos) {
    TIdent(name) =>
    if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {
      (name, pos + 1)
    } else {
      collect_import_path(tokens, pos, "")
    },
    _ => collect_import_path(tokens, pos, "")
  }
  let after_path = match peek(tokens, next_pos) {
    TIdent(alias_name) =>
    if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {
      next_pos + 1
    } else {
      next_pos
    },
    _ => next_pos
  }
  let end_pos = match peek(tokens, after_path) {
    TLBrace => skip_brace_list(tokens, after_path),
    _ => after_path
  }
  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)
}

/// #1027: this scanner's main loop stops at the first top-level statement
/// that isn't `import`/`export` (a deliberate fast-path exploiting the
/// codebase convention that every file's imports come first -- see the
/// `done = true` fallthrough below). A `.vpkg` contract's grammar puts a
/// `version x.y.z` directive (and optional `require ...` pin lines) BEFORE
/// its `import ./x.vibe {}` lines, so scanning a contract file's RAW text
/// hit that fallthrough on line 1 and returned zero deps for EVERY
/// vpkg-ified directory (external package boundaries AND #897 compiler-
/// internal ones alike) -- this is the root cause of #1027's own title
/// ("collect_all_sources_fs undercounts vpkg-ified internal directories"):
/// the walk correctly resolves an import/export edge down to the target
/// `.vpkg` row (that part was always fine), but then found NO further
/// dependencies when it visited that row itself, so a directory's own impl
/// files never got scheduled. `extract_require_pins` (contract/contract.vibe)
/// already knows how to blank exactly this leading directive region (line-
/// based, tolerates comments/blank lines, stops at the first ordinary
/// statement) -- reuse it here instead of re-deriving the same rule, so the
/// import/export scan below sees the blanked (all-whitespace) directive
/// lines and continues straight through to the real import statements.
fn manifest_header_scan_source(path: String, source: String) -> String with Exception {
  if is_contract_ext(path) {
    let (_, blanked) = extract_require_pins(source)
    blanked
  } else {
    source
  }
}

fn collect_manifest_header_deps_from_source(path: String, raw_source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with Exception + Fs {
  let deps = array_empty()
  let base_dir = dir_of_path(path)
  let source = manifest_header_scan_source(path, raw_source)
  let len = String::length(source)
  let mut pos = 0
  let mut done = false
  while !done {
    pos = skip_header_ws_and_comments(source, len, pos)
    if pos >= len {
      done = true
    } else {
      let is_import = starts_with_keyword_at(source, pos, "import")
      let is_export = starts_with_keyword_at(source, pos, "export")
      if !(is_import || is_export) {
        done = true
      } else {
        let stmt_end = scan_header_stmt_end(source, len, pos)
        let stmt_source = source[pos: stmt_end]
        let tokens = lex(stmt_source)
        let stmt_pos = skip_semi(tokens, 0)
        match peek(tokens, stmt_pos) {
          TImport => {
            let (dep_path, _) = scan_header_import_dep(tokens, stmt_pos + 1, base_dir, manifest_path_index)
            Array::push(deps, dep_path)
          },
          TExport => {
            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {
              let (dep_path, _) = scan_header_import_dep(tokens, stmt_pos + 1, base_dir, manifest_path_index)
              Array::push(deps, dep_path)
            }
          },
          _ => {
            done = true
          }
        }
        pos = stmt_end
      }
    }
  }
  // Mirror the full loader's unconditional `.vpkg` sibling auto-discovery
  // (ADR-0070 Phase 1): this fast textual scanner only sees deps the
  // contract's OWN `import ./x.vibe {}` lines spell out explicitly, so a
  // `.vpkg` that relies on (now-legitimate) undeclared siblings silently
  // dropped them from the manifest-preferring FS collection closure --
  // same class of gap as #1027, just for auto-discovered rather than
  // version-directive-blocked deps.
  if String::ends_with(path, ".vpkg") {
    let discovered_raws = contract_sibling_impl_raws(base_dir)
    let mut di = 0
    let discovered_deps = array_empty()
    while di < Array::length(discovered_raws) {
      Array::push(discovered_deps, resolve_manifest_dep_path(base_dir, Array::get(discovered_raws, di), manifest_path_index))
      di = di + 1
    }
    merge_impl_raws_dedupe(deps, discovered_deps)
  } else {
    deps
  }
}

fn collect_manifest_header_deps_from_source_with_context(path: String, source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with Exception + Fs {
  handle {
    collect_manifest_header_deps_from_source(path, source, manifest_path_index)
  } with Exception {
    Throw(err) => throw("manifest header scan failed for " + path + ": " + err)
  }
}

fn is_manifest_external_terminal_dep(path: String) -> Bool {
  String::ends_with(path, "compiler_sources_bundle.vibe")
}

fn should_schedule_manifest_dep(dep_path: String, manifest_path_index: Map[String, Bool]) -> Bool {
  if Map::has_key(manifest_path_index, dep_path) {
    true
  } else {
    !(is_manifest_external_terminal_dep(dep_path))
  }
}

fn load_or_parse_module_header_deps_with_context(path: String, source: String) -> Array[String] with Exception + Fs {
  handle {
    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)
    deps
  } with Exception {
    Throw(err) => throw("module header parse failed for " + path + ": " + err)
  }
}

export fn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String] {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    MapBuilder::set(builder, path, source)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

fn source_lookup_in_index(source_index: Map[String, String], path_key: String) -> Option[String] {
  if Map::has_key(source_index, path_key) {
    Some(Map::get(source_index, path_key))
  } else {
    None
  }
}

export fn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool] {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(paths) {
    MapBuilder::set(builder, Array::get(paths, i), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

fn empty_path_index() -> Map[String, Bool] {
  let builder = MapBuilder::new()
  MapBuilder::freeze(builder)
}

fn build_manifest_path_index_from_rows(base_dir: String, rows: Array[(String, String)]) -> Map[String, Bool] {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    MapBuilder::set(builder, join_path(base_dir, rel_path), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

fn find_manifest_base_dir(entry_path: String) -> Option[String] with Fs {
  let mut base_dir = dir_of_path(entry_path)
  let mut found = None
  let mut done = false
  loop {
    if done {
      break
    }
    let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
    if Fs::exists(manifest_path) {
      found = Some(base_dir)
      done = true
    } else if base_dir == "" {
      done = true
    } else {
      let parent = dir_of_path(base_dir)
      if parent == base_dir {
        done = true
      } else {
        base_dir = parent
      }
    }
  }
  found
}

fn strip_trailing_cr(line: String) -> String {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0: len - 1]
    } else {
      line
    }
  } else {
    line
  }
}

fn find_char(s: String, target: Int) -> Int {
  let len = String::length(s)
  let mut i = 0
  let mut result = -1
  while i < len {
    if String::char_code_at(s, i) == target {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

fn split_tsv_fields(line: String) -> Array[String] {
  let fields = array_empty()
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start: i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}

let header_value_separator = String::from_char_code(31)

fn join_header_values(values: Array[String]) -> String {
  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).
  let out = StringBuilder::new()
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      StringBuilder::push(out, header_value_separator)
    }
    StringBuilder::push(out, Array::get(values, i))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

fn split_header_values(text: String) -> Array[String] {
  let values = array_empty()
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start: i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}

fn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {
  array_empty()
}

fn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {
  array_empty()
}

/// #801 (系統2 follow-up): a bucket that does not exist yet MUST have its first
/// element pushed BEFORE the (group_name, bucket) tuple is embedded into
/// `groups` -- never the other way around. Pushing an EMPTY bucket into
/// `groups` first and mutating the returned handle afterward (the previous
/// shape of this function) let a `groups`-array growth event land between the
/// two pushes; the bucket handle the caller went on to push the first real
/// element into was then observed to diverge from the copy embedded in
/// `groups`, leaving a corrupted `path="0"` row behind (reproduced
/// deterministically for entry "lib/@vibe/compiler/loader/index.vibe": the
/// 11th distinct group, "vibe_core", landed exactly on this hazard while
/// every other group -- multi-row groups whose bucket is already "live" by
/// the time any subsequent `groups` growth happens, and single-row groups
/// created before the hazard's growth boundary -- did not). The already-safe
/// sibling `push_grouped_source` (loader/index.vibe) avoids this by always
/// populating a brand-new bucket with its first item BEFORE pushing the tuple
/// into the outer array; this seeded variant applies the same ordering here.
fn ensure_grouped_source_bucket_seeded(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, value: String) -> Array[(String, String)] {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      found = Some(sources)
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  match found {
    Some(sources) => {
      Array::push(sources, (path, value))
      sources
    },
    None => {
      let sources = array_empty()
      Array::push(sources, (path, value))
      Array::push(groups, (group_name, sources))
      sources
    }
  }
}

fn build_grouped_sources_from_manifest_rows_with_lookup(base_dir: String, rows: Array[(String, String)], on_path: (String) -> Option[String]) -> Array[(String, Array[(String, String)])] {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = array_empty()
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    match on_path(path) {
      Some(source) => {
        if has_last_group && last_group_name == group_name {
          Array::push(last_group_sources, (path, source))
        } else {
          let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, source)
          last_group_name = group_name
          last_group_sources = ensured
          has_last_group = true
        }
      },
      None => ()
    }
    i = i + 1
  }
  groups
}

//# Manifest parsing

fn parse_source_manifest_rows(manifest_source: String) -> Array[(String, String)] with Exception {
  let rows = array_empty()
  let len = String::length(manifest_source)
  let mut line_start = 0
  let mut i = 0
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(manifest_source, i) == 10
    }
    if at_line_end {
      let raw_line = strip_trailing_cr(manifest_source[line_start: i])
      let line_len = String::length(raw_line)
      let has_content = line_len > 0
      let is_comment = if has_content {
        String::char_code_at(raw_line, 0) == 35
      } else {
        false
      }
      if has_content {
        if is_comment {
          ()
        } else {
          let tab_idx = find_char(raw_line, 9)
          let invalid_row = if tab_idx < 0 {
            true
          } else {
            tab_idx + 1 >= line_len
          }
          if invalid_row {
            throw(String::concat("invalid source manifest row: ", raw_line))
          }
          let group = raw_line[0: tab_idx]
          let path = raw_line[tab_idx + 1: line_len]
          Array::push(rows, (group, path))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  rows
}

export fn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with Exception + Fs {
  match find_manifest_base_dir(entry_path) {
    Some(base_dir) => {
      let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))
      let mut has_entry = false
      let mut i = 0
      while i < Array::length(rows) {
        let (_, rel_path) = Array::get(rows, i)
        let path = join_path(base_dir, rel_path)
        if path == entry_path {
          has_entry = true
        }
        i = i + 1
      }
      if has_entry {
        Some((base_dir, rows))
      } else {
        None
      }
    },
    None => None
  }
}

export fn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with Exception + Fs {
  let full_sources = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    Array::push(full_sources, (path, Fs::read_file(path)))
    i = i + 1
  }
  full_sources
}

fn load_manifest_sources_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] with Exception + Fs {
  let sources = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      Array::push(sources, (path, Fs::read_file(path)))
    }
    i = i + 1
  }
  sources
}

fn load_manifest_source_groups_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, Array[(String, String)])] with Exception + Fs {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = array_empty()
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      if has_last_group && last_group_name == group_name {
        Array::push(last_group_sources, (path, Fs::read_file(path)))
      } else {
        let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, Fs::read_file(path))
        last_group_name = group_name
        last_group_sources = ensured
        has_last_group = true
      }
    }
    i = i + 1
  }
  groups
}

export fn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])] {
  build_grouped_sources_from_manifest_rows_with_lookup(base_dir, rows, (path: String) -> Option[String] {
    source_lookup_in_index(source_index, path)
  })
}

export fn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {
  let source_index = build_manifest_source_index(sources)
  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)
}

export fn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if Map::has_key(needed_path_index, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  filtered_sources
}

export fn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {
  let needed_path_index = build_manifest_path_index(needed_paths)
  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)
}

export fn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if contains_path(needed_paths, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  filtered_sources
}

export fn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)] {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(needed_paths) {
    let path = Array::get(needed_paths, i)
    match source_lookup_in_index(preloaded_source_index, path) {
      Some(source) => Array::push(filtered_sources, (path, source)),
      None => ()
    }
    i = i + 1
  }
  filtered_sources
}

//# Manifest header cache

fn parse_persistent_manifest_header_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with Exception {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_manifest_header_cache_rows()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start: i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent manifest header cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent manifest header cache version")
          }
        } else if tag == "manifest" {
          if Array::length(fields) != 4 {
            throw("invalid persistent manifest header cache manifest row")
          }
          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
        } else if tag == "header" {
          if version == 1 {
            if Array::length(fields) != 6 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))
          }
        } else {
          throw(String::concat("invalid persistent manifest header cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}

fn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with Exception + Fs {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        fingerprint_file_fs(path) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      fingerprint_file_fs(path) == source_fingerprint
    } else {
      false
    }
  }
}

fn load_persistent_manifest_header_cache_if_valid(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with Exception + Fs {
  let cache_path = persistent_manifest_header_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_manifest_header_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    let manifest_ok = match manifest {
      Some((cached_path, stat_token_text, source_fingerprint)) =>
      cached_path == manifest_path &&
      matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),
      None => false
    }
    if !manifest_ok {
      None
    } else {
      let mut valid = true
      let mut i = 0
      while i < Array::length(rows) {
        if valid {
          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)
          if !(Map::has_key(manifest_path_index, path)) {
            valid = false
          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
            valid = false
          }
        }
        i = i + 1
      }
      if valid {
        Some(rows)
      } else {
        None
      }
    }
  }
}

fn build_persistent_manifest_header_cache_text(manifest_path: String, rows: Array[(String, String, String, String)]) -> String with Exception + Fs {
  let mut out = "version\t2\n"
  out = String::concat(out, String::concat("manifest\t", String::concat(manifest_path, String::concat("\t", String::concat(__to_string(Fs::stat_token(manifest_path)), String::concat("\t", String::concat(fingerprint_file_fs(manifest_path), "\n")))))))
  let mut i = 0
  while i < Array::length(rows) {
    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)
    out = String::concat(out, String::concat("header\t", String::concat(path, String::concat("\t", String::concat(stat_token_text, String::concat("\t", String::concat(source_fingerprint, String::concat("\t", String::concat(deps_text, "\n")))))))))
    i = i + 1
  }
  out
}

fn store_persistent_manifest_header_cache(entry_path: String, manifest_path: String, rows: Array[(String, String, String, String)]) -> Unit with Exception + Fs {
  Fs::write_file(persistent_manifest_header_cache_path(entry_path), build_persistent_manifest_header_cache_text(manifest_path, rows))
}

fn manifest_header_deps_lookup(rows: Array[(String, String, String, String)], path: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(rows) {
    let (row_path, _, _, deps_text) = Array::get(rows, i)
    if row_path == path {
      found = Some(split_header_values(deps_text))
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}

/// #533: schedule-time dedup via a mutable `path_set`. The previous
/// `Map[String, Bool]` scheduled-set copied the whole map on every
/// `Map::set` (O(N) per insert → O(N²) total) and linearly scanned it per
/// `Map::has_key`; the pop-time `contains_path(visited, current)` guard
/// was another O(edges × modules) scan that could never fire, because
/// every worklist push is gated on the scheduled set, making worklist
/// entries unique by construction. `visited` stays an insertion-ordered
/// array — it is the returned needed-paths list. (Same pattern in the two
/// sibling collectors below.)
fn collect_needed_paths_from_manifest_headers(path: String, manifest_path_index: Map[String, Bool], rows: Array[(String, String, String, String)]) -> Array[String] with Exception + Fs {
  let visited = array_empty()
  let worklist = array_empty()
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let deps = match manifest_header_deps_lookup(rows, current) {
      Some(found) => found,
      None => {
        let source = Fs::read_file(current)
        if Map::has_key(manifest_path_index, current) {
          collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)
        } else {
          load_or_parse_module_header_deps_with_context(current, source)
        }
      }
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
      !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  visited
}

fn collect_needed_paths_and_manifest_headers(path: String, manifest_path_index: Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with Exception + Fs {
  let rows = empty_manifest_header_cache_rows()
  let visited = array_empty()
  let worklist = array_empty()
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let source = Fs::read_file(current)
    let deps = match manifest_header_deps_lookup(rows, current) {
      Some(found) => found,
      None => {
        let parsed_deps = if Map::has_key(manifest_path_index, current) {
          collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)
        } else {
          load_or_parse_module_header_deps_with_context(current, source)
        }
        Array::push(rows, (current, __to_string(Fs::stat_token(current)), compact_string_fingerprint(source), join_header_values(parsed_deps)))
        parsed_deps
      }
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
      !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  (rows, visited)
}

fn collect_needed_paths_from_manifest_scan(path: String, manifest_path_index: Map[String, Bool]) -> Array[String] with Exception + Fs {
  let visited = array_empty()
  let worklist = array_empty()
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let source = Fs::read_file(current)
    let deps = if Map::has_key(manifest_path_index, current) {
      collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)
    } else {
      load_or_parse_module_header_deps_with_context(current, source)
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
      !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  visited
}

fn load_or_collect_manifest_header_rows(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Array[(String, String, String, String)] with Exception + Fs {
  match load_persistent_manifest_header_cache_if_valid(entry_path, manifest_path, manifest_path_index) {
    Some(cached_rows) => cached_rows,
    None => {
      let (built_rows, _) = collect_needed_paths_and_manifest_headers(entry_path, manifest_path_index)
      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)
      built_rows
    }
  }
}

export fn probe_manifest_header_rows_count(entry_path: String) -> Int with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)
      Array::length(header_rows)
    },
    None => throw("manifest rows unavailable")
  }
}

export fn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let (header_rows, _) = collect_needed_paths_and_manifest_headers(entry_path, manifest_path_index)
      Array::length(header_rows)
    },
    None => throw("manifest rows unavailable")
  }
}

export fn probe_manifest_needed_paths_count(entry_path: String) -> Int with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)
      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)
      Array::length(needed_paths)
    },
    None => throw("manifest rows unavailable")
  }
}

export fn probe_manifest_scan_paths_count(entry_path: String) -> Int with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let needed_paths = collect_needed_paths_from_manifest_scan(entry_path, manifest_path_index)
      Array::length(needed_paths)
    },
    None => throw("manifest rows unavailable")
  }
}

//# Source collection

export fn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)
      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)
      let needed_path_index = build_manifest_path_index(needed_paths)
      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, sources))
    },
    None => None
  }
}

export fn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with Exception + Fs {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "compiler_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)
      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)
      let needed_path_index = build_manifest_path_index(needed_paths)
      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, groups))
    },
    None => None
  }
}
