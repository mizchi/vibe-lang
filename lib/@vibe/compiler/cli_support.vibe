//# Imports

import ./codegen/wasi {
  compile_wasi_module_linked_impl
}

import ./codegen/common_base {
  empty_dbg_prov
}

import ./checker/index.vibe {
  check_program
}

import ./core/index.vibe {
  Stmt
}

import ./entry/compiler/file_compile {
  compile_file_fs_mode, compile_file_fs_mode_cached, compile_file_fs_mode_cached_profiled,
  compile_file_fs_mode_profiled
}

import ./entry/source_compile/wasi_only/linked_artifacts.vibe {
  collect_linked_compile_inputs, collect_linked_dep_inputs_for_stmts
}

import ./entry/source_compile/wasi_only/preprocess_interp.vibe {
  expand_interp_stmts
}

import ./entry/source_compile/wasi_only/path_utils.vibe {
  empty_stmt_array
}

import ./entry/source_compile/wasi_only/linked_library.vibe {
  compile_file_wasi_library
}

import ./type_db.vibe {
  db_new
}

// #946(3,4): `vibe check` runs this same inline-wasm codegen validation (lane
// index / align / etc.) as `vibe diagnostics` — see check_inline_wasm_fns'
// doc comment in typecheck_fs.vibe. Without this, making `check` genuinely
// codegen-free (Gate v2 #492, wired to the CLI by #946(3)) would have made it
// blind to inline-wasm errors that used to be caught by the old full-compile
// `check` — a regression trade for fixing the empty-file false-positive.
// `locate_type_error` recovers the `line:col` prefix the OLD full-compile
// `check` got for free via typecheck_fs.vibe's own db_typecheck_fs path
// (finish_typecheck_fs_impl wraps every check_program Throw with it) —
// without rewrapping here, check_linked_file's raw check_program message
// would regress every located-diagnostic case check has (scripts/
// test_located_diagnostics.sh).
import ./runtime/typecheck_fs.vibe {
  check_inline_wasm_fns, locate_type_error
}

// #946(3): re-parse the entry file WITH real char offsets for check_linked_file
// (see its doc comment) — collect_linked_compile_inputs's own entry_stmts come
// from linked_artifacts.vibe's read_program, which parses via the PLAIN
// `parse_program(lex(source))` (no starts array => every node's offset is -1,
// same pitfall parse_program_with_path's doc comment describes for
// finish_typecheck_fs_impl). Re-parsing just the entry file is self-contained
// (no shared-helper edit, so compile/build/debug paths that also flow through
// read_program are untouched). Uses the RECOVERING parser (not
// parse_program_located): every diagnostic parse_program_recovering emits is
// ALREADY a full `line L:col C: msg` string (extract_err_token_pos +
// offset_to_line_col at the point of the throw, in parser.vibe) — the same
// robust locating parse_program_located does only for its own top-level
// throws, missing errors that bubble up from nested expr-parsing helpers
// (e.g. `export let bad = = 5`'s "unexpected token at #9: ..." came back
// unlocated through parse_program_located but located through the recovering
// parser). check_linked_file only wants the single FIRST parse error (`check`
// is one-error-at-a-time; `vibe diagnostics` is the multi-diagnostic surface
// — collect_all_diagnostics already uses this same recovering parser).
import ./syntax {
  lex_with_offsets, parse_program_recovering
}

//# Functions

fn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn linked_output_dir(output_path: String) -> String {
  let len = String::length(output_path)
  if len >= 5 && output_path[len - 5: len] == ".wasm" {
    String::concat(output_path[0: len - 5], ".debug")
  } else {
    String::concat(output_path, ".debug")
  }
}

fn empty_source_pairs() -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

fn normalize_release_mode(mode: String) -> String with { Error } {
  if mode == "" || mode == "release" || mode == "no-dce" {
    "no-dce"
  } else if mode == "mvp" {
    "mvp"
  } else {
    throw(String::concat("unsupported release mode: ", mode))
  }
}

export fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)
  bytes
}

export fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode(input_path, entry_name, compile_mode)
}

export fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)
}

export fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)
}

export fn compile_release_file(input_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  compile_release_file_mode(input_path, entry_name, "no-dce")
}

export fn compile_debug_library(dep_path: String) -> Bytes with { Error, Fs } {
  compile_file_wasi_library(dep_path)
}

fn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    match Array::get(src, i) {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(dst, Array::get(src, i))
    }
    i = i + 1
  }
}

export fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with { Error, Fs } {
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)
  let main_stmts = empty_stmt_array()
  append_stmt_array(main_stmts, resolved_type_stmts)
  append_non_import_stmts(main_stmts, entry_stmts)
  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, empty_dbg_prov())
  (bytes, linked_dep_specs)
}

// Gate v2 (#492): parse + typecheck only, with imports linked. The checker
// knows builtin signatures, so this surfaces REAL language/checker
// expressiveness gaps (parse errors, type errors, genuine unknown names)
// WITHOUT the codegen builtin-body-linking confounder that makes the `debug`
// mode emit spurious `undefined variable: Ns::method`. No wasm is produced.
export fn check_linked_file(input_path: String) -> Int with { Error, Fs } {
  // Mirrors the front of compile_file_wasi_linked_artifacts exactly (the proven
  // linked check): keep SImport stmts so check_program registers imported names,
  // expand interpolation, then check — but stop before codegen. Stripping
  // imports here would make every imported value read as `unknown name`.
  //
  // #946(3): parse the entry file OURSELVES first (located + recovering —
  // see the import comment above), then feed those stmts into
  // collect_linked_dep_inputs_for_stmts for dep/import resolution, instead of
  // calling collect_linked_compile_inputs (which re-parses the entry file
  // itself via linked_artifacts.vibe's plain, unlocated, non-recovering
  // read_program — any entry-file parse error there throws a RAW message
  // before this function's own located handling ever runs).
  let entry_source = Fs::read_file(input_path)
  let (tokens, starts, _ends) = lex_with_offsets(entry_source)
  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)
  if Array::length(parse_diags) > 0 {
    // Already a full `line L:col C: msg` string (see the import comment
    // above) -- report just the first, matching check's one-error-at-a-time
    // convention (vibe diagnostics is the multi-diagnostic surface).
    throw(Array::get(parse_diags, 0))
  } else {
    ()
  }
  let (resolved_type_stmts, _linked_imports, _linked_dep_specs) = collect_linked_dep_inputs_for_stmts(input_path, entry_stmts)
  let stmts = empty_stmt_array()
  append_stmt_array(stmts, resolved_type_stmts)
  append_stmt_array(stmts, entry_stmts)
  expand_interp_stmts(stmts)
  // #946(3): locate errors against the ENTRY file's own source text. `stmts`
  // is the MERGED entry+deps statement list, so a [@off=N]/by-name location
  // is only exact for errors whose blame is in the entry file itself (the
  // common case, and the one every located-diagnostic regression test
  // exercises); an error rooted in an imported dependency degrades to the
  // unlocated message, same as before this fix, rather than mis-locating it
  // against the wrong file's text.
  handle {
    let _ = check_program(stmts)
    match check_inline_wasm_fns(stmts) {
      Some(msg) => throw(locate_type_error(entry_source, msg)),
      None => ()
    }
  } with Error {
    Throw(msg) => throw(locate_type_error(entry_source, msg))
  }
  0
}

export fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with { Error, Fs } {
  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)
  Fs::write_bytes(output_path, entry_bytes)
  let output_dir = linked_output_dir(output_path)
  let mut i = 0
  while i < Array::length(linked_dep_specs) {
    let (module_name, dep_path) = Array::get(linked_dep_specs, i)
    let lib_output_path = String::concat(output_dir, String::concat("/", String::concat(module_name, ".wasm")))
    let lib_bytes = compile_debug_library(dep_path)
    Fs::write_bytes(lib_output_path, lib_bytes)
    i = i + 1
  }
}
