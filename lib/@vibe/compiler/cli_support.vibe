//# Imports

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_linked_impl
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_base {
  codegen_body_cache_new, empty_dbg_prov
}

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/entry/compiler/file_compile {
  check_file_fs_mode, compile_file_fs_mode, compile_file_fs_mode_cached, compile_file_fs_mode_cached_profiled, compile_file_fs_mode_profiled
}

// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --
// these used to be three separate leaf imports (linked_artifacts.vibe,
// preprocess_interp.vibe, linked_library.vibe), now merged into one. A
// fourth leaf import (path_utils.vibe's `empty_stmt_array`) is dropped
// entirely: it is a private helper only promoted to sibling-file visibility
// within wasi_only/ (not part of this package's declared contract surface,
// see wasi_only/index.vpkg's header), and its body is a one-line forward to
// `@vibe/core`'s generic `array_empty[T]()` -- already imported below under
// its own name, so the two call sites that used `empty_stmt_array()` now
// call `array_empty()` directly instead.
import @vibe/compiler/entry/source_compile/wasi_only {
  collect_linked_compile_inputs, collect_linked_dep_inputs_for_stmts, compile_file_wasi_library, expand_interp_stmts
}

import ./type_db.vibe {
  db_new
}

// #946(3,4): `vibe check` runs this same inline-wasm codegen validation (lane
// index / align / etc.) as `vibe diagnostics` — see check_inline_wasm_fns'
// doc comment in typecheck_fs.vibe. Without this, making `check` genuinely
// codegen-free (Gate v2 #492, wired to the CLI by #946(3)) would have made it
// blind to inline-wasm errors that used to be caught by the old full-compile
// `check` — a regression trade for fixing the empty-file false-positive.
// `locate_type_error` recovers the `line:col` prefix the OLD full-compile
// `check` got for free via typecheck_fs.vibe's own db_typecheck_fs path
// (finish_typecheck_fs_impl wraps every Throw with it) — without rewrapping
// here, check_linked_file's raw check_file_fs_mode/check_program message
// would regress every located-diagnostic case check has (scripts/
// test_located_diagnostics.sh).
import @vibe/compiler/runtime {
  check_inline_wasm_fns, locate_type_error
}

// #946(3): re-parse the entry file WITH real char offsets for check_linked_file
// (see its doc comment) — collect_linked_compile_inputs's own entry_stmts come
// from linked_artifacts.vibe's read_program, which parses via the PLAIN
// `parse_program(lex(source))` (no starts array => every node's offset is -1,
// same pitfall parse_program_with_path's doc comment describes for
// finish_typecheck_fs_impl). Re-parsing just the entry file is self-contained
// (no shared-helper edit, so compile/build/debug paths that also flow through
// read_program are untouched). Uses the RECOVERING parser (not
// parse_program_located): every diagnostic parse_program_recovering emits is
// ALREADY a full `line L:col C: msg` string (extract_err_token_pos +
// offset_to_line_col at the point of the throw, in parser.vibe) — the same
// robust locating parse_program_located does only for its own top-level
// throws, missing errors that bubble up from nested expr-parsing helpers
// (e.g. `export let bad = = 5`'s "unexpected token at #9: ..." came back
// unlocated through parse_program_located but located through the recovering
// parser). check_linked_file only wants the single FIRST parse error (`check`
// is one-error-at-a-time; `vibe diagnostics` is the multi-diagnostic surface
// — collect_all_diagnostics already uses this same recovering parser).
import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_recovering
}

//# Functions

fn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn linked_output_dir(output_path: String) -> String {
  let len = String::length(output_path)
  if len >= 5 && output_path[len - 5: len] == ".wasm" {
    String::concat(output_path[0: len - 5], ".debug")
  } else {
    String::concat(output_path, ".debug")
  }
}

fn empty_source_pairs() -> Array[(String, String)] {
  array_empty()
}

fn normalize_release_mode(mode: String) -> String with Exception {
  if mode == "" || mode == "release" || mode == "no-dce" {
    "no-dce"
  } else if mode == "mvp" {
    "mvp"
  } else {
    throw(String::concat("unsupported release mode: ", mode))
  }
}

export fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)
  bytes
}

export fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode(input_path, entry_name, compile_mode)
}

export fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)
}

export fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)
}

export fn compile_release_file(input_path: String, entry_name: String) -> Bytes with Exception + Fs {
  compile_release_file_mode(input_path, entry_name, "no-dce")
}

export fn compile_debug_library(dep_path: String) -> Bytes with Exception + Fs {
  compile_file_wasi_library(dep_path)
}

fn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    match Array::get(src, i) {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(dst, Array::get(src, i))
    }
    i = i + 1
  }
}

export fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with Exception + Fs {
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)
  let main_stmts = array_empty()
  append_stmt_array(main_stmts, resolved_type_stmts)
  append_non_import_stmts(main_stmts, entry_stmts)
  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
  (bytes, linked_dep_specs)
}

/// Gate v2 (#492): parse + typecheck only, with imports linked. The checker
/// knows builtin signatures, so this surfaces REAL language/checker
/// expressiveness gaps (parse errors, type errors, genuine unknown names)
/// WITHOUT the codegen builtin-body-linking confounder that makes the `debug`
/// mode emit spurious `undefined variable: Ns::method`. No wasm is produced.
export fn check_linked_file(input_path: String) -> Int with Exception + Fs {
  // #946(3): parse the entry file OURSELVES first (located + recovering —
  // see the import comment above) so a parse error is reported with an exact
  // `line:col` before any other check runs.
  let entry_source = Fs::read_file(input_path)
  let (tokens, starts, _ends) = lex_with_offsets(entry_source)
  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)
  if Array::length(parse_diags) > 0 {
    // Already a full `line L:col C: msg` string (see the import comment
    // above) -- report just the first, matching check's one-error-at-a-time
    // convention (vibe diagnostics is the multi-diagnostic surface).
    throw(Array::get(parse_diags, 0))
  } else {
    ()
  }
  // #946 P1 (Codex, PR #1006): the type-check itself must go through
  // check_file_fs_mode (the fs-mode source-group + db_typecheck_fs pipeline
  // compile_file_fs_mode already relies on for a real compile), NOT
  // collect_linked_dep_inputs_for_stmts + check_program. That "linked"
  // mechanism exists to feed the wasm import-linking codegen boundary: it
  // copies a dependency's SEnum/struct declarations into the checked stmts
  // but never a `let rec fn` signature, so check_program never learned an
  // imported function's real type and a wrong-typed call site (e.g.
  // `f("x")` against `fn f(x: Int)`) typechecked cleanly no matter what was
  // passed — confirmed via a live two-file repro before this fix.
  //
  // collect_linked_dep_inputs_for_stmts is still used below, ONLY to build
  // the merged stmts check_inline_wasm_fns scans (inline-wasm fns can live in
  // an imported file too) — that scan is independent of type information.
  handle {
    let _ = check_file_fs_mode(input_path)
    let (resolved_type_stmts, _linked_imports, _linked_dep_specs) = collect_linked_dep_inputs_for_stmts(input_path, entry_stmts)
    let stmts = array_empty()
    append_stmt_array(stmts, resolved_type_stmts)
    append_stmt_array(stmts, entry_stmts)
    expand_interp_stmts(stmts)
    // #946(3): locate errors against the ENTRY file's own source text. `stmts`
    // is the MERGED entry+deps statement list, so a [@off=N]/by-name location
    // is only exact for errors whose blame is in the entry file itself (the
    // common case, and the one every located-diagnostic regression test
    // exercises); an error rooted in an imported dependency degrades to the
    // unlocated message, same as before this fix, rather than mis-locating it
    // against the wrong file's text.
    match check_inline_wasm_fns(stmts) {
      Some(msg) => throw(locate_type_error(entry_source, msg)),
      None => ()
    }
  } with Exception {
    Throw(msg) => throw(locate_type_error(entry_source, msg))
  }
  0
}

//# Release wasm stripping (#1100 size)

/// Read one unsigned LEB128 at `i`; returns (value, next_index) or (-1, end)
/// when malformed/truncated so callers can bail out to the untouched input.
fn strip_read_uleb(wasm: Bytes, start: Int, end: Int) -> (Int, Int) {
  let mut i = start
  let mut v = 0
  let mut shift = 0
  while i < end && shift < 35 {
    let b = Bytes::get(wasm, i)
    v = v|((b&127)<<shift)
    i = i + 1
    if (b&128) == 0 {
      return (v, i)
    } else {
      shift = shift + 7
    }
  }
  (0 - 1, end)
}

fn strip_bytes_range_eq_str(wasm: Bytes, start: Int, n: Int, s: String) -> Bool {
  if n != String::length(s) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(wasm, start + i) != String::char_code_at(s, i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn strip_bytes_range_starts_with(wasm: Bytes, start: Int, n: Int, prefix: String) -> Bool {
  let plen = String::length(prefix)
  if n < plen {
    false
  } else {
    strip_bytes_range_eq_str(wasm, start, plen, prefix)
  }
}

fn strip_push_range(out: Bytes, wasm: Bytes, start: Int, end: Int) -> Unit {
  let mut i = start
  while i < end {
    Bytes::push(out, Bytes::get(wasm, i))
    i = i + 1
  }
}

fn strip_push_uleb(out: Bytes, value: Int) -> Unit {
  let mut v = value
  let mut more = true
  while more {
    let b = v&127
    v = v>>7
    if v == 0 {
      Bytes::push(out, b)
      more = false
    } else {
      Bytes::push(out, b|128)
    }
  }
}

/// Executable-output post-pass: drop the `name` custom section (debug info)
/// and/or filter the export section down to the entries an executable's
/// runners actually address by name — the entry function, `_start`,
/// `cli_main`, per-block `__bench_*`/`__test_*` exports, and every non-function
/// export (memory / `__heap_ptr` global / `error` tag). Everything else is a
/// module-linking artifact (`*_exp_lib__*` mangled names from the flat module
/// source) that nothing external can reasonably call. Section-level surgery
/// only: removing a custom section or export ENTRIES never renumbers any
/// index, so the code/table/elem sections are byte-identical. Any parse
/// anomaly returns the input untouched. Component/library/test paths must NOT
/// come through here — components lift core exports by name and `vibe test`
/// tooling reads `__test_*` frames from the name section (callers gate on
/// entry_name/env, see strip_executable_wasm_env).
export fn strip_executable_wasm(wasm: Bytes, entry_name: String, strip_names: Bool, filter_exports: Bool) -> Bytes {
  if !strip_names && !filter_exports {
    return wasm
  } else {
    ()
  }
  let len = Bytes::length(wasm)
  if len < 8 {
    return wasm
  } else {
    ()
  }
  let out = Bytes::new()
  strip_push_range(out, wasm, 0, 8)
  let mut i = 8
  let mut ok = true
  while ok && i < len {
    let sid = Bytes::get(wasm, i)
    let (ssz, payload_start) = strip_read_uleb(wasm, i + 1, len)
    if ssz < 0 || payload_start + ssz > len {
      ok = false
    } else {
      let payload_end = payload_start + ssz
      let mut handled = false
      if sid == 0 && strip_names {
        // custom section: drop iff its name is exactly "name"
        let (cn_len, cn_start) = strip_read_uleb(wasm, payload_start, payload_end)
        if cn_len >= 0 && cn_start + cn_len <= payload_end {
          if strip_bytes_range_eq_str(wasm, cn_start, cn_len, "name") {
            handled = true
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      if !handled && sid == 7 && filter_exports {
        let (exp_count, cur0) = strip_read_uleb(wasm, payload_start, payload_end)
        if exp_count >= 0 {
          let kept = Bytes::new()
          let mut kept_count = 0
          let mut cur = cur0
          let mut ei = 0
          let mut parse_ok = true
          while parse_ok && ei < exp_count {
            let entry_start = cur
            let (nlen, nstart) = strip_read_uleb(wasm, cur, payload_end)
            if nlen < 0 || nstart + nlen + 1 > payload_end {
              parse_ok = false
            } else {
              let kind = Bytes::get(wasm, nstart + nlen)
              let (_eidx, entry_end) = strip_read_uleb(wasm, nstart + nlen + 1, payload_end)
              if entry_end > payload_end {
                parse_ok = false
              } else {
                let keep = kind != 0 || strip_bytes_range_eq_str(wasm, nstart, nlen, entry_name) || strip_bytes_range_eq_str(wasm, nstart, nlen, "_start") || strip_bytes_range_eq_str(wasm, nstart, nlen, "cli_main") || strip_bytes_range_starts_with(wasm, nstart, nlen, "__bench_") || strip_bytes_range_starts_with(wasm, nstart, nlen, "__test_")
                if keep {
                  strip_push_range(kept, wasm, entry_start, entry_end)
                  kept_count = kept_count + 1
                } else {
                  ()
                }
                cur = entry_end
                ei = ei + 1
              }
            }
          }
          if parse_ok {
            Bytes::push(out, 7)
            let sec_content = Bytes::new()
            strip_push_uleb(sec_content, kept_count)
            Bytes::append(sec_content, kept)
            strip_push_uleb(out, Bytes::length(sec_content))
            Bytes::append(out, sec_content)
            handled = true
          } else {
            ok = false
          }
        } else {
          ok = false
        }
      } else {
        ()
      }
      if ok && !handled {
        strip_push_range(out, wasm, i, payload_end)
      } else {
        ()
      }
      i = payload_end
    }
  }
  if ok {
    out
  } else {
    wasm
  }
}

/// Env-gated policy wrapper shared by the CLI adapter (env-mode interface) and
/// the command dispatch layer: executables (a real entry name) are stripped by
/// default; `__no_entry__` builds (test/bench/serve cores) are left untouched
/// because their tooling reads `__test_*` name-section frames, greps the
/// binary for `__test_`, enumerates `__bench_*` exports, or lifts component
/// exports by name. VIBE_WASM_NAMES=1 keeps the name section (profiling /
/// trap-backtrace workflows); VIBE_WASM_KEEP_EXPORTS=1 keeps every export.
export fn strip_executable_wasm_env(wasm: Bytes, entry_name: String) -> Bytes with Env {
  if entry_name == "__no_entry__" {
    wasm
  } else {
    strip_executable_wasm(wasm, entry_name, Env::get("VIBE_WASM_NAMES") != "1", Env::get("VIBE_WASM_KEEP_EXPORTS") != "1")
  }
}

export fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with Exception + Fs {
  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)
  Fs::write_bytes(output_path, entry_bytes)
  let output_dir = linked_output_dir(output_path)
  let mut i = 0
  while i < Array::length(linked_dep_specs) {
    let (module_name, dep_path) = Array::get(linked_dep_specs, i)
    let lib_output_path = String::concat(output_dir, String::concat("/", String::concat(module_name, ".wasm")))
    let lib_bytes = compile_debug_library(dep_path)
    Fs::write_bytes(lib_output_path, lib_bytes)
    i = i + 1
  }
}
