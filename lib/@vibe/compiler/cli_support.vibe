// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --
// these used to be three separate leaf imports (linked_artifacts.vibe,
// preprocess_interp.vibe, linked_library.vibe), now merged into one. A
// fourth leaf import (path_utils.vibe's `empty_stmt_array`) is dropped
// entirely: it is a private helper only promoted to sibling-file visibility
// within wasi_only/ (not part of this package's declared contract surface,
// see wasi_only/index.vpkg's header), and its body is a one-line forward to
// `@vibe/core`'s generic `array_empty[T]()` -- already imported below under
// its own name, so the two call sites that used `empty_stmt_array()` now
// call `array_empty()` directly instead.
import @vibe/compiler/entry/source_compile/wasi_only {
  collect_linked_compile_inputs, compile_file_wasi_library, expand_interp_stmts
}

import ./type_db.vibe {
  db_new
}

// #946(3,4): `vibe check` runs this same inline-wasm codegen validation (lane
// index / align / etc.) as `vibe diagnostics` — see check_inline_wasm_fns'
// doc comment in typecheck_fs.vibe. Without this, making `check` genuinely
// codegen-free (Gate v2 #492, wired to the CLI by #946(3)) would have made it
// blind to inline-wasm errors that used to be caught by the old full-compile
// `check` — a regression trade for fixing the empty-file false-positive.
// `locate_type_error` recovers the `line:col` prefix the OLD full-compile
// `check` got for free via typecheck_fs.vibe's own db_typecheck_fs path
// (finish_typecheck_fs_impl wraps every Throw with it) — without rewrapping
// here, check_linked_file's raw check_file_fs_mode/check_program message
// would regress every located-diagnostic case check has (scripts/
// test_located_diagnostics.sh).
import @vibe/compiler/runtime {
  check_inline_wasm_fns, deprecated_warning_lines_visible, locate_type_error, unstable_import_diagnostics,
  unstable_inherited_marker, checked_warning_stmts, unstable_index_of_str
}

// #946(3): re-parse the entry file WITH real char offsets for check_linked_file
// (see its doc comment) — collect_linked_compile_inputs's own entry_stmts come
// from linked_artifacts.vibe's read_program, which parses via the PLAIN
// `parse_program(lex(source))` (no starts array => every node's offset is -1,
// same pitfall parse_program_with_path's doc comment describes for
// finish_typecheck_fs_impl). Re-parsing just the entry file is self-contained
// (no shared-helper edit, so compile/build/debug paths that also flow through
// read_program are untouched). Uses the RECOVERING parser (not
// parse_program_located): every diagnostic parse_program_recovering emits is
// ALREADY a full `line L:col C: msg` string (extract_err_token_pos +
// offset_to_line_col at the point of the throw, in parser.vibe) — the same
// robust locating parse_program_located does only for its own top-level
// throws, missing errors that bubble up from nested expr-parsing helpers
// (e.g. `export let bad = = 5`'s "unexpected token at #9: ..." came back
// unlocated through parse_program_located but located through the recovering
// parser). check_linked_file only wants the single FIRST parse error (`check`
// is one-error-at-a-time; `vibe diagnostics` is the multi-diagnostic surface
// — collect_all_diagnostics already uses this same recovering parser).
import @vibe/compiler/syntax {
  Token, lex_with_offsets, parse_program_recovering, token_to_string
}

//# Functions

fn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn linked_output_dir(output_path: String) -> String {
  let len = String::length(output_path)
  if len >= 5 && output_path[len - 5: len] == ".wasm" {
    String::concat(output_path[0: len - 5], ".debug")
  } else {
    String::concat(output_path, ".debug")
  }
}

fn empty_source_pairs() -> Array[(String, String)] {
  array_empty()
}

fn normalize_release_mode(mode: String) -> String with Exception {
  if mode == "" || mode == "release" || mode == "no-dce" {
    "no-dce"
  } else if mode == "mvp" {
    "mvp"
  } else {
    throw(String::concat("unsupported release mode: ", mode))
  }
}

export fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)
  bytes
}

export fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode(input_path, entry_name, compile_mode)
}

export fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let compile_mode = normalize_release_mode(mode)
  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)
}

export fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let compile_mode = normalize_release_mode(mode)
  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)
}

export fn compile_release_file(input_path: String, entry_name: String) -> Bytes with Exception + Fs {
  compile_release_file_mode(input_path, entry_name, "no-dce")
}

export fn compile_debug_library(dep_path: String) -> Bytes with Exception + Fs {
  compile_file_wasi_library(dep_path)
}

fn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    match Array::get(src, i) {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(dst, Array::get(src, i))
    }
    i = i + 1
  }
}

/// #1514 C (repair 08): the evidence-passing hard error carries the culprit
/// call as `(here: the call to 'X') ... [@off=N:M]`, where N:M index the text
/// of whichever MODULE the handle lives in. This lane resolves markers against
/// the ENTRY file's text, which is only correct when the culprit is in the
/// entry file itself. Verify the span actually spells `X` in `source` — as a
/// whole identifier, not a slice of a longer one (a dep offset landing inside
/// the entry's `run_all` must not pass for culprit `run`) — before letting
/// locate_type_error resolve it; on mismatch (a dep-module offset) strip the
/// marker so the message degrades to unlocated instead of naming a
/// plausible-but-wrong entry-file line (worse than no position, per #1445).
/// Messages without the culprit clause pass through untouched. This is the
/// single-source primitive; linked lanes must use
/// verify_culprit_off_marker_snapshot below, which additionally rejects an
/// entry match when any dependency in the same consumed snapshot matches the
/// same culprit and span (#1596).
/// Parse a run of ASCII digits as a non-negative Int, or -1 when `s` is empty
/// or contains any non-digit (local copy of typecheck_fs's parse_offset_digits,
/// which is module-private there).
fn parse_marker_digits(s: String) -> Int {
  let n = String::length(s)
  let mut i = 0
  let mut acc = 0
  let mut ok = n > 0
  while i < n && ok {
    let c = String::char_code_at(s, i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    } else {
      ok = false
    }
    i = i + 1
  }
  if ok {
    acc
  } else {
    -1
  }
}

/// True when char code `c` can appear in a vibe identifier (ASCII letter,
/// digit, or underscore) — used for the whole-identifier boundary check.
fn marker_ident_char(c: Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

export fn verify_culprit_off_marker(source: String, msg: String) -> String {
  let clause = " (here: the call to '"
  let ci = String::index_of(msg, clause)
  let marker = " [@off="
  let mi = String::index_of(msg, marker)
  if ci < 0 || mi < 0 {
    msg
  } else {
    let name_start = ci + String::length(clause)
    let name_rel = String::index_of(String::substring(msg, name_start, String::length(msg)), "')")
    let inner_start = mi + String::length(marker)
    let close_rel = String::index_of(String::substring(msg, inner_start, String::length(msg)), "]")
    if name_rel < 0 || close_rel < 0 {
      msg
    } else {
      let culprit = String::substring(msg, name_start, name_start + name_rel)
      let inner = String::substring(msg, inner_start, inner_start + close_rel)
      let colon = String::index_of(inner, ":")
      let span_ok = if colon < 0 {
        false
      } else {
        let n = parse_marker_digits(String::substring(inner, 0, colon))
        let m = parse_marker_digits(String::substring(inner, colon + 1, String::length(inner)))
        if n >= 0 && m > n && m <= String::length(source) && String::substring(source, n, m) == culprit {
          // Whole-identifier boundary: the byte before N / at M must not
          // extend the identifier, or the "match" is a slice of a longer
          // name and the basis is not the entry file.
          let left_ok = n == 0 || !marker_ident_char(String::char_code_at(source, n - 1))
          let right_ok = m == String::length(source) || !marker_ident_char(String::char_code_at(source, m))
          left_ok && right_ok
        } else {
          false
        }
      }
      if span_ok {
        msg
      } else {
        String::concat(String::substring(msg, 0, mi), String::substring(msg, inner_start + close_rel + 1, String::length(msg)))
      }
    }
  }
}

/// FS/build compilation does not yet return the grouped-source snapshot that
/// produced a Throw. Without same-snapshot ownership evidence, keep the culprit
/// name but strip its unproven transport offset (#1596).
export fn verify_culprit_off_marker_fs_fail_closed(msg: String) -> String {
  if String::contains(msg, " [@off=") && String::contains(msg, " (here: the call to '") {
    verify_culprit_off_marker("", msg)
  } else {
    msg
  }
}

/// Verify a culprit marker against the exact grouped-source snapshot consumed
/// by the failing check. The entry must occur exactly once in that snapshot and
/// be the unique reachable source spelling the named whole identifier at the
/// marker span. Missing/duplicate entry identity or a dependency collision is
/// fail-closed: keep the culprit name, but strip the transport marker (#1596).
export fn verify_culprit_off_marker_snapshot(input_path: String, source_groups: Array[(String, Array[(String, String)])], msg: String) -> (String, String) {
  let mut entry_source = ""
  let dep_sources: Array[String] = array_empty()
  let mut entry_count = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == input_path {
        entry_source = source
        entry_count = entry_count + 1
      } else {
        Array::push(dep_sources, source)
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if entry_count != 1 {
    (entry_source, verify_culprit_off_marker("", msg))
  } else {
    let entry_verified = verify_culprit_off_marker(entry_source, msg)
    if !String::contains(entry_verified, " [@off=") {
      (entry_source, entry_verified)
    } else {
      let mut i = 0
      let mut ambiguous = false
      while i < Array::length(dep_sources) && !ambiguous {
        let dep_verified = verify_culprit_off_marker(Array::get(dep_sources, i), msg)
        ambiguous = String::contains(dep_verified, " [@off=")
        i = i + 1
      }
      if ambiguous {
        (entry_source, verify_culprit_off_marker("", msg))
      } else {
        (entry_source, entry_verified)
      }
    }
  }
}

export fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with Exception + Fs {
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)
  let main_stmts = array_empty()
  append_stmt_array(main_stmts, resolved_type_stmts)
  append_non_import_stmts(main_stmts, entry_stmts)
  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
  (bytes, linked_dep_specs)
}

/// Every source the LOADER says this entry compiles, minus the entry itself.
///
/// #1262 follow-up: the two callers below used to re-resolve imports with
/// `collect_linked_dep_inputs_for_stmts`, whose `resolve_import_path` is a
/// plain path join -- it turns `import @vibe/core { ... }` into the filename
/// `@vibe/core.vibe` and the read throws. That made `vibe check` ABORT on any
/// file importing a `@scope/pkg` package (verified on the committed seed, so
/// it is not new), even though the very same file compiles: the typecheck
/// above already goes through `collect_source_groups_fs`, which does the real
/// store/lib/contract resolution. Two resolution paths, one of them wrong.
///
/// This is the same rule `vibe deps` states: report the loader's own
/// collection rather than a separately-derived graph, because a derived graph
/// drifts from real resolution and then under-reports silently.
fn resolved_dep_sources(input_path: String, groups: Array[(String, Array[(String, String)])]) -> Array[String] {
  let out: Array[String] = array_empty()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_group_name, members) = Array::get(groups, gi)
    let mut mi = 0
    while mi < Array::length(members) {
      let (path, source) = Array::get(members, mi)
      if path == input_path {
        ()
      } else {
        Array::push(out, source)
      }
      mi = mi + 1
    }
    gi = gi + 1
  }
  out
}

/// Gate v2 (#492): parse + typecheck only, with imports linked. The checker
/// knows builtin signatures, so this surfaces REAL language/checker
/// expressiveness gaps (parse errors, type errors, genuine unknown names)
/// WITHOUT the codegen builtin-body-linking confounder that makes the `debug`
/// mode emit spurious `undefined variable: Ns::method`. No wasm is produced.
/// #1536(c)/#1511(b): "typecheck only" no longer means blind to effect-lowering
/// eligibility — check_file_fs_mode below also runs the ADR-0076 prelude
/// (suspend CPS split + evidence-passing migration, shared verbatim with the
/// real compile) on the merged program, so a handle/suspend shape codegen
/// would reject fails here instead of first failing at build/test/doctest.
/// Still no wasm and no builtin-body linking.
export fn check_linked_file(input_path: String) -> Int with Exception + Fs {
  let _groups = check_linked_file_source_groups(input_path)
  0
}

/// Same check, but hands back the source groups it collected so a caller that
/// needs them next (`check_deprecated_warnings_from_source_groups`) does not
/// pay for -- or re-enter -- a second `collect_source_groups_fs`. Re-entering
/// it is not merely wasteful: the second call reads back the persistent
/// source-group cache the first call just wrote, and that round-trip is TAB-
/// hostile (rows are TAB-separated with a fixed field count, so an entry path
/// containing a TAB parses as too many fields -- #1712). Collecting once keeps
/// this lane off that latent bug entirely.
export fn check_linked_file_source_groups(input_path: String) -> Array[(String, Array[(String, String)])] with Exception + Fs {
  // #946(3): parse the entry file OURSELVES first (located + recovering —
  // see the import comment above) so a parse error is reported with an exact
  // `line:col` before any other check runs.
  // #2227: blank `require ... = #pkg:sha1:` pin heads before parsing, the
  // way every build-lane ingestion does (ingest_source_text_fs) -- a pin
  // head is a header directive, not statement grammar, and parsing it raw
  // made `vibe check` report a parse error for a file the build compiles.
  // extract_require_pins blanks to spaces (byte length preserved), so every
  // diagnostic offset below stays exact.
  //
  // #2280: a CONTRACT (`.vpkg`) is not statement grammar -- it is a list of
  // bodyless declarations, and every compile lane reads it through
  // `ingest_source_text_fs`, which replaces it with the generated facade
  // before anything parses it. This lane read the raw bytes and so answered
  // `expected { but got fn` about `lib/@vibe/random/index.vpkg`, a committed
  // contract the build consumes on every run: a diagnostic that asserts
  // something untrue about the file. Ingest contracts here too, so `check`
  // answers about the package the contract describes.
  //
  // Contracts ONLY. `ingest_source_text_fs`'s other branch
  // (`apply_vpkg_directory_shared_imports_fs`) can PREPEND import lines to an
  // ordinary `.vibe` file, which would shift every offset below and mislocate
  // the diagnostics this pre-parse exists to locate exactly.
  let raw_entry_source = Fs::read_file(input_path)
  let entry_source = if is_contract_ext(input_path) {
    ingest_source_text_fs(input_path, raw_entry_source)
  } else {
    let (_, pin_blanked) = extract_require_pins(raw_entry_source)
    pin_blanked
  }
  let (tokens, starts, _ends) = lex_with_offsets(entry_source)
  ingestion_pipeline_telemetry_add(14, 1)
  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)
  if Array::length(parse_diags) > 0 {
    // Each is already a full `line L:col C: msg` string (see the import
    // comment above). Report ALL of them, one per line.
    //
    // #1567: this used to throw only `parse_diags[0]`, on the grounds that
    // one-error-at-a-time was "check's convention" and `vibe diagnostics` was
    // the multi-diagnostic surface. That split is exactly what #1567 is about:
    // the recovering parser has already collected every top-level error by
    // this point, so dropping all but the first made `check` answer a strictly
    // worse version of the same question -- a file with three broken
    // statements took three edit-and-rerun cycles instead of one. The two
    // verbs now agree on COUNT as well as on wording.
    throw(String::join(parse_diags, "\n"))
  } else {
    ()
  }
  // Capture one grouped-source snapshot and pass that exact value through the
  // failing check and culprit ownership proof. Recollecting after Throw would
  // reintroduce #1596's concurrent-edit TOCTOU.
  let source_groups = collect_source_groups_fs(input_path)
  // #946 P1 (Codex, PR #1006): the type-check itself must go through
  // check_file_fs_mode (the fs-mode source-group + db_typecheck_fs pipeline
  // compile_file_fs_mode already relies on for a real compile), NOT
  // collect_linked_dep_inputs_for_stmts + check_program. That "linked"
  // mechanism exists to feed the wasm import-linking codegen boundary: it
  // copies a dependency's SEnum/struct declarations into the checked stmts
  // but never a `let rec fn` signature, so check_program never learned an
  // imported function's real type and a wrong-typed call site (e.g.
  // `f("x")` against `fn f(x: Int)`) typechecked cleanly no matter what was
  // passed — confirmed via a live two-file repro before this fix.
  //
  // The merged stmts check_inline_wasm_fns scans (inline-wasm fns can live in
  // an imported file too) are now built from `source_groups` as well — see
  // `resolved_dep_sources`. That scan is independent of type information.
  handle {
    let _ = check_file_fs_mode_from_source_groups(input_path, source_groups)
    // #1262 follow-up: parse the dependency sources the LOADER resolved
    // (`source_groups`, captured above) instead of re-resolving them. The old
    // second resolution could not express `@scope/pkg` and threw, taking the
    // whole check down with it; and the set scanned here should be the set the
    // build compiles, which is what `source_groups` is by construction.
    let stmts = array_empty()
    let dep_sources = resolved_dep_sources(input_path, source_groups)
    let mut dsi = 0
    while dsi < Array::length(dep_sources) {
      let dep_source = Array::get(dep_sources, dsi)
      let (dep_tokens, dep_starts, _dep_ends) = lex_with_offsets(dep_source)
      ingestion_pipeline_telemetry_add(16, 1)
      // A dependency that does not parse cannot reach here: the typecheck
      // immediately above compiles this same set and would have thrown first.
      let (dep_stmts, _dep_diags) = parse_program_recovering(dep_tokens, dep_starts, dep_source)
      append_stmt_array(stmts, dep_stmts)
      dsi = dsi + 1
    }
    append_stmt_array(stmts, entry_stmts)
    expand_interp_stmts(stmts)
    // #946(3): locate errors against the ENTRY file's own source text. `stmts`
    // is the MERGED entry+deps statement list, so a [@off=N]/by-name location
    // is only exact for errors whose blame is in the entry file itself (the
    // common case, and the one every located-diagnostic regression test
    // exercises); an error rooted in an imported dependency degrades to the
    // unlocated message, same as before this fix, rather than mis-locating it
    // against the wrong file's text.
    match check_inline_wasm_fns(stmts) {
      Some(msg) => throw(locate_type_error(entry_source, msg)),
      None => ()
    }
  } with {
  // #1596: locate only when entry is the unique reachable source matching
  // the culprit/span. A dependency collision keeps the culprit name but
  // drops the potentially false entry location.
  Exception::Throw(msg) => {
    if String::contains(msg, " [@off=") && String::contains(msg, " (here: the call to '") {
      let (snapshot_entry_source, verified) = verify_culprit_off_marker_snapshot(input_path, source_groups, msg)
      throw(locate_type_error(snapshot_entry_source, verified))
    } else {
      // #2198: the missing-Show interpolation throw escapes the desugar
      // (reached via check_file_fs_mode's effect_lowering_prelude, or via
      // expand_interp_stmts below) with no `<path>: ` prefix -- path
      // prefixing lives in check_module_job, which that throw bypasses.
      // Prefix this one message class here; every other message reaching
      // this catch is already path-prefixed by its module job, and
      // prefixing unconditionally would double those.
      //
      // #2244 review (Codex P1): the throw itself carries no source
      // identity -- the desugar ran on the MERGED statements, so the
      // culprit can live in a dependency. Naming the entry file for a
      // dep-file error would be confidently wrong, so the path is added
      // only when exactly one source in the consumed group set resolves
      // the message's [@fn=] anchor (locate_type_error answers with a
      // `line ` prefix only when it does): that source owns the culprit,
      // and its own path and text locate it. Zero owners (the marker was
      // absent or the merge renamed the binder) or two-plus owners (the
      // #1596 same-name collision) fail closed to the unlocated message
      // with no path -- missing information beats misinformation.
      if String::starts_with(msg, "cannot interpolate a value of type `") {
        let mut owner_path = ""
        let mut owner_source = ""
        let mut owners = 0
        let seen_paths: Array[String] = array_empty()
        let mut gi2 = 0
        while gi2 < Array::length(source_groups) {
          let (_gname2, members2) = Array::get(source_groups, gi2)
          let mut mi2 = 0
          while mi2 < Array::length(members2) {
            let (mpath, msource) = Array::get(members2, mi2)
            let mut seen2 = false
            let mut si2 = 0
            while si2 < Array::length(seen_paths) {
              if Array::get(seen_paths, si2) == mpath {
                seen2 = true
              } else {
                ()
              }
              si2 = si2 + 1
            }
            if seen2 {
              ()
            } else {
              Array::push(seen_paths, mpath)
              // #2244 review round 5: a directory-shared vpkg import or a
              // contract facade makes the ingested group source differ
              // from the physical file (imports prepended / contract
              // replaced), so an offset computed on it names a line below
              // the real one. Recover the physical bytes the way
              // checked_entry_source does -- re-ingest and require an
              // exact match -- and drop the candidate (not an owner) when
              // they cannot be verified.
              match owner_locating_source(mpath, msource) {
                Some(mlocating) => if String::starts_with(locate_type_error(mlocating, msg), "line ") {
                  owners = owners + 1
                  owner_path = mpath
                  owner_source = mlocating
                } else {
                  ()
                },
                None => ()
              }
            }
            mi2 = mi2 + 1
          }
          gi2 = gi2 + 1
        }
        if owners == 1 {
          throw(String::concat(owner_path, String::concat(": ", locate_type_error(owner_source, msg))))
        } else {
          // locate against an empty source: the anchor cannot resolve, so
          // this only strips the side marker from the message.
          throw(locate_type_error("", msg))
        }
      } else {
        throw(locate_type_error(entry_source, msg))
      }
    }
  } }
  source_groups
}

/// `#deprecated` warnings for a file that already passed check_linked_file
/// (#1262 / ADR-0101). Markers are collected from the entry file AND every
/// linked dependency file (the same linked_dep_specs set the debug build
/// links); uses are reported for the entry file only, as non-fatal
/// `warning:` lines. A file that fails to parse gets no warnings — the
/// check itself already failed loudly.
export fn check_deprecated_warnings(input_path: String) -> Array[String] with Exception + Fs {
  check_deprecated_warnings_from_source_groups(input_path, collect_source_groups_fs(input_path))
}

/// Redundant owner/member selections in the entry file. The linked checker has
/// already accepted the file before this runs; this is a non-fatal `vibe check`
/// hygiene report with an actionable removal.
export fn check_redundant_import_warnings(input_path: String) -> Array[String] with Exception + Fs {
  let source = Fs::read_file(input_path)
  check_redundant_import_warnings_from_source_groups(input_path, [
    ("entry", [(input_path, source)])
  ])
}

/// The source text an offset-bearing diagnostic may be located against for
/// one (path, source) member of a consumed group set. A plain member locates
/// against its snapshot as-is. A member whose snapshot carries the loader's
/// shared-import or contract-facade transform (imports prepended / contract
/// replaced) must locate against the PHYSICAL file, recovered the same way
/// checked_entry_source recovers the entry: re-ingest the current bytes and
/// require the complete synthetic snapshot to match. None when the physical
/// text cannot be verified -- the caller must then treat the member as
/// unlocatable rather than emit coordinates computed on synthetic text.
fn owner_locating_source(path: String, source: String) -> Option[String] with Exception + Fs {
  if String::starts_with(source, vpkg_shared_import_marker) || String::starts_with(source, contract_facade_marker) {
    if Fs::exists(path) {
      let physical = Fs::read_file(path)
      if source == ingest_source_text_fs(path, physical) {
        Some(physical)
      } else {
        None
      }
    } else {
      None
    }
  } else {
    Some(source)
  }
}

/// The entry's snapshot EXACTLY as the linked check consumed it -- ingested,
/// markers and all, with no remap to the physical file. `checked_entry_source`
/// does that remap so ordinary warnings cite lines a reader can visit; a
/// VERDICT must not, or an inherited `.vpkg` import is invisible to it while
/// the build rejects the same entry.
///
/// Unique-or-nothing, like `checked_entry_source`: describing text that was not
/// the text checked is worse than saying nothing.
fn checked_entry_snapshot(input_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Option[String] {
  let mut found: Option[String] = None
  let mut count = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == input_path {
        found = Some(source)
        count = count + 1
      } else {
        ()
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if count == 1 {
    found
  } else {
    None
  }
}

fn checked_entry_source(input_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Option[String] with Exception + Fs {
  let mut found: Option[String] = None
  let mut count = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == input_path {
        found = Some(source)
        count = count + 1
      } else {
        ()
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if count == 1 {
    match found {
      Some(source) => if String::starts_with(source, vpkg_shared_import_marker) || String::starts_with(source, contract_facade_marker) {
        // The loader prepends inherited `.vpkg` imports or replaces a contract
        // with its generated facade before checking.
        // Warning locations must refer to the physical file. Re-ingest the
        // current bytes and require the complete synthetic snapshot to match;
        // a suffix comparison would accept a file whose leading bytes changed.
        if Fs::exists(input_path) {
          let physical = Fs::read_file(input_path)
          if source == ingest_source_text_fs(input_path, physical) {
            Some(physical)
          } else {
            None
          }
        } else {
          None
        }
      } else {
        Some(source)
      },
      None => None
    }
  } else {
    None
  }
}

//# ADR-0068 single-file scan (#2297)

/// The scan itself now lives in `@vibe/compiler/runtime` (typecheck_fs.vibe),
/// beside `collect_all_diagnostics`, so that every single-file consumer --
/// this lane, `vibe check --single-file --json`, and the live LSP -- inherits
/// one answer instead of the adapter splicing its own into two of them and the
/// third going without.
///
/// These two stay here as the package's declared surface
/// (`lib/@vibe/compiler/index.vpkg`) and as what `cli_adapter.vibe` and the
/// closure lane below already call. Delegation rather than a move of the
/// declarations, so the package contract and every consumer are untouched.
export fn unstable_surface_diagnostics_located(input_path: String, detected: String, located: String) -> Array[String] with Exception {
  unstable_import_diagnostics(input_path, detected, located)
}

export fn unstable_surface_diagnostics(input_path: String, source: String) -> Array[String] with Exception {
  unstable_import_diagnostics(input_path, source, source)
}

/// The BUILD lane's entry point: one file read, no import closure. It used to
/// call `collect_source_groups_fs`, which parses every reachable file a second
/// time purely to find the entry again -- measured as a 1.1% self-compile heap
/// regression that took CI's selfcompile KPI over its +10% ceiling (#2277 CI).
/// Only the entry is scanned, so only the entry needs reading.
/// INGESTED, not raw. The build ingests before it parses, and ingestion blanks
/// the package header -- so a pinned `require @scope/pkg x.y.z = #pkg:sha1:...`
/// line reaches a raw scan with a `#` in it, the lexer refuses it ("unknown #
/// directive"), the parse yields nothing, and the gate goes SILENT while the
/// build compiles the unstable import anyway. Measured: the same file unpinned
/// produced the diagnostic, pinned produced none. That is the two-verbs-
/// disagree defect this gate exists to prevent, reintroduced by reading the
/// file a different way than the build reads it (#2277 review).
/// The CLOSURE lane: every module the compile actually loaded, not just the
/// entry (#2284).
///
/// The entry-only scan let a sibling carry the import -- `main.vibe` importing
/// `./worker.vibe`, with the concurrency in `worker.vibe`, is the normal shape
/// of a project, so the boundary was absent for exactly the structure it most
/// needed to cover. Measured before this: that two-file program built an
/// artifact and checked clean with no opt-in.
///
/// The loader records candidates as it ingests (`unstable_candidates`), so this
/// costs no extra traversal -- the alternative, calling `collect_source_groups_fs`
/// a second time, was measured as a 1.1% self-compile heap regression that put
/// the selfcompile KPI over its ceiling.
///
/// Each candidate is confirmed by the same token scan the entry lane uses, so a
/// module that merely MENTIONS the package in a comment yields nothing. The
/// diagnostic names the file that actually spells the import, which is the edit
/// point even when that file is a dependency the reader did not write --
/// `VIBE_UNSTABLE=1` stays the escape hatch either way.
export fn check_unstable_surface_warnings_from_closure() -> Array[String] with Exception + Fs {
  let out = array_empty()
  let seen: Array[String] = array_empty()
  let candidates = unstable_candidates()
  let mut i = 0
  while i < Array::length(candidates) {
    let (path, ingested) = Array::get(candidates, i)
    let located = handle {
      Fs::read_file(path)
    } with { Exception::Throw(_) => ingested }
    let diags = handle {
      unstable_surface_diagnostics_located(path, ingested, located)
    } with { Exception::Throw(_) => array_empty() }
    let mut j = 0
    while j < Array::length(diags) {
      let diag = Array::get(diags, j)
      let report = String::concat(path, String::concat(": ", diag))
      // #2289: DEDUPE, on two axes, because printing every report (rather than
      // just the first) exposed two different floods.
      //
      // 1. The loader ingests a module more than once per compile (header
      //    cache, source-group collection) and records a candidate each time,
      //    so one file's single import arrived three times.
      // 2. An INHERITED import is one edit -- the directory's index.vpkg --
      //    but ingestion prepends it to every sibling, so a package with N
      //    members reported it N times. Measured on a 3-member package: ten
      //    reports for one `import` line.
      //
      // So an inherited report keys by (DIRECTORY, diagnostic): the file
      // differs per sibling, the edit does not. Everything else keys by
      // (file, diagnostic), which keeps two siblings that each physically
      // spell the import reporting separately, and keeps a file's own
      // inherited and physical reports distinct -- they differ in the note.
      let key = if String::index_of(diag, unstable_inherited_marker) >= 0 {
        String::concat("inherited\n", String::concat(dir_of_path(path), String::concat("\n", diag)))
      } else {
        String::concat("own\n", report)
      }
      if unstable_index_of_str(seen, key) < 0 {
        Array::push(seen, key)
        Array::push(out, report)
      } else {
        ()
      }
      j = j + 1
    }
    i = i + 1
  }
  out
}

/// Clear the record before a compile. The unit-test batch compiles many files
/// in one long-lived daemon, so a record left standing would report a previous
/// file's dependency against the next one.
export fn unstable_closure_reset() -> Unit {
  unstable_candidates_reset()
}

export fn check_unstable_surface_warnings_from_path(input_path: String) -> Array[String] with Exception + Fs {
  handle {
    unstable_surface_diagnostics_located(input_path, ingest_source_text_fs(input_path, Fs::read_file(input_path)), Fs::read_file(input_path))
  } with {
  // An unreadable or uningestable entry is the compile's error to report, in
  // its own words.
  Exception::Throw(_) => array_empty() }
}

/// Redundant import warnings derived from the exact source snapshot consumed
/// by the successful linked check. Missing or duplicate entry identity is
/// fail-closed: no warning is safer than describing unchecked contents.
export fn check_redundant_import_warnings_from_source_groups(input_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Array[String] with Exception + Fs {
  let source = match checked_entry_source(input_path, source_groups) {
    Some(snapshot) => snapshot,
    None => return array_empty()
  }
  match checked_warning_stmts(input_path, source) {
    Some(stmts) => {
      let rows = detect_redundant_namespace_imports(stmts)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(rows) {
        let (_, _, msg) = Array::get(rows, i)
        Array::push(out, locate_type_error(source, String::concat("warning: ", msg)))
        i = i + 1
      }
      out
    },
    None => array_empty()
  }
}

/// The same warnings, from source groups the caller already has. `vibe check`
/// uses this form so the whole lane collects exactly once.
export fn check_deprecated_warnings_from_source_groups(input_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Array[String] with Exception + Fs {
  let entry_source = match checked_entry_source(input_path, source_groups) {
    Some(snapshot) => snapshot,
    None => return array_empty()
  }
  ingestion_pipeline_telemetry_add(17, 1)
  let entry_stmts = match checked_warning_stmts(input_path, entry_source) {
    Some(stmts) => stmts,
    None => return array_empty()
  }
  // #1262 follow-up: markers come from the LOADER's resolved set, not from a
  // second path-joining resolver. The old collection could not resolve
  // `@scope/pkg`, so a deprecated alias published by a PACKAGE -- which is
  // every alias the ADR-0100 (3) collection rename shipped -- was invisible
  // here and the migration warning this function promises never appeared.
  let dep_sources = resolved_dep_sources(input_path, source_groups)
  // A `.vpkg` reaches source_groups as a generated facade (and its type
  // aliases as a materialized types module). `#deprecated` on a contract
  // type alias lives only in the on-disk file, so re-read those paths.
  append_raw_vpkg_dep_sources(input_path, source_groups, dep_sources)
  // Codex review (PR #1713, P2): the closure above is deliberately WIDE -- it
  // has to be, because a package publishes its markers from a sibling file the
  // entry never names. Wide marker COLLECTION plus a token-level scanner would
  // be too wide the other way, though: a file importing something unrelated
  // from `@vibe/core` and declaring its own `HashMap::new_string` would be told
  // to use `MutMap::new_string`. So a dependency's marker only counts for a
  // name the entry actually IMPORTED. Markers the entry declares itself still
  // count unconditionally (a file deprecating its own helper needs no import).
  deprecated_warning_lines_visible(entry_source, dep_sources, Some(entry_imported_names(entry_stmts)))
}

/// Re-read every on-disk `.vpkg` in `groups` (except the entry itself) so
/// `#deprecated` markers on contract-only type aliases are visible to the
/// token scanner. The generated facade in `groups` does not preserve them.
fn append_raw_vpkg_dep_sources(input_path: String, groups: Array[(String, Array[(String, String)])], out: Array[String]) -> Unit with Fs {
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_g, members) = Array::get(groups, gi)
    let mut mi = 0
    while mi < Array::length(members) {
      let (path, _source) = Array::get(members, mi)
      if path != input_path && String::ends_with(path, ".vpkg") && Fs::exists(path) {
        Array::push(out, Fs::read_file(path))
      } else {
        ()
      }
      mi = mi + 1
    }
    gi = gi + 1
  }
}

/// Every name the entry selects from an import / re-export, in source order.
/// The alias half of `import p { old as new }` is intentionally not included:
/// the entry's later uses spell `new`, and the `old` at the import site is
/// itself a use worth warning about.
fn entry_imported_names(entry_stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = array_empty()
  let mut i = 0
  while i < Array::length(entry_stmts) {
    match Array::get(entry_stmts, i) {
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let iname = Array::get(items, j).name
          Array::push(out, iname)
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let iname = Array::get(items, j).name
          Array::push(out, iname)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

//# Release wasm stripping (#1100 size)

/// Read one unsigned LEB128 at `i`; returns (value, next_index) or (-1, end)
/// when malformed/truncated so callers can bail out to the untouched input.
fn strip_read_uleb(wasm: Bytes, start: Int, end: Int) -> (Int, Int) {
  let mut i = start
  let mut v = 0
  let mut shift = 0
  while i < end && shift < 35 {
    let b = Bytes::get(wasm, i)
    v = v|((b&127)<<shift)
    i = i + 1
    if (b&128) == 0 {
      return (v, i)
    } else {
      shift = shift + 7
    }
  }
  (0 - 1, end)
}

fn strip_bytes_range_eq_str(wasm: Bytes, start: Int, n: Int, s: String) -> Bool {
  if n != String::length(s) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(wasm, start + i) != String::char_code_at(s, i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn strip_bytes_range_starts_with(wasm: Bytes, start: Int, n: Int, prefix: String) -> Bool {
  let plen = String::length(prefix)
  if n < plen {
    false
  } else {
    strip_bytes_range_eq_str(wasm, start, plen, prefix)
  }
}

fn strip_push_range(out: Bytes, wasm: Bytes, start: Int, end: Int) -> Unit {
  let mut i = start
  while i < end {
    Bytes::push(out, Bytes::get(wasm, i))
    i = i + 1
  }
}

fn strip_push_uleb(out: Bytes, value: Int) -> Unit {
  let mut v = value
  let mut more = true
  while more {
    let b = v&127
    v = v>>7
    if v == 0 {
      Bytes::push(out, b)
      more = false
    } else {
      Bytes::push(out, b|128)
    }
  }
}

/// Executable-output post-pass: drop the `name` custom section (debug info)
/// and/or filter the export section down to the entries an executable's
/// runners actually address by name — the entry function, `_start`,
/// `cli_main`, per-block `__bench_*`/`__test_*` exports, and every non-function
/// export (memory / `__heap_ptr` global / `error` tag). Everything else is a
/// module-linking artifact (`*_exp_lib__*` mangled names from the flat module
/// source) that nothing external can reasonably call. Section-level surgery
/// only: removing a custom section or export ENTRIES never renumbers any
/// index, so the code/table/elem sections are byte-identical. Any parse
/// anomaly returns the input untouched. Component/library/test paths must NOT
/// come through here — components lift core exports by name and `vibe test`
/// tooling reads `__test_*` frames from the name section (callers gate on
/// entry_name/env, see strip_executable_wasm_env).
export fn strip_executable_wasm(wasm: Bytes, entry_name: String, strip_names: Bool, filter_exports: Bool) -> Bytes {
  if !strip_names && !filter_exports {
    return wasm
  } else {
    ()
  }
  let len = Bytes::length(wasm)
  if len < 8 {
    return wasm
  } else {
    ()
  }
  let out = Bytes::new()
  strip_push_range(out, wasm, 0, 8)
  let mut i = 8
  let mut ok = true
  while ok && i < len {
    let sid = Bytes::get(wasm, i)
    let (ssz, payload_start) = strip_read_uleb(wasm, i + 1, len)
    if ssz < 0 || payload_start + ssz > len {
      ok = false
    } else {
      let payload_end = payload_start + ssz
      let mut handled = false
      if sid == 0 && strip_names {
        // custom section: drop iff its name is exactly "name"
        let (cn_len, cn_start) = strip_read_uleb(wasm, payload_start, payload_end)
        if cn_len >= 0 && cn_start + cn_len <= payload_end {
          if strip_bytes_range_eq_str(wasm, cn_start, cn_len, "name") {
            handled = true
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      if !handled && sid == 7 && filter_exports {
        let (exp_count, cur0) = strip_read_uleb(wasm, payload_start, payload_end)
        if exp_count >= 0 {
          let kept = Bytes::new()
          let mut kept_count = 0
          let mut cur = cur0
          let mut ei = 0
          let mut parse_ok = true
          while parse_ok && ei < exp_count {
            let entry_start = cur
            let (nlen, nstart) = strip_read_uleb(wasm, cur, payload_end)
            if nlen < 0 || nstart + nlen + 1 > payload_end {
              parse_ok = false
            } else {
              let kind = Bytes::get(wasm, nstart + nlen)
              let (_eidx, entry_end) = strip_read_uleb(wasm, nstart + nlen + 1, payload_end)
              if entry_end > payload_end {
                parse_ok = false
              } else {
                let keep = kind != 0 || strip_bytes_range_eq_str(wasm, nstart, nlen, entry_name) || strip_bytes_range_eq_str(wasm, nstart, nlen, "_start") || strip_bytes_range_eq_str(wasm, nstart, nlen, "cli_main") || strip_bytes_range_starts_with(wasm, nstart, nlen, "__bench_") || strip_bytes_range_starts_with(wasm, nstart, nlen, "__test_")
                if keep {
                  strip_push_range(kept, wasm, entry_start, entry_end)
                  kept_count = kept_count + 1
                } else {
                  ()
                }
                cur = entry_end
                ei = ei + 1
              }
            }
          }
          if parse_ok {
            Bytes::push(out, 7)
            let sec_content = Bytes::new()
            strip_push_uleb(sec_content, kept_count)
            Bytes::append(sec_content, kept)
            strip_push_uleb(out, Bytes::length(sec_content))
            Bytes::append(out, sec_content)
            handled = true
          } else {
            ok = false
          }
        } else {
          ok = false
        }
      } else {
        ()
      }
      if ok && !handled {
        strip_push_range(out, wasm, i, payload_end)
      } else {
        ()
      }
      i = payload_end
    }
  }
  if ok {
    out
  } else {
    wasm
  }
}

/// Env-gated policy wrapper shared by the CLI adapter (env-mode interface) and
/// the command dispatch layer: executables (a real entry name) are stripped by
/// default; `__no_entry__` builds (test/bench/serve cores) are left untouched
/// because their tooling reads `__test_*` name-section frames, greps the
/// binary for `__test_`, enumerates `__bench_*` exports, or lifts component
/// exports by name. VIBE_WASM_NAMES=1 keeps the name section (profiling /
/// trap-backtrace workflows); VIBE_WASM_KEEP_EXPORTS=1 keeps every export.
export fn strip_executable_wasm_env(wasm: Bytes, entry_name: String) -> Bytes with Env {
  if entry_name == "__no_entry__" {
    wasm
  } else {
    strip_executable_wasm(wasm, entry_name, Env::get("VIBE_WASM_NAMES") != "1", Env::get("VIBE_WASM_KEEP_EXPORTS") != "1")
  }
}

export fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with Exception + Fs {
  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)
  Fs::write_bytes(output_path, entry_bytes)
  let output_dir = linked_output_dir(output_path)
  let mut i = 0
  while i < Array::length(linked_dep_specs) {
    let (module_name, dep_path) = Array::get(linked_dep_specs, i)
    let lib_output_path = String::concat(output_dir, String::concat("/", String::concat(module_name, ".wasm")))
    let lib_bytes = compile_debug_library(dep_path)
    Fs::write_bytes(lib_output_path, lib_bytes)
    i = i + 1
  }
}
