//# Imports

import ./loader_hotspot_probe.vibe {
  load_loader_hotspot_fixture,
  load_loader_hotspot_indexed_fixture,
  probe_loader_manifest_groups_encoded,
  probe_loader_manifest_groups_indexed_encoded_with_source_index,
  probe_loader_manifest_groups_linear_encoded,
  probe_loader_manifest_list_count,
  probe_loader_manifest_list_filter_indexed_count_with_index,
  probe_loader_manifest_list_filter_linear_count
}

//# Misc

/// #859: top-level tuple-pattern let is a rejected parse error (the
/// destructure sugar only lowers correctly inside a function/block body);
/// these globals are shared across several `bench` blocks below, so they
/// must stay module-level -- expanded into individual field-projection
/// `let`s instead of a single pattern-let.
let hotspot_fixture = load_loader_hotspot_fixture()
let base_dir = hotspot_fixture.0
let manifest_rows = hotspot_fixture.1
let preloaded_sources = hotspot_fixture.2
let needed_sources = hotspot_fixture.3
let needed_paths = hotspot_fixture.4

let indexed_hotspot_fixture = load_loader_hotspot_indexed_fixture()
let needed_path_index = indexed_hotspot_fixture.5
let needed_source_index = indexed_hotspot_fixture.6

bench "loader_manifest_list" {
  let _ = handle {
    probe_loader_manifest_list_count()
  } with { Exception::Throw(_) => 0 }
}

bench "loader_manifest_list_filter_linear" {
  let _ = probe_loader_manifest_list_filter_linear_count(preloaded_sources, needed_paths)
}

bench "loader_manifest_list_filter_indexed" {
  let _ = probe_loader_manifest_list_filter_indexed_count_with_index(preloaded_sources, needed_path_index)
}

bench "loader_manifest_groups" {
  let _ = handle {
    probe_loader_manifest_groups_encoded()
  } with { Exception::Throw(_) => 0 }
}

bench "loader_manifest_groups_linear" {
  let _ = probe_loader_manifest_groups_linear_encoded(base_dir, manifest_rows, needed_sources)
}

bench "loader_manifest_groups_indexed" {
  let _ = probe_loader_manifest_groups_indexed_encoded_with_source_index(base_dir, manifest_rows, needed_source_index)
}
