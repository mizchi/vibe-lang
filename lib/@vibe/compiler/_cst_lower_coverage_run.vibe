  ]))
  let _e15i = lower_expr(CNode(NBinOpExpr, [
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CToken(TAnd),
    CNode(NBoolExpr, [CToken(TIdent("false"))])
  ]))
  let _e15j = lower_expr(CNode(NBinOpExpr, [
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CToken(TOr),
    CNode(NBoolExpr, [CToken(TIdent("false"))])
  ]))
  let _e15k = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TBitAnd),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15l = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPercent),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15m = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TLte),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15n = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TGte),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15o = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
