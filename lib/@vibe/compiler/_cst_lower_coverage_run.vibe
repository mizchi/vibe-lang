  ]))
  let _e15q = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TLShift),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15r = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRShift),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15s = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPipeGt),
    CNode(NIdentExpr, [CToken(TIdent("f"))])
  ]))
  let _e16a = lower_expr(CNode(NUnaryOpExpr, [
    CToken(TMinus),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _e16b = lower_expr(CNode(NUnaryOpExpr, [
    CToken(TNot),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ]))
  let _e17 = lower_expr(CNode(NCallExpr, [
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRParen)
  ]))
  let _e18 = lower_expr(CNode(NDotExpr, [
    CNode(NIdentExpr, [CToken(TIdent("obj"))]),
    CToken(TDot),
    CToken(TIdent("field"))
  ]))
  let _e19 = lower_expr(CNode(NMatchExpr, [
    CToken(TMatch),
    CNode(NIdentExpr, [CToken(TIdent("x"))]),
    CToken(TLBrace),
    CNode(NMatchArm, [
      CNode(NIntPat, [CToken(TInt(1))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("one"))])
    ]),
    CNode(NMatchArm, [
      CNode(NWildPat, [CToken(TIdent("_"))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("other"))])
    ]),
    CToken(TRBrace)
  ]))
  let _e20 = lower_expr(CNode(NWhileExpr, [
    CToken(TWhile),
    CNode(NBoolExpr, [CToken(TIdent("false"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ]))
  let _e21a = lower_expr(CNode(NBreakExpr, [CToken(TBreak)]))
  let _e21b = lower_expr(CNode(NBreakExpr, [
    CToken(TBreak),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _e22 = lower_expr(CNode(NContinueExpr, [CToken(TContinue)]))
  let _e23 = lower_expr(CNode(NThrowExpr, [
    CToken(TThrow),
    CNode(NStringExpr, [CToken(TString("err"))])
  ]))
  let _e24 = lower_expr(CNode(NAssignExpr, [
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(10))]),
    CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  ]))
  let _e25 = lower_expr(CNode(NAssignOpExpr, [
    CToken(TIdent("x")),
    CToken(TPlusEq),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  ]))
  let _e26 = lower_expr(CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [CToken(TIdent("xs"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ]))
  let _e27 = lower_expr(CNode(NFnExpr, [
    CToken(TLParen),
    CNode(NParam, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NNameType, [CToken(TIdent("Int"))])
    ]),
    CToken(TRParen),
    CToken(TThinArrow),
    CNode(NIntExpr, [CToken(TInt(0))])
  ]))
  let _e28 = lower_expr(CNode(NHandleExpr, [
    CToken(THandle),
    CNode(NIntExpr, [CToken(TInt(0))]),
    CNode(NEffectClause, [
      CNode(NWildPat, [CToken(TIdent("_"))]),
      CToken(TArrow),
      CNode(NIntExpr, [CToken(TInt(1))])
    ])
  ]))
  let _e29 = lower_expr(CNode(NLabeledArgExpr, [
    CToken(TIdent("label")),
    CToken(TColon),
    CToken(TIdent("name")),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _e30 = lower_expr(CNode(NRecordExpr, [
    CToken(TLBrace),
    CNode(NRecordField, [CToken(TIdent("x"))]),
    CToken(TRBrace)
  ]))
  0
}

fn run_lower_stmts() -> Int with Exception {
  let _s1 = lower_stmt(CNode(NLetStmt, [
    CToken(TLet),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(42))])
  ]))
  let _s2 = lower_stmt(CNode(NLetStmt, [
    CToken(TExport),
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CToken(TEq),
    CNode(NIdentExpr, [CToken(TIdent("f"))])
  ]))
  let _s3 = lower_stmt(CNode(NLetMutStmt, [
    CToken(TLet),
    CToken(TMut),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(0))])
  ]))
  let _s4 = lower_stmt(CNode(NEnumStmt, [
    CToken(TExport),
    CToken(TEnum),
    CToken(TIdent("Color")),
    CToken(TLBrace),
    CNode(NEnumVariant, [CToken(TIdent("Red"))]),
    CNode(NEnumVariant, [CToken(TIdent("Blue"))]),
    CToken(TRBrace)
  ]))
  let _s4b = lower_stmt(CNode(NSuberrorStmt, [
    CToken(TSuberror),
    CToken(TIdent("MyErr")),
    CToken(TLBrace),
    CNode(NEnumVariant, [CToken(TIdent("E1"))]),
    CToken(TRBrace)
  ]))
  let _s5 = lower_stmt(CNode(NStructStmt, [
    CToken(TStruct),
    CToken(TIdent("Point")),
    CToken(TLBrace),
    CNode(NStructField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NNameType, [CToken(TIdent("Int"))])
    ]),
    CNode(NStructField, [
      CToken(TIdent("y")),
      CToken(TColon),
      CNode(NNameType, [CToken(TIdent("Int"))])
    ]),
    CToken(TRBrace)
  ]))
  let _s6 = lower_stmt(CNode(NTypeAliasStmt, [
    CToken(TType),
    CToken(TIdent("Num")),
    CToken(TEq),
    CNode(NNameType, [CToken(TIdent("Int"))])
  ]))
  let _s7 = lower_stmt(CNode(NTraitStmt, [
    CToken(TTrait),
    CToken(TIdent("Show")),
    CToken(TLBrace),
    CToken(TIdent("show")),
    CToken(TRBrace)
  ]))
  let _s8 = lower_stmt(CNode(NImplStmt, [
    CToken(TImpl),
    CToken(TIdent("Show")),
    CToken(TFor),
    CToken(TIdent("Int"))
  ]))
  let _s9 = lower_stmt(CNode(NExternLetStmt, [
    CToken(TDeclare),
    CToken(TIdent("print")),
    CToken(TColon),
    CNode(NNameType, [CToken(TIdent("String"))])
  ]))
  let _s10 = lower_stmt(CNode(NImportStmt, [
    CToken(TImport),
    CToken(TString("./foo.vibe")),
    CToken(TLBrace),
    CNode(NImportItem, [CToken(TIdent("bar"))]),
    CToken(TRBrace)
  ]))
  let _s11 = lower_stmt(CNode(NTestStmt, [
    CToken(TTest),
    CToken(TString("my test")),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _s12 = lower_stmt(CNode(NBenchStmt, [
    CToken(TBench),
    CToken(TString("my bench")),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _s13 = lower_stmt(CNode(NExprStmt, [CNode(NIntExpr, [CToken(TInt(42))])]))
  let _s14 = lower_stmt(CNode(NExportStmt, [
    CToken(TExport),
    CToken(TIdent("foo")),
    CToken(TIdent("bar"))
  ]))
  let _s15 = lower_stmt(CNode(NReExportStmt, [
    CToken(TExport),
    CToken(TString("./foo.vibe")),
    CToken(TLBrace),
    CNode(NImportItem, [CToken(TIdent("baz"))]),
    CToken(TRBrace)
  ]))
  let _s16 = lower_stmt(CNode(NModuleStmt, [
    CToken(TExport),
    CToken(TModule),
    CToken(TIdent("M")),
    CToken(TLBrace),
    CNode(NExprStmt, [CNode(NIntExpr, [CToken(TInt(1))])]),
    CToken(TRBrace)
  ]))
  0
}

fn run_lower_types() -> Int with Exception {
  let _t1 = lower_type(CNode(NNameType, [CToken(TIdent("Int"))]))
  let _t2 = lower_type(CNode(NUnitType, [CToken(TLParen), CToken(TRParen)]))
  let _t3 = lower_type(CNode(NTupleType, [
    CToken(TLParen),
    CNode(NNameType, [CToken(TIdent("Int"))]),
    CToken(TComma),
    CNode(NNameType, [CToken(TIdent("String"))]),
    CToken(TRParen)
  ]))
  let _t4 = lower_type(CNode(NFnType, [
    CToken(TLParen),
    CNode(NNameType, [CToken(TIdent("Int"))]),
    CToken(TRParen),
    CToken(TThinArrow),
    CNode(NNameType, [CToken(TIdent("String"))])
  ]))
  let _t5 = lower_type(CNode(NAppType, [
    CToken(TIdent("Array")),
    CToken(TLBracket),
    CNode(NNameType, [CToken(TIdent("Int"))]),
    CToken(TRBracket)
  ]))
  0
}

fn run_lower_source() -> Int with Exception {
  let root = CNode(NSourceFile, [
    CNode(NExprStmt, [CNode(NIntExpr, [CToken(TInt(1))])]),
    CNode(NExprStmt, [CNode(NIntExpr, [CToken(TInt(2))])])
  ])
  let stmts = lower_source_file(root)
  Array::length(stmts)
}

fn run_cst_accessors() -> Int {
  let mut sum = 0
  sum = sum + node_kind_tag(NSourceFile)
  sum = sum + node_kind_tag(NLetStmt)
  sum = sum + node_kind_tag(NLetMutStmt)
  sum = sum + node_kind_tag(NEnumStmt)
  sum = sum + node_kind_tag(NStructStmt)
  sum = sum + node_kind_tag(NTypeAliasStmt)
  sum = sum + node_kind_tag(NTraitStmt)
  sum = sum + node_kind_tag(NImplStmt)
  sum = sum + node_kind_tag(NExternLetStmt)
  sum = sum + node_kind_tag(NImportStmt)
  sum = sum + node_kind_tag(NTestStmt)
  sum = sum + node_kind_tag(NBenchStmt)
  sum = sum + node_kind_tag(NExprStmt)
  sum = sum + node_kind_tag(NExportStmt)
  sum = sum + node_kind_tag(NReExportStmt)
  sum = sum + node_kind_tag(NModuleStmt)
  sum = sum + node_kind_tag(NSuberrorStmt)
  sum = sum + node_kind_tag(NIntExpr)
  sum = sum + node_kind_tag(NFloatExpr)
  sum = sum + node_kind_tag(NStringExpr)
  sum = sum + node_kind_tag(NBoolExpr)
  sum = sum + node_kind_tag(NIdentExpr)
  sum = sum + node_kind_tag(NUnitExpr)
  sum = sum + node_kind_tag(NTupleExpr)
  sum = sum + node_kind_tag(NArrayExpr)
  sum = sum + node_kind_tag(NRecordExpr)
  sum = sum + node_kind_tag(NRecordField)
  sum = sum + node_kind_tag(NIfExpr)
  sum = sum + node_kind_tag(NLetExpr)
  sum = sum + node_kind_tag(NLetRecExpr)
  sum = sum + node_kind_tag(NLetMutExpr)
  sum = sum + node_kind_tag(NAssignExpr)
  sum = sum + node_kind_tag(NAssignOpExpr)
  sum = sum + node_kind_tag(NSeqExpr)
  sum = sum + node_kind_tag(NMatchExpr)
  sum = sum + node_kind_tag(NHandleExpr)
  sum = sum + node_kind_tag(NWhileExpr)
  sum = sum + node_kind_tag(NForInExpr)
  sum = sum + node_kind_tag(NCallExpr)
  sum = sum + node_kind_tag(NBinOpExpr)
  sum = sum + node_kind_tag(NUnaryOpExpr)
  sum = sum + node_kind_tag(NFnExpr)
  sum = sum + node_kind_tag(NDotExpr)
  sum = sum + node_kind_tag(NThrowExpr)
  sum = sum + node_kind_tag(NBreakExpr)
  sum = sum + node_kind_tag(NContinueExpr)
  sum = sum + node_kind_tag(NLabeledArgExpr)
  sum = sum + node_kind_tag(NWildPat)
  sum = sum + node_kind_tag(NBindPat)
  sum = sum + node_kind_tag(NIntPat)
  sum = sum + node_kind_tag(NStringPat)
  sum = sum + node_kind_tag(NBoolPat)
  sum = sum + node_kind_tag(NCtorPat)
  sum = sum + node_kind_tag(NTuplePat)
  sum = sum + node_kind_tag(NOrPat)
  sum = sum + node_kind_tag(NMatchArm)
  sum = sum + node_kind_tag(NNameType)
  sum = sum + node_kind_tag(NAppType)
  sum = sum + node_kind_tag(NFnType)
  sum = sum + node_kind_tag(NTupleType)
  sum = sum + node_kind_tag(NUnitType)
  sum = sum + node_kind_tag(NParam)
  sum = sum + node_kind_tag(NTypeParam)
  sum = sum + node_kind_tag(NVariant)
  sum = sum + node_kind_tag(NEnumVariant)
  sum = sum + node_kind_tag(NStructField)
  sum = sum + node_kind_tag(NImportItem)
  sum = sum + node_kind_tag(NEffectClause)
  sum = sum + node_kind_tag(NError)
  let _eq1 = node_kind_eq(NIntExpr, NIntExpr)
  let _eq2 = node_kind_eq(NIntExpr, NStringExpr)
  let _k1 = cst_kind(CNode(NIntExpr, [CToken(TInt(1))]))
  let _k2 = cst_kind(CToken(TInt(1)))
  let _k3 = cst_kind(CError("x"))
  let _c1 = cst_children(CNode(NIntExpr, [CToken(TInt(1))]))
  let _c2 = cst_children(CToken(TInt(1)))
  let kids = [
    CToken(TLet),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CNode(NStringExpr, [CToken(TString("x"))])
  ]
  let _f1 = cst_find(kids, NIntExpr, 0)
  let _f2 = cst_find(kids, NFloatExpr, 0)
  let _ft1 = cst_find_token(kids, 0)
  let _ft2 = cst_find_token([CNode(NIntExpr, [CToken(TInt(1))])], 0)
  let mixed = [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CNode(NStringExpr, [CToken(TString("x"))])
  ]
  let _fil = cst_filter(mixed, NIntExpr)
  let _cn = cst_child_nodes([
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRParen)
  ])
  let _ct = cst_tokens([
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRParen)
  ])
  sum
}

fn try_lower_pat_error(node: CstChild) -> Int {
  handle {
    let _r = lower_pat(node)
    0
  } with Exception {
    Throw(_) => 1
  }
}

fn try_lower_expr_error(node: CstChild) -> Int {
  handle {
    let _r = lower_expr(node)
    0
  } with Exception {
    Throw(_) => 1
  }
}

fn try_lower_stmt_error(node: CstChild) -> Int {
  handle {
    let _r = lower_stmt(node)
    0
  } with Exception {
    Throw(_) => 1
  }
}

fn try_lower_type_error(node: CstChild) -> Int {
  handle {
    let _r = lower_type(node)
    0
  } with Exception {
    Throw(_) => 1
  }
}

fn run_error_paths() -> Int {
  let mut errors = 0
  errors = errors + try_lower_expr_error(CToken(TInt(1)))
  errors = errors + try_lower_expr_error(CNode(NError, [CToken(TInt(1))]))
  errors = errors + try_lower_expr_error(CNode(NIntExpr, [CToken(TIdent("x"))]))
  errors = errors + try_lower_expr_error(CNode(NFloatExpr, [CToken(TIdent("x"))]))
  errors = errors + try_lower_expr_error(CNode(NStringExpr, [CToken(TInt(1))]))
  errors = errors + try_lower_expr_error(CNode(NBoolExpr, [CToken(TInt(1))]))
  errors = errors + try_lower_expr_error(CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ]))
  errors = errors + try_lower_expr_error(CNode(NLetRecExpr, [
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  errors = errors + try_lower_expr_error(CNode(NAssignExpr, [
    CToken(TIdent("x"))
  ]))
  errors = errors + try_lower_expr_error(CNode(NAssignOpExpr, [
    CToken(TIdent("x"))
  ]))
  errors = errors + try_lower_expr_error(CNode(NSeqExpr, [
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  errors = errors + try_lower_expr_error(CNode(NWhileExpr, [
    CToken(TWhile),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ]))
  errors = errors + try_lower_expr_error(CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [CToken(TIdent("xs"))])
  ]))
  errors = errors + try_lower_expr_error(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPlus)
  ]))
  errors = errors + try_lower_expr_error(CNode(NUnaryOpExpr, [CToken(TMinus)]))
  errors = errors + try_lower_expr_error(CNode(NDotExpr, [
    CToken(TDot),
    CToken(TIdent("f"))
  ]))
  errors = errors + try_lower_expr_error(CNode(NThrowExpr, [CToken(TThrow)]))
  errors = errors + try_lower_expr_error(CNode(NLabeledArgExpr, [
    CToken(TIdent("x"))
  ]))
  errors = errors + try_lower_expr_error(CNode(NLetExpr, [
    CToken(TLet),
    CToken(TIdent("x"))
  ]))
  errors = errors + try_lower_expr_error(CNode(NLetMutExpr, [
    CToken(TLet),
    CToken(TMut),
    CToken(TIdent("x"))
  ]))
  let _e_assign1 = handle {
    let _r = lower_expr(CNode(NAssignExpr, [
      CToken(TIdent("x")),
      CToken(TEq),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  errors = errors + _e_assign1
  let _e_aop1 = handle {
    let _r = lower_expr(CNode(NAssignOpExpr, [
      CToken(TIdent("x")),
      CToken(TMinusEq),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  errors = errors + try_lower_pat_error(CToken(TInt(1)))
  errors = errors + try_lower_pat_error(CNode(NError, [CToken(TInt(1))]))
  errors = errors + try_lower_pat_error(CNode(NIntPat, [CToken(TIdent("x"))]))
  errors = errors + try_lower_pat_error(CNode(NStringPat, [CToken(TInt(1))]))
  errors = errors + try_lower_pat_error(CNode(NBoolPat, [CToken(TInt(1))]))
  errors = errors + try_lower_pat_error(CNode(NOrPat, [
    CNode(NIntPat, [CToken(TInt(1))])
  ]))
  errors = errors + try_lower_type_error(CToken(TInt(1)))
  errors = errors + try_lower_type_error(CNode(NError, [CToken(TInt(1))]))
  errors = errors + try_lower_type_error(CNode(NFnType, [
    CToken(TLParen),
    CToken(TRParen)
  ]))
  errors = errors + try_lower_stmt_error(CToken(TInt(1)))
  errors = errors + try_lower_stmt_error(CNode(NError, [CToken(TInt(1))]))
  errors = errors + try_lower_stmt_error(CNode(NExprStmt, [CToken(TInt(1))]))
  errors = errors + try_lower_stmt_error(CNode(NTypeAliasStmt, [
    CToken(TType),
    CToken(TIdent("X"))
  ]))
  errors = errors + try_lower_stmt_error(CNode(NImplStmt, [
    CToken(TImpl),
    CToken(TIdent("Show"))
  ]))
  errors = errors + try_lower_stmt_error(CNode(NExternLetStmt, [
    CToken(TDeclare),
    CToken(TIdent("x"))
  ]))
  let _e_let1 = handle {
    let _r = lower_expr(CNode(NLetExpr, [
      CToken(TLet),
      CToken(TIdent("x")),
      CToken(TEq),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_letmut1 = handle {
    let _r = lower_expr(CNode(NLetMutExpr, [
      CToken(TLet),
      CToken(TMut),
      CToken(TIdent("x")),
      CToken(TEq),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_aop2 = handle {
    let _r = lower_expr(CNode(NAssignOpExpr, [
      CToken(TIdent("x")),
      CToken(TStarEq),
      CNode(NIntExpr, [CToken(TInt(2))]),
      CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_aop3 = handle {
    let _r = lower_expr(CNode(NAssignOpExpr, [
      CToken(TIdent("x")),
      CToken(TSlashEq),
      CNode(NIntExpr, [CToken(TInt(2))]),
      CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_aop4 = handle {
    let _r = lower_expr(CNode(NAssignOpExpr, [
      CToken(TIdent("x")),
      CToken(TPercentEq),
      CNode(NIntExpr, [CToken(TInt(2))]),
      CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_imp = handle {
    let _r = lower_stmt(CNode(NImportStmt, [
      CToken(TImport),
      CToken(TString("./bar.vibe")),
      CToken(TLBrace),
      CNode(NImportItem, [
        CToken(TIdent("Foo")),
        CToken(TAs),
        CToken(TIdent("Bar"))
      ]),
      CToken(TRBrace)
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_enum2 = handle {
    let _r = lower_stmt(CNode(NEnumStmt, [
      CToken(TEnum),
      CToken(TIdent("Opt")),
      CToken(TLBrace),
      CNode(NEnumVariant, [
        CToken(TIdent("Some")),
        CToken(TLParen),
        CNode(NNameType, [CToken(TIdent("Int"))]),
        CToken(TRParen)
      ]),
      CNode(NEnumVariant, [CToken(TIdent("None"))]),
      CToken(TRBrace)
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_fn2 = handle {
    let _r = lower_expr(CNode(NFnExpr, [
      CToken(TLt),
      CNode(NTypeParam, [CToken(TIdent("T"))]),
      CToken(TGt),
      CToken(TLParen),
      CNode(NParam, [CToken(TIdent("x"))]),
      CToken(TRParen),
      CNode(NIntExpr, [CToken(TInt(0))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_let_typed = handle {
    let _r = lower_stmt(CNode(NLetStmt, [
      CToken(TLet),
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NNameType, [CToken(TIdent("Int"))]),
      CToken(TEq),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_letmut_typed = handle {
    let _r = lower_stmt(CNode(NLetMutStmt, [
      CToken(TLet),
      CToken(TMut),
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NNameType, [CToken(TIdent("Int"))]),
      CToken(TEq),
      CNode(NIntExpr, [CToken(TInt(0))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _e_cont = handle {
    let _r = lower_expr(CNode(NContinueExpr, [
      CToken(TContinue),
      CNode(NIntExpr, [CToken(TInt(1))]),
      CNode(NIntExpr, [CToken(TInt(2))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_test2 = handle {
    let _r = lower_stmt(CNode(NTestStmt, [
      CToken(TTest),
      CToken(TIdent("unnamed")),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _s_bench2 = handle {
    let _r = lower_stmt(CNode(NBenchStmt, [
      CToken(TBench),
      CToken(TIdent("unnamed")),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]))
    0
  } with Exception {
    Throw(_) => 1
  }
  let _f3 = cst_find([
    CToken(TComma),
    CToken(TPlus),
    CNode(NIntExpr, [CToken(TInt(1))])
  ], NIntExpr, 0)
  let _f4 = cst_find([CToken(TComma)], NIntExpr, 0)
  let _ft3 = cst_find_token([
    CNode(NIntExpr, [CToken(TInt(1))]),
    CNode(NIntExpr, [CToken(TInt(2))])
  ], 0)
  let _fil2 = cst_filter([CToken(TComma), CToken(TPlus)], NIntExpr)
  let _fi_err = handle {
    let _r = lower_expr(CNode(NIdentExpr, [CToken(TInt(1))]))
    0
  } with Exception {
    Throw(_) => 1
  }
  errors = errors + _fi_err
  errors = errors + try_lower_expr_error(CNode(NIntExpr, [CToken(TInt(1))]))
  errors = errors + try_lower_pat_error(CNode(NWildPat, [CToken(TIdent("_"))]))
  errors = errors + try_lower_type_error(CNode(NNameType, [
    CToken(TIdent("Int"))
  ]))
  errors = errors + try_lower_stmt_error(CNode(NExprStmt, [
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let all_kinds = [
    NSourceFile,
    NLetStmt,
    NLetMutStmt,
    NEnumStmt,
    NStructStmt,
    NTypeAliasStmt,
    NTraitStmt,
    NImplStmt,
    NExternLetStmt,
    NImportStmt,
    NTestStmt,
    NBenchStmt,
    NExprStmt,
    NExportStmt,
    NReExportStmt,
    NModuleStmt,
    NSuberrorStmt,
    NIntExpr,
    NFloatExpr,
    NStringExpr,
    NBoolExpr,
    NIdentExpr,
    NUnitExpr,
    NTupleExpr,
    NArrayExpr,
    NRecordExpr,
    NRecordField,
    NIfExpr,
    NLetExpr,
    NLetRecExpr,
    NLetMutExpr,
    NAssignExpr,
    NAssignOpExpr,
    NSeqExpr,
    NMatchExpr,
    NHandleExpr,
    NWhileExpr,
    NForInExpr,
    NCallExpr,
    NBinOpExpr,
    NUnaryOpExpr,
    NFnExpr,
    NDotExpr,
    NThrowExpr,
    NBreakExpr,
    NContinueExpr,
    NLabeledArgExpr,
    NWildPat,
    NBindPat,
    NIntPat,
    NStringPat,
    NBoolPat,
    NCtorPat,
    NTuplePat,
    NOrPat,
    NMatchArm,
    NNameType,
    NAppType,
    NFnType,
    NTupleType,
    NUnitType,
    NParam,
    NTypeParam,
    NVariant,
    NEnumVariant,
    NStructField,
    NImportItem,
    NEffectClause,
    NError
  ]
  let mut ki = 0
  while ki < Array::length(all_kinds) {
    let k = Array::get(all_kinds, ki)
    let _eq = node_kind_eq(k, NError)
    let _eq2 = node_kind_eq(k, k)
    ki = ki + 1
  }
  errors
}

export fn main() -> Int with Exception {
  let mut total = 0
  total = total + run_cst_accessors()
  total = total + run_lower_pats()
  total = total + run_lower_types()
  total = total + run_lower_exprs()
  total = total + run_lower_stmts()
  total = total + run_lower_source()
  total = total + run_error_paths()
  total
}
