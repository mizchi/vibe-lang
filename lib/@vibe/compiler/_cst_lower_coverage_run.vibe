//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import ./cst.vibe {
  CstChild, NodeKind, cst_child_nodes, cst_children, cst_filter, cst_find, cst_find_token, cst_kind, cst_tokens, node_kind_eq, node_kind_tag
}

import ./lower.vibe {
  lower_expr, lower_pat, lower_source_file, lower_stmt, lower_type
}

import @vibe/compiler/syntax {
  Token
}

//# Functions

fn run_lower_pats() -> Int with Exception {
  let _p1 = lower_pat(CNode(NWildPat, [CToken(TIdent("_"))]))
  let _p2 = lower_pat(CNode(NBindPat, [CToken(TIdent("x"))]))
  let _p3 = lower_pat(CNode(NIntPat, [CToken(TInt(42))]))
  let _p4 = lower_pat(CNode(NStringPat, [CToken(TString("hi"))]))
  let _p5 = lower_pat(CNode(NBoolPat, [CToken(TIdent("true"))]))
  let _p6 = lower_pat(CNode(NBoolPat, [CToken(TIdent("false"))]))
  let _p7 = lower_pat(CNode(NCtorPat, [CToken(TIdent("None"))]))
  let _p8 = lower_pat(CNode(NCtorPat, [
    CToken(TIdent("Some")),
    CToken(TLParen),
    CNode(NBindPat, [CToken(TIdent("x"))]),
    CToken(TRParen)
  ]))
  let _p9 = lower_pat(CNode(NTuplePat, [
    CToken(TLParen),
    CNode(NBindPat, [CToken(TIdent("a"))]),
    CToken(TComma),
    CNode(NBindPat, [CToken(TIdent("b"))]),
    CToken(TRParen)
  ]))
  let _p10 = lower_pat(CNode(NOrPat, [
    CNode(NIntPat, [CToken(TInt(1))]),
    CToken(TBitOr),
    CNode(NIntPat, [CToken(TInt(2))])
  ]))
  0
}

fn run_lower_exprs() -> Int with Exception {
  let _e1 = lower_expr(CNode(NIntExpr, [CToken(TInt(42))]))
  let _e2 = lower_expr(CNode(NFloatExpr, [CToken(TFloat(3.14))]))
  let _e3 = lower_expr(CNode(NStringExpr, [CToken(TString("hi"))]))
  let _e4 = lower_expr(CNode(NBoolExpr, [CToken(TIdent("true"))]))
  let _e5 = lower_expr(CNode(NIdentExpr, [CToken(TIdent("foo"))]))
  let _e6 = lower_expr(CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)]))
  let _e7 = lower_expr(CNode(NTupleExpr, [
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRParen)
  ]))
  let _e8 = lower_expr(CNode(NArrayExpr, [
    CToken(TLBracket),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRBracket)
  ]))
  let _e9 = lower_expr(CNode(NRecordExpr, [
    CToken(TLBrace),
    CNode(NRecordField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]),
    CToken(TRBrace)
  ]))
  let _e10 = lower_expr(CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TElse),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e10b = lower_expr(CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))])
  ]))
  let _e11 = lower_expr(CNode(NLetExpr, [
    CToken(TLet),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(42))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ]))
  let _e12 = lower_expr(CNode(NLetMutExpr, [
    CToken(TLet),
    CToken(TMut),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(0))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ]))
  let _e13 = lower_expr(CNode(NLetRecExpr, [
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CToken(TEq),
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ]))
  let _e14 = lower_expr(CNode(NSeqExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TSemicolon),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15a = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPlus),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15b = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TMinus),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15c = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TStar),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15d = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TSlash),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15e = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TEqEq),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15f = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TNeq),
    CNode(NIntExpr, [CToken(TInt(2))])
  ]))
  let _e15g = lower_expr(CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
