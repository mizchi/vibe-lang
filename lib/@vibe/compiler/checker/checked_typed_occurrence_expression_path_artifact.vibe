//# Checked typed-occurrence expression-path artifact (#1379 Phase 3)
//
// This strict v1 transport retains the complete append-aligned structural
// observation only. It carries no source offsets and is not a CheckedProgram,
// typed IR, cache/reuse key, trace, interface, or import contract. Decoded
// bytes do not attest that a successful checker invocation produced them.

import @vibe/core {
  array_empty
}

import ./canonical_checked_type_state.vibe {
  canonical_checked_occurrence_type_fields
}

import ./checker_stmt.vibe {
  CheckedTypedOccurrenceExpressionPathObservation
}

/// Opaque capture-order transport of statement path, post-desugar expression
/// path, role, lane, and final-substitution-applied canonical type text.
export struct CheckedTypedOccurrenceExpressionPathArtifact {
  entries: Array[(Array[Int], Array[Int], String, String, String)]
}

fn occurrence_artifact_copy_string(text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, text)
  StringBuilder::freeze(out)
}

fn occurrence_artifact_copy_path(path: Array[Int]) -> Array[Int] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(path) {
    Array::push(out, Array::get(path, i))
    i = i + 1
  }
  out
}

fn occurrence_artifact_copy_entries(entries: Array[(Array[Int], Array[Int], String, String, String)]) -> Array[(Array[Int], Array[Int], String, String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    let (statement_path, expression_path, role, lane, ty) = Array::get(entries, i)
    Array::push(out, (occurrence_artifact_copy_path(statement_path), occurrence_artifact_copy_path(expression_path), occurrence_artifact_copy_string(role), occurrence_artifact_copy_string(lane), occurrence_artifact_copy_string(ty)))
    i = i + 1
  }
  out
}

fn occurrence_artifact_path_valid(path: Array[Int]) -> Bool {
  let mut i = 0
  let mut valid = true
  while i < Array::length(path) && valid {
    if Array::get(path, i) < 0 {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn occurrence_artifact_role_valid(role: String) -> Bool {
  role == "Identifier" || role == "CallResult" || role == "DotProjection" || role == "DotFieldName"
}

fn occurrence_artifact_lane_valid(lane: String) -> Bool {
  lane == "Primary" || lane == "SyntheticRewrite" || lane == "AuxiliaryResumeValueRecheck"
}

fn occurrence_artifact_valid(entries: Array[(Array[Int], Array[Int], String, String, String)]) -> Bool {
  let mut i = 0
  let mut valid = true
  while i < Array::length(entries) && valid {
    let (statement_path, expression_path, role, lane, _) = Array::get(entries, i)
    if !occurrence_artifact_path_valid(statement_path) || !occurrence_artifact_path_valid(expression_path) || !occurrence_artifact_role_valid(role) || !occurrence_artifact_lane_valid(lane) {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

/// Deep-copy a complete successful-check observation and freeze its occurrence
/// types after applying final_subst. Invalid sibling-constructed observations
/// fail closed; the artifact itself carries no checker attestation.
export fn checked_typed_occurrence_expression_path_artifact_from_observation(observation: CheckedTypedOccurrenceExpressionPathObservation) -> Option[CheckedTypedOccurrenceExpressionPathArtifact] {
  if !observation.entries.complete || Array::length(observation.entries.provenance_entries) != Array::length(observation.checked_program.typed_occurrences) {
    None
  } else {
    let raw_types = array_empty()
    let mut i = 0
    while i < Array::length(observation.entries.provenance_entries) {
      let (_, _, _, _, ty) = Array::get(observation.entries.provenance_entries, i)
      Array::push(raw_types, ty)
      i = i + 1
    }
    let types = canonical_checked_occurrence_type_fields(raw_types, observation.checked_program.final_subst)
    let entries = array_empty()
    let mut j = 0
    while j < Array::length(observation.entries.provenance_entries) {
      let (statement_path, expression_path, role, lane, _) = Array::get(observation.entries.provenance_entries, j)
      Array::push(entries, (occurrence_artifact_copy_path(statement_path), occurrence_artifact_copy_path(expression_path), occurrence_artifact_copy_string(role), occurrence_artifact_copy_string(lane), occurrence_artifact_copy_string(Array::get(types, j))))
      j = j + 1
    }
    if occurrence_artifact_valid(entries) {
      Some(CheckedTypedOccurrenceExpressionPathArtifact::{
        entries: entries
      })
    } else {
      None
    }
  }
}

fn occurrence_artifact_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, __to_string(value))
  StringBuilder::push(out, ":")
}

fn occurrence_artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  occurrence_artifact_push_int(out, String::length(text))
  StringBuilder::push(out, text)
}

fn occurrence_artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(path) {
    occurrence_artifact_push_int(out, Array::get(path, i))
    i = i + 1
  }
  StringBuilder::push(out, "]")
}

fn occurrence_artifact_entry(statement_path: Array[Int], expression_path: Array[Int], role: String, lane: String, ty: String) -> String {
  let out = StringBuilder::new()
  occurrence_artifact_push_path(out, statement_path)
  occurrence_artifact_push_path(out, expression_path)
  occurrence_artifact_push_piece(out, role)
  occurrence_artifact_push_piece(out, lane)
  occurrence_artifact_push_piece(out, ty)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder. Capture order and every
/// retained path/tag/type field are emitted exactly; offsets never appear.
export fn encode_checked_typed_occurrence_expression_path_artifact_v1(artifact: CheckedTypedOccurrenceExpressionPathArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-typed-occurrence-expression-path-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(artifact.entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, role, lane, ty) = Array::get(artifact.entries, i)
    occurrence_artifact_push_piece(out, occurrence_artifact_entry(statement_path, expression_path, role, lane, ty))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn occurrence_artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end {
    None
  } else {
    let mut i = start
    let mut value = 0
    let mut valid = true
    if end - start > 1 && String::char_code_at(text, start) == 48 {
      valid = false
    } else {
      ()
    }
    while i < end && valid {
      let digit = String::char_code_at(text, i) - 48
      if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
        valid = false
      } else {
        value = value * 10 + digit
        i = i + 1
      }
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn occurrence_artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match occurrence_artifact_decimal(text, pos, at, n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn occurrence_artifact_path_parse(text: String, pos: Int) -> Option[(Array[Int], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match occurrence_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        let path = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          let start = cursor
          while cursor < n && String::char_code_at(text, cursor) != 58 {
            cursor = cursor + 1
          }
          if cursor == start || cursor >= n {
            valid = false
          } else {
            match occurrence_artifact_decimal(text, start, cursor, 2305843009213693951) {
              Some(value) => {
                Array::push(path, value)
                cursor = cursor + 1
              },
              None => {
                valid = false
              }
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((path, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn occurrence_artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match occurrence_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        let out = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          match occurrence_artifact_piece_parse(text, cursor) {
            Some((item, next)) => {
              Array::push(out, item)
              cursor = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((out, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn occurrence_artifact_entry_parse(text: String) -> Option[(Array[Int], Array[Int], String, String, String)] {
  match occurrence_artifact_path_parse(text, 0) {
    Some((statement_path, after_statement)) => match occurrence_artifact_path_parse(text, after_statement) {
      Some((expression_path, after_expression)) => match occurrence_artifact_piece_parse(text, after_expression) {
        Some((role, after_role)) => match occurrence_artifact_piece_parse(text, after_role) {
          Some((lane, after_lane)) => match occurrence_artifact_piece_parse(text, after_lane) {
            Some((ty, end)) => if end == String::length(text) {
              Some((statement_path, expression_path, role, lane, ty))
            } else {
              None
            },
            None => None
          },
          None => None
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

/// Strict v1 decoder. Counts are bounded by remaining input before iteration,
/// parsing stops at the first failure, and exact re-encoding rejects alternate
/// noncanonical representations.
export fn decode_checked_typed_occurrence_expression_path_artifact_v1(text: String) -> Option[CheckedTypedOccurrenceExpressionPathArtifact] {
  let prefix = "vibe-checked-typed-occurrence-expression-path-artifact:v1\n"
  if !String::starts_with(text, prefix) {
    None
  } else {
    match occurrence_artifact_array_parse(text, String::length(prefix)) {
      Some((raw_entries, end)) => {
        let entries = array_empty()
        let mut i = 0
        let mut valid = end == String::length(text)
        while i < Array::length(raw_entries) && valid {
          match occurrence_artifact_entry_parse(Array::get(raw_entries, i)) {
            Some(entry) => Array::push(entries, entry),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !occurrence_artifact_valid(entries) {
          None
        } else {
          let artifact = CheckedTypedOccurrenceExpressionPathArtifact::{
            entries: occurrence_artifact_copy_entries(entries)
          }
          if encode_checked_typed_occurrence_expression_path_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Reproduce the successful observation's deterministic vocabulary snapshot.
/// This does not turn decoded data into a checker-derived observation.
export fn canonical_checked_typed_occurrence_expression_path_artifact_snapshot(artifact: CheckedTypedOccurrenceExpressionPathArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-typed-occurrence-expression-path-observation:v1\n")
  occurrence_artifact_push_int(out, Array::length(artifact.entries))
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, role, lane, ty) = Array::get(artifact.entries, i)
    occurrence_artifact_push_int(out, Array::length(statement_path))
    let mut j = 0
    while j < Array::length(statement_path) {
      occurrence_artifact_push_int(out, Array::get(statement_path, j))
      j = j + 1
    }
    occurrence_artifact_push_int(out, Array::length(expression_path))
    let mut k = 0
    while k < Array::length(expression_path) {
      occurrence_artifact_push_int(out, Array::get(expression_path, k))
      k = k + 1
    }
    occurrence_artifact_push_piece(out, role)
    occurrence_artifact_push_piece(out, lane)
    occurrence_artifact_push_piece(out, ty)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_typed_occurrence_expression_path_artifact_row_count(artifact: CheckedTypedOccurrenceExpressionPathArtifact) -> Int {
  Array::length(artifact.entries)
}

export fn checked_typed_occurrence_expression_path_artifact_statement_path_at(artifact: CheckedTypedOccurrenceExpressionPathArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (path, _, _, _, _) = Array::get(artifact.entries, row_index)
    Some(occurrence_artifact_copy_path(path))
  }
}

export fn checked_typed_occurrence_expression_path_artifact_expression_path_at(artifact: CheckedTypedOccurrenceExpressionPathArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, path, _, _, _) = Array::get(artifact.entries, row_index)
    Some(occurrence_artifact_copy_path(path))
  }
}

export fn checked_typed_occurrence_expression_path_artifact_role_at(artifact: CheckedTypedOccurrenceExpressionPathArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, role, _, _) = Array::get(artifact.entries, row_index)
    Some(occurrence_artifact_copy_string(role))
  }
}

export fn checked_typed_occurrence_expression_path_artifact_lane_at(artifact: CheckedTypedOccurrenceExpressionPathArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, _, lane, _) = Array::get(artifact.entries, row_index)
    Some(occurrence_artifact_copy_string(lane))
  }
}

export fn checked_typed_occurrence_expression_path_artifact_type_at(artifact: CheckedTypedOccurrenceExpressionPathArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, _, _, ty) = Array::get(artifact.entries, row_index)
    Some(occurrence_artifact_copy_string(ty))
  }
}
