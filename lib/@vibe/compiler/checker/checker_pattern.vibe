//# Imports

import @vibe/compiler/core {
  Pat, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_enum_typedef, find_typedef
}

import @vibe/core {
  array_empty
}

import ./checker_trait.vibe {
  send_subst_vars
}

//# Functions

fn find_ctor_in_defs(defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {
  let dlen = Array::length(defs)
  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {
    if di >= dlen {
      None
    } else {
      let d = Array::get(defs, di)
      match d {
        TDEnum(enum_name, _, variants) => {
          let vlen = Array::length(variants)
          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {
            if vi >= vlen {
              go_defs(di + 1)
            } else {
              let (vname, vtypes) = Array::get(variants, vi)
              if vname == ctor_name {
                Some((enum_name, vtypes))
              } else {
                go_variants(vi + 1)
              }
            }
          }
          go_variants(0)
        },
        _ => go_defs(di + 1)
      }
    }
  }
  go_defs(0)
}

/// Validate the `Enum::Variant` pattern qualifiers the parser recorded on its
/// side channel (#1455 step 3), appending one error per bad pair.
///
/// `refs` is the drained `(qualifier, variant)` log; `defs` is the enum table
/// the checker has just finished building for this compilation.
///
/// A pair is only ever an error when the qualifier names an enum that is
/// actually in `defs` and that enum does not own the variant. Everything else
/// stays silent, deliberately:
///
///   - `Fs::ReadFile(p)` in a `with Fs` arm reaches the log too (handle-arm op
///     patterns parse through the same branch). `Fs` is an effect, not an
///     enum, so it never resolves here.
///   - A pair left over from a parse-only path (`vibe fmt`, an LSP buffer that
///     was never type-checked) names an enum this compilation cannot see.
///
/// Position: like the other constructor-pattern diagnostics in this file the
/// message carries no offset -- `Pat` has no span slot to hang one on.
export fn check_qualified_pattern_refs(refs: Array[(String, String)], defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let n = Array::length(refs)
  let mut i = 0
  while i < n {
    let (qualifier, variant) = Array::get(refs, i)
    match find_enum_typedef(defs, qualifier) {
      Some(TDEnum(ename, _, variants)) => {
        let vlen = Array::length(variants)
        let mut vi = 0
        let mut owns = false
        while vi < vlen {
          let (vname, _) = Array::get(variants, vi)
          if vname == variant {
            owns = true
          } else {
            ()
          }
          vi = vi + 1
        }
        if owns {
          ()
        } else {
          // #1502: the enum is named by its OWN name (`ename`) but the pattern
          // is echoed with the qualifier as WRITTEN (`qualifier`), which differ
          // when the qualifier is an alias. Identical spelling in the common
          // case, so this only shows up on the alias path.
          Array::push(errors, String::concat("enum `", String::concat(ename, String::concat("` has no variant `", String::concat(variant, String::concat("` (in pattern `", String::concat(qualifier, String::concat("::", String::concat(variant, "`)")))))))))
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// True if `pat` binds at least one variable, at any nesting depth (through
/// PCtor/PTuple/PStruct/POr).
fn pat_binds_any(pat: Pat) -> Bool {
  match pat {
    PBind(_) => true,
    PCtor(_, pats) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pats) {
        if pat_binds_any(Array::get(pats, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PTuple(pats) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pats) {
        if pat_binds_any(Array::get(pats, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    POr(a, b) => pat_binds_any(a) || pat_binds_any(b),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        if pat_binds_any(fpat) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #951: codegen's or-pattern lowering (`emit_or_check` in
/// codegen/expr/compile_match.vibe) only emits the tag/literal DISCRIMINATION
/// test for an or-pattern (`A(v) | B(v) => ..`); it never emits a binding
/// EXTRACTION for either branch, since which branch actually matched is not
/// known at the point the arm body binds its locals. A binding or-pattern
/// (even one where both branches use the same name/type, e.g. `A(v) | B(v)`)
/// therefore passes `check_pattern` below — which only walks the LEFT branch —
/// and then crashes codegen with an unlocated "undefined variable" internal
/// error when the arm body reads the binding. Detect ANY or-pattern that binds
/// a variable in either branch, at any nesting depth, so the checker can
/// reject it with a normal, located diagnostic instead of letting it reach
/// codegen at all.
export fn pat_has_unsupported_or_binding(pat: Pat) -> Bool {
  match pat {
    POr(a, b) => pat_binds_any(a) || pat_binds_any(b) || pat_has_unsupported_or_binding(a) || pat_has_unsupported_or_binding(b),
    PCtor(_, pats) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pats) {
        if pat_has_unsupported_or_binding(Array::get(pats, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PTuple(pats) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pats) {
        if pat_has_unsupported_or_binding(Array::get(pats, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        if pat_has_unsupported_or_binding(fpat) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

export fn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {
  match pat {
    PWild => env,
    PBind(name) => env_bind(env, name, scrutinee_ty),
    // A literal pattern can only match a scrutinee of its own type. When the
    // scrutinee resolves to a concrete type that is NOT that literal's type
    // (`match 5 { "x" => .. }`, or a nested `Some(true)` over `Option[Int]`),
    // it is a type error. Type variables / unknown / named (generic) scrutinees
    // are tolerated.
    PInt(_) => {
      match scrutinee_ty {
        CtInt => (),
        // Char is a transparent alias of Int (char literals lex to TInt), so an
        // integer/char literal pattern matches a Char scrutinee too (char_test).
        CtChar => (),
        CtVar(_) => (),
        CtUnknown => (),
        CtNamed(_, _) => (),
        _ => Array::push(errors, "integer literal pattern cannot match a non-Int scrutinee")
      }
      env
    },
    PFloat(_) => {
      match scrutinee_ty {
        CtDouble => (),
        CtVar(_) => (),
        CtUnknown => (),
        CtNamed(_, _) => (),
        _ => Array::push(errors, "float literal pattern cannot match a non-Double scrutinee")
      }
      env
    },
    PString(_) => {
      match scrutinee_ty {
        CtString => (),
        CtVar(_) => (),
        CtUnknown => (),
        CtNamed(_, _) => (),
        _ => Array::push(errors, "string literal pattern cannot match a non-String scrutinee")
      }
      env
    },
    PBool(_) => {
      match scrutinee_ty {
        CtBool => (),
        CtVar(_) => (),
        CtUnknown => (),
        CtNamed(_, _) => (),
        _ => Array::push(errors, "boolean literal pattern cannot match a non-Bool scrutinee")
      }
      env
    },
    PCtor(name, sub_pats) => {
      let builtin_payload = match scrutinee_ty {
        CtOption(elem) => if name == "Some" {
          Some([
            elem
          ])
        } else if name == "None" {
          Some(array_empty())
        } else {
          None
        },
        _ => None
      }
      let ctor_payload = match builtin_payload {
        Some(types) => Some(("Option", types)),
        None => find_ctor_in_defs(defs, name)
      }
      match ctor_payload {
        Some(info) => {
          let (enum_name, raw_payload) = info
          // Instantiate the variant's field types for a parameterized enum:
          // substitute the enum's formal params with the scrutinee's actual
          // type args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]`
          // types `inner` as `Result[T,E]`, not the bare enum param).
          //
          // #1081 step 3 Phase B investigation: `raw_payload` (from
          // `find_ctor_in_defs`/`defs`'s `TDEnum`) is NOT name-parameterized
          // -- `checker_stmt.vibe`'s `SEnum` processing already substitutes
          // the enum's declared param NAMES with FRESH, fixed declaration-
          // time `CtVar` ids before storing a variant's field types (see its
          // `param_var_types`/`resolved_variants`). A name-based
          // `subst_type_params(pt, eparams_names, sargs)` against that
          // already-var-id-substituted payload can never match anything (no
          // `CtNamed(paramname, [])` node survives that first substitution),
          // so it silently no-ops -- `Ok(a)` on a generic `Result[Int,
          // String]` bound `a` to the enum's raw, disconnected declaration-
          // time var instead of `Int` for every parameterized enum ctor
          // (reproduces with a plain `enum Result[T,E]{Ok(T);Err(E)}`,
          // nothing region- or Sender-specific -- found chasing why a
          // same-region `Sender` capture through `Channel::bounded`'s
          // `Ok((s,rx))` pattern lost `s`'s type entirely).
          //
          // The fix mirrors `checker_trait.vibe`'s `send_ok_named` (the
          // `Send` judgment's generic-enum case), which already solves this
          // correctly for that other consumer: recover the SAME fixed var
          // ids via the constructor's own `env`-bound scheme --
          // `CtForAll(param_var_ids, _, CtFn(payload_types_with_var_ids,
          // ret, _))` -- and substitute THOSE ids (not names) with the
          // scrutinee's actual type args.
          let payload_types = match scrutinee_ty {
            CtNamed(_, sargs) => if Array::length(sargs) > 0 {
              match env_lookup(env, name) {
                Some(scheme) => match scheme {
                  CtForAll(param_var_ids, _, inner) => if Array::length(param_var_ids) == Array::length(sargs) {
                    match inner {
                      CtFn(fn_payload_tys, _, _) => for pt in fn_payload_tys {
                        send_subst_vars(pt, param_var_ids, sargs)
                      },
                      _ => raw_payload
                    }
                  } else {
                    raw_payload
                  },
                  _ => raw_payload
                },
                None => raw_payload
              }
            } else {
              raw_payload
            },
            _ => raw_payload
          }
          let splen = Array::length(sub_pats)
          let ptlen = Array::length(payload_types)
          // A constructor pattern can only match a value whose type is the
          // corresponding enum (or builtin Option). A concrete NON-enum type —
          // a scalar (`match 5 { Red => .. }`), a function (`match N { N(a) =>
          // .. }` where the bare ctor `N` is the `(Int) -> E` partial
          // application), an Array or a Tuple — can never be that enum.
          // Type vars / unknown / named / enum / option scrutinees are tolerated.
          let non_enum_scrutinee = match scrutinee_ty {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtString => true,
            CtChar => true,
            CtUnit => true,
            CtBytes => true,
            CtFn(_, _, _) => true,
            CtArray(_) => true,
            CtTuple(_) => true,
            _ => false
          }
          if non_enum_scrutinee {
            Array::push(errors, String::concat("constructor pattern `", String::concat(name, String::concat("` (of ", String::concat(enum_name, ") cannot match this scrutinee type")))))
          } else {
            ()
          }
          // The pattern must bind exactly the variant's payload arity —
          // `Pair(a)` for `Pair(Int, Int)` binds a garbage/oob 2nd field, and
          // binding MORE than exists is likewise wrong. Skip the builtin
          // `Option` (its `None` carries a synthetic 1-element payload).
          if enum_name != "Option" && splen != ptlen {
            Array::push(errors, String::concat("constructor pattern `", String::concat(name, String::concat("` expects ", String::concat(__to_string(ptlen), String::concat(" field(s) but binds ", __to_string(splen)))))))
          } else {
            ()
          }
          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let sub_ty = if i < ptlen {
                Array::get(payload_types, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)
              bind_subs(i + 1, next_env)
            }
          }
          bind_subs(0, env)
        },
        None => {
          let splen = Array::length(sub_pats)
          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)
              bind_unknown(i + 1, next_env)
            }
          }
          bind_unknown(0, env)
        }
      }
    },
    PTuple(pats) => {
      let plen = Array::length(pats)
      match scrutinee_ty {
        CtTuple(elem_tys) => {
          let elen = Array::length(elem_tys)
          // A tuple pattern must bind exactly the scrutinee tuple's arity —
          // `let (a, b, c) = (1, 2)` was accepted and would read past the
          // tuple (binding `c` to garbage). Tuples have a fixed, fully known
          // arity, so this is always a real error.
          if plen != elen {
            Array::push(errors, String::concat("tuple pattern binds ", String::concat(__to_string(plen), String::concat(" elements but the value is a ", String::concat(__to_string(elen), "-tuple")))))
          } else {
            ()
          }
          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let et = if i < elen {
                Array::get(elem_tys, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)
              bind_tuple(i + 1, next_env)
            }
          }
          bind_tuple(0, env)
        },
        _ => {
          // A tuple pattern can only match a tuple value. `let (a, b) = 5`
          // (desugared to `match 5 { (a, b) => .. }`) was accepted and bound
          // `a`/`b` to garbage. When the scrutinee resolves to a concrete
          // NON-tuple type (a scalar, array, option, fn, struct, enum), this is
          // a real error. Type vars / unknown / named (generic) scrutinees stay
          // tolerated.
          let concrete_non_tuple = match scrutinee_ty {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtString => true,
            CtChar => true,
            CtUnit => true,
            CtBytes => true,
            CtArray(_) => true,
            CtOption(_) => true,
            CtFn(_, _, _) => true,
            CtStruct(_) => true,
            CtEnum(_) => true,
            _ => false
          }
          if concrete_non_tuple {
            Array::push(errors, String::concat("tuple pattern binds ", String::concat(__to_string(plen), " elements but the value is not a tuple")))
          } else {
            ()
          }
          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)
              bind_unk(i + 1, next_env)
            }
          }
          bind_unk(0, env)
        }
      }
    },
    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),
    PStruct(_, fields) => {
      let flen = Array::length(fields)
      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
        if i >= flen {
          acc_env
        } else {
          let (_, fpat) = Array::get(fields, i)
          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)
          bind_fields(i + 1, next_env)
        }
      }
      bind_fields(0, env)
    }
  }
}
