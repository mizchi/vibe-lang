import @vibe/compiler/core {
  Expr,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  call_placement_error,
  call_placement_get,
  call_placement_is_identity,
  call_placement_is_pending,
  call_placement_mode,
  call_placement_payload_valid,
  env_value_binding,
  expr_any_node,
  fresh_var,
  refine_trait_bounds_from_receiver,
  subst_apply
}
import ./checker_int32.vibe {
  int32_literal_adapt
}

import ./checker_expr_capture_helpers.vibe {
  struct_literal_typedef
}

import ./checker_infer_binop_type.vibe {
  TypedOccurrenceRoleLaneCapture
}
import ./checker_lambda_seed.vibe {
  seed_lambda_arg_from_call, seed_lambda_fn, seed_lambda_params, take_lambda_param_seeds, take_lambda_return_seed
}

import @vibe/compiler/checker/type_relations {
  int32_kind_name
}
import ./checker_row_effect_inst.vibe {
  callback_arg_env, callback_prefix_subst, effect_inst_arg_check
}

let labeled_value_marker: String = "#call.labeled.value"

/// Shape inspection may unwrap a label; recursive checking still enters its
/// source wrapper so occurrence paths retain that structural child.
export fn checker_call_argument_value(_ arg: Expr) -> Expr {
  match arg {
    ELabeledArg(_, _, value) => value,
    _ => arg
  }
}

/// Whether `arg` is a lambda literal that writes no result type and has a
/// `return` in its body. Nothing checks such a `return` (`__return__` is
/// `CtUnknown`) unless a result seed is handed to the lambda, so a parameter
/// seed alone can type the lambda by its tail while a `return` hands back
/// another type. A `return` inside a nested lambda counts too: that only
/// leaves more lambdas unseeded, which is how they were checked before #4053.
fn lambda_has_unchecked_return(_ arg: Expr) -> Bool {
  match checker_call_argument_value(arg) {
    EFn(_, _, _, None, _, body) => expr_any_node(expr = body, pred = (e) -> e is EReturn(_)),
    _ => false
  }
}

/// Drop any seed recorded for a lambda that is not going to receive one.
fn clear_lambda_seeds() -> Unit {
  let _ = take_lambda_param_seeds()
  let _ = take_lambda_return_seed()
}

/// #4053: an element callback's lambda literal (`Array::map(xs, f = (k) ->
/// ..)`) starts with its one parameter at the receiver's element type, so an
/// `Array[Int32]` gives `k + 1` the `Int32` the call will ask of it.
///
/// A lambda with an unchecked `return` (`lambda_has_unchecked_return`) is not
/// seeded: `Array::map(xs, f = (s) -> { if s == "" { return 123 }; s + s })`
/// over an `Array[String]` would type as `(String) -> String` while
/// `return 123` puts an `Int` into the result. Unseeded, `s + s` settles on
/// `Int` and the call is refused, as it was before this seed existed.
export fn seed_array_callback_elem(arg: Expr, recv_ty: Type, s: Subst) -> Unit {
  if lambda_has_unchecked_return(arg) {
    clear_lambda_seeds()
  } else {
    match subst_apply(s = s, ty = recv_ty) {
      CtArray(elem) => {
        let expected: Array[Type] = [elem]
        seed_lambda_params(arg = checker_call_argument_value(arg), expected = expected, s = s)
      },
      _ => ()
    }
  }
}

/// #4053: a lambda literal given for a named struct's function-typed field
/// (`H::{ f: (k) -> k + 1 }`) starts with its parameters, and an `Int32` /
/// `UInt32` result, at the field's declared types, as an argument does at its
/// parameter's (`seed_lambda_fn`).
export fn seed_struct_field_lambda(defs: Array[TypeDef], struct_name: String, field: String, value: Expr, s: Subst) -> Unit {
  if struct_name != "" && (value is EFn(_, _, _, _, _, _)) {
    match struct_literal_typedef(defs = defs, name = struct_name) {
      Some(TDStruct(_, dfields, _, _)) => for df in dfields {
        let (dn, dty) = df
        if dn == field {
          // An unchecked `return` is left unseeded, as for an element
          // callback, unless the field's result is an `Int32` / `UInt32`:
          // that result seed checks every `return` (`seed_lambda_fn`).
          let ret_seeded = match subst_apply(s = s, ty = dty) {
            CtFn(_, ret, _) => int32_kind_name(subst_apply(s = s, ty = ret)) != "",
            _ => false
          }
          if lambda_has_unchecked_return(value) && !ret_seeded {
            clear_lambda_seeds()
          } else {
            seed_lambda_fn(arg = value, want = dty, s = s)
          }
        }
      },
      _ => ()
    }
  }
}

/// This ephemeral top binding is consumed at the wrapper, before its value
/// is checked. It never leaks into a nested call or a cached environment.
export fn checker_call_argument_env(arg: Expr, env: TypeEnv, cell: Array[Int]) -> TypeEnv {
  if (arg is ELabeledArg(_, _, _)) {
    let known = call_placement_mode(cell) == 0
    match env {
      // Already wrapped for this call (the written-argument loop wraps, and
      // the call's child checker wraps again): keep it rather than build an
      // identical binding per argument.
      EnvBind(name, binding, rest) => if name == labeled_value_marker {
        if (binding.ty == CtUnit) == known {
          env
        } else {
          labeled_value_env(rest = rest, known = known)
        }
      } else {
        labeled_value_env(rest = env, known = known)
      },
      _ => labeled_value_env(rest = env, known = known)
    }
  } else {
    env
  }
}

/// #4037: the wrapper context for a labeled argument whose value's type is
/// wanted before the call's placement is published -- a dot call on a
/// receiver that resolves only later, judged once it does. The wrapper stays
/// in the checked tree, so a typed-occurrence capture keeps the value's path.
export fn checker_known_labeled_argument_env(arg: Expr, env: TypeEnv) -> TypeEnv {
  if (arg is ELabeledArg(_, _, _)) {
    labeled_value_env(rest = env, known = true)
  } else {
    env
  }
}

fn labeled_value_env(rest: TypeEnv, known: Bool) -> TypeEnv {
  EnvBind(labeled_value_marker, env_value_binding(if known {
    CtUnit
  } else {
    CtUnknown
  }), rest)
}

/// Pop the call-local wrapper context without walking or changing its value's
/// lexical environment. Unresolved value calls retain legacy Unknown typing.
export fn checker_labeled_argument_context(_ env: TypeEnv) -> (Bool, TypeEnv) {
  match env {
    EnvBind(name, binding, rest) => if name == labeled_value_marker {
      (binding.ty == CtUnit, rest)
    } else {
      (true, env)
    },
    _ => (true, env)
  }
}

fn written_formal_slot(slots: Array[Int], written: Int) -> Int {
  let mut result = -1
  let mut i = 0
  while i < Array::length(slots) && result < 0 {
    let code = Array::get(slots, at = i)
    if code >= 2 && code / 2 - 1 == written {
      result = i
    } else {
      ()
    }
    i = i + 1
  }
  result
}

// Checking a closure body does not evaluate the argument. Check value
// expressions in written order first, then seed literal callbacks from the
// preceding formal arguments, as declaration-order inference did before.
fn call_args_have_callback(_ args: Array[Expr]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(args) {
    found = checker_call_argument_value(Array::get(args, at = i)) is EFn(_, _, _, _, _, _)
    i = i + 1
  }
  found
}

fn call_argument_visit_order(args: Array[Expr], slots: Array[Int]) -> Option[Array[Int]] {
  let mut has_callback = false
  for arg in args {
    has_callback = has_callback || (checker_call_argument_value(arg) is EFn(_, _, _, _, _, _))
  }
  if has_callback {
    let order: Array[Int] = []
    let mut i = 0
    while i < Array::length(args) {
      if !(checker_call_argument_value(Array::get(args, at = i)) is EFn(_, _, _, _, _, _)) {
        Array::push(order, value = i)
      } else {
        ()
      }
      i = i + 1
    }
    for code in slots {
      if code >= 2 {
        let source = code / 2 - 1
        if checker_call_argument_value(Array::get(args, at = source)) is EFn(_, _, _, _, _, _) {
          Array::push(order, value = source)
        } else {
          ()
        }
      } else {
        ()
      }
    }
    Some(order)
  } else {
    None
  }
}

// Deferred bodies must still enter their original structural source child.
// The visit order is a permutation of checked placement indices, so each
// child is checked once before the parent cursor advances past the call.
fn call_argument_capture_cursor(capture: Option[TypedOccurrenceRoleLaneCapture], next: Int) -> Int {
  match capture {
    Some(c) => if c.provenance_enabled && c.frame_depth > 0 {
      let parent = c.frame_depth - 1
      let previous = Array::get(c.frame_next_children, at = parent)
      if next >= 0 {
        if next <= Array::get(c.frame_expected_children, at = parent) {
          Array::set(c.frame_next_children, at = parent, value = next)
        } else {
          c.complete = false
        }
      } else {
        ()
      }
      previous
    } else {
      -1
    },
    None => -1
  }
}

/// Type arguments in written order and retain aligned formal views only for
/// unification. Literal callback bodies receive preceding formal constraints
/// after value expressions are checked. Omitted slots have logical None types.
/// The caller keeps the expression view; this result owns only the checked types.
export fn check_written_call_arguments(args: Array[Expr], formal_args: Array[Expr], cell: Array[Int], param_tys: Array[Type], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], capture: Option[TypedOccurrenceRoleLaneCapture], lane: String, callee_inst: Option[(Type, Type)], name: String, check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> (Array[Type], Subst, Int) {
  // An identity placement with no literal callback is a positional call, so
  // it takes that path without copying the payload. A callback keeps the plan:
  // its visit order checks callbacks after the value arguments after them.
  let plan = if call_placement_is_pending(cell) && !(call_placement_is_identity(cell = cell, written = Array::length(args)) && !call_args_have_callback(args)) {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => if mode != 0 {
        None
      } else if written != Array::length(args) || !call_placement_payload_valid(written = written, mode = mode, slots = slots) {
        Array::push(errors, value = call_placement_error(cell = cell, callee = EIdent(name, -1), offset = -1)); None
      } else {
        Some(slots)
      },
      None => None
    }
  } else {
    None
  }
  let arg_tys: Array[Type] = match plan {
    Some(slots) => for _ in slots {
      CtUnknown
    },
    None => []
  }
  let seen_params: Array[Type] = match plan {
    Some(_) => [],
    None => param_tys
  }
  let seen_types: Array[Type] = match plan {
    Some(_) => [],
    None => arg_tys
  }
  let mut s2 = s
  let mut c2 = c
  match plan {
    Some(slots) => {
      let mut pi = 0
      while pi < Array::length(slots) {
        if Array::get(slots, at = pi) == 0 {
          let (payload, next) = fresh_var(c2)
          Array::set(arg_tys, at = pi, value = CtOption(payload))
          c2 = next
        } else {
          ()
        }
        pi = pi + 1
      }
    },
    None => ()
  }
  let known = call_placement_mode(cell) == 0
  let order = match plan {
    Some(slots) => call_argument_visit_order(args = args, slots = slots),
    None => None
  }
  let capture_base = match order {
    Some(_) => call_argument_capture_cursor(capture = capture, next = -1),
    None => -1
  }
  let mut ai = 0
  while ai < Array::length(args) {
    let source_index = match order {
      Some(indices) => Array::get(indices, at = ai),
      None => ai
    }
    let source_arg = Array::get(args, at = source_index)
    let arg = if known {
      checker_call_argument_value(source_arg)
    } else {
      source_arg
    }
    let slot = match plan {
      Some(slots) => written_formal_slot(slots = slots, written = source_index),
      None => ai
    }
    let original_expected = if slot >= 0 && slot < Array::length(param_tys) {
      Array::get(param_tys, at = slot)
    } else {
      CtUnknown
    }
    let wrap = match plan {
      Some(slots) => slot >= 0 && Array::get(slots, at = slot) % 2 == 1,
      None => false
    }
    let expected = if wrap {
      match original_expected {
        CtOption(inner) => inner,
        _ => original_expected
      }
    } else {
      original_expected
    }
    let deferred = (order is Some(_)) && (arg is EFn(_, _, _, _, _, _))
    let prefix_params = match plan {
      Some(_) => {
        let out: Array[Type] = []
        if deferred {
          let mut j = 0
          while j < slot {
            Array::push(out, value = if j < Array::length(param_tys) {
              Array::get(param_tys, at = j)
            } else {
              CtUnknown
            })
            j = j + 1
          }
        } else {
          for previous in seen_params {
            Array::push(out, value = previous)
          }; ()
        }
        Array::push(out, value = expected); out
      },
      None => param_tys
    }
    let prefix_types = match plan {
      Some(_) => if deferred {
        Array::slice(arg_tys, start = 0, end = slot)
      } else {
        seen_types
      },
      None => arg_tys
    }
    let arg_s = callback_prefix_subst(arg = arg, param_tys = prefix_params, arg_tys = prefix_types, s = s2, callee = callee_inst)
    let arg_env = if slot >= 0 && slot < Array::length(param_tys) {
      callback_arg_env(env = env, arg = arg, param_ty = expected, s = arg_s, callee = callee_inst, defs = defs)
    } else {
      env
    }
    seed_lambda_arg_from_call(arg = arg, param_tys = prefix_params, arg_tys = prefix_types, s = arg_s)
    let saved_child = if capture_base >= 0 {
      call_argument_capture_cursor(capture = capture, next = capture_base + source_index)
    } else {
      -1
    }
    let source_env = checker_call_argument_env(arg = source_arg, env = arg_env, cell = cell)
    let (at_raw, ns, nc) = check_child(source_arg, source_env, defs, arg_s, c2, errors, tytab, capture, lane)
    // #3730: an integer literal argument takes an `Int32` / `UInt32`
    // parameter's type, range-checked. An annotated `let` is such a call
    // (`ascribe_wrap`), so `let x: Int32 = 5` checks the same way.
    let at = int32_literal_adapt(e = arg, expected = expected, actual = at_raw, s = ns, errors = errors, off = -1)
    if saved_child >= 0 {
      let _ = call_argument_capture_cursor(capture = capture, next = saved_child); ()
    } else {
      ()
    }
    let logical = if wrap {
      CtOption(at)
    } else {
      at
    }
    let logical_expr = match plan {
      Some(_) => if slot >= 0 {
        Array::get(formal_args, at = slot)
      } else {
        arg
      },
      // Keep one value alias through the checks so the source wrapper
      // stays borrowed from its argument array, including under RC.
      None => arg
    }
    match plan {
      Some(_) => {
        if slot >= 0 {
          Array::set(arg_tys, at = slot, value = logical)
        } else {
          ()
        }
        Array::push(seen_params, value = original_expected)
        Array::push(seen_types, value = logical)
      },
      None => Array::push(arg_tys, value = at)
    }
    s2 = if slot >= 0 && slot < Array::length(param_tys) {
      let ns_inst = effect_inst_arg_check(env = env, arg = logical_expr, arg_ty = logical, param_ty = original_expected, s = ns, callee = callee_inst, callee_name = name, defs = defs, errors = errors)
      refine_trait_bounds_from_receiver(env = env, s = ns_inst, param = original_expected, receiver = logical)
    } else {
      ns
    }
    c2 = nc
    ai = ai + 1
  }
  if capture_base >= 0 {
    let _ = call_argument_capture_cursor(capture = capture, next = capture_base + Array::length(args)); ()
  } else {
    ()
  }
  (arg_tys, s2, c2)
}

/// Preserve source positions independently of the logical formal-order view.
export fn checker_call_argument_positions(_ cell: Array[Int]) -> Option[(Array[Int], Int)] {
  if call_placement_is_pending(cell) && !call_placement_is_identity(cell = cell, written = Array::length(cell) - 5) {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => if mode == 0 {
        Some((slots, written))
      } else {
        None
      },
      None => None
    }
  } else {
    None
  }
}
