//# Checked expression-kind direct-return artifact (Phase 3)
//
// Strict opaque v1 transport of retained expression constructor kind joined
// atomically to authoritative direct checker-return type text. It is not
// universal expression typing, a checked program, full typed IR,
// binding/resolution, source identity, diagnostics, cache/reuse/import/interface,
// or trace.

import @vibe/core {
  array_empty
}

import ./canonical_checked_type_state.vibe {
  canonical_checked_occurrence_type_fields
}

import ./checked_expression_structure_core.vibe {
  checked_expression_structure_kind_valid, checked_expression_structure_rows
}

import ./checker_stmt.vibe {
  CheckedDirectExpressionReturnObservation
}

/// Opaque preorder transport of `(statement_path, expression_path, kind, ty)`.
export struct CheckedExpressionKindDirectReturnArtifact {
  entries: Array[(Array[Int], Array[Int], String, String)]
}

fn kind_direct_return_artifact_copy_string(text: String) -> String {
  String::concat(text, "")
}

fn kind_direct_return_artifact_copy_path(path: Array[Int]) -> Array[Int] {
  Array::slice(path, 0, Array::length(path))
}

fn kind_direct_return_artifact_copy_rows(entries: Array[(Array[Int], Array[Int], String, String)]) -> Array[(Array[Int], Array[Int], String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    let (statement_path, expression_path, kind, ty) = Array::get(entries, i)
    Array::push(out, (kind_direct_return_artifact_copy_path(statement_path), kind_direct_return_artifact_copy_path(expression_path), kind_direct_return_artifact_copy_string(kind), kind_direct_return_artifact_copy_string(ty)))
    i = i + 1
  }
  out
}

fn kind_direct_return_artifact_path_valid(path: Array[Int]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(path) && valid {
    if Array::get(path, i) < 0 {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn kind_direct_return_artifact_valid(entries: Array[(Array[Int], Array[Int], String, String)]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(entries) && valid {
    let (statement_path, expression_path, kind, _) = Array::get(entries, i)
    if !kind_direct_return_artifact_path_valid(statement_path) || !kind_direct_return_artifact_path_valid(expression_path) || !checked_expression_structure_kind_valid(kind) {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

/// Complete-or-none conversion independently reconciles every observed row
/// with the checked program's shared retained expression-structure authority.
/// It rejects absent, duplicate, unmapped, or preorder-misaligned coordinates,
/// then deep-copies paths and freezes final-substitution canonical type text.
export fn checked_expression_kind_direct_return_artifact_from_observation(observation: CheckedDirectExpressionReturnObservation) -> Option[CheckedExpressionKindDirectReturnArtifact] {
  match checked_expression_structure_rows(observation.checked_program.checked_stmts) {
    None => None,
    Some(authority) => if Array::length(authority) != Array::length(observation.entries) {
      None
    } else {
      let entries = array_empty()
      let raw_types = array_empty()
      let mut i = 0
      let mut valid = true
      while i < Array::length(authority) && valid {
        let (statement_path, expression_path, _) = Array::get(authority, i)
        let (actual_statement_path, actual_expression_path, ty) = Array::get(observation.entries, i)
        if !kind_direct_return_artifact_paths_equal(statement_path, actual_statement_path) || !kind_direct_return_artifact_paths_equal(expression_path, actual_expression_path) {
          valid = false
        } else {
          Array::push(raw_types, ty)
          i = i + 1
        }
      }
      if !valid {
        None
      } else {
        let types = canonical_checked_occurrence_type_fields(raw_types, observation.checked_program.final_subst)
        if Array::length(types) != Array::length(authority) {
          None
        } else {
          let mut row = 0
          while row < Array::length(authority) {
            let (statement_path, expression_path, kind) = Array::get(authority, row)
            Array::push(entries, (kind_direct_return_artifact_copy_path(statement_path), kind_direct_return_artifact_copy_path(expression_path), kind_direct_return_artifact_copy_string(kind), kind_direct_return_artifact_copy_string(Array::get(types, row))))
            row = row + 1
          }
          if kind_direct_return_artifact_valid(entries) {
            Some(CheckedExpressionKindDirectReturnArtifact::{
              entries: entries
            })
          } else {
            None
          }
        }
      }
    }
  }
}

fn kind_direct_return_artifact_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn kind_direct_return_artifact_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, __to_string(value))
  StringBuilder::push(out, ":")
}

fn kind_direct_return_artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  kind_direct_return_artifact_push_int(out, String::length(text))
  StringBuilder::push(out, text)
}

fn kind_direct_return_artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(path) {
    kind_direct_return_artifact_push_int(out, Array::get(path, i))
    i = i + 1
  }
  StringBuilder::push(out, "]")
}

fn kind_direct_return_artifact_entry(statement_path: Array[Int], expression_path: Array[Int], kind: String, ty: String) -> String {
  let out = StringBuilder::new()
  kind_direct_return_artifact_push_path(out, statement_path)
  kind_direct_return_artifact_push_path(out, expression_path)
  kind_direct_return_artifact_push_piece(out, kind)
  kind_direct_return_artifact_push_piece(out, ty)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder preserving preorder.
export fn encode_checked_expression_kind_direct_return_artifact_v1(artifact: CheckedExpressionKindDirectReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-expression-kind-direct-return-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(artifact.entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, kind, ty) = Array::get(artifact.entries, i)
    kind_direct_return_artifact_push_piece(out, kind_direct_return_artifact_entry(statement_path, expression_path, kind, ty))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn kind_direct_return_artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end || bound < 0 {
    None
  } else {
    let mut valid = true
    let mut value = 0
    let mut i = start
    if end - start > 1 && String::char_code_at(text, start) == 48 {
      valid = false
    }
    while i < end && valid {
      let digit = String::char_code_at(text, i) - 48
      if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
        valid = false
      } else {
        value = value * 10 + digit
        i = i + 1
      }
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn kind_direct_return_artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match kind_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn kind_direct_return_artifact_path_parse(text: String, pos: Int) -> Option[(Array[Int], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match kind_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        if count > n - at - 1 {
          None
        } else {
          let path = array_empty()
          let mut cursor = at + 1
          let mut i = 0
          let mut valid = true
          while i < count && valid {
            let start = cursor
            while cursor < n && String::char_code_at(text, cursor) != 58 {
              cursor = cursor + 1
            }
            if cursor == start || cursor >= n {
              valid = false
            } else {
              match kind_direct_return_artifact_decimal(text, start, cursor, 2305843009213693951) {
                Some(value) => {
                  Array::push(path, value)
                  cursor = cursor + 1
                },
                None => {
                  valid = false
                }
              }
            }
            i = i + 1
          }
          if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
            None
          } else {
            Some((path, cursor + 1))
          }
        }
      },
      None => None
    }
  }
}

fn kind_direct_return_artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match kind_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        if count > n - at - 1 {
          None
        } else {
          let out = array_empty()
          let mut cursor = at + 1
          let mut i = 0
          let mut valid = true
          while i < count && valid {
            match kind_direct_return_artifact_piece_parse(text, cursor) {
              Some((item, next)) => {
                Array::push(out, item)
                cursor = next
              },
              None => {
                valid = false
              }
            }
            i = i + 1
          }
          if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
            None
          } else {
            Some((out, cursor + 1))
          }
        }
      },
      None => None
    }
  }
}

fn kind_direct_return_artifact_entry_parse(text: String) -> Option[(Array[Int], Array[Int], String, String)] {
  match kind_direct_return_artifact_path_parse(text, 0) {
    Some((statement_path, after_statement)) => match kind_direct_return_artifact_path_parse(text, after_statement) {
      Some((expression_path, after_expression)) => match kind_direct_return_artifact_piece_parse(text, after_expression) {
        Some((kind, after_kind)) => match kind_direct_return_artifact_piece_parse(text, after_kind) {
          Some((ty, end)) => if end == String::length(text) {
            Some((statement_path, expression_path, kind, ty))
          } else {
            None
          },
          None => None
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

/// Strict v1 decoder. Counts are bounded by remaining input before iteration;
/// exact re-encoding rejects all alternate noncanonical representations.
export fn decode_checked_expression_kind_direct_return_artifact_v1(text: String) -> Option[CheckedExpressionKindDirectReturnArtifact] {
  let prefix = "vibe-checked-expression-kind-direct-return-artifact:v1\n"
  if !String::starts_with(text, prefix) {
    None
  } else {
    match kind_direct_return_artifact_array_parse(text, String::length(prefix)) {
      Some((raw_rows, end)) => {
        let rows = array_empty()
        let mut valid = end == String::length(text)
        let mut i = 0
        while i < Array::length(raw_rows) && valid {
          match kind_direct_return_artifact_entry_parse(Array::get(raw_rows, i)) {
            Some(row) => Array::push(rows, row),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !kind_direct_return_artifact_valid(rows) {
          None
        } else {
          let artifact = CheckedExpressionKindDirectReturnArtifact::{
            entries: kind_direct_return_artifact_copy_rows(rows)
          }
          if encode_checked_expression_kind_direct_return_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Deterministic opaque artifact snapshot. Decoded bytes attest neither
/// checker success nor canonical type semantics, full typed IR, provenance,
/// binding/resolution, source identity, diagnostics, cache/reuse/import/interface, or trace.
export fn canonical_checked_expression_kind_direct_return_artifact_snapshot(artifact: CheckedExpressionKindDirectReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-expression-kind-direct-return-artifact:v1\n")
  kind_direct_return_artifact_push_int(out, Array::length(artifact.entries))
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, kind, ty) = Array::get(artifact.entries, i)
    kind_direct_return_artifact_push_int(out, Array::length(statement_path))
    let mut j = 0
    while j < Array::length(statement_path) {
      kind_direct_return_artifact_push_int(out, Array::get(statement_path, j))
      j = j + 1
    }
    kind_direct_return_artifact_push_int(out, Array::length(expression_path))
    let mut k = 0
    while k < Array::length(expression_path) {
      kind_direct_return_artifact_push_int(out, Array::get(expression_path, k))
      k = k + 1
    }
    kind_direct_return_artifact_push_piece(out, kind)
    kind_direct_return_artifact_push_piece(out, ty)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_expression_kind_direct_return_artifact_row_count(artifact: CheckedExpressionKindDirectReturnArtifact) -> Int {
  Array::length(artifact.entries)
}

export fn checked_expression_kind_direct_return_artifact_statement_path_at(artifact: CheckedExpressionKindDirectReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (path, _, _, _) = Array::get(artifact.entries, row_index)
    Some(kind_direct_return_artifact_copy_path(path))
  }
}

export fn checked_expression_kind_direct_return_artifact_expression_path_at(artifact: CheckedExpressionKindDirectReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, path, _, _) = Array::get(artifact.entries, row_index)
    Some(kind_direct_return_artifact_copy_path(path))
  }
}

/// Closed constructor kind for a retained direct-return row.
export fn checked_expression_kind_direct_return_artifact_kind_at(artifact: CheckedExpressionKindDirectReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, kind, _) = Array::get(artifact.entries, row_index)
    Some(kind_direct_return_artifact_copy_string(kind))
  }
}

/// Opaque canonical direct checker-return type text for a retained row.
export fn checked_expression_kind_direct_return_artifact_type_at(artifact: CheckedExpressionKindDirectReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, _, ty) = Array::get(artifact.entries, row_index)
    Some(kind_direct_return_artifact_copy_string(ty))
  }
}
