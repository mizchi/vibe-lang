// 32-bit integers in the checker (#3730).

import @vibe/compiler/core {
  Expr, Subst, Type, subst_apply, types_equal, unify
}

import @vibe/compiler/checker/diagnostics {
  off_marker
}

import @vibe/compiler/checker/resume {
  arm_tail_all_return
}

import @vibe/compiler/checker/type_relations {
  float_mix_hint
}

//# Functions

/// #3730: the value of an integer literal operand -- `5`, or a negated one
/// (`-5`), or a block that ends in one -- or None for any other expression.
/// Only a literal takes its type from the context it sits in; a name or a
/// call has the type it was given.
export fn int32_literal_value(_ e: Expr) -> Option[Int] {
  match e {
    EInt(n) => Some(n),
    ELet(_, _, body, _) => int32_literal_value(body),
    ELetMut(_, _, body, _) => int32_literal_value(body),
    ESeq(_, body) => int32_literal_value(body),
    EUnaryOp(op, EInt(n)) => if op == "-" {
      Some(0 - n)
    } else {
      None
    },
    _ => None
  }
}

/// #3730: the type an integer literal `e` takes where a value of type
/// `expected` is wanted. A literal checks as `Int32` / `UInt32` where that
/// type is expected, and is refused (naming the range) when it does not
/// fit; so does an array literal of such literals where an `Array` of either
/// is expected. Anything else keeps `actual`, so a mismatch is reported as
/// usual.
///
/// The literal may sit inside the value, following `expected`'s shape: a
/// tuple element (`(5, "a")` where `(Int32, String)` is wanted), a `Some(..)`
/// payload, or the tail of both branches of an `if`. A part whose shape does
/// not line up with `expected` keeps its inferred type.
export fn int32_literal_adapt(e: Expr, expected: Type, actual: Type, s: Subst, errors: Array[String], off: Int) -> Type {
  let want = subst_apply(s = s, ty = expected)
  match e {
    EIf(_, then_e, else_e) => {
      let t = int32_literal_adapt(e = int32_tail(then_e), expected = want, actual = actual, s = s, errors = errors, off = off)
      let f = int32_literal_adapt(e = int32_tail(else_e), expected = want, actual = actual, s = s, errors = errors, off = off)
      if types_equal(a = t, b = f) {
        t
      } else {
        actual
      }
    },
    // #4053: a lambda literal with no written return type, where a function
    // is wanted: its body's tail takes the wanted return type, as an
    // annotated `-> Int32` tail does (`(k) -> 7` for `(Int32) -> Int32`).
    EFn(tparams, _, _, None, _, body) => match want {
      CtFn(_, want_ret, _) => match subst_apply(s = s, ty = actual) {
        CtFn(ps, ret, eff) => if Array::length(tparams) == 0 {
          CtFn(ps, int32_literal_adapt(e = int32_tail(body), expected = want_ret, actual = ret, s = s, errors = errors, off = off), eff)
        } else {
          actual
        },
        _ => actual
      },
      _ => actual
    },
    _ => match want {
      CtInt32 => int32_literal_fit(e = e, want = want, actual = actual, s = s, errors = errors, off = off),
      CtUInt32 => int32_literal_fit(e = e, want = want, actual = actual, s = s, errors = errors, off = off),
      CtArray(inner) => match subst_apply(s = s, ty = inner) {
        CtInt32 => int32_array_literal_fit(e = e, want = want, elem = CtInt32, actual = actual, s = s, errors = errors, off = off),
        CtUInt32 => int32_array_literal_fit(e = e, want = want, elem = CtUInt32, actual = actual, s = s, errors = errors, off = off),
        _ => actual
      },
      CtTuple(wants) => match e {
        ETuple(items) => match subst_apply(s = s, ty = actual) {
          CtTuple(actuals) => if Array::length(items) == Array::length(wants) && Array::length(items) == Array::length(actuals) {
            let out: Array[Type] = []
            let mut i = 0
            while i < Array::length(items) {
              Array::push(out, value = int32_literal_adapt(e = Array::get(items, at = i), expected = Array::get(wants, at = i), actual = Array::get(actuals, at = i), s = s, errors = errors, off = off))
              i = i + 1
            }
            CtTuple(out)
          } else {
            actual
          },
          _ => actual
        },
        _ => actual
      },
      CtOption(want_inner) => match e {
        ECall(EIdent(ctor, _), args, _, _) => if ctor == "Some" && Array::length(args) == 1 {
          match subst_apply(s = s, ty = actual) {
            CtOption(inner) => CtOption(int32_literal_adapt(e = Array::get(args, at = 0), expected = want_inner, actual = inner, s = s, errors = errors, off = off)),
            _ => actual
          }
        } else {
          actual
        },
        _ => actual
      },
      _ => actual
    }
  }
}

/// The expression a block evaluates to: its tail past `;` and `let`s.
export fn int32_tail(_ e: Expr) -> Expr {
  match e {
    ESeq(_, rest) => int32_tail(rest),
    ELet(_, _, rest, _) => int32_tail(rest),
    ELetRec(_, _, rest) => int32_tail(rest),
    ELetMut(_, _, rest, _) => int32_tail(rest),
    _ => e
  }
}

/// #3730: a struct literal field's value type, an integer literal taking the
/// field's declared `Int32` / `UInt32` type (`Pixel::{ x: 3 }`).
export fn int32_field_adapt(fields: Array[(String, Expr)], name: String, expected: Type, actual: Type, s: Subst, errors: Array[String]) -> Type {
  let mut value = EUnit
  for f in fields {
    let (n, v) = f
    if n == name {
      value = v
    } else {
      ()
    }
  }
  int32_literal_adapt(e = value, expected = expected, actual = actual, s = s, errors = errors, off = 0 - 1)
}

/// #3730: one branch of a join -- an `if` branch, a `match` arm, an array
/// element -- against the type joined so far: an integer literal beside an
/// `Int32` / `UInt32` takes its type. `earlier` are the expressions already
/// joined, `count` of them read through `earlier_at` only when a sized branch
/// follows `Int` ones (so a long ordinary `match` costs nothing here); when a
/// sized one follows nothing but literals, those literals take its type too
/// and are range-checked here. Answers the joined type and this branch's
/// type.
export fn int32_join_branch(count: Int, earlier_at: (Int) -> Expr, e: Expr, joined: Type, actual: Type, s: Subst, errors: Array[String]) -> (Type, Type) {
  let mine = int32_literal_adapt(e = int32_tail(e), expected = joined, actual = actual, s = s, errors = errors, off = 0 - 1)
  let sized_now = match subst_apply(s = s, ty = mine) {
    CtInt32 => true,
    CtUInt32 => true,
    _ => false
  }
  let joined_is_int = match subst_apply(s = s, ty = joined) {
    CtInt => true,
    _ => false
  }
  if sized_now && joined_is_int && count > 0 {
    // An earlier entry that only `return`s yields nothing to the join, so it
    // neither blocks the adaptation nor needs a range check.
    let mut all = true
    let mut i = 0
    while i < count && all {
      let prior = earlier_at(i)
      if !arm_tail_all_return(prior) && int32_literal_value(int32_tail(prior)) is None {
        all = false
      }
      i = i + 1
    }
    if all {
      let mut j = 0
      while j < count {
        match int32_literal_value(int32_tail(earlier_at(j))) {
          Some(n) => int32_literal_range_check(n = n, want = subst_apply(s = s, ty = mine), errors = errors, off = 0 - 1),
          None => ()
        }
        j = j + 1
      }
      (mine, mine)
    } else {
      (joined, mine)
    }
  } else {
    (joined, mine)
  }
}

fn int32_literal_fit(e: Expr, want: Type, actual: Type, s: Subst, errors: Array[String], off: Int) -> Type {
  match int32_literal_value(e) {
    Some(n) => match subst_apply(s = s, ty = actual) {
      CtInt => {
        int32_literal_range_check(n = n, want = want, errors = errors, off = off)
        want
      },
      _ => actual
    },
    None => actual
  }
}

fn int32_array_literal_fit(e: Expr, want: Type, elem: Type, actual: Type, s: Subst, errors: Array[String], off: Int) -> Type {
  let actual_is_int_array = match subst_apply(s = s, ty = actual) {
    CtArray(a) => match subst_apply(s = s, ty = a) {
      CtInt => true,
      _ => false
    },
    _ => false
  }
  match e {
    EArray(items) => if actual_is_int_array && Array::length(items) > 0 {
      let mut all = true
      for it in items {
        if int32_literal_value(it) is None {
          all = false
        }
      }
      if all {
        for it in items {
          match int32_literal_value(it) {
            Some(n) => int32_literal_range_check(n = n, want = elem, errors = errors, off = off),
            None => ()
          }
        }
        want
      } else {
        actual
      }
    } else {
      actual
    },
    _ => actual
  }
}

fn int32_literal_range_check(n: Int, want: Type, errors: Array[String], off: Int) -> Unit {
  match want {
    CtInt32 => if n < 0 - 2147483648 || n > 2147483647 {
      Array::push(errors, value = "integer literal \{n} does not fit `Int32` (-2147483648 .. 2147483647): use an `Int`, or write a value in range\{off_marker(off)}")
    } else {
      ()
    },
    CtUInt32 => if n < 0 || n > 4294967295 {
      Array::push(errors, value = "integer literal \{n} does not fit `UInt32` (0 .. 4294967295): use an `Int`, or write a value in range\{off_marker(off)}")
    } else {
      ()
    },
    _ => ()
  }
}

/// #3730: whether an operation whose result is an `Int32` / `UInt32` can
/// leave that type's range, so its result needs wrapping. `&`, `|`, `^` and
/// `%` of two in-range values are in range; a shift is filed too, because
/// its count is masked to 0 .. 31 (wasm's `i32` shift).
export fn int32_op_wraps(_ op: String) -> Bool {
  op == "+" || op == "-" || op == "*" || op == "/" || op == "<<" || op == ">>"
}

/// #3730: the operands of a binop over `Int32` / `UInt32` must have that one
/// type; an `Int` operand is never converted implicitly. Answers None unless
/// an operand is already one of the two.
export fn int32_binop_candidate(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {
  let target = match subst_apply(s = s, ty = left_ty) {
    CtInt32 => Some(CtInt32),
    CtUInt32 => Some(CtUInt32),
    _ => match subst_apply(s = s, ty = right_ty) {
      CtInt32 => Some(CtInt32),
      CtUInt32 => Some(CtUInt32),
      _ => None
    }
  }
  match target {
    Some(t) => match unify(a = left_ty, b = t, s = s) {
      Some(s1) => match unify(a = right_ty, b = t, s = s1) {
        Some(s2) => Some((t, s2)),
        None => None
      },
      None => None
    },
    None => None
  }
}

/// The integer-only operators `%`, `&`, `|`, `^`, `<<` and `>>`: both
/// operands `Int`, or both one of the 32-bit integers (#3730), which keeps
/// its type.
export fn infer_integer_binop(op: String, left_ty: Type, right_ty: Type, s: Subst, errors: Array[String], off: Int) -> (Type, Subst) {
  if op == "%" {
    match int32_binop_candidate(left_ty = left_ty, right_ty = right_ty, s = s) {
      Some((t, s1)) => (t, s1),
      None => match int_binop_unify(left_ty = left_ty, right_ty = right_ty, s = s) {
        Some(s1) => (CtInt, s1),
        None => {
          Array::push(errors, value = binop_mismatch_msg(op = "%", tail = float_mix_hint(left_ty = left_ty, right_ty = right_ty, s = s, base = "': operands must be Int"), off = off))
          (CtUnknown, s)
        }
      }
    }
  }
  else {
    match int32_binop_candidate(left_ty = left_ty, right_ty = right_ty, s = s) {
      Some((t, s1)) => (t, s1),
      None => match int_binop_unify(left_ty = left_ty, right_ty = right_ty, s = s) {
        Some(s1) => (CtInt, s1),
        None => {
          Array::push(errors, value = binop_mismatch_msg(op = op, tail = float_mix_hint(left_ty = left_ty, right_ty = right_ty, s = s, base = "': operands must be Int"), off = off))
          (CtUnknown, s)
        }
      }
    }
  }
}

fn int_binop_unify(left_ty: Type, right_ty: Type, s: Subst) -> Option[Subst] {
  match unify(a = left_ty, b = CtInt, s = s) {
    Some(s1) => unify(a = right_ty, b = CtInt, s = s1),
    None => None
  }
}

/// `type mismatch in '<op>': <tail>`, carrying the operand anchor as the
/// strippable `[@off=N]` marker. Every binop mismatch in `infer_binop_type`
/// goes through here so none of them can silently go back to being unlocated:
/// the offset is a parameter of the message, not an afterthought at one site.
/// String::concat only (`+`/interpolation mis-codegen to NUL here).
export fn binop_mismatch_msg(op: String, tail: String, off: Int) -> String {
  String::concat(String::concat("type mismatch in '", String::concat(op, tail)), off_marker(off))
}
