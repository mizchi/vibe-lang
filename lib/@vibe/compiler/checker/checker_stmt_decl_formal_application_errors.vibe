/// Run the production whole-program check and retain every successful output
/// the checker actually produces. This deliberately does not use the
/// hover-only `check_program_type_table` path.
/// #2141 (interim guard): reject a type-parameter binder that shares its
/// spelling with a struct/enum declared in the SAME module. The desugar's
/// generated generic helpers resolve type names by SPELLING
/// (`dtd_type_param_names` subtracts declared type names program-wide), so a
/// formal `T` next to a declared `struct T` makes
/// `fn same[T](a: Array[T], b: Array[T]) { a == b }` compare with the
/// STRUCT's semantics over non-struct elements -- `same([1,2], [1,3])`
/// answered true with no diagnostic anywhere. Until that classification is
/// scope-precise, the collision itself is rejected at the binder.
///
/// LOCAL declarations only, on purpose: a formal shadowing an IMPORTED type
/// is measured behaviorally harmless (the helper over-binds and element
/// comparison stays structural; pinned by
/// derive_array_helper_interference_test.vibe), and rejecting it would break
/// working programs whose dependency happens to export a colliding name.
fn tps_local_type_names_into(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, _) => Array::push(out, value = name),
      SEnum(_, name, _, _, _) => Array::push(out, value = name),
      // #2141: `module` blocks are rejected by the parser (#728), so source
      // cannot produce an SModule -- recursed anyway so a synthetic or
      // legacy producer stays covered.
      SModule(_, _, body) => tps_local_type_names_into(stmts = body, out = out),
      _ => ()
    }
    i = i + 1
  }
}

fn tps_local_type_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  tps_local_type_names_into(stmts = stmts, out = out)
  out
}

fn tps_names_contains(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if Array::get(names, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn tps_report(tparams: Array[String], local_types: Array[String], where_label: String, anchor: String, errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(tparams) {
    let tp = type_param_name(Array::get(tparams, at = i))
    if tps_names_contains(names = local_types, name = tp) {
      // The ` [@fn=name]` suffix is the #1941 side-channel marker: binder
      // lists carry no offset of their own, so the diagnostic anchors on the
      // declaration name and locate_type_error turns it into a real line:col
      // at the CLI boundary (find_fn_anchor_off prefers `fn name`/`let name`
      // and falls back to the name's first occurrence, which for a struct or
      // enum label is its declaration). Attached only when the label names a
      // real identifier -- a test's string title is not a word the locator
      // can find, and an unresolved marker is stripped, never printed.
      let located = if String::length(anchor) > 0 {
        String::concat(" [@fn=", String::concat(anchor, "]"))
      } else {
        ""
      }
      Array::push(errors, value = String::concat("type parameter `", String::concat(tp, String::concat("` of ", String::concat(where_label, String::concat(" shadows the declared type `", String::concat(tp, String::concat("`; rename the type parameter or the declared type -- generated generic helpers resolve type names by spelling, so a shadowed formal silently takes the declared type's semantics (#2141)", located))))))))
    } else {
      ()
    }
    i = i + 1
  }
}

fn tps_scan_expr(e: Expr, local_types: Array[String], where_label: String, anchor: String, errors: Array[String]) -> Unit {
  match e {
    EFn(tparams, _, _, _, _, _) => tps_report(tparams = tparams, local_types = local_types, where_label = where_label, anchor = anchor, errors = errors),
    _ => ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    tps_scan_expr(e = expr_child_at(i), local_types = local_types, where_label = where_label, anchor = anchor, errors = errors)
    i = i + 1
  }
  expr_children_pop(mark)
}

fn tps_decl_label(kind: String, name: String) -> String {
  String::concat(kind, String::concat(" `", String::concat(name, "`")))
}

/// #2141 (Codex P1 on #2183): the `__Vfp_` prefix is the desugar's re-spelling
/// of a type-parameter -- `is_marked_formal_name` treats any matching spelling
/// as compiler-generated, so a USER-DECLARED type borrowing the prefix
/// (`struct __Vfp_Point`) would be classified as a variable and its arrays
/// silently compared with erased equality. Reserve the prefix at the one place
/// user source can introduce a colliding meaning: a type DECLARATION. Binders
/// and annotations need no rule of their own -- a binder spelled `__Vfp_X` is
/// genuinely a formal (nothing declared can collide once declarations are
/// rejected), and an undeclared annotation is already an unknown type (#2125).
/// Generated code never declares a `__Vfp_`-prefixed type (helpers are `let`
/// functions; witness structs are `<Trait>Dict`), so the post-desugar merged
/// re-check lane stays clean.
fn tps_reserved_prefix_report(kind: String, name: String, errors: Array[String]) -> Unit {
  if String::starts_with(name, prefix = "__Vfp_") {
    Array::push(errors, value = String::concat(kind, String::concat(" `", String::concat(name, "` uses the reserved `__Vfp_` prefix (compiler-generated type-variable spellings) -- rename the type (#2141)"))))
  } else {
    ()
  }
}

/// #2378: the `fn`s (declarations and bound lambdas) this file defines at a
/// QUALIFIED name the builtin registry owns -- `export fn String::index_of`.
/// Such a definition replaces that builtin for EVERY program that links the
/// file as a dependency -- not the defining file, not the importer's import
/// list, `export`ed or not: bare names are namespaced per file by the export
/// merge (`name_exp_<path>`), and so is a `Trait::operation` whose trait is
/// declared in the same file, but every other `Type::method` stays global
/// because that is what receiver dispatch across files needs, and a builtin
/// such as `String::index_of` lives in that same global namespace. Measured
/// on the seed with a dependency defining `String::index_of` as `-999` and a
/// caller importing only an unrelated name: a private `fn`, an exported
/// `fn`, a private lambda and an exported lambda all answered -999 (in the
/// original instance 0.8us -> 174us on a sparse search, and
/// `String::split(s, "")` changed its ANSWER), and nothing said so.
///
/// Which qualified definitions stay GLOBAL is the merge's decision, and this
/// mirrors it exactly rather than approximating it (Codex review on #2708):
/// an exported definition is renamed by the export plan only when its head is
/// a trait this file declares (`append_export_def_name`, plus the
/// `Array::flatmap` / `Iterator` specialization); a private one is renamed by
/// private namespacing only when its head is a type this file declares and
/// does NOT export (`collect_private_value_renames` /
/// `qualified_method_of_exported_type` -- a private `struct Fs` with a private
/// `fn Fs::exists` is renamed with its type and can replace nothing). Every
/// other qualified definition keeps its spelling in the linked program.
///
/// Which names are BUILTINS: the registry's rows, under the canonical
/// spelling (a source alias such as `String::byte_at` counts, since a call
/// resolves by what the source wrote), plus the runtime-prelude names codegen
/// dispatches by spelling with no registry row
/// (`runtime_prelude_dispatched_builtin_name`): their arms honor any
/// definition in the merged function table, so a dependency's
/// `fn Double::to_string` would be an unrequested override too. A
/// fallback-typed name the registry does not list and no arm dispatches this
/// way (`Array::map`, which `lib/@vibe/builtin/array.vibe` defines as a
/// first-class value) is not collected.
///
/// NOT collected either: a bare name, and a `let` VALUE ALIAS at a qualified
/// builtin name (`export let Fs::exists = exists` in lib/@vibe/fs/fs.vibe),
/// which takes no part in the name-to-fn-def resolution a real definition
/// hijacks. The ENTRY file's own shadow is left alone on purpose: it is
/// explicit in the program being compiled, and
/// `fixtures/to_string_shadowed_builtin_test.vibe` relies on it.
///
/// This is the pure half. The refusal is the loader's (runtime/
/// typecheck_fs.vibe): a checked module's published environment carries one
/// marker per name collected here, and the module that IMPORTS it -- the
/// caller that never asked for the override -- is the one diagnosed, with
/// the edit first. Keeping the marker in the environment is what makes the
/// answer independent of whether the file was checked as a root or as a
/// dependency, so a cached check can never turn a leak into a clean result.
/// `scripts/check_builtin_shadowing.sh` keeps watching the tree for the
/// bare-name and alias shapes this leaves alone.
export fn collect_builtin_shadowing_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  bfs_collect(stmts = stmts, out = out)
  out
}

fn bfs_collect(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let trait_names = bfs_local_trait_names(stmts)
  let declared_types = collect_declared_type_names(stmts)
  let exported_types = collect_exported_type_names(stmts)
  let export_items = bfs_export_items(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, _, name, _, body) => bfs_note(exported = exported || string_array_contains_exact(items = export_items, wanted = name), name = name, body = body, trait_names = trait_names, declared_types = declared_types, exported_types = exported_types, out = out),
      SModule(_, _, body) => bfs_collect(stmts = body, out = out),
      _ => ()
    }
    i = i + 1
  }
}

fn bfs_local_trait_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STrait(_, tname, _, _, _, _) => Array::push(out, value = tname),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The names an `export { a, b }` list publishes: a private `let` named there
/// travels with the export plan, like an `export let`.
fn bfs_export_items(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          Array::push(out, value = Array::get(items, at = j))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Does `name` (`head::member`) keep its spelling in the linked program?
/// The merge's two rename passes, mirrored -- see the collector's doc.
fn bfs_stays_global(exported: Bool, name: String, head: String, trait_names: Array[String], declared_types: Array[String], exported_types: Array[String]) -> Bool {
  if exported {
    !(string_array_contains_exact(items = trait_names, wanted = head) || (name == "Array::flatmap" && string_array_contains_exact(items = trait_names, wanted = "Iterator")))
  } else {
    string_array_contains_exact(items = exported_types, wanted = head) || !string_array_contains_exact(items = declared_types, wanted = head)
  }
}

fn bfs_builtin_owned(_ name: String) -> Bool {
  let canonical = canonical_builtin_name(name)
  match lookup_registry_builtin(canonical) {
    Some(_) => true,
    None => runtime_prelude_dispatched_builtin_name(canonical)
  }
}

fn bfs_note(exported: Bool, name: String, body: Expr, trait_names: Array[String], declared_types: Array[String], exported_types: Array[String], out: Array[String]) -> Unit {
  let sep = String::index_of(name, needle = "::")
  if sep < 0 {
    ()
  } else {
    match body {
      EFn(_, _, _, _, _, _) => {
        let head = String::substring(name, start = 0, end = sep)
        if string_array_contains_exact(items = out, wanted = name) || !bfs_stays_global(exported = exported, name = name, head = head, trait_names = trait_names, declared_types = declared_types, exported_types = exported_types) {
          ()
        } else if bfs_builtin_owned(name) {
          Array::push(out, value = name)
        } else {
          ()
        }
      },
      _ => ()
    }
  }
}

/// PR #2708 review (Codex P1): the `__vibe_` prefix is the compiler's. Its
/// generated definitions carry it -- the Double runtime prelude's
/// `__vibe_double_to_string` / `__vibe_double_parse` and the String
/// length-view prelude's `__vibe_string_unicode_length` /
/// `__vibe_string_utf16_length` (codegen/common_base/*_runtime.vibe), which
/// are appended to the program AFTER this check and found again by
/// spelling -- so a program's own top-level definition spelled that way would
/// be taken for the generated one. Measured: with `fn __vibe_double_to_string(
/// d: Double) -> String { "hijacked" }` in the program, `Double::to_string(
/// 1.5)` answered `hijacked`. Refusing the spelling here, with the edit
/// first, is what makes a by-spelling presence test sound
/// (`program_defines_top_level`).
///
/// #3189 review: `__hs_` is the compiler's for the same reason. The host
/// stream reader the linked lowering injects -- `__hs_next`,
/// `__hs_next_option`, the finisher `__hs_fin`, `__hs_close` -- is added
/// under fixed names, called by those names, and pruned by name. A program's
/// own top-level `__hs_fin` therefore shared a name with the injected one:
/// the injected reader could call the program's function, and the prune kept
/// both, so "did a read survive" could not be answered from the finisher.
///
/// Top-level binders only -- `let` / `fn`, `let mut`, a destructuring `let`,
/// an extern, in a module body too: those are what a generated function's
/// name is resolved against. A LOCAL binder is left alone because the
/// compiler's own desugars introduce locals under these prefixes before the
/// check runs (`__vibe_inspect_actual` and `__hs_src`,
/// desugar_trait_dict.vibe) and a re-check of desugared statements must stay
/// clean.
fn collect_reserved_value_prefix_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => rvp_report(name = name, errors = errors),
      SLetMut(name, _, _) => rvp_report(name = name, errors = errors),
      SExternLet(name, _) => rvp_report(name = name, errors = errors),
      SLetPat(pat, _) => rvp_report_pat(pat = pat, errors = errors),
      SModule(_, _, body) => collect_reserved_value_prefix_errors(stmts = body, errors = errors),
      _ => ()
    }
    i = i + 1
  }
}

fn rvp_report(name: String, errors: Array[String]) -> Unit {
  if String::starts_with(name, prefix = "__vibe_") {
    Array::push(errors, value = String::concat("rename `", String::concat(name, "`: the `__vibe_` prefix is reserved for definitions the compiler generates (the Double runtime prelude's `__vibe_double_to_string`, for one), and a program's own top-level definition spelled that way would silently take the generated one's place (#2652)")))
  } else if String::starts_with(name, prefix = "__hs_") {
    Array::push(errors, value = String::concat("rename `", String::concat(name, "`: the `__hs_` prefix is reserved for the host-stream reader the compiler generates (`__hs_next` and its finisher `__hs_fin`, for two), and a program's own top-level definition spelled that way would share a name with the generated one")))
  } else {
    ()
  }
}

fn rvp_report_pat(pat: Pat, errors: Array[String]) -> Unit {
  match pat {
    PBind(name) => rvp_report(name = name, errors = errors),
    PCtor(_, items) => rvp_report_pats(items = items, errors = errors),
    PTuple(items) => rvp_report_pats(items = items, errors = errors),
    POr(a, b) => {
      rvp_report_pat(pat = a, errors = errors)
      rvp_report_pat(pat = b, errors = errors)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, p) = Array::get(fields, at = i)
        rvp_report_pat(pat = p, errors = errors)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn rvp_report_pats(items: Array[Pat], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    rvp_report_pat(pat = Array::get(items, at = i), errors = errors)
    i = i + 1
  }
}

fn collect_reserved_type_prefix_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, _) => tps_reserved_prefix_report(kind = "struct", name = name, errors = errors),
      SEnum(_, name, _, _, _) => tps_reserved_prefix_report(kind = "enum", name = name, errors = errors),
      STypeAlias(_, name, _, _) => tps_reserved_prefix_report(kind = "type alias", name = name, errors = errors),
      // #2141: unreachable from source (#728 removed module blocks);
      // recursed for any synthetic/legacy producer.
      SModule(_, _, body) => collect_reserved_type_prefix_errors(stmts = body, errors = errors),
      _ => ()
    }
    i = i + 1
  }
}

fn tps_scan_stmts(stmts: Array[Stmt], local_types: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, tparams) => tps_report(tparams = tparams, local_types = local_types, where_label = tps_decl_label(kind = "struct", name = name), anchor = name, errors = errors),
      SEnum(_, name, tparams, _, _) => tps_report(tparams = tparams, local_types = local_types, where_label = tps_decl_label(kind = "enum", name = name), anchor = name, errors = errors),
      SLet(_, _, name, _, e) => tps_scan_expr(e = e, local_types = local_types, where_label = tps_decl_label(kind = "declaration", name = name), anchor = name, errors = errors),
      SLetMut(name, _, e) => tps_scan_expr(e = e, local_types = local_types, where_label = tps_decl_label(kind = "declaration", name = name), anchor = name, errors = errors),
      SLetPat(_, e) => tps_scan_expr(e = e, local_types = local_types, where_label = "a `let` pattern binding", anchor = "", errors = errors),
      SExpr(e) => tps_scan_expr(e = e, local_types = local_types, where_label = "a top-level expression", anchor = "", errors = errors),
      STest(name, e) => tps_scan_expr(e = e, local_types = local_types, where_label = tps_decl_label(kind = "test", name = name), anchor = "", errors = errors),
      SBench(name, e) => tps_scan_expr(e = e, local_types = local_types, where_label = tps_decl_label(kind = "bench", name = name), anchor = "", errors = errors),
      // #2141: unreachable from source (#728 removed module blocks);
      // recursed for any synthetic/legacy producer.
      SModule(_, _, body) => tps_scan_stmts(stmts = body, local_types = local_types, errors = errors),
      _ => ()
    }
    i = i + 1
  }
}

/// Mixed-kind only (`F` unapplied and `F[A]` applied on the same TypeExpr).
/// Alias / effect / trait / struct-field `F[A]` is a well-kinded constructor
/// use; `report_formal_applications` is the shared rule with fn signatures.
fn fapp_report(te: TypeExpr, formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_formal_applications(te = te, formals = formals, where_label = where_label, errors = errors)
}

/// #2286: the label for a struct FIELD diagnostic.
///
/// Normally ``field `f` of struct `S` ``. But when `S` is a witness struct the
/// trait-dict desugar synthesized, that names a declaration the author never
/// wrote and cannot act on -- and in the whole-program lane it is the only
/// diagnostic emitted, because the trait statement is gone by the time this
/// walk runs. So it carries the trait's label instead, the same
/// ``the signature of `Store::lookup` `` that `vibe check` reports, and the
/// two lanes stop disagreeing about the same file.
///
/// `synthesized_dict_field_trait` answers from what the desugar RECORDED, not
/// from the `+ "Dict"` name convention. A hand-written `StoreDict` is never
/// synthesized (the desugar's `struct_decl_exists` guard skips it), so it is
/// absent from the record and keeps the field label -- by construction rather
/// than by a name test, which is what #2276's attempt got wrong.
///
/// Keyed by (struct, FIELD): `flatten_traits` copies a supertrait's methods
/// into the child's dict, so `ChildDict` carries fields only `Base` declares.
/// Keying by struct alone reported ``the signature of `Child::lookup` `` for
/// one of those -- a declaration that does not exist (Codex review on #2313).
export fn struct_field_decl_label(struct_name: String, field_name: String) -> String {
  let owning_trait = synthesized_dict_field_trait(struct_name = struct_name, field_name = field_name)
  if owning_trait == "" {
    String::concat(String::concat(String::concat("field `", field_name), "` of struct `"), String::concat(struct_name, "`"))
  } else {
    fapp_decl_label(owner = owning_trait, member = field_name)
  }
}

export fn fapp_decl_label(owner: String, member: String) -> String {
  String::concat(String::concat(String::concat("the signature of `", owner), String::concat("::", member)), "`")
}

/// Does this method declare a generic of its own with this name -- i.e. does it
/// shadow a trait header parameter spelled the same way?
fn fapp_method_binds_name(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], mname: String, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(method_gens) && !found {
    let (gname, gtp, _) = Array::get(method_gens, at = i)
    if gname == mname && fapp_formals_have_name(formals = gtp, name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does any of `formals` bind this NAME? They are type-param keys (`A[_]`), so
/// an exact string compare misses a kinded binder -- which is the shadow this
/// question exists to find.
fn fapp_formals_have_name(formals: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(formals) && !found {
    if type_param_name(Array::get(formals, at = i)) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn fapp_applied_formals_across(tes: Array[TypeExpr], formals: Array[String]) -> Array[String] {
  let applied = array_empty()
  let is_formal = (head) -> {
    string_array_contains_exact(items = formals, wanted = head)
  }
  let mut i = 0
  while i < Array::length(tes) {
    collect_formal_applications_by(te = Array::get(tes, at = i), is_formal = is_formal, out = applied)
    i = i + 1
  }
  applied
}

/// An applied formal (`F[A]`) in a trait method signature whose parameter is
/// declared as a COMPLETE type. Such a trait can be declared but never
/// implemented: measured, every impl head that supplies a constructor for it is
/// rejected ("type parameter `F` of `Functor` expects a complete type, but
/// `Array` is a constructor with 1 argument(s)"). The declaration is therefore
/// where to say so, and the fix is to declare the parameter kinded -- a kinded
/// `F[_]` applied as `F[A]` stays legal (#2351).
fn fapp_unkinded_application_error(tname: String, mname: String, formal: String) -> String {
  let head = String::concat(String::concat("constructor parameter `", formal), "` is applied in ")
  let mid = String::concat(String::concat(", but `", formal), "` is declared as a complete type that no impl can satisfy")
  let tail = String::concat(String::concat("; declare it as a type constructor -- spell it `", formal), String::concat(String::concat("[_]` in trait `", tname), "`'s parameter list"))
  String::concat(String::concat(head, fapp_decl_label(owner = tname, member = mname)), String::concat(mid, tail))
}

fn collect_decl_formal_application_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STypeAlias(_, name, params, te) => fapp_report(te = te, formals = params, where_label = String::concat(String::concat("the body of type alias `", name), "`"), errors = errors),
      SEffectDef(_, ename, eparams, ops) => {
        let effect_tes = array_empty()
        let mut oi = 0
        while oi < Array::length(ops) {
          let (_, opparams, opret) = Array::get(ops, at = oi)
          let mut pi = 0
          while pi < Array::length(opparams) {
            Array::push(effect_tes, value = Array::get(opparams, at = pi))
            pi = pi + 1
          }
          Array::push(effect_tes, value = opret)
          oi = oi + 1
        }
        report_formal_applications_across(tes = effect_tes, formals = eparams, where_label = String::concat(String::concat("effect `", ename), "`"), errors = errors)
      },
      STrait(_, tname, _, methods, method_gens, tparams) => {
        // A header parameter's kind is aggregated across the whole trait, so
        // it has to be aggregated over the methods that actually MENTION it.
        // A method generic of the same name is a different binder with its own
        // kind, and pooling both made
        //
        //   trait Scoped[A] { raw(A) -> A; project[A[_], B](A[B]) -> A[B] }
        //
        // look like one `A` used unapplied by `raw` and applied by `project`,
        // reported as a mixed-kind error against a valid declaration (Codex
        // review). One pass per header parameter, over the methods that do not
        // rebind it.
        let trait_label = String::concat(String::concat("trait `", tname), "`")
        let mut hi = 0
        while hi < Array::length(tparams) {
          let header_key = Array::get(tparams, at = hi)
          let header_name = type_param_name(header_key)
          let visible_tes = array_empty()
          let mut mj = 0
          while mj < Array::length(methods) {
            let (mname_j, mparams_j, mret_j) = Array::get(methods, at = mj)
            if !fapp_method_binds_name(method_gens = method_gens, mname = mname_j, name = header_name) {
              let mut pj = 0
              while pj < Array::length(mparams_j) {
                Array::push(visible_tes, value = Array::get(mparams_j, at = pj))
                pj = pj + 1
              }
              Array::push(visible_tes, value = mret_j)
            } else {
              ()
            }
            mj = mj + 1
          }
          let header_only = array_empty()
          Array::push(header_only, value = header_key)
          report_formal_applications_across(tes = visible_tes, formals = header_only, where_label = trait_label, errors = errors)
          hi = hi + 1
        }
        let mut mi = 0
        while mi < Array::length(methods) {
          let (mname, mparams, mret) = Array::get(methods, at = mi)
          // Method-local formals are checked per method. Header formals were
          // checked across the whole trait above because their kind belongs
          // to the trait declaration, not one member.
          let formals = array_empty()
          Array::push(formals, value = "Self")
          let mut gi = 0
          while gi < Array::length(method_gens) {
            let (gname, gtp, _) = Array::get(method_gens, at = gi)
            if gname == mname {
              let mut gj = 0
              while gj < Array::length(gtp) {
                Array::push(formals, value = Array::get(gtp, at = gj))
                gj = gj + 1
              }
            } else {
              ()
            }
            gi = gi + 1
          }
          let method_tes = array_empty()
          let mut pi = 0
          while pi < Array::length(mparams) {
            Array::push(method_tes, value = Array::get(mparams, at = pi))
            pi = pi + 1
          }
          Array::push(method_tes, value = mret)
          report_formal_applications_across(tes = method_tes, formals = formals, where_label = fapp_decl_label(owner = tname, member = mname), errors = errors)
          let applied_method_formals = fapp_applied_formals_across(tes = method_tes, formals = formals)
          let mut afi = 0
          while afi < Array::length(applied_method_formals) {
            let applied_name = Array::get(applied_method_formals, at = afi)
            if applied_name == "Self" {
              Array::push(errors, value = String::concat(String::concat("`Self` is a complete type and cannot be applied in ", fapp_decl_label(owner = tname, member = mname)), "; write `Self`, not `Self[...]`"))
            } else {
              Array::push(errors, value = fapp_unkinded_application_error(tname = tname, mname = mname, formal = applied_name))
            }
            afi = afi + 1
          }
          // Only the header parameters this method does NOT shadow. A method
          // generic of the same name is a different binder with its own kind:
          // `trait Scoped[A] { project[A[_], B](A[B]) -> A[B] }` applies the
          // method's kinded `A`, not the header's complete-type `A`, and
          // reporting it produced a diagnostic that told the author to write
          // `A[_]` -- which is what they had written (Codex review).
          let unshadowed_tparams = array_empty()
          let mut ti = 0
          while ti < Array::length(tparams) {
            let tparam = Array::get(tparams, at = ti)
            if !fapp_formals_have_name(formals = formals, name = type_param_name(tparam)) {
              Array::push(unshadowed_tparams, value = tparam)
            } else {
              ()
            }
            ti = ti + 1
          }
          let applied_header_formals = fapp_applied_formals_across(tes = method_tes, formals = unshadowed_tparams)
          let mut ahi = 0
          while ahi < Array::length(applied_header_formals) {
            Array::push(errors, value = fapp_unkinded_application_error(tname = tname, mname = mname, formal = Array::get(applied_header_formals, at = ahi)))
            ahi = ahi + 1
          }
          mi = mi + 1
        }
      },
      SModule(_, _, body) => collect_decl_formal_application_errors(stmts = body, errors = errors),
      _ => ()
    }
    i = i + 1
  }
}

/// #3002: an exception kind that names a type parameter of its declaration
/// (`fn boom[T](x: T) -> Int with Exception[T]`, or a parameter row
/// `f: () -> Int with Exception[T]`). A row item is text and is never
/// substituted at a call site, so every caller was refused with a hint that
/// named the callee's formal. Refused where it is WRITTEN instead.
fn collect_formal_exception_kind_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EFn(tparams, _, params, ret, eff, _)) => if Array::length(tparams) > 0 {
        let formals = array_empty()
        let mut ti = 0
        while ti < Array::length(tparams) {
          Array::push(formals, value = type_param_name(Array::get(tparams, at = ti)))
          ti = ti + 1
        }
        let rows = array_empty()
        match eff {
          Some(row) => Array::push(rows, value = row),
          None => ()
        }
        let mut pi = 0
        while pi < Array::length(params) {
          match Array::get(params, at = pi) {
            (_, Some(pte)) => fek_rows_in_texpr(te = pte, out = rows),
            _ => ()
          }
          pi = pi + 1
        }
        match ret {
          Some(rte) => fek_rows_in_texpr(te = rte, out = rows),
          None => ()
        }
        let mut ri = 0
        let mut reported = false
        while ri < Array::length(rows) && !reported {
          let (kind, formal) = fek_formal_kind_in_row(row = Array::get(rows, at = ri), formals = formals)
          if String::length(kind) > 0 {
            reported = true
            let mut m = String::concat("the exception kind `Exception[", String::concat(kind, String::concat("]` of '", String::concat(name, "' names its type parameter `"))))
            m = String::concat(m, String::concat(formal, "`, but a row does not substitute a type parameter at a call site, so no caller could discharge it -- write a concrete kind (`Exception[String]`), or return the failure as a value of an enum you declare (`enum Res[V, E] { Ok(V); Err(E) }`, returning `Res[V, "))
            m = String::concat(m, String::concat(formal, String::concat("]`) [@fn=", String::concat(name, "]"))))
            Array::push(errors, value = m)
          }
          ri = ri + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// Every effect row written inside a type expression (a function-typed
/// parameter, a function nested in a tuple or an application).
export fn fek_rows_in_texpr(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyFn(ps, r, eff) => {
      match eff {
        Some(row) => Array::push(out, value = row),
        None => ()
      }
      let mut i = 0
      while i < Array::length(ps) {
        fek_rows_in_texpr(te = Array::get(ps, at = i), out = out)
        i = i + 1
      }
      fek_rows_in_texpr(te = r, out = out)
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        fek_rows_in_texpr(te = Array::get(args, at = i), out = out)
        i = i + 1
      }
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        fek_rows_in_texpr(te = Array::get(items, at = i), out = out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn fek_ident_char(_ c: Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

/// The first `Exception[..]` kind in a row's text that mentions one of
/// `formals` as a whole identifier, and that formal; ("", "") when none does.
fn fek_formal_kind_in_row(row: String, formals: Array[String]) -> (String, String) {
  let head = "Exception["
  let n = String::length(row)
  let mut from = 0
  let mut kind_out = ""
  let mut formal_out = ""
  let mut scanning = true
  while scanning {
    let rel = String::index_of(String::substring(row, start = from, end = n), needle = head)
    if rel < 0 {
      scanning = false
    } else {
      let kopen = from + rel + String::length(head)
      let mut j = kopen
      let mut depth = 1
      while j < n && depth > 0 {
        let c = String::char_code_at(row, at = j)
        if c == 91 {
          depth = depth + 1
        } else if c == 93 {
          depth = depth - 1
        }
        j = j + 1
      }
      let close = if depth == 0 {
        j - 1
      } else {
        n
      }
      let kind = String::substring(row, start = kopen, end = close)
      let klen = String::length(kind)
      let mut k = 0
      while k < klen && String::length(formal_out) == 0 {
        if fek_ident_char(String::char_code_at(kind, at = k)) {
          let st = k
          while k < klen && fek_ident_char(String::char_code_at(kind, at = k)) {
            k = k + 1
          }
          let word = String::substring(kind, start = st, end = k)
          let mut fi = 0
          while fi < Array::length(formals) {
            if Array::get(formals, at = fi) == word {
              formal_out = word
            }
            fi = fi + 1
          }
        } else {
          k = k + 1
        }
      }
      if String::length(formal_out) > 0 {
        kind_out = kind
        scanning = false
      } else {
        from = if close < n {
          close + 1
        } else {
          n
        }
        if from >= n {
          scanning = false
        }
      }
    }
  }
  (kind_out, formal_out)
}

/// #3053 (Codex on #3054): per top-level declaration, the builtin type names
/// a binder inside it reuses as a type parameter. `tps_scan_stmts` already
/// walks every binder's formals for #2141; asked about the builtin names
/// instead of the declared ones, its reports name exactly the shadowed
/// spellings. Keyed by `effect_shadow_key`, so the effects pass applies each
/// declaration's set to that declaration alone.
export fn builtin_named_type_params(_ stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut si = 0
  while si < Array::length(stmts) {
    let stmt = Array::get(stmts, at = si)
    let hits = array_empty()
    tps_scan_stmts(stmts = [stmt], local_types = [
      "Int",
      "String",
      "Bool",
      "Float64",
      "Char",
      "Bytes",
      "Unit",
      "Array",
      "Option"
    ], errors = hits)
    if Array::length(hits) > 0 {
      let names = array_empty()
      let mut i = 0
      while i < Array::length(hits) {
        let msg = Array::get(hits, at = i)
        let a = String::index_of(msg, needle = "`")
        if a >= 0 {
          let rest = String::substring(msg, start = a + 1, end = String::length(msg))
          let b = String::index_of(rest, needle = "`")
          if b > 0 {
            Array::push(names, value = String::substring(rest, start = 0, end = b))
          }
        }
        i = i + 1
      }
      Array::push(out, value = (effect_shadow_key(stmt), names))
    }
    si = si + 1
  }
  out
}

/// #3095: the nominal type names -- structs and enums -- this module declares
/// or imports under their own name. The effects pass reads such a word in a
/// row as naming exactly one type, so two rows that spell different nominal
/// heads name different types. A name any alias in scope also spells (`type
/// P = Pt`, an imported alias) is left out, and so is every name an import
/// item renames (`Box as B`), because the checker prints the type by its
/// declared name while the row spells the local one -- unless this module
/// declares its own struct / enum under the source name, which then owns it.
export fn row_nominal_type_names(stmts: Array[Stmt], env: TypeEnv, defs: Array[TypeDef]) -> Array[String] {
  let blocked = array_empty()
  let candidates = array_empty()
  let imported = array_empty()
  let renamed = array_empty()
  let mut ti = 0
  while ti < Array::length(stmts) {
    match Array::get(stmts, at = ti) {
      SStruct(_, name, _, _, _, _) => Array::push(candidates, value = name),
      SEnum(_, name, _, _, _) => Array::push(candidates, value = name),
      STypeAlias(_, name, _, _) => Array::push(blocked, value = name),
      SImport(_, items) => {
        let mut ii = 0
        while ii < Array::length(items) {
          let item = Array::get(items, at = ii)
          match item.alias {
            Some(alias) => {
              Array::push(renamed, value = item.name)
              Array::push(blocked, value = alias)
            },
            None => Array::push(imported, value = item.name)
          }
          ii = ii + 1
        }
      },
      _ => ()
    }
    ti = ti + 1
  }
  // A renamed import's source spelling is blocked only when no local
  // struct / enum owns it: `struct Box` plus `import ./dep { Box as
  // RemoteBox }` leaves a row's `Box` naming the local type (#3102 review).
  let mut ri = 0
  while ri < Array::length(renamed) {
    let n = Array::get(renamed, at = ri)
    if !tps_names_contains(names = candidates, name = n) {
      Array::push(blocked, value = n)
    }
    ri = ri + 1
  }
  let nominal_defs = array_empty()
  row_nominal_scan_defs(defs = env_type_defs(env), blocked = blocked, nominal_defs = nominal_defs)
  row_nominal_scan_defs(defs = defs, blocked = blocked, nominal_defs = nominal_defs)
  let mut ii = 0
  while ii < Array::length(imported) {
    let n = Array::get(imported, at = ii)
    if tps_names_contains(names = nominal_defs, name = n) {
      Array::push(candidates, value = n)
    }
    ii = ii + 1
  }
  let out = array_empty()
  let mut ci = 0
  while ci < Array::length(candidates) {
    let n = Array::get(candidates, at = ci)
    if !tps_names_contains(names = blocked, name = n) && !tps_names_contains(names = out, name = n) {
      Array::push(out, value = n)
    }
    ci = ci + 1
  }
  out
}

fn row_nominal_scan_defs(defs: Array[TypeDef], blocked: Array[String], nominal_defs: Array[String]) -> Unit {
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, at = di) {
      TDAlias(name, _, _) => Array::push(blocked, value = name),
      TDStruct(name, _, _, _) => Array::push(nominal_defs, value = name),
      TDEnum(name, _, _) => Array::push(nominal_defs, value = name),
      _ => ()
    }
    di = di + 1
  }
}

/// #3896: a struct field holding a function, and a companion of the same name.
/// `x.m()` cannot mean both, and the passes did not agree which it meant: the
/// checker typed the call as `T::m` while both lowerings ran the field, so
/// `let n: Int = g.get()` checked clean against `fn G::get(_ g: G) -> Int` and
/// then did `Int` arithmetic on the field's `String`. `(x.m)()` and
/// `let f = x.m` went wrong the same way. The declaration is refused instead,
/// at the companion, naming both spellings to rename. A field that holds a
/// value (`size: Int` beside `fn T::size`) is not ambiguous and stays legal.
fn collect_field_companion_clash_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let fn_fields: Array[(String, String)] = array_empty()
  for stmt in stmts {
    match stmt {
      SStruct(_, name, fields, _, _, _) => for field in fields {
        let (fname, fty) = field
        match fty {
          TyFn(_, _, _) => Array::push(fn_fields, value = (name, fname)),
          _ => ()
        }
      },
      _ => ()
    }
  }
  if Array::length(fn_fields) > 0 {
    for stmt in stmts {
      let declared = match stmt {
        SLet(_, _, name, _, EFn(_, _, _, _, _, _)) => name,
        SFnDecl(_, name, _, _, _) => name,
        _ => ""
      }
      for entry in fn_fields {
        let (owner, fname) = entry
        if declared == String::concat(owner, String::concat("::", fname)) {
          Array::push(errors, value = "`" + owner + "` has a field `" + fname + "` holding a function and a companion `fn " + declared + "`, so `x." + fname + "()` names both -- rename the field or the companion [@fn=" + declared + "]")
        }
      }
    }
  }
}

export fn collect_type_param_shadowing_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  collect_field_companion_clash_errors(stmts = stmts, errors = errors)
  collect_formal_exception_kind_errors(stmts = stmts, errors = errors)
  collect_reserved_type_prefix_errors(stmts = stmts, errors = errors)
  collect_reserved_value_prefix_errors(stmts = stmts, errors = errors)
  collect_decl_formal_application_errors(stmts = stmts, errors = errors)
  let local_types = tps_local_type_names(stmts)
  if Array::length(local_types) == 0 {
    ()
  } else {
    tps_scan_stmts(stmts = stmts, local_types = local_types, errors = errors)
  }
}

export fn push_unique_error_strings(found: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(found) {
    let message = Array::get(found, at = i)
    if string_array_contains_exact(items = errors, wanted = message) {
      ()
    } else {
      Array::push(errors, value = message)
    }
    i = i + 1
  }
}

export fn insert_unique_error_strings(found: Array[String], errors: Array[String], at: Int) -> Unit {
  if Array::length(found) == 0 {
    ()
  } else {
    let suffix = Array::slice(errors, start = at, end = Array::length(errors))
    Array::truncate(errors, length = at)
    push_unique_error_strings(found = found, errors = errors)
    push_unique_error_strings(found = suffix, errors = errors)
  }
}

/// Checks every declaration payload after the current statement list's
/// complete type-definition table exists. Each nested module invokes this from
/// its own phase boundary, and a sibling completion invokes it again over the
/// combined visible declarations. Without the completed table, a later alias
/// can leave a `Map` key looking nominal and defer a diagnostic forever.
export fn check_completed_decl_map_keys(stmts: Array[Stmt], defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let found = array_empty()
    match Array::get(stmts, at = i) {
      STypeAlias(_, name, params, te) => {
        let where_label = String::concat(String::concat("the body of type alias `", name), "`")
        report_map_key_types(te = te, defs = defs, shadow = params, where_label = where_label, errors = found)
        report_decl_bare_generic_heads(te = te, defs = defs, shadow = params, where_label = where_label, errors = found)
      },
      SStruct(_, name, fields, _, _, params) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (field_name, field_type) = Array::get(fields, at = fi)
          let where_label = struct_field_decl_label(struct_name = name, field_name = field_name)
          report_map_key_types(te = field_type, defs = defs, shadow = params, where_label = where_label, errors = found)
          report_decl_bare_generic_heads(te = field_type, defs = defs, shadow = params, where_label = where_label, errors = found)
          fi = fi + 1
        }
      },
      SEnum(_, name, params, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (variant_name, payloads) = Array::get(variants, at = vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            let where_label = String::concat(String::concat(String::concat("the payload of `", name), String::concat("::", variant_name)), "`")
            report_map_key_types(te = Array::get(payloads, at = pi), defs = defs, shadow = params, where_label = where_label, errors = found)
            report_decl_bare_generic_heads(te = Array::get(payloads, at = pi), defs = defs, shadow = params, where_label = where_label, errors = found)
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      SSuberror(_, name, variants) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (variant_name, payloads) = Array::get(variants, at = vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            let where_label = String::concat(String::concat(String::concat("the payload of `", name), String::concat("::", variant_name)), "`")
            report_map_key_types(te = Array::get(payloads, at = pi), defs = defs, shadow = array_empty(), where_label = where_label, errors = found)
            report_decl_bare_generic_heads(te = Array::get(payloads, at = pi), defs = defs, shadow = array_empty(), where_label = where_label, errors = found)
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      SEffectDef(_, name, params, ops) => {
        let mut oi = 0
        while oi < Array::length(ops) {
          let (op_name, op_params, op_ret) = Array::get(ops, at = oi)
          let where_label = fapp_decl_label(owner = name, member = op_name)
          let mut pi = 0
          while pi < Array::length(op_params) {
            report_map_key_types(te = Array::get(op_params, at = pi), defs = defs, shadow = params, where_label = where_label, errors = found)
            report_decl_bare_generic_heads(te = Array::get(op_params, at = pi), defs = defs, shadow = params, where_label = where_label, errors = found)
            pi = pi + 1
          }
          report_map_key_types(te = op_ret, defs = defs, shadow = params, where_label = where_label, errors = found)
          report_decl_bare_generic_heads(te = op_ret, defs = defs, shadow = params, where_label = where_label, errors = found)
          oi = oi + 1
        }
      },
      _ => ()
    }
    push_unique_error_strings(found = found, errors = errors)
    i = i + 1
  }
}

/// Counts the tree that `resolve_type_alias_params` would materialize without
/// allocating it. Counts saturate above `limit`, including duplicated formal
/// arguments, so a generic alias cannot hide the same exponential shape.
fn substituted_type_node_count(ty: Type, params: Array[String], arg_counts: Array[Int], limit: Int) -> Int {
  match ty {
    CtNamed(name, args) => {
      let param_idx = type_param_index(params = params, name = name)
      if param_idx >= 0 && param_idx < Array::length(arg_counts) {
        Array::get(arg_counts, at = param_idx)
      } else {
        let mut total = 1
        let mut i = 0
        while i < Array::length(args) && total <= limit {
          total = capped_type_node_add(total = total, extra = substituted_type_node_count(ty = Array::get(args, at = i), params = params, arg_counts = arg_counts, limit = limit), limit = limit)
          i = i + 1
        }
        total
      }
    },
    CtArray(elem) => capped_type_node_add(total = 1, extra = substituted_type_node_count(ty = elem, params = params, arg_counts = arg_counts, limit = limit), limit = limit),
    CtOption(elem) => capped_type_node_add(total = 1, extra = substituted_type_node_count(ty = elem, params = params, arg_counts = arg_counts, limit = limit), limit = limit),
    CtTuple(elems) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(elems) && total <= limit {
        total = capped_type_node_add(total = total, extra = substituted_type_node_count(ty = Array::get(elems, at = i), params = params, arg_counts = arg_counts, limit = limit), limit = limit)
        i = i + 1
      }
      total
    },
    CtFn(fn_params, ret, _) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(fn_params) && total <= limit {
        total = capped_type_node_add(total = total, extra = substituted_type_node_count(ty = Array::get(fn_params, at = i), params = params, arg_counts = arg_counts, limit = limit), limit = limit)
        i = i + 1
      }
      if total <= limit {
        total = capped_type_node_add(total = total, extra = substituted_type_node_count(ty = ret, params = params, arg_counts = arg_counts, limit = limit), limit = limit)
      } else {
        ()
      }
      total
    },
    CtForAll(_, _, body) => capped_type_node_add(total = 1, extra = substituted_type_node_count(ty = body, params = array_empty(), arg_counts = array_empty(), limit = limit), limit = limit),
    CtRecord(fields) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(fields) && total <= limit {
        let (_, field_type) = Array::get(fields, at = i)
        total = capped_type_node_add(total = total, extra = substituted_type_node_count(ty = field_type, params = array_empty(), arg_counts = array_empty(), limit = limit), limit = limit)
        i = i + 1
      }
      total
    },
    _ => 1
  }
}

fn type_expr_arg_expansion_stats(args: Array[TypeExpr], defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> Array[(Int, Int)] {
  let stats = array_empty()
  let mut i = 0
  while i < Array::length(args) {
    Array::push(stats, value = type_expr_expansion_stats(te = Array::get(args, at = i), defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit))
    i = i + 1
  }
  stats
}

fn type_expr_result_sizes(_ stats: Array[(Int, Int)]) -> Array[Int] {
  let sizes = array_empty()
  let mut i = 0
  while i < Array::length(stats) {
    Array::push(sizes, value = Array::get(stats, at = i).0)
    i = i + 1
  }
  sizes
}

/// Combines eagerly evaluated children. Previously resolved child results stay
/// live while the next child's transient allocation is evaluated.
fn type_expr_children_expansion_stats(child_stats: Array[(Int, Int)], root_size: Int, limit: Int) -> (Int, Int) {
  let mut result_sum = 0
  let mut peak = 0
  let mut i = 0
  while i < Array::length(child_stats) && result_sum <= limit {
    let child = Array::get(child_stats, at = i)
    let child_peak = capped_type_node_add(total = result_sum, extra = child.1, limit = limit)
    if child_peak > peak {
      peak = child_peak
    } else {
      ()
    }
    result_sum = capped_type_node_add(total = result_sum, extra = child.0, limit = limit)
    i = i + 1
  }
  let result_size = capped_type_node_add(total = root_size, extra = result_sum, limit = limit)
  if result_size > peak {
    peak = result_size
  } else {
    ()
  }
  (result_size, peak)
}

fn named_type_expr_expansion_stats(name: String, arg_stats: Array[(Int, Int)], defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> (Int, Int) {
  let arg_counts = type_expr_result_sizes(arg_stats)
  let args = type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 0, limit = limit)
  if string_array_contains_exact(items = shadow, wanted = name) {
    type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 1, limit = limit)
  } else {
    let idx = typedef_index_of_from(defs = defs, name = name, from = 0)
    if idx >= 0 && int_array_contains(items = capped_aliases, wanted = idx) {
      (limit + 1, limit + 1)
    } else if idx >= 0 {
      match Array::get(defs, at = idx) {
        TDAlias(_, params, body) => {
          // `resolve_type_expr_core_shadowed` eagerly materializes every
          // argument before substituting the alias body, even when a formal is
          // unused. Direct argument results and the cloned result coexist, but
          // a nested argument's transient peak does not remain live afterward.
          let result_size = substituted_type_node_count(ty = body, params = params, arg_counts = arg_counts, limit = limit)
          let own_peak = capped_type_node_add(total = args.0, extra = result_size, limit = limit)
          let peak = if args.1 > own_peak {
            args.1
          } else {
            own_peak
          }
          (result_size, peak)
        },
        _ => type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 1, limit = limit)
      }
    } else {
      type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 1, limit = limit)
    }
  }
}

/// Preflights resolved tree size and transient allocation peak with saturation.
/// The first tuple field is the retained result size; the second is the peak.
/// This must run
/// before `resolve_type_expr_shadowed`: measuring the returned tree would
/// already have paid the exponential allocation this guard exists to avoid.
fn type_expr_expansion_stats(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> (Int, Int) {
  match te {
    TyUnit => (1, 1),
    TyName(name) => match resolve_builtin(name) {
      Some(_) => (1, 1),
      None => named_type_expr_expansion_stats(name = name, arg_stats = array_empty(), defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit)
    },
    TyApp(name, args) => {
      let arg_stats = type_expr_arg_expansion_stats(args = args, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit)
      if name == "Array" && Array::length(arg_stats) == 1 {
        type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 1, limit = limit)
      } else if name == "Option" && Array::length(arg_stats) == 1 {
        type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 1, limit = limit)
      } else if name == "StringMap" && Array::length(arg_stats) == 1 && !string_array_contains_exact(items = shadow, wanted = name) && typedef_index_of_from(defs = defs, name = name, from = 0) < 0 {
        type_expr_children_expansion_stats(child_stats = arg_stats, root_size = 2, limit = limit)
      } else {
        named_type_expr_expansion_stats(name = name, arg_stats = arg_stats, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit)
      }
    },
    TyTuple(elems) => type_expr_children_expansion_stats(child_stats = type_expr_arg_expansion_stats(args = elems, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit), root_size = 1, limit = limit),
    TyFn(fn_params, ret, _) => {
      let children = type_expr_arg_expansion_stats(args = fn_params, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit)
      Array::push(children, value = type_expr_expansion_stats(te = ret, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit))
      type_expr_children_expansion_stats(child_stats = children, root_size = 1, limit = limit)
    }
  }
}

export fn type_expr_expansion_node_count(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> Int {
  type_expr_expansion_stats(te = te, defs = defs, shadow = shadow, capped_aliases = capped_aliases, limit = limit).1
}

export fn report_alias_expansion_limit(name: String, errors: Array[String]) -> Unit {
  let message = String::concat(String::concat(String::concat("type alias expansion exceeds ", __to_string(alias_expansion_node_limit())), String::concat(" nodes for `", name)), "`; replace the shared alias DAG with a nominal struct or enum")
  if string_array_contains_exact(items = errors, wanted = message) {
    ()
  } else {
    Array::push(errors, value = message)
  }
}

export fn errors_contain_alias_expansion_limit(_ errors: Array[String]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(errors) && !found {
    if String::starts_with(Array::get(errors, at = i), prefix = "type alias expansion exceeds ") {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Re-resolves acyclic aliases from their source expressions until every
/// dependency edge has had a chance to observe the completed body. Recursive
/// declarations are skipped by statement identity, so a recursive alias in one
/// scope cannot freeze an acyclic same-name alias in another; the alias-count
/// bound cannot exponentially expand a cycle. Acyclic DAGs are preflighted
/// against a node limit before allocation, then rejected with an actionable
/// diagnostic instead of exhausting memory.
export fn refresh_completed_alias_defs(stmts: Array[Stmt], defs: Array[TypeDef], from: Int, to: Int, errors: Array[String]) -> Unit {
  let rounds = local_alias_def_count(defs = defs, from = from, to = to)
  let recursive = recursive_alias_flags(stmts)
  let capped_aliases = array_empty()
  let limit = alias_expansion_node_limit()
  let mut round = 0
  while round < rounds {
    let taken = array_empty()
    let mut i = Array::length(stmts) - 1
    while i >= 0 {
      match Array::get(stmts, at = i) {
        STypeAlias(_, name, params, te) => {
          let idx = completed_alias_index_reverse(defs = defs, name = name, from = from, to = to, taken = taken)
          if idx >= 0 && !Array::get(recursive, at = i) && !int_array_contains(items = capped_aliases, wanted = idx) {
            if type_expr_expansion_node_count(te = te, defs = defs, shadow = params, capped_aliases = capped_aliases, limit = limit) > limit {
              Array::push(capped_aliases, value = idx)
              report_alias_expansion_limit(name = name, errors = errors)
            } else {
              Array::set(defs, at = idx, value = TDAlias(name, params, type_exception_rows_resolved(resolve_type_expr_shadowed(te = te, defs = defs, shadow = params))))
            }
          } else {
            ()
          }
        },
        _ => ()
      }
      i = i - 1
    }
    round = round + 1
  }
}

/// Rebuilds declaration payloads that may have consumed an alias before that
/// alias reached its completed body. Unlike alias definitions, enum payloads
/// keep checker-local CtVar binder ids, so their original binder table is
/// reused while resolving the source expressions again.
export fn refresh_completed_payload_defs(stmts: Array[Stmt], defs: Array[TypeDef], type_def_binders: Array[Array[Int]], from: Int, to: Int) -> Unit {
  let taken = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, fields, _, mut_fields, params) => {
        let idx = completed_type_def_index(defs = defs, probe = TDStruct(name, array_empty(), mut_fields, params), from = from, to = to, taken = taken)
        if idx >= 0 {
          let resolved = for field in fields {
            let (field_name, field_type) = field
            (field_name, type_exception_rows_resolved(resolve_type_expr_shadowed(te = field_type, defs = defs, shadow = params)))
          }
          Array::set(defs, at = idx, value = TDStruct(name, resolved, mut_fields, params))
        } else {
          ()
        }
      },
      SEnum(_, name, params, variants, _) => {
        let idx = completed_type_def_index(defs = defs, probe = TDEnum(name, params, array_empty()), from = from, to = to, taken = taken)
        if idx >= 0 {
          let binder_types = if idx < Array::length(type_def_binders) {
            for binder in Array::get(type_def_binders, at = idx) {
              CtVar(binder)
            }
          } else {
            array_empty()
          }
          let resolved = for variant in variants {
            let (variant_name, payloads) = variant
            (variant_name, for payload in payloads {
              subst_type_params(ty = type_exception_rows_resolved(resolve_type_expr_shadowed(te = payload, defs = defs, shadow = params)), params = params, args = binder_types)
            })
          }
          Array::set(defs, at = idx, value = TDEnum(name, params, resolved))
        } else {
          ()
        }
      },
      SSuberror(_, name, variants) => {
        let idx = completed_type_def_index(defs = defs, probe = TDEnum(name, array_empty(), array_empty()), from = from, to = to, taken = taken)
        if idx >= 0 {
          let resolved = for variant in variants {
            let (variant_name, payloads) = variant
            (variant_name, for payload in payloads {
              resolve_type_expr(te = payload, defs = defs)
            })
          }
          Array::set(defs, at = idx, value = TDEnum(name, array_empty(), resolved))
        } else {
          ()
        }
      },
      SEffectDef(_, name, params, ops) => {
        let idx = completed_type_def_index(defs = defs, probe = TDEffect(name, array_empty(), params), from = from, to = to, taken = taken)
        if idx >= 0 {
          let resolved = for op in ops {
            let (op_name, op_params, ret) = op
            (op_name, for param in op_params {
              resolve_type_expr_shadowed(te = param, defs = defs, shadow = params)
            }, resolve_type_expr_shadowed(te = ret, defs = defs, shadow = params))
          }
          Array::set(defs, at = idx, value = TDEffect(name, resolved, params))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn replace_first_env_binding(env: TypeEnv, wanted: String, ty: Type, replaced: Array[Bool]) -> TypeEnv {
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => if !Array::get(replaced, at = 0) && name == wanted {
      Array::set(replaced, at = 0, value = true)
      EnvBind(name, env_value_binding_with_origin(ty = ty, origin = binding.origin), rest)
    } else {
      EnvBind(name, binding, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced))
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced)),
    EnvTypeDefs(node_defs, selectable, rest) => EnvTypeDefs(node_defs, selectable, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced)),
    EnvShowWrappers(wrappers, unknown, rest) => EnvShowWrappers(wrappers, unknown, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => env_cached_after_tail_change(names = names, bindings = bindings, rest = replace_first_env_binding(env = rest, wanted = wanted, ty = ty, replaced = replaced))
  }
}

fn stmt_owns_equals_marker(stmt: Stmt, type_name: String) -> Bool {
  match stmt {
    SEnum(_, name, _, _, _) => name == type_name,
    SSuberror(_, name, _) => name == type_name,
    SStruct(_, name, _, _, _, _) => name == type_name,
    _ => false
  }
}

fn later_equals_owner_count(stmts: Array[Stmt], after: Int, type_name: String) -> Int {
  let mut count = 0
  let mut i = after + 1
  while i < Array::length(stmts) {
    if stmt_owns_equals_marker(stmt = Array::get(stmts, at = i), type_name = type_name) {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

fn refresh_suberror_owned_bindings(env: TypeEnv, suberror_name: String, variants: Array[(String, Array[Type])], markers_to_skip: Int) -> TypeEnv {
  let marker = String::concat(suberror_name, "::equals")
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => if name == marker {
      if markers_to_skip > 0 {
        EnvBind(name, binding, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip - 1))
      } else {
        let mut refreshed_rest = rest
        let mut vi = Array::length(variants) - 1
        while vi >= 0 {
          let (variant_name, payloads) = Array::get(variants, at = vi)
          let ctor_ty = if Array::length(payloads) == 0 {
            CtEnum(suberror_name)
          } else {
            CtFn(payloads, CtEnum(suberror_name), constructor_dependency_row(Array::length(payloads)))
          }
          refreshed_rest = replace_first_env_binding(env = refreshed_rest, wanted = variant_name, ty = ctor_ty, replaced = [
            false
          ])
          if Array::length(payloads) > 0 {
            refreshed_rest = replace_first_env_binding(env = refreshed_rest, wanted = fn_return_env_name(variant_name), ty = CtEnum(suberror_name), replaced = [
              false
            ])
          } else {
            ()
          }
          vi = vi - 1
        }
        EnvBind(name, binding, refreshed_rest)
      }
    } else {
      EnvBind(name, binding, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip))
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip)),
    EnvTypeDefs(node_defs, selectable, rest) => EnvTypeDefs(node_defs, selectable, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip)),
    EnvShowWrappers(wrappers, unknown, rest) => EnvShowWrappers(wrappers, unknown, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => env_cached_after_tail_change(names = names, bindings = bindings, rest = refresh_suberror_owned_bindings(env = rest, suberror_name = suberror_name, variants = variants, markers_to_skip = markers_to_skip))
  }
}

export fn refresh_completed_suberror_env(stmts: Array[Stmt], env: TypeEnv, defs: Array[TypeDef], from: Int, to: Int) -> TypeEnv {
  let taken = array_empty()
  let mut refreshed = env
  let mut i = Array::length(stmts) - 1
  while i >= 0 {
    match Array::get(stmts, at = i) {
      SSuberror(_, name, _) => {
        let idx = completed_type_def_index_reverse(defs = defs, probe = TDEnum(name, array_empty(), array_empty()), from = from, to = to, taken = taken)
        if idx >= 0 {
          match Array::get(defs, at = idx) {
            TDEnum(_, _, variants) => {
              refreshed = refresh_suberror_owned_bindings(env = refreshed, suberror_name = name, variants = variants, markers_to_skip = later_equals_owner_count(stmts = stmts, after = i, type_name = name))
            },
            _ => ()
          }
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i - 1
  }
  refreshed
}

fn local_alias_def_count(defs: Array[TypeDef], from: Int, to: Int) -> Int {
  let mut count = 0
  let mut i = from
  while i < to {
    match Array::get(defs, at = i) {
      TDAlias(_, _, _) => {
        count = count + 1
      },
      _ => ()
    }
    i = i + 1
  }
  count
}

/// The environment chain is newest-first, while `defs` is declaration order.
/// Find the newest unclaimed local alias so replacing an `EnvTypeDefs` node
/// preserves duplicate-name and cross-kind shadowing exactly.
fn completed_alias_index_reverse(defs: Array[TypeDef], name: String, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = to - 1
  let mut found = 0 - 1
  while i >= from && found < 0 {
    let matches = match Array::get(defs, at = i) {
      TDAlias(n, _, _) => n == name,
      _ => false
    }
    if matches && !int_array_contains(items = taken, wanted = i) {
      found = i
    } else {
      i = i - 1
    }
  }
  if found >= 0 {
    Array::push(taken, value = found)
  } else {
    ()
  }
  found
}

fn type_def_same_head(left: TypeDef, right: TypeDef) -> Bool {
  match (left, right) {
    (TDEnum(a, _, _), TDEnum(b, _, _)) => a == b,
    (TDStruct(a, _, _, _), TDStruct(b, _, _, _)) => a == b,
    (TDAlias(a, _, _), TDAlias(b, _, _)) => a == b,
    (TDEffect(a, _, _), TDEffect(b, _, _)) => a == b,
    (TDEffectSet(a, _), TDEffectSet(b, _)) => a == b,
    _ => false
  }
}

fn completed_type_def_index(defs: Array[TypeDef], probe: TypeDef, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = from
  let mut found = 0 - 1
  while i < to && found < 0 {
    if type_def_same_head(left = Array::get(defs, at = i), right = probe) && !int_array_contains(items = taken, wanted = i) {
      found = i
    } else {
      i = i + 1
    }
  }
  if found >= 0 {
    Array::push(taken, value = found)
  } else {
    ()
  }
  found
}

fn completed_type_def_index_reverse(defs: Array[TypeDef], probe: TypeDef, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = to - 1
  let mut found = 0 - 1
  while i >= from && found < 0 {
    if type_def_same_head(left = Array::get(defs, at = i), right = probe) && !int_array_contains(items = taken, wanted = i) {
      found = i
    } else {
      i = i - 1
    }
  }
  if found >= 0 {
    Array::push(taken, value = found)
  } else {
    ()
  }
  found
}

fn refresh_completed_type(ty: Type, defs: Array[TypeDef], shadow: Array[String], seen: Array[String]) -> Type {
  match ty {
    CtNamed(name, args) => {
      let refreshed_args = for arg in args {
        refresh_completed_type(ty = arg, defs = defs, shadow = shadow, seen = seen)
      }
      if string_array_contains_exact(items = shadow, wanted = name) || string_array_contains_exact(items = seen, wanted = name) {
        CtNamed(name, refreshed_args)
      } else match find_typedef(defs = defs, name = name) {
        Some(TDAlias(_, params, target)) => {
          let next_seen = Array::slice(seen, start = 0, end = Array::length(seen))
          Array::push(next_seen, value = name)
          refresh_completed_type(ty = subst_type_params(ty = target, params = params, args = refreshed_args), defs = defs, shadow = shadow, seen = next_seen)
        },
        _ => CtNamed(name, refreshed_args)
      }
    },
    CtTuple(items) => CtTuple(for item in items {
      refresh_completed_type(ty = item, defs = defs, shadow = shadow, seen = seen)
    }),
    CtArray(item) => CtArray(refresh_completed_type(ty = item, defs = defs, shadow = shadow, seen = seen)),
    CtOption(item) => CtOption(refresh_completed_type(ty = item, defs = defs, shadow = shadow, seen = seen)),
    CtApplied(head, args) => apply_type_constructor(head = refresh_completed_type(ty = head, defs = defs, shadow = shadow, seen = seen), args = for arg in args {
      refresh_completed_type(ty = arg, defs = defs, shadow = shadow, seen = seen)
    }),
    CtFn(params, ret, row) => CtFn(for param in params {
      refresh_completed_type(ty = param, defs = defs, shadow = shadow, seen = seen)
    }, refresh_completed_type(ty = ret, defs = defs, shadow = shadow, seen = seen), match row {
      // #3028: a constructor's signature is refreshed here once the
      // declarations are complete; its rows' kinds resolve with its payloads.
      Some(r) => Some(exception_row_resolved(r)),
      None => None
    }),
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, refresh_completed_type(ty = body, defs = defs, shadow = shadow, seen = seen)),
    CtRecord(fields) => CtRecord(for field in fields {
      let (name, field_ty) = field
      (name, refresh_completed_type(ty = field_ty, defs = defs, shadow = shadow, seen = seen))
    }),
    _ => ty
  }
}

fn refresh_completed_env_type_def(node_def: TypeDef, completed_def: TypeDef, defs: Array[TypeDef]) -> TypeDef {
  match node_def {
    TDAlias(name, params, old_body) => match completed_def {
      TDAlias(_, _, body) => TDAlias(name, params, body),
      _ => TDAlias(name, params, old_body)
    },
    TDStruct(name, fields, mut_fields, params) => TDStruct(name, for field in fields {
      let (field_name, field_ty) = field
      (field_name, refresh_completed_type(ty = field_ty, defs = defs, shadow = params, seen = array_empty()))
    }, mut_fields, params),
    TDEnum(name, params, variants) => TDEnum(name, params, for variant in variants {
      let (variant_name, payloads) = variant
      (variant_name, for payload in payloads {
        refresh_completed_type(ty = payload, defs = defs, shadow = params, seen = array_empty())
      })
    }),
    TDEffect(name, ops, params) => TDEffect(name, for op in ops {
      let (op_name, op_params, ret) = op
      (op_name, for param in op_params {
        refresh_completed_type(ty = param, defs = defs, shadow = params, seen = array_empty())
      }, refresh_completed_type(ty = ret, defs = defs, shadow = params, seen = array_empty()))
    }, params),
    TDEffectSet(name, members) => TDEffectSet(name, members)
  }
}

fn refresh_alias_env_binding(env: TypeEnv, name: String, body: Type) -> TypeEnv {
  match env {
    EnvBind(bound_name, binding, rest) => if bound_name == name {
      EnvBind(bound_name, env_value_binding_with_origin(ty = body, origin = binding.origin), rest)
    } else {
      env
    },
    EnvCached(names, bindings, rest) => env_cached_after_tail_change(names = names, bindings = bindings, rest = refresh_alias_env_binding(env = rest, name = name, body = body)),
    _ => env
  }
}

fn refresh_type_env_prefix(env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  match env {
    EnvBind(name, binding, rest) => EnvBind(name, env_value_binding_with_origin(ty = refresh_completed_type(ty = binding.ty, defs = defs, shadow = array_empty(), seen = array_empty()), origin = binding.origin), refresh_type_env_prefix(env = rest, defs = defs)),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, refresh_completed_type(ty = target, defs = defs, shadow = array_empty(), seen = array_empty()), refresh_type_env_prefix(env = rest, defs = defs)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, refresh_completed_type(ty = target, defs = defs, shadow = params, seen = array_empty()), refresh_type_env_prefix(env = rest, defs = defs)),
    EnvShowWrappers(wrappers, unknown, rest) => EnvShowWrappers(wrappers, unknown, refresh_type_env_prefix(env = rest, defs = defs)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_type_env_prefix(env = rest, defs = defs)),
    EnvCached(names, bindings, rest) => env_cached_after_tail_change(names = names, bindings = bindings, rest = refresh_type_env_prefix(env = rest, defs = defs)),
    _ => env
  }
}

/// Refreshes the completed local declaration payloads and their companion
/// value signatures without restacking the environment. The exact local type
/// count provides the boundary that keeps imported and outer nodes untouched.
export fn refresh_completed_type_env(env: TypeEnv, defs: Array[TypeDef], from: Int, to: Int, taken: Array[Int], local_count: Int) -> TypeEnv {
  if Array::length(taken) >= local_count {
    env
  } else match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => EnvBind(name, binding, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count)),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count)),
    EnvTypeDefs(node_defs, selectable, rest) => {
      let refreshed = array_empty()
      let mut refreshed_rest = rest
      let mut refresh_prefix = false
      let mut i = 0
      while i < Array::length(node_defs) {
        let node_def = Array::get(node_defs, at = i)
        let idx = completed_type_def_index_reverse(defs = defs, probe = node_def, from = from, to = to, taken = taken)
        if idx >= 0 {
          let completed_def = Array::get(defs, at = idx)
          Array::push(refreshed, value = refresh_completed_env_type_def(node_def = node_def, completed_def = completed_def, defs = defs))
          match completed_def {
            TDAlias(name, _, body) => {
              refreshed_rest = refresh_alias_env_binding(env = refreshed_rest, name = name, body = body)
            },
            _ => {
              refresh_prefix = true
            }
          }
        } else {
          Array::push(refreshed, value = node_def)
        }
        i = i + 1
      }
      let completed_rest = if refresh_prefix {
        refresh_type_env_prefix(env = refreshed_rest, defs = defs)
      } else {
        refreshed_rest
      }
      EnvTypeDefs(refreshed, selectable, refresh_completed_type_env(env = completed_rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count))
    },
    EnvShowWrappers(wrappers, unknown, rest) => EnvShowWrappers(wrappers, unknown, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => env_cached_after_tail_change(names = names, bindings = bindings, rest = refresh_completed_type_env(env = rest, defs = defs, from = from, to = to, taken = taken, local_count = local_count))
  }
}
