//# Package-local malformed direct-return observation coverage

import @vibe/compiler/core {
  Expr, Stmt, Type
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker/artifacts {
  checked_expression_kind_direct_return_artifact_from_observation
}

import ./checker_stmt.vibe {
  CheckedDirectExpressionReturnObservation, check_program_direct_expression_return_observation
}

fn kind_direct_internal_fixture() -> Array[Stmt] {
  [SLet(false, false, "value", None, EIf(EBool(true), EInt(1), EInt(2)))]
}

fn kind_direct_internal_copy_entries(_ entries: Array[(Array[Int], Array[Int], Type)]) -> Array[(Array[Int], Array[Int], Type)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    Array::push(out, value = Array::get(entries, at = i))
    i = i + 1
  }
  out
}

fn kind_direct_internal_assert_none(_ observation: CheckedDirectExpressionReturnObservation) -> Unit {
  match checked_expression_kind_direct_return_artifact_from_observation(observation) {
    None => (),
    Some(_) => assert(false)
  }
}

test "kind direct-return artifact rejects malformed internal observations" {
  match check_program_direct_expression_return_observation(kind_direct_internal_fixture()) {
    Some(observation) => {
      let count = Array::length(observation.entries)
      assert(count >= 2)
      let missing = Array::slice(observation.entries, start = 0, end = count - 1)
      kind_direct_internal_assert_none(CheckedDirectExpressionReturnObservation::{
        checked_program: observation.checked_program,
        entries: missing
      })
      let extra = kind_direct_internal_copy_entries(observation.entries)
      Array::push(extra, value = Array::get(observation.entries, at = 0))
      kind_direct_internal_assert_none(CheckedDirectExpressionReturnObservation::{
        checked_program: observation.checked_program,
        entries: extra
      })
      let misaligned = kind_direct_internal_copy_entries(observation.entries)
      let (_, first_expression_path, first_ty) = Array::get(misaligned, at = 0)
      Array::set(misaligned, at = 0, value = ([99], first_expression_path, first_ty))
      kind_direct_internal_assert_none(CheckedDirectExpressionReturnObservation::{
        checked_program: observation.checked_program,
        entries: misaligned
      })
      let duplicate = kind_direct_internal_copy_entries(observation.entries)
      let (first_statement_path, first_expression_path, _) = Array::get(duplicate, at = 0)
      let (_, _, second_ty) = Array::get(duplicate, at = 1)
      Array::set(duplicate, at = 1, value = (first_statement_path, first_expression_path, second_ty))
      kind_direct_internal_assert_none(CheckedDirectExpressionReturnObservation::{
        checked_program: observation.checked_program,
        entries: duplicate
      })
    },
    None => assert(false)
  }
}
