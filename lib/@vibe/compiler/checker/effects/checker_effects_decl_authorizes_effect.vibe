/// #2964 / #3015: does the row name exception kinds and no erased
/// `Exception` label?
fn row_is_kinded_exception_only(labels: Array[String]) -> Bool {
  !row_has_erased_exception(labels) && Array::length(exception_effect_labels(labels)) > 0
}

/// Does a row carry the ERASED exception effect (`Exception` /
/// `Exception::Throw`, kind empty), the spelling that admits every kind?
export fn row_has_erased_exception(labels: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) && String::length(exception_label_kind(l)) == 0 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The kinded exception labels (`Exception[K]`, kind non-empty) among a
/// handle's discharged effect names.
export fn kinded_exception_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) && String::length(exception_label_kind(l)) > 0 && String::index_of(l, "::") < 0 {
      Array::push(out, l)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `labels` without the exception family and without the kinded-handle
/// marker: what an enclosing row still authorizes inside a kinded handle
/// (everything but exceptions, which the handle now owns).
export fn labels_without_exception_family(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) || l == kinded_handle_marker() {
      ()
    } else {
      Array::push(out, l)
    }
    i = i + 1
  }
  out
}

export fn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {
  // All concrete label checks, including Async above, go through this same
  // exact-membership primitive rather than substring matching.
  if authority_is_optional(eff_name) {
    // ADR-0088 graded subset: an OPTIONAL requirement (`with Fs::read_file?`
    // on a callee) is satisfied by an optional grant that covers the
    // operation -- the operation itself, or its whole provider (`allows
    // Fs?`: the grade is stripped and the provider-to-operation containment
    // of `decl_authorizes_op` is re-applied, Codex review on PR #2653) --
    // or by the required grade of either, Required being the join. The
    // reverse (an optional grant for a required call) is the plain-label case
    // below, where the `?` label never matches, and `optional_grant_for`
    // names the edit.
    let core = strip_authority_grade(eff_name)
    decl_authorizes_optional_op(labels, core) || decl_authorizes_op(labels, core)
  } else if effect_row_has_label(Some(labels), eff_name) && !row_label_args_differ(eff_name, requirement_marked_for(eff_name)) {
    // #3095: the same spelling can still name two types -- `with State[Int]`
    // inside a lambda binding `[Int]` names its formal, while `get(5)`
    // requires the builtin.
    true
  } else if console_authorizes_legacy(labels, eff_name) {
    true
  } else if is_exception_effect_name(eff_name) {
    // ADR-0085 Phase 3 (#1344): the exception effect is authorized by KIND.
    // This arm now runs BEFORE row_base_membership below, because that rule
    // compares generic row items by their base name (the
    // instantiation-insensitive #1340 v1, where `State[Int]` and
    // `State[String]` are interchangeable) -- reaching it would let
    // `with Exception[ParseError]` authorize an `IoError` throw and erase
    // the one guarantee typed exceptions exist to give. For BRACKETLESS rows
    // the reorder is inert: the old order could only have matched here when
    // some declared label already shared the base `Error`, which the exact
    // check above decided.
    let required_kind = exception_label_kind(eff_name)
    // #2985 review (Codex P0): inside a handle with a KINDED arm the erased
    // gradual rule is off -- the arm catches every exception at run time, so
    // only a requirement of exactly its kind is authorized; an unresolved
    // kind ("") is not, and neither is another kind (the outer row's
    // exception labels were stripped for the body, see the EHandle arm).
    // #2964 / #3015: a row that declares ONLY kinded exception labels is a
    // promise about which kinds leave the function, so it is strict too. The
    // gradual rule admitted an unresolved requirement against it -- a `throw`
    // of a pattern binder or a field, a callback typed `with Exception`, a
    // callee declared `with Exception` -- and the function then raised a kind
    // it does not declare. The erased spelling `with Exception` stays gradual.
    let strict = effect_row_has_label(Some(labels), kinded_handle_marker()) || row_is_kinded_exception_only(labels)
    let mut alias_found = false
    let mut alias_i = 0
    while alias_i < Array::length(labels) {
      let declared_label = Array::get(labels, alias_i)
      let declared_kind = exception_label_kind(declared_label)
      let covers = if strict {
        String::length(required_kind) > 0 && String::length(declared_kind) > 0 && exception_kinds_same(declared_kind, required_kind)
      } else {
        exception_kinds_compatible(declared_kind, required_kind)
      }
      if is_exception_label(declared_label) && covers {
        alias_found = true
      }
      alias_i = alias_i + 1
    }
    alias_found
  } else if row_base_membership(labels, eff_name) {
    true
  } else {
    let mut i = 0
    let mut has_effect_var = false
    while i < Array::length(labels) {
      if label_is_effect_var(Array::get(labels, i)) {
        has_effect_var = true
      }
      i = i + 1
    }
    has_effect_var
  }
}

/// A DIRECT `perform EffName::Op` is authorized if the declared row names
/// either the whole effect (`EffName`) or, per ADR-0071's operation-level row
/// items, the exact operation (`EffName::Op`) itself -- e.g. `with Ask::Get`
/// must authorize a bare `perform Ask::Get` in the same function, exactly as
/// it already authorizes a transitive call to a callee declaring the same
/// item (that check compares the full qualified label directly, without
/// stripping to the base effect name).
export fn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {
  if decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name) {
    true
  } else {
    // #2985 review (Codex P0): under a kinded handle the erased-compatible
    // equality is off here too -- this branch is the one that admitted an
    // erased `Exception::Throw` requirement against an `Exception[String]`
    // arm after decl_authorizes_effect had already refused it.
    let strict = under_kinded_handle(labels) || row_is_kinded_exception_only(labels)
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      let lab = Array::get(labels, i)
      let equal = if strict {
        is_exception_label(lab) && is_exception_label(op_name) && String::length(exception_label_kind(op_name)) > 0 && String::length(exception_label_kind(lab)) > 0 && exception_kinds_same(exception_label_kind(lab), exception_label_kind(op_name))
      } else {
        exception_effect_labels_equal(lab, op_name)
      }
      // #3095: equal spellings, as in `decl_authorizes_effect`, can name two
      // types.
      if equal && !row_label_args_differ(lab, requirement_marked_for(op_name)) {
        found = true
      }
      i = i + 1
    }
    found
  }
}

export fn set_entry_user_effect_operations(stmts: Array[Stmt]) -> Unit {
  Array::truncate(entry_user_effect_operations, 0)
  collect_entry_user_effect_operations(stmts, entry_user_effect_operations)
}

export fn user_provider_collision_errors(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, effect_name, _, operations) => {
        let mut oi = 0
        while oi < Array::length(operations) {
          let (op_name, _, _) = Array::get(operations, oi)
          let operation = String::concat(effect_name, String::concat("::", op_name))
          if standard_provider_owns_operation(operation) {
            Array::push(errors, EEProviderOperationCollision(operation))
          } else {
            ()
          }
          oi = oi + 1
        }
      },
      SModule(_, _, body) => append_eff_errs(errors, user_provider_collision_errors(body)),
      _ => ()
    }
    i = i + 1
  }
  errors
}

fn entry_label_is_user_declared_operation(label: String) -> Bool {
  String::index_of(label, "::") > 0 && effect_row_has_label(Some(entry_user_effect_operations), label)
}

export fn standard_provider_owns_operation(label: String) -> Bool {
  match builtin_call_effect(label) {
    Some(owner) => is_entry_admitted_effect(owner) && label == canonical_builtin_name(label),
    None => false
  }
}

/// #1961: instantiate freeze uses the same identity as WIT/cache/checker.
/// A bare provider name (`Fs`) is authority for that namespace. A qualified
/// label is authority only when it is an exact registry-owned operation
/// (`Console::write_stream`). `Console::Get` is not frozen as host Console.
export fn strip_authority_grade(label: String) -> String {
  let n = String::length(label)
  if n > 0 && String::char_code_at(label, n - 1) == 63 {
    String::substring(label, 0, n - 1)
  } else {
    label
  }
}

export fn authority_is_optional(label: String) -> Bool {
  let n = String::length(label)
  n > 0 && String::char_code_at(label, n - 1) == 63
}

export fn is_instantiate_authority(label: String) -> Bool {
  let core = strip_authority_grade(label)
  if String::index_of(core, "::") < 0 {
    has_standard_host_provider(core)
  } else {
    standard_provider_owns_operation(core)
  }
}

/// #1961 / ADR-0088 L2: freeze optional resolution before run.
/// Required owned operations are Granted; Optional ones are NotGranted
/// (non-TTY instantiate default). Labels that are not instantiate
/// authority are dropped — check_entry_declared_effects already rejects them.
export fn freeze_binding_lock(labels: Array[String]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let status = if authority_is_optional(lab) {
        "NotGranted"
      } else {
        "Granted"
      }
      Array::push(out, (core, status))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The instantiate-authority labels a program's ENTRY grants, read from the
/// entry's own row (ADR-0088: an entry has no caller, so its row is a grant).
///
/// #2828 / ADR-0088's Remaining (#2332): `preflight_instantiate` and
/// `freeze_binding_lock` were written, unit-tested, and reachable from nothing
/// but their test -- measured, zero production callers. They take the entry's
/// labels, and nothing outside the checker could produce that list, so this
/// exposes it. Labels that are not instantiate authority are dropped here, the
/// same rule `freeze_binding_lock` applies, so callers see exactly the set the
/// ladder reasons about.
///
/// Empty when the program declares no entry, which is the honest answer for a
/// library: there is no grant to preflight.
export fn entry_declared_authority(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ty, body) => if is_program_entry_name(name) {
        let labels = fn_binding_effects(ty, body)
        let mut j = 0
        while j < Array::length(labels) {
          let lab = Array::get(labels, j)
          if is_instantiate_authority(lab) {
            Array::push(out, lab)
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn host_grant_covers(host_granted: Array[String], core: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(host_granted) && !found {
    let g = Array::get(host_granted, i)
    if g == core {
      found = true
    } else if String::index_of(g, "::") < 0 && has_standard_host_provider(g) {
      if core == g || effect_name_of_op(core) == g {
        found = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The authority PROVIDER a `--allow-<x>` / `--deny-<x>` flag names, or `""`
/// when the argument is not a capability flag.
///
/// Inverse of `allow_flag_for_authority`, and deliberately its neighbour: the
/// flag a diagnostic PRINTS and the flag the CLI READS must be the same
/// string, and they drift the moment the two mappings live apart. The
/// comparison is on the lowercased provider name, so `--allow-fs` and
/// `--deny-fs` both answer `Fs` (#2828, ADR-0088 L1).
export fn authority_for_capability_flag(flag: String) -> String {
  let rest = if String::starts_with(flag, "--allow-") {
    flag[8: String::length(flag)]
  } else if String::starts_with(flag, "--deny-") {
    flag[7: String::length(flag)]
  } else {
    ""
  }
  if rest == "" {
    ""
  } else {
    let names = standard_host_provider_names()
    let mut i = 0
    let mut found = ""
    while i < Array::length(names) {
      let n = Array::get(names, i)
      if lowercase_ascii(n) == rest {
        found = n
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// ASCII lowercase. The provider names are ASCII by construction (they are
/// vibe identifiers), so this needs no Unicode case table.
fn lowercase_ascii(s: String) -> String {
  let acc = StringBuilder::new()
  let mut i = 0
  while i < String::length(s) {
    let c = String::byte_at(s, i)
    if c >= 65 && c <= 90 {
      StringBuilder::push(acc, String::from_byte(c + 32))
    } else {
      StringBuilder::push(acc, String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

/// The `--allow-*` spelling a diagnostic tells the reader to pass.
///
/// #1963: this was a six-arm chain over provider NAMES -- `Fs` -> `--allow-fs`
/// and five more -- with `String::concat("--allow-", provider)` underneath. The
/// chain was doing one thing, lowercasing, one name at a time, and the fall-
/// through did not do it at all. `standard_host_provider_names()` has TEN
/// entries, so `Stderr`, `Process`, `Profiler` and `Socket` reached that
/// fallthrough and printed a capitalised flag.
///
/// Measured, the printed flag was one the CLI REJECTS:
///
///   instantiate preflight: required `Profiler::now_us` is not granted;
///   pass `--allow-Profiler` before main starts, ...
///
///   authority_for_capability_flag("--allow-Profiler") == ""     <- rejected
///   authority_for_capability_flag("--allow-profiler") == "Profiler"
///
/// and a rejected flag is reported as `--allow-Profiler: not a capability`.
/// AGENTS.md requires a diagnostic to lead with the edit that fixes it; on the
/// authority path this one led with an edit the next command refuses.
///
/// `authority_for_capability_flag` below is the reader, and it has always
/// derived the spelling with `lowercase_ascii` over the same provider list.
/// Deriving it here too is what makes the pair one rule instead of two, which
/// is this issue's criterion: no semantic decision left that is keyed on an
/// effect NAME.
export fn allow_flag_for_authority(core: String) -> String {
  let provider = if String::index_of(core, "::") < 0 {
    core
  } else {
    effect_name_of_op(core)
  }
  String::concat("--allow-", lowercase_ascii(provider))
}

/// #1961 / ADR-0088 L3: non-TTY instantiate preflight.
/// `host_granted` is what the composed host will actually inject this run.
/// Required instantiate-authority labels missing from it abort before main,
/// with the `--allow-*` spelling. Optional missing stay NotGranted; a
/// granted optional becomes Granted. Labels that are not instantiate
/// authority are dropped, same as freeze_binding_lock.
export fn preflight_instantiate(labels: Array[String], host_granted: Array[String]) -> Array[(String, String)] with Exception {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let granted = host_grant_covers(host_granted, core)
      if authority_is_optional(lab) {
        let status = if granted {
          "Granted"
        } else {
          "NotGranted"
        }
        Array::push(out, (core, status))
      } else if granted {
        Array::push(out, (core, "Granted"))
      } else {
        throw(String::concat("instantiate preflight: required `", String::concat(core, String::concat("` is not granted; pass `", String::concat(allow_flag_for_authority(core), String::concat("` before main starts, or mark it optional (`allows ", String::concat(core, "?`)")))))))
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn authority_covers_operation(auth: String, emitted: String) -> Bool {
  if authority_is_optional(auth) {
    false
  } else if auth == emitted {
    true
  } else if String::index_of(auth, "::") < 0 && standard_provider_owns_operation(emitted) {
    effect_name_of_op(emitted) == auth
  } else if auth == "Console" && is_legacy_console_provider(effect_name_of_op(emitted)) {
    // The instantiate-grant half of #2102's containment. `allows` is a
    // SEPARATE authorization path from the `with` row (ADR-0075/0084/0088:
    // authority is fixed once, at instantiate), so teaching only
    // `decl_authorizes_effect` left the split form unable to express what the
    // bare form could -- `fn main with () allows Console { println(..) }` was
    // rejected while `fn main with Console { println(..) }` compiled. Same
    // one-way rule and same reason: `Console` is the union, the legacy labels
    // are subsets, and the reverse would widen authority.
    true
  } else {
    false
  }
}

/// ADR-0088: does the declared label `lab`, when it carries the Optional
/// grade, cover `op_name` -- the operation itself (`Fs::read_file?`) or its
/// whole provider (`Fs?`, every operation of the provider)? A required label
/// never answers here: the plain-label rules decide those.
fn optional_label_covers_op(lab: String, op_name: String) -> Bool {
  if authority_is_optional(lab) {
    let core = strip_authority_grade(lab)
    core == op_name || core == effect_name_of_op(op_name) || authority_covers_operation(core, op_name)
  } else {
    false
  }
}

/// ADR-0088: the REQUIRED label of `labels` that covers `op_name` -- the
/// operation itself or its provider -- or "" when none. Required is the join
/// of the grade lattice, so such a label absorbs any optional grant of the
/// same operation: the operation is always granted, and a `perform?` on it
/// would advertise a `NotGranted` arm that cannot run.
export fn required_grant_covering_op(labels: Array[String], op_name: String) -> String {
  let mut i = 0
  let mut found = ""
  while i < Array::length(labels) && String::length(found) == 0 {
    let lab = Array::get(labels, i)
    if authority_covers_operation(lab, op_name) {
      found = lab
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn decl_authorizes_optional_op(labels: Array[String], op_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) && !found {
    if optional_label_covers_op(Array::get(labels, i), op_name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn perform_question_op_name(arg: Expr) -> Option[String] {
  match arg {
    ECall(op_callee, _, _, _) => match op_callee {
      EIdent(op_name, _) => Some(op_name),
      _ => None
    },
    _ => None
  }
}

export fn entry_user_operation_requires_handler(label: String) -> Bool {
  // #1961: a source-declared operation is algebraic even when its spelling
  // matches a host provider. Exact collisions are rejected separately and
  // never grant provider authority from the text of the perform.
  entry_label_is_user_declared_operation(label)
}

export fn entry_unresolved_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    if label_is_effect_var(label) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

export fn entry_unadmitted_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    // Row variables are separated above so they receive the closed-row hint;
    // this list contains only concrete effects that lack an entry owner.
    // The Optional grade is a property of the grant, not of the label's
    // owner: classify `Fs::read_file?` as `Fs::read_file`.
    let core = strip_authority_grade(label)
    if !label_is_effect_var(label) && (entry_user_operation_requires_handler(core) || !is_entry_admitted_effect(core)) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

export fn entry_handler_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let base = effect_name_of_op(Array::get(labels, i))
    if effect_row_has_label(Some(out), base) {
      ()
    } else {
      Array::push(out, base)
    }
    i = i + 1
  }
  sort_labels(out)
}

/// ADR-0088: the first missing label that an OPTIONAL grant in `declared`
/// covers, paired with that grant as written (`Fs::read_file?`, or the
/// provider-wide `Fs?`); `("", "")` when no optional grant reaches any of
/// them. The pair is what the strict-grade diagnostic quotes.
export fn optional_grant_for(declared: Array[String], missing: Array[String]) -> (String, String) {
  let mut i = 0
  let mut op = ""
  let mut grant = ""
  while i < Array::length(missing) && String::length(grant) == 0 {
    let m = Array::get(missing, i)
    let mut di = 0
    while di < Array::length(declared) && String::length(grant) == 0 {
      let lab = Array::get(declared, di)
      if optional_label_covers_op(lab, m) {
        op = m
        grant = lab
      } else {
        ()
      }
      di = di + 1
    }
    i = i + 1
  }
  (op, grant)
}
