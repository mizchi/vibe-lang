/// #2964: every missing label is the ERASED exception (`Exception` /
/// `Exception::Throw`).
fn missing_is_erased_exception_only(_ missing: String) -> Bool {
  let parts = row_items(missing)
  let mut ok = Array::length(parts) > 0
  let mut i = 0
  while i < Array::length(parts) {
    let p = Array::get(parts, at = i)
    // #1963: the exception policy's predicates, not the spelling -- the
    // legacy `Error` alias is the same erased exception.
    if !is_exception_label(p) || String::length(exception_label_kind(p)) > 0 {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// #2964: the declared row names a kinded exception and no erased one.
fn declared_is_kinded_exception(_ declared: String) -> Bool {
  let parts = row_items(declared)
  let mut kinded = false
  let mut erased = false
  let mut i = 0
  while i < Array::length(parts) {
    let p = Array::get(parts, at = i)
    if !is_exception_label(p) {
      ()
    } else if String::length(exception_label_kind(p)) > 0 {
      kinded = true
    } else {
      erased = true
    }
    i = i + 1
  }
  kinded && !erased
}

/// #3417: the first kind in `offending`, spelled the way a reader writes it
/// (`row_as_source`), and the alias declarations that spelling needs ("" when
/// none). `offending` is a stored row, so a kind such as
/// `Exception[(Int, Int) -> Int]` is one item, not two.
fn first_offending_kind(_ offending: String) -> (String, String) {
  let items = row_items(offending)
  let first = if Array::length(items) > 0 {
    Array::get(items, at = 0)
  } else {
    ""
  }
  (row_as_source(first), row_unspellable_kind_decls(first))
}

export fn effect_error_to_string(_ err: EffectError) -> String {
  match err {
    // #3520: lead with the edit, which depends on where the call sits, and
    // point at the callee.
    EEEffectfulCallOutsideEffect(name, off, kind) => {
      let shown = String::concat("`", String::concat(name, "`"))
      let task_hint = "; in a `TaskGroup` task, start the task with `TaskGroup::spawn_suspend` (effectful call outside effectful context)"
      let body = if kind == 1 {
        String::concat("give this closure a row of its own (`() -> T with Async { .. }`), or move this call out of it: ", String::concat(shown, String::concat(" needs `Async`, and a closure with no row runs as a plain one", task_hint)))
      } else if kind == 3 {
        String::concat("move this call out of the closure: ", String::concat(shown, String::concat(" needs `Async`, and the closure is passed where no `Async` is expected, so it runs as a plain function", task_hint)))
      } else if kind == 2 {
        String::concat("add `Async` to this closure's row: ", String::concat(shown, " needs it (effectful call outside effectful context)"))
      } else {
        String::concat("add `Async` to this function's row (`with Async`; an entry writes `allows Async`): ", String::concat(shown, " needs it (effectful call outside effectful context)"))
      }
      // A start offset only: `name` may be the canonical spelling of a renamed
      // import (`S::next` written, `StdinStream::next` here), so its length is
      // not the written callee's (Codex on #3552).
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with` row or wrap in a `handle`")))),
    // #639: expected-vs-actual effect rows as a set difference, then ONE
    // deterministic fix-it hint line targeting the enclosing declaration
    // (for a call-site leak that is the CALLER, not the callee).
    EEMultipleExceptionArms(fname, arms, off) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      // #3548: located at the second exception arm, the one that never runs.
      let at = if off >= 0 {
        String::concat(" [@off=", String::concat(__to_string(off), "]"))
      } else {
        ""
      }
      String::concat("a handle may have only ONE exception arm, in ", String::concat(where_, String::concat(" it has { ", String::concat(arms, String::concat(" }: the exception channel carries no kind and only the first exception arm is compiled, so the others can never run\nhint: nest one handle per kind inside another, or keep one arm -- an erased `Exception::Throw(_)` arm that leaves its payload unread catches every kind", at)))))
    },
    EEKindedHandleCatchesAll(fname, handler, offending, off) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      let body = String::concat("handler arm `", String::concat(handler, String::concat("::Throw` catches EVERY exception its body raises at run time (the exception channel carries no kind), so the body may raise only `", String::concat(handler, String::concat("`; in ", String::concat(where_, String::concat(" it also raises { ", String::concat(offending, " }\nhint: catch that kind in a handle of its own, nested inside this one around the call that raises it (a handle has only one exception arm), use the erased `Exception::Throw(m)` arm (which catches everything, with an untyped payload), give the throw a payload of the handled kind, or move that call outside this handle"))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEErasedArmReadsOtherKind(fname, binder, offending, off) => {
      let block = entry_block_display_name(fname)
      let where_ = if fname == "#lambda:" || String::length(fname) == 0 {
        "this handle's body"
      } else if String::starts_with(fname, prefix = "#lambda:") {
        String::concat("the lambda '", String::concat(String::substring(fname, start = 8, end = String::length(fname)), "'"))
      } else if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      let name = if String::contains(binder, needle = " ") {
        "e"
      } else {
        binder
      }
      let (first, decls) = first_offending_kind(offending)
      let edit = String::concat(decls, String::concat("write `", String::concat(first, String::concat("::Throw(", String::concat(name, ")` to catch it")))))
      let why = String::concat(": the erased arm `Exception::Throw(", String::concat(name, String::concat(")` reads `", String::concat(name, String::concat("` as the thrown message, a `String`, and the kind is not carried at run time, but in ", String::concat(where_, String::concat(" the handled body raises { ", String::concat(offending, " }"))))))))
      let more = "\nhint: a kinded arm binds the payload at its own type; for several kinds, nest one handle per kind, or leave the payload unread (`Exception::Throw(_)`), which catches every kind. A callee declared with the erased `with Exception` raises the kinds its body throws"
      let body = String::concat(edit, String::concat(why, more))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEErasedValueOtherKind(fname, value, offending, off) => {
      let (first, decls) = first_offending_kind(offending)
      let where_ = erased_error_place(fname)
      let edit = String::concat(decls, String::concat("declare `", String::concat(value, String::concat("` `with ", String::concat(first, "` instead of the erased `with Exception`, and the parameter, annotation or field it is passed to with that kind (or a row variable alone, `with e`, with no erased `Exception` beside it)")))))
      let why = String::concat(": the row of `", String::concat(value, String::concat("` is the erased `with Exception`, but it raises { ", String::concat(offending, String::concat(" }, and in ", String::concat(where_, " it is used as a value whose row does not name that kind; a function value typed with the erased row raises only messages (`String`) to the code that calls it, so an erased arm `Exception::Throw(m)` would read the payload as a `String`"))))))
      let more = String::concat("\nhint: a call `", String::concat(value, String::concat("(..)` and an unannotated alias `let f = ", String::concat(value, String::concat("` keep the kinds, and a receiver declared `with Exception + ", String::concat(first, String::concat("` takes `", String::concat(value, "` as it is"))))))))
      erased_error_at(body = String::concat(edit, String::concat(why, more)), off = off)
    },
    EEErasedClosureOtherKind(fname, offending, off) => {
      let (first, decls) = first_offending_kind(offending)
      let where_ = erased_error_place(fname)
      let edit = String::concat(decls, String::concat("write `with ", String::concat(first, "` in this closure's function type (or throw a `String`)")))
      let why = String::concat(": its row is the erased `with Exception`, which raises only messages (`String`) to the code that calls the closure, but in ", String::concat(where_, String::concat(" its body raises { ", String::concat(offending, " }"))))
      let more = "\nhint: the kind is not carried at run time, so an erased arm `Exception::Throw(m)` around a call of the closure would read the payload as a `String`; the row is the parameter's, the annotation's or the field's the closure is written for, or its own"
      erased_error_at(body = String::concat(edit, String::concat(why, more)), off = off)
    },
    EEKindedHandleOpenRow(fname, handler, vars, off) => {
      let block = entry_block_display_name(fname)
      // A handle in a local lambda's body names that lambda (#3540).
      let where_ = if fname == "#lambda:" {
        "this lambda"
      } else if String::starts_with(fname, prefix = "#lambda:") {
        String::concat("the lambda '", String::concat(String::substring(fname, start = 8, end = String::length(fname)), "'"))
      } else if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      let kind = exception_label_kind(handler)
      let edit = String::concat("move this `", String::concat(handler, String::concat("::Throw` handle out of ", String::concat(where_, String::concat(" to its caller, where { ", String::concat(vars, " } is filled in"))))))
      let edit2 = String::concat("; or give the callback the closed row `with ", String::concat(handler, String::concat("` in place of { ", String::concat(vars, " }; or catch with the erased `Exception::Throw(m)` arm"))))
      let why = String::concat(". The handle's body runs the effect row variable { ", String::concat(vars, String::concat(" }, which a caller may fill with another exception kind, and a kinded arm catches EVERY exception at run time (the exception channel carries no kind), so it would read that payload as `", String::concat(kind, "`"))))
      let body = String::concat(edit, String::concat(edit2, why))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEEffectRowMismatch(fname, missing0, declared0, required0, off) => {
      // #3051: a published row spells a formal `NAME$K`; show `NAME`.
      // #3351: and a struct `^Name` or an enum `^^Name`; show `Name`.
      let missing = strip_published_row_marks(missing0)
      let declared = strip_published_row_marks(declared0)
      let required = strip_published_row_marks(required0)
      let block = entry_block_display_name(fname)
      let closure_row = fname == closure_row_mismatch_marker()
      let head = if closure_row {
        "effect row mismatch for this closure literal's own row"
      } else if String::length(block) > 0 {
        String::concat("effect row mismatch for ", block)
      } else if String::length(fname) > 0 {
        String::concat("effect row mismatch for '", String::concat(fname, "'"))
      } else {
        "effect row mismatch"
      }
      let detail = if String::length(declared) > 0 {
        String::concat(" (declared { ", String::concat(declared, String::concat(" }, requires { ", String::concat(row_set_for_reader(required), " })"))))
      } else {
        String::concat(" (no 'with' clause, requires { ", String::concat(row_set_for_reader(required), " })"))
      }
      // ADR-0088: an entry point (`main` / `_start`, a `test` / `bench` /
      // `example` block) GRANTS its row, so the edit it is told is `allows`;
      // a called function requires, so its edit stays `with`.
      let entry_block = entry_block_display_name(fname)
      let hint = if closure_row {
        // #3520: the enclosing function has these effects; the closure's
        // written row does not. Dropping the row lets the closure use the
        // function's -- the one edit that also works for a
        // `TaskGroup::spawn_suspend` task, whose row cannot name them.
        String::concat("\nhint: drop this closure's row so it uses the enclosing function's effects; a row written on it instead must be 'with ", String::concat(row_as_source(required), "', and a parameter the closure is passed to must accept that row too"))
      } else if String::contains(required, needle = "[?]") {
        // #3408 (Codex on #3409): a generic function passed by NAME to a
        // callee that runs it has no call here to fix its formals, so the
        // instantiation its row names is unknown (`Box[?]`) and no row
        // authorizes it. The edit is to call it where the type is known.
        "\nhint: this call reaches a generic function that is passed by name to a callee that runs it; its row names its own type parameter, which only a call fixes -- where it is passed, pass a lambda that calls it at the type you mean instead (`(x: Int) -> mk(x)` rather than `mk`)"
      } else if row_has_ambiguous_label(required) {
        // Codex on #3055: a call whose instantiation is ambiguous (`?S`, two
        // merged sources' calls at one position) fails closed, and no row can
        // spell `?S`, so the hint names the cause instead of an edit.
        "\nhint: the type a generic callee's row takes at this call could not be determined -- another call at the same source position (sources merged without separate positions) instantiates it differently -- so no row authorizes it; check this file on its own with `vibe check` to see the concrete row"
      } else if missing_is_erased_exception_only(missing) && declared_is_kinded_exception(declared) {
        // #2964 / #3015: the requirement is an exception whose KIND this check
        // could not resolve, under a row that promises kinds. Adding the erased
        // label is one honest edit; the others keep the kinded promise. A
        // value an erased arm caught is of no known kind however it is
        // rethrown, so its edit is the kinded arm (#3551 review).
        "\nhint: the kind of this exception is not known here, and a kinded row promises exactly its kinds -- give the thrown value a type (`let e: K = ..` then `throw(e)`), give the callback or callee a kinded `with Exception[K]` row, rethrow what a kinded arm `Exception[K]::Throw(e)` caught instead of the erased `Exception::Throw(e)`, or declare the erased `with Exception`"
      } else if String::length(fname) == 0 {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), "' to the enclosing function"))
      } else if String::length(entry_block) > 0 {
        // A test / bench / example block's declared row is the ambient
        // default, not a clause the source wrote, so the edit is to add one.
        String::concat("\nhint: add 'allows ", String::concat(row_as_source(required), String::concat("' to ", entry_block)))
      } else if is_program_entry_name(fname) && String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat(" allows ", String::concat(row_as_source(required), "'"))))
      } else if is_program_entry_name(fname) {
        String::concat("\nhint: change 'allows ", String::concat(row_as_source(declared), String::concat("' to 'allows ", String::concat(row_as_source(required), String::concat("' on '", String::concat(fname, "'"))))))
      } else if String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat("(...) -> T with ", String::concat(row_as_source(required), "'"))))
      } else {
        // #3549: the clause is already there, so "add 'with <whole row>'"
        // asked for a second one; the edit is to the clause that exists.
        String::concat("\nhint: change 'with ", String::concat(row_as_source(declared), String::concat("' to 'with ", String::concat(row_as_source(required), String::concat("' on '", String::concat(fname, "'"))))))
      }
      // A kind the row syntax cannot spell is pasted through an alias, whose
      // declaration leads the hint.
      let decls = row_unspellable_kind_decls(required)
      let hint = if String::length(decls) > 0 && String::starts_with(hint, prefix = "\nhint: ") {
        String::concat("\nhint: ", String::concat(decls, String::substring(hint, start = 7, end = String::length(hint))))
      } else {
        hint
      }
      let body = String::concat(head, String::concat(": missing { ", String::concat(row_set_for_reader(missing), String::concat(" }", String::concat(detail, hint)))))
      // #1514: marker LAST so the hint line stays the visible tail; the decoder
      // strips it before the user ever sees the string.
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUndischargedEntryEffect(entry_name, effects, handlers, off, capability_note) => {
      let note = if String::length(capability_note) > 0 {
        // On the hint's own line: a separate `note:` line renders as an
        // error of its own and takes the location off the first.
        String::concat(" -- ", capability_note)
      } else {
        ""
      }
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" cannot discharge { ", String::concat(effects, String::concat(" }: no host provider or runtime handler owns this effect\nhint: ", String::concat(row_unspellable_kind_decls(handlers), String::concat("wrap the operation in `handle ... with ", String::concat(row_as_source(handlers), String::concat(" { ... }` before it reaches the entry boundary", note)))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEVacuousEntryEffect(entry_name, label, off) => {
      let effect = row_label_base(effect_name_of_op(label))
      let body = "entry point \{entry_display_name(entry_name)} allows `\{label}`, which nothing in its body handles\nhint: remove `\{label}` from the `allows` row: no host grants an effect the program declares, so on an entry row it only records a `handle ... with \{effect} { ... }` inside the entry, and there is none"
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnresolvedEntryEffectRow(entry_name, variables, off) => {
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" has unresolved effect row { ", String::concat(variables, " }: entry rows must be concrete\nhint: close the entry row, or discharge each concrete effect with `handle` before it reaches the entry boundary"))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGrantForRequiredCall(fname, op, grant, off) => {
      // An entry GRANTS (`allows`), a called function REQUIRES (`with`).
      let is_entry = is_entry_point_name(fname)
      let keyword = if is_entry {
        "allows"
      } else {
        "with"
      }
      let verb = if is_entry {
        "granted"
      } else {
        "declared"
      }
      // The grant is quoted as written -- `Fs::read_file?`, or the
      // provider-wide `Fs?` -- so the "drop the `?`" edit names that label.
      let head = String::concat("`", String::concat(op, String::concat("` is ", String::concat(verb, String::concat(" as optional (`", String::concat(keyword, String::concat(" ", String::concat(grant, String::concat("`) but ", String::concat(row_owner_display_name(fname), " calls it as required"))))))))))
      // A call to an `extern effect` operation is charged the effect's bare
      // label (#4082), which is no callee: `perform?` takes the operation.
      let callee = if String::index_of(op, needle = "::") < 0 {
        "\{op}::<operation>"
      } else {
        op
      }
      let hint = String::concat("\nhint: call it with `perform? ", String::concat(callee, String::concat("(..)` and match the `Attempt`, or drop the `?` (`", String::concat(keyword, String::concat(" ", String::concat(strip_authority_grade(grant), "`)"))))))
      let body = String::concat(head, hint)
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGradeNotCapability(fname, label) => {
      let core = strip_authority_grade(label)
      String::concat("`", String::concat(label, String::concat("` in the row of ", String::concat(row_owner_display_name(fname), String::concat(": `?` marks a host capability optional, and `", String::concat(core, String::concat("` is not one (it has no host provider)\nhint: drop the `?` -- `", String::concat(core, "` is required, handled or runtime-managed, never optional"))))))))
    },
    EEUnknownProviderOperation(entry_name, label) => {
      let provider = effect_name_of_op(label)
      let head = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" grants `", String::concat(label, String::concat("`, but the `", String::concat(provider, "` provider has no such operation"))))))
      String::concat(head, String::concat("\nhint: grant the provider (`allows ", String::concat(provider, "`) or one of its operations")))
    },
    EEProviderOperationCollision(operation) => String::concat("user effect operation `", String::concat(operation, "` collides with a registry-owned host provider operation; rename the user operation so it cannot impersonate provider authority")),
    // #3348: the range of the assignment's target name.
    EEAssignImmutable(name, off) => {
      let body = String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)"))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + String::length(name)), "]")))))
      } else {
        body
      }
    },
    EEStdinProviderValueReference(name) => String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function")),
    EEHandleNeverFires(eff) => {
      let tail = String::concat(eff, "::..` and calls an opaque function value. A continuation captured by another handler carries THAT handler with it, so wrapping its invocation in a new `handle` does not switch handlers (non-scoped resumption is unsupported -- ADR-0089 Part A, #1347). Drive the continuation without the wrapping handle, or handle the effect where it is performed")
      String::concat("handle of effect '", String::concat(eff, String::concat("' can never fire: this body reaches no `perform ", tail)))
    },
    EEHandleRowlessClosure(eff, cname, off) => {
      let edit = String::concat("give the local closure `", String::concat(cname, String::concat("` an effect row -- `let ", String::concat(cname, String::concat(" = (..) -> T with ", String::concat(eff, String::concat(" { .. }` -- or write its `perform ", String::concat(eff, "::..` directly in the handled body"))))))))
      let why = String::concat(": `", String::concat(cname, String::concat("` has no row, so this handle of effect '", String::concat(eff, "' cannot see the perform that the call to it reaches"))))
      let body = String::concat(edit, why)
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEHandleMutableAlias(eff, cname, off) => {
      let body = String::concat("handle of effect '", String::concat(eff, String::concat("' cannot compile a call through mutable local `", String::concat(cname, "`: bind the function with immutable `let` and `with "))))
      let message = String::concat(body, String::concat(eff, "`, or call the effectful function directly inside the handle"))
      if off >= 0 {
        String::concat(message, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        message
      }
    },
    EEEmptyHandle => "handler must contain at least one arm; an empty handler cannot discharge an effect",
    EEPerformQuestionRequiresOptional(fname, operation, off) => {
      // The edit names the keyword the row's owner takes: an entry GRANTS
      // (`allows`), a called function REQUIRES (`with`) -- telling a called
      // function to write `allows` would only lead to the parse error that
      // refuses it there (Codex review on PR #2653).
      let keyword = if is_entry_point_name(fname) {
        "allows"
      } else {
        "with"
      }
      let body = String::concat("`perform? ", String::concat(operation, String::concat("` requires the optional grade: write `", String::concat(keyword, String::concat(" ", String::concat(operation, String::concat("?` on ", String::concat(row_owner_display_name(fname), String::concat(", or call `", String::concat(operation, "(..)` plainly"))))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionAlwaysGranted(fname, operation, grant, off) => {
      let block = entry_block_display_name(fname)
      let body = if String::length(grant) == 0 {
        // A test artifact resolves every optional grant to `Granted`
        // (optional_perform_artifact_resolution): the block runs with full
        // authority, so a `perform?` written in it advertises an arm that
        // can never run.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` in ", String::concat(block, ": a `test` / `bench` / `example` block runs with full authority, so the operation is always granted and `NotGranted` can never happen here"))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or move the `perform?` into a function that requires `with ", String::concat(operation, "?` and call that from the block")))))
      } else {
        // Required is the join of the grade lattice: a required grant of the
        // operation or of its provider absorbs the optional one.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` can never be `NotGranted` here: ", String::concat(row_owner_display_name(fname), String::concat(" grants `", String::concat(grant, String::concat("` as required, and Required absorbs the optional grade of `", String::concat(operation, "`"))))))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or grant `", String::concat(operation, String::concat("?` without the required `", String::concat(grant, "`")))))))
      }
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionSourceShadow(operation, off) => {
      let body = String::concat("`perform? ", String::concat(operation, "(..)` resolves to a source function, not a capability operation; rename the source function or call the capability under an unshadowed name"))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionInvalidOperand(off) => {
      let body = "`perform?` takes a capability-operation call, like `perform? Fs::read_file(path)`. Either call an operation here, or drop `perform?` from this expression."
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    }
  }
}

//# Async-scoped effect enforcement (the pass wired into `check_program`)
//
// This pass enforces ONLY the `Async` effect, and only
// for async PRIMITIVES — builtins such as `await(..)` and `sleep(..)`
// whose type carries `with Async`, including the `await(..)` the async
// desugar injects over a Future-returning iterator. A primitive must appear
// inside a function/lambda annotated `with Async`.
//
// Crucially it does NOT propagate to user functions that merely COMPOSE async
// work: calling a `with Async` helper (e.g. `AsyncIter::collect`) from a
// sync context is allowed (await is the identity on the synchronous backend,
// and on a real async backend the value/Future mismatch is a separate type
// error). Only env-absent BUILTIN primitives are checked, so the compiler /
// prelude — which use `Async` only in the disciplined async_iter terminals —
// stay green while `for` over an async stream becomes sound (#2+#3).

export fn effect_opt_is_async(_ eff: Option[String]) -> Bool {
  effect_row_contains_label(eff = eff, wanted = "Async")
}

fn is_stdin_provider_surface(_ name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// #1539: the four public provider operations are syntactic direct-call
/// primitives, not first-class function values. A direct `ECall` skips its
/// exact builtin callee but still checks every argument; every other expression
/// position is traversed structurally. This rejects aliases, chains,
/// conditionals, returned/container values, and unknown HOF transport without
/// attempting the generic effect-flow propagation deliberately deferred by
/// #1536. An explicitly effectful user wrapper remains an ordinary function.
fn check_stdin_provider_direct_calls_expr(_ expr: Expr) -> Array[EffectError] {
  let out = array_empty()
  check_stdin_provider_direct_calls_expr_into(expr = expr, out = out)
  out
}

fn check_stdin_provider_direct_calls_expr_into(expr: Expr, out: Array[EffectError]) -> Unit {
  match expr {
    ECall(EIdent(name, _), args, _, _) => {
      if is_stdin_provider_surface(name) {
        let mut ai = 0
        while ai < Array::length(args) {
          check_stdin_provider_direct_calls_expr_into(expr = Array::get(args, at = ai), out = out)
          ai = ai + 1
        }
      } else {
        let mark = expr_children_push(expr)
        let end = expr_children_top()
        let mut i = mark
        while i < end {
          check_stdin_provider_direct_calls_expr_into(expr = expr_child_at(i), out = out)
          i = i + 1
        }
        expr_children_pop(mark)
      }
    },
    EIdent(name, _) => if is_stdin_provider_surface(name) {
      Array::push(out, value = EEStdinProviderValueReference(name))
    } else {
      ()
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_stdin_provider_direct_calls_expr_into(expr = expr_child_at(i), out = out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

fn check_stdin_provider_direct_calls_stmt(_ stmt: Stmt) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, _, body) => check_stdin_provider_direct_calls_expr(body),
    SLetMut(_, _, body) => check_stdin_provider_direct_calls_expr(body),
    STest(_, body) => check_stdin_provider_direct_calls_expr(body),
    SBench(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExample(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExpr(body) => check_stdin_provider_direct_calls_expr(body),
    SLetPat(_, body) => check_stdin_provider_direct_calls_expr(body),
    SModule(_, _, inner) => check_stdin_provider_direct_calls_stmts(inner),
    _ => array_empty()
  }
}

export fn check_stdin_provider_direct_calls_stmts(_ stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(dst = errors, src = check_stdin_provider_direct_calls_stmt(Array::get(stmts, at = i)))
    i = i + 1
  }
  errors
}

/// True only for async-effect BUILTIN primitives (await/sleep/...).
/// A name bound in `env` (a user/prelude function) is intentionally NOT treated
/// as a primitive even if its type is `with Async`, except the four exact
/// compiler-owned stdin provider names imported from their public contract.
/// #2386: `is_async_primitive`'s answers for the walk in progress. The walk
/// hands every call site the same env (nothing in it extends `env`; locals go
/// through `afe_bind_*`), and the answer for a name is a full env miss for
/// every user callee -- a chain walk per call site. Each exported entry
/// clears it, so an entry with another env never reads a previous walk's
/// answer. Values: 1 = async primitive, 0 = not.
let afe_async_primitive_memo: Array[MutMap[String, Int]] = [
  MutMap::new_string()
]

export fn afe_reset_entry_memos() -> Unit {
  Array::set(afe_async_primitive_memo, at = 0, value = MutMap::new_string())
  Array::set(afe_builtin_async_iter_cell, at = 0, value = -1)
  Array::set(afe_callable_body_index, at = 0, value = MutMap::new_string())
}

export fn is_async_primitive(name: String, env: TypeEnv) -> Bool {
  let memo = Array::get(afe_async_primitive_memo, at = 0)
  match MutMap::get(memo, k = name) {
    Some(v) => v == 1,
    None => {
      let answer = is_async_primitive_uncached(name = name, env = env)
      MutMap::set(memo, k = name, v = if answer {
        1
      } else {
        0
      })
      answer
    }
  }
}

fn is_async_primitive_uncached(name: String, env: TypeEnv) -> Bool {
  if is_stdin_provider_surface(name) {
    // Imported package contracts bind these exact public names in env, but
    // they remain compiler-owned primitives after canonical import rewriting.
    // Do not let that binding suppress their Async authority requirement.
    match lookup_builtin(canonical_builtin_name(name)) {
      Some(ty) => match ty {
        CtFn(_, _, eff) => effect_opt_is_async(eff),
        _ => false
      },
      None => false
    }
  } else {
    match env_lookup(env = env, name = name) {
      Some(_) => false,
      None => {
        let normalized = canonical_builtin_name(name)
        match lookup_builtin(normalized) {
          Some(ty) => match ty {
            CtFn(_, _, eff) => effect_opt_is_async(eff),
            _ => false
          },
          None => false
        }
      }
    }
  }
}

fn afe_has_recorded_builtin_async_iter_import(_ name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_builtin_async_iter_import_names) && !found {
    if Array::get(afe_builtin_async_iter_import_names, at = i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Head name of an inferred checker type (`AsyncIter[Int]` -> "AsyncIter").
///
/// #1347/#1358 (Codex P1 on PR #1364): `CtEnum` counts too. An ENUM can
/// implement an async iterator trait, and an iterand reached through its
/// constructor (`Chan(3)`), a factory call, or an inferred local carries
/// `CtEnum` -- dropping it here lost the head name while the desugar still
/// resolved it from the constructor's return metadata and lowered the loop
/// through `Chan::next` with an injected `await`. Verified against a repro
/// that RAN the await loop.
fn afe_type_head_name(_ t: Type) -> Option[String] {
  match t {
    CtNamed(n, args) => if n == "#hkt" {
      if Array::length(args) >= 1 {
        match Array::get(args, at = 0) {
          CtVar(_) => None,
          other => afe_type_head_name(other)
        }
      } else {
        None
      }
    } else {
      Some(n)
    },
    CtStruct(n) => Some(n),
    CtEnum(n) => Some(n),
    CtConstructor(n, _) => Some(n),
    CtApplied(head, _) => afe_type_head_name(head),
    _ => None
  }
}

/// Head name of a source annotation (`s: AsyncIter[Int]` -> "AsyncIter").
fn afe_texpr_head_name(_ t: TypeExpr) -> Option[String] {
  match t {
    TyName(n) => Some(n),
    TyApp(n, _) => Some(n),
    _ => None
  }
}

fn afe_lookup_local(locals: AfeLocals, name: String) -> Option[String] {
  let mut cur = locals
  let mut found = None
  let mut go = true
  while go {
    match cur {
      AlNil => {
        go = false
      },
      AlBind(n, h, rest) => if n == name {
        found = Some(h)
        go = false
      } else {
        cur = rest
      },
      AlMask(n, rest) => if n == name {
        go = false
      } else {
        cur = rest
      }
    }
  }
  found
}

/// Whether `name` is bound by the walk's locals at all, with or without a
/// known head (#3163).
export fn afe_binds_local(locals: AfeLocals, name: String) -> Bool {
  let mut cur = locals
  let mut found = false
  let mut go = true
  while go {
    match cur {
      AlNil => {
        go = false
      },
      AlBind(n, _, rest) => if n == name {
        found = true
        go = false
      } else {
        cur = rest
      },
      AlMask(n, rest) => if n == name {
        found = true
        go = false
      } else {
        cur = rest
      }
    }
  }
  found
}

export fn afe_bind_local(locals: AfeLocals, name: String, head: Option[String]) -> AfeLocals {
  match head {
    Some(h) => AlBind(name, h, locals),
    None => AlMask(name, locals)
  }
}

export fn afe_bind_params(locals: AfeLocals, params: Array[(String, Option[TypeExpr])], env: TypeEnv) -> AfeLocals {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, at = i)
    let name = effect_param_base_name(pname)
    let head = match ptype {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(head = h, provenanced = afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    }
    cur = afe_bind_local(locals = cur, name = name, head = head)
    cur = match ptype {
      Some(te) => afe_bind_annotation_payloads(locals = cur, name = name, te = te, env = env),
      None => afe_clear_annotation_payloads(locals = cur, name = name)
    }
    i = i + 1
  }
  cur
}

/// #3198 review: the heads an ANNOTATED aggregate's payloads carry, so a match
/// arm over that name can hand them to its binders. The lowering recovers the
/// same payloads from the annotation (`seed_var_types`,
/// `arm_binder_var_types_env`) and builds the awaiting loop from them, so a
/// binder this walk left headless -- `match o { Some(c) => for x in c { .. } }`
/// with `o: Option[Countdown]` -- was accepted in a row-free function while the
/// desugar inserted the builtin `await`.
///
/// Recorded: `Option[T]` (`Some`), `Result[T, E]` (`Ok`, `Err`) and a tuple
/// annotation (its shape, which `.0` / `.1` projections already read).
fn afe_bind_annotation_payloads(locals: AfeLocals, name: String, te: TypeExpr, env: TypeEnv) -> AfeLocals {
  let cleared = afe_clear_annotation_payloads(locals = locals, name = name)
  match te {
    TyApp(head, args) => if head == "Option" && Array::length(args) == 1 {
      afe_bind_local(locals = cleared, name = afe_ctor_payload_key(name = name, ctor = "Some"), head = Some(afe_payload_heads_csv(items = args, env = env)))
    } else if head == "Result" && Array::length(args) == 2 {
      let with_ok = afe_bind_local(locals = cleared, name = afe_ctor_payload_key(name = name, ctor = "Ok"), head = Some(afe_payload_heads_csv(items = [
        Array::get(args, at = 0)
      ], env = env)))
      afe_bind_local(locals = with_ok, name = afe_ctor_payload_key(name = name, ctor = "Err"), head = Some(afe_payload_heads_csv(items = [
        Array::get(args, at = 1)
      ], env = env)))
    } else {
      cleared
    },
    TyTuple(items) => if Array::length(items) > 0 {
      afe_bind_local(locals = cleared, name = afe_tuple_shape_key(name), head = Some(afe_payload_heads_csv(items = items, env = env)))
    } else {
      cleared
    },
    _ => cleared
  }
}

// Compare an internal metadata key without allocating prefix/name joins.
fn afe_metadata_key_is(key: String, prefix: String, name: String) -> Bool {
  let start = String::length(prefix)
  let len = String::length(name)
  if String::length(key) != start + len || !String::starts_with(key, prefix = prefix) {
    return false
  }
  let mut i = 0
  while i < len {
    if String::char_code_at(key, at = start + i) != String::char_code_at(name, at = i) {
      return false
    }
    i = i + 1
  }
  true
}

fn afe_metadata_key_bit(key: String, name: String, wanted: Int) -> Int {
  if !String::starts_with(key, prefix = "__") {
    return 0
  }
  if (wanted&1) != 0 && afe_metadata_key_is(key = key, prefix = "__ctorpay$Some$", name = name) {
    1
  }
  else if (wanted&2) != 0 && afe_metadata_key_is(key = key, prefix = "__ctorpay$Ok$", name = name) {
    2
  }
  else if (wanted&4) != 0 && afe_metadata_key_is(key = key, prefix = "__ctorpay$Err$", name = name) {
    4
  }
  else if (wanted&8) != 0 && afe_metadata_key_is(key = key, prefix = "__tupshape$", name = name) {
    8
  }
  else if (wanted&16) != 0 && afe_metadata_key_is(key = key, prefix = "__arrelem$", name = name) {
    16
  }
  else if (wanted&32) != 0 && afe_metadata_key_is(key = key, prefix = "__local_fn_return$", name = name) {
    32
  }
  else {
    0
  }
}

// Metadata lookup has no TypeEnv fallback. An absent key needs no mask.
// Inspect only the nearest entry for each key, retaining existing masks and
// reusing a recorded key when an actual head must be hidden. This bounds the
// new masks to six even across repeated same-named bindings.
fn afe_mask_metadata(locals: AfeLocals, name: String, wanted: Int) -> AfeLocals {
  let mut cur = locals
  let mut out = locals
  let mut seen = 0
  let mut done = false
  while !done && (seen&wanted) != wanted {
    match cur {
      AlNil => done = true,
      AlBind(key, _, rest) => {
        let bit = afe_metadata_key_bit(key = key, name = name, wanted = wanted)
        if bit != 0 && (seen&bit) == 0 {
          out = AlMask(key, out)
          seen = seen|bit
        } else ()
        cur = rest
      },
      AlMask(key, rest) => {
        seen = seen|afe_metadata_key_bit(key = key, name = name, wanted = wanted)
        cur = rest
      }
    }
  }
  out
}

/// A rebinding of `name` without an annotation hides the payload heads an
/// outer annotated binding of the same name recorded.
fn afe_clear_annotation_payloads(locals: AfeLocals, name: String) -> AfeLocals {
  afe_mask_metadata(locals = locals, name = name, wanted = 7)
}

fn afe_ctor_payload_key(name: String, ctor: String) -> String {
  String::concat("__ctorpay$", String::concat(ctor, String::concat("$", name)))
}

fn afe_payload_heads_csv(items: Array[TypeExpr], env: TypeEnv) -> String {
  let parts = array_empty()
  let mut i = 0
  while i < Array::length(items) {
    let part = match afe_texpr_head_name(Array::get(items, at = i)) {
      Some(h) => afe_tag_async_iter_head(head = h, provenanced = afe_type_binding_is_builtin_async_iter(env)),
      None => ""
    }
    Array::push(parts, value = part)
    i = i + 1
  }
  afe_join_csv(parts)
}

/// The constructor name without its qualifier (`Option::Some` -> `Some`).
fn afe_bare_ctor(_ cn: String) -> String {
  let parts = String::split(cn, sep = "::")
  Array::get(parts, at = Array::length(parts) - 1)
}

/// Bind the plain binders of `pats` to the heads in `csv`, position by
/// position. An empty head, or a non-binder pattern, is left as masked.
fn afe_bind_pats_to_heads(acc: AfeLocals, pats: Array[Pat], csv: String) -> AfeLocals {
  let heads = afe_split_csv(csv)
  let mut cur = acc
  let mut i = 0
  while i < Array::length(pats) && i < Array::length(heads) {
    let h = Array::get(heads, at = i)
    match Array::get(pats, at = i) {
      PBind(n) => if String::length(h) > 0 {
        cur = afe_bind_local(locals = cur, name = n, head = Some(h))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  cur
}

/// Best-effort head type name of an expression used as a `for` iterand (or as a
/// `let` value feeding one).
/// #1341 (Codex P1 on #1369): struct FIELD type heads, `Holder.s ->
/// HostStream`. The async pass walks per-statement, so a whole-program table
/// cannot ride the walk's parameters; it lives in a module cell rebuilt at each
/// public entry. Entries are keyed with a `.` that no vibe binding name can contain.
///
/// Needed because the desugar now routes `for b in h.s` over a host stream to
/// the parking read loop (build_host_stream_for). If this pass could not
/// classify the same projection, that loop would be legal in a row without
/// { Async } -- the precise hole #1358 exists to close, reopened one
/// expression shape over.
let afe_field_types_cell: Array[(String, String)] = array_empty()

fn afe_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

fn afe_field_head_with_origin(head: String, env: TypeEnv) -> String {
  if head == "AsyncIter" {
    let from_binding = afe_type_binding_is_builtin_async_iter(env)
    let from_definition = match env_type_definition_origin(env = env, name = head) {
      Some(origin) => afe_origin_is_builtin_async_iter(origin),
      None => false
    }
    afe_tag_async_iter_head(head = head, provenanced = from_binding || from_definition)
  } else {
    head
  }
}

fn afe_record_field_type(struct_name: String, field: String, head: String, env: TypeEnv) -> Unit {
  if String::length(head) > 0 {
    Array::push(afe_field_types_cell, value = (afe_field_type_key(struct_name = struct_name, field = field), afe_field_head_with_origin(head = head, env = env)))
  } else {
    ()
  }
}

fn afe_collect_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, at = j)
          afe_record_field_type(struct_name = sname, field = fname, head = texpr_head_name_afe(fty), env = env)
          j = j + 1
        }
      },
      SModule(_, _, inner) => afe_collect_field_types(stmts = inner, env = env),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_collect_env_field_types(_ env: TypeEnv) -> Unit {
  let defs = env_type_defs(env)
  let mut i = 0
  while i < Array::length(defs) {
    match Array::get(defs, at = i) {
      TDStruct(sname, fields, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, at = j)
          match afe_type_head_name(fty) {
            Some(head) => afe_record_field_type(struct_name = sname, field = fname, head = head, env = env),
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn texpr_head_name_afe(_ t: TypeExpr) -> String {
  match t {
    TyName(n) => n,
    TyApp(n, _) => n,
    _ => ""
  }
}

export fn afe_set_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  Array::truncate(afe_field_types_cell, length = 0)
  afe_collect_field_types(stmts = stmts, env = env)
  afe_collect_env_field_types(env)
}

fn afe_lookup_field_type(struct_name: String, field: String) -> Option[String] {
  let key = afe_field_type_key(struct_name = struct_name, field = field)
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_field_types_cell) {
    let (k, v) = Array::get(afe_field_types_cell, at = i)
    if k == key {
      out = Some(v)
      i = Array::length(afe_field_types_cell)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_applied_constructor_var(_ t: Type) -> Option[Int] {
  match t {
    CtApplied(CtVar(id), _) => Some(id),
    CtNamed(n, args) => if n == "#hkt" && Array::length(args) >= 1 {
      match Array::get(args, at = 0) {
        CtVar(id) => Some(id),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn afe_lookup_alias(env: TypeEnv, name: String) -> Option[(Array[String], Type)] {
  match find_typedef(defs = env_type_defs(env), name = name) {
    Some(TDAlias(_, params, body)) => Some((params, body)),
    _ => None
  }
}

fn afe_expand_constructor_alias(t: Type, env: TypeEnv, fuel: Int) -> Type {
  if fuel <= 0 {
    t
  } else {
    match t {
      CtForAll(ids, bounds, body) => CtForAll(ids, bounds, afe_expand_constructor_alias(t = body, env = env, fuel = fuel)),
      CtNamed(name, args) => match afe_lookup_alias(env = env, name = name) {
        Some((params, body)) => if Array::length(params) == Array::length(args) {
          afe_expand_constructor_alias(t = resolve_type_alias_params(ty = body, params = params, args = args), env = env, fuel = fuel - 1)
        } else if Array::length(params) == 0 {
          afe_expand_constructor_alias(t = body, env = env, fuel = fuel - 1)
        } else {
          t
        },
        None => t
      },
      CtApplied(head, args) => {
        let expanded_head = afe_expand_constructor_alias(t = head, env = env, fuel = fuel - 1)
        match expanded_head {
          CtNamed(name, _) => match afe_lookup_alias(env = env, name = name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(t = resolve_type_alias_params(ty = body, params = params, args = args), env = env, fuel = fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          CtConstructor(name, _) => match afe_lookup_alias(env = env, name = name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(t = resolve_type_alias_params(ty = body, params = params, args = args), env = env, fuel = fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          _ => CtApplied(expanded_head, args)
        }
      },
      _ => t
    }
  }
}

/// #2386: the `AsyncIter` provenance answer for the walk in progress
/// (-1 = not asked yet, else 0 / 1); the env is constant across a walk and
/// this was asked once per binding and per call head. Cleared per entry with
/// the memo above.
let afe_builtin_async_iter_cell: Array[Int] = [-1]

export fn afe_type_binding_is_builtin_async_iter(_ env: TypeEnv) -> Bool {
  let cached = Array::get(afe_builtin_async_iter_cell, at = 0)
  if cached >= 0 {
    cached == 1
  } else {
    let answer = match env_lookup_binding(env = env, name = "AsyncIter") {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
    Array::set(afe_builtin_async_iter_cell, at = 0, value = if answer {
      1
    } else {
      0
    })
    answer
  }
}

fn afe_tag_async_iter_head(head: String, provenanced: Bool) -> String {
  if head == "AsyncIter" && provenanced {
    afe_builtin_async_iter_head
  } else if head == afe_builtin_async_iter_head {
    afe_builtin_async_iter_head
  } else {
    head
  }
}

export fn afe_display_iter_head(_ head: String) -> String {
  if head == afe_builtin_async_iter_head {
    "AsyncIter"
  } else {
    head
  }
}

fn afe_tuple_shape_key(_ name: String) -> String {
  String::concat("__tupshape$", name)
}

fn afe_array_elem_key(_ name: String) -> String {
  String::concat("__arrelem$", name)
}

fn afe_local_fn_return_key(_ name: String) -> String {
  String::concat("__local_fn_return$", name)
}

fn afe_digit_index(_ field: String) -> Option[Int] {
  let n = String::length(field)
  if n == 0 {
    None
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while i < n {
      let c = String::char_code_at(field, at = i)
      if c >= 48 && c <= 57 {
        acc = acc * 10 + (c - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(acc)
    } else {
      None
    }
  }
}

fn afe_split_csv(_ sentinel: String) -> Array[String] {
  let out = array_empty()
  let mut rest = sentinel
  let mut go = true
  while go {
    let comma = String::index_of(rest, needle = ",")
    if comma < 0 {
      Array::push(out, value = rest)
      go = false
    } else {
      Array::push(out, value = String::substring(rest, start = 0, end = comma))
      rest = String::substring(rest, start = comma + 1, end = String::length(rest))
    }
  }
  out
}

fn afe_join_csv(_ parts: Array[String]) -> String {
  let mut acc = ""
  let mut i = 0
  while i < Array::length(parts) {
    acc = if i == 0 {
      Array::get(parts, at = i)
    } else {
      String::concat(acc, String::concat(",", Array::get(parts, at = i)))
    }
    i = i + 1
  }
  acc
}

fn afe_prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, value = head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, value = Array::get(rest, at = i))
    i = i + 1
  }
  out
}

/// Recover the concrete head returned by a constructor-polymorphic call such
/// as `map[F[_]](xs: F[A], ...) -> F[B]`. The checker type keeps the same
/// constructor variable on the receiver and result, so follow that receiver
/// back to its source expression instead of treating the abstract `F[B]` as
/// an unknown head.
fn afe_call_result_head(callee_type: Type, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match callee_type {
    CtForAll(_, _, body) => afe_call_result_head(callee_type = body, args = args, env = env, locals = locals),
    CtFn(params, ret, _) => {
      let expanded = afe_expand_constructor_alias(t = ret, env = env, fuel = 8)
      match afe_type_head_name(expanded) {
        Some(head) => Some(head),
        None => match afe_applied_constructor_var(expanded) {
          Some(result_var) => {
            let mut i = 0
            let mut result = None
            while i < Array::length(params) && i < Array::length(args) {
              match afe_applied_constructor_var(Array::get(params, at = i)) {
                Some(param_var) => {
                  let same_constructor = param_var == result_var
                  if same_constructor {
                    match afe_expr_head_name(e = Array::get(args, at = i), env = env, locals = locals) {
                      Some(head) => {
                        result = Some(head)
                        i = Array::length(params)
                      },
                      None => {
                        i = i + 1
                      }
                    }
                  } else {
                    i = i + 1
                  }
                },
                None => {
                  i = i + 1
                }
              }
            }
            result
          },
          None => None
        }
      }
    },
    _ => None
  }
}

fn afe_callee_is_builtin_async_iter(env: TypeEnv, name: String) -> Bool {
  if afe_has_recorded_builtin_async_iter_import(name) {
    true
  } else {
    match env_lookup_binding(env = env, name = name) {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
  }
}

fn afe_finish_call_head(head: String, env: TypeEnv, callee: String) -> String {
  if head == afe_builtin_async_iter_head {
    head
  } else {
    afe_tag_async_iter_head(head = head, provenanced = afe_callee_is_builtin_async_iter(env = env, name = callee) || afe_type_binding_is_builtin_async_iter(env))
  }
}

fn afe_heads_agree(left: Option[String], right: Option[String]) -> Option[String] {
  match left {
    Some(name) => match right {
      Some(other) => {
        let same = name == other
        if same {
          Some(name)
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}

fn afe_bind_shapes(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  afe_bind_shapes_from(acc = locals, outer = locals, name = name, val = val, env = env)
}

/// `afe_bind_shapes` with the scope `val` is read in (`outer`) kept apart from
/// the one the shapes are added to (`acc`).
fn afe_bind_shapes_from(acc: AfeLocals, outer: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let locals = outer
  let without = afe_mask_metadata(locals = acc, name = name, wanted = 24)
  match val {
    ETuple(items) => if Array::length(items) > 0 {
      let parts = array_empty()
      let mut i = 0
      while i < Array::length(items) {
        let part = match afe_expr_head_name(e = Array::get(items, at = i), env = env, locals = locals) {
          Some(h) => h,
          None => ""
        }
        Array::push(parts, value = part)
        i = i + 1
      }
      afe_bind_local(locals = without, name = afe_tuple_shape_key(name), head = Some(afe_join_csv(parts)))
    } else {
      without
    },
    EArray(items) => if Array::length(items) > 0 {
      afe_bind_local(locals = without, name = afe_array_elem_key(name), head = afe_expr_head_name(e = Array::get(items, at = 0), env = env, locals = locals))
    } else {
      without
    },
    _ => without
  }
}

fn afe_fn_return_head(val: Expr, env: TypeEnv) -> Option[String] {
  match val {
    EFn(_, _, _, ret, _, _) => match ret {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(head = h, provenanced = afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    },
    _ => None
  }
}

fn afe_bind_local_fn_return(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  match afe_fn_return_head(val = val, env = env) {
    Some(head) => AlBind(afe_local_fn_return_key(name), head, locals),
    None => afe_mask_metadata(locals = locals, name = name, wanted = 32)
  }
}

export fn afe_bind_value(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let with_head = afe_bind_local(locals = locals, name = name, head = afe_expr_head_name(e = val, env = env, locals = locals))
  let with_fn = afe_bind_local_fn_return(locals = with_head, name = name, val = val, env = env)
  afe_bind_value_payloads(locals = afe_bind_shapes(locals = with_fn, name = name, val = val, env = env), name = name, val = val, env = env)
}

/// #3198 review: an annotated `let` (the parser's `((__asc: T) -> __asc)(v)`)
/// records its payload heads like an annotated parameter; any other `let`
/// hides the ones an outer binding of the same name recorded.
fn afe_bind_value_payloads(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  match afe_ascribed_type(val) {
    Some(te) => afe_bind_annotation_payloads(locals = locals, name = name, te = te, env = env),
    None => afe_clear_annotation_payloads(locals = locals, name = name)
  }
}

fn afe_ascribed_type(_ val: Expr) -> Option[TypeExpr] {
  match val {
    ECall(EFn(_, _, params, _, _, EIdent(bname, _)), args, _, _) => if Array::length(params) == 1 && Array::length(args) == 1 {
      let (pname, pty) = Array::get(params, at = 0)
      if pname == "__asc" && bname == "__asc" {
        pty
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// The evidence planner carries a local row annotation through a named
/// function value (including a chain of immutable aliases). A conditional or
/// other computed value still has no corresponding evidence binding.
export fn afe_ascribed_name_type(_ val: Expr) -> Option[TypeExpr] {
  match val {
    ECall(_, args, _, _) => if Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        EIdent(_, _) => afe_ascribed_type(val),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3198 review: `afe_bind_value` with the scope `val` is read in (`outer`)
/// kept apart from the one `name` is added to (`acc`). A `loop` state's
/// initial value is read in the enclosing scope while its name joins the
/// body's, so `loop (it = it) { for x in it { .. } }` keeps the async
/// iterator head the outer `it` carries.
export fn afe_bind_value_from(acc: AfeLocals, outer: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let with_head = afe_bind_local(locals = acc, name = name, head = afe_expr_head_name(e = val, env = env, locals = outer))
  let with_fn = afe_bind_local_fn_return(locals = with_head, name = name, val = val, env = env)
  afe_bind_value_payloads(locals = afe_bind_shapes_from(acc = with_fn, outer = outer, name = name, val = val, env = env), name = name, val = val, env = env)
}

/// The scope a match arm's body is read in. #3177: every pattern binder masks
/// the outer scope, and the binders whose head the scrutinee reveals carry it.
export fn afe_match_arm_locals(scrut: Expr, pat: Pat, env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  afe_match_arm_locals_onto(scrut = scrut, pat = pat, env = env, outer = locals, acc = afe_mask_pat_binders(locals = locals, pat = pat))
}

/// `afe_match_arm_locals` with the scope the scrutinee is read in (`outer`)
/// kept apart from the one the binders are added to (`acc`), so a binder can
/// shadow the very name its scrutinee reads (`match it { Some(it) => .. }`).
fn afe_match_arm_locals_onto(scrut: Expr, pat: Pat, env: TypeEnv, outer: AfeLocals, acc: AfeLocals) -> AfeLocals {
  match pat {
    PBind(name) => afe_bind_local(locals = acc, name = name, head = afe_expr_head_name(e = scrut, env = env, locals = outer)),
    PCtor(raw_cn, sub) => match scrut {
      ECall(EIdent(name, _), args, _, _) => if name == pattern_ctor_base_name(raw_cn) || String::ends_with(name, suffix = String::concat("::", pattern_ctor_base_name(raw_cn))) {
        let mut cur = acc
        let mut i = 0
        while i < Array::length(sub) && i < Array::length(args) {
          cur = afe_match_arm_locals_onto(scrut = Array::get(args, at = i), pat = Array::get(sub, at = i), env = env, outer = outer, acc = cur)
          i = i + 1
        }
        cur
      } else {
        acc
      },
      // #3198 review: a NAME whose annotation recorded this constructor's
      // payload heads (`o: Option[Countdown]`, `Some(c)`).
      EIdent(sname, _) => match afe_lookup_local(locals = outer, name = afe_ctor_payload_key(name = sname, ctor = afe_bare_ctor(raw_cn))) {
        Some(csv) => afe_bind_pats_to_heads(acc = acc, pats = sub, csv = csv),
        None => acc
      },
      _ => acc
    },
    PTuple(items) => match scrut {
      ETuple(vals) => {
        let mut cur = acc
        let mut i = 0
        while i < Array::length(items) && i < Array::length(vals) {
          cur = afe_match_arm_locals_onto(scrut = Array::get(vals, at = i), pat = Array::get(items, at = i), env = env, outer = outer, acc = cur)
          i = i + 1
        }
        cur
      },
      EIdent(sname, _) => match afe_lookup_local(locals = outer, name = afe_tuple_shape_key(sname)) {
        Some(csv) => afe_bind_pats_to_heads(acc = acc, pats = items, csv = csv),
        None => acc
      },
      _ => acc
    },
    _ => acc
  }
}

/// #3177: every name `pat` binds, as a binding of no known head, so it hides
/// an outer binding of the same name. A match or handler arm binds its
/// pattern's names whether or not their heads can be resolved -- a name the
/// walk does not see bound reads the OUTER binding (or the builtin: a
/// match-bound `await` called in a row-free lambda demanded `Async`).
export fn afe_mask_pat_binders(locals: AfeLocals, pat: Pat) -> AfeLocals {
  match pat {
    PBind(name) => afe_mask_metadata(locals = afe_bind_local(locals = locals, name = name, head = None), name = name, wanted = 15),
    PCtor(_, sub) => afe_mask_pats_binders(locals = locals, pats = sub),
    PTuple(items) => afe_mask_pats_binders(locals = locals, pats = items),
    POr(a, b) => afe_mask_pat_binders(locals = afe_mask_pat_binders(locals = locals, pat = a), pat = b),
    PStruct(_, fields) => {
      let mut cur = locals
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        cur = afe_mask_pat_binders(locals = cur, pat = fp)
        i = i + 1
      }
      cur
    },
    _ => locals
  }
}

fn afe_mask_pats_binders(locals: AfeLocals, pats: Array[Pat]) -> AfeLocals {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(pats) {
    cur = afe_mask_pat_binders(locals = cur, pat = Array::get(pats, at = i))
    i = i + 1
  }
  cur
}

fn afe_tuple_elem_head(obj: Expr, field: String, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_digit_index(field) {
    None => None,
    Some(idx) => match obj {
      ETuple(items) => if idx >= 0 && idx < Array::length(items) {
        afe_expr_head_name(e = Array::get(items, at = idx), env = env, locals = locals)
      } else {
        None
      },
      EIdent(name, _) => match afe_lookup_local(locals = locals, name = afe_tuple_shape_key(name)) {
        Some(sentinel) => {
          let parts = afe_split_csv(sentinel)
          if idx >= 0 && idx < Array::length(parts) {
            let elem = Array::get(parts, at = idx)
            if String::length(elem) > 0 {
              Some(elem)
            } else {
              None
            }
          } else {
            None
          }
        },
        None => None
      },
      _ => None
    }
  }
}

fn afe_array_elem_head(args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if Array::length(args) == 2 {
    match Array::get(args, at = 0) {
      EIdent(arrname, _) => afe_lookup_local(locals = locals, name = afe_array_elem_key(arrname)),
      EArray(items) => if Array::length(items) > 0 {
        afe_expr_head_name(e = Array::get(items, at = 0), env = env, locals = locals)
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

/// #3179: `f_off` is the callee identifier's offset. The element-type
/// shortcut reads the builtin `Array::get` / index sugar, so it answers only
/// for a call the checker types as that builtin (`builtin_call_arm`); a
/// program's own function of either spelling is read from its declaration.
fn afe_ident_call_head(f: String, f_off: Int, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if (f == "Array::get" || f == "__index") && builtin_call_arm(env = env, name = f, argc = Array::length(args), callee_off = f_off) != "" {
    match afe_array_elem_head(args = args, env = env, locals = locals) {
      Some(head) => Some(head),
      None => afe_ident_call_head_generic(f = f, args = args, env = env, locals = locals)
    }
  } else {
    afe_ident_call_head_generic(f = f, args = args, env = env, locals = locals)
  }
}

fn afe_ident_call_head_generic(f: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_lookup_local(locals = locals, name = afe_local_fn_return_key(f)) {
    Some(head) => Some(head),
    None => afe_ident_call_head_env(f = f, args = args, env = env, locals = locals)
  }
}

fn afe_ident_call_head_env(f: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match env_lookup(env = env, name = f) {
    Some(callee_type) => match afe_call_result_head(callee_type = callee_type, args = args, env = env, locals = locals) {
      Some(head) => Some(afe_finish_call_head(head = head, env = env, callee = f)),
      None => match env_lookup_binding(env = env, name = f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => None
      }
    },
    _ => match lookup_builtin(f) {
      Some(callee_type) => match afe_call_result_head(callee_type = callee_type, args = args, env = env, locals = locals) {
        Some(head) => Some(afe_finish_call_head(head = head, env = env, callee = f)),
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      },
      _ => match env_lookup_binding(env = env, name = f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    }
  }
}

fn afe_dot_call_head(obj: Expr, method: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_expr_head_name(e = obj, env = env, locals = locals) {
    Some(receiver) => {
      let display = afe_display_iter_head(receiver)
      let qualified = String::concat(display, String::concat("::", method))
      let call_args = afe_prepend_expr(head = obj, rest = args)
      match afe_ident_call_head(f = qualified, f_off = 0 - 1, args = call_args, env = env, locals = locals) {
        Some(head) => Some(head),
        None => if receiver == afe_builtin_async_iter_head && afe_is_async_iter_publication_name(qualified) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    },
    None => None
  }
}

fn afe_iife_head(params: Array[(String, Option[TypeExpr])], body: Expr, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let mut body_locals = afe_bind_params(locals = locals, params = params, env = env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, at = i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(e = Array::get(args, at = i), env = env, locals = locals)
    } else {
      None
    }
    body_locals = afe_bind_local(locals = body_locals, name = name, head = inferred)
    i = i + 1
  }
  afe_expr_head_name(e = body, env = env, locals = body_locals)
}

fn afe_handler_arm_head(arm_body: Expr, expected: String, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match arm_body {
    ECall(EIdent("resume", _), resume_args, _, _) => if Array::length(resume_args) == 1 {
      Some(expected)
    } else {
      None
    },
    ELet(name, val, body, _) => afe_handler_arm_head(arm_body = body, expected = expected, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env)),
    ELetMut(name, val, body, _) => afe_handler_arm_head(arm_body = body, expected = expected, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env)),
    ELetRec(name, val, body) => afe_handler_arm_head(arm_body = body, expected = expected, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env)),
    EReturn(inner) => afe_handler_arm_head(arm_body = inner, expected = expected, env = env, locals = locals),
    EAssign(_, _, continuation, _) => afe_handler_arm_head(arm_body = continuation, expected = expected, env = env, locals = locals),
    EAssignOp(_, _, _, continuation, _) => afe_handler_arm_head(arm_body = continuation, expected = expected, env = env, locals = locals),
    ESeq(_, result) => afe_handler_arm_head(arm_body = result, expected = expected, env = env, locals = locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(left = afe_handler_arm_head(arm_body = then_branch, expected = expected, env = env, locals = locals), right = afe_handler_arm_head(arm_body = else_branch, expected = expected, env = env, locals = locals)),
    _ => afe_expr_head_name(e = arm_body, env = env, locals = locals)
  }
}

fn afe_op_name_matches(name: String, op: String) -> Bool {
  name == op || String::ends_with(name, suffix = String::concat("::", op)) || String::ends_with(op, suffix = String::concat("::", name))
}

fn afe_handler_consumes_op(arms: Array[(Pat, Expr)], op: String) -> Bool {
  let mut i = 0
  let mut consumes = false
  while i < Array::length(arms) && !consumes {
    let (pat, _) = Array::get(arms, at = i)
    match pat {
      PCtor(name, _) => if afe_op_name_matches(name = name, op = op) {
        consumes = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  consumes
}

export let afe_callable_bodies: Array[(String, Array[(String, Option[TypeExpr])], Option[String], Expr)] = array_empty()
// One-based row IDs preserve the body's authoritative ordered storage;
// zero means ambiguous, including repeated copies of the same body. Every
// checker entry resets this index before collecting its own callable rows.
let afe_callable_body_index: Array[MutMap[String, Int]] = [MutMap::new_string()]
export let afe_payload_call_stack: Array[String] = array_empty()
export let afe_reachability_keys: Array[String] = array_empty()
export let afe_reachability_values: Array[Bool] = array_empty()
export let afe_reachability_stack: Array[String] = array_empty()

fn afe_add_callable_body(name: String, params: Array[(String, Option[TypeExpr])], effect: Option[String], body: Expr) -> Unit {
  Array::push(afe_callable_bodies, value = (name, params, effect, body))
  let index = Array::get(afe_callable_body_index, at = 0)
  let row = match MutMap::get(index, k = name) {
    Some(_) => 0,
    None => Array::length(afe_callable_bodies)
  }
  MutMap::set(index, k = name, v = row)
}

export fn afe_collect_callable_bodies(_ stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, EFn(_, _, params, _, effect, body)) => {
        afe_add_callable_body(name = name, params = params, effect = effect, body = body)
      },
      SFnDecl(_, name, EFn(_, _, params, _, effect, body), _, _) => {
        afe_add_callable_body(name = name, params = params, effect = effect, body = body)
      },
      SModule(_, _, body) => afe_collect_callable_bodies(body),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_lookup_callable_body(_ name: String) -> Option[(Array[(String, Option[TypeExpr])], Option[String], Expr)] {
  match MutMap::get(Array::get(afe_callable_body_index, at = 0), k = name) {
    Some(row) => if row > 0 {
      let (_, params, effect, body) = Array::get(afe_callable_bodies, at = row - 1)
      Some((params, effect, body))
    } else {
      None
    },
    None => None
  }
}

fn afe_payload_call_is_active(_ name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_payload_call_stack) && !found {
    found = Array::get(afe_payload_call_stack, at = i) == name
    i = i + 1
  }
  found
}

fn afe_callable_may_perform(effect: Option[String], op: String) -> Bool {
  match effect_row_parse(effect) {
    // A row variable is whatever a caller supplies, so it may carry `op`
    // (#3595 stopped `decl_authorizes_op` from reading it that way).
    Some(labels) => afe_row_has_var(labels) || decl_authorizes_op(labels = labels, op_name = op),
    None => false
  }
}

fn afe_row_has_var(_ labels: Array[String]) -> Bool {
  let mut found = false
  for l in labels {
    if label_is_effect_var(l) {
      found = true
    }
  }
  found
}

fn afe_reachability_key(name: String, op: String) -> String {
  String::concat(name, String::concat("\t", op))
}

fn afe_reachability_cache_get(_ key: String) -> Option[Bool] {
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_reachability_keys) {
    if Array::get(afe_reachability_keys, at = i) == key {
      out = Some(Array::get(afe_reachability_values, at = i))
      i = Array::length(afe_reachability_keys)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_reachability_is_active(_ key: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_reachability_stack) && !found {
    found = Array::get(afe_reachability_stack, at = i) == key
    i = i + 1
  }
  found
}

fn afe_expr_may_perform(expr: Expr, op: String) -> Bool {
  match expr {
    EHandle(body, arms) => {
      let mut found = if afe_handler_consumes_op(arms = arms, op = op) {
        false
      } else {
        afe_expr_may_perform(expr = body, op = op)
      }
      let mut i = 0
      while i < Array::length(arms) && !found {
        let (_, arm_body) = Array::get(arms, at = i)
        found = afe_expr_may_perform(expr = arm_body, op = op)
        i = i + 1
      }
      found
    },
    EFn(_, _, _, _, _, _) => false,
    ECall(callee, args, _, _) => {
      let mut found = match callee {
        EIdent("perform", _) => if Array::length(args) == 1 {
          match Array::get(args, at = 0) {
            ECall(EIdent(op_name, _), _, _, _) => afe_op_name_matches(name = op_name, op = op),
            _ => false
          }
        } else {
          false
        },
        EFn(_, _, _, _, _, body) => afe_expr_may_perform(expr = body, op = op),
        EIdent(name, _) => afe_callable_reaches_op(name = name, op = op),
        _ => false
      }
      let mut i = 0
      while i < Array::length(args) && !found {
        found = afe_expr_may_perform(expr = Array::get(args, at = i), op = op)
        i = i + 1
      }
      found
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) && !found {
        found = afe_expr_may_perform(expr = Array::get(children, at = i), op = op)
        i = i + 1
      }
      found
    }
  }
}

fn afe_callable_reaches_op(name: String, op: String) -> Bool {
  let key = afe_reachability_key(name = name, op = op)
  match afe_reachability_cache_get(key) {
    Some(value) => value,
    None => if afe_reachability_is_active(key) {
      false
    } else match afe_lookup_callable_body(name) {
      Some((_, effect, body)) => {
        let stack_len = Array::length(afe_reachability_stack)
        Array::push(afe_reachability_stack, value = key)
        let result = afe_callable_may_perform(effect = effect, op = op) && afe_expr_may_perform(expr = body, op = op)
        Array::truncate(afe_reachability_stack, length = stack_len)
        if result {
          Array::push(afe_reachability_keys, value = key)
          Array::push(afe_reachability_values, value = true)
        } else {
          ()
        }
        result
      },
      None => false
    }
  }
}

fn afe_callable_body_locals(params: Array[(String, Option[TypeExpr])], args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  let mut body_locals = afe_bind_params(locals = locals, params = params, env = env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, at = i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(e = Array::get(args, at = i), env = env, locals = locals)
    } else {
      None
    }
    body_locals = afe_bind_local(locals = body_locals, name = name, head = inferred)
    i = i + 1
  }
  body_locals
}

fn afe_collect_perform_payloads(expr: Expr, op: String, payload_index: Int, env: TypeEnv, locals: AfeLocals, out: Array[Option[String]]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      if !afe_handler_consumes_op(arms = arms, op = op) {
        afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = locals, out = out)
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, at = i)
        let arm_locals = afe_handler_arm_locals(body = body, pat = pat, env = env, locals = locals)
        afe_collect_perform_payloads(expr = arm_body, op = op, payload_index = payload_index, env = env, locals = arm_locals, out = out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, _) => (),
    ELet(name, val, body, _) => {
      afe_collect_perform_payloads(expr = val, op = op, payload_index = payload_index, env = env, locals = locals, out = out)
      afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env), out = out)
    },
    ELetMut(name, val, body, _) => {
      afe_collect_perform_payloads(expr = val, op = op, payload_index = payload_index, env = env, locals = locals, out = out)
      afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env), out = out)
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals = locals, name = name, val = val, env = env)
      afe_collect_perform_payloads(expr = val, op = op, payload_index = payload_index, env = env, locals = rec_locals, out = out)
      afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = rec_locals, out = out)
    },
    EAssign(name, val, continuation, _) => {
      afe_collect_perform_payloads(expr = val, op = op, payload_index = payload_index, env = env, locals = locals, out = out)
      afe_collect_perform_payloads(expr = continuation, op = op, payload_index = payload_index, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env), out = out)
    },
    ECall(callee, args, _, _) => {
      match callee {
        EIdent(name, _) => if name == "perform" && Array::length(args) == 1 {
          match Array::get(args, at = 0) {
            ECall(EIdent(op_name, _), oargs, _, _) => if afe_op_name_matches(name = op_name, op = op) && payload_index >= 0 && payload_index < Array::length(oargs) {
              Array::push(out, value = afe_expr_head_name(e = Array::get(oargs, at = payload_index), env = env, locals = locals))
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      match callee {
        EFn(_, _, params, _, _, body) => {
          let body_locals = afe_callable_body_locals(params = params, args = args, env = env, locals = locals)
          afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = body_locals, out = out)
        },
        EIdent(name, _) => if name == "perform" || afe_payload_call_is_active(name) {
          ()
        } else match afe_lookup_callable_body(name) {
          Some((params, effect, body)) => if afe_callable_may_perform(effect = effect, op = op) && afe_callable_reaches_op(name = name, op = op) {
            let stack_len = Array::length(afe_payload_call_stack)
            Array::push(afe_payload_call_stack, value = name)
            let body_locals = afe_callable_body_locals(params = params, args = args, env = env, locals = locals)
            afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = body_locals, out = out)
            Array::truncate(afe_payload_call_stack, length = stack_len)
          } else {
            ()
          },
          None => ()
        },
        _ => ()
      }
      let mut i = 0
      while i < Array::length(args) {
        afe_collect_perform_payloads(expr = Array::get(args, at = i), op = op, payload_index = payload_index, env = env, locals = locals, out = out)
        i = i + 1
      }
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        afe_collect_perform_payloads(expr = Array::get(children, at = i), op = op, payload_index = payload_index, env = env, locals = locals, out = out)
        i = i + 1
      }
    }
  }
}

fn afe_perform_payload_head(body: Expr, op: String, payload_index: Int, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let payloads = array_empty()
  afe_collect_perform_payloads(expr = body, op = op, payload_index = payload_index, env = env, locals = locals, out = payloads)
  if Array::length(payloads) == 0 {
    None
  } else {
    let mut i = 1
    let mut result = Array::get(payloads, at = 0)
    while i < Array::length(payloads) {
      match result {
        Some(expected) => match Array::get(payloads, at = i) {
          Some(actual) => if actual != expected {
            result = None
          } else {
            ()
          },
          None => {
            result = None
          }
        },
        None => {
          i = Array::length(payloads)
        }
      }
      i = i + 1
    }
    result
  }
}

/// The scope a handler arm's body is read in: every pattern binder masks the
/// outer scope (#3177), and an operation argument bound by name carries the
/// head of what the body performs in that position.
export fn afe_handler_arm_locals(body: Expr, pat: Pat, env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  match pat {
    PCtor(cn, sub) => {
      let mut arm_locals = afe_mask_pat_binders(locals = locals, pat = pat)
      let mut i = 0
      while i < Array::length(sub) {
        match Array::get(sub, at = i) {
          PBind(name) => {
            arm_locals = afe_bind_local(locals = arm_locals, name = name, head = afe_perform_payload_head(body = body, op = cn, payload_index = i, env = env, locals = locals))
          },
          _ => ()
        }
        i = i + 1
      }
      arm_locals
    },
    _ => afe_mask_pat_binders(locals = locals, pat = pat)
  }
}

fn afe_handle_head(body: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_expr_head_name(e = body, env = env, locals = locals) {
    None => None,
    Some(expected) => {
      let mut i = 0
      let mut agrees = true
      while i < Array::length(arms) && agrees {
        let (pat, arm_body) = Array::get(arms, at = i)
        // #3683: first read the arm with its binders masked. A masked name
        // has no head, and every head rule answers None for a None input
        // (`afe_heads_agree` included), so knowing the binders' heads can
        // only turn an unknown arm head into a known one, never change a
        // known one. When the masked arm already has a head, its binders'
        // heads -- which `afe_handler_arm_locals` finds by walking the
        // handled body and every callee it reaches, once per call path --
        // cannot change the answer. Measured: `let answer = handle { <calls
        // into the checker> } with { Exception::Throw(message) => .. }` in
        // the compiler's own source made that walk cost the committed seed
        // over 700 MB in bootstrap pass 3 and ran it out of wasm32 memory.
        let masked_head = afe_handler_arm_head(arm_body = arm_body, expected = expected, env = env, locals = afe_mask_pat_binders(locals = locals, pat = pat))
        let arm_head = match masked_head {
          Some(_) => masked_head,
          None => afe_handler_arm_head(arm_body = arm_body, expected = expected, env = env, locals = afe_handler_arm_locals(body = body, pat = pat, env = env, locals = locals))
        }
        match arm_head {
          Some(actual) => {
            let same = actual == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            agrees = false
          }
        }
        i = i + 1
      }
      if agrees {
        Some(expected)
      } else {
        None
      }
    }
  }
}

fn afe_match_head(scrut: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if Array::length(arms) == 0 {
    None
  } else {
    let mut i = 0
    let mut result = None
    let mut agrees = true
    while i < Array::length(arms) && agrees {
      let (pat, body) = Array::get(arms, at = i)
      let arm_locals = afe_match_arm_locals(scrut = scrut, pat = pat, env = env, locals = locals)
      match afe_expr_head_name(e = body, env = env, locals = arm_locals) {
        Some(head) => match result {
          Some(expected) => {
            let same = head == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            result = Some(head)
          }
        },
        None => {
          agrees = false
        }
      }
      i = i + 1
    }
    if agrees {
      result
    } else {
      None
    }
  }
}

fn afe_collect_loop_head(expr: Expr, env: TypeEnv, locals: AfeLocals, expected: Array[String], valid: Array[Bool]) -> Unit {
  if !Array::get(valid, at = 0) {
    ()
  } else {
    match expr {
      EAssign("__loop_result", value, continuation, _) => {
        match afe_expr_head_name(e = value, env = env, locals = locals) {
          Some(actual) => if Array::length(expected) == 0 {
            Array::push(expected, value = actual)
          } else if Array::get(expected, at = 0) != actual {
            Array::set(valid, at = 0, value = false)
          } else {
            ()
          },
          None => Array::set(valid, at = 0, value = false)
        }
        afe_collect_loop_head(expr = continuation, env = env, locals = locals, expected = expected, valid = valid)
      },
      EBreak(Some(value)) => match afe_expr_head_name(e = value, env = env, locals = locals) {
        Some(actual) => if Array::length(expected) == 0 {
          Array::push(expected, value = actual)
        } else if Array::get(expected, at = 0) != actual {
          Array::set(valid, at = 0, value = false)
        } else {
          ()
        },
        None => Array::set(valid, at = 0, value = false)
      },
      ELetMut("__loop_result", _, _, _) => (),
      ELoop(_, _) => (),
      EWhile(_, _) => (),
      EForIn(_, _, _, _) => (),
      EFn(_, _, _, _, _, _) => (),
      ELet(name, value, body, _) => {
        afe_collect_loop_head(expr = value, env = env, locals = locals, expected = expected, valid = valid)
        afe_collect_loop_head(expr = body, env = env, locals = afe_bind_value(locals = locals, name = name, val = value, env = env), expected = expected, valid = valid)
      },
      ELetMut(name, value, body, _) => {
        afe_collect_loop_head(expr = value, env = env, locals = locals, expected = expected, valid = valid)
        afe_collect_loop_head(expr = body, env = env, locals = afe_bind_value(locals = locals, name = name, val = value, env = env), expected = expected, valid = valid)
      },
      EMatch(scrut, arms) => {
        afe_collect_loop_head(expr = scrut, env = env, locals = locals, expected = expected, valid = valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, at = 0) {
          let (pat, body) = Array::get(arms, at = i)
          afe_collect_loop_head(expr = body, env = env, locals = afe_match_arm_locals(scrut = scrut, pat = pat, env = env, locals = locals), expected = expected, valid = valid)
          i = i + 1
        }
      },
      EHandle(body, arms) => {
        afe_collect_loop_head(expr = body, env = env, locals = locals, expected = expected, valid = valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, at = 0) {
          let (_, arm_body) = Array::get(arms, at = i)
          afe_collect_loop_head(expr = arm_body, env = env, locals = locals, expected = expected, valid = valid)
          i = i + 1
        }
      },
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) && Array::get(valid, at = 0) {
          afe_collect_loop_head(expr = Array::get(children, at = i), env = env, locals = locals, expected = expected, valid = valid)
          i = i + 1
        }
      }
    }
  }
}

fn afe_parameterized_loop_head(body: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match body {
    ESeq(EWhile(_, loop_body), EIdent("__loop_result", _)) => {
      let expected = array_empty()
      let valid = [true]
      afe_collect_loop_head(expr = loop_body, env = env, locals = locals, expected = expected, valid = valid)
      if Array::get(valid, at = 0) && Array::length(expected) == 1 {
        Some(Array::get(expected, at = 0))
      } else {
        None
      }
    },
    _ => None
  }
}

fn afe_loop_head(inits: Array[(String, Expr)], body: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let mut body_locals = locals
  let mut i = 0
  while i < Array::length(inits) {
    let (name, val) = Array::get(inits, at = i)
    body_locals = afe_bind_value(locals = body_locals, name = name, val = val, env = env)
    i = i + 1
  }
  let expected = array_empty()
  let valid = [true]
  afe_collect_loop_head(expr = body, env = env, locals = body_locals, expected = expected, valid = valid)
  if Array::get(valid, at = 0) && Array::length(expected) == 1 {
    Some(Array::get(expected, at = 0))
  } else {
    None
  }
}

export fn afe_expr_head_name(e: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match e {
    EIdent(n, _) => match afe_lookup_local(locals = locals, name = n) {
      Some(h) => Some(h),
      // #3683 (Codex on #3985): a local the walk binds without a head -- a
      // masked pattern binder, a `for` variable -- shadows any outer
      // binding of that name, so it has no head; reading the outer one's
      // answered for a different value.
      None => if afe_binds_local(locals = locals, name = n) {
        None
      } else match env_lookup(env = env, name = n) {
        Some(t) => match afe_type_head_name(t) {
          Some(head) => Some(afe_tag_async_iter_head(head = head, provenanced = afe_callee_is_builtin_async_iter(env = env, name = n) || afe_type_binding_is_builtin_async_iter(env))),
          None => None
        },
        None => None
      }
    },
    ERecord(n, _, _) => if String::length(n) > 0 {
      Some(afe_tag_async_iter_head(head = n, provenanced = afe_type_binding_is_builtin_async_iter(env)))
    } else {
      None
    },
    EDot(obj, field, _, _) => match afe_tuple_elem_head(obj = obj, field = field, env = env, locals = locals) {
      Some(head) => Some(head),
      None => match afe_expr_head_name(e = obj, env = env, locals = locals) {
        Some(otype) => afe_lookup_field_type(struct_name = afe_display_iter_head(otype), field = field),
        None => None
      }
    },
    ECall(callee, args, _, _) => match callee {
      EIdent(f, f_off) => afe_ident_call_head(f = f, f_off = f_off, args = args, env = env, locals = locals),
      EDot(obj, method, _, _) => afe_dot_call_head(obj = obj, method = method, args = args, env = env, locals = locals),
      EFn(_, _, params, _, _, body) => afe_iife_head(params = params, body = body, args = args, env = env, locals = locals),
      _ => None
    },
    ELet(name, val, body, _) => afe_expr_head_name(e = body, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env)),
    ELetMut(name, val, body, _) => if name == "__loop_result" {
      afe_parameterized_loop_head(body = body, env = env, locals = locals)
    } else {
      afe_expr_head_name(e = body, env = env, locals = afe_bind_value(locals = locals, name = name, val = val, env = env))
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals = locals, name = name, val = val, env = env)
      afe_expr_head_name(e = body, env = env, locals = rec_locals)
    },
    EReturn(inner) => afe_expr_head_name(e = inner, env = env, locals = locals),
    EAssign(_, _, continuation, _) => afe_expr_head_name(e = continuation, env = env, locals = locals),
    EAssignOp(_, _, _, continuation, _) => afe_expr_head_name(e = continuation, env = env, locals = locals),
    ESeq(_, result) => afe_expr_head_name(e = result, env = env, locals = locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(left = afe_expr_head_name(e = then_branch, env = env, locals = locals), right = afe_expr_head_name(e = else_branch, env = env, locals = locals)),
    EMatch(scrut, arms) => afe_match_head(scrut = scrut, arms = arms, env = env, locals = locals),
    EHandle(body, arms) => afe_handle_head(body = body, arms = arms, env = env, locals = locals),
    ELoop(inits, body) => afe_loop_head(inits = inits, body = body, env = env, locals = locals),
    _ => None
  }
}

/// #3601: where an erased-row diagnostic happened, as its message names it.
fn erased_error_place(_ fname: String) -> String {
  let block = entry_block_display_name(fname)
  if fname == "#lambda:" || String::length(fname) == 0 {
    "this expression"
  } else if String::starts_with(fname, prefix = "#lambda:") {
    String::concat("the lambda '", String::concat(String::substring(fname, start = 8, end = String::length(fname)), "'"))
  } else if String::length(block) > 0 {
    block
  } else {
    String::concat("'", String::concat(fname, "'"))
  }
}

fn erased_error_at(body: String, off: Int) -> String {
  if off >= 0 {
    String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
  } else {
    body
  }
}
