generated_hash =

// @vibe/compiler/checker/effects — the passes that run after typing and
// judge effects rather than types: the perform/effect-row discipline, the
// async and stdin-provider checks, mutability, authority flags and the
// entry/test cacheability answers. Directory-shared-scope package.
//
// It reads only @vibe/compiler/core and the builtin signature tables, and
// never calls back into the checker. The checker imports it, and
// checker/checker_effects.vibe re-exports the part of its surface that
// @vibe/compiler/checker publishes.

// --- public surface
// EffectError is declared transparently (no `opaque`): tests match its
// constructors directly.
