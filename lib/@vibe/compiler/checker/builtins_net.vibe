//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

//# #1343 (ADR-0094 の provider / consumer 軸): `Http::*` builtin の effect
//# ラベルは provider 識別子 `Http` に統一している。以前は同じ関数群が
//# `HttpServer` / `HttpClient` / `HttpIncoming` の3ラベルに分かれていたが、
//# これは consumer 側の関心 (serve か egress か) を **provider 軸**で表そうと
//# したもので、1つの host HTTP provider に対する実装契約を3つに断片化して
//# いた。実際 raw import 層 (`vibe_http_*_raw`、builtin_registry.vibe) と
//# ラッパーライブラリ (`lib/@vibe/http`、`with Http`) は一貫して `Http`
//# を使っており、層ごとにラベルが食い違う状態だった。
//#
//# 細粒度は **consumer 軸** = operation-level row で表す (#1359 で builtin
//# 呼び出し経路に導通済み):
//#   with Http::listen   -- serve だけ
//#   with Http::request  -- outbound request (egress) だけ
//#   with Http           -- 全 operation の shorthand (従来どおり)
//# 束ねた名前が要る場合は ADR-0071 の `effectset` を使う (透明な
//# compile-time alias なので provider 契約を汚さない)。
//#
//# なお `lib/@vibe/http/http_effect.vibe` の `effect HttpServer` /
//# `HttpClient` / `HttpIncoming` は**別物**で、in-process の mock/DI 用に
//# 宣言されたユーザー algebraic effect として残る (ADR-0084 の分類でも
//# 宣言された effect は algebraic 側)。

fn net_no_params() -> Array[Type] {
  array_empty()
}

fn net_one_param(a: Type) -> Array[Type] {
  let arr = net_no_params()
  Array::push(arr, a)
  arr
}

fn net_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = net_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn net_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = net_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn net_four_params(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {
  let arr = net_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  arr
}

fn lookup_http_close(name: String) -> Option[Type] {
  if name == "Http::close" {
    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some("Http")))
  }
  else None
}

fn lookup_http_accept(name: String) -> Option[Type] {
  if name == "Http::accept" {
    Some(CtFn(net_one_param(CtUnknown), CtUnknown, Some("Http")))
  }
  else None
}

fn lookup_http_listen(name: String) -> Option[Type] {
  if name == "Http::listen" {
    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some("Http")))
  }
  else None
}

/// #1505: this said TWO params while every other declaration of the same
/// builtin says FOUR -- `builtins/declarations.vibe`
/// (`declare Http::request(String, String, String, String) -> Int`), the
/// viberun host import (`|method: i64, url: i64, headers: i64, body: i64|`,
/// runtime/viberun/src/main.rs), the Node runner
/// (`http_request(methodTagged, urlTagged, headersTagged, bodyTagged)`) and
/// `lib/@vibe/http/http.vibe`'s `vibe_http_request_raw(method, url, headers,
/// body)`. The checker was the outlier and it is the one that decides, so
/// `Http::request("GET", url, "", "")` -- the shape the runtime actually
/// takes -- reported `expected 2 args, got 4` and no caller of the full form
/// could type-check.
///
/// The return stays `CtUnknown`: it is an opaque response handle, and every
/// consumer below (`Http::response_status` / `response_body` /
/// `response_header` / `close`) takes `CtUnknown`. `declarations.vibe` spells
/// it `Int` because that file has no opaque-handle type; narrowing the
/// checker to `Int` would leak the representation into user programs.
fn lookup_http_request(name: String) -> Option[Type] {
  if name == "Http::request" {
    Some(CtFn(net_four_params(CtString, CtString, CtString, CtString), CtUnknown, Some("Http")))
  }
  else None
}

fn lookup_http_respond(name: String) -> Option[Type] {
  if name == "Http::respond" {
    Some(CtFn(net_three_params(CtUnknown, CtInt, CtString), CtUnit, Some("Http")))
  }
  else None
}

fn lookup_http_response_body(name: String) -> Option[Type] {
  if name == "Http::response_body" {
    Some(CtFn(net_one_param(CtUnknown), CtString, Some("Http")))
  }
  else None
}

fn lookup_http_request_header(name: String) -> Option[Type] {
  if name == "Http::request_header" {
    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some("Http")))
  }
  else None
}

fn lookup_net_group_d(name: String) -> Option[Type] {
  match lookup_http_request_header(name) {
    Some(t) => Some(t),
    None => lookup_http_respond(name)
  }
}

fn lookup_http_request_method(name: String) -> Option[Type] {
  if name == "Http::request_method" {
    Some(CtFn(net_one_param(CtUnknown), CtString, Some("Http")))
  }
  else None
}

fn lookup_net_group_c(name: String) -> Option[Type] {
  match lookup_http_close(name) {
    Some(t) => Some(t),
    None => match lookup_http_listen(name) {
      Some(t) => Some(t),
      None => match lookup_http_accept(name) {
        Some(t) => Some(t),
        None => lookup_http_request_method(name)
      }
    }
  }
}

fn lookup_http_response_header(name: String) -> Option[Type] {
  if name == "Http::response_header" {
    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some("Http")))
  }
  else None
}

fn lookup_http_response_status(name: String) -> Option[Type] {
  if name == "Http::response_status" {
    Some(CtFn(net_one_param(CtUnknown), CtInt, Some("Http")))
  }
  else None
}

fn lookup_net_group_b(name: String) -> Option[Type] {
  match lookup_http_request(name) {
    Some(t) => Some(t),
    None => match lookup_http_response_status(name) {
      Some(t) => Some(t),
      None => match lookup_http_response_header(name) {
        Some(t) => Some(t),
        None => lookup_http_response_body(name)
      }
    }
  }
}

// Socket::tcp_connect/tcp_read/tcp_write/tcp_close used to be declared here
// (as lookup_net_group_a) but now live in builtin_registry.vibe, which
// lookup_registry_builtin (checker/builtins.vibe) consults before this
// function is ever reached -- see that registry's row-header comment.
export fn lookup_net(name: String) -> Option[Type] {
  match lookup_net_group_b(name) {
    Some(t) => Some(t),
    None => match lookup_net_group_c(name) {
      Some(t) => Some(t),
      None => lookup_net_group_d(name)
    }
  }
}
