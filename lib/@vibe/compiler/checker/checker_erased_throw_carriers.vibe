// lib/@vibe/compiler/checker/checker_erased_throw_carriers.vibe -- which
// identifiers in an erased exception arm may hold the value it caught.
//
// #3551 review: the binder of an ERASED arm (`Exception::Throw(m)`) is typed
// `String`, but holds whatever was thrown. A rethrow whose payload may carry
// that value is a throw of no known kind (`throw_payload_recorded_type`).
// This file answers "may it carry the value" for each identifier occurrence
// of the arm body, by BINDING rather than by spelling: `let m = "other"`
// rebinds `m` to a value of its own, and `throw(m)` after it throws a
// `String`, while the arm's `m` is still a carrier once that scope ends.

import @vibe/compiler/core {
  Expr, Pat, expr_any_node, expr_children, is_exception_throw_operation
}

import @vibe/core {
  struct MutMap
}

//# The answer

/// The carriers of one erased arm: for each identifier occurrence the walk
/// resolved (by its source offset), whether its binding may hold the caught
/// value; the spellings of every carrier binding, the answer for an
/// occurrence the walk did not see at its offset; (one cell) whether a
/// `perform`'s result may be a carrier; (one cell) whether the caught value
/// ESCAPED to a place the walk cannot follow; and the spellings bound outside
/// the arm that may reach state such an escape wrote (`outer_state`).
export struct ErasedCarriers {
  offs: MutMap[Int, Bool];
  names: Array[String];
  resumed: Array[Bool];
  escaped: Array[Bool];
  state_names: Array[String]
}

/// The carriers of the erased arm whose binder is `binder` and whose body is
/// `body`. Only a body that throws needs them, so any other answers the
/// binder alone.
///
/// A binding is a carrier when its value may hold a carrier's value:
///
/// - the arm's binder;
/// - a `let`, `let mut` or `let rec` whose value mentions a carrier, or a
///   variable assigned such a value anywhere (annotated or not: an
///   annotation does not change the value);
/// - the binders of a `match`, `for` or nested handler whose subject
///   mentions a carrier, and a `loop`'s state when the loop mentions one;
/// - a STORE TARGET: every binding a call's arguments mention when one of
///   them (or the callee) mentions a carrier, and every binding the receiver
///   of such a method call mentions. The callee may store the carrier into
///   anything those arguments reach, so a projection names its root:
///   `store(outer.cell, m)`, `outer.cell.value = m` (a `__set_field` call),
///   `outer.cells[0].value = m`, `outer.cell.put(m)` and
///   `store(cell_of(outer), m)` all make `outer` one. Whatever a store
///   target's own value mentions is a store target in turn -- a `let` or
///   assigned value, a `match` / `for` / handler subject, a `loop` state, a
///   tracked lambda's call arguments -- so `let c = outer.cell` then
///   `store(c, m)` reaches `outer`, and a local closure called as a store
///   target reaches what it captured;
/// - a parameter of a function literal that may receive a carrier: one bound
///   by `let` / `let rec` or applied where it is written gets the arguments
///   of its direct calls, and any other use (passed, stored, aliased,
///   returned) may give it anything, so its parameters are carriers;
/// - the result of every `perform` once a nested handler arm mentions a
///   carrier, because that arm may `resume` the `perform` with it;
/// - once the caught value ESCAPES, every name bound outside the arm that
///   `outer_state` says is a binding of the program (a function, closure,
///   parameter, local or global, not a builtin), and the result of every
///   `perform`.
///
/// The value escapes when a carrier is handed to a callee the walk does not
/// follow -- a function or closure bound outside the arm (`remember(m)`,
/// `slot(Some(m))`, a parameter `sink(m)`), a method, a computed callee --
/// or is stored into a binding of the enclosing code (`Array::push(saved,
/// m)`, `outer.cell.value = m`). The callee may keep it in state it captured
/// or in a global, and a later `recall()`, `slot(None)` or `cell.value` may
/// read it back; an alias of the binding stored into may too. So after an
/// escape anything such state may reach is a carrier. Escape is judged for
/// the whole arm, not in order, because a loop may run the store after the
/// read. A builtin keeps what it is handed only in its arguments, which the
/// store targets already follow. A value kept by the arm and read back by a
/// throw OUTSIDE every arm is not this walk's to see (#3541).
///
/// `outer_state(name, off)` answers, for an identifier occurrence bound
/// outside the arm, whether it means a binding of the program rather than a
/// builtin.
///
/// A binding whose value mentions no carrier is not one, and SHADOWS a
/// carrier of the same spelling for its scope only. Carriers grow to a
/// fixpoint, because a later assignment or call can make an earlier binding
/// one.
export fn erased_arm_carriers(binder: String, body: Expr, outer_state: (String, Int) -> Bool) -> ErasedCarriers {
  let out = ErasedCarriers::{
    offs: MutMap::new_int(),
    names: [binder],
    resumed: [false],
    escaped: [false],
    state_names: []
  }
  let throws = expr_any_node(expr = body, pred = (e) -> match e {
    ECall(EIdent(n, _), _, _, _) => n == "perform" || n == "perform?",
    _ => false
  })
  if throws {
    // Asked once per occurrence, before the walk; the walk consults it only
    // for an occurrence bound outside the arm.
    let state_offs: MutMap[Int, Bool] = MutMap::new_int()
    let _ = expr_any_node(expr = body, pred = (n) -> match n {
      EIdent(x, off) => {
        if outer_state(x, off) {
          if off >= 0 {
            MutMap::set(state_offs, k = off, v = true)
          }
          cw_add_name(names = out.state_names, x = x)
        }
        false
      },
      _ => false
    })
    let w = CarrierWalk::{
      scope_names: [],
      scope_ids: [],
      carrier: [],
      binding_names: [],
      binding_lambda: [],
      lambda_open: [],
      lambda_param_first: [],
      lambda_param_count: [],
      targeted: [],
      outer: [],
      outer_targeted: [],
      counters: [0, 0, 0, 0, 0],
      offs: out.offs,
      off_ids: MutMap::new_int(),
      state_offs: state_offs,
      state_names: out.state_names
    }
    let mut again = true
    while again {
      cw_set_int(xs = w.counters, i = 0, v = 0)
      cw_set_int(xs = w.counters, i = 1, v = 0)
      cw_set_int(xs = w.counters, i = 2, v = 0)
      Array::truncate(w.scope_names, length = 0)
      Array::truncate(w.scope_ids, length = 0)
      let _ = cw_bind(w = w, name = binder, carrier = true, lambda = 0 - 1)
      let _ = cw_walk(w = w, e = body)
      again = Array::get(w.counters, at = 2) != 0
    }
    let mut i = 0
    while i < Array::length(w.carrier) {
      if Array::get(w.carrier, at = i) {
        cw_add_name(names = out.names, x = Array::get(w.binding_names, at = i))
      }
      i = i + 1
    }
    for n in w.outer {
      cw_add_name(names = out.names, x = n)
    }
    cw_set_bool(xs = out.resumed, i = 0, v = Array::get(w.counters, at = 3) != 0)
    cw_set_bool(xs = out.escaped, i = 0, v = Array::get(w.counters, at = 4) != 0)
  }
  out
}

/// Whether `payload` mentions an identifier that may hold the arm's caught
/// value. An occurrence the walk resolved answers by its binding; any other
/// (a synthesized node) answers by its spelling, and so does one that may
/// reach state the caught value escaped to. A `perform` answers whether a
/// handler arm may resume it with a carrier.
export fn erased_carriers_mention(payload: Expr, c: ErasedCarriers) -> Bool {
  let resumed = Array::get(c.resumed, at = 0)
  let escaped = Array::get(c.escaped, at = 0)
  expr_any_node(expr = payload, pred = (n) -> match n {
    EIdent(x, off) => match cw_off_answer(offs = c.offs, off = off) {
      Some(known) => known,
      None => cw_str_in(xs = c.names, x = x) || escaped && cw_str_in(xs = c.state_names, x = x)
    },
    ECall(EIdent(p, _), _, _, _) => resumed && (p == "perform" || p == "perform?"),
    _ => false
  })
}

fn cw_off_answer(offs: MutMap[Int, Bool], off: Int) -> Option[Bool] {
  if off >= 0 {
    MutMap::get(offs, k = off)
  } else {
    None
  }
}

//# The walk

/// One fixpoint pass's state. Binding and lambda ids are handed out in walk
/// order, so a pass gives each the same id as the one before it, and the
/// per-id flags carry over. `counters` holds the next binding id, the next
/// lambda id, whether this pass turned a flag on, whether a `perform`'s
/// result may be a carrier, and whether the caught value escaped.
struct CarrierWalk {
  scope_names: Array[String];
  scope_ids: Array[Int];
  carrier: Array[Bool];
  binding_names: Array[String];
  // The lambda id a `let` / `let rec` binding holds, or -1.
  binding_lambda: Array[Int];
  // Whether a lambda's parameters may receive a carrier.
  lambda_open: Array[Bool];
  // A lambda's first parameter binding id and its parameter count.
  lambda_param_first: Array[Int];
  lambda_param_count: Array[Int];
  // Per binding: whether a carrier may be stored into what it reaches.
  targeted: Array[Bool];
  // Names bound outside the arm that a carrier was stored into.
  outer: Array[String];
  // Names bound outside the arm that are store targets.
  outer_targeted: Array[String];
  counters: Array[Int];
  offs: MutMap[Int, Bool];
  // The binding id each identifier occurrence resolved to (-1: outside the
  // arm), by source offset, so a store target's value is re-read with the
  // scope it was walked in.
  off_ids: MutMap[Int, Int];
  // The occurrences (by offset) and spellings `outer_state` answered for:
  // names that may reach state the caught value escaped to.
  state_offs: MutMap[Int, Bool];
  state_names: Array[String]
}

fn cw_changed(_ w: CarrierWalk) -> Unit {
  cw_set_int(xs = w.counters, i = 2, v = 1)
}

/// The caught value escaped to a place the walk does not follow: every name
/// that may reach state, and every `perform`'s result, may now hold it.
fn cw_escape(_ w: CarrierWalk) -> Unit {
  if Array::get(w.counters, at = 4) == 0 {
    cw_set_int(xs = w.counters, i = 4, v = 1)
    cw_changed(w)
  }
  if Array::get(w.counters, at = 3) == 0 {
    cw_set_int(xs = w.counters, i = 3, v = 1)
    cw_changed(w)
  }
}

fn cw_escaped(_ w: CarrierWalk) -> Bool {
  Array::get(w.counters, at = 4) != 0
}

/// Whether an occurrence bound outside the arm is a binding of the program,
/// which may reach state the caught value escaped to.
fn cw_outer_state(w: CarrierWalk, x: String, off: Int) -> Bool {
  if off >= 0 {
    match MutMap::get(w.state_offs, k = off) {
      Some(v) => v,
      None => false
    }
  } else {
    cw_str_in(xs = w.state_names, x = x)
  }
}

/// Bind `name` in the current scope; answers its id.
fn cw_bind(w: CarrierWalk, name: String, carrier: Bool, lambda: Int) -> Int {
  let id = Array::get(w.counters, at = 0)
  cw_set_int(xs = w.counters, i = 0, v = id + 1)
  if id < Array::length(w.carrier) {
    if carrier {
      cw_mark_id(w = w, id = id)
    }
  } else {
    Array::push(w.carrier, value = carrier)
    Array::push(w.targeted, value = false)
    Array::push(w.binding_names, value = name)
    Array::push(w.binding_lambda, value = lambda)
  }
  Array::push(w.scope_names, value = name)
  Array::push(w.scope_ids, value = id)
  id
}

fn cw_scope_mark(_ w: CarrierWalk) -> Int {
  Array::length(w.scope_names)
}

fn cw_scope_pop(w: CarrierWalk, mark: Int) -> Unit {
  Array::truncate(w.scope_names, length = mark)
  Array::truncate(w.scope_ids, length = mark)
}

/// The binding id `name` resolves to here, or -1 for a name bound outside
/// the arm.
fn cw_resolve(w: CarrierWalk, name: String) -> Int {
  let mut i = Array::length(w.scope_names) - 1
  let mut found = 0 - 1
  while found < 0 && i >= 0 {
    if Array::get(w.scope_names, at = i) == name {
      found = Array::get(w.scope_ids, at = i)
    }
    i = i - 1
  }
  found
}

fn cw_mark_id(w: CarrierWalk, id: Int) -> Unit {
  if !Array::get(w.carrier, at = id) {
    cw_set_bool(xs = w.carrier, i = id, v = true)
    cw_changed(w)
  }
}

/// Make the binding `name` resolves to here a carrier.
fn cw_mark_name(w: CarrierWalk, name: String) -> Unit {
  let id = cw_resolve(w = w, name = name)
  if id >= 0 {
    cw_mark_id(w = w, id = id)
  } else {
    // Assigned to a binding of the enclosing code, which an alias the walk
    // cannot see may read.
    cw_escape(w)
    if !cw_str_in(xs = w.outer, x = name) {
      Array::push(w.outer, value = name)
      cw_changed(w)
    }
  }
}

fn cw_open_lambda(w: CarrierWalk, lid: Int) -> Unit {
  if lid >= 0 && !Array::get(w.lambda_open, at = lid) {
    cw_set_bool(xs = w.lambda_open, i = lid, v = true)
    cw_changed(w)
  }
}

/// An identifier occurrence: record its answer at its offset. `callee` says
/// it is called where it stands, which is the one use that does not hand a
/// `let`-bound lambda to code this walk does not follow.
fn cw_ident(w: CarrierWalk, x: String, off: Int, callee: Bool) -> Bool {
  let id = cw_resolve(w = w, name = x)
  let carrier = if id >= 0 {
    Array::get(w.carrier, at = id)
  } else {
    cw_str_in(xs = w.outer, x = x) || cw_escaped(w) && cw_outer_state(w = w, x = x, off = off)
  }
  if id >= 0 && !callee {
    cw_open_lambda(w = w, lid = Array::get(w.binding_lambda, at = id))
  }
  if off >= 0 {
    MutMap::set(w.off_ids, k = off, v = id)
    if carrier {
      MutMap::set(w.offs, k = off, v = true)
    } else {
      let _ = MutMap::insert_if_absent(w.offs, k = off, v = false)
    }
  }
  carrier
}

/// Walk `e`; answers whether it mentions a carrier.
fn cw_walk(w: CarrierWalk, e: Expr) -> Bool {
  match e {
    EIdent(x, off) => cw_ident(w = w, x = x, off = off, callee = false),
    ELet(x, v, body, _) => {
      let (mv, lid) = cw_value(w = w, v = v)
      let mark = cw_scope_mark(w)
      let id = cw_bind(w = w, name = x, carrier = mv, lambda = lid)
      let mb = cw_walk(w = w, e = body)
      cw_scope_pop(w = w, mark = mark)
      cw_target_value(w = w, id = id, v = v)
      mv || mb
    },
    ELetMut(x, v, body, _) => {
      let mv = cw_walk(w = w, e = v)
      let mark = cw_scope_mark(w)
      let id = cw_bind(w = w, name = x, carrier = mv, lambda = 0 - 1)
      let mb = cw_walk(w = w, e = body)
      cw_scope_pop(w = w, mark = mark)
      cw_target_value(w = w, id = id, v = v)
      mv || mb
    },
    ELetRec(x, v, body) => {
      let mark = cw_scope_mark(w)
      let lid = match v {
        EFn(_, _, _, _, _, _) => Array::get(w.counters, at = 1),
        _ => 0 - 1
      }
      let id = cw_bind(w = w, name = x, carrier = false, lambda = lid)
      let (mv, _) = cw_value(w = w, v = v)
      if mv {
        cw_mark_id(w = w, id = id)
      }
      let mb = cw_walk(w = w, e = body)
      cw_target_value(w = w, id = id, v = v)
      cw_scope_pop(w = w, mark = mark)
      mv || mb
    },
    EAssign(x, v, cont, _) => {
      let mv = cw_assign(w = w, x = x, v = v)
      let mc = cw_walk(w = w, e = cont)
      mv || mc
    },
    EAssignOp(x, _, v, cont, _) => {
      let mv = cw_assign(w = w, x = x, v = v)
      let mc = cw_walk(w = w, e = cont)
      mv || mc
    },
    EMatch(subject, arms) => {
      let (ms, ma) = cw_arms(w = w, subject = subject, arms = arms)
      ms || ma
    },
    EHandle(handled, arms) => {
      let (mh, ma) = cw_arms(w = w, subject = handled, arms = arms)
      // An arm that mentions a carrier may resume a `perform` with it.
      if ma && Array::get(w.counters, at = 3) == 0 {
        cw_set_int(xs = w.counters, i = 3, v = 1)
        cw_changed(w)
      }
      mh || ma
    },
    EForIn(x, y, subject, body, _) => {
      let ms = cw_walk(w = w, e = subject)
      let mark = cw_scope_mark(w)
      let first = cw_bind(w = w, name = x, carrier = ms, lambda = 0 - 1)
      match y {
        Some(n) => {
          let _ = cw_bind(w = w, name = n, carrier = ms, lambda = 0 - 1)
          ()
        },
        None => ()
      }
      let past = Array::get(w.counters, at = 0)
      let mb = cw_walk(w = w, e = body)
      cw_scope_pop(w = w, mark = mark)
      if cw_any_targeted(w = w, first = first, past = past) {
        cw_target(w = w, e = subject)
      }
      ms || mb
    },
    ELoop(state, body) => {
      let mut mi = false
      for slot in state {
        let (_, init) = slot
        if cw_walk(w = w, e = init) {
          mi = true
        }
      }
      let mark = cw_scope_mark(w)
      let ids: Array[Int] = []
      for slot in state {
        let (n, _) = slot
        Array::push(ids, value = cw_bind(w = w, name = n, carrier = mi, lambda = 0 - 1))
      }
      // `continue(..)` in the body feeds the state, so a body that mentions
      // a carrier makes every slot one.
      let mb = cw_walk(w = w, e = body)
      if mb {
        for id in ids {
          cw_mark_id(w = w, id = id)
        }
        ()
      }
      cw_scope_pop(w = w, mark = mark)
      // A state slot that is a store target reaches what its initial value
      // and every `continue(..)` feeds it.
      let mut tgt = false
      for id in ids {
        if Array::get(w.targeted, at = id) {
          tgt = true
        }
      }
      if tgt {
        for slot in state {
          let (_, init) = slot
          cw_target(w = w, e = init)
        }
        let _ = expr_any_node(expr = body, pred = (n) -> match n {
          EContinue(cargs) => {
            for a in cargs {
              cw_target(w = w, e = a)
            }
            false
          },
          _ => false
        })
        ()
      }
      mi || mb
    },
    EFn(_, _, _, _, _, _) => {
      let (mf, _) = cw_fn(w = w, e = e, tracked = false)
      mf
    },
    ECall(callee, args, _, _) => cw_call(w = w, callee = callee, args = args),
    _ => {
      let mut m = false
      for child in expr_children(e) {
        if cw_walk(w = w, e = child) {
          m = true
        }
      }
      m
    }
  }
}

/// A `let` / `let rec` value: a function literal there is tracked (its
/// parameters receive only its direct calls' arguments). Answers whether
/// the value mentions a carrier and the lambda id it holds, or -1.
fn cw_value(w: CarrierWalk, v: Expr) -> (Bool, Int) {
  match v {
    EFn(_, _, _, _, _, _) => cw_fn(w = w, e = v, tracked = true),
    _ => (cw_walk(w = w, e = v), 0 - 1)
  }
}

/// A function literal. An untracked one's parameters are carriers; a tracked
/// one's are carriers once one of its calls passed a carrier.
fn cw_fn(w: CarrierWalk, e: Expr, tracked: Bool) -> (Bool, Int) {
  let lid = Array::get(w.counters, at = 1)
  cw_set_int(xs = w.counters, i = 1, v = lid + 1)
  if lid >= Array::length(w.lambda_open) {
    Array::push(w.lambda_open, value = !tracked)
    Array::push(w.lambda_param_first, value = 0)
    Array::push(w.lambda_param_count, value = 0)
  } else if !tracked {
    cw_open_lambda(w = w, lid = lid)
  }
  let params_carry = Array::get(w.lambda_open, at = lid)
  match e {
    EFn(_, _, params, _, _, body) => {
      let mark = cw_scope_mark(w)
      cw_set_int(xs = w.lambda_param_first, i = lid, v = Array::get(w.counters, at = 0))
      cw_set_int(xs = w.lambda_param_count, i = lid, v = Array::length(params))
      for param in params {
        let (n, _) = param
        let _ = cw_bind(w = w, name = n, carrier = params_carry, lambda = 0 - 1)
      }
      let mb = cw_walk(w = w, e = body)
      cw_scope_pop(w = w, mark = mark)
      (mb, lid)
    },
    _ => (cw_walk(w = w, e = e), lid)
  }
}

fn cw_call(w: CarrierWalk, callee: Expr, args: Array[Expr]) -> Bool {
  // The lambda this call applies directly, if it is one this walk tracks.
  let mut applied = 0 - 1
  let performed = match callee {
    EIdent(n, _) => (n == "perform" || n == "perform?") && Array::get(w.counters, at = 3) != 0,
    _ => false
  }
  let mc = match callee {
    EIdent(x, off) => {
      let id = cw_resolve(w = w, name = x)
      if id >= 0 {
        applied = Array::get(w.binding_lambda, at = id)
      }
      cw_ident(w = w, x = x, off = off, callee = true)
    },
    EFn(_, _, _, _, _, _) => {
      let (mf, lid) = cw_fn(w = w, e = callee, tracked = true)
      applied = lid
      mf
    },
    _ => cw_walk(w = w, e = callee)
  }
  let mut ma = false
  for a in args {
    if cw_walk(w = w, e = a) {
      ma = true
    }
  }
  // A carrier handed to a call may be stored into anything its arguments
  // (`Array::push(xs, m)`, `store(outer.cell, m)`) or its receiver
  // (`outer.cell.put(m)`) reach. So may a carrier the callee holds, unless
  // the callee is a lambda this walk follows: its body says where its
  // parameters go, and a parameter that is a store target makes its
  // arguments ones.
  let tracked = applied >= 0
  // A carrier handed to a callee the walk does not follow, other than a
  // builtin, escapes: the callee may keep it where a later call reads it.
  let via_perform = match callee {
    EIdent(p, _) => (p == "perform" || p == "perform?") && cw_perform_escapes(args),
    _ => false
  }
  if (ma || mc) && !tracked && (via_perform || cw_callee_escapes(w = w, callee = callee)) {
    cw_escape(w)
  }
  if ma || (mc && !tracked) || (tracked && cw_params_targeted(w = w, lid = applied)) {
    for a in args {
      cw_target(w = w, e = a)
    }
    match callee {
      EIdent(x, off) => if !tracked {
        cw_target_local(w = w, x = x, off = off)
      },
      EFn(_, _, _, _, _, _) => (),
      EDot(recv, _, _, _) => cw_target(w = w, e = recv),
      _ => cw_target(w = w, e = callee)
    }
  }
  if ma {
    cw_open_lambda(w = w, lid = applied)
  }
  performed || mc || ma
}

/// Whether an untracked callee may keep what it is handed where the walk
/// does not see. A builtin keeps it only in its arguments; a binding of the
/// arm or of the program, a method, or a computed callee may keep it
/// anywhere.
///
/// `perform` hands its operation to a handler outside the arm, which may
/// keep what the operation carries, so that escapes too (`cw_perform_escapes`)
/// -- except a throw, whose payload is what the throw site this walk serves
/// judges, and which never resumes.
fn cw_callee_escapes(w: CarrierWalk, callee: Expr) -> Bool {
  match callee {
    EIdent(x, off) => if cw_is_throw_op(x) || x == "perform" || x == "perform?" {
      false
    } else {
      cw_occ_id(w = w, x = x, off = off) >= 0 || cw_outer_state(w = w, x = x, off = off)
    },
    _ => true
  }
}

/// Whether `perform`'s argument applies an operation other than a throw.
fn cw_perform_escapes(_ args: Array[Expr]) -> Bool {
  if Array::length(args) == 1 {
    match Array::get(args, at = 0) {
      ECall(EIdent(op, _), _, _, _) => !cw_is_throw_op(op),
      _ => true
    }
  } else {
    true
  }
}

/// The exception effect's own throw, by the exact grammar
/// (`is_exception_throw_operation`). A spelling test would also take a
/// program effect such as `ExceptionLog::Throw`, whose handler may keep the
/// value and resume.
fn cw_is_throw_op(_ x: String) -> Bool {
  is_exception_throw_operation(x)
}

//# Store targets

/// The binding id an identifier occurrence resolved to when the walk met
/// it, or (for a synthesized node) the one its spelling resolves to here.
fn cw_occ_id(w: CarrierWalk, x: String, off: Int) -> Int {
  let seen = if off >= 0 {
    MutMap::get(w.off_ids, k = off)
  } else {
    None
  }
  match seen {
    Some(id) => id,
    None => cw_resolve(w = w, name = x)
  }
}

/// Make the binding `id` (or, for -1, the outer name `x`) a store target,
/// and so a carrier.
fn cw_target_ref(w: CarrierWalk, id: Int, x: String) -> Unit {
  if id >= 0 {
    if !Array::get(w.targeted, at = id) {
      cw_set_bool(xs = w.targeted, i = id, v = true)
      cw_changed(w)
    }
    cw_mark_id(w = w, id = id)
  } else {
    // A carrier stored into what a binding of the enclosing code reaches
    // escapes: an alias of it the walk cannot see may read it back.
    if cw_str_in(xs = w.state_names, x = x) {
      cw_escape(w)
    }
    if !cw_str_in(xs = w.outer_targeted, x = x) {
      Array::push(w.outer_targeted, value = x)
      cw_changed(w)
    }
    if !cw_str_in(xs = w.outer, x = x) {
      Array::push(w.outer, value = x)
      cw_changed(w)
    }
  }
}

/// A called name that is a store target: only a binding of the arm (a local
/// closure, which may store into what it captured) is one. A name bound
/// outside the arm is called as a function here.
fn cw_target_local(w: CarrierWalk, x: String, off: Int) -> Unit {
  let id = cw_occ_id(w = w, x = x, off = off)
  if id >= 0 {
    cw_target_ref(w = w, id = id, x = x)
  }
}

/// Make every binding `e` mentions a store target: a carrier stored into
/// `e`'s value may be reached from any of them. A called name counts only
/// when it is a binding of the arm.
fn cw_target(w: CarrierWalk, e: Expr) -> Unit {
  match e {
    EIdent(x, off) => cw_target_ref(w = w, id = cw_occ_id(w = w, x = x, off = off), x = x),
    ECall(callee, args, _, _) => {
      match callee {
        EIdent(f, off) => cw_target_local(w = w, x = f, off = off),
        _ => cw_target(w = w, e = callee)
      }
      for a in args {
        cw_target(w = w, e = a)
      }
      ()
    },
    _ => {
      for child in expr_children(e) {
        cw_target(w = w, e = child)
      }
      ()
    }
  }
}

/// A binding that is a store target makes its value's bindings ones.
fn cw_target_value(w: CarrierWalk, id: Int, v: Expr) -> Unit {
  if Array::get(w.targeted, at = id) {
    cw_target(w = w, e = v)
  }
}

/// `x = v`: `x` carries when `v` does, and `v` is a store target when `x` is.
fn cw_assign(w: CarrierWalk, x: String, v: Expr) -> Bool {
  let mv = cw_walk(w = w, e = v)
  if mv {
    cw_mark_name(w = w, name = x)
  }
  let id = cw_resolve(w = w, name = x)
  let tgt = if id >= 0 {
    Array::get(w.targeted, at = id)
  } else {
    cw_str_in(xs = w.outer_targeted, x = x)
  }
  if tgt {
    cw_target(w = w, e = v)
  }
  mv
}

/// Whether a binding with an id in `[first, past)` is a store target.
fn cw_any_targeted(w: CarrierWalk, first: Int, past: Int) -> Bool {
  let mut i = first
  let mut found = false
  while !found && i < past {
    found = Array::get(w.targeted, at = i)
    i = i + 1
  }
  found
}

/// Whether a parameter of the lambda `lid` is a store target.
fn cw_params_targeted(w: CarrierWalk, lid: Int) -> Bool {
  let first = Array::get(w.lambda_param_first, at = lid)
  cw_any_targeted(w = w, first = first, past = first + Array::get(w.lambda_param_count, at = lid))
}

/// A `match` or handler: its arms' binders carry when the subject mentions a
/// carrier. Answers whether the subject mentions one, and whether an arm
/// body does.
fn cw_arms(w: CarrierWalk, subject: Expr, arms: Array[(Pat, Expr)]) -> (Bool, Bool) {
  let ms = cw_walk(w = w, e = subject)
  let mut ma = false
  let mut tgt = false
  for arm in arms {
    let (p, body) = arm
    let mark = cw_scope_mark(w)
    let first = Array::get(w.counters, at = 0)
    cw_bind_pat(w = w, p = p, carrier = ms)
    let past = Array::get(w.counters, at = 0)
    if cw_walk(w = w, e = body) {
      ma = true
    }
    cw_scope_pop(w = w, mark = mark)
    if cw_any_targeted(w = w, first = first, past = past) {
      tgt = true
    }
  }
  // A binder that is a store target reaches into the subject.
  if tgt {
    cw_target(w = w, e = subject)
  }
  (ms, ma)
}

fn cw_bind_pat(w: CarrierWalk, p: Pat, carrier: Bool) -> Unit {
  match p {
    PBind(n) => {
      let _ = cw_bind(w = w, name = n, carrier = carrier, lambda = 0 - 1)
      ()
    },
    PCtor(_, items) => cw_bind_pats(w = w, items = items, carrier = carrier),
    PTuple(items) => cw_bind_pats(w = w, items = items, carrier = carrier),
    POr(a, b) => {
      cw_bind_pat(w = w, p = a, carrier = carrier)
      cw_bind_pat(w = w, p = b, carrier = carrier)
    },
    PStruct(_, fields) => {
      for field in fields {
        let (_, fp) = field
        cw_bind_pat(w = w, p = fp, carrier = carrier)
      }
      ()
    },
    _ => ()
  }
}

fn cw_bind_pats(w: CarrierWalk, items: Array[Pat], carrier: Bool) -> Unit {
  for item in items {
    cw_bind_pat(w = w, p = item, carrier = carrier)
  }
  ()
}

//# Helpers

// A field's element type does not reach an index write's lowering, so the
// writes go through typed parameters.
fn cw_set_int(xs: Array[Int], i: Int, v: Int) -> Unit {
  Array::set(xs, at = i, value = v)
}

fn cw_set_bool(xs: Array[Bool], i: Int, v: Bool) -> Unit {
  Array::set(xs, at = i, value = v)
}

fn cw_add_name(names: Array[String], x: String) -> Unit {
  if !cw_str_in(xs = names, x = x) {
    Array::push(names, value = x)
  }
}

fn cw_str_in(xs: Array[String], x: String) -> Bool {
  let mut found = false
  for v in xs {
    if v == x {
      found = true
    }
  }
  found
}
