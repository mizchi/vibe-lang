import @vibe/compiler/core {
  TypeExpr
}
import @vibe/compiler/checker/annotations {
  report_map_key_types
}
test "map-key annotation validation keeps the supported and refused sides" {
  let errors: Array[String] = []
  report_map_key_types(te = TyApp("Map", [TyName("String"), TyName("Int")]), defs = [
  ], shadow = [], where_label = "annotation", errors = errors)
  inspect(Array::length(errors), content = "0")
  // #2334: `Int`, `Char` and `Bool` keys are supported too.
  report_map_key_types(te = TyApp("Map", [TyName("Int"), TyName("Int")]), defs = [
  ], shadow = [], where_label = "annotation", errors = errors)
  report_map_key_types(te = TyApp("Map", [TyName("Char"), TyName("Int")]), defs = [
  ], shadow = [], where_label = "annotation", errors = errors)
  report_map_key_types(te = TyApp("Map", [TyName("Bool"), TyName("Int")]), defs = [
  ], shadow = [], where_label = "annotation", errors = errors)
  inspect(Array::length(errors), content = "0")
  report_map_key_types(te = TyApp("Map", [TyName("Double"), TyName("Int")]), defs = [
  ], shadow = [], where_label = "annotation", errors = errors)
  inspect(Array::length(errors), content = "1")
  inspect(String::contains(Array::get(errors, at = 0), needle = "MutMap[K, V]"), content = "true")
}
