import @vibe/compiler/core {
  TypeExpr
}
import @vibe/compiler/checker/annotations {
  report_map_key_types
}
test "map-key annotation validation keeps the supported and refused sides" {
  let errors: Array[String] = []
  report_map_key_types(TyApp("Map", [TyName("String"), TyName("Int")]), [], [], "annotation", errors)
  inspect(Array::length(errors), content = "0")
  // #2334: `Int`, `Char` and `Bool` keys are supported too.
  report_map_key_types(TyApp("Map", [TyName("Int"), TyName("Int")]), [], [], "annotation", errors)
  report_map_key_types(TyApp("Map", [TyName("Char"), TyName("Int")]), [], [], "annotation", errors)
  report_map_key_types(TyApp("Map", [TyName("Bool"), TyName("Int")]), [], [], "annotation", errors)
  inspect(Array::length(errors), content = "0")
  report_map_key_types(TyApp("Map", [TyName("Double"), TyName("Int")]), [], [], "annotation", errors)
  inspect(Array::length(errors), content = "1")
  inspect(String::contains(Array::get(errors, 0), "MutMap[K, V]"), content = "true")
}
