import @vibe/compiler/core {
  TypeExpr
}
import @vibe/compiler/checker/annotations {
  report_map_key_types
}
test "map-key annotation validation keeps the supported and refused sides" {
  let errors: Array[String] = []
  report_map_key_types(TyApp("Map", [TyName("String"), TyName("Int")]), [], [], "annotation", errors)
  inspect(Array::length(errors), content = "0")
  report_map_key_types(TyApp("Map", [TyName("Int"), TyName("Int")]), [], [], "annotation", errors)
  inspect(Array::length(errors), content = "1")
  inspect(String::contains(Array::get(errors, 0), "StringMap[V]"), content = "true")
}
