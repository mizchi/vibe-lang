fn placement_param_name(_ raw: String) -> String {
  // ADR-0120 D3 (#3681): a `_` slot's header name is `"_ " + name`.
  let named = if checker_header_name_is_positional(raw) {
    raw[2: String::length(raw)]
  } else {
    raw
  }
  let size = String::length(named)
  if String::ends_with(named, suffix = "~") || String::ends_with(named, suffix = "?") {
    named[0: size - 1]
  } else {
    named
  }
}

/// ADR-0120 D3: a call may mix the two forms only when each unlabeled
/// argument stands at a `_` slot of the declaration (`get(xs, at = 0)` for
/// `fn get(_ xs: Array[Int], at: Int)`); such an argument fills its slot by
/// position, and the labels name the rest.
fn placement_plain_at_positional_slots(args: Array[Expr], names: Array[String]) -> Bool {
  let mut ok = true
  let mut i = 0
  while i < Array::length(args) && ok {
    match Array::get(args, at = i) {
      ELabeledArg(_, _, _) => (),
      _ => ok = i < Array::length(names) && checker_header_name_is_positional(Array::get(names, at = i))
    }
    i = i + 1
  }
  ok
}

fn placement_value(_ arg: Expr) -> Expr {
  match arg {
    ELabeledArg(_, _, value) => value,
    _ => arg
  }
}

fn placement_option_value(_ arg: Expr) -> Bool {
  match placement_value(arg) {
    EIdent(name, _) => name == "None",
    ECall(EIdent(name, _), args, _, _) => name == "Some" && Array::length(args) == 1,
    _ => false
  }
}

fn placement_identity(_ count: Int) -> Array[Int] {
  let slots: Array[Int] = []
  let mut i = 0
  while i < count {
    Array::push(slots, value = (i + 1) * 2)
    i = i + 1
  }
  slots
}

// Written-first resolution is independent of the old declared-slot-first
// rewrite. The header comes from the value binding selected for typing.
fn placement_for_header(args: Array[Expr], names: Array[String]) -> Option[Array[Int]] {
  let sources = for _ in names {
    -1
  }
  let mut labeled = 0
  for arg in args {
    match arg {
      ELabeledArg(_, _, _) => labeled = labeled + 1,
      _ => ()
    }
  }
  let mut valid = labeled == 0 || labeled == Array::length(args) || placement_plain_at_positional_slots(args = args, names = names)
  let mut written = 0
  while written < Array::length(args) && valid {
    let slot = match Array::get(args, at = written) {
      ELabeledArg(label, _, _) => {
        let mut found = -1
        let mut i = 0
        while i < Array::length(names) && found < 0 {
          if placement_param_name(Array::get(names, at = i)) == label {
            found = i
          } else {
            ()
          }
          i = i + 1
        }
        found
      },
      _ => written
    }
    if slot < 0 || slot >= Array::length(names) {
      valid = false
    } else if Array::get(sources, at = slot) >= 0 {
      valid = false
    } else {
      Array::set(sources, at = slot, value = written)
    }
    written = written + 1
  }
  let slots: Array[Int] = []
  let mut slot = 0
  while slot < Array::length(names) && valid {
    let source = Array::get(sources, at = slot)
    let optional = String::ends_with(Array::get(names, at = slot), suffix = "?")
    if source < 0 {
      if optional {
        Array::push(slots, value = 0)
      } else {
        valid = false
      }
    } else {
      let wrap = optional && !placement_option_value(Array::get(args, at = source))
      Array::push(slots, value = (source + 1) * 2 + if wrap {
        1
      } else {
        0
      })
    }
    slot = slot + 1
  }
  if valid {
    Some(slots)
  } else {
    None
  }
}

/// Calls through values without declaration headers keep the legacy positional
/// passthrough. Labels on such values are retired in ADR-0120 Phase 4.
export fn checker_record_opaque_call_placement(cell: Array[Int], errors: Array[String]) -> Unit {
  if checker_call_header_is_probe() {
    ()
  } else {
    match call_placement_raw(cell) {
      Some((callee, args, _, offset)) => {
        let before = Array::length(errors)
        placement_check_mixed(name = placement_source_name(callee), offset = offset, args = args, errors = errors)
        if Array::length(errors) == before {
          call_placement_publish(callee = callee, offset = offset, cell = cell, written = Array::length(args), mode = 2, slots = placement_identity(Array::length(args)), errors = errors)
        } else {
          ()
        }
      },
      None => ()
    }
  }
}

/// The UFCS dispatcher supplies its checker-resolved qualified binding and
/// whether the receiver occupies the first formal (not a written argument).
export fn checker_record_resolved_call_placement(cell: Array[Int], env: TypeEnv, name: String, ident_offset: Int, implicit_receiver: Bool, errors: Array[String]) -> Unit {
  if checker_call_header_is_probe() {
    ()
  } else {
    let before = Array::length(errors)
    match call_placement_raw(cell) {
      Some((callee, args, macro_call, offset)) => {
        // The inspect expander owns its fixed two-value layout. Its labels
        // were decorative before Phase1c, including the content spelling;
        // this macro snapshot must not be treated as an ordinary builtin.
        // #3832: a builtin reached through an import alias is placed by the
        // builtin's own labels, as its canonical spelling is.
        let bname = checker_builtin_call_name(env = env, name = name)
        if macro_call && name == "inspect" {
          call_placement_publish(callee = callee, offset = offset, cell = cell, written = Array::length(args), mode = 0, slots = placement_identity(Array::length(args)), errors = errors)
        } else if builtin_resolves_at(env = env, name = bname, ident_off = ident_offset) && (lookup_builtin(bname) is Some(_)) {
          placement_check_builtin(name = bname, written_len = String::length(name), offset = ident_offset, args = args, errors = errors)
          if Array::length(errors) == before {
            match builtin_param_labels(bname) {
              Some(_) => {
                let mode = if canonical_builtin_name(bname) == "sh_lines" {
                  1
                } else {
                  0
                }
                call_placement_publish(callee = callee, offset = offset, cell = cell, written = Array::length(args), mode = mode, slots = placement_identity(Array::length(args)), errors = errors)
              },
              None => checker_record_opaque_call_placement(cell = cell, errors = errors)
            }
          } else {
            ()
          }
        } else {
          match checker_call_header_names(env = env, name = name) {
            Some(all_names) => {
              let names = if implicit_receiver && Array::length(all_names) > 0 {
                Array::slice(all_names, start = 1, end = Array::length(all_names))
              } else {
                all_names
              }
              let slots = placement_for_header(args = args, names = names)
              placement_check_declared(name = name, offset = ident_offset, args = args, names = names, slots = slots, defaults = checker_call_header_defaults(env = env, name = name), errors = errors)
              if Array::length(errors) == before {
                match slots {
                  Some(found) => call_placement_publish(callee = callee, offset = offset, cell = cell, written = Array::length(args), mode = 0, slots = found, errors = errors),
                  None => ()
                }
              } else {
                ()
              }
            },
            None => {
              placement_check_uncertain(env = env, name = name, offset = ident_offset, args = args, errors = errors)
              if Array::length(errors) == before {
                checker_record_opaque_call_placement(cell = cell, errors = errors)
              } else {
                ()
              }
            }
          }
        }
      },
      None => ()
    }
  }
}

/// A bare callee that nothing binds is retried as a method on its first
/// argument (`xs |> length` is `xs.length()`, the #736 arm of
/// `check_call_expr`). Mirrors that arm's gate exactly.
export fn checker_bare_call_is_method_retry(env: TypeEnv, name: String, argc: Int) -> Bool {
  if String::index_of(name, needle = "::") < 0 && argc >= 1 {
    match env_lookup(env = env, name = name) {
      Some(_) => false,
      None => lookup_builtin_in_env(env = env, name = name) is None
    }
  } else {
    false
  }
}

/// The retry checked a bare call as a dot call, where the receiver is not an
/// argument. As written it is argument 0, a positional argument beside any
/// labels, which only a `_` slot takes (ADR-0120 D4) -- the same answer the
/// qualified `m |> Meter::shift(by = 7)` gets. Then restore the receiver in
/// the placement the lowering applies to the written call.
export fn checker_finish_method_retry_placement(cell: Array[Int], env: TypeEnv, qualified: String, ident_offset: Int, args: Array[Expr], errors: Array[String]) -> Unit {
  let before = Array::length(errors)
  match checker_call_header_names(env = env, name = qualified) {
    Some(names) => if placement_plain_at_positional_slots(args = args, names = names) {
      ()
    } else {
      placement_check_mixed(name = qualified, offset = ident_offset, args = args, errors = errors)
    },
    None => ()
  }
  if Array::length(errors) == before {
    call_placement_prepend_receiver(cell = cell, explicit = Array::length(args) - 1)
  } else {
    ()
  }
}

/// Precheck macros carry the original snapshot on their typed replacement.
/// Resolve that source callee in the actual environment at this point.
///
/// A bare callee the method retry may take is neither captured nor placed
/// here: the retry checks it as a dot call, which captures and places it at
/// the method it resolves (`call_placement_prepend_receiver` then restores
/// the written receiver). Placing the unbound spelling first reported
/// `b |> bump(n = 3)` as a mixed call even though `Box::bump` declares its
/// receiver `_`. When the retry declines, the caller places it through
/// `checker_record_declined_retry_call_placement`.
export fn checker_record_call_placement(expr: Expr, env: TypeEnv, errors: Array[String]) -> Unit {
  placement_record_call(expr = expr, env = env, errors = errors, defer_retry = true)
}

/// The method retry declined this bare call: place it as written.
export fn checker_record_declined_retry_call_placement(expr: Expr, env: TypeEnv, errors: Array[String]) -> Unit {
  placement_record_call(expr = expr, env = env, errors = errors, defer_retry = false)
}

fn placement_record_call(expr: Expr, env: TypeEnv, errors: Array[String], defer_retry: Bool) -> Unit {
  match expr {
    ECall(callee, args, offset, cell) => {
      let deferred = defer_retry && match callee {
        EIdent(name, _) => checker_bare_call_is_method_retry(env = env, name = name, argc = Array::length(args)),
        _ => false
      }
      if deferred {
        ()
      } else {
        let mut needed = placement_has_labels(args)
        match callee {
          EIdent(name, _) => needed = needed || checker_call_header_has_optional(env = env, name = name),
          // Namespace and receiver dispatch select their declaration below.
          _ => ()
        }
        if needed && !checker_call_header_is_probe() {
          call_placement_capture_source(callee = callee, args = args, offset = offset, cell = cell, macro_call = false)
        } else {
          ()
        }
        placement_note_and_resolve(callee = callee, offset = offset, cell = cell, args = args, env = env, errors = errors)
      }
    },
    _ => ()
  }
}

fn placement_note_and_resolve(callee: Expr, offset: Int, cell: Array[Int], args: Array[Expr], env: TypeEnv, errors: Array[String]) -> Unit {
  match callee {
    EIdent(name, ident_offset) => checker_note_label_site(env = env, name = name, ident_offset = ident_offset, offset = offset, args = args, method_call = false),
    _ => ()
  }
  match call_placement_raw(cell) {
    Some((raw_callee, _, _, _)) => match raw_callee {
      EIdent(name, ident_offset) => checker_record_resolved_call_placement(cell = cell, env = env, name = name, ident_offset = ident_offset, implicit_receiver = false, errors = errors),
      _ => match callee {
        // Namespace and UFCS dispatch publish explicitly at their resolved
        // binding. Optional filling can also increase arity by one, so
        // argument counts cannot identify an implicit receiver.
        EIdent(_, _) => (),
        EDot(_, _, _, _) => (),
        _ => checker_record_opaque_call_placement(cell = cell, errors = errors)
      }
    },
    None => ()
  }
}

fn builtin_label_refusal(fname: String, lbl: String, at: Int, labels: Option[Array[String]]) -> String {
  let remove = String::concat("remove `", String::concat(lbl, " = `"))
  match labels {
    None => String::concat("builtin `", String::concat(fname, String::concat("` takes positional arguments: ", String::concat(remove, " and write the arguments in parameter order")))),
    Some(names) => {
      let slot = if at < Array::length(names) {
        Array::get(names, at = at)
      } else {
        ""
      }
      let mut declared = -1
      let mut k = 0
      while k < Array::length(names) && declared < 0 {
        if lbl != "_" && Array::get(names, at = k) == lbl {
          declared = k
        } else {
          ()
        }
        k = k + 1
      }
      if fname == "sh_lines" {
        String::concat("the command of `sh_lines` is positional: ", String::concat(remove, " (labels after the command are flags)"))
      } else if declared >= 0 {
        String::concat("labeled argument `", String::concat(lbl, String::concat("` for builtin `", String::concat(fname, String::concat("` is out of parameter order: `", String::concat(lbl, String::concat("` is argument ", String::concat(__to_string(declared + 1), ", so write the arguments in parameter order"))))))))
      } else if slot == "_" {
        String::concat("argument ", String::concat(__to_string(at + 1), String::concat(" of builtin `", String::concat(fname, String::concat("` is positional: ", remove)))))
      } else {
        String::concat("builtin `", String::concat(fname, String::concat("` has no parameter `", String::concat(lbl, String::concat("`: ", String::concat(remove, builtin_label_list_hint(names)))))))
      }
    }
  }
}

/// ` (its labels are `at`, `value`)`, or ` (every argument is positional)`
/// when no slot has a label.
fn builtin_label_list_hint(_ names: Array[String]) -> String {
  let named = array_empty()
  for n in names {
    if n == "_" {
      ()
    } else {
      Array::push(named, value = String::concat("`", String::concat(n, "`")))
    }
  }
  if Array::length(named) == 0 {
    " (every argument is positional)"
  } else {
    String::concat(" (its labels are ", String::concat(String::join(named, sep = ", "), ")"))
  }
}

fn placement_source_name(_ callee: Expr) -> String {
  match callee {
    EIdent(name, _) => name,
    EDot(_, name, _, _) => name,
    _ => "<call>"
  }
}

fn placement_has_labels(_ args: Array[Expr]) -> Bool {
  let mut found = false
  for arg in args {
    match arg {
      ELabeledArg(_, _, _) => found = true,
      _ => ()
    }
  }
  found
}

fn placement_check_mixed(name: String, offset: Int, args: Array[Expr], errors: Array[String]) -> Unit {
  let mut labeled = false
  let mut plain = false
  for arg in args {
    match arg {
      ELabeledArg(_, _, _) => labeled = true,
      _ => plain = true
    }
  }
  if labeled && plain {
    Array::push(errors, value = "call to " + name + " mixes positional and labeled arguments — use either all positional or all labeled arguments" + off_marker_len(off = offset, len = String::length(name)))
  } else {
    ()
  }
}

/// `written_len` is the callee as the source spells it: the canonical `name`
/// for a direct call, the alias for one through an import alias (#3832), so
/// the diagnostic's range covers what was written (Codex on #3839).
fn placement_check_builtin(name: String, written_len: Int, offset: Int, args: Array[Expr], errors: Array[String]) -> Unit {
  let labels = builtin_param_labels(name)
  let mut ai = 0
  let mut reported = false
  while ai < Array::length(args) && !reported {
    match Array::get(args, at = ai) {
      ELabeledArg(label, _, _) => {
        let valid = if canonical_builtin_name(name) == "sh_lines" && ai > 0 {
          true
        } else {
          match labels {
            Some(names) => label != "_" && ai < Array::length(names) && Array::get(names, at = ai) == label,
            None => false
          }
        }
        if !valid {
          Array::push(errors, value = builtin_label_refusal(fname = name, lbl = label, at = ai, labels = labels) + off_marker_len(off = offset, len = written_len))
          reported = true
        } else {
          ()
        }
      },
      _ => ()
    }
    ai = ai + 1
  }
}

fn placement_check_declared(name: String, offset: Int, args: Array[Expr], names: Array[String], slots: Option[Array[Int]], defaults: Option[Array[Bool]], errors: Array[String]) -> Unit {
  if placement_plain_at_positional_slots(args = args, names = names) {
    ()
  } else {
    placement_check_mixed(name = name, offset = offset, args = args, errors = errors)
  }
  let marker = off_marker_len(off = offset, len = String::length(name))
  let mut ai = 0
  while ai < Array::length(args) {
    let arg = Array::get(args, at = ai)
    let slot = match arg {
      ELabeledArg(label, _, _) => {
        let mut found = -1
        let mut pi = 0
        while pi < Array::length(names) && found < 0 {
          if placement_param_name(Array::get(names, at = pi)) == label {
            found = pi
          } else {
            ()
          }
          pi = pi + 1
        }
        if found >= 0 && checker_header_name_is_positional(Array::get(names, at = found)) {
          Array::push(errors, value = "argument " + __to_string(found + 1) + " of " + name + " is positional (the declaration writes `_` before it): remove `" + label + " = `" + marker)
        } else {
          ()
        }
        match slots {
          Some(_) => (),
          None => if found < 0 {
            Array::push(errors, value = "unknown labeled argument `" + label + "` for " + name + marker)
          } else if ai != found {
            Array::push(errors, value = "labeled argument `" + label + "` for " + name + " is out of declared parameter order" + marker)
          } else {
            ()
          }
        }
        if found >= 0 {
          found
        } else {
          ai
        }
      },
      _ => ai
    }
    match defaults {
      Some(flags) => if slot < Array::length(flags) && Array::get(flags, at = slot) && placement_option_value(arg) {
        Array::push(errors, value = "argument " + __to_string(slot + 1) + " of " + name + " is a written `None` / `Some(..)` for a parameter with a default, which would read as an omitted argument; bind the value first (`let v: T = None`) and pass `v`, or omit the argument to use the default" + marker)
      } else {
        ()
      },
      None => ()
    }
    ai = ai + 1
  }
}

fn placement_check_uncertain(env: TypeEnv, name: String, offset: Int, args: Array[Expr], errors: Array[String]) -> Unit {
  let uncertain = match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginUncertainFunctionHeader => true,
      BindingOriginMutableFunctionHeader(box) => Array::get(box, at = 0).0 == 2,
      _ => false
    },
    None => false
  }
  if uncertain && placement_has_labels(args) {
    Array::push(errors, value = "cannot resolve labeled arguments for " + name + ": a branch, loop or closure assigns it a lambda with different parameter names, so a label does not name a position here — call " + name + " positionally, or give every lambda assigned to " + name + " the same parameter names" + off_marker_len(off = offset, len = String::length(name)))
  } else {
    ()
  }
}

/// Defaults are declaration-only facts. A value reference cannot preserve
/// their omission contract through an ordinary function type.
export fn checker_check_defaulted_value(env: TypeEnv, name: String, offset: Int, errors: Array[String]) -> Unit {
  if checker_call_header_is_probe() {
    ()
  } else {
    // One lookup serves both checks: this runs for every value reference.
    match env_lookup_binding(env = env, name = name) {
      Some(binding) => {
        match checker_header_defaults_of(binding.origin) {
          Some(_) => Array::push(errors, value = name + " has parameter defaults, which apply only to a direct call, so it cannot be used as a value; wrap it in a lambda that calls it, e.g. `(a) -> " + name + "(a)`" + off_marker_len(off = offset, len = String::length(name))),
          None => ()
        }
        checker_check_aliased_builtin_value(env = env, name = name, origin = binding.origin, offset = offset, errors = errors)
      },
      None => ()
    }
  }
}

/// #3833: a call-only builtin reached through an import alias is refused as a
/// value exactly as its canonical spelling is: `let g = D::floor` after
/// `import @vibe/builtin { Float64 as D }`, and `let g = fl` after
/// `{ Float64::floor as fl }`. The alias is an ordinary binding, so the
/// builtin branch that refuses `let g = Float64::floor` never saw it, and the
/// value reached code generation as an internal error. The marker is looked
/// up only for a binding renamed from another source name.
fn checker_check_aliased_builtin_value(env: TypeEnv, name: String, origin: BindingOrigin, offset: Int, errors: Array[String]) -> Unit {
  match checker_builtin_alias_of(env = env, name = name, origin = origin) {
    // The stdin provider operations have a refusal of their own, which names
    // the edit for them: wrap the call in an explicitly effectful function.
    Some(canonical) => if is_stdin_provider_import_value(canonical) {
      ()
    } else match lookup_builtin(canonical) {
      Some(t) => if builtin_ident_is_value(name = canonical, t = t) {
        ()
      } else {
        Array::push(errors, value = call_only_builtin_ident_error(name = canonical, ty = t, ident_off = 0 - 1) + off_marker_len(off = offset, len = String::length(name)))
      },
      None => ()
    },
    None => ()
  }
}

/// Receiver/namespace dispatch supplies the declaration it actually resolved.
/// Capture optional-only calls here as well, without scanning source bindings.
export fn checker_capture_resolved_call_placement(callee: Expr, args: Array[Expr], offset: Int, cell: Array[Int], env: TypeEnv, name: String) -> Unit {
  let needed = placement_has_labels(args) || checker_call_header_has_optional(env = env, name = name)
  if needed && !checker_call_header_is_probe() {
    call_placement_capture_source(callee = callee, args = args, offset = offset, cell = cell, macro_call = false)
  } else {
    ()
  }
}
