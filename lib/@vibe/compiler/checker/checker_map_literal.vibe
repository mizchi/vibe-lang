// Leaf type predicates split out of checker_lambda_expr.vibe and
// checker_expr_capture_impl.vibe: map literal value types, and the handler
// arm's `resume` continuation marker.

import @vibe/compiler/core {
  Type
}

//# Functions

/// Whether a map literal's value type is a scalar the literal's check can
/// judge as it stands: the builtin scalars, `Int32` / `UInt32` (#3730)
/// included.
export fn map_literal_ground(_ t: Type) -> Bool {
  match t {
    CtInt => true,
    CtInt32 => true,
    CtUInt32 => true,
    CtDouble => true,
    CtFloat => true,
    CtBool => true,
    CtString => true,
    CtChar => true,
    _ => false
  }
}

/// #3301: what check_resume_values' walk starts with `resume` bound to: the
/// arm's own continuation. A binder the walk meets inside the arm rebinds the
/// name to something else, which is what shadows it.
export fn resume_continuation_marker() -> Type {
  CtNamed("$resume_continuation", [])
}

/// Whether `t` is that marker.
export fn resume_is_continuation(_ t: Type) -> Bool {
  match t {
    CtNamed(name, _) => name == "$resume_continuation",
    _ => false
  }
}
