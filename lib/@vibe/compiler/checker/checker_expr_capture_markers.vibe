// Small pure helpers of `checker_expr_capture_impl.vibe` and
// `checker_lambda_expr.vibe`, split out to keep those files under the
// source-size limit.

import @vibe/compiler/core {
  Subst, Type, subst_apply, type_to_string, unify
}

import @vibe/compiler/checker/diagnostics {
  off_marker
}

//# Functions

/// #3541: settle the binder of an ERASED exception arm (`Exception::Throw(m)`)
/// once its body is typed. `var` is the fresh variable `m` was bound to. A
/// body that left it open used `m` only where any type is accepted, and it is
/// pinned to `String`, the thrown message, so a later use outside the arm
/// (the handle's result) is checked against that. A body that used it as
/// `String` is accepted. Any other type is refused with the edit: only a
/// kinded arm knows its payload's type.
export fn erased_throw_binder_settle(name: String, var: Type, s: Subst, errors: Array[String], off: Int) -> Subst {
  let now = subst_apply(s = s, ty = var)
  match now {
    CtString => s,
    CtVar(_) => match unify(a = now, b = CtString, s = s) {
      Some(s2) => s2,
      None => s
    },
    _ => {
      let shown = type_to_string(now)
      let edit = String::concat("write `Exception[", String::concat(shown, String::concat("]::Throw(", String::concat(name, String::concat(")` to catch a thrown `", String::concat(shown, "`"))))))
      let why = String::concat(": the erased `Exception::Throw(", String::concat(name, String::concat(")` arm binds `", String::concat(name, String::concat("` as the thrown message, a `String`, and this arm uses it as `", String::concat(shown, "`"))))))
      Array::push(errors, value = String::concat(edit, String::concat(why, off_marker(off))))
      s
    }
  }
}

export fn resume_is_continuation(_ t: Type) -> Bool {
  match t {
    CtNamed(name, _) => name == "$resume_continuation",
    _ => false
  }
}

/// #3248: the marker an unknown assignment target carries. ` [@assign-target=N]`
/// names the target token the parser recorded (`N` is its start byte, so the
/// locator can read the token's own extent back, `r#name` included). A
/// synthesized assignment has no token (`off < 0`) and gets the bare
/// ` [@assign-target]`, which the locator strips without inventing a position.
export fn assign_target_marker(_ off: Int) -> String {
  if off >= 0 {
    String::concat(" [@assign-target=", String::concat(__to_string(off), "]"))
  } else {
    " [@assign-target]"
  }
}

/// #3301: what check_resume_values' walk starts with `resume` bound to: the
/// arm's own continuation. A binder the walk meets inside the arm rebinds the
/// name to something else, which is what shadows it.
export fn resume_continuation_marker() -> Type {
  CtNamed("$resume_continuation", [])
}

/// #2820: the same shape for a BUILTIN receiver (`Array`, `Map`, `Bytes`,
/// `String`, ...). A builtin container has no fields at all, so unlike the
/// struct case there is no "you named the wrong one" reading -- the only edit
/// that can give `.name` a meaning is a qualified call, which is also what the
/// dot-call diagnostics on these receivers already recommend
/// (``call it as `Array::length(...)` ``). Leading with that keeps one
/// vocabulary across both.
export fn builtin_field_access_message(type_name: String, field: String) -> String {
  String::concat("call `", String::concat(type_name, String::concat("::", String::concat(field, String::concat("(...)` if you meant a method; field access `.", String::concat(field, String::concat("` needs a struct, and ", String::concat(type_name, " is a builtin type"))))))))
}

/// #2848: the same shape for a receiver typed by a TYPE PARAMETER. Nothing a
/// bound can say promises `T` a field -- there is no `HasField` bound, and a
/// generic body is lowered once for every instantiation -- so the only edit
/// that gives `.name` a meaning is naming the struct in the signature. Before
/// this refusal the read typed as `CtUnknown` and codegen resolved the field
/// by SPELLING against any struct in the program declaring it: measured on the
/// committed seed, `struct Crate { payload: Int }` in scope and `fn read[T](m:
/// T) -> Int { m.payload }` applied to `7` compiled clean and answered `0`,
/// slot 0 of a tagged integer read through `Crate`'s offset; with no struct
/// declaring the name the same program was clean in `vibe check` and died in
/// the build with an unlocated `unknown struct field: v`.
export fn formal_field_access_message(tparam: String, field: String) -> String {
  String::concat("write the struct that declares `", String::concat(field, String::concat("` in place of the type parameter `", String::concat(tparam, String::concat("`; field access `.", String::concat(field, String::concat("` needs a struct, and a bound on `", String::concat(tparam, "` cannot promise one"))))))))
}
