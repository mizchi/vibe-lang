//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn map_one_param(_ a: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, value = a)
  arr
}

fn map_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, value = a)
  Array::push(arr, value = b)
  arr
}

fn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, value = a)
  Array::push(arr, value = b)
  Array::push(arr, value = c)
  arr
}

fn lookup_map_set(_ name: String) -> Option[Type] {
  if name == "Map::set" {
    Some(CtFn(map_three_params(a = CtUnknown, b = CtString, c = CtUnknown), CtNamed("Map", [
      CtString,
      CtUnknown
    ]), None))
  }
  else None
}

fn lookup_map_has_key(_ name: String) -> Option[Type] {
  if name == "Map::has_key" || name == "Map::has" {
    Some(CtFn(map_two_params(a = CtUnknown, b = CtString), CtBool, None))
  }
  else None
}

fn lookup_map_size(_ name: String) -> Option[Type] {
  if name == "Map::size" {
    Some(CtFn(map_one_param(CtUnknown), CtInt, None))
  }
  else None
}

fn lookup_map_values(_ name: String) -> Option[Type] {
  if name == "Map::values" {
    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_map_delete(_ name: String) -> Option[Type] {
  if name == "Map::delete" {
    Some(CtFn(map_two_params(a = CtUnknown, b = CtString), CtNamed("Map", [
      CtString,
      CtUnknown
    ]), None))
  }
  else None
}

export fn lookup_map(_ name: String) -> Option[Type] {
  match lookup_map_set(name) {
    Some(t) => Some(t),
    None => match lookup_map_has_key(name) {
      Some(t) => Some(t),
      None => match lookup_map_size(name) {
        Some(t) => Some(t),
        None => match lookup_map_values(name) {
          Some(t) => Some(t),
          None => lookup_map_delete(name)
        }
      }
    }
  }
}
