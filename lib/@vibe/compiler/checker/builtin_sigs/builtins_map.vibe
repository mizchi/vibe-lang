//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn map_one_param(a: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  arr
}

fn map_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

// #2334: the KEY positions are open (`?`) because the key type is the
// receiver's key slot, which only the call arms (checker_call_map.vibe) can
// read; a table row cannot mint a per-call variable.
fn lookup_map_set(name: String) -> Option[Type] {
  if name == "Map::set" {
    Some(CtFn(map_three_params(CtUnknown, CtUnknown, CtUnknown), CtNamed("Map", [
      CtUnknown,
      CtUnknown
    ]), None))
  }
  else None
}

fn lookup_map_has_key(name: String) -> Option[Type] {
  if name == "Map::has_key" || name == "Map::has" {
    Some(CtFn(map_two_params(CtUnknown, CtUnknown), CtBool, None))
  }
  else None
}

fn lookup_map_size(name: String) -> Option[Type] {
  if name == "Map::size" {
    Some(CtFn(map_one_param(CtUnknown), CtInt, None))
  }
  else None
}

fn lookup_map_values(name: String) -> Option[Type] {
  if name == "Map::values" {
    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_map_delete(name: String) -> Option[Type] {
  if name == "Map::delete" {
    Some(CtFn(map_two_params(CtUnknown, CtUnknown), CtNamed("Map", [
      CtUnknown,
      CtUnknown
    ]), None))
  }
  else None
}

export fn lookup_map(name: String) -> Option[Type] {
  match lookup_map_set(name) {
    Some(t) => Some(t),
    None => match lookup_map_has_key(name) {
      Some(t) => Some(t),
      None => match lookup_map_size(name) {
        Some(t) => Some(t),
        None => match lookup_map_values(name) {
          Some(t) => Some(t),
          None => lookup_map_delete(name)
        }
      }
    }
  }
}
