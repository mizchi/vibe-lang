//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn misc_no_params() -> Array[Type] {
  array_empty()
}

fn misc_one_param(_ a: Type) -> Array[Type] {
  let arr = misc_no_params()
  Array::push(arr, value = a)
  arr
}

fn misc_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = misc_no_params()
  Array::push(arr, value = a)
  Array::push(arr, value = b)
  arr
}

fn lookup_arithmetic_helper(_ name: String) -> Option[Type] {
  if name == "add" || name == "sub" || name == "mul" {
    Some(CtFn(misc_two_params(a = CtInt, b = CtInt), CtInt, None))
  } else if name == "lt" {
    Some(CtFn(misc_two_params(a = CtInt, b = CtInt), CtBool, None))
  } else {
    None
  }
}

fn lookup_none(_ name: String) -> Option[Type] {
  if name == "None" {
    Some(CtOption(CtUnknown))
  }
  else None
}

fn lookup_some(_ name: String) -> Option[Type] {
  if name == "Some" {
    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))
  }
  else None
}

fn lookup_index(_ name: String) -> Option[Type] {
  if name == "__index" {
    Some(CtFn(misc_two_params(a = CtUnknown, b = CtUnknown), CtUnknown, None))
  }
  else if name == "__set_field" {
    // Build the param list inline rather than via the shared `misc_three_params`
    // helper: adding a second call site for that private helper triggered a
    // namespace-hash collision in the wasm bundler (#492).
    let set_field_params = misc_no_params()
    Array::push(set_field_params, value = CtUnknown)
    Array::push(set_field_params, value = CtString)
    Array::push(set_field_params, value = CtUnknown)
    Some(CtFn(set_field_params, CtUnit, None))
  }
  else None
}

fn lookup_throw(_ name: String) -> Option[Type] {
  if name == "throw" {
    // #786: `throw` accepts any value, not just String — a `suberror` value
    // (`throw(KeyInvalid("x"))`) is thrown through the same Exception effect.
    // The Exception handler arms are unchecked (see checker EHandle), so
    // widening the payload from CtString to CtUnknown only affects the throw
    // call site and still accepts every existing `throw("msg")`.
    //
    // #1461: the label is the CANONICAL erased spelling, so it moved with
    // canonical_exception_effect_name. `with Exception` still authorizes this
    // requirement -- the comparison goes through exception_effect_labels_equal.
    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, Some("Exception")))
  }
  else None
}

/// #1374: the static type name of the payload of the throw currently being
/// handled, or "" when the throw site's payload type was not syntactically
/// resolvable. Only meaningful INSIDE an exception handler arm.
///
/// This is a checker-only intrinsic: it has no wasm body and no entry in the
/// codegen builtin registry, because `desugar_trait_dicts` lowers every call to
/// a read of the one-slot module cell it also maintains (see the "#1374"
/// section of desugar_trait_dict.vibe). Effect `None` -- reading the cell can
/// neither perform nor throw.
///
/// It exists because ADR-0085's runtime carries a single abortive tag with no
/// kind, so an erased `with Exception { Throw(m) => .. }` arm also catches every
/// typed `Exception[E]` and cannot otherwise tell what `m` actually is.
///
/// `__exn_message` (#1392 slice 3) is the companion read: the payload RENDERED
/// at the throw site, where its static type is still known. The kind alone says
/// "this is not text" without saying what it says, and the arm cannot recover
/// that -- its binder is `CtUnknown`, so no `T::to_string` and no `[T: Show]`
/// witness resolves there. Same shape, same cell, same one-unwind window.
fn lookup_exn_kind(_ name: String) -> Option[Type] {
  if name == "__exn_kind" || name == "__exn_message" {
    Some(CtFn(misc_no_params(), CtString, None))
  }
  else None
}

/// #2913: only `Map::iter_get` remains. The six names that stood beside it --
/// bare `iter_require` / `iter_length` / `iter_get`, and `String::iter_length`
/// / `String::iter_get` / `Map::iter_length` -- were admitted here and emitted
/// NOWHERE, so writing one gave a clean `vibe check` and then
/// `internal compiler error: ... reached code generation unresolved`.
///
/// Measured before removing, because deleting a name the lowering generates
/// would be worse than leaving it: every occurrence of the six across
/// `lib/@vibe/compiler` is a `name == "..."` test in the checker, and none is
/// an emission. `Map::iter_get` is the opposite -- the lowering builds calls to
/// it in ten places -- which is why it stays.
///
/// The iterator protocol itself is untouched and does not run through these.
/// `desugar_trait_dict.vibe:7665` emits `ECall(EIdent(<ctype>::iter_get))`
/// gated on `fn_exists(fn_returns, tn ++ "::iter_length")`, which reads
/// USER-declared functions: a struct that declares its own `T::iter_length` /
/// `T::iter_get` is iterable, and that path never consulted the rows below.
/// Verified end to end with a `for v in bag` over such a struct.
fn lookup_iter_intrinsic(_ name: String) -> Option[Type] {
  if name == "Map::iter_get" {
    // Map iteration yields keys. Keep the value parameter erased, but retain
    // the nominal receiver so arbitrary integers cannot reach raw key loads.
    Some(CtFn(misc_two_params(a = CtNamed("Map", [CtUnknown, CtUnknown]), b = CtInt), CtString, None))
  } else {
    None
  }
}

fn lookup_misc_group_a(_ name: String) -> Option[Type] {
  // #2913: `lookup_neg` used to sit between these two. `__neg` is a PHANTOM --
  // it is typed nowhere else, lowered nowhere at all (no occurrence outside
  // the checker, its own `declare` and one test), and it ICEs in every form:
  // `Int`, `Double`, and the literal `__neg(3.5f)`.
  //
  // What kept it alive is the #2248 shape. Its only test asserts
  // `check_source_ok("... __neg(3.5f) ...")` -- the CHECKER, which is exactly
  // the half that works. The half that does not was never asked.
  match lookup_arithmetic_helper(name) {
    Some(t) => Some(t),
    None => match lookup_exn_kind(name) {
      Some(t) => Some(t),
      // `__slice` / `__len` are deliberately NOT first-class builtins.
      // Their direct parser-generated calls are type-directed in checker.vibe;
      // exposing an all-Unknown function signature here would let an alias
      // bypass those receiver and same-result-type checks (#1682).
      None => lookup_index(name)
    }
  }
}

fn lookup_misc_group_e(_ name: String) -> Option[Type] {
  if name == "__rec_field" {
    // record-pattern desugar: __rec_field(record, index) -> field value.
    // Lenient (field type unknown); only needs to resolve, not constrain.
    Some(CtFn(misc_two_params(a = CtUnknown, b = CtInt), CtUnknown, None))
  } else {
    match lookup_iter_intrinsic(name) {
      Some(t) => Some(t),
      None => lookup_none(name)
    }
  }
}

fn lookup_double_to_int(_ name: String) -> Option[Type] {
  // `Double::to_int` is registry-backed; `Float::to_int` is a fallback-only
  // spelling over the same representation (an f32 value held as an f64), so
  // it lowers through the same saturating truncation.
  if name == "Float32::to_int" {
    Some(CtFn(misc_one_param(CtFloat), CtInt, None))
  }
  else None
}

fn lookup_int_to_double(_ name: String) -> Option[Type] {
  if name == "Int::to_string" {
    // Documented in the cheatsheet's conversion set but never wired up —
    // codegen lowers it to the `__to_string` integer path (#740 fallout:
    // ripple_test rotted against it).
    Some(CtFn(misc_one_param(CtInt), CtString, None))
  }
  else None
}

fn lookup_double_to_i64_bits(_ name: String) -> Option[Type] {
  if name == "Float64::to_i64_bits_lo" || name == "Float64::to_i64_bits_hi" {
    Some(CtFn(misc_one_param(CtDouble), CtInt, None))
  }
  else if name == "Float64::from_i64_bits_lohi" {
    // The inverse of the pair above, and it has to BE a pair: an `Int` is
    // 63-bit, so the whole 64-bit pattern does not fit in one of them
    // (ADR-0055 Blocker-2). `-1.5` is 0xBFF8000000000000, already out of
    // range, so the single-`Int` `Double::from_i64_bits` cannot express any
    // negative double at all. Each 32-bit half fits comfortably. (#2651)
    Some(CtFn(misc_two_params(a = CtInt, b = CtInt), CtDouble, None))
  }
  else None
}

/// #3730 (ADR-0122 (5)): the conversions between `Int` and the exact 32-bit
/// integers. None is implicit: widening is total (`Int32::to_int`), and
/// narrowing is checked (`Int::to_int32`, an `Option`) or wraps by name
/// (`Int::wrap_int32`). The post-check desugar rewrites each to `Int`
/// arithmetic before any lowering sees it.
fn lookup_sized_int_conversion(_ name: String) -> Option[Type] {
  if name == "Int32::to_int" {
    Some(CtFn(misc_one_param(CtInt32), CtInt, None))
  }
  else if name == "UInt32::to_int" {
    Some(CtFn(misc_one_param(CtUInt32), CtInt, None))
  }
  else if name == "Int::to_int32" {
    Some(CtFn(misc_one_param(CtInt), CtOption(CtInt32), None))
  }
  else if name == "Int::to_uint32" {
    Some(CtFn(misc_one_param(CtInt), CtOption(CtUInt32), None))
  }
  else if name == "Int::wrap_int32" {
    Some(CtFn(misc_one_param(CtInt), CtInt32, None))
  }
  else if name == "Int::wrap_uint32" {
    Some(CtFn(misc_one_param(CtInt), CtUInt32, None))
  }
  else if name == "Int32::to_string" {
    Some(CtFn(misc_one_param(CtInt32), CtString, None))
  }
  else if name == "UInt32::to_string" {
    Some(CtFn(misc_one_param(CtUInt32), CtString, None))
  }
  else None
}

fn lookup_misc_group_c(_ name: String) -> Option[Type] {
  match lookup_throw(name) {
    Some(t) => Some(t),
    None => match lookup_int_to_double(name) {
      Some(t) => Some(t),
      None => match lookup_double_to_int(name) {
        Some(t) => Some(t),
        None => match lookup_double_to_i64_bits(name) {
          Some(t) => Some(t),
          None => lookup_sized_int_conversion(name)
        }
      }
    }
  }
}

fn lookup_misc_group_d(_ name: String) -> Option[Type] {
  lookup_some(name)
}

/// Double::to_string / Float::to_string are fallback-only spellings; codegen
/// lowers them through `double_to_string_expr` / `float_to_string_expr`, the
/// shortest round-trip spelling of the f64 or of the f32 respectively.
fn lookup_double_to_string(_ name: String) -> Option[Type] {
  if name == "Float64::to_string" {
    Some(CtFn(misc_one_param(CtDouble), CtString, None))
  }
  else if name == "Float32::to_string" {
    Some(CtFn(misc_one_param(CtFloat), CtString, None))
  }
  else None
}

/// Native single-opcode f64 ops (f64.abs/floor/ceil/min/max) — cheap to wire
/// up since wasm has direct instructions for all of them.
fn lookup_double_unary_op(_ name: String) -> Option[Type] {
  if name == "Float64::abs" || name == "Float64::floor" || name == "Float64::ceil" {
    Some(CtFn(misc_one_param(CtDouble), CtDouble, None))
  }
  else None
}

fn lookup_double_binary_op(_ name: String) -> Option[Type] {
  if name == "Float64::max" || name == "Float64::min" {
    Some(CtFn(misc_two_params(a = CtDouble, b = CtDouble), CtDouble, None))
  }
  else None
}

/// Int::abs/signum/is_even/is_odd/max/min/clamp are intentionally NOT
/// registered as compiler builtins here: lib/@vibe/builtin/int.vibe already
/// defines all of them as regular user-space functions (with correct
/// overflow/saturation semantics, e.g. Int::abs(int_min_value) ==
/// int_max_value). Registering them as builtins too would let this
/// checker-side entry win over the prelude definition and silently swap in
/// different (wrong-for-edge-cases) codegen — this previously broke
/// lib/@vibe/builtin/int_test.vibe after a #767 attempt added them.
fn lookup_int_parse(_ name: String) -> Option[Type] {
  if name == "Int::parse" {
    Some(CtFn(misc_one_param(CtString), CtOption(CtInt), None))
  }
  else if name == "Float64::parse" {
    Some(CtFn(misc_one_param(CtString), CtOption(CtDouble), None))
  }
  else None
}

fn lookup_misc_group_f(_ name: String) -> Option[Type] {
  match lookup_double_to_string(name) {
    Some(t) => Some(t),
    None => match lookup_double_unary_op(name) {
      Some(t) => Some(t),
      None => match lookup_double_binary_op(name) {
        Some(t) => Some(t),
        None => lookup_int_parse(name)
      }
    }
  }
}

export fn lookup_misc(_ name: String) -> Option[Type] {
  match lookup_misc_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_misc_group_c(name) {
      Some(t) => Some(t),
      None => match lookup_misc_group_d(name) {
        Some(t) => Some(t),
        None => match lookup_misc_group_e(name) {
          Some(t) => Some(t),
          None => lookup_misc_group_f(name)
        }
      }
    }
  }
}
