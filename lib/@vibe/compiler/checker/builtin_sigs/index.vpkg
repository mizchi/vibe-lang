name = @vibe/compiler/checker/builtin_sigs
version = 0.0.1
description =
  #|@vibe/compiler/checker/builtin_sigs — the type signatures of the compiler's builtins
deps = {
  @vibe/ast : 0.2.0
  @vibe/compiler/core : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

// @vibe/compiler/checker/builtin_sigs — the type signature of every builtin
// the checker types by name (`lookup_builtin` and the per-family `lookup_*`
// tables), and which by-name call arm a builtin call may take
// (builtin_call_arms.vibe). Directory-shared-scope package.
//
// It is a leaf: it reads the builtin registry and the binding environment
// from @vibe/compiler/core and never calls back into the checker. The
// checker and its effect pass both import it.

// --- builtins.vibe
fn lookup_builtin(name: String) -> Option[Type]
fn lookup_builtin_fallback(normalized: String) -> Option[Type]

// --- builtins_array.vibe
fn lookup_array(name: String) -> Option[Type]

// --- builtins_async.vibe
fn lookup_async(name: String) -> Option[Type]

// --- builtins_builders.vibe
fn lookup_array_builder(name: String) -> Option[Type]
fn lookup_string_builder(name: String) -> Option[Type]

// --- builtins_bytes.vibe
fn lookup_bytes(name: String) -> Option[Type]

// --- builtins_fixed_array.vibe
fn lookup_fixed_array(name: String) -> Option[Type]

// --- builtins_frozen_array.vibe
fn lookup_frozen_array(name: String) -> Option[Type]

// --- builtins_fs.vibe
fn lookup_fs(name: String) -> Option[Type]

// --- builtins_map.vibe
fn lookup_map(name: String) -> Option[Type]

// --- builtins_misc.vibe
fn lookup_misc(name: String) -> Option[Type]

// --- builtins_net.vibe
fn lookup_net(name: String) -> Option[Type]

// --- builtins_string1.vibe
fn lookup_string1(name: String) -> Option[Type]

// --- builtins_string2.vibe
fn lookup_string2(name: String) -> Option[Type]

// --- builtins_system.vibe
fn lookup_io(name: String) -> Option[Type]

// --- builtin_call_arms.vibe (#3146, #3179): which call a builtin's by-name
// arm may type. Shared by the checker and its effect pass.
fn builtin_resolves_at(env: TypeEnv, name: String, ident_off: Int) -> Bool
fn builtin_call_arm(env: TypeEnv, name: String, argc: Int, callee_off: Int) -> String
fn builtin_call_arms() -> Array[(String, Int)]
fn resolve_builtin_callee(env: TypeEnv, name: String, ident_off: Int, resolution: Array[Int]) -> Int
