import @vibe/core {
  array_empty
}

/// The state of one walk over a handled body.
struct HceWalk {
  /// Bases of the effects whose performs count (`Ask`, `Exception`).
  mut labels: Array[String];
  /// Names bound inside the handled body, innermost last, each with the
  /// effect base of the handle-bound value it holds ("" for a plain value)
  /// and the declarations a local alias of a function stands for (#3596;
  /// comma-joined, "" for any other binding), and the binding's identity in
  /// `assigned` and `links` (`hce_declare`).
  scope: Array[(String, String, String, Int)];
  /// Every counted perform, in walk order: its offset and effect base.
  performs: Array[(Int, String)];
  /// Handle-bound values found: (description, offset, effect base, reach).
  /// The reach says where the value can go: 0 nowhere (applied in place, or
  /// bound by `let` and only ever called), 1 into a call that returns no
  /// function (which might store it), 2 anywhere.
  producers: Array[(String, Int, String, Int)];
  /// The reach of the expression the walk is about to enter, set by its
  /// parent and read once on entry (see `hce_walk`). `hce_let_reach` marks
  /// a `let` initializer, whose reach its uses decide.
  mut pos: Int;
  /// How many references to a handle-bound local the walk has passed, and
  /// the effect base of the latest.
  mut mentions: Int;
  mut mention_label: String;
  /// Whether the walk also looks for routes out (the second pass).
  find_routes: Bool;
  /// Closure literals the walk is inside: a `return` there leaves the
  /// closure, not the handle.
  mut fn_depth: Int;
  /// The routes out found: (what it is, offset, the reach a value needs to
  /// take it).
  routes: Array[(String, Int, Int)];
  /// Calls handed a handle-bound value that may keep it: (what, offset,
  /// the effects the parameter does not take). Named only when no other
  /// route, nor the handle's value, explains the refusal.
  keeps: Array[(String, Int, String)];
  /// Where the handled body's rows begin in `call_callee_sites`.
  sites_from: Int;
  /// Every name a `let` in the handled body binds, wherever it sits.
  body_names: Array[String];
  /// #4051: the parameter names of each `loop` the walk is inside,
  /// innermost last, which a `continue` assigns.
  loops: Array[Array[String]];
  /// #4051: by declaration, the effect bases of the handle-bound values
  /// assigned to a binding of the body (`=`, `+=`, a `continue`), kept from
  /// one walk of the body to the next (see `hce_walk_body`). A declaration
  /// is identified by its place in walk order (`next_decl`), which every
  /// walk of the same body repeats, so a binding of the same spelling in
  /// another scope -- shadowing it, or beside it -- has a fact of its own.
  assigned: Array[(Int, String)];
  /// #4064: by declaration, the bindings of the body each binding was
  /// taken from (`let a2 = arr`, `for row in rows`, `Box::{ fs: arr }`),
  /// whose storage it may share. The flag restricts a link to writes into
  /// an element or field. Kept across walks like `assigned`.
  links: Array[(Int, Int, Bool)];
  /// The identity the next binding the walk binds takes.
  mut next_decl: Int;
  /// Whether this walk added to `assigned`.
  mut grew: Bool;
  /// Where the producers of each argument of the call the walk last
  /// finished begin, and where the last one's end (`hce_match_parts`).
  mut arg_marks: Array[Int]
}

/// Refuse a handle-bound value leaving the handle `body` / `arms` checked
/// at `body_ty`. `env` is the environment the handle is written in, so a
/// name it binds is declared outside the body. `sites_from` is the length of
/// `call_callee_sites` before the body was checked.
export fn refuse_handle_bound_escape(body: Expr, arms: Array[(Pat, Expr)], body_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, sites_from: Int, errors: Array[String]) -> Unit {
  let unsure_before = Array::length(hce_unsure)
  let errors_before = Array::length(errors)
  hce_refuse(body = body, arms = arms, body_ty = body_ty, env = env, defs0 = defs, s = s, sites_from = sites_from, errors = errors)
  // A declaration read before its body was checked may have answered no
  // for want of the callee types that body records (Codex on #3594): ask
  // again once the module is checked (`hce_run_deferred`).
  if Array::length(hce_final) == 0 && Array::length(errors) == errors_before && Array::length(hce_unsure) > unsure_before {
    Array::push(hce_pending, value = (body, arms, body_ty, env, defs, s, sites_from))
  } else {
    ()
  }
  Array::truncate(hce_unsure, length = unsure_before)
}

/// `defs` and the declarations of other modules this one did not import by
/// name (`import dep { mk }` with `mk() -> Box`), whose fields decide
/// whether the handle's value can hold a function (#3593). Such a type
/// reaches the importer only as a reference marker in `env`
/// (`#typeref-def:Box`), whose identity spells its definition.
fn hce_defs_with_env(defs: Array[TypeDef], env: TypeEnv) -> Array[TypeDef] {
  let extra: Array[TypeDef] = array_empty()
  for row in hce_reference_rows(env) {
    let (name, identity) = row
    if (find_typedef(defs = defs, name = name) is None) && (find_typedef(defs = extra, name = name) is None) {
      match hce_reference_typedef(name = name, identity = identity) {
        Some(d) => Array::push(extra, value = d),
        None => ()
      }
    } else {
      ()
    }
  }
  if Array::length(extra) == 0 {
    defs
  } else {
    let out = Array::slice(defs, start = 0, end = Array::length(defs))
    for d in extra {
      Array::push(out, value = d)
    }
    out
  }
}

let hce_reference_prefix: String = "#typeref-def:"

/// Every type reference marker bound in `env`, as (type name, identity),
/// nearest first.
fn hce_reference_rows(_ env: TypeEnv) -> Array[(String, Type)] {
  let rows: Array[(String, Type)] = array_empty()
  let plen = String::length(hce_reference_prefix)
  let mut current = env
  let mut done = false
  while !done {
    match current {
      EnvBind(name, binding, rest) => {
        if String::starts_with(name, prefix = hce_reference_prefix) {
          Array::push(rows, value = (name[plen: String::length(name)], binding.ty))
        } else {
          ()
        }
        current = rest
      },
      EnvFlat(bindings) => {
        for entry in bindings {
          let (name, binding) = entry
          if String::starts_with(name, prefix = hce_reference_prefix) {
            Array::push(rows, value = (name[plen: String::length(name)], binding.ty))
          } else {
            ()
          }
        }
        done = true
      },
      EnvShowWrappers(_, _, rest) => current = rest,
      EnvTraitDef(_, _, _, _, rest, _, _) => current = rest,
      EnvTraitImpl(_, _, rest) => current = rest,
      EnvTraitImplGen(_, _, _, _, rest) => current = rest,
      EnvTypeDefs(_, _, rest) => current = rest,
      EnvMutCell(_, _, rest) => current = rest,
      EnvCached(_, _, rest) => current = rest,
      EnvEmpty => done = true
    }
  }
  rows
}

/// The declaration a type reference marker's identity spells: `(head,
/// definition[, mutable fields])`, the head naming the kind and carrying the
/// formals by position, which the definition refers to by those names.
fn hce_reference_typedef(name: String, identity: Type) -> Option[TypeDef] {
  match identity {
    CtTuple(parts) => if Array::length(parts) >= 2 {
      match Array::get(parts, at = 0) {
        CtNamed(head, formals) => {
          let params: Array[String] = array_empty()
          for f in formals {
            match f {
              CtNamed(p, _) => Array::push(params, value = p),
              _ => ()
            }
          }
          match Array::get(parts, at = 1) {
            CtRecord(items) => if String::starts_with(head, prefix = "#typeid.struct.") {
              let muts: Array[String] = array_empty()
              if Array::length(parts) >= 3 {
                match Array::get(parts, at = 2) {
                  CtTuple(ms) => for m in ms {
                    match m {
                      CtNamed(mn, _) => Array::push(muts, value = mn),
                      _ => ()
                    }
                  },
                  _ => ()
                }
              } else {
                ()
              }
              Some(TDStruct(name, items, muts, params))
            } else if String::starts_with(head, prefix = "#typeid.enum.") {
              let variants: Array[(String, Array[Type])] = array_empty()
              for v in items {
                let (vname, payload) = v
                match payload {
                  CtTuple(ps) => Array::push(variants, value = (vname, ps)),
                  _ => Array::push(variants, value = (vname, [payload]))
                }
              }
              Some(TDEnum(name, params, variants))
            } else if String::starts_with(head, prefix = "#typeid.type.") {
              Some(TDAlias(name, params, CtRecord(items)))
            } else {
              None
            },
            target => if String::starts_with(head, prefix = "#typeid.type.") {
              Some(TDAlias(name, params, target))
            } else {
              None
            }
          }
        },
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// Handles whose answer leaned on a declaration read before its body was
/// checked, to be asked again by `hce_run_deferred`.
let hce_pending: Array[(Expr, Array[(Pat, Expr)], Type, TypeEnv, Array[TypeDef], Subst, Int)] = [
]

/// The module's final substitution while `hce_run_deferred` runs; empty
/// otherwise.
let hce_final: Array[Subst] = []

/// One entry for each call a declaration's body was read through without
/// the callee type its check records (see `hce_note_unsure`).
let hce_unsure: Array[Int] = []

/// Where the handles a module's check is about to defer begin.
export fn hce_deferred_mark() -> Int {
  Array::length(hce_pending)
}

/// Forget the handles deferred from `mark` on: the statements that deferred
/// them are being checked again.
export fn hce_drop_deferred(_ mark: Int) -> Unit {
  if Array::length(hce_pending) > mark {
    Array::truncate(hce_pending, length = mark)
  } else {
    ()
  }
}

/// Ask again, now that every declaration of the module is checked and has
/// recorded its callee types, about the handles deferred from `mark` on.
/// `final_s` is the module's final substitution, which the types recorded
/// after a handle was checked are read under.
export fn hce_run_deferred(mark: Int, final_s: Subst, errors: Array[String]) -> Unit {
  if Array::length(hce_pending) > mark {
    let entries = Array::slice(hce_pending, start = mark, end = Array::length(hce_pending))
    Array::truncate(hce_pending, length = mark)
    Array::push(hce_final, value = final_s)
    let found: Array[String] = array_empty()
    for entry in entries {
      let (body, arms, body_ty, env, defs, s, sites_from) = entry
      hce_refuse(body = body, arms = arms, body_ty = body_ty, env = env, defs0 = defs, s = s, sites_from = sites_from, errors = found)
    }
    Array::truncate(hce_final, length = Array::length(hce_final) - 1)
    for msg in found {
      if !hce_has(items = errors, label = msg) {
        Array::push(errors, value = msg)
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

/// `ty`, read also under the module's final substitution while deferred
/// handles are asked again.
fn hce_late(_ ty: Type) -> Type {
  if Array::length(hce_final) > 0 {
    subst_apply(s = Array::get(hce_final, at = Array::length(hce_final) - 1), ty = ty)
  } else {
    ty
  }
}

/// A declaration's body (`hce_decl_makes_bound`) calls through `spelling`
/// at `off`, and the checker recorded no callee type there. Before the
/// module is checked that may be only because the body is not checked yet,
/// so no answer read through it is final.
fn hce_note_unsure(off: Int, spelling: String) -> Unit {
  if Array::length(hce_decl_stack) > 0 && Array::length(hce_final) == 0 && hce_recorded_type(off = off, spelling = spelling) is None {
    Array::push(hce_unsure, value = 1)
  } else {
    ()
  }
}

fn hce_refuse(body: Expr, arms: Array[(Pat, Expr)], body_ty: Type, env: TypeEnv, defs0: Array[TypeDef], s: Subst, sites_from: Int, errors: Array[String]) -> Unit {
  // #1451: a closure literal also takes the rows the enclosing declaration's
  // result type declares for the function values it returns, and the caller
  // of such a value passes its own handler (`fn mid() -> (() -> Int with
  // Box[Int]) { handle { () -> mk() } with { .. } }` answers through the
  // handler around the call). An effect carried that way is not bound here
  // -- but only when the result IS that function type. A closure is not
  // told which position of a composite result it fills: a row-less slot
  // beside a `with Ask` one (`-> (() -> Int with Ask, () -> Int)`) took a
  // closure that kept this handle's evidence (`6`, from the dead handler),
  // and with both slots declaring the row the lowering gave the row to
  // neither (`null function or function signature mismatch`).
  let returned_rows = match env_lookup(env = env, name = "__return__") {
    Some(rt) => hce_result_fn_row(subst_apply(s = s, ty = rt)),
    None => array_empty()
  }
  let labels = hce_without(labels = hce_handled_bases(arms), row = returned_rows)
  if Array::length(labels) > 0 {
    let defs = hce_defs_with_env(defs = defs0, env = env)
    let body_names: Array[String] = array_empty()
    hce_collect_let_names(e = body, out = body_names)
    let assigned: Array[(Int, String)] = array_empty()
    let links: Array[(Int, Int, Bool)] = array_empty()
    let st = hce_walk_body(body = body, labels = labels, find_routes = false, sites_from = sites_from, body_names = body_names, assigned = assigned, links = links, env = env, defs = defs, s = s)
    let mut reach = 0
    let mut pick = 0 - 1
    let mut pi = 0
    while pi < Array::length(st.producers) {
      let (_, _, _, preach) = Array::get(st.producers, at = pi)
      if preach > reach {
        reach = preach
        pick = pi
      } else {
        ()
      }
      pi = pi + 1
    }
    if reach > 0 {
      let (what, off, label, _) = Array::get(st.producers, at = pick)
      // A route the body spells is named first: a body ending in `return h`
      // has an open type of its own, which the value route would also read.
      let routes = hce_walk_body(body = body, labels = labels, find_routes = true, sites_from = sites_from, body_names = body_names, assigned = assigned, links = links, env = env, defs = defs, s = s)
      let mut route = ""
      let mut roff = 0 - 1
      for r in routes.routes {
        let (rwhat, rat, rneed) = r
        if route == "" && rneed <= reach {
          route = rwhat
          roff = rat
        } else {
          ()
        }
      }
      if route != "" {
        Array::push(errors, value = hce_message(what = what, set = label, route = route, off = if roff >= 0 {
          roff
        } else {
          off
        }))
      } else if reach >= 2 && hce_holds_fn(ty = subst_apply(s = s, ty = body_ty), defs = defs, seen = array_empty()) {
        Array::push(errors, value = hce_message(what = what, set = label, route = "returning it as the handle's value", off = off))
      } else if Array::length(routes.keeps) > 0 {
        let (kwhat, kat, klabel) = Array::get(routes.keeps, at = 0)
        Array::push(errors, value = hce_message(what = what, set = klabel, route = kwhat, off = if kat >= 0 {
          kat
        } else {
          off
        }))
      } else {
        ()
      }
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #4051: walk the handled `body` until the values assigned to its mutable
/// bindings stop growing. An assignment can come after a use it reaches --
/// in a loop, or in a closure called later -- so each walk binds those
/// bindings with every handle-bound value the walks before found assigned
/// to them; `assigned` only grows, so the walks end.
fn hce_walk_body(body: Expr, labels: Array[String], find_routes: Bool, sites_from: Int, body_names: Array[String], assigned: Array[(Int, String)], links: Array[(Int, Int, Bool)], env: TypeEnv, defs: Array[TypeDef], s: Subst) -> HceWalk {
  let mut st = hce_new(labels = labels, find_routes = find_routes, sites_from = sites_from, body_names = body_names, assigned = assigned, links = links)
  hce_walk(e = body, st = st, env = env, defs = defs, s = s)
  while st.grew {
    st = hce_new(labels = labels, find_routes = find_routes, sites_from = sites_from, body_names = body_names, assigned = assigned, links = links)
    hce_walk(e = body, st = st, env = env, defs = defs, s = s)
  }
  st
}

fn hce_new(labels: Array[String], find_routes: Bool, sites_from: Int, body_names: Array[String], assigned: Array[(Int, String)], links: Array[(Int, Int, Bool)]) -> HceWalk {
  HceWalk::{
    labels: labels,
    scope: array_empty(),
    performs: array_empty(),
    producers: array_empty(),
    pos: 2,
    mentions: 0,
    mention_label: "",
    find_routes: find_routes,
    fn_depth: 0,
    routes: array_empty(),
    keeps: array_empty(),
    sites_from: sites_from,
    body_names: body_names,
    loops: array_empty(),
    assigned: assigned,
    links: links,
    next_decl: 0,
    grew: false,
    arg_marks: array_empty()
  }
}

fn hce_message(what: String, set: String, route: String, off: Int) -> String {
  let named: Array[String] = array_empty()
  let mut throws = false
  for l in hce_set_items(set) {
    if is_exception_effect_name(l) {
      throws = true
    } else {
      Array::push(named, value = String::concat("`", String::concat(l, "`")))
    }
  }
  let performs = String::concat("performs ", String::join(named, sep = " and "))
  let verb = if throws && Array::length(named) == 0 {
    "throws, and this `handle` catches it"
  } else if throws {
    String::concat("throws and ", String::concat(performs, ", and this `handle` catches and answers them"))
  } else if Array::length(named) > 1 {
    String::concat(performs, ", and this `handle` answers them")
  } else {
    String::concat(performs, ", and this `handle` answers it")
  }
  // #3599: for a callee with no body to read, `what` is `any closure in
  // what <callee> returns`, and the reason says the throw is assumed.
  let reason = if String::starts_with(what, prefix = hce_unread_prefix()) && throws && Array::length(named) == 0 {
    let callee = what[String::length(hce_unread_prefix()): String::length(what) - String::length(" returns")]
    String::concat(callee, " has no body this check can read, so a closure in what it returns may throw, and this `handle` catches it")
  } else {
    String::concat(what, String::concat(" ", verb))
  }
  let edit = String::concat("call ", String::concat(what, String::concat(" inside this `handle` and keep only what it computes, or move the `handle` into the closure (`() -> handle { .. } with { .. }`) -- ", reason)))
  let why = String::concat(" only while the handled body runs, so ", String::concat(route, " leaves it with no handler to call"))
  String::concat(edit, String::concat(why, off_marker(off)))
}

/// How a value produced by a callee with no body to read is named.
fn hce_unread_prefix() -> String {
  "any closure in what "
}

/// The row labels of `ty` when it is a function type; none otherwise.
fn hce_result_fn_row(_ ty: Type) -> Array[String] {
  let labels: Array[String] = array_empty()
  match ty {
    CtForAll(_, _, inner) => hce_result_fn_row(inner),
    CtFn(_, _, Some(r)) => {
      for raw in String::split(r, sep = ",") {
        let l = String::trim(raw)
        if String::length(l) > 0 && !String::starts_with(l, prefix = "#") {
          Array::push(labels, value = l)
        } else {
          ()
        }
      }
      labels
    },
    _ => labels
  }
}

/// The base of every effect an arm of the handle discharges.
fn hce_handled_bases(_ arms: Array[(Pat, Expr)]) -> Array[String] {
  let out = array_empty()
  for arm in arms {
    let (pat, _) = arm
    match pat {
      PCtor(name, _) => if String::index_of(name, needle = "::") > 0 {
        hce_add(out = out, label = row_label_base(effect_name_of_op(name)))
      } else {
        ()
      },
      _ => ()
    }
  }
  out
}

/// #3585: the effect bases a handle-bound value performs that the handle
/// answers, written as one set (`Ask,Log`; "" for none). A destination's row
/// discharges only the bases it names, and the value stays handle-bound
/// while any is left.
fn hce_set_items(_ set: String) -> Array[String] {
  let out = array_empty()
  if String::length(set) > 0 {
    for l in String::split(set, sep = ",") {
      if String::length(l) > 0 {
        hce_add(out = out, label = l)
      } else {
        ()
      }
    }
  } else {
    ()
  }
  out
}

fn hce_set_union(a: String, b: String) -> String {
  if a == "" {
    b
  } else if b == "" {
    a
  } else {
    let items = hce_set_items(a)
    for l in hce_set_items(b) {
      hce_add(out = items, label = l)
    }
    String::join(items, sep = ",")
  }
}

/// `set` without the bases the parameter type `pt` takes (see
/// `hce_param_takes_row`).
fn hce_set_untaken(set: String, pt: Type) -> String {
  let left = array_empty()
  for l in hce_set_items(set) {
    if !hce_param_takes_row(pt = pt, label = l) {
      Array::push(left, value = l)
    } else {
      ()
    }
  }
  String::join(left, sep = ",")
}

/// `labels` without the bases of `row` (a row label may be an operation,
/// `Ask::Get`, or a kinded exception, `Exception[String]`).
fn hce_without(labels: Array[String], row: Array[String]) -> Array[String] {
  let drop = array_empty()
  for l in row {
    if !label_is_effect_var(l) {
      hce_add(out = drop, label = row_label_base(effect_name_of_op(l)))
    } else {
      ()
    }
  }
  if Array::length(drop) == 0 {
    labels
  } else {
    let out = array_empty()
    for l in labels {
      if !hce_has(items = drop, label = l) {
        Array::push(out, value = l)
      } else {
        ()
      }
    }
    out
  }
}

fn hce_fn_result(_ ty: Type) -> Option[Type] {
  match ty {
    CtForAll(_, _, inner) => hce_fn_result(inner),
    CtFn(_, ret, _) => Some(ret),
    _ => None
  }
}

/// The innermost binding of `name` in the handled body: 0 when the body does
/// not bind it, 1 when it binds it to a plain value, 2 to a handle-bound one.
fn hce_lookup(st: HceWalk, name: String) -> Int {
  let i = hce_scope_index(st = st, name = name)
  if i < 0 {
    0
  } else {
    let (_, label, _, _) = Array::get(st.scope, at = i)
    if label == "" {
      1
    } else {
      2
    }
  }
}

fn hce_scope_index(st: HceWalk, name: String) -> Int {
  let mut i = Array::length(st.scope) - 1
  let mut found = 0 - 1
  while i >= 0 && found < 0 {
    let (n, _, _, _) = Array::get(st.scope, at = i)
    if n == name {
      found = i
    } else {
      ()
    }
    i = i - 1
  }
  found
}

/// The effect base a handle-bound local holds.
fn hce_local_label(st: HceWalk, name: String) -> String {
  let i = hce_scope_index(st = st, name = name)
  if i < 0 {
    ""
  } else {
    let (_, label, _, _) = Array::get(st.scope, at = i)
    label
  }
}

fn hce_bind(st: HceWalk, name: String, label: String) -> Unit {
  hce_declare(st = st, name = hce_param_base(name), label = label, decls = "")
}

/// #4051: bind `name`, holding `label`, as a declaration later walks find
/// again (see `HceWalk.assigned`): it holds whatever the walks before found
/// assigned to it as well.
fn hce_declare(st: HceWalk, name: String, label: String, decls: String) -> Unit {
  let id = st.next_decl
  st.next_decl = id + 1
  Array::push(st.scope, value = (name, hce_set_union(a = label, b = hce_assigned(st = st, id = id)), decls, id))
}

/// #3596: the declarations the binding of `name` stands for, comma-joined
/// (see `hce_alias_decls`): read from the handled body's binding when it
/// binds `name`, else from the binding `env` holds.
fn hce_name_decls(st: HceWalk, name: String, env: TypeEnv) -> String {
  let i = hce_scope_index(st = st, name = name)
  if i < 0 {
    hce_outer_decls(env = env, name = name)
  } else {
    let (_, _, decls, _) = Array::get(st.scope, at = i)
    decls
  }
}

/// #3596: the declarations a `let` initializer `val` stands for when it
/// names a function -- a plain alias (`let g = mk`, `let h = g`), or each
/// branch of a conditional one (`let g = if c { mk } else { mk_ok }`) --
/// comma-joined, "" when it names none. Read the way the marker of a `let`
/// before the handle is (`retention_alias_names`, which sees through an
/// annotation, parentheses and a block's tail); a branch that names no
/// function beside one that does adds `hce_unknown_decl`.
fn hce_alias_decls(val: Expr, st: HceWalk, env: TypeEnv) -> String {
  let mut out = ""
  for n in retention_alias_names(val) {
    out = hce_set_union(a = out, b = if n == hce_unknown_decl() {
      n
    } else {
      hce_name_decls(st = st, name = n, env = env)
    })
  }
  out
}

/// The declaration an alias stands for when one of the places its value
/// can come from names no function (`if c { mk } else { pick() }`): it may
/// be any, so it is taken to create a closure that can leave it.
fn hce_unknown_decl() -> String {
  "?"
}

/// #3596: the declarations the binding of `name` visible in `env` stands
/// for, comma-joined: `name` itself when it is bound at module level; what a
/// local alias names -- through an alias of an alias, and each branch of a
/// conditional one, each read where that alias was written (the marker
/// `retention_bind_let` lays in front of it), so a later binding of the
/// spelling hides it -- and none for any other local binding (a parameter,
/// a closure literal, a call's result).
///
/// The chain is followed to its end, however long: each hop reads the
/// environment below the alias's own binding (`retention_closure_scope`), a
/// strict suffix of the one before, so it cannot cycle. A depth cap here
/// answered "names none" for a finite chain one alias past it, and the call
/// through the last alias went unrefused.
fn hce_outer_decls(env: TypeEnv, name: String) -> String {
  match env_marker_before(env = env, marker = retention_marker(name), name = name) {
    Some(CtNamed(text, _)) => if String::starts_with(text, prefix = "a:") || String::starts_with(text, prefix = "o:") {
      match retention_closure_scope(env = env, bound_name = name, text = text) {
        Some(def_env) => {
          let mut out = ""
          for src in String::split(String::substring(text, start = 2, end = String::length(text)), sep = ",") {
            out = hce_set_union(a = out, b = if src == hce_unknown_decl() {
              src
            } else {
              hce_outer_decls(env = def_env, name = src)
            })
          }
          out
        },
        None => ""
      }
    } else {
      ""
    },
    Some(_) => "",
    None => if retention_name_scope(env = env, name = name) == 1 {
      ""
    } else {
      name
    }
  }
}

/// A parameter is written `x`, or `x?` when optional.
fn hce_param_base(_ name: String) -> String {
  let n = String::length(name)
  if n > 0 {
    let last = String::byte_at(name, at = n - 1)
    if last == '?' {
      name[0: n - 1]
    } else {
      name
    }
  } else {
    name
  }
}

/// Bind every name `pat` binds to a value holding the handle-bound effect
/// bases `label` ("" for a plain value).
fn hce_bind_pat(st: HceWalk, pat: Pat, label: String) -> Unit {
  let names = array_empty()
  collect_pat_binds_into(pat = pat, acc = names)
  for n in names {
    hce_bind(st = st, name = n, label = label)
  }
  ()
}

/// #4051: bind the names `pat` binds when it takes apart `src`, which holds
/// the effect bases `held`. Where `src` is written in the pattern's own
/// shape -- a tuple, a constructor's call, a struct literal -- each part of
/// the pattern holds what the matching part holds, so the `n` of `match (g,
/// 1) { (_, n) => .. }` is a plain value; any other binder holds `held`.
/// `known` is what each of `src`'s parts holds and whether it created a
/// handle-bound value, as `hce_match_parts` read it for a scrutinee; empty,
/// a part holds what it names (`hce_names_held`) and created none.
fn hce_bind_pat_from(st: HceWalk, pat: Pat, src: Expr, held: String, known: Array[(String, Bool)], env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let src = hce_unwrap_value(src)
  let parts: Array[Expr] = array_empty()
  let at: Array[Int] = array_empty()
  let subs: Array[Pat] = array_empty()
  let shaped = match (pat, src) {
    (PTuple(ps), ETuple(es)) => if Array::length(ps) == Array::length(es) {
      for p in ps {
        Array::push(subs, value = p)
      }
      for e in es {
        Array::push(at, value = Array::length(parts))
        Array::push(parts, value = e)
      }
      true
    } else {
      false
    },
    (PCtor(pc, ps), ECall(EIdent(ec, _), es, _, _)) => if !hce_is_paren(src) && hce_same_ctor(a = pc, b = ec) && Array::length(ps) == Array::length(es) {
      for p in ps {
        Array::push(subs, value = p)
      }
      for e in es {
        Array::push(at, value = Array::length(parts))
        Array::push(parts, value = call_arg_value(e))
      }
      true
    } else {
      false
    },
    (PStruct(_, pfields), ERecord(_, efields, _)) => {
      let mut all = true
      for pf in pfields {
        let (fname, fp) = pf
        let mut hit: Option[(Int, Expr)] = None
        let mut ei = 0
        for ef in efields {
          let (ename, ev) = ef
          if ename == fname && hit is None {
            hit = Some((ei, ev))
          } else {
            ()
          }
          ei = ei + 1
        }
        match hit {
          Some((k, ev)) => {
            Array::push(subs, value = fp)
            Array::push(at, value = k)
            Array::push(parts, value = ev)
          },
          None => all = false
        }
      }
      all
    },
    _ => false
  }
  if shaped {
    let mut i = 0
    while i < Array::length(subs) {
      let part = Array::get(parts, at = i)
      let k = Array::get(at, at = i)
      let (part_held, part_fresh) = if k < Array::length(known) {
        Array::get(known, at = k)
      } else {
        (hce_names_held(e = part, st = st, env = env, defs = defs, s = s), false)
      }
      if part_held == "" || part_fresh {
        hce_bind_pat(st = st, pat = Array::get(subs, at = i), label = part_held)
      } else {
        hce_bind_pat_from(st = st, pat = Array::get(subs, at = i), src = part, held = part_held, known = array_empty(), env = env, defs = defs, s = s)
      }
      i = i + 1
    }
  } else {
    hce_bind_pat(st = st, pat = pat, label = held)
  }
}

/// Walk a `match` scrutinee `e` and answer what it holds (`hce_walk_source`).
/// When it is written as a tuple, a call or a struct literal, also push to
/// `parts`, for each element, argument or field in order, what it holds --
/// the locals it names and the handle-bound values it created -- and whether
/// it created any: a closure performing the handled effect beside a plain
/// one, `(() -> perform Ask::Get(), () -> 7)`, leaves the plain one plain
/// (Codex on #4066).
fn hce_match_parts(e: Expr, parts: Array[(String, Bool)], st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  let src = hce_unwrap_value(e)
  let pieces: Array[Expr] = array_empty()
  let walked = match src {
    ETuple(es) => {
      for x in es {
        Array::push(pieces, value = x)
      }
      false
    },
    ERecord(_, fields, _) => {
      for fv in fields {
        let (_, x) = fv
        Array::push(pieces, value = x)
      }
      false
    },
    ECall(EIdent(_, _), es, _, _) => if hce_is_paren(src) {
      false
    } else {
      for x in es {
        Array::push(pieces, value = call_arg_value(x))
      }
      true
    },
    _ => false
  }
  if Array::length(pieces) == 0 {
    hce_walk_source(e = e, st = st, env = env, defs = defs, s = s)
  } else {
    let marks: Array[Int] = array_empty()
    let mut held = ""
    if walked {
      // A call is walked whole, so its own work is done; it leaves where
      // each argument's producers begin. Marks from before this walk are
      // not this call's, so they are cleared first and must not predate it.
      let start = Array::length(st.producers)
      st.arg_marks = array_empty()
      held = hce_walk_source(e = e, st = st, env = env, defs = defs, s = s)
      for m in st.arg_marks {
        if m >= start {
          Array::push(marks, value = m)
        } else {
          ()
        }
      }
    } else {
      // A tuple or struct literal is only its parts, walked in order, each
      // where `hce_walk` would walk it (a child's position).
      for x in pieces {
        Array::push(marks, value = Array::length(st.producers))
        st.pos = 2
        held = hce_set_union(a = held, b = hce_walk_source(e = x, st = st, env = env, defs = defs, s = s))
      }
      Array::push(marks, value = Array::length(st.producers))
    }
    if Array::length(marks) == Array::length(pieces) + 1 {
      let mut k = 0
      for x in pieces {
        let from = Array::get(marks, at = k)
        let upto = Array::get(marks, at = k + 1)
        let mut part = hce_names_held(e = x, st = st, env = env, defs = defs, s = s)
        let mut pi = from
        while pi < upto && pi < Array::length(st.producers) {
          let (_, _, plabel, _) = Array::get(st.producers, at = pi)
          part = hce_set_union(a = part, b = plabel)
          pi = pi + 1
        }
        Array::push(parts, value = (part, upto > from))
        k = k + 1
      }
    } else {
      ()
    }
    held
  }
}

/// `e` without the parentheses or label it is written with.
fn hce_unwrap_value(_ e: Expr) -> Expr {
  match e {
    ELabeledArg(_, _, inner) => hce_unwrap_value(inner),
    ECall(_, wargs, _, _) => if hce_is_paren(e) {
      hce_unwrap_value(Array::get(wargs, at = 0))
    } else {
      e
    },
    _ => e
  }
}

/// Do a pattern's constructor `a` and a call's callee `b` name the same
/// constructor, one possibly qualified (`Wrap::W`, `W`)?
fn hce_same_ctor(a: String, b: String) -> Bool {
  a == b || String::ends_with(a, suffix = String::concat("::", b)) || String::ends_with(b, suffix = String::concat("::", a))
}

/// The effect bases of the handle-bound locals `e` hands on as a value
/// (read as `hce_arg_bound_label` reads a call's argument).
fn hce_names_held(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  let mut found = ""
  let mut si = 0
  while si < Array::length(st.scope) {
    let (n, label, _, _) = Array::get(st.scope, at = si)
    if label != "" && hce_lookup(st = st, name = n) == 2 && hce_name_reach(name = n, e = e, st = st, env = env, defs = defs, s = s) > 0 {
      found = hce_set_union(a = found, b = label)
    } else {
      ()
    }
    si = si + 1
  }
  found
}

fn hce_count_perform(st: HceWalk, label: String, off: Int) -> Unit {
  Array::push(st.performs, value = (off, label))
}

/// Walk `e` in the handled body.
fn hce_walk(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let pos = st.pos
  st.pos = 2
  let performed = dh_perform_effect(e)
  if String::length(performed) > 0 {
    let label = canonical_exception_effect_name(row_label_base(performed))
    if hce_has(items = st.labels, label = label) {
      hce_count_perform(st = st, label = label, off = railway_expr_off(e))
    } else {
      ()
    }
  } else {
    ()
  }
  match e {
    EIdent(name, _) => if hce_lookup(st = st, name = name) == 2 {
      st.mentions = st.mentions + 1
      st.mention_label = hce_set_union(a = st.mention_label, b = hce_local_label(st = st, name = name))
    } else {
      ()
    },
    EFn(_, _, params, _, eff, fbody) => {
      let saved = st.labels
      st.labels = hce_without(labels = saved, row = effect_row_labels(effect_row_parse(eff)))
      let before = Array::length(st.performs)
      let mark = Array::length(st.scope)
      for p in params {
        let (pname, _) = p
        hce_bind(st = st, name = pname, label = "")
      }
      st.fn_depth = st.fn_depth + 1
      hce_walk(e = fbody, st = st, env = env, defs = defs, s = s)
      st.fn_depth = st.fn_depth - 1
      Array::truncate(st.scope, length = mark)
      st.labels = saved
      if Array::length(st.performs) > before {
        // Every effect the closure performs, not only the first (#3585).
        let (poff, _) = Array::get(st.performs, at = before)
        let mut set = ""
        let mut qi = before
        while qi < Array::length(st.performs) {
          let (_, qlabel) = Array::get(st.performs, at = qi)
          set = hce_set_union(a = set, b = qlabel)
          qi = qi + 1
        }
        Array::push(st.producers, value = ("the closure", poff, set, pos))
      } else {
        ()
      }
    },
    ELet(name, val, rest, off) => hce_walk_let(name = name, val = val, rest = rest, off = off, st = st, env = env, defs = defs, s = s, recursive = false, mutable = false),
    ELetMut(name, val, rest, off) => hce_walk_let(name = name, val = val, rest = rest, off = off, st = st, env = env, defs = defs, s = s, recursive = false, mutable = true),
    ELetRec(name, val, rest) => hce_walk_let(name = name, val = val, rest = rest, off = 0 - 1, st = st, env = env, defs = defs, s = s, recursive = true, mutable = false),
    // #4051: a binding of the body assigned a handle-bound value holds it
    // from then on (`let mut x = plain; x = g; keep(f = x)`).
    EAssign(name, val, rest, off) => {
      hce_assign(st = st, name = name, held = hce_walk_source(e = val, st = st, env = env, defs = defs, s = s))
      hce_link_name(st = st, name = name, e = val, env = env)
      hce_note_outer_write(st = st, name = name, off = off, env = env, defs = defs, s = s)
      hce_walk(e = rest, st = st, env = env, defs = defs, s = s)
    },
    EAssignOp(name, _, val, rest, off) => {
      hce_assign(st = st, name = name, held = hce_walk_source(e = val, st = st, env = env, defs = defs, s = s))
      hce_link_name(st = st, name = name, e = val, env = env)
      hce_note_outer_write(st = st, name = name, off = off, env = env, defs = defs, s = s)
      hce_walk(e = rest, st = st, env = env, defs = defs, s = s)
    },
    EHandle(hbody, harms) => {
      let saved = st.labels
      let inner = hce_handled_bases(harms)
      st.labels = hce_without(labels = saved, row = inner)
      hce_walk(e = hbody, st = st, env = env, defs = defs, s = s)
      st.labels = saved
      for arm in harms {
        let (pat, abody) = arm
        let mark = Array::length(st.scope)
        hce_bind_pat(st = st, pat = pat, label = "")
        hce_bind(st = st, name = "resume", label = "")
        hce_walk(e = abody, st = st, env = env, defs = defs, s = s)
        Array::truncate(st.scope, length = mark)
      }
      ()
    },
    // #4051: a binder holds what the value it takes apart holds -- an arm's
    // pattern (an `is` test, a destructuring `let`) whatever the scrutinee
    // holds, a `for` variable whatever its iterable holds, a `loop`
    // parameter whatever its initial value or a `continue` holds -- as
    // `let x = g` does, so a call handed the binder sees the handle-bound
    // value. Bound plain, `for x in [g] { keep(f = x) }` checked clean and
    // the kept closure trapped once the handle was gone.
    EMatch(scrutinee, marms) => {
      let producers_before = Array::length(st.producers)
      let parts: Array[(String, Bool)] = array_empty()
      let held = hce_match_parts(e = scrutinee, parts = parts, st = st, env = env, defs = defs, s = s)
      let fresh = Array::length(st.producers) > producers_before
      let srcs = hce_source_ids(st = st, e = scrutinee, env = env, element = true)
      for arm in marms {
        let (pat, abody) = arm
        let mark = Array::length(st.scope)
        if held == "" || fresh && Array::length(parts) == 0 {
          hce_bind_pat(st = st, pat = pat, label = held)
        } else {
          hce_bind_pat_from(st = st, pat = pat, src = scrutinee, held = held, known = parts, env = env, defs = defs, s = s)
        }
        hce_link_from(st = st, from = mark, srcs = srcs)
        hce_walk(e = abody, st = st, env = env, defs = defs, s = s)
        Array::truncate(st.scope, length = mark)
      }
      ()
    },
    EForIn(name, index_name, iter, fbody) => {
      let held = hce_walk_source(e = iter, st = st, env = env, defs = defs, s = s)
      let mark = Array::length(st.scope)
      hce_bind(st = st, name = name, label = held)
      hce_link_from(st = st, from = mark, srcs = hce_source_ids(st = st, e = iter, env = env, element = true))
      match index_name {
        Some(n) => hce_bind(st = st, name = n, label = ""),
        None => ()
      }
      hce_walk(e = fbody, st = st, env = env, defs = defs, s = s)
      Array::truncate(st.scope, length = mark)
    },
    ELoop(lparams, lbody) => {
      let held: Array[String] = array_empty()
      for p in lparams {
        let (_, init) = p
        Array::push(held, value = hce_walk_source(e = init, st = st, env = env, defs = defs, s = s))
      }
      let mark = Array::length(st.scope)
      let depth = Array::length(st.loops)
      let names: Array[String] = array_empty()
      let mut pi = 0
      for p in lparams {
        let (pname, init) = p
        let srcs = hce_source_ids(st = st, e = init, env = env)
        let elements = hce_source_ids(st = st, e = init, env = env, element = true)
        hce_declare(st = st, name = pname, label = Array::get(held, at = pi), decls = "")
        hce_link_from(st = st, from = Array::length(st.scope) - 1, srcs = srcs)
        hce_link_from(st = st, from = Array::length(st.scope) - 1, srcs = elements, projected = true)
        Array::push(names, value = pname)
        pi = pi + 1
      }
      Array::push(st.loops, value = names)
      hce_walk(e = lbody, st = st, env = env, defs = defs, s = s)
      Array::truncate(st.loops, length = depth)
      Array::truncate(st.scope, length = mark)
    },
    // A `continue` assigns the innermost `loop`'s parameters.
    EContinue(cargs) => {
      let depth = Array::length(st.loops)
      let mut ci = 0
      for a in cargs {
        let held = hce_walk_source(e = call_arg_value(a), st = st, env = env, defs = defs, s = s)
        if depth > 0 && ci < Array::length(Array::get(st.loops, at = depth - 1)) {
          hce_assign(st = st, name = Array::get(Array::get(st.loops, at = depth - 1), at = ci), held = held)
          hce_link_name(st = st, name = Array::get(Array::get(st.loops, at = depth - 1), at = ci), e = call_arg_value(a), env = env)
        } else {
          ()
        }
        ci = ci + 1
      }
      ()
    },
    ECall(callee, args, off, _) => if hce_is_paren(e) {
      // `$source_span` wraps a parenthesized expression; it is that
      // expression, in the same position.
      let mut wi = 0
      while wi < Array::length(args) {
        st.pos = if wi == 0 {
          pos
        } else {
          2
        }
        hce_walk(e = Array::get(args, at = wi), st = st, env = env, defs = defs, s = s)
        wi = wi + 1
      }
    } else {
      hce_note_call(callee = callee, args = args, off = off, pos = pos, st = st, env = env, defs = defs, s = s)
      // A callee is applied where it is written: a closure literal there
      // (`(() -> perform E::Op())()`) never leaves.
      st.pos = 0
      hce_walk(e = callee, st = st, env = env, defs = defs, s = s)
      let arg_reach = hce_arg_reach(callee = callee, st = st, env = env, defs = defs, s = s)
      let marks: Array[Int] = array_empty()
      let arg_held: Array[String] = array_empty()
      let mut ai = 0
      for arg in args {
        let producers_before = Array::length(st.producers)
        Array::push(marks, value = producers_before)
        st.pos = hce_beside_local(reach = arg_reach, args = args, ai = ai, st = st, env = env)
        hce_walk(e = arg, st = st, env = env, defs = defs, s = s)
        // A closure passed to a parameter that carries its row gets that
        // handler from its eventual caller. Filter literals and local names
        // before propagating the remaining handle-bound labels into storage.
        let pt = hce_param_type(callee = callee, off = off, arg = arg, ai = ai, nargs = Array::length(args), st = st, env = env, s = s)
        match pt {
          Some(t) => if Array::length(st.producers) > producers_before {
            hce_drop_row_taken(st = st, from = producers_before, pt = t)
          } else {
            ()
          },
          None => ()
        }
        let arg_label = hce_arg_bound_label(arg = arg, producers_before = producers_before, st = st, env = env, defs = defs, s = s)
        Array::push(arg_held, value = match pt {
          Some(t) => hce_set_untaken(set = arg_label, pt = t),
          None => arg_label
        })
        // #3594: reading a declaration for a row variable, a call handed a
        // parameter that performs it (`() -> apply(g)`) may call it.
        if hce_poly_walk(st) && !hce_callee_is_ctor(callee = callee, defs = defs) {
          let handed = arg_label
          if handed != "" {
            hce_count_perform(st = st, label = handed, off = railway_expr_off(arg))
          } else {
            ()
          }
        } else {
          ()
        }
        if st.find_routes {
          let label = arg_label
          if label != "" && hce_callee_may_keep(callee = callee, off = off, arg = arg, ai = ai, nargs = Array::length(args), label = label, st = st, env = env, defs = defs, s = s) {
            let left = match pt {
              Some(pt) => hce_set_untaken(set = label, pt = pt),
              None => label
            }
            Array::push(st.keeps, value = (hce_keep_route(callee), railway_expr_off(arg), if left == "" {
              label
            } else {
              left
            }))
          } else {
            ()
          }
        } else {
          ()
        }
        ai = ai + 1
      }
      Array::push(marks, value = Array::length(st.producers))
      // #4064: what an argument holds may be stored into another one rooted
      // at a binding of the body (`Array::push(arr, value = g)`); that
      // binding holds it from here on, so `keep_arr(xs = arr)` and `for x in
      // arr { keep(f = x) }` are keep routes as `keep(f = g)` is.
      hce_note_stores(callee = callee, args = args, held = arg_held, st = st, env = env, defs = defs)
      st.arg_marks = marks
      ()
    },
    ELabeledArg(_, _, inner) => {
      st.pos = pos
      hce_walk(e = inner, st = st, env = env, defs = defs, s = s)
    },
    EReturn(value) => {
      if st.find_routes && st.fn_depth == 0 {
        let holds = match env_lookup(env = env, name = "__return__") {
          Some(rt) => hce_holds_fn(ty = subst_apply(s = s, ty = rt), defs = defs, seen = array_empty()),
          None => true
        }
        if holds {
          Array::push(st.routes, value = ("`return`ing it from inside the handle", railway_expr_off(value), 2))
        } else {
          ()
        }
      } else {
        ()
      }
      hce_walk(e = value, st = st, env = env, defs = defs, s = s)
    },
    _ => hce_walk_children(e = e, st = st, env = env, defs = defs, s = s)
  }
}

fn hce_walk_children(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    hce_walk(e = expr_child_at(i), st = st, env = env, defs = defs, s = s)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// A `let` binds its name to a handle-bound value when its initializer
/// produced one or names one. A value the initializer itself is (a closure
/// literal, a call's result) goes where the name's uses take it.
fn hce_walk_let(name: String, val: Expr, rest: Expr, off: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst, recursive: Bool, mutable: Bool) -> Unit {
  let mark = Array::length(st.scope)
  if recursive {
    hce_bind(st = st, name = name, label = "")
  } else {
    ()
  }
  let producers_before = Array::length(st.producers)
  let mentions_before = st.mentions
  let mentioned_before = st.mention_label
  st.mention_label = ""
  st.pos = hce_let_reach()
  hce_walk(e = val, st = st, env = env, defs = defs, s = s)
  let bound = if Array::length(st.producers) > producers_before {
    let mut set = ""
    let mut bi = producers_before
    while bi < Array::length(st.producers) {
      let (_, _, blabel, _) = Array::get(st.producers, at = bi)
      set = hce_set_union(a = set, b = blabel)
      bi = bi + 1
    }
    set
  } else if st.mentions > mentions_before {
    st.mention_label
  } else {
    ""
  }
  st.mention_label = hce_set_union(a = mentioned_before, b = st.mention_label)
  let mut pi = producers_before
  let mut uses = 0 - 1
  while pi < Array::length(st.producers) {
    let (pwhat, poff, plabel, preach) = Array::get(st.producers, at = pi)
    if preach == hce_let_reach() {
      if uses < 0 {
        uses = hce_name_reach(name = name, e = rest, st = st, env = env, defs = defs, s = s)
        if recursive {
          let in_val = hce_name_reach(name = name, e = val, st = st, env = env, defs = defs, s = s)
          if in_val > uses {
            uses = in_val
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      // Name the closure the program named.
      let (what, at) = match val {
        EFn(_, _, _, _, _, _) => (String::concat("`", String::concat(name, "`")), if off >= 0 {
          off
        } else {
          poff
        }),
        _ => (pwhat, poff)
      }
      Array::set(st.producers, at = pi, value = (what, at, plabel, uses))
    } else {
      ()
    }
    pi = pi + 1
  }
  Array::truncate(st.scope, length = mark)
  let decls = if bound == "" && !recursive {
    hce_alias_decls(val = val, st = st, env = env)
  } else {
    ""
  }
  let srcs = hce_source_ids(st = st, e = val, env = env)
  let elements = hce_source_ids(st = st, e = val, env = env, element = true)
  hce_declare(st = st, name = name, label = bound, decls = decls)
  hce_link_from(st = st, from = Array::length(st.scope) - 1, srcs = srcs)
  hce_link_from(st = st, from = Array::length(st.scope) - 1, srcs = elements, projected = true)
  hce_walk(e = rest, st = st, env = env, defs = defs, s = s)
  Array::truncate(st.scope, length = mark)
}

/// #4051: walk `e`, a value a binder takes apart (a `match` scrutinee, a
/// `for` iterable, a `loop` parameter's value), and answer the effect bases
/// of the handle-bound values it creates or names -- both, read as a `let`
/// initializer's are (`hce_walk_let`), so the binder holds what `let x = e`
/// would.
fn hce_walk_source(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  let producers_before = Array::length(st.producers)
  let mentions_before = st.mentions
  let mentioned_before = st.mention_label
  st.mention_label = ""
  hce_walk(e = e, st = st, env = env, defs = defs, s = s)
  let mut set = if st.mentions > mentions_before {
    st.mention_label
  } else {
    ""
  }
  let mut bi = producers_before
  while bi < Array::length(st.producers) {
    let (_, _, blabel, _) = Array::get(st.producers, at = bi)
    set = hce_set_union(a = set, b = blabel)
    bi = bi + 1
  }
  st.mention_label = hce_set_union(a = mentioned_before, b = st.mention_label)
  set
}

/// #4051: `held` was assigned to the body's binding `name`: it holds it
/// from here on, and every later walk binds that declaration so from the
/// start.
fn hce_assign(st: HceWalk, name: String, held: String) -> Unit {
  let i = hce_scope_index(st = st, name = name)
  if held != "" && i >= 0 {
    let (n, label, decls, id) = Array::get(st.scope, at = i)
    Array::set(st.scope, at = i, value = (n, hce_set_union(a = label, b = held), decls, id))
    hce_note_assigned(st = st, id = id, held = held)
  } else {
    ()
  }
}

/// Record that declaration `id` holds `held` (see `HceWalk.assigned`).
fn hce_note_assigned(st: HceWalk, id: Int, held: String) -> Unit {
  if id >= 0 && held != "" {
    let mut ai = 0
    let mut hit = false
    while ai < Array::length(st.assigned) {
      let (aid, alabel) = Array::get(st.assigned, at = ai)
      if aid == id {
        hit = true
        let wider = hce_set_union(a = alabel, b = held)
        if wider != alabel {
          Array::set(st.assigned, at = ai, value = (aid, wider))
          st.grew = true
        } else {
          ()
        }
      } else {
        ()
      }
      ai = ai + 1
    }
    if !hit {
      Array::push(st.assigned, value = (id, held))
      st.grew = true
    } else {
      ()
    }
  } else {
    ()
  }
}

/// Declarations that can supply storage to this value.
fn hce_source_ids(st: HceWalk, e: Expr, env: TypeEnv, element: Bool = false) -> Array[Int] {
  let names: Array[String] = array_empty()
  hce_storage_sources(e = e, env = env, out = names, element = element)
  let out: Array[Int] = array_empty()
  for name in names {
    let i = hce_scope_index(st = st, name = name)
    if i >= 0 {
      let (_, _, _, id) = Array::get(st.scope, at = i)
      if id >= 0 && !hce_has_int(items = out, n = id) {
        Array::push(out, value = id)
      }
    }
  }
  out
}

fn hce_has_int(items: Array[Int], n: Int) -> Bool {
  let mut found = false
  for x in items {
    if x == n {
      found = true
    } else {
      ()
    }
  }
  found
}

/// #4064: every binding at scope index `from` or later was taken from the
/// declarations `srcs`.
fn hce_link_from(st: HceWalk, from: Int, srcs: Array[Int], projected: Bool = false) -> Unit {
  let mut i = if from < 0 {
    0
  } else {
    from
  }
  while i < Array::length(st.scope) {
    hce_link_one(st = st, i = i, srcs = srcs, projected = projected)
    i = i + 1
  }
}

/// #4064: the binding at scope index `i` was taken from the declarations
/// `srcs` (see `HceWalk.links`).
fn hce_link_one(st: HceWalk, i: Int, srcs: Array[Int], projected: Bool = false) -> Unit {
  let (_, _, _, id) = Array::get(st.scope, at = i)
  for src in srcs {
    if id >= 0 && src >= 0 && src != id {
      let mut hit = false
      for l in st.links {
        let (a, b, p) = l
        if a == id && b == src && p == projected {
          hit = true
        } else {
          ()
        }
      }
      if !hit {
        Array::push(st.links, value = (id, src, projected))
      } else {
        ()
      }
    } else {
      ()
    }
  }
  ()
}

/// #4064: the body's binding `name` was assigned `e` and now shares the
/// storage of the bindings `e` names.
fn hce_link_name(st: HceWalk, name: String, e: Expr, env: TypeEnv) -> Unit {
  let i = hce_scope_index(st = st, name = name)
  if i >= 0 {
    hce_link_one(st = st, i = i, srcs = hce_source_ids(st = st, e = e, env = env))
    hce_link_one(st = st, i = i, srcs = hce_source_ids(st = st, e = e, env = env, element = true), projected = true)
  } else {
    ()
  }
}

/// #4064: a call stored `held` into the body's binding `name` (through
/// `Array::push`, `Array::set`, `xs[i] = ..`, a field, a helper): it holds
/// it from here on, and so does every binding of the body it was taken
/// from, whose storage it may share (`HceWalk.links`).
fn hce_store(st: HceWalk, name: String, held: String, projected: Bool) -> Unit {
  let i = hce_scope_index(st = st, name = name)
  if held != "" && i >= 0 {
    hce_store_at(st = st, i = i, held = held, projected = projected, seen = array_empty())
  } else {
    ()
  }
}

fn hce_store_at(st: HceWalk, i: Int, held: String, projected: Bool, seen: Array[(Int, Bool)]) -> Unit {
  let (n, label, decls, id) = Array::get(st.scope, at = i)
  Array::set(st.scope, at = i, value = (n, hce_set_union(a = label, b = held), decls, id))
  let key = (id, projected)
  if id >= 0 && !Array::any(seen, f = (item) -> item == key) {
    Array::push(seen, value = key)
    hce_note_assigned(st = st, id = id, held = held)
    let srcs: Array[(Int, Bool)] = array_empty()
    for l in st.links {
      let (a, b, element_link) = l
      // A write into an element goes on into the elements of what the
      // binding holds as elements: `Array::slice(rows, ..)` holds the very
      // arrays `rows` holds, so a push into one of its elements is a push
      // into an element of `rows`, and on into the array written there.
      if a == id && (!element_link || projected) {
        Array::push(srcs, value = (b, projected))
      } else {
        ()
      }
    }
    for source in srcs {
      let (src, into_element) = source
      let mut k = Array::length(st.scope) - 1
      let mut at = 0 - 1
      while k >= 0 && at < 0 {
        let (_, _, _, kid) = Array::get(st.scope, at = k)
        if kid == src {
          at = k
        } else {
          ()
        }
        k = k - 1
      }
      if at >= 0 {
        hce_store_at(st = st, i = at, held = held, projected = into_element, seen = seen)
      } else {
        // Out of scope here; later walks bind it holding `held`.
        hce_note_assigned(st = st, id = src, held = held)
      }
    }
    ()
  } else {
    ()
  }
}

/// #4064: the binding of the body a value stored into `e` lands in: `e`
/// itself, a field of it, or an element a getter reads out of it
/// (`Array::get(rows, at = 0)`, `rows[0]`).
fn hce_store_root(e: Expr, st: HceWalk, env: TypeEnv, projected: Bool = false) -> Option[(String, Bool)] {
  match e {
    EIdent(name, _) => if hce_scope_index(st = st, name = name) >= 0 {
      Some((name, projected))
    } else {
      None
    },
    EDot(base, _, _, _) => hce_store_root(e = base, st = st, env = env, projected = true),
    ELabeledArg(_, _, inner) => hce_store_root(e = inner, st = st, env = env, projected = projected),
    ECall(callee, cargs, _, _) => if hce_is_paren(e) {
      hce_store_root(e = Array::get(cargs, at = 0), st = st, env = env, projected = projected)
    } else {
      match callee {
        EIdent(cname, coff) => if Array::length(cargs) > 0 && hce_store_getter(env = env, name = cname, noff = coff) {
          hce_store_root(e = Array::get(cargs, at = 0), st = st, env = env, projected = true)
        } else {
          None
        },
        _ => None
      }
    },
    _ => None
  }
}

/// #4064: a call may store what one argument holds into another argument
/// rooted at a binding of the body (`Array::push(arr, value = g)`,
/// `MutMap::set`, `xs[i] = g`, `fill(xs = arr, f = g)`), and what a
/// handle-bound local callee holds (a closure that captured `g`) into any
/// of them. A constructor, an effect operation and a builtin that only
/// calls its function store nothing. `held` is what each argument holds.
fn hce_note_stores(callee: Expr, args: Array[Expr], held: Array[String], st: HceWalk, env: TypeEnv, defs: Array[TypeDef]) -> Unit {
  let mask = match callee {
    EIdent(name, noff) => if hce_scope_index(st = st, name = name) < 0 {
      hce_retained_argument_mask(env = env, name = name, noff = noff)
    } else {
      0
    },
    _ => 0
  }
  if mask != 0 && Array::length(args) > 0 {
    let mut stored = ""
    let mut i = 1
    while i < Array::length(held) {
      if (i == 1 && mask % 2 == 1) || (i == 2 && mask >= 2) {
        stored = hce_set_union(a = stored, b = Array::get(held, at = i))
      }
      i = i + 1
    }
    match hce_store_root(e = Array::get(args, at = 0), st = st, env = env) {
      Some((root, projected)) => hce_store(st = st, name = root, held = stored, projected = projected),
      None => ()
    }
    return ()
  }
  let (stores, by_callee) = match callee {
    EIdent(name, noff) => if hce_scope_index(st = st, name = name) >= 0 {
      (true, hce_local_label(st = st, name = name))
    } else {
      (!(hce_is_ctor(name = name, defs = defs) || hce_is_effect_op(name = name, defs = defs) || hce_calls_only_builtin(env = env, name = name, noff = noff) || hce_nonmutating_array_builtin(env = env, name = name, noff = noff)), "")
    },
    _ => (true, "")
  }
  let mut all = by_callee
  for h in held {
    all = hce_set_union(a = all, b = h)
  }
  if stores && all != "" {
    let mut j = 0
    while j < Array::length(args) {
      match hce_store_root(e = Array::get(args, at = j), st = st, env = env) {
        Some((root, projected)) => {
          let mut into = by_callee
          let mut i = 0
          while i < Array::length(held) {
            if i != j {
              into = hce_set_union(a = into, b = Array::get(held, at = i))
            } else {
              ()
            }
            i = i + 1
          }
          hce_store(st = st, name = root, held = into, projected = projected)
        },
        None => ()
      }
      j = j + 1
    }
    // A method call stores into its receiver.
    match callee {
      EDot(base, _, _, _) => match hce_store_root(e = base, st = st, env = env) {
        Some((root, projected)) => hce_store(st = st, name = root, held = all, projected = projected),
        None => ()
      },
      _ => ()
    }
  } else {
    ()
  }
}

/// The effect bases the walks so far found assigned to declaration `id`.
fn hce_assigned(st: HceWalk, id: Int) -> String {
  let mut out = ""
  for row in st.assigned {
    let (aid, alabel) = row
    if aid == id {
      out = alabel
    } else {
      ()
    }
  }
  out
}

/// The reach marking a `let` initializer (see `HceWalk.pos`).
fn hce_let_reach() -> Int {
  3
}

/// Where the uses of `name` in `e` can take its value: 0 when every use
/// calls it, 1 when some use hands it straight to a call that returns no
/// function, 2 otherwise. An inner binding of the same spelling is not told
/// apart, which can only answer higher.
fn hce_name_reach(name: String, e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  match e {
    EIdent(n, _) => if n == name {
      2
    } else {
      0
    },
    ECall(callee, args, _, _) => if hce_is_paren(e) {
      hce_name_reach_children(name = name, e = e, st = st, env = env, defs = defs, s = s)
    } else {
      let mut r = if hce_names(e = callee, name = name) {
        0
      } else {
        hce_name_reach(name = name, e = callee, st = st, env = env, defs = defs, s = s)
      }
      let mut ai = 0
      for arg in args {
        let ar = if hce_names(e = arg, name = name) {
          hce_beside_local(reach = hce_arg_reach(callee = callee, st = st, env = env, defs = defs, s = s), args = args, ai = ai, st = st, env = env)
        } else {
          hce_name_reach(name = name, e = arg, st = st, env = env, defs = defs, s = s)
        }
        if ar > r {
          r = ar
        } else {
          ()
        }
        ai = ai + 1
      }
      r
    },
    _ => hce_name_reach_children(name = name, e = e, st = st, env = env, defs = defs, s = s)
  }
}

fn hce_name_reach_children(name: String, e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut r = 0
  let mut i = mark
  while i < top && r < 2 {
    let cr = hce_name_reach(name = name, e = expr_child_at(i), st = st, env = env, defs = defs, s = s)
    if cr > r {
      r = cr
    } else {
      ()
    }
    i = i + 1
  }
  expr_children_pop(mark)
  r
}

/// Is `e` the bare name `name` (possibly labeled or parenthesized)?
fn hce_names(e: Expr, name: String) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    ELabeledArg(_, _, inner) => hce_names(e = inner, name = name),
    ECall(_, wargs, _, _) => hce_is_paren(e) && hce_names(e = Array::get(wargs, at = 0), name = name),
    _ => false
  }
}

/// The reach of argument `ai` of a call, given the callee's (`reach`): a
/// value the call cannot return (1) may still be stored into another of its
/// arguments, and when that argument is rooted at a binding of the handled
/// body (`Array::push(xs, h)` with `let xs = []` in the body), the value
/// lives on in that binding and goes wherever it goes (2). A binding outside
/// the body is a write route of its own.
fn hce_beside_local(reach: Int, args: Array[Expr], ai: Int, st: HceWalk, env: TypeEnv) -> Int {
  let args = call_arg_values(args)
  if reach != 1 {
    reach
  } else {
    let mut out = reach
    let mut j = 0
    while j < Array::length(args) {
      if j != ai {
        match hce_root_name(Array::get(args, at = j)) {
          Some((root, _)) => if hce_lookup(st = st, name = root) != 0 || hce_has(items = st.body_names, label = root) || env_lookup(env = env, name = root) is None {
            out = 2
          } else {
            ()
          },
          None => ()
        }
      } else {
        ()
      }
      j = j + 1
    }
    out
  }
}

/// Every name a `let` in `e` binds.
fn hce_collect_let_names(e: Expr, out: Array[String]) -> Unit {
  match e {
    ELet(name, _, _, _) => hce_add(out = out, label = name),
    ELetMut(name, _, _, _) => hce_add(out = out, label = name),
    ELetRec(name, _, _) => hce_add(out = out, label = name),
    _ => ()
  }
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    hce_collect_let_names(e = expr_child_at(i), out = out)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// The reach of a value handed straight to a call of `callee`: 1 when the
/// callee is a function declared outside the handled body whose result
/// type cannot hold a function (its result cannot be the value, though the
/// call might store it), 2 otherwise.
fn hce_arg_reach(callee: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  match callee {
    EIdent(name, _) => if hce_lookup(st = st, name = name) == 0 {
      match env_lookup(env = env, name = name) {
        Some(ty) => match hce_fn_result(ty) {
          Some(ret) => if hce_holds_fn(ty = subst_apply(s = s, ty = ret), defs = defs, seen = array_empty()) {
            2
          } else {
            1
          },
          None => 2
        },
        None => 2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// A call performs a counted effect when its callee is a handle-bound local
/// or a function whose row names one. Its result is handle-bound when such a
/// function's result type can hold a function. In the routes pass, an
/// argument rooted at a binding declared outside the body that can store a
/// function is a write out of the handle.
fn hce_note_call(callee: Expr, args: Array[Expr], off: Int, pos: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let args = call_arg_values(args)
  match callee {
    EIdent(name, noff) => {
      let local = hce_lookup(st = st, name = name)
      let at = if off >= 0 {
        off
      } else {
        noff
      }
      if local == 2 {
        hce_count_perform(st = st, label = hce_local_label(st = st, name = name), off = at)
      } else if local == 1 && off >= 0 && Array::length(st.labels) > 0 {
        // A plain local holding a function (`let f = ask`, an alias of an
        // alias, a method value): the type the checker inferred for the
        // callee at this call (#3539).
        // An alias of a declaration is followed to it (#3596).
        match hce_site_type(st = st, off = off, spelling = name, s = s) {
          Some(ty) => hce_note_callee(st = st, ty = ty, spelling = name, decl = hce_name_decls(st = st, name = name, env = env), at = at, pos = pos, env = env, defs = defs, s = s),
          None => hce_note_unsure(off = off, spelling = name)
        }
      } else if local == 0 && name != "perform" && Array::length(st.labels) > 0 {
        match env_lookup(env = env, name = name) {
          Some(ty) => {
            // A declaration not inferred yet has no row to read.
            match subst_apply(s = s, ty = ty) {
              CtVar(_) => hce_note_unsure(off = 0 - 1, spelling = name),
              _ => ()
            }
            // A row-polymorphic callee (`forward[e](g: () -> Int with e)`)
            // performs what this call instantiates its row variables to: the
            // type the checker recorded here.
            let cty = if off >= 0 && hce_row_has_var(ty) {
              match hce_site_type(st = st, off = off, spelling = name, s = s) {
                Some(t) => t,
                None => ty
              }
            } else {
              ty
            }
            // A local `let` before the handle that aliases a declaration
            // stands for it; any other local names none (#3596).
            hce_note_callee(st = st, ty = cty, spelling = name, decl = hce_outer_decls(env = env, name = name), at = at, pos = pos, env = env, defs = defs, s = s)
          },
          None => ()
        }
      } else {
        ()
      }
    },
    // A method call (`foo.mk()`, `foo.me().mk()`) or a call through any
    // other expression: the type of the callee the checker resolved there
    // (#3539).
    _ => if off >= 0 && Array::length(st.labels) > 0 {
      match hce_namespace_callee(callee = callee, st = st, env = env) {
        // `ns.mk()` through a qualified-import namespace calls the import
        // `ns.mk` by name (#3593).
        Some(qualified) => match env_lookup(env = env, name = qualified) {
          Some(ty) => hce_note_callee(st = st, ty = ty, spelling = qualified, decl = qualified, at = off, pos = pos, env = env, defs = defs, s = s),
          None => ()
        },
        None => {
          let spelling = call_callee_spelling(callee)
          match hce_site_type(st = st, off = off, spelling = spelling, s = s) {
            Some(ty) => {
              let decl = hce_method_decl(callee = callee, ty = ty, env = env, s = s)
              // A function-typed field is named as written (`fac.mk`): its
              // own name may be a declaration's too (#3599).
              let shown = match callee {
                EDot(EIdent(recv, _), m, _, _) => if decl == "" {
                  String::concat(recv, String::concat(".", m))
                } else {
                  spelling
                },
                _ => spelling
              }
              hce_note_callee(st = st, ty = ty, spelling = shown, decl = decl, at = off, pos = pos, env = env, defs = defs, s = s)
            },
            None => hce_note_unsure(off = off, spelling = spelling)
          }
        }
      }
    } else {
      ()
    }
  }
  if st.find_routes {
    for arg in args {
      match hce_root_name(arg) {
        Some((root, roff)) => if hce_lookup(st = st, name = root) == 0 {
          match env_lookup(env = env, name = root) {
            Some(ty) => if hce_stores_fn(ty = subst_apply(s = s, ty = ty), defs = defs, seen = array_empty()) {
              Array::push(st.routes, value = (String::concat("handing it to a call that may store it in `", String::concat(root, "`, which is declared outside the handle,")), roff, 1))
            } else {
              ()
            },
            None => ()
          }
        } else {
          ()
        },
        None => ()
      }
    }
    ()
  } else {
    ()
  }
}

/// `ns.m` when `callee` is `ns.m` and `ns` names a qualified-import
/// namespace rather than a value (the checker calls the import `ns.m`).
fn hce_namespace_callee(callee: Expr, st: HceWalk, env: TypeEnv) -> Option[String] {
  match callee {
    EDot(EIdent(ns, _), m, _, _) => if hce_lookup(st = st, name = ns) == 0 && env_lookup(env = env, name = ns) is None {
      let qualified = String::concat(ns, String::concat(".", m))
      match env_lookup(env = env, name = qualified) {
        Some(_) => Some(qualified),
        None => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3593: the declaration a method call `recv.m(..)` resolved to -- the
/// checker calls `T::m` for a receiver of type `T`, the recorded callee
/// type's first parameter -- or "" when it calls a function-typed field or
/// anything else that names no declaration.
fn hce_method_decl(callee: Expr, ty: Type, env: TypeEnv, s: Subst) -> String {
  match callee {
    EDot(_, m, _, _) => match hce_fn_params(hce_late(subst_apply(s = s, ty = ty))) {
      Some(params) => if Array::length(params) > 0 {
        let prefix = type_name_prefix(hce_late(subst_apply(s = s, ty = Array::get(params, at = 0))))
        let qualified = String::concat(prefix, String::concat("::", m))
        if prefix != "" && env_lookup(env = env, name = qualified) is Some(_) {
          qualified
        } else {
          ""
        }
      } else {
        ""
      },
      None => ""
    },
    _ => ""
  }
}

/// A call at `at` whose callee, spelled `spelling`, has type `ty`: it
/// performs every counted effect the callee's row names, and its result is
/// handle-bound for each one it can hold a function without -- the closure
/// it returns inherited the row of this call. However the callee is reached
/// (a name, a local alias, a method), the same type decides. `decl` names
/// the declarations outside the body the callee stands for, comma-joined
/// (more than one through a conditional alias, #3596), else "".
fn hce_note_callee(st: HceWalk, ty: Type, spelling: String, decl: String, at: Int, pos: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let found = hce_row_labels(ty = ty, labels = st.labels)
  if Array::length(found) > 0 {
    let mut performed = ""
    let mut bound = ""
    let mut guessed = false
    for label in found {
      performed = hce_set_union(a = performed, b = label)
      // An exception row counts the function values the result type spells
      // -- the result itself, or one inside a tuple, array, `Option`,
      // record or type argument. Inside the fields of a declared type it
      // counts them only when the callee's body creates a closure that
      // throws and can leave it (#3584): a function that may throw and
      // returns compiler state or a table holding callbacks (a `MutMap`'s
      // hash function) is common, and following every field refused nine
      // handles in the compiler itself. A declaration of another module
      // answers by the fact its module published (#3593), whose fields this
      // module may not see. A callee whose row has `label` only through a
      // row variable this call instantiates answers by whether its body
      // creates such a closure performing that variable (#3594).
      let holds = if is_exception_effect_name(label) {
        let ret = subst_apply(s = s, ty = ret_or_unit(hce_fn_result(ty)))
        let mut made = hce_spells_fn_without(ty = ret, label = label, defs = defs, seen = array_empty())
        for d in hce_set_items(decl) {
          if !made && (hce_holds_fn_without(ty = ret, label = label, defs = defs, seen = array_empty()) || retention_decl_value(d) is None) && (hce_decl_makes_bound(name = d, label = label, env = env, defs = defs, s = s) || hce_decl_makes_bound_via_var(name = d, inst = ty, label = label, env = env, defs = defs, s = s)) {
            made = true
            guessed = hce_decl_unread(d)
          } else {
            ()
          }
        }
        // #3599: a callee that names no declaration -- a parameter, a local
        // bound to a call's result, a function-typed field -- has no body to
        // read, so a closure inside a declared type's field of its result is
        // taken to throw.
        if !made && decl == "" && hce_holds_fn_without(ty = ret, label = label, defs = defs, seen = array_empty()) {
          made = true
          guessed = true
        } else {
          ()
        }
        made
      } else {
        match hce_fn_result(ty) {
          Some(ret) => hce_holds_fn_without(ty = subst_apply(s = s, ty = ret), label = label, defs = defs, seen = array_empty()),
          None => false
        }
      }
      if holds {
        bound = hce_set_union(a = bound, b = label)
      } else {
        ()
      }
    }
    hce_count_perform(st = st, label = performed, off = at)
    match hce_fn_result(ty) {
      Some(_) => if bound != "" {
        let callee = if spelling == "" {
          "this call's callee"
        } else {
          String::concat("`", String::concat(spelling, "`"))
        }
        let what = if guessed {
          String::concat(hce_unread_prefix(), String::concat(callee, " returns"))
        } else if spelling == "" {
          "the closure this call returns"
        } else {
          String::concat("the closure ", String::concat(callee, " returns"))
        }
        Array::push(st.producers, value = (what, at, bound, pos))
      } else {
        ()
      },
      None => ()
    }
  } else {
    ()
  }
}

/// The callee type the checker recorded for the call at `off` among the
/// calls the handled body recorded: the first whose row names a counted
/// label.
fn hce_site_type(st: HceWalk, off: Int, spelling: String, s: Subst) -> Option[Type] {
  let mut found: Option[Type] = None
  let mut hit = false
  let mut i = st.sites_from
  let n = Array::length(call_callee_sites)
  while !hit && i < n {
    let (soff, sp, ty) = Array::get(call_callee_sites, at = i)
    if soff == off && sp == spelling {
      let t = hce_late(subst_apply(s = s, ty = ty))
      if hce_row_label(ty = t, labels = st.labels) != "" {
        found = Some(t)
        hit = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does the function literal `f`, the value (or one of the values) of the
/// declaration `name`, create a closure that performs `label` and can leave
/// it? Its body is walked the way a handled body is.
fn hce_literal_makes_bound(name: String, label: String, f: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  match f {
    EFn(_, _, params, _, _, fbody) => {
      let names: Array[String] = array_empty()
      hce_collect_let_names(e = fbody, out = names)
      let st = hce_new(labels = [label], find_routes = false, sites_from = 0, body_names = names, assigned = array_empty(), links = array_empty())
      // #3594: read for a row variable (`label` is `e`), a parameter
      // whose function type's row is `e` performs it when called.
      let declared = if label_is_effect_var(label) {
        match env_lookup(env = env, name = name) {
          Some(t) => match hce_fn_params(t) {
            Some(ps) => ps,
            None => array_empty()
          },
          None => array_empty()
        }
      } else {
        array_empty()
      }
      let mut pi = 0
      for p in params {
        let (pname, _) = p
        hce_bind(st = st, name = pname, label = if pi < Array::length(declared) && hce_row_names_var(ty = Array::get(declared, at = pi), v = label) {
          label
        } else {
          ""
        })
        pi = pi + 1
      }
      hce_walk(e = fbody, st = st, env = env, defs = defs, s = s)
      let mut made = false
      for p in st.producers {
        let (_, _, plabel, preach) = p
        if preach > 0 && hce_has(items = hce_set_items(plabel), label = label) {
          made = true
        } else {
          ()
        }
      }
      made
    },
    _ => false
  }
}

/// Is `callee` the parser's spelling of an annotation (`e: T`)?
fn hce_is_ascription(_ callee: Expr) -> Bool {
  match ascription_lambda_ann(callee) {
    Some(_) => true,
    None => false
  }
}

/// The function literals (`lits`) and the declarations (`srcs`) the value
/// `e` of a top-level function-typed `let` may be, and whether every place
/// its value can come from was read. Read the way `retention_alias_sources`
/// reads an alias, with a literal as one more source: each branch of an
/// `if` or a `match`, a block's tail, under an annotation or parentheses. A
/// literal under a `let` of a block, or in a `match` arm that binds, may
/// close over what those bind, which a walk of its body does not see, so it
/// leaves the reading incomplete.
fn hce_decl_sources(e: Expr, lits: Array[Expr], srcs: Array[String]) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => {
      Array::push(lits, value = e)
      true
    },
    EIdent(src, _) => {
      Array::push(srcs, value = src)
      true
    },
    EIf(_, a, b) => {
      let ca = hce_decl_sources(e = a, lits = lits, srcs = srcs)
      let cb = hce_decl_sources(e = b, lits = lits, srcs = srcs)
      ca && cb
    },
    EMatch(_, arms) => {
      let mut complete = true
      for arm in arms {
        let bound: Array[String] = array_empty()
        retention_pat_names_into(p = arm.0, out = bound)
        let found_lits: Array[Expr] = array_empty()
        let found: Array[String] = array_empty()
        if !hce_decl_sources(e = arm.1, lits = found_lits, srcs = found) {
          complete = false
        } else {
          ()
        }
        if Array::length(bound) > 0 && Array::length(found_lits) > 0 {
          complete = false
        } else {
          for f in found_lits {
            Array::push(lits, value = f)
          }
        }
        for src in found {
          if hce_has(items = bound, label = src) {
            complete = false
          } else {
            Array::push(srcs, value = src)
          }
        }
      }
      complete
    },
    ESeq(_, b) => hce_decl_sources(e = b, lits = lits, srcs = srcs),
    ELet(n, v, rest, _) => {
      let found_lits: Array[Expr] = array_empty()
      let found: Array[String] = array_empty()
      let mut complete = hce_decl_sources(e = rest, lits = found_lits, srcs = found)
      if Array::length(found_lits) > 0 {
        complete = false
      } else {
        ()
      }
      for src in found {
        if src == n {
          if !hce_decl_sources(e = v, lits = lits, srcs = srcs) {
            complete = false
          } else {
            ()
          }
        } else {
          Array::push(srcs, value = src)
        }
      }
      complete
    },
    ECall(callee, args, _, _) => if hce_is_paren(e) || Array::length(args) == 1 && hce_is_ascription(callee) {
      hce_decl_sources(e = Array::get(args, at = 0), lits = lits, srcs = srcs)
    } else {
      false
    },
    _ => false
  }
}

/// The declarations `hce_decl_makes_bound` is reading, innermost last, and
/// one entry for each time it met one of them again.
let hce_decl_stack: Array[String] = []
let hce_decl_cycles: Array[Int] = []

/// #3584: does the declaration `name` of this module create a closure that
/// performs `label` and can leave it -- held in a field of the value it
/// returns (`Box::{ f: () -> throw(7) }`), say? Such a closure inherited the
/// row of the call, so the handle around the call is what answers it. Read
/// from the declaration's body, the way the handled body is: a declaration
/// whose fields hold only closures that do not perform `label` (a `MutMap`'s
/// hash function) answers no, and so does one this module does not hold.
fn hce_decl_makes_bound(name: String, label: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  let key = String::concat(name, String::concat("|", label))
  let mut known = 0 - 1
  let mut ki = 0
  while known < 0 && ki < Array::length(hce_decl_facts) {
    let (k, _) = Array::get(hce_decl_facts, at = ki)
    if k == key {
      known = ki
    } else {
      ()
    }
    ki = ki + 1
  }
  if name == hce_unknown_decl() {
    true
  } else if known >= 0 {
    let (_, made) = Array::get(hce_decl_facts, at = known)
    made
  } else if hce_has(items = hce_decl_stack, label = key) {
    // A cycle answers no while its first reading is under way; an answer
    // that leaned on it is not remembered.
    Array::push(hce_decl_cycles, value = 1)
    false
  } else {
    match retention_decl_value(name) {
      // The function literals and the declarations its value may be
      // (`hce_decl_sources`): `let make = () -> ..`, an alias of other
      // declarations (`let make = mk`, `let make: () -> Box with
      // Exception[Int] = mk`), or a choice between them (`let make = if c {
      // () -> .. } else { mk }`). One whose value may also come from
      // something it does not read may be any, and answers yes
      // (`hce_unknown_decl`), and so does one that reads nothing at all (a
      // call's result), like a local of that kind (#3599).
      Some(val) => {
        let lits: Array[Expr] = array_empty()
        let srcs: Array[String] = array_empty()
        if !hce_decl_sources(e = val, lits = lits, srcs = srcs) {
          Array::push(srcs, value = hce_unknown_decl())
        } else {
          ()
        }
        let cycles_before = Array::length(hce_decl_cycles)
        let unsure_before = Array::length(hce_unsure)
        Array::push(hce_decl_stack, value = key)
        let mut made = false
        for f in lits {
          if !made && hce_literal_makes_bound(name = name, label = label, f = f, env = env, defs = defs, s = s) {
            made = true
          } else {
            ()
          }
        }
        for src in srcs {
          if !made && src != name && hce_decl_makes_bound(name = src, label = label, env = env, defs = defs, s = s) {
            made = true
          } else {
            ()
          }
        }
        Array::truncate(hce_decl_stack, length = Array::length(hce_decl_stack) - 1)
        if made || (Array::length(hce_decl_cycles) == cycles_before && Array::length(hce_unsure) == unsure_before) {
          Array::push(hce_decl_facts, value = (key, made))
        } else {
          ()
        }
        if Array::length(hce_decl_stack) == 0 {
          Array::truncate(hce_decl_cycles, length = 0)
        } else {
          ()
        }
        made
      },
      // #3593: a declaration of another module, by the fact its module
      // published (`hce_bind_module_summaries`).
      None => hce_imported_makes_bound(name = name, label = label, env = env)
    }
  }
}

/// #3599: is `name` a top-level binding of this module whose value names no
/// function the check can read (`let g = pick(3)`)?
fn hce_decl_unread(_ name: String) -> Bool {
  match retention_decl_value(name) {
    Some(val) => {
      let lits: Array[Expr] = array_empty()
      let srcs: Array[String] = array_empty()
      !hce_decl_sources(e = val, lits = lits, srcs = srcs) && Array::length(lits) == 0 && Array::length(srcs) == 0
    },
    None => false
  }
}

/// Whether the module that declares the imported function `name` published
/// that a closure it creates performs `label` and can leave it.
fn hce_imported_makes_bound(name: String, label: String, env: TypeEnv) -> Bool {
  match env_lookup(env = env, name = retention_summary_marker(name)) {
    Some(CtNamed(_, facts)) => {
      let mut found = false
      for f in facts {
        match f {
          CtNamed(l, _) => if l == label {
            found = true
          } else {
            ()
          },
          _ => ()
        }
      }
      found
    },
    _ => false
  }
}

/// #3594: does the declaration `name`, called at the instantiated type
/// `inst`, return a closure performing `label` that it created for a row
/// variable of its own row (`forward[e](g: () -> Int with e) -> Box with e`
/// building `Box::{ f: () -> g() }`), the call instantiating that variable
/// to a row that names `label`?
fn hce_decl_makes_bound_via_var(name: String, inst: Type, label: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  match env_lookup(env = env, name = name) {
    Some(scheme) => {
      let mut made = false
      for v in hce_result_fn_row(scheme) {
        if !made && label_is_effect_var(v) {
          let at: Array[String] = array_empty()
          hce_var_inst(scheme = scheme, inst = inst, v = v, out = at)
          if hce_has(items = at, label = label) && hce_decl_makes_bound(name = name, label = v, env = env, defs = defs, s = s) {
            made = true
          } else {
            ()
          }
        } else {
          ()
        }
      }
      made
    },
    None => false
  }
}

/// The effect bases the row variable `v` of `scheme` stands for in `inst`,
/// the same type instantiated at a call: read off each function row of
/// `scheme` that names `v`, as the labels the matching row of `inst` adds
/// to the ones `scheme` spells there.
fn hce_var_inst(scheme: Type, inst: Type, v: String, out: Array[String]) -> Unit {
  match (scheme, inst) {
    (CtForAll(_, _, inner), _) => hce_var_inst(scheme = inner, inst = inst, v = v, out = out),
    (_, CtForAll(_, _, inner)) => hce_var_inst(scheme = scheme, inst = inner, v = v, out = out),
    (CtFn(ps, r, srow), CtFn(qs, r2, irow)) => {
      if hce_row_names_var(ty = scheme, v = v) {
        let own = hce_row_bases(srow)
        for b in hce_row_bases(irow) {
          if !hce_has(items = own, label = b) {
            hce_add(out = out, label = b)
          } else {
            ()
          }
        }
      } else {
        ()
      }
      if Array::length(ps) == Array::length(qs) {
        hce_var_inst_all(xs = ps, ys = qs, v = v, out = out)
      } else {
        ()
      }
      hce_var_inst(scheme = r, inst = r2, v = v, out = out)
    },
    (CtArray(a), CtArray(b)) => hce_var_inst(scheme = a, inst = b, v = v, out = out),
    (CtOption(a), CtOption(b)) => hce_var_inst(scheme = a, inst = b, v = v, out = out),
    (CtTuple(xs), CtTuple(ys)) => if Array::length(xs) == Array::length(ys) {
      hce_var_inst_all(xs = xs, ys = ys, v = v, out = out)
    } else {
      ()
    },
    (CtNamed(_, xs), CtNamed(_, ys)) => if Array::length(xs) == Array::length(ys) {
      hce_var_inst_all(xs = xs, ys = ys, v = v, out = out)
    } else {
      ()
    },
    _ => ()
  }
}

fn hce_var_inst_all(xs: Array[Type], ys: Array[Type], v: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(xs) {
    hce_var_inst(scheme = Array::get(xs, at = i), inst = Array::get(ys, at = i), v = v, out = out)
    i = i + 1
  }
}

/// The bases of the effects a row spells, row variables left out.
fn hce_row_bases(_ row: Option[String]) -> Array[String] {
  let out: Array[String] = array_empty()
  match row {
    Some(r) => for raw in String::split(r, sep = ",") {
      let l = String::trim(raw)
      if String::length(l) > 0 && !String::starts_with(l, prefix = "#") && !label_is_effect_var(l) {
        hce_add(out = out, label = row_label_base(effect_name_of_op(l)))
      } else {
        ()
      }
    },
    None => ()
  }
  out
}

/// Does the row of the function type `ty` name the row variable `v`?
fn hce_row_names_var(ty: Type, v: String) -> Bool {
  match ty {
    CtForAll(_, _, inner) => hce_row_names_var(ty = inner, v = v),
    CtFn(_, _, Some(row)) => {
      let mut found = false
      for raw in String::split(row, sep = ",") {
        if String::trim(raw) == v {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// Does the row of the function type `ty` name a row variable?
fn hce_row_has_var(_ ty: Type) -> Bool {
  match ty {
    CtForAll(_, _, inner) => hce_row_has_var(inner),
    CtFn(_, _, Some(row)) => {
      let mut found = false
      for raw in String::split(row, sep = ",") {
        if label_is_effect_var(String::trim(raw)) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// Is the walk reading a declaration for a row variable (#3594)?
fn hce_poly_walk(_ st: HceWalk) -> Bool {
  Array::length(st.labels) == 1 && label_is_effect_var(Array::get(st.labels, at = 0))
}

fn hce_callee_is_ctor(callee: Expr, defs: Array[TypeDef]) -> Bool {
  match callee {
    EIdent(name, _) => hce_is_ctor(name = name, defs = defs),
    _ => false
  }
}

/// #3593: `env` with, for each function this module publishes that creates
/// a closure performing an exception and can return it inside a declared
/// type's fields, the exception bases it does that for -- read where the
/// module's own handles read it (`hce_decl_makes_bound`), so an importer's
/// handle can answer without the body. The facts ride the function's
/// `retention_summary_marker` binding as its type arguments, after the
/// retention summary, and reach importers, re-exports and type companions
/// the way that summary does. `final_s` is the module's final substitution.
export fn hce_bind_module_summaries(stmts: Array[Stmt], env: TypeEnv, defs0: Array[TypeDef], final_s: Subst) -> TypeEnv {
  if !retention_summaries_enabled() {
    env
  } else {
    let defs = hce_defs_with_env(defs = defs0, env = env)
    Array::push(hce_final, value = final_s)
    let mut out = env
    for stmt in stmts {
      match stmt {
        SLet(_, _, name, _, _) => {
          let facts = hce_decl_bound_facts(name = name, env = env, defs = defs, s = final_s)
          // A declaration with no fact still hides the facts of an import
          // its name would otherwise republish.
          match env_lookup(env = env, name = retention_summary_marker(name)) {
            Some(CtNamed(text, old)) => if Array::length(facts) > 0 || Array::length(old) > 0 {
              out = env_bind(env = out, name = retention_summary_marker(name), ty = CtNamed(text, facts))
            } else {
              ()
            },
            _ => if Array::length(facts) > 0 {
              out = env_bind(env = out, name = retention_summary_marker(name), ty = CtNamed("", facts))
            } else {
              ()
            }
          }
        },
        _ => ()
      }
    }
    Array::truncate(hce_final, length = Array::length(hce_final) - 1)
    out
  }
}

/// The exception bases the declaration `name` creates a throwing closure
/// for that can leave it inside a declared type's fields, and the row
/// variables of its own row it creates a closure performing for (#3594),
/// each as a `CtNamed` with no arguments. A result type that spells the
/// function needs no fact: the importer reads it off the type.
fn hce_decl_bound_facts(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Array[Type] {
  let facts: Array[Type] = array_empty()
  match env_lookup(env = env, name = name) {
    Some(ty0) => {
      let ty = subst_apply(s = s, ty = ty0)
      match hce_fn_result(ty) {
        Some(ret0) => {
          let ret = subst_apply(s = s, ty = ret0)
          let bases: Array[String] = array_empty()
          for l in hce_result_fn_row(ty) {
            if !label_is_effect_var(l) {
              let base = row_label_base(effect_name_of_op(l))
              if is_exception_effect_name(base) {
                hce_add(out = bases, label = base)
              } else {
                ()
              }
            } else {
              ()
            }
          }
          // #3594: a row variable of the declaration's own row (`e`) is a
          // fact too, which an importer reads at the row its call
          // instantiates that variable to.
          for l in hce_result_fn_row(ty) {
            if label_is_effect_var(l) {
              hce_add(out = bases, label = l)
            } else {
              ()
            }
          }
          for base in bases {
            if !hce_spells_fn_without(ty = ret, label = base, defs = defs, seen = array_empty()) && hce_holds_fn_without(ty = ret, label = base, defs = defs, seen = array_empty()) && hce_decl_makes_bound(name = name, label = base, env = env, defs = defs, s = s) {
              Array::push(facts, value = CtNamed(base, array_empty()))
            } else {
              ()
            }
          }
        },
        None => ()
      }
    },
    None => ()
  }
  facts
}

/// The effect bases of the handle-bound values the argument `arg` (just
/// walked; `producers_before` is where its producers begin) hands the call:
/// the closures written in it that can leave it, and the handle-bound
/// locals it does not merely call. "" when it hands none.
fn hce_arg_bound_label(arg: Expr, producers_before: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  let arg = call_arg_value(arg)
  let mut found = ""
  let mut pi = producers_before
  while pi < Array::length(st.producers) {
    let (_, _, plabel, preach) = Array::get(st.producers, at = pi)
    if preach > 0 {
      found = hce_set_union(a = found, b = plabel)
    } else {
      ()
    }
    pi = pi + 1
  }
  let mut si = 0
  while si < Array::length(st.scope) {
    let (n, label, _, _) = Array::get(st.scope, at = si)
    if label != "" && hce_lookup(st = st, name = n) == 2 && hce_name_reach(name = n, e = arg, st = st, env = env, defs = defs, s = s) > 0 {
      found = hce_set_union(a = found, b = label)
    } else {
      ()
    }
    si = si + 1
  }
  found
}

/// Can the call at `off` keep the value performing the set `label` it is handed as
/// argument `ai` (`arg`, of `nargs`) past the call -- in state the callee
/// captured, a module-level binding, its receiver, a handler's state? Not
/// when:
///
///   - the parameter there cannot hold a function, or is a function type
///     whose row names every base of `label` or a row variable: a closure handed there
///     takes that row, and whoever calls it passes the handler;
///   - the callee is a constructor -- `Some` / `Ok` / `Err` or a declared
///     enum variant, never a function by the case of its name (the value it
///     builds is the value, and its reach is read where it goes);
///   - the callee is a builtin that only calls the function (`Array::map`,
///     `filter`, `fold`, `any`, `all`, `find`, a `region` body) and the call
///     reaches that builtin, not a program function of its spelling;
///   - the callee is a function declared at the top of this module, or a
///     closure literal a `let` before the handle bound, whose body only ever
///     calls that parameter, outside any closure of its own.
///
/// Any other callee -- a local, a closure declared before the handle, an
/// imported function, a method, a computed callee, `perform` -- may.
fn hce_callee_may_keep(callee: Expr, off: Int, arg: Expr, ai: Int, nargs: Int, label: String, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  let written = arg
  let takes_row = match hce_param_type(callee = callee, off = off, arg = written, ai = ai, nargs = nargs, st = st, env = env, s = s) {
    Some(pt) => !hce_holds_fn(ty = pt, defs = defs, seen = array_empty()) || hce_set_untaken(set = label, pt = pt) == "",
    None => false
  }
  if takes_row {
    false
  } else {
    match callee {
      EIdent(name, noff) => if hce_lookup(st = st, name = name) != 0 {
        true
      } else if hce_is_ctor(name = name, defs = defs) || hce_is_effect_op(name = name, defs = defs) || hce_calls_only_builtin(env = env, name = name, noff = noff) || hce_container_builtin(env = env, name = name, noff = noff) {
        false
      } else {
        let lit = match retention_local_closure(env = env, name = name) {
          Some(l) => Some(l),
          None => retention_decl_value(name)
        }
        match lit {
          // A labeled argument is read at its written index only when the
          // call writes every parameter (`hce_param_type`).
          Some(EFn(_, _, fparams, _, _, fbody)) => if (written is ELabeledArg(_, _, _)) && Array::length(fparams) != nargs {
            true
          } else {
            if ai < Array::length(fparams) {
              let (pname, _) = Array::get(fparams, at = ai)
              !hce_only_called(name = hce_param_base(pname), e = fbody)
            } else {
              true
            }
          },
          _ => true
        }
      },
      _ => true
    }
  }
}

/// The type of the parameter argument `ai` of the call at `off` is passed
/// to: from the environment for a function declared outside the body, else
/// from the callee type the checker recorded at the call. A method's
/// recorded type may lead with its receiver. None when it is not known, or
/// the argument is labeled.
fn hce_param_type(callee: Expr, off: Int, arg: Expr, ai: Int, nargs: Int, st: HceWalk, env: TypeEnv, s: Subst) -> Option[Type] {
  let ty = match callee {
    EIdent(name, _) => if hce_lookup(st = st, name = name) == 0 {
      match env_lookup(env = env, name = name) {
        Some(t) => Some(t),
        None => hce_recorded_type(off = off, spelling = name)
      }
    } else {
      hce_recorded_type(off = off, spelling = name)
    },
    _ => hce_recorded_type(off = off, spelling = call_callee_spelling(callee))
  }
  // A labeled argument's written index is its formal slot only when the call
  // writes every parameter (and a dot call's receiver): labels never reorder
  // (an out-of-order label is refused), but an omitted optional parameter
  // shifts every later argument.
  let labeled = arg is ELabeledArg(_, _, _)
  match ty {
    Some(t) => match hce_fn_params(hce_late(subst_apply(s = s, ty = t))) {
      Some(params) => {
        let receiver = Array::length(params) == nargs + 1
        let at = if receiver {
          ai + 1
        } else {
          ai
        }
        // One parameter more than the written arguments is a method's
        // receiver only at a dot call; at any other callee it is an omitted
        // optional parameter, so a labeled argument's slot is unknown.
        if labeled && !(Array::length(params) == nargs || receiver && (callee is EDot(_, _, _, _))) {
          None
        } else if at < Array::length(params) {
          Some(Array::get(params, at = at))
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}

/// Any callee type the checker recorded for the call at `off`.
fn hce_recorded_type(off: Int, spelling: String) -> Option[Type] {
  let mut found: Option[Type] = None
  let mut hit = false
  if off >= 0 {
    for row in call_callee_sites {
      let (soff, sp, ty) = row
      if !hit && soff == off && sp == spelling {
        found = Some(ty)
        hit = true
      } else {
        ()
      }
    }
    for row in call_callee_param_sites {
      let (soff, sp, ty) = row
      if !hit && soff == off && sp == spelling {
        found = Some(ty)
        hit = true
      } else {
        ()
      }
    }
  } else {
    ()
  }
  found
}

/// Take from the producers from `from` on the effects the parameter type
/// `pt` carries, and forget those left with none: a closure performing
/// `Ask` and `Log` handed to `() -> Int with Ask` still needs this handle
/// for `Log` (#3585).
fn hce_drop_row_taken(st: HceWalk, from: Int, pt: Type) -> Unit {
  let kept: Array[(String, Int, String, Int)] = array_empty()
  let mut pi = from
  while pi < Array::length(st.producers) {
    let (pwhat, poff, plabel, preach) = Array::get(st.producers, at = pi)
    let left = hce_set_untaken(set = plabel, pt = pt)
    if left != "" {
      Array::push(kept, value = (pwhat, poff, left, preach))
    } else {
      ()
    }
    pi = pi + 1
  }
  Array::truncate(st.producers, length = from)
  for p in kept {
    Array::push(st.producers, value = p)
  }
  ()
}

fn hce_note_outer_write(st: HceWalk, name: String, off: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  if st.find_routes && hce_lookup(st = st, name = name) == 0 {
    match env_lookup(env = env, name = name) {
      Some(ty) => if hce_holds_fn(ty = subst_apply(s = s, ty = ty), defs = defs, seen = array_empty()) {
        Array::push(st.routes, value = (String::concat("assigning it to `", String::concat(name, "`, which is declared outside the handle,")), off, 2))
      } else {
        ()
      },
      None => ()
    }
  } else {
    ()
  }
}

/// The binding an argument reads through (`x`, `x.f.g`).
fn hce_root_name(_ e: Expr) -> Option[(String, Int)] {
  match e {
    EIdent(name, off) => Some((name, off)),
    EDot(base, _, _, _) => hce_root_name(base),
    ELabeledArg(_, _, inner) => hce_root_name(inner),
    _ => None
  }
}

fn ret_or_unit(_ r: Option[Type]) -> Type {
  match r {
    Some(t) => t,
    None => CtUnit
  }
}
