//# A closure must not outlive the `handle` that answers its effects (#3540)
//
// An unannotated closure literal inherits the effect row of the context it is
// written in (#761), and its type stays PURE: its row is charged by the
// effect pass, not carried by the value. Inside a `handle`, that context
// includes the operations the handle discharges, so
//
//   let g = handle { () -> perform Ask::Get() + 1 } with { Ask::Get() => resume(5) }
//
// typed `g: () -> Int` and checked clean. The perform is answered by THIS
// handle, which exists only while its body runs; the value outlives it, and
// calling it afterwards trapped (`unreachable`) or answered from the dead
// handler, depending on which lowering the closure took. Neither the caller's
// row nor its type said that `g` performs `Ask`.
//
// A value that may perform what the handle discharges is a HANDLE-BOUND value:
//
//   - a closure literal written in the handled body, without its own row for
//     the operation, whose body performs it -- a `perform`, a `throw` for an
//     exception arm, a call (by name, through a local alias, or a method
//     call) to a function whose row names it, or a call to another
//     handle-bound local -- unless it is handed straight to a parameter
//     whose function type's row names every such effect it performs, or a
//     row variable (`TaskGroup::spawn(g, () -> ..)`): it takes that row
//     there, as does every closure written inside it, and whoever calls it
//     passes the handler;
//   - the result of a call to a function whose row names the effect and
//     whose result type can hold a function without that row (the closure
//     it returns inherited the row of that call; for an exception row, a
//     function the result type spells, or one inside a declared type's
//     fields when the callee is a declaration whose body creates a closure
//     that throws and can leave it -- read from the body for this module's,
//     from the fact its module published for an imported one, #3593, or
//     when the callee names no declaration to read -- a parameter, a call's
//     result, a field -- #3599; for
//     a row variable the call instantiates to the effect, a closure that
//     performs that variable, such as one calling a parameter whose row it
//     is, #3594) --
//     called by name, through a local alias, or as a method
//     (`factory.mk()`, the `T::mk` it resolved to), whose type is the one
//     the checker recorded at the call.
//
// An effect the enclosing declaration's result type gives the function
// value it returns (#1451) is not bound here when the result is that
// function type: such a closure takes the row and its caller passes the
// handler.
//
// Where such a value can go is read from where it is written (its REACH):
//
//   - nowhere, when it is applied in place (`(() -> perform E::Op())()`, a
//     call's result called at once) or bound by `let` and only ever called;
//   - into a call, when it is handed straight to a function declared outside
//     the body whose result type cannot hold a function (`apply(() -> ..)`):
//     the call cannot return it, though it might store it -- unless another
//     argument is rooted at a binding of the body (`Array::push(xs, ..)`
//     with `let xs` in the body), where the value lives on and goes
//     wherever that binding goes;
//   - anywhere, otherwise.
//
// A value that goes nowhere is not looked at again. Otherwise the routes out
// are refused:
//
//   - a write into a binding declared outside the body that can store a
//     function: an assignment, or a call given that binding (a field write,
//     `Array::push`, a helper that pushes into its argument);
//   - handing the value itself to a call that may keep it where no argument
//     reaches -- in state the callee captured, a module-level binding, its
//     receiver, an outer handler's state (`perform`). Every callee may,
//     except where the parameter is a function type whose row names the
//     effect or a row variable (the closure takes that row, and whoever
//     calls it passes the handler) or cannot hold a function; a
//     constructor (`Some`, `Ok`, `Err` or a declared enum variant -- never
//     a function by the case of its name); a builtin that only calls it
//     (`Array::map`, `filter`, `fold`, `any`, `all`, `find`, a `region`
//     body); a builtin of a container namespace (`Array::push`), which
//     keeps a value only in its arguments; and a function
//     declared at the top of the module, or a closure literal a `let`
//     bound before the handle, whose body only ever calls that parameter,
//     outside any closure of its own (`apply(() -> ..)` with
//     `fn apply(f: () -> Int) -> Int { f() + 100 }`);
//   - for a value that can go anywhere, also a `return` whose declared type
//     can hold a function, and the handle's value when the body's type can
//     hold one (directly or inside a tuple, array, `Option`, struct, enum or
//     map, so an `AsyncIter` counts).
//
// The rule does not trace which value reaches a write or a value route: once
// a value that can go anywhere exists, any function value leaving through one
// is refused. Measured on the compiler, the standard library and the
// fixtures, that refuses nothing they write except one fixture that did
// store such a closure outside its handle.

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  canonical_exception_effect_name,
  env_bind,
  env_lookup,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  find_typedef,
  is_exception_effect_name,
  subst_apply
}

import @vibe/compiler/checker/effects {
  call_callee_spelling,
  collect_pat_binds_into,
  dh_perform_effect,
  effect_name_of_op,
  effect_row_labels,
  effect_row_parse,
  label_is_effect_var,
  row_label_base
}

import @vibe/compiler/checker/diagnostics {
  off_marker
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_resolves_at
}

import @vibe/compiler/checker/resolution {
  subst_type_params
}

import @vibe/compiler/checker/traits {
  env_marker_before
}

import ./checker_throw_kind_of_type.vibe {
  railway_expr_off
}

import ./checker_merge_capture_provenance.vibe {
  call_callee_param_sites, call_callee_sites
}

import ./checker_region_retention_arms.vibe {
  hce_decl_facts, retention_alias_names, retention_decl_value, retention_pat_names_into
}

import ./checker_builtin_arg_head_rest.vibe {
  ascription_lambda_ann, type_name_prefix
}

import ./checker_region_retention_summary.vibe {
  retention_summaries_enabled, retention_summary_marker
}

import ./checker_region_retention.vibe {
  retention_closure_scope, retention_local_closure, retention_marker, retention_name_scope
}

import @vibe/core {
  array_empty
}

/// The state of one walk over a handled body.
struct HceWalk {
  /// Bases of the effects whose performs count (`Ask`, `Exception`).
  mut labels: Array[String];
  /// Names bound inside the handled body, innermost last, each with the
  /// effect base of the handle-bound value it holds ("" for a plain value)
  /// and the declarations a local alias of a function stands for (#3596;
  /// comma-joined, "" for any other binding).
  scope: Array[(String, String, String)];
  /// Every counted perform, in walk order: its offset and effect base.
  performs: Array[(Int, String)];
  /// Handle-bound values found: (description, offset, effect base, reach).
  /// The reach says where the value can go: 0 nowhere (applied in place, or
  /// bound by `let` and only ever called), 1 into a call that returns no
  /// function (which might store it), 2 anywhere.
  producers: Array[(String, Int, String, Int)];
  /// The reach of the expression the walk is about to enter, set by its
  /// parent and read once on entry (see `hce_walk`). `hce_let_reach` marks
  /// a `let` initializer, whose reach its uses decide.
  mut pos: Int;
  /// How many references to a handle-bound local the walk has passed, and
  /// the effect base of the latest.
  mut mentions: Int;
  mut mention_label: String;
  /// Whether the walk also looks for routes out (the second pass).
  find_routes: Bool;
  /// Closure literals the walk is inside: a `return` there leaves the
  /// closure, not the handle.
  mut fn_depth: Int;
  /// The routes out found: (what it is, offset, the reach a value needs to
  /// take it).
  routes: Array[(String, Int, Int)];
  /// Calls handed a handle-bound value that may keep it: (what, offset,
  /// the effects the parameter does not take). Named only when no other
  /// route, nor the handle's value, explains the refusal.
  keeps: Array[(String, Int, String)];
  /// Where the handled body's rows begin in `call_callee_sites`.
  sites_from: Int;
  /// Every name a `let` in the handled body binds, wherever it sits.
  body_names: Array[String]
}

/// Refuse a handle-bound value leaving the handle `body` / `arms` checked
/// at `body_ty`. `env` is the environment the handle is written in, so a
/// name it binds is declared outside the body. `sites_from` is the length of
/// `call_callee_sites` before the body was checked.
export fn refuse_handle_bound_escape(body: Expr, arms: Array[(Pat, Expr)], body_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, sites_from: Int, errors: Array[String]) -> Unit {
  let unsure_before = Array::length(hce_unsure)
  let errors_before = Array::length(errors)
  hce_refuse(body, arms, body_ty, env, defs, s, sites_from, errors)
  // A declaration read before its body was checked may have answered no
  // for want of the callee types that body records (Codex on #3594): ask
  // again once the module is checked (`hce_run_deferred`).
  if Array::length(hce_final) == 0 && Array::length(errors) == errors_before && Array::length(hce_unsure) > unsure_before {
    Array::push(hce_pending, (body, arms, body_ty, env, defs, s, sites_from))
  } else {
    ()
  }
  Array::truncate(hce_unsure, unsure_before)
}

/// `defs` and the declarations of other modules this one did not import by
/// name (`import dep { mk }` with `mk() -> Box`), whose fields decide
/// whether the handle's value can hold a function (#3593). Such a type
/// reaches the importer only as a reference marker in `env`
/// (`#typeref-def:Box`), whose identity spells its definition.
fn hce_defs_with_env(defs: Array[TypeDef], env: TypeEnv) -> Array[TypeDef] {
  let extra: Array[TypeDef] = array_empty()
  for row in hce_reference_rows(env) {
    let (name, identity) = row
    if (find_typedef(defs, name) is None) && (find_typedef(extra, name) is None) {
      match hce_reference_typedef(name, identity) {
        Some(d) => Array::push(extra, d),
        None => ()
      }
    } else {
      ()
    }
  }
  if Array::length(extra) == 0 {
    defs
  } else {
    let out = Array::slice(defs, 0, Array::length(defs))
    for d in extra {
      Array::push(out, d)
    }
    out
  }
}

let hce_reference_prefix: String = "#typeref-def:"

/// Every type reference marker bound in `env`, as (type name, identity),
/// nearest first.
fn hce_reference_rows(env: TypeEnv) -> Array[(String, Type)] {
  let rows: Array[(String, Type)] = array_empty()
  let plen = String::length(hce_reference_prefix)
  let mut current = env
  let mut done = false
  while !done {
    match current {
      EnvBind(name, binding, rest) => {
        if String::starts_with(name, hce_reference_prefix) {
          Array::push(rows, (name[plen: String::length(name)], binding.ty))
        } else {
          ()
        }
        current = rest
      },
      EnvFlat(bindings) => {
        for entry in bindings {
          let (name, binding) = entry
          if String::starts_with(name, hce_reference_prefix) {
            Array::push(rows, (name[plen: String::length(name)], binding.ty))
          } else {
            ()
          }
        }
        done = true
      },
      EnvShowWrappers(_, _, rest) => current = rest,
      EnvTraitDef(_, _, _, _, rest, _, _) => current = rest,
      EnvTraitImpl(_, _, rest) => current = rest,
      EnvTraitImplGen(_, _, _, _, rest) => current = rest,
      EnvTypeDefs(_, _, rest) => current = rest,
      EnvMutCell(_, _, rest) => current = rest,
      EnvCached(_, _, rest) => current = rest,
      EnvEmpty => done = true
    }
  }
  rows
}

/// The declaration a type reference marker's identity spells: `(head,
/// definition[, mutable fields])`, the head naming the kind and carrying the
/// formals by position, which the definition refers to by those names.
fn hce_reference_typedef(name: String, identity: Type) -> Option[TypeDef] {
  match identity {
    CtTuple(parts) => if Array::length(parts) >= 2 {
      match Array::get(parts, 0) {
        CtNamed(head, formals) => {
          let params: Array[String] = array_empty()
          for f in formals {
            match f {
              CtNamed(p, _) => Array::push(params, p),
              _ => ()
            }
          }
          match Array::get(parts, 1) {
            CtRecord(items) => if String::starts_with(head, "#typeid.struct.") {
              let muts: Array[String] = array_empty()
              if Array::length(parts) >= 3 {
                match Array::get(parts, 2) {
                  CtTuple(ms) => for m in ms {
                    match m {
                      CtNamed(mn, _) => Array::push(muts, mn),
                      _ => ()
                    }
                  },
                  _ => ()
                }
              } else {
                ()
              }
              Some(TDStruct(name, items, muts, params))
            } else if String::starts_with(head, "#typeid.enum.") {
              let variants: Array[(String, Array[Type])] = array_empty()
              for v in items {
                let (vname, payload) = v
                match payload {
                  CtTuple(ps) => Array::push(variants, (vname, ps)),
                  _ => Array::push(variants, (vname, [payload]))
                }
              }
              Some(TDEnum(name, params, variants))
            } else if String::starts_with(head, "#typeid.type.") {
              Some(TDAlias(name, params, CtRecord(items)))
            } else {
              None
            },
            target => if String::starts_with(head, "#typeid.type.") {
              Some(TDAlias(name, params, target))
            } else {
              None
            }
          }
        },
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// Handles whose answer leaned on a declaration read before its body was
/// checked, to be asked again by `hce_run_deferred`.
let hce_pending: Array[(Expr, Array[(Pat, Expr)], Type, TypeEnv, Array[TypeDef], Subst, Int)] = [
]

/// The module's final substitution while `hce_run_deferred` runs; empty
/// otherwise.
let hce_final: Array[Subst] = []

/// One entry for each call a declaration's body was read through without
/// the callee type its check records (see `hce_note_unsure`).
let hce_unsure: Array[Int] = []

/// Where the handles a module's check is about to defer begin.
export fn hce_deferred_mark() -> Int {
  Array::length(hce_pending)
}

/// Forget the handles deferred from `mark` on: the statements that deferred
/// them are being checked again.
export fn hce_drop_deferred(mark: Int) -> Unit {
  if Array::length(hce_pending) > mark {
    Array::truncate(hce_pending, mark)
  } else {
    ()
  }
}

/// Ask again, now that every declaration of the module is checked and has
/// recorded its callee types, about the handles deferred from `mark` on.
/// `final_s` is the module's final substitution, which the types recorded
/// after a handle was checked are read under.
export fn hce_run_deferred(mark: Int, final_s: Subst, errors: Array[String]) -> Unit {
  if Array::length(hce_pending) > mark {
    let entries = Array::slice(hce_pending, mark, Array::length(hce_pending))
    Array::truncate(hce_pending, mark)
    Array::push(hce_final, final_s)
    let found: Array[String] = array_empty()
    for entry in entries {
      let (body, arms, body_ty, env, defs, s, sites_from) = entry
      hce_refuse(body, arms, body_ty, env, defs, s, sites_from, found)
    }
    Array::truncate(hce_final, Array::length(hce_final) - 1)
    for msg in found {
      if !hce_has(errors, msg) {
        Array::push(errors, msg)
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

/// `ty`, read also under the module's final substitution while deferred
/// handles are asked again.
fn hce_late(ty: Type) -> Type {
  if Array::length(hce_final) > 0 {
    subst_apply(Array::get(hce_final, Array::length(hce_final) - 1), ty)
  } else {
    ty
  }
}

/// A declaration's body (`hce_decl_makes_bound`) calls through `spelling`
/// at `off`, and the checker recorded no callee type there. Before the
/// module is checked that may be only because the body is not checked yet,
/// so no answer read through it is final.
fn hce_note_unsure(off: Int, spelling: String) -> Unit {
  if Array::length(hce_decl_stack) > 0 && Array::length(hce_final) == 0 && hce_recorded_type(off, spelling) is None {
    Array::push(hce_unsure, 1)
  } else {
    ()
  }
}

fn hce_refuse(body: Expr, arms: Array[(Pat, Expr)], body_ty: Type, env: TypeEnv, defs0: Array[TypeDef], s: Subst, sites_from: Int, errors: Array[String]) -> Unit {
  // #1451: a closure literal also takes the rows the enclosing declaration's
  // result type declares for the function values it returns, and the caller
  // of such a value passes its own handler (`fn mid() -> (() -> Int with
  // Box[Int]) { handle { () -> mk() } with { .. } }` answers through the
  // handler around the call). An effect carried that way is not bound here
  // -- but only when the result IS that function type. A closure is not
  // told which position of a composite result it fills: a row-less slot
  // beside a `with Ask` one (`-> (() -> Int with Ask, () -> Int)`) took a
  // closure that kept this handle's evidence (`6`, from the dead handler),
  // and with both slots declaring the row the lowering gave the row to
  // neither (`null function or function signature mismatch`).
  let returned_rows = match env_lookup(env, "__return__") {
    Some(rt) => hce_result_fn_row(subst_apply(s, rt)),
    None => array_empty()
  }
  let labels = hce_without(hce_handled_bases(arms), returned_rows)
  if Array::length(labels) > 0 {
    let defs = hce_defs_with_env(defs0, env)
    let body_names: Array[String] = array_empty()
    hce_collect_let_names(body, body_names)
    let st = hce_new(labels, false, sites_from, body_names)
    hce_walk(body, st, env, defs, s)
    let mut reach = 0
    let mut pick = 0 - 1
    let mut pi = 0
    while pi < Array::length(st.producers) {
      let (_, _, _, preach) = Array::get(st.producers, pi)
      if preach > reach {
        reach = preach
        pick = pi
      } else {
        ()
      }
      pi = pi + 1
    }
    if reach > 0 {
      let (what, off, label, _) = Array::get(st.producers, pick)
      // A route the body spells is named first: a body ending in `return h`
      // has an open type of its own, which the value route would also read.
      let routes = hce_new(labels, true, sites_from, body_names)
      hce_walk(body, routes, env, defs, s)
      let mut route = ""
      let mut roff = 0 - 1
      for r in routes.routes {
        let (rwhat, rat, rneed) = r
        if route == "" && rneed <= reach {
          route = rwhat
          roff = rat
        } else {
          ()
        }
      }
      if route != "" {
        Array::push(errors, hce_message(what, label, route, if roff >= 0 {
          roff
        } else {
          off
        }))
      } else if reach >= 2 && hce_holds_fn(subst_apply(s, body_ty), defs, array_empty()) {
        Array::push(errors, hce_message(what, label, "returning it as the handle's value", off))
      } else if Array::length(routes.keeps) > 0 {
        let (kwhat, kat, klabel) = Array::get(routes.keeps, 0)
        Array::push(errors, hce_message(what, klabel, kwhat, if kat >= 0 {
          kat
        } else {
          off
        }))
      } else {
        ()
      }
    } else {
      ()
    }
  } else {
    ()
  }
}

fn hce_new(labels: Array[String], find_routes: Bool, sites_from: Int, body_names: Array[String]) -> HceWalk {
  HceWalk::{
    labels: labels,
    scope: array_empty(),
    performs: array_empty(),
    producers: array_empty(),
    pos: 2,
    mentions: 0,
    mention_label: "",
    find_routes: find_routes,
    fn_depth: 0,
    routes: array_empty(),
    keeps: array_empty(),
    sites_from: sites_from,
    body_names: body_names
  }
}

fn hce_message(what: String, set: String, route: String, off: Int) -> String {
  let named: Array[String] = array_empty()
  let mut throws = false
  for l in hce_set_items(set) {
    if is_exception_effect_name(l) {
      throws = true
    } else {
      Array::push(named, String::concat("`", String::concat(l, "`")))
    }
  }
  let performs = String::concat("performs ", String::join(named, " and "))
  let verb = if throws && Array::length(named) == 0 {
    "throws, and this `handle` catches it"
  } else if throws {
    String::concat("throws and ", String::concat(performs, ", and this `handle` catches and answers them"))
  } else if Array::length(named) > 1 {
    String::concat(performs, ", and this `handle` answers them")
  } else {
    String::concat(performs, ", and this `handle` answers it")
  }
  // #3599: for a callee with no body to read, `what` is `any closure in
  // what <callee> returns`, and the reason says the throw is assumed.
  let reason = if String::starts_with(what, hce_unread_prefix()) && throws && Array::length(named) == 0 {
    let callee = what[String::length(hce_unread_prefix()): String::length(what) - String::length(" returns")]
    String::concat(callee, " has no body this check can read, so a closure in what it returns may throw, and this `handle` catches it")
  } else {
    String::concat(what, String::concat(" ", verb))
  }
  let edit = String::concat("call ", String::concat(what, String::concat(" inside this `handle` and keep only what it computes, or move the `handle` into the closure (`() -> handle { .. } with { .. }`) -- ", reason)))
  let why = String::concat(" only while the handled body runs, so ", String::concat(route, " leaves it with no handler to call"))
  String::concat(edit, String::concat(why, off_marker(off)))
}

/// How a value produced by a callee with no body to read is named.
fn hce_unread_prefix() -> String {
  "any closure in what "
}

/// The row labels of `ty` when it is a function type; none otherwise.
fn hce_result_fn_row(ty: Type) -> Array[String] {
  let labels: Array[String] = array_empty()
  match ty {
    CtForAll(_, _, inner) => hce_result_fn_row(inner),
    CtFn(_, _, Some(r)) => {
      for raw in String::split(r, ",") {
        let l = String::trim(raw)
        if String::length(l) > 0 && !String::starts_with(l, "#") {
          Array::push(labels, l)
        } else {
          ()
        }
      }
      labels
    },
    _ => labels
  }
}

/// The base of every effect an arm of the handle discharges.
fn hce_handled_bases(arms: Array[(Pat, Expr)]) -> Array[String] {
  let out = array_empty()
  for arm in arms {
    let (pat, _) = arm
    match pat {
      PCtor(name, _) => if String::index_of(name, "::") > 0 {
        hce_add(out, row_label_base(effect_name_of_op(name)))
      } else {
        ()
      },
      _ => ()
    }
  }
  out
}

fn hce_add(out: Array[String], label: String) -> Unit {
  if !hce_has(out, label) {
    Array::push(out, label)
  } else {
    ()
  }
}

fn hce_has(items: Array[String], label: String) -> Bool {
  let mut found = false
  for item in items {
    if item == label {
      found = true
    } else {
      ()
    }
  }
  found
}

/// #3585: the effect bases a handle-bound value performs that the handle
/// answers, written as one set (`Ask,Log`; "" for none). A destination's row
/// discharges only the bases it names, and the value stays handle-bound
/// while any is left.
fn hce_set_items(set: String) -> Array[String] {
  let out = array_empty()
  if String::length(set) > 0 {
    for l in String::split(set, ",") {
      if String::length(l) > 0 {
        hce_add(out, l)
      } else {
        ()
      }
    }
  } else {
    ()
  }
  out
}

fn hce_set_union(a: String, b: String) -> String {
  if a == "" {
    b
  } else if b == "" {
    a
  } else {
    let items = hce_set_items(a)
    for l in hce_set_items(b) {
      hce_add(items, l)
    }
    String::join(items, ",")
  }
}

/// `set` without the bases the parameter type `pt` takes (see
/// `hce_param_takes_row`).
fn hce_set_untaken(set: String, pt: Type) -> String {
  let left = array_empty()
  for l in hce_set_items(set) {
    if !hce_param_takes_row(pt, l) {
      Array::push(left, l)
    } else {
      ()
    }
  }
  String::join(left, ",")
}

/// `labels` without the bases of `row` (a row label may be an operation,
/// `Ask::Get`, or a kinded exception, `Exception[String]`).
fn hce_without(labels: Array[String], row: Array[String]) -> Array[String] {
  let drop = array_empty()
  for l in row {
    if !label_is_effect_var(l) {
      hce_add(drop, row_label_base(effect_name_of_op(l)))
    } else {
      ()
    }
  }
  if Array::length(drop) == 0 {
    labels
  } else {
    let out = array_empty()
    for l in labels {
      if !hce_has(drop, l) {
        Array::push(out, l)
      } else {
        ()
      }
    }
    out
  }
}

/// The first of `labels` a function type's row names, or "".
fn hce_row_label(ty: Type, labels: Array[String]) -> String {
  let found = hce_row_labels(ty, labels)
  if Array::length(found) > 0 {
    Array::get(found, 0)
  } else {
    ""
  }
}

/// Every one of `labels` a function type's row names.
fn hce_row_labels(ty: Type, labels: Array[String]) -> Array[String] {
  let found = array_empty()
  match ty {
    CtForAll(_, _, inner) => hce_row_labels(inner, labels),
    CtFn(_, _, Some(row)) => {
      for raw in String::split(row, ",") {
        let l = String::trim(raw)
        if String::length(l) > 0 && !String::starts_with(l, "#") && !label_is_effect_var(l) {
          let base = row_label_base(effect_name_of_op(l))
          if hce_has(labels, base) {
            hce_add(found, base)
          } else {
            ()
          }
        } else {
          ()
        }
      }
      found
    },
    _ => found
  }
}

fn hce_fn_result(ty: Type) -> Option[Type] {
  match ty {
    CtForAll(_, _, inner) => hce_fn_result(inner),
    CtFn(_, ret, _) => Some(ret),
    _ => None
  }
}

/// The innermost binding of `name` in the handled body: 0 when the body does
/// not bind it, 1 when it binds it to a plain value, 2 to a handle-bound one.
fn hce_lookup(st: HceWalk, name: String) -> Int {
  let i = hce_scope_index(st, name)
  if i < 0 {
    0
  } else {
    let (_, label, _) = Array::get(st.scope, i)
    if label == "" {
      1
    } else {
      2
    }
  }
}

fn hce_scope_index(st: HceWalk, name: String) -> Int {
  let mut i = Array::length(st.scope) - 1
  let mut found = 0 - 1
  while i >= 0 && found < 0 {
    let (n, _, _) = Array::get(st.scope, i)
    if n == name {
      found = i
    } else {
      ()
    }
    i = i - 1
  }
  found
}

/// The effect base a handle-bound local holds.
fn hce_local_label(st: HceWalk, name: String) -> String {
  let i = hce_scope_index(st, name)
  if i < 0 {
    ""
  } else {
    let (_, label, _) = Array::get(st.scope, i)
    label
  }
}

fn hce_bind(st: HceWalk, name: String, label: String) -> Unit {
  Array::push(st.scope, (hce_param_base(name), label, ""))
}

/// #3596: the declarations the binding of `name` stands for, comma-joined
/// (see `hce_alias_decls`): read from the handled body's binding when it
/// binds `name`, else from the binding `env` holds.
fn hce_name_decls(st: HceWalk, name: String, env: TypeEnv) -> String {
  let i = hce_scope_index(st, name)
  if i < 0 {
    hce_outer_decls(env, name)
  } else {
    let (_, _, decls) = Array::get(st.scope, i)
    decls
  }
}

/// #3596: the declarations a `let` initializer `val` stands for when it
/// names a function -- a plain alias (`let g = mk`, `let h = g`), or each
/// branch of a conditional one (`let g = if c { mk } else { mk_ok }`) --
/// comma-joined, "" when it names none. Read the way the marker of a `let`
/// before the handle is (`retention_alias_names`, which sees through an
/// annotation, parentheses and a block's tail); a branch that names no
/// function beside one that does adds `hce_unknown_decl`.
fn hce_alias_decls(val: Expr, st: HceWalk, env: TypeEnv) -> String {
  let mut out = ""
  for n in retention_alias_names(val) {
    out = hce_set_union(out, if n == hce_unknown_decl() {
      n
    } else {
      hce_name_decls(st, n, env)
    })
  }
  out
}

/// The declaration an alias stands for when one of the places its value
/// can come from names no function (`if c { mk } else { pick() }`): it may
/// be any, so it is taken to create a closure that can leave it.
fn hce_unknown_decl() -> String {
  "?"
}

/// #3596: the declarations the binding of `name` visible in `env` stands
/// for, comma-joined: `name` itself when it is bound at module level; what a
/// local alias names -- through an alias of an alias, and each branch of a
/// conditional one, each read where that alias was written (the marker
/// `retention_bind_let` lays in front of it), so a later binding of the
/// spelling hides it -- and none for any other local binding (a parameter,
/// a closure literal, a call's result).
///
/// The chain is followed to its end, however long: each hop reads the
/// environment below the alias's own binding (`retention_closure_scope`), a
/// strict suffix of the one before, so it cannot cycle. A depth cap here
/// answered "names none" for a finite chain one alias past it, and the call
/// through the last alias went unrefused.
fn hce_outer_decls(env: TypeEnv, name: String) -> String {
  match env_marker_before(env, retention_marker(name), name) {
    Some(CtNamed(text, _)) => if String::starts_with(text, "a:") || String::starts_with(text, "o:") {
      match retention_closure_scope(env, name, text) {
        Some(def_env) => {
          let mut out = ""
          for src in String::split(String::substring(text, 2, String::length(text)), ",") {
            out = hce_set_union(out, if src == hce_unknown_decl() {
              src
            } else {
              hce_outer_decls(def_env, src)
            })
          }
          out
        },
        None => ""
      }
    } else {
      ""
    },
    Some(_) => "",
    None => if retention_name_scope(env, name) == 1 {
      ""
    } else {
      name
    }
  }
}

/// A parameter is written `x`, `x~` (labeled) or `x?` (optional).
fn hce_param_base(name: String) -> String {
  let n = String::length(name)
  if n > 0 {
    let last = String::byte_at(name, n - 1)
    if last == '~' || last == '?' {
      name[0: n - 1]
    } else {
      name
    }
  } else {
    name
  }
}

fn hce_bind_pat(st: HceWalk, pat: Pat) -> Unit {
  let names = array_empty()
  collect_pat_binds_into(pat, names)
  for n in names {
    hce_bind(st, n, "")
  }
  ()
}

fn hce_count_perform(st: HceWalk, label: String, off: Int) -> Unit {
  Array::push(st.performs, (off, label))
}

/// Walk `e` in the handled body.
fn hce_walk(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let pos = st.pos
  st.pos = 2
  let performed = dh_perform_effect(e)
  if String::length(performed) > 0 {
    let label = canonical_exception_effect_name(row_label_base(performed))
    if hce_has(st.labels, label) {
      hce_count_perform(st, label, railway_expr_off(e))
    } else {
      ()
    }
  } else {
    ()
  }
  match e {
    EIdent(name, _) => if hce_lookup(st, name) == 2 {
      st.mentions = st.mentions + 1
      st.mention_label = hce_set_union(st.mention_label, hce_local_label(st, name))
    } else {
      ()
    },
    EFn(_, _, params, _, eff, fbody) => {
      let saved = st.labels
      st.labels = hce_without(saved, effect_row_labels(effect_row_parse(eff)))
      let before = Array::length(st.performs)
      let mark = Array::length(st.scope)
      for p in params {
        let (pname, _) = p
        hce_bind(st, pname, "")
      }
      st.fn_depth = st.fn_depth + 1
      hce_walk(fbody, st, env, defs, s)
      st.fn_depth = st.fn_depth - 1
      Array::truncate(st.scope, mark)
      st.labels = saved
      if Array::length(st.performs) > before {
        // Every effect the closure performs, not only the first (#3585).
        let (poff, _) = Array::get(st.performs, before)
        let mut set = ""
        let mut qi = before
        while qi < Array::length(st.performs) {
          let (_, qlabel) = Array::get(st.performs, qi)
          set = hce_set_union(set, qlabel)
          qi = qi + 1
        }
        Array::push(st.producers, ("the closure", poff, set, pos))
      } else {
        ()
      }
    },
    ELet(name, val, rest, off) => hce_walk_let(name, val, rest, off, st, env, defs, s, false),
    ELetMut(name, val, rest, off) => hce_walk_let(name, val, rest, off, st, env, defs, s, false),
    ELetRec(name, val, rest) => hce_walk_let(name, val, rest, 0 - 1, st, env, defs, s, true),
    EAssign(name, val, rest, off) => {
      hce_walk(val, st, env, defs, s)
      hce_note_outer_write(st, name, off, env, defs, s)
      hce_walk(rest, st, env, defs, s)
    },
    EAssignOp(name, _, val, rest, off) => {
      hce_walk(val, st, env, defs, s)
      hce_note_outer_write(st, name, off, env, defs, s)
      hce_walk(rest, st, env, defs, s)
    },
    EHandle(hbody, harms) => {
      let saved = st.labels
      let inner = hce_handled_bases(harms)
      st.labels = hce_without(saved, inner)
      hce_walk(hbody, st, env, defs, s)
      st.labels = saved
      for arm in harms {
        let (pat, abody) = arm
        let mark = Array::length(st.scope)
        hce_bind_pat(st, pat)
        hce_bind(st, "resume", "")
        hce_walk(abody, st, env, defs, s)
        Array::truncate(st.scope, mark)
      }
      ()
    },
    EMatch(scrutinee, marms) => {
      hce_walk(scrutinee, st, env, defs, s)
      for arm in marms {
        let (pat, abody) = arm
        let mark = Array::length(st.scope)
        hce_bind_pat(st, pat)
        hce_walk(abody, st, env, defs, s)
        Array::truncate(st.scope, mark)
      }
      ()
    },
    EForIn(name, index_name, iter, fbody) => {
      hce_walk(iter, st, env, defs, s)
      let mark = Array::length(st.scope)
      hce_bind(st, name, "")
      match index_name {
        Some(n) => hce_bind(st, n, ""),
        None => ()
      }
      hce_walk(fbody, st, env, defs, s)
      Array::truncate(st.scope, mark)
    },
    ELoop(lparams, lbody) => {
      for p in lparams {
        let (_, init) = p
        hce_walk(init, st, env, defs, s)
      }
      let mark = Array::length(st.scope)
      for p in lparams {
        let (pname, _) = p
        hce_bind(st, pname, "")
      }
      hce_walk(lbody, st, env, defs, s)
      Array::truncate(st.scope, mark)
    },
    ECall(callee, args, off, _) => if hce_is_paren(e) {
      // `$source_span` wraps a parenthesized expression; it is that
      // expression, in the same position.
      let mut wi = 0
      while wi < Array::length(args) {
        st.pos = if wi == 0 {
          pos
        } else {
          2
        }
        hce_walk(Array::get(args, wi), st, env, defs, s)
        wi = wi + 1
      }
    } else {
      hce_note_call(callee, args, off, pos, st, env, defs, s)
      // A callee is applied where it is written: a closure literal there
      // (`(() -> perform E::Op())()`) never leaves.
      st.pos = 0
      hce_walk(callee, st, env, defs, s)
      let arg_reach = hce_arg_reach(callee, st, env, defs, s)
      let mut ai = 0
      for arg in args {
        let producers_before = Array::length(st.producers)
        st.pos = hce_beside_local(arg_reach, args, ai, st, env)
        hce_walk(arg, st, env, defs, s)
        // A closure handed to a parameter whose row names its effect (or a
        // row variable) takes that row there, and so does every closure
        // written inside it: whoever calls them passes the handler.
        if Array::length(st.producers) > producers_before {
          match hce_param_type(callee, off, arg, ai, Array::length(args), st, env, s) {
            Some(pt) => hce_drop_row_taken(st, producers_before, pt),
            None => ()
          }
        } else {
          ()
        }
        // #3594: reading a declaration for a row variable, a call handed a
        // parameter that performs it (`() -> apply(g)`) may call it.
        if hce_poly_walk(st) && !hce_callee_is_ctor(callee, defs) {
          let handed = hce_arg_bound_label(arg, producers_before, st, env, defs, s)
          if handed != "" {
            hce_count_perform(st, handed, railway_expr_off(arg))
          } else {
            ()
          }
        } else {
          ()
        }
        if st.find_routes {
          let label = hce_arg_bound_label(arg, producers_before, st, env, defs, s)
          if label != "" && hce_callee_may_keep(callee, off, arg, ai, Array::length(args), label, st, env, defs, s) {
            let left = match hce_param_type(callee, off, arg, ai, Array::length(args), st, env, s) {
              Some(pt) => hce_set_untaken(label, pt),
              None => label
            }
            Array::push(st.keeps, (hce_keep_route(callee), railway_expr_off(arg), if left == "" {
              label
            } else {
              left
            }))
          } else {
            ()
          }
        } else {
          ()
        }
        ai = ai + 1
      }
      ()
    },
    ELabeledArg(_, _, inner) => {
      st.pos = pos
      hce_walk(inner, st, env, defs, s)
    },
    EReturn(value) => {
      if st.find_routes && st.fn_depth == 0 {
        let holds = match env_lookup(env, "__return__") {
          Some(rt) => hce_holds_fn(subst_apply(s, rt), defs, array_empty()),
          None => true
        }
        if holds {
          Array::push(st.routes, ("`return`ing it from inside the handle", railway_expr_off(value), 2))
        } else {
          ()
        }
      } else {
        ()
      }
      hce_walk(value, st, env, defs, s)
    },
    _ => hce_walk_children(e, st, env, defs, s)
  }
}

fn hce_walk_children(e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    hce_walk(expr_child_at(i), st, env, defs, s)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// A `let` binds its name to a handle-bound value when its initializer
/// produced one or names one. A value the initializer itself is (a closure
/// literal, a call's result) goes where the name's uses take it.
fn hce_walk_let(name: String, val: Expr, rest: Expr, off: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst, recursive: Bool) -> Unit {
  let mark = Array::length(st.scope)
  if recursive {
    hce_bind(st, name, "")
  } else {
    ()
  }
  let producers_before = Array::length(st.producers)
  let mentions_before = st.mentions
  let mentioned_before = st.mention_label
  st.mention_label = ""
  st.pos = hce_let_reach()
  hce_walk(val, st, env, defs, s)
  let bound = if Array::length(st.producers) > producers_before {
    let mut set = ""
    let mut bi = producers_before
    while bi < Array::length(st.producers) {
      let (_, _, blabel, _) = Array::get(st.producers, bi)
      set = hce_set_union(set, blabel)
      bi = bi + 1
    }
    set
  } else if st.mentions > mentions_before {
    st.mention_label
  } else {
    ""
  }
  st.mention_label = hce_set_union(mentioned_before, st.mention_label)
  let mut pi = producers_before
  let mut uses = 0 - 1
  while pi < Array::length(st.producers) {
    let (pwhat, poff, plabel, preach) = Array::get(st.producers, pi)
    if preach == hce_let_reach() {
      if uses < 0 {
        uses = hce_name_reach(name, rest, st, env, defs, s)
        if recursive {
          let in_val = hce_name_reach(name, val, st, env, defs, s)
          if in_val > uses {
            uses = in_val
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      // Name the closure the program named.
      let (what, at) = match val {
        EFn(_, _, _, _, _, _) => (String::concat("`", String::concat(name, "`")), if off >= 0 {
          off
        } else {
          poff
        }),
        _ => (pwhat, poff)
      }
      Array::set(st.producers, pi, (what, at, plabel, uses))
    } else {
      ()
    }
    pi = pi + 1
  }
  Array::truncate(st.scope, mark)
  let decls = if bound == "" && !recursive {
    hce_alias_decls(val, st, env)
  } else {
    ""
  }
  Array::push(st.scope, (name, bound, decls))
  hce_walk(rest, st, env, defs, s)
  Array::truncate(st.scope, mark)
}

/// The reach marking a `let` initializer (see `HceWalk.pos`).
fn hce_let_reach() -> Int {
  3
}

/// Is `e` a parenthesized expression (`$source_span(inner, ..)`)?
fn hce_is_paren(e: Expr) -> Bool {
  match e {
    ECall(EIdent(wrapper, _), wargs, _, _) => wrapper == "$source_span" && Array::length(wargs) > 0,
    _ => false
  }
}

/// Where the uses of `name` in `e` can take its value: 0 when every use
/// calls it, 1 when some use hands it straight to a call that returns no
/// function, 2 otherwise. An inner binding of the same spelling is not told
/// apart, which can only answer higher.
fn hce_name_reach(name: String, e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  match e {
    EIdent(n, _) => if n == name {
      2
    } else {
      0
    },
    ECall(callee, args, _, _) => if hce_is_paren(e) {
      hce_name_reach_children(name, e, st, env, defs, s)
    } else {
      let mut r = if hce_names(callee, name) {
        0
      } else {
        hce_name_reach(name, callee, st, env, defs, s)
      }
      let mut ai = 0
      for arg in args {
        let ar = if hce_names(arg, name) {
          hce_beside_local(hce_arg_reach(callee, st, env, defs, s), args, ai, st, env)
        } else {
          hce_name_reach(name, arg, st, env, defs, s)
        }
        if ar > r {
          r = ar
        } else {
          ()
        }
        ai = ai + 1
      }
      r
    },
    _ => hce_name_reach_children(name, e, st, env, defs, s)
  }
}

fn hce_name_reach_children(name: String, e: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut r = 0
  let mut i = mark
  while i < top && r < 2 {
    let cr = hce_name_reach(name, expr_child_at(i), st, env, defs, s)
    if cr > r {
      r = cr
    } else {
      ()
    }
    i = i + 1
  }
  expr_children_pop(mark)
  r
}

/// Is `e` the bare name `name` (possibly labeled or parenthesized)?
fn hce_names(e: Expr, name: String) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    ELabeledArg(_, _, inner) => hce_names(inner, name),
    ECall(_, wargs, _, _) => hce_is_paren(e) && hce_names(Array::get(wargs, 0), name),
    _ => false
  }
}

/// The reach of argument `ai` of a call, given the callee's (`reach`): a
/// value the call cannot return (1) may still be stored into another of its
/// arguments, and when that argument is rooted at a binding of the handled
/// body (`Array::push(xs, h)` with `let xs = []` in the body), the value
/// lives on in that binding and goes wherever it goes (2). A binding outside
/// the body is a write route of its own.
fn hce_beside_local(reach: Int, args: Array[Expr], ai: Int, st: HceWalk, env: TypeEnv) -> Int {
  if reach != 1 {
    reach
  } else {
    let mut out = reach
    let mut j = 0
    while j < Array::length(args) {
      if j != ai {
        match hce_root_name(Array::get(args, j)) {
          Some((root, _)) => if hce_lookup(st, root) != 0 || hce_has(st.body_names, root) || env_lookup(env, root) is None {
            out = 2
          } else {
            ()
          },
          None => ()
        }
      } else {
        ()
      }
      j = j + 1
    }
    out
  }
}

/// Every name a `let` in `e` binds.
fn hce_collect_let_names(e: Expr, out: Array[String]) -> Unit {
  match e {
    ELet(name, _, _, _) => hce_add(out, name),
    ELetMut(name, _, _, _) => hce_add(out, name),
    ELetRec(name, _, _) => hce_add(out, name),
    _ => ()
  }
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    hce_collect_let_names(expr_child_at(i), out)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// The reach of a value handed straight to a call of `callee`: 1 when the
/// callee is a function declared outside the handled body whose result
/// type cannot hold a function (its result cannot be the value, though the
/// call might store it), 2 otherwise.
fn hce_arg_reach(callee: Expr, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Int {
  match callee {
    EIdent(name, _) => if hce_lookup(st, name) == 0 {
      match env_lookup(env, name) {
        Some(ty) => match hce_fn_result(ty) {
          Some(ret) => if hce_holds_fn(subst_apply(s, ret), defs, array_empty()) {
            2
          } else {
            1
          },
          None => 2
        },
        None => 2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// A call performs a counted effect when its callee is a handle-bound local
/// or a function whose row names one. Its result is handle-bound when such a
/// function's result type can hold a function. In the routes pass, an
/// argument rooted at a binding declared outside the body that can store a
/// function is a write out of the handle.
fn hce_note_call(callee: Expr, args: Array[Expr], off: Int, pos: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  match callee {
    EIdent(name, noff) => {
      let local = hce_lookup(st, name)
      let at = if off >= 0 {
        off
      } else {
        noff
      }
      if local == 2 {
        hce_count_perform(st, hce_local_label(st, name), at)
      } else if local == 1 && off >= 0 && Array::length(st.labels) > 0 {
        // A plain local holding a function (`let f = ask`, an alias of an
        // alias, a method value): the type the checker inferred for the
        // callee at this call (#3539).
        // An alias of a declaration is followed to it (#3596).
        match hce_site_type(st, off, name, s) {
          Some(ty) => hce_note_callee(st, ty, name, hce_name_decls(st, name, env), at, pos, env, defs, s),
          None => hce_note_unsure(off, name)
        }
      } else if local == 0 && name != "perform" && Array::length(st.labels) > 0 {
        match env_lookup(env, name) {
          Some(ty) => {
            // A declaration not inferred yet has no row to read.
            match subst_apply(s, ty) {
              CtVar(_) => hce_note_unsure(0 - 1, name),
              _ => ()
            }
            // A row-polymorphic callee (`forward[e](g: () -> Int with e)`)
            // performs what this call instantiates its row variables to: the
            // type the checker recorded here.
            let cty = if off >= 0 && hce_row_has_var(ty) {
              match hce_site_type(st, off, name, s) {
                Some(t) => t,
                None => ty
              }
            } else {
              ty
            }
            // A local `let` before the handle that aliases a declaration
            // stands for it; any other local names none (#3596).
            hce_note_callee(st, cty, name, hce_outer_decls(env, name), at, pos, env, defs, s)
          },
          None => ()
        }
      } else {
        ()
      }
    },
    // A method call (`foo.mk()`, `foo.me().mk()`) or a call through any
    // other expression: the type of the callee the checker resolved there
    // (#3539).
    _ => if off >= 0 && Array::length(st.labels) > 0 {
      match hce_namespace_callee(callee, st, env) {
        // `ns.mk()` through a qualified-import namespace calls the import
        // `ns.mk` by name (#3593).
        Some(qualified) => match env_lookup(env, qualified) {
          Some(ty) => hce_note_callee(st, ty, qualified, qualified, off, pos, env, defs, s),
          None => ()
        },
        None => {
          let spelling = call_callee_spelling(callee)
          match hce_site_type(st, off, spelling, s) {
            Some(ty) => {
              let decl = hce_method_decl(callee, ty, env, s)
              // A function-typed field is named as written (`fac.mk`): its
              // own name may be a declaration's too (#3599).
              let shown = match callee {
                EDot(EIdent(recv, _), m, _, _) => if decl == "" {
                  String::concat(recv, String::concat(".", m))
                } else {
                  spelling
                },
                _ => spelling
              }
              hce_note_callee(st, ty, shown, decl, off, pos, env, defs, s)
            },
            None => hce_note_unsure(off, spelling)
          }
        }
      }
    } else {
      ()
    }
  }
  if st.find_routes {
    for arg in args {
      match hce_root_name(arg) {
        Some((root, roff)) => if hce_lookup(st, root) == 0 {
          match env_lookup(env, root) {
            Some(ty) => if hce_stores_fn(subst_apply(s, ty), defs, array_empty()) {
              Array::push(st.routes, (String::concat("handing it to a call that may store it in `", String::concat(root, "`, which is declared outside the handle,")), roff, 1))
            } else {
              ()
            },
            None => ()
          }
        } else {
          ()
        },
        None => ()
      }
    }
    ()
  } else {
    ()
  }
}

/// `ns.m` when `callee` is `ns.m` and `ns` names a qualified-import
/// namespace rather than a value (the checker calls the import `ns.m`).
fn hce_namespace_callee(callee: Expr, st: HceWalk, env: TypeEnv) -> Option[String] {
  match callee {
    EDot(EIdent(ns, _), m, _, _) => if hce_lookup(st, ns) == 0 && env_lookup(env, ns) is None {
      let qualified = String::concat(ns, String::concat(".", m))
      match env_lookup(env, qualified) {
        Some(_) => Some(qualified),
        None => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3593: the declaration a method call `recv.m(..)` resolved to -- the
/// checker calls `T::m` for a receiver of type `T`, the recorded callee
/// type's first parameter -- or "" when it calls a function-typed field or
/// anything else that names no declaration.
fn hce_method_decl(callee: Expr, ty: Type, env: TypeEnv, s: Subst) -> String {
  match callee {
    EDot(_, m, _, _) => match hce_fn_params(hce_late(subst_apply(s, ty))) {
      Some(params) => if Array::length(params) > 0 {
        let prefix = type_name_prefix(hce_late(subst_apply(s, Array::get(params, 0))))
        let qualified = String::concat(prefix, String::concat("::", m))
        if prefix != "" && env_lookup(env, qualified) is Some(_) {
          qualified
        } else {
          ""
        }
      } else {
        ""
      },
      None => ""
    },
    _ => ""
  }
}

/// A call at `at` whose callee, spelled `spelling`, has type `ty`: it
/// performs every counted effect the callee's row names, and its result is
/// handle-bound for each one it can hold a function without -- the closure
/// it returns inherited the row of this call. However the callee is reached
/// (a name, a local alias, a method), the same type decides. `decl` names
/// the declarations outside the body the callee stands for, comma-joined
/// (more than one through a conditional alias, #3596), else "".
fn hce_note_callee(st: HceWalk, ty: Type, spelling: String, decl: String, at: Int, pos: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  let found = hce_row_labels(ty, st.labels)
  if Array::length(found) > 0 {
    let mut performed = ""
    let mut bound = ""
    let mut guessed = false
    for label in found {
      performed = hce_set_union(performed, label)
      // An exception row counts the function values the result type spells
      // -- the result itself, or one inside a tuple, array, `Option`,
      // record or type argument. Inside the fields of a declared type it
      // counts them only when the callee's body creates a closure that
      // throws and can leave it (#3584): a function that may throw and
      // returns compiler state or a table holding callbacks (a `MutMap`'s
      // hash function) is common, and following every field refused nine
      // handles in the compiler itself. A declaration of another module
      // answers by the fact its module published (#3593), whose fields this
      // module may not see. A callee whose row has `label` only through a
      // row variable this call instantiates answers by whether its body
      // creates such a closure performing that variable (#3594).
      let holds = if is_exception_effect_name(label) {
        let ret = subst_apply(s, ret_or_unit(hce_fn_result(ty)))
        let mut made = hce_spells_fn_without(ret, label, defs, array_empty())
        for d in hce_set_items(decl) {
          if !made && (hce_holds_fn_without(ret, label, defs, array_empty()) || retention_decl_value(d) is None) && (hce_decl_makes_bound(d, label, env, defs, s) || hce_decl_makes_bound_via_var(d, ty, label, env, defs, s)) {
            made = true
            guessed = hce_decl_unread(d)
          } else {
            ()
          }
        }
        // #3599: a callee that names no declaration -- a parameter, a local
        // bound to a call's result, a function-typed field -- has no body to
        // read, so a closure inside a declared type's field of its result is
        // taken to throw.
        if !made && decl == "" && hce_holds_fn_without(ret, label, defs, array_empty()) {
          made = true
          guessed = true
        } else {
          ()
        }
        made
      } else {
        match hce_fn_result(ty) {
          Some(ret) => hce_holds_fn_without(subst_apply(s, ret), label, defs, array_empty()),
          None => false
        }
      }
      if holds {
        bound = hce_set_union(bound, label)
      } else {
        ()
      }
    }
    hce_count_perform(st, performed, at)
    match hce_fn_result(ty) {
      Some(_) => if bound != "" {
        let callee = if spelling == "" {
          "this call's callee"
        } else {
          String::concat("`", String::concat(spelling, "`"))
        }
        let what = if guessed {
          String::concat(hce_unread_prefix(), String::concat(callee, " returns"))
        } else if spelling == "" {
          "the closure this call returns"
        } else {
          String::concat("the closure ", String::concat(callee, " returns"))
        }
        Array::push(st.producers, (what, at, bound, pos))
      } else {
        ()
      },
      None => ()
    }
  } else {
    ()
  }
}

/// The callee type the checker recorded for the call at `off` among the
/// calls the handled body recorded: the first whose row names a counted
/// label.
fn hce_site_type(st: HceWalk, off: Int, spelling: String, s: Subst) -> Option[Type] {
  let mut found: Option[Type] = None
  let mut hit = false
  let mut i = st.sites_from
  let n = Array::length(call_callee_sites)
  while !hit && i < n {
    let (soff, sp, ty) = Array::get(call_callee_sites, i)
    if soff == off && sp == spelling {
      let t = hce_late(subst_apply(s, ty))
      if hce_row_label(t, st.labels) != "" {
        found = Some(t)
        hit = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does the function literal `f`, the value (or one of the values) of the
/// declaration `name`, create a closure that performs `label` and can leave
/// it? Its body is walked the way a handled body is.
fn hce_literal_makes_bound(name: String, label: String, f: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  match f {
    EFn(_, _, params, _, _, fbody) => {
      let names: Array[String] = array_empty()
      hce_collect_let_names(fbody, names)
      let st = hce_new([label], false, 0, names)
      // #3594: read for a row variable (`label` is `e`), a parameter
      // whose function type's row is `e` performs it when called.
      let declared = if label_is_effect_var(label) {
        match env_lookup(env, name) {
          Some(t) => match hce_fn_params(t) {
            Some(ps) => ps,
            None => array_empty()
          },
          None => array_empty()
        }
      } else {
        array_empty()
      }
      let mut pi = 0
      for p in params {
        let (pname, _) = p
        hce_bind(st, pname, if pi < Array::length(declared) && hce_row_names_var(Array::get(declared, pi), label) {
          label
        } else {
          ""
        })
        pi = pi + 1
      }
      hce_walk(fbody, st, env, defs, s)
      let mut made = false
      for p in st.producers {
        let (_, _, plabel, preach) = p
        if preach > 0 && hce_has(hce_set_items(plabel), label) {
          made = true
        } else {
          ()
        }
      }
      made
    },
    _ => false
  }
}

/// Is `callee` the parser's spelling of an annotation (`e: T`)?
fn hce_is_ascription(callee: Expr) -> Bool {
  match ascription_lambda_ann(callee) {
    Some(_) => true,
    None => false
  }
}

/// The function literals (`lits`) and the declarations (`srcs`) the value
/// `e` of a top-level function-typed `let` may be, and whether every place
/// its value can come from was read. Read the way `retention_alias_sources`
/// reads an alias, with a literal as one more source: each branch of an
/// `if` or a `match`, a block's tail, under an annotation or parentheses. A
/// literal under a `let` of a block, or in a `match` arm that binds, may
/// close over what those bind, which a walk of its body does not see, so it
/// leaves the reading incomplete.
fn hce_decl_sources(e: Expr, lits: Array[Expr], srcs: Array[String]) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => {
      Array::push(lits, e)
      true
    },
    EIdent(src, _) => {
      Array::push(srcs, src)
      true
    },
    EIf(_, a, b) => {
      let ca = hce_decl_sources(a, lits, srcs)
      let cb = hce_decl_sources(b, lits, srcs)
      ca && cb
    },
    EMatch(_, arms) => {
      let mut complete = true
      for arm in arms {
        let bound: Array[String] = array_empty()
        retention_pat_names_into(arm.0, bound)
        let found_lits: Array[Expr] = array_empty()
        let found: Array[String] = array_empty()
        if !hce_decl_sources(arm.1, found_lits, found) {
          complete = false
        } else {
          ()
        }
        if Array::length(bound) > 0 && Array::length(found_lits) > 0 {
          complete = false
        } else {
          for f in found_lits {
            Array::push(lits, f)
          }
        }
        for src in found {
          if hce_has(bound, src) {
            complete = false
          } else {
            Array::push(srcs, src)
          }
        }
      }
      complete
    },
    ESeq(_, b) => hce_decl_sources(b, lits, srcs),
    ELet(n, v, rest, _) => {
      let found_lits: Array[Expr] = array_empty()
      let found: Array[String] = array_empty()
      let mut complete = hce_decl_sources(rest, found_lits, found)
      if Array::length(found_lits) > 0 {
        complete = false
      } else {
        ()
      }
      for src in found {
        if src == n {
          if !hce_decl_sources(v, lits, srcs) {
            complete = false
          } else {
            ()
          }
        } else {
          Array::push(srcs, src)
        }
      }
      complete
    },
    ECall(callee, args, _, _) => if hce_is_paren(e) || Array::length(args) == 1 && hce_is_ascription(callee) {
      hce_decl_sources(Array::get(args, 0), lits, srcs)
    } else {
      false
    },
    _ => false
  }
}

/// The declarations `hce_decl_makes_bound` is reading, innermost last, and
/// one entry for each time it met one of them again.
let hce_decl_stack: Array[String] = []
let hce_decl_cycles: Array[Int] = []

/// #3584: does the declaration `name` of this module create a closure that
/// performs `label` and can leave it -- held in a field of the value it
/// returns (`Box::{ f: () -> throw(7) }`), say? Such a closure inherited the
/// row of the call, so the handle around the call is what answers it. Read
/// from the declaration's body, the way the handled body is: a declaration
/// whose fields hold only closures that do not perform `label` (a `MutMap`'s
/// hash function) answers no, and so does one this module does not hold.
fn hce_decl_makes_bound(name: String, label: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  let key = String::concat(name, String::concat("|", label))
  let mut known = 0 - 1
  let mut ki = 0
  while known < 0 && ki < Array::length(hce_decl_facts) {
    let (k, _) = Array::get(hce_decl_facts, ki)
    if k == key {
      known = ki
    } else {
      ()
    }
    ki = ki + 1
  }
  if name == hce_unknown_decl() {
    true
  } else if known >= 0 {
    let (_, made) = Array::get(hce_decl_facts, known)
    made
  } else if hce_has(hce_decl_stack, key) {
    // A cycle answers no while its first reading is under way; an answer
    // that leaned on it is not remembered.
    Array::push(hce_decl_cycles, 1)
    false
  } else {
    match retention_decl_value(name) {
      // The function literals and the declarations its value may be
      // (`hce_decl_sources`): `let make = () -> ..`, an alias of other
      // declarations (`let make = mk`, `let make: () -> Box with
      // Exception[Int] = mk`), or a choice between them (`let make = if c {
      // () -> .. } else { mk }`). One whose value may also come from
      // something it does not read may be any, and answers yes
      // (`hce_unknown_decl`), and so does one that reads nothing at all (a
      // call's result), like a local of that kind (#3599).
      Some(val) => {
        let lits: Array[Expr] = array_empty()
        let srcs: Array[String] = array_empty()
        if !hce_decl_sources(val, lits, srcs) {
          Array::push(srcs, hce_unknown_decl())
        } else {
          ()
        }
        let cycles_before = Array::length(hce_decl_cycles)
        let unsure_before = Array::length(hce_unsure)
        Array::push(hce_decl_stack, key)
        let mut made = false
        for f in lits {
          if !made && hce_literal_makes_bound(name, label, f, env, defs, s) {
            made = true
          } else {
            ()
          }
        }
        for src in srcs {
          if !made && src != name && hce_decl_makes_bound(src, label, env, defs, s) {
            made = true
          } else {
            ()
          }
        }
        Array::truncate(hce_decl_stack, Array::length(hce_decl_stack) - 1)
        if made || (Array::length(hce_decl_cycles) == cycles_before && Array::length(hce_unsure) == unsure_before) {
          Array::push(hce_decl_facts, (key, made))
        } else {
          ()
        }
        if Array::length(hce_decl_stack) == 0 {
          Array::truncate(hce_decl_cycles, 0)
        } else {
          ()
        }
        made
      },
      // #3593: a declaration of another module, by the fact its module
      // published (`hce_bind_module_summaries`).
      None => hce_imported_makes_bound(name, label, env)
    }
  }
}

/// #3599: is `name` a top-level binding of this module whose value names no
/// function the check can read (`let g = pick(3)`)?
fn hce_decl_unread(name: String) -> Bool {
  match retention_decl_value(name) {
    Some(val) => {
      let lits: Array[Expr] = array_empty()
      let srcs: Array[String] = array_empty()
      !hce_decl_sources(val, lits, srcs) && Array::length(lits) == 0 && Array::length(srcs) == 0
    },
    None => false
  }
}

/// Whether the module that declares the imported function `name` published
/// that a closure it creates performs `label` and can leave it.
fn hce_imported_makes_bound(name: String, label: String, env: TypeEnv) -> Bool {
  match env_lookup(env, retention_summary_marker(name)) {
    Some(CtNamed(_, facts)) => {
      let mut found = false
      for f in facts {
        match f {
          CtNamed(l, _) => if l == label {
            found = true
          } else {
            ()
          },
          _ => ()
        }
      }
      found
    },
    _ => false
  }
}

/// #3594: does the declaration `name`, called at the instantiated type
/// `inst`, return a closure performing `label` that it created for a row
/// variable of its own row (`forward[e](g: () -> Int with e) -> Box with e`
/// building `Box::{ f: () -> g() }`), the call instantiating that variable
/// to a row that names `label`?
fn hce_decl_makes_bound_via_var(name: String, inst: Type, label: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  match env_lookup(env, name) {
    Some(scheme) => {
      let mut made = false
      for v in hce_result_fn_row(scheme) {
        if !made && label_is_effect_var(v) {
          let at: Array[String] = array_empty()
          hce_var_inst(scheme, inst, v, at)
          if hce_has(at, label) && hce_decl_makes_bound(name, v, env, defs, s) {
            made = true
          } else {
            ()
          }
        } else {
          ()
        }
      }
      made
    },
    None => false
  }
}

/// The effect bases the row variable `v` of `scheme` stands for in `inst`,
/// the same type instantiated at a call: read off each function row of
/// `scheme` that names `v`, as the labels the matching row of `inst` adds
/// to the ones `scheme` spells there.
fn hce_var_inst(scheme: Type, inst: Type, v: String, out: Array[String]) -> Unit {
  match (scheme, inst) {
    (CtForAll(_, _, inner), _) => hce_var_inst(inner, inst, v, out),
    (_, CtForAll(_, _, inner)) => hce_var_inst(scheme, inner, v, out),
    (CtFn(ps, r, srow), CtFn(qs, r2, irow)) => {
      if hce_row_names_var(scheme, v) {
        let own = hce_row_bases(srow)
        for b in hce_row_bases(irow) {
          if !hce_has(own, b) {
            hce_add(out, b)
          } else {
            ()
          }
        }
      } else {
        ()
      }
      if Array::length(ps) == Array::length(qs) {
        hce_var_inst_all(ps, qs, v, out)
      } else {
        ()
      }
      hce_var_inst(r, r2, v, out)
    },
    (CtArray(a), CtArray(b)) => hce_var_inst(a, b, v, out),
    (CtOption(a), CtOption(b)) => hce_var_inst(a, b, v, out),
    (CtTuple(xs), CtTuple(ys)) => if Array::length(xs) == Array::length(ys) {
      hce_var_inst_all(xs, ys, v, out)
    } else {
      ()
    },
    (CtNamed(_, xs), CtNamed(_, ys)) => if Array::length(xs) == Array::length(ys) {
      hce_var_inst_all(xs, ys, v, out)
    } else {
      ()
    },
    _ => ()
  }
}

fn hce_var_inst_all(xs: Array[Type], ys: Array[Type], v: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(xs) {
    hce_var_inst(Array::get(xs, i), Array::get(ys, i), v, out)
    i = i + 1
  }
}

/// The bases of the effects a row spells, row variables left out.
fn hce_row_bases(row: Option[String]) -> Array[String] {
  let out: Array[String] = array_empty()
  match row {
    Some(r) => for raw in String::split(r, ",") {
      let l = String::trim(raw)
      if String::length(l) > 0 && !String::starts_with(l, "#") && !label_is_effect_var(l) {
        hce_add(out, row_label_base(effect_name_of_op(l)))
      } else {
        ()
      }
    },
    None => ()
  }
  out
}

/// Does the row of the function type `ty` name the row variable `v`?
fn hce_row_names_var(ty: Type, v: String) -> Bool {
  match ty {
    CtForAll(_, _, inner) => hce_row_names_var(inner, v),
    CtFn(_, _, Some(row)) => {
      let mut found = false
      for raw in String::split(row, ",") {
        if String::trim(raw) == v {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// Does the row of the function type `ty` name a row variable?
fn hce_row_has_var(ty: Type) -> Bool {
  match ty {
    CtForAll(_, _, inner) => hce_row_has_var(inner),
    CtFn(_, _, Some(row)) => {
      let mut found = false
      for raw in String::split(row, ",") {
        if label_is_effect_var(String::trim(raw)) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// Is the walk reading a declaration for a row variable (#3594)?
fn hce_poly_walk(st: HceWalk) -> Bool {
  Array::length(st.labels) == 1 && label_is_effect_var(Array::get(st.labels, 0))
}

fn hce_callee_is_ctor(callee: Expr, defs: Array[TypeDef]) -> Bool {
  match callee {
    EIdent(name, _) => hce_is_ctor(name, defs),
    _ => false
  }
}

/// #3593: `env` with, for each function this module publishes that creates
/// a closure performing an exception and can return it inside a declared
/// type's fields, the exception bases it does that for -- read where the
/// module's own handles read it (`hce_decl_makes_bound`), so an importer's
/// handle can answer without the body. The facts ride the function's
/// `retention_summary_marker` binding as its type arguments, after the
/// retention summary, and reach importers, re-exports and type companions
/// the way that summary does. `final_s` is the module's final substitution.
export fn hce_bind_module_summaries(stmts: Array[Stmt], env: TypeEnv, defs0: Array[TypeDef], final_s: Subst) -> TypeEnv {
  if !retention_summaries_enabled() {
    env
  } else {
    let defs = hce_defs_with_env(defs0, env)
    Array::push(hce_final, final_s)
    let mut out = env
    for stmt in stmts {
      match stmt {
        SLet(_, _, name, _, _) => {
          let facts = hce_decl_bound_facts(name, env, defs, final_s)
          // A declaration with no fact still hides the facts of an import
          // its name would otherwise republish.
          match env_lookup(env, retention_summary_marker(name)) {
            Some(CtNamed(text, old)) => if Array::length(facts) > 0 || Array::length(old) > 0 {
              out = env_bind(out, retention_summary_marker(name), CtNamed(text, facts))
            } else {
              ()
            },
            _ => if Array::length(facts) > 0 {
              out = env_bind(out, retention_summary_marker(name), CtNamed("", facts))
            } else {
              ()
            }
          }
        },
        _ => ()
      }
    }
    Array::truncate(hce_final, Array::length(hce_final) - 1)
    out
  }
}

/// The exception bases the declaration `name` creates a throwing closure
/// for that can leave it inside a declared type's fields, and the row
/// variables of its own row it creates a closure performing for (#3594),
/// each as a `CtNamed` with no arguments. A result type that spells the
/// function needs no fact: the importer reads it off the type.
fn hce_decl_bound_facts(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Array[Type] {
  let facts: Array[Type] = array_empty()
  match env_lookup(env, name) {
    Some(ty0) => {
      let ty = subst_apply(s, ty0)
      match hce_fn_result(ty) {
        Some(ret0) => {
          let ret = subst_apply(s, ret0)
          let bases: Array[String] = array_empty()
          for l in hce_result_fn_row(ty) {
            if !label_is_effect_var(l) {
              let base = row_label_base(effect_name_of_op(l))
              if is_exception_effect_name(base) {
                hce_add(bases, base)
              } else {
                ()
              }
            } else {
              ()
            }
          }
          // #3594: a row variable of the declaration's own row (`e`) is a
          // fact too, which an importer reads at the row its call
          // instantiates that variable to.
          for l in hce_result_fn_row(ty) {
            if label_is_effect_var(l) {
              hce_add(bases, l)
            } else {
              ()
            }
          }
          for base in bases {
            if !hce_spells_fn_without(ret, base, defs, array_empty()) && hce_holds_fn_without(ret, base, defs, array_empty()) && hce_decl_makes_bound(name, base, env, defs, s) {
              Array::push(facts, CtNamed(base, array_empty()))
            } else {
              ()
            }
          }
        },
        None => ()
      }
    },
    None => ()
  }
  facts
}

/// The effect bases of the handle-bound values the argument `arg` (just
/// walked; `producers_before` is where its producers begin) hands the call:
/// the closures written in it that can leave it, and the handle-bound
/// locals it does not merely call. "" when it hands none.
fn hce_arg_bound_label(arg: Expr, producers_before: Int, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  let mut found = ""
  let mut pi = producers_before
  while pi < Array::length(st.producers) {
    let (_, _, plabel, preach) = Array::get(st.producers, pi)
    if preach > 0 {
      found = hce_set_union(found, plabel)
    } else {
      ()
    }
    pi = pi + 1
  }
  let mut si = 0
  while si < Array::length(st.scope) {
    let (n, label, _) = Array::get(st.scope, si)
    if label != "" && hce_lookup(st, n) == 2 && hce_name_reach(n, arg, st, env, defs, s) > 0 {
      found = hce_set_union(found, label)
    } else {
      ()
    }
    si = si + 1
  }
  found
}

/// Can the call at `off` keep the value performing the set `label` it is handed as
/// argument `ai` (`arg`, of `nargs`) past the call -- in state the callee
/// captured, a module-level binding, its receiver, a handler's state? Not
/// when:
///
///   - the parameter there cannot hold a function, or is a function type
///     whose row names every base of `label` or a row variable: a closure handed there
///     takes that row, and whoever calls it passes the handler;
///   - the callee is a constructor -- `Some` / `Ok` / `Err` or a declared
///     enum variant, never a function by the case of its name (the value it
///     builds is the value, and its reach is read where it goes);
///   - the callee is a builtin that only calls the function (`Array::map`,
///     `filter`, `fold`, `any`, `all`, `find`, a `region` body);
///   - the callee is a function declared at the top of this module, or a
///     closure literal a `let` before the handle bound, whose body only ever
///     calls that parameter, outside any closure of its own.
///
/// Any other callee -- a local, a closure declared before the handle, an
/// imported function, a method, a computed callee, `perform` -- may.
fn hce_callee_may_keep(callee: Expr, off: Int, arg: Expr, ai: Int, nargs: Int, label: String, st: HceWalk, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Bool {
  let takes_row = match hce_param_type(callee, off, arg, ai, nargs, st, env, s) {
    Some(pt) => !hce_holds_fn(pt, defs, array_empty()) || hce_set_untaken(label, pt) == "",
    None => false
  }
  if takes_row {
    false
  } else {
    match callee {
      EIdent(name, noff) => if hce_lookup(st, name) != 0 {
        true
      } else if hce_is_ctor(name, defs) || hce_is_effect_op(name, defs) || hce_calls_only_builtin(name) || hce_container_builtin(env, name, noff) {
        false
      } else {
        let lit = match retention_local_closure(env, name) {
          Some(l) => Some(l),
          None => retention_decl_value(name)
        }
        match lit {
          Some(EFn(_, _, fparams, _, _, fbody)) => match arg {
            ELabeledArg(_, _, _) => true,
            _ => if ai < Array::length(fparams) {
              let (pname, _) = Array::get(fparams, ai)
              !hce_only_called(hce_param_base(pname), fbody)
            } else {
              true
            }
          },
          _ => true
        }
      },
      _ => true
    }
  }
}

/// The type of the parameter argument `ai` of the call at `off` is passed
/// to: from the environment for a function declared outside the body, else
/// from the callee type the checker recorded at the call. A method's
/// recorded type may lead with its receiver. None when it is not known, or
/// the argument is labeled.
fn hce_param_type(callee: Expr, off: Int, arg: Expr, ai: Int, nargs: Int, st: HceWalk, env: TypeEnv, s: Subst) -> Option[Type] {
  let ty = match callee {
    EIdent(name, _) => if hce_lookup(st, name) == 0 {
      match env_lookup(env, name) {
        Some(t) => Some(t),
        None => hce_recorded_type(off, name)
      }
    } else {
      hce_recorded_type(off, name)
    },
    _ => hce_recorded_type(off, call_callee_spelling(callee))
  }
  match arg {
    ELabeledArg(_, _, _) => None,
    _ => match ty {
      Some(t) => match hce_fn_params(hce_late(subst_apply(s, t))) {
        Some(params) => {
          let at = if Array::length(params) == nargs + 1 {
            ai + 1
          } else {
            ai
          }
          if at < Array::length(params) {
            Some(Array::get(params, at))
          } else {
            None
          }
        },
        None => None
      },
      None => None
    }
  }
}

/// Any callee type the checker recorded for the call at `off`.
fn hce_recorded_type(off: Int, spelling: String) -> Option[Type] {
  let mut found: Option[Type] = None
  let mut hit = false
  if off >= 0 {
    for row in call_callee_sites {
      let (soff, sp, ty) = row
      if !hit && soff == off && sp == spelling {
        found = Some(ty)
        hit = true
      } else {
        ()
      }
    }
    for row in call_callee_param_sites {
      let (soff, sp, ty) = row
      if !hit && soff == off && sp == spelling {
        found = Some(ty)
        hit = true
      } else {
        ()
      }
    }
  } else {
    ()
  }
  found
}

/// Take from the producers from `from` on the effects the parameter type
/// `pt` carries, and forget those left with none: a closure performing
/// `Ask` and `Log` handed to `() -> Int with Ask` still needs this handle
/// for `Log` (#3585).
fn hce_drop_row_taken(st: HceWalk, from: Int, pt: Type) -> Unit {
  let kept: Array[(String, Int, String, Int)] = array_empty()
  let mut pi = from
  while pi < Array::length(st.producers) {
    let (pwhat, poff, plabel, preach) = Array::get(st.producers, pi)
    let left = hce_set_untaken(plabel, pt)
    if left != "" {
      Array::push(kept, (pwhat, poff, left, preach))
    } else {
      ()
    }
    pi = pi + 1
  }
  Array::truncate(st.producers, from)
  for p in kept {
    Array::push(st.producers, p)
  }
  ()
}

/// Is `pt` a function type whose row names `label` or a row variable?
fn hce_param_takes_row(pt: Type, label: String) -> Bool {
  match pt {
    CtForAll(_, _, inner) => hce_param_takes_row(inner, label),
    CtFn(_, _, Some(row)) => {
      let mut found = false
      for raw in String::split(row, ",") {
        let l = String::trim(raw)
        if String::length(l) > 0 && !String::starts_with(l, "#") {
          if label_is_effect_var(l) || canonical_exception_effect_name(row_label_base(effect_name_of_op(l))) == label {
            found = true
          } else {
            ()
          }
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// The route a call that may keep its argument names.
fn hce_keep_route(callee: Expr) -> String {
  let spelling = call_callee_spelling(callee)
  if spelling == "perform" {
    "handing it to an effect operation, whose handler may keep it past the handle,"
  } else if spelling == "" {
    "handing it to a function that may keep it past the handle,"
  } else {
    String::concat("handing it to `", String::concat(spelling, "`, which may keep it past the handle,"))
  }
}

/// A constructor, read from the declarations: `Some` / `Ok` / `Err`, or a
/// variant of a declared enum (`Wrap`, `W::Wrap`) -- unless this module
/// declares a function of that spelling. The spelling's case decides nothing:
/// `fn Keep(f: () -> Int)` is an ordinary function.
fn hce_is_ctor(name: String, defs: Array[TypeDef]) -> Bool {
  match retention_decl_value(name) {
    Some(_) => false,
    None => if name == "Some" || name == "Ok" || name == "Err" {
      true
    } else {
      let at = String::last_index_of(name, "::")
      let (qual, variant) = if at >= 0 {
        (name[0: at], name[at + 2: String::length(name)])
      } else {
        ("", name)
      }
      let mut found = false
      for d in defs {
        match d {
          TDEnum(ename, _, variants) => if !found && (qual == "" || qual == ename) {
            for v in variants {
              let (vname, _) = v
              if vname == variant || vname == name {
                found = true
              } else {
                ()
              }
            }
          } else {
            ()
          },
          _ => ()
        }
      }
      found
    }
  }
}

/// An operation of a declared effect (`Store::Put`): it is only ever the
/// operand of `perform`, which is the call judged as handing the value to
/// a handler.
fn hce_is_effect_op(name: String, defs: Array[TypeDef]) -> Bool {
  let at = String::last_index_of(name, "::")
  if at < 0 {
    false
  } else {
    let qual = name[0: at]
    let op = name[at + 2: String::length(name)]
    let mut found = false
    for d in defs {
      match d {
        TDEffect(ename, ops, _) => if !found && ename == qual {
          for o in ops {
            let (oname, _, _) = o
            if oname == op {
              found = true
            } else {
              ()
            }
          }
        } else {
          ()
        },
        _ => ()
      }
    }
    found
  }
}

/// A builtin of a container namespace (`Array::push`, `MutMap::set`): it
/// keeps a value only in its own arguments, which the write routes and
/// `hce_beside_local` judge.
fn hce_container_builtin(env: TypeEnv, name: String, noff: Int) -> Bool {
  (String::starts_with(name, "Array::") || String::starts_with(name, "MutMap::") || String::starts_with(name, "Map::") || String::starts_with(name, "FixedArray::") || String::starts_with(name, "Option::")) && builtin_resolves_at(env, name, noff)
}

/// The builtins that call the function they are handed and keep nothing.
fn hce_calls_only_builtin(name: String) -> Bool {
  name == "Array::map" || name == "Array::filter" || name == "Array::fold" || name == "Array::any" || name == "Array::all" || name == "Array::find" || name == "__region_run"
}

fn hce_fn_params(ty: Type) -> Option[Array[Type]] {
  match ty {
    CtForAll(_, _, inner) => hce_fn_params(inner),
    CtFn(params, _, _) => Some(params),
    _ => None
  }
}

/// Is every use of `name` in `e` a call of it, none inside a closure? An
/// inner binding of the same spelling is not told apart, which can only
/// answer no.
fn hce_only_called(name: String, e: Expr) -> Bool {
  match e {
    EIdent(n, _) => n != name,
    EFn(_, _, _, _, _, fbody) => !hce_names_anywhere(fbody, name),
    ECall(callee, args, _, _) => if hce_is_paren(e) {
      hce_only_called_children(name, e)
    } else {
      let mut ok = match callee {
        EIdent(n, _) => n == name || hce_only_called(name, callee),
        _ => hce_only_called(name, callee)
      }
      for arg in args {
        if ok && !hce_only_called(name, arg) {
          ok = false
        } else {
          ()
        }
      }
      ok
    },
    _ => hce_only_called_children(name, e)
  }
}

fn hce_only_called_children(name: String, e: Expr) -> Bool {
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut ok = true
  let mut i = mark
  while ok && i < top {
    if !hce_only_called(name, expr_child_at(i)) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  expr_children_pop(mark)
  ok
}

/// Does `name` occur anywhere in `e`?
fn hce_names_anywhere(e: Expr, name: String) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    _ => {
      let mark = expr_children_push(e)
      let top = expr_children_top()
      let mut found = false
      let mut i = mark
      while !found && i < top {
        if hce_names_anywhere(expr_child_at(i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

fn hce_note_outer_write(st: HceWalk, name: String, off: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Unit {
  if st.find_routes && hce_lookup(st, name) == 0 {
    match env_lookup(env, name) {
      Some(ty) => if hce_holds_fn(subst_apply(s, ty), defs, array_empty()) {
        Array::push(st.routes, (String::concat("assigning it to `", String::concat(name, "`, which is declared outside the handle,")), off, 2))
      } else {
        ()
      },
      None => ()
    }
  } else {
    ()
  }
}

/// The binding an argument reads through (`x`, `x.f.g`).
fn hce_root_name(e: Expr) -> Option[(String, Int)] {
  match e {
    EIdent(name, off) => Some((name, off)),
    EDot(base, _, _, _) => hce_root_name(base),
    ELabeledArg(_, _, inner) => hce_root_name(inner),
    _ => None
  }
}

/// Can a value of `ty` hold a function? An unsolved variable can.
fn hce_holds_fn(ty: Type, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  hce_holds_fn_without(ty, "", defs, seen)
}

/// `hce_holds_fn`, except that a function whose row names `label` does not
/// count: it carries the effect in its type, so its caller answers it. With
/// a label, only a function the type spells counts; an unsolved variable
/// does not.
fn hce_holds_fn_without(ty: Type, label: String, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  match ty {
    CtFn(_, _, _) => label == "" || hce_row_label(ty, [label]) != label,
    // A callee whose result is only a type variable (`f: () -> T with E`)
    // is not taken to return a closure.
    CtVar(_) => label == "",
    CtApplied(_, _) => label == "",
    CtForAll(_, _, inner) => hce_holds_fn_without(inner, label, defs, seen),
    CtArray(inner) => hce_holds_fn_without(inner, label, defs, seen),
    CtOption(inner) => hce_holds_fn_without(inner, label, defs, seen),
    CtTuple(items) => hce_any_holds_fn(items, label, defs, seen),
    CtRecord(fields) => {
      let mut found = false
      for f in fields {
        let (_, fty) = f
        if !found && hce_holds_fn_without(fty, label, defs, seen) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtNamed(name, args) => hce_named_holds(name, args, label, defs, seen, false),
    CtStruct(name) => hce_named_holds(name, array_empty(), label, defs, seen, false),
    CtEnum(name) => hce_named_holds(name, array_empty(), label, defs, seen, false),
    _ => false
  }
}

fn ret_or_unit(r: Option[Type]) -> Type {
  match r {
    Some(t) => t,
    None => CtUnit
  }
}

/// `hce_holds_fn_without` for an exception row: a function type the type
/// spells, through tuples, arrays, `Option`, records, type arguments and
/// aliases, but not through the fields or payloads of a declared struct or
/// enum.
fn hce_spells_fn_without(ty: Type, label: String, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  match ty {
    CtFn(_, _, _) => hce_row_label(ty, [label]) != label,
    CtForAll(_, _, inner) => hce_spells_fn_without(inner, label, defs, seen),
    CtArray(inner) => hce_spells_fn_without(inner, label, defs, seen),
    CtOption(inner) => hce_spells_fn_without(inner, label, defs, seen),
    CtTuple(items) => hce_any_spells_fn(items, label, defs, seen),
    CtRecord(fields) => {
      let mut found = false
      for f in fields {
        let (_, fty) = f
        if !found && hce_spells_fn_without(fty, label, defs, seen) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtNamed(name, args) => if hce_has(seen, name) {
      false
    } else {
      match find_typedef(defs, name) {
        Some(TDAlias(_, tparams, target)) => {
          let inner_seen = Array::slice(seen, 0, Array::length(seen))
          Array::push(inner_seen, name)
          hce_spells_fn_without(subst_type_params(target, tparams, args), label, defs, inner_seen)
        },
        _ => hce_any_spells_fn(args, label, defs, seen)
      }
    },
    _ => false
  }
}

fn hce_any_spells_fn(items: Array[Type], label: String, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  let mut found = false
  for t in items {
    if !found && hce_spells_fn_without(t, label, defs, seen) {
      found = true
    } else {
      ()
    }
  }
  found
}

fn hce_any_holds_fn(items: Array[Type], label: String, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  let mut found = false
  for t in items {
    if !found && hce_holds_fn_without(t, label, defs, seen) {
      found = true
    } else {
      ()
    }
  }
  found
}

/// Can a write through a value of `ty` store a function: an array or a map
/// whose elements can hold one, or a struct with a `mut` field that can?
fn hce_stores_fn(ty: Type, defs: Array[TypeDef], seen: Array[String]) -> Bool {
  match ty {
    CtFn(_, _, _) => false,
    CtVar(_) => true,
    CtApplied(_, _) => true,
    CtForAll(_, _, inner) => hce_stores_fn(inner, defs, seen),
    CtArray(inner) => hce_holds_fn(inner, defs, array_empty()) || hce_stores_fn(inner, defs, seen),
    CtOption(inner) => hce_stores_fn(inner, defs, seen),
    CtTuple(items) => {
      let mut found = false
      for t in items {
        if !found && hce_stores_fn(t, defs, seen) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtRecord(fields) => {
      let mut found = false
      for f in fields {
        let (_, fty) = f
        if !found && hce_stores_fn(fty, defs, seen) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtNamed(name, args) => hce_named_holds(name, args, "", defs, seen, true),
    CtStruct(name) => hce_named_holds(name, array_empty(), "", defs, seen, true),
    CtEnum(name) => hce_named_holds(name, array_empty(), "", defs, seen, true),
    _ => false
  }
}

/// A declared type answers through its fields and payloads, read at `args`;
/// one this module does not declare (`Map`, `MutMap`, an opaque type)
/// answers through its arguments. A type already being read answers no.
fn hce_named_holds(name: String, args: Array[Type], label: String, defs: Array[TypeDef], seen: Array[String], store: Bool) -> Bool {
  if hce_has(seen, name) {
    false
  } else {
    let inner_seen = Array::slice(seen, 0, Array::length(seen))
    Array::push(inner_seen, name)
    match find_typedef(defs, name) {
      Some(TDStruct(_, fields, mut_fields, tparams)) => {
        let mut found = false
        for f in fields {
          let (fname, fty) = f
          let t = subst_type_params(fty, tparams, args)
          let hit = if store {
            (hce_has(mut_fields, fname) && hce_holds_fn(t, defs, array_empty())) || hce_stores_fn(t, defs, inner_seen)
          } else {
            hce_holds_fn_without(t, label, defs, inner_seen)
          }
          if !found && hit {
            found = true
          } else {
            ()
          }
        }
        found
      },
      Some(TDEnum(_, tparams, variants)) => {
        let mut found = false
        for v in variants {
          let (_, payload) = v
          for pty in payload {
            let t = subst_type_params(pty, tparams, args)
            let hit = if store {
              hce_stores_fn(t, defs, inner_seen)
            } else {
              hce_holds_fn_without(t, label, defs, inner_seen)
            }
            if !found && hit {
              found = true
            } else {
              ()
            }
          }
          ()
        }
        found
      },
      Some(TDAlias(_, tparams, target)) => {
        let t = subst_type_params(target, tparams, args)
        if store {
          hce_stores_fn(t, defs, inner_seen)
        } else {
          hce_holds_fn_without(t, label, defs, inner_seen)
        }
      },
      _ => hce_any_holds_fn(args, label, defs, inner_seen)
    }
  }
}
