fn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)]
fn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String]

// --- checker_trait.vibe (relocated here from compiler/ top level, #897
// batch; used to live outside checker/ so checker_stmt.vibe's need for
// register_builtin_traits was a #847-style direct leaf import bypassing the
// facade -- once checker/ became a real index.vpkg package boundary,
// enforce_incoming_boundary_fs rejected that leaf import from outside the
// package, same class of fix as checker_effects.vibe's relocation above.
// Its own former `./types.vibe` import (a top-level re-export shim of
