// --- checked_statement_root_type_observation.vibe
// Successful direct checker-returned roots only. No typed IR, cache/reuse,
// import contract, or persistent codec surface is exposed. Presentation and
// artifact APIs are owned by @vibe/compiler/checker/artifacts.
opaque type CheckedStatementRootTypeObservation

// --- checked_typed_occurrence_role_lane_observation.vibe
// Successful append-aligned role/lane tags only. No offsets, types, paths, or
// mutation surface are exposed; invalid indexes and mismatch observations fail
// closed as None. Presentation APIs are owned by
// @vibe/compiler/checker/artifacts.
opaque type CheckedTypedOccurrenceRoleLaneObservation

// --- checked_typed_occurrence_expression_path_observation.vibe
// Complete-or-none post-desugar structural provenance. Expression paths use
// core::expr_children child indexes; no offsets or raw capture state escape.
// Presentation and artifact APIs are owned by
// @vibe/compiler/checker/artifacts.
opaque type CheckedTypedOccurrenceExpressionPathObservation

