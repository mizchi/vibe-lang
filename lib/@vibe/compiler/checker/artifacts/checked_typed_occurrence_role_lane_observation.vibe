//# Append-aligned typed-occurrence role/lane observation
//
// This is intentionally an opaque, successful-check-only view. It records no
// offsets, expression paths, types, cache data, or mutable capture handle.

import @vibe/compiler/checker {
  CheckedTypedOccurrenceRoleLaneObservation
}

fn snapshot_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, value = __to_string(value))
  StringBuilder::push(out, value = ":")
}

fn snapshot_push_piece(out: StringBuilder, value: String) -> Unit {
  snapshot_push_int(out = out, value = String::length(value))
  StringBuilder::push(out, value = value)
}

/// Deterministic capture-order schema. Versioning is explicit because role and
/// lane tokens are the complete public payload of this narrow observation.
export fn canonical_checked_typed_occurrence_role_lane_snapshot(_ observation: CheckedTypedOccurrenceRoleLaneObservation) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-typed-occurrence-role-lane-observation:v1\n")
  snapshot_push_int(out = out, value = Array::length(observation.entries.entries))
  let mut i = 0
  while i < Array::length(observation.entries.entries) {
    let (role, lane) = Array::get(observation.entries.entries, at = i)
    snapshot_push_piece(out = out, value = role)
    snapshot_push_piece(out = out, value = lane)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// Invalid indexes are deliberately invisible rather than exposing the raw
/// capture representation.
export fn checked_typed_occurrence_role_lane_observation_row_count(_ observation: CheckedTypedOccurrenceRoleLaneObservation) -> Int {
  Array::length(observation.entries.entries)
}

export fn checked_typed_occurrence_role_lane_observation_role_at(observation: CheckedTypedOccurrenceRoleLaneObservation, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(observation.entries.entries) {
    None
  } else {
    let (role, _) = Array::get(observation.entries.entries, at = row_index)
    Some(role)
  }
}

export fn checked_typed_occurrence_role_lane_observation_lane_at(observation: CheckedTypedOccurrenceRoleLaneObservation, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(observation.entries.entries) {
    None
  } else {
    let (_, lane) = Array::get(observation.entries.entries, at = row_index)
    Some(lane)
  }
}
