      Some((args, p2)) => match body_piece(text = text, pos = p2) {
        Some((ret, end)) => String::length(name) > 0 && end == String::length(text) && normalized_type_array_payload_valid(text = args, depth = depth + 1) && normalized_type_valid(text = ret, depth = depth + 1),
        None => false
      },
      None => false
    },
    None => false
  }
}

fn normalized_type_def_valid(text: String, depth: Int) -> Bool {
  if depth > 512 || String::length(text) == 0 {
    false
  } else {
    let tag = String::char_code_at(text, at = 0)
    if tag == 101 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((params, p2)) => match normalized_piece_array_end(text = text, pos = p2, validator = normalized_enum_variant_valid, depth = depth) {
            Some(end) => String::length(name) > 0 && normalized_string_array_payload_valid(text = params, depth = depth + 1) && end == String::length(text),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 115 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match normalized_piece_array_end(text = text, pos = p1, validator = normalized_named_type_field_valid, depth = depth) {
          Some(p2) => match body_piece(text = text, pos = p2) {
            Some((mut_fields, p3)) => match body_piece(text = text, pos = p3) {
              Some((params, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = mut_fields, depth = depth + 1) && normalized_string_array_payload_valid(text = params, depth = depth + 1),
              None => false
            },
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 97 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((params, p2)) => match body_piece(text = text, pos = p2) {
            Some((body, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = params, depth = depth + 1) && normalized_type_valid(text = body, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 102 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match normalized_piece_array_end(text = text, pos = p1, validator = normalized_effect_operation_valid, depth = depth) {
          Some(p2) => match body_piece(text = text, pos = p2) {
            Some((params, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = params, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 122 {
      match body_piece(text = text, pos = 1) {
        Some((name, p)) => match body_piece(text = text, pos = p) {
          Some((members, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = members, depth = depth + 1),
          None => false
        },
        None => false
      }
    } else {
      false
    }
  }
}

fn normalized_string_bounds_bytes(_ bounds: Array[(String, Array[String])]) -> String {
  let out = StringBuilder::new(); StringBuilder::push(out, value = __to_string(Array::length(bounds))); StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(bounds) {
    let row = Array::get(bounds, at = i); let entry = StringBuilder::new(); body_push_piece(out = entry, value = row.0); body_push_piece(out = entry, value = normalized_string_array_bytes(row.1)); body_push_piece(out = out, value = StringBuilder::freeze(entry)); i = i + 1
  }
  StringBuilder::push(out, value = "]"); StringBuilder::freeze(out)
}

fn normalized_string_bound_valid(text: String, depth: Int) -> Bool {
  match body_piece(text = text, pos = 0) {
    Some((name, p)) => match body_piece(text = text, pos = p) {
      Some((bounds, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = bounds, depth = depth + 1),
      None => false
    },
    None => false
  }
}

fn normalized_trait_method_bytes(method: (String, Array[TypeExpr], TypeExpr), depth: Int) -> Option[String] {
  match (normalized_type_expr_array_bytes(tag = "t", items = method.1, depth = depth + 1), normalized_type_expr_bytes(ty = method.2, depth = depth + 1)) {
    (Some(params), Some(ret)) => {
      let out = StringBuilder::new(); body_push_piece(out = out, value = method.0); body_push_piece(out = out, value = params); body_push_piece(out = out, value = ret); Some(StringBuilder::freeze(out))
    },
    _ => None
  }
}

fn normalized_trait_method_valid(text: String, depth: Int) -> Bool {
  match body_piece(text = text, pos = 0) {
    Some((name, p1)) => match body_piece(text = text, pos = p1) {
      Some((params, p2)) => match body_piece(text = text, pos = p2) {
        Some((ret, end)) => String::length(name) > 0 && end == String::length(text) && normalized_type_expr_valid(text = params, depth = depth + 1) && normalized_type_expr_valid(text = ret, depth = depth + 1),
        None => false
      },
      None => false
    },
    None => false
  }
}

fn normalized_method_gen_bytes(_ row: (String, Array[String], Array[(String, Array[String])])) -> String {
  let out = StringBuilder::new(); body_push_piece(out = out, value = row.0); body_push_piece(out = out, value = normalized_string_array_bytes(row.1)); body_push_piece(out = out, value = normalized_string_bounds_bytes(row.2)); StringBuilder::freeze(out)
}

fn normalized_method_gen_valid(text: String, depth: Int) -> Bool {
  match body_piece(text = text, pos = 0) {
    Some((name, p1)) => match body_piece(text = text, pos = p1) {
      Some((params, p2)) => match body_piece(text = text, pos = p2) {
        Some((bounds, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = params, depth = depth + 1) && match normalized_piece_array_end(text = bounds, pos = 0, validator = normalized_string_bound_valid, depth = depth) {
          Some(bound_end) => bound_end == String::length(bounds),
          None => false
        },
        None => false
      },
      None => false
    },
    None => false
  }
}

fn normalized_env_bytes(env: TypeEnv, depth: Int) -> Option[String] {
  if depth > 2048 {
    None
  } else match env {
    EnvEmpty => Some("0"),
    EnvBind(name, binding, rest) => match (normalized_env_binding_bytes(binding = binding, depth = depth + 1), normalized_env_bytes(env = rest, depth = depth + 1)) {
      (Some(binding_bytes), Some(rest_bytes)) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "B"); body_push_piece(out = out, value = name); body_push_piece(out = out, value = binding_bytes); body_push_piece(out = out, value = rest_bytes); Some(StringBuilder::freeze(out))
      },
      _ => None
    },
    EnvFlat(bindings) => {
      let out = StringBuilder::new(); StringBuilder::push(out, value = "L"); StringBuilder::push(out, value = __to_string(Array::length(bindings))); StringBuilder::push(out, value = "[")
      let mut i = 0; let mut valid = true
      while i < Array::length(bindings) && valid {
        let entry = Array::get(bindings, at = i)
        match normalized_env_binding_bytes(binding = entry.1, depth = depth + 1) {
          Some(binding_bytes) => {
            let field = StringBuilder::new(); body_push_piece(out = field, value = entry.0); body_push_piece(out = field, value = binding_bytes); body_push_piece(out = out, value = StringBuilder::freeze(field))
          },
          None => {
            valid = false
          }
        }
        i = i + 1
      }
      StringBuilder::push(out, value = "]"); if valid {
        Some(StringBuilder::freeze(out))
      } else {
        None
      }
    },
    EnvCached(names, bindings, rest) => if env_name_index_length(names) != Array::length(bindings) {
      None
    } else match normalized_env_bytes(env = rest, depth = depth + 1) {
      Some(rest_bytes) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "C"); StringBuilder::push(out, value = __to_string(env_name_index_length(names))); StringBuilder::push(out, value = "[")
        let mut i = 0; let mut valid = true
        while i < env_name_index_length(names) && valid {
          match normalized_env_binding_bytes(binding = Array::get(bindings, at = i), depth = depth + 1) {
            Some(binding_bytes) => {
              let field = StringBuilder::new(); body_push_piece(out = field, value = env_name_index_at(index = names, row = i)); body_push_piece(out = field, value = binding_bytes); body_push_piece(out = out, value = StringBuilder::freeze(field))
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        StringBuilder::push(out, value = "]"); body_push_piece(out = out, value = rest_bytes); if valid {
          Some(StringBuilder::freeze(out))
        } else {
          None
        }
      },
      None => None
    },
    // This observation normalizes typing scope, not render-lowering facts.
    // Lossless CheckedProgram and module transports retain the wrapper node.
    EnvShowWrappers(_, _, rest) => normalized_env_bytes(env = rest, depth = depth + 1),
    EnvMutCell(name, escapes, rest) => match normalized_env_bytes(env = rest, depth = depth + 1) {
      Some(r) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "M"); body_push_piece(out = out, value = name); body_push_piece(out = out, value = if escapes {
          "1"
        } else {
          "0"
        }); body_push_piece(out = out, value = r); Some(StringBuilder::freeze(out))
      },
      None => None
    },
    EnvTraitImpl(name, target, rest) => match (normalized_type_bytes(ty = target, depth = depth + 1), normalized_env_bytes(env = rest, depth = depth + 1)) {
      (Some(t), Some(r)) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "I"); body_push_piece(out = out, value = name); body_push_piece(out = out, value = t); body_push_piece(out = out, value = r); Some(StringBuilder::freeze(out))
      },
      _ => None
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => match (normalized_type_bytes(ty = target, depth = depth + 1), normalized_env_bytes(env = rest, depth = depth + 1)) {
      (Some(t), Some(r)) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "G"); body_push_piece(out = out, value = name); body_push_piece(out = out, value = normalized_string_array_bytes(params)); body_push_piece(out = out, value = normalized_string_bounds_bytes(bounds)); body_push_piece(out = out, value = t); body_push_piece(out = out, value = r); Some(StringBuilder::freeze(out))
      },
      _ => None
    },
    EnvTypeDefs(defs, selectable, rest) => match normalized_env_bytes(env = rest, depth = depth + 1) {
      Some(r) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "P"); StringBuilder::push(out, value = __to_string(Array::length(defs))); StringBuilder::push(out, value = "["); let mut i = 0; let mut valid = true; while i < Array::length(defs) && valid {
          match normalized_type_def_bytes(def = Array::get(defs, at = i), depth = depth + 1) {
            Some(d) => body_push_piece(out = out, value = d),
            None => {
              valid = false
            }
          }; i = i + 1
        }; StringBuilder::push(out, value = "]"); body_push_piece(out = out, value = normalized_string_array_bytes(selectable)); body_push_piece(out = out, value = r); if valid {
          Some(StringBuilder::freeze(out))
        } else {
          None
        }
      },
      None => None
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => match normalized_env_bytes(env = rest, depth = depth + 1) {
      Some(r) => {
        let out = StringBuilder::new(); StringBuilder::push(out, value = "D"); body_push_piece(out = out, value = name); body_push_piece(out = out, value = normalized_string_array_bytes(supers)); body_push_piece(out = out, value = if is_auto {
          "1"
        } else {
          "0"
        }); StringBuilder::push(out, value = __to_string(Array::length(methods))); StringBuilder::push(out, value = "["); let mut i = 0; let mut valid = true; while i < Array::length(methods) && valid {
          match normalized_trait_method_bytes(method = Array::get(methods, at = i), depth = depth + 1) {
            Some(m) => body_push_piece(out = out, value = m),
            None => {
              valid = false
            }
          }; i = i + 1
        }; StringBuilder::push(out, value = "]"); body_push_piece(out = out, value = r); body_push_piece(out = out, value = normalized_string_array_bytes(params)); StringBuilder::push(out, value = __to_string(Array::length(method_gens))); StringBuilder::push(out, value = "["); i = 0; while i < Array::length(method_gens) {
          body_push_piece(out = out, value = normalized_method_gen_bytes(Array::get(method_gens, at = i))); i = i + 1
        }; StringBuilder::push(out, value = "]"); if valid {
          Some(StringBuilder::freeze(out))
        } else {
          None
        }
      },
      None => None
    }
  }
}

fn normalized_env_valid(text: String, depth: Int) -> Bool {
  if depth > 2048 || String::length(text) == 0 {
    false
  } else {
    let tag = String::char_code_at(text, at = 0)
    if tag == 48 {
      text == "0"
    }
    else if tag == 66 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((binding, p2)) => match body_piece(text = text, pos = p2) {
            Some((rest, end)) => String::length(name) > 0 && end == String::length(text) && normalized_env_binding_valid(text = binding, depth = depth + 1) && normalized_env_valid(text = rest, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 76 {
      match normalized_piece_array_end(text = text, pos = 1, validator = normalized_named_env_binding_valid, depth = depth) {
        Some(end) => end == String::length(text),
        None => false
      }
    }
    else if tag == 67 {
      match normalized_piece_array_end(text = text, pos = 1, validator = normalized_named_env_binding_valid, depth = depth) {
        Some(p) => match body_piece(text = text, pos = p) {
          Some((rest, end)) => end == String::length(text) && normalized_env_valid(text = rest, depth = depth + 1),
          None => false
        },
        None => false
      }
    }
    else if tag == 77 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((flag, p2)) => match body_piece(text = text, pos = p2) {
            Some((rest, end)) => String::length(name) > 0 && (flag == "0" || flag == "1") && end == String::length(text) && normalized_env_valid(text = rest, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 73 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((target, p2)) => match body_piece(text = text, pos = p2) {
            Some((rest, end)) => String::length(name) > 0 && end == String::length(text) && normalized_type_valid(text = target, depth = depth + 1) && normalized_env_valid(text = rest, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 71 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((params, p2)) => match body_piece(text = text, pos = p2) {
            Some((bounds, p3)) => match body_piece(text = text, pos = p3) {
              Some((target, p4)) => match body_piece(text = text, pos = p4) {
                Some((rest, end)) => String::length(name) > 0 && end == String::length(text) && normalized_string_array_payload_valid(text = params, depth = depth + 1) && match normalized_piece_array_end(text = bounds, pos = 0, validator = normalized_string_bound_valid, depth = depth) {
                  Some(be) => be == String::length(bounds),
                  None => false
                } && normalized_type_valid(text = target, depth = depth + 1) && normalized_env_valid(text = rest, depth = depth + 1),
                None => false
              },
              None => false
            },
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 80 {
      match normalized_piece_array_end(text = text, pos = 1, validator = normalized_type_def_valid, depth = depth) {
        Some(p1) => match body_piece(text = text, pos = p1) {
          Some((selectable, p2)) => match body_piece(text = text, pos = p2) {
            Some((rest, end)) => end == String::length(text) && normalized_string_array_payload_valid(text = selectable, depth = depth + 1) && normalized_env_valid(text = rest, depth = depth + 1),
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else if tag == 68 {
      match body_piece(text = text, pos = 1) {
        Some((name, p1)) => match body_piece(text = text, pos = p1) {
          Some((supers, p2)) => match body_piece(text = text, pos = p2) {
            Some((auto, p3)) => match normalized_piece_array_end(text = text, pos = p3, validator = normalized_trait_method_valid, depth = depth) {
              Some(p4) => match body_piece(text = text, pos = p4) {
                Some((rest, p5)) => match body_piece(text = text, pos = p5) {
                  Some((params, p6)) => match normalized_piece_array_end(text = text, pos = p6, validator = normalized_method_gen_valid, depth = depth) {
                    Some(end) => String::length(name) > 0 && (auto == "0" || auto == "1") && end == String::length(text) && normalized_string_array_payload_valid(text = supers, depth = depth + 1) && normalized_env_valid(text = rest, depth = depth + 1) && normalized_string_array_payload_valid(text = params, depth = depth + 1),
                    None => false
                  },
                  None => false
                },
                None => false
              },
              None => false
            },
            None => false
          },
          None => false
        },
        None => false
      }
    }
    else {
      false
    }
  }
}

export fn normalized_value_type_env_artifact_from_env(_ env: TypeEnv) -> Option[NormalizedValueTypeEnvArtifact] {
  match normalized_env_bytes(env = env, depth = 0) {
    Some(env_bytes) => if normalized_env_valid(text = env_bytes, depth = 0) {
      Some(NormalizedValueTypeEnvArtifact::{ env_bytes })
    } else {
      None
    },
    None => None
  }
}

export fn normalized_value_type_env_artifact_from_authority(_ authority: LocatedProgramBinderAuthority) -> Option[NormalizedValueTypeEnvArtifact] with Exception {
  normalized_value_type_env_artifact_from_env(check_program_result(located_program_binder_authority_program(authority)).final_env)
}

export fn encode_normalized_value_type_env_artifact_v1(_ artifact: NormalizedValueTypeEnvArtifact) -> String {
  let out = StringBuilder::new(); StringBuilder::push(out, value = "vibe-normalized-value-type-env:v1\n"); body_push_piece(out = out, value = artifact.env_bytes); StringBuilder::freeze(out)
}

export fn decode_normalized_value_type_env_artifact_v1(_ text: String) -> Option[NormalizedValueTypeEnvArtifact] {
  let prefix = "vibe-normalized-value-type-env:v1\n"
  if !String::starts_with(text, prefix = prefix) {
    None
  } else match body_piece(text = text, pos = String::length(prefix)) {
    Some((env_bytes, end)) => {
      let artifact = NormalizedValueTypeEnvArtifact::{ env_bytes }
      if end == String::length(text) && normalized_env_valid(text = env_bytes, depth = 0) && encode_normalized_value_type_env_artifact_v1(artifact) == text {
        Some(artifact)
      } else {
        None
      }
    },
    None => None
  }
}
