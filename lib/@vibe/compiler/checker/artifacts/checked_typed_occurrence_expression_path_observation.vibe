//# Complete typed-occurrence structural expression-path observation
//
// This opaque successful-check-only view is append-aligned to the legacy
// typed-occurrences table. Coordinates are post-desugar structural paths:
// statement paths use the retained statement convention and expression paths
// use `core::expr_children` zero-based child indexes (root `[]`). Synthetic
// rewrites and auxiliary resume rechecks fail closed rather than claiming a
// partial path observation.

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  CheckedTypedOccurrenceExpressionPathObservation, canonical_checked_occurrence_type_fields
}

fn snapshot_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, value = __to_string(value))
  StringBuilder::push(out, value = ":")
}

fn snapshot_push_piece(out: StringBuilder, value: String) -> Unit {
  snapshot_push_int(out = out, value = String::length(value))
  StringBuilder::push(out, value = value)
}

fn snapshot_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  snapshot_push_int(out = out, value = Array::length(path))
  let mut i = 0
  while i < Array::length(path) {
    snapshot_push_int(out = out, value = Array::get(path, at = i))
    i = i + 1
  }
}

/// Deterministic, length-delimited capture-order schema. It intentionally
/// exposes no legacy offsets or raw capture representation.
export fn canonical_checked_typed_occurrence_expression_path_snapshot(_ observation: CheckedTypedOccurrenceExpressionPathObservation) -> String {
  let raw_types = array_empty()
  let mut i = 0
  while i < Array::length(observation.entries.provenance_entries) {
    let (_, _, _, _, ty) = Array::get(observation.entries.provenance_entries, at = i)
    Array::push(raw_types, value = ty)
    i = i + 1
  }
  let types = canonical_checked_occurrence_type_fields(types = raw_types, s = observation.checked_program.final_subst)
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-typed-occurrence-expression-path-observation:v1\n")
  snapshot_push_int(out = out, value = Array::length(observation.entries.provenance_entries))
  let mut j = 0
  while j < Array::length(observation.entries.provenance_entries) {
    let (statement_path, expression_path, role, lane, _) = Array::get(observation.entries.provenance_entries, at = j)
    snapshot_push_path(out = out, path = statement_path)
    snapshot_push_path(out = out, path = expression_path)
    snapshot_push_piece(out = out, value = role)
    snapshot_push_piece(out = out, value = lane)
    snapshot_push_piece(out = out, value = Array::get(types, at = j))
    j = j + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_typed_occurrence_expression_path_observation_row_count(_ observation: CheckedTypedOccurrenceExpressionPathObservation) -> Int {
  Array::length(observation.entries.provenance_entries)
}

export fn checked_typed_occurrence_expression_path_observation_statement_path_at(observation: CheckedTypedOccurrenceExpressionPathObservation, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(observation.entries.provenance_entries) {
    None
  } else {
    let (statement_path, _, _, _, _) = Array::get(observation.entries.provenance_entries, at = row_index)
    Some(Array::slice(statement_path, start = 0, end = Array::length(statement_path)))
  }
}

export fn checked_typed_occurrence_expression_path_observation_expression_path_at(observation: CheckedTypedOccurrenceExpressionPathObservation, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(observation.entries.provenance_entries) {
    None
  } else {
    let (_, expression_path, _, _, _) = Array::get(observation.entries.provenance_entries, at = row_index)
    Some(Array::slice(expression_path, start = 0, end = Array::length(expression_path)))
  }
}

export fn checked_typed_occurrence_expression_path_observation_role_at(observation: CheckedTypedOccurrenceExpressionPathObservation, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(observation.entries.provenance_entries) {
    None
  } else {
    let (_, _, role, _, _) = Array::get(observation.entries.provenance_entries, at = row_index)
    Some(role)
  }
}

export fn checked_typed_occurrence_expression_path_observation_lane_at(observation: CheckedTypedOccurrenceExpressionPathObservation, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(observation.entries.provenance_entries) {
    None
  } else {
    let (_, _, _, lane, _) = Array::get(observation.entries.provenance_entries, at = row_index)
    Some(lane)
  }
}
