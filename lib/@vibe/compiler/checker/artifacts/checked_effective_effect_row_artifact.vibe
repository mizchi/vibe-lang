//# Checked effective-effect-row artifact (#1379 Phase 3)
//
// This strict v1 transport retains exactly the narrow checked-observation
// tuple. It is structurally validated transport, not evidence that decoded
// data came from a successful checker invocation. It is not a CheckedProgram,
// TypeEnv, structured EffectRow, cache/reuse key, trace, interface, or import
// contract.

import @vibe/compiler/core {
  sorted_names_of
}

import @vibe/core {
  array_empty
}

import ./checked_effective_effect_row_observation.vibe {
  CheckedEffectiveEffectRowObservation, canonical_checked_effective_effect_row_snapshot
}

/// Opaque transport of `(root_statement_index, name, annotation_kind,
/// annotation_row, direct_fn_source_row, final_effective_row)` exactly as
/// observed. Rows remain arbitrary Option[String] text; v1 never parses them.
export struct CheckedEffectiveEffectRowArtifact {
  entries: Array[(Int, String, Int, Option[String], Option[String], Option[String])]
}

fn artifact_copy_string(text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, text)
  StringBuilder::freeze(out)
}

fn artifact_copy_option(row: Option[String]) -> Option[String] {
  match row {
    None => None,
    Some(text) => Some(artifact_copy_string(text))
  }
}

fn artifact_copy_entries(entries: Array[(Int, String, Int, Option[String], Option[String], Option[String])]) -> Array[(Int, String, Int, Option[String], Option[String], Option[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    let (owner, name, annotation_kind, annotation_row, source_row, effective_row) = Array::get(entries, i)
    Array::push(out, (owner, artifact_copy_string(name), annotation_kind, artifact_copy_option(annotation_row), artifact_copy_option(source_row), artifact_copy_option(effective_row)))
    i = i + 1
  }
  out
}

fn artifact_annotation_consistent(annotation_kind: Int, annotation_row: Option[String]) -> Bool {
  if annotation_kind == 0 || annotation_kind == 2 {
    match annotation_row {
      None => true,
      Some(_) => false
    }
  } else {
    // A TyFn annotation (kind 1) legitimately has either no row or an exact
    // row string, including Some("").
    annotation_kind == 1
  }
}

/// These are exactly the structural invariants the observer guarantees. Row
/// strings intentionally have no additional syntax or checker-provenance test.
/// Duplicate detection uses stable merge-sort instead of repeated scans or a
/// deterministic hash table, so adversarial equal-hash names remain bounded.
fn artifact_valid(entries: Array[(Int, String, Int, Option[String], Option[String], Option[String])]) -> Bool {
  let names = array_empty()
  let mut i = 0
  let mut previous_owner = 0
  let mut have_previous = false
  let mut valid = true
  while i < Array::length(entries) && valid {
    let (owner, name, annotation_kind, annotation_row, _, _) = Array::get(entries, i)
    if owner < 0 || (have_previous && owner <= previous_owner) || !artifact_annotation_consistent(annotation_kind, annotation_row) {
      valid = false
    } else {
      Array::push(names, name)
      previous_owner = owner
      have_previous = true
    }
    i = i + 1
  }
  if valid {
    let sorted_names = sorted_names_of(names)
    let mut j = 1
    while j < Array::length(sorted_names) && valid {
      if Array::get(sorted_names, j - 1) == Array::get(sorted_names, j) {
        valid = false
      } else {
        j = j + 1
      }
    }
  } else {
    ()
  }
  valid
}

/// Deep-copy a successful-check observation without normalizing any retained
/// row text. Manually malformed observations fail closed; success is still not
/// an attestation carried by the resulting transport value.
export fn checked_effective_effect_row_artifact_from_observation(observation: CheckedEffectiveEffectRowObservation) -> Option[CheckedEffectiveEffectRowArtifact] {
  if artifact_valid(observation.entries) {
    Some(CheckedEffectiveEffectRowArtifact::{
      entries: artifact_copy_entries(observation.entries)
    })
  } else {
    None
  }
}

fn artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, __to_string(String::length(text)))
  StringBuilder::push(out, ":")
  StringBuilder::push(out, text)
}

fn artifact_push_option(out: StringBuilder, row: Option[String]) -> Unit {
  match row {
    None => StringBuilder::push(out, "N"),
    Some(text) => {
      StringBuilder::push(out, "S")
      artifact_push_piece(out, text)
    }
  }
}

fn artifact_entry(owner: Int, name: String, annotation_kind: Int, annotation_row: Option[String], source_row: Option[String], effective_row: Option[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, __to_string(owner))
  StringBuilder::push(out, ":")
  artifact_push_piece(out, name)
  StringBuilder::push(out, __to_string(annotation_kind))
  StringBuilder::push(out, ":")
  artifact_push_option(out, annotation_row)
  artifact_push_option(out, source_row)
  artifact_push_option(out, effective_row)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder. Every tuple field is kept
/// byte-exact, including None versus Some("") and arbitrary row text.
export fn encode_checked_effective_effect_row_artifact_v1(artifact: CheckedEffectiveEffectRowArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-effective-effect-rows-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(artifact.entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (owner, name, annotation_kind, annotation_row, source_row, effective_row) = Array::get(artifact.entries, i)
    artifact_push_piece(out, artifact_entry(owner, name, annotation_kind, annotation_row, source_row, effective_row))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end {
    None
  } else {
    let mut i = start
    let mut value = 0
    let mut valid = true
    if end - start > 1 && String::char_code_at(text, start) == 48 {
      valid = false
    } else {
      ()
    }
    while i < end {
      let code = String::char_code_at(text, i)
      if code < 48 || code > 57 || value > (bound - (code - 48)) / 10 {
        valid = false
      } else {
        value = value * 10 + (code - 48)
      }
      i = i + 1
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match artifact_decimal(text, pos, at, n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    // Bound the untrusted count by the remaining payload before any loop or
    // allocation. On a bad first item, stop rather than rescanning it once per
    // claimed element.
    match artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        let out = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          match artifact_piece_parse(text, cursor) {
            Some((item, next)) => {
              Array::push(out, item)
              cursor = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((out, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn artifact_option_parse(text: String, pos: Int) -> Option[(Option[String], Int)] {
  if pos >= String::length(text) {
    None
  } else {
    let tag = String::char_code_at(text, pos)
    if tag == 78 {
      Some((None, pos + 1))
    } else if tag == 83 {
      match artifact_piece_parse(text, pos + 1) {
        Some((row, next)) => Some((Some(row), next)),
        None => None
      }
    } else {
      None
    }
  }
}

fn artifact_entry_parse(text: String) -> Option[(Int, String, Int, Option[String], Option[String], Option[String])] {
  let n = String::length(text)
  let mut at = 0
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == 0 || at >= n {
    None
  } else {
    match artifact_decimal(text, 0, at, (2305843009213693951<<1)|1) {
      Some(owner) => match artifact_piece_parse(text, at + 1) {
        Some((name, after_name)) => if after_name + 1 >= n || String::char_code_at(text, after_name + 1) != 58 {
          None
        } else {
          let annotation_kind_code = String::char_code_at(text, after_name)
          let annotation_kind = if annotation_kind_code == 48 {
            Some(0)
          } else if annotation_kind_code == 49 {
            Some(1)
          } else if annotation_kind_code == 50 {
            Some(2)
          } else {
            None
          }
          match annotation_kind {
            Some(annotation_kind) => match artifact_option_parse(text, after_name + 2) {
              Some((annotation_row, after_annotation)) => match artifact_option_parse(text, after_annotation) {
                Some((source_row, after_source)) => match artifact_option_parse(text, after_source) {
                  Some((effective_row, end)) => if end == n {
                    Some((owner, name, annotation_kind, annotation_row, source_row, effective_row))
                  } else {
                    None
                  },
                  None => None
                },
                None => None
              },
              None => None
            },
            None => None
          }
        },
        None => None
      },
      None => None
    }
  }
}

/// Strict v1 decoder. It rejects malformed/count-hostile/noncanonical data,
/// enforces only observer-guaranteed structure, and requires exact re-encoding.
/// Decoding therefore never claims checker provenance or row-language validity.
export fn decode_checked_effective_effect_row_artifact_v1(text: String) -> Option[CheckedEffectiveEffectRowArtifact] {
  let prefix = "vibe-checked-effective-effect-rows-artifact:v1\n"
  if !String::starts_with(text, prefix) {
    None
  } else {
    match artifact_array_parse(text, String::length(prefix)) {
      Some((raw_entries, end)) => {
        let entries = array_empty()
        let mut i = 0
        let mut valid = end == String::length(text)
        while i < Array::length(raw_entries) && valid {
          match artifact_entry_parse(Array::get(raw_entries, i)) {
            Some(entry) => Array::push(entries, entry),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !artifact_valid(entries) {
          None
        } else {
          let artifact = CheckedEffectiveEffectRowArtifact::{
            entries: artifact_copy_entries(entries)
          }
          if encode_checked_effective_effect_row_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Deterministic observation-vocabulary snapshot of opaque transport data.
/// This is a view only; it does not make decoded data checker-derived.
export fn canonical_checked_effective_effect_row_artifact_snapshot(artifact: CheckedEffectiveEffectRowArtifact) -> Option[String] {
  let observation: CheckedEffectiveEffectRowObservation = CheckedEffectiveEffectRowObservation::{
    entries: artifact_copy_entries(artifact.entries)
  }
  canonical_checked_effective_effect_row_snapshot(observation)
}
