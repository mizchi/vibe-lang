//# Checked expression-structure artifact (#1379 Phase 3)
//
// Strict v1 transport of the complete structure-only observation. It retains
// only statement paths, post-desugar expression paths, and closed constructor
// kinds. It is not a CheckedProgram, typed IR, checker attestation, cache key,
// import contract, source identity, or edit-stable identity.

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  checked_expression_structure_kind_valid
}

import ./checked_expression_structure_observation.vibe {
  CheckedExpressionStructureObservation
}

/// Opaque preorder transport of `(statement_path, expression_path, kind)`.
export struct CheckedExpressionStructureArtifact {
  rows: Array[(Array[Int], Array[Int], String)]
}

fn expression_structure_artifact_copy_string(_ text: String) -> String {
  String::concat(text, "")
}

fn expression_structure_artifact_copy_path(_ path: Array[Int]) -> Array[Int] {
  Array::slice(path, start = 0, end = Array::length(path))
}

fn expression_structure_artifact_copy_rows(_ rows: Array[(Array[Int], Array[Int], String)]) -> Array[(Array[Int], Array[Int], String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (statement_path, expression_path, kind) = Array::get(rows, at = i)
    Array::push(out, value = (expression_structure_artifact_copy_path(statement_path), expression_structure_artifact_copy_path(expression_path), expression_structure_artifact_copy_string(kind)))
    i = i + 1
  }
  out
}

fn expression_structure_artifact_path_valid(_ path: Array[Int]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(path) && valid {
    if Array::get(path, at = i) < 0 {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn expression_structure_artifact_valid(_ rows: Array[(Array[Int], Array[Int], String)]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(rows) && valid {
    let (statement_path, expression_path, kind) = Array::get(rows, at = i)
    if !expression_structure_artifact_path_valid(statement_path) || !expression_structure_artifact_path_valid(expression_path) || !checked_expression_structure_kind_valid(kind) {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

/// Deep-copy the complete observation. Sibling-constructed invalid paths or
/// constructor tags fail closed.
export fn checked_expression_structure_artifact_from_observation(_ observation: CheckedExpressionStructureObservation) -> Option[CheckedExpressionStructureArtifact] {
  let rows = expression_structure_artifact_copy_rows(observation.rows)
  if expression_structure_artifact_valid(rows) {
    Some(CheckedExpressionStructureArtifact::{
      rows: rows
    })
  } else {
    None
  }
}

fn expression_structure_artifact_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, value = __to_string(value))
  StringBuilder::push(out, value = ":")
}

fn expression_structure_artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  expression_structure_artifact_push_int(out = out, value = String::length(text))
  StringBuilder::push(out, value = text)
}

fn expression_structure_artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, value = __to_string(Array::length(path)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(path) {
    expression_structure_artifact_push_int(out = out, value = Array::get(path, at = i))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
}

fn expression_structure_artifact_entry(statement_path: Array[Int], expression_path: Array[Int], kind: String) -> String {
  let out = StringBuilder::new()
  expression_structure_artifact_push_path(out = out, path = statement_path)
  expression_structure_artifact_push_path(out = out, path = expression_path)
  expression_structure_artifact_push_piece(out = out, text = kind)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder preserving preorder.
export fn encode_checked_expression_structure_artifact_v1(_ artifact: CheckedExpressionStructureArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-expression-structure-artifact:v1\n")
  StringBuilder::push(out, value = __to_string(Array::length(artifact.rows)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(artifact.rows) {
    let (statement_path, expression_path, kind) = Array::get(artifact.rows, at = i)
    expression_structure_artifact_push_piece(out = out, text = expression_structure_artifact_entry(statement_path = statement_path, expression_path = expression_path, kind = kind))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn expression_structure_artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end {
    None
  } else {
    let mut valid = true
    let mut value = 0
    let mut i = start
    if end - start > 1 && String::char_code_at(text, at = start) == 48 {
      valid = false
    }
    while i < end && valid {
      let digit = String::char_code_at(text, at = i) - 48
      if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
        valid = false
      } else {
        value = value * 10 + digit
        i = i + 1
      }
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn expression_structure_artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at = at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match expression_structure_artifact_decimal(text = text, start = pos, end = at, bound = n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn expression_structure_artifact_path_parse(text: String, pos: Int) -> Option[(Array[Int], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at = at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match expression_structure_artifact_decimal(text = text, start = pos, end = at, bound = n - at - 1) {
      Some(count) => {
        let path = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          let start = cursor
          while cursor < n && String::char_code_at(text, at = cursor) != 58 {
            cursor = cursor + 1
          }
          if cursor == start || cursor >= n {
            valid = false
          } else {
            match expression_structure_artifact_decimal(text = text, start = start, end = cursor, bound = (2305843009213693951<<1)|1) {
              Some(value) => {
                Array::push(path, value = value)
                cursor = cursor + 1
              },
              None => {
                valid = false
              }
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, at = cursor) != 93 {
          None
        } else {
          Some((path, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn expression_structure_artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at = at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match expression_structure_artifact_decimal(text = text, start = pos, end = at, bound = n - at - 1) {
      Some(count) => {
        let out = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          match expression_structure_artifact_piece_parse(text = text, pos = cursor) {
            Some((item, next)) => {
              Array::push(out, value = item)
              cursor = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, at = cursor) != 93 {
          None
        } else {
          Some((out, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn expression_structure_artifact_entry_parse(_ text: String) -> Option[(Array[Int], Array[Int], String)] {
  match expression_structure_artifact_path_parse(text = text, pos = 0) {
    Some((statement_path, after_statement)) => match expression_structure_artifact_path_parse(text = text, pos = after_statement) {
      Some((expression_path, after_expression)) => match expression_structure_artifact_piece_parse(text = text, pos = after_expression) {
        Some((kind, end)) => if end == String::length(text) {
          Some((statement_path, expression_path, kind))
        } else {
          None
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

/// Strict v1 decoder. Counts are bounded by remaining input before iteration;
/// exact re-encoding rejects all alternate noncanonical representations.
export fn decode_checked_expression_structure_artifact_v1(_ text: String) -> Option[CheckedExpressionStructureArtifact] {
  let prefix = "vibe-checked-expression-structure-artifact:v1\n"
  if !String::starts_with(text, prefix = prefix) {
    None
  } else {
    match expression_structure_artifact_array_parse(text = text, pos = String::length(prefix)) {
      Some((raw_rows, end)) => {
        let rows = array_empty()
        let mut valid = end == String::length(text)
        let mut i = 0
        while i < Array::length(raw_rows) && valid {
          match expression_structure_artifact_entry_parse(Array::get(raw_rows, at = i)) {
            Some(row) => Array::push(rows, value = row),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !expression_structure_artifact_valid(rows) {
          None
        } else {
          let artifact = CheckedExpressionStructureArtifact::{
            rows: expression_structure_artifact_copy_rows(rows)
          }
          if encode_checked_expression_structure_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Reproduce the observation vocabulary snapshot without checker attestation.
export fn canonical_checked_expression_structure_artifact_snapshot(_ artifact: CheckedExpressionStructureArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-expression-structure-observation:v1\n")
  expression_structure_artifact_push_int(out = out, value = Array::length(artifact.rows))
  let mut i = 0
  while i < Array::length(artifact.rows) {
    let (statement_path, expression_path, kind) = Array::get(artifact.rows, at = i)
    expression_structure_artifact_push_int(out = out, value = Array::length(statement_path))
    let mut j = 0
    while j < Array::length(statement_path) {
      expression_structure_artifact_push_int(out = out, value = Array::get(statement_path, at = j))
      j = j + 1
    }
    expression_structure_artifact_push_int(out = out, value = Array::length(expression_path))
    let mut k = 0
    while k < Array::length(expression_path) {
      expression_structure_artifact_push_int(out = out, value = Array::get(expression_path, at = k))
      k = k + 1
    }
    expression_structure_artifact_push_piece(out = out, text = kind)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_expression_structure_artifact_row_count(_ artifact: CheckedExpressionStructureArtifact) -> Int {
  Array::length(artifact.rows)
}

export fn checked_expression_structure_artifact_statement_path_at(artifact: CheckedExpressionStructureArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.rows) {
    None
  } else {
    let (path, _, _) = Array::get(artifact.rows, at = row_index)
    Some(expression_structure_artifact_copy_path(path))
  }
}

export fn checked_expression_structure_artifact_expression_path_at(artifact: CheckedExpressionStructureArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.rows) {
    None
  } else {
    let (_, path, _) = Array::get(artifact.rows, at = row_index)
    Some(expression_structure_artifact_copy_path(path))
  }
}

export fn checked_expression_structure_artifact_kind_at(artifact: CheckedExpressionStructureArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.rows) {
    None
  } else {
    let (_, _, kind) = Array::get(artifact.rows, at = row_index)
    Some(expression_structure_artifact_copy_string(kind))
  }
}
