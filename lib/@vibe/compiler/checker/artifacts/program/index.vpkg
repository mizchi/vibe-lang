name = @vibe/compiler/checker/artifacts/program
version = 0.0.1
description =
  #|Lossless transport of complete checked programs.
deps = {
  @vibe/compiler/cache : 0.0.1
  @vibe/compiler/cache/policy : 0.0.1
  @vibe/compiler/checker : 0.0.1
  @vibe/compiler/core : 0.0.1
}

import @vibe/compiler/checker {
  CheckedProgram
}

fn encode_checked_program(_ checked: CheckedProgram) -> Bytes
fn decode_checked_program(_ bytes: Bytes) -> Option[CheckedProgram]

import @vibe/compiler/cache {
  AstBinaryReader
}
fn write_checked_program_fields(out: Bytes, checked: CheckedProgram) -> Unit
fn read_checked_program_fields(_ reader: AstBinaryReader) -> CheckedProgram with Exception

import @vibe/compiler/core {
  TypeEnv
}
fn write_checked_environment(out: Bytes, env: TypeEnv) -> Unit
