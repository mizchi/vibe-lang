//# Checked expression leaf-payload direct-return artifact (Phase 3)

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  CheckedDirectExpressionReturnObservation,
  canonical_checked_occurrence_type_fields,
  checked_expression_structure_leaf_rows,
  checked_expression_structure_rows
}

/// Opaque preorder transport of `(statement_path, expression_path, leaf_kind,
/// exact_payload_text, canonical_direct_return_type_text)`.
export struct CheckedExpressionLeafPayloadDirectReturnArtifact {
  entries: Array[(Array[Int], Array[Int], String, String, String)]
}

fn leaf_payload_direct_return_artifact_copy_string(text: String) -> String {
  String::concat(text, "")
}

fn leaf_payload_direct_return_artifact_copy_path(path: Array[Int]) -> Array[Int] {
  Array::slice(path, 0, Array::length(path))
}

fn leaf_payload_direct_return_artifact_copy_rows(entries: Array[(Array[Int], Array[Int], String, String, String)]) -> Array[(Array[Int], Array[Int], String, String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    let (statement_path, expression_path, kind, payload, ty) = Array::get(entries, i)
    Array::push(out, (leaf_payload_direct_return_artifact_copy_path(statement_path), leaf_payload_direct_return_artifact_copy_path(expression_path), leaf_payload_direct_return_artifact_copy_string(kind), leaf_payload_direct_return_artifact_copy_string(payload), leaf_payload_direct_return_artifact_copy_string(ty)))
    i = i + 1
  }
  out
}

fn leaf_payload_direct_return_artifact_path_valid(path: Array[Int]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(path) && valid {
    if Array::get(path, i) < 0 {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn leaf_payload_direct_return_artifact_int_payload_valid(text: String) -> Bool {
  let n = String::length(text)
  if n == 0 {
    false
  } else {
    let negative = String::char_code_at(text, 0) == 45
    let start = if negative {
      1
    } else {
      0
    }
    if start >= n || (n - start > 1 && String::char_code_at(text, start) == 48) || (negative && String::char_code_at(text, start) == 48) {
      false
    } else if negative && text == "-4611686018427387904" {
      true
    } else {
      // Vibe's negative minimum has magnitude max+1, which cannot itself be
      // represented as an Int literal; admit its sole canonical spelling above.
      let bound = (2305843009213693951<<1)|1
      let mut value = 0
      let mut i = start
      let mut valid = true
      while i < n && valid {
        let digit = String::char_code_at(text, i) - 48
        if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
          valid = false
        } else {
          value = value * 10 + digit
          i = i + 1
        }
      }
      valid
    }
  }
}

fn leaf_payload_direct_return_artifact_kind_payload_valid(kind: String, payload: String) -> Bool {
  match kind {
    "EInt" => leaf_payload_direct_return_artifact_int_payload_valid(payload),
    "EBool" => payload == "true" || payload == "false",
    "EString" => true,
    "EIdent" => true,
    "EUnit" => payload == "",
    _ => false
  }
}

fn leaf_payload_direct_return_artifact_valid(entries: Array[(Array[Int], Array[Int], String, String, String)]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(entries) && valid {
    let (statement_path, expression_path, kind, payload, _) = Array::get(entries, i)
    if !leaf_payload_direct_return_artifact_path_valid(statement_path) || !leaf_payload_direct_return_artifact_path_valid(expression_path) || !leaf_payload_direct_return_artifact_kind_payload_valid(kind, payload) {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn leaf_payload_direct_return_artifact_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

/// Complete-or-none conversion first reconciles the complete observation table
/// against the private retained-node authority, then filters selected leaves.
export fn checked_expression_leaf_payload_direct_return_artifact_from_observation(observation: CheckedDirectExpressionReturnObservation) -> Option[CheckedExpressionLeafPayloadDirectReturnArtifact] {
  match checked_expression_structure_rows(observation.checked_program.checked_stmts) {
    None => None,
    Some(authority) => if Array::length(authority) != Array::length(observation.entries) {
      None
    } else {
      let raw_types = array_empty()
      let mut i = 0
      let mut valid = true
      while i < Array::length(authority) && valid {
        let (statement_path, expression_path, _) = Array::get(authority, i)
        let (actual_statement_path, actual_expression_path, ty) = Array::get(observation.entries, i)
        if !leaf_payload_direct_return_artifact_paths_equal(statement_path, actual_statement_path) || !leaf_payload_direct_return_artifact_paths_equal(expression_path, actual_expression_path) {
          valid = false
        } else {
          Array::push(raw_types, ty)
          i = i + 1
        }
      }
      if !valid {
        None
      } else {
        match checked_expression_structure_leaf_rows(observation.checked_program.checked_stmts) {
          None => None,
          Some(leaves) => {
            let types = canonical_checked_occurrence_type_fields(raw_types, observation.checked_program.final_subst)
            if Array::length(types) != Array::length(authority) {
              None
            } else {
              let entries = array_empty()
              let mut row = 0
              let mut leaf = 0
              while row < Array::length(authority) {
                let (statement_path, expression_path, _) = Array::get(authority, row)
                if leaf < Array::length(leaves) {
                  let (leaf_statement_path, leaf_expression_path, kind, payload) = Array::get(leaves, leaf)
                  if leaf_payload_direct_return_artifact_paths_equal(statement_path, leaf_statement_path) && leaf_payload_direct_return_artifact_paths_equal(expression_path, leaf_expression_path) {
                    Array::push(entries, (leaf_payload_direct_return_artifact_copy_path(statement_path), leaf_payload_direct_return_artifact_copy_path(expression_path), leaf_payload_direct_return_artifact_copy_string(kind), leaf_payload_direct_return_artifact_copy_string(payload), leaf_payload_direct_return_artifact_copy_string(Array::get(types, row))))
                    leaf = leaf + 1
                  } else {
                    ()
                  }
                } else {
                  ()
                }
                row = row + 1
              }
              if leaf != Array::length(leaves) || !leaf_payload_direct_return_artifact_valid(entries) {
                None
              } else {
                Some(CheckedExpressionLeafPayloadDirectReturnArtifact::{
                  entries: entries
                })
              }
            }
          }
        }
      }
    }
  }
}

fn leaf_payload_direct_return_artifact_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, __to_string(value))
  StringBuilder::push(out, ":")
}

fn leaf_payload_direct_return_artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  leaf_payload_direct_return_artifact_push_int(out, String::length(text))
  StringBuilder::push(out, text)
}

fn leaf_payload_direct_return_artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(path) {
    leaf_payload_direct_return_artifact_push_int(out, Array::get(path, i))
    i = i + 1
  }
  StringBuilder::push(out, "]")
}

fn leaf_payload_direct_return_artifact_entry(statement_path: Array[Int], expression_path: Array[Int], kind: String, payload: String, ty: String) -> String {
  let out = StringBuilder::new()
  leaf_payload_direct_return_artifact_push_path(out, statement_path)
  leaf_payload_direct_return_artifact_push_path(out, expression_path)
  leaf_payload_direct_return_artifact_push_piece(out, kind)
  leaf_payload_direct_return_artifact_push_piece(out, payload)
  leaf_payload_direct_return_artifact_push_piece(out, ty)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder preserving preorder.
export fn encode_checked_expression_leaf_payload_direct_return_artifact_v1(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(artifact.entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, kind, payload, ty) = Array::get(artifact.entries, i)
    leaf_payload_direct_return_artifact_push_piece(out, leaf_payload_direct_return_artifact_entry(statement_path, expression_path, kind, payload, ty))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn leaf_payload_direct_return_artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end || bound < 0 {
    None
  } else {
    let mut valid = true
    let mut value = 0
    let mut i = start
    if end - start > 1 && String::char_code_at(text, start) == 48 {
      valid = false
    }
    while i < end && valid {
      let digit = String::char_code_at(text, i) - 48
      if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
        valid = false
      } else {
        value = value * 10 + digit
        i = i + 1
      }
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn leaf_payload_direct_return_artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match leaf_payload_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn leaf_payload_direct_return_artifact_path_parse(text: String, pos: Int) -> Option[(Array[Int], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match leaf_payload_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => if count > n - at - 1 {
        None
      } else {
        let path = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          let start = cursor
          while cursor < n && String::char_code_at(text, cursor) != 58 {
            cursor = cursor + 1
          }
          if cursor == start || cursor >= n {
            valid = false
          } else {
            match leaf_payload_direct_return_artifact_decimal(text, start, cursor, (2305843009213693951<<1)|1) {
              Some(value) => {
                Array::push(path, value); cursor = cursor + 1
              },
              None => {
                valid = false
              }
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((path, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn leaf_payload_direct_return_artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match leaf_payload_direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => if count > n - at - 1 {
        None
      } else {
        let out = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          match leaf_payload_direct_return_artifact_piece_parse(text, cursor) {
            Some((item, next)) => {
              Array::push(out, item); cursor = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((out, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn leaf_payload_direct_return_artifact_entry_parse(text: String) -> Option[(Array[Int], Array[Int], String, String, String)] {
  match leaf_payload_direct_return_artifact_path_parse(text, 0) {
    Some((statement_path, after_statement)) => match leaf_payload_direct_return_artifact_path_parse(text, after_statement) {
      Some((expression_path, after_expression)) => match leaf_payload_direct_return_artifact_piece_parse(text, after_expression) {
        Some((kind, after_kind)) => match leaf_payload_direct_return_artifact_piece_parse(text, after_kind) {
          Some((payload, after_payload)) => match leaf_payload_direct_return_artifact_piece_parse(text, after_payload) {
            Some((ty, end)) => if end == String::length(text) {
              Some((statement_path, expression_path, kind, payload, ty))
            } else {
              None
            },
            None => None
          },
          None => None
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

/// Strict v1 decoder. Counts and lengths are bounded by remaining input and
/// exact re-encoding rejects every noncanonical representation.
export fn decode_checked_expression_leaf_payload_direct_return_artifact_v1(text: String) -> Option[CheckedExpressionLeafPayloadDirectReturnArtifact] {
  let prefix = "vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n"
  if !String::starts_with(text, prefix) {
    None
  } else {
    match leaf_payload_direct_return_artifact_array_parse(text, String::length(prefix)) {
      Some((raw_rows, end)) => {
        let rows = array_empty()
        let mut valid = end == String::length(text)
        let mut i = 0
        while i < Array::length(raw_rows) && valid {
          match leaf_payload_direct_return_artifact_entry_parse(Array::get(raw_rows, i)) {
            Some(row) => Array::push(rows, row),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !leaf_payload_direct_return_artifact_valid(rows) {
          None
        } else {
          let artifact = CheckedExpressionLeafPayloadDirectReturnArtifact::{
            entries: leaf_payload_direct_return_artifact_copy_rows(rows)
          }
          if encode_checked_expression_leaf_payload_direct_return_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Deterministic opaque snapshot. Decoded bytes do not attest checking, type
/// semantics, provenance, binding, full typed IR, cache/reuse, or trace.
export fn canonical_checked_expression_leaf_payload_direct_return_artifact_snapshot(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n")
  leaf_payload_direct_return_artifact_push_int(out, Array::length(artifact.entries))
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, kind, payload, ty) = Array::get(artifact.entries, i)
    leaf_payload_direct_return_artifact_push_int(out, Array::length(statement_path))
    let mut j = 0
    while j < Array::length(statement_path) {
      leaf_payload_direct_return_artifact_push_int(out, Array::get(statement_path, j)); j = j + 1
    }
    leaf_payload_direct_return_artifact_push_int(out, Array::length(expression_path))
    let mut k = 0
    while k < Array::length(expression_path) {
      leaf_payload_direct_return_artifact_push_int(out, Array::get(expression_path, k)); k = k + 1
    }
    leaf_payload_direct_return_artifact_push_piece(out, kind)
    leaf_payload_direct_return_artifact_push_piece(out, payload)
    leaf_payload_direct_return_artifact_push_piece(out, ty)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_expression_leaf_payload_direct_return_artifact_row_count(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact) -> Int {
  Array::length(artifact.entries)
}

export fn checked_expression_leaf_payload_direct_return_artifact_statement_path_at(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (path, _, _, _, _) = Array::get(artifact.entries, row_index)
    Some(leaf_payload_direct_return_artifact_copy_path(path))
  }
}

export fn checked_expression_leaf_payload_direct_return_artifact_expression_path_at(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, path, _, _, _) = Array::get(artifact.entries, row_index)
    Some(leaf_payload_direct_return_artifact_copy_path(path))
  }
}

/// One of EInt, EBool, EString, EIdent, or EUnit.
export fn checked_expression_leaf_payload_direct_return_artifact_kind_at(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, kind, _, _) = Array::get(artifact.entries, row_index)
    Some(leaf_payload_direct_return_artifact_copy_string(kind))
  }
}

/// Exact retained literal content/name, with no binding or source claim.
export fn checked_expression_leaf_payload_direct_return_artifact_payload_at(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, _, payload, _) = Array::get(artifact.entries, row_index)
    Some(leaf_payload_direct_return_artifact_copy_string(payload))
  }
}

/// Canonical direct checker-return type text for a selected retained leaf.
export fn checked_expression_leaf_payload_direct_return_artifact_type_at(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, _, _, ty) = Array::get(artifact.entries, row_index)
    Some(leaf_payload_direct_return_artifact_copy_string(ty))
  }
}
