//# Statement-owner typed-occurrence observation (#1379 Phase 3)
//
// This deliberately records only the retained post-desugar statement that
// owned each checker-time legacy typed_occurrences append. It is not
// expression/role provenance, source-offset recovery, edit-stable typed IR,
// cache/reuse input, trace schema, interface, import transport, or codec. The
// first intentional erasure point is the expression tree inside that statement.

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  CheckedTypedOccurrenceStatementObservation, canonical_checked_occurrence_type_fields
}

fn snapshot_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, value = __to_string(value))
  StringBuilder::push(out, value = ":")
}

fn snapshot_push_piece(out: StringBuilder, value: String) -> Unit {
  snapshot_push_int(out = out, value = String::length(value))
  StringBuilder::push(out, value = value)
}

fn snapshot_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  snapshot_push_int(out = out, value = Array::length(path))
  let mut i = 0
  while i < Array::length(path) {
    snapshot_push_int(out = out, value = Array::get(path, at = i))
    i = i + 1
  }
}

/// Deterministic, length-delimited capture-order snapshot. It omits legacy
/// offsets by design and applies final_subst through the shared canonical
/// type machinery before emitting each row type.
export fn canonical_checked_typed_occurrence_statement_snapshot(_ observation: CheckedTypedOccurrenceStatementObservation) -> String {
  let raw_types = array_empty()
  let mut i = 0
  while i < Array::length(observation.entries) {
    let (_, _, ty) = Array::get(observation.entries, at = i)
    Array::push(raw_types, value = ty)
    i = i + 1
  }
  let types = canonical_checked_occurrence_type_fields(types = raw_types, s = observation.checked_program.final_subst)
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-typed-occurrence-statement-observation:v1\n")
  snapshot_push_int(out = out, value = Array::length(observation.entries))
  let mut j = 0
  while j < Array::length(observation.entries) {
    let (path, ordinal, _) = Array::get(observation.entries, at = j)
    snapshot_push_path(out = out, path = path)
    snapshot_push_int(out = out, value = ordinal)
    snapshot_push_piece(out = out, value = Array::get(types, at = j))
    j = j + 1
  }
  StringBuilder::freeze(out)
}

/// Row count is exposed without making the observation's retained capture
/// representation transparent at the package boundary.
export fn checked_typed_occurrence_statement_observation_row_count(_ observation: CheckedTypedOccurrenceStatementObservation) -> Int {
  Array::length(observation.entries)
}

/// Return an independent exact retained statement path for a captured row.
/// The observation stays opaque; invalid row indexes have no path.
export fn checked_typed_occurrence_statement_observation_statement_path_at(observation: CheckedTypedOccurrenceStatementObservation, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(observation.entries) {
    None
  } else {
    let (path, _, _) = Array::get(observation.entries, at = row_index)
    Some(Array::slice(path, start = 0, end = Array::length(path)))
  }
}

/// Return the exact capture ordinal within the row's retained statement path.
/// Invalid row indexes have no ordinal.
export fn checked_typed_occurrence_statement_observation_capture_ordinal_at(observation: CheckedTypedOccurrenceStatementObservation, row_index: Int) -> Option[Int] {
  if row_index < 0 || row_index >= Array::length(observation.entries) {
    None
  } else {
    let (_, ordinal, _) = Array::get(observation.entries, at = row_index)
    Some(ordinal)
  }
}
