//# Imports

// Pure re-export facade. (This file used to ALSO import check_* and then
// re-declare everything in bare `export { ... }` blocks; a bare export of a
// name with no local def resolves to "undefined variable (local)" under the
// FS merge — the flat bundle's first-match hid it. #726.)

export ./builtins.vibe {
  lookup_builtin
}

export ./checker.vibe {
  check_expr
}

export ./checker_pattern.vibe {
  check_pattern, pat_has_unsupported_or_binding
}

export ./checker_resolve.vibe {
  resolve_type_expr
}

export ./canonical_checked_type_state.vibe {
  canonical_checked_effect_row_snapshot,
  canonical_checked_type_defs_snapshot,
  canonical_checked_value_env_snapshot,
  canonical_effective_value_env_snapshot,
  canonical_retained_trait_impl_entries_snapshot,
  canonical_retained_trait_method_gens_snapshot
}

export ./checker_stmt.vibe {
  CheckedDirectExpressionReturnObservation,
  CheckedProgram,
  CheckedProgramTypeDefsObservation,
  CheckedStatementRootTypeObservation,
  CheckedTypedOccurrenceExpressionPathObservation,
  CheckedTypedOccurrenceRoleLaneObservation,
  CheckedTypedOccurrenceStatementObservation,
  check_program,
  check_program_binder_occurrence_observation,
  check_program_direct_expression_return_observation,
  check_program_double_call_result_located_observation,
  check_program_double_call_result_observation,
  check_program_result,
  check_program_statement_root_type_observation,
  check_program_type_defs_observation,
  check_program_type_table,
  check_program_typed_occurrence_expression_path_observation,
  check_program_typed_occurrence_role_lane_observation,
  check_program_typed_occurrence_statement_observation,
  check_program_with_env,
  check_program_with_env_direct_expression_return_observation,
  check_program_with_env_result,
  check_program_with_env_statement_root_type_observation,
  check_program_with_env_type_defs_observation,
  check_program_with_env_typed_occurrence_expression_path_observation,
  check_program_with_env_typed_occurrence_role_lane_observation,
  check_program_with_env_typed_occurrence_statement_observation,
  check_program_with_projected_import_env_result,
  check_stmts
}
