import ./checker_parameter_defaults.vibe {
  checker_parameter_defaults
}

import @vibe/compiler/core {
  BindingOrigin, Expr, Stmt, Type, TypeEnv, env_bind, env_bind_with_origin, env_lookup, env_lookup_binding, param_names_prefix
}

import @vibe/core {
  struct MutMap
}

/// ADR-0120 D3 (#3681): the `_` slots of the program being checked, from its
/// trailing `SPositionalParams` statement. The root statement list publishes
/// them for the duration of its check (`checker_swap_positional_rows`); a
/// header built meanwhile spells each `_` slot `"_ " + name`. The space is
/// what no identifier holds, so only code that reads a header -- call
/// placement, the label sites -- ever sees the marker.
let positional_rows: Array[(String, Array[Int])] = Array::slice([("", [0])], start = 0, end = 0)

/// The `_` slots written in `stmts`, empty when none.
export fn checker_positional_rows_of(_ stmts: Array[Stmt]) -> Array[(String, Array[Int])] {
  let out: Array[(String, Array[Int])] = []
  for stmt in stmts {
    match stmt {
      SPositionalParams(rows) => for row in rows {
        Array::push(out, value = row)
      },
      _ => ()
    }
  }
  out
}

/// Publish `rows` and return the ones they replace, for the caller to restore.
export fn checker_swap_positional_rows(_ rows: Array[(String, Array[Int])]) -> Array[(String, Array[Int])] {
  let saved = Array::slice(positional_rows, start = 0, end = Array::length(positional_rows))
  Array::truncate(positional_rows, length = 0)
  for row in rows {
    Array::push(positional_rows, value = row)
  }
  saved
}

/// Is header name `raw` a `_` slot?
export fn checker_header_name_is_positional(_ raw: String) -> Bool {
  String::starts_with(raw, prefix = "_ ")
}

fn positional_header_names(name: String, raw: Array[String]) -> Array[String] {
  if Array::length(positional_rows) == 0 {
    raw
  } else {
    let names = Array::slice(raw, start = 0, end = Array::length(raw))
    for row in positional_rows {
      let (decl, slots) = row
      if decl == name {
        for slot in slots {
          if slot >= 0 && slot < Array::length(names) && !checker_header_name_is_positional(Array::get(names, at = slot)) {
            Array::set(names, at = slot, value = "_ " + Array::get(names, at = slot))
          } else {
            ()
          }
        }
      } else {
        ()
      }
    }
    names
  }
}

/// Bind a declaration header on the same value binding typing will resolve.
/// Later calls can request labels, so every declaration retains its names.
/// A local `let` lambda comes here too, and has no `_` slots of its own.
export fn checker_bind_call_header(env: TypeEnv, name: String, ty: Type, value: Expr) -> TypeEnv {
  bind_call_header(env = env, name = name, ty = ty, value = value, declaration = false)
}

/// The same, for a declaration in a program or module statement list, whose
/// `_` slots the published rows name.
export fn checker_bind_declaration_call_header(env: TypeEnv, name: String, ty: Type, value: Expr) -> TypeEnv {
  bind_call_header(env = env, name = name, ty = ty, value = value, declaration = true)
}

/// ADR-0120 Phase 4: the header each declaration of the program being
/// checked was bound with. A local `let` lambda gets a header of the same
/// shape (labels on it still place), but its call stays positional; a call is
/// to a declaration when the header it resolved to is the one recorded here.
let declared_headers: Array[MutMap[String, Array[String]]] = [
  MutMap::new_string()
]

/// Forget the declarations of an earlier check.
export fn checker_declared_headers_reset() -> Unit {
  Array::set(declared_headers, at = 0, value = MutMap::new_string())
}

fn declared_header_is(name: String, names: Array[String]) -> Bool {
  match MutMap::get(Array::get(declared_headers, at = 0), k = name) {
    Some(found) => found == names,
    None => false
  }
}

/// Whether a call to `name` in `env` calls a declaration -- a top-level `fn`
/// or lambda-initialized `let`, an import, or a re-export -- rather than a
/// local lambda or a value. Only such a call must label its arguments.
export fn checker_call_header_is_declaration(env: TypeEnv, name: String) -> Bool {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginModuleFunctionHeader(_, _, _, _) => true,
      BindingOriginReExportFunctionHeader(_, _, _, _) => true,
      BindingOriginModuleExport(_, _) => true,
      BindingOriginFunctionHeader(names) => declared_header_is(name = name, names = names),
      BindingOriginDefaultedFunctionHeader(names, _) => declared_header_is(name = name, names = names),
      _ => false
    },
    None => false
  }
}

/// A `Trait::op` wrapper the trait-namespace derivation synthesized: its body
/// forwards to the implementation through a call at the derivation's
/// synthetic offset (-2). The trait's signature names no parameter, so every
/// slot of the wrapper is positional (`Mappable::map(xs, f)`).
fn synthesized_trait_operation(_ value: Expr) -> Bool {
  match value {
    EFn(_, _, _, _, _, body) => match body {
      ECall(EIdent(_, callee_off), _, off, _) => off == 0 - 2 && callee_off == 0 - 2,
      _ => false
    },
    _ => false
  }
}

fn bind_call_header(env: TypeEnv, name: String, ty: Type, value: Expr, declaration: Bool) -> TypeEnv {
  match value {
    EFn(_, _, params, _, _, _) => {
      let raw_names = for param in params {
        let (raw, _) = param
        raw
      }
      let names = if declaration && synthesized_trait_operation(value) {
        for raw in raw_names {
          "_ " + raw
        }
      } else if declaration {
        positional_header_names(name = name, raw = raw_names)
      } else {
        raw_names
      }
      if declaration {
        MutMap::set(Array::get(declared_headers, at = 0), k = name, v = names)
      } else {
        ()
      }
      let origin = match checker_parameter_defaults(value) {
        Some(flags) => BindingOriginDefaultedFunctionHeader(names, flags),
        None => BindingOriginFunctionHeader(names)
      }
      env_bind_with_origin(env = env, name = name, ty = ty, origin = origin)
    },
    _ => env_bind(env = env, name = name, ty = ty)
  }
}

fn header_names_have_optional(_ names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    found = String::ends_with(Array::get(names, at = i), suffix = "?")
    i = i + 1
  }
  found
}

/// Ordinary positional calls need only optional-slot demand. Inspect the
/// selected binding without copying an imported header's field names.
export fn checker_call_header_has_optional(env: TypeEnv, name: String) -> Bool {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginFunctionHeader(names) => header_names_have_optional(names),
      BindingOriginModuleFunctionHeader(_, _, names, _) => header_names_have_optional(names),
      BindingOriginDefaultedFunctionHeader(names, _) => header_names_have_optional(names),
      BindingOriginMutableFunctionHeader(box) => {
        let (kind, names, _) = Array::get(box, at = 0)
        kind == 1 && header_names_have_optional(names)
      },
      BindingOriginModuleExport(_, _) => match env_lookup(env = env, name = String::concat(param_names_prefix, name)) {
        Some(CtRecord(fields)) => {
          let mut i = 0
          let mut found = false
          while i < Array::length(fields) && !found {
            let (raw, _) = Array::get(fields, at = i)
            found = String::ends_with(raw, suffix = "?")
            i = i + 1
          }
          found
        },
        _ => false
      },
      _ => false
    },
    None => false
  }
}

/// A value/parameter shadow has Unavailable provenance, so it cannot inherit
/// a same-typed outer function's labels. Imported declarations retain names
/// on their value binding; legacy module headers use a companion marker.
export fn checker_call_header_names(env: TypeEnv, name: String) -> Option[Array[String]] {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginFunctionHeader(names) => Some(names),
      BindingOriginModuleFunctionHeader(_, _, names, _) => Some(names),
      BindingOriginDefaultedFunctionHeader(names, _) => Some(names),
      BindingOriginMutableFunctionHeader(box) => {
        let (kind, names, _) = Array::get(box, at = 0)
        if kind == 1 {
          Some(names)
        } else {
          None
        }
      },
      BindingOriginModuleExport(_, _) => match env_lookup(env = env, name = String::concat(param_names_prefix, name)) {
        Some(CtRecord(fields)) => Some(for field in fields {
          let (raw, _) = field
          raw
        }),
        _ => None
      },
      _ => None
    },
    None => None
  }
}

/// The standalone checker API also accepts explicit imported parameter-name
/// companions without a module path. Promote those input declarations once;
/// later ordinary bindings automatically clear their header provenance.
export fn checker_seed_import_call_headers(env: TypeEnv, imported: Array[(String, Array[String])]) -> TypeEnv {
  let mut out = env
  for row in imported {
    let (name, names) = row
    match env_lookup_binding(env = env, name = name) {
      Some(binding) => match binding.origin {
        BindingOriginUnavailable => out = env_bind_with_origin(env = out, name = name, ty = binding.ty, origin = BindingOriginFunctionHeader(names)),
        _ => ()
      },
      None => ()
    }
  }
  out
}

/// Only the binding selected by typing can contribute parameter defaults.
export fn checker_call_header_defaults(env: TypeEnv, name: String) -> Option[Array[Bool]] {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginDefaultedFunctionHeader(_, flags) => Some(flags),
      // #3440: an imported declaration carries its bits on the header.
      BindingOriginModuleFunctionHeader(_, _, _, flags) => if Array::length(flags) > 0 {
        Some(flags)
      } else {
        None
      },
      BindingOriginReExportFunctionHeader(_, _, _, flags) => if Array::length(flags) > 0 {
        Some(flags)
      } else {
        None
      },
      _ => None
    },
    None => None
  }
}
