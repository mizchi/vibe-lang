import @vibe/core {
  array_empty
}

import ./checker_parameter_defaults.vibe {
  checker_parameter_defaults
}

import @vibe/compiler/core {
  BindingOrigin,
  Expr,
  Stmt,
  Type,
  TypeEnv,
  canonical_builtin_name,
  env_bind,
  env_bind_with_origin,
  env_lookup,
  env_lookup_binding,
  param_names_prefix,
  record_alias_target
}

import @vibe/core {
  struct MutMap
}

/// ADR-0120 D3 (#3681): the `_` slots of the program being checked, from its
/// trailing `SPositionalParams` statement. The root statement list publishes
/// them for the duration of its check (`checker_swap_positional_rows`); a
/// header built meanwhile spells each `_` slot `"_ " + name`. The space is
/// what no identifier holds, so only code that reads a header -- call
/// placement, the label sites -- ever sees the marker.
let positional_rows: Array[(String, Array[Int])] = Array::slice([("", [0])], start = 0, end = 0)

/// The `_` slots written in `stmts`, empty when none. #3837: the rows also
/// name each alias a struct literal may be written through -- a `type` alias
/// the file declares and a name it imports with `as` -- under a key no
/// function name can spell (`checker_record_alias_is_local`).
export fn checker_positional_rows_of(_ stmts: Array[Stmt]) -> Array[(String, Array[Int])] {
  let out: Array[(String, Array[Int])] = []
  for stmt in stmts {
    match stmt {
      SPositionalParams(rows) => for row in rows {
        Array::push(out, value = row)
      },
      STypeAlias(_, name, params, target) => {
        Array::push(out, value = (record_alias_row_key(name), array_empty()))
        match record_alias_target(params = params, target = target) {
          Some(t) => Array::push(out, value = (record_alias_target_row_key(name = name, target = t), array_empty())),
          None => ()
        }
      },
      SImport(_, items) => for item in items {
        match item.alias {
          Some(alias) => {
            Array::push(out, value = (record_alias_row_key(alias), array_empty()))
            Array::push(out, value = (record_alias_target_row_key(name = alias, target = item.name), array_empty()))
          },
          None => ()
        }
      },
      _ => ()
    }
  }
  out
}

fn record_alias_row_key(_ name: String) -> String {
  String::concat("#record-alias ", name)
}

fn record_alias_target_prefix(_ name: String) -> String {
  String::concat("#record-alias-to ", String::concat(name, " "))
}

fn record_alias_target_row_key(name: String, target: String) -> String {
  String::concat(record_alias_target_prefix(name), target)
}

/// #3837: the name a local alias stands for as the file spells it -- the
/// head of `type M = R`, or `X` of `import ./a.vibe { X as Q }` -- when the
/// alias passes its own parameters through. Lowering renames a literal
/// through the file's own aliases one hop at a time, and through nothing else.
export fn checker_record_alias_target(_ name: String) -> Option[String] {
  let prefix = record_alias_target_prefix(name)
  let mut found = None
  for row in positional_rows {
    let (n, _) = row
    if String::starts_with(n, prefix = prefix) {
      found = Some(String::substring(n, start = String::length(prefix), end = String::length(n)))
    }
  }
  found
}

/// #3837: whether the program being checked declares `name` itself, as a
/// `type` alias or an `as` import. Lowering renames a struct literal written
/// through such an alias to the struct it names; an alias another module
/// declares and this one imports under its own name it cannot see through,
/// so a literal through it would be laid out by its field set alone.
export fn checker_record_alias_is_local(_ name: String) -> Bool {
  let key = record_alias_row_key(name)
  let mut found = false
  for row in positional_rows {
    let (n, _) = row
    if n == key {
      found = true
    }
  }
  found
}

/// Publish `rows` and return the ones they replace, for the caller to restore.
export fn checker_swap_positional_rows(_ rows: Array[(String, Array[Int])]) -> Array[(String, Array[Int])] {
  let saved = Array::slice(positional_rows, start = 0, end = Array::length(positional_rows))
  Array::truncate(positional_rows, length = 0)
  for row in rows {
    Array::push(positional_rows, value = row)
  }
  saved
}

/// Is header name `raw` a `_` slot?
export fn checker_header_name_is_positional(_ raw: String) -> Bool {
  String::starts_with(raw, prefix = "_ ")
}

fn positional_header_names(name: String, raw: Array[String]) -> Array[String] {
  if Array::length(positional_rows) == 0 {
    raw
  } else {
    let names = Array::slice(raw, start = 0, end = Array::length(raw))
    for row in positional_rows {
      let (decl, slots) = row
      if decl == name {
        for slot in slots {
          if slot >= 0 && slot < Array::length(names) && !checker_header_name_is_positional(Array::get(names, at = slot)) {
            Array::set(names, at = slot, value = "_ " + Array::get(names, at = slot))
          } else {
            ()
          }
        }
      } else {
        ()
      }
    }
    names
  }
}

/// Bind a declaration header on the same value binding typing will resolve.
/// Later calls can request labels, so every declaration retains its names.
/// A local `let` lambda comes here too, and has no `_` slots of its own.
export fn checker_bind_call_header(env: TypeEnv, name: String, ty: Type, value: Expr) -> TypeEnv {
  bind_call_header(env = env, name = name, ty = ty, value = value, declaration = false)
}

/// The same, for a declaration in a program or module statement list, whose
/// `_` slots the published rows name.
export fn checker_bind_declaration_call_header(env: TypeEnv, name: String, ty: Type, value: Expr) -> TypeEnv {
  bind_call_header(env = env, name = name, ty = ty, value = value, declaration = true)
}

/// ADR-0120 Phase 4: the header each declaration of the program being
/// checked was bound with. A local `let` lambda gets a header of the same
/// shape (labels on it still place), but its call stays positional; a call is
/// to a declaration when the header it resolved to is the one recorded here.
let declared_headers: Array[MutMap[String, Array[String]]] = [
  MutMap::new_string()
]

/// The declaration names a local lambda has shadowed in this check (Codex on
/// #3881). Equal parameter names cannot tell the two headers apart, so such a
/// local also binds `local_shadow_marker(name)` beside itself; the marker is
/// in scope exactly where the local is. Only a name listed here pays for the
/// marker lookup.
let locally_shadowed: Array[MutMap[String, Bool]] = [MutMap::new_string()]

/// The names this check bound to a local lambda's header (ADR-0120 Phase
/// 4b). Each such local also binds `local_shadow_marker(name)` beside
/// itself, so the marker is in scope exactly where the local is. A header
/// neither registered as a declaration nor under a marker came in through
/// the supplied environment -- a declaration whose caller did not register
/// it -- so its call names its arguments. Only a name listed here pays for
/// the marker lookup; a stale entry (a scope that ended, an earlier
/// standalone check) costs that lookup and nothing else.
let local_headers: Array[MutMap[String, Bool]] = [MutMap::new_string()]

/// Forget the declarations of an earlier check.
export fn checker_declared_headers_reset() -> Unit {
  Array::set(declared_headers, at = 0, value = MutMap::new_string())
  Array::set(locally_shadowed, at = 0, value = MutMap::new_string())
  Array::set(local_headers, at = 0, value = MutMap::new_string())
}

fn local_shadow_marker(_ name: String) -> String {
  String::concat("#local_call_header:", name)
}

fn declared_header_is(env: TypeEnv, name: String, names: Array[String]) -> Bool {
  match MutMap::get(Array::get(declared_headers, at = 0), k = name) {
    Some(found) => if found != names {
      false
    } else {
      match MutMap::get(Array::get(locally_shadowed, at = 0), k = name) {
        Some(_) => match env_lookup_binding(env = env, name = local_shadow_marker(name)) {
          Some(_) => false,
          None => true
        },
        None => true
      }
    },
    None => if MutMap::has(Array::get(local_headers, at = 0), k = name) {
      match env_lookup_binding(env = env, name = local_shadow_marker(name)) {
        Some(_) => false,
        None => true
      }
    } else {
      true
    }
  }
}

/// Whether a call to `name` in `env` calls a declaration -- a top-level `fn`
/// or lambda-initialized `let`, an import, or a re-export -- rather than a
/// local lambda or a value. Only such a call must label its arguments.
export fn checker_call_header_is_declaration(env: TypeEnv, name: String) -> Bool {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginModuleFunctionHeader(_, _, _, _) => true,
      BindingOriginReExportFunctionHeader(_, _, _, _) => true,
      BindingOriginModuleExport(_, _) => true,
      BindingOriginFunctionHeader(names) => declared_header_is(env = env, name = name, names = names),
      BindingOriginDefaultedFunctionHeader(names, _) => declared_header_is(env = env, name = name, names = names),
      _ => false
    },
    None => false
  }
}

/// A `Trait::op` wrapper the trait-namespace derivation synthesized: its body
/// forwards to the implementation through a call at the derivation's
/// synthetic offset (-2). The trait's signature names no parameter, so every
/// slot of the wrapper is positional (`Mappable::map(xs, f)`).
fn synthesized_trait_operation(_ value: Expr) -> Bool {
  match value {
    EFn(_, _, _, _, _, body) => match body {
      ECall(EIdent(_, callee_off), _, off, _) => off == 0 - 2 && callee_off == 0 - 2,
      _ => false
    },
    _ => false
  }
}

fn bind_call_header(env: TypeEnv, name: String, ty: Type, value: Expr, declaration: Bool) -> TypeEnv {
  match value {
    EFn(_, _, params, _, _, _) => {
      let raw_names = for param in params {
        let (raw, _) = param
        raw
      }
      let names = if declaration && synthesized_trait_operation(value) {
        for raw in raw_names {
          "_ " + raw
        }
      } else if declaration {
        positional_header_names(name = name, raw = raw_names)
      } else {
        raw_names
      }
      // A local lambda carries a marker in its scope.
      let scoped = if declaration {
        MutMap::set(Array::get(declared_headers, at = 0), k = name, v = names)
        env
      } else {
        MutMap::set(Array::get(local_headers, at = 0), k = name, v = true)
        match MutMap::get(Array::get(declared_headers, at = 0), k = name) {
          Some(_) => MutMap::set(Array::get(locally_shadowed, at = 0), k = name, v = true),
          None => ()
        }
        env_bind(env = env, name = local_shadow_marker(name), ty = ty)
      }
      let origin = match checker_parameter_defaults(value) {
        Some(flags) => BindingOriginDefaultedFunctionHeader(names, flags),
        None => BindingOriginFunctionHeader(names)
      }
      env_bind_with_origin(env = scoped, name = name, ty = ty, origin = origin)
    },
    _ => env_bind(env = env, name = name, ty = ty)
  }
}

fn header_names_have_optional(_ names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    found = String::ends_with(Array::get(names, at = i), suffix = "?")
    i = i + 1
  }
  found
}

/// Ordinary positional calls need only optional-slot demand. Inspect the
/// selected binding without copying an imported header's field names.
export fn checker_call_header_has_optional(env: TypeEnv, name: String) -> Bool {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginFunctionHeader(names) => header_names_have_optional(names),
      BindingOriginModuleFunctionHeader(_, _, names, _) => header_names_have_optional(names),
      BindingOriginDefaultedFunctionHeader(names, _) => header_names_have_optional(names),
      BindingOriginMutableFunctionHeader(box) => {
        let (kind, names, _) = Array::get(box, at = 0)
        kind == 1 && header_names_have_optional(names)
      },
      BindingOriginModuleExport(_, _) => match env_lookup(env = env, name = String::concat(param_names_prefix, name)) {
        Some(CtRecord(fields)) => {
          let mut i = 0
          let mut found = false
          while i < Array::length(fields) && !found {
            let (raw, _) = Array::get(fields, at = i)
            found = String::ends_with(raw, suffix = "?")
            i = i + 1
          }
          found
        },
        _ => false
      },
      _ => false
    },
    None => false
  }
}

/// A value/parameter shadow has Unavailable provenance, so it cannot inherit
/// a same-typed outer function's labels. Imported declarations retain names
/// on their value binding; legacy module headers use a companion marker.
export fn checker_call_header_names(env: TypeEnv, name: String) -> Option[Array[String]] {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginFunctionHeader(names) => Some(names),
      BindingOriginModuleFunctionHeader(_, _, names, _) => Some(names),
      BindingOriginDefaultedFunctionHeader(names, _) => Some(names),
      BindingOriginMutableFunctionHeader(box) => {
        let (kind, names, _) = Array::get(box, at = 0)
        if kind == 1 {
          Some(names)
        } else {
          None
        }
      },
      BindingOriginModuleExport(_, _) => match env_lookup(env = env, name = String::concat(param_names_prefix, name)) {
        Some(CtRecord(fields)) => Some(for field in fields {
          let (raw, _) = field
          raw
        }),
        _ => None
      },
      _ => None
    },
    None => None
  }
}

/// The standalone checker API also accepts explicit imported parameter-name
/// companions without a module path. Promote those input declarations once;
/// later ordinary bindings automatically clear their header provenance.
export fn checker_seed_import_call_headers(env: TypeEnv, imported: Array[(String, Array[String])]) -> TypeEnv {
  let mut out = env
  for row in imported {
    let (name, names) = row
    match env_lookup_binding(env = env, name = name) {
      Some(binding) => match binding.origin {
        // An imported declaration: a call to it labels its arguments as a
        // filesystem import's would (Codex on #3881).
        BindingOriginUnavailable => {
          MutMap::set(Array::get(declared_headers, at = 0), k = name, v = names)
          out = env_bind_with_origin(env = out, name = name, ty = binding.ty, origin = BindingOriginFunctionHeader(names))
        },
        _ => ()
      },
      None => ()
    }
  }
  out
}

/// Only the binding selected by typing can contribute parameter defaults.
export fn checker_call_header_defaults(env: TypeEnv, name: String) -> Option[Array[Bool]] {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => checker_header_defaults_of(binding.origin),
    None => None
  }
}

/// The parameter defaults a binding's origin carries, for a caller that has
/// already looked the binding up.
export fn checker_header_defaults_of(_ origin: BindingOrigin) -> Option[Array[Bool]] {
  match origin {
    BindingOriginDefaultedFunctionHeader(_, flags) => Some(flags),
    // #3440: an imported declaration carries its bits on the header.
    BindingOriginModuleFunctionHeader(_, _, _, flags) => if Array::length(flags) > 0 {
      Some(flags)
    } else {
      None
    },
    BindingOriginReExportFunctionHeader(_, _, _, flags) => if Array::length(flags) > 0 {
      Some(flags)
    } else {
      None
    },
    _ => None
  }
}

/// #3832: the binding that records which builtin an imported alias stands for.
/// `import @vibe/builtin { String as S }` binds `S::starts_with` with the
/// builtin's signature (#3758); this marker, bound beside it to a one-field
/// record naming `String::starts_with`, lets call placement and the label
/// sites check `S::starts_with("ab", prefix = "a")` by the builtin's own
/// labels, the way the canonical spelling is checked. The import-alias rewrite
/// spells the call canonically before code generation, so the labels checked
/// are the labels the lowering reads. No source identifier can spell it.
export fn builtin_alias_marker(_ name: String) -> String {
  String::concat("#builtin-alias:", name)
}

/// #3888: the marker an import binds beside a builtin TYPE it renames
/// (`{ Float64 as F }`), naming the type it stands for, so `F::ceil` can be
/// read as `Float64::ceil` whatever module the type came through.
export fn builtin_type_alias_marker(_ name: String) -> String {
  String::concat("#builtin-type-alias:", name)
}

/// #3888: the builtin a qualified name `A::m` stands for when `A` is an import
/// alias of a builtin type, or `None`. A direct `import @vibe/builtin { Float64
/// as G }` binds `G::*` from the builtin module's own markers; a facade that
/// re-exports `Float64` publishes only the type, so `import ./m.vibe { Float64
/// as F }` reached `F` as a type and `F::ceil` as an unknown name. The import
/// alias rewrite already spells the call `Float64::ceil` for lowering.
///
/// The marker is trusted only while `F` itself still resolves to that import:
/// a value binder of the same spelling (`fn f(F: Int)`) shadows the alias, the
/// rewrite then leaves `F::ceil` alone, and accepting it reached code
/// generation unresolved (Codex on #3902).
export fn builtin_type_alias_member(env: TypeEnv, name: String) -> Option[String] {
  let sep = String::index_of(name, needle = "::")
  if sep <= 0 {
    None
  } else {
    let head = String::substring(name, start = 0, end = sep)
    match env_lookup(env = env, name = builtin_type_alias_marker(head)) {
      Some(CtRecord(fields)) => if Array::length(fields) == 1 {
        let (canonical, _) = Array::get(fields, at = 0)
        if builtin_type_alias_still_bound(env = env, head = head, canonical = canonical) {
          Some(String::concat(canonical, String::substring(name, start = sep, end = String::length(name))))
        } else {
          None
        }
      } else {
        None
      },
      _ => None
    }
  }
}

fn builtin_type_alias_still_bound(env: TypeEnv, head: String, canonical: String) -> Bool {
  match env_lookup_binding(env = env, name = head) {
    Some(binding) => match binding.origin {
      BindingOriginModuleExport(_, original) => original == canonical,
      BindingOriginReExportSurface(_, original) => original == canonical,
      _ => false
    },
    None => false
  }
}

/// The builtin `name` stands for when an import aliased it, else `None`.
///
/// The marker is a binding of its own, so a later binding of `name` -- a
/// local `let sw = (text: String, suffix: String) -> ..` -- does not hide it
/// (Codex on #3839). It counts only while the binding `name` resolves to is
/// still the import that bound it: an imported origin whose source is the
/// builtin itself.
///
/// This runs for every call placement checks and every qualified value
/// reference, so the binding is read first and the marker key is built and
/// looked up only for a renamed import.
export fn checker_builtin_alias_target(env: TypeEnv, name: String) -> Option[String] {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => checker_builtin_alias_of(env = env, name = name, origin = binding.origin),
    None => None
  }
}

/// `checker_builtin_alias_target` for a caller that has already looked up
/// the binding of `name`: the marker key is built and looked up only when the
/// origin is an import renamed from another source name.
export fn checker_builtin_alias_of(env: TypeEnv, name: String, origin: BindingOrigin) -> Option[String] {
  let source = match origin {
    BindingOriginModuleExport(_, original) => original,
    BindingOriginReExportSurface(_, original) => original,
    _ => name
  }
  if source == name {
    None
  } else {
    match env_lookup(env = env, name = builtin_alias_marker(name)) {
      Some(CtRecord(fields)) => if Array::length(fields) == 1 {
        let (canonical, _) = Array::get(fields, at = 0)
        if canonical_builtin_name(source) == canonical {
          Some(canonical)
        } else {
          None
        }
      } else {
        None
      },
      _ => None
    }
  }
}

/// The spelling to check a call to `name` as: the builtin an import aliased
/// it to, or `name` itself.
export fn checker_builtin_call_name(env: TypeEnv, name: String) -> String {
  match checker_builtin_alias_target(env = env, name = name) {
    Some(canonical) => canonical,
    None => match env_lookup(env = env, name = name) {
      Some(_) => name,
      None => match builtin_type_alias_member(env = env, name = name) {
        Some(canonical) => canonical,
        None => name
      }
    }
  }
}
