import @vibe/compiler/checker/diagnostics {
  attach_unlocated_decl_name_marker, off_marker_len
}
test "diagnostic markers preserve byte ranges and existing anchors" {
  inspect(off_marker_len(5, 3), content = " [@off=5:8]")
  let errors = ["return type mismatch", "return type mismatch [@off=5:8]"]
  attach_unlocated_decl_name_marker(errors, 0, "main")
  inspect(errors, content = "[return type mismatch [@fn=main], return type mismatch [@off=5:8]]")
}
