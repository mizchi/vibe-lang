/// Encode a real AST char offset into a strippable diagnostic marker so the
/// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode
/// the exact line:col instead of falling back to a first-occurrence text scan.
/// String::concat only (never `+` / interpolation — both mis-codegen to NUL
/// here). off < 0 => no marker (heuristic fallback retained).
export fn off_marker(off: Int) -> String {
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// Like off_marker but also encodes the offending token's END offset as
/// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an
/// EXACT source range (line:colC-E) instead of the LSP guessing the token end
/// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan
/// stops at the dot). Falls back to the start-only marker when len <= 0. Use this
/// where `off` is the START of a known-length named token (the symbol whose
/// length matches the source span); keep plain off_marker where the offset is an
/// anchor rather than the token start (e.g. a field error whose offset is the
/// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).
export fn off_marker_len(off: Int, len: Int) -> String {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else {
    off_marker(off)
  }
}

/// #3305: `[@off=N::PATH]` for a tuple or array literal, which has no offset
/// slot of its own. `N` is a located element INSIDE the literal and `PATH` the
/// brackets from the literal down to that element, outermost first (`1` for
/// `[`, `2` for `(`). `locate_type_error` widens `N` to the outermost of those
/// brackets by matching the source tokens. The body stays digits and `:`, so a
/// reader that only knows `N` / `N:M` still reads `N` -- a position inside the
/// literal -- and every stripper still removes the whole marker. Falls back to
/// `off_marker` when `path` is empty.
export fn off_marker_enclosing(off: Int, path: String) -> String {
  if off >= 0 && String::length(path) > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat("::", String::concat(path, "]"))))
  } else {
    off_marker(off)
  }
}

/// #1941: a return-type mismatch whose tail is an offset-less literal
/// (EInt/EBool/EFloat; EString carries a parser offset since #2831) has no
/// `[@off=]`. Tag the enclosing binding name so `locate_type_error` can
/// recover the `fn` / `let` name token instead of falling through to the
/// synthetic `0:0` LSP range. Only rewrites errors that still have no
/// side-channel marker. Exported for checker_stmt's top-level SLet path.
export fn attach_unlocated_decl_name_marker(errors: Array[String], from: Int, name: String) -> Unit {
  if String::length(name) == 0 {
    ()
  } else {
    let n = Array::length(errors)
    let mut i = from
    while i < n {
      let msg = Array::get(errors, i)
      // #1941: `binding type mismatch` joins `return type mismatch` here. A
      // top-level `let a: Int = "x"` anchors on the VALUE, and a literal value
      // has no offset -- so that one diagnostic came out with no position at
      // all, while the same code inside a function was located (the local lane
      // goes through `ascribe_wrap`, which carries the binder offset).
      // `find_fn_anchor_off` already prefers `fn name` then `let name`, so the
      // binder is recoverable from the name alone.
      let unlocated = String::index_of(msg, " [@") < 0
      // #2125: `unknown type` is reported from a function literal's parameter
      // and return annotations, which carry no offset of their own -- so it
      // anchors on the declaration name exactly like the two above.
      // #2198: `if branches have incompatible types` joins them for the
      // all-literal case (`if c { "yes" } else { 0 }`) where the else
      // branch, the then-tail and the condition are all offset-less.
      // #2268 (Codex round 7 on #2267): `type parameter ...` joins -- the
      // formal-application rejection reports from the same offset-less
      // parameter/return/local-let annotations `unknown type` does, so it
      // anchors on the declaration name the same way. The declaration-sweep
      // sites (alias bodies, effect ops, trait methods, struct fields, enum
      // payloads) stay unlocated exactly like their `unknown type` siblings
      // -- locating those is the #1567 positions program, not this marker.
      let anchorable = String::starts_with(msg, "return type mismatch") || String::starts_with(msg, "binding type mismatch for ") || String::starts_with(msg, "unknown type `") || String::starts_with(msg, "type parameter `") || String::starts_with(msg, "type constructor parameter `") || String::starts_with(msg, "if branches have incompatible types")
      if anchorable && unlocated {
        Array::set(errors, i, String::concat(msg, String::concat(" [@fn=", String::concat(name, "]"))))
      }
      i = i + 1
    }
  }
}

/// #3520: the call each bounded type variable was instantiated at -- `(vid,
/// callee offset, callee spelling length)` -- so an unsatisfied bound names the
/// call that asked for it. A bound used to be reported with no position at all
/// (``no impl `Send` for `Array[Int]` `` for a `TaskGroup::spawn` result).
/// Variable ids restart per module check, so the record is cleared before and
/// after each program's bound check.
export let bound_var_sites: Array[(Int, Int, Int)] = []

export fn note_bound_var_site(vid: Int, off: Int, len: Int) -> Unit {
  if off >= 0 {
    Array::push(bound_var_sites, (vid, off, len))
  } else {
    ()
  }
}

export fn reset_bound_var_sites() -> Unit {
  Array::truncate(bound_var_sites, 0)
}

export fn bound_var_site_marker(vid: Int) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(bound_var_sites) && out == "" {
    let (sid, off, len) = Array::get(bound_var_sites, i)
    if sid == vid {
      out = off_marker_len(off, len)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #3548: give every diagnostic pushed since `from` that carries no
/// position the marker of `off` (or of `fallback` when `off` is negative).
/// For a check whose subject has no offset of its own -- a pattern -- this is
/// the nearest node that does; one already located is left alone.
export fn anchor_unlocated_errors(errors: Array[String], from: Int, off: Int, fallback: Int) -> Unit {
  let at = if off >= 0 {
    off
  } else {
    fallback
  }
  if at >= 0 {
    let mut i = from
    while i < Array::length(errors) {
      let msg = Array::get(errors, i)
      if String::index_of(msg, " [@") < 0 {
        Array::set(errors, i, String::concat(msg, off_marker(at)))
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
}

/// #3548: the `impl` heads checked so far in this program, as
/// `trait|owner`, so a diagnostic about one can name WHICH `impl Trait for
/// Owner` it is (`impl_head_marker`). An impl carries no source offset.
export let impl_heads_seen: Array[String] = []

export fn reset_impl_heads_seen() -> Unit {
  Array::truncate(impl_heads_seen, 0)
}

/// Record one more `impl trait_head for owner` and answer the locator marker
/// naming it: the k-th impl of that trait for that owner in source order. An
/// impl with no plain owner name gets no marker.
export fn note_impl_head(trait_head: String, owner: String) -> String {
  if trait_head == "" || owner == "" {
    ""
  } else {
    let key = String::concat(trait_head, String::concat("|", owner))
    Array::push(impl_heads_seen, key)
    let mut k = 0
    for seen in impl_heads_seen {
      if seen == key {
        k = k + 1
      } else {
        ()
      }
    }
    String::concat(" [@impl-method=", String::concat(key, String::concat("||head|", String::concat(Int::to_string(k), "]"))))
  }
}
