/// #3275: publish the instantiation a function's own `with` row writes for a
/// declared generic effect (`with Box[Int]`) under the key a `handle` uses
/// (`effect_instantiate`), so a `perform Box::Put(..)` in the body is checked
/// against `Int` instead of a fresh variable. Without it the payload was never
/// compared with the row, and `perform Box::Put("x")` under `with Box[Int]`
/// compiled and handed a pointer to an arm reading an `Int`.
///
/// An explicit row also masks an instantiation inherited from an enclosing
/// function or handle: a bare `with Box`, two different labels for the same
/// effect, or an argument the type parser cannot read binds `CtUnit`, which
/// `effect_inst_lookup` rejects, so those performs keep a fresh
/// instantiation. A repeated identical label is the same instantiation.
///
/// A kinded parameter's argument is bound by `kinded_row_inst`, which reports
/// a wrong-kinded argument rather than leaving the perform unchecked.
///
/// The instantiation is also recorded under `effect_row_inst_key`, so an
/// unannotated lambda can tell it came from an enclosing ROW rather than a
/// `handle` (`mask_row_effect_instantiations`).
fn bind_row_effect_instantiations(env: TypeEnv, row: Option[String], defs: Array[TypeDef], tparams: Array[String], errors: Array[String]) -> TypeEnv {
  match row {
    None => mask_row_effect_instantiations(env = env, defs = defs),
    Some(text) => {
      let seen_bases = array_empty()
      let seen_labels = array_empty()
      let mut out = env
      for raw in row_items_top_level(text) {
        let label = String::trim(raw)
        let bi = String::index_of(label, needle = "[")
        let base = if bi > 0 {
          label[0: bi]
        } else {
          label
        }
        if Array::length(effect_tparams(defs = defs, eff = base)) == 1 {
          let mut prior = 0 - 1
          let mut si = 0
          while si < Array::length(seen_bases) {
            if Array::get(seen_bases, at = si) == base {
              prior = si
            }
            si = si + 1
          }
          if prior >= 0 {
            if Array::get(seen_labels, at = prior) != label {
              Array::set(seen_labels, at = prior, value = "#conflict")
              out = env_bind(env = env_bind(env = out, name = effect_inst_env_key(base), ty = CtUnit), name = effect_row_inst_key(base), ty = CtUnit)
            } else {
              ()
            }
          } else {
            Array::push(seen_bases, value = base)
            Array::push(seen_labels, value = label)
            let parsed = if bi > 0 && String::ends_with(label, suffix = "]") {
              handle {
                let (arg_te, _) = parse_type(tokens = lex(label[bi + 1: String::length(label) - 1]), pos = 0)
                Some(arg_te)
              } with { Exception::Throw(_unreadable) => None }
            } else {
              None
            }
            let param = Array::get(effect_tparams(defs = defs, eff = base), at = 0)
            let inst = match parsed {
              Some(arg_te) => {
                let shadow = formal_shadow(te = arg_te, env = env, own = tparams)
                if type_param_arity(param) > 0 {
                  // A kinded parameter (`F` of `Read[F[_]]`) takes a bare
                  // constructor, not a complete type.
                  kinded_row_inst(label = label, base = base, param = param, arg_te = arg_te, defs = defs, shadow = shadow, tparams = tparams, env = env, errors = errors)
                } else {
                  row_arg_as_type(arg_te = arg_te, defs = defs, shadow = shadow, env = env)
                }
              },
              None => CtUnit
            }
            out = env_bind(env = env_bind(env = out, name = effect_inst_env_key(base), ty = inst), name = effect_row_inst_key(base), ty = inst)
          }
        } else {
          ()
        }
      }
      out
    }
  }
}

fn effect_row_inst_key(_ eff: String) -> String {
  String::concat("$einst_row$", eff)
}

/// A row argument resolved as a complete type, its formals mapped to the
/// enclosing binders' variables.
fn row_arg_as_type(arg_te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv) -> Type {
  CtTuple([
    resolve_tparams_in(ty = resolve_type_expr_shadowed(te = arg_te, defs = defs, shadow = shadow), env = env)
  ])
}

/// #3275 follow-up (Codex on #3315): the instantiation the row item `label`
/// gives the kinded parameter `param` of effect `base`. A perform the row
/// governs is never left unchecked:
///
/// - a bare constructor of the parameter's kind is bound as that constructor
///   (`row_constructor_arg`), so `with Read[Array]` makes `F[Int]` an
///   `Array[Int]`;
/// - a constructor formal in scope (`with Read[G]` in `fn producer[G[_]]`) is
///   bound as the formal itself, so the payload is `G[Int]`, the type a
///   `xs: G[Int]` parameter has. A formal whose declared arity is not the
///   parameter's (`with Read[T]` for a plain `T`, or an `H[_, _]`) is reported
///   like any other wrong-kinded argument (Codex on #3315): bound as itself it
///   let a nested lambda's row through unchecked;
/// - a wrong-kinded argument is REPORTED here with the row-item check's
///   message, and the parameter is left fresh, since the program is refused
///   anyway. Leaving the report to `geff_row_targ_errors_into` was not enough:
///   that check runs only once type checking found nothing, it does not walk a
///   lambda nested in a body, and it compared arities only, so
///   `perform Read::Put(Some(1))` checked clean under `with Read[Higher]`
///   (`struct Higher[G[_]]`), and under `Read[Int]` or `Read[Nope]` in a
///   nested lambda;
/// - anything else is bound as the argument resolved as a type, an
///   application no payload of the parameter's shape matches.
fn kinded_row_inst(label: String, base: String, param: String, arg_te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], tparams: Array[String], env: TypeEnv, errors: Array[String]) -> Type {
  let want = type_param_arity(param)
  match row_constructor_arg(param = param, arg_te = arg_te, defs = defs, shadow = shadow) {
    Some(ctor) => CtTuple([ctor]),
    None => {
      let formal_name = match arg_te {
        TyName(name) => if type_expr_name_is_shadowed(shadow = shadow, name = name) {
          name
        } else {
          ""
        },
        _ => ""
      }
      let msg = if formal_name != "" {
        let farity = row_formal_arity(name = formal_name, tparams = tparams, env = env)
        if farity >= 0 && farity != want {
          kinded_row_kind_message(label = label, base = base, want = want, arity = farity, plain = true)
        } else {
          ""
        }
      } else {
        kinded_row_arg_message(label = label, base = base, want = want, arg_te = arg_te, defs = defs)
      }
      if msg == "" {
        row_arg_as_type(arg_te = arg_te, defs = defs, shadow = shadow, env = env)
      } else {
        Array::push(errors, value = msg)
        CtUnit
      }
    }
  }
}

/// The declared arity of the type formal `name` in scope: the row's own
/// binder's (`tparams`, keys such as `G[_]`), or an enclosing binder's, read
/// from the formal table the EFn arm fills (`record_eq_formal_var`); -1 when
/// neither records it.
fn row_formal_arity(name: String, tparams: Array[String], env: TypeEnv) -> Int {
  let mut own = 0 - 1
  let mut i = 0
  while i < Array::length(tparams) {
    let key = Array::get(tparams, at = i)
    if type_param_name(key) == name {
      own = type_param_arity(key)
    } else {
      ()
    }
    i = i + 1
  }
  if own >= 0 {
    own
  } else {
    let row = match env_lookup(env = env, name = name) {
      Some(t) => match t {
        CtVar(vid) => {
          let r = eq_formal_row_of(vid)
          if r >= 0 {
            let (_, rname) = Array::get(eq_formal_vars, at = r)
            if rname == name {
              r
            } else {
              0 - 1
            }
          } else {
            0 - 1
          }
        },
        CtNamed(n, _) => if n == String::concat("#hktformal.", name) {
          eq_formal_rigid_row(name)
        } else {
          0 - 1
        },
        _ => 0 - 1
      },
      None => 0 - 1
    }
    if row >= 0 {
      Array::get(eq_formal_arity, at = row)
    } else {
      0 - 1
    }
  }
}

/// The row-item check's message (`geff_row_targ_errors_into`) for a
/// wrong-kinded argument of a kinded effect parameter that takes `want` type
/// arguments, or "" when the argument's kind is right as far as this can tell.
/// An unknown name and an applied type count as taking no arguments, as they
/// do there.
fn kinded_row_arg_message(label: String, base: String, want: Int, arg_te: TypeExpr, defs: Array[TypeDef]) -> String {
  let (arity, plain) = match arg_te {
    TyName(name) => match compiler_owned_type_arity(name) {
      Some(owned) => (owned, true),
      None => (Array::length(declared_type_params(defs = defs, name = name)), constructor_params_plain(defs = defs, name = name))
    },
    _ => (0, true)
  }
  kinded_row_kind_message(label = label, base = base, want = want, arity = arity, plain = plain)
}

/// The message itself: `arity` is what the row's argument takes and `plain`
/// whether all its parameters are types; "" when both fit.
fn kinded_row_kind_message(label: String, base: String, want: Int, arity: Int, plain: Bool) -> String {
  let bi = String::index_of(label, needle = "[")
  let inner = if bi > 0 && String::ends_with(label, suffix = "]") {
    String::trim(label[bi + 1: String::length(label) - 1])
  } else {
    label
  }
  let head = String::concat("effect row item `", String::concat(label, String::concat("`: effect ", base)))
  if arity != want {
    String::concat(head, String::concat(" expects a constructor with ", String::concat(__to_string(want), String::concat(" argument(s), but `", String::concat(inner, String::concat("` has ", String::concat(__to_string(arity), " -- pass a bare constructor with the required arity")))))))
  } else if !plain {
    String::concat(head, String::concat(" applies its parameter to types, but a parameter of `", String::concat(inner, "` takes a constructor -- pass a constructor whose parameters are all types, such as `Array` or `Option`")))
  } else {
    ""
  }
}

/// #3275 follow-up (Codex on #3315): the constructor a row passes to a kinded
/// effect parameter `param` (`with Read[Array]` for `effect Read[F[_]]`),
/// reified the way a kinded type argument is everywhere else
/// (`resolve_type_constructor_args`): `Array` and `Option` as `CtConstructor`,
/// a declared generic type as its constructor, a parameterized alias as an
/// alias constructor. Substituting it into the operation's `F[Int]` then gives
/// `Array[Int]`. Resolving the bare name as a complete type instead gave a
/// head with no arguments, so `F[Int]` became an application no payload
/// matches: `perform Read::Put([1, 2])` under `with Read[Array]` was refused
/// with `expected Array[Int], got Array[Int]`, and a `Cell[String]` payload
/// under `with Read[Cell]` was accepted.
///
/// None for anything else -- a formal in scope, an applied or complete type,
/// a constructor whose arity is not the parameter's or that itself takes a
/// constructor, an unknown name -- which `kinded_row_inst` handles.
fn row_constructor_arg(param: String, arg_te: TypeExpr, defs: Array[TypeDef], shadow: Array[String]) -> Option[Type] {
  match arg_te {
    TyName(name) => if type_expr_name_is_shadowed(shadow = shadow, name = name) {
      None
    } else {
      let params: Array[String] = [param]
      let source_args: Array[TypeExpr] = [arg_te]
      let resolved = resolve_type_expr_shadowed(te = arg_te, defs = defs, shadow = shadow)
      let resolved_args: Array[Type] = [resolved]
      let reified = Array::get(resolve_type_constructor_args(params = params, source_args = source_args, resolved_args = resolved_args, defs = defs, shadow = shadow), at = 0)
      let want = type_param_arity(param)
      match reified {
        CtConstructor(ctor, arity) => if arity == want && constructor_params_plain(defs = defs, name = ctor) {
          Some(reified)
        } else {
          None
        },
        CtApplied(_, meta) => if is_alias_constructor(reified) && Array::length(meta) == want + 1 && alias_constructor_params_plain(meta) {
          Some(reified)
        } else {
          None
        },
        _ => None
      }
    },
    _ => None
  }
}

/// The type parameters of the type declared as `name`, or none when no
/// struct, enum or alias of that name is declared.
fn declared_type_params(defs: Array[TypeDef], name: String) -> Array[String] {
  match find_typedef(defs = defs, name = name) {
    Some(td) => match td {
      TDStruct(_, _, _, sps) => sps,
      TDEnum(_, eps, _) => eps,
      TDAlias(_, aps, _) => aps,
      _ => array_empty()
    },
    None => array_empty()
  }
}

/// Does the type declared as `name` take only complete types (no parameter
/// of its own is a constructor)? A compiler-owned head (`Array`, `Option`)
/// has no declaration and takes complete types.
fn constructor_params_plain(defs: Array[TypeDef], name: String) -> Bool {
  let params = declared_type_params(defs = defs, name = name)
  let mut plain = true
  let mut i = 0
  while i < Array::length(params) {
    if type_param_arity(Array::get(params, at = i)) > 0 {
      plain = false
    } else {
      ()
    }
    i = i + 1
  }
  plain
}

/// An alias constructor's binders (everything after its body) are all
/// complete-type parameters.
fn alias_constructor_params_plain(_ meta: Array[Type]) -> Bool {
  let mut plain = true
  let mut i = 1
  while i < Array::length(meta) {
    match Array::get(meta, at = i) {
      CtNamed(n, _) => if type_param_arity(n) > 0 {
        plain = false
      } else {
        ()
      },
      _ => {
        plain = false
      }
    }
    i = i + 1
  }
  plain
}

/// #3275 (Codex on #3304): a lambda with no `with` row does not inherit an
/// instantiation an enclosing function's ROW chose. Its row is derived where
/// it is used -- passed to a callback parameter typed `() -> Int with
/// Box[String]`, its performs belong to that row, not the outer `Box[Int]`.
/// An instantiation a `handle` chose is a different binding (fresh variables,
/// so not equal to the row's) and is still inherited, as before.
fn mask_row_effect_instantiations(env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  let mut out = env
  for d in defs {
    match d {
      TDEffect(name, _, etps) => if Array::length(etps) == 1 {
        match (env_lookup(env = env, name = effect_row_inst_key(name)), env_lookup(env = env, name = effect_inst_env_key(name))) {
          (Some(row_inst), Some(inst)) => if types_equal(a = row_inst, b = inst) {
            out = env_bind(env = out, name = effect_inst_env_key(name), ty = CtUnit)
          } else {
            ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
  }
  out
}

/// #3311: the generic-effect instantiations a lambda's body is checked under.
/// A lambda with its own `with` row is bound by that row
/// (`bind_row_effect_instantiations`). A lambda with none, passed as an
/// argument, takes the instantiations the parameter's row names
/// (`callback_arg_env` hands them over): its performs belong to that callback
/// row, as if the lambda had been written with it. The hand-off is consumed
/// here, so a lambda nested in the body does not inherit it.
export fn bind_lambda_row_effect_instantiations(env: TypeEnv, row: Option[String], defs: Array[TypeDef], tparams: Array[String], errors: Array[String]) -> TypeEnv {
  let own = bind_row_effect_instantiations(env = env, row = row, defs = defs, tparams = tparams, errors = errors)
  match env_lookup(env = env, name = callback_row_inst_key()) {
    Some(CtTuple(items)) => {
      let mut out = env_bind(env = own, name = callback_row_inst_key(), ty = CtUnit)
      match row {
        Some(_) => out,
        None => {
          for item in items {
            match item {
              CtNamed(base, insts) => if Array::length(insts) == 1 {
                let inst = Array::get(insts, at = 0)
                out = env_bind(env = env_bind(env = out, name = effect_inst_env_key(base), ty = inst), name = effect_row_inst_key(base), ty = inst)
              },
              _ => ()
            }
          }
          out
        }
      }
    },
    _ => own
  }
}

/// #3311: the env key under which a call hands a lambda argument the
/// instantiations its parameter's row names, as a `CtTuple` of
/// `CtNamed(effect, [instantiation])`.
fn callback_row_inst_key() -> String {
  "#callback_row_inst"
}

/// #3311: the environment a call checks the argument `arg` in. When `arg` is a
/// lambda literal with no `with` row and the parameter it is passed to has a
/// function type whose row instantiates a declared generic effect
/// (`f: () -> Int with Box[String]`), the lambda's performs belong to that row,
/// so its instantiations are handed to the EFn arm. Before, the lambda was
/// checked with no expectation, its perform got a fresh `T`, and
/// `perform Box::Put(1)` reached a handler that read the `Int` as a `String`.
///
/// The row is the callee's, written where the callee is declared, so it is
/// resolved there and not in the caller's scope. `callee` is a generic
/// callee's scheme and this call's instantiation of it: a formal the row names
/// (`fn run[T](f: () -> Int with Box[T], x: T)`) is the type this call gives
/// it. An instantiation that cannot be read exactly (`callback_type_exact`),
/// and a bare label (`with Box`), are not handed over: the lambda is checked
/// as before, an enclosing row's instantiation masked and an enclosing
/// handle's kept, since a callee may forward such a row to that handle.
export fn callback_arg_env(env: TypeEnv, arg: Expr, param_ty: Type, s: Subst, callee: Option[(Type, Type)], defs: Array[TypeDef]) -> TypeEnv {
  let arg = call_arg_value(arg)
  callback_arg_env_read(env = env, arg = arg, param_ty = param_ty, s = s, callee = callee, read = (row: String) -> Array[Type] {
    callback_row_instantiations(row = row, callee = callee, defs = defs)
  })
}

/// #3386: a generic callee's own row hands its effects to whatever is in
/// scope at the call -- the nearest `handle`, else the enclosing function's
/// row. A formal only that row names (`fn run[T](f: () -> Int with Box[T])
/// -> Int with Box[T]`) is therefore the type the scope gives the effect, and
/// it is fixed here, before the arguments are checked, so a callback's
/// `perform Box::Put(12345)` under a caller's `with Box[String]` is checked
/// at `String`. Before, `T` stayed free, the lambda chose `Int`, and the
/// handler read the `Int` as a `String`. Only the variables
/// `label_row_only_formals` made are fixed here: a formal an argument
/// reaches is the argument's to fix, and the row comparison judges it. A label
/// the scope cannot take is left alone for the same comparison.
export fn callee_row_scope_subst(env: TypeEnv, callee_ty: Type, s: Subst) -> Subst {
  match callee_ty {
    CtFn(_, _, row) => {
      let mut out = s
      for label in effect_inst_labels(row) {
        let (eff, id) = label
        if int_array_has(items = row_only_formal_vars, wanted = id) {
          match env_lookup(env = env, name = effect_inst_env_key(eff)) {
            Some(CtTuple(scope)) => if Array::length(scope) == 1 {
              match unify(a = CtVar(id), b = Array::get(scope, at = 0), s = out) {
                Some(ns) => {
                  out = ns
                },
                None => ()
              }
            },
            _ => ()
          }
        }
      }
      out
    },
    _ => s
  }
}

/// #3386: a generic callee's formal that only its rows name (`T` of `fn
/// run[T](f: () -> Int with Box[T]) -> Int with Box[T]`) has no place in the
/// instantiated type -- rows are text -- so nothing at the call could read the
/// type this call gives it. Each such formal gets a fresh variable here. Every
/// row item whose argument mentions one, in the callee's own row and in its
/// parameters' and result's function types, is labelled (`#einst:E:<id>`)
/// with a variable bound to that payload as this call reads it: the formal's
/// own variable for `E[T]`, a new one bound to `Option[T]` for
/// `E[Option[T]]`. The labels are what the callback hand-off, the argument
/// checks and `callee_row_scope_subst` read; the written items stay for the
/// readers of the text.
export fn label_row_only_formals(scheme: Type, inst: Type, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {
  match scheme {
    CtForAll(_, _, _) => match generic_decl_of_scheme(scheme) {
      Some((tps, dparams, dret)) => {
        let (name_ids, id_tys) = callee_formal_ids(decl = Some((tps, dparams, dret)), scheme = scheme, inst = inst, defs = defs)
        let formals: Array[(String, Int)] = []
        let names: Array[String] = []
        let mut scope = EnvEmpty
        let mut next = c
        for tp in tps {
          let fname = type_param_name(tp)
          Array::push(names, value = fname)
          // Reached: a parameter or the result spells it, so the
          // instantiated type already carries this call's variable.
          let mut reached = false
          for name_id in name_ids {
            let (nname, nid) = name_id
            if nname == fname {
              for id_ty in id_tys {
                let (kid, kty) = id_ty
                if kid == nid && !reached {
                  reached = true
                  scope = env_bind(env = scope, name = fname, ty = kty)
                }
              }
            }
          }
          // #3418: a constructor formal (`F[_]`) too; `Box[F[Int]]` reads
          // its payload through the variable like `Box[Option[T]]`.
          if !reached {
            let (fv, nc) = fresh_var(next)
            Array::push(formals, value = (fname, nc - 1))
            Array::push(row_only_formal_vars, value = nc - 1)
            scope = env_bind(env = scope, name = fname, ty = fv)
            next = nc
          }
        }
        if Array::length(formals) == 0 {
          (inst, s, c)
        } else {
          // Each row item that mentions a row-only formal, read once.
          let items: Array[(String, Int)] = []
          let mut out_s = s
          for raw in row_only_items(t = inst, formals = formals, defs = defs) {
            let (base, item) = raw
            let mut seen = false
            for done in items {
              if done.0 == item {
                seen = true
              }
            }
            if !seen {
              let mut exact = -1
              for f in formals {
                if String::concat(base, String::concat("[", String::concat(f.0, "]"))) == item {
                  exact = f.1
                }
              }
              if exact >= 0 {
                Array::push(items, value = (item, exact))
              } else {
                match env_lookup(env = bind_row_effect_instantiations(env = scope, row = Some(item), defs = defs, tparams = names, errors = array_empty()), name = effect_inst_env_key(base)) {
                  Some(CtTuple(read)) => if Array::length(read) == 1 {
                    let (lv, nc) = fresh_var(next)
                    match unify(a = lv, b = Array::get(read, at = 0), s = out_s) {
                      Some(ns) => {
                        out_s = ns
                        next = nc
                        Array::push(row_only_formal_vars, value = nc - 1)
                        Array::push(items, value = (item, nc - 1))
                      },
                      None => ()
                    }
                  },
                  _ => ()
                }
              }
            }
          }
          (label_row_only_type(t = inst, items = items, defs = defs), out_s, next)
        }
      },
      None => (inst, s, c)
    },
    _ => (inst, s, c)
  }
}

/// The `(effect, item)` pairs of every row in `t` (its own, its parameters'
/// and its result's, and a function type's inside an `Array`, `Option`,
/// tuple, named type or record, Codex on #3414) whose single generic-effect
/// argument names one of `formals` as a whole word.
fn row_only_items(t: Type, formals: Array[(String, Int)], defs: Array[TypeDef]) -> Array[(String, String)] {
  let out: Array[(String, String)] = []
  row_only_items_into(t = t, formals = formals, defs = defs, out = out)
  out
}

fn row_only_items_into(t: Type, formals: Array[(String, Int)], defs: Array[TypeDef], out: Array[(String, String)]) -> Unit {
  match t {
    CtFn(params, ret, row) => {
      for p in params {
        row_only_items_into(t = p, formals = formals, defs = defs, out = out)
      }
      row_only_items_into(t = ret, formals = formals, defs = defs, out = out)
      match row {
        Some(text) => for raw in row_items_top_level(text) {
          let item = String::trim(raw)
          let bi = String::index_of(item, needle = "[")
          if bi > 0 && String::ends_with(item, suffix = "]") {
            let base = item[0: bi]
            let arg = item[bi + 1: String::length(item) - 1]
            let etps = effect_tparams(defs = defs, eff = base)
            if Array::length(etps) == 1 {
              let mut mentions = false
              for f in formals {
                if text_has_word(text = arg, word = f.0) {
                  mentions = true
                }
              }
              if mentions {
                Array::push(out, value = (base, item))
              }
            }
          }
        },
        None => ()
      }
      ()
    },
    CtArray(e) => row_only_items_into(t = e, formals = formals, defs = defs, out = out),
    CtOption(e) => row_only_items_into(t = e, formals = formals, defs = defs, out = out),
    CtTuple(es) => for e in es {
      row_only_items_into(t = e, formals = formals, defs = defs, out = out)
    },
    CtNamed(_, args) => for a in args {
      row_only_items_into(t = a, formals = formals, defs = defs, out = out)
    },
    CtApplied(_, args) => for a in args {
      row_only_items_into(t = a, formals = formals, defs = defs, out = out)
    },
    CtRecord(fields) => for f in fields {
      row_only_items_into(t = f.1, formals = formals, defs = defs, out = out)
    },
    _ => ()
  }
  ()
}

/// Whether `word` occurs in `text` delimited by non-identifier bytes.
fn text_has_word(text: String, word: String) -> Bool {
  let n = String::length(text)
  let w = String::length(word)
  let mut found = false
  let mut i = 0
  while i + w <= n && !found {
    if String::substring(text, start = i, end = i + w) == word && (i == 0 || !is_word_byte(String::byte_at(text, at = i - 1))) && (i + w == n || !is_word_byte(String::byte_at(text, at = i + w))) {
      found = true
    }
    i = i + 1
  }
  found
}

fn is_word_byte(_ b: Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn label_row_only_type(t: Type, items: Array[(String, Int)], defs: Array[TypeDef]) -> Type {
  match t {
    CtFn(params, ret, row) => CtFn(for p in params {
      label_row_only_type(t = p, items = items, defs = defs)
    }, label_row_only_type(t = ret, items = items, defs = defs), label_row_only_row(row = row, items = items)),
    CtArray(e) => CtArray(label_row_only_type(t = e, items = items, defs = defs)),
    CtOption(e) => CtOption(label_row_only_type(t = e, items = items, defs = defs)),
    CtTuple(es) => CtTuple(for e in es {
      label_row_only_type(t = e, items = items, defs = defs)
    }),
    CtNamed(n, args) => CtNamed(n, for a in args {
      label_row_only_type(t = a, items = items, defs = defs)
    }),
    CtApplied(h, args) => CtApplied(h, for a in args {
      label_row_only_type(t = a, items = items, defs = defs)
    }),
    CtRecord(fields) => CtRecord(for f in fields {
      (f.0, label_row_only_type(t = f.1, items = items, defs = defs))
    }),
    _ => t
  }
}

fn label_row_only_row(row: Option[String], items: Array[(String, Int)]) -> Option[String] {
  match row {
    Some(text) => {
      let mut out = row
      for raw in row_items_top_level(text) {
        let item = String::trim(raw)
        let bi = String::index_of(item, needle = "[")
        for labelled in items {
          if labelled.0 == item && bi > 0 {
            out = merge_provenance_row(expected = out, actual = Some(effect_inst_label(eff = item[0: bi], id = labelled.1)))
          }
        }
      }
      out
    },
    None => None
  }
}

/// Codex on #3340: the environment a field call `r.f(..)` checks the argument
/// `arg` in, when `f` is a function-typed field of the receiver's struct. The
/// field's row is written in the struct's declaration, so it is read there:
/// a type parameter of the struct is the receiver's type argument
/// (`struct_field_row_instantiations`). Before, a field call checked its
/// arguments before it found the field's type, so a lambda passed to
/// `r.run` with `run: (() -> Int with Box[String]) -> Int` was handed
/// nothing and its `perform Box::Put(1)` chose `Int`.
export fn field_callback_arg_env(env: TypeEnv, arg: Expr, param_ty: Type, s: Subst, recv: Type, defs: Array[TypeDef]) -> TypeEnv {
  let arg = call_arg_value(arg)
  callback_arg_env_read(env = env, arg = arg, param_ty = param_ty, s = s, callee = None, read = (row: String) -> Array[Type] {
    struct_field_row_instantiations(row = row, recv = recv, defs = defs)
  })
}

fn callback_arg_env_read(env: TypeEnv, arg: Expr, param_ty: Type, s: Subst, callee: Option[(Type, Type)], read: (String) -> Array[Type]) -> TypeEnv {
  let arg = call_arg_value(arg)
  match arg {
    EFn(_, _, _, _, None, _) => match subst_apply(s = s, ty = param_ty) {
      CtFn(_, _, Some(row)) => {
        // #3387: a label is the typed record of the instantiation, so it
        // replaces what the text says about the same effect: the text may
        // spell a formal of a scheme this value has left.
        // Labels that disagree are not handed over: the lambda is checked as
        // before and the disagreement is reported once, at the argument.
        let labelled = row_label_instantiations(row = row, s = s, callee = callee)
        let items = without_effects(items = prefer_row_labels(read = read(row), labelled = labelled), names = conflicting_label_effects(labelled = labelled, s = s))
        if Array::length(items) == 0 {
          env
        } else {
          env_bind(env = env, name = callback_row_inst_key(), ty = CtTuple(items))
        }
      },
      _ => env
    },
    _ => env
  }
}

/// #3387: `read` (a row's text, read in some scope) with every item for an
/// effect that `labelled` records replaced by the labels' items.
fn prefer_row_labels(read: Array[Type], labelled: Array[Type]) -> Array[Type] {
  if Array::length(labelled) == 0 {
    read
  } else {
    let names: Array[String] = []
    for item in labelled {
      match item {
        CtNamed(name, _) => Array::push(names, value = name),
        _ => ()
      }
    }
    let out: Array[Type] = []
    for item in read {
      match item {
        CtNamed(name, _) => if !checker_string_array_has(items = names, wanted = name) {
          Array::push(out, value = item)
        } else {
          ()
        },
        _ => Array::push(out, value = item)
      }
    }
    for item in labelled {
      Array::push(out, value = item)
    }
    out
  }
}

/// #3387: the effects two labels of one row give payloads that cannot be the
/// same type under `s`. A joined callee (`[first, second]`) carries each
/// member's label, and a function passed to it has to perform at all of them.
fn conflicting_label_effects(labelled: Array[Type], s: Subst) -> Array[String] {
  let out: Array[String] = []
  let mut acc = s
  let mut i = 0
  while i < Array::length(labelled) {
    match effect_inst_wanted_payload(Array::get(labelled, at = i)) {
      Some((eff, want)) => {
        let mut j = i + 1
        while j < Array::length(labelled) {
          match effect_inst_wanted_payload(Array::get(labelled, at = j)) {
            Some((other, other_want)) => if other == eff && !checker_string_array_has(items = out, wanted = eff) {
              match unify(a = want, b = other_want, s = acc) {
                Some(ns) => acc = ns,
                None => Array::push(out, value = eff)
              }
            } else {
              ()
            },
            None => ()
          }
          j = j + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
  out
}

fn without_effects(items: Array[Type], names: Array[String]) -> Array[Type] {
  if Array::length(names) == 0 {
    items
  } else {
    let out: Array[Type] = []
    for item in items {
      match item {
        CtNamed(name, _) => if !checker_string_array_has(items = names, wanted = name) {
          Array::push(out, value = item)
        } else {
          ()
        },
        _ => Array::push(out, value = item)
      }
    }
    out
  }
}

/// #3387: the instantiation each `#einst:` label of a parameter's row records,
/// as `CtNamed(effect, [instantiation])`, read at this use of the callee
/// (`label_type_at_use`): a label a generic value's instantiation wrote
/// (`bind_generic_value_effect_instantiations`) names a variable its scheme
/// may since have quantified.
fn row_label_instantiations(row: String, s: Subst, callee: Option[(Type, Type)]) -> Array[Type] {
  let out: Array[Type] = []
  for label in effect_inst_labels(Some(row)) {
    let (eff, id) = label
    let read = match callee {
      Some((scheme, inst)) => label_type_at_use(s = s, id = id, binding = Some(scheme), used = inst),
      None => Some(subst_apply(s = s, ty = CtVar(id)))
    }
    match read {
      Some(t) => Array::push(out, value = CtNamed(eff, [CtTuple([t])])),
      None => ()
    }
  }
  out
}

/// #3311: the substitution a callback lambda passed to a generic callee is
/// checked under. The arguments to its left are unified with their parameters
/// first, so a formal they fix (`x: T` in `run2("s", () -> { .. })`) is the
/// type the lambda's performs are checked against, and a perform that
/// disagrees is reported at the perform. Otherwise the perform would fix `T`
/// itself and the mismatch would be reported at `"s"`, the argument that is
/// right. A pair that does not unify is left for the call's own argument check
/// to report.
export fn callback_prefix_subst(arg: Expr, param_tys: Array[Type], arg_tys: Array[Type], s: Subst, callee: Option[(Type, Type)]) -> Subst {
  let arg = call_arg_value(arg)
  let ai = Array::length(arg_tys)
  let applies = if ai > 0 && ai < Array::length(param_tys) {
    let param = subst_apply(s = s, ty = Array::get(param_tys, at = ai))
    match callee {
      Some(_) => type_has_instantiated_callback_row(param),
      // #3387: a callee that is not a scheme here (a generic function taken
      // as a value and bound by `let`) carries its instantiation as labels.
      None => type_has_effect_inst_label(param)
    }
  } else {
    false
  }
  if applies {
    // Aggregate contents and named/explicit callbacks must read the same
    // instantiation as a rowless literal. The contract, not the syntax of
    // `arg`, determines whether its earlier arguments need unifying first.
    let mut out = s
    let mut j = 0
    while j < ai {
      match unify(a = Array::get(param_tys, at = j), b = Array::get(arg_tys, at = j), s = out) {
        Some(su) => out = su,
        None => ()
      }
      j = j + 1
    }
    out
  } else {
    s
  }
}

/// Does a function type anywhere in `t` carry an `#einst:` label?
fn type_has_effect_inst_label(_ t: Type) -> Bool {
  match t {
    CtFn(params, ret, row) => {
      let mut found = match row {
        Some(r) => String::contains(r, needle = "#einst:"),
        None => false
      }
      for p in params {
        if type_has_effect_inst_label(p) {
          found = true
        }
      }
      found || type_has_effect_inst_label(ret)
    },
    CtArray(e) => type_has_effect_inst_label(e),
    CtOption(e) => type_has_effect_inst_label(e),
    CtTuple(items) => {
      let mut found = false
      for item in items {
        if type_has_effect_inst_label(item) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

/// Rows within an aggregate parameter have the same prefix constraints as a
/// direct callback row. A separately quantified callback has its own scope.
fn type_has_instantiated_callback_row(_ t: Type) -> Bool {
  let children = match t {
    CtFn(params, ret, row) => {
      match row {
        Some(r) => if String::contains(r, needle = "[") && row_names_instantiation(r) {
          return true
        },
        None => ()
      }
      if type_has_instantiated_callback_row(ret) {
        return true
      }
      params
    },
    CtArray(e) => return type_has_instantiated_callback_row(e),
    CtOption(e) => return type_has_instantiated_callback_row(e),
    CtTuple(items) => items,
    CtNamed(_, items) => items,
    CtApplied(head, args) => {
      if type_has_instantiated_callback_row(head) {
        return true
      }
      args
    },
    CtRecord(fields) => {
      for field in fields {
        let (_, ft) = field
        if type_has_instantiated_callback_row(ft) {
          return true
        }
      }
      return false
    },
    _ => return false
  }
  for child in children {
    if type_has_instantiated_callback_row(child) {
      return true
    }
  }
  false
}

/// Does the row text name an effect with a type argument (`Box[T]`)? The
/// checker's own provenance labels (`#param[0]`) do not count.
fn row_names_instantiation(_ row: String) -> Bool {
  let mut found = false
  for raw in row_items_top_level(row) {
    let label = String::trim(raw)
    if !String::starts_with(label, prefix = "#") && String::contains(label, needle = "[") {
      found = true
    } else {
      ()
    }
  }
  found
}

/// The instantiation the callback row `row` gives each declared one-parameter
/// generic effect it names exactly, as `CtNamed(effect, [instantiation])`. The
/// row is read by the binder a lambda's own row goes through, in a scope
/// holding only the callee's formals, each bound to the type this call gives
/// it. A wrong-kinded argument is reported where the callee's annotation is
/// checked, not at every call, so the binder's reports are dropped here.
///
/// A generic callee with no declaration in this module (an imported one)
/// names its formals in the row by the markers its published type carries
/// (`T$0`, `publish_row_formals`); each is the type this call gives that
/// quantified variable (Codex on #3340). Before, such a callee handed the
/// lambda nothing, so an imported `run[T](x: T, f: () -> Int with Box[T])`
/// let `run("s", () -> { perform Box::Put(1) })` through.
///
/// Every other word of a published row names a type, read in this module's
/// scope (Codex on #3340: `Box[Wrap[T]]` handed nothing, and the lambda chose
/// the payload). That reads the exporter's type: a name in a published row is
/// part of the callee's signature, and a module whose `Wrap` is a different
/// declaration is refused at the import (#3035 / #3036, "are different types
/// that share the name"). A name this module cannot resolve is not bound.
fn callback_row_instantiations(row: String, callee: Option[(Type, Type)], defs: Array[TypeDef]) -> Array[Type] {
  let formals: Array[String] = []
  let mut scope = EnvEmpty
  let mut declared = true
  match callee {
    Some((scheme, inst)) => match scheme {
      CtForAll(vars, _, _) => match generic_decl_of_scheme(scheme) {
        Some((tps, dparams, dret)) => {
          for tp in tps {
            Array::push(formals, value = tp)
          }
          let (name_ids, id_tys) = callee_formal_ids(decl = Some((tps, dparams, dret)), scheme = scheme, inst = inst, defs = defs)
          for name_id in name_ids {
            let (fname, fid) = name_id
            for id_ty in id_tys {
              let (kid, kty) = id_ty
              if kid == fid && formals_contain_source_name(formals = tps, name = fname) {
                scope = env_bind(env = scope, name = fname, ty = kty)
              } else {
                ()
              }
            }
          }
        },
        None => match inst {
          // A generic callee checked as an expression is not instantiated
          // before its arguments, and its row names its formals unmarked.
          CtUnknown => {
            declared = false
          },
          _ => {
            // Every formal of a published row is marked; one past the
            // quantifier list (only the row names it) has no variable, so it
            // stays unbound and is never read as a type of the same name.
            for word in published_marker_words(row) {
              let fname = strip_published_formal_suffixes(word)
              if !checker_string_array_has(items = formals, wanted = fname) {
                Array::push(formals, value = fname)
              } else {
                ()
              }
            }
            let marked: Array[(String, Int)] = []
            published_row_formal_ids(row = Some(row), vars = vars, out = marked)
            let (_, id_tys) = callee_formal_ids(decl = None, scheme = scheme, inst = inst, defs = defs)
            for mark in marked {
              let (word, mid) = mark
              let fname = strip_published_formal_suffixes(word)
              for id_ty in id_tys {
                let (kid, kty) = id_ty
                if kid == mid {
                  scope = env_bind(env = scope, name = fname, ty = kty)
                } else {
                  ()
                }
              }
            }
          }
        }
      },
      _ => ()
    },
    None => ()
  }
  callback_row_instantiations_in(row = row, formals = formals, scope = scope, declared = declared, defs = defs)
}

/// The instantiations of `row` read with `formals` in scope, each bound in
/// `scope` to the type this use gives it (`callback_row_instantiations`).
fn callback_row_instantiations_in(row: String, formals: Array[String], scope: TypeEnv, declared: Bool, defs: Array[TypeDef]) -> Array[Type] {
  callback_row_instantiations_at(row = row, formals = formals, scope = scope, declared = declared, defs = defs, params = array_empty(), args = array_empty())
}

/// `callback_row_instantiations_in`, with each formal in `params` that is
/// still spelled by its own name replaced by the matching type in `args`
/// before the instantiation is judged exact.
fn callback_row_instantiations_at(row: String, formals: Array[String], scope: TypeEnv, declared: Bool, defs: Array[TypeDef], params: Array[String], args: Array[Type]) -> Array[Type] {
  // A marker is not a word the type parser reads; the scope above binds the
  // formal by its own name; exporter-marked nominal types retain their identity.
  let nominals = published_nominal_words(row)
  let vouched = published_nominal_names(nominals)
  let readable = strip_published_row_marks(row)
  let bound = bind_row_effect_instantiations(env = scope, row = Some(readable), defs = defs, tparams = formals, errors = array_empty())
  let unreadable = callback_row_unreadable_labels(row = readable, defs = defs, formals = formals, vouched = vouched)
  let substituted = Array::length(params) > 0
  let out: Array[Type] = []
  for d in defs {
    match d {
      TDEffect(name, _, etps) => if Array::length(etps) == 1 {
        let mut refused = false
        if declared {
          for entry in unreadable {
            let (base, label, missing) = entry
            if base == name && !refused {
              refused = true
              Array::push(out, value = CtNamed(name, [
                callback_row_refusal(label = label, missing = missing)
              ]))
            } else {
              ()
            }
          }
        } else {
          ()
        }
        if !refused {
          match env_lookup(env = bound, name = effect_inst_env_key(name)) {
            Some(read) => {
              let inst = if substituted {
                inst_struct_field_ty(ft = read, tparams = params, targs = args)
              } else {
                read
              }
              match inst {
                CtTuple(targs) => if callback_types_exact(ts = targs, formals = if substituted {
                  array_empty()
                } else {
                  formals
                }, declared = declared, defs = defs, vouched = vouched) {
                  Array::push(out, value = CtNamed(name, [
                    vouch_published_nominals(t = inst, nominals = nominals, formals = formals)
                  ]))
                } else {
                  ()
                },
                _ => ()
              }
            },
            None => ()
          }
        } else {
          ()
        }
      },
      _ => ()
    }
  }
  out
}

/// Codex on #3340: the instantiations a function-typed struct field's
/// callback row gives, read in the struct's declaration: each type parameter
/// of the struct is the receiver's type argument, so `run: (() -> Int with
/// Box[T]) -> Int` in a `GRunner[String]` hands over `String`. The field's
/// parameter types are already instantiated this way (`inst_struct_field_ty`);
/// its row is text, so the struct's formals are bound here.
fn struct_field_row_instantiations(row: String, recv: Type, defs: Array[TypeDef]) -> Array[Type] {
  match recv {
    CtNamed(sname, targs) => match find_typedef(defs = defs, name = sname) {
      Some(TDStruct(_, _, _, tparams)) => if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {
        // Read with the struct's formals in scope, so each stays spelled by
        // its own name, then substitute the receiver's arguments the way
        // `inst_struct_field_ty` instantiates the field's parameters.
        callback_row_instantiations_at(row = row, formals = tparams, scope = EnvEmpty, declared = true, defs = defs, params = tparams, args = targs)
      } else {
        callback_row_instantiations_in(row = row, formals = array_empty(), scope = EnvEmpty, declared = true, defs = defs)
      },
      _ => callback_row_instantiations_in(row = row, formals = array_empty(), scope = EnvEmpty, declared = true, defs = defs)
    },
    _ => callback_row_instantiations_in(row = row, formals = array_empty(), scope = EnvEmpty, declared = true, defs = defs)
  }
}

/// Keep every generic result callback's payload tied to this call instance,
/// including unresolved ordinary type variables. Existing payload labels carry
/// that identity through aliases, containers and later substitutions.
export fn bind_generic_result_effect_instantiations(t: Type, callee: Option[(Type, Type)], defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], off: Int) -> (Type, Subst, Int) {
  match callee {
    Some((CtForAll(_, _, _), _)) => if field_effect_type_has_row(t) {
      let read = (row: String) -> Array[Type] {
        let items = callback_row_instantiations(row = row, callee = callee, defs = defs)
        if Array::length(published_marker_words(row)) > 0 && Array::length(items) == 0 {
          let readable = strip_published_row_marks(row)
          Array::push(errors, value = "write a concrete callback result row: `\{readable}` has no payload type resolved by this call\{off_marker(off)}")
        }
        items
      }
      bind_field_effect_type(t = t, read = read, defs = defs, s = s, c = c, keep = false)
    } else {
      (t, s, c)
    },
    _ => (t, s, c)
  }
}

/// #3387: a generic function taken as a value (`let f = if c { run } else {
/// run }`, `[run]`, `Holder::{ f: run }`). Its rows are text that spells the
/// scheme's formals, and nothing renames a formal inside text, so once the
/// value left the place it was instantiated the row `Box[Wrap[T]]` had no
/// link to the variable `T` became: a callback passed to `f` was handed
/// nothing and its perform chose the payload. Each row item this
/// instantiation fixes gets an `#einst:` label on a variable bound to the
/// payload, here, while the scheme and its instantiation are both in hand;
/// the label is what every later reader compares (`callback_arg_env`,
/// `effect_inst_arg_check`, `effect_inst_call_check`), however the value
/// travels. The written item is kept beside it for the readers of the text.
///
/// `own_row` false leaves the function's own row as written: a bare alias
/// (`let g = f`) is generalized afresh and its own row respelled for the
/// effect pass, which reports a call through it (`missing { State[String] }`).
export fn bind_generic_value_effect_instantiations(scheme: Type, inst: Type, defs: Array[TypeDef], s: Subst, c: Int, own_row: Bool) -> (Type, Subst, Int) {
  match scheme {
    CtForAll(_, _, _) => if field_effect_type_has_row(inst) {
      let callee = Some((scheme, inst))
      let read = (row: String) -> Array[Type] {
        callback_row_instantiations(row = row, callee = callee, defs = defs)
      }
      match inst {
        CtFn(params, ret, row) => if own_row {
          bind_field_effect_type(t = inst, read = read, defs = defs, s = s, c = c, keep = true)
        } else {
          let (ps, s1, c1) = bind_field_effect_types(items = params, read = read, defs = defs, s = s, c = c, keep = true)
          let (rt, s2, c2) = bind_field_effect_type(t = ret, read = read, defs = defs, s = s1, c = c1, keep = true)
          (CtFn(ps, rt, row), s2, c2)
        },
        _ => bind_field_effect_type(t = inst, read = read, defs = defs, s = s, c = c, keep = true)
      }
    } else {
      (inst, s, c)
    },
    _ => (inst, s, c)
  }
}

/// Resolve a generic struct field's function rows in the receiver's scope
/// before the field leaves that scope. The existing payload labels preserve
/// this evidence through arbitrary projections, aliases and containers.
export fn bind_struct_field_effect_instantiations(t: Type, recv: Type, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {
  if !field_effect_type_has_row(t) {
    (t, s, c)
  } else {
    bind_struct_field_effect_receiver(t = t, recv = recv, defs = defs, s = s, c = c)
  }
}

fn bind_struct_field_effect_receiver(t: Type, recv: Type, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {
  match recv {
    CtNamed(name, args) => match find_typedef(defs = defs, name = name) {
      Some(TDStruct(_, _, _, params)) => if Array::length(params) > 0 && Array::length(params) == Array::length(args) {
        bind_field_effect_type(t = t, read = (row: String) -> Array[Type] {
          struct_field_row_instantiations(row = row, recv = recv, defs = defs)
        }, defs = defs, s = s, c = c, keep = false)
      } else {
        (t, s, c)
      },
      _ => (t, s, c)
    },
    _ => (t, s, c)
  }
}

fn field_effect_type_has_row(_ t: Type) -> Bool {
  match t {
    CtFn(params, ret, row) => {
      let mut found = match row {
        Some(text) => String::contains(text, needle = "["),
        None => false
      }
      for p in params {
        if field_effect_type_has_row(p) {
          found = true
        }
      }
      found || field_effect_type_has_row(ret)
    },
    CtArray(e) => field_effect_type_has_row(e),
    CtOption(e) => field_effect_type_has_row(e),
    CtTuple(items) => field_effect_types_have_row(items),
    CtNamed(_, args) => field_effect_types_have_row(args),
    CtApplied(head, args) => field_effect_type_has_row(head) || field_effect_types_have_row(args),
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, ft) = field
        if field_effect_type_has_row(ft) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

fn field_effect_types_have_row(_ items: Array[Type]) -> Bool {
  let mut found = false
  for item in items {
    if field_effect_type_has_row(item) {
      found = true
    }
  }
  found
}

fn bind_field_effect_type(t: Type, read: (String) -> Array[Type], defs: Array[TypeDef], s: Subst, c: Int, keep: Bool) -> (Type, Subst, Int) {
  match t {
    CtFn(params, ret, row) => {
      let (ps, s1, c1) = bind_field_effect_types(items = params, read = read, defs = defs, s = s, c = c, keep = keep)
      let (rt, s2, c2) = bind_field_effect_type(t = ret, read = read, defs = defs, s = s1, c = c1, keep = keep)
      let (eff, s3, c3) = bind_field_effect_row(row = row, read = read, defs = defs, s = s2, c = c2, keep = keep)
      (CtFn(ps, rt, eff), s3, c3)
    },
    CtArray(e) => {
      let (et, ns, nc) = bind_field_effect_type(t = e, read = read, defs = defs, s = s, c = c, keep = keep)
      (CtArray(et), ns, nc)
    },
    CtOption(e) => {
      let (et, ns, nc) = bind_field_effect_type(t = e, read = read, defs = defs, s = s, c = c, keep = keep)
      (CtOption(et), ns, nc)
    },
    CtTuple(items) => {
      let (ts, ns, nc) = bind_field_effect_types(items = items, read = read, defs = defs, s = s, c = c, keep = keep)
      (CtTuple(ts), ns, nc)
    },
    CtRecord(fields) => {
      let mut ns = s
      let mut nc = c
      let fs = for field in fields {
        let (name, ft) = field
        let (nt, next_s, next_c) = bind_field_effect_type(t = ft, read = read, defs = defs, s = ns, c = nc, keep = keep)
        ns = next_s
        nc = next_c
        (name, nt)
      }
      (CtRecord(fs), ns, nc)
    },
    CtNamed(name, args) => {
      let (ts, ns, nc) = bind_field_effect_types(items = args, read = read, defs = defs, s = s, c = c, keep = keep)
      (CtNamed(name, ts), ns, nc)
    },
    CtApplied(head, args) => {
      let (ht, s1, c1) = bind_field_effect_type(t = head, read = read, defs = defs, s = s, c = c, keep = keep)
      let (ts, ns, nc) = bind_field_effect_types(items = args, read = read, defs = defs, s = s1, c = c1, keep = keep)
      (CtApplied(ht, ts), ns, nc)
    },
    _ => (t, s, c)
  }
}

fn bind_field_effect_types(items: Array[Type], read: (String) -> Array[Type], defs: Array[TypeDef], s: Subst, c: Int, keep: Bool) -> (Array[Type], Subst, Int) {
  let mut ns = s
  let mut nc = c
  let ts = for item in items {
    let (nt, next_s, next_c) = bind_field_effect_type(t = item, read = read, defs = defs, s = ns, c = nc, keep = keep)
    ns = next_s
    nc = next_c
    nt
  }
  (ts, ns, nc)
}

fn bind_field_effect_row(row: Option[String], read: (String) -> Array[Type], defs: Array[TypeDef], s: Subst, c: Int, keep: Bool) -> (Option[String], Subst, Int) {
  match row {
    Some(text) => {
      let out: Array[String] = []
      let mut ns = s
      let mut nc = c
      for raw in row_items_top_level(text) {
        let label = String::trim(raw)
        let items = read(label)
        let vouched = published_nominal_names(published_nominal_words(label))
        let mut replaced = false
        for item in items {
          match effect_inst_wanted_payload(item) {
            Some((name, payload)) => if callback_type_exact(t = payload, formals = [
            ], declared = true, defs = defs, vouched = vouched) && row_writes_effect_instantiation(row = label, name = name) {
              let (id, next_c) = fresh_unbound_var(s = ns, c = nc)
              nc = next_c
              match unify(a = CtVar(id), b = payload, s = ns) {
                Some(next_s) => {
                  ns = next_s
                  // `keep` leaves the written item beside its label, so the
                  // readers of the row text still see what they did before.
                  Array::push(out, value = if keep {
                    label
                  } else {
                    name
                  })
                  Array::push(out, value = effect_inst_label(eff = name, id = id))
                  replaced = true
                },
                None => ()
              }
            },
            None => ()
          }
        }
        if !replaced {
          Array::push(out, value = label)
        }
      }
      (Some(String::join(out, sep = ", ")), ns, nc)
    },
    None => (None, s, c)
  }
}

/// Can a callback row's type argument `t`, read in the callee's scope, be
/// bound for the lambda's performs? A callee formal this call fixes reads as
/// the variable the call instantiated it with; that is the only way a variable
/// reaches the row's scope. One still spelled by its own name is a formal the
/// call does not fix (only the row names it), so it is not bound; nor is a
/// name nothing declares. For a generic callee whose formals are unknown
/// (`declared` false: one checked as an expression, whose row is not
/// published) a formal cannot be told from a type name, so only
/// compiler-owned types are read there.
///
/// Every structure a row argument resolves to is read by its parts, so a
/// function type is bound like a tuple (Codex on #3340). A row argument is
/// written as a name or an application, but an alias expands to whatever it
/// names: under `type Mapper = (Int) -> Int`, `with Box[Mapper]` resolves to a
/// function type, which this used to call inexact, so a callback performing
/// `Box::Put((s: String) -> Int { .. })` was handed nothing and its handler
/// called the closure with an `Int`. A function type's own row is read as
/// written, the way the callee's handler reads it.
fn callback_type_exact(t: Type, formals: Array[String], declared: Bool, defs: Array[TypeDef], vouched: Array[String]) -> Bool {
  match t {
    CtInt => true,
    CtInt32 => true,
    CtUInt32 => true,
    CtDouble => true,
    CtFloat => true,
    CtBool => true,
    CtString => true,
    CtChar => true,
    CtUnit => true,
    CtBytes => true,
    CtArray(e) => callback_type_exact(t = e, formals = formals, declared = declared, defs = defs, vouched = vouched),
    CtOption(e) => callback_type_exact(t = e, formals = formals, declared = declared, defs = defs, vouched = vouched),
    CtTuple(es) => callback_types_exact(ts = es, formals = formals, declared = declared, defs = defs, vouched = vouched),
    CtConstructor(n, _) => declared || n == "Array" || n == "Option",
    CtVar(_) => true,
    CtStruct(_) => declared,
    CtEnum(_) => declared,
    CtNamed(n, args) => {
      let known = match find_typedef(defs = defs, name = n) {
        Some(_) => true,
        None => match compiler_owned_type_arity(n) {
          Some(_) => true,
          None => checker_string_array_has(items = vouched, wanted = n)
        }
      }
      declared && known && !formals_contain_source_name(formals = formals, name = n) && callback_types_exact(ts = args, formals = formals, declared = declared, defs = defs, vouched = vouched)
    },
    CtApplied(h, args) => declared && callback_type_exact(t = h, formals = formals, declared = declared, defs = defs, vouched = vouched) && callback_types_exact(ts = args, formals = formals, declared = declared, defs = defs, vouched = vouched),
    CtFn(params, ret, _) => callback_types_exact(ts = params, formals = formals, declared = declared, defs = defs, vouched = vouched) && callback_type_exact(t = ret, formals = formals, declared = declared, defs = defs, vouched = vouched),
    CtRecord(fields) => {
      let mut all = true
      for field in fields {
        let (_, ft) = field
        if !callback_type_exact(t = ft, formals = formals, declared = declared, defs = defs, vouched = vouched) {
          all = false
        } else {
          ()
        }
      }
      all
    },
    // Neither is a type a written row argument resolves to.
    CtForAll(_, _, _) => false,
    CtUnknown => false
  }
}

fn callback_types_exact(ts: Array[Type], formals: Array[String], declared: Bool, defs: Array[TypeDef], vouched: Array[String]) -> Bool {
  let mut all = true
  for t in ts {
    if !callback_type_exact(t = t, formals = formals, declared = declared, defs = defs, vouched = vouched) {
      all = false
    } else {
      ()
    }
  }
  all
}

//# A lambda's own instantiation (#3341)

/// #3341: the generic-effect instantiations a lambda's body is checked under,
/// and the variables its type records them by. On top of
/// `bind_lambda_row_effect_instantiations`:
///
/// - a lambda with no row of its own, not passed straight to a callback
///   parameter and not inside a `handle` of the effect, performs each
///   one-parameter generic effect at ONE variable of its own, so its
///   performs agree with each other. Before, each perform took a fresh
///   instantiation and nothing compared it with the place the lambda was
///   used: `let g = () -> Int { perform Box::Put(1) }` passed to a
///   `() -> Int with Box[String]` parameter, or called inside a `with
///   Box[String]` function, checked clean and a `String` arm read the `Int`;
/// - a lambda whose own row writes `Box[Int]` records that instantiation the
///   same way, so it is compared where it is used too: function types unify
///   row labels by base name (#1340), and a `Box[Int]` lambda passed to a
///   `Box[String]` parameter was accepted.
///
/// The variables reach the lambda's type as `#einst:` labels
/// (`lambda_effect_inst_row`), which `effect_inst_arg_check` and
/// `effect_inst_call_check` read at an argument and at a direct call. A
/// top-level declaration with a bare row also records the payload its body
/// fixes. Publication resolves that carrier before dropping session-local
/// variable IDs. A generic lambda's variables may be quantified with its
/// formals; its concrete consumers must require an explicit row contract.
export fn bind_lambda_effect_instantiations(env: TypeEnv, row: Option[String], defs: Array[TypeDef], tparams: Array[String], errors: Array[String], s: Subst, c: Int, top_level: Bool, generic: Bool) -> (TypeEnv, Subst, Int, Array[(String, Int)]) {
  let base = bind_lambda_row_effect_instantiations(env = env, row = row, defs = defs, tparams = tparams, errors = errors)
  let pairs: Array[(String, Int)] = []
  let top_level_pure = match row {
    None => top_level,
    Some(_) => false
  }
  if generic {
    // #3411: a generic declaration's BARE label still gets a variable for its
    // payload, so `generic_bare_row_payload_errors` can see what the body
    // fixes it to. Written labels are left to the scheme, as before. A kinded
    // effect (`Kb[F[_]]`) is included (#3418): its variable is the
    // constructor the body performs at.
    let mut gout = base
    let mut gs = s
    let mut gc = c
    for d in defs {
      match d {
        TDEffect(name, _, etps) => if Array::length(etps) == 1 && effect_inst_row_has_bare(row = row, name = name) {
          let (tid, nc) = fresh_unbound_var(s = gs, c = gc)
          gc = nc
          let own_inst = CtTuple([CtVar(tid)])
          gout = env_bind(env = env_bind(env = gout, name = effect_inst_env_key(name), ty = own_inst), name = effect_row_inst_key(name), ty = own_inst)
          Array::push(pairs, value = (name, tid))
        } else {
          ()
        },
        _ => ()
      }
    }
    (gout, gs, gc, pairs)
  } else if top_level_pure {
    (base, s, c, pairs)
  } else {
    let mut out = base
    let mut s1 = s
    let mut c1 = c
    for d in defs {
      match d {
        TDEffect(name, _, etps) => if Array::length(etps) == 1 {
          match row {
            Some(text) => if row_writes_effect_instantiation(row = text, name = name) {
              if !top_level {
                match env_lookup(env = base, name = effect_inst_env_key(name)) {
                  Some(CtTuple(targs)) => if Array::length(targs) == 1 {
                    let (tid, nc) = fresh_unbound_var(s = s1, c = c1)
                    c1 = nc
                    match unify(a = CtVar(tid), b = Array::get(targs, at = 0), s = s1) {
                      Some(ns) => {
                        s1 = ns
                        Array::push(pairs, value = (name, tid))
                      },
                      None => ()
                    }
                  } else {
                    ()
                  },
                  _ => ()
                }
              }
            } else if effect_inst_row_has_bare(row = Some(text), name = name) {
              let (tid, nc) = fresh_unbound_var(s = s1, c = c1)
              c1 = nc
              let own_inst = CtTuple([CtVar(tid)])
              out = env_bind(env = env_bind(env = out, name = effect_inst_env_key(name), ty = own_inst), name = effect_row_inst_key(name), ty = own_inst)
              Array::push(pairs, value = (name, tid))
            } else {
              ()
            },
            // A hand-off is per effect: Box[String] + Other supplies
            // Box's binding but must still track Other independently.
            None => {
              match env_lookup(env = base, name = effect_inst_env_key(name)) {
                // An enclosing handle's instantiation is inherited, as before.
                Some(CtTuple(_)) => (),
                _ => {
                  let (tid, nc) = fresh_unbound_var(s = s1, c = c1)
                  c1 = nc
                  let own_inst = CtTuple([CtVar(tid)])
                  out = env_bind(env = env_bind(env = out, name = effect_inst_env_key(name), ty = own_inst), name = effect_row_inst_key(name), ty = own_inst)
                  Array::push(pairs, value = (name, tid))
                }
              }
            }
          }
        } else {
          ()
        },
        _ => ()
      }
    }
    (out, s1, c1, pairs)
  }
}

/// #3411: a generic declaration's bare `with Box` publishes no payload, so a
/// caller's `with Box[String]` covered it by name and `mk(12345)` reached a
/// `Box[String]` handler, which read the `Int` as a string. When the body
/// fixes the payload -- to one of the declaration's formals or to a concrete
/// type -- the row has to say so. `pairs` are the bare labels'
/// variables (`bind_lambda_effect_instantiations`), `s` the substitution
/// after the body. The refusal points at the body's first `perform` of the
/// effect, the site that most likely fixed the payload, or else at the body
/// (#3423: it used to carry no position at all).
export fn generic_bare_row_payload_errors(pairs: Array[(String, Int)], tparams: Array[String], tparam_ids: Array[Int], s: Subst, body: Expr, errors: Array[String]) -> Unit {
  for pair in pairs {
    let (name, tid) = pair
    let payload = subst_apply(s = s, ty = CtVar(tid))
    // The declaration's formals print by name, so a nested payload reads
    // `Option[T]` (Codex on #3414); any other open variable prints `_`.
    let mut named = SubstEmpty
    let mut formal = ""
    let mut fi = 0
    while fi < Array::length(tparam_ids) && fi < Array::length(tparams) {
      let fname = type_param_name(Array::get(tparams, at = fi))
      let resolved = subst_apply(s = s, ty = CtVar(Array::get(tparam_ids, at = fi)))
      if formal == "" && types_equal(a = resolved, b = payload) {
        formal = fname
      }
      match resolved {
        CtVar(k) => {
          named = SubstBind(k, CtNamed(fname, []), named)
        },
        _ => ()
      }
      fi = fi + 1
    }
    let written = if formal != "" {
      formal
    } else {
      match payload {
        CtVar(_) => "",
        CtUnknown => "",
        // A kinded effect's payload is a constructor, spelled as a row
        // writes it (`Kb[Array]`, not `Kb[Array/1]`; Codex on #3420).
        _ => open_vars_as_wildcards(effect_payload_text(subst_apply(s = named, ty = payload)))
      }
    }
    if written != "" {
      let perform_off = first_perform_off(e = body, eff = name)
      let off = if perform_off >= 0 {
        perform_off
      } else {
        railway_expr_off(body)
      }
      Array::push(errors, value = "write `with \{name}[\{written}]`: this generic function performs `\{name}` at `\{written}`, and a bare `with \{name}` lets a caller's `\{name}[..]` of another type cover it\{off_marker(off)}")
    } else {
      ()
    }
  }
  ()
}

/// A rendered type with each inference variable (`?t9`) written `_`.
fn open_vars_as_wildcards(_ text: String) -> String {
  let out = StringBuilder::new()
  let n = String::length(text)
  let mut i = 0
  while i < n {
    if i + 1 < n && String::byte_at(text, at = i) == 63 && String::byte_at(text, at = i + 1) == 116 {
      StringBuilder::push(out, value = "_")
      i = i + 2
      while i < n && String::byte_at(text, at = i) >= 48 && String::byte_at(text, at = i) <= 57 {
        i = i + 1
      }
    } else {
      StringBuilder::push(out, value = String::substring(text, start = i, end = i + 1))
      i = i + 1
    }
  }
  StringBuilder::freeze(out)
}

/// A variable `s` does not bind yet, and the next counter. The counter can
/// hand out an id an earlier declaration's check already bound (measured: a
/// `handle` arm resuming with a generic struct literal), and a label on such a
/// variable would compare the lambda's performs with that unrelated type.
fn fresh_unbound_var(s: Subst, c: Int) -> (Int, Int) {
  let mut next = c
  let mut id = 0 - 1
  while id < 0 {
    let (_, nc) = fresh_var(next)
    match subst_lookup(s = s, id = nc - 1) {
      Some(_) => (),
      None => {
        id = nc - 1
      }
    }
    next = nc
  }
  (id, next)
}

/// Does the row text write `name` with a type argument (`Box[Int]`)?
fn row_writes_effect_instantiation(row: String, name: String) -> Bool {
  let mut found = false
  for raw in row_items_top_level(row) {
    let label = String::trim(raw)
    let bi = String::index_of(label, needle = "[")
    if bi > 0 && label[0: bi] == name {
      found = true
    } else {
      ()
    }
  }
  found
}

/// #3341: the lambda's row with an `#einst:<effect>:<id>` label for each of
/// its own instantiation variables (`bind_lambda_effect_instantiations`). One
/// its own row writes is always recorded; one a row-less lambda made is
/// recorded only when its body read it (`effect_inst_used_vars`), so a lambda
/// that never performs `Box` is not tied to any `Box` instantiation.
export fn lambda_effect_inst_row(effect: Option[String], row: Option[String], pairs: Array[(String, Int)]) -> Option[String] {
  let mut out = effect
  for pair in pairs {
    let (name, id) = pair
    let used = match row {
      Some(text) => row_writes_effect_instantiation(row = text, name = name) || int_array_has(items = effect_inst_used_vars, wanted = id),
      None => int_array_has(items = effect_inst_used_vars, wanted = id)
    }
    if used {
      out = merge_provenance_row(expected = out, actual = Some(effect_inst_label(eff = name, id = id)))
    } else {
      ()
    }
  }
  out
}

fn effect_inst_label(eff: String, id: Int) -> String {
  String::concat("#einst:", String::concat(eff, String::concat(":", __to_string(id))))
}

/// #3341: (effect, instantiation variable) for each `#einst:` label of `row`.
export fn effect_inst_labels(_ row: Option[String]) -> Array[(String, Int)] {
  let out: Array[(String, Int)] = []
  let text = match row {
    Some(r) => r,
    None => ""
  }
  if String::contains(text, needle = "#einst:") {
    for raw in row_items_top_level(text) {
      let label = String::trim(raw)
      if is_effect_inst_label(label) {
        let rest = String::substring(label, start = 7, end = String::length(label))
        let n = String::length(rest)
        let mut cut = 0 - 1
        let mut i = 0
        while i < n {
          if String::byte_at(rest, at = i) == 58 {
            cut = i
          } else {
            ()
          }
          i = i + 1
        }
        if cut > 0 && cut + 1 < n {
          let mut id = 0
          let mut digits = true
          let mut p = cut + 1
          while p < n {
            let ch = String::byte_at(rest, at = p)
            if ch >= 48 && ch <= 57 {
              id = id * 10 + (ch - 48)
            } else {
              digits = false
            }
            p = p + 1
          }
          if digits {
            Array::push(out, value = (String::substring(rest, start = 0, end = cut), id))
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
    }
    ()
  } else {
    ()
  }
  out
}

// These raw types cannot reach a function row in effect_inst_value_check.
// Keep the aggregate and function paths conservative; substitutions are still
// applied by the callers that previously applied them.
fn effect_inst_leaf_slot(_ ty: Type) -> Bool {
  match ty {
    CtFn(_, _, _) => false,
    CtTuple(items) => Array::length(items) == 0,
    CtArray(_) => false,
    CtOption(_) => false,
    CtRecord(fields) => Array::length(fields) == 0,
    CtNamed(_, args) => Array::length(args) == 0,
    CtApplied(_, _) => false,
    _ => true
  }
}

/// #3341: compare the instantiations a function value records
/// (`#einst:` labels) with the row of the parameter it is passed to. The
/// parameter's row is read in the callee's scope (`callback_row_instantiations`),
/// so a formal it names is the type this call gives it.
export fn effect_inst_arg_check(env: TypeEnv, arg: Expr, arg_ty: Type, param_ty: Type, s: Subst, callee: Option[(Type, Type)], callee_name: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let arg = call_arg_value(arg)
  if effect_inst_leaf_slot(param_ty) {
    return s
  }
  let subject = if String::length(callee_name) > 0 {
    "the function passed to `\{callee_name}`"
  } else {
    "the function passed here"
  }
  effect_inst_value_check(env = env, arg = arg, arg_ty = arg_ty, param_ty = param_ty, s = s, read = (row: String) -> Array[Type] {
    let wants = callback_row_instantiations(row = row, callee = callee, defs = defs)
    // A bare callback effect forwarded by the callee reaches the caller's
    // row. Effects handled inside the callee have no such requirement.
    let binding = match callee {
      Some((scheme, _)) => Some(scheme),
      None => env_lookup(env = env, name = callee_name)
    }
    let forwarded = effect_inst_function_row(binding)
    let explicit = match forwarded {
      Some(text) => callback_row_instantiations(row = text, callee = callee, defs = defs),
      None => []
    }
    for raw in row_items_top_level(row) {
      let name = String::trim(raw)
      let mut concrete = false
      for item in explicit {
        match item {
          CtNamed(eff, _) => if eff == name {
            concrete = true
            Array::push(wants, value = item)
          },
          _ => ()
        }
      }
      if !concrete && effect_inst_row_has_bare(row = forwarded, name = name) {
        match env_lookup(env = env, name = effect_inst_env_key(name)) {
          Some(CtTuple(args)) => if Array::length(args) == 1 {
            Array::push(wants, value = CtNamed(name, [CtTuple(args)]))
          },
          _ => ()
        }
      }
    }
    wants
  }, subject = subject, slot = "the parameter's row", defs = defs, errors = errors, mode = 1)
}

/// #3387: the part of `effect_inst_arg_check` that a parameter whose type
/// names no row for an effect needs (`effect_inst_unnamed_slot_check`), run
/// once the call's arguments are unified with its parameters: an unannotated
/// lambda parameter has its type by then, so the performed payload is read
/// as the call fixed it rather than fixed by this comparison.
export fn effect_inst_unnamed_args_check(env: TypeEnv, args: Array[Expr], arg_tys: Array[Type], param_tys: Array[Type], s: Subst, callee_name: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let args = call_arg_values(args)
  let subject = if String::length(callee_name) > 0 {
    "the function passed to `\{callee_name}`"
  } else {
    "the function passed here"
  }
  // Mode 2 reads no row text.
  let read = (row: String) -> Array[Type] {
    array_empty()
  }
  let mut out = s
  let mut i = 0
  while i < Array::length(args) && i < Array::length(arg_tys) && i < Array::length(param_tys) {
    out = effect_inst_value_check(env = env, arg = Array::get(args, at = i), arg_ty = subst_apply(s = out, ty = Array::get(arg_tys, at = i)), param_ty = subst_apply(s = out, ty = Array::get(param_tys, at = i)), s = out, read = read, subject = subject, slot = "the parameter's row", defs = defs, errors = errors, mode = 2)
    i = i + 1
  }
  out
}

/// #3387: `effect_inst_unnamed_args_check` for one argument whose parameter
/// type `param_ty` is already known: a `TaskGroup::spawn` callback, a
/// `TaskGroup::run` body. It calls the worker directly rather than passing
/// `effect_inst_unnamed_args_check` one-element array literals: a compiler
/// before #3406's codegen fix miscompiles that shape, and the committed seed
/// is one. Fold this into the worker once the seed carries the fix.
export fn effect_inst_unnamed_arg_check(env: TypeEnv, arg: Expr, arg_ty: Type, param_ty: Type, s: Subst, callee_name: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let arg = call_arg_value(arg)
  let read = (row: String) -> Array[Type] {
    array_empty()
  }
  effect_inst_value_check(env = env, arg = arg, arg_ty = subst_apply(s = s, ty = arg_ty), param_ty = subst_apply(s = s, ty = param_ty), s = s, read = read, subject = "the function passed to `\{callee_name}`", slot = "the parameter's row", defs = defs, errors = errors, mode = 2)
}

/// #3387: `effect_inst_unnamed_arg_check` for a builtin's callback parameter,
/// whose type has no row at all (`Array::map`, `Array::filter`).
export fn effect_inst_rowless_arg_check(env: TypeEnv, arg: Expr, arg_ty: Type, s: Subst, callee_name: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let arg = call_arg_value(arg)
  effect_inst_unnamed_arg_check(env = env, arg = arg, arg_ty = arg_ty, param_ty = CtFn(array_empty(), CtUnknown, None), s = s, callee_name = callee_name, defs = defs, errors = errors)
}

/// Codex on #3340: `effect_inst_arg_check` for a field call `r.f(..)`, whose
/// parameter's row is read in the receiver's struct
/// (`struct_field_row_instantiations`).
export fn field_effect_inst_arg_check(env: TypeEnv, arg: Expr, arg_ty: Type, param_ty: Type, s: Subst, recv: Type, field: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let arg = call_arg_value(arg)
  if effect_inst_leaf_slot(param_ty) {
    return s
  }
  effect_inst_value_check(env = env, arg = arg, arg_ty = arg_ty, param_ty = param_ty, s = s, read = (row: String) -> Array[Type] {
    struct_field_row_instantiations(row = row, recv = recv, defs = defs)
  }, subject = "the function passed to `\{field}`", slot = "the parameter's row", defs = defs, errors = errors, mode = 1)
}

/// #3387: `field_effect_inst_arg_check` for a value stored in a struct
/// literal's field, after the value's type is checked against the field's:
/// both the field's row and a row the field's type does not name.
export fn struct_field_effect_inst_check(env: TypeEnv, value: Expr, value_ty: Type, field_ty: Type, s: Subst, recv: Type, field: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  if effect_inst_leaf_slot(field_ty) {
    return s
  }
  effect_inst_value_check(env = env, arg = value, arg_ty = value_ty, param_ty = field_ty, s = s, read = (row: String) -> Array[Type] {
    struct_field_row_instantiations(row = row, recv = recv, defs = defs)
  }, subject = "the function stored in `\{field}`", slot = "the field's row", defs = defs, errors = errors, mode = 0)
}

/// #3341: the same comparison for a function value bound by an annotated
/// `let` or returned under a declared return type: `want_ty` was written in
/// this scope, so only the names it resolves to exactly are read
/// (`callback_type_exact`).
export fn effect_inst_annotation_check(env: TypeEnv, value: Expr, value_ty: Type, want_ty: Type, s: Subst, subject: String, slot: String, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  if effect_inst_leaf_slot(want_ty) {
    return s
  }
  effect_inst_value_check(env = env, arg = value, arg_ty = value_ty, param_ty = want_ty, s = s, read = (row: String) -> Array[Type] {
    if String::contains(row, needle = "$") {
      callback_row_instantiations(row = row, callee = None, defs = defs)
    } else {
      lexical_value_row_instantiations_at(row = row, env = env, defs = defs, closed = true)
    }
  }, subject = subject, slot = slot, defs = defs, errors = errors, mode = 0)
}

/// #3417: the same comparison for `name = value` on a `let mut` binding.
/// Before, `let mut f = h` with `h` performing `Box[String]` accepted
/// `f = g` with `g` performing `Box[Int]`: row labels unify by base name, and
/// no hand-off ran on an assignment. The binding's row is read like an
/// annotation's, in this scope, so a formal of the enclosing binder is that
/// formal. A row with a published row's marks (`T$0`, `^Name`), or one this
/// scope cannot read (a generic `mk[U]`'s `Box[U]` after `let mut f = mk`),
/// is read in the value's own scope instead (`value_effect_instantiations` on
/// the target's name), where an imported nominal still resolves.
export fn assignment_effect_inst_check(env: TypeEnv, name: String, value: Expr, value_ty: Type, var_ty: Type, s: Subst, defs: Array[TypeDef], errors: Array[String]) -> Subst {
  let want_ty = subst_apply(s = s, ty = var_ty)
  if effect_inst_leaf_slot(want_ty) {
    return s
  }
  let target = EIdent(name, 0 - 1)
  effect_inst_value_check(env = env, arg = value, arg_ty = value_ty, param_ty = want_ty, s = s, read = (row: String) -> Array[Type] {
    let marked = String::contains(row, needle = "$") || String::contains(row, needle = "^")
    let lexical = if marked {
      array_empty()
    } else {
      lexical_value_row_instantiations_at(row = row, env = env, defs = defs, closed = true)
    }
    let payloads: Array[Type] = []
    for item in lexical {
      match effect_inst_wanted_payload(item) {
        Some((_, payload)) => Array::push(payloads, value = payload),
        None => ()
      }
    }
    if !marked && (callback_row_unreadable(payloads) is None) {
      lexical
    } else {
      let wants: Array[Type] = []
      for pair in value_effect_instantiations(env = env, arg = target, arg_ty = want_ty, arow = row, s = s, defs = defs) {
        let (eff, t) = pair
        Array::push(wants, value = CtNamed(eff, [CtTuple([t])]))
      }
      wants
    }
  }, subject = "the function assigned to `\{name}`", slot = "the variable's row", defs = defs, errors = errors, mode = 0)
}

fn effect_inst_value_check(env: TypeEnv, arg: Expr, arg_ty: Type, param_ty: Type, s: Subst, read: (String) -> Array[Type], subject: String, slot: String, defs: Array[TypeDef], errors: Array[String], mode: Int) -> Subst {
  let arg = call_arg_value(arg)
  if effect_inst_leaf_slot(param_ty) {
    return s
  }
  match (param_ty, arg_ty) {
    (CtTuple(wants), CtTuple(haves)) => {
      let children = match arg {
        ETuple(items) => items,
        _ => []
      }
      effect_inst_items_check(env = env, arg = arg, children = children, haves = haves, wants = wants, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
    },
    (CtArray(want), CtArray(have)) => match arg {
      EArray(items) => {
        let mut out = s
        for item in items {
          out = effect_inst_value_check(env = env, arg = item, arg_ty = have, param_ty = want, s = out, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
        }
        out
      },
      _ => effect_inst_value_check(env = env, arg = arg, arg_ty = have, param_ty = want, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
    },
    (CtOption(want), CtOption(have)) => {
      let child = match arg {
        ECall(_, items, _, _) => if Array::length(items) == 1 {
          Array::get(items, at = 0)
        } else {
          arg
        },
        _ => arg
      }
      effect_inst_value_check(env = env, arg = child, arg_ty = have, param_ty = want, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
    },
    (CtRecord(wants), CtRecord(haves)) => {
      let mut out = s
      for field in wants {
        let (name, want) = field
        for actual in haves {
          let (aname, have) = actual
          if name == aname {
            let child = effect_inst_record_child(arg = arg, name = name)
            out = effect_inst_value_check(env = env, arg = child, arg_ty = have, param_ty = want, s = out, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
          }
        }
      }
      out
    },
    (CtNamed(name, wants), CtNamed(aname, haves)) => if name == aname {
      effect_inst_items_check(env = env, arg = arg, children = [], haves = haves, wants = wants, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
    } else {
      s
    },
    (CtApplied(head, wants), CtApplied(ahead, haves)) => {
      let out = effect_inst_value_check(env = env, arg = arg, arg_ty = ahead, param_ty = head, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
      effect_inst_items_check(env = env, arg = arg, children = [], haves = haves, wants = wants, s = out, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
    },
    _ => effect_inst_fn_check(env = env, arg = arg, arg_ty = arg_ty, param_ty = param_ty, s = s, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
  }
}

fn effect_inst_record_child(arg: Expr, name: String) -> Expr {
  let mut child = arg
  match arg {
    ERecord(_, fields, _) => for field in fields {
      let (fname, value) = field
      if fname == name {
        child = value
      }
    },
    _ => ()
  }
  child
}

fn effect_inst_items_check(env: TypeEnv, arg: Expr, children: Array[Expr], haves: Array[Type], wants: Array[Type], s: Subst, read: (String) -> Array[Type], subject: String, slot: String, defs: Array[TypeDef], errors: Array[String], mode: Int) -> Subst {
  let mut out = s
  if Array::length(haves) == Array::length(wants) {
    let mut i = 0
    while i < Array::length(haves) {
      let child = if i < Array::length(children) {
        Array::get(children, at = i)
      } else {
        arg
      }
      out = effect_inst_value_check(env = env, arg = child, arg_ty = Array::get(haves, at = i), param_ty = Array::get(wants, at = i), s = out, read = read, subject = subject, slot = slot, defs = defs, errors = errors, mode = mode)
      i = i + 1
    }
  }
  out
}

fn effect_inst_function_row(_ binding: Option[Type]) -> Option[String] {
  match binding {
    Some(CtFn(_, _, row)) => row,
    Some(CtForAll(_, _, body)) => effect_inst_function_row(Some(body)),
    _ => None
  }
}

fn effect_inst_row_has_bare(row: Option[String], name: String) -> Bool {
  let mut found = false
  match row {
    Some(text) => for raw in row_items_top_level(text) {
      if String::trim(raw) == name {
        found = true
      }
    },
    None => ()
  }
  found
}

fn effect_inst_wanted_payload(_ item: Type) -> Option[(String, Type)] {
  match item {
    CtNamed(name, args) => if Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        CtTuple(ts) => if Array::length(ts) == 1 {
          Some((name, Array::get(ts, at = 0)))
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn effect_inst_fn_check(env: TypeEnv, arg: Expr, arg_ty: Type, param_ty: Type, s: Subst, read: (String) -> Array[Type], subject: String, slot: String, defs: Array[TypeDef], errors: Array[String], mode: Int) -> Subst {
  // Read row text in its declaration's scope; substitutions are only applied
  // to the payloads that both rows actually name.
  match (param_ty, arg_ty) {
    (CtFn(_, _, prow_opt), CtFn(_, _, arow_opt)) => {
      let labelled: Array[Type] = []
      // Mode 2 compares only what the slot's row does not name.
      let slot_row = if mode == 2 {
        None
      } else {
        prow_opt
      }
      let wants = match slot_row {
        Some(prow) => {
          // A projected field may also carry its parameter's resolved row as
          // payload labels, which must constrain a callback passed to the field.
          for label in effect_inst_labels(Some(prow)) {
            let (name, id) = label
            Array::push(labelled, value = CtNamed(name, [
              CtTuple([subst_apply(s = s, ty = CtVar(id))])
            ]))
          }
          prefer_row_labels(read = read(prow), labelled = labelled)
        },
        None => []
      }
      let arow = match arow_opt {
        Some(text) => text,
        None => ""
      }
      let haves = if String::length(arow) > 0 && mode != 2 {
        value_effect_instantiations(env = env, arg = arg, arg_ty = arg_ty, arow = arow, s = s, defs = defs)
      } else {
        []
      }
      let mut out = s
      // #3387: every label the slot carries for one effect is a payload the
      // function passed here must perform at, so they are one type. A
      // function whose row does not name the effect never performs it, so
      // the disagreement does not reach it (Codex on #3407).
      let conflicted: Array[String] = []
      for eff in conflicting_label_effects(labelled = labelled, s = out) {
        if row_names_effect(row = arow_opt, eff = eff) {
          Array::push(conflicted, value = eff)
        } else {
          ()
        }
      }
      for eff in conflicted {
        Array::push(errors, value = effect_inst_conflict_message(subject = subject, slot = slot, eff = eff, labelled = labelled, s = out, off = effect_inst_arg_anchor(arg)))
      }
      let mut li = 0
      while li < Array::length(labelled) {
        match effect_inst_wanted_payload(Array::get(labelled, at = li)) {
          Some((eff, want)) => if !checker_string_array_has(items = conflicted, wanted = eff) {
            let mut lj = li + 1
            while lj < Array::length(labelled) {
              match effect_inst_wanted_payload(Array::get(labelled, at = lj)) {
                Some((other, other_want)) => if other == eff {
                  match unify(a = want, b = other_want, s = out) {
                    Some(ns) => out = ns,
                    None => ()
                  }
                },
                None => ()
              }
              lj = lj + 1
            }
          },
          None => ()
        }
        li = li + 1
      }
      for item in wants {
        match effect_inst_wanted_payload(item) {
          Some((eff, want)) => if !checker_string_array_has(items = conflicted, wanted = eff) {
            let mut found = false
            let mut refused = false
            match callback_row_unreadable([want]) {
              Some((label, missing)) => {
                refused = true
                Array::push(errors, value = "import `\{missing}` into this module: \{subject} is checked against `\{label}`, which names a type unavailable here\{off_marker(effect_inst_arg_anchor(arg))}")
              },
              None => ()
            }
            for pair in haves {
              let (name, have) = pair
              if name == eff && !refused {
                found = true
                match callback_row_unreadable([have]) {
                  Some((label, missing)) => {
                    refused = true
                    Array::push(errors, value = "import `\{missing}` into this module: \{subject}'s row `\{label}` names a type unavailable here\{off_marker(effect_inst_arg_anchor(arg))}")
                  },
                  None => match unify(a = have, b = want, s = out) {
                    Some(ns) => out = ns,
                    None => Array::push(errors, value = effect_inst_value_message(subject = subject, slot = slot, eff = eff, have = subst_apply(s = out, ty = have), want = subst_apply(s = out, ty = want), off = effect_inst_arg_anchor(arg)))
                  }
                }
              }
            }
            if !found && !refused && effect_inst_row_has_bare(row = Some(arow), name = eff) {
              let want_text = effect_payload_text(subst_apply(s = out, ty = want))
              Array::push(errors, value = "write a concrete `\{eff}[\{want_text}]` row on \{subject}: its bare `\{eff}` contract does not establish the payload type required by \{slot}\{off_marker(effect_inst_arg_anchor(arg))}")
            }
          },
          _ => ()
        }
      }
      // A call reads the slot's own row per argument (mode 1) and a row the
      // slot does not name once its arguments are unified (mode 2).
      if mode == 1 {
        out
      } else {
        effect_inst_unnamed_slot_check(env = env, arg = arg, arg_ty = arg_ty, arow = arow, prow = prow_opt, s = out, subject = subject, slot = slot, errors = errors)
      }
    },
    _ => s
  }
}

/// #3387: a function value that records the instantiation it performs a
/// generic effect at, passed into a slot whose function type does not name
/// that effect (`f: () -> Int`, a struct field typed `() -> Int`, a row
/// variable). Nothing in the slot's type carries the instantiation any further,
/// so it can no longer be compared where the value is finally called. A
/// perform the slot's type does not mention is the enclosing function's, as it
/// is for any row-less lambda (the handle check refuses one that a `handle`
/// in a callee could reach), so it is compared HERE with the instantiation in
/// scope: the enclosing function's row, or an enclosing row-less lambda's own
/// variable. Before, `apply(() -> { perform Box::Put(12345) })` with `fn
/// apply(f: () -> Int)`, inside a `with Box[String]` function, checked clean
/// and its handler's `String::length` of the payload answered `24690`.
/// An enclosing `handle`'s instantiation is left to the handle's own check,
/// as at a direct call (`effect_inst_call_check`).
fn effect_inst_unnamed_slot_check(env: TypeEnv, arg: Expr, arg_ty: Type, arow: String, prow: Option[String], s: Subst, subject: String, slot: String, errors: Array[String]) -> Subst {
  let mut out = s
  let reported: Array[String] = []
  // Only a label is lost here. A row the value's type spells (`with
  // State[String]`) stays in that type: a row-less slot refuses it when the
  // types unify, and a row variable carries it on to the effect check.
  let binding = match arg {
    EIdent(name, _) => env_lookup(env = env, name = name),
    _ => None
  }
  let haves: Array[(String, Type)] = []
  for label in effect_inst_labels(Some(arow)) {
    let (eff, id) = label
    match label_type_at_use(s = s, id = id, binding = binding, used = arg_ty) {
      Some(t) => Array::push(haves, value = (eff, t)),
      None => ()
    }
  }
  for pair in haves {
    let (eff, have) = pair
    if !row_names_effect(row = prow, eff = eff) && !checker_string_array_has(items = reported, wanted = eff) {
      let from_row = match (env_lookup(env = env, name = effect_row_inst_key(eff)), env_lookup(env = env, name = effect_inst_env_key(eff))) {
        (Some(row_inst), Some(inst)) => types_equal(a = row_inst, b = inst),
        _ => false
      }
      match env_lookup(env = env, name = effect_inst_env_key(eff)) {
        Some(CtTuple(targs)) => if Array::length(targs) == 1 && from_row {
          note_effect_inst_used(targs)
          let want = Array::get(targs, at = 0)
          match unify(a = have, b = want, s = out) {
            Some(ns) => out = ns,
            None => {
              Array::push(reported, value = eff)
              Array::push(errors, value = effect_inst_unnamed_slot_message(subject = subject, slot = slot, eff = eff, have = subst_apply(s = out, ty = have), want = subst_apply(s = out, ty = want), off = effect_inst_arg_anchor(arg)))
            }
          }
        } else {
          ()
        },
        _ => ()
      }
    } else {
      ()
    }
  }
  out
}

/// Does the row name `eff` at all: bare, with a type argument, or by an
/// `#einst:` label?
fn row_names_effect(row: Option[String], eff: String) -> Bool {
  let mut found = false
  match row {
    Some(text) => {
      for raw in row_items_top_level(text) {
        let label = String::trim(raw)
        let bi = String::index_of(label, needle = "[")
        if label == eff || (bi > 0 && label[0: bi] == eff) {
          found = true
        } else {
          ()
        }
      }
      for label in effect_inst_labels(row) {
        let (name, _) = label
        if name == eff {
          found = true
        } else {
          ()
        }
      }
    },
    None => ()
  }
  found
}

/// A lambda's written row or a current parameter's provenance-marked row is
/// owned by this lexical environment. Read its enclosing formals by active
/// binder identities and arities. Published and independently quantified
/// values continue to use their own scheme.
fn lexical_value_row_instantiations(row: String, env: TypeEnv, defs: Array[TypeDef]) -> Array[Type] {
  lexical_value_row_instantiations_at(row = row, env = env, defs = defs, closed = false)
}

/// Return checking follows the owning binder's close; its lexical env still
/// supplies the exact formal identity. Value lookups retain the open-group guard.
fn lexical_value_row_instantiations_at(row: String, env: TypeEnv, defs: Array[TypeDef], closed: Bool) -> Array[Type] {
  let formals: Array[String] = []
  for binding in eq_formal_vars {
    let (id, name) = binding
    let formal_index = match env_lookup(env = env, name = name) {
      Some(CtVar(bound)) => if bound == id {
        eq_formal_row_of(bound)
      } else {
        0 - 1
      },
      Some(CtNamed(head, _)) => if head == String::concat("#hktformal.", name) {
        eq_formal_rigid_row(name)
      } else {
        0 - 1
      },
      _ => 0 - 1
    }
    if formal_index >= 0 && (closed || eq_group_is_open(Array::get(eq_formal_group, at = formal_index))) {
      let (_, recorded_name) = Array::get(eq_formal_vars, at = formal_index)
      if recorded_name == name && !formals_contain_source_name(formals = formals, name = name) {
        Array::push(formals, value = eq_formal_binder_spelling(name = name, arity = Array::get(eq_formal_arity, at = formal_index)))
      }
    }
  }
  callback_row_instantiations_at(row = row, formals = formals, scope = env, declared = true, defs = defs, params = array_empty(), args = array_empty())
}

/// The instantiation a function value performs each one-parameter generic
/// effect at, as far as its type says: an `#einst:` label's variable, read at
/// this use (`label_type_at_use`), else a row item whose argument names a type
/// exactly, read with no formal in scope (`callback_row_instantiations`): a
/// top-level function's own row, or a callback parameter's. A row item naming
/// a formal is not read. `arg_ty` is the value's type at this use.
fn value_effect_instantiations(env: TypeEnv, arg: Expr, arg_ty: Type, arow: String, s: Subst, defs: Array[TypeDef]) -> Array[(String, Type)] {
  let out: Array[(String, Type)] = []
  let labels = effect_inst_labels(Some(arow))
  let binding = match arg {
    EIdent(name, _) => env_lookup(env = env, name = name),
    _ => None
  }
  for label in labels {
    let (eff, id) = label
    match label_type_at_use(s = s, id = id, binding = binding, used = arg_ty) {
      Some(t) => Array::push(out, value = (eff, t)),
      None => ()
    }
  }
  if row_names_instantiation(arow) {
    // A joined value can carry several concrete rows for the same effect.
    // Read each alternative separately: binding the entire union as one row
    // would replace contradictory payloads with CtUnit and lose both.
    let scope = match binding {
      Some(scheme) => Some((scheme, arg_ty)),
      None => None
    }
    let lexical_row = !String::contains(arow, needle = "$") && match arg {
      EFn(tparams, _, _, _, Some(written), _) => Array::length(tparams) == 0 && row_names_instantiation(written),
      EIdent(name, _) => match env_lookup(env = env, name = String::concat("__param_marker__", name)) {
        Some(CtNamed(marker, _)) => checker_string_array_has(items = row_items_top_level(arow), wanted = marker),
        _ => false
      },
      _ => false
    }
    // #3537: an effect the `#einst:` labels above already resolved is not
    // read again from a MARKED text item (`Box[T$0]`). The markers index the
    // quantifier list of the scheme the value was instantiated from, and a
    // monomorphic binding (a call result is not generalized) or a call
    // through one no longer has that scheme in hand, so the text would read
    // the formal as a type of the same name and refuse it. The label is what
    // fixes the payload (#3387); the text is kept beside it for readers that
    // have the scheme.
    let label_effects: Array[String] = []
    for resolved in out {
      let (eff, _) = resolved
      Array::push(label_effects, value = eff)
    }
    for raw in row_items_top_level(arow) {
      let item_text = String::trim(raw)
      let bracket = String::index_of(item_text, needle = "[")
      let covered = bracket > 0 && String::contains(item_text, needle = "$") && checker_string_array_has(items = label_effects, wanted = item_text[0: bracket])
      let items = if covered {
        array_empty()
      } else if lexical_row {
        lexical_value_row_instantiations_at(row = String::trim(raw), env = env, defs = defs, closed = match arg {
          EFn(_, _, _, _, _, _) => true,
          _ => false
        })
      } else {
        callback_row_instantiations(row = String::trim(raw), callee = scope, defs = defs)
      }
      for item in items {
        match item {
          CtNamed(iname, iargs) => if Array::length(iargs) == 1 {
            match Array::get(iargs, at = 0) {
              CtTuple(ts) => if Array::length(ts) == 1 {
                Array::push(out, value = (iname, Array::get(ts, at = 0)))
              },
              _ => ()
            }
          },
          _ => ()
        }
      }
    }
    ()
  } else {
    ()
  }
  out
}

/// #3341: compare the instantiations a called function value records with
/// the one in scope at the call: the enclosing function's own row's, or an
/// enclosing row-less lambda's own variable -- the row the performs are
/// charged to. An enclosing `handle`'s is left to the handle's own check of
/// the callees it reaches (#3010, #3022), and the effect pass refuses a
/// row-less lambda called under a handle. `binding` is the callee's type as
/// bound and `callee_ty` its type at this call (`label_type_at_use`). The
/// callee's type is read as written: a value that carries labels is a
/// function type.
export fn effect_inst_call_check(env: TypeEnv, binding: Option[Type], callee_ty: Type, callee_name: String, off: Int, s: Subst, errors: Array[String]) -> Subst {
  match callee_ty {
    CtFn(_, _, Some(row)) => if String::contains(row, needle = "#einst:") {
      let labels = effect_inst_labels(Some(row))
      let mut out = s
      for label in labels {
        let (eff, id) = label
        let from_row = match (env_lookup(env = env, name = effect_row_inst_key(eff)), env_lookup(env = env, name = effect_inst_env_key(eff))) {
          (Some(row_inst), Some(inst)) => types_equal(a = row_inst, b = inst),
          _ => false
        }
        match env_lookup(env = env, name = effect_inst_env_key(eff)) {
          Some(CtTuple(targs)) => if Array::length(targs) == 1 && from_row {
            match label_type_at_use(s = out, id = id, binding = binding, used = callee_ty) {
              Some(have) => {
                note_effect_inst_used(targs)
                let want = Array::get(targs, at = 0)
                match unify(a = have, b = want, s = out) {
                  Some(ns) => {
                    out = ns
                  },
                  None => Array::push(errors, value = effect_inst_call_message(callee_name = callee_name, eff = eff, have = subst_apply(s = out, ty = have), want = subst_apply(s = out, ty = want), off = off))
                }
              },
              None => ()
            }
          } else {
            ()
          },
          _ => ()
        }
      }
      out
    } else {
      s
    },
    _ => s
  }
}

/// The type a label's variable `id` stands for at one use of a binding.
/// A let-generalized lambda generic in its payload (`let g = (x) -> {
/// perform Box::Put(x) }`) has a scheme that quantifies the payload's
/// variable, and the label, being text, still names the scheme's variable.
/// Each quantified variable it reaches is read at the position the scheme
/// holds it in `used`, this use's instantiated type. None when one has no
/// such position, so nothing is compared.
fn label_type_at_use(s: Subst, id: Int, binding: Option[Type], used: Type) -> Option[Type] {
  let lt = subst_apply(s = s, ty = CtVar(id))
  match binding {
    Some(CtForAll(vs, _, body)) => {
      let reached: Array[Int] = []
      for v in collect_tvars(lt) {
        if int_array_has(items = vs, wanted = v) && !int_array_has(items = reached, wanted = v) {
          Array::push(reached, value = v)
        } else {
          ()
        }
      }
      if Array::length(reached) == 0 {
        Some(lt)
      } else {
        let pairs: Array[(Int, Type)] = []
        pair_quantified(scheme = body, used = used, vs = vs, out = pairs)
        let mut sub = SubstEmpty
        let mut complete = true
        for v in reached {
          let mut found = false
          for pair in pairs {
            let (q, t) = pair
            if q == v && !found {
              found = true
              sub = SubstBind(v, t, sub)
            } else {
              ()
            }
          }
          if !found {
            complete = false
          } else {
            ()
          }
        }
        if complete {
          Some(subst_apply(s = sub, ty = lt))
        } else {
          None
        }
      }
    },
    _ => Some(lt)
  }
}

/// Pair each quantified variable of `scheme` with what `used` holds at the
/// same position.
fn pair_quantified(scheme: Type, used: Type, vs: Array[Int], out: Array[(Int, Type)]) -> Unit {
  match scheme {
    CtVar(q) => if int_array_has(items = vs, wanted = q) {
      Array::push(out, value = (q, used))
    } else {
      ()
    },
    CtFn(ps, r, _) => match used {
      CtFn(ups, ur, _) => {
        pair_quantified_lists(xs = ps, ys = ups, vs = vs, out = out)
        pair_quantified(scheme = r, used = ur, vs = vs, out = out)
      },
      _ => ()
    },
    CtArray(e) => match used {
      CtArray(ue) => pair_quantified(scheme = e, used = ue, vs = vs, out = out),
      _ => ()
    },
    CtOption(e) => match used {
      CtOption(ue) => pair_quantified(scheme = e, used = ue, vs = vs, out = out),
      _ => ()
    },
    CtTuple(es) => match used {
      CtTuple(ues) => pair_quantified_lists(xs = es, ys = ues, vs = vs, out = out),
      _ => ()
    },
    CtNamed(n, args) => match used {
      CtNamed(un, uargs) => if n == un {
        pair_quantified_lists(xs = args, ys = uargs, vs = vs, out = out)
      } else {
        ()
      },
      _ => ()
    },
    // #3387 (Codex on #3407): a constructor formal applied to arguments
    // (`F[Int]` of `put[F[_]](x: F[Int])`) pairs its head with the head the
    // use holds, read the way unification reads `Array[Int]` or `Box[Int]`.
    CtApplied(head, args) => match type_application_view(used) {
      Some((uhead, uargs)) => {
        pair_quantified(scheme = head, used = uhead, vs = vs, out = out)
        pair_quantified_lists(xs = args, ys = uargs, vs = vs, out = out)
      },
      None => ()
    },
    _ => ()
  }
}

fn pair_quantified_lists(xs: Array[Type], ys: Array[Type], vs: Array[Int], out: Array[(Int, Type)]) -> Unit {
  if Array::length(xs) == Array::length(ys) {
    let mut i = 0
    while i < Array::length(xs) {
      pair_quantified(scheme = Array::get(xs, at = i), used = Array::get(ys, at = i), vs = vs, out = out)
      i = i + 1
    }
  } else {
    ()
  }
}

fn effect_inst_arg_anchor(_ arg: Expr) -> Int {
  match arg {
    EFn(_, _, _, _, _, body) => railway_expr_off(body),
    _ => railway_expr_off(arg)
  }
}

/// An effect payload as a row spells it: a kinded parameter's payload is a
/// bare constructor, written `Option` in `Kb[Option]`, not `Option/1`.
fn effect_payload_text(_ t: Type) -> String {
  match t {
    CtConstructor(name, _) => name,
    _ => type_to_string(t)
  }
}

fn effect_inst_value_message(subject: String, slot: String, eff: String, have: Type, want: Type, off: Int) -> String {
  let have_text = effect_payload_text(have)
  let want_text = effect_payload_text(want)
  "make \{subject} perform `\{eff}` at `\{want_text}`: it performs `\{eff}` at `\{have_text}`, but \{slot} is `\{eff}[\{want_text}]` (its handler would read the `\{have_text}` as `\{want_text}`)\{off_marker(off)}"
}

fn effect_inst_conflict_message(subject: String, slot: String, eff: String, labelled: Array[Type], s: Subst, off: Int) -> String {
  let texts: Array[String] = []
  for item in labelled {
    match effect_inst_wanted_payload(item) {
      Some((name, want)) => if name == eff {
        let text = effect_payload_text(subst_apply(s = s, ty = want))
        if !checker_string_array_has(items = texts, wanted = text) {
          Array::push(texts, value = text)
        }
      },
      None => ()
    }
  }
  let listed = String::join(for t in texts {
    "`\{eff}[\{t}]`"
  }, sep = " and ")
  "call each function joined into this callee on its own: \{slot} is \{listed} at once, because the functions joined here disagree on `\{eff}`, and \{subject} cannot perform `\{eff}` at both\{off_marker(off)}"
}

fn effect_inst_unnamed_slot_message(subject: String, slot: String, eff: String, have: Type, want: Type, off: Int) -> String {
  let have_text = effect_payload_text(have)
  let want_text = effect_payload_text(want)
  "make \{subject} perform `\{eff}` at `\{want_text}`: it performs `\{eff}` at `\{have_text}`, and \{slot} names no `\{eff}`, so its performs reach the `\{eff}[\{want_text}]` in scope here (its handler would read the `\{have_text}` as `\{want_text}`)\{off_marker(off)}"
}

fn effect_inst_call_message(callee_name: String, eff: String, have: Type, want: Type, off: Int) -> String {
  let callee = if String::length(callee_name) > 0 {
    String::concat("`", String::concat(callee_name, "`"))
  } else {
    "the called function"
  }
  let have_text = effect_payload_text(have)
  let want_text = effect_payload_text(want)
  "make \{callee} perform `\{eff}` at `\{want_text}`, or handle `\{eff}` around this call: it performs `\{eff}` at `\{have_text}`, and the `\{eff}` in scope here is `\{eff}[\{want_text}]`\{off_marker(off)}"
}

/// Publish inferred concrete payloads as ordinary row arguments, then drop
/// every `#einst:` label: its variables belong to this check and cannot be
/// read by an importer or a cache. An unresolved bare contract remains bare
/// and cannot satisfy a concrete callback row without an explicit annotation.
export fn strip_effect_inst_labels(t: Type, s: Subst, defs: Array[TypeDef]) -> Type {
  match t {
    CtFn(params, ret, eff) => CtFn(for p in params {
      strip_effect_inst_labels(t = p, s = s, defs = defs)
    }, strip_effect_inst_labels(t = ret, s = s, defs = defs), strip_effect_inst_row(eff = eff, s = s, defs = defs)),
    CtArray(e) => CtArray(strip_effect_inst_labels(t = e, s = s, defs = defs)),
    CtOption(e) => CtOption(strip_effect_inst_labels(t = e, s = s, defs = defs)),
    CtTuple(items) => CtTuple(for item in items {
      strip_effect_inst_labels(t = item, s = s, defs = defs)
    }),
    CtRecord(fields) => CtRecord(for field in fields {
      let (fname, fty) = field
      (fname, strip_effect_inst_labels(t = fty, s = s, defs = defs))
    }),
    CtNamed(name, args) => CtNamed(name, for arg in args {
      strip_effect_inst_labels(t = arg, s = s, defs = defs)
    }),
    CtApplied(head, args) => CtApplied(strip_effect_inst_labels(t = head, s = s, defs = defs), for arg in args {
      strip_effect_inst_labels(t = arg, s = s, defs = defs)
    }),
    CtForAll(vs, bounds, body) => CtForAll(vs, bounds, strip_effect_inst_labels(t = body, s = s, defs = defs)),
    _ => t
  }
}

fn strip_effect_inst_row(eff: Option[String], s: Subst, defs: Array[TypeDef]) -> Option[String] {
  match eff {
    Some(row) => if String::contains(row, needle = "#einst:") {
      let kept = array_empty()
      let inferred: Array[(String, Type)] = []
      for label in effect_inst_labels(eff) {
        let (name, id) = label
        let ty = subst_apply(s = s, ty = CtVar(id))
        if Array::length(collect_tvars(ty)) == 0 && callback_type_exact(t = ty, formals = [
        ], declared = true, defs = defs, vouched = []) {
          Array::push(inferred, value = (name, ty))
        }
      }
      for raw in row_items_top_level(row) {
        let label = String::trim(raw)
        if !is_effect_inst_label(label) && String::length(label) > 0 {
          let mut published = label
          for inst in inferred {
            let (name, ty) = inst
            if label == name {
              published = "\{name}[\{effect_payload_text(ty)}]"
            }
          }
          Array::push(kept, value = published)
        } else {
          ()
        }
      }
      if Array::length(kept) == 0 {
        None
      } else {
        Some(String::join(kept, sep = ", "))
      }
    } else {
      eff
    },
    None => None
  }
}
