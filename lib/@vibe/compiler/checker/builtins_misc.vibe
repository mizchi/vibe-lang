//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn misc_no_params() -> Array[Type] {
  array_empty()
}

fn misc_one_param(a: Type) -> Array[Type] {
  let arr = misc_no_params()
  Array::push(arr, a)
  arr
}

fn lookup_not(name: String) -> Option[Type] {
  if name == "not" {
    Some(CtFn(misc_one_param(CtBool), CtBool, None))
  }
  else None
}

fn lookup_neg(name: String) -> Option[Type] {
  if name == "__neg" {
    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))
  }
  else None
}

fn misc_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = misc_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

/// #1520: this is a SHADOWED declaration -- `eq` has a checker-visible registry
/// row, and `lookup_builtin` consults the registry before this chain, so nothing
/// reads it. It said `(Int, Int) -> Bool` while `eq` is the structural-equality
/// builtin and is applied to enums / structs / strings; the registry carried the
/// same untruth until #1519 made the checker read parameter types and
/// `eq(Color::Red, c)` started being rejected. Kept in sync (rather than
/// deleted) because 85 of the 154 registry rows are shadowed like this and
/// deleting one of them would be an arbitrary partial cleanup -- the
/// "registry and lane tables agree" test in tests/builtins_test.vibe is what
/// makes the whole set self-checking.
fn lookup_eq(name: String) -> Option[Type] {
  if name == "eq" {
    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtBool, None))
  }
  else None
}

fn lookup_arithmetic_helper(name: String) -> Option[Type] {
  if name == "add" || name == "sub" || name == "mul" {
    Some(CtFn(misc_two_params(CtInt, CtInt), CtInt, None))
  } else if name == "lt" {
    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))
  } else {
    None
  }
}

fn lookup_none(name: String) -> Option[Type] {
  if name == "None" {
    Some(CtOption(CtUnknown))
  }
  else None
}

fn lookup_some(name: String) -> Option[Type] {
  if name == "Some" {
    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))
  }
  else None
}

fn lookup_index(name: String) -> Option[Type] {
  if name == "__index" {
    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtUnknown, None))
  }
  else if name == "__set_field" {
    // Build the param list inline rather than via the shared `misc_three_params`
    // helper: adding a second call site for that private helper triggered a
    // namespace-hash collision in the wasm bundler (#492).
    let set_field_params = misc_no_params()
    Array::push(set_field_params, CtUnknown)
    Array::push(set_field_params, CtString)
    Array::push(set_field_params, CtUnknown)
    Some(CtFn(set_field_params, CtUnit, None))
  }
  else None
}

fn lookup_print(name: String) -> Option[Type] {
  if name == "print" {
    Some(CtFn(misc_one_param(CtString), CtUnit, None))
  }
  else None
}

fn lookup_throw(name: String) -> Option[Type] {
  if name == "throw" {
    // #786: `throw` accepts any value, not just String — a `suberror` value
    // (`throw(KeyInvalid("x"))`) is thrown through the same Exception effect.
    // The Exception handler arms are unchecked (see checker EHandle), so
    // widening the payload from CtString to CtUnknown only affects the throw
    // call site and still accepts every existing `throw("msg")`.
    //
    // #1461: the label is the CANONICAL erased spelling, so it moved with
    // canonical_exception_effect_name. `with Exception` still authorizes this
    // requirement -- the comparison goes through exception_effect_labels_equal.
    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, Some("Exception")))
  }
  else None
}

fn misc_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = misc_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_slice(name: String) -> Option[Type] {
  if name == "__slice" {
    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))
  }
  else None
}

fn lookup_assert(name: String) -> Option[Type] {
  if name == "assert" {
    Some(CtFn(misc_one_param(CtBool), CtUnit, None))
  }
  else if name == "assert_true" {
    Some(CtFn(misc_one_param(CtBool), CtUnit, None))
  }
  else if name == "assert_eq" {
    Some(CtFn([
      CtUnknown,
      CtUnknown
    ], CtUnit, None))
  }
  else None
}

fn lookup_println(name: String) -> Option[Type] {
  if name == "println" {
    Some(CtFn(misc_one_param(CtString), CtUnit, None))
  }
  else None
}

fn lookup_to_string(name: String) -> Option[Type] {
  if name == "__to_string" {
    Some(CtFn(misc_one_param(CtUnknown), CtString, None))
  }
  else None
}

/// #1374: the static type name of the payload of the throw currently being
/// handled, or "" when the throw site's payload type was not syntactically
/// resolvable. Only meaningful INSIDE an exception handler arm.
///
/// This is a checker-only intrinsic: it has no wasm body and no entry in the
/// codegen builtin registry, because `desugar_trait_dicts` lowers every call to
/// a read of the one-slot module cell it also maintains (see the "#1374"
/// section of desugar_trait_dict.vibe). Effect `None` -- reading the cell can
/// neither perform nor throw.
///
/// It exists because ADR-0085's runtime carries a single abortive tag with no
/// kind, so an erased `with Exception { Throw(m) => .. }` arm also catches every
/// typed `Exception[E]` and cannot otherwise tell what `m` actually is.
///
/// `__exn_message` (#1392 slice 3) is the companion read: the payload RENDERED
/// at the throw site, where its static type is still known. The kind alone says
/// "this is not text" without saying what it says, and the arm cannot recover
/// that -- its binder is `CtUnknown`, so no `T::to_string` and no `[T: Show]`
/// witness resolves there. Same shape, same cell, same one-unwind window.
fn lookup_exn_kind(name: String) -> Option[Type] {
  if name == "__exn_kind" || name == "__exn_message" {
    Some(CtFn(misc_no_params(), CtString, None))
  }
  else None
}

fn lookup_len(name: String) -> Option[Type] {
  if name == "__len" {
    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))
  }
  else None
}

fn lookup_iter_intrinsic(name: String) -> Option[Type] {
  if name == "iter_require" {
    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))
  } else if name == "iter_length" {
    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))
  } else if name == "iter_get" {
    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))
  } else if name == "String::iter_length" {
    Some(CtFn(misc_one_param(CtString), CtInt, None))
  } else if name == "String::iter_get" {
    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))
  } else if name == "Map::iter_length" {
    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))
  } else if name == "Map::iter_get" {
    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))
  } else {
    None
  }
}

fn lookup_char_to_int(name: String) -> Option[Type] {
  if name == "Char::to_int" {
    Some(CtFn(misc_one_param(CtChar), CtInt, None))
  }
  else None
}

fn lookup_misc_group_a(name: String) -> Option[Type] {
  match lookup_arithmetic_helper(name) {
    Some(t) => Some(t),
    None => match lookup_eq(name) {
      Some(t) => Some(t),
      None => match lookup_not(name) {
        Some(t) => Some(t),
        None => match lookup_neg(name) {
          Some(t) => Some(t),
          None => match lookup_to_string(name) {
            Some(t) => Some(t),
            None => match lookup_exn_kind(name) {
              Some(t) => Some(t),
              None => match lookup_len(name) {
                Some(t) => Some(t),
                None => lookup_index(name)
              }
            }
          }
        }
      }
    }
  }
}

fn lookup_misc_group_b(name: String) -> Option[Type] {
  match lookup_slice(name) {
    Some(t) => Some(t),
    None => match lookup_print(name) {
      Some(t) => Some(t),
      None => match lookup_println(name) {
        Some(t) => Some(t),
        None => lookup_assert(name)
      }
    }
  }
}

fn lookup_misc_group_e(name: String) -> Option[Type] {
  if name == "String::join" {
    // (Array[String], String) -> String  (host builtin)
    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))
  } else if name == "__rec_field" {
    // record-pattern desugar: __rec_field(record, index) -> field value.
    // Lenient (field type unknown); only needs to resolve, not constrain.
    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))
  } else {
    match lookup_iter_intrinsic(name) {
      Some(t) => Some(t),
      None => lookup_none(name)
    }
  }
}

fn lookup_char_from_int(name: String) -> Option[Type] {
  if name == "Char::from_int" {
    Some(CtFn(misc_one_param(CtInt), CtChar, None))
  }
  else None
}

fn lookup_double_to_int(name: String) -> Option[Type] {
  // `Float` is `CtDouble` under the hood (see core/types.vibe) — codegen
  // already treats "Double::to_int" / "Float::to_int" as the same case, so
  // accept both spellings here too.
  if name == "Double::to_int" || name == "Float::to_int" {
    Some(CtFn(misc_one_param(CtDouble), CtInt, None))
  }
  else None
}

fn lookup_int_to_double(name: String) -> Option[Type] {
  if name == "Int::to_double" || name == "Int::to_float" {
    Some(CtFn(misc_one_param(CtInt), CtDouble, None))
  }
  else if name == "Int::to_string" {
    // Documented in the cheatsheet's conversion set but never wired up —
    // codegen lowers it to the `__to_string` integer path (#740 fallout:
    // ripple_test rotted against it).
    Some(CtFn(misc_one_param(CtInt), CtString, None))
  }
  else None
}

fn lookup_double_to_i64_bits(name: String) -> Option[Type] {
  if name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" {
    Some(CtFn(misc_one_param(CtDouble), CtInt, None))
  }
  else None
}

fn lookup_misc_group_c(name: String) -> Option[Type] {
  match lookup_throw(name) {
    Some(t) => Some(t),
    None => match lookup_int_to_double(name) {
      Some(t) => Some(t),
      None => match lookup_double_to_int(name) {
        Some(t) => Some(t),
        None => lookup_double_to_i64_bits(name)
      }
    }
  }
}

fn lookup_double_from_i64_bits(name: String) -> Option[Type] {
  if name == "Double::from_i64_bits" {
    Some(CtFn(misc_one_param(CtInt), CtDouble, None))
  }
  else None
}

fn lookup_misc_group_d(name: String) -> Option[Type] {
  match lookup_double_from_i64_bits(name) {
    Some(t) => Some(t),
    None => match lookup_char_to_int(name) {
      Some(t) => Some(t),
      None => match lookup_char_from_int(name) {
        Some(t) => Some(t),
        None => lookup_some(name)
      }
    }
  }
}

/// Double::to_string / Float::to_string: codegen already lowers these through
/// `double_to_string_expr` (the same formatter string interpolation of a
/// float uses via `__to_string`) — only the checker-side registration was
/// missing.
fn lookup_double_to_string(name: String) -> Option[Type] {
  if name == "Double::to_string" || name == "Float::to_string" {
    Some(CtFn(misc_one_param(CtDouble), CtString, None))
  }
  else None
}

/// Native single-opcode f64 ops (f64.abs/floor/ceil/min/max) — cheap to wire
/// up since wasm has direct instructions for all of them.
fn lookup_double_unary_op(name: String) -> Option[Type] {
  if name == "Double::abs" || name == "Double::floor" || name == "Double::ceil" {
    Some(CtFn(misc_one_param(CtDouble), CtDouble, None))
  }
  else None
}

fn lookup_double_binary_op(name: String) -> Option[Type] {
  if name == "Double::max" || name == "Double::min" {
    Some(CtFn(misc_two_params(CtDouble, CtDouble), CtDouble, None))
  }
  else None
}

/// Int::abs/signum/is_even/is_odd/max/min/clamp are intentionally NOT
/// registered as compiler builtins here: lib/@vibe/prelude/int.vibe already
/// defines all of them as regular user-space functions (with correct
/// overflow/saturation semantics, e.g. Int::abs(int_min_value) ==
/// int_max_value). Registering them as builtins too would let this
/// checker-side entry win over the prelude definition and silently swap in
/// different (wrong-for-edge-cases) codegen — this previously broke
/// lib/@vibe/prelude/int_test.vibe after a #767 attempt added them.
fn lookup_int_parse(name: String) -> Option[Type] {
  if name == "Int::parse" {
    Some(CtFn(misc_one_param(CtString), CtOption(CtInt), None))
  }
  else if name == "Double::parse" {
    Some(CtFn(misc_one_param(CtString), CtOption(CtDouble), None))
  }
  else None
}

fn lookup_misc_group_f(name: String) -> Option[Type] {
  match lookup_double_to_string(name) {
    Some(t) => Some(t),
    None => match lookup_double_unary_op(name) {
      Some(t) => Some(t),
      None => match lookup_double_binary_op(name) {
        Some(t) => Some(t),
        None => lookup_int_parse(name)
      }
    }
  }
}

export fn lookup_misc(name: String) -> Option[Type] {
  match lookup_misc_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_misc_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_misc_group_c(name) {
        Some(t) => Some(t),
        None => match lookup_misc_group_d(name) {
          Some(t) => Some(t),
          None => match lookup_misc_group_e(name) {
            Some(t) => Some(t),
            None => lookup_misc_group_f(name)
          }
        }
      }
    }
  }
}
