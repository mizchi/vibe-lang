//# Imports

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  Type,
  TypeEnv,
  TypeExpr,
  canonical_exception_effect_name,
  env_lookup,
  exception_effect_labels_equal,
  expr_children,
  is_exception_effect_name
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen {
  canonical_builtin_name
}

// #897 (ADR-0070 Phase 3): this file was moved from
// lib/@vibe/compiler/checker_effects.vibe into checker/ itself specifically
// so this import stays a plain SAME-PACKAGE sibling reference. Before the
// move it was a `#847 Phase C exception` — a deliberate direct leaf import
// of the internal `checker/builtins.vibe` file, bypassing the (then-plain)
// facade, because `checker/checker_stmt.vibe` imports this file and the
// facade re-exports `checker_stmt.vibe`'s surface: routing through the
// facade would have closed a real cycle (checker package -> checker_stmt.vibe
// -> checker_effects.vibe -> checker package). Once checker/ became a real
// `index.vpkg` package boundary (#729's enforce_incoming_boundary_fs), an
// outside file could no longer reach `checker/builtins.vibe` directly at
// all (only through the package), so the old workaround stopped compiling.
// Moving this file INTO checker/ resolves both problems at once: this
// import is now an ordinary directory-shared-scope sibling reference (no
// facade indirection, so no cycle), and every OTHER consumer of this file's
// own exports (check_effects_stmt, check_perform_effects_stmts_env, etc.)
// now reaches them through the checker package's index.vpkg like any other
// checker export.
import ./builtins.vibe {
  lookup_builtin
}

//# Types

export enum EffectError {
  EEEffectfulCallOutsideEffect(String);
  EEPerformUndeclaredEffect(String, String);
  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a
  // set difference plus a fix-it hint for the `with { ... }` annotation.
  // Fields (all pre-rendered ", "-joined label lists, deterministic order):
  // (enclosing fn name or "" when unnamed, missing labels (sorted),
  //  declared row (source order, "" when no row), required row (sorted union)).
  EEEffectRowMismatch(String, String, String, String);
  EEAssignImmutable(String)
}

//# Functions

// #944 follow-up: the general `check_effects_expr`/`check_effects_stmt`/
// `check_effects_stmts` walk (the pre-#933 `in_effect: Bool` discipline that
// produced EEThrowOutsideEffect / EEEffectfulCallOutsideEffect for ANY
// effectful call outside an effectful context) was retired here. It had no
// live-pipeline caller -- `check_program` wires check_perform_effects_* (the
// row-based discipline below, which since #944 also checks the Error row by
// default) plus the Async-scoped check_async_effects_* pass further down --
// and was only reachable from two unit-test harnesses, which now exercise the
// live entry points instead. EEThrowOutsideEffect went with it (its only
// constructor was that walk's EThrow arm, dead since #640 Stage 2 desugared
// `throw` to `perform Error::Throw`); EEEffectfulCallOutsideEffect stays --
// check_async_effects_expr still reports it for async primitives.

export fn effect_error_to_string(err: EffectError) -> String {
  match err {
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name),
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with { ... }` or wrap in a `handle`")))),
    // #639: expected-vs-actual effect rows as a set difference, then ONE
    // deterministic fix-it hint line targeting the enclosing declaration
    // (for a call-site leak that is the CALLER, not the callee).
    EEEffectRowMismatch(fname, missing, declared, required) => {
      let head = if String::length(fname) > 0 {
        String::concat("effect row mismatch for '", String::concat(fname, "'"))
      } else {
        "effect row mismatch"
      }
      let detail = if String::length(declared) > 0 {
        String::concat(" (declared with { ", String::concat(declared, String::concat(" }, requires { ", String::concat(required, " })"))))
      } else {
        String::concat(" (no 'with' clause, requires { ", String::concat(required, " })"))
      }
      let hint = if String::length(fname) == 0 {
        String::concat("\nhint: add 'with { ", String::concat(required, " }' to the enclosing function"))
      } else if String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat("(...) -> T with { ", String::concat(required, " }'"))))
      } else {
        String::concat("\nhint: add 'with { ", String::concat(required, String::concat(" }' to '", String::concat(fname, "'"))))
      }
      String::concat(head, String::concat(": missing { ", String::concat(missing, String::concat(" }", String::concat(detail, hint)))))
    },
    EEAssignImmutable(name) => String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)"))
  }
}

//# Async-scoped effect enforcement (the pass wired into `check_program`)
//
// This pass enforces ONLY the `Async` effect, and only
// for async PRIMITIVES — the builtins `await(..)` / `sleep(..)` / `Stream::next`
// whose type carries `with { Async }`, including the `await(..)` the `for await`
// desugar injects over a Future-returning iterator. A primitive must appear
// inside a function/lambda annotated `with { Async }`.
//
// Crucially it does NOT propagate to user functions that merely COMPOSE async
// work: calling a `with { Async }` helper (e.g. `async_iter_collect`) from a
// sync context is allowed (await is the identity on the synchronous backend,
// and on a real async backend the value/Future mismatch is a separate type
// error). Only env-absent BUILTIN primitives are checked, so the compiler /
// prelude — which use `Async` only in the disciplined async_iter terminals —
// stay green while `for await` over an async stream becomes sound (#2+#3).

fn effect_opt_is_async(eff: Option[String]) -> Bool {
  effect_row_has_label(effect_row_parse(eff), "Async")
}

/// True only for async-effect BUILTIN primitives (await/sleep/Stream::next/...).
/// A name bound in `env` (a user/prelude function) is intentionally NOT treated
/// as a primitive even if its type is `with { Async }`.
fn is_async_primitive(name: String, env: TypeEnv) -> Bool {
  match env_lookup(env, name) {
    Some(_) => false,
    None => {
      let normalized = canonical_builtin_name(name)
      match lookup_builtin(normalized) {
        Some(ty) => match ty {
          CtFn(_, _, eff) => effect_opt_is_async(eff),
          _ => false
        },
        None => false
      }
    }
  }
}

/// True when a handle arm targets an Async operation.
fn handle_arms_handle_async(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if String::starts_with(name, "Async::") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

export fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {
  let errors = array_empty()
  // Preserve the legacy preorder diagnostic order: inspect a call before its
  // structural children, then delegate their enumeration to expr_children.
  match expr {
    ECall(EIdent(name, _), _, _) => if !in_async && is_async_primitive(name, env) {
      Array::push(errors, EEEffectfulCallOutsideEffect(name))
    } else {
      ()
    },
    _ => ()
  }
  match expr {
    // Scope boundary: a lambda's explicit row replaces its enclosing Async
    // context. All other expression forms retain the context unchanged.
    EFn(_, _, _, _, effect, body) => {
      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))
    },
    EHandle(body, arms) => {
      let discharges_async = handle_arms_handle_async(arms)
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async || discharges_async))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))
        ai = ai + 1
      }
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        append_eff_errs(errors, check_async_effects_expr(Array::get(children, i), env, in_async))
        i = i + 1
      }
    }
  }
  errors
}

/// A function body runs in an `{Async}` context if EITHER the lambda's inline
/// effect OR the binding's declared signature type carries `Async`.
fn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {
  match topt {
    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),
    _ => false
  }
}

fn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {
  let sig_async = sig_type_is_async(ty)
  match body {
    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),
    _ => check_async_effects_expr(body, env, sig_async)
  }
}

export fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),
    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),
    STest(_, body) => check_async_effects_expr(body, env, false),
    SBench(_, body) => check_async_effects_expr(body, env, false),
    SExpr(e) => check_async_effects_expr(e, env, false),
    _ => array_empty()
  }
}

export fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))
    i = i + 1
  }
  errors
}

//# perform-discipline enforcement (#626 criterion 1)
//
// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either
// the enclosing function/lambda declares it in `with { ... }`, or the perform
// is inside a `handle` (which discharges it). Otherwise it is a type error —
// "performing an undeclared effect". This realizes the first acceptance
// criterion of #626 (the checker formerly accepted undeclared performs because
// it never resolved which effect an op belongs to).
//
// A `handle` is treated CONSERVATIVELY as discharging any effect for its body
// (we do not yet read which specific effect its arms handle), so a perform
// inside any handle is allowed — this never rejects a valid program; it only
// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle
// case, which full row tracking (#626 criteria 2/4) will cover.

/// Parse a source `with { ... }` annotation into the canonical row. This is
/// the sole parser for checker effect rows: labels are trimmed and deduped, and
/// `None` remains structurally different from an explicit `with {}`.
fn effect_row_parse(eff: Option[String]) -> Option[Array[String]] {
  match eff {
    // None is structurally distinct from Some([]): it means the row is
    // inferred and therefore inherits its surrounding context.
    None => None,
    Some(s) => {
      let labels = array_empty()
      let raw = String::split(s, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = canonical_exception_effect_name(String::trim(Array::get(raw, i)))
        if String::length(label) > 0 && !effect_row_has_label(Some(labels), label) {
          Array::push(labels, label)
        }
        i = i + 1
      }
      // Some([]) is an explicitly pure `with {}` row.
      Some(labels)
    }
  }
}

/// Exact membership only; notably, `NotAsync` and `AsyncLike` do not contain
/// the `Async` label.
fn effect_row_has_label(row: Option[Array[String]], wanted: String) -> Bool {
  match row {
    None => false,
    Some(labels) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(labels) {
        if Array::get(labels, i) == wanted {
          found = true
        }
        i = i + 1
      }
      found
    }
  }
}

fn effect_row_labels(row: Option[Array[String]]) -> Array[String] {
  match row {
    None => array_empty(),
    Some(labels) => labels
  }
}

/// Resolve an annotation at a nested lambda boundary. Inferred rows inherit;
/// explicit rows, including `with {}`, replace the surrounding row.
fn effect_row_inherit(row: Option[Array[String]], surrounding: Array[String]) -> Array[String] {
  match row {
    None => surrounding,
    Some(labels) => labels
  }
}

/// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the
/// current representation): a function declaring `with { e }` may perform any
/// effect, so treat such a declaration as authorizing everything.
fn label_is_effect_var(name: String) -> Bool {
  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
}

fn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {
  // All concrete label checks, including Async above, go through this same
  // exact-membership primitive rather than substring matching.
  if effect_row_has_label(Some(labels), eff_name) {
    true
  } else if is_exception_effect_name(eff_name) {
    let mut alias_found = false
    let mut alias_i = 0
    while alias_i < Array::length(labels) {
      if is_exception_effect_name(Array::get(labels, alias_i)) {
        alias_found = true
      }
      alias_i = alias_i + 1
    }
    alias_found
  } else {
    let mut i = 0
    let mut has_effect_var = false
    while i < Array::length(labels) {
      if label_is_effect_var(Array::get(labels, i)) {
        has_effect_var = true
      }
      i = i + 1
    }
    has_effect_var
  }
}

/// A DIRECT `perform EffName::Op` is authorized if the declared row names
/// either the whole effect (`EffName`) or, per ADR-0071's operation-level row
/// items, the exact operation (`EffName::Op`) itself -- e.g. `with { Ask::Get
/// }` must authorize a bare `perform Ask::Get` in the same function, exactly
/// as it already authorizes a transitive call to a callee declaring `{
/// Ask::Get }` (that check compares the full qualified label directly,
/// without stripping to the base effect name).
fn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {
  if decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name) {
    true
  } else {
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      if exception_effect_labels_equal(Array::get(labels, i), op_name) {
        found = true
      }
      i = i + 1
    }
    found
  }
}

/// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the
/// segment before `::`.
fn effect_name_of_op(op_name: String) -> String {
  let idx = String::index_of(op_name, "::")
  if idx > 0 {
    canonical_exception_effect_name(op_name[0: idx])
  } else {
    canonical_exception_effect_name(op_name)
  }
}

/// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful
/// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing
/// function to declare that effect, exactly like `perform`. Returns the required
/// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw
/// discipline) and `Async` (composition-allowed; handled by the async pass) are
/// deliberately excluded from this slice.
fn builtin_call_effect(name: String) -> Option[String] {
  // `sh`/`sh_lines` and the checker_visible `vibe_*_raw` dunder builtins
  // (Codex review, PR #909) are the only UNQUALIFIED effectful builtins:
  // they lower to real `vibe.*` host imports that execute shell commands or
  // terminate the process, so calling them directly must require
  // `{ Process }` just like a qualified builtin -- otherwise they could run
  // from a pure function or a bare top-level expression undeclared. Every
  // name here is checker_visible=true in builtin_registry.vibe (directly
  // callable from source); vibe_sh_lines_raw is checker_visible=false (only
  // synthesized internally, never typed by user source) so it needs no
  // entry. Checked before the `::` fast path below.
  if name == "sh" || name == "sh_lines"
  || name == "vibe_sh_capture_raw"
  || name == "vibe_sh_capture_exit_code_raw"
  || name == "vibe_sh_capture_stdout_raw"
  || name == "vibe_sh_capture_stderr_raw"
  || name == "vibe_sh_capture_close_raw"
  || name == "vibe_process_exit_raw" {
    Some("Process")
  } else if String::index_of(name, "::") < 0 {
    // Fast path: every OTHER effectful builtin in this slice is a QUALIFIED name
    // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a
    // callee with no `::` can never be one. Skipping `lookup_builtin` for the
    // (vastly more common) unqualified calls keeps the pass cheap enough to run
    // over the whole compiler source within the seed's heap during self-build.
    None
  } else {
    let normalized = canonical_builtin_name(name)
    match lookup_builtin(normalized) {
      Some(ty) => match ty {
        CtFn(_, _, Some(eff)) => if is_exception_effect_name(eff) {
          None
        } else if eff == "Async" {
          None
        } else {
          Some(eff)
        },
        _ => None
      },
      None => None
    }
  }
}

fn labels_union(a: Array[String], b: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    let l = Array::get(b, j)
    let mut seen = false
    let mut k = 0
    while k < Array::length(out) {
      if Array::get(out, k) == l {
        seen = true
      }
      k = k + 1
    }
    if !seen {
      Array::push(out, l)
    }
    j = j + 1
  }
  out
}

/// #639: deterministic label ordering for effect-row diagnostics. Char-by-char
/// lexicographic compare, shorter-prefix-first on a tie — written out by hand
/// (see CLAUDE.md's length-first `String <` gotcha) so `{ Env, Fs }` always
/// renders in the same order.
fn label_lt(a: String, b: String) -> Bool {
  let la = String::length(a)
  let lb = String::length(b)
  let n = if la < lb {
    la
  } else {
    lb
  }
  let mut i = 0
  let mut decided = 0
  while i < n && decided == 0 {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca < cb {
      decided = 1
    } else if ca > cb {
      decided = 2
    } else {
      ()
    }
    i = i + 1
  }
  if decided == 1 {
    true
  } else if decided == 2 {
    false
  } else {
    la < lb
  }
}

/// Copying insertion sort (rows are tiny — a handful of labels at most).
fn sort_labels(xs: Array[String]) -> Array[String] {
  let out = Array::slice(xs, 0, Array::length(xs))
  let mut i = 1
  while i < Array::length(out) {
    let key = Array::get(out, i)
    let mut j = i
    while j > 0 && label_lt(key, Array::get(out, j - 1)) {
      Array::set(out, j, Array::get(out, j - 1))
      j = j - 1
    }
    Array::set(out, j, key)
    i = i + 1
  }
  out
}

fn join_labels(xs: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(xs) {
    if i == 0 {
      out = Array::get(xs, i)
    } else {
      out = String::concat(out, String::concat(", ", Array::get(xs, i)))
    }
    i = i + 1
  }
  out
}

/// #639: build the effect-row mismatch diagnostic for a perform/call whose
/// required effects are absent from the enclosing declaration's row. `missing`
/// is the set difference (callee requires minus caller declares), rendered
/// sorted; `required` is the sorted union the fix-it hint suggests declaring.
fn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String]) -> EffectError {
  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))
  let required = sort_labels(labels_union(declared, missing))
  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(declared), join_labels(required))
}

/// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after
/// handling E the body need not declare it. The parser qualifies each handler
/// arm pattern as `E::Op`, so the discharged effect names are recoverable as the
/// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a
/// handle discharges (empty if none could be determined — then the body stays
/// conservatively permissive, never over-strict).
///
/// ADR-0071 (#755) step 4: ALSO push each arm's own fully-qualified operation
/// name (`Ask::Get`, not just the bare `Ask` prefix). `handle ... with Ask
/// {...}` is exhaustive over every operation of Ask (ADR-0050 -- a handler
/// can't discharge only some operations), so discharging the bare effect
/// name is semantically equivalent to discharging every one of its qualified
/// operation names. But the DOWNSTREAM containment check
/// (decl_authorizes_effect) does exact string-label matching: a handled
/// body that transitively calls a function declaring `with { Ask::Get }`
/// (operation-level, not the bare effect) previously reported that specific
/// requirement as still missing even though the handle plainly covers it --
/// "Ask" != "Ask::Get" as strings, and the discharge list only ever
/// contained the bare form. Pushing the qualified name too is a pure
/// widening (nothing that was authorized before stops being authorized; the
/// bare-effect-name discharge and its blanket effect_name_of_op-based
/// authorization inside the body are both untouched), so it only fixes this
/// gap without changing any other observable behavior.
fn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => {
        let idx = String::index_of(name, "::")
        if idx > 0 {
          let eff = canonical_exception_effect_name(name[0: idx])
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == eff {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, eff)
          }
          let mut qseen = false
          let mut k = 0
          while k < Array::length(out) {
            if Array::get(out, k) == name {
              qseen = true
            }
            k = k + 1
          }
          if !qseen {
            Array::push(out, name)
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of
/// recursion, so the pass never exhausts the wasm call stack however deeply the
/// compiler's own source nests (long `let`/`seq` spines AND nested
/// if/match/call forms). Each stack item carries its (expr, declared, in_handle)
/// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it
/// with the discharged effects (criterion 2). Order of traversal differs from a
/// recursive pre-order walk, but the SET of effect errors found is identical, so
/// the accept/reject decision is unchanged.
/// The declared effect row of a top-level binding: the signature's `with { ... }`
/// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with
/// { E }`). Used to build the call-graph effect map for transitive enforcement.
fn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {
  let sig = sig_type_effect_labels(ty)
  match body {
    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_row_labels(effect_row_parse(eff))),
    _ => sig
  }
}

/// Look up a called function's declared effect row by linear scan over PARALLEL
/// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across
/// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap
/// (#626 OOM); the linear scan allocates nothing.
fn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(names) {
    match found {
      None => if Array::get(names, i) == name {
        found = Some(Array::get(effs, i))
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// #885 review (Codex): a `let`/`let rec`/`let mut` binding can reuse the NAME
/// of an in-scope callback-parameter overlay entry (e.g. rebinding `f` to an
/// unrelated local pure closure). Without this, `lookup_fn_effs`'s first-match
/// scan would still find the SHADOWED outer entry and reject a call to the
/// new, unrelated binding as if it were the original effectful callback --
/// a false positive on valid shadowing. Removes every overlay entry matching
/// `name` before the shadowing binding's scope is pushed onto the stack.
/// #885 review (Codex): shadow the overlay by EVERY name in `params`, in one
/// pass — used at an EFn boundary where all of the lambda's own parameter
/// names (not just the ones that become new overlay entries) must block a
/// same-named inherited entry.
fn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {
  let mut cur_names = names
  let mut cur_effs = effs
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    let shadowed = shadow_overlay(cur_names, cur_effs, pname)
    cur_names = shadowed.0
    cur_effs = shadowed.1
    i = i + 1
  }
  (cur_names, cur_effs)
}

fn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {
  let out_names = array_empty()
  let out_effs = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    if Array::get(names, i) != name {
      Array::push(out_names, Array::get(names, i))
      Array::push(out_effs, Array::get(effs, i))
    } else {
      ()
    }
    i = i + 1
  }
  (out_names, out_effs)
}

/// #885 (split off from #838, originally scoped out at #626): a function-typed
/// PARAMETER (a callback, e.g. `f: (T) -> T with { e }`) is a call-graph leaf
/// exactly like a named top-level function, but `fn_names`/`fn_effs` above is
/// built ONLY from top-level `SLet`/`SLetMut` bindings, so invoking a callback
/// PARAMETER directly (`f(x)` inside the wrapper that owns `f`) was invisible to
/// the transitive check — no lookup ever matched `f`'s name, so nothing was
/// required. This is a SEPARATE parallel-array "overlay" (ov_names/ov_effs),
/// scoped to the function body currently being walked (extended when the walk
/// descends into an `EFn`, carried unchanged through every other node), that
/// records each in-scope function-typed parameter's declared effect labels.
///
/// Deliberately narrower than the general transitive check: callback-parameter
/// labels are checked via `decl_authorizes_effect` WITHOUT the
/// `label_is_effect_var` exemption used below for calls to NAMED top-level
/// functions. That exemption exists to prevent a real unsoundness of its own —
/// naively requiring the LITERAL row-variable token (e.g. `"e"`) to appear in
/// the CALLER's declared row at a call site like `apply(inc, 41)` — since the
/// caller has no way to know the row variable resolves to nothing without
/// call-site effect-row UNIFICATION (matching the argument actually passed
/// against the callee's parameter type), which this pass does not perform. This
/// is exactly the naive fix rejected during #885's investigation: dropping the
/// exemption globally broke `generic_effect_matrix_ok_passthrough_pure.vibe`.
/// The callback-parameter case is different in kind: the row variable and the
/// declared effect being compared live in the SAME function signature (the
/// parameter's `with { e }` and the enclosing function's own `with { e }` are
/// the identical token by construction — no cross-call-site instantiation is
/// involved), so a literal-name check here is sound, not a naive shortcut.
fn build_param_overlay(params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {
  let names = array_empty()
  let effs = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    match ptype {
      Some(TyFn(_, _, eff)) => {
        let labels = effect_row_labels(effect_row_parse(eff))
        if Array::length(labels) > 0 {
          Array::push(names, pname)
          Array::push(effs, labels)
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  (names, effs)
}

/// A `let apply: [T](f: (T) -> T with { e }, x: T) -> T = (f, x) -> { f(x) }`
/// binding (separate top-level type annotation + untyped lambda) parses to an
/// `EFn` whose OWN `params` carry no per-parameter `TypeExpr` at all (the types
/// live only on the `SLet`'s `ty` field). `build_param_overlay` needs real
/// per-parameter types to find a callback parameter's declared effect, so this
/// fills in each untyped `EFn` parameter from `ty`'s `TyFn` parameter list at
/// the SAME position — the two lists describe the same signature, so positional
/// pairing is exact. An `EFn` parameter that already carries its own inline
/// type (the `[T](f: (T) -> T with { e }, ...)` generic-literal spelling used
/// elsewhere in this file) is left untouched; `ty` is consulted only to fill
/// gaps, never to override.
fn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  match ty {
    Some(TyFn(sig_params, _, _)) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, ptype) = Array::get(params, i)
        let effective = match ptype {
          Some(_) => ptype,
          None => if i < Array::length(sig_params) {
            Some(Array::get(sig_params, i))
          } else {
            None
          }
        }
        Array::push(out, (pname, effective))
        i = i + 1
      }
      out
    },
    _ => params
  }
}

/// Transitive effect enforcement (#626): a call to a user function `G` that
/// declares `with { E }` leaks E into the caller unless the caller declares E or
/// the call is under a `handle ... with E`. Combined with the DIRECT discipline
/// (every function that itself performs/invokes an effectful builtin must declare
/// it — already enforced), this propagates effect requirements up the call graph
/// level by level: every effectful leaf is annotated, so a one-level check at
/// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty
/// => transitive check disabled, preserving the direct-only behavior).
///
/// `ov_names`/`ov_effs` (#885) is the SEPARATE callback-parameter overlay
/// described above, scoped to the function body currently in view (empty at the
/// program's top level and at any call site with no enclosing function-typed
/// parameters in scope).
export fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {
  check_perform_effects_expr_tx_in("", root, root_declared, root_in_handle, fn_names, fn_effs, root_ov_names, root_ov_effs)
}

/// #639: the same walk with the enclosing top-level binding's NAME threaded in
/// so row-mismatch diagnostics can blame the caller's declaration in the fix-it
/// hint. The name is constant per walk (lambdas are anonymous), so it rides as
/// a plain parameter, not on the work stack.
fn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {
  let errors = array_empty()
  let stack = Array::slice([
    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs)
  ], 0, 1)
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let (expr, declared, in_handle, ov_names, ov_effs) = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match expr {
      ECall(callee, args, _) => {
        match callee {
          EIdent(name, _) => {
            if name == "perform" && Array::length(args) == 1 {
              match Array::get(args, 0) {
                ECall(op_callee, _, _) => match op_callee {
                  EIdent(op_name, _) => {
                    let eff = effect_name_of_op(op_name)
                    // #640 Stage 2: `Error` is exempt from the DIRECT
                    // discipline, exactly like the transitive slice below
                    // (`teff != "Error"`) and builtin_call_effect's Error
                    // carve-out — the throw row is pervasive (~970
                    // un-annotated throw sites). `throw(x)` now parses to
                    // `perform Error::Throw(x)`, so without this exemption
                    // every one of those sites would newly require
                    // `with { Error }`.
                    // Codex review (PR #1161): report the qualified
                    // operation (`op_name`, e.g. "Ask::Get"), not the
                    // stripped base effect name -- per docs/effectset.md's
                    // operation-level diagnostic contract, a fix-it should
                    // grant only the specific missing operation, not widen
                    // to the whole effect (which would over-grant when a
                    // sibling operation of the same effect is already
                    // authorized at operation granularity, e.g. `with {
                    // Ask::Other }` + a bare `perform Ask::Get`).
                    if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {
                      Array::push(errors, make_row_mismatch(fn_name, declared, [
                        op_name
                      ]))
                    } else {
                      ()
                    }
                  },
                  _ => ()
                },
                // #1157: a zero-arg operation (`Op -> T`, no parens) parses
                // its `perform` argument as a bare `EIdent`, not an `ECall`
                // — same direct-discipline check as the parenthesized form
                // above, just without an args list to look past.
                EIdent(op_name, _) => {
                  let eff = effect_name_of_op(op_name)
                  if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {
                    Array::push(errors, make_row_mismatch(fn_name, declared, [
                      op_name
                    ]))
                  } else {
                    ()
                  }
                },
                _ => ()
              }
            } else {
              match builtin_call_effect(name) {
                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {
                  Array::push(errors, make_row_mismatch(fn_name, declared, [
                    eff
                  ]))
                } else {
                  ()
                },
                None => ()
              }
            }
            // Transitive (#626): calling a user function leaks its declared
            // effects into this context unless declared here or under a handle.
            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the
            // DIRECT discipline already excludes `Error` (the throw row is
            // pervasive — nearly every function can throw) and `Async`
            // (composition is allowed; the async pass governs it), so the
            // transitive pass mirrors that exclusion. Effect-variable rows
            // (polymorphic) impose nothing HERE — call-site resolution of what
            // a row variable is instantiated to would need real effect-row
            // unification (#885 tracks that separately); naively requiring the
            // row-variable TOKEN itself in the caller's declared row produces
            // false positives (see `generic_effect_matrix_ok_passthrough_pure`).
            match lookup_fn_effs(fn_names, fn_effs, name) {
              Some(callee_effs) => {
                // #639: aggregate every effect this call site leaks into ONE
                // set-difference diagnostic ("missing { Env, Fs }") instead of
                // one error per label.
                let missing = no_str_labels()
                let mut ti = 0
                while ti < Array::length(callee_effs) {
                  let teff = Array::get(callee_effs, ti)
                  if String::length(teff) > 0 && (!is_exception_effect_name(teff) || error_row_checked()) && teff != "Async" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {
                    Array::push(missing, teff)
                  } else {
                    ()
                  }
                  ti = ti + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))
                } else {
                  ()
                }
              },
              None => ()
            }
            // #885: calling a function-typed PARAMETER (a callback) directly —
            // e.g. `f(x)` inside the wrapper that declares `f: (T) -> T with
            // { e }` — leaks `f`'s declared row into this context exactly like
            // a named function call above, but UNLIKE that case a row-variable
            // label here is NOT exempted: the parameter's `with { e }` and the
            // enclosing function's own declared row live in the SAME
            // signature, so the token `e` denotes the identical variable in
            // both places (no cross-call-site instantiation to resolve), and
            // literal-name membership is a sound check.
            match lookup_fn_effs(ov_names, ov_effs, name) {
              Some(param_effs) => {
                // #639: aggregated exactly like the named-callee case above.
                let missing = no_str_labels()
                let mut pi = 0
                while pi < Array::length(param_effs) {
                  let peff = Array::get(param_effs, pi)
                  if String::length(peff) > 0 && (!is_exception_effect_name(peff) || error_row_checked()) && peff != "Async" && !in_handle && !decl_authorizes_effect(declared, peff) {
                    Array::push(missing, peff)
                  } else {
                    ()
                  }
                  pi = pi + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))
                } else {
                  ()
                }
              },
              None => ()
            }
          },
          _ => ()
        }
        Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs))
        let mut ai = 0
        while ai < Array::length(args) {
          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs))
          ai = ai + 1
        }
      },
      EFn(_, _, params, _, effect, body) => {
        // #761: an EXPLICITLY-annotated lambda (`(x) -> { .. } with { E }`) is
        // checked against its own row E. An UN-annotated lambda's effect row is
        // INFERRED, not declared, so checking its body against an empty row is
        // wrong — it wrongly rejected an inline effectful lambda passed to a HOF
        // param whose type declares the effect (bidirectional effect checking,
        // e.g. `call_twice((c) -> { write_char(c) })`). Inherit the enclosing
        // declared context instead: the lambda may use any effect available
        // where it is written (its inferred row is surfaced in its type and
        // re-checked at the call/handle site). Conservative — like the
        // mutability pass, this can only miss errors, never invent them.
        let body_declared = effect_row_inherit(effect_row_parse(effect), declared)
        // #885: extend the callback-parameter overlay with THIS function's own
        // function-typed parameters (if any carry a declared effect), scoped to
        // its body. New entries are appended AHEAD of the inherited overlay so
        // `lookup_fn_effs` (first-match) has a same-named inner parameter
        // shadow an outer one.
        //
        // #885 review (Codex): shadowing must apply to EVERY one of this
        // lambda's own parameter names, not just the ones that end up in
        // local_names/local_effs (function-typed with a declared effect) --
        // a parameter reusing an outer callback's name with a DIFFERENT type
        // (e.g. plain `Int`, or a function type with no declared effect) must
        // still block the inherited entry, or a call to the new, unrelated
        // parameter is wrongly checked against the shadowed outer callback's
        // effect row.
        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)
        let (shadowed_ov_names, shadowed_ov_effs) = shadowed
        let (local_names, local_effs) = build_param_overlay(params)
        let body_ov_names = if Array::length(local_names) == 0 {
          shadowed_ov_names
        } else {
          let merged = Array::slice(local_names, 0, Array::length(local_names))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_names) {
            Array::push(merged, Array::get(shadowed_ov_names, oi))
            oi = oi + 1
          }
          merged
        }
        let body_ov_effs = if Array::length(local_effs) == 0 {
          shadowed_ov_effs
        } else {
          let merged = Array::slice(local_effs, 0, Array::length(local_effs))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_effs) {
            Array::push(merged, Array::get(shadowed_ov_effs, oi))
            oi = oi + 1
          }
          merged
        }
        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs))
      },
      EHandle(body, arms) => {
        let discharged = collect_handle_effects(arms)
        let body_declared = labels_union(declared, discharged)
        let body_in_handle = if Array::length(discharged) == 0 {
          true
        } else {
          in_handle
        }
        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, ai)
          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))
          ai = ai + 1
        }
      },
      ELet(name, val, body, _) => {
        // #885 review (Codex): `val` is evaluated in the OUTER scope (ELet is
        // non-recursive), so only the body's overlay needs the new binding
        // shadowed out.
        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))
      },
      ELetRec(name, val, body) => {
        // #885 review (Codex): unlike ELet, `let rec` allows `val` itself to
        // reference `name` (self-recursion), so both val and body need the
        // shadow applied.
        let (rec_ov_names, rec_ov_effs) = shadow_overlay(ov_names, ov_effs, name)
        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs))
        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs))
      },
      ELetMut(name, val, body, _) => {
        // #885 review (Codex): same as ELet -- non-recursive, only body shadows.
        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))
      },
      ESeq(a, b) => {
        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs))
      },
      EIf(cond, then_e, else_e) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs))
      },
      EMatch(scrutinee, arms) => {
        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, ai)
          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))
          ai = ai + 1
        }
      },
      EWhile(cond, body) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))
      },
      ELoop(params, body) => {
        let mut i = 0
        while i < Array::length(params) {
          let (_, init) = Array::get(params, i)
          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs))
          i = i + 1
        }
        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))
      },
      EForIn(_, _, iter, body) => {
        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))
      },
      EBinOp(_, left, right) => {
        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs))
      },
      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs)),
      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs)),
      EAssign(_, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))
      },
      EAssignOp(_, _, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))
      },
      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs)),
      ETuple(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))
          ei = ei + 1
        }
      },
      EArray(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))
          ei = ei + 1
        }
      },
      ERecord(_, fields, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fval) = Array::get(fields, fi)
          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs))
          fi = fi + 1
        }
      },
      EMap(fields) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fval) = Array::get(fields, fi)
          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs))
          fi = fi + 1
        }
      },
      ELabeledArg(_, _, value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs)),
      ESpread(value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs)),
      EBreak(Some(value)) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs)),
      EBreak(None) => (),
      EContinue(args) => {
        let mut ai = 0
        while ai < Array::length(args) {
          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs))
          ai = ai + 1
        }
      },
      // Scoped forms are handled above; any future non-scoped structural
      // expression inherits this frame unchanged.
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) {
          Array::push(stack, (Array::get(children, i), declared, in_handle, ov_names, ov_effs))
          i = i + 1
        }
      }
    }
  }
  errors
}

fn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),
    _ => effect_row_labels(effect_row_parse(None))
  }
}

fn no_str_labels() -> Array[String] {
  array_empty()
}

fn no_ov_effs() -> Array[Array[String]] {
  array_empty()
}

/// Public 3-arg entry: the direct-only check (no call-graph map), preserving the
/// pre-transitive behavior for unit tests and any non-stmts caller.
export fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {
  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())
}

fn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {
  let sig_labels = sig_type_effect_labels(ty)
  match body {
    // #885: build the callback-parameter overlay for THIS binding's own
    // function value from its (possibly untyped, see merge_param_types_with_sig)
    // parameters, so a direct call to one of them inside the body is checked
    // from the very first stack frame — not just once the walk happens to
    // redescend through a nested `EFn` node.
    EFn(_, _, params, _, eff, fbody) => {
      let (ov_names, ov_effs) = build_param_overlay(merge_param_types_with_sig(ty, params))
      check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(sig_labels, effect_row_labels(effect_row_parse(eff))), false, fn_names, fn_effs, ov_names, ov_effs)
    },
    _ => check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
  }
}

/// #761: a `test {}` / `bench {}` block is a program entry point — it runs under
/// the runtime host, which is the ambient handler for the HOST resource effects
/// (Fs/Env/Stdin/Stdout/Process/Profiler). So a test may invoke a host-effectful
/// function (directly, transitively, or as an unqualified builtin) without a
/// `handle`, exactly as `main` does. This grant was already de-facto true for
/// IMPORTED effectful functions (they are absent from the transitive fn_effs map,
/// so calling them never flagged), but LOCALLY-defined ones (in fn_effs) and
/// direct builtin/perform host effects were wrongly rejected — an asymmetry.
/// Seeding the test/bench declared row with the host set removes it. NON-host
/// (user-defined) effects still require a handler: performing one at runtime with
/// no host handler would trap, so leaving it flagged is correct. Purity/caching
/// is judged separately by file_tests_cacheable (empty declared row), so a test
/// that reaches a host effect still correctly counts as impure/non-cacheable.
/// #944 (ADR-0073 implementation bridge): checked-Error mode. The accepted
/// owner decision makes `Error::Throw` a fully checked semantic operation
/// (direct throw and `with { Error }` callees propagate to the caller's
/// row; discharge via `handle ... with Error`). Stage A landed this
/// opt-in (`VIBE_CHECK_ERROR_ROW=1`, default off, preserving the old
/// exemption byte-for-byte) while the tree still carried hundreds of
/// row-less throw sites (#640 measured ~970); stage B annotated those and
/// flipped the DEFAULT to checked, leaving `VIBE_CHECK_ERROR_ROW=0` as a
/// temporary opt-OUT escape hatch (wired in cli_adapter.vibe) for any
/// downstream code that hasn't annotated yet. The switch rides in a
/// module-level memo cell (fixtures/module_let_memo_test.vibe pattern)
/// because the effect discipline has no configuration threading and the
/// checker itself is pure (no Env row).
///
/// Scope note: builtin_call_effect's own Error carve-out (a BUILTIN whose
/// declared row is Error) is deliberately NOT flipped by this switch --
/// which builtins should carry a semantic Error row is a separate
/// sub-decision tracked on #944.
let error_row_mode_cell = array_empty()

export fn set_error_row_checked(on: Bool) -> Unit {
  Array::truncate(error_row_mode_cell, 0)
  Array::push(error_row_mode_cell, if on {
    1
  } else {
    0
  })
}

fn error_row_checked() -> Bool {
  Array::length(error_row_mode_cell) > 0 && Array::get(error_row_mode_cell, 0) == 1
}

fn test_bench_ambient_effects() -> Array[String] {
  [
    // #865: "Stderr" added alongside "Stdout" -- same ambient-host-handler
    // reasoning (a test/bench block runs under the runtime host, which
    // implements Stderr::write_stream/write_char just like Stdout's).
    //
    // #944 (checked-Error stage B): "Error" is ambient in test/bench
    // blocks by the same boundary reasoning -- `assert` itself is
    // implemented as a throw, and a failing test IS an escaping Error the
    // test runner catches and reports (the block is an entry-like
    // boundary, exactly ADR-0073's entry-boundary-A shape). Requiring
    // every test block to spell `with { Error }` would annotate the
    // mechanism the runner already owns.
    "Fs",
    "Env",
    "Stdin",
    "Stdout",
    "Stderr",
    "Process",
    "Profiler",
    "Error"
  ]
}

fn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {
  match stmt {
    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),
    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),
    STest(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),
    SBench(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),
    SExpr(e) => check_perform_effects_expr_tx(e, effect_row_labels(effect_row_parse(None)), false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
    _ => array_empty()
  }
}

/// Public 1-arg entry: direct-only (empty map). Kept for unit tests.
export fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {
  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs())
}

/// #812: seed the transitive call-graph map with the checker ENV's bindings.
/// fn_names/fn_effs was built from the CURRENT module's top-level statements
/// only, so a caller could invoke an IMPORTED `with { Fs }` function without
/// declaring Fs and reach the filesystem at runtime — while the identical
/// shape with a local callee was rejected. An imported binding's CtFn carries
/// its declared effect row in the env; add every effect-bearing env binding
/// AFTER the local rows (lookup_fn_effs is first-match, so a same-name local
/// row still shadows the env row). Effect-free bindings are skipped — an
/// absent row and an empty row enforce the same (nothing).
fn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {
  let fnty = match ty {
    CtForAll(_, _, body) => body,
    _ => ty
  }
  match fnty {
    CtFn(_, _, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      if Array::length(labels) > 0 {
        Array::push(fn_names, name)
        Array::push(fn_effs, labels)
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {
  let mut cur = env
  let mut looping = true
  while looping {
    match cur {
      EnvBind(name, ty, rest) => {
        push_env_fn_eff(name, ty, fn_names, fn_effs)
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      EnvFlat(entries) => {
        let mut ei = 0
        while ei < Array::length(entries) {
          let (ename, ety) = Array::get(entries, ei)
          push_env_fn_eff(ename, ety, fn_names, fn_effs)
          ei = ei + 1
        }
        looping = false
      },
      EnvEmpty => {
        looping = false
      }
    }
  }
}

fn build_perform_fn_effs(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
}

export fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  check_perform_effects_stmts_env(stmts, EnvEmpty)
}

export fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  // Build the call-graph effect map (parallel arrays) from every top-level
  // binding's declared row — locals first, then the env's (imported)
  // bindings (#812) — then run the per-stmt check WITH transitive
  // enforcement so a caller must declare (or handle) the effects of the
  // functions it invokes.
  let fn_names = array_empty()
  let fn_effs = array_empty()
  build_perform_fn_effs(stmts, fn_names, fn_effs)
  seed_env_fn_effs(env, fn_names, fn_effs)
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))
    i = i + 1
  }
  errors
}

/// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result
/// is safe to cache/skip only when running it depends on nothing external — no
/// I/O, no non-determinism — so it is a deterministic function of source + deps +
/// compiler version. file_tests_cacheable is true iff the file has at least one
/// `test {}` block and EVERY test block is transitively effect-free.
///
/// Reuses the transitive effect walk: a test body checked with an EMPTY declared
/// row reports an error for ANY effect it reaches that a `handle` does not
/// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the
/// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`
/// are excluded by that pass, so they stay cacheable; a `handle` that fully
/// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.
/// Zero errors => cacheable.
///
/// A direct `sh`/`sh_lines` call IS surfaced: builtin_call_effect special-cases
/// these two unqualified builtins to `Process` (they lower to real host imports),
/// so a test that shells out is correctly treated as impure/non-cacheable, the
/// same as `sh` reached through a user function declaring `with { Process }`.
/// Conservative otherwise: an effect the type system does not surface here stays
/// invisible, but it never marks a genuinely-impure test cacheable.
export fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
  let empty_decl = array_empty()
  let mut any_test = false
  let mut all_ok = true
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(_, body) => {
        any_test = true
        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
        if Array::length(errs) != 0 {
          all_ok = false
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  any_test && all_ok
}

/// #819 (Codex review, PR #1214): entry-function counterpart of
/// file_tests_cacheable above, for a program compiled with a normal ENTRY
/// function (e.g. `fn main`) instead of `test {}` blocks -- used by
/// scripts/vibe_md.vibex's ```vibe run block execute-cache. Unlike a test's
/// empty declared row, `Stdout` is declared-safe here: it is the block's
/// PRODUCED, CAPTURED value (the exact thing the cache stores and compares
/// against the doc's ```output block), not a hidden nondeterminism source.
/// `Error`/`Async` are exempt for the same reason file_tests_cacheable
/// leaves them out -- a throwing entry never reaches the caller's cache-write
/// path anyway (run_one_block only caches on a successful `_start`), and
/// Async is composition, not itself a host nondeterminism source. Any OTHER
/// reachable effect (Fs/Env/Http/Process/Socket/custom/...) means the
/// entry's stdout can vary between runs of byte-identical compiled wasm, so
/// it must NOT be treated as cacheable -- returns false if `entry_name` is
/// not found among the file's top-level bindings.
export fn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut entry_body = None
  let mut entry_declared = None
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      SLetMut(name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      _ => ()
    }
    m = m + 1
  }
  match entry_body {
    None => false,
    Some(body) => {
      let cache_safe_row = [
        "Stdout",
        "Error",
        "Exception",
        "Async"
      ]
      // Codex review, PR #1215: belt-and-suspenders on top of the
      // reachable-effects walk below. That walk shares check_perform_
      // effects_expr_tx's own limitation (also present, unchanged, in the
      // established `vibe test` cache via file_tests_cacheable above): a
      // LOCAL closure defined inside the body is checked under its OWN
      // declared row (so an inner `with { Env }` satisfies itself and never
      // surfaces as an error at this call site), and a row-POLYMORPHIC
      // callee's effect-VARIABLE labels are deliberately treated as "leaks
      // nothing" here (real call-site row-variable instantiation tracking
      // is #885, not implemented by this pass -- see the "Effect-variable
      // rows (polymorphic) impose nothing HERE" comment near
      // check_perform_effects_expr_tx_in's transitive-leak check above).
      // Neither gap is new to this PR. Closing it outright would need #885-
      // class compiler work, out of proportion for a doctest-cache
      // hardening -- instead, conservatively reject up front whenever the
      // entry's OWN declared row names anything outside the safe set. A
      // real top-level `main` is never itself row-polymorphic, so this is a
      // cheap, purely-additive net that catches the common/direct case
      // (`fn main with { Stdout, Env } { ... }`) even in scenarios the
      // deeper walk alone would miss.
      let declared_ok = match entry_declared {
        None => true,
        Some(row) => array_is_subset_of_str(row, cache_safe_row)
      }
      if !declared_ok {
        false
      } else {
        // `body` (from SLet/SLetMut) is the closure VALUE bound to
        // entry_name, e.g. `EFn(type_params, bounds, params, ret_ty,
        // effect, fn_body)` for `fn main with { ... } { ... }` -- checking
        // the EFn NODE itself would trivially find zero reachable effects
        // (defining a closure performs nothing; only CALLING it would),
        // silently marking every entry cacheable regardless of what it
        // does. The walk needs `fn_body`, the 6th field, not the literal.
        let exec_body = match body {
          EFn(_, _, _, _, _, fn_body) => fn_body,
          _ => body
        }
        let errs = check_perform_effects_expr_tx(exec_body, cache_safe_row, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
        Array::length(errs) == 0
      }
    }
  }
}

/// Every label in `row` must appear in `safe` -- unlike decl_authorizes_
/// effect above (used the OPPOSITE direction: "does this declared row
/// authorize performing effect X", where an effect-VARIABLE label
/// conservatively authorizes anything), this is used to conservatively
/// REJECT: an unrecognized label (including a row-variable letter, which a
/// real top-level `main` should never carry) is NOT treated as safe.
fn array_is_subset_of_str(row: Array[String], safe: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(row) {
    let eff = Array::get(row, i)
    let mut j = 0
    let mut found = false
    while j < Array::length(safe) {
      if Array::get(safe, j) == eff {
        found = true
      } else {
        ()
      }
      j = j + 1
    }
    if !found {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

//# Mutability discipline: reassignment requires a `let mut` binding.
//
// `let x = ...` is immutable (docs/cheatsheet.md); only `let mut x` may be
// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass
// walks expressions carrying the SET of names that are reassignable in scope
// and reports an `x = e` / `x op= e` whose target is not in that set.
//
// The set only ever GROWS down a scope (never shrinks), so the pass can only
// produce false NEGATIVES, never false positives: every form that introduces a
// reassignable or freshly-rebindable name — `let mut`, function parameters,
// loop accumulators, `for` variables, and pattern binds — is added, so the
// only thing flagged is reassignment of a plain immutable `let`. Nested
// functions INHERIT the outer set (a closure may mutate a captured `let mut`).

fn mut_has(xs: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn mut_with(base: Array[String], name: String) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  Array::push(out, name)
  out
}

fn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(acc, name),
    PCtor(_, subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    PTuple(subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    POr(l, r) => {
      collect_pat_binds_into(l, acc)
      collect_pat_binds_into(r, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binds_into(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  collect_pat_binds_into(pat, out)
  out
}

fn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    Array::push(out, pname)
    i = i + 1
  }
  out
}

export fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {
  let errors = array_empty()
  match expr {
    ECall(callee, args, _) => {
      append_eff_errs(errors, check_mutability_expr(callee, mutable))
      let mut ai = 0
      while ai < Array::length(args) {
        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, params, _, _, body) => {
      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))
      errors
    },
    EHandle(body, arms) => {
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    ELet(_, val, body, _) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetRec(_, val, body) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetMut(name, val, body, _) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))
      errors
    },
    ESeq(a, b) => {
      append_eff_errs(errors, check_mutability_expr(a, mutable))
      append_eff_errs(errors, check_mutability_expr(b, mutable))
      errors
    },
    EIf(cond, then_e, else_e) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(then_e, mutable))
      append_eff_errs(errors, check_mutability_expr(else_e, mutable))
      errors
    },
    EMatch(scrutinee, arms) => {
      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELoop(params, body) => {
      let loopmut = Array::slice(mutable, 0, Array::length(mutable))
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        append_eff_errs(errors, check_mutability_expr(init, mutable))
        Array::push(loopmut, pname)
        i = i + 1
      }
      append_eff_errs(errors, check_mutability_expr(body, loopmut))
      errors
    },
    EForIn(name, index_name, iter, body) => {
      append_eff_errs(errors, check_mutability_expr(iter, mutable))
      let base = mut_with(mutable, name)
      let formut = match index_name {
        Some(idx) => mut_with(base, idx),
        None => base
      }
      append_eff_errs(errors, check_mutability_expr(body, formut))
      errors
    },
    EBinOp(_, left, right) => {
      append_eff_errs(errors, check_mutability_expr(left, mutable))
      append_eff_errs(errors, check_mutability_expr(right, mutable))
      errors
    },
    EReturn(e) => check_mutability_expr(e, mutable),
    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),
    EAssign(name, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EAssignOp(name, _, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    ERecord(_, fields, _) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        append_eff_errs(errors, check_mutability_expr(fval, mutable))
        fi = fi + 1
      }
      errors
    },
    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal
    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map
    // literal, labeled argument, spread, break value, or continue argument went
    // unflagged. Recurse with the SAME mutable set (these forms introduce no new
    // bindings), keeping the pass sound: still no false positives, just fewer
    // false negatives.
    EMap(entries) => {
      let mut mi = 0
      while mi < Array::length(entries) {
        let (_, mval) = Array::get(entries, mi)
        append_eff_errs(errors, check_mutability_expr(mval, mutable))
        mi = mi + 1
      }
      errors
    },
    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),
    ESpread(inner) => check_mutability_expr(inner, mutable),
    EBreak(opt) => match opt {
      Some(e) => check_mutability_expr(e, mutable),
      None => errors
    },
    EContinue(cargs) => {
      let mut ci = 0
      while ci < Array::length(cargs) {
        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))
        ci = ci + 1
      }
      errors
    },
    // New structural forms keep the same binding context; scoped forms above
    // intentionally remain explicit so their boundary semantics are visible.
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        append_eff_errs(errors, check_mutability_expr(Array::get(children, i), mutable))
        i = i + 1
      }
      errors
    }
  }
}

/// #770: `outer` carries the top-level `let mut` names already in scope from
/// earlier sibling statements (see check_mutability_stmts below) so a later
/// top-level statement's assignment to an earlier top-level `mut` binding
/// (directly, or via a closure capturing it) is recognized as mutable instead
/// of being misreported as `cannot assign to immutable binding`.
fn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {
  match body {
    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),
    _ => check_mutability_expr(body, outer)
  }
}

/// #770: top-level program statements are a flat `Array[Stmt]` sequence (not
/// nested `ELetMut` continuations like a function/test body), so a top-level
/// `let mut x = ...` must thread `x` forward into the mutability check of
/// every later sibling statement by accumulating `mutable` across the loop —
/// mirroring how `check_stmts` threads `env` across the same array. Before
/// this fix each statement was checked in isolation starting from an empty
/// mutable set, so any top-level `let mut` followed by an assignment in a
/// later top-level statement (e.g. a top-level `while` loop mutating a
/// counter) was rejected with a bogus `cannot assign to immutable binding`
/// error even though the program is valid.
export fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut mutable = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),
      SLetMut(name, _, body) => {
        append_eff_errs(errors, check_mutability_binding(body, mutable))
        mutable = mut_with(mutable, name)
      },
      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),
      _ => ()
    }
    i = i + 1
  }
  errors
}
