// #897 (ADR-0070 Phase 3): this file was moved from
// lib/@vibe/compiler/checker_effects.vibe into checker/ itself specifically
// so this import stays a plain SAME-PACKAGE sibling reference. Before the
// move it was a `#847 Phase C exception` — a deliberate direct leaf import
// of the internal `checker/builtins.vibe` file, bypassing the (then-plain)
// facade, because `checker/checker_stmt.vibe` imports this file and the
// facade re-exports `checker_stmt.vibe`'s surface: routing through the
// facade would have closed a real cycle (checker package -> checker_stmt.vibe
// -> checker_effects.vibe -> checker package). Once checker/ became a real
// `index.vpkg` package boundary (#729's enforce_incoming_boundary_fs), an
// outside file could no longer reach `checker/builtins.vibe` directly at
// all (only through the package), so the old workaround stopped compiling.
// Moving this file INTO checker/ resolves both problems at once: this
// import is now an ordinary directory-shared-scope sibling reference (no
// facade indirection, so no cycle), and every OTHER consumer of this file's
// own exports (check_effects_stmt, check_perform_effects_stmts_env, etc.)
// now reaches them through the checker package's index.vpkg like any other
// checker export.
import ./builtins.vibe {
  lookup_builtin
}

//# Types

export enum EffectError {
  EEEffectfulCallOutsideEffect(String);
  EEPerformUndeclaredEffect(String, String);
  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a
  // set difference plus a fix-it hint for the `with` row annotation.
  // Fields (all pre-rendered ", "-joined label lists, deterministic order):
  // (enclosing fn name or "" when unnamed, missing labels (sorted),
  //  declared row (source order, "" when no row), required row (sorted union)).
  // #1514: the 5th field is the CALL SITE's source offset (-1 when unknown),
  // carried to the renderer as the ` [@off=N]` marker locate_type_error decodes.
  // Before this the row mismatch had no position at all -- measured as the worst
  // tier in eval/lang-review/repair (05).
  EEEffectRowMismatch(String, String, String, String, Int);
  // #2985 review (Codex P0): a KINDED handler arm (`Exception[K]::Throw`)
  // is a catch-all at run time -- the abortive channel carries no kind -- so
  // a throw of another kind, or of an unresolved kind, that the checker
  // believed would propagate past the handle is caught by it and its payload
  // is read at the wrong type. Fields: enclosing function, the handler's
  // kinded labels, the offending required labels, offset.
  EEKindedHandleCatchesAll(String, String, String, Int);
  // #2985 review (Codex P0): a handle with more than one exception arm.
  // Fields: enclosing function, the exception labels of its arms.
  EEMultipleExceptionArms(String, String);
  // #1683: a source effect with no host/runtime owner reached a program entry.
  // Fields: entry name, sorted offending row, sorted bare handler names, offset.
  EEUndischargedEntryEffect(String, String, String, Int);
  // An entry row variable has no caller that can instantiate it. Keep this
  // separate from concrete effects so the fix-it never suggests handling a
  // type-level row variable as though it were an effect declaration.
  EEUnresolvedEntryEffectRow(String, String, Int);
  EEProviderOperationCollision(String);
  // ADR-0088: the entry granted `Op?` (optional) and the body called `Op` as
  // required. Fields: function name, operation, the declared label whose
  // optional grade covers it (`Op?`, or the provider-wide `Provider?`), offset.
  EEOptionalGrantForRequiredCall(String, String, String, Int);
  // ADR-0088: an entry row names `Provider::op` for a standard host provider
  // that owns no such operation. Fields: entry name, label.
  EEUnknownProviderOperation(String, String);
  // ADR-0088: `?` on a row label that is not a host capability. Fields:
  // function name, label as written.
  EEOptionalGradeNotCapability(String, String);
  EEAssignImmutable(String);
  // #1539: provider-owned stdin lifecycle operations cannot be transported as
  // values until generic higher-order effect flow is sound (#1536).
  EEStdinProviderValueReference(String);
  // #1347: a `handle ... with E` whose arms are provably dead because the
  // body cannot reach a perform of E and only invokes an opaque value —
  // the handler-switch footgun. Field: the effect name.
  EEHandleNeverFires(String);
  // ADR-0102 / #1678: defense in depth for AST producers that bypass the
  // source parser. EHandle does not retain its source effect name, so this
  // diagnostic deliberately names the structural problem instead.
  EEEmptyHandle;
  // ADR-0088: a `perform?` with no optional grant of its operation in scope.
  // Fields: the function or block whose row would carry the grade, the
  // operation, offset.
  EEPerformQuestionRequiresOptional(String, String, Int);
  // ADR-0088: a `perform?` whose `NotGranted` arm cannot run. Fields: the
  // function or block, the operation, the REQUIRED label that absorbs the
  // optional grade ("" when the reason is the block's full authority), offset.
  EEPerformQuestionAlwaysGranted(String, String, String, Int);
  EEPerformQuestionSourceShadow(String, Int);
  EEPerformQuestionInvalidOperand(Int)
}

//# Functions

// #944 follow-up: the general `check_effects_expr`/`check_effects_stmt`/
// `check_effects_stmts` walk (the pre-#933 `in_effect: Bool` discipline that
// produced EEThrowOutsideEffect / EEEffectfulCallOutsideEffect for ANY
// effectful call outside an effectful context) was retired here. It had no
// live-pipeline caller -- `check_program` wires check_perform_effects_* (the
// row-based discipline below, which since #944 also checks the Error row by
// default) plus the Async-scoped check_async_effects_* pass further down --
// and was only reachable from two unit-test harnesses, which now exercise the
// live entry points instead. EEThrowOutsideEffect went with it (its only
// constructor was that walk's EThrow arm, dead since #640 Stage 2 desugared
// `throw` to `perform Exception::Throw`); EEEffectfulCallOutsideEffect stays --
// check_async_effects_expr still reports it for async primitives.

/// A hint rewrites a bare `Stdin` / `Stdout` / `Stderr` label to `Console`.
/// `println` and `print` already require `Console`. The legacy operations
/// still carry their own labels; pasting those labels would tell the reader
/// to write the name the book retired.
fn spell_legacy_tty(item: String) -> String {
  if String::index_of(item, "::") < 0 && is_legacy_console_provider(item) {
    "Console"
  } else {
    item
  }
}

/// #1429: render a stored row as the SOURCE spelling the reader must type.
/// Rows are stored comma-joined; the syntax is `+`-separated. Every `hint:`
/// below hands the reader something to paste into their code, so it has to go
/// through here -- a hint that suggests `with { Error, Fs }` is telling them
/// to write syntax the compiler is migrating away from (and, once the braced
/// form is removed, syntax it rejects outright).
///
/// Legacy tty labels are spelled `Console`, and a second `Console` is
/// dropped. The set-valued parts of the message (`missing { .. }`,
/// `requires { .. }`) use `row_set_for_reader` for the same spelling.
fn row_as_source(row: String) -> String {
  let parts = row_items_top_level(row)
  let n = Array::length(parts)
  let mut acc = ""
  let mut k = 0
  let mut i = 0
  let mut any = false
  let mut seen_console = false
  while i < n {
    let item = Array::get(parts, i)
    let shown = if row_item_kind_is_unspellable(item) {
      k = k + 1
      String::concat("Exception[", String::concat(unspellable_kind_alias(k), "]"))
    } else {
      spell_legacy_tty(item)
    }
    let skip = shown == "Console" && seen_console
    if shown == "Console" {
      seen_console = true
    } else {
      ()
    }
    if !skip {
      acc = if !any {
        shown
      } else {
        String::concat(acc, String::concat(" + ", shown))
      }
      any = true
    } else {
      ()
    }
    i = i + 1
  }
  acc
}

/// Same spelling as `row_as_source`, joined the way a set difference is
/// printed (`A, B`). What the reader declared is not passed through here.
fn row_set_for_reader(row: String) -> String {
  let parts = row_items_top_level(row)
  let n = Array::length(parts)
  let mut acc = ""
  let mut i = 0
  let mut any = false
  let mut seen_console = false
  while i < n {
    let shown = spell_legacy_tty(Array::get(parts, i))
    let skip = shown == "Console" && seen_console
    if shown == "Console" {
      seen_console = true
    } else {
      ()
    }
    if !skip {
      acc = if !any {
        shown
      } else {
        String::concat(acc, String::concat(", ", shown))
      }
      any = true
    } else {
      ()
    }
    i = i + 1
  }
  acc
}

/// A stored row's items, split at the commas that separate items. A kind
/// such as `(Int, Int) -> Int` holds a comma of its own, inside brackets.
export fn row_items_top_level(row: String) -> Array[String] {
  let out = array_empty()
  let n = String::length(row)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::char_code_at(row, i)
    if c == 40 || c == 91 {
      depth = depth + 1
    } else if c == 41 || c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      let item = String::trim(String::substring(row, start, i))
      if String::length(item) > 0 {
        Array::push(out, item)
      } else {
        ()
      }
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  let last = String::trim(String::substring(row, start, n))
  if String::length(last) > 0 {
    Array::push(out, last)
  } else {
    ()
  }
  out
}

/// #3033 follow-up: a row item's type arguments are type NAMES
/// (`collect_row_item_targs`), so a kind the checker spells from a function
/// type, `Exception[(Int) -> Int]`, cannot be pasted into a row. A hint names
/// such a kind through an alias it asks the reader to declare.
fn row_item_kind_is_unspellable(item: String) -> Bool {
  String::starts_with(item, "Exception[") && (String::contains(item, "(") || String::contains(item, "->"))
}

fn unspellable_kind_alias(k: Int) -> String {
  if k == 1 {
    "Kind"
  } else {
    String::concat("Kind", __to_string(k))
  }
}

/// The alias declarations `row_as_source` relies on, in its numbering --
/// or "" when every kind in the row is already a type name. The names are
/// placeholders the reader may have to change, and the hint says so.
fn row_unspellable_kind_decls(row: String) -> String {
  let parts = row_items_top_level(row)
  let decls = array_empty()
  let mut k = 0
  let mut i = 0
  while i < Array::length(parts) {
    let item = Array::get(parts, i)
    if row_item_kind_is_unspellable(item) {
      k = k + 1
      let inner = String::substring(item, 10, String::length(item) - 1)
      Array::push(decls, String::concat("`type ", String::concat(unspellable_kind_alias(k), String::concat(" = ", String::concat(inner, "`")))))
    } else {
      ()
    }
    i = i + 1
  }
  if Array::length(decls) == 0 {
    ""
  } else {
    // The alias is numbered, not looked up: this renderer has no type
    // environment, so the hint says the name is the reader's to choose.
    String::concat("a row names an exception kind by a type name, so declare ", String::concat(String::join(decls, " and "), " (any name this module does not already declare -- use it in the row too), then "))
  }
}

/// #2964: every missing label is the ERASED exception (`Exception` /
/// `Exception::Throw`).
fn missing_is_erased_exception_only(missing: String) -> Bool {
  let parts = String::split(missing, ",")
  let mut ok = Array::length(parts) > 0
  let mut i = 0
  while i < Array::length(parts) {
    let p = String::trim(Array::get(parts, i))
    // #1963: the exception policy's predicates, not the spelling -- the
    // legacy `Error` alias is the same erased exception.
    if !is_exception_label(p) || String::length(exception_label_kind(p)) > 0 {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// #2964: the declared row names a kinded exception and no erased one.
fn declared_is_kinded_exception(declared: String) -> Bool {
  let parts = String::split(declared, ",")
  let mut kinded = false
  let mut erased = false
  let mut i = 0
  while i < Array::length(parts) {
    let p = String::trim(Array::get(parts, i))
    if !is_exception_label(p) {
      ()
    } else if String::length(exception_label_kind(p)) > 0 {
      kinded = true
    } else {
      erased = true
    }
    i = i + 1
  }
  kinded && !erased
}

export fn effect_error_to_string(err: EffectError) -> String {
  match err {
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name),
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with` row or wrap in a `handle`")))),
    // #639: expected-vs-actual effect rows as a set difference, then ONE
    // deterministic fix-it hint line targeting the enclosing declaration
    // (for a call-site leak that is the CALLER, not the callee).
    EEMultipleExceptionArms(fname, arms) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      String::concat("a handle may have only ONE exception arm, in ", String::concat(where_, String::concat(" it has { ", String::concat(arms, " }: the exception channel carries no kind and only the first exception arm is compiled, so the others can never run\nhint: keep one arm -- an erased `Exception::Throw(m)` arm catches every kind, and the payload can be matched inside it -- or nest one handle inside another"))))
    },
    EEKindedHandleCatchesAll(fname, handler, offending, off) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      let body = String::concat("handler arm `", String::concat(handler, String::concat("::Throw` catches EVERY exception its body raises at run time (the exception channel carries no kind), so the body may raise only `", String::concat(handler, String::concat("`; in ", String::concat(where_, String::concat(" it also raises { ", String::concat(offending, " }\nhint: add an arm for that kind, use the erased `Exception::Throw(m)` arm (which catches everything, with an untyped payload), give the throw a payload of the handled kind, or move that call outside this handle"))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEEffectRowMismatch(fname, missing0, declared0, required0, off) => {
      // #3051: a published row spells a formal `NAME$K`; show `NAME`.
      let missing = strip_published_formal_suffixes(missing0)
      let declared = strip_published_formal_suffixes(declared0)
      let required = strip_published_formal_suffixes(required0)
      let block = entry_block_display_name(fname)
      let head = if String::length(block) > 0 {
        String::concat("effect row mismatch for ", block)
      } else if String::length(fname) > 0 {
        String::concat("effect row mismatch for '", String::concat(fname, "'"))
      } else {
        "effect row mismatch"
      }
      let detail = if String::length(declared) > 0 {
        String::concat(" (declared { ", String::concat(declared, String::concat(" }, requires { ", String::concat(row_set_for_reader(required), " })"))))
      } else {
        String::concat(" (no 'with' clause, requires { ", String::concat(row_set_for_reader(required), " })"))
      }
      // ADR-0088: an entry point (`main` / `_start`, a `test` / `bench` /
      // `example` block) GRANTS its row, so the edit it is told is `allows`;
      // a called function requires, so its edit stays `with`.
      let entry_block = entry_block_display_name(fname)
      let hint = if row_has_ambiguous_label(required) {
        // Codex on #3055: a call whose instantiation is ambiguous (`?S`, two
        // merged sources' calls at one position) fails closed, and no row can
        // spell `?S`, so the hint names the cause instead of an edit.
        "\nhint: the type a generic callee's row takes at this call could not be determined -- another call at the same source position (sources merged without separate positions) instantiates it differently -- so no row authorizes it; check this file on its own with `vibe check` to see the concrete row"
      } else if missing_is_erased_exception_only(missing) && declared_is_kinded_exception(declared) {
        // #2964 / #3015: the requirement is an exception whose KIND this check
        // could not resolve, under a row that promises kinds. Adding the erased
        // label is one honest edit; the others keep the kinded promise.
        "\nhint: the kind of this exception is not known here, and a kinded row promises exactly its kinds -- give the thrown value a type (`let e: K = ..` then `throw(e)`), give the callback or callee a kinded `with Exception[K]` row, or declare the erased `with Exception`"
      } else if String::length(fname) == 0 {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), "' to the enclosing function"))
      } else if String::length(entry_block) > 0 {
        String::concat("\nhint: add 'allows ", String::concat(row_as_source(required), String::concat("' to ", entry_block)))
      } else if is_program_entry_name(fname) && String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat(" allows ", String::concat(row_as_source(required), "'"))))
      } else if is_program_entry_name(fname) {
        String::concat("\nhint: add 'allows ", String::concat(row_as_source(required), String::concat("' to '", String::concat(fname, "'"))))
      } else if String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat("(...) -> T with ", String::concat(row_as_source(required), "'"))))
      } else {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), String::concat("' to '", String::concat(fname, "'"))))
      }
      // A kind the row syntax cannot spell is pasted through an alias, whose
      // declaration leads the hint.
      let decls = row_unspellable_kind_decls(required)
      let hint = if String::length(decls) > 0 && String::starts_with(hint, "\nhint: ") {
        String::concat("\nhint: ", String::concat(decls, String::substring(hint, 7, String::length(hint))))
      } else {
        hint
      }
      let body = String::concat(head, String::concat(": missing { ", String::concat(row_set_for_reader(missing), String::concat(" }", String::concat(detail, hint)))))
      // #1514: marker LAST so the hint line stays the visible tail; the decoder
      // strips it before the user ever sees the string.
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUndischargedEntryEffect(entry_name, effects, handlers, off) => {
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" cannot discharge { ", String::concat(effects, String::concat(" }: no host provider or runtime handler owns this effect\nhint: ", String::concat(row_unspellable_kind_decls(handlers), String::concat("wrap the operation in `handle ... with ", String::concat(row_as_source(handlers), " { ... }` before it reaches the entry boundary"))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnresolvedEntryEffectRow(entry_name, variables, off) => {
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" has unresolved effect row { ", String::concat(variables, " }: entry rows must be concrete\nhint: close the entry row, or discharge each concrete effect with `handle` before it reaches the entry boundary"))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGrantForRequiredCall(fname, op, grant, off) => {
      // An entry GRANTS (`allows`), a called function REQUIRES (`with`).
      let is_entry = is_entry_point_name(fname)
      let keyword = if is_entry {
        "allows"
      } else {
        "with"
      }
      let verb = if is_entry {
        "granted"
      } else {
        "declared"
      }
      // The grant is quoted as written -- `Fs::read_file?`, or the
      // provider-wide `Fs?` -- so the "drop the `?`" edit names that label.
      let head = String::concat("`", String::concat(op, String::concat("` is ", String::concat(verb, String::concat(" as optional (`", String::concat(keyword, String::concat(" ", String::concat(grant, String::concat("`) but ", String::concat(row_owner_display_name(fname), " calls it as required"))))))))))
      let hint = String::concat("\nhint: call it with `perform? ", String::concat(op, String::concat("(..)` and match the `Attempt`, or drop the `?` (`", String::concat(keyword, String::concat(" ", String::concat(strip_authority_grade(grant), "`)"))))))
      let body = String::concat(head, hint)
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGradeNotCapability(fname, label) => {
      let core = strip_authority_grade(label)
      String::concat("`", String::concat(label, String::concat("` in the row of ", String::concat(row_owner_display_name(fname), String::concat(": `?` marks a host capability optional, and `", String::concat(core, String::concat("` is not one (it has no host provider)\nhint: drop the `?` -- `", String::concat(core, "` is required, handled or runtime-managed, never optional"))))))))
    },
    EEUnknownProviderOperation(entry_name, label) => {
      let provider = effect_name_of_op(label)
      let head = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" grants `", String::concat(label, String::concat("`, but the `", String::concat(provider, "` provider has no such operation"))))))
      String::concat(head, String::concat("\nhint: grant the provider (`allows ", String::concat(provider, "`) or one of its operations")))
    },
    EEProviderOperationCollision(operation) => String::concat("user effect operation `", String::concat(operation, "` collides with a registry-owned host provider operation; rename the user operation so it cannot impersonate provider authority")),
    EEAssignImmutable(name) => String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)")),
    EEStdinProviderValueReference(name) => String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function")),
    EEHandleNeverFires(eff) => {
      let tail = String::concat(eff, "::..` and calls an opaque function value. A continuation captured by another handler carries THAT handler with it, so wrapping its invocation in a new `handle` does not switch handlers (non-scoped resumption is unsupported -- ADR-0089 Part A, #1347). Drive the continuation without the wrapping handle, or handle the effect where it is performed")
      String::concat("handle of effect '", String::concat(eff, String::concat("' can never fire: this body reaches no `perform ", tail)))
    },
    EEEmptyHandle => "handler must contain at least one arm; an empty handler cannot discharge an effect",
    EEPerformQuestionRequiresOptional(fname, operation, off) => {
      // The edit names the keyword the row's owner takes: an entry GRANTS
      // (`allows`), a called function REQUIRES (`with`) -- telling a called
      // function to write `allows` would only lead to the parse error that
      // refuses it there (Codex review on PR #2653).
      let keyword = if is_entry_point_name(fname) {
        "allows"
      } else {
        "with"
      }
      let body = String::concat("`perform? ", String::concat(operation, String::concat("` requires the optional grade: write `", String::concat(keyword, String::concat(" ", String::concat(operation, String::concat("?` on ", String::concat(row_owner_display_name(fname), String::concat(", or call `", String::concat(operation, "(..)` plainly"))))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionAlwaysGranted(fname, operation, grant, off) => {
      let block = entry_block_display_name(fname)
      let body = if String::length(grant) == 0 {
        // A test artifact resolves every optional grant to `Granted`
        // (optional_perform_artifact_resolution): the block runs with full
        // authority, so a `perform?` written in it advertises an arm that
        // can never run.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` in ", String::concat(block, ": a `test` / `bench` / `example` block runs with full authority, so the operation is always granted and `NotGranted` can never happen here"))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or move the `perform?` into a function that requires `with ", String::concat(operation, "?` and call that from the block")))))
      } else {
        // Required is the join of the grade lattice: a required grant of the
        // operation or of its provider absorbs the optional one.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` can never be `NotGranted` here: ", String::concat(row_owner_display_name(fname), String::concat(" grants `", String::concat(grant, String::concat("` as required, and Required absorbs the optional grade of `", String::concat(operation, "`"))))))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or grant `", String::concat(operation, String::concat("?` without the required `", String::concat(grant, "`")))))))
      }
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionSourceShadow(operation, off) => {
      let body = String::concat("`perform? ", String::concat(operation, "(..)` resolves to a source function, not a capability operation; rename the source function or call the capability under an unshadowed name"))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionInvalidOperand(off) => {
      let body = "`perform?` takes a capability-operation call, like `perform? Fs::read_file(path)`. Either call an operation here, or drop `perform?` from this expression."
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    }
  }
}

//# Async-scoped effect enforcement (the pass wired into `check_program`)
//
// This pass enforces ONLY the `Async` effect, and only
// for async PRIMITIVES — builtins such as `await(..)` and `sleep(..)`
// whose type carries `with Async`, including the `await(..)` the async
// desugar injects over a Future-returning iterator. A primitive must appear
// inside a function/lambda annotated `with Async`.
//
// Crucially it does NOT propagate to user functions that merely COMPOSE async
// work: calling a `with Async` helper (e.g. `AsyncIter::collect`) from a
// sync context is allowed (await is the identity on the synchronous backend,
// and on a real async backend the value/Future mismatch is a separate type
// error). Only env-absent BUILTIN primitives are checked, so the compiler /
// prelude — which use `Async` only in the disciplined async_iter terminals —
// stay green while `for` over an async stream becomes sound (#2+#3).

fn effect_opt_is_async(eff: Option[String]) -> Bool {
  effect_row_contains_label(eff, "Async")
}

fn is_stdin_provider_surface(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// #1539: the four public provider operations are syntactic direct-call
/// primitives, not first-class function values. A direct `ECall` skips its
/// exact builtin callee but still checks every argument; every other expression
/// position is traversed structurally. This rejects aliases, chains,
/// conditionals, returned/container values, and unknown HOF transport without
/// attempting the generic effect-flow propagation deliberately deferred by
/// #1536. An explicitly effectful user wrapper remains an ordinary function.
fn check_stdin_provider_direct_calls_expr(expr: Expr) -> Array[EffectError] {
  let out = array_empty()
  check_stdin_provider_direct_calls_expr_into(expr, out)
  out
}

fn check_stdin_provider_direct_calls_expr_into(expr: Expr, out: Array[EffectError]) -> Unit {
  match expr {
    ECall(EIdent(name, _), args, _) => {
      if is_stdin_provider_surface(name) {
        let mut ai = 0
        while ai < Array::length(args) {
          check_stdin_provider_direct_calls_expr_into(Array::get(args, ai), out)
          ai = ai + 1
        }
      } else {
        let mark = expr_children_push(expr)
        let end = expr_children_top()
        let mut i = mark
        while i < end {
          check_stdin_provider_direct_calls_expr_into(expr_child_at(i), out)
          i = i + 1
        }
        expr_children_pop(mark)
      }
    },
    EIdent(name, _) => if is_stdin_provider_surface(name) {
      Array::push(out, EEStdinProviderValueReference(name))
    } else {
      ()
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_stdin_provider_direct_calls_expr_into(expr_child_at(i), out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

fn check_stdin_provider_direct_calls_stmt(stmt: Stmt) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, _, body) => check_stdin_provider_direct_calls_expr(body),
    SLetMut(_, _, body) => check_stdin_provider_direct_calls_expr(body),
    STest(_, body) => check_stdin_provider_direct_calls_expr(body),
    SBench(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExample(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExpr(body) => check_stdin_provider_direct_calls_expr(body),
    SLetPat(_, body) => check_stdin_provider_direct_calls_expr(body),
    SModule(_, _, inner) => check_stdin_provider_direct_calls_stmts(inner),
    _ => array_empty()
  }
}

export fn check_stdin_provider_direct_calls_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_stdin_provider_direct_calls_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  errors
}

/// True only for async-effect BUILTIN primitives (await/sleep/...).
/// A name bound in `env` (a user/prelude function) is intentionally NOT treated
/// as a primitive even if its type is `with Async`, except the four exact
/// compiler-owned stdin provider names imported from their public contract.
/// #2386: `is_async_primitive`'s answers for the walk in progress. The walk
/// hands every call site the same env (nothing in it extends `env`; locals go
/// through `afe_bind_*`), and the answer for a name is a full env miss for
/// every user callee -- a chain walk per call site. Each exported entry
/// clears it, so an entry with another env never reads a previous walk's
/// answer. Values: 1 = async primitive, 0 = not.
let afe_async_primitive_memo: Array[MutMap[String, Int]] = [
  MutMap::new_string()
]

fn afe_reset_entry_memos() -> Unit {
  Array::set(afe_async_primitive_memo, 0, MutMap::new_string())
  Array::set(afe_builtin_async_iter_cell, 0, -1)
}

fn is_async_primitive(name: String, env: TypeEnv) -> Bool {
  let memo = Array::get(afe_async_primitive_memo, 0)
  match MutMap::get(memo, name) {
    Some(v) => v == 1,
    None => {
      let answer = is_async_primitive_uncached(name, env)
      MutMap::set(memo, name, if answer {
        1
      } else {
        0
      })
      answer
    }
  }
}

fn is_async_primitive_uncached(name: String, env: TypeEnv) -> Bool {
  if is_stdin_provider_surface(name) {
    // Imported package contracts bind these exact public names in env, but
    // they remain compiler-owned primitives after canonical import rewriting.
    // Do not let that binding suppress their Async authority requirement.
    match lookup_builtin(canonical_builtin_name(name)) {
      Some(ty) => match ty {
        CtFn(_, _, eff) => effect_opt_is_async(eff),
        _ => false
      },
      None => false
    }
  } else {
    match env_lookup(env, name) {
      Some(_) => false,
      None => {
        let normalized = canonical_builtin_name(name)
        match lookup_builtin(normalized) {
          Some(ty) => match ty {
            CtFn(_, _, eff) => effect_opt_is_async(eff),
            _ => false
          },
          None => false
        }
      }
    }
  }
}

/// True when a handle arm targets an Async operation.
fn handle_arms_handle_async(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if String::starts_with(name, "Async::") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

//# #1358: `for` over an ASYNC iterator also needs `Async`
//
// `for x in it`, where `it`'s iterator `next` yields a `Future`, is lowered to
// an AWAIT loop by the dict-passing desugar (build_await_iter_for), which runs
// AFTER the checker -- so at check time the program text holds no async
// primitive and the pass above finds nothing to require. The loop could
// therefore suspend from a context that neither declares nor handles `Async`.
// This hole is not #1350's doing: the retired `for await` marker was unwrapped
// by the checker without requiring anything either. #1350 only widened the
// exposure, since now every plain `for` over a Future-returning iterator takes
// the await lowering.
//
// Recognising the loop needs the ITERAND's type, so this mirrors the desugar's
// own resolution (infer_arg_type_name over var_types/fn_returns). Those tables
// are built in codegen, so here the head type name comes from the type
// environment plus a small locals table threaded down the walk. Both sides are
// best-effort by construction -- an unresolvable iterand requires nothing,
// exactly as the desugar leaves an unclassifiable loop as a sync EForIn -- so
// this can MISS a requirement, but never invent one.

fn afe_no_locals() -> Array[(String, String)] {
  array_empty()
}

// Selected package imports are the source-level provenance that survives even
// when the projected TypeEnv intentionally hides AsyncIterator. Reset for each
// checked program because unit-test daemons reuse this compiler instance.
let afe_builtin_async_iter_import_names: Array[String] = array_empty()

fn afe_is_async_iter_publication_name(name: String) -> Bool {
  name == "AsyncIter" || name == "Array::iter" || name == "AsyncIter::empty" || name == "AsyncIter::once" || name == "AsyncIter::map" || name == "AsyncIter::filter" || name == "AsyncIter::take" || name == "AsyncIter::take_while" || name == "async_iter_arr" || name == "async_iter_empty" || name == "async_iter_once" || name == "async_iter_map" || name == "async_iter_filter" || name == "async_iter_take" || name == "async_iter_take_while"
}

let afe_builtin_async_iter_head = "#builtin:AsyncIter"

fn afe_record_builtin_async_iter_imports(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => if path == "@vibe/builtin" {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          if afe_is_async_iter_publication_name(item.name) {
            Array::push(afe_builtin_async_iter_import_names, item.name)
            match item.alias {
              Some(alias) => Array::push(afe_builtin_async_iter_import_names, alias),
              None => ()
            }
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      SModule(_, _, body) => afe_record_builtin_async_iter_imports(body),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_has_recorded_builtin_async_iter_import(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_builtin_async_iter_import_names) && !found {
    if Array::get(afe_builtin_async_iter_import_names, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Head name of an inferred checker type (`AsyncIter[Int]` -> "AsyncIter").
///
/// #1347/#1358 (Codex P1 on PR #1364): `CtEnum` counts too. An ENUM can
/// implement an async iterator trait, and an iterand reached through its
/// constructor (`Chan(3)`), a factory call, or an inferred local carries
/// `CtEnum` -- dropping it here lost the head name while the desugar still
/// resolved it from the constructor's return metadata and lowered the loop
/// through `Chan::next` with an injected `await`. Verified against a repro
/// that RAN the await loop.
fn afe_type_head_name(t: Type) -> Option[String] {
  match t {
    CtNamed(n, args) => if n == "#hkt" {
      if Array::length(args) >= 1 {
        match Array::get(args, 0) {
          CtVar(_) => None,
          other => afe_type_head_name(other)
        }
      } else {
        None
      }
    } else {
      Some(n)
    },
    CtStruct(n) => Some(n),
    CtEnum(n) => Some(n),
    CtConstructor(n, _) => Some(n),
    CtApplied(head, _) => afe_type_head_name(head),
    _ => None
  }
}

/// Head name of a source annotation (`s: AsyncIter[Int]` -> "AsyncIter").
fn afe_texpr_head_name(t: TypeExpr) -> Option[String] {
  match t {
    TyName(n) => Some(n),
    TyApp(n, _) => Some(n),
    _ => None
  }
}

fn afe_lookup_local(locals: Array[(String, String)], name: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(locals) {
    let entry = Array::get(locals, i)
    match found {
      None => if entry.0 == name {
        found = Some(entry.1)
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// Bind `name` to a head type for the scope below, REMOVING any outer entry of
/// the same name first. Dropping the shadow would let an outer async-iterator
/// binding be resolved through an inner, unrelated one of the same name — a
/// false positive (a rejected valid program), which this pass must never
/// produce. `None` therefore still shadows; it just adds nothing.
fn afe_bind_local(locals: Array[(String, String)], name: String, head: Option[String]) -> Array[(String, String)] {
  let out = array_empty()
  match head {
    Some(h) => Array::push(out, (name, h)),
    None => ()
  }
  let mut i = 0
  while i < Array::length(locals) {
    let entry = Array::get(locals, i)
    if entry.0 != name {
      Array::push(out, entry)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn afe_bind_params(locals: Array[(String, String)], params: Array[(String, Option[TypeExpr])], env: TypeEnv) -> Array[(String, String)] {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let head = match ptype {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(h, afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    }
    cur = afe_bind_local(cur, pname, head)
    i = i + 1
  }
  cur
}

/// Best-effort head type name of an expression used as a `for` iterand (or as a
/// `let` value feeding one).
/// #1341 (Codex P1 on #1369): struct FIELD type heads, `Holder.s ->
/// HostStream`. The async pass walks per-statement, so a whole-program table
/// cannot ride the walk's parameters; it lives in a module cell rebuilt at each
/// public entry, exactly like error_row_mode_cell / throw_kind_cell in this
/// file. Entries are keyed with a `.` that no vibe binding name can contain.
///
/// Needed because the desugar now routes `for b in h.s` over a host stream to
/// the parking read loop (build_host_stream_for). If this pass could not
/// classify the same projection, that loop would be legal in a row without
/// { Async } -- the precise hole #1358 exists to close, reopened one
/// expression shape over.
let afe_field_types_cell: Array[(String, String)] = array_empty()

fn afe_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

fn afe_field_head_with_origin(head: String, env: TypeEnv) -> String {
  if head == "AsyncIter" {
    let from_binding = afe_type_binding_is_builtin_async_iter(env)
    let from_definition = match env_type_definition_origin(env, head) {
      Some(origin) => afe_origin_is_builtin_async_iter(origin),
      None => false
    }
    afe_tag_async_iter_head(head, from_binding || from_definition)
  } else {
    head
  }
}

fn afe_record_field_type(struct_name: String, field: String, head: String, env: TypeEnv) -> Unit {
  if String::length(head) > 0 {
    Array::push(afe_field_types_cell, (afe_field_type_key(struct_name, field), afe_field_head_with_origin(head, env)))
  } else {
    ()
  }
}

fn afe_collect_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          afe_record_field_type(sname, fname, texpr_head_name_afe(fty), env)
          j = j + 1
        }
      },
      SModule(_, _, inner) => afe_collect_field_types(inner, env),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_collect_env_field_types(env: TypeEnv) -> Unit {
  let defs = env_type_defs(env)
  let mut i = 0
  while i < Array::length(defs) {
    match Array::get(defs, i) {
      TDStruct(sname, fields, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          match afe_type_head_name(fty) {
            Some(head) => afe_record_field_type(sname, fname, head, env),
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn texpr_head_name_afe(t: TypeExpr) -> String {
  match t {
    TyName(n) => n,
    TyApp(n, _) => n,
    _ => ""
  }
}

fn afe_set_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  Array::truncate(afe_field_types_cell, 0)
  afe_collect_field_types(stmts, env)
  afe_collect_env_field_types(env)
}

fn afe_lookup_field_type(struct_name: String, field: String) -> Option[String] {
  let key = afe_field_type_key(struct_name, field)
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_field_types_cell) {
    let (k, v) = Array::get(afe_field_types_cell, i)
    if k == key {
      out = Some(v)
      i = Array::length(afe_field_types_cell)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_applied_constructor_var(t: Type) -> Option[Int] {
  match t {
    CtApplied(CtVar(id), _) => Some(id),
    CtNamed(n, args) => if n == "#hkt" && Array::length(args) >= 1 {
      match Array::get(args, 0) {
        CtVar(id) => Some(id),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn afe_lookup_alias(env: TypeEnv, name: String) -> Option[(Array[String], Type)] {
  match find_typedef(env_type_defs(env), name) {
    Some(TDAlias(_, params, body)) => Some((params, body)),
    _ => None
  }
}

fn afe_expand_constructor_alias(t: Type, env: TypeEnv, fuel: Int) -> Type {
  if fuel <= 0 {
    t
  } else {
    match t {
      CtForAll(ids, bounds, body) => CtForAll(ids, bounds, afe_expand_constructor_alias(body, env, fuel)),
      CtNamed(name, args) => match afe_lookup_alias(env, name) {
        Some((params, body)) => if Array::length(params) == Array::length(args) {
          afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
        } else if Array::length(params) == 0 {
          afe_expand_constructor_alias(body, env, fuel - 1)
        } else {
          t
        },
        None => t
      },
      CtApplied(head, args) => {
        let expanded_head = afe_expand_constructor_alias(head, env, fuel - 1)
        match expanded_head {
          CtNamed(name, _) => match afe_lookup_alias(env, name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          CtConstructor(name, _) => match afe_lookup_alias(env, name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          _ => CtApplied(expanded_head, args)
        }
      },
      _ => t
    }
  }
}

/// #2386: the `AsyncIter` provenance answer for the walk in progress
/// (-1 = not asked yet, else 0 / 1); the env is constant across a walk and
/// this was asked once per binding and per call head. Cleared per entry with
/// the memo above.
let afe_builtin_async_iter_cell: Array[Int] = [-1]

fn afe_type_binding_is_builtin_async_iter(env: TypeEnv) -> Bool {
  let cached = Array::get(afe_builtin_async_iter_cell, 0)
  if cached >= 0 {
    cached == 1
  } else {
    let answer = match env_lookup_binding(env, "AsyncIter") {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
    Array::set(afe_builtin_async_iter_cell, 0, if answer {
      1
    } else {
      0
    })
    answer
  }
}

fn afe_tag_async_iter_head(head: String, provenanced: Bool) -> String {
  if head == "AsyncIter" && provenanced {
    afe_builtin_async_iter_head
  } else if head == afe_builtin_async_iter_head {
    afe_builtin_async_iter_head
  } else {
    head
  }
}

fn afe_display_iter_head(head: String) -> String {
  if head == afe_builtin_async_iter_head {
    "AsyncIter"
  } else {
    head
  }
}

fn afe_tuple_shape_key(name: String) -> String {
  String::concat("__tupshape$", name)
}

fn afe_array_elem_key(name: String) -> String {
  String::concat("__arrelem$", name)
}

fn afe_local_fn_return_key(name: String) -> String {
  String::concat("__local_fn_return$", name)
}

fn afe_digit_index(field: String) -> Option[Int] {
  let n = String::length(field)
  if n == 0 {
    None
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while i < n {
      let c = String::char_code_at(field, i)
      if c >= 48 && c <= 57 {
        acc = acc * 10 + (c - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(acc)
    } else {
      None
    }
  }
}

fn afe_split_csv(sentinel: String) -> Array[String] {
  let out = array_empty()
  let mut rest = sentinel
  let mut go = true
  while go {
    let comma = String::index_of(rest, ",")
    if comma < 0 {
      Array::push(out, rest)
      go = false
    } else {
      Array::push(out, String::substring(rest, 0, comma))
      rest = String::substring(rest, comma + 1, String::length(rest))
    }
  }
  out
}

fn afe_join_csv(parts: Array[String]) -> String {
  let mut acc = ""
  let mut i = 0
  while i < Array::length(parts) {
    acc = if i == 0 {
      Array::get(parts, i)
    } else {
      String::concat(acc, String::concat(",", Array::get(parts, i)))
    }
    i = i + 1
  }
  acc
}

fn afe_prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// Recover the concrete head returned by a constructor-polymorphic call such
/// as `map[F[_]](xs: F[A], ...) -> F[B]`. The checker type keeps the same
/// constructor variable on the receiver and result, so follow that receiver
/// back to its source expression instead of treating the abstract `F[B]` as
/// an unknown head.
fn afe_call_result_head(callee_type: Type, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match callee_type {
    CtForAll(_, _, body) => afe_call_result_head(body, args, env, locals),
    CtFn(params, ret, _) => {
      let expanded = afe_expand_constructor_alias(ret, env, 8)
      match afe_type_head_name(expanded) {
        Some(head) => Some(head),
        None => match afe_applied_constructor_var(expanded) {
          Some(result_var) => {
            let mut i = 0
            let mut result = None
            while i < Array::length(params) && i < Array::length(args) {
              match afe_applied_constructor_var(Array::get(params, i)) {
                Some(param_var) => {
                  let same_constructor = param_var == result_var
                  if same_constructor {
                    match afe_expr_head_name(Array::get(args, i), env, locals) {
                      Some(head) => {
                        result = Some(head)
                        i = Array::length(params)
                      },
                      None => {
                        i = i + 1
                      }
                    }
                  } else {
                    i = i + 1
                  }
                },
                None => {
                  i = i + 1
                }
              }
            }
            result
          },
          None => None
        }
      }
    },
    _ => None
  }
}

fn afe_callee_is_builtin_async_iter(env: TypeEnv, name: String) -> Bool {
  if afe_has_recorded_builtin_async_iter_import(name) {
    true
  } else {
    match env_lookup_binding(env, name) {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
  }
}

fn afe_finish_call_head(head: String, env: TypeEnv, callee: String) -> String {
  if head == afe_builtin_async_iter_head {
    head
  } else {
    afe_tag_async_iter_head(head, afe_callee_is_builtin_async_iter(env, callee) || afe_type_binding_is_builtin_async_iter(env))
  }
}

fn afe_heads_agree(left: Option[String], right: Option[String]) -> Option[String] {
  match left {
    Some(name) => match right {
      Some(other) => {
        let same = name == other
        if same {
          Some(name)
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}

fn afe_bind_shapes(locals: Array[(String, String)], name: String, val: Expr, env: TypeEnv) -> Array[(String, String)] {
  let without = afe_bind_local(afe_bind_local(locals, afe_tuple_shape_key(name), None), afe_array_elem_key(name), None)
  match val {
    ETuple(items) => if Array::length(items) > 0 {
      let parts = array_empty()
      let mut i = 0
      while i < Array::length(items) {
        let part = match afe_expr_head_name(Array::get(items, i), env, locals) {
          Some(h) => h,
          None => ""
        }
        Array::push(parts, part)
        i = i + 1
      }
      afe_bind_local(without, afe_tuple_shape_key(name), Some(afe_join_csv(parts)))
    } else {
      without
    },
    EArray(items) => if Array::length(items) > 0 {
      afe_bind_local(without, afe_array_elem_key(name), afe_expr_head_name(Array::get(items, 0), env, locals))
    } else {
      without
    },
    _ => without
  }
}

fn afe_fn_return_head(val: Expr, env: TypeEnv) -> Option[String] {
  match val {
    EFn(_, _, _, ret, _, _) => match ret {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(h, afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    },
    _ => None
  }
}

fn afe_bind_local_fn_return(locals: Array[(String, String)], name: String, val: Expr, env: TypeEnv) -> Array[(String, String)] {
  afe_bind_local(locals, afe_local_fn_return_key(name), afe_fn_return_head(val, env))
}

fn afe_bind_value(locals: Array[(String, String)], name: String, val: Expr, env: TypeEnv) -> Array[(String, String)] {
  let with_head = afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))
  let with_fn = afe_bind_local_fn_return(with_head, name, val, env)
  afe_bind_shapes(with_fn, name, val, env)
}

fn afe_match_arm_locals(scrut: Expr, pat: Pat, env: TypeEnv, locals: Array[(String, String)]) -> Array[(String, String)] {
  match pat {
    PBind(name) => afe_bind_local(locals, name, afe_expr_head_name(scrut, env, locals)),
    PCtor(cn, sub) => match scrut {
      ECall(EIdent(name, _), args, _) => if name == cn || String::ends_with(name, String::concat("::", cn)) {
        let mut acc = locals
        let mut i = 0
        while i < Array::length(sub) && i < Array::length(args) {
          acc = afe_match_arm_locals(Array::get(args, i), Array::get(sub, i), env, acc)
          i = i + 1
        }
        acc
      } else {
        locals
      },
      _ => locals
    },
    _ => locals
  }
}

fn afe_tuple_elem_head(obj: Expr, field: String, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_digit_index(field) {
    None => None,
    Some(idx) => match obj {
      ETuple(items) => if idx >= 0 && idx < Array::length(items) {
        afe_expr_head_name(Array::get(items, idx), env, locals)
      } else {
        None
      },
      EIdent(name, _) => match afe_lookup_local(locals, afe_tuple_shape_key(name)) {
        Some(sentinel) => {
          let parts = afe_split_csv(sentinel)
          if idx >= 0 && idx < Array::length(parts) {
            let elem = Array::get(parts, idx)
            if String::length(elem) > 0 {
              Some(elem)
            } else {
              None
            }
          } else {
            None
          }
        },
        None => None
      },
      _ => None
    }
  }
}

fn afe_array_elem_head(args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  if Array::length(args) == 2 {
    match Array::get(args, 0) {
      EIdent(arrname, _) => afe_lookup_local(locals, afe_array_elem_key(arrname)),
      EArray(items) => if Array::length(items) > 0 {
        afe_expr_head_name(Array::get(items, 0), env, locals)
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

fn afe_ident_call_head(f: String, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  if f == "Array::get" || f == "__index" {
    match afe_array_elem_head(args, env, locals) {
      Some(head) => Some(head),
      None => afe_ident_call_head_generic(f, args, env, locals)
    }
  } else {
    afe_ident_call_head_generic(f, args, env, locals)
  }
}

fn afe_ident_call_head_generic(f: String, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_lookup_local(locals, afe_local_fn_return_key(f)) {
    Some(head) => Some(head),
    None => afe_ident_call_head_env(f, args, env, locals)
  }
}

fn afe_ident_call_head_env(f: String, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match env_lookup(env, f) {
    Some(callee_type) => match afe_call_result_head(callee_type, args, env, locals) {
      Some(head) => Some(afe_finish_call_head(head, env, f)),
      None => match env_lookup_binding(env, f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => None
      }
    },
    _ => match lookup_builtin(f) {
      Some(callee_type) => match afe_call_result_head(callee_type, args, env, locals) {
        Some(head) => Some(afe_finish_call_head(head, env, f)),
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      },
      _ => match env_lookup_binding(env, f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    }
  }
}

fn afe_dot_call_head(obj: Expr, method: String, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_expr_head_name(obj, env, locals) {
    Some(receiver) => {
      let display = afe_display_iter_head(receiver)
      let qualified = String::concat(display, String::concat("::", method))
      let call_args = afe_prepend_expr(obj, args)
      match afe_ident_call_head(qualified, call_args, env, locals) {
        Some(head) => Some(head),
        None => if receiver == afe_builtin_async_iter_head && afe_is_async_iter_publication_name(qualified) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    },
    None => None
  }
}

fn afe_iife_head(params: Array[(String, Option[TypeExpr])], body: Expr, args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  let mut body_locals = afe_bind_params(locals, params, env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(Array::get(args, i), env, locals)
    } else {
      None
    }
    body_locals = afe_bind_local(body_locals, name, inferred)
    i = i + 1
  }
  afe_expr_head_name(body, env, body_locals)
}

fn afe_handler_arm_head(arm_body: Expr, expected: String, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match arm_body {
    ECall(EIdent("resume", _), resume_args, _) => if Array::length(resume_args) == 1 {
      Some(expected)
    } else {
      None
    },
    ELet(name, val, body, _) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    ELetMut(name, val, body, _) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    ELetRec(name, val, body) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    EReturn(inner) => afe_handler_arm_head(inner, expected, env, locals),
    EAssign(_, _, continuation) => afe_handler_arm_head(continuation, expected, env, locals),
    EAssignOp(_, _, _, continuation) => afe_handler_arm_head(continuation, expected, env, locals),
    ESeq(_, result) => afe_handler_arm_head(result, expected, env, locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(afe_handler_arm_head(then_branch, expected, env, locals), afe_handler_arm_head(else_branch, expected, env, locals)),
    _ => afe_expr_head_name(arm_body, env, locals)
  }
}

fn afe_op_name_matches(name: String, op: String) -> Bool {
  name == op || String::ends_with(name, String::concat("::", op)) || String::ends_with(op, String::concat("::", name))
}

fn afe_handler_consumes_op(arms: Array[(Pat, Expr)], op: String) -> Bool {
  let mut i = 0
  let mut consumes = false
  while i < Array::length(arms) && !consumes {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if afe_op_name_matches(name, op) {
        consumes = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  consumes
}

let afe_callable_bodies: Array[(String, Array[(String, Option[TypeExpr])], Option[String], Expr)] = array_empty()
let afe_payload_call_stack: Array[String] = array_empty()
let afe_reachability_keys: Array[String] = array_empty()
let afe_reachability_values: Array[Bool] = array_empty()
let afe_reachability_stack: Array[String] = array_empty()

fn afe_collect_callable_bodies(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, params, _, effect, body)) => {
        Array::push(afe_callable_bodies, (name, params, effect, body))
      },
      SFnDecl(_, name, EFn(_, _, params, _, effect, body), _, _) => {
        Array::push(afe_callable_bodies, (name, params, effect, body))
      },
      SModule(_, _, body) => afe_collect_callable_bodies(body),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_lookup_callable_body(name: String) -> Option[(Array[(String, Option[TypeExpr])], Option[String], Expr)] {
  let mut i = Array::length(afe_callable_bodies) - 1
  let mut out = None
  let mut found = false
  let mut ambiguous = false
  while i >= 0 {
    let (current, params, effect, body) = Array::get(afe_callable_bodies, i)
    if current == name {
      if found {
        ambiguous = true
      } else {
        out = Some((params, effect, body))
        found = true
      }
    } else {
      ()
    }
    i = i - 1
  }
  if ambiguous {
    None
  } else {
    out
  }
}

fn afe_payload_call_is_active(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_payload_call_stack) && !found {
    found = Array::get(afe_payload_call_stack, i) == name
    i = i + 1
  }
  found
}

fn afe_callable_may_perform(effect: Option[String], op: String) -> Bool {
  match effect_row_parse(effect) {
    Some(labels) => decl_authorizes_op(labels, op),
    None => false
  }
}

fn afe_reachability_key(name: String, op: String) -> String {
  String::concat(name, String::concat("\t", op))
}

fn afe_reachability_cache_get(key: String) -> Option[Bool] {
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_reachability_keys) {
    if Array::get(afe_reachability_keys, i) == key {
      out = Some(Array::get(afe_reachability_values, i))
      i = Array::length(afe_reachability_keys)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_reachability_is_active(key: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_reachability_stack) && !found {
    found = Array::get(afe_reachability_stack, i) == key
    i = i + 1
  }
  found
}

fn afe_expr_may_perform(expr: Expr, op: String) -> Bool {
  match expr {
    EHandle(body, arms) => {
      let mut found = if afe_handler_consumes_op(arms, op) {
        false
      } else {
        afe_expr_may_perform(body, op)
      }
      let mut i = 0
      while i < Array::length(arms) && !found {
        let (_, arm_body) = Array::get(arms, i)
        found = afe_expr_may_perform(arm_body, op)
        i = i + 1
      }
      found
    },
    EFn(_, _, _, _, _, _) => false,
    ECall(callee, args, _) => {
      let mut found = match callee {
        EIdent("perform", _) => if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(EIdent(op_name, _), _, _) => afe_op_name_matches(op_name, op),
            _ => false
          }
        } else {
          false
        },
        EFn(_, _, _, _, _, body) => afe_expr_may_perform(body, op),
        EIdent(name, _) => afe_callable_reaches_op(name, op),
        _ => false
      }
      let mut i = 0
      while i < Array::length(args) && !found {
        found = afe_expr_may_perform(Array::get(args, i), op)
        i = i + 1
      }
      found
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) && !found {
        found = afe_expr_may_perform(Array::get(children, i), op)
        i = i + 1
      }
      found
    }
  }
}

fn afe_callable_reaches_op(name: String, op: String) -> Bool {
  let key = afe_reachability_key(name, op)
  match afe_reachability_cache_get(key) {
    Some(value) => value,
    None => if afe_reachability_is_active(key) {
      false
    } else match afe_lookup_callable_body(name) {
      Some((_, effect, body)) => {
        let stack_len = Array::length(afe_reachability_stack)
        Array::push(afe_reachability_stack, key)
        let result = afe_callable_may_perform(effect, op) && afe_expr_may_perform(body, op)
        Array::truncate(afe_reachability_stack, stack_len)
        if result {
          Array::push(afe_reachability_keys, key)
          Array::push(afe_reachability_values, true)
        } else {
          ()
        }
        result
      },
      None => false
    }
  }
}

fn afe_callable_body_locals(params: Array[(String, Option[TypeExpr])], args: Array[Expr], env: TypeEnv, locals: Array[(String, String)]) -> Array[(String, String)] {
  let mut body_locals = afe_bind_params(locals, params, env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(Array::get(args, i), env, locals)
    } else {
      None
    }
    body_locals = afe_bind_local(body_locals, name, inferred)
    i = i + 1
  }
  body_locals
}

fn afe_collect_perform_payloads(expr: Expr, op: String, payload_index: Int, env: TypeEnv, locals: Array[(String, String)], out: Array[Option[String]]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      if !afe_handler_consumes_op(arms, op) {
        afe_collect_perform_payloads(body, op, payload_index, env, locals, out)
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_locals = afe_handler_arm_locals(body, pat, env, locals)
        afe_collect_perform_payloads(arm_body, op, payload_index, env, arm_locals, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, _) => (),
    ELet(name, val, body, _) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ELetMut(name, val, body, _) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals, name, val, env)
      afe_collect_perform_payloads(val, op, payload_index, env, rec_locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, rec_locals, out)
    },
    EAssign(name, val, continuation) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(continuation, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => if name == "perform" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(EIdent(op_name, _), oargs, _) => if afe_op_name_matches(op_name, op) && payload_index >= 0 && payload_index < Array::length(oargs) {
              Array::push(out, afe_expr_head_name(Array::get(oargs, payload_index), env, locals))
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      match callee {
        EFn(_, _, params, _, _, body) => {
          let body_locals = afe_callable_body_locals(params, args, env, locals)
          afe_collect_perform_payloads(body, op, payload_index, env, body_locals, out)
        },
        EIdent(name, _) => if name == "perform" || afe_payload_call_is_active(name) {
          ()
        } else match afe_lookup_callable_body(name) {
          Some((params, effect, body)) => if afe_callable_may_perform(effect, op) && afe_callable_reaches_op(name, op) {
            let stack_len = Array::length(afe_payload_call_stack)
            Array::push(afe_payload_call_stack, name)
            let body_locals = afe_callable_body_locals(params, args, env, locals)
            afe_collect_perform_payloads(body, op, payload_index, env, body_locals, out)
            Array::truncate(afe_payload_call_stack, stack_len)
          } else {
            ()
          },
          None => ()
        },
        _ => ()
      }
      let mut i = 0
      while i < Array::length(args) {
        afe_collect_perform_payloads(Array::get(args, i), op, payload_index, env, locals, out)
        i = i + 1
      }
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        afe_collect_perform_payloads(Array::get(children, i), op, payload_index, env, locals, out)
        i = i + 1
      }
    }
  }
}

fn afe_perform_payload_head(body: Expr, op: String, payload_index: Int, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  let payloads = array_empty()
  afe_collect_perform_payloads(body, op, payload_index, env, locals, payloads)
  if Array::length(payloads) == 0 {
    None
  } else {
    let mut i = 1
    let mut result = Array::get(payloads, 0)
    while i < Array::length(payloads) {
      match result {
        Some(expected) => match Array::get(payloads, i) {
          Some(actual) => if actual != expected {
            result = None
          } else {
            ()
          },
          None => {
            result = None
          }
        },
        None => {
          i = Array::length(payloads)
        }
      }
      i = i + 1
    }
    result
  }
}

fn afe_handler_arm_locals(body: Expr, pat: Pat, env: TypeEnv, locals: Array[(String, String)]) -> Array[(String, String)] {
  match pat {
    PCtor(cn, sub) => {
      let mut arm_locals = locals
      let mut i = 0
      while i < Array::length(sub) {
        match Array::get(sub, i) {
          PBind(name) => {
            arm_locals = afe_bind_local(arm_locals, name, afe_perform_payload_head(body, cn, i, env, locals))
          },
          _ => ()
        }
        i = i + 1
      }
      arm_locals
    },
    _ => locals
  }
}

fn afe_handle_head(body: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_expr_head_name(body, env, locals) {
    None => None,
    Some(expected) => {
      let mut i = 0
      let mut agrees = true
      while i < Array::length(arms) && agrees {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_locals = afe_handler_arm_locals(body, pat, env, locals)
        match afe_handler_arm_head(arm_body, expected, env, arm_locals) {
          Some(actual) => {
            let same = actual == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            agrees = false
          }
        }
        i = i + 1
      }
      if agrees {
        Some(expected)
      } else {
        None
      }
    }
  }
}

fn afe_match_head(scrut: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  if Array::length(arms) == 0 {
    None
  } else {
    let mut i = 0
    let mut result = None
    let mut agrees = true
    while i < Array::length(arms) && agrees {
      let (pat, body) = Array::get(arms, i)
      let arm_locals = afe_match_arm_locals(scrut, pat, env, locals)
      match afe_expr_head_name(body, env, arm_locals) {
        Some(head) => match result {
          Some(expected) => {
            let same = head == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            result = Some(head)
          }
        },
        None => {
          agrees = false
        }
      }
      i = i + 1
    }
    if agrees {
      result
    } else {
      None
    }
  }
}

fn afe_collect_loop_head(expr: Expr, env: TypeEnv, locals: Array[(String, String)], expected: Array[String], valid: Array[Bool]) -> Unit {
  if !Array::get(valid, 0) {
    ()
  } else {
    match expr {
      EAssign("__loop_result", value, continuation) => {
        match afe_expr_head_name(value, env, locals) {
          Some(actual) => if Array::length(expected) == 0 {
            Array::push(expected, actual)
          } else if Array::get(expected, 0) != actual {
            Array::set(valid, 0, false)
          } else {
            ()
          },
          None => Array::set(valid, 0, false)
        }
        afe_collect_loop_head(continuation, env, locals, expected, valid)
      },
      EBreak(Some(value)) => match afe_expr_head_name(value, env, locals) {
        Some(actual) => if Array::length(expected) == 0 {
          Array::push(expected, actual)
        } else if Array::get(expected, 0) != actual {
          Array::set(valid, 0, false)
        } else {
          ()
        },
        None => Array::set(valid, 0, false)
      },
      ELetMut("__loop_result", _, _, _) => (),
      ELoop(_, _) => (),
      EWhile(_, _) => (),
      EForIn(_, _, _, _) => (),
      EFn(_, _, _, _, _, _) => (),
      ELet(name, value, body, _) => {
        afe_collect_loop_head(value, env, locals, expected, valid)
        afe_collect_loop_head(body, env, afe_bind_value(locals, name, value, env), expected, valid)
      },
      ELetMut(name, value, body, _) => {
        afe_collect_loop_head(value, env, locals, expected, valid)
        afe_collect_loop_head(body, env, afe_bind_value(locals, name, value, env), expected, valid)
      },
      EMatch(scrut, arms) => {
        afe_collect_loop_head(scrut, env, locals, expected, valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (pat, body) = Array::get(arms, i)
          afe_collect_loop_head(body, env, afe_match_arm_locals(scrut, pat, env, locals), expected, valid)
          i = i + 1
        }
      },
      EHandle(body, arms) => {
        afe_collect_loop_head(body, env, locals, expected, valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (_, arm_body) = Array::get(arms, i)
          afe_collect_loop_head(arm_body, env, locals, expected, valid)
          i = i + 1
        }
      },
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) && Array::get(valid, 0) {
          afe_collect_loop_head(Array::get(children, i), env, locals, expected, valid)
          i = i + 1
        }
      }
    }
  }
}

fn afe_parameterized_loop_head(body: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match body {
    ESeq(EWhile(_, loop_body), EIdent("__loop_result", _)) => {
      let expected = array_empty()
      let valid = [true]
      afe_collect_loop_head(loop_body, env, locals, expected, valid)
      if Array::get(valid, 0) && Array::length(expected) == 1 {
        Some(Array::get(expected, 0))
      } else {
        None
      }
    },
    _ => None
  }
}

fn afe_loop_head(inits: Array[(String, Expr)], body: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  let mut body_locals = locals
  let mut i = 0
  while i < Array::length(inits) {
    let (name, val) = Array::get(inits, i)
    body_locals = afe_bind_value(body_locals, name, val, env)
    i = i + 1
  }
  let expected = array_empty()
  let valid = [true]
  afe_collect_loop_head(body, env, body_locals, expected, valid)
  if Array::get(valid, 0) && Array::length(expected) == 1 {
    Some(Array::get(expected, 0))
  } else {
    None
  }
}

fn afe_expr_head_name(e: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match e {
    EIdent(n, _) => match afe_lookup_local(locals, n) {
      Some(h) => Some(h),
      None => match env_lookup(env, n) {
        Some(t) => match afe_type_head_name(t) {
          Some(head) => Some(afe_tag_async_iter_head(head, afe_callee_is_builtin_async_iter(env, n) || afe_type_binding_is_builtin_async_iter(env))),
          None => None
        },
        None => None
      }
    },
    ERecord(n, _, _) => if String::length(n) > 0 {
      Some(afe_tag_async_iter_head(n, afe_type_binding_is_builtin_async_iter(env)))
    } else {
      None
    },
    EDot(obj, field, _, _) => match afe_tuple_elem_head(obj, field, env, locals) {
      Some(head) => Some(head),
      None => match afe_expr_head_name(obj, env, locals) {
        Some(otype) => afe_lookup_field_type(afe_display_iter_head(otype), field),
        None => None
      }
    },
    ECall(callee, args, _) => match callee {
      EIdent(f, _) => afe_ident_call_head(f, args, env, locals),
      EDot(obj, method, _, _) => afe_dot_call_head(obj, method, args, env, locals),
      EFn(_, _, params, _, _, body) => afe_iife_head(params, body, args, env, locals),
      _ => None
    },
    ELet(name, val, body, _) => afe_expr_head_name(body, env, afe_bind_value(locals, name, val, env)),
    ELetMut(name, val, body, _) => if name == "__loop_result" {
      afe_parameterized_loop_head(body, env, locals)
    } else {
      afe_expr_head_name(body, env, afe_bind_value(locals, name, val, env))
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals, name, val, env)
      afe_expr_head_name(body, env, rec_locals)
    },
    EReturn(inner) => afe_expr_head_name(inner, env, locals),
    EAssign(_, _, continuation) => afe_expr_head_name(continuation, env, locals),
    EAssignOp(_, _, _, continuation) => afe_expr_head_name(continuation, env, locals),
    ESeq(_, result) => afe_expr_head_name(result, env, locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(afe_expr_head_name(then_branch, env, locals), afe_expr_head_name(else_branch, env, locals)),
    EMatch(scrut, arms) => afe_match_head(scrut, arms, env, locals),
    EHandle(body, arms) => afe_handle_head(body, arms, env, locals),
    ELoop(inits, body) => afe_loop_head(inits, body, env, locals),
    _ => None
  }
}

/// The public constructor is the package-stable evidence available after
/// `@vibe/builtin` projection hides its private `AsyncIterator` trait. Require
/// the imported signature as well as the nominal head: a user-defined struct
/// that happens to be named `AsyncIter` must remain an ordinary sync value.
fn afe_origin_is_builtin_async_iter(origin: BindingOrigin) -> Bool {
  let (path, source_name) = match origin {
    BindingOriginModuleExport(origin_path, source) => (origin_path, source),
    BindingOriginReExportSurface(origin_path, source) => (origin_path, source),
    BindingOriginUnavailable => ("", "")
  }
  let from_builtin = String::ends_with(path, "@vibe/builtin/index.vpkg") || String::ends_with(path, "@vibe/builtin/async_iter.vibe")
  let publishes_async_iter = afe_is_async_iter_publication_name(source_name)
  from_builtin && publishes_async_iter
}

fn afe_has_builtin_async_iter_provenance(env: TypeEnv) -> Bool {
  afe_type_binding_is_builtin_async_iter(env)
}

/// The iterand's type name when driving it with `for` awaits each step,
/// otherwise None. Named so the diagnostic can point at `<T>::next`.
fn afe_async_iterand(iter: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_expr_head_name(iter, env, locals) {
    // #1341: the p3 host stream is async by construction and has no
    // AsyncIterator impl to find -- its read primitive is the scalar
    // `host_stream_next(s) -> Int with Async`, and the desugar builds the
    // loop on that read directly (build_host_stream_for). The loop therefore
    // parks once per byte, so the enclosing row must carry `Async` for exactly
    // the reason #1358 gave for trait-based async iterators.
    Some(tn) => {
      let display = afe_display_iter_head(tn)
      if display == "HostStream" || type_name_has_async_iterator_impl(env, display) {
        Some(display)
      } else if tn == afe_builtin_async_iter_head || (display == "AsyncIter" && afe_has_builtin_async_iter_provenance(env)) {
        Some("AsyncIter")
      } else {
        None
      }
    },
    None => None
  }
}

fn afe_contains_for(expr: Expr) -> Bool {
  match expr {
    EForIn(_, _, _, _) => true,
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) && !found {
        found = afe_contains_for(Array::get(children, i))
        i = i + 1
      }
      found
    }
  }
}

export fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {
  // #2386 review: the memos are cleared before ANYTHING of this entry asks
  // them -- `afe_set_field_types` below consults the `AsyncIter` provenance
  // cell while building the field-type table, so a reset placed after it
  // would let the previous entry's answer into this program's table.
  afe_reset_entry_memos()
  Array::truncate(afe_callable_bodies, 0)
  Array::truncate(afe_payload_call_stack, 0)
  Array::truncate(afe_reachability_keys, 0)
  Array::truncate(afe_reachability_values, 0)
  Array::truncate(afe_reachability_stack, 0)
  check_async_effects_expr_lo(expr, env, in_async, afe_no_locals())
}

/// #1358: the same walk with a `name -> head type name` table for the bindings
/// in scope, so an async `for` can be recognised through an ordinary local
/// (`let it = Array::iter(xs); for x in it`) and through a typed parameter.
fn check_async_effects_expr_lo(expr: Expr, env: TypeEnv, in_async: Bool, locals: Array[(String, String)]) -> Array[EffectError] {
  let out = array_empty()
  check_async_effects_expr_lo_into(expr, env, in_async, locals, out)
  out
}

fn check_async_effects_expr_lo_into(expr: Expr, env: TypeEnv, in_async: Bool, locals: Array[(String, String)], out: Array[EffectError]) -> Unit {
  // Preserve the legacy preorder diagnostic order: inspect a call before its
  // structural children, then delegate their enumeration to expr_children.
  match expr {
    ECall(EIdent(name, _), _, _) => if !in_async && is_async_primitive(name, env) {
      Array::push(out, EEEffectfulCallOutsideEffect(name))
    } else {
      ()
    },
    EForIn(_, _, iter, _) => match afe_async_iterand(iter, env, locals) {
      Some(tn) => if !in_async {
        Array::push(out, EEEffectfulCallOutsideEffect(String::concat(tn, "::next (a `for` over an async iterator awaits every step -- add `with Async` or wrap the loop in a handler for it)")))
      } else {
        ()
      },
      None => ()
    },
    _ => ()
  }
  match expr {
    // Scope boundary: a lambda's explicit row replaces its enclosing Async
    // context. All other expression forms retain the context unchanged.
    EFn(_, _, params, _, effect, body) => {
      check_async_effects_expr_lo_into(body, env, effect_opt_is_async(effect), afe_bind_params(locals, params, env), out)
    },
    EHandle(body, arms) => {
      let discharges_async = handle_arms_handle_async(arms)
      check_async_effects_expr_lo_into(body, env, in_async || discharges_async, locals, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let arm_locals = if afe_contains_for(arm_body) {
          afe_handler_arm_locals(body, pat, env, locals)
        } else {
          locals
        }
        check_async_effects_expr_lo_into(arm_body, env, in_async, arm_locals, out)
        ai = ai + 1
      }
    },
    // ELet/ELetMut are non-recursive: the value is resolved in the OUTER scope,
    // and only the body sees the new binding. ELetRec's value may reference
    // itself, so both sides see it.
    ELet(name, val, body, _) => {
      check_async_effects_expr_lo_into(val, env, in_async, locals, out)
      check_async_effects_expr_lo_into(body, env, in_async, afe_bind_value(locals, name, val, env), out)
    },
    ELetMut(name, val, body, _) => {
      check_async_effects_expr_lo_into(val, env, in_async, locals, out)
      check_async_effects_expr_lo_into(body, env, in_async, afe_bind_value(locals, name, val, env), out)
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals, name, val, env)
      check_async_effects_expr_lo_into(val, env, in_async, rec_locals, out)
      check_async_effects_expr_lo_into(body, env, in_async, rec_locals, out)
    },
    EForIn(name, index_name, iter, body) => {
      check_async_effects_expr_lo_into(iter, env, in_async, locals, out)
      // The loop variables are ELEMENTS, never the iterator itself: bind them
      // to nothing so they shadow any same-named outer entry.
      let body_locals = match index_name {
        Some(idx) => afe_bind_local(afe_bind_local(locals, name, None), idx, None),
        None => afe_bind_local(locals, name, None)
      }
      check_async_effects_expr_lo_into(body, env, in_async, body_locals, out)
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_async_effects_expr_lo_into(expr_child_at(i), env, in_async, locals, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

/// A function body runs in an `{Async}` context if EITHER the lambda's inline
/// effect OR the binding's declared signature type carries `Async`.
fn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {
  match topt {
    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),
    _ => false
  }
}

fn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {
  let sig_async = sig_type_is_async(ty)
  match body {
    // #1358: descending straight into `fbody` skips the EFn arm, so bind this
    // binding's own parameters here — otherwise `fn drain(s: AsyncIter[Int])`
    // would not resolve `s` when its body loops over it.
    EFn(_, _, params, _, eff, fbody) => check_async_effects_expr_lo(fbody, env, sig_async || effect_opt_is_async(eff), afe_bind_params(afe_no_locals(), merge_param_types_with_sig(ty, params), env)),
    _ => check_async_effects_expr_lo(body, env, sig_async, afe_no_locals())
  }
}

fn check_async_effects_stmt_lo(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),
    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),
    STest(_, body) => check_async_effects_expr_lo(body, env, false, afe_no_locals()),
    SBench(_, body) => check_async_effects_expr_lo(body, env, false, afe_no_locals()),
    SExpr(e) => check_async_effects_expr_lo(e, env, false, afe_no_locals()),
    _ => array_empty()
  }
}

export fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {
  // #2386 review: the memos are cleared before ANYTHING of this entry asks
  // them -- `afe_set_field_types` below consults the `AsyncIter` provenance
  // cell while building the field-type table, so a reset placed after it
  // would let the previous entry's answer into this program's table.
  afe_reset_entry_memos()
  Array::truncate(afe_callable_bodies, 0)
  Array::truncate(afe_payload_call_stack, 0)
  Array::truncate(afe_reachability_keys, 0)
  Array::truncate(afe_reachability_values, 0)
  Array::truncate(afe_reachability_stack, 0)
  check_async_effects_stmt_lo(stmt, env)
}

export fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  // #2386 review: the memos are cleared before ANYTHING of this entry asks
  // them -- `afe_set_field_types` below consults the `AsyncIter` provenance
  // cell while building the field-type table, so a reset placed after it
  // would let the previous entry's answer into this program's table.
  afe_reset_entry_memos()
  // Enforce direct-call-only before ordinary Async row checks. These errors are
  // checker diagnostics, so no artifact reaches codegen for an opaque flow.
  let errors = check_stdin_provider_direct_calls_stmts(stmts)
  // #1341: rebuild the struct field-type table for THIS program before the
  // walk, so a stale one from a previous module can never classify a
  // same-named field here.
  afe_set_field_types(stmts, env)
  Array::truncate(afe_builtin_async_iter_import_names, 0)
  afe_record_builtin_async_iter_imports(stmts)
  Array::truncate(afe_callable_bodies, 0)
  Array::truncate(afe_payload_call_stack, 0)
  Array::truncate(afe_reachability_keys, 0)
  Array::truncate(afe_reachability_values, 0)
  Array::truncate(afe_reachability_stack, 0)
  afe_collect_callable_bodies(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_async_effects_stmt_lo(Array::get(stmts, i), env))
    i = i + 1
  }
  errors
}

//# perform-discipline enforcement (#626 criterion 1)
//
// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either
// the enclosing function/lambda declares it in `with` row, or the perform
// is inside a `handle` (which discharges it). Otherwise it is a type error —
// "performing an undeclared effect". This realizes the first acceptance
// criterion of #626 (the checker formerly accepted undeclared performs because
// it never resolved which effect an op belongs to).
//
// A `handle` is treated CONSERVATIVELY as discharging any effect for its body
// (we do not yet read which specific effect its arms handle), so a perform
// inside any handle is allowed — this never rejects a valid program; it only
// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle
// case, which full row tracking (#626 criteria 2/4) will cover.

/// Parse a source `with` row annotation into the canonical row. This is
/// the sole parser for checker effect rows: labels are trimmed and deduped, and
/// `None` remains structurally different from an explicit `with ()`.
fn effect_row_parse(eff: Option[String]) -> Option[Array[String]] {
  match eff {
    // None is structurally distinct from Some([]): it means the row is
    // inferred and therefore inherits its surrounding context.
    None => None,
    Some(s) => {
      let labels = array_empty()
      let raw = String::split(s, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = canonical_exception_effect_name(String::trim(Array::get(raw, i)))
        let internal_provenance = String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[") || String::starts_with(label, "#aliasparam[") || String::starts_with(label, "#fieldparam[")
        if String::length(label) > 0 && !internal_provenance && !effect_row_has_label(Some(labels), label) {
          Array::push(labels, label)
        }
        i = i + 1
      }
      // Some([]) is an explicitly pure `with ()` row.
      Some(labels)
    }
  }
}

/// Exact membership only; notably, `NotAsync` and `AsyncLike` do not contain
/// the `Async` label.
fn effect_row_has_label(row: Option[Array[String]], wanted: String) -> Bool {
  match row {
    None => false,
    Some(labels) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(labels) {
        if Array::get(labels, i) == wanted {
          found = true
        }
        i = i + 1
      }
      found
    }
  }
}

/// Exact membership for consumers outside the checker package. Effect rows
/// are parser-normalized comma-separated labels; substring matching would let
/// `NotAsync` or `AsyncLike` grant the `Async` capability (#1289).
export fn effect_row_contains_label(eff: Option[String], wanted: String) -> Bool {
  effect_row_has_label(effect_row_parse(eff), wanted)
}

fn effect_row_labels(row: Option[Array[String]]) -> Array[String] {
  match row {
    None => array_empty(),
    Some(labels) => labels
  }
}

/// Resolve an annotation at a nested lambda boundary. Inferred rows inherit;
/// explicit rows, including `with ()`, replace the surrounding row.
fn effect_row_inherit(row: Option[Array[String]], surrounding: Array[String]) -> Array[String] {
  match row {
    None => surrounding,
    Some(labels) => labels
  }
}

/// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the
/// current representation): a function declaring `with e` may perform any
/// effect, so treat such a declaration as authorizing everything.
fn label_is_effect_var(name: String) -> Bool {
  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
}

/// #1340 (ADR-0071): the base effect name of a row label — `State[Int]` and
/// `State[String]` both have base `State`; a bracketless label is its own
/// base. Row CONTAINMENT is instantiation-insensitive for now: a bare
/// `State` authorizes any instantiation and vice versa (for bracketless
/// rows base equality degenerates to exact equality, so existing programs
/// are unchanged). Distinguishing instantiations inside containment is the
/// remaining ADR-0071 OperationRef-normalization work.
fn row_label_base(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi > 0 {
    label[0: bi]
  } else {
    label
  }
}

/// #3053: `E[A]` and `E[B]` stay interchangeable (#1340 v1) EXCEPT when both
/// sides spell closed builtin types that differ: `with State[Int]` does not
/// authorize a callee's `State[String]`. The test is syntactic, so it only
/// judges spellings made of builtin type names -- a formal, an alias or a
/// declared type is not a builtin name, so it keeps the old base-name answer
/// rather than being mistaken for a different type.
/// A requirement whose call instantiated a formal ambiguously (`?S`, see
/// `ambiguous_formal_bindings`) is authorized by no declared label.
fn row_label_args_ambiguous(label: String) -> Bool {
  String::contains(row_label_args(label), "?")
}

/// Does a stored row carry a label `row_label_args_ambiguous` refuses?
fn row_has_ambiguous_label(row: String) -> Bool {
  let parts = row_items_top_level(row)
  let mut found = false
  let mut i = 0
  while i < Array::length(parts) && !found {
    if row_label_args_ambiguous(Array::get(parts, i)) {
      found = true
    }
    i = i + 1
  }
  found
}

fn row_label_args_closed_and_differ(a: String, b: String) -> Bool {
  let aa = row_label_args(a)
  let ba = row_label_args(b)
  String::length(aa) > 0 && String::length(ba) > 0 && builtin_closed_type_text(aa) && builtin_closed_type_text(ba) && aa != ba
}

/// The text between a label's first `[` and its matching `]`, spaces removed;
/// "" when the label carries no brackets.
fn row_label_args(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi < 0 {
    ""
  } else {
    let n = String::length(label)
    let mut depth = 0
    let mut end = 0 - 1
    let mut i = bi
    while i < n && end < 0 {
      let c = String::char_code_at(label, i)
      if c == 91 {
        depth = depth + 1
      } else if c == 93 {
        depth = depth - 1
        if depth == 0 {
          end = i
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    if end < 0 {
      ""
    } else {
      let inner = String::substring(label, bi + 1, end)
      String::join(String::split(inner, " "), "")
    }
  }
}

/// Builtin type names a binder reuses as a type parameter (`fn f[Int](..)`,
/// Codex on #3054). Such a spelling may name a formal, so
/// `builtin_closed_type_text` does not judge it. The set is LEXICAL: it is
/// recorded per top-level declaration (`effect_shadow_key`), and the effects
/// walk selects the declaration's own set before walking it, so a shadowing
/// formal in one declaration does not switch the check off in another (Codex
/// on #3054). Slot 0 is the set in force; slot 1 is the module-wide union,
/// used for a statement no key names -- the lenient answer, never a refusal.
let shadowed_builtin_type_names_cell: Array[Array[String]] = [[], []]
let shadowed_builtin_type_names_by_decl: Array[MutMap[String, Array[String]]] = [
  MutMap::new_string()
]

export fn set_shadowed_builtin_type_names(by_decl: Array[(String, Array[String])]) -> Unit {
  let m = MutMap::new_string()
  let all = array_empty()
  let mut i = 0
  while i < Array::length(by_decl) {
    let (k, names) = Array::get(by_decl, i)
    MutMap::set(m, k, names)
    let mut j = 0
    while j < Array::length(names) {
      if !str_labels_contain(all, Array::get(names, j)) {
        Array::push(all, Array::get(names, j))
      }
      j = j + 1
    }
    i = i + 1
  }
  Array::set(shadowed_builtin_type_names_by_decl, 0, m)
  Array::set(shadowed_builtin_type_names_cell, 1, all)
  Array::set(shadowed_builtin_type_names_cell, 0, all)
}

/// The key a top-level statement's shadow set is recorded and selected under;
/// "" for a statement that names nothing (it takes the module-wide set).
export fn effect_shadow_key(stmt: Stmt) -> String {
  match stmt {
    SLet(_, _, name, _, _) => String::concat("let:", name),
    SLetMut(name, _, _) => String::concat("let:", name),
    STest(name, _) => String::concat("test:", name),
    SBench(name, _) => String::concat("bench:", name),
    _ => ""
  }
}

fn select_shadowed_builtin_type_names(stmt: Stmt) -> Unit {
  let k = effect_shadow_key(stmt)
  let chosen = if String::length(k) == 0 {
    Array::get(shadowed_builtin_type_names_cell, 1)
  } else {
    // A declaration with no entry shadows nothing.
    match MutMap::get(Array::get(shadowed_builtin_type_names_by_decl, 0), k) {
      Some(names) => names,
      None => []
    }
  }
  Array::set(shadowed_builtin_type_names_cell, 0, chosen)
}

/// #3095: the nominal type names (structs, enums) this module declares or
/// imports under their own name, never an alias (`row_nominal_type_names`).
/// A row word in this set names exactly one type.
let row_nominal_types_cell: Array[Array[String]] = [[]]

export fn set_row_nominal_types(names: Array[String]) -> Unit {
  Array::set(row_nominal_types_cell, 0, names)
}

/// #3095: the type formals in LEXICAL scope where the walk stands, one entry
/// per binder that introduced some: the top-level declaration's own `[S]`, and
/// every nested lambda's. A lambda with no row of its own inherits the
/// enclosing row, whose words were written OUTSIDE its binder, so its formals
/// are entered as `@N`: they place a requirement's `'N` (the lambda's body
/// runs at its own `N`) but never a DECLARED word (`[N](v: N) -> Int { .. }`
/// under `with State[N]`, `N` an imported alias, reads the alias). An entry
/// holding `row_scope_unknown()` switches the judge off below it.
let row_formal_scope: Array[Array[String]] = []

fn row_scope_unknown() -> String {
  "#unknown"
}

/// The expression the walk pushes BELOW a lambda body: it is popped once the
/// whole body has been walked, and closes that body's formal scope. The
/// spelling is not an identifier, so no source expression can be it.
fn row_scope_pop_marker() -> String {
  "#row-scope-pop"
}

fn row_scope_has(name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(row_formal_scope) && !found {
    if str_labels_contain(Array::get(row_formal_scope, i), name) {
      found = true
    }
    i = i + 1
  }
  found
}

/// A requirement's formal `'name`: bound by any enclosing binder.
fn row_scope_has_formal(name: String) -> Bool {
  row_scope_has(name) || row_scope_has(String::concat("@", name))
}

/// #3101: does scope entry `entry` belong to a generic binder -- one that
/// introduced type formals (`S`, or `@S` for a lambda inheriting its row)?
/// An entry holding only callback markers (`%f`) or `row_scope_unknown()` is
/// not one, and neither is a top-level declaration with no formals. The
/// checker opens a generic declaration exactly for these (`eq_group_begin`).
fn row_scope_entry_is_generic(entry: Array[String]) -> Bool {
  let mut found = false
  let mut j = 0
  while j < Array::length(entry) && !found {
    let w = Array::get(entry, j)
    if !String::starts_with(w, "%") && w != row_scope_unknown() {
      found = true
    }
    j = j + 1
  }
  found
}

/// #3101: the generic depth of scope entry `idx`: how many generic binders
/// enclose it. The checker qualifies a requirement's formal with the same
/// count (`eq_formal_depth`), so `S$0` and `S$1` are two binders' `S`.
fn row_scope_generic_depth_of(idx: Int) -> Int {
  let mut d = 0
  let mut i = 0
  while i < idx && i < Array::length(row_formal_scope) {
    if row_scope_entry_is_generic(Array::get(row_formal_scope, i)) {
      d = d + 1
    }
    i = i + 1
  }
  d
}

fn row_formal_at_depth(name: String, depth: Int) -> String {
  String::concat(name, String::concat("$", __to_string(depth)))
}

/// #3101: a declared word `name` that the lexical scope binds, qualified by
/// the INNERMOST binder of that spelling -- the one the word names where it
/// was written. Only a binder's own formals count; an `@name` entry (a lambda
/// inheriting the enclosing row) does not rebind the row's words.
fn row_declared_formal(name: String) -> String {
  let mut out = ""
  let mut i = Array::length(row_formal_scope) - 1
  while i >= 0 {
    if str_labels_contain(Array::get(row_formal_scope, i), name) {
      out = row_formal_at_depth(name, row_scope_generic_depth_of(i))
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  out
}

/// #3101: a requirement's formal word as the checker marked it: `'S$1` names
/// binder depth 1's `S`, and is returned as is. A formal the checker could not
/// qualify (`'Int`, a formal spelled like a builtin, has no variable) is
/// placed only when exactly ONE binder in scope has that spelling; with two,
/// which one it is cannot be told, and the answer is a spelling no declared
/// word resolves to, so it never matches a row by accident. "" when no binder
/// in scope has the spelling.
fn row_required_formal(word: String) -> String {
  let di = String::last_index_of(word, "$")
  let name = if di > 0 {
    String::substring(word, 0, di)
  } else {
    word
  }
  if !row_scope_has_formal(name) {
    ""
  } else if di > 0 {
    word
  } else {
    let mut count = 0
    let mut at = 0 - 1
    let mut i = 0
    while i < Array::length(row_formal_scope) {
      let entry = Array::get(row_formal_scope, i)
      if str_labels_contain(entry, name) || str_labels_contain(entry, String::concat("@", name)) {
        count = count + 1
        at = i
      }
      i = i + 1
    }
    if count == 1 {
      row_formal_at_depth(name, row_scope_generic_depth_of(at))
    } else {
      String::concat(name, "$ambiguous")
    }
  }
}

/// #3102 review: the first scope entry that can stand between a callback
/// parameter's annotation and its call -- one past the binder that declared
/// the parameter. A top-level declaration's parameters leave it at 1.
let row_callback_scope_start_cell: Array[Int] = [1]

/// The scope entry a lambda pushes names each callback parameter it declares
/// as `%name`, so a call can find the binder its annotation was written in.
fn row_scope_callback_marker(name: String) -> String {
  String::concat("%", name)
}

fn row_scope_callback_start(name: String) -> Int {
  let marker = row_scope_callback_marker(name)
  let mut start = 1
  let mut i = Array::length(row_formal_scope) - 1
  while i >= 1 {
    if str_labels_contain(Array::get(row_formal_scope, i), marker) {
      start = i + 1
      i = 0
    }
    i = i - 1
  }
  start
}

/// Does a binder nested inside the callback annotation's own binder bind
/// `name`? (The top-level declaration's own binder never does.)
fn row_scope_nested_binds(name: String) -> Bool {
  let mut found = false
  let mut i = Array::get(row_callback_scope_start_cell, 0)
  while i < Array::length(row_formal_scope) {
    let entry = Array::get(row_formal_scope, i)
    if str_labels_contain(entry, name) || str_labels_contain(entry, String::concat("@", name)) {
      found = true
    }
    i = i + 1
  }
  found
}

/// Does the declared-word scope hold only the top-level declaration's own
/// binder? Then every enclosing parameter annotation was written in it.
fn row_scope_decl_is_root() -> Bool {
  let mut ok = true
  let mut i = 1
  while i < Array::length(row_formal_scope) {
    let entry = Array::get(row_formal_scope, i)
    let mut j = 0
    while j < Array::length(entry) {
      let w = Array::get(entry, j)
      if !String::starts_with(w, "@") && !String::starts_with(w, "%") {
        ok = false
      }
      j = j + 1
    }
    i = i + 1
  }
  ok
}

fn row_scope_pop() -> Unit {
  if Array::length(row_formal_scope) > 0 {
    Array::truncate(row_formal_scope, Array::length(row_formal_scope) - 1)
  }
}

fn tparam_names(tparams: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(tparams) {
    Array::push(out, type_param_name(Array::get(tparams, i)))
    i = i + 1
  }
  out
}

/// #3095: the requirement being authorized, as its call instantiates it in
/// the marked spelling (`row_marked_type_text`), keyed by its printed
/// spelling. Set around the authorization of one callee label only; every
/// other requirement has none and is never judged by `row_label_args_differ`.
let requirement_marked_cell: Array[(String, String)] = [("", "")]

fn requirement_marked_for(eff_name: String) -> String {
  let (printed, marked) = Array::get(requirement_marked_cell, 0)
  if String::length(printed) > 0 && printed == eff_name {
    marked
  } else {
    ""
  }
}

fn builtin_row_type_name(w: String) -> Bool {
  w == "Int" || w == "String" || w == "Bool" || w == "Double" || w == "Char" || w == "Bytes" || w == "Unit" || w == "Array" || w == "Option"
}

/// A type in a row argument, as far as the judge can tell. `RtWild` may be any
/// type (a part the call left open), `RtIndet` is a part the judge must not
/// read (an alias, a name of unknown provenance), `RtFormal` a rigid formal in
/// scope, `RtHead` a builtin or nominal type constructor with its arguments.
enum RowTy {
  RtWild;
  RtIndet;
  RtFormal(String);
  RtHead(String, Array[RowTy]);
  RtTuple(Array[RowTy])
}

/// Split a row argument text (spaces removed) into words and `[ ] , ( )`;
/// a word keeps a leading `'` / `^` mark. None for any other character.
fn row_ty_tokens(t: String) -> Option[Array[String]] {
  let out = array_empty()
  let n = String::length(t)
  let mut ok = true
  let mut start = 0 - 1
  let mut i = 0
  while i <= n && ok {
    let c = if i < n {
      String::char_code_at(t, i)
    } else {
      0
    }
    let word = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 36 || c == 126
    let mark = c == 39 || c == 94
    if word || mark {
      if mark && start >= 0 {
        ok = false
      } else if start < 0 {
        start = i
      } else {
        ()
      }
    } else {
      if start >= 0 {
        Array::push(out, String::substring(t, start, i))
        start = 0 - 1
      } else {
        ()
      }
      if i < n {
        if c == 91 || c == 93 || c == 44 || c == 40 || c == 41 {
          Array::push(out, String::substring(t, i, i + 1))
        } else {
          ok = false
        }
      } else {
        ()
      }
    }
    i = i + 1
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// What one word names. `mode` 0 reads a declared row, whose words the
/// lexical scope resolves; 1 a requirement's marked spelling, where a mark says
/// where the word came from (`'S` a formal, `^Name` a type the checker
/// resolved, a bare word the callee's own row text); 2 a callback parameter's
/// row as written, which may have been written OUTSIDE a nested binder that
/// now stands between -- so a word any nested binder rebinds is not read.
fn row_word_class(w: String, mode: Int, nargs: Int) -> RowTy {
  let nominals = Array::get(row_nominal_types_cell, 0)
  if w == "_" {
    RtWild
  } else if mode == 2 {
    if row_scope_nested_binds(w) {
      RtIndet
    } else {
      row_word_class(w, 0, nargs)
    }
  } else if mode == 0 {
    if row_scope_has(w) {
      if nargs == 0 {
        RtFormal(row_declared_formal(w))
      } else {
        RtIndet
      }
    } else if builtin_row_type_name(w) || str_labels_contain(nominals, w) {
      RtHead(w, [])
    } else {
      RtIndet
    }
  } else if String::starts_with(w, "'") {
    let f = row_required_formal(String::substring(w, 1, String::length(w)))
    if nargs == 0 && String::length(f) > 0 {
      RtFormal(f)
    } else {
      RtIndet
    }
  } else if String::starts_with(w, "^") {
    let h = String::substring(w, 1, String::length(w))
    if builtin_row_type_name(h) || (str_labels_contain(nominals, h) && !row_scope_has_formal(h)) {
      RtHead(h, [])
    } else {
      RtIndet
    }
  } else if builtin_row_type_name(w) && !row_scope_has(w) && !str_labels_contain(Array::get(shadowed_builtin_type_names_cell, 0), w) {
    // A word the callee's own row spells: only a builtin name is certain.
    RtHead(w, [])
  } else {
    RtIndet
  }
}

/// Parse one type starting at token `i`; returns it and the next index, or
/// index -1 on a malformed spelling.
fn row_ty_parse(toks: Array[String], i: Int, mode: Int) -> (RowTy, Int) {
  if i >= Array::length(toks) {
    (RtIndet, 0 - 1)
  } else {
    let tok = Array::get(toks, i)
    if tok == "(" {
      let (items, next) = row_ty_parse_list(toks, i + 1, ")", mode)
      if next < 0 {
        (RtIndet, 0 - 1)
      } else if Array::length(items) == 0 {
        (RtHead("Unit", []), next)
      } else if Array::length(items) == 1 {
        (Array::get(items, 0), next)
      } else {
        (RtTuple(items), next)
      }
    } else if tok == "[" || tok == "]" || tok == "," || tok == ")" {
      (RtIndet, 0 - 1)
    } else {
      let has_args = i + 1 < Array::length(toks) && Array::get(toks, i + 1) == "["
      let (args, next) = if has_args {
        row_ty_parse_list(toks, i + 2, "]", mode)
      } else {
        (array_empty(), i + 1)
      }
      if next < 0 {
        (RtIndet, 0 - 1)
      } else {
        match row_word_class(tok, mode, Array::length(args)) {
          RtHead(h, _) => (RtHead(h, args), next),
          other => (other, next)
        }
      }
    }
  }
}

/// Comma-separated types up to the closing token `close`; returns the items
/// and the index after `close`, or -1.
fn row_ty_parse_list(toks: Array[String], start: Int, close: String, mode: Int) -> (Array[RowTy], Int) {
  let items = array_empty()
  if start < Array::length(toks) && Array::get(toks, start) == close {
    (items, start + 1)
  } else {
    let mut i = start
    let mut done = false
    while !done {
      let (t, next) = row_ty_parse(toks, i, mode)
      if next < 0 || next >= Array::length(toks) {
        i = 0 - 1
        done = true
      } else {
        Array::push(items, t)
        let sep = Array::get(toks, next)
        if sep == close {
          i = next + 1
          done = true
        } else if sep == "," {
          i = next + 1
        } else {
          i = 0 - 1
          done = true
        }
      }
    }
    (items, i)
  }
}

/// A label's argument list (`State[A, B]` -> [A, B]); None when it has no
/// brackets or does not parse.
fn row_label_arg_tys(label: String, mode: Int) -> Option[Array[RowTy]] {
  let args = row_label_args(label)
  if String::length(args) == 0 {
    None
  } else {
    match row_ty_tokens(args) {
      Some(toks) => {
        // Read the list as if closed by a `]`, which must be the last token.
        Array::push(toks, "]")
        let (items, next) = row_ty_parse_list(toks, 0, "]", mode)
        if next == Array::length(toks) {
          Some(items)
        } else {
          None
        }
      },
      None => None
    }
  }
}

/// Do two judged types CERTAINLY name different types? Only parts both sides
/// determine are compared; an open or unreadable part never differs.
fn row_tys_differ(a: RowTy, b: RowTy) -> Bool {
  match (a, b) {
    (RtWild, _) => false,
    (_, RtWild) => false,
    (RtIndet, _) => false,
    (_, RtIndet) => false,
    (RtFormal(x), RtFormal(y)) => x != y,
    (RtFormal(_), _) => true,
    (_, RtFormal(_)) => true,
    (RtHead(x, xs), RtHead(y, ys)) => if x != y {
      true
    } else if Array::length(xs) != Array::length(ys) {
      false
    } else {
      row_ty_lists_differ(xs, ys)
    },
    (RtTuple(xs), RtTuple(ys)) => if Array::length(xs) != Array::length(ys) {
      true
    } else {
      row_ty_lists_differ(xs, ys)
    },
    (RtHead(_, _), RtTuple(_)) => true,
    (RtTuple(_), RtHead(_, _)) => true
  }
}

fn row_ty_lists_differ(xs: Array[RowTy], ys: Array[RowTy]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && i < Array::length(ys) && !found {
    if row_tys_differ(Array::get(xs, i), Array::get(ys, i)) {
      found = true
    }
    i = i + 1
  }
  found
}

/// #3095: does the declared label `declared` certainly NOT cover the
/// requirement whose marked spelling is `marked`? Both name the same effect;
/// the question is whether their arguments name different types. A rigid
/// formal differs from every other formal and every concrete type, a
/// nominal or builtin head from every other head -- so `with State[S]` does
/// not cover `State[Box[S]]`, nor `with State[N]` for a lambda's own `[N]`
/// cover `State[String]` -- while an alias, a part the call left open, or a
/// word whose meaning the pass cannot place never makes a row refuse.
///
/// A requirement spelled `=Label` is a callback parameter's row as written:
/// its words were written where the parameter was declared, so it is read
/// like a declared row, except for a word a nested binder rebinds (mode 2).
fn row_label_args_differ(declared: String, marked: String) -> Bool {
  if row_scope_has(row_scope_unknown()) || String::length(marked) == 0 {
    false
  } else if String::starts_with(marked, "=") {
    match (row_label_arg_tys(declared, 0), row_label_arg_tys(String::substring(marked, 1, String::length(marked)), 2)) {
      (Some(ds), Some(ms)) => Array::length(ds) == Array::length(ms) && row_ty_lists_differ(ds, ms),
      _ => false
    }
  } else {
    match (row_label_arg_tys(declared, 0), row_label_arg_tys(marked, 1)) {
      (Some(ds), Some(ms)) => Array::length(ds) == Array::length(ms) && row_ty_lists_differ(ds, ms),
      _ => false
    }
  }
}

fn str_labels_contain(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && !found {
    if Array::get(xs, i) == x {
      found = true
    }
    i = i + 1
  }
  found
}

/// Is `t` (spaces already removed) built only from builtin type names,
/// `Array[..]` / `Option[..]` and commas?
fn builtin_closed_type_text(t: String) -> Bool {
  let n = String::length(t)
  let mut ok = n > 0
  let mut start = 0 - 1
  let mut i = 0
  while i <= n && ok {
    let c = if i < n {
      String::char_code_at(t, i)
    } else {
      0
    }
    let is_letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
    if is_letter {
      if start < 0 {
        start = i
      } else {
        ()
      }
    } else {
      if start >= 0 {
        let w = String::substring(t, start, i)
        if w != "Int" && w != "String" && w != "Bool" && w != "Double" && w != "Char" && w != "Bytes" && w != "Unit" && w != "Array" && w != "Option" || str_labels_contain(Array::get(shadowed_builtin_type_names_cell, 0), w) {
          ok = false
        } else {
          ()
        }
        start = 0 - 1
      } else {
        ()
      }
      if i < n && c != 91 && c != 93 && c != 44 {
        ok = false
      } else {
        ()
      }
    }
    i = i + 1
  }
  ok
}

/// #1340: base-aware membership — true when some declared label and the
/// required name share a base AND at least one side actually carries a
/// bracket (so this never fires for pre-#1340 rows, where the exact check
/// above already decided).
fn row_base_membership(labels: Array[String], eff_name: String) -> Bool {
  // ADR-0085 (#1344): the exception effect opts OUT of base-name equivalence.
  // Every other generic effect treats `E[A]` and `E[B]` as interchangeable
  // (#1340 v1), but `Exception[E]`'s whole point is that they are not, and
  // this predicate would otherwise re-admit exactly what decl_authorizes_
  // effect's kind check just rejected -- via the OPERATION spelling
  // (`Exception[IoError]::Throw` strips to base `Exception`), which the
  // bare-effect arm above never sees. Bracketless exception labels were
  // already outside this rule (it fires only when one side has a bracket), so
  // pre-#1344 rows are unchanged.
  if is_exception_label(eff_name) {
    false
  } else {
    let eb = row_label_base(eff_name)
    let ehas = String::length(eb) < String::length(eff_name)
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      let l = Array::get(labels, i)
      let lb = row_label_base(l)
      let lhas = String::length(lb) < String::length(l)
      if (ehas || lhas) && lb == eb && !is_exception_label(l) && !row_label_args_closed_and_differ(l, eff_name) && !row_label_args_differ(l, requirement_marked_for(eff_name)) && !row_label_args_ambiguous(eff_name) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// #1460 is merging `Stdin` / `Stdout` / `Stderr` into one `Console`
/// capability, and until that lands both spellings have to work. The merge
/// direction is what makes this CONTAINMENT rather than the alias equality
/// `exception_effect_labels_equal` uses for `Error` / `Exception`: measured on
/// the registry, `Console` owns six operations (`read_stream`, `read_char`,
/// `write_stream`, `write_char`, `write_err_stream`, `write_err_char`) while
/// the legacy three own three, two and two of them.
///
/// So a declared `Console` authorizes a legacy label, and the reverse is
/// deliberately ABSENT. Letting `with Stdout` authorize a `Console` operation
/// would hand a write-only program `Console::read_stream` -- the capability
/// escape class #2107/#2108 closed, reintroduced through a migration alias.
/// The negative case is pinned in `console_migration_row_test.vibe`.
///
/// One coverage gap this does not paper over: `Stdin::read_via_stream`
/// (#1539's StdinStream) has no `Console::` counterpart, so `Console` is not
/// yet a complete replacement for `Stdin` at the operation level. That is
/// #1460's problem to close, not this predicate's to hide.
///
/// Which providers are legacy is policy metadata and lives with the provider
/// table (`is_legacy_console_provider`, #1963); the containment direction is
/// the checker's.
fn console_authorizes_legacy(labels: Array[String], eff_name: String) -> Bool {
  is_legacy_console_provider(eff_name) && effect_row_has_label(Some(labels), "Console")
}

/// #2985 review (Codex P0): the pseudo-label a handle with a KINDED exception
/// arm adds to its body's declared row. It never comes from source (rows
/// cannot spell `#`), and it makes decl_authorizes_effect strict for the
/// exception family and make_contextual_row_error name the catch-all rule.
fn kinded_handle_marker() -> String {
  "#kinded-handle"
}

/// Is this declared row the BODY of a handle with a kinded exception arm?
/// (Carries the marker; see kinded_handle_marker.) There the erased
/// exception exemption of the direct and transitive disciplines is off.
fn under_kinded_handle(labels: Array[String]) -> Bool {
  effect_row_has_label(Some(labels), kinded_handle_marker())
}

/// The exception EFFECT labels (`Exception`, `Exception[K]`; not the `::Throw`
/// operation spellings) among a handle's discharged effect names.
fn exception_effect_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) && String::index_of(l, "::") < 0 {
      Array::push(out, l)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The declared row a call ARGUMENT is walked under. Under a kinded handle
/// a closure literal passed straight to a callee is walked under the row the
/// callee's PARAMETER declares for it, as far as exceptions go:
///
/// - a parameter row admitting the erased `Exception` (`TaskGroup::spawn`'s
///   `() -> T with Exception + e`, `Parallel::map`'s `(T) -> U with Exception
///   + e`) takes any kind, so the literal is walked the ordinary gradual way
///   (marker dropped, erased label restored); what comes back OUT of the call
///   is the callee's own declared row, which the transitive check charges to
///   the strict body like any other call (`Exception[TaskError]` passes an
///   `Exception[TaskError]` arm, an erased `with Exception` is refused);
/// - a parameter row naming kinds (`f: () -> Int with Exception[K]`) lets the
///   literal throw exactly those kinds, still strictly -- the callee's own
///   arm for `K` catches everything the literal raises;
/// - a parameter row with no exception label (`f: () -> Int with e`) absorbs
///   nothing: whatever the literal throws rides the row variable back into
///   the body, so the literal stays as strict as the body.
///
/// A callee this pass cannot see -- a callback parameter (its parameter rows
/// are not in the overlay), a builtin, a field or call result -- keeps the
/// literal as strict as the body.
///
/// #2985 review (Codex P0, second round): the first version relaxed EVERY
/// literal argument. An unannotated literal handed to
/// `invoke[e](f: () -> Int with e) -> Int with e` throws straight back into
/// the enclosing body through `e`, and the row-variable instantiation bails
/// on such a literal (its row IS the lexical charge the relaxation dropped),
/// so `throw(7)` in it reached an `Exception[String]` arm and read as a
/// String (`14`). The parameter's row decides now, not the argument's shape.
/// What this deliberately trusts is the callee's DECLARED row: a helper
/// declared `with Exception[String]` whose body calls a `with Exception`
/// callback is accepted at its own definition by the gradual rule and so
/// can raise a kind it does not declare -- a definition-site hole reachable
/// through a named or an annotated argument as well, filed separately.
fn closure_arg_declared(arg: Expr, declared: Array[String], callee: String, lexical_callee: Option[Array[String]], index: Int) -> Array[String] {
  match arg {
    EFn(_, _, _, _, _, _) => if !under_kinded_handle(declared) {
      // #3013: outside a kinded handle the literal inherited the ENCLOSING row,
      // so `takes_int(() -> Int { throw("hello") })` inside a function declaring
      // `Exception[String]` passed although `takes_int`'s parameter declares
      // `Exception[Int]` -- the String landed in `takes_int`'s `Int` arm. A
      // named argument is refused for this by the type checker. When the
      // parameter's row names exception KINDS, those kinds are what the
      // literal's body may throw; every other label still comes from the
      // enclosing row, as before.
      match lexical_callee {
        Some(_) => declared,
        None => match MutMap::get(Array::get(callee_sig_index, 0), callee) {
          None => declared,
          Some(si) => {
            let prows = Array::get(callee_sig_param_effs, si)
            if index >= Array::length(prows) {
              declared
            } else {
              let prow = Array::get(prows, index)
              let kinds = exception_effect_labels(prow)
              if !row_has_erased_exception(prow) && Array::length(kinds) > 0 {
                labels_union(labels_union(labels_without_exception_family(declared), [
                  kinded_handle_marker()
                ]), kinds)
              } else {
                declared
              }
            }
          }
        }
      }
    } else {
      match lexical_callee {
        Some(_) => declared,
        None => match MutMap::get(Array::get(callee_sig_index, 0), callee) {
          None => declared,
          Some(si) => {
            let prows = Array::get(callee_sig_param_effs, si)
            if index >= Array::length(prows) {
              declared
            } else {
              let prow = Array::get(prows, index)
              if row_has_erased_exception(prow) {
                labels_union(labels_without_exception_family_marker(declared), [
                  "Exception"
                ])
              } else {
                let kinds = exception_effect_labels(prow)
                if Array::length(kinds) > 0 {
                  labels_union(labels_union(labels_without_exception_family(declared), [
                    kinded_handle_marker()
                  ]), kinds)
                } else {
                  declared
                }
              }
            }
          }
        }
      }
    },
    _ => declared
  }
}

/// #2964 / #3015: does the row name exception kinds and no erased
/// `Exception` label?
fn row_is_kinded_exception_only(labels: Array[String]) -> Bool {
  !row_has_erased_exception(labels) && Array::length(exception_effect_labels(labels)) > 0
}

/// Does a row carry the ERASED exception effect (`Exception` /
/// `Exception::Throw`, kind empty), the spelling that admits every kind?
fn row_has_erased_exception(labels: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) && String::length(exception_label_kind(l)) == 0 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The kinded exception labels (`Exception[K]`, kind non-empty) among a
/// handle's discharged effect names.
fn kinded_exception_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) && String::length(exception_label_kind(l)) > 0 && String::index_of(l, "::") < 0 {
      Array::push(out, l)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `labels` without the exception family and without the kinded-handle
/// marker: what an enclosing row still authorizes inside a kinded handle
/// (everything but exceptions, which the handle now owns).
fn labels_without_exception_family(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) || l == kinded_handle_marker() {
      ()
    } else {
      Array::push(out, l)
    }
    i = i + 1
  }
  out
}

fn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {
  // All concrete label checks, including Async above, go through this same
  // exact-membership primitive rather than substring matching.
  if authority_is_optional(eff_name) {
    // ADR-0088 graded subset: an OPTIONAL requirement (`with Fs::read_file?`
    // on a callee) is satisfied by an optional grant that covers the
    // operation -- the operation itself, or its whole provider (`allows
    // Fs?`: the grade is stripped and the provider-to-operation containment
    // of `decl_authorizes_op` is re-applied, Codex review on PR #2653) --
    // or by the required grade of either, Required being the join. The
    // reverse (an optional grant for a required call) is the plain-label case
    // below, where the `?` label never matches, and `optional_grant_for`
    // names the edit.
    let core = strip_authority_grade(eff_name)
    decl_authorizes_optional_op(labels, core) || decl_authorizes_op(labels, core)
  } else if effect_row_has_label(Some(labels), eff_name) && !row_label_args_differ(eff_name, requirement_marked_for(eff_name)) {
    // #3095: the same spelling can still name two types -- `with State[Int]`
    // inside a lambda binding `[Int]` names its formal, while `get(5)`
    // requires the builtin.
    true
  } else if console_authorizes_legacy(labels, eff_name) {
    true
  } else if is_exception_effect_name(eff_name) {
    // ADR-0085 Phase 3 (#1344): the exception effect is authorized by KIND.
    // This arm now runs BEFORE row_base_membership below, because that rule
    // compares generic row items by their base name (the
    // instantiation-insensitive #1340 v1, where `State[Int]` and
    // `State[String]` are interchangeable) -- reaching it would let
    // `with Exception[ParseError]` authorize an `IoError` throw and erase
    // the one guarantee typed exceptions exist to give. For BRACKETLESS rows
    // the reorder is inert: the old order could only have matched here when
    // some declared label already shared the base `Error`, which the exact
    // check above decided.
    let required_kind = exception_label_kind(eff_name)
    // #2985 review (Codex P0): inside a handle with a KINDED arm the erased
    // gradual rule is off -- the arm catches every exception at run time, so
    // only a requirement of exactly its kind is authorized; an unresolved
    // kind ("") is not, and neither is another kind (the outer row's
    // exception labels were stripped for the body, see the EHandle arm).
    // #2964 / #3015: a row that declares ONLY kinded exception labels is a
    // promise about which kinds leave the function, so it is strict too. The
    // gradual rule admitted an unresolved requirement against it -- a `throw`
    // of a pattern binder or a field, a callback typed `with Exception`, a
    // callee declared `with Exception` -- and the function then raised a kind
    // it does not declare. The erased spelling `with Exception` stays gradual.
    let strict = effect_row_has_label(Some(labels), kinded_handle_marker()) || row_is_kinded_exception_only(labels)
    let mut alias_found = false
    let mut alias_i = 0
    while alias_i < Array::length(labels) {
      let declared_label = Array::get(labels, alias_i)
      let declared_kind = exception_label_kind(declared_label)
      let covers = if strict {
        String::length(required_kind) > 0 && String::length(declared_kind) > 0 && exception_kinds_same(declared_kind, required_kind)
      } else {
        exception_kinds_compatible(declared_kind, required_kind)
      }
      if is_exception_label(declared_label) && covers {
        alias_found = true
      }
      alias_i = alias_i + 1
    }
    alias_found
  } else if row_base_membership(labels, eff_name) {
    true
  } else {
    let mut i = 0
    let mut has_effect_var = false
    while i < Array::length(labels) {
      if label_is_effect_var(Array::get(labels, i)) {
        has_effect_var = true
      }
      i = i + 1
    }
    has_effect_var
  }
}

/// A DIRECT `perform EffName::Op` is authorized if the declared row names
/// either the whole effect (`EffName`) or, per ADR-0071's operation-level row
/// items, the exact operation (`EffName::Op`) itself -- e.g. `with Ask::Get`
/// must authorize a bare `perform Ask::Get` in the same function, exactly as
/// it already authorizes a transitive call to a callee declaring the same
/// item (that check compares the full qualified label directly, without
/// stripping to the base effect name).
fn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {
  if decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name) {
    true
  } else {
    // #2985 review (Codex P0): under a kinded handle the erased-compatible
    // equality is off here too -- this branch is the one that admitted an
    // erased `Exception::Throw` requirement against an `Exception[String]`
    // arm after decl_authorizes_effect had already refused it.
    let strict = under_kinded_handle(labels) || row_is_kinded_exception_only(labels)
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      let lab = Array::get(labels, i)
      let equal = if strict {
        is_exception_label(lab) && is_exception_label(op_name) && String::length(exception_label_kind(op_name)) > 0 && String::length(exception_label_kind(lab)) > 0 && exception_kinds_same(exception_label_kind(lab), exception_label_kind(op_name))
      } else {
        exception_effect_labels_equal(lab, op_name)
      }
      // #3095: equal spellings, as in `decl_authorizes_effect`, can name two
      // types.
      if equal && !row_label_args_differ(lab, requirement_marked_for(op_name)) {
        found = true
      }
      i = i + 1
    }
    found
  }
}

/// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the
/// segment before `::`.
fn effect_name_of_op(op_name: String) -> String {
  let idx = String::index_of(op_name, "::")
  if idx > 0 {
    canonical_exception_effect_name(op_name[0: idx])
  } else {
    canonical_exception_effect_name(op_name)
  }
}

// ADR-0085 Phase 3 (#1344): the exception KIND of a `throw` payload.
//
// `throw(v)` requires `Exception[typeof(v)]`. This pass runs AFTER type
// checking but is itself untyped -- it walks the AST with the module's row
// table, not a Subst -- so the payload's static type is recovered from the
// checked top-level ENV instead of re-inferring it, via a flat table built
// once per module (throw_kind_cell below).
//
// What that resolves, and what it does not:
//
//   throw("boom")                 -> String       literal
//   throw(NotFound("cfg"))        -> IoError      constructor application
//   throw(Eof)                    -> ParseError   nullary constructor
//   throw(make_err(x))            -> whatever `make_err` returns
//   throw(Wrapped { .. })         -> Wrapped      struct literal
//   throw(e)  // e: IoError       -> IoError      annotated parameter
//   throw(e)  // let e = Eof      -> ParseError   local binder (see below)
//   throw(r.cause)                -> ""           unresolved
//
// An unresolved payload yields kind "", which exception_kinds_compatible
// treats as compatible with every declared exception label -- so this can
// never invent an error out of the gap, only miss one.
//
// LOCAL binders (the #1344 follow-up, and the shape #1324's migration mostly
// produces -- `let e = ...; Err(e)` becoming `let e = ...; throw(e)`) are
// resolved by threading a scope of `(name, kind)` pairs through the walk,
// exactly the way ov_names/ov_effs already ride it. The scope is built from
// binder syntax alone: a `let` takes its initializer's kind (recursively, so
// `let e = make_err(x)` resolves through the module table), and every other
// binder form -- patterns, `for`, `loop`, un-annotated parameters, `let rec`
// -- binds the name with kind "".
//
// Binding the unresolvable ones EXPLICITLY, rather than leaving them out, is
// what keeps the "never invents an error" property: lookup falls back to the
// module table when a name is absent, so an omitted local would let a
// same-named TOP-LEVEL binding answer for it. (That was a real, if narrow,
// pre-existing hole: before this scope existed, a local `let e = "boom"` in a
// module that also defines a top-level `e: IoError` reported the top-level
// kind.)
//
// The whole refinement is provably additive for existing code: a declared row
// either carries an ERASED exception label (`Error` / `Exception`), which is
// kind-compatible with everything, or carries no exception label at all, in
// which case the throw was already rejected with the identical message. Only a
// row that opts into `Exception[K]` -- a spelling nothing in the codebase uses
// -- can newly fail.

/// The exception-kind name of a checked type: the head name of a nominal type,
/// and "" for anything structural or still-unresolved (a type variable, a
/// function, a tuple). Kinds are compared by NAME because the row label is a
/// string; a structural payload therefore has no kind and stays gradual.
fn type_kind_name(t: Type) -> String {
  match t {
    CtString => "String",
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtChar => "Char",
    CtBytes => "Bytes",
    CtEnum(n) => n,
    CtStruct(n) => n,
    CtNamed(n, _) => n,
    _ => ""
  }
}

/// (name, kind-as-a-value, kind-of-its-result) for every top-level binding.
/// Both columns are needed because a `throw` payload names a binding in two
/// different positions: `throw(Eof)` wants the binding's own type, while
/// `throw(NotFound("x"))` wants the RESULT type of the constructor it applies.
let throw_kind_cell: Array[(String, String, String)] = array_empty()

/// #2386: name -> first slot of `throw_kind_cell`, rebuilt with the table.
/// `throw_kind_lookup` scanned the table -- every kinded binding of the env
/// -- per throw site; the first pushed entry (the innermost binding) wins,
/// which is what the scan answered.
let throw_kind_index: Array[MutMap[String, Int]] = [MutMap::new_string()]

fn throw_kind_push(name: String, ty: Type) -> Unit {
  let fnty = match ty {
    CtForAll(_, _, body) => body,
    _ => ty
  }
  let value_kind = type_kind_name(fnty)
  let result_kind = match fnty {
    CtFn(_, ret, _) => type_kind_name(ret),
    _ => ""
  }
  if String::length(value_kind) > 0 || String::length(result_kind) > 0 {
    let index = Array::get(throw_kind_index, 0)
    if MutMap::has(index, name) {
      ()
    } else {
      MutMap::set(index, name, Array::length(throw_kind_cell))
    }
    Array::push(throw_kind_cell, (name, value_kind, result_kind))
  } else {
    ()
  }
}

/// Rebuild the payload-kind table from the checked top-level env. Called at
/// every public entry of this pass -- including the ones with no env, which
/// therefore CLEAR it -- so a table can never survive into the next module and
/// misclassify a same-named binding there.
fn set_throw_kind_table(env: TypeEnv) -> Unit {
  Array::truncate(throw_kind_cell, 0)
  Array::set(throw_kind_index, 0, MutMap::new_string())
  let mut cur = env
  let mut looping = true
  while looping {
    match cur {
      EnvBind(name, binding, rest) => {
        throw_kind_push(name, binding.ty)
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(cnames, ctypes, rest) => {
        // Unlike seed_env_fn_effs above, the cached parallel arrays must be
        // READ, not skipped: `collect_all_diagnostics` (the `vibe diagnostics`
        // / LSP lane) hands this pass an env whose bindings have all been
        // folded into one EnvCached, so skipping it left every payload kind
        // unresolved on exactly that lane while the file-compile lane
        // resolved them -- the same program diagnosed differently depending
        // on which entry point asked.
        let mut ci = 0
        while ci < env_name_index_length(cnames) && ci < Array::length(ctypes) {
          throw_kind_push(env_name_index_at(cnames, ci), Array::get(ctypes, ci).ty)
          ci = ci + 1
        }
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(entries) => {
        let mut ei = 0
        while ei < Array::length(entries) {
          let (ename, binding) = Array::get(entries, ei)
          throw_kind_push(ename, binding.ty)
          ei = ei + 1
        }
        looping = false
      },
      EnvEmpty => {
        looping = false
      }
    }
  }
}

/// `want_result`: look up the binding's RESULT kind (it is being applied)
/// rather than its own. First match wins, matching the env's own innermost-
/// first order.
fn throw_kind_lookup(name: String, want_result: Bool) -> String {
  match MutMap::get(Array::get(throw_kind_index, 0), name) {
    Some(i) => {
      let (_, value_kind, result_kind) = Array::get(throw_kind_cell, i)
      if want_result {
        result_kind
      } else {
        value_kind
      }
    },
    None => ""
  }
}

/// The LOCAL exception-kind scope: `(name, kind)` innermost-first, first match
/// wins, threaded through the perform walk like ov_names/ov_effs. An empty
/// `kind` is a real entry meaning "in scope, unresolvable" -- see the header
/// comment for why that must shadow the module table rather than fall through
/// to it.
///
/// A cons list rather than an `Array`: every binder used to copy the whole
/// array to put itself in front, so a body's walk cost bytes quadratic in its
/// binder count (~16 MB of the self-compile heap).
enum TkEnv {
  TkNil;
  TkBind(String, String, TkEnv)
}

fn no_kind_binds() -> TkEnv {
  TkNil
}

/// The innermost binding of `name`, if any.
fn tk_lookup(binds: TkEnv, name: String) -> Option[String] {
  let mut cur = binds
  let mut found = None
  let mut looking = true
  while looking {
    match cur {
      TkBind(n, kind, rest) => if n == name {
        found = Some(kind)
        looking = false
      } else {
        cur = rest
      },
      TkNil => looking = false
    }
  }
  found
}

fn throw_kind_bind(binds: TkEnv, name: String, kind: String) -> TkEnv {
  TkBind(name, kind, binds)
}

/// Every name a pattern binds enters scope unresolvable: this pass is untyped,
/// so it cannot tell what `Err(e)` destructures `e` to.
fn throw_kind_bind_pat(binds: TkEnv, pat: Pat) -> TkEnv {
  let names = no_str_labels()
  collect_pat_binds_into(pat, names)
  let mut cur = binds
  let mut i = 0
  while i < Array::length(names) {
    cur = throw_kind_bind(cur, Array::get(names, i), "")
    i = i + 1
  }
  cur
}

/// A parameter's kind comes from its whole ANNOTATION (`e: IoError`,
/// `xs: Array[Int]`). Un-annotated parameters bind unresolvable -- their type
/// exists only in the inference substitution this pass does not carry.
fn throw_kind_bind_params(binds: TkEnv, params: Array[(String, Option[TypeExpr])]) -> TkEnv {
  let mut cur = binds
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let kind = match ptype {
      Some(te) => throw_kind_of_texpr(te),
      None => ""
    }
    cur = throw_kind_bind(cur, pname, kind)
    i = i + 1
  }
  cur
}

/// The kind an annotation names, spelled the way a kinded row writes it:
/// `Array[Int]`, not the head `Array` -- a row `Exception[Array[Int]]` is not
/// satisfied by `Exception[Array]` (#3022 review). A function, tuple or unit
/// type has no row spelling here and stays unresolved ("").
fn throw_kind_of_texpr(te: TypeExpr) -> String {
  match te {
    TyName(n) => n,
    TyApp(n, args) => {
      let parts = array_empty()
      let mut ok = true
      let mut i = 0
      while i < Array::length(args) {
        let a = throw_kind_of_texpr(Array::get(args, i))
        if String::length(a) == 0 {
          ok = false
        }
        Array::push(parts, a)
        i = i + 1
      }
      if ok {
        String::concat(n, String::concat("[", String::concat(String::join(parts, ", "), "]")))
      } else {
        ""
      }
    },
    _ => ""
  }
}

/// #2964: the result kind of a callee the module table does not list -- a
/// String builtin (an interpolation lowers to `String::concat`), or a QUALIFIED
/// constructor `Type::Variant`, whose kind is the type it names. A qualified
/// name whose last segment is lower-case is a function and stays unresolved.
fn throw_kind_of_unlisted_callee(f: String) -> String {
  if f == "String::concat" || f == "__to_string" || f == "Int::to_string" || f == "Double::to_string" || f == "String::substring" || f == "String::join" || f == "String::trim" || f == "String::from_char_code" {
    "String"
  } else {
    let sep = String::last_index_of(f, "::")
    if sep > 0 && sep + 2 < String::length(f) {
      let first = String::char_code_at(f, sep + 2)
      if first >= 65 && first <= 90 {
        String::substring(f, 0, sep)
      } else {
        ""
      }
    } else {
      ""
    }
  }
}

/// The exception kind of a `throw` payload expression, or "" when this pass
/// cannot resolve it (see the header comment above for the exact coverage).
fn throw_payload_kind(payload: Expr, binds: TkEnv) -> String {
  match payload {
    EString(_, _) => "String",
    EStringInterp(_) => "String",
    EInt(_) => "Int",
    EFloat(_) => "Double",
    EBool(_) => "Bool",
    // A struct literal names its own type. Anonymous records carry "" here and
    // stay gradual.
    ERecord(sname, _, _) => sname,
    EIdent(n, _) => match tk_lookup(binds, n) {
      Some(k) => k,
      None => throw_kind_lookup(n, false)
    },
    // #2964: an array literal's kind is `Array[<its first element's kind>]`,
    // the spelling a kinded row writes (`Exception[Array[Int]]`).
    EArray(items) => if Array::length(items) > 0 {
      let ek = throw_payload_kind(Array::get(items, 0), binds)
      if String::length(ek) > 0 {
        String::concat("Array[", String::concat(ek, "]"))
      } else {
        ""
      }
    } else {
      ""
    },
    // #2964: `Some(v)` is `Option[<v's kind>]`, the spelling a kinded row
    // writes (`Exception[Option[T]]`).
    ECall(EIdent("Some", _), sargs, _) => if Array::length(sargs) == 1 {
      let sk = throw_payload_kind(Array::get(sargs, 0), binds)
      if String::length(sk) > 0 {
        String::concat("Option[", String::concat(sk, "]"))
      } else {
        ""
      }
    } else {
      ""
    },
    ECall(callee, _, _) => match callee {
      // A LOCAL of this name is being APPLIED. The scope tracks a local's VALUE
      // kind, never the kind of its RESULT, so the call is unresolvable -- and
      // it must not fall through to the module table, whose same-named
      // top-level function this local shadows.
      EIdent(f, _) => match tk_lookup(binds, f) {
        Some(_) => "",
        None => {
          let from_table = throw_kind_lookup(f, true)
          if String::length(from_table) > 0 {
            from_table
          } else {
            throw_kind_of_unlisted_callee(f)
          }
        }
      },
      // #2964: a type ascription -- the parser spells `let e: K = v` as
      // `((__asc: K) -> __asc)(v)` -- names its kind, which is the edit the
      // unresolved-kind refusal tells the reader to make.
      // Only the parser's own ascription wrapper -- the reserved `__asc`
      // parameter returned unchanged -- names the payload's kind. Any other
      // immediately-applied one-parameter lambda (`((x: String) -> Int { 1 })("s")`)
      // annotates its ARGUMENT, not its result, and is left to the checker's
      // inferred type (#3022 review).
      EFn(_, _, aps, _, _, abody) => if Array::length(aps) == 1 {
        match Array::get(aps, 0) {
          (pname, Some(te)) => match abody {
            EIdent(bname, _) => if pname == "__asc" && bname == "__asc" {
              throw_kind_of_texpr(te)
            } else {
              ""
            },
            _ => ""
          },
          _ => ""
        }
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// #3017: the key a `throw` site is recorded under by the checker and looked up
/// under here -- the `perform` call's offset plus a short spelling of the
/// payload, so two throws sharing an offset (sources merged from different
/// files, a desugar that copies an offset) rarely share a key; when they do and
/// their kinds differ, `set_throw_site_kinds` drops the key.
export fn throw_payload_site_key(off: Int, payload: Expr) -> String {
  let tag = match payload {
    EIdent(n, _) => n,
    ECall(EIdent(f, _), _, _) => String::concat(f, "()"),
    EDot(_, fname, _, _) => String::concat(".", fname),
    _ => ""
  }
  String::concat(__to_string(off), String::concat(":", tag))
}

/// #3017: the checker's inferred kind per throw site (see
/// `throw_payload_site_key`). Filled once per check before the effects walk,
/// and consulted only when the payload's syntax does not name a kind. A key
/// recorded with two different kinds maps to "" (unresolved), so a collision
/// can only keep a refusal, never admit a wrong kind.
let throw_site_kind_cell: Array[MutMap[String, String]] = [MutMap::new_string()]

export fn set_throw_site_kinds(sites: Array[(String, String)]) -> Unit {
  let m = MutMap::new_string()
  let mut i = 0
  while i < Array::length(sites) {
    let (k, kind) = Array::get(sites, i)
    match MutMap::get(m, k) {
      Some(prev) => if prev != kind {
        MutMap::set(m, k, "")
      },
      None => MutMap::set(m, k, kind)
    }
    i = i + 1
  }
  Array::set(throw_site_kind_cell, 0, m)
}

/// #3053: a generic callee's formal bindings at each call, keyed by the
/// callee identifier's offset (`callee_formal_bindings`). Filled once per
/// check before the effects walk. A key seen with two different bindings maps
/// to none, so a collision leaves the row as written (open) and can only keep
/// the old answer, never invent a binding.
let call_formal_bindings_cell: Array[MutMap[String, Array[(String, String)]]] = [
  MutMap::new_string()
]

export fn set_call_formal_bindings(rows: Array[(String, Array[(String, String)])]) -> Unit {
  let m = MutMap::new_string()
  let mut i = 0
  while i < Array::length(rows) {
    let (k, binds) = Array::get(rows, i)
    match MutMap::get(m, k) {
      Some(prev) => if !formal_bindings_same(prev, binds) {
        MutMap::set(m, k, ambiguous_formal_bindings(prev, binds))
      },
      None => MutMap::set(m, k, binds)
    }
    i = i + 1
  }
  Array::set(call_formal_bindings_cell, 0, m)
}

/// #3095: the same bindings in the marked spelling (`callee_formal_marked_bindings`).
/// A key seen with two different bindings maps every formal either names to
/// `~`, which the judge never reads, so a collision can only keep the answer
/// the printed spelling gives.
let call_formal_marked_bindings_cell: Array[MutMap[String, Array[(String, String)]]] = [
  MutMap::new_string()
]

export fn set_call_formal_marked_bindings(rows: Array[(String, Array[(String, String)])]) -> Unit {
  let m = MutMap::new_string()
  let mut i = 0
  while i < Array::length(rows) {
    let (k, binds) = Array::get(rows, i)
    match MutMap::get(m, k) {
      Some(prev) => if !formal_bindings_same(prev, binds) {
        let names = array_empty()
        let out = array_empty()
        let mut j = 0
        while j < Array::length(prev) + Array::length(binds) {
          let (n, _) = if j < Array::length(prev) {
            Array::get(prev, j)
          } else {
            Array::get(binds, j - Array::length(prev))
          }
          if !str_labels_contain(names, n) {
            Array::push(names, n)
            Array::push(out, (n, "~"))
          }
          j = j + 1
        }
        MutMap::set(m, k, out)
      },
      None => MutMap::set(m, k, binds)
    }
    i = i + 1
  }
  Array::set(call_formal_marked_bindings_cell, 0, m)
}

/// Two calls under one key that instantiate differently (sources merged
/// without rebased offsets): every formal either names is bound to `?Name`,
/// which no row authorizes (`row_label_args_ambiguous`), so the collision
/// FAILS CLOSED instead of leaving the formal open for the base-name match
/// (Codex on #3055).
fn ambiguous_formal_bindings(a: Array[(String, String)], b: Array[(String, String)]) -> Array[(String, String)] {
  let out = array_empty()
  let names = array_empty()
  let mut i = 0
  while i < Array::length(a) + Array::length(b) {
    let (n, _) = if i < Array::length(a) {
      Array::get(a, i)
    } else {
      Array::get(b, i - Array::length(a))
    }
    if !str_labels_contain(names, n) {
      Array::push(names, n)
      Array::push(out, (n, String::concat("?", n)))
    }
    i = i + 1
  }
  out
}

/// Clears the per-call bindings and the shadow sets, for the direct effect
/// entries that run without a checker pass: a previous program's tables must
/// not answer for this one (Codex on #3055).
fn clear_checker_published_tables() -> Unit {
  Array::set(call_formal_bindings_cell, 0, MutMap::new_string())
  set_shadowed_builtin_type_names([])
  set_row_nominal_types([])
  Array::set(call_formal_marked_bindings_cell, 0, MutMap::new_string())
}

/// Test hook: a label as the call at `key` instantiates it.
export fn instantiate_callee_label_at(label: String, key: String) -> String {
  instantiate_callee_label_key(label, key)
}

fn formal_bindings_same(a: Array[(String, String)], b: Array[(String, String)]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut same = true
    let mut i = 0
    while i < Array::length(a) {
      let (an, at) = Array::get(a, i)
      let (bn, bt) = Array::get(b, i)
      if an != bn || at != bt {
        same = false
      }
      i = i + 1
    }
    same
  }
}

/// A callee's row label as this call instantiates it: every whole-word formal
/// inside the label's brackets is replaced by the type the call gives it
/// (`State[S]` at `get("abc")` reads `State[String]`). The effect name before
/// the bracket is never touched, and a label with no binding is returned as
/// written.
fn instantiate_callee_label(label: String, callee_off: Int, callee: String) -> String {
  if callee_off < 0 {
    label
  } else {
    instantiate_callee_label_key(label, String::concat(__to_string(callee_off), String::concat(":", callee)))
  }
}

fn instantiate_callee_label_key(label: String, key: String) -> String {
  instantiate_callee_label_in(label, match MutMap::get(Array::get(call_formal_bindings_cell, 0), key) {
    Some(b) => b,
    None => []
  })
}

/// #3095: the label as the call instantiates it, in the marked spelling the
/// judge reads (`row_label_args_differ`). A word no binding replaces is the
/// callee's own text and stays bare.
fn instantiate_callee_label_marked(label: String, callee_off: Int, callee: String) -> String {
  if callee_off < 0 {
    label
  } else {
    let key = String::concat(__to_string(callee_off), String::concat(":", callee))
    instantiate_callee_label_in(label, match MutMap::get(Array::get(call_formal_marked_bindings_cell, 0), key) {
      Some(b) => b,
      None => []
    })
  }
}

fn callee_has_marked_bindings(callee_off: Int, callee: String) -> Bool {
  let key = String::concat(__to_string(callee_off), String::concat(":", callee))
  callee_off >= 0 && (match MutMap::get(Array::get(call_formal_marked_bindings_cell, 0), key) {
    Some(_) => true,
    None => false
  })
}

fn instantiate_callee_label_in(label: String, binds: Array[(String, String)]) -> String {
  let bi = String::index_of(label, "[")
  if bi < 0 {
    label
  } else {
    if Array::length(binds) == 0 {
      label
    } else {
      let n = String::length(label)
      let sb = StringBuilder::new()
      StringBuilder::push(sb, String::substring(label, 0, bi))
      let mut start = 0 - 1
      let mut i = bi
      while i <= n {
        let c = if i < n {
          String::char_code_at(label, i)
        } else {
          0
        }
        let word_char = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 36
        if word_char {
          if start < 0 {
            start = i
          } else {
            ()
          }
        } else {
          if start >= 0 {
            let w = String::substring(label, start, i)
            let mut rep = w
            let mut exact = false
            let mut k = 0
            while k < Array::length(binds) {
              let (fname, text) = Array::get(binds, k)
              if fname == w {
                rep = text
                exact = true
              }
              k = k + 1
            }
            if !exact {
              rep = marker_base_binding(w, binds)
            }
            StringBuilder::push(sb, rep)
            start = 0 - 1
          } else {
            ()
          }
          if i < n {
            StringBuilder::push(sb, String::substring(label, i, i + 1))
          } else {
            ()
          }
        }
        i = i + 1
      }
      StringBuilder::freeze(sb)
    }
  }
}

/// #3057: a label word spelled `NAME$K` that no binding names exactly. A
/// LOCAL alias (`let h = f` inside a body) calls with its source's row, whose
/// markers index the source's quantifier list, while the call's bindings come
/// from the alias's own scheme, respelled against ITS list. The two agree on
/// the formal's NAME, which is unique within one callee, so the word takes the
/// binding of that name when every binding of it gives the same type; when
/// they disagree it reads `?NAME`, which no row authorizes (fail closed, as
/// `ambiguous_formal_bindings` does). With no binding of the name the word is
/// kept as written, exactly as before.
fn marker_base_binding(w: String, binds: Array[(String, String)]) -> String {
  let base = marker_base_name(w)
  if base == w {
    w
  } else {
    let mut found = None
    let mut agree = true
    let mut k = 0
    while k < Array::length(binds) {
      let (fname, text) = Array::get(binds, k)
      if marker_base_name(fname) == base {
        match found {
          Some(prev) => if prev != text {
            agree = false
          },
          None => found = Some(text)
        }
      }
      k = k + 1
    }
    match found {
      Some(text) => if agree {
        text
      } else {
        String::concat("?", base)
      },
      None => w
    }
  }
}

/// `NAME` for a word spelled `NAME$K` (NAME non-empty, K all digits); any
/// other word unchanged.
fn marker_base_name(w: String) -> String {
  let at = String::last_index_of(w, "$")
  let n = String::length(w)
  if at <= 0 || at + 1 >= n {
    w
  } else {
    let mut digits = true
    let mut i = at + 1
    while i < n {
      let c = String::byte_at(w, i)
      if c < 48 || c > 57 {
        digits = false
      }
      i = i + 1
    }
    if digits {
      String::substring(w, 0, at)
    } else {
      w
    }
  }
}

fn throw_site_kind(off: Int, payload: Expr) -> String {
  let m = Array::get(throw_site_kind_cell, 0)
  match MutMap::get(m, throw_payload_site_key(off, payload)) {
    Some(kind) => kind,
    None => ""
  }
}

/// The row label a `throw` requires: the typed `Exception[K]::Throw` when the
/// payload's kind is resolvable, and the pinned erased `Exception::Throw`
/// otherwise. Non-exception operations pass through untouched.
fn throw_required_label(op_name: String, opargs: Array[Expr], binds: TkEnv, call_off: Int) -> String {
  if is_exception_throw_operation(op_name) && Array::length(opargs) == 1 {
    let payload = Array::get(opargs, 0)
    // The checker's kind is the answer whenever it has one. #3029: a struct
    // literal's syntax names only its struct, so for a generic one
    // (`Box[Int]::{ .. }`, or with its argument inferred) the checker's kind
    // carries the arguments. #3033: a payload read through an annotation
    // (`e: E`, `xs: Array[E]` with `type E = IoErr`) is spelled by the
    // syntax as WRITTEN, while the checker's kind is the type it names -- the
    // spelling kinds are compared in. The syntax answers only what the
    // checker left unresolved (another lane, or a site whose key collided).
    let typed = throw_site_kind(call_off, payload)
    let kind = if String::length(typed) > 0 {
      typed
    } else {
      throw_payload_kind(payload, binds)
    }
    exception_throw_label_for_kind(kind)
  } else {
    op_name
  }
}

/// Which spelling of the missing label to REPORT. A row that names no
/// exception label at all is the pre-#1344 "this function cannot throw" case,
/// and its diagnostic stays byte-identical (`missing { Exception::Throw }`); the
/// typed spelling is surfaced only once the row is already speaking in kinds,
/// where it is the actionable fix-it.
fn throw_report_label(op_name: String, required: String, declared: Array[String]) -> String {
  // #2982: report the RESOLVED kind whatever the declared row holds. This used
  // to fall back to the erased `Exception::Throw` when the row had no exception
  // label, so the hint told the reader to paste the erased spelling -- the one
  // ADR-0085 calls transitional -- even though the kind was known.
  // `required` is already the erased spelling when the kind is unresolved.
  required
}

/// #1343 (ADR-0071 operation-level rows, builtin slice): the OPERATION-level
/// label a builtin call can be authorized by, in addition to its bare effect.
/// For a QUALIFIED builtin the canonical name IS the operation id
/// (`Fs::read_file`), so a row may grant just that one operation instead of the
/// whole effect. An UNQUALIFIED effectful builtin (`sh`, the `vibe_*_raw`
/// dunders) has no operation spelling a user could write, so it falls back to
/// its effect and behaves exactly as before.
///
/// Without this, host capabilities had NO granularity below the whole effect:
/// `with Fs::read_file` was rejected with `missing { Fs }` because the
/// builtin path only ever compared the bare label, even though ADR-0071 made
/// the operation the row's minimal unit and `perform Eff::Op` already honored
/// it. That is what forced coarse rows like `with Http` (serve + outbound
/// request + request-field reads in one grant).
fn builtin_call_op_label(name: String, eff: String) -> String {
  let normalized = canonical_builtin_name(name)
  if String::index_of(normalized, "::") > 0 {
    normalized
  } else {
    eff
  }
}

/// #2107: does a definition in the program own this name, making the builtin
/// of the same name unreachable at this call site? A lexical binding (closure
/// parameter, `let`) or a top-level function both shadow it, the same way
/// codegen resolves a source definition ahead of its builtin lowering.
fn source_definition_shadows_builtin(name: String, lexical_callee: Option[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int]) -> Bool {
  match lexical_callee {
    Some(_) => true,
    None => match lookup_program_fn_effs(fn_index, fn_effs, name) {
      Some(_) => true,
      None => false
    }
  }
}

/// The complete set of UNQUALIFIED builtins that carry an effect row, and the
/// row each one carries. Everything else effectful in the registry is spelled
/// `Effect::op`, which `builtin_call_effect` resolves through `lookup_builtin`;
/// an unqualified name never reaches that lookup (the fast path there answers
/// None without it, on purpose -- the scan is over ~450 rows and runs on every
/// call in the program), so an unqualified effectful builtin that is missing
/// from this list is invisible to the row discipline entirely.
///
/// #2107: ten of them were. `println` / `print` lower onto
/// `Stdout::write_stream` / `Stdout::write_char`, the `vibe_tcp_*_raw` four
/// open and drive sockets, the `vibe_http_*_raw` five make outbound requests,
/// and `vibe_fs_stat_token_raw` stats a path -- all callable from a function
/// declaring no row at all, with a clean `vibe check` and a real host import
/// in the emitted module. Only the `sh` family had ever been listed.
///
/// `sleep` is deliberately absent: it carries `Async`, which
/// `is_entry_runtime_managed_effect` excludes at the caller anyway.
///
/// `builtin_registry_unqualified_row_test.vibe` derives this set from the
/// registry and fails if a new row appears that this list does not name, so it
/// cannot silently fall behind again.
fn unqualified_builtin_effect(name: String) -> Option[String] {
  // vibe_sh_lines_raw is checker_visible=false (only synthesized internally,
  // never typed by user source), so it needs no entry.
  if name == "sh" || name == "sh_lines"
  || name == "vibe_sh_capture_raw"
  || name == "vibe_sh_capture_exit_code_raw"
  || name == "vibe_sh_capture_stdout_raw"
  || name == "vibe_sh_capture_stderr_raw"
  || name == "vibe_sh_capture_close_raw"
  || name == "vibe_process_exit_raw" {
    Some("Process")
  } else if name == "println" || name == "print" {
    Some("Console")
  } else if name == "vibe_fs_stat_token_raw" {
    Some("Fs")
  } else if name == "vibe_tcp_connect_raw" || name == "vibe_tcp_read_raw"
  || name == "vibe_tcp_write_raw" || name == "vibe_tcp_close_raw" {
    Some("Socket")
  } else if name == "vibe_http_request_raw"
  || name == "vibe_http_response_status_raw"
  || name == "vibe_http_response_header_raw"
  || name == "vibe_http_response_body_raw"
  || name == "vibe_http_close_raw" {
    Some("Http")
  } else {
    None
  }
}

/// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful
/// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing
/// function to declare that effect, exactly like `perform`. Returns the required
/// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw
/// discipline) and `Async` (composition-allowed; handled by the async pass) are
/// deliberately excluded from this slice.
fn builtin_call_effect(name: String) -> Option[String] {
  let unqualified = unqualified_builtin_effect(name)
  if unqualified != None {
    match unqualified {
      Some(eff) => if is_entry_runtime_managed_effect(eff) {
        None
      } else {
        Some(eff)
      },
      None => None
    }
  } else if String::index_of(name, "::") < 0 {
    // Fast path: every OTHER effectful builtin in this slice is a QUALIFIED name
    // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a
    // callee with no `::` can never be one -- `unqualified_builtin_effect` above
    // is the complete list of the exceptions. Skipping `lookup_builtin` for the
    // (vastly more common) unqualified calls keeps the pass cheap enough to run
    // over the whole compiler source within the seed's heap during self-build.
    None
  } else {
    let normalized = canonical_builtin_name(name)
    match lookup_builtin(normalized) {
      Some(ty) => match ty {
        // Standard entry/runtime execution handles `Error`/`Exception[K]`
        // (entry-boundary exception policy) and `Async` (runtime scheduling),
        // so builtin calls carrying either label add no checker row
        // requirement. core/standard_effect_policy.vibe is the single
        // behavior-preserving definition.
        CtFn(_, _, Some(eff)) => if is_entry_runtime_managed_effect(eff) {
          None
        } else {
          Some(eff)
        },
        _ => None
      },
      None => None
    }
  }
}

fn labels_union(a: Array[String], b: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    let l = Array::get(b, j)
    let mut seen = false
    let mut k = 0
    while k < Array::length(out) {
      if Array::get(out, k) == l {
        seen = true
      }
      k = k + 1
    }
    if !seen {
      Array::push(out, l)
    }
    j = j + 1
  }
  out
}

/// #639: deterministic lexical label ordering for effect-row diagnostics.
/// The typed helper keeps Array-sourced labels on String relational lowering
/// (#1184).
fn label_lt(a: String, b: String) -> Bool {
  a < b
}

/// Copying insertion sort (rows are tiny — a handful of labels at most).
fn sort_labels(xs: Array[String]) -> Array[String] {
  let out = Array::slice(xs, 0, Array::length(xs))
  let mut i = 1
  while i < Array::length(out) {
    let key = Array::get(out, i)
    let mut j = i
    while j > 0 && label_lt(key, Array::get(out, j - 1)) {
      Array::set(out, j, Array::get(out, j - 1))
      j = j - 1
    }
    Array::set(out, j, key)
    i = i + 1
  }
  out
}

fn join_labels(xs: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(xs) {
    if i == 0 {
      out = Array::get(xs, i)
    } else {
      out = String::concat(out, String::concat(", ", Array::get(xs, i)))
    }
    i = i + 1
  }
  out
}

/// #639: build the effect-row mismatch diagnostic for a perform/call whose
/// required effects are absent from the enclosing declaration's row. `missing`
/// is the set difference (callee requires minus caller declares), rendered
/// sorted; `required` is the sorted union the fix-it hint suggests declaring.
/// #2975: the row the function being walked DECLARED, innermost walk last.
/// Inside a `handle` the walk's `declared` also carries the labels the handle
/// discharges, and the hint was built from that union: it told the reader to
/// declare the kind they had just handled, spelled `Exception[A]::Throw`,
/// which the row grammar does not parse. The report names the function's own
/// row instead.
let row_mismatch_roots: Array[Array[String]] = []

/// Only row items the grammar accepts in a `with` row: `Eff[T]::Op` is not one.
fn row_labels_pasteable(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if String::contains(l, "]::") || l == kinded_handle_marker() {
      ()
    } else {
      Array::push(out, l)
    }
    i = i + 1
  }
  out
}

fn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String], off: Int) -> EffectError {
  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))
  let own = if Array::length(row_mismatch_roots) > 0 {
    row_labels_pasteable(Array::get(row_mismatch_roots, Array::length(row_mismatch_roots) - 1))
  } else {
    row_labels_pasteable(declared)
  }
  let required = sort_labels(labels_union(own, row_labels_pasteable(missing)))
  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(own), join_labels(required), off)
}

fn is_program_entry_name(name: String) -> Bool {
  name == "main" || name == "_start"
}

/// The source spelling of a lowered `test` / `bench` block -- `test "x"` for
/// the synthesized `__test_x` -- so a hint about its row names the block the
/// reader wrote rather than the compiler's internal function. Empty for any
/// other name.
fn entry_block_display_name(fn_name: String) -> String {
  let n = String::length(fn_name)
  if String::starts_with(fn_name, "__test_") {
    String::concat("test \"", String::concat(String::substring(fn_name, 7, n), "\""))
  } else if String::starts_with(fn_name, "__bench_") {
    String::concat("bench \"", String::concat(String::substring(fn_name, 8, n), "\""))
  } else {
    ""
  }
}

/// An entry point by name: `main` / `_start`, or a lowered `test` / `bench` /
/// `example` block. ADR-0088: every one of them GRANTS its row, so the row
/// admission and the `allows`-spelled hints apply to all of them alike.
fn is_entry_point_name(fn_name: String) -> Bool {
  is_program_entry_name(fn_name) || String::length(entry_block_display_name(fn_name)) > 0
}

/// How an entry-boundary diagnostic names its entry: `'main'`, or the block
/// as the reader wrote it (`test "x"`) for a lowered block.
fn entry_display_name(fn_name: String) -> String {
  let block = entry_block_display_name(fn_name)
  if String::length(block) > 0 {
    block
  } else {
    String::concat("'", String::concat(fn_name, "'"))
  }
}

/// How a row diagnostic names the row's owner: `` `ask` `` for a binding or a
/// declaration, the block as written for a lowered block.
fn row_owner_display_name(fn_name: String) -> String {
  let block = entry_block_display_name(fn_name)
  if String::length(block) > 0 {
    block
  } else {
    String::concat("`", String::concat(fn_name, "`"))
  }
}

// User declarations can legally reuse a provider spelling such as `Fs`.
// Retain operation identity rather than only the effect name: the selfhost
// linked program contains private `effect Env { Get ... }` declarations as
// well as the real host `Env::get` builtin used by its entry point.
let entry_user_effect_operations: Array[String] = array_empty()

fn collect_entry_user_effect_operations(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, ops) => {
        let mut oi = 0
        while oi < Array::length(ops) {
          let (op_name, _, _) = Array::get(ops, oi)
          let label = String::concat(name, String::concat("::", op_name))
          if effect_row_has_label(Some(out), label) {
            ()
          } else {
            Array::push(out, label)
          }
          oi = oi + 1
        }
      },
      SModule(_, _, body) => collect_entry_user_effect_operations(body, out),
      _ => ()
    }
    i = i + 1
  }
}

fn set_entry_user_effect_operations(stmts: Array[Stmt]) -> Unit {
  Array::truncate(entry_user_effect_operations, 0)
  collect_entry_user_effect_operations(stmts, entry_user_effect_operations)
}

fn user_provider_collision_errors(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, effect_name, _, operations) => {
        let mut oi = 0
        while oi < Array::length(operations) {
          let (op_name, _, _) = Array::get(operations, oi)
          let operation = String::concat(effect_name, String::concat("::", op_name))
          if standard_provider_owns_operation(operation) {
            Array::push(errors, EEProviderOperationCollision(operation))
          } else {
            ()
          }
          oi = oi + 1
        }
      },
      SModule(_, _, body) => append_eff_errs(errors, user_provider_collision_errors(body)),
      _ => ()
    }
    i = i + 1
  }
  errors
}

fn entry_label_is_user_declared_operation(label: String) -> Bool {
  String::index_of(label, "::") > 0 && effect_row_has_label(Some(entry_user_effect_operations), label)
}

export fn standard_provider_owns_operation(label: String) -> Bool {
  match builtin_call_effect(label) {
    Some(owner) => is_entry_admitted_effect(owner) && label == canonical_builtin_name(label),
    None => false
  }
}

/// #1961: instantiate freeze uses the same identity as WIT/cache/checker.
/// A bare provider name (`Fs`) is authority for that namespace. A qualified
/// label is authority only when it is an exact registry-owned operation
/// (`Console::write_stream`). `Console::Get` is not frozen as host Console.
fn strip_authority_grade(label: String) -> String {
  let n = String::length(label)
  if n > 0 && String::char_code_at(label, n - 1) == 63 {
    String::substring(label, 0, n - 1)
  } else {
    label
  }
}

fn authority_is_optional(label: String) -> Bool {
  let n = String::length(label)
  n > 0 && String::char_code_at(label, n - 1) == 63
}

export fn is_instantiate_authority(label: String) -> Bool {
  let core = strip_authority_grade(label)
  if String::index_of(core, "::") < 0 {
    has_standard_host_provider(core)
  } else {
    standard_provider_owns_operation(core)
  }
}

/// #1961 / ADR-0088 L2: freeze optional resolution before run.
/// Required owned operations are Granted; Optional ones are NotGranted
/// (non-TTY instantiate default). Labels that are not instantiate
/// authority are dropped — check_entry_declared_effects already rejects them.
export fn freeze_binding_lock(labels: Array[String]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let status = if authority_is_optional(lab) {
        "NotGranted"
      } else {
        "Granted"
      }
      Array::push(out, (core, status))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The instantiate-authority labels a program's ENTRY grants, read from the
/// entry's own row (ADR-0088: an entry has no caller, so its row is a grant).
///
/// #2828 / ADR-0088's Remaining (#2332): `preflight_instantiate` and
/// `freeze_binding_lock` were written, unit-tested, and reachable from nothing
/// but their test -- measured, zero production callers. They take the entry's
/// labels, and nothing outside the checker could produce that list, so this
/// exposes it. Labels that are not instantiate authority are dropped here, the
/// same rule `freeze_binding_lock` applies, so callers see exactly the set the
/// ladder reasons about.
///
/// Empty when the program declares no entry, which is the honest answer for a
/// library: there is no grant to preflight.
export fn entry_declared_authority(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ty, body) => if is_program_entry_name(name) {
        let labels = fn_binding_effects(ty, body)
        let mut j = 0
        while j < Array::length(labels) {
          let lab = Array::get(labels, j)
          if is_instantiate_authority(lab) {
            Array::push(out, lab)
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn host_grant_covers(host_granted: Array[String], core: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(host_granted) && !found {
    let g = Array::get(host_granted, i)
    if g == core {
      found = true
    } else if String::index_of(g, "::") < 0 && has_standard_host_provider(g) {
      if core == g || effect_name_of_op(core) == g {
        found = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The authority PROVIDER a `--allow-<x>` / `--deny-<x>` flag names, or `""`
/// when the argument is not a capability flag.
///
/// Inverse of `allow_flag_for_authority`, and deliberately its neighbour: the
/// flag a diagnostic PRINTS and the flag the CLI READS must be the same
/// string, and they drift the moment the two mappings live apart. The
/// comparison is on the lowercased provider name, so `--allow-fs` and
/// `--deny-fs` both answer `Fs` (#2828, ADR-0088 L1).
export fn authority_for_capability_flag(flag: String) -> String {
  let rest = if String::starts_with(flag, "--allow-") {
    flag[8: String::length(flag)]
  } else if String::starts_with(flag, "--deny-") {
    flag[7: String::length(flag)]
  } else {
    ""
  }
  if rest == "" {
    ""
  } else {
    let names = standard_host_provider_names()
    let mut i = 0
    let mut found = ""
    while i < Array::length(names) {
      let n = Array::get(names, i)
      if lowercase_ascii(n) == rest {
        found = n
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// ASCII lowercase. The provider names are ASCII by construction (they are
/// vibe identifiers), so this needs no Unicode case table.
fn lowercase_ascii(s: String) -> String {
  let acc = StringBuilder::new()
  let mut i = 0
  while i < String::length(s) {
    let c = String::byte_at(s, i)
    if c >= 65 && c <= 90 {
      StringBuilder::push(acc, String::from_byte(c + 32))
    } else {
      StringBuilder::push(acc, String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

/// The `--allow-*` spelling a diagnostic tells the reader to pass.
///
/// #1963: this was a six-arm chain over provider NAMES -- `Fs` -> `--allow-fs`
/// and five more -- with `String::concat("--allow-", provider)` underneath. The
/// chain was doing one thing, lowercasing, one name at a time, and the fall-
/// through did not do it at all. `standard_host_provider_names()` has TEN
/// entries, so `Stderr`, `Process`, `Profiler` and `Socket` reached that
/// fallthrough and printed a capitalised flag.
///
/// Measured, the printed flag was one the CLI REJECTS:
///
///   instantiate preflight: required `Profiler::now_us` is not granted;
///   pass `--allow-Profiler` before main starts, ...
///
///   authority_for_capability_flag("--allow-Profiler") == ""     <- rejected
///   authority_for_capability_flag("--allow-profiler") == "Profiler"
///
/// and a rejected flag is reported as `--allow-Profiler: not a capability`.
/// AGENTS.md requires a diagnostic to lead with the edit that fixes it; on the
/// authority path this one led with an edit the next command refuses.
///
/// `authority_for_capability_flag` below is the reader, and it has always
/// derived the spelling with `lowercase_ascii` over the same provider list.
/// Deriving it here too is what makes the pair one rule instead of two, which
/// is this issue's criterion: no semantic decision left that is keyed on an
/// effect NAME.
export fn allow_flag_for_authority(core: String) -> String {
  let provider = if String::index_of(core, "::") < 0 {
    core
  } else {
    effect_name_of_op(core)
  }
  String::concat("--allow-", lowercase_ascii(provider))
}

/// #1961 / ADR-0088 L3: non-TTY instantiate preflight.
/// `host_granted` is what the composed host will actually inject this run.
/// Required instantiate-authority labels missing from it abort before main,
/// with the `--allow-*` spelling. Optional missing stay NotGranted; a
/// granted optional becomes Granted. Labels that are not instantiate
/// authority are dropped, same as freeze_binding_lock.
export fn preflight_instantiate(labels: Array[String], host_granted: Array[String]) -> Array[(String, String)] with Exception {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let granted = host_grant_covers(host_granted, core)
      if authority_is_optional(lab) {
        let status = if granted {
          "Granted"
        } else {
          "NotGranted"
        }
        Array::push(out, (core, status))
      } else if granted {
        Array::push(out, (core, "Granted"))
      } else {
        throw(String::concat("instantiate preflight: required `", String::concat(core, String::concat("` is not granted; pass `", String::concat(allow_flag_for_authority(core), String::concat("` before main starts, or mark it optional (`allows ", String::concat(core, "?`)")))))))
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn authority_covers_operation(auth: String, emitted: String) -> Bool {
  if authority_is_optional(auth) {
    false
  } else if auth == emitted {
    true
  } else if String::index_of(auth, "::") < 0 && standard_provider_owns_operation(emitted) {
    effect_name_of_op(emitted) == auth
  } else if auth == "Console" && is_legacy_console_provider(effect_name_of_op(emitted)) {
    // The instantiate-grant half of #2102's containment. `allows` is a
    // SEPARATE authorization path from the `with` row (ADR-0075/0084/0088:
    // authority is fixed once, at instantiate), so teaching only
    // `decl_authorizes_effect` left the split form unable to express what the
    // bare form could -- `fn main with () allows Console { println(..) }` was
    // rejected while `fn main with Console { println(..) }` compiled. Same
    // one-way rule and same reason: `Console` is the union, the legacy labels
    // are subsets, and the reverse would widen authority.
    true
  } else {
    false
  }
}

/// ADR-0088: does the declared label `lab`, when it carries the Optional
/// grade, cover `op_name` -- the operation itself (`Fs::read_file?`) or its
/// whole provider (`Fs?`, every operation of the provider)? A required label
/// never answers here: the plain-label rules decide those.
fn optional_label_covers_op(lab: String, op_name: String) -> Bool {
  if authority_is_optional(lab) {
    let core = strip_authority_grade(lab)
    core == op_name || core == effect_name_of_op(op_name) || authority_covers_operation(core, op_name)
  } else {
    false
  }
}

/// ADR-0088: the REQUIRED label of `labels` that covers `op_name` -- the
/// operation itself or its provider -- or "" when none. Required is the join
/// of the grade lattice, so such a label absorbs any optional grant of the
/// same operation: the operation is always granted, and a `perform?` on it
/// would advertise a `NotGranted` arm that cannot run.
fn required_grant_covering_op(labels: Array[String], op_name: String) -> String {
  let mut i = 0
  let mut found = ""
  while i < Array::length(labels) && String::length(found) == 0 {
    let lab = Array::get(labels, i)
    if authority_covers_operation(lab, op_name) {
      found = lab
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn decl_authorizes_optional_op(labels: Array[String], op_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) && !found {
    if optional_label_covers_op(Array::get(labels, i), op_name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn perform_question_op_name(arg: Expr) -> Option[String] {
  match arg {
    ECall(op_callee, _, _) => match op_callee {
      EIdent(op_name, _) => Some(op_name),
      _ => None
    },
    _ => None
  }
}

fn entry_user_operation_requires_handler(label: String) -> Bool {
  // #1961: a source-declared operation is algebraic even when its spelling
  // matches a host provider. Exact collisions are rejected separately and
  // never grant provider authority from the text of the perform.
  entry_label_is_user_declared_operation(label)
}

fn entry_unresolved_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    if label_is_effect_var(label) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

fn entry_unadmitted_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    // Row variables are separated above so they receive the closed-row hint;
    // this list contains only concrete effects that lack an entry owner.
    // The Optional grade is a property of the grant, not of the label's
    // owner: classify `Fs::read_file?` as `Fs::read_file`.
    let core = strip_authority_grade(label)
    if !label_is_effect_var(label) && (entry_user_operation_requires_handler(core) || !is_entry_admitted_effect(core)) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

fn entry_handler_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let base = effect_name_of_op(Array::get(labels, i))
    if effect_row_has_label(Some(out), base) {
      ()
    } else {
      Array::push(out, base)
    }
    i = i + 1
  }
  sort_labels(out)
}

/// ADR-0088: the first missing label that an OPTIONAL grant in `declared`
/// covers, paired with that grant as written (`Fs::read_file?`, or the
/// provider-wide `Fs?`); `("", "")` when no optional grant reaches any of
/// them. The pair is what the strict-grade diagnostic quotes.
fn optional_grant_for(declared: Array[String], missing: Array[String]) -> (String, String) {
  let mut i = 0
  let mut op = ""
  let mut grant = ""
  while i < Array::length(missing) && String::length(grant) == 0 {
    let m = Array::get(missing, i)
    let mut di = 0
    while di < Array::length(declared) && String::length(grant) == 0 {
      let lab = Array::get(declared, di)
      if optional_label_covers_op(lab, m) {
        op = m
        grant = lab
      } else {
        ()
      }
      di = di + 1
    }
    i = i + 1
  }
  (op, grant)
}

fn make_contextual_row_error(fn_name: String, declared: Array[String], missing: Array[String], off: Int) -> EffectError {
  // #2985 review (Codex P0): under a kinded exception handler the body's
  // exception requirements are checked exactly (see kinded_handle_marker);
  // a missing exception label there is not "add it to the row" -- the row
  // may well have it -- but "this handle would catch it".
  let strict_kinded = effect_row_has_label(Some(declared), kinded_handle_marker())
  let missing_exc = if strict_kinded {
    let out = no_str_labels()
    let mut mi = 0
    while mi < Array::length(missing) {
      let ml = Array::get(missing, mi)
      if is_exception_label(ml) {
        Array::push(out, ml)
      } else {
        ()
      }
      mi = mi + 1
    }
    out
  } else {
    no_str_labels()
  }
  if Array::length(missing_exc) > 0 {
    EEKindedHandleCatchesAll(fn_name, join_labels(kinded_exception_labels(declared)), join_labels(sort_labels(missing_exc)), off)
  } else {
    make_contextual_row_error_plain(fn_name, labels_without_exception_family_marker(declared), missing, off)
  }
}

/// `labels` without the kinded-handle marker (the exception labels stay).
fn labels_without_exception_family_marker(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if l == kinded_handle_marker() {
      ()
    } else {
      Array::push(out, l)
    }
    i = i + 1
  }
  out
}

fn make_contextual_row_error_plain(fn_name: String, declared: Array[String], missing: Array[String], off: Int) -> EffectError {
  let unresolved = entry_unresolved_labels(missing)
  let bad = entry_unadmitted_labels(missing)
  let (optional_op, optional_grant) = optional_grant_for(declared, missing)
  if String::length(optional_grant) > 0 {
    // ADR-0088 strict grade match: an optional grant never authorizes a
    // required call, and the edit is either the `perform?` form or the
    // required grade -- not "add it to the row", which it already is.
    EEOptionalGrantForRequiredCall(fn_name, optional_op, optional_grant, off)
  } else if is_entry_point_name(fn_name) && Array::length(unresolved) > 0 {
    // An entry -- `main`, or a `test` / `bench` / `example` block -- has no
    // caller: a label nothing can bring in is not "missing from the row", it
    // is undischargeable, and the edit is `handle`, not `allows`.
    EEUnresolvedEntryEffectRow(fn_name, join_labels(unresolved), off)
  } else if is_entry_point_name(fn_name) && Array::length(bad) > 0 {
    EEUndischargedEntryEffect(fn_name, join_labels(bad), join_labels(entry_handler_labels(bad)), off)
  } else {
    make_row_mismatch(fn_name, declared, missing, off)
  }
}

fn first_expr_offset(root: Expr) -> Int {
  let stack = Array::slice([root], 0, 1)
  let mut first = 0 - 1
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let expr = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    let off = match expr {
      EIdent(_, x) => x,
      ELet(_, _, _, x) => x,
      ELetMut(_, _, _, x) => x,
      ECall(_, _, x) => x,
      EDot(_, _, x, _) => x,
      _ => 0 - 1
    }
    if off >= 0 && (first < 0 || off < first) {
      first = off
    } else {
      ()
    }
    expr_children_into(expr, stack)
  }
  first
}

/// ADR-0088: an entry's row is its GRANT (`fn main allows ..`, `test "x"
/// allows ..`; the legacy `with` spelling reads the same). Every label must
/// have an owner the run can bring in -- a standard host provider, or the
/// entry / runtime policy (`Exception`, `Async`) -- because nothing above the
/// entry could handle it. A user effect that reaches the boundary is rejected
/// with the `handle` edit (#1683); a row variable has no caller to instantiate
/// it. Past those, a grant is the run's contract, so an operation it names
/// must exist: `allows Console::Get` on a program that declares no `effect
/// Console` used to be admitted by the provider prefix alone and granted
/// nothing. One policy for `main` / `_start` and for the `test` / `bench` /
/// `example` blocks (Codex review on PR #2653: the block row used to pass
/// straight into the walk, so `test "x" allows Ask::Get` authorized a
/// `perform` no handler would ever catch).
fn entry_grant_errors(entry_name: String, labels: Array[String], off: Int) -> Array[EffectError] {
  let errors = array_empty()
  let unresolved = entry_unresolved_labels(labels)
  let bad = entry_unadmitted_labels(labels)
  if Array::length(unresolved) > 0 || Array::length(bad) > 0 {
    if Array::length(unresolved) > 0 {
      Array::push(errors, EEUnresolvedEntryEffectRow(entry_name, join_labels(unresolved), off))
    } else {
      Array::push(errors, EEUndischargedEntryEffect(entry_name, join_labels(bad), join_labels(entry_handler_labels(bad)), off))
    }
  } else {
    let mut li = 0
    while li < Array::length(labels) {
      let core = strip_authority_grade(Array::get(labels, li))
      if String::index_of(core, "::") >= 0 && has_standard_host_provider(core) && !entry_user_operation_requires_handler(core) && !standard_provider_owns_operation(core) {
        Array::push(errors, EEUnknownProviderOperation(entry_name, core))
      } else {
        ()
      }
      li = li + 1
    }
  }
  errors
}

fn check_entry_declared_effects(fn_name: String, ty: Option[TypeExpr], body: Expr) -> Array[EffectError] {
  let errors = array_empty()
  if is_program_entry_name(fn_name) {
    let inspect_body = match body {
      EFn(_, _, _, _, _, fbody) => fbody,
      _ => body
    }
    append_eff_errs(errors, entry_grant_errors(fn_name, fn_binding_effects(ty, body), first_expr_offset(inspect_body)))
  } else {
    ()
  }
  errors
}

/// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after
/// handling E the body need not declare it. The parser qualifies each handler
/// arm pattern as `E::Op`, so the discharged effect names are recoverable as the
/// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a
/// handle discharges (empty if none could be determined — then the body stays
/// conservatively permissive, never over-strict).
///
/// ADR-0071 (#755) step 4: ALSO push each arm's own fully-qualified operation
/// name (`Ask::Get`, not just the bare `Ask` prefix). `handle ... with Ask
/// {...}` is exhaustive over every operation of Ask (ADR-0050 -- a handler
/// can't discharge only some operations), so discharging the bare effect
/// name is semantically equivalent to discharging every one of its qualified
/// operation names. But the DOWNSTREAM containment check
/// (decl_authorizes_effect) does exact string-label matching: a handled
/// body that transitively calls a function declaring `with Ask::Get`
/// (operation-level, not the bare effect) previously reported that specific
/// requirement as still missing even though the handle plainly covers it --
/// "Ask" != "Ask::Get" as strings, and the discharge list only ever
/// contained the bare form. Pushing the qualified name too is a pure
/// widening (nothing that was authorized before stops being authorized; the
/// bare-effect-name discharge and its blanket effect_name_of_op-based
/// authorization inside the body are both untouched), so it only fixes this
/// gap without changing any other observable behavior.
fn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => {
        let idx = String::index_of(name, "::")
        if idx > 0 {
          let eff = canonical_exception_effect_name(name[0: idx])
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == eff {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, eff)
          }
          let mut qseen = false
          let mut k = 0
          while k < Array::length(out) {
            if Array::get(out, k) == name {
              qseen = true
            }
            k = k + 1
          }
          if !qseen {
            Array::push(out, name)
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of
/// recursion, so the pass never exhausts the wasm call stack however deeply the
/// compiler's own source nests (long `let`/`seq` spines AND nested
/// if/match/call forms). Each stack item carries its (expr, declared, in_handle)
/// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it
/// with the discharged effects (criterion 2). Order of traversal differs from a
/// recursive pre-order walk, but the SET of effect errors found is identical, so
/// the accept/reject decision is unchanged.
/// The declared effect row of a top-level binding: the signature's `with` row
/// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with
/// { E }`). Used to build the call-graph effect map for transitive enforcement.
fn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {
  let sig = sig_type_effect_labels(ty)
  match body {
    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_row_labels(effect_row_parse(eff))),
    _ => sig
  }
}

/// #1485: the effect labels a PARAMETER's own type declares. `(T) -> T with e`
/// yields `["e"]`; a non-function parameter yields nothing.
fn param_type_effect_labels(pty: TypeExpr) -> Array[String] {
  match pty {
    TyFn(_, _, peff) => effect_row_labels(effect_row_parse(peff)),
    _ => no_str_labels()
  }
}

/// #1485: per-PARAMETER effect labels for one top-level binding, positionally.
/// `apply: [T](f: (T) -> T with e, x: T) -> T with e` yields `[["e"], []]`.
///
/// This is the data call-site row unification needs. To resolve what a callee's
/// row VARIABLE binds to at ONE call site you have to know which of its
/// parameters carry that variable, and then look at what was actually passed
/// there -- the callee's own row alone cannot tell you, which is exactly why
/// the transitive check used to exempt row variables outright.
///
/// Both spellings of a signature are read, because they put the parameter types
/// in different places: a separate annotation (`let apply: [T](f: (T) -> T with
/// e, ..) -> T = ..`) carries them on the `SLet`'s `TyFn`, while the inline
/// generic literal (`let apply = [T](f: (x: T) -> T with e, ..) -> T with e
/// { .. }`, the form both #1485 fixtures use) carries them on the `EFn`.
fn fn_binding_param_effects(ty: Option[TypeExpr], body: Expr) -> Array[Array[String]] {
  let out = array_empty()
  match ty {
    Some(TyFn(sig_params, _, _)) => {
      let mut i = 0
      while i < Array::length(sig_params) {
        Array::push(out, param_type_effect_labels(Array::get(sig_params, i)))
        i = i + 1
      }
    },
    _ => match body {
      EFn(_, _, params, _, _, _) => {
        let mut i = 0
        while i < Array::length(params) {
          let (_, pty) = Array::get(params, i)
          match pty {
            Some(t) => Array::push(out, param_type_effect_labels(t)),
            None => Array::push(out, no_str_labels())
          }
          i = i + 1
        }
      },
      _ => ()
    }
  }
  out
}

fn no_param_effs() -> Array[Array[Array[String]]] {
  array_empty()
}

/// The callee signatures a call ARGUMENT's row is decided by
/// (closure_arg_declared). The program table (`fn_names` / `fn_effs` /
/// `fn_param_effs`) records what the transitive check needs -- every
/// top-level binding of the module, and of the env only the bindings with a
/// non-empty row, those with no parameter rows (#1485 keeps imports on its
/// exemption). The argument rule needs an imported callee's PARAMETER rows
/// (`TaskGroup::spawn`'s `() -> T with Exception + e` is the one that
/// licenses the relaxation), so it reads this separate table --
/// the same module bindings plus EVERY function binding of the env, module
/// first so a same-named import is shadowed the way lookups shadow it. Set
/// at every entry of the pass, and cleared by the entries with no env, so
/// no table survives into the next module (the throw_kind_cell rule).
let callee_sig_index: Array[MutMap[String, Int]] = [MutMap::new_string()]

let callee_sig_effs: Array[Array[String]] = array_empty()

let callee_sig_param_effs: Array[Array[Array[String]]] = array_empty()

fn set_callee_sigs(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let loc_names = array_empty()
  let loc_effs = array_empty()
  let loc_peffs = no_param_effs()
  build_perform_fn_effs(stmts, env, loc_names, loc_effs, loc_peffs)
  set_callee_sigs_from(loc_names, loc_effs, loc_peffs, env_fn_sigs(env))
}

/// `set_callee_sigs` from tables the caller already built: this module's own
/// bindings (`build_perform_fn_effs`) followed by every function binding of
/// the env (`env_fn_sigs`). The effect pass needs both halves for its program
/// table too, so it builds each once and hands them here.
fn set_callee_sigs_from(loc_names: Array[String], loc_effs: Array[Array[String]], loc_peffs: Array[Array[Array[String]]], env_sigs: (Array[String], Array[Array[String]], Array[Array[Array[String]]])) -> Unit {
  Array::truncate(callee_sig_effs, 0)
  Array::truncate(callee_sig_param_effs, 0)
  let names = array_empty()
  let mut i = 0
  while i < Array::length(loc_names) {
    Array::push(names, Array::get(loc_names, i))
    Array::push(callee_sig_effs, Array::get(loc_effs, i))
    Array::push(callee_sig_param_effs, Array::get(loc_peffs, i))
    i = i + 1
  }
  let (env_names, env_effs, env_peffs) = env_sigs
  let mut j = 0
  while j < Array::length(env_names) {
    Array::push(names, Array::get(env_names, j))
    Array::push(callee_sig_effs, Array::get(env_effs, j))
    Array::push(callee_sig_param_effs, Array::get(env_peffs, j))
    j = j + 1
  }
  Array::set(callee_sig_index, 0, program_fn_index(names))
}

/// `param_type_effect_labels` over a checked `Type`: the row a function-typed
/// parameter declares, nothing for any other parameter.
fn type_param_effect_labels(pty: Type) -> Array[String] {
  match pty {
    CtFn(_, _, peff) => effect_row_labels(effect_row_parse(peff)),
    _ => no_str_labels()
  }
}

/// `fn_binding_param_effects` over a checked function `Type`, positionally.
fn fn_type_param_effects(params: Array[Type]) -> Array[Array[String]] {
  let out = no_param_row()
  let mut i = 0
  while i < Array::length(params) {
    Array::push(out, type_param_effect_labels(Array::get(params, i)))
    i = i + 1
  }
  out
}

/// One callee's "no parameter rows known" entry.
fn no_param_row() -> Array[Array[String]] {
  array_empty()
}

/// #3016: union one label of a named argument's row into a row variable's
/// instantiation -- unless a CONCRETE label of the same parameter row already
/// authorizes it (`Exception` covers `Exception[String]`, `Fs` covers
/// `Fs::read_file`). The callee handles or declares that label itself, so it
/// never reaches the variable, and charging it to the caller asked `main` to
/// declare an exception that could not reach it.
fn rv_union_label(out: Array[String], lbl: String, concrete: Array[String]) -> Unit {
  if effect_row_has_label(Some(out), lbl) {
    ()
  } else if Array::length(concrete) > 0 && decl_authorizes_op(concrete, lbl) {
    ()
  } else {
    Array::push(out, lbl)
  }
}

/// The labels of a parameter row that are not row variables.
fn rv_concrete_labels(row: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(row) {
    let lbl = Array::get(row, i)
    if label_is_effect_var(lbl) {
      ()
    } else {
      Array::push(out, lbl)
    }
    i = i + 1
  }
  out
}

/// #1485: what a callee's row VARIABLE is instantiated to at ONE call site.
///
/// `row_var` is a row-variable label from the callee's declared row (e.g. `"e"` of
/// `apply: [T](f: (T) -> T with e, x: T) -> T with e`). For every parameter
/// whose own type declares that same variable, the argument actually passed
/// there is resolved to its declared row, and the union of those rows is what
/// the variable binds to here.
///
/// Returns None when the instantiation cannot be determined, and the caller
/// then keeps the pre-#1485 exemption. That happens when a contributing
/// argument is anything other than a name this pass can look up, or a closure
/// literal that DECLARES its row (#2078) -- a call result, a field access, an
/// unannotated lambda. Bailing out there is what keeps the
/// change one-directional: a call site either gains a requirement that is
/// justified by a row we actually read, or is left exactly as it was. It never
/// guesses, so it cannot produce the false positives that sank the naive fix
/// (`generic_effect_matrix_ok_passthrough_pure`, where `apply(inc, 41)` passes
/// a PURE function and must keep requiring nothing).
fn resolve_row_var_instantiation(row_var: String, callee_param_effs: Array[Array[String]], args: Array[Expr], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], ov_names: Array[String], ov_effs: Array[Array[String]]) -> Option[Array[String]] {
  let out = no_str_labels()
  let mut i = 0
  let mut bailed = false
  let mut saw_param = false
  while i < Array::length(callee_param_effs) {
    if effect_row_has_label(Some(Array::get(callee_param_effs, i)), row_var) {
      saw_param = true
      let concrete = rv_concrete_labels(Array::get(callee_param_effs, i))
      if i < Array::length(args) {
        match Array::get(args, i) {
          EIdent(argname, _) => {
            // A named argument: its row is whatever the call-graph map or the
            // in-scope callback overlay records for it. An argument naming
            // nothing either table knows (an import this pass cannot see) is a
            // bail-out, not an empty row -- treating "unknown" as "pure" would
            // silently authorize the very leak this is closing.
            // #1723: argument names obey the same lexical precedence as the
            // callee itself. An explicit empty overlay entry is a pure local
            // shadow, not permission to consult a same-named top-level fn.
            match lookup_fn_effs(ov_names, ov_effs, argname) {
              Some(argeffs) => {
                let mut k = 0
                while k < Array::length(argeffs) {
                  let lbl = Array::get(argeffs, k)
                  rv_union_label(out, lbl, concrete)
                  k = k + 1
                }
              },
              None => match lookup_program_fn_effs(fn_index, fn_effs, argname) {
                Some(argeffs2) => {
                  let mut k2 = 0
                  while k2 < Array::length(argeffs2) {
                    let lbl2 = Array::get(argeffs2, k2)
                    rv_union_label(out, lbl2, concrete)
                    k2 = k2 + 1
                  }
                },
                None => {
                  bailed = true
                }
              }
            }
          },
          EFn(_, _, _, _, eff, _) => match effect_row_parse(eff) {
            // #2078: a closure literal that DECLARES its row needs no
            // guessing -- the row is written at the argument position. It was
            // bailing here, and the two mechanisms that would otherwise catch
            // it both stand down for this exact shape: an explicit annotation
            // suppresses the lexical charge to the enclosing function (an
            // unannotated literal's `perform` still lands there, which is why
            // that case keeps bailing below), and the named-argument arm above
            // never sees a literal. The result was a program that performs an
            // effect with no handler and no declared row anywhere, compiles
            // clean, and traps at runtime.
            Some(lambda_effs) => {
              let mut li = 0
              while li < Array::length(lambda_effs) {
                let llbl = Array::get(lambda_effs, li)
                rv_union_label(out, llbl, concrete)
                li = li + 1
              }
            },
            // An INFERRED row (`None`, structurally distinct from `Some([])`)
            // inherits its surrounding context, so reading it here would be
            // the guess this function exists not to make. Bail and keep the
            // pre-#1485 exemption; the enclosing function's own row check is
            // what covers this shape.
            None => {
              bailed = true
            }
          },
          _ => {
            bailed = true
          }
        }
      } else {
        bailed = true
      }
    } else {
      ()
    }
    i = i + 1
  }
  if bailed || !saw_param {
    None
  } else {
    Some(out)
  }
}

/// Look up a called function's declared effect row by linear scan over PARALLEL
/// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across
/// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap
/// (#626 OOM); the linear scan allocates nothing.
/// #2386: the program table's name -> first slot index. `fn_names` holds every
/// top-level binding of the module and every effectful binding of the env, in
/// that order, and used to be scanned front to back once per call site and
/// once per binder of the walk (`lookup_fn_effs` / `effect_name_exists`) --
/// about a second of a cold compiler-closure check. The index answers the
/// same slot: the first occurrence wins, exactly as the scan did. Built once
/// per entry, after the table is final; the small per-scope overlays keep the
/// scan.
fn program_fn_index(fn_names: Array[String]) -> MutMap[String, Int] {
  let index = MutMap::with_capacity_string(Array::length(fn_names) * 2 + 16)
  let mut i = 0
  while i < Array::length(fn_names) {
    let name = Array::get(fn_names, i)
    if MutMap::has(index, name) {
      ()
    } else {
      MutMap::set(index, name, i)
    }
    i = i + 1
  }
  index
}

/// `lookup_fn_effs` over the program table, through its index.
fn lookup_program_fn_effs(fn_index: MutMap[String, Int], effs: Array[Array[String]], name: String) -> Option[Array[String]] {
  match MutMap::get(fn_index, name) {
    Some(i) => Some(Array::get(effs, i)),
    None => None
  }
}

/// `effect_name_exists` over the program table, through its index.
fn program_fn_exists(fn_index: MutMap[String, Int], name: String) -> Bool {
  MutMap::has(fn_index, name)
}

/// `lookup_fn_param_effs` over the program table, through its index. The
/// scan stopped at the shorter of the two aligned arrays; the index slot is
/// checked against `param_effs` the same way.
fn lookup_program_fn_param_effs(fn_index: MutMap[String, Int], param_effs: Array[Array[Array[String]]], name: String) -> Option[Array[Array[String]]] {
  match MutMap::get(fn_index, name) {
    Some(i) => if i < Array::length(param_effs) {
      Some(Array::get(param_effs, i))
    } else {
      None
    },
    None => None
  }
}

fn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(names) {
    match found {
      None => if Array::get(names, i) == name {
        found = Some(Array::get(effs, i))
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// #885 review (Codex): a `let`/`let rec`/`let mut` binding can reuse the NAME
/// of an in-scope callback-parameter overlay entry (e.g. rebinding `f` to an
/// unrelated local pure closure). Without this, `lookup_fn_effs`'s first-match
/// scan would still find the SHADOWED outer entry and reject a call to the
/// new, unrelated binding as if it were the original effectful callback --
/// a false positive on valid shadowing. Removes every overlay entry matching
/// `name` before the shadowing binding's scope is pushed onto the stack.
/// #885 review (Codex): shadow the overlay by EVERY name in `params`, in one
/// pass — used at an EFn boundary where all of the lambda's own parameter
/// names (not just the ones that become new overlay entries) must block a
/// same-named inherited entry.
fn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {
  let mut cur_names = names
  let mut cur_effs = effs
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    let shadowed = shadow_overlay(cur_names, cur_effs, pname)
    cur_names = shadowed.0
    cur_effs = shadowed.1
    i = i + 1
  }
  (cur_names, cur_effs)
}

fn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {
  let out_names = array_empty()
  let out_effs = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    if Array::get(names, i) != name {
      Array::push(out_names, Array::get(names, i))
      Array::push(out_effs, Array::get(effs, i))
    } else {
      ()
    }
    i = i + 1
  }
  (out_names, out_effs)
}

fn overlay_bind_empty(names: Array[String], effs: Array[Array[String]], name: String, fn_names: Array[String], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let (sn, se) = shadow_overlay(names, effs, name)
  // Most locals cannot fall through to a top-level function, so retaining an
  // empty marker for every binding only lengthens every descendant snapshot.
  // The marker is needed exactly when the fallback table contains this name.
  if !program_fn_exists(fn_index, name) {
    return (sn, se)
  }
  let out_names = [name]
  let out_effs = [no_str_labels()]
  let mut i = 0
  while i < Array::length(sn) {
    Array::push(out_names, Array::get(sn, i))
    Array::push(out_effs, Array::get(se, i))
    i = i + 1
  }
  (out_names, out_effs)
}

fn overlay_bind_empty_names(names: Array[String], effs: Array[Array[String]], bound: Array[String], fn_names: Array[String], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let mut cur_names = names
  let mut cur_effs = effs
  let mut i = 0
  while i < Array::length(bound) {
    let next = overlay_bind_empty(cur_names, cur_effs, Array::get(bound, i), fn_names, fn_index)
    cur_names = next.0
    cur_effs = next.1
    i = i + 1
  }
  (cur_names, cur_effs)
}

fn overlay_bind_empty_pat(names: Array[String], effs: Array[Array[String]], pat: Pat, fn_names: Array[String], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let bound = array_empty()
  collect_pat_binds_into(pat, bound)
  overlay_bind_empty_names(names, effs, bound, fn_names, fn_index)
}

/// #885 (split off from #838, originally scoped out at #626): a function-typed
/// PARAMETER (a callback, e.g. `f: (T) -> T with e`) is a call-graph leaf
/// exactly like a named top-level function, but `fn_names`/`fn_effs` above is
/// built ONLY from top-level `SLet`/`SLetMut` bindings, so invoking a callback
/// PARAMETER directly (`f(x)` inside the wrapper that owns `f`) was invisible to
/// the transitive check — no lookup ever matched `f`'s name, so nothing was
/// required. This is a SEPARATE parallel-array "overlay" (ov_names/ov_effs),
/// scoped to the function body currently being walked (extended when the walk
/// descends into an `EFn`, carried unchanged through every other node), that
/// records each in-scope function-typed parameter's declared effect labels.
///
/// Deliberately narrower than the general transitive check: callback-parameter
/// labels are checked via `decl_authorizes_effect` WITHOUT the
/// `label_is_effect_var` exemption used below for calls to NAMED top-level
/// functions. That exemption exists to prevent a real unsoundness of its own —
/// naively requiring the LITERAL row-variable token (e.g. `"e"`) to appear in
/// the CALLER's declared row at a call site like `apply(inc, 41)` — since the
/// caller has no way to know the row variable resolves to nothing without
/// call-site effect-row UNIFICATION (matching the argument actually passed
/// against the callee's parameter type), which this pass does not perform. This
/// is exactly the naive fix rejected during #885's investigation: dropping the
/// exemption globally broke `generic_effect_matrix_ok_passthrough_pure.vibe`.
/// The callback-parameter case is different in kind: the row variable and the
/// declared effect being compared live in the SAME function signature (the
/// parameter's `with e` and the enclosing function's own `with e` are
/// the identical token by construction — no cross-call-site instantiation is
/// involved), so a literal-name check here is sound, not a naive shortcut.
/// #1361: a LOCAL `let f = () -> T with E { .. }` is a call-graph leaf just
/// like a top-level function or a callback PARAMETER (#885), but NEITHER table
/// knew about it: `fn_names`/`fn_effs` is built only from top-level SLet/SLetMut
/// bindings, and `build_param_overlay` only from function-typed parameters. So
/// `f()` leaked nothing into the enclosing body, while the closure's own body
/// satisfied its own declared row (the EFn arm's `effect_row_inherit`) — a
/// function declaring `with Stdout` could reach `Env` through a local
/// closure with no diagnostic at all, and file_entry_cacheable /
/// file_tests_cacheable consequently judged such an entry cacheable (its stdout
/// varies with the environment, so the doctest cache replayed a stale run).
/// Registering the binding in the SAME overlay the callback case uses closes
/// both at once, with the same semantics: the row leaks at the call site unless
/// the caller declares it or a `handle` discharges it.
///
/// Only a literal `EFn` value is registered. An ANNOTATED local binding
/// (`let f: () -> T with E = ..`) is desugared to an ascription call
/// (`((__asc: T) -> __asc)(e)`, ascribe_wrap) before this walk runs, so its row
/// is not visible here — that shape keeps the old, permissive behavior rather
/// than being half-checked.
/// #1515: a local binding's row, when the VALUE is a bare NAME rather than a
/// closure literal — `let f = eff` / `let g = f`, an ALIAS of something that
/// already carries a row.
///
/// The `EFn` arm below (#1361) covers a literal with its own declared row, and
/// #885's parameter overlay covers a row-carrying parameter, so an alias was the
/// one shape left where the row vanished: `overlay_bind_local` shadowed the name
/// out and re-registered nothing, and the walker's `ECall` arm then saw a name in
/// no table at all and let the call through unchecked. Measured (and reproducing
/// on the committed seed, so this predates #1451):
///
///   fn eff(s: String) -> Unit with Log::Emit { perform Log::Emit(s) }
///   fn caller() -> Unit { let f = eff; f("boom") }   // compiled clean
///
/// while the direct `eff("boom")` and the parameter form were both correctly
/// rejected. Resolution order matches `lookup_fn_effs`'s own: the OVERLAY first
/// (an inner binding shadows an outer one), then the top-level call-graph map.
fn alias_fn_overlay_labels(name: String, ov_names: Array[String], ov_effs: Array[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int]) -> Array[String] {
  match lookup_fn_effs(ov_names, ov_effs, name) {
    Some(labels) => labels,
    None => match lookup_program_fn_effs(fn_index, fn_effs, name) {
      Some(labels) => labels,
      None => no_str_labels()
    }
  }
}

fn local_fn_overlay_labels(val: Expr, ov_names: Array[String], ov_effs: Array[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int]) -> Array[String] {
  match val {
    EFn(_, _, _, _, eff, _) => effect_row_labels(effect_row_parse(eff)),
    EIdent(n, _) => alias_fn_overlay_labels(n, ov_names, ov_effs, fn_names, fn_effs, fn_index),
    _ => no_str_labels()
  }
}

/// Shadow `name` out of the inherited overlay (a local binding always hides an
/// outer entry of the same name), then re-register it when its value is a
/// row-declaring closure. The new entry goes FIRST so `lookup_fn_effs`'s
/// first-match scan finds it.
fn overlay_bind_local(names: Array[String], effs: Array[Array[String]], name: String, val: Expr, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let shadowed = shadow_overlay(names, effs, name)
  // #1515: resolve an ALIAS against the pre-shadow overlay -- `let f = f`
  // rebinds to the OUTER `f`, so the lookup must see the entry the shadow is
  // about to remove.
  let labels = local_fn_overlay_labels(val, names, effs, fn_names, fn_effs, fn_index)
  // #1723: an empty row is still a lexical binding. Keeping an explicit
  // empty entry is what distinguishes "a pure local shadows this name" from
  // "no local binding; consult the top-level function table".
  if Array::length(labels) == 0 && !program_fn_exists(fn_index, name) {
    return shadowed
  }
  let out_names = [name]
  let out_effs = [labels]
  let (sn, se) = shadowed
  let mut i = 0
  while i < Array::length(sn) {
    Array::push(out_names, Array::get(sn, i))
    Array::push(out_effs, Array::get(se, i))
    i = i + 1
  }
  (out_names, out_effs)
}

fn build_param_overlay(params: Array[(String, Option[TypeExpr])], fn_names: Array[String], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let names = array_empty()
  let effs = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let labels = match ptype {
      Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),
      _ => no_str_labels()
    }
    // #1723: all parameters are lexical bindings. A pure callback (or even a
    // non-function parameter later rejected by typing) must mask a same-named
    // top-level function during this independent effect walk.
    if Array::length(labels) > 0 || program_fn_exists(fn_index, pname) {
      Array::push(names, pname)
      Array::push(effs, labels)
    } else {
      ()
    }
    i = i + 1
  }
  (names, effs)
}

/// A `let apply: [T](f: (T) -> T with e, x: T) -> T = (f, x) -> { f(x) }`
/// binding (separate top-level type annotation + untyped lambda) parses to an
/// `EFn` whose OWN `params` carry no per-parameter `TypeExpr` at all (the types
/// live only on the `SLet`'s `ty` field). `build_param_overlay` needs real
/// per-parameter types to find a callback parameter's declared effect, so this
/// fills in each untyped `EFn` parameter from `ty`'s `TyFn` parameter list at
/// the SAME position — the two lists describe the same signature, so positional
/// pairing is exact. An `EFn` parameter that already carries its own inline
/// type (the `[T](f: (T) -> T with e, ...)` generic-literal spelling used
/// elsewhere in this file) is left untouched; `ty` is consulted only to fill
/// gaps, never to override.
fn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  match ty {
    Some(TyFn(sig_params, _, _)) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, ptype) = Array::get(params, i)
        let effective = match ptype {
          Some(_) => ptype,
          None => if i < Array::length(sig_params) {
            Some(Array::get(sig_params, i))
          } else {
            None
          }
        }
        Array::push(out, (pname, effective))
        i = i + 1
      }
      out
    },
    _ => params
  }
}

/// Transitive effect enforcement (#626): a call to a user function `G` that
/// declares `with E` leaks E into the caller unless the caller declares E or
/// the call is under a `handle ... with E`. Combined with the DIRECT discipline
/// (every function that itself performs/invokes an effectful builtin must declare
/// it — already enforced), this propagates effect requirements up the call graph
/// level by level: every effectful leaf is annotated, so a one-level check at
/// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty
/// => transitive check disabled, preserving the direct-only behavior).
///
/// `ov_names`/`ov_effs` (#885) is the SEPARATE callback-parameter overlay
/// described above, scoped to the function body currently in view (empty at the
/// program's top level and at any call site with no enclosing function-typed
/// parameters in scope).
export fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {
  // #1485: the public entry keeps its 7-arg contract and supplies an EMPTY
  // per-parameter table, which switches call-site row unification off and
  // restores the pre-#1485 exemption. Callers of this entry are unit-test and
  // non-stmts paths that have no call-graph parameter types to offer anyway.
  // Nor has a checker pass published call bindings for this AST (Codex on
  // #3055).
  clear_checker_published_tables()
  check_perform_effects_expr_tx_indexed(root, root_declared, root_in_handle, fn_names, fn_effs, program_fn_index(fn_names), root_ov_names, root_ov_effs)
}

/// The same entry with the program table's index supplied by the caller
/// (#2386 review): the cacheability walks below run it once per test block
/// of a file, and an index rebuilt per block is `blocks x table` of memory
/// the bump lane never frees.
fn check_perform_effects_expr_tx_indexed(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {
  set_entry_user_effect_operations(array_empty())
  check_perform_effects_expr_tx_in("", root, root_declared, root_in_handle, fn_names, fn_effs, fn_index, no_param_effs(), root_ov_names, root_ov_effs, no_kind_binds())
}

/// #639: the same walk with the enclosing top-level binding's NAME threaded in
/// so row-mismatch diagnostics can blame the caller's declaration in the fix-it
/// hint. The name is constant per walk (lambdas are anonymous), so it rides as
/// a plain parameter, not on the work stack.
fn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], fn_param_effs: Array[Array[Array[String]]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]], root_kinds: TkEnv) -> Array[EffectError] {
  let errors = array_empty()
  let scope_depth = Array::length(row_formal_scope)
  Array::push(row_mismatch_roots, root_declared)
  let stack = Array::slice([
    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs, root_kinds)
  ], 0, 1)
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let (expr, declared, in_handle, ov_names, ov_effs, kinds) = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match expr {
      ECall(callee, args, call_off) => {
        match callee {
          EIdent(name, callee_ident_off) => {
            // #1723: the overlay is also the lexical-binding environment.
            // Some([]) means a pure local binding; only None may fall through
            // to the module-level function table.
            let lexical_callee = lookup_fn_effs(ov_names, ov_effs, name)
            if name == "perform?" && Array::length(args) == 1 {
              match perform_question_op_name(Array::get(args, 0)) {
                Some(op_name) => {
                  let lexical_operation = lookup_fn_effs(ov_names, ov_effs, op_name)
                  // ADR-0088 strict grade match, both directions of "the
                  // arm must be reachable" (Codex review on PR #2653): a
                  // block runs with full authority, and a required grant of
                  // the operation or its provider (`allows Fs +
                  // Fs::read_file?`, or a block's ambient `Fs`) absorbs the
                  // optional grade -- either way `NotGranted` cannot run.
                  let required_cover = required_grant_covering_op(declared, op_name)
                  if source_definition_shadows_builtin(op_name, lexical_operation, fn_names, fn_effs, fn_index) {
                    Array::push(errors, EEPerformQuestionSourceShadow(op_name, call_off))
                  } else if String::length(entry_block_display_name(fn_name)) > 0 {
                    Array::push(errors, EEPerformQuestionAlwaysGranted(fn_name, op_name, "", call_off))
                  } else if String::length(required_cover) > 0 {
                    Array::push(errors, EEPerformQuestionAlwaysGranted(fn_name, op_name, required_cover, call_off))
                  } else if decl_authorizes_optional_op(declared, op_name) {
                    ()
                  } else {
                    Array::push(errors, EEPerformQuestionRequiresOptional(fn_name, op_name, call_off))
                  }
                },
                // The operand is not a recognizable operation call, as in
                // `perform? 1`. Reject it here so malformed source never
                // reaches the lowering pass as an internal compiler error.
                None => Array::push(errors, EEPerformQuestionInvalidOperand(call_off))
              }
              match Array::get(args, 0) {
                ECall(_, opargs, _) => {
                  let mut oi = 0
                  while oi < Array::length(opargs) {
                    Array::push(stack, (Array::get(opargs, oi), declared, in_handle, ov_names, ov_effs, kinds))
                    oi = oi + 1
                  }
                },
                _ => ()
              }
            } else if name == "perform" && Array::length(args) == 1 {
              match Array::get(args, 0) {
                ECall(op_callee, opargs, _) => match op_callee {
                  EIdent(op_name, _) => {
                    let eff = effect_name_of_op(op_name)
                    // ADR-0085 Phase 3 (#1344): for `throw(v)` the required
                    // label carries the payload's exception KIND
                    // (`Exception[IoError]::Throw`); every other operation
                    // keeps its own name verbatim.
                    let required_op = throw_required_label(op_name, opargs, kinds, call_off)
                    // #640 Stage 2: `Error` is exempt from the DIRECT
                    // discipline, exactly like the transitive slice below
                    // (`teff != "Error"`) and builtin_call_effect's Error
                    // carve-out — the throw row is pervasive (~970
                    // un-annotated throw sites). `throw(x)` now parses to
                    // `perform Exception::Throw(x)`, so without this exemption
                    // every one of those sites would newly require
                    // `with Exception`.
                    // Codex review (PR #1161): report the qualified
                    // operation (`op_name`, e.g. "Ask::Get"), not the
                    // stripped base effect name -- per docs/internal/design/effectset.md's
                    // operation-level diagnostic contract, a fix-it should
                    // grant only the specific missing operation, not widen
                    // to the whole effect (which would over-grant when a
                    // sibling operation of the same effect is already
                    // authorized at operation granularity, e.g. `with {
                    // Ask::Other }` + a bare `perform Ask::Get`).
                    //
                    // `main` / `_start` only: a block's own `allows` row is
                    // admitted up front (`entry_grant_errors`), and its ambient
                    // default names every provider, so testing it here charged
                    // a user effect that merely reuses a provider spelling
                    // (`effect Console`, #1961) to the block. And a perform
                    // whose qualified operation the enclosing `handle`
                    // discharged (it is in `declared` by name) is not
                    // undischarged, whatever the root row spells.
                    if is_program_entry_name(fn_name) && !in_handle && !effect_row_has_label(Some(declared), op_name) && entry_user_operation_requires_handler(op_name) && decl_authorizes_op(root_declared, op_name) {
                      Array::push(errors, EEUndischargedEntryEffect(fn_name, op_name, effect_name_of_op(op_name), call_off))
                    } else if (!is_exception_effect_name(eff) || error_row_checked() || under_kinded_handle(declared)) && !in_handle && !decl_authorizes_op(declared, required_op) {
                      // #2985 review (Codex P0): under a KINDED handler the
                      // erased exemption is off -- this throw would be caught
                      // by that arm and read at its kind.
                      Array::push(errors, make_contextual_row_error(fn_name, declared, [
                        throw_report_label(op_name, required_op, declared)
                      ], call_off))
                    } else {
                      ()
                    }
                  },
                  _ => ()
                },
                // #1157: a zero-arg operation (`Op -> T`, no parens) parses
                // its `perform` argument as a bare `EIdent`, not an `ECall`
                // — same direct-discipline check as the parenthesized form
                // above, just without an args list to look past.
                EIdent(op_name, _) => {
                  let eff = effect_name_of_op(op_name)
                  if is_program_entry_name(fn_name) && !in_handle && !effect_row_has_label(Some(declared), op_name) && entry_user_operation_requires_handler(op_name) && decl_authorizes_op(root_declared, op_name) {
                    Array::push(errors, EEUndischargedEntryEffect(fn_name, op_name, effect_name_of_op(op_name), call_off))
                  } else if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {
                    Array::push(errors, make_contextual_row_error(fn_name, declared, [
                      op_name
                    ], call_off))
                  } else {
                    ()
                  }
                },
                _ => ()
              }
            } else if source_definition_shadows_builtin(name, lexical_callee, fn_names, fn_effs, fn_index) {
              // #2107: a source definition of this name wins, so the builtin's
              // row is not the one to require -- the callee's OWN declared row
              // is, and the transitive check below reads it. Codegen has the
              // same rule for the print builtins (`cc_ft_has(ctx.func_table,
              // fname)` in expr/compile_call.vibe, #929) and the gate pins it:
              // `fn println(s: String) -> Unit { print("S\n") }` must compile
              // and win over the builtin lowering. Without this the checker
              // would demand `with Console` from callers of a user function that
              // merely reuses the name.
              ()
            } else {
              match builtin_call_effect(name) {
                Some(eff) => {
                  // #1343: authorize at OPERATION granularity as well as by the
                  // bare effect. `with Fs` keeps working unchanged (the
                  // effect check is tried first and is what every existing row
                  // relies on); `with Fs::read_file` now also authorizes,
                  // giving host capabilities the minimal-permission granularity
                  // ADR-0071 defined and `perform Eff::Op` already had. Strictly
                  // a widening -- nothing that compiled before can start failing.
                  let op_label = builtin_call_op_label(name, eff)
                  if !in_handle && !decl_authorizes_effect(declared, eff) && !decl_authorizes_effect(declared, op_label) && !decl_authorizes_op(declared, op_label) {
                    // Report the OPERATION, per ADR-0071's diagnostic contract:
                    // the fix-it should grant the one operation actually needed,
                    // not widen the row to the whole effect (same rule the
                    // perform path follows since Codex review on PR #1161).
                    Array::push(errors, make_contextual_row_error(fn_name, declared, [
                      op_label
                    ], call_off))
                  } else {
                    ()
                  }
                },
                None => ()
              }
            }
            // Transitive (#626): calling a user function leaks its declared
            // effects into this context unless declared here or under a handle.
            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the
            // DIRECT discipline already excludes `Error` (the throw row is
            // pervasive — nearly every function can throw) and `Async`
            // (composition is allowed; the async pass governs it), so the
            // transitive pass mirrors that exclusion. Effect-variable rows
            // (polymorphic) impose nothing HERE — call-site resolution of what
            // a row variable is instantiated to would need real effect-row
            // unification (#885 tracks that separately); naively requiring the
            // row-variable TOKEN itself in the caller's declared row produces
            // false positives (see `generic_effect_matrix_ok_passthrough_pure`).
            let top_level_callee = match lexical_callee {
              Some(_) => None,
              None => lookup_program_fn_effs(fn_index, fn_effs, name)
            }
            match top_level_callee {
              Some(callee_effs) => {
                // #639: aggregate every effect this call site leaks into ONE
                // set-difference diagnostic ("missing { Env, Fs }") instead of
                // one error per label.
                let missing = no_str_labels()
                let mut ti = 0
                while ti < Array::length(callee_effs) {
                  // #3053: the callee's row as THIS call instantiates it.
                  let teff = instantiate_callee_label(Array::get(callee_effs, ti), callee_ident_off, name)
                  Array::set(requirement_marked_cell, 0, (teff, instantiate_callee_label_marked(Array::get(callee_effs, ti), callee_ident_off, name)))
                  // #1343 (Codex P1 on PR #1359): `decl_authorizes_op`, not
                  // `decl_authorizes_effect` -- once a callee can declare an
                  // OPERATION row (`with Fs::read_file`), a caller holding
                  // the WHOLE effect (`with Fs`) must authorize it. The
                  // effect-only check compared labels literally, so the bare
                  // `Fs` failed to cover `Fs::read_file` and calling such a
                  // callee was rejected. decl_authorizes_op tries the base
                  // effect name first, then the exact operation, so both
                  // spellings of the caller's row work and nothing that
                  // authorized before stops authorizing.
                  if label_is_effect_var(teff) {
                    // #1485: a row VARIABLE used to be skipped outright. It is
                    // now resolved AT THIS CALL SITE from the arguments
                    // actually passed to the parameters that carry it, and the
                    // labels it turns out to denote are required like any
                    // other. Unresolvable instantiations still fall through to
                    // the old exemption (see resolve_row_var_instantiation).
                    let callee_param_effs = match lookup_program_fn_param_effs(fn_index, fn_param_effs, name) {
                      Some(pe) => pe,
                      None => no_param_row()
                    }
                    match resolve_row_var_instantiation(teff, callee_param_effs, args, fn_names, fn_effs, fn_index, ov_names, ov_effs) {
                      Some(inst) => {
                        let mut ii = 0
                        while ii < Array::length(inst) {
                          let ieff = Array::get(inst, ii)
                          // #3102 review: the label the variable resolved to
                          // is judged on its own spelling, which was written
                          // in the argument's scope -- so only a builtin word
                          // in it names a certain type (marked mode 1).
                          Array::set(requirement_marked_cell, 0, (ieff, ieff))
                          // Same discipline the concrete branch below applies:
                          // the exception row is row-transparent, and a
                          // variable resolving to another variable is still
                          // unresolved. #2967: `Async` is charged like any
                          // other label.
                          if String::length(ieff) > 0 && (!is_exception_effect_name(ieff) || error_row_checked() || under_kinded_handle(declared)) && !label_is_effect_var(ieff) && !in_handle && !decl_authorizes_op(declared, ieff) {
                            Array::push(missing, ieff)
                          } else {
                            ()
                          }
                          ii = ii + 1
                        }
                      },
                      None => ()
                    }
                  } else if String::length(teff) > 0 && (!is_exception_effect_name(teff) || error_row_checked() || under_kinded_handle(declared)) && !in_handle && !decl_authorizes_op(declared, teff) {
                    Array::push(missing, teff)
                  } else {
                    ()
                  }
                  Array::set(requirement_marked_cell, 0, ("", ""))
                  ti = ti + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_contextual_row_error(fn_name, declared, missing, call_off))
                } else {
                  ()
                }
              },
              None => ()
            }
            // #885: calling a function-typed PARAMETER (a callback) directly —
            // e.g. `f(x)` inside the wrapper that declares `f: (T) -> T with
            // { e }` — leaks `f`'s declared row into this context exactly like
            // a named function call above, but UNLIKE that case a row-variable
            // label here is NOT exempted: the parameter's `with e` and the
            // enclosing function's own declared row live in the SAME
            // signature, so the token `e` denotes the identical variable in
            // both places (no cross-call-site instantiation to resolve), and
            // literal-name membership is a sound check.
            match lexical_callee {
              Some(param_effs) => {
                // #639: aggregated exactly like the named-callee case above.
                let missing = no_str_labels()
                let mut pi = 0
                while pi < Array::length(param_effs) {
                  // #3053 (Codex on #3055): a local generic lambda, or an
                  // alias of one, is a lexical callee; its row is
                  // instantiated at this call exactly like a top-level one.
                  // A callback parameter records no instantiation, so its row
                  // is returned as written.
                  let peff = instantiate_callee_label(Array::get(param_effs, pi), callee_ident_off, name)
                  // A callback parameter records no instantiation: its row
                  // is the annotation as written (`row_label_args_differ`).
                  let peff_marked = if callee_has_marked_bindings(callee_ident_off, name) {
                    instantiate_callee_label_marked(Array::get(param_effs, pi), callee_ident_off, name)
                  } else {
                    String::concat("=", peff)
                  }
                  Array::set(requirement_marked_cell, 0, (peff, peff_marked))
                  Array::set(row_callback_scope_start_cell, 0, row_scope_callback_start(name))
                  // #1343: same operation-awareness as the named-callee case
                  // above -- a callback parameter whose row names an operation
                  // is covered by a caller holding the whole effect.
                  if String::length(peff) > 0 && (!is_exception_effect_name(peff) || error_row_checked() || under_kinded_handle(declared)) && !in_handle && !decl_authorizes_op(declared, peff) {
                    Array::push(missing, peff)
                  } else {
                    ()
                  }
                  Array::set(requirement_marked_cell, 0, ("", ""))
                  Array::set(row_callback_scope_start_cell, 0, 1)
                  pi = pi + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_contextual_row_error(fn_name, declared, missing, call_off))
                } else {
                  ()
                }
              },
              None => ()
            }
          },
          _ => ()
        }
        match callee {
          EIdent(cname, _) => if cname == "perform?" {
            ()
          } else {
            Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs, kinds))
            let mut ai = 0
            while ai < Array::length(args) {
              let arg = Array::get(args, ai)
              Array::push(stack, (arg, closure_arg_declared(arg, declared, cname, lookup_fn_effs(ov_names, ov_effs, cname), ai), in_handle, ov_names, ov_effs, kinds))
              ai = ai + 1
            }
          },
          _ => {
            // A callee that is not a name (a field, a call result) is one
            // this pass cannot see, so a closure literal handed to it stays
            // as strict as the body (closure_arg_declared).
            Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs, kinds))
            let mut bi = 0
            while bi < Array::length(args) {
              Array::push(stack, (Array::get(args, bi), declared, in_handle, ov_names, ov_effs, kinds))
              bi = bi + 1
            }
          }
        }
      },
      EFn(tparams, _, params, fret, effect, body) => {
        // ADR-0088: the grade check reaches a closure literal's annotations
        // too -- its own row, its parameters' rows, its return type's rows --
        // named after the enclosing binding (Codex review, PR #2653).
        append_eff_errs(errors, optional_grade_errors(fn_name, labels_union(effect_row_labels(effect_row_parse(effect)), nested_type_rows(None, expr))))
        // #761: an EXPLICITLY-annotated lambda (`(x) -> { .. } with E`) is
        // checked against its own row E. An UN-annotated lambda's effect row is
        // INFERRED, not declared, so checking its body against an empty row is
        // wrong — it wrongly rejected an inline effectful lambda passed to a HOF
        // param whose type declares the effect (bidirectional effect checking,
        // e.g. `call_twice((c) -> { write_char(c) })`). Inherit the enclosing
        // declared context instead: the lambda may use any effect available
        // where it is written (its inferred row is surfaced in its type and
        // re-checked at the call/handle site). Conservative — like the
        // mutability pass, this can only miss errors, never invent them.
        // #1451: a closure LITERAL also inherits the rows the enclosing binding's
        // RETURN type declares for the function values it produces (see
        // ret_fn_row_labels). Without this, `fn make() -> (String) -> Unit with E
        // { (s) -> { perform E::Op(s) } }` charged the perform to `make`, whose
        // own row is (correctly) empty -- the row belongs to the RETURNED value.
        // Only literals get it; the enclosing body's own direct performs do not.
        // #2985 review (Codex P0): a closure literal created and CALLED
        // inside a kinded handle keeps the handle's strictness (its throws
        // reach that arm: `let f = () -> Int { throw(7) }; f()` under
        // `Exception[String]` read `7` as a String). Only a literal passed
        // directly as a call ARGUMENT is relaxed, at the call site and only
        // when the callee's signature shows it discharges the throws
        // (closure_arg_declared).
        let body_declared = effect_row_inherit(effect_row_parse(effect), labels_union(declared, current_ret_fn_rows()))
        // #885: extend the callback-parameter overlay with THIS function's own
        // function-typed parameters (if any carry a declared effect), scoped to
        // its body. New entries are appended AHEAD of the inherited overlay so
        // `lookup_fn_effs` (first-match) has a same-named inner parameter
        // shadow an outer one.
        //
        // #885 review (Codex): shadowing must apply to EVERY one of this
        // lambda's own parameter names, not just the ones that end up in
        // local_names/local_effs (function-typed with a declared effect) --
        // a parameter reusing an outer callback's name with a DIFFERENT type
        // (e.g. plain `Int`, or a function type with no declared effect) must
        // still block the inherited entry, or a call to the new, unrelated
        // parameter is wrongly checked against the shadowed outer callback's
        // effect row.
        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)
        let (shadowed_ov_names, shadowed_ov_effs) = shadowed
        let (local_names, local_effs) = build_param_overlay(params, fn_names, fn_index)
        let body_ov_names = if Array::length(local_names) == 0 {
          shadowed_ov_names
        } else {
          let merged = Array::slice(local_names, 0, Array::length(local_names))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_names) {
            Array::push(merged, Array::get(shadowed_ov_names, oi))
            oi = oi + 1
          }
          merged
        }
        let body_ov_effs = if Array::length(local_effs) == 0 {
          shadowed_ov_effs
        } else {
          let merged = Array::slice(local_effs, 0, Array::length(local_effs))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_effs) {
            Array::push(merged, Array::get(shadowed_ov_effs, oi))
            oi = oi + 1
          }
          merged
        }
        // #1344 follow-up: a lambda's parameters enter the payload-kind scope
        // from their annotations, exactly like a top-level function's.
        // #3095: the body's formal scope. A lambda that declares its own row
        // reads that row with its own formals in scope; one that inherits the
        // enclosing row does not rebind the row's words, so it adds nothing --
        // unless it also inherits the enclosing binding's RETURN-type rows,
        // written outside every nested binder, which no scope can place.
        let own_row = match effect_row_parse(effect) {
          Some(_) => true,
          None => false
        }
        let entry = array_empty()
        let names = tparam_names(tparams)
        let mut ni = 0
        while ni < Array::length(names) {
          if own_row {
            Array::push(entry, Array::get(names, ni))
          } else {
            Array::push(entry, String::concat("@", Array::get(names, ni)))
          }
          ni = ni + 1
        }
        if !own_row && Array::length(current_ret_fn_rows()) > 0 && !row_scope_decl_is_root() {
          Array::push(entry, row_scope_unknown())
        }
        let mut li = 0
        while li < Array::length(local_names) {
          Array::push(entry, row_scope_callback_marker(Array::get(local_names, li)))
          li = li + 1
        }
        if Array::length(entry) > 0 {
          Array::push(row_formal_scope, entry)
          Array::push(stack, (EIdent(row_scope_pop_marker(), 0 - 1), declared, in_handle, ov_names, ov_effs, kinds))
        } else {
          ()
        }
        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs, throw_kind_bind_params(kinds, params)))
      },
      EIdent(ident, _) => if ident == row_scope_pop_marker() {
        row_scope_pop()
      } else {
        ()
      },
      EHandle(body, arms) => {
        if Array::length(arms) == 0 {
          Array::push(errors, EEEmptyHandle)
        } else {
          ()
        }
        let discharged = collect_handle_effects(arms)
        // #2985 review (Codex P0): the exception channel carries no kind and
        // codegen compiles only the FIRST exception arm, so a second one can
        // never run -- `Exception[String]::Throw` + `Exception[Int]::Throw`
        // routed an Int throw into the String arm (`14`). One exception arm
        // per handle.
        let exc_arms = exception_effect_labels(discharged)
        if Array::length(exc_arms) > 1 {
          Array::push(errors, EEMultipleExceptionArms(fn_name, join_labels(exc_arms)))
        } else {
          ()
        }
        // #2985 review (Codex P0): a kinded arm is a catch-all at run time,
        // so the body must not raise any exception this handle does not
        // name -- neither one the OUTER row would have let propagate (it
        // would be caught here instead, and read at the wrong type) nor one
        // of unresolved kind. The outer row's exception labels are dropped
        // for the body and the marker makes the exception check exact. An
        // ERASED arm is a new catch-all boundary: everything its body raises
        // ends in it, so an enclosing kinded handle's marker is cleared.
        let body_declared = if Array::length(kinded_exception_labels(discharged)) > 0 {
          labels_union(labels_union(labels_without_exception_family(declared), discharged), [
            kinded_handle_marker()
          ])
        } else if Array::length(exc_arms) > 0 {
          labels_union(labels_without_exception_family_marker(declared), discharged)
        } else {
          labels_union(declared, discharged)
        }
        // Unknown wildcard arms stay conservative for the legacy surface,
        // but a structurally empty handler must not gain that permission.
        // Known discharge stays out of `in_handle`: that flag also skips the
        // undeclared-effect check, so treating `handle Ask` as "inside a
        // handle" lets `Logger` leak through (#626 criterion 2). Discharge
        // of the named effect is already in `body_declared`.
        let body_in_handle = if Array::length(arms) > 0 && Array::length(discharged) == 0 {
          true
        } else {
          in_handle
        }
        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs, kinds))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (arm_pat, arm_body) = Array::get(arms, ai)
          let (arm_ov_names, arm_ov_effs) = overlay_bind_empty_pat(ov_names, ov_effs, arm_pat, fn_names, fn_index)
          Array::push(stack, (arm_body, declared, in_handle, arm_ov_names, arm_ov_effs, throw_kind_bind_pat(kinds, arm_pat)))
          ai = ai + 1
        }
      },
      ELet(name, val, body, _) => {
        // #885 review (Codex): `val` is evaluated in the OUTER scope (ELet is
        // non-recursive), so only the body's overlay needs the new binding
        // shadowed out. #1361: the same place registers a local closure's own
        // declared row, so calling it from the body leaks that row.
        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
        // #1344 follow-up: the local's payload kind is its initializer's, read
        // in the OUTER scope for the same non-recursive reason.
        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      ELetRec(name, val, body) => {
        // #885 review (Codex): unlike ELet, `let rec` allows `val` itself to
        // reference `name` (self-recursion), so both val and body need the
        // shadow applied -- and, since #1361, the local closure's own row, so a
        // recursive effectful closure is checked against it on both sides.
        let (rec_ov_names, rec_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
        // A `let rec` value is a function; there is no payload kind to read off
        // it, so the name binds unresolvable on both sides (which is also what
        // stops it resolving through a same-named top-level binding).
        let rec_kinds = throw_kind_bind(kinds, name, "")
        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))
        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))
      },
      ELetMut(name, val, body, _) => {
        // #885 review (Codex): same as ELet -- non-recursive, only body shadows.
        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
        // A `mut` binding keeps one type for its whole life (an assignment of a
        // different type is a type error), so its initializer's kind holds for
        // the body just as ELet's does.
        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      ESeq(a, b) => {
        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EIf(cond, then_e, else_e) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EMatch(scrutinee, arms) => {
        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs, kinds))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (arm_pat, arm_body) = Array::get(arms, ai)
          let (arm_ov_names, arm_ov_effs) = overlay_bind_empty_pat(ov_names, ov_effs, arm_pat, fn_names, fn_index)
          Array::push(stack, (arm_body, declared, in_handle, arm_ov_names, arm_ov_effs, throw_kind_bind_pat(kinds, arm_pat)))
          ai = ai + 1
        }
      },
      EWhile(cond, body) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs, kinds))
      },
      ELoop(params, body) => {
        // A loop parameter is re-bound by every `continue`, so its initializer's
        // kind does not describe it for the whole body: it binds unresolvable.
        let mut body_kinds = kinds
        let loop_names = array_empty()
        let mut i = 0
        while i < Array::length(params) {
          let (pname, init) = Array::get(params, i)
          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs, kinds))
          body_kinds = throw_kind_bind(body_kinds, pname, "")
          Array::push(loop_names, pname)
          i = i + 1
        }
        let (body_ov_names, body_ov_effs) = overlay_bind_empty_names(ov_names, ov_effs, loop_names, fn_names, fn_index)
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      EForIn(value_name, index_name, iter, body) => {
        // The element (and optional index) binder has no syntactic kind here --
        // it comes from the iterand's element type, which this untyped pass
        // cannot see. Binding them unresolvable is what stops a same-named
        // top-level binding answering for a loop variable.
        let for_kinds = match index_name {
          Some(iname) => throw_kind_bind(throw_kind_bind(kinds, value_name, ""), iname, ""),
          None => throw_kind_bind(kinds, value_name, "")
        }
        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs, kinds))
        let (value_ov_names, value_ov_effs) = overlay_bind_empty(ov_names, ov_effs, value_name, fn_names, fn_index)
        let for_overlay = match index_name {
          Some(iname) => overlay_bind_empty(value_ov_names, value_ov_effs, iname, fn_names, fn_index),
          None => (value_ov_names, value_ov_effs)
        }
        Array::push(stack, (body, declared, in_handle, for_overlay.0, for_overlay.1, for_kinds))
      },
      EBinOp(_, left, right, _) => {
        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs, kinds)),
      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs, kinds)),
      EAssign(_, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EAssignOp(_, _, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs, kinds)),
      ETuple(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))
          ei = ei + 1
        }
      },
      EArray(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))
          ei = ei + 1
        }
      },
      ERecord(rec_sname, fields, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fval) = Array::get(fields, fi)
          // #1451: a closure LITERAL stored into a field whose declared type
          // carries a row may use that row -- the row belongs to the stored
          // VALUE, not to the function assembling the record. Widened for the
          // literal only: any OTHER field expression (a call that performs, say)
          // keeps the enclosing `declared` and stays checked as before.
          let field_declared = match fval {
            EFn(_, _, _, _, _, _) => labels_union(declared, struct_field_rows_for(rec_sname, fname)),
            _ => declared
          }
          Array::push(stack, (fval, field_declared, in_handle, ov_names, ov_effs, kinds))
          fi = fi + 1
        }
      },
      EMap(fields) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fval) = Array::get(fields, fi)
          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs, kinds))
          fi = fi + 1
        }
      },
      ELabeledArg(_, _, value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      ESpread(value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      EBreak(Some(value)) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      EBreak(None) => (),
      EContinue(args) => {
        let mut ai = 0
        while ai < Array::length(args) {
          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs, kinds))
          ai = ai + 1
        }
      },
      // Scoped forms are handled above; any future non-scoped structural
      // expression inherits this frame unchanged.
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) {
          Array::push(stack, (Array::get(children, i), declared, in_handle, ov_names, ov_effs, kinds))
          i = i + 1
        }
      }
    }
  }
  Array::truncate(row_mismatch_roots, Array::length(row_mismatch_roots) - 1)
  Array::truncate(row_formal_scope, scope_depth)
  errors
}

fn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),
    _ => effect_row_labels(effect_row_parse(None))
  }
}

/// #1451: rows declared by FUNCTION TYPES sitting inside a signature's RETURN
/// type. `fn make() -> (String) -> Unit with Log::Emit { (s) -> { perform .. } }`
/// declares that the returned VALUE may perform `Log::Emit`; `make` itself does
/// not, and `sig_type_effect_labels` correctly reports `make`'s own row as empty.
///
/// A closure LITERAL never carries a row of its own (rows are not written at a
/// literal — the pass infers them), so the returned literal's perform was charged
/// to the enclosing function, and the only way to satisfy the checker was to
/// declare a row on `make` that `make` does not have. Collected recursively, so a
/// row nested under `Array[_]` / a tuple / `Option[_]` is found too.
///
/// This set is granted ONLY to nested closure literals (see the walker's `EFn`
/// arm), never to the enclosing body's own statements — a direct
/// `perform Log::Emit(..)` in `make`'s body stays flagged, because that one really
/// does run in `make` with no handler.
fn ret_fn_row_labels_into(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyFn(params, ret, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      let mut li = 0
      while li < Array::length(labels) {
        Array::push(out, Array::get(labels, li))
        li = li + 1
      }
      let mut i = 0
      while i < Array::length(params) {
        ret_fn_row_labels_into(Array::get(params, i), out)
        i = i + 1
      }
      ret_fn_row_labels_into(ret, out)
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        ret_fn_row_labels_into(Array::get(args, i), out)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        ret_fn_row_labels_into(Array::get(elems, i), out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn ret_fn_row_labels(ret: Option[TypeExpr]) -> Array[String] {
  let out = array_empty()
  match ret {
    Some(te) => ret_fn_row_labels_into(te, out),
    None => ()
  }
  out
}

/// Same, from a BINDING annotation (`let make: () -> ((String) -> Unit with E) = ...`)
/// rather than the `fn`'s own arrow. Descends only into the RETURN slot: a
/// PARAMETER's function row is already handled by the callback-parameter overlay
/// (#885), and granting it here would widen the body's permission for no reason.
fn ret_fn_rows_from_sig(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, ret, _)) => {
      let out = array_empty()
      ret_fn_row_labels_into(ret, out)
      out
    },
    _ => array_empty()
  }
}

/// Module-level cell for the current binding's return-type rows, in the same
/// style as `error_row_mode_cell` above: the walker is a flat stack loop with a
/// fixed tuple shape and eight call sites, so threading a ninth parameter through
/// it to reach one arm costs more than it buys. Set per binding by
/// `check_perform_effects_binding_tx`, read by the walker's `EFn` arm. Walks are
/// sequential (one binding at a time), so no save/restore stack is needed.
let ret_fn_rows_cell = array_empty()

fn set_ret_fn_rows(rows: Array[String]) -> Unit {
  Array::truncate(ret_fn_rows_cell, 0)
  Array::push(ret_fn_rows_cell, rows)
}

fn current_ret_fn_rows() -> Array[String] {
  if Array::length(ret_fn_rows_cell) > 0 {
    Array::get(ret_fn_rows_cell, 0)
  } else {
    array_empty()
  }
}

/// #1451 (struct-field position): rows declared by a STRUCT FIELD's type, keyed
/// `Struct::field`. Same defect as the return position and the same cause -- a
/// closure literal stored into
/// `struct Box { run: (String) -> Unit with Log::Emit }` carries no row of its
/// own, so its perform was charged to the function BUILDING the record, which
/// only assembles a closure and never performs it.
///
/// The walker is a flat stack loop with no access to the program's type
/// declarations, so the table is built once per program (from every `SStruct`)
/// and read by the `ERecord` arm -- the same module-cell shape as
/// `ret_fn_rows_cell` above, for the same reason. Only fields whose type
/// actually declares a row get an entry, so the common program adds nothing.
let struct_field_rows_cell = array_empty()

fn struct_field_key(sname: String, fname: String) -> String {
  String::concat(sname, String::concat("::", fname))
}

fn build_struct_field_rows(stmts: Array[Stmt]) -> Unit {
  let keys = array_empty()
  let rows = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fty) = Array::get(fields, fi)
          let out = array_empty()
          ret_fn_row_labels_into(fty, out)
          if Array::length(out) > 0 {
            Array::push(keys, struct_field_key(sname, fname))
            Array::push(rows, out)
          } else {
            ()
          }
          fi = fi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  Array::truncate(struct_field_rows_cell, 0)
  Array::push(struct_field_rows_cell, (keys, rows))
}

fn struct_field_rows_for(sname: String, fname: String) -> Array[String] {
  if Array::length(struct_field_rows_cell) == 0 || String::length(sname) == 0 {
    array_empty()
  } else {
    let (keys, rows) = Array::get(struct_field_rows_cell, 0)
    let want = struct_field_key(sname, fname)
    let mut found = array_empty()
    let mut i = 0
    while i < Array::length(keys) {
      if Array::get(keys, i) == want {
        found = Array::get(rows, i)
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

fn no_str_labels() -> Array[String] {
  array_empty()
}

fn no_ov_effs() -> Array[Array[String]] {
  array_empty()
}

/// Public 3-arg entry: the direct-only check (no call-graph map), preserving the
/// pre-transitive behavior for unit tests and any non-stmts caller.
export fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {
  // Same clearing rule as check_perform_effects_stmt (#1344): no env here, so
  // no payload kinds are resolvable and none must be carried over.
  set_throw_kind_table(EnvEmpty)
  clear_checker_published_tables()
  set_callee_sigs(array_empty(), EnvEmpty)
  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())
}

/// #2107: the ambient test grant, for a `test` / `bench` body that has already
/// been lowered to a function.
///
/// The wasm-gc lane rewrites `test "x" { .. }` into `let __test_x = () -> { .. }`
/// BEFORE the check (entry/source_compile/gc_only) -- it has to, because a
/// `handle` inside a test block is only eligible for the ADR-0076 direct-perform
/// lowering once the block is a named top-level fn. The STest / SBench arms in
/// check_perform_effects_stmt_tx therefore never see those bodies, and without
/// this the identical source checks differently on the two lanes: on gc every
/// assertion in a test wanted `with Stdout` from a function with no row to
/// declare.
///
/// Keyed on the name because the alternative -- writing the row onto the
/// synthesized function -- changes what CODEGEN reads, and the eligibility pass
/// above reads exactly that. The two prefixes are compiler-synthesized and
/// reserved; `cli_support.vibe`, `codegen/wasi/linked_compile.vibe` and
/// `codegen/gc/backend_body.vibe` already key off them the same way. The test's
/// own `with` row (#1508) is looked up under its original name, so
/// `test "x" allows Http` keeps widening the grant after lowering.
fn lowered_test_ambient_effects(fn_name: String) -> Array[String] {
  let n = String::length(fn_name)
  if String::starts_with(fn_name, "__test_") {
    test_ambient_effects(String::substring(fn_name, 7, n))
  } else if String::starts_with(fn_name, "__bench_") {
    test_ambient_effects(String::substring(fn_name, 8, n))
  } else {
    no_str_labels()
  }
}

/// ADR-0088: every row a binding's TYPES write besides its own -- the rows of
/// function-typed parameters (`cb: () -> Unit with Fs::read_file?`), of the
/// return type, and of anything nested under `Array[_]` / a tuple /
/// `Option[_]`, in either spelling of the signature (the annotation `ty`, the
/// `EFn` literal's own parameter and return annotations). Collected with the
/// walk `ret_fn_row_labels` uses, so the grade check sees them all: a `?` on a
/// user effect in a callback's row is the same claim about nothing as on the
/// binding's own row (Codex review, PR #2653). `ty` may be `None` for a bare
/// closure literal.
fn nested_type_rows(ty: Option[TypeExpr], body: Expr) -> Array[String] {
  let out = no_str_labels()
  match ty {
    Some(te) => ret_fn_row_labels_into(te, out),
    None => ()
  }
  match body {
    EFn(_, _, params, fret, _, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, pty) = Array::get(params, i)
        match pty {
          Some(pte) => ret_fn_row_labels_into(pte, out),
          None => ()
        }
        i = i + 1
      }
      match fret {
        Some(rte) => ret_fn_row_labels_into(rte, out),
        None => ()
      }
    },
    _ => ()
  }
  out
}

fn variant_payload_rows_into(variants: Array[(String, Array[TypeExpr])], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(variants) {
    let (_, payload) = Array::get(variants, i)
    let mut pi = 0
    while pi < Array::length(payload) {
      ret_fn_row_labels_into(Array::get(payload, pi), out)
      pi = pi + 1
    }
    i = i + 1
  }
}

fn signature_rows_into(sigs: Array[(String, Array[TypeExpr], TypeExpr)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(sigs) {
    let (_, params, ret) = Array::get(sigs, i)
    let mut pi = 0
    while pi < Array::length(params) {
      ret_fn_row_labels_into(Array::get(params, pi), out)
      pi = pi + 1
    }
    ret_fn_row_labels_into(ret, out)
    i = i + 1
  }
}

/// ADR-0088: the rows written by the function types of a declaration that is
/// not a binding -- a type alias, a struct's fields, an enum's or suberror's
/// payloads, a trait's or an effect's operation signatures, an extern binding
/// -- paired with the declaration's name for the diagnostic. The grade check
/// runs on them so `type Callback = () -> Int with Ask::Get?` is refused like
/// the same row on a binding (Codex review, PR #2653). `("", [])` for any
/// other statement; bindings are covered by `nested_type_rows`.
export fn stmt_type_rows(stmt: Stmt) -> (String, Array[String]) {
  let out = no_str_labels()
  let owner = match stmt {
    STypeAlias(_, name, _, te) => {
      ret_fn_row_labels_into(te, out)
      name
    },
    SStruct(_, name, fields, _, _, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fte) = Array::get(fields, i)
        ret_fn_row_labels_into(fte, out)
        i = i + 1
      }
      name
    },
    SEnum(_, name, _, variants, _) => {
      variant_payload_rows_into(variants, out)
      name
    },
    SSuberror(_, name, variants) => {
      variant_payload_rows_into(variants, out)
      name
    },
    STrait(_, name, _, methods, _, _) => {
      signature_rows_into(methods, out)
      name
    },
    SEffectDef(_, name, _, ops) => {
      signature_rows_into(ops, out)
      name
    },
    SExternLet(name, te) => {
      ret_fn_row_labels_into(te, out)
      name
    },
    _ => ""
  }
  (owner, out)
}

/// ADR-0088: the labels of `labels` that carry the Optional grade on
/// something that is not a host capability. Grades on `Exception`, `Async`
/// and user effects are refused; the entry-admission and handler checks
/// then see the plain label.
fn optional_grade_errors(fn_name: String, labels: Array[String]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    if authority_is_optional(label) && !is_instantiate_authority(label) {
      Array::push(errors, EEOptionalGradeNotCapability(fn_name, label))
    } else {
      ()
    }
    i = i + 1
  }
  errors
}

fn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], fn_param_effs: Array[Array[Array[String]]]) -> Array[EffectError] {
  let sig_labels = sig_type_effect_labels(ty)
  // ADR-0088: `?` marks a host capability optional, on a grant or on a
  // requirement. Anything else carrying the grade -- a user effect, the
  // runtime's `Async`, the boundary's `Exception` -- has no host that could
  // withhold it, so the grade would be a claim about nothing.
  let grade_errors = optional_grade_errors(fn_name, labels_union(labels_union(fn_binding_effects(ty, body), lowered_test_ambient_effects(fn_name)), nested_type_rows(ty, body)))
  let walk_errors = match body {
    // #885: build the callback-parameter overlay for THIS binding's own
    // function value from its (possibly untyped, see merge_param_types_with_sig)
    // parameters, so a direct call to one of them inside the body is checked
    // from the very first stack frame — not just once the walk happens to
    // redescend through a nested `EFn` node.
    EFn(tparams, _, params, fret, eff, fbody) => {
      // #1451: this binding's declared RETURN type may declare rows for the
      // function VALUES it produces. Publish them for nested closure literals
      // (see ret_fn_row_labels' doc comment); the body's own declared set below
      // is deliberately NOT widened by them.
      set_ret_fn_rows(labels_union(ret_fn_rows_from_sig(ty), ret_fn_row_labels(fret)))
      // #1344 follow-up: the same merged parameter list seeds the payload-kind
      // scope, so `fn f(e: IoError) { throw(e) }` resolves from the very first
      // frame -- the walk never re-descends through this EFn to pick the
      // parameters up on its own.
      let merged_params = merge_param_types_with_sig(ty, params)
      let (ov_names, ov_effs) = build_param_overlay(merged_params, fn_names, fn_index)
      // #3095: the declaration's own `[S]` scopes over its header and body.
      Array::truncate(row_formal_scope, 0)
      Array::push(row_formal_scope, tparam_names(tparams))
      let errs = check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(lowered_test_ambient_effects(fn_name), labels_union(sig_labels, effect_row_labels(effect_row_parse(eff)))), false, fn_names, fn_effs, fn_index, fn_param_effs, ov_names, ov_effs, throw_kind_bind_params(no_kind_binds(), merged_params))
      Array::truncate(row_formal_scope, 0)
      errs
    },
    _ => {
      // #1451: a non-EFn binding declares no arrow of its own; clear the cell so
      // the PREVIOUS binding's return-type rows cannot leak into this walk.
      set_ret_fn_rows(ret_fn_rows_from_sig(ty))
      check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, fn_index, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds())
    }
  }
  if Array::length(grade_errors) == 0 {
    walk_errors
  } else {
    let mut wi = 0
    while wi < Array::length(walk_errors) {
      Array::push(grade_errors, Array::get(walk_errors, wi))
      wi = wi + 1
    }
    grade_errors
  }
}

/// #761: a `test {}` / `bench {}` block is a program entry point — it runs under
/// the runtime host, which is the ambient handler for the HOST resource effects
/// (Fs/Env/Stdin/Stdout/Process/Profiler). So a test may invoke a host-effectful
/// function (directly, transitively, or as an unqualified builtin) without a
/// `handle`, exactly as `main` does. This grant was already de-facto true for
/// IMPORTED effectful functions (they are absent from the transitive fn_effs map,
/// so calling them never flagged), but LOCALLY-defined ones (in fn_effs) and
/// direct builtin/perform host effects were wrongly rejected — an asymmetry.
/// Seeding the test/bench declared row with the host set removes it. NON-host
/// (user-defined) effects still require a handler: performing one at runtime with
/// no host handler would trap, so leaving it flagged is correct. Purity/caching
/// is judged separately by file_tests_cacheable (empty declared row), so a test
/// that reaches a host effect still correctly counts as impure/non-cacheable.
/// #944 (ADR-0073 implementation bridge): checked-Error mode. The accepted
/// owner decision makes `Exception::Throw` a fully checked semantic operation
/// (direct throw and `with Exception` callees propagate to the caller's
/// row; discharge via `handle ... with Exception`). Stage A landed this
/// opt-in (`VIBE_CHECK_ERROR_ROW=1`, default off, preserving the old
/// exemption byte-for-byte) while the tree still carried hundreds of
/// row-less throw sites (#640 measured ~970); stage B annotated those and
/// flipped the DEFAULT to checked, leaving `VIBE_CHECK_ERROR_ROW=0` as a
/// temporary opt-OUT escape hatch (wired in cli_adapter.vibe) for any
/// downstream code that hasn't annotated yet. The switch rides in a
/// module-level memo cell (fixtures/module_let_memo_test.vibe pattern)
/// because the effect discipline has no configuration threading and the
/// checker itself is pure (no Env row).
///
/// Scope note: builtin_call_effect's own Error carve-out (a BUILTIN whose
/// declared row is Error) is deliberately NOT flipped by this switch --
/// which builtins should carry a semantic Error row is a separate
/// sub-decision tracked on #944.
let error_row_mode_cell = array_empty()

export fn set_error_row_checked(on: Bool) -> Unit {
  Array::truncate(error_row_mode_cell, 0)
  Array::push(error_row_mode_cell, if on {
    1
  } else {
    0
  })
}

fn error_row_checked() -> Bool {
  Array::length(error_row_mode_cell) > 0 && Array::get(error_row_mode_cell, 0) == 1
}

/// Canonical cache identity for the actual process-wide checker mode. Direct
/// callers that do not configure the cell are unchecked, matching
/// error_row_checked(); CLI callers set the cell explicitly every invocation.
export fn typing_semantics_seed() -> String {
  if error_row_checked() {
    "checked"
  } else {
    "unchecked"
  }
}

// Test/bench default rows are derived from core/standard_effect_policy.vibe
// (`test_bench_default_effects`) rather than a local literal. Each item's
// existing operation-granularity evidence is retained in the policy table.
// 根拠 (Fs/Env の使用 operation 分布、Stdin の推移的要求、Process に退避先の
// 綴りが無いこと) も表側のコメントへ移した。

/// #1508: `(test name, row text)` from the parse's `STestEffectRows` marker.
/// A module cell for the same reason the marker exists at all: the row has to
/// reach the two `STest` / `SBench` arms below without widening either node.
let test_effect_row_tbl: Array[(String, String)] = array_empty()

fn test_row_has_label(labels: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    if Array::get(labels, i) == target {
      found = true
      i = Array::length(labels)
    } else {
      i = i + 1
    }
  }
  found
}

fn set_test_effect_rows(stmts: Array[Stmt]) -> Unit {
  Array::truncate(test_effect_row_tbl, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STestEffectRows(rows) => {
        let mut ri = 0
        while ri < Array::length(rows) {
          Array::push(test_effect_row_tbl, Array::get(rows, ri))
          ri = ri + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// The ambient row a `test` / `bench` body is checked against: the policy
/// default (`core/standard_effect_policy.vibe`) plus whatever the declaration's
/// own `with` clause added.
///
/// A declared row WIDENS rather than replaces. `Exception` and the Stdout/Fs
/// family are what `assert` and ordinary test scaffolding need, and making
/// `with Http` silently drop them would mean every such test had to restate the
/// whole default -- which `docs/internal/design/test-example-capabilities.md` asks for in
/// its "row は完全に明示する" note, but that reads as a rule for a future
/// `with ()` form; taking it now would break every existing test that adds a
/// row. Recorded on #1508.
fn test_ambient_effects(name: String) -> Array[String] {
  let base = test_bench_default_effects()
  let extra = test_declared_row_labels(name)
  let mut ei = 0
  while ei < Array::length(extra) {
    let label = Array::get(extra, ei)
    if test_row_has_label(base, label) {
      ()
    } else {
      Array::push(base, label)
    }
    ei = ei + 1
  }
  base
}

/// The labels a `test` / `bench` block's own `allows` row writes (with any
/// effectset already expanded), without the ambient default. Empty when the
/// block declares no row.
fn test_declared_row_labels(name: String) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(test_effect_row_tbl) {
    let (n, row) = Array::get(test_effect_row_tbl, i)
    if n == name {
      let extra = effect_row_labels(effect_row_parse(Some(row)))
      let mut ei = 0
      while ei < Array::length(extra) {
        Array::push(out, Array::get(extra, ei))
        ei = ei + 1
      }
      i = Array::length(test_effect_row_tbl)
    } else {
      i = i + 1
    }
  }
  out
}

/// A `test` / `bench` block is an entry point, so its own `allows` row is a
/// GRANT and is admitted exactly like `main`'s (`entry_grant_errors`) before
/// the body is walked under the ambient row (the policy default widened by
/// that row). The grade check runs on that row exactly as it does for a
/// binding's declared row.
fn check_perform_effects_block_tx(block_name: String, source_name: String, body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], fn_param_effs: Array[Array[Array[String]]]) -> Array[EffectError] {
  let declared = test_ambient_effects(source_name)
  let errors = entry_grant_errors(block_name, test_declared_row_labels(source_name), first_expr_offset(body))
  append_eff_errs(errors, optional_grade_errors(block_name, declared))
  append_eff_errs(errors, check_perform_effects_expr_tx_in(block_name, body, declared, false, fn_names, fn_effs, fn_index, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds()))
  errors
}

fn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], fn_param_effs: Array[Array[Array[String]]]) -> Array[EffectError] {
  match stmt {
    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs, fn_index, fn_param_effs),
    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs, fn_index, fn_param_effs),
    // The block's row is checked under the synthesized name the gc lane also
    // uses (`__test_x`), so a diagnostic can name the block the reader wrote
    // (`entry_block_display_name`) and its hint can say `allows`.
    STest(tname, body) => check_perform_effects_block_tx(String::concat("__test_", tname), tname, body, fn_names, fn_effs, fn_index, fn_param_effs),
    SBench(bname, body) => check_perform_effects_block_tx(String::concat("__bench_", bname), bname, body, fn_names, fn_effs, fn_index, fn_param_effs),
    SExpr(e) => check_perform_effects_expr_tx_in("", e, effect_row_labels(effect_row_parse(None)), false, fn_names, fn_effs, fn_index, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds())
    _ => array_empty()
  }
}

/// Public 1-arg entry: direct-only (empty map). Kept for unit tests.
export fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {
  // No env to resolve payload kinds from: clear the table rather than let a
  // previous module's bindings decide this one's throw kinds (#1344).
  set_throw_kind_table(EnvEmpty)
  clear_checker_published_tables()
  set_callee_sigs(Array::slice([stmt], 0, 1), EnvEmpty)
  set_entry_user_effect_operations(Array::slice([stmt], 0, 1))
  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs(), program_fn_index(no_str_labels()), no_param_effs())
}

/// #812: seed the transitive call-graph map with the checker ENV's bindings.
/// fn_names/fn_effs was built from the CURRENT module's top-level statements
/// only, so a caller could invoke an IMPORTED `with Fs` function without
/// declaring Fs and reach the filesystem at runtime — while the identical
/// shape with a local callee was rejected. An imported binding's CtFn carries
/// its declared effect row in the env; add every effect-bearing env binding
/// AFTER the local rows (lookup_fn_effs is first-match, so a same-name local
/// row still shadows the env row). Effect-free bindings are skipped — an
/// absent row and an empty row enforce the same (nothing).
/// `every_fn` (the callee-signature table, set_callee_sigs) records every
/// function binding with its parameter rows; the program table keeps the
/// #1485 shape below.
fn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]], every_fn: Bool) -> Unit {
  let fnty = match ty {
    CtForAll(_, _, body) => body,
    _ => ty
  }
  match fnty {
    CtFn(params, _, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      if every_fn {
        Array::push(fn_names, name)
        Array::push(fn_effs, labels)
        Array::push(fn_param_effs, fn_type_param_effects(params))
      } else if Array::length(labels) > 0 {
        Array::push(fn_names, name)
        Array::push(fn_effs, labels)
        // #1485: the three arrays are index-aligned, so SOMETHING is pushed
        // for every binding. #3014: an env-seeded (imported) binding's
        // parameter rows come from its checked `Type` -- an empty entry
        // exempted its row variable, so an unhandled effect passed by name
        // through an imported row-polymorphic helper compiled and trapped.
        Array::push(fn_param_effs, fn_type_param_effects(params))
      } else {
        ()
      }
    },
    _ => ()
  }
}

/// #2968: every label an env (imported) function's row or parameter rows
/// write. A module may spell an effect it reaches only through an imported
/// function's row without importing the effect declaration itself, so these
/// count as known when a row label is validated.
export fn env_row_labels(env: TypeEnv, local_names: Array[String]) -> Array[String] {
  env_row_labels_from(env_fn_sigs(env), local_names)
}

/// Every function binding of an env with its row and parameter rows, in env
/// order (`seed_env_fn_effs` with `every_fn`). Walking the env parses every
/// imported binding's row, and one module's effect pass needs the answer
/// three times -- the callee-signature table, the program table (its
/// non-empty rows), and the unknown-label check -- so it is built once per
/// pass and threaded (`env_fn_sigs` / `*_from`).
export fn env_fn_sigs(env: TypeEnv) -> (Array[String], Array[Array[String]], Array[Array[Array[String]]]) {
  let names = no_str_labels()
  let effs = array_empty()
  let peffs = no_param_effs()
  seed_env_fn_effs(env, names, effs, peffs, true)
  (names, effs, peffs)
}

export fn env_row_labels_from(sigs: (Array[String], Array[Array[String]], Array[Array[Array[String]]]), local_names: Array[String]) -> Array[String] {
  let (names, effs, peffs) = sigs
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(effs) {
    // The checked env also binds this module's own declarations; their rows
    // are what is being validated, so they cannot vouch for themselves.
    let mut own = false
    let mut oi = 0
    while oi < Array::length(local_names) {
      if Array::get(local_names, oi) == Array::get(names, i) {
        own = true
      }
      oi = oi + 1
    }
    if !own {
      let row = Array::get(effs, i)
      let mut j = 0
      while j < Array::length(row) {
        Array::push(out, Array::get(row, j))
        j = j + 1
      }
      let prow = Array::get(peffs, i)
      let mut k = 0
      while k < Array::length(prow) {
        let pr = Array::get(prow, k)
        let mut m = 0
        while m < Array::length(pr) {
          Array::push(out, Array::get(pr, m))
          m = m + 1
        }
        k = k + 1
      }
    }
    i = i + 1
  }
  out
}

/// #2968: the labels of one written row (`Fs + Exception[E] + e`).
export fn row_text_labels(row: String) -> Array[String] {
  effect_row_labels(effect_row_parse(Some(row)))
}

fn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]], every_fn: Bool) -> Unit {
  let mut cur = env
  let mut looping = true
  while looping {
    match cur {
      EnvBind(name, binding, rest) => {
        push_env_fn_eff(name, binding.ty, fn_names, fn_effs, fn_param_effs, every_fn)
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(entries) => {
        let mut ei = 0
        while ei < Array::length(entries) {
          let (ename, binding) = Array::get(entries, ei)
          push_env_fn_eff(ename, binding.ty, fn_names, fn_effs, fn_param_effs, every_fn)
          ei = ei + 1
        }
        looping = false
      },
      EnvEmpty => {
        looping = false
      }
    }
  }
}

fn build_perform_fn_effs(stmts: Array[Stmt], env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Unit {
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, None, EIdent(src, _)) => {
        // #3057: an unannotated top-level ALIAS (`let h = f`) has no row of
        // its own to read; it calls with its source's. It used to be recorded
        // with an empty row, which shadowed the env's entry, so every effect
        // a call of `h` performs was dropped -- `f`'s `with Tick` compiled
        // in a pure caller.
        let (effs, peffs) = toplevel_alias_effects(stmts, env, name, src, 8)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        Array::push(fn_param_effs, peffs)
      },
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
        Array::push(fn_param_effs, fn_binding_param_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
        Array::push(fn_param_effs, fn_binding_param_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
}

/// #3057: the row (and per-parameter rows) a call of the top-level alias
/// `name` carries, `src` being the name it aliases. A source declared in this
/// module is read from its own declaration, following alias chains; any other
/// source (an import) is read from the checked type of `name` itself, whose
/// row the checker respelled against the alias's own quantifiers
/// (`publish_row_formals`), so a call's formal bindings line up with it.
fn toplevel_alias_effects(stmts: Array[Stmt], env: TypeEnv, name: String, src: String, fuel: Int) -> (Array[String], Array[Array[String]]) {
  let mut local = None
  let mut i = 0
  while i < Array::length(stmts) {
    match local {
      Some(_) => (),
      None => match Array::get(stmts, i) {
        SLet(_, _, n, ty, body) => if n == src {
          local = Some((ty, body))
        },
        SLetMut(n, ty, body) => if n == src {
          local = Some((ty, body))
        },
        _ => ()
      }
    }
    i = i + 1
  }
  match local {
    Some((None, EIdent(next, _))) => if fuel > 0 {
      toplevel_alias_effects(stmts, env, name, next, fuel - 1)
    } else {
      env_binding_effects(env, name)
    },
    Some((ty, body)) => (fn_binding_effects(ty, body), fn_binding_param_effects(ty, body)),
    None => env_binding_effects(env, name)
  }
}

/// The row and per-parameter rows of `name`'s checked type in `env`; nothing
/// for a name the env does not bind to a function.
fn env_binding_effects(env: TypeEnv, name: String) -> (Array[String], Array[Array[String]]) {
  let fnty = match env_lookup(env, name) {
    Some(CtForAll(_, _, body)) => Some(body),
    other => other
  }
  match fnty {
    Some(CtFn(params, _, eff)) => (effect_row_labels(effect_row_parse(eff)), fn_type_param_effects(params)),
    _ => (no_str_labels(), array_empty())
  }
}

export fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  check_perform_effects_stmts_env(stmts, EnvEmpty)
}

/// The standalone entry: no checker pass published call bindings or shadow
/// sets for these statements, so a previous program's must not answer
/// (Codex on #3055). The checker calls
/// `check_perform_effects_stmts_env_published` instead, right after
/// publishing them.
export fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  clear_checker_published_tables()
  check_perform_effects_stmts_env_published(stmts, env)
}

export fn check_perform_effects_stmts_env_published(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  check_perform_effects_stmts_env_published_sigs(stmts, env, env_fn_sigs(env))
}

/// `check_perform_effects_stmts_env_published` with `env_sigs` =
/// `env_fn_sigs(env)` already built by the caller.
export fn check_perform_effects_stmts_env_published_sigs(stmts: Array[Stmt], env: TypeEnv, env_sigs: (Array[String], Array[Array[String]], Array[Array[Array[String]]])) -> Array[EffectError] {
  // Build the call-graph effect map (parallel arrays) from every top-level
  // binding's declared row — locals first, then the env's (imported)
  // bindings (#812) — then run the per-stmt check WITH transitive
  // enforcement so a caller must declare (or handle) the effects of the
  // functions it invokes.
  let fn_names = array_empty()
  let fn_effs = array_empty()
  // #1485: the third parallel array is per-PARAMETER rows, used to resolve what
  // a callee's row VARIABLE binds to at each call site. It stays index-aligned
  // with the first two; entries seeded from the env get an empty list, which
  // reads as "no parameter types available here" and leaves those callees on
  // the pre-#1485 exemption.
  let fn_param_effs = no_param_effs()
  build_perform_fn_effs(stmts, env, fn_names, fn_effs, fn_param_effs)
  // The callee-signature table is the same local rows plus EVERY env
  // function; build it before the program table appends its env half.
  set_callee_sigs_from(fn_names, fn_effs, fn_param_effs, env_sigs)
  // The program table's env half is `seed_env_fn_effs` without `every_fn`:
  // the env functions whose own row is non-empty (push_env_fn_eff).
  let (env_names, env_effs, env_peffs) = env_sigs
  let mut ei = 0
  while ei < Array::length(env_names) {
    let labels = Array::get(env_effs, ei)
    if Array::length(labels) > 0 {
      Array::push(fn_names, Array::get(env_names, ei))
      Array::push(fn_effs, labels)
      Array::push(fn_param_effs, Array::get(env_peffs, ei))
    }
    ei = ei + 1
  }
  let fn_index = program_fn_index(fn_names)
  // #1451: struct FIELD rows, for closure literals stored into a field whose
  // declared type carries one (see build_struct_field_rows).
  build_struct_field_rows(stmts)
  // #1508: per-test declared effect rows, from the parse's STestEffectRows
  // marker (see test_ambient_effects).
  set_test_effect_rows(stmts)
  // ADR-0085 Phase 3 (#1344): rebuild the `throw` payload-kind table from the
  // same checked env, so a typed `Exception[K]` row can be compared against
  // what each throw site actually throws.
  set_throw_kind_table(env)
  set_entry_user_effect_operations(stmts)
  let errors = user_provider_collision_errors(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, name, ty, body) => append_eff_errs(errors, check_entry_declared_effects(name, ty, body)),
      SLetMut(name, ty, body) => append_eff_errs(errors, check_entry_declared_effects(name, ty, body)),
      _ => {
        // ADR-0088: the grade check for the rows a non-binding declaration
        // writes (a type alias, struct fields, ..); a binding's rows are
        // covered by check_perform_effects_binding_tx below.
        let (owner, rows) = stmt_type_rows(stmt)
        if String::length(owner) > 0 {
          append_eff_errs(errors, optional_grade_errors(owner, rows))
        } else {
          ()
        }
      }
    }
    select_shadowed_builtin_type_names(stmt)
    append_eff_errs(errors, check_perform_effects_stmt_tx(stmt, fn_names, fn_effs, fn_index, fn_param_effs))
    i = i + 1
  }
  Array::set(shadowed_builtin_type_names_cell, 0, Array::get(shadowed_builtin_type_names_cell, 1))
  // #1347: only once the rows themselves check out — on a program with real
  // row errors every reachability answer is suspect, and a second diagnostic
  // per handle would bury the first.
  if Array::length(errors) == 0 {
    append_eff_errs(errors, check_dead_handles_stmts(stmts, fn_names, fn_effs, fn_index))
  } else {
    ()
  }
  errors
}

//# #1347: a `handle` that can never fire (the handler-switch footgun)
//
// A continuation captured by handler H carries H with it: the suspend
// lowering bakes H's driver into the closure it hands to the arm
// (`resume = (rv) -> .. __scps_driveN(k(rv))`, inline_direct_perform.vibe),
// so invoking that stored continuation later re-enters H no matter what
// handles enclose the invocation. Wrapping the call in a NEW
// `handle .. with E { .. }` therefore switches nothing — the new arms are
// simply dead. That is the semantics (first-class continuations are
// handler-carrying); the defect #1347 reports is that it was SILENT.
//
// The suspend lowering already rejects the same shape when the WRAPPING
// handle is itself suspend-class ("the handle body calls something this
// suspend lowering cannot see through"). Only the tail-resumptive spelling
// slipped through, so this restores the symmetry — measured on the two
// spellings of one program, which differed solely in the wrapping arm.
//
// Flagged iff all three hold:
//   1. the program performs E somewhere (so E is live, not a label pun);
//   2. this handle's body cannot STATICALLY reach any perform of E;
//   3. this handle's body calls an OPAQUE value — a plain lowercase local
//      that is not a top-level binding or a builtin, i.e. exactly the
//      `k(())` of a stored continuation.
//
// All three are load-bearing against real in-tree sites. Without (1),
// `entry.vibe`'s `Profiler` handle (which wraps the whole CLI dispatch —
// an opaque call) and `cache_underlying.vibe`'s module-private `effect Env`
// label pun are flagged: nothing performs those labels, and today's
// vacuous-handle elimination erases them deliberately. Without (3),
// `http_e2e_test`'s client-only `Http` handle is flagged: `Http` IS
// performed by the server wrappers elsewhere, but that body reaches only
// direct host calls, which resolve. (2) is what spares the legitimate
// coroutine handle, whose body performs the effect directly.
//
// Every uncertainty resolves toward NOT flagging: an unresolved callee, a
// row variable, a nested handle, or a row-carrying closure literal all
// count as "may reach", so this pass rejects only handles it can prove
// dead.

fn dh_effect_of_perform_arg(arg: Expr) -> String {
  match arg {
    ECall(EIdent(op_name, _), _, _) => effect_name_of_op(op_name),
    EIdent(op_name, _) => effect_name_of_op(op_name),
    _ => ""
  }
}

/// The effect of `expr` if it is a `perform` call, else "".
fn dh_perform_effect(expr: Expr) -> String {
  match expr {
    ECall(EIdent(name, _), args, _) => if name == "perform" && Array::length(args) == 1 {
      dh_effect_of_perform_arg(Array::get(args, 0))
    } else {
      ""
    },
    _ => ""
  }
}

fn dh_collect_performed_into(expr: Expr, acc: Array[String]) -> Unit {
  let eff = dh_perform_effect(expr)
  if String::length(eff) > 0 && !effect_row_has_label(Some(acc), eff) {
    Array::push(acc, eff)
  } else {
    ()
  }
  let children = expr_children(expr)
  let mut i = 0
  while i < Array::length(children) {
    dh_collect_performed_into(Array::get(children, i), acc)
    i = i + 1
  }
}

/// Every effect the program performs, anywhere. Collected once (rather than
/// re-scanning per handle site) because a large program has many handles.
fn dh_collect_performed_effects(stmts: Array[Stmt]) -> Array[String] {
  let acc = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => dh_collect_performed_into(body, acc),
      SLetMut(_, _, body) => dh_collect_performed_into(body, acc),
      SExpr(e) => dh_collect_performed_into(e, acc),
      STest(_, body) => dh_collect_performed_into(body, acc),
      SBench(_, body) => dh_collect_performed_into(body, acc),
      _ => ()
    }
    i = i + 1
  }
  acc
}

fn dh_declared_effects(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, _) => if effect_row_has_label(Some(out), name) {
        ()
      } else {
        Array::push(out, name)
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// True when any label in `labels` could denote `ename` — base-name match, or
/// a row VARIABLE (which may be instantiated to anything, so it counts).
fn dh_labels_may_be(labels: Array[String], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if label_is_effect_var(l) || row_label_base(effect_name_of_op(l)) == ename {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does this type annotation mention a function row carrying `ename`? An
/// ANNOTATED local binding (`let apply: (String) -> String with Transform
/// = (s) -> { .. }`) is desugared to an ascription call before this walk runs
/// (`((__asc: T) -> __asc)(e)`, ascribe_wrap), so its row survives only in the
/// ascription lambda's PARAMETER annotation -- see fixtures/effect_crossfn_test
/// .vibe, where the handled body's only callee is such a binding.
fn dh_texpr_may_be(t: TypeExpr, ename: String) -> Bool {
  match t {
    TyFn(ps, ret, eff) => if dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) {
      true
    } else {
      dh_texprs_may_be(ps, ename) || dh_texpr_may_be(ret, ename)
    },
    TyApp(_, args) => dh_texprs_may_be(args, ename),
    TyTuple(elems) => dh_texprs_may_be(elems, ename),
    _ => false
  }
}

fn dh_texprs_may_be(ts: Array[TypeExpr], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) && !found {
    found = dh_texpr_may_be(Array::get(ts, i), ename)
    i = i + 1
  }
  found
}

fn dh_params_may_be(params: Array[(String, Option[TypeExpr])], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) && !found {
    let (_, pty) = Array::get(params, i)
    found = match pty {
      Some(t) => dh_texpr_may_be(t, ename),
      None => false
    }
    i = i + 1
  }
  found
}

/// Can this expression statically reach a `perform` of `ename`? Conservative
/// in the "yes" direction: anything unresolved answers true, so a false here
/// really does mean the handler is dead.
fn dh_may_reach(expr: Expr, ename: String, fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], ov_names: Array[String], ov_effs: Array[Array[String]]) -> Bool {
  if dh_perform_effect(expr) == ename {
    true
  } else {
    let direct = match expr {
      // A callee whose declared row carries the effect (or a row variable
      // that could be instantiated to it). Both tables are consulted: named
      // top-level bindings, and the #885/#1361 overlay of function-typed
      // PARAMETERS and row-declaring local closures in scope. The overlay is
      // what spares `TaskGroup::spawn_suspend`, whose handled body's only
      // callee is its own `f: () -> T with Async + Exception` parameter.
      ECall(EIdent(nm, _), _, _) => match lookup_program_fn_effs(fn_index, fn_effs, nm) {
        Some(effs) => dh_labels_may_be(effs, ename),
        None => match lookup_fn_effs(ov_names, ov_effs, nm) {
          Some(effs) => dh_labels_may_be(effs, ename),
          None => false
        }
      },
      // A closure LITERAL whose row carries the effect: it may be invoked
      // from anywhere inside this body, including through a value this walk
      // cannot follow. Its PARAMETER annotations count too -- that is where
      // an ascription-wrapped annotated local keeps its row.
      EFn(_, _, params, ret, eff, _) => dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) || dh_params_may_be(params, ename) || (match ret {
        Some(rt) => dh_texpr_may_be(rt, ename),
        None => false
      }),
      // A nested handle is not analysed for discharge here -- treating it as
      // reaching is the safe direction (it only ever suppresses a report).
      EHandle(_, _) => true,
      // #1515: a LOCAL binding of a row-carrying value is in neither table
      // until `overlay_bind_local` registers it, and the generic child walk
      // below descends with the OUTER overlay -- so `handle { let f = eff;
      // f(..) }` looked like it reached no perform and was reported dead.
      // Rebuild the overlay here exactly as `dh_check_expr` does, so the two
      // halves of the dead-handle judgement share one notion of scope.
      //
      // This matters BECAUSE of the row fix in this same change: requiring the
      // row makes `handle` the other way to satisfy the checker, and that way
      // was answering with a false "can never fire" (measured on the committed
      // seed too, so the false positive predates the row fix -- it was just
      // unreachable while the row was never required).
      ELet(lname, lval, lbody, _) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs, fn_index) {
        (bn, be) => dh_may_reach(lval, ename, fn_names, fn_effs, fn_index, ov_names, ov_effs) || dh_may_reach(lbody, ename, fn_names, fn_effs, fn_index, bn, be)
      },
      ELetMut(lname, lval, lbody, _) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs, fn_index) {
        (bn, be) => dh_may_reach(lval, ename, fn_names, fn_effs, fn_index, ov_names, ov_effs) || dh_may_reach(lbody, ename, fn_names, fn_effs, fn_index, bn, be)
      },
      // `let rec` may reference itself, so both sides see the rebound overlay
      // (same asymmetry the transitive walk's ELetRec arm keeps).
      ELetRec(lname, lval, lbody) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs, fn_index) {
        (rn, re) => dh_may_reach(lval, ename, fn_names, fn_effs, fn_index, rn, re) || dh_may_reach(lbody, ename, fn_names, fn_effs, fn_index, rn, re)
      },
      _ => false
    }
    if direct {
      true
    } else {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) {
        if !found && dh_may_reach(Array::get(children, i), ename, fn_names, fn_effs, fn_index, ov_names, ov_effs) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

/// A call to a plain lowercase, unqualified name that is neither a top-level
/// binding nor a builtin: a local value holding a function, which is what a
/// stored continuation is. Constructors (capitalised) and qualified names
/// (`Fs::read_file`, `T::method`) are resolvable and never count; so does any
/// non-`EIdent` callee, deliberately -- narrowing to this one shape is what
/// keeps the rule free of false positives on ordinary code.
fn dh_callee_is_opaque(nm: String, fn_names: Array[String], fn_index: MutMap[String, Int]) -> Bool {
  if String::length(nm) == 0 || nm == "perform" || nm == "resume" {
    false
  } else if String::index_of(nm, "::") >= 0 {
    false
  } else {
    let c = String::char_code_at(nm, 0)
    if c >= 65 && c <= 90 {
      false
    } else if program_fn_exists(fn_index, nm) {
      false
    } else {
      match lookup_builtin(canonical_builtin_name(nm)) {
        Some(_) => false,
        None => true
      }
    }
  }
}

fn dh_has_opaque_call(expr: Expr, fn_names: Array[String], fn_index: MutMap[String, Int]) -> Bool {
  let direct = match expr {
    ECall(EIdent(nm, _), _, _) => dh_callee_is_opaque(nm, fn_names, fn_index),
    _ => false
  }
  if direct {
    true
  } else {
    let children = expr_children(expr)
    let mut i = 0
    let mut found = false
    while i < Array::length(children) {
      if !found && dh_has_opaque_call(Array::get(children, i), fn_names, fn_index) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// Scope-aware descent: the #885/#1361 overlay of in-scope function-typed
/// parameters and row-declaring local closures is rebuilt exactly as the
/// transitive walk above rebuilds it, so a handle site is judged against the
/// same notion of "this callee's declared row" the row checker itself uses.
fn dh_check_expr(expr: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], ov_names: Array[String], ov_effs: Array[Array[String]], errors: Array[EffectError]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      let handled = collect_handle_effects(arms)
      let mut i = 0
      while i < Array::length(handled) {
        let eff = Array::get(handled, i)
        if effect_row_has_label(Some(declared), eff) && effect_row_has_label(Some(performed), eff) && !dh_may_reach(body, eff, fn_names, fn_effs, fn_index, ov_names, ov_effs) && dh_has_opaque_call(body, fn_names, fn_index) {
          Array::push(errors, EEHandleNeverFires(eff))
        } else {
          ()
        }
        i = i + 1
      }
      dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, ov_names, ov_effs, errors)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        dh_check_expr(arm_body, declared, performed, fn_names, fn_effs, fn_index, ov_names, ov_effs, errors)
        ai = ai + 1
      }
    },
    EFn(_, _, params, _, _, body) => {
      let (bn, be) = dh_overlay_with_params(ov_names, ov_effs, params, fn_names, fn_index)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, bn, be, errors)
    },
    ELet(name, val, body, _) => {
      dh_check_expr(val, declared, performed, fn_names, fn_effs, fn_index, ov_names, ov_effs, errors)
      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, bn, be, errors)
    },
    ELetMut(name, val, body, _) => {
      dh_check_expr(val, declared, performed, fn_names, fn_effs, fn_index, ov_names, ov_effs, errors)
      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, bn, be, errors)
    },
    ELetRec(name, val, body) => {
      let (rn, re) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs, fn_index)
      dh_check_expr(val, declared, performed, fn_names, fn_effs, fn_index, rn, re, errors)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, rn, re, errors)
    },
    _ => {
      let children = expr_children(expr)
      let mut c = 0
      while c < Array::length(children) {
        dh_check_expr(Array::get(children, c), declared, performed, fn_names, fn_effs, fn_index, ov_names, ov_effs, errors)
        c = c + 1
      }
    }
  }
}

/// Strip a trailing `~` (labeled) / `?` (optional) marker — a parameter is
/// DECLARED as `f~` but CALLED as `f()`, so the overlay key must be the base
/// name or the lookup misses. fixtures/effect_inline_lambda_literal_labeled_
/// arg.vibe is exactly that shape: its handled body's only callee is the
/// labeled parameter `f~: () -> Int with Log`.
fn dh_param_base_name(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

fn dh_overlay_with_params(ov_names: Array[String], ov_effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])], fn_names: Array[String], fn_index: MutMap[String, Int]) -> (Array[String], Array[Array[String]]) {
  let (sn, se) = shadow_overlay_names(ov_names, ov_effs, params)
  let (raw_ln, le) = build_param_overlay(params, fn_names, fn_index)
  let ln = for n in raw_ln {
    dh_param_base_name(n)
  }
  if Array::length(ln) == 0 {
    (sn, se)
  } else {
    let names = Array::slice(ln, 0, Array::length(ln))
    let effs = Array::slice(le, 0, Array::length(le))
    let mut i = 0
    while i < Array::length(sn) {
      Array::push(names, Array::get(sn, i))
      Array::push(effs, Array::get(se, i))
      i = i + 1
    }
    (names, effs)
  }
}

fn dh_check_binding(ty: Option[TypeExpr], body: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int], errors: Array[EffectError]) -> Unit {
  match body {
    // Seed the overlay from THIS binding's own parameters, exactly as
    // check_perform_effects_binding_tx does -- descending straight into
    // `fbody` would otherwise lose them (the top-level annotation, not the
    // EFn node, is where a separately-typed signature keeps its rows).
    EFn(_, _, params, _, _, fbody) => {
      let (n, e) = dh_overlay_with_params(no_str_labels(), no_ov_effs(), merge_param_types_with_sig(ty, params), fn_names, fn_index)
      dh_check_expr(fbody, declared, performed, fn_names, fn_effs, fn_index, n, e, errors)
    },
    _ => dh_check_expr(body, declared, performed, fn_names, fn_effs, fn_index, no_str_labels(), no_ov_effs(), errors)
  }
}

fn check_dead_handles_stmts(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]], fn_index: MutMap[String, Int]) -> Array[EffectError] {
  let errors = array_empty()
  let declared = dh_declared_effects(stmts)
  if Array::length(declared) == 0 {
    errors
  } else {
    let performed = dh_collect_performed_effects(stmts)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(_, _, _, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, fn_index, errors),
        SLetMut(_, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, fn_index, errors),
        SExpr(e) => dh_check_binding(None, e, declared, performed, fn_names, fn_effs, fn_index, errors),
        STest(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, fn_index, errors),
        SBench(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, fn_index, errors),
        _ => ()
      }
      i = i + 1
    }
    errors
  }
}

/// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result
/// is safe to cache/skip only when running it depends on nothing external — no
/// I/O, no non-determinism — so it is a deterministic function of source + deps +
/// compiler version. file_tests_cacheable is true iff the file has at least one
/// `test {}` block and EVERY test block is transitively effect-free.
///
/// Reuses the transitive effect walk: a test body checked with an EMPTY declared
/// row reports an error for ANY effect it reaches that a `handle` does not
/// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the
/// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`
/// are excluded by that pass, so they stay cacheable; a `handle` that fully
/// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.
/// Zero errors => cacheable.
///
/// A direct `sh`/`sh_lines` call IS surfaced: builtin_call_effect special-cases
/// these two unqualified builtins to `Process` (they lower to real host imports),
/// so a test that shells out is correctly treated as impure/non-cacheable, the
/// same as `sh` reached through a user function declaring `with Process`.
/// Conservative otherwise: an effect the type system does not surface here stays
/// invisible, but it never marks a genuinely-impure test cacheable.
export fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
  let empty_decl = array_empty()
  let fn_index = program_fn_index(fn_names)
  set_callee_sigs(stmts, EnvEmpty)
  let mut any_test = false
  let mut all_ok = true
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(_, body) => {
        any_test = true
        let errs = check_perform_effects_expr_tx_indexed(body, empty_decl, false, fn_names, fn_effs, fn_index, no_str_labels(), no_ov_effs())
        if Array::length(errs) != 0 {
          all_ok = false
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  any_test && all_ok
}

/// #819 (Codex review, PR #1214): entry-function counterpart of
/// file_tests_cacheable above, for a program compiled with a normal ENTRY
/// function (e.g. `fn main`) instead of `test {}` blocks -- used by
/// scripts/vibe_md.vibex's ```vibe run block execute-cache. Unlike a test's
/// empty declared row, `Stdout` is declared-safe here: it is the block's
/// PRODUCED, CAPTURED value (the exact thing the cache stores and compares
/// against the doc's ```output block), not a hidden nondeterminism source.
/// `Error`/`Async` are exempt for the same reason file_tests_cacheable
/// leaves them out -- a throwing entry never reaches the caller's cache-write
/// path anyway (run_one_block only caches on a successful `_start`), and
/// Async is composition, not itself a host nondeterminism source. Any OTHER
/// reachable effect (Fs/Env/Http/Process/Socket/custom/...) means the
/// entry's stdout can vary between runs of byte-identical compiled wasm, so
/// it must NOT be treated as cacheable -- returns false if `entry_name` is
/// not found among the file's top-level bindings.
export fn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut entry_body = None
  let mut entry_declared = None
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      SLetMut(name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      _ => ()
    }
    m = m + 1
  }
  match entry_body {
    None => false,
    Some(body) => {
      // Entry-cache-safe labels are derived from
      // core/standard_effect_policy.vibe in existing order. Their policy
      // decisions, including provider output and entry/runtime handling, are
      // unchanged.
      let cache_safe_row = entry_cache_safe_effects()
      // Codex review, PR #1215: belt-and-suspenders on top of the
      // reachable-effects walk below. That walk shares check_perform_
      // effects_expr_tx's own limitation (also present, unchanged, in the
      // established `vibe test` cache via file_tests_cacheable above): a
      // LOCAL closure defined inside the body is checked under its OWN
      // declared row (so an inner `with Env` satisfies itself and never
      // surfaces as an error at this call site), and a row-POLYMORPHIC
      // callee's effect-VARIABLE labels are deliberately treated as "leaks
      // nothing" here (real call-site row-variable instantiation tracking
      // is #885, not implemented by this pass -- see the "Effect-variable
      // rows (polymorphic) impose nothing HERE" comment near
      // check_perform_effects_expr_tx_in's transitive-leak check above).
      // Neither gap is new to this PR. Closing it outright would need #885-
      // class compiler work, out of proportion for a doctest-cache
      // hardening -- instead, conservatively reject up front whenever the
      // entry's OWN declared row names anything outside the safe set. A
      // real top-level `main` is never itself row-polymorphic, so this is a
      // cheap, purely-additive net that catches the common/direct case
      // (`fn main allows Stdout + Env { ... }`) even in scenarios the
      // deeper walk alone would miss. Bare `Console` is not in that safe
      // set -- it can read -- but `println` requires it. When the body is
      // provably only stdout writes, cache it; a nested function stays out.
      let declared_ok = match entry_declared {
        None => true,
        Some(row) => labels_are_entry_cache_safe(row)
      }
      // `body` (from SLet/SLetMut) is the closure VALUE bound to
      // entry_name, e.g. `EFn(type_params, bounds, params, ret_ty,
      // effect, fn_body)` for `fn main allows <row> { ... }` -- checking
      // the EFn NODE itself would trivially find zero reachable effects
      // (defining a closure performs nothing; only CALLING it would),
      // silently marking every entry cacheable regardless of what it
      // does. The walk needs `fn_body`, the 6th field, not the literal.
      // Parameters are in scope for fn_body and are not in the module fn
      // table. A parameter named println / print / Console / Stdout is that
      // binding, including the labeled `println~` / optional `println?`
      // spellings whose call site uses the base name.
      let (exec_body, params_hide) = match body {
        EFn(_, _, params, _, _, fn_body) => (fn_body, params_hide_stdout_write(params)),
        _ => (body, false)
      }
      if !declared_ok {
        match entry_declared {
          Some(row) => !params_hide && console_entry_is_output_only(row, exec_body, fn_names),
          None => false
        }
      } else {
        set_callee_sigs(stmts, EnvEmpty)
        let errs = check_perform_effects_expr_tx_indexed(exec_body, cache_safe_row, false, fn_names, fn_effs, program_fn_index(fn_names), no_str_labels(), no_ov_effs())
        Array::length(errs) == 0
      }
    }
  }
}

/// A declared `Console` row includes input, so it is not cache-safe by
/// itself (`is_entry_cache_safe_operation`). `println` / `print` require
/// that broad label anyway. An entry is still cacheable when every other
/// declared label is cache-safe and the body is provably output-only:
/// the builtin `println` / `print` and the stdout `write_stream` /
/// `write_char` spellings, and only when nothing in the module shadows
/// those names. A nested function, a `for` (its desugar inserts the
/// iterator call), and an interpolation are not inspected.
fn str_list_has(xs: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn binding_hides_stdout_write(name: String) -> Bool {
  name == "println" || name == "print" || name == "Console" || name == "Stdout"
  // review-lint: allow-effect-name-compare -- a source spelling that can shadow a write, not an effect policy
}

fn params_hide_stdout_write(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    if binding_hides_stdout_write(dh_param_base_name(name)) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn pats_hide_stdout_write(pats: Array[Pat]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(pats) {
    if pat_hides_stdout_write(Array::get(pats, i)) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn pat_hides_stdout_write(pat: Pat) -> Bool {
  match pat {
    PWild => false,
    PBind(name) => binding_hides_stdout_write(name),
    PInt(_) => false,
    PFloat(_) => false,
    PString(_) => false,
    PBool(_) => false,
    PCtor(_, args) => pats_hide_stdout_write(args),
    PTuple(args) => pats_hide_stdout_write(args),
    POr(left, right) => pat_hides_stdout_write(left) || pat_hides_stdout_write(right),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hide = false
      while i < Array::length(fields) {
        let (_, inner) = Array::get(fields, i)
        if pat_hides_stdout_write(inner) {
          hide = true
        } else {
          ()
        }
        i = i + 1
      }
      hide
    }
  }
}

fn call_is_captured_output(callee: Expr, fn_names: Array[String]) -> Bool {
  match callee {
    EIdent(name, _) => {
      if str_list_has(fn_names, name) {
        false
      } else {
        name == "println" || name == "print" || name == "Console::write_stream" || name == "Console::write_char" || name == "Stdout::write_stream" || name == "Stdout::write_char"
      }
    },
    EDot(recv, field, _, _) => {
      match recv {
        EIdent(head, _) => {
          if str_list_has(fn_names, head) {
            false
          } else {
            (head == "Console" || head == "Stdout") && (field == "write_stream" || field == "write_char")
            // review-lint: allow-effect-name-compare -- matches the written qualifier of a write call, not an effect policy
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

fn exprs_are_captured_output(xs: Array[Expr], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(xs) {
    if !expr_is_captured_output(Array::get(xs, i), fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn expr_pairs_are_captured_output(xs: Array[(String, Expr)], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(xs) {
    let (_, value) = Array::get(xs, i)
    if !expr_is_captured_output(value, fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn loop_inits_hide_stdout_write(inits: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(inits) {
    let (name, _) = Array::get(inits, i)
    if binding_hides_stdout_write(name) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn arms_are_captured_output(arms: Array[(Pat, Expr)], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    if pat_hides_stdout_write(pat) || !expr_is_captured_output(body, fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn expr_keeps_stdout_write(name: String, value: Expr, body: Expr, fn_names: Array[String]) -> Bool {
  if binding_hides_stdout_write(name) {
    false
  } else {
    expr_is_captured_output(value, fn_names) && expr_is_captured_output(body, fn_names)
  }
}

/// `|>` is still an `EBinOp` here. Desugar turns it into a call of the
/// right-hand side, so that side is the callee, not a pure operand.
fn pipe_rhs_is_captured_output(right: Expr, fn_names: Array[String]) -> Bool {
  match right {
    ECall(callee, args, _) => call_is_captured_output(callee, fn_names) && exprs_are_captured_output(args, fn_names),
    EIdent(_, _) => call_is_captured_output(right, fn_names),
    EDot(_, _, _, _) => call_is_captured_output(right, fn_names),
    _ => false
  }
}

fn expr_is_captured_output(expr: Expr, fn_names: Array[String]) -> Bool {
  match expr {
    EInt(_) => true,
    EFloat(_) => true,
    EBool(_) => true,
    EUnit => true,
    EIdent(_, _) => true,
    // The holes are source text until expand_interp, which this walk does
    // not run. A hole can be a read. Refuse the entry instead of caching it.
    EStringInterp(_) => false,
    EString(_, _) => true,
    ETuple(xs) => exprs_are_captured_output(xs, fn_names),
    EArray(xs) => exprs_are_captured_output(xs, fn_names),
    EContinue(xs) => exprs_are_captured_output(xs, fn_names),
    ERecord(_, fields, _) => expr_pairs_are_captured_output(fields, fn_names),
    EMap(fields) => expr_pairs_are_captured_output(fields, fn_names),
    EIf(cond, then_branch, else_branch) => expr_is_captured_output(cond, fn_names) && expr_is_captured_output(then_branch, fn_names) && expr_is_captured_output(else_branch, fn_names),
    ELet(name, value, body, _) => expr_keeps_stdout_write(name, value, body, fn_names),
    ELetRec(name, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    ELetMut(name, value, body, _) => expr_keeps_stdout_write(name, value, body, fn_names),
    EAssign(name, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    EAssignOp(name, _, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    ESeq(left, right) => expr_is_captured_output(left, fn_names) && expr_is_captured_output(right, fn_names),
    EWhile(cond, body) => expr_is_captured_output(cond, fn_names) && expr_is_captured_output(body, fn_names),
    // Desugar rewrites `for` into iter_get / host_stream_next, which can
    // read. Those calls are not in this AST, so the surface node is refused.
    EForIn(_, _, _, _) => false,
    EBinOp(op, left, right, _) => if op == "|>" {
      expr_is_captured_output(left, fn_names) && pipe_rhs_is_captured_output(right, fn_names)
    } else {
      expr_is_captured_output(left, fn_names) && expr_is_captured_output(right, fn_names)
    },
    EUnaryOp(_, arg) => expr_is_captured_output(arg, fn_names),
    EReturn(arg) => expr_is_captured_output(arg, fn_names),
    ESpread(arg) => expr_is_captured_output(arg, fn_names),
    ELabeledArg(_, _, arg) => expr_is_captured_output(arg, fn_names),
    EDot(recv, _, _, _) => expr_is_captured_output(recv, fn_names),
    EBreak(value) => {
      match value {
        Some(inner) => expr_is_captured_output(inner, fn_names),
        None => true
      }
    },
    EMatch(scrut, arms) => expr_is_captured_output(scrut, fn_names) && arms_are_captured_output(arms, fn_names),
    ELoop(inits, body) => !loop_inits_hide_stdout_write(inits) && expr_pairs_are_captured_output(inits, fn_names) && expr_is_captured_output(body, fn_names),
    ECall(callee, args, _) => call_is_captured_output(callee, fn_names) && exprs_are_captured_output(args, fn_names),
    // A nested function is invisible to the effect walk. Caching it would
    // hide a read. A handler can discharge a read the same way.
    EFn(_, _, _, _, _, _) => false,
    EHandle(_, _) => false
  }
}

fn console_entry_is_output_only(row: Array[String], body: Expr, fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut saw_console = false
  let mut ok = true
  while i < Array::length(row) {
    let label = Array::get(row, i)
    if label == "Console" {
      saw_console = true
    } else if !is_entry_cache_safe_operation(label) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok && saw_console && expr_is_captured_output(body, fn_names)
}

/// Every label in `row` must appear in `safe` -- unlike decl_authorizes_
/// effect above (used the OPPOSITE direction: "does this declared row
/// authorize performing effect X", where an effect-VARIABLE label
/// conservatively authorizes anything), this is used to conservatively
/// REJECT: an unrecognized label (including a row-variable letter, which a
/// real top-level `main` should never carry) is NOT treated as safe.
///
/// #1343: each row label is reduced to its EFFECT name before the lookup.
/// Once operation-level rows became expressible for host capabilities
/// (#1359), an entry declaring the STRICTLY NARROWER
/// `with Stdout::write_stream` would otherwise fail this exact-string
/// test and be judged un-cacheable, while the broader `with Stdout`
/// passed -- i.e. tightening a row would lose the #819/#1214 doctest cache.
/// `effect_name_of_op` only strips a `::` suffix (and canonicalizes the
/// exception aliases), so a row variable stays a row variable and an
/// unrelated effect stays unrelated: the conservative rejection above is
/// unchanged.
fn labels_are_entry_cache_safe(row: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(row) {
    if !is_entry_cache_safe_operation(Array::get(row, i)) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

//# Mutability discipline: reassignment requires a `let mut` binding.
//
// `let x = ...` is immutable (docs/user/reference/cheatsheet.md); only `let mut x` may be
// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass
// walks expressions carrying the SET of names that are reassignable in scope
// and reports an `x = e` / `x op= e` whose target is not in that set.
//
// The set only ever GROWS down a scope (never shrinks), so the pass can only
// produce false NEGATIVES, never false positives: every form that introduces a
// reassignable or freshly-rebindable name — `let mut`, function parameters,
// loop accumulators, `for` variables, and pattern binds — is added, so the
// only thing flagged is reassignment of a plain immutable `let`. Nested
// functions INHERIT the outer set (a closure may mutate a captured `let mut`).

fn mut_has(xs: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn mut_with(base: Array[String], name: String) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  Array::push(out, name)
  out
}

fn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(acc, name),
    PCtor(_, subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    PTuple(subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    POr(l, r) => {
      collect_pat_binds_into(l, acc)
      collect_pat_binds_into(r, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binds_into(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  collect_pat_binds_into(pat, out)
  out
}

fn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    Array::push(out, pname)
    i = i + 1
  }
  out
}

export fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {
  let out = array_empty()
  check_mutability_expr_into(expr, mutable, out)
  out
}

fn check_mutability_expr_into(expr: Expr, mutable: Array[String], out: Array[EffectError]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      check_mutability_expr_into(callee, mutable, out)
      let mut ai = 0
      while ai < Array::length(args) {
        check_mutability_expr_into(Array::get(args, ai), mutable, out)
        ai = ai + 1
      }
      ()
    },
    EFn(_, _, params, _, _, body) => {
      check_mutability_expr_into(body, mut_with_params(mutable, params), out)
      ()
    },
    EHandle(body, arms) => {
      check_mutability_expr_into(body, mutable, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        check_mutability_expr_into(arm_body, mut_with_pat(mutable, pat), out)
        ai = ai + 1
      }
      ()
    },
    ELet(_, val, body, _) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELetRec(_, val, body) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELetMut(name, val, body, _) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mut_with(mutable, name), out)
      ()
    },
    ESeq(a, b) => {
      check_mutability_expr_into(a, mutable, out)
      check_mutability_expr_into(b, mutable, out)
      ()
    },
    EIf(cond, then_e, else_e) => {
      check_mutability_expr_into(cond, mutable, out)
      check_mutability_expr_into(then_e, mutable, out)
      check_mutability_expr_into(else_e, mutable, out)
      ()
    },
    EMatch(scrutinee, arms) => {
      check_mutability_expr_into(scrutinee, mutable, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        check_mutability_expr_into(arm_body, mut_with_pat(mutable, pat), out)
        ai = ai + 1
      }
      ()
    },
    EWhile(cond, body) => {
      check_mutability_expr_into(cond, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELoop(params, body) => {
      let loopmut = Array::slice(mutable, 0, Array::length(mutable))
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        check_mutability_expr_into(init, mutable, out)
        Array::push(loopmut, pname)
        i = i + 1
      }
      check_mutability_expr_into(body, loopmut, out)
      ()
    },
    EForIn(name, index_name, iter, body) => {
      check_mutability_expr_into(iter, mutable, out)
      let base = mut_with(mutable, name)
      let formut = match index_name {
        Some(idx) => mut_with(base, idx),
        None => base
      }
      check_mutability_expr_into(body, formut, out)
      ()
    },
    EBinOp(_, left, right, _) => {
      check_mutability_expr_into(left, mutable, out)
      check_mutability_expr_into(right, mutable, out)
      ()
    },
    EReturn(e) => check_mutability_expr_into(e, mutable, out),
    EUnaryOp(_, operand) => check_mutability_expr_into(operand, mutable, out),
    EAssign(name, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(out, EEAssignImmutable(name))
      } else {
        ()
      }
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(cont, mutable, out)
      ()
    },
    EAssignOp(name, _, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(out, EEAssignImmutable(name))
      } else {
        ()
      }
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(cont, mutable, out)
      ()
    },
    EDot(obj, _, _, _) => check_mutability_expr_into(obj, mutable, out),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        check_mutability_expr_into(Array::get(elems, ei), mutable, out)
        ei = ei + 1
      }
      ()
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        check_mutability_expr_into(Array::get(elems, ei), mutable, out)
        ei = ei + 1
      }
      ()
    },
    ERecord(_, fields, _) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        check_mutability_expr_into(fval, mutable, out)
        fi = fi + 1
      }
      ()
    },
    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal
    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map
    // literal, labeled argument, spread, break value, or continue argument went
    // unflagged. Recurse with the SAME mutable set (these forms introduce no new
    // bindings), keeping the pass sound: still no false positives, just fewer
    // false negatives.
    EMap(entries) => {
      let mut mi = 0
      while mi < Array::length(entries) {
        let (_, mval) = Array::get(entries, mi)
        check_mutability_expr_into(mval, mutable, out)
        mi = mi + 1
      }
      ()
    },
    ELabeledArg(_, _, inner) => check_mutability_expr_into(inner, mutable, out),
    ESpread(inner) => check_mutability_expr_into(inner, mutable, out),
    EBreak(opt) => match opt {
      Some(e) => check_mutability_expr_into(e, mutable, out),
      None => ()
    },
    EContinue(cargs) => {
      let mut ci = 0
      while ci < Array::length(cargs) {
        check_mutability_expr_into(Array::get(cargs, ci), mutable, out)
        ci = ci + 1
      }
      ()
    },
    // New structural forms keep the same binding context; scoped forms above
    // intentionally remain explicit so their boundary semantics are visible.
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_mutability_expr_into(expr_child_at(i), mutable, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

/// #770: `outer` carries the top-level `let mut` names already in scope from
/// earlier sibling statements (see check_mutability_stmts below) so a later
/// top-level statement's assignment to an earlier top-level `mut` binding
/// (directly, or via a closure capturing it) is recognized as mutable instead
/// of being misreported as `cannot assign to immutable binding`.
fn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {
  match body {
    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),
    _ => check_mutability_expr(body, outer)
  }
}

/// #770: top-level program statements are a flat `Array[Stmt]` sequence (not
/// nested `ELetMut` continuations like a function/test body), so a top-level
/// `let mut x = ...` must thread `x` forward into the mutability check of
/// every later sibling statement by accumulating `mutable` across the loop —
/// mirroring how `check_stmts` threads `env` across the same array. Before
/// this fix each statement was checked in isolation starting from an empty
/// mutable set, so any top-level `let mut` followed by an assignment in a
/// later top-level statement (e.g. a top-level `while` loop mutating a
/// counter) was rejected with a bogus `cannot assign to immutable binding`
/// error even though the program is valid.
export fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut mutable = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),
      SLetMut(name, _, body) => {
        append_eff_errs(errors, check_mutability_binding(body, mutable))
        mutable = mut_with(mutable, name)
      },
      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),
      _ => ()
    }
    i = i + 1
  }
  errors
}
