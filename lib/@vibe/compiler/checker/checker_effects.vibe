import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  Type,
  TypeEnv,
  TypeExpr,
  canonical_builtin_name,
  canonical_exception_effect_name,
  effect_row_allows_text,
  effect_row_emitted_text,
  entry_cache_safe_effects,
  env_lookup,
  exception_effect_labels_equal,
  exception_kinds_compatible,
  exception_label_kind,
  exception_throw_label_for_kind,
  expr_children,
  has_standard_host_provider,
  is_entry_admitted_effect,
  is_entry_cache_safe_operation,
  is_entry_runtime_managed_effect,
  is_exception_effect_name,
  is_exception_label,
  is_exception_throw_operation,
  test_bench_default_effects,
  type_name_has_async_iterator_impl
}

import @vibe/core {
  array_empty
}

// #897 (ADR-0070 Phase 3): this file was moved from
// lib/@vibe/compiler/checker_effects.vibe into checker/ itself specifically
// so this import stays a plain SAME-PACKAGE sibling reference. Before the
// move it was a `#847 Phase C exception` — a deliberate direct leaf import
// of the internal `checker/builtins.vibe` file, bypassing the (then-plain)
// facade, because `checker/checker_stmt.vibe` imports this file and the
// facade re-exports `checker_stmt.vibe`'s surface: routing through the
// facade would have closed a real cycle (checker package -> checker_stmt.vibe
// -> checker_effects.vibe -> checker package). Once checker/ became a real
// `index.vpkg` package boundary (#729's enforce_incoming_boundary_fs), an
// outside file could no longer reach `checker/builtins.vibe` directly at
// all (only through the package), so the old workaround stopped compiling.
// Moving this file INTO checker/ resolves both problems at once: this
// import is now an ordinary directory-shared-scope sibling reference (no
// facade indirection, so no cycle), and every OTHER consumer of this file's
// own exports (check_effects_stmt, check_perform_effects_stmts_env, etc.)
// now reaches them through the checker package's index.vpkg like any other
// checker export.
import ./builtins.vibe {
  lookup_builtin
}

//# Types

export enum EffectError {
  EEEffectfulCallOutsideEffect(String);
  EEPerformUndeclaredEffect(String, String);
  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a
  // set difference plus a fix-it hint for the `with` row annotation.
  // Fields (all pre-rendered ", "-joined label lists, deterministic order):
  // (enclosing fn name or "" when unnamed, missing labels (sorted),
  //  declared row (source order, "" when no row), required row (sorted union)).
  // #1514: the 5th field is the CALL SITE's source offset (-1 when unknown),
  // carried to the renderer as the ` [@off=N]` marker locate_type_error decodes.
  // Before this the row mismatch had no position at all -- measured as the worst
  // tier in eval/lang-review/repair (05).
  EEEffectRowMismatch(String, String, String, String, Int);
  // #1683: a source effect with no host/runtime owner reached a program entry.
  // Fields: entry name, sorted offending row, sorted bare handler names, offset.
  EEUndischargedEntryEffect(String, String, String, Int);
  // An entry row variable has no caller that can instantiate it. Keep this
  // separate from concrete effects so the fix-it never suggests handling a
  // type-level row variable as though it were an effect declaration.
  EEUnresolvedEntryEffectRow(String, String, Int);
  EEUnauthorizedEntryOperation(String, String, String, Int);
  EEUnauthorizedInstantiateAuthority(String);
  EEProviderOperationCollision(String);
  EEAssignImmutable(String);
  // #1539: provider-owned stdin lifecycle operations cannot be transported as
  // values until generic higher-order effect flow is sound (#1536).
  EEStdinProviderValueReference(String);
  // #1347: a `handle ... with E` whose arms are provably dead because the
  // body cannot reach a perform of E and only invokes an opaque value —
  // the handler-switch footgun. Field: the effect name.
  EEHandleNeverFires(String);
  // ADR-0102 / #1678: defense in depth for AST producers that bypass the
  // source parser. EHandle does not retain its source effect name, so this
  // diagnostic deliberately names the structural problem instead.
  EEEmptyHandle;
  EEPerformQuestionRequiresOptional(String, Int)
}

//# Functions

// #944 follow-up: the general `check_effects_expr`/`check_effects_stmt`/
// `check_effects_stmts` walk (the pre-#933 `in_effect: Bool` discipline that
// produced EEThrowOutsideEffect / EEEffectfulCallOutsideEffect for ANY
// effectful call outside an effectful context) was retired here. It had no
// live-pipeline caller -- `check_program` wires check_perform_effects_* (the
// row-based discipline below, which since #944 also checks the Error row by
// default) plus the Async-scoped check_async_effects_* pass further down --
// and was only reachable from two unit-test harnesses, which now exercise the
// live entry points instead. EEThrowOutsideEffect went with it (its only
// constructor was that walk's EThrow arm, dead since #640 Stage 2 desugared
// `throw` to `perform Exception::Throw`); EEEffectfulCallOutsideEffect stays --
// check_async_effects_expr still reports it for async primitives.

/// #1429: render a stored row as the SOURCE spelling the reader must type.
/// Rows are stored comma-joined; the syntax is `+`-separated. Every `hint:`
/// below hands the reader something to paste into their code, so it has to go
/// through here -- a hint that suggests `with { Error, Fs }` is telling them
/// to write syntax the compiler is migrating away from (and, once the braced
/// form is removed, syntax it rejects outright).
///
/// The set-valued parts of the message (`missing { .. }`, `requires { .. }`)
/// deliberately keep braces: those render a SET difference, not source.
fn row_as_source(row: String) -> String {
  let parts = String::split(row, ", ")
  let n = Array::length(parts)
  let mut acc = ""
  let mut i = 0
  while i < n {
    acc = if i == 0 {
      Array::get(parts, i)
    } else {
      String::concat(acc, String::concat(" + ", Array::get(parts, i)))
    }
    i = i + 1
  }
  acc
}

export fn effect_error_to_string(err: EffectError) -> String {
  match err {
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name),
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with` row or wrap in a `handle`")))),
    // #639: expected-vs-actual effect rows as a set difference, then ONE
    // deterministic fix-it hint line targeting the enclosing declaration
    // (for a call-site leak that is the CALLER, not the callee).
    EEEffectRowMismatch(fname, missing, declared, required, off) => {
      let head = if String::length(fname) > 0 {
        String::concat("effect row mismatch for '", String::concat(fname, "'"))
      } else {
        "effect row mismatch"
      }
      let detail = if String::length(declared) > 0 {
        String::concat(" (declared { ", String::concat(declared, String::concat(" }, requires { ", String::concat(required, " })"))))
      } else {
        String::concat(" (no 'with' clause, requires { ", String::concat(required, " })"))
      }
      let hint = if String::length(fname) == 0 {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), "' to the enclosing function"))
      } else if String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat("(...) -> T with ", String::concat(row_as_source(required), "'"))))
      } else {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), String::concat("' to '", String::concat(fname, "'"))))
      }
      let body = String::concat(head, String::concat(": missing { ", String::concat(missing, String::concat(" }", String::concat(detail, hint)))))
      // #1514: marker LAST so the hint line stays the visible tail; the decoder
      // strips it before the user ever sees the string.
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUndischargedEntryEffect(entry_name, effects, handlers, off) => {
      let body = String::concat("entry point '", String::concat(entry_name, String::concat("' cannot discharge { ", String::concat(effects, String::concat(" }: no host provider or runtime handler owns this effect\nhint: wrap the operation in `handle ... with ", String::concat(row_as_source(handlers), " { ... }` before it reaches the entry boundary"))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnresolvedEntryEffectRow(entry_name, variables, off) => {
      let body = String::concat("entry point '", String::concat(entry_name, String::concat("' has unresolved effect row { ", String::concat(variables, " }: entry rows must be concrete\nhint: close the entry row, or discharge each concrete effect with `handle` before it reaches the entry boundary"))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnauthorizedEntryOperation(entry_name, operation, allows, off) => {
      let who = if is_program_entry_name(entry_name) {
        String::concat("entry point '", String::concat(entry_name, "'"))
      } else {
        String::concat("'", String::concat(entry_name, "'"))
      }
      let body = String::concat(who, String::concat(" emits unhandled `", String::concat(operation, String::concat("` that is not authorized by `allows ", String::concat(allows, "`\nhint: handle the operation, or add it to the `allows` clause")))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnauthorizedInstantiateAuthority(label) => String::concat("allows `", String::concat(label, "` cannot be frozen as instantiate authority: it is not a registry-owned host provider operation")),
    EEProviderOperationCollision(operation) => String::concat("user effect operation `", String::concat(operation, "` collides with a registry-owned host provider operation; rename the user operation so it cannot impersonate provider authority")),
    EEAssignImmutable(name) => String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)")),
    EEStdinProviderValueReference(name) => String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function")),
    EEHandleNeverFires(eff) => {
      let tail = String::concat(eff, "::..` and calls an opaque function value. A continuation captured by another handler carries THAT handler with it, so wrapping its invocation in a new `handle` does not switch handlers (non-scoped resumption is unsupported -- ADR-0089 Part A, #1347). Drive the continuation without the wrapping handle, or handle the effect where it is performed")
      String::concat("handle of effect '", String::concat(eff, String::concat("' can never fire: this body reaches no `perform ", tail)))
    },
    EEEmptyHandle => "handler must contain at least one arm; an empty handler cannot discharge an effect",
    EEPerformQuestionRequiresOptional(operation, off) => {
      let body = String::concat("`perform?` requires optional `allows ", String::concat(operation, "?`; write that grade, or use plain `perform`"))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    }
  }
}

//# Async-scoped effect enforcement (the pass wired into `check_program`)
//
// This pass enforces ONLY the `Async` effect, and only
// for async PRIMITIVES — builtins such as `await(..)` and `sleep(..)`
// whose type carries `with Async`, including the `await(..)` the async
// desugar injects over a Future-returning iterator. A primitive must appear
// inside a function/lambda annotated `with Async`.
//
// Crucially it does NOT propagate to user functions that merely COMPOSE async
// work: calling a `with Async` helper (e.g. `async_iter_collect`) from a
// sync context is allowed (await is the identity on the synchronous backend,
// and on a real async backend the value/Future mismatch is a separate type
// error). Only env-absent BUILTIN primitives are checked, so the compiler /
// prelude — which use `Async` only in the disciplined async_iter terminals —
// stay green while `for` over an async stream becomes sound (#2+#3).

fn effect_opt_is_async(eff: Option[String]) -> Bool {
  effect_row_contains_label(eff, "Async")
}

fn is_stdin_provider_surface(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// #1539: the four public provider operations are syntactic direct-call
/// primitives, not first-class function values. A direct `ECall` skips its
/// exact builtin callee but still checks every argument; every other expression
/// position is traversed structurally. This rejects aliases, chains,
/// conditionals, returned/container values, and unknown HOF transport without
/// attempting the generic effect-flow propagation deliberately deferred by
/// #1536. An explicitly effectful user wrapper remains an ordinary function.
fn check_stdin_provider_direct_calls_expr(expr: Expr) -> Array[EffectError] {
  let errors = array_empty()
  match expr {
    ECall(EIdent(name, _), args, _) => {
      if is_stdin_provider_surface(name) {
        let mut ai = 0
        while ai < Array::length(args) {
          append_eff_errs(errors, check_stdin_provider_direct_calls_expr(Array::get(args, ai)))
          ai = ai + 1
        }
      } else {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) {
          append_eff_errs(errors, check_stdin_provider_direct_calls_expr(Array::get(children, i)))
          i = i + 1
        }
      }
    },
    EIdent(name, _) => if is_stdin_provider_surface(name) {
      Array::push(errors, EEStdinProviderValueReference(name))
    } else {
      ()
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        append_eff_errs(errors, check_stdin_provider_direct_calls_expr(Array::get(children, i)))
        i = i + 1
      }
    }
  }
  errors
}

fn check_stdin_provider_direct_calls_stmt(stmt: Stmt) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, _, body) => check_stdin_provider_direct_calls_expr(body),
    SLetMut(_, _, body) => check_stdin_provider_direct_calls_expr(body),
    STest(_, body) => check_stdin_provider_direct_calls_expr(body),
    SBench(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExample(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExpr(body) => check_stdin_provider_direct_calls_expr(body),
    SLetPat(_, body) => check_stdin_provider_direct_calls_expr(body),
    SModule(_, _, inner) => check_stdin_provider_direct_calls_stmts(inner),
    _ => array_empty()
  }
}

export fn check_stdin_provider_direct_calls_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_stdin_provider_direct_calls_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  errors
}

/// True only for async-effect BUILTIN primitives (await/sleep/...).
/// A name bound in `env` (a user/prelude function) is intentionally NOT treated
/// as a primitive even if its type is `with Async`, except the four exact
/// compiler-owned stdin provider names imported from their public contract.
fn is_async_primitive(name: String, env: TypeEnv) -> Bool {
  if is_stdin_provider_surface(name) {
    // Imported package contracts bind these exact public names in env, but
    // they remain compiler-owned primitives after canonical import rewriting.
    // Do not let that binding suppress their Async authority requirement.
    match lookup_builtin(canonical_builtin_name(name)) {
      Some(ty) => match ty {
        CtFn(_, _, eff) => effect_opt_is_async(eff),
        _ => false
      },
      None => false
    }
  } else {
    match env_lookup(env, name) {
      Some(_) => false,
      None => {
        let normalized = canonical_builtin_name(name)
        match lookup_builtin(normalized) {
          Some(ty) => match ty {
            CtFn(_, _, eff) => effect_opt_is_async(eff),
            _ => false
          },
          None => false
        }
      }
    }
  }
}

/// True when a handle arm targets an Async operation.
fn handle_arms_handle_async(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if String::starts_with(name, "Async::") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

//# #1358: `for` over an ASYNC iterator also needs `Async`
//
// `for x in it`, where `it`'s iterator `next` yields a `Future`, is lowered to
// an AWAIT loop by the dict-passing desugar (build_await_iter_for), which runs
// AFTER the checker -- so at check time the program text holds no async
// primitive and the pass above finds nothing to require. The loop could
// therefore suspend from a context that neither declares nor handles `Async`.
// This hole is not #1350's doing: the retired `for await` marker was unwrapped
// by the checker without requiring anything either. #1350 only widened the
// exposure, since now every plain `for` over a Future-returning iterator takes
// the await lowering.
//
// Recognising the loop needs the ITERAND's type, so this mirrors the desugar's
// own resolution (infer_arg_type_name over var_types/fn_returns). Those tables
// are built in codegen, so here the head type name comes from the type
// environment plus a small locals table threaded down the walk. Both sides are
// best-effort by construction -- an unresolvable iterand requires nothing,
// exactly as the desugar leaves an unclassifiable loop as a sync EForIn -- so
// this can MISS a requirement, but never invent one.

fn afe_no_locals() -> Array[(String, String)] {
  array_empty()
}

/// Head name of an inferred checker type (`AsyncIter[Int]` -> "AsyncIter").
///
/// #1347/#1358 (Codex P1 on PR #1364): `CtEnum` counts too. An ENUM can
/// implement an async iterator trait, and an iterand reached through its
/// constructor (`Chan(3)`), a factory call, or an inferred local carries
/// `CtEnum` -- dropping it here lost the head name while the desugar still
/// resolved it from the constructor's return metadata and lowered the loop
/// through `Chan::next` with an injected `await`. Verified against a repro
/// that RAN the await loop.
fn afe_type_head_name(t: Type) -> Option[String] {
  match t {
    CtNamed(n, _) => Some(n),
    CtStruct(n) => Some(n),
    CtEnum(n) => Some(n),
    _ => None
  }
}

/// Head name of a source annotation (`s: AsyncIter[Int]` -> "AsyncIter").
fn afe_texpr_head_name(t: TypeExpr) -> Option[String] {
  match t {
    TyName(n) => Some(n),
    TyApp(n, _) => Some(n),
    _ => None
  }
}

fn afe_lookup_local(locals: Array[(String, String)], name: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(locals) {
    let entry = Array::get(locals, i)
    match found {
      None => if entry.0 == name {
        found = Some(entry.1)
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// Bind `name` to a head type for the scope below, REMOVING any outer entry of
/// the same name first. Dropping the shadow would let an outer async-iterator
/// binding be resolved through an inner, unrelated one of the same name — a
/// false positive (a rejected valid program), which this pass must never
/// produce. `None` therefore still shadows; it just adds nothing.
fn afe_bind_local(locals: Array[(String, String)], name: String, head: Option[String]) -> Array[(String, String)] {
  let out = array_empty()
  match head {
    Some(h) => Array::push(out, (name, h)),
    None => ()
  }
  let mut i = 0
  while i < Array::length(locals) {
    let entry = Array::get(locals, i)
    if entry.0 != name {
      Array::push(out, entry)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn afe_bind_params(locals: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let head = match ptype {
      Some(te) => afe_texpr_head_name(te),
      None => None
    }
    cur = afe_bind_local(cur, pname, head)
    i = i + 1
  }
  cur
}

/// Best-effort head type name of an expression used as a `for` iterand (or as a
/// `let` value feeding one).
/// #1341 (Codex P1 on #1369): struct FIELD type heads, `Holder.s ->
/// HostStream`. The async pass walks per-statement, so a whole-program table
/// cannot ride the walk's parameters; it lives in a module cell rebuilt at each
/// public entry, exactly like error_row_mode_cell / throw_kind_cell in this
/// file. Entries are keyed with a `.` that no vibe binding name can contain.
///
/// Needed because the desugar now routes `for b in h.s` over a host stream to
/// the parking read loop (build_host_stream_for). If this pass could not
/// classify the same projection, that loop would be legal in a row without
/// { Async } -- the precise hole #1358 exists to close, reopened one
/// expression shape over.
let afe_field_types_cell: Array[(String, String)] = array_empty()

fn afe_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

fn afe_collect_field_types(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          let head = texpr_head_name_afe(fty)
          if String::length(head) > 0 {
            Array::push(afe_field_types_cell, (afe_field_type_key(sname, fname), head))
          } else {
            ()
          }
          j = j + 1
        }
      },
      SModule(_, _, inner) => afe_collect_field_types(inner),
      _ => ()
    }
    i = i + 1
  }
}

fn texpr_head_name_afe(t: TypeExpr) -> String {
  match t {
    TyName(n) => n,
    TyApp(n, _) => n,
    _ => ""
  }
}

fn afe_set_field_types(stmts: Array[Stmt]) -> Unit {
  Array::truncate(afe_field_types_cell, 0)
  afe_collect_field_types(stmts)
}

fn afe_lookup_field_type(struct_name: String, field: String) -> Option[String] {
  let key = afe_field_type_key(struct_name, field)
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_field_types_cell) {
    let (k, v) = Array::get(afe_field_types_cell, i)
    if k == key {
      out = Some(v)
      i = Array::length(afe_field_types_cell)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_expr_head_name(e: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match e {
    EIdent(n, _) => match afe_lookup_local(locals, n) {
      Some(h) => Some(h),
      None => match env_lookup(env, n) {
        Some(t) => afe_type_head_name(t),
        None => None
      }
    },
    // `Counter::{ .. }` -- the struct literal names its own type.
    ERecord(n, _, _) => if String::length(n) > 0 {
      Some(n)
    } else {
      None
    },
    // #1341: a PROJECTION (`h.s`) -- the object's type name plus the field
    // name give the field's declared head. Mirrors infer_arg_type_name's EDot
    // arm in the desugar so both passes classify the same expression shapes.
    EDot(obj, field, _, _) => match afe_expr_head_name(obj, env, locals) {
      Some(otype) => afe_lookup_field_type(otype, field),
      None => None
    },
    // `for x in async_iter_arr(xs)` -- the callee's declared return head.
    // #1341: a BUILTIN callee (`host_stream_named("body")`) is absent from the
    // type env -- builtins resolve through lookup_builtin -- so the env lookup
    // alone left every direct-call iterand unclassified.
    ECall(EIdent(f, _), _, _) => match env_lookup(env, f) {
      Some(CtFn(_, ret, _)) => afe_type_head_name(ret),
      _ => match lookup_builtin(f) {
        Some(CtFn(_, bret, _)) => afe_type_head_name(bret),
        _ => None
      }
    },
    _ => None
  }
}

/// The iterand's type name when driving it with `for` awaits each step,
/// otherwise None. Named so the diagnostic can point at `<T>::next`.
fn afe_async_iterand(iter: Expr, env: TypeEnv, locals: Array[(String, String)]) -> Option[String] {
  match afe_expr_head_name(iter, env, locals) {
    // #1341: the p3 host stream is async by construction and has no
    // AsyncIterator impl to find -- its read primitive is the scalar
    // `host_stream_next(s) -> Int with Async`, and the desugar builds the
    // loop on that read directly (build_host_stream_for). The loop therefore
    // parks once per byte, so the enclosing row must carry `Async` for exactly
    // the reason #1358 gave for trait-based async iterators.
    Some(tn) => if tn == "HostStream" || type_name_has_async_iterator_impl(env, tn) {
      Some(tn)
    } else {
      None
    },
    None => None
  }
}

export fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {
  check_async_effects_expr_lo(expr, env, in_async, afe_no_locals())
}

/// #1358: the same walk with a `name -> head type name` table for the bindings
/// in scope, so an async `for` can be recognised through an ordinary local
/// (`let it = async_iter_arr(xs); for x in it`) and through a typed parameter.
fn check_async_effects_expr_lo(expr: Expr, env: TypeEnv, in_async: Bool, locals: Array[(String, String)]) -> Array[EffectError] {
  let errors = array_empty()
  // Preserve the legacy preorder diagnostic order: inspect a call before its
  // structural children, then delegate their enumeration to expr_children.
  match expr {
    ECall(EIdent(name, _), _, _) => if !in_async && is_async_primitive(name, env) {
      Array::push(errors, EEEffectfulCallOutsideEffect(name))
    } else {
      ()
    },
    EForIn(_, _, iter, _) => match afe_async_iterand(iter, env, locals) {
      Some(tn) => if !in_async {
        Array::push(errors, EEEffectfulCallOutsideEffect(String::concat(tn, "::next (a `for` over an async iterator awaits every step -- add `with Async` or wrap the loop in a handler for it)")))
      } else {
        ()
      },
      None => ()
    },
    _ => ()
  }
  match expr {
    // Scope boundary: a lambda's explicit row replaces its enclosing Async
    // context. All other expression forms retain the context unchanged.
    EFn(_, _, params, _, effect, body) => {
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, effect_opt_is_async(effect), afe_bind_params(locals, params)))
    },
    EHandle(body, arms) => {
      let discharges_async = handle_arms_handle_async(arms)
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async || discharges_async, locals))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_async_effects_expr_lo(arm_body, env, in_async, locals))
        ai = ai + 1
      }
    },
    // ELet/ELetMut are non-recursive: the value is resolved in the OUTER scope,
    // and only the body sees the new binding. ELetRec's value may reference
    // itself, so both sides see it.
    ELet(name, val, body, _) => {
      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, locals))
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))))
    },
    ELetMut(name, val, body, _) => {
      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, locals))
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))))
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))
      append_eff_errs(errors, check_async_effects_expr_lo(val, env, in_async, rec_locals))
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, rec_locals))
    },
    EForIn(name, index_name, iter, body) => {
      append_eff_errs(errors, check_async_effects_expr_lo(iter, env, in_async, locals))
      // The loop variables are ELEMENTS, never the iterator itself: bind them
      // to nothing so they shadow any same-named outer entry.
      let body_locals = match index_name {
        Some(idx) => afe_bind_local(afe_bind_local(locals, name, None), idx, None),
        None => afe_bind_local(locals, name, None)
      }
      append_eff_errs(errors, check_async_effects_expr_lo(body, env, in_async, body_locals))
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        append_eff_errs(errors, check_async_effects_expr_lo(Array::get(children, i), env, in_async, locals))
        i = i + 1
      }
    }
  }
  errors
}

/// A function body runs in an `{Async}` context if EITHER the lambda's inline
/// effect OR the binding's declared signature type carries `Async`.
fn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {
  match topt {
    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),
    _ => false
  }
}

fn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {
  let sig_async = sig_type_is_async(ty)
  match body {
    // #1358: descending straight into `fbody` skips the EFn arm, so bind this
    // binding's own parameters here — otherwise `fn drain(s: AsyncIter[Int])`
    // would not resolve `s` when its body loops over it.
    EFn(_, _, params, _, eff, fbody) => check_async_effects_expr_lo(fbody, env, sig_async || effect_opt_is_async(eff), afe_bind_params(afe_no_locals(), merge_param_types_with_sig(ty, params))),
    _ => check_async_effects_expr(body, env, sig_async)
  }
}

export fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),
    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),
    STest(_, body) => check_async_effects_expr(body, env, false),
    SBench(_, body) => check_async_effects_expr(body, env, false),
    SExpr(e) => check_async_effects_expr(e, env, false),
    _ => array_empty()
  }
}

export fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  // Enforce direct-call-only before ordinary Async row checks. These errors are
  // checker diagnostics, so no artifact reaches codegen for an opaque flow.
  let errors = check_stdin_provider_direct_calls_stmts(stmts)
  // #1341: rebuild the struct field-type table for THIS program before the
  // walk, so a stale one from a previous module can never classify a
  // same-named field here.
  afe_set_field_types(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))
    i = i + 1
  }
  errors
}

//# perform-discipline enforcement (#626 criterion 1)
//
// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either
// the enclosing function/lambda declares it in `with` row, or the perform
// is inside a `handle` (which discharges it). Otherwise it is a type error —
// "performing an undeclared effect". This realizes the first acceptance
// criterion of #626 (the checker formerly accepted undeclared performs because
// it never resolved which effect an op belongs to).
//
// A `handle` is treated CONSERVATIVELY as discharging any effect for its body
// (we do not yet read which specific effect its arms handle), so a perform
// inside any handle is allowed — this never rejects a valid program; it only
// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle
// case, which full row tracking (#626 criteria 2/4) will cover.

/// Parse a source `with` row annotation into the canonical row. This is
/// the sole parser for checker effect rows: labels are trimmed and deduped, and
/// `None` remains structurally different from an explicit `with ()`.
fn effect_row_parse(eff: Option[String]) -> Option[Array[String]] {
  match eff {
    // None is structurally distinct from Some([]): it means the row is
    // inferred and therefore inherits its surrounding context.
    None => None,
    Some(s) => {
      let labels = array_empty()
      let raw = String::split(effect_row_emitted_text(s), ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = canonical_exception_effect_name(String::trim(Array::get(raw, i)))
        let internal_provenance = String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[") || String::starts_with(label, "#aliasparam[") || String::starts_with(label, "#fieldparam[")
        if String::length(label) > 0 && !internal_provenance && !effect_row_has_label(Some(labels), label) {
          Array::push(labels, label)
        }
        i = i + 1
      }
      // Some([]) is an explicitly pure `with ()` row.
      Some(labels)
    }
  }
}

/// Exact membership only; notably, `NotAsync` and `AsyncLike` do not contain
/// the `Async` label.
fn effect_row_has_label(row: Option[Array[String]], wanted: String) -> Bool {
  match row {
    None => false,
    Some(labels) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(labels) {
        if Array::get(labels, i) == wanted {
          found = true
        }
        i = i + 1
      }
      found
    }
  }
}

/// Exact membership for consumers outside the checker package. Effect rows
/// are parser-normalized comma-separated labels; substring matching would let
/// `NotAsync` or `AsyncLike` grant the `Async` capability (#1289).
export fn effect_row_contains_label(eff: Option[String], wanted: String) -> Bool {
  effect_row_has_label(effect_row_parse(eff), wanted)
}

fn effect_row_labels(row: Option[Array[String]]) -> Array[String] {
  match row {
    None => array_empty(),
    Some(labels) => labels
  }
}

/// Resolve an annotation at a nested lambda boundary. Inferred rows inherit;
/// explicit rows, including `with ()`, replace the surrounding row.
fn effect_row_inherit(row: Option[Array[String]], surrounding: Array[String]) -> Array[String] {
  match row {
    None => surrounding,
    Some(labels) => labels
  }
}

/// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the
/// current representation): a function declaring `with e` may perform any
/// effect, so treat such a declaration as authorizing everything.
fn label_is_effect_var(name: String) -> Bool {
  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
}

/// #1340 (ADR-0071): the base effect name of a row label — `State[Int]` and
/// `State[String]` both have base `State`; a bracketless label is its own
/// base. Row CONTAINMENT is instantiation-insensitive for now: a bare
/// `State` authorizes any instantiation and vice versa (for bracketless
/// rows base equality degenerates to exact equality, so existing programs
/// are unchanged). Distinguishing instantiations inside containment is the
/// remaining ADR-0071 OperationRef-normalization work.
fn row_label_base(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi > 0 {
    label[0: bi]
  } else {
    label
  }
}

/// #1340: base-aware membership — true when some declared label and the
/// required name share a base AND at least one side actually carries a
/// bracket (so this never fires for pre-#1340 rows, where the exact check
/// above already decided).
fn row_base_membership(labels: Array[String], eff_name: String) -> Bool {
  // ADR-0085 (#1344): the exception effect opts OUT of base-name equivalence.
  // Every other generic effect treats `E[A]` and `E[B]` as interchangeable
  // (#1340 v1), but `Exception[E]`'s whole point is that they are not, and
  // this predicate would otherwise re-admit exactly what decl_authorizes_
  // effect's kind check just rejected -- via the OPERATION spelling
  // (`Exception[IoError]::Throw` strips to base `Exception`), which the
  // bare-effect arm above never sees. Bracketless exception labels were
  // already outside this rule (it fires only when one side has a bracket), so
  // pre-#1344 rows are unchanged.
  if is_exception_label(eff_name) {
    false
  } else {
    let eb = row_label_base(eff_name)
    let ehas = String::length(eb) < String::length(eff_name)
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      let l = Array::get(labels, i)
      let lb = row_label_base(l)
      let lhas = String::length(lb) < String::length(l)
      if (ehas || lhas) && lb == eb && !is_exception_label(l) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// #1460 is merging `Stdin` / `Stdout` / `Stderr` into one `Console`
/// capability, and until that lands both spellings have to work. The merge
/// direction is what makes this CONTAINMENT rather than the alias equality
/// `exception_effect_labels_equal` uses for `Error` / `Exception`: measured on
/// the registry, `Console` owns six operations (`read_stream`, `read_char`,
/// `write_stream`, `write_char`, `write_err_stream`, `write_err_char`) while
/// the legacy three own three, two and two of them.
///
/// So a declared `Console` authorizes a legacy label, and the reverse is
/// deliberately ABSENT. Letting `with Stdout` authorize a `Console` operation
/// would hand a write-only program `Console::read_stream` -- the capability
/// escape class #2107/#2108 closed, reintroduced through a migration alias.
/// The negative case is pinned in `console_migration_row_test.vibe`.
///
/// One coverage gap this does not paper over: `Stdin::read_via_stream`
/// (#1539's StdinStream) has no `Console::` counterpart, so `Console` is not
/// yet a complete replacement for `Stdin` at the operation level. That is
/// #1460's problem to close, not this predicate's to hide.
fn is_legacy_console_label(name: String) -> Bool {
  name == "Stdin" || name == "Stdout" || name == "Stderr"
}

fn console_authorizes_legacy(labels: Array[String], eff_name: String) -> Bool {
  is_legacy_console_label(eff_name) && effect_row_has_label(Some(labels), "Console")
}

fn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {
  // All concrete label checks, including Async above, go through this same
  // exact-membership primitive rather than substring matching.
  if effect_row_has_label(Some(labels), eff_name) {
    true
  } else if console_authorizes_legacy(labels, eff_name) {
    true
  } else if is_exception_effect_name(eff_name) {
    // ADR-0085 Phase 3 (#1344): the exception effect is authorized by KIND.
    // This arm now runs BEFORE row_base_membership below, because that rule
    // compares generic row items by their base name (the
    // instantiation-insensitive #1340 v1, where `State[Int]` and
    // `State[String]` are interchangeable) -- reaching it would let
    // `with Exception[ParseError]` authorize an `IoError` throw and erase
    // the one guarantee typed exceptions exist to give. For BRACKETLESS rows
    // the reorder is inert: the old order could only have matched here when
    // some declared label already shared the base `Error`, which the exact
    // check above decided.
    let required_kind = exception_label_kind(eff_name)
    let mut alias_found = false
    let mut alias_i = 0
    while alias_i < Array::length(labels) {
      let declared_label = Array::get(labels, alias_i)
      if is_exception_label(declared_label) && exception_kinds_compatible(exception_label_kind(declared_label), required_kind) {
        alias_found = true
      }
      alias_i = alias_i + 1
    }
    alias_found
  } else if row_base_membership(labels, eff_name) {
    true
  } else {
    let mut i = 0
    let mut has_effect_var = false
    while i < Array::length(labels) {
      if label_is_effect_var(Array::get(labels, i)) {
        has_effect_var = true
      }
      i = i + 1
    }
    has_effect_var
  }
}

/// A DIRECT `perform EffName::Op` is authorized if the declared row names
/// either the whole effect (`EffName`) or, per ADR-0071's operation-level row
/// items, the exact operation (`EffName::Op`) itself -- e.g. `with Ask::Get`
/// must authorize a bare `perform Ask::Get` in the same function, exactly as
/// it already authorizes a transitive call to a callee declaring the same
/// item (that check compares the full qualified label directly, without
/// stripping to the base effect name).
fn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {
  if decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name) {
    true
  } else {
    let mut i = 0
    let mut found = false
    while i < Array::length(labels) {
      let lab = Array::get(labels, i)
      if exception_effect_labels_equal(lab, op_name) {
        found = true
      }
      i = i + 1
    }
    found
  }
}

/// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the
/// segment before `::`.
fn effect_name_of_op(op_name: String) -> String {
  let idx = String::index_of(op_name, "::")
  if idx > 0 {
    canonical_exception_effect_name(op_name[0: idx])
  } else {
    canonical_exception_effect_name(op_name)
  }
}

// ADR-0085 Phase 3 (#1344): the exception KIND of a `throw` payload.
//
// `throw(v)` requires `Exception[typeof(v)]`. This pass runs AFTER type
// checking but is itself untyped -- it walks the AST with the module's row
// table, not a Subst -- so the payload's static type is recovered from the
// checked top-level ENV instead of re-inferring it, via a flat table built
// once per module (throw_kind_cell below).
//
// What that resolves, and what it does not:
//
//   throw("boom")                 -> String       literal
//   throw(NotFound("cfg"))        -> IoError      constructor application
//   throw(Eof)                    -> ParseError   nullary constructor
//   throw(make_err(x))            -> whatever `make_err` returns
//   throw(Wrapped { .. })         -> Wrapped      struct literal
//   throw(e)  // e: IoError       -> IoError      annotated parameter
//   throw(e)  // let e = Eof      -> ParseError   local binder (see below)
//   throw(r.cause)                -> ""           unresolved
//
// An unresolved payload yields kind "", which exception_kinds_compatible
// treats as compatible with every declared exception label -- so this can
// never invent an error out of the gap, only miss one.
//
// LOCAL binders (the #1344 follow-up, and the shape #1324's migration mostly
// produces -- `let e = ...; Err(e)` becoming `let e = ...; throw(e)`) are
// resolved by threading a scope of `(name, kind)` pairs through the walk,
// exactly the way ov_names/ov_effs already ride it. The scope is built from
// binder syntax alone: a `let` takes its initializer's kind (recursively, so
// `let e = make_err(x)` resolves through the module table), and every other
// binder form -- patterns, `for`, `loop`, un-annotated parameters, `let rec`
// -- binds the name with kind "".
//
// Binding the unresolvable ones EXPLICITLY, rather than leaving them out, is
// what keeps the "never invents an error" property: lookup falls back to the
// module table when a name is absent, so an omitted local would let a
// same-named TOP-LEVEL binding answer for it. (That was a real, if narrow,
// pre-existing hole: before this scope existed, a local `let e = "boom"` in a
// module that also defines a top-level `e: IoError` reported the top-level
// kind.)
//
// The whole refinement is provably additive for existing code: a declared row
// either carries an ERASED exception label (`Error` / `Exception`), which is
// kind-compatible with everything, or carries no exception label at all, in
// which case the throw was already rejected with the identical message. Only a
// row that opts into `Exception[K]` -- a spelling nothing in the codebase uses
// -- can newly fail.

/// The exception-kind name of a checked type: the head name of a nominal type,
/// and "" for anything structural or still-unresolved (a type variable, a
/// function, a tuple). Kinds are compared by NAME because the row label is a
/// string; a structural payload therefore has no kind and stays gradual.
fn type_kind_name(t: Type) -> String {
  match t {
    CtString => "String",
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtChar => "Char",
    CtBytes => "Bytes",
    CtEnum(n) => n,
    CtStruct(n) => n,
    CtNamed(n, _) => n,
    _ => ""
  }
}

/// (name, kind-as-a-value, kind-of-its-result) for every top-level binding.
/// Both columns are needed because a `throw` payload names a binding in two
/// different positions: `throw(Eof)` wants the binding's own type, while
/// `throw(NotFound("x"))` wants the RESULT type of the constructor it applies.
let throw_kind_cell: Array[(String, String, String)] = array_empty()

fn throw_kind_push(name: String, ty: Type) -> Unit {
  let fnty = match ty {
    CtForAll(_, _, body) => body,
    _ => ty
  }
  let value_kind = type_kind_name(fnty)
  let result_kind = match fnty {
    CtFn(_, ret, _) => type_kind_name(ret),
    _ => ""
  }
  if String::length(value_kind) > 0 || String::length(result_kind) > 0 {
    Array::push(throw_kind_cell, (name, value_kind, result_kind))
  } else {
    ()
  }
}

/// Rebuild the payload-kind table from the checked top-level env. Called at
/// every public entry of this pass -- including the ones with no env, which
/// therefore CLEAR it -- so a table can never survive into the next module and
/// misclassify a same-named binding there.
fn set_throw_kind_table(env: TypeEnv) -> Unit {
  Array::truncate(throw_kind_cell, 0)
  let mut cur = env
  let mut looping = true
  while looping {
    match cur {
      EnvBind(name, binding, rest) => {
        throw_kind_push(name, binding.ty)
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(cnames, ctypes, rest) => {
        // Unlike seed_env_fn_effs above, the cached parallel arrays must be
        // READ, not skipped: `collect_all_diagnostics` (the `vibe diagnostics`
        // / LSP lane) hands this pass an env whose bindings have all been
        // folded into one EnvCached, so skipping it left every payload kind
        // unresolved on exactly that lane while the file-compile lane
        // resolved them -- the same program diagnosed differently depending
        // on which entry point asked.
        let mut ci = 0
        while ci < Array::length(cnames) && ci < Array::length(ctypes) {
          throw_kind_push(Array::get(cnames, ci), Array::get(ctypes, ci).ty)
          ci = ci + 1
        }
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(entries) => {
        let mut ei = 0
        while ei < Array::length(entries) {
          let (ename, binding) = Array::get(entries, ei)
          throw_kind_push(ename, binding.ty)
          ei = ei + 1
        }
        looping = false
      },
      EnvEmpty => {
        looping = false
      }
    }
  }
}

/// `want_result`: look up the binding's RESULT kind (it is being applied)
/// rather than its own. First match wins, matching the env's own innermost-
/// first order.
fn throw_kind_lookup(name: String, want_result: Bool) -> String {
  let mut i = 0
  let mut out = ""
  let mut found = false
  while i < Array::length(throw_kind_cell) && !found {
    let (n, value_kind, result_kind) = Array::get(throw_kind_cell, i)
    if n == name {
      out = if want_result {
        result_kind
      } else {
        value_kind
      }
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The LOCAL exception-kind scope: `(name, kind)` innermost-first, first match
/// wins, threaded through the perform walk like ov_names/ov_effs. An empty
/// `kind` is a real entry meaning "in scope, unresolvable" -- see the header
/// comment for why that must shadow the module table rather than fall through
/// to it.
fn no_kind_binds() -> Array[(String, String)] {
  array_empty()
}

fn throw_kind_bind(binds: Array[(String, String)], name: String, kind: String) -> Array[(String, String)] {
  let out = Array::slice([(name, kind)], 0, 1)
  let mut i = 0
  while i < Array::length(binds) {
    Array::push(out, Array::get(binds, i))
    i = i + 1
  }
  out
}

/// Every name a pattern binds enters scope unresolvable: this pass is untyped,
/// so it cannot tell what `Err(e)` destructures `e` to.
fn throw_kind_bind_pat(binds: Array[(String, String)], pat: Pat) -> Array[(String, String)] {
  let names = no_str_labels()
  collect_pat_binds_into(pat, names)
  let mut cur = binds
  let mut i = 0
  while i < Array::length(names) {
    cur = throw_kind_bind(cur, Array::get(names, i), "")
    i = i + 1
  }
  cur
}

/// A parameter's kind comes from its ANNOTATION's head name (`e: IoError`).
/// Un-annotated parameters bind unresolvable -- their type exists only in the
/// inference substitution this pass does not carry.
fn throw_kind_bind_params(binds: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {
  let mut cur = binds
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let kind = match ptype {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => h,
        None => ""
      },
      None => ""
    }
    cur = throw_kind_bind(cur, pname, kind)
    i = i + 1
  }
  cur
}

/// The exception kind of a `throw` payload expression, or "" when this pass
/// cannot resolve it (see the header comment above for the exact coverage).
fn throw_payload_kind(payload: Expr, binds: Array[(String, String)]) -> String {
  match payload {
    EString(_) => "String",
    EStringInterp(_) => "String",
    EInt(_) => "Int",
    EFloat(_) => "Double",
    EBool(_) => "Bool",
    // A struct literal names its own type. Anonymous records carry "" here and
    // stay gradual.
    ERecord(sname, _, _) => sname,
    // afe_lookup_local is a plain first-match lookup over the same
    // `Array[(String, String)]` shape; only its afe_ SPELLING is
    // async-pass-specific.
    EIdent(n, _) => match afe_lookup_local(binds, n) {
      Some(k) => k,
      None => throw_kind_lookup(n, false)
    },
    ECall(callee, _, _) => match callee {
      // A LOCAL of this name is being APPLIED. The scope tracks a local's VALUE
      // kind, never the kind of its RESULT, so the call is unresolvable -- and
      // it must not fall through to the module table, whose same-named
      // top-level function this local shadows.
      EIdent(f, _) => match afe_lookup_local(binds, f) {
        Some(_) => "",
        None => throw_kind_lookup(f, true)
      },
      _ => ""
    },
    _ => ""
  }
}

/// The row label a `throw` requires: the typed `Exception[K]::Throw` when the
/// payload's kind is resolvable, and the pinned erased `Exception::Throw`
/// otherwise. Non-exception operations pass through untouched.
fn throw_required_label(op_name: String, opargs: Array[Expr], binds: Array[(String, String)]) -> String {
  if is_exception_throw_operation(op_name) && Array::length(opargs) == 1 {
    exception_throw_label_for_kind(throw_payload_kind(Array::get(opargs, 0), binds))
  } else {
    op_name
  }
}

/// Which spelling of the missing label to REPORT. A row that names no
/// exception label at all is the pre-#1344 "this function cannot throw" case,
/// and its diagnostic stays byte-identical (`missing { Exception::Throw }`); the
/// typed spelling is surfaced only once the row is already speaking in kinds,
/// where it is the actionable fix-it.
fn throw_report_label(op_name: String, required: String, declared: Array[String]) -> String {
  let mut i = 0
  let mut typed_row = false
  while i < Array::length(declared) {
    if is_exception_label(Array::get(declared, i)) {
      typed_row = true
    }
    i = i + 1
  }
  if typed_row {
    required
  } else {
    op_name
  }
}

/// #1343 (ADR-0071 operation-level rows, builtin slice): the OPERATION-level
/// label a builtin call can be authorized by, in addition to its bare effect.
/// For a QUALIFIED builtin the canonical name IS the operation id
/// (`Fs::read_file`), so a row may grant just that one operation instead of the
/// whole effect. An UNQUALIFIED effectful builtin (`sh`, the `vibe_*_raw`
/// dunders) has no operation spelling a user could write, so it falls back to
/// its effect and behaves exactly as before.
///
/// Without this, host capabilities had NO granularity below the whole effect:
/// `with Fs::read_file` was rejected with `missing { Fs }` because the
/// builtin path only ever compared the bare label, even though ADR-0071 made
/// the operation the row's minimal unit and `perform Eff::Op` already honored
/// it. That is what forced coarse rows like `with Http` (serve + outbound
/// request + request-field reads in one grant).
fn builtin_call_op_label(name: String, eff: String) -> String {
  let normalized = canonical_builtin_name(name)
  if String::index_of(normalized, "::") > 0 {
    normalized
  } else {
    eff
  }
}

/// #2107: does a definition in the program own this name, making the builtin
/// of the same name unreachable at this call site? A lexical binding (closure
/// parameter, `let`) or a top-level function both shadow it, the same way
/// codegen resolves a source definition ahead of its builtin lowering.
fn source_definition_shadows_builtin(name: String, lexical_callee: Option[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Bool {
  match lexical_callee {
    Some(_) => true,
    None => match lookup_fn_effs(fn_names, fn_effs, name) {
      Some(_) => true,
      None => false
    }
  }
}

/// The complete set of UNQUALIFIED builtins that carry an effect row, and the
/// row each one carries. Everything else effectful in the registry is spelled
/// `Effect::op`, which `builtin_call_effect` resolves through `lookup_builtin`;
/// an unqualified name never reaches that lookup (the fast path there answers
/// None without it, on purpose -- the scan is over ~450 rows and runs on every
/// call in the program), so an unqualified effectful builtin that is missing
/// from this list is invisible to the row discipline entirely.
///
/// #2107: ten of them were. `println` / `print` lower onto
/// `Stdout::write_stream` / `Stdout::write_char`, the `vibe_tcp_*_raw` four
/// open and drive sockets, the `vibe_http_*_raw` five make outbound requests,
/// and `vibe_fs_stat_token_raw` stats a path -- all callable from a function
/// declaring no row at all, with a clean `vibe check` and a real host import
/// in the emitted module. Only the `sh` family had ever been listed.
///
/// `sleep` is deliberately absent: it carries `Async`, which
/// `is_entry_runtime_managed_effect` excludes at the caller anyway.
///
/// `builtin_registry_unqualified_row_test.vibe` derives this set from the
/// registry and fails if a new row appears that this list does not name, so it
/// cannot silently fall behind again.
fn unqualified_builtin_effect(name: String) -> Option[String] {
  // vibe_sh_lines_raw is checker_visible=false (only synthesized internally,
  // never typed by user source), so it needs no entry.
  if name == "sh" || name == "sh_lines"
  || name == "vibe_sh_capture_raw"
  || name == "vibe_sh_capture_exit_code_raw"
  || name == "vibe_sh_capture_stdout_raw"
  || name == "vibe_sh_capture_stderr_raw"
  || name == "vibe_sh_capture_close_raw"
  || name == "vibe_process_exit_raw" {
    Some("Process")
  } else if name == "println" || name == "print" {
    Some("Stdout")
  } else if name == "vibe_fs_stat_token_raw" {
    Some("Fs")
  } else if name == "vibe_tcp_connect_raw" || name == "vibe_tcp_read_raw"
  || name == "vibe_tcp_write_raw" || name == "vibe_tcp_close_raw" {
    Some("Socket")
  } else if name == "vibe_http_request_raw"
  || name == "vibe_http_response_status_raw"
  || name == "vibe_http_response_header_raw"
  || name == "vibe_http_response_body_raw"
  || name == "vibe_http_close_raw" {
    Some("Http")
  } else {
    None
  }
}

/// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful
/// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing
/// function to declare that effect, exactly like `perform`. Returns the required
/// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw
/// discipline) and `Async` (composition-allowed; handled by the async pass) are
/// deliberately excluded from this slice.
fn builtin_call_effect(name: String) -> Option[String] {
  let unqualified = unqualified_builtin_effect(name)
  if unqualified != None {
    match unqualified {
      Some(eff) => if is_entry_runtime_managed_effect(eff) {
        None
      } else {
        Some(eff)
      },
      None => None
    }
  } else if String::index_of(name, "::") < 0 {
    // Fast path: every OTHER effectful builtin in this slice is a QUALIFIED name
    // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a
    // callee with no `::` can never be one -- `unqualified_builtin_effect` above
    // is the complete list of the exceptions. Skipping `lookup_builtin` for the
    // (vastly more common) unqualified calls keeps the pass cheap enough to run
    // over the whole compiler source within the seed's heap during self-build.
    None
  } else {
    let normalized = canonical_builtin_name(name)
    match lookup_builtin(normalized) {
      Some(ty) => match ty {
        // Standard entry/runtime execution handles `Error`/`Exception[K]`
        // (entry-boundary exception policy) and `Async` (runtime scheduling),
        // so builtin calls carrying either label add no checker row
        // requirement. core/standard_effect_policy.vibe is the single
        // behavior-preserving definition.
        CtFn(_, _, Some(eff)) => if is_entry_runtime_managed_effect(eff) {
          None
        } else {
          Some(eff)
        },
        _ => None
      },
      None => None
    }
  }
}

fn labels_union(a: Array[String], b: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    let l = Array::get(b, j)
    let mut seen = false
    let mut k = 0
    while k < Array::length(out) {
      if Array::get(out, k) == l {
        seen = true
      }
      k = k + 1
    }
    if !seen {
      Array::push(out, l)
    }
    j = j + 1
  }
  out
}

/// #639: deterministic lexical label ordering for effect-row diagnostics.
/// The typed helper keeps Array-sourced labels on String relational lowering
/// (#1184).
fn label_lt(a: String, b: String) -> Bool {
  a < b
}

/// Copying insertion sort (rows are tiny — a handful of labels at most).
fn sort_labels(xs: Array[String]) -> Array[String] {
  let out = Array::slice(xs, 0, Array::length(xs))
  let mut i = 1
  while i < Array::length(out) {
    let key = Array::get(out, i)
    let mut j = i
    while j > 0 && label_lt(key, Array::get(out, j - 1)) {
      Array::set(out, j, Array::get(out, j - 1))
      j = j - 1
    }
    Array::set(out, j, key)
    i = i + 1
  }
  out
}

fn join_labels(xs: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(xs) {
    if i == 0 {
      out = Array::get(xs, i)
    } else {
      out = String::concat(out, String::concat(", ", Array::get(xs, i)))
    }
    i = i + 1
  }
  out
}

/// #639: build the effect-row mismatch diagnostic for a perform/call whose
/// required effects are absent from the enclosing declaration's row. `missing`
/// is the set difference (callee requires minus caller declares), rendered
/// sorted; `required` is the sorted union the fix-it hint suggests declaring.
fn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String], off: Int) -> EffectError {
  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))
  let required = sort_labels(labels_union(declared, missing))
  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(declared), join_labels(required), off)
}

fn is_program_entry_name(name: String) -> Bool {
  name == "main" || name == "_start"
}

// User declarations can legally reuse a provider spelling such as `Fs`.
// Retain operation identity rather than only the effect name: the selfhost
// linked program contains private `effect Env { Get ... }` declarations as
// well as the real host `Env::get` builtin used by its entry point.
let entry_user_effect_operations: Array[String] = array_empty()

fn collect_entry_user_effect_operations(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, ops) => {
        let mut oi = 0
        while oi < Array::length(ops) {
          let (op_name, _, _) = Array::get(ops, oi)
          let label = String::concat(name, String::concat("::", op_name))
          if effect_row_has_label(Some(out), label) {
            ()
          } else {
            Array::push(out, label)
          }
          oi = oi + 1
        }
      },
      SModule(_, _, body) => collect_entry_user_effect_operations(body, out),
      _ => ()
    }
    i = i + 1
  }
}

fn set_entry_user_effect_operations(stmts: Array[Stmt]) -> Unit {
  Array::truncate(entry_user_effect_operations, 0)
  collect_entry_user_effect_operations(stmts, entry_user_effect_operations)
}

fn user_provider_collision_errors(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, effect_name, _, operations) => {
        let mut oi = 0
        while oi < Array::length(operations) {
          let (op_name, _, _) = Array::get(operations, oi)
          let operation = String::concat(effect_name, String::concat("::", op_name))
          if standard_provider_owns_operation(operation) {
            Array::push(errors, EEProviderOperationCollision(operation))
          } else {
            ()
          }
          oi = oi + 1
        }
      },
      SModule(_, _, body) => append_eff_errs(errors, user_provider_collision_errors(body)),
      _ => ()
    }
    i = i + 1
  }
  errors
}

fn entry_label_is_user_declared_operation(label: String) -> Bool {
  String::index_of(label, "::") > 0 && effect_row_has_label(Some(entry_user_effect_operations), label)
}

export fn standard_provider_owns_operation(label: String) -> Bool {
  match builtin_call_effect(label) {
    Some(owner) => is_entry_admitted_effect(owner) && label == canonical_builtin_name(label),
    None => false
  }
}

/// #1961: instantiate freeze uses the same identity as WIT/cache/checker.
/// A bare provider name (`Fs`) is authority for that namespace. A qualified
/// label is authority only when it is an exact registry-owned operation
/// (`Console::write_stream`). `Console::Get` is not frozen as host Console.
fn strip_authority_grade(label: String) -> String {
  let n = String::length(label)
  if n > 0 && String::char_code_at(label, n - 1) == 63 {
    String::substring(label, 0, n - 1)
  } else {
    label
  }
}

fn authority_is_optional(label: String) -> Bool {
  let n = String::length(label)
  n > 0 && String::char_code_at(label, n - 1) == 63
}

export fn is_instantiate_authority(label: String) -> Bool {
  let core = strip_authority_grade(label)
  if String::index_of(core, "::") < 0 {
    has_standard_host_provider(core)
  } else {
    standard_provider_owns_operation(core)
  }
}

/// #1961 / ADR-0088 L2: freeze optional resolution before run.
/// Required owned operations are Granted; Optional ones are NotGranted
/// (non-TTY instantiate default). Labels that are not instantiate
/// authority are dropped — check_entry_declared_effects already rejects them.
export fn freeze_binding_lock(labels: Array[String]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let status = if authority_is_optional(lab) {
        "NotGranted"
      } else {
        "Granted"
      }
      Array::push(out, (core, status))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn host_grant_covers(host_granted: Array[String], core: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(host_granted) && !found {
    let g = Array::get(host_granted, i)
    if g == core {
      found = true
    } else if String::index_of(g, "::") < 0 && has_standard_host_provider(g) {
      if core == g || effect_name_of_op(core) == g {
        found = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn allow_flag_for_authority(core: String) -> String {
  let provider = if String::index_of(core, "::") < 0 {
    core
  } else {
    effect_name_of_op(core)
  }
  if provider == "Fs" {
    "--allow-fs"
  } else if provider == "Console" {
    "--allow-console"
  } else if provider == "Env" {
    "--allow-env"
  } else if provider == "Stdout" {
    "--allow-stdout"
  } else if provider == "Stdin" {
    "--allow-stdin"
  } else if provider == "Http" {
    "--allow-http"
  } else {
    String::concat("--allow-", provider)
  }
}

/// #1961 / ADR-0088 L3: non-TTY instantiate preflight.
/// `host_granted` is what the composed host will actually inject this run.
/// Required instantiate-authority labels missing from it abort before main,
/// with the `--allow-*` spelling. Optional missing stay NotGranted; a
/// granted optional becomes Granted. Labels that are not instantiate
/// authority are dropped, same as freeze_binding_lock.
export fn preflight_instantiate(labels: Array[String], host_granted: Array[String]) -> Array[(String, String)] with Exception {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let lab = Array::get(labels, i)
    if is_instantiate_authority(lab) {
      let core = strip_authority_grade(lab)
      let granted = host_grant_covers(host_granted, core)
      if authority_is_optional(lab) {
        let status = if granted {
          "Granted"
        } else {
          "NotGranted"
        }
        Array::push(out, (core, status))
      } else if granted {
        Array::push(out, (core, "Granted"))
      } else {
        throw(String::concat("instantiate preflight: required `", String::concat(core, String::concat("` is not granted; pass `", String::concat(allow_flag_for_authority(core), String::concat("` before main starts, or mark it optional (`allows ", String::concat(core, "?`)")))))))
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn authority_covers_operation(auth: String, emitted: String) -> Bool {
  if authority_is_optional(auth) {
    false
  } else if auth == emitted {
    true
  } else if String::index_of(auth, "::") < 0 && standard_provider_owns_operation(emitted) {
    effect_name_of_op(emitted) == auth
  } else if auth == "Console" && is_legacy_console_label(effect_name_of_op(emitted)) {
    // The instantiate-grant half of #2102's containment. `allows` is a
    // SEPARATE authorization path from the `with` row (ADR-0075/0084/0088:
    // authority is fixed once, at instantiate), so teaching only
    // `decl_authorizes_effect` left the split form unable to express what the
    // bare form could -- `fn main with () allows Console { println(..) }` was
    // rejected while `fn main with Console { println(..) }` compiled. Same
    // one-way rule and same reason: `Console` is the union, the legacy labels
    // are subsets, and the reverse would widen authority.
    true
  } else {
    false
  }
}

fn decl_authorizes_optional_op(labels: Array[String], op_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) && !found {
    let lab = Array::get(labels, i)
    if authority_is_optional(lab) {
      let core = strip_authority_grade(lab)
      if core == op_name || core == effect_name_of_op(op_name) || authority_covers_operation(core, op_name) {
        found = true
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn perform_question_op_name(arg: Expr) -> Option[String] {
  match arg {
    ECall(op_callee, _, _) => match op_callee {
      EIdent(op_name, _) => Some(op_name),
      _ => None
    },
    EIdent(op_name, _) => Some(op_name),
    _ => None
  }
}

fn entry_user_operation_requires_handler(label: String) -> Bool {
  // #1961: a source-declared operation is algebraic even when its spelling
  // matches a host provider. Exact collisions are rejected separately and
  // never grant provider authority from the text of the perform.
  entry_label_is_user_declared_operation(label)
}

fn entry_unresolved_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    if label_is_effect_var(label) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

fn entry_unadmitted_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    // Row variables are separated above so they receive the closed-row hint;
    // this list contains only concrete effects that lack an entry owner.
    if !label_is_effect_var(label) && (entry_user_operation_requires_handler(label) || !is_entry_admitted_effect(label)) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  sort_labels(labels_union(no_str_labels(), out))
}

fn entry_handler_labels(labels: Array[String]) -> Array[String] {
  let out = no_str_labels()
  let mut i = 0
  while i < Array::length(labels) {
    let base = effect_name_of_op(Array::get(labels, i))
    if effect_row_has_label(Some(out), base) {
      ()
    } else {
      Array::push(out, base)
    }
    i = i + 1
  }
  sort_labels(out)
}

fn make_contextual_row_error(fn_name: String, declared: Array[String], missing: Array[String], off: Int) -> EffectError {
  let unresolved = entry_unresolved_labels(missing)
  let bad = entry_unadmitted_labels(missing)
  if is_program_entry_name(fn_name) && Array::length(unresolved) > 0 {
    EEUnresolvedEntryEffectRow(fn_name, join_labels(unresolved), off)
  } else if is_program_entry_name(fn_name) && Array::length(bad) > 0 {
    EEUndischargedEntryEffect(fn_name, join_labels(bad), join_labels(entry_handler_labels(bad)), off)
  } else {
    make_row_mismatch(fn_name, declared, missing, off)
  }
}

fn first_expr_offset(root: Expr) -> Int {
  let stack = Array::slice([root], 0, 1)
  let mut first = 0 - 1
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let expr = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    let off = match expr {
      EIdent(_, x) => x,
      ELet(_, _, _, x) => x,
      ELetMut(_, _, _, x) => x,
      ECall(_, _, x) => x,
      EDot(_, _, x, _) => x,
      _ => 0 - 1
    }
    if off >= 0 && (first < 0 || off < first) {
      first = off
    } else {
      ()
    }
    let children = expr_children(expr)
    let mut i = 0
    while i < Array::length(children) {
      Array::push(stack, Array::get(children, i))
      i = i + 1
    }
  }
  first
}

fn raw_fn_effect_string(ty: Option[TypeExpr], body: Expr) -> String {
  match ty {
    Some(TyFn(_, _, Some(s))) => s,
    _ => match body {
      EFn(_, _, _, _, Some(s), _) => s,
      _ => ""
    }
  }
}

fn push_unique_label(out: Array[String], lab: String) -> Unit {
  if String::length(lab) == 0 || effect_row_has_label(Some(out), lab) {
    ()
  } else {
    Array::push(out, lab)
  }
}

fn collect_unhandled_entry_ops(root: Expr) -> Array[String] {
  let out = no_str_labels()
  let stack = array_empty()
  Array::push(stack, (root, no_str_labels()))
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let (expr, discharged) = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match expr {
      EHandle(body, arms) => {
        let inner = labels_union(discharged, collect_handle_effects(arms))
        Array::push(stack, (body, inner))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, ai)
          Array::push(stack, (arm_body, discharged))
          ai = ai + 1
        }
      },
      EFn(_, _, _, _, _, _) => (),
      ECall(callee, args, _) => {
        match callee {
          EIdent(name, _) => {
            if name == "perform?" && Array::length(args) == 1 {
              // Optional perform does not emit a required unhandled op.
              // Walk only the operation arguments so the inner builtin is
              // not counted as a required host call.
              match Array::get(args, 0) {
                ECall(_, opargs, _) => {
                  let mut oi = 0
                  while oi < Array::length(opargs) {
                    Array::push(stack, (Array::get(opargs, oi), discharged))
                    oi = oi + 1
                  }
                },
                _ => ()
              }
            } else if name == "perform" && Array::length(args) == 1 {
              match Array::get(args, 0) {
                ECall(op_callee, _, _) => match op_callee {
                  EIdent(op_name, _) => {
                    if label_is_handled(op_name, discharged) {
                      ()
                    } else {
                      push_unique_label(out, op_name)
                    }
                  },
                  _ => ()
                },
                EIdent(op_name, _) => {
                  if label_is_handled(op_name, discharged) {
                    ()
                  } else {
                    push_unique_label(out, op_name)
                  }
                },
                _ => ()
              }
              Array::push(stack, (callee, discharged))
              let mut ai = 0
              while ai < Array::length(args) {
                Array::push(stack, (Array::get(args, ai), discharged))
                ai = ai + 1
              }
            } else {
              match builtin_call_effect(name) {
                Some(eff) => {
                  let op_label = builtin_call_op_label(name, eff)
                  if label_is_handled(op_label, discharged) || label_is_handled(eff, discharged) {
                    ()
                  } else {
                    push_unique_label(out, op_label)
                  }
                },
                None => ()
              }
              Array::push(stack, (callee, discharged))
              let mut pai = 0
              while pai < Array::length(args) {
                Array::push(stack, (Array::get(args, pai), discharged))
                pai = pai + 1
              }
            }
          },
          _ => {
            Array::push(stack, (callee, discharged))
            let mut ai = 0
            while ai < Array::length(args) {
              Array::push(stack, (Array::get(args, ai), discharged))
              ai = ai + 1
            }
          }
        }
      },
      _ => {
        let children = expr_children(expr)
        let mut ci = 0
        while ci < Array::length(children) {
          Array::push(stack, (Array::get(children, ci), discharged))
          ci = ci + 1
        }
      }
    }
  }
  out
}

fn collect_expr_handle_effects(root: Expr) -> Array[String] {
  let out = no_str_labels()
  let stack = Array::slice([root], 0, 1)
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let expr = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match expr {
      EHandle(_, arms) => {
        let discharged = collect_handle_effects(arms)
        let mut i = 0
        while i < Array::length(discharged) {
          let lab = Array::get(discharged, i)
          if effect_row_has_label(Some(out), lab) {
            ()
          } else {
            Array::push(out, lab)
          }
          i = i + 1
        }
      },
      _ => ()
    }
    let children = expr_children(expr)
    let mut ci = 0
    while ci < Array::length(children) {
      Array::push(stack, Array::get(children, ci))
      ci = ci + 1
    }
  }
  out
}

fn label_is_handled(label: String, handled: Array[String]) -> Bool {
  if effect_row_has_label(Some(handled), label) {
    true
  } else {
    let base = effect_name_of_op(label)
    effect_row_has_label(Some(handled), base)
  }
}

fn label_is_authorized(label: String, auth: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = false
  while i < Array::length(auth) {
    if authority_covers_operation(Array::get(auth, i), label) {
      ok = true
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn check_entry_declared_effects(fn_name: String, ty: Option[TypeExpr], body: Expr) -> Array[EffectError] {
  let errors = array_empty()
  let raw = raw_fn_effect_string(ty, body)
  let allows = effect_row_allows_text(raw)
  let inspect_body = match body {
    EFn(_, _, _, _, _, fbody) => fbody,
    _ => body
  }
  let off = first_expr_offset(inspect_body)
  if String::length(allows) > 0 {
    let emitted = effect_row_labels(effect_row_parse(Some(raw)))
    let auth = effect_row_labels(effect_row_parse(Some(allows)))
    let mut ai = 0
    while ai < Array::length(auth) {
      let lab = Array::get(auth, ai)
      if is_instantiate_authority(lab) {
        ()
      } else {
        Array::push(errors, EEUnauthorizedInstantiateAuthority(lab))
      }
      ai = ai + 1
    }
    let unhandled = collect_unhandled_entry_ops(inspect_body)
    let unresolved = entry_unresolved_labels(emitted)
    if Array::length(unresolved) > 0 {
      Array::push(errors, EEUnresolvedEntryEffectRow(fn_name, join_labels(unresolved), off))
    } else {
      let mut ui = 0
      while ui < Array::length(unhandled) {
        let lab = Array::get(unhandled, ui)
        if label_is_authorized(lab, auth) {
          ()
        } else {
          Array::push(errors, EEUnauthorizedEntryOperation(fn_name, lab, allows, off))
        }
        ui = ui + 1
      }
    }
  } else if is_program_entry_name(fn_name) {
    let labels = fn_binding_effects(ty, body)
    let unresolved = entry_unresolved_labels(labels)
    let bad = entry_unadmitted_labels(labels)
    if Array::length(unresolved) > 0 || Array::length(bad) > 0 {
      if Array::length(unresolved) > 0 {
        Array::push(errors, EEUnresolvedEntryEffectRow(fn_name, join_labels(unresolved), off))
      } else {
        Array::push(errors, EEUndischargedEntryEffect(fn_name, join_labels(bad), join_labels(entry_handler_labels(bad)), off))
      }
    } else {
      ()
    }
  } else {
    ()
  }
  errors
}

/// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after
/// handling E the body need not declare it. The parser qualifies each handler
/// arm pattern as `E::Op`, so the discharged effect names are recoverable as the
/// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a
/// handle discharges (empty if none could be determined — then the body stays
/// conservatively permissive, never over-strict).
///
/// ADR-0071 (#755) step 4: ALSO push each arm's own fully-qualified operation
/// name (`Ask::Get`, not just the bare `Ask` prefix). `handle ... with Ask
/// {...}` is exhaustive over every operation of Ask (ADR-0050 -- a handler
/// can't discharge only some operations), so discharging the bare effect
/// name is semantically equivalent to discharging every one of its qualified
/// operation names. But the DOWNSTREAM containment check
/// (decl_authorizes_effect) does exact string-label matching: a handled
/// body that transitively calls a function declaring `with Ask::Get`
/// (operation-level, not the bare effect) previously reported that specific
/// requirement as still missing even though the handle plainly covers it --
/// "Ask" != "Ask::Get" as strings, and the discharge list only ever
/// contained the bare form. Pushing the qualified name too is a pure
/// widening (nothing that was authorized before stops being authorized; the
/// bare-effect-name discharge and its blanket effect_name_of_op-based
/// authorization inside the body are both untouched), so it only fixes this
/// gap without changing any other observable behavior.
fn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => {
        let idx = String::index_of(name, "::")
        if idx > 0 {
          let eff = canonical_exception_effect_name(name[0: idx])
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == eff {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, eff)
          }
          let mut qseen = false
          let mut k = 0
          while k < Array::length(out) {
            if Array::get(out, k) == name {
              qseen = true
            }
            k = k + 1
          }
          if !qseen {
            Array::push(out, name)
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of
/// recursion, so the pass never exhausts the wasm call stack however deeply the
/// compiler's own source nests (long `let`/`seq` spines AND nested
/// if/match/call forms). Each stack item carries its (expr, declared, in_handle)
/// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it
/// with the discharged effects (criterion 2). Order of traversal differs from a
/// recursive pre-order walk, but the SET of effect errors found is identical, so
/// the accept/reject decision is unchanged.
/// The declared effect row of a top-level binding: the signature's `with` row
/// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with
/// { E }`). Used to build the call-graph effect map for transitive enforcement.
fn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {
  let sig = sig_type_effect_labels(ty)
  match body {
    EFn(_, _, _, _, eff, _) => labels_union(sig, labels_union(effect_row_labels(effect_row_parse(eff)), effect_row_allows_labels(eff))),
    _ => sig
  }
}

/// #1485: the effect labels a PARAMETER's own type declares. `(T) -> T with e`
/// yields `["e"]`; a non-function parameter yields nothing.
fn param_type_effect_labels(pty: TypeExpr) -> Array[String] {
  match pty {
    TyFn(_, _, peff) => effect_row_labels(effect_row_parse(peff)),
    _ => no_str_labels()
  }
}

/// #1485: per-PARAMETER effect labels for one top-level binding, positionally.
/// `apply: [T](f: (T) -> T with e, x: T) -> T with e` yields `[["e"], []]`.
///
/// This is the data call-site row unification needs. To resolve what a callee's
/// row VARIABLE binds to at ONE call site you have to know which of its
/// parameters carry that variable, and then look at what was actually passed
/// there -- the callee's own row alone cannot tell you, which is exactly why
/// the transitive check used to exempt row variables outright.
///
/// Both spellings of a signature are read, because they put the parameter types
/// in different places: a separate annotation (`let apply: [T](f: (T) -> T with
/// e, ..) -> T = ..`) carries them on the `SLet`'s `TyFn`, while the inline
/// generic literal (`let apply = [T](f: (x: T) -> T with e, ..) -> T with e
/// { .. }`, the form both #1485 fixtures use) carries them on the `EFn`.
fn fn_binding_param_effects(ty: Option[TypeExpr], body: Expr) -> Array[Array[String]] {
  let out = array_empty()
  match ty {
    Some(TyFn(sig_params, _, _)) => {
      let mut i = 0
      while i < Array::length(sig_params) {
        Array::push(out, param_type_effect_labels(Array::get(sig_params, i)))
        i = i + 1
      }
    },
    _ => match body {
      EFn(_, _, params, _, _, _) => {
        let mut i = 0
        while i < Array::length(params) {
          let (_, pty) = Array::get(params, i)
          match pty {
            Some(t) => Array::push(out, param_type_effect_labels(t)),
            None => Array::push(out, no_str_labels())
          }
          i = i + 1
        }
      },
      _ => ()
    }
  }
  out
}

fn no_param_effs() -> Array[Array[Array[String]]] {
  array_empty()
}

/// One callee's "no parameter rows known" entry.
fn no_param_row() -> Array[Array[String]] {
  array_empty()
}

/// Positional lookup companion to `lookup_fn_effs` -- same parallel-array
/// discipline (see that function's note on why this is a linear scan).
fn lookup_fn_param_effs(names: Array[String], param_effs: Array[Array[Array[String]]], name: String) -> Option[Array[Array[String]]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(names) && i < Array::length(param_effs) {
    match found {
      None => if Array::get(names, i) == name {
        found = Some(Array::get(param_effs, i))
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// #1485: what a callee's row VARIABLE is instantiated to at ONE call site.
///
/// `row_var` is a row-variable label from the callee's declared row (e.g. `"e"` of
/// `apply: [T](f: (T) -> T with e, x: T) -> T with e`). For every parameter
/// whose own type declares that same variable, the argument actually passed
/// there is resolved to its declared row, and the union of those rows is what
/// the variable binds to here.
///
/// Returns None when the instantiation cannot be determined, and the caller
/// then keeps the pre-#1485 exemption. That happens when a contributing
/// argument is anything other than a name this pass can look up, or a closure
/// literal that DECLARES its row (#2078) -- a call result, a field access, an
/// unannotated lambda. Bailing out there is what keeps the
/// change one-directional: a call site either gains a requirement that is
/// justified by a row we actually read, or is left exactly as it was. It never
/// guesses, so it cannot produce the false positives that sank the naive fix
/// (`generic_effect_matrix_ok_passthrough_pure`, where `apply(inc, 41)` passes
/// a PURE function and must keep requiring nothing).
fn resolve_row_var_instantiation(row_var: String, callee_param_effs: Array[Array[String]], args: Array[Expr], fn_names: Array[String], fn_effs: Array[Array[String]], ov_names: Array[String], ov_effs: Array[Array[String]]) -> Option[Array[String]] {
  let out = no_str_labels()
  let mut i = 0
  let mut bailed = false
  let mut saw_param = false
  while i < Array::length(callee_param_effs) {
    if effect_row_has_label(Some(Array::get(callee_param_effs, i)), row_var) {
      saw_param = true
      if i < Array::length(args) {
        match Array::get(args, i) {
          EIdent(argname, _) => {
            // A named argument: its row is whatever the call-graph map or the
            // in-scope callback overlay records for it. An argument naming
            // nothing either table knows (an import this pass cannot see) is a
            // bail-out, not an empty row -- treating "unknown" as "pure" would
            // silently authorize the very leak this is closing.
            // #1723: argument names obey the same lexical precedence as the
            // callee itself. An explicit empty overlay entry is a pure local
            // shadow, not permission to consult a same-named top-level fn.
            match lookup_fn_effs(ov_names, ov_effs, argname) {
              Some(argeffs) => {
                let mut k = 0
                while k < Array::length(argeffs) {
                  let lbl = Array::get(argeffs, k)
                  if effect_row_has_label(Some(out), lbl) {
                    ()
                  } else {
                    Array::push(out, lbl)
                  }
                  k = k + 1
                }
              },
              None => match lookup_fn_effs(fn_names, fn_effs, argname) {
                Some(argeffs2) => {
                  let mut k2 = 0
                  while k2 < Array::length(argeffs2) {
                    let lbl2 = Array::get(argeffs2, k2)
                    if effect_row_has_label(Some(out), lbl2) {
                      ()
                    } else {
                      Array::push(out, lbl2)
                    }
                    k2 = k2 + 1
                  }
                },
                None => {
                  bailed = true
                }
              }
            }
          },
          EFn(_, _, _, _, eff, _) => match effect_row_parse(eff) {
            // #2078: a closure literal that DECLARES its row needs no
            // guessing -- the row is written at the argument position. It was
            // bailing here, and the two mechanisms that would otherwise catch
            // it both stand down for this exact shape: an explicit annotation
            // suppresses the lexical charge to the enclosing function (an
            // unannotated literal's `perform` still lands there, which is why
            // that case keeps bailing below), and the named-argument arm above
            // never sees a literal. The result was a program that performs an
            // effect with no handler and no declared row anywhere, compiles
            // clean, and traps at runtime.
            Some(lambda_effs) => {
              let mut li = 0
              while li < Array::length(lambda_effs) {
                let llbl = Array::get(lambda_effs, li)
                if effect_row_has_label(Some(out), llbl) {
                  ()
                } else {
                  Array::push(out, llbl)
                }
                li = li + 1
              }
            },
            // An INFERRED row (`None`, structurally distinct from `Some([])`)
            // inherits its surrounding context, so reading it here would be
            // the guess this function exists not to make. Bail and keep the
            // pre-#1485 exemption; the enclosing function's own row check is
            // what covers this shape.
            None => {
              bailed = true
            }
          },
          _ => {
            bailed = true
          }
        }
      } else {
        bailed = true
      }
    } else {
      ()
    }
    i = i + 1
  }
  if bailed || !saw_param {
    None
  } else {
    Some(out)
  }
}

/// Look up a called function's declared effect row by linear scan over PARALLEL
/// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across
/// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap
/// (#626 OOM); the linear scan allocates nothing.
fn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(names) {
    match found {
      None => if Array::get(names, i) == name {
        found = Some(Array::get(effs, i))
      } else {
        ()
      },
      Some(_) => ()
    }
    i = i + 1
  }
  found
}

/// #885 review (Codex): a `let`/`let rec`/`let mut` binding can reuse the NAME
/// of an in-scope callback-parameter overlay entry (e.g. rebinding `f` to an
/// unrelated local pure closure). Without this, `lookup_fn_effs`'s first-match
/// scan would still find the SHADOWED outer entry and reject a call to the
/// new, unrelated binding as if it were the original effectful callback --
/// a false positive on valid shadowing. Removes every overlay entry matching
/// `name` before the shadowing binding's scope is pushed onto the stack.
/// #885 review (Codex): shadow the overlay by EVERY name in `params`, in one
/// pass — used at an EFn boundary where all of the lambda's own parameter
/// names (not just the ones that become new overlay entries) must block a
/// same-named inherited entry.
fn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {
  let mut cur_names = names
  let mut cur_effs = effs
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    let shadowed = shadow_overlay(cur_names, cur_effs, pname)
    cur_names = shadowed.0
    cur_effs = shadowed.1
    i = i + 1
  }
  (cur_names, cur_effs)
}

fn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {
  let out_names = array_empty()
  let out_effs = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    if Array::get(names, i) != name {
      Array::push(out_names, Array::get(names, i))
      Array::push(out_effs, Array::get(effs, i))
    } else {
      ()
    }
    i = i + 1
  }
  (out_names, out_effs)
}

/// Add lexical bindings that carry no effect row. These empty entries are
/// semantically meaningful: they stop lookup from falling through to a
/// same-named top-level function (#1723).
fn effect_name_exists(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    found = Array::get(names, i) == name
    i = i + 1
  }
  found
}

fn overlay_bind_empty(names: Array[String], effs: Array[Array[String]], name: String, fn_names: Array[String]) -> (Array[String], Array[Array[String]]) {
  let (sn, se) = shadow_overlay(names, effs, name)
  // Most locals cannot fall through to a top-level function, so retaining an
  // empty marker for every binding only lengthens every descendant snapshot.
  // The marker is needed exactly when the fallback table contains this name.
  if !effect_name_exists(fn_names, name) {
    return (sn, se)
  }
  let out_names = [name]
  let out_effs = [no_str_labels()]
  let mut i = 0
  while i < Array::length(sn) {
    Array::push(out_names, Array::get(sn, i))
    Array::push(out_effs, Array::get(se, i))
    i = i + 1
  }
  (out_names, out_effs)
}

fn overlay_bind_empty_names(names: Array[String], effs: Array[Array[String]], bound: Array[String], fn_names: Array[String]) -> (Array[String], Array[Array[String]]) {
  let mut cur_names = names
  let mut cur_effs = effs
  let mut i = 0
  while i < Array::length(bound) {
    let next = overlay_bind_empty(cur_names, cur_effs, Array::get(bound, i), fn_names)
    cur_names = next.0
    cur_effs = next.1
    i = i + 1
  }
  (cur_names, cur_effs)
}

fn overlay_bind_empty_pat(names: Array[String], effs: Array[Array[String]], pat: Pat, fn_names: Array[String]) -> (Array[String], Array[Array[String]]) {
  let bound = array_empty()
  collect_pat_binds_into(pat, bound)
  overlay_bind_empty_names(names, effs, bound, fn_names)
}

/// #885 (split off from #838, originally scoped out at #626): a function-typed
/// PARAMETER (a callback, e.g. `f: (T) -> T with e`) is a call-graph leaf
/// exactly like a named top-level function, but `fn_names`/`fn_effs` above is
/// built ONLY from top-level `SLet`/`SLetMut` bindings, so invoking a callback
/// PARAMETER directly (`f(x)` inside the wrapper that owns `f`) was invisible to
/// the transitive check — no lookup ever matched `f`'s name, so nothing was
/// required. This is a SEPARATE parallel-array "overlay" (ov_names/ov_effs),
/// scoped to the function body currently being walked (extended when the walk
/// descends into an `EFn`, carried unchanged through every other node), that
/// records each in-scope function-typed parameter's declared effect labels.
///
/// Deliberately narrower than the general transitive check: callback-parameter
/// labels are checked via `decl_authorizes_effect` WITHOUT the
/// `label_is_effect_var` exemption used below for calls to NAMED top-level
/// functions. That exemption exists to prevent a real unsoundness of its own —
/// naively requiring the LITERAL row-variable token (e.g. `"e"`) to appear in
/// the CALLER's declared row at a call site like `apply(inc, 41)` — since the
/// caller has no way to know the row variable resolves to nothing without
/// call-site effect-row UNIFICATION (matching the argument actually passed
/// against the callee's parameter type), which this pass does not perform. This
/// is exactly the naive fix rejected during #885's investigation: dropping the
/// exemption globally broke `generic_effect_matrix_ok_passthrough_pure.vibe`.
/// The callback-parameter case is different in kind: the row variable and the
/// declared effect being compared live in the SAME function signature (the
/// parameter's `with e` and the enclosing function's own `with e` are
/// the identical token by construction — no cross-call-site instantiation is
/// involved), so a literal-name check here is sound, not a naive shortcut.
/// #1361: a LOCAL `let f = () -> T with E { .. }` is a call-graph leaf just
/// like a top-level function or a callback PARAMETER (#885), but NEITHER table
/// knew about it: `fn_names`/`fn_effs` is built only from top-level SLet/SLetMut
/// bindings, and `build_param_overlay` only from function-typed parameters. So
/// `f()` leaked nothing into the enclosing body, while the closure's own body
/// satisfied its own declared row (the EFn arm's `effect_row_inherit`) — a
/// function declaring `with Stdout` could reach `Env` through a local
/// closure with no diagnostic at all, and file_entry_cacheable /
/// file_tests_cacheable consequently judged such an entry cacheable (its stdout
/// varies with the environment, so the doctest cache replayed a stale run).
/// Registering the binding in the SAME overlay the callback case uses closes
/// both at once, with the same semantics: the row leaks at the call site unless
/// the caller declares it or a `handle` discharges it.
///
/// Only a literal `EFn` value is registered. An ANNOTATED local binding
/// (`let f: () -> T with E = ..`) is desugared to an ascription call
/// (`((__asc: T) -> __asc)(e)`, ascribe_wrap) before this walk runs, so its row
/// is not visible here — that shape keeps the old, permissive behavior rather
/// than being half-checked.
/// #1515: a local binding's row, when the VALUE is a bare NAME rather than a
/// closure literal — `let f = eff` / `let g = f`, an ALIAS of something that
/// already carries a row.
///
/// The `EFn` arm below (#1361) covers a literal with its own declared row, and
/// #885's parameter overlay covers a row-carrying parameter, so an alias was the
/// one shape left where the row vanished: `overlay_bind_local` shadowed the name
/// out and re-registered nothing, and the walker's `ECall` arm then saw a name in
/// no table at all and let the call through unchecked. Measured (and reproducing
/// on the committed seed, so this predates #1451):
///
///   fn eff(s: String) -> Unit with Log::Emit { perform Log::Emit(s) }
///   fn caller() -> Unit { let f = eff; f("boom") }   // compiled clean
///
/// while the direct `eff("boom")` and the parameter form were both correctly
/// rejected. Resolution order matches `lookup_fn_effs`'s own: the OVERLAY first
/// (an inner binding shadows an outer one), then the top-level call-graph map.
fn alias_fn_overlay_labels(name: String, ov_names: Array[String], ov_effs: Array[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[String] {
  match lookup_fn_effs(ov_names, ov_effs, name) {
    Some(labels) => labels,
    None => match lookup_fn_effs(fn_names, fn_effs, name) {
      Some(labels) => labels,
      None => no_str_labels()
    }
  }
}

fn local_fn_overlay_labels(val: Expr, ov_names: Array[String], ov_effs: Array[Array[String]], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[String] {
  match val {
    EFn(_, _, _, _, eff, _) => effect_row_labels(effect_row_parse(eff)),
    EIdent(n, _) => alias_fn_overlay_labels(n, ov_names, ov_effs, fn_names, fn_effs),
    _ => no_str_labels()
  }
}

/// Shadow `name` out of the inherited overlay (a local binding always hides an
/// outer entry of the same name), then re-register it when its value is a
/// row-declaring closure. The new entry goes FIRST so `lookup_fn_effs`'s
/// first-match scan finds it.
fn overlay_bind_local(names: Array[String], effs: Array[Array[String]], name: String, val: Expr, fn_names: Array[String], fn_effs: Array[Array[String]]) -> (Array[String], Array[Array[String]]) {
  let shadowed = shadow_overlay(names, effs, name)
  // #1515: resolve an ALIAS against the pre-shadow overlay -- `let f = f`
  // rebinds to the OUTER `f`, so the lookup must see the entry the shadow is
  // about to remove.
  let labels = local_fn_overlay_labels(val, names, effs, fn_names, fn_effs)
  // #1723: an empty row is still a lexical binding. Keeping an explicit
  // empty entry is what distinguishes "a pure local shadows this name" from
  // "no local binding; consult the top-level function table".
  if Array::length(labels) == 0 && !effect_name_exists(fn_names, name) {
    return shadowed
  }
  let out_names = [name]
  let out_effs = [labels]
  let (sn, se) = shadowed
  let mut i = 0
  while i < Array::length(sn) {
    Array::push(out_names, Array::get(sn, i))
    Array::push(out_effs, Array::get(se, i))
    i = i + 1
  }
  (out_names, out_effs)
}

fn build_param_overlay(params: Array[(String, Option[TypeExpr])], fn_names: Array[String]) -> (Array[String], Array[Array[String]]) {
  let names = array_empty()
  let effs = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let labels = match ptype {
      Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),
      _ => no_str_labels()
    }
    // #1723: all parameters are lexical bindings. A pure callback (or even a
    // non-function parameter later rejected by typing) must mask a same-named
    // top-level function during this independent effect walk.
    if Array::length(labels) > 0 || effect_name_exists(fn_names, pname) {
      Array::push(names, pname)
      Array::push(effs, labels)
    } else {
      ()
    }
    i = i + 1
  }
  (names, effs)
}

/// A `let apply: [T](f: (T) -> T with e, x: T) -> T = (f, x) -> { f(x) }`
/// binding (separate top-level type annotation + untyped lambda) parses to an
/// `EFn` whose OWN `params` carry no per-parameter `TypeExpr` at all (the types
/// live only on the `SLet`'s `ty` field). `build_param_overlay` needs real
/// per-parameter types to find a callback parameter's declared effect, so this
/// fills in each untyped `EFn` parameter from `ty`'s `TyFn` parameter list at
/// the SAME position — the two lists describe the same signature, so positional
/// pairing is exact. An `EFn` parameter that already carries its own inline
/// type (the `[T](f: (T) -> T with e, ...)` generic-literal spelling used
/// elsewhere in this file) is left untouched; `ty` is consulted only to fill
/// gaps, never to override.
fn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  match ty {
    Some(TyFn(sig_params, _, _)) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, ptype) = Array::get(params, i)
        let effective = match ptype {
          Some(_) => ptype,
          None => if i < Array::length(sig_params) {
            Some(Array::get(sig_params, i))
          } else {
            None
          }
        }
        Array::push(out, (pname, effective))
        i = i + 1
      }
      out
    },
    _ => params
  }
}

/// Transitive effect enforcement (#626): a call to a user function `G` that
/// declares `with E` leaks E into the caller unless the caller declares E or
/// the call is under a `handle ... with E`. Combined with the DIRECT discipline
/// (every function that itself performs/invokes an effectful builtin must declare
/// it — already enforced), this propagates effect requirements up the call graph
/// level by level: every effectful leaf is annotated, so a one-level check at
/// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty
/// => transitive check disabled, preserving the direct-only behavior).
///
/// `ov_names`/`ov_effs` (#885) is the SEPARATE callback-parameter overlay
/// described above, scoped to the function body currently in view (empty at the
/// program's top level and at any call site with no enclosing function-typed
/// parameters in scope).
export fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {
  // #1485: the public entry keeps its 7-arg contract and supplies an EMPTY
  // per-parameter table, which switches call-site row unification off and
  // restores the pre-#1485 exemption. Callers of this entry are unit-test and
  // non-stmts paths that have no call-graph parameter types to offer anyway.
  set_entry_user_effect_operations(array_empty())
  check_perform_effects_expr_tx_in("", root, root_declared, root_in_handle, fn_names, fn_effs, no_param_effs(), root_ov_names, root_ov_effs, no_kind_binds())
}

/// #639: the same walk with the enclosing top-level binding's NAME threaded in
/// so row-mismatch diagnostics can blame the caller's declaration in the fix-it
/// hint. The name is constant per walk (lambdas are anonymous), so it rides as
/// a plain parameter, not on the work stack.
fn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]], root_kinds: Array[(String, String)]) -> Array[EffectError] {
  let errors = array_empty()
  let stack = Array::slice([
    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs, root_kinds)
  ], 0, 1)
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let (expr, declared, in_handle, ov_names, ov_effs, kinds) = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match expr {
      ECall(callee, args, call_off) => {
        match callee {
          EIdent(name, _) => {
            // #1723: the overlay is also the lexical-binding environment.
            // Some([]) means a pure local binding; only None may fall through
            // to the module-level function table.
            let lexical_callee = lookup_fn_effs(ov_names, ov_effs, name)
            if name == "perform?" && Array::length(args) == 1 {
              match perform_question_op_name(Array::get(args, 0)) {
                Some(op_name) => if decl_authorizes_optional_op(declared, op_name) {
                  ()
                } else {
                  Array::push(errors, EEPerformQuestionRequiresOptional(op_name, call_off))
                },
                None => ()
              }
              match Array::get(args, 0) {
                ECall(_, opargs, _) => {
                  let mut oi = 0
                  while oi < Array::length(opargs) {
                    Array::push(stack, (Array::get(opargs, oi), declared, in_handle, ov_names, ov_effs, kinds))
                    oi = oi + 1
                  }
                },
                _ => ()
              }
            } else if name == "perform" && Array::length(args) == 1 {
              match Array::get(args, 0) {
                ECall(op_callee, opargs, _) => match op_callee {
                  EIdent(op_name, _) => {
                    let eff = effect_name_of_op(op_name)
                    // ADR-0085 Phase 3 (#1344): for `throw(v)` the required
                    // label carries the payload's exception KIND
                    // (`Exception[IoError]::Throw`); every other operation
                    // keeps its own name verbatim.
                    let required_op = throw_required_label(op_name, opargs, kinds)
                    // #640 Stage 2: `Error` is exempt from the DIRECT
                    // discipline, exactly like the transitive slice below
                    // (`teff != "Error"`) and builtin_call_effect's Error
                    // carve-out — the throw row is pervasive (~970
                    // un-annotated throw sites). `throw(x)` now parses to
                    // `perform Exception::Throw(x)`, so without this exemption
                    // every one of those sites would newly require
                    // `with Exception`.
                    // Codex review (PR #1161): report the qualified
                    // operation (`op_name`, e.g. "Ask::Get"), not the
                    // stripped base effect name -- per docs/effectset.md's
                    // operation-level diagnostic contract, a fix-it should
                    // grant only the specific missing operation, not widen
                    // to the whole effect (which would over-grant when a
                    // sibling operation of the same effect is already
                    // authorized at operation granularity, e.g. `with {
                    // Ask::Other }` + a bare `perform Ask::Get`).
                    if is_program_entry_name(fn_name) && !in_handle && !entry_allows_authority() && entry_user_operation_requires_handler(op_name) && decl_authorizes_op(root_declared, op_name) {
                      Array::push(errors, EEUndischargedEntryEffect(fn_name, op_name, effect_name_of_op(op_name), call_off))
                    } else if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, required_op) {
                      Array::push(errors, make_contextual_row_error(fn_name, declared, [
                        throw_report_label(op_name, required_op, declared)
                      ], call_off))
                    } else {
                      ()
                    }
                  },
                  _ => ()
                },
                // #1157: a zero-arg operation (`Op -> T`, no parens) parses
                // its `perform` argument as a bare `EIdent`, not an `ECall`
                // — same direct-discipline check as the parenthesized form
                // above, just without an args list to look past.
                EIdent(op_name, _) => {
                  let eff = effect_name_of_op(op_name)
                  if is_program_entry_name(fn_name) && !in_handle && !entry_allows_authority() && entry_user_operation_requires_handler(op_name) && decl_authorizes_op(root_declared, op_name) {
                    Array::push(errors, EEUndischargedEntryEffect(fn_name, op_name, effect_name_of_op(op_name), call_off))
                  } else if (!is_exception_effect_name(eff) || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {
                    Array::push(errors, make_contextual_row_error(fn_name, declared, [
                      op_name
                    ], call_off))
                  } else {
                    ()
                  }
                },
                _ => ()
              }
            } else if source_definition_shadows_builtin(name, lexical_callee, fn_names, fn_effs) {
              // #2107: a source definition of this name wins, so the builtin's
              // row is not the one to require -- the callee's OWN declared row
              // is, and the transitive check below reads it. Codegen has the
              // same rule for the print builtins (`cc_ft_has(ctx.func_table,
              // fname)` in expr/compile_call.vibe, #929) and the gate pins it:
              // `fn println(s: String) -> Unit { print("S\n") }` must compile
              // and win over the builtin lowering. Without this the checker
              // would demand `with Stdout` from callers of a user function that
              // merely reuses the name.
              ()
            } else {
              match builtin_call_effect(name) {
                Some(eff) => {
                  // #1343: authorize at OPERATION granularity as well as by the
                  // bare effect. `with Fs` keeps working unchanged (the
                  // effect check is tried first and is what every existing row
                  // relies on); `with Fs::read_file` now also authorizes,
                  // giving host capabilities the minimal-permission granularity
                  // ADR-0071 defined and `perform Eff::Op` already had. Strictly
                  // a widening -- nothing that compiled before can start failing.
                  let op_label = builtin_call_op_label(name, eff)
                  if !in_handle && !decl_authorizes_effect(declared, eff) && !decl_authorizes_effect(declared, op_label) && !decl_authorizes_op(declared, op_label) {
                    // Report the OPERATION, per ADR-0071's diagnostic contract:
                    // the fix-it should grant the one operation actually needed,
                    // not widen the row to the whole effect (same rule the
                    // perform path follows since Codex review on PR #1161).
                    Array::push(errors, make_contextual_row_error(fn_name, declared, [
                      op_label
                    ], call_off))
                  } else {
                    ()
                  }
                },
                None => ()
              }
            }
            // Transitive (#626): calling a user function leaks its declared
            // effects into this context unless declared here or under a handle.
            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the
            // DIRECT discipline already excludes `Error` (the throw row is
            // pervasive — nearly every function can throw) and `Async`
            // (composition is allowed; the async pass governs it), so the
            // transitive pass mirrors that exclusion. Effect-variable rows
            // (polymorphic) impose nothing HERE — call-site resolution of what
            // a row variable is instantiated to would need real effect-row
            // unification (#885 tracks that separately); naively requiring the
            // row-variable TOKEN itself in the caller's declared row produces
            // false positives (see `generic_effect_matrix_ok_passthrough_pure`).
            let top_level_callee = match lexical_callee {
              Some(_) => None,
              None => lookup_fn_effs(fn_names, fn_effs, name)
            }
            match top_level_callee {
              Some(callee_effs) => {
                // #639: aggregate every effect this call site leaks into ONE
                // set-difference diagnostic ("missing { Env, Fs }") instead of
                // one error per label.
                let missing = no_str_labels()
                let mut ti = 0
                while ti < Array::length(callee_effs) {
                  let teff = Array::get(callee_effs, ti)
                  // #1343 (Codex P1 on PR #1359): `decl_authorizes_op`, not
                  // `decl_authorizes_effect` -- once a callee can declare an
                  // OPERATION row (`with Fs::read_file`), a caller holding
                  // the WHOLE effect (`with Fs`) must authorize it. The
                  // effect-only check compared labels literally, so the bare
                  // `Fs` failed to cover `Fs::read_file` and calling such a
                  // callee was rejected. decl_authorizes_op tries the base
                  // effect name first, then the exact operation, so both
                  // spellings of the caller's row work and nothing that
                  // authorized before stops authorizing.
                  if label_is_effect_var(teff) {
                    // #1485: a row VARIABLE used to be skipped outright. It is
                    // now resolved AT THIS CALL SITE from the arguments
                    // actually passed to the parameters that carry it, and the
                    // labels it turns out to denote are required like any
                    // other. Unresolvable instantiations still fall through to
                    // the old exemption (see resolve_row_var_instantiation).
                    let callee_param_effs = match lookup_fn_param_effs(fn_names, fn_param_effs, name) {
                      Some(pe) => pe,
                      None => no_param_row()
                    }
                    match resolve_row_var_instantiation(teff, callee_param_effs, args, fn_names, fn_effs, ov_names, ov_effs) {
                      Some(inst) => {
                        let mut ii = 0
                        while ii < Array::length(inst) {
                          let ieff = Array::get(inst, ii)
                          // Same discipline the concrete branch below applies:
                          // the exception row and `Async` are row-transparent,
                          // and a variable resolving to another variable is
                          // still unresolved.
                          if String::length(ieff) > 0 && (!is_exception_effect_name(ieff) || error_row_checked()) && ieff != "Async" && !label_is_effect_var(ieff) && !in_handle && !decl_authorizes_op(declared, ieff) {
                            Array::push(missing, ieff)
                          } else {
                            ()
                          }
                          ii = ii + 1
                        }
                      },
                      None => ()
                    }
                  } else if String::length(teff) > 0 && (!is_exception_effect_name(teff) || error_row_checked()) && teff != "Async" && !in_handle && !decl_authorizes_op(declared, teff) {
                    Array::push(missing, teff)
                  } else {
                    ()
                  }
                  ti = ti + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_contextual_row_error(fn_name, declared, missing, call_off))
                } else {
                  ()
                }
              },
              None => ()
            }
            // #885: calling a function-typed PARAMETER (a callback) directly —
            // e.g. `f(x)` inside the wrapper that declares `f: (T) -> T with
            // { e }` — leaks `f`'s declared row into this context exactly like
            // a named function call above, but UNLIKE that case a row-variable
            // label here is NOT exempted: the parameter's `with e` and the
            // enclosing function's own declared row live in the SAME
            // signature, so the token `e` denotes the identical variable in
            // both places (no cross-call-site instantiation to resolve), and
            // literal-name membership is a sound check.
            match lexical_callee {
              Some(param_effs) => {
                // #639: aggregated exactly like the named-callee case above.
                let missing = no_str_labels()
                let mut pi = 0
                while pi < Array::length(param_effs) {
                  let peff = Array::get(param_effs, pi)
                  // #1343: same operation-awareness as the named-callee case
                  // above -- a callback parameter whose row names an operation
                  // is covered by a caller holding the whole effect.
                  if String::length(peff) > 0 && (!is_exception_effect_name(peff) || error_row_checked()) && peff != "Async" && !in_handle && !decl_authorizes_op(declared, peff) {
                    Array::push(missing, peff)
                  } else {
                    ()
                  }
                  pi = pi + 1
                }
                if Array::length(missing) > 0 {
                  Array::push(errors, make_contextual_row_error(fn_name, declared, missing, call_off))
                } else {
                  ()
                }
              },
              None => ()
            }
          },
          _ => ()
        }
        match callee {
          EIdent(cname, _) => if cname == "perform?" {
            ()
          } else {
            Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs, kinds))
            let mut ai = 0
            while ai < Array::length(args) {
              Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs, kinds))
              ai = ai + 1
            }
          },
          _ => {
            Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs, kinds))
            let mut bi = 0
            while bi < Array::length(args) {
              Array::push(stack, (Array::get(args, bi), declared, in_handle, ov_names, ov_effs, kinds))
              bi = bi + 1
            }
          }
        }
      },
      EFn(_, _, params, _, effect, body) => {
        // #761: an EXPLICITLY-annotated lambda (`(x) -> { .. } with E`) is
        // checked against its own row E. An UN-annotated lambda's effect row is
        // INFERRED, not declared, so checking its body against an empty row is
        // wrong — it wrongly rejected an inline effectful lambda passed to a HOF
        // param whose type declares the effect (bidirectional effect checking,
        // e.g. `call_twice((c) -> { write_char(c) })`). Inherit the enclosing
        // declared context instead: the lambda may use any effect available
        // where it is written (its inferred row is surfaced in its type and
        // re-checked at the call/handle site). Conservative — like the
        // mutability pass, this can only miss errors, never invent them.
        // #1451: a closure LITERAL also inherits the rows the enclosing binding's
        // RETURN type declares for the function values it produces (see
        // ret_fn_row_labels). Without this, `fn make() -> (String) -> Unit with E
        // { (s) -> { perform E::Op(s) } }` charged the perform to `make`, whose
        // own row is (correctly) empty -- the row belongs to the RETURNED value.
        // Only literals get it; the enclosing body's own direct performs do not.
        let body_declared = effect_row_inherit(effect_row_parse(effect), labels_union(declared, current_ret_fn_rows()))
        // #885: extend the callback-parameter overlay with THIS function's own
        // function-typed parameters (if any carry a declared effect), scoped to
        // its body. New entries are appended AHEAD of the inherited overlay so
        // `lookup_fn_effs` (first-match) has a same-named inner parameter
        // shadow an outer one.
        //
        // #885 review (Codex): shadowing must apply to EVERY one of this
        // lambda's own parameter names, not just the ones that end up in
        // local_names/local_effs (function-typed with a declared effect) --
        // a parameter reusing an outer callback's name with a DIFFERENT type
        // (e.g. plain `Int`, or a function type with no declared effect) must
        // still block the inherited entry, or a call to the new, unrelated
        // parameter is wrongly checked against the shadowed outer callback's
        // effect row.
        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)
        let (shadowed_ov_names, shadowed_ov_effs) = shadowed
        let (local_names, local_effs) = build_param_overlay(params, fn_names)
        let body_ov_names = if Array::length(local_names) == 0 {
          shadowed_ov_names
        } else {
          let merged = Array::slice(local_names, 0, Array::length(local_names))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_names) {
            Array::push(merged, Array::get(shadowed_ov_names, oi))
            oi = oi + 1
          }
          merged
        }
        let body_ov_effs = if Array::length(local_effs) == 0 {
          shadowed_ov_effs
        } else {
          let merged = Array::slice(local_effs, 0, Array::length(local_effs))
          let mut oi = 0
          while oi < Array::length(shadowed_ov_effs) {
            Array::push(merged, Array::get(shadowed_ov_effs, oi))
            oi = oi + 1
          }
          merged
        }
        // #1344 follow-up: a lambda's parameters enter the payload-kind scope
        // from their annotations, exactly like a top-level function's.
        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs, throw_kind_bind_params(kinds, params)))
      },
      EHandle(body, arms) => {
        if Array::length(arms) == 0 {
          Array::push(errors, EEEmptyHandle)
        } else {
          ()
        }
        let discharged = collect_handle_effects(arms)
        let body_declared = labels_union(declared, discharged)
        // Unknown wildcard arms stay conservative for the legacy surface,
        // but a structurally empty handler must not gain that permission.
        // Known discharge stays out of `in_handle`: that flag also skips the
        // undeclared-effect check, so treating `handle Ask` as "inside a
        // handle" lets `Logger` leak through (#626 criterion 2). Discharge
        // of the named effect is already in `body_declared`.
        let body_in_handle = if Array::length(arms) > 0 && Array::length(discharged) == 0 {
          true
        } else {
          in_handle
        }
        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs, kinds))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (arm_pat, arm_body) = Array::get(arms, ai)
          let (arm_ov_names, arm_ov_effs) = overlay_bind_empty_pat(ov_names, ov_effs, arm_pat, fn_names)
          Array::push(stack, (arm_body, declared, in_handle, arm_ov_names, arm_ov_effs, throw_kind_bind_pat(kinds, arm_pat)))
          ai = ai + 1
        }
      },
      ELet(name, val, body, _) => {
        // #885 review (Codex): `val` is evaluated in the OUTER scope (ELet is
        // non-recursive), so only the body's overlay needs the new binding
        // shadowed out. #1361: the same place registers a local closure's own
        // declared row, so calling it from the body leaks that row.
        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
        // #1344 follow-up: the local's payload kind is its initializer's, read
        // in the OUTER scope for the same non-recursive reason.
        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      ELetRec(name, val, body) => {
        // #885 review (Codex): unlike ELet, `let rec` allows `val` itself to
        // reference `name` (self-recursion), so both val and body need the
        // shadow applied -- and, since #1361, the local closure's own row, so a
        // recursive effectful closure is checked against it on both sides.
        let (rec_ov_names, rec_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
        // A `let rec` value is a function; there is no payload kind to read off
        // it, so the name binds unresolvable on both sides (which is also what
        // stops it resolving through a same-named top-level binding).
        let rec_kinds = throw_kind_bind(kinds, name, "")
        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))
        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs, rec_kinds))
      },
      ELetMut(name, val, body, _) => {
        // #885 review (Codex): same as ELet -- non-recursive, only body shadows.
        let (body_ov_names, body_ov_effs) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
        // A `mut` binding keeps one type for its whole life (an assignment of a
        // different type is a type error), so its initializer's kind holds for
        // the body just as ELet's does.
        let body_kinds = throw_kind_bind(kinds, name, throw_payload_kind(val, kinds))
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      ESeq(a, b) => {
        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EIf(cond, then_e, else_e) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EMatch(scrutinee, arms) => {
        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs, kinds))
        let mut ai = 0
        while ai < Array::length(arms) {
          let (arm_pat, arm_body) = Array::get(arms, ai)
          let (arm_ov_names, arm_ov_effs) = overlay_bind_empty_pat(ov_names, ov_effs, arm_pat, fn_names)
          Array::push(stack, (arm_body, declared, in_handle, arm_ov_names, arm_ov_effs, throw_kind_bind_pat(kinds, arm_pat)))
          ai = ai + 1
        }
      },
      EWhile(cond, body) => {
        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs, kinds))
      },
      ELoop(params, body) => {
        // A loop parameter is re-bound by every `continue`, so its initializer's
        // kind does not describe it for the whole body: it binds unresolvable.
        let mut body_kinds = kinds
        let loop_names = array_empty()
        let mut i = 0
        while i < Array::length(params) {
          let (pname, init) = Array::get(params, i)
          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs, kinds))
          body_kinds = throw_kind_bind(body_kinds, pname, "")
          Array::push(loop_names, pname)
          i = i + 1
        }
        let (body_ov_names, body_ov_effs) = overlay_bind_empty_names(ov_names, ov_effs, loop_names, fn_names)
        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs, body_kinds))
      },
      EForIn(value_name, index_name, iter, body) => {
        // The element (and optional index) binder has no syntactic kind here --
        // it comes from the iterand's element type, which this untyped pass
        // cannot see. Binding them unresolvable is what stops a same-named
        // top-level binding answering for a loop variable.
        let for_kinds = match index_name {
          Some(iname) => throw_kind_bind(throw_kind_bind(kinds, value_name, ""), iname, ""),
          None => throw_kind_bind(kinds, value_name, "")
        }
        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs, kinds))
        let (value_ov_names, value_ov_effs) = overlay_bind_empty(ov_names, ov_effs, value_name, fn_names)
        let for_overlay = match index_name {
          Some(iname) => overlay_bind_empty(value_ov_names, value_ov_effs, iname, fn_names),
          None => (value_ov_names, value_ov_effs)
        }
        Array::push(stack, (body, declared, in_handle, for_overlay.0, for_overlay.1, for_kinds))
      },
      EBinOp(_, left, right) => {
        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs, kinds)),
      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs, kinds)),
      EAssign(_, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EAssignOp(_, _, val, cont) => {
        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs, kinds))
        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs, kinds))
      },
      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs, kinds)),
      ETuple(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))
          ei = ei + 1
        }
      },
      EArray(elems) => {
        let mut ei = 0
        while ei < Array::length(elems) {
          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs, kinds))
          ei = ei + 1
        }
      },
      ERecord(rec_sname, fields, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fval) = Array::get(fields, fi)
          // #1451: a closure LITERAL stored into a field whose declared type
          // carries a row may use that row -- the row belongs to the stored
          // VALUE, not to the function assembling the record. Widened for the
          // literal only: any OTHER field expression (a call that performs, say)
          // keeps the enclosing `declared` and stays checked as before.
          let field_declared = match fval {
            EFn(_, _, _, _, _, _) => labels_union(declared, struct_field_rows_for(rec_sname, fname)),
            _ => declared
          }
          Array::push(stack, (fval, field_declared, in_handle, ov_names, ov_effs, kinds))
          fi = fi + 1
        }
      },
      EMap(fields) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fval) = Array::get(fields, fi)
          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs, kinds))
          fi = fi + 1
        }
      },
      ELabeledArg(_, _, value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      ESpread(value) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      EBreak(Some(value)) => Array::push(stack, (value, declared, in_handle, ov_names, ov_effs, kinds)),
      EBreak(None) => (),
      EContinue(args) => {
        let mut ai = 0
        while ai < Array::length(args) {
          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs, kinds))
          ai = ai + 1
        }
      },
      // Scoped forms are handled above; any future non-scoped structural
      // expression inherits this frame unchanged.
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) {
          Array::push(stack, (Array::get(children, i), declared, in_handle, ov_names, ov_effs, kinds))
          i = i + 1
        }
      }
    }
  }
  errors
}

fn effect_row_allows_labels(eff: Option[String]) -> Array[String] {
  match eff {
    None => no_str_labels(),
    Some(s) => {
      let allows = effect_row_allows_text(s)
      if String::length(allows) == 0 {
        no_str_labels()
      } else {
        effect_row_labels(effect_row_parse(Some(allows)))
      }
    }
  }
}

fn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, _, eff)) => labels_union(effect_row_labels(effect_row_parse(eff)), effect_row_allows_labels(eff)),
    _ => effect_row_labels(effect_row_parse(None))
  }
}

/// #1451: rows declared by FUNCTION TYPES sitting inside a signature's RETURN
/// type. `fn make() -> (String) -> Unit with Log::Emit { (s) -> { perform .. } }`
/// declares that the returned VALUE may perform `Log::Emit`; `make` itself does
/// not, and `sig_type_effect_labels` correctly reports `make`'s own row as empty.
///
/// A closure LITERAL never carries a row of its own (rows are not written at a
/// literal — the pass infers them), so the returned literal's perform was charged
/// to the enclosing function, and the only way to satisfy the checker was to
/// declare a row on `make` that `make` does not have. Collected recursively, so a
/// row nested under `Array[_]` / a tuple / `Option[_]` is found too.
///
/// This set is granted ONLY to nested closure literals (see the walker's `EFn`
/// arm), never to the enclosing body's own statements — a direct
/// `perform Log::Emit(..)` in `make`'s body stays flagged, because that one really
/// does run in `make` with no handler.
fn ret_fn_row_labels_into(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyFn(params, ret, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      let mut li = 0
      while li < Array::length(labels) {
        Array::push(out, Array::get(labels, li))
        li = li + 1
      }
      let mut i = 0
      while i < Array::length(params) {
        ret_fn_row_labels_into(Array::get(params, i), out)
        i = i + 1
      }
      ret_fn_row_labels_into(ret, out)
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        ret_fn_row_labels_into(Array::get(args, i), out)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        ret_fn_row_labels_into(Array::get(elems, i), out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn ret_fn_row_labels(ret: Option[TypeExpr]) -> Array[String] {
  let out = array_empty()
  match ret {
    Some(te) => ret_fn_row_labels_into(te, out),
    None => ()
  }
  out
}

/// Same, from a BINDING annotation (`let make: () -> ((String) -> Unit with E) = ...`)
/// rather than the `fn`'s own arrow. Descends only into the RETURN slot: a
/// PARAMETER's function row is already handled by the callback-parameter overlay
/// (#885), and granting it here would widen the body's permission for no reason.
fn ret_fn_rows_from_sig(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, ret, _)) => {
      let out = array_empty()
      ret_fn_row_labels_into(ret, out)
      out
    },
    _ => array_empty()
  }
}

/// Module-level cell for the current binding's return-type rows, in the same
/// style as `error_row_mode_cell` above: the walker is a flat stack loop with a
/// fixed tuple shape and eight call sites, so threading a ninth parameter through
/// it to reach one arm costs more than it buys. Set per binding by
/// `check_perform_effects_binding_tx`, read by the walker's `EFn` arm. Walks are
/// sequential (one binding at a time), so no save/restore stack is needed.
let ret_fn_rows_cell = array_empty()

fn set_ret_fn_rows(rows: Array[String]) -> Unit {
  Array::truncate(ret_fn_rows_cell, 0)
  Array::push(ret_fn_rows_cell, rows)
}

fn current_ret_fn_rows() -> Array[String] {
  if Array::length(ret_fn_rows_cell) > 0 {
    Array::get(ret_fn_rows_cell, 0)
  } else {
    array_empty()
  }
}

// #1961: when an entry row has `allows`, `check_entry_declared_effects`
// already owns unhandled ⊆ authorized (handlers subtracted). The perform
// walk must not also emit EEUndischargedEntryEffect for those ops — that
// check cannot see lexical discharge without setting `in_handle`, which
// would reopen #626 criterion 2.
let entry_allows_authority_cell = array_empty()

fn set_entry_allows_authority(on: Bool) -> Unit {
  Array::truncate(entry_allows_authority_cell, 0)
  Array::push(entry_allows_authority_cell, if on {
    1
  } else {
    0
  })
}

fn entry_allows_authority() -> Bool {
  Array::length(entry_allows_authority_cell) > 0 && Array::get(entry_allows_authority_cell, 0) == 1
}

/// #1451 (struct-field position): rows declared by a STRUCT FIELD's type, keyed
/// `Struct::field`. Same defect as the return position and the same cause -- a
/// closure literal stored into
/// `struct Box { run: (String) -> Unit with Log::Emit }` carries no row of its
/// own, so its perform was charged to the function BUILDING the record, which
/// only assembles a closure and never performs it.
///
/// The walker is a flat stack loop with no access to the program's type
/// declarations, so the table is built once per program (from every `SStruct`)
/// and read by the `ERecord` arm -- the same module-cell shape as
/// `ret_fn_rows_cell` above, for the same reason. Only fields whose type
/// actually declares a row get an entry, so the common program adds nothing.
let struct_field_rows_cell = array_empty()

fn struct_field_key(sname: String, fname: String) -> String {
  String::concat(sname, String::concat("::", fname))
}

fn build_struct_field_rows(stmts: Array[Stmt]) -> Unit {
  let keys = array_empty()
  let rows = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fty) = Array::get(fields, fi)
          let out = array_empty()
          ret_fn_row_labels_into(fty, out)
          if Array::length(out) > 0 {
            Array::push(keys, struct_field_key(sname, fname))
            Array::push(rows, out)
          } else {
            ()
          }
          fi = fi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  Array::truncate(struct_field_rows_cell, 0)
  Array::push(struct_field_rows_cell, (keys, rows))
}

fn struct_field_rows_for(sname: String, fname: String) -> Array[String] {
  if Array::length(struct_field_rows_cell) == 0 || String::length(sname) == 0 {
    array_empty()
  } else {
    let (keys, rows) = Array::get(struct_field_rows_cell, 0)
    let want = struct_field_key(sname, fname)
    let mut found = array_empty()
    let mut i = 0
    while i < Array::length(keys) {
      if Array::get(keys, i) == want {
        found = Array::get(rows, i)
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

fn no_str_labels() -> Array[String] {
  array_empty()
}

fn no_ov_effs() -> Array[Array[String]] {
  array_empty()
}

/// Public 3-arg entry: the direct-only check (no call-graph map), preserving the
/// pre-transitive behavior for unit tests and any non-stmts caller.
export fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {
  // Same clearing rule as check_perform_effects_stmt (#1344): no env here, so
  // no payload kinds are resolvable and none must be carried over.
  set_throw_kind_table(EnvEmpty)
  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())
}

/// #2107: the ambient test grant, for a `test` / `bench` body that has already
/// been lowered to a function.
///
/// The wasm-gc lane rewrites `test "x" { .. }` into `let __test_x = () -> { .. }`
/// BEFORE the check (entry/source_compile/gc_only) -- it has to, because a
/// `handle` inside a test block is only eligible for the ADR-0076 direct-perform
/// lowering once the block is a named top-level fn. The STest / SBench arms in
/// check_perform_effects_stmt_tx therefore never see those bodies, and without
/// this the identical source checks differently on the two lanes: on gc every
/// assertion in a test wanted `with Stdout` from a function with no row to
/// declare.
///
/// Keyed on the name because the alternative -- writing the row onto the
/// synthesized function -- changes what CODEGEN reads, and the eligibility pass
/// above reads exactly that. The two prefixes are compiler-synthesized and
/// reserved; `cli_support.vibe`, `codegen/wasi/linked_compile.vibe` and
/// `codegen/gc/backend_body.vibe` already key off them the same way. The test's
/// own `with` row (#1508) is looked up under its original name, so
/// `test "x" with Http` keeps widening the grant after lowering.
fn lowered_test_ambient_effects(fn_name: String) -> Array[String] {
  let n = String::length(fn_name)
  if String::starts_with(fn_name, "__test_") {
    test_ambient_effects(String::substring(fn_name, 7, n))
  } else if String::starts_with(fn_name, "__bench_") {
    test_ambient_effects(String::substring(fn_name, 8, n))
  } else {
    no_str_labels()
  }
}

fn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Array[EffectError] {
  let sig_labels = sig_type_effect_labels(ty)
  set_entry_allows_authority(is_program_entry_name(fn_name) && String::length(effect_row_allows_text(raw_fn_effect_string(ty, body))) > 0)
  match body {
    // #885: build the callback-parameter overlay for THIS binding's own
    // function value from its (possibly untyped, see merge_param_types_with_sig)
    // parameters, so a direct call to one of them inside the body is checked
    // from the very first stack frame — not just once the walk happens to
    // redescend through a nested `EFn` node.
    EFn(_, _, params, fret, eff, fbody) => {
      // #1451: this binding's declared RETURN type may declare rows for the
      // function VALUES it produces. Publish them for nested closure literals
      // (see ret_fn_row_labels' doc comment); the body's own declared set below
      // is deliberately NOT widened by them.
      set_ret_fn_rows(labels_union(ret_fn_rows_from_sig(ty), ret_fn_row_labels(fret)))
      // #1344 follow-up: the same merged parameter list seeds the payload-kind
      // scope, so `fn f(e: IoError) { throw(e) }` resolves from the very first
      // frame -- the walk never re-descends through this EFn to pick the
      // parameters up on its own.
      let merged_params = merge_param_types_with_sig(ty, params)
      let (ov_names, ov_effs) = build_param_overlay(merged_params, fn_names)
      check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(lowered_test_ambient_effects(fn_name), labels_union(sig_labels, labels_union(effect_row_labels(effect_row_parse(eff)), effect_row_allows_labels(eff)))), false, fn_names, fn_effs, fn_param_effs, ov_names, ov_effs, throw_kind_bind_params(no_kind_binds(), merged_params))
    },
    _ => {
      // #1451: a non-EFn binding declares no arrow of its own; clear the cell so
      // the PREVIOUS binding's return-type rows cannot leak into this walk.
      set_ret_fn_rows(ret_fn_rows_from_sig(ty))
      check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds())
    }
  }
}

/// #761: a `test {}` / `bench {}` block is a program entry point — it runs under
/// the runtime host, which is the ambient handler for the HOST resource effects
/// (Fs/Env/Stdin/Stdout/Process/Profiler). So a test may invoke a host-effectful
/// function (directly, transitively, or as an unqualified builtin) without a
/// `handle`, exactly as `main` does. This grant was already de-facto true for
/// IMPORTED effectful functions (they are absent from the transitive fn_effs map,
/// so calling them never flagged), but LOCALLY-defined ones (in fn_effs) and
/// direct builtin/perform host effects were wrongly rejected — an asymmetry.
/// Seeding the test/bench declared row with the host set removes it. NON-host
/// (user-defined) effects still require a handler: performing one at runtime with
/// no host handler would trap, so leaving it flagged is correct. Purity/caching
/// is judged separately by file_tests_cacheable (empty declared row), so a test
/// that reaches a host effect still correctly counts as impure/non-cacheable.
/// #944 (ADR-0073 implementation bridge): checked-Error mode. The accepted
/// owner decision makes `Exception::Throw` a fully checked semantic operation
/// (direct throw and `with Exception` callees propagate to the caller's
/// row; discharge via `handle ... with Exception`). Stage A landed this
/// opt-in (`VIBE_CHECK_ERROR_ROW=1`, default off, preserving the old
/// exemption byte-for-byte) while the tree still carried hundreds of
/// row-less throw sites (#640 measured ~970); stage B annotated those and
/// flipped the DEFAULT to checked, leaving `VIBE_CHECK_ERROR_ROW=0` as a
/// temporary opt-OUT escape hatch (wired in cli_adapter.vibe) for any
/// downstream code that hasn't annotated yet. The switch rides in a
/// module-level memo cell (fixtures/module_let_memo_test.vibe pattern)
/// because the effect discipline has no configuration threading and the
/// checker itself is pure (no Env row).
///
/// Scope note: builtin_call_effect's own Error carve-out (a BUILTIN whose
/// declared row is Error) is deliberately NOT flipped by this switch --
/// which builtins should carry a semantic Error row is a separate
/// sub-decision tracked on #944.
let error_row_mode_cell = array_empty()

export fn set_error_row_checked(on: Bool) -> Unit {
  Array::truncate(error_row_mode_cell, 0)
  Array::push(error_row_mode_cell, if on {
    1
  } else {
    0
  })
}

fn error_row_checked() -> Bool {
  Array::length(error_row_mode_cell) > 0 && Array::get(error_row_mode_cell, 0) == 1
}

/// Canonical cache identity for the actual process-wide checker mode. Direct
/// callers that do not configure the cell are unchecked, matching
/// error_row_checked(); CLI callers set the cell explicitly every invocation.
export fn typing_semantics_seed() -> String {
  if error_row_checked() {
    "checked"
  } else {
    "unchecked"
  }
}

// Test/bench default rows are derived from core/standard_effect_policy.vibe
// (`test_bench_default_effects`) rather than a local literal. Each item's
// existing operation-granularity evidence is retained in the policy table.
// 根拠 (Fs/Env の使用 operation 分布、Stdin の推移的要求、Process に退避先の
// 綴りが無いこと) も表側のコメントへ移した。

/// #1508: `(test name, row text)` from the parse's `STestEffectRows` marker.
/// A module cell for the same reason the marker exists at all: the row has to
/// reach the two `STest` / `SBench` arms below without widening either node.
let test_effect_row_tbl: Array[(String, String)] = array_empty()

///|
fn test_row_has_label(labels: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    if Array::get(labels, i) == target {
      found = true
      i = Array::length(labels)
    } else {
      i = i + 1
    }
  }
  found
}

///|
fn set_test_effect_rows(stmts: Array[Stmt]) -> Unit {
  Array::truncate(test_effect_row_tbl, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STestEffectRows(rows) => {
        let mut ri = 0
        while ri < Array::length(rows) {
          Array::push(test_effect_row_tbl, Array::get(rows, ri))
          ri = ri + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// The ambient row a `test` / `bench` body is checked against: the policy
/// default (`core/standard_effect_policy.vibe`) plus whatever the declaration's
/// own `with` clause added.
///
/// A declared row WIDENS rather than replaces. `Exception` and the Stdout/Fs
/// family are what `assert` and ordinary test scaffolding need, and making
/// `with Http` silently drop them would mean every such test had to restate the
/// whole default -- which `docs/spec/test-example-capabilities.md` asks for in
/// its "row は完全に明示する" note, but that reads as a rule for a future
/// `with ()` form; taking it now would break every existing test that adds a
/// row. Recorded on #1508.
fn test_ambient_effects(name: String) -> Array[String] {
  let base = test_bench_default_effects()
  let mut i = 0
  while i < Array::length(test_effect_row_tbl) {
    let (n, row) = Array::get(test_effect_row_tbl, i)
    if n == name {
      let extra = effect_row_labels(effect_row_parse(Some(row)))
      let mut ei = 0
      while ei < Array::length(extra) {
        let label = Array::get(extra, ei)
        if test_row_has_label(base, label) {
          ()
        } else {
          Array::push(base, label)
        }
        ei = ei + 1
      }
      i = Array::length(test_effect_row_tbl)
    } else {
      i = i + 1
    }
  }
  base
}

fn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Array[EffectError] {
  match stmt {
    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs, fn_param_effs),
    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs, fn_param_effs),
    STest(tname, body) => check_perform_effects_expr_tx_in("", body, test_ambient_effects(tname), false, fn_names, fn_effs, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds()),
    SBench(bname, body) => check_perform_effects_expr_tx_in("", body, test_ambient_effects(bname), false, fn_names, fn_effs, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds()),
    SExpr(e) => check_perform_effects_expr_tx_in("", e, effect_row_labels(effect_row_parse(None)), false, fn_names, fn_effs, fn_param_effs, no_str_labels(), no_ov_effs(), no_kind_binds())
    _ => array_empty()
  }
}

/// Public 1-arg entry: direct-only (empty map). Kept for unit tests.
export fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {
  // No env to resolve payload kinds from: clear the table rather than let a
  // previous module's bindings decide this one's throw kinds (#1344).
  set_throw_kind_table(EnvEmpty)
  set_entry_user_effect_operations(Array::slice([stmt], 0, 1))
  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs(), no_param_effs())
}

/// #812: seed the transitive call-graph map with the checker ENV's bindings.
/// fn_names/fn_effs was built from the CURRENT module's top-level statements
/// only, so a caller could invoke an IMPORTED `with Fs` function without
/// declaring Fs and reach the filesystem at runtime — while the identical
/// shape with a local callee was rejected. An imported binding's CtFn carries
/// its declared effect row in the env; add every effect-bearing env binding
/// AFTER the local rows (lookup_fn_effs is first-match, so a same-name local
/// row still shadows the env row). Effect-free bindings are skipped — an
/// absent row and an empty row enforce the same (nothing).
fn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Unit {
  let fnty = match ty {
    CtForAll(_, _, body) => body,
    _ => ty
  }
  match fnty {
    CtFn(_, _, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      if Array::length(labels) > 0 {
        Array::push(fn_names, name)
        Array::push(fn_effs, labels)
        // #1485: an env-seeded (imported) binding carries a checked `Type`, not
        // the `TypeExpr` the per-parameter table is built from, so it gets an
        // empty entry and keeps the exemption. Pushing SOMETHING is required --
        // the three arrays are index-aligned, and a skipped push would shift
        // every later callee's parameter list onto the wrong name.
        Array::push(fn_param_effs, no_param_row())
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Unit {
  let mut cur = env
  let mut looping = true
  while looping {
    match cur {
      EnvBind(name, binding, rest) => {
        push_env_fn_eff(name, binding.ty, fn_names, fn_effs, fn_param_effs)
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(entries) => {
        let mut ei = 0
        while ei < Array::length(entries) {
          let (ename, binding) = Array::get(entries, ei)
          push_env_fn_eff(ename, binding.ty, fn_names, fn_effs, fn_param_effs)
          ei = ei + 1
        }
        looping = false
      },
      EnvEmpty => {
        looping = false
      }
    }
  }
}

fn build_perform_fn_effs(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]], fn_param_effs: Array[Array[Array[String]]]) -> Unit {
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
        Array::push(fn_param_effs, fn_binding_param_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
        Array::push(fn_param_effs, fn_binding_param_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
}

export fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  check_perform_effects_stmts_env(stmts, EnvEmpty)
}

export fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  // Build the call-graph effect map (parallel arrays) from every top-level
  // binding's declared row — locals first, then the env's (imported)
  // bindings (#812) — then run the per-stmt check WITH transitive
  // enforcement so a caller must declare (or handle) the effects of the
  // functions it invokes.
  let fn_names = array_empty()
  let fn_effs = array_empty()
  // #1485: the third parallel array is per-PARAMETER rows, used to resolve what
  // a callee's row VARIABLE binds to at each call site. It stays index-aligned
  // with the first two; entries seeded from the env get an empty list, which
  // reads as "no parameter types available here" and leaves those callees on
  // the pre-#1485 exemption.
  let fn_param_effs = no_param_effs()
  build_perform_fn_effs(stmts, fn_names, fn_effs, fn_param_effs)
  seed_env_fn_effs(env, fn_names, fn_effs, fn_param_effs)
  // #1451: struct FIELD rows, for closure literals stored into a field whose
  // declared type carries one (see build_struct_field_rows).
  build_struct_field_rows(stmts)
  // #1508: per-test declared effect rows, from the parse's STestEffectRows
  // marker (see test_ambient_effects).
  set_test_effect_rows(stmts)
  // ADR-0085 Phase 3 (#1344): rebuild the `throw` payload-kind table from the
  // same checked env, so a typed `Exception[K]` row can be compared against
  // what each throw site actually throws.
  set_throw_kind_table(env)
  set_entry_user_effect_operations(stmts)
  let errors = user_provider_collision_errors(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, name, ty, body) => append_eff_errs(errors, check_entry_declared_effects(name, ty, body)),
      SLetMut(name, ty, body) => append_eff_errs(errors, check_entry_declared_effects(name, ty, body)),
      _ => ()
    }
    append_eff_errs(errors, check_perform_effects_stmt_tx(stmt, fn_names, fn_effs, fn_param_effs))
    i = i + 1
  }
  // #1347: only once the rows themselves check out — on a program with real
  // row errors every reachability answer is suspect, and a second diagnostic
  // per handle would bury the first.
  if Array::length(errors) == 0 {
    append_eff_errs(errors, check_dead_handles_stmts(stmts, fn_names, fn_effs))
  } else {
    ()
  }
  errors
}

//# #1347: a `handle` that can never fire (the handler-switch footgun)
//
// A continuation captured by handler H carries H with it: the suspend
// lowering bakes H's driver into the closure it hands to the arm
// (`resume = (rv) -> .. __scps_driveN(k(rv))`, inline_direct_perform.vibe),
// so invoking that stored continuation later re-enters H no matter what
// handles enclose the invocation. Wrapping the call in a NEW
// `handle .. with E { .. }` therefore switches nothing — the new arms are
// simply dead. That is the semantics (first-class continuations are
// handler-carrying); the defect #1347 reports is that it was SILENT.
//
// The suspend lowering already rejects the same shape when the WRAPPING
// handle is itself suspend-class ("the handle body calls something this
// suspend lowering cannot see through"). Only the tail-resumptive spelling
// slipped through, so this restores the symmetry — measured on the two
// spellings of one program, which differed solely in the wrapping arm.
//
// Flagged iff all three hold:
//   1. the program performs E somewhere (so E is live, not a label pun);
//   2. this handle's body cannot STATICALLY reach any perform of E;
//   3. this handle's body calls an OPAQUE value — a plain lowercase local
//      that is not a top-level binding or a builtin, i.e. exactly the
//      `k(())` of a stored continuation.
//
// All three are load-bearing against real in-tree sites. Without (1),
// `entry.vibe`'s `Profiler` handle (which wraps the whole CLI dispatch —
// an opaque call) and `cache_underlying.vibe`'s module-private `effect Env`
// label pun are flagged: nothing performs those labels, and today's
// vacuous-handle elimination erases them deliberately. Without (3),
// `http_e2e_test`'s client-only `Http` handle is flagged: `Http` IS
// performed by the server wrappers elsewhere, but that body reaches only
// direct host calls, which resolve. (2) is what spares the legitimate
// coroutine handle, whose body performs the effect directly.
//
// Every uncertainty resolves toward NOT flagging: an unresolved callee, a
// row variable, a nested handle, or a row-carrying closure literal all
// count as "may reach", so this pass rejects only handles it can prove
// dead.

fn dh_effect_of_perform_arg(arg: Expr) -> String {
  match arg {
    ECall(EIdent(op_name, _), _, _) => effect_name_of_op(op_name),
    EIdent(op_name, _) => effect_name_of_op(op_name),
    _ => ""
  }
}

/// The effect of `expr` if it is a `perform` call, else "".
fn dh_perform_effect(expr: Expr) -> String {
  match expr {
    ECall(EIdent(name, _), args, _) => if name == "perform" && Array::length(args) == 1 {
      dh_effect_of_perform_arg(Array::get(args, 0))
    } else {
      ""
    },
    _ => ""
  }
}

fn dh_collect_performed_into(expr: Expr, acc: Array[String]) -> Unit {
  let eff = dh_perform_effect(expr)
  if String::length(eff) > 0 && !effect_row_has_label(Some(acc), eff) {
    Array::push(acc, eff)
  } else {
    ()
  }
  let children = expr_children(expr)
  let mut i = 0
  while i < Array::length(children) {
    dh_collect_performed_into(Array::get(children, i), acc)
    i = i + 1
  }
}

/// Every effect the program performs, anywhere. Collected once (rather than
/// re-scanning per handle site) because a large program has many handles.
fn dh_collect_performed_effects(stmts: Array[Stmt]) -> Array[String] {
  let acc = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => dh_collect_performed_into(body, acc),
      SLetMut(_, _, body) => dh_collect_performed_into(body, acc),
      SExpr(e) => dh_collect_performed_into(e, acc),
      STest(_, body) => dh_collect_performed_into(body, acc),
      SBench(_, body) => dh_collect_performed_into(body, acc),
      _ => ()
    }
    i = i + 1
  }
  acc
}

fn dh_declared_effects(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, _) => if effect_row_has_label(Some(out), name) {
        ()
      } else {
        Array::push(out, name)
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// True when any label in `labels` could denote `ename` — base-name match, or
/// a row VARIABLE (which may be instantiated to anything, so it counts).
fn dh_labels_may_be(labels: Array[String], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if label_is_effect_var(l) || row_label_base(effect_name_of_op(l)) == ename {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does this type annotation mention a function row carrying `ename`? An
/// ANNOTATED local binding (`let apply: (String) -> String with Transform
/// = (s) -> { .. }`) is desugared to an ascription call before this walk runs
/// (`((__asc: T) -> __asc)(e)`, ascribe_wrap), so its row survives only in the
/// ascription lambda's PARAMETER annotation -- see fixtures/effect_crossfn_test
/// .vibe, where the handled body's only callee is such a binding.
fn dh_texpr_may_be(t: TypeExpr, ename: String) -> Bool {
  match t {
    TyFn(ps, ret, eff) => if dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) {
      true
    } else {
      dh_texprs_may_be(ps, ename) || dh_texpr_may_be(ret, ename)
    },
    TyApp(_, args) => dh_texprs_may_be(args, ename),
    TyTuple(elems) => dh_texprs_may_be(elems, ename),
    _ => false
  }
}

fn dh_texprs_may_be(ts: Array[TypeExpr], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) && !found {
    found = dh_texpr_may_be(Array::get(ts, i), ename)
    i = i + 1
  }
  found
}

fn dh_params_may_be(params: Array[(String, Option[TypeExpr])], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) && !found {
    let (_, pty) = Array::get(params, i)
    found = match pty {
      Some(t) => dh_texpr_may_be(t, ename),
      None => false
    }
    i = i + 1
  }
  found
}

/// Can this expression statically reach a `perform` of `ename`? Conservative
/// in the "yes" direction: anything unresolved answers true, so a false here
/// really does mean the handler is dead.
fn dh_may_reach(expr: Expr, ename: String, fn_names: Array[String], fn_effs: Array[Array[String]], ov_names: Array[String], ov_effs: Array[Array[String]]) -> Bool {
  if dh_perform_effect(expr) == ename {
    true
  } else {
    let direct = match expr {
      // A callee whose declared row carries the effect (or a row variable
      // that could be instantiated to it). Both tables are consulted: named
      // top-level bindings, and the #885/#1361 overlay of function-typed
      // PARAMETERS and row-declaring local closures in scope. The overlay is
      // what spares `TaskGroup::spawn_suspend`, whose handled body's only
      // callee is its own `f: () -> T with Async + Exception` parameter.
      ECall(EIdent(nm, _), _, _) => match lookup_fn_effs(fn_names, fn_effs, nm) {
        Some(effs) => dh_labels_may_be(effs, ename),
        None => match lookup_fn_effs(ov_names, ov_effs, nm) {
          Some(effs) => dh_labels_may_be(effs, ename),
          None => false
        }
      },
      // A closure LITERAL whose row carries the effect: it may be invoked
      // from anywhere inside this body, including through a value this walk
      // cannot follow. Its PARAMETER annotations count too -- that is where
      // an ascription-wrapped annotated local keeps its row.
      EFn(_, _, params, ret, eff, _) => dh_labels_may_be(effect_row_labels(effect_row_parse(eff)), ename) || dh_params_may_be(params, ename) || (match ret {
        Some(rt) => dh_texpr_may_be(rt, ename),
        None => false
      }),
      // A nested handle is not analysed for discharge here -- treating it as
      // reaching is the safe direction (it only ever suppresses a report).
      EHandle(_, _) => true,
      // #1515: a LOCAL binding of a row-carrying value is in neither table
      // until `overlay_bind_local` registers it, and the generic child walk
      // below descends with the OUTER overlay -- so `handle { let f = eff;
      // f(..) }` looked like it reached no perform and was reported dead.
      // Rebuild the overlay here exactly as `dh_check_expr` does, so the two
      // halves of the dead-handle judgement share one notion of scope.
      //
      // This matters BECAUSE of the row fix in this same change: requiring the
      // row makes `handle` the other way to satisfy the checker, and that way
      // was answering with a false "can never fire" (measured on the committed
      // seed too, so the false positive predates the row fix -- it was just
      // unreachable while the row was never required).
      ELet(lname, lval, lbody, _) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs) {
        (bn, be) => dh_may_reach(lval, ename, fn_names, fn_effs, ov_names, ov_effs) || dh_may_reach(lbody, ename, fn_names, fn_effs, bn, be)
      },
      ELetMut(lname, lval, lbody, _) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs) {
        (bn, be) => dh_may_reach(lval, ename, fn_names, fn_effs, ov_names, ov_effs) || dh_may_reach(lbody, ename, fn_names, fn_effs, bn, be)
      },
      // `let rec` may reference itself, so both sides see the rebound overlay
      // (same asymmetry the transitive walk's ELetRec arm keeps).
      ELetRec(lname, lval, lbody) => match overlay_bind_local(ov_names, ov_effs, lname, lval, fn_names, fn_effs) {
        (rn, re) => dh_may_reach(lval, ename, fn_names, fn_effs, rn, re) || dh_may_reach(lbody, ename, fn_names, fn_effs, rn, re)
      },
      _ => false
    }
    if direct {
      true
    } else {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) {
        if !found && dh_may_reach(Array::get(children, i), ename, fn_names, fn_effs, ov_names, ov_effs) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

/// A call to a plain lowercase, unqualified name that is neither a top-level
/// binding nor a builtin: a local value holding a function, which is what a
/// stored continuation is. Constructors (capitalised) and qualified names
/// (`Fs::read_file`, `T::method`) are resolvable and never count; so does any
/// non-`EIdent` callee, deliberately -- narrowing to this one shape is what
/// keeps the rule free of false positives on ordinary code.
fn dh_callee_is_opaque(nm: String, fn_names: Array[String]) -> Bool {
  if String::length(nm) == 0 || nm == "perform" || nm == "resume" {
    false
  } else if String::index_of(nm, "::") >= 0 {
    false
  } else {
    let c = String::char_code_at(nm, 0)
    if c >= 65 && c <= 90 {
      false
    } else if effect_row_has_label(Some(fn_names), nm) {
      false
    } else {
      match lookup_builtin(canonical_builtin_name(nm)) {
        Some(_) => false,
        None => true
      }
    }
  }
}

fn dh_has_opaque_call(expr: Expr, fn_names: Array[String]) -> Bool {
  let direct = match expr {
    ECall(EIdent(nm, _), _, _) => dh_callee_is_opaque(nm, fn_names),
    _ => false
  }
  if direct {
    true
  } else {
    let children = expr_children(expr)
    let mut i = 0
    let mut found = false
    while i < Array::length(children) {
      if !found && dh_has_opaque_call(Array::get(children, i), fn_names) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// Scope-aware descent: the #885/#1361 overlay of in-scope function-typed
/// parameters and row-declaring local closures is rebuilt exactly as the
/// transitive walk above rebuilds it, so a handle site is judged against the
/// same notion of "this callee's declared row" the row checker itself uses.
fn dh_check_expr(expr: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], ov_names: Array[String], ov_effs: Array[Array[String]], errors: Array[EffectError]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      let handled = collect_handle_effects(arms)
      let mut i = 0
      while i < Array::length(handled) {
        let eff = Array::get(handled, i)
        if effect_row_has_label(Some(declared), eff) && effect_row_has_label(Some(performed), eff) && !dh_may_reach(body, eff, fn_names, fn_effs, ov_names, ov_effs) && dh_has_opaque_call(body, fn_names) {
          Array::push(errors, EEHandleNeverFires(eff))
        } else {
          ()
        }
        i = i + 1
      }
      dh_check_expr(body, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        dh_check_expr(arm_body, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)
        ai = ai + 1
      }
    },
    EFn(_, _, params, _, _, body) => {
      let (bn, be) = dh_overlay_with_params(ov_names, ov_effs, params, fn_names)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)
    },
    ELet(name, val, body, _) => {
      dh_check_expr(val, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)
      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)
    },
    ELetMut(name, val, body, _) => {
      dh_check_expr(val, declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)
      let (bn, be) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, bn, be, errors)
    },
    ELetRec(name, val, body) => {
      let (rn, re) = overlay_bind_local(ov_names, ov_effs, name, val, fn_names, fn_effs)
      dh_check_expr(val, declared, performed, fn_names, fn_effs, rn, re, errors)
      dh_check_expr(body, declared, performed, fn_names, fn_effs, rn, re, errors)
    },
    _ => {
      let children = expr_children(expr)
      let mut c = 0
      while c < Array::length(children) {
        dh_check_expr(Array::get(children, c), declared, performed, fn_names, fn_effs, ov_names, ov_effs, errors)
        c = c + 1
      }
    }
  }
}

/// Strip a trailing `~` (labeled) / `?` (optional) marker — a parameter is
/// DECLARED as `f~` but CALLED as `f()`, so the overlay key must be the base
/// name or the lookup misses. fixtures/effect_inline_lambda_literal_labeled_
/// arg.vibe is exactly that shape: its handled body's only callee is the
/// labeled parameter `f~: () -> Int with Log`.
fn dh_param_base_name(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

fn dh_overlay_with_params(ov_names: Array[String], ov_effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])], fn_names: Array[String]) -> (Array[String], Array[Array[String]]) {
  let (sn, se) = shadow_overlay_names(ov_names, ov_effs, params)
  let (raw_ln, le) = build_param_overlay(params, fn_names)
  let ln = for n in raw_ln {
    dh_param_base_name(n)
  }
  if Array::length(ln) == 0 {
    (sn, se)
  } else {
    let names = Array::slice(ln, 0, Array::length(ln))
    let effs = Array::slice(le, 0, Array::length(le))
    let mut i = 0
    while i < Array::length(sn) {
      Array::push(names, Array::get(sn, i))
      Array::push(effs, Array::get(se, i))
      i = i + 1
    }
    (names, effs)
  }
}

fn dh_check_binding(ty: Option[TypeExpr], body: Expr, declared: Array[String], performed: Array[String], fn_names: Array[String], fn_effs: Array[Array[String]], errors: Array[EffectError]) -> Unit {
  match body {
    // Seed the overlay from THIS binding's own parameters, exactly as
    // check_perform_effects_binding_tx does -- descending straight into
    // `fbody` would otherwise lose them (the top-level annotation, not the
    // EFn node, is where a separately-typed signature keeps its rows).
    EFn(_, _, params, _, _, fbody) => {
      let (n, e) = dh_overlay_with_params(no_str_labels(), no_ov_effs(), merge_param_types_with_sig(ty, params), fn_names)
      dh_check_expr(fbody, declared, performed, fn_names, fn_effs, n, e, errors)
    },
    _ => dh_check_expr(body, declared, performed, fn_names, fn_effs, no_str_labels(), no_ov_effs(), errors)
  }
}

fn check_dead_handles_stmts(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {
  let errors = array_empty()
  let declared = dh_declared_effects(stmts)
  if Array::length(declared) == 0 {
    errors
  } else {
    let performed = dh_collect_performed_effects(stmts)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(_, _, _, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, errors),
        SLetMut(_, ty, body) => dh_check_binding(ty, body, declared, performed, fn_names, fn_effs, errors),
        SExpr(e) => dh_check_binding(None, e, declared, performed, fn_names, fn_effs, errors),
        STest(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, errors),
        SBench(_, body) => dh_check_binding(None, body, declared, performed, fn_names, fn_effs, errors),
        _ => ()
      }
      i = i + 1
    }
    errors
  }
}

/// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result
/// is safe to cache/skip only when running it depends on nothing external — no
/// I/O, no non-determinism — so it is a deterministic function of source + deps +
/// compiler version. file_tests_cacheable is true iff the file has at least one
/// `test {}` block and EVERY test block is transitively effect-free.
///
/// Reuses the transitive effect walk: a test body checked with an EMPTY declared
/// row reports an error for ANY effect it reaches that a `handle` does not
/// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the
/// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`
/// are excluded by that pass, so they stay cacheable; a `handle` that fully
/// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.
/// Zero errors => cacheable.
///
/// A direct `sh`/`sh_lines` call IS surfaced: builtin_call_effect special-cases
/// these two unqualified builtins to `Process` (they lower to real host imports),
/// so a test that shells out is correctly treated as impure/non-cacheable, the
/// same as `sh` reached through a user function declaring `with Process`.
/// Conservative otherwise: an effect the type system does not surface here stays
/// invisible, but it never marks a genuinely-impure test cacheable.
export fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      SLetMut(name, ty, body) => {
        Array::push(fn_names, name)
        Array::push(fn_effs, fn_binding_effects(ty, body))
      },
      _ => ()
    }
    m = m + 1
  }
  let empty_decl = array_empty()
  let mut any_test = false
  let mut all_ok = true
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(_, body) => {
        any_test = true
        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
        if Array::length(errs) != 0 {
          all_ok = false
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  any_test && all_ok
}

/// #819 (Codex review, PR #1214): entry-function counterpart of
/// file_tests_cacheable above, for a program compiled with a normal ENTRY
/// function (e.g. `fn main`) instead of `test {}` blocks -- used by
/// scripts/vibe_md.vibex's ```vibe run block execute-cache. Unlike a test's
/// empty declared row, `Stdout` is declared-safe here: it is the block's
/// PRODUCED, CAPTURED value (the exact thing the cache stores and compares
/// against the doc's ```output block), not a hidden nondeterminism source.
/// `Error`/`Async` are exempt for the same reason file_tests_cacheable
/// leaves them out -- a throwing entry never reaches the caller's cache-write
/// path anyway (run_one_block only caches on a successful `_start`), and
/// Async is composition, not itself a host nondeterminism source. Any OTHER
/// reachable effect (Fs/Env/Http/Process/Socket/custom/...) means the
/// entry's stdout can vary between runs of byte-identical compiled wasm, so
/// it must NOT be treated as cacheable -- returns false if `entry_name` is
/// not found among the file's top-level bindings.
export fn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool {
  let fn_names = array_empty()
  let fn_effs = array_empty()
  let mut entry_body = None
  let mut entry_declared = None
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SLet(_, _, name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      SLetMut(name, ty, body) => {
        let effs = fn_binding_effects(ty, body)
        Array::push(fn_names, name)
        Array::push(fn_effs, effs)
        if name == entry_name {
          entry_body = Some(body)
          entry_declared = Some(effs)
        } else {
          ()
        }
      },
      _ => ()
    }
    m = m + 1
  }
  match entry_body {
    None => false,
    Some(body) => {
      // Entry-cache-safe labels are derived from
      // core/standard_effect_policy.vibe in existing order. Their policy
      // decisions, including provider output and entry/runtime handling, are
      // unchanged.
      let cache_safe_row = entry_cache_safe_effects()
      // Codex review, PR #1215: belt-and-suspenders on top of the
      // reachable-effects walk below. That walk shares check_perform_
      // effects_expr_tx's own limitation (also present, unchanged, in the
      // established `vibe test` cache via file_tests_cacheable above): a
      // LOCAL closure defined inside the body is checked under its OWN
      // declared row (so an inner `with Env` satisfies itself and never
      // surfaces as an error at this call site), and a row-POLYMORPHIC
      // callee's effect-VARIABLE labels are deliberately treated as "leaks
      // nothing" here (real call-site row-variable instantiation tracking
      // is #885, not implemented by this pass -- see the "Effect-variable
      // rows (polymorphic) impose nothing HERE" comment near
      // check_perform_effects_expr_tx_in's transitive-leak check above).
      // Neither gap is new to this PR. Closing it outright would need #885-
      // class compiler work, out of proportion for a doctest-cache
      // hardening -- instead, conservatively reject up front whenever the
      // entry's OWN declared row names anything outside the safe set. A
      // real top-level `main` is never itself row-polymorphic, so this is a
      // cheap, purely-additive net that catches the common/direct case
      // (`fn main with Stdout + Env { ... }`) even in scenarios the
      // deeper walk alone would miss.
      let declared_ok = match entry_declared {
        None => true,
        Some(row) => labels_are_entry_cache_safe(row)
      }
      if !declared_ok {
        false
      } else {
        // `body` (from SLet/SLetMut) is the closure VALUE bound to
        // entry_name, e.g. `EFn(type_params, bounds, params, ret_ty,
        // effect, fn_body)` for `fn main with <row> { ... }` -- checking
        // the EFn NODE itself would trivially find zero reachable effects
        // (defining a closure performs nothing; only CALLING it would),
        // silently marking every entry cacheable regardless of what it
        // does. The walk needs `fn_body`, the 6th field, not the literal.
        let exec_body = match body {
          EFn(_, _, _, _, _, fn_body) => fn_body,
          _ => body
        }
        let errs = check_perform_effects_expr_tx(exec_body, cache_safe_row, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())
        Array::length(errs) == 0
      }
    }
  }
}

/// Every label in `row` must appear in `safe` -- unlike decl_authorizes_
/// effect above (used the OPPOSITE direction: "does this declared row
/// authorize performing effect X", where an effect-VARIABLE label
/// conservatively authorizes anything), this is used to conservatively
/// REJECT: an unrecognized label (including a row-variable letter, which a
/// real top-level `main` should never carry) is NOT treated as safe.
///
/// #1343: each row label is reduced to its EFFECT name before the lookup.
/// Once operation-level rows became expressible for host capabilities
/// (#1359), an entry declaring the STRICTLY NARROWER
/// `with Stdout::write_stream` would otherwise fail this exact-string
/// test and be judged un-cacheable, while the broader `with Stdout`
/// passed -- i.e. tightening a row would lose the #819/#1214 doctest cache.
/// `effect_name_of_op` only strips a `::` suffix (and canonicalizes the
/// exception aliases), so a row variable stays a row variable and an
/// unrelated effect stays unrelated: the conservative rejection above is
/// unchanged.
fn labels_are_entry_cache_safe(row: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(row) {
    if !is_entry_cache_safe_operation(Array::get(row, i)) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn array_is_subset_of_str(row: Array[String], safe: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(row) {
    let eff = effect_name_of_op(Array::get(row, i))
    let mut j = 0
    let mut found = false
    while j < Array::length(safe) {
      if Array::get(safe, j) == eff {
        found = true
      } else {
        ()
      }
      j = j + 1
    }
    if !found {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

//# Mutability discipline: reassignment requires a `let mut` binding.
//
// `let x = ...` is immutable (docs/cheatsheet.md); only `let mut x` may be
// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass
// walks expressions carrying the SET of names that are reassignable in scope
// and reports an `x = e` / `x op= e` whose target is not in that set.
//
// The set only ever GROWS down a scope (never shrinks), so the pass can only
// produce false NEGATIVES, never false positives: every form that introduces a
// reassignable or freshly-rebindable name — `let mut`, function parameters,
// loop accumulators, `for` variables, and pattern binds — is added, so the
// only thing flagged is reassignment of a plain immutable `let`. Nested
// functions INHERIT the outer set (a closure may mutate a captured `let mut`).

fn mut_has(xs: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn mut_with(base: Array[String], name: String) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  Array::push(out, name)
  out
}

fn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(acc, name),
    PCtor(_, subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    PTuple(subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    POr(l, r) => {
      collect_pat_binds_into(l, acc)
      collect_pat_binds_into(r, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binds_into(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  collect_pat_binds_into(pat, out)
  out
}

fn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    Array::push(out, pname)
    i = i + 1
  }
  out
}

export fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {
  let errors = array_empty()
  match expr {
    ECall(callee, args, _) => {
      append_eff_errs(errors, check_mutability_expr(callee, mutable))
      let mut ai = 0
      while ai < Array::length(args) {
        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, params, _, _, body) => {
      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))
      errors
    },
    EHandle(body, arms) => {
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    ELet(_, val, body, _) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetRec(_, val, body) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetMut(name, val, body, _) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))
      errors
    },
    ESeq(a, b) => {
      append_eff_errs(errors, check_mutability_expr(a, mutable))
      append_eff_errs(errors, check_mutability_expr(b, mutable))
      errors
    },
    EIf(cond, then_e, else_e) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(then_e, mutable))
      append_eff_errs(errors, check_mutability_expr(else_e, mutable))
      errors
    },
    EMatch(scrutinee, arms) => {
      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELoop(params, body) => {
      let loopmut = Array::slice(mutable, 0, Array::length(mutable))
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        append_eff_errs(errors, check_mutability_expr(init, mutable))
        Array::push(loopmut, pname)
        i = i + 1
      }
      append_eff_errs(errors, check_mutability_expr(body, loopmut))
      errors
    },
    EForIn(name, index_name, iter, body) => {
      append_eff_errs(errors, check_mutability_expr(iter, mutable))
      let base = mut_with(mutable, name)
      let formut = match index_name {
        Some(idx) => mut_with(base, idx),
        None => base
      }
      append_eff_errs(errors, check_mutability_expr(body, formut))
      errors
    },
    EBinOp(_, left, right) => {
      append_eff_errs(errors, check_mutability_expr(left, mutable))
      append_eff_errs(errors, check_mutability_expr(right, mutable))
      errors
    },
    EReturn(e) => check_mutability_expr(e, mutable),
    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),
    EAssign(name, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EAssignOp(name, _, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    ERecord(_, fields, _) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        append_eff_errs(errors, check_mutability_expr(fval, mutable))
        fi = fi + 1
      }
      errors
    },
    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal
    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map
    // literal, labeled argument, spread, break value, or continue argument went
    // unflagged. Recurse with the SAME mutable set (these forms introduce no new
    // bindings), keeping the pass sound: still no false positives, just fewer
    // false negatives.
    EMap(entries) => {
      let mut mi = 0
      while mi < Array::length(entries) {
        let (_, mval) = Array::get(entries, mi)
        append_eff_errs(errors, check_mutability_expr(mval, mutable))
        mi = mi + 1
      }
      errors
    },
    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),
    ESpread(inner) => check_mutability_expr(inner, mutable),
    EBreak(opt) => match opt {
      Some(e) => check_mutability_expr(e, mutable),
      None => errors
    },
    EContinue(cargs) => {
      let mut ci = 0
      while ci < Array::length(cargs) {
        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))
        ci = ci + 1
      }
      errors
    },
    // New structural forms keep the same binding context; scoped forms above
    // intentionally remain explicit so their boundary semantics are visible.
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        append_eff_errs(errors, check_mutability_expr(Array::get(children, i), mutable))
        i = i + 1
      }
      errors
    }
  }
}

/// #770: `outer` carries the top-level `let mut` names already in scope from
/// earlier sibling statements (see check_mutability_stmts below) so a later
/// top-level statement's assignment to an earlier top-level `mut` binding
/// (directly, or via a closure capturing it) is recognized as mutable instead
/// of being misreported as `cannot assign to immutable binding`.
fn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {
  match body {
    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),
    _ => check_mutability_expr(body, outer)
  }
}

/// #770: top-level program statements are a flat `Array[Stmt]` sequence (not
/// nested `ELetMut` continuations like a function/test body), so a top-level
/// `let mut x = ...` must thread `x` forward into the mutability check of
/// every later sibling statement by accumulating `mutable` across the loop —
/// mirroring how `check_stmts` threads `env` across the same array. Before
/// this fix each statement was checked in isolation starting from an empty
/// mutable set, so any top-level `let mut` followed by an assignment in a
/// later top-level statement (e.g. a top-level `while` loop mutating a
/// counter) was rejected with a bogus `cannot assign to immutable binding`
/// error even though the program is valid.
export fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut mutable = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),
      SLetMut(name, _, body) => {
        append_eff_errs(errors, check_mutability_binding(body, mutable))
        mutable = mut_with(mutable, name)
      },
      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),
      _ => ()
    }
    i = i + 1
  }
  errors
}
