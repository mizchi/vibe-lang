//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

// WASI 0.3 async front-end (M1a/M2/M-conc). See docs/spec/wasi-p3-async.md,
// ADR-0012.
//
// These are type-level / front-end only (no codegen yet): `Future[T]`,
// `Stream[T]`, `Task[T]` are represented structurally as CtNamed(name, _) so no
// core `Type` enum change is needed, and element/result types use CtUnknown
// (gradual), consistent with the rest of the builtin table. Operations that
// suspend or touch the async runtime carry the open-string `Async` effect, so
// the existing effect-escape check (checker_effects.vibe) requires them to be
// used inside `with Async` (or a handle body) — exactly like `throw`/`Error`.

fn async_no_params() -> Array[Type] {
  array_empty()
}

/// Future[T] + await (M1a).
fn lookup_future(name: String) -> Option[Type] {
  if name == "await" {
    // await: (Future[T]) -> T with Async
    Some(CtFn([
      CtNamed("Future", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Future::ready" {
    // Future::ready: (T) -> Future[T]   (pure; an already-resolved future)
    Some(CtFn([
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), None))
  } else if name == "Future::pending" {
    // Future::pending: () -> Future[T]   (pure; an UNRESOLVED future)
    //
    // #1230, the producer half. `await` on this suspends
    // (`perform Async::Suspend(1)`, the poll-wait reason) and re-checks after
    // every resume, so whoever holds the future decides when it completes by
    // calling Future::resolve on it. Creating one is pure -- it is an empty
    // cell, not an operation -- and only AWAITING it carries `Async`.
    Some(CtFn(async_no_params(), CtNamed("Future", [
      CtUnknown
    ]), None))
  } else if name == "host_future_get" {
    // host_future_get: () -> Future[Int]   (pure; a HOST-supplied future)
    //
    // ADR-0089 step 4 (#1218): the readable end of the component-level
    // `get-future: func() -> future<u32>` import (spec §3.13). Creating it
    // is pure -- the async-lowered import call completes eagerly (the pair
    // is created synchronously; only the producer suspends) -- and only
    // AWAITING it carries `Async`, exactly like Future::pending. The await
    // parks with the reserved waitable payload (Suspend(handle + 2)); the
    // entry-boundary handler settles it via waitable-set.wait in the
    // component adapter. Payload is u32 on the wire, so Future[Int].
    Some(CtFn(async_no_params(), CtNamed("Future", [
      CtInt
    ]), None))
  } else if name == "host_future_named" {
    // host_future_named: (String) -> Future[Int]   (pure; a NAMED host future)
    //
    // ADR-0089 (c) (#1218): the generalization of `host_future_get`. The
    // argument is the component-level import NAME, so one program can await
    // several distinct host futures (`price`, `qty`, ...) instead of the
    // single anonymous `get-future`. Codegen requires a STRING LITERAL: the
    // name becomes a core import (`vibe.host_future_get$<name>`) and then a
    // component import, both of which are decided at compile time. Same
    // purity/effect story as host_future_get -- creating the pair is eager,
    // only AWAITING it carries `Async`.
    Some(CtFn([
      CtString
    ], CtNamed("Future", [
      CtInt
    ]), None))
  } else if name == "Future::resolve" {
    // Future::resolve: (Future[T], T) -> Unit   (completes a pending future in
    // place, so every awaiter of THAT future observes it)
    Some(CtFn([
      CtNamed("Future", [
        CtUnknown
      ]),
      CtUnknown
    ], CtUnit, None))
  } else {
    None
  }
}

/// Stream[T] — a pull-based async iterator (WASI 0.3 stream<T>), the async
/// sibling of Iterator (ADR-0044): the same combinator shape (map/filter/fold)
/// as the sync Iterator, but `next` yields a Future and `fold` is Async.
fn lookup_stream(name: String) -> Option[Type] {
  if name == "Stream::empty" {
    // Stream::empty: () -> Stream[T]   (pure)
    Some(CtFn(async_no_params(), CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::once" {
    // Stream::once: (T) -> Stream[T]   (pure; single-element stream)
    Some(CtFn([
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::next" {
    // Stream::next: (Stream[T]) -> Future[Option[T]] with Async
    // None terminates the stream.
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ])
    ], CtNamed("Future", [
      CtOption(CtUnknown)
    ]), Some("Async")))
  } else if name == "host_stream_named" {
    // host_stream_named: (String) -> Stream[Int]   (pure; a NAMED host stream)
    //
    // ADR-0089 Decision 3 (#1218): the readable end of a component-level
    // `<name>: func() -> stream<u8>` import (spec §3.17/§3.18) -- the stream
    // sibling of `host_future_named`. The argument is the component import
    // NAME; codegen requires a STRING LITERAL (it becomes the core import
    // `vibe.host_stream_get$<name>` and then a component import, both fixed
    // at compile time). Creating the readable end is pure -- the
    // async-lowered import call completes eagerly (pair creation never
    // suspends) -- and only READING it (`host_stream_next`) carries `Async`.
    //
    // #1341: the result is `HostStream`, NOT `Stream[Int]`. They had the same
    // static type and two INCOMPATIBLE runtime representations: an eager
    // `Stream[Int]` is a plain array of elements, while a host stream is the
    // 2-word cell `[state, handle]`. Nothing rejected `for b in host_stream_
    // named("body")` -- it took the array path and summed the CELL, returning
    // a plausible small number (measured: 4 = state 3 + handle 1) instead of
    // the body's bytes. A distinct nominal type is what lets the desugar route
    // the loop to the host read and makes every other Stream combinator a type
    // error on a host stream instead of silent garbage.
    Some(CtFn([
      CtString
    ], CtNamed("HostStream", array_empty()), None))
  } else if name == "host_stream_next" {
    // host_stream_next: (Stream[Int]) -> Int with Async
    //
    // ADR-0089 Decision 3 (#1218): pull ONE byte from a host stream created
    // by `host_stream_named`. Returns the byte (0-255), or -1 once the
    // writer is gone (end of stream; further calls keep returning -1). This
    // is where the park happens -- per READ, not per stream: each call
    // performs `Async::Suspend` with the reserved stream payload band and
    // the entry boundary settles it via `stream.read` (+ waitable-set.wait
    // when the read blocks) in the component adapter.
    //
    // Distinct from the generic `Stream::next` (Future[Option[T]] protocol):
    // this is the direct scalar read the p3 lowering supports today. #1341
    // connects `for b in s` to it via the desugar; the full AsyncIter
    // unification stays follow-up (spec §3.18).
    Some(CtFn([
      CtNamed("HostStream", array_empty())
    ], CtInt, Some("Async")))
  } else if name == "host_stream_close" {
    // host_stream_close: (Stream[Int]) -> Unit   (pure)
    //
    // ADR-0089 Decision 3 follow-up (#1218): release the readable end of a
    // host stream the guest is done with BEFORE end of stream. The read
    // half drops the end only when it reaches EOS, so a partially consumed
    // stream (`take the first 4 bytes, then stop`) otherwise pins its
    // handle for the component instance's whole lifetime -- the limitation
    // recorded at the end of spec §3.18.
    //
    // Not `Async`, unlike `host_stream_next`: dropping a readable end is a
    // canon call that never blocks, so it needs no park and no boundary
    // settle -- the injected `__hs_close` calls the adapter directly. It is
    // also IDEMPOTENT: closing an already-closed (or fully drained) stream
    // is a no-op, because the cell's state word is what gates the drop.
    Some(CtFn([
      CtNamed("HostStream", array_empty())
    ], CtUnit, None))
  } else if name == "Stream::map" {
    // Stream::map: (Stream[T], (T) -> U) -> Stream[U]   (lazy)
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::filter" {
    // Stream::filter: (Stream[T], (T) -> Bool) -> Stream[T]   (lazy)
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::fold" {
    // Stream::fold: (Stream[T], A, (A, T) -> A) -> Future[A] with Async
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown,
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), Some("Async")))
  } else {
    None
  }
}

/// `Task[T]` (the M-conc-1 eager prototype: `Task::spawn`/`join`/`cancel`/
/// `race`/`timeout`) was RETIRED in #1227. It compiled `spawn` to an immediate
/// `call_indirect` of the thunk, so `spawn(f); spawn(g)` always finished `f`
/// before starting `g` -- concurrency that silently serialized, with `join` as
/// identity and `cancel` a no-op. Its only callers in this repo were two
/// coverage probes; nothing used it to actually run work concurrently.
///
/// The working surface is `@vibex/concurrent`: `TaskGroup::spawn_suspend` for a
/// suspendable task, `TaskHandle::join`, and `sleep_wait` (#1253) for a sleep
/// that overlaps instead of blocking. Real subtask spawn over waitable-set /
/// `future.cancel-*` remains M-conc-2 (ADR-0068, spec §2.5).
fn lookup_concurrency(name: String) -> Option[Type] {
  let _ = name
  None
}

/// ByteStream = Stream[Int] — WASI 0.3 stream<u8> / HTTP body bridge (M2c).
/// `String::to_bytes` exposes a String's bytes as a ByteStream so request/response
/// bodies can be consumed with the Stream combinators (map/filter/fold/next). It
/// is pure & eager on the linear backend (the bytes are already in memory).
fn lookup_bytestream(name: String) -> Option[Type] {
  if name == "String::to_bytes" {
    // String::to_bytes: (String) -> Stream[Int]   (ByteStream)
    Some(CtFn([
      CtString
    ], CtNamed("Stream", [
      CtInt
    ]), None))
  } else if name == "Stream::to_string" {
    // Stream::to_string: (Stream[Int]) -> String   (ByteStream -> String;
    // collect a byte stream into a response body)
    Some(CtFn([
      CtNamed("Stream", [
        CtInt
      ])
    ], CtString, None))
  } else {
    None
  }
}

export fn lookup_async(name: String) -> Option[Type] {
  match lookup_future(name) {
    Some(t) => Some(t),
    None => match lookup_stream(name) {
      Some(t) => Some(t),
      None => match lookup_concurrency(name) {
        Some(t) => Some(t),
        None => lookup_bytestream(name)
      }
    }
  }
}
