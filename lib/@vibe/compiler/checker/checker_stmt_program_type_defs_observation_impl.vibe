export fn check_program_type_defs_observation_impl(stmts: Array[Stmt], capture: Option[CheckerStatementCapture], role_lane_capture: Option[TypedOccurrenceRoleLaneCapture]) -> CheckedProgramTypeDefsObservation with Exception {
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  push_error_strings(collect_trait_namespace_conflict_errors(stmts, EnvEmpty), frozen_errors)
  derive_trait_namespace_operations(stmts)
  // Rank-1 method generics (#684): re-attach trait-method `[X: Bound]` binders
  // to impl free functions before checking, so `X::method` in an impl body
  // resolves on every path (the FS-compile path type-checks before the codegen
  // desugar runs). In-place + idempotent + inert without a method-level binder.
  inject_trait_method_generics(stmts)
  // #635: lower `let*`/`?` railway sentinels (`__try_bind`/`__try_op`) by the
  // operand's head type BEFORE checking, so the checker never sees the
  // sentinels (the codegen-time desugar runs later, but the FS-compile path
  // type-checks first). In-place, idempotent, inert without `let*`/`?`.
  desugar_railway_binds(stmts)
  canonicalize_stdin_provider_type_import_heads(stmts)
  collect_stdin_provider_direct_call_errors(stmts, frozen_errors)
  // #3086: a value binder spelled like a constructor, before the check reads
  // the program under two meanings of that name.
  collect_constructor_binder_errors(stmts, EnvEmpty, frozen_errors)
  // #3073: a derive whose generated code would call an operation that a
  // field's declared type does not provide.
  collect_derive_field_errors(stmts, EnvEmpty, frozen_errors)
  // #1455 step 3: the `Enum::Variant` pattern qualifiers the parser folded into
  // a trailing `SQualifiedPatternRefs` marker (see attach_qualified_pattern_refs).
  // Collected up front; validating them needs the enum table, which only exists
  // once check_stmts_with_binders below has run.
  let qualified_pattern_refs = collect_qualified_pattern_refs(stmts)
  // #1001: mixed positional/labeled argument-mode validation. Must run BEFORE
  // desugar_labeled_args below — it silently strips a label that already
  // matches its own declared position, which erases the only evidence that a
  // call genuinely mixed argument modes (see check_mixed_argument_modes).
  check_labeled_arg_names_stmts(stmts, frozen_errors, true)
  // #986: reorder fully-labeled calls into declared parameter order BEFORE
  // checking, so the checker unifies each labeled argument against the same
  // parameter position codegen will bind it to (the codegen-time desugar runs
  // this pass again later — it is in-place and idempotent). Without this the
  // checker would see `add(y=2, x=1)` in call order while codegen binds the
  // reordered form.
  desugar_labeled_args(stmts)
  // #1571: expand `inspect(..)` here, before the checker and before every
  // pre-codegen scan, so the snapshot assertion is import-free (see
  // desugar_inspect_calls).
  desugar_inspect_calls(stmts)
  // #1962 (Option 1): a direct host-builtin call inside a `handle` whose arms
  // name the same operation becomes `perform <Op>(..)`. BEFORE checking, so
  // the effect row the checker computes is the one the program actually has.
  desugar_handled_host_calls(stmts)
  // #2141: loud guard at the binder, before checking -- see the pass doc.
  collect_type_param_shadowing_errors(stmts, frozen_errors)
  let empty_defs = array_empty()
  let type_def_binders = array_empty()
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits_for(EnvEmpty, builtin_seed_withheld(stmts, EnvEmpty))
  }
  let seeded_env = env_cache(seeded_raw_env)
  let tytab = array_empty()
  reset_return_provenance_index()
  reset_eq_formal_vars()
  reset_throw_payload_sites()
  set_generic_fn_decls(stmts)
  // #986: labeled-argument name validation (unknown / out-of-order labels).
  // Must run after desugar_labeled_args above.
  check_labeled_arg_names_stmts(stmts, frozen_errors, false)
  // ADR-0071 step 3 (#755): expand any effectset-name token in EVERY
  // declared effect row (function signatures AND parameter types) into its
  // flat leaf-label set ONCE here, before type-checking -- not just before
  // collect_async_effect_errors below. Argument-compatibility checking
  // (check_assignable's effect-row subtyping, checker.vibe) runs as part of
  // check_stmts and independently compares raw row strings; feeding it an
  // unexpanded "AskAll" against an already-expanded "Ask::Get" callee would
  // report a false "effect would be dropped" mismatch even though the
  // effectset actually covers it. A non-mutating copy (stmts itself, and
  // whatever the caller does with it after check_program returns, are
  // unaffected) is enough: codegen never reads the row's text content.
  let expanded_stmts = es_expand_top_level_effectset_rows(stmts, EnvEmpty)
  let statement_parent_path = match capture {
    Some(_) => Some(array_empty()),
    None => match role_lane_capture {
      Some(_) => Some(array_empty()),
      None => None
    }
  }
  // #3042: the prelude `Ordering`, checked ahead of the module's own
  // declarations (see seed_prelude_ordering).
  let (prelude_env, prelude_defs_start, prelude_next_c) = seed_prelude_ordering(expanded_stmts, seeded_env, empty_defs, type_def_binders, 0, 0, frozen_errors, tytab)
  let (env, final_s0, _) = check_stmts_with_binders(expanded_stmts, 0, prelude_env, empty_defs, type_def_binders, prelude_defs_start, SubstEmpty, prelude_next_c, frozen_errors, tytab, statement_parent_path, capture, role_lane_capture, false, true)
  // #2848: field reads whose receiver was still unsolved at every function
  // end are judged once more under the final substitution, which comes back
  // extended by the resolved reads' result variables -- BEFORE the bound
  // check, so a bound attached to a read's result is validated against the
  // field's real type rather than skipped as an unresolved variable (Codex on
  // #2864, round 3).
  let final_s = resolve_deferred_field_reads(final_s0, empty_defs, frozen_errors, false)
  check_program_bounds(env, final_s, empty_defs, frozen_errors)
  // #1858: a bounded generic whose body calls `T::m` but whose signature has
  // no witness-carrying parameter would sail through checking and ICE in
  // codegen (`T::m reached code generation unresolved`) — reject it here with
  // an actionable message instead. The capability predicate lives next to
  // build_gens in desugar_trait_dict.vibe.
  push_error_strings(collect_undispatchable_trait_method_errors(stmts, env), frozen_errors)
  publish_throw_site_kinds(final_s)
  // These publication walks share one completed substitution. Index its
  // read view once; the observation still publishes the original final_s.
  let formal_s = callee_formal_query_subst(final_s)
  set_call_formal_bindings(callee_formal_bindings(empty_defs, formal_s))
  set_call_formal_marked_bindings(callee_formal_marked_bindings(empty_defs, formal_s))
  set_shadowed_builtin_type_names(builtin_named_type_params(stmts))
  set_row_nominal_types(row_nominal_type_names(stmts, env, empty_defs))
  collect_async_effect_errors(expanded_stmts, env, empty_defs, frozen_errors)
  // #1455 step 3: `empty_defs` is the finished enum table by now, so the
  // qualifiers drained above can finally be checked against it.
  check_qualified_pattern_refs(qualified_pattern_refs, empty_defs, frozen_errors)
  if Array::length(frozen_errors) > 0 {
    // #2831 criterion 4: report EVERY diagnostic this check collected, not
    // just the first. They are all computed by the time we get here, and
    // measured on a three-error file they are real, distinct and none a
    // cascade of another -- so throwing `frozen_errors[0]` made `vibe check`
    // answer a strictly worse version of a question it had already answered:
    // three broken bindings took three edit-and-rerun cycles instead of one.
    // The parse lane has joined its diagnostics with `\n` since #1567 for
    // exactly this reason, and every locate/prefix site downstream maps over
    // the lines.
    throw(String::join(dedupe_error_lines(frozen_errors), "\n"))
  }
  // #1947: `__try_none` is a checker-only origin marker. Codegen resolves
  // constructors by name and would ICE on it (`reached code generation
  // unresolved`). Erase after a clean check so later stages see `None`.
  erase_railway_origin_markers(stmts)
  CheckedProgramTypeDefsObservation::{
    checked_program: CheckedProgram::{
      checked_stmts: stmts,
      final_env: env,
      type_defs: empty_defs,
      final_subst: final_s,
      typed_occurrences: tytab
    },
    type_def_binders: type_def_binders
  }
}

fn direct_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

/// Append an injective decimal path encoding. Length and per-element
/// delimiters make `[1, 23]`, `[12, 3]`, and signed coordinates distinct.
/// This is a complete coordinate value, never a hash used as an identity.
fn direct_coordinate_key_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, ":")
  let mut i = 0
  while i < Array::length(path) {
    StringBuilder::push(out, __to_string(Array::get(path, i)))
    StringBuilder::push(out, ":")
    i = i + 1
  }
}

/// Collision-safe total key for one retained statement/expression coordinate.
/// The tags prevent the two independently length-prefixed paths from merging.
fn direct_coordinate_key(statement_path: Array[Int], expression_path: Array[Int]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "S")
  direct_coordinate_key_push_path(out, statement_path)
  StringBuilder::push(out, "E")
  direct_coordinate_key_push_path(out, expression_path)
  StringBuilder::freeze(out)
}

/// Reconcile checker-return frames against authoritative retained preorder in
/// O(n log n): stable bottom-up sorts arrange complete coordinate keys, then
/// an exact merge detects missing and duplicate frames. The final assembly
/// walks the skeleton's original preorder, never checker scheduling order.
/// Any synthetic lane, skipped child, duplicate, or missing frame is invisible
/// as `None`; normal checker errors have already propagated to the caller.
export fn direct_expression_return_observation_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> Option[CheckedDirectExpressionReturnObservation] {
  if !capture.complete {
    None
  } else {
    match checked_expression_structure_rows(checked.checked_stmts) {
      None => None,
      Some(skeleton) => if Array::length(skeleton) != Array::length(capture.direct_entries) {
        None
      } else {
        let skeleton_keys = array_empty()
        let direct_keys = array_empty()
        let mut i = 0
        while i < Array::length(skeleton) {
          let (statement_path, expression_path, _) = Array::get(skeleton, i)
          let (direct_statement_path, direct_expression_path, _) = Array::get(capture.direct_entries, i)
          Array::push(skeleton_keys, direct_coordinate_key(statement_path, expression_path))
          Array::push(direct_keys, direct_coordinate_key(direct_statement_path, direct_expression_path))
          i = i + 1
        }
        let skeleton_perm = sort_perm_by_names(skeleton_keys)
        let direct_perm = sort_perm_by_names(direct_keys)
        let direct_index_for_skeleton = array_empty()
        let mut fill = 0
        while fill < Array::length(skeleton) {
          Array::push(direct_index_for_skeleton, -1)
          fill = fill + 1
        }
        let mut sorted = 0
        let mut valid = true
        while sorted < Array::length(skeleton) && valid {
          let skeleton_index = Array::get(skeleton_perm, sorted)
          let direct_index = Array::get(direct_perm, sorted)
          let skeleton_key = Array::get(skeleton_keys, skeleton_index)
          let direct_key = Array::get(direct_keys, direct_index)
          let duplicate_skeleton = sorted > 0 && skeleton_key == Array::get(skeleton_keys, Array::get(skeleton_perm, sorted - 1))
          let duplicate_direct = sorted > 0 && direct_key == Array::get(direct_keys, Array::get(direct_perm, sorted - 1))
          let (statement_path, expression_path, _) = Array::get(skeleton, skeleton_index)
          let (actual_statement_path, actual_expression_path, _) = Array::get(capture.direct_entries, direct_index)
          if duplicate_skeleton || duplicate_direct || skeleton_key != direct_key || !direct_paths_equal(statement_path, actual_statement_path) || !direct_paths_equal(expression_path, actual_expression_path) {
            valid = false
          } else {
            Array::set(direct_index_for_skeleton, skeleton_index, direct_index)
          }
          sorted = sorted + 1
        }
        if valid {
          let entries = array_empty()
          let mut row = 0
          while row < Array::length(skeleton) {
            let (statement_path, expression_path, _) = Array::get(skeleton, row)
            let (_, _, ty) = Array::get(capture.direct_entries, Array::get(direct_index_for_skeleton, row))
            Array::push(entries, (copy_ints(statement_path), copy_ints(expression_path), ty))
            row = row + 1
          }
          Some(CheckedDirectExpressionReturnObservation::{
            checked_program: checked,
            entries: entries
          })
        } else {
          None
        }
      }
    }
  }
}

export fn direct_expression_return_capture() -> TypedOccurrenceRoleLaneCapture {
  TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: true,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
}

/// Run the production checker once and expose retained type-definition binder
/// provenance for canonical observation.
export fn check_program_type_defs_observation(stmts: Array[Stmt]) -> CheckedProgramTypeDefsObservation with Exception {
  check_program_type_defs_observation_impl(stmts, None, None)
}

/// Observe every legacy typed-occurrence row at checker time by its owning
/// retained statement. Paths are relative only to this post-desugar
/// CheckedProgram; they are not original-source or edit-stable coordinates.
export fn check_program_typed_occurrence_statement_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceStatementObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_type_defs_observation_impl(stmts, Some(StatementTypedOccurrences(entries)), None).checked_program
  typed_occurrence_statement_observation_from_capture(checked, entries)
}

/// Capture the direct checker-returned root type for every retained
/// expression-bearing statement. Marker or alignment failures are hidden as
/// None so no partial observation escapes.
export fn check_program_statement_root_type_observation(stmts: Array[Stmt]) -> Option[CheckedStatementRootTypeObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_type_defs_observation_impl(stmts, Some(StatementRootTypes(entries)), None).checked_program
  statement_root_type_observation_from_capture(checked, entries)
}

/// Append-time role/lane capture. Failure or an alignment mismatch is hidden as
/// None, so no partial observation can escape.
export fn check_program_typed_occurrence_role_lane_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceRoleLaneObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(entries)).checked_program
  typed_occurrence_role_lane_observation_from_capture(checked, entries)
}

/// Complete-or-none structural expression-path provenance. Synthetic rewrites
/// and auxiliary resume-value rechecks deliberately make this return None.
export fn check_program_typed_occurrence_expression_path_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceExpressionPathObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(entries)).checked_program
  typed_occurrence_expression_path_observation_from_capture(checked, entries)
}

/// Opt-in complete direct-primary return observation. The bounded retained
/// skeleton is preflighted before checking; unsupported routes return None only
/// after a successful ordinary checker run.
export fn check_program_direct_expression_return_observation(stmts: Array[Stmt]) -> Option[CheckedDirectExpressionReturnObservation] with Exception {
  match checked_expression_structure_rows(stmts) {
    None => None,
    Some(_) => {
      let capture = direct_expression_return_capture()
      let checked = check_program_type_defs_observation_impl(stmts, Some(StatementDirectExpressionReturns), Some(capture)).checked_program
      direct_expression_return_observation_from_capture(checked, capture)
    }
  }
}

/// Successful production-check result, preserving the original public shape.
export fn check_program_result(stmts: Array[Stmt]) -> CheckedProgram with Exception {
  check_program_type_defs_observation_impl(stmts, None, None).checked_program
}

/// ONE process-wide entries-only capture for the Double observations, reset
/// before every use. A fresh capture per module made the bump high-water grow
/// with the SUM of every module's typed occurrences; truncating and reusing
/// the same backing arrays bounds it by the LARGEST module instead, which is
/// what keeps the wasm32 CLI-core build (already within a few MB of the 4GB
/// linear-memory ceiling) standing. The wave loop runs module checks
/// serially, and every consumer copies its answer out before the next reset.
let shared_double_call_capture: TypedOccurrenceRoleLaneCapture = double_call_result_role_lane_capture()

export fn reset_double_call_capture() -> TypedOccurrenceRoleLaneCapture {
  let capture = shared_double_call_capture
  Array::truncate(capture.entries, 0)
  Array::truncate(capture.entries_flags, 0)
  Array::truncate(capture.binop_offsets, 0)
  Array::truncate(capture.binop_kinds, 0)
  Array::truncate(capture.binop_types, 0)
  Array::truncate(capture.provenance_entries, 0)
  Array::truncate(capture.statement_path, 0)
  Array::truncate(capture.frame_paths, 0)
  Array::truncate(capture.frame_next_children, 0)
  Array::truncate(capture.frame_expected_children, 0)
  Array::truncate(capture.frame_direct_recorded, 0)
  Array::truncate(capture.direct_entries, 0)
  capture.frame_depth = 0
  capture.complete = true
  capture
}

fn double_call_result_role_lane_capture() -> TypedOccurrenceRoleLaneCapture {
  TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    // Entries-only: the Double observation reads (role, lane) aligned with
    // typed_occurrences and nothing else, so the per-expression path and
    // per-occurrence provenance allocation stays off. Run once per module
    // across a compiler-sized closure, that allocation tripped the CI
    // selfcompile KPI heap gate (see the struct field's note).
    provenance_enabled: false,
    frame_depth: 0,
    complete: true
  }
}

/// Shared extraction half of the #2158 observation: retain only source-located
/// primary call results whose checker-confirmed instantiated type is Double,
/// plus the two counts that say whether the AST was located at all. `None`
/// means the capture did not line up with the typed occurrences and nothing
/// can be classified. Reads the entries-only FLAG array (one Int per
/// occurrence; see the struct's entries_flags note), not the role/lane
/// tuples -- the Double captures run with provenance_enabled = false.
export fn double_call_result_offsets_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> Option[(Array[Int], Int, Int)] {
  if Array::length(capture.entries_flags) != Array::length(checked.typed_occurrences) {
    None
  } else {
    let out: Array[Int] = []
    let mut primary_calls = 0
    let mut located_primary_calls = 0
    let mut i = 0
    while i < Array::length(checked.typed_occurrences) {
      let (off, raw_ty) = Array::get(checked.typed_occurrences, i)
      // The primary-call-result test comes FIRST, and the type query is the
      // cheap head form. Both are about cost, and the cost is not
      // incidental: this loop used to resolve EVERY typed occurrence through
      // `subst_apply`, which rebuilds the whole substituted type, and then
      // throw all but the head away. On a single file that is invisible; on
      // a merged program it is quadratic, because `subst_lookup` walks a
      // substitution that grows with the program. Measured on
      // `lib/@vibe/compiler/tests/compiler_fs_test.vibe` (import closure:
      // the whole compiler), compiling it went 6.1s -> 77.5s with the old
      // shape and back to a small delta with this one.
      if Array::get(capture.entries_flags, i) == 1 {
        primary_calls = primary_calls + 1
        if off >= 0 {
          located_primary_calls = located_primary_calls + 1
          if subst_resolves_to_double(checked.final_subst, raw_ty) {
            let mut seen = false
            let mut j = 0
            while j < Array::length(out) {
              if Array::get(out, j) == off {
                seen = true
                j = Array::length(out)
              } else {
                j = j + 1
              }
            }
            if !seen {
              Array::push(out, off)
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    // #2427 second pass: which of those candidate offsets is ALSO claimed by
    // a primary call that is NOT a Double.
    //
    // Pass 1 above is byte-for-byte the original loop, so a program with no
    // Double call result allocates nothing new and does no extra work -- the
    // block below is skipped entirely. That property is the point: Codex
    // round 1 on this PR replaced the dedup with a linear scan over a key
    // list holding EVERY primary call, which was quadratic on the minified
    // bundle and quadratic even with no Double present. The comment above
    // records what a quadratic costs in this exact loop: 6.1s -> 77.5s on
    // one file.
    //
    // Round 2 caught the sequel: the first repair sorted the non-Double
    // offsets, and `irc_sorted_unique` is an INSERTION sort whose own comment
    // says it is sized for a small candidate set. So the sorted side is the
    // SMALL one -- one entry per distinct Double offset, already deduplicated
    // by the same O(D^2) scan the original ran -- and the large side is
    // scanned against it.
    //
    // The offset test comes FIRST and the type resolution second, for the
    // same reason pass 1 orders them that way: a binary search is cheap and
    // `subst_resolves_to_double` is not, so the resolution runs only for the
    // occurrences that sit at a candidate offset. Nothing is accumulated in
    // between -- an earlier cut collected every non-Double offset into an
    // array, which the CI perf report priced at +0.20% selfcompile heap.
    let kept = if Array::length(out) == 0 {
      out
    } else {
      let sorted_doubles = irc_sorted_unique(out)
      let poisoned: Array[Bool] = []
      let mut d = 0
      while d < Array::length(sorted_doubles) {
        Array::push(poisoned, false)
        d = d + 1
      }
      let mut p = 0
      while p < Array::length(checked.typed_occurrences) {
        let (poff, praw) = Array::get(checked.typed_occurrences, p)
        if Array::get(capture.entries_flags, p) == 1 && poff >= 0 {
          let idx = irc_index_of(sorted_doubles, poff)
          if idx >= 0 && !subst_resolves_to_double(checked.final_subst, praw) {
            Array::set(poisoned, idx, true)
          } else {
            ()
          }
        } else {
          ()
        }
        p = p + 1
      }
      // Emitted in `out`'s original first-seen order, not the sorted one: the
      // sort exists for the lookup, and reordering the published table would
      // be an unrelated behavioural change to everything downstream of it.
      let keep: Array[Int] = []
      let mut k = 0
      while k < Array::length(out) {
        let off = Array::get(out, k)
        if !Array::get(poisoned, irc_index_of(sorted_doubles, off)) {
          Array::push(keep, off)
        } else {
          ()
        }
        k = k + 1
      }
      keep
    }
    Some((kept, primary_calls, located_primary_calls))
  }
}

/// #2391 slice 2: extract the String binop tables from the capture's side
/// arrays. Rows come in consecutive PAIRS -- one binop pushes its left and
/// right operand types under the same (anchor, kind) -- and a binop
/// classifies as String when EITHER type resolves to String under the final
/// substitution: the same either-operand rule as the desugar tracker, but
/// answered by the checker. Returns (relational anchors, `+` anchors).
///
/// An anchor claimed by MORE THAN ONE binop of the same kind is kept only
/// when every claimant classifies the same way, and POISONED otherwise
/// (Codex round 1 on #2429): the rewrite pass rewrites every same-kind binop
/// at a matching anchor, which is correct exactly when the claimants agree.
/// The channel anchor already refuses to descend into sequence/match
/// operands, so a disagreeing collision needs a shape the checker tolerates
/// with mixed types -- the poison turns any such residue into a degrade
/// (syntactic classifiers), never a wrong rewrite.
export fn string_binop_offsets_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> (Array[Int], Array[Int]) {
  let rels: Array[Int] = []
  let pluses: Array[Int] = []
  let keys: Array[Int] = []
  let verdicts: Array[Int] = []
  let poisoned: Array[Bool] = []
  let n = Array::length(capture.binop_offsets)
  let mut i = 0
  while i + 1 < n {
    let off = Array::get(capture.binop_offsets, i)
    let kind = Array::get(capture.binop_kinds, i)
    // Kind 3 (`==` / `!=`, #2441) shares the capture arrays but has its own
    // extraction (eq_binop_type_keys_from_capture below); the String tables
    // read only the relational/`+` kinds.
    if kind == 1 || kind == 2 {
      let is_string = subst_resolves_to_string(checked.final_subst, Array::get(capture.binop_types, i)) || subst_resolves_to_string(checked.final_subst, Array::get(capture.binop_types, i + 1))
      let key = off * 4 + kind
      let verdict = if is_string {
        1
      } else {
        0
      }
      let mut idx = 0 - 1
      let mut k = 0
      while k < Array::length(keys) {
        if Array::get(keys, k) == key {
          idx = k
          k = Array::length(keys)
        } else {
          k = k + 1
        }
      }
      if idx < 0 {
        Array::push(keys, key)
        Array::push(verdicts, verdict)
        Array::push(poisoned, false)
      } else if Array::get(verdicts, idx) != verdict {
        Array::set(poisoned, idx, true)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 2
  }
  let mut out_i = 0
  while out_i < Array::length(keys) {
    if Array::get(verdicts, out_i) == 1 && !Array::get(poisoned, out_i) {
      let key = Array::get(keys, out_i)
      let off = key / 4
      if key - off * 4 == 1 {
        Array::push(rels, off)
      } else {
        Array::push(pluses, off)
      }
    } else {
      ()
    }
    out_i = out_i + 1
  }
  (rels, pluses)
}

/// #2441: the checker `Type` of a `==`/`!=` operand, lowered to the surface
/// `TypeExpr` grammar the `==` desugar's `eq_for_typed` consumes. `None`
/// means the type cannot ride the channel -- a variable, a function, a
/// forall, a record, a compiler-internal `#hkt`/`#ctor.` spelling -- and the
/// row is simply absent (the syntactic classifiers stay in charge, which is
/// today's behavior; absent, never wrong).
export fn eq_channel_type_expr(ty: Type) -> Option[TypeExpr] {
  eq_channel_type_expr_impl(ty, None)
}

/// #3283: the `==` row extraction's lowering. It differs from
/// `eq_channel_type_expr` in exactly one place: a TYPE ARGUMENT of a named
/// type that is still an unresolved inference variable against the final
/// substitution is lowered to `Unit` instead of dropping the whole row.
///
/// `let a = Ok([1, 2])` types as `Res[Array[Int], e]`, and nothing in the
/// program ever constrains `e`. Dropping the row for that left `a == b` to the
/// syntactic classifiers, whose `Ok` / `Err` match compares an `Array` payload
/// by identity: two equal values answered `false` (measured on main at
/// `ac8f8cc`). An unconstrained variable has no value in the operands -- a
/// generalized `Res[Array[Int], e]` cannot hold an `Err`, there is no `e` to
/// put in it -- so the comparator that position gets is dead code, and `Unit`
/// (a raw `==`, which is also what that payload compared with before) is as
/// good as any type. The cases where a value of such a variable CAN exist (a
/// let-polymorphic lambda's own parameter) keep that same raw `==` for the
/// position and gain the typed comparator for every other one.
///
/// What is NOT filled in:
///   - a FORMAL of an enclosing binder (`T` of `fn f[T: Eq]`): it has values,
///     and its comparator is the witness, never `Unit`. `eq_formal_row_of`
///     reads the table the check that produced this capture filled; an id
///     collision only makes a variable look like a formal, which keeps the row
///     absent.
///   - a variable anywhere else: an `Array` element, an `Option` payload, a
///     tuple slot, or the whole operand. Those already have their own rungs
///     (the untyped-empty arm, `opt_eq_match`, the tuple walk) and keep them.
///   - a head whose declaration is not in `defs`: the parameter's arity is
///     read from the head's own declaration (`type_param_arity` of its
///     `params` key), and without one there is nothing to read.
///
/// #3288: an argument whose declared parameter is a type CONSTRUCTOR (`F` of
/// `enum R[T, F[_]]`) is filled with `Unit` too, read as the CONSTANT
/// constructor of that arity: the desugar's substitution turns the payload
/// `F[Int]` into `Unit` (`eq_subst_ty`), so the position compares with the
/// same raw `==` the arity-0 fill gives it, and by the same argument it is
/// dead code. Before this the row stayed absent there and the comparison fell
/// to the derived `R::equals`, whose `T` payload compares an aggregate by
/// identity.
///
/// `Unit` has the wrong kind for `F`, and the generated comparator's
/// signature says `R[Array[Int], Unit]`. That is tolerated because it lives
/// only in generated comparators, which are not type-checked again: an
/// application of `F` becomes `Unit`, and `F` passed on unapplied
/// (`Phantom[F]`, Codex on #3296) or through an alias reaches the same
/// substitution one declaration further down. A kind-correct placeholder
/// would have to be a real constructor, and that is unsound: a lambda
/// let-generalized over `F` holds live `F[Int]` values while `F` stays free
/// here, so `Array` would compare an `Option` as an array. `Unit` keeps that
/// position's raw `==`, which is what it compared with before (measured: still
/// `false` for two equal arrays there). Declining the row instead would
/// restore the identity answer for every other position.
/// `fixtures/structural_eq_kinded_ctor_arg_test.vibe` pins that generation
/// succeeds for all three routes.
fn eq_channel_row_type_expr(ty: Type, defs: Array[TypeDef]) -> Option[TypeExpr] {
  eq_channel_type_expr_impl(ty, Some(defs))
}

/// `fill_defs`: `None` lowers every variable to an absent row; `Some(defs)`
/// fills a free type argument as `eq_channel_row_type_expr` describes.
fn eq_channel_type_expr_impl(ty: Type, fill_defs: Option[Array[TypeDef]]) -> Option[TypeExpr] {
  match ty {
    CtInt => Some(TyName("Int")),
    CtDouble => Some(TyName("Double")),
    CtBool => Some(TyName("Bool")),
    CtString => Some(TyName("String")),
    CtChar => Some(TyName("Char")),
    CtBytes => Some(TyName("Bytes")),
    CtUnit => Some(TyUnit),
    CtTuple(items) => match eq_channel_type_exprs(items, fill_defs) {
      Some(out) => Some(TyTuple(out)),
      None => None
    },
    CtArray(t) => match eq_channel_type_expr_impl(t, fill_defs) {
      Some(inner) => Some(TyApp("Array", [inner])),
      None => None
    },
    CtOption(t) => match eq_channel_type_expr_impl(t, fill_defs) {
      Some(inner) => Some(TyApp("Option", [inner])),
      None => None
    },
    CtEnum(n) => if String::starts_with(n, "#") {
      None
    } else {
      Some(TyName(n))
    },
    CtStruct(n) => if String::starts_with(n, "#") {
      None
    } else {
      Some(TyName(n))
    },
    CtNamed(n, args) => if String::starts_with(n, "#") {
      None
    } else if Array::length(args) == 0 {
      Some(TyName(n))
    } else {
      match eq_channel_type_args(n, args, fill_defs) {
        Some(out) => Some(TyApp(n, out)),
        None => None
      }
    },
    CtApplied(head, args) => {
      let head_name = match head {
        CtEnum(n) => n,
        CtStruct(n) => n,
        CtNamed(n, hargs) => if Array::length(hargs) == 0 {
          n
        } else {
          ""
        },
        _ => ""
      }
      if String::length(head_name) == 0 || String::starts_with(head_name, "#") {
        None
      } else {
        match eq_channel_type_args(head_name, args, fill_defs) {
          Some(out) => Some(TyApp(head_name, out)),
          None => None
        }
      }
    },
    _ => None
  }
}

/// The type arguments of the named head `head`. With `fill_defs`, an
/// unresolved non-formal variable whose head's declaration is known lowers to
/// `Unit` (see `eq_channel_row_type_expr`); everything else lowers as any
/// other position does.
///
/// #3288: a type CONSTRUCTOR argument (`Option` in `R[Array[Int], Option]`)
/// lowers to its bare name, which the desugar substitutes as the head of the
/// payload's application (`F[Int]` becomes `Option[Int]`). It is lowered only
/// here: a constructor is never a whole operand type.
fn eq_channel_type_args(head: String, args: Array[Type], fill_defs: Option[Array[TypeDef]]) -> Option[Array[TypeExpr]] {
  let out: Array[TypeExpr] = []
  let mut i = 0
  let mut ok = true
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    let lowered = match arg {
      CtVar(vid) => match fill_defs {
        Some(defs) => if eq_formal_row_of(vid) < 0 && eq_declared_param_arity(defs, head, i) >= 0 {
          Some(TyUnit)
        } else {
          None
        },
        None => None
      },
      CtConstructor(n, _) => if String::starts_with(n, "#") {
        None
      } else {
        Some(TyName(n))
      },
      _ => eq_channel_type_expr_impl(arg, fill_defs)
    }
    match lowered {
      Some(te) => Array::push(out, te),
      None => {
        ok = false
        i = Array::length(args)
      }
    }
    i = i + 1
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// The arity of the `index`th type parameter of the enum or struct `head`
/// declares, or -1 when `defs` holds no such declaration or parameter.
fn eq_declared_param_arity(defs: Array[TypeDef], head: String, index: Int) -> Int {
  let mut out = 0 - 1
  let mut i = 0
  while i < Array::length(defs) {
    let params = match Array::get(defs, i) {
      TDEnum(n, ps, _) => if n == head {
        Some(ps)
      } else {
        None
      },
      TDStruct(n, _, _, ps) => if n == head {
        Some(ps)
      } else {
        None
      },
      _ => None
    }
    match params {
      Some(ps) => {
        if index < Array::length(ps) {
          out = type_param_arity(Array::get(ps, index))
        } else {
          ()
        }
        i = Array::length(defs)
      },
      None => {
        i = i + 1
      }
    }
  }
  out
}

fn eq_channel_type_exprs(items: Array[Type], fill_defs: Option[Array[TypeDef]]) -> Option[Array[TypeExpr]] {
  let out: Array[TypeExpr] = []
  let mut i = 0
  let mut ok = true
  while i < Array::length(items) {
    match eq_channel_type_expr_impl(Array::get(items, i), fill_defs) {
      Some(te) => Array::push(out, te),
      None => {
        ok = false
        i = Array::length(items)
      }
    }
    i = i + 1
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// #2441: a channel row is worth carrying only for aggregates (and Double,
/// whose `eq_for_typed` form routes codegen onto the f64 unbox-compare
/// path). Scalars answer correctly on the raw lowering already -- `Int`/
/// `Bool`/`Char` compare by value, `String` content-compares in the runtime
/// `eq` -- and a function type never compares.
fn eq_channel_type_expr_is_scalar(te: TypeExpr) -> Bool {
  match te {
    TyUnit => true,
    TyFn(_, _, _) => true,
    TyName(n) => n == "Int" || n == "Bool" || n == "Char" || n == "String" || n == "Unit",
    _ => false
  }
}

/// #2441: extract the typed-`==` rows from the capture's kind-3 pairs --
/// `(anchor offset, impl_target_key of the resolved operand TypeExpr)`, in
/// this module's own offset space. A row survives only when BOTH operand
/// types resolve (against the final substitution) to the SAME serializable
/// aggregate TypeExpr; an anchor claimed twice with different keys is
/// poisoned and dropped, mirroring the String extraction above -- a
/// generic function checked at two instantiations legitimately disagrees
/// with itself, and the degrade is the syntactic classifiers, never a
/// wrong comparator.
export fn eq_binop_type_keys_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> (Array[Int], Array[String]) {
  let offs: Array[Int] = []
  let keys: Array[String] = []
  let poisoned: Array[Bool] = []
  let n = Array::length(capture.binop_offsets)
  let mut i = 0
  while i + 1 < n {
    let off = Array::get(capture.binop_offsets, i)
    let kind = Array::get(capture.binop_kinds, i)
    if kind == 3 {
      let lte = eq_channel_row_type_expr(subst_apply(checked.final_subst, Array::get(capture.binop_types, i)), checked.type_defs)
      let rte = eq_channel_row_type_expr(subst_apply(checked.final_subst, Array::get(capture.binop_types, i + 1)), checked.type_defs)
      let row_key = match (lte, rte) {
        (Some(lt), Some(rt)) => if eq_channel_type_expr_is_scalar(lt) {
          ""
        } else {
          let lk = impl_target_key(lt)
          let rk = impl_target_key(rt)
          if lk == rk {
            lk
          } else {
            ""
          }
        },
        _ => ""
      }
      // An unresolvable pair records an EMPTY key rather than being skipped:
      // the rewrite lowers a shared (possibly generic) body exactly once, so
      // an anchor that resolves in one check and not in another must degrade
      // to the syntactic classifiers, exactly like two different keys.
      let mut idx = 0 - 1
      let mut k = 0
      while k < Array::length(offs) {
        if Array::get(offs, k) == off {
          idx = k
          k = Array::length(offs)
        } else {
          k = k + 1
        }
      }
      if idx < 0 {
        Array::push(offs, off)
        Array::push(keys, row_key)
        Array::push(poisoned, false)
      } else if Array::get(keys, idx) == row_key {
        ()
      } else {
        Array::set(poisoned, idx, true)
      }
    } else {
      ()
    }
    i = i + 2
  }
  let out_offs: Array[Int] = []
  let out_keys: Array[String] = []
  let mut out_i = 0
  while out_i < Array::length(offs) {
    if !Array::get(poisoned, out_i) && String::length(Array::get(keys, out_i)) > 0 {
      Array::push(out_offs, Array::get(offs, out_i))
      Array::push(out_keys, Array::get(keys, out_i))
    } else {
      ()
    }
    out_i = out_i + 1
  }
  (out_offs, out_keys)
}

//# #3133: index receiver rows

/// #3133: the checker's verdict on one index receiver, against the final
/// substitution: `typed_index_map_verdict()` for a Map (directly or through a
/// type alias), `typed_index_open_verdict()` for a type that is still a
/// variable -- an unresolved inference variable or an erased type parameter,
/// either of which may be a Map at run time -- and "" for anything else, which
/// is array indexing whatever it turns out to be. Follows the variable chain
/// only (the `subst_resolves_to_double` cost contract): the head decides.
fn index_receiver_verdict(checked: CheckedProgram, ty: Type, unknown_is_open: Bool) -> String {
  let mut cur = ty
  let seen: Array[Int] = []
  let mut verdict = typed_index_open_verdict()
  let mut done = false
  let mut alias_depth = 0
  while !done {
    match cur {
      CtVar(vid) => if index_receiver_seen(seen, vid) {
        done = true
      } else {
        Array::push(seen, vid)
        match subst_lookup(checked.final_subst, vid) {
          Some(next) => {
            cur = next
          },
          None => {
            done = true
          }
        }
      },
      CtUnknown => {
        if !unknown_is_open {
          verdict = ""
        } else {
          ()
        }
        done = true
      },
      CtForAll(_, _, _) => {
        done = true
      },
      CtApplied(head, _) => match head {
        CtNamed(hn, _) => if hn == "Map" || hn == "StringMap" {
          verdict = typed_index_map_verdict()
          done = true
        } else {
          verdict = ""
          done = true
        },
        _ => {
          done = true
        }
      },
      CtNamed(n, _) => if n == "Map" || n == "StringMap" {
        verdict = typed_index_map_verdict()
        done = true
      } else if String::starts_with(n, "#hktformal.") {
        done = true
      } else {
        // A type alias names its body; anything else is a declared nominal,
        // which is not a Map.
        match index_receiver_alias_body(checked.type_defs, n) {
          Some(body) => if alias_depth < 16 {
            alias_depth = alias_depth + 1
            cur = body
          } else {
            done = true
          },
          None => {
            verdict = ""
            done = true
          }
        }
      },
      _ => {
        verdict = ""
        done = true
      }
    }
  }
  verdict
}

fn index_receiver_seen(seen: Array[Int], vid: Int) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(seen) && !hit {
    hit = Array::get(seen, i) == vid
    i = i + 1
  }
  hit
}

fn index_receiver_names_have(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(names) && !hit {
    hit = Array::get(names, i) == name
    i = i + 1
  }
  hit
}

fn index_receiver_alias_body(defs: Array[TypeDef], name: String) -> Option[Type] {
  let mut i = 0
  let mut found = None
  while i < Array::length(defs) {
    match Array::get(defs, i) {
      TDAlias(an, params, body) => if an == name {
        // An alias whose body is one of its own parameters says nothing
        // about the head: stay open.
        found = match body {
          CtNamed(bn, bargs) => if Array::length(bargs) == 0 && index_receiver_names_have(params, bn) {
            Some(CtUnknown)
          } else {
            Some(body)
          },
          _ => Some(body)
        }
        i = Array::length(defs)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

/// #3133: the index rows for the typed-`==` channel -- `(bracket offset,
/// impl_target_key(#index[<verdict>]))` for every recorded index receiver
/// whose verdict is Map or open. A receiver the checker typed as anything
/// else files nothing: the index is array indexing and the pass leaves it.
/// An offset claimed by checks that disagree (one shared generic body seen at
/// two types) is OPEN, because the body is lowered once and cannot be both.
/// Rows are kept sorted by offset; the capture visits sites in source order,
/// so the insertion is an append in the common case.
export fn index_receiver_rows_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> (Array[Int], Array[String]) {
  receiver_rows_from_capture(checked, capture, false)
}

/// #3148: the same extraction for the `for` iterand rows (kind 7), under
/// `typed_forin_row_head()`. A bare `CtUnknown` iterand is not open, as for
/// an Array reader (#3145).
export fn forin_receiver_rows_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> (Array[Int], Array[String]) {
  receiver_rows_from_capture(checked, capture, true)
}

fn receiver_rows_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture, forin: Bool) -> (Array[Int], Array[String]) {
  let offs: Array[Int] = []
  let verdicts: Array[String] = []
  let n = Array::length(capture.binop_offsets)
  let mut i = 0
  while i + 1 < n {
    let kind = Array::get(capture.binop_kinds, i)
    let wanted = if forin {
      kind == 7 || kind == 8
    } else {
      kind == 4 || kind == 5 || kind == 6
    }
    if wanted {
      let off = Array::get(capture.binop_offsets, i)
      // #3145: a builtin Array reader (kind 5) is refused only for a type
      // VARIABLE -- an erased formal, or a generalised lambda's parameter.
      // A bare `CtUnknown` there is the checker declining to type an
      // expression it could (a `None` match arm, an untyped builtin result),
      // not a value that can be anything at run time; the self-build meets
      // one in `checker_effects.vibe` (`Array::length(callee_effs)`).
      // Kind 6 is a declared formal the fast path bound (`record_array_receiver`);
      // kind 8 is a declared formal used as a `for` iterand (#3148).
      // #3149: unless the formal's scheme already constrains every caller.
      let v = if kind == 6 || kind == 8 {
        match Array::get(capture.binop_types, i) {
          CtVar(fv) => if scheme_formal_constrained(fv) {
            ""
          } else {
            typed_index_open_verdict()
          },
          _ => typed_index_open_verdict()
        }
      } else {
        index_receiver_verdict(checked, Array::get(capture.binop_types, i), kind == 4)
      }
      let mut lo = 0
      let mut hi = Array::length(offs)
      while lo < hi {
        let mid = (lo + hi) / 2
        if Array::get(offs, mid) < off {
          lo = mid + 1
        } else {
          hi = mid
        }
      }
      if lo < Array::length(offs) && Array::get(offs, lo) == off {
        if Array::get(verdicts, lo) != v {
          Array::set(verdicts, lo, typed_index_open_verdict())
        } else {
          ()
        }
      } else {
        Array::push(offs, off)
        Array::push(verdicts, v)
        let mut j = Array::length(offs) - 1
        while j > lo {
          Array::set(offs, j, Array::get(offs, j - 1))
          Array::set(verdicts, j, Array::get(verdicts, j - 1))
          j = j - 1
        }
        Array::set(offs, lo, off)
        Array::set(verdicts, lo, v)
      }
    } else {
      ()
    }
    i = i + 2
  }
  let out_offs: Array[Int] = []
  let out_keys: Array[String] = []
  let mut k = 0
  while k < Array::length(offs) {
    let v = Array::get(verdicts, k)
    if String::length(v) > 0 {
      Array::push(out_offs, Array::get(offs, k))
      Array::push(out_keys, impl_target_key(TyApp(if forin {
        typed_forin_row_head()
      } else {
        typed_index_row_head()
      }, [TyName(v)])))
    } else {
      ()
    }
    k = k + 1
  }
  (out_offs, out_keys)
}

//# #2424: Int render/equality argument offsets

/// #2424: does `ty` resolve to `Int` under `s`, WITHOUT building the
/// substituted type?
///
/// The Double twin (`subst_resolves_to_double`, core/types.vibe) carries the
/// full argument for why this is a variable-chain walk rather than
/// `subst_apply`: asked once per candidate on a merged program, the rebuild
/// dominated everything -- 6.1s to 77.5s measured on the compiler's own import
/// closure. `CtInt` takes no arguments, so a type that is not already `CtInt`
/// at its head cannot become one by substituting inside it, and following the
/// variable chain is the whole job. Cycle handling matches `subst_apply`'s: a
/// variable already seen ends the walk instead of looping.
///
/// Local rather than a sibling export next to `subst_resolves_to_double`: it
/// has exactly one caller, in this file.
///
/// #2462/#2464: `want_bool` swaps the accepted head from `CtInt` to `CtBool`.
/// One walk rather than two copies, because the walk is the delicate part --
/// the variable chain and its cycle guard -- and the head test is one line. A
/// second copy is how the Int channel and the Bool channel would come to
/// disagree about what "resolves to" means.
export fn irc_resolves_to_scalar(s: Subst, ty: Type, want_bool: Bool) -> Bool {
  let mut cur = ty
  let seen: Array[Int] = []
  let mut done = false
  let mut result = false
  while !done {
    match cur {
      CtInt => {
        result = !want_bool
        done = true
      },
      CtBool => {
        result = want_bool
        done = true
      },
      CtVar(vid) => {
        let mut sj = 0
        let mut already = false
        while sj < Array::length(seen) {
          if Array::get(seen, sj) == vid {
            already = true
          } else {
            ()
          }
          sj = sj + 1
        }
        if already {
          done = true
        } else {
          Array::push(seen, vid)
          match subst_lookup(s, vid) {
            Some(next) => {
              cur = next
            },
            None => {
              done = true
            }
          }
        }
      },
      _ => {
        done = true
      }
    }
  }
  result
}

/// #2987 tag 6: does this occurrence's type have NO runtime rendering?
///
/// An argument that reaches codegen's `__to_string` lowering unexpanded is
/// printed by a heuristic that knows two representations -- a string pointer
/// and an Int. An `Option` / `Array` / tuple / `Bytes` / record value is
/// neither, so it printed its allocation address with no diagnostic
/// (#2970, #2986, #2987, #2991, #2998). Normalize expands the shapes it can
/// resolve into a structural render before codegen, so what still arrives here
/// is exactly the set it could not resolve, and the only honest answer left is
/// a refusal. Only these heads: a nominal type can be an opaque wrapper over a
/// scalar, which the heuristic does print correctly, and a function type is
/// left out because a call key is its callee's offset, where the callee's own
/// `CtFn` occurrence also sits.
export fn irc_resolves_to_unrenderable(s: Subst, ty: Type) -> Bool {
  match subst_apply(s, ty) {
    CtOption(_) => true,
    CtArray(_) => true,
    CtTuple(_) => true,
    CtBytes => true,
    CtRecord(_) => true,
    _ => false
  }
}

/// The builtins whose argument codegen must know the type of: the renderer
/// (both spellings) and the untyped equality. `\{...}` interpolation is
/// already `__to_string` HERE -- the parser builds the call
/// (`parser_expr_primary.vibe`), so a per-module check sees it, which is what
/// makes this walk usable on the FS lane where interpolation is otherwise
/// expanded only on the merged program.
///
/// #2468: `shims` carries the program's generic **Show wrapper**s. The lowering
/// treats a call to one exactly like `__to_string` (`is_show_shim_call`,
/// normalize/desugar_trait_dict.vibe), so an argument reaching the renderer
/// through `to_string(x)` needs the same row as one reaching it directly.
/// Without them, measured on `lib/@vibe/builtin/builtin_traits_test.vibe`, the
/// two spellings of one render disagreed:
///
///   __to_string(l())  ->  "true"      to_string(l())  ->  "1"
fn irc_is_render_callee(n: String, shims: Int) -> Bool {
  n == "__to_string" || n == "Int::to_string" || n == "eq" || irc_shim_stamped(n, shims)
}

/// #2386: the shim names of a walk, as stamps in one process-wide map.
/// `shims` carries every imported and re-exported local name (see
/// irc_show_shim_names), so on a module with a wide import surface the
/// per-call-site membership test was a scan of that whole list, with no
/// early exit, for each tag walk -- 130 ms of a cold self-compile. A set per
/// walk answered as fast but cost 4 MB of the self-compile's heap on the
/// bump lane (one table per module per walk, never freed); stamping the
/// names into one map with a per-walk generation shares an entry across
/// every module that imports the same name. The generation is what keeps
/// walks apart: a name stamped for the previous module must not count as a
/// wrapper of this one. The map is dropped past 65536 names for a resident
/// compiler.
let irc_shim_stamp: Array[MutMap[String, Int]] = [MutMap::new_string()]

let irc_shim_gen: Array[Int] = [0]

/// Stamp `names` for a new walk; the walk's generation is the answer.
export fn irc_shim_set(names: Array[String]) -> Int {
  if MutMap::size(Array::get(irc_shim_stamp, 0)) > 65536 {
    Array::set(irc_shim_stamp, 0, MutMap::new_string())
  } else {
    ()
  }
  let gen = Array::get(irc_shim_gen, 0) + 1
  Array::set(irc_shim_gen, 0, gen)
  let stamp = Array::get(irc_shim_stamp, 0)
  let mut i = 0
  while i < Array::length(names) {
    MutMap::set(stamp, Array::get(names, i), gen)
    i = i + 1
  }
  gen
}

fn irc_shim_stamped(n: String, gen: Int) -> Bool {
  match MutMap::get(Array::get(irc_shim_stamp, 0), n) {
    Some(g) => g == gen,
    None => false
  }
}

/// Is `body` exactly `__to_string(<pname>)`? The shim's whole body.
///
/// Mirrors `is_bare_to_string_of` (normalize/desugar_trait_dict.vibe) rather
/// than importing it: the checker runs BEFORE that pass and cannot read the
/// `dtd_show_shims` it fills, so the producer has to answer the same question
/// for itself. The two are one edit apart, which is the cost of the phase
/// order; the shape is small enough to keep them honest.
fn irc_is_bare_to_string_of(body: Expr, pname: String) -> Bool {
  match body {
    ECall(bc, ba, _, _) => if Array::length(ba) == 1 {
      match bc {
        EIdent(cn, _) => if cn == "__to_string" {
          match Array::get(ba, 0) {
            EIdent(an, _) => an == pname,
            _ => false
          }
        } else {
          false
        },
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #2987: the render-argument keys inside the program's own top-level Show
/// shims. A shim's body is expanded at each CALL SITE, where the argument's
/// type is known (`fn f(t: (Int, String)) -> String { "\{t}" }` renders
/// `(1, a)` through `f((1, "a"))`), so the `__to_string(t)` left in the body is
/// not the render that runs. Tag 6 stands down there, the way
/// `check_interp_formal` does inside a shim body; the call site's own argument
/// is still filed.
export fn irc_shim_body_arg_offsets(stmts: Array[Stmt]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(stmts) {
    let value = match Array::get(stmts, i) {
      SLet(_, _, _, _, v) => Some(v),
      SFnDecl(_, _, v, _, _) => Some(v),
      _ => None
    }
    match value {
      Some(v) => if irc_is_show_shim_value(v) {
        match v {
          EFn(_, _, _, _, _, ECall(_, ba, _, _)) => Array::push(out, typed_lowering_arg_offset(Array::get(ba, 0))),
          _ => ()
        }
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  out
}

export fn irc_int_array_has(xs: Array[Int], v: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && !found {
    found = Array::get(xs, i) == v
    i = i + 1
  }
  found
}

/// A one-parameter function whose body is just `__to_string` of that parameter.
fn irc_is_show_shim_value(v: Expr) -> Bool {
  match v {
    EFn(_, _, ps, _, _, body) => if Array::length(ps) == 1 {
      let (pn, _) = Array::get(ps, 0)
      irc_is_bare_to_string_of(body, pn)
    } else {
      false
    },
    _ => false
  }
}

/// Classify source declarations and the selected dependency publication together.
/// Unknown dependency facts remain unknown when this module re-exports them.
/// Local declarations override imported spellings, including ordinary functions.
export fn irc_show_wrapper_facts(stmts: Array[Stmt], env: TypeEnv) -> (Array[String], Array[String]) {
  let status: MutMap[String, Int] = MutMap::new_string()
  let candidates: Array[String] = []
  match env_show_wrapper_facts(env) {
    Some((wrappers, unknown)) => {
      for name in wrappers {
        MutMap::set(status, name, 1)
        Array::push(candidates, name)
      }
      for name in unknown {
        MutMap::set(status, name, 2)
        Array::push(candidates, name)
      }
    },
    None => for statement in stmts {
      match statement {
        SImport(_, items) => {
          let names: Array[String] = []
          irc_push_bound_import_names(items, names)
          for name in names {
            MutMap::set(status, name, 2)
            Array::push(candidates, name)
          }
        },
        SReExport(_, items) => {
          let names: Array[String] = []
          irc_push_bound_import_names(items, names)
          for name in names {
            MutMap::set(status, name, 2)
            Array::push(candidates, name)
          }
        },
        _ => ()
      }
    }
  }
  for statement in stmts {
    match statement {
      SLet(_, _, name, _, value) => {
        let wrapper = irc_is_show_shim_value(value)
        if wrapper || MutMap::get(status, name) != None {
          MutMap::set(status, name, if wrapper {
            1
          } else {
            0
          })
        } else {
          ()
        }
        if wrapper {
          Array::push(candidates, name)
        } else {
          ()
        }
      },
      SFnDecl(_, name, value, _, _) => {
        let wrapper = irc_is_show_shim_value(value)
        if wrapper || MutMap::get(status, name) != None {
          MutMap::set(status, name, if wrapper {
            1
          } else {
            0
          })
        } else {
          ()
        }
        if wrapper {
          Array::push(candidates, name)
        } else {
          ()
        }
      },
      _ => ()
    }
  }
  let wrappers: Array[String] = []
  let unknown: Array[String] = []
  // Taking a candidate clears its status, so repeated imports/declarations do
  // not duplicate publication rows. The map belongs only to this query.
  for name in candidates {
    match MutMap::get(status, name) {
      Some(1) => Array::push(wrappers, name),
      Some(2) => Array::push(unknown, name),
      _ => ()
    }
    MutMap::set(status, name, 0)
  }
  (wrappers, unknown)
}

export fn irc_show_shim_names_with_env(stmts: Array[Stmt], env: TypeEnv) -> Array[String] {
  match env_show_wrapper_facts(env) {
    None => irc_show_shim_names(stmts),
    Some(_) => {
      let (wrappers, unknown) = irc_show_wrapper_facts(stmts, env)
      for name in unknown {
        Array::push(wrappers, name)
      }
      wrappers
    }
  }
}

/// The local names an import / re-export item list binds: the alias when there
/// is one, else the imported name.
fn irc_push_bound_import_names(items: Array[ImportItem], out: Array[String]) -> Unit {
  let mut j = 0
  while j < Array::length(items) {
    let item = Array::get(items, j)
    match item.alias {
      Some(alias) => Array::push(out, alias),
      None => Array::push(out, item.name)
    }
    j = j + 1
  }
}

/// #2468: the program's Show-wrapper names, from its top-level declarations.
///
/// Only the TOP level, and both statement spellings. `parse_program` and
/// `parse_program_located` lower `SFnDecl` to the `SLet` shape before anything
/// checks the program, so the `SFnDecl` arm is inert on every path that reaches
/// the checker today -- it is here so the walk does not depend on that
/// ordering, the same reason `irc_collect_stmts` keeps its `SExample` arm.
/// `collect_show_shims` (normalize) is the SLet arm alone for the same reason.
///
/// A shim declared inside a nested `module` is not collected. That is an
/// under-approximation, and the fail-closed direction: the call keeps the
/// syntactic answer it has today rather than getting a wrong one.
///
/// The normalize-pass twin also excludes a name shadowed by a local binder.
/// This one does not, and the omission is safe HERE for a reason that does not
/// hold there: these rows are TYPE facts, not render facts. An offset is
/// emitted only when every typed occurrence at it resolves to the wanted type,
/// so a row filed for an argument of some unrelated call is still a true
/// statement about that expression's type -- it can be inert, never wrong. The
/// rewrite pass has no such margin, because it REPLACES the call.
export fn irc_show_shim_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => if irc_is_show_shim_value(value) {
        Array::push(out, name)
      } else {
        ()
      },
      SFnDecl(_, fname, body, _, _) => if irc_is_show_shim_value(body) {
        Array::push(out, fname)
      } else {
        ()
      },
      // #2468 (Codex P1 on this PR): a wrapper the module IMPORTS -- the
      // prelude's `to_string` above all -- has its body in another file, which
      // this check cannot see. Measured before this arm, on the FS lane:
      //
      //   import ./builtin_traits.vibe { to_string }
      //   let l = () -> Bool { 1 < 2 }
      //   __to_string(l()) -> "true"      to_string(l()) -> "1"
      //
      // So every imported local name joins the set, without a shape test. That
      // is an OVER-approximation, and it is safe for the reason stated above:
      // a row is a TYPE fact, not a render fact. It says "the expression at
      // this offset resolved to Bool", which the agreement rule verified, and
      // codegen reads the table ONLY when it is lowering a render argument
      // (`bool_offset_says_bool` inside `cc_expr_is_boolish`, and its two
      // twins). A row filed for an ordinary imported call is therefore inert:
      // nothing looks it up. It can never be a wrong classification, because
      // there is no way for a true statement about an expression's type to
      // become one.
      //
      // The alternative -- resolving each imported name to its definition and
      // shape-testing it -- means carrying wrapper metadata across the module
      // boundary, and doing it in a way that survives a cache hit that skips
      // the dependency's check. Getting that wrong renders the same program
      // differently warm and cold, which is worse than an inert row. The
      // measured price of not having that metadata is +0.28% selfcompile
      // heap; the design is #2472.
      SImport(_, items) => irc_push_bound_import_names(items, out),
      // A re-export binds its items LOCALLY too, so the module can call them
      // (`collect_import_value_renames`, core/import_alias_rewrite.vibe,
      // handles `SReExport` alongside `SImport` for exactly that reason).
      // Codex P1 on this PR, measured before this arm:
      //
      //   export ./builtin_traits.vibe { to_string }
      //   let l = () -> Bool { 1 < 2 }
      //   __to_string(l()) -> "true"      to_string(l()) -> "1"
      //
      // The merged normalize pass still rewrites that call to `__to_string`,
      // so the consumer looks the argument's offset up and finds nothing --
      // the same silent "1" the `SImport` arm above exists to prevent, one
      // statement keyword away.
      SReExport(_, items) => irc_push_bound_import_names(items, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// `want` is the typed-lowering TAG being collected (3 = Int, 4 = Double,
/// 5 = Bool), and it picks the KEY, not just the type filter. The Int and Bool
/// channels key an argument by `typed_lowering_arg_offset`, which answers for a
/// bare name too; the Double channel must not, because its table also carries
/// call-result rows and a call node's offset is its callee identifier's offset
/// -- see `typed_lowering_float_key` (@vibe/compiler/core) for the whole
/// argument. Collecting under the key the consumer reads is the point: a
/// candidate filed under a key nobody looks up is not a wrong answer, it is
/// silence.
/// #2585: the key for one render argument -- its own if it has one, else its
/// JOIN ARMS'.
///
/// `typed_lowering_arg_offset` answers only for an ident, a call or a
/// projection, so a render argument that is an `if` / `match` / block had NO
/// key and this walk recorded nothing for it. The consumer then fell through to
/// the runtime string-pointer heuristic, which returns the operand unchanged
/// when `raw >> 32` lands in bounds -- rendering an Int at or above 2^37 as
/// bytes read from the static data section, silently, while the wasm-gc lane
/// printed the number.
///
/// The arms DO have keys and the checker has already typed them, so record
/// those instead. The descent mirrors `ts_known_int`'s (codegen/expr/
/// compile_call.vibe) exactly, including the binder rule: only the "body is
/// its own binder" shape is followed, and what it records is the binder's
/// VALUE, which is the expression the consumer classifies.
///
/// Neither side can answer WRONGLY if the two ever drift. A key recorded here
/// that the consumer does not descend into is inert -- nobody reads it. A shape
/// the consumer descends into that is not recorded here falls back to the
/// heuristic, which is the behaviour before this change. And an offset recorded
/// here survives `irc_render_arg_offsets_pair` only when EVERY typed occurrence
/// at it resolves to the wanted type, so recording a candidate can never
/// promote a non-Int.
/// #3081: the arg-offset keys of the ELEMENTS of a composite literal in
/// render-argument position, collected by `irc_push_arg_key` below and read by
/// `irc_render_arg_offsets_quad`, which truncates it before its own walk.
/// A render row filed at one of these may carry a SCALAR type as well: the
/// interpolation pass renders the element from the literal's shape, where a
/// scalar leaf it could not type went through the pointer heuristic.
export let irc_literal_item_keys: Array[Int] = []

/// #3081 review: how many composite-literal elements the key walk is inside.
/// An element that has no key of its own (`if` / `match` / a binder block)
/// hands the walk to its arms, and the keys found there are literal elements
/// as much as a directly keyed element is -- they are what the interpolation
/// pass renders from the literal's shape.
export let irc_literal_depth: Array[Int] = [0]

fn irc_push_arg_key(arg: Expr, out: Array[Int], want: Int) -> Unit {
  let aoff = if want == 4 {
    typed_lowering_float_key(arg)
  } else {
    typed_lowering_arg_offset(arg)
  }
  if aoff >= 0 {
    Array::push(out, aoff)
    if want != 4 && Array::get(irc_literal_depth, 0) > 0 {
      Array::push(irc_literal_item_keys, aoff)
    } else {
      ()
    }
  } else {
    match arg {
      EIf(_, t, f) => {
        irc_push_arg_key(t, out, want)
        irc_push_arg_key(f, out, want)
      },
      ESeq(_, second) => irc_push_arg_key(second, out, want),
      // #2585: the ARITHMETIC operands, for the same reason and by the same
      // rule as #2422's arm in `ts_known_int`: `+ - * /` resolve from their
      // operands, so a sum is an Int exactly when both sides are. That arm
      // reads slot kinds, which only know a `let` whose value codegen could
      // already see as intish -- so `let v = mk(xs); __to_string(v + 0)` was
      // silently wrong at >= 2^37 while the bare `__to_string(v)` beside it
      // was right, because the bare ident had a key and the sum had none.
      // Recording the operands' keys is what lets the existing recursion
      // answer. The other Int operators (`& | ^ << >> %`) are Int by the
      // checker's own rule whatever the operands are, so that arm never
      // reaches for a key and none is recorded for them.
      EBinOp(op, lhs, rhs, _) => if op == "+" || op == "-" || op == "*" || op == "/" {
        irc_push_arg_key(lhs, out, want)
        irc_push_arg_key(rhs, out, want)
      } else {
        ()
      },
      EMatch(_, arms) => irc_push_arm_keys(arms, out, want),
      // #3081: an array / tuple LITERAL has no key of its own, and the
      // interpolation pass renders it element by element from its SHAPE. An
      // element it cannot type (`[Some(k())]`, `(k(), 1)`) went through the
      // pointer heuristic -- `[Some(0)]` for `[Some(false)]` -- although the
      // checker had typed it. So its elements are candidates too, recursively
      // through nested literals.
      EArray(items) => irc_push_literal_item_keys(items, out, want),
      ETuple(items) => irc_push_literal_item_keys(items, out, want),
      ELet(nm, val, body, _) => irc_push_binder_key(nm, val, body, out, want),
      ELetRec(nm, val, body) => irc_push_binder_key(nm, val, body, out, want),
      ELetMut(nm, val, body, _) => irc_push_binder_key(nm, val, body, out, want),
      _ => ()
    }
  }
}

/// #3081: every element of a composite literal in render-argument position.
fn irc_push_literal_item_keys(items: Array[Expr], out: Array[Int], want: Int) -> Unit {
  Array::set(irc_literal_depth, 0, Array::get(irc_literal_depth, 0) + 1)
  let mut i = 0
  while i < Array::length(items) {
    irc_push_arg_key(Array::get(items, i), out, want)
    i = i + 1
  }
  Array::set(irc_literal_depth, 0, Array::get(irc_literal_depth, 0) - 1)
}

/// #2585: every arm body of a `match` in render-argument position.
///
/// No pattern filter here, deliberately: this side only proposes CANDIDATE
/// offsets, and the consumer refuses an arm whose pattern binds a name (it
/// resolves identifiers through `local_names`, which does not carry the arm's
/// own binders). An offset proposed for an arm the consumer will not read is
/// inert.
fn irc_push_arm_keys(arms: Array[(Pat, Expr)], out: Array[Int], want: Int) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, body) = Array::get(arms, i)
    irc_push_arg_key(body, out, want)
    i = i + 1
  }
}

/// #2585: a `let` / `let rec` / `let mut` in render-argument position, in the
/// one shape that is answerable without an environment -- the body is a single
/// identifier and the binder immediately above it binds that exact name, so the
/// binder's VALUE answers for the body. Deeper chains stay unrecorded, matching
/// the consumer.
fn irc_push_binder_key(name: String, value: Expr, body: Expr, out: Array[Int], want: Int) -> Unit {
  match body {
    EIdent(bn, _) => if bn == name {
      irc_push_arg_key(value, out, want)
    } else {
      ()
    },
    _ => ()
  }
}

fn irc_collect_expr(e: Expr, out: Array[Int], want: Int, shims: Int) -> Unit {
  // A projected field can be a Double operand of an ordinary arithmetic or
  // ordering expression, not only of a render call. The typed occurrence
  // agreement check below admits the key only when every claimant is Double.
  if want == 4 {
    match e {
      EDot(_, _, _, _) => {
        let off = typed_lowering_float_key(e)
        if off >= 0 {
          Array::push(out, off)
        } else {
          ()
        }
      },
      _ => ()
    }
  } else {
    ()
  }
  match e {
    ECall(callee, args, _, _) => match callee {
      EIdent(cn, _) => if irc_is_render_callee(cn, shims) {
        let mut ai = 0
        while ai < Array::length(args) {
          irc_push_arg_key(Array::get(args, ai), out, want)
          ai = ai + 1
        }
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    irc_collect_expr(expr_child_at(i), out, want, shims)
    i = i + 1
  }
  expr_children_pop(mark)
}

export fn irc_collect_stmts(stmts: Array[Stmt], out: Array[Int], want: Int, shims: Int) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, e) => irc_collect_expr(e, out, want, shims),
      SLetMut(_, _, e) => irc_collect_expr(e, out, want, shims),
      SLetPat(_, e) => irc_collect_expr(e, out, want, shims),
      SExpr(e) => irc_collect_expr(e, out, want, shims),
      STest(_, e) => irc_collect_expr(e, out, want, shims),
      SBench(_, e) => irc_collect_expr(e, out, want, shims),
      // `parse_program` lowers `SExample` to `STest` before anything checks
      // the program, so this arm is inert on every compile path today
      // (measured: a render of an `Array::get` result inside an `example`
      // block already answers correctly). It is here so the walk does not
      // depend on that ordering -- `parse_program_preserving` keeps the
      // variant, and an executable block form must not be silently skipped.
      SExample(_, e) => irc_collect_expr(e, out, want, shims),
      // A render inside a nested module is checked with the rest of the
      // program and its occurrences are in the same table, so skipping the
      // body would leave that code with no classification at all (Codex
      // review on #2434). `count_typed_lowering_offsets_stmts` recurses the same way.
      SModule(_, _, inner) => irc_collect_stmts(inner, out, want, shims),
      _ => ()
    }
    i = i + 1
  }
}

/// Insertion-sorted unique copy. The candidate set contains render/`eq`
/// arguments and, for the Double channel, field projections. Sorting keeps
/// the scan below off a quadratic path: one binary search per typed occurrence
/// instead of one linear membership test.
export fn irc_sorted_unique(xs: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(xs) {
    let v = Array::get(xs, i)
    let mut lo = 0
    let mut hi = Array::length(out)
    while lo < hi {
      let mid = (lo + hi) / 2
      if Array::get(out, mid) < v {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let dup = lo < Array::length(out) && Array::get(out, lo) == v
    if dup {
      ()
    } else {
      Array::push(out, v)
      let mut j = Array::length(out) - 1
      while j > lo {
        Array::set(out, j, Array::get(out, j - 1))
        j = j - 1
      }
      Array::set(out, lo, v)
    }
    i = i + 1
  }
  out
}

export fn irc_index_of(sorted: Array[Int], v: Int) -> Int {
  let mut lo = 0
  let mut hi = Array::length(sorted)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(sorted, mid) < v {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(sorted) && Array::get(sorted, lo) == v {
    lo
  } else {
    0 - 1
  }
}
