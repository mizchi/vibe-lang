//# Imports

import ../core {
  Type
}

import ../../../../lib/@vibe/core {
  array_empty
}

//# Functions

fn bytes_no_params() -> Array[Type] {
  array_empty()
}

fn bytes_one_param(a: Type) -> Array[Type] {
  let arr = bytes_no_params()
  Array::push(arr, a)
  arr
}

fn bytes_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn bytes_four_params(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  arr
}

fn bytes_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_bytes_get(name: String) -> Option[Type] {
  if name == "Bytes::get" {
    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtInt, None))
  }
  else None
}

fn lookup_bytes_new(name: String) -> Option[Type] {
  if name == "Bytes::new" {
    Some(CtFn(bytes_no_params(), CtBytes, None))
  }
  else None
}

fn lookup_bytes_set(name: String) -> Option[Type] {
  if name == "Bytes::set" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

fn lookup_bytes_blit(name: String) -> Option[Type] {
  if name == "Bytes::blit" {
    Some(CtFn(bytes_four_params(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

fn lookup_bytes_fill(name: String) -> Option[Type] {
  if name == "Bytes::fill" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

fn lookup_bytes_push(name: String) -> Option[Type] {
  if name == "Bytes::push" {
    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtUnit, None))
  }
  else None
}

fn lookup_bytes_slice(name: String) -> Option[Type] {
  if name == "Bytes::slice" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtBytes, None))
  }
  else None
}

fn lookup_bytes_append(name: String) -> Option[Type] {
  if name == "Bytes::append" {
    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtUnit, None))
  }
  else None
}

fn lookup_bytes_concat(name: String) -> Option[Type] {
  if name == "Bytes::concat" {
    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtBytes, None))
  }
  else None
}

fn lookup_bytes_length(name: String) -> Option[Type] {
  if name == "Bytes::length" {
    Some(CtFn(bytes_one_param(CtBytes), CtInt, None))
  }
  else None
}

fn lookup_bytes_group_a(name: String) -> Option[Type] {
  match lookup_bytes_new(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_length(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_get(name) {
        Some(t) => Some(t),
        None => lookup_bytes_set(name)
      }
    }
  }
}

fn lookup_bytes_group_b(name: String) -> Option[Type] {
  match lookup_bytes_push(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_concat(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_slice(name) {
        Some(t) => Some(t),
        None => lookup_bytes_append(name)
      }
    }
  }
}

fn lookup_bytes_to_array(name: String) -> Option[Type] {
  if name == "Bytes::to_array" {
    Some(CtFn(bytes_one_param(CtBytes), CtArray(CtInt), None))
  }
  else None
}

fn lookup_bytes_from_array(name: String) -> Option[Type] {
  if name == "Bytes::from_array" {
    Some(CtFn(bytes_one_param(CtArray(CtInt)), CtBytes, None))
  }
  else None
}

fn lookup_bytes_group_c(name: String) -> Option[Type] {
  match lookup_bytes_blit(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_fill(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_from_array(name) {
        Some(t) => Some(t),
        None => lookup_bytes_to_array(name)
      }
    }
  }
}

// simd_skip_ws(buf, pos, len): SIMD-accelerated whitespace scan over a byte
// buffer; returns the first non-whitespace index in [pos, len), or len.
fn lookup_simd_skip_ws(name: String) -> Option[Type] {
  if name == "simd_skip_ws" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))
  }
  else None
}

// simd_scan_alnum(buf, pos, len): SIMD-accelerated identifier-byte scan; returns
// the first non-[A-Za-z0-9_] index in [pos, len), or len.
fn lookup_simd_scan_alnum(name: String) -> Option[Type] {
  if name == "simd_scan_alnum" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))
  }
  else None
}

// simd_scan_alnum_str: same scan over a String source (lexer-facing variant);
// (source, pos, len) -> first non-identifier index in [pos, len), or len.
fn lookup_simd_scan_alnum_str(name: String) -> Option[Type] {
  if name == "simd_scan_alnum_str" {
    Some(CtFn(bytes_three_params(CtString, CtInt, CtInt), CtInt, None))
  }
  else None
}

export fn lookup_bytes(name: String) -> Option[Type] {
  match lookup_bytes_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_group_c(name) {
        Some(t) => Some(t),
        None => match lookup_simd_skip_ws(name) {
          Some(t) => Some(t),
          None => match lookup_simd_scan_alnum(name) {
            Some(t) => Some(t),
            None => lookup_simd_scan_alnum_str(name)
          }
        }
      }
    }
  }
}
