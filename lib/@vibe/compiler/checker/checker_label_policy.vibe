import @vibe/core {
  struct MutMap
}

/// The invocation owns its label policy. Dependency checks for a repair
/// accept missing labels without recording offsets from another source.
export enum LabelCheck {
  RequireLabels
  RepairLabelDependency
  CollectLabelSites(Array[LabelSite], MutMap[Int, Bool])
}

export let strict_label_check: LabelCheck = RequireLabels
