//# The STRICT escape judgment for `let mut` bindings (#1262, ADR-0100 (1)).
//#
//# vibe answers "does this mutable binding escape?" in two deliberately
//# different directions, and this file is the second of the two:
//#
//#   * LOWERING (`codegen/common_analysis :: is_mut_captured_in`, surfaced as
//#     `vibe escapes`) is CONSERVATIVE. It does not subtract binder shadowing,
//#     so an inner binding that merely reuses an outer `let mut`'s name is
//#     reported as a capture. Over-reporting there only boxes a cell that did
//#     not need boxing -- slower, never wrong.
//#   * ENFORCEMENT (this file) is STRICT. Its answers reach the user as
//#     diagnostics and, through `env_bind_mut`, as facts other checks trust,
//#     so a false positive is a WRONG diagnostic. It subtracts shadowing on
//#     every binder on the path.
//#
//# ADR-0100 (1) fixes the definition of escape at CLOSURE CAPTURE ONLY:
//# passing a `struct { mut f }`, an `Array`, or a `Bytes` to a function is
//# NOT an escape under this definition. That is the same shape the lowering
//# predicate already decides, so putting this judgment in `TypeEnv` changes
//# no existing program's legality -- it only makes the fact addressable.
//#
//# Mutability is a purely SYNTACTIC property of the source, so nothing here
//# consults `TypeEnv` or `Subst`; the checker records the answer INTO the env
//# at the binding site (`env_bind_mut`) and later checks read it back with
//# `env_mut_escape` instead of re-walking the AST.

//# Imports

import @vibe/compiler/core {
  Expr, Pat, TypeExpr
}

//# Functions

/// True when `pat` binds `name` (and therefore shadows an outer `let mut` of
/// that name for the arm it guards).
fn esc_pat_binds(pat: Pat, name: String) -> Bool {
  match pat {
    PBind(n) => n == name,
    PCtor(_, pats) => esc_pat_list_binds(pats, name),
    PTuple(pats) => esc_pat_list_binds(pats, name),
    POr(a, b) => esc_pat_binds(a, name) || esc_pat_binds(b, name),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        if esc_pat_binds(fpat, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn esc_pat_list_binds(pats: Array[Pat], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pats) {
    if esc_pat_binds(Array::get(pats, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// A labeled (`x~`) or optional (`x?`) parameter is spelled with its marker in
/// `Expr`, but the checker binds the BASE name, so the raw spelling is not what
/// shadows an outer binding. Same stripping `check_expr`'s own `EFn` arm does
/// (`param_base_name`, checker.vibe) -- comparing raw names here would make
/// `let mut x = 0; let f = (x~: Int) -> Int { let g = () -> Int { x }; g() }`
/// report the OUTER `x` as escaping, which is exactly the false positive the
/// strict lane exists to avoid.
fn esc_param_base_name(raw: String) -> String {
  let len = String::length(raw)
  if len > 0 {
    let last = String::char_code_at(raw, len - 1)
    if last == '~' || last == '?' {
      raw[0: len - 1]
    } else {
      raw
    }
  } else {
    raw
  }
}

/// True when any of a closure's formal parameters binds `name`.
fn esc_params_bind(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    if esc_param_base_name(pname) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_free_in_list(items: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if esc_free_in(Array::get(items, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_free_in_fields(fields: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, fval) = Array::get(fields, i)
    if esc_free_in(fval, name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Arms (`match` / `handle`) whose PATTERN does not rebind `name`, asked
/// whether `name` occurs free in the arm body.
fn esc_free_in_arms(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    if !esc_pat_binds(pat, name) && esc_free_in(body, name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `loop` binds its parameters SEQUENTIALLY: the i-th initialiser is evaluated
/// with parameters 0..i-1 already in scope. So a `loop (x = x + 1, ...)` whose
/// first parameter shadows `name` hides it from every later initialiser and
/// from the body, but not from its own initialiser.
fn esc_loop_free_in(params: Array[(String, Expr)], body: Expr, name: String) -> Bool {
  let mut i = 0
  let mut shadowed = false
  let mut found = false
  while i < Array::length(params) {
    let (pname, init) = Array::get(params, i)
    if !shadowed && esc_free_in(init, name) {
      found = true
    } else {
      ()
    }
    if pname == name {
      shadowed = true
    } else {
      ()
    }
    i = i + 1
  }
  if !shadowed && esc_free_in(body, name) {
    found = true
  } else {
    ()
  }
  found
}

/// Does `name` occur FREE in `expr`? Standard free-variable test with every
/// binder subtracted.
///
/// A bare-identifier CALLEE counts, unlike `checker_spawnable`'s free-variable
/// collection which excludes it. That exclusion is right there (a callee is
/// usually a builtin / top-level function / constructor needing no environment
/// slot), but it is wrong here: `let mut f = () -> 1` really can be the callee
/// of `f()`, and reading the cell through a call is a read like any other.
fn esc_free_in(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(n, _) => n == name,
    EAssign(n, val, cont) => n == name || esc_free_in(val, name) || esc_free_in(cont, name),
    EAssignOp(n, _, val, cont) => n == name || esc_free_in(val, name) || esc_free_in(cont, name),
    ELet(n, val, body, _) => esc_free_in(val, name) || (n != name && esc_free_in(body, name)),
    ELetMut(n, val, body, _) => esc_free_in(val, name) || (n != name && esc_free_in(body, name)),
    ELetRec(n, val, body) => n != name && (esc_free_in(val, name) || esc_free_in(body, name)),
    EFn(_, _, params, _, _, body) => !esc_params_bind(params, name) && esc_free_in(body, name),
    EForIn(n, index_name, iter, body) => {
      let index_shadows = match index_name {
        Some(ixn) => ixn == name,
        None => false
      }
      esc_free_in(iter, name) || (n != name && !index_shadows && esc_free_in(body, name))
    },
    ELoop(params, body) => esc_loop_free_in(params, body, name),
    EMatch(scrut, arms) => esc_free_in(scrut, name) || esc_free_in_arms(arms, name),
    EHandle(body, arms) => esc_free_in(body, name) || esc_free_in_arms(arms, name),
    ECall(callee, args, _) => esc_free_in(callee, name) || esc_free_in_list(args, name),
    ESeq(a, b) => esc_free_in(a, name) || esc_free_in(b, name),
    EIf(c, t, e) => esc_free_in(c, name) || esc_free_in(t, name) || esc_free_in(e, name),
    EBinOp(_, l, r) => esc_free_in(l, name) || esc_free_in(r, name),
    EUnaryOp(_, e) => esc_free_in(e, name),
    EWhile(c, b) => esc_free_in(c, name) || esc_free_in(b, name),
    ETuple(elems) => esc_free_in_list(elems, name),
    EArray(elems) => esc_free_in_list(elems, name),
    ERecord(_, fields, _) => esc_free_in_fields(fields, name),
    EMap(entries) => esc_free_in_fields(entries, name),
    EDot(recv, _, _, _) => esc_free_in(recv, name),
    ELabeledArg(_, _, e) => esc_free_in(e, name),
    EReturn(e) => esc_free_in(e, name),
    ESpread(e) => esc_free_in(e, name),
    EBreak(opt) => match opt {
      Some(e) => esc_free_in(e, name),
      None => false
    },
    EContinue(args) => esc_free_in_list(args, name),
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

fn esc_scan_list(items: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if esc_scan(Array::get(items, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_fields(fields: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, fval) = Array::get(fields, i)
    if esc_scan(fval, name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_arms(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    if !esc_pat_binds(pat, name) && esc_scan(body, name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_loop(params: Array[(String, Expr)], body: Expr, name: String) -> Bool {
  let mut i = 0
  let mut shadowed = false
  let mut found = false
  while i < Array::length(params) {
    let (pname, init) = Array::get(params, i)
    if !shadowed && esc_scan(init, name) {
      found = true
    } else {
      ()
    }
    if pname == name {
      shadowed = true
    } else {
      ()
    }
    i = i + 1
  }
  if !shadowed && esc_scan(body, name) {
    found = true
  } else {
    ()
  }
  found
}

/// Is there a closure literal reachable from `expr`, with `name` unshadowed on
/// the path to it, that has `name` free in its own body?
///
/// The `EFn` arm does not recurse further: a closure nested inside another
/// closure can only see `name` if `name` is free in the OUTER closure's body
/// too, which `esc_free_in` already answers.
fn esc_scan(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => !esc_params_bind(params, name) && esc_free_in(body, name),
    ELet(n, val, body, _) => esc_scan(val, name) || (n != name && esc_scan(body, name)),
    ELetMut(n, val, body, _) => esc_scan(val, name) || (n != name && esc_scan(body, name)),
    ELetRec(n, val, body) => n != name && (esc_scan(val, name) || esc_scan(body, name)),
    EForIn(n, index_name, iter, body) => {
      let index_shadows = match index_name {
        Some(ixn) => ixn == name,
        None => false
      }
      esc_scan(iter, name) || (n != name && !index_shadows && esc_scan(body, name))
    },
    ELoop(params, body) => esc_scan_loop(params, body, name),
    EMatch(scrut, arms) => esc_scan(scrut, name) || esc_scan_arms(arms, name),
    EHandle(body, arms) => esc_scan(body, name) || esc_scan_arms(arms, name),
    EAssign(_, val, cont) => esc_scan(val, name) || esc_scan(cont, name),
    EAssignOp(_, _, val, cont) => esc_scan(val, name) || esc_scan(cont, name),
    ECall(callee, args, _) => esc_scan(callee, name) || esc_scan_list(args, name),
    ESeq(a, b) => esc_scan(a, name) || esc_scan(b, name),
    EIf(c, t, e) => esc_scan(c, name) || esc_scan(t, name) || esc_scan(e, name),
    EBinOp(_, l, r) => esc_scan(l, name) || esc_scan(r, name),
    EUnaryOp(_, e) => esc_scan(e, name),
    EWhile(c, b) => esc_scan(c, name) || esc_scan(b, name),
    ETuple(elems) => esc_scan_list(elems, name),
    EArray(elems) => esc_scan_list(elems, name),
    ERecord(_, fields, _) => esc_scan_fields(fields, name),
    EMap(entries) => esc_scan_fields(entries, name),
    EDot(recv, _, _, _) => esc_scan(recv, name),
    ELabeledArg(_, _, e) => esc_scan(e, name),
    EReturn(e) => esc_scan(e, name),
    ESpread(e) => esc_scan(e, name),
    EBreak(opt) => match opt {
      Some(e) => esc_scan(e, name),
      None => false
    },
    EContinue(args) => esc_scan_list(args, name),
    EIdent(_, _) => false,
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

/// STRICT escape judgment: does any closure inside `body` capture the `let mut`
/// binding `name` declared just outside it?
///
/// `body` is the ELetMut's continuation -- the exact region where the binding
/// is in scope -- so a same-named binding declared BEFORE it, or one declared
/// inside it that shadows it, is correctly not this binding.
export fn mut_binding_escapes(body: Expr, name: String) -> Bool {
  esc_scan(body, name)
}
