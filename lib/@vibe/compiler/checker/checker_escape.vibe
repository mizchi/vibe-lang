//# The STRICT escape judgment for `let mut` bindings (#1262, ADR-0100 (1)).
//#
//# vibe answers "does this mutable binding escape?" in two deliberately
//# different directions, and this file is the second of the two:
//#
//#   * LOWERING (`codegen/common_analysis :: is_mut_captured_in`, surfaced as
//#     `vibe escapes`) is CONSERVATIVE. It does not subtract binder shadowing,
//#     so an inner binding that merely reuses an outer `let mut`'s name is
//#     reported as a capture. Over-reporting there only boxes a cell that did
//#     not need boxing -- slower, never wrong.
//#   * ENFORCEMENT (this file) is STRICT. Its answers reach the user as
//#     diagnostics and, through `env_bind_mut`, as facts other checks trust,
//#     so a false positive is a WRONG diagnostic. It subtracts shadowing on
//#     every binder on the path.
//#
//# ADR-0100 (1) fixes the definition of escape at CLOSURE CAPTURE ONLY:
//# passing a `struct { mut f }`, an `Array`, or a `Bytes` to a function is
//# NOT an escape under this definition. That is the same shape the lowering
//# predicate already decides, so putting this judgment in `TypeEnv` changes
//# no existing program's legality -- it only makes the fact addressable.
//#
//# Mutability is a purely SYNTACTIC property of the source, so nothing here
//# consults `TypeEnv` or `Subst`; the checker records the answer INTO the env
//# at the binding site (`env_bind_mut`) and later checks read it back with
//# `env_mut_escape` instead of re-walking the AST.

//# Imports

import @vibe/compiler/core {
  Expr, Pat, TypeExpr
}

import @vibe/core {
  array_empty
}

//# Functions

/// True when `pat` binds `name` (and therefore shadows an outer `let mut` of
/// that name for the arm it guards).
fn esc_pat_binds(pat: Pat, name: String) -> Bool {
  match pat {
    PBind(n) => n == name,
    PCtor(_, pats) => esc_pat_list_binds(pats = pats, name = name),
    PTuple(pats) => esc_pat_list_binds(pats = pats, name = name),
    POr(a, b) => esc_pat_binds(pat = a, name = name) || esc_pat_binds(pat = b, name = name),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, at = i)
        if esc_pat_binds(pat = fpat, name = name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn esc_pat_list_binds(pats: Array[Pat], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pats) {
    if esc_pat_binds(pat = Array::get(pats, at = i), name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// An optional (`x?`) parameter is spelled with its marker in
/// `Expr`, but the checker binds the BASE name, so the raw spelling is not what
/// shadows an outer binding. Same stripping `check_expr`'s own `EFn` arm does
/// (`param_base_name`, checker.vibe) -- comparing raw names here would make
/// `let mut x = 0; let f = (x?: Int) -> Int { let g = () -> Int { x }; g() }`
/// report the OUTER `x` as escaping, which is exactly the false positive the
/// strict lane exists to avoid.
fn esc_param_base_name(_ raw: String) -> String {
  let len = String::length(raw)
  if len > 0 {
    let last = String::char_code_at(raw, at = len - 1)
    if last == '?' {
      raw[0: len - 1]
    } else {
      raw
    }
  } else {
    raw
  }
}

/// True when any of a closure's formal parameters binds `name`.
fn esc_params_bind(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, at = i)
    if esc_param_base_name(pname) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_free_in_list(items: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if esc_free_in(expr = Array::get(items, at = i), name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_free_in_fields(fields: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, fval) = Array::get(fields, at = i)
    if esc_free_in(expr = fval, name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Arms (`match` / `handle`) whose PATTERN does not rebind `name`, asked
/// whether `name` occurs free in the arm body.
fn esc_free_in_arms(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, at = i)
    if !esc_pat_binds(pat = pat, name = name) && esc_free_in(expr = body, name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `loop` binds its parameters SEQUENTIALLY: the i-th initialiser is evaluated
/// with parameters 0..i-1 already in scope. So a `loop (x = x + 1, ...)` whose
/// first parameter shadows `name` hides it from every later initialiser and
/// from the body, but not from its own initialiser.
fn esc_loop_free_in(params: Array[(String, Expr)], body: Expr, name: String) -> Bool {
  let mut i = 0
  let mut shadowed = false
  let mut found = false
  while i < Array::length(params) {
    let (pname, init) = Array::get(params, at = i)
    if !shadowed && esc_free_in(expr = init, name = name) {
      found = true
    } else {
      ()
    }
    if pname == name {
      shadowed = true
    } else {
      ()
    }
    i = i + 1
  }
  if !shadowed && esc_free_in(expr = body, name = name) {
    found = true
  } else {
    ()
  }
  found
}

/// Does `name` occur FREE in `expr`? Standard free-variable test with every
/// binder subtracted.
///
/// A bare-identifier CALLEE counts, unlike `checker_spawnable`'s free-variable
/// collection which excludes it. That exclusion is right there (a callee is
/// usually a builtin / top-level function / constructor needing no environment
/// slot), but it is wrong here: `let mut f = () -> 1` really can be the callee
/// of `f()`, and reading the cell through a call is a read like any other.
fn esc_free_in(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(n, _) => n == name,
    EAssign(n, val, cont, _) => n == name || esc_free_in(expr = val, name = name) || esc_free_in(expr = cont, name = name),
    EAssignOp(n, _, val, cont, _) => n == name || esc_free_in(expr = val, name = name) || esc_free_in(expr = cont, name = name),
    ELet(n, val, body, _) => esc_free_in(expr = val, name = name) || (n != name && esc_free_in(expr = body, name = name)),
    ELetMut(n, val, body, _) => esc_free_in(expr = val, name = name) || (n != name && esc_free_in(expr = body, name = name)),
    ELetRec(n, val, body) => n != name && (esc_free_in(expr = val, name = name) || esc_free_in(expr = body, name = name)),
    EFn(_, _, params, _, _, body) => !esc_params_bind(params = params, name = name) && esc_free_in(expr = body, name = name),
    EForIn(n, index_name, iter, body, _) => {
      let index_shadows = match index_name {
        Some(ixn) => ixn == name,
        None => false
      }
      esc_free_in(expr = iter, name = name) || (n != name && !index_shadows && esc_free_in(expr = body, name = name))
    },
    ELoop(params, body) => esc_loop_free_in(params = params, body = body, name = name),
    EMatch(scrut, arms) => esc_free_in(expr = scrut, name = name) || esc_free_in_arms(arms = arms, name = name),
    EHandle(body, arms) => esc_free_in(expr = body, name = name) || esc_free_in_arms(arms = arms, name = name),
    ECall(callee, args, _, _) => esc_free_in(expr = callee, name = name) || esc_free_in_list(items = args, name = name),
    ESeq(a, b) => esc_free_in(expr = a, name = name) || esc_free_in(expr = b, name = name),
    EIf(c, t, e) => esc_free_in(expr = c, name = name) || esc_free_in(expr = t, name = name) || esc_free_in(expr = e, name = name),
    EBinOp(_, l, r, _) => esc_free_in(expr = l, name = name) || esc_free_in(expr = r, name = name),
    EUnaryOp(_, e) => esc_free_in(expr = e, name = name),
    EWhile(c, b) => esc_free_in(expr = c, name = name) || esc_free_in(expr = b, name = name),
    ETuple(elems) => esc_free_in_list(items = elems, name = name),
    EArray(elems) => esc_free_in_list(items = elems, name = name),
    ERecord(_, fields, _) => esc_free_in_fields(fields = fields, name = name),
    EMap(entries) => esc_free_in_fields(fields = entries, name = name),
    EDot(recv, _, _, _) => esc_free_in(expr = recv, name = name),
    ELabeledArg(_, _, e) => esc_free_in(expr = e, name = name),
    EReturn(e) => esc_free_in(expr = e, name = name),
    ESpread(e) => esc_free_in(expr = e, name = name),
    EBreak(opt) => match opt {
      Some(e) => esc_free_in(expr = e, name = name),
      None => false
    },
    EContinue(args) => esc_free_in_list(items = args, name = name),
    EInt(_) => false,
    EFloat(_) => false,
    EString(_, _) => false,
    EBool(_) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

/// Public checker query used when synthesizing closure provenance. This is
/// the same strict, shadowing-aware free-variable judgment as `let mut`
/// enforcement; region capture must not grow a second binder walk.
export fn expr_free_in(expr: Expr, name: String) -> Bool {
  esc_free_in(expr = expr, name = name)
}

fn esc_scan_list(items: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if esc_scan(expr = Array::get(items, at = i), name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_fields(fields: Array[(String, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, fval) = Array::get(fields, at = i)
    if esc_scan(expr = fval, name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_arms(arms: Array[(Pat, Expr)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, at = i)
    if !esc_pat_binds(pat = pat, name = name) && esc_scan(expr = body, name = name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn esc_scan_loop(params: Array[(String, Expr)], body: Expr, name: String) -> Bool {
  let mut i = 0
  let mut shadowed = false
  let mut found = false
  while i < Array::length(params) {
    let (pname, init) = Array::get(params, at = i)
    if !shadowed && esc_scan(expr = init, name = name) {
      found = true
    } else {
      ()
    }
    if pname == name {
      shadowed = true
    } else {
      ()
    }
    i = i + 1
  }
  if !shadowed && esc_scan(expr = body, name = name) {
    found = true
  } else {
    ()
  }
  found
}

/// Is there a closure literal reachable from `expr`, with `name` unshadowed on
/// the path to it, that has `name` free in its own body?
///
/// The `EFn` arm does not recurse further: a closure nested inside another
/// closure can only see `name` if `name` is free in the OUTER closure's body
/// too, which `esc_free_in` already answers.
fn esc_scan(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => !esc_params_bind(params = params, name = name) && esc_free_in(expr = body, name = name),
    ELet(n, val, body, _) => esc_scan(expr = val, name = name) || (n != name && esc_scan(expr = body, name = name)),
    ELetMut(n, val, body, _) => esc_scan(expr = val, name = name) || (n != name && esc_scan(expr = body, name = name)),
    ELetRec(n, val, body) => n != name && (esc_scan(expr = val, name = name) || esc_scan(expr = body, name = name)),
    EForIn(n, index_name, iter, body, _) => {
      let index_shadows = match index_name {
        Some(ixn) => ixn == name,
        None => false
      }
      esc_scan(expr = iter, name = name) || (n != name && !index_shadows && esc_scan(expr = body, name = name))
    },
    ELoop(params, body) => esc_scan_loop(params = params, body = body, name = name),
    EMatch(scrut, arms) => esc_scan(expr = scrut, name = name) || esc_scan_arms(arms = arms, name = name),
    EHandle(body, arms) => esc_scan(expr = body, name = name) || esc_scan_arms(arms = arms, name = name),
    EAssign(_, val, cont, _) => esc_scan(expr = val, name = name) || esc_scan(expr = cont, name = name),
    EAssignOp(_, _, val, cont, _) => esc_scan(expr = val, name = name) || esc_scan(expr = cont, name = name),
    ECall(callee, args, _, _) => esc_scan(expr = callee, name = name) || esc_scan_list(items = args, name = name),
    ESeq(a, b) => esc_scan(expr = a, name = name) || esc_scan(expr = b, name = name),
    EIf(c, t, e) => esc_scan(expr = c, name = name) || esc_scan(expr = t, name = name) || esc_scan(expr = e, name = name),
    EBinOp(_, l, r, _) => esc_scan(expr = l, name = name) || esc_scan(expr = r, name = name),
    EUnaryOp(_, e) => esc_scan(expr = e, name = name),
    EWhile(c, b) => esc_scan(expr = c, name = name) || esc_scan(expr = b, name = name),
    ETuple(elems) => esc_scan_list(items = elems, name = name),
    EArray(elems) => esc_scan_list(items = elems, name = name),
    ERecord(_, fields, _) => esc_scan_fields(fields = fields, name = name),
    EMap(entries) => esc_scan_fields(fields = entries, name = name),
    EDot(recv, _, _, _) => esc_scan(expr = recv, name = name),
    ELabeledArg(_, _, e) => esc_scan(expr = e, name = name),
    EReturn(e) => esc_scan(expr = e, name = name),
    ESpread(e) => esc_scan(expr = e, name = name),
    EBreak(opt) => match opt {
      Some(e) => esc_scan(expr = e, name = name),
      None => false
    },
    EContinue(args) => esc_scan_list(items = args, name = name),
    EIdent(_, _) => false,
    EInt(_) => false,
    EFloat(_) => false,
    EString(_, _) => false,
    EBool(_) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

/// STRICT escape judgment: does any closure inside `body` capture the `let mut`
/// binding `name` declared just outside it?
///
/// `body` is the ELetMut's continuation -- the exact region where the binding
/// is in scope -- so a same-named binding declared BEFORE it, or one declared
/// inside it that shadows it, is correctly not this binding.
export fn mut_binding_escapes(body: Expr, name: String) -> Bool {
  esc_scan(expr = body, name = name)
}

//# #1951 Diag::Report — compiler-private diagnostic effect.
//
// One bounded slice (MutList::empty region-token) reports through this
// effect. Handlers are local to these helpers: collect-all appends into the
// caller-owned errors array, fail-fast returns the payload via resume.
// No global sink, and checker.vibe does not wrap its giant functions in a
// handle (that blew selfcompile heap).

effect Diag {
  Report(String) -> String
}

export fn diag_report_into(errors: Array[String], msg: String) -> Unit {
  let _ = handle {
    perform Diag::Report(msg)
  } with { Diag::Report(m) => {
    Array::push(errors, value = m)
    resume(m)
  } }
}

export fn diag_collect_all(_ msg: String) -> Array[String] {
  let out = array_empty()
  diag_report_into(errors = out, msg = msg)
  out
}

export fn diag_collect_all_many(_ msgs: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(msgs) {
    diag_report_into(errors = out, msg = Array::get(msgs, at = i))
    i = i + 1
  }
  out
}

export fn diag_fail_fast(_ msg: String) -> String {
  handle {
    perform Diag::Report(msg)
  } with { Diag::Report(m) => resume(m) }
}
