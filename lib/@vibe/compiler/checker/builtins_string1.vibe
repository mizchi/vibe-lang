//# Imports

import ../core {
  Type
}

import ../../../../lib/@vibe/core {
  array_empty
}

//# Functions

fn string1_no_params() -> Array[Type] {
  array_empty()
}

fn string1_one_param(a: Type) -> Array[Type] {
  let arr = string1_no_params()
  Array::push(arr, a)
  arr
}

fn string1_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = string1_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn string1_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = string1_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_string_concat(name: String) -> Option[Type] {
  if name == "String::concat" {
    Some(CtFn(string1_two_params(CtString, CtString), CtString, None))
  }
  else None
}

fn lookup_string_equals(name: String) -> Option[Type] {
  if name == "String::equals" {
    Some(CtFn(string1_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

fn lookup_string_length(name: String) -> Option[Type] {
  if name == "String::length" {
    Some(CtFn(string1_one_param(CtString), CtInt, None))
  }
  else None
}

fn lookup_string_char_at(name: String) -> Option[Type] {
  if name == "string_char_at" {
    Some(CtFn(string1_two_params(CtString, CtInt), CtString, None))
  }
  else None
}

fn lookup_string_group_a(name: String) -> Option[Type] {
  match lookup_string_concat(name) {
    Some(t) => Some(t),
    None => match lookup_string_length(name) {
      Some(t) => Some(t),
      None => lookup_string_equals(name)
    }
  }
}

fn lookup_string_substring(name: String) -> Option[Type] {
  if name == "String::substring" {
    Some(CtFn(string1_three_params(CtString, CtInt, CtInt), CtString, None))
  }
  else None
}

fn lookup_string_group_b(name: String) -> Option[Type] {
  match lookup_string_substring(name) {
    Some(t) => Some(t),
    None => lookup_string_char_at(name)
  }
}

export fn lookup_string1(name: String) -> Option[Type] {
  match lookup_string_group_a(name) {
    Some(t) => Some(t),
    None => lookup_string_group_b(name)
  }
}
