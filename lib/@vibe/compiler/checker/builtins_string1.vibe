//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn string1_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

/// Runtime-internal char access remains fallback-only. Public String
/// signatures in this lane are checker-visible registry rows (#1593).
export fn lookup_string1(name: String) -> Option[Type] {
  if name == "string_char_at" {
    Some(CtFn(string1_two_params(CtString, CtInt), CtString, None))
  }
  else None
}
