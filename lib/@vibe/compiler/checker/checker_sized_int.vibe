// #3730 (ADR-0122 (5)): typing the exact 32-bit integers' operators and
// literals.

import @vibe/compiler/core {
  Expr, Subst, Type, subst_apply, typed_negation_operand_key, unify
}

import @vibe/compiler/checker/diagnostics {
  off_marker
}

//# Functions

export fn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {
  match unify(a = left_ty, b = target_ty, s = s) {
    Some(s1) => unify(a = right_ty, b = target_ty, s = s1),
    None => None
  }
}

/// #3730: an operator on two `Int32`s (or two `UInt32`s) is typed at that
/// width. Tried after `Int`, so two variable operands still default to `Int`
/// and a sized result always has a concrete sized operand behind it.
export fn sized_int_binop(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {
  match unify_binop_candidate(left_ty = left_ty, right_ty = right_ty, target_ty = CtInt32, s = s) {
    Some(s1) => Some((CtInt32, s1)),
    None => match unify_binop_candidate(left_ty = left_ty, right_ty = right_ty, target_ty = CtUInt32, s = s) {
      Some(s1) => Some((CtUInt32, s1)),
      None => None
    }
  }
}

/// A binop operand's type, with an integer literal opposite a sized-integer
/// operand taking that operand's type (`x + 1`, `x << 3`, `5 < x`).
export fn sized_int_operand_type(e: Expr, ty: Type, other: Type, s: Subst, errors: Array[String], off: Int) -> Type {
  match sized_int_literal_type(e = e, expected = other, s = s, errors = errors, off = off) {
    Some(t) => t,
    None => match e {
      // An array literal of integer literals where an `Array[Int32]` /
      // `Array[UInt32]` is expected: each element takes the element type.
      EArray(items) => match subst_apply(s = s, ty = other) {
        CtArray(elem) => if Array::length(items) > 0 && sized_int_all_literals(items) {
          let mut sized = true
          for it in items {
            match sized_int_literal_type(e = it, expected = elem, s = s, errors = errors, off = off) {
              Some(_) => (),
              None => {
                sized = false
              }
            }
          }
          if sized {
            CtArray(subst_apply(s = s, ty = elem))
          } else {
            ty
          }
        } else {
          ty
        },
        _ => ty
      },
      _ => ty
    }
  }
}

/// One array literal element against the element type so far: an integer
/// literal next to an `Int32` / `UInt32` element takes that type, whichever
/// comes first (`[1, x32]`, `[x32, 1]`). Answers the element type and this
/// element's type to unify. Earlier literals that a sized element now types
/// are range-checked here.
export fn sized_int_array_elem(items: Array[Expr], at: Int, elem_ty: Type, it: Type, s: Subst, errors: Array[String]) -> (Type, Type) {
  let item_ty = sized_int_operand_type(e = Array::get(items, at = at), ty = it, other = elem_ty, s = s, errors = errors, off = 0 - 1)
  let sized_now = String::length(sized_int_type_name(subst_apply(s = s, ty = item_ty))) > 0
  let elem_is_int = match subst_apply(s = s, ty = elem_ty) {
    CtInt => true,
    _ => false
  }
  // The earlier elements are only read when a sized element follows `Int`s,
  // so an ordinary array literal costs nothing here.
  if sized_now && elem_is_int && sized_int_literals_before(items = items, at = at) {
    let mut i = 0
    while i < at {
      let _ = sized_int_literal_type(e = Array::get(items, at = i), expected = item_ty, s = s, errors = errors, off = 0 - 1)
      i = i + 1
    }
    (item_ty, item_ty)
  } else {
    (elem_ty, item_ty)
  }
}

fn sized_int_type_name(_ t: Type) -> String {
  match t {
    CtInt32 => "Int32",
    CtUInt32 => "UInt32",
    _ => ""
  }
}

fn sized_int_literals_before(items: Array[Expr], at: Int) -> Bool {
  let mut all = true
  let mut i = 0
  while i < at && all {
    match sized_int_literal_value(Array::get(items, at = i)) {
      Some(_) => (),
      None => {
        all = false
      }
    }
    i = i + 1
  }
  all
}

fn sized_int_all_literals(_ items: Array[Expr]) -> Bool {
  let mut all = true
  for it in items {
    match sized_int_literal_value(it) {
      Some(_) => (),
      None => {
        all = false
      }
    }
  }
  all
}

/// Whether either operand of a compound assignment is a sized integer, so the
/// assignment is typed as the binop it stands for.
export fn sized_int_involved(a: Type, b: Type) -> Bool {
  match a {
    CtInt32 => true,
    CtUInt32 => true,
    _ => match b {
      CtInt32 => true,
      CtUInt32 => true,
      _ => false
    }
  }
}

/// The expression a block evaluates to -- its tail past `;` and `let`s --
/// for the literal check of a function body against its return type.
export fn sized_int_tail(_ e: Expr) -> Expr {
  match e {
    ESeq(_, rest) => sized_int_tail(rest),
    ELet(_, _, rest, _) => sized_int_tail(rest),
    ELetRec(_, _, rest) => sized_int_tail(rest),
    ELetMut(_, _, rest, _) => sized_int_tail(rest),
    _ => e
  }
}

/// #3730: the capture kind of a sized-integer operation whose `Int` result
/// must be wrapped to 32 bits (`typed_int_wrap_verdict`), or 0 when it needs
/// no wrap. `assign` selects the compound-assignment kinds. The result of
/// `>>`, `&`, `|`, `^` on in-range operands is already in range, and so are
/// `/` and `%` on `UInt32`; `Int32 / -1` of `MIN` is not, so `/` wraps there.
export fn sized_int_wrap_kind(op: String, result: Type, assign: Bool) -> Int {
  let base = match result {
    CtInt32 => if op == "+" || op == "-" || op == "*" || op == "/" || op == "<<" {
      16
    } else {
      0
    },
    CtUInt32 => if op == "+" || op == "-" || op == "*" || op == "<<" {
      17
    } else {
      0
    },
    _ => 0
  }
  if base > 0 && assign {
    base + 2
  } else {
    base
  }
}

/// #3730: the row type a capture kind records: the sized type for the wrap
/// kinds (16..22), `Float32` for the float kinds `record_float_arith` files.
export fn arith_row_type(_ kind: Int) -> Type {
  if kind == 16 || kind == 18 || kind == 20 {
    CtInt32
  } else if kind == 17 || kind == 19 || kind == 21 || kind == 22 {
    CtUInt32
  } else {
    CtFloat
  }
}

/// #3730: the key a sized negation's (or `UInt32` `~`'s) wrap row is filed
/// under. A unary operator has no offset of its own, so the row is keyed by
/// its operand (`typed_negation_operand_key`); an operand with no key -- a
/// nested operator, `-(a + b)` -- is refused with the edit rather than left
/// unwrapped.
export fn sized_negation_key(operand: Expr, op: String, errors: Array[String]) -> Int {
  let key = typed_negation_operand_key(operand)
  if key < 0 {
    Array::push(errors, value = "write this `" + op + "` on an `Int32` / `UInt32` as `0 - (..)`" + (if op == "~" {
      " or `(..) ^ 4294967295`"
    } else {
      ""
    }) + ": the compiler wraps a sized negation by its operand's position, and this operand (an operator or a literal) has none")
  } else {
    ()
  }
  key
}

/// A struct literal field's value type, with an integer literal taking the
/// field's declared `Int32` / `UInt32` type (`Pixel::{ x: 3 }`).
export fn sized_int_field_type(exprs: Array[(String, Expr)], name: String, ty: Type, expected: Type, s: Subst, errors: Array[String]) -> Type {
  let mut value = EUnit
  for f in exprs {
    let (n, v) = f
    if n == name {
      value = v
    } else {
      ()
    }
  }
  sized_int_operand_type(e = value, ty = ty, other = expected, s = s, errors = errors, off = 0 - 1)
}

/// The value of an integer literal as written: `5`, or `-5` (the parser reads
/// a negative literal as unary minus over `EInt`). `None` for any other
/// expression.
export fn sized_int_literal_value(_ e: Expr) -> Option[Int] {
  match e {
    EInt(n) => Some(n),
    EUnaryOp(op, inner) => if op == "-" {
      match inner {
        EInt(n) => Some(0 - n),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3730: an integer literal where an `Int32` / `UInt32` is expected takes
/// that type, and is refused when it does not fit -- the checker is not
/// bidirectional, so each site that knows its expected type asks here.
/// Answers the type the literal takes (`expected` when it applies), or
/// `None` when `e` is not a literal or `expected` is not a sized integer.
export fn sized_int_literal_type(e: Expr, expected: Type, s: Subst, errors: Array[String], off: Int) -> Option[Type] {
  match sized_int_literal_value(e) {
    Some(n) => match subst_apply(s = s, ty = expected) {
      CtInt32 => {
        if n < 0 - 2147483648 || n > 2147483647 {
          Array::push(errors, value = "integer literal \{n} does not fit `Int32` (-2147483648 ..= 2147483647) -- write it as an `Int`, or convert one with `Int::to_int32(n)` (checked) or `Int::wrap_int32(n)` (wrapping)" + off_marker(off))
        } else {
          ()
        }
        Some(CtInt32)
      },
      CtUInt32 => {
        if n < 0 || n > 4294967295 {
          Array::push(errors, value = "integer literal \{n} does not fit `UInt32` (0 ..= 4294967295) -- write it as an `Int`, or convert one with `Int::to_uint32(n)` (checked) or `Int::wrap_uint32(n)` (wrapping)" + off_marker(off))
        } else {
          ()
        }
        Some(CtUInt32)
      },
      _ => None
    },
    None => None
  }
}
