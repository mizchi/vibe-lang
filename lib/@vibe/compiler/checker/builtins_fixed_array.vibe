//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

fn fixed_array_no_params() -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

fn fixed_array_one_param(a: Type) -> Array[Type] {
  let arr = fixed_array_no_params()
  Array::push(arr, a)
  arr
}

fn fixed_array_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = fixed_array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn fixed_array_five_params(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {
  let arr = fixed_array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  Array::push(arr, e)
  arr
}

fn fixed_array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = fixed_array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_fixed_array_get(name: String) -> Option[Type] {
  if name == "FixedArray::get" {
    Some(CtFn(fixed_array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

fn lookup_fixed_array_set(name: String) -> Option[Type] {
  if name == "FixedArray::set" {
    Some(CtFn(fixed_array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_fixed_array_blit(name: String) -> Option[Type] {
  if name == "FixedArray::blit" {
    Some(CtFn(fixed_array_five_params(CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt), CtUnit, None))
  }
  else None
}

fn lookup_fixed_array_make(name: String) -> Option[Type] {
  if name == "FixedArray::make" {
    Some(CtFn(fixed_array_two_params(CtInt, CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_fixed_array_length(name: String) -> Option[Type] {
  if name == "FixedArray::length" {
    Some(CtFn(fixed_array_one_param(CtArray(CtUnknown)), CtInt, None))
  }
  else None
}

fn lookup_fixed_array_group_a(name: String) -> Option[Type] {
  match lookup_fixed_array_make(name) {
    Some(t) => Some(t),
    None => match lookup_fixed_array_length(name) {
      Some(t) => Some(t),
      None => lookup_fixed_array_get(name)
    }
  }
}

fn lookup_fixed_array_unsafe_set(name: String) -> Option[Type] {
  if name == "FixedArray::unsafe_set" {
    Some(CtFn(fixed_array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_fixed_array_group_b(name: String) -> Option[Type] {
  match lookup_fixed_array_set(name) {
    Some(t) => Some(t),
    None => match lookup_fixed_array_unsafe_set(name) {
      Some(t) => Some(t),
      None => lookup_fixed_array_blit(name)
    }
  }
}

export fn lookup_fixed_array(name: String) -> Option[Type] {
  match lookup_fixed_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_fixed_array_group_b(name)
  }
}
