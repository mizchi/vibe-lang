//# Imports

import .. / core / ast.vibe {
  Expr, Stmt
}

//# Functions

// Labeled parameters are lexed with a trailing marker (`x~` / `x?`) baked
// into the declared param NAME itself (see @vibe/parser's parse_one_param).
// Call-site `ELabeledArg(label, modifier, value)` carries the bare label
// (no marker). Strip the marker so both sides compare equal.
let strip_label_marker: (String) -> String = (name) -> {
  let len = String::length(name)
  if len > 0 && (String::ends_with(name, "~") || String::ends_with(name, "?")) {
    String::substring(name, 0, len - 1)
  } else {
    name
  }
}

// name -> ordered bare param labels, for every top-level
// `let name = (params) -> ...` / `let name: T = (params) -> ...`.
export let compute_fn_param_labels: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {
  let out: Array[(String, Array[String])] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, params, _, _, _) => {
          let labels: Array[String] = [
          ]
          let mut pi = 0
          while pi < Array::length(params) {
            let (pname, _) = Array::get(params, pi)
            Array::push(labels, strip_label_marker(pname))
            pi = pi + 1
          }
          Array::push(out, (name, labels))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

let lookup_fn_param_labels: (Array[(String, Array[String])], String) -> Option[Array[String]] = (table, name) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(table) {
    let (n, labels) = Array::get(table, i)
    if n == name {
      found = Some(labels)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// Labeled arguments in vibe bind POSITIONALLY (labels are not reordered at
// the call site), so `f(y=20, x=10)` silently swaps values when `f` is
// declared `(x~, y~)`. Catch that footgun as a compile error instead of a
// silent wrong-value bug: every `ELabeledArg` in a call to a KNOWN top-level
// function must use the label matching that position's declared param.
let rec check_labeled_arg_order_expr: (Expr, Array[(String, Array[String])], Array[String]) -> Int = (expr, table, errors) -> {
  match expr {
    EIdent(_, _) => 0,
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(opt) => match opt {
      Some(e) => check_labeled_arg_order_expr(e, table, errors),
      None => 0
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        check_labeled_arg_order_expr(Array::get(args, i), table, errors)
        i = i + 1
      }
      0
    },
    EThrow(e) => check_labeled_arg_order_expr(e, table, errors),
    EReturn(e) => check_labeled_arg_order_expr(e, table, errors),
    EUnaryOp(_, e) => check_labeled_arg_order_expr(e, table, errors),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        check_labeled_arg_order_expr(Array::get(items, i), table, errors)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        check_labeled_arg_order_expr(Array::get(items, i), table, errors)
        i = i + 1
      }
      0
    },
    ERecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        check_labeled_arg_order_expr(val, table, errors)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r) => {
      check_labeled_arg_order_expr(l, table, errors)
      check_labeled_arg_order_expr(r, table, errors)
      0
    },
    ECall(callee, args, _) => {
      check_labeled_arg_order_expr(callee, table, errors)
      let mut i = 0
      while i < Array::length(args) {
        check_labeled_arg_order_expr(Array::get(args, i), table, errors)
        i = i + 1
      }
      match callee {
        EIdent(fname, _) => match lookup_fn_param_labels(table, fname) {
          Some(decl_labels) => {
            let mut ai = 0
            while ai < Array::length(args) {
              match Array::get(args, ai) {
                ELabeledArg(label, _, _) => if ai < Array::length(decl_labels) {
                  let expected = Array::get(decl_labels, ai)
                  if expected != "" && label != expected {
                    Array::push(errors, String::concat("labeled argument out of order calling `", String::concat(fname, String::concat("`: expected `", String::concat(expected, String::concat("=` at position ", String::concat(__to_string(ai), String::concat(", got `", String::concat(label, "=` (vibe labeled args bind positionally, not by name)")))))))))
                  } else {
                    ()
                  }
                } else {
                  ()
                },
                _ => ()
              }
              ai = ai + 1
            }
          },
          None => ()
        },
        _ => ()
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      check_labeled_arg_order_expr(cond, table, errors)
      check_labeled_arg_order_expr(then_e, table, errors)
      check_labeled_arg_order_expr(else_e, table, errors)
      0
    },
    ELet(_, val, body) => {
      check_labeled_arg_order_expr(val, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    ELetRec(_, val, body) => {
      check_labeled_arg_order_expr(val, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    ELetMut(_, val, body) => {
      check_labeled_arg_order_expr(val, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    EAssign(_, val, body) => {
      check_labeled_arg_order_expr(val, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    EAssignOp(_, _, val, body) => {
      check_labeled_arg_order_expr(val, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    ESeq(l, r) => {
      check_labeled_arg_order_expr(l, table, errors)
      check_labeled_arg_order_expr(r, table, errors)
      0
    },
    EMatch(scr, arms) => {
      check_labeled_arg_order_expr(scr, table, errors)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, i)
        check_labeled_arg_order_expr(body, table, errors)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      check_labeled_arg_order_expr(body_expr, table, errors)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        check_labeled_arg_order_expr(arm_body, table, errors)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      check_labeled_arg_order_expr(cond, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        check_labeled_arg_order_expr(init, table, errors)
        i = i + 1
      }
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    EForIn(_, _, iter, body) => {
      check_labeled_arg_order_expr(iter, table, errors)
      check_labeled_arg_order_expr(body, table, errors)
      0
    },
    EFn(_, _, _, _, _, body) => check_labeled_arg_order_expr(body, table, errors),
    EDot(obj, _, _) => check_labeled_arg_order_expr(obj, table, errors),
    ELabeledArg(_, _, e) => check_labeled_arg_order_expr(e, table, errors),
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        check_labeled_arg_order_expr(val, table, errors)
        i = i + 1
      }
      0
    },
    ESpread(e) => check_labeled_arg_order_expr(e, table, errors),
    EStringInterp(_) => 0
  }
}

export let rec check_labeled_arg_order_stmts: (Array[Stmt], Array[(String, Array[String])], Array[String]) -> Int = (stmts, table, errors) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => check_labeled_arg_order_expr(expr, table, errors),
      SLetMut(_, _, expr) => check_labeled_arg_order_expr(expr, table, errors),
      SExpr(expr) => check_labeled_arg_order_expr(expr, table, errors),
      STest(_, expr) => check_labeled_arg_order_expr(expr, table, errors),
      SBench(_, expr) => check_labeled_arg_order_expr(expr, table, errors),
      SLetPat(_, expr) => check_labeled_arg_order_expr(expr, table, errors),
      SModule(_, _, inner) => check_labeled_arg_order_stmts(inner, table, errors),
      _ => 0
    }
    i = i + 1
  }
  0
}
