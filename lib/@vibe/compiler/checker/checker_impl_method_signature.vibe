// lib/@vibe/compiler/checker/checker_impl_method_signature.vibe -- an impl
// method's signature against the trait that declares it (#3538).

import @vibe/core {
  struct MutMap
}

import @vibe/compiler/core {
  Expr,
  Stmt,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  compiler_owned_type_arity,
  find_typedef,
  is_builtin_type_name,
  subst_apply,
  trait_definition,
  trait_method_sig_binders_deep,
  type_to_string,
  unify
}

import @vibe/compiler/checker/type_relations {
  row_labels
}

import @vibe/ast {
  impl_method_owner, impl_target_head, trait_ref_args, trait_ref_name, type_param_arity, type_param_name
}

import @vibe/parser {
  print_type_expr
}

import ./checker_resolve.vibe {
  resolve_type_expr_shadowed
}

import ./checker_throw_kind_of_type.vibe {
  trait_reference_display
}

//# Provenance

/// Where an impl method came from: the impl's type parameters, its trait key,
/// and its target, as the `SImpl` the parser emitted ahead of it.
export struct ImplMethodOrigin {
  tparams: Array[String];
  trait_key: String;
  target: TypeExpr
}

/// Every impl method of one statement list, by binding name.
export struct ImplMethodOrigins {
  by_name: MutMap[String, ImplMethodOrigin]
}

/// Index every impl method in `stmts` (from `from`) by its binding name.
///
/// `parse_impl_methods` lowers `impl Tr for T { m(..) { .. } }` to the
/// `SImpl` marker followed by one `let <owner>::m = (..) -> ..` per method.
/// The checker schedules statements in its own order, so the pairing is read
/// here, from the list as parsed: a binding is an impl method only when it
/// directly follows its `SImpl` (or a sibling method, or one of the trait's
/// operation bindings) and carries exactly the name `impl_method_binding_name`
/// gives it. A qualified free function
/// `fn P::m(..)` never qualifies, whatever its name.
export fn collect_impl_method_origins(stmts: Array[Stmt], from: Int) -> ImplMethodOrigins {
  let out: MutMap[String, ImplMethodOrigin] = MutMap::new_string()
  let mut k = from
  while k < Array::length(stmts) {
    match Array::get(stmts, k) {
      SImpl(tparams, _, trait_key, target) => {
        let prefix = String::concat(impl_method_owner(tparams, trait_key, target), "::")
        // The trait's own operation bindings (`let Tr::m = ..`, synthesized
        // ahead of checking) may sit between the marker and its methods.
        let trait_prefix = String::concat(trait_ref_name(trait_key), "::")
        let mut j = k + 1
        let mut more = true
        while more && j < Array::length(stmts) {
          match Array::get(stmts, j) {
            SLet(_, _, qname, _, _) => if String::starts_with(qname, prefix) && String::length(qname) > String::length(prefix) {
              MutMap::set(out, qname, ImplMethodOrigin::{
                tparams: tparams,
                trait_key: trait_key,
                target: target
              })
              j = j + 1
            } else if String::starts_with(qname, trait_prefix) {
              j = j + 1
            } else {
              more = false
            },
            _ => {
              more = false
            }
          }
        }
        k = j
      },
      _ => {
        k = k + 1
      }
    }
  }
  ImplMethodOrigins::{ by_name: out }
}

/// The impl a method binding belongs to, or `None` for any other binding.
export fn impl_method_origin(origins: ImplMethodOrigins, binding_name: String) -> Option[ImplMethodOrigin] {
  MutMap::get(origins.by_name, binding_name)
}

//# Diagnostics

/// The located-diagnostic marker for a span inside an impl block. The parser
/// gives an impl method's lambda no source offset, so the locator finds the
/// span from the impl header (trait and owner), the method name and `part`:
/// `name` (the method name), `param` (the parameter `param`), `ret` (the
/// declared return type) or `row` (the `with` clause).
fn impl_method_marker(trait_head: String, owner: String, method: String, part: String, param: String) -> String {
  String::join([
    " [@impl-method=",
    trait_head,
    "|",
    owner,
    "|",
    method,
    "|",
    part,
    "|",
    param,
    "]"
  ], "")
}

/// A labeled (`x~`) or optional (`x?`) parameter keeps its marker on the
/// name; the diagnostic names the bare parameter.
fn param_base(raw_name: String) -> String {
  let len = String::length(raw_name)
  if len > 0 {
    let last = String::char_code_at(raw_name, len - 1)
    if last == 126 || last == 63 {
      String::substring(raw_name, 0, len - 1)
    } else {
      raw_name
    }
  } else {
    raw_name
  }
}

fn signature_text(method: String, params: Array[TypeExpr], ret: TypeExpr) -> String {
  let parts: Array[String] = []
  for p in params {
    Array::push(parts, print_type_expr(p))
  }
  String::join([
    method,
    "(",
    String::join(parts, ", "),
    ") -> ",
    print_type_expr(ret)
  ], "")
}

fn plural_parameters(n: Int) -> String {
  if n == 1 {
    "1 parameter"
  } else {
    String::concat(__to_string(n), " parameters")
  }
}

//# Expected types

fn string_list_has(names: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    found = Array::get(names, i) == wanted
    i = i + 1
  }
  found
}

/// The pieces that turn a trait signature into the impl's expected one.
struct ExpectedScope {
  defs: Array[TypeDef];
  self_ty: Type;
  // Names that stand for something this check cannot decide: an unapplied
  // or kinded trait parameter, a method-level generic. They become
  // `CtUnknown`, which matches anything.
  open_names: Array[String];
  // Trait parameters the impl head applies (`impl Iter[Int] for P`).
  applied_names: Array[String];
  applied_types: Array[Type];
  // The impl's own formals, kept rigid.
  impl_names: Array[String]
}

fn applied_index(scope: ExpectedScope, name: String) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(scope.applied_names) && found < 0 {
    if Array::get(scope.applied_names, i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Is `name` a type this module can name? Anything else -- typically a type
/// the trait's own module declares but this one does not import -- resolved
/// to a rigid placeholder that would compare by spelling, so it is left open
/// rather than refusing an impl over a name this check cannot see.
fn known_type_name(scope: ExpectedScope, name: String) -> Bool {
  match find_typedef(scope.defs, name) {
    Some(_) => true,
    None => is_builtin_type_name(name) || match compiler_owned_type_arity(name) {
      Some(_) => true,
      None => false
    }
  }
}

fn fill_expected(scope: ExpectedScope, ty: Type) -> Type {
  match ty {
    CtNamed(name, args) => if name == "Self" && Array::length(args) == 0 {
      scope.self_ty
    } else if string_list_has(scope.open_names, name) {
      CtUnknown
    } else {
      let at = applied_index(scope, name)
      if at >= 0 {
        if Array::length(args) == 0 {
          Array::get(scope.applied_types, at)
        } else {
          CtUnknown
        }
      } else if string_list_has(scope.impl_names, name) {
        if Array::length(args) == 0 {
          ty
        } else {
          CtUnknown
        }
      } else if known_type_name(scope, name) {
        CtNamed(name, for a in args {
          fill_expected(scope, a)
        })
      } else {
        CtUnknown
      }
    },
    CtArray(elem) => CtArray(fill_expected(scope, elem)),
    CtOption(elem) => CtOption(fill_expected(scope, elem)),
    CtTuple(items) => CtTuple(for item in items {
      fill_expected(scope, item)
    }),
    CtFn(params, ret, eff) => CtFn(for p in params {
      fill_expected(scope, p)
    }, fill_expected(scope, ret), eff),
    CtRecord(fields) => CtRecord(for field in fields {
      let (fname, fty) = field
      (fname, fill_expected(scope, fty))
    }),
    // A higher-kinded application, a bare constructor and a quantified type
    // are not compared here: the kinded binders they come from have no
    // value-level spelling this check could hold the impl to.
    CtApplied(_, _) => CtUnknown,
    CtConstructor(_, _) => CtUnknown,
    CtForAll(_, _, _) => CtUnknown,
    _ => ty
  }
}

fn method_declared_here(methods: Array[(String, Array[TypeExpr], TypeExpr)], method: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(methods) && !found {
    let (mname, _, _) = Array::get(methods, i)
    found = mname == method
    i = i + 1
  }
  found
}

//# Check

/// #3538: hold an impl method to the signature its trait declares.
///
/// A call through the trait (`Name::name(p, 1)`, or `T::name` under a bound)
/// is checked against the TRAIT's signature and then dispatched to the impl's
/// function, so an impl that disagrees with it is never checked at all: a
/// `String` parameter received an `Int` (`String::length` of it printed
/// `24690`), a `-> Int` return was read as a `String`, an extra parameter
/// trapped, and an impl's `with Console` let a pure generic caller print.
///
/// Refused here, each with the edit: a method the trait does not declare (in
/// an applied impl; see the `None` arm for a plain one); a different number
/// of parameters; a parameter or return type the trait's
/// signature (with `Self`, applied trait arguments and the impl's formals
/// substituted) does not admit; and a `with` clause, because a trait method
/// declares no effects, so a caller through the trait authorizes none.
///
/// What is NOT compared, and stays as it was: a position that mentions a trait
/// parameter the impl head leaves unapplied (it is erased, and the impl may
/// spell it as anything), a kinded parameter or a higher-kinded application,
/// a method-level generic, a type this module cannot name, and every position
/// of an impl whose own formals are kinded. Those are `CtUnknown` on the
/// expected side, so they never refuse a program.
///
/// `vt` is the method's inferred type before generalization and `s` its
/// substitution; the unification here is a probe and is discarded, so the
/// method's own typing is unchanged.
export fn check_impl_method_signature(origin: ImplMethodOrigin, binding_name: String, val: Expr, vt: Type, s: Subst, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let owner_prefix = String::concat(impl_method_owner(origin.tparams, origin.trait_key, origin.target), "::")
  let method = String::substring(binding_name, String::length(owner_prefix), String::length(binding_name))
  let owner = impl_target_head(origin.target)
  let trait_head = trait_ref_name(origin.trait_key)
  let trait_disp = trait_reference_display(origin.trait_key)
  let shown = String::join(["`", owner, "::", method, "`"], "")
  match trait_definition(env, origin.trait_key) {
    None => (),
    Some(def) => {
      let (_, own_methods, trait_tparams, _) = def
      match trait_method_sig_binders_deep(env, origin.trait_key, method) {
        // A method the trait does not declare. Refused only where the binding
        // name proves it was written inside the impl block: an applied impl's
        // owner (`Box$impl$..`) is a name no declaration can spell. A plain
        // impl's method is `let P::m = ..`, the same statement `fn P::m` lowers
        // to, and a free function right after the block would be refused with
        // it -- so that case stays accepted until the parser records which
        // bindings an impl block produced.
        None => if String::contains(owner_prefix, "$impl$") {
          Array::push(errors, String::join([
            "remove method `",
            method,
            "` from `impl ",
            trait_disp,
            " for ",
            print_type_expr(origin.target),
            "`, or declare it in trait `",
            trait_head,
            "`: the trait declares no method `",
            method,
            "`, so nothing can call it through the trait",
            impl_method_marker(trait_head, owner, method, "name", "")
          ], ""))
        } else {
          ()
        },
        Some(found) => {
          let (sparams, sret, binders) = found
          // Only a method body is checked: a non-function binding that shares
          // the owner prefix (`let P::k = ..` after a body-less impl) is not
          // an implementation of anything.
          let (params, eff) = match val {
            EFn(_, _, ps, _, e, _) => (ps, e),
            _ => return
          }
          let declares = String::join([
            ": trait `",
            trait_disp,
            "` declares `",
            signature_text(method, sparams, sret),
            "`"
          ], "")
          let n_impl = Array::length(params)
          let n_trait = Array::length(sparams)
          if n_impl > n_trait {
            let (extra_raw, _) = Array::get(params, n_trait)
            let extra = param_base(extra_raw)
            Array::push(errors, String::join([
              "remove parameter `",
              extra,
              "` from ",
              shown,
              declares,
              ", which takes ",
              plural_parameters(n_trait),
              impl_method_marker(trait_head, owner, method, "param", extra)
            ], ""))
          } else if n_impl < n_trait {
            Array::push(errors, String::join([
              "add ",
              plural_parameters(n_trait - n_impl),
              " to ",
              shown,
              declares,
              ", which takes ",
              plural_parameters(n_trait),
              impl_method_marker(trait_head, owner, method, "name", "")
            ], ""))
          } else {
            // The row: a trait method declares no effects.
            let labels = row_labels(eff)
            if Array::length(labels) > 0 {
              let row = String::join(labels, ", ")
              Array::push(errors, String::join([
                "remove `with ",
                row,
                "` from ",
                shown,
                declares,
                ", which performs no effects; a caller through the trait does not authorize `",
                row,
                "`",
                impl_method_marker(trait_head, owner, method, "row", "")
              ], ""))
            } else {
              ()
            }
            let kinded_impl = {
              let mut k = false
              for tp in origin.tparams {
                if type_param_arity(tp) > 0 {
                  k = true
                } else {
                  ()
                }
              }
              k
            }
            if !kinded_impl {
              let impl_names: Array[String] = []
              for tp in origin.tparams {
                Array::push(impl_names, type_param_name(tp))
              }
              // Trait parameters the impl head applies are substituted when
              // the method is declared by THIS trait (not inherited from a
              // supertrait with formals of its own) and none is kinded.
              let applied_args = trait_ref_args(origin.trait_key)
              let applied_names: Array[String] = []
              let applied_types: Array[Type] = []
              let substitutable = Array::length(applied_args) > 0 && Array::length(applied_args) == Array::length(trait_tparams) && method_declared_here(own_methods, method) && {
                let mut all_plain = true
                for tp in trait_tparams {
                  if type_param_arity(tp) > 0 {
                    all_plain = false
                  } else {
                    ()
                  }
                }
                all_plain
              }
              if substitutable {
                let mut ai = 0
                while ai < Array::length(applied_args) {
                  Array::push(applied_names, type_param_name(Array::get(trait_tparams, ai)))
                  ai = ai + 1
                }
              } else {
                ()
              }
              let open_names: Array[String] = []
              for b in binders {
                let bname = type_param_name(b)
                if !string_list_has(applied_names, bname) {
                  Array::push(open_names, bname)
                } else {
                  ()
                }
              }
              let shadow: Array[String] = ["Self"]
              for b in binders {
                Array::push(shadow, type_param_name(b))
              }
              for n in impl_names {
                Array::push(shadow, n)
              }
              let raw_self = resolve_type_expr_shadowed(origin.target, defs, impl_names)
              let pre_scope = ExpectedScope::{
                defs: defs,
                self_ty: CtUnknown,
                open_names: open_names,
                applied_names: [],
                applied_types: [],
                impl_names: impl_names
              }
              let self_ty = match raw_self {
                CtConstructor(_, _) => CtUnknown,
                CtApplied(_, _) => CtUnknown,
                _ => fill_expected(pre_scope, raw_self)
              }
              if substitutable {
                for a in applied_args {
                  Array::push(applied_types, fill_expected(pre_scope, resolve_type_expr_shadowed(a, defs, impl_names)))
                }
              } else {
                ()
              }
              let scope = ExpectedScope::{
                defs: defs,
                self_ty: self_ty,
                open_names: open_names,
                applied_names: applied_names,
                applied_types: applied_types,
                impl_names: impl_names
              }
              let actual = match subst_apply(s, vt) {
                CtForAll(_, _, body) => body,
                other => other
              }
              match actual {
                CtFn(aparams, aret, _) => if Array::length(aparams) == n_trait {
                  let mut cur = s
                  let mut pi = 0
                  while pi < n_trait {
                    let want = fill_expected(scope, resolve_type_expr_shadowed(Array::get(sparams, pi), defs, shadow))
                    match unify(want, Array::get(aparams, pi), cur) {
                      Some(next) => {
                        cur = next
                      },
                      None => {
                        let (raw, _) = Array::get(params, pi)
                        let pname = param_base(raw)
                        Array::push(errors, String::join([
                          "change parameter `",
                          pname,
                          "` of ",
                          shown,
                          " to `",
                          type_to_string(want),
                          "`",
                          declares,
                          impl_method_marker(trait_head, owner, method, "param", pname)
                        ], ""))
                      }
                    }
                    pi = pi + 1
                  }
                  let want_ret = fill_expected(scope, resolve_type_expr_shadowed(sret, defs, shadow))
                  match unify(want_ret, aret, cur) {
                    Some(_) => (),
                    None => Array::push(errors, String::join([
                      "change the return type of ",
                      shown,
                      " to `",
                      type_to_string(want_ret),
                      "`",
                      declares,
                      impl_method_marker(trait_head, owner, method, "ret", "")
                    ], ""))
                  }
                } else {
                  ()
                },
                _ => ()
              }
            } else {
              ()
            }
          }
        }
      }
    }
  }
}
