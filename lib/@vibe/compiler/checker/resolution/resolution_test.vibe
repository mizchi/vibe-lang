import @vibe/compiler/core {
  TypeExpr
}
import @vibe/compiler/checker/resolution {
  collect_unknown_type_names
}

test "type-name resolution honors bound formals and reports unknown heads" {
  let errors: Array[String] = []
  collect_unknown_type_names(te = TyApp("Array", [TyName("T")]), defs = [], shadow = ["T"], out = errors)
  inspect(errors, content = "[]")
  collect_unknown_type_names(te = TyName("Missing"), defs = [], shadow = [], out = errors)
  inspect(errors, content = "[Missing]")
}
