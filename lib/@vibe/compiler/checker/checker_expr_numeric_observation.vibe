import @vibe/compiler/core {
  Expr, Subst, Type, TypeDef, TypeEnv, bound_flat_self_add, subst_apply, subst_bounds_for
}
import @vibe/compiler/checker/diagnostics {
  off_marker
}
import @vibe/compiler/checker/traits {
  bound_entails_trait
}
import ./checker_infer_binop_type.vibe {
  TypedOccurrenceRoleLaneCapture, infer_binop_type, record_float_arith, record_string_binop_operands
}
import ./checker_eq_function_operand.vibe {
  eq_function_operand_refusal, eq_operand_is_nullary_ctor
}
import ./checker_int32_rows.vibe {
  int32_binop_operands, record_int32_binop
}
import ./checker_lambda_expr.vibe {
  open_formal_name_for_var
}

/// #3629: is `op` a `Double` / `Float` operation -- arithmetic whose result
/// the checker typed as one, or an ordering whose operands it did?
///
/// Code generation picks float arithmetic from the operands' SYNTAX, and the
/// desugar sends `+` and `<` on an operand whose static type it reads as a
/// type formal to the runtime Int/String dispatch. A call to a generic
/// function reads as its callee's own formal there (`pick[T](x: T) -> T`
/// is `T`), so `pick(2.5) + 1.0` added the boxed Double's bits as an Int and
/// printed `537`. The row this answer files makes the post-check rewrite mark
/// both operands as floats (`rewrite_float_arith_stmts`), so neither lowering
/// has to see the type in the syntax. A result typed `Double` or `Float` is
/// concrete by construction -- the Int candidate is tried first -- so no later
/// substitution can change the answer. `==` is not filed: the typed-`==`
/// channel already compares a `Double` through its own rows.
export fn float_operand_binop(op: String, result: Type, left: Type, right: Type) -> Bool {
  if op == "+" || op == "-" || op == "*" || op == "/" {
    ty_is_float_scalar(result)
  } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
    ty_is_float_scalar(left) || ty_is_float_scalar(right)
  } else {
    false
  }
}

fn ty_is_float_scalar(_ t: Type) -> Bool {
  match t {
    CtDouble => true,
    CtFloat => true,
    _ => false
  }
}

// Store the OPEN lexical formal now: resolving a callee's spelling later can
// mistake its T for the caller's T. Kind 13 shares the paired typed-row carrier.
export fn record_add_formal(capture: Option[TypedOccurrenceRoleLaneCapture], off: Int, ty: Type, env: TypeEnv, s: Subst) -> Unit {
  match capture {
    Some(c) => if !c.provenance_enabled && off >= 0 {
      match ty {
        CtVar(id) => {
          let name = add_formal_for_type(ty = CtVar(id), env = env, s = s)
          if name != "" {
            Array::push(c.binop_offsets, value = off)
            Array::push(c.binop_kinds, value = 13)
            Array::push(c.binop_types, value = CtNamed(name, []))
            Array::push(c.binop_offsets, value = off)
            Array::push(c.binop_kinds, value = 13)
            Array::push(c.binop_types, value = CtNamed(name, []))
          }
        },
        _ => ()
      }
    },
    None => ()
  }
}

/// #3825: a generic call's type variable `vid`, bounded by `bounds`, at the
/// callee's offset `off`, when one of the bounds entails `Add` (kind 22, a
/// pair like every row of the carrier). Its type is read against the final
/// substitution when the rows are extracted, so an `Int32` / `UInt32`
/// instantiation files the row that makes the call's witness wrap.
export fn record_add32_call(capture: Option[TypedOccurrenceRoleLaneCapture], off: Int, vid: Int, bounds: Array[String], env: TypeEnv) -> Unit {
  match capture {
    Some(c) => if !c.provenance_enabled && off >= 0 && Array::any(bounds, f = (b) -> bound_entails_trait(env = env, bound = b, wanted = "Add")) {
      Array::push(c.binop_offsets, value = off)
      Array::push(c.binop_kinds, value = 22)
      Array::push(c.binop_types, value = CtVar(vid))
      Array::push(c.binop_offsets, value = off)
      Array::push(c.binop_kinds, value = 22)
      Array::push(c.binop_types, value = CtVar(vid))
    },
    None => ()
  }
}

/// #2501: the receiver head of a dot-method call the checker resolved to a
/// program function `<head>::<method>` (kind 23, a pair like every row of the
/// carrier), filed at the method name's offset. The lowering builds the
/// qualified call from this head instead of recovering the receiver's type
/// from its spelling, which knows nothing about a `for` element, a `match`
/// arm binder, a lambda parameter or an unannotated binding of a call result.
export fn record_method_receiver(capture: Option[TypedOccurrenceRoleLaneCapture], off: Int, qualified: String, method: String) -> Unit {
  let head_len = String::length(qualified) - String::length(method) - 2
  match capture {
    Some(c) => if !c.provenance_enabled && off >= 0 && head_len > 0 {
      let name = String::substring(qualified, start = 0, end = head_len)
      let head = CtNamed(name, [])
      Array::push(c.binop_offsets, value = off)
      Array::push(c.binop_kinds, value = 23)
      Array::push(c.binop_types, value = head)
      Array::push(c.binop_offsets, value = off)
      Array::push(c.binop_kinds, value = 23)
      Array::push(c.binop_types, value = head)
    },
    None => ()
  }
}

export fn add_formal_for_type(ty: Type, env: TypeEnv, s: Subst) -> String {
  match ty {
    CtVar(id) => if Array::any(subst_bounds_for(s = s, id = id), f = (b) -> bound_entails_trait(env = env, bound = b, wanted = "Add") && bound_flat_self_add(env = env, bound = b)) {
      open_formal_name_for_var(id = id, s = s)
    } else {
      ""
    },
    _ => ""
  }
}

/// Type the operands and record lowering rows after their types are available.
export fn check_binop_operands(op: String, left: Expr, right: Expr, left_ty: Type, right_ty: Type, env: TypeEnv, defs: Array[TypeDef], s2: Subst, errors: Array[String], tytab: Array[(Int, Type)], capture: Option[TypedOccurrenceRoleLaneCapture], boff: Int, bin_off: Int) -> (Type, Subst) {
  let (left_applied, right_applied) = int32_binop_operands(left = left, right = right, left_ty = left_ty, right_ty = right_ty, s = s2, errors = errors, off = bin_off)
  // #2391 slice 2 / #2435: the typed String-lowering channel. The types
  // recorded here may still be unresolved variables; the extraction
  // resolves them against the FINAL substitution, so a binding unified
  // after this binop still classifies. The recorder anchors on the
  // binop's OWN operator offset (exact identity), with the operand walk
  // only as the fallback for desugar-synthesized binops.
  record_string_binop_operands(capture = capture, op = op, own_off = boff, left = left, right = right, left_ty = left_applied, right_ty = right_applied)
  let (result_ty, s3) = infer_binop_type(op = op, left_ty = left_applied, right_ty = right_applied, env = env, s = s2, errors = errors, tytab = tytab, off = bin_off)
  // #3549: a function has no content to compare, so `==` on a value
  // whose comparator would reach one could only answer by identity.
  let eq_typed = match result_ty {
    CtBool => true,
    _ => false
  }
  // A comparison with a payload-less constructor (`x == None`) decides by
  // the variant alone and never reaches a function.
  if eq_typed && (op == "==" || op == "!=") && !eq_operand_is_nullary_ctor(e = left, defs = defs) && !eq_operand_is_nullary_ctor(e = right, defs = defs) {
    match eq_function_operand_refusal(op = op, operand = left_applied, s = s3, defs = defs) {
      Some(msg) => Array::push(errors, value = String::concat(msg, off_marker(bin_off))),
      None => ()
    }
  } else {
    ()
  }
  let bin_result = subst_apply(s = s3, ty = result_ty)
  record_int32_binop(capture = capture, op = op, result = bin_result, off = boff, errors = errors)
  // #3543: an arithmetic result typed `Float` is rounded to f32 after
  // the checker ran; the row tells the rewrite which operators to wrap.
  match bin_result {
    CtFloat => if op == "+" || op == "-" || op == "*" || op == "/" {
      record_float_arith(capture = capture, off = boff, kind = 9)
    } else {
      ()
    },
    _ => ()
  }
  // #3629: a `Double` / `Float` operation whose operands the lowering
  // may not see as floats (a generic call's result, an index), filed so
  // the post-check rewrite marks them; see `float_operand_binop`.
  if float_operand_binop(op = op, result = bin_result, left = subst_apply(s = s3, ty = left_applied), right = subst_apply(s = s3, ty = right_applied)) {
    record_float_arith(capture = capture, off = boff, kind = 11)
  } else {
    ()
  }
  if op == "+" {
    record_add_formal(capture = capture, off = boff, ty = bin_result, env = env, s = s3)
  }
  (bin_result, s3)
}
