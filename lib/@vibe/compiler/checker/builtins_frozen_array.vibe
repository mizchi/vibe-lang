//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

// #906: FrozenArray[T] fallback builtin signature table -- mirrors
// builtins_builders.vibe's ArrayBuilder table exactly (same reason: arity /
// name recognition for lookup_builtin's identifier-value path). The REAL,
// per-call-site type flow lives in checker.vibe's FrozenArray::* ECall
// branches (from_array/get/length/to_array), same split as ArrayBuilder's
// checker.vibe #938 branches vs. this file's CtUnknown-shaped fallback.

fn frozen_array_no_params() -> Array[Type] {
  array_empty()
}

fn frozen_array_one_param(a: Type) -> Array[Type] {
  let arr = frozen_array_no_params()
  Array::push(arr, a)
  arr
}

fn frozen_array_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = frozen_array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn lookup_frozen_array_from_array(name: String) -> Option[Type] {
  if name == "FrozenArray::from_array" {
    Some(CtFn(frozen_array_one_param(CtArray(CtUnknown)), CtNamed("FrozenArray", frozen_array_one_param(CtUnknown)), None))
  }
  else None
}

fn lookup_frozen_array_get(name: String) -> Option[Type] {
  if name == "FrozenArray::get" {
    Some(CtFn(frozen_array_two_params(CtNamed("FrozenArray", frozen_array_one_param(CtUnknown)), CtInt), CtUnknown, None))
  }
  else None
}

fn lookup_frozen_array_length(name: String) -> Option[Type] {
  if name == "FrozenArray::length" {
    Some(CtFn(frozen_array_one_param(CtNamed("FrozenArray", frozen_array_one_param(CtUnknown))), CtInt, None))
  }
  else None
}

fn lookup_frozen_array_to_array(name: String) -> Option[Type] {
  if name == "FrozenArray::to_array" {
    Some(CtFn(frozen_array_one_param(CtNamed("FrozenArray", frozen_array_one_param(CtUnknown))), CtArray(CtUnknown), None))
  }
  else None
}

export fn lookup_frozen_array(name: String) -> Option[Type] {
  match lookup_frozen_array_from_array(name) {
    Some(t) => Some(t),
    None => match lookup_frozen_array_get(name) {
      Some(t) => Some(t),
      None => match lookup_frozen_array_length(name) {
        Some(t) => Some(t),
        None => lookup_frozen_array_to_array(name)
      }
    }
  }
}
