// The result type of a function written without one (#4062).

import @vibe/compiler/core {
  Expr,
  Subst,
  Type,
  TypeEnv,
  env_lookup,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  fresh_var,
  subst_apply,
  subst_bind_value,
  unify
}

import @vibe/compiler/checker/resume {
  arm_tail_all_return
}

import @vibe/compiler/checker/type_relations {
  branch_join_widens
}

import ./checker_merge_capture_provenance.vibe {
  merge_value_effect_provenance
}

import ./checker_int32.vibe {
  int32_literal_adapt, int32_literal_can_adapt, int32_literal_value, int32_tail
}

import ./checker_int32_rows.vibe {
  int32_assigned_type
}

import ./checker_closure_capture_row.vibe {
  railway_is_ident, tail_expr_off
}

import ./checker_throw_kind_of_type.vibe {
  railway_expr_off
}

import ./checker_eq_unbounded_formal_msg.vibe {
  check_assignable, check_assignable_set_end, string_lit_end
}

//# Functions

/// The env key under which a function with no written result type binds
/// that result's variable (the same variable as its `__return__`), and a
/// function with one binds `Unit`, so a nested function never sees its
/// enclosing one's.
export fn unwritten_result_key() -> String {
  "#return.unwritten"
}

/// Whether the body `e` of a function holds an explicit `return` of its own
/// (a nested function's are not counted). Only such a function gets a
/// result variable: one with no `return` is typed exactly as before, down to
/// the numbering of its type variables.
export fn body_has_return(_ e: Expr) -> Bool {
  match e {
    EReturn(_) => true,
    EFn(_, _, _, _, _, _) => false,
    _ => {
      let mark = expr_children_push(e)
      let top = expr_children_top()
      let mut i = mark
      let mut found = false
      while !found && i < top {
        found = body_has_return(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

/// The `return`s whose check `check_return_value` left to
/// `check_unwritten_result`: the id of the function's result variable, the
/// returned expression and its checked type. Each function takes only the
/// rows under its own variable, so a nested function's stay its own.
let deferred_returns: Array[(Int, Expr, Type)] = []

fn unwritten_result_id(_ env: TypeEnv) -> Int {
  match env_lookup(env = env, name = unwritten_result_key()) {
    Some(CtVar(id)) => id,
    _ => 0 - 1
  }
}

/// Join an inferred result with a later return path using the same effect
/// row ordering as branches. A written result is checked separately.
fn widen_unwritten_result(id: Int, anchor: Type, later: Type, s: Subst) -> Option[Subst] {
  match branch_join_widens(anchor = anchor, later = later, s = s) {
    Some(ns) => Some(subst_bind_value(id = id, ty = merge_value_effect_provenance(expected = later, actual = anchor, s = ns), s = ns)),
    None => None
  }
}

/// An explicit `return e`, whose value checked as `et`, against the nearest
/// enclosing function's result (`__return__`).
///
/// #4062: in a function with no written result type that result is a
/// variable, so the check's substitution is kept: the first `return` binds
/// it, and every other one and the body's value join with it
/// (`check_unwritten_result`). A value whose integer literals could still
/// take a sized type (`0`, `Some(0)`, `[1, 2]`, `(0, "a")`, an `if` of such)
/// is left to that final check, because its type is the one the rest of the
/// function settles on (`return Some(0)` beside a `Some(k)` tail of an
/// `Int32` is an `Option[Int32]`). Under a written result type the
/// substitution is dropped, as it always was.
export fn check_return_value(e: Expr, et: Type, env: TypeEnv, s: Subst, errors: Array[String]) -> Subst {
  match env_lookup(env = env, name = "__return__") {
    Some(rt) => {
      let rte = subst_apply(s = s, ty = rt)
      let ate = subst_apply(s = s, ty = et)
      // #1947: `?` lowers to `return None`. The EMatch railway hook
      // reports that in source-level terms; do not also emit
      // `got Option[?]` against the synthetic None.
      let skip_railway_none = match env_lookup(env = env, name = "__railway_q__") {
        Some(_) => railway_is_ident(e = e, want = "None"),
        None => false
      }
      let unwritten = unwritten_result_id(env)
      if skip_railway_none {
        s
      } else if unwritten >= 0 && int32_literal_can_adapt(e = int32_tail(e), actual = ate) {
        Array::push(deferred_returns, value = (unwritten, e, ate))
        s
      } else {
        let widened = if unwritten >= 0 {
          widen_unwritten_result(id = unwritten, anchor = rte, later = ate, s = s)
        } else {
          None
        }
        match widened {
          Some(ns) => ns,
          None => {
            // Anchor on the returned value, as for the implicit tail.
            check_assignable_set_end(string_lit_end(e))
            let ns = check_assignable(expected = rte, actual = int32_assigned_type(e = e, expected = rte, actual = ate, s = s, errors = errors, off = railway_expr_off(e)), s = s, errors = errors, what = "return type mismatch", off = railway_expr_off(e))
            if unwritten >= 0 {
              ns
            } else {
              s
            }
          }
        }
      }
    },
    None => s
  }
}

/// Take the deferred `return`s of the function whose result variable is
/// `result`, in the order they were checked.
fn take_deferred_returns(_ result: Type) -> Array[(Expr, Type)] {
  let out: Array[(Expr, Type)] = []
  match result {
    CtVar(id) => {
      let kept: Array[(Int, Expr, Type)] = []
      for row in deferred_returns {
        let (rid, e, t) = row
        if rid == id {
          Array::push(out, value = (e, t))
        } else {
          Array::push(kept, value = row)
        }
      }
      Array::truncate(deferred_returns, length = 0)
      for row in kept {
        Array::push(deferred_returns, value = row)
      }
    },
    _ => ()
  }
  out
}

/// Build a result constraint while leaving adaptable Int literals open.
fn return_literal_constraint(e: Expr, actual: Type, holes: Array[Type], c: Int) -> (Type, Int) {
  match e {
    EIf(_, then_e, else_e) => {
      let (a, c1) = return_literal_constraint(e = int32_tail(then_e), actual = actual, holes = holes, c = c)
      let (b, c2) = return_literal_constraint(e = int32_tail(else_e), actual = actual, holes = holes, c = c1)
      match unify(a = a, b = b, s = SubstEmpty) {
        Some(s) => (subst_apply(s = s, ty = a), c2),
        None => (actual, c2)
      }
    },
    _ => match actual {
      CtInt => if int32_literal_value(e) is Some(_) {
        return_literal_hole(holes = holes, c = c)
      } else {
        (actual, c)
      },
      CtArray(CtInt) => if int32_literal_can_adapt(e = e, actual = actual) {
        let (elem, c1) = return_literal_hole(holes = holes, c = c)
        (CtArray(elem), c1)
      } else {
        (actual, c)
      },
      CtTuple(types) => match e {
        ETuple(items) => if Array::length(items) == Array::length(types) {
          let out: Array[Type] = []
          let mut next = c
          let mut i = 0
          while i < Array::length(items) {
            let (part, c1) = return_literal_constraint(e = Array::get(items, at = i), actual = Array::get(types, at = i), holes = holes, c = next)
            Array::push(out, value = part)
            next = c1
            i = i + 1
          }
          (CtTuple(out), next)
        } else {
          (actual, c)
        },
        _ => (actual, c)
      },
      CtOption(inner) => match e {
        ECall(EIdent("Some", _), args, _, _) => if Array::length(args) == 1 {
          let (part, c1) = return_literal_constraint(e = Array::get(args, at = 0), actual = inner, holes = holes, c = c)
          (CtOption(part), c1)
        } else {
          (actual, c)
        },
        _ => (actual, c)
      },
      _ => (actual, c)
    }
  }
}

fn return_literal_hole(holes: Array[Type], c: Int) -> (Type, Int) {
  let (ty, next) = fresh_var(c)
  Array::push(holes, value = ty)
  (ty, next)
}

fn constrain_return_literal(e: Expr, actual: Type, result: Type, holes: Array[Type], s: Subst, c: Int) -> (Subst, Int) {
  let (constraint, c1) = return_literal_constraint(e = e, actual = subst_apply(s = s, ty = actual), holes = holes, c = c)
  match unify(a = result, b = constraint, s = s) {
    Some(ns) => (ns, c1),
    None => match result {
      CtVar(id) => {
        let anchor = subst_apply(s = s, ty = result)
        let later = subst_apply(s = s, ty = constraint)
        let joined = match widen_unwritten_result(id = id, anchor = anchor, later = later, s = s) {
          Some(ns) => ns,
          // The result already has the wider row. Keep the component
          // substitutions from assigning the narrower return to it.
          None => match branch_join_widens(anchor = later, later = anchor, s = s) {
            Some(ns) => ns,
            None => s
          }
        }
        (joined, c1)
      },
      _ => (s, c1)
    }
  }
}

/// #4062: the result type of a function or lambda that writes none. Its
/// `__return__` is the fresh variable `result`, which the explicit `return`s
/// in the body bound (`check_return_value`); the body's own value `actual` is
/// checked against it here, then every deferred `return`, adapted and
/// range-checked against the type the function settled on. A body with no
/// `return` (whose `result` is not a variable) keeps its value's type,
/// untouched. Before, `__return__` was
/// `CtUnknown` and a `return` was checked against nothing:
/// `(k) -> { if k == 0 { return "oops" }; k }` passed for `(Int) -> Int` and
/// handed its caller a string as an `Int`.
export fn check_unwritten_result(body: Expr, result: Type, actual: Type, s: Subst, c: Int, errors: Array[String]) -> (Type, Subst, Int) {
  let deferred = take_deferred_returns(result)
  let returned = match subst_apply(s = s, ty = result) {
    CtVar(_) => false,
    _ => true
  }
  // `result` is a variable only for a body with a `return` (`body_has_return`).
  if !(result is CtVar(_)) || (!returned && Array::length(deferred) == 0) {
    // No `return` reached the result: it is the body's value, as it always was.
    (subst_apply(s = s, ty = actual), s, c)
  } else {
    let tail = int32_tail(body)
    let has_fallthrough = !arm_tail_all_return(tail)
    let mut inferred = s
    let mut next = c
    if Array::length(deferred) > 0 {
      let holes: Array[Type] = []
      if has_fallthrough {
        let (ns, nc) = constrain_return_literal(e = tail, actual = actual, result = result, holes = holes, s = inferred, c = next)
        inferred = ns
        next = nc
      } else {
        ()
      }
      for d in deferred {
        let (e, t) = d
        let (ns, nc) = constrain_return_literal(e = int32_tail(e), actual = t, result = result, holes = holes, s = inferred, c = next)
        inferred = ns
        next = nc
      }
      for hole in holes {
        match subst_apply(s = inferred, ty = hole) {
          CtVar(id) => inferred = subst_bind_value(id = id, ty = CtInt, s = inferred),
          _ => ()
        }
      }
    } else {
      ()
    }
    let s = inferred
    let s_tail = if has_fallthrough {
      let what = if returned {
        "the value at the end of this function disagrees with its `return`: give them one type, or write the result type"
      } else {
        "return type mismatch"
      }
      let widened = match result {
        CtVar(id) => widen_unwritten_result(id = id, anchor = subst_apply(s = s, ty = result), later = subst_apply(s = s, ty = actual), s = s),
        _ => None
      }
      match widened {
        Some(ns) => ns,
        None => {
          check_assignable_set_end(string_lit_end(body))
          check_assignable(expected = subst_apply(s = s, ty = result), actual = int32_literal_adapt(e = tail, expected = result, actual = subst_apply(s = s, ty = actual), s = s, errors = errors, off = tail_expr_off(body)), s = s, errors = errors, what = what, off = tail_expr_off(body))
        }
      }
    } else {
      // All tail paths were checked at their explicit returns.
      s
    }
    let mut out = s_tail
    for d in deferred {
      let (e, t) = d
      let want = subst_apply(s = out, ty = result)
      check_assignable_set_end(string_lit_end(e))
      out = check_assignable(expected = want, actual = int32_literal_adapt(e = int32_tail(e), expected = want, actual = subst_apply(s = out, ty = t), s = out, errors = errors, off = railway_expr_off(e)), s = out, errors = errors, what = "return type mismatch", off = railway_expr_off(e))
    }
    (subst_apply(s = out, ty = result), out, next)
  }
}
