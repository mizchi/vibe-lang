fn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv
fn check_qualified_pattern_refs(refs: Array[(String, String)], defs: Array[TypeDef], errors: Array[String]) -> Unit
