// @vibe/compiler/checker/patterns — checks a pattern against its scrutinee
// type and binds its names (checker_pattern.vibe), and finds a value a
// `match` does not cover (checker_exhaustive.vibe). Directory-shared-scope
// package.
//
// It reads only @vibe/compiler/core, type-name resolution and the trait
// package, and never calls back into the checker. checker_facade.vibe
// re-exports check_pattern and pat_has_unsupported_or_binding.

// --- checker_exhaustive.vibe
fn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String]

// --- checker_pattern.vibe
