//# Functions

fn min_int(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

/// Encode a real AST char offset into a strippable diagnostic marker so the
/// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode
/// the exact line:col instead of falling back to a first-occurrence text scan.
/// String::concat only (never `+` / interpolation — both mis-codegen to NUL
/// here). off < 0 => no marker (heuristic fallback retained).
fn off_marker(off: Int) -> String {
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// Like off_marker but also encodes the offending token's END offset as
/// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an
/// EXACT source range (line:colC-E) instead of the LSP guessing the token end
/// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan
/// stops at the dot). Falls back to the start-only marker when len <= 0. Use this
/// where `off` is the START of a known-length named token (the symbol whose
/// length matches the source span); keep plain off_marker where the offset is an
/// anchor rather than the token start (e.g. a field error whose offset is the
/// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).
fn off_marker_len(off: Int, len: Int) -> String {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else {
    off_marker(off)
  }
}

/// #1941: a return-type mismatch whose tail is a literal has no `[@off=]`
/// (EInt/EString/EBool/EFloat carry no offset). Tag the enclosing binding
/// name so `locate_type_error` can recover the `fn` / `let` name token
/// instead of falling through to the synthetic `0:0` LSP range. Only
/// rewrites errors that still have no side-channel marker. Exported for
/// checker_stmt's top-level SLet path (the leftover `fn f() -> Int { "s" }`).
export fn attach_unlocated_decl_name_marker(errors: Array[String], from: Int, name: String) -> Unit {
  if String::length(name) == 0 {
    ()
  } else {
    let n = Array::length(errors)
    let mut i = from
    while i < n {
      let msg = Array::get(errors, i)
      // #1941: `binding type mismatch` joins `return type mismatch` here. A
      // top-level `let a: Int = "x"` anchors on the VALUE, and a literal value
      // has no offset -- so that one diagnostic came out with no position at
      // all, while the same code inside a function was located (the local lane
      // goes through `ascribe_wrap`, which carries the binder offset).
      // `find_fn_anchor_off` already prefers `fn name` then `let name`, so the
      // binder is recoverable from the name alone.
      let unlocated = String::index_of(msg, " [@") < 0
      // #2125: `unknown type` is reported from a function literal's parameter
      // and return annotations, which carry no offset of their own -- so it
      // anchors on the declaration name exactly like the two above.
      let anchorable = String::starts_with(msg, "return type mismatch") || String::starts_with(msg, "binding type mismatch for ") || String::starts_with(msg, "unknown type `")
      if anchorable && unlocated {
        Array::set(errors, i, String::concat(msg, String::concat(" [@fn=", String::concat(name, "]"))))
      }
      i = i + 1
    }
  }
}

/// #2125: the env key prefix under which an `impl` method's body carries the
/// trait type parameters its signature may legally leave unbound. One key per
/// NAME, bound only around the value being checked -- never into the
/// environment the statement returns -- so it cannot reach a published or
/// cached env.
let trait_erased_type_param_prefix: String = "__trait_erased_tp__"

/// True when some entry of `methods` declares a method named `method_name`.
fn trait_methods_declare(methods: Array[(String, Array[TypeExpr], TypeExpr)], method_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(methods) && !found {
    let (mname, _, _) = Array::get(methods, i)
    if mname == method_name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// True when `env` records an impl of `trait_name` for the type named
/// `type_name` -- the binder that licenses the trait's erased parameters
/// inside that impl's methods.
fn env_has_trait_impl_for(env: TypeEnv, trait_name: String, type_name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitImpl(tn, target, rest) => (tn == trait_name && type_constructor_name(target) == type_name) || env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitImplGen(tn, _, _, target, rest) => (tn == trait_name && type_constructor_name(target) == type_name) || env_has_trait_impl_for(rest, trait_name, type_name),
    EnvMutCell(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTypeDefs(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvCached(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvFlat(_) => false
  }
}

fn collect_impl_erased_type_params(chain: TypeEnv, full: TypeEnv, type_name: String, method_name: String, out: Array[String]) -> Unit {
  match chain {
    EnvEmpty => (),
    EnvBind(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTraitDef(trait_name, params, _, methods, rest, header_params, _) => {
      if trait_methods_declare(methods, method_name) && env_has_trait_impl_for(full, trait_name, type_name) {
        let mut pi = 0
        while pi < Array::length(params) {
          Array::push(out, Array::get(params, pi))
          pi = pi + 1
        }
        let mut hi = 0
        while hi < Array::length(header_params) {
          Array::push(out, Array::get(header_params, hi))
          hi = hi + 1
        }
        // `Self` is erased the same way (Codex round 4 on #2147): the
        // trait-dict desugar copies the trait signature's parameter types onto
        // the lowered impl-method lambda, so a genuine impl method's `self`
        // parameter arrives annotated `Self` with no binder of its own.
        // Outside this provenance `Self` is a wildcard and is reported.
        Array::push(out, "Self")
      } else {
        ()
      }
      collect_impl_erased_type_params(rest, full, type_name, method_name, out)
    },
    EnvTraitImpl(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTraitImplGen(_, _, _, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvMutCell(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTypeDefs(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvCached(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvFlat(_) => ()
  }
}

/// #2125: bind the erased type parameters an IMPL METHOD's signature may
/// legally spell without a binder of its own -- the `T` of
/// `trait Iterator[T]` in `impl Iterator for LazyIter { next(self) ->
/// Option[(T, LazyIter)] }`. The uniform representation erases those
/// parameters and `relax_unknown_named` relaxes every use to `CtUnknown`, so
/// they resolve to nothing and look exactly like a typo.
///
/// Codex on #2147 (round 2): PROVENANCE, not a name shape. `parse_impl_methods`
/// lowers an impl to `let <Type>::<method> = (..) -> ..` emitted after its
/// `SImpl`, so the impl is already in the env when the method is checked --
/// this asks the env the question the impl answers: does a trait in scope
/// declare a method of THIS name, carry type parameters, and have an impl for
/// THIS type? A qualified name alone is not that question, and treating it as
/// one exempted every associated function: `fn Array::bad(x: T) -> Int { 1 }`
/// compiled clean whenever any in-scope trait declared a `T` (measured).
export fn trait_erased_type_param_env(env: TypeEnv, binding_name: String) -> TypeEnv {
  let sep = String::index_of(binding_name, "::")
  if sep < 0 {
    env
  } else {
    let type_name = String::substring(binding_name, 0, sep)
    let method_name = String::substring(binding_name, sep + 2, String::length(binding_name))
    let names = array_empty()
    collect_impl_erased_type_params(env, env, type_name, method_name, names)
    let mut out = env
    let mut i = 0
    while i < Array::length(names) {
      out = env_bind(out, String::concat(trait_erased_type_param_prefix, Array::get(names, i)), CtUnit)
      i = i + 1
    }
    out
  }
}

/// #2125: report every type name in `te` that resolves to NOTHING, so a typo
/// stops behaving as a wildcard. `resolve_type_expr_shadowed` turns such a
/// name into `CtNamed(name, [])` -- the same shape as an un-instantiated
/// generic formal, whose unify failures `check_assignable` must tolerate so as
/// not to over-reject polymorphic code.
///
/// Every exemption below is a BINDER in scope for this annotation, which is
/// the whole rule -- an unresolved name that no binder introduces is a typo:
///
///   1. a type formal. `shadow` is not the authority on what one is: a lambda
///      nested in a generic function resolves its own parameters with its OWN
///      (empty) `tparams`, so the enclosing `T` is invisible there. The env is
///      -- whichever binder introduced the formal bound it to a `CtVar`, which
///      is exactly what `resolve_tparams_in` reads.
///   2. a trait's own erased type parameter, and only where an actual IMPL
///      binds it -- see `trait_erased_type_param_env`, which asks the env for
///      the impl rather than inferring one from the binding's name.
///
/// Those two are TYPES, so they are exempt wherever a type may appear. The
/// other two binders are NOT types, so their exemption is positional as well
/// as name-based -- `collect_unknown_type_names_regionwise` accepts them only
/// in a region-argument slot (Codex round 3 on #2147; before that,
/// `fn f(x: r) -> Int with r { 1 }` accepted both `f(1)` and `f("s")`):
///
///   3. a REGION TOKEN bound by an enclosing `region r { .. }` (ADR-0090),
///      spelled in the region slot of `MutList[Int, r]`. Recognised by the
///      rigid skolem the region binder binds it to (`#region_<n>`, a name no
///      source can spell), NOT by "some value has this name" -- that would let
///      `let Intt = 1` excuse `x: Intt`.
///   4. a region ROW VARIABLE declared by this very signature:
///      `fn fill(l: MutList[Int, r]) -> Unit with r`. Nothing binds `r` as a
///      value there; the binder is the row, so the call site passes its
///      variables in `row_binders`.
export fn report_unknown_type_names(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  // Which of the unresolved names are region-ish binders at all. Asked over
  // the name candidates first because the positional walk below takes a set,
  // and `#region_` skolem membership is an env question this file owns.
  let candidates = array_empty()
  collect_unknown_type_names(te, defs, shadow, candidates)
  let region_binders = array_empty()
  let mut ci = 0
  while ci < Array::length(candidates) {
    let candidate = Array::get(candidates, ci)
    let is_region_token = match env_lookup(env, candidate) {
      Some(t) => match t {
        CtNamed(bound_name, _) => String::starts_with(bound_name, "#region_"),
        _ => false
      },
      None => false
    }
    if (is_region_token || string_array_has(row_binders, candidate)) && !string_array_has(region_binders, candidate) {
      Array::push(region_binders, candidate)
    } else {
      ()
    }
    ci = ci + 1
  }
  let out = array_empty()
  collect_unknown_type_names_regionwise(te, defs, shadow, region_binders, out)
  let mut i = 0
  while i < Array::length(out) {
    let name = Array::get(out, i)
    let is_type_formal = match env_lookup(env, name) {
      Some(t) => match t {
        CtVar(_) => true,
        _ => false
      },
      None => false
    }
    let trait_erased_by_impl = match env_lookup(env, String::concat(trait_erased_type_param_prefix, name)) {
      Some(_) => true,
      None => false
    }
    if is_type_formal || trait_erased_by_impl {
      ()
    } else {
      Array::push(errors, String::concat(String::concat(String::concat("unknown type `", name), "` in "), where_label))
    }
    i = i + 1
  }
}

/// ADR-0090 MutBytes: reject a known-wrong receiver head instead of letting
/// codegen alias the op onto Bytes::* and reinterpret an arbitrary value as
/// a buffer pointer (Codex review on #1801). Unresolved vars and CtUnknown
/// stay tolerant -- enforcement is the "silent when unsure" side (ADR-0100).
fn check_mutbytes_receiver(op: String, zonked: Type, errors: Array[String], callee_off: Int) -> Unit {
  match zonked {
    CtNamed(mb_name, _) => if mb_name == "MutBytes" {
      ()
    } else {
      Array::push(errors, String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(callee_off, String::length(op))))
    },
    CtVar(_) => (),
    CtUnknown => (),
    _ => Array::push(errors, String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(callee_off, String::length(op))))
  }
}

fn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// Replace the abstract `Self` type (resolved as `CtNamed("Self", _)`) inside a
/// trait-method signature with the concrete receiver type, when typing a
/// `T::method` call against a bounded generic parameter T.
fn subst_self_in_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(a, self_ty)
      }
      CtNamed(n, ra)
    },
    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(e, self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(p, self_ty)
    }, subst_self_in_type(ret, self_ty), eff),
    _ => ty
  }
}

/// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->
/// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that
/// resolves to a real type (primitive or declared) is kept; only truly-unknown
/// named types — the trait's own element type params, which the uniform
/// representation erases — are relaxed. (#636.)
fn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs, n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(a, defs)
        })
      } else {
        CtUnknown
      }
    },
    CtArray(e) => CtArray(relax_unknown_named(e, defs)),
    CtOption(e) => CtOption(relax_unknown_named(e, defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(e, defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(p, defs)
    }, relax_unknown_named(r, defs), eff),
    _ => ty
  }
}

/// Resolve a qualified identifier `T::method` where `T` is a bounded generic
/// type parameter (`[T: Trait]`). If the head resolves to a type variable whose
/// recorded bounds include a trait declaring `method`, return that method's
/// signature with `Self` substituted by T. Returns None for any other qualified
/// name (concrete `Type::method`, module-qualified names, etc.) so the existing
/// resolution paths are untouched. (PR-3 component 2.)
fn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let method = String::substring(name, idx + 2, String::length(name))
    match env_lookup(env, head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s, vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_name = Array::get(bounds, bi)
              match trait_method_sig_binders_deep(env, trait_name, method) {
                Some(sig) => {
                  // #1512: the trait header's params and the method's own
                  // generics are binders, so they must shadow `defs` —
                  // otherwise `import { Hue as T }` captures the `T` of
                  // `trait Boxed[T] { unwrap(Self) -> T }`.
                  let (params_te, ret_te, binders) = sig
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(subst_self_in_type(resolve_type_expr_shadowed(pte, defs, binders), self_ty), defs)
                  }
                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr_shadowed(ret_te, defs, binders), self_ty), defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}

/// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,
/// `Sh::Circle`) to the variant's constructor type, confirming that `head`
/// names a known enum that actually owns `member` (so unrelated `T::method`
/// names fall through to the `unknown name` path). Callers instantiate the
/// result exactly like a bare ident. (#672 qualified ctors.)
///
/// #1455: for a MONOMORPHIC enum the constructor type is built from `head`'s
/// own `TDEnum` rather than looked up under the BARE variant name. The old
/// `env_lookup(env, member)` made the qualifier purely cosmetic: it confirmed
/// ownership and then took whatever the flat, last-registered-wins env had
/// under `member`, so `A::Mk` and `B::Mk` resolved to the same type and a
/// qualified reference could not disambiguate anything. Building from the
/// `TDEnum` reproduces exactly what the SEnum arm binds for a local enum
/// (`CtEnum(name)` nullary, `CtFn(payloads, CtEnum(name), None)` otherwise)
/// and additionally works for an IMPORTED enum, whose bare constructors are in
/// the env but whose variant list only reaches this module through
/// `enum_def_env_name`.
///
/// A PARAMETERIZED enum validates ownership through `TDEnum` and then uses
/// the imported bare constructor's checked `CtForAll` scheme. The historical
/// `Enum::__variants__` carrier is deliberately not an authority source.
fn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef], c: Int) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    match find_enum_typedef(defs, head) {
      Some(TDEnum(ename, params, variants)) => {
        let mut found = false
        let mut payloads = array_empty()
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          if vname == member {
            found = true
            payloads = vtypes
          } else {
            ()
          }
          vi = vi + 1
        }
        if found {
          if Array::length(params) == 0 {
            if Array::length(payloads) == 0 {
              Some(CtEnum(ename))
            } else {
              Some(CtFn(payloads, CtEnum(ename), constructor_dependency_row(Array::length(payloads))))
            }
          } else {
            // The imported bare constructor is the checked `CtForAll` scheme.
            // `Enum::__variants__` is legacy data only and is never consulted
            // for authority, so a corrupt carrier cannot override EnvTypeDefs.
            env_lookup(env, member)
          }
        } else {
          None
        }
      },
      _ => None
    }
  }
}

/// Legacy carrier decoder path retained for compatibility with its isolated
/// codec tests. No checker/import path calls it; EnvTypeDefs is authoritative.
fn resolve_qualified_parameterized_ctor(ename: String, params: Array[String], member: String, env: TypeEnv, c: Int) -> Option[Type] {
  match env_lookup(env, enum_def_env_name(ename)) {
    Some(carrier) => match decode_enum_def(carrier) {
      Some((carrier_params, carrier_variants)) => {
        // The carrier and the `TDEnum` must agree on the arity, or the
        // substitution below would leave a formal unbound. They disagree only
        // if the two were written by different declarations of the same name,
        // which is exactly when guessing is wrong.
        if Array::length(carrier_params) != Array::length(params) {
          env_lookup(env, member)
        } else {
          let param_var_ids = array_empty()
          let param_var_types = array_empty()
          let mut pi = 0
          while pi < Array::length(carrier_params) {
            Array::push(param_var_ids, c + pi)
            Array::push(param_var_types, CtVar(c + pi))
            pi = pi + 1
          }
          let result_ty = CtNamed(ename, param_var_types)
          let mut found = false
          let mut payloads = array_empty()
          let mut vi = 0
          while vi < Array::length(carrier_variants) {
            let (vname, vtypes) = Array::get(carrier_variants, vi)
            if vname == member {
              found = true
              payloads = vtypes
            } else {
              ()
            }
            vi = vi + 1
          }
          if found {
            let subst_payloads = for pt in payloads {
              subst_type_params(pt, carrier_params, param_var_types)
            }
            let ctor_ty = if Array::length(subst_payloads) == 0 {
              result_ty
            } else {
              CtFn(subst_payloads, result_ty, None)
            }
            Some(CtForAll(param_var_ids, array_empty(), ctor_ty))
          } else {
            // The `TDEnum` says the variant exists but the carrier does not
            // list it. Do not invent a scheme for it.
            None
          }
        }
      },
      None => env_lookup(env, member)
    },
    None => env_lookup(env, member)
  }
}

fn expr_ident_name_or_empty(expr: Expr) -> String {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}

/// Erase every effect annotation in a type (recursively), so an argument can be
/// checked for STRUCTURAL compatibility independent of effects. Effects on
/// function VALUES are inferred imprecisely (a `with Exception` callback often
/// arrives typed with no effect), so an effect-only difference must not be
/// reported as a type error — only the structural shape is enforced here.
fn strip_effects(ty: Type) -> Type {
  match ty {
    CtFn(params, ret, _) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, strip_effects(Array::get(params, i)))
        i = i + 1
      }
      CtFn(out, strip_effects(ret), None)
    },
    CtArray(elem) => CtArray(strip_effects(elem)),
    CtOption(elem) => CtOption(strip_effects(elem)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, strip_effects(Array::get(elems, i)))
        i = i + 1
      }
      CtTuple(out)
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, strip_effects(Array::get(args, i)))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => ty
  }
}

/// True when a type is fully ground (mentions no type parameter / type
/// variable). An unresolved type name resolves to `CtNamed(_, _)` (see
/// resolve_type_expr), which for a struct field or function parameter means a
/// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used
/// both to restrict record struct-identity recovery to MONOMORPHIC structs (a
/// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`
/// relies on) and to gate structural-mismatch reporting to concrete types.
/// #635: does a match-arm body DIVERGE (early-`return`), yielding no value to the
/// match? The `?`-operator desugar lowers `val?` to
///   match val { Some(v) => v, None => return None }
/// whose `None` arm is `return None` — it must not force the match's result type
/// (else `T` vs `Option[T]` clashes). A diverging arm is a bare `return`, or a
/// block (`ESeq`) whose final expr diverges.
fn arm_body_diverges(body: Expr) -> Bool {
  match body {
    EReturn(_) => true,
    ESeq(_, rest) => arm_body_diverges(rest),
    _ => false
  }
}

// #1324 removed the #941 `railway_head` / `railway_heads_conflict` pair,
// which reported an Option-vs-Result head conflict on one railway. `Result`
// is no longer a language- or prelude-provided type, so `?`/`let*` lower only
// to `Option` and there is no second built-in monad to conflict with.
//
// The mismatch #941 was written for is still reported: a `?` / `let*`
// inside a function that does not return Option is caught by the #1947
// railway-origin hook (source-level `?` / `let*` message), not by the
// generic `return None` / `Option[?]` debris of the desugar.

/// Best-effort source anchor for a (possibly desugar-generated) expr — the
/// first real char offset found walking into the value position, or -1. The
/// railway desugar (#635) threads the `?`/`let*` operand's offset into its
/// generated `None` failure-track nodes, so a diagnostic on desugar output
/// still locates at the offending operand.
fn railway_expr_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      railway_expr_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(base)
    },
    EBinOp(_, lhs, _) => railway_expr_off(lhs),
    EMatch(scrut, _) => railway_expr_off(scrut),
    ESeq(first, _) => railway_expr_off(first),
    _ => 0 - 1
  }
}

/// Source anchor for a function BODY's implicit return -- the value the return
/// type is checked against. `railway_expr_off` walks into an `ESeq`'s FIRST
/// arm, which is the right anchor for a desugar operand but the wrong one here:
/// in `{ setup(); compute() }` the return value is `compute()`, so a diagnostic
/// anchored on `setup()` would point at a line that is not the problem. Descend
/// to the tail first, then reuse the ordinary walk.
///
/// A statement body is not only `ESeq`: `let`/`let mut` parse as an `ELet`
/// whose THIRD field is the rest of the block, so `{ let _ = setup(); mk() }`
/// is `ELet(_, setup(), mk(), _)` and stopping at `ESeq` alone would miss the
/// tail entirely (and, via railway_expr_off's ELet-less fallback, report no
/// location at all).
fn tail_expr_off(e: Expr) -> Int {
  match e {
    ESeq(_, rest) => tail_expr_off(rest),
    ELet(_, _, rest, _) => tail_expr_off(rest),
    ELetRec(_, _, rest) => tail_expr_off(rest),
    ELetMut(_, _, rest, _) => tail_expr_off(rest),
    _ => railway_expr_off(e)
  }
}

/// #1947: classify a two-arm match as a lowered railway. The pre-check
/// desugar (`lower_try_op` / `lower_try_bind`) is the only producer of
/// these shapes. Origin markers, not source shape: `__try_v` is postfix
/// `?`, `__try_none` is `let*`. A user-written
/// `match o { Some(v) => ..., None => None }` is never a railway, even
/// when `compile_source` used `parse_program` and every offset is -1.
///   0 = not a railway desugar
///   1 = postfix `?`  (`Some(__try_v) => __try_v, None => return None`)
///   2 = `let*`       (`Some(name) => rest, None => __try_none`)
fn railway_pat_none(p: Pat) -> Bool {
  match p {
    PCtor(n, args) => n == "None" && Array::length(args) == 0,
    _ => false
  }
}

fn railway_pat_is_some_try_v(p: Pat) -> Bool {
  match p {
    PCtor(n, args) => n == "Some" && Array::length(args) == 1 && match Array::get(args, 0) {
      PBind(name) => name == "__try_v",
      _ => false
    },
    _ => false
  }
}

fn railway_pat_is_some_bind(p: Pat) -> Bool {
  match p {
    PCtor(n, args) => n == "Some" && Array::length(args) == 1 && match Array::get(args, 0) {
      PBind(_) => true,
      _ => false
    },
    _ => false
  }
}

fn railway_is_ident(e: Expr, want: String) -> Bool {
  match e {
    EIdent(n, _) => n == want,
    _ => false
  }
}

/// `let*` lowers the failure arm to `__try_none` (see `lower_try_bind`).
/// Type it as the prelude `None` constructor; the name itself is only an
/// origin marker.
fn railway_ident_lookup_name(name: String) -> String {
  if name == "__try_none" {
    "None"
  } else {
    name
  }
}

fn railway_is_return_none(e: Expr) -> Bool {
  match e {
    EReturn(inner) => railway_is_ident(inner, "None"),
    _ => false
  }
}

fn railway_kind_from_match(scrutinee: Expr, arms: Array[(Pat, Expr)]) -> Int {
  if Array::length(arms) != 2 {
    0
  } else {
    let (p0, b0) = Array::get(arms, 0)
    let (p1, b1) = Array::get(arms, 1)
    if !railway_pat_none(p1) {
      0
    } else if railway_pat_is_some_try_v(p0) && railway_is_ident(b0, "__try_v") && railway_is_return_none(b1) {
      1
    } else if railway_pat_is_some_bind(p0) && railway_is_ident(b1, "__try_none") {
      2
    } else {
      0
    }
  }
}

fn railway_none_off_from_arms(arms: Array[(Pat, Expr)]) -> Int {
  if Array::length(arms) < 2 {
    0 - 1
  } else {
    let (_, b1) = Array::get(arms, 1)
    match b1 {
      EReturn(inner) => railway_expr_off(inner),
      _ => railway_expr_off(b1)
    }
  }
}

fn type_is_option_head(t: Type) -> Bool {
  match t {
    CtOption(_) => true,
    CtNamed(n, _) => n == "Option",
    _ => false
  }
}

fn type_is_concrete_non_option(t: Type) -> Bool {
  if type_is_option_head(t) {
    false
  } else {
    match t {
      CtUnknown => false,
      CtVar(_) => false,
      CtNamed(_, _) => type_fully_concrete(t),
      _ => true
    }
  }
}

fn railway_origin_env(env: TypeEnv, kind: Int) -> TypeEnv {
  if kind == 1 {
    env_bind(env, "__railway_q__", CtUnit)
  } else if kind == 2 {
    env_bind(env, "__railway_star__", CtUnit)
  } else {
    env
  }
}

fn railway_op_spelling(kind: Int) -> String {
  if kind == 1 {
    "?"
  } else {
    "let*"
  }
}

fn railway_anchor_off(arms: Array[(Pat, Expr)], scrutinee: Expr) -> Int {
  let none_off = railway_none_off_from_arms(arms)
  if none_off >= 0 {
    none_off
  } else {
    railway_expr_off(scrutinee)
  }
}

fn railway_wrong_context_msg(kind: Int, off: Int) -> String {
  let op = railway_op_spelling(kind)
  let head = String::concat("`", String::concat(op, "` requires an Option-returning function; change the return type to Option[...], or handle the Option with `match` instead of `"))
  String::concat(head, String::concat(op, String::concat("`", off_marker(off))))
}

fn railway_not_option_msg(kind: Int, got: String, off: Int) -> String {
  let op = railway_op_spelling(kind)
  let head = String::concat("`", String::concat(op, "` unwraps an Option; this expression is "))
  let mid = String::concat(got, " — handle it with `match`, or only use `")
  let tail = String::concat(op, String::concat("` on an Option value", off_marker(off)))
  String::concat(head, String::concat(mid, tail))
}

fn railway_wrap_some_msg(off: Int) -> String {
  String::concat("`let*` short-circuits with None, so the rest of the block must also produce an Option — wrap the result in Some(...)", off_marker(off))
}

fn report_railway_after_arms(kind: Int, env: TypeEnv, s: Subst, result_ty: Type, arms: Array[(Pat, Expr)], scrutinee: Expr, errors: Array[String]) -> Unit {
  let off = railway_anchor_off(arms, scrutinee)
  if kind == 1 {
    match env_lookup(env, "__return__") {
      Some(rt) => if type_is_concrete_non_option(subst_apply(s, rt)) {
        Array::push(errors, railway_wrong_context_msg(1, off))
      } else {
        ()
      },
      None => ()
    }
  } else if kind == 2 {
    match env_lookup(env, "__return__") {
      Some(rt) => if type_is_concrete_non_option(subst_apply(s, rt)) {
        Array::push(errors, railway_wrong_context_msg(2, off))
      } else if type_is_concrete_non_option(subst_apply(s, result_ty)) {
        Array::push(errors, railway_wrap_some_msg(off))
      } else {
        ()
      },
      None => if type_is_concrete_non_option(subst_apply(s, result_ty)) {
        Array::push(errors, railway_wrap_some_msg(off))
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

fn type_is_ground(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground(e),
    CtOption(e) => type_is_ground(e),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #1340 (ADR-0071): ground modulo a set of rigid names — a generic effect's
/// declared op return type is usable as the perform's value type when its
/// only non-ground parts are the effect's OWN type params (which the caller
/// substitutes with fresh inference vars before use). Any other CtNamed /
/// CtVar / CtForAll keeps the conservative fresh-var fallback, exactly like
/// type_is_ground does for non-generic effects.
fn type_is_ground_except(t: Type, allowed: Array[String]) -> Bool {
  match t {
    CtNamed(nm, targs) => if Array::length(targs) == 0 {
      let mut found = false
      let mut i = 0
      while i < Array::length(allowed) {
        if Array::get(allowed, i) == nm {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    } else {
      false
    },
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground_except(Array::get(items, i), allowed) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground_except(e, allowed),
    CtOption(e) => type_is_ground_except(e, allowed),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground_except(r, allowed)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground_except(Array::get(ps, i), allowed) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #1081 step 3: does a FULLY-ZONKED type contain a `CtNamed` with exactly
/// this name anywhere in its structure? Used to detect a region skolem
/// (`"#region_<n>"`, unforgeable by parsed source) escaping its
/// `TaskGroup::run` call. The caller must `subst_apply` before calling this
/// — an un-zonked `CtVar` cannot be inspected here (deliberately no
/// substitution lookup: this function has no `Subst` to chase, and the two
/// call sites both already pass zonked input).
fn type_mentions_named(ty: Type, name: String) -> Bool {
  match ty {
    CtNamed(n, targs) => if n == name {
      true
    } else {
      let mut found = false
      let mut i = 0
      while i < Array::length(targs) {
        if type_mentions_named(Array::get(targs, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) {
        if type_mentions_named(Array::get(items, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtArray(e) => type_mentions_named(e, name),
    CtOption(e) => type_mentions_named(e, name),
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, field_ty) = field
        if type_mentions_named(field_ty, name) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtFn(ps, ret, eff) => {
      let mut found = type_mentions_named(ret, name)
      match eff {
        Some(row) => {
          let labels = String::split(row, ",")
          let mut ei = 0
          while ei < Array::length(labels) {
            if String::trim(Array::get(labels, ei)) == name {
              found = true
            }
            ei = ei + 1
          }
        },
        None => ()
      }
      let mut i = 0
      while i < Array::length(ps) {
        if type_mentions_named(Array::get(ps, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtForAll(_, _, body) => type_mentions_named(body, name),
    _ => false
  }
}

fn merge_provenance_row(expected: Option[String], actual: Option[String]) -> Option[String] {
  let labels = match expected {
    Some(row) => for raw in String::split(row, ",") {
      String::trim(raw)
    },
    None => array_empty()
  }
  match actual {
    Some(row) => for raw in String::split(row, ",") {
      let label = String::trim(raw)
      if (String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[") || String::starts_with(label, "#aliasparam[") || String::starts_with(label, "#fieldparam[")) && !string_array_has(labels, label) {
        Array::push(labels, label)
      }
    },
    None => array_empty()
  }
  if Array::length(labels) == 0 {
    None
  } else {
    Some(String::join(labels, ", "))
  }
}

/// Constructor results retain every payload. Record that dependency in the
/// same checker-only row used by field-projection helpers, so direct,
/// qualified, imported, and first-class enum constructors share one contract.
export fn constructor_dependency_row(arity: Int) -> Option[String] {
  if arity <= 0 {
    None
  } else if arity == 1 {
    Some("#fieldparam[0]")
  } else if arity == 2 {
    Some("#fieldparam[0], #fieldparam[1]")
  } else if arity == 3 {
    Some("#fieldparam[0], #fieldparam[1], #fieldparam[2]")
  } else {
    let labels = array_empty()
    let mut i = 0
    while i < arity {
      Array::push(labels, String::concat("#fieldparam[", String::concat(__to_string(i), "]")))
      i = i + 1
    }
    Some(String::join(labels, ", "))
  }
}

/// An explicit return annotation constrains the public shape but must not
/// erase checker-only capture provenance synthesized on the returned value.
fn merge_capture_provenance(expected: Type, actual: Type) -> Type {
  match expected {
    CtFn(eps, eret, eeff) => match actual {
      CtFn(aps, aret, aeff) => {
        let params = array_empty()
        let mut i = 0
        while i < Array::length(eps) {
          if i < Array::length(aps) {
            Array::push(params, merge_capture_provenance(Array::get(eps, i), Array::get(aps, i)))
          } else {
            Array::push(params, Array::get(eps, i))
          }
          i = i + 1
        }
        CtFn(params, merge_capture_provenance(eret, aret), merge_provenance_row(eeff, aeff))
      },
      _ => expected
    },
    CtArray(ee) => match actual {
      CtArray(ae) => CtArray(merge_capture_provenance(ee, ae)),
      _ => expected
    },
    CtOption(ee) => match actual {
      CtOption(ae) => CtOption(merge_capture_provenance(ee, ae)),
      _ => expected
    },
    CtTuple(es) => match actual {
      CtTuple(as_) => {
        let items = array_empty()
        let mut i = 0
        while i < Array::length(es) {
          if i < Array::length(as_) {
            Array::push(items, merge_capture_provenance(Array::get(es, i), Array::get(as_, i)))
          } else {
            Array::push(items, Array::get(es, i))
          }
          i = i + 1
        }
        CtTuple(items)
      },
      _ => expected
    },
    CtRecord(efields) => match actual {
      CtRecord(afields) => {
        let fields = array_empty()
        let mut i = 0
        while i < Array::length(efields) {
          let (name, field_ty) = Array::get(efields, i)
          let merged = if i < Array::length(afields) {
            let (actual_name, actual_ty) = Array::get(afields, i)
            if name == actual_name {
              merge_capture_provenance(field_ty, actual_ty)
            } else {
              field_ty
            }
          } else {
            field_ty
          }
          Array::push(fields, (name, merged))
          i = i + 1
        }
        CtRecord(fields)
      },
      _ => expected
    },
    CtNamed(name, eargs) => match actual {
      CtNamed(aname, aargs) => if name == aname {
        let args = array_empty()
        let mut i = 0
        while i < Array::length(eargs) {
          if i < Array::length(aargs) {
            Array::push(args, merge_capture_provenance(Array::get(eargs, i), Array::get(aargs, i)))
          } else {
            Array::push(args, Array::get(eargs, i))
          }
          i = i + 1
        }
        CtNamed(name, args)
      } else expected,
      _ => expected
    },
    _ => expected
  }
}

/// #1081 step 3: every (name, type) binding currently visible in `env`,
/// walking the same cons-chain shape `env_cache` (core/types.vibe) already
/// walks — trait-def/impl layers carry no ordinary value binding and are
/// skipped, matching that traversal. Used by the `TaskGroup::run` escape
/// check to scan every OUTER binding (never a binding local to the nursery
/// body itself, since those live in a DERIVED env built while checking the
/// body, not in the `env` captured at the call site) for a leaked region
/// skolem after the body has been checked.
fn collect_env_bindings(env: TypeEnv, acc: Array[(String, Type)]) -> Unit {
  match env {
    EnvEmpty => (),
    EnvBind(n, binding, rest) => {
      Array::push(acc, (n, binding.ty))
      collect_env_bindings(rest, acc)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => collect_env_bindings(rest, acc),
    EnvTraitImpl(_, _, rest) => collect_env_bindings(rest, acc),
    EnvMutCell(_, _, rest) => collect_env_bindings(rest, acc),
    EnvTraitImplGen(_, _, _, _, rest) => collect_env_bindings(rest, acc),
    EnvTypeDefs(_, _, rest) => collect_env_bindings(rest, acc),
    EnvFlat(bindings) => {
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, i)
        Array::push(acc, (name, binding.ty))
        i = i + 1
      }
    },
    EnvCached(names, types, rest) => {
      let mut i = 0
      while i < Array::length(names) {
        Array::push(acc, (Array::get(names, i), Array::get(types, i).ty))
        i = i + 1
      }
      collect_env_bindings(rest, acc)
    }
  }
}

fn string_array_has(items: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if Array::get(items, i) == wanted {
      found = true
    }
    i = i + 1
  }
  found
}

fn collect_region_skolems(ty: Type, out: Array[String]) -> Unit {
  match ty {
    CtNamed(name, args) => {
      if String::starts_with(name, "#region_") && !string_array_has(out, name) {
        Array::push(out, name)
      }
      for arg in args {
        collect_region_skolems(arg, out)
      }
      ()
    },
    CtFn(params, ret, eff) => {
      for param in params {
        collect_region_skolems(param, out)
      }
      collect_region_skolems(ret, out)
      match eff {
        Some(row) => {
          for raw in String::split(row, ",") {
            let label = String::trim(raw)
            if String::starts_with(label, "#region_") && !string_array_has(out, label) {
              Array::push(out, label)
            }
          }
          ()
        },
        None => ()
      }
    },
    CtArray(elem) => collect_region_skolems(elem, out),
    CtOption(elem) => collect_region_skolems(elem, out),
    CtTuple(items) => {
      for item in items {
        collect_region_skolems(item, out)
      }
      ()
    },
    CtRecord(fields) => {
      for field in fields {
        let (_, field_ty) = field
        collect_region_skolems(field_ty, out)
      }
      ()
    },
    CtForAll(_, _, body) => collect_region_skolems(body, out),
    _ => ()
  }
}

/// Region-backed handles can erase the captured region from a closure's
/// result through operations such as `to_array`. Recognize that nominal shape
/// even when a helper is checked before a region-tagged call site exists.
fn type_has_region_handle_shape(ty: Type) -> Bool {
  match ty {
    CtNamed(name, args) => {
      let mut found = name == "MutList" || name == "MutBytes"
      for arg in args {
        if type_has_region_handle_shape(arg) {
          found = true
        }
      }
      found
    },
    CtFn(params, ret, _) => {
      let mut found = type_has_region_handle_shape(ret)
      for param in params {
        if type_has_region_handle_shape(param) {
          found = true
        }
      }
      found
    },
    CtArray(elem) => type_has_region_handle_shape(elem),
    CtOption(elem) => type_has_region_handle_shape(elem),
    CtTuple(items) => {
      let mut found = false
      for item in items {
        if type_has_region_handle_shape(item) {
          found = true
        }
      }
      found
    },
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, field_ty) = field
        if type_has_region_handle_shape(field_ty) {
          found = true
        }
      }
      found
    },
    CtForAll(_, _, body) => type_has_region_handle_shape(body),
    _ => false
  }
}

fn append_row_label(labels: Array[String], label: String) -> Unit {
  if !string_array_has(labels, label) {
    Array::push(labels, label)
  }
}

/// Add closure-capture provenance to the checked row. The labels beginning
/// with `#` are not effects and cannot be written by source; core/types keeps
/// them through ordinary substitution while excluding them from effect-set
/// compatibility. A captured inference variable is dependent provenance:
/// `#capture[v]` resolves to `#region_n` only if call-site unification binds v
/// to a region-tagged type. This is what makes helper functions structural
/// rather than another literal-name pattern.
fn closure_capture_row(effect: Option[String], body: Expr, params: Array[(String, Option[TypeExpr])], env: TypeEnv, s: Subst) -> Option[String] {
  let labels = match effect {
    Some(row) => for raw in String::split(row, ",") {
      String::trim(raw)
    },
    None => array_empty()
  }
  let active_region = env_has_active_region(env)
  let captured_names = closure_free_names(body, params)
  let seen_names = array_empty()
  let mut i = 0
  while i < Array::length(captured_names) {
    let name = Array::get(captured_names, i)
    if !string_array_has(seen_names, name) {
      Array::push(seen_names, name)
      match env_lookup(env, name) {
        Some(raw_ty) => {
          let ty = subst_apply(s, raw_ty)
          let provenance = array_empty()
          collect_internal_provenance(ty, provenance)
          let vars = collect_tvars(ty)
          for label in provenance {
            append_row_label(labels, label)
          }
          for var_id in vars {
            append_row_label(labels, String::concat("#capture[", String::concat(__to_string(var_id), "]")))
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  for callee in closure_bare_callee_names(body) {
    let mut is_param = false
    for param in params {
      let (raw_name, _) = param
      let nlen = String::length(raw_name)
      let param_name = if nlen > 0 {
        let last = String::char_code_at(raw_name, nlen - 1)
        if last == '~' || last == '?' {
          raw_name[0: nlen - 1]
        } else raw_name
      } else raw_name
      if callee == param_name {
        is_param = true
      }
    }
    match env_lookup(env, callee) {
      Some(raw_ty) => {
        let ty = subst_apply(s, raw_ty)
        let provenance = array_empty()
        collect_internal_provenance(ty, provenance)
        for label in provenance {
          if String::starts_with(label, "#param[") || (active_region && String::starts_with(label, "#region_")) {
            append_row_label(labels, label)
          }
        }
        if is_param {
          for var_id in collect_tvars(ty) {
            append_row_label(labels, String::concat("#capture[", String::concat(__to_string(var_id), "]")))
          }
        }
      },
      None => ()
    }
  }
  if Array::length(labels) == 0 {
    None
  } else {
    Some(String::join(labels, ", "))
  }
}

fn type_mentions_active_region(ty: Type, env: TypeEnv) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(name, binding, rest) => if name == "__active_region__" {
      match binding.ty {
        CtNamed(region_name, _) => type_mentions_named(ty, region_name) || type_mentions_active_region(ty, rest),
        _ => type_mentions_active_region(ty, rest)
      }
    } else {
      type_mentions_active_region(ty, rest)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => type_mentions_active_region(ty, rest),
    EnvTraitImpl(_, _, rest) => type_mentions_active_region(ty, rest),
    EnvMutCell(_, _, rest) => type_mentions_active_region(ty, rest),
    EnvTraitImplGen(_, _, _, _, rest) => type_mentions_active_region(ty, rest),
    EnvTypeDefs(_, _, rest) => type_mentions_active_region(ty, rest),
    EnvCached(_, _, rest) => type_mentions_active_region(ty, rest),
    EnvFlat(_) => false
  }
}

/// A target declared before the relevant active-region marker can outlive the
/// region; a target found first in the environment chain is region-local.
fn assignment_crosses_region(name: String, ty: Type, env: TypeEnv) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(n, binding, rest) => if n == name {
      false
    } else if n == "__active_region__" {
      match binding.ty {
        CtNamed(region_name, _) => type_mentions_named(ty, region_name) || assignment_crosses_region(name, ty, rest),
        _ => assignment_crosses_region(name, ty, rest)
      }
    } else {
      assignment_crosses_region(name, ty, rest)
    },
    EnvMutCell(n, _, rest) => if n == name {
      false
    } else {
      assignment_crosses_region(name, ty, rest)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => assignment_crosses_region(name, ty, rest),
    EnvTraitImpl(_, _, rest) => assignment_crosses_region(name, ty, rest),
    EnvTraitImplGen(_, _, _, _, rest) => assignment_crosses_region(name, ty, rest),
    EnvTypeDefs(_, _, rest) => assignment_crosses_region(name, ty, rest),
    EnvCached(_, _, rest) => assignment_crosses_region(name, ty, rest),
    EnvFlat(_) => false
  }
}

/// A mutable aggregate inherits the lifetime of its binding. Writes through a
/// region-local binding are safe; a binding outside the active region must not
/// retain a value whose closure provenance names that region.
fn container_write_crosses_region(target: Expr, ty: Type, env: TypeEnv) -> Bool {
  match target {
    EIdent(name, _) => assignment_crosses_region(name, ty, env) || match env_lookup(env, String::concat("__region_outer_alias__", name)) {
      Some(_) => type_mentions_active_region(ty, env),
      None => false
    },
    EDot(obj, _, _, _) => container_write_crosses_region(obj, ty, env),
    ECall(EIdent("__index", _), args, _) => if Array::length(args) > 0 {
      container_write_crosses_region(Array::get(args, 0), ty, env)
    } else {
      false
    },
    ECall(_, _, _) => expression_aliases_outer_binding(target, env) && type_mentions_active_region(ty, env),
    _ => false
  }
}

fn binding_predates_active_region(name: String, env: TypeEnv) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(n, _, rest) => if n == name {
      false
    } else if n == "__active_region__" {
      match env_lookup(rest, name) {
        Some(_) => true,
        None => false
      }
    } else {
      binding_predates_active_region(name, rest)
    },
    EnvMutCell(n, _, rest) => if n == name {
      false
    } else {
      binding_predates_active_region(name, rest)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => binding_predates_active_region(name, rest),
    EnvTraitImpl(_, _, rest) => binding_predates_active_region(name, rest),
    EnvTraitImplGen(_, _, _, _, rest) => binding_predates_active_region(name, rest),
    EnvTypeDefs(_, _, rest) => binding_predates_active_region(name, rest),
    EnvCached(_, _, rest) => binding_predates_active_region(name, rest),
    EnvFlat(_) => false
  }
}

fn push_unique_dependency_index(out: Array[Int], index: Int) -> Unit {
  let mut found = false
  for existing in out {
    if existing == index {
      found = true
    }
  }
  if !found {
    Array::push(out, index)
  }
}

fn alias_result_reaches_outer_binding(ty: Type, args: Array[Expr], env: TypeEnv) -> Bool {
  match ty {
    CtForAll(_, _, body) => alias_result_reaches_outer_binding(body, args, env),
    CtFn(_, _, effect) => match effect {
      Some(row) => if String::contains(row, "#aliasparam[") {
        let mut found = false
        for raw in String::split(row, ",") {
          if !found {
            let label = String::trim(raw)
            if String::starts_with(label, "#aliasparam[") {
              let close = String::index_of(label, "]")
              let mut id = 0
              let mut p = 12
              while p < close {
                id = id * 10 + (String::char_code_at(label, p) - 48)
                p = p + 1
              }
              if id >= 0 && id < Array::length(args) && expression_aliases_outer_binding(Array::get(args, id), env) {
                found = true
              }
            }
          }
        }
        found
      } else {
        false
      },
      None => false
    },
    _ => false
  }
}

fn decimal_index(text: String) -> Int {
  let mut out = 0
  let mut i = 0
  while i < String::length(text) {
    out = out * 10 + (String::char_code_at(text, i) - 48)
    i = i + 1
  }
  out
}

fn expression_aliases_outer_binding(expr: Expr, env: TypeEnv) -> Bool {
  match expr {
    EIdent(name, _) => binding_predates_active_region(name, env) || match env_lookup(env, String::concat("__region_outer_alias__", name)) {
      Some(_) => true,
      None => false
    },
    ECall(EIdent(callee, _), args, _) => match env_lookup(env, callee) {
      Some(callee_ty) => {
        let mut found = false
        match env_lookup(env, String::concat("__alias_contract__", callee)) {
          Some(CtNamed(index_text, _)) => {
            let index = decimal_index(index_text)
            if index >= 0 && index < Array::length(args) {
              found = expression_aliases_outer_binding(Array::get(args, index), env)
            }
          },
          _ => ()
        }
        if !found && alias_result_reaches_outer_binding(callee_ty, args, env) {
          found = true
        }
        found
      },
      None => false
    },
    ECall(EFn(_, _, params, _, _, body), args, _) => {
      let mut found = false
      for index in direct_result_param_indices(body, params) {
        if index >= 0 && index < Array::length(args) && expression_aliases_outer_binding(Array::get(args, index), env) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

fn collect_result_param_indices(body: Expr, params: Array[(String, Option[TypeExpr])], alias_names: Array[String], alias_indices: Array[Int], found: Array[Int]) -> Unit {
  match body {
    EIdent(name, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (raw_name, _) = Array::get(params, i)
        let nlen = String::length(raw_name)
        let param_name = if nlen > 0 {
          let last = String::char_code_at(raw_name, nlen - 1)
          if last == '~' || last == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        if name == param_name {
          push_unique_dependency_index(found, i)
        }
        i = i + 1
      }
      let mut alias_i = 0
      while alias_i < Array::length(alias_names) {
        if name == Array::get(alias_names, alias_i) {
          push_unique_dependency_index(found, Array::get(alias_indices, alias_i))
        }
        alias_i = alias_i + 1
      }
    },
    ELet(name, value, rest, _) => {
      let found_mark = Array::length(found)
      let alias_mark = Array::length(alias_names)
      collect_result_param_indices(value, params, alias_names, alias_indices, found)
      let mut i = found_mark
      while i < Array::length(found) {
        Array::push(alias_names, name)
        Array::push(alias_indices, Array::get(found, i))
        i = i + 1
      }
      Array::truncate(found, found_mark)
      collect_result_param_indices(rest, params, alias_names, alias_indices, found)
      Array::truncate(alias_names, alias_mark)
      Array::truncate(alias_indices, alias_mark)
    },
    ESeq(_, right) => collect_result_param_indices(right, params, alias_names, alias_indices, found),
    EIf(_, then_expr, else_expr) => {
      collect_result_param_indices(then_expr, params, alias_names, alias_indices, found)
      collect_result_param_indices(else_expr, params, alias_names, alias_indices, found)
    },
    _ => ()
  }
}

fn direct_result_param_indices(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[Int] {
  let found = array_empty()
  collect_result_param_indices(body, params, array_empty(), array_empty(), found)
  found
}

fn direct_result_param_index(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Option[Int] {
  let indices = direct_result_param_indices(body, params)
  if Array::length(indices) > 0 {
    Some(Array::get(indices, 0))
  } else {
    None
  }
}

fn result_field_param_index(body: Expr, params: Array[(String, Option[TypeExpr])], alias_names: Array[String], alias_indices: Array[Int]) -> Option[Int] {
  match body {
    EDot(EIdent(name, _), _, _, _) => {
      let mut found = None
      let mut i = 0
      while i < Array::length(params) {
        let (raw_name, _) = Array::get(params, i)
        if name == raw_name {
          found = Some(i)
        }
        i = i + 1
      }
      found
    },
    EIdent(name, _) => {
      let mut found = None
      let mut i = 0
      while i < Array::length(alias_names) {
        if Array::get(alias_names, i) == name {
          found = Some(Array::get(alias_indices, i))
        }
        i = i + 1
      }
      found
    },
    ELet(name, value, rest, _) => {
      let mark = Array::length(alias_names)
      match result_field_param_index(value, params, alias_names, alias_indices) {
        Some(index) => {
          Array::push(alias_names, name)
          Array::push(alias_indices, index)
        },
        None => ()
      }
      let found = result_field_param_index(rest, params, alias_names, alias_indices)
      Array::truncate(alias_names, mark)
      Array::truncate(alias_indices, mark)
      found
    },
    ESeq(_, right) => result_field_param_index(right, params, alias_names, alias_indices),
    EIf(_, then_expr, else_expr) => match result_field_param_index(then_expr, params, alias_names, alias_indices) {
      Some(index) => Some(index),
      None => result_field_param_index(else_expr, params, alias_names, alias_indices)
    },
    _ => None
  }
}

fn direct_result_field_param_index(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Option[Int] {
  result_field_param_index(body, params, array_empty(), array_empty())
}

fn return_provenance_key(id: Int) -> Int {
  0 - id - 1000000000
}

fn return_provenance_was_written(tytab: Array[(Int, Type)], id: Int) -> Bool {
  let wanted = return_provenance_key(id)
  let mut found = false
  for entry in tytab {
    let (off, _) = entry
    if off == wanted {
      found = true
    }
  }
  found
}

fn is_enum_ctor_name(name: String, defs: Array[TypeDef]) -> Bool {
  let separator = String::last_index_of(name, "::")
  let member = if separator >= 0 {
    String::substring(name, separator + 2, String::length(name))
  } else {
    name
  }
  let mut found = name == "Some"
  for type_def in defs {
    match type_def {
      TDEnum(_, _, variants) => {
        for variant in variants {
          let (variant_name, _) = variant
          if variant_name == member {
            found = true
          }
        }
        ()
      },
      _ => ()
    }
  }
  found
}

fn direct_result_enum_payload_param_indices(body: Expr, params: Array[(String, Option[TypeExpr])], defs: Array[TypeDef]) -> Array[Int] {
  let found = array_empty()
  match body {
    ECall(EIdent(ctor_name, _), args, _) => {
      let alias_names = array_empty()
      let alias_indices = array_empty()
      for call_arg in args {
        collect_result_param_indices(call_arg, params, alias_names, alias_indices, found)
      }
      if Array::length(found) > 0 && !is_enum_ctor_name(ctor_name, defs) {
        Array::truncate(found, 0)
      }
    },
    _ => ()
  }
  found
}

export fn bind_function_dependency_contracts(env: TypeEnv, name: String, value: Expr) -> TypeEnv {
  match value {
    EFn(_, _, params, _, _, body) => {
      let with_alias = match direct_result_param_index(body, params) {
        Some(index) => env_bind(env, String::concat("__alias_contract__", name), CtNamed(__to_string(index), [
        ])),
        None => env
      }
      match direct_result_field_param_index(body, params) {
        Some(index) => env_bind(with_alias, String::concat("__field_contract__", name), CtNamed(__to_string(index), [
        ])),
        None => with_alias
      }
    },
    _ => env
  }
}

fn env_has_active_region(env: TypeEnv) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(name, _, rest) => name == "__active_region__" || env_has_active_region(rest),
    EnvTraitDef(_, _, _, _, rest, _, _) => env_has_active_region(rest),
    EnvTraitImpl(_, _, rest) => env_has_active_region(rest),
    EnvMutCell(_, _, rest) => env_has_active_region(rest),
    EnvTraitImplGen(_, _, _, _, rest) => env_has_active_region(rest),
    EnvTypeDefs(_, _, rest) => env_has_active_region(rest),
    EnvCached(_, _, rest) => env_has_active_region(rest),
    EnvFlat(_) => false
  }
}

/// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but
/// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type
/// whose only flexibility is unification variables: if such a type fails to unify
/// against a fully GROUND expected type, no instantiation of its variables can
/// make it match, so the mismatch is real (unlike an un-instantiated generic
/// param `CtNamed(T)`, which the checker simply has not substituted yet).
fn type_no_named(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_no_named(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_no_named(e),
    CtOption(e) => type_no_named(e),
    CtFn(ps, r, _) => {
      let mut ok = type_no_named(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_no_named(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is
/// not concrete (a type variable / unresolved named param / unknown / forall).
/// Two types with DIFFERENT non-zero heads can never be made equal by any
/// instantiation of their inner type parameters (an `Int` is never an `Array[T]`
/// for any `T`), so such a unify failure is a real mismatch even when the inner
/// parts are generic — which the whole-type groundness gate misses.
fn head_kind(t: Type) -> Int {
  match t {
    CtInt => 1,
    CtDouble => 2,
    CtBool => 3,
    CtString => 4,
    CtChar => 5,
    CtUnit => 6,
    CtBytes => 7,
    CtTuple(_) => 8,
    CtArray(_) => 9,
    CtOption(_) => 10,
    CtStruct(_) => 11,
    CtEnum(_) => 12,
    CtFn(_, _, _) => 13,
    // #1839 (Codex review on #1867): a concrete head, NOT the `_ => 0`
    // "unresolved; tolerate" bucket — otherwise representation-specific
    // builtin receiver checks (`Array::get(record { a: 1 }, 0)` etc.) pass
    // and codegen reads the record layout as the wrong representation.
    CtRecord(_) => 14,
    CtNamed(name, _) => if name == "MutList" {
      15
    } else if name == "Attempt" {
      // #1961 / ADR-0088: `perform?` yields `Attempt[T, E]`, a compiler-owned
      // named type. Kind 0 would let `fn main() -> String { perform? ... }`
      // unify-fail and then be swallowed — `type_no_named` is false and
      // `nominal_name_of` treats a still-open `T` as non-concrete.
      16
    } else {
      0
    },
    _ => 0
  }
}

/// The surface slice forms lower to `__slice(receiver, start, end)`. Runtime
/// dispatch supports exactly these three receiver representations and returns
/// the same representation (including an Array's element slot).
fn slice_result_type(receiver: Type) -> Type {
  match receiver {
    CtString => CtString,
    CtBytes => CtBytes,
    CtArray(elem) => CtArray(elem),
    _ => CtUnknown
  }
}

/// Unknown is retained only when checking THIS receiver expression already
/// emitted a diagnostic. `CtUnknown` is also a legitimate result of tolerant
/// builtins such as `iter_get`, so accepting every unknown receiver would leave
/// `iter_get(xs, 0)[:]` to unsafe runtime representation dispatch (#1682).
/// A fresh/generic/named type has no Sliceable bound in the language either.
fn slice_receiver_is_invalid(receiver: Type, receiver_had_error: Bool) -> Bool {
  match receiver {
    CtString => false,
    CtBytes => false,
    CtArray(_) => false,
    CtUnknown => !receiver_had_error,
    _ => true
  }
}

/// `ByteStream` is `CtNamed` (head_kind 0 = tolerated), so the Array
/// builtins' receiver head check let `Array::length(stream)` / `Array::get(s,
/// 0)` through — observably leaking the eager Array-backed representation
/// (ADR-0012) into user programs. Recognise a Stream receiver so the Array
/// head-check sites can reject it explicitly; head_kind itself is unchanged
/// (other CtNamed heads stay tolerated, the #826 discipline).
fn is_bytestream_named_type(t: Type) -> Bool {
  match t {
    CtNamed(n, _) => n == "ByteStream",
    _ => false
  }
}

fn is_stdin_stream_internal(t: Type) -> Bool {
  match t {
    CtStruct(n) => n == "#vibe_stdin_stream",
    _ => false
  }
}

/// #1539: the opaque stdin provider token is compiler-owned. Unlike ordinary
/// nullary CtNamed values, no unresolved/generic tolerance may let a different
/// concrete representation cross this boundary. Recurse through matching
/// containers/function signatures so aliases cannot launder the token either.
fn stdin_stream_nominal_conflict(expected: Type, actual: Type) -> Bool {
  let e_token = is_stdin_stream_internal(expected)
  let a_token = is_stdin_stream_internal(actual)
  if e_token || a_token {
    e_token != a_token
  } else {
    match expected {
      CtArray(e) => match actual {
        CtArray(a) => stdin_stream_nominal_conflict(e, a),
        _ => false
      },
      CtOption(e) => match actual {
        CtOption(a) => stdin_stream_nominal_conflict(e, a),
        _ => false
      },
      CtNamed(_, es) => match actual {
        CtNamed(_, actuals) => if Array::length(es) == Array::length(actuals) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(es) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(es, i), Array::get(actuals, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtTuple(es) => match actual {
        CtTuple(actuals) => if Array::length(es) == Array::length(actuals) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(es) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(es, i), Array::get(actuals, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtFn(eps, er, _) => match actual {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          let mut i = 0
          let mut conflict = stdin_stream_nominal_conflict(er, ar)
          while i < Array::length(eps) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(eps, i), Array::get(aps, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      _ => false
    }
  }
}

/// True when every declared field type of a struct is ground (the struct is not
/// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.
fn struct_fields_ground(dfields: Array[(String, Type)]) -> Bool {
  let mut ok = true
  let mut i = 0
  while i < Array::length(dfields) {
    let (_, ft) = Array::get(dfields, i)
    if !type_is_ground(ft) {
      ok = false
    }
    i = i + 1
  }
  ok
}

/// #939 helpers: detect a function VALUE laundering a concrete effect row away
/// through a pure-typed slot (HOF argument, let/struct-field/array annotation).
/// The strip_effects fallback below deliberately tolerates effect-only
/// differences — but for CONCRETE, non-exempt labels flowing in a COVARIANT
/// position that tolerance is the #939 soundness hole: the value's perform
/// executes with no handler and the program dies with an unhandled wasm
/// exception at runtime. Exemptions mirror checker_effects' transitive pass:
/// `Error` (pervasive un-annotated throw sites, #640), `Async`
/// (composition-allowed), and effect VARIABLES (single lowercase letter /
/// `$N` fresh vars — not decidable without call-site row unification, #885).
fn effect_label_is_exempt(lbl: String) -> Bool {
  let len = String::length(lbl)
  // ADR-0085 (#1344): only the ERASED exception spellings keep the #640
  // exemption. It exists because `Error` is pervasive and un-annotated, so
  // laundering it away is not evidence of a bug; a KINDED `Exception[E]` is
  // opt-in and carries real information, so dropping it through a pure-typed
  // slot is exactly the #939 hole this check exists to catch. Nothing in the
  // codebase writes a kinded label, so no existing program changes verdict.
  if String::starts_with(lbl, "#region_") || String::starts_with(lbl, "#capture[") || String::starts_with(lbl, "#param[") || String::starts_with(lbl, "#aliasparam[") || String::starts_with(lbl, "#fieldparam[") {
    true
  } else if (is_exception_effect_name(lbl) && String::length(exception_effect_kind(lbl)) == 0) || lbl == "Async" {
    true
  } else if len == 1 {
    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122
  } else if len >= 2 {
    String::char_code_at(lbl, 0) == 36
  } else {
    true
  }
}

/// #2147 review (round 2): the row entries that are effect VARIABLES -- the
/// only entries a row declares as binders. Mirrors `is_effect_var_name`
/// (core/types.vibe), which is file-private there; three other copies in the
/// tree already spell it out the same way.
fn row_label_is_variable(label: String) -> Bool {
  let len = String::length(label)
  if len == 1 {
    // A source-level effect variable: a single lowercase letter (`with e`).
    String::char_code_at(label, 0) >= 97 && String::char_code_at(label, 0) <= 122
  } else if len >= 2 {
    // A FRESH effect variable minted by `instantiate` (`$N`).
    String::char_code_at(label, 0) == 36
  } else {
    false
  }
}

fn row_variable_labels(row: Option[String]) -> Array[String] {
  let out = array_empty()
  let labels = row_labels(row)
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    if row_label_is_variable(label) {
      Array::push(out, label)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn row_labels(row: Option[String]) -> Array[String] {
  match row {
    Some(r) => {
      let parts = String::split(r, ",")
      let out = array_empty()
      let mut i = 0
      while i < Array::length(parts) {
        let t = String::trim(Array::get(parts, i))
        if String::length(t) > 0 {
          Array::push(out, t)
        } else {
          ()
        }
        i = i + 1
      }
      out
    },
    None => array_empty()
  }
}

/// #1340 (ADR-0071): base effect name of a row label — `State[Int]` strips
/// to `State`, a bracketless label is its own base. (Local copy: the
/// same-named helpers in checker_effects.vibe / core stay file-private.)
fn ck_row_label_base(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi > 0 {
    label[0: bi]
  } else {
    label
  }
}

fn row_contains_label(row: Option[String], lbl: String) -> Bool {
  let labels = row_labels(row)
  let mut i = 0
  let mut found = false
  // #1340 (ADR-0071): compare by base name so a generic instantiation label
  // (`State[Int]`) and the bare effect (`State`) count as the same label in
  // the dropped-row walk — bracketless labels degenerate to exact equality.
  // ADR-0085 (#1344): the exception effect opts out of that base-name
  // equivalence and compares by KIND instead, so assigning a
  // `with Exception[IoError]` value into a `with Exception[ParseError]`
  // slot is a dropped row, not a match. Erased labels (`Error`, `Exception`)
  // stay compatible with every kind in both directions, which is what keeps
  // every pre-#1344 row behaving exactly as before.
  let wanted = ck_row_label_base(lbl)
  let exc_wanted = is_exception_label(lbl)
  while i < Array::length(labels) && !found {
    let have = Array::get(labels, i)
    let hit = if exc_wanted || is_exception_label(have) {
      exception_effect_labels_equal(have, lbl)
    } else {
      ck_row_label_base(have) == wanted
    }
    if hit {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// First concrete, non-exempt effect label whose drop would let a perform run
/// with no handler. At each CtFn the ACTUAL side's own row must not carry a
/// label the EXPECTED side's row lacks; the return type recurses covariantly;
/// PARAMETER positions recurse with expected/actual SWAPPED (contravariance —
/// Codex P1 on #978: an `((Int) -> Int with Logger, Int) -> Int` slot
/// holding a pure-callback fn lets `h(eff, 1)` type-check while the callee
/// invokes the effectful callback with no handler, so at parameter positions
/// it is the EXPECTED param's concrete labels that must be tolerated by the
/// ACTUAL param). pure→effectful still passes in both directions by
/// construction, and an effectful parameter slot accepting a pure function
/// stays legal (the swap makes that the label-free side).
fn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {
  match expected {
    CtFn(eparams, eret, eeff) => match actual {
      CtFn(aparams, aret, aeff) => {
        let alabels = row_labels(aeff)
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(alabels) && !done {
          let lbl = Array::get(alabels, i)
          if !effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl) {
            dropped = Some(lbl)
            done = true
          } else {
            ()
          }
          i = i + 1
        }
        if !done && Array::length(eparams) == Array::length(aparams) {
          let mut pi = 0
          while pi < Array::length(eparams) && !done {
            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {
              Some(pl) => {
                dropped = Some(pl)
                done = true
              },
              None => ()
            }
            pi = pi + 1
          }
        } else {
          ()
        }
        match dropped {
          Some(l) => Some(l),
          None => effect_row_dropped(eret, aret)
        }
      },
      _ => None
    },
    CtArray(ee) => match actual {
      CtArray(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtOption(ee) => match actual {
      CtOption(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtTuple(ees) => match actual {
      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(ees) && !done {
          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    CtNamed(en, eargs) => match actual {
      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(eargs) && !done {
          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch
/// (the checker historically swallowed these, accepting ill-typed programs).
/// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with
/// effects erased, and tolerate the difference if the structure matches — effect
/// inference on function values is imprecise, so effect-only differences must not
/// be reported here (EXCEPT a concrete covariant row drop — see
/// `effect_row_dropped` above, #939). Returns the (possibly extended)
/// substitution.
export fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {
  match unify(expected, actual, s) {
    Some(su) => su,
    None => {
      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {
        Some(_) => true,
        None => false
      }
      // Only report when BOTH sides are fully ground (mention no type parameter
      // / type variable). The checker does not instantiate a generic
      // struct field's or function parameter's type params — they surface as
      // rigid `CtNamed(T, _)` — so a unify failure against a concrete
      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->
      // Option[(T, Int)]` field vs a concrete closure). Reporting only on
      // ground/ground keeps the genuine concrete-type mismatches (Int vs
      // String, struct field of the wrong concrete type) while not
      // over-rejecting polymorphic code.
      // Report when the EXPECTED type is fully ground and the ACTUAL type
      // mentions no rigid type parameter (inference variables are fine). A
      // unify failure under those conditions is genuine: no instantiation of
      // the actual's variables can satisfy the concrete expected type (this is
      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground
      // expected, or an actual carrying an un-instantiated generic `CtNamed`,
      // is still tolerated to avoid over-rejecting polymorphic code.
      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))
      // Also report when the two types have DIFFERENT concrete top-level
      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no
      // instantiation of inner type parameters can reconcile them, so it is a
      // real mismatch even though the expected type is non-ground. A
      // var/named/unknown head (kind 0) on either side stays tolerated.
      let eh = head_kind(subst_apply(s, expected))
      let ah = head_kind(subst_apply(s, actual))
      let head_differ = eh != 0 && ah != 0 && eh != ah
      // #1001: a `CtNamed` head is kind 0 in `head_kind` (may be a rigid type
      // parameter), so `Result[Int,String]` vs `Option[Int]` — or the same
      // pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn signature —
      // sails past `head_differ` untouched, and `detect_narrowed_generic_mismatch`
      // below only fires on a SAME-name pair, so a genuinely DIFFERENT nominal
      // head was never reported at all. Check that ahead of the existing
      // gates; internally gated on `type_fully_concrete` so a still-rigid
      // type parameter never triggers it.
      let expected_zonked = subst_apply(s, expected)
      let actual_zonked = subst_apply(s, actual)
      let stdin_stream_conflict = stdin_stream_nominal_conflict(expected_zonked, actual_zonked)
      let nominal_conflict = nominal_head_conflict(expected_zonked, actual_zonked)
      if stdin_stream_conflict || nominal_conflict {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(expected_zonked), String::concat(", got ", String::concat(type_to_string(actual_zonked), off_marker(off)))))))
        s
      } else if structural {
        // #939: the structural retry tolerated EVERY effect-only difference,
        // including a function value whose CONCRETE row silently vanishes
        // into a pure-typed slot (HOF argument, let / struct field / array
        // annotation) — the perform then runs with no handler and dies as an
        // unhandled wasm exception at runtime. Report exactly that shape;
        // pure→effectful subsumption and Error/Async/effect-var differences
        // stay tolerated (see effect_row_dropped).
        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {
          Some(lbl) => {
            Array::push(errors, String::concat(what, String::concat(": effect row mismatch: a value of type ", String::concat(type_to_string(subst_apply(s, actual)), String::concat(" cannot be used where ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(" is expected (the { ", String::concat(lbl, String::concat(" } effect would be dropped — no handler could ever run)", off_marker(off))))))))))
            s
          },
          None => s
        }
      } else if !(reportable || head_differ) {
        // #981: a user generic type's ARGUMENTS were never compared here — a
        // `CtNamed` head is kind 0 (tolerated by `head_differ`) and makes
        // `type_no_named(actual)` false, so `get_int(b)` with
        // `b: Box[String]` against `Box[Int]` sailed through this branch
        // silently (compile clean, heap-pointer garbage at runtime), while
        // the symmetric builtin (`Array[String]` vs `Array[Int]`) and the
        // RETURN position were both rejected. Close exactly that hole with
        // the proven #844 predicate (`detect_narrowed_generic_mismatch`):
        // report ONLY a same-name, same-arity (> 0), fully-concrete `CtNamed`
        // pair whose arguments fail to unify — a rigid/uninstantiated type
        // parameter surfaces as `CtNamed(T, [])` / the `[CtUnknown]` sentinel
        // and stays tolerated, so polymorphic code is not over-rejected.
        // Additionally gate on the RAW expected type (BEFORE subst) being
        // fully concrete: an expected that only became concrete through this
        // call's own unification is not trustworthy — an IMPORTED generic
        // fn's signature can cross-talk its type params through the flat
        // import env (measured: `list_zip[A, B]` imported from
        // lib/@vibe/core/list.vibe reported `expected List[String], got
        // List[Int]` on its second argument — A's binding leaked into B's
        // slot), and reporting that shape would reject valid polymorphic
        // calls. A monomorphic signature (the #981 hole) is concrete without
        // any substitution, so the genuine cases all keep reporting.
        if type_fully_concrete(expected) {
          detect_narrowed_generic_mismatch(expected, actual, s, errors, what, off)
        } else {
          s
        }
      } else {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(", got ", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))
        s
      }
    }
  }
}

/// #1001: the type's outer constructor's nominal name, when it is one that can
/// NEVER be a placeholder for a still-unresolved rigid type parameter --
/// `CtOption` (the builtin `Option[T]`; `Option` written as an annotation
/// resolves to this, not `CtNamed("Option", _)`)
/// and `CtEnum`/`CtStruct` (a RESOLVED reference to a declared enum/struct,
/// always concrete) are unconditionally trustworthy. A bare `CtNamed(n, _)`
/// is ambiguous -- it is ALSO how an uninstantiated generic type parameter
/// surfaces (`CtNamed("T", [])`) -- so it only counts when
/// `type_fully_concrete` confirms this occurrence is not that sentinel shape.
/// `None` means "nothing nominal to compare" (a type variable, a builtin
/// scalar, a container whose own head isn't itself nominal, etc).
fn nominal_name_of(t: Type) -> Option[String] {
  match t {
    CtOption(_) => Some("Option"),
    CtEnum(n) => Some(n),
    CtStruct(n) => Some(n),
    CtNamed(n, _) => if n == "HostStream" || n == "Attempt" {
      // Compiler-owned and always concrete despite an open type argument
      // (`HostStream` is nullary; `Attempt[T, E]` may still hold a fresh
      // var for T when the inner capability has no declared signature).
      Some(n)
    } else if type_fully_concrete(t) {
      Some(n)
    } else {
      None
    },
    _ => None
  }
}

/// #1001: true when `expected` and `actual` carry a corresponding pair of
/// nominal names that DIFFER, anywhere in their structure -- e.g.
/// `Result[Int,String]` (`CtNamed`) vs `Option[Int]` (the builtin `CtOption`),
/// or the same pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn
/// signature/a same-named `CtNamed`'s own type arguments (mirroring
/// `effect_row_dropped`'s traversal above). No instantiation of type
/// PARAMETERS can ever reconcile two DIFFERENT nominal names, so this is a
/// genuine mismatch regardless of arity or which concrete `Type` shape either
/// side happens to be represented as -- unlike `detect_narrowed_generic_mismatch`
/// below, which only catches a SAME-name `CtNamed`/`CtNamed` mismatch (e.g.
/// `Box[Int]` vs `Box[String]`, #981) and never even inspects a
/// `CtArray[Option[Int]]` vs `CtArray[Result[Int,String]]` pair's nested heads,
/// nor a builtin `CtOption` against a `CtNamed`/`CtEnum` nominal type, at all.
fn nominal_head_conflict(expected: Type, actual: Type) -> Bool {
  let direct_conflict = match nominal_name_of(expected) {
    Some(en) => match nominal_name_of(actual) {
      Some(an) => en != an,
      None => false
    },
    None => false
  }
  if direct_conflict {
    true
  } else {
    match expected {
      CtNamed(_, eargs) => match actual {
        CtNamed(_, aargs) => if Array::length(eargs) == Array::length(aargs) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(eargs) && !conflict {
            if nominal_head_conflict(Array::get(eargs, i), Array::get(aargs, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtArray(ee) => match actual {
        CtArray(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtOption(ee) => match actual {
        CtOption(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtTuple(ees) => match actual {
        CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(ees) && !conflict {
            if nominal_head_conflict(Array::get(ees, i), Array::get(aes, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtFn(eps, er, _) => match actual {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          let mut i = 0
          let mut conflict = nominal_head_conflict(er, ar)
          while i < Array::length(eps) && !conflict {
            if nominal_head_conflict(Array::get(eps, i), Array::get(aps, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      _ => false
    }
  }
}

/// #844: true when `t` mentions no unresolved/rigid type-parameter placeholder
/// and no unbound unification variable ANYWHERE in its structure -- i.e. it is
/// a genuinely CONCRETE type. Unlike the more conservative shared
/// `type_is_ground` (which treats EVERY `CtNamed` as non-ground, to stay safe
/// for the many call sites that must still tolerate a rigid/uninstantiated
/// type parameter such as a trait method's `CtNamed("T", _)` field type), this
/// recurses into `CtNamed`'s own type arguments. Used ONLY by
/// `detect_narrowed_generic_mismatch` below (a narrowly-scoped, additive check
/// for the `let`-annotation erasure hole -- see #844) so this refinement's
/// blast radius stays contained to that one new check instead of the many
/// existing `type_is_ground` call sites.
///
/// The sentinel shape `CtNamed(name, [CtUnknown])` is what `resolve_type_expr`
/// (checker_resolve.vibe) emits for an unresolved rigid single-name type
/// parameter reference AND for an unresolved/unknown type name alike -- treat
/// that shape as non-concrete. A REAL instantiated generic type (e.g. #829's
/// `Box::{v:1}` -> `CtNamed("Box", [CtInt])`) never carries the bare
/// `CtUnknown` sentinel as its own argument.
fn type_fully_concrete(t: Type) -> Bool {
  match t {
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtUnknown => false,
    // A `CtNamed` with an EMPTY argument list is ALSO treated as non-concrete
    // (not just the `[CtUnknown]` singlet sentinel above): a rigid/uninstantiated
    // generic function's own type parameter can leak through, unsubstituted,
    // as a bare `CtNamed(pname, [])` when it only appears NESTED inside another
    // type's argument list (e.g. `MutMap::new_int[V]() -> MutMap[Int, V]`
    // called as `MutMap::new_int()` -- `instantiate` does not always rewrite
    // an occurrence of `V` buried inside a struct's own field/return-type
    // representation to a fresh `CtVar`, so it can surface literally as
    // `CtNamed("V", [])` instead -- lib/@vibe/core/hashmap_test.vibe
    // hit exactly this via `let m: MutMap[Int, String] = MutMap::new_int()`
    // during development of this check). Both shapes are the SAME underlying
    // ambiguity (a name with no way to tell "resolved zero-arg nominal type"
    // from "unresolved rigid reference" apart) that the shared `type_is_ground`
    // sidesteps by always tolerating `CtNamed`; treat both as non-concrete here
    // too so this narrowly-scoped check only ever fires when it is SURE both
    // sides are fully resolved.
    CtNamed(_, args) => {
      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {
        CtUnknown => true,
        _ => false
      })
      if is_sentinel {
        false
      } else {
        let mut ok = true
        let mut i = 0
        while i < Array::length(args) {
          if !type_fully_concrete(Array::get(args, i)) {
            ok = false
          }
          i = i + 1
        }
        ok
      }
    },
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_fully_concrete(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_fully_concrete(e),
    CtOption(e) => type_fully_concrete(e),
    CtFn(ps, r, _) => {
      let mut ok = type_fully_concrete(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_fully_concrete(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #844: `resolve_type_expr` types a BARE (unparameterized) reference to a
/// generic struct annotation (`let x: Box = ...`) as bare `CtStruct("Box")`,
/// discarding the struct's real type arguments -- and `unify`'s
/// `CtStruct`/`CtNamed` bridge (core/types.vibe, #829/#843) then lets that bare
/// annotation re-unify by NAME ALONE with any later, unrelated instantiation
/// (`let y: Box[String] = x`), silently re-narrowing a laundered value. Fixing
/// that erasure at its source (threading fresh type variables through
/// `resolve_type_expr`) touches its ~20 call sites across the whole checker
/// and was judged too wide-blast-radius to land in one pass (#844); this is
/// the narrower, additive half of the fix that IS safe to land: when BOTH the
/// expected annotation and the actual value are already a fully concrete,
/// SAME-NAME `CtNamed` instantiation (arity > 0) and their arguments do not
/// unify, report the mismatch directly -- bypassing `check_assignable`'s
/// `type_is_ground` gate, which (deliberately, to stay lenient for genuinely
/// rigid/uninstantiated type parameters elsewhere) treats every `CtNamed` as
/// non-ground and so never reports this shape at all. Gated on
/// `type_fully_concrete` on BOTH sides so a still-polymorphic case (either
/// side embedding an unresolved rigid parameter or unbound type variable, e.g.
/// a trait-generic `LazyIter[T]` return before `T` is resolved) is never
/// flagged -- only a same-name mismatch where both sides are already fully
/// resolved concrete types.
export fn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {
  let e2 = subst_apply(s, expected)
  let a2 = subst_apply(s, actual)
  match e2 {
    CtNamed(ename, eargs) => match a2 {
      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {
        match unify(e2, a2, s) {
          Some(_) => s,
          None => {
            Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(e2), String::concat(", got ", String::concat(type_to_string(a2), off_marker(off)))))))
            s
          }
        }
      } else s,
      _ => s
    },
    _ => s
  }
}

/// #844: when a `let`-style annotation is a BARE (unparameterized) reference to
/// a generic struct (`resolve_type_expr` resolves it to bare `CtStruct(name)`,
/// discarding type args) and the RHS's ACTUAL inferred type is already a
/// concrete instantiation of that SAME struct (`CtNamed(name, args)`, arity >
/// 0, from #829's struct-literal instantiation), prefer recording the RHS's
/// real instantiated type for the binding instead of the erasing bare
/// annotation. This does not change what the CURRENT statement accepts (the
/// bare annotation already tolerates any instantiation via the unify bridge,
/// unchanged here) -- it only changes what a LATER statement observes when it
/// looks the binding up, so a subsequent re-narrowing annotation
/// (`detect_narrowed_generic_mismatch` above) has real type information to
/// compare against instead of an erased placeholder.
export fn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type {
  match resolved {
    CtStruct(rname) => match actual {
      CtNamed(aname, aargs) => if rname == aname && Array::length(aargs) > 0 {
        actual
      } else {
        resolved
      },
      _ => resolved
    },
    _ => resolved
  }
}

/// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a
/// bare ERecord), so the struct is resolved by matching the field-name SET. True
/// when `declared` and `actual` have the same field names.
fn struct_field_names_match(declared: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {
  if Array::length(declared) != Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(declared) {
      let (dn, _) = Array::get(declared, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(actual) {
        let (an, _) = Array::get(actual, j)
        if an == dn {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

/// #813: look up a qualified operation name ("Eff::Op") in the declared-effect
/// registry (TDEffect defs). None when the name is unqualified, the effect is
/// undeclared/builtin/generic, or the op is unknown WITHIN a declared effect is
/// reported separately by the callers — this returns None only when there is
/// nothing to validate against (pre-#813 behavior).
fn effect_op_sig(defs: Array[TypeDef], qname: String) -> Option[(Array[Type], Type)] {
  let ci = String::index_of(qname, "::")
  if ci < 0 {
    None
  } else {
    let eff = String::substring(qname, 0, ci)
    let op = String::substring(qname, ci + 2, String::length(qname))
    match find_typedef(defs, eff) {
      Some(td) => match td {
        TDEffect(_, ops, _) => {
          let mut oi = 0
          let mut found = None
          while oi < Array::length(ops) {
            let (oname, oparams, oret) = Array::get(ops, oi)
            if oname == op {
              found = Some((oparams, oret))
            } else {
              ()
            }
            oi = oi + 1
          }
          found
        },
        _ => None
      },
      None => None
    }
  }
}

/// #1340 (ADR-0071): a declared effect's type params (empty for non-generic
/// effects and for anything absent from the registry). The op signatures
/// returned by effect_op_sig mention these as rigid `CtNamed(param, [])`
/// names — every consumer must substitute them (fresh inference vars per
/// use site) before checking against them.
fn effect_tparams(defs: Array[TypeDef], eff: String) -> Array[String] {
  match find_typedef(defs, eff) {
    Some(td) => match td {
      TDEffect(_, _, etps) => etps,
      _ => array_empty()
    },
    None => array_empty()
  }
}

/// #1340: instantiate a generic effect's declared type params with fresh
/// inference vars. Returns (fresh args, next counter).
fn effect_fresh_targs(etps: Array[String], c: Int) -> (Array[Type], Int) {
  let out = array_empty()
  let mut c1 = c
  let mut i = 0
  while i < Array::length(etps) {
    let (tv, nc) = fresh_var(c1)
    Array::push(out, tv)
    c1 = nc
    i = i + 1
  }
  (out, c1)
}

/// #1340 (Codex P1 on #1352): the reserved TypeEnv key under which an
/// enclosing `handle` publishes the instantiation it chose for a generic
/// effect. `$` cannot start a source identifier (it is already the marker for
/// compiler-generated effect variables), so this never collides with a user
/// binding, and riding the ordinary lexical env gives nested handles the right
/// scoping for free: the innermost handle of an effect wins.
fn effect_inst_env_key(eff: String) -> String {
  String::concat("$einst$", eff)
}

/// The instantiation an enclosing `handle` chose for `eff`, if this expression
/// sits inside one. The arity guard makes a stale binding (the effect
/// redeclared with a different parameter count between the handle and here)
/// fall back to a fresh instantiation instead of substituting the wrong number
/// of arguments.
fn effect_inst_lookup(env: TypeEnv, eff: String, etps: Array[String]) -> Option[Array[Type]] {
  match env_lookup(env, effect_inst_env_key(eff)) {
    Some(t) => match t {
      CtTuple(targs) => if Array::length(targs) == Array::length(etps) {
        Some(targs)
      } else {
        None
      },
      _ => None
    },
    None => None
  }
}

/// #1340 (Codex P1 on #1352): instantiate `eff`'s type params for ONE use
/// site, reusing the enclosing handle's instantiation when there is one so the
/// handled body and the arms that handle it share type variables. Falls back
/// to fresh variables when the perform is NOT inside a handle of that effect —
/// it is re-raised to the caller, whose own handle instantiates it.
///
/// This sharing is what makes `let s: String = perform Box::Get()` conflict
/// with `Get => resume(123)`. Until the row-label set comparison was fixed
/// (effect_label_sets_equal, same review) the link happened to fall out of
/// unification instead; with that comparison corrected the two sides no longer
/// meet on their own, so the instantiation has to be shared explicitly.
fn effect_instantiate(env: TypeEnv, eff: String, etps: Array[String], c: Int) -> (Array[Type], Int) {
  match effect_inst_lookup(env, eff, etps) {
    Some(targs) => (targs, c),
    None => effect_fresh_targs(etps, c)
  }
}

/// #813: is `eff` a DECLARED effect (TDEffect) in this module? Distinguishes
/// "unknown op of a declared effect" (reportable) from builtin/imported
/// effects the registry cannot see (skip).
fn effect_is_declared(defs: Array[TypeDef], eff: String) -> Bool {
  match find_typedef(defs, eff) {
    Some(td) => match td {
      TDEffect(_, _, _) => true,
      _ => false
    },
    None => false
  }
}

/// Where the record literal WROTE the value for field `name`, or -1 when the
/// field is absent or its value carries no offset (a literal -- see
/// ADR-0108). The sibling of `lookup_actual_field_ty`: that one answers what
/// type the literal gave a field, this one answers where to point when the
/// answer is wrong.
fn lookup_field_expr_off(fields: Array[(String, Expr)], name: String) -> Int {
  let mut i = 0
  let mut out = 0 - 1
  while i < Array::length(fields) {
    let (fname, fval) = Array::get(fields, i)
    if fname == name {
      out = tail_expr_off(fval)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn lookup_actual_field_ty(actual: Array[(String, Type)], name: String) -> Option[Type] {
  let mut i = 0
  let mut out = None
  while i < Array::length(actual) {
    let (an, at) = Array::get(actual, i)
    if an == name {
      out = Some(at)
    }
    i = i + 1
  }
  out
}

/// True when `dfields` (a struct's declared fields) is a STRICT superset of the
/// record literal's `actual` fields: every provided field name appears in the
/// struct, and the struct declares strictly more fields. Used to flag a record
/// that omits required fields.
fn struct_is_strict_superset(dfields: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {
  if Array::length(dfields) <= Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut all_in = true
    while i < Array::length(actual) {
      let (an, _) = Array::get(actual, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(dfields) {
        let (dn, _) = Array::get(dfields, j)
        if dn == an {
          found = true
        } else {
          ()
        }
        j = j + 1
      }
      if !found {
        all_in = false
      } else {
        ()
      }
      i = i + 1
    }
    all_in
  }
}

/// Check a record literal's field VALUES against the declared field types of the
/// (uniquely) matching struct definition — previously unchecked, so
/// `S::{ x: "oops" }` for `struct S { x: Int }` was accepted. Conservative: if 0
/// or >1 structs share the field-name set, skip (no struct could be determined).
fn check_record_fields(defs: Array[TypeDef], actual: Array[(String, Type)], s: Subst, errors: Array[String]) -> Subst {
  let mut matchct = 0
  let mut matched_fields = array_empty()
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(_, dfields, _, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        matched_fields = dfields
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 {
    let mut out = s
    let mut i = 0
    while i < Array::length(matched_fields) {
      let (fname, declared_ty) = Array::get(matched_fields, i)
      match lookup_actual_field_ty(actual, fname) {
        Some(actual_ty) => {
          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat("struct field type mismatch for ", fname), 0 - 1)
        },
        None => ()
      }
      i = i + 1
    }
    out
  } else if matchct > 1 {
    // Ambiguous: MORE than one struct declares exactly this field-name set
    // (e.g. `S2 { name: Int; y: String }` vs `S3 { y: String; name: String }`).
    // The literal is a valid construction of one of them, we just cannot tell
    // which — skip value checking, and in particular do NOT fall through to
    // the missing-field superset heuristic below: it used to fire here and
    // report a bogus "missing field" against some unrelated superset struct
    // (found by tests/fuzz/run_fuzz.sh, seeds 68/282).
    s
  } else {
    // No struct has EXACTLY this field set. If exactly one struct is a strict
    // SUPERSET (contains every provided field and at least one more), the record
    // is that struct with fields MISSING — a real soundness hole, since the
    // omitted fields would be left uninitialized. Reported only when the
    // superset is unique (otherwise the intended struct is ambiguous → skip).
    let mut supct = 0
    let mut sup_name = ""
    let mut sup_fields = array_empty()
    let mut dj = 0
    while dj < Array::length(defs) {
      match Array::get(defs, dj) {
        TDStruct(sname, dfields, _, _) => if struct_is_strict_superset(dfields, actual) {
          supct = supct + 1
          sup_name = sname
          sup_fields = dfields
        },
        _ => ()
      }
      dj = dj + 1
    }
    if supct == 1 {
      let mut fi = 0
      while fi < Array::length(sup_fields) {
        let (dn, _) = Array::get(sup_fields, fi)
        match lookup_actual_field_ty(actual, dn) {
          Some(_) => (),
          None => Array::push(errors, String::concat("missing field `", String::concat(dn, String::concat("` in construction of struct ", sup_name))))
        }
        fi = fi + 1
      }
      s
    } else {
      s
    }
  }
}

/// Resolve the (uniquely) matching struct name for a record literal's field-name
/// set. Returns None when 0 or >1 structs share that field set (ambiguous), or
/// when the matching struct is GENERIC (non-ground fields) — so a record's
/// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used
/// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of
/// CtUnknown, which in turn lets `mut`-field write checking see the struct
/// without disturbing generic-struct inference.
fn resolve_record_struct_name(defs: Array[TypeDef], actual: Array[(String, Type)]) -> Option[String] {
  let mut matchct = 0
  let mut out = None
  let mut ground = false
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(sname, dfields, _, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        out = Some(sname)
        ground = struct_fields_ground(dfields)
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 && ground {
    out
  } else {
    None
  }
}

/// Unify each argument against its parameter, REPORTING a type mismatch instead
/// of silently swallowing it. `__to_string` (the polymorphic interpolation
/// stringifier: `"\{x}"` -> `__to_string(x)` wraps values of any type, but the
/// polyfill annotates it `(Int) -> String`) is exempt.
fn unify_call_args(param_tys: Array[Type], arg_tys: Array[Type], s: Subst, errors: Array[String], label: String, off: Int) -> Subst {
  let mut out = s
  let mut ui = 0
  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
  while ui < ul {
    let pty = Array::get(param_tys, ui)
    let aty = Array::get(arg_tys, ui)
    out = if label == "__to_string" {
      match unify(pty, aty, out) {
        Some(su) => su,
        None => out
      }
    } else {
      check_assignable(pty, aty, out, errors, String::concat("argument type mismatch for ", label), off)
    }
    ui = ui + 1
  }
  out
}

fn param_marker_index(label: String) -> Option[Int] {
  if String::starts_with(label, "#param[") {
    let close = String::index_of(label, "]")
    if close > 7 {
      let mut id = 0
      let mut p = 7
      while p < close {
        id = id * 10 + (String::char_code_at(label, p) - 48)
        p = p + 1
      }
      Some(id)
    } else {
      None
    }
  } else {
    None
  }
}

/// Scalar / unit types cannot later mention a region, so a function that
/// merely returns such a parameter must stay a pure `None` row. Attaching
/// `#aliasparam` there made identity `(x: Int) -> x` look effectful and
/// then fail #939 drop-checks (`inc` into a `with Logger` slot, Parallel::map).
fn type_can_carry_region(ty: Type) -> Bool {
  match ty {
    CtFn(_, _, _) => true,
    CtArray(_) => true,
    CtOption(_) => true,
    CtTuple(_) => true,
    CtRecord(_) => true,
    CtNamed(_, _) => true,
    CtStruct(_) => true,
    CtEnum(_) => true,
    CtVar(_) => true,
    CtUnknown => true,
    CtForAll(_, _, _) => true,
    _ => false
  }
}

fn add_param_capture_dependency(ty: Type, index: Int) -> Type {
  match ty {
    CtFn(params, ret, effect) => CtFn(for param in params {
      add_param_capture_dependency(param, index)
    }, add_param_capture_dependency(ret, index), merge_provenance_row(effect, Some(String::concat("#param[", String::concat(__to_string(index), "]"))))),
    CtArray(elem) => CtArray(add_param_capture_dependency(elem, index)),
    CtOption(elem) => CtOption(add_param_capture_dependency(elem, index)),
    CtTuple(items) => CtTuple(for item in items {
      add_param_capture_dependency(item, index)
    }),
    CtRecord(fields) => CtRecord(for field in fields {
      let (name, field_ty) = field
      (name, add_param_capture_dependency(field_ty, index))
    }),
    CtNamed(name, args) => CtNamed(name, for arg in args {
      add_param_capture_dependency(arg, index)
    }),
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, add_param_capture_dependency(body, index)),
    _ => ty
  }
}

fn collect_internal_provenance(ty: Type, out: Array[String]) -> Unit {
  match ty {
    CtFn(params, ret, effect) => {
      match effect {
        Some(row) => for raw in String::split(row, ",") {
          let label = String::trim(raw)
          if (String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[")) && !string_array_has(out, label) {
            Array::push(out, label)
          }
        },
        None => ()
      }
      for param in params {
        collect_internal_provenance(param, out)
      }
      collect_internal_provenance(ret, out)
    },
    CtArray(elem) => collect_internal_provenance(elem, out),
    CtOption(elem) => collect_internal_provenance(elem, out),
    CtTuple(items) => for item in items {
      collect_internal_provenance(item, out)
    },
    CtRecord(fields) => for field in fields {
      let (_, field_ty) = field
      collect_internal_provenance(field_ty, out)
    },
    CtNamed(name, args) => {
      if String::starts_with(name, "#region_") && !string_array_has(out, name) {
        Array::push(out, name)
      }
      for arg in args {
        collect_internal_provenance(arg, out)
      }
    },
    CtForAll(_, _, body) => collect_internal_provenance(body, out),
    _ => ()
  }
}

fn type_has_param_marker(ty: Type, marker: Int) -> Bool {
  let wanted = String::concat("#param[", String::concat(__to_string(marker), "]"))
  match ty {
    CtFn(params, ret, effect) => {
      let mut found = match effect {
        Some(row) => string_array_has(for raw in String::split(row, ",") {
          String::trim(raw)
        }, wanted),
        None => false
      }
      for param in params {
        if type_has_param_marker(param, marker) {
          found = true
        }
      }
      found || type_has_param_marker(ret, marker)
    },
    CtArray(elem) => type_has_param_marker(elem, marker),
    CtOption(elem) => type_has_param_marker(elem, marker),
    CtTuple(items) => {
      let mut found = false
      for item in items {
        if type_has_param_marker(item, marker) {
          found = true
        }
      }
      found
    },
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, field_ty) = field
        if type_has_param_marker(field_ty, marker) {
          found = true
        }
      }
      found
    },
    CtNamed(_, args) => {
      let mut found = false
      for arg in args {
        if type_has_param_marker(arg, marker) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

fn param_marker_argument(marker: Int, param_tys: Array[Type], arg_tys: Array[Type]) -> Option[Type] {
  let len = min_int(Array::length(param_tys), Array::length(arg_tys))
  let mut i = 0
  let mut found = None
  while i < len {
    if type_has_param_marker(Array::get(param_tys, i), marker) {
      found = Some(Array::get(arg_tys, i))
    }
    i = i + 1
  }
  found
}

fn resolve_param_provenance(ty: Type, param_tys: Array[Type], arg_tys: Array[Type]) -> Type {
  match ty {
    CtFn(params, ret, effect) => {
      let labels = array_empty()
      match effect {
        Some(row) => for raw in String::split(row, ",") {
          let label = String::trim(raw)
          match param_marker_index(label) {
            Some(marker) => match param_marker_argument(marker, param_tys, arg_tys) {
              Some(arg_ty) => collect_internal_provenance(arg_ty, labels),
              None => Array::push(labels, label)
            },
            None => Array::push(labels, label)
          }
        },
        None => ()
      }
      let mapped_params = for param in params {
        resolve_param_provenance(param, param_tys, arg_tys)
      }
      let resolved_effect = if Array::length(labels) == 0 {
        None
      } else {
        Some(String::join(labels, ", "))
      }
      CtFn(mapped_params, resolve_param_provenance(ret, param_tys, arg_tys), resolved_effect)
    },
    CtArray(elem) => CtArray(resolve_param_provenance(elem, param_tys, arg_tys)),
    CtOption(elem) => CtOption(resolve_param_provenance(elem, param_tys, arg_tys)),
    CtTuple(items) => CtTuple(for item in items {
      resolve_param_provenance(item, param_tys, arg_tys)
    }),
    CtRecord(fields) => CtRecord(for field in fields {
      let (name, field_ty) = field
      (name, resolve_param_provenance(field_ty, param_tys, arg_tys))
    }),
    CtNamed(name, args) => CtNamed(name, for arg in args {
      resolve_param_provenance(arg, param_tys, arg_tys)
    }),
    _ => ty
  }
}

fn call_result_with_provenance(ret: Type, param_tys: Array[Type], arg_tys: Array[Type], s: Subst) -> Type {
  let resolved_ret = subst_apply(s, ret)
  match resolved_ret {
    CtFn(_, _, _)|CtArray(_)|CtOption(_)|CtTuple(_)|CtRecord(_)|CtNamed(_, _) => {
      let resolved_params = for param in param_tys {
        subst_apply(s, param)
      }
      let resolved_args = for arg in arg_tys {
        subst_apply(s, arg)
      }
      resolve_param_provenance(resolved_ret, resolved_params, resolved_args)
    },
    _ => resolved_ret
  }
}

/// #844: recognize the EXACT synthetic call shape `parser_expr_dispatch.vibe`'s
/// `ascribe_wrap` builds for a LOCAL `let x: T = val` --
/// `((__asc: T) -> __asc)(val)` -- and return its annotation `T`. `"__asc"` is
/// a dedicated internal marker name (parallel to `"__return__"` /
/// `"__in_loop__"` used elsewhere in this file), never written by real user
/// code, so this match is precise: an ordinary lambda call (a real user IIFE)
/// will not have a single param literally named `__asc` whose body is exactly
/// `EIdent("__asc", _)`. Used to run a dedicated, narrowly-scoped check for
/// this one call shape (see the `ECall` fallback arm below) instead of
/// changing the general call-argument checking (`unify_call_args`) that every
/// other call in the language goes through.
fn ascription_lambda_ann(callee: Expr) -> Option[TypeExpr] {
  match callee {
    EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {
      match ret_ty {
        Some(_) => None,
        None => match effect {
          Some(_) => None,
          None => {
            let (pname, pann) = Array::get(params, 0)
            if pname == "__asc" {
              match body {
                EIdent(bname, _) => if bname == "__asc" {
                  pann
                } else {
                  None
                },
                _ => None
              }
            } else {
              None
            }
          }
        }
      }
    } else {
      None
    },
    _ => None
  }
}

export fn fn_return_env_name(name: String) -> String {
  String::concat("__fn_ret__:", name)
}

/// #1455: the side-channel binding that carries a MONOMORPHIC enum's variant
/// list across a module boundary, the way `fn_return_env_name` carries a
/// function's return type. The checker's cross-module transport is the flat
/// `TypeEnv`, so an importing module sees each exported constructor as a bare
/// `Mk : (Int) -> Box` binding and nothing that says which enum owns `Mk`.
/// Three separate symptoms all come from that one missing edge:
/// `Box::Mk(..)` cannot resolve (`resolve_qualified_ctor_ident` finds no
/// `TDEnum` for `Box`), a non-exhaustive `match` cannot name the variants it
/// is missing, and `find_ctor_in_defs` falls through to `bind_unknown`, so an
/// imported enum's pattern payloads bind `CtUnknown` and are never checked
/// (`match b { Mk(n) => String::concat(n, "!") }` compiles with `n : Int`).
/// Rebuilding the `TDEnum` in the importing module's `defs` closes all three.
///
/// Parameterized enums ride the same carrier. What blocked them at first was
/// that a `TDEnum`'s payload types hold `CtVar` ids allocated by the DECLARING
/// compilation's fresh-id counter, with the binders that quantify them in
/// `type_def_binders` rather than in the `TDEnum` -- so the ids mean nothing in
/// the importing unit. The carrier therefore stores the enum's formals by NAME
/// alongside NAME-parameterized payloads (`encode_enum_def`), and the importing
/// side rebinds them to ids of its own: `seed_imported_enum_defs` for the
/// `TDEnum` it registers, `resolve_qualified_ctor_ident` for the `CtForAll`
/// scheme it hands a qualified reference.
///
/// The name is `Enum::__variants__` rather than a fresh `__enumdef__:Enum`
/// prefix so the carrier needs no transport code of its own: an importing
/// module's env is NOT the dependency's whole env, it is built name by name
/// from the import list, and `bind_enum_constructor_companions`
/// (runtime/typecheck_fs.vibe and runtime/runtime.vibe both have a copy)
/// already pulls across every dependency binding spelled `Enum::`, which is
/// how `Enum::equals` and the derive signatures reach an importer. Riding
/// that rule means the carrier arrives on every path that already carries
/// constructors, and cannot be forgotten by one of them.
export fn enum_def_env_name(name: String) -> String {
  String::concat(name, "::__variants__")
}

/// The enum a binding produced by `enum_def_env_name` describes, or None for
/// an ordinary binding.
export fn enum_def_env_target(binding_name: String) -> Option[String] {
  let suffix = "::__variants__"
  let slen = String::length(suffix)
  let blen = String::length(binding_name)
  if blen > slen && String::ends_with(binding_name, suffix) {
    Some(String::substring(binding_name, 0, blen - slen))
  } else {
    None
  }
}

/// The reserved leading entry that carries a parameterized enum's formal
/// parameter names. `__params__` is not a legal variant name, so a decoder can
/// tell it apart from a variant by name alone, and a monomorphic enum simply
/// omits it -- its encoding is byte-identical to the one that existed before
/// parameterized enums rode this carrier at all.
fn enum_def_params_marker() -> String {
  "__params__"
}

/// Variant list -> `Type`, so the carrier rides the existing `TypeEnv` instead
/// of adding a `TypeEnv` or `Type` variant: every `match` over those (plus the
/// persistent-env transport identity and the canonical checked-state walks)
/// would otherwise have to grow a case for a value that is pure provenance.
/// One variant becomes `CtNamed(vname, payloads)`; the whole list becomes
/// `CtNamed("__variants__", entries)`, which no source type can spell.
///
/// `params` names the enum's formal type parameters and is empty for a
/// monomorphic enum. The payload types written here must be the
/// NAME-parameterized form (`CtNamed("T", [])` where the declaration said `T`),
/// NOT the `CtVar`-substituted form the `TDEnum` stores: a `CtVar` id only
/// means anything paired with the binder list that quantifies it, and the
/// binder list lives in the declaring compilation's `type_def_binders`, which
/// does not cross the module boundary. Names do cross, and the importing side
/// re-substitutes its own fresh ids (see `seed_imported_enum_defs` and
/// `resolve_qualified_ctor_ident`).
export fn encode_enum_def(params: Array[String], variants: Array[(String, Array[Type])]) -> Type {
  let entries = array_empty()
  if Array::length(params) > 0 {
    let param_entries = array_empty()
    let mut pi = 0
    while pi < Array::length(params) {
      Array::push(param_entries, CtNamed(Array::get(params, pi), array_empty()))
      pi = pi + 1
    }
    Array::push(entries, CtNamed(enum_def_params_marker(), param_entries))
  } else {
    ()
  }
  let mut i = 0
  while i < Array::length(variants) {
    let (vname, payloads) = Array::get(variants, i)
    Array::push(entries, CtNamed(vname, payloads))
    i = i + 1
  }
  CtNamed("__variants__", entries)
}

/// Monomorphic shorthand for `encode_enum_def`.
export fn encode_enum_def_variants(variants: Array[(String, Array[Type])]) -> Type {
  encode_enum_def(array_empty(), variants)
}

/// Inverse of `encode_enum_def`, as `(params, variants)`. Returns None rather
/// than a partial list if the shape is not exactly what the encoder writes -- a
/// half-decoded variant list would register a `TDEnum` that silently loses
/// constructors.
export fn decode_enum_def(ty: Type) -> Option[(Array[String], Array[(String, Array[Type])])] {
  match ty {
    CtNamed(head, entries) => if head == "__variants__" {
      let params = array_empty()
      let out = array_empty()
      let mut ok = true
      let mut i = 0
      while i < Array::length(entries) {
        match Array::get(entries, i) {
          CtNamed(vname, payloads) => if vname == enum_def_params_marker() {
            let mut pi = 0
            while pi < Array::length(payloads) {
              match Array::get(payloads, pi) {
                CtNamed(pname, _) => Array::push(params, pname),
                _ => {
                  ok = false
                }
              }
              pi = pi + 1
            }
          } else {
            Array::push(out, (vname, payloads))
          },
          _ => {
            ok = false
          }
        }
        i = i + 1
      }
      if ok {
        Some((params, out))
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// `decode_enum_def` keeping only the variant list.
export fn decode_enum_def_variants(ty: Type) -> Option[Array[(String, Array[Type])]] {
  match decode_enum_def(ty) {
    Some((_, variants)) => Some(variants),
    None => None
  }
}

/// #938: the ArrayBuilder container type — `CtNamed("ArrayBuilder", [elem])`,
/// the same shape `b: ArrayBuilder[T]` annotations resolve to. Used by the
/// builder call branches below. #983/#996 (Codex P2): `Map` is deliberately
/// NOT listed here — `Map::set` is a FUNCTIONAL update (the linear codegen
/// allocates a fresh count+1 map and leaves the receiver untouched; measured:
/// `Map::has_key(m, "a")` is false after `let m2 = Map::set(m, "a", 1)`), so
/// aliases of one empty `Map::new()` binding do NOT share a live value slot.
/// Value-restricting Map would mis-reject
/// `let e = Map::new(); Map::set(e, "i", 1); Map::set(e, "s", "x")` (two
/// independent derived maps). Generalizing the empty literal's fresh slot is
/// therefore sound; maps whose slot is already CONCRETE (from_pairs values,
/// annotations, a set-chain's returned type) keep the #983 value check.
fn is_array_builder_head(t: Type) -> Bool {
  match t {
    CtNamed(n, targs) => n == "ArrayBuilder" && Array::length(targs) == 1,
    _ => false
  }
}

/// #1081 step 3 Phase B: true when a `TaskGroup[r]` / `TaskHandle[r,_]` /
/// `Sender[r,_]` / `Receiver[r,_]` region-tagged endpoint occurs anywhere in
/// the value's type. Generalizing a `let`-bound endpoint (ordinary
/// Hindley-Milner let-polymorphism, `generalize`) would sever its region
/// argument from the skolem `TaskGroup::run` minted -- EVERY later reference
/// re-instantiates a FRESH, unconnected region var, so `check_spawnable_
/// captures`'s same-region comparison (checker_spawnable.vibe) could never
/// see two endpoints from the same nursery as equal. Same value-restriction
/// shape as `is_array_builder_ty` right below (a mutable container has the
/// identical "generalizing loses the identity a later use needs" problem);
/// bind the monotype instead.
export fn is_region_tagged_ty(t: Type) -> Bool {
  match t {
    CtNamed(n, targs) => if n == "TaskGroup" && Array::length(targs) == 2 {
      true
    } else if (n == "TaskHandle" || n == "Sender" || n == "Receiver") && Array::length(targs) == 3 {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(targs) && !found {
        found = is_region_tagged_ty(Array::get(targs, i))
        i = i + 1
      }
      found
    },
    CtArray(e) => is_region_tagged_ty(e),
    CtOption(e) => is_region_tagged_ty(e),
    CtTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) && !found {
        found = is_region_tagged_ty(Array::get(elems, i))
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #938 value-restriction predicate (Codex P1 on #977): true when a builder
/// occurs ANYWHERE in the value's type reachable without crossing a function
/// boundary — `(ArrayBuilder::new(), 0)`, `[ArrayBuilder::new()]`,
/// `Some(ArrayBuilder::new())` all alias ONE live builder, so their element
/// vars must stay un-quantified exactly like a bare builder's (a root-only
/// check let each lookup of the tuple re-instantiate a fresh element slot and
/// mixed pushes type-checked again). CtFn is deliberately NOT descended:
/// a function value creates a NEW builder per call, so generalizing
/// `() -> ArrayBuilder[v]` is sound and useful.
export fn is_array_builder_ty(t: Type) -> Bool {
  if is_array_builder_head(t) {
    true
  } else {
    match t {
      CtArray(e) => is_array_builder_ty(e),
      CtOption(e) => is_array_builder_ty(e),
      CtTuple(elems) => {
        let mut i = 0
        let mut found = false
        while i < Array::length(elems) && !found {
          found = is_array_builder_ty(Array::get(elems, i))
          i = i + 1
        }
        found
      },
      CtNamed(_, targs) => {
        let mut i = 0
        let mut found = false
        while i < Array::length(targs) && !found {
          found = is_array_builder_ty(Array::get(targs, i))
          i = i + 1
        }
        found
      },
      _ => false
    }
  }
}

fn direct_builtin_return(name: String) -> Option[Type] {
  if name == "Bytes::length" {
    Some(CtInt)
  }
  else if name == "iter_length" || name == "String::iter_length" || name == "Map::iter_length" {
    Some(CtInt)
  }
  else if name == "Array::length" {
    Some(CtInt)
  }
  else if name == "FixedArray::length" || name == "Int64Array::length" {
    Some(CtInt)
  }
  else if name == "String::length" {
    Some(CtInt)
  }
  else if name == "Bytes::get" || name == "String::index_of" || name == "String::char_code_at" || name == "String::last_index_of" || name == "Char::to_int" || name == "Double::to_int" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" || name == "Env::args_len" || name == "Stdin::read_char" || name == "Int64Array::get" {
    Some(CtInt)
  }
  else if name == "String::equals" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "Array::any" || name == "Array::all" || name == "Array::contains" || name == "Map::has_key" || name == "map_has" || name == "MapBuilder::has_key" || name == "Path::is_absolute" || name == "Fs::exists" || name == "Fs::is_dir" || name == "Fs::is_file" || name == "eq" || name == "not" {
    Some(CtBool)
  }
  else if name == "String::concat" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::join" || name == "Array::join" || name == "Path::to_string" || name == "Path::resolve" || name == "PromptText::new" || name == "Stdin::read_stream" || name == "Env::get" || name == "Env::args_get" || name == "Fs::read_file" || name == "Fs::getcwd" || name == "sh" || name == "Lines::stringify" || name == "__to_string" {
    Some(CtString)
  }
  else if name == "__len" {
    Some(CtInt)
  }
  else if name == "String::iter_get" {
    Some(CtInt)
  }
  else if name == "iter_get" || name == "Map::iter_get" || name == "iter_require" || name == "__neg" {
    Some(CtUnknown)
  }
  else if name == "Bytes::new" || name == "Bytes::concat" || name == "Bytes::slice" || name == "Bytes::from_array" || name == "Fs::read_bytes" {
    Some(CtBytes)
  }
  else if name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "MutList::truncate" || name == "Array::foreach" || name == "FixedArray::set" || name == "FixedArray::blit" || name == "FixedArray::unsafe_set" || name == "Int64Array::set" || name == "Bytes::set" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "Stdout::write_char" || name == "Stdout::write_stream" || name == "sleep" || name == "Fs::copy" || name == "Fs::chdir" || name == "Fs::mkdir" || name == "Fs::mkdir_p" || name == "Fs::append" || name == "Fs::remove" || name == "Fs::rename" || name == "Fs::write_file" || name == "Fs::write_bytes" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" || name == "__set_field" {
    Some(CtUnit)
  }
  else if name == "Double::from_i64_bits" || name == "Int::to_double" || name == "Double::to_float" || name == "Float::to_double" {
    Some(CtDouble)
  }
  else if name == "Char::from_int" {
    Some(CtChar)
  }
  else if name == "Bytes::to_array" || name == "Int64Array::make" {
    Some(CtArray(CtInt))
  }
  else if name == "Map::keys" || name == "sh_lines" || name == "Lines::parse" || name == "String::split" {
    Some(CtArray(CtString))
  }
  else if name == "Array::slice" || name == "Array::concat" || name == "Array::filter" || name == "Array::reverse" || name == "Array::sort" || name == "FixedArray::make" {
    Some(CtArray(CtUnknown))
  }
  else if name == "Some" || name == "Array::find" {
    Some(CtOption(CtUnknown))
  }
  else {
    None
  }
}

fn direct_call_return(env: TypeEnv, name: String) -> Option[Type] {
  match env_lookup(env, name) {
    Some(_) => None,
    None => direct_builtin_return(canonical_builtin_name(name))
  }
}

/// Expected TOP-LEVEL head-kind (see `head_kind`) of a builtin's FIRST argument,
/// for the container/string builtins whose receiver head is unambiguous. 0 means
/// "unchecked". Used to catch `Array::length(5)` / `String::length(5)` etc. on
/// the direct-call fast path WITHOUT a per-call `lookup_builtin` (the #626
/// seed-heap OOM constraint). Only entries whose first-arg head is certain are
/// listed; anything else returns 0 (tolerated).
fn builtin_first_arg_head(name: String) -> Int {
  if name == "Array::length" || name == "Array::get" || name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::slice" || name == "Array::concat" || name == "Array::reverse" || name == "Array::truncate" || name == "Array::foreach" || name == "Array::contains" || name == "Array::any" || name == "Array::all" || name == "Array::find" || name == "Array::filter" {
    9
  } else if name == "String::length" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::index_of" || name == "String::last_index_of" || name == "String::char_code_at" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" || name == "String::concat" {
    4
  } else if name == "Bytes::length" || name == "Bytes::get" || name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::to_array" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" {
    7
  } else if name == "Int64Array::make" || name == "FixedArray::make" {
    // #989 review: the make length is arg 0, so the rest-position table
    // never sees it — `Int64Array::make("4", 0)` compiled with the String
    // as the loop bound. Both makes take a certain Int first.
    1
  } else {
    0
  }
}

/// Expected head-kind for argument position `i` (i >= 1) of fixed-signature
/// builtins, mirroring `builtin_first_arg_head` for the non-receiver args.
/// `direct_call_return` types these polymorphically, so passing e.g. an Int as
/// the second arg of `String::concat`, or a String as the index of
/// `String::substring`, slipped through. 0 = tolerate (no certain head). Only
/// monomorphic, non-callback positions are listed (so HOF args like Array::map's
/// function stay untouched — those need real signature inference, not a head).
fn builtin_arg_head_rest(name: String, i: Int) -> Int {
  // String head = 4, Int head = 1, Bytes head = 7 (see head_kind).
  if name == "String::concat" {
    if i == 1 {
      4
    } else {
      0
    }
  } else if name == "String::index_of" || name == "String::last_index_of" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" {
    if i == 1 {
      4
    } else {
      0
    }
  } else if name == "String::substring" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "String::char_code_at" {
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Bytes::get" || name == "Bytes::push" {
    // #985: Bytes::push's pushed byte (Int) was unlisted, so
    // `Bytes::push(b, "hello")` compiled clean and wrote a garbage byte.
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::fill" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "Bytes::blit" {
    // blit(dst: Bytes, src: Bytes, src_off: Int, len: Int)
    if i == 1 {
      7
    } else if i == 2 || i == 3 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::get" {
    // #985: the Int64Array positions were never listed —
    // `Int64Array::set(w, 0, "hi")` wrote a String pointer into an i64 slot.
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::set" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::make" {
    if i == 1 {
      1
    } else {
      0
    }
  } else {
    0
  }
}

/// Fixed argument COUNT for direct-path builtins (-1 = unchecked). The direct
/// fast path types the call by name alone (the #626 seed-heap constraint rules
/// out a per-call `lookup_builtin`), so a wrong argument count was silently
/// accepted — and the linear backend then emitted the surplus operands straight
/// into the wasm body (`Bytes::new(3)` left a value stranded on the stack and
/// the module failed validation only at instantiation). Only builtins whose
/// arity is certain are listed; anything variadic-ish or unsure stays -1.
/// `Bytes::new` is handled separately (0 or 1 capacity arg).
fn builtin_fixed_arity(name: String) -> Int {
  let name = canonical_builtin_name(name)
  if name == "Array::length" || name == "Array::reverse" || name == "String::length" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::iter_length" || name == "Bytes::length" || name == "Bytes::to_array" || name == "Bytes::from_array" || name == "Map::keys" || name == "Map::iter_length" || name == "Char::to_int" || name == "Char::from_int" || name == "Double::to_int" || name == "Double::from_i64_bits" || name == "Int::to_double" || name == "not" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "__to_string" || name == "FixedArray::length" || name == "Int64Array::length" {
    1
  } else if name == "Array::get" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::concat" || name == "Array::contains" || name == "Array::any" || name == "Array::all" || name == "Array::find" || name == "Array::filter" || name == "Array::join" || name == "Array::foreach" || name == "String::equals" || name == "String::concat" || name == "String::char_code_at" || name == "String::index_of" || name == "String::last_index_of" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" || name == "String::join" || name == "String::iter_get" || name == "Bytes::get" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::concat" || name == "Map::has_key" || name == "map_has" || name == "MapBuilder::has_key" || name == "MapBuilder::get" || name == "eq" || name == "assert_eq" || name == "FixedArray::get" || name == "FixedArray::make" || name == "Int64Array::get" || name == "Int64Array::make" {
    2
  } else if name == "Array::set" || name == "Array::slice" || name == "String::substring" || name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "FixedArray::set" || name == "FixedArray::unsafe_set" || name == "Int64Array::set" {
    3
  } else if name == "Bytes::blit" {
    4
  } else if name == "FixedArray::blit" {
    5
  } else {
    // #1513: fall back to the central registry rather than growing this list.
    // The chain above predates the registry and covers the pure container /
    // string builtins; every HOST builtin (`Stdout::*`, `Env::*`, `Stdin::*`,
    // `Fs::*`, `sh`, `sleep`, ...) declares its parameters there and was
    // therefore arity-UNCHECKED here -- `Stdout::write_stream()` compiled and
    // emitted a module the host rejected at load time, and
    // `Fs::read_file("a", "b")` did the same. Returns -1 for a non-registry
    // name, so anything this pass genuinely cannot see stays tolerated exactly
    // as before.
    registry_builtin_arity(name)
  }
}

/// #1513: the expected head kind of builtin `name`'s argument `i`, hand table
/// FIRST and the central registry as the fallback.
///
/// The two hand tables above (`builtin_first_arg_head` /
/// `builtin_arg_head_rest`) predate the registry and cover Array / String /
/// Bytes / FixedArray only, so every HOST builtin's arguments were unchecked:
/// `Stdout::write_stream(42)` compiled AND RAN, printing the pointer as a
/// decimal. Same shape as the arity gap this issue's first half closed —
/// "which builtins get checked" was the maintenance state of a list, not a rule.
///
/// The hand table wins where it has an entry so nothing already checked can
/// change verdict (it encodes receiver-position knowledge the registry's
/// per-parameter types do not, e.g. HOF callbacks deliberately left at 0).
/// A registry parameter typed `CtUnknown` maps to head 0 = tolerate, which is
/// how `assert_eq` and friends stay unchecked.
fn builtin_param_head(name: String, i: Int) -> Int {
  let normalized = canonical_builtin_name(name)
  let hand = if i == 0 {
    builtin_first_arg_head(normalized)
  } else {
    builtin_arg_head_rest(normalized, i)
  }
  if hand != 0 {
    hand
  } else {
    match registry_builtin_param_type(normalized, i) {
      Some(t) => head_fold_char(head_kind(t)),
      None => 0
    }
  }
}

/// `Char` is an `Int` alias in this language: the lexer emits `TInt` for a char
/// literal, so `'A' == 65` and `char_int_compatible` (core/types.vibe) lets the
/// two unify freely in both directions. The head-kind check must not invent a
/// distinction `unify` does not make, so fold `CtChar`'s head into `CtInt`'s on
/// both sides of the comparison. Without this the registry's `Char::to_int`
/// row (declared `CtChar`) rejects `Char::to_int('A')`, and a `CtChar`-typed
/// value (e.g. `Char::from_int(65)`) is rejected by every builtin whose
/// registry row spells the slot `CtInt` (`Stdout::write_char`, ...).
fn head_fold_char(k: Int) -> Int {
  if k == 5 {
    1
  } else {
    k
  }
}

/// Check a higher-order builtin's callback parameter against the type it will be
/// fed. `recv_ty` / `fn_ty` are already subst-applied; when the receiver is a
/// concrete `CtArray(elem)` and the callback is a `CtFn` with a parameter at
/// `pidx`, require `elem` to be assignable to that parameter type. Ground-gated
/// via check_assignable, so an unannotated callback param (a fresh CtVar that
/// the body never pins to a concrete type) stays tolerant — only an explicit
/// wrong annotation (or a body that pins the param to a mismatching concrete
/// type) is rejected. `expected_ty` is the param (the slot), `elem` the value.
fn check_hof_param_vs_elem(recv_ty: Type, fn_ty: Type, pidx: Int, s: Subst, errors: Array[String], msg: String) -> Subst {
  match recv_ty {
    CtArray(elem) => match fn_ty {
      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {
        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)
      } else {
        s
      },
      _ => s
    },
    _ => s
  }
}

/// Require two array operands to share an element type (Array::concat /
/// Array::push_all). `a_app` / `b_app` are already subst-applied; when both are
/// concrete `CtArray`, ground-gated check_assignable compares their element
/// types (generic / var operands stay tolerant).
fn check_two_array_elems(a_app: Type, b_app: Type, s: Subst, errors: Array[String], msg: String) -> Subst {
  match a_app {
    CtArray(ea) => match b_app {
      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),
      _ => s
    },
    _ => s
  }
}

/// Declared type of a (monomorphic) struct field by name, or None if the struct
/// or field is unknown. Used to recognise a field-stored-function call
/// `b.f(args)` when no method/builtin `T::f` exists.
fn struct_field_type(defs: Array[TypeDef], sname: String, field: String) -> Option[Type] {
  match find_typedef(defs, sname) {
    Some(td) => match td {
      TDStruct(_, fields, _, _) => {
        let rec go: (Int) -> Option[Type] = (i) -> {
          if i >= Array::length(fields) {
            None
          } else {
            let (fname, ftype) = Array::get(fields, i)
            if fname == field {
              Some(ftype)
            } else {
              go(i + 1)
            }
          }
        }
        go(0)
      },
      _ => None
    },
    None => None
  }
}

/// #829: instantiate a declared field type against the receiver's actual type
/// arguments (`CtNamed(S, targs)`). Substitutes only when the declared param
/// list and the argument list line up; otherwise the raw (rigid) type is kept,
/// which downstream checks tolerate exactly as before.
fn inst_struct_field_ty(ft: Type, tparams: Array[String], targs: Array[Type]) -> Type {
  if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {
    subst_type_params(ft, tparams, targs)
  } else {
    ft
  }
}

/// #829: field type of a struct-typed receiver, instantiated when the receiver
/// is an applied generic struct. `CtStruct` receivers keep the raw field type
/// (monomorphic structs have no params to substitute). None when the receiver
/// is not a known struct or the field does not exist.
fn receiver_struct_field_type(defs: Array[TypeDef], recv: Type, field: String) -> Option[Type] {
  match recv {
    CtStruct(sname) => struct_field_type(defs, sname, field),
    CtNamed(sname, targs) => match find_typedef(defs, sname) {
      Some(td) => match td {
        TDStruct(_, _, _, tparams) => match struct_field_type(defs, sname, field) {
          Some(ft) => Some(inst_struct_field_ty(ft, tparams, targs)),
          None => None
        },
        _ => None
      },
      None => None
    },
    _ => None
  }
}

fn is_logic_binop(op: String) -> Bool {
  op == "&&"
  || op == "||"
}

fn is_order_binop(op: String) -> Bool {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}

fn type_name_prefix(ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}

/// #994: builtin data types that can appear as a dot-call RECEIVER's checked
/// type (via `type_name_prefix` or a `CtNamed` head). An unresolved method on
/// one of these is definitely bogus -- there is no "it might be an imported
/// user type with the method defined elsewhere" escape hatch for a builtin.
/// Deliberately excludes namespace-only builtins (Fs, Http, Socket, Stdout,
/// ...) that are never a receiver VALUE's type, only ever called by
/// `Module::fn` name -- including them here would risk false positives on
/// legitimate qualified-import shortcut calls that happen to share a method
/// name.
/// #994 review: `Bool`/`Option`/`Result` are excluded even though they are
/// builtin heads. lib/@vibe/builtin/{bool,option,result}.vibe extend them
/// with real top-level `fn Bool::to_int` etc., and the *_type_import_test.vibe
/// fixtures use the "import just the type, dot-call resolves the method via
/// the merged program" idiom the #953 comment documents -- in an isolated
/// per-file check (as these unit tests exercise) the extension fn isn't in
/// `env` yet, so gating on this prefix here regressed 4 passing tests
/// (`no method ... on Bool/Option/Result`) that only compile correctly once
/// merged. No equivalent extension-via-type-import convention exists for the
/// container types below (grep confirms no prelude file extends Array/Bytes/
/// Map/...), so they keep the stricter check.
/// #994 follow-up (Codex P1): `Int`/`Double`/`Char` were missing here even
/// though `lib/@vibe/builtin/{int,double}.vibe` extend them with real fns
/// (`Int::abs`, `Double::ceil`, ...) the same way Bool/Option/Result do.
/// Unlike Bool/Option/Result, no test anywhere dot-calls one of those
/// extension fns (grep across the repo for `.abs(`/`.gcd(`/`.ceil(`/... on a
/// bare int/double/char value found zero hits), so there is no "import type
/// only, resolve via merge" idiom to protect for these three -- adding them
/// carries none of the regression risk that excluded Bool/Option/Result.
/// Confirmed the gap empirically: `n.to_string()` for `n: Int` checks and
/// "succeeds" (no parsed `fn Int::to_string` exists anywhere, only a
/// checker-only `lookup_builtin` signature), then codegen dies with
/// "unknown struct field: to_string" -- the exact class of bug #994 exists
/// to catch.
fn is_known_builtin_receiver_prefix(prefix: String) -> Bool {
  prefix == "String"
  || prefix == "Bytes"
  || prefix == "Array"
  || prefix == "Map"
  || prefix == "MapBuilder"
  || prefix == "Int64Array"
  || prefix == "FixedArray"
  || prefix == "ArrayBuilder"
  || prefix == "StringBuilder"
  || prefix == "Int"
  || prefix == "Double"
  || prefix == "Char"
}

fn is_equality_binop(op: String) -> Bool {
  op == "=="
  || op == "!="
}

fn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}

fn unify_same_binop_operands(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {
  match unify(left_ty, right_ty, s) {
    Some(s1) => Some((subst_apply(s1, left_ty), s1)),
    None => None
  }
}

fn infer_named_trait_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {
  match unify_same_binop_operands(left_ty, right_ty, s) {
    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {
      Some((resolved, s1))
    } else {
      None
    },
    None => None
  }
}

fn binop_str_arr_contains(arr: Array[String], val: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

/// #952: a bound generic type parameter (`[T: Ord]` / `[T: Add]`) is checked
/// as a plain `CtVar(id)` carrying its trait bounds in the current `Subst`
/// (recorded by `subst_add_bound` when the `EFn` type-param header is
/// processed, read back via `subst_bounds_for`). The order/`+` binop paths
/// below try `unify_binop_candidate(_, _, CtInt, s)` FIRST as a fast path for
/// ordinary (unbound) local-var inference -- but `unify` treats ANY unbound
/// `CtVar` as freely unifiable with `CtInt` (no bound check), so that fast
/// path silently binds T := Int the first time `<`/`>`/`+` appears in a bound
/// generic function's OWN body, before any call site is even seen. That
/// poisons the substitution used to `generalize` the function's signature,
/// turning `fn my_lt[T: Ord](a: T, b: T) -> Bool { a < b }` into a
/// monomorphic `(Int, Int) -> Bool` -- so calling it with String args later
/// fails with "expected Int, got String" even though `impl Ord for String`
/// exists. `==`/`!=` never hit this because `is_equality_binop` only unifies
/// the two operands against EACH OTHER (never against a concrete target
/// type), so a bound CtVar is never concretized there.
///
/// Fix: when either operand resolves (post-subst) to a CtVar whose recorded
/// bounds already include the needed trait, dispatch directly here -- unify
/// the operands against EACH OTHER only (mirroring the Eq path) and skip the
/// CtInt/CtDouble fast paths entirely, so the type parameter stays
/// rigid/polymorphic through the rest of the definition check. An ordinary
/// unbound CtVar (no recorded bounds -- the common unannotated-local-var
/// inference case, e.g. `fn f(x) { x < 5 }`) is untouched: `rigid_bound_operand`
/// returns false for it, so it still takes the existing
/// CtInt/CtDouble/struct-Ord(Add) fast path exactly as before.
fn rigid_bound_operand(ty: Type, s: Subst, trait_name: String) -> Bool {
  match subst_apply(s, ty) {
    CtVar(id) => binop_str_arr_contains(subst_bounds_for(s, id), trait_name),
    _ => false
  }
}

/// Bounds recorded on a var the operand-vs-operand unify just eliminated
/// (post-subst it is no longer a CtVar) would otherwise be dropped: in
/// `fn bad[T: Ord, U](a: T, b: U) { a < b }` unify may bind T := U, leaving
/// the surviving U with NO recorded Ord bound, so generalize exports an
/// unbounded (U, U) -> Bool and `bad(true, false)` sails through the
/// call-site bound check. Collect each operand's pre-unify var bounds so
/// they can be re-recorded on whatever survives.
fn operand_var_bounds(ty: Type, s: Subst) -> Array[String] {
  match subst_apply(s, ty) {
    CtVar(id) => subst_bounds_for(s, id),
    _ => array_empty()
  }
}

fn rigid_trait_bound_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {
  if rigid_bound_operand(left_ty, s, trait_name) || rigid_bound_operand(right_ty, s, trait_name) {
    let lb = operand_var_bounds(left_ty, s)
    let rb = operand_var_bounds(right_ty, s)
    match unify_same_binop_operands(left_ty, right_ty, s) {
      Some((resolved, s1)) => match subst_apply(s1, resolved) {
        CtVar(id) => {
          // Var survivor: transfer every bound either operand carried that
          // the survivor does not already record, so generalize keeps them.
          let have = subst_bounds_for(s1, id)
          let missing = ArrayBuilder::new()
          let mut i = 0
          while i < Array::length(lb) + Array::length(rb) {
            let cand = if i < Array::length(lb) {
              Array::get(lb, i)
            } else {
              Array::get(rb, i - Array::length(lb))
            }
            if !binop_str_arr_contains(have, cand) {
              // (duplicates between lb and rb are harmless -- bound lookups
              // only ever ask "contains", never count)
              ArrayBuilder::push(missing, cand)
            } else {
              ()
            }
            i = i + 1
          }
          let missing_arr = ArrayBuilder::freeze(missing)
          if Array::length(missing_arr) > 0 {
            Some((resolved, subst_add_bound(s1, id, missing_arr)))
          } else {
            Some((resolved, s1))
          }
        },
        other => if type_implements_trait(env, s1, other, trait_name) {
          // Concrete survivor (e.g. `a < "x"` forcing T := String): only
          // accept when it actually implements the required trait --
          // mirroring infer_named_trait_binop, which handled this shape
          // before the rigid pre-step existed.
          Some((resolved, s1))
        } else {
          None
        }
      },
      None => None
    }
  } else {
    None
  }
}

/// `type mismatch in '<op>': <tail>`, carrying the operand anchor as the
/// strippable `[@off=N]` marker. Every binop mismatch in `infer_binop_type`
/// goes through here so none of them can silently go back to being unlocated:
/// the offset is a parameter of the message, not an afterthought at one site.
/// String::concat only (`+`/interpolation mis-codegen to NUL here).
fn binop_mismatch_msg(op: String, tail: String, off: Int) -> String {
  String::concat(String::concat("type mismatch in '", String::concat(op, tail)), off_marker(off))
}

/// `off` is the source anchor of the offending operator expression (the left
/// operand's offset, falling back to the right's) -- see the EBinOp arm. -1
/// when neither operand carries one, which is what a literal-only expression
/// like `1 + "s"` gives: EInt/EString/EBool/EFloat have no offset slot in the
/// AST (lib/@vibe/ast/index.vpkg), so there is nothing to point at. off_marker
/// emits nothing for -1, leaving those messages exactly as they were.
fn infer_binop_type(op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String], tytab: Array[(Int, Type)], off: Int) -> (Type, Subst) {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, binop_mismatch_msg(op, "': operands must be Bool", off))
        (CtUnknown, s)
      }
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => {
        // Tolerate unresolved NOMINAL operands: a generic `[T]` callee's
        // result reaches here as a rigid CtNamed type param when call-site
        // instantiation can't ground it (#829) — e.g.
        // `Array::get(ArrayView::to_array(v), 0) == 20`. Pre-fn-migration
        // these positions were CtUnknown, so erroring regressed working
        // code. Fully concrete mismatches still error.
        let eq_l = subst_apply(s, left_ty)
        let eq_r = subst_apply(s, right_ty)
        let eq_has_named = match eq_l {
          CtNamed(_, _) => true,
          _ => match eq_r {
            CtNamed(_, _) => true,
            _ => false
          }
        }
        if eq_has_named {
          (CtBool, s)
        } else {
          Array::push(errors, binop_mismatch_msg(op, "': operands must have same type", off))
          (CtUnknown, s)
        }
      }
    }
  }
  else if is_order_binop(op) {
    match rigid_trait_bound_binop(env, left_ty, right_ty, "Ord", s) {
      Some((_, s1)) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
        Some(s1) => (CtBool, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
          Some(s1) => (CtBool, s1),
          None => match infer_named_trait_binop(env, left_ty, right_ty, "Ord", s) {
            Some((_, s1)) => (CtBool, s1),
            None => {
              Array::push(errors, binop_mismatch_msg(op, "': operands must be Int or Double", off))
              (CtUnknown, s)
            }
          }
        }
      }
    }
  }
  else if op == "+" {
    match rigid_trait_bound_binop(env, left_ty, right_ty, "Add", s) {
      Some((resolved, s1)) => (resolved, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
        Some(s1) => (CtInt, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
          Some(s1) => (CtDouble, s1),
          None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
            Some(s1) => (CtString, s1),
            None => match infer_named_trait_binop(env, left_ty, right_ty, "Add", s) {
              Some((resolved, s1)) => (resolved, s1),
              None => {
                Array::push(errors, binop_mismatch_msg("+", "': operands must be Int, Double, or String", off))
                (CtUnknown, s)
              }
            }
          }
        }
      }
    }
  }
  else if op == "-"
  || op == "*"
  || op == "/" {
    let trait_name = if op == "-" {
      "Sub"
    } else if op == "*" {
      "Mul"
    } else {
      "Div"
    }
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {
          Some((resolved, s1)) => (resolved, s1),
          None => {
            Array::push(errors, binop_mismatch_msg(op, "': operands must be Int or Double", off))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, binop_mismatch_msg("%", "': operands must be Int", off))
        (CtUnknown, s)
      }
    }
  }
  else if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, binop_mismatch_msg(op, "': operands must be Int", off))
        (CtUnknown, s)
      }
    }
  }
  else {
    Array::push(errors, String::concat(String::concat("unknown operator: ", op), off_marker(off)))
    (CtUnknown, s)
  }
}

/// Recursively replace type-parameter names (those bound to a CtVar in `env`)
/// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type
/// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and
/// their args recursed. This lets a generic annotation like `Map[String, V]`
/// resolve its inner `V` to the function's quantified var, so call sites can
/// instantiate it (the previous shallow lookup only handled the outermost name).
fn resolve_tparams_in(ty: Type, env: TypeEnv) -> Type {
  match ty {
    CtNamed(name, args) => {
      let ra = for a in args {
        resolve_tparams_in(a, env)
      }
      match env_lookup(env, name) {
        Some(t) => match t {
          CtVar(_) => t,
          _ => CtNamed(name, ra)
        },
        None => CtNamed(name, ra)
      }
    },
    CtArray(e) => CtArray(resolve_tparams_in(e, env)),
    CtOption(e) => CtOption(resolve_tparams_in(e, env)),
    CtTuple(es) => CtTuple(for e in es {
      resolve_tparams_in(e, env)
    }),
    CtFn(ps, ret, eff) => {
      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = array_empty()
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, resolve_tparams_in(Array::get(types, i), env))
          i = i + 1
        }
        out
      }
      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)
    },
    _ => ty
  }
}

// Internal append-time capture. It is allocated only by the explicit
// observation entry points; ordinary checking carries None and keeps the
// legacy `(offset, Type)` table as its only output.
export struct TypedOccurrenceRoleLaneCapture {
  entries: Array[(String, String)];
  provenance_entries: Array[(Array[Int], Array[Int], String, String, Type)];
  mut statement_path: Array[Int];
  frame_paths: Array[Array[Int]];
  frame_next_children: Array[Int];
  frame_expected_children: Array[Int];
  frame_direct_recorded: Array[Bool];
  direct_entries: Array[(Array[Int], Array[Int], Type)];
  direct_enabled: Bool;
  mut frame_depth: Int;
  mut complete: Bool
}

/// Start one retained statement's expression root. This mutable state exists
/// only for explicit provenance observations; the production checker passes
/// None and performs no path allocation.
export fn typed_occurrence_capture_begin_statement(capture: Option[TypedOccurrenceRoleLaneCapture], statement_path: Array[Int]) -> Unit {
  match capture {
    Some(c) => {
      c.statement_path = Array::slice(statement_path, 0, Array::length(statement_path))
      c.frame_depth = 0
    },
    None => ()
  }
}

/// End a retained statement. Clearing the logical stack prevents a later
/// statement from ever inheriting an expression coordinate.
export fn typed_occurrence_capture_end_statement(capture: Option[TypedOccurrenceRoleLaneCapture]) -> Unit {
  match capture {
    Some(c) => {
      // Every statement root must have exited before the statement boundary.
      // Do not let a checker traversal-order divergence leak into the next
      // statement as a plausible path.
      if c.frame_depth != 0 {
        c.complete = false
        c.frame_depth = 0
      } else {
        ()
      }
    },
    None => ()
  }
}

fn typed_occurrence_capture_enter_expression(capture: Option[TypedOccurrenceRoleLaneCapture], expr: Expr) -> Unit {
  match capture {
    Some(c) => {
      let path = if c.frame_depth == 0 {
        // The statement coordinate is captured independently at append time;
        // each retained statement expression starts at structural root [].
        array_empty()
      } else {
        let parent_index = c.frame_depth - 1
        let parent_path = Array::get(c.frame_paths, parent_index)
        let child_index = Array::get(c.frame_next_children, parent_index)
        Array::set(c.frame_next_children, parent_index, child_index + 1)
        let next_path = Array::slice(parent_path, 0, Array::length(parent_path))
        Array::push(next_path, child_index)
        next_path
      }
      if c.frame_depth < Array::length(c.frame_paths) {
        Array::set(c.frame_paths, c.frame_depth, path)
        Array::set(c.frame_next_children, c.frame_depth, 0)
        Array::set(c.frame_expected_children, c.frame_depth, Array::length(expr_children(expr)))
        Array::set(c.frame_direct_recorded, c.frame_depth, false)
      } else {
        Array::push(c.frame_paths, path)
        Array::push(c.frame_next_children, 0)
        Array::push(c.frame_expected_children, Array::length(expr_children(expr)))
        Array::push(c.frame_direct_recorded, false)
      }
      c.frame_depth = c.frame_depth + 1
    },
    None => ()
  }
}

fn typed_occurrence_capture_exit_expression(capture: Option[TypedOccurrenceRoleLaneCapture]) -> Unit {
  match capture {
    Some(c) => {
      if c.frame_depth > 0 {
        let index = c.frame_depth - 1
        if c.direct_enabled && (Array::get(c.frame_next_children, index) != Array::get(c.frame_expected_children, index) || !Array::get(c.frame_direct_recorded, index)) {
          c.complete = false
        } else {
          ()
        }
        c.frame_depth = index
      } else {
        c.complete = false
      }
    },
    None => ()
  }
}

/// Account for structural children that checker semantics deliberately do not
/// recurse into (for example a recognized call callee). The next actual
/// recursive child then still receives its `expr_children` index.
fn typed_occurrence_capture_skip_children(capture: Option[TypedOccurrenceRoleLaneCapture], count: Int) -> Unit {
  match capture {
    Some(c) => {
      if c.frame_depth > 0 {
        let parent_index = c.frame_depth - 1
        let next_child = Array::get(c.frame_next_children, parent_index)
        if c.direct_enabled {
          c.complete = false
        } else {
          ()
        }
        Array::set(c.frame_next_children, parent_index, next_child + count)
      } else {
        c.complete = false
      }
    },
    None => ()
  }
}

/// Represent a structural child that checker control flow enters iteratively
/// rather than through `check_expr_capture`. This is needed for the right
/// spine of sequence/let expressions and for specialized call traversal.
fn typed_occurrence_capture_enter_virtual_child(capture: Option[TypedOccurrenceRoleLaneCapture], expected_child: Int, expected_children: Int) -> Unit {
  match capture {
    Some(c) => {
      if c.frame_depth > 0 {
        let parent_index = c.frame_depth - 1
        let actual_child = Array::get(c.frame_next_children, parent_index)
        if actual_child != expected_child {
          c.complete = false
        } else {
          ()
        }
        Array::set(c.frame_next_children, parent_index, actual_child + 1)
        let parent_path = Array::get(c.frame_paths, parent_index)
        let path = Array::slice(parent_path, 0, Array::length(parent_path))
        Array::push(path, actual_child)
        if c.frame_depth < Array::length(c.frame_paths) {
          Array::set(c.frame_paths, c.frame_depth, path)
          Array::set(c.frame_next_children, c.frame_depth, 0)
          Array::set(c.frame_expected_children, c.frame_depth, expected_children)
          Array::set(c.frame_direct_recorded, c.frame_depth, false)
        } else {
          Array::push(c.frame_paths, path)
          Array::push(c.frame_next_children, 0)
          Array::push(c.frame_expected_children, expected_children)
          Array::push(c.frame_direct_recorded, false)
        }
        c.frame_depth = c.frame_depth + 1
      } else {
        c.complete = false
      }
    },
    None => ()
  }
}

/// Restore a virtual traversal stack to its entry depth. Any imbalance is
/// incomplete rather than a fabricated provenance path.
fn typed_occurrence_capture_restore_frame_depth(capture: Option[TypedOccurrenceRoleLaneCapture], expected_depth: Int) -> Unit {
  match capture {
    Some(c) => {
      if c.frame_depth < expected_depth {
        c.complete = false
      } else {
        ()
      }
      while c.frame_depth > expected_depth {
        let index = c.frame_depth - 1
        if c.direct_enabled && (Array::get(c.frame_next_children, index) != Array::get(c.frame_expected_children, index) || !Array::get(c.frame_direct_recorded, index)) {
          c.complete = false
        } else {
          ()
        }
        c.frame_depth = index
      }
      if c.frame_depth != expected_depth {
        c.complete = false
      } else {
        ()
      }
    },
    None => ()
  }
}

fn typed_occurrence_capture_record_direct_return(capture: Option[TypedOccurrenceRoleLaneCapture], ty: Type, lane: String) -> Unit {
  match capture {
    Some(c) => if c.direct_enabled {
      if c.frame_depth <= 0 || lane != "Primary" {
        c.complete = false
      } else {
        let index = c.frame_depth - 1
        if Array::get(c.frame_direct_recorded, index) {
          c.complete = false
        } else {
          let path = Array::get(c.frame_paths, index)
          Array::push(c.direct_entries, (Array::slice(c.statement_path, 0, Array::length(c.statement_path)), Array::slice(path, 0, Array::length(path)), ty))
          Array::set(c.frame_direct_recorded, index, true)
        }
      }
    } else {
      ()
    },
    None => ()
  }
}

fn typed_occurrence_capture_record_virtual_spine_returns(capture: Option[TypedOccurrenceRoleLaneCapture], start_depth: Int, ty: Type, lane: String) -> Unit {
  match capture {
    Some(c) => if c.direct_enabled {
      let mut index = start_depth
      while index < c.frame_depth {
        if lane != "Primary" || Array::get(c.frame_direct_recorded, index) {
          c.complete = false
        } else {
          let path = Array::get(c.frame_paths, index)
          Array::push(c.direct_entries, (Array::slice(c.statement_path, 0, Array::length(c.statement_path)), Array::slice(path, 0, Array::length(path)), ty))
          Array::set(c.frame_direct_recorded, index, true)
        }
        index = index + 1
      }
    } else {
      ()
    },
    None => ()
  }
}

fn typed_occurrence_capture_frame_depth(capture: Option[TypedOccurrenceRoleLaneCapture]) -> Int {
  match capture {
    Some(c) => c.frame_depth,
    None => -1
  }
}

fn append_legacy_typed_occurrence(tytab: Array[(Int, Type)], offset: Int, ty: Type, capture: Option[TypedOccurrenceRoleLaneCapture], role: String, lane: String) -> Unit {
  // Keep this order strict: an observation is meaningful only after its legacy
  // row exists. Negative offsets are filtered by the individual funnels.
  Array::push(tytab, (offset, ty))
  match capture {
    Some(capture_entries) => {
      Array::push(capture_entries.entries, (role, lane))
      if lane == "SyntheticRewrite" || lane == "AuxiliaryResumeValueRecheck" || capture_entries.frame_depth == 0 {
        capture_entries.complete = false
      } else {
        let expression_path = Array::get(capture_entries.frame_paths, capture_entries.frame_depth - 1)
        Array::push(capture_entries.provenance_entries, (Array::slice(capture_entries.statement_path, 0, Array::length(capture_entries.statement_path)), Array::slice(expression_path, 0, Array::length(expression_path)), role, lane, ty))
      }
    },
    None => ()
  }
}

fn tab_identifier_ty(tytab: Array[(Int, Type)], ident_off: Int, ty: Type, capture: Option[TypedOccurrenceRoleLaneCapture], lane: String) -> Unit {
  append_legacy_typed_occurrence(tytab, ident_off, ty, capture, "Identifier", lane)
}

fn tab_call_ty(tytab: Array[(Int, Type)], call_off: Int, ty: Type, capture: Option[TypedOccurrenceRoleLaneCapture], lane: String) -> Type {
  if call_off >= 0 {
    append_legacy_typed_occurrence(tytab, call_off, ty, capture, "CallResult", lane)
  } else {
    ()
  }
  ty
}

fn tab_dot_projection_ty(tytab: Array[(Int, Type)], dot_off: Int, ty: Type, capture: Option[TypedOccurrenceRoleLaneCapture], lane: String) -> Unit {
  append_legacy_typed_occurrence(tytab, dot_off, ty, capture, "DotProjection", lane)
}

fn tab_dot_field_name_ty(tytab: Array[(Int, Type)], field_off: Int, ty: Type, capture: Option[TypedOccurrenceRoleLaneCapture], lane: String) -> Unit {
  append_legacy_typed_occurrence(tytab, field_off, ty, capture, "DotFieldName", lane)
}

/// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`
/// chains) instead of recursing into each `body`, so a long function body — a
/// deep right-nested `let` chain — does not exhaust the wasm call stack during
/// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a
/// forward reference). Semantics are identical to the recursive arms: each `let`
/// binds its (generalized, or raw for `mut`) value type into the env seen by the
/// rest of the spine, and the final non-spine expression's result is returned.
fn check_seq_spine(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], capture: Option[TypedOccurrenceRoleLaneCapture], lane: String, ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int), ce_discarded_root: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> (Type, Subst, Int) {
  let mut cur = expr
  let mut cenv = env
  let mut s1 = s
  let mut c1 = c
  let start_frame_depth = typed_occurrence_capture_frame_depth(capture)
  let mut done = false
  let mut result = (CtUnit, s, c)
  while !done {
    match cur {
      ESeq(left, right) => {
        // Only a DIRECT EForIn at the head of a sequence is statement-shaped.
        // Do not put this context in TypeEnv: an ambient sentinel leaks through
        // if/lambda/block children (and can collide with a user binding), which
        // would let a nested consumed iterator result revive #1679.
        let (_, ns, nc) = match left {
          EForIn(_, _, _, _) => ce_discarded_root(left, cenv, defs, s1, c1, errors, tytab, capture, lane),
          _ => ce(left, cenv, defs, s1, c1, errors, tytab, capture, lane)
        }
        s1 = ns
        c1 = nc
        // The right child is processed by this iterative loop, not by a
        // recursive call. Keep its frame so nested spine values receive the
        // exact `expr_children` prefix.
        typed_occurrence_capture_enter_virtual_child(capture, 1, Array::length(expr_children(right)))
        cur = right
      },
      ELet(name, val, body, _) => {
        let err_before = Array::length(errors)
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab, capture, lane)
        attach_unlocated_decl_name_marker(errors, err_before, name)
        // #938 value restriction: a builder is a MUTABLE container, so its
        // element var must stay un-quantified — generalizing
        // `CtNamed("ArrayBuilder", [v])` would re-instantiate a fresh v at
        // every use and pushes could never constrain each other (the exact
        // hole this issue is about). Bind the monotype instead.
        let vt_resolved = subst_apply(ns, vt)
        let gen = if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {
          vt
        } else {
          generalize(ns, vt)
        }
        let aliases_outer = expression_aliases_outer_binding(val, cenv)
        cenv = env_bind(cenv, name, gen)
        cenv = bind_function_dependency_contracts(cenv, name, val)
        if aliases_outer {
          cenv = env_bind(cenv, String::concat("__region_outer_alias__", name), CtUnit)
        } else {
          ()
        }
        s1 = ns
        c1 = nc
        typed_occurrence_capture_enter_virtual_child(capture, 1, Array::length(expr_children(body)))
        cur = body
      },
      ELetMut(name, val, body, _) => {
        let err_before = Array::length(errors)
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab, capture, lane)
        attach_unlocated_decl_name_marker(errors, err_before, name)
        // `loop` desugars to `let mut __loop_result = 0; while true { ...
        // __loop_result = <break value> ... }` (parser_expr_primary.vibe) —
        // the 0 is only a slot placeholder, but binding its CtInt here pinned
        // every loop's result to Int, so `break((a, b))` / `break(acc)` with a
        // tuple/String errored "assignment type mismatch for __loop_result".
        // Bind the marker to a fresh var instead; the first assignment (break)
        // instantiates it via check_assignable's unify.
        // #1262 / ADR-0100 (1): record the STRICT escape fact alongside the
        // type. `body` is exactly the region where this binding is in scope,
        // so `mut_binding_escapes` answers about THIS binding and not a
        // same-named one outside it. Consumers read it back with
        // `env_mut_escape` (checker_spawnable) instead of re-deriving
        // mutability from the raw AST.
        let escapes = mut_binding_escapes(body, name)
        if name == "__loop_result" {
          let (lr_tv, nc2) = fresh_var(nc)
          cenv = env_bind_mut(cenv, name, lr_tv, escapes)
          c1 = nc2
        } else {
          cenv = env_bind_mut(cenv, name, vt, escapes)
          c1 = nc
        }
        s1 = ns
        typed_occurrence_capture_enter_virtual_child(capture, 1, Array::length(expr_children(body)))
        cur = body
      },
      ELetRec(name, val, body) => {
        let (tv, c1b) = fresh_var(c1)
        let err_before = Array::length(errors)
        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab, capture, lane)
        attach_unlocated_decl_name_marker(errors, err_before, name)
        let s2 = match unify(tv, vt, ns) {
          Some(su) => su,
          None => ns
        }
        let gen = generalize(s2, tv)
        cenv = env_bind(cenv, name, gen)
        cenv = bind_function_dependency_contracts(cenv, name, val)
        s1 = s2
        c1 = nc
        typed_occurrence_capture_enter_virtual_child(capture, 1, Array::length(expr_children(body)))
        cur = body
      },
      _ => {
        // `cur` already owns the active virtual right-child frame. Calling
        // the wrapper here would add a fictional child before checking it.
        result = check_expr_capture_impl(cur, cenv, defs, s1, c1, errors, tytab, capture, lane, false)
        done = true
      }
    }
  }
  typed_occurrence_capture_record_virtual_spine_returns(capture, start_frame_depth, result.0, lane)
  typed_occurrence_capture_restore_frame_depth(capture, start_frame_depth)
  result
}

/// #418: enforce that `obj.field = x` (which desugars to
/// `__set_field(obj, "field", x)`) only targets a `mut`-declared struct field.
/// Runs as a pure side-effect over a *throwaway* errors/tytab so it never
/// perturbs the main type/subst flow — it only type-checks `obj` to learn its
/// struct name, looks up that struct's `mut` field set, and pushes a single
/// diagnostic to the real `errors` when the written field is not `mut`.
fn field_write_mut_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {
  if name == "__set_field" && Array::length(args) == 3 {
    match Array::get(args, 1) {
      EString(field) => {
        let throwaway = array_empty()
        let throwtab = array_empty()
        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
        // #829: also recognise an INSTANTIATED generic struct receiver
        // (`CtNamed(S, targs)`), so `mut`-field enforcement and the written-
        // value type check cover generic structs too.
        let recv_struct = match subst_apply(s, obj_ty) {
          CtStruct(sn) => Some((sn, array_empty())),
          CtNamed(sn, sargs) => Some((sn, sargs)),
          _ => None
        }
        match recv_struct {
          Some(recv_info) => {
            let (sname, recv_targs) = recv_info
            match find_typedef(defs, sname) {
              Some(TDStruct(_, dfields, mut_names, s_tparams)) => {
                let mut found = false
                let mut i = 0
                while i < Array::length(mut_names) {
                  if Array::get(mut_names, i) == field {
                    found = true
                  } else {
                    ()
                  }
                  i = i + 1
                }
                if found {
                  ()
                } else {
                  Array::push(errors, String::concat("cannot assign to non-`mut` field `", String::concat(field, String::concat("` of struct ", sname))))
                }
                // The written value must match the field's declared type
                // (`p.x = "s"` for `x: Int` was accepted). Ground-gated via
                // check_assignable so a generic field type is not over-rejected.
                let mut fty = CtUnknown
                let mut has_field = false
                let mut fi = 0
                while fi < Array::length(dfields) {
                  let (fn2, ft) = Array::get(dfields, fi)
                  if fn2 == field {
                    fty = ft
                    has_field = true
                  } else {
                    ()
                  }
                  fi = fi + 1
                }
                if has_field {
                  let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)
                  // #829: instantiate a generic field's declared type from the
                  // receiver's type args so the written value is checked against
                  // the CONCRETE field type; a non-applied receiver keeps the
                  // raw (rigid) type, which check_assignable tolerates.
                  let inst_fty = inst_struct_field_ty(fty, s_tparams, recv_targs)
                  let _ = check_assignable(subst_apply(s, inst_fty), subst_apply(s, val_ty), s, errors, String::concat("type mismatch writing field `", String::concat(field, "`")), tail_expr_off(Array::get(args, 2)))
                  ()
                } else {
                  ()
                }
              },
              _ => ()
            }
          },
          None => ()
        }
      },
      _ => ()
    }
  } else {
    ()
  }
}

/// Argument positions retained by a mutable operation, encoded as a two-bit
/// mask for positions 1 and 2. This is the single checker-owned inventory for
/// shipped primitives and standard-library mutable wrappers; aliases are listed
/// beside their canonical spelling.
fn retaining_write_argument_mask(source_name: String) -> Int {
  let name = canonical_builtin_name(source_name)
  if name == "Array::push" || name == "ArrayBuilder::push" || name == "Array::push_all" || name == "Array::truncate" || name == "MutList::push" || name == "MutList::truncate" || name == "MutSet::add" || name == "HashSet::add" || name == "MutSortedSet::add" || name == "SortedSet::add" || name == "PriorityQueue::push" || name == "Deque::push_back" || name == "Deque::push_front" {
    1
  } else if name == "Array::set" || name == "FixedArray::set" || name == "FixedArray::unsafe_set" || name == "__set_field" {
    2
  } else if name == "MapBuilder::set" || name == "MutMap::set" || name == "HashMap::set" || name == "MutSortedMap::set" || name == "SortedMap::set" {
    3
  } else {
    0
  }
}

/// Mutable container operations are assignments with a non-syntactic target.
/// Check every stored argument against the same region lifetime rule as
/// `EAssign`; skip the duplicate type walk entirely outside a region.
fn retaining_write_region_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {
  if env_has_active_region(env) && Array::length(args) > 0 {
    let retained = retaining_write_argument_mask(name)
    let mut value_index = 1
    while value_index <= 2 {
      let is_retained = if value_index == 1 {
        retained == 1 || retained == 3
      } else {
        retained == 2 || retained == 3
      }
      if is_retained && value_index < Array::length(args) {
        let throwaway = array_empty()
        let throwtab = array_empty()
        let (val_ty, s1, _) = ce(Array::get(args, value_index), env, defs, s, c, throwaway, throwtab)
        if container_write_crosses_region(Array::get(args, 0), subst_apply(s1, val_ty), env) {
          Array::push(errors, String::concat("region escapes its scope: a container write stores a value that captures this region into an outer binding", off_marker(tail_expr_off(Array::get(args, value_index)))))
        } else {
          ()
        }
      } else {
        ()
      }
      value_index = value_index + 1
    }
  } else {
    ()
  }
}

/// Nominal struct identity intentionally omits field types. Reconstruct only
/// the tail record literal's local let environment so a region-return check can
/// inspect the actual field values without changing the public nominal type.
fn named_record_provenance_key(name: String) -> String {
  String::concat("__region_named_record__", name)
}

/// Bind the structural field types of a nominal record initializer under a
/// checker-private key. Nominal identity remains `CtStruct`; only the region
/// tail check reads this detached provenance view. Bare aliases copy the view.
fn bind_named_record_provenance(name: String, val: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> TypeEnv {
  match val {
    ERecord(record_name, fields, _) => if record_name != "" {
      let field_types = array_empty()
      for field in fields {
        let (field_name, value) = field
        let throwaway = array_empty()
        let throwtab = array_empty()
        let (field_ty, field_s, _) = ce(value, env, defs, s, c, throwaway, throwtab)
        Array::push(field_types, (field_name, subst_apply(field_s, field_ty)))
      }
      env_bind(env, named_record_provenance_key(name), CtRecord(field_types))
    } else {
      env
    },
    EIdent(alias, _) => match env_lookup(env, named_record_provenance_key(alias)) {
      Some(provenance) => env_bind(env, named_record_provenance_key(name), provenance),
      None => env
    },
    _ => env
  }
}

fn named_record_tail_mentions_region(expr: Expr, env: TypeEnv, region_name: String) -> Bool {
  match expr {
    EIdent(name, _) => match env_lookup(env, named_record_provenance_key(name)) {
      Some(provenance) => type_mentions_named(provenance, region_name),
      None => false
    },
    EDot(obj, field, _, _) => match obj {
      EIdent(name, _) => match env_lookup(env, named_record_provenance_key(name)) {
        Some(CtRecord(fields)) => {
          let mut found = false
          for entry in fields {
            let (field_name, field_ty) = entry
            if field_name == field && type_mentions_named(field_ty, region_name) {
              found = true
            } else {
              ()
            }
          }
          found
        },
        _ => false
      },
      _ => false
    },
    _ => false
  }
}

/// Nominal struct identity intentionally omits field types. Preserve a private
/// structural view through local bindings and aliases so whole-value and field
/// tails cannot erase region provenance.

fn tail_returns_binding(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(found, _) => found == name,
    ELet(_, _, body, _) => tail_returns_binding(body, name),
    ELetMut(_, _, body, _) => tail_returns_binding(body, name),
    ELetRec(_, _, body) => tail_returns_binding(body, name),
    ESeq(_, right) => tail_returns_binding(right, name),
    EIf(_, then_expr, else_expr) => tail_returns_binding(then_expr, name) || tail_returns_binding(else_expr, name),
    _ => false
  }
}

fn tail_named_record_mentions_region(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, region_name: String, ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Bool {
  match expr {
    ELet(name, val, body, _) => {
      let throwaway = array_empty()
      let throwtab = array_empty()
      let (val_ty, s1, c1) = ce(val, env, defs, s, c, throwaway, throwtab)
      let next_env = bind_named_record_provenance(name, val, env_bind(env, name, val_ty), defs, s1, c1, ce)
      (tail_returns_binding(body, name) && tail_named_record_mentions_region(val, env, defs, s, c, region_name, ce)) || tail_named_record_mentions_region(body, next_env, defs, s1, c1, region_name, ce)
    },
    ELetMut(name, val, body, _) => {
      let throwaway = array_empty()
      let throwtab = array_empty()
      let (val_ty, s1, c1) = ce(val, env, defs, s, c, throwaway, throwtab)
      let next_env = bind_named_record_provenance(name, val, env_bind_mut(env, name, val_ty, false), defs, s1, c1, ce)
      tail_named_record_mentions_region(body, next_env, defs, s1, c1, region_name, ce)
    },
    ESeq(left, right) => {
      let throwaway = array_empty()
      let throwtab = array_empty()
      let (_, s1, c1) = ce(left, env, defs, s, c, throwaway, throwtab)
      tail_named_record_mentions_region(right, env, defs, s1, c1, region_name, ce)
    },
    ECall(callee, args, _) => {
      let throwaway = array_empty()
      let throwtab = array_empty()
      let (callee_ty, s1, c1) = ce(callee, env, defs, s, c, throwaway, throwtab)
      let mut builtin_constructor_found = false
      match callee {
        EIdent("Some", _) => for arg in args {
          if tail_named_record_mentions_region(arg, env, defs, s1, c1, region_name, ce) {
            builtin_constructor_found = true
          }
        },
        _ => ()
      }
      match subst_apply(s1, callee_ty) {
        CtFn(param_tys, ret_ty, callee_effect) => {
          let resolved_ret = subst_apply(s1, ret_ty)
          let mut found = false
          let limit = min_int(Array::length(param_tys), Array::length(args))
          let mut i = 0
          while i < limit {
            let markers = array_empty()
            collect_internal_provenance(Array::get(param_tys, i), markers)
            let mut depends = false
            for marker_label in markers {
              match param_marker_index(marker_label) {
                Some(marker) => if type_has_param_marker(resolved_ret, marker) {
                  depends = true
                } else {
                  ()
                },
                None => ()
              }
            }
            if depends && tail_named_record_mentions_region(Array::get(args, i), env, defs, s1, c1, region_name, ce) {
              found = true
            }
            i = i + 1
          }
          match callee_effect {
            Some(row) => if String::contains(row, "#aliasparam[") {
              for raw in String::split(row, ",") {
                let label = String::trim(raw)
                if String::starts_with(label, "#aliasparam[") {
                  let close = String::index_of(label, "]")
                  let mut index = 0
                  let mut p = 12
                  while p < close {
                    index = index * 10 + (String::char_code_at(label, p) - 48)
                    p = p + 1
                  }
                  if index >= 0 && index < Array::length(args) && tail_named_record_mentions_region(Array::get(args, index), env, defs, s1, c1, region_name, ce) {
                    found = true
                  }
                }
              }
            } else {
              ()
            },
            None => ()
          }
          match callee_effect {
            Some(row) => for raw in String::split(row, ",") {
              let label = String::trim(raw)
              if String::starts_with(label, "#fieldparam[") {
                let close = String::index_of(label, "]")
                let mut index = 0
                let mut p = 12
                while p < close {
                  index = index * 10 + (String::char_code_at(label, p) - 48)
                  p = p + 1
                }
                if index >= 0 && index < Array::length(args) && tail_named_record_mentions_region(Array::get(args, index), env, defs, s1, c1, region_name, ce) {
                  found = true
                }
              }
            },
            None => ()
          }
          match callee {
            EIdent(callee_name, _) => match env_lookup(env, String::concat("__field_contract__", callee_name)) {
              Some(CtNamed(index_text, _)) => {
                let index = decimal_index(index_text)
                if index >= 0 && index < Array::length(args) && tail_named_record_mentions_region(Array::get(args, index), env, defs, s1, c1, region_name, ce) {
                  found = true
                }
              },
              _ => ()
            },
            _ => ()
          }
          found || builtin_constructor_found
        },
        _ => builtin_constructor_found
      }
    },
    ERecord(name, fields, _) => if name != "" {
      let mut found = false
      let mut s1 = s
      let mut c1 = c
      for field in fields {
        let (_, value) = field
        let throwaway = array_empty()
        let throwtab = array_empty()
        let (field_ty, next_s, next_c) = ce(value, env, defs, s1, c1, throwaway, throwtab)
        if type_mentions_named(subst_apply(next_s, field_ty), region_name) {
          found = true
        } else {
          ()
        }
        s1 = next_s
        c1 = next_c
      }
      found
    } else {
      false
    },
    EArray(items) => {
      let mut found = false
      for item in items {
        if tail_named_record_mentions_region(item, env, defs, s, c, region_name, ce) {
          found = true
        }
      }
      found
    },
    ETuple(items) => {
      let mut found = false
      for item in items {
        if tail_named_record_mentions_region(item, env, defs, s, c, region_name, ce) {
          found = true
        }
      }
      found
    },
    _ => {
      let throwaway = array_empty()
      let throwtab = array_empty()
      let (expr_ty, next_s, _) = ce(expr, env, defs, s, c, throwaway, throwtab)
      named_record_tail_mentions_region(expr, env, region_name) || type_mentions_named(subst_apply(next_s, expr_ty), region_name)
    }
  }
}

fn expression_mentions_active_region_scan(expr: Expr, cur: TypeEnv, full: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Bool {
  match cur {
    EnvEmpty => false,
    EnvBind(name, binding, rest) => if name == "__active_region__" {
      match binding.ty {
        CtNamed(region_name, _) => tail_named_record_mentions_region(expr, full, defs, s, c, region_name, ce) || expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
        _ => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce)
      }
    } else {
      expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce)
    },
    EnvMutCell(_, _, rest) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvTraitDef(_, _, _, _, rest, _, _) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvTraitImpl(_, _, rest) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvTraitImplGen(_, _, _, _, rest) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvTypeDefs(_, _, rest) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvCached(_, _, rest) => expression_mentions_active_region_scan(expr, rest, full, defs, s, c, ce),
    EnvFlat(_) => false
  }
}

fn expression_mentions_active_region(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Bool {
  expression_mentions_active_region_scan(expr, env, env, defs, s, c, ce)
}

/// `obj[i]` desugars to `__index(obj, i)`, typed fully polymorphically, so
/// indexing a non-indexable scalar (`let n = 5; n[0]`) was accepted silently.
/// Report when `obj` resolves to a concrete scalar that cannot be indexed
/// (Array/String/Bytes ARE indexable; type vars / unknown / named stay
/// tolerated). Pure side-effect over a throwaway error/type table.
fn index_target_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {
  if name == "__index" && Array::length(args) == 2 {
    let throwaway = array_empty()
    let throwtab = array_empty()
    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
    let resolved_obj = subst_apply(s, obj_ty)
    let not_indexable = match resolved_obj {
      CtInt => true,
      CtDouble => true,
      CtBool => true,
      CtChar => true,
      CtUnit => true,
      _ => false
    }
    if not_indexable {
      Array::push(errors, "cannot index a non-indexable value (expected Array, String, or Bytes)")
    } else {
      // For an indexable receiver (Array/String/Bytes), the subscript must be an
      // Int — `a["x"]` was accepted silently. Only flag a concrete non-Int index;
      // type vars / unknown / named stay tolerated.
      let indexable = match resolved_obj {
        CtArray(_) => true,
        CtString => true,
        CtBytes => true,
        _ => false
      }
      if indexable {
        let throwaway2 = array_empty()
        let throwtab2 = array_empty()
        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)
        let bad_index = match subst_apply(s, idx_ty) {
          CtInt => false,
          _ => type_is_ground(subst_apply(s, idx_ty))
        }
        if bad_index {
          Array::push(errors, "index must be an Int")
        } else {
          ()
        }
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

/// An arm pattern is a CATCH-ALL (makes a match exhaustive regardless of which
/// constructors precede it) when it is a wildcard or a bare binding. `POr` is a
/// catch-all if either side is.
fn pat_is_catchall(pat: Pat) -> Bool {
  match pat {
    PWild => true,
    PBind(_) => true,
    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),
    _ => false
  }
}

/// Collect the constructor names a pattern matches at the TOP level (for enum
/// exhaustiveness). `POr` contributes from both sides; other patterns none.
/// #940 Phase 1: Bool-literal coverage names (`"true"` / `"false"`) for the
/// flat Bool exhaustiveness check, walking or-patterns like
/// collect_ctor_names_into does for ctor names.
fn collect_bool_pats_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBool(b) => if b {
      Array::push(acc, "true")
    } else {
      Array::push(acc, "false")
    },
    POr(l, r) => {
      collect_bool_pats_into(l, acc)
      collect_bool_pats_into(r, acc)
    },
    _ => ()
  }
}

fn flat_names_contain(names: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if Array::get(names, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn collect_ctor_names_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PCtor(name, _) => Array::push(acc, name),
    POr(l, r) => {
      collect_ctor_names_into(l, acc)
      collect_ctor_names_into(r, acc)
    },
    _ => ()
  }
}

/// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit
/// index string. Returns None for a non-numeric field (a real `.method`/.field)
/// so only genuine tuple projections are bounds-checked.
fn parse_tuple_index(s: String) -> Option[Int] {
  let len = String::length(s)
  if len == 0 {
    None
  } else {
    let mut i = 0
    let mut val = 0
    let mut ok = true
    while i < len {
      let cc = String::char_code_at(s, i)
      if cc >= 48 && cc <= 57 {
        val = val * 10 + (cc - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(val)
    } else {
      None
    }
  }
}

/// #813: bind a pattern's binders to CtUnknown for the resume-value walk —
/// the walker re-checks resume arguments outside the main inference flow, so
/// locally-bound names (match arms, lets) must be in scope or a legitimate
/// `Read() => { let v = ...; resume(v) }` reports a false `unknown name: v`.
/// CtUnknown keeps the value check ground-gated (tolerant) for such names.
fn resume_walk_bind_pat(p: Pat, env: TypeEnv) -> TypeEnv {
  match p {
    PBind(n) => env_bind(env, n, CtUnknown),
    PCtor(_, ps) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(ps) {
        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)
        pi = pi + 1
      }
      env1
    },
    PTuple(ps) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(ps) {
        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)
        pi = pi + 1
      }
      env1
    },
    POr(a, b) => resume_walk_bind_pat(b, resume_walk_bind_pat(a, env)),
    PStruct(_, fields) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(fields) {
        let (_, fp) = Array::get(fields, pi)
        env1 = resume_walk_bind_pat(fp, env1)
        pi = pi + 1
      }
      env1
    },
    _ => env
  }
}

/// #813: walk a handler arm body for `resume(x)` calls and check x against the
/// op's declared return type (ground-gated via check_assignable). Nested
/// EHandle subtrees are skipped entirely — their resumes belong to the inner
/// handler's own arms. Runs on a throwaway lane after the arm body was checked,
/// so it only ADDS diagnostics (main inference flow untouched). Local binders
/// (let / let mut / let rec / match arms / for-in vars) are bound to CtUnknown
/// while descending so resume(local) doesn't report a false `unknown name`.
/// #640: walk a `with Exception` handler arm body and reject any `resume(...)`
/// call. `Error` is non-resumable — `throw` / `perform Exception::Throw` unwind
/// the stack for good (no perform-counter/memo replay machinery runs for tag
/// 2), so a resume in an Error arm never resumed anything; it was silently
/// meaningless. Nested EHandle subtrees are skipped (their resumes belong to
/// the inner handler's own arms, which may be resumable effects).
fn reject_resume_in_error_arm(e: Expr, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" {
          Array::push(errors, String::concat("Exception is a non-resumable effect (#640); an Exception arm's value IS the handle result — remove resume(...)", off_marker(off)))
        } else {
          ()
        },
        _ => reject_resume_in_error_arm(callee, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        reject_resume_in_error_arm(Array::get(args, ri), errors)
        ri = ri + 1
      }
    },
    EHandle(_, _) => (),
    ELet(_, v, b, _) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ELetMut(_, v, b, _) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ELetRec(_, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ESeq(a, b) => {
      reject_resume_in_error_arm(a, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EIf(cnd, t, el) => {
      reject_resume_in_error_arm(cnd, errors)
      reject_resume_in_error_arm(t, errors)
      reject_resume_in_error_arm(el, errors)
    },
    EMatch(scr, marms) => {
      reject_resume_in_error_arm(scr, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (_, mb) = Array::get(marms, mi)
        reject_resume_in_error_arm(mb, errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      reject_resume_in_error_arm(cnd, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EForIn(_, _, it, b) => {
      reject_resume_in_error_arm(it, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EBinOp(_, l, r) => {
      reject_resume_in_error_arm(l, errors)
      reject_resume_in_error_arm(r, errors)
    },
    EUnaryOp(_, inner) => reject_resume_in_error_arm(inner, errors),
    EAssign(_, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EAssignOp(_, _, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EFn(_, _, _, _, _, fb) => reject_resume_in_error_arm(fb, errors),
    EReturn(inner) => reject_resume_in_error_arm(inner, errors),
    EDot(obj, _, _, _) => reject_resume_in_error_arm(obj, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    // Codex P2 on #933: the catch-all silently ended the walk for these
    // recursive forms, so e.g. `Throw(_) => loop { break resume(0) }` or a
    // resume tucked into a record/map literal escaped the non-resumable
    // rejection and reached codegen's meaningless tag-1 path.
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        reject_resume_in_error_arm(fe, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      while ti < Array::length(binds) {
        let (_, be) = Array::get(binds, ti)
        reject_resume_in_error_arm(be, errors)
        ti = ti + 1
      }
      reject_resume_in_error_arm(b, errors)
    },
    ELabeledArg(_, _, inner) => reject_resume_in_error_arm(inner, errors),
    EBreak(opt) => match opt {
      Some(inner) => reject_resume_in_error_arm(inner, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        reject_resume_in_error_arm(pe, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => reject_resume_in_error_arm(inner, errors),
    _ => ()
  }
}

/// #942 (ADR-0050): is this handler-arm pattern an `Error` arm? Error arms are
/// owned by reject_resume_in_error_arm (#640), so the general resume-misuse
/// walks below leave them alone (no double report).
fn handler_arm_pat_is_error(p: Pat) -> Bool {
  match p {
    PCtor(q, _) => {
      is_exception_throw_handler_name(q)
    },
    _ => false
  }
}

/// #942 (Codex P2 on #969): does this pattern bind the name `resume`? Codegen's
/// prefer_bound_call (codegen/expr/compile_call.vibe) sends `resume(x)` to the
/// BOUND function whenever any top-level fn / local binding / binder named
/// `resume` is in scope — such calls never touch the continuation machinery,
/// so the #942 misuse walks must skip them (they ran fine pre-#942).
export fn pat_binds_resume(p: Pat) -> Bool {
  match p {
    PBind(n) => n == "resume",
    PCtor(_, ps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ps) {
        if pat_binds_resume(Array::get(ps, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PTuple(ps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ps) {
        if pat_binds_resume(Array::get(ps, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    POr(a, b) => pat_binds_resume(a) || pat_binds_resume(b),
    PStruct(_, fps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fps) {
        let (_, fp) = Array::get(fps, i)
        if pat_binds_resume(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #942 (Codex P2): does an EFn's parameter list bind `resume`? Labeled/
/// optional params keep a trailing `~`/`?` in the raw AST name (stripped by
/// the checker/codegen before binding, same as the labeled-param handling in
/// check_expr's EFn arm above) — strip it here too so `fn f(resume~: ...)`
/// is recognized as shadowing.
fn param_base_name(raw_name: String) -> String {
  let nlen = String::length(raw_name)
  if nlen > 0 {
    let lc = String::char_code_at(raw_name, nlen - 1)
    if lc == '~' || lc == '?' {
      raw_name[0: nlen - 1]
    } else raw_name
  } else raw_name
}

fn fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if param_base_name(pn) == "resume" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #942 (ADR-0050): inside a handler arm, `resume(...)` is one-shot and must be
/// the LAST thing the arm does. Codegen compiles resume as a continuation
/// throw, so any code after it silently never runs — `let a = resume(1);
/// resume(2)` returned the first resume's flow and dropped the second on the
/// floor. Reject non-tail resume calls, mirroring the #814 rejection of the
/// k-convention non-tail continuation binder. Tail position distributes
/// through let/seq continuations and if/match branches (only one branch runs),
/// so `if c { resume(1) } else { resume(2) }` and multi-statement arms ending
/// in resume stay legal. `return resume(v)` inherits the tail flag (Codex P2
/// on #969 — return exits before anything else runs; pre-#942 it behaved
/// exactly like a plain tail resume at runtime). Loop bodies are never tail
/// (a resume there would run per iteration). EFn subtrees are skipped
/// wholesale — a resume inside a nested lambda keeps its pre-#942 acceptance.
/// A nested EHandle's handled body inherits the current tail flag (its value
/// IS the handle's value, and a lexical resume there still targets THIS arm's
/// continuation); its non-Error arms restart a fresh tail walk of their own.
/// `sh` = `resume` is shadowed by an enclosing binder (top-level fn/let,
/// local let/let-mut/let-rec, match/for/loop binders, arm payload binders):
/// codegen's prefer_bound_call routes such calls to the bound function, so
/// the tail discipline does not apply to them (Codex P2 on #969).
fn check_arm_resume_tail(e: Expr, tail: Bool, sh: Bool, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" && !tail && !sh {
          Array::push(errors, String::concat("resume(...) must be the last expression of the handler arm (tail position) — code after a resume never runs, so a bound or repeated resume is silently dropped (#942, ADR-0050)", off_marker(off)))
        } else {
          ()
        },
        _ => check_arm_resume_tail(callee, false, sh, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        check_arm_resume_tail(Array::get(args, ri), false, sh, errors)
        ri = ri + 1
      }
    },
    EHandle(body, harms) => {
      check_arm_resume_tail(body, tail, sh, errors)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (hpat, hbody) = Array::get(harms, hi)
        if handler_arm_pat_is_error(hpat) {
          ()
        } else {
          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)
        }
        hi = hi + 1
      }
    },
    ELet(ln, v, b, _) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ELetMut(ln, v, b, _) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ELetRec(ln, v, b) => {
      check_arm_resume_tail(v, false, sh || ln == "resume", errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ESeq(a, b) => {
      check_arm_resume_tail(a, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EIf(cnd, t, el) => {
      check_arm_resume_tail(cnd, false, sh, errors)
      check_arm_resume_tail(t, tail, sh, errors)
      check_arm_resume_tail(el, tail, sh, errors)
    },
    EMatch(scr, marms) => {
      check_arm_resume_tail(scr, false, sh, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        check_arm_resume_tail(mb, tail, sh || pat_binds_resume(mp), errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      check_arm_resume_tail(cnd, false, sh, errors)
      check_arm_resume_tail(b, false, sh, errors)
    },
    EForIn(v1, v2, it, b) => {
      check_arm_resume_tail(it, false, sh, errors)
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      check_arm_resume_tail(b, false, sh || for_sh, errors)
    },
    EBinOp(_, l, r) => {
      check_arm_resume_tail(l, false, sh, errors)
      check_arm_resume_tail(r, false, sh, errors)
    },
    EUnaryOp(_, inner) => check_arm_resume_tail(inner, false, sh, errors),
    EAssign(_, v, b) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EAssignOp(_, _, v, b) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EFn(_, _, _, _, _, _) => (),
    EReturn(inner) => check_arm_resume_tail(inner, tail, sh, errors),
    EDot(obj, _, _, _) => check_arm_resume_tail(obj, false, sh, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        check_arm_resume_tail(fe, false, sh, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      let mut loop_sh = false
      while ti < Array::length(binds) {
        let (bn, be) = Array::get(binds, ti)
        if bn == "resume" {
          loop_sh = true
        } else {
          ()
        }
        check_arm_resume_tail(be, false, sh, errors)
        ti = ti + 1
      }
      check_arm_resume_tail(b, false, sh || loop_sh, errors)
    },
    ELabeledArg(_, _, inner) => check_arm_resume_tail(inner, false, sh, errors),
    EBreak(opt) => match opt {
      Some(inner) => check_arm_resume_tail(inner, false, sh, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        check_arm_resume_tail(pe, false, sh, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => check_arm_resume_tail(inner, false, sh, errors),
    _ => ()
  }
}

/// #942 (ADR-0050): a call-position `resume(...)` OUTSIDE any handler arm has
/// no continuation to resume. Codegen emits the tag-1 continuation throw
/// unconditionally (see codegen/common_analysis — the module must stay valid),
/// so `fn f() -> Int { resume(1); 2 }` compiled and then died at runtime with
/// an unhandled wasm exception. Walk every top-level statement expression and
/// reject it in the checker instead. Only CALLS are rejected — `resume` as an
/// ordinary binding name (e.g. lib/@vibe/parser/lexer.vibe's `let resume =
/// ...`, which is passed around but never called) stays legal. On reaching an
/// EHandle, the handled body is still "outside" (a resume there is not in any
/// arm); non-Error arm bodies switch to the check_arm_resume_tail walk above,
/// and Error arms are left to reject_resume_in_error_arm (#640).
/// `sh` = `resume` is shadowed by an enclosing binder (Codex P2 on #969):
/// codegen's prefer_bound_call routes `resume(x)` to the BOUND function
/// whenever a top-level fn/let named resume, a local binding, a lambda param,
/// or a match/for/loop binder named resume is in scope — such calls ran fine
/// pre-#942 and must stay accepted. check_stmts seeds `sh` from the top-level
/// declarations (fn resume / let resume / extern / imports).
export fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" && !sh {
          Array::push(errors, String::concat("resume(...) is only valid inside a handler arm of `handle ... with` — outside one there is no continuation to resume (#942, ADR-0050)", off_marker(off)))
        } else {
          ()
        },
        _ => reject_resume_outside_handler(callee, sh, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        reject_resume_outside_handler(Array::get(args, ri), sh, errors)
        ri = ri + 1
      }
    },
    EHandle(body, harms) => {
      reject_resume_outside_handler(body, sh, errors)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (hpat, hbody) = Array::get(harms, hi)
        if handler_arm_pat_is_error(hpat) {
          ()
        } else {
          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)
        }
        hi = hi + 1
      }
    },
    ELet(ln, v, b, _) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ELetMut(ln, v, b, _) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ELetRec(ln, v, b) => {
      reject_resume_outside_handler(v, sh || ln == "resume", errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ESeq(a, b) => {
      reject_resume_outside_handler(a, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EIf(cnd, t, el) => {
      reject_resume_outside_handler(cnd, sh, errors)
      reject_resume_outside_handler(t, sh, errors)
      reject_resume_outside_handler(el, sh, errors)
    },
    EMatch(scr, marms) => {
      reject_resume_outside_handler(scr, sh, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        reject_resume_outside_handler(mb, sh || pat_binds_resume(mp), errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      reject_resume_outside_handler(cnd, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EForIn(v1, v2, it, b) => {
      reject_resume_outside_handler(it, sh, errors)
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      reject_resume_outside_handler(b, sh || for_sh, errors)
    },
    EBinOp(_, l, r) => {
      reject_resume_outside_handler(l, sh, errors)
      reject_resume_outside_handler(r, sh, errors)
    },
    EUnaryOp(_, inner) => reject_resume_outside_handler(inner, sh, errors),
    EAssign(_, v, b) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EAssignOp(_, _, v, b) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EFn(_, _, fparams, _, _, fb) => reject_resume_outside_handler(fb, sh || fn_params_bind_resume(fparams), errors),
    EReturn(inner) => reject_resume_outside_handler(inner, sh, errors),
    EDot(obj, _, _, _) => reject_resume_outside_handler(obj, sh, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        reject_resume_outside_handler(fe, sh, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      let mut loop_sh = false
      while ti < Array::length(binds) {
        let (bn, be) = Array::get(binds, ti)
        if bn == "resume" {
          loop_sh = true
        } else {
          ()
        }
        reject_resume_outside_handler(be, sh, errors)
        ti = ti + 1
      }
      reject_resume_outside_handler(b, sh || loop_sh, errors)
    },
    ELabeledArg(_, _, inner) => reject_resume_outside_handler(inner, sh, errors),
    EBreak(opt) => match opt {
      Some(inner) => reject_resume_outside_handler(inner, sh, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        reject_resume_outside_handler(pe, sh, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => reject_resume_outside_handler(inner, sh, errors),
    _ => ()
  }
}

fn check_resume_values(e: Expr, ret_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], capture: Option[TypedOccurrenceRoleLaneCapture]) -> Subst {
  match e {
    ECall(callee, args, _) => {
      let mut s1 = s
      // #942 (Codex P2 on #970): `env` is the normal lexical TypeEnv threaded
      // through check_expr, already containing every enclosing binder (the
      // top-level fn/let hoist, the arm's own payload binders via henv, and
      // any local let/let-mut/let-rec/match-arm binder this walk itself adds
      // below) — so a `resume` name already bound here is a real callable
      // binding codegen's prefer_bound_call routes to, not the builtin.
      let resume_shadowed = env_lookup(env, "resume") is Some(_)
      match callee {
        EIdent(nm, _) => {
          // A Unit-returning op discards the resumed value at the perform
          // site, so any resume argument is tolerated there (mirrors the
          // statement-position Unit tolerance elsewhere; the existing idiom
          // `Print(s) => resume(0)` for `Print(String) -> Unit` stays legal).
          if nm == "resume" && !resume_shadowed && Array::length(args) == 1 && !(ret_ty is CtUnit) {
            let (aty, ns, _) = check_expr_capture(Array::get(args, 0), env, defs, s1, c, errors, tytab, capture, "AuxiliaryResumeValueRecheck")
            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, "resume value type mismatch", tail_expr_off(Array::get(args, 0)))
          } else if nm == "resume" && !resume_shadowed && Array::length(args) == 0 && !(ret_ty is CtUnit) {
            // #828: `resume()` on a value-returning op used to reach codegen,
            // which indexes resume args[0] unconditionally — a compiler ICE
            // with no diagnostic. Reject it here instead.
            Array::push(errors, "resume expects a value (the operation returns a non-Unit type); resume() with no argument is only valid for Unit-returning operations")
          } else {
            ()
          }
        },
        _ => {
          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab, capture)
        }
      }
      let mut ri = 0
      while ri < Array::length(args) {
        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab, capture)
        ri = ri + 1
      }
      s1
    },
    EHandle(_, _) => s,
    ELet(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    ELetMut(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    ELetRec(ln, v, b) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env_bind(env, ln, CtUnknown), defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture), c, errors, tytab, capture),
    EMatch(scr, marms) => {
      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab, capture)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        s1 = check_resume_values(mb, ret_ty, resume_walk_bind_pat(mp, env), defs, s1, c, errors, tytab, capture)
        mi = mi + 1
      }
      s1
    },
    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    EForIn(fname, fidx, it, b) => {
      let fenv = match fidx {
        Some(fi) => env_bind(env_bind(env, fname, CtUnknown), fi, CtUnknown),
        None => env_bind(env, fname, CtUnknown)
      }
      check_resume_values(b, ret_ty, fenv, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture)
    },
    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab, capture),
    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab, capture), c, errors, tytab, capture),
    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab, capture),
    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab, capture),
    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab, capture),
    ETuple(items) => {
      let mut s1 = s
      let mut ti = 0
      while ti < Array::length(items) {
        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab, capture)
        ti = ti + 1
      }
      s1
    },
    EArray(items) => {
      let mut s1 = s
      let mut ti = 0
      while ti < Array::length(items) {
        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab, capture)
        ti = ti + 1
      }
      s1
    },
    _ => s
  }
}

fn check_expr_capture_impl(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], capture: Option[TypedOccurrenceRoleLaneCapture], lane: String, discarded_root: Bool) -> (Type, Subst, Int) {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name, ident_off) => match env_lookup(env, railway_ident_lookup_name(name)) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if Array::length(bounds) != 0 {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        // Record this user identifier's inferred (raw, pre-final-subst) type
        // keyed by its real source offset, for typed-hover (vibe type-at) on
        // locals and parameters. Synthetic idents (off < 0) are skipped.
        if ident_off >= 0 {
          tab_identifier_ty(tytab, ident_off, ti, capture, lane)
        } else {
          ()
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(railway_ident_lookup_name(name)) {
        Some(t) => {
          if ident_off >= 0 {
            tab_identifier_ty(tytab, ident_off, t, capture, lane)
          } else {
            ()
          }
          (t, s, c)
        },
        None => match resolve_trait_method_ident(name, env, defs, s) {
          Some(mty) => {
            if ident_off >= 0 {
              tab_identifier_ty(tytab, ident_off, mty, capture, lane)
            } else {
              ()
            }
            (mty, s, c)
          },
          None => match resolve_qualified_ctor_ident(name, env, defs, c) {
            Some(ct) => {
              let (ti, c1, new_bounds) = instantiate(ct, c)
              let nblen = Array::length(new_bounds)
              let mut s1 = s
              let mut bi = 0
              while bi < nblen {
                let (vid, bounds) = Array::get(new_bounds, bi)
                if Array::length(bounds) != 0 {
                  s1 = subst_add_bound(s1, vid, bounds)
                } else {
                  ()
                }
                bi = bi + 1
              }
              if ident_off >= 0 {
                tab_identifier_ty(tytab, ident_off, ti, capture, lane)
              } else {
                ()
              }
              (ti, s1, c1)
            },
            None => {
              if name == "__try_v" {
                Array::push(errors, String::concat("`?` could not unwrap this value (the lowered binder is not in scope)", off_marker(ident_off)))
              } else if name == "_" {
                // #2201: `_` is syntax the reader used in the wrong position,
                // not a name they thought existed -- "unknown name: _" answers
                // the wrong question. Name its two expression roles instead.
                Array::push(errors, String::concat("`_` is not a value here: it is only a pipe slot (in the call directly after `|>`) or a lambda section (as part of a larger expression, e.g. `_ * 2`)", off_marker_len(ident_off, 1)))
              } else {
                Array::push(errors, String::concat(String::concat("unknown name: ", name), off_marker_len(ident_off, String::length(name))))
              }
              (CtUnknown, s, c)
            }
          }
        }
      }
    },
    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, capture, lane, check_expr_capture, check_expr_capture_discarded_root),
    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, capture, lane, check_expr_capture, check_expr_capture_discarded_root),
    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, capture, lane, check_expr_capture, check_expr_capture_discarded_root),
    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, capture, lane, check_expr_capture, check_expr_capture_discarded_root),
    EIf(cond, then_e, else_e) => {
      let (ct, s1, c1) = check_expr_capture(cond, env, defs, s, c, errors, tytab, capture, lane)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        // Anchor on the CONDITION, not the `if`: that is the expression whose
        // type is wrong, and it is what the reader has to change (#1941).
        // Naming the actual type is the other half of the repair (#2200): for
        // `flag?: Bool` the condition is Option[Bool], and without "got ..."
        // the message reads as agreeing with the reader who believes flag IS
        // a Bool.
        _ => Array::push(errors, String::concat("if condition must be Bool, got ", String::concat(type_to_string(resolved_ct), off_marker(railway_expr_off(cond)))))
      }
      let (tt, s2, c2) = check_expr_capture(then_e, env, defs, s1, c1, errors, tytab, capture, lane)
      let (et, s3, c3) = check_expr_capture(else_e, env, defs, s2, c2, errors, tytab, capture, lane)
      // The two branches must agree when both yield a real value (previously
      // unchecked — `if c { 1 } else { "x" }` was accepted). A `CtUnit` branch
      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is
      // discarded, and a statement-position `if` need not have matching arms.
      let rtt = subst_apply(s3, tt)
      let ret = subst_apply(s3, et)
      // When one branch yields Unit (an else-less `if`, whose missing else is
      // `()`, or an explicit `()` branch), the branches need not agree and the
      // expression yields Unit as a VALUE — so `let x: Int = if c { 1 }` is
      // rejected (it returns Unit when c is false) while a statement-position
      // `if` is harmless (its value is discarded). Only when BOTH branches yield
      // a real (non-Unit) value must they agree, and the result is that type.
      let (s3b, if_ty) = match rtt {
        CtUnit => (s3, CtUnit),
        _ => match ret {
          CtUnit => (s3, CtUnit),
          _ => {
            // #2198: a literal else-branch carries no offset, which left this
            // diagnostic file-only. Keep the else anchor when it exists (pinned
            // by diagnostic_anchor_test), else fall back to the then-branch
            // tail, else to the condition -- coarser, but still on the `if`.
            let else_off = railway_expr_off(else_e)
            let branch_off = if else_off >= 0 {
              else_off
            } else {
              let then_off = tail_expr_off(then_e)
              if then_off >= 0 {
                then_off
              } else {
                railway_expr_off(cond)
              }
            }
            (check_assignable(rtt, ret, s3, errors, "if branches have incompatible types", branch_off), tt)
          }
        }
      }
      (if_ty, s3b, c3)
    },
    ECall(callee, args, call_off) => match callee {
      // `perform EffName::Op(opargs)` parses as ECall(EIdent("perform"),
      // [ECall(EIdent("EffName::Op"), opargs)]). The op name may be a builtin
      // effect (Stdin/Stdout/...) not registered in the checker env, so check
      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.
      // `resume(v)` likewise yields the continuation result (a fresh var;
      // handler arms are otherwise unchecked).
      EIdent(name, callee_off) => {
        // The recognized-callee path types arguments directly, but its callee
        // remains structural child 0 under core::expr_children.
        typed_occurrence_capture_skip_children(capture, 1)
        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)
        retaining_write_region_check(name, args, env, defs, s, c, errors, check_expr)
        index_target_check(name, args, env, defs, s, c, errors, check_expr)
        if name == "perform" || name == "perform?" {
          let (pty, ps, pc) = if Array::length(args) == 1 {
            match Array::get(args, 0) {
              ECall(op_callee, opargs, _) => {
                // #640 Stage 2: `throw(x)` parses to this exact shape
                // (perform Exception::Throw(x)), and that carve-out preserved
                // EThrow's historical typing verbatim: CtUnknown as the value
                // AND no look at the payload at all.
                //
                // #1464: only the FIRST half is still wanted. Skipping the
                // payload meant every type error inside a `throw(...)` was
                // invisible -- measured, all of these compiled:
                //
                //   suberror AppError(String)
                //   throw(AppError("boom", 1))   arity
                //   throw(AppError(1))           payload type
                //   throw(f("x", 1))             any call, at any depth
                //
                // while the same expressions OUTSIDE a throw were rejected,
                // and `perform Log::Emit(f("x", 1))` (a user effect) was
                // rejected too. So this was `Exception::Throw` alone, not `perform`
                // and not CtUnknown-parameter builtins.
                //
                // The payload is now checked; the RESULT stays CtUnknown, which
                // is the half the carve-out was really protecting -- `throw`
                // sits in any expression position, so yielding a fresh var
                // would change typing at all ~970 throw sites. Nothing is
                // unified against a declared signature: `Exception` is core
                // ambient and has no TDEffect, so the payload is checked on its
                // own terms and no further.
                let is_error_throw = match op_callee {
                  EIdent(op_qname0, _) => is_exception_throw_operation(op_qname0),
                  _ => false
                }
                if is_error_throw {
                  let throw_parent_depth = typed_occurrence_capture_frame_depth(capture)
                  typed_occurrence_capture_enter_virtual_child(capture, 1, 1 + Array::length(opargs))
                  typed_occurrence_capture_skip_children(capture, 1)
                  let mut ts = s
                  let mut tc = c
                  let mut ti = 0
                  while ti < Array::length(opargs) {
                    let (_, ns, nc) = check_expr_capture(Array::get(opargs, ti), env, defs, ts, tc, errors, tytab, capture, lane)
                    ts = ns
                    tc = nc
                    ti = ti + 1
                  }
                  typed_occurrence_capture_restore_frame_depth(capture, throw_parent_depth)
                  (CtUnknown, ts, tc)
                } else {
                  // The op call is perform's outer argument (child 1), and
                  // its callee is its own child 0. We check only op arguments,
                  // so retain both skipped structural frames explicitly.
                  let virtual_parent_depth = typed_occurrence_capture_frame_depth(capture)
                  typed_occurrence_capture_enter_virtual_child(capture, 1, 1 + Array::length(opargs))
                  typed_occurrence_capture_skip_children(capture, 1)
                  let oalen = Array::length(opargs)
                  let mut s1 = s
                  let mut c1 = c
                  let oparg_tys = array_empty()
                  let mut ai = 0
                  while ai < oalen {
                    let (oat, ns, nc) = check_expr_capture(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab, capture, lane)
                    Array::push(oparg_tys, oat)
                    s1 = ns
                    c1 = nc
                    ai = ai + 1
                  }
                  // #813: when the op belongs to a DECLARED effect, validate the
                  // perform against its signature — arity and (ground-gated)
                  // argument types were previously unchecked, so
                  // `perform R::Take("str")` against `Take(Int)` compiled and
                  // produced garbage. Builtin/imported effects (no TDEffect) skip.
                  let perform_result = match op_callee {
                    EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {
                      Some(sig) => {
                        let (sig_params_decl, sig_ret_decl) = sig
                        // #1340 (ADR-0071): a GENERIC effect's signature
                        // mentions its declared type params as rigid CtNamed
                        // names — instantiate them with fresh inference vars
                        // per perform site, so arity AND argument types are
                        // genuinely checked (`perform State::Get(1,2,3)`
                        // against a 0-arity op used to pass silently).
                        let eff_of_op = String::substring(op_qname, 0, String::index_of(op_qname, "::"))
                        let etps = effect_tparams(defs, eff_of_op)
                        let mut c1b = c1
                        let (sig_params, sig_ret, ret_usable) = if Array::length(etps) > 0 {
                          let (ftargs, nc) = effect_instantiate(env, eff_of_op, etps, c1b)
                          c1b = nc
                          let ip = for p in sig_params_decl {
                            subst_type_params(p, etps, ftargs)
                          }
                          (ip, subst_type_params(sig_ret_decl, etps, ftargs), type_is_ground_except(sig_ret_decl, etps))
                        } else {
                          (sig_params_decl, sig_ret_decl, type_is_ground(sig_ret_decl))
                        }
                        if Array::length(sig_params) != oalen {
                          Array::push(errors, String::concat("perform ", String::concat(op_qname, String::concat(" expects ", String::concat(__to_string(Array::length(sig_params)), String::concat(" argument(s), got ", String::concat(__to_string(oalen), off_marker(op_off))))))))
                        } else {
                          let mut vi = 0
                          while vi < oalen {
                            s1 = check_assignable(subst_apply(s1, Array::get(sig_params, vi)), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat("perform argument type mismatch for ", op_qname), op_off)
                            vi = vi + 1
                          }
                        }
                        // The perform's value is the op's declared return type —
                        // typing it (instead of a fresh var) also lets resume/arm
                        // consumers see the concrete type. Non-ground returns keep
                        // the fresh var (generic inference untouched); a generic
                        // effect's params-only return counts as usable after the
                        // fresh-var substitution above (#1340).
                        if ret_usable {
                          (sig_ret, s1, c1b)
                        } else {
                          let (tv, c2) = fresh_var(c1b)
                          (tv, s1, c2)
                        }
                      },
                      None => {
                        // Unknown op of a DECLARED effect: the typo'd op would
                        // never be matched by any handler arm — report it.
                        let ci2 = String::index_of(op_qname, "::")
                        if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {
                          Array::push(errors, String::concat("unknown operation `", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat("` of effect ", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))
                        } else {
                          ()
                        }
                        let (tv, c2) = fresh_var(c1)
                        (tv, s1, c2)
                      }
                    },
                    _ => {
                      let (tv, c2) = fresh_var(c1)
                      (tv, s1, c2)
                    }
                  }
                  typed_occurrence_capture_restore_frame_depth(capture, virtual_parent_depth)
                  perform_result
                }
              },
              EIdent(bare_qname, bare_off) => {
                // #1157: a zero-arg operation performed WITHOUT parens
                // (`perform State::Get`) parses as a bare EIdent, not an
                // ECall. #1340: validate it against the registry too — an
                // op that declares parameters cannot be performed bare, and
                // a usable return type flows out just like the ECall path
                // (generic effects instantiate their type params with fresh
                // vars first).
                match effect_op_sig(defs, bare_qname) {
                  Some(bare_sig) => {
                    let (bare_params_decl, bare_ret_decl) = bare_sig
                    let bare_eff = String::substring(bare_qname, 0, String::index_of(bare_qname, "::"))
                    let betps = effect_tparams(defs, bare_eff)
                    let mut bc1 = c
                    let (bare_ret, bare_ret_usable) = if Array::length(betps) > 0 {
                      let (bftargs, bnc) = effect_instantiate(env, bare_eff, betps, bc1)
                      bc1 = bnc
                      (subst_type_params(bare_ret_decl, betps, bftargs), type_is_ground_except(bare_ret_decl, betps))
                    } else {
                      (bare_ret_decl, type_is_ground(bare_ret_decl))
                    }
                    if Array::length(bare_params_decl) != 0 {
                      Array::push(errors, String::concat("perform ", String::concat(bare_qname, String::concat(" expects ", String::concat(__to_string(Array::length(bare_params_decl)), String::concat(" argument(s), got 0", off_marker(bare_off)))))))
                    } else {
                      ()
                    }
                    if bare_ret_usable {
                      (bare_ret, s, bc1)
                    } else {
                      let (tv, c2) = fresh_var(bc1)
                      (tv, s, c2)
                    }
                  },
                  None => {
                    let (tv, c2) = fresh_var(c)
                    (tv, s, c2)
                  }
                }
              },
              other => check_expr_capture(other, env, defs, s, c, errors, tytab, capture, lane)
            }
          } else {
            (CtUnknown, s, c)
          }
          if name == "perform?" {
            let attempt_t = if Array::length(args) == 1 {
              match Array::get(args, 0) {
                ECall(op_callee, _, _) => match op_callee {
                  EIdent(op_qname, _) => match direct_builtin_return(canonical_builtin_name(op_qname)) {
                    Some(bt) => bt,
                    None => pty
                  },
                  _ => pty
                },
                EIdent(op_qname, _) => match direct_builtin_return(canonical_builtin_name(op_qname)) {
                  Some(bt) => bt,
                  None => pty
                },
                _ => pty
              }
            } else {
              pty
            }
            (CtNamed("Attempt", [attempt_t, CtString]), ps, pc)
          } else {
            (pty, ps, pc)
          }
        } else if name == "resume" {
          let alen = Array::length(args)
          let mut s1 = s
          let mut c1 = c
          let mut ai = 0
          while ai < alen {
            let (_, ns, nc) = check_expr_capture(Array::get(args, ai), env, defs, s1, c1, errors, tytab, capture, lane)
            s1 = ns
            c1 = nc
            ai = ai + 1
          }
          let (tv, c2) = fresh_var(c1)
          (tv, s1, c2)
        } else if name == "%wasm" {
          // #805 (ADR-0072) inline wasm marker: only producible by the parser's
          // `fn f(a: Int, ..) -> Int = wasm "..."` form (a `%`-ident cannot be
          // parsed in expression position, so user source cannot forge it).
          // The declared signature is trusted extern-let style; the call's
          // value is a fresh var that unifies with the declared Int return.
          // The single arg is the WAT text literal — shape-checked here
          // defensively, never evaluated.
          let wasm_shape_ok = if Array::length(args) == 1 {
            match Array::get(args, 0) {
              EString(_) => true,
              _ => false
            }
          } else {
            false
          }
          if !wasm_shape_ok {
            Array::push(errors, "malformed inline wasm marker (expected a single WAT string literal)")
          } else {
            ()
          }
          let (tv, c2) = fresh_var(c)
          (tv, s, c2)
        } else if name == "Some" {
          if Array::length(args) == 1 {
            let (at, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
            (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at)), capture, lane), s1, c1)
          } else {
            // `Some` takes exactly one payload — `Some(1, 2)` was accepted.
            Array::push(errors, String::concat(String::concat("Some expects 1 argument, got ", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))
            (tab_call_ty(tytab, call_off, CtOption(CtUnknown), capture, lane), s, c)
          }
        } else if name == "__index" && Array::length(args) == 2 {
          // `obj[i]` (`__index(obj, i)`) is typed polymorphically by the builtin
          // table, losing the result type — `let s: String = a[0]` over an
          // `Array[Int]` slipped through. When the receiver resolves to
          // `CtArray(elem)`, refine the result to `elem`; String/Bytes indexing
          // yields the char/byte code (`Int`) so `let s: String = "abc"[0]`
          // (which returns 97) must be rejected. Var / unknown / named receivers
          // keep the conservative CtUnknown. (index_target_check above still
          // validates the receiver/subscript shapes on a throwaway channel.)
          let (obj_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let (_, s2, c2) = check_expr_capture(Array::get(args, 1), env, defs, s1, c1, errors, tytab, capture, lane)
          let result = match subst_apply(s2, obj_ty) {
            CtArray(elem) => elem,
            CtString => CtInt,
            CtBytes => CtInt,
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result, capture, lane), s2, c2)
        } else if name == "__slice" && Array::length(args) == 3 {
          // #1682: the old fallback signature was
          // `(CtUnknown, Int, Int) -> CtUnknown`, so both the receiver and
          // result unified with anything. In particular
          // `let n: Int = "hello"[0:2]` checked clean and then performed
          // pointer arithmetic at runtime. Mirror the runtime's three-way
          // dispatch explicitly and preserve an Array receiver's element type.
          let receiver_errors_before = Array::length(errors)
          let (obj_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let receiver_had_error = Array::length(errors) > receiver_errors_before
          let (start_ty, s2, c2) = check_expr_capture(Array::get(args, 1), env, defs, s1, c1, errors, tytab, capture, lane)
          let s2b = check_assignable(CtInt, subst_apply(s2, start_ty), s2, errors, "slice start must be Int", call_off)
          let (end_ty, s3, c3) = check_expr_capture(Array::get(args, 2), env, defs, s2b, c2, errors, tytab, capture, lane)
          let s3b = check_assignable(CtInt, subst_apply(s3, end_ty), s3, errors, "slice end must be Int", call_off)
          let receiver = subst_apply(s3b, obj_ty)
          if slice_receiver_is_invalid(receiver, receiver_had_error) {
            Array::push(errors, String::concat("slice receiver must be String, Bytes, or Array, got ", String::concat(type_to_string(receiver), off_marker_len(callee_off, String::length(name)))))
          } else {
            ()
          }
          (tab_call_ty(tytab, call_off, slice_result_type(receiver), capture, lane), s3b, c3)
        } else if name == "__len" && Array::length(args) == 1 {
          // Open-ended slices synthesize `__len(receiver)`. Keep its accepted
          // receiver set identical to `__slice` and the runtime dispatch.
          let receiver_errors_before = Array::length(errors)
          let (obj_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let receiver_had_error = Array::length(errors) > receiver_errors_before
          let receiver = subst_apply(s1, obj_ty)
          if slice_receiver_is_invalid(receiver, receiver_had_error) {
            Array::push(errors, String::concat("slice receiver must be String, Bytes, or Array, got ", String::concat(type_to_string(receiver), off_marker_len(callee_off, String::length(name)))))
          } else {
            ()
          }
          (tab_call_ty(tytab, call_off, CtInt, capture, lane), s1, c1)
        } else if name == "ArrayBuilder::new" && Array::length(args) == 0 {
          // #938: the builder ops were typed all-CtUnknown, so
          // `ArrayBuilder::push(b, 1); ArrayBuilder::push(b, "two")` compiled
          // clean and the frozen array leaked a raw String pointer through an
          // `Array[Int]` annotation. Give the builder a REAL element slot:
          // `CtNamed("ArrayBuilder", [fresh])` — the same shape an explicit
          // `b: ArrayBuilder[String]` annotation already resolves to
          // (checker_resolve TyApp fallback), so annotated params get checked
          // by the same push/freeze rules for free. The fresh var is bound by
          // the FIRST push and every later push must unify with it. (ELet's
          // generalize deliberately skips this shape — see the value-restriction
          // note at the ELet arm — or each use would re-instantiate the var and
          // the pushes could never disagree.)
          let (ev, c1) = fresh_var(c)
          (tab_call_ty(tytab, call_off, CtNamed("ArrayBuilder", Array::slice([
            ev
          ], 0, 1)), capture, lane), s, c1)
        } else if name == "ArrayBuilder::push" && Array::length(args) == 2 {
          // #938: unify the pushed value with the builder's element slot. A
          // builder that reaches here untyped (CtUnknown / var receiver from an
          // un-annotated param) stays tolerant, exactly like Array::push's
          // ground gate.
          let (b_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let (v_ty, s2, c2) = check_expr_capture(Array::get(args, 1), env, defs, s1, c1, errors, tytab, capture, lane)
          let s3 = match subst_apply(s2, b_ty) {
            CtNamed(bn, bargs) => if bn == "ArrayBuilder" && Array::length(bargs) == 1 {
              match unify(Array::get(bargs, 0), v_ty, s2) {
                Some(su) => su,
                None => {
                  Array::push(errors, String::concat("ArrayBuilder::push element type mismatch: builder holds ", String::concat(type_to_string(subst_apply(s2, Array::get(bargs, 0))), String::concat(", got ", String::concat(type_to_string(subst_apply(s2, v_ty)), off_marker_len(callee_off, String::length(name)))))))
                  s2
                }
              }
            } else {
              s2
            },
            _ => s2
          }
          (tab_call_ty(tytab, call_off, CtUnit, capture, lane), s3, c2)
        } else if name == "ArrayBuilder::freeze" && Array::length(args) == 1 {
          // #938: freeze returns an array of the builder's (now tracked) element
          // type, so a wrong return/let annotation is caught by the ordinary
          // unify instead of vanishing into CtArray(CtUnknown).
          let (b_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let result = match subst_apply(s1, b_ty) {
            CtNamed(bn, bargs) => if bn == "ArrayBuilder" && Array::length(bargs) == 1 {
              CtArray(subst_apply(s1, Array::get(bargs, 0)))
            } else {
              CtArray(CtUnknown)
            },
            _ => CtArray(CtUnknown)
          }
          (tab_call_ty(tytab, call_off, result, capture, lane), s1, c1)
        } else if name == "FrozenArray::from_array" && Array::length(args) == 1 {
          // #906: FrozenArray[T] is a checker-only phantom-type distinction over
          // Array[T]'s exact same runtime layout -- same technique as
          // ArrayBuilder above (freeze is a pure identity cast; here from_array
          // is too). Capture the argument's element type into
          // CtNamed("FrozenArray", [elem]) so get/to_array recover a real type
          // instead of CtUnknown. A non-concrete argument (var/unknown
          // receiver) stays tolerant, matching Array::reverse's own fallback.
          let (a_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let elem = match subst_apply(s1, a_ty) {
            CtArray(e) => e,
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, CtNamed("FrozenArray", Array::slice([
            elem
          ], 0, 1)), capture, lane), s1, c1)
        } else if name == "FrozenArray::to_array" && Array::length(args) == 1 {
          // #906: the reverse of from_array -- unwraps a tracked FrozenArray
          // element type back into an ordinary Array[T], same shape as
          // ArrayBuilder::freeze above.
          let (fa_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let result = match subst_apply(s1, fa_ty) {
            CtNamed(fn0, fargs) => if fn0 == "FrozenArray" && Array::length(fargs) == 1 {
              CtArray(subst_apply(s1, Array::get(fargs, 0)))
            } else {
              CtArray(CtUnknown)
            },
            _ => CtArray(CtUnknown)
          }
          (tab_call_ty(tytab, call_off, result, capture, lane), s1, c1)
        } else if name == "FrozenArray::get" && Array::length(args) == 2 {
          // #906: same element-type extraction as Array::get, over a tracked
          // FrozenArray receiver instead of CtArray.
          let (fa_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let (_, s2, c2) = check_expr_capture(Array::get(args, 1), env, defs, s1, c1, errors, tytab, capture, lane)
          let result = match subst_apply(s2, fa_ty) {
            CtNamed(fn1, fargs1) => if fn1 == "FrozenArray" && Array::length(fargs1) == 1 {
              subst_apply(s2, Array::get(fargs1, 0))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result, capture, lane), s2, c2)
        } else if name == "FrozenArray::length" && Array::length(args) == 1 {
          // #906: length is not element-type-dependent -- always Int, but the
          // receiver still needs checking (consistent with every other builtin
          // branch here checking all of its arguments).
          let (_, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          (tab_call_ty(tytab, call_off, CtInt, capture, lane), s1, c1)
        } else if name == "MutList::empty" && Array::length(args) == 1 {
          // ADR-0090 Phase 1: MutList[T, r] is a checker-only phantom over
          // Array[T]'s runtime layout (same technique as FrozenArray above).
          // The region argument's type -- inside `region r { .. }` a type
          // variable that `__region_run` later pins to its rigid skolem --
          // is captured as the SECOND type argument, so the escape scan in
          // the `__region_run` branch below can see region-tainted values in
          // fully-zonked types. The element type stays tolerant (CtUnknown),
          // matching FrozenArray's rows.
          let (r_ty, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let zoned_r = subst_apply(s1, r_ty)
          // #1274 Codex P1: the token must be the unforgeable `#region_N`
          // skolem the `region` binder carries. Any other argument type
          // (e.g. `MutList::empty(0)`) would install a skolem-free phantom
          // that the `__region_run` escape scan can never see, making the
          // region-bound collection freely constructible and escapable.
          // Second-class by design: the token cannot pass through function
          // parameters in this slice (a param's type is a fresh var, not
          // the skolem), matching the ADR's escape rules.
          let is_region_token = match zoned_r {
            CtNamed(zr_name, _) => String::length(zr_name) >= 8 && String::substring(zr_name, 0, 8) == "#region_",
            _ => false
          }
          if is_region_token {
            ()
          } else {
            diag_report_into(errors, String::concat("MutList::empty requires the region token bound by `region r { ... }` (the token is second-class and cannot be forged or passed through function parameters)", off_marker_len(callee_off, String::length(name))))
          }
          (tab_call_ty(tytab, call_off, CtNamed("MutList", Array::slice([
            CtUnknown,
            zoned_r
          ], 0, 2)), capture, lane), s1, c1)
        } else if name == "MutList::push" && Array::length(args) == 2 {
          // ADR-0090 Phase 1: borrows the list (arg0), consumes the element.
          // The tolerant CtUnknown element type means no per-push element
          // unification yet -- the checker slice keeps FrozenArray's
          // tolerance until MutList grows real element inference.
          let (_, s1, c1) = check_expr_capture(Array::get(args, 0), env, defs, s, c, errors, tytab, capture, lane)
          let (_, s2, c2) = check_expr_capture(Array::get(args, 1), env, defs, s1, c1, errors, tytab, capture, lane)
