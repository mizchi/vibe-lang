//# Functions

fn min_int(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

/// Encode a real AST char offset into a strippable diagnostic marker so the
/// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode
/// the exact line:col instead of falling back to a first-occurrence text scan.
/// String::concat only (never `+` / interpolation — both mis-codegen to NUL
/// here). off < 0 => no marker (heuristic fallback retained).
fn off_marker(off: Int) -> String {
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// Like off_marker but also encodes the offending token's END offset as
/// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an
/// EXACT source range (line:colC-E) instead of the LSP guessing the token end
/// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan
/// stops at the dot). Falls back to the start-only marker when len <= 0. Use this
/// where `off` is the START of a known-length named token (the symbol whose
/// length matches the source span); keep plain off_marker where the offset is an
/// anchor rather than the token start (e.g. a field error whose offset is the
/// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).
fn off_marker_len(off: Int, len: Int) -> String {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else {
    off_marker(off)
  }
}

fn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// Replace the abstract `Self` type (resolved as `CtNamed("Self", _)`) inside a
/// trait-method signature with the concrete receiver type, when typing a
/// `T::method` call against a bounded generic parameter T.
fn subst_self_in_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(a, self_ty)
      }
      CtNamed(n, ra)
    },
    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(e, self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(p, self_ty)
    }, subst_self_in_type(ret, self_ty), eff),
    _ => ty
  }
}

/// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->
/// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that
/// resolves to a real type (primitive or declared) is kept; only truly-unknown
/// named types — the trait's own element type params, which the uniform
/// representation erases — are relaxed. (#636.)
fn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs, n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(a, defs)
        })
      } else {
        CtUnknown
      }
    },
    CtArray(e) => CtArray(relax_unknown_named(e, defs)),
    CtOption(e) => CtOption(relax_unknown_named(e, defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(e, defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(p, defs)
    }, relax_unknown_named(r, defs), eff),
    _ => ty
  }
}

/// Resolve a qualified identifier `T::method` where `T` is a bounded generic
/// type parameter (`[T: Trait]`). If the head resolves to a type variable whose
/// recorded bounds include a trait declaring `method`, return that method's
/// signature with `Self` substituted by T. Returns None for any other qualified
/// name (concrete `Type::method`, module-qualified names, etc.) so the existing
/// resolution paths are untouched. (PR-3 component 2.)
fn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let method = String::substring(name, idx + 2, String::length(name))
    match env_lookup(env, head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s, vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_name = Array::get(bounds, bi)
              match trait_method_sig_deep(env, trait_name, method) {
                Some(sig) => {
                  let (params_te, ret_te) = sig
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)
                  }
                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}

/// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,
/// `Sh::Circle`) to the bare variant's constructor type. The bare variant name
/// is already bound in `env` by the SEnum case; we only confirm `head` names a
/// known enum that actually owns `member` (so unrelated `T::method` names fall
/// through to the `unknown name` path). Returns the polymorphic env type as-is;
/// callers instantiate it exactly like a bare ident. (#672 qualified ctors.)
fn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef]) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    match find_typedef(defs, head) {
      Some(TDEnum(_, _, variants)) => {
        let mut found = false
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          if vname == member {
            found = true
          } else {
            ()
          }
          vi = vi + 1
        }
        if found {
          env_lookup(env, member)
        } else {
          None
        }
      },
      _ => None
    }
  }
}

fn expr_ident_name_or_empty(expr: Expr) -> String {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}

/// Erase every effect annotation in a type (recursively), so an argument can be
/// checked for STRUCTURAL compatibility independent of effects. Effects on
/// function VALUES are inferred imprecisely (a `with { Error }` callback often
/// arrives typed with no effect), so an effect-only difference must not be
/// reported as a type error — only the structural shape is enforced here.
fn strip_effects(ty: Type) -> Type {
  match ty {
    CtFn(params, ret, _) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, strip_effects(Array::get(params, i)))
        i = i + 1
      }
      CtFn(out, strip_effects(ret), None)
    },
    CtArray(elem) => CtArray(strip_effects(elem)),
    CtOption(elem) => CtOption(strip_effects(elem)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, strip_effects(Array::get(elems, i)))
        i = i + 1
      }
      CtTuple(out)
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, strip_effects(Array::get(args, i)))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => ty
  }
}

/// True when a type is fully ground (mentions no type parameter / type
/// variable). An unresolved type name resolves to `CtNamed(_, _)` (see
/// resolve_type_expr), which for a struct field or function parameter means a
/// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used
/// both to restrict record struct-identity recovery to MONOMORPHIC structs (a
/// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`
/// relies on) and to gate structural-mismatch reporting to concrete types.
/// #635: does a match-arm body DIVERGE (early-`return`), yielding no value to the
/// match? The `?`-operator desugar lowers `val?` to
///   match val { Some(v) => v, None => return None }
/// whose `None` arm is `return None` — it must not force the match's result type
/// (else `T` vs `Option[T]` clashes). A diverging arm is a bare `return`, or a
/// block (`ESeq`) whose final expr diverges.
fn arm_body_diverges(body: Expr) -> Bool {
  match body {
    EReturn(_) => true,
    ESeq(_, rest) => arm_body_diverges(rest),
    _ => false
  }
}

/// #941: the railway monad HEAD of a type — 1 for Option, 2 for Result, 0 for
/// anything else. `Option[T]` is the builtin `CtOption`; the prelude `Result`
/// is an injected user-level enum, so a constructed value surfaces as
/// `CtNamed("Result", args)` (or bare `CtEnum("Result")`). Mixing the two
/// monads on one railway (`?` / `let*` — docs/cheatsheet.md #635) is documented
/// as a type error, but `check_assignable` tolerates the pair silently: a
/// `CtNamed` head is kind 0 in `head_kind` (it may be a rigid type parameter)
/// and makes `type_no_named` false, so NEITHER report gate fires and the
/// mismatch sailed through to a runtime `unreachable` trap. The name-based
/// check below is safe precisely because "Result"/"Option" as heads are the
/// prelude monads — a rigid type parameter never carries those names.
fn railway_head(t: Type) -> Int {
  match t {
    CtOption(_) => 1,
    CtEnum(n) => if n == "Result" {
      2
    } else if n == "Option" {
      1
    } else {
      0
    },
    CtNamed(n, _) => if n == "Result" {
      2
    } else if n == "Option" {
      1
    } else {
      0
    },
    _ => 0
  }
}

/// #941: true when `expected` and `actual` sit on DIFFERENT railway monads
/// (one Option-headed, the other Result-headed). No instantiation of inner
/// type parameters can ever reconcile the two heads, so this is a genuine
/// mismatch even though both types mention type variables / named params.
fn railway_heads_conflict(expected: Type, actual: Type) -> Bool {
  let he = railway_head(expected)
  let ha = railway_head(actual)
  he != 0 && ha != 0 && he != ha
}

/// #941: best-effort source anchor for a (possibly desugar-generated) expr —
/// the first real char offset found walking into the value position, or -1.
/// The railway desugar (#635) threads the `?`/`let*` operand's offset into its
/// generated `Err(..)`/`None` failure-track nodes, so the mixing diagnostics
/// below locate at the offending operand.
fn railway_expr_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      railway_expr_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(base)
    },
    EBinOp(_, lhs, _) => railway_expr_off(lhs),
    EMatch(scrut, _) => railway_expr_off(scrut),
    ESeq(first, _) => railway_expr_off(first),
    _ => 0 - 1
  }
}

fn type_is_ground(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground(e),
    CtOption(e) => type_is_ground(e),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #1081 step 3: does a FULLY-ZONKED type contain a `CtNamed` with exactly
/// this name anywhere in its structure? Used to detect a region skolem
/// (`"#region_<n>"`, unforgeable by parsed source) escaping its
/// `TaskGroup::run` call. The caller must `subst_apply` before calling this
/// — an un-zonked `CtVar` cannot be inspected here (deliberately no
/// substitution lookup: this function has no `Subst` to chase, and the two
/// call sites both already pass zonked input).
fn type_mentions_named(ty: Type, name: String) -> Bool {
  match ty {
    CtNamed(n, targs) => if n == name {
      true
    } else {
      let mut found = false
      let mut i = 0
      while i < Array::length(targs) {
        if type_mentions_named(Array::get(targs, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) {
        if type_mentions_named(Array::get(items, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtArray(e) => type_mentions_named(e, name),
    CtOption(e) => type_mentions_named(e, name),
    CtFn(ps, ret, _) => {
      let mut found = type_mentions_named(ret, name)
      let mut i = 0
      while i < Array::length(ps) {
        if type_mentions_named(Array::get(ps, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtForAll(_, _, body) => type_mentions_named(body, name),
    _ => false
  }
}

/// #1081 step 3: every (name, type) binding currently visible in `env`,
/// walking the same cons-chain shape `env_cache` (core/types.vibe) already
/// walks — trait-def/impl layers carry no ordinary value binding and are
/// skipped, matching that traversal. Used by the `TaskGroup::run` escape
/// check to scan every OUTER binding (never a binding local to the nursery
/// body itself, since those live in a DERIVED env built while checking the
/// body, not in the `env` captured at the call site) for a leaked region
/// skolem after the body has been checked.
fn collect_env_bindings(env: TypeEnv, acc: Array[(String, Type)]) -> Unit {
  match env {
    EnvEmpty => (),
    EnvBind(n, ty, rest) => {
      Array::push(acc, (n, ty))
      collect_env_bindings(rest, acc)
    },
    EnvTraitDef(_, _, _, _, rest) => collect_env_bindings(rest, acc),
    EnvTraitImpl(_, _, rest) => collect_env_bindings(rest, acc),
    EnvTraitImplGen(_, _, _, _, rest) => collect_env_bindings(rest, acc),
    EnvFlat(bindings) => {
      let mut i = 0
      while i < Array::length(bindings) {
        Array::push(acc, Array::get(bindings, i))
        i = i + 1
      }
    },
    EnvCached(names, types, rest) => {
      let mut i = 0
      while i < Array::length(names) {
        Array::push(acc, (Array::get(names, i), Array::get(types, i)))
        i = i + 1
      }
      collect_env_bindings(rest, acc)
    }
  }
}

/// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but
/// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type
/// whose only flexibility is unification variables: if such a type fails to unify
/// against a fully GROUND expected type, no instantiation of its variables can
/// make it match, so the mismatch is real (unlike an un-instantiated generic
/// param `CtNamed(T)`, which the checker simply has not substituted yet).
fn type_no_named(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_no_named(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_no_named(e),
    CtOption(e) => type_no_named(e),
    CtFn(ps, r, _) => {
      let mut ok = type_no_named(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_no_named(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is
/// not concrete (a type variable / unresolved named param / unknown / forall).
/// Two types with DIFFERENT non-zero heads can never be made equal by any
/// instantiation of their inner type parameters (an `Int` is never an `Array[T]`
/// for any `T`), so such a unify failure is a real mismatch even when the inner
/// parts are generic — which the whole-type groundness gate misses.
fn head_kind(t: Type) -> Int {
  match t {
    CtInt => 1,
    CtDouble => 2,
    CtBool => 3,
    CtString => 4,
    CtChar => 5,
    CtUnit => 6,
    CtBytes => 7,
    CtTuple(_) => 8,
    CtArray(_) => 9,
    CtOption(_) => 10,
    CtStruct(_) => 11,
    CtEnum(_) => 12,
    CtFn(_, _, _) => 13,
    _ => 0
  }
}

/// #827: `Stream[T]` is `CtNamed` (head_kind 0 = tolerated), so the Array
/// builtins' receiver head check let `Array::length(stream)` / `Array::get(s,
/// 0)` through — observably leaking the eager Array-backed representation
/// (ADR-0012) into user programs. Recognise a Stream receiver so the Array
/// head-check sites can reject it explicitly; head_kind itself is unchanged
/// (other CtNamed heads stay tolerated, the #826 discipline).
fn is_stream_named_type(t: Type) -> Bool {
  match t {
    CtNamed(n, _) => n == "Stream",
    _ => false
  }
}

/// True when every declared field type of a struct is ground (the struct is not
/// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.
fn struct_fields_ground(dfields: Array[(String, Type)]) -> Bool {
  let mut ok = true
  let mut i = 0
  while i < Array::length(dfields) {
    let (_, ft) = Array::get(dfields, i)
    if !type_is_ground(ft) {
      ok = false
    }
    i = i + 1
  }
  ok
}

/// #939 helpers: detect a function VALUE laundering a concrete effect row away
/// through a pure-typed slot (HOF argument, let/struct-field/array annotation).
/// The strip_effects fallback below deliberately tolerates effect-only
/// differences — but for CONCRETE, non-exempt labels flowing in a COVARIANT
/// position that tolerance is the #939 soundness hole: the value's perform
/// executes with no handler and the program dies with an unhandled wasm
/// exception at runtime. Exemptions mirror checker_effects' transitive pass:
/// `Error` (pervasive un-annotated throw sites, #640), `Async`
/// (composition-allowed), and effect VARIABLES (single lowercase letter /
/// `$N` fresh vars — not decidable without call-site row unification, #885).
fn effect_label_is_exempt(lbl: String) -> Bool {
  let len = String::length(lbl)
  if is_exception_effect_name(lbl) || lbl == "Async" {
    true
  } else if len == 1 {
    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122
  } else if len >= 2 {
    String::char_code_at(lbl, 0) == 36
  } else {
    true
  }
}

fn row_labels(row: Option[String]) -> Array[String] {
  match row {
    Some(r) => {
      let parts = String::split(r, ",")
      let out = array_empty()
      let mut i = 0
      while i < Array::length(parts) {
        let t = String::trim(Array::get(parts, i))
        if String::length(t) > 0 {
          Array::push(out, t)
        } else {
          ()
        }
        i = i + 1
      }
      out
    },
    None => array_empty()
  }
}

fn row_contains_label(row: Option[String], lbl: String) -> Bool {
  let labels = row_labels(row)
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) && !found {
    if Array::get(labels, i) == lbl {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// First concrete, non-exempt effect label whose drop would let a perform run
/// with no handler. At each CtFn the ACTUAL side's own row must not carry a
/// label the EXPECTED side's row lacks; the return type recurses covariantly;
/// PARAMETER positions recurse with expected/actual SWAPPED (contravariance —
/// Codex P1 on #978: an `((Int) -> Int with { Logger }, Int) -> Int` slot
/// holding a pure-callback fn lets `h(eff, 1)` type-check while the callee
/// invokes the effectful callback with no handler, so at parameter positions
/// it is the EXPECTED param's concrete labels that must be tolerated by the
/// ACTUAL param). pure→effectful still passes in both directions by
/// construction, and an effectful parameter slot accepting a pure function
/// stays legal (the swap makes that the label-free side).
fn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {
  match expected {
    CtFn(eparams, eret, eeff) => match actual {
      CtFn(aparams, aret, aeff) => {
        let alabels = row_labels(aeff)
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(alabels) && !done {
          let lbl = Array::get(alabels, i)
          if !effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl) {
            dropped = Some(lbl)
            done = true
          } else {
            ()
          }
          i = i + 1
        }
        if !done && Array::length(eparams) == Array::length(aparams) {
          let mut pi = 0
          while pi < Array::length(eparams) && !done {
            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {
              Some(pl) => {
                dropped = Some(pl)
                done = true
              },
              None => ()
            }
            pi = pi + 1
          }
        } else {
          ()
        }
        match dropped {
          Some(l) => Some(l),
          None => effect_row_dropped(eret, aret)
        }
      },
      _ => None
    },
    CtArray(ee) => match actual {
      CtArray(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtOption(ee) => match actual {
      CtOption(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtTuple(ees) => match actual {
      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(ees) && !done {
          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    CtNamed(en, eargs) => match actual {
      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(eargs) && !done {
          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch
/// (the checker historically swallowed these, accepting ill-typed programs).
/// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with
/// effects erased, and tolerate the difference if the structure matches — effect
/// inference on function values is imprecise, so effect-only differences must not
/// be reported here (EXCEPT a concrete covariant row drop — see
/// `effect_row_dropped` above, #939). Returns the (possibly extended)
/// substitution.
export fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {
  match unify(expected, actual, s) {
    Some(su) => su,
    None => {
      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {
        Some(_) => true,
        None => false
      }
      // Only report when BOTH sides are fully ground (mention no type parameter
      // / type variable). The checker does not instantiate a generic
      // struct field's or function parameter's type params — they surface as
      // rigid `CtNamed(T, _)` — so a unify failure against a concrete
      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->
      // Option[(T, Int)]` field vs a concrete closure). Reporting only on
      // ground/ground keeps the genuine concrete-type mismatches (Int vs
      // String, struct field of the wrong concrete type) while not
      // over-rejecting polymorphic code.
      // Report when the EXPECTED type is fully ground and the ACTUAL type
      // mentions no rigid type parameter (inference variables are fine). A
      // unify failure under those conditions is genuine: no instantiation of
      // the actual's variables can satisfy the concrete expected type (this is
      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground
      // expected, or an actual carrying an un-instantiated generic `CtNamed`,
      // is still tolerated to avoid over-rejecting polymorphic code.
      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))
      // Also report when the two types have DIFFERENT concrete top-level
      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no
      // instantiation of inner type parameters can reconcile them, so it is a
      // real mismatch even though the expected type is non-ground. A
      // var/named/unknown head (kind 0) on either side stays tolerated.
      let eh = head_kind(subst_apply(s, expected))
      let ah = head_kind(subst_apply(s, actual))
      let head_differ = eh != 0 && ah != 0 && eh != ah
      // #1001: a `CtNamed` head is kind 0 in `head_kind` (may be a rigid type
      // parameter), so `Result[Int,String]` vs `Option[Int]` — or the same
      // pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn signature —
      // sails past `head_differ` untouched, and `detect_narrowed_generic_mismatch`
      // below only fires on a SAME-name pair, so a genuinely DIFFERENT nominal
      // head was never reported at all. Check that ahead of the existing
      // gates; internally gated on `type_fully_concrete` so a still-rigid
      // type parameter never triggers it.
      let nominal_conflict = nominal_head_conflict(subst_apply(s, expected), subst_apply(s, actual))
      if nominal_conflict {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(", got ", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))
        s
      } else if structural {
        // #939: the structural retry tolerated EVERY effect-only difference,
        // including a function value whose CONCRETE row silently vanishes
        // into a pure-typed slot (HOF argument, let / struct field / array
        // annotation) — the perform then runs with no handler and dies as an
        // unhandled wasm exception at runtime. Report exactly that shape;
        // pure→effectful subsumption and Error/Async/effect-var differences
        // stay tolerated (see effect_row_dropped).
        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {
          Some(lbl) => {
            Array::push(errors, String::concat(what, String::concat(": effect row mismatch: a value of type ", String::concat(type_to_string(subst_apply(s, actual)), String::concat(" cannot be used where ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(" is expected (the { ", String::concat(lbl, String::concat(" } effect would be dropped — no handler could ever run)", off_marker(off))))))))))
            s
          },
          None => s
        }
      } else if !(reportable || head_differ) {
        // #981: a user generic type's ARGUMENTS were never compared here — a
        // `CtNamed` head is kind 0 (tolerated by `head_differ`) and makes
        // `type_no_named(actual)` false, so `get_int(b)` with
        // `b: Box[String]` against `Box[Int]` sailed through this branch
        // silently (compile clean, heap-pointer garbage at runtime), while
        // the symmetric builtin (`Array[String]` vs `Array[Int]`) and the
        // RETURN position were both rejected. Close exactly that hole with
        // the proven #844 predicate (`detect_narrowed_generic_mismatch`):
        // report ONLY a same-name, same-arity (> 0), fully-concrete `CtNamed`
        // pair whose arguments fail to unify — a rigid/uninstantiated type
        // parameter surfaces as `CtNamed(T, [])` / the `[CtUnknown]` sentinel
        // and stays tolerated, so polymorphic code is not over-rejected.
        // Additionally gate on the RAW expected type (BEFORE subst) being
        // fully concrete: an expected that only became concrete through this
        // call's own unification is not trustworthy — an IMPORTED generic
        // fn's signature can cross-talk its type params through the flat
        // import env (measured: `list_zip[A, B]` imported from
        // lib/@vibe/core/list.vibe reported `expected List[String], got
        // List[Int]` on its second argument — A's binding leaked into B's
        // slot), and reporting that shape would reject valid polymorphic
        // calls. A monomorphic signature (the #981 hole) is concrete without
        // any substitution, so the genuine cases all keep reporting.
        if type_fully_concrete(expected) {
          detect_narrowed_generic_mismatch(expected, actual, s, errors, what, off)
        } else {
          s
        }
      } else {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(", got ", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))
        s
      }
    }
  }
}

/// #1001: the type's outer constructor's nominal name, when it is one that can
/// NEVER be a placeholder for a still-unresolved rigid type parameter --
/// `CtOption` (the builtin `Option[T]`; `Option` written as an annotation
/// resolves to this, not `CtNamed("Option", _)` -- see `railway_head` above)
/// and `CtEnum`/`CtStruct` (a RESOLVED reference to a declared enum/struct,
/// always concrete) are unconditionally trustworthy. A bare `CtNamed(n, _)`
/// is ambiguous -- it is ALSO how an uninstantiated generic type parameter
/// surfaces (`CtNamed("T", [])`) -- so it only counts when
/// `type_fully_concrete` confirms this occurrence is not that sentinel shape.
/// `None` means "nothing nominal to compare" (a type variable, a builtin
/// scalar, a container whose own head isn't itself nominal, etc).
fn nominal_name_of(t: Type) -> Option[String] {
  match t {
    CtOption(_) => Some("Option"),
    CtEnum(n) => Some(n),
    CtStruct(n) => Some(n),
    CtNamed(n, _) => if type_fully_concrete(t) {
      Some(n)
    } else {
      None
    },
    _ => None
  }
}

/// #1001: true when `expected` and `actual` carry a corresponding pair of
/// nominal names that DIFFER, anywhere in their structure -- e.g.
/// `Result[Int,String]` (`CtNamed`) vs `Option[Int]` (the builtin `CtOption`),
/// or the same pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn
/// signature/a same-named `CtNamed`'s own type arguments (mirroring
/// `effect_row_dropped`'s traversal above). No instantiation of type
/// PARAMETERS can ever reconcile two DIFFERENT nominal names, so this is a
/// genuine mismatch regardless of arity or which concrete `Type` shape either
/// side happens to be represented as -- unlike `detect_narrowed_generic_mismatch`
/// below, which only catches a SAME-name `CtNamed`/`CtNamed` mismatch (e.g.
/// `Box[Int]` vs `Box[String]`, #981) and never even inspects a
/// `CtArray[Option[Int]]` vs `CtArray[Result[Int,String]]` pair's nested heads,
/// nor a builtin `CtOption` against a `CtNamed`/`CtEnum` nominal type, at all.
fn nominal_head_conflict(expected: Type, actual: Type) -> Bool {
  let direct_conflict = match nominal_name_of(expected) {
    Some(en) => match nominal_name_of(actual) {
      Some(an) => en != an,
      None => false
    },
    None => false
  }
  if direct_conflict {
    true
  } else {
    match expected {
      CtNamed(_, eargs) => match actual {
        CtNamed(_, aargs) => if Array::length(eargs) == Array::length(aargs) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(eargs) && !conflict {
            if nominal_head_conflict(Array::get(eargs, i), Array::get(aargs, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtArray(ee) => match actual {
        CtArray(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtOption(ee) => match actual {
        CtOption(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtTuple(ees) => match actual {
        CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(ees) && !conflict {
            if nominal_head_conflict(Array::get(ees, i), Array::get(aes, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtFn(eps, er, _) => match actual {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          let mut i = 0
          let mut conflict = nominal_head_conflict(er, ar)
          while i < Array::length(eps) && !conflict {
            if nominal_head_conflict(Array::get(eps, i), Array::get(aps, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      _ => false
    }
  }
}

/// #844: true when `t` mentions no unresolved/rigid type-parameter placeholder
/// and no unbound unification variable ANYWHERE in its structure -- i.e. it is
/// a genuinely CONCRETE type. Unlike the more conservative shared
/// `type_is_ground` (which treats EVERY `CtNamed` as non-ground, to stay safe
/// for the many call sites that must still tolerate a rigid/uninstantiated
/// type parameter such as a trait method's `CtNamed("T", _)` field type), this
/// recurses into `CtNamed`'s own type arguments. Used ONLY by
/// `detect_narrowed_generic_mismatch` below (a narrowly-scoped, additive check
/// for the `let`-annotation erasure hole -- see #844) so this refinement's
/// blast radius stays contained to that one new check instead of the many
/// existing `type_is_ground` call sites.
///
/// The sentinel shape `CtNamed(name, [CtUnknown])` is what `resolve_type_expr`
/// (checker_resolve.vibe) emits for an unresolved rigid single-name type
/// parameter reference AND for an unresolved/unknown type name alike -- treat
/// that shape as non-concrete. A REAL instantiated generic type (e.g. #829's
/// `Box::{v:1}` -> `CtNamed("Box", [CtInt])`) never carries the bare
/// `CtUnknown` sentinel as its own argument.
fn type_fully_concrete(t: Type) -> Bool {
  match t {
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtUnknown => false,
    // A `CtNamed` with an EMPTY argument list is ALSO treated as non-concrete
    // (not just the `[CtUnknown]` singlet sentinel above): a rigid/uninstantiated
    // generic function's own type parameter can leak through, unsubstituted,
    // as a bare `CtNamed(pname, [])` when it only appears NESTED inside another
    // type's argument list (e.g. `HashMap::new_int[V]() -> HashMap[Int, V]`
    // called as `HashMap::new_int()` -- `instantiate` does not always rewrite
    // an occurrence of `V` buried inside a struct's own field/return-type
    // representation to a fresh `CtVar`, so it can surface literally as
    // `CtNamed("V", [])` instead -- lib/@vibe/core/hashmap_test.vibe
    // hit exactly this via `let m: HashMap[Int, String] = HashMap::new_int()`
    // during development of this check). Both shapes are the SAME underlying
    // ambiguity (a name with no way to tell "resolved zero-arg nominal type"
    // from "unresolved rigid reference" apart) that the shared `type_is_ground`
    // sidesteps by always tolerating `CtNamed`; treat both as non-concrete here
    // too so this narrowly-scoped check only ever fires when it is SURE both
    // sides are fully resolved.
    CtNamed(_, args) => {
      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {
        CtUnknown => true,
        _ => false
      })
      if is_sentinel {
        false
      } else {
        let mut ok = true
        let mut i = 0
        while i < Array::length(args) {
          if !type_fully_concrete(Array::get(args, i)) {
            ok = false
          }
          i = i + 1
        }
        ok
      }
    },
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_fully_concrete(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_fully_concrete(e),
    CtOption(e) => type_fully_concrete(e),
    CtFn(ps, r, _) => {
      let mut ok = type_fully_concrete(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_fully_concrete(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #844: `resolve_type_expr` types a BARE (unparameterized) reference to a
/// generic struct annotation (`let x: Box = ...`) as bare `CtStruct("Box")`,
/// discarding the struct's real type arguments -- and `unify`'s
/// `CtStruct`/`CtNamed` bridge (core/types.vibe, #829/#843) then lets that bare
/// annotation re-unify by NAME ALONE with any later, unrelated instantiation
/// (`let y: Box[String] = x`), silently re-narrowing a laundered value. Fixing
/// that erasure at its source (threading fresh type variables through
/// `resolve_type_expr`) touches its ~20 call sites across the whole checker
/// and was judged too wide-blast-radius to land in one pass (#844); this is
/// the narrower, additive half of the fix that IS safe to land: when BOTH the
/// expected annotation and the actual value are already a fully concrete,
/// SAME-NAME `CtNamed` instantiation (arity > 0) and their arguments do not
/// unify, report the mismatch directly -- bypassing `check_assignable`'s
/// `type_is_ground` gate, which (deliberately, to stay lenient for genuinely
/// rigid/uninstantiated type parameters elsewhere) treats every `CtNamed` as
/// non-ground and so never reports this shape at all. Gated on
/// `type_fully_concrete` on BOTH sides so a still-polymorphic case (either
/// side embedding an unresolved rigid parameter or unbound type variable, e.g.
/// a trait-generic `LazyIter[T]` return before `T` is resolved) is never
/// flagged -- only a same-name mismatch where both sides are already fully
/// resolved concrete types.
export fn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {
  let e2 = subst_apply(s, expected)
  let a2 = subst_apply(s, actual)
  match e2 {
    CtNamed(ename, eargs) => match a2 {
      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {
        match unify(e2, a2, s) {
          Some(_) => s,
          None => {
            Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(e2), String::concat(", got ", String::concat(type_to_string(a2), off_marker(off)))))))
            s
          }
        }
      } else s,
      _ => s
    },
    _ => s
  }
}

/// #844: when a `let`-style annotation is a BARE (unparameterized) reference to
/// a generic struct (`resolve_type_expr` resolves it to bare `CtStruct(name)`,
/// discarding type args) and the RHS's ACTUAL inferred type is already a
/// concrete instantiation of that SAME struct (`CtNamed(name, args)`, arity >
/// 0, from #829's struct-literal instantiation), prefer recording the RHS's
/// real instantiated type for the binding instead of the erasing bare
/// annotation. This does not change what the CURRENT statement accepts (the
/// bare annotation already tolerates any instantiation via the unify bridge,
/// unchanged here) -- it only changes what a LATER statement observes when it
/// looks the binding up, so a subsequent re-narrowing annotation
/// (`detect_narrowed_generic_mismatch` above) has real type information to
/// compare against instead of an erased placeholder.
export fn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type {
  match resolved {
    CtStruct(rname) => match actual {
      CtNamed(aname, aargs) => if rname == aname && Array::length(aargs) > 0 {
        actual
      } else {
        resolved
      },
      _ => resolved
    },
    _ => resolved
  }
}

/// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a
/// bare ERecord), so the struct is resolved by matching the field-name SET. True
/// when `declared` and `actual` have the same field names.
fn struct_field_names_match(declared: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {
  if Array::length(declared) != Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(declared) {
      let (dn, _) = Array::get(declared, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(actual) {
        let (an, _) = Array::get(actual, j)
        if an == dn {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

/// #813: look up a qualified operation name ("Eff::Op") in the declared-effect
/// registry (TDEffect defs). None when the name is unqualified, the effect is
/// undeclared/builtin/generic, or the op is unknown WITHIN a declared effect is
/// reported separately by the callers — this returns None only when there is
/// nothing to validate against (pre-#813 behavior).
fn effect_op_sig(defs: Array[TypeDef], qname: String) -> Option[(Array[Type], Type)] {
  let ci = String::index_of(qname, "::")
  if ci < 0 {
    None
  } else {
    let eff = String::substring(qname, 0, ci)
    let op = String::substring(qname, ci + 2, String::length(qname))
    match find_typedef(defs, eff) {
      Some(td) => match td {
        TDEffect(_, ops) => {
          let mut oi = 0
          let mut found = None
          while oi < Array::length(ops) {
            let (oname, oparams, oret) = Array::get(ops, oi)
            if oname == op {
              found = Some((oparams, oret))
            } else {
              ()
            }
            oi = oi + 1
          }
          found
        },
        _ => None
      },
      None => None
    }
  }
}

/// #813: is `eff` a DECLARED effect (TDEffect) in this module? Distinguishes
/// "unknown op of a declared effect" (reportable) from builtin/imported
/// effects the registry cannot see (skip).
fn effect_is_declared(defs: Array[TypeDef], eff: String) -> Bool {
  match find_typedef(defs, eff) {
    Some(td) => match td {
      TDEffect(_, _) => true,
      _ => false
    },
    None => false
  }
}

fn lookup_actual_field_ty(actual: Array[(String, Type)], name: String) -> Option[Type] {
  let mut i = 0
  let mut out = None
  while i < Array::length(actual) {
    let (an, at) = Array::get(actual, i)
    if an == name {
      out = Some(at)
    }
    i = i + 1
  }
  out
}

/// True when `dfields` (a struct's declared fields) is a STRICT superset of the
/// record literal's `actual` fields: every provided field name appears in the
/// struct, and the struct declares strictly more fields. Used to flag a record
/// that omits required fields.
fn struct_is_strict_superset(dfields: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {
  if Array::length(dfields) <= Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut all_in = true
    while i < Array::length(actual) {
      let (an, _) = Array::get(actual, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(dfields) {
        let (dn, _) = Array::get(dfields, j)
        if dn == an {
          found = true
        } else {
          ()
        }
        j = j + 1
      }
      if !found {
        all_in = false
      } else {
        ()
      }
      i = i + 1
    }
    all_in
  }
}

/// Check a record literal's field VALUES against the declared field types of the
/// (uniquely) matching struct definition — previously unchecked, so
/// `S::{ x: "oops" }` for `struct S { x: Int }` was accepted. Conservative: if 0
/// or >1 structs share the field-name set, skip (no struct could be determined).
fn check_record_fields(defs: Array[TypeDef], actual: Array[(String, Type)], s: Subst, errors: Array[String]) -> Subst {
  let mut matchct = 0
  let mut matched_fields = array_empty()
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(_, dfields, _, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        matched_fields = dfields
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 {
    let mut out = s
    let mut i = 0
    while i < Array::length(matched_fields) {
      let (fname, declared_ty) = Array::get(matched_fields, i)
      match lookup_actual_field_ty(actual, fname) {
        Some(actual_ty) => {
          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat("struct field type mismatch for ", fname), 0 - 1)
        },
        None => ()
      }
      i = i + 1
    }
    out
  } else if matchct > 1 {
    // Ambiguous: MORE than one struct declares exactly this field-name set
    // (e.g. `S2 { name: Int; y: String }` vs `S3 { y: String; name: String }`).
    // The literal is a valid construction of one of them, we just cannot tell
    // which — skip value checking, and in particular do NOT fall through to
    // the missing-field superset heuristic below: it used to fire here and
    // report a bogus "missing field" against some unrelated superset struct
    // (found by fuzz/run_fuzz.sh, seeds 68/282).
    s
  } else {
    // No struct has EXACTLY this field set. If exactly one struct is a strict
    // SUPERSET (contains every provided field and at least one more), the record
    // is that struct with fields MISSING — a real soundness hole, since the
    // omitted fields would be left uninitialized. Reported only when the
    // superset is unique (otherwise the intended struct is ambiguous → skip).
    let mut supct = 0
    let mut sup_name = ""
    let mut sup_fields = array_empty()
    let mut dj = 0
    while dj < Array::length(defs) {
      match Array::get(defs, dj) {
        TDStruct(sname, dfields, _, _) => if struct_is_strict_superset(dfields, actual) {
          supct = supct + 1
          sup_name = sname
          sup_fields = dfields
        },
        _ => ()
      }
      dj = dj + 1
    }
    if supct == 1 {
      let mut fi = 0
      while fi < Array::length(sup_fields) {
        let (dn, _) = Array::get(sup_fields, fi)
        match lookup_actual_field_ty(actual, dn) {
          Some(_) => (),
          None => Array::push(errors, String::concat("missing field `", String::concat(dn, String::concat("` in construction of struct ", sup_name))))
        }
        fi = fi + 1
      }
      s
    } else {
      s
    }
  }
}

/// Resolve the (uniquely) matching struct name for a record literal's field-name
/// set. Returns None when 0 or >1 structs share that field set (ambiguous), or
/// when the matching struct is GENERIC (non-ground fields) — so a record's
/// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used
/// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of
/// CtUnknown, which in turn lets `mut`-field write checking see the struct
/// without disturbing generic-struct inference.
fn resolve_record_struct_name(defs: Array[TypeDef], actual: Array[(String, Type)]) -> Option[String] {
  let mut matchct = 0
  let mut out = None
  let mut ground = false
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(sname, dfields, _, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        out = Some(sname)
        ground = struct_fields_ground(dfields)
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 && ground {
    out
  } else {
    None
  }
}

/// Unify each argument against its parameter, REPORTING a type mismatch instead
/// of silently swallowing it. `__to_string` (the polymorphic interpolation
/// stringifier: `"\{x}"` -> `__to_string(x)` wraps values of any type, but the
/// polyfill annotates it `(Int) -> String`) is exempt.
fn unify_call_args(param_tys: Array[Type], arg_tys: Array[Type], s: Subst, errors: Array[String], label: String, off: Int) -> Subst {
  let mut out = s
  let mut ui = 0
  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
  while ui < ul {
    let pty = Array::get(param_tys, ui)
    let aty = Array::get(arg_tys, ui)
    out = if label == "__to_string" {
      match unify(pty, aty, out) {
        Some(su) => su,
        None => out
      }
    } else {
      check_assignable(pty, aty, out, errors, String::concat("argument type mismatch for ", label), off)
    }
    ui = ui + 1
  }
  out
}

/// #844: recognize the EXACT synthetic call shape `parser_expr_dispatch.vibe`'s
/// `ascribe_wrap` builds for a LOCAL `let x: T = val` --
/// `((__asc: T) -> __asc)(val)` -- and return its annotation `T`. `"__asc"` is
/// a dedicated internal marker name (parallel to `"__return__"` /
/// `"__in_loop__"` used elsewhere in this file), never written by real user
/// code, so this match is precise: an ordinary lambda call (a real user IIFE)
/// will not have a single param literally named `__asc` whose body is exactly
/// `EIdent("__asc", _)`. Used to run a dedicated, narrowly-scoped check for
/// this one call shape (see the `ECall` fallback arm below) instead of
/// changing the general call-argument checking (`unify_call_args`) that every
/// other call in the language goes through.
fn ascription_lambda_ann(callee: Expr) -> Option[TypeExpr] {
  match callee {
    EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {
      match ret_ty {
        Some(_) => None,
        None => match effect {
          Some(_) => None,
          None => {
            let (pname, pann) = Array::get(params, 0)
            if pname == "__asc" {
              match body {
                EIdent(bname, _) => if bname == "__asc" {
                  pann
                } else {
                  None
                },
                _ => None
              }
            } else {
              None
            }
          }
        }
      }
    } else {
      None
    },
    _ => None
  }
}

export fn fn_return_env_name(name: String) -> String {
  String::concat("__fn_ret__:", name)
}

/// #938: the ArrayBuilder container type — `CtNamed("ArrayBuilder", [elem])`,
/// the same shape `b: ArrayBuilder[T]` annotations resolve to. Used by the
/// builder call branches below. #983/#996 (Codex P2): `Map` is deliberately
/// NOT listed here — `Map::set` is a FUNCTIONAL update (the linear codegen
/// allocates a fresh count+1 map and leaves the receiver untouched; measured:
/// `Map::has_key(m, "a")` is false after `let m2 = Map::set(m, "a", 1)`), so
/// aliases of one empty `Map::new()` binding do NOT share a live value slot.
/// Value-restricting Map would mis-reject
/// `let e = Map::new(); Map::set(e, "i", 1); Map::set(e, "s", "x")` (two
/// independent derived maps). Generalizing the empty literal's fresh slot is
/// therefore sound; maps whose slot is already CONCRETE (from_pairs values,
/// annotations, a set-chain's returned type) keep the #983 value check.
fn is_array_builder_head(t: Type) -> Bool {
  match t {
    CtNamed(n, targs) => n == "ArrayBuilder" && Array::length(targs) == 1,
    _ => false
  }
}

/// #1081 step 3 Phase B: true when a `TaskGroup[r]` / `TaskHandle[r,_]` /
/// `Sender[r,_]` / `Receiver[r,_]` region-tagged endpoint occurs anywhere in
/// the value's type. Generalizing a `let`-bound endpoint (ordinary
/// Hindley-Milner let-polymorphism, `generalize`) would sever its region
/// argument from the skolem `TaskGroup::run` minted -- EVERY later reference
/// re-instantiates a FRESH, unconnected region var, so `check_spawnable_
/// captures`'s same-region comparison (checker_spawnable.vibe) could never
/// see two endpoints from the same nursery as equal. Same value-restriction
/// shape as `is_array_builder_ty` right below (a mutable container has the
/// identical "generalizing loses the identity a later use needs" problem);
/// bind the monotype instead.
export fn is_region_tagged_ty(t: Type) -> Bool {
  match t {
    CtNamed(n, targs) => if n == "TaskGroup" && Array::length(targs) == 2 {
      true
    } else if (n == "TaskHandle" || n == "Sender" || n == "Receiver") && Array::length(targs) == 3 {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(targs) && !found {
        found = is_region_tagged_ty(Array::get(targs, i))
        i = i + 1
      }
      found
    },
    CtArray(e) => is_region_tagged_ty(e),
    CtOption(e) => is_region_tagged_ty(e),
    CtTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) && !found {
        found = is_region_tagged_ty(Array::get(elems, i))
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #938 value-restriction predicate (Codex P1 on #977): true when a builder
/// occurs ANYWHERE in the value's type reachable without crossing a function
/// boundary — `(ArrayBuilder::new(), 0)`, `[ArrayBuilder::new()]`,
/// `Some(ArrayBuilder::new())` all alias ONE live builder, so their element
/// vars must stay un-quantified exactly like a bare builder's (a root-only
/// check let each lookup of the tuple re-instantiate a fresh element slot and
/// mixed pushes type-checked again). CtFn is deliberately NOT descended:
/// a function value creates a NEW builder per call, so generalizing
/// `() -> ArrayBuilder[v]` is sound and useful.
export fn is_array_builder_ty(t: Type) -> Bool {
  if is_array_builder_head(t) {
    true
  } else {
    match t {
      CtArray(e) => is_array_builder_ty(e),
      CtOption(e) => is_array_builder_ty(e),
      CtTuple(elems) => {
        let mut i = 0
        let mut found = false
        while i < Array::length(elems) && !found {
          found = is_array_builder_ty(Array::get(elems, i))
          i = i + 1
        }
        found
      },
      CtNamed(_, targs) => {
        let mut i = 0
        let mut found = false
        while i < Array::length(targs) && !found {
          found = is_array_builder_ty(Array::get(targs, i))
          i = i + 1
        }
        found
      },
      _ => false
    }
  }
}

fn direct_builtin_return(name: String) -> Option[Type] {
  if name == "Bytes::length" {
    Some(CtInt)
  }
  else if name == "iter_length" || name == "String::iter_length" || name == "Map::iter_length" {
    Some(CtInt)
  }
  else if name == "Array::length" {
    Some(CtInt)
  }
  else if name == "FixedArray::length" || name == "Int64Array::length" {
    Some(CtInt)
  }
  else if name == "String::length" {
    Some(CtInt)
  }
  else if name == "Bytes::get" || name == "String::index_of" || name == "String::char_code_at" || name == "String::last_index_of" || name == "Char::to_int" || name == "Double::to_int" || name == "Double::to_i64_bits" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" || name == "Env::args_len" || name == "Stdin::read_char" || name == "Int64Array::get" {
    Some(CtInt)
  }
  else if name == "String::equals" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "Array::any" || name == "Array::all" || name == "Array::contains" || name == "Map::has_key" || name == "map_has" || name == "MapBuilder::has_key" || name == "Path::is_absolute" || name == "Fs::exists" || name == "Fs::is_dir" || name == "Fs::is_file" || name == "eq" || name == "not" {
    Some(CtBool)
  }
  else if name == "String::concat" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::join" || name == "Array::join" || name == "Path::to_string" || name == "Path::resolve" || name == "PromptText::new" || name == "Stdin::read_stream" || name == "Env::get" || name == "Env::args_get" || name == "Fs::read_file" || name == "Fs::getcwd" || name == "sh" || name == "Lines::stringify" || name == "Llm::complete" || name == "Rlm::run" || name == "Rlm::finalize" || name == "__to_string" {
    Some(CtString)
  }
  else if name == "__len" {
    Some(CtInt)
  }
  else if name == "String::iter_get" {
    Some(CtInt)
  }
  else if name == "iter_get" || name == "Map::iter_get" || name == "iter_require" || name == "__neg" {
    Some(CtUnknown)
  }
  else if name == "Bytes::new" || name == "Bytes::concat" || name == "Bytes::slice" || name == "Bytes::from_array" || name == "Fs::read_bytes" {
    Some(CtBytes)
  }
  else if name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::foreach" || name == "FixedArray::set" || name == "FixedArray::blit" || name == "FixedArray::unsafe_set" || name == "Int64Array::set" || name == "Bytes::set" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "Stdout::write_char" || name == "Stdout::write_stream" || name == "sleep" || name == "Fs::copy" || name == "Fs::chdir" || name == "Fs::mkdir" || name == "Fs::mkdir_p" || name == "Fs::append" || name == "Fs::remove" || name == "Fs::rename" || name == "Fs::write_file" || name == "Fs::write_bytes" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" || name == "__set_field" {
    Some(CtUnit)
  }
  else if name == "Double::from_i64_bits" || name == "Int::to_double" || name == "Double::to_float" || name == "Float::to_double" {
    Some(CtDouble)
  }
  else if name == "Char::from_int" {
    Some(CtChar)
  }
  else if name == "Bytes::to_array" || name == "Int64Array::make" {
    Some(CtArray(CtInt))
  }
  else if name == "Map::keys" || name == "sh_lines" || name == "Lines::parse" {
    Some(CtArray(CtString))
  }
  else if name == "Array::slice" || name == "Array::concat" || name == "Array::filter" || name == "Array::reverse" || name == "Array::sort" || name == "FixedArray::make" {
    Some(CtArray(CtUnknown))
  }
  else if name == "Some" || name == "Array::find" || name == "MapBuilder::get" {
    Some(CtOption(CtUnknown))
  }
  else {
    None
  }
}

fn direct_call_return(env: TypeEnv, name: String) -> Option[Type] {
  match env_lookup(env, name) {
    Some(_) => None,
    None => direct_builtin_return(name)
  }
}

/// Expected TOP-LEVEL head-kind (see `head_kind`) of a builtin's FIRST argument,
/// for the container/string builtins whose receiver head is unambiguous. 0 means
/// "unchecked". Used to catch `Array::length(5)` / `String::length(5)` etc. on
/// the direct-call fast path WITHOUT a per-call `lookup_builtin` (the #626
/// seed-heap OOM constraint). Only entries whose first-arg head is certain are
/// listed; anything else returns 0 (tolerated).
fn builtin_first_arg_head(name: String) -> Int {
  if name == "Array::length" || name == "Array::get" || name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::slice" || name == "Array::concat" || name == "Array::reverse" || name == "Array::truncate" || name == "Array::foreach" || name == "Array::contains" || name == "Array::any" || name == "Array::all" || name == "Array::find" || name == "Array::filter" {
    9
  } else if name == "String::length" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::index_of" || name == "String::last_index_of" || name == "String::char_code_at" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" || name == "String::concat" {
    4
  } else if name == "Bytes::length" || name == "Bytes::get" || name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::to_array" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" {
    7
  } else if name == "Int64Array::make" || name == "FixedArray::make" {
    // #989 review: the make length is arg 0, so the rest-position table
    // never sees it — `Int64Array::make("4", 0)` compiled with the String
    // as the loop bound. Both makes take a certain Int first.
    1
  } else {
    0
  }
}

/// Expected head-kind for argument position `i` (i >= 1) of fixed-signature
/// builtins, mirroring `builtin_first_arg_head` for the non-receiver args.
/// `direct_call_return` types these polymorphically, so passing e.g. an Int as
/// the second arg of `String::concat`, or a String as the index of
/// `String::substring`, slipped through. 0 = tolerate (no certain head). Only
/// monomorphic, non-callback positions are listed (so HOF args like Array::map's
/// function stay untouched — those need real signature inference, not a head).
fn builtin_arg_head_rest(name: String, i: Int) -> Int {
  // String head = 4, Int head = 1, Bytes head = 7 (see head_kind).
  if name == "String::concat" {
    if i == 1 {
      4
    } else {
      0
    }
  } else if name == "String::index_of" || name == "String::last_index_of" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" {
    if i == 1 {
      4
    } else {
      0
    }
  } else if name == "String::substring" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "String::char_code_at" {
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Bytes::get" || name == "Bytes::push" {
    // #985: Bytes::push's pushed byte (Int) was unlisted, so
    // `Bytes::push(b, "hello")` compiled clean and wrote a garbage byte.
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::fill" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "Bytes::blit" {
    // blit(dst: Bytes, src: Bytes, src_off: Int, len: Int)
    if i == 1 {
      7
    } else if i == 2 || i == 3 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::get" {
    // #985: the Int64Array positions were never listed —
    // `Int64Array::set(w, 0, "hi")` wrote a String pointer into an i64 slot.
    if i == 1 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::set" {
    if i == 1 || i == 2 {
      1
    } else {
      0
    }
  } else if name == "Int64Array::make" {
    if i == 1 {
      1
    } else {
      0
    }
  } else {
    0
  }
}

/// Fixed argument COUNT for direct-path builtins (-1 = unchecked). The direct
/// fast path types the call by name alone (the #626 seed-heap constraint rules
/// out a per-call `lookup_builtin`), so a wrong argument count was silently
/// accepted — and the linear backend then emitted the surplus operands straight
/// into the wasm body (`Bytes::new(3)` left a value stranded on the stack and
/// the module failed validation only at instantiation). Only builtins whose
/// arity is certain are listed; anything variadic-ish or unsure stays -1.
/// `Bytes::new` is handled separately (0 or 1 capacity arg).
fn builtin_fixed_arity(name: String) -> Int {
  if name == "Array::length" || name == "Array::reverse" || name == "String::length" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::iter_length" || name == "Bytes::length" || name == "Bytes::to_array" || name == "Bytes::from_array" || name == "Map::keys" || name == "Map::iter_length" || name == "Char::to_int" || name == "Char::from_int" || name == "Double::to_int" || name == "Double::to_i64_bits" || name == "Double::from_i64_bits" || name == "Int::to_double" || name == "not" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "__to_string" || name == "FixedArray::length" || name == "Int64Array::length" {
    1
  } else if name == "Array::get" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::concat" || name == "Array::contains" || name == "Array::any" || name == "Array::all" || name == "Array::find" || name == "Array::filter" || name == "Array::join" || name == "Array::foreach" || name == "String::equals" || name == "String::concat" || name == "String::char_code_at" || name == "String::index_of" || name == "String::last_index_of" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "String::split" || name == "String::join" || name == "String::iter_get" || name == "Bytes::get" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::concat" || name == "Map::has_key" || name == "map_has" || name == "MapBuilder::has_key" || name == "MapBuilder::get" || name == "eq" || name == "assert_eq" || name == "FixedArray::get" || name == "FixedArray::make" || name == "Int64Array::get" || name == "Int64Array::make" {
    2
  } else if name == "Array::set" || name == "Array::slice" || name == "String::substring" || name == "Bytes::set" || name == "Bytes::slice" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "FixedArray::set" || name == "FixedArray::unsafe_set" || name == "Int64Array::set" {
    3
  } else if name == "Bytes::blit" {
    4
  } else if name == "FixedArray::blit" {
    5
  } else {
    0 - 1
  }
}

/// Check a higher-order builtin's callback parameter against the type it will be
/// fed. `recv_ty` / `fn_ty` are already subst-applied; when the receiver is a
/// concrete `CtArray(elem)` and the callback is a `CtFn` with a parameter at
/// `pidx`, require `elem` to be assignable to that parameter type. Ground-gated
/// via check_assignable, so an unannotated callback param (a fresh CtVar that
/// the body never pins to a concrete type) stays tolerant — only an explicit
/// wrong annotation (or a body that pins the param to a mismatching concrete
/// type) is rejected. `expected_ty` is the param (the slot), `elem` the value.
fn check_hof_param_vs_elem(recv_ty: Type, fn_ty: Type, pidx: Int, s: Subst, errors: Array[String], msg: String) -> Subst {
  match recv_ty {
    CtArray(elem) => match fn_ty {
      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {
        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)
      } else {
        s
      },
      _ => s
    },
    _ => s
  }
}

/// Require two array operands to share an element type (Array::concat /
/// Array::push_all). `a_app` / `b_app` are already subst-applied; when both are
/// concrete `CtArray`, ground-gated check_assignable compares their element
/// types (generic / var operands stay tolerant).
fn check_two_array_elems(a_app: Type, b_app: Type, s: Subst, errors: Array[String], msg: String) -> Subst {
  match a_app {
    CtArray(ea) => match b_app {
      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),
      _ => s
    },
    _ => s
  }
}

/// Declared type of a (monomorphic) struct field by name, or None if the struct
/// or field is unknown. Used to recognise a field-stored-function call
/// `b.f(args)` when no method/builtin `T::f` exists.
fn struct_field_type(defs: Array[TypeDef], sname: String, field: String) -> Option[Type] {
  match find_typedef(defs, sname) {
    Some(td) => match td {
      TDStruct(_, fields, _, _) => {
        let rec go: (Int) -> Option[Type] = (i) -> {
          if i >= Array::length(fields) {
            None
          } else {
            let (fname, ftype) = Array::get(fields, i)
            if fname == field {
              Some(ftype)
            } else {
              go(i + 1)
            }
          }
        }
        go(0)
      },
      _ => None
    },
    None => None
  }
}

/// #829: instantiate a declared field type against the receiver's actual type
/// arguments (`CtNamed(S, targs)`). Substitutes only when the declared param
/// list and the argument list line up; otherwise the raw (rigid) type is kept,
/// which downstream checks tolerate exactly as before.
fn inst_struct_field_ty(ft: Type, tparams: Array[String], targs: Array[Type]) -> Type {
  if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {
    subst_type_params(ft, tparams, targs)
  } else {
    ft
  }
}

/// #829: field type of a struct-typed receiver, instantiated when the receiver
/// is an applied generic struct. `CtStruct` receivers keep the raw field type
/// (monomorphic structs have no params to substitute). None when the receiver
/// is not a known struct or the field does not exist.
fn receiver_struct_field_type(defs: Array[TypeDef], recv: Type, field: String) -> Option[Type] {
  match recv {
    CtStruct(sname) => struct_field_type(defs, sname, field),
    CtNamed(sname, targs) => match find_typedef(defs, sname) {
      Some(td) => match td {
        TDStruct(_, _, _, tparams) => match struct_field_type(defs, sname, field) {
          Some(ft) => Some(inst_struct_field_ty(ft, tparams, targs)),
          None => None
        },
        _ => None
      },
      None => None
    },
    _ => None
  }
}

fn is_logic_binop(op: String) -> Bool {
  op == "&&"
  || op == "||"
}

fn is_order_binop(op: String) -> Bool {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}

fn type_name_prefix(ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}

/// #994: builtin data types that can appear as a dot-call RECEIVER's checked
/// type (via `type_name_prefix` or a `CtNamed` head). An unresolved method on
/// one of these is definitely bogus -- there is no "it might be an imported
/// user type with the method defined elsewhere" escape hatch for a builtin.
/// Deliberately excludes namespace-only builtins (Fs, Http, Socket, Stdout,
/// ...) that are never a receiver VALUE's type, only ever called by
/// `Module::fn` name -- including them here would risk false positives on
/// legitimate qualified-import shortcut calls that happen to share a method
/// name.
/// #994 review: `Bool`/`Option`/`Result` are excluded even though they are
/// builtin heads. lib/@vibe/prelude/{bool,option,result}.vibe extend them
/// with real top-level `fn Bool::to_int` etc., and the *_type_import_test.vibe
/// fixtures use the "import just the type, dot-call resolves the method via
/// the merged program" idiom the #953 comment documents -- in an isolated
/// per-file check (as these unit tests exercise) the extension fn isn't in
/// `env` yet, so gating on this prefix here regressed 4 passing tests
/// (`no method ... on Bool/Option/Result`) that only compile correctly once
/// merged. No equivalent extension-via-type-import convention exists for the
/// container types below (grep confirms no prelude file extends Array/Bytes/
/// Map/...), so they keep the stricter check.
/// #994 follow-up (Codex P1): `Int`/`Double`/`Char` were missing here even
/// though `lib/@vibe/prelude/{int,double}.vibe` extend them with real fns
/// (`Int::abs`, `Double::ceil`, ...) the same way Bool/Option/Result do.
/// Unlike Bool/Option/Result, no test anywhere dot-calls one of those
/// extension fns (grep across the repo for `.abs(`/`.gcd(`/`.ceil(`/... on a
/// bare int/double/char value found zero hits), so there is no "import type
/// only, resolve via merge" idiom to protect for these three -- adding them
/// carries none of the regression risk that excluded Bool/Option/Result.
/// Confirmed the gap empirically: `n.to_string()` for `n: Int` checks and
/// "succeeds" (no parsed `fn Int::to_string` exists anywhere, only a
/// checker-only `lookup_builtin` signature), then codegen dies with
/// "unknown struct field: to_string" -- the exact class of bug #994 exists
/// to catch.
fn is_known_builtin_receiver_prefix(prefix: String) -> Bool {
  prefix == "String"
  || prefix == "Bytes"
  || prefix == "Array"
  || prefix == "Map"
  || prefix == "MapBuilder"
  || prefix == "Int64Array"
  || prefix == "FixedArray"
  || prefix == "ArrayBuilder"
  || prefix == "StringBuilder"
  || prefix == "Int"
  || prefix == "Double"
  || prefix == "Char"
}

fn is_equality_binop(op: String) -> Bool {
  op == "=="
  || op == "!="
}

fn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}

fn unify_same_binop_operands(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {
  match unify(left_ty, right_ty, s) {
    Some(s1) => Some((subst_apply(s1, left_ty), s1)),
    None => None
  }
}

fn infer_named_trait_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {
  match unify_same_binop_operands(left_ty, right_ty, s) {
    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {
      Some((resolved, s1))
    } else {
      None
    },
    None => None
  }
}

fn binop_str_arr_contains(arr: Array[String], val: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

/// #952: a bound generic type parameter (`[T: Ord]` / `[T: Add]`) is checked
/// as a plain `CtVar(id)` carrying its trait bounds in the current `Subst`
/// (recorded by `subst_add_bound` when the `EFn` type-param header is
/// processed, read back via `subst_bounds_for`). The order/`+` binop paths
/// below try `unify_binop_candidate(_, _, CtInt, s)` FIRST as a fast path for
/// ordinary (unbound) local-var inference -- but `unify` treats ANY unbound
/// `CtVar` as freely unifiable with `CtInt` (no bound check), so that fast
/// path silently binds T := Int the first time `<`/`>`/`+` appears in a bound
/// generic function's OWN body, before any call site is even seen. That
/// poisons the substitution used to `generalize` the function's signature,
/// turning `fn my_lt[T: Ord](a: T, b: T) -> Bool { a < b }` into a
/// monomorphic `(Int, Int) -> Bool` -- so calling it with String args later
/// fails with "expected Int, got String" even though `impl Ord for String`
/// exists. `==`/`!=` never hit this because `is_equality_binop` only unifies
/// the two operands against EACH OTHER (never against a concrete target
/// type), so a bound CtVar is never concretized there.
///
/// Fix: when either operand resolves (post-subst) to a CtVar whose recorded
/// bounds already include the needed trait, dispatch directly here -- unify
/// the operands against EACH OTHER only (mirroring the Eq path) and skip the
/// CtInt/CtDouble fast paths entirely, so the type parameter stays
/// rigid/polymorphic through the rest of the definition check. An ordinary
/// unbound CtVar (no recorded bounds -- the common unannotated-local-var
/// inference case, e.g. `fn f(x) { x < 5 }`) is untouched: `rigid_bound_operand`
/// returns false for it, so it still takes the existing
/// CtInt/CtDouble/struct-Ord(Add) fast path exactly as before.
fn rigid_bound_operand(ty: Type, s: Subst, trait_name: String) -> Bool {
  match subst_apply(s, ty) {
    CtVar(id) => binop_str_arr_contains(subst_bounds_for(s, id), trait_name),
    _ => false
  }
}

/// Bounds recorded on a var the operand-vs-operand unify just eliminated
/// (post-subst it is no longer a CtVar) would otherwise be dropped: in
/// `fn bad[T: Ord, U](a: T, b: U) { a < b }` unify may bind T := U, leaving
/// the surviving U with NO recorded Ord bound, so generalize exports an
/// unbounded (U, U) -> Bool and `bad(true, false)` sails through the
/// call-site bound check. Collect each operand's pre-unify var bounds so
/// they can be re-recorded on whatever survives.
fn operand_var_bounds(ty: Type, s: Subst) -> Array[String] {
  match subst_apply(s, ty) {
    CtVar(id) => subst_bounds_for(s, id),
    _ => array_empty()
  }
}

fn rigid_trait_bound_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {
  if rigid_bound_operand(left_ty, s, trait_name) || rigid_bound_operand(right_ty, s, trait_name) {
    let lb = operand_var_bounds(left_ty, s)
    let rb = operand_var_bounds(right_ty, s)
    match unify_same_binop_operands(left_ty, right_ty, s) {
      Some((resolved, s1)) => match subst_apply(s1, resolved) {
        CtVar(id) => {
          // Var survivor: transfer every bound either operand carried that
          // the survivor does not already record, so generalize keeps them.
          let have = subst_bounds_for(s1, id)
          let missing = ArrayBuilder::new()
          let mut i = 0
          while i < Array::length(lb) + Array::length(rb) {
            let cand = if i < Array::length(lb) {
              Array::get(lb, i)
            } else {
              Array::get(rb, i - Array::length(lb))
            }
            if !binop_str_arr_contains(have, cand) {
              // (duplicates between lb and rb are harmless -- bound lookups
              // only ever ask "contains", never count)
              ArrayBuilder::push(missing, cand)
            } else {
              ()
            }
            i = i + 1
          }
          let missing_arr = ArrayBuilder::freeze(missing)
          if Array::length(missing_arr) > 0 {
            Some((resolved, subst_add_bound(s1, id, missing_arr)))
          } else {
            Some((resolved, s1))
          }
        },
        other => if type_implements_trait(env, s1, other, trait_name) {
          // Concrete survivor (e.g. `a < "x"` forcing T := String): only
          // accept when it actually implements the required trait --
          // mirroring infer_named_trait_binop, which handled this shape
          // before the rigid pre-step existed.
          Some((resolved, s1))
        } else {
          None
        }
      },
      None => None
    }
  } else {
    None
  }
}

fn infer_binop_type(op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst) {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Bool")))
        (CtUnknown, s)
      }
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => {
        // Tolerate unresolved NOMINAL operands: a generic `[T]` callee's
        // result reaches here as a rigid CtNamed type param when call-site
        // instantiation can't ground it (#829) — e.g.
        // `Array::get(ArrayView::to_array(v), 0) == 20`. Pre-fn-migration
        // these positions were CtUnknown, so erroring regressed working
        // code. Fully concrete mismatches still error.
        let eq_l = subst_apply(s, left_ty)
        let eq_r = subst_apply(s, right_ty)
        let eq_has_named = match eq_l {
          CtNamed(_, _) => true,
          _ => match eq_r {
            CtNamed(_, _) => true,
            _ => false
          }
        }
        if eq_has_named {
          (CtBool, s)
        } else {
          Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must have same type")))
          (CtUnknown, s)
        }
      }
    }
  }
  else if is_order_binop(op) {
    match rigid_trait_bound_binop(env, left_ty, right_ty, "Ord", s) {
      Some((_, s1)) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
        Some(s1) => (CtBool, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
          Some(s1) => (CtBool, s1),
          None => match infer_named_trait_binop(env, left_ty, right_ty, "Ord", s) {
            Some((_, s1)) => (CtBool, s1),
            None => {
              Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
              (CtUnknown, s)
            }
          }
        }
      }
    }
  }
  else if op == "+" {
    match rigid_trait_bound_binop(env, left_ty, right_ty, "Add", s) {
      Some((resolved, s1)) => (resolved, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
        Some(s1) => (CtInt, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
          Some(s1) => (CtDouble, s1),
          None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
            Some(s1) => (CtString, s1),
            None => match infer_named_trait_binop(env, left_ty, right_ty, "Add", s) {
              Some((resolved, s1)) => (resolved, s1),
              None => {
                Array::push(errors, "type mismatch in '+': operands must be Int, Double, or String")
                (CtUnknown, s)
              }
            }
          }
        }
      }
    }
  }
  else if op == "-"
  || op == "*"
  || op == "/" {
    let trait_name = if op == "-" {
      "Sub"
    } else if op == "*" {
      "Mul"
    } else {
      "Div"
    }
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {
          Some((resolved, s1)) => (resolved, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, "type mismatch in '%': operands must be Int")
        (CtUnknown, s)
      }
    }
  }
  else if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int")))
        (CtUnknown, s)
      }
    }
  }
  else {
    Array::push(errors, String::concat("unknown operator: ", op))
    (CtUnknown, s)
  }
}

/// Recursively replace type-parameter names (those bound to a CtVar in `env`)
/// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type
/// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and
/// their args recursed. This lets a generic annotation like `Map[String, V]`
/// resolve its inner `V` to the function's quantified var, so call sites can
/// instantiate it (the previous shallow lookup only handled the outermost name).
fn resolve_tparams_in(ty: Type, env: TypeEnv) -> Type {
  match ty {
    CtNamed(name, args) => {
      let ra = for a in args {
        resolve_tparams_in(a, env)
      }
      match env_lookup(env, name) {
        Some(t) => match t {
          CtVar(_) => t,
          _ => CtNamed(name, ra)
        },
        None => CtNamed(name, ra)
      }
    },
    CtArray(e) => CtArray(resolve_tparams_in(e, env)),
    CtOption(e) => CtOption(resolve_tparams_in(e, env)),
    CtTuple(es) => CtTuple(for e in es {
      resolve_tparams_in(e, env)
    }),
    CtFn(ps, ret, eff) => {
      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = array_empty()
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, resolve_tparams_in(Array::get(types, i), env))
          i = i + 1
        }
        out
      }
      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)
    },
    _ => ty
  }
}

/// Record a call-site node's (raw, pre-final-subst) result type `ty` keyed by
/// its real source char offset `call_off`, for typed-hover (vibe type-at) on
/// `foo(x)` / `obj.method(x)`, then return `ty` unchanged so it can be dropped
/// into the call-result tuple in place. Synthetic calls (call_off < 0) skip the
/// push. Used at the ECall result sites (NOT by wrapping the giant ECall match,
/// which the bootstrap seed parser cannot reparse when that match is nested one
/// level deeper — only the interior result types are tagged).
fn tab_call_ty(tytab: Array[(Int, Type)], call_off: Int, ty: Type) -> Type {
  if call_off >= 0 {
    Array::push(tytab, (call_off, ty))
  } else {
    ()
  }
  ty
}

/// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`
/// chains) instead of recursing into each `body`, so a long function body — a
/// deep right-nested `let` chain — does not exhaust the wasm call stack during
/// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a
/// forward reference). Semantics are identical to the recursive arms: each `let`
/// binds its (generalized, or raw for `mut`) value type into the env seen by the
/// rest of the spine, and the final non-spine expression's result is returned.
fn check_seq_spine(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) {
  let mut cur = expr
  let mut cenv = env
  let mut s1 = s
  let mut c1 = c
  let mut done = false
  let mut result = (CtUnit, s, c)
  while !done {
    match cur {
      ESeq(left, right) => {
        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        cur = right
      },
      ELet(name, val, body, _) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        // #938 value restriction: a builder is a MUTABLE container, so its
        // element var must stay un-quantified — generalizing
        // `CtNamed("ArrayBuilder", [v])` would re-instantiate a fresh v at
        // every use and pushes could never constrain each other (the exact
        // hole this issue is about). Bind the monotype instead.
        let vt_resolved = subst_apply(ns, vt)
        let gen = if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {
          vt
        } else {
          generalize(ns, vt)
        }
        cenv = env_bind(cenv, name, gen)
        s1 = ns
        c1 = nc
        cur = body
      },
      ELetMut(name, val, body, _) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        // `loop` desugars to `let mut __loop_result = 0; while true { ...
        // __loop_result = <break value> ... }` (parser_expr_primary.vibe) —
        // the 0 is only a slot placeholder, but binding its CtInt here pinned
        // every loop's result to Int, so `break((a, b))` / `break(acc)` with a
        // tuple/String errored "assignment type mismatch for __loop_result".
        // Bind the marker to a fresh var instead; the first assignment (break)
        // instantiates it via check_assignable's unify.
        if name == "__loop_result" {
          let (lr_tv, nc2) = fresh_var(nc)
          cenv = env_bind(cenv, name, lr_tv)
          c1 = nc2
        } else {
          cenv = env_bind(cenv, name, vt)
          c1 = nc
        }
        s1 = ns
        cur = body
      },
      ELetRec(name, val, body) => {
        let (tv, c1b) = fresh_var(c1)
        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)
        let s2 = match unify(tv, vt, ns) {
          Some(su) => su,
          None => ns
        }
        let gen = generalize(s2, tv)
        cenv = env_bind(cenv, name, gen)
        s1 = s2
        c1 = nc
        cur = body
      },
      _ => {
        result = ce(cur, cenv, defs, s1, c1, errors, tytab)
        done = true
      }
    }
  }
  result
}

/// #418: enforce that `obj.field = x` (which desugars to
/// `__set_field(obj, "field", x)`) only targets a `mut`-declared struct field.
/// Runs as a pure side-effect over a *throwaway* errors/tytab so it never
/// perturbs the main type/subst flow — it only type-checks `obj` to learn its
/// struct name, looks up that struct's `mut` field set, and pushes a single
/// diagnostic to the real `errors` when the written field is not `mut`.
fn field_write_mut_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {
  if name == "__set_field" && Array::length(args) == 3 {
    match Array::get(args, 1) {
      EString(field) => {
        let throwaway = array_empty()
        let throwtab = array_empty()
        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
        // #829: also recognise an INSTANTIATED generic struct receiver
        // (`CtNamed(S, targs)`), so `mut`-field enforcement and the written-
        // value type check cover generic structs too.
        let recv_struct = match subst_apply(s, obj_ty) {
          CtStruct(sn) => Some((sn, array_empty())),
          CtNamed(sn, sargs) => Some((sn, sargs)),
          _ => None
        }
        match recv_struct {
          Some(recv_info) => {
            let (sname, recv_targs) = recv_info
            match find_typedef(defs, sname) {
              Some(TDStruct(_, dfields, mut_names, s_tparams)) => {
                let mut found = false
                let mut i = 0
                while i < Array::length(mut_names) {
                  if Array::get(mut_names, i) == field {
                    found = true
                  } else {
                    ()
                  }
                  i = i + 1
                }
                if found {
                  ()
                } else {
                  Array::push(errors, String::concat("cannot assign to non-`mut` field `", String::concat(field, String::concat("` of struct ", sname))))
                }
                // The written value must match the field's declared type
                // (`p.x = "s"` for `x: Int` was accepted). Ground-gated via
                // check_assignable so a generic field type is not over-rejected.
                let mut fty = CtUnknown
                let mut has_field = false
                let mut fi = 0
                while fi < Array::length(dfields) {
                  let (fn2, ft) = Array::get(dfields, fi)
                  if fn2 == field {
                    fty = ft
                    has_field = true
                  } else {
                    ()
                  }
                  fi = fi + 1
                }
                if has_field {
                  let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)
                  // #829: instantiate a generic field's declared type from the
                  // receiver's type args so the written value is checked against
                  // the CONCRETE field type; a non-applied receiver keeps the
                  // raw (rigid) type, which check_assignable tolerates.
                  let inst_fty = inst_struct_field_ty(fty, s_tparams, recv_targs)
                  let _ = check_assignable(subst_apply(s, inst_fty), subst_apply(s, val_ty), s, errors, String::concat("type mismatch writing field `", String::concat(field, "`")), 0 - 1)
                  ()
                } else {
                  ()
                }
              },
              _ => ()
            }
          },
          None => ()
        }
      },
      _ => ()
    }
  } else {
    ()
  }
}

/// `obj[i]` desugars to `__index(obj, i)`, typed fully polymorphically, so
/// indexing a non-indexable scalar (`let n = 5; n[0]`) was accepted silently.
/// Report when `obj` resolves to a concrete scalar that cannot be indexed
/// (Array/String/Bytes ARE indexable; type vars / unknown / named stay
/// tolerated). Pure side-effect over a throwaway error/type table.
fn index_target_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {
  if name == "__index" && Array::length(args) == 2 {
    let throwaway = array_empty()
    let throwtab = array_empty()
    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
    let resolved_obj = subst_apply(s, obj_ty)
    let not_indexable = match resolved_obj {
      CtInt => true,
      CtDouble => true,
      CtBool => true,
      CtChar => true,
      CtUnit => true,
      _ => false
    }
    if not_indexable {
      Array::push(errors, "cannot index a non-indexable value (expected Array, String, or Bytes)")
    } else {
      // For an indexable receiver (Array/String/Bytes), the subscript must be an
      // Int — `a["x"]` was accepted silently. Only flag a concrete non-Int index;
      // type vars / unknown / named stay tolerated.
      let indexable = match resolved_obj {
        CtArray(_) => true,
        CtString => true,
        CtBytes => true,
        _ => false
      }
      if indexable {
        let throwaway2 = array_empty()
        let throwtab2 = array_empty()
        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)
        let bad_index = match subst_apply(s, idx_ty) {
          CtInt => false,
          _ => type_is_ground(subst_apply(s, idx_ty))
        }
        if bad_index {
          Array::push(errors, "index must be an Int")
        } else {
          ()
        }
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

/// An arm pattern is a CATCH-ALL (makes a match exhaustive regardless of which
/// constructors precede it) when it is a wildcard or a bare binding. `POr` is a
/// catch-all if either side is.
fn pat_is_catchall(pat: Pat) -> Bool {
  match pat {
    PWild => true,
    PBind(_) => true,
    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),
    _ => false
  }
}

/// Collect the constructor names a pattern matches at the TOP level (for enum
/// exhaustiveness). `POr` contributes from both sides; other patterns none.
/// #940 Phase 1: Bool-literal coverage names (`"true"` / `"false"`) for the
/// flat Bool exhaustiveness check, walking or-patterns like
/// collect_ctor_names_into does for ctor names.
fn collect_bool_pats_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBool(b) => if b {
      Array::push(acc, "true")
    } else {
      Array::push(acc, "false")
    },
    POr(l, r) => {
      collect_bool_pats_into(l, acc)
      collect_bool_pats_into(r, acc)
    },
    _ => ()
  }
}

fn flat_names_contain(names: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if Array::get(names, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn collect_ctor_names_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PCtor(name, _) => Array::push(acc, name),
    POr(l, r) => {
      collect_ctor_names_into(l, acc)
      collect_ctor_names_into(r, acc)
    },
    _ => ()
  }
}

/// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit
/// index string. Returns None for a non-numeric field (a real `.method`/.field)
/// so only genuine tuple projections are bounds-checked.
fn parse_tuple_index(s: String) -> Option[Int] {
  let len = String::length(s)
  if len == 0 {
    None
  } else {
    let mut i = 0
    let mut val = 0
    let mut ok = true
    while i < len {
      let cc = String::char_code_at(s, i)
      if cc >= 48 && cc <= 57 {
        val = val * 10 + (cc - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(val)
    } else {
      None
    }
  }
}

/// #813: bind a pattern's binders to CtUnknown for the resume-value walk —
/// the walker re-checks resume arguments outside the main inference flow, so
/// locally-bound names (match arms, lets) must be in scope or a legitimate
/// `Read() => { let v = ...; resume(v) }` reports a false `unknown name: v`.
/// CtUnknown keeps the value check ground-gated (tolerant) for such names.
fn resume_walk_bind_pat(p: Pat, env: TypeEnv) -> TypeEnv {
  match p {
    PBind(n) => env_bind(env, n, CtUnknown),
    PCtor(_, ps) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(ps) {
        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)
        pi = pi + 1
      }
      env1
    },
    PTuple(ps) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(ps) {
        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)
        pi = pi + 1
      }
      env1
    },
    POr(a, b) => resume_walk_bind_pat(b, resume_walk_bind_pat(a, env)),
    PStruct(_, fields) => {
      let mut env1 = env
      let mut pi = 0
      while pi < Array::length(fields) {
        let (_, fp) = Array::get(fields, pi)
        env1 = resume_walk_bind_pat(fp, env1)
        pi = pi + 1
      }
      env1
    },
    _ => env
  }
}

/// #813: walk a handler arm body for `resume(x)` calls and check x against the
/// op's declared return type (ground-gated via check_assignable). Nested
/// EHandle subtrees are skipped entirely — their resumes belong to the inner
/// handler's own arms. Runs on a throwaway lane after the arm body was checked,
/// so it only ADDS diagnostics (main inference flow untouched). Local binders
/// (let / let mut / let rec / match arms / for-in vars) are bound to CtUnknown
/// while descending so resume(local) doesn't report a false `unknown name`.
/// #640: walk a `with Error` handler arm body and reject any `resume(...)`
/// call. `Error` is non-resumable — `throw` / `perform Error::Throw` unwind
/// the stack for good (no perform-counter/memo replay machinery runs for tag
/// 2), so a resume in an Error arm never resumed anything; it was silently
/// meaningless. Nested EHandle subtrees are skipped (their resumes belong to
/// the inner handler's own arms, which may be resumable effects).
fn reject_resume_in_error_arm(e: Expr, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" {
          Array::push(errors, String::concat("Error is a non-resumable effect (#640); an Error arm's value IS the handle result — remove resume(...)", off_marker(off)))
        } else {
          ()
        },
        _ => reject_resume_in_error_arm(callee, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        reject_resume_in_error_arm(Array::get(args, ri), errors)
        ri = ri + 1
      }
    },
    EHandle(_, _) => (),
    ELet(_, v, b, _) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ELetMut(_, v, b, _) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ELetRec(_, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    ESeq(a, b) => {
      reject_resume_in_error_arm(a, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EIf(cnd, t, el) => {
      reject_resume_in_error_arm(cnd, errors)
      reject_resume_in_error_arm(t, errors)
      reject_resume_in_error_arm(el, errors)
    },
    EMatch(scr, marms) => {
      reject_resume_in_error_arm(scr, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (_, mb) = Array::get(marms, mi)
        reject_resume_in_error_arm(mb, errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      reject_resume_in_error_arm(cnd, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EForIn(_, _, it, b) => {
      reject_resume_in_error_arm(it, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EBinOp(_, l, r) => {
      reject_resume_in_error_arm(l, errors)
      reject_resume_in_error_arm(r, errors)
    },
    EUnaryOp(_, inner) => reject_resume_in_error_arm(inner, errors),
    EAssign(_, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EAssignOp(_, _, v, b) => {
      reject_resume_in_error_arm(v, errors)
      reject_resume_in_error_arm(b, errors)
    },
    EFn(_, _, _, _, _, fb) => reject_resume_in_error_arm(fb, errors),
    EReturn(inner) => reject_resume_in_error_arm(inner, errors),
    EDot(obj, _, _, _) => reject_resume_in_error_arm(obj, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    // Codex P2 on #933: the catch-all silently ended the walk for these
    // recursive forms, so e.g. `Throw(_) => loop { break resume(0) }` or a
    // resume tucked into a record/map literal escaped the non-resumable
    // rejection and reached codegen's meaningless tag-1 path.
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        reject_resume_in_error_arm(fe, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      while ti < Array::length(binds) {
        let (_, be) = Array::get(binds, ti)
        reject_resume_in_error_arm(be, errors)
        ti = ti + 1
      }
      reject_resume_in_error_arm(b, errors)
    },
    ELabeledArg(_, _, inner) => reject_resume_in_error_arm(inner, errors),
    EBreak(opt) => match opt {
      Some(inner) => reject_resume_in_error_arm(inner, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_in_error_arm(Array::get(items, ti), errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        reject_resume_in_error_arm(pe, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => reject_resume_in_error_arm(inner, errors),
    _ => ()
  }
}

/// #942 (ADR-0050): is this handler-arm pattern an `Error` arm? Error arms are
/// owned by reject_resume_in_error_arm (#640), so the general resume-misuse
/// walks below leave them alone (no double report).
fn handler_arm_pat_is_error(p: Pat) -> Bool {
  match p {
    PCtor(q, _) => {
      is_exception_throw_handler_name(q)
    },
    _ => false
  }
}

/// #942 (Codex P2 on #969): does this pattern bind the name `resume`? Codegen's
/// prefer_bound_call (codegen/expr/compile_call.vibe) sends `resume(x)` to the
/// BOUND function whenever any top-level fn / local binding / binder named
/// `resume` is in scope — such calls never touch the continuation machinery,
/// so the #942 misuse walks must skip them (they ran fine pre-#942).
export fn pat_binds_resume(p: Pat) -> Bool {
  match p {
    PBind(n) => n == "resume",
    PCtor(_, ps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ps) {
        if pat_binds_resume(Array::get(ps, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PTuple(ps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ps) {
        if pat_binds_resume(Array::get(ps, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    POr(a, b) => pat_binds_resume(a) || pat_binds_resume(b),
    PStruct(_, fps) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fps) {
        let (_, fp) = Array::get(fps, i)
        if pat_binds_resume(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #942 (Codex P2): does an EFn's parameter list bind `resume`? Labeled/
/// optional params keep a trailing `~`/`?` in the raw AST name (stripped by
/// the checker/codegen before binding, same as the labeled-param handling in
/// check_expr's EFn arm above) — strip it here too so `fn f(resume~: ...)`
/// is recognized as shadowing.
fn param_base_name(raw_name: String) -> String {
  let nlen = String::length(raw_name)
  if nlen > 0 {
    let lc = String::char_code_at(raw_name, nlen - 1)
    if lc == '~' || lc == '?' {
      raw_name[0: nlen - 1]
    } else raw_name
  } else raw_name
}

fn fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if param_base_name(pn) == "resume" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #942 (ADR-0050): inside a handler arm, `resume(...)` is one-shot and must be
/// the LAST thing the arm does. Codegen compiles resume as a continuation
/// throw, so any code after it silently never runs — `let a = resume(1);
/// resume(2)` returned the first resume's flow and dropped the second on the
/// floor. Reject non-tail resume calls, mirroring the #814 rejection of the
/// k-convention non-tail continuation binder. Tail position distributes
/// through let/seq continuations and if/match branches (only one branch runs),
/// so `if c { resume(1) } else { resume(2) }` and multi-statement arms ending
/// in resume stay legal. `return resume(v)` inherits the tail flag (Codex P2
/// on #969 — return exits before anything else runs; pre-#942 it behaved
/// exactly like a plain tail resume at runtime). Loop bodies are never tail
/// (a resume there would run per iteration). EFn subtrees are skipped
/// wholesale — a resume inside a nested lambda keeps its pre-#942 acceptance.
/// A nested EHandle's handled body inherits the current tail flag (its value
/// IS the handle's value, and a lexical resume there still targets THIS arm's
/// continuation); its non-Error arms restart a fresh tail walk of their own.
/// `sh` = `resume` is shadowed by an enclosing binder (top-level fn/let,
/// local let/let-mut/let-rec, match/for/loop binders, arm payload binders):
/// codegen's prefer_bound_call routes such calls to the bound function, so
/// the tail discipline does not apply to them (Codex P2 on #969).
fn check_arm_resume_tail(e: Expr, tail: Bool, sh: Bool, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" && !tail && !sh {
          Array::push(errors, String::concat("resume(...) must be the last expression of the handler arm (tail position) — code after a resume never runs, so a bound or repeated resume is silently dropped (#942, ADR-0050)", off_marker(off)))
        } else {
          ()
        },
        _ => check_arm_resume_tail(callee, false, sh, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        check_arm_resume_tail(Array::get(args, ri), false, sh, errors)
        ri = ri + 1
      }
    },
    EHandle(body, harms) => {
      check_arm_resume_tail(body, tail, sh, errors)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (hpat, hbody) = Array::get(harms, hi)
        if handler_arm_pat_is_error(hpat) {
          ()
        } else {
          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)
        }
        hi = hi + 1
      }
    },
    ELet(ln, v, b, _) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ELetMut(ln, v, b, _) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ELetRec(ln, v, b) => {
      check_arm_resume_tail(v, false, sh || ln == "resume", errors)
      check_arm_resume_tail(b, tail, sh || ln == "resume", errors)
    },
    ESeq(a, b) => {
      check_arm_resume_tail(a, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EIf(cnd, t, el) => {
      check_arm_resume_tail(cnd, false, sh, errors)
      check_arm_resume_tail(t, tail, sh, errors)
      check_arm_resume_tail(el, tail, sh, errors)
    },
    EMatch(scr, marms) => {
      check_arm_resume_tail(scr, false, sh, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        check_arm_resume_tail(mb, tail, sh || pat_binds_resume(mp), errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      check_arm_resume_tail(cnd, false, sh, errors)
      check_arm_resume_tail(b, false, sh, errors)
    },
    EForIn(v1, v2, it, b) => {
      check_arm_resume_tail(it, false, sh, errors)
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      check_arm_resume_tail(b, false, sh || for_sh, errors)
    },
    EBinOp(_, l, r) => {
      check_arm_resume_tail(l, false, sh, errors)
      check_arm_resume_tail(r, false, sh, errors)
    },
    EUnaryOp(_, inner) => check_arm_resume_tail(inner, false, sh, errors),
    EAssign(_, v, b) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EAssignOp(_, _, v, b) => {
      check_arm_resume_tail(v, false, sh, errors)
      check_arm_resume_tail(b, tail, sh, errors)
    },
    EFn(_, _, _, _, _, _) => (),
    EReturn(inner) => check_arm_resume_tail(inner, tail, sh, errors),
    EDot(obj, _, _, _) => check_arm_resume_tail(obj, false, sh, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        check_arm_resume_tail(fe, false, sh, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      let mut loop_sh = false
      while ti < Array::length(binds) {
        let (bn, be) = Array::get(binds, ti)
        if bn == "resume" {
          loop_sh = true
        } else {
          ()
        }
        check_arm_resume_tail(be, false, sh, errors)
        ti = ti + 1
      }
      check_arm_resume_tail(b, false, sh || loop_sh, errors)
    },
    ELabeledArg(_, _, inner) => check_arm_resume_tail(inner, false, sh, errors),
    EBreak(opt) => match opt {
      Some(inner) => check_arm_resume_tail(inner, false, sh, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        check_arm_resume_tail(pe, false, sh, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => check_arm_resume_tail(inner, false, sh, errors),
    _ => ()
  }
}

/// #942 (ADR-0050): a call-position `resume(...)` OUTSIDE any handler arm has
/// no continuation to resume. Codegen emits the tag-1 continuation throw
/// unconditionally (see codegen/common_analysis — the module must stay valid),
/// so `fn f() -> Int { resume(1); 2 }` compiled and then died at runtime with
/// an unhandled wasm exception. Walk every top-level statement expression and
/// reject it in the checker instead. Only CALLS are rejected — `resume` as an
/// ordinary binding name (e.g. lib/@vibe/parser/lexer.vibe's `let resume =
/// ...`, which is passed around but never called) stays legal. On reaching an
/// EHandle, the handled body is still "outside" (a resume there is not in any
/// arm); non-Error arm bodies switch to the check_arm_resume_tail walk above,
/// and Error arms are left to reject_resume_in_error_arm (#640).
/// `sh` = `resume` is shadowed by an enclosing binder (Codex P2 on #969):
/// codegen's prefer_bound_call routes `resume(x)` to the BOUND function
/// whenever a top-level fn/let named resume, a local binding, a lambda param,
/// or a match/for/loop binder named resume is in scope — such calls ran fine
/// pre-#942 and must stay accepted. check_stmts seeds `sh` from the top-level
/// declarations (fn resume / let resume / extern / imports).
export fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, off) => if nm == "resume" && !sh {
          Array::push(errors, String::concat("resume(...) is only valid inside a handler arm of `handle ... with` — outside one there is no continuation to resume (#942, ADR-0050)", off_marker(off)))
        } else {
          ()
        },
        _ => reject_resume_outside_handler(callee, sh, errors)
      }
      let mut ri = 0
      while ri < Array::length(args) {
        reject_resume_outside_handler(Array::get(args, ri), sh, errors)
        ri = ri + 1
      }
    },
    EHandle(body, harms) => {
      reject_resume_outside_handler(body, sh, errors)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (hpat, hbody) = Array::get(harms, hi)
        if handler_arm_pat_is_error(hpat) {
          ()
        } else {
          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)
        }
        hi = hi + 1
      }
    },
    ELet(ln, v, b, _) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ELetMut(ln, v, b, _) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ELetRec(ln, v, b) => {
      reject_resume_outside_handler(v, sh || ln == "resume", errors)
      reject_resume_outside_handler(b, sh || ln == "resume", errors)
    },
    ESeq(a, b) => {
      reject_resume_outside_handler(a, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EIf(cnd, t, el) => {
      reject_resume_outside_handler(cnd, sh, errors)
      reject_resume_outside_handler(t, sh, errors)
      reject_resume_outside_handler(el, sh, errors)
    },
    EMatch(scr, marms) => {
      reject_resume_outside_handler(scr, sh, errors)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        reject_resume_outside_handler(mb, sh || pat_binds_resume(mp), errors)
        mi = mi + 1
      }
    },
    EWhile(cnd, b) => {
      reject_resume_outside_handler(cnd, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EForIn(v1, v2, it, b) => {
      reject_resume_outside_handler(it, sh, errors)
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      reject_resume_outside_handler(b, sh || for_sh, errors)
    },
    EBinOp(_, l, r) => {
      reject_resume_outside_handler(l, sh, errors)
      reject_resume_outside_handler(r, sh, errors)
    },
    EUnaryOp(_, inner) => reject_resume_outside_handler(inner, sh, errors),
    EAssign(_, v, b) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EAssignOp(_, _, v, b) => {
      reject_resume_outside_handler(v, sh, errors)
      reject_resume_outside_handler(b, sh, errors)
    },
    EFn(_, _, fparams, _, _, fb) => reject_resume_outside_handler(fb, sh || fn_params_bind_resume(fparams), errors),
    EReturn(inner) => reject_resume_outside_handler(inner, sh, errors),
    EDot(obj, _, _, _) => reject_resume_outside_handler(obj, sh, errors),
    ETuple(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    EArray(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ti = 0
      while ti < Array::length(fields) {
        let (_, fe) = Array::get(fields, ti)
        reject_resume_outside_handler(fe, sh, errors)
        ti = ti + 1
      }
    },
    ELoop(binds, b) => {
      let mut ti = 0
      let mut loop_sh = false
      while ti < Array::length(binds) {
        let (bn, be) = Array::get(binds, ti)
        if bn == "resume" {
          loop_sh = true
        } else {
          ()
        }
        reject_resume_outside_handler(be, sh, errors)
        ti = ti + 1
      }
      reject_resume_outside_handler(b, sh || loop_sh, errors)
    },
    ELabeledArg(_, _, inner) => reject_resume_outside_handler(inner, sh, errors),
    EBreak(opt) => match opt {
      Some(inner) => reject_resume_outside_handler(inner, sh, errors),
      None => ()
    },
    EContinue(items) => {
      let mut ti = 0
      while ti < Array::length(items) {
        reject_resume_outside_handler(Array::get(items, ti), sh, errors)
        ti = ti + 1
      }
    },
    EMap(pairs) => {
      let mut ti = 0
      while ti < Array::length(pairs) {
        let (_, pe) = Array::get(pairs, ti)
        reject_resume_outside_handler(pe, sh, errors)
        ti = ti + 1
      }
    },
    ESpread(inner) => reject_resume_outside_handler(inner, sh, errors),
    _ => ()
  }
}

fn check_resume_values(e: Expr, ret_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> Subst {
  match e {
    ECall(callee, args, _) => {
      let mut s1 = s
      // #942 (Codex P2 on #970): `env` is the normal lexical TypeEnv threaded
      // through check_expr, already containing every enclosing binder (the
      // top-level fn/let hoist, the arm's own payload binders via henv, and
      // any local let/let-mut/let-rec/match-arm binder this walk itself adds
      // below) — so a `resume` name already bound here is a real callable
      // binding codegen's prefer_bound_call routes to, not the builtin.
      let resume_shadowed = env_lookup(env, "resume") is Some(_)
      match callee {
        EIdent(nm, _) => {
          // A Unit-returning op discards the resumed value at the perform
          // site, so any resume argument is tolerated there (mirrors the
          // statement-position Unit tolerance elsewhere; the existing idiom
          // `Print(s) => resume(0)` for `Print(String) -> Unit` stays legal).
          if nm == "resume" && !resume_shadowed && Array::length(args) == 1 && !(ret_ty is CtUnit) {
            let (aty, ns, _) = check_expr(Array::get(args, 0), env, defs, s1, c, errors, tytab)
            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, "resume value type mismatch", 0 - 1)
          } else if nm == "resume" && !resume_shadowed && Array::length(args) == 0 && !(ret_ty is CtUnit) {
            // #828: `resume()` on a value-returning op used to reach codegen,
            // which indexes resume args[0] unconditionally — a compiler ICE
            // with no diagnostic. Reject it here instead.
            Array::push(errors, "resume expects a value (the operation returns a non-Unit type); resume() with no argument is only valid for Unit-returning operations")
          } else {
            ()
          }
        },
        _ => {
          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab)
        }
      }
      let mut ri = 0
      while ri < Array::length(args) {
        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab)
        ri = ri + 1
      }
      s1
    },
    EHandle(_, _) => s,
    ELet(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    ELetMut(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    ELetRec(ln, v, b) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env_bind(env, ln, CtUnknown), defs, s, c, errors, tytab), c, errors, tytab),
    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab), c, errors, tytab),
    EMatch(scr, marms) => {
      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab)
      let mut mi = 0
      while mi < Array::length(marms) {
        let (mp, mb) = Array::get(marms, mi)
        s1 = check_resume_values(mb, ret_ty, resume_walk_bind_pat(mp, env), defs, s1, c, errors, tytab)
        mi = mi + 1
      }
      s1
    },
    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    EForIn(fname, fidx, it, b) => {
      let fenv = match fidx {
        Some(fi) => env_bind(env_bind(env, fname, CtUnknown), fi, CtUnknown),
        None => env_bind(env, fname, CtUnknown)
      }
      check_resume_values(b, ret_ty, fenv, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab)
    },
    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),
    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),
    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab),
    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),
    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab),
    ETuple(items) => {
      let mut s1 = s
      let mut ti = 0
      while ti < Array::length(items) {
        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)
        ti = ti + 1
      }
      s1
    },
    EArray(items) => {
      let mut s1 = s
      let mut ti = 0
      while ti < Array::length(items) {
        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)
        ti = ti + 1
      }
      s1
    },
    _ => s
  }
}

export fn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int) {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name, ident_off) => match env_lookup(env, name) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if Array::length(bounds) != 0 {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        // Record this user identifier's inferred (raw, pre-final-subst) type
        // keyed by its real source offset, for typed-hover (vibe type-at) on
        // locals and parameters. Synthetic idents (off < 0) are skipped.
        if ident_off >= 0 {
          Array::push(tytab, (ident_off, ti))
        } else {
          ()
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(name) {
        Some(t) => {
          if ident_off >= 0 {
            Array::push(tytab, (ident_off, t))
          } else {
            ()
          }
          (t, s, c)
        },
        None => match resolve_trait_method_ident(name, env, defs, s) {
          Some(mty) => {
            if ident_off >= 0 {
              Array::push(tytab, (ident_off, mty))
            } else {
              ()
            }
            (mty, s, c)
          },
          None => match resolve_qualified_ctor_ident(name, env, defs) {
            Some(ct) => {
              let (ti, c1, new_bounds) = instantiate(ct, c)
              let nblen = Array::length(new_bounds)
              let mut s1 = s
              let mut bi = 0
              while bi < nblen {
                let (vid, bounds) = Array::get(new_bounds, bi)
                if Array::length(bounds) != 0 {
                  s1 = subst_add_bound(s1, vid, bounds)
                } else {
                  ()
                }
                bi = bi + 1
              }
              if ident_off >= 0 {
                Array::push(tytab, (ident_off, ti))
              } else {
                ()
              }
              (ti, s1, c1)
            },
            None => {
              Array::push(errors, String::concat(String::concat("unknown name: ", name), off_marker_len(ident_off, String::length(name))))
              (CtUnknown, s, c)
            }
          }
        }
      }
    },
    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    EIf(cond, then_e, else_e) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "if condition must be Bool")
      }
      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)
      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)
      // The two branches must agree when both yield a real value (previously
      // unchecked — `if c { 1 } else { "x" }` was accepted). A `CtUnit` branch
      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is
      // discarded, and a statement-position `if` need not have matching arms.
      let rtt = subst_apply(s3, tt)
      let ret = subst_apply(s3, et)
      // When one branch yields Unit (an else-less `if`, whose missing else is
      // `()`, or an explicit `()` branch), the branches need not agree and the
      // expression yields Unit as a VALUE — so `let x: Int = if c { 1 }` is
      // rejected (it returns Unit when c is false) while a statement-position
      // `if` is harmless (its value is discarded). Only when BOTH branches yield
      // a real (non-Unit) value must they agree, and the result is that type.
      let (s3b, if_ty) = match rtt {
        CtUnit => (s3, CtUnit),
        _ => match ret {
          CtUnit => (s3, CtUnit),
          _ => (check_assignable(rtt, ret, s3, errors, "if branches have incompatible types", 0 - 1), tt)
        }
      }
      (if_ty, s3b, c3)
    },
    ECall(callee, args, call_off) => match callee {
      // `perform EffName::Op(opargs)` parses as ECall(EIdent("perform"),
      // [ECall(EIdent("EffName::Op"), opargs)]). The op name may be a builtin
      // effect (Stdin/Stdout/...) not registered in the checker env, so check
      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.
      // `resume(v)` likewise yields the continuation result (a fresh var;
      // handler arms are otherwise unchecked).
      EIdent(name, callee_off) => {
        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)
        index_target_check(name, args, env, defs, s, c, errors, check_expr)
        if name == "perform" {
          if Array::length(args) == 1 {
            match Array::get(args, 0) {
              ECall(op_callee, opargs, _) => {
                // #640 Stage 2: `throw(x)` now parses to this exact shape
                // (perform Error::Throw(x)). Preserve EThrow's historical
                // typing verbatim: the payload is NOT type-checked (EThrow fell
                // to check_expr's catch-all) and the value is CtUnknown (a
                // wildcard — `throw` sits in any expression position). Running
                // the generic perform path instead would newly check the ~970
                // existing throw payloads and yield a fresh var, changing
                // pinned checker behavior.
                let is_error_throw = match op_callee {
                  EIdent(op_qname0, _) => is_exception_throw_operation(op_qname0),
                  _ => false
                }
                if is_error_throw {
                  (CtUnknown, s, c)
                } else {
                  let oalen = Array::length(opargs)
                  let mut s1 = s
                  let mut c1 = c
                  let oparg_tys = array_empty()
                  let mut ai = 0
                  while ai < oalen {
                    let (oat, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)
                    Array::push(oparg_tys, oat)
                    s1 = ns
                    c1 = nc
                    ai = ai + 1
                  }
                  // #813: when the op belongs to a DECLARED effect, validate the
                  // perform against its signature — arity and (ground-gated)
                  // argument types were previously unchecked, so
                  // `perform R::Take("str")` against `Take(Int)` compiled and
                  // produced garbage. Builtin/imported effects (no TDEffect) skip.
                  match op_callee {
                    EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {
                      Some(sig) => {
                        let (sig_params, sig_ret) = sig
                        if Array::length(sig_params) != oalen {
                          Array::push(errors, String::concat("perform ", String::concat(op_qname, String::concat(" expects ", String::concat(__to_string(Array::length(sig_params)), String::concat(" argument(s), got ", String::concat(__to_string(oalen), off_marker(op_off))))))))
                        } else {
                          let mut vi = 0
                          while vi < oalen {
                            s1 = check_assignable(Array::get(sig_params, vi), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat("perform argument type mismatch for ", op_qname), op_off)
                            vi = vi + 1
                          }
                        }
                        // The perform's value is the op's declared return type —
                        // typing it (instead of a fresh var) also lets resume/arm
                        // consumers see the concrete type. Non-ground returns keep
                        // the fresh var (generic inference untouched).
                        if type_is_ground(sig_ret) {
                          (sig_ret, s1, c1)
                        } else {
                          let (tv, c2) = fresh_var(c1)
                          (tv, s1, c2)
                        }
                      },
                      None => {
                        // Unknown op of a DECLARED effect: the typo'd op would
                        // never be matched by any handler arm — report it.
                        let ci2 = String::index_of(op_qname, "::")
                        if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {
                          Array::push(errors, String::concat("unknown operation `", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat("` of effect ", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))
                        } else {
                          ()
                        }
                        let (tv, c2) = fresh_var(c1)
                        (tv, s1, c2)
                      }
                    },
                    _ => {
                      let (tv, c2) = fresh_var(c1)
                      (tv, s1, c2)
                    }
                  }
                }
              },
              EIdent(_, _) => {
                let (tv, c2) = fresh_var(c)
                (tv, s, c2)
              },
              other => check_expr(other, env, defs, s, c, errors, tytab)
            }
          } else {
            (CtUnknown, s, c)
          }
        } else if name == "resume" {
          let alen = Array::length(args)
          let mut s1 = s
          let mut c1 = c
          let mut ai = 0
          while ai < alen {
            let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
            s1 = ns
            c1 = nc
            ai = ai + 1
          }
          let (tv, c2) = fresh_var(c1)
          (tv, s1, c2)
        } else if name == "%wasm" {
          // #805 (ADR-0072) inline wasm marker: only producible by the parser's
          // `fn f(a: Int, ..) -> Int = wasm "..."` form (a `%`-ident cannot be
          // parsed in expression position, so user source cannot forge it).
          // The declared signature is trusted extern-let style; the call's
          // value is a fresh var that unifies with the declared Int return.
          // The single arg is the WAT text literal — shape-checked here
          // defensively, never evaluated.
          let wasm_shape_ok = if Array::length(args) == 1 {
            match Array::get(args, 0) {
              EString(_) => true,
              _ => false
            }
          } else {
            false
          }
          if !wasm_shape_ok {
            Array::push(errors, "malformed inline wasm marker (expected a single WAT string literal)")
          } else {
            ()
          }
          let (tv, c2) = fresh_var(c)
          (tv, s, c2)
        } else if name == "Some" {
          if Array::length(args) == 1 {
            let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
            (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)
          } else {
            // `Some` takes exactly one payload — `Some(1, 2)` was accepted.
            Array::push(errors, String::concat(String::concat("Some expects 1 argument, got ", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))
            (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)
          }
        } else if name == "__index" && Array::length(args) == 2 {
          // `obj[i]` (`__index(obj, i)`) is typed polymorphically by the builtin
          // table, losing the result type — `let s: String = a[0]` over an
          // `Array[Int]` slipped through. When the receiver resolves to
          // `CtArray(elem)`, refine the result to `elem`; String/Bytes indexing
          // yields the char/byte code (`Int`) so `let s: String = "abc"[0]`
          // (which returns 97) must be rejected. Var / unknown / named receivers
          // keep the conservative CtUnknown. (index_target_check above still
          // validates the receiver/subscript shapes on a throwaway channel.)
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let result = match subst_apply(s2, obj_ty) {
            CtArray(elem) => elem,
            CtString => CtInt,
            CtBytes => CtInt,
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s2, c2)
        } else if name == "ArrayBuilder::new" && Array::length(args) == 0 {
          // #938: the builder ops were typed all-CtUnknown, so
          // `ArrayBuilder::push(b, 1); ArrayBuilder::push(b, "two")` compiled
          // clean and the frozen array leaked a raw String pointer through an
          // `Array[Int]` annotation. Give the builder a REAL element slot:
          // `CtNamed("ArrayBuilder", [fresh])` — the same shape an explicit
          // `b: ArrayBuilder[String]` annotation already resolves to
          // (checker_resolve TyApp fallback), so annotated params get checked
          // by the same push/freeze rules for free. The fresh var is bound by
          // the FIRST push and every later push must unify with it. (ELet's
          // generalize deliberately skips this shape — see the value-restriction
          // note at the ELet arm — or each use would re-instantiate the var and
          // the pushes could never disagree.)
          let (ev, c1) = fresh_var(c)
          (tab_call_ty(tytab, call_off, CtNamed("ArrayBuilder", Array::slice([
            ev
          ], 0, 1))), s, c1)
        } else if name == "ArrayBuilder::push" && Array::length(args) == 2 {
          // #938: unify the pushed value with the builder's element slot. A
          // builder that reaches here untyped (CtUnknown / var receiver from an
          // un-annotated param) stays tolerant, exactly like Array::push's
          // ground gate.
          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (v_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = match subst_apply(s2, b_ty) {
            CtNamed(bn, bargs) => if bn == "ArrayBuilder" && Array::length(bargs) == 1 {
              match unify(Array::get(bargs, 0), v_ty, s2) {
                Some(su) => su,
                None => {
                  Array::push(errors, String::concat("ArrayBuilder::push element type mismatch: builder holds ", String::concat(type_to_string(subst_apply(s2, Array::get(bargs, 0))), String::concat(", got ", String::concat(type_to_string(subst_apply(s2, v_ty)), off_marker_len(callee_off, String::length(name)))))))
                  s2
                }
              }
            } else {
              s2
            },
            _ => s2
          }
          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)
        } else if name == "ArrayBuilder::freeze" && Array::length(args) == 1 {
          // #938: freeze returns an array of the builder's (now tracked) element
          // type, so a wrong return/let annotation is caught by the ordinary
          // unify instead of vanishing into CtArray(CtUnknown).
          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let result = match subst_apply(s1, b_ty) {
            CtNamed(bn, bargs) => if bn == "ArrayBuilder" && Array::length(bargs) == 1 {
              CtArray(subst_apply(s1, Array::get(bargs, 0)))
            } else {
              CtArray(CtUnknown)
            },
            _ => CtArray(CtUnknown)
          }
          (tab_call_ty(tytab, call_off, result), s1, c1)
        } else if name == "FrozenArray::from_array" && Array::length(args) == 1 {
          // #906: FrozenArray[T] is a checker-only phantom-type distinction over
          // Array[T]'s exact same runtime layout -- same technique as
          // ArrayBuilder above (freeze is a pure identity cast; here from_array
          // is too). Capture the argument's element type into
          // CtNamed("FrozenArray", [elem]) so get/to_array recover a real type
          // instead of CtUnknown. A non-concrete argument (var/unknown
          // receiver) stays tolerant, matching Array::reverse's own fallback.
          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let elem = match subst_apply(s1, a_ty) {
            CtArray(e) => e,
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, CtNamed("FrozenArray", Array::slice([
            elem
          ], 0, 1))), s1, c1)
        } else if name == "FrozenArray::to_array" && Array::length(args) == 1 {
          // #906: the reverse of from_array -- unwraps a tracked FrozenArray
          // element type back into an ordinary Array[T], same shape as
          // ArrayBuilder::freeze above.
          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let result = match subst_apply(s1, fa_ty) {
            CtNamed(fn0, fargs) => if fn0 == "FrozenArray" && Array::length(fargs) == 1 {
              CtArray(subst_apply(s1, Array::get(fargs, 0)))
            } else {
              CtArray(CtUnknown)
            },
            _ => CtArray(CtUnknown)
          }
          (tab_call_ty(tytab, call_off, result), s1, c1)
        } else if name == "FrozenArray::get" && Array::length(args) == 2 {
          // #906: same element-type extraction as Array::get, over a tracked
          // FrozenArray receiver instead of CtArray.
          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let result = match subst_apply(s2, fa_ty) {
            CtNamed(fn1, fargs1) => if fn1 == "FrozenArray" && Array::length(fargs1) == 1 {
              subst_apply(s2, Array::get(fargs1, 0))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s2, c2)
        } else if name == "FrozenArray::length" && Array::length(args) == 1 {
          // #906: length is not element-type-dependent -- always Int, but the
          // receiver still needs checking (consistent with every other builtin
          // branch here checking all of its arguments).
          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          (tab_call_ty(tytab, call_off, CtInt), s1, c1)
        } else if name == "MutList::empty" && Array::length(args) == 1 {
          // ADR-0090 Phase 1: MutList[T, r] is a checker-only phantom over
          // Array[T]'s runtime layout (same technique as FrozenArray above).
          // The region argument's type -- inside `region r { .. }` a type
          // variable that `__region_run` later pins to its rigid skolem --
          // is captured as the SECOND type argument, so the escape scan in
          // the `__region_run` branch below can see region-tainted values in
          // fully-zonked types. The element type stays tolerant (CtUnknown),
          // matching FrozenArray's rows.
          let (r_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let zoned_r = subst_apply(s1, r_ty)
          // #1274 Codex P1: the token must be the unforgeable `#region_N`
          // skolem the `region` binder carries. Any other argument type
          // (e.g. `MutList::empty(0)`) would install a skolem-free phantom
          // that the `__region_run` escape scan can never see, making the
          // region-bound collection freely constructible and escapable.
          // Second-class by design: the token cannot pass through function
          // parameters in this slice (a param's type is a fresh var, not
          // the skolem), matching the ADR's escape rules.
          let is_region_token = match zoned_r {
            CtNamed(zr_name, _) => String::length(zr_name) >= 8 && String::substring(zr_name, 0, 8) == "#region_",
            _ => false
          }
          if is_region_token {
            ()
          } else {
            Array::push(errors, String::concat("MutList::empty requires the region token bound by `region r { ... }` (the token is second-class and cannot be forged or passed through function parameters)", off_marker_len(callee_off, String::length(name))))
          }
          (tab_call_ty(tytab, call_off, CtNamed("MutList", Array::slice([
            CtUnknown,
            zoned_r
          ], 0, 2))), s1, c1)
        } else if name == "MutList::push" && Array::length(args) == 2 {
          // ADR-0090 Phase 1: borrows the list (arg0), consumes the element.
          // The tolerant CtUnknown element type means no per-push element
          // unification yet -- the checker slice keeps FrozenArray's
          // tolerance until MutList grows real element inference.
          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          (tab_call_ty(tytab, call_off, CtUnit), s2, c2)
        } else if name == "MutList::freeze" && Array::length(args) == 1 {
          // ADR-0090 Phase 1: the sanctioned region exit -- drops the region
          // type argument, so the frozen result passes the `__region_run`
          // escape scan (runtime identity cast, like ArrayBuilder::freeze).
          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let elem = match subst_apply(s1, ml_ty) {
            CtNamed(ml_name, ml_args) => if ml_name == "MutList" && Array::length(ml_args) == 2 {
              subst_apply(s1, Array::get(ml_args, 0))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, CtNamed("FrozenArray", Array::slice([
            elem
          ], 0, 1))), s1, c1)
        } else if name == "MutList::to_array" && Array::length(args) == 1 {
          // ADR-0090 Phase 1: like freeze but exits to a plain Array[T].
          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let elem = match subst_apply(s1, ml_ty) {
            CtNamed(ml_name, ml_args) => if ml_name == "MutList" && Array::length(ml_args) == 2 {
              subst_apply(s1, Array::get(ml_args, 0))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, CtArray(elem)), s1, c1)
        } else if name == "FixedArray::make" && Array::length(args) == 2 {
          // #1140: FixedArray[T] is a checker-only phantom-type distinction
          // over Array[T]'s exact same runtime layout, same technique as
          // FrozenArray above (codegen already treats FixedArray::make/get/
          // set/length as their own opcodes -- see codegen/gc/backend_call.vibe
          // and codegen/expr/compile_call.vibe -- only the checker-level type
          // tracking was missing, degrading every FixedArray value to
          // CtArray(CtUnknown)/CtUnknown). Capture the init value's type into
          // CtNamed("FixedArray", [elem]) so get/set/length recover a real
          // element type. The length (arg 0) must still be checked against
          // Int here -- #985's builtin_first_arg_head table already enforced
          // this via the fallback path, and this ECall branch pre-empts that
          // fallback, so skipping the check here would silently regress
          // `FixedArray::make("4", 0)` back to compiling clean (caught by
          // checker_builtin_arg_head_test.vibe's #985 review case).
          let (len_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let s1b = check_assignable(CtInt, subst_apply(s1, len_ty), s1, errors, "FixedArray::make length must be Int", call_off)
          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1b, c1, errors, tytab)
          let elem = subst_apply(s2, init_ty)
          (tab_call_ty(tytab, call_off, CtNamed("FixedArray", Array::slice([
            elem
          ], 0, 1))), s2, c2)
        } else if name == "FixedArray::get" && Array::length(args) == 2 {
          // #1140: same element-type extraction as FrozenArray::get, over a
          // tracked FixedArray receiver. Index (arg 1) checked against Int,
          // same discipline #985's builtin_first_arg_head table enforced for
          // Int64Array::get before this ECall branch pre-empted the fallback.
          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty), s2, errors, "FixedArray::get index must be Int", call_off)
          let result = match subst_apply(s2b, fa_ty) {
            CtNamed(fan, faargs) => if fan == "FixedArray" && Array::length(faargs) == 1 {
              subst_apply(s2b, Array::get(faargs, 0))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s2b, c2)
        } else if (name == "FixedArray::set" || name == "FixedArray::unsafe_set") && Array::length(args) == 3 {
          // #1140: writing a value not assignable to the tracked element type
          // is now a located type error instead of silently compiling through
          // CtUnknown (same discipline as Map::set below). `unsafe_set` only
          // skips the runtime bounds check (codegen concern) -- the static
          // element-type contract is identical to `set`. Index (arg 1)
          // checked against Int, same #985 discipline as FixedArray::get above.
          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (idx_ty2, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty2), s2, errors, String::concat("index must be Int for ", name), call_off)
          let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)
          let s4 = match subst_apply(s3, fa_ty) {
            CtNamed(fan2, faargs2) => if fan2 == "FixedArray" && Array::length(faargs2) == 1 {
              check_assignable(subst_apply(s3, Array::get(faargs2, 0)), subst_apply(s3, v_ty), s3, errors, String::concat("value type mismatch for ", name), call_off)
            } else {
              s3
            },
            _ => s3
          }
          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)
        } else if name == "FixedArray::length" && Array::length(args) == 1 {
          // #1140: same as FrozenArray::length -- always Int, receiver still checked.
          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          (tab_call_ty(tytab, call_off, CtInt), s1, c1)
        } else if name == "FixedArray::blit" && Array::length(args) == 5 {
          // #1140: dst/dst_off/src/src_off/len -- dst_off/src_off/len (1, 3, 4)
          // checked against Int, matching the Int positions the pre-existing
          // fallback signature (fixed_array_five_params(.., CtInt, .., CtInt,
          // CtInt)) enforced before this ECall branch pre-empted it. No
          // cross-checking that dst's and src's tracked element types match
          // (kept tolerant, same spirit as that same fallback signature's
          // CtArray(CtUnknown) receiver positions).
          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (dst_off_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s2b = check_assignable(CtInt, subst_apply(s2, dst_off_ty), s2, errors, "FixedArray::blit dst_off must be Int", call_off)
          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)
          let (src_off_ty, s4, c4) = check_expr(Array::get(args, 3), env, defs, s3, c3, errors, tytab)
          let s4b = check_assignable(CtInt, subst_apply(s4, src_off_ty), s4, errors, "FixedArray::blit src_off must be Int", call_off)
          let (len_ty2, s5, c5) = check_expr(Array::get(args, 4), env, defs, s4b, c4, errors, tytab)
          let s5b = check_assignable(CtInt, subst_apply(s5, len_ty2), s5, errors, "FixedArray::blit len must be Int", call_off)
          (tab_call_ty(tytab, call_off, CtUnit), s5b, c5)
        } else if name == "Map::set" && Array::length(args) == 3 {
          // #983: every Map API's VALUE position was `CtUnknown` (the static
          // builtin table cannot mint per-call vars), so
          // `Map::set(m, "b", "str")` into a `Map[String, Int]` compiled clean
          // and trapped at the consumer. Map literals now carry a real value
          // slot (`CtNamed("Map", [CtString, v])` — the shape a
          // `Map[String, V]` annotation already resolves to), and set checks
          // the written value against it, ground-gated via `check_assignable`
          // (same tolerate discipline as Array::push — untyped/var receivers
          // stay tolerant). The key check replicates the CtString param the
          // bypassed table signature enforced.
          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)
          let s4 = check_assignable(CtString, subst_apply(s3, k_ty), s3, errors, "argument type mismatch for Map::set", call_off)
          let s5 = match subst_apply(s4, m_ty) {
            CtNamed(mn, margs) => if mn == "Map" && Array::length(margs) == 2 {
              check_assignable(subst_apply(s4, Array::get(margs, 1)), subst_apply(s4, v_ty), s4, errors, "Map::set value type mismatch", call_off)
            } else {
              s4
            },
            _ => s4
          }
          let mret = match subst_apply(s5, m_ty) {
            CtNamed(mn2, margs2) => if mn2 == "Map" && Array::length(margs2) == 2 {
              subst_apply(s5, m_ty)
            } else {
              CtNamed("Map", [
                CtString,
                CtUnknown
              ])
            },
            _ => CtNamed("Map", [
              CtString,
              CtUnknown
            ])
          }
          (tab_call_ty(tytab, call_off, mret), s5, c3)
        } else if name == "Map::get" && Array::length(args) == 2 {
          // #983: refine the result from bare CtUnknown to the receiver's value
          // slot, so a wrongly-typed consume of the looked-up value is caught
          // by the ordinary unify. NOTE: `Map::get` returns the RAW stored
          // value (0 on a miss) — `declare Map::get(Map[T, U], T) -> U` in
          // builtins/declarations.vibe and the linear codegen agree — NOT an
          // Option. Untyped receivers keep the conservative CtUnknown.
          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, "argument type mismatch for Map::get", call_off)
          let result = match subst_apply(s3, m_ty) {
            CtNamed(mn, margs) => if mn == "Map" && Array::length(margs) == 2 {
              subst_apply(s3, Array::get(margs, 1))
            } else {
              CtUnknown
            },
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s3, c2)
        } else if name == "Map::values" && Array::length(args) == 1 {
          // #983: values() of a value-slotted map is `Array[v]`, not
          // `Array[CtUnknown]`.
          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let result = match subst_apply(s1, m_ty) {
            CtNamed(mn, margs) => if mn == "Map" && Array::length(margs) == 2 {
              CtArray(subst_apply(s1, Array::get(margs, 1)))
            } else {
              CtArray(CtUnknown)
            },
            _ => CtArray(CtUnknown)
          }
          (tab_call_ty(tytab, call_off, result), s1, c1)
        } else if name == "Map::delete" && Array::length(args) == 2 {
          // #983: delete preserves the receiver's map type (value slot
          // included) instead of collapsing it to `Map[String, CtUnknown]`.
          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, "argument type mismatch for Map::delete", call_off)
          let mret = match subst_apply(s3, m_ty) {
            CtNamed(mn, margs) => if mn == "Map" && Array::length(margs) == 2 {
              subst_apply(s3, m_ty)
            } else {
              CtNamed("Map", [
                CtString,
                CtUnknown
              ])
            },
            _ => CtNamed("Map", [
              CtString,
              CtUnknown
            ])
          }
          (tab_call_ty(tytab, call_off, mret), s3, c2)
        } else if name == "Array::push" && Array::length(args) == 2 {
          // `Array::push(a, v)` requires `v` to match `a`'s element type — pushing
          // a String into an `Array[Int]` was accepted (direct_call_return only
          // checks arg-0 head). Check the value against a concrete element type;
          // generic / var element types stay tolerant (check_assignable is ground-
          // gated).
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = match subst_apply(s2, obj_ty) {
            CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, "Array::push value type mismatch", 0 - 1),
            _ => s2
          }
          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)
        } else if name == "Array::set" && Array::length(args) == 3 {
          // `Array::set(a, i, v)` requires `v` to match `a`'s element type (the 3rd
          // arg was unchecked). Same ground-gated discipline as Array::push.
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (set_idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)
          // #826: same head checks as Array::get (this branch also bypasses the
          // direct fast path).
          let as_recv_head = head_kind(subst_apply(s3, obj_ty))
          if as_recv_head != 0 && as_recv_head != 9 {
            Array::push(errors, String::concat("argument type mismatch for Array::set: receiver type ", String::concat(type_to_string(subst_apply(s3, obj_ty)), off_marker_len(callee_off, String::length(name)))))
          } else if is_stream_named_type(subst_apply(s3, obj_ty)) {
            // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.
            Array::push(errors, String::concat("argument type mismatch for Array::set: receiver type ", String::concat(type_to_string(subst_apply(s3, obj_ty)), String::concat(" is a Stream, not an Array (use `for await` / Stream::*)", off_marker_len(callee_off, String::length(name))))))
          } else {
            ()
          }
          let as_idx_head = head_kind(subst_apply(s3, set_idx_ty))
          if as_idx_head != 0 && as_idx_head != 1 {
            Array::push(errors, String::concat("argument type mismatch for Array::set (arg 1): ", String::concat(type_to_string(subst_apply(s3, set_idx_ty)), off_marker_len(callee_off, String::length(name)))))
          } else {
            ()
          }
          let s4 = match subst_apply(s3, obj_ty) {
            CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, "Array::set value type mismatch", 0 - 1),
            _ => s3
          }
          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)
        } else if name == "Array::push_all" && Array::length(args) == 2 {
          // `Array::push_all(a, b)` appends every element of `b` into `a`, so the
          // two arrays must share an element type — `Array::push_all([1], ["x"])`
          // merged Int and String elements and slipped through (push_all had no
          // value/element check, only the arg-0 head). Same ground-gated discipline
          // as Array::concat.
          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, "Array::push_all element type mismatch")
          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)
        } else if name == "Array::get" && Array::length(args) == 2 {
          // `Array::get(a, i)` returns the element type, but `direct_call_return`
          // types it CtUnknown — `let s: String = Array::get(intArr, 0)` slipped
          // through. Refine the result to the element type from a concrete
          // `CtArray(elem)` receiver (var / generic receivers stay CtUnknown).
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          // #826: this special branch bypasses the direct fast path, so the
          // head checks never ran — `Array::get("str", 0)` trapped at runtime
          // and `Array::get(a, "x")` returned silent garbage. Same ground-gated
          // discipline as builtin_first_arg_head (0 = tolerate).
          let ag_recv_head = head_kind(subst_apply(s2, obj_ty))
          if ag_recv_head != 0 && ag_recv_head != 9 {
            Array::push(errors, String::concat("argument type mismatch for Array::get: receiver type ", String::concat(type_to_string(subst_apply(s2, obj_ty)), off_marker_len(callee_off, String::length(name)))))
          } else if is_stream_named_type(subst_apply(s2, obj_ty)) {
            // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.
            Array::push(errors, String::concat("argument type mismatch for Array::get: receiver type ", String::concat(type_to_string(subst_apply(s2, obj_ty)), String::concat(" is a Stream, not an Array (use `for await` / Stream::*)", off_marker_len(callee_off, String::length(name))))))
          } else {
            ()
          }
          let ag_idx_head = head_kind(subst_apply(s2, idx_ty))
          if ag_idx_head != 0 && ag_idx_head != 1 {
            Array::push(errors, String::concat("argument type mismatch for Array::get (arg 1): ", String::concat(type_to_string(subst_apply(s2, idx_ty)), off_marker_len(callee_off, String::length(name)))))
          } else {
            ()
          }
          let result = match subst_apply(s2, obj_ty) {
            CtArray(elem) => elem,
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s2, c2)
        } else if name == "Array::reverse" && Array::length(args) == 1 {
          // Returns an array of the same element type (was CtUnknown).
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let result = match subst_apply(s1, obj_ty) {
            CtArray(elem) => CtArray(elem),
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s1, c1)
        } else if name == "Array::concat" && Array::length(args) == 2 {
          // Returns an array of the receivers' element type (was CtUnknown). Refine
          // from the first concrete `CtArray(elem)` operand, and require the two
          // operands' element types to agree — `Array::concat([1], ["x"])` mixed
          // `Array[Int]` with `Array[String]` and slipped through (the result was
          // refined to the first operand but the second was never checked).
          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let a_app = subst_apply(s2, a_ty)
          let b_app = subst_apply(s2, b_ty)
          let s3 = check_two_array_elems(a_app, b_app, s2, errors, "Array::concat element type mismatch")
          let result = match a_app {
            CtArray(elem) => CtArray(elem),
            _ => match b_app {
              CtArray(elem) => CtArray(elem),
              _ => CtUnknown
            }
          }
          (tab_call_ty(tytab, call_off, result), s3, c2)
        } else if name == "Array::slice" && Array::length(args) == 3 {
          // `Array::slice(a, lo, hi)` returns an array of the SAME element type,
          // typed CtUnknown by the builtin table (`let s: String =
          // Array::get(Array::slice(ints, 0, 1), 0)` slipped through). Refine to
          // `CtArray(elem)` from a concrete receiver.
          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)
          let result = match subst_apply(s3, obj_ty) {
            CtArray(elem) => CtArray(elem),
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s3, c3)
        } else if name == "Array::fold" && Array::length(args) == 3 {
          // `Array::fold(a, init, f)` returns the accumulator type — i.e. `init`'s
          // type — but was typed CtUnknown, so `let s: String = Array::fold(ints,
          // 0, add)` slipped through. Refine the result to the init value's type.
          // Also check the callback `(acc, x)` params: `acc` against `init`'s type
          // and `x` against the array element type (`Array::fold([1,2], 0, (acc:
          // String, x) -> ...)` slipped through). Ground-gated.
          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)
          let s4 = match subst_apply(s3, fn_ty) {
            CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {
              check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, "Array::fold accumulator type mismatch", 0 - 1)
            } else {
              s3
            },
            _ => s3
          }
          let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, "Array::fold element parameter type mismatch")
          (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)
        } else if name == "Array::map" && Array::length(args) == 2 {
          // `Array::map(a, f)` returns `Array[R]` where R is f's return type —
          // typed CtUnknown by the builtin table, so the mapped element type was
          // lost (`let s: String = Array::get(Array::map(ints, inc), 0)`). Refine
          // the result element to the mapping function's concrete return type; a
          // non-function / var f stays CtUnknown. Also check the callback's first
          // parameter type against the array element type — `Array::map([1,2],
          // (s: String) -> ...)` applied a `(String)->_` over `Array[Int]` and
          // slipped through. Ground-gated, so an unannotated `(x) -> ...` param
          // (CtVar) stays tolerant.
          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)
          let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, "Array::map function parameter type mismatch")
          let result = match subst_apply(s3, fn_ty) {
            CtFn(_, ret, _) => CtArray(ret),
            _ => CtUnknown
          }
          (tab_call_ty(tytab, call_off, result), s3, c2)
        } else if name == "TaskGroup::run" && Array::length(args) == 1 {
          // #1081 step 3: `TaskGroup::run` mints a fresh generative region.
          // There is no general rank-2/`Region`-bound mechanism in this
          // checker (see docs/concurrency.md's dated 実装ノート) — this
          // qualified name is special-cased exactly like `resume`/`perform`/
          // `Some` above, matched by its LITERAL spelling. (Codex review, PR
          // #1135, P1: an attempted fix that matched by the callee's
          // structural shape instead — so a first-class alias like `let run
          // = TaskGroup::run; run(...)` would also get this treatment — was
          // tried and reverted: it false-matched unrelated single-argument
          // calls elsewhere in the compiler's own source, regressing 20
          // unit-test files with runtime traps. The alias/import-rename/
          // higher-order-wrapper bypass this literal-name match cannot close
          // is therefore a documented, accepted gap for this slice — see
          // docs/concurrency.md's dated 実装ノート.) The scheme's `r` type
          // parameter is instantiated to a fresh RIGID skolem (a `CtNamed`
          // name no parsed source can ever spell — the lexer rejects `#` in
          // identifiers) instead of an ordinary unifiable `CtVar`, so nothing
          // outside this call can be coerced into it by accident; only a
          // real escape reaches it, which the two checks below catch by
          // scanning fully-zonked types for the skolem's name.
          match env_lookup(env, "TaskGroup::run") {
            Some(scheme) => {
              let (ti, c1, new_bounds) = instantiate(scheme, c)
              let mut s0 = s
              let mut bi = 0
              while bi < Array::length(new_bounds) {
                let (vid, bounds) = Array::get(new_bounds, bi)
                if Array::length(bounds) != 0 {
                  s0 = subst_add_bound(s0, vid, bounds)
                } else {
                  ()
                }
                bi = bi + 1
              }
              match ti {
                CtFn(run_params, run_ret, _) => match Array::get(run_params, 0) {
                  CtFn(body_params, body_ret, body_eff) => match Array::get(body_params, 0) {
                    CtNamed(tg_name, tg_args) => if tg_name == "TaskGroup" && Array::length(tg_args) == 2 {
                      match Array::get(tg_args, 0) {
                        CtVar(rv_id) => {
                          let skolem_name = String::concat("#region_", __to_string(c1))
                          let s_skolem = SubstBind(rv_id, CtNamed(skolem_name, [
                          ]), s0)
                          let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s_skolem, c1 + 1, errors, tytab)
                          match unify(CtFn(body_params, body_ret, body_eff), bt, s_body) {
                            Some(s_unified) => {
                              let zonked_ret = subst_apply(s_unified, body_ret)
                              if type_mentions_named(zonked_ret, skolem_name) {
                                Array::push(errors, String::concat("region escapes its nursery scope: the value returned from this TaskGroup::run body still depends on its own Nursery/Task/Sender/Receiver token", off_marker_len(callee_off, String::length(name))))
                              } else {
                                ()
                              }
                              let outer_bindings = array_empty()
                              collect_env_bindings(env, outer_bindings)
                              let mut oi = 0
                              let mut leaked = false
                              while oi < Array::length(outer_bindings) {
                                let (_, oty) = Array::get(outer_bindings, oi)
                                if !leaked && type_mentions_named(subst_apply(s_unified, oty), skolem_name) {
                                  leaked = true
                                } else {
                                  ()
                                }
                                oi = oi + 1
                              }
                              if leaked {
                                Array::push(errors, String::concat("region escapes its nursery scope: an outer binding now depends on this TaskGroup::run call's own Nursery/Task/Sender/Receiver token", off_marker_len(callee_off, String::length(name))))
                              } else {
                                ()
                              }
                              // #1081 step 3 Phase B: the `let mut` capture
                              // check (Codex review, PR #1150/#1151) runs as
                              // a SEPARATE whole-program pass
                              // (check_spawnable_mut_captures_stmts, wired
                              // into check_program/check_program_with_env in
                              // checker_stmt.vibe), not per `TaskGroup::run`
                              // call -- it needs to see `let mut` bindings
                              // declared in the ENCLOSING scope, outside this
                              // call's own body, which this call site alone
                              // cannot observe.
                              (tab_call_ty(tytab, call_off, subst_apply(s_unified, run_ret)), s_unified, c_body)
                            },
                            None => {
                              Array::push(errors, String::concat("argument type mismatch for TaskGroup::run", off_marker_len(callee_off, String::length(name))))
                              (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)
                            }
                          }
                        },
                        _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
                      }
                    } else {
                      (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
                    },
                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
                  },
                  _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
                },
                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
              }
            },
            // Reachable: the outer condition only matches the literal name
            // `"TaskGroup::run"`, not that it actually resolves in `env`
            // (e.g. the package isn't imported here at all).
            None => {
              Array::push(errors, String::concat("unknown name: ", name))
              (tab_call_ty(tytab, call_off, CtUnknown), s, c)
            }
          }
        } else if name == "__region_run" && Array::length(args) == 1 {
          // ADR-0090 Phase 1: `region r { body }` -- parser-lowered to
          // `__region_run((r) -> { body })` -- mints a fresh generative
          // region, cloned from the TaskGroup::run branch above. Two
          // differences: `__region_run` is a reserved internal ABI name that
          // only the `region` syntax emits (a direct call spelled by hand
          // gets the same semantics, so the TaskGroup::run alias-bypass hole
          // does not exist here -- there is no scheme to alias), and there
          // is no env scheme to instantiate: the argument is by construction
          // a literal lambda, so its binder is bound DIRECTLY to the rigid
          // skolem (a CtNamed name no parsed source can spell -- `#` is
          // rejected in identifiers) before the body is checked. Binding
          // before checking matters: region-tainted `let` bindings then
          // carry the concrete skolem in their types, so this checker's
          // let-generalization cannot quantify the taint away (the
          // check-first-unify-later order would leave a free var at `let`
          // time and reopen exactly the generalize hole the ADR-0068
          // section documents). Known Phase 1 gap: the body is checked as a
          // plain expression here, but the separate effect-row pass still
          // sees the lambda wrapper, so effects performed inside a region
          // body are not attributed to the enclosing fn by that pass.
          let skolem_name = String::concat("#region_", __to_string(c))
          match Array::get(args, 0) {
            EFn(_, _, fn_params, _, _, fn_body) => if Array::length(fn_params) == 1 {
              let (binder_name, _) = Array::get(fn_params, 0)
              let env_body = env_bind(env, binder_name, CtNamed(skolem_name, [
              ]))
              let (body_ty, s1, c1) = check_expr(fn_body, env_body, defs, s, c + 1, errors, tytab)
              let zonked_ret = subst_apply(s1, body_ty)
              if type_mentions_named(zonked_ret, skolem_name) {
                Array::push(errors, String::concat("region escapes its scope: the value returned from this region body still depends on the region's own token", off_marker_len(callee_off, String::length(name))))
              } else {
                ()
              }
              let outer_bindings = array_empty()
              collect_env_bindings(env, outer_bindings)
              let mut oi = 0
              let mut leaked = false
              while oi < Array::length(outer_bindings) {
                let (_, oty) = Array::get(outer_bindings, oi)
                if !leaked && type_mentions_named(subst_apply(s1, oty), skolem_name) {
                  leaked = true
                } else {
                  ()
                }
                oi = oi + 1
              }
              if leaked {
                Array::push(errors, String::concat("region escapes its scope: an outer binding now depends on this region's own token", off_marker_len(callee_off, String::length(name))))
              } else {
                ()
              }
              (tab_call_ty(tytab, call_off, zonked_ret), s1, c1)
            } else {
              (tab_call_ty(tytab, call_off, CtUnknown), s, c + 1)
            },
            // A hand-written `__region_run(f)` with a non-literal callee:
            // check it as an ordinary 1-arg closure call and pin its
            // parameter to the skolem afterwards. Direct return-position
            // escapes are still caught through the final zonk; taint that
            // detoured through a generalized `let` inside `f` is not (the
            // documented generalize gap -- only the literal-lambda form the
            // parser emits gets the stronger bind-first treatment above).
            _ => {
              let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s, c + 1, errors, tytab)
              match subst_apply(s_body, bt) {
                CtFn(body_params, body_ret, _) => if Array::length(body_params) == 1 {
                  match unify(Array::get(body_params, 0), CtNamed(skolem_name, [
                  ]), s_body) {
                    Some(s_unified) => {
                      let zonked_ret = subst_apply(s_unified, body_ret)
                      if type_mentions_named(zonked_ret, skolem_name) {
                        Array::push(errors, String::concat("region escapes its scope: the value returned from this region body still depends on the region's own token", off_marker_len(callee_off, String::length(name))))
                      } else {
                        ()
                      }
                      (tab_call_ty(tytab, call_off, zonked_ret), s_unified, c_body)
                    },
                    None => {
                      Array::push(errors, String::concat("region body parameter type mismatch for __region_run", off_marker_len(callee_off, String::length(name))))
                      (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)
                    }
                  }
                } else {
                  (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)
                },
                _ => (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)
              }
            }
          }
        } else if (name == "TaskGroup::spawn" || name == "TaskGroup::spawn_suspend") && Array::length(args) == 2 {
          // #1081 step 3 Phase B: `Spawnable[r]` capture check. Like
          // `TaskGroup::run` above, there is no general `Spawnable`
          // trait/bound in this checker -- these two qualified names are
          // special-cased by literal spelling (same alias/rename bypass
          // caveat as TaskGroup::run, documented in docs/concurrency.md).
          // This branch does exactly the SAME instantiate + check-args +
          // unify work the generic call-checking fallback below would (so
          // ordinary type errors on `n`/`f` are unaffected), then additionally
          // zonks `n`'s region argument and walks the closure literal's
          // captured free variables against `check_spawnable_captures`.
          match env_lookup(env, name) {
            Some(scheme) => {
              let (ti, c1, new_bounds) = instantiate(scheme, c)
              let mut s0 = s
              let mut bi = 0
              while bi < Array::length(new_bounds) {
                let (vid, bounds) = Array::get(new_bounds, bi)
                if Array::length(bounds) != 0 {
                  s0 = subst_add_bound(s0, vid, bounds)
                } else {
                  ()
                }
                bi = bi + 1
              }
              match ti {
                CtFn(param_tys, ret_ty, _) => {
                  let (a0_ty, s1, c2) = check_expr(Array::get(args, 0), env, defs, s0, c1, errors, tytab)
                  let (a1_ty, s2, c3) = check_expr(Array::get(args, 1), env, defs, s1, c2, errors, tytab)
                  let arg_tys = [
                    a0_ty,
                    a1_ty
                  ]
                  let s3 = unify_call_args(param_tys, arg_tys, s2, errors, name, callee_off)
                  match subst_apply(s3, a0_ty) {
                    CtNamed(tg_name, tg_args) => if tg_name == "TaskGroup" && Array::length(tg_args) == 2 {
                      let violations = check_spawnable_captures(env, s3, defs, Array::get(args, 1), Array::get(tg_args, 0))
                      let mut vi = 0
                      while vi < Array::length(violations) {
                        Array::push(errors, String::concat(Array::get(violations, vi), off_marker_len(callee_off, String::length(name))))
                        vi = vi + 1
                      }
                    } else {
                      ()
                    },
                    _ => ()
                  }
                  (tab_call_ty(tytab, call_off, subst_apply(s3, ret_ty)), s3, c3)
                },
                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)
              }
            },
            None => {
              Array::push(errors, String::concat("unknown name: ", name))
              (tab_call_ty(tytab, call_off, CtUnknown), s, c)
            }
          }
        } else {
          match direct_call_return(env, name) {
            Some(ret_ty) => {
              let alen = Array::length(args)
              let want_head = builtin_first_arg_head(name)
              // Argument-count check (see `builtin_fixed_arity`). `Bytes::new`
              // is special-cased: 0 args = empty growable buffer, 1 arg =
              // length-n zero-filled (MoonBit semantics, linear backend synth).
              if name == "Bytes::new" {
                if alen > 1 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected 0 or 1 args, got ", __to_string(alen)))), off_marker_len(callee_off, String::length(name))))
                } else {
                  ()
                }
              } else {
                let want_arity = builtin_fixed_arity(name)
                if want_arity >= 0 && alen != want_arity {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected ", String::concat(__to_string(want_arity), String::concat(" args, got ", __to_string(alen)))))), off_marker_len(callee_off, String::length(name))))
                } else {
                  ()
                }
              }
              let mut ai = 0
              let mut s2 = s
              let mut c2 = c
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                // First-argument head check for container/string builtins: the
                // receiver's top-level constructor must match (`Array::length(5)`
                // passes an Int where an Array is required). A non-concrete head
                // (var / generic / unknown) is tolerated.
                if ai == 0 && want_head != 0 {
                  let got_head = head_kind(subst_apply(s2, at))
                  if got_head != 0 && got_head != want_head {
                    Array::push(errors, String::concat(String::concat("argument type mismatch for ", String::concat(name, ": receiver type ")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))
                  } else if want_head == 9 && is_stream_named_type(subst_apply(s2, at)) {
                    // #827: Stream is CtNamed (head 0 = tolerated), so the eager
                    // Array-backed representation leaked through every Array
                    // builtin (`Array::length(stream)` compiled and ran).
                    Array::push(errors, String::concat(String::concat("argument type mismatch for ", String::concat(name, ": receiver type ")), String::concat(type_to_string(subst_apply(s2, at)), String::concat(" is a Stream, not an Array (use `for await` / Stream::*)", off_marker_len(callee_off, String::length(name))))))
                  } else {
                    ()
                  }
                } else if ai >= 1 {
                  // Non-receiver argument head check for fixed-signature builtins
                  // (`String::concat("a", 1)`, `String::substring(s, "x", 2)`).
                  let want_rest = builtin_arg_head_rest(name, ai)
                  if want_rest != 0 {
                    let got_head = head_kind(subst_apply(s2, at))
                    if got_head != 0 && got_head != want_rest {
                      Array::push(errors, String::concat(String::concat("argument type mismatch for ", String::concat(name, String::concat(" (arg ", String::concat(__to_string(ai), "): ")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))
                    } else {
                      ()
                    }
                  } else {
                    ()
                  }
                } else {
                  ()
                }
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
            },
            None => {
              // #736 residual: method-style call with a bare UNRESOLVED callee —
              // `xs |> length` is `length(xs)`, and with only the receiver TYPE
              // imported there is no lexical `length`. Retry as
              // `<type-of-arg0>::length`, the same resolution as `xs.length()`
              // (the EDot arm below), by re-checking in EDot form. Gated on the
              // bare name resolving to nothing (env/builtin) AND the qualified
              // name actually resolving, so a genuinely unknown callee still
              // reports `unknown name` from the normal path below.
              let method_form = if String::index_of(name, "::") < 0 && Array::length(args) >= 1 {
                match env_lookup(env, name) {
                  Some(_) => false,
                  None => match lookup_builtin(name) {
                    Some(_) => false,
                    None => true
                  }
                }
              } else {
                false
              }
              let recv_method = if method_form {
                let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
                let recv_ty = subst_apply(sa, a0_ty)
                let qual = String::concat(type_name_prefix(recv_ty), String::concat("::", name))
                let has_qual = match env_lookup(env, qual) {
                  Some(_) => true,
                  None => match lookup_builtin(qual) {
                    Some(_) => true,
                    None => false
                  }
                }
                // A USER-typed receiver takes the (tolerant) EDot path even when
                // the qualified method is not in THIS module's env: with only the
                // type imported (`import ./list.vibe { List }`), `List::length`
                // lives in the imported module and is resolved by the merged
                // codegen — the per-module checker can't see it, exactly like
                // `xs.length()` (EDot), which types such calls CtUnknown. A
                // non-user receiver (Int/String/...) keeps the strict path so a
                // typo'd `foo(42)` still reports `unknown name`.
                let user_recv = match recv_ty {
                  CtEnum(_) => true,
                  CtStruct(_) => true,
                  CtNamed(_, _) => true,
                  _ => false
                }
                if has_qual || user_recv {
                  Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))
                } else {
                  None
                }
              } else {
                None
              }
              match recv_method {
                Some(rm) => rm,
                None => {
                  let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)
                  let alen = Array::length(args)
                  let arg_tys = array_empty()
                  let mut ai = 0
                  let mut s2 = s1
                  let mut c2 = c1
                  while ai < alen {
                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                    Array::push(arg_tys, at)
                    s2 = ns
                    c2 = nc
                    ai = ai + 1
                  }
                  let applied_callee_ty = match ct {
                    CtFn(_, _, _) => ct,
                    _ => subst_apply(s2, ct)
                  }
                  match applied_callee_ty {
                    CtFn(param_tys, ret, _) => {
                      let ret_box = Array::slice([
                        ret
                      ], 0, 1)
                      let call_param_tys = param_tys
                      let plen2 = Array::length(param_tys)
                      let alen3 = Array::length(arg_tys)
                      if alen3 != plen2 {
                        Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))
                      }
                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)
                      let call_ret = Array::get(ret_box, 0)
                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
                    },
                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
                    other => {
                      // Calling a value whose type is a concrete NON-callable scalar /
                      // aggregate (e.g. `let x = 5; x(3)`) was previously accepted
                      // silently. A type variable / unknown / named (generic) callee
                      // is tolerated — it may yet resolve to a function.
                      let not_callable = match other {
                        CtInt => true,
                        CtDouble => true,
                        CtBool => true,
                        CtString => true,
                        CtChar => true,
                        CtUnit => true,
                        CtBytes => true,
                        CtTuple(_) => true,
                        CtArray(_) => true,
                        // A constructed `Option`/enum value (`let o = Some(1); o(2)`)
                        // is not callable — constructors themselves are typed `CtFn`,
                        // so a `CtOption`/`CtEnum` callee is always a built value.
                        CtOption(_) => true,
                        CtEnum(_) => true,
                        _ => false
                      }
                      if not_callable {
                        Array::push(errors, String::concat(String::concat("calling a non-function value: ", name), off_marker_len(callee_off, String::length(name))))
                      } else {
                        ()
                      }
                      (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
                    }
                  }
                }
              }
            }
          }
        }
      },
      // #897: `mod.x(args)` through a qualified-import namespace parses as
      // ECall(EDot(EIdent(mod), x), args) -- a call whose callee is EDot goes
      // through THIS UFCS/method-call arm, not the standalone EDot arm below,
      // so the same qualified-namespace shortcut is needed here too (see the
      // comment on the standalone `EDot` check_expr arm for the full
      // rationale).
      EDot(obj, method, _, qcall_field_off) => {
        // #897/Codex P2: only take the qualified-import shortcut when `ns`
        // is NOT independently bound -- a real local/param named the same
        // as a qualified-import namespace must shadow it (normal field
        // access on that local's own value), matching how import_alias_
        // rewrite.vibe's alias map is pruned at every binder.
        let qualified_key = match obj {
          EIdent(ns, _) => match env_lookup(env, ns) {
            Some(_) => None,
            None => Some(String::concat(ns, String::concat(".", method)))
          },
          _ => None
        }
        let qualified_hit = match qualified_key {
          Some(k) => env_lookup(env, k),
          None => None
        }
        match qualified_hit {
          Some(_) => match qualified_key {
            Some(k) => check_expr(ECall(EIdent(k, qcall_field_off), args, call_off), env, defs, s, c, errors, tytab),
            None => (CtUnknown, s, c)
          },
          None => {
            let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
            let resolved = subst_apply(s1, obj_ty)
            let type_prefix = type_name_prefix(resolved)
            let qualified = String::concat(type_prefix, String::concat("::", method))
            let has_real_fn_binding = match env_lookup(env, qualified) {
              Some(_) => true,
              None => false
            }
            // #994: `desugar_trait_dict.vibe`'s dot-call lowering (the
            // `EDot(obj, m, ...)` arm, `as_recv_method`) only rewrites a
            // `.method(...)` call into a working `Type::method(...)` call when
            // `fn_exists(fn_returns, qual)` -- i.e. `qual` is a REAL parsed
            // top-level `fn` declaration. `env_lookup` reflects that exact same
            // set of declarations. A `lookup_builtin` hit with NO `env_lookup`
            // hit is a checker-only hardcoded signature (`Array::set`,
            // `String::length`, ...) that has no corresponding parsed fn --
            // codegen's EDot fallback then compiles the call as a struct-field
            // READ and dies with an unlocated "unknown struct field: <method>"
            // regardless of argument types (confirmed by probing EVERY builtin
            // dot-call, well-typed or not: `a.set(0, 42)` fails identically to
            // `a.set(0, "bad")`). Reject these HERE instead of silently
            // accepting a call that can never compile.
            if !has_real_fn_binding && is_known_builtin_receiver_prefix(type_prefix) {
              match lookup_builtin(qualified) {
                Some(_) => {
                  Array::push(errors, String::concat("dot-call syntax is not supported for the builtin method `", String::concat(qualified, String::concat("` -- call it as `", String::concat(qualified, String::concat("(...)`", off_marker_len(qcall_field_off, String::length(method))))))))
                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)
                },
                None => {
                  let bare_hint = match env_lookup(env, method) {
                    Some(_) => String::concat(String::concat("(...)` (a bare `fn ", method), String::concat("` is only callable as `", String::concat(method, String::concat("(x)` or `x |> ", String::concat(method, "`)"))))),
                    None => "(...)`"
                  }
                  Array::push(errors, String::concat(String::concat("no method `", String::concat(method, String::concat("` on `", String::concat(type_prefix, "`: declare a top-level `fn ")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))
                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)
                }
              }
            } else {
              let direct_ret = direct_call_return(env, qualified)
              let method_ty = match env_lookup(env, qualified) {
                Some(t) => {
                  let (ti, c2, _) = instantiate(t, c1)
                  (ti, s1, c2)
                },
                None => match lookup_builtin(qualified) {
                  Some(t) => (t, s1, c1),
                  None => (CtUnknown, s1, c1)
                }
              }
              let (mt, s2, c2) = method_ty
              let all_args = prepend_expr(obj, args)
              let alen = Array::length(all_args)
              let arg_tys = array_empty()
              Array::push(arg_tys, obj_ty)
              let mut ai = 1
              let mut s3 = s2
              let mut c3 = c2
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)
                Array::push(arg_tys, at)
                s3 = ns
                c3 = nc
                ai = ai + 1
              }
              let applied_method_ty = match mt {
                CtFn(_, _, _) => mt,
                _ => subst_apply(s3, mt)
              }
              match applied_method_ty {
                CtFn(param_tys, ret, _) => {
                  let ret_box = Array::slice([
                    ret
                  ], 0, 1)
                  let call_param_tys = param_tys
                  let plen = Array::length(param_tys)
                  let alen2 = Array::length(arg_tys)
                  if alen2 != plen {
                    Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(qualified, String::concat(": expected ", String::concat(__to_string(plen), String::concat(" args, got ", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))
                  }
                  let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)
                  let call_ret = Array::get(ret_box, 0)
                  let selected_ret = match direct_ret {
                    Some(t) => t,
                    None => call_ret
                  }
                  (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)
                },
                _ => {
                  // No method/builtin `T::method` resolved. If the receiver is a
                  // concrete struct whose field `method` holds a FUNCTION, this is a
                  // field-stored-function call `b.f(args)` (the receiver is NOT an
                  // argument). Arg-check the explicit args against the field's
                  // parameter types and use its return type — `(b.f)("s")` with `f:
                  // (Int) -> Int` was otherwise unchecked. Ground-gated via
                  // unify_call_args; generic-struct receivers stay CtUnknown so no
                  // over-rejection.
                  // #829: also resolve the field through an INSTANTIATED generic
                  // struct receiver (`CtNamed(S, targs)`), so `it.pull(x)` on
                  // `LazyIter[Int]` checks against the concrete field signature.
                  let field_fn = receiver_struct_field_type(defs, subst_apply(s3, obj_ty), method)
                  match field_fn {
                    Some(CtFn(fpts, fret, _)) => {
                      let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))
                      if Array::length(fpts) != Array::length(explicit) {
                        Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(qualified, String::concat(": expected ", String::concat(__to_string(Array::length(fpts)), String::concat(" args, got ", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))
                      }
                      let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)
                      (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)
                    },
                    _ => match direct_ret {
                      Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),
                      None => {
                        // #953: method-style call `x.m()` on a receiver whose checked
                        // type is a USER type DECLARED IN THIS CHECK'S defs, with no
                        // `T::m` binding anywhere (env covers the whole program on the
                        // merged FS-compile path, and check_stmts hoists every
                        // top-level SLet — including `fn T::m` declared later — so an
                        // absent binding means the method truly does not exist), no
                        // builtin, and no struct field `m`. Codegen compiles a called
                        // EDot as a struct-field read, so this previously escaped the
                        // checker and died in codegen with an unlocated "unknown
                        // struct field: m". Report it HERE, located at the method
                        // token, with the #736 contract spelled out: dot-calls
                        // resolve `T::m` top-level fns (a BARE `fn m(x: T)` is only
                        // callable as `m(x)` / `x |> m`). Receivers of IMPORTED types
                        // (no local typedef) keep the tolerant CtUnknown path — with
                        // only the type imported, the method lives in the source
                        // module and is resolved by the merged codegen (see the #736
                        // comment on the bare-callee arm above).
                        let no_field = match field_fn {
                          None => true,
                          _ => false
                        }
                        let local_user_ty = if type_prefix == "" {
                          false
                        } else {
                          match find_typedef(defs, type_prefix) {
                            Some(_) => true,
                            None => false
                          }
                        }
                        let has_method_binding = match env_lookup(env, qualified) {
                          Some(_) => true,
                          None => match lookup_builtin(qualified) {
                            Some(_) => true,
                            None => false
                          }
                        }
                        // #994: known builtin receiver prefixes (String/Array/...)
                        // never reach this branch anymore -- they're intercepted
                        // earlier (before `direct_ret`/`method_ty` are computed) so
                        // codegen-unlowerable builtin dot-calls get a located error
                        // instead of silently unifying against a tolerant
                        // `CtUnknown` builtin signature. This diagnostic now only
                        // covers genuinely LOCAL user types.
                        if no_field && local_user_ty && !has_method_binding {
                          let bare_hint = match env_lookup(env, method) {
                            Some(_) => String::concat(String::concat("(...)` (a bare `fn ", method), String::concat("` is only callable as `", String::concat(method, String::concat("(x)` or `x |> ", String::concat(method, "`)"))))),
                            // Codex P2 on #961: with no bare binding of this name,
                            // suggesting `x |> method` re-enters the same fallback
                            // and reproduces this diagnostic — only suggest the
                            // Type::method declaration.
                            None => "(...)`"
                          }
                          Array::push(errors, String::concat(String::concat("no method `", String::concat(method, String::concat("` on `", String::concat(type_prefix, "`: declare a top-level `fn ")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))
                        } else {
                          ()
                        }
                        (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      _ => {
        // #844: intercept the synthetic ascription-lambda call shape
        // `((__asc: T) -> __asc)(val)` that a LOCAL `let x: T = val` desugars
        // to (parser_expr_dispatch.vibe's ascribe_wrap) BEFORE the general
        // callee-dispatch logic below, so its annotation-vs-value check can
        // additionally run `detect_narrowed_generic_mismatch` (closing the
        // #844 same-name generic-struct re-narrowing hole) and
        // `preserve_generic_instantiation` (so the bound local variable keeps
        // its real instantiated type instead of an erased bare one) without
        // touching `unify_call_args` / `check_assignable`, which every OTHER
        // call in the language also goes through.
        let asc_ann = if Array::length(args) == 1 {
          ascription_lambda_ann(callee)
        } else {
          None
        }
        match asc_ann {
          Some(ann_te) => {
            let (at, ns0, nc0) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
            let resolved = resolve_type_expr(ann_te, defs)
            let actual = subst_apply(ns0, at)
            // #981: `check_assignable` now runs the #844 same-name concrete
            // `CtNamed` check itself (its tolerate branch calls
            // `detect_narrowed_generic_mismatch`), so the explicit second
            // call this site used to make would double-report — dropped.
            let ns2 = check_assignable(resolved, actual, ns0, errors, "binding type mismatch for a local let", call_off)
            let bound_ty = preserve_generic_instantiation(resolved, subst_apply(ns2, actual))
            (tab_call_ty(tytab, call_off, bound_ty), ns2, nc0)
          },
          None => {
            let callee_name0 = expr_ident_name_or_empty(callee)
            if callee_name0 != "" {
              match direct_call_return(env, callee_name0) {
                Some(ret_ty) => {
                  let alen = Array::length(args)
                  let mut ai = 0
                  let mut s2 = s
                  let mut c2 = c
                  while ai < alen {
                    let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                    s2 = ns
                    c2 = nc
                    ai = ai + 1
                  }
                  (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
                },
                None => {
                  let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
                  let alen = Array::length(args)
                  let arg_tys = array_empty()
                  let mut ai = 0
                  let mut s2 = s1
                  let mut c2 = c1
                  while ai < alen {
                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                    Array::push(arg_tys, at)
                    s2 = ns
                    c2 = nc
                    ai = ai + 1
                  }
                  let applied_callee_ty = match ct {
                    CtFn(_, _, _) => ct,
                    _ => subst_apply(s2, ct)
                  }
                  match applied_callee_ty {
                    CtFn(param_tys, ret, _) => {
                      let ret_box = Array::slice([
                        ret
                      ], 0, 1)
                      let call_param_tys = param_tys
                      let plen2 = Array::length(param_tys)
                      let alen3 = Array::length(arg_tys)
                      if alen3 != plen2 {
                        Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(callee_name0, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))
                      }
                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)
                      let call_ret = Array::get(ret_box, 0)
                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
                    },
                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
                  }
                }
              }
            } else {
              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
              let alen = Array::length(args)
              let arg_tys = array_empty()
              let mut ai = 0
              let mut s2 = s1
              let mut c2 = c1
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                Array::push(arg_tys, at)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
              let applied_callee_ty = match ct {
                CtFn(_, _, _) => ct,
                _ => subst_apply(s2, ct)
              }
              match applied_callee_ty {
                CtFn(param_tys, ret, _) => {
                  let ret_box = Array::slice([
                    ret
                  ], 0, 1)
                  let call_param_tys = param_tys
                  let plen2 = Array::length(param_tys)
                  let alen3 = Array::length(arg_tys)
                  if alen3 != plen2 {
                    Array::push(errors, String::concat(String::concat("function arity mismatch for <expr>: expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))), off_marker(call_off)))
                  }
                  let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, "<expr>", call_off)
                  let call_ret = Array::get(ret_box, 0)
                  (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
                },
                CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
                _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
              }
            }
          }
        }
      }
    },
    EBinOp(op, left, right) => {
      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)
      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)
      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)
      (subst_apply(s3, result_ty), s3, c2)
    },
    EUnaryOp(op, operand) => {
      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)
      if op == "!" {
        match subst_apply(s1, operand_ty) {
          CtBool => (CtBool, s1, c1),
          CtVar(_) => match unify(operand_ty, CtBool, s1) {
            Some(s2) => (CtBool, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          other => {
            // `!x` on a concrete non-Bool operand (`!5`) was accepted silently.
            // A non-ground/Unknown operand is tolerated (may resolve to Bool).
            let flag = match other {
              CtUnknown => false,
              _ => type_is_ground(other)
            }
            if flag {
              Array::push(errors, "operand of `!` must be Bool")
            } else {
              ()
            }
            (CtUnknown, s1, c1)
          }
        }
      } else if op == "-" {
        match subst_apply(s1, operand_ty) {
          CtDouble => (CtDouble, s1, c1),
          CtInt => (CtInt, s1, c1),
          CtVar(_) => match unify(operand_ty, CtInt, s1) {
            Some(s2) => (CtInt, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          other => {
            // Unary `-` on a concrete non-numeric operand (`-"hi"`) was accepted
            // silently. A non-ground / Unknown operand is tolerated.
            let flag = match other {
              CtUnknown => false,
              _ => type_is_ground(other)
            }
            if flag {
              Array::push(errors, "operand of unary `-` must be Int or Double")
            } else {
              ()
            }
            (CtUnknown, s1, c1)
          }
        }
      } else (CtUnknown, s1, c1)
    },
    EAssign(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      // The assigned value must be assignable to the variable's type
      // (previously unchecked — `y = "s"` for `let mut y = 1` was accepted).
      let s1b = match env_lookup(env, name) {
        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat("assignment type mismatch for ", name), 0 - 1),
        None => s1
      }
      check_expr(body, env, defs, s1b, c1, errors, tytab)
    },
    EAssignOp(_, _, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      check_expr(body, env, defs, s1, c1, errors, tytab)
    },
    EMatch(scrutinee, arms) => {
      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)
      let alen = Array::length(arms)
      if alen == 0 {
        // #809: a match with ZERO arms is only produced by the guard desugar
        // (#666) — `pat if g => body` chains end in `match __mg { }` when NO
        // unguarded arm exists — or by a literal empty `match x { }`. Both
        // reach codegen as an unconditional `unreachable`: every guard failing
        // at runtime trapped with no source location. Reject at compile time.
        Array::push(errors, "non-exhaustive match: no unguarded arm covers the scrutinee (all guards may fail — add an unguarded arm or `_`)")
        (CtUnknown, s1, c1)
      }
      else {
        // #940 Phase 2 baseline: the nested usefulness check below only runs
        // when THIS match produced no other diagnostics (pattern shape / arm
        // type / flat exhaustiveness errors all suppress it — an ill-typed
        // matrix would only yield a garbage witness on top of the real error).
        let exh_base = Array::length(errors)
        let mut result_ty = CtUnknown
        // Whether to cross-check arm types. Enabled only when the first arm's
        // type resolves to a SIMPLE scalar (Int/Double/Bool/String/Char) — that
        // covers the real bug (`match x { 0 => 1, _ => "s" }`) while skipping
        // the per-arm `subst_apply` for matches whose arms yield large tuple /
        // struct / function types (e.g. the compiler's own `(Type, Subst, Int)`
        // returning matches), which would otherwise balloon the self-compile
        // heap. CtUnknown/CtVar/aggregate first arms are left unchecked.
        let mut check_arms = false
        // #941: cross-check arms for Option⇔Result railway-head conflicts
        // when the first arm's type is railway-headed. The full aggregate
        // cross-check stays off (heap cost, see `check_arms` above), but this
        // one conflict is both cheap (head-only) and always genuine — it is
        // exactly the `let*` desugar's failure track (`Err(e)` / `None`)
        // yielding the WRONG monad into a match whose other arms yield the
        // function's annotated one (docs/cheatsheet.md #635).
        let mut railway_arms = false
        let mut si = s1
        let mut ci = c1
        let mut ai = 0
        while ai < alen {
          let (pat, body) = Array::get(arms, ai)
          // #951: `A(v) | B(v) => v` (or any or-pattern binding a variable in
          // either branch) passes `check_pattern` (which only walks the LEFT
          // branch) but codegen has no per-branch binding-extraction path for
          // or-patterns and crashes with an unlocated internal error. Reject
          // it here instead, as a normal located diagnostic.
          if pat_has_unsupported_or_binding(pat) {
            // Anchor on the arm body when it has a usable offset; block /
            // let / literal bodies have none (railway_expr_off => -1), so
            // fall back to the match scrutinee — patterns carry no offsets,
            // and an unlocated reject would defeat the point of this check.
            let body_off = railway_expr_off(body)
            let or_off = if body_off >= 0 {
              body_off
            } else {
              railway_expr_off(scrutinee)
            }
            Array::push(errors, String::concat("or-pattern bindings are not supported yet: `A(v) | B(v)`-style patterns cannot bind variables in an or-branch (rewrite without a shared binding, e.g. separate arms with the same body, or bind after matching)", off_marker(or_off)))
          } else {
            ()
          }
          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)
          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)
          si = ns
          ci = nc
          if ai == 0 {
            result_ty = arm_ty
            let r0 = subst_apply(si, arm_ty)
            check_arms = match r0 {
              CtInt => true,
              CtDouble => true,
              CtBool => true,
              CtString => true,
              CtChar => true,
              _ => false
            }
            railway_arms = railway_head(r0) != 0
          } else {
            if check_arms {
              // Tolerate a `CtUnit` arm (statement-position match); rely on
              // check_assignable's ground/ground gate otherwise. Also tolerate a
              // DIVERGING arm whose body is an early `return` (#635): `val?`
              // lowers to `match val { Some(v) => v, None => return None }` — the
              // `return` arm yields no value to the match, so it must not force
              // the match's result type (it would clash `T` vs `Option[T]`).
              let r2 = subst_apply(si, arm_ty)
              si = if arm_body_diverges(body) {
                si
              } else {
                match r2 {
                  CtUnit => si,
                  _ => check_assignable(result_ty, r2, si, errors, "match arms have incompatible types", 0 - 1)
                }
              }
            } else if railway_arms {
              // #941: report ONLY the Option⇔Result head conflict; every
              // other shape keeps the historical no-cross-check tolerance.
              // Diverging (early-`return`) arms yield no value to the match
              // and are checked at their own EReturn instead.
              if arm_body_diverges(body) {
                ()
              } else {
                let rr0 = subst_apply(si, result_ty)
                let rr2 = subst_apply(si, arm_ty)
                if railway_heads_conflict(rr0, rr2) {
                  Array::push(errors, String::concat("match arms have incompatible types", String::concat(": expected ", String::concat(type_to_string(rr0), String::concat(", got ", String::concat(type_to_string(rr2), off_marker(railway_expr_off(scrutinee))))))))
                } else {
                  ()
                }
              }
            } else {
              ()
            }
          }
          ai = ai + 1
        }
        // Exhaustiveness: when the scrutinee is a concrete user enum, the arms
        // must either include a catch-all (`_` / bind) or cover EVERY variant —
        // otherwise an unhandled variant traps at runtime. Conservative: only a
        // concrete enum whose definition is known is checked; anything else
        // (builtin Option/bool, type vars, non-enum) is left alone.
        let enum_name_opt = match subst_apply(si, scr_ty) {
          CtEnum(en) => Some(en),
          CtNamed(en, _) => Some(en),
          _ => None
        }
        match enum_name_opt {
          Some(en) => match find_typedef(defs, en) {
            Some(TDEnum(_, _, variants)) => {
              let mut has_catchall = false
              let covered = array_empty()
              let mut ax = 0
              while ax < Array::length(arms) {
                let (apat, _) = Array::get(arms, ax)
                if pat_is_catchall(apat) {
                  has_catchall = true
                } else {
                  ()
                }
                collect_ctor_names_into(apat, covered)
                ax = ax + 1
              }
              if has_catchall {
                ()
              } else {
                let mut vi = 0
                while vi < Array::length(variants) {
                  let (vname, _) = Array::get(variants, vi)
                  let mut found = false
                  let mut ci2 = 0
                  while ci2 < Array::length(covered) {
                    if Array::get(covered, ci2) == vname {
                      found = true
                    } else {
                      ()
                    }
                    ci2 = ci2 + 1
                  }
                  if found {
                    ()
                  } else {
                    Array::push(errors, String::concat("non-exhaustive match: variant `", String::concat(vname, String::concat("` of enum ", String::concat(en, " is not handled (add it or a `_` arm)")))))
                  }
                  vi = vi + 1
                }
              }
            },
            _ => ()
          },
          None => ()
        }
        // #940 Phase 1: builtin `Option` and `Bool` scrutinees were not
        // covered by the flat exhaustiveness check AT ALL (the comment above
        // even said so) — `match o { Some(v) => v, Some-only arms }` or a
        // Bool match missing `false` compiled clean and trapped at runtime
        // (codegen's test chain ends in `unreachable`). Checked for
        // MULTI-arm matches, plus (Codex P2 on #980) for ANY match whose
        // scrutinee is the guard desugar's synthesized `__mg` temp: a failed
        // guard falls through to `EMatch(__mg, rest)` (#666), and that
        // residual can have a single arm (`match b { true if g => 1,
        // false => 0 }` leaves `match __mg { false => 0 }` — `b == true &&
        // !g` trapped). A single-arm match over anything else stays
        // tolerated: it is syntactically indistinguishable from the
        // partial-let desugar (`let Some(v) = o`, the cheatsheet's
        // documented idiom), whose scrutinee is the user's own expression,
        // never `__mg`. Nested-pattern completeness (tuples, ctor payloads,
        // literals) is the Phase 2 usefulness algorithm — this closes only
        // the flat gap.
        let flat_guard_residual = match scrutinee {
          EIdent(sn, _) => sn == "__mg",
          _ => false
        }
        if alen >= 2 || flat_guard_residual {
          match subst_apply(si, scr_ty) {
            CtOption(_) => {
              let mut opt_catchall = false
              let opt_covered = array_empty()
              let mut oax = 0
              while oax < Array::length(arms) {
                let (oapat, _) = Array::get(arms, oax)
                if pat_is_catchall(oapat) {
                  opt_catchall = true
                } else {
                  ()
                }
                collect_ctor_names_into(oapat, opt_covered)
                oax = oax + 1
              }
              if opt_catchall {
                ()
              } else {
                if !flat_names_contain(opt_covered, "Some") {
                  Array::push(errors, "non-exhaustive match: variant `Some` of Option is not handled (add it or a `_` arm)")
                } else {
                  ()
                }
                if !flat_names_contain(opt_covered, "None") {
                  Array::push(errors, "non-exhaustive match: variant `None` of Option is not handled (add it or a `_` arm)")
                } else {
                  ()
                }
              }
            },
            CtBool => {
              let mut bool_catchall = false
              let bool_covered = array_empty()
              let mut bax = 0
              while bax < Array::length(arms) {
                let (bapat, _) = Array::get(arms, bax)
                if pat_is_catchall(bapat) {
                  bool_catchall = true
                } else {
                  ()
                }
                collect_bool_pats_into(bapat, bool_covered)
                bax = bax + 1
              }
              if bool_catchall {
                ()
              } else {
                if !flat_names_contain(bool_covered, "true") {
                  Array::push(errors, "non-exhaustive match: `true` is not handled for a Bool scrutinee (add it or a `_` arm)")
                } else {
                  ()
                }
                if !flat_names_contain(bool_covered, "false") {
                  Array::push(errors, "non-exhaustive match: `false` is not handled for a Bool scrutinee (add it or a `_` arm)")
                } else {
                  ()
                }
              }
            },
            _ => ()
          }
        } else {
          ()
        }
        // #940 Phase 2: nested usefulness (Maranget). Same arity gate as the
        // flat checks above; additionally skipped when this match already has
        // any diagnostic (no duplicate/garbage reports on top of a flat
        // non-exhaustiveness or an ill-typed pattern). The ground gate,
        // catch-all fast path and budget cap live inside
        // match_nonexhaustive_witness (checker_exhaustive.vibe).
        if (alen >= 2 || flat_guard_residual) && Array::length(errors) == exh_base {
          let exh_pats = array_empty()
          let mut exh_i = 0
          while exh_i < alen {
            let (exh_p, _) = Array::get(arms, exh_i)
            Array::push(exh_pats, exh_p)
            exh_i = exh_i + 1
          }
          match match_nonexhaustive_witness(subst_apply(si, scr_ty), exh_pats, defs) {
            Some(exh_wit) => Array::push(errors, String::concat("non-exhaustive match: pattern `", String::concat(exh_wit, String::concat("` is not handled (add it or a `_` arm)", off_marker(railway_expr_off(scrutinee)))))),
            None => ()
          }
        } else {
          ()
        }
        (result_ty, si, ci)
      }
    },
    EHandle(body, harms) => {
      let (hty, hs, hc) = check_expr(body, env, defs, s, c, errors, tytab)
      // #813: validate handler arms against DECLARED effects (TDEffect).
      // Previously arms were never checked at all: a typo'd op name silently
      // handled a different op, payload binds carried garbage types, and
      // `resume("oops")` into an Int-returning op compiled. Scope is limited
      // to declared effects — arms for builtin/imported effects (Error etc.)
      // keep the pre-#813 behavior (unchecked) so the compiler's ~4k
      // `with Error` arms are untouched.
      let mut hs1 = hs
      let mut hc1 = hc
      // #954 (Codex P1): when the body's type is unknown (e.g. a bare
      // `throw`), adopt the first ground arm value type as the handle
      // result instead of staying CtUnknown — otherwise
      // `let n: Int = handle { throw("x") } with Error { Throw(_) => "s" }`
      // sailed through and did Int arithmetic on a String.
      let mut hres: Type = hty
      let mut hai = 0
      while hai < Array::length(harms) {
        let (hpat, hbody) = Array::get(harms, hai)
        match hpat {
          PCtor(hqname, hbinds) => {
            let hci = String::index_of(hqname, "::")
            if hci > 0 && effect_is_declared(defs, String::substring(hqname, 0, hci)) {
              match effect_op_sig(defs, hqname) {
                Some(hsig) => {
                  let (hparams, hret) = hsig
                  let hplen = Array::length(hparams)
                  let hblen = Array::length(hbinds)
                  // The op's declared arity, plus optionally one trailing
                  // continuation binder (`Op(v, k)` — the #627 k-convention).
                  // #814: the k-convention only ever ran on the retired
                  // MoonBit fixture runner; this build path compiles
                  // the binder but codegen dies with an internal `undefined
                  // variable (local): k`. Reject it HERE with a located
                  // message until evidence-passing handlers (#817) land.
                  if hblen == hplen + 1 {
                    // #828: this shape is EITHER a payload-arity typo or an
                    // intended k-convention continuation — say both, since a
                    // plain extra binder was misdiagnosed as k-convention.
                    Array::push(errors, String::concat("handler arm ", String::concat(hqname, String::concat(String::concat(" expects ", String::concat(__to_string(hplen), " payload binding(s), got ")), String::concat(__to_string(hblen), " — either drop the extra binder, or if it was meant as a non-tail continuation (k-convention): that is not supported by the build path; use resume(v) (#814, evidence-passing handlers #817)")))))
                  } else if hblen != hplen {
                    Array::push(errors, String::concat("handler arm ", String::concat(hqname, String::concat(" expects ", String::concat(__to_string(hplen), " payload binding(s)")))))
                  } else {
                    ()
                  }
                  // Bind payload names to the op's param types and check the
                  // arm body (the trailing k binder stays CtUnknown).
                  let mut henv = env
                  let mut hbi = 0
                  let mut hbinds_shadow_resume = false
                  while hbi < hblen {
                    match Array::get(hbinds, hbi) {
                      PBind(hbname) => {
                        if hbname == "resume" {
                          hbinds_shadow_resume = true
                        } else {
                          ()
                        }
                        henv = env_bind(henv, hbname, if hbi < hplen {
                          Array::get(hparams, hbi)
                        } else {
                          CtUnknown
                        })
                      },
                      _ => ()
                    }
                    hbi = hbi + 1
                  }
                  // ADR-0076 Phase 3a (#817): `resume` is a first-class
                  // one-shot value inside a declared-effect handler arm —
                  // bind it as (op return type) -> (handle result type) so
                  // an arm can STORE it and call it later (the suspend
                  // class, ADR-0068's Async::suspend). Only check_expr gets
                  // this binding: check_resume_values below keeps the
                  // pre-binding henv so its resume_shadowed detection and
                  // direct-call argument checks are unchanged, and #942's
                  // tail constraint on the DIRECT call form stays in force
                  // (check_arm_resume_tail is a separate syntactic walk that
                  // only looks at call sites — a bare value reference never
                  // trips it). A payload binder literally named `resume`
                  // keeps shadowing (no extra binding on top of it).
                  let henv_arm = if hbinds_shadow_resume {
                    henv
                  } else {
                    env_bind(henv, "resume", CtFn([
                      hret
                    ], subst_apply(hs1, hres), None))
                  }
                  let (harm_ty, hns, hnc) = check_expr(hbody, henv_arm, defs, hs1, hc1, errors, tytab)
                  hs1 = hns
                  hc1 = hnc
                  // #938: a non-resuming arm's value IS the handle result, so
                  // it must unify with the body's type. Resume-tailed arms
                  // type as CtUnknown (builtin resume), which the ground gate
                  // in check_assignable waves through, so only arms returning
                  // a concrete mismatching value are rejected.
                  let hres_now = subst_apply(hs1, hres)
                  let harm_now = subst_apply(hs1, harm_ty)
                  if hres_now is CtUnknown {
                    hres = harm_now
                  } else {
                    hs1 = check_assignable(hres_now, harm_now, hs1, errors, "handler arm value type mismatch with the handle body's type", 0 - 1)
                  }
                  // resume(x): x must be assignable to the op's declared
                  // return type (ground-gated). Throwaway walk — nested
                  // handles are skipped (their resumes belong to inner arms).
                  hs1 = check_resume_values(hbody, hret, henv, defs, hs1, hc1, errors, tytab)
                },
                None => Array::push(errors, String::concat("handler arm `", String::concat(String::substring(hqname, hci + 2, String::length(hqname)), String::concat("` is not an operation of effect ", String::substring(hqname, 0, hci)))))
              }
            } else if hci > 0 && is_exception_effect_name(String::substring(hqname, 0, hci)) {
              // #640 Stage 1: Error arms stay OUT of the #813 arm validation
              // above (payload/arity/exhaustiveness unchanged), but a
              // resume(...) inside one is rejected — Error is non-resumable
              // (`throw` / `perform Error::Throw` unwind for good; the arm's
              // value IS the handle result, so the resume never ran).
              reject_resume_in_error_arm(hbody, errors)
              // #938: an Error arm never resumes, so its value IS the handle
              // result — type the body (Throw's payload binds as String) and
              // unify with the handle body's type. Ground-gated, so arms
              // whose value involves unknowns (throw/rethrow etc.) pass.
              let mut eaenv = env
              if Array::length(hbinds) == 1 {
                match Array::get(hbinds, 0) {
                  PBind(eabname) => {
                    // The payload stays CtUnknown: `throw` accepts any value
                    // (#786 — suberror payloads like `throw(AppError("x"))`
                    // are legal), so pinning String would newly reject valid
                    // `Throw(e) => inspect(e)` handlers (Codex P1 on #954).
                    eaenv = env_bind(eaenv, eabname, CtUnknown)
                  },
                  _ => ()
                }
              } else {
                ()
              }
              let (earm_ty, eans, eanc) = check_expr(hbody, eaenv, defs, hs1, hc1, errors, tytab)
              hs1 = eans
              hc1 = eanc
              let eres_now = subst_apply(hs1, hres)
              let earm_now = subst_apply(hs1, earm_ty)
              if eres_now is CtUnknown {
                hres = earm_now
              } else {
                hs1 = check_assignable(eres_now, earm_now, hs1, errors, "handler arm value type mismatch with the handle body's type", 0 - 1)
              }
            } else {
              ()
            }
          },
          _ => ()
        }
        hai = hai + 1
      }
      // #828: op-arm exhaustiveness for DECLARED effects — a handler covering
      // only some ops compiled and the unhandled perform trapped unreachable
      // at runtime with no message. The checker knows the op set (it already
      // rejects unknown arm names), so require every op to have an arm.
      let hx_eff = array_empty()
      let hx_ops = array_empty()
      let mut hxi = 0
      while hxi < Array::length(harms) {
        let (hxpat, _) = Array::get(harms, hxi)
        match hxpat {
          PCtor(hxq, _) => {
            let hxci = String::index_of(hxq, "::")
            if hxci > 0 && effect_is_declared(defs, String::substring(hxq, 0, hxci)) {
              Array::push(hx_eff, String::substring(hxq, 0, hxci))
              Array::push(hx_ops, String::substring(hxq, hxci + 2, String::length(hxq)))
            } else {
              ()
            }
          },
          _ => ()
        }
        hxi = hxi + 1
      }
      if Array::length(hx_eff) > 0 {
        match find_typedef(defs, Array::get(hx_eff, 0)) {
          Some(TDEffect(_, hx_decl_ops)) => {
            let mut hoi = 0
            while hoi < Array::length(hx_decl_ops) {
              let (hx_op_name, _, _) = Array::get(hx_decl_ops, hoi)
              let mut hx_found = false
              let mut hoj = 0
              while hoj < Array::length(hx_ops) {
                if Array::get(hx_ops, hoj) == hx_op_name {
                  hx_found = true
                } else {
                  ()
                }
                hoj = hoj + 1
              }
              if hx_found {
                ()
              } else {
                Array::push(errors, String::concat("non-exhaustive handler: operation `", String::concat(hx_op_name, String::concat("` of effect ", String::concat(Array::get(hx_eff, 0), " has no arm — performing it would trap at runtime; add an arm for it")))))
              }
              hoi = hoi + 1
            }
          },
          _ => ()
        }
      } else {
        ()
      }
      (hres, hs1, hc1)
    },
    EWhile(cond, body) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "while condition must be Bool")
      }
      let (_, s2, c2) = check_expr(body, env_bind(env, "__in_loop__", CtUnit), defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    ELoop(params, body) => {
      let mut env1 = env
      let mut s1 = s
      let mut c1 = c
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)
        env1 = env_bind(env1, name, pt)
        s1 = ns
        c1 = nc
        i = i + 1
      }
      let (_, s2, c2) = check_expr(body, env_bind(env1, "__in_loop__", CtUnit), defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    EForIn(name, index_name, iterable, body) => {
      // `for await x in s` reaches the checker as `for x in __await_iter(s)`
      // (the parser's marker; the dict-passing desugar strips it for codegen).
      // The marker is not a real function, so check the inner iterable directly.
      let real_iterable = match iterable {
        ECall(callee, args, _) => match callee {
          EIdent(nm, _) => if nm == "__await_iter" && Array::length(args) == 1 {
            Array::get(args, 0)
          } else iterable,
          _ => iterable
        },
        _ => iterable
      }
      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)
      // Element type bound by `for x in it`:
      //   - `Array[T]`                       -> T
      //   - a parameterized iterator type
      //     `C[T, ..]` (`LazyIter[T]`, async `Stream[T]`, `for await`'s
      //     desugared iterator, …) -> its FIRST type argument `T`. By the
      //     iterator convention `next(Self) -> Option[(T, Self)]` the element is
      //     the struct's first type parameter, so it is recoverable from the
      //     iterable's type alone — which matters across modules, where the
      //     `impl Iterator for C` lives in a dependency and is not in this file's
      //     import env (the dict-passing desugar drives codegen off the merged
      //     sources separately). Only `for` loops over a real iterable reach
      //     codegen, so a non-iterator never lands here in a valid program.
      //   - an iterator type with NO type argument (a bare struct value, or
      //     `Stream` in the eager Array-backed model, docs/spec §M2c-3) -> a
      //     fresh unification var, so the loop body's usage constrains the
      //     element instead of `CtUnknown` silently accepting any element use and
      //     dropping element-type safety.
      let it_resolved = subst_apply(s1, it)
      let (et, c1b) = match it_resolved {
        CtArray(elem) => (elem, c1),
        CtNamed(nm, args) => if Array::length(args) > 0 {
          (Array::get(args, 0), c1)
        } else if nm == "Stream" || type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        other => {
          // `for x in 5` over a primitive scalar can never be an iterable and
          // was accepted silently. Only flag the unambiguously non-iterable
          // primitives — a struct/named type may have an Iterator impl in
          // another module (see above), so those stay tolerated.
          let flag = match other {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtUnit => true,
            CtChar => true,
            _ => false
          }
          if flag {
            Array::push(errors, "for loop requires an iterable (Array or iterator)")
          } else {
            ()
          }
          (CtUnknown, c1)
        }
      }
      let env2 = env_bind(env, name, et)
      let env3 = match index_name {
        Some(index_name) => env_bind(env2, index_name, CtInt),
        None => env2
      }
      let (bt, s2, c2) = check_expr(body, env_bind(env3, "__in_loop__", CtUnit), defs, s1, c1b, errors, tytab)
      (CtArray(bt), s2, c2)
    },
    // #897: `mod.x` against a qualified-import namespace (`import ... as mod
    // only { x }`) is bound directly as "mod.x" in env (see
    // qualify_import_items in lib/@vibe/parser/parser.vibe -- bare `mod` is
    // deliberately never bound, so a real identifier can never collide with
    // this key). Whole-program merge later rewrites `EDot(EIdent(mod), x)`
    // straight to the merged/renamed `x` (import_alias_rewrite.vibe), but
    // some lanes (incremental fs_compile) type-check per-file BEFORE that
    // merge runs, so this same shortcut is needed here too: resolve through
    // the qualified binding directly instead of ever checking `mod` alone.
    EDot(obj, field, dot_off, field_off) => {
      // #897/Codex P2: only take the qualified-import shortcut when `ns` is
      // NOT independently bound -- see the matching comment on the ECall
      // callee-is-EDot arm above for the full rationale.
      let qualified_key = match obj {
        EIdent(ns, _) => match env_lookup(env, ns) {
          Some(_) => None,
          None => Some(String::concat(ns, String::concat(".", field)))
        },
        _ => None
      }
      let qualified_hit = match qualified_key {
        Some(k) => env_lookup(env, k),
        None => None
      }
      match qualified_hit {
        Some(_) => match qualified_key {
          Some(k) => check_expr(EIdent(k, field_off), env, defs, s, c, errors, tytab),
          None => (CtUnknown, s, c)
        },
        None => {
          let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
          let resolved = subst_apply(s1, obj_ty)
          let field_ty = match resolved {
            CtStruct(sname) => match find_typedef(defs, sname) {
              Some(td) => match td {
                TDStruct(_, fields, _, _) => {
                  let rec find_field: (Int) -> Option[Type] = (i) -> {
                    if i >= Array::length(fields) {
                      None
                    } else {
                      let (fname, ftype) = Array::get(fields, i)
                      if fname == field {
                        Some(ftype)
                      } else find_field(i + 1)
                    }
                  }
                  match find_field(0) {
                    Some(ft) => ft,
                    None => {
                      Array::push(errors, String::concat(String::concat("unknown field '", String::concat(field, String::concat("' on struct ", sname))), if field_off >= 0 {
                        off_marker_len(field_off, String::length(field))
                      } else {
                        off_marker(dot_off)
                      }))
                      CtUnknown
                    }
                  }
                },
                _ => CtUnknown
              },
              None => CtUnknown
            },
            // #829: field read through an INSTANTIATED generic struct value —
            // substitute the declared type params with the receiver's type args so
            // `b.v` on `Box[Int]` is `Int` (previously the whole read was
            // CtUnknown, letting `String::length(b.v)` compile to silent garbage).
            // A CtNamed head that is not a known struct (Stream/i64/unresolved
            // type params, cross-module names) stays tolerated as before.
            CtNamed(gname, gargs) => match find_typedef(defs, gname) {
              Some(td) => match td {
                TDStruct(_, gfields, _, gtparams) => {
                  let rec find_field_g: (Int) -> Option[Type] = (i) -> {
                    if i >= Array::length(gfields) {
                      None
                    } else {
                      let (fname, ftype) = Array::get(gfields, i)
                      if fname == field {
                        Some(ftype)
                      } else find_field_g(i + 1)
                    }
                  }
                  match find_field_g(0) {
                    Some(ft) => inst_struct_field_ty(ft, gtparams, gargs),
                    None => {
                      Array::push(errors, String::concat(String::concat("unknown field '", String::concat(field, String::concat("' on struct ", gname))), if field_off >= 0 {
                        off_marker_len(field_off, String::length(field))
                      } else {
                        off_marker(dot_off)
                      }))
                      CtUnknown
                    }
                  }
                },
                _ => CtUnknown
              },
              None => CtUnknown
            },
            // `t.N` tuple projection: the index must be in range, else it reads an
            // out-of-bounds slot (`(1, 2).5` was accepted). When `field` is a
            // numeric index and the tuple arity is known, bounds-check it.
            CtTuple(elems) => match parse_tuple_index(field) {
              Some(idx) => if idx >= 0 && idx < Array::length(elems) {
                Array::get(elems, idx)
              } else {
                Array::push(errors, String::concat(String::concat("tuple index ", String::concat(field, String::concat(" out of range for a ", String::concat(__to_string(Array::length(elems)), "-tuple")))), if field_off >= 0 {
                  off_marker_len(field_off, String::length(field))
                } else {
                  off_marker(dot_off)
                }))
                CtUnknown
              },
              None => CtUnknown
            },
            // Field access on a concrete NON-struct value (`o.x` where `o :
            // Option[P]`, or a scalar / function) is a type error — only structs
            // (and tuple `.N`) have fields. Type vars / unknown / named scrutinees
            // are tolerated; CtString/CtBytes/CtArray are NOT flagged because `.m`
            // on them parses as a method call elsewhere, not a value-position EDot.
            other => {
              let not_struct = match other {
                CtInt => true,
                CtDouble => true,
                CtBool => true,
                CtChar => true,
                CtUnit => true,
                CtOption(_) => true,
                CtFn(_, _, _) => true,
                _ => false
              }
              if not_struct {
                Array::push(errors, String::concat(String::concat("field access `.", String::concat(field, "` on a non-struct value")), if field_off >= 0 {
                  off_marker_len(field_off, String::length(field))
                } else {
                  off_marker(dot_off)
                }))
              } else {
                ()
              }
              CtUnknown
            }
          }
          // Record this field-access node's (raw, pre-final-subst) projection type
          // keyed by its real source offset, for typed-hover on `obj.field`.
          // Synthetic accesses (dot_off < 0) are skipped. #645: the field token's
          // own offset gets the same entry, so hovering the field NAME (not just
          // the base) resolves the projection type.
          if dot_off >= 0 {
            Array::push(tytab, (dot_off, field_ty))
          } else {
            ()
          }
          if field_off >= 0 && field_off != dot_off {
            Array::push(tytab, (field_off, field_ty))
          } else {
            ()
          }
          (field_ty, s1, c1)
        }
      }
    },
    EFn(tparams, tbounds, params, ret_ty, effect, body) => {
      let tplen = Array::length(tparams)
      let mut tp_env = env
      let mut s0 = s
      let mut c0 = c
      let mut tpi = 0
      while tpi < tplen {
        let tpname = Array::get(tparams, tpi)
        match fresh_var(c0) {
          (tv, nc) => {
            let vid = nc - 1
            let tblen = Array::length(tbounds)
            let mut bounds = array_empty()
            let mut tbi = 0
            let mut found_bounds = false
            while tbi < tblen {
              let (bname, blist) = Array::get(tbounds, tbi)
              if !found_bounds && bname == tpname {
                bounds = blist
                found_bounds = true
              }
              tbi = tbi + 1
            }
            s0 = if Array::length(bounds) == 0 {
              s0
            } else subst_add_bound(s0, vid, bounds)
            tp_env = env_bind(tp_env, tpname, tv)
            c0 = nc
          },
          _ => ()
        }
        tpi = tpi + 1
      }
      let plen = Array::length(params)
      let mut fn_env = tp_env
      let mut s1 = s0
      let mut c1 = c0
      let param_types = array_empty()
      let mut pi = 0
      while pi < plen {
        let (raw_name, ann) = Array::get(params, pi)
        let nlen = String::length(raw_name)
        let name = if nlen > 0 {
          let lc = String::char_code_at(raw_name, nlen - 1)
          if lc == '~' || lc == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        let (pt, ns, nc) = match ann {
          Some(te) => {
            let resolved = resolve_type_expr(te, defs)
            let pt2 = resolve_tparams_in(resolved, fn_env)
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        fn_env = env_bind(fn_env, name, pt)
        Array::push(param_types, pt)
        s1 = ns
        c1 = nc
        pi = pi + 1
      }
      // Bind the function's annotated return type under a sentinel so an
      // explicit `return e` inside the body can be checked against it (the body
      // value is checked below, but `return` short-circuits and was otherwise
      // unchecked — `() -> Int { return "x" }` was accepted). Nested functions
      // rebind the sentinel, so `return` always targets the nearest enclosing
      // function's type.
      // #964 (Codex P2 on #941): an UNANNOTATED function must SHADOW the
      // sentinel too (bind CtUnknown), not inherit the enclosing function's.
      // `return` targets the nearest enclosing function, so a `return Ok(1)`
      // inside an unannotated lambda nested in a `-> Option[Int]` fn belongs
      // to the LAMBDA — checking it against the OUTER annotation wrongly
      // rejected it once the #941 railway-conflict report landed. CtUnknown
      // unifies with anything, so the EReturn check is inert for it.
      let body_env = match ret_ty {
        Some(rte) => env_bind(fn_env, "__return__", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),
        None => env_bind(fn_env, "__return__", CtUnknown)
      }
      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)
      let (final_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr(te, defs)
          let resolved_ret = resolve_tparams_in(resolved, fn_env)
          match unify(bt, resolved_ret, s2) {
            Some(ns) => (subst_apply(ns, resolved_ret), ns),
            None => {
              Array::push(errors, String::concat("return type mismatch: expected ", String::concat(type_to_string(resolved_ret), String::concat(", got ", type_to_string(bt)))))
              (CtUnknown, s2)
            }
          }
        },
        None => (subst_apply(s2, bt), s2)
      }
      (CtFn(param_types, final_ret, effect), s3, c2)
    },
    EBreak(opt) => {
      // `break` is only meaningful inside a loop. Loop bodies bind the
      // `__in_loop__` sentinel; its absence means this `break` is outside any
      // loop (`() -> { break }`). Threaded through env, so if/match/let/seq
      // inside a loop still see it; a nested function does not introduce one, so
      // a `break` there is (conservatively) left unchecked rather than flagged.
      match env_lookup(env, "__in_loop__") {
        Some(_) => (),
        None => Array::push(errors, "`break` outside a loop")
      }
      match opt {
        Some(e) => {
          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
          (CtUnit, s1, c1)
        },
        None => (CtUnit, s, c)
      }
    },
    EContinue(args) => {
      match env_lookup(env, "__in_loop__") {
        Some(_) => (),
        None => Array::push(errors, "`continue` outside a loop")
      }
      let alen = Array::length(args)
      let mut s1 = s
      let mut c1 = c
      let mut ai = 0
      while ai < alen {
        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtUnit, s1, c1)
    },
    ERecord(rn, fields, targs) => {
      let flen = Array::length(fields)
      let mut s1 = s
      let mut c1 = c
      let field_tys = array_empty()
      let mut fi = 0
      while fi < flen {
        let (fname, fval) = Array::get(fields, fi)
        // A field may be given only once in a record literal (`P::{ x: 1, x: 2 }`
        // silently kept the last). Report a duplicate by scanning the names
        // already collected.
        let mut dj = 0
        let mut dup = false
        while dj < Array::length(field_tys) {
          let (pn, _) = Array::get(field_tys, dj)
          if pn == fname {
            dup = true
          } else {
            ()
          }
          dj = dj + 1
        }
        if dup {
          Array::push(errors, String::concat("duplicate field `", String::concat(fname, "` in record literal")))
        } else {
          ()
        }
        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)
        Array::push(field_tys, (fname, ft))
        s1 = ns
        c1 = nc
        fi = fi + 1
      }
      // #810: a NAMED struct literal `S::{ ... }` (rn carries the parsed
      // struct name since the ERecord arity bump) is validated against S's
      // declaration by NAME — the field-set heuristics below cannot tell a
      // typo'd `Point::{ x, z }` from an intentional anonymous
      // `record { x, z }`, so before this check a same-count wrong-name
      // field silently landed in another field's slot. Anonymous literals
      // (rn == "") keep the field-set path unchanged.
      if rn != "" {
        match find_typedef(defs, rn) {
          Some(td) => match td {
            TDStruct(_, dfields, _, s_tparams) => {
              // Unknown literal fields (present in the literal, absent from
              // the declaration).
              let mut ui = 0
              while ui < Array::length(field_tys) {
                let (an, _) = Array::get(field_tys, ui)
                let mut known = false
                let mut uj = 0
                while uj < Array::length(dfields) {
                  let (dn, _) = Array::get(dfields, uj)
                  if dn == an {
                    known = true
                  } else {
                    ()
                  }
                  uj = uj + 1
                }
                if !known {
                  Array::push(errors, String::concat("unknown field `", String::concat(an, String::concat("` for struct ", rn))))
                } else {
                  ()
                }
                ui = ui + 1
              }
              // #829: instantiate a GENERIC struct's declared type params with
              // fresh inference vars, so the field values determine the
              // construction's concrete type arguments (`Box::{ v: 1 }` is
              // `Box[Int]`, not CtUnknown → its field reads become checkable).
              //
              // #886: EXPLICIT type arguments (`Pair[Int]::{ .. }`) pin the
              // instantiation instead: each declared param is substituted by
              // the resolved explicit argument (no fresh var), so field values
              // are checked against the pinned types (mismatches surface as
              // `struct field type mismatch for <f>`) and the construction's
              // type is exactly `CtNamed(rn, <explicit args>)` even when the
              // field values alone could not determine a param (e.g. an
              // empty-array field). An arity mismatch reports an error and
              // falls back to #829's inference to avoid cascading errors.
              let tplen = Array::length(s_tparams)
              let ntargs = Array::length(targs)
              if ntargs > 0 && ntargs != tplen {
                Array::push(errors, "struct \{rn} expects \{tplen} type argument(s), got \{ntargs} in `\{rn}[...]::{ ... }` (#886 explicit struct type arguments)")
              }
              let use_explicit = ntargs > 0 && ntargs == tplen
              let fresh_targs = array_empty()
              let mut c2 = c1
              let mut tpi = 0
              while tpi < tplen {
                if use_explicit {
                  // Resolve through the generic environment (same as param /
                  // return annotations, ~line 3252): an explicit argument
                  // naming an ENCLOSING fn's type parameter (`fn make[T](x:
                  // T) -> Box[T] { Box[T]::{ v: x } }`) must become the
                  // env-bound CtVar, not a rigid CtNamed("T") — otherwise the
                  // construction's type loses its link to the quantified
                  // param and `make(42).v` fails as `expected Int, got T`
                  // (Codex review, PR #926).
                  Array::push(fresh_targs, resolve_tparams_in(resolve_type_expr(Array::get(targs, tpi), defs), env))
                } else {
                  match fresh_var(c2) {
                    (tv, nc) => {
                      Array::push(fresh_targs, tv)
                      c2 = nc
                    },
                    _ => ()
                  }
                }
                tpi = tpi + 1
              }
              // Missing declared fields (absent from the literal).
              let mut mi = 0
              while mi < Array::length(dfields) {
                let (dn, dty0) = Array::get(dfields, mi)
                // Check field values against the INSTANTIATED declared type
                // (rigid params substituted by the fresh vars above); a
                // non-generic struct keeps the raw declared type as before.
                let dty = if tplen > 0 {
                  subst_type_params(dty0, s_tparams, fresh_targs)
                } else {
                  dty0
                }
                match lookup_actual_field_ty(field_tys, dn) {
                  Some(aty) => {
                    // Value type check (ground-gated like check_record_fields).
                    s1 = check_assignable(dty, subst_apply(s1, aty), s1, errors, String::concat("struct field type mismatch for ", dn), 0 - 1)
                  },
                  None => Array::push(errors, String::concat("missing field `", String::concat(dn, String::concat("` in construction of struct ", rn))))
                }
                mi = mi + 1
              }
              // Struct identity: a monomorphic struct keeps `CtStruct(rn)`;
              // a GENERIC struct now gets its instantiated nominal type
              // `CtNamed(rn, args)` (#829 — previously CtUnknown, which made
              // every downstream use of the value unchecked). A non-ground
              // struct WITHOUT declared params (unresolved field type names)
              // keeps the old CtUnknown tolerance.
              if struct_fields_ground(dfields) {
                (CtStruct(rn), s1, c2)
              } else if tplen > 0 {
                let inst_targs = for ta in fresh_targs {
                  subst_apply(s1, ta)
                }
                (CtNamed(rn, inst_targs), s1, c2)
              } else {
                (CtUnknown, s1, c2)
              }
            },
            _ => {
              Array::push(errors, String::concat("`", String::concat(rn, "` is not a struct (struct literal)")))
              (CtUnknown, s1, c1)
            }
          },
          // Unknown name: fall back to the anonymous field-set path instead
          // of erroring — the merge layer's private-struct rename and alias
          // imports can leave rn referring to a pre-rename spelling that the
          // merged defs no longer contain. The typo detection above still
          // fires for the common case (the struct EXISTS and a field name is
          // wrong).
          None => {
            let s2f = check_record_fields(defs, field_tys, s1, errors)
            let rec_tyf = match resolve_record_struct_name(defs, field_tys) {
              Some(sname) => CtStruct(sname),
              None => CtUnknown
            }
            (rec_tyf, s2f, c1)
          }
        }
      } else {
        // Check the field values against the matching struct's declared types.
        let s2 = check_record_fields(defs, field_tys, s1, errors)
        // Recover the struct identity (when unambiguous) so downstream uses — in
        // particular `mut`-field write checking — see a concrete `CtStruct`.
        let rec_ty = match resolve_record_struct_name(defs, field_tys) {
          Some(sname) => CtStruct(sname),
          None => CtUnknown
        }
        (rec_ty, s2, c1)
      }
    },
    ETuple(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let tys = array_empty()
      let mut ti = 0
      while ti < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)
        Array::push(tys, it)
        s1 = ns
        c1 = nc
        ti = ti + 1
      }
      (CtTuple(tys), s1, c1)
    },
    EArray(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let mut elem_ty = CtUnknown
      // Cross-check elements only when the first element is a simple scalar, or
      // a one-level array of scalars (`[[1], ["x"]]` — `Array[Int]` vs
      // `Array[String]`) — see EMatch: this catches the cheap, bounded cases
      // while skipping the per-element `subst_apply` for arrays of large
      // struct/tuple values that pressure the self-compile heap.
      let mut check_elems = false
      let mut ai = 0
      while ai < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        if ai == 0 {
          elem_ty = it
          check_elems = match subst_apply(s1, it) {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtString => true,
            CtChar => true,
            CtArray(inner) => match inner {
              CtInt => true,
              CtDouble => true,
              CtBool => true,
              CtString => true,
              CtChar => true,
              _ => false
            },
            _ => false
          }
        } else {
          if check_elems {
            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, "array elements have incompatible types", 0 - 1)
          } else {
            ()
          }
        }
        ai = ai + 1
      }
      (CtArray(elem_ty), s1, c1)
    },
    EReturn(e) => {
      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
      // Check the returned value against the enclosing function's annotated
      // return type (bound as `__return__` by the EFn arm). Ground-gated via
      // check_assignable, so a generic return type is not over-rejected.
      match env_lookup(env, "__return__") {
        Some(rt) => {
          let rte = subst_apply(s1, rt)
          let ate = subst_apply(s1, et)
          // #941: an Option⇔Result railway-head conflict is a genuine
          // mismatch, but check_assignable tolerates it (a `CtNamed` head is
          // neither reportable nor a differing head_kind). Report it directly
          // — this is exactly the `?`-desugar's early `return Err(e)` /
          // `return None` escaping a function annotated with the OTHER monad
          // (docs/cheatsheet.md #635: mixing is a type error).
          if railway_heads_conflict(rte, ate) {
            Array::push(errors, String::concat("return type mismatch", String::concat(": expected ", String::concat(type_to_string(rte), String::concat(", got ", String::concat(type_to_string(ate), off_marker(railway_expr_off(e))))))))
          } else {
            let _ = check_assignable(rte, ate, s1, errors, "return type mismatch", 0 - 1)
            ()
          }
        },
        None => ()
      }
      // The expression value of `return e` is `e`'s type, not CtUnknown. A lambda
      // whose body is a bare `return e` (`(n) -> { return n }`) otherwise inferred
      // a CtUnknown return type, so when its type came from OUTER unification
      // (`let g: (Int) -> String = (n) -> { return n }`) the return/result
      // mismatch was hidden — the no-`return` form `(n) -> { n }` is rejected, so
      // the `return` form must be too. Propagating `et` makes them identical.
      (et, s1, c1)
    },
    EMap(mpairs) => {
      // #938: map literals were entirely untyped (fell through to CtUnknown),
      // so `map { "a": 1, "b": "two" }` compiled and the stray String read
      // back as a garbage Int. Check each entry and require pairwise
      // homogeneous keys/values, ground-gated exactly like array literals
      // (only when the first key/value type is a simple ground type).
      let mut ms1 = s
      let mut mc1 = c
      let mut mvty: Type = CtUnknown
      let mut mchk_v = false
      let mut mi = 0
      while mi < Array::length(mpairs) {
        let (_, mve) = Array::get(mpairs, mi)
        let (mvt, mvs, mvc) = check_expr(mve, env, defs, ms1, mc1, errors, tytab)
        ms1 = mvs
        mc1 = mvc
        if mi == 0 {
          mvty = mvt
          mchk_v = map_literal_ground(subst_apply(ms1, mvt))
        } else {
          if mchk_v {
            ms1 = check_assignable(mvty, subst_apply(ms1, mvt), ms1, errors, "map literal values have incompatible types", 0 - 1)
          } else {
            ()
          }
        }
        mi = mi + 1
      }
      // #983: surface the literal's value type as a REAL slot —
      // `CtNamed("Map", [CtString, v])`, the exact shape a `Map[String, V]`
      // annotation resolves to (checker_resolve's TyApp fallback) — so
      // `Map::set`/`Map::get` can check against it. An empty literal
      // (`Map::new()`) gets a fresh var; a let-bound empty map GENERALIZES
      // (#996 Codex P2: `Map::set` is a functional update, so aliases of the
      // empty binding build independent maps — no value restriction; each
      // use re-instantiates a fresh slot, bound by that use's own flow).
      if Array::length(mpairs) == 0 {
        let (mv0, mc2) = fresh_var(mc1)
        (CtNamed("Map", [
          CtString,
          mv0
        ]), ms1, mc2)
      } else {
        (CtNamed("Map", [
          CtString,
          subst_apply(ms1, mvty)
        ]), ms1, mc1)
      }
    },
    ELabeledArg(_, _, la_val) => {
      // #986: desugar_labeled_args (run before checking — see check_program)
      // RESOLVES labeled args whose callee's parameter names are known in this
      // module: it reorders fully-labeled calls into declared order and strips
      // the ELabeledArg wrappers, so those values reach the strict positional
      // unification as plain args. An ELabeledArg that SURVIVES to this arm
      // therefore has no label→position resolution available here — the
      // callee is import-resolved (its param names live in another module,
      // Codex P2-1 on #993), locally shadowed, a builtin with decorative flag
      // labels (`sh_lines("ls", a = true)`), or an erroneous local shape that
      // check_labeled_arg_names_stmts reports by name. Check the value for
      // nested diagnostics but type the arg CtUnknown, so an unresolvable
      // label is never falsely rejected by position.
      let (_, la_s, la_c) = check_expr(la_val, env, defs, s, c, errors, tytab)
      (CtUnknown, la_s, la_c)
    },
    _ => (CtUnknown, s, c)
  }
}

fn map_literal_ground(t: Type) -> Bool {
  match t {
    CtInt => true,
    CtDouble => true,
    CtBool => true,
    CtString => true,
    CtChar => true,
    _ => false
  }
}
