      if tplen > 0 {
        let mut hbi = 0
        while hbi < tplen {
          let hid = Array::get(tparam_ids, hbi)
          if int_array_has(keep_ids, hid) {
            ()
          } else {
            match subst_lookup(s3, hid) {
              Some(t) => {
                let tvs = collect_tvars(subst_apply(s3, t))
                let mut tvi = 0
                while tvi < Array::length(tvs) {
                  let tv = Array::get(tvs, tvi)
                  if int_array_has(head_bound_vars, tv) || int_array_has(tparam_ids, tv) {
                    ()
                  } else {
                    Array::push(head_bound_vars, tv)
                  }
                  tvi = tvi + 1
                }
              },
              None => ()
            }
          }
          hbi = hbi + 1
        }
      } else {
        ()
      }
      let head_bound_env = if Array::length(head_bound_vars) == 0 {
        array_empty()
      } else {
        env_reachable_tvars(expr, env, s3, None)
      }
      let mut sfi = 0
      while sfi < tplen {
        let sfid = Array::get(tparam_ids, sfi)
        if int_array_has(keep_ids, sfid) {
          ()
        } else {
          Array::push(efn_substituted_formals, sfid)
        }
        sfi = sfi + 1
      }
      let inferred_ret = subst_apply_except(s3, final_ret, keep_ids)
      let scheme_ret_raw = match ret_ty {
        Some(te) => subst_apply_except(s3, resolve_tparams_in(resolve_type_expr_shadowed(te, defs, formal_shadow(te, env, tparams)), scheme_env), keep_ids),
        None => inferred_ret
      }
      let scheme_ret = merge_capture_provenance(scheme_ret_raw, inferred_ret)
      let scheme_params = array_empty()
      let mut spi2 = 0
      while spi2 < plen {
        let inferred_pt = subst_apply_except(s3, Array::get(param_types, spi2), keep_ids)
        match Array::get(params, spi2) {
          (_, Some(pte)) => Array::push(scheme_params, merge_capture_provenance(subst_apply_except(s3, resolve_tparams_in(resolve_type_expr_shadowed(pte, defs, formal_shadow(pte, env, tparams)), scheme_env), keep_ids), inferred_pt)),
          _ => Array::push(scheme_params, inferred_pt)
        }
        spi2 = spi2 + 1
      }
      let fn_ty = if tplen == 0 {
        CtFn(param_types, final_ret, lambda_effect_inst_row(dependency_effect, effect, effect_inst_pairs))
      } else {
        CtFn(scheme_params, scheme_ret, dependency_effect)
      }
      if tplen == 0 {
        (fn_ty, s3, c2)
      } else {
        let var_bounds = array_empty()
        let mut vbi = 0
        while vbi < tplen {
          let vid = Array::get(tparam_ids, vbi)
          let bl = subst_bounds_for(s3, vid)
          if Array::length(bl) != 0 {
            Array::push(var_bounds, (vid, bl))
          } else {
            ()
          }
          vbi = vbi + 1
        }
        // #3149: the head-bound formals' own variables, quantified after the
        // formals (so a positional reading of the first `tplen` ids is kept).
        let scheme_ids = array_empty()
        for tid in tparam_ids {
          Array::push(scheme_ids, tid)
        }
        for hv in head_bound_vars {
          if int_array_has(head_bound_env, hv) {
            ()
          } else {
            Array::push(scheme_ids, hv)
            Array::push(keep_ids, hv)
            let hbl = subst_bounds_for(s3, hv)
            if Array::length(hbl) != 0 {
              Array::push(var_bounds, (hv, hbl))
            } else {
              ()
            }
          }
        }
        (CtForAll(scheme_ids, var_bounds, subst_apply_except(s3, fn_ty, keep_ids)), s3, c2)
      }
    },
    _ => (CtUnknown, s, c)
  }
}
