            // the #1869 reserved-prefix rule (desugar_trait_dict.vibe), and
            // that is the actionable edit -- reporting its annotation on top
            // would only bury it, since a witness dictionary's type has no
            // TypeDef either.
            if String::starts_with(name, "__dict_") {
              ()
            } else {
              report_unknown_type_names(te, defs, tparams, fn_env, declared_row_binders, String::concat(String::concat("parameter `", name), "`"), errors)
              report_formal_applications(te, tparams, String::concat(String::concat("parameter `", name), "`"), errors)
            }
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        // #3276: a `TaskGroup::run` body's group parameter carries the call's
        // region from the start, so every write in the body sees it. An
        // annotation that disagrees is left to the call's own unification,
        // which reports the mismatch.
        let ns = if plen == 1 {
          match run_body_param {
            Some(expected) => match unify(pt, expected, ns) {
              Some(seeded) => seeded,
              None => ns
            },
            None => ns
          }
        } else {
          ns
        }
        // #3343: a region re-check binds the parameter to its argument's type
        // at the call being judged -- the annotation may spell it without the
        // region (`TaskHandle[Int]`) -- marks it an alias of an outer binding
        // for the regions that argument's location predates, and records what
        // a function argument is, so a call of the parameter is judged too.
        let has_override = pi < Array::length(retention_override)
        let (pt, ns) = if has_override {
          let (expected, _, _, _) = Array::get(retention_override, pi)
          match unify(pt, expected, ns) {
            Some(seeded) => (expected, seeded),
            None => (expected, ns)
          }
        } else {
          (pt, ns)
        }
        let marked_pt = add_param_capture_dependency(pt, nc)
        let marked_nc = nc + 1
        fn_env = env_bind(fn_env, name, marked_pt)
        fn_env = env_bind(fn_env, String::concat("__param_marker__", name), CtNamed(String::concat("#param[", String::concat(__to_string(nc), "]")), [
        ]))
        if has_override {
          let (_, predates, callee, carried) = Array::get(retention_override, pi)
          // What the argument carries where its type does not show it (a
          // struct built from the token), so a write of the parameter is
          // judged by the argument's value rather than by every region the
          // parameter is declared inside.
          fn_env = retention_bind_param_carry(fn_env, name, carried)
          if Array::length(predates) > 0 {
            fn_env = env_bind(fn_env, String::concat("__region_outer_alias__", name), CtTuple(for rname in predates {
              CtNamed(rname, [])
            }))
          } else {
            ()
          }
          fn_env = retention_bind_param_callee(fn_env, name, callee)
        } else {
          ()
        }
        Array::push(param_types, marked_pt)
        s1 = ns
        c1 = marked_nc
        pi = pi + 1
      }
      // #3152: inside a spawn-shaped function, its closure parameter is
      // checked at every call site (the call branch keys on this same
      // shape), so a spawned closure may capture or pass it on.
      if plen >= 2 && param_types_are_spawn_shaped(param_types) {
        let (last_raw, _) = Array::get(params, plen - 1)
        let last_len = String::length(last_raw)
        let last_name = if last_len > 0 {
          let lc = String::char_code_at(last_raw, last_len - 1)
          if lc == '~' || lc == '?' {
            last_raw[0: last_len - 1]
          } else last_raw
        } else last_raw
        fn_env = env_bind(fn_env, spawn_safe_marker(last_name), CtUnit)
      } else {
        ()
      }
      // Bind the function's annotated return type under a sentinel so an
      // explicit `return e` inside the body can be checked against it (the body
      // value is checked below, but `return` short-circuits and was otherwise
      // unchecked — `() -> Int { return "x" }` was accepted). Nested functions
      // rebind the sentinel, so `return` always targets the nearest enclosing
      // function's type.
      // #964 (Codex P2 on #941): an UNANNOTATED function must SHADOW the
      // sentinel too (bind CtUnknown), not inherit the enclosing function's.
      // `return` targets the nearest enclosing function, so a `return Ok(1)`
      // inside an unannotated lambda nested in a `-> Option[Int]` fn belongs
      // to the LAMBDA — checking it against the OUTER annotation wrongly
      // rejected it once the #941 railway-conflict report landed. CtUnknown
      // unifies with anything, so the EReturn check is inert for it.
      let annotated_body_env = match ret_ty {
        Some(rte) => {
          // #2125: see the parameter arm above.
          report_unknown_type_names(rte, defs, tparams, fn_env, declared_row_binders, "the return type", errors)
          report_formal_applications(rte, tparams, "the return type", errors)
          env_bind(fn_env, "__return__", resolve_tparams_in(resolve_type_expr_shadowed(rte, defs, formal_shadow(rte, env, tparams)), fn_env))
        },
        None => env_bind(fn_env, "__return__", CtUnknown)
      }
      let (return_provenance, return_c) = fresh_var(c1)
      let return_env = env_bind(annotated_body_env, "__return_provenance__", return_provenance)
      let top_level = match env_lookup(env, "#interp.top.fn") {
        Some(CtBool) => true,
        _ => false
      }
      // Only a direct top-level declaration is expanded by collect_show_shims.
      // Consume the marker so a nested lambda cannot inherit the exemption.
      // #3341: a lambda also records the instantiations it performs at, so the
      // place it is used can compare them (`effect_inst_pairs`).
      let (row_inst_env, s1_inst, c1_inst, effect_inst_pairs) = bind_lambda_effect_instantiations(return_env, effect, defs, tparams, errors, s1, return_c, top_level, tplen > 0)
      let body_env = env_bind(env_bind(row_inst_env, "#interp.top.fn", CtUnit), "#interp.shim.body", if top_level && interp_is_shim_body(params, body) {
        CtBool
      } else {
        CtUnit
      })
      let (bt, s2_body, c2) = check_child(body, body_env, defs, s1_inst, c1_inst, errors, tytab, capture, lane)
      // #3343 (Codex on #3359): a region re-check asks which regions this
      // lambda's RESULT carries -- by the body's own type, before any return
      // annotation can hide it, or, where the type may hide one, by what the
      // values it returns (its tail and every explicit `return`) read.
      if retention_rechecking {
        let body_ty = subst_apply(s2_body, bt)
        // The values explicit `return`s hand back, merged by the EReturn arm.
        let returned_ty = subst_apply(s2_body, return_provenance)
        let hidden = if retention_type_hides_region(body_ty, defs) || retention_type_hides_region(returned_ty, defs) {
          retention_result_regions(body, body_env, defs, s2_body)
        } else {
          array_empty()
        }
        let carried = array_empty()
        for rname in retention_active_region_names(body_env) {
          if type_mentions_named(body_ty, rname) || type_mentions_named(returned_ty, rname) || retention_region_listed(hidden, rname) {
            Array::push(carried, rname)
          } else {
            ()
          }
        }
        retention_note_result(carried)
      } else {
        ()
      }
      // #2848: a field read on a receiver that was unsolved when checked (an
      // unannotated parameter of a lambda in this body) may have been solved
      // by a call in this body. Judge it now, while this declaration's own
      // formals are still open, so a parameter that became `T` is refused as
      // `T` and one that became a concrete type gets the concrete verdict.
      // The substitution comes back extended by the resolved reads' result
      // variables, so the body type below already carries the field types.
      let s2 = resolve_deferred_field_reads(s2_body, defs, errors, true)
      if eq_gid >= 0 {
        eq_group_end()
      } else {
        ()
      }
      let (base_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr_shadowed(te, defs, formal_shadow(te, env, tparams))
          let resolved_ret = resolve_tparams_in(resolved, fn_env)
          // #1451: check_assignable, not a raw `unify`, so the IMPLICIT
          // tail-expression return follows the same rules as an EXPLICIT
          // `return e` -- the EReturn arm already calls check_assignable with
          // this exact label, so the two spellings of the same return disagreed.
          //
          // A closure LITERAL always synthesizes a PURE row (`CtFn(.., None)`):
          // its row is not written at the literal, and the latent row is charged
          // by the separate effect pass. A raw unify treats `None` vs
          // `Some(row)` as a conflict (effect_names_compatible: "None (pure) vs
          // Some(concrete) differ in set size"), so EVERY function returning an
          // effectful function value was rejected -- including through Array /
          // tuple / Option, since the mismatch is nested:
          //   fn make() -> (String) -> Unit with Log::Emit {
          //     (s) -> { perform Log::Emit(s) }        // expected .. got (?t0) -> ()
          //   }
          // check_assignable's structural retry tolerates exactly the
          // pure->effectful direction and still reports the UNSOUND one (an
          // effectful value flowing into a pure-typed slot) via
          // effect_row_dropped, so this loosens nothing that was load-bearing.
          // Anchor on the body's TAIL expression -- the value actually being
          // returned. EString now carries a parser offset (#2831); other
          // literals (EInt/EBool/EFloat) still have none, and the enclosing
          // SLet/ELet then tags those with `[@fn=name]` so locate_type_error
          // recovers the function name instead of a synthetic 0:0 range.
          check_assignable_set_end(string_lit_end(body))
          let ns_ret = check_assignable(resolved_ret, bt, s2, errors, "return type mismatch", tail_expr_off(body))
          // #3341: a returned function value is used at the declared row.
          let ns = effect_inst_annotation_check(body_env, body, bt, resolved_ret, ns_ret, "the returned function", "the return type's row", defs, errors)
          (merge_capture_provenance(subst_apply(ns, resolved_ret), subst_apply(ns, bt)), ns)
