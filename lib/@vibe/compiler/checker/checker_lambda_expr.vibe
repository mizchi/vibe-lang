      } else {
        ()
      }
      let keep_ids = array_empty()
      let mut ki0 = 0
      while ki0 < Array::length(tparam_ids) {
        let kid = Array::get(tparam_ids, ki0)
        // Keep only still-open bindings. `type_is_ground` is false for every
        // `CtNamed`, so it would leave `T := Box[Int]` quantified and `f(1)`
        // would typecheck. `type_fully_concrete` zonks that and still keeps
        // a nullary `#ctor.Array` / `#hktformal.F` / unbound vars. HKT
        // constructor params are rigid in the body and simply unbound in s3.
        let still_free = match subst_lookup(s3, kid) {
          Some(t) => !type_fully_concrete(t) && !scheme_formal_head_bound(subst_apply(s3, t)),
          None => true
        }
