// @vibe/compiler/checker/traits — whether a type satisfies a trait bound,
// the builtin trait registrations, supertrait and impl-overlap validation
// (checker_trait.vibe), and the Send judgment over spawned closures and
// their captures (checker_spawnable.vibe). Directory-shared-scope package.
//
// It reads only @vibe/compiler/core and type-name resolution, and never
// calls back into the checker.

// --- checker_trait.vibe
fn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool
fn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type
fn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool
fn bound_entails_send(env: TypeEnv, bound: String) -> Bool
fn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String]
fn register_builtin_traits(env: TypeEnv) -> TypeEnv
fn register_builtin_traits_for(env: TypeEnv, withheld: Array[String]) -> TypeEnv
fn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String]
fn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool

// --- checker_spawnable.vibe
fn closure_free_names(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[String]
fn closure_bare_callee_names(body: Expr) -> Array[String]
fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type, formals: Array[Int]) -> Array[String]
fn closure_capture_facts(env: TypeEnv, body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[Type]
fn env_marker_before(env: TypeEnv, marker: String, name: String) -> Option[Type]
fn env_name_is_local(env: TypeEnv, name: String) -> Bool
fn spawn_caps_marker(name: String) -> String
fn spawn_safe_marker(name: String) -> String
