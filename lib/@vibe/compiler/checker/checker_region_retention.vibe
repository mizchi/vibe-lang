//# Per-module tables

/// Every `let`-bound closure literal of the module being checked, as
/// `(literal, name, bound by let rec)`. A binding's marker holds its index.
let retention_closures: Array[(Expr, String, Bool)] = []

/// The environment of the top-level statement being checked: the scope a
/// top-level function's body is re-checked in.
let retention_module_env_cell: Array[TypeEnv] = []

/// `(parameter type, regions, callee, carried)` for each parameter of the
/// lambda a re-check is about to check, taken by `check_lambda_expr` on
/// entry: the argument's type, the regions its location predates, what a
/// function argument is (a `p:` index into `retention_arg_lambdas`, `o` for a
/// function nothing is known about, empty otherwise), and the regions the
/// argument's value carries where its type does not show them
/// (`retention_value_regions`).
let retention_param_override_cell: Array[Array[(Type, Array[String], String, Array[String])]] = [
]

/// The lambdas a re-check's function arguments stand for, with the scope each
/// is checked in and what the lambda IS (`retention_arg_identity`), while
/// that re-check runs.
let retention_arg_lambdas: Array[(Expr, TypeEnv, String)] = []

/// The re-checks in progress, by callee and argument shape.
let retention_recheck_stack: Array[String] = []

/// `(let offset, regions)` for every local `let` / `let mut` checked inside
/// a region: the regions its value carries, by its type and, where the type
/// may hide one, by what its value read -- the TYPED answer, which
/// `retention_walk` takes for a binding of the body it walks (the walk itself
/// has no types, so it could not tell `MutList::to_array(l)`, a copy, from
/// the list). The newest row for an offset is the latest check of that `let`.
let retention_let_rows: Array[(Int, Array[String])] = []

/// Beside each let row: the regions the binding's value may carry where its
/// type does not show them, and the binding's type when it was made. They
/// count only while that type, solved as far as the walk's substitution
/// goes, may still hide a region -- a `MutList::to_array` copy whose element
/// type was open at its `let` carries nothing once it is `Array[Int]`.
let retention_let_hidden_rows: Array[(Int, Array[String], Type)] = []

/// `(callee offset, regions)` for every call of a function or closure of this
/// module made inside a region: the regions its RESULT carries, as the second
/// check of the callee found them (`retention_note_result`) -- so a helper
/// that is handed the region and returns something else (`ignore(f)`
/// returning a closure that does not capture `f`) does not pass the region
/// on. `retention_walk` takes it for such a call; any other call carries
/// whatever its arguments carry. The newest row for an offset is the latest
/// check of that call.
let retention_call_rows: Array[(Int, Array[String])] = []

/// The active regions the result of the lambda a re-check checked carries --
/// by its type, or by what its tail and explicit `return`s read where the
/// type may hide one -- written by `check_lambda_expr` for that lambda alone
/// (`retention_note_result`). A body passed to `TaskGroup::run` by name is
/// refused when it returns the group's region.
let retention_result_cell: Array[String] = []

/// Fresh variables of a re-check start this far above the counter the real
/// check is at, so no id it hands out is ever handed out again by the real
/// check (a stale per-run row would otherwise alias a fresh variable).
export fn retention_counter_gap() -> Int {
  1000000000
}

fn retention_collect_decls(_ stmts: Array[Stmt]) -> Unit {
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, val) => Array::push(retention_decls, value = (name, val)),
      SModule(_, _, body) => retention_collect_decls(body),
      _ => ()
    }
  }
  ()
}

/// #3343: start the tables for a module's root statement list and hand back
/// the ones in effect before it, for `retention_end_module`.
export fn retention_begin_module(_ stmts: Array[Stmt]) -> (Array[(String, Expr)], Array[(Expr, String, Bool)], Array[TypeEnv]) {
  let saved = (Array::slice(retention_decls, start = 0, end = Array::length(retention_decls)), Array::slice(retention_closures, start = 0, end = Array::length(retention_closures)), Array::slice(retention_module_env_cell, start = 0, end = Array::length(retention_module_env_cell)))
  Array::truncate(retention_decls, length = 0)
  Array::truncate(hce_decl_facts, length = 0)
  Array::truncate(retention_closures, length = 0)
  Array::truncate(retention_module_env_cell, length = 0)
  Array::truncate(retention_arg_lambdas, length = 0)
  Array::truncate(retention_let_rows, length = 0)
  Array::truncate(retention_let_hidden_rows, length = 0)
  Array::truncate(retention_call_rows, length = 0)
  retention_collect_decls(stmts)
  saved
}

/// #3343: restore the tables `retention_begin_module` saved.
export fn retention_end_module(_ saved: (Array[(String, Expr)], Array[(Expr, String, Bool)], Array[TypeEnv])) -> Unit {
  let (decls, closures, module_env) = saved
  Array::truncate(retention_decls, length = 0)
  Array::truncate(hce_decl_facts, length = 0)
  for d in decls {
    Array::push(retention_decls, value = d)
  }
  Array::truncate(retention_closures, length = 0)
  for cl in closures {
    Array::push(retention_closures, value = cl)
  }
  Array::truncate(retention_module_env_cell, length = 0)
  for m in module_env {
    Array::push(retention_module_env_cell, value = m)
  }
  Array::truncate(retention_arg_lambdas, length = 0)
  Array::truncate(retention_let_rows, length = 0)
  Array::truncate(retention_let_hidden_rows, length = 0)
  Array::truncate(retention_call_rows, length = 0)
  ()
}

/// #3343: the environment the current top-level statement is checked in.
export fn retention_note_module_env(_ env: TypeEnv) -> Unit {
  Array::truncate(retention_module_env_cell, length = 0)
  Array::push(retention_module_env_cell, value = env)
}

/// #3343: the parameter types a re-check hands the lambda it checks, taken
/// once, on entry, by that lambda alone. Some([]) is a zero-argument re-check;
/// None means ordinary checking and must not overwrite the result summary.
export fn take_retention_param_override() -> Option[Array[(Type, Array[String], String, Array[String])]] {
  let taken = if Array::length(retention_param_override_cell) > 0 {
    Some(Array::get(retention_param_override_cell, at = 0))
  } else {
    None
  }
  Array::truncate(retention_param_override_cell, length = 0)
  taken
}

/// #3343 (Codex on #3359): record the regions the re-checked lambda's result
/// carries. `check_lambda_expr` answers this for the lambda that took a
/// parameter override, once its body is checked.
export fn retention_note_result(_ regions: Array[String]) -> Unit {
  Array::truncate(retention_result_cell, length = 0)
  for r in regions {
    Array::push(retention_result_cell, value = r)
  }
  ()
}

/// #3343: the names of the regions active in `env`, innermost first.
export fn retention_active_region_names(_ env: TypeEnv) -> Array[String] {
  for r in retention_active_regions(env) {
    let (rname, _) = r
    rname
  }
}

/// #3343 (Codex on #3359): whether a value of type `t` may hold a region's
/// token without its type naming the region -- a nominal type (whose fields
/// the type does not show), a function (whose captures it may not), or a
/// type not yet known. A scalar, and an array, option, tuple or record of
/// scalars, cannot.
export fn retention_type_may_hide_region(_ t: Type) -> Bool {
  match t {
    CtInt => false,
    CtInt32 => false,
    CtUInt32 => false,
    CtDouble => false,
    CtFloat => false,
    CtBool => false,
    CtString => false,
    CtChar => false,
    CtUnit => false,
    CtBytes => false,
    CtArray(e) => retention_type_may_hide_region(e),
    CtOption(e) => retention_type_may_hide_region(e),
    CtTuple(items) => {
      let mut any = false
      for item in items {
        if retention_type_may_hide_region(item) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    CtRecord(fields) => {
      let mut any = false
      for field in fields {
        let (_, fty) = field
        if retention_type_may_hide_region(fty) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    _ => true
  }
}

//# Provenance a type does not show
//#
//# A value's type names the regions it carries only as far as the type has
//# room for them. A nominal struct or enum hides its fields' types, an
//# annotation may spell `TaskHandle[Int]` for a handle of the group, and a
//# closure's type does not list everything it captured. Codex found three
//# rounds of holes on #3359 that were all this one fact, each patched where
//# it was seen (a struct literal in a tail, a callee's result, an explicit
//# `return`, a struct argument). The answer below does not depend on where
//# the value is built or how it travels: a value can carry a region only if
//# a variable it reads carries it, since the region's token is itself a
//# variable and every region-carrying value is made from it. So where a
//# value's type may hide a region (`retention_type_hides_region`), the
//# regions it carries are those carried by the variables its expression
//# reads (`retention_value_regions`): by their types where those show them,
//# and otherwise by what their own binding recorded (`#retain_carry:`, from
//# the value a `let` bound or the argument a re-checked parameter was
//# passed), or, for a binding that recorded nothing -- a `let mut`, a
//# pattern, a loop variable, a parameter of a lambda written in the region
//# -- by every region the binding was declared inside. A call of a function
//# or closure of this module that the region reached carries what its
//# re-check found in its result (`retention_call_rows`); any other call
//# carries what its arguments carry. Every escape check that reads a stored,
//# assigned or returned value's type asks this too.

fn retention_carry_marker(_ name: String) -> String {
  String::concat("#retain_carry:", name)
}

/// What the binding `name` recorded about the regions its value carries,
/// when the binding `name` resolves to recorded it.
fn retention_recorded_carry(env: TypeEnv, name: String) -> Option[Array[String]] {
  let marker = retention_carry_marker(name)
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => if String::equals(n, marker) {
        result = Some(match binding.ty {
          CtTuple(items) => {
            let out = array_empty()
            for item in items {
              match item {
                CtNamed(rname, _) => Array::push(out, value = rname),
                _ => ()
              }
            }
            out
          },
          _ => array_empty()
        })
        done = true
      } else if String::equals(n, name) {
        done = true
      } else {
        cur = rest
      },
      EnvMutCell(n, _, rest) => if String::equals(n, name) {
        done = true
      } else {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvCached(index, _, rest) => if env_name_index_find(index = index, name = name) >= 0 {
        done = true
      } else {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  result
}

fn retention_union_into(out: Array[String], items: Array[String]) -> Unit {
  for item in items {
    if !retention_string_has(items = out, wanted = item) {
      Array::push(out, value = item)
    } else {
      ()
    }
  }
  ()
}

/// The active regions (`active`) the value of the binding `name` resolves to
/// may carry: those its type names, and, where its type may hide one, those
/// its binding recorded, or every active region it was declared inside.
fn retention_name_carried(env: TypeEnv, name: String, active: Array[String], defs: Array[TypeDef], s: Subst) -> Array[String] {
  match env_lookup(env = env, name = name) {
    Some(raw) => {
      let ty = subst_apply(s = s, ty = raw)
      let out = array_empty()
      for rname in active {
        if type_mentions_named(ty = ty, name = rname) {
          Array::push(out, value = rname)
        } else {
          ()
        }
      }
      if retention_type_hides_region(t = ty, defs = defs) {
        match retention_recorded_carry(env = env, name = name) {
          Some(recorded) => {
            for rname in recorded {
              if retention_string_has(items = active, wanted = rname) {
                retention_union_into(out = out, items = [rname])
              } else {
                ()
              }
            }
            ()
          },
          None => retention_union_into(out = out, items = retention_name_inside(env = env, name = name, active = active))
        }
      } else {
        ()
      }
      out
    },
    None => array_empty()
  }
}

/// The active regions (`active`) the binding `name` resolves to was declared
/// inside: those whose marker lies further from the head of the chain than
/// the binding. A name the chain holds only in an accelerator index -- an
/// import, cached at the head before any region began -- or does not hold
/// at all was declared inside none, and so does a local alias of an outer
/// binding for the regions it records.
fn retention_name_inside(env: TypeEnv, name: String, active: Array[String]) -> Array[String] {
  let passed = array_empty()
  let mut cur = env
  let mut found = false
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => if String::equals(n, name) {
        found = true
        done = true
      } else {
        if String::equals(n, "#active_region") {
          match binding.ty {
            CtNamed(rname, _) => retention_union_into(out = passed, items = [
              rname
            ]),
            _ => ()
          }
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(n, _, rest) => if String::equals(n, name) {
        found = true
        done = true
      } else {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  if found {
    let aliased = retention_name_predates(env = env, name = name)
    let out = array_empty()
    for rname in active {
      if !retention_string_has(items = passed, wanted = rname) && !retention_string_has(items = aliased, wanted = rname) {
        Array::push(out, value = rname)
      } else {
        ()
      }
    }
    out
  } else {
    array_empty()
  }
}

fn retention_local_find(local: Array[(String, Array[String])], name: String) -> Int {
  let mut i = Array::length(local) - 1
  let mut hit = -1
  while i >= 0 && hit < 0 {
    let (ln, _) = Array::get(local, at = i)
    if String::equals(ln, name) {
      hit = i
    } else {
      ()
    }
    i = i - 1
  }
  hit
}

fn retention_ident_carried(name: String, env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst) -> Array[String] {
  let i = retention_local_find(local = local, name = name)
  if i >= 0 {
    let (_, rs) = Array::get(local, at = i)
    rs
  } else {
    retention_name_carried(env = env, name = name, active = active, defs = defs, s = s)
  }
}

/// The names a closure body reads from outside it -- with `callees`, the
/// names it calls too; without, only the values it reads (a call's callee
/// spelled by name is not a value the call hands anything to).
fn retention_free_names_into(expr: Expr, bound: Array[String], out: Array[String], callees: Bool) -> Unit {
  match expr {
    EIdent(name, _) => if !retention_string_has(items = bound, wanted = name) {
      retention_union_into(out = out, items = [name])
    } else {
      ()
    },
    ELet(name, val, body, _) => {
      retention_free_names_into(expr = val, bound = bound, out = out, callees = callees)
      Array::push(bound, value = name)
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = Array::length(bound) - 1)
    },
    ELetMut(name, val, body, _) => {
      retention_free_names_into(expr = val, bound = bound, out = out, callees = callees)
      Array::push(bound, value = name)
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = Array::length(bound) - 1)
    },
    ELetRec(name, val, body) => {
      Array::push(bound, value = name)
      retention_free_names_into(expr = val, bound = bound, out = out, callees = callees)
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = Array::length(bound) - 1)
    },
    EAssign(name, val, body, _) => {
      if !retention_string_has(items = bound, wanted = name) {
        retention_union_into(out = out, items = [name])
      } else {
        ()
      }
      retention_free_names_into(expr = val, bound = bound, out = out, callees = callees)
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
    },
    EAssignOp(name, _, val, body, _) => {
      if !retention_string_has(items = bound, wanted = name) {
        retention_union_into(out = out, items = [name])
      } else {
        ()
      }
      retention_free_names_into(expr = val, bound = bound, out = out, callees = callees)
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
    },
    ECall(callee, args, _, _) => {
      match callee {
        EIdent(_, _) => if callees {
          retention_free_names_into(expr = callee, bound = bound, out = out, callees = callees)
        } else {
          ()
        },
        _ => retention_free_names_into(expr = callee, bound = bound, out = out, callees = callees)
      }
      for arg in args {
        retention_free_names_into(expr = arg, bound = bound, out = out, callees = callees)
      }
      ()
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (pname, _) = param
        Array::push(bound, value = retention_param_base(pname))
      }
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (pname, init) = param
        retention_free_names_into(expr = init, bound = bound, out = out, callees = callees)
        Array::push(bound, value = pname)
      }
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = mark)
    },
    EForIn(name, index_name, iter, body) => {
      retention_free_names_into(expr = iter, bound = bound, out = out, callees = callees)
      let mark = Array::length(bound)
      Array::push(bound, value = name)
      match index_name {
        Some(index) => Array::push(bound, value = index),
        None => ()
      }
      retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
      Array::truncate(bound, length = mark)
    },
    EMatch(scrutinee, arms) => {
      retention_free_names_into(expr = scrutinee, bound = bound, out = out, callees = callees)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        collect_pat_binds_into(pat = pat, acc = bound)
        retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
        Array::truncate(bound, length = mark)
      }
      ()
    },
    EHandle(scrutinee, arms) => {
      retention_free_names_into(expr = scrutinee, bound = bound, out = out, callees = callees)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        collect_pat_binds_into(pat = pat, acc = bound)
        Array::push(bound, value = "resume")
        retention_free_names_into(expr = body, bound = bound, out = out, callees = callees)
        Array::truncate(bound, length = mark)
      }
      ()
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        retention_free_names_into(expr = expr_child_at(i), bound = bound, out = out, callees = callees)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

/// An optional (`x?`) parameter keeps its marker on the
/// name; the body binds the bare name.
fn retention_param_base(_ raw_name: String) -> String {
  let len = String::length(raw_name)
  if len > 0 && String::byte_at(raw_name, at = len - 1) == 63 {
    String::substring(raw_name, start = 0, end = len - 1)
  } else {
    raw_name
  }
}

/// The active regions the value of `expr` may carry, read from the variables
/// it reads (see the section header). `local` holds the bindings this walk
/// made itself, with what each carries; a value an explicit `return` (or a
/// `break`) hands out of the expression goes to `returns`.
fn retention_walk(expr: Expr, env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst, returns: Array[String], breaks: Array[String]) -> Array[String] {
  match expr {
    EIdent(name, _) => retention_ident_carried(name = name, env = env, local = local, active = active, defs = defs, s = s),
    EInt(_) => array_empty(),
    EFloat(_) => array_empty(),
    EString(_, _) => array_empty(),
    EBool(_) => array_empty(),
    EUnit => array_empty(),
    EStringInterp(_) => array_empty(),
    ELet(name, val, body, let_off) => {
      let walked = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let rv = match retention_let_row(let_off = let_off, defs = defs, s = s) {
        Some(recorded) => recorded,
        None => {
          retention_union_into(out = walked, items = retention_scope_writes(name = name, scope = body, env = env, local = local, active = active, defs = defs, s = s))
          walked
        }
      }
      let mark = Array::length(local)
      Array::push(local, value = (name, rv))
      let r = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      Array::truncate(local, length = mark)
      r
    },
    // A `let mut` carries what it starts with and what is assigned to it.
    ELetMut(name, val, body, let_off) => {
      let walked = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let rv = match retention_let_row(let_off = let_off, defs = defs, s = s) {
        Some(recorded) => recorded,
        None => {
          retention_union_into(out = walked, items = retention_scope_writes(name = name, scope = body, env = env, local = local, active = active, defs = defs, s = s))
          walked
        }
      }
      let mark = Array::length(local)
      Array::push(local, value = (name, rv))
      let r = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      Array::truncate(local, length = mark)
      r
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(local)
      Array::push(local, value = (name, array_empty()))
      let rv = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      Array::truncate(local, length = mark)
      Array::push(local, value = (name, rv))
      let r = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      Array::truncate(local, length = mark)
      r
    },
    EAssign(_, val, body, _) => {
      let _ = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
    },
    EAssignOp(_, _, val, body, _) => {
      let _ = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
    },
    ESeq(left, right) => {
      let _ = retention_walk(expr = left, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      retention_walk(expr = right, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
    },
    EIf(cond, then_expr, else_expr) => {
      let _ = retention_walk(expr = cond, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let out = retention_walk(expr = then_expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let out2 = array_empty()
      retention_union_into(out = out2, items = out)
      retention_union_into(out = out2, items = retention_walk(expr = else_expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
      out2
    },
    // A pattern's bindings are parts of the scrutinee.
    EMatch(scrutinee, arms) => {
      let rs = retention_walk(expr = scrutinee, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let out = array_empty()
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(local)
        retention_pattern_parts(pat = pat, value = scrutinee, fallback = rs, env = env, local = local, active = active, defs = defs, s = s)
        retention_union_into(out = out, items = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
        Array::truncate(local, length = mark)
      }
      out
    },
    // A handler arm's bindings are an operation's arguments, made anywhere
    // in the handled body.
    EHandle(scrutinee, arms) => {
      let out = array_empty()
      retention_union_into(out = out, items = retention_walk(expr = scrutinee, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
      for arm in arms {
        let (pat, body) = arm
        let names = array_empty()
        collect_pat_binds_into(pat = pat, acc = names)
        let mark = Array::length(local)
        for n in names {
          Array::push(local, value = (n, active))
        }
        retention_union_into(out = out, items = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
        Array::truncate(local, length = mark)
      }
      out
    },
    EWhile(cond, body) => {
      let _ = retention_walk(expr = cond, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let _ = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      array_empty()
    },
    ELoop(params, body) => {
      let mark = Array::length(local)
      for param in params {
        let (pname, init) = param
        let _ = retention_walk(expr = init, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
        Array::push(local, value = (pname, active))
      }
      let loop_breaks = array_empty()
      let _ = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = loop_breaks)
      Array::truncate(local, length = mark)
      loop_breaks
    },
    EForIn(name, index_name, iter, body) => {
      let ri = retention_walk(expr = iter, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      let mark = Array::length(local)
      Array::push(local, value = (name, ri))
      match index_name {
        Some(index) => Array::push(local, value = (index, array_empty())),
        None => ()
      }
      let _ = retention_walk(expr = body, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      Array::truncate(local, length = mark)
      array_empty()
    },
    // A closure carries what it captured: every name it reads from outside.
    EFn(_, _, params, _, _, body) => {
      let bound = array_empty()
      for param in params {
        let (pname, _) = param
        Array::push(bound, value = retention_param_base(pname))
      }
      let names = array_empty()
      retention_free_names_into(expr = body, bound = bound, out = names, callees = true)
      let out = array_empty()
      for n in names {
        retention_union_into(out = out, items = retention_ident_carried(name = n, env = env, local = local, active = active, defs = defs, s = s))
      }
      out
    },
    EReturn(val) => {
      retention_union_into(out = returns, items = retention_walk(expr = val, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
      array_empty()
    },
    // A call of a function or closure of this module that a second check
    // answered for: what its result carries, by that check.
    ECall(EIdent(cname, coff), args, _, _) => match retention_row(rows = retention_call_rows, off = coff) {
      Some(recorded) => if retention_local_find(local = local, name = cname) >= 0 {
        // A binding this walk made shadows the callee the row was written
        // for; read the call as any other.
        retention_walk_children(expr = expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
      } else {
        for arg in args {
          let _ = retention_walk(expr = arg, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
        }
        recorded
      },
      None => retention_walk_children(expr = expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
    },
    // An expression callee has no binding name to shadow. Its re-check is
    // recorded at the call's own source offset, and describes the result,
    // independently of the regions its consumed arguments carried.
    ECall(_, args, call_off, _) => match retention_row(rows = retention_call_rows, off = call_off) {
      Some(recorded) => {
        for arg in args {
          let _ = retention_walk(expr = arg, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
        }
        recorded
      },
      None => retention_walk_children(expr = expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
    },
    EBreak(val) => {
      match val {
        Some(v) => retention_union_into(out = breaks, items = retention_walk(expr = v, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)),
        None => ()
      }
      array_empty()
    },
    _ => retention_walk_children(expr = expr, env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks)
  }
}

/// Bind a literal aggregate's pattern from each matched component, taking
/// all component values before introducing any of the pattern's names.
fn retention_pattern_parts(pat: Pat, value: Expr, fallback: Array[String], env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst) -> Unit {
  let projected: Array[(String, Array[String])] = []
  retention_pattern_parts_into(pat = pat, value = value, fallback = fallback, read = (part: Expr) -> Array[String] {
    retention_walk(expr = part, env = env, local = local, active = active, defs = defs, s = s, returns = array_empty(), breaks = array_empty())
  }, out = projected)
  for binding in projected {
    Array::push(local, value = binding)
  }
  ()
}

/// A projection with no known source shape retains the conservative union.
fn retention_pattern_parts_into(pat: Pat, value: Expr, fallback: Array[String], read: (Expr) -> Array[String], out: Array[(String, Array[String])]) -> Unit {
  match (pat, value) {
    (PTuple(patterns), ETuple(values)) => if Array::length(patterns) == Array::length(values) {
      let mut i = 0
      while i < Array::length(patterns) {
        let part = Array::get(values, at = i)
        let carried = read(part)
        retention_pattern_parts_into(pat = Array::get(patterns, at = i), value = part, fallback = carried, read = read, out = out)
        i = i + 1
      }
    } else {
      let names = array_empty()
      collect_pat_binds_into(pat = pat, acc = names)
      for name in names {
        Array::push(out, value = (name, fallback))
      }
    },
    (PStruct(pname, patterns), ERecord(vname, values, _)) => if pname == vname {
      for field in patterns {
        let (name, pattern) = field
        let mut source = None
        for entry in values {
          let (value_name, part) = entry
          if name == value_name {
            source = Some(part)
          }
        }
        match source {
          Some(part) => {
            let carried = read(part)
            retention_pattern_parts_into(pat = pattern, value = part, fallback = carried, read = read, out = out)
          },
          None => {
            let names = array_empty()
            collect_pat_binds_into(pat = pattern, acc = names)
            for name in names {
              Array::push(out, value = (name, fallback))
            }
          }
        }
      }
    } else {
      let names = array_empty()
      collect_pat_binds_into(pat = pat, acc = names)
      for name in names {
        Array::push(out, value = (name, fallback))
      }
    },
    _ => {
      let names = array_empty()
      collect_pat_binds_into(pat = pat, acc = names)
      for name in names {
        Array::push(out, value = (name, fallback))
      }
    }
  }
  ()
}

/// What a node that binds nothing carries: what its children carry.
fn retention_walk_children(expr: Expr, env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst, returns: Array[String], breaks: Array[String]) -> Array[String] {
  let out = array_empty()
  let mark = expr_children_push(expr)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    retention_union_into(out = out, items = retention_walk(expr = expr_child_at(i), env = env, local = local, active = active, defs = defs, s = s, returns = returns, breaks = breaks))
    i = i + 1
  }
  expr_children_pop(mark)
  out
}

//# Writes into a binding
//#
//# A binding's value can gain a region after it is made: a field write
//# (`b.h = Some(handle)`), a container write (`Array::push(xs, handle)`), an
//# assignment, or a helper handed the binding together with the handle. Codex
//# on #3359: a body that made `let b = Box::{ h: None }` and then wrote the
//# handle into `b.h` could return `b` with nothing seeing the region. So a
//# binding made inside a region carries, besides what its value read, what
//# every write into it ANYWHERE in its scope writes -- a flow-insensitive
//# union, so a read before the write in a loop, or a write in a closure that
//# runs later, counts too. "Into it" follows aliases both ways: a name bound
//# from it, a pattern or loop variable over it, a location it is stored
//# into, a location stored into it, a container or helper it is handed to
//# with other arguments, and the captures of a closure of this scope that is
//# called with it. What a write inside a closure writes from the closure's
//# own parameters is not known here, so it counts as every region.

/// `t` contains a part the checker has not determined yet, which may still
/// become a type that hides a region.
fn retention_type_open(_ t: Type) -> Bool {
  match t {
    CtVar(_) => true,
    CtUnknown => true,
    CtArray(e) => retention_type_open(e),
    CtOption(e) => retention_type_open(e),
    CtTuple(items) => {
      let mut any = false
      for item in items {
        if retention_type_open(item) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    CtNamed(_, args) => {
      let mut any = false
      for a in args {
        if retention_type_open(a) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    CtForAll(_, _, body) => retention_type_open(body),
    _ => false
  }
}

/// The values `expr` reads by name (a callee spelled by name excluded).
fn retention_value_names(_ expr: Expr) -> Array[String] {
  let out = array_empty()
  retention_free_names_into(expr = expr, bound = array_empty(), out = out, callees = false)
  out
}

fn retention_any_listed(names: Array[String], set: Array[String]) -> Bool {
  let mut any = false
  for n in names {
    if !any && retention_string_has(items = set, wanted = n) {
      any = true
    } else {
      ()
    }
  }
  any
}

/// Add `names` to `set`; whether any was new.
fn retention_add_names(set: Array[String], names: Array[String]) -> Bool {
  let mut changed = false
  for n in names {
    if !retention_string_has(items = set, wanted = n) {
      Array::push(set, value = n)
      changed = true
    } else {
      ()
    }
  }
  changed
}

/// The parts of a call that values flow between: its arguments, the
/// receiver of a method call, and a lambda applied where it is written.
fn retention_call_parts(callee: Expr, args: Array[Expr]) -> Array[Expr] {
  let parts = array_empty()
  match callee {
    EDot(obj, _, _, _) => Array::push(parts, value = obj),
    EFn(_, _, _, _, _, _) => Array::push(parts, value = callee),
    _ => ()
  }
  for arg in args {
    Array::push(parts, value = arg)
  }
  parts
}

/// Every `let`-bound closure literal of `expr`, with the values it reads.
fn retention_collect_closures(expr: Expr, out: Array[(String, Array[String])]) -> Unit {
  match expr {
    ELet(name, val, body, _) => {
      match let_rhs_closure_literal(val) {
        Some(lit) => Array::push(out, value = (name, retention_value_names(lit))),
        None => ()
      }
      retention_collect_closures(expr = val, out = out)
      retention_collect_closures(expr = body, out = out)
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        retention_collect_closures(expr = expr_child_at(i), out = out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

/// `target` and the values `val` reads become aliases of each other.
fn retention_alias_link(target: String, val: Expr, aliases: Array[String]) -> Bool {
  let names = retention_value_names(val)
  let mut changed = false
  if retention_string_has(items = aliases, wanted = target) {
    if retention_add_names(set = aliases, names = names) {
      changed = true
    } else {
      ()
    }
  } else if retention_any_listed(names = names, set = aliases) {
    Array::push(aliases, value = target)
    changed = true
  } else {
    ()
  }
  changed
}

/// A lexical binder hides the outer location of the same spelling.
fn retention_aliases_without(names: Array[String], aliases: Array[String]) -> Array[String] {
  let out = array_empty()
  for alias in aliases {
    if !retention_string_has(items = names, wanted = alias) {
      Array::push(out, value = alias)
    }
  }
  out
}

/// A pattern owns only the locations its selected components alias.
fn retention_pattern_aliases(pat: Pat, value: Expr, aliases: Array[String]) -> Array[String] {
  let names = array_empty()
  collect_pat_binds_into(pat = pat, acc = names)
  let inner = retention_aliases_without(names = names, aliases = aliases)
  let projected: Array[(String, Array[String])] = []
  retention_pattern_parts_into(pat = pat, value = value, fallback = retention_value_names(value), read = (part: Expr) -> Array[String] {
    retention_value_names(part)
  }, out = projected)
  for binding in projected {
    let (name, related) = binding
    if retention_any_listed(names = related, set = aliases) {
      let _ = retention_add_names(set = inner, names = [name])
    }
  }
  inner
}

/// A binder shadows the outer location even when its spelling is identical.
/// Its initializer reads the old scope; only a real alias keeps the new name.
fn retention_binding_aliases(name: String, val: Expr, aliases: Array[String]) -> Array[String] {
  let inner = array_empty()
  for alias in aliases {
    if alias != name {
      Array::push(inner, value = alias)
    }
  }
  if retention_any_listed(names = retention_value_names(val), set = aliases) {
    Array::push(inner, value = name)
  }
  inner
}

/// The alias set owned by this binder's occurrence in the scope walk.
/// Every fixed-point round visits occurrences in the same order. Inherited
/// aliases may grow, but a shadowed outer location never seeds the new binder.
fn retention_binder_aliases(inherited: Array[String], scopes: Array[Array[String]], cursor: Array[Int]) -> (Array[String], Bool) {
  let index = Array::get(cursor, at = 0)
  Array::set(cursor, at = 0, value = index + 1)
  if index == Array::length(scopes) {
    Array::push(scopes, value = array_empty())
  }
  let inner = Array::get(scopes, at = index)
  let changed = retention_add_names(set = inner, names = inherited)
  (inner, changed)
}

/// The write pass uses the same occurrence order as the alias fixed point.
fn retention_binder_scope(scopes: Array[Array[String]], cursor: Array[Int]) -> Array[String] {
  let index = Array::get(cursor, at = 0)
  Array::set(cursor, at = 0, value = index + 1)
  Array::get(scopes, at = index)
}

/// Walk a binding without confusing its body with the location it shadows.
fn retention_alias_binding(name: String, val: Expr, body: Expr, aliases: Array[String], closures: Array[(String, Array[String])], scopes: Array[Array[String]], cursor: Array[Int]) -> Bool {
  let a = retention_alias_step(expr = val, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
  let (inner, seeded) = retention_binder_aliases(inherited = retention_binding_aliases(name = name, val = val, aliases = aliases), scopes = scopes, cursor = cursor)
  let b = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
  let additions = array_empty()
  for alias in inner {
    if alias != name {
      Array::push(additions, value = alias)
    }
  }
  let propagated = retention_add_names(set = aliases, names = additions)
  a || seeded || b || propagated
}

/// Parameters introduce locations distinct from any outer same-named alias.
fn retention_parameter_aliases(params: Array[(String, Option[TypeExpr])], aliases: Array[String]) -> Array[String] {
  let mut inner = Array::slice(aliases, start = 0, end = Array::length(aliases))
  for param in params {
    let (name, _) = param
    inner = retention_binding_aliases(name = retention_param_base(name), val = EUnit, aliases = inner)
  }
  inner
}

/// One round of the alias closure over `expr`; whether `aliases` grew.
fn retention_alias_step(expr: Expr, aliases: Array[String], closures: Array[(String, Array[String])], scopes: Array[Array[String]], cursor: Array[Int]) -> Bool {
  match expr {
    ELet(name, val, body, _) => retention_alias_binding(name = name, val = val, body = body, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor),
    ELetMut(name, val, body, _) => retention_alias_binding(name = name, val = val, body = body, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor),
    EFn(_, _, params, _, _, body) => {
      let (inner, seeded) = retention_binder_aliases(inherited = retention_parameter_aliases(params = params, aliases = aliases), scopes = scopes, cursor = cursor)
      let nested = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
      let propagated = retention_add_names(set = aliases, names = retention_parameter_aliases(params = params, aliases = inner))
      seeded || nested || propagated
    },
    ELetRec(name, val, body) => {
      let inherited = retention_binding_aliases(name = name, val = val, aliases = retention_aliases_without(names = [
        name
      ], aliases = aliases))
      let (inner, seeded) = retention_binder_aliases(inherited = inherited, scopes = scopes, cursor = cursor)
      let a = retention_alias_step(expr = val, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
      let b = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
      let propagated = retention_add_names(set = aliases, names = retention_aliases_without(names = [
        name
      ], aliases = inner))
      seeded || a || b || propagated
    },
    EAssign(name, val, body, _) => {
      let a = retention_alias_link(target = name, val = val, aliases = aliases)
      let b = retention_alias_step(expr = val, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      let c = retention_alias_step(expr = body, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      a || b || c
    },
    EAssignOp(name, _, val, body, _) => {
      let a = retention_alias_link(target = name, val = val, aliases = aliases)
      let b = retention_alias_step(expr = val, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      let c = retention_alias_step(expr = body, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      a || b || c
    },
    ECall(callee, args, _, _) => {
      let names = array_empty()
      for part in retention_call_parts(callee = callee, args = args) {
        retention_union_into(out = names, items = retention_value_names(part))
      }
      let mut changed = false
      if retention_any_listed(names = names, set = aliases) {
        if retention_add_names(set = aliases, names = names) {
          changed = true
        } else {
          ()
        }
        // A closure of this scope called with an alias may store it in
        // what it captured.
        match callee {
          EIdent(cname, _) => for entry in closures {
            let (closure_name, captured) = entry
            if String::equals(closure_name, cname) && retention_add_names(set = aliases, names = captured) {
              changed = true
            } else {
              ()
            }
          },
          _ => ()
        }
        ()
      } else {
        ()
      }
      let mut inner = false
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        if retention_alias_step(expr = expr_child_at(i), aliases = aliases, closures = closures, scopes = scopes, cursor = cursor) {
          inner = true
        } else {
          ()
        }
        i = i + 1
      }
      expr_children_pop(mark)
      changed || inner
    },
    EMatch(scrutinee, arms) => {
      let mut changed = retention_alias_step(expr = scrutinee, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      for arm in arms {
        let (pat, body) = arm
        let names = array_empty()
        collect_pat_binds_into(pat = pat, acc = names)
        let (inner, seeded) = retention_binder_aliases(inherited = retention_pattern_aliases(pat = pat, value = scrutinee, aliases = aliases), scopes = scopes, cursor = cursor)
        let nested = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
        let propagated = retention_add_names(set = aliases, names = retention_aliases_without(names = names, aliases = inner))
        changed = changed || seeded || nested || propagated
      }
      changed
    },
    EHandle(scrutinee, arms) => {
      let mut changed = retention_alias_step(expr = scrutinee, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      for arm in arms {
        let (pat, body) = arm
        let names = ["resume"]
        collect_pat_binds_into(pat = pat, acc = names)
        let inherited = retention_aliases_without(names = ["resume"], aliases = retention_pattern_aliases(pat = pat, value = scrutinee, aliases = aliases))
        let (inner, seeded) = retention_binder_aliases(inherited = inherited, scopes = scopes, cursor = cursor)
        let nested = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
        let propagated = retention_add_names(set = aliases, names = retention_aliases_without(names = names, aliases = inner))
        changed = changed || seeded || nested || propagated
      }
      changed
    },
    EForIn(name, index_name, iter, body) => {
      let before = retention_alias_step(expr = iter, aliases = aliases, closures = closures, scopes = scopes, cursor = cursor)
      let names = [name]
      let mut inherited = retention_binding_aliases(name = name, val = iter, aliases = aliases)
      match index_name {
        Some(index) => {
          Array::push(names, value = index); inherited = retention_aliases_without(names = [
            index
          ], aliases = inherited)
        },
        None => ()
      }
      let (inner, seeded) = retention_binder_aliases(inherited = inherited, scopes = scopes, cursor = cursor)
      let nested = retention_alias_step(expr = body, aliases = inner, closures = closures, scopes = scopes, cursor = cursor)
      let propagated = retention_add_names(set = aliases, names = retention_aliases_without(names = names, aliases = inner))
      before || seeded || nested || propagated
    },
    _ => {
      let mut changed = false
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        if retention_alias_step(expr = expr_child_at(i), aliases = aliases, closures = closures, scopes = scopes, cursor = cursor) {
          changed = true
        } else {
          ()
        }
        i = i + 1
      }
      expr_children_pop(mark)
      changed
    }
  }
}

/// What every write into an alias in `expr` writes, into `out`. `local`
/// holds the bindings of `expr` passed so far, as `retention_walk`'s does.
fn retention_write_pass(expr: Expr, aliases: Array[String], env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst, out: Array[String], scopes: Array[Array[String]], cursor: Array[Int]) -> Unit {
  let walk = (e: Expr) -> {
    retention_walk(expr = e, env = env, local = local, active = active, defs = defs, s = s, returns = array_empty(), breaks = array_empty())
  }
  match expr {
    ELet(name, val, body, _) => {
      retention_write_pass(expr = val, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      let rv = walk(val)
      let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
      if retention_string_has(items = inner, wanted = name) {
        retention_union_into(out = out, items = rv)
      } else {
        ()
      }
      let mark = Array::length(local)
      Array::push(local, value = (name, rv))
      retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    ELetMut(name, val, body, _) => {
      retention_write_pass(expr = val, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      let rv = walk(val)
      let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
      if retention_string_has(items = inner, wanted = name) {
        retention_union_into(out = out, items = rv)
      } else {
        ()
      }
      let mark = Array::length(local)
      Array::push(local, value = (name, rv))
      retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    ELetRec(name, val, body) => {
      let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
      let mark = Array::length(local)
      Array::push(local, value = (name, array_empty()))
      retention_write_pass(expr = val, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      let rv = walk(val)
      Array::truncate(local, length = mark)
      if retention_string_has(items = inner, wanted = name) {
        retention_union_into(out = out, items = rv)
      } else {
        ()
      }
      Array::push(local, value = (name, rv))
      retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    EAssign(name, val, body, _) => {
      retention_write_pass(expr = val, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      if retention_string_has(items = aliases, wanted = name) {
        retention_union_into(out = out, items = walk(val))
      } else {
        ()
      }
      retention_write_pass(expr = body, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
    },
    EAssignOp(name, _, val, body, _) => {
      retention_write_pass(expr = val, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      if retention_string_has(items = aliases, wanted = name) {
        retention_union_into(out = out, items = walk(val))
      } else {
        ()
      }
      retention_write_pass(expr = body, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
    },
    ECall(callee, args, _, _) => {
      let parts = retention_call_parts(callee = callee, args = args)
      let names = array_empty()
      for part in parts {
        retention_union_into(out = names, items = retention_value_names(part))
      }
      if retention_any_listed(names = names, set = aliases) {
        for part in parts {
          retention_union_into(out = out, items = walk(part))
        }
        // A closure called with the alias may store what it captured.
        match callee {
          EIdent(_, _) => retention_union_into(out = out, items = walk(callee)),
          _ => ()
        }
        ()
      } else {
        ()
      }
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        retention_write_pass(expr = expr_child_at(i), aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
        i = i + 1
      }
      expr_children_pop(mark)
    },
    EMatch(scrutinee, arms) => {
      retention_write_pass(expr = scrutinee, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      let rs = walk(scrutinee)
      for arm in arms {
        let (pat, body) = arm
        let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
        let projected: Array[(String, Array[String])] = []
        retention_pattern_parts_into(pat = pat, value = scrutinee, fallback = rs, read = walk, out = projected)
        let mark = Array::length(local)
        for binding in projected {
          let (name, carried) = binding
          if retention_string_has(items = inner, wanted = name) {
            retention_union_into(out = out, items = carried)
          }
          Array::push(local, value = binding)
        }
        retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
        Array::truncate(local, length = mark)
      }
      ()
    },
    EHandle(scrutinee, arms) => {
      retention_write_pass(expr = scrutinee, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      for arm in arms {
        let (pat, body) = arm
        let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
        let binders = array_empty()
        collect_pat_binds_into(pat = pat, acc = binders)
        let mark = Array::length(local)
        for n in binders {
          Array::push(local, value = (n, active))
        }
        retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
        Array::truncate(local, length = mark)
      }
      ()
    },
    EForIn(name, index_name, iter, body) => {
      retention_write_pass(expr = iter, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      let ri = walk(iter)
      let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
      if retention_string_has(items = inner, wanted = name) {
        retention_union_into(out = out, items = ri)
      } else {
        ()
      }
      let mark = Array::length(local)
      Array::push(local, value = (name, ri))
      match index_name {
        Some(index) => Array::push(local, value = (index, array_empty())),
        None => ()
      }
      retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(local)
      for param in params {
        let (pname, init) = param
        retention_write_pass(expr = init, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
        Array::push(local, value = (pname, active))
      }
      retention_write_pass(expr = body, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    // A closure's parameters are whatever its callers pass: every region.
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(local)
      for param in params {
        let (pname, _) = param
        Array::push(local, value = (retention_param_base(pname), active))
      }
      let inner = retention_binder_scope(scopes = scopes, cursor = cursor)
      retention_write_pass(expr = body, aliases = inner, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
      Array::truncate(local, length = mark)
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        retention_write_pass(expr = expr_child_at(i), aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = out, scopes = scopes, cursor = cursor)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

/// The active regions (`active`) the writes into the binding `name` anywhere
/// in its scope `scope` write (see the section header), read in `env` with
/// `local`'s bindings. An alias closure that does not settle answers every
/// region.
fn retention_scope_writes(name: String, scope: Expr, env: TypeEnv, local: Array[(String, Array[String])], active: Array[String], defs: Array[TypeDef], s: Subst) -> Array[String] {
  if Array::length(active) == 0 || !retention_string_has(items = retention_value_names(scope), wanted = name) {
    array_empty()
  } else {
    let aliases = array_empty()
    Array::push(aliases, value = name)
    let closures = array_empty()
    retention_collect_closures(expr = scope, out = closures)
    let scopes: Array[Array[String]] = []
    let mut changed = true
    let mut rounds = 0
    while changed && rounds < 16 {
      changed = retention_alias_step(expr = scope, aliases = aliases, closures = closures, scopes = scopes, cursor = [
        0
      ])
      rounds = rounds + 1
    }
    if changed || retention_string_has(items = aliases, wanted = "#retain_unsettled") {
      Array::slice(active, start = 0, end = Array::length(active))
    } else {
      let found = array_empty()
      let mark = Array::length(local)
      Array::push(local, value = (name, array_empty()))
      retention_write_pass(expr = scope, aliases = aliases, env = env, local = local, active = active, defs = defs, s = s, out = found, scopes = scopes, cursor = [
        0
      ])
      Array::truncate(local, length = mark)
      let out = array_empty()
      for rname in found {
        if retention_string_has(items = active, wanted = rname) {
          retention_union_into(out = out, items = [rname])
        } else {
          ()
        }
      }
      out
    }
  }
}

/// #3343 (Codex on #3359): the active regions of `env` the value of `expr`
/// may carry, read from the variables it reads (see the section header).
/// Ask it where the value's type may hide a region; where the type shows
/// one, the type answers.
export fn retention_value_regions(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Array[String] {
  let active = retention_active_region_names(env)
  if Array::length(active) == 0 {
    array_empty()
  } else {
    retention_walk(expr = expr, env = env, local = array_empty(), active = active, defs = defs, s = s, returns = array_empty(), breaks = array_empty())
  }
}

/// #3343 (Codex on #3359): the active regions of `env` the RESULT of a body
/// may carry -- its value, and every value an explicit `return` in it hands
/// back, at any depth outside a nested lambda.
export fn retention_result_regions(body: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Array[String] {
  let active = retention_active_region_names(env)
  if Array::length(active) == 0 {
    array_empty()
  } else {
    let returns = array_empty()
    let out = retention_walk(expr = body, env = env, local = array_empty(), active = active, defs = defs, s = s, returns = returns, breaks = array_empty())
    retention_union_into(out = out, items = returns)
    out
  }
}

/// #3343 (Codex on #3359): whether a write of `val` (of type `val_ty`) keeps
/// one of `regions` -- the regions its target was declared before -- where
/// the type does not show it. The first such region, or "".
fn retention_hidden_write_region(val: Expr, val_ty: Type, regions: Array[String], env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  if Array::length(regions) == 0 || !retention_type_hides_region(t = val_ty, defs = defs) {
    ""
  } else {
    let carried = retention_value_regions(expr = val, env = env, defs = defs, s = s)
    let mut hit = ""
    for rname in regions {
      if hit == "" && retention_string_has(items = carried, wanted = rname) {
        hit = rname
      } else {
        ()
      }
    }
    hit
  }
}

/// #3343 (Codex on #3359): the region `name` was declared before that
/// assigning `val` (of type `val_ty`) to it would keep where the value's type
/// does not show it, or "".
export fn retention_assign_hidden_region(name: String, val: Expr, val_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> String {
  if retention_type_hides_region(t = val_ty, defs = defs) {
    retention_hidden_write_region(val = val, val_ty = val_ty, regions = retention_name_predates(env = env, name = name), env = env, defs = defs, s = s)
  } else {
    ""
  }
}

/// #3343: whether `rname` is one of `names`.
export fn retention_region_listed(names: Array[String], rname: String) -> Bool {
  retention_string_has(items = names, wanted = rname)
}

/// The regions the newest row of `rows` for `off` recorded, if any.
fn retention_row(rows: Array[(Int, Array[String])], off: Int) -> Option[Array[String]] {
  if off < 0 {
    None
  } else {
    let mut i = Array::length(rows) - 1
    let mut hit = -1
    while i >= 0 && hit < 0 {
      let (row_off, _) = Array::get(rows, at = i)
      if row_off == off {
        hit = i
      } else {
        ()
      }
      i = i - 1
    }
    if hit >= 0 {
      let (_, regions) = Array::get(rows, at = hit)
      Some(regions)
    } else {
      None
    }
  }
}

/// What the `let` at `let_off` recorded its binding carries: what its type
/// showed, and what it may carry where its type does not show it while that
/// type, as `s` solves it, may still hide a region.
fn retention_let_row(let_off: Int, defs: Array[TypeDef], s: Subst) -> Option[Array[String]] {
  match retention_row(rows = retention_let_rows, off = let_off) {
    Some(shown) => {
      let out = Array::slice(shown, start = 0, end = Array::length(shown))
      let mut i = Array::length(retention_let_hidden_rows) - 1
      let mut hit = -1
      while i >= 0 && hit < 0 {
        let (off, _, _) = Array::get(retention_let_hidden_rows, at = i)
        if off == let_off {
          hit = i
        } else {
          ()
        }
        i = i - 1
      }
      if hit >= 0 {
        let (_, hidden, raw) = Array::get(retention_let_hidden_rows, at = hit)
        let ty = subst_apply(s = s, ty = raw)
        if retention_type_hides_region(t = ty, defs = defs) || retention_type_open(ty) {
          retention_union_into(out = out, items = hidden)
        } else {
          ()
        }
      } else {
        ()
      }
      Some(out)
    },
    None => None
  }
}

fn retention_visible_regions(ty: Type, active: Array[String]) -> Array[String] {
  let out = array_empty()
  for rname in active {
    if type_mentions_named(ty = ty, name = rname) {
      Array::push(out, value = rname)
    } else {
      ()
    }
  }
  out
}

/// #3343 (Codex on #3359): record, for a `let` binding `name` made inside a
/// region (its keyword at `let_off`), which regions its value carries -- by
/// its type and, where its type may hide one (now, or once its open parts
/// are solved), by what its value read and what every write into it in its
/// scope `scope` writes -- and bind that in front of the binding too.
/// `def_env` is the scope the value was written in.
export fn retention_bind_carry(env: TypeEnv, def_env: TypeEnv, name: String, val: Expr, scope: Expr, ty: Type, defs: Array[TypeDef], s: Subst, let_off: Int) -> TypeEnv {
  let active = retention_active_region_names(def_env)
  let carried = retention_visible_regions(ty = ty, active = active)
  // A type still open may become one that hides a region once its writes
  // are solved (`let xs = []` filled with boxes later), so its writes are
  // read; its value is read only when its type hides one already -- a
  // call's result whose element type is still open (`MutList::to_array(l)`)
  // is read by its type, not by the arguments of the call.
  let hides_now = retention_type_hides_region(t = ty, defs = defs)
  let may_hide = hides_now || retention_type_open(ty)
  let hidden = if may_hide {
    let from_value = if hides_now {
      retention_value_regions(expr = val, env = def_env, defs = defs, s = s)
    } else {
      array_empty()
    }
    retention_union_into(out = from_value, items = retention_scope_writes(name = name, scope = scope, env = def_env, local = array_empty(), active = active, defs = defs, s = s))
    from_value
  } else {
    array_empty()
  }
  if let_off >= 0 {
    Array::push(retention_let_rows, value = (let_off, carried))
    Array::push(retention_let_hidden_rows, value = (let_off, hidden, ty))
  } else {
    ()
  }
  if may_hide {
    retention_bind_param_carry(env = env, name = name, regions = hidden)
  } else {
    env
  }
}

/// #3343 (Codex on #3359): `retention_bind_carry` for a `let mut`: what it
/// starts with, and what every assignment or other write into it in its
/// scope writes. `env` already binds it.
export fn retention_note_let_mut(env: TypeEnv, def_env: TypeEnv, name: String, val: Expr, scope: Expr, ty: Type, defs: Array[TypeDef], s: Subst, let_off: Int) -> TypeEnv {
  retention_bind_carry(env = env, def_env = def_env, name = name, val = val, scope = scope, ty = ty, defs = defs, s = s, let_off = let_off)
}

/// #3343 (Codex on #3359): record, in front of the binding `name`, that its
/// value carries `regions` (see `retention_recorded_carry`).
export fn retention_bind_param_carry(env: TypeEnv, name: String, regions: Array[String]) -> TypeEnv {
  env_bind(env = env, name = retention_carry_marker(name), ty = CtTuple(for rname in regions {
    CtNamed(rname, [])
  }))
}

/// #3343: bind, in front of a re-checked lambda's parameter `name`, what its
/// function argument is (see `retention_param_override_cell`).
export fn retention_bind_param_callee(env: TypeEnv, name: String, callee: String) -> TypeEnv {
  if callee == "" {
    env
  } else {
    env_bind(env = env, name = retention_marker(name), ty = CtNamed(callee, []))
  }
}

//# Local bindings

export fn retention_marker(_ name: String) -> String {
  String::concat("#retain_body:", name)
}

/// The name a `let` aliases: a bare name, or one under an annotation.
export fn retention_alias_source(_ val: Expr) -> String {
  match val {
    EIdent(src, _) => src,
    ECall(callee, args, _, _) => if Array::length(args) == 1 {
      match ascription_lambda_ann(callee) {
        Some(_) => match Array::get(args, at = 0) {
          EIdent(src, _) => src,
          _ => ""
        },
        None => ""
      }
    } else {
      ""
    },
    _ => ""
  }
}

/// #3343: record what a local `let` binds, in front of the binding, the way
/// `spawn_caps_marker` does: a closure literal's body (`c:` and its index in
/// the module's closure table), or the name a function-typed alias stands
/// for (`a:` and the name, resolved in the alias's own scope when a call
/// needs it; `o:` and the names a conditional alias's branches name). A
/// later binding of the same name sits in front of the marker and hides it.
/// Nothing is recorded for any other value.
export fn retention_bind_let(env: TypeEnv, name: String, val: Expr, ty: Type, is_rec: Bool) -> TypeEnv {
  match let_rhs_closure_literal(val) {
    Some(lit) => {
      Array::push(retention_closures, value = (lit, name, is_rec))
      env_bind(env = env, name = retention_marker(name), ty = CtNamed(String::concat("c:", __to_string(Array::length(retention_closures) - 1)), [
      ]))
    },
    None => if retention_is_function_type(ty) {
      let src = retention_alias_source(val)
      let branches = retention_alias_names(val)
      if src != "" {
        env_bind(env = env, name = retention_marker(name), ty = CtNamed(String::concat("a:", src), [
        ]))
      } else if Array::length(branches) > 0 {
        // #3596: what a branch names (`if c { mk } else { mk_ok }`), for the
        // handle-escape check; a call through it is not followed here.
        env_bind(env = env, name = retention_marker(name), ty = CtNamed(String::concat("o:", String::join(branches, sep = ",")), [
        ]))
      } else {
        env
      }
    } else {
      env
    }
  }
}

/// 1 when `name` resolves to a binding made inside a body -- a function
/// body (`__capture_boundary__`) or a top-level statement's value or test
/// body (`#interp.top.fn`) lies behind it -- 2 when it resolves at module
/// level, 0 when the chain has no binding of it.
export fn retention_name_scope(env: TypeEnv, name: String) -> Int {
  let mut cur = env
  let mut found = false
  let mut scope = 0
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, _, rest) => {
        if found && (String::equals(n, "__capture_boundary__") || String::equals(n, "#interp.top.fn")) {
          scope = 1
          done = true
        } else if !found && String::equals(n, name) {
          found = true
          scope = 2
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(n, _, rest) => {
        if !found && String::equals(n, name) {
          found = true
          scope = 2
        } else {
          ()
        }
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      // A name in an accelerator index is a module-level or imported one;
      // the index is otherwise looked through (see `env_marker_before`).
      EnvCached(index, _, rest) => if !found && env_name_index_find(index = index, name = name) >= 0 {
        scope = 2
        done = true
      } else {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  scope
}

/// The scope the closure literal recorded as `text` was written in: what lies
/// under the binding of `bound_name` that its marker sits in front of. An
/// alias copies the marker, so the closure's own binding is found by the
/// marker's payload, not by the name the call spells.
export fn retention_closure_scope(env: TypeEnv, bound_name: String, text: String) -> Option[TypeEnv] {
  let marker = retention_marker(bound_name)
  let mut cur = env
  let mut armed = false
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => {
        if armed && String::equals(n, bound_name) {
          result = Some(rest)
          done = true
        } else if !armed && String::equals(n, marker) {
          armed = match binding.ty {
            CtNamed(t, _) => String::equals(t, text),
            _ => false
          }
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  result
}

fn retention_decl_index(_ name: String) -> Int {
  let mut found = 0 - 1
  let mut i = 0
  while i < Array::length(retention_decls) {
    let (n, _) = Array::get(retention_decls, at = i)
    if found < 0 && String::equals(n, name) {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

//# Callee classification

/// What a call reaches: a lambda the checker can re-check (the literal, the
/// scope its body is checked in, and a key naming it), a parameter of an
/// enclosing lambda (named, to place it against the regions), a function
/// value whose body is not visible, a function imported with the summary of
/// what it keeps (#3360), or a callee whose retention is someone else's
/// question (a builtin, a constructor, an import that keeps nothing).
enum RetentionCallee {
  RetentionVisible(Expr, TypeEnv, String);
  RetentionParam(String);
  RetentionOpaque;
  RetentionSummary(String);
  RetentionTrusted
}

fn retention_module_env() -> Option[TypeEnv] {
  if Array::length(retention_module_env_cell) == 0 {
    None
  } else {
    Some(Array::get(retention_module_env_cell, at = 0))
  }
}

/// A top-level declaration: its literal, re-checked in the module's scope;
/// an alias of another name, followed; any other value, opaque.
fn retention_top_level_callee(name: String, depth: Int) -> RetentionCallee {
  let index = retention_decl_index(name)
  if index < 0 {
    retention_imported_callee(name)
  } else if depth > 8 {
    RetentionOpaque
  } else {
    let (_, val) = Array::get(retention_decls, at = index)
    match let_rhs_closure_literal(val) {
      Some(lit) => match retention_module_env() {
        Some(module_env) => RetentionVisible(lit, env_bind(env = module_env, name = "#interp.top.fn", ty = CtBool), String::concat("top:", name)),
        None => RetentionOpaque
      },
      None => {
        let src = retention_alias_source(val)
        if src == "" {
          RetentionOpaque
        } else {
          retention_top_level_callee(name = src, depth = depth + 1)
        }
      }
    }
  }
}

/// #3360: a name no declaration of this module binds -- an import, a builtin
/// -- answers by the summary its module published, if any.
fn retention_imported_callee(_ name: String) -> RetentionCallee {
  match retention_module_env() {
    Some(module_env) => match env_lookup(env = module_env, name = retention_summary_marker(name)) {
      Some(CtNamed(summary, _)) => if summary == "" {
        RetentionTrusted
      } else {
        RetentionSummary(summary)
      },
      _ => RetentionTrusted
    },
    None => RetentionTrusted
  }
}

/// What the marker in front of the binding of `name` says the binding is.
fn retention_marker_callee(env: TypeEnv, name: String, payload: Type) -> RetentionCallee {
  match payload {
    CtNamed(text, _) => if String::starts_with(text, prefix = "c:") {
      let index = retention_summary_index(String::substring(text, start = 2, end = String::length(text)))
      if index >= 0 && index < Array::length(retention_closures) {
        let (lit, bound_name, is_rec) = Array::get(retention_closures, at = index)
        match retention_closure_scope(env = env, bound_name = bound_name, text = text) {
          Some(def_env) => {
            // A `let rec` closure's body sees its own name; bind it (with its
            // marker) so a recursive call is classified as this closure.
            let scope = if is_rec {
              env_bind(env = env_bind(env = def_env, name = bound_name, ty = CtUnknown), name = retention_marker(bound_name), ty = payload)
            } else {
              def_env
            }
            RetentionVisible(lit, scope, text)
          },
          None => RetentionOpaque
        }
      } else {
        RetentionOpaque
      }
    } else if String::starts_with(text, prefix = "a:") {
      // An alias: what its source name meant where the alias was written.
      match retention_closure_scope(env = env, bound_name = name, text = text) {
        Some(def_env) => retention_named_callee(env = def_env, name = String::substring(text, start = 2, end = String::length(text))),
        None => RetentionOpaque
      }
    } else if String::starts_with(text, prefix = "p:") {
      // A re-checked lambda's parameter, bound to the function its argument
      // was at the call being judged.
      let index = retention_summary_index(String::substring(text, start = 2, end = String::length(text)))
      if index >= 0 && index < Array::length(retention_arg_lambdas) {
        let (lit, scope, _) = Array::get(retention_arg_lambdas, at = index)
        RetentionVisible(lit, scope, text)
      } else {
        RetentionOpaque
      }
    } else if text == "t" {
      RetentionTrusted
    } else {
      RetentionOpaque
    },
    _ => RetentionOpaque
  }
}

/// #3360: the closure literal a local `let` binds `name` to, where `env` can
/// still see that binding -- through the marker `retention_bind_let` lays in
/// front of it, so a later binding of the spelling hides it, and through an
/// alias of such a binding -- with the environment its body is to be read in.
/// That is the closure's own definition scope, not the call's (Codex on
/// #3461: a region-local `let sink` at the call must not stand for the outer
/// `sink` the body captured), with each region active at the call and not
/// yet open where the closure was written laid on top, so a binding the body
/// captured reads as declared before that region. A name bound any other way
/// answers `None`.
export fn retention_local_closure_literal(env: TypeEnv, name: String) -> Option[(Expr, TypeEnv, String)] {
  // Every literal the name is seen to stand for: a local `let`'s (`c:`), a
  // module-level one's (`top:`, Codex on #3461), or the argument a re-checked
  // lambda's parameter was bound to (`p:`), each read in its own scope.
  match retention_named_callee(env = env, name = name) {
    RetentionVisible(lit, scope, key) => Some((lit, retention_with_call_regions(def = scope, call = env), retention_callee_identity(key))),
    _ => None
  }
}

/// #3360: is `name` a binding whose closure the region-retention markers
/// cannot reach -- a `let mut`, an alias of one (Codex on #3461:
/// `let mut stash = ..; let again = stash`), a closure a call produced? A
/// module-level `let` counts too (Codex on #3461): one bound to a call, or at
/// the end of more aliases than `retention_top_level_callee` follows. A
/// parameter and a declared `fn` answer `false`: those are checked where
/// their closure is written.
export fn retention_local_callback_unresolved(env: TypeEnv, name: String) -> Bool {
  match retention_named_callee(env = env, name = name) {
    RetentionOpaque => retention_name_scope(env = env, name = name) != 0,
    _ => false
  }
}

/// `def` with the regions active in `call` that `def` does not have open,
/// outermost first, so the innermost is nearest.
fn retention_with_call_regions(def: TypeEnv, call: TypeEnv) -> TypeEnv {
  let opened = retention_active_region_names(def)
  let regions = retention_active_regions(call)
  let mut out = def
  let mut i = Array::length(regions) - 1
  while i >= 0 {
    let (rname, nursery) = Array::get(regions, at = i)
    if !retention_region_listed(names = opened, rname = rname) {
      out = env_bind(env = out, name = "#active_region", ty = CtNamed(rname, []))
      if nursery {
        out = env_bind(env = out, name = "#active_nursery", ty = CtNamed(rname, [
        ]))
      } else {
        ()
      }
    } else {
      ()
    }
    i = i - 1
  }
  out
}

/// #3540: the closure literal a local `let` bound the binding of `name`
/// visible in `env` to, if it did (`let slot = (f) -> ..`).
export fn retention_local_closure(env: TypeEnv, name: String) -> Option[Expr] {
  match env_marker_before(env = env, marker = retention_marker(name), name = name) {
    Some(CtNamed(text, _)) => if String::starts_with(text, prefix = "c:") {
      let index = retention_summary_index(String::substring(text, start = 2, end = String::length(text)))
      if index >= 0 && index < Array::length(retention_closures) {
        let (lit, _, _) = Array::get(retention_closures, at = index)
        Some(lit)
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

fn retention_named_callee(env: TypeEnv, name: String) -> RetentionCallee {
  match env_marker_before(env = env, marker = retention_marker(name), name = name) {
    Some(payload) => retention_marker_callee(env = env, name = name, payload = payload),
    None => {
      let scope = retention_name_scope(env = env, name = name)
      if scope == 1 {
        // `check_lambda_expr` lays `__param_marker__<name>` in front of
        // every parameter it binds.
        match env_marker_before(env = env, marker = String::concat("__param_marker__", name), name = name) {
          Some(_) => RetentionParam(name),
          None => RetentionOpaque
        }
      } else {
        retention_top_level_callee(name = name, depth = 0)
      }
    }
  }
}

//# Regions at the call

/// The regions active in `env`, innermost first, each with whether it is a
/// task group's (`#active_nursery`).
export fn retention_active_regions(_ env: TypeEnv) -> Array[(String, Bool)] {
  let names = array_empty()
  let nurseries = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => {
        if String::equals(n, "#active_region") {
          match binding.ty {
            CtNamed(rname, _) => Array::push(names, value = rname),
            _ => ()
          }
        } else if String::equals(n, "#active_nursery") {
          match binding.ty {
            CtNamed(rname, _) => Array::push(nurseries, value = rname),
            _ => ()
          }
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvCached(_, _, rest) => {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  let out = array_empty()
  for rname in names {
    let mut nursery = false
    for nn in nurseries {
      if String::equals(nn, rname) {
        nursery = true
      } else {
        ()
      }
    }
    let mut seen = false
    for existing in out {
      let (en, _) = existing
      if String::equals(en, rname) {
        seen = true
      } else {
        ()
      }
    }
    if !seen {
      Array::push(out, value = (rname, nursery))
    } else {
      ()
    }
  }
  out
}

fn retention_string_has(items: Array[String], wanted: String) -> Bool {
  let mut found = false
  for item in items {
    if String::equals(item, wanted) {
      found = true
    } else {
      ()
    }
  }
  found
}

/// The regions a binding named `name` was declared before, as seen from
/// `env`: every region marker passed before the binding is reached (all of
/// them for a binding the chain does not hold -- a top-level or imported
/// name), plus the regions a local alias of an outer binding records.
fn retention_name_predates(env: TypeEnv, name: String) -> Array[String] {
  let out = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => if String::equals(n, name) {
        done = true
      } else {
        if String::equals(n, "#active_region") {
          match binding.ty {
            CtNamed(rname, _) => if !retention_string_has(items = out, wanted = rname) {
              Array::push(out, value = rname)
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(n, _, rest) => if String::equals(n, name) {
        done = true
      } else {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvCached(index, _, rest) => if env_name_index_find(index = index, name = name) >= 0 {
        done = true
      } else {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  match env_marker_before(env = env, marker = String::concat("__region_outer_alias__", name), name = name) {
    Some(CtTuple(regions)) => {
      for r in regions {
        match r {
          CtNamed(rname, _) => if !retention_string_has(items = out, wanted = rname) {
            Array::push(out, value = rname)
          } else {
            ()
          },
          _ => ()
        }
      }
      ()
    },
    Some(_) => {
      for active in retention_active_regions(env) {
        let (rname, _) = active
        if !retention_string_has(items = out, wanted = rname) {
          Array::push(out, value = rname)
        } else {
          ()
        }
      }
      ()
    },
    None => ()
  }
  out
}

/// The regions the location an argument names was declared before: a name,
/// a field or element of one, or a call the checker knows returns an outer
/// binding. A fresh value names no location.
fn retention_arg_predates(arg: Expr, env: TypeEnv) -> Array[String] {
  match arg {
    EIdent(name, _) => retention_name_predates(env = env, name = name),
    EDot(obj, _, _, _) => retention_arg_predates(arg = obj, env = env),
    ECall(EIdent("__index", _), args, _, _) => if Array::length(args) > 0 {
      retention_arg_predates(arg = Array::get(args, at = 0), env = env)
    } else {
      array_empty()
    },
    ECall(_, _, _, _) => if expression_aliases_outer_binding(expr = arg, env = env) {
      for active in retention_active_regions(env) {
        let (rname, _) = active
        rname
      }
    } else {
      array_empty()
    },
    // #3488: a literal, conditional or block names what its parts do.
    _ => retention_args_predate(items = retention_result_items(arg), env = env)
  }
}

fn retention_args_predate(items: Array[Expr], env: TypeEnv) -> Array[String] {
  let out: Array[String] = []
  for item in items {
    if !literal_item_is_inert(item = item, env = env) {
      for r in retention_arg_predates(arg = item, env = env) {
        if !retention_string_has(items = out, wanted = r) {
          Array::push(out, value = r)
        }
      }
    }
  }
  out
}

//# The re-check

/// The per-run tables a check of a lambda body may change, as they were.
struct RetentionCheckpoint {
  field_reads: Array[(Int, String, Int, Int, String, Int)];
  eq_sites: Array[(Int, Type, String)];
  callee_inst: Int;
  value_inst: Int;
  map_sites: Int;
  throw_sites: Int;
  efn_formals: Int;
  formal_rows: Int;
  let_rhs: Array[Bool];
  override_cell: Array[Array[(Type, Array[String], String, Array[String])]]
}

fn retention_checkpoint() -> RetentionCheckpoint {
  RetentionCheckpoint::{
    field_reads: Array::slice(deferred_field_reads, start = 0, end = Array::length(deferred_field_reads)),
    eq_sites: Array::slice(deferred_eq_sites, start = 0, end = Array::length(deferred_eq_sites)),
    callee_inst: Array::length(callee_inst_types_cell),
    value_inst: Array::length(value_inst_types_cell),
    map_sites: Array::length(map_key_site_offsets),
    throw_sites: Array::length(throw_payload_sites),
    efn_formals: Array::length(efn_substituted_formals),
    formal_rows: eq_formal_rows_mark(),
    let_rhs: Array::slice(spawn_value_let_rhs_cell, start = 0, end = Array::length(spawn_value_let_rhs_cell)),
    override_cell: Array::slice(retention_param_override_cell, start = 0, end = Array::length(retention_param_override_cell))
  }
}

fn retention_restore(_ cp: RetentionCheckpoint) -> Unit {
  Array::truncate(deferred_field_reads, length = 0)
  for row in cp.field_reads {
    Array::push(deferred_field_reads, value = row)
  }
  Array::truncate(deferred_eq_sites, length = 0)
  for row in cp.eq_sites {
    Array::push(deferred_eq_sites, value = row)
  }
  rewind_call_records(callee_mark = cp.callee_inst, value_mark = cp.value_inst, map_site_mark = cp.map_sites)
  if Array::length(throw_payload_sites) > cp.throw_sites {
    Array::truncate(throw_payload_sites, length = cp.throw_sites)
  } else {
    ()
  }
  eq_formal_rows_restore(efn_mark = cp.efn_formals, mark = cp.formal_rows)
  Array::truncate(spawn_value_let_rhs_cell, length = 0)
  for flag in cp.let_rhs {
    Array::push(spawn_value_let_rhs_cell, value = flag)
  }
  Array::truncate(retention_param_override_cell, length = 0)
  for row in cp.override_cell {
    Array::push(retention_param_override_cell, value = row)
  }
  ()
}

/// What a re-check found: 0 nothing, 1 a write that keeps the region past it,
/// 2 only a call that hands the region to a function nothing is known about.
fn retention_escape_kind(_ errors: Array[String]) -> Int {
  let mut kind = 0
  for e in errors {
    if String::starts_with(e, prefix = "region escapes its") {
      if String::contains(e, needle = " stores ") {
        kind = 1
      } else if kind == 0 && String::contains(e, needle = " passes ") {
        kind = 2
      } else {
        ()
      }
    } else {
      ()
    }
  }
  kind
}

/// Bind every region of `regions` that `base` does not already have active
/// above it, outermost first, the way a region body's environment binds its
/// own.
fn retention_region_env(base: TypeEnv, regions: Array[(String, Bool)]) -> TypeEnv {
  let present = retention_active_regions(base)
  let mut env = base
  let mut i = Array::length(regions) - 1
  while i >= 0 {
    let (rname, nursery) = Array::get(regions, at = i)
    let mut already = false
    for p in present {
      let (pn, _) = p
      if String::equals(pn, rname) {
        already = true
      } else {
        ()
      }
    }
    if !already {
      let region_ty = CtNamed(rname, [])
      let with_nursery = if nursery {
        env_bind(env = env, name = "#active_nursery", ty = region_ty)
      } else {
        env
      }
      env = env_cache_binding(env = env_bind(env = with_nursery, name = "#active_region", ty = region_ty), name = "#active_region", ty = region_ty)
    } else {
      ()
    }
    i = i - 1
  }
  env
}

/// Check `lit` again in `scope` under `regions`, with `overrides` for its
/// parameters, and report what its writes do with them; its diagnostics land
/// in `found`. `c` is in the re-check's own variable range. `key` names the
/// callee and the argument shape; a re-check already in progress for the same
/// key answers nothing new, and a chain of re-checks deeper than any real
/// program builds is refused rather than cut off silently.
export fn retention_recheck(lit: Expr, scope: TypeEnv, regions: Array[(String, Bool)], overrides: Array[(Type, Array[String], String, Array[String])], key: String, defs: Array[TypeDef], s: Subst, c: Int, found: Array[String], check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> (Int, Array[String]) {
  // A re-check skipped -- already in progress for this key, or a chain
  // deeper than any real program builds -- says nothing about the callee's
  // result, so it answers that the result may carry every region.
  let every = for r in regions {
    let (rname, _) = r
    rname
  }
  if retention_string_has(items = retention_recheck_stack, wanted = key) {
    (0, every)
  } else if Array::length(retention_recheck_stack) >= 24 {
    (1, every)
  } else {
    Array::push(retention_recheck_stack, value = key)
    let scalar_mark = scalar_local_sites_mark()
    let cp = retention_checkpoint()
    Array::truncate(retention_param_override_cell, length = 0)
    Array::push(retention_param_override_cell, value = overrides)
    Array::truncate(retention_result_cell, length = 0)
    let rc_errors = found
    let rc_tab = array_empty()
    let _ = check_child(lit, retention_region_env(base = scope, regions = regions), defs, s, c, rc_errors, rc_tab, None, "AuxiliaryRetentionRecheck")
    let result_regions = Array::slice(retention_result_cell, start = 0, end = Array::length(retention_result_cell))
    Array::truncate(retention_result_cell, length = 0)
    retention_restore(cp)
    scalar_local_sites_rewind(scalar_mark)
    Array::truncate(retention_recheck_stack, length = Array::length(retention_recheck_stack) - 1)
    (retention_escape_kind(rc_errors), result_regions)
  }
}

/// The argument types of a call, checked in a throwaway lane, with the
/// substitution they were read against and the next variable of the
/// re-check's own range.
fn retention_arg_types(args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> (Array[Type], Subst, Int) {
  let raw = array_empty()
  let mut s1 = s
  let mut c1 = c + retention_counter_gap()
  for arg in args {
    let throwaway = array_empty()
    let throwtab = array_empty()
    let (at, ns, nc) = check_child(arg, env, defs, s1, c1, throwaway, throwtab, None, "AuxiliaryRetentionRecheck")
    Array::push(raw, value = at)
    s1 = ns
    c1 = nc
  }
  let tys = for t in raw {
    subst_apply(s = s1, ty = t)
  }
  (tys, s1, c1)
}

/// The active regions a closure literal's captured bindings carry, read in
/// the scope it was written in.
fn retention_captured_regions(lit: Expr, scope: TypeEnv, defs: Array[TypeDef], s: Subst, regions: Array[(String, Bool)]) -> Array[(String, Bool)] {
  let out = array_empty()
  match lit {
    EFn(_, _, params, _, _, body) => {
      // What a captured binding carries without its type showing it is
      // asked only for the regions active where the closure was written: a
      // closure written before a region captured nothing of it.
      let scope_active = retention_active_region_names(scope)
      for name in closure_free_names(body = body, params = params) {
        match env_lookup(env = scope, name = name) {
          Some(ty) => {
            for r in retention_regions_mentioned(ty = subst_apply(s = s, ty = ty), regions = regions) {
              Array::push(out, value = r)
            }
            let hidden = retention_name_carried(env = scope, name = name, active = scope_active, defs = defs, s = s)
            for r in regions {
              let (rname, _) = r
              if retention_string_has(items = hidden, wanted = rname) {
                Array::push(out, value = r)
              } else {
                ()
              }
            }
            ()
          },
          None => ()
        }
      }
      ()
    },
    _ => ()
  }
  out
}

fn retention_type_may_be_function(_ ty: Type) -> Bool {
  match ty {
    CtFn(_, _, _) => true,
    CtForAll(_, _, body) => retention_type_may_be_function(body),
    CtVar(_) => true,
    CtUnknown => true,
    _ => false
  }
}

/// What a function argument is, for the parameter it is passed to: `p:` and
/// the index of the lambda it stands for (a literal, with the call's scope;
/// a function or `let`-bound closure, with its own), `t` for a callee whose
/// retention is someone else's question, empty for a parameter of an
/// enclosing lambda written inside the regions (its own calls answer for
/// it), `o` for anything else.
fn retention_arg_callee(arg: Expr, arg_ty: Type, env: TypeEnv) -> String {
  let lambda_index = (lit: Expr, scope: TypeEnv, identity: String) -> {
    let index = Array::length(retention_arg_lambdas)
    let named = if identity == "" {
      String::concat("lit@", __to_string(index))
    } else {
      identity
    }
    Array::push(retention_arg_lambdas, value = (lit, scope, named))
    String::concat("p:", __to_string(index))
  }
  match arg {
    EFn(_, _, _, _, _, _) => lambda_index(arg, env, ""),
    EIdent(an, _) => if retention_type_may_be_function(arg_ty) {
      match retention_named_callee(env = env, name = an) {
        RetentionVisible(lit, scope, key) => lambda_index(lit, scope, retention_callee_identity(key)),
        RetentionTrusted => "t",
        // An imported function handed on as an argument is not followed into.
        RetentionSummary(_) => "t",
        RetentionParam(pn) => if Array::length(retention_name_predates(env = env, name = pn)) == 0 {
          ""
        } else {
          "o"
        },
        RetentionOpaque => "o"
      }
    } else {
      ""
    },
    _ => if retention_type_may_be_function(arg_ty) {
      "o"
    } else {
      ""
    }
  }
}

/// Codex on #3359: what a callee key names, the same at every level of a
/// recursion -- a `p:` key is a slot of this re-check's argument table, which
/// a recursive call fills again, so it answers for the lambda the slot holds
/// (a top-level function or `let`-bound closure by its own key, a literal by
/// the slot it was first given). Two calls whose arguments are different
/// functions must not share a re-check: a helper that recurses with another
/// callback (`loop(safe, h)` calling `loop(stash, h)`) would otherwise have
/// only the first callback checked.
fn retention_callee_identity(_ key: String) -> String {
  if String::starts_with(key, prefix = "p:") {
    let index = retention_summary_index(String::substring(key, start = 2, end = String::length(key)))
    if index >= 0 && index < Array::length(retention_arg_lambdas) {
      let (_, _, identity) = Array::get(retention_arg_lambdas, at = index)
      identity
    } else {
      key
    }
  } else {
    key
  }
}

fn retention_regions_intersect(names: Array[String], regions: Array[(String, Bool)]) -> Bool {
  let mut hit = false
  for r in regions {
    let (rname, _) = r
    if retention_string_has(items = names, wanted = rname) {
      hit = true
    } else {
      ()
    }
  }
  hit
}

/// The shared core of a call check: `callee` already classified,
/// `callee_expr` the callee as written, `label` the spelling the diagnostic
/// names, `marker` its location.
fn retention_check_callee(callee: RetentionCallee, callee_expr: Expr, label: String, marker: String, call_key: Int, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> Unit {
  // A labeled argument is its value (`retention_arg_values`).
  let args = retention_arg_values(args)
  match callee {
    RetentionTrusted => (),
    _ => {
      let regions = retention_active_regions(env)
      let scalar_mark = scalar_local_sites_mark()
      let cp = retention_checkpoint()
      let (arg_tys, s_args, c_args) = retention_arg_types(args = args, env = env, defs = defs, s = s, c = c, check_child = check_child)
      retention_restore(cp)
      scalar_local_sites_rewind(scalar_mark)
      let mentioned = array_empty()
      // Codex on #3359: an argument may carry a region its type does not
      // show -- a struct built from the token, a closure that captured it --
      // so its value is asked too, and the parameter it is passed to records
      // what it carries.
      let hidden_by_arg = array_empty()
      let mut hi = 0
      while hi < Array::length(arg_tys) {
        let t = Array::get(arg_tys, at = hi)
        for r in retention_regions_mentioned(ty = t, regions = regions) {
          Array::push(mentioned, value = r)
        }
        let hidden = if retention_type_hides_region(t = t, defs = defs) {
          retention_value_regions(expr = Array::get(args, at = hi), env = env, defs = defs, s = s_args)
        } else {
          array_empty()
        }
        for r in regions {
          let (rname, _) = r
          if retention_string_has(items = hidden, wanted = rname) {
            Array::push(mentioned, value = r)
          } else {
            ()
          }
        }
        Array::push(hidden_by_arg, value = hidden)
        hi = hi + 1
      }
      match callee {
        RetentionVisible(lit, scope, key) => {
          // A closure that captured a value of the region may hand it to a
          // function it is passed, so it is checked even when no argument
          // carries the region.
          let triggers = array_empty()
          for r in mentioned {
            Array::push(triggers, value = r)
          }
          for r in retention_captured_regions(lit = lit, scope = scope, defs = defs, s = s_args, regions = regions) {
            Array::push(triggers, value = r)
          }
          if Array::length(triggers) > 0 {
            let lambdas_before = Array::length(retention_arg_lambdas)
            let overrides = array_empty()
            // The key names the callee and, for each argument, whether it
            // carries a region (and which, where its type hides them), the
            // regions its location predates, and the function it is.
            let mut shape = retention_callee_identity(key)
            let mut ai = 0
            while ai < Array::length(args) {
              let arg = Array::get(args, at = ai)
              let arg_ty = Array::get(arg_tys, at = ai)
              let predates = retention_arg_predates(arg = arg, env = env)
              let hidden = Array::get(hidden_by_arg, at = ai)
              let fn_arg = retention_arg_callee(arg = arg, arg_ty = arg_ty, env = env)
              Array::push(overrides, value = (arg_ty, predates, fn_arg, hidden))
              // Codex on #3359: WHICH regions the argument carries, not
              // whether it carries one -- a recursive call that moves an
              // inner group's handle into a parameter the first call gave
              // an outer one is another shape, and is checked again.
              let shown = for r in retention_regions_mentioned(ty = arg_ty, regions = regions) {
                let (rname, _) = r
                rname
              }
              shape = String::concat(shape, String::concat("|", String::concat(String::join(shown, sep = ","), String::concat("/", String::concat(String::join(predates, sep = ","), String::concat("/", String::concat(String::join(hidden, sep = ","), String::concat("/", retention_callee_identity(fn_arg)))))))))
              ai = ai + 1
            }
            let (kind, result_regions) = retention_recheck(lit = lit, scope = scope, regions = regions, overrides = overrides, key = shape, defs = defs, s = s_args, c = c_args, found = array_empty(), check_child = check_child)
            Array::truncate(retention_arg_lambdas, length = lambdas_before)
            if call_key >= 0 {
              Array::push(retention_call_rows, value = (call_key, result_regions))
            } else {
              ()
            }
            // A callee that keeps nothing may still RETURN the token, under
            // a type that does not show it (`-> TaskHandle[Int]`, a struct).
            // That is not refused here: the call's result carries the
            // regions this check found in the callee's result (the row
            // above, read by `retention_walk`), so the caller's own write,
            // return or call of the result is judged as if the token were in
            // plain view, and a caller that keeps the result inside the body
            // -- joins it, matches on it -- is legal.
            if kind > 0 {
              Array::push(errors, value = String::concat(retention_call_message(callee = label, nursery = retention_any_nursery(triggers), kind = kind), marker))
            } else {
              ()
            }
          } else if call_key >= 0 {
            // Nothing the call hands over, and nothing the callee captured,
            // carries a region: neither does its result.
            Array::push(retention_call_rows, value = (call_key, array_empty()))
          } else {
            ()
          }
        },
        // A parameter of a lambda written inside every region its argument
        // carries is answered for at that lambda's own calls, where the
        // argument is known; one bound before the region (the function that
        // minted it took it) is not.
        RetentionParam(pname) => if Array::length(mentioned) > 0 && retention_regions_intersect(names = retention_name_predates(env = env, name = pname), regions = mentioned) {
          Array::push(errors, value = String::concat(retention_opaque_message(callee = label, nursery = retention_any_nursery(mentioned)), marker))
        } else {
          ()
        },
        // #3360: an imported function, by the summary its module published:
        // what each argument carries, against where each is declared.
        RetentionSummary(summary) => if Array::length(mentioned) > 0 {
          let carried = array_empty()
          let predates = array_empty()
          let mut ai = 0
          while ai < Array::length(args) {
            let names = array_empty()
            let hidden = Array::get(hidden_by_arg, at = ai)
            for r in regions {
              let (rname, _) = r
              if type_mentions_named(ty = Array::get(arg_tys, at = ai), name = rname) || retention_string_has(items = hidden, wanted = rname) {
                Array::push(names, value = rname)
              } else {
                ()
              }
            }
            Array::push(carried, value = names)
            Array::push(predates, value = retention_arg_predates(arg = Array::get(args, at = ai), env = env))
            ai = ai + 1
          }
          let kind = retention_summary_refuses(summary = summary, carried = carried, predates = predates)
          if kind > 0 {
            Array::push(errors, value = String::concat(retention_call_message(callee = label, nursery = retention_any_nursery(mentioned), kind = kind), marker))
          } else {
            ()
          }
        } else {
          ()
        },
        _ => if Array::length(mentioned) > 0 {
          Array::push(errors, value = String::concat(retention_opaque_message(callee = label, nursery = retention_any_nursery(mentioned)), marker))
        } else {
          ()
        }
      }
    }
  }
}

/// #3343: a call by name made inside an active region. When an argument or
/// a visible closure capture carries an active region, the callee is checked for what it
/// keeps: a function of this module or a `let`-bound closure literal is
/// re-checked under the call's regions; a local function value with no
/// visible body is refused; a builtin, a constructor, an imported function,
/// and a runner (checked by its own branch) are left alone. The diagnostic
/// uses the named token; the result uses the lookup key of this call shape.
export fn retention_call_region_check(name: String, name_off: Int, call_key: Int, span_len: Int, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> Unit {
  if env_has_active_region(env) && !builtin_resolves_at(env = env, name = name, ident_off = name_off) && !callee_is_run_shaped(env = env, s = s, name = name) {
    retention_check_callee(callee = retention_named_callee(env = env, name = name), callee_expr = EIdent(name, name_off), label = name, marker = off_marker_len(off = name_off, len = span_len), call_key = call_key, args = args, env = env, defs = defs, s = s, c = c, errors = errors, check_child = check_child)
  } else {
    ()
  }
}

/// #3343: a call whose callee is an expression rather than a name, made
/// inside an active region: a lambda applied where it is written is
/// re-checked like a `let`-bound one; any other callee (a call's result, a
/// function stored in a field) has no visible body.
export fn retention_expr_callee_region_check(callee: Expr, label: String, marker_off: Int, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> Unit {
  if env_has_active_region(env) {
    let classified = match callee {
      EFn(_, _, _, _, _, _) => RetentionVisible(callee, env, String::concat("lambda:", __to_string(marker_off))),
      _ => RetentionOpaque
    }
    retention_check_callee(callee = classified, callee_expr = callee, label = label, marker = off_marker(marker_off), call_key = marker_off, args = args, env = env, defs = defs, s = s, c = c, errors = errors, check_child = check_child)
  } else {
    ()
  }
}

/// #3343: whether the body a `TaskGroup::run` call is handed BY NAME keeps
/// the call's own token past the group, and whether its result carries the
/// token. The kind is 0 no, 1 a write stores it in a binding declared
/// outside the body, 2 or 6 it hands the token to a function that loses
/// track of it, 5 the body is not visible here at all. A literal body is
/// checked inside the region already; a name bound to a closure literal or
/// a top-level function is re-checked under the region with its parameter
/// bound to the group; anything else -- a `let mut` closure, a parameter, a
/// call's result, a function stored in a field (Codex on #3359) -- is
/// refused, except a function imported from another module (see the header).
export fn retention_named_run_body(body: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, region_ty: Type, group_ty: Type, check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> (Int, Bool) {
  match region_ty {
    CtNamed(rname, _) => match body {
      // A literal is checked inside the region where it is written; one of
      // another arity is a type error reported by the call.
      EFn(_, _, _, _, _, _) => (0, false),
      EIdent(name, _) => match retention_named_callee(env = env, name = name) {
        RetentionVisible(lit, scope, key) => {
          let regions = retention_active_regions(env)
          let all_regions = array_empty()
          Array::push(all_regions, value = (rname, true))
          for r in regions {
            Array::push(all_regions, value = r)
          }
          let (kind, result_regions) = retention_recheck(lit = lit, scope = scope, regions = all_regions, overrides = [
            (group_ty, array_empty(), "", array_empty())
          ], key = String::concat("run|", String::concat(retention_callee_identity(key), String::concat("|", String::join(for r in all_regions {
            let (an, _) = r
            an
          }, sep = ",")))), defs = defs, s = s, c = c + retention_counter_gap(), found = array_empty(), check_child = check_child)
          (kind, retention_string_has(items = result_regions, wanted = rname))
        },
        // A function imported from another module: by the summary it
        // published (#3360), whose one argument is the group.
        RetentionSummary(summary) => (retention_summary_refuses(summary = summary, carried = [
          [rname]
        ], predates = [array_empty()]), retention_summary_result_from(summary = summary, i = 0)),
        RetentionTrusted => (0, false),
        // Codex on #3359: a `let mut` closure, a value no closure literal is
        // bound to, a parameter -- checked where it was written, outside
        // this region, and nothing about what it keeps is known.
        _ => (5, false)
      },
      // A call's result, a function stored in a field, a branch: the same.
      _ => (5, false)
    },
    _ => (0, false)
  }
}

/// #3343: the refusal for a body passed by name, by `retention_named_run_body`'s
/// answer.
//# What an exported function keeps

/// #3360: `env` with the summary of what each function this module publishes
/// keeps of its arguments (`retention_summaries_bind`), each found by
/// re-checking the function's literal as a call made in a region would. Only
/// a module checked for publication is summarized.
export fn retention_bind_module_summaries(stmts: Array[Stmt], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, check_child: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], Option[TypedOccurrenceRoleLaneCapture], String) -> (Type, Subst, Int)) -> TypeEnv {
  if !retention_summaries_enabled() {
    env
  } else {
    let scope = env_bind(env = env, name = "#interp.top.fn", ty = CtBool)
    let base = c + retention_counter_gap()
    let regions = [(retention_summary_region(), false)]
    retention_summaries_bind(stmts = stmts, env = env, defs = defs, resolve = (name) -> match retention_top_level_callee(name = name, depth = 0) {
      RetentionVisible(lit, _, _) => (1, lit),
      RetentionOpaque => (2, EUnit),
      _ => (0, EUnit)
    }, fresh = (k) -> CtVar(base + k), recheck = (lit, overrides, key) -> {
      let (kind, result) = retention_recheck(lit = lit, scope = scope, regions = regions, overrides = overrides, key = key, defs = defs, s = s, c = base + 4096, found = array_empty(), check_child = check_child)
      (kind, retention_string_has(items = result, wanted = retention_summary_region()))
    })
  }
}
