  env_name_index_find,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  subst_apply
}

import @vibe/core {
  array_empty
}

import ./builtin_call_arms.vibe {
  builtin_resolves_at
}

import ./checker_effects_mutability_expr_into.vibe {
  collect_pat_binds_into
}

import ./checker_spawnable.vibe {
  closure_free_names, env_marker_before
}

import ./checker_builtin_arg_head_rest.vibe {
