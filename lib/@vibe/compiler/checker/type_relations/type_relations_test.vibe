import @vibe/compiler/core {
  Subst, Type
}
import @vibe/compiler/checker/type_relations {
  check_assignable
}
test "assignability reports a concrete mismatch at its source anchor" {
  let errors: Array[String] = []
  let _ = check_assignable(CtInt, CtInt, SubstEmpty, errors, "value", 12)
  inspect(Array::length(errors), content = "0")
  let _ = check_assignable(CtInt, CtString, SubstEmpty, errors, "value", 12)
  inspect(Array::length(errors), content = "1")
  inspect(String::ends_with(Array::get(errors, 0), " [@off=12]"), content = "true")
}
