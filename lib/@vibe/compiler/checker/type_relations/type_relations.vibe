import @vibe/compiler/core {
  Subst,
  Type,
  TypeDef,
  compiler_owned_type_arity,
  effect_var_spelling,
  exception_effect_labels_equal,
  exception_label_kind,
  find_typedef,
  instantiate,
  is_effect_inst_label,
  is_exception_label,
  is_hkt_app,
  is_runtime_scheduled_effect,
  occurs_in,
  owned_head_payload_span,
  subst_apply,
  subst_bind_value,
  subst_lookup,
  type_application_view,
  type_to_string,
  unify
}

import @vibe/core {
  array_empty, struct MutMap
}

import @vibe/compiler/checker/diagnostics {
  off_marker, off_marker_enclosing, off_marker_len
}

let assignable_span_end: Array[Int] = array_empty()

let assignable_enclosing: Array[String] = array_empty()

export fn check_assignable_set_end(end: Int) -> Unit {
  Array::truncate(assignable_span_end, 0)
  Array::truncate(assignable_enclosing, 0)
  if end > 0 {
    Array::push(assignable_span_end, end)
  } else {
    ()
  }
}

/// #3305: the next mismatch's offset is an element INSIDE a tuple or array
/// literal, and `path` the brackets from that literal down to it
/// (`off_marker_enclosing`). An empty `path` clears it, and so does
/// `check_assignable_set_end`. The next reported mismatch consumes it; a
/// caller whose check reports nothing clears it, so it cannot reach an
/// unrelated diagnostic.
export fn check_assignable_set_enclosing(path: String) -> Unit {
  Array::truncate(assignable_enclosing, 0)
  if String::length(path) > 0 {
    Array::push(assignable_enclosing, path)
  } else {
    ()
  }
}

fn assignable_marker(off: Int) -> String {
  if Array::length(assignable_enclosing) > 0 {
    let path = Array::get(assignable_enclosing, 0)
    Array::truncate(assignable_enclosing, 0)
    Array::truncate(assignable_span_end, 0)
    off_marker_enclosing(off, path)
  } else if Array::length(assignable_span_end) > 0 {
    let end = Array::get(assignable_span_end, 0)
    Array::truncate(assignable_span_end, 0)
    if end > off {
      off_marker_len(off, end - off)
    } else {
      off_marker(off)
    }
  } else {
    off_marker(off)
  }
}

/// Erase every effect annotation in a type (recursively), so an argument can be
/// checked for STRUCTURAL compatibility independent of effects. Effects on
/// function VALUES are inferred imprecisely (a `with Exception` callback often
/// arrives typed with no effect), so an effect-only difference must not be
/// reported as a type error — only the structural shape is enforced here.
fn strip_effects(ty: Type) -> Type {
  match ty {
    CtFn(params, ret, _) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, strip_effects(Array::get(params, i)))
        i = i + 1
      }
      CtFn(out, strip_effects(ret), None)
    },
    CtArray(elem) => CtArray(strip_effects(elem)),
    CtOption(elem) => CtOption(strip_effects(elem)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, strip_effects(Array::get(elems, i)))
        i = i + 1
      }
      CtTuple(out)
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, strip_effects(Array::get(args, i)))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => ty
  }
}

/// #3518: the structural retry unifies effect-STRIPPED types, so a variable
/// it binds holds a stripped type -- `T := () -> Int` for an actual
/// `() -> Int with Log` -- and a later use of `T` would refuse the row the
/// value really has, or accept a slot that drops it. Bind each variable the
/// retry bound (`su`) from the UNSTRIPPED type on the other side instead: a
/// variable of `expected` from the actual, and one of `actual` (`?u` of an
/// untyped `[]`) from the expected.
///
/// A variable met more than once must meet the SAME type at every
/// occurrence, rows included, up to the open variables an occurrence still
/// holds (`retry_merge`); those are then bound from the merge, unstripped.
/// Rows that differ anywhere -- `(T, T)` given a pure and a `Log` function,
/// or two callbacks under an `Array` -- are refused rather than reconciled:
/// a union is wrong at a parameter, an intersection is wrong at a result,
/// and a mutable or user-declared container is wrong under either, so no
/// rule that picks one is sound everywhere. The edit is to write the
/// function type the value should have. A variable the walk does not reach
/// keeps the retry's own binding when that binding holds no function type,
/// since stripping changes nothing else; left open, a `T: Send` bound would
/// be skipped. One that holds a function is refused too.
fn retry_bind_unstripped(expected: Type, actual: Type, s: Subst, su: Subst) -> Option[Subst] {
  let occ: Array[(Int, Type)] = array_empty()
  retry_collect_occurrences(expected, actual, s, su, occ)
  let mut out = s
  let mut ok = true
  let mut i = 0
  while i < Array::length(occ) && ok {
    let (id, _) = Array::get(occ, i)
    match subst_lookup(out, id) {
      Some(_) => (),
      None => match retry_merge_occurrences(occ, id) {
        Some(t) => if occurs_in(id, t) {
          ()
        } else {
          out = retry_unify_occurrences(occ, id, t, subst_bind_value(id, t, out))
        },
        None => ok = false
      }
    }
    i = i + 1
  }
  // A variable can be bound by ANOTHER variable's merge (`U` inside
  // `Option[U]` beside `Option[logged]`), and then its own occurrences were
  // never compared with that binding. Every occurrence is checked against the
  // final binding of its variable.
  let mut ci = 0
  while ci < Array::length(occ) && ok {
    let (id, t) = Array::get(occ, ci)
    match subst_lookup(out, id) {
      Some(_) => match retry_merge(subst_apply(out, CtVar(id)), subst_apply(out, t)) {
        Some(_) => (),
        None => ok = false
      },
      None => ()
    }
    ci = ci + 1
  }
  let vars: Array[Int] = array_empty()
  retry_collect_vars(subst_apply(s, expected), vars)
  retry_collect_vars(subst_apply(s, actual), vars)
  let mut vi = 0
  while vi < Array::length(vars) && ok {
    let id = Array::get(vars, vi)
    match subst_lookup(out, id) {
      Some(_) => (),
      None => match subst_lookup(su, id) {
        Some(t) => {
          let bound = subst_apply(su, t)
          if retry_type_has_fn(bound) {
            ok = false
          } else if occurs_in(id, bound) {
            ()
          } else {
            out = subst_bind_value(id, bound, out)
          }
        },
        None => ()
      }
    }
    vi = vi + 1
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// Bind the variables every other occurrence of `id` still holds -- `?u` of
/// a `None` beside `Some(logged)` -- from the UNSTRIPPED merge at the same
/// position (`retry_bind_from`), so they keep its rows; what that leaves is
/// unified with rows set aside (the merge already matched them). An
/// occurrence that does not unify is left alone.
fn retry_unify_occurrences(occ: Array[(Int, Type)], id: Int, chosen: Type, s: Subst) -> Subst {
  let mut out = s
  let mut i = 0
  while i < Array::length(occ) {
    let (oid, other) = Array::get(occ, i)
    if oid == id {
      out = retry_bind_from(other, chosen, out)
      match unify(strip_effects(subst_apply(out, chosen)), strip_effects(subst_apply(out, other)), out) {
        Some(u) => out = u,
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Bind each open variable of `pattern` to the subtree of `source` at the
/// same position, unstripped.
fn retry_bind_from(pattern: Type, source: Type, s: Subst) -> Subst {
  let p = subst_apply(s, pattern)
  match p {
    CtVar(id) => if occurs_in(id, source) {
      s
    } else {
      subst_bind_value(id, source, s)
    },
    CtFn(pps, pr, _) => match source {
      CtFn(sps, sr, _) => retry_bind_from(pr, sr, retry_bind_from_all(pps, sps, s)),
      _ => s
    },
    CtArray(pe) => match source {
      CtArray(se) => retry_bind_from(pe, se, s),
      _ => s
    },
    CtOption(pe) => match source {
      CtOption(se) => retry_bind_from(pe, se, s),
      _ => s
    },
    CtTuple(pes) => match source {
      CtTuple(ses) => retry_bind_from_all(pes, ses, s),
      _ => s
    },
    CtNamed(pn, pas) => match source {
      CtNamed(sn, sas) => if pn == sn {
        retry_bind_from_all(pas, sas, s)
      } else {
        s
      },
      _ => s
    },
    CtRecord(pfs) => match source {
      CtRecord(sfs) => match retry_record_pairs(pfs, sfs) {
        Some((pts, sts)) => retry_bind_from_all(pts, sts, s),
        None => s
      },
      _ => s
    },
    _ => s
  }
}

fn retry_bind_from_all(ps: Array[Type], ss: Array[Type], s: Subst) -> Subst {
  if Array::length(ps) == Array::length(ss) {
    let mut out = s
    let mut i = 0
    while i < Array::length(ps) {
      out = retry_bind_from(Array::get(ps, i), Array::get(ss, i), out)
      i = i + 1
    }
    out
  } else {
    s
  }
}

/// Every occurrence of `id` merged into one type, or None when two of them
/// carry different rows.
fn retry_merge_occurrences(occ: Array[(Int, Type)], id: Int) -> Option[Type] {
  let mut acc = None
  let mut ok = true
  let mut i = 0
  while i < Array::length(occ) && ok {
    let (oid, t) = Array::get(occ, i)
    if oid == id {
      acc = match acc {
        None => Some(t),
        Some(a) => match retry_merge(a, t) {
          Some(m) => Some(m),
          None => {
            ok = false
            None
          }
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  if ok {
    acc
  } else {
    None
  }
}

/// `a` and `b` as one type, given that they already agree once rows are
/// stripped: an open variable on either side gives way to the other, and
/// every function row must name the same labels on both sides. None when
/// one does not.
fn retry_merge(a: Type, b: Type) -> Option[Type] {
  match b {
    CtVar(_) => Some(a),
    _ => match a {
      CtVar(_) => Some(b),
      CtFn(aps, ar, arow) => match b {
        CtFn(bps, br, brow) => if retry_same_row(arow, brow) {
          match retry_merge_all(aps, bps) {
            Some(ps) => match retry_merge(ar, br) {
              Some(r) => Some(CtFn(ps, r, arow)),
              None => None
            },
            None => None
          }
        } else {
          None
        },
        _ => Some(a)
      },
      CtArray(ae) => match b {
        CtArray(be) => match retry_merge(ae, be) {
          Some(e) => Some(CtArray(e)),
          None => None
        },
        _ => Some(a)
      },
      CtOption(ae) => match b {
        CtOption(be) => match retry_merge(ae, be) {
          Some(e) => Some(CtOption(e)),
          None => None
        },
        _ => Some(a)
      },
      CtTuple(aes) => match b {
        CtTuple(bes) => match retry_merge_all(aes, bes) {
          Some(es) => Some(CtTuple(es)),
          None => None
        },
        _ => Some(a)
      },
      CtNamed(an, aargs) => match b {
        CtNamed(bn, bargs) => if an != bn {
          Some(a)
        } else {
          match retry_merge_all(aargs, bargs) {
            Some(args) => Some(CtNamed(an, args)),
            None => None
          }
        },
        _ => Some(a)
      },
      CtRecord(afs) => match b {
        CtRecord(bfs) => match retry_record_pairs(afs, bfs) {
          Some((ats, bts)) => match retry_merge_all(ats, bts) {
            Some(ts) => {
              let fields: Array[(String, Type)] = array_empty()
              let mut i = 0
              while i < Array::length(afs) {
                let (n, _) = Array::get(afs, i)
                Array::push(fields, (n, Array::get(ts, i)))
                i = i + 1
              }
              Some(CtRecord(fields))
            },
            None => None
          },
          None => Some(a)
        },
        _ => Some(a)
      },
      _ => Some(a)
    }
  }
}

fn retry_merge_all(as_: Array[Type], bs: Array[Type]) -> Option[Array[Type]] {
  if Array::length(as_) == Array::length(bs) {
    let out = array_empty()
    let mut ok = true
    let mut i = 0
    while i < Array::length(as_) && ok {
      match retry_merge(Array::get(as_, i), Array::get(bs, i)) {
        Some(t) => Array::push(out, t),
        None => ok = false
      }
      i = i + 1
    }
    if ok {
      Some(out)
    } else {
      None
    }
  } else {
    None
  }
}

/// Do two rows name the same labels, effect variables included, in any
/// order? No exemption applies: this asks whether they are one row, not
/// whether one may stand for the other.
fn retry_same_row(a: Option[String], b: Option[String]) -> Bool {
  let al = row_labels(a)
  let bl = row_labels(b)
  retry_labels_within(al, bl) && retry_labels_within(bl, al)
}

fn retry_labels_within(xs: Array[String], ys: Array[String]) -> Bool {
  let mut ok = true
  let mut i = 0
  while i < Array::length(xs) && ok {
    let x = Array::get(xs, i)
    let mut seen = false
    let mut k = 0
    while k < Array::length(ys) && !seen {
      seen = Array::get(ys, k) == x
      k = k + 1
    }
    ok = seen
    i = i + 1
  }
  ok
}

/// Does `t` hold a function type anywhere? Only there can stripping a
/// binding lose a row.
fn retry_type_has_fn(t: Type) -> Bool {
  match t {
    CtFn(_, _, _) => true,
    CtArray(e) => retry_type_has_fn(e),
    CtOption(e) => retry_type_has_fn(e),
    CtTuple(es) => retry_any_has_fn(es),
    CtNamed(_, args) => retry_any_has_fn(args),
    CtApplied(head, args) => retry_type_has_fn(head) || retry_any_has_fn(args),
    CtRecord(fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) && !found {
        let (_, ft) = Array::get(fields, i)
        found = retry_type_has_fn(ft)
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn retry_any_has_fn(ts: Array[Type]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(ts) && !found {
    found = retry_type_has_fn(Array::get(ts, i))
    i = i + 1
  }
  found
}

fn retry_collect_vars(t: Type, out: Array[Int]) -> Unit {
  match t {
    CtVar(id) => Array::push(out, id),
    CtFn(ps, r, _) => {
      let mut i = 0
      while i < Array::length(ps) {
        retry_collect_vars(Array::get(ps, i), out)
        i = i + 1
      }
      retry_collect_vars(r, out)
    },
    CtArray(e) => retry_collect_vars(e, out),
    CtOption(e) => retry_collect_vars(e, out),
    CtTuple(es) => {
      let mut i = 0
      while i < Array::length(es) {
        retry_collect_vars(Array::get(es, i), out)
        i = i + 1
      }
    },
    CtNamed(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        retry_collect_vars(Array::get(args, i), out)
        i = i + 1
      }
    },
    CtApplied(head, args) => {
      retry_collect_vars(head, out)
      let mut i = 0
      while i < Array::length(args) {
        retry_collect_vars(Array::get(args, i), out)
        i = i + 1
      }
    },
    CtRecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, ft) = Array::get(fields, i)
        retry_collect_vars(ft, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Record `(id, other side)` wherever a variable the retry bound meets a
/// type: a variable of `expected` against the actual, and one of `actual`
/// against the expected. A higher-kinded application (`F[T]`, spelled with
/// the `hkt_app_name()` head or as `CtApplied`) is walked against the
/// constructor it unified with, the way `unify_hkt_ctors` and
/// `unify_type_applications` decompose it.
fn retry_collect_occurrences(expected: Type, actual: Type, s: Subst, su: Subst, occ: Array[(Int, Type)]) -> Unit {
  let e = subst_apply(s, expected)
  let a = subst_apply(s, actual)
  let e_var = match e {
    CtVar(id) => match subst_lookup(su, id) {
      Some(_) => id,
      None => 0 - 1
    },
    _ => 0 - 1
  }
  let a_var = match a {
    CtVar(id) => match subst_lookup(su, id) {
      Some(_) => id,
      None => 0 - 1
    },
    _ => 0 - 1
  }
  if e_var >= 0 {
    Array::push(occ, (e_var, a))
  } else if a_var >= 0 {
    Array::push(occ, (a_var, e))
  } else if is_hkt_app(e) && !is_hkt_app(a) {
    retry_collect_hkt(e, a, true, s, su, occ)
  } else if is_hkt_app(a) && !is_hkt_app(e) {
    retry_collect_hkt(a, e, false, s, su, occ)
  } else if retry_is_applied(e) || retry_is_applied(a) {
    // `F[T]` instantiated as `CtApplied`, met against `Option[..]` or another
    // application: `unify` pairs them through `type_application_view`.
    match type_application_view(e) {
      Some((eh, eargs)) => match type_application_view(a) {
        Some((ah, aargs)) => {
          retry_collect_occurrences(eh, ah, s, su, occ)
          retry_collect_all(eargs, aargs, s, su, occ)
        },
        None => ()
      },
      None => ()
    }
  } else {
    match e {
      CtFn(eps, er, _) => match a {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          retry_collect_all(eps, aps, s, su, occ)
          retry_collect_occurrences(er, ar, s, su, occ)
        } else {
          ()
        },
        _ => ()
      },
      CtArray(ee) => match a {
        CtArray(ae) => retry_collect_occurrences(ee, ae, s, su, occ),
        _ => ()
      },
      CtOption(ee) => match a {
        CtOption(ae) => retry_collect_occurrences(ee, ae, s, su, occ),
        _ => ()
      },
      CtTuple(ees) => match a {
        CtTuple(aes) => retry_collect_all(ees, aes, s, su, occ),
        _ => ()
      },
      CtNamed(en, eas) => match a {
        CtNamed(an, aas) => if en == an {
          retry_collect_all(eas, aas, s, su, occ)
        } else {
          ()
        },
        _ => ()
      },
      CtRecord(efs) => match a {
        CtRecord(afs) => match retry_record_pairs(efs, afs) {
          Some((ets, ats)) => retry_collect_all(ets, ats, s, su, occ),
          None => ()
        },
        _ => ()
      },
      _ => ()
    }
  }
}

/// The field types of two records with the same field names, in `a`'s
/// order, or None when the names differ.
fn retry_record_pairs(a: Array[(String, Type)], b: Array[(String, Type)]) -> Option[(Array[Type], Array[Type])] {
  if Array::length(a) != Array::length(b) {
    None
  } else {
    let ats: Array[Type] = array_empty()
    let bts: Array[Type] = array_empty()
    let mut ok = true
    let mut i = 0
    while i < Array::length(a) && ok {
      let (n, t) = Array::get(a, i)
      let mut found = false
      let mut k = 0
      while k < Array::length(b) && !found {
        let (bn, bt) = Array::get(b, k)
        if bn == n {
          Array::push(ats, t)
          Array::push(bts, bt)
          found = true
        } else {
          ()
        }
        k = k + 1
      }
      ok = found
      i = i + 1
    }
    if ok {
      Some((ats, bts))
    } else {
      None
    }
  }
}

fn retry_is_applied(t: Type) -> Bool {
  match t {
    CtApplied(_, _) => true,
    _ => false
  }
}

/// `app` is `F[args..]` (head first); `other` is the constructor it met. The
/// head is not walked: it binds a constructor, which holds no row.
fn retry_collect_hkt(app: Type, other: Type, app_is_expected: Bool, s: Subst, su: Subst, occ: Array[(Int, Type)]) -> Unit {
  match app {
    CtNamed(_, aa) => {
      let rest = array_empty()
      let mut i = 1
      while i < Array::length(aa) {
        Array::push(rest, Array::get(aa, i))
        i = i + 1
      }
      let others = match other {
        CtArray(x) => [x],
        CtOption(x) => [x],
        CtNamed(_, xs) => xs,
        _ => array_empty()
      }
      if app_is_expected {
        retry_collect_all(rest, others, s, su, occ)
      } else {
        retry_collect_all(others, rest, s, su, occ)
      }
    },
    _ => ()
  }
}

fn retry_collect_all(es: Array[Type], as_: Array[Type], s: Subst, su: Subst, occ: Array[(Int, Type)]) -> Unit {
  if Array::length(es) == Array::length(as_) {
    let mut i = 0
    while i < Array::length(es) {
      retry_collect_occurrences(Array::get(es, i), Array::get(as_, i), s, su, occ)
      i = i + 1
    }
  } else {
    ()
  }
}

export fn type_is_ground(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground(e),
    CtOption(e) => type_is_ground(e),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but
/// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type
/// whose only flexibility is unification variables: if such a type fails to unify
/// against a fully GROUND expected type, no instantiation of its variables can
/// make it match, so the mismatch is real (unlike an un-instantiated generic
/// param `CtNamed(T)`, which the checker simply has not substituted yet).
fn type_no_named(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_no_named(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_no_named(e),
    CtOption(e) => type_no_named(e),
    CtFn(ps, r, _) => {
      let mut ok = type_no_named(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_no_named(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is
/// not concrete (a type variable / unresolved named param / unknown / forall).
/// Two types with DIFFERENT non-zero heads can never be made equal by any
/// instantiation of their inner type parameters (an `Int` is never an `Array[T]`
/// for any `T`), so such a unify failure is a real mismatch even when the inner
/// parts are generic — which the whole-type groundness gate misses.
export fn head_kind(t: Type) -> Int {
  match t {
    CtInt => 1,
    CtDouble => 2,
    CtBool => 3,
    CtString => 4,
    CtChar => 5,
    CtUnit => 6,
    CtBytes => 7,
    CtTuple(_) => 8,
    CtArray(_) => 9,
    CtOption(_) => 10,
    CtStruct(_) => 11,
    CtEnum(_) => 12,
    CtFn(_, _, _) => 13,
    // #1839 (Codex review on #1867): a concrete head, NOT the `_ => 0`
    // "unresolved; tolerate" bucket — otherwise representation-specific
    // builtin receiver checks (`Array::get(record { a: 1 }, 0)` etc.) pass
    // and codegen reads the record layout as the wrong representation.
    CtRecord(_) => 14,
    CtNamed(name, nargs) => if name == "MutList" {
      15
    } else if name == "Attempt" {
      // #1961 / ADR-0088: `perform?` yields `Attempt[T, E]`, a compiler-owned
      // named type. Kind 0 would let `fn main() -> String { perform? ... }`
      // unify-fail and then be swallowed — `type_no_named` is false and
      // `nominal_name_of` treats a still-open `T` as non-concrete.
      16
    } else if name == "Map" {
      // Map's runtime representation is compiler-owned just like MutList's.
      // Keeping it in the unresolved CtNamed bucket lets direct builtins such
      // as `Map::iter_get(1, 0)` reinterpret an arbitrary scalar as a map.
      17
    } else if name == "FrozenArray" {
      // #2454: `FrozenArray[T]` is a checker-only phantom over `Array[T]`'s
      // runtime layout (#906), and while it sat in the tolerated `0` bucket the
      // distinction it exists for was not held apart AT ALL. All three of these
      // checked clean:
      //
      //   fn f(x: Array[Int]) -> Int { FrozenArray::length(x) }
      //   fn g(x: Array[Int]) -> Int { FrozenArray::get(x, 0) }
      //   fn h(x: FrozenArray[Int]) -> Int { Array::get(x, 0) }
      //
      // A certain head is all three need. The `FrozenArray::*` rows carry real
      // parameter types since #2451, so `builtin_param_head` reads
      // `FrozenArray[T]` for their receiver and the existing head check rejects
      // an `Array` there; the `Array::*` rows expect head 9, which now rejects a
      // `FrozenArray`. Nothing goes wrong at RUN time either way -- the copy
      // contract is codegen's (fixtures/frozen_array_copies_test.vibe) -- so
      // this is a missing diagnostic being added, not a wrong answer being
      // fixed.
      //
      // This is the MutList / Attempt / Map treatment, not ByteStream's: that
      // one stayed out of head_kind and got its own predicate because only the
      // Array sites needed it. Here both directions need a head, so the head is
      // where it belongs.
      18
    } else if name == "MutMap" && Array::length(nargs) > 0 {
      // #2640: `@vibe/core`'s collections are declared BODYLESS in its
      // contract (`type MutMap[K, V]`, `type MutSet[T]`), so a consumer sees
      // them as `CtNamed` and they landed in the tolerated `0` bucket --
      // indistinguishable from a rigid type parameter. Measured, that let
      // `vibe check` accept an `Array[String]` passed where a `MutSet[String]`
      // is declared, in BOTH directions, with no diagnostic; the program then
      // read an array's header as a hash table and trapped in `find_index`.
      // `Int` in the same position was rejected (it is a builtin scalar, so
      // `named_vs_scalar` fires), and so were `StringSet`, an imported
      // concrete struct and an array element mismatch -- the hole was exactly
      // a PARAMETERIZED bodyless contract head.
      //
      // Same treatment as MutList / Attempt / Map / FrozenArray above, for the
      // same reason: their runtime representation is compiler-owned, so a
      // certain head is what the check needs.
      //
      // APPLIED ONLY, and that is the load-bearing half (Codex review on
      // #2644's successor). A type formal may be NAMED `MutSet`: shadowing is
      // legal, these names are not reserved, and
      // `resolve_type_expr_core_shadowed` gives a bare shadowed formal
      // `CtNamed(name, [])` -- the same representation. Classifying by the
      // string alone would make `struct Cell[MutSet] { value: MutSet }`
      // behave differently from the identical declaration spelled `T`, whose
      // tolerance is what the `0` bucket exists for. An APPLIED occurrence is
      // not that case: the contract declares both heads WITH parameters
      // (`type MutMap[K, V]`, `type MutSet[T]`), and a shadowed formal with
      // arity resolves to `CtApplied`, not here. So the arity is the property
      // and the name is not asked to carry it alone.
      //
      // The four entries above are unguarded and carry the same latent
      // exposure; narrowing them is a separate change with its own
      // measurement, not a drive-by.
      19
    } else if name == "MutSet" && Array::length(nargs) > 0 {
      // Its own kind, not MutMap's: sharing one would make `MutMap[K, V]` and
      // `MutSet[T]` equal to `head_differ`, and then only `nominal_head_conflict`
      // stands between them. Two heads, two kinds.
      20
    } else {
      0
    },
    _ => 0
  }
}

fn is_stdin_stream_internal(t: Type) -> Bool {
  match t {
    CtStruct(n) => n == "#vibe_stdin_stream",
    _ => false
  }
}

/// #1539: the opaque stdin provider token is compiler-owned. Unlike ordinary
/// nullary CtNamed values, no unresolved/generic tolerance may let a different
/// concrete representation cross this boundary. Recurse through matching
/// containers/function signatures so aliases cannot launder the token either.
fn stdin_stream_nominal_conflict(expected: Type, actual: Type) -> Bool {
  let e_token = is_stdin_stream_internal(expected)
  let a_token = is_stdin_stream_internal(actual)
  if e_token || a_token {
    e_token != a_token
  } else {
    match expected {
      CtArray(e) => match actual {
        CtArray(a) => stdin_stream_nominal_conflict(e, a),
        _ => false
      },
      CtOption(e) => match actual {
        CtOption(a) => stdin_stream_nominal_conflict(e, a),
        _ => false
      },
      CtNamed(_, es) => match actual {
        CtNamed(_, actuals) => if Array::length(es) == Array::length(actuals) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(es) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(es, i), Array::get(actuals, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtTuple(es) => match actual {
        CtTuple(actuals) => if Array::length(es) == Array::length(actuals) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(es) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(es, i), Array::get(actuals, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtFn(eps, er, _) => match actual {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          let mut i = 0
          let mut conflict = stdin_stream_nominal_conflict(er, ar)
          while i < Array::length(eps) && !conflict {
            conflict = stdin_stream_nominal_conflict(Array::get(eps, i), Array::get(aps, i))
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      _ => false
    }
  }
}

/// #939 helpers: detect a function VALUE laundering a concrete effect row away
/// through a pure-typed slot (HOF argument, let/struct-field/array annotation).
/// The strip_effects fallback below deliberately tolerates effect-only
/// differences — but for CONCRETE, non-exempt labels flowing in a COVARIANT
/// position that tolerance is the #939 soundness hole: the value's perform
/// executes with no handler and the program dies with an unhandled wasm
/// exception at runtime. Exemptions mirror checker_effects' transitive pass:
/// `Error` (pervasive un-annotated throw sites, #640), `Async`
/// (composition-allowed), and effect VARIABLES (single lowercase letter /
/// `$N` fresh vars — not decidable without call-site row unification, #885).
fn effect_label_is_exempt(lbl: String) -> Bool {
  let len = String::length(lbl)
  // #3539: the ERASED exception label is no longer exempt. The #640
  // exemption assumed an un-annotated, pervasive throw row, but a row on a
  // function TYPE is always written: `fn thrower() -> Int with Exception`
  // passed where `() -> Int` is expected let `call(thrower)` type a caller
  // pure while the throw ran with no handler. `with Exception[K]` was already
  // refused there (ADR-0085); the erased spelling now is too. Erased and
  // kinded labels still match each other (`row_contains_label`), so a
  // `with Exception` slot accepts a `with Exception[K]` value.
  if String::starts_with(lbl, "#region_") || String::starts_with(lbl, "#capture[") || String::starts_with(lbl, "#param[") || String::starts_with(lbl, "#aliasparam[") || String::starts_with(lbl, "#fieldparam[") || is_effect_inst_label(lbl) {
    true
    // #1963: `is_runtime_scheduled_effect`, not `lbl == "Async"`. Row labels
    // can arrive operation-qualified (`Async::Suspend`), and the literal
    // comparison denied the exemption to exactly those -- firing the #939
    // check on a label the policy calls composition-allowed.
  } else if is_runtime_scheduled_effect(lbl) {
    true
  } else if len == 1 {
    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122
  } else if len >= 2 {
    String::char_code_at(lbl, 0) == 36
  } else {
    true
  }
}

export fn row_labels(row: Option[String]) -> Array[String] {
  match row {
    Some(r) => {
      let parts = String::split(r, ",")
      let out = array_empty()
      let mut i = 0
      while i < Array::length(parts) {
        let t = String::trim(Array::get(parts, i))
        if String::length(t) > 0 {
          Array::push(out, t)
        } else {
          ()
        }
        i = i + 1
      }
      out
    },
    None => array_empty()
  }
}

/// #1340 (ADR-0071): base effect name of a row label — `State[Int]` strips
/// to `State`, a bracketless label is its own base. (Local copy: the
/// same-named helpers in checker_effects.vibe / core stay file-private.)
fn ck_row_label_base(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi > 0 {
    label[0: bi]
  } else {
    label
  }
}

/// Does `row` name exception KINDS only -- at least one kinded exception
/// label, no erased one, and no effect variable that could stand for the
/// erased exception?
fn row_is_kinded_exception_only(row: Option[String]) -> Bool {
  let labels = row_labels(row)
  let mut kinded = false
  let mut open_row = false
  let mut i = 0
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if is_exception_label(l) {
      if String::length(exception_label_kind(l)) > 0 {
        kinded = true
      } else {
        open_row = true
      }
    } else if (String::length(l) == 1 && String::char_code_at(l, 0) >= 97 && String::char_code_at(l, 0) <= 122) || (String::length(l) >= 2 && String::char_code_at(l, 0) == 36) {
      open_row = true
    }
    i = i + 1
  }
  kinded && !open_row
}

fn row_contains_label(row: Option[String], lbl: String) -> Bool {
  let labels = row_labels(row)
  let mut i = 0
  let mut found = false
  // #1340 (ADR-0071): compare by base name so a generic instantiation label
  // (`State[Int]`) and the bare effect (`State`) count as the same label in
  // the dropped-row walk — bracketless labels degenerate to exact equality.
  // ADR-0085 (#1344): the exception effect opts out of that base-name
  // equivalence and compares by KIND instead, so assigning a
  // `with Exception[IoError]` value into a `with Exception[ParseError]`
  // slot is a dropped row, not a match. Erased labels (`Error`, `Exception`)
  // stay compatible with every kind in both directions, which is what keeps
  // every pre-#1344 row behaving exactly as before.
  let wanted = ck_row_label_base(lbl)
  let exc_wanted = is_exception_label(lbl)
  while i < Array::length(labels) && !found {
    let have = Array::get(labels, i)
    let hit = if exc_wanted || is_exception_label(have) {
      exception_effect_labels_equal(have, lbl)
    } else {
      ck_row_label_base(have) == wanted
    }
    if hit {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// First concrete, non-exempt effect label whose drop would let a perform run
/// with no handler. At each CtFn the ACTUAL side's own row must not carry a
/// label the EXPECTED side's row lacks; the return type recurses covariantly;
/// PARAMETER positions recurse with expected/actual SWAPPED (contravariance —
/// Codex P1 on #978: an `((Int) -> Int with Logger, Int) -> Int` slot
/// holding a pure-callback fn lets `h(eff, 1)` type-check while the callee
/// invokes the effectful callback with no handler, so at parameter positions
/// it is the EXPECTED param's concrete labels that must be tolerated by the
/// ACTUAL param). pure→effectful still passes in both directions by
/// construction, and an effectful parameter slot accepting a pure function
/// stays legal (the swap makes that the label-free side).
fn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {
  match expected {
    CtFn(eparams, eret, eeff) => match actual {
      CtFn(aparams, aret, aeff) => {
        let alabels = row_labels(aeff)
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(alabels) && !done {
          let lbl = Array::get(alabels, i)
          // An ERASED exception label narrowed into a row that names only
          // kinds (the mirror of #3015): the value may raise any kind, the
          // slot promises only its own, and a kinded handler trusting the
          // slot reads a foreign payload at the wrong type. The #640
          // exemption covers erased labels dropped into rows that say
          // nothing about kinds; it does not cover this.
          let narrowed = is_exception_label(lbl) && String::length(exception_label_kind(lbl)) == 0 && row_is_kinded_exception_only(eeff)
          if narrowed || (!effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl)) {
            dropped = Some(lbl)
            done = true
          } else {
            ()
          }
          i = i + 1
        }
        if !done && Array::length(eparams) == Array::length(aparams) {
          let mut pi = 0
          while pi < Array::length(eparams) && !done {
            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {
              Some(pl) => {
                dropped = Some(pl)
                done = true
              },
              None => ()
            }
            pi = pi + 1
          }
        } else {
          ()
        }
        match dropped {
          Some(l) => Some(l),
          None => effect_row_dropped(eret, aret)
        }
      },
      _ => None
    },
    CtArray(ee) => match actual {
      CtArray(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtOption(ee) => match actual {
      CtOption(ae) => effect_row_dropped(ee, ae),
      _ => None
    },
    CtTuple(ees) => match actual {
      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(ees) && !done {
          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    CtNamed(en, eargs) => match actual {
      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {
        let mut i = 0
        let mut dropped = None
        let mut done = false
        while i < Array::length(eargs) && !done {
          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {
            Some(d) => {
              dropped = Some(d)
              done = true
            },
            None => ()
          }
          i = i + 1
        }
        dropped
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch
/// (the checker historically swallowed these, accepting ill-typed programs).
/// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with
/// effects erased, and tolerate the difference if the structure matches — effect
/// inference on function values is imprecise, so effect-only differences must not
/// be reported here (EXCEPT a concrete covariant row drop — see
/// `effect_row_dropped` above, #939). Returns the (possibly extended)
/// substitution.
fn is_hkt_skolem(ty: Type) -> Bool {
  match ty {
    CtNamed(n, args) => String::starts_with(n, "#hktformal.") && Array::length(args) == 0,
    _ => false
  }
}

fn hkt_skolem_differ(a: Type, b: Type) -> Bool {
  if is_hkt_skolem(a) && is_hkt_skolem(b) {
    match a {
      CtNamed(an, _) => match b {
        CtNamed(bn, _) => an != bn,
        _ => false
      },
      _ => false
    }
  } else {
    false
  }
}

fn is_unresolved_head(ty: Type) -> Bool {
  match ty {
    CtVar(_) => true,
    CtUnknown => true,
    _ => false
  }
}

fn skolem_vs_concrete(a: Type, b: Type) -> Bool {
  // Only `#hktformal.*` is a rigid constructor/index. A nullary `CtNamed`
  // is also an unresolved alias (`MyAlias`) and a region token (`r`);
  // treating those as skolems rejects `fn a() -> Int { rows }` when
  // `rows: MyAlias` is declared later.
  if is_hkt_skolem(a) && !is_hkt_skolem(b) && !is_unresolved_head(b) {
    true
  } else if is_hkt_skolem(b) && !is_hkt_skolem(a) && !is_unresolved_head(a) {
    true
  } else {
    hkt_skolem_differ(a, b)
  }
}

fn named_args_skolem_differ(ea: Array[Type], aa: Array[Type]) -> Bool {
  if Array::length(ea) != Array::length(aa) {
    true
  } else {
    let mut i = 0
    let mut differ = false
    while i < Array::length(ea) {
      let e = Array::get(ea, i)
      let a = Array::get(aa, i)
      if rigid_applied_mismatch(e, a) {
        differ = true
      } else {
        ()
      }
      i = i + 1
    }
    differ
  }
}

/// Report `#hkt` vs `#hkt` with rigid args, and `#hkt` vs a resolved
/// constructor. Recurses into tuple / fn / Array / Option / same-name
/// `CtNamed` `#hkt` args so nested identity-as-map is not tolerated.
/// Call-site `F` is a unification var so this does not run there.
fn rigid_applied_mismatch(expected: Type, actual: Type) -> Bool {
  if skolem_vs_concrete(expected, actual) {
    true
  } else if is_hkt_app(expected) && is_hkt_app(actual) {
    match expected {
      CtNamed(en, ea) => match actual {
        CtNamed(an, aa) => en == an && named_args_skolem_differ(ea, aa),
        _ => false
      },
      _ => false
    }
  } else if is_hkt_app(expected) && !is_unresolved_head(actual) {
    true
  } else if is_hkt_app(actual) && !is_unresolved_head(expected) {
    true
  } else {
    match expected {
      CtArray(e) => match actual {
        CtArray(a) => rigid_applied_mismatch(e, a),
        _ => false
      },
      CtOption(e) => match actual {
        CtOption(a) => rigid_applied_mismatch(e, a),
        _ => false
      },
      CtTuple(ees) => match actual {
        CtTuple(aes) => if Array::length(ees) != Array::length(aes) {
          false
        } else {
          let mut i = 0
          let mut differ = false
          while i < Array::length(ees) {
            if rigid_applied_mismatch(Array::get(ees, i), Array::get(aes, i)) {
              differ = true
            } else {
              ()
            }
            i = i + 1
          }
          differ
        },
        _ => false
      },
      CtFn(eps, eret, _) => match actual {
        CtFn(aps, aret, _) => if Array::length(eps) != Array::length(aps) {
          false
        } else {
          let mut i = 0
          let mut differ = rigid_applied_mismatch(eret, aret)
          while i < Array::length(eps) {
            if rigid_applied_mismatch(Array::get(eps, i), Array::get(aps, i)) {
              differ = true
            } else {
              ()
            }
            i = i + 1
          }
          differ
        },
        _ => false
      },
      CtNamed(en, ea) => match actual {
        CtNamed(an, aa) => if en != an {
          false
        } else if Array::length(ea) != Array::length(aa) {
          false
        } else {
          // Only walk `#hkt` arguments. Walking every arg would compare
          // region tokens (`r` vs `#region_1`) inside MutList.
          let mut i = 0
          let mut differ = false
          while i < Array::length(ea) {
            let e = Array::get(ea, i)
            let a = Array::get(aa, i)
            if (is_hkt_app(e) || is_hkt_app(a)) && rigid_applied_mismatch(e, a) {
              differ = true
            } else {
              ()
            }
            i = i + 1
          }
          differ
        },
        _ => false
      },
      _ => false
    }
  }
}

fn reader_ident_byte(b: Int) -> Bool {
  (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

/// A type's spelling for a message. An effect variable a call instantiated
/// (`$4`) reads as the source spelled it (`e`), as it did before #3557 made a
/// signature's row variable fresh per call; a `$` inside a name (`T$1`, a
/// scoped formal) is left alone. With `blank_vars`, an unresolved inference
/// variable (`?t429`) reads `_` (#3520).
fn type_spelled_for_message(t: Type, blank_vars: Bool) -> String {
  let raw = type_to_string(t)
  let n = String::length(raw)
  let out = StringBuilder::new()
  let mut i = 0
  while i < n {
    let var_start = blank_vars && i + 2 < n && String::byte_at(raw, i) == '?' && String::byte_at(raw, i + 1) == 't' && String::byte_at(raw, i + 2) >= '0' && String::byte_at(raw, i + 2) <= '9'
    let eff_var_start = i + 1 < n && String::byte_at(raw, i) == '$' && String::byte_at(raw, i + 1) >= '0' && String::byte_at(raw, i + 1) <= '9' && (i == 0 || !reader_ident_byte(String::byte_at(raw, i - 1)))
    if eff_var_start {
      let mut j = i + 1
      while j < n && String::byte_at(raw, j) >= '0' && String::byte_at(raw, j) <= '9' {
        j = j + 1
      }
      StringBuilder::push(out, effect_var_spelling(String::substring(raw, i, j)))
      i = j
    } else if var_start {
      StringBuilder::push(out, "_")
      i = i + 2
      while i < n && String::byte_at(raw, i) >= '0' && String::byte_at(raw, i) <= '9' {
        i = i + 1
      }
    } else {
      StringBuilder::push(out, String::substring(raw, i, i + 1))
      i = i + 1
    }
  }
  StringBuilder::freeze(out)
}

/// #3520: a type as a message shows it -- an unresolved inference variable is
/// `_`, not the internal `?t429` the reader cannot act on, and an instantiated
/// effect variable is the source's spelling. Display only: `type_to_string`
/// stays the spelling keys are built from.
export fn type_for_reader(t: Type) -> String {
  type_spelled_for_message(t, true)
}

/// The `expected X, got Y` spelling: effect variables as the source wrote
/// them, inference variables unchanged.
fn type_for_mismatch(t: Type) -> String {
  type_spelled_for_message(t, false)
}

export fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {
  check_assignable_for(expected, actual, s, errors, what, "", off)
}

/// #2386: `check_assignable` with the report's subject split in two so the
/// message is built only when a mismatch is reported. Every call site with a
/// per-call subject (`"argument type mismatch for " ++ label`) used to build
/// the string first: ~25 ms of `__rt_str_concat` under `unify_call_args` in a
/// cold self-compile, for calls that almost always agree.
export fn check_assignable_for(expected: Type, actual: Type, s: Subst, errors: Array[String], what_head: String, what_tail: String, off: Int) -> Subst {
  let result = match unify(expected, actual, s) {
    Some(su) => su,
    None => {
      // #3518: the effect-stripped retry's substitution is the answer when it
      // succeeds. Discarding it left every type variable that only this
      // retry could bind -- `T` in `f: () -> T with Exception + e` given a
      // closure whose row differs -- unbound: a `T: Send` bound was then
      // skipped as an open variable (a closure crossed `TaskGroup::spawn`),
      // and `let n: Int = give(() -> "hello")` checked clean and printed a
      // pointer.
      let structural_s = unify(strip_effects(expected), strip_effects(actual), s)
      let structural = match structural_s {
        Some(_) => true,
        None => false
      }
      // Only report when BOTH sides are fully ground (mention no type parameter
      // / type variable). The checker does not instantiate a generic
      // struct field's or function parameter's type params — they surface as
      // rigid `CtNamed(T, _)` — so a unify failure against a concrete
      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->
      // Option[(T, Int)]` field vs a concrete closure). Reporting only on
      // ground/ground keeps the genuine concrete-type mismatches (Int vs
      // String, struct field of the wrong concrete type) while not
      // over-rejecting polymorphic code.
      // Report when the EXPECTED type is fully ground and the ACTUAL type
      // mentions no rigid type parameter (inference variables are fine). A
      // unify failure under those conditions is genuine: no instantiation of
      // the actual's variables can satisfy the concrete expected type (this is
      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground
      // expected, or an actual carrying an un-instantiated generic `CtNamed`,
      // is still tolerated to avoid over-rejecting polymorphic code.
      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))
      // Also report when the two types have DIFFERENT concrete top-level
      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no
      // instantiation of inner type parameters can reconcile them, so it is a
      // real mismatch even though the expected type is non-ground. A
      // var/named/unknown head (kind 0) on either side stays tolerated.
      let eh = head_kind(subst_apply(s, expected))
      let ah = head_kind(subst_apply(s, actual))
      let head_differ = eh != 0 && ah != 0 && eh != ah
      // #1001: a `CtNamed` head is kind 0 in `head_kind` (may be a rigid type
      // parameter), so `Result[Int,String]` vs `Option[Int]` — or the same
      // pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn signature —
      // sails past `head_differ` untouched, and `detect_narrowed_generic_mismatch`
      // below only fires on a SAME-name pair, so a genuinely DIFFERENT nominal
      // head was never reported at all. Check that ahead of the existing
      // gates; internally gated on `type_fully_concrete` so a still-rigid
      // type parameter never triggers it.
      let expected_zonked = subst_apply(s, expected)
      let actual_zonked = subst_apply(s, actual)
      let stdin_stream_conflict = stdin_stream_nominal_conflict(expected_zonked, actual_zonked)
      let nominal_conflict = nominal_head_conflict(expected_zonked, actual_zonked)
      let rigid_applied_conflict = rigid_applied_mismatch(expected_zonked, actual_zonked)
      let argument_conflict = applied_argument_conflict(expected, actual_zonked, s)
      // A body that instantiated `T := Box[Int]` publishes that named type,
      // and `f(1)` is then Box vs Int. `type_is_ground` is false for every
      // `CtNamed` and `head_kind` of a named type is 0, so the existing
      // gates tolerate it. Restrict to fully-concrete named vs a builtin
      // scalar: Array vs FixedArray (zlib Huffman) is a different pair and
      // stays on the historical tolerate path.
      let named_vs_scalar = (type_fully_concrete(expected) && is_fully_concrete_named(expected_zonked) && is_builtin_scalar(actual_zonked)) || (is_builtin_scalar(expected_zonked) && is_fully_concrete_named(actual_zonked))
      if stdin_stream_conflict || nominal_conflict || rigid_applied_conflict || argument_conflict || (named_vs_scalar && !structural) {
        Array::push(errors, String::concat(String::concat(what_head, what_tail), String::concat(": expected ", String::concat(type_for_mismatch(expected_zonked), String::concat(", got ", String::concat(type_for_mismatch(actual_zonked), assignable_marker(off)))))))
        s
      } else if structural {
        // #939: the structural retry tolerated EVERY effect-only difference,
        // including a function value whose CONCRETE row silently vanishes
        // into a pure-typed slot (HOF argument, let / struct field / array
        // annotation) — the perform then runs with no handler and dies as an
        // unhandled wasm exception at runtime. Report exactly that shape;
        // pure→effectful subsumption and Error/Async/effect-var differences
        // stay tolerated (see effect_row_dropped).
        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {
          Some(lbl) => {
            Array::push(errors, String::concat(String::concat(what_head, what_tail), String::concat(": effect row mismatch: a value of type ", String::concat(type_for_reader(subst_apply(s, actual)), String::concat(" cannot be used where ", String::concat(type_for_reader(subst_apply(s, expected)), String::concat(" is expected (the { ", String::concat(lbl, String::concat(" } effect would be dropped — no handler could ever run)", assignable_marker(off))))))))))
            s
          },
          None => match structural_s {
            Some(su) => match retry_bind_unstripped(expected, actual, s, su) {
              Some(out) => out,
              None => {
                Array::push(errors, String::concat(String::concat(what_head, what_tail), String::concat(": annotate this value with the function type it should have: the function values in it carry effect rows that no single type covers (expected ", String::concat(type_for_mismatch(subst_apply(s, expected)), String::concat(", got ", String::concat(type_for_mismatch(subst_apply(s, actual)), String::concat(")", assignable_marker(off))))))))
                s
              }
            },
            None => s
          }
        }
      } else if !(reportable || head_differ) {
        // #981: a user generic type's ARGUMENTS were never compared here — a
        // `CtNamed` head is kind 0 (tolerated by `head_differ`) and makes
        // `type_no_named(actual)` false, so `get_int(b)` with
        // `b: Box[String]` against `Box[Int]` sailed through this branch
        // silently (compile clean, heap-pointer garbage at runtime), while
        // the symmetric builtin (`Array[String]` vs `Array[Int]`) and the
        // RETURN position were both rejected. Close exactly that hole with
        // the proven #844 predicate (`detect_narrowed_generic_mismatch`):
        // report ONLY a same-name, same-arity (> 0), fully-concrete `CtNamed`
        // pair whose arguments fail to unify — a rigid/uninstantiated type
        // parameter surfaces as `CtNamed(T, [])` / the `[CtUnknown]` sentinel
        // and stays tolerated, so polymorphic code is not over-rejected.
        // Additionally gate on the RAW expected type (BEFORE subst) being
        // fully concrete: an expected that only became concrete through this
        // call's own unification is not trustworthy — an IMPORTED generic
        // fn's signature can cross-talk its type params through the flat
        // import env (measured: `list_zip[A, B]` imported from
        // lib/@vibe/core/list.vibe reported `expected List[String], got
        // List[Int]` on its second argument — A's binding leaked into B's
        // slot), and reporting that shape would reject valid polymorphic
        // calls. A monomorphic signature (the #981 hole) is concrete without
        // any substitution, so the genuine cases all keep reporting.
        if type_fully_concrete(expected) {
          detect_narrowed_generic_mismatch_for(expected, actual, s, errors, what_head, what_tail, off)
        } else {
          s
        }
      } else {
        Array::push(errors, String::concat(String::concat(what_head, what_tail), String::concat(": expected ", String::concat(type_for_mismatch(subst_apply(s, expected)), String::concat(", got ", String::concat(type_for_mismatch(subst_apply(s, actual)), assignable_marker(off)))))))
        s
      }
    }
  }
  Array::truncate(assignable_span_end, 0)
  result
}

/// #3590: true when two applications of one head meet with an argument that
/// is concrete on both sides and differs -- `Pair[x, String]` against
/// `Pair[x, Int]`, and the same nested inside an `Array` / `Option` / tuple /
/// function / same-name application (`Option[Pair[x, Int]]`). A `CtNamed`
/// pair whose other positions still hold a formal or an inference variable
/// is not ground, so a failed unify there was tolerated as possibly
/// polymorphic, and a returned `Pair[x, Int]` read its `Int` field as a
/// `String`. No instantiation of the open positions reconciles two different
/// concrete arguments, so each position is judged on its own: an open one
/// (a formal, a variable, a zero-argument name such as a row or an
/// unresolved alias) is only searched for a nested application, never
/// reported. A constructor-kinded argument (`#hkt`, `CtConstructor`,
/// `CtApplied`) is left to `rigid_applied_mismatch`, and effect rows are
/// stripped first, since a row difference alone is the effect checks' to
/// judge.
///
/// #3588: a compiler-owned head with region and row slots
/// (`owned_head_payload_span`) pairs its payload positions across the elided
/// and complete spellings (`TaskHandle[Int]` against `TaskHandle[rg, e,
/// String]`), so either spelling on either side is compared.
///
/// `expected` is read as written, so an argument that only became concrete
/// through this check's own substitution is not trusted (see
/// `detect_narrowed_generic_mismatch_for`'s caller).
fn applied_argument_conflict(expected: Type, actual: Type, s: Subst) -> Bool {
  match expected {
    CtNamed(en, eargs) => match actual {
      CtNamed(an, aargs) => if en != an || String::starts_with(en, "#") {
        false
      } else match owned_head_payload_span(en, Array::length(eargs)) {
        Some((estart, count)) => match owned_head_payload_span(an, Array::length(aargs)) {
          Some((astart, acount)) => if count != acount {
            false
          } else {
            applied_argument_conflict_pairwise(Array::slice(eargs, estart, estart + count), Array::slice(aargs, astart, astart + count), s)
          },
          None => false
        },
        None => applied_argument_conflict_pairwise(eargs, aargs, s)
      },
      _ => false
    },
    CtArray(e) => match actual {
      CtArray(a) => applied_argument_conflict(e, a, s),
      _ => false
    },
    CtOption(e) => match actual {
      CtOption(a) => applied_argument_conflict(e, a, s),
      _ => false
    },
    CtTuple(es) => match actual {
      CtTuple(acts) => nested_argument_conflict_pairwise(es, acts, s),
      _ => false
    },
    CtFn(eps, er, _) => match actual {
      CtFn(aps, ar, _) => applied_argument_conflict(er, ar, s) || nested_argument_conflict_pairwise(eps, aps, s),
      _ => false
    },
    _ => false
  }
}

/// One application's arguments, position by position: a pair that is
/// concrete on both sides must unify; any other pair is searched for a
/// nested application that conflicts.
fn applied_argument_conflict_pairwise(es: Array[Type], acts: Array[Type], s: Subst) -> Bool {
  if Array::length(es) != Array::length(acts) {
    false
  } else {
    let mut i = 0
    let mut conflict = false
    while i < Array::length(es) && !conflict {
      let e = Array::get(es, i)
      let a = Array::get(acts, i)
      conflict = if argument_comparable(e) && argument_comparable(a) {
        unify(strip_effects(e), strip_effects(a), s) is None
      } else {
        applied_argument_conflict(e, a, s)
      }
      i = i + 1
    }
    conflict
  }
}

/// Tuple elements and function parameters are not arguments of an
/// application themselves; only applications nested in them are judged.
fn nested_argument_conflict_pairwise(es: Array[Type], acts: Array[Type], s: Subst) -> Bool {
  if Array::length(es) != Array::length(acts) {
    false
  } else {
    let mut i = 0
    let mut conflict = false
    while i < Array::length(es) && !conflict {
      conflict = applied_argument_conflict(Array::get(es, i), Array::get(acts, i), s)
      i = i + 1
    }
    conflict
  }
}

/// Whether an argument position can be judged on its own: fully concrete
/// (`type_fully_concrete`: no variable, formal, zero-argument name or
/// unknown anywhere) and free of constructor-kinded parts.
fn argument_comparable(t: Type) -> Bool {
  type_fully_concrete(t) && !mentions_constructor_kind(t)
}

fn mentions_constructor_kind(t: Type) -> Bool {
  match t {
    CtConstructor(_, _) => true,
    CtApplied(_, _) => true,
    CtNamed(n, args) => String::starts_with(n, "#") || types_mention_constructor_kind(args),
    CtArray(e) => mentions_constructor_kind(e),
    CtOption(e) => mentions_constructor_kind(e),
    CtTuple(items) => types_mention_constructor_kind(items),
    CtFn(ps, r, _) => mentions_constructor_kind(r) || types_mention_constructor_kind(ps),
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, ft) = field
        if mentions_constructor_kind(ft) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

fn types_mention_constructor_kind(ts: Array[Type]) -> Bool {
  let mut found = false
  for t in ts {
    if mentions_constructor_kind(t) {
      found = true
    } else {
      ()
    }
  }
  found
}

/// #1001: the type's outer constructor's nominal name, when it is one that can
/// NEVER be a placeholder for a still-unresolved rigid type parameter --
/// `CtOption` (the builtin `Option[T]`; `Option` written as an annotation
/// resolves to this, not `CtNamed("Option", _)`)
/// and `CtEnum`/`CtStruct` (a RESOLVED reference to a declared enum/struct,
/// always concrete) are unconditionally trustworthy. A bare `CtNamed(n, _)`
/// is ambiguous -- it is ALSO how an uninstantiated generic type parameter
/// surfaces (`CtNamed("T", [])`) -- so it only counts when
/// `type_fully_concrete` confirms this occurrence is not that sentinel shape.
/// `None` means "nothing nominal to compare" (a type variable, a builtin
/// scalar, a container whose own head isn't itself nominal, etc).
fn nominal_name_of(t: Type) -> Option[String] {
  match t {
    CtOption(_) => Some("Option"),
    CtEnum(n) => Some(n),
    CtStruct(n) => Some(n),
    CtNamed(n, _) => if n == "HostStream" || n == "HostResponse" || n == "Attempt" {
      // Compiler-owned and always concrete despite an open type argument
      // (`HostStream` is nullary; `Attempt[T, E]` may still hold a fresh
      // var for T when the inner capability has no declared signature).
      Some(n)
    } else if type_fully_concrete(t) {
      Some(n)
    } else {
      None
    },
    _ => None
  }
}

/// #3326: the program's type declarations, for telling a source type apart
/// from a compiler-owned head spelled the same way. A program may declare its
/// own `struct Task[T]` or `enum Task[T]` (the legacy builtin is retired),
/// Their applications resolve to `CtNamed(name, args)`, so
/// the name alone cannot say whose type it is. (The heads whose values stand
/// in for a builtin value -- `FixedArray`, `ArrayBuilder`, `MutBytes` -- and
/// the constructor-owned `Future` / `FrozenArray` heads may
/// not be declared at all: `builtin_spelling_decl_error`.) Each
/// checker entry stores the `defs` table it checks with; that table grows in
/// place as declarations (local and imported) are registered, so a lookup
/// sees the declarations known at the point of the check.
let assignable_type_defs: Array[Array[TypeDef]] = [[]]

export fn check_assignable_set_type_defs(defs: Array[TypeDef]) -> Unit {
  Array::set(assignable_type_defs, 0, defs)
}

fn source_declares_type(name: String) -> Bool {
  match find_typedef(Array::get(assignable_type_defs, 0), name) {
    Some(td) => match td {
      TDStruct(_, _, _, _) => true,
      TDEnum(_, _, _) => true,
      _ => false
    },
    None => false
  }
}

/// #3326: true for a source-declared generic struct or enum APPLIED to
/// arguments (`Cell[Int]`, `Wrap[String]`, and `Cell[T]` / `Cell[?t]` too).
/// Its HEAD is certain whatever the arguments are. A rigid formal surfaces
/// as `CtNamed(T, [])` (no arguments) or `CtNamed(T, [CtUnknown])` (excluded
/// below); a constructor formal applied to arguments resolves to `CtApplied`
/// or a `#hkt` application, not to this; and an alias is expanded by
/// resolution (`type L[T] = Array[T]` resolves `L[Int]` to `Array[Int]`).
/// So no instantiation of the arguments can turn it into a builtin value --
/// `fn get[T](c: Cell[T])` applied to `[7]` is as wrong as `Cell[Int]` is.
///
/// A compiler-owned head is excluded and keeps its own treatment: several of
/// them cross into a builtin on purpose (`FixedArray[T]` is a checker-only
/// phantom over `Array[T]`'s layout, #1140, and the compiler passes its own
/// `MutBytes[r]` where `Bytes` is declared), and the ones that must not mix
/// carry a `head_kind`. The exclusion is the COMPILER's: when a source
/// declaration owns the spelling (`struct Task[T]`, local or imported),
/// the type is an ordinary struct or enum and an array read as one is this
/// bug again. A spelling with a sanctioned crossing cannot be owned by a
/// source declaration (it is refused), so this never takes the crossing away
/// from the builtin's own values. `#`-prefixed internal encodings (`#hkt`
/// applications) are excluded too; `rigid_applied_mismatch` owns them.
fn is_applied_declared_nominal(t: Type) -> Bool {
  match t {
    CtNamed(n, args) => if Array::length(args) == 0 || String::starts_with(n, "#") || is_unknown_arg_sentinel(args) {
      false
    } else {
      match compiler_owned_type_arity(n) {
        Some(_) => source_declares_type(n),
        None => true
      }
    },
    _ => false
  }
}

/// #3368: a compiler-owned head (`Future[Int]`, `FixedArray[Int]`,
/// `MutBytes`) against a builtin value it is not represented as. The heads are
/// excluded from `is_applied_declared_nominal`, and a `CtNamed` head is kind 0
/// to `head_kind`, so `let x: Future[Int] = [1]` and a tuple where
/// `FixedArray` is declared checked clean. Only the representation-compatible
/// crossings the compiler relies on stay accepted
/// (`compiler_owned_crossing`); every other builtin value is refused like any
/// other declared type. A source declaration that owns the spelling is
/// `is_applied_declared_nominal`'s, and `Array` / `Option` resolve to their
/// structural nodes.
fn compiler_owned_head_conflict(owned: Type, other: Type) -> Bool {
  match owned {
    CtNamed(n, args) => if String::starts_with(n, "#") || is_unknown_arg_sentinel(args) || n == "Array" || n == "Option" {
      false
    } else {
      match compiler_owned_type_arity(n) {
        Some(_) => !source_declares_type(n) && has_builtin_value_head(other) && !compiler_owned_crossing(n, other),
        None => false
      }
    },
    _ => false
  }
}

/// The builtin values a compiler-owned head shares a representation with:
/// `FixedArray` / `FrozenArray` / `ArrayBuilder` are phantoms over an
/// `Array`'s layout (#1140), `MutBytes` is passed where `Bytes` is
/// declared, and a `ByteStream` reaches an unannotated parameter a `for`
/// loop typed `Array[_]` (#3148), which iterates it by byte
/// (tests/gates/early/async_for_loop_classification.sh), and a `String` is
/// coerced to `PromptText` where one is declared
/// (fixtures/prompttext_coercion_fn_call_test.vibe).
fn compiler_owned_crossing(head: String, other: Type) -> Bool {
  match other {
    CtArray(_) => head == "FixedArray" || head == "FrozenArray" || head == "ArrayBuilder" || head == "ByteStream",
    CtBytes => head == "MutBytes",
    CtString => head == "PromptText",
    _ => false
  }
}

fn is_unknown_arg_sentinel(args: Array[Type]) -> Bool {
  Array::length(args) == 1 && match Array::get(args, 0) {
    CtUnknown => true,
    _ => false
  }
}

/// #3326: true for a type whose head is a builtin VALUE shape -- an `Array`, a
/// tuple, a function, an anonymous record or a scalar. None of those is ever
/// a declared struct or enum, so against `is_applied_declared_nominal` no
/// instantiation can reconcile the two. `Option` is absent because
/// `nominal_name_of` already names it.
fn has_builtin_value_head(t: Type) -> Bool {
  match t {
    CtArray(_) => true,
    CtTuple(_) => true,
    CtFn(_, _, _) => true,
    CtRecord(_) => true,
    _ => is_builtin_scalar(t)
  }
}

/// #1001: true when `expected` and `actual` carry a corresponding pair of
/// nominal names that DIFFER, anywhere in their structure -- e.g.
/// `Result[Int,String]` (`CtNamed`) vs `Option[Int]` (the builtin `CtOption`),
/// or the same pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn
/// signature/a same-named `CtNamed`'s own type arguments (mirroring
/// `effect_row_dropped`'s traversal above). No instantiation of type
/// PARAMETERS can ever reconcile two DIFFERENT nominal names, so this is a
/// genuine mismatch regardless of arity or which concrete `Type` shape either
/// side happens to be represented as -- unlike `detect_narrowed_generic_mismatch`
/// below, which only catches a SAME-name `CtNamed`/`CtNamed` mismatch (e.g.
/// `Box[Int]` vs `Box[String]`, #981) and never even inspects a
/// `CtArray[Option[Int]]` vs `CtArray[Result[Int,String]]` pair's nested heads,
/// nor a builtin `CtOption` against a `CtNamed`/`CtEnum` nominal type, at all.
///
/// #3326: an applied declared type against a builtin value head
/// (`Cell[Int]` vs `Array[Int]`) is the same kind of conflict, checked by
/// `declared_vs_builtin` because neither side carries a nominal name. Without
/// it an array passed as a `Cell[Int]` compiles clean and `x.value` reads the
/// array's packed representation.
fn nominal_head_conflict(expected: Type, actual: Type) -> Bool {
  let direct_conflict = match nominal_name_of(expected) {
    Some(en) => match nominal_name_of(actual) {
      Some(an) => en != an,
      None => false
    },
    None => false
  }
  let declared_vs_builtin = (is_applied_declared_nominal(expected) && has_builtin_value_head(actual)) || (has_builtin_value_head(expected) && is_applied_declared_nominal(actual))
  let owned_vs_builtin = compiler_owned_head_conflict(expected, actual) || compiler_owned_head_conflict(actual, expected)
  if direct_conflict || declared_vs_builtin || owned_vs_builtin {
    true
  } else {
    match expected {
      CtNamed(_, eargs) => match actual {
        CtNamed(_, aargs) => if Array::length(eargs) == Array::length(aargs) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(eargs) && !conflict {
            if nominal_head_conflict(Array::get(eargs, i), Array::get(aargs, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtArray(ee) => match actual {
        CtArray(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtOption(ee) => match actual {
        CtOption(ae) => nominal_head_conflict(ee, ae),
        _ => false
      },
      CtTuple(ees) => match actual {
        CtTuple(aes) => if Array::length(ees) == Array::length(aes) {
          let mut i = 0
          let mut conflict = false
          while i < Array::length(ees) && !conflict {
            if nominal_head_conflict(Array::get(ees, i), Array::get(aes, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      CtFn(eps, er, _) => match actual {
        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {
          let mut i = 0
          let mut conflict = nominal_head_conflict(er, ar)
          while i < Array::length(eps) && !conflict {
            if nominal_head_conflict(Array::get(eps, i), Array::get(aps, i)) {
              conflict = true
            } else {
              ()
            }
            i = i + 1
          }
          conflict
        } else {
          false
        },
        _ => false
      },
      _ => false
    }
  }
}

/// #844: true when `t` mentions no unresolved/rigid type-parameter placeholder
/// and no unbound unification variable ANYWHERE in its structure -- i.e. it is
/// a genuinely CONCRETE type. Unlike the more conservative shared
/// `type_is_ground` (which treats EVERY `CtNamed` as non-ground, to stay safe
/// for the many call sites that must still tolerate a rigid/uninstantiated
/// type parameter such as a trait method's `CtNamed("T", _)` field type), this
/// recurses into `CtNamed`'s own type arguments. Used ONLY by
/// `detect_narrowed_generic_mismatch` below (a narrowly-scoped, additive check
/// for the `let`-annotation erasure hole -- see #844) so this refinement's
/// blast radius stays contained to that one new check instead of the many
/// existing `type_is_ground` call sites.
///
/// The sentinel shape `CtNamed(name, [CtUnknown])` is what `resolve_type_expr`
/// (checker_resolve.vibe) emits for an unresolved rigid single-name type
/// parameter reference AND for an unresolved/unknown type name alike -- treat
/// that shape as non-concrete. A REAL instantiated generic type (e.g. #829's
/// `Box::{v:1}` -> `CtNamed("Box", [CtInt])`) never carries the bare
/// `CtUnknown` sentinel as its own argument.
export fn type_fully_concrete(t: Type) -> Bool {
  match t {
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtUnknown => false,
    // A `CtNamed` with an EMPTY argument list is ALSO treated as non-concrete
    // (not just the `[CtUnknown]` singlet sentinel above): a rigid/uninstantiated
    // generic function's own type parameter can leak through, unsubstituted,
    // as a bare `CtNamed(pname, [])` when it only appears NESTED inside another
    // type's argument list (e.g. `MutMap::new_int[V]() -> MutMap[Int, V]`
    // called as `MutMap::new_int()` -- `instantiate` does not always rewrite
    // an occurrence of `V` buried inside a struct's own field/return-type
    // representation to a fresh `CtVar`, so it can surface literally as
    // `CtNamed("V", [])` instead -- lib/@vibe/core/hashmap_test.vibe
    // hit exactly this via `let m: MutMap[Int, String] = MutMap::new_int()`
    // during development of this check). Both shapes are the SAME underlying
    // ambiguity (a name with no way to tell "resolved zero-arg nominal type"
    // from "unresolved rigid reference" apart) that the shared `type_is_ground`
    // sidesteps by always tolerating `CtNamed`; treat both as non-concrete here
    // too so this narrowly-scoped check only ever fires when it is SURE both
    // sides are fully resolved.
    CtNamed(_, args) => {
      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {
        CtUnknown => true,
        _ => false
      })
      if is_sentinel {
        false
      } else {
        let mut ok = true
        let mut i = 0
        while i < Array::length(args) {
          if !type_fully_concrete(Array::get(args, i)) {
            ok = false
          }
          i = i + 1
        }
        ok
      }
    },
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_fully_concrete(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_fully_concrete(e),
    CtOption(e) => type_fully_concrete(e),
    CtFn(ps, r, _) => {
      let mut ok = type_fully_concrete(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_fully_concrete(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

fn is_builtin_scalar(t: Type) -> Bool {
  match t {
    CtInt => true,
    CtDouble => true,
    CtBool => true,
    CtString => true,
    CtChar => true,
    CtUnit => true,
    CtBytes => true,
    _ => false
  }
}

fn is_fully_concrete_named(t: Type) -> Bool {
  match t {
    CtNamed(_, _) => type_fully_concrete(t),
    _ => false
  }
}

export fn detect_narrowed_generic_mismatch_for(expected: Type, actual: Type, s: Subst, errors: Array[String], what_head: String, what_tail: String, off: Int) -> Subst {
  let e2 = subst_apply(s, expected)
  let a2 = subst_apply(s, actual)
  match e2 {
    CtNamed(ename, eargs) => match a2 {
      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {
        match unify(e2, a2, s) {
          Some(_) => s,
          None => {
            Array::push(errors, String::concat(String::concat(what_head, what_tail), String::concat(": expected ", String::concat(type_for_mismatch(e2), String::concat(", got ", String::concat(type_for_mismatch(a2), assignable_marker(off)))))))
            s
          }
        }
      } else s,
      _ => s
    },
    _ => s
  }
}
