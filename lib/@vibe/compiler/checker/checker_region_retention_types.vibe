import @vibe/compiler/core {
  Expr, Pat, Type, TypeDef, TypeEnv, env_lookup, expr_child_at, expr_children_pop, expr_children_push, expr_children_top
}
import @vibe/core {
  array_empty
}

/// The region-carrying builtin heads: their region is an argument of the
/// type, so a use of the head with no `#region_` argument is a spelling that
/// erased it (`TaskHandle[Int]`, a struct field `MutList[Int]`).
fn retention_is_region_head(name: String) -> Bool {
  name == "TaskHandle" || name == "TaskGroup" || name == "Sender" || name == "Receiver" || name == "Channel" || name == "MutList" || name == "MutBytes" || name == "Region" || name == "Task" || name == "Nursery"
}

/// Codex on #3359: whether the program declares a struct, enum or alias named
/// `name` -- itself or through an import. A compiler-owned head spelled the
/// same way (`struct Sender[T]` of the program's own) is then that
/// declaration, judged by its fields, the way `source_declares_type` reads
/// the declaration table for the assignability checks (#3326).
fn retention_declared_type(name: String, defs: Array[TypeDef]) -> Bool {
  let mut found = false
  for d in defs {
    match d {
      TDStruct(dn, _, _, _) => if String::equals(dn, name) {
        found = true
      } else {
        ()
      },
      TDAlias(dn, _, _) => if String::equals(dn, name) {
        found = true
      },
      TDEnum(dn, _, _) => if String::equals(dn, name) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
  }
  found
}

fn retention_type_has_region_skolem(t: Type) -> Bool {
  match t {
    CtNamed(n, args) => if String::starts_with(n, "#region_") {
      true
    } else {
      let mut found = false
      for a in args {
        if retention_type_has_region_skolem(a) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    _ => false
  }
}

/// `t` with each of `names` (a declaration's type parameters) replaced by
/// the argument at the same position, where there is one.
fn retention_subst_params(t: Type, names: Array[String], args: Array[Type]) -> Type {
  if Array::length(names) == 0 {
    t
  } else {
    match t {
      CtNamed(n, targs) => {
        let mut hit = -1
        let mut i = 0
        while i < Array::length(names) && i < Array::length(args) {
          if hit < 0 && String::equals(Array::get(names, i), n) && Array::length(targs) == 0 {
            hit = i
          } else {
            ()
          }
          i = i + 1
        }
        if hit >= 0 {
          Array::get(args, hit)
        } else {
          CtNamed(n, for a in targs {
            retention_subst_params(a, names, args)
          })
        }
      },
      CtArray(e) => CtArray(retention_subst_params(e, names, args)),
      CtOption(e) => CtOption(retention_subst_params(e, names, args)),
      CtTuple(items) => CtTuple(for item in items {
        retention_subst_params(item, names, args)
      }),
      CtRecord(fields) => CtRecord(for field in fields {
        let (fname, fty) = field
        (fname, retention_subst_params(fty, names, args))
      }),
      CtFn(ps, ret, eff) => CtFn(for p in ps {
        retention_subst_params(p, names, args)
      }, retention_subst_params(ret, names, args), eff),
      _ => t
    }
  }
}

fn retention_any_hides(items: Array[Type], defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  let mut any = false
  for item in items {
    if !any && retention_hides(item, defs, visiting) {
      any = true
    } else {
      ()
    }
  }
  any
}

/// Whether a declared type `name` applied to `args` holds a value whose
/// region its type would not show. Stop re-expanding an already visited
/// declaration, but inspect its current arguments: a recursive occurrence
/// may replace a harmless parameter with a region-hiding type.
fn retention_named_hides(name: String, args: Array[Type], defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  if retention_string_has(visiting, name) {
    retention_any_hides(args, defs, visiting)
  } else {
    let mut found = false
    let mut answer = false
    for d in defs {
      if !found {
        match d {
          TDStruct(dn, fields, _, tparams) => if String::equals(dn, name) {
            found = true
            Array::push(visiting, name)
            answer = retention_any_hides(for field in fields {
              let (_, fty) = field
              retention_subst_params(fty, tparams, args)
            }, defs, visiting)
            Array::truncate(visiting, Array::length(visiting) - 1)
          } else {
            ()
          },
          TDEnum(dn, tparams, variants) => if String::equals(dn, name) {
            found = true
            Array::push(visiting, name)
            let payloads = array_empty()
            for v in variants {
              let (_, tys) = v
              for t in tys {
                Array::push(payloads, retention_subst_params(t, tparams, args))
              }
            }
            answer = retention_any_hides(payloads, defs, visiting)
            Array::truncate(visiting, Array::length(visiting) - 1)
          } else {
            ()
          },
          TDAlias(dn, tparams, body) => if String::equals(dn, name) {
            found = true
            Array::push(visiting, name)
            answer = retention_hides(retention_subst_params(body, tparams, args), defs, visiting)
            Array::truncate(visiting, Array::length(visiting) - 1)
          } else {
            ()
          },
          _ => ()
        }
      } else {
        ()
      }
    }
    if found {
      answer
    } else if Array::length(args) == 0 {
      // An opaque type whose declaration is not visible here may hold
      // anything; a lowercase spelling is a type or row variable's name
      // (`e` of `TaskHandle[r, e, T]`), not a declaration.
      let head = if String::length(name) > 0 {
        String::byte_at(name, 0)
      } else {
        0
      }
      !(head >= 97 && head <= 122)
    } else {
      retention_any_hides(args, defs, visiting)
    }
  }
}

fn retention_hides(t: Type, defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  match t {
    CtInt => false,
    CtDouble => false,
    CtBool => false,
    CtString => false,
    CtChar => false,
    CtUnit => false,
    CtBytes => false,
    CtVar(_) => false,
    // A type the checker could not resolve is not judged here: what left a
    // region-carrying value untyped -- a struct literal whose field spells a
    // region head without its region -- is typed now, and an element the
    // checker lost (`FrozenArray::get(MutList::freeze(l), 0)` on a list whose
    // element type stayed open) is a copy out of the region.
    CtUnknown => false,
    CtConstructor(_, _) => false,
    CtArray(e) => retention_hides(e, defs, visiting),
    CtOption(e) => retention_hides(e, defs, visiting),
    CtTuple(items) => retention_any_hides(items, defs, visiting),
    CtRecord(fields) => retention_any_hides(for field in fields {
      let (_, fty) = field
      fty
    }, defs, visiting),
    // A closure's type does not list everything it captured.
    CtFn(_, _, _) => true,
    CtForAll(_, _, body) => retention_hides(body, defs, visiting),
    CtApplied(_, _) => true,
    CtStruct(name) => retention_named_hides(name, array_empty(), defs, visiting),
    CtEnum(name) => retention_named_hides(name, array_empty(), defs, visiting),
    CtNamed(name, args) => if String::starts_with(name, "#region_") {
      false
    } else if retention_is_region_head(name) && !retention_declared_type(name, defs) {
      let mut shown = false
      for a in args {
        if retention_type_has_region_skolem(a) {
          shown = true
        } else {
          ()
        }
      }
      !shown || retention_any_hides(args, defs, visiting)
    } else {
      retention_named_hides(name, args, defs, visiting)
    }
  }
}

/// #3343 (Codex on #3359): whether a value of type `t` may carry a region
/// its type does not name -- a region-carrying builtin spelled without its
/// region, a closure, a declared struct or enum holding either (through its
/// type arguments too), or a type whose declaration is not visible.
export fn retention_type_hides_region(t: Type, defs: Array[TypeDef]) -> Bool {
  retention_hides(t, defs, array_empty())
}

fn retention_string_has(items: Array[String], wanted: String) -> Bool {
  let mut found = false
  for item in items {
    if String::equals(item, wanted) {
      found = true
    } else {
      ()
    }
  }
  found
}

//# What a function keeps (#3360)

/// #3360: the binding that publishes which parameters a function keeps -- a
/// value passed there may be stored where it outlives the call (another
/// parameter, a module binding). A region body that passes its token at such
/// a position to an IMPORTED function is refused the way a call to a function
/// of its own module is, whose body is checked again at the call: an
/// importer sees only the dependency's interface, and this marker is how the
/// answer of that check crosses it. Bound to a record whose field names are
/// the kept positions; no source identifier can spell it.
export fn retention_keeps_marker(name: String) -> String {
  String::concat(retention_keeps_prefix, name)
}

let retention_keeps_prefix: String = "#keeps:"

/// Whether a binding name is a `retention_keeps_marker`. Allocates nothing.
export fn is_retention_keeps_marker(name: String) -> Bool {
  String::starts_with(name, retention_keeps_prefix)
}

/// The function a `retention_keeps_marker` binding names.
export fn retention_keeps_marker_target(name: String) -> String {
  String::substring(name, String::length(retention_keeps_prefix), String::length(name))
}

/// The kept parameter positions a marker's type records, each with where it
/// is kept: another parameter's position, or -1 for a module binding or a
/// function whose body is out of sight. A field is spelled `i` or `i>j`. A
/// tombstone (an import later hidden by a binding that keeps nothing)
/// records none.
export fn retention_keeps_positions(t: Type) -> Array[(Int, Int)] {
  let out: Array[(Int, Int)] = []
  match t {
    CtRecord(fields) => for field in fields {
      let (k, _) = field
      let parts = String::split(k, ">")
      if Array::length(parts) == 2 {
        Array::push(out, (retention_keeps_decimal(Array::get(parts, 0)), retention_keeps_decimal(Array::get(parts, 1))))
      } else {
        Array::push(out, (retention_keeps_decimal(k), 0 - 1))
      }
    },
    _ => ()
  }
  out
}

fn retention_keeps_decimal(text: String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < String::length(text) {
    n = n * 10 + String::byte_at(text, i) - '0'
    i = i + 1
  }
  n
}

/// The keeps marker for a function in `env`, innermost first, or None.
export fn retention_keeps_in_env(env: TypeEnv, name: String) -> Option[Type] {
  env_lookup(env, retention_keeps_marker(name))
}

/// Every `retention_keeps_marker` row in `env`, as (function name, marker
/// type), nearest binding first and each name once. A row whose type is not a
/// record is a tombstone: a later binding of the name that keeps nothing.
/// An env with no marker, which is nearly every env, answers a shared empty
/// array without allocating.
export fn env_keeps_rows(env: TypeEnv) -> Array[(String, Type)] {
  if env_keeps_marker_count(env) == 0 {
    no_keeps_rows
  } else {
    let rows: Array[(String, Type)] = []
    let mut current = env
    let mut done = false
    while !done {
      match current {
        EnvBind(name, binding, rest) => {
          keeps_row_push(rows, name, binding.ty)
          current = rest
        },
        EnvFlat(bindings) => {
          for entry in bindings {
            let (name, binding) = entry
            keeps_row_push(rows, name, binding.ty)
          }
          done = true
        },
        EnvShowWrappers(_, _, rest) => current = rest,
        EnvTraitDef(_, _, _, _, rest, _, _) => current = rest,
        EnvTraitImpl(_, _, rest) => current = rest,
        EnvTraitImplGen(_, _, _, _, rest) => current = rest,
        EnvTypeDefs(_, _, rest) => current = rest,
        EnvMutCell(_, _, rest) => current = rest,
        EnvCached(_, _, rest) => current = rest,
        EnvEmpty => done = true
      }
    }
    rows
  }
}

let no_keeps_rows: Array[(String, Type)] = []

fn env_keeps_marker_count(env: TypeEnv) -> Int {
  let mut count = 0
  let mut current = env
  let mut done = false
  while !done {
    match current {
      EnvBind(name, _, rest) => {
        if is_retention_keeps_marker(name) {
          count = count + 1
        }
        current = rest
      },
      EnvFlat(bindings) => {
        for entry in bindings {
          let (name, _) = entry
          if is_retention_keeps_marker(name) {
            count = count + 1
          }
        }
        done = true
      },
      EnvShowWrappers(_, _, rest) => current = rest,
      EnvTraitDef(_, _, _, _, rest, _, _) => current = rest,
      EnvTraitImpl(_, _, rest) => current = rest,
      EnvTraitImplGen(_, _, _, _, rest) => current = rest,
      EnvTypeDefs(_, _, rest) => current = rest,
      EnvMutCell(_, _, rest) => current = rest,
      EnvCached(_, _, rest) => current = rest,
      EnvEmpty => done = true
    }
  }
  count
}

fn keeps_row_push(rows: Array[(String, Type)], name: String, ty: Type) -> Unit {
  if is_retention_keeps_marker(name) {
    let fname = retention_keeps_marker_target(name)
    let mut seen = false
    for row in rows {
      let (n, _) = row
      seen = seen || n == fname
    }
    if !seen {
      Array::push(rows, (fname, ty))
    }
  }
}

/// The `retention_keeps_marker` rows of a flat binding list (a dependency's
/// published bindings), as (function name, marker type), first entry of each
/// name. Allocates nothing when there are none, which is nearly every
/// dependency.
export fn flat_keeps_rows(bindings: Array[(String, Type)]) -> Array[(String, Type)] {
  let mut hits = 0
  for entry in bindings {
    let (name, _) = entry
    if is_retention_keeps_marker(name) {
      hits = hits + 1
    }
  }
  if hits == 0 {
    no_keeps_rows
  } else {
    let rows: Array[(String, Type)] = []
    for entry in bindings {
      let (name, ty) = entry
      keeps_row_push(rows, name, ty)
    }
    rows
  }
}

/// The row `rows` holds for `name`, if any.
export fn keeps_rows_lookup(rows: Array[(String, Type)], name: String) -> Option[Type] {
  let mut found: Option[Type] = None
  for row in rows {
    let (n, t) = row
    if n == name {
      match found {
        None => found = Some(t),
        Some(_) => ()
      }
    }
  }
  found
}

/// #3360: whether a parameter of type `t` is probed for what its function
/// keeps: a region head, a type variable a caller can instantiate to one, or
/// a type that holds either (`Cell[T]`, `Array[TaskHandle[Int]]`, a struct
/// with such a field). A closure, and a closure field, are not probed: every
/// checker function takes a closure, and re-checking all of them costs more
/// heap than the compiler's own self-compile has.
export fn retention_type_may_carry_region(t: Type, defs: Array[TypeDef]) -> Bool {
  retention_may_carry(t, defs, array_empty())
}

fn retention_may_carry(t: Type, defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  match t {
    CtVar(_) => true,
    // Inside a declaration only a task group's tokens count: a field of a
    // `MutList` is how the compiler's own builders are shaped, and following
    // those re-checked enough of it to reach the self-compile heap gate.
    CtNamed(name, args) => String::starts_with(name, "#region_") || (retention_is_region_head(name) && (Array::length(visiting) == 0 || retention_is_task_head(name))) || retention_any_may_carry(args, defs, visiting) || retention_decl_may_carry(name, args, defs, visiting),
    CtStruct(name) => retention_decl_may_carry(name, array_empty(), defs, visiting),
    CtEnum(name) => retention_decl_may_carry(name, array_empty(), defs, visiting),
    CtApplied(head, args) => retention_may_carry(head, defs, visiting) || retention_any_may_carry(args, defs, visiting),
    CtArray(e) => retention_may_carry(e, defs, visiting),
    CtOption(e) => retention_may_carry(e, defs, visiting),
    CtTuple(items) => retention_any_may_carry(items, defs, visiting),
    CtForAll(_, _, body) => retention_may_carry(body, defs, visiting),
    _ => false
  }
}

fn retention_any_may_carry(items: Array[Type], defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  let mut any = false
  for item in items {
    any = any || retention_may_carry(item, defs, visiting)
  }
  any
}

fn retention_is_task_head(name: String) -> Bool {
  name == "TaskHandle" || name == "TaskGroup" || name == "Sender" || name == "Receiver" || name == "Channel" || name == "Task" || name == "Nursery"
}

/// Codex on #3467: a declaration whose fields or payloads hold a task group's
/// token (`struct Box { h: TaskHandle[Int] }`) carries the token its value is
/// built from. Its closure fields are not followed, as a closure parameter is
/// not.
fn retention_decl_may_carry(name: String, args: Array[Type], defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  if retention_string_has(visiting, name) {
    false
  } else if Array::length(args) == 0 {
    // A declaration used without arguments answers the same for the whole
    // module, so its answer is kept (`retention_decl_memo_reset`).
    match retention_decl_memo_get(name) {
      Some(b) => b,
      None => {
        let answer = retention_decl_fields_may_carry(name, args, defs, visiting)
        if Array::length(visiting) == 0 {
          Array::push(retention_decl_memo, (name, answer))
        }
        answer
      }
    }
  } else {
    retention_decl_fields_may_carry(name, args, defs, visiting)
  }
}

/// What `retention_decl_may_carry` answered for an argument-less declaration
/// in the module being checked.
let retention_decl_memo: Array[(String, Bool)] = []

export fn retention_decl_memo_reset() -> Unit {
  Array::truncate(retention_decl_memo, 0)
}

fn retention_decl_memo_get(name: String) -> Option[Bool] {
  let mut out: Option[Bool] = None
  for row in retention_decl_memo {
    let (n, b) = row
    if n == name {
      out = Some(b)
    }
  }
  out
}

fn retention_decl_fields_may_carry(name: String, args: Array[Type], defs: Array[TypeDef], visiting: Array[String]) -> Bool {
  let mut found = false
  let mut answer = false
  Array::push(visiting, name)
  for d in defs {
    if !found {
      match d {
        TDStruct(dn, fields, _, tparams) => if String::equals(dn, name) {
          found = true
          for field in fields {
            let (_, fty) = field
            answer = answer || retention_may_carry(retention_subst_if(fty, tparams, args), defs, visiting)
          }
        },
        TDEnum(dn, tparams, variants) => if String::equals(dn, name) {
          found = true
          for v in variants {
            let (_, tys) = v
            for ty in tys {
              answer = answer || retention_may_carry(retention_subst_if(ty, tparams, args), defs, visiting)
            }
          }
        },
        TDAlias(dn, tparams, body) => if String::equals(dn, name) {
          found = true
          answer = retention_may_carry(retention_subst_if(body, tparams, args), defs, visiting)
        },
        _ => ()
      }
    }
  }
  Array::truncate(visiting, Array::length(visiting) - 1)
  answer
}

/// `t` with the declaration's parameters substituted, or `t` itself when it
/// is used without arguments (no copy is made).
fn retention_subst_if(t: Type, tparams: Array[String], args: Array[Type]) -> Type {
  if Array::length(args) == 0 {
    t
  } else {
    retention_subst_params(t, tparams, args)
  }
}

/// #3360: whether a function body can store anything where it outlives the
/// call, read from its syntax: a field or element write, a call to a
/// retaining operation (`Array::push`, `Map::insert`, `Sender::send`, ...),
/// an assignment to a binding the body did not declare, or a call to a
/// function named in `keepers` (this module's functions already found to
/// store, and imported ones that publish what they keep). A write into a
/// binding the body itself made fresh (`let out = []`, `MutMap::new()`) is
/// not one: nothing outside the call can reach it unless another write stores
/// it, and that write is counted. A body that does none of these keeps
/// nothing, so it is not checked again; this is what keeps the probes
/// affordable.
export fn retention_body_may_store(body: Expr, keepers: Array[String]) -> Bool {
  let mut_locals: Array[String] = []
  let fresh: Array[String] = []
  let other: Array[String] = []
  retention_collect_locals(body, mut_locals, fresh, other)
  // A name also bound some other way (a parameter, a `let` of a value from
  // outside) may be that other binding at the write, so only a name every
  // binder of which is fresh counts as fresh.
  let only_fresh: Array[String] = []
  for n in fresh {
    if !retention_string_has(other, n) {
      Array::push(only_fresh, n)
    }
  }
  retention_scan_store(body, mut_locals, only_fresh, keepers)
}

fn retention_collect_locals(e: Expr, mut_locals: Array[String], fresh: Array[String], other: Array[String]) -> Unit {
  match e {
    ELet(name, v, _, _) => if retention_is_fresh_value(v) {
      Array::push(fresh, name)
    } else {
      Array::push(other, name)
    },
    ELetMut(name, v, _, _) => {
      Array::push(mut_locals, name)
      if retention_is_fresh_value(v) {
        Array::push(fresh, name)
      } else {
        Array::push(other, name)
      }
    },
    EForIn(name, _, _, _) => Array::push(other, name),
    EFn(_, _, params, _, _, _) => for p in params {
      let (pn, _) = p
      Array::push(other, pn)
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    retention_collect_locals(expr_child_at(i), mut_locals, fresh, other)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// A value that is a new container no one else holds: a literal, a
/// constructor call (`MutMap::new()`, `Array::make(n, x)`, `array_empty()`),
/// or one of these under a `let` annotation's ascription wrapper.
fn retention_is_fresh_value(v: Expr) -> Bool {
  match v {
    EArray(_) => true,
    ERecord(_, _, _) => true,
    EMap(_) => true,
    ECall(EFn(_, _, _, _, _, EIdent("__asc", _)), args, _, _) => Array::length(args) == 1 && retention_is_fresh_value(Array::get(args, 0)),
    ECall(EIdent(name, _), _, _, _) => name == "array_empty" || String::ends_with(name, "::new") || String::ends_with(name, "::new_string") || String::ends_with(name, "::new_int") || String::ends_with(name, "::make") || String::ends_with(name, "::with_capacity"),
    _ => false
  }
}

fn retention_scan_store(e: Expr, locals: Array[String], fresh: Array[String], keepers: Array[String]) -> Bool {
  let here = match e {
    EAssign(name, _, _, _) => !retention_string_has(locals, name),
    EAssignOp(name, _, _, _, _) => !retention_string_has(locals, name),
    ECall(EIdent(name, _), args, _, _) => if retention_string_has(keepers, name) {
      true
    } else if retention_is_store_op(name) {
      !retention_targets_fresh(args, fresh)
    } else {
      false
    },
    _ => false
  }
  if here {
    true
  } else {
    let mark = expr_children_push(e)
    let top = expr_children_top()
    let mut found = false
    let mut i = mark
    while i < top && !found {
      found = retention_scan_store(expr_child_at(i), locals, fresh, keepers)
      i = i + 1
    }
    expr_children_pop(mark)
    found
  }
}

/// Whether a retaining operation writes into a fresh local: its target, the
/// first argument, names one directly.
fn retention_targets_fresh(args: Array[Expr], fresh: Array[String]) -> Bool {
  if Array::length(args) == 0 {
    false
  } else {
    match Array::get(args, 0) {
      EIdent(n, _) => retention_string_has(fresh, n),
      _ => false
    }
  }
}

/// #3360: whether parameter `pname` of the function literal `lit` can reach a
/// store at all, read from its syntax. The names bound from a value that
/// mentions it (`let`, `for`, a `match` on it) carry it too; it reaches a
/// store when one of them is an argument of a retaining operation that does
/// not write a fresh local, of a function in `keepers`, or of a call to a
/// function value; or the value assigned to a binding the body did not
/// declare. A parameter that reaches none of these is not kept, and the
/// probe that would re-check the body for it is skipped.
export fn retention_param_may_reach_store(lit: Expr, pname: String, keepers: Array[String]) -> Bool {
  let tainted: Array[String] = [pname]
  let mut grew = true
  while grew {
    let before = Array::length(tainted)
    retention_taint_bindings(lit, tainted)
    grew = Array::length(tainted) > before
  }
  let mut_locals: Array[String] = []
  let fresh: Array[String] = []
  let other: Array[String] = []
  retention_collect_locals(lit, mut_locals, fresh, other)
  let only_fresh: Array[String] = []
  for n in fresh {
    if !retention_string_has(other, n) {
      Array::push(only_fresh, n)
    }
  }
  let callables: Array[String] = []
  match lit {
    EFn(_, _, params, _, _, _) => for p in params {
      let (pn, _) = p
      Array::push(callables, pn)
    },
    _ => ()
  }
  retention_tainted_store(lit, tainted, mut_locals, only_fresh, keepers, callables)
}

fn retention_taint_bindings(e: Expr, tainted: Array[String]) -> Unit {
  match e {
    ELet(n, v, _, _) => retention_taint_if(n, v, tainted),
    ELetMut(n, v, _, _) => retention_taint_if(n, v, tainted),
    EForIn(n, _, it, _) => retention_taint_if(n, it, tainted),
    EAssign(n, v, _, _) => retention_taint_if(n, v, tainted),
    EMatch(sc, arms) => if retention_mentions_any(sc, tainted) {
      for arm in arms {
        let (pat, _) = arm
        retention_taint_pat(pat, tainted)
      }
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    retention_taint_bindings(expr_child_at(i), tainted)
    i = i + 1
  }
  expr_children_pop(mark)
}

fn retention_taint_if(n: String, v: Expr, tainted: Array[String]) -> Unit {
  if !retention_string_has(tainted, n) && retention_mentions_any(v, tainted) {
    Array::push(tainted, n)
  }
}

fn retention_taint_pat(p: Pat, tainted: Array[String]) -> Unit {
  match p {
    PBind(n) => if !retention_string_has(tainted, n) {
      Array::push(tainted, n)
    },
    PCtor(_, ps) => for q in ps {
      retention_taint_pat(q, tainted)
    },
    PTuple(ps) => for q in ps {
      retention_taint_pat(q, tainted)
    },
    POr(a, b) => {
      retention_taint_pat(a, tainted)
      retention_taint_pat(b, tainted)
    },
    PStruct(_, fs) => for f in fs {
      let (_, q) = f
      retention_taint_pat(q, tainted)
    },
    _ => ()
  }
}

fn retention_mentions_any(e: Expr, names: Array[String]) -> Bool {
  match e {
    EIdent(n, _) => retention_string_has(names, n),
    _ => {
      let mark = expr_children_push(e)
      let top = expr_children_top()
      let mut found = false
      let mut i = mark
      while i < top && !found {
        found = retention_mentions_any(expr_child_at(i), names)
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

fn retention_args_mention(args: Array[Expr], names: Array[String]) -> Bool {
  let mut found = false
  for a in args {
    found = found || retention_mentions_any(a, names)
  }
  found
}

fn retention_tainted_store(e: Expr, tainted: Array[String], locals: Array[String], fresh: Array[String], keepers: Array[String], callables: Array[String]) -> Bool {
  let here = match e {
    EAssign(name, v, _, _) => !retention_string_has(locals, name) && retention_mentions_any(v, tainted),
    EAssignOp(name, _, v, _, _) => !retention_string_has(locals, name) && retention_mentions_any(v, tainted),
    ECall(EIdent(name, _), args, _, _) => if retention_string_has(keepers, name) || retention_string_has(callables, name) || retention_string_has(tainted, name) {
      retention_args_mention(args, tainted)
    } else if retention_is_store_op(name) {
      !retention_targets_fresh(args, fresh) && retention_args_mention(args, tainted)
    } else {
      false
    },
    ECall(EIdent(_, _), _, _, _) => false,
    ECall(_, args, _, _) => retention_args_mention(args, tainted),
    _ => false
  }
  if here {
    true
  } else {
    let mark = expr_children_push(e)
    let top = expr_children_top()
    let mut found = false
    let mut i = mark
    while i < top && !found {
      found = retention_tainted_store(expr_child_at(i), tainted, locals, fresh, keepers, callables)
      i = i + 1
    }
    expr_children_pop(mark)
    found
  }
}

fn retention_is_store_op(name: String) -> Bool {
  // Suffix tests allocate nothing; this runs on every named call of every
  // published function body.
  name == "__set_field" || String::ends_with(name, "::push") || String::ends_with(name, "::push_all") || String::ends_with(name, "::push_back") || String::ends_with(name, "::push_front") || String::ends_with(name, "::set") || String::ends_with(name, "::unsafe_set") || String::ends_with(name, "::insert") || String::ends_with(name, "::add") || String::ends_with(name, "::append") || String::ends_with(name, "::blit") || String::ends_with(name, "::fill") || String::ends_with(name, "::send") || String::ends_with(name, "::put")
}

/// The probed parameter's type with every type variable read as the probe
/// region, so a value of it carries the probe in plain view the way a token
/// passed at a call does (`T` becomes the probe; `Cell[T]` holds it; the
/// `rg` of a `TaskHandle[rg, e, T]` is it).
export fn retention_probe_type(t: Type, probe: String) -> Type {
  match t {
    CtVar(_) => CtNamed(probe, array_empty()),
    CtNamed(name, args) => CtNamed(name, for a in args {
      retention_probe_type(a, probe)
    }),
    CtApplied(head, args) => CtApplied(retention_probe_type(head, probe), for a in args {
      retention_probe_type(a, probe)
    }),
    CtArray(e) => CtArray(retention_probe_type(e, probe)),
    CtOption(e) => CtOption(retention_probe_type(e, probe)),
    CtTuple(items) => CtTuple(for a in items {
      retention_probe_type(a, probe)
    }),
    _ => t
  }
}

/// `t` contains a part the checker has not determined yet, which may still
/// become a type that hides a region.
export fn retention_type_open(t: Type) -> Bool {
  match t {
    CtVar(_) => true,
    CtUnknown => true,
    CtArray(e) => retention_type_open(e),
    CtOption(e) => retention_type_open(e),
    CtTuple(items) => {
      let mut any = false
      for item in items {
        if retention_type_open(item) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    CtNamed(_, args) => {
      let mut any = false
      for a in args {
        if retention_type_open(a) {
          any = true
        } else {
          ()
        }
      }
      any
    },
    CtForAll(_, _, body) => retention_type_open(body),
    _ => false
  }
}

export fn retention_decimal_text(text: String) -> Int {
  if String::length(text) == 0 {
    0 - 1
  } else {
    let mut out = 0
    let mut ok = true
    let mut i = 0
    while i < String::length(text) {
      let d = String::byte_at(text, i) - 48
      if d < 0 || d > 9 {
        ok = false
      } else {
        out = out * 10 + d
      }
      i = i + 1
    }
    if ok {
      out
    } else {
      0 - 1
    }
  }
}

export fn retention_call_message(callee: String, nursery: Bool, kind: Int) -> String {
  let head = String::concat(if nursery {
    "region escapes its nursery scope: this call to `"
  } else {
    "region escapes its scope: this call to `"
  }, callee)
  let token = if nursery {
    "this TaskGroup::run call's own Nursery/Task/Sender/Receiver token"
  } else {
    "a value that captures this region"
  }
  let fix = if nursery {
    " -- join the task (or use the endpoint) inside the body and pass the result instead"
  } else {
    ""
  }
  if kind == 1 {
    if nursery {
      String::concat(head, String::concat("` stores ", String::concat(token, String::concat(" in a binding declared outside the body", String::concat(fix, ", or declare the binding inside the body")))))
    } else {
      String::concat(head, "` stores a value that captures this region into an outer binding")
    }
  } else {
    String::concat(head, String::concat("` passes ", String::concat(token, String::concat(" on to a function whose body the checker cannot see", fix))))
  }
}

export fn retention_opaque_message(callee: String, nursery: Bool) -> String {
  if nursery {
    String::concat("region escapes its nursery scope: this call passes this TaskGroup::run call's own Nursery/Task/Sender/Receiver token to `", String::concat(callee, "`, a function whose body the checker cannot see, so it may keep the token after the group closes -- join the task (or use the endpoint) inside the body and pass the result instead, or call a function or `let`-bound closure written in this file"))
  } else {
    String::concat("region escapes its scope: this call passes a value that captures this region to `", String::concat(callee, "`, a function whose body the checker cannot see, so it may keep the value after the region ends"))
  }
}

