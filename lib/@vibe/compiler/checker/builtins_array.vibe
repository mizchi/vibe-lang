//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn array_no_params() -> Array[Type] {
  array_empty()
}

fn array_one_param(a: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  arr
}

fn array_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_array_get(name: String) -> Option[Type] {
  if name == "Array::get" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

fn lookup_array_new(name: String) -> Option[Type] {
  if name == "array_new" {
    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_set(name: String) -> Option[Type] {
  if name == "Array::set" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_array_push(name: String) -> Option[Type] {
  if name == "Array::push" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_array_slice(name: String) -> Option[Type] {
  if name == "Array::slice" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_concat(name: String) -> Option[Type] {
  if name == "Array::concat" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_map(name: String) -> Option[Type] {
  if name == "Array::map" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_fold(name: String) -> Option[Type] {
  if name == "Array::fold" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtUnknown, CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)), CtUnknown, None))
  }
  else None
}

fn lookup_array_filter(name: String) -> Option[Type] {
  if name == "Array::filter" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_foreach(name: String) -> Option[Type] {
  if name == "Array::foreach" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnit, None)), CtUnit, None))
  }
  else None
}

fn lookup_array_reverse(name: String) -> Option[Type] {
  if name == "Array::reverse" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_any(name: String) -> Option[Type] {
  if name == "Array::any" || name == "Array::all" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtBool, None))
  }
  else None
}

fn lookup_array_find(name: String) -> Option[Type] {
  if name == "Array::find" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtOption(CtUnknown), None))
  }
  else None
}

fn lookup_array_sort(name: String) -> Option[Type] {
  if name == "Array::sort" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_contains(name: String) -> Option[Type] {
  if name == "Array::contains" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtBool, None))
  }
  else None
}

fn lookup_array_join(name: String) -> Option[Type] {
  if name == "Array::join" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtString), CtString, None))
  }
  else None
}

fn lookup_array_length(name: String) -> Option[Type] {
  if name == "Array::length" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtInt, None))
  }
  else None
}

fn lookup_array_group_a(name: String) -> Option[Type] {
  match lookup_array_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_length(name) {
      Some(t) => Some(t),
      None => match lookup_array_get(name) {
        Some(t) => Some(t),
        None => lookup_array_set(name)
      }
    }
  }
}

fn lookup_array_push_all(name: String) -> Option[Type] {
  if name == "Array::push_all" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))
  }
  else None
}

fn lookup_array_truncate(name: String) -> Option[Type] {
  if name == "Array::truncate" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))
  }
  else None
}

fn lookup_array_group_b(name: String) -> Option[Type] {
  match lookup_array_push(name) {
    Some(t) => Some(t),
    None => match lookup_array_slice(name) {
      Some(t) => Some(t),
      None => match lookup_array_push_all(name) {
        Some(t) => Some(t),
        None => match lookup_array_truncate(name) {
          Some(t) => Some(t),
          None => match lookup_array_concat(name) {
            Some(t) => Some(t),
            None => match lookup_array_map(name) {
              Some(t) => Some(t),
              None => match lookup_array_fold(name) {
                Some(t) => Some(t),
                None => match lookup_array_filter(name) {
                  Some(t) => Some(t),
                  None => match lookup_array_foreach(name) {
                    Some(t) => Some(t),
                    None => match lookup_array_reverse(name) {
                      Some(t) => Some(t),
                      None => match lookup_array_any(name) {
                        Some(t) => Some(t),
                        None => match lookup_array_find(name) {
                          Some(t) => Some(t),
                          None => match lookup_array_sort(name) {
                            Some(t) => Some(t),
                            None => match lookup_array_contains(name) {
                              Some(t) => Some(t),
                              None => lookup_array_join(name)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

export fn lookup_array(name: String) -> Option[Type] {
  match lookup_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_array_group_b(name)
  }
}
