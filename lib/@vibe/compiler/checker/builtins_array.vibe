//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn array_no_params() -> Array[Type] {
  array_empty()
}

fn array_one_param(a: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  arr
}

fn array_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_array_map(name: String) -> Option[Type] {
  if name == "Array::map" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_fold(name: String) -> Option[Type] {
  if name == "Array::fold" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtUnknown, CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)), CtUnknown, None))
  }
  else None
}

fn lookup_array_filter(name: String) -> Option[Type] {
  if name == "Array::filter" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_foreach(name: String) -> Option[Type] {
  if name == "Array::foreach" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnit, None)), CtUnit, None))
  }
  else None
}

fn lookup_array_reverse(name: String) -> Option[Type] {
  if name == "Array::reverse" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_any(name: String) -> Option[Type] {
  if name == "Array::any" || name == "Array::all" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtBool, None))
  }
  else None
}

fn lookup_array_find(name: String) -> Option[Type] {
  if name == "Array::find" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)), CtOption(CtUnknown), None))
  }
  else None
}

fn lookup_array_sort(name: String) -> Option[Type] {
  if name == "Array::sort" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_array_contains(name: String) -> Option[Type] {
  if name == "Array::contains" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtBool, None))
  }
  else None
}

fn lookup_array_join(name: String) -> Option[Type] {
  if name == "Array::join" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtString), CtString, None))
  }
  else None
}

export fn lookup_array(name: String) -> Option[Type] {
  match lookup_array_map(name) {
    Some(t) => Some(t),
    None => match lookup_array_fold(name) {
      Some(t) => Some(t),
      None => match lookup_array_filter(name) {
        Some(t) => Some(t),
        None => match lookup_array_foreach(name) {
          Some(t) => Some(t),
          None => match lookup_array_reverse(name) {
            Some(t) => Some(t),
            None => match lookup_array_any(name) {
              Some(t) => Some(t),
              None => match lookup_array_find(name) {
                Some(t) => Some(t),
                None => match lookup_array_sort(name) {
                  Some(t) => Some(t),
                  None => match lookup_array_contains(name) {
                    Some(t) => Some(t),
                    None => lookup_array_join(name)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
