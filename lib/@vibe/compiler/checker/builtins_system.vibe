//# Imports

import ../core/index.vibe {
  Type
}

//# Functions

fn system_no_params() -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

// NOTE: these use `if name == ...` chains, NOT `match name { "lit" => }`.
// String-literal patterns in `match` do not match at runtime in the compiled
// selfhost (codegen gap), so the original `match`-based lookups silently
// returned None for every entry — that is why Stdin/Stdout/Env/sh builtins (and
// thus io.vibe/markdown/rlm) failed to resolve. `==` comparison works.
fn lookup_io_a(name: String) -> Option[Type] {
  if name == "sh" {
    Some(CtFn([
      CtString
    ], CtString, Some("Process")))
  } else if name == "sh_lines" {
    Some(CtFn([
      CtString
    ], CtArray(CtString), Some("Process")))
  } else if name == "path" {
    Some(CtFn([
      CtString
    ], CtUnknown, None))
  } else if name == "Path::ref" {
    // #762: a trusted path LITERAL reference. Resolved to an absolute path
    // against the process CWD by the `resolve_path` host import (compile_call
    // lowering), but typed PURE — a `Path::ref` in source is a static reference,
    // so from_literal need not carry `Env`. Path::resolve is the effect-tracked
    // dynamic counterpart (same host op, `with { Env }`).
    Some(CtFn([
      CtString
    ], CtString, None))
  } else if name == "Path::to_string" {
    Some(CtFn([
      CtUnknown
    ], CtString, None))
  } else if name == "Path::is_absolute" {
    Some(CtFn([
      CtString
    ], CtBool, None))
  } else if name == "PromptText::new" {
    Some(CtFn([
      CtString
    ], CtString, None))
  } else if name == "Stdin::read_char" {
    Some(CtFn(system_no_params(), CtInt, Some("Stdin")))
  } else if name == "Stdin::read_stream" {
    Some(CtFn([
      CtInt
    ], CtString, Some("Stdin")))
  } else {
    None
  }
}

fn lookup_io_b(name: String) -> Option[Type] {
  if name == "Stdout::write_char" {
    Some(CtFn([
      CtInt
    ], CtUnit, Some("Stdout")))
  } else if name == "Stdout::write_stream" {
    Some(CtFn([
      CtString
    ], CtUnit, Some("Stdout")))
  } else if name == "Env::get" {
    Some(CtFn([
      CtString
    ], CtString, Some("Env")))
  } else if name == "Env::args_len" {
    Some(CtFn(system_no_params(), CtInt, Some("Env")))
  } else if name == "Env::args_get" {
    Some(CtFn([
      CtInt
    ], CtString, Some("Env")))
  } else if name == "Profiler::now_us" {
    Some(CtFn(system_no_params(), CtInt, Some("Profiler")))
  } else if name == "sleep" {
    Some(CtFn([
      CtInt
    ], CtUnit, Some("Async")))
  } else if name == "Path::resolve" {
    Some(CtFn([
      CtString
    ], CtString, None))
  } else {
    None
  }
}

// Lines / Llm / Rlm builtins (host: src/checker builtin_declared_names +
// core_io / json_and_fallback handlers). Added for selfhost parity.
fn lookup_io_c(name: String) -> Option[Type] {
  if name == "Lines::parse" {
    Some(CtFn([
      CtString
    ], CtArray(CtString), None))
  } else if name == "Lines::stringify" {
    Some(CtFn([
      CtArray(CtString)
    ], CtString, None))
  } else if name == "Llm::complete" {
    Some(CtFn([
      CtString,
      CtString
    ], CtString, Some("Llm")))
  } else if name == "Rlm::run" {
    Some(CtFn([
      CtString,
      CtString
    ], CtString, Some("Llm")))
  } else if name == "Rlm::finalize" {
    Some(CtFn([
      CtString
    ], CtString, None))
  } else {
    None
  }
}

export fn lookup_io(name: String) -> Option[Type] {
  match lookup_io_a(name) {
    Some(t) => Some(t),
    None => match lookup_io_b(name) {
      Some(t) => Some(t),
      None => lookup_io_c(name)
    }
  }
}
