//# Imports

import @vibe/compiler/core {
  Type
}

//# Functions

/// Fallback-only process and path helpers. Checker-visible capability builtins
/// (sh, Stdin, Stdout, Env, Profiler, sleep) live in the registry (#1593).
fn lookup_io_a(name: String) -> Option[Type] {
  if name == "sh_lines" {
    Some(CtFn([CtString], CtArray(CtString), Some("Process")))
  } else if name == "path" {
    Some(CtFn([CtString], CtUnknown, None))
  } else if name == "Path::ref" {
    Some(CtFn([CtString], CtString, None))
  } else if name == "Path::to_string" {
    Some(CtFn([CtUnknown], CtString, None))
  } else if name == "Path::is_absolute" {
    Some(CtFn([CtString], CtBool, None))
  } else if name == "Path::resolve" {
    Some(CtFn([CtString], CtString, None))
  } else {
    None
  }
}

/// #2913: `Lines::parse`, `Lines::stringify` and `PromptText::new` used to be
/// typed here (the first two in a `lookup_io_b` that held nothing else). The
/// comment above them said "it is implemented in `@vibe/builtin`'s string.vibe,
/// so a direct call still reaches code". Measured, it does not: with no import
/// the call types clean and codegen answers
///
///   internal compiler error: `Lines::parse` (local, @call) reached code
///   generation unresolved
///
/// while the same program with `import @vibe/builtin { Lines::parse }` compiles.
/// They are ordinary exported vibe functions (`lib/@vibe/builtin/string.vibe`,
/// declared in that package's `index.vpkg`), so they follow the same rule as
/// `String::replace` and the rest of #2900's family: the name must be imported
/// by name. `builtin_no_lowering_hint` says so at the `unknown name`.
///
/// This is the rule the #2110 paragraph below already stated and these three
/// broke -- nothing may be declared in this lane that has no lowering. It was
/// found by sweeping every `declare` in `builtins/declarations.vibe` through a
/// compile probe, which is #2913's second half.
///
/// #2110: nothing may be declared here that has no lowering. `Llm::complete` /
/// `Rlm::run` / `Rlm::finalize` were, and a two-line program calling one passed
/// the checker and died in codegen with "internal compiler error ... a bug in
/// the compiler and not in your program". An absent name gets `unknown name`
/// with a position, which is the honest answer for a never-implemented feature.
export fn lookup_io(name: String) -> Option[Type] {
  lookup_io_a(name)
}
