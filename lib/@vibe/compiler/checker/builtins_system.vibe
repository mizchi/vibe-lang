//# Imports

import @vibe/compiler/core {
  Type
}

//# Functions

/// Fallback-only process and path helpers. Checker-visible capability builtins
/// (sh, Stdin, Stdout, Env, Profiler, sleep) live in the registry (#1593).
fn lookup_io_a(name: String) -> Option[Type] {
  if name == "sh_lines" {
    Some(CtFn([CtString], CtArray(CtString), Some("Process")))
  } else if name == "path" {
    Some(CtFn([CtString], CtUnknown, None))
  } else if name == "Path::ref" {
    Some(CtFn([CtString], CtString, None))
  } else if name == "Path::to_string" {
    Some(CtFn([CtUnknown], CtString, None))
  } else if name == "Path::is_absolute" {
    Some(CtFn([CtString], CtBool, None))
  } else if name == "PromptText::new" {
    Some(CtFn([CtString], CtString, None))
  } else if name == "Path::resolve" {
    Some(CtFn([CtString], CtString, None))
  } else {
    None
  }
}

/// Lines remains a fallback-only checker declaration; it is implemented in
/// `@vibe/builtin`'s string.vibe, so a direct call still reaches code.
///
/// #2110: nothing may be declared here that has no lowering. `Llm::complete` /
/// `Rlm::run` / `Rlm::finalize` were, and a two-line program calling one passed
/// the checker and died in codegen with "internal compiler error ... a bug in
/// the compiler and not in your program". An absent name gets `unknown name`
/// with a position, which is the honest answer for a never-implemented feature.
fn lookup_io_b(name: String) -> Option[Type] {
  if name == "Lines::parse" {
    Some(CtFn([CtString], CtArray(CtString), None))
  } else if name == "Lines::stringify" {
    Some(CtFn([CtArray(CtString)], CtString, None))
  } else {
    None
  }
}

export fn lookup_io(name: String) -> Option[Type] {
  match lookup_io_a(name) {
    Some(t) => Some(t),
    None => lookup_io_b(name)
  }
}
