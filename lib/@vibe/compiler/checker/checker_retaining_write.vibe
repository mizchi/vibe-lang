// Which arguments a mutable operation retains in its receiver, for the
// region write check (`retaining_write_region_check`).

import @vibe/compiler/core {
  Type,
  TypeEnv,
  builtin_array_push,
  builtin_array_set,
  builtin_mutlist_push,
  builtin_mutlist_truncate,
  canonical_builtin_name,
  resolved_builtin_operation_from_source
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_resolves_at
}

import @vibe/compiler/checker/traits {
  env_marker_before
}

import ./checker_eq_unbounded_formal_msg.vibe {
  env_has_active_region
}

import ./checker_region_retention_arms.vibe {
  retention_decls
}

import ./checker_region_retention.vibe {
  retention_alias_source, retention_closure_scope, retention_marker, retention_name_scope
}

/// Argument positions retained by a mutable operation, encoded as a two-bit
/// mask for positions 1 and 2. `operation` is the checker's answer for the
/// call (`resolve_builtin_callee`): a builtin operation identity, -1 for a
/// program binding of a builtin spelling, or 0 for a spelling with no
/// identity yet, which is the only case read from `source_name`.
///
/// #3255: an operation with an identity is classified by that identity. Its
/// spelling used to be in the ladder below, so a program's own `fn
/// Array::push` that keeps nothing was refused inside a region as if it were
/// the builtin. A program binding retains what its body retains, and
/// `retention_call_region_check` re-checks that body at the call; a program
/// alias of a builtin is followed by `retaining_write_call_mask`.
///
/// The ladder is the checker-owned inventory for the operations without an
/// identity: other shipped primitives and standard-library mutable wrappers.
/// Aliases are listed beside their canonical spelling.
export fn retaining_write_argument_mask(source_name: String, operation: Int) -> Int {
  if operation > 0 {
    retaining_write_operation_mask(operation)
  } else if operation < 0 {
    0
  } else {
    let name = canonical_builtin_name(source_name)
    if name == "ArrayBuilder::push" || name == "Array::push_all" || name == "Array::truncate" || name == "MutSet::add" || name == "HashSet::add" || name == "MutSortedSet::add" || name == "SortedSet::add" || name == "PriorityQueue::push" || name == "Deque::push_back" || name == "Deque::push_front" {
      1
    } else if name == "FixedArray::set" || name == "FixedArray::unsafe_set" || name == "__set_field" {
      2
    } else if name == "MapBuilder::set" || name == "MutMap::set" || name == "HashMap::set" || name == "MutSortedMap::set" || name == "SortedMap::set" {
      3
    } else {
      0
    }
  }
}

/// The same mask for a builtin operation identity; 0 for every operation that
/// stores none of its arguments.
fn retaining_write_operation_mask(_ operation: Int) -> Int {
  if operation == builtin_array_push || operation == builtin_mutlist_push || operation == builtin_mutlist_truncate {
    1
  } else if operation == builtin_array_set {
    2
  } else {
    0
  }
}

/// The retained-argument mask of a call by `name` inside an active region,
/// with the checker's `operation` for it. A spelling with no answer of its own
/// is asked through the aliases it may name (`retaining_write_alias_target`):
///
/// - an alias of a builtin operation answers that operation's mask. That
///   includes a program binding of a builtin spelling (`operation < 0`):
///   Codex on #3984 found `let MutList::push = Array::push` answered -1, so
///   the call stored nothing here, and the body recheck trusts the builtin it
///   follows the alias to;
/// - #3255: an alias of a spelling the ladder lists -- an imported library
///   wrapper such as `MutMap::set` or `MutSet::add`, by a local or top-level
///   `let` -- answers the ladder for THAT spelling. It used to name no
///   ladder entry, so `let put = MutMap::set; put(outer, 1, cell)` stored a
///   region value into an outer map and was accepted.
///
/// A program `fn` of a ladder spelling still answers the ladder for its
/// spelling, as before: the region gate's fail-closed rows
/// (`fixtures/err_region_escape_*_write.vibe`, #1938) stand in for the library
/// wrappers with such functions, whose bodies keep nothing.
export fn retaining_write_call_mask(env: TypeEnv, name: String, operation: Int) -> Int {
  let named = retaining_write_argument_mask(source_name = name, operation = operation)
  if named == 0 && operation <= 0 && env_has_active_region(env) {
    let (alias_operation, target) = retaining_write_alias_target(env = env, name = name)
    if alias_operation > 0 {
      retaining_write_operation_mask(alias_operation)
    } else if target != "" && target != name {
      retaining_write_argument_mask(source_name = target, operation = 0)
    } else {
      0
    }
  } else {
    named
  }
}

/// #3255 (Codex on #3984): the builtin operation a call by `name` reaches
/// through function aliases -- a local `let put = Array::push`, an alias of an
/// alias, or a top-level `let` -- or 0 when `name` is no alias of a builtin.
/// A call through such an alias stores into its receiver what the builtin
/// does, but its spelling named no retaining operation, so a region value it
/// wrote into an outer binding was not seen (`let put = Array::push; put(sink,
/// cell)`, directly or inside a function the retention recheck reads).
///
/// Each local alias is followed in the scope it was written in, through the
/// marker `retention_bind_let` lays in front of it; a local binding without
/// one (a parameter, a closure) ends the chain, as does any value that is not
/// a bare name.
export fn retaining_write_alias_operation(env: TypeEnv, name: String) -> Int {
  let (operation, _) = retaining_write_alias_target(env = env, name = name)
  operation
}

/// Where a call by `name` lands, following the aliases
/// `retaining_write_alias_operation` describes: the builtin operation it
/// reaches (0 for none), and the spelling the chain ends at, or "" when it
/// ends at a local binding that is no alias (a parameter, a closure).
fn retaining_write_alias_target(env: TypeEnv, name: String) -> (Int, String) {
  let mut scope = env
  let mut current = name
  let mut local = true
  let mut operation = 0
  let mut target = ""
  let mut depth = 0
  let mut done = false
  while !done && depth <= 8 {
    let marker = if local {
      env_marker_before(env = scope, marker = retention_marker(current), name = current)
    } else {
      None
    }
    match marker {
      Some(CtNamed(text, _)) => if String::starts_with(text, prefix = "a:") {
        match retention_closure_scope(env = scope, bound_name = current, text = text) {
          Some(def_env) => {
            scope = def_env
            current = String::substring(text, start = 2, end = String::length(text))
          },
          None => {
            done = true
          }
        }
      } else {
        done = true
      },
      Some(_) => {
        done = true
      },
      None => if local && retention_name_scope(env = scope, name = current) == 1 {
        done = true
      } else {
        let source = retaining_write_top_level_alias(current)
        if source != "" {
          local = false
          current = source
        } else {
          if depth > 0 && builtin_resolves_at(env = scope, name = current, ident_off = 0 - 1) {
            operation = resolved_builtin_operation_from_source(current)
          } else {
            ()
          }
          target = current
          done = true
        }
      }
    }
    depth = depth + 1
  }
  (operation, target)
}

/// The name a top-level `let` of `name` aliases, or "".
fn retaining_write_top_level_alias(_ name: String) -> String {
  let mut source = ""
  let mut found = false
  for decl in retention_decls {
    let (decl_name, value) = decl
    if !found && String::equals(decl_name, name) {
      found = true
      source = retention_alias_source(value)
    } else {
      ()
    }
  }
  source
}
