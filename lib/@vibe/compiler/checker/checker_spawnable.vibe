//# Imports

import @vibe/compiler/core {
  Expr,
  Pat,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_flat_bindings,
  env_lookup,
  env_mut_escape,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  find_typedef,
  subst_apply,
  type_to_string
}

import @vibe/core {
  array_empty
}

import ./checker_trait.vibe {
  type_send_ok
}

import ./checker_resolve.vibe {
  subst_type_params
}

//# Functions

// #1081 step 3 Phase B: `Spawnable[r]` capture check for `TaskGroup::spawn` /
// `TaskGroup::spawn_suspend`. Free-variable collection duplicated here
// (rather than shared with codegen's own copy) —
// this package cannot import the root `@vibe/compiler` package (it is
// itself a dependency of the root package; importing back would be a
// package cycle), and codegen's copy lives in yet another separate
// package for its own ABI purpose. Per-package duplication of this exact
// analysis is already the established pattern in this codebase (compare
// codegen/common_analysis/common_analysis.vibe's `collect_free_vars_expr`).

fn sp_empty_strings() -> Array[String] {
  array_empty()
}

fn sp_array_contains_str(arr: Array[String], v: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn sp_add_unique(arr: Array[String], v: String) -> Unit {
  if sp_array_contains_str(arr, v) {
    ()
  } else {
    Array::push(arr, v)
  }
}

fn sp_collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      sp_collect_pat_bindings(a, out)
      sp_collect_pat_bindings(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        sp_collect_pat_bindings(fpat, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Free variables of `expr`, given the names already `bound` by enclosing
/// closure params / lets / match arms. Call callees are ordinary value uses:
/// a directly-called local closure occupies an environment slot just like a
/// closure passed as an argument. Builtins and top-level functions disappear
/// later because they have no region-bearing local binding.

fn sp_collect_free_vars_into(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match expr {
    EIdent(name, _) => if !sp_array_contains_str(bound, name) {
      sp_add_unique(out, name)
    } else {
      ()
    },
    ECall(callee, args, _) => {
      match callee {
        EIdent(_, _) => (),
        _ => sp_collect_free_vars_into(callee, bound, out)
      }
      for arg in args {
        sp_collect_free_vars_into(arg, bound, out)
      }
    },
    ELet(name, val, body, _) => {
      sp_collect_free_vars_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetMut(name, val, body, _) => {
      sp_collect_free_vars_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EAssign(name, val, cont) => {
      if !sp_array_contains_str(bound, name) {
        sp_add_unique(out, name)
      }
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(cont, bound, out)
    },
    EAssignOp(name, _, val, cont) => {
      if !sp_array_contains_str(bound, name) {
        sp_add_unique(out, name)
      }
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(cont, bound, out)
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, _) = param
        Array::push(bound, name)
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, init) = param
        sp_collect_free_vars_into(init, bound, out)
        Array::push(bound, name)
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EForIn(name, index_name, iter, body) => {
      sp_collect_free_vars_into(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index) => Array::push(bound, index),
        None => ()
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EMatch(scrutinee, arms) => {
      sp_collect_free_vars_into(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_free_vars_into(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    EHandle(scrutinee, arms) => {
      sp_collect_free_vars_into(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_free_vars_into(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        sp_collect_free_vars_into(expr_child_at(i), bound, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

fn sp_collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {
  let out = sp_empty_strings()
  sp_collect_free_vars_into(expr, bound, out)
  out
}

/// Free value names captured by a closure body. Capture provenance uses this
/// once per closure and then performs direct TypeEnv lookups, avoiding an
/// O(all visible bindings x body size) scan during self-compilation.
export fn closure_free_names(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let bound = sp_empty_strings()
  for param in params {
    let (raw_name, _) = param
    let len = String::length(raw_name)
    let name = if len > 0 {
      let last = String::char_code_at(raw_name, len - 1)
      if last == 126 || last == 63 {
        String::substring(raw_name, 0, len - 1)
      } else {
        raw_name
      }
    } else {
      raw_name
    }
    Array::push(bound, name)
  }
  sp_collect_free_vars(body, bound)
}

fn sp_collect_bare_callees(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => if !sp_array_contains_str(bound, name) {
          sp_add_unique(out, name)
        } else {
          ()
        },
        _ => sp_collect_bare_callees(callee, bound, out)
      }
      for arg in args {
        sp_collect_bare_callees(arg, bound, out)
      }
    },
    ELet(name, val, body, _) => {
      sp_collect_bare_callees(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetMut(name, val, body, _) => {
      sp_collect_bare_callees(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(val, bound, out)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, _) = param
        Array::push(bound, name)
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, init) = param
        sp_collect_bare_callees(init, bound, out)
        Array::push(bound, name)
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EForIn(name, index_name, iter, body) => {
      sp_collect_bare_callees(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index) => Array::push(bound, index),
        None => ()
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EMatch(scrutinee, arms) => {
      sp_collect_bare_callees(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_bare_callees(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    EHandle(scrutinee, arms) => {
      sp_collect_bare_callees(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_bare_callees(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        sp_collect_bare_callees(expr_child_at(i), bound, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

export fn closure_bare_callee_names(body: Expr) -> Array[String] {
  let out = sp_empty_strings()
  sp_collect_bare_callees(body, sp_empty_strings(), out)
  out
}

/// A same-region endpoint. Two shapes both count: both sides are the SAME
/// `CtNamed` region skolem (compared by name -- the skolem `#region_<n>` is
/// a plain string, see checker.vibe's `type_mentions_named`); OR both sides
/// are still the SAME unresolved `CtVar` id. The second shape is not a
/// fallback for "unknown, so assume equal" -- it is REQUIRED for
/// correctness: `TaskGroup::spawn`/`TaskGroup::spawn_suspend` are checked
/// WHILE still inside the enclosing `TaskGroup::run` body, before that
/// body's own closure has been unified against its `TaskGroup[r]` skolem
/// parameter (checker.vibe's escape check runs its `unify(CtFn(body_params,
/// ...), ...)` only AFTER the whole body is checked) -- so at spawn-check
/// time `n`'s own region is still whatever fresh var the body's untyped
/// closure parameter got, not yet the skolem itself. Two endpoints that
/// share that SAME not-yet-resolved var (both zonked through the identical
/// running Subst) are still provably the same nursery: nothing outside this
/// one `TaskGroup::run` call could have produced or observed that var, and
/// a DIFFERENT nursery's endpoint would carry a DIFFERENT var (its own
/// `TaskGroup::run` call mints its own fresh closure parameter and its own
/// skolem) or, if already resolved, a different skolem name.
fn sp_same_region(a: Type, b: Type) -> Bool {
  match (a, b) {
    (CtNamed(n1, _), CtNamed(n2, _)) => n1 == n2,
    (CtVar(v1), CtVar(v2)) => v1 == v2,
    _ => false
  }
}

fn sp_formals_has(formals: Array[Int], id: Int) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(formals) && !hit {
    hit = Array::get(formals, i) == id
    i = i + 1
  }
  hit
}

fn sp_is_stream_owning_future(s: Subst, defs: Array[TypeDef], t: Type, formals: Array[Int]) -> Bool {
  match t {
    CtNamed(n, targs) => n == "Future" && Array::length(targs) == 1 && sp_owns_host_stream(s, defs, Array::get(targs, 0), 0, formals),
    _ => false
  }
}

/// #2066: does a value of type `t` own a host stream's readable end -- a
/// `HostResponse` or `HostStream` anywhere inside it: through `Option`,
/// `Array`, tuples, records, the arguments of a named type, and the fields
/// and payloads of a declared struct or enum (Codex on #3091). The descent
/// is capped; a type too deep to finish is answered as owning, which only
/// refuses a capture. So is a type parameter of an open generic declaration
/// with no `Send` bound (`formals`): the helper is checked once, and a later
/// instantiation at `HostResponse` would share the body end with every task
/// the helper spawns (Codex on #3091). `Send` excludes a host stream, so the
/// bound is what makes such a capture sound, and the call site checks it.
fn sp_owns_host_stream(s: Subst, defs: Array[TypeDef], t: Type, depth: Int, formals: Array[Int]) -> Bool {
  if depth > 16 {
    true
  } else {
    match subst_apply(s, t) {
      CtNamed(n, targs) => if n == "HostResponse" || n == "HostStream" {
        true
      } else {
        // A declared type owns what its instantiated fields own; a type
        // argument its fields never hold (a region or effect formal of
        // `TaskGroup[rg, e]`, say) owns nothing. Only an undeclared builtin
        // (`Future[T]`, `Option`-like carriers) is judged by its arguments.
        match find_typedef(defs, n) {
          Some(_) => sp_decl_owns_host_stream(s, defs, n, targs, depth + 1, formals),
          None => sp_owns_host_stream_all(s, defs, targs, depth + 1, formals)
        }
      },
      CtVar(id) => sp_formals_has(formals, id),
      CtStruct(n) => sp_decl_owns_host_stream(s, defs, n, [], depth + 1, formals),
      CtEnum(n) => sp_decl_owns_host_stream(s, defs, n, [], depth + 1, formals),
      CtTuple(ts) => sp_owns_host_stream_all(s, defs, ts, depth + 1, formals),
      CtArray(e) => sp_owns_host_stream(s, defs, e, depth + 1, formals),
      CtOption(e) => sp_owns_host_stream(s, defs, e, depth + 1, formals),
      CtApplied(h, args) => sp_owns_host_stream(s, defs, h, depth + 1, formals) || sp_owns_host_stream_all(s, defs, args, depth + 1, formals),
      CtRecord(fields) => {
        let mut hit = false
        let mut i = 0
        while i < Array::length(fields) {
          let (_, ft) = Array::get(fields, i)
          if sp_owns_host_stream(s, defs, ft, depth + 1, formals) {
            hit = true
          } else {
            ()
          }
          i = i + 1
        }
        hit
      },
      _ => false
    }
  }
}

fn sp_owns_host_stream_all(s: Subst, defs: Array[TypeDef], ts: Array[Type], depth: Int, formals: Array[Int]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(ts) {
    if sp_owns_host_stream(s, defs, Array::get(ts, i), depth, formals) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// The fields of a declared struct, or the payloads of a declared enum's
/// variants, instantiated at `targs`.
/// Declarations being walked, keyed by name and instantiation. A recursive
/// declaration reached again at the SAME instantiation adds nothing its first
/// visit does not already examine, so it answers "owns nothing" there rather
/// than descending to the depth cap, which would count `List[Int]` as a
/// stream owner (Codex on #3091). A non-regular recursion (new arguments at
/// every level) still reaches the cap and is answered as owning.
let sp_decl_walk: Array[String] = []

fn sp_decl_walk_has(key: String) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(sp_decl_walk) && !hit {
    hit = Array::get(sp_decl_walk, i) == key
    i = i + 1
  }
  hit
}

fn sp_decl_owns_host_stream(s: Subst, defs: Array[TypeDef], name: String, targs: Array[Type], depth: Int, formals: Array[Int]) -> Bool {
  let mut key = name
  let mut ki = 0
  while ki < Array::length(targs) {
    key = String::concat(key, String::concat("|", type_to_string(subst_apply(s, Array::get(targs, ki)))))
    ki = ki + 1
  }
  if sp_decl_walk_has(key) {
    false
  } else {
    Array::push(sp_decl_walk, key)
    let owns = sp_decl_owns_host_stream_fields(s, defs, name, targs, depth, formals)
    Array::truncate(sp_decl_walk, Array::length(sp_decl_walk) - 1)
    owns
  }
}

fn sp_decl_owns_host_stream_fields(s: Subst, defs: Array[TypeDef], name: String, targs: Array[Type], depth: Int, formals: Array[Int]) -> Bool {
  match find_typedef(defs, name) {
    Some(td) => match td {
      TDStruct(_, fields, _, tparams) => {
        let mut hit = false
        let mut i = 0
        while i < Array::length(fields) {
          let (_, ft) = Array::get(fields, i)
          let inst = if Array::length(tparams) == Array::length(targs) {
            subst_type_params(ft, tparams, targs)
          } else {
            ft
          }
          if sp_owns_host_stream(s, defs, inst, depth, formals) {
            hit = true
          } else {
            ()
          }
          i = i + 1
        }
        hit
      },
      TDEnum(_, tparams, variants) => {
        let mut hit = false
        let mut vi = 0
        while vi < Array::length(variants) {
          let (_, payload) = Array::get(variants, vi)
          let mut pi = 0
          while pi < Array::length(payload) {
            let pt = Array::get(payload, pi)
            let inst = if Array::length(tparams) == Array::length(targs) {
              subst_type_params(pt, tparams, targs)
            } else {
              pt
            }
            if sp_owns_host_stream(s, defs, inst, depth, formals) {
              hit = true
            } else {
              ()
            }
            pi = pi + 1
          }
          vi = vi + 1
        }
        hit
      },
      TDAlias(_, aparams, body) => sp_owns_host_stream(s, defs, if Array::length(aparams) == Array::length(targs) {
        subst_type_params(body, aparams, targs)
      } else {
        body
      }, depth, formals),
      _ => false
    },
    None => false
  }
}

/// A capture is Spawnable-legal when it is structurally `Send`, or when it
/// is a `TaskGroup[r]` / `TaskHandle[r,_]` / `Sender[r,_]` / `Receiver[r,_]`
/// tagged with THIS spawn call's own region (`r_here`) -- an endpoint from
/// a DIFFERENT nursery is rejected exactly like any other non-Send value.
fn sp_spawnable_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, r_here: Type, formals: Array[Int]) -> Bool {
  if type_send_ok(env, s, defs, ty) {
    true
  } else {
    match ty {
      CtNamed(n, targs) => if n == "TaskGroup" && Array::length(targs) == 2 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if (n == "TaskHandle" || n == "Sender" || n == "Receiver") && Array::length(targs) == 3 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if n == "Future" && Array::length(targs) == 1 {
        // ADR-0089 D2 (#1218): a `Future[T]` cell is a communication
        // endpoint like Sender/Receiver -- one task awaits it, a sibling
        // resolves it -- but the builtin phantom carries NO region
        // parameter, so the same-nursery comparison the other endpoints
        // get is not expressible for it. Allowing the capture is sound
        // under the current poll model: the cell is plain shared memory
        // with zero scheduler coupling (awaiting re-reads the state slot
        // through `__aw_poll`; resolving is two stores), and the guest is
        // single-threaded, so no cross-nursery hazard exists that Send
        // would prevent. When the cell gains a scheduler-visible waiter
        // list (the waitable/completion-order slice), `Future` should
        // grow a region tag and join the sp_same_region branch above.
        //
        // #2066: except a future whose VALUE owns a host stream. A
        // `HostResponse` carries its body's one readable end, so every task
        // that awaits a shared response future would be handed that same
        // end; once one drains or closes it, another reads a dropped -- or
        // reused -- handle (Codex on #3091). Like a `HostStream`, it has one
        // owner: the task that makes the request.
        !sp_owns_host_stream(s, defs, Array::get(targs, 0), 0, formals)
      } else {
        false
      },
      _ => false
    }
  }
}

/// Entry point: given the closure literal passed as the second argument to
/// `TaskGroup::spawn`/`TaskGroup::spawn_suspend` and the ALREADY-ZONKED
/// region argument of the `n: TaskGroup[r_here]` passed as the first, check
/// every captured free variable and return one error message per violation
/// (empty when the check passes). A non-literal closure argument (`let f =
/// ...; TaskGroup::spawn(n, f)`) is opaque to this analysis and tolerated --
/// same documented-gap shape as the region-escape check's alias bypass.
export fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type, formals: Array[Int]) -> Array[String] {
  match f_expr {
    EFn(_, _, params, _, _, body) => {
      let pnames = sp_empty_strings()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(pnames, pname)
        i = i + 1
      }
      let free = sp_collect_free_vars(body, pnames)
      let out = sp_empty_strings()
      let mut fi = 0
      while fi < Array::length(free) {
        let vname = Array::get(free, fi)
        match env_mut_escape(env, vname) {
          // #1262: `type_send_ok` judges the captured value's TYPE alone, so a
          // `let mut counter = 0` captured by a spawn closure used to pass as
          // a plain Send `Int` -- docs/internal/design/concurrency.md lists "captured `let
          // mut`" as never Send, independent of type, because sharing a
          // mutable cell across the spawn boundary is exactly what
          // `Spawnable[r]` exists to forbid. This used to need a whole second
          // AST walk (`check_spawnable_mut_captures_stmts`) because `TypeEnv`
          // carried no mutability; ADR-0100 (1) put the fact in the env, so
          // the judgment is now one lookup at the very scope the capture
          // happens in -- shadowing is exact by construction rather than by a
          // hand-threaded visible-name list.
          Some(_) => Array::push(out, String::concat("no impl `Spawnable` for a `let mut` binding: capture `", String::concat(vname, "` shares a mutable cell across the spawn boundary"))),
          None => ()
        }
        match env_lookup(env, vname) {
          Some(vty) => {
            let resolved = subst_apply(s, vty)
            if sp_spawnable_ok(env, s, defs, resolved, r_here, formals) {
              ()
            } else if sp_is_stream_owning_future(s, defs, resolved, formals) && !sp_is_stream_owning_future(s, defs, resolved, [
            ]) {
              Array::push(out, String::concat("capture `", String::concat(vname, "` is a future whose value type is a type parameter with no `Send` bound; it may be instantiated at a host response, whose body only one task may read: add `Send` to that type parameter's bounds, or start the future inside the spawned task")))
            } else if sp_is_stream_owning_future(s, defs, resolved, formals) {
              Array::push(out, String::concat("capture `", String::concat(vname, "` is a future whose value owns a host stream (a response body), which only one task may read: start the request inside the spawned task and await it there, rather than sharing the future")))
            } else {
              Array::push(out, String::concat("no impl `Spawnable` for `", String::concat(type_to_string(resolved), String::concat("`: capture `", String::concat(vname, "` is neither Send nor a same-nursery endpoint")))))
            }
          },
          // Not a real value binding in scope (shouldn't happen for a
          // genuine capture -- e.g. a name resolved only via a builtin
          // table or trait-method dispatch, which sp_collect_free_vars's
          // callee-position exclusion should already keep out). Tolerate.
          None => ()
        }
        fi = fi + 1
      }
      out
    },
    // #2066: a closure that is not a literal here -- a name bound to one, a
    // call returning one -- hides its captures from this check. For most
    // values that is the documented gap above; for a value that owns a host
    // stream it would hand one body end to every task spawned with the
    // closure (Codex on #3091). So when such a value is visible here, the
    // spawn is refused and the message names the edit.
    _ => {
      // Concrete owners only: a formal payload in scope is judged where a
      // literal captures it, not on every named-closure spawn.
      let owner = sp_visible_stream_owner(env, s, defs, [])
      if owner == "" {
        sp_empty_strings()
      } else {
        [
          String::concat("this spawn takes a closure that is not written here, while `", String::concat(owner, "` owns a host stream (a response body) that only one task may read, and the closure may capture it: pass the closure literal itself to the spawn so its captures can be checked"))
        ]
      }
    }
  }
}

/// The name of a visible binding whose value owns a host stream, or "".
fn sp_visible_stream_owner(env: TypeEnv, s: Subst, defs: Array[TypeDef], formals: Array[Int]) -> String {
  // `formals` is threaded for the walk's signature; the caller passes none.
  let bindings = env_flat_bindings(env)
  let mut found = ""
  let mut i = 0
  while i < Array::length(bindings) && found == "" {
    let (name, ty) = Array::get(bindings, i)
    if sp_owns_host_stream(s, defs, ty, 0, formals) {
      found = name
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// #1262 / ADR-0100 (1) -- HISTORY, and why the walk that used to live here is
// gone.
//
// `type_send_ok` judges structural TYPE alone, so `let mut counter = 0;
// TaskGroup::spawn(n, () -> { counter += 1; 0 })` captures a `CtInt` (Send)
// with no record that its BINDING is mutable. `TypeEnv` carried no mutability
// flag at all (`EnvBind(String, Type, TypeEnv)`), so the fix at the time was a
// SECOND, purely syntactic pass (`check_spawnable_mut_captures_stmts`) that
// re-walked every top-level declaration threading a hand-maintained list of
// the `let mut` names visible at each point. Three Codex review rounds went
// into getting that list right: PR #1151 (anchor on the whole enclosing
// declaration, not the `TaskGroup::run` argument, or a `let mut` declared
// before the call is invisible) and PR #1152 (thread a SCOPED list rather than
// a flat whole-declaration set, or an unrelated `let mut x` in a sibling
// closure makes every other `x` look mutable). A third copy of the judgment,
// the root package's checker_capture.vibe, was dead AND defective and was
// deleted in #1262.
//
// ADR-0100 (1) put the escape fact in `TypeEnv` itself (`env_bind_mut` /
// `env_mut_escape`, recorded by the checker at each `ELetMut` from
// checker_escape.vibe's strict predicate), so the judgment above is now a
// single lookup in the env that is live AT the capture. Scope precision --
// the thing all three review rounds were about -- is then a property of the
// env chain rather than of a walker that has to re-derive it, and the walk
// was removed along with its ~230 lines. Two live judgments remain, and they
// still differ ON PURPOSE: this strict one (enforcement: stay silent when
// unsure) and codegen's conservative `is_mut_captured_in` (lowering: box when
// unsure), surfaced as `vibe escapes` / `vibe escapes --strict`. See
// docs/internal/design/side-effect-consolidation.md 4.5.
//
// Two limits carried over unchanged. A mutable binding captured by a HELPER
// FUNCTION that itself calls `TaskGroup::spawn` is interprocedural and still
// not detected. And the check now rides the same branch as the Send/region
// judgment in checker.vibe, so it needs `n` to have resolved to a
// `TaskGroup[r, _]` -- a program whose nursery argument does not typecheck
// reports that error instead.
