//# Imports

import @vibe/compiler/core {
  Expr,
  Pat,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_lookup,
  env_mut_escape,
  env_name_index_find,
  expr_child_at,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  subst_apply,
  type_to_string
}

import @vibe/core {
  array_empty
}

import ./checker_trait.vibe {
  type_send_ok
}

//# Functions

// #1081 step 3 Phase B: `Spawnable[r]` capture check for `TaskGroup::spawn` /
// `TaskGroup::spawn_suspend`. Free-variable collection duplicated here
// (rather than shared with codegen's own copy) —
// this package cannot import the root `@vibe/compiler` package (it is
// itself a dependency of the root package; importing back would be a
// package cycle), and codegen's copy lives in yet another separate
// package for its own ABI purpose. Per-package duplication of this exact
// analysis is already the established pattern in this codebase (compare
// codegen/common_analysis/common_analysis.vibe's `collect_free_vars_expr`).

fn sp_empty_strings() -> Array[String] {
  array_empty()
}

fn sp_array_contains_str(arr: Array[String], v: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn sp_add_unique(arr: Array[String], v: String) -> Unit {
  if sp_array_contains_str(arr, v) {
    ()
  } else {
    Array::push(arr, v)
  }
}

fn sp_collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      sp_collect_pat_bindings(a, out)
      sp_collect_pat_bindings(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        sp_collect_pat_bindings(fpat, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Free variables of `expr`, given the names already `bound` by enclosing
/// closure params / lets / match arms. Call callees are ordinary value uses:
/// a directly-called local closure occupies an environment slot just like a
/// closure passed as an argument. Builtins and top-level functions disappear
/// later because they have no region-bearing local binding.

fn sp_collect_free_vars_into(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match expr {
    EIdent(name, _) => if !sp_array_contains_str(bound, name) {
      sp_add_unique(out, name)
    } else {
      ()
    },
    ECall(callee, args, _) => {
      match callee {
        EIdent(_, _) => (),
        _ => sp_collect_free_vars_into(callee, bound, out)
      }
      for arg in args {
        sp_collect_free_vars_into(arg, bound, out)
      }
    },
    ELet(name, val, body, _) => {
      sp_collect_free_vars_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetMut(name, val, body, _) => {
      sp_collect_free_vars_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EAssign(name, val, cont) => {
      if !sp_array_contains_str(bound, name) {
        sp_add_unique(out, name)
      }
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(cont, bound, out)
    },
    EAssignOp(name, _, val, cont) => {
      if !sp_array_contains_str(bound, name) {
        sp_add_unique(out, name)
      }
      sp_collect_free_vars_into(val, bound, out)
      sp_collect_free_vars_into(cont, bound, out)
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, _) = param
        Array::push(bound, sp_param_base(name))
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, init) = param
        sp_collect_free_vars_into(init, bound, out)
        Array::push(bound, name)
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EForIn(name, index_name, iter, body) => {
      sp_collect_free_vars_into(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index) => Array::push(bound, index),
        None => ()
      }
      sp_collect_free_vars_into(body, bound, out)
      Array::truncate(bound, mark)
    },
    EMatch(scrutinee, arms) => {
      sp_collect_free_vars_into(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_free_vars_into(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    EHandle(scrutinee, arms) => {
      sp_collect_free_vars_into(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_free_vars_into(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        sp_collect_free_vars_into(expr_child_at(i), bound, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

fn sp_collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {
  let out = sp_empty_strings()
  sp_collect_free_vars_into(expr, bound, out)
  out
}

/// A labeled (`x~`) or optional (`x?`) parameter keeps its marker on the
/// name; the body and the environment bind the bare name.
fn sp_param_base(raw_name: String) -> String {
  let len = String::length(raw_name)
  if len > 0 {
    let last = String::char_code_at(raw_name, len - 1)
    if last == 126 || last == 63 {
      String::substring(raw_name, 0, len - 1)
    } else {
      raw_name
    }
  } else {
    raw_name
  }
}

/// Free value names captured by a closure body. Capture provenance uses this
/// once per closure and then performs direct TypeEnv lookups, avoiding an
/// O(all visible bindings x body size) scan during self-compilation.
export fn closure_free_names(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let bound = sp_empty_strings()
  for param in params {
    let (raw_name, _) = param
    Array::push(bound, sp_param_base(raw_name))
  }
  sp_collect_free_vars(body, bound)
}

fn sp_collect_bare_callees(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => if !sp_array_contains_str(bound, name) {
          sp_add_unique(out, name)
        } else {
          ()
        },
        _ => sp_collect_bare_callees(callee, bound, out)
      }
      for arg in args {
        sp_collect_bare_callees(arg, bound, out)
      }
    },
    ELet(name, val, body, _) => {
      sp_collect_bare_callees(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetMut(name, val, body, _) => {
      sp_collect_bare_callees(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      sp_collect_bare_callees(val, bound, out)
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, _) = param
        Array::push(bound, sp_param_base(name))
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      for param in params {
        let (name, init) = param
        sp_collect_bare_callees(init, bound, out)
        Array::push(bound, name)
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EForIn(name, index_name, iter, body) => {
      sp_collect_bare_callees(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index) => Array::push(bound, index),
        None => ()
      }
      sp_collect_bare_callees(body, bound, out)
      Array::truncate(bound, mark)
    },
    EMatch(scrutinee, arms) => {
      sp_collect_bare_callees(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_bare_callees(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    EHandle(scrutinee, arms) => {
      sp_collect_bare_callees(scrutinee, bound, out)
      for arm in arms {
        let (pat, body) = arm
        let mark = Array::length(bound)
        sp_collect_pat_bindings(pat, bound)
        sp_collect_bare_callees(body, bound, out)
        Array::truncate(bound, mark)
      }
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        sp_collect_bare_callees(expr_child_at(i), bound, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
  ()
}

export fn closure_bare_callee_names(body: Expr) -> Array[String] {
  let out = sp_empty_strings()
  sp_collect_bare_callees(body, sp_empty_strings(), out)
  out
}

/// A same-region endpoint. Two shapes both count: both sides are the SAME
/// `CtNamed` region skolem (compared by name -- the skolem `#region_<n>` is
/// a plain string, see checker.vibe's `type_mentions_named`); OR both sides
/// are still the SAME unresolved `CtVar` id. The second shape is not a
/// fallback for "unknown, so assume equal" -- it is REQUIRED for
/// correctness: `TaskGroup::spawn`/`TaskGroup::spawn_suspend` are checked
/// WHILE still inside the enclosing `TaskGroup::run` body, before that
/// body's own closure has been unified against its `TaskGroup[r]` skolem
/// parameter (checker.vibe's escape check runs its `unify(CtFn(body_params,
/// ...), ...)` only AFTER the whole body is checked) -- so at spawn-check
/// time `n`'s own region is still whatever fresh var the body's untyped
/// closure parameter got, not yet the skolem itself. Two endpoints that
/// share that SAME not-yet-resolved var (both zonked through the identical
/// running Subst) are still provably the same nursery: nothing outside this
/// one `TaskGroup::run` call could have produced or observed that var, and
/// a DIFFERENT nursery's endpoint would carry a DIFFERENT var (its own
/// `TaskGroup::run` call mints its own fresh closure parameter and its own
/// skolem) or, if already resolved, a different skolem name.
fn sp_same_region(a: Type, b: Type) -> Bool {
  match (a, b) {
    (CtNamed(n1, _), CtNamed(n2, _)) => n1 == n2,
    (CtVar(v1), CtVar(v2)) => v1 == v2,
    _ => false
  }
}

/// A capture is Spawnable-legal when it is structurally `Send`, or when it
/// is a `TaskGroup[r]` / `TaskHandle[r,_]` / `Sender[r,_]` / `Receiver[r,_]`
/// tagged with THIS spawn call's own region (`r_here`) -- an endpoint from
/// a DIFFERENT nursery is rejected exactly like any other non-Send value.
fn sp_spawnable_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, r_here: Type) -> Bool {
  if type_send_ok(env, s, defs, ty) {
    true
  } else {
    match ty {
      CtNamed(n, targs) => if n == "TaskGroup" && Array::length(targs) == 2 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if (n == "TaskHandle" || n == "Sender" || n == "Receiver") && Array::length(targs) == 3 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if n == "Future" && Array::length(targs) == 1 {
        // ADR-0089 D2 (#1218): a `Future[T]` cell is a communication
        // endpoint like Sender/Receiver -- one task awaits it, a sibling
        // resolves it -- but the builtin phantom carries NO region
        // parameter, so the same-nursery comparison the other endpoints
        // get is not expressible for it. Allowing the capture is sound
        // under the current poll model: the cell is plain shared memory
        // with zero scheduler coupling (awaiting re-reads the state slot
        // through `__aw_poll`; resolving is two stores), and the guest is
        // single-threaded, so no cross-nursery hazard exists that Send
        // would prevent. When the cell gains a scheduler-visible waiter
        // list (the waitable/completion-order slice), `Future` should
        // grow a region tag and join the sp_same_region branch above.
        true
      } else {
        false
      },
      _ => false
    }
  }
}

// #3152: what the `Spawnable` check knows about a closure VALUE.
//
// A closure type carries no record of what it captured, so a closure the check
// cannot see as a literal used to pass unexamined (`let g = () -> xs;
// TaskGroup::spawn(n, g)` ran a capture of a plain `Array`). The check now
// accepts exactly three kinds of closure value, and refuses the rest:
//
//   1. a closure LITERAL at the call -- its captures are read directly;
//   2. a name bound by a local `let` to a closure literal -- its captures were
//      recorded when the `let` was checked, under `spawn_caps_marker`,
//      in the environment the literal was written in;
//   3. a name that cannot capture anything: a top-level function, or the
//      closure PARAMETER of a spawn-shaped function (`spawn_safe_marker`),
//      whose every call site is itself checked this way.
//
// A captured closure is judged the same way, so a local closure CALLED inside
// the spawned body (`() -> cb()`) is a capture too; it used to be skipped as a
// bare callee.
//
// Both markers are laid IN FRONT of the binding they describe, the way
// `env_bind_mut` lays `EnvMutCell`, so a later rebinding of the same name
// (a parameter, an inner `let`) sits in front of the marker and hides it:
// `env_marker_before` answers for the binding that is actually in scope.

/// Marker name for the recorded captures of the local `let` closure `name`.
export fn spawn_caps_marker(name: String) -> String {
  String::concat("#spawn_caps:", name)
}

/// Marker name for `name` as the closure parameter of a spawn-shaped function.
export fn spawn_safe_marker(name: String) -> String {
  String::concat("#spawn_safe:", name)
}

/// The marker `marker` when it is bound in front of every binding of `name`;
/// `None` when `name` is bound first, or neither is bound locally.
export fn env_marker_before(env: TypeEnv, marker: String, name: String) -> Option[Type] {
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, binding, rest) => if String::equals(n, marker) {
        result = Some(binding.ty)
        done = true
      } else if String::equals(n, name) {
        done = true
      } else {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      // The import cache stays at the HEAD of the chain and later bindings
      // are tucked under it unless they shadow one of its names
      // (`env_bind_with_origin`), so it is looked through, and a cached
      // `name` answers "bound, and not by a marked local".
      EnvCached(index, _, rest) => if env_name_index_find(index, name) >= 0 {
        done = true
      } else {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  result
}

/// Whether `name` resolves to a binding made inside some function body: a
/// `__capture_boundary__` (bound on entry to every function) lies behind it.
/// A top-level or imported name has no boundary behind it.
export fn env_name_is_local(env: TypeEnv, name: String) -> Bool {
  let mut cur = env
  let mut found = false
  let mut local = false
  let mut done = false
  while !done {
    match cur {
      EnvBind(n, _, rest) => {
        if found && String::equals(n, "__capture_boundary__") {
          local = true
          done = true
        } else if !found && String::equals(n, name) {
          found = true
        } else {
          ()
        }
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      // A name found in the import cache is an import, so not local; the
      // cache is otherwise looked through (see `env_marker_before`).
      EnvCached(index, _, rest) => if !found && env_name_index_find(index, name) >= 0 {
        done = true
      } else {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  local
}

fn sp_is_top_level_function(env: TypeEnv, name: String) -> Bool {
  match env_lookup(env, name) {
    Some(vty) => sp_is_function_type(vty) && !env_name_is_local(env, name),
    None => false
  }
}

fn sp_is_function_type(ty: Type) -> Bool {
  match ty {
    CtFn(_, _, _) => true,
    CtForAll(_, _, body) => sp_is_function_type(body),
    _ => false
  }
}

/// Append the capture facts for `name` as seen from `env`. A fact is a
/// `CtNamed` whose name is a one-letter kind, `:`, and the captured name:
/// `v:` a value of the carried type, `m:` a `let mut` cell shared across the
/// boundary, `p:` the checked closure parameter of a spawn-shaped function.
/// A captured local `let` closure contributes its own recorded facts instead.
fn sp_push_capture_facts(env: TypeEnv, name: String, out: Array[Type]) -> Unit {
  match env_mut_escape(env, name) {
    Some(_) => Array::push(out, CtNamed(String::concat("m:", name), [])),
    None => ()
  }
  match env_marker_before(env, spawn_safe_marker(name), name) {
    Some(_) => Array::push(out, CtNamed(String::concat("p:", name), [])),
    None => match env_marker_before(env, spawn_caps_marker(name), name) {
      Some(CtTuple(facts)) => {
        let mut fi = 0
        while fi < Array::length(facts) {
          Array::push(out, Array::get(facts, fi))
          fi = fi + 1
        }
      },
      _ => match env_lookup(env, name) {
        Some(vty) => if sp_is_top_level_function(env, name) {
          // A top-level function captures nothing.
          ()
        } else {
          Array::push(out, CtNamed(String::concat("v:", name), [vty]))
        },
        // Not a value binding in scope (a builtin, a constructor): nothing
        // is captured.
        None => ()
      }
    }
  }
}

/// The capture facts of a closure literal written in `env`. Values read by
/// name and LOCAL closures called by name are both captures; a bare callee
/// that is not a local binding (a top-level function, a builtin) is not.
export fn closure_capture_facts(env: TypeEnv, body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[Type] {
  let pnames = sp_empty_strings()
  for param in params {
    let (pname, _) = param
    Array::push(pnames, sp_param_base(pname))
  }
  let names = sp_collect_free_vars(body, pnames)
  let callees = sp_empty_strings()
  sp_collect_bare_callees(body, pnames, callees)
  for callee in callees {
    if !sp_array_contains_str(names, callee) && env_name_is_local(env, callee) {
      Array::push(names, callee)
    } else {
      ()
    }
  }
  let out = array_empty()
  for name in names {
    sp_push_capture_facts(env, name, out)
  }
  out
}

fn sp_fact_name(fact_name: String) -> String {
  String::substring(fact_name, 2, String::length(fact_name))
}

/// Judge recorded capture facts against THIS spawn call's region.
fn sp_judge_facts(env: TypeEnv, s: Subst, defs: Array[TypeDef], facts: Array[Type], r_here: Type) -> Array[String] {
  let out = sp_empty_strings()
  for fact in facts {
    match fact {
      CtNamed(tagged, targs) => {
        let vname = sp_fact_name(tagged)
        if String::starts_with(tagged, "m:") {
          // #1262: `type_send_ok` judges the captured value's TYPE alone, so
          // a captured `let mut` needs its own verdict: sharing a mutable
          // cell across the spawn boundary is what `Spawnable[r]` forbids,
          // whatever the cell holds (ADR-0100 (1) put the fact in the env).
          Array::push(out, String::concat("no impl `Spawnable` for a `let mut` binding: capture `", String::concat(vname, "` shares a mutable cell across the spawn boundary")))
        } else if String::starts_with(tagged, "v:") && Array::length(targs) == 1 {
          let resolved = subst_apply(s, Array::get(targs, 0))
          if sp_spawnable_ok(env, s, defs, resolved, r_here) {
            ()
          } else {
            Array::push(out, String::concat("no impl `Spawnable` for `", String::concat(type_to_string(resolved), String::concat("`: capture `", String::concat(vname, "` is neither Send nor a same-nursery endpoint")))))
          }
        } else {
          // `p:` -- checked at the enclosing function's own call sites.
          ()
        }
      },
      _ => ()
    }
  }
  out
}

/// Entry point: the closure argument of a spawn-shaped call (`TaskGroup::spawn`,
/// `TaskGroup::spawn_suspend`, `Parallel::map`, a wrapper with the same shape)
/// and the ALREADY-ZONKED region argument of its `TaskGroup[r_here, _]`.
/// Returns one message per violation, empty when the check passes. A closure
/// value whose captures cannot be seen is refused rather than trusted (#3152).
export fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String] {
  match f_expr {
    EFn(_, _, params, _, _, body) => sp_judge_facts(env, s, defs, closure_capture_facts(env, body, params), r_here),
    EIdent(name, _) => match env_marker_before(env, spawn_safe_marker(name), name) {
      Some(_) => sp_empty_strings(),
      None => match env_marker_before(env, spawn_caps_marker(name), name) {
        Some(CtTuple(facts)) => sp_judge_facts(env, s, defs, facts, r_here),
        _ => if sp_is_top_level_function(env, name) {
          // A top-level function captures nothing.
          sp_empty_strings()
        } else {
          [
            String::concat("no impl `Spawnable` for closure `", String::concat(name, "`: its captures cannot be seen here -- write the closure literally at this call, or bind it with a local `let` to a closure literal"))
          ]
        }
      }
    },
    _ => [
      "no impl `Spawnable` for this closure argument: its captures cannot be seen here -- write the closure literally at this call, or bind it with a local `let` to a closure literal"
    ]
  }
}

// #1262 / ADR-0100 (1) -- HISTORY, and why the walk that used to live here is
// gone.
//
// `type_send_ok` judges structural TYPE alone, so `let mut counter = 0;
// TaskGroup::spawn(n, () -> { counter += 1; 0 })` captures a `CtInt` (Send)
// with no record that its BINDING is mutable. `TypeEnv` carried no mutability
// flag at all (`EnvBind(String, Type, TypeEnv)`), so the fix at the time was a
// SECOND, purely syntactic pass (`check_spawnable_mut_captures_stmts`) that
// re-walked every top-level declaration threading a hand-maintained list of
// the `let mut` names visible at each point. Three Codex review rounds went
// into getting that list right: PR #1151 (anchor on the whole enclosing
// declaration, not the `TaskGroup::run` argument, or a `let mut` declared
// before the call is invisible) and PR #1152 (thread a SCOPED list rather than
// a flat whole-declaration set, or an unrelated `let mut x` in a sibling
// closure makes every other `x` look mutable). A third copy of the judgment,
// the root package's checker_capture.vibe, was dead AND defective and was
// deleted in #1262.
//
// ADR-0100 (1) put the escape fact in `TypeEnv` itself (`env_bind_mut` /
// `env_mut_escape`, recorded by the checker at each `ELetMut` from
// checker_escape.vibe's strict predicate), so the judgment above is now a
// single lookup in the env that is live AT the capture. Scope precision --
// the thing all three review rounds were about -- is then a property of the
// env chain rather than of a walker that has to re-derive it, and the walk
// was removed along with its ~230 lines. Two live judgments remain, and they
// still differ ON PURPOSE: this strict one (enforcement: stay silent when
// unsure) and codegen's conservative `is_mut_captured_in` (lowering: box when
// unsure), surfaced as `vibe escapes` / `vibe escapes --strict`. See
// docs/internal/design/side-effect-consolidation.md 4.5.
//
// A mutable binding reached through a HELPER FUNCTION that itself calls
// `TaskGroup::spawn` is covered since #3152: the helper's closure parameter is
// either the checked parameter of a spawn-shaped function (its callers are
// checked) or a closure value the check cannot see, which is refused. The
// check still rides the same branch as the Send/region
// judgment in checker.vibe, so it needs `n` to have resolved to a
// `TaskGroup[r, _]` -- a program whose nursery argument does not typecheck
// reports that error instead.
