//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, env_lookup, subst_apply, type_to_string
}

import @vibe/core {
  array_empty
}

import ./checker_trait.vibe {
  type_send_ok
}

//# Functions

// #1081 step 3 Phase B: `Spawnable[r]` capture check for `TaskGroup::spawn` /
// `TaskGroup::spawn_suspend`. Free-variable collection duplicated here
// (rather than shared with codegen's own copy) —
// this package cannot import the root `@vibe/compiler` package (it is
// itself a dependency of the root package; importing back would be a
// package cycle), and codegen's copy lives in yet another separate
// package for its own ABI purpose. Per-package duplication of this exact
// analysis is already the established pattern in this codebase (compare
// codegen/common_analysis/common_analysis.vibe's `collect_free_vars_expr`).

fn sp_empty_strings() -> Array[String] {
  array_empty()
}

fn sp_array_contains_str(arr: Array[String], v: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn sp_add_unique(arr: Array[String], v: String) -> Unit {
  if sp_array_contains_str(arr, v) {
    ()
  } else {
    Array::push(arr, v)
  }
}

fn sp_append_all(dst: Array[String], src: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn sp_clone_strings(items: Array[String]) -> Array[String] {
  let out = sp_empty_strings()
  sp_append_all(out, items)
  out
}

fn sp_bound_with(bound: Array[String], extras: Array[String]) -> Array[String] {
  let out = sp_clone_strings(bound)
  sp_append_all(out, extras)
  out
}

fn sp_bound_with_one(bound: Array[String], name: String) -> Array[String] {
  let out = sp_clone_strings(bound)
  Array::push(out, name)
  out
}

fn sp_collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        sp_collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      sp_collect_pat_bindings(a, out)
      sp_collect_pat_bindings(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        sp_collect_pat_bindings(fpat, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Free variables of `expr`, given the names already `bound` by enclosing
/// closure params / lets / match arms. A call's CALLEE, when it is a bare
/// identifier, is NOT counted as a capture: it is either a compiler
/// builtin (`Array::set`), a top-level function (`helper()`), or a
/// constructor (`Some(x)`) -- none of these need an environment slot
/// captured at runtime. This intentionally also excludes a directly-called
/// LOCAL closure variable (`let cb = ...; TaskGroup::spawn(n, () -> {
/// cb() })`) from capture analysis -- a documented, accepted gap (this
/// checker has no indirect-call capture analysis yet), matching the
/// project's existing precedent for this class of limitation (see
/// TaskGroup::run's alias-bypass gap, checker.vibe). A callee that is NOT a
/// bare identifier (`EDot` receiver, `ECall` result, ...) is walked
/// normally -- `sender.send_wait(v)` still captures `sender` via the EDot
/// arm below.
fn sp_collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {
  let result = sp_empty_strings()
  match expr {
    EIdent(name, _) => {
      if sp_array_contains_str(bound, name) {
        ()
      } else {
        sp_add_unique(result, name)
      }
      result
    },
    EInt(_) => result,
    EFloat(_) => result,
    EString(_) => result,
    EBool(_) => result,
    EUnit => result,
    ELet(name, val, body, _) => {
      sp_append_all(result, sp_collect_free_vars(val, bound))
      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))
      result
    },
    ELetRec(name, val, body) => {
      let nb = sp_bound_with_one(bound, name)
      sp_append_all(result, sp_collect_free_vars(val, nb))
      sp_append_all(result, sp_collect_free_vars(body, nb))
      result
    },
    ELetMut(name, val, body, _) => {
      sp_append_all(result, sp_collect_free_vars(val, bound))
      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))
      result
    },
    EAssign(name, val, cont) => {
      if sp_array_contains_str(bound, name) {
        ()
      } else {
        sp_add_unique(result, name)
      }
      sp_append_all(result, sp_collect_free_vars(val, bound))
      sp_append_all(result, sp_collect_free_vars(cont, bound))
      result
    },
    EAssignOp(name, _, val, cont) => {
      if sp_array_contains_str(bound, name) {
        ()
      } else {
        sp_add_unique(result, name)
      }
      sp_append_all(result, sp_collect_free_vars(val, bound))
      sp_append_all(result, sp_collect_free_vars(cont, bound))
      result
    },
    EFn(_, _, params, _, _, body) => {
      let pnames = sp_empty_strings()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(pnames, pname)
        i = i + 1
      }
      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with(bound, pnames)))
      result
    },
    ECall(callee, args, _) => {
      match callee {
        EIdent(_, _) => (),
        _ => sp_append_all(result, sp_collect_free_vars(callee, bound))
      }
      let mut i = 0
      while i < Array::length(args) {
        sp_append_all(result, sp_collect_free_vars(Array::get(args, i), bound))
        i = i + 1
      }
      result
    },
    EIf(cond, then_e, else_e) => {
      sp_append_all(result, sp_collect_free_vars(cond, bound))
      sp_append_all(result, sp_collect_free_vars(then_e, bound))
      sp_append_all(result, sp_collect_free_vars(else_e, bound))
      result
    },
    ESeq(a, b) => {
      sp_append_all(result, sp_collect_free_vars(a, bound))
      sp_append_all(result, sp_collect_free_vars(b, bound))
      result
    },
    EBinOp(_, left, right) => {
      sp_append_all(result, sp_collect_free_vars(left, bound))
      sp_append_all(result, sp_collect_free_vars(right, bound))
      result
    },
    EUnaryOp(_, operand) => {
      sp_append_all(result, sp_collect_free_vars(operand, bound))
      result
    },
    EWhile(cond, body) => {
      sp_append_all(result, sp_collect_free_vars(cond, bound))
      sp_append_all(result, sp_collect_free_vars(body, bound))
      result
    },
    ELoop(params, body) => {
      let mut b2 = sp_clone_strings(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        sp_append_all(result, sp_collect_free_vars(init, b2))
        b2 = sp_bound_with_one(b2, name)
        i = i + 1
      }
      sp_append_all(result, sp_collect_free_vars(body, b2))
      result
    },
    EForIn(name, index_name, iter, body) => {
      sp_append_all(result, sp_collect_free_vars(iter, bound))
      let b2 = sp_bound_with_one(bound, name)
      let b3 = match index_name {
        Some(ixn) => sp_bound_with_one(b2, ixn),
        None => b2
      }
      sp_append_all(result, sp_collect_free_vars(body, b3))
      result
    },
    EMatch(scrut, arms) => {
      sp_append_all(result, sp_collect_free_vars(scrut, bound))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = sp_empty_strings()
        sp_collect_pat_bindings(pat, pat_binds)
        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    EHandle(body, arms) => {
      sp_append_all(result, sp_collect_free_vars(body, bound))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = sp_empty_strings()
        sp_collect_pat_bindings(pat, pat_binds)
        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))
        i = i + 1
      }
      result
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))
        i = i + 1
      }
      result
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        sp_append_all(result, sp_collect_free_vars(fval, bound))
        i = i + 1
      }
      result
    },
    EDot(obj, _, _, _) => {
      sp_append_all(result, sp_collect_free_vars(obj, bound))
      result
    },
    EReturn(e) => {
      sp_append_all(result, sp_collect_free_vars(e, bound))
      result
    },
    ELabeledArg(_, _, e) => {
      sp_append_all(result, sp_collect_free_vars(e, bound))
      result
    },
    EBreak(opt) => {
      match opt {
        Some(e) => sp_append_all(result, sp_collect_free_vars(e, bound)),
        None => ()
      }
      result
    },
    EContinue(exprs) => {
      let mut i = 0
      while i < Array::length(exprs) {
        sp_append_all(result, sp_collect_free_vars(Array::get(exprs, i), bound))
        i = i + 1
      }
      result
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        sp_append_all(result, sp_collect_free_vars(fval, bound))
        i = i + 1
      }
      result
    },
    ESpread(e) => {
      sp_append_all(result, sp_collect_free_vars(e, bound))
      result
    },
    EStringInterp(_) => result
  }
}

/// A same-region endpoint. Two shapes both count: both sides are the SAME
/// `CtNamed` region skolem (compared by name -- the skolem `#region_<n>` is
/// a plain string, see checker.vibe's `type_mentions_named`); OR both sides
/// are still the SAME unresolved `CtVar` id. The second shape is not a
/// fallback for "unknown, so assume equal" -- it is REQUIRED for
/// correctness: `TaskGroup::spawn`/`TaskGroup::spawn_suspend` are checked
/// WHILE still inside the enclosing `TaskGroup::run` body, before that
/// body's own closure has been unified against its `TaskGroup[r]` skolem
/// parameter (checker.vibe's escape check runs its `unify(CtFn(body_params,
/// ...), ...)` only AFTER the whole body is checked) -- so at spawn-check
/// time `n`'s own region is still whatever fresh var the body's untyped
/// closure parameter got, not yet the skolem itself. Two endpoints that
/// share that SAME not-yet-resolved var (both zonked through the identical
/// running Subst) are still provably the same nursery: nothing outside this
/// one `TaskGroup::run` call could have produced or observed that var, and
/// a DIFFERENT nursery's endpoint would carry a DIFFERENT var (its own
/// `TaskGroup::run` call mints its own fresh closure parameter and its own
/// skolem) or, if already resolved, a different skolem name.
fn sp_same_region(a: Type, b: Type) -> Bool {
  match (a, b) {
    (CtNamed(n1, _), CtNamed(n2, _)) => n1 == n2,
    (CtVar(v1), CtVar(v2)) => v1 == v2,
    _ => false
  }
}

/// A capture is Spawnable-legal when it is structurally `Send`, or when it
/// is a `TaskGroup[r]` / `TaskHandle[r,_]` / `Sender[r,_]` / `Receiver[r,_]`
/// tagged with THIS spawn call's own region (`r_here`) -- an endpoint from
/// a DIFFERENT nursery is rejected exactly like any other non-Send value.
fn sp_spawnable_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, r_here: Type) -> Bool {
  if type_send_ok(env, s, defs, ty) {
    true
  } else {
    match ty {
      CtNamed(n, targs) => if n == "TaskGroup" && Array::length(targs) == 2 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if (n == "TaskHandle" || n == "Sender" || n == "Receiver") && Array::length(targs) == 3 {
        sp_same_region(Array::get(targs, 0), r_here)
      } else if n == "Future" && Array::length(targs) == 1 {
        // ADR-0089 D2 (#1218): a `Future[T]` cell is a communication
        // endpoint like Sender/Receiver -- one task awaits it, a sibling
        // resolves it -- but the builtin phantom carries NO region
        // parameter, so the same-nursery comparison the other endpoints
        // get is not expressible for it. Allowing the capture is sound
        // under the current poll model: the cell is plain shared memory
        // with zero scheduler coupling (awaiting re-reads the state slot
        // through `__aw_poll`; resolving is two stores), and the guest is
        // single-threaded, so no cross-nursery hazard exists that Send
        // would prevent. When the cell gains a scheduler-visible waiter
        // list (the waitable/completion-order slice), `Future` should
        // grow a region tag and join the sp_same_region branch above.
        true
      } else {
        false
      },
      _ => false
    }
  }
}

/// Entry point: given the closure literal passed as the second argument to
/// `TaskGroup::spawn`/`TaskGroup::spawn_suspend` and the ALREADY-ZONKED
/// region argument of the `n: TaskGroup[r_here]` passed as the first, check
/// every captured free variable and return one error message per violation
/// (empty when the check passes). A non-literal closure argument (`let f =
/// ...; TaskGroup::spawn(n, f)`) is opaque to this analysis and tolerated --
/// same documented-gap shape as the region-escape check's alias bypass.
export fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String] {
  match f_expr {
    EFn(_, _, params, _, _, body) => {
      let pnames = sp_empty_strings()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(pnames, pname)
        i = i + 1
      }
      let free = sp_collect_free_vars(body, pnames)
      let out = sp_empty_strings()
      let mut fi = 0
      while fi < Array::length(free) {
        let vname = Array::get(free, fi)
        match env_lookup(env, vname) {
          Some(vty) => {
            let resolved = subst_apply(s, vty)
            if sp_spawnable_ok(env, s, defs, resolved, r_here) {
              ()
            } else {
              Array::push(out, String::concat("no impl `Spawnable` for `", String::concat(type_to_string(resolved), String::concat("`: capture `", String::concat(vname, "` is neither Send nor a same-nursery endpoint")))))
            }
          },
          // Not a real value binding in scope (shouldn't happen for a
          // genuine capture -- e.g. a name resolved only via a builtin
          // table or trait-method dispatch, which sp_collect_free_vars's
          // callee-position exclusion should already keep out). Tolerate.
          None => ()
        }
        fi = fi + 1
      }
      out
    },
    _ => sp_empty_strings()
  }
}

// Codex review (PR #1150, P1): `type_send_ok` judges structural TYPE alone
// -- `let mut counter = 0; TaskGroup::spawn(n, () -> { counter += 1; 0 })`
// captures a `CtInt` (Send) with no record that its BINDING is mutable, so
// `check_spawnable_captures` above accepts it even though
// docs/concurrency.md explicitly lists "captured `let mut`" as never Send,
// independent of the captured value's type -- sharing a mutable cell
// across the spawn boundary is exactly what `Spawnable[r]` exists to
// forbid. `TypeEnv` (core/types.vibe) carries no mutability flag at all
// (`EnvBind(String, Type, TypeEnv)`). A third mutable-capture judgment used
// to live in the root package's checker_capture.vibe, but it was dead
// (unreachable from here, never wired into any check, unit-tested only) AND
// defective -- `collect_mut_bindings` handled only 5 Expr shapes and fell
// through `_` for the rest, so it never descended into `EFn` and therefore
// could not observe a closure capture at all; `analyze_captures_with_muts`
// did not subtract shadowing on `ELet`/params/patterns, the same false
// positive PR #1152 fixed here. It was removed in #1262 rather than left as
// a trap for the next person who needs this judgment; the two live ones are
// this walker and codegen's `is_mut_captured_in` (surfaced as `vibe
// escapes`, runtime/escape_spans.vibe), which differ on purpose -- see
// docs/side-effect-consolidation.md 4.5. Mutability is a purely SYNTACTIC property of the
// SOURCE, though, so no env/Subst lookup is needed at all: walk the raw
// AST, threading the set of `let mut` names actually VISIBLE at each
// point (below), and at every nested `TaskGroup::spawn`/`spawn_suspend`
// call flag any free variable of that call's closure argument that is
// still a live `let mut` name at that exact point -- independent of, and
// in addition to, `check_spawnable_captures`'s Send/same-region judgment
// above.
//
// Codex review (PR #1151, P1): the first version of this check anchored
// on the `TaskGroup::run` call's OWN closure argument, so a `let mut
// counter = 0` declared in the ENCLOSING function BEFORE calling
// `TaskGroup::run` (rather than inside the run body itself) was invisible.
// Fixed by anchoring on the WHOLE enclosing top-level declaration's body
// instead (`check_spawnable_mut_captures_stmts` below calls
// `check_spawnable_mut_captures_scope` once per top-level `fn`/`let`/
// `test`/`bench`, not once per `TaskGroup::run` call).
//
// Codex review (PR #1152, P1): that second version collected EVERY `let
// mut` name reachable ANYWHERE in the declaration into one flat,
// scope-blind list (deliberately no scope-exit removal), then
// cross-matched a spawn closure's free variables against that flat list
// by NAME ALONE. This produced false positives: an unrelated `let mut x`
// in a sibling closure (e.g. a separate `let helper = () -> { let mut x =
// 0; ... }` defined later in the same top-level declaration) made every
// OTHER, lexically-unrelated and genuinely-immutable `x` in that same
// declaration look mutable too. Fixed below by replacing the two-pass
// flat-collect-then-cross-match with a SINGLE recursive walker
// (`sp_walk_spawnable_mut`) that threads a properly SCOPED `mut_names`
// list: `ELetMut` EXTENDS it for its body; `ELet`/`ELetRec`, `EFn`
// params, `ELoop`/`EForIn` bound names, and `EMatch`/`EHandle` arm
// pattern bindings all REMOVE the shadowed name(s) for their own
// body/arm (an immutable binding that merely reuses a mutable outer name
// is not itself mutable). Each spawn call is checked against the
// `mut_names` actually visible at that exact call site, not a flattened
// whole-declaration set.
//
// Codex review (PR #1152, P2): the whole-program-pass version of this
// check also lost the `[@off=...]` source-offset marker the ORIGINAL
// per-call check (still visible in checker.vibe's `TaskGroup::spawn`
// branch, for the Send/region violations) attached via
// `off_marker_len(callee_off, ...)` -- degrading `vibe diagnostics`/LSP to
// an unlocated error for this diagnostic class. Fixed by capturing each
// spawn `ECall`'s own callee offset while walking (see
// `sp_check_spawn_mut_capture` below) and appending the same marker shape
// via a local `sp_off_marker_len` (duplicated from checker.vibe's private
// `off_marker`/`off_marker_len` -- not exported there, and importing it
// back across these two mutually-importing sibling files would be a
// needless coupling for two small pure string-formatting helpers; same
// per-file duplication convention already used above for free-variable
// collection).
//
// Still-accepted gap (not attempted): a mutable binding captured by a
// HELPER FUNCTION that itself calls `TaskGroup::spawn` -- e.g. passing
// `counter` into a separate top-level `fn helper(c) { TaskGroup::spawn(n,
// () -> { c += 1 }) }` -- is interprocedural (would need call-graph /
// alias tracking across separate top-level declarations) and out of
// scope for this purely per-declaration AST sweep.

fn sp_remove_name(names: Array[String], name: String) -> Array[String] {
  let out = sp_empty_strings()
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, i)
    if n == name {
      ()
    } else {
      Array::push(out, n)
    }
    i = i + 1
  }
  out
}

fn sp_remove_names(names: Array[String], to_remove: Array[String]) -> Array[String] {
  let mut cur = names
  let mut i = 0
  while i < Array::length(to_remove) {
    cur = sp_remove_name(cur, Array::get(to_remove, i))
    i = i + 1
  }
  cur
}

fn sp_off_marker_len(off: Int, len: Int) -> String {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// Check one `TaskGroup::spawn`/`spawn_suspend` call's closure argument
/// against the `let mut` names actually visible (properly scoped) at this
/// exact call site, appending a located violation message per offender.
fn sp_check_spawn_mut_capture(closure_expr: Expr, mut_names: Array[String], call_off: Int, name_len: Int, out: Array[String]) -> Unit {
  match closure_expr {
    EFn(_, _, params, _, _, body) => {
      let pnames = sp_empty_strings()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(pnames, pname)
        i = i + 1
      }
      let free = sp_collect_free_vars(body, pnames)
      let mut fi = 0
      while fi < Array::length(free) {
        let vname = Array::get(free, fi)
        if sp_array_contains_str(mut_names, vname) {
          Array::push(out, String::concat("no impl `Spawnable` for a `let mut` binding: capture `", String::concat(vname, String::concat("` shares a mutable cell across the spawn boundary", sp_off_marker_len(call_off, name_len)))))
        } else {
          ()
        }
        fi = fi + 1
      }
    },
    _ => ()
  }
}

fn sp_walk_spawnable_mut_binary(a: Expr, b: Expr, mut_names: Array[String], out: Array[String]) -> Unit {
  sp_walk_spawnable_mut(a, mut_names, out)
  sp_walk_spawnable_mut(b, mut_names, out)
}

fn sp_walk_spawnable_mut_list(items: Array[Expr], mut_names: Array[String], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    sp_walk_spawnable_mut(Array::get(items, i), mut_names, out)
    i = i + 1
  }
}

fn sp_walk_spawnable_mut_fields(fields: Array[(String, Expr)], mut_names: Array[String], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, fval) = Array::get(fields, i)
    sp_walk_spawnable_mut(fval, mut_names, out)
    i = i + 1
  }
}

/// The combined, scope-aware walk: `mut_names` always reflects exactly the
/// `let mut` bindings actually visible (not shadowed) at the current
/// position -- threaded the same way `sp_collect_free_vars` threads
/// `bound`, except `ELet`/`ELetRec`/`EFn` params/pattern bindings REMOVE a
/// name (shadowing hides mutability) while `ELetMut` EXTENDS it.
fn sp_walk_spawnable_mut(expr: Expr, mut_names: Array[String], out: Array[String]) -> Unit {
  match expr {
    ELetMut(name, val, body, _) => {
      sp_walk_spawnable_mut(val, mut_names, out)
      sp_walk_spawnable_mut(body, sp_bound_with_one(mut_names, name), out)
    },
    ELet(name, val, body, _) => {
      sp_walk_spawnable_mut(val, mut_names, out)
      sp_walk_spawnable_mut(body, sp_remove_name(mut_names, name), out)
    },
    ELetRec(name, val, body) => {
      let nm = sp_remove_name(mut_names, name)
      sp_walk_spawnable_mut(val, nm, out)
      sp_walk_spawnable_mut(body, nm, out)
    },
    EAssign(_, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),
    EAssignOp(_, _, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),
    EFn(_, _, params, _, _, body) => {
      let mut cur = mut_names
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        cur = sp_remove_name(cur, pname)
        i = i + 1
      }
      sp_walk_spawnable_mut(body, cur, out)
    },
    ECall(callee, args, _) => {
      let spawn_info = match callee {
        EIdent(name, coff) => if (name == "TaskGroup::spawn" || name == "TaskGroup::spawn_suspend") && Array::length(args) == 2 {
          Some((coff, String::length(name)))
        } else {
          None
        },
        _ => None
      }
      match spawn_info {
        Some((coff, nlen)) => sp_check_spawn_mut_capture(Array::get(args, 1), mut_names, coff, nlen, out),
        None => ()
      }
      match callee {
        EIdent(_, _) => (),
        _ => sp_walk_spawnable_mut(callee, mut_names, out)
      }
      sp_walk_spawnable_mut_list(args, mut_names, out)
    },
    EIf(c, t, e) => {
      sp_walk_spawnable_mut(c, mut_names, out)
      sp_walk_spawnable_mut_binary(t, e, mut_names, out)
    },
    ESeq(a, b) => sp_walk_spawnable_mut_binary(a, b, mut_names, out),
    EBinOp(_, l, r) => sp_walk_spawnable_mut_binary(l, r, mut_names, out),
    EUnaryOp(_, e) => sp_walk_spawnable_mut(e, mut_names, out),
    EWhile(c, b) => sp_walk_spawnable_mut_binary(c, b, mut_names, out),
    ELoop(params, body) => {
      let mut cur = mut_names
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        sp_walk_spawnable_mut(init, cur, out)
        cur = sp_remove_name(cur, name)
        i = i + 1
      }
      sp_walk_spawnable_mut(body, cur, out)
    },
    EForIn(name, index_name, iter, body) => {
      sp_walk_spawnable_mut(iter, mut_names, out)
      let m2 = sp_remove_name(mut_names, name)
      let m3 = match index_name {
        Some(ixn) => sp_remove_name(m2, ixn),
        None => m2
      }
      sp_walk_spawnable_mut(body, m3, out)
    },
    EMatch(scrut, arms) => {
      sp_walk_spawnable_mut(scrut, mut_names, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = sp_empty_strings()
        sp_collect_pat_bindings(pat, pat_binds)
        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)
        ai = ai + 1
      }
    },
    EHandle(body, arms) => {
      sp_walk_spawnable_mut(body, mut_names, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = sp_empty_strings()
        sp_collect_pat_bindings(pat, pat_binds)
        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)
        ai = ai + 1
      }
    },
    ETuple(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),
    EArray(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),
    ERecord(_, fields, _) => sp_walk_spawnable_mut_fields(fields, mut_names, out),
    EDot(obj, _, _, _) => sp_walk_spawnable_mut(obj, mut_names, out),
    EReturn(e) => sp_walk_spawnable_mut(e, mut_names, out),
    ELabeledArg(_, _, e) => sp_walk_spawnable_mut(e, mut_names, out),
    EBreak(opt) => match opt {
      Some(e) => sp_walk_spawnable_mut(e, mut_names, out),
      None => ()
    },
    EContinue(exprs) => sp_walk_spawnable_mut_list(exprs, mut_names, out),
    EMap(fields) => sp_walk_spawnable_mut_fields(fields, mut_names, out),
    ESpread(e) => sp_walk_spawnable_mut(e, mut_names, out),
    _ => ()
  }
}

/// Entry point (per lexical scope): walk `scope_body` once from an empty
/// `mut_names` set, threading scope-aware `let mut` visibility per the
/// walker above.
fn check_spawnable_mut_captures_scope(scope_body: Expr) -> Array[String] {
  let out = sp_empty_strings()
  sp_walk_spawnable_mut(scope_body, sp_empty_strings(), out)
  out
}

/// Entry point: run `check_spawnable_mut_captures_scope` once per
/// top-level declaration with a body (function/`let`/`test`/`bench`/bare
/// top-level expression), recursing into `SModule` blocks. Called once
/// per program (checker_stmt.vibe's `check_program`/
/// `check_program_with_env`), not per `TaskGroup::run`/spawn call site.
export fn check_spawnable_mut_captures_stmts(stmts: Array[Stmt]) -> Array[String] {
  let out = sp_empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),
      SLetMut(_, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),
      STest(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),
      SBench(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),
      SExpr(body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),
      SModule(_, _, inner) => sp_append_all(out, check_spawnable_mut_captures_stmts(inner)),
      _ => ()
    }
    i = i + 1
  }
  out
}
