//# Checked direct-expression-return artifact (#1379 Phase 3)
//
// Strict opaque v1 transport of retained direct checker-return expression
// coordinates and final-substitution canonical type text. It is not a checked
// program, typed IR, checker/canonical-type/full-IR semantic attestation,
// cache/reuse key, import contract, or trace.

import @vibe/core {
  array_empty
}

import ./canonical_checked_type_state.vibe {
  canonical_checked_occurrence_type_fields
}

import ./checked_expression_structure_core.vibe {
  checked_expression_structure_rows
}

import ./checker_stmt.vibe {
  CheckedDirectExpressionReturnObservation
}

/// Opaque preorder transport of `(statement_path, expression_path, ty)`.
export struct CheckedDirectExpressionReturnArtifact {
  entries: Array[(Array[Int], Array[Int], String)]
}

fn direct_return_artifact_copy_string(text: String) -> String {
  String::concat(text, "")
}

fn direct_return_artifact_copy_path(path: Array[Int]) -> Array[Int] {
  Array::slice(path, 0, Array::length(path))
}

fn direct_return_artifact_copy_rows(entries: Array[(Array[Int], Array[Int], String)]) -> Array[(Array[Int], Array[Int], String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(entries) {
    let (statement_path, expression_path, ty) = Array::get(entries, i)
    Array::push(out, (direct_return_artifact_copy_path(statement_path), direct_return_artifact_copy_path(expression_path), direct_return_artifact_copy_string(ty)))
    i = i + 1
  }
  out
}

fn direct_return_artifact_path_valid(path: Array[Int]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(path) && valid {
    if Array::get(path, i) < 0 {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

fn direct_return_artifact_valid(entries: Array[(Array[Int], Array[Int], String)]) -> Bool {
  let mut valid = true
  let mut i = 0
  while i < Array::length(entries) && valid {
    let (statement_path, expression_path, _) = Array::get(entries, i)
    if !direct_return_artifact_path_valid(statement_path) || !direct_return_artifact_path_valid(expression_path) {
      valid = false
    } else {
      i = i + 1
    }
  }
  valid
}

/// Complete-or-none conversion independently reconciles every observed row
/// with the checked program's shared retained expression-structure authority.
/// It rejects absent, duplicate, unmapped, or preorder-misaligned coordinates,
/// then deep-copies paths and freezes final-substitution canonical type text.
export fn checked_direct_expression_return_artifact_from_observation(observation: CheckedDirectExpressionReturnObservation) -> Option[CheckedDirectExpressionReturnArtifact] {
  match checked_expression_structure_rows(observation.checked_program.checked_stmts) {
    None => None,
    Some(authority) => if Array::length(authority) != Array::length(observation.entries) {
      None
    } else {
      let entries = array_empty()
      let raw_types = array_empty()
      let mut i = 0
      let mut valid = true
      while i < Array::length(authority) && valid {
        let (statement_path, expression_path, _) = Array::get(authority, i)
        let (actual_statement_path, actual_expression_path, ty) = Array::get(observation.entries, i)
        if !direct_return_artifact_paths_equal(statement_path, actual_statement_path) || !direct_return_artifact_paths_equal(expression_path, actual_expression_path) {
          valid = false
        } else {
          Array::push(raw_types, ty)
          i = i + 1
        }
      }
      let types = canonical_checked_occurrence_type_fields(raw_types, observation.checked_program.final_subst)
      let mut row = 0
      while row < Array::length(authority) && valid {
        let (statement_path, expression_path, _) = Array::get(authority, row)
        Array::push(entries, (direct_return_artifact_copy_path(statement_path), direct_return_artifact_copy_path(expression_path), direct_return_artifact_copy_string(Array::get(types, row))))
        row = row + 1
      }
      if valid && direct_return_artifact_valid(entries) {
        Some(CheckedDirectExpressionReturnArtifact::{
          entries: entries
        })
      } else {
        None
      }
    }
  }
}

fn direct_return_artifact_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn direct_return_artifact_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, __to_string(value))
  StringBuilder::push(out, ":")
}

fn direct_return_artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  direct_return_artifact_push_int(out, String::length(text))
  StringBuilder::push(out, text)
}

fn direct_return_artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(path) {
    direct_return_artifact_push_int(out, Array::get(path, i))
    i = i + 1
  }
  StringBuilder::push(out, "]")
}

fn direct_return_artifact_entry(statement_path: Array[Int], expression_path: Array[Int], ty: String) -> String {
  let out = StringBuilder::new()
  direct_return_artifact_push_path(out, statement_path)
  direct_return_artifact_push_path(out, expression_path)
  direct_return_artifact_push_piece(out, ty)
  StringBuilder::freeze(out)
}

/// Canonical versioned length-delimited v1 encoder preserving preorder.
export fn encode_checked_direct_expression_return_artifact_v1(artifact: CheckedDirectExpressionReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-direct-expression-return-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(artifact.entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, ty) = Array::get(artifact.entries, i)
    direct_return_artifact_push_piece(out, direct_return_artifact_entry(statement_path, expression_path, ty))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn direct_return_artifact_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {
  if start >= end || bound < 0 {
    None
  } else {
    let mut valid = true
    let mut value = 0
    let mut i = start
    if end - start > 1 && String::char_code_at(text, start) == 48 {
      valid = false
    }
    while i < end && valid {
      let digit = String::char_code_at(text, i) - 48
      if digit < 0 || digit > 9 || value > (bound - digit) / 10 {
        valid = false
      } else {
        value = value * 10 + digit
        i = i + 1
      }
    }
    if valid {
      Some(value)
    } else {
      None
    }
  }
}

fn direct_return_artifact_piece_parse(text: String, pos: Int) -> Option[(String, Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 58 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(size) => {
        let start = at + 1
        let end = start + size
        if end < start || end > n {
          None
        } else {
          Some((text[start: end], end))
        }
      },
      None => None
    }
  }
}

fn direct_return_artifact_path_parse(text: String, pos: Int) -> Option[(Array[Int], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        let path = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          let start = cursor
          while cursor < n && String::char_code_at(text, cursor) != 58 {
            cursor = cursor + 1
          }
          if cursor == start || cursor >= n {
            valid = false
          } else {
            match direct_return_artifact_decimal(text, start, cursor, 2305843009213693951) {
              Some(value) => {
                Array::push(path, value)
                cursor = cursor + 1
              },
              None => {
                valid = false
              }
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((path, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn direct_return_artifact_array_parse(text: String, pos: Int) -> Option[(Array[String], Int)] {
  let n = String::length(text)
  let mut at = pos
  while at < n && String::char_code_at(text, at) != 91 {
    at = at + 1
  }
  if at == pos || at >= n {
    None
  } else {
    match direct_return_artifact_decimal(text, pos, at, n - at - 1) {
      Some(count) => {
        let out = array_empty()
        let mut cursor = at + 1
        let mut i = 0
        let mut valid = true
        while i < count && valid {
          match direct_return_artifact_piece_parse(text, cursor) {
            Some((item, next)) => {
              Array::push(out, item)
              cursor = next
            },
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || cursor >= n || String::char_code_at(text, cursor) != 93 {
          None
        } else {
          Some((out, cursor + 1))
        }
      },
      None => None
    }
  }
}

fn direct_return_artifact_entry_parse(text: String) -> Option[(Array[Int], Array[Int], String)] {
  match direct_return_artifact_path_parse(text, 0) {
    Some((statement_path, after_statement)) => match direct_return_artifact_path_parse(text, after_statement) {
      Some((expression_path, after_expression)) => match direct_return_artifact_piece_parse(text, after_expression) {
        Some((ty, end)) => if end == String::length(text) {
          Some((statement_path, expression_path, ty))
        } else {
          None
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

/// Strict v1 decoder. Counts are bounded by remaining input before iteration;
/// exact re-encoding rejects all alternate noncanonical representations.
export fn decode_checked_direct_expression_return_artifact_v1(text: String) -> Option[CheckedDirectExpressionReturnArtifact] {
  let prefix = "vibe-checked-direct-expression-return-artifact:v1\n"
  if !String::starts_with(text, prefix) {
    None
  } else {
    match direct_return_artifact_array_parse(text, String::length(prefix)) {
      Some((raw_rows, end)) => {
        let rows = array_empty()
        let mut valid = end == String::length(text)
        let mut i = 0
        while i < Array::length(raw_rows) && valid {
          match direct_return_artifact_entry_parse(Array::get(raw_rows, i)) {
            Some(row) => Array::push(rows, row),
            None => {
              valid = false
            }
          }
          i = i + 1
        }
        if !valid || !direct_return_artifact_valid(rows) {
          None
        } else {
          let artifact = CheckedDirectExpressionReturnArtifact::{
            entries: direct_return_artifact_copy_rows(rows)
          }
          if encode_checked_direct_expression_return_artifact_v1(artifact) == text {
            Some(artifact)
          } else {
            None
          }
        }
      },
      None => None
    }
  }
}

/// Deterministic artifact vocabulary only. Decoded payloads do not attest
/// checker success, canonical-type semantics, or complete typed IR semantics.
export fn canonical_checked_direct_expression_return_artifact_snapshot(artifact: CheckedDirectExpressionReturnArtifact) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-direct-expression-return-observation:v1\n")
  direct_return_artifact_push_int(out, Array::length(artifact.entries))
  let mut i = 0
  while i < Array::length(artifact.entries) {
    let (statement_path, expression_path, ty) = Array::get(artifact.entries, i)
    direct_return_artifact_push_int(out, Array::length(statement_path))
    let mut j = 0
    while j < Array::length(statement_path) {
      direct_return_artifact_push_int(out, Array::get(statement_path, j))
      j = j + 1
    }
    direct_return_artifact_push_int(out, Array::length(expression_path))
    let mut k = 0
    while k < Array::length(expression_path) {
      direct_return_artifact_push_int(out, Array::get(expression_path, k))
      k = k + 1
    }
    direct_return_artifact_push_piece(out, ty)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export fn checked_direct_expression_return_artifact_row_count(artifact: CheckedDirectExpressionReturnArtifact) -> Int {
  Array::length(artifact.entries)
}

export fn checked_direct_expression_return_artifact_statement_path_at(artifact: CheckedDirectExpressionReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (path, _, _) = Array::get(artifact.entries, row_index)
    Some(direct_return_artifact_copy_path(path))
  }
}

export fn checked_direct_expression_return_artifact_expression_path_at(artifact: CheckedDirectExpressionReturnArtifact, row_index: Int) -> Option[Array[Int]] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, path, _) = Array::get(artifact.entries, row_index)
    Some(direct_return_artifact_copy_path(path))
  }
}

export fn checked_direct_expression_return_artifact_type_at(artifact: CheckedDirectExpressionReturnArtifact, row_index: Int) -> Option[String] {
  if row_index < 0 || row_index >= Array::length(artifact.entries) {
    None
  } else {
    let (_, _, ty) = Array::get(artifact.entries, row_index)
    Some(direct_return_artifact_copy_string(ty))
  }
}
