/// #2424: the source offsets of expressions that a render (`__to_string` /
/// `Int::to_string`) or `eq` call takes as an argument AND whose
/// checker-confirmed type is the one asked for.
///
/// This is the answer codegen cannot compute for itself. Both lanes classify a
/// render argument syntactically -- `ts_known_int` on linear,
/// `bc_expr_is_intish` on gc -- from a slot log seeded at binding sites, so
/// correctness is exactly the set of binding forms someone remembered to seed,
/// and everything else renders the empty string with no diagnostic. The type is
/// already computed right here; this hands it over instead of asking codegen to
/// re-derive it.
///
/// FAIL CLOSED on disagreement. An offset can carry more than one typed
/// occurrence (a dot-call receiver and its result share one), so an offset is
/// emitted only when it has at least one occurrence and EVERY occurrence there
/// resolves to it. A candidate with no occurrence at all -- which is what an
/// unlocated `parse_program(lex(source))` AST produces for the whole program --
/// is simply absent, and an absent offset classifies nothing, leaving the
/// pre-existing syntactic answer exactly as it was.
///
/// #2424: the shared core of the render/eq ARGUMENT channels. `want` is the
/// typed-lowering tag (3 = Int, 4 = Double, 5 = Bool) and picks which type head
/// an offset must resolve to; everything else -- the candidate walk, the
/// fail-closed agreement rule, the binary search -- is the same question asked
/// per tag, so it is written once. Reading a candidate set under one rule and a
/// type under another is how a producer and a consumer drift into silence.
fn irc_render_arg_offsets(checked: CheckedProgram, want: Int) -> Array[Int] {
  let (only, _) = irc_render_arg_offsets_pair(checked, want, 0 - 1)
  only
}

/// #2462/#2464 perf: tags 3 (Int) and 5 (Bool) answered from ONE walk.
///
/// The two share a KEY (`typed_lowering_arg_offset`), so they share a candidate
/// set exactly -- the same expressions, found by the same walk, looked up in
/// the same sorted array. Only the type test differs, and that is one line per
/// occurrence. Running the walk twice re-derived an identical `cands` and
/// re-scanned `typed_occurrences` to ask a second question about rows it had
/// already visited.
///
/// Measured when tag 5 landed as its own walk: selfcompile heap 1.49 -> 1.50
/// GiB, +0.86% on the perf report's deterministic section. Tag 4 stays separate
/// because its key is `typed_lowering_float_key`, a genuinely different
/// candidate set -- folding it in would mean collecting under one key and
/// reading under another, which is the silence this file keeps warning about.
///
/// `want_b` of -1 asks for `want_a` alone. The two OUTPUT arrays stay separate:
/// sharing the walk is a cost decision, sharing the answers would put a Bool
/// offset where `ts_known_int` reads and render `true` as a number.
fn irc_render_arg_offsets_pair(checked: CheckedProgram, want_a: Int, want_b: Int) -> (Array[Int], Array[Int]) {
  let (a, b, _) = irc_render_arg_offsets_triple(checked, want_a, want_b, 0 - 1)
  (a, b)
}

/// #2987 et al.: the pair walk plus an optional third tag (`want_c`, -1 for
/// none) answered from the same candidate set. Only tag 6 uses it, and it
/// shares tag 3's key, so no candidate is filed under a key nobody reads.
fn irc_render_arg_offsets_triple(checked: CheckedProgram, want_a: Int, want_b: Int, want_c: Int) -> (Array[Int], Array[Int], Array[Int]) {
  let (a, b, c, _, _) = irc_render_arg_offsets_quad(checked, want_a, want_b, want_c, false)
  (a, b, c)
}

/// #3066: the triple plus the RENDER ROWS, from the same walk and the same
/// occurrence loop (`want_rows`). A row is `(argument offset,
/// impl_target_key(__render[T]))` for a render argument whose every typed
/// occurrence resolves to the SAME `Option` / `Array` / tuple type `T` that the
/// typed-`==` channel can spell -- see `irc_render_row_key`. Anything else
/// (no occurrence, a disagreement, a type variable, a record) files nothing,
/// so the interpolation pass keeps its own answer: absent, never wrong.
fn irc_render_arg_offsets_quad(checked: CheckedProgram, want_a: Int, want_b: Int, want_c: Int, want_rows: Bool) -> (Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) {
  let raw: Array[Int] = []
  let shims = irc_shim_set(irc_show_shim_names_with_env(checked.checked_stmts, checked.final_env))
  Array::truncate(irc_literal_item_keys, 0)
  Array::set(irc_literal_depth, 0, 0)
  irc_collect_stmts(checked.checked_stmts, raw, want_a, shims)
  let cands = irc_sorted_unique(raw)
  let literal_items = irc_sorted_unique(irc_literal_item_keys)
  let shim_args = if want_c >= 0 || want_rows {
    irc_shim_body_arg_offsets(checked.checked_stmts)
  } else {
    []
  }
  let n = Array::length(cands)
  if n == 0 {
    ([], [], [], [], [])
  } else {
    // Presized: filled from empty, each table regrew by doubling and left
    // its outgrown buffers on the bump heap.
    let seen_any: Array[Int] = Array::with_capacity(n)
    let all_a: Array[Int] = Array::with_capacity(n)
    let all_b: Array[Int] = Array::with_capacity(n)
    let all_c: Array[Int] = Array::with_capacity(n)
    // #3066: per candidate, the render-row key its occurrences agree on, and
    // 0 = no occurrence yet / 1 = agreeing / 2 = poisoned.
    let rows_n = if want_rows {
      n
    } else {
      0
    }
    let row_keys: Array[String] = Array::with_capacity(rows_n)
    let row_state: Array[Int] = Array::with_capacity(rows_n)
    let mut k = 0
    while k < n {
      if want_rows {
        Array::push(row_keys, "")
        Array::push(row_state, 0)
      } else {
        ()
      }
      Array::push(seen_any, 0)
      Array::push(all_a, 1)
      Array::push(all_b, 1)
      Array::push(all_c, 1)
      k = k + 1
    }
    let mut oi = 0
    while oi < Array::length(checked.typed_occurrences) {
      let (ooff, oty) = Array::get(checked.typed_occurrences, oi)
      if ooff >= 0 {
        let idx = irc_index_of(cands, ooff)
        if idx >= 0 {
          Array::set(seen_any, idx, 1)
          if irc_occurrence_wants(checked, oty, want_a) {
            ()
          } else {
            Array::set(all_a, idx, 0)
          }
          if want_b < 0 || irc_occurrence_wants(checked, oty, want_b) {
            ()
          } else {
            Array::set(all_b, idx, 0)
          }
          if want_c < 0 || irc_occurrence_wants(checked, oty, want_c) {
            ()
          } else {
            Array::set(all_c, idx, 0)
          }
          if want_rows && Array::get(row_state, idx) != 2 {
            let rk = irc_render_row_key(checked, oty, irc_index_of(literal_items, ooff) >= 0)
            if String::length(rk) == 0 {
              Array::set(row_state, idx, 2)
            } else if Array::get(row_state, idx) == 0 {
              Array::set(row_state, idx, 1)
              Array::set(row_keys, idx, rk)
            } else if Array::get(row_keys, idx) != rk {
              Array::set(row_state, idx, 2)
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      oi = oi + 1
    }
    let out_a: Array[Int] = []
    let out_b: Array[Int] = []
    let out_c: Array[Int] = []
    let out_row_offs: Array[Int] = []
    let out_row_keys: Array[String] = []
    let mut m = 0
    while m < n {
      if Array::get(seen_any, m) == 1 {
        if Array::get(all_a, m) == 1 {
          Array::push(out_a, Array::get(cands, m))
        } else {
          ()
        }
        if want_b >= 0 && Array::get(all_b, m) == 1 {
          Array::push(out_b, Array::get(cands, m))
        } else {
          ()
        }
        if want_c >= 0 && Array::get(all_c, m) == 1 && !irc_int_array_has(shim_args, Array::get(cands, m)) {
          Array::push(out_c, Array::get(cands, m))
        } else {
          ()
        }
        if want_rows && Array::get(row_state, m) == 1 && !irc_int_array_has(shim_args, Array::get(cands, m)) {
          Array::push(out_row_offs, Array::get(cands, m))
          Array::push(out_row_keys, Array::get(row_keys, m))
        } else {
          ()
        }
      } else {
        ()
      }
      m = m + 1
    }
    (out_a, out_b, out_c, out_row_offs, out_row_keys)
  }
}

/// #3066: the render-row key for one typed occurrence, or "" when it cannot
/// be one. An `Option` / `Array` / tuple / applied nominal: those are the
/// shapes the interpolation pass expands, and the ones whose payload positions
/// it had to guess from syntax -- `Some(k())` through a local lambda rendered
/// `Some(0)` for `Some(false)`. Plus the `Char` / `Unit` leaves (#3075). The
/// type must be fully spelled by
/// `eq_channel_type_expr` (no variable, function or record anywhere in it).
///
/// #3081: an ELEMENT of a composite literal (`literal_item`) files any type
/// the channel can spell, scalars included -- the pass renders an element from
/// the literal's shape, so a Bool or Double leaf needs the row as much as an
/// Option does.
fn irc_render_row_key(checked: CheckedProgram, oty: Type, literal_item: Bool) -> String {
  let t = subst_apply(checked.final_subst, oty)
  // #3074: an applied nominal (`G[Bool]`), whose derived renderer erases its
  // formals. #3075: a `Char` / `Unit` leaf, which the runtime renderer cannot
  // tell from an Int.
  let composite = match t {
    CtOption(_) => true,
    CtArray(_) => true,
    CtTuple(_) => true,
    // #3084: a plain nominal too. A generic function's result (`pass(Pt::{
    // x: 1 })`) is typed only here -- its declared return is the callee's
    // formal, which names nothing at the call site.
    CtNamed(_, _) => true,
    CtStruct(_) => true,
    CtEnum(_) => true,
    CtApplied(_, _) => true,
    CtChar => true,
    CtUnit => true,
    _ => false
  }
  if composite || literal_item {
    match eq_channel_type_expr(t) {
      Some(te) => impl_target_key(TyApp(typed_render_row_head(), [te])),
      None => ""
    }
  } else {
    ""
  }
}

/// Does this occurrence's type resolve to the head tag `want` asks for?
fn irc_occurrence_wants(checked: CheckedProgram, oty: Type, want: Int) -> Bool {
  if want == 4 {
    subst_resolves_to_double(checked.final_subst, oty)
  } else if want == 6 {
    irc_resolves_to_unrenderable(checked.final_subst, oty)
  } else {
    irc_resolves_to_scalar(checked.final_subst, oty, want == 5)
  }
}

/// #2424 tag 3 and #2462/#2464 tag 5, from ONE walk. The lanes that want both
/// -- which is every lane that wants either -- should call this rather than the
/// two singles, so the shared candidate set is computed once.
export fn checked_int_and_bool_render_offsets(checked: CheckedProgram) -> (Array[Int], Array[Int]) {
  irc_render_arg_offsets_pair(checked, 3, 5)
}

/// #2987 tag 6: tags 3 and 5 plus the render/eq argument offsets whose type the
/// runtime renderer cannot print (see `irc_resolves_to_unrenderable`), from the
/// ONE walk the pair already runs.
export fn checked_int_bool_and_unrenderable_render_offsets(checked: CheckedProgram) -> (Array[Int], Array[Int], Array[Int]) {
  irc_render_arg_offsets_triple(checked, 3, 5, 6)
}

/// #3066: the same three tables plus the render rows (see
/// `irc_render_arg_offsets_quad`), from the one walk.
fn checked_render_offsets_and_rows(checked: CheckedProgram) -> (Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) {
  irc_render_arg_offsets_quad(checked, 3, 5, 6, true)
}

/// #3066: only the render rows, for a lane that asks for none of the tables.
fn checked_render_rows(checked: CheckedProgram) -> (Array[Int], Array[String]) {
  let (_, _, _, offs, keys) = irc_render_arg_offsets_quad(checked, 3, 0 - 1, 0 - 1, true)
  (offs, keys)
}

/// #3066: the typed-`==` rows with the render rows appended. They share one
/// channel on purpose (see `typed_render_row_head`); the head keeps a lookup of
/// one kind from ever reading the other.
fn append_render_rows(eq_offs: Array[Int], eq_keys: Array[String], row_offs: Array[Int], row_keys: Array[String]) -> (Array[Int], Array[String]) {
  let offs: Array[Int] = []
  let keys: Array[String] = []
  let mut i = 0
  while i < Array::length(eq_offs) {
    Array::push(offs, Array::get(eq_offs, i))
    Array::push(keys, Array::get(eq_keys, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(row_offs) {
    Array::push(offs, Array::get(row_offs, j))
    Array::push(keys, Array::get(row_keys, j))
    j = j + 1
  }
  (offs, keys)
}

/// #2987: the Int channel with the tag-6 rows folded in under
/// `typed_render_refuse_key`, which is how every codegen lane receives them.
/// The refusal rides the Int array rather than a table of its own because the
/// array already reaches every `__to_string` lowering on every lane; a
/// negative key can never equal the non-negative offset an Int lookup asks
/// for, so the Int answers are untouched.
export fn merge_unrenderable_render_offsets(ints: Array[Int], unrenderable: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(ints) {
    Array::push(out, Array::get(ints, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(unrenderable) {
    Array::push(out, typed_render_refuse_key(Array::get(unrenderable, j)))
    j = j + 1
  }
  out
}

/// #2424 tag 3: render/eq argument offsets the checker typed as `Int`.
export fn checked_int_render_offsets(checked: CheckedProgram) -> Array[Int] {
  irc_render_arg_offsets(checked, 3)
}

/// #2462/#2464 tag 5: the same argument offsets the checker typed as `Bool`.
///
/// It closes two P0s that are one gap seen from two sides. Both lanes decide
/// "is this argument a Bool" syntactically, and both answers are incomplete in
/// ways nobody can see from the source:
///
///   - linear reads `fn_returns`, which `collect_fn_returns` fills from the
///     STATEMENT list, so a lambda bound by a `let` inside a function body is
///     invisible to it and `__to_string(f())` rendered "1" (#2462). The same
///     lambda at top level rendered "true", which is the tell that the rule was
///     about where the binding sat rather than about the type.
///   - gc's `gc_expr_is_boolish` had no ECall arm at all, so no Bool-returning
///     builtin was classified and `__to_string(eq(a, b))` rendered "0" where
///     linear rendered "false" (#2464) -- a regression against the committed
///     seed.
///
/// The type is already computed here, and it does not care where the producer
/// was bound or whether the callee is a builtin. Keyed like tag 3, because a
/// Bool argument is reached through exactly the same expression shapes an Int
/// one is.
export fn checked_bool_render_offsets(checked: CheckedProgram) -> Array[Int] {
  irc_render_arg_offsets(checked, 5)
}

/// #2424 tag 4: the Double half of the same question. #3201 also proposes
/// every field projection as a candidate, then keeps only keys whose typed
/// occurrences all resolve to Double. This covers ordinary field arithmetic
/// and ordering outside a render/`eq` call.
///
/// Split out from tag 3 rather than folded into it because the two answers go
/// to DIFFERENT consumers -- `ts_known_int` / `bc_expr_is_intish` read one and
/// the four `*_expr_is_floatish` copies read the other -- and an offset that
/// classified as both would force each consumer to re-derive which half it was
/// looking at.
///
/// The row it closes: a Double-typed STRUCT FIELD through `__to_string`.
/// `float_call_offsets` (#2158) is keyed by CALL offsets only, so it has no
/// projection arm, exactly as `ts_known_int` had none before the tag-3 channel;
/// measured before this change, `DBox::{ ratio: 1.5 }` rendered `b.ratio` as
/// `256` on the RC lane and trapped on gc, while the same Double reached
/// through a tuple element or a plain `let` answered `1.5`.
export fn checked_double_render_offsets(checked: CheckedProgram) -> Array[Int] {
  irc_render_arg_offsets(checked, 4)
}

/// #2391 slice 2: the typed-lowering channel's value encoding. One table
/// carries every per-module channel so the memo/sidecar/rebase carrier stays a
/// flat Array[Int]: enc = offset * 8 + tag, with tag 0 = Double call result,
/// 1 = String relational binop anchor, 2 = String `+` binop anchor, 3 = Int
/// render/`eq` argument, 4 = Double render/`eq` argument, 5 = Bool render/`eq`
/// argument, 6 = unrenderable render/`eq` argument (#2987). Tag 7 carries
/// resolved callees: its payload is call_offset * 65536 + operation, so its
/// rebase is B * 65536 * 8 (core/resolved_callee.vibe). Rebasing any other module
/// table by a merge base B therefore adds B * 8. The decoder lives in
/// file_compile's split; keep the two in lockstep.
///
/// #2424 widened the tag from 2 bits to 3 when tag 4 arrived. Nothing has to be
/// migrated for that: the persistent artifact key is
/// `persistent_cache_version_tag()` = "v23|cg-" + `codegen_fingerprint()`, and
/// the fingerprint hashes every compiler source, so a stale sidecar written
/// under the old encoding cannot be read back under the new one.
export fn typed_lowering_enc(offset: Int, tag: Int) -> Int {
  offset * 8 + tag
}

export fn typed_lowering_enc_offset(enc: Int) -> Int {
  enc / 8
}

export fn typed_lowering_enc_tag(enc: Int) -> Int {
  enc - (enc / 8) * 8
}

/// Check once and retain only source-located primary call results whose
/// checker-confirmed instantiated type is Double, plus the two counts that say
/// whether the AST was located at all: how many primary call results the
/// program has, and how many of those carry a source offset.
///
/// The counts exist because an EMPTY offset array is ambiguous. `check_program`
/// records an occurrence for every primary call result either way, but
/// `tab_call_ty` (checker.vibe) only files one under an offset when that offset
/// is `>= 0` -- so an AST built by `parse_program(lex(source))` produces an
/// empty table BY CONSTRUCTION, indistinguishable from a program that simply
/// has no Double call results. A caller that cannot tell those apart wires the
/// channel up green and inert; `check_program_double_call_result_located_observation`
/// below is the caller-facing form that refuses the first case.
///
/// #2427: an offset claimed by MORE THAN ONE primary call result is kept only
/// when every claimant resolves the same way, and POISONED otherwise -- the
/// rule `string_binop_offsets_from_capture` below has carried since Codex
/// round 1 on #2429, and the one this extraction was missing.
///
/// The difference is not academic. The consumer is keyed by OFFSET, so an
/// offset in the table classifies EVERY call node anchored there. Filing an
/// offset because one claimant is Double, while another claimant at the same
/// offset is an `Int`, tells codegen the Int call returns a float; the first
/// consumer that renders it hands `__rt_str_concat` a corrupt `(ptr|len)`.
/// Measured by forcing the collision (two top-level `let`s whose call offsets
/// are rewritten to one value, `fn fd() -> Double` and `fn fi() -> Int`):
///
///   distinct offsets   table [59]    -- correct
///   both at 777        table [777]   -- the Int call is now "a Double call"
///
/// Deduplication was the old shape and it cannot express this: it asks "did I
/// already push this offset", which is a question about the OUTPUT, when the
/// question that matters is whether the claimants AGREE. Two claimants that
/// agree still collapse to one row, exactly as before.
///
/// Poisoning does NOT make a mixed collision harmless. It is a SWAP: before
/// it the Double claimant kept its row and the Int claimant was misclassified;
/// after it neither is classified and both fall to the syntactic classifiers.
/// Measured on the collision itself (Codex rounds 1 and 3 on this PR -- an
/// earlier claim that the render path survives was measured BESIDE the
/// collision, on an uncollided source, and was wrong):
///
///   natural    tag0=1  tag4=1
///   collided   tag0=0  tag4=0
///
/// The tag-4 render row does not rescue the Double claimant, because
/// `typed_lowering_float_key` keys a call-result argument on the call's OWN
/// offset -- the colliding one -- and `irc_render_arg_offsets` drops a
/// candidate whose occurrences disagree. (That producer answers 0 there
/// without this change too; its agreement rule is older.)
///
/// The reason to prefer the swap is not that it hurts less. It is that an
/// offset whose claimants disagree has no single true answer, and this
/// channel's contract is "absent, never wrong": filing the offset asserts
/// Double for EVERY node anchored there, which is knowably false for one of
/// them. Every sibling channel already fails closed the same way -- tags 3, 4
/// and 5 emit an offset only when every occurrence there agrees, and the
/// String binops poison a disagreeing anchor. Tag 0 was the only one asserting
/// an answer it could not know, which is exactly what
/// `typed_lowering_float_key`'s own comment says when it explains why the
/// FLOAT key needs a restriction the Int key does not.
///
/// The residue is real and is pinned in the test: a mixed collision leaves the
/// Double claimant unclassified. Node identity in the key is the fix, and an
/// offset-keyed consumer cannot express it -- #2427's remaining step.
///
/// A curried `f()()` -- the obvious candidate -- anchors its two calls four
/// bytes apart, and this comment used to stop there, at "no colliding pair was
/// found in today's bundle". That was measured on the wrong file. The bundle
/// holds compiler sources as STRING CONSTANTS, so parsing it sees a few dozen
/// call nodes and answers "clean" about code it never looked at; the flat
/// source the single-source lane actually compiles is the reprinted
/// `_cli_adapter_module_source.vibe`.
///
/// Scanned properly (998 files, every `ECall` offset and every `EDot`
/// field-name offset -- both halves of this table's key space), exactly ONE
/// shape collided: the `throw(x)` desugar, which anchored `perform` and the op
/// call at the same `throw` keyword. 904 sites in `lib/**`, 782 more in the
/// flat module source, and nothing else -- no dot key on a call key, no second
/// shape. It never misclassified anything, because the `perform` arm returns
/// without routing either result through `tab_call_ty`, so neither node
/// records an occurrence. `parse_throw_primary` now leaves the op call
/// unlocated (#2427), and `tests/offset_key_collision_test.vibe` scans for the
/// next one. The rule here still closes the hole whether or not an instance is
/// live -- a desugar is one edit away from making one.
fn check_program_double_call_result_observation_impl(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int], Int, Int, Array[Int], Array[String])] with Exception {
  resolved_callee_capture_reset()
  let capture = reset_double_call_capture()
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(capture)).checked_program
  match double_call_result_offsets_from_capture(checked, capture) {
    None => None,
    Some((out, primary_calls, located_primary_calls)) => {
      // #2441: the typed-`==` rows from the SAME capture the Double
      // observation already filled -- one check answers both. Unlike the
      // Double table, these need no located-refusal ambiguity handling OR a
      // downstream uniqueness filter: an unlocated binop records nothing
      // (the record site's `anchor_off >= 0` guard), and an offset claimed
      // by two binops with different types is poisoned at extraction --
      // with the SAME type, rewriting both is correct.
      let (eq_only_offs, eq_only_keys) = eq_binop_type_keys_from_capture(checked, capture)
      // #3066: the render rows ride the same channel.
      let (row_offs, row_keys) = checked_render_rows(checked)
      let (eq_render_offs, eq_render_keys) = append_render_rows(eq_only_offs, eq_only_keys, row_offs, row_keys)
      // #3133: the index-receiver rows ride the same channel.
      let (index_offs, index_keys) = index_receiver_rows_from_capture(checked, capture)
      let (eq_index_offs, eq_index_keys) = append_render_rows(eq_render_offs, eq_render_keys, index_offs, index_keys)
      // #3148: and the `for` iterand rows.
      let (forin_offs, forin_keys) = forin_receiver_rows_from_capture(checked, capture)
      let (eq_offs, eq_keys) = append_render_rows(eq_index_offs, eq_index_keys, forin_offs, forin_keys)
      // #2424: the Double table is the union of the call results above and
      // the render/`eq` ARGUMENTS the checker typed Double (tag 4 on the
      // modular channel) -- see union_double_render_arg_offsets.
      Some((checked, union_double_render_arg_offsets(checked, out), primary_calls, located_primary_calls, eq_offs, eq_keys))
    }
  }
}

/// #2424: fold the Double render/`eq` ARGUMENT offsets (tag 4 on the modular
/// channel) into a whole-program Double offset table.
///
/// The two sets answer the same consumer question -- "is the value at this
/// offset a Double?" -- and reach the same array, `CompileCtx.float_call_offsets`
/// and its gc twin, which the classifiers read with `typed_lowering_float_key`.
/// They are collected separately because their producers are: one comes from
/// the primary-call-result capture, the other from the render/`eq` argument
/// walk, and a projection has no call result to capture.
///
/// Unioning HERE rather than at each entry lane is deliberate. Every
/// non-modular consumer of the observation (`compile_source`, the two
/// `preprocess_compile` entries, the gc entry) goes through this one function,
/// so none of them can be the caller that forgot -- which is exactly how the
/// float channel stayed inert on the module lane for three releases (#2437).
fn union_double_render_arg_offsets(checked: CheckedProgram, call_results: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(call_results) {
    Array::push(out, Array::get(call_results, i))
    i = i + 1
  }
  let args = checked_double_render_offsets(checked)
  let mut j = 0
  while j < Array::length(args) {
    let off = Array::get(args, j)
    let mut seen = false
    let mut k = 0
    while k < Array::length(out) {
      if Array::get(out, k) == off {
        seen = true
        k = Array::length(out)
      } else {
        k = k + 1
      }
    }
    if seen {
      ()
    } else {
      Array::push(out, off)
    }
    j = j + 1
  }
  out
}

/// #2391: the modular form of the #2158 observation, for the per-module check
/// the FS lanes already run (check_module). One checker invocation answers
/// both questions: the CheckedProgram every consumer of the module check needs,
/// and this module's typed-lowering table -- Double call-result offsets plus
/// String relational/`+` binop anchors, tag-encoded per typed_lowering_enc,
/// in the module's OWN offset space (the FS merge rebases them per file
/// before consumption).
///
/// The table is `None` exactly when the located form below would refuse the
/// channel: the program has primary call results and not one is located (an
/// unlocated `parse_program(lex(source))` AST), or the capture did not line up.
/// `Some([])` stays the honest "located, and nothing classifies".
///
/// `initial_env` follows check_module's two production entries: `EnvEmpty`
/// delegates to the plain whole-program check, anything else takes the
/// projected-import-env path (`imports_already_projected`), so the checked
/// program is identical to what check_program_result /
/// check_program_with_projected_import_env_result produce today.
export fn check_program_with_projected_import_env_typed_lowering_located_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> (CheckedProgram, Option[Array[Int]], Array[Int], Array[String]) with Exception {
  typed_lowering_located_observation_impl(stmts, initial_env, true)
}

/// #2449: the same observation for the lane whose import statements are NOT
/// pre-projected -- the in-memory module walk in `runtime/ensure_fingerprint`,
/// which reaches the checker through `check_program_with_env` and so must keep
/// `imports_already_projected = false`. Everything after the check is shared
/// with the projected entry above; only that flag differs, because a lane that
/// changed it would be checking a different program in order to observe one.
export fn check_program_with_env_typed_lowering_located_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> (CheckedProgram, Option[Array[Int]], Array[Int], Array[String]) with Exception {
  typed_lowering_located_observation_impl(stmts, initial_env, false)
}

fn typed_lowering_located_observation_impl(stmts: Array[Stmt], initial_env: TypeEnv, imports_already_projected: Bool) -> (CheckedProgram, Option[Array[Int]], Array[Int], Array[String]) with Exception {
  resolved_callee_capture_reset()
  let capture = reset_double_call_capture()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(capture), imports_already_projected).checked_program
  match double_call_result_offsets_from_capture(checked, capture) {
    None => (checked, None, array_empty(), array_empty()),
    Some((out, primary_calls, located_primary_calls)) => if primary_calls > 0 && located_primary_calls == 0 {
      (checked, None, array_empty(), array_empty())
    } else {
      // #2391 slice 2: one encoded table carries the Double call-result
      // offsets (tag 0) and the String relational/`+` binop anchors
      // (tags 1/2) -- see typed_lowering_enc. The located-channel refusal
      // above is decided by the Double half alone: it observes every module
      // the same way (a flag per typed occurrence), so "primary calls exist
      // and none is located" identifies an unlocated AST for the String
      // half too.
      let (rels, pluses) = string_binop_offsets_from_capture(checked, capture)
      let enc: Array[Int] = []
      let mut fi = 0
      while fi < Array::length(out) {
        Array::push(enc, typed_lowering_enc(Array::get(out, fi), 0))
        fi = fi + 1
      }
      let mut ri = 0
      while ri < Array::length(rels) {
        Array::push(enc, typed_lowering_enc(Array::get(rels, ri), 1))
        ri = ri + 1
      }
      let mut pi = 0
      while pi < Array::length(pluses) {
        Array::push(enc, typed_lowering_enc(Array::get(pluses, pi), 2))
        pi = pi + 1
      }
      // #2424: tag 3 -- render (`__to_string` / `Int::to_string`) and `eq`
      // ARGUMENT offsets the checker typed as `Int`. Riding this table rather
      // than a second one is the whole point of the slice-2 encoding: the
      // memo, the sidecar, the per-file rebase and the reuse arms are already
      // built and already require the sidecar before skipping a check.
      let (int_renders, bool_renders, unrenderable, row_offs, row_keys) = checked_render_offsets_and_rows(checked)
      let mut ii = 0
      while ii < Array::length(int_renders) {
        Array::push(enc, typed_lowering_enc(Array::get(int_renders, ii), 3))
        ii = ii + 1
      }
      // #2424: tag 4 -- the same argument offsets the checker typed as
      // `Double`. It rides the SAME table for the same reason tag 3 does, and
      // it is a separate tag rather than more tag-0 rows because tag 0 is keyed
      // by CALL offsets and this is keyed by `typed_lowering_arg_offset`; the
      // decoder unions them only once it has read both keys correctly.
      let double_renders = checked_double_render_offsets(checked)
      let mut di = 0
      while di < Array::length(double_renders) {
        Array::push(enc, typed_lowering_enc(Array::get(double_renders, di), 4))
        di = di + 1
      }
      // #2462/#2464: tag 5 -- the same argument offsets the checker typed as
      // `Bool`. Keyed exactly like tag 3, and kept a separate tag for the same
      // reason tag 4 is: the consumers are different predicates
      // (`*_expr_is_boolish` rather than `ts_known_int`), and an offset that
      // classified as both would make each one re-derive which half it was
      // looking at.
      let mut bi = 0
      while bi < Array::length(bool_renders) {
        Array::push(enc, typed_lowering_enc(Array::get(bool_renders, bi), 5))
        bi = bi + 1
      }
      // #2987: tag 6 -- the same argument offsets the checker typed as a
      // shape the runtime renderer cannot print (`irc_resolves_to_unrenderable`).
      // The decoder folds them into the Int array under
      // `typed_render_refuse_key`, exactly as the direct lanes do.
      let mut ui = 0
      while ui < Array::length(unrenderable) {
        Array::push(enc, typed_lowering_enc(Array::get(unrenderable, ui), 6))
        ui = ui + 1
      }
      // #2441: the typed-`==` rows carry a String payload (the operand
      // TypeExpr's impl_target_key), so they cannot ride the Int-encoded
      // table -- they come back as their own pair of parallel arrays, under
      // the same located-channel refusal as the tables above.
      let (eq_only_offs, eq_only_keys) = eq_binop_type_keys_from_capture(checked, capture)
      // #3066: the render rows from the walk above, on the same channel.
      let (eq_render_offs, eq_render_keys) = append_render_rows(eq_only_offs, eq_only_keys, row_offs, row_keys)
      // #3133: the index-receiver rows ride the same channel.
      let (index_offs, index_keys) = index_receiver_rows_from_capture(checked, capture)
      let (eq_index_offs, eq_index_keys) = append_render_rows(eq_render_offs, eq_render_keys, index_offs, index_keys)
      // #3148: and the `for` iterand rows.
      let (forin_offs, forin_keys) = forin_receiver_rows_from_capture(checked, capture)
      let (eq_offs, eq_keys) = append_render_rows(eq_index_offs, eq_index_keys, forin_offs, forin_keys)
      for row in resolved_callee_capture_rows() {
        Array::push(enc, row)
      }
      (checked, Some(enc), eq_offs, eq_keys)
    }
  }
}

/// Check once and retain only source-located primary call results whose
/// checker-confirmed instantiated type is Double. Offset alone is not enough:
/// a dot-call receiver and its non-Double result can share the same offset.
export fn check_program_double_call_result_observation(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int], Array[Int], Array[String])] with Exception {
  match check_program_double_call_result_observation_impl(stmts) {
    None => None,
    Some((checked, out, _, _, eq_offs, eq_keys)) => Some((checked, out, eq_offs, eq_keys))
  }
}

/// #2158: the same observation with an explicit "this AST carried source
/// offsets" signal, for callers that would otherwise silently accept an inert
/// channel.
///
/// `None` means the offset space is UNUSABLE -- the program has primary call
/// results and not one of them is located, which is exactly what an unlocated
/// `parse_program(lex(source))` produces. `Some((checked, []))` still means the
/// honest "located, and no call result is a Double". A program with no calls at
/// all is located-vacuously and answers `Some((checked, []))` too; an empty set
/// classifies nothing either way, so that direction cannot be wrong.
export fn check_program_double_call_result_located_observation(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int], Array[Int], Array[String])] with Exception {
  match check_program_double_call_result_observation_impl(stmts) {
    None => None,
    Some((checked, out, primary_calls, located_primary_calls, eq_offs, eq_keys)) => if primary_calls > 0 && located_primary_calls == 0 {
      None
    } else {
      Some((checked, out, eq_offs, eq_keys))
    }
  }
}

/// Compatibility API: preserve the historical TypeEnv result and error
/// behavior while delegating through the successful production result.
export fn check_program(stmts: Array[Stmt]) -> TypeEnv with Exception {
  check_program_result(stmts).final_env
}

/// Mark an offset unknown when its copies disagree after substitution.
/// Used only after the or-arm check found a conflict; unrelated hover rows
/// remain available. Keeping an unknown row prevents query fallback from
/// resolving the conflicting name to an unrelated outer binding.
fn suppress_conflicting_hover_types(table: Array[(Int, Type)], final_s: Subst) -> Unit {
  let first: MutMap[Int, Type] = MutMap::new_int()
  let conflicts: MutMap[Int, Bool] = MutMap::new_int()
  let mut r = 0
  while r < Array::length(table) {
    let (off, ty) = Array::get(table, r)
    let resolved = subst_apply(final_s, ty)
    match MutMap::get(first, off) {
      None => MutMap::set(first, off, resolved),
      Some(previous) => if !types_equal(previous, resolved) {
        MutMap::set(conflicts, off, true)
      } else {
        ()
      }
    }
    r = r + 1
  }
  let mut i = 0
  while i < Array::length(table) {
    let row = Array::get(table, i)
    let (off, _) = row
    match MutMap::get(conflicts, off) {
      Some(_) => Array::set(table, i, (off, CtUnknown)),
      None => ()
    }
    i = i + 1
  }
}

/// Collecting variant of check_program for typed hover (vibe type-at): runs the
/// same inference but RETURNS the recorded (offset, Type) table plus the FINAL
/// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades
/// gracefully: any type error is swallowed and whatever table was collected so
/// far is returned, so hovering inside a partially-bad file still resolves the
/// names that were checked before the error. The table holds RAW (pre-final
/// subst) types; callers resolve via subst_apply(finalSubst, ty).
export fn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with Exception {
  derive_trait_namespace_operations(stmts)
  // #3301 (Codex on #3337): hover types an or-pattern handler arm's body the
  // way the check does -- split it into one arm per operation first, or the
  // `POr` arm is skipped and `let k = resume` inside it has no type. A
  // program the split refuses to expand is hovered unsplit, as the check
  // refuses it.
  handle {
    split_handler_or_arms(stmts, false)
  } with { Exception::Throw(_) => () }
  let handler_or_arms = Array::slice(handler_or_arm_groups(), 0, Array::length(handler_or_arm_groups()))
  let empty_defs = array_empty()
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits_for(EnvEmpty, builtin_seed_withheld(stmts, EnvEmpty))
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = array_empty()
  reset_return_provenance_index()
  reset_eq_formal_vars()
  reset_throw_payload_sites()
  handler_or_arm_resume_begin(handler_or_arms)
  set_generic_fn_decls(stmts)
  check_assignable_set_type_defs(empty_defs)
  // #3050: also record each local `let`'s value type, for hover alone.
  local_let_types_begin()
  handle {
    // #3042: hover sees the prelude `Ordering` the check does.
    let prelude_binders = array_empty()
    // The binder table has to stay aligned with `empty_defs`, which the
    // prelude just grew, so this goes through the binder-aware entry.
    let (prelude_env, prelude_defs_start, prelude_next_c) = seed_prelude_ordering(stmts, seeded_env, empty_defs, prelude_binders, 0, 0, frozen_errors, tytab)
    let (_, final_s0, _) = check_stmts_with_binders(stmts, 0, prelude_env, empty_defs, prelude_binders, prelude_defs_start, SubstEmpty, prelude_next_c, frozen_errors, tytab, None, None, None, false, true)
    // #2848 (Codex on #2864, round 3): a deferred field read is typed by a
    // result variable that the production check resolves at the end; hover
    // reads this table through the returned substitution, so resolve here too
    // or `p.value` under `let f: (Holder) -> Int = (p) -> { p.value }` would
    // show the variable instead of `Int`.
    let final_s = resolve_deferred_field_reads(final_s0, empty_defs, frozen_errors, false)
    let errors_before_or_arms = Array::length(frozen_errors)
    check_handler_or_arm_resume_types(handler_or_arms, empty_defs, final_s, frozen_errors)
    if Array::length(frozen_errors) > errors_before_or_arms {
      suppress_conflicting_hover_types(tytab, final_s)
      suppress_conflicting_hover_types(local_let_types(), final_s)
      suppress_conflicting_hover_types(local_let_rec_types(), final_s)
    } else {
      ()
    }
    erase_handler_or_arm_stamps(stmts)
    local_let_types_end()
    (tytab, final_s)
  } with { Exception::Throw(_) => {
    // No completed substitution is available after an inference failure.
    // Clear the arm recording and any contradictory partial rows too.
    let errors_before_or_arms = Array::length(frozen_errors)
    check_handler_or_arm_resume_types(handler_or_arms, empty_defs, SubstEmpty, frozen_errors)
    if Array::length(frozen_errors) > errors_before_or_arms {
      suppress_conflicting_hover_types(tytab, SubstEmpty)
      suppress_conflicting_hover_types(local_let_types(), SubstEmpty)
      suppress_conflicting_hover_types(local_let_rec_types(), SubstEmpty)
    } else {
      ()
    }
    erase_handler_or_arm_stamps(stmts)
    local_let_types_end()
    (tytab, SubstEmpty)
  } }
}

/// As `check_program_result`, seeded with an importing module's environment.
/// The non-empty path intentionally keeps the existing imported-module checks
/// and error behavior unchanged.
fn check_program_with_env_type_defs_observation_impl(stmts: Array[Stmt], initial_env: TypeEnv, capture: Option[CheckerStatementCapture], role_lane_capture: Option[TypedOccurrenceRoleLaneCapture], imports_already_projected: Bool) -> CheckedProgramTypeDefsObservation with Exception {
  match initial_env {
    EnvEmpty => check_program_type_defs_observation_impl(stmts, capture, role_lane_capture),
    _ => {
      let errors = ArrayBuilder::new()
      let frozen_errors = ArrayBuilder::freeze(errors)
      push_error_strings(collect_trait_namespace_conflict_errors(stmts, initial_env), frozen_errors)
      derive_imported_trait_namespace_operations(stmts, initial_env)
      derive_trait_namespace_operations(stmts)
      inject_trait_method_generics(stmts)
      // #635: lower `let*`/`?` railway sentinels before checking (see
      // check_program). This path checks each imported/entry file pre-codegen.
      desugar_railway_binds(stmts)
      check_import_kinds(stmts, initial_env, frozen_errors)
      canonicalize_stdin_provider_type_import_heads(stmts)
      collect_stdin_provider_direct_call_errors(stmts, frozen_errors)
      // #3086: see check_program.
      collect_constructor_binder_errors(stmts, initial_env, frozen_errors)
      // #3073: see check_program.
      collect_derive_field_errors(stmts, initial_env, frozen_errors)
      // #1455 step 3: see check_program.
      let qualified_pattern_refs = collect_qualified_pattern_refs(stmts)
      // #3421: which enums a pattern qualifies `Some` / `None` with.
      note_qualified_builtin_ctor_refs(qualified_pattern_refs)
      // #1001: mixed argument-mode validation before desugar (see check_program).
      check_labeled_arg_names_stmts(stmts, frozen_errors, true)
      // #986: reorder fully-labeled calls before checking (see check_program).
      desugar_labeled_args(stmts)
      // #1571: see check_program.
      desugar_inspect_calls(stmts)
      // #3301: see check_program.
      split_handler_or_arms(stmts, false)
      let handler_or_arms = Array::slice(handler_or_arm_groups(), 0, Array::length(handler_or_arm_groups()))
      // #1962 (Option 1): a direct host-builtin call inside a `handle` whose arms
      // name the same operation becomes `perform <Op>(..)`. BEFORE checking, so
      // the effect row the checker computes is the one the program actually has.
      desugar_handled_host_calls(stmts)
      // #2141: loud guard at the binder, before checking -- see the pass doc.
      collect_type_param_shadowing_errors(stmts, frozen_errors)
      let empty_defs = array_empty()
      let type_def_binders = array_empty()
      // #1455: register the imported enums BEFORE checking, so
      // `Enum::Variant`, exhaustiveness and pattern-payload checking all see
      // the same `TDEnum`s a same-file declaration would have produced.
      // `seed_next_c` is the first type-variable id seeding did NOT consume;
      // checking has to start there or a parameterized imported enum's formals
      // would be handed out a second time.
      let (local_defs_start, seed_defs_next_c) = seed_imported_type_defs(stmts, initial_env, empty_defs, type_def_binders)
      // #3149: and above every free variable an imported value carries.
      let imported_free_ceiling = env_free_tvar_ceiling(initial_env)
      let seed_next_c = if imported_free_ceiling > seed_defs_next_c {
        imported_free_ceiling
      } else {
        seed_defs_next_c
      }
      let cached_env = env_cache(initial_env)
      let seeded_raw_env = if trait_defined(cached_env, "Eq") {
        cached_env
      } else {
        register_builtin_traits_for(cached_env, builtin_seed_withheld(stmts, cached_env))
      }
      let seeded_env = env_cache(seeded_raw_env)
      let tytab = array_empty()
      reset_return_provenance_index()
      reset_eq_formal_vars()
      reset_throw_payload_sites()
      // #3301: the or-pattern arm copies the check after typing compares.
      handler_or_arm_resume_begin(handler_or_arms)
      set_generic_fn_decls(stmts)
      check_assignable_set_type_defs(empty_defs)
      // #986: labeled-argument name validation (see check_program).
      check_labeled_arg_names_stmts(stmts, frozen_errors, false)
      // Keep CheckedProgram.checked_stmts as the original post-desugar source,
      // but match the ordinary path by checking and validating an expanded copy.
      let expanded_stmts = es_expand_top_level_effectset_rows(stmts, initial_env)
      let statement_parent_path = match capture {
        Some(_) => Some(array_empty()),
        None => match role_lane_capture {
          Some(_) => Some(array_empty()),
          None => None
        }
      }
      // #3042: the prelude `Ordering`, after the imported type defs and
      // before the module's own (see seed_prelude_ordering).
      let (prelude_env, prelude_defs_start, prelude_next_c) = seed_prelude_ordering(expanded_stmts, seeded_env, empty_defs, type_def_binders, local_defs_start, seed_next_c, frozen_errors, tytab)
      let (env, final_s0, _) = check_stmts_with_binders(expanded_stmts, 0, prelude_env, empty_defs, type_def_binders, prelude_defs_start, SubstEmpty, prelude_next_c, frozen_errors, tytab, statement_parent_path, capture, role_lane_capture, imports_already_projected, true)
      // Selected import projection carries trait definitions and impls into
      // this environment, so user-trait bounds are checked here with the same
      // rule as the standalone path.
      // #2848: see the standalone path -- resolved before the bound check.
      let final_s = resolve_deferred_field_reads(final_s0, empty_defs, frozen_errors, false)
      check_program_bounds(env, final_s, empty_defs, frozen_errors)
      // #1858: same witness-carrier validation as the standalone path — the
      // projected env supplies imported traits' method tables, so a module
      // using an imported method-bearing trait (e.g. @vibe/core's Default)
      // is covered too.
      push_error_strings(collect_undispatchable_trait_method_errors(stmts, env), frozen_errors)
      publish_throw_site_kinds(final_s)
      set_call_formal_bindings(callee_formal_bindings(empty_defs, final_s))
      set_call_formal_marked_bindings(callee_formal_marked_bindings(empty_defs, final_s))
      set_shadowed_builtin_type_names(builtin_named_type_params(stmts))
      set_row_nominal_types(row_nominal_type_names(stmts, env, empty_defs))
      collect_async_effect_errors(expanded_stmts, env, empty_defs, frozen_errors)
      // #1455 step 3: `empty_defs` holds the imported enums seeded above plus
      // this module's own, which is exactly the set a qualifier may name.
      check_qualified_pattern_refs(qualified_pattern_refs, empty_defs, frozen_errors)
      // #3301: see check_program.
      check_handler_or_arm_resume_types(handler_or_arms, empty_defs, final_s, frozen_errors)
      // The split's group stamps are the checker's alone.
      erase_handler_or_arm_stamps(stmts)
      if Array::length(frozen_errors) > 0 {
        throw(Array::get(frozen_errors, 0))
      }
      // #1947: see the standalone path — marker is gone before codegen.
      erase_railway_origin_markers(stmts)
      CheckedProgramTypeDefsObservation::{
        checked_program: CheckedProgram::{
          checked_stmts: stmts,
          final_env: env,
          type_defs: empty_defs,
          final_subst: final_s,
          typed_occurrences: tytab
        },
        type_def_binders: type_def_binders
      }
    }
  }
}

/// Run the production checker once with an initial environment and expose
/// retained type-definition binder provenance for canonical observation.
export fn check_program_with_env_type_defs_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgramTypeDefsObservation with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, false)
}

/// As the ordinary statement-owner observation, seeded with an importing
/// environment. Validation failure is fail-closed as None.
export fn check_program_with_env_typed_occurrence_statement_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceStatementObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementTypedOccurrences(entries)), None, false).checked_program
  typed_occurrence_statement_observation_from_capture(checked, entries)
}

/// With-env form of the direct root-type observation. The initial environment
/// seeds checking only; nested module environments remain lexical.
export fn check_program_with_env_statement_root_type_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedStatementRootTypeObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementRootTypes(entries)), None, false).checked_program
  statement_root_type_observation_from_capture(checked, entries)
}

export fn check_program_with_env_typed_occurrence_role_lane_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceRoleLaneObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(entries), false).checked_program
  typed_occurrence_role_lane_observation_from_capture(checked, entries)
}

export fn check_program_with_env_typed_occurrence_expression_path_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceExpressionPathObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(entries), false).checked_program
  typed_occurrence_expression_path_observation_from_capture(checked, entries)
}

fn binder_scope_lookup(scope: Array[SourceBinder], name: String) -> Option[SourceBinder] {
  let mut i = Array::length(scope)
  let mut found = None
  while i > 0 && match found {
    Some(_) => false,
    None => true
  } {
    i = i - 1
    let binder = Array::get(scope, i)
    match binder {
      SourceToken(n, _, _) => if n == name {
        found = Some(binder)
      } else {
        ()
      },
      Synthetic(n, _) => if n == name {
        found = Some(binder)
      } else {
        ()
      }
    }
  }
  found
}

fn binder_scope_push(scope: Array[SourceBinder], binder: SourceBinder) -> Array[SourceBinder] {
  let next = Array::slice(scope, 0, Array::length(scope))
  Array::push(next, binder)
  next
}

fn binder_first_slot(node: BinderAuthorityNode) -> Option[SourceBinder] {
  let slots = binder_authority_node_slots(node)
  if Array::length(slots) == 0 {
    None
  } else {
    Some(binder_authority_slot_binder(Array::get(slots, 0)))
  }
}

fn collect_pattern_binders(node: BinderAuthorityNode, out: Array[SourceBinder]) -> Unit {
  let slots = binder_authority_node_slots(node)
  let mut i = 0
  while i < Array::length(slots) {
    Array::push(out, binder_authority_slot_binder(Array::get(slots, i)))
    i = i + 1
  }
  let children = binder_authority_node_children(node)
  let mut j = 0
  while j < Array::length(children) {
    collect_pattern_binders(Array::get(children, j), out)
    j = j + 1
  }
}

fn walk_binder_match_like(head: Expr, arms: Array[(Pat, Expr)], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let achildren = binder_authority_node_children(node)
  let n = Array::length(arms)
  if Array::length(achildren) != 1 + 2 * n {
    false
  } else {
    let mut ok = walk_binder_expr(head, Array::get(achildren, 0), scope, out)
    let mut i = 0
    while i < n && ok {
      let pat_node = Array::get(achildren, 1 + 2 * i)
      let body_node = Array::get(achildren, 2 + 2 * i)
      let (_, body) = Array::get(arms, i)
      let binders = array_empty()
      collect_pattern_binders(pat_node, binders)
      let mut inner = scope
      let mut bi = 0
      while bi < Array::length(binders) {
        inner = binder_scope_push(inner, Array::get(binders, bi))
        bi = bi + 1
      }
      ok = walk_binder_expr(body, body_node, inner, out)
      i = i + 1
    }
    ok
  }
}

fn walk_binder_for_in(iter: Expr, body: Expr, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let achildren = binder_authority_node_children(node)
  let slots = binder_authority_node_slots(node)
  if Array::length(achildren) != 2 || Array::length(slots) == 0 {
    false
  } else {
    if walk_binder_expr(iter, Array::get(achildren, 0), scope, out) {
      let mut inner = scope
      let mut i = 0
      while i < Array::length(slots) {
        inner = binder_scope_push(inner, binder_authority_slot_binder(Array::get(slots, i)))
        i = i + 1
      }
      walk_binder_expr(body, Array::get(achildren, 1), inner, out)
    } else {
      false
    }
  }
}

fn walk_binder_expr(expr: Expr, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let children = expr_children(expr)
  let achildren = binder_authority_node_children(node)
  match expr {
    EIdent(name, off) => match binder_scope_lookup(scope, name) {
      Some(SourceToken(_, start, end)) => {
        if off >= 0 {
          Array::push(out, (off, start, end))
        } else {
          ()
        }
        true
      },
      // Lowering-only identifiers have no source occurrence to publish. A
      // source-located use resolving to a synthetic binder would be an
      // unsupported provenance lane and must invalidate the observation.
      Some(Synthetic(_, _)) => off < 0,
      None => true
    },
    ELet(_, _, _, _) => walk_binder_let_like(children, achildren, node, scope, out, false),
    ELetMut(_, _, _, _) => walk_binder_let_like(children, achildren, node, scope, out, false),
    ELetRec(_, _, _) => walk_binder_let_like(children, achildren, node, scope, out, true),
    EFn(_, _, _, _, _, _) => walk_binder_fn(children, achildren, node, scope, out),
    EMatch(scrut, arms) => walk_binder_match_like(scrut, arms, node, scope, out),
    EHandle(body, arms) => walk_binder_match_like(body, arms, node, scope, out),
    EForIn(_, _, iter, body) => walk_binder_for_in(iter, body, node, scope, out),
    ELoop(_, _) => false,
    _ => {
      if Array::length(children) != Array::length(achildren) {
        false
      } else {
        let mut i = 0
        let mut ok = true
        while i < Array::length(children) && ok {
          ok = walk_binder_expr(Array::get(children, i), Array::get(achildren, i), scope, out)
          i = i + 1
        }
        ok
      }
    }
  }
}

fn walk_binder_let_like(children: Array[Expr], achildren: Array[BinderAuthorityNode], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)], recursive: Bool) -> Bool {
  if Array::length(children) != 2 || Array::length(achildren) != 2 {
    false
  } else {
    match binder_first_slot(node) {
      Some(binder) => {
        let inner = binder_scope_push(scope, binder)
        let value_scope = if recursive {
          inner
        } else {
          scope
        }
        walk_binder_expr(Array::get(children, 0), Array::get(achildren, 0), value_scope, out) && walk_binder_expr(Array::get(children, 1), Array::get(achildren, 1), inner, out)
      },
      None => false
    }
  }
}

fn walk_binder_fn(children: Array[Expr], achildren: Array[BinderAuthorityNode], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  if Array::length(children) == 0 || Array::length(achildren) != Array::length(children) {
    false
  } else {
    let mut inner = scope
    let slots = binder_authority_node_slots(node)
    let mut si = 0
    while si < Array::length(slots) {
      inner = binder_scope_push(inner, binder_authority_slot_binder(Array::get(slots, si)))
      si = si + 1
    }
    let mut i = 0
    let mut ok = true
    let last = Array::length(children) - 1
    while i < Array::length(children) && ok {
      let child_scope = if i == last {
        inner
      } else {
        scope
      }
      ok = walk_binder_expr(Array::get(children, i), Array::get(achildren, i), child_scope, out)
      i = i + 1
    }
    ok
  }
}

fn walk_binder_stmt(stmt: Stmt, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> (Bool, Array[SourceBinder]) {
  match stmt {
    SLet(_, _, _, _, value) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 1 {
          (false, scope)
        } else {
          let ok = walk_binder_expr(value, Array::get(children, 0), scope, out)
          (ok, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    SLetMut(_, _, value) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 1 {
          (false, scope)
        } else {
          let ok = walk_binder_expr(value, Array::get(children, 0), scope, out)
          (ok, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    SExpr(value) => {
      let children = binder_authority_node_children(node)
      if Array::length(children) != 1 {
        (false, scope)
      } else {
        (walk_binder_expr(value, Array::get(children, 0), scope, out), scope)
      }
    },
    SImport(_, _) => {
      let children = binder_authority_node_children(node)
      if Array::length(children) != 0 {
        (false, scope)
      } else {
        let slots = binder_authority_node_slots(node)
        let mut next = scope
        let mut i = 0
        while i < Array::length(slots) {
          next = binder_scope_push(next, binder_authority_slot_binder(Array::get(slots, i)))
          i = i + 1
        }
        (true, next)
      }
    },
    SAliasDecl(_, _) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 0 {
          (false, scope)
        } else {
          (true, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    _ => (false, scope)
  }
}

/// #1957: checker occurrence provenance from validated parser authority.
/// Each local identifier use is `(use_offset, binder_start, binder_end)`.
/// Distinct binders with the same name stay distinct. Free/builtin names
/// are not claimed. Shape mismatch fails closed.
export fn check_program_binder_occurrence_observation(authority: LocatedProgramBinderAuthority) -> Option[Array[(Int, Int, Int)]] with Exception {
  let program = located_program_binder_authority_program(authority)
  let roots = located_program_binder_authority_nodes(authority)
  if Array::length(roots) != Array::length(program) {
    None
  } else {
    let out = array_empty()
    let mut scope = array_empty()
    let mut i = 0
    let mut ok = true
    while i < Array::length(program) && ok {
      let walked = walk_binder_stmt(Array::get(program, i), Array::get(roots, i), scope, out)
      ok = walked.0
      scope = walked.1
      i = i + 1
    }
    if ok {
      Some(out)
    } else {
      None
    }
  }
}

/// With-env variant of the complete direct-primary return observation.
export fn check_program_with_env_direct_expression_return_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedDirectExpressionReturnObservation] with Exception {
  match checked_expression_structure_rows(stmts) {
    None => None,
    Some(_) => {
      let capture = direct_expression_return_capture()
      let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementDirectExpressionReturns), Some(capture), false).checked_program
      direct_expression_return_observation_from_capture(checked, capture)
    }
  }
}

/// Successful production-check result, preserving the original public shape.
export fn check_program_with_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, false).checked_program
}

/// Production-only checker entry for an environment already projected from
/// this root module's import declarations. Root import statements must not
/// replay type-only bindings over that authoritative environment; nested
/// modules deliberately retain the historical replay path.
export fn check_program_with_projected_import_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, true).checked_program
}

/// Compatibility API: preserve the historical TypeEnv result and error
/// behavior while delegating through the successful production result.
export fn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with Exception {
  check_program_with_env_result(stmts, initial_env).final_env
}
