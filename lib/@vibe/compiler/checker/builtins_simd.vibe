//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

// #536: first-class WebAssembly 128-bit SIMD (V128) intrinsics. The V128 type is
// represented structurally as CtNamed("V128", []) (no core Type enum variant),
// exactly like Future/Stream/Task in builtins_async.vibe. Each intrinsic is bound
// to one or more wasm SIMD instructions; codegen is inline in
// codegen/expr/compile_call.vibe (non-RC linear backend only). The signatures
// below mirror declarations.vibe:201-214 and are the source of truth.

fn simd_no_params() -> Array[Type] {
  array_empty()
}

fn simd_v128_ty() -> Type {
  CtNamed("V128", simd_no_params())
}

fn simd_one_param(a: Type) -> Array[Type] {
  let arr = simd_no_params()
  Array::push(arr, a)
  arr
}

fn simd_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = simd_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn simd_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = simd_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

/// Loads / stores against a Bytes payload.
fn lookup_simd_mem(name: String) -> Option[Type] {
  if name == "v128_load" {
    // v128_load(Bytes, Int) -> V128
    Some(CtFn(simd_two_params(CtBytes, CtInt), simd_v128_ty(), None))
  } else if name == "v128_store" {
    // v128_store(Bytes, Int, V128) -> Unit
    Some(CtFn(simd_three_params(CtBytes, CtInt, simd_v128_ty()), CtUnit, None))
  } else {
    None
  }
}

/// splat + binary lane ops returning V128.
fn lookup_simd_lane_a(name: String) -> Option[Type] {
  if name == "v128_splat_i8x16" {
    // v128_splat_i8x16(Int) -> V128
    Some(CtFn(simd_one_param(CtInt), simd_v128_ty(), None))
  } else if name == "v128_eq_i8x16" {
    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))
  } else if name == "v128_le_u_i8x16" {
    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))
  } else if name == "v128_ge_u_i8x16" {
    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))
  } else {
    None
  }
}

/// bitwise ops returning V128.
fn lookup_simd_lane_b(name: String) -> Option[Type] {
  if name == "v128_and" {
    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))
  } else if name == "v128_or" {
    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))
  } else if name == "v128_not" {
    Some(CtFn(simd_one_param(simd_v128_ty()), simd_v128_ty(), None))
  } else {
    None
  }
}

/// reductions returning Int / Bool.
fn lookup_simd_reduce(name: String) -> Option[Type] {
  if name == "v128_bitmask_i8x16" {
    // v128_bitmask_i8x16(V128) -> Int
    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))
  } else if name == "v128_any_true" {
    // v128_any_true(V128) -> Bool
    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))
  } else if name == "v128_all_true_i8x16" {
    // v128_all_true_i8x16(V128) -> Bool
    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))
  } else {
    None
  }
}

export fn lookup_simd(name: String) -> Option[Type] {
  match lookup_simd_mem(name) {
    Some(t) => Some(t),
    None => match lookup_simd_lane_a(name) {
      Some(t) => Some(t),
      None => match lookup_simd_lane_b(name) {
        Some(t) => Some(t),
        None => lookup_simd_reduce(name)
      }
    }
  }
}
