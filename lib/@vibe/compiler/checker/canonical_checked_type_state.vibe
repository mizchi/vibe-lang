//# Canonical checked value-environment observation (# canonical-checked-type-state)
//
// The value-environment API below deliberately observes only CheckedProgram.final_env
// and final_subst. The separate typedef API at the end observes retained type
// definitions plus their declaration-time binder provenance. The trait-impl API
// observes only retained implementation entries. None serializes checked
// statements, trait definitions, typed occurrences, runtime sidecars, or cache state.

import @vibe/compiler/core {
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  __to_string,
  canonical_exception_effect_name,
  env_name_index_at,
  env_name_index_length,
  is_effect_inst_label,
  str_lt,
  subst_lookup
}

import @vibe/core {
  array_empty
}

import @vibe/ast {
  type_param_arity, type_param_name
}

// #2125: the two observation wrappers below annotate parameters with types
// this package's contract declares BODYLESS (`type CheckedProgram`). A
// bodyless declaration has no `TypeDef`, so the annotation used to resolve to
// a bare `CtNamed` -- indistinguishable from a typo, and unchecked. Import
// the real declarations from the sibling that owns them.
import ./checker_stmt.vibe {
  CheckedProgram, CheckedProgramTypeDefsObservation
}

//# Encoding helpers

fn canonical_piece(_ text: String) -> String {
  String::concat(__to_string(String::length(text)), String::concat(":", text))
}

fn canonical_node(tag: String, fields: Array[String]) -> String {
  let mut out = String::concat(tag, __to_string(Array::length(fields)))
  let mut i = 0
  while i < Array::length(fields) {
    out = String::concat(out, canonical_piece(Array::get(fields, at = i)))
    i = i + 1
  }
  out
}

fn int_in(items: Array[Int], id: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, at = i) == id {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn int_index(items: Array[Int], id: Int) -> Int {
  let mut i = 0
  let mut out = -1
  while i < Array::length(items) && out < 0 {
    if Array::get(items, at = i) == id {
      out = i
    } else {
      i = i + 1
    }
  }
  out
}

fn string_in(items: Array[String], item: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, at = i) == item {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn sorted_unique_strings(_ items: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    if !string_in(items = out, item = item) {
      let mut at = Array::length(out)
      let mut j = 0
      while j < Array::length(out) && at == Array::length(out) {
        if str_lt(a = item, b = Array::get(out, at = j)) {
          at = j
        } else {
          j = j + 1
        }
      }
      Array::push(out, value = item)
      let mut k = Array::length(out) - 1
      while k > at {
        Array::set(out, at = k, value = Array::get(out, at = k - 1))
        k = k - 1
      }
      Array::set(out, at = at, value = item)
    }
    i = i + 1
  }
  out
}

//# Effect rows

// This is nesting-aware: generic effect labels can themselves contain commas.
fn canonical_effect_labels(_ text: String) -> Array[String] {
  let raw = array_empty()
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i < String::length(text) {
    let c = String::char_code_at(text, at = i)
    if c == 91 || c == 40 || c == 123 {
      depth = depth + 1
    } else if (c == 93 || c == 41 || c == 125) && depth > 0 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      let label = String::trim(String::substring(text, start = start, end = i))
      if String::length(label) > 0 && !canonical_is_provenance_label(label) {
        Array::push(raw, value = canonical_exception_effect_name(label))
      }
      start = i + 1
    }
    i = i + 1
  }
  let last = String::trim(String::substring(text, start = start, end = String::length(text)))
  if String::length(last) > 0 && !canonical_is_provenance_label(last) {
    Array::push(raw, value = canonical_exception_effect_name(last))
  }
  sorted_unique_strings(raw)
}

fn canonical_is_provenance_label(_ label: String) -> Bool {
  String::starts_with(label, prefix = "#region_") || String::starts_with(label, prefix = "#capture[") || String::starts_with(label, prefix = "#param[") || String::starts_with(label, prefix = "#aliasparam[") || String::starts_with(label, prefix = "#fieldparam[") || is_effect_inst_label(label)
}

fn canonical_is_effect_var(_ name: String) -> Bool {
  let len = String::length(name)
  if len == 1 {
    String::char_code_at(name, at = 0) >= 97 && String::char_code_at(name, at = 0) <= 122
  } else if len >= 2 {
    String::char_code_at(name, at = 0) == 36
  } else {
    false
  }
}

fn canonical_effect_lookup(s: Subst, name: String, seen: Array[String]) -> Option[String] {
  if string_in(items = seen, item = name) {
    Some(name)
  } else {
    let next_seen = Array::slice(seen, start = 0, end = Array::length(seen))
    Array::push(next_seen, value = name)
    let mut cur = s
    let mut found = None
    let mut done = false
    while !done {
      match cur {
        SubstEmpty => {
          done = true
        },
        SubstBind(_, _, rest) => {
          cur = rest
        },
        SubstBound(_, _, rest) => {
          cur = rest
        },
        SubstValueRange(_, rest) => {
          cur = rest
        },
        SubstCached(_, _, rest) => {
          cur = rest
        },
        SubstEffBind(v, value, rest) => if v == name {
          found = Some(value)
          done = true
        } else {
          cur = rest
        }
      }
    }
    match found {
      Some(value) => if canonical_is_effect_var(value) {
        canonical_effect_lookup(s = s, name = value, seen = next_seen)
      } else {
        Some(value)
      },
      None => None
    }
  }
}

fn canonical_effect(s: Subst, effect: Option[String]) -> String {
  match effect {
    None => canonical_node(tag = "EP", fields = array_empty()),
    Some(name) => {
      let resolved = if canonical_is_effect_var(name) {
        canonical_effect_lookup(s = s, name = name, seen = array_empty())
      } else {
        Some(name)
      }
      match resolved {
        Some(text) => {
          let labels = canonical_effect_labels(text)
          if String::length(text) == 0 || Array::length(labels) == 0 {
            canonical_node(tag = "EP", fields = array_empty())
          } else {
            canonical_node(tag = "ER", fields = labels)
          }
        },
        None => canonical_node(tag = "EV", fields = [name])
      }
    }
  }
}

/// Canonical observation-only identity for one stringly checked effect row.
/// This is intentionally a narrow helper: it follows final SubstEffBind
/// chains, normalizes unordered labels and the project's Error/Exception
/// alias semantics, but does not introduce a structured EffectRow transport.
export fn canonical_checked_effect_row_snapshot(s: Subst, effect: Option[String]) -> String {
  canonical_effect(s = s, effect = effect)
}

//# Type alpha-normalization

fn canonical_free_var(id: Int, free_ids: Array[Int], free_names: Array[String]) -> String {
  let found = int_index(items = free_ids, id = id)
  if found >= 0 {
    Array::get(free_names, at = found)
  } else {
    let name = String::concat("f", __to_string(Array::length(free_ids)))
    Array::push(free_ids, value = id)
    Array::push(free_names, value = name)
    name
  }
}

fn canonical_bounds_for(vars: Array[Int], rows: Array[(Int, Array[String])], id: Int) -> String {
  let labels = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (row_id, row_labels) = Array::get(rows, at = i)
    if row_id == id {
      let mut j = 0
      while j < Array::length(row_labels) {
        Array::push(labels, value = Array::get(row_labels, at = j))
        j = j + 1
      }
    }
    i = i + 1
  }
  canonical_node(tag = "B", fields = sorted_unique_strings(labels))
}

fn canonical_named_bound(names: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) && found < 0 {
    if type_param_name(Array::get(names, at = i)) == name {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

fn canonical_param_arities(_ params: Array[String]) -> String {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    Array::push(fields, value = __to_string(type_param_arity(Array::get(params, at = i))))
    i = i + 1
  }
  canonical_node(tag = "K", fields = fields)
}

fn canonical_type(ty: Type, s: Subst, bound_ids: Array[Int], bound_names: Array[String], free_ids: Array[Int], free_names: Array[String], resolving: Array[Int]) -> String {
  match ty {
    CtInt => canonical_node(tag = "I", fields = array_empty()),
    CtDouble => canonical_node(tag = "D", fields = array_empty()),
    CtFloat => canonical_node(tag = "W", fields = array_empty()),
    CtBool => canonical_node(tag = "Z", fields = array_empty()),
    CtString => canonical_node(tag = "S", fields = array_empty()),
    CtChar => canonical_node(tag = "C", fields = array_empty()),
    CtUnit => canonical_node(tag = "U", fields = array_empty()),
    CtBytes => canonical_node(tag = "Y", fields = array_empty()),
    CtUnknown => canonical_node(tag = "X", fields = array_empty()),
    CtVar(id) => {
      let bound_at = int_index(items = bound_ids, id = id)
      if bound_at >= 0 {
        canonical_node(tag = "Q", fields = [__to_string(bound_at)])
      } else if int_in(items = resolving, id = id) {
        canonical_node(tag = "V", fields = [
          canonical_free_var(id = id, free_ids = free_ids, free_names = free_names)
        ])
      } else {
        match subst_lookup(s = s, id = id) {
          Some(next) => {
            let next_resolving = Array::slice(resolving, start = 0, end = Array::length(resolving))
            Array::push(next_resolving, value = id)
            canonical_type(ty = next, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = next_resolving)
          },
          None => canonical_node(tag = "V", fields = [
            canonical_free_var(id = id, free_ids = free_ids, free_names = free_names)
          ])
        }
      }
    },
    CtConstructor(name, arity) => canonical_node(tag = "H", fields = [
      name,
      __to_string(arity)
    ]),
    CtApplied(head, args) => {
      let fields = [
        canonical_type(ty = head, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving)
      ]
      let mut i = 0
      while i < Array::length(args) {
        Array::push(fields, value = canonical_type(ty = Array::get(args, at = i), s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
        i = i + 1
      }
      canonical_node(tag = "P", fields = fields)
    },
    CtTuple(items) => {
      let fields = array_empty()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(fields, value = canonical_type(ty = Array::get(items, at = i), s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
        i = i + 1
      }
      canonical_node(tag = "T", fields = fields)
    },
    // #1839: anonymous record — field names participate in the canonical
    // form (they are part of the type), literal order preserved.
    CtRecord(rfields) => {
      let kfields = array_empty()
      let mut ki = 0
      while ki < Array::length(rfields) {
        let (kname, kty) = Array::get(rfields, at = ki)
        Array::push(kfields, value = kname)
        Array::push(kfields, value = canonical_type(ty = kty, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
        ki = ki + 1
      }
      canonical_node(tag = "K", fields = kfields)
    },
    CtArray(item) => canonical_node(tag = "A", fields = [
      canonical_type(ty = item, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving)
    ]),
    CtOption(item) => canonical_node(tag = "O", fields = [
      canonical_type(ty = item, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving)
    ]),
    CtEnum(name) => canonical_node(tag = "N", fields = [name]),
    CtStruct(name) => canonical_node(tag = "R", fields = [name]),
    CtNamed(name, args) => {
      let bound_at = if Array::length(args) == 0 {
        canonical_named_bound(names = bound_names, name = name)
      } else {
        -1
      }
      if bound_at >= 0 {
        canonical_node(tag = "Q", fields = [__to_string(bound_at)])
      } else {
        let fields = [name]
        let mut i = 0
        while i < Array::length(args) {
          Array::push(fields, value = canonical_type(ty = Array::get(args, at = i), s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
          i = i + 1
        }
        canonical_node(tag = "M", fields = fields)
      }
    },
    CtFn(params, ret, effect) => {
      let fields = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(fields, value = canonical_type(ty = Array::get(params, at = i), s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
        i = i + 1
      }
      Array::push(fields, value = canonical_type(ty = ret, s = s, bound_ids = bound_ids, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
      Array::push(fields, value = canonical_effect_with_params(s = s, effect = effect, params = bound_names))
      canonical_node(tag = "F", fields = fields)
    },
    CtForAll(vars, rows, body) => {
      // The locally introduced ids precede outer ids, so Q0 is always the
      // innermost lexical binder and outer binders shift outward.
      let nested_bound = Array::slice(vars, start = 0, end = Array::length(vars))
      let mut i = 0
      while i < Array::length(bound_ids) {
        Array::push(nested_bound, value = Array::get(bound_ids, at = i))
        i = i + 1
      }
      let fields = array_empty()
      let mut j = 0
      while j < Array::length(vars) {
        let id = Array::get(vars, at = j)
        // Each row is emitted at its binder position; rows are never sorted.
        Array::push(fields, value = canonical_bounds_for(vars = vars, rows = rows, id = id))
        j = j + 1
      }
      Array::push(fields, value = canonical_type(ty = body, s = s, bound_ids = nested_bound, bound_names = bound_names, free_ids = free_ids, free_names = free_names, resolving = resolving))
      canonical_node(tag = "G", fields = fields)
    }
  }
}

//# Effective environment collection

fn canonical_name_seen(names: Array[String], name: String) -> Bool {
  string_in(items = names, item = name)
}

/// Checker-internal entries that must not surface in a semantic environment
/// snapshot: per-function return markers, and every `#`-prefixed sentinel --
/// `#` is rejected in identifiers, so no parsed source can bind such a name
/// and its presence is pure checker bookkeeping (e.g. the negative
/// #active_region entry env_cache seeds into every acceleration index).
/// Filtering here keeps cached and uncached environments canonically equal.
fn canonical_env_name_is_internal(_ name: String) -> Bool {
  String::starts_with(name, prefix = "__fn_ret__:") || String::starts_with(name, prefix = "#")
}

fn canonical_collect_effective_bindings(_ env: TypeEnv) -> Array[(String, Type)] {
  let out = array_empty()
  let seen = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(name, binding, rest) => {
        if !canonical_name_seen(names = seen, name = name) {
          Array::push(seen, value = name)
          if !canonical_env_name_is_internal(name) {
            Array::push(out, value = (name, binding.ty))
          }
        }
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(bindings) => {
        let mut i = 0
        while i < Array::length(bindings) {
          let (name, binding) = Array::get(bindings, at = i)
          if !canonical_name_seen(names = seen, name = name) {
            Array::push(seen, value = name)
            if !canonical_env_name_is_internal(name) {
              Array::push(out, value = (name, binding.ty))
            }
          }
          i = i + 1
        }
        done = true
      },
      EnvCached(names, types, rest) => {
        let mut i = 0
        while i < env_name_index_length(names) {
          let name = env_name_index_at(index = names, row = i)
          if !canonical_name_seen(names = seen, name = name) {
            Array::push(seen, value = name)
            if !canonical_env_name_is_internal(name) {
              Array::push(out, value = (name, Array::get(types, at = i).ty))
            }
          }
          i = i + 1
        }
        cur = rest
      }
    }
  }
  out
}

fn canonical_sorted_bindings(_ bindings: Array[(String, Type)]) -> Array[(String, Type)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(bindings) {
    let item = Array::get(bindings, at = i)
    let (name, _) = item
    let mut at = Array::length(out)
    let mut j = 0
    while j < Array::length(out) && at == Array::length(out) {
      let (other, _) = Array::get(out, at = j)
      if str_lt(a = name, b = other) {
        at = j
      } else {
        j = j + 1
      }
    }
    Array::push(out, value = item)
    let mut k = Array::length(out) - 1
    while k > at {
      Array::set(out, at = k, value = Array::get(out, at = k - 1))
      k = k - 1
    }
    Array::set(out, at = at, value = item)
    i = i + 1
  }
  out
}

/// Canonical, observation-only effective value environment. It intentionally
/// excludes statements, type definitions, traits/impls, and typed occurrences.
export fn canonical_effective_value_env_snapshot(env: TypeEnv, s: Subst) -> String {
  let bindings = canonical_sorted_bindings(canonical_collect_effective_bindings(env))
  let free_ids = array_empty()
  let free_names = array_empty()
  let fields = ["v3"]
  let mut i = 0
  while i < Array::length(bindings) {
    let (name, ty) = Array::get(bindings, at = i)
    Array::push(fields, value = canonical_node(tag = "B", fields = [
      name,
      canonical_type(ty = ty, s = s, bound_ids = array_empty(), bound_names = array_empty(), free_ids = free_ids, free_names = free_names, resolving = array_empty())
    ]))
    i = i + 1
  }
  canonical_node(tag = "CEVS", fields = fields)
}

/// CheckedProgram wrapper: observes only final_env and final_subst.
export fn canonical_checked_value_env_snapshot(_ checked: CheckedProgram) -> String {
  canonical_effective_value_env_snapshot(env = checked.final_env, s = checked.final_subst)
}

/// Canonicalize a capture-ordered list of raw types with one shared alpha-name
/// table, so relationships between free vars across rows remain observable.
/// This is observation formatting only, not a persistent type codec.
export fn canonical_checked_occurrence_type_fields(types: Array[Type], s: Subst) -> Array[String] {
  let free_ids = array_empty()
  let free_names = array_empty()
  let out = array_empty()
  let mut i = 0
  while i < Array::length(types) {
    Array::push(out, value = canonical_type(ty = Array::get(types, at = i), s = s, bound_ids = array_empty(), bound_names = array_empty(), free_ids = free_ids, free_names = free_names, resolving = array_empty()))
    i = i + 1
  }
  out
}

//# Retained trait-implementation observation

// A non-negative result is the declared parameter position. -1 is unbound;
// -2 is ambiguous because a malformed declaration repeats the name. Both are
// represented explicitly rather than silently associating a bound with a
// different parameter.
fn canonical_trait_impl_param_position(params: Array[String], name: String) -> Int {
  let mut i = 0
  let mut position = -1
  let mut matches = 0
  while i < Array::length(params) {
    if type_param_name(Array::get(params, at = i)) == name {
      position = i
      matches = matches + 1
    } else {
      ()
    }
    i = i + 1
  }
  if matches == 0 {
    -1
  } else if matches == 1 {
    position
  } else {
    -2
  }
}

// Trait bounds are semantic sets. Valid rows are therefore aggregated by
// declared parameter position, and labels are sorted and deduplicated exactly
// as quantified bounds are in canonical_bounds_for. Malformed references keep
// their raw name in explicit failure nodes so they cannot collide with valid
// entries.
fn canonical_trait_impl_bounds(params: Array[String], bounds: Array[(String, Array[String])]) -> String {
  let rows = array_empty()
  let mut position = 0
  while position < Array::length(params) {
    let labels = array_empty()
    let mut i = 0
    while i < Array::length(bounds) {
      let (name, row_labels) = Array::get(bounds, at = i)
      if canonical_trait_impl_param_position(params = params, name = name) == position {
        let mut j = 0
        while j < Array::length(row_labels) {
          Array::push(labels, value = Array::get(row_labels, at = j))
          j = j + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
    let label_set = sorted_unique_strings(labels)
    let label_encoding = canonical_node(tag = "L", fields = label_set)
    let row = canonical_node(tag = "R", fields = [
      __to_string(position),
      label_encoding
    ])
    Array::push(rows, value = row)
    position = position + 1
  }
  let malformed = array_empty()
  let mut i = 0
  while i < Array::length(bounds) {
    let (name, labels) = Array::get(bounds, at = i)
    let position = canonical_trait_impl_param_position(params = params, name = name)
    if position == -1 {
      let label_set = sorted_unique_strings(labels)
      let label_encoding = canonical_node(tag = "L", fields = label_set)
      let marker = canonical_node(tag = "M", fields = [
        "reason",
        "unbound_bound_parameter",
        "name",
        name,
        "labels",
        label_encoding
      ])
      Array::push(malformed, value = marker)
    } else if position == -2 {
      let label_set = sorted_unique_strings(labels)
      let label_encoding = canonical_node(tag = "L", fields = label_set)
      let marker = canonical_node(tag = "M", fields = [
        "reason",
        "ambiguous_bound_parameter",
        "name",
        name,
        "labels",
        label_encoding
      ])
      Array::push(malformed, value = marker)
    } else {
      ()
    }
    i = i + 1
  }
  let normalized_malformed = sorted_unique_strings(malformed)
  let mut j = 0
  while j < Array::length(normalized_malformed) {
    Array::push(rows, value = Array::get(normalized_malformed, at = j))
    j = j + 1
  }
  canonical_node(tag = "B", fields = rows)
}

fn canonical_trait_impl_entry(trait_name: String, target: Type, s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {
  let encoded_target = canonical_type(ty = target, s = s, bound_ids = array_empty(), bound_names = array_empty(), free_ids = free_ids, free_names = free_names, resolving = array_empty())
  canonical_node(tag = "I", fields = [trait_name, encoded_target])
}

fn canonical_trait_impl_gen_entry(trait_name: String, params: Array[String], bounds: Array[(String, Array[String])], target: Type, s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {
  let encoded_bounds = canonical_trait_impl_bounds(params = params, bounds = bounds)
  // Generic targets retain their complete applied type. Treat the impl's
  // rigid parameter names as bound names so alpha-renaming a declaration does
  // not change the snapshot while argument order and concrete slots remain
  // observable.
  let encoded_target = canonical_type(ty = target, s = s, bound_ids = array_empty(), bound_names = params, free_ids = free_ids, free_names = free_names, resolving = array_empty())
  canonical_node(tag = "G", fields = [
    trait_name,
    __to_string(Array::length(params)),
    canonical_param_arities(params),
    encoded_bounds,
    encoded_target
  ])
}

/// Canonical, observation-only retained trait-implementation snapshot. It
/// preserves final-environment traversal order and includes only EnvTraitImpl
/// and EnvTraitImplGen entries. Generic parameter names are alpha-normalized
/// by declaration position; bounds retain association as semantic sets.
/// The complete retained target is encoded after the same alpha-normalization,
/// so concrete slots and reordered generic arguments remain observable.
/// EnvFlat and EnvEmpty terminate traversal; trait definitions, values, cache
/// payloads, and all other CheckedProgram state are excluded.
export fn canonical_retained_trait_impl_entries_snapshot(env: TypeEnv, s: Subst) -> String {
  let fields = ["v4"]
  let free_ids = array_empty()
  let free_names = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(trait_name, target, rest) => {
        let entry = canonical_trait_impl_entry(trait_name = trait_name, target = target, s = s, free_ids = free_ids, free_names = free_names)
        Array::push(fields, value = entry)
        cur = rest
      },
      EnvTraitImplGen(trait_name, params, bounds, target, rest) => {
        let entry = canonical_trait_impl_gen_entry(trait_name = trait_name, params = params, bounds = bounds, target = target, s = s, free_ids = free_ids, free_names = free_names)
        Array::push(fields, value = entry)
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  canonical_node(tag = "CTIS", fields = fields)
}

//# Retained trait method-generic observation

// Method-generic bounds share the generic-impl encoding above: declared
// parameter positions are the alpha-normal names, bounds are semantic sets,
// and unbound or ambiguous rows are explicit malformed nodes. Add a separate
// duplicate-parameter marker because a duplicate declaration with no bounds
// would otherwise serialize like two distinct unbounded parameters.
fn canonical_trait_method_generic_entry(params: Array[String], bounds: Array[(String, Array[String])]) -> String {
  let fields = [
    __to_string(Array::length(params)),
    canonical_param_arities(params),
    canonical_trait_impl_bounds(params = params, bounds = bounds)
  ]
  let mut position = 0
  while position < Array::length(params) {
    let name = type_param_name(Array::get(params, at = position))
    let mut matches = 0
    let mut i = 0
    while i < Array::length(params) {
      if type_param_name(Array::get(params, at = i)) == name {
        matches = matches + 1
      } else {
        ()
      }
      i = i + 1
    }
    if matches > 1 {
      Array::push(fields, value = canonical_node(tag = "M", fields = [
        "reason",
        "ambiguous_method_parameter",
        "position",
        __to_string(position)
      ]))
    } else {
      ()
    }
    position = position + 1
  }
  canonical_node(tag = "G", fields = fields)
}

fn canonical_retained_trait_method_gens_entry(trait_name: String, methods: Array[(String, Array[TypeExpr], TypeExpr)], method_gens: Array[(String, Array[String], Array[(String, Array[String])])]) -> String {
  let fields = [trait_name, __to_string(Array::length(methods))]
  let mut position = 0
  while position < Array::length(methods) {
    let (method_name, _, _) = Array::get(methods, at = position)
    if position >= Array::length(method_gens) {
      Array::push(fields, value = canonical_node(tag = "M", fields = [
        "reason",
        "missing_method_generic_provenance",
        "position",
        __to_string(position),
        "method",
        method_name
      ]))
    } else {
      let (source_method, params, bounds) = Array::get(method_gens, at = position)
      let generic = canonical_trait_method_generic_entry(params = params, bounds = bounds)
      if source_method == method_name {
        Array::push(fields, value = canonical_node(tag = "R", fields = [
          __to_string(position),
          generic
        ]))
      } else {
        Array::push(fields, value = canonical_node(tag = "M", fields = [
          "reason",
          "method_name_mismatch",
          "position",
          __to_string(position),
          "method",
          method_name,
          "source_method",
          source_method,
          "generic",
          generic
        ]))
      }
    }
    position = position + 1
  }
  while position < Array::length(method_gens) {
    let (source_method, params, bounds) = Array::get(method_gens, at = position)
    Array::push(fields, value = canonical_node(tag = "M", fields = [
      "reason",
      "surplus_method_generic_provenance",
      "position",
      __to_string(position),
      "source_method",
      source_method,
      "generic",
      canonical_trait_method_generic_entry(params = params, bounds = bounds)
    ]))
    position = position + 1
  }
  canonical_node(tag = "T", fields = fields)
}

/// Canonical, observation-only trait method-generic provenance retained by the
/// checker in EnvTraitDef. Entries preserve final-environment traversal order;
/// generic parameter spellings are alpha-normalized by position and method
/// generic rows pair with method signatures only by position. Missing,
/// surplus, duplicate, unbound, ambiguous, and mismatched provenance becomes
/// explicit data rather than silently becoming an empty generic declaration.
/// This is not source interface identity, trace schema, cache key, or reuse
/// decision. EnvFlat and EnvEmpty terminate traversal.
export fn canonical_retained_trait_method_gens_snapshot(_ env: TypeEnv) -> String {
  let fields = ["v3"]
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(trait_name, _, _, methods, rest, _, method_gens) => {
        Array::push(fields, value = canonical_retained_trait_method_gens_entry(trait_name = trait_name, methods = methods, method_gens = method_gens))
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  canonical_node(tag = "CTMGS", fields = fields)
}

//# Retained type-definition observation

// Normalize only complete identifier tokens, so a parameter `T` does not
// accidentally rewrite a nominal name such as `Thing` in an effect label.
fn canonical_effect_label_with_params(label: String, params: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < String::length(label) {
    let code = String::char_code_at(label, at = i)
    let is_ident = (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95
    if is_ident {
      let start = i
      while i < String::length(label) {
        let inner = String::char_code_at(label, at = i)
        if (inner >= 65 && inner <= 90) || (inner >= 97 && inner <= 122) || (inner >= 48 && inner <= 57) || inner == 95 {
          i = i + 1
        } else {
          ()
          // Break by advancing no further; the outer loop consumes punctuation.
          break
        }
      }
      let token = String::substring(label, start = start, end = i)
      let at = canonical_named_bound(names = params, name = token)
      if at >= 0 {
        out = String::concat(out, String::concat("Q", __to_string(at)))
      } else {
        out = String::concat(out, token)
      }
    } else {
      out = String::concat(out, String::substring(label, start = i, end = i + 1))
      i = i + 1
    }
  }
  out
}

fn canonical_effect_with_params(s: Subst, effect: Option[String], params: Array[String]) -> String {
  match effect {
    None => canonical_node(tag = "EP", fields = array_empty()),
    Some(name) => {
      let resolved = if canonical_is_effect_var(name) {
        canonical_effect_lookup(s = s, name = name, seen = array_empty())
      } else {
        Some(name)
      }
      match resolved {
        Some(text) => {
          let labels = canonical_effect_labels(text)
          if String::length(text) == 0 || Array::length(labels) == 0 {
            canonical_node(tag = "EP", fields = array_empty())
          } else {
            let normalized = array_empty()
            let mut i = 0
            while i < Array::length(labels) {
              Array::push(normalized, value = canonical_effect_label_with_params(label = Array::get(labels, at = i), params = params))
              i = i + 1
            }
            canonical_node(tag = "ER", fields = sorted_unique_strings(normalized))
          }
        },
        None => canonical_node(tag = "EV", fields = [
          canonical_effect_label_with_params(label = name, params = params)
        ])
      }
    }
  }
}

fn canonical_typedef_type(ty: Type, s: Subst, enum_binders: Array[Int], rigid_params: Array[String], free_ids: Array[Int], free_names: Array[String]) -> String {
  // `canonical_type` handles bound CtVar before looking in `s`, making enum
  // declaration binders substitution-safe. CtNamed rigid params are handled
  // before their nominal encoding for structs, aliases, and effects.
  canonical_type(ty = ty, s = s, bound_ids = enum_binders, bound_names = rigid_params, free_ids = free_ids, free_names = free_names, resolving = array_empty())
}

fn canonical_typedef(def: TypeDef, binders: Array[Int], s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {
  match def {
    TDEnum(name, params, variants) => {
      let fields = [
        name,
        __to_string(Array::length(params)),
        canonical_param_arities(params)
      ]
      let mut i = 0
      while i < Array::length(variants) {
        let (variant_name, payloads) = Array::get(variants, at = i)
        let variant_fields = [variant_name]
        let mut j = 0
        while j < Array::length(payloads) {
          Array::push(variant_fields, value = canonical_typedef_type(ty = Array::get(payloads, at = j), s = s, enum_binders = binders, rigid_params = array_empty(), free_ids = free_ids, free_names = free_names))
          j = j + 1
        }
        Array::push(fields, value = canonical_node(tag = "V", fields = variant_fields))
        i = i + 1
      }
      canonical_node(tag = "E", fields = fields)
    },
    TDStruct(name, fields_raw, mut_fields, params) => {
      let fields = [
        name,
        __to_string(Array::length(params)),
        canonical_param_arities(params)
      ]
      let mut i = 0
      while i < Array::length(fields_raw) {
        let (field_name, field_ty) = Array::get(fields_raw, at = i)
        Array::push(fields, value = canonical_node(tag = "F", fields = [
          field_name,
          canonical_typedef_type(ty = field_ty, s = s, enum_binders = array_empty(), rigid_params = params, free_ids = free_ids, free_names = free_names)
        ]))
        i = i + 1
      }
      Array::push(fields, value = canonical_node(tag = "MU", fields = sorted_unique_strings(mut_fields)))
      canonical_node(tag = "S", fields = fields)
    },
    TDAlias(name, params, body) => canonical_node(tag = "A", fields = [
      name,
      __to_string(Array::length(params)),
      canonical_param_arities(params),
      canonical_typedef_type(ty = body, s = s, enum_binders = array_empty(), rigid_params = params, free_ids = free_ids, free_names = free_names)
    ]),
    TDEffect(name, ops, params) => {
      let fields = [
        name,
        __to_string(Array::length(params)),
        canonical_param_arities(params)
      ]
      let mut i = 0
      while i < Array::length(ops) {
        let (op_name, args, ret) = Array::get(ops, at = i)
        let op_fields = [op_name]
        let mut j = 0
        while j < Array::length(args) {
          Array::push(op_fields, value = canonical_typedef_type(ty = Array::get(args, at = j), s = s, enum_binders = array_empty(), rigid_params = params, free_ids = free_ids, free_names = free_names))
          j = j + 1
        }
        Array::push(op_fields, value = canonical_typedef_type(ty = ret, s = s, enum_binders = array_empty(), rigid_params = params, free_ids = free_ids, free_names = free_names))
        Array::push(fields, value = canonical_node(tag = "O", fields = op_fields))
        i = i + 1
      }
      canonical_node(tag = "K", fields = fields)
    },
    TDEffectSet(name, members) => canonical_node(tag = "Z", fields = [
      name,
      canonical_node(tag = "M", fields = members)
    ])
  }
}

/// Canonical, observation-only retained type-definition snapshot. It is not a
/// typed IR, source serialization, cache key, sidecar, or reuse contract.
/// Definitions and their nested members remain in checker registration order.
fn canonical_typedef_kind(_ def: TypeDef) -> String {
  match def {
    TDEnum(_, _, _) => "enum",
    TDStruct(_, _, _, _) => "struct",
    TDAlias(_, _, _) => "alias",
    TDEffect(_, _, _) => "effect",
    TDEffectSet(_, _) => "effectset"
  }
}

// Malformed observations are data, not recoverable empty provenance. Include
// the aligned position, definition kind, overall counts, and local counts so
// snapshots fail closed and remain deterministic for diagnostics/tests.
fn canonical_malformed_provenance(position: Int, kind: String, defs_count: Int, binders_count: Int, expected_binders: Int, actual_binders: Int, reason: String) -> String {
  canonical_node(tag = "M", fields = [
    "position",
    __to_string(position),
    "kind",
    kind,
    "defs_count",
    __to_string(defs_count),
    "binders_count",
    __to_string(binders_count),
    "expected_binders",
    __to_string(expected_binders),
    "actual_binders",
    __to_string(actual_binders),
    "reason",
    reason
  ])
}

/// Canonical, observation-only retained type-definition snapshot. It is not a
/// typed IR, source serialization, cache key, sidecar, or reuse contract.
/// Malformed provenance is represented explicitly rather than treated as an
/// empty binder list.
export fn canonical_checked_type_defs_snapshot(_ observation: CheckedProgramTypeDefsObservation) -> String {
  let fields = ["v2"]
  let checked = observation.checked_program
  let defs = checked.type_defs
  let binders_by_def = observation.type_def_binders
  let defs_count = Array::length(defs)
  let binders_count = Array::length(binders_by_def)
  let free_ids = array_empty()
  let free_names = array_empty()
  if defs_count != binders_count {
    Array::push(fields, value = canonical_malformed_provenance(position = -1, kind = "array", defs_count = defs_count, binders_count = binders_count, expected_binders = defs_count, actual_binders = binders_count, reason = "array_count_mismatch"))
  } else {
    ()
  }
  let mut i = 0
  while i < defs_count {
    let def = Array::get(defs, at = i)
    let kind = canonical_typedef_kind(def)
    if i >= binders_count {
      let expected = match def {
        TDEnum(_, params, _) => Array::length(params),
        _ => 0
      }
      Array::push(fields, value = canonical_malformed_provenance(position = i, kind = kind, defs_count = defs_count, binders_count = binders_count, expected_binders = expected, actual_binders = -1, reason = "missing_metadata"))
    } else {
      let binders = Array::get(binders_by_def, at = i)
      let actual = Array::length(binders)
      match def {
        TDEnum(_, params, _) => {
          let expected = Array::length(params)
          if actual != expected {
            Array::push(fields, value = canonical_malformed_provenance(position = i, kind = kind, defs_count = defs_count, binders_count = binders_count, expected_binders = expected, actual_binders = actual, reason = "enum_binder_count_mismatch"))
          } else {
            Array::push(fields, value = canonical_typedef(def = def, binders = binders, s = checked.final_subst, free_ids = free_ids, free_names = free_names))
          }
        },
        _ => if actual != 0 {
          Array::push(fields, value = canonical_malformed_provenance(position = i, kind = kind, defs_count = defs_count, binders_count = binders_count, expected_binders = 0, actual_binders = actual, reason = "non_enum_binders"))
        } else {
          Array::push(fields, value = canonical_typedef(def = def, binders = binders, s = checked.final_subst, free_ids = free_ids, free_names = free_names))
        }
      }
    }
    i = i + 1
  }
  while i < binders_count {
    Array::push(fields, value = canonical_malformed_provenance(position = i, kind = "none", defs_count = defs_count, binders_count = binders_count, expected_binders = 0, actual_binders = Array::length(Array::get(binders_by_def, at = i)), reason = "surplus_metadata"))
    i = i + 1
  }
  canonical_node(tag = "CTDS", fields = fields)
}
