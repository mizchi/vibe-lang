// lib/@vibe/compiler/checker/checker_region_retention.vibe — the parts an
// expression's value can come from, for the retention and provenance checks.

import @vibe/compiler/core {
  Expr, Pat, expr_children
}

/// #3488: the subexpressions `e`'s value may be, or hold: a literal's fields
/// or elements, either branch of an `if`, each `match` arm (and the
/// scrutinee, when an arm hands it back), a block's tail, and a `let`'s
/// value and body, and a spread's operand (Codex on #3492: `{ 0; c }`,
/// `{ let y = c; y }`, `[...cells]`).
/// Anything else is a leaf, with no parts.
export fn retention_result_items(e: Expr) -> Array[Expr] {
  match e {
    ERecord(_, fields, _) => for f in fields {
      f.1
    },
    ETuple(items) => items,
    EArray(items) => items,
    EIf(_, a, b) => [a, b],
    EMatch(scrut, arms) => {
      let items = for arm in arms {
        arm.1
      }
      if retention_arms_bind(arms) {
        Array::push(items, scrut)
      }
      items
    },
    ESeq(_, b) => [b],
    // A spread copies its operand's elements (`[...outer_cells]`).
    ESpread(inner) => [inner],
    ELet(_, v, b, _) => [v, b],
    ELetMut(_, v, b, _) => [v, b],
    _ => []
  }
}

/// Whether some arm's body names a binder its own pattern binds: such an arm
/// may hand back the scrutinee's value under a name the outer environment
/// does not know (#3488, Codex on #3492). `Some(x) => x` does; `Some(x) =>
/// fresh` and `None => fresh` do not.
export fn retention_arms_bind(arms: Array[(Pat, Expr)]) -> Bool {
  let mut any = false
  for arm in arms {
    if !any {
      let names: Array[String] = []
      retention_pat_names_into(arm.0, names)
      any = Array::length(names) > 0 && retention_expr_names_any(arm.1, names)
    }
  }
  any
}

fn retention_pat_names_into(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, ps) => retention_pats_names_into(ps, out),
    PTuple(ps) => retention_pats_names_into(ps, out),
    POr(a, _) => retention_pat_names_into(a, out),
    PStruct(_, fields) => retention_pats_names_into(for f in fields {
      f.1
    }, out),
    _ => ()
  }
}

fn retention_pats_names_into(ps: Array[Pat], out: Array[String]) -> Unit {
  for q in ps {
    retention_pat_names_into(q, out)
  }
  ()
}

fn retention_expr_names_any(e: Expr, names: Array[String]) -> Bool {
  let stack: Array[Expr] = [e]
  let mut hit = false
  while !hit && Array::length(stack) > 0 {
    let n = Array::length(stack)
    let cur = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match cur {
      EIdent(x, _) => {
        for name in names {
          if name == x {
            hit = true
          }
        }
        ()
      },
      _ => ()
    }
    for child in expr_children(cur) {
      Array::push(stack, child)
    }
  }
  hit
}
