// lib/@vibe/compiler/checker -- a binder whose value is read out of a
// location declared before an active region (#4050).

//# Inside `region r { .. }` or a `TaskGroup::run` body, a write is refused
//# when it stores a value of a region into a location that outlives that
//# region (`container_write_crosses_region`). A binding declared inside the
//# body may still BE such a location: `let a = boxes`, `for a in boxes`,
//# `match Some(boxes) { Some(a) => .. }` and `let (a, _) = (boxes, 1)` all
//# bind `a` to a part of `boxes`. Each such binder is marked
//# `__region_outer_alias__a` with the regions its source location was
//# declared before -- the same `CtTuple` of region names a re-checked
//# parameter carries -- so a write into it is judged against exactly those
//# regions. With nested regions that matters: a container declared inside
//# `region r1` and iterated inside a nested `region r2` predates `r2` only,
//# so it may hold an `r1` value but not an `r2` one.

import @vibe/compiler/core {
  Expr, Pat, Type, TypeDef, TypeEnv, TypeExpr, env_bind, env_lookup, expr_children, find_typedef, type_name_has_iterator_impl
}

import ./checker_builtin_arg_head_rest.vibe {
  ascription_lambda_ann
}

import ./checker_merge_capture_provenance.vibe {
  arg_is_region_token, expression_aliases_outer_binding, literal_item_is_inert
}

import ./checker_region_retention.vibe {
  retention_active_region_names, retention_arg_predates
}

import ./checker_region_retention_arms.vibe {
  retention_decl_value, retention_pat_names_into
}

/// #4050: the active regions that the location `value` reads from was
/// declared before, as seen from `scope` -- the regions a binder holding
/// `value`, or a part of it, may not keep a value of. Empty when `active` is
/// false (no region is open) or `value` is fresh. A name answers the regions
/// opened since its binding, plus those its own alias marker records; a
/// field, element, literal, block or conditional answers what its parts do;
/// a constructor or builtin call (`Some(boxes)`, `Map::values(m)`) answers
/// what its arguments do, since its result holds only them. Any other call
/// the checker knows returns an outer location answers every active region,
/// and so does a value `expression_aliases_outer_binding` says aliases one
/// when no narrower answer was found, so the answer is never smaller than
/// the one that test gives.
export fn region_outer_alias_regions(value: Expr, scope: TypeEnv, active: Bool) -> Array[String] {
  if active {
    let found = binder_source_predates(value = value, scope = scope)
    if Array::length(found) == 0 && expression_aliases_outer_binding(expr = value, env = scope) {
      retention_active_region_names(scope)
    } else {
      found
    }
  } else {
    []
  }
}

/// Mark `name` an alias of a location declared before `regions`, so a write
/// into it is judged as a write into that location for those regions. No
/// regions, no mark.
export fn region_outer_alias_mark(env: TypeEnv, name: String, regions: Array[String]) -> TypeEnv {
  if Array::length(regions) > 0 {
    env_bind(env = env, name = String::concat("__region_outer_alias__", name), ty = CtTuple(for rname in regions {
      CtNamed(rname, [])
    }))
  } else {
    env
  }
}

/// #4050: mark each name `pat` binds -- a `for` element (`PBind(name)`), a
/// `match` arm's pattern, which a destructuring `let` and `if .. is` lower
/// to -- with the regions the part of `value` it reads predates
/// (`binder_alias_bind_parts`). `env` is the binders'
/// environment, `scope` the one `value` is read in. Before, the binder was
/// judged as a binding of the region body, so `for a in boxes {
/// Array::push(a, value = cell) }` kept a region value in an outer array.
export fn region_outer_alias_bind(env: TypeEnv, pat: Pat, value: Expr, scope: TypeEnv) -> TypeEnv {
  let active = match env_lookup(env = scope, name = "#active_region") {
    Some(CtNamed(_, _)) => true,
    _ => false
  }
  if active {
    binder_alias_bind_parts(env = env, pat = pat, value = value, scope = scope)
  } else {
    env
  }
}

/// `region_outer_alias_bind` for one pattern against the expression it
/// matches. A tuple pattern against a tuple literal, and a constructor
/// pattern against a call of that constructor, pair component with
/// component, so in `match (outer, inner) { (_, a) => .. }` the binder `a`
/// is marked only with what `inner` predates (Codex on #4061). Anything
/// that cannot be paired marks every name it binds with what the whole
/// value predates.
fn binder_alias_bind_parts(env: TypeEnv, pat: Pat, value: Expr, scope: TypeEnv) -> TypeEnv {
  let paired: Option[(Array[Pat], Array[Expr])] = match pat {
    PTuple(ps) => match value {
      ETuple(es) => if Array::length(ps) == Array::length(es) {
        Some((ps, es))
      } else {
        None
      },
      _ => None
    },
    PCtor(pname, ps) => match value {
      ECall(EIdent(callee, _), args, _, _) => if pname == callee && Array::length(ps) == Array::length(args) {
        Some((ps, args))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
  match paired {
    Some((ps, es)) => binder_alias_bind_pairs(env = env, ps = ps, es = es, scope = scope),
    None => {
      let names: Array[String] = []
      retention_pat_names_into(p = pat, out = names)
      if Array::length(names) > 0 {
        let regions = region_outer_alias_regions(value = value, scope = scope, active = true)
        let mut out = env
        for name in names {
          out = region_outer_alias_mark(env = out, name = name, regions = regions)
        }
        out
      } else {
        env
      }
    }
  }
}

fn binder_alias_bind_pairs(env: TypeEnv, ps: Array[Pat], es: Array[Expr], scope: TypeEnv) -> TypeEnv {
  let mut out = env
  let mut i = 0
  while i < Array::length(ps) {
    out = binder_alias_bind_parts(env = out, pat = Array::get(ps, at = i), value = Array::get(es, at = i), scope = scope)
    i = i + 1
  }
  out
}

/// #4050 (Codex on #4061): `for name in iterable` -- the loop's element is
/// what the iteration hands out, not `iterable` itself. An `Array` hands out
/// its stored elements, so the binder reads `iterable`. A declared type
/// iterated through its own protocol hands out what the protocol call the
/// `for` desugar selects returns -- `C::next(iterable)`, `C::iter(iterable)`
/// or `C::iter_get(iterable, i)` (`for_binder_protocols`) -- and the binder
/// is marked by what that call's declaration hands out
/// (`for_binder_source_regions`); for `C::iter` that is the returned
/// iterator's `next` (#4093). An element the body builds fresh marks
/// nothing: an iterator built before the region may hand out a new array to
/// write into. One holding only parts of `iterable` is marked with what
/// `iterable` predates, and any other -- a module-level binding, a call's
/// result, a body not readable here -- with every active region.
export fn region_for_binder_bind(env: TypeEnv, name: String, iterable: Expr, iter_ty: Type, scope: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  let active = match env_lookup(env = scope, name = "#active_region") {
    Some(CtNamed(_, _)) => true,
    _ => false
  }
  if active {
    let regions: Array[String] = []
    for src in for_binder_sources(iterable = iterable, iter_ty = iter_ty, scope = scope, defs = defs) {
      for r in for_binder_source_regions(source = src, iterable = iterable, scope = scope) {
        if !binder_region_listed(names = regions, rname = r) {
          Array::push(regions, value = r)
        } else {
          ()
        }
      }
      ()
    }
    region_outer_alias_mark(env = env, name = name, regions = regions)
  } else {
    env
  }
}

/// The expressions a `for` element over `iterable` is read from: the
/// protocol calls a declared type binds, else `iterable` itself.
fn for_binder_sources(iterable: Expr, iter_ty: Type, scope: TypeEnv, defs: Array[TypeDef]) -> Array[Expr] {
  let head = match iter_ty {
    CtStruct(nm) => nm,
    CtNamed(nm, _) => nm,
    _ => ""
  }
  let declared = head != "" && head != "Array" && head != "String" && head != "Map" && head != "HostStream" && match find_typedef(defs = defs, name = head) {
    Some(_) => true,
    None => false
  }
  let methods = if declared {
    for_binder_protocols(head = head, scope = scope)
  } else {
    []
  }
  if Array::length(methods) > 0 {
    for method in methods {
      let callee = String::concat(head, String::concat("::", method))
      let args = if method == "iter_get" {
        [iterable, EInt(0)]
      } else {
        [iterable]
      }
      ECall(EIdent(callee, -1), args, -1, [])
    }
  } else {
    [iterable]
  }
}

/// The regions one source of a `for` element predates. A protocol call is
/// judged by what its declaration hands out (`for_protocol_reach`): an
/// element built fresh in the body marks nothing, one that holds only
/// parts of the iterand marks what `iterable` predates, and any other --
/// one that reaches a module-level binding, a call whose result is not read
/// here, or a declaration that is not readable -- marks every active
/// region (Codex on #4100). The iterand itself (an `Array`, a `Map`'s
/// values) is judged as a value, as before.
fn for_binder_source_regions(source: Expr, iterable: Expr, scope: TypeEnv) -> Array[String] {
  let reach = match source {
    ECall(EIdent(callee, _), _, _, _) => for_protocol_reach(callee = callee, scope = scope),
    _ => -1
  }
  if reach == 0 {
    []
  } else if reach == 1 {
    region_outer_alias_regions(value = iterable, scope = scope, active = true)
  } else if reach == 2 {
    retention_active_region_names(scope)
  } else {
    region_outer_alias_regions(value = source, scope = scope, active = true)
  }
}

/// The reach (`for_element_reach`) of the element the `for` desugar binds
/// from the protocol call `callee`; -1 when `callee` is not a protocol call.
/// - `C::next(xs)` returns `Some((element, rest))`, and the desugar binds
///   only `element` (`Some((x, __iter_rest))`), so the element is read
///   alone: a fresh one reaches nothing, however much the continuation
///   keeps (Codex on #4061). One that holds `next`'s parameter holds the
///   cursor, which after the first step is the previous `rest`, so it
///   reaches what `rest` does as well.
/// - `C::iter(xs)` is driven through `R::next` over the `R` it returns
///   (`classify_sync_for_loop`), so the element is `R::next`'s, read the
///   same way (#4093). When that one holds the cursor, the first cursor is
///   `C::iter`'s result, so it reaches what that result does as well.
/// - `C::iter_get(xs, i)` returns the element itself.
fn for_protocol_reach(callee: String, scope: TypeEnv) -> Int {
  if String::ends_with(callee, suffix = "::next") {
    for_next_reach(callee = callee)
  } else if String::ends_with(callee, suffix = "::iter") {
    match for_iter_next_callee(iter_callee = callee, scope = scope) {
      Some(next_callee) => {
        let element = for_next_reach(callee = next_callee)
        if element == 0 {
          0
        } else {
          for_reach_max(a = element, b = for_result_reach(callee = callee))
        }
      },
      None => 2
    }
  } else if String::ends_with(callee, suffix = "::iter_get") {
    for_result_reach(callee = callee)
  } else {
    -1
  }
}

/// The reach of the element `callee` (a `next`) hands out: 2 unless every
/// result of its declaration is spelled `Some((e, rest))` or `None`.
fn for_next_reach(callee: String) -> Int {
  match retention_decl_value(callee) {
    Some(EFn(_, _, params, _, _, body)) => if Array::length(params) > 0 && !for_body_has_return(body) {
      match for_next_component_body(body = body, at = 0) {
        Some(element) => {
          let names = for_param_names(params)
          let er = for_element_reach(e = element, params = names, locals = for_no_locals())
          if er == 1 {
            match for_next_component_body(body = body, at = 1) {
              Some(rest) => for_reach_max(a = 1, b = for_element_reach(e = rest, params = names, locals = for_no_locals())),
              None => 2
            }
          } else {
            er
          }
        },
        None => 2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// The reach of what `callee`'s declaration returns; 2 when it is not
/// readable here or returns early.
fn for_result_reach(callee: String) -> Int {
  match retention_decl_value(callee) {
    Some(EFn(_, _, params, _, _, body)) => if !for_body_has_return(body) {
      for_element_reach(e = body, params = for_param_names(params), locals = for_no_locals())
    } else {
      2
    },
    _ => 2
  }
}

fn for_param_names(_ params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  for p in params {
    p.0
  }
}

fn for_reach_max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

/// What the value of `e` may be a part of, read from its syntax only, so an
/// element counts as fresh only by positive evidence (Codex on #4100):
/// 0 -- built in the body from literals, constructors and other fresh parts;
/// 1 -- may also hold the function's parameters; 2 -- may hold anything
/// else: a module-level or captured name, a call's result, a `let mut`
/// (which a later assignment may point elsewhere), or a form not read here.
/// `locals` carries the reach of each name the body binds before `e`; the
/// last entry for a name wins, so an inner binding shadows an outer one and
/// a parameter.
fn for_element_reach(e: Expr, params: Array[String], locals: Array[(String, Int)]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    // The builtin operators return a scalar or a new string.
    EBinOp(_, _, _, _) => 0,
    EUnaryOp(_, _) => 0,
    EIdent(n, _) => {
      let mut found = -1
      for l in locals {
        if l.0 == n {
          found = l.1
        } else {
          ()
        }
      }
      if found >= 0 {
        found
      } else if n == "None" || n == "Option::None" {
        0
      } else if for_name_listed(names = params, name = n) {
        1
      } else {
        2
      }
    },
    ETuple(items) => for_elements_reach(es = items, params = params, locals = locals),
    EArray(items) => for_elements_reach(es = items, params = params, locals = locals),
    ERecord(_, fields, _) => for_elements_reach(es = for f in fields {
      f.1
    }, params = params, locals = locals),
    EMap(entries) => for_elements_reach(es = for f in entries {
      f.1
    }, params = params, locals = locals),
    EDot(inner, _, _, _) => for_element_reach(e = inner, params = params, locals = locals),
    ECall(EIdent(ctor, _), args, _, _) => if for_is_wrapping_ctor(ctor) {
      for_elements_reach(es = args, params = params, locals = locals)
    } else {
      2
    },
    // A written `let x: T = e` parses to `((__asc: T) -> __asc)(e)`.
    ECall(callee, args, _, _) => match ascription_lambda_ann(callee) {
      Some(_) => if Array::length(args) == 1 {
        for_element_reach(e = Array::get(args, at = 0), params = params, locals = locals)
      } else {
        2
      },
      None => 2
    },
    EIf(_, a, b) => for_reach_max(a = for_element_reach(e = a, params = params, locals = locals), b = for_element_reach(e = b, params = params, locals = locals)),
    EMatch(scrutinee, arms) => {
      let sr = for_element_reach(e = scrutinee, params = params, locals = locals)
      let mut out = 0
      for arm in arms {
        let (pat, body) = arm
        let names: Array[String] = []
        retention_pat_names_into(p = pat, out = names)
        let inner: Array[(String, Int)] = Array::concat(locals, for n in names {
          (n, sr)
        })
        out = for_reach_max(a = out, b = for_element_reach(e = body, params = params, locals = inner))
      }
      out
    },
    ELet(x, v, rest, _) => {
      let vr = for_element_reach(e = v, params = params, locals = locals)
      for_element_reach(e = rest, params = params, locals = for_locals_with(locals = locals, name = x, reach = vr))
    },
    ELetMut(x, _, rest, _) => for_element_reach(e = rest, params = params, locals = for_locals_with(locals = locals, name = x, reach = 2)),
    ESeq(_, rest) => for_element_reach(e = rest, params = params, locals = locals),
    _ => 2
  }
}

fn for_no_locals() -> Array[(String, Int)] {
  []
}

/// `locals` with `name` bound at `reach`, after every earlier entry.
fn for_locals_with(locals: Array[(String, Int)], name: String, reach: Int) -> Array[(String, Int)] {
  let out: Array[(String, Int)] = Array::concat(locals, [])
  Array::push(out, value = (name, reach))
  out
}

fn for_elements_reach(es: Array[Expr], params: Array[String], locals: Array[(String, Int)]) -> Int {
  let mut out = 0
  for e in es {
    out = for_reach_max(a = out, b = for_element_reach(e = e, params = params, locals = locals))
  }
  out
}

/// A builtin constructor whose result holds exactly its arguments.
fn for_is_wrapping_ctor(_ name: String) -> Bool {
  name == "Some" || name == "Option::Some" || name == "Ok" || name == "Result::Ok" || name == "Err" || name == "Result::Err"
}

fn for_name_listed(names: Array[String], name: String) -> Bool {
  let mut found = false
  for n in names {
    if n == name {
      found = true
    } else {
      ()
    }
  }
  found
}

/// #4093: the `next` the `for` desugar drives over what `iter_callee`
/// returns -- `R::next` for the nominal head `R` of `iter_callee`'s declared
/// result, the type `classify_sync_for_loop` reads from `C::iter`. None when
/// `iter_callee` is unbound or its result has no nominal head; a head whose
/// `next` has no readable declaration reaches everything
/// (`for_next_reach`).
fn for_iter_next_callee(iter_callee: String, scope: TypeEnv) -> Option[String] {
  match env_lookup(env = scope, name = iter_callee) {
    Some(t) => match for_binder_result_head(t) {
      Some(head) => Some(String::concat(head, "::next")),
      None => None
    },
    None => None
  }
}

/// The nominal head of a function type's result, through a `forall`.
fn for_binder_result_head(_ t: Type) -> Option[String] {
  match t {
    CtFn(_, ret, _) => match ret {
      CtNamed(n, _) => if n != "" {
        Some(n)
      } else {
        None
      },
      CtStruct(n) => if n != "" {
        Some(n)
      } else {
        None
      },
      _ => None
    },
    CtForAll(_, _, body) => for_binder_result_head(body),
    _ => None
  }
}

/// `body` with each result `Some((element, rest))` replaced by its component
/// `at` (0 the element, 1 the continuation) and each `None` by `()`,
/// through `if`, `match`, `let` and sequencing; None at any other result.
fn for_next_component_body(body: Expr, at: Int) -> Option[Expr] {
  match body {
    ECall(EIdent(ctor, _), args, _, _) => if (ctor == "Some" || ctor == "Option::Some") && Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        ETuple(items) => if Array::length(items) == 2 {
          Some(Array::get(items, at = at))
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    EIdent(n, _) => if n == "None" || n == "Option::None" {
      Some(EUnit)
    } else {
      None
    },
    EIf(c, a, b) => match for_next_component_body(body = a, at = at) {
      Some(ra) => match for_next_component_body(body = b, at = at) {
        Some(rb) => Some(EIf(c, ra, rb)),
        None => None
      },
      None => None
    },
    EMatch(scrutinee, arms) => {
      let out: Array[(Pat, Expr)] = []
      let mut ok = true
      for arm in arms {
        let (pat, arm_body) = arm
        match for_next_component_body(body = arm_body, at = at) {
          Some(r) => Array::push(out, value = (pat, r)),
          None => ok = false
        }
      }
      if ok {
        Some(EMatch(scrutinee, out))
      } else {
        None
      }
    },
    ELet(x, v, rest, off) => match for_next_component_body(body = rest, at = at) {
      Some(r) => Some(ELet(x, v, r, off)),
      None => None
    },
    ELetMut(x, v, rest, off) => match for_next_component_body(body = rest, at = at) {
      Some(r) => Some(ELetMut(x, v, r, off)),
      None => None
    },
    ESeq(a, rest) => match for_next_component_body(body = rest, at = at) {
      Some(r) => Some(ESeq(a, r)),
      None => None
    },
    _ => None
  }
}

fn for_body_has_return(_ body: Expr) -> Bool {
  let stack: Array[Expr] = [body]
  let mut found = false
  while !found && Array::length(stack) > 0 {
    let n = Array::length(stack)
    let cur = Array::get(stack, at = n - 1)
    Array::truncate(stack, length = n - 1)
    match cur {
      EReturn(_) => found = true,
      _ => {
        for child in expr_children(cur) {
          Array::push(stack, value = child)
        }
        ()
      }
    }
  }
  found
}

/// The protocol method(s) the `for` desugar may draw `head`'s elements
/// from, mirroring `normalize/desugar/iteration.vibe` (Codex on #4061). With
/// a method-bearing trait in the program, `classify_sync_for_loop` takes
/// `C::next`, else `C::iter`, else the indexed `C::iter_length` +
/// `C::iter_get`. Without one, `classify_trait_free_for_loop` takes `C::next`
/// only when it returns a `Future`, else the indexed protocol. An `impl` of an
/// iterator trait for `head` puts such a trait in the program, so only the
/// first lane can run; otherwise the lane is not known here, and both lanes'
/// choices are returned, so the binder is marked with what either predates.
/// Empty when neither lane finds a protocol (the loop does not iterate a
/// protocol, and the binder reads the iterand).
fn for_binder_protocols(head: String, scope: TypeEnv) -> Array[String] {
  let has_next = for_binder_has(head = head, method = "next", scope = scope)
  let has_indexed = for_binder_has(head = head, method = "iter_length", scope = scope) && for_binder_has(head = head, method = "iter_get", scope = scope)
  let sync_choice = if has_next {
    "next"
  } else if for_binder_has(head = head, method = "iter", scope = scope) {
    "iter"
  } else if has_indexed {
    "iter_get"
  } else {
    ""
  }
  let next_is_future = has_next && match env_lookup(env = scope, name = String::concat(head, "::next")) {
    Some(t) => for_binder_returns_future(t),
    None => false
  }
  let free_choice = if next_is_future {
    "next"
  } else if has_indexed {
    "iter_get"
  } else {
    ""
  }
  let out: Array[String] = []
  if sync_choice != "" {
    Array::push(out, value = sync_choice)
  } else {
    ()
  }
  if !type_name_has_iterator_impl(env = scope, type_name = head) && free_choice != "" && free_choice != sync_choice {
    Array::push(out, value = free_choice)
  } else {
    ()
  }
  out
}

fn for_binder_has(head: String, method: String, scope: TypeEnv) -> Bool {
  match env_lookup(env = scope, name = String::concat(head, String::concat("::", method))) {
    Some(_) => true,
    None => false
  }
}

fn for_binder_returns_future(_ t: Type) -> Bool {
  match t {
    CtFn(_, ret, _) => match ret {
      CtNamed(n, _) => n == "Future",
      _ => false
    },
    CtForAll(_, _, body) => for_binder_returns_future(body),
    _ => false
  }
}

/// The regions `value`'s location predates; a constructor or builtin call
/// is read through its arguments rather than answered by every region.
fn binder_source_predates(value: Expr, scope: TypeEnv) -> Array[String] {
  match value {
    ECall(EIdent(callee, _), args, _, _) => match env_lookup(env = scope, name = callee) {
      None => {
        let out: Array[String] = []
        for a in args {
          if !literal_item_is_inert(item = a, env = scope) && !arg_is_region_token(arg = a, env = scope) {
            for r in binder_source_predates(value = a, scope = scope) {
              if !binder_region_listed(names = out, rname = r) {
                Array::push(out, value = r)
              } else {
                ()
              }
            }
            ()
          } else {
            ()
          }
        }
        out
      },
      Some(_) => retention_arg_predates(arg = value, env = scope)
    },
    _ => retention_arg_predates(arg = value, env = scope)
  }
}

fn binder_region_listed(names: Array[String], rname: String) -> Bool {
  let mut found = false
  for n in names {
    if n == rname {
      found = true
    } else {
      ()
    }
  }
  found
}
