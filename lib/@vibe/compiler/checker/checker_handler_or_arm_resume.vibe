//# Or-pattern handler arms and their `resume` (#3301)
//
// The checker types an or-pattern arm `A | B => body` the way the split
// (core/handler_or_arms.vibe) hands it over: as `A => body` and `B => body`,
// so each expression of the body is typed once per operation, at one source
// offset. The one name in that body whose type depends on the operation is
// `resume` -- an or-pattern arm cannot bind a payload -- and it is
// `(A's return type) -> ..` in one copy and `(B's) -> ..` in the other. When
// those differ, the source holds one `resume` at two types, and every reader
// of the per-offset type table (`vibe type-at`, hover, `vibe grep --where`)
// answers with whichever copy was typed last. Such an arm is refused, the way
// an or-pattern in Rust or a `match` arm binds each name at one type. An arm
// that never names `resume` reads nothing that differs between its
// operations, so their signatures may differ there.
//
// The types compared are the ones the arms were checked at. A generic
// effect's declaration says `X -> A` and `Y -> B`, but the handle
// instantiates `A` and `B`, and at `E[Int, Int]` both copies type `resume`
// alike. So the arm loop records, for each copy of an or-pattern arm, the
// return type it instantiated, and the comparison reads those through the
// program's final substitution (Codex on #3337). Two variables nothing
// resolved are two types, not one: the arm is refused rather than trusted.
// The copies of one arm are recognised by their shape -- consecutive arms of
// one `handle`, one per operation of the source arm, over one body -- and not
// by a source offset, so a lane that parses without offsets answers as the
// located ones do.

import @vibe/compiler/core {
  Expr, Pat, Subst, Type, TypeDef, subst_apply, type_to_string, types_equal
}

import @vibe/compiler/checker/diagnostics {
  off_marker, off_marker_len
}

import @vibe/compiler/checker/resume {
  arm_first_resume_ref
}

import @vibe/compiler/checker/type_relations {
  type_is_ground
}

import ./checker_eq_unbounded_formal_msg.vibe {
  effect_op_sig
}

/// The operations of each or-pattern arm the split took whose body names its
/// `resume` (handler_or_arm_resume_begin), and whether the arm loop has found
/// its copies in a checked `handle`.
let or_arm_group_names: Array[Array[String]] = []
let or_arm_group_matched: Array[Bool] = []

/// One row per checked copy of such an arm: the `handle` it belongs to (a
/// handler_or_arm_handle_instance number), the index of the first copy of
/// its arm in that handle's arms (handler_or_arm_runs), the operation it
/// handles, the operation's return type as that handle instantiated it
/// (before the final substitution), and where its `resume` is written.
let or_arm_resume_rows: Array[(Int, Int, String, Type, Int)] = []

let or_arm_handle_next: Array[Int] = [0]

fn or_arm_names(alternatives: Array[Pat]) -> Array[String] {
  let names: Array[String] = []
  let mut j = 0
  while j < Array::length(alternatives) {
    match Array::get(alternatives, j) {
      PCtor(qname, _) => Array::push(names, qname),
      _ => ()
    }
    j = j + 1
  }
  names
}

fn names_equal(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut same = true
    let mut i = 0
    while same && i < Array::length(a) {
      same = Array::get(a, i) == Array::get(b, i)
      i = i + 1
    }
    same
  }
}

/// #3301: start recording for one program's check. `arms` are the or-pattern
/// arms the split took (`handler_or_arms_to_split`), with their bodies as
/// written.
export fn handler_or_arm_resume_begin(arms: Array[(Array[Pat], Expr)]) -> Unit {
  Array::truncate(or_arm_group_names, 0)
  Array::truncate(or_arm_group_matched, 0)
  Array::truncate(or_arm_resume_rows, 0)
  let mut i = 0
  while i < Array::length(arms) {
    let (alternatives, body) = Array::get(arms, i)
    let names = or_arm_names(alternatives)
    match arm_first_resume_ref(body, false) {
      Some(_) => if Array::length(names) >= 2 {
        Array::push(or_arm_group_names, names)
        Array::push(or_arm_group_matched, false)
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
}

/// A number for the `handle` the checker is about to check, so the rows of
/// two handles never meet in one comparison.
export fn handler_or_arm_handle_instance() -> Int {
  let n = Array::get(or_arm_handle_next, 0)
  Array::set(or_arm_handle_next, 0, n + 1)
  n
}

fn or_arm_bodies_equal(a: Expr, b: Expr) -> Bool {
  a == b
}

/// Do the arms from `start` on hold the copies the split made of one
/// or-pattern arm over `names`: one arm per operation, in order, every body
/// the same tree, and that body naming its own `resume`?
fn or_arm_run_at(arms: Array[(Pat, Expr)], start: Int, names: Array[String]) -> Bool {
  let m = Array::length(names)
  if m < 2 || start + m > Array::length(arms) {
    false
  } else {
    let (_, first_body) = Array::get(arms, start)
    let mut same = true
    let mut k = 0
    while same && k < m {
      let (pat, body) = Array::get(arms, start + k)
      same = match pat {
        PCtor(qname, _) => qname == Array::get(names, k) && (k == 0 || or_arm_bodies_equal(body, first_body)),
        _ => false
      }
      k = k + 1
    }
    same && match arm_first_resume_ref(first_body, false) {
      Some(_) => true,
      None => false
    }
  }
}

/// #3301: for each arm of a `handle` about to be checked, the index of the
/// first copy of the or-pattern arm it was split from, or -1. The copies are
/// found by what the split made of them -- consecutive arms, one per
/// operation of the source arm, over one body -- rather than by a source
/// offset, which an unlocated parse (`vibe build --debug`'s library lane)
/// does not have (Codex on #3337). An empty answer means no arm is one.
export fn handler_or_arm_runs(arms: Array[(Pat, Expr)]) -> Array[Int] {
  let runs: Array[Int] = []
  if Array::length(or_arm_group_names) > 0 {
    let n = Array::length(arms)
    let mut f = 0
    while f < n {
      Array::push(runs, -1)
      f = f + 1
    }
    let mut i = 0
    while i < n {
      let mut run_len = 0
      let mut g = 0
      while run_len == 0 && g < Array::length(or_arm_group_names) {
        let names = Array::get(or_arm_group_names, g)
        if or_arm_run_at(arms, i, names) {
          run_len = Array::length(names)
          or_arm_mark_matched(names)
        } else {
          ()
        }
        g = g + 1
      }
      if run_len > 0 {
        let mut k = 0
        while k < run_len {
          Array::set(runs, i + k, i)
          k = k + 1
        }
        i = i + run_len
      } else {
        i = i + 1
      }
    }
  } else {
    ()
  }
  runs
}

fn or_arm_mark_matched(names: Array[String]) -> Unit {
  let mut g = 0
  while g < Array::length(or_arm_group_names) {
    if names_equal(Array::get(or_arm_group_names, g), names) {
      Array::set(or_arm_group_matched, g, true)
    } else {
      ()
    }
    g = g + 1
  }
}

/// Called by the arm loop for every declared-effect arm it checks: `run` is
/// what handler_or_arm_runs answered for this arm, and `ret` the operation's
/// return type at this handle's instantiation. Kept only for a copy of an
/// or-pattern arm that names `resume`.
export fn record_handler_or_arm_resume(instance: Int, run: Int, body: Expr, qname: String, ret: Type) -> Unit {
  if run >= 0 {
    let at = match arm_first_resume_ref(body, false) {
      Some(EIdent(_, off)) => off,
      _ => -1
    }
    Array::push(or_arm_resume_rows, (instance, run, qname, ret, at))
  } else {
    ()
  }
}

/// #3301: refuse each or-pattern handler arm whose body names its `resume`
/// while its operations resume with different types. Read after checking,
/// when `defs` holds every declared effect's operations and `final_s` every
/// variable the check resolved: the copies of one arm in one `handle` are
/// compared at the types they were checked at. An arm whose copies the arm
/// loop never found (`arms`, as given to handler_or_arm_resume_begin) is
/// compared at its declared signatures instead, which can refuse a generic
/// arm the instantiation would have allowed but never accepts two types; an
/// alternative whose operation is not declared is not typed against a
/// signature, and is skipped. Clears the recording.
export fn check_handler_or_arm_resume_types(arms: Array[(Array[Pat], Expr)], defs: Array[TypeDef], final_s: Subst, errors: Array[String]) -> Unit {
  let reported: Array[String] = []
  let mut r = 0
  while r < Array::length(or_arm_resume_rows) {
    match or_arm_row_disagreement(r, defs, final_s) {
      Some(msg) => or_arm_report(reported, errors, msg),
      None => ()
    }
    r = r + 1
  }
  let mut i = 0
  while i < Array::length(arms) {
    let (alternatives, body) = Array::get(arms, i)
    match arm_first_resume_ref(body, false) {
      Some(at) => if !or_arm_names_matched(or_arm_names(alternatives)) {
        match or_arm_declared_disagreement(alternatives, defs) {
          Some(msg) => or_arm_report(reported, errors, String::concat(msg, match at {
            EIdent(name, off) => off_marker_len(off, String::length(name)),
            _ => off_marker(-1)
          })),
          None => ()
        }
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  Array::truncate(or_arm_group_names, 0)
  Array::truncate(or_arm_group_matched, 0)
  Array::truncate(or_arm_resume_rows, 0)
}

/// Each copy of a nested arm is checked once per copy of the arm around it,
/// so the same refusal can come more than once; it is reported once.
fn or_arm_report(reported: Array[String], errors: Array[String], msg: String) -> Unit {
  let mut seen = false
  let mut i = 0
  while !seen && i < Array::length(reported) {
    seen = Array::get(reported, i) == msg
    i = i + 1
  }
  if !seen {
    Array::push(reported, msg)
    Array::push(errors, msg)
  } else {
    ()
  }
}

fn or_arm_names_matched(names: Array[String]) -> Bool {
  let mut found = false
  let mut g = 0
  while !found && g < Array::length(or_arm_group_names) {
    found = Array::get(or_arm_group_matched, g) && names_equal(Array::get(or_arm_group_names, g), names)
    g = g + 1
  }
  found
}

/// Compare the recorded copy at `row` with the first copy of the same arm in
/// the same `handle`; the message is located at that arm's `resume`. A
/// return type the check could not name (`CtUnknown`) agrees with nothing:
/// two of them are not known to be one type.
fn or_arm_row_disagreement(row: Int, defs: Array[TypeDef], final_s: Subst) -> Option[String] {
  let (instance, run, qname, ret, _) = Array::get(or_arm_resume_rows, row)
  let mut found: Option[String] = None
  let mut done = false
  let mut r = 0
  while !done && r < row {
    let (first_instance, first_run, first_name, first_ret, first_at) = Array::get(or_arm_resume_rows, r)
    if first_instance == instance && first_run == run {
      done = true
      let first_now = subst_apply(final_s, first_ret)
      let now = subst_apply(final_s, ret)
      let agree = match first_now {
        CtUnknown => false,
        _ => types_equal(first_now, now)
      }
      if !agree {
        let msg = if type_is_ground(first_now) && type_is_ground(now) {
          or_arm_message(first_name, first_now, qname, now)
        } else {
          or_arm_message(first_name, or_arm_declared_ret(defs, first_name, first_now), qname, or_arm_declared_ret(defs, qname, now))
        }
        found = Some(String::concat(msg, off_marker_len(first_at, String::length("resume"))))
      } else {
        ()
      }
    } else {
      ()
    }
    r = r + 1
  }
  found
}

/// A type the check left unresolved is named by its declaration (`A`), which
/// says more than a fresh variable would.
fn or_arm_declared_ret(defs: Array[TypeDef], qname: String, fallback: Type) -> Type {
  match effect_op_sig(defs, qname) {
    Some((_, ret)) => ret,
    None => fallback
  }
}

fn or_arm_declared_disagreement(alternatives: Array[Pat], defs: Array[TypeDef]) -> Option[String] {
  let mut first: Option[(String, Type)] = None
  let mut found: Option[String] = None
  let mut j = 0
  while j < Array::length(alternatives) {
    match found {
      Some(_) => (),
      None => match Array::get(alternatives, j) {
        PCtor(qname, _) => match effect_op_sig(defs, qname) {
          Some((_, ret)) => match first {
            None => {
              first = Some((qname, ret))
            },
            Some((first_name, first_ret)) => if types_equal(first_ret, ret) {
              ()
            } else {
              found = Some(or_arm_message(first_name, first_ret, qname, ret))
            }
          },
          None => ()
        },
        _ => ()
      }
    }
    j = j + 1
  }
  found
}

fn or_arm_message(first_name: String, first_ret: Type, qname: String, ret: Type) -> String {
  String::concat("write `", String::concat(first_name, String::concat(" => ..` and `", String::concat(qname, String::concat(" => ..` as separate arms: `resume` here would take ", String::concat(type_to_string(first_ret), String::concat(" for `", String::concat(first_name, String::concat("` but ", String::concat(type_to_string(ret), String::concat(" for `", String::concat(qname, "`, and an or-pattern arm has one `resume`"))))))))))))
}
