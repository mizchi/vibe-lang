//# Unreachable `match` arms (#3549)
//#
//# A `match` tries its arms in order, so an arm whose every value an earlier
//# arm already matches never runs: `1 => 10, 1 => 20` and anything after a
//# `_` arm. The checker accepted both without a word. This pass reports each
//# such arm as a warning on `vibe check`, located at the arm's pattern and
//# naming the earlier arm that takes its values.
//#
//# It reads the tooling parse (`parse_source_with_ranges`), because only that
//# parse keeps a pattern's source range. The judgement is syntactic and only
//# ever under-reports: an earlier arm covers a later one when it is a name,
//# `_`, or a tuple / struct pattern of those, or when both are the same literal / constructor / tuple shape with
//# every position covered. Exhaustiveness (`true` and `false` arms before a
//# `_`) is not consulted, so a dead arm that needs it is not reported.
//#
//# Only a `match` written as such is read. A guarded arm (`p if c => ..`)
//# covers nothing, since its guard may fail; the parser's own matches (a
//# refutable `let`, `if x is P`, a guard's fall-through) are skipped.

//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, match_scrutinee_temp
}

import @vibe/compiler/core {
  expr_children
}

import @vibe/compiler/checker/diagnostics {
  off_marker_len
}

import @vibe/parser {
  parse_source_with_ranges, source_expr, source_expr_range, source_pat, source_pat_range
}

//# Functions

/// The unreachable arms of every written `match` in `source`, one message
/// each, carrying the `[@off=..]` marker of the arm's pattern. A source the
/// tooling parse cannot read answers no rows (its errors are the check's).
export fn detect_unreachable_match_arms(source: String) -> Array[String] {
  let out: Array[String] = []
  let stmts = handle {
    parse_source_with_ranges(source)
  } with { Exception::Throw(_) => {
    let none: Array[Stmt] = []
    none
  } }
  ua_walk_stmts(out, source, stmts)
  out
}

fn ua_walk_stmts(out: Array[String], source: String, stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => ua_walk_expr(out, source, body),
      SLetMut(_, _, body) => ua_walk_expr(out, source, body),
      SLetPat(_, body) => ua_walk_expr(out, source, body),
      SExpr(body) => ua_walk_expr(out, source, body),
      STest(_, body) => ua_walk_expr(out, source, body),
      SBench(_, body) => ua_walk_expr(out, source, body),
      SExample(_, body) => ua_walk_expr(out, source, body),
      SFnDecl(_, _, body, _, _) => ua_walk_expr(out, source, body),
      SModule(_, _, body) => ua_walk_stmts(out, source, body),
      _ => ()
    }
    i = i + 1
  }
}

fn ua_walk_expr(out: Array[String], source: String, expr: Expr) -> Unit {
  let (start, _) = source_expr_range(expr)
  let node = source_expr(expr)
  let written = start >= 0 && ua_text_at(source, start, "match")
  match node {
    EMatch(scrutinee, arms) => {
      if written {
        ua_check_arms(out, source, arms)
      } else {
        ()
      }
      ua_walk_expr(out, source, scrutinee)
      ua_walk_arm_bodies(out, source, arms)
    },
    // A guarded match binds its scrutinee to the match temporary first.
    ELet(name, value, body, _) => match source_expr(body) {
      EMatch(EIdent(temp, _), arms) => if name == match_scrutinee_temp() && temp == name {
        if written {
          ua_check_arms(out, source, arms)
        } else {
          ()
        }
        ua_walk_expr(out, source, value)
        ua_walk_arm_bodies(out, source, arms)
      } else {
        ua_walk_children(out, source, node)
      },
      _ => ua_walk_children(out, source, node)
    },
    _ => ua_walk_children(out, source, node)
  }
}

fn ua_walk_children(out: Array[String], source: String, node: Expr) -> Unit {
  let kids = expr_children(node)
  let mut i = 0
  while i < Array::length(kids) {
    ua_walk_expr(out, source, Array::get(kids, i))
    i = i + 1
  }
}

/// A guarded arm's fall-through match repeats the other arms, so only its
/// guard and its own body are walked; every arm is reached as an arm of the
/// match itself.
fn ua_walk_arm_bodies(out: Array[String], source: String, arms: Array[(Pat, Expr)]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, body) = Array::get(arms, i)
    match ua_guard_parts(body) {
      Some((cond, taken)) => {
        ua_walk_expr(out, source, cond)
        ua_walk_expr(out, source, taken)
      },
      None => ua_walk_expr(out, source, body)
    }
    i = i + 1
  }
}

/// `p if c => b` desugars to the arm `p => if c { b } else { match <temp>
/// { .. } }`; a source name can never be the temporary, so the shape is the
/// parser's alone.
fn ua_guard_parts(body: Expr) -> Option[(Expr, Expr)] {
  match source_expr(body) {
    EIf(cond, taken, rest) => match source_expr(rest) {
      EMatch(EIdent(temp, _), _) => if temp == match_scrutinee_temp() {
        Some((cond, taken))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

fn ua_check_arms(out: Array[String], source: String, arms: Array[(Pat, Expr)]) -> Unit {
  let mut j = 1
  while j < Array::length(arms) {
    let (later, _) = Array::get(arms, j)
    let (ls, le) = source_pat_range(later)
    if ls >= 0 && le > ls {
      let mut i = 0
      let mut found = false
      while i < j && !found {
        let (earlier, body) = Array::get(arms, i)
        let (es, ee) = source_pat_range(earlier)
        let guarded = match ua_guard_parts(body) {
          Some(_) => true,
          None => false
        }
        if es >= 0 && ee > es && !guarded && ua_covers(earlier, later) {
          found = true
          Array::push(out, String::concat("remove this unreachable `match` arm: the earlier arm `", String::concat(ua_one_line(String::substring(source, es, ee)), String::concat("` already matches every value this arm matches, and arms are tried in order", off_marker_len(ls, le - ls)))))
        } else {
          ()
        }
        i = i + 1
      }
    } else {
      ()
    }
    j = j + 1
  }
}

/// Whether every value `q` matches is also matched by `p`. Conservative: a
/// `false` answer may be wrong, a `true` answer never is.
fn ua_covers(p: Pat, q: Pat) -> Bool {
  let p0 = source_pat(p)
  let q0 = source_pat(q)
  if ua_irrefutable(p0) {
    true
  } else {
    ua_covers_refutable(p, p0, q0)
  }
}

fn ua_covers_refutable(p: Pat, p0: Pat, q0: Pat) -> Bool {
  match p0 {
    POr(a, b) => ua_covers(a, q0) || ua_covers(b, q0) || ua_covers_or_parts(p, q0),
    _ => match q0 {
      POr(c, d) => ua_covers(p, c) && ua_covers(p, d),
      _ => ua_covers_same_shape(p0, q0)
    }
  }
}

/// A pattern that matches every value of its type: a name, `_`, or a tuple or
/// struct pattern made only of those. The later arm is of the same type, so
/// such an arm covers it.
fn ua_irrefutable(p0: Pat) -> Bool {
  match p0 {
    PWild => true,
    PBind(_) => true,
    PTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) && ok {
        ok = ua_irrefutable(source_pat(Array::get(items, i)))
        i = i + 1
      }
      ok
    },
    PStruct(_, fields) => ua_fields_irrefutable(fields),
    _ => false
  }
}

fn ua_covers_or_parts(p: Pat, q0: Pat) -> Bool {
  match q0 {
    POr(c, d) => ua_covers(p, c) && ua_covers(p, d),
    _ => false
  }
}

fn ua_covers_same_shape(p0: Pat, q0: Pat) -> Bool {
  match (p0, q0) {
    (PInt(a), PInt(b)) => a == b,
    (PString(a), PString(b)) => a == b,
    (PBool(a), PBool(b)) => a == b,
    (PCtor(n, ps), PCtor(m, qs)) => n == m && ua_covers_all(ps, qs),
    (PTuple(ps), PTuple(qs)) => ua_covers_all(ps, qs),
    _ => false
  }
}

fn ua_covers_all(ps: Array[Pat], qs: Array[Pat]) -> Bool {
  if Array::length(ps) != Array::length(qs) {
    false
  } else {
    let mut ok = true
    let mut i = 0
    while i < Array::length(ps) && ok {
      ok = ua_covers(Array::get(ps, i), Array::get(qs, i))
      i = i + 1
    }
    ok
  }
}

fn ua_fields_irrefutable(fields: Array[(String, Pat)]) -> Bool {
  let mut ok = true
  let mut i = 0
  while i < Array::length(fields) && ok {
    let (_, fp) = Array::get(fields, i)
    ok = ua_irrefutable(source_pat(fp))
    i = i + 1
  }
  ok
}

fn ua_text_at(source: String, start: Int, text: String) -> Bool {
  let n = String::length(text)
  start + n <= String::length(source) && String::substring(source, start, start + n) == text
}

/// A pattern's text on one line, shortened past 40 bytes.
fn ua_one_line(text: String) -> String {
  let nl = String::index_of(text, "\n")
  let line = if nl >= 0 {
    String::concat(String::substring(text, 0, nl), " ..")
  } else {
    text
  }
  if String::length(line) > 40 {
    String::concat(String::substring(line, 0, 40), " ..")
  } else {
    line
  }
}
