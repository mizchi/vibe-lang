//# A functional builtin's result thrown away (#4142)
//
// `Map::set` and `Map::delete` return a new map and leave their receiver
// alone. Written as a statement -- the way `Array::push` / `Array::set`, which
// do mutate in place, are written -- the call is a silent no-op: the program
// checks, runs, and nothing reaches the map. Measured on #4140, a helper that
// deduplicated names this way did nothing, and a test kept passing against a
// fixture whose maps it had meant to fill.
//
// So a call to one of them whose value is thrown away is refused, with the
// edit. A statement of a block (`taken = ..` missing), the value of a
// statement-position `if` / `match` branch or `for` body, and a `while` body
// wherever the loop stands, are thrown away; `let _ = Map::set(..)` still
// discards on purpose. Only the builtin is judged: a program's own function
// of that spelling is its own business.

import @vibe/compiler/core {
  Expr, Pat, TypeEnv, call_arg_value
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_resolves_at
}

import @vibe/compiler/checker/diagnostics {
  off_marker_len
}

import @vibe/compiler/checker/resume {
  arm_refs_resume_value, pat_binds_resume
}

/// Refuse every call of a functional builtin whose value `stmt`, a statement
/// of a block or a loop body, throws away. A statement's own inner statements
/// are judged when the checker reaches their block, so only the value it ends
/// in is read here -- through bindings, assignments and statement `if` /
/// `match` branches.
///
/// One walker judges every discarded value, so each site is reported once.
/// It starts exactly where a value is thrown away -- the left side of a block
/// statement (`check_seq_spine`) and a `while` body -- and follows that value
/// to its end: through bindings, assignments, statement `if` / `match`
/// branches, and into a `for`, whose body's values are dropped with the
/// `for`'s own. A `for` reached here sits in a discarded position by
/// construction; a `for` used as an expression is never reached, since no
/// walk starts at an expression (ADR-0116). The checker does not refuse a
/// `for` body again where it types the `for`: two authorities disagreed about
/// which `for` each owned, and a `for` after an assignment fell between them.
export fn refuse_discarded_functional_result(stmt: Expr, env: TypeEnv, errors: Array[String]) -> Unit {
  discarded_result_walk(e = stmt, env = env, errors = errors)
}

fn discarded_result_walk(e: Expr, env: TypeEnv, errors: Array[String]) -> Unit {
  match e {
    ECall(EIdent(name, noff), args, _, _) => if discarded_result_is_functional(name) && builtin_resolves_at(env = env, name = name, ident_off = noff) {
      Array::push(errors, value = discarded_result_message(name = name, args = args, noff = noff))
    },
    ESeq(_, rest) => discarded_result_walk(e = rest, env = env, errors = errors),
    ELet(_, _, body, _) => discarded_result_walk(e = body, env = env, errors = errors),
    ELetMut(_, _, body, _) => discarded_result_walk(e = body, env = env, errors = errors),
    ELetRec(_, _, body) => discarded_result_walk(e = body, env = env, errors = errors),
    // `x = v` then the rest of the block: the block's value is the rest's.
    EAssign(_, _, rest, _) => discarded_result_walk(e = rest, env = env, errors = errors),
    EAssignOp(_, _, _, rest, _) => discarded_result_walk(e = rest, env = env, errors = errors),
    EIf(_, then_e, else_e) => {
      discarded_result_walk(e = then_e, env = env, errors = errors)
      discarded_result_walk(e = else_e, env = env, errors = errors)
    },
    EMatch(_, arms) => for arm in arms {
      discarded_result_walk(e = arm.1, env = env, errors = errors)
    },
    EForIn(_, _, _, body) => {
      discarded_result_walk(e = body, env = env, errors = errors)
    },
    // A `handle`'s value is its body's when the body completes, unless an arm
    // binds `resume` as a value: calling that continuation hands the body's
    // value to the arm, which may keep it (`let k = resume; let r = k(v)`),
    // so the body is walked only when no arm does. A tail `resume(v)` passes
    // the body's value straight through as the arm's own. The arms are not
    // walked: whether an arm's value is the `handle`'s depends on how it
    // resumes, and a wrong guess would refuse a program that is fine. A
    // `while` reached here is skipped too -- its own site walks its body.
    EHandle(hbody, harms) => if !handle_arm_keeps_body_value(harms) {
      discarded_result_walk(e = hbody, env = env, errors = errors)
    } else {
      ()
    },
    _ => ()
  }
}

/// A builtin whose only effect is the value it returns, and whose receiver a
/// reader may expect it to change.
fn discarded_result_is_functional(_ name: String) -> Bool {
  name == "Map::set" || name == "Map::delete"
}

/// The refusal, the edit first: assign the new map back (or bind it).
fn discarded_result_message(name: String, args: Array[Expr], noff: Int) -> String {
  let receiver = if Array::length(args) > 0 {
    match call_arg_value(Array::get(args, at = 0)) {
      EIdent(r, _) => r,
      _ => ""
    }
  } else {
    ""
  }
  let edit = if receiver == "" {
    "bind the result of `" + name + "` (`let updated = " + name + "(..)`)"
  } else {
    "write `" + receiver + " = " + name + "(" + receiver + ", ..)` (with `let mut " + receiver + "`), or bind the result (`let updated = " + name + "(" + receiver + ", ..)`)"
  }
  let unchanged = if receiver == "" {
    "its argument"
  } else {
    "`" + receiver + "`"
  }
  edit + ": `" + name + "` returns a new map and leaves " + unchanged + " unchanged, so this statement does nothing. Write `let _ = " + name + "(..)` to discard it on purpose." + off_marker_len(off = noff, len = String::length(name))
}

/// Does an arm of this `handle` bind its continuation as a value? Such an arm
/// receives the body's value from the continuation call and may keep it.
fn handle_arm_keeps_body_value(_ harms: Array[(Pat, Expr)]) -> Bool {
  let mut keeps = false
  for arm in harms {
    if arm_refs_resume_value(e = arm.1, sh = pat_binds_resume(arm.0)) {
      keeps = true
    } else {
      ()
    }
  }
  keeps
}
