//# Bounded retained expression structural coordinates
//
// Internal shared preorder used by structure-only and checker-attested
// observations. It is deliberately core-only and fails closed before any
// observer can attempt to check malformed/cyclic retained syntax.

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Expr, Stmt, expr_children
}

export fn checked_expression_structure_max_rows() -> Int {
  262144
}

export fn checked_expression_structure_max_depth() -> Int {
  2048
}

export fn checked_expression_structure_copy_path(path: Array[Int]) -> Array[Int] {
  Array::slice(path, 0, Array::length(path))
}

fn checked_expression_structure_child_path(path: Array[Int], child: Int) -> Array[Int] {
  let out = checked_expression_structure_copy_path(path)
  Array::push(out, child)
  out
}

/// Closed constructor-tag authority shared by structural artifacts.
export fn checked_expression_structure_kind_valid(kind: String) -> Bool {
  kind == "EInt" || kind == "EFloat" || kind == "EString" || kind == "EBool" || kind == "EIdent" || kind == "ETuple" || kind == "EArray" || kind == "ERecord" || kind == "EIf" || kind == "ELet" || kind == "ELetRec" || kind == "ELetMut" || kind == "EAssign" || kind == "EAssignOp" || kind == "ESeq" || kind == "EMatch" || kind == "EHandle" || kind == "EWhile" || kind == "ELoop" || kind == "EForIn" || kind == "ECall" || kind == "EBinOp" || kind == "EUnaryOp" || kind == "EFn" || kind == "EDot" || kind == "ELabeledArg" || kind == "EReturn" || kind == "EBreak" || kind == "EContinue" || kind == "EMap" || kind == "ESpread" || kind == "EStringInterp" || kind == "EUnit"
}

export fn checked_expression_structure_kind(expr: Expr) -> String {
  match expr {
    EInt(_) => "EInt",
    EFloat(_) => "EFloat",
    EString(_) => "EString",
    EBool(_) => "EBool",
    EIdent(_, _) => "EIdent",
    ETuple(_) => "ETuple",
    EArray(_) => "EArray",
    ERecord(_, _, _) => "ERecord",
    EIf(_, _, _) => "EIf",
    ELet(_, _, _, _) => "ELet",
    ELetRec(_, _, _) => "ELetRec",
    ELetMut(_, _, _, _) => "ELetMut",
    EAssign(_, _, _) => "EAssign",
    EAssignOp(_, _, _, _) => "EAssignOp",
    ESeq(_, _) => "ESeq",
    EMatch(_, _) => "EMatch",
    EHandle(_, _) => "EHandle",
    EWhile(_, _) => "EWhile",
    ELoop(_, _) => "ELoop",
    EForIn(_, _, _, _) => "EForIn",
    ECall(_, _, _) => "ECall",
    EBinOp(_, _, _) => "EBinOp",
    EUnaryOp(_, _) => "EUnaryOp",
    EFn(_, _, _, _, _, _) => "EFn",
    EDot(_, _, _, _) => "EDot",
    ELabeledArg(_, _, _) => "ELabeledArg",
    EReturn(_) => "EReturn",
    EBreak(_) => "EBreak",
    EContinue(_) => "EContinue",
    EMap(_) => "EMap",
    ESpread(_) => "ESpread",
    EStringInterp(_) => "EStringInterp",
    EUnit => "EUnit"
  }
}

fn collect_checked_expression_structure_expr(rows: Array[(Array[Int], Array[Int], String)], statement_path: Array[Int], root: Expr) -> Bool {
  let stack = array_empty()
  Array::push(stack, (root, array_empty()))
  let mut complete = true
  while Array::length(stack) > 0 && complete {
    let stack_len = Array::length(stack)
    let (expr, expression_path) = Array::get(stack, stack_len - 1)
    Array::truncate(stack, stack_len - 1)
    if Array::length(expression_path) > checked_expression_structure_max_depth() || Array::length(rows) >= checked_expression_structure_max_rows() {
      complete = false
    } else {
      Array::push(rows, (checked_expression_structure_copy_path(statement_path), checked_expression_structure_copy_path(expression_path), checked_expression_structure_kind(expr)))
      let children = expr_children(expr)
      if Array::length(children) > checked_expression_structure_max_rows() - Array::length(stack) {
        complete = false
      } else {
        let mut i = Array::length(children)
        while i > 0 && complete {
          let child_index = i - 1
          let child_path = checked_expression_structure_child_path(expression_path, child_index)
          if Array::length(child_path) > checked_expression_structure_max_depth() {
            complete = false
          } else {
            Array::push(stack, (Array::get(children, child_index), child_path))
          }
          i = i - 1
        }
      }
    }
  }
  complete
}

fn push_checked_expression_structure_stmts(stack: Array[(Stmt, Array[Int])], parent_path: Array[Int], stmts: Array[Stmt]) -> Bool {
  if Array::length(parent_path) >= checked_expression_structure_max_depth() || Array::length(stmts) > checked_expression_structure_max_rows() - Array::length(stack) {
    false
  } else {
    let mut i = Array::length(stmts)
    while i > 0 {
      let statement_index = i - 1
      Array::push(stack, (Array::get(stmts, statement_index), checked_expression_structure_child_path(parent_path, statement_index)))
      i = i - 1
    }
    true
  }
}

/// Return the complete retained statement/expression preorder skeleton, or no
/// rows. Unlowered declarations, depth/row exhaustion, and cycles fail closed.
export fn checked_expression_structure_rows(stmts: Array[Stmt]) -> Option[Array[(Array[Int], Array[Int], String)]] {
  let rows = array_empty()
  let stack = array_empty()
  let mut complete = push_checked_expression_structure_stmts(stack, array_empty(), stmts)
  let mut visited = 0
  while Array::length(stack) > 0 && complete {
    let stack_len = Array::length(stack)
    let (stmt, statement_path) = Array::get(stack, stack_len - 1)
    Array::truncate(stack, stack_len - 1)
    visited = visited + 1
    if visited > checked_expression_structure_max_rows() || Array::length(statement_path) > checked_expression_structure_max_depth() {
      complete = false
    } else {
      match stmt {
        SLet(_, _, _, _, value) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, value)
        },
        SLetMut(_, _, value) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, value)
        },
        STest(_, body) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, body)
        },
        SBench(_, body) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, body)
        },
        SExpr(expr) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, expr)
        },
        SLetPat(_, value) => {
          complete = collect_checked_expression_structure_expr(rows, statement_path, value)
        },
        SModule(_, _, body) => {
          complete = push_checked_expression_structure_stmts(stack, statement_path, body)
        },
        SFnDecl(_, _, _, _, _) => {
          complete = false
        },
        SEnum(_, _, _, _, _) => (),
        SSuberror(_, _, _) => (),
        SStruct(_, _, _, _, _, _) => (),
        STypeAlias(_, _, _, _) => (),
        STrait(_, _, _, _, _, _) => (),
        SImpl(_, _, _, _) => (),
        SExternLet(_, _) => (),
        SImport(_, _) => (),
        SExport(_) => (),
        SReExport(_, _) => (),
        SAliasDecl(_, _) => (),
        SEffectDef(_, _, _, _) => (),
        SEffectSet(_, _, _) => ()
      }
    }
  }
  if complete {
    Some(rows)
  } else {
    None
  }
}
