//# Imports

// #415 B-2: func-table builtin signatures live in core's central registry;
// the registry lookup is consulted FIRST below, so the per-namespace files
// no longer carry (and must not re-add) arms for registry names.
import @vibe/compiler/core {
  Type, canonical_builtin_name, lookup_registry_builtin
}

import ./builtins_array.vibe {
  lookup_array
}

import ./builtins_async.vibe {
  lookup_async
}

import ./builtins_builders.vibe {
  lookup_array_builder, lookup_string_builder
}

import ./builtins_bytes.vibe {
  lookup_bytes
}

import ./builtins_fixed_array.vibe {
  lookup_fixed_array
}

import ./builtins_frozen_array.vibe {
  lookup_frozen_array
}

import ./builtins_fs.vibe {
  lookup_fs
}

import ./builtins_map.vibe {
  lookup_map
}

import ./builtins_misc.vibe {
  lookup_misc
}

import ./builtins_simd.vibe {
  lookup_simd
}

import ./builtins_net.vibe {
  lookup_net
}

import ./builtins_string1.vibe {
  lookup_string1
}

import ./builtins_string2.vibe {
  lookup_string2
}

import ./builtins_system.vibe {
  lookup_io
}

//# Functions

export fn lookup_builtin(name: String) -> Option[Type] {
  let normalized = canonical_builtin_name(name)
  match lookup_registry_builtin(normalized) {
    Some(t) => Some(t),
    None => lookup_builtin_fallback(normalized)
  }
}

/// The per-lane `lookup_*` chain, consulted only when the central registry
/// (`core/builtin_registry.vibe`) has no checker-visible row for the name.
///
/// #1593: this chain contains fallback-only declarations. The invariant in
/// `tests/builtins_test.vibe` rejects any checker-visible registry name that is
/// reintroduced here; registry-backed signatures belong only in the central
/// registry.
///
/// Takes an ALREADY-normalized name (`canonical_builtin_name`), like the lane
/// lookups it delegates to.
export fn lookup_builtin_fallback(normalized: String) -> Option[Type] {
  match lookup_array(normalized) {
    Some(t) => Some(t),
    None => match lookup_fixed_array(normalized) {
      Some(t) => Some(t),
      None => match lookup_frozen_array(normalized) {
        Some(t) => Some(t),
        None => match lookup_array_builder(normalized) {
          Some(t) => Some(t),
          None => match lookup_string1(normalized) {
            Some(t) => Some(t),
            None => match lookup_string2(normalized) {
              Some(t) => Some(t),
              None => match lookup_string_builder(normalized) {
                Some(t) => Some(t),
                None => match lookup_bytes(normalized) {
                  Some(t) => Some(t),
                  None => match lookup_simd(normalized) {
                    Some(t) => Some(t),
                    None => match lookup_map(normalized) {
                      Some(t) => Some(t),
                      None => match lookup_io(normalized) {
                        Some(t) => Some(t),
                        None => match lookup_fs(normalized) {
                          Some(t) => Some(t),
                          None => match lookup_net(normalized) {
                            Some(t) => Some(t),
                            None => match lookup_misc(normalized) {
                              Some(t) => Some(t),
                              None => lookup_async(normalized)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
