//# Imports

import ../builtin_name.vibe {
  canonical_builtin_name
}

// #415 B-2: func-table builtin signatures live in the central registry; the
// registry lookup is consulted FIRST below, so the per-namespace files no
// longer carry (and must not re-add) arms for registry names.
//
// #847 Phase C exception: this deliberately imports the internal file
// directly rather than `../codegen/index.vibe`. Routing it through the full
// facade pulls codegen's ENTIRE transitive graph (expr/, wasi/, gc/,
// wasm_emit/, ...) into every program that imports checker/builtins.vibe
// (which is nearly everything, since the checker is loaded everywhere).
// That was found to trigger a pre-existing whole-program-merge bug: some
// far-removed file (e.g. lib/@vibe/core/diff.vibe's has_changes) becomes
// reachable via two independent import paths once codegen is added to the
// graph, and the merge's export-rename dedup mis-handles the resulting
// duplicate, producing a wasm CompileError ("not enough arguments on the
// stack for call") in an unrelated function. Reproduced via
// checker_pattern_test.vibe: passes against baseline, fails once this
// import routes through codegen/index.vibe. See #847.
import ../codegen/builtin_registry.vibe {
  lookup_registry_builtin
}

import ../core/index.vibe {
  Type
}

import ./builtins_array.vibe {
  lookup_array
}

import ./builtins_async.vibe {
  lookup_async
}

import ./builtins_builders.vibe {
  lookup_array_builder, lookup_string_builder
}

import ./builtins_bytes.vibe {
  lookup_bytes
}

import ./builtins_fixed_array.vibe {
  lookup_fixed_array
}

import ./builtins_fs.vibe {
  lookup_fs
}

import ./builtins_map.vibe {
  lookup_map
}

import ./builtins_misc.vibe {
  lookup_misc
}

import ./builtins_simd.vibe {
  lookup_simd
}

import ./builtins_net.vibe {
  lookup_net
}

import ./builtins_string1.vibe {
  lookup_string1
}

import ./builtins_string2.vibe {
  lookup_string2
}

import ./builtins_system.vibe {
  lookup_io
}

//# Functions

export fn lookup_builtin(name: String) -> Option[Type] {
  let normalized = canonical_builtin_name(name)
  match lookup_registry_builtin(normalized) {
    Some(t) => Some(t),
    None => match lookup_array(normalized) {
    Some(t) => Some(t),
    None => match lookup_fixed_array(normalized) {
      Some(t) => Some(t),
      None => match lookup_array_builder(normalized) {
        Some(t) => Some(t),
        None => match lookup_string1(normalized) {
          Some(t) => Some(t),
          None => match lookup_string2(normalized) {
            Some(t) => Some(t),
            None => match lookup_string_builder(normalized) {
              Some(t) => Some(t),
              None => match lookup_bytes(normalized) {
                Some(t) => Some(t),
                None => match lookup_simd(normalized) {
                Some(t) => Some(t),
                None => match lookup_map(normalized) {
                  Some(t) => Some(t),
                  None => match lookup_io(normalized) {
                    Some(t) => Some(t),
                    None => match lookup_fs(normalized) {
                      Some(t) => Some(t),
                      None => match lookup_net(normalized) {
                        Some(t) => Some(t),
                        None => match lookup_misc(normalized) {
                          Some(t) => Some(t),
                          None => lookup_async(normalized)
                        }
                      }
                    }
                  }
                }
                }
              }
            }
          }
        }
      }
    }
  }
  }
}
