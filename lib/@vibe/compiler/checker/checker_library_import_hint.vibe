//# Library names the checker does not know without their import (#3549)
//#
//# `Int::abs`, `Option::unwrap_or`, `String::pad_left` and the rest are
//# functions `@vibe/builtin` exports, not compiler builtins, so a call
//# without the import is `unknown name`. That is true, and answers the wrong
//# question for someone who reasonably expected an `Int` operation to be
//# there. The hint names the one-line edit.
//#
//# The list is the qualified names `lib/@vibe/builtin/index.vpkg` declares
//# that are unknown without the import, measured, and every one of them
//# imports cleanly. `tests/builtin_library_import_hint_test.vibe` checks it
//# against the contract, so a name added there without a row here fails.

//# Functions

/// " -- it is a library function, not a builtin: add `import @vibe/builtin {
/// NAME }`" when `name` is one of `@vibe/builtin`'s qualified exports, else "".
export fn builtin_library_import_hint(_ name: String) -> String {
  if builtin_library_name_known(name) {
    String::concat(String::concat(" -- it is a library function, not a builtin: add `import @vibe/builtin { ", name), " }`")
  } else {
    ""
  }
}

fn builtin_library_name_known(_ name: String) -> Bool {
  let names = builtin_library_names()
  let mut found = false
  let mut i = 0
  while i < Array::length(names) && !found {
    found = Array::get(names, at = i) == name
    i = i + 1
  }
  found
}

/// The qualified `@vibe/builtin` exports a program reaches only by import.
