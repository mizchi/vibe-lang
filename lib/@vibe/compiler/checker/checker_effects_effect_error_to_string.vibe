/// #2964: every missing label is the ERASED exception (`Exception` /
/// `Exception::Throw`).
fn missing_is_erased_exception_only(missing: String) -> Bool {
  let parts = String::split(missing, ",")
  let mut ok = Array::length(parts) > 0
  let mut i = 0
  while i < Array::length(parts) {
    let p = String::trim(Array::get(parts, i))
    // #1963: the exception policy's predicates, not the spelling -- the
    // legacy `Error` alias is the same erased exception.
    if !is_exception_label(p) || String::length(exception_label_kind(p)) > 0 {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// #2964: the declared row names a kinded exception and no erased one.
fn declared_is_kinded_exception(declared: String) -> Bool {
  let parts = String::split(declared, ",")
  let mut kinded = false
  let mut erased = false
  let mut i = 0
  while i < Array::length(parts) {
    let p = String::trim(Array::get(parts, i))
    if !is_exception_label(p) {
      ()
    } else if String::length(exception_label_kind(p)) > 0 {
      kinded = true
    } else {
      erased = true
    }
    i = i + 1
  }
  kinded && !erased
}

export fn effect_error_to_string(err: EffectError) -> String {
  match err {
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name),
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with` row or wrap in a `handle`")))),
    // #639: expected-vs-actual effect rows as a set difference, then ONE
    // deterministic fix-it hint line targeting the enclosing declaration
    // (for a call-site leak that is the CALLER, not the callee).
    EEMultipleExceptionArms(fname, arms) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      String::concat("a handle may have only ONE exception arm, in ", String::concat(where_, String::concat(" it has { ", String::concat(arms, " }: the exception channel carries no kind and only the first exception arm is compiled, so the others can never run\nhint: keep one arm -- an erased `Exception::Throw(m)` arm catches every kind, and the payload can be matched inside it -- or nest one handle inside another"))))
    },
    EEKindedHandleCatchesAll(fname, handler, offending, off) => {
      let block = entry_block_display_name(fname)
      let where_ = if String::length(block) > 0 {
        block
      } else {
        String::concat("'", String::concat(fname, "'"))
      }
      let body = String::concat("handler arm `", String::concat(handler, String::concat("::Throw` catches EVERY exception its body raises at run time (the exception channel carries no kind), so the body may raise only `", String::concat(handler, String::concat("`; in ", String::concat(where_, String::concat(" it also raises { ", String::concat(offending, " }\nhint: add an arm for that kind, use the erased `Exception::Throw(m)` arm (which catches everything, with an untyped payload), give the throw a payload of the handled kind, or move that call outside this handle"))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEEffectRowMismatch(fname, missing0, declared0, required0, off) => {
      // #3051: a published row spells a formal `NAME$K`; show `NAME`.
      // #3351: and a struct `^Name` or an enum `^^Name`; show `Name`.
      let missing = strip_published_row_marks(missing0)
      let declared = strip_published_row_marks(declared0)
      let required = strip_published_row_marks(required0)
      let block = entry_block_display_name(fname)
      let head = if String::length(block) > 0 {
        String::concat("effect row mismatch for ", block)
      } else if String::length(fname) > 0 {
        String::concat("effect row mismatch for '", String::concat(fname, "'"))
      } else {
        "effect row mismatch"
      }
      let detail = if String::length(declared) > 0 {
        String::concat(" (declared { ", String::concat(declared, String::concat(" }, requires { ", String::concat(row_set_for_reader(required), " })"))))
      } else {
        String::concat(" (no 'with' clause, requires { ", String::concat(row_set_for_reader(required), " })"))
      }
      // ADR-0088: an entry point (`main` / `_start`, a `test` / `bench` /
      // `example` block) GRANTS its row, so the edit it is told is `allows`;
      // a called function requires, so its edit stays `with`.
      let entry_block = entry_block_display_name(fname)
      let hint = if row_has_ambiguous_label(required) {
        // Codex on #3055: a call whose instantiation is ambiguous (`?S`, two
        // merged sources' calls at one position) fails closed, and no row can
        // spell `?S`, so the hint names the cause instead of an edit.
        "\nhint: the type a generic callee's row takes at this call could not be determined -- another call at the same source position (sources merged without separate positions) instantiates it differently -- so no row authorizes it; check this file on its own with `vibe check` to see the concrete row"
      } else if missing_is_erased_exception_only(missing) && declared_is_kinded_exception(declared) {
        // #2964 / #3015: the requirement is an exception whose KIND this check
        // could not resolve, under a row that promises kinds. Adding the erased
        // label is one honest edit; the others keep the kinded promise.
        "\nhint: the kind of this exception is not known here, and a kinded row promises exactly its kinds -- give the thrown value a type (`let e: K = ..` then `throw(e)`), give the callback or callee a kinded `with Exception[K]` row, or declare the erased `with Exception`"
      } else if String::length(fname) == 0 {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), "' to the enclosing function"))
      } else if String::length(entry_block) > 0 {
        String::concat("\nhint: add 'allows ", String::concat(row_as_source(required), String::concat("' to ", entry_block)))
      } else if is_program_entry_name(fname) && String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat(" allows ", String::concat(row_as_source(required), "'"))))
      } else if is_program_entry_name(fname) {
        String::concat("\nhint: add 'allows ", String::concat(row_as_source(required), String::concat("' to '", String::concat(fname, "'"))))
      } else if String::length(declared) == 0 {
        String::concat("\nhint: declare 'fn ", String::concat(fname, String::concat("(...) -> T with ", String::concat(row_as_source(required), "'"))))
      } else {
        String::concat("\nhint: add 'with ", String::concat(row_as_source(required), String::concat("' to '", String::concat(fname, "'"))))
      }
      // A kind the row syntax cannot spell is pasted through an alias, whose
      // declaration leads the hint.
      let decls = row_unspellable_kind_decls(required)
      let hint = if String::length(decls) > 0 && String::starts_with(hint, "\nhint: ") {
        String::concat("\nhint: ", String::concat(decls, String::substring(hint, 7, String::length(hint))))
      } else {
        hint
      }
      let body = String::concat(head, String::concat(": missing { ", String::concat(row_set_for_reader(missing), String::concat(" }", String::concat(detail, hint)))))
      // #1514: marker LAST so the hint line stays the visible tail; the decoder
      // strips it before the user ever sees the string.
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUndischargedEntryEffect(entry_name, effects, handlers, off) => {
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" cannot discharge { ", String::concat(effects, String::concat(" }: no host provider or runtime handler owns this effect\nhint: ", String::concat(row_unspellable_kind_decls(handlers), String::concat("wrap the operation in `handle ... with ", String::concat(row_as_source(handlers), " { ... }` before it reaches the entry boundary"))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEUnresolvedEntryEffectRow(entry_name, variables, off) => {
      let body = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" has unresolved effect row { ", String::concat(variables, " }: entry rows must be concrete\nhint: close the entry row, or discharge each concrete effect with `handle` before it reaches the entry boundary"))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGrantForRequiredCall(fname, op, grant, off) => {
      // An entry GRANTS (`allows`), a called function REQUIRES (`with`).
      let is_entry = is_entry_point_name(fname)
      let keyword = if is_entry {
        "allows"
      } else {
        "with"
      }
      let verb = if is_entry {
        "granted"
      } else {
        "declared"
      }
      // The grant is quoted as written -- `Fs::read_file?`, or the
      // provider-wide `Fs?` -- so the "drop the `?`" edit names that label.
      let head = String::concat("`", String::concat(op, String::concat("` is ", String::concat(verb, String::concat(" as optional (`", String::concat(keyword, String::concat(" ", String::concat(grant, String::concat("`) but ", String::concat(row_owner_display_name(fname), " calls it as required"))))))))))
      let hint = String::concat("\nhint: call it with `perform? ", String::concat(op, String::concat("(..)` and match the `Attempt`, or drop the `?` (`", String::concat(keyword, String::concat(" ", String::concat(strip_authority_grade(grant), "`)"))))))
      let body = String::concat(head, hint)
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEOptionalGradeNotCapability(fname, label) => {
      let core = strip_authority_grade(label)
      String::concat("`", String::concat(label, String::concat("` in the row of ", String::concat(row_owner_display_name(fname), String::concat(": `?` marks a host capability optional, and `", String::concat(core, String::concat("` is not one (it has no host provider)\nhint: drop the `?` -- `", String::concat(core, "` is required, handled or runtime-managed, never optional"))))))))
    },
    EEUnknownProviderOperation(entry_name, label) => {
      let provider = effect_name_of_op(label)
      let head = String::concat("entry point ", String::concat(entry_display_name(entry_name), String::concat(" grants `", String::concat(label, String::concat("`, but the `", String::concat(provider, "` provider has no such operation"))))))
      String::concat(head, String::concat("\nhint: grant the provider (`allows ", String::concat(provider, "`) or one of its operations")))
    },
    EEProviderOperationCollision(operation) => String::concat("user effect operation `", String::concat(operation, "` collides with a registry-owned host provider operation; rename the user operation so it cannot impersonate provider authority")),
    EEAssignImmutable(name) => String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)")),
    EEStdinProviderValueReference(name) => String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function")),
    EEHandleNeverFires(eff) => {
      let tail = String::concat(eff, "::..` and calls an opaque function value. A continuation captured by another handler carries THAT handler with it, so wrapping its invocation in a new `handle` does not switch handlers (non-scoped resumption is unsupported -- ADR-0089 Part A, #1347). Drive the continuation without the wrapping handle, or handle the effect where it is performed")
      String::concat("handle of effect '", String::concat(eff, String::concat("' can never fire: this body reaches no `perform ", tail)))
    },
    EEHandleRowlessClosure(eff, cname, off) => {
      let edit = String::concat("give the local closure `", String::concat(cname, String::concat("` an effect row -- `let ", String::concat(cname, String::concat(" = (..) -> T with ", String::concat(eff, String::concat(" { .. }` -- or write its `perform ", String::concat(eff, "::..` directly in the handled body"))))))))
      let why = String::concat(": `", String::concat(cname, String::concat("` has no row, so this handle of effect '", String::concat(eff, "' cannot see the perform that the call to it reaches"))))
      let body = String::concat(edit, why)
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEHandleMutableAlias(eff, cname, off) => {
      let body = String::concat("handle of effect '", String::concat(eff, String::concat("' cannot compile a call through mutable local `", String::concat(cname, "`: bind the function with immutable `let` and `with "))))
      let message = String::concat(body, String::concat(eff, "`, or call the effectful function directly inside the handle"))
      if off >= 0 {
        String::concat(message, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        message
      }
    },
    EEEmptyHandle => "handler must contain at least one arm; an empty handler cannot discharge an effect",
    EEPerformQuestionRequiresOptional(fname, operation, off) => {
      // The edit names the keyword the row's owner takes: an entry GRANTS
      // (`allows`), a called function REQUIRES (`with`) -- telling a called
      // function to write `allows` would only lead to the parse error that
      // refuses it there (Codex review on PR #2653).
      let keyword = if is_entry_point_name(fname) {
        "allows"
      } else {
        "with"
      }
      let body = String::concat("`perform? ", String::concat(operation, String::concat("` requires the optional grade: write `", String::concat(keyword, String::concat(" ", String::concat(operation, String::concat("?` on ", String::concat(row_owner_display_name(fname), String::concat(", or call `", String::concat(operation, "(..)` plainly"))))))))))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionAlwaysGranted(fname, operation, grant, off) => {
      let block = entry_block_display_name(fname)
      let body = if String::length(grant) == 0 {
        // A test artifact resolves every optional grant to `Granted`
        // (optional_perform_artifact_resolution): the block runs with full
        // authority, so a `perform?` written in it advertises an arm that
        // can never run.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` in ", String::concat(block, ": a `test` / `bench` / `example` block runs with full authority, so the operation is always granted and `NotGranted` can never happen here"))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or move the `perform?` into a function that requires `with ", String::concat(operation, "?` and call that from the block")))))
      } else {
        // Required is the join of the grade lattice: a required grant of the
        // operation or of its provider absorbs the optional one.
        let head = String::concat("`perform? ", String::concat(operation, String::concat("` can never be `NotGranted` here: ", String::concat(row_owner_display_name(fname), String::concat(" grants `", String::concat(grant, String::concat("` as required, and Required absorbs the optional grade of `", String::concat(operation, "`"))))))))
        String::concat(head, String::concat("\nhint: call `", String::concat(operation, String::concat("(..)` plainly, or grant `", String::concat(operation, String::concat("?` without the required `", String::concat(grant, "`")))))))
      }
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionSourceShadow(operation, off) => {
      let body = String::concat("`perform? ", String::concat(operation, "(..)` resolves to a source function, not a capability operation; rename the source function or call the capability under an unshadowed name"))
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    },
    EEPerformQuestionInvalidOperand(off) => {
      let body = "`perform?` takes a capability-operation call, like `perform? Fs::read_file(path)`. Either call an operation here, or drop `perform?` from this expression."
      if off >= 0 {
        String::concat(body, String::concat(" [@off=", String::concat(__to_string(off), "]")))
      } else {
        body
      }
    }
  }
}

//# Async-scoped effect enforcement (the pass wired into `check_program`)
//
// This pass enforces ONLY the `Async` effect, and only
// for async PRIMITIVES — builtins such as `await(..)` and `sleep(..)`
// whose type carries `with Async`, including the `await(..)` the async
// desugar injects over a Future-returning iterator. A primitive must appear
// inside a function/lambda annotated `with Async`.
//
// Crucially it does NOT propagate to user functions that merely COMPOSE async
// work: calling a `with Async` helper (e.g. `AsyncIter::collect`) from a
// sync context is allowed (await is the identity on the synchronous backend,
// and on a real async backend the value/Future mismatch is a separate type
// error). Only env-absent BUILTIN primitives are checked, so the compiler /
// prelude — which use `Async` only in the disciplined async_iter terminals —
// stay green while `for` over an async stream becomes sound (#2+#3).

export fn effect_opt_is_async(eff: Option[String]) -> Bool {
  effect_row_contains_label(eff, "Async")
}

fn is_stdin_provider_surface(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// #1539: the four public provider operations are syntactic direct-call
/// primitives, not first-class function values. A direct `ECall` skips its
/// exact builtin callee but still checks every argument; every other expression
/// position is traversed structurally. This rejects aliases, chains,
/// conditionals, returned/container values, and unknown HOF transport without
/// attempting the generic effect-flow propagation deliberately deferred by
/// #1536. An explicitly effectful user wrapper remains an ordinary function.
fn check_stdin_provider_direct_calls_expr(expr: Expr) -> Array[EffectError] {
  let out = array_empty()
  check_stdin_provider_direct_calls_expr_into(expr, out)
  out
}

fn check_stdin_provider_direct_calls_expr_into(expr: Expr, out: Array[EffectError]) -> Unit {
  match expr {
    ECall(EIdent(name, _), args, _, _) => {
      if is_stdin_provider_surface(name) {
        let mut ai = 0
        while ai < Array::length(args) {
          check_stdin_provider_direct_calls_expr_into(Array::get(args, ai), out)
          ai = ai + 1
        }
      } else {
        let mark = expr_children_push(expr)
        let end = expr_children_top()
        let mut i = mark
        while i < end {
          check_stdin_provider_direct_calls_expr_into(expr_child_at(i), out)
          i = i + 1
        }
        expr_children_pop(mark)
      }
    },
    EIdent(name, _) => if is_stdin_provider_surface(name) {
      Array::push(out, EEStdinProviderValueReference(name))
    } else {
      ()
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_stdin_provider_direct_calls_expr_into(expr_child_at(i), out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

fn check_stdin_provider_direct_calls_stmt(stmt: Stmt) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, _, body) => check_stdin_provider_direct_calls_expr(body),
    SLetMut(_, _, body) => check_stdin_provider_direct_calls_expr(body),
    STest(_, body) => check_stdin_provider_direct_calls_expr(body),
    SBench(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExample(_, body) => check_stdin_provider_direct_calls_expr(body),
    SExpr(body) => check_stdin_provider_direct_calls_expr(body),
    SLetPat(_, body) => check_stdin_provider_direct_calls_expr(body),
    SModule(_, _, inner) => check_stdin_provider_direct_calls_stmts(inner),
    _ => array_empty()
  }
}

export fn check_stdin_provider_direct_calls_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_stdin_provider_direct_calls_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  errors
}

/// True only for async-effect BUILTIN primitives (await/sleep/...).
/// A name bound in `env` (a user/prelude function) is intentionally NOT treated
/// as a primitive even if its type is `with Async`, except the four exact
/// compiler-owned stdin provider names imported from their public contract.
/// #2386: `is_async_primitive`'s answers for the walk in progress. The walk
/// hands every call site the same env (nothing in it extends `env`; locals go
/// through `afe_bind_*`), and the answer for a name is a full env miss for
/// every user callee -- a chain walk per call site. Each exported entry
/// clears it, so an entry with another env never reads a previous walk's
/// answer. Values: 1 = async primitive, 0 = not.
let afe_async_primitive_memo: Array[MutMap[String, Int]] = [
  MutMap::new_string()
]

export fn afe_reset_entry_memos() -> Unit {
  Array::set(afe_async_primitive_memo, 0, MutMap::new_string())
  Array::set(afe_builtin_async_iter_cell, 0, -1)
  Array::set(afe_callable_body_index, 0, MutMap::new_string())
}

export fn is_async_primitive(name: String, env: TypeEnv) -> Bool {
  let memo = Array::get(afe_async_primitive_memo, 0)
  match MutMap::get(memo, name) {
    Some(v) => v == 1,
    None => {
      let answer = is_async_primitive_uncached(name, env)
      MutMap::set(memo, name, if answer {
        1
      } else {
        0
      })
      answer
    }
  }
}

fn is_async_primitive_uncached(name: String, env: TypeEnv) -> Bool {
  if is_stdin_provider_surface(name) {
    // Imported package contracts bind these exact public names in env, but
    // they remain compiler-owned primitives after canonical import rewriting.
    // Do not let that binding suppress their Async authority requirement.
    match lookup_builtin(canonical_builtin_name(name)) {
      Some(ty) => match ty {
        CtFn(_, _, eff) => effect_opt_is_async(eff),
        _ => false
      },
      None => false
    }
  } else {
    match env_lookup(env, name) {
      Some(_) => false,
      None => {
        let normalized = canonical_builtin_name(name)
        match lookup_builtin(normalized) {
          Some(ty) => match ty {
            CtFn(_, _, eff) => effect_opt_is_async(eff),
            _ => false
          },
          None => false
        }
      }
    }
  }
}

fn afe_has_recorded_builtin_async_iter_import(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_builtin_async_iter_import_names) && !found {
    if Array::get(afe_builtin_async_iter_import_names, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Head name of an inferred checker type (`AsyncIter[Int]` -> "AsyncIter").
///
/// #1347/#1358 (Codex P1 on PR #1364): `CtEnum` counts too. An ENUM can
/// implement an async iterator trait, and an iterand reached through its
/// constructor (`Chan(3)`), a factory call, or an inferred local carries
/// `CtEnum` -- dropping it here lost the head name while the desugar still
/// resolved it from the constructor's return metadata and lowered the loop
/// through `Chan::next` with an injected `await`. Verified against a repro
/// that RAN the await loop.
fn afe_type_head_name(t: Type) -> Option[String] {
  match t {
    CtNamed(n, args) => if n == "#hkt" {
      if Array::length(args) >= 1 {
        match Array::get(args, 0) {
          CtVar(_) => None,
          other => afe_type_head_name(other)
        }
      } else {
        None
      }
    } else {
      Some(n)
    },
    CtStruct(n) => Some(n),
    CtEnum(n) => Some(n),
    CtConstructor(n, _) => Some(n),
    CtApplied(head, _) => afe_type_head_name(head),
    _ => None
  }
}

/// Head name of a source annotation (`s: AsyncIter[Int]` -> "AsyncIter").
fn afe_texpr_head_name(t: TypeExpr) -> Option[String] {
  match t {
    TyName(n) => Some(n),
    TyApp(n, _) => Some(n),
    _ => None
  }
}

fn afe_lookup_local(locals: AfeLocals, name: String) -> Option[String] {
  let mut cur = locals
  let mut found = None
  let mut go = true
  while go {
    match cur {
      AlNil => {
        go = false
      },
      AlBind(n, h, rest) => if n == name {
        found = Some(h)
        go = false
      } else {
        cur = rest
      },
      AlMask(n, rest) => if n == name {
        go = false
      } else {
        cur = rest
      }
    }
  }
  found
}

/// Whether `name` is bound by the walk's locals at all, with or without a
/// known head (#3163).
export fn afe_binds_local(locals: AfeLocals, name: String) -> Bool {
  let mut cur = locals
  let mut found = false
  let mut go = true
  while go {
    match cur {
      AlNil => {
        go = false
      },
      AlBind(n, _, rest) => if n == name {
        found = true
        go = false
      } else {
        cur = rest
      },
      AlMask(n, rest) => if n == name {
        found = true
        go = false
      } else {
        cur = rest
      }
    }
  }
  found
}

export fn afe_bind_local(locals: AfeLocals, name: String, head: Option[String]) -> AfeLocals {
  match head {
    Some(h) => AlBind(name, h, locals),
    None => AlMask(name, locals)
  }
}

export fn afe_bind_params(locals: AfeLocals, params: Array[(String, Option[TypeExpr])], env: TypeEnv) -> AfeLocals {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ptype) = Array::get(params, i)
    let name = effect_param_base_name(pname)
    let head = match ptype {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(h, afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    }
    cur = afe_bind_local(cur, name, head)
    cur = match ptype {
      Some(te) => afe_bind_annotation_payloads(cur, name, te, env),
      None => afe_clear_annotation_payloads(cur, name)
    }
    i = i + 1
  }
  cur
}

/// #3198 review: the heads an ANNOTATED aggregate's payloads carry, so a match
/// arm over that name can hand them to its binders. The lowering recovers the
/// same payloads from the annotation (`seed_var_types`,
/// `arm_binder_var_types_env`) and builds the awaiting loop from them, so a
/// binder this walk left headless -- `match o { Some(c) => for x in c { .. } }`
/// with `o: Option[Countdown]` -- was accepted in a row-free function while the
/// desugar inserted the builtin `await`.
///
/// Recorded: `Option[T]` (`Some`), `Result[T, E]` (`Ok`, `Err`) and a tuple
/// annotation (its shape, which `.0` / `.1` projections already read).
fn afe_bind_annotation_payloads(locals: AfeLocals, name: String, te: TypeExpr, env: TypeEnv) -> AfeLocals {
  let cleared = afe_clear_annotation_payloads(locals, name)
  match te {
    TyApp(head, args) => if head == "Option" && Array::length(args) == 1 {
      afe_bind_local(cleared, afe_ctor_payload_key(name, "Some"), Some(afe_payload_heads_csv(args, env)))
    } else if head == "Result" && Array::length(args) == 2 {
      let with_ok = afe_bind_local(cleared, afe_ctor_payload_key(name, "Ok"), Some(afe_payload_heads_csv([
        Array::get(args, 0)
      ], env)))
      afe_bind_local(with_ok, afe_ctor_payload_key(name, "Err"), Some(afe_payload_heads_csv([
        Array::get(args, 1)
      ], env)))
    } else {
      cleared
    },
    TyTuple(items) => if Array::length(items) > 0 {
      afe_bind_local(cleared, afe_tuple_shape_key(name), Some(afe_payload_heads_csv(items, env)))
    } else {
      cleared
    },
    _ => cleared
  }
}

/// A rebinding of `name` without an annotation hides the payload heads an
/// outer annotated binding of the same name recorded.
fn afe_clear_annotation_payloads(locals: AfeLocals, name: String) -> AfeLocals {
  let no_some = afe_bind_local(locals, afe_ctor_payload_key(name, "Some"), None)
  let no_ok = afe_bind_local(no_some, afe_ctor_payload_key(name, "Ok"), None)
  afe_bind_local(no_ok, afe_ctor_payload_key(name, "Err"), None)
}

fn afe_ctor_payload_key(name: String, ctor: String) -> String {
  String::concat("__ctorpay$", String::concat(ctor, String::concat("$", name)))
}

fn afe_payload_heads_csv(items: Array[TypeExpr], env: TypeEnv) -> String {
  let parts = array_empty()
  let mut i = 0
  while i < Array::length(items) {
    let part = match afe_texpr_head_name(Array::get(items, i)) {
      Some(h) => afe_tag_async_iter_head(h, afe_type_binding_is_builtin_async_iter(env)),
      None => ""
    }
    Array::push(parts, part)
    i = i + 1
  }
  afe_join_csv(parts)
}

/// The constructor name without its qualifier (`Option::Some` -> `Some`).
fn afe_bare_ctor(cn: String) -> String {
  let parts = String::split(cn, "::")
  Array::get(parts, Array::length(parts) - 1)
}

/// Bind the plain binders of `pats` to the heads in `csv`, position by
/// position. An empty head, or a non-binder pattern, is left as masked.
fn afe_bind_pats_to_heads(acc: AfeLocals, pats: Array[Pat], csv: String) -> AfeLocals {
  let heads = afe_split_csv(csv)
  let mut cur = acc
  let mut i = 0
  while i < Array::length(pats) && i < Array::length(heads) {
    let h = Array::get(heads, i)
    match Array::get(pats, i) {
      PBind(n) => if String::length(h) > 0 {
        cur = afe_bind_local(cur, n, Some(h))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  cur
}

/// Best-effort head type name of an expression used as a `for` iterand (or as a
/// `let` value feeding one).
/// #1341 (Codex P1 on #1369): struct FIELD type heads, `Holder.s ->
/// HostStream`. The async pass walks per-statement, so a whole-program table
/// cannot ride the walk's parameters; it lives in a module cell rebuilt at each
/// public entry, exactly like error_row_mode_cell / throw_kind_cell in this
/// file. Entries are keyed with a `.` that no vibe binding name can contain.
///
/// Needed because the desugar now routes `for b in h.s` over a host stream to
/// the parking read loop (build_host_stream_for). If this pass could not
/// classify the same projection, that loop would be legal in a row without
/// { Async } -- the precise hole #1358 exists to close, reopened one
/// expression shape over.
let afe_field_types_cell: Array[(String, String)] = array_empty()

fn afe_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

fn afe_field_head_with_origin(head: String, env: TypeEnv) -> String {
  if head == "AsyncIter" {
    let from_binding = afe_type_binding_is_builtin_async_iter(env)
    let from_definition = match env_type_definition_origin(env, head) {
      Some(origin) => afe_origin_is_builtin_async_iter(origin),
      None => false
    }
    afe_tag_async_iter_head(head, from_binding || from_definition)
  } else {
    head
  }
}

fn afe_record_field_type(struct_name: String, field: String, head: String, env: TypeEnv) -> Unit {
  if String::length(head) > 0 {
    Array::push(afe_field_types_cell, (afe_field_type_key(struct_name, field), afe_field_head_with_origin(head, env)))
  } else {
    ()
  }
}

fn afe_collect_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          afe_record_field_type(sname, fname, texpr_head_name_afe(fty), env)
          j = j + 1
        }
      },
      SModule(_, _, inner) => afe_collect_field_types(inner, env),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_collect_env_field_types(env: TypeEnv) -> Unit {
  let defs = env_type_defs(env)
  let mut i = 0
  while i < Array::length(defs) {
    match Array::get(defs, i) {
      TDStruct(sname, fields, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          match afe_type_head_name(fty) {
            Some(head) => afe_record_field_type(sname, fname, head, env),
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn texpr_head_name_afe(t: TypeExpr) -> String {
  match t {
    TyName(n) => n,
    TyApp(n, _) => n,
    _ => ""
  }
}

export fn afe_set_field_types(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  Array::truncate(afe_field_types_cell, 0)
  afe_collect_field_types(stmts, env)
  afe_collect_env_field_types(env)
}

fn afe_lookup_field_type(struct_name: String, field: String) -> Option[String] {
  let key = afe_field_type_key(struct_name, field)
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_field_types_cell) {
    let (k, v) = Array::get(afe_field_types_cell, i)
    if k == key {
      out = Some(v)
      i = Array::length(afe_field_types_cell)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_applied_constructor_var(t: Type) -> Option[Int] {
  match t {
    CtApplied(CtVar(id), _) => Some(id),
    CtNamed(n, args) => if n == "#hkt" && Array::length(args) >= 1 {
      match Array::get(args, 0) {
        CtVar(id) => Some(id),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn afe_lookup_alias(env: TypeEnv, name: String) -> Option[(Array[String], Type)] {
  match find_typedef(env_type_defs(env), name) {
    Some(TDAlias(_, params, body)) => Some((params, body)),
    _ => None
  }
}

fn afe_expand_constructor_alias(t: Type, env: TypeEnv, fuel: Int) -> Type {
  if fuel <= 0 {
    t
  } else {
    match t {
      CtForAll(ids, bounds, body) => CtForAll(ids, bounds, afe_expand_constructor_alias(body, env, fuel)),
      CtNamed(name, args) => match afe_lookup_alias(env, name) {
        Some((params, body)) => if Array::length(params) == Array::length(args) {
          afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
        } else if Array::length(params) == 0 {
          afe_expand_constructor_alias(body, env, fuel - 1)
        } else {
          t
        },
        None => t
      },
      CtApplied(head, args) => {
        let expanded_head = afe_expand_constructor_alias(head, env, fuel - 1)
        match expanded_head {
          CtNamed(name, _) => match afe_lookup_alias(env, name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          CtConstructor(name, _) => match afe_lookup_alias(env, name) {
            Some((params, body)) => if Array::length(params) == Array::length(args) {
              afe_expand_constructor_alias(resolve_type_alias_params(body, params, args), env, fuel - 1)
            } else {
              CtApplied(expanded_head, args)
            },
            None => CtApplied(expanded_head, args)
          },
          _ => CtApplied(expanded_head, args)
        }
      },
      _ => t
    }
  }
}

/// #2386: the `AsyncIter` provenance answer for the walk in progress
/// (-1 = not asked yet, else 0 / 1); the env is constant across a walk and
/// this was asked once per binding and per call head. Cleared per entry with
/// the memo above.
let afe_builtin_async_iter_cell: Array[Int] = [-1]

export fn afe_type_binding_is_builtin_async_iter(env: TypeEnv) -> Bool {
  let cached = Array::get(afe_builtin_async_iter_cell, 0)
  if cached >= 0 {
    cached == 1
  } else {
    let answer = match env_lookup_binding(env, "AsyncIter") {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
    Array::set(afe_builtin_async_iter_cell, 0, if answer {
      1
    } else {
      0
    })
    answer
  }
}

fn afe_tag_async_iter_head(head: String, provenanced: Bool) -> String {
  if head == "AsyncIter" && provenanced {
    afe_builtin_async_iter_head
  } else if head == afe_builtin_async_iter_head {
    afe_builtin_async_iter_head
  } else {
    head
  }
}

export fn afe_display_iter_head(head: String) -> String {
  if head == afe_builtin_async_iter_head {
    "AsyncIter"
  } else {
    head
  }
}

fn afe_tuple_shape_key(name: String) -> String {
  String::concat("__tupshape$", name)
}

fn afe_array_elem_key(name: String) -> String {
  String::concat("__arrelem$", name)
}

fn afe_local_fn_return_key(name: String) -> String {
  String::concat("__local_fn_return$", name)
}

fn afe_digit_index(field: String) -> Option[Int] {
  let n = String::length(field)
  if n == 0 {
    None
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while i < n {
      let c = String::char_code_at(field, i)
      if c >= 48 && c <= 57 {
        acc = acc * 10 + (c - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(acc)
    } else {
      None
    }
  }
}

fn afe_split_csv(sentinel: String) -> Array[String] {
  let out = array_empty()
  let mut rest = sentinel
  let mut go = true
  while go {
    let comma = String::index_of(rest, ",")
    if comma < 0 {
      Array::push(out, rest)
      go = false
    } else {
      Array::push(out, String::substring(rest, 0, comma))
      rest = String::substring(rest, comma + 1, String::length(rest))
    }
  }
  out
}

fn afe_join_csv(parts: Array[String]) -> String {
  let mut acc = ""
  let mut i = 0
  while i < Array::length(parts) {
    acc = if i == 0 {
      Array::get(parts, i)
    } else {
      String::concat(acc, String::concat(",", Array::get(parts, i)))
    }
    i = i + 1
  }
  acc
}

fn afe_prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// Recover the concrete head returned by a constructor-polymorphic call such
/// as `map[F[_]](xs: F[A], ...) -> F[B]`. The checker type keeps the same
/// constructor variable on the receiver and result, so follow that receiver
/// back to its source expression instead of treating the abstract `F[B]` as
/// an unknown head.
fn afe_call_result_head(callee_type: Type, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match callee_type {
    CtForAll(_, _, body) => afe_call_result_head(body, args, env, locals),
    CtFn(params, ret, _) => {
      let expanded = afe_expand_constructor_alias(ret, env, 8)
      match afe_type_head_name(expanded) {
        Some(head) => Some(head),
        None => match afe_applied_constructor_var(expanded) {
          Some(result_var) => {
            let mut i = 0
            let mut result = None
            while i < Array::length(params) && i < Array::length(args) {
              match afe_applied_constructor_var(Array::get(params, i)) {
                Some(param_var) => {
                  let same_constructor = param_var == result_var
                  if same_constructor {
                    match afe_expr_head_name(Array::get(args, i), env, locals) {
                      Some(head) => {
                        result = Some(head)
                        i = Array::length(params)
                      },
                      None => {
                        i = i + 1
                      }
                    }
                  } else {
                    i = i + 1
                  }
                },
                None => {
                  i = i + 1
                }
              }
            }
            result
          },
          None => None
        }
      }
    },
    _ => None
  }
}

fn afe_callee_is_builtin_async_iter(env: TypeEnv, name: String) -> Bool {
  if afe_has_recorded_builtin_async_iter_import(name) {
    true
  } else {
    match env_lookup_binding(env, name) {
      Some(binding) => afe_origin_is_builtin_async_iter(binding.origin),
      None => false
    }
  }
}

fn afe_finish_call_head(head: String, env: TypeEnv, callee: String) -> String {
  if head == afe_builtin_async_iter_head {
    head
  } else {
    afe_tag_async_iter_head(head, afe_callee_is_builtin_async_iter(env, callee) || afe_type_binding_is_builtin_async_iter(env))
  }
}

fn afe_heads_agree(left: Option[String], right: Option[String]) -> Option[String] {
  match left {
    Some(name) => match right {
      Some(other) => {
        let same = name == other
        if same {
          Some(name)
        } else {
          None
        }
      },
      None => None
    },
    None => None
  }
}

fn afe_bind_shapes(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  afe_bind_shapes_from(locals, locals, name, val, env)
}

/// `afe_bind_shapes` with the scope `val` is read in (`outer`) kept apart from
/// the one the shapes are added to (`acc`).
fn afe_bind_shapes_from(acc: AfeLocals, outer: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let locals = outer
  let without = afe_bind_local(afe_bind_local(acc, afe_tuple_shape_key(name), None), afe_array_elem_key(name), None)
  match val {
    ETuple(items) => if Array::length(items) > 0 {
      let parts = array_empty()
      let mut i = 0
      while i < Array::length(items) {
        let part = match afe_expr_head_name(Array::get(items, i), env, locals) {
          Some(h) => h,
          None => ""
        }
        Array::push(parts, part)
        i = i + 1
      }
      afe_bind_local(without, afe_tuple_shape_key(name), Some(afe_join_csv(parts)))
    } else {
      without
    },
    EArray(items) => if Array::length(items) > 0 {
      afe_bind_local(without, afe_array_elem_key(name), afe_expr_head_name(Array::get(items, 0), env, locals))
    } else {
      without
    },
    _ => without
  }
}

fn afe_fn_return_head(val: Expr, env: TypeEnv) -> Option[String] {
  match val {
    EFn(_, _, _, ret, _, _) => match ret {
      Some(te) => match afe_texpr_head_name(te) {
        Some(h) => Some(afe_tag_async_iter_head(h, afe_type_binding_is_builtin_async_iter(env))),
        None => None
      },
      None => None
    },
    _ => None
  }
}

fn afe_bind_local_fn_return(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  afe_bind_local(locals, afe_local_fn_return_key(name), afe_fn_return_head(val, env))
}

export fn afe_bind_value(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let with_head = afe_bind_local(locals, name, afe_expr_head_name(val, env, locals))
  let with_fn = afe_bind_local_fn_return(with_head, name, val, env)
  afe_bind_value_payloads(afe_bind_shapes(with_fn, name, val, env), name, val, env)
}

/// #3198 review: an annotated `let` (the parser's `((__asc: T) -> __asc)(v)`)
/// records its payload heads like an annotated parameter; any other `let`
/// hides the ones an outer binding of the same name recorded.
fn afe_bind_value_payloads(locals: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  match afe_ascribed_type(val) {
    Some(te) => afe_bind_annotation_payloads(locals, name, te, env),
    None => afe_clear_annotation_payloads(locals, name)
  }
}

fn afe_ascribed_type(val: Expr) -> Option[TypeExpr] {
  match val {
    ECall(EFn(_, _, params, _, _, EIdent(bname, _)), args, _, _) => if Array::length(params) == 1 && Array::length(args) == 1 {
      let (pname, pty) = Array::get(params, 0)
      if pname == "__asc" && bname == "__asc" {
        pty
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// The evidence planner carries a local row annotation through a named
/// function value (including a chain of immutable aliases). A conditional or
/// other computed value still has no corresponding evidence binding.
export fn afe_ascribed_name_type(val: Expr) -> Option[TypeExpr] {
  match val {
    ECall(_, args, _, _) => if Array::length(args) == 1 {
      match Array::get(args, 0) {
        EIdent(_, _) => afe_ascribed_type(val),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3198 review: `afe_bind_value` with the scope `val` is read in (`outer`)
/// kept apart from the one `name` is added to (`acc`). A `loop` state's
/// initial value is read in the enclosing scope while its name joins the
/// body's, so `loop (it = it) { for x in it { .. } }` keeps the async
/// iterator head the outer `it` carries.
export fn afe_bind_value_from(acc: AfeLocals, outer: AfeLocals, name: String, val: Expr, env: TypeEnv) -> AfeLocals {
  let with_head = afe_bind_local(acc, name, afe_expr_head_name(val, env, outer))
  let with_fn = afe_bind_local_fn_return(with_head, name, val, env)
  afe_bind_value_payloads(afe_bind_shapes_from(with_fn, outer, name, val, env), name, val, env)
}

/// The scope a match arm's body is read in. #3177: every pattern binder masks
/// the outer scope, and the binders whose head the scrutinee reveals carry it.
export fn afe_match_arm_locals(scrut: Expr, pat: Pat, env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  afe_match_arm_locals_onto(scrut, pat, env, locals, afe_mask_pat_binders(locals, pat))
}

/// `afe_match_arm_locals` with the scope the scrutinee is read in (`outer`)
/// kept apart from the one the binders are added to (`acc`), so a binder can
/// shadow the very name its scrutinee reads (`match it { Some(it) => .. }`).
fn afe_match_arm_locals_onto(scrut: Expr, pat: Pat, env: TypeEnv, outer: AfeLocals, acc: AfeLocals) -> AfeLocals {
  match pat {
    PBind(name) => afe_bind_local(acc, name, afe_expr_head_name(scrut, env, outer)),
    PCtor(cn, sub) => match scrut {
      ECall(EIdent(name, _), args, _, _) => if name == cn || String::ends_with(name, String::concat("::", cn)) {
        let mut cur = acc
        let mut i = 0
        while i < Array::length(sub) && i < Array::length(args) {
          cur = afe_match_arm_locals_onto(Array::get(args, i), Array::get(sub, i), env, outer, cur)
          i = i + 1
        }
        cur
      } else {
        acc
      },
      // #3198 review: a NAME whose annotation recorded this constructor's
      // payload heads (`o: Option[Countdown]`, `Some(c)`).
      EIdent(sname, _) => match afe_lookup_local(outer, afe_ctor_payload_key(sname, afe_bare_ctor(cn))) {
        Some(csv) => afe_bind_pats_to_heads(acc, sub, csv),
        None => acc
      },
      _ => acc
    },
    PTuple(items) => match scrut {
      ETuple(vals) => {
        let mut cur = acc
        let mut i = 0
        while i < Array::length(items) && i < Array::length(vals) {
          cur = afe_match_arm_locals_onto(Array::get(vals, i), Array::get(items, i), env, outer, cur)
          i = i + 1
        }
        cur
      },
      EIdent(sname, _) => match afe_lookup_local(outer, afe_tuple_shape_key(sname)) {
        Some(csv) => afe_bind_pats_to_heads(acc, items, csv),
        None => acc
      },
      _ => acc
    },
    _ => acc
  }
}

/// #3177: every name `pat` binds, as a binding of no known head, so it hides
/// an outer binding of the same name. A match or handler arm binds its
/// pattern's names whether or not their heads can be resolved -- a name the
/// walk does not see bound reads the OUTER binding (or the builtin: a
/// match-bound `await` called in a row-free lambda demanded `Async`).
export fn afe_mask_pat_binders(locals: AfeLocals, pat: Pat) -> AfeLocals {
  match pat {
    PBind(name) => afe_clear_annotation_payloads(afe_bind_local(afe_bind_local(locals, afe_tuple_shape_key(name), None), name, None), name),
    PCtor(_, sub) => afe_mask_pats_binders(locals, sub),
    PTuple(items) => afe_mask_pats_binders(locals, items),
    POr(a, b) => afe_mask_pat_binders(afe_mask_pat_binders(locals, a), b),
    PStruct(_, fields) => {
      let mut cur = locals
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        cur = afe_mask_pat_binders(cur, fp)
        i = i + 1
      }
      cur
    },
    _ => locals
  }
}

fn afe_mask_pats_binders(locals: AfeLocals, pats: Array[Pat]) -> AfeLocals {
  let mut cur = locals
  let mut i = 0
  while i < Array::length(pats) {
    cur = afe_mask_pat_binders(cur, Array::get(pats, i))
    i = i + 1
  }
  cur
}

fn afe_tuple_elem_head(obj: Expr, field: String, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_digit_index(field) {
    None => None,
    Some(idx) => match obj {
      ETuple(items) => if idx >= 0 && idx < Array::length(items) {
        afe_expr_head_name(Array::get(items, idx), env, locals)
      } else {
        None
      },
      EIdent(name, _) => match afe_lookup_local(locals, afe_tuple_shape_key(name)) {
        Some(sentinel) => {
          let parts = afe_split_csv(sentinel)
          if idx >= 0 && idx < Array::length(parts) {
            let elem = Array::get(parts, idx)
            if String::length(elem) > 0 {
              Some(elem)
            } else {
              None
            }
          } else {
            None
          }
        },
        None => None
      },
      _ => None
    }
  }
}

fn afe_array_elem_head(args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if Array::length(args) == 2 {
    match Array::get(args, 0) {
      EIdent(arrname, _) => afe_lookup_local(locals, afe_array_elem_key(arrname)),
      EArray(items) => if Array::length(items) > 0 {
        afe_expr_head_name(Array::get(items, 0), env, locals)
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

/// #3179: `f_off` is the callee identifier's offset. The element-type
/// shortcut reads the builtin `Array::get` / index sugar, so it answers only
/// for a call the checker types as that builtin (`builtin_call_arm`); a
/// program's own function of either spelling is read from its declaration.
fn afe_ident_call_head(f: String, f_off: Int, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if (f == "Array::get" || f == "__index") && builtin_call_arm(env, f, Array::length(args), f_off) != "" {
    match afe_array_elem_head(args, env, locals) {
      Some(head) => Some(head),
      None => afe_ident_call_head_generic(f, args, env, locals)
    }
  } else {
    afe_ident_call_head_generic(f, args, env, locals)
  }
}

fn afe_ident_call_head_generic(f: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_lookup_local(locals, afe_local_fn_return_key(f)) {
    Some(head) => Some(head),
    None => afe_ident_call_head_env(f, args, env, locals)
  }
}

fn afe_ident_call_head_env(f: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match env_lookup(env, f) {
    Some(callee_type) => match afe_call_result_head(callee_type, args, env, locals) {
      Some(head) => Some(afe_finish_call_head(head, env, f)),
      None => match env_lookup_binding(env, f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => None
      }
    },
    _ => match lookup_builtin(f) {
      Some(callee_type) => match afe_call_result_head(callee_type, args, env, locals) {
        Some(head) => Some(afe_finish_call_head(head, env, f)),
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      },
      _ => match env_lookup_binding(env, f) {
        Some(binding) => if afe_origin_is_builtin_async_iter(binding.origin) || afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        },
        None => if afe_has_recorded_builtin_async_iter_import(f) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    }
  }
}

fn afe_dot_call_head(obj: Expr, method: String, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_expr_head_name(obj, env, locals) {
    Some(receiver) => {
      let display = afe_display_iter_head(receiver)
      let qualified = String::concat(display, String::concat("::", method))
      let call_args = afe_prepend_expr(obj, args)
      match afe_ident_call_head(qualified, 0 - 1, call_args, env, locals) {
        Some(head) => Some(head),
        None => if receiver == afe_builtin_async_iter_head && afe_is_async_iter_publication_name(qualified) {
          Some(afe_builtin_async_iter_head)
        } else {
          None
        }
      }
    },
    None => None
  }
}

fn afe_iife_head(params: Array[(String, Option[TypeExpr])], body: Expr, args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let mut body_locals = afe_bind_params(locals, params, env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(Array::get(args, i), env, locals)
    } else {
      None
    }
    body_locals = afe_bind_local(body_locals, name, inferred)
    i = i + 1
  }
  afe_expr_head_name(body, env, body_locals)
}

fn afe_handler_arm_head(arm_body: Expr, expected: String, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match arm_body {
    ECall(EIdent("resume", _), resume_args, _, _) => if Array::length(resume_args) == 1 {
      Some(expected)
    } else {
      None
    },
    ELet(name, val, body, _) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    ELetMut(name, val, body, _) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    ELetRec(name, val, body) => afe_handler_arm_head(body, expected, env, afe_bind_value(locals, name, val, env)),
    EReturn(inner) => afe_handler_arm_head(inner, expected, env, locals),
    EAssign(_, _, continuation, _) => afe_handler_arm_head(continuation, expected, env, locals),
    EAssignOp(_, _, _, continuation, _) => afe_handler_arm_head(continuation, expected, env, locals),
    ESeq(_, result) => afe_handler_arm_head(result, expected, env, locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(afe_handler_arm_head(then_branch, expected, env, locals), afe_handler_arm_head(else_branch, expected, env, locals)),
    _ => afe_expr_head_name(arm_body, env, locals)
  }
}

fn afe_op_name_matches(name: String, op: String) -> Bool {
  name == op || String::ends_with(name, String::concat("::", op)) || String::ends_with(op, String::concat("::", name))
}

fn afe_handler_consumes_op(arms: Array[(Pat, Expr)], op: String) -> Bool {
  let mut i = 0
  let mut consumes = false
  while i < Array::length(arms) && !consumes {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if afe_op_name_matches(name, op) {
        consumes = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  consumes
}

export let afe_callable_bodies: Array[(String, Array[(String, Option[TypeExpr])], Option[String], Expr)] = array_empty()
// One-based row IDs preserve the body's authoritative ordered storage;
// zero means ambiguous, including repeated copies of the same body. Every
// checker entry resets this index before collecting its own callable rows.
let afe_callable_body_index: Array[MutMap[String, Int]] = [MutMap::new_string()]
export let afe_payload_call_stack: Array[String] = array_empty()
export let afe_reachability_keys: Array[String] = array_empty()
export let afe_reachability_values: Array[Bool] = array_empty()
export let afe_reachability_stack: Array[String] = array_empty()

fn afe_add_callable_body(name: String, params: Array[(String, Option[TypeExpr])], effect: Option[String], body: Expr) -> Unit {
  Array::push(afe_callable_bodies, (name, params, effect, body))
  let index = Array::get(afe_callable_body_index, 0)
  let row = match MutMap::get(index, name) {
    Some(_) => 0,
    None => Array::length(afe_callable_bodies)
  }
  MutMap::set(index, name, row)
}

export fn afe_collect_callable_bodies(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, params, _, effect, body)) => {
        afe_add_callable_body(name, params, effect, body)
      },
      SFnDecl(_, name, EFn(_, _, params, _, effect, body), _, _) => {
        afe_add_callable_body(name, params, effect, body)
      },
      SModule(_, _, body) => afe_collect_callable_bodies(body),
      _ => ()
    }
    i = i + 1
  }
}

fn afe_lookup_callable_body(name: String) -> Option[(Array[(String, Option[TypeExpr])], Option[String], Expr)] {
  match MutMap::get(Array::get(afe_callable_body_index, 0), name) {
    Some(row) => if row > 0 {
      let (_, params, effect, body) = Array::get(afe_callable_bodies, row - 1)
      Some((params, effect, body))
    } else {
      None
    },
    None => None
  }
}

fn afe_payload_call_is_active(name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_payload_call_stack) && !found {
    found = Array::get(afe_payload_call_stack, i) == name
    i = i + 1
  }
  found
}

fn afe_callable_may_perform(effect: Option[String], op: String) -> Bool {
  match effect_row_parse(effect) {
    Some(labels) => decl_authorizes_op(labels, op),
    None => false
  }
}

fn afe_reachability_key(name: String, op: String) -> String {
  String::concat(name, String::concat("\t", op))
}

fn afe_reachability_cache_get(key: String) -> Option[Bool] {
  let mut i = 0
  let mut out = None
  while i < Array::length(afe_reachability_keys) {
    if Array::get(afe_reachability_keys, i) == key {
      out = Some(Array::get(afe_reachability_values, i))
      i = Array::length(afe_reachability_keys)
    } else {
      i = i + 1
    }
  }
  out
}

fn afe_reachability_is_active(key: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(afe_reachability_stack) && !found {
    found = Array::get(afe_reachability_stack, i) == key
    i = i + 1
  }
  found
}

fn afe_expr_may_perform(expr: Expr, op: String) -> Bool {
  match expr {
    EHandle(body, arms) => {
      let mut found = if afe_handler_consumes_op(arms, op) {
        false
      } else {
        afe_expr_may_perform(body, op)
      }
      let mut i = 0
      while i < Array::length(arms) && !found {
        let (_, arm_body) = Array::get(arms, i)
        found = afe_expr_may_perform(arm_body, op)
        i = i + 1
      }
      found
    },
    EFn(_, _, _, _, _, _) => false,
    ECall(callee, args, _, _) => {
      let mut found = match callee {
        EIdent("perform", _) => if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(EIdent(op_name, _), _, _, _) => afe_op_name_matches(op_name, op),
            _ => false
          }
        } else {
          false
        },
        EFn(_, _, _, _, _, body) => afe_expr_may_perform(body, op),
        EIdent(name, _) => afe_callable_reaches_op(name, op),
        _ => false
      }
      let mut i = 0
      while i < Array::length(args) && !found {
        found = afe_expr_may_perform(Array::get(args, i), op)
        i = i + 1
      }
      found
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      let mut found = false
      while i < Array::length(children) && !found {
        found = afe_expr_may_perform(Array::get(children, i), op)
        i = i + 1
      }
      found
    }
  }
}

fn afe_callable_reaches_op(name: String, op: String) -> Bool {
  let key = afe_reachability_key(name, op)
  match afe_reachability_cache_get(key) {
    Some(value) => value,
    None => if afe_reachability_is_active(key) {
      false
    } else match afe_lookup_callable_body(name) {
      Some((_, effect, body)) => {
        let stack_len = Array::length(afe_reachability_stack)
        Array::push(afe_reachability_stack, key)
        let result = afe_callable_may_perform(effect, op) && afe_expr_may_perform(body, op)
        Array::truncate(afe_reachability_stack, stack_len)
        if result {
          Array::push(afe_reachability_keys, key)
          Array::push(afe_reachability_values, true)
        } else {
          ()
        }
        result
      },
      None => false
    }
  }
}

fn afe_callable_body_locals(params: Array[(String, Option[TypeExpr])], args: Array[Expr], env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  let mut body_locals = afe_bind_params(locals, params, env)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    let inferred = if i < Array::length(args) {
      afe_expr_head_name(Array::get(args, i), env, locals)
    } else {
      None
    }
    body_locals = afe_bind_local(body_locals, name, inferred)
    i = i + 1
  }
  body_locals
}

fn afe_collect_perform_payloads(expr: Expr, op: String, payload_index: Int, env: TypeEnv, locals: AfeLocals, out: Array[Option[String]]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      if !afe_handler_consumes_op(arms, op) {
        afe_collect_perform_payloads(body, op, payload_index, env, locals, out)
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_locals = afe_handler_arm_locals(body, pat, env, locals)
        afe_collect_perform_payloads(arm_body, op, payload_index, env, arm_locals, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, _) => (),
    ELet(name, val, body, _) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ELetMut(name, val, body, _) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals, name, val, env)
      afe_collect_perform_payloads(val, op, payload_index, env, rec_locals, out)
      afe_collect_perform_payloads(body, op, payload_index, env, rec_locals, out)
    },
    EAssign(name, val, continuation, _) => {
      afe_collect_perform_payloads(val, op, payload_index, env, locals, out)
      afe_collect_perform_payloads(continuation, op, payload_index, env, afe_bind_value(locals, name, val, env), out)
    },
    ECall(callee, args, _, _) => {
      match callee {
        EIdent(name, _) => if name == "perform" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(EIdent(op_name, _), oargs, _, _) => if afe_op_name_matches(op_name, op) && payload_index >= 0 && payload_index < Array::length(oargs) {
              Array::push(out, afe_expr_head_name(Array::get(oargs, payload_index), env, locals))
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      match callee {
        EFn(_, _, params, _, _, body) => {
          let body_locals = afe_callable_body_locals(params, args, env, locals)
          afe_collect_perform_payloads(body, op, payload_index, env, body_locals, out)
        },
        EIdent(name, _) => if name == "perform" || afe_payload_call_is_active(name) {
          ()
        } else match afe_lookup_callable_body(name) {
          Some((params, effect, body)) => if afe_callable_may_perform(effect, op) && afe_callable_reaches_op(name, op) {
            let stack_len = Array::length(afe_payload_call_stack)
            Array::push(afe_payload_call_stack, name)
            let body_locals = afe_callable_body_locals(params, args, env, locals)
            afe_collect_perform_payloads(body, op, payload_index, env, body_locals, out)
            Array::truncate(afe_payload_call_stack, stack_len)
          } else {
            ()
          },
          None => ()
        },
        _ => ()
      }
      let mut i = 0
      while i < Array::length(args) {
        afe_collect_perform_payloads(Array::get(args, i), op, payload_index, env, locals, out)
        i = i + 1
      }
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      while i < Array::length(children) {
        afe_collect_perform_payloads(Array::get(children, i), op, payload_index, env, locals, out)
        i = i + 1
      }
    }
  }
}

fn afe_perform_payload_head(body: Expr, op: String, payload_index: Int, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let payloads = array_empty()
  afe_collect_perform_payloads(body, op, payload_index, env, locals, payloads)
  if Array::length(payloads) == 0 {
    None
  } else {
    let mut i = 1
    let mut result = Array::get(payloads, 0)
    while i < Array::length(payloads) {
      match result {
        Some(expected) => match Array::get(payloads, i) {
          Some(actual) => if actual != expected {
            result = None
          } else {
            ()
          },
          None => {
            result = None
          }
        },
        None => {
          i = Array::length(payloads)
        }
      }
      i = i + 1
    }
    result
  }
}

/// The scope a handler arm's body is read in: every pattern binder masks the
/// outer scope (#3177), and an operation argument bound by name carries the
/// head of what the body performs in that position.
export fn afe_handler_arm_locals(body: Expr, pat: Pat, env: TypeEnv, locals: AfeLocals) -> AfeLocals {
  match pat {
    PCtor(cn, sub) => {
      let mut arm_locals = afe_mask_pat_binders(locals, pat)
      let mut i = 0
      while i < Array::length(sub) {
        match Array::get(sub, i) {
          PBind(name) => {
            arm_locals = afe_bind_local(arm_locals, name, afe_perform_payload_head(body, cn, i, env, locals))
          },
          _ => ()
        }
        i = i + 1
      }
      arm_locals
    },
    _ => afe_mask_pat_binders(locals, pat)
  }
}

fn afe_handle_head(body: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match afe_expr_head_name(body, env, locals) {
    None => None,
    Some(expected) => {
      let mut i = 0
      let mut agrees = true
      while i < Array::length(arms) && agrees {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_locals = afe_handler_arm_locals(body, pat, env, locals)
        match afe_handler_arm_head(arm_body, expected, env, arm_locals) {
          Some(actual) => {
            let same = actual == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            agrees = false
          }
        }
        i = i + 1
      }
      if agrees {
        Some(expected)
      } else {
        None
      }
    }
  }
}

fn afe_match_head(scrut: Expr, arms: Array[(Pat, Expr)], env: TypeEnv, locals: AfeLocals) -> Option[String] {
  if Array::length(arms) == 0 {
    None
  } else {
    let mut i = 0
    let mut result = None
    let mut agrees = true
    while i < Array::length(arms) && agrees {
      let (pat, body) = Array::get(arms, i)
      let arm_locals = afe_match_arm_locals(scrut, pat, env, locals)
      match afe_expr_head_name(body, env, arm_locals) {
        Some(head) => match result {
          Some(expected) => {
            let same = head == expected
            if !same {
              agrees = false
            } else {
              ()
            }
          },
          None => {
            result = Some(head)
          }
        },
        None => {
          agrees = false
        }
      }
      i = i + 1
    }
    if agrees {
      result
    } else {
      None
    }
  }
}

fn afe_collect_loop_head(expr: Expr, env: TypeEnv, locals: AfeLocals, expected: Array[String], valid: Array[Bool]) -> Unit {
  if !Array::get(valid, 0) {
    ()
  } else {
    match expr {
      EAssign("__loop_result", value, continuation, _) => {
        match afe_expr_head_name(value, env, locals) {
          Some(actual) => if Array::length(expected) == 0 {
            Array::push(expected, actual)
          } else if Array::get(expected, 0) != actual {
            Array::set(valid, 0, false)
          } else {
            ()
          },
          None => Array::set(valid, 0, false)
        }
        afe_collect_loop_head(continuation, env, locals, expected, valid)
      },
      EBreak(Some(value)) => match afe_expr_head_name(value, env, locals) {
        Some(actual) => if Array::length(expected) == 0 {
          Array::push(expected, actual)
        } else if Array::get(expected, 0) != actual {
          Array::set(valid, 0, false)
        } else {
          ()
        },
        None => Array::set(valid, 0, false)
      },
      ELetMut("__loop_result", _, _, _) => (),
      ELoop(_, _) => (),
      EWhile(_, _) => (),
      EForIn(_, _, _, _) => (),
      EFn(_, _, _, _, _, _) => (),
      ELet(name, value, body, _) => {
        afe_collect_loop_head(value, env, locals, expected, valid)
        afe_collect_loop_head(body, env, afe_bind_value(locals, name, value, env), expected, valid)
      },
      ELetMut(name, value, body, _) => {
        afe_collect_loop_head(value, env, locals, expected, valid)
        afe_collect_loop_head(body, env, afe_bind_value(locals, name, value, env), expected, valid)
      },
      EMatch(scrut, arms) => {
        afe_collect_loop_head(scrut, env, locals, expected, valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (pat, body) = Array::get(arms, i)
          afe_collect_loop_head(body, env, afe_match_arm_locals(scrut, pat, env, locals), expected, valid)
          i = i + 1
        }
      },
      EHandle(body, arms) => {
        afe_collect_loop_head(body, env, locals, expected, valid)
        let mut i = 0
        while i < Array::length(arms) && Array::get(valid, 0) {
          let (_, arm_body) = Array::get(arms, i)
          afe_collect_loop_head(arm_body, env, locals, expected, valid)
          i = i + 1
        }
      },
      _ => {
        let children = expr_children(expr)
        let mut i = 0
        while i < Array::length(children) && Array::get(valid, 0) {
          afe_collect_loop_head(Array::get(children, i), env, locals, expected, valid)
          i = i + 1
        }
      }
    }
  }
}

fn afe_parameterized_loop_head(body: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match body {
    ESeq(EWhile(_, loop_body), EIdent("__loop_result", _)) => {
      let expected = array_empty()
      let valid = [true]
      afe_collect_loop_head(loop_body, env, locals, expected, valid)
      if Array::get(valid, 0) && Array::length(expected) == 1 {
        Some(Array::get(expected, 0))
      } else {
        None
      }
    },
    _ => None
  }
}

fn afe_loop_head(inits: Array[(String, Expr)], body: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  let mut body_locals = locals
  let mut i = 0
  while i < Array::length(inits) {
    let (name, val) = Array::get(inits, i)
    body_locals = afe_bind_value(body_locals, name, val, env)
    i = i + 1
  }
  let expected = array_empty()
  let valid = [true]
  afe_collect_loop_head(body, env, body_locals, expected, valid)
  if Array::get(valid, 0) && Array::length(expected) == 1 {
    Some(Array::get(expected, 0))
  } else {
    None
  }
}

export fn afe_expr_head_name(e: Expr, env: TypeEnv, locals: AfeLocals) -> Option[String] {
  match e {
    EIdent(n, _) => match afe_lookup_local(locals, n) {
      Some(h) => Some(h),
      None => match env_lookup(env, n) {
        Some(t) => match afe_type_head_name(t) {
          Some(head) => Some(afe_tag_async_iter_head(head, afe_callee_is_builtin_async_iter(env, n) || afe_type_binding_is_builtin_async_iter(env))),
          None => None
        },
        None => None
      }
    },
    ERecord(n, _, _) => if String::length(n) > 0 {
      Some(afe_tag_async_iter_head(n, afe_type_binding_is_builtin_async_iter(env)))
    } else {
      None
    },
    EDot(obj, field, _, _) => match afe_tuple_elem_head(obj, field, env, locals) {
      Some(head) => Some(head),
      None => match afe_expr_head_name(obj, env, locals) {
        Some(otype) => afe_lookup_field_type(afe_display_iter_head(otype), field),
        None => None
      }
    },
    ECall(callee, args, _, _) => match callee {
      EIdent(f, f_off) => afe_ident_call_head(f, f_off, args, env, locals),
      EDot(obj, method, _, _) => afe_dot_call_head(obj, method, args, env, locals),
      EFn(_, _, params, _, _, body) => afe_iife_head(params, body, args, env, locals),
      _ => None
    },
    ELet(name, val, body, _) => afe_expr_head_name(body, env, afe_bind_value(locals, name, val, env)),
    ELetMut(name, val, body, _) => if name == "__loop_result" {
      afe_parameterized_loop_head(body, env, locals)
    } else {
      afe_expr_head_name(body, env, afe_bind_value(locals, name, val, env))
    },
    ELetRec(name, val, body) => {
      let rec_locals = afe_bind_value(locals, name, val, env)
      afe_expr_head_name(body, env, rec_locals)
    },
    EReturn(inner) => afe_expr_head_name(inner, env, locals),
    EAssign(_, _, continuation, _) => afe_expr_head_name(continuation, env, locals),
    EAssignOp(_, _, _, continuation, _) => afe_expr_head_name(continuation, env, locals),
    ESeq(_, result) => afe_expr_head_name(result, env, locals),
    EIf(_, then_branch, else_branch) => afe_heads_agree(afe_expr_head_name(then_branch, env, locals), afe_expr_head_name(else_branch, env, locals)),
    EMatch(scrut, arms) => afe_match_head(scrut, arms, env, locals),
    EHandle(body, arms) => afe_handle_head(body, arms, env, locals),
    ELoop(inits, body) => afe_loop_head(inits, body, env, locals),
    _ => None
  }
}
