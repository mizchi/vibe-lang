//# Types

export enum EffectError {
  EEEffectfulCallOutsideEffect(String);
  EEPerformUndeclaredEffect(String, String);
  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a
  // set difference plus a fix-it hint for the `with` row annotation.
  // Fields (all pre-rendered ", "-joined label lists, deterministic order):
  // (enclosing fn name or "" when unnamed, missing labels (sorted),
  //  declared row (source order, "" when no row), required row (sorted union)).
  // #1514: the 5th field is the CALL SITE's source offset (-1 when unknown),
  // carried to the renderer as the ` [@off=N]` marker locate_type_error decodes.
  // Before this the row mismatch had no position at all -- measured as the worst
  // tier in eval/lang-review/repair (05).
  EEEffectRowMismatch(String, String, String, String, Int);
  // #2985 review (Codex P0): a KINDED handler arm (`Exception[K]::Throw`)
  // is a catch-all at run time -- the abortive channel carries no kind -- so
  // a throw of another kind, or of an unresolved kind, that the checker
  // believed would propagate past the handle is caught by it and its payload
  // is read at the wrong type. Fields: enclosing function, the handler's
  // kinded labels, the offending required labels, offset.
  EEKindedHandleCatchesAll(String, String, String, Int);
  // #2985 review (Codex P0): a handle with more than one exception arm.
  // Fields: enclosing function, the exception labels of its arms.
  EEMultipleExceptionArms(String, String);
  // #1683: a source effect with no host/runtime owner reached a program entry.
  // Fields: entry name, sorted offending row, sorted bare handler names, offset.
  EEUndischargedEntryEffect(String, String, String, Int);
  // An entry row variable has no caller that can instantiate it. Keep this
  // separate from concrete effects so the fix-it never suggests handling a
  // type-level row variable as though it were an effect declaration.
  EEUnresolvedEntryEffectRow(String, String, Int);
  EEProviderOperationCollision(String);
  // ADR-0088: the entry granted `Op?` (optional) and the body called `Op` as
  // required. Fields: function name, operation, the declared label whose
  // optional grade covers it (`Op?`, or the provider-wide `Provider?`), offset.
  EEOptionalGrantForRequiredCall(String, String, String, Int);
  // ADR-0088: an entry row names `Provider::op` for a standard host provider
  // that owns no such operation. Fields: entry name, label.
  EEUnknownProviderOperation(String, String);
  // ADR-0088: `?` on a row label that is not a host capability. Fields:
  // function name, label as written.
  EEOptionalGradeNotCapability(String, String);
  EEAssignImmutable(String);
  // #1539: provider-owned stdin lifecycle operations cannot be transported as
  // values until generic higher-order effect flow is sound (#1536).
  EEStdinProviderValueReference(String);
  // #1347: a `handle ... with E` whose arms are provably dead because the
  // body cannot reach a perform of E and only invokes an opaque value —
  // the handler-switch footgun. Field: the effect name.
  EEHandleNeverFires(String);
  // #3180: the #1347 shape where the opaque call IS visible -- a local closure
  // with no effect row whose body performs the effect. The handle is refused
  // the same way, but "reaches no perform" is false. Fields: the effect, the
  // closure's name, the call's source offset (-1 when unlocated).
  EEHandleRowlessClosure(String, String, Int);
  // A mutable local may change targets, so handler evidence cannot follow
  // its annotated row even when its current initializer performs the effect.
  EEHandleMutableAlias(String, String, Int);
  // ADR-0102 / #1678: defense in depth for AST producers that bypass the
  // source parser. EHandle does not retain its source effect name, so this
  // diagnostic deliberately names the structural problem instead.
  EEEmptyHandle;
  // ADR-0088: a `perform?` with no optional grant of its operation in scope.
  // Fields: the function or block whose row would carry the grade, the
  // operation, offset.
  EEPerformQuestionRequiresOptional(String, String, Int);
  // ADR-0088: a `perform?` whose `NotGranted` arm cannot run. Fields: the
  // function or block, the operation, the REQUIRED label that absorbs the
  // optional grade ("" when the reason is the block's full authority), offset.
  EEPerformQuestionAlwaysGranted(String, String, String, Int);
  EEPerformQuestionSourceShadow(String, Int);
  EEPerformQuestionInvalidOperand(Int)
}

//# Functions

// #944 follow-up: the general `check_effects_expr`/`check_effects_stmt`/
// `check_effects_stmts` walk (the pre-#933 `in_effect: Bool` discipline that
// produced EEThrowOutsideEffect / EEEffectfulCallOutsideEffect for ANY
// effectful call outside an effectful context) was retired here. It had no
// live-pipeline caller -- `check_program` wires check_perform_effects_* (the
// row-based discipline below, which since #944 also checks the Error row by
// default) plus the Async-scoped check_async_effects_* pass further down --
// and was only reachable from two unit-test harnesses, which now exercise the
// live entry points instead. EEThrowOutsideEffect went with it (its only
// constructor was that walk's EThrow arm, dead since #640 Stage 2 desugared
// `throw` to `perform Exception::Throw`); EEEffectfulCallOutsideEffect stays --
// check_async_effects_expr still reports it for async primitives.

/// A hint rewrites a bare `Stdin` / `Stdout` / `Stderr` label to `Console`.
/// `println` and `print` already require `Console`. The legacy operations
/// still carry their own labels; pasting those labels would tell the reader
/// to write the name the book retired.
fn spell_legacy_tty(item: String) -> String {
  if String::index_of(item, "::") < 0 && is_legacy_console_provider(item) {
    "Console"
  } else {
    item
  }
}

/// #1429: render a stored row as the SOURCE spelling the reader must type.
/// Rows are stored comma-joined; the syntax is `+`-separated. Every `hint:`
/// below hands the reader something to paste into their code, so it has to go
/// through here -- a hint that suggests `with { Error, Fs }` is telling them
/// to write syntax the compiler is migrating away from (and, once the braced
/// form is removed, syntax it rejects outright).
///
/// Legacy tty labels are spelled `Console`, and a second `Console` is
/// dropped. The set-valued parts of the message (`missing { .. }`,
/// `requires { .. }`) use `row_set_for_reader` for the same spelling.
export fn row_as_source(row: String) -> String {
  let parts = row_items_top_level(row)
  let n = Array::length(parts)
  let mut acc = ""
  let mut k = 0
  let mut i = 0
  let mut any = false
  let mut seen_console = false
  while i < n {
    let item = Array::get(parts, i)
    let shown = if row_item_kind_is_unspellable(item) {
      k = k + 1
      String::concat("Exception[", String::concat(unspellable_kind_alias(k), "]"))
    } else {
      spell_legacy_tty(item)
    }
    let skip = shown == "Console" && seen_console
    if shown == "Console" {
      seen_console = true
    } else {
      ()
    }
    if !skip {
      acc = if !any {
        shown
      } else {
        String::concat(acc, String::concat(" + ", shown))
      }
      any = true
    } else {
      ()
    }
    i = i + 1
  }
  acc
}

/// Same spelling as `row_as_source`, joined the way a set difference is
/// printed (`A, B`). What the reader declared is not passed through here.
export fn row_set_for_reader(row: String) -> String {
  let parts = row_items_top_level(row)
  let n = Array::length(parts)
  let mut acc = ""
  let mut i = 0
  let mut any = false
  let mut seen_console = false
  while i < n {
    let shown = spell_legacy_tty(Array::get(parts, i))
    let skip = shown == "Console" && seen_console
    if shown == "Console" {
      seen_console = true
    } else {
      ()
    }
    if !skip {
      acc = if !any {
        shown
      } else {
        String::concat(acc, String::concat(", ", shown))
      }
      any = true
    } else {
      ()
    }
    i = i + 1
  }
  acc
}

/// A stored row's items, split at the commas that separate items. A kind
/// such as `(Int, Int) -> Int` holds a comma of its own, inside brackets.
export fn row_items_top_level(row: String) -> Array[String] {
  let out = array_empty()
  let n = String::length(row)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::char_code_at(row, i)
    if c == 40 || c == 91 {
      depth = depth + 1
    } else if c == 41 || c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      let item = String::trim(String::substring(row, start, i))
      if String::length(item) > 0 {
        Array::push(out, item)
      } else {
        ()
      }
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  let last = String::trim(String::substring(row, start, n))
  if String::length(last) > 0 {
    Array::push(out, last)
  } else {
    ()
  }
  out
}

/// #3033 follow-up: a row item's type arguments are type NAMES
/// (`collect_row_item_targs`), so a kind the checker spells from a function
/// type, `Exception[(Int) -> Int]`, cannot be pasted into a row. A hint names
/// such a kind through an alias it asks the reader to declare.
fn row_item_kind_is_unspellable(item: String) -> Bool {
  String::starts_with(item, "Exception[") && (String::contains(item, "(") || String::contains(item, "->"))
}

fn unspellable_kind_alias(k: Int) -> String {
  if k == 1 {
    "Kind"
  } else {
    String::concat("Kind", __to_string(k))
  }
}

/// The alias declarations `row_as_source` relies on, in its numbering --
/// or "" when every kind in the row is already a type name. The names are
/// placeholders the reader may have to change, and the hint says so.
export fn row_unspellable_kind_decls(row: String) -> String {
  let parts = row_items_top_level(row)
  let decls = array_empty()
  let mut k = 0
  let mut i = 0
  while i < Array::length(parts) {
    let item = Array::get(parts, i)
    if row_item_kind_is_unspellable(item) {
      k = k + 1
      let inner = String::substring(item, 10, String::length(item) - 1)
      Array::push(decls, String::concat("`type ", String::concat(unspellable_kind_alias(k), String::concat(" = ", String::concat(inner, "`")))))
    } else {
      ()
    }
    i = i + 1
  }
  if Array::length(decls) == 0 {
    ""
  } else {
    // The alias is numbered, not looked up: this renderer has no type
    // environment, so the hint says the name is the reader's to choose.
    String::concat("a row names an exception kind by a type name, so declare ", String::concat(String::join(decls, " and "), " (any name this module does not already declare -- use it in the row too), then "))
  }
}

/// True when a handle arm targets an Async operation.
export fn handle_arms_handle_async(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => if String::starts_with(name, "Async::") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

//# #1358: `for` over an ASYNC iterator also needs `Async`
//
// `for x in it`, where `it`'s iterator `next` yields a `Future`, is lowered to
// an AWAIT loop by the dict-passing desugar (build_await_iter_for), which runs
// AFTER the checker -- so at check time the program text holds no async
// primitive and the pass above finds nothing to require. The loop could
// therefore suspend from a context that neither declares nor handles `Async`.
// This hole is not #1350's doing: the retired `for await` marker was unwrapped
// by the checker without requiring anything either. #1350 only widened the
// exposure, since now every plain `for` over a Future-returning iterator takes
// the await lowering.
//
// Recognising the loop needs the ITERAND's type, so this mirrors the desugar's
// own resolution (infer_arg_type_name over var_types/fn_returns). Those tables
// are built in codegen, so here the head type name comes from the type
// environment plus a small locals table threaded down the walk. Both sides are
// best-effort by construction -- an unresolvable iterand requires nothing,
// exactly as the desugar leaves an unclassifiable loop as a sync EForIn -- so
// this can MISS a requirement, but never invent one.

/// The walk's locals: `name -> head type name`, innermost binding first.
/// A cons list, so binding is O(1) and shares the outer scope; the array this
/// replaced was copied on every bind (five copies per `let`). `AlMask(n, ..)`
/// is a binding of `n` with no known head: it hides an outer `n`.
export enum AfeLocals {
  AlNil;
  AlBind(String, String, AfeLocals);
  AlMask(String, AfeLocals)
}

export fn afe_no_locals() -> AfeLocals {
  AlNil
}

// Selected package imports are the source-level provenance that survives even
// when the projected TypeEnv intentionally hides AsyncIterator. Reset for each
// checked program because unit-test daemons reuse this compiler instance.
export let afe_builtin_async_iter_import_names: Array[String] = array_empty()

export fn afe_is_async_iter_publication_name(name: String) -> Bool {
  name == "AsyncIter" || name == "Array::iter" || name == "AsyncIter::empty" || name == "AsyncIter::once" || name == "AsyncIter::map" || name == "AsyncIter::filter" || name == "AsyncIter::take" || name == "AsyncIter::take_while" || name == "async_iter_arr" || name == "async_iter_empty" || name == "async_iter_once" || name == "async_iter_map" || name == "async_iter_filter" || name == "async_iter_take" || name == "async_iter_take_while"
}

export let afe_builtin_async_iter_head: String = "#builtin:AsyncIter"

export fn afe_record_builtin_async_iter_imports(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => if path == "@vibe/builtin" {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          if afe_is_async_iter_publication_name(item.name) {
            Array::push(afe_builtin_async_iter_import_names, item.name)
            match item.alias {
              Some(alias) => Array::push(afe_builtin_async_iter_import_names, alias),
              None => ()
            }
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      SModule(_, _, body) => afe_record_builtin_async_iter_imports(body),
      _ => ()
    }
    i = i + 1
  }
}

/// The public constructor is the package-stable evidence available after
/// `@vibe/builtin` projection hides its private `AsyncIterator` trait. Require
/// the imported signature as well as the nominal head: a user-defined struct
/// that happens to be named `AsyncIter` must remain an ordinary sync value.
export fn afe_origin_is_builtin_async_iter(origin: BindingOrigin) -> Bool {
  let (path, source_name) = match origin {
    BindingOriginModuleExport(origin_path, source) => (origin_path, source),
    BindingOriginReExportSurface(origin_path, source) => (origin_path, source),
    BindingOriginUnavailable => ("", "")
  }
  let from_builtin = String::ends_with(path, "@vibe/builtin/index.vpkg") || String::ends_with(path, "@vibe/builtin/async_iter.vibe")
  let publishes_async_iter = afe_is_async_iter_publication_name(source_name)
  from_builtin && publishes_async_iter
}

//# perform-discipline enforcement (#626 criterion 1)
//
// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either
// the enclosing function/lambda declares it in `with` row, or the perform
// is inside a `handle` (which discharges it). Otherwise it is a type error —
// "performing an undeclared effect". This realizes the first acceptance
// criterion of #626 (the checker formerly accepted undeclared performs because
// it never resolved which effect an op belongs to).
//
// A `handle` is treated CONSERVATIVELY as discharging any effect for its body
// (we do not yet read which specific effect its arms handle), so a perform
// inside any handle is allowed — this never rejects a valid program; it only
// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle
// case, which full row tracking (#626 criteria 2/4) will cover.

/// Parse a source `with` row annotation into the canonical row. This is
/// the sole parser for checker effect rows: labels are trimmed and deduped, and
/// `None` remains structurally different from an explicit `with ()`.
export fn effect_row_parse(eff: Option[String]) -> Option[Array[String]] {
  match eff {
    // None is structurally distinct from Some([]): it means the row is
    // inferred and therefore inherits its surrounding context.
    None => None,
    Some(s) => {
      let labels = array_empty()
      let raw = String::split(s, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = canonical_exception_effect_name(String::trim(Array::get(raw, i)))
        let internal_provenance = String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[") || String::starts_with(label, "#aliasparam[") || String::starts_with(label, "#fieldparam[")
        if String::length(label) > 0 && !internal_provenance && !effect_row_has_label(Some(labels), label) {
          Array::push(labels, label)
        }
        i = i + 1
      }
      // Some([]) is an explicitly pure `with ()` row.
      Some(labels)
    }
  }
}

/// Exact membership only; notably, `NotAsync` and `AsyncLike` do not contain
/// the `Async` label.
export fn effect_row_has_label(row: Option[Array[String]], wanted: String) -> Bool {
  match row {
    None => false,
    Some(labels) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(labels) {
        if Array::get(labels, i) == wanted {
          found = true
        }
        i = i + 1
      }
      found
    }
  }
}

/// Exact membership for consumers outside the checker package. Effect rows
/// are parser-normalized comma-separated labels; substring matching would let
/// `NotAsync` or `AsyncLike` grant the `Async` capability (#1289).
export fn effect_row_contains_label(eff: Option[String], wanted: String) -> Bool {
  effect_row_has_label(effect_row_parse(eff), wanted)
}

export fn effect_row_labels(row: Option[Array[String]]) -> Array[String] {
  match row {
    None => array_empty(),
    Some(labels) => labels
  }
}

/// Resolve an annotation at a nested lambda boundary. Inferred rows inherit;
/// explicit rows, including `with ()`, replace the surrounding row.
export fn effect_row_inherit(row: Option[Array[String]], surrounding: Array[String]) -> Array[String] {
  match row {
    None => surrounding,
    Some(labels) => labels
  }
}

/// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the
/// current representation): a function declaring `with e` may perform any
/// effect, so treat such a declaration as authorizing everything.
export fn label_is_effect_var(name: String) -> Bool {
  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
}

/// #1340 (ADR-0071): the base effect name of a row label — `State[Int]` and
/// `State[String]` both have base `State`; a bracketless label is its own
/// base. Row CONTAINMENT is instantiation-insensitive for now: a bare
/// `State` authorizes any instantiation and vice versa (for bracketless
/// rows base equality degenerates to exact equality, so existing programs
/// are unchanged). Distinguishing instantiations inside containment is the
/// remaining ADR-0071 OperationRef-normalization work.
export fn row_label_base(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi > 0 {
    label[0: bi]
  } else {
    label
  }
}

/// #3053: `E[A]` and `E[B]` stay interchangeable (#1340 v1) EXCEPT when both
/// sides spell closed builtin types that differ: `with State[Int]` does not
/// authorize a callee's `State[String]`. The test is syntactic, so it only
/// judges spellings made of builtin type names -- a formal, an alias or a
/// declared type is not a builtin name, so it keeps the old base-name answer
/// rather than being mistaken for a different type.
/// A requirement whose call instantiated a formal ambiguously (`?S`, see
/// `ambiguous_formal_bindings`) is authorized by no declared label.
export fn row_label_args_ambiguous(label: String) -> Bool {
  String::contains(row_label_args(label), "?")
}

/// Does a stored row carry a label `row_label_args_ambiguous` refuses?
export fn row_has_ambiguous_label(row: String) -> Bool {
  let parts = row_items_top_level(row)
  let mut found = false
  let mut i = 0
  while i < Array::length(parts) && !found {
    if row_label_args_ambiguous(Array::get(parts, i)) {
      found = true
    }
    i = i + 1
  }
  found
}

export fn row_label_args_closed_and_differ(a: String, b: String) -> Bool {
  let aa = row_label_args(a)
  let ba = row_label_args(b)
  String::length(aa) > 0 && String::length(ba) > 0 && builtin_closed_type_text(aa) && builtin_closed_type_text(ba) && aa != ba
}

/// The text between a label's first `[` and its matching `]`, spaces removed;
/// "" when the label carries no brackets.
export fn row_label_args(label: String) -> String {
  let bi = String::index_of(label, "[")
  if bi < 0 {
    ""
  } else {
    let n = String::length(label)
    let mut depth = 0
    let mut end = 0 - 1
    let mut i = bi
    while i < n && end < 0 {
      let c = String::char_code_at(label, i)
      if c == 91 {
        depth = depth + 1
      } else if c == 93 {
        depth = depth - 1
        if depth == 0 {
          end = i
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    if end < 0 {
      ""
    } else {
      let inner = String::substring(label, bi + 1, end)
      String::join(String::split(inner, " "), "")
    }
  }
}

/// Builtin type names a binder reuses as a type parameter (`fn f[Int](..)`,
/// Codex on #3054). Such a spelling may name a formal, so
/// `builtin_closed_type_text` does not judge it. The set is LEXICAL: it is
/// recorded per top-level declaration (`effect_shadow_key`), and the effects
/// walk selects the declaration's own set before walking it, so a shadowing
/// formal in one declaration does not switch the check off in another (Codex
/// on #3054). Slot 0 is the set in force; slot 1 is the module-wide union,
/// used for a statement no key names -- the lenient answer, never a refusal.
export let shadowed_builtin_type_names_cell: Array[Array[String]] = [[], []]
let shadowed_builtin_type_names_by_decl: Array[MutMap[String, Array[String]]] = [
  MutMap::new_string()
]

export fn set_shadowed_builtin_type_names(by_decl: Array[(String, Array[String])]) -> Unit {
  let m = MutMap::new_string()
  let all = array_empty()
  let mut i = 0
  while i < Array::length(by_decl) {
    let (k, names) = Array::get(by_decl, i)
    MutMap::set(m, k, names)
    let mut j = 0
    while j < Array::length(names) {
      if !str_labels_contain(all, Array::get(names, j)) {
        Array::push(all, Array::get(names, j))
      }
      j = j + 1
    }
    i = i + 1
  }
  Array::set(shadowed_builtin_type_names_by_decl, 0, m)
  Array::set(shadowed_builtin_type_names_cell, 1, all)
  Array::set(shadowed_builtin_type_names_cell, 0, all)
}

/// The key a top-level statement's shadow set is recorded and selected under;
/// "" for a statement that names nothing (it takes the module-wide set).
export fn effect_shadow_key(stmt: Stmt) -> String {
  match stmt {
    SLet(_, _, name, _, _) => String::concat("let:", name),
    SLetMut(name, _, _) => String::concat("let:", name),
    STest(name, _) => String::concat("test:", name),
    SBench(name, _) => String::concat("bench:", name),
    _ => ""
  }
}

export fn select_shadowed_builtin_type_names(stmt: Stmt) -> Unit {
  let k = effect_shadow_key(stmt)
  let chosen = if String::length(k) == 0 {
    Array::get(shadowed_builtin_type_names_cell, 1)
  } else {
    // A declaration with no entry shadows nothing.
    match MutMap::get(Array::get(shadowed_builtin_type_names_by_decl, 0), k) {
      Some(names) => names,
      None => []
    }
  }
  Array::set(shadowed_builtin_type_names_cell, 0, chosen)
}

/// #3095: the nominal type names (structs, enums) this module declares or
/// imports under their own name, never an alias (`row_nominal_type_names`).
/// A row word in this set names exactly one type.
export let row_nominal_types_cell: Array[Array[String]] = [[]]

export fn set_row_nominal_types(names: Array[String]) -> Unit {
  Array::set(row_nominal_types_cell, 0, names)
}

/// #3095: the type formals in LEXICAL scope where the walk stands, one entry
/// per binder that introduced some: the top-level declaration's own `[S]`, and
/// every nested lambda's. A lambda with no row of its own inherits the
/// enclosing row, whose words were written OUTSIDE its binder, so its formals
/// are entered as `@N`: they place a requirement's `'N` (the lambda's body
/// runs at its own `N`) but never a DECLARED word (`[N](v: N) -> Int { .. }`
/// under `with State[N]`, `N` an imported alias, reads the alias). An entry
/// holding `row_scope_unknown()` switches the judge off below it.
export let row_formal_scope: Array[Array[String]] = []

export fn row_scope_unknown() -> String {
  "#unknown"
}

/// The expression the walk pushes BELOW a lambda body: it is popped once the
/// whole body has been walked, and closes that body's formal scope. The
/// spelling is not an identifier, so no source expression can be it.
export fn row_scope_pop_marker() -> String {
  "#row-scope-pop"
}

export fn row_scope_has(name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(row_formal_scope) && !found {
    if str_labels_contain(Array::get(row_formal_scope, i), name) {
      found = true
    }
    i = i + 1
  }
  found
}

/// A requirement's formal `'name`: bound by any enclosing binder.
export fn row_scope_has_formal(name: String) -> Bool {
  row_scope_has(name) || row_scope_has(String::concat("@", name))
}

/// #3101: does scope entry `entry` belong to a generic binder -- one that
/// introduced type formals (`S`, or `@S` for a lambda inheriting its row)?
/// An entry holding only callback markers (`%f`) or `row_scope_unknown()` is
/// not one, and neither is a top-level declaration with no formals. The
/// checker opens a generic declaration exactly for these (`eq_group_begin`).
fn row_scope_entry_is_generic(entry: Array[String]) -> Bool {
  let mut found = false
  let mut j = 0
  while j < Array::length(entry) && !found {
    let w = Array::get(entry, j)
    if !String::starts_with(w, "%") && w != row_scope_unknown() {
      found = true
    }
    j = j + 1
  }
  found
}

/// #3101: the generic depth of scope entry `idx`: how many generic binders
/// enclose it. The checker qualifies a requirement's formal with the same
/// count (`eq_formal_depth`), so `S$0` and `S$1` are two binders' `S`.
fn row_scope_generic_depth_of(idx: Int) -> Int {
  let mut d = 0
  let mut i = 0
  while i < idx && i < Array::length(row_formal_scope) {
    if row_scope_entry_is_generic(Array::get(row_formal_scope, i)) {
      d = d + 1
    }
    i = i + 1
  }
  d
}

fn row_formal_at_depth(name: String, depth: Int) -> String {
  String::concat(name, String::concat("$", __to_string(depth)))
}

/// #3101: a declared word `name` that the lexical scope binds, qualified by
/// the INNERMOST binder of that spelling -- the one the word names where it
/// was written. Only a binder's own formals count; an `@name` entry (a lambda
/// inheriting the enclosing row) does not rebind the row's words.
export fn row_declared_formal(name: String) -> String {
  let mut out = ""
  let mut i = Array::length(row_formal_scope) - 1
  while i >= 0 {
    if str_labels_contain(Array::get(row_formal_scope, i), name) {
      out = row_formal_at_depth(name, row_scope_generic_depth_of(i))
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  out
}

/// #3101: a requirement's formal word as the checker marked it: `'S$1` names
/// binder depth 1's `S`, and is returned as is. A formal the checker could not
/// qualify (`'Int`, a formal spelled like a builtin, has no variable) is
/// placed only when exactly ONE binder in scope has that spelling; with two,
/// which one it is cannot be told, and the answer is a spelling no declared
/// word resolves to, so it never matches a row by accident. "" when no binder
/// in scope has the spelling.
export fn row_required_formal(word: String) -> String {
  let di = String::last_index_of(word, "$")
  let name = if di > 0 {
    String::substring(word, 0, di)
  } else {
    word
  }
  if !row_scope_has_formal(name) {
    ""
  } else if di > 0 {
    word
  } else {
    let mut count = 0
    let mut at = 0 - 1
    let mut i = 0
    while i < Array::length(row_formal_scope) {
      let entry = Array::get(row_formal_scope, i)
      if str_labels_contain(entry, name) || str_labels_contain(entry, String::concat("@", name)) {
        count = count + 1
        at = i
      }
      i = i + 1
    }
    if count == 1 {
      row_formal_at_depth(name, row_scope_generic_depth_of(at))
    } else {
      String::concat(name, "$ambiguous")
    }
  }
}

/// #3102 review: the first scope entry that can stand between a callback
/// parameter's annotation and its call -- one past the binder that declared
/// the parameter. A top-level declaration's parameters leave it at 1.
export let row_callback_scope_start_cell: Array[Int] = [1]

/// The scope entry a lambda pushes names each callback parameter it declares
/// as `%name`, so a call can find the binder its annotation was written in.
export fn row_scope_callback_marker(name: String) -> String {
  String::concat("%", name)
}

export fn row_scope_callback_start(name: String) -> Int {
  let marker = row_scope_callback_marker(name)
  let mut start = 1
  let mut i = Array::length(row_formal_scope) - 1
  while i >= 1 {
    if str_labels_contain(Array::get(row_formal_scope, i), marker) {
      start = i + 1
      i = 0
    }
    i = i - 1
  }
  start
}

/// Does a binder nested inside the callback annotation's own binder bind
/// `name`? (The top-level declaration's own binder never does.)
export fn row_scope_nested_binds(name: String) -> Bool {
  let mut found = false
  let mut i = Array::get(row_callback_scope_start_cell, 0)
  while i < Array::length(row_formal_scope) {
    let entry = Array::get(row_formal_scope, i)
    if str_labels_contain(entry, name) || str_labels_contain(entry, String::concat("@", name)) {
      found = true
    }
    i = i + 1
  }
  found
}

/// Does the declared-word scope hold only the top-level declaration's own
/// binder? Then every enclosing parameter annotation was written in it.
export fn row_scope_decl_is_root() -> Bool {
  let mut ok = true
  let mut i = 1
  while i < Array::length(row_formal_scope) {
    let entry = Array::get(row_formal_scope, i)
    let mut j = 0
    while j < Array::length(entry) {
      let w = Array::get(entry, j)
      if !String::starts_with(w, "@") && !String::starts_with(w, "%") {
        ok = false
      }
      j = j + 1
    }
    i = i + 1
  }
  ok
}

export fn str_labels_contain(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && !found {
    if Array::get(xs, i) == x {
      found = true
    }
    i = i + 1
  }
  found
}

/// Is `t` (spaces already removed) built only from builtin type names,
/// `Array[..]` / `Option[..]` and commas?
fn builtin_closed_type_text(t: String) -> Bool {
  let n = String::length(t)
  let mut ok = n > 0
  let mut start = 0 - 1
  let mut i = 0
  while i <= n && ok {
    let c = if i < n {
      String::char_code_at(t, i)
    } else {
      0
    }
    let is_letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
    if is_letter {
      if start < 0 {
        start = i
      } else {
        ()
      }
    } else {
      if start >= 0 {
        let w = String::substring(t, start, i)
        if w != "Int" && w != "String" && w != "Bool" && w != "Double" && w != "Char" && w != "Bytes" && w != "Unit" && w != "Array" && w != "Option" || str_labels_contain(Array::get(shadowed_builtin_type_names_cell, 0), w) {
          ok = false
        } else {
          ()
        }
        start = 0 - 1
      } else {
        ()
      }
      if i < n && c != 91 && c != 93 && c != 44 {
        ok = false
      } else {
        ()
      }
    }
    i = i + 1
  }
  ok
}

export fn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, _, eff)) => effect_row_labels(effect_row_parse(eff)),
    _ => effect_row_labels(effect_row_parse(None))
  }
}

/// #1451: rows declared by FUNCTION TYPES sitting inside a signature's RETURN
/// type. `fn make() -> (String) -> Unit with Log::Emit { (s) -> { perform .. } }`
/// declares that the returned VALUE may perform `Log::Emit`; `make` itself does
/// not, and `sig_type_effect_labels` correctly reports `make`'s own row as empty.
///
/// A closure LITERAL never carries a row of its own (rows are not written at a
/// literal — the pass infers them), so the returned literal's perform was charged
/// to the enclosing function, and the only way to satisfy the checker was to
/// declare a row on `make` that `make` does not have. Collected recursively, so a
/// row nested under `Array[_]` / a tuple / `Option[_]` is found too.
///
/// This set is granted ONLY to nested closure literals (see the walker's `EFn`
/// arm), never to the enclosing body's own statements — a direct
/// `perform Log::Emit(..)` in `make`'s body stays flagged, because that one really
/// does run in `make` with no handler.
export fn ret_fn_row_labels_into(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyFn(params, ret, eff) => {
      let labels = effect_row_labels(effect_row_parse(eff))
      let mut li = 0
      while li < Array::length(labels) {
        Array::push(out, Array::get(labels, li))
        li = li + 1
      }
      let mut i = 0
      while i < Array::length(params) {
        ret_fn_row_labels_into(Array::get(params, i), out)
        i = i + 1
      }
      ret_fn_row_labels_into(ret, out)
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        ret_fn_row_labels_into(Array::get(args, i), out)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        ret_fn_row_labels_into(Array::get(elems, i), out)
        i = i + 1
      }
    },
    _ => ()
  }
}

export fn ret_fn_row_labels(ret: Option[TypeExpr]) -> Array[String] {
  let out = array_empty()
  match ret {
    Some(te) => ret_fn_row_labels_into(te, out),
    None => ()
  }
  out
}

/// Same, from a BINDING annotation (`let make: () -> ((String) -> Unit with E) = ...`)
/// rather than the `fn`'s own arrow. Descends only into the RETURN slot: a
/// PARAMETER's function row is already handled by the callback-parameter overlay
/// (#885), and granting it here would widen the body's permission for no reason.
export fn ret_fn_rows_from_sig(topt: Option[TypeExpr]) -> Array[String] {
  match topt {
    Some(TyFn(_, ret, _)) => {
      let out = array_empty()
      ret_fn_row_labels_into(ret, out)
      out
    },
    _ => array_empty()
  }
}

/// Module-level cell for the current binding's return-type rows, in the same
/// style as `error_row_mode_cell` above: the walker is a flat stack loop with a
/// fixed tuple shape and eight call sites, so threading a ninth parameter through
/// it to reach one arm costs more than it buys. Set per binding by
/// `check_perform_effects_binding_tx`, read by the walker's `EFn` arm. Walks are
/// sequential (one binding at a time), so no save/restore stack is needed.
let ret_fn_rows_cell: Array[Array[String]] = array_empty()

export fn set_ret_fn_rows(rows: Array[String]) -> Unit {
  Array::truncate(ret_fn_rows_cell, 0)
  Array::push(ret_fn_rows_cell, rows)
}

export fn current_ret_fn_rows() -> Array[String] {
  if Array::length(ret_fn_rows_cell) > 0 {
    Array::get(ret_fn_rows_cell, 0)
  } else {
    array_empty()
  }
}

/// #1451 (struct-field position): rows declared by a STRUCT FIELD's type, keyed
/// `Struct::field`. Same defect as the return position and the same cause -- a
/// closure literal stored into
/// `struct Box { run: (String) -> Unit with Log::Emit }` carries no row of its
/// own, so its perform was charged to the function BUILDING the record, which
/// only assembles a closure and never performs it.
///
/// The walker is a flat stack loop with no access to the program's type
/// declarations, so the table is built once per program (from every `SStruct`)
/// and read by the `ERecord` arm -- the same module-cell shape as
/// `ret_fn_rows_cell` above, for the same reason. Only fields whose type
/// actually declares a row get an entry, so the common program adds nothing.
let struct_field_rows_cell: Array[(Array[String], Array[Array[String]])] = array_empty()

fn struct_field_key(sname: String, fname: String) -> String {
  String::concat(sname, String::concat("::", fname))
}

export fn build_struct_field_rows(stmts: Array[Stmt]) -> Unit {
  let keys = array_empty()
  let rows = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fty) = Array::get(fields, fi)
          let out = array_empty()
          ret_fn_row_labels_into(fty, out)
          if Array::length(out) > 0 {
            Array::push(keys, struct_field_key(sname, fname))
            Array::push(rows, out)
          } else {
            ()
          }
          fi = fi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  Array::truncate(struct_field_rows_cell, 0)
  Array::push(struct_field_rows_cell, (keys, rows))
}

export fn struct_field_rows_for(sname: String, fname: String) -> Array[String] {
  if Array::length(struct_field_rows_cell) == 0 || String::length(sname) == 0 {
    array_empty()
  } else {
    let (keys, rows) = Array::get(struct_field_rows_cell, 0)
    let want = struct_field_key(sname, fname)
    let mut found = array_empty()
    let mut i = 0
    while i < Array::length(keys) {
      if Array::get(keys, i) == want {
        found = Array::get(rows, i)
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

export fn no_str_labels() -> Array[String] {
  array_empty()
}

export fn no_ov_effs() -> Array[Array[String]] {
  array_empty()
}

/// A labeled or optional parameter is declared with a trailing marker but
/// bound and called by its base name. Use that name for local shadowing and
/// effect overlays.
export fn effect_param_base_name(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

/// A declared `Console` row includes input, so it is not cache-safe by
/// itself (`is_entry_cache_safe_operation`). `println` / `print` require
/// that broad label anyway. An entry is still cacheable when every other
/// declared label is cache-safe and the body is provably output-only:
/// the builtin `println` / `print` and the stdout `write_stream` /
/// `write_char` spellings, and only when nothing in the module shadows
/// those names. A nested function, a `for` (its desugar inserts the
/// iterator call), and an interpolation are not inspected.
export fn str_list_has(xs: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn binding_hides_stdout_write(name: String) -> Bool {
  name == "println" || name == "print" || name == "Console" || name == "Stdout"
  // review-lint: allow-effect-name-compare -- a source spelling that can shadow a write, not an effect policy
}

export fn params_hide_stdout_write(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    if binding_hides_stdout_write(effect_param_base_name(name)) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn pats_hide_stdout_write(pats: Array[Pat]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(pats) {
    if pat_hides_stdout_write(Array::get(pats, i)) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn pat_hides_stdout_write(pat: Pat) -> Bool {
  match pat {
    PWild => false,
    PBind(name) => binding_hides_stdout_write(name),
    PInt(_) => false,
    PFloat(_) => false,
    PString(_) => false,
    PBool(_) => false,
    PCtor(_, args) => pats_hide_stdout_write(args),
    PTuple(args) => pats_hide_stdout_write(args),
    POr(left, right) => pat_hides_stdout_write(left) || pat_hides_stdout_write(right),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hide = false
      while i < Array::length(fields) {
        let (_, inner) = Array::get(fields, i)
        if pat_hides_stdout_write(inner) {
          hide = true
        } else {
          ()
        }
        i = i + 1
      }
      hide
    }
  }
}

fn call_is_captured_output(callee: Expr, fn_names: Array[String]) -> Bool {
  match callee {
    EIdent(name, _) => {
      if str_list_has(fn_names, name) {
        false
      } else {
        name == "println" || name == "print" || name == "Console::write_stream" || name == "Console::write_char" || name == "Stdout::write_stream" || name == "Stdout::write_char"
      }
    },
    EDot(recv, field, _, _) => {
      match recv {
        EIdent(head, _) => {
          if str_list_has(fn_names, head) {
            false
          } else {
            (head == "Console" || head == "Stdout") && (field == "write_stream" || field == "write_char")
            // review-lint: allow-effect-name-compare -- matches the written qualifier of a write call, not an effect policy
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

fn exprs_are_captured_output(xs: Array[Expr], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(xs) {
    if !expr_is_captured_output(Array::get(xs, i), fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn expr_pairs_are_captured_output(xs: Array[(String, Expr)], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(xs) {
    let (_, value) = Array::get(xs, i)
    if !expr_is_captured_output(value, fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn loop_inits_hide_stdout_write(inits: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hide = false
  while i < Array::length(inits) {
    let (name, _) = Array::get(inits, i)
    if binding_hides_stdout_write(name) {
      hide = true
    } else {
      ()
    }
    i = i + 1
  }
  hide
}

fn arms_are_captured_output(arms: Array[(Pat, Expr)], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    if pat_hides_stdout_write(pat) || !expr_is_captured_output(body, fn_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn expr_keeps_stdout_write(name: String, value: Expr, body: Expr, fn_names: Array[String]) -> Bool {
  if binding_hides_stdout_write(name) {
    false
  } else {
    expr_is_captured_output(value, fn_names) && expr_is_captured_output(body, fn_names)
  }
}

/// `|>` is still an `EBinOp` here. Desugar turns it into a call of the
/// right-hand side, so that side is the callee, not a pure operand.
fn pipe_rhs_is_captured_output(right: Expr, fn_names: Array[String]) -> Bool {
  match right {
    ECall(callee, args, _) => call_is_captured_output(callee, fn_names) && exprs_are_captured_output(args, fn_names),
    EIdent(_, _) => call_is_captured_output(right, fn_names),
    EDot(_, _, _, _) => call_is_captured_output(right, fn_names),
    _ => false
  }
}

fn expr_is_captured_output(expr: Expr, fn_names: Array[String]) -> Bool {
  match expr {
    EInt(_) => true,
    EFloat(_) => true,
    EBool(_) => true,
    EUnit => true,
    EIdent(_, _) => true,
    // The holes are source text until expand_interp, which this walk does
    // not run. A hole can be a read. Refuse the entry instead of caching it.
    EStringInterp(_) => false,
    EString(_, _) => true,
    ETuple(xs) => exprs_are_captured_output(xs, fn_names),
    EArray(xs) => exprs_are_captured_output(xs, fn_names),
    EContinue(xs) => exprs_are_captured_output(xs, fn_names),
    ERecord(_, fields, _) => expr_pairs_are_captured_output(fields, fn_names),
    EMap(fields) => expr_pairs_are_captured_output(fields, fn_names),
    EIf(cond, then_branch, else_branch) => expr_is_captured_output(cond, fn_names) && expr_is_captured_output(then_branch, fn_names) && expr_is_captured_output(else_branch, fn_names),
    ELet(name, value, body, _) => expr_keeps_stdout_write(name, value, body, fn_names),
    ELetRec(name, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    ELetMut(name, value, body, _) => expr_keeps_stdout_write(name, value, body, fn_names),
    EAssign(name, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    EAssignOp(name, _, value, body) => expr_keeps_stdout_write(name, value, body, fn_names),
    ESeq(left, right) => expr_is_captured_output(left, fn_names) && expr_is_captured_output(right, fn_names),
    EWhile(cond, body) => expr_is_captured_output(cond, fn_names) && expr_is_captured_output(body, fn_names),
    // Desugar rewrites `for` into iter_get / host_stream_next, which can
    // read. Those calls are not in this AST, so the surface node is refused.
    EForIn(_, _, _, _) => false,
    EBinOp(op, left, right, _) => if op == "|>" {
      expr_is_captured_output(left, fn_names) && pipe_rhs_is_captured_output(right, fn_names)
    } else {
      expr_is_captured_output(left, fn_names) && expr_is_captured_output(right, fn_names)
    },
    EUnaryOp(_, arg) => expr_is_captured_output(arg, fn_names),
    EReturn(arg) => expr_is_captured_output(arg, fn_names),
    ESpread(arg) => expr_is_captured_output(arg, fn_names),
    ELabeledArg(_, _, arg) => expr_is_captured_output(arg, fn_names),
    EDot(recv, _, _, _) => expr_is_captured_output(recv, fn_names),
    EBreak(value) => {
      match value {
        Some(inner) => expr_is_captured_output(inner, fn_names),
        None => true
      }
    },
    EMatch(scrut, arms) => expr_is_captured_output(scrut, fn_names) && arms_are_captured_output(arms, fn_names),
    ELoop(inits, body) => !loop_inits_hide_stdout_write(inits) && expr_pairs_are_captured_output(inits, fn_names) && expr_is_captured_output(body, fn_names),
    ECall(callee, args, _) => call_is_captured_output(callee, fn_names) && exprs_are_captured_output(args, fn_names),
    // A nested function is invisible to the effect walk. Caching it would
    // hide a read. A handler can discharge a read the same way.
    EFn(_, _, _, _, _, _) => false,
    EHandle(_, _) => false
  }
}

export fn console_entry_is_output_only(row: Array[String], body: Expr, fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut saw_console = false
  let mut ok = true
  while i < Array::length(row) {
    let label = Array::get(row, i)
    if label == "Console" {
      saw_console = true
    } else if !is_entry_cache_safe_operation(label) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok && saw_console && expr_is_captured_output(body, fn_names)
}

/// Every label in `row` must appear in `safe` -- unlike decl_authorizes_
/// effect above (used the OPPOSITE direction: "does this declared row
/// authorize performing effect X", where an effect-VARIABLE label
/// conservatively authorizes anything), this is used to conservatively
/// REJECT: an unrecognized label (including a row-variable letter, which a
/// real top-level `main` should never carry) is NOT treated as safe.
///
/// #1343: each row label is reduced to its EFFECT name before the lookup.
/// Once operation-level rows became expressible for host capabilities
/// (#1359), an entry declaring the STRICTLY NARROWER
/// `with Stdout::write_stream` would otherwise fail this exact-string
/// test and be judged un-cacheable, while the broader `with Stdout`
/// passed -- i.e. tightening a row would lose the #819/#1214 doctest cache.
/// `effect_name_of_op` only strips a `::` suffix (and canonicalizes the
/// exception aliases), so a row variable stays a row variable and an
/// unrelated effect stays unrelated: the conservative rejection above is
/// unchanged.
export fn labels_are_entry_cache_safe(row: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(row) {
    if !is_entry_cache_safe_operation(Array::get(row, i)) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

//# Mutability discipline: reassignment requires a `let mut` binding.
//
// `let x = ...` is immutable (docs/user/reference/cheatsheet.md); only `let mut x` may be
// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass
// walks expressions carrying the SET of names that are reassignable in scope
// and reports an `x = e` / `x op= e` whose target is not in that set.
//
// The set only ever GROWS down a scope (never shrinks), so the pass can only
// produce false NEGATIVES, never false positives: every form that introduces a
// reassignable or freshly-rebindable name — `let mut`, function parameters,
// loop accumulators, `for` variables, and pattern binds — is added, so the
// only thing flagged is reassignment of a plain immutable `let`. Nested
// functions INHERIT the outer set (a closure may mutate a captured `let mut`).

fn mut_has(xs: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn mut_with(base: Array[String], name: String) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  Array::push(out, name)
  out
}

export fn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(acc, name),
    PCtor(_, subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    PTuple(subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    POr(l, r) => {
      collect_pat_binds_into(l, acc)
      collect_pat_binds_into(r, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binds_into(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  collect_pat_binds_into(pat, out)
  out
}

fn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(base, 0, Array::length(base))
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    Array::push(out, pname)
    i = i + 1
  }
  out
}

export fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {
  let out = array_empty()
  check_mutability_expr_into(expr, mutable, out)
  out
}

fn check_mutability_expr_into(expr: Expr, mutable: Array[String], out: Array[EffectError]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      check_mutability_expr_into(callee, mutable, out)
      let mut ai = 0
      while ai < Array::length(args) {
        check_mutability_expr_into(Array::get(args, ai), mutable, out)
        ai = ai + 1
      }
      ()
    },
    EFn(_, _, params, _, _, body) => {
      check_mutability_expr_into(body, mut_with_params(mutable, params), out)
      ()
    },
    EHandle(body, arms) => {
      check_mutability_expr_into(body, mutable, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        check_mutability_expr_into(arm_body, mut_with_pat(mutable, pat), out)
        ai = ai + 1
      }
      ()
    },
    ELet(_, val, body, _) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELetRec(_, val, body) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELetMut(name, val, body, _) => {
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(body, mut_with(mutable, name), out)
      ()
    },
    ESeq(a, b) => {
      check_mutability_expr_into(a, mutable, out)
      check_mutability_expr_into(b, mutable, out)
      ()
    },
    EIf(cond, then_e, else_e) => {
      check_mutability_expr_into(cond, mutable, out)
      check_mutability_expr_into(then_e, mutable, out)
      check_mutability_expr_into(else_e, mutable, out)
      ()
    },
    EMatch(scrutinee, arms) => {
      check_mutability_expr_into(scrutinee, mutable, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        check_mutability_expr_into(arm_body, mut_with_pat(mutable, pat), out)
        ai = ai + 1
      }
      ()
    },
    EWhile(cond, body) => {
      check_mutability_expr_into(cond, mutable, out)
      check_mutability_expr_into(body, mutable, out)
      ()
    },
    ELoop(params, body) => {
      let loopmut = Array::slice(mutable, 0, Array::length(mutable))
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        check_mutability_expr_into(init, mutable, out)
        Array::push(loopmut, pname)
        i = i + 1
      }
      check_mutability_expr_into(body, loopmut, out)
      ()
    },
    EForIn(name, index_name, iter, body) => {
      check_mutability_expr_into(iter, mutable, out)
      let base = mut_with(mutable, name)
      let formut = match index_name {
        Some(idx) => mut_with(base, idx),
        None => base
      }
      check_mutability_expr_into(body, formut, out)
      ()
    },
    EBinOp(_, left, right, _) => {
      check_mutability_expr_into(left, mutable, out)
      check_mutability_expr_into(right, mutable, out)
      ()
    },
    EReturn(e) => check_mutability_expr_into(e, mutable, out),
    EUnaryOp(_, operand) => check_mutability_expr_into(operand, mutable, out),
    EAssign(name, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(out, EEAssignImmutable(name))
      } else {
        ()
      }
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(cont, mutable, out)
      ()
    },
    EAssignOp(name, _, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(out, EEAssignImmutable(name))
      } else {
        ()
      }
      check_mutability_expr_into(val, mutable, out)
      check_mutability_expr_into(cont, mutable, out)
      ()
    },
    EDot(obj, _, _, _) => check_mutability_expr_into(obj, mutable, out),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        check_mutability_expr_into(Array::get(elems, ei), mutable, out)
        ei = ei + 1
      }
      ()
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        check_mutability_expr_into(Array::get(elems, ei), mutable, out)
        ei = ei + 1
      }
      ()
    },
    ERecord(_, fields, _) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        check_mutability_expr_into(fval, mutable, out)
        fi = fi + 1
      }
      ()
    },
    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal
    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map
    // literal, labeled argument, spread, break value, or continue argument went
    // unflagged. Recurse with the SAME mutable set (these forms introduce no new
    // bindings), keeping the pass sound: still no false positives, just fewer
    // false negatives.
    EMap(entries) => {
      let mut mi = 0
      while mi < Array::length(entries) {
        let (_, mval) = Array::get(entries, mi)
        check_mutability_expr_into(mval, mutable, out)
        mi = mi + 1
      }
      ()
    },
    ELabeledArg(_, _, inner) => check_mutability_expr_into(inner, mutable, out),
    ESpread(inner) => check_mutability_expr_into(inner, mutable, out),
    EBreak(opt) => match opt {
      Some(e) => check_mutability_expr_into(e, mutable, out),
      None => ()
    },
    EContinue(cargs) => {
      let mut ci = 0
      while ci < Array::length(cargs) {
        check_mutability_expr_into(Array::get(cargs, ci), mutable, out)
        ci = ci + 1
      }
      ()
    },
    // New structural forms keep the same binding context; scoped forms above
    // intentionally remain explicit so their boundary semantics are visible.
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        check_mutability_expr_into(expr_child_at(i), mutable, out)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

/// #770: `outer` carries the top-level `let mut` names already in scope from
/// earlier sibling statements (see check_mutability_stmts below) so a later
/// top-level statement's assignment to an earlier top-level `mut` binding
/// (directly, or via a closure capturing it) is recognized as mutable instead
/// of being misreported as `cannot assign to immutable binding`.
fn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {
  match body {
    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),
    _ => check_mutability_expr(body, outer)
  }
}

/// #770: top-level program statements are a flat `Array[Stmt]` sequence (not
/// nested `ELetMut` continuations like a function/test body), so a top-level
/// `let mut x = ...` must thread `x` forward into the mutability check of
/// every later sibling statement by accumulating `mutable` across the loop —
/// mirroring how `check_stmts` threads `env` across the same array. Before
/// this fix each statement was checked in isolation starting from an empty
/// mutable set, so any top-level `let mut` followed by an assignment in a
/// later top-level statement (e.g. a top-level `while` loop mutating a
/// counter) was rejected with a bogus `cannot assign to immutable binding`
/// error even though the program is valid.
export fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {
  let errors = array_empty()
  let mut mutable = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),
      SLetMut(name, _, body) => {
        append_eff_errs(errors, check_mutability_binding(body, mutable))
        mutable = mut_with(mutable, name)
      },
      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),
      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),
      _ => ()
    }
    i = i + 1
  }
  errors
}
