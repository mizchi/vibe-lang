//# Append-aligned typed-occurrence role/lane observation
//
// This is intentionally an opaque, successful-check-only view. It records no
// offsets, expression paths, types, cache data, or mutable capture handle.

import ./checker_stmt.vibe {
  CheckedTypedOccurrenceRoleLaneObservation
}

fn snapshot_push_int(out: StringBuilder, value: Int) -> Unit {
  StringBuilder::push(out, __to_string(value))
  StringBuilder::push(out, ":")
}

fn snapshot_push_piece(out: StringBuilder, value: String) -> Unit {
  snapshot_push_int(out, String::length(value))
  StringBuilder::push(out, value)
}

/// Deterministic capture-order schema. Versioning is explicit because role and
/// lane tokens are the complete public payload of this narrow observation.
export fn canonical_checked_typed_occurrence_role_lane_snapshot(observation: CheckedTypedOccurrenceRoleLaneObservation) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-typed-occurrence-role-lane-observation:v1\n")
  snapshot_push_int(out, Array::length(observation.entries.entries))
  let mut i = 0
  while i < Array::length(observation.entries.entries) {
    let (role, lane) = Array::get(observation.entries.entries, i)
    snapshot_push_piece(out, role)
    snapshot_push_piece(out, lane)
    i = i + 1
  }
  StringBuilder::freeze(out)
}
