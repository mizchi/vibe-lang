//# Imports

import ../core {
  Type
}

import ../../../../lib/@vibe/core {
  array_empty
}

//# Functions

fn map_no_params() -> Array[Type] {
  array_empty()
}

fn map_one_param(a: Type) -> Array[Type] {
  let arr = map_no_params()
  Array::push(arr, a)
  arr
}

fn map_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = map_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = map_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

fn lookup_map_get(name: String) -> Option[Type] {
  if name == "Map::get" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))
  }
  else None
}

fn lookup_map_has(name: String) -> Option[Type] {
  if name == "map_has" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

fn lookup_map_set(name: String) -> Option[Type] {
  if name == "Map::set" {
    // Functional update: returns the (new) map, matching the host checker
    // (src/checker typecheck_call_builtin "Map::set"), not Unit.
    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed("Map", [
      CtString,
      CtUnknown
    ]), None))
  }
  else None
}

fn lookup_map_keys(name: String) -> Option[Type] {
  if name == "Map::keys" {
    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))
  }
  else None
}

fn lookup_map_has_key(name: String) -> Option[Type] {
  if name == "Map::has_key" || name == "Map::has" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

fn lookup_map_size(name: String) -> Option[Type] {
  if name == "Map::size" {
    Some(CtFn(map_one_param(CtUnknown), CtInt, None))
  }
  else None
}

fn lookup_map_values(name: String) -> Option[Type] {
  if name == "Map::values" {
    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

fn lookup_map_delete(name: String) -> Option[Type] {
  if name == "Map::delete" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtNamed("Map", [
      CtString,
      CtUnknown
    ]), None))
  }
  else None
}

fn lookup_map_group_c(name: String) -> Option[Type] {
  match lookup_map_size(name) {
    Some(t) => Some(t),
    None => match lookup_map_values(name) {
      Some(t) => Some(t),
      None => lookup_map_delete(name)
    }
  }
}

fn lookup_map_group_b(name: String) -> Option[Type] {
  match lookup_map_has(name) {
    Some(t) => Some(t),
    None => match lookup_map_keys(name) {
      Some(t) => Some(t),
      None => match lookup_map_has_key(name) {
        Some(t) => Some(t),
        None => match lookup_map_set(name) {
          Some(t) => Some(t),
          None => lookup_map_group_c(name)
        }
      }
    }
  }
}

fn lookup_mapbuilder_new(name: String) -> Option[Type] {
  if name == "MapBuilder::new" {
    Some(CtFn(map_no_params(), CtUnknown, None))
  }
  else None
}

fn lookup_mapbuilder_set(name: String) -> Option[Type] {
  if name == "MapBuilder::set" {
    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_mapbuilder_freeze(name: String) -> Option[Type] {
  if name == "MapBuilder::freeze" {
    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))
  }
  else None
}

fn lookup_map_group_a(name: String) -> Option[Type] {
  match lookup_mapbuilder_new(name) {
    Some(t) => Some(t),
    None => match lookup_mapbuilder_set(name) {
      Some(t) => Some(t),
      None => match lookup_mapbuilder_freeze(name) {
        Some(t) => Some(t),
        None => lookup_map_get(name)
      }
    }
  }
}

export fn lookup_map(name: String) -> Option[Type] {
  match lookup_map_group_a(name) {
    Some(t) => Some(t),
    None => lookup_map_group_b(name)
  }
}
