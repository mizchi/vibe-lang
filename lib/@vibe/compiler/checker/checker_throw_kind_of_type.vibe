//# Functions

export fn min_int(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

// Forward the established checker API to its owning package.
export fn attach_unlocated_decl_name_marker(errors: Array[String], from: Int, name: String) -> Unit {
  diagnostics_attach_unlocated_decl_name_marker(errors, from, name)
}

/// #2125: the env key prefix under which an `impl` method's body carries the
/// trait type parameters its signature may legally leave unbound. One key per
/// NAME, bound only around the value being checked -- never into the
/// environment the statement returns -- so it cannot reach a published or
/// cached env.
export let trait_erased_type_param_prefix: String = "__trait_erased_tp__"

/// True when some entry of `methods` declares a method named `method_name`.
fn trait_methods_declare(methods: Array[(String, Array[TypeExpr], TypeExpr)], method_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(methods) && !found {
    let (mname, _, _) = Array::get(methods, i)
    if mname == method_name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// True when `env` records an impl of `trait_name` for the type named
/// `type_name` -- the binder that licenses the trait's erased parameters
/// inside that impl's methods.
fn env_has_trait_impl_for(env: TypeEnv, trait_name: String, type_name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitImpl(tn, target, rest) => (tn == trait_name && type_constructor_name(target) == type_name) || env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTraitImplGen(tn, _, _, target, rest) => (tn == trait_name && type_constructor_name(target) == type_name) || env_has_trait_impl_for(rest, trait_name, type_name),
    EnvShowWrappers(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvMutCell(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvTypeDefs(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvCached(_, _, rest) => env_has_trait_impl_for(rest, trait_name, type_name),
    EnvFlat(_) => false
  }
}

fn collect_impl_erased_type_params(chain: TypeEnv, full: TypeEnv, type_name: String, method_name: String, out: Array[String]) -> Unit {
  match chain {
    EnvEmpty => (),
    EnvBind(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTraitDef(trait_name, params, _, methods, rest, header_params, _) => {
      if trait_methods_declare(methods, method_name) && env_has_trait_impl_for(full, trait_name, type_name) {
        let mut pi = 0
        while pi < Array::length(params) {
          Array::push(out, Array::get(params, pi))
          pi = pi + 1
        }
        let mut hi = 0
        while hi < Array::length(header_params) {
          Array::push(out, Array::get(header_params, hi))
          hi = hi + 1
        }
        // `Self` is erased the same way (Codex round 4 on #2147): the
        // trait-dict desugar copies the trait signature's parameter types onto
        // the lowered impl-method lambda, so a genuine impl method's `self`
        // parameter arrives annotated `Self` with no binder of its own.
        // Outside this provenance `Self` is a wildcard and is reported.
        Array::push(out, "Self")
      } else {
        ()
      }
      collect_impl_erased_type_params(rest, full, type_name, method_name, out)
    },
    EnvTraitImpl(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTraitImplGen(_, _, _, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvShowWrappers(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvMutCell(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvTypeDefs(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvCached(_, _, rest) => collect_impl_erased_type_params(rest, full, type_name, method_name, out),
    EnvFlat(_) => ()
  }
}

/// #2125: bind the erased type parameters an IMPL METHOD's signature may
/// legally spell without a binder of its own -- the `T` of
/// `trait Iterator[T]` in `impl Iterator for LazyIter { next(self) ->
/// Option[(T, LazyIter)] }`. The uniform representation erases those
/// parameters and `relax_unknown_named` relaxes every use to `CtUnknown`, so
/// they resolve to nothing and look exactly like a typo.
///
/// Codex on #2147 (round 2): PROVENANCE, not a name shape. `parse_impl_methods`
/// lowers an impl to `let <Type>::<method> = (..) -> ..` emitted after its
/// `SImpl`, so the impl is already in the env when the method is checked --
/// this asks the env the question the impl answers: does a trait in scope
/// declare a method of THIS name, carry type parameters, and have an impl for
/// THIS type? A qualified name alone is not that question, and treating it as
/// one exempted every associated function: `fn Array::bad(x: T) -> Int { 1 }`
/// compiled clean whenever any in-scope trait declared a `T` (measured).
export fn trait_erased_type_param_env(env: TypeEnv, binding_name: String) -> TypeEnv {
  let sep = String::index_of(binding_name, "::")
  if sep < 0 {
    env
  } else {
    let type_name = impl_method_owner_head(String::substring(binding_name, 0, sep))
    let method_name = String::substring(binding_name, sep + 2, String::length(binding_name))
    let names = array_empty()
    collect_impl_erased_type_params(env, env, type_name, method_name, names)
    let mut out = env
    let mut i = 0
    while i < Array::length(names) {
      out = env_bind(out, String::concat(trait_erased_type_param_prefix, Array::get(names, i)), CtUnit)
      i = i + 1
    }
    out
  }
}

/// #2125: report every type name in `te` that resolves to NOTHING, so a typo
/// stops behaving as a wildcard. `resolve_type_expr_shadowed` turns such a
/// name into `CtNamed(name, [])` -- the same shape as an un-instantiated
/// generic formal, whose unify failures `check_assignable` must tolerate so as
/// not to over-reject polymorphic code.
///
/// Every exemption below is a BINDER in scope for this annotation, which is
/// the whole rule -- an unresolved name that no binder introduces is a typo:
///
///   1. a type formal. `shadow` is not the authority on what one is: a lambda
///      nested in a generic function resolves its own parameters with its OWN
///      (empty) `tparams`, so the enclosing `T` is invisible there. The env is
///      -- whichever binder introduced the formal bound it to a `CtVar`, which
///      is exactly what `resolve_tparams_in` reads.
///   2. a trait's own erased type parameter, and only where an actual IMPL
///      binds it -- see `trait_erased_type_param_env`, which asks the env for
///      the impl rather than inferring one from the binding's name.
///
/// Those two are TYPES, so they are exempt wherever a type may appear. The
/// other two binders are NOT types, so their exemption is positional as well
/// as name-based -- `collect_unknown_type_names_regionwise` accepts them only
/// in a region-argument slot (Codex round 3 on #2147; before that,
/// `fn f(x: r) -> Int with r { 1 }` accepted both `f(1)` and `f("s")`):
///
///   3. a REGION TOKEN bound by an enclosing `region r { .. }` (ADR-0090),
///      spelled in the region slot of `MutList[Int, r]`. Recognised by the
///      rigid skolem the region binder binds it to (`#region_<n>`, a name no
///      source can spell), NOT by "some value has this name" -- that would let
///      `let Intt = 1` excuse `x: Intt`.
///   4. a region ROW VARIABLE declared by this very signature:
///      `fn fill(l: MutList[Int, r]) -> Unit with r`. Nothing binds `r` as a
///      value there; the binder is the row, so the call site passes its
///      variables in `row_binders`.
/// Collect type applications whose head the caller classifies as a type
/// formal (`F[A]` under `[F, A]`). Used to detect mixed-kind (`F` and
/// `F[A]` together). Constructor-only `F[A]` is well-kinded HKT.
export fn collect_formal_applications_by(te: TypeExpr, is_formal: (String) -> Bool, out: Array[String]) -> Unit {
  collect_formal_kind_uses(te, is_formal, out, array_empty())
}

// Forward the established checker API to its owning package.
export fn formal_application_error(fname: String, where_label: String) -> String {
  annotations_formal_application_error(fname, where_label)
}

// Forward the established checker API to its owning package.
export fn report_formal_applications_across(tes: Array[TypeExpr], formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  annotations_report_formal_applications_across(tes, formals, where_label, errors)
}

/// #2268: the reporting face of `collect_formal_applications_by`. `formals`
/// must be the declaration's OWN type binders -- never the merged shadow
/// `report_unknown_type_names` takes, which also carries deferred
/// cross-package names (`Map` in a `.vpkg`-derived struct) that are types,
/// not formals (the Codex round-2 false positive on #2267: every
/// `Map[String, String]` field in `@vibe/http`'s synthesized types was
/// rejected) -- and never an env lookup: a VALUE binding whose type is a
/// `CtVar` is indistinguishable from a type formal by env alone, so
/// `fn f[T](Array: T, xs: Array[Int])` would reject the valid builtin head
/// (Codex round 4). Binder provenance is the only test. The one
/// non-declaration site -- a let annotation inside a generic fn -- is
/// covered separately through the `fapp_formal_marker_prefix` markers the
/// EFn arm binds (Codex round 5), which are also binder provenance.
export fn report_formal_applications(te: TypeExpr, formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  let tes = array_empty()
  Array::push(tes, te)
  report_formal_applications_across(tes, formals, where_label, errors)
  report_kinded_formal_applications(te, formals, where_label, errors)
}

export fn formals_source_arity(formals: Array[String], name: String) -> Int {
  let mut i = 0
  let mut arity = 0 - 1
  while i < Array::length(formals) {
    if type_param_name(Array::get(formals, i)) == name {
      arity = type_param_arity(Array::get(formals, i))
    } else {
      ()
    }
    i = i + 1
  }
  arity
}

// Forward the established checker API to its owning package.
export fn report_map_key_types(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], where_label: String, errors: Array[String]) -> Unit {
  annotations_report_map_key_types(te, defs, shadow, where_label, errors)
}

fn report_unknown_type_names_only(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  // Which of the unresolved names are region-ish binders at all. Asked over
  // the name candidates first because the positional walk below takes a set,
  // and `#region_` skolem membership is an env question this file owns.
  let candidates = array_empty()
  collect_unknown_type_names(te, defs, shadow, candidates)
  let region_binders = array_empty()
  let mut ci = 0
  while ci < Array::length(candidates) {
    let candidate = Array::get(candidates, ci)
    let is_region_token = match env_lookup(env, candidate) {
      Some(t) => match t {
        CtNamed(bound_name, _) => String::starts_with(bound_name, "#region_"),
        _ => false
      },
      None => false
    }
    if (is_region_token || checker_string_array_has(row_binders, candidate)) && !checker_string_array_has(region_binders, candidate) {
      Array::push(region_binders, candidate)
    } else {
      ()
    }
    ci = ci + 1
  }
  let out = array_empty()
  collect_unknown_type_names_regionwise(te, defs, shadow, region_binders, out)
  let mut i = 0
  while i < Array::length(out) {
    let name = Array::get(out, i)
    let is_type_formal = match env_lookup(env, name) {
      Some(t) => match t {
        CtVar(_) => true,
        CtNamed(bound_name, bargs) => Array::length(bargs) == 0 && (bound_name == name || bound_name == String::concat("#hktformal.", name)),
        _ => false
      },
      None => false
    }
    let trait_erased_by_impl = match env_lookup(env, String::concat(trait_erased_type_param_prefix, name)) {
      Some(_) => true,
      None => false
    }
    if is_type_formal || trait_erased_by_impl {
      ()
    } else {
      Array::push(errors, String::concat(String::concat(String::concat("unknown type `", name), "` in "), where_label))
    }
    i = i + 1
  }
}

/// Reports unresolved type names while leaving Map-key and structural-head
/// arity validation to a later completed-definition pass. Type declaration
/// payloads use this because a nested declaration can still claim a spelling
/// that currently looks like a compiler-owned builtin head.
export fn report_unknown_type_names_deferred_validation(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_unknown_type_names_only(te, defs, shadow, env, row_binders, where_label, errors)
  // A struct field's or enum payload's function row names exception kinds too.
  // Their resolutions are recorded once the declarations are complete
  // (`record_decl_exception_kinds`): `shadow` here also holds the names of
  // types declared later, which are not formals.
  report_exception_kinds_in_type_expr(te, defs, shadow, env, errors, false)
}

/// #3028 / #3033: record how every exception kind in a type declaration's
/// function rows resolves -- an alias body, a struct field, an enum payload --
/// with the declaration's own type parameters as the formals, so the
/// declaration's published types carry the resolved kinds.
///
/// `complete` is true once the statement list's type declarations are all in
/// `defs`: then an alias body's kinds are also CHECKED as types (the one
/// declaration whose rows went unchecked; earlier, a later alias would read
/// as unknown), and an EXPORTED declaration whose row names a kind no row can
/// spell is refused (`refuse_unpublishable_exception_row`). Called per
/// declaration as it is checked, with `complete` false, and for the whole
/// list at the phase boundary.
export fn record_decl_exception_kinds(stmts: Array[Stmt], defs: Array[TypeDef], env: TypeEnv, errors: Array[String], complete: Bool) -> Unit {
  let scratch = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STypeAlias(exported, name, params, te) => {
        report_exception_kinds_in_type_expr(te, defs, params, env, if complete {
          errors
        } else {
          scratch
        }, true)
        if complete && exported {
          refuse_unpublishable_exception_row(resolve_type_expr_shadowed(te, defs, params), name, name, defs, errors)
        } else {
          ()
        }
      },
      SStruct(exported, name, fields, _, _, params) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fte) = Array::get(fields, fi)
          report_exception_kinds_in_type_expr(fte, defs, params, env, scratch, true)
          if complete && exported {
            refuse_unpublishable_exception_row(resolve_type_expr_shadowed(fte, defs, params), String::concat(name, String::concat(".", fname)), name, defs, errors)
          } else {
            ()
          }
          fi = fi + 1
        }
      },
      SEnum(exported, name, params, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, payloads) = Array::get(variants, vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            report_exception_kinds_in_type_expr(Array::get(payloads, pi), defs, params, env, scratch, true)
            if complete && exported {
              refuse_unpublishable_exception_row(resolve_type_expr_shadowed(Array::get(payloads, pi), defs, params), String::concat(name, String::concat("::", vname)), name, defs, errors)
            } else {
              ()
            }
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

export fn report_unknown_type_names(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_map_key_types(te, defs, shadow, where_label, errors)
  report_unknown_type_names_only(te, defs, shadow, env, row_binders, where_label, errors)
  report_exception_kinds_in_type_expr(te, defs, shadow, env, errors, true)
}

/// #3017: the exception kind a resolved payload type names, spelled the way a
/// kinded row writes it (`Int`, `Array[Int]`, `Option[P]`, `P`). "" for
/// anything else -- an unresolved variable, a type formal, a tuple -- which
/// leaves the syntactic answer standing. A generic nominal keeps its
/// arguments (`Box[Int]`, #3029). A function type is spelled
/// `(Int) -> Int` (#3033): it had no kind, so a function payload was an
/// erased requirement that `with Exception[Callback]` could never cover.
///
/// This is also how the checker spells a written kind's RESOLUTION
/// (`record_exception_kind_resolution`), so a payload and a row that name one
/// type compare equal.
export fn throw_kind_of_type(t: Type) -> String {
  match t {
    CtNamed(n, args) => if Array::length(args) == 0 || String::starts_with(n, "#") || String::starts_with(n, "__") {
      ""
    } else {
      let parts = array_empty()
      let mut ok = true
      let mut ai = 0
      while ai < Array::length(args) {
        let k = throw_kind_of_type(Array::get(args, ai))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, k)
        ai = ai + 1
      }
      if ok {
        String::concat(n, String::concat("[", String::concat(String::join(parts, ", "), "]")))
      } else {
        ""
      }
    },
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtBytes => "Bytes",
    CtStruct(n) => if String::starts_with(n, "#") {
      ""
    } else {
      n
    },
    CtEnum(n) => n,
    CtArray(e) => {
      let k = throw_kind_of_type(e)
      if String::length(k) > 0 {
        String::concat("Array[", String::concat(k, "]"))
      } else {
        ""
      }
    },
    CtOption(e) => {
      let k = throw_kind_of_type(e)
      if String::length(k) > 0 {
        String::concat("Option[", String::concat(k, "]"))
      } else {
        ""
      }
    },
    CtFn(params, ret, row) => {
      let parts = array_empty()
      let mut ok = true
      let mut pi = 0
      while pi < Array::length(params) {
        let k = throw_kind_of_fn_slot(Array::get(params, pi))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, k)
        pi = pi + 1
      }
      let rk = throw_kind_of_fn_slot(ret)
      if ok && String::length(rk) > 0 {
        let head = String::concat("(", String::concat(String::join(parts, ", "), String::concat(") -> ", rk)))
        // The checker's own provenance labels (`#param[0]`, `#capture[..]`)
        // are not part of the type a row names.
        // A row is a SET: `with Fs + Env` and `with Env + Fs` name one type,
        // so the labels are sorted. They are joined the way a row is WRITTEN,
        // so the kind stays the spelling of a type a reader could declare.
        let labels = array_empty()
        match row {
          Some(r) => {
            let parts = row_items_top_level(r)
            let mut li = 0
            while li < Array::length(parts) {
              let l = Array::get(parts, li)
              if !String::starts_with(l, "#") {
                insert_sorted_label(labels, l)
              } else {
                ()
              }
              li = li + 1
            }
          },
          None => ()
        }
        if Array::length(labels) > 0 {
          String::concat(head, String::concat(" with ", String::join(labels, " + ")))
        } else {
          head
        }
      } else {
        ""
      }
    },
    _ => ""
  }
}

/// A parameter or result of a function-type kind: `Unit` has a spelling
/// there even though a bare `Unit` payload keeps having none.
fn throw_kind_of_fn_slot(t: Type) -> String {
  match t {
    CtUnit => "Unit",
    // A tuple is no kind on its own (a row cannot spell one), but it is a
    // parameter or result a function-type kind has to spell, or two aliases
    // of `((Int, Int)) -> Int` never meet.
    CtTuple(elems) => {
      let parts = array_empty()
      let mut ok = Array::length(elems) > 0
      let mut i = 0
      while i < Array::length(elems) {
        let k = throw_kind_of_fn_slot(Array::get(elems, i))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, k)
        i = i + 1
      }
      if ok {
        String::concat("(", String::concat(String::join(parts, ", "), ")"))
      } else {
        ""
      }
    },
    _ => throw_kind_of_type(t)
  }
}

fn insert_sorted_label(labels: Array[String], l: String) -> Unit {
  Array::push(labels, l)
  let mut i = Array::length(labels) - 1
  while i > 0 && str_lt(l, Array::get(labels, i - 1)) {
    Array::set(labels, i, Array::get(labels, i - 1))
    i = i - 1
  }
  Array::set(labels, i, l)
}

/// The KIND of an exception label names a type, so it gets the unknown-name
/// check an annotation gets. A handler arm's kind already did
/// (`an exception kind`); a function's `with` row, the row of a function type
/// written in an annotation, and a struct field's or enum payload's row did
/// not, so `fn f() -> Int with Exception[Nope]` was accepted with no `Nope`
/// anywhere. A kind the type parser cannot read is left alone. Type formals
/// in a kind are `collect_formal_exception_kind_errors`' subject, and are
/// exempt here through `shadow` and the env.
/// `record_kinds`: also record each kind's resolution (#3033), with `shadow` as the
/// formals in scope.
/// A generic effect's type argument in the same row is checked too
/// (`report_generic_effect_row_arg_names`, #3319).
export fn report_exception_kinds_in_row(row: Option[String], defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String], record_kinds: Bool) -> Unit {
  let labels = row_labels(row)
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, i)
    let kind = exception_label_kind(label)
    if is_exception_label(label) && String::length(kind) > 0 {
      let parsed = handle {
        let (kind_te, _) = parse_type(lex(kind), 0)
        Some(kind_te)
      } with { Exception::Throw(_unreadable) => None }
      match parsed {
        Some(kind_te) => {
          report_map_key_types(kind_te, defs, shadow, "an exception kind", errors)
          report_unknown_type_names_only(kind_te, defs, shadow, env, array_empty(), "an exception kind", errors)
          if record_kinds {
            record_exception_kind_resolution(kind, kind_te, defs, formal_shadow(kind_te, env, shadow))
          } else {
            ()
          }
        },
        None => ()
      }
    } else if !is_exception_label(label) {
      report_generic_effect_row_arg_names(label, defs, shadow, env, errors)
    } else {
      ()
    }
    i = i + 1
  }
}

/// #3319: the type argument of a declared generic effect in a row
/// (`with Box[Nope]`) names a type, so it gets the unknown-name check an
/// annotation gets. Nothing looked at it: the row binder read `Nope` as a bare
/// name, the perform kept a fresh instantiation, and the program checked clean
/// as if the row said `with Box`. A kinded parameter (`F` of `Read[F[_]]`)
/// takes a constructor, and the row binder reports its argument
/// (`kinded_row_inst`); a label of an undeclared or non-generic effect is the
/// row-item check's subject. Formals in scope are exempt through `shadow` and
/// the env, as in an annotation.
fn report_generic_effect_row_arg_names(label: String, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String]) -> Unit {
  let bi = String::index_of(label, "[")
  if bi > 0 && String::ends_with(label, "]") {
    let plain_generic = match find_typedef(defs, String::trim(label[0: bi])) {
      Some(TDEffect(_, _, etps)) => Array::length(etps) == 1 && type_param_arity(Array::get(etps, 0)) == 0,
      _ => false
    }
    if plain_generic {
      let parsed = handle {
        let (arg_te, _) = parse_type(lex(label[bi + 1: String::length(label) - 1]), 0)
        Some(arg_te)
      } with { Exception::Throw(_unreadable) => None }
      match parsed {
        Some(arg_te) => report_unknown_type_names_only(arg_te, defs, shadow, env, array_empty(), String::concat("the effect row item `", String::concat(label, "` (declare or import the type, or fix its spelling)")), errors),
        None => ()
      }
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #3033: record how the kind written `kind` (parsed as `kind_te`) resolves,
/// so every comparison of kinds in this module sees the type it names
/// (`exception_kinds_same`): `Es[IoErr]` with `type Es[T] = Array[T]` is
/// `Array[IoErr]`. `formals` are the type formals in scope; a kind that names
/// one is POISONED instead -- a formal is not the type a same-named alias or
/// import denotes, so that spelling keeps being compared as written. A kind
/// whose type has no kind spelling (a tuple) records nothing.
export fn record_exception_kind_resolution(kind: String, kind_te: TypeExpr, defs: Array[TypeDef], formals: Array[String]) -> Unit {
  if type_expr_names_any(kind_te, formals) {
    exception_kind_resolution_record(kind, "")
  } else {
    let resolved = throw_kind_of_type(resolve_type_expr_shadowed(kind_te, defs, formals))
    if String::length(resolved) > 0 {
      exception_kind_resolution_record(kind, resolved)
    } else {
      ()
    }
  }
}

/// #3033 / #3028: `t` with every function row's exception kinds written as
/// the types they resolve to (`exception_row_resolved`). A declaration's
/// PUBLISHED type goes through this -- a binding, a struct field, an enum
/// payload and its constructor, a type alias's body -- so a module importing
/// it compares types, not a kind spelled through an alias that is private to
/// this module (or means another type in the importer).
export fn type_exception_rows_resolved(t: Type) -> Type {
  if exception_kind_resolution_count() == 0 {
    t
  } else {
    type_exception_rows_resolved_walk(t)
  }
}

fn type_exception_rows_resolved_walk(t: Type) -> Type {
  match t {
    CtFn(params, ret, row) => CtFn(for p in params {
      type_exception_rows_resolved_walk(p)
    }, type_exception_rows_resolved_walk(ret), match row {
      Some(r) => Some(exception_row_resolved(r)),
      None => None
    }),
    CtForAll(ids, bounds, body) => CtForAll(ids, bounds, type_exception_rows_resolved_walk(body)),
    CtArray(e) => CtArray(type_exception_rows_resolved_walk(e)),
    CtOption(e) => CtOption(type_exception_rows_resolved_walk(e)),
    CtTuple(items) => CtTuple(for item in items {
      type_exception_rows_resolved_walk(item)
    }),
    CtNamed(n, args) => if Array::length(args) == 0 {
      t
    } else {
      CtNamed(n, for a in args {
        type_exception_rows_resolved_walk(a)
      })
    },
    CtApplied(head, args) => CtApplied(type_exception_rows_resolved_walk(head), for a in args {
      type_exception_rows_resolved_walk(a)
    }),
    CtRecord(fields) => CtRecord(for field in fields {
      let (fname, fty) = field
      (fname, type_exception_rows_resolved_walk(fty))
    }),
    _ => t
  }
}

/// #3033 / #3028: refuse an EXPORTED type whose function row names an
/// exception kind through a type alias that resolves to a type no row can
/// spell -- a tuple (`type Pair = (Int, Int)`), or anything with a comma,
/// since rows are split on commas. Its published row would keep the alias
/// NAME, which an importer cannot resolve (or resolves to its own type of
/// that name). `owner` names the export in the message (`f`, `S.field`,
/// `E::Variant`); `anchor` is the declaration name the diagnostic points at.
export fn refuse_unpublishable_exception_row(t: Type, owner: String, anchor: String, defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let found = array_empty()
  collect_unpublishable_exception_kinds(t, defs, found)
  if Array::length(found) > 0 {
    let (kind, shown) = Array::get(found, 0)
    Array::push(errors, String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat("`Exception[", kind), "]` in the row of exported `"), owner), "`: `"), kind), "` is `"), shown), "`, which a published row cannot spell -- throw a struct or enum that wraps it instead [@fn="), anchor), "]"))
  } else {
    ()
  }
}

fn collect_unpublishable_exception_kinds(t: Type, defs: Array[TypeDef], out: Array[(String, String)]) -> Unit {
  match t {
    CtFn(params, ret, row) => {
      match row {
        Some(r) => {
          let kinds = exception_row_kinds(r)
          let mut i = 0
          while i < Array::length(kinds) {
            let kind = Array::get(kinds, i)
            let resolved = exception_kind_resolution(kind)
            if String::length(resolved) > 0 && !String::contains(resolved, ",") {
              ()
            } else {
              match exception_kind_through_alias(kind, defs) {
                Some(shown) => Array::push(out, (kind, shown)),
                None => ()
              }
            }
            i = i + 1
          }
        },
        None => ()
      }
      let mut pi = 0
      while pi < Array::length(params) {
        collect_unpublishable_exception_kinds(Array::get(params, pi), defs, out)
        pi = pi + 1
      }
      collect_unpublishable_exception_kinds(ret, defs, out)
    },
    CtForAll(_, _, body) => collect_unpublishable_exception_kinds(body, defs, out),
    CtArray(e) => collect_unpublishable_exception_kinds(e, defs, out),
    CtOption(e) => collect_unpublishable_exception_kinds(e, defs, out),
    CtTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_unpublishable_exception_kinds(Array::get(items, i), defs, out)
        i = i + 1
      }
    },
    CtNamed(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_unpublishable_exception_kinds(Array::get(args, i), defs, out)
        i = i + 1
      }
    },
    CtApplied(head, args) => {
      collect_unpublishable_exception_kinds(head, defs, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_unpublishable_exception_kinds(Array::get(args, i), defs, out)
        i = i + 1
      }
    },
    CtRecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, i)
        collect_unpublishable_exception_kinds(fty, defs, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// When `kind` names a type ALIAS of `defs` anywhere in its spelling, the
/// type it resolves to, as printed; None otherwise (a kind with no alias in
/// it publishes the names it was written with, which are the types' own).
fn exception_kind_through_alias(kind: String, defs: Array[TypeDef]) -> Option[String] {
  let parsed = handle {
    let (kind_te, _) = parse_type(lex(kind), 0)
    Some(kind_te)
  } with { Exception::Throw(_unreadable) => None }
  match parsed {
    Some(kind_te) => if type_expr_names_alias(kind_te, defs) {
      Some(type_to_string(resolve_type_expr(kind_te, defs)))
    } else {
      None
    },
    None => None
  }
}

fn type_expr_names_alias(te: TypeExpr, defs: Array[TypeDef]) -> Bool {
  let is_alias = (n: String) -> Bool {
    match find_typedef(defs, n) {
      Some(TDAlias(_, _, _)) => true,
      _ => false
    }
  }
  match te {
    TyName(n) => is_alias(n),
    TyApp(n, args) => {
      let mut found = is_alias(n)
      let mut i = 0
      while i < Array::length(args) && !found {
        found = type_expr_names_alias(Array::get(args, i), defs)
        i = i + 1
      }
      found
    },
    TyTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) && !found {
        found = type_expr_names_alias(Array::get(items, i), defs)
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = type_expr_names_alias(ret, defs)
      let mut i = 0
      while i < Array::length(params) && !found {
        found = type_expr_names_alias(Array::get(params, i), defs)
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

/// Does `te` name any of `names` (as a type name or an applied head)?
fn type_expr_names_any(te: TypeExpr, names: Array[String]) -> Bool {
  if Array::length(names) == 0 {
    false
  } else {
    match te {
      TyName(n) => checker_string_array_has(names, n),
      TyApp(n, args) => {
        let mut found = checker_string_array_has(names, n)
        let mut i = 0
        while i < Array::length(args) && !found {
          found = type_expr_names_any(Array::get(args, i), names)
          i = i + 1
        }
        found
      },
      TyTuple(items) => {
        let mut found = false
        let mut i = 0
        while i < Array::length(items) && !found {
          found = type_expr_names_any(Array::get(items, i), names)
          i = i + 1
        }
        found
      },
      TyFn(params, ret, _) => {
        let mut found = type_expr_names_any(ret, names)
        let mut i = 0
        while i < Array::length(params) && !found {
          found = type_expr_names_any(Array::get(params, i), names)
          i = i + 1
        }
        found
      },
      TyUnit => false
    }
  }
}

/// The rows of every function type written inside an annotation, checked by
/// `report_exception_kinds_in_row`.
fn report_exception_kinds_in_type_expr(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String], record_kinds: Bool) -> Unit {
  match te {
    TyApp(_, targs) => {
      let mut i = 0
      while i < Array::length(targs) {
        report_exception_kinds_in_type_expr(Array::get(targs, i), defs, shadow, env, errors, record_kinds)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        report_exception_kinds_in_type_expr(Array::get(elems, i), defs, shadow, env, errors, record_kinds)
        i = i + 1
      }
    },
    TyFn(ps, ret, row) => {
      let mut i = 0
      while i < Array::length(ps) {
        report_exception_kinds_in_type_expr(Array::get(ps, i), defs, shadow, env, errors, record_kinds)
        i = i + 1
      }
      report_exception_kinds_in_type_expr(ret, defs, shadow, env, errors, record_kinds)
      report_exception_kinds_in_row(row, defs, shadow, env, errors, record_kinds)
    },
    _ => ()
  }
}

/// ADR-0090 MutBytes: reject a known-wrong receiver head instead of letting
/// codegen alias the op onto Bytes::* and reinterpret an arbitrary value as
/// a buffer pointer (Codex review on #1801). Unresolved vars and CtUnknown
/// stay tolerant -- enforcement is the "silent when unsure" side (ADR-0100).
export fn check_mutbytes_receiver(op: String, zonked: Type, errors: Array[String], callee_off: Int) -> Unit {
  match zonked {
    CtNamed(mb_name, _) => if mb_name == "MutBytes" {
      ()
    } else {
      Array::push(errors, String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(callee_off, String::length(op))))
    },
    CtVar(_) => (),
    CtUnknown => (),
    _ => Array::push(errors, String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(callee_off, String::length(op))))
  }
}

export fn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

/// Replace the abstract `Self` type (resolved as `CtNamed("Self", _)`) inside a
/// trait-method signature with the concrete receiver type, when typing a
/// `T::method` call against a bounded generic parameter T.
fn subst_self_in_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(a, self_ty)
      }
      CtNamed(n, ra)
    },
    CtApplied(head, args) => apply_type_constructor(subst_self_in_type(head, self_ty), for arg in args {
      subst_self_in_type(arg, self_ty)
    }),
    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(e, self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(p, self_ty)
    }, subst_self_in_type(ret, self_ty), eff),
    _ => ty
  }
}

/// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->
/// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that
/// resolves to a real type (primitive or declared) is kept; only truly-unknown
/// named types — the trait's own element type params, which the uniform
/// representation erases — are relaxed. (#636.)
fn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs, n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(a, defs)
        })
      } else {
        CtUnknown
      }
    },
    CtApplied(head, args) => apply_type_constructor(relax_unknown_named(head, defs), for arg in args {
      relax_unknown_named(arg, defs)
    }),
    CtArray(e) => CtArray(relax_unknown_named(e, defs)),
    CtOption(e) => CtOption(relax_unknown_named(e, defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(e, defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(p, defs)
    }, relax_unknown_named(r, defs), eff),
    _ => ty
  }
}

fn replace_trait_bound_vars_from_env(ty: Type, env: TypeEnv) -> Type {
  match ty {
    CtNamed(name, args) => if Array::length(args) == 0 {
      match env_lookup(env, name) {
        Some(CtVar(id)) => CtVar(id),
        _ => ty
      }
    } else {
      CtNamed(name, for arg in args {
        replace_trait_bound_vars_from_env(arg, env)
      })
    },
    CtApplied(head, args) => apply_type_constructor(replace_trait_bound_vars_from_env(head, env), for arg in args {
      replace_trait_bound_vars_from_env(arg, env)
    }),
    CtArray(elem) => CtArray(replace_trait_bound_vars_from_env(elem, env)),
    CtOption(elem) => CtOption(replace_trait_bound_vars_from_env(elem, env)),
    CtTuple(items) => CtTuple(for item in items {
      replace_trait_bound_vars_from_env(item, env)
    }),
    CtFn(params, ret, effect) => CtFn(for param in params {
      replace_trait_bound_vars_from_env(param, env)
    }, replace_trait_bound_vars_from_env(ret, env), effect),
    _ => ty
  }
}

let trait_bound_self_marker: String = "$trait_bound_self$"

fn bind_trait_bound_self_type_expr(te: TypeExpr, binder: String) -> TypeExpr {
  match te {
    TyName(name) => if name == binder {
      TyName(trait_bound_self_marker)
    } else {
      te
    },
    TyApp(name, args) => TyApp(if name == binder {
      trait_bound_self_marker
    } else {
      name
    }, for arg in args {
      bind_trait_bound_self_type_expr(arg, binder)
    }),
    TyTuple(items) => TyTuple(for item in items {
      bind_trait_bound_self_type_expr(item, binder)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      bind_trait_bound_self_type_expr(param, binder)
    }, bind_trait_bound_self_type_expr(ret, binder), effect),
    TyUnit => TyUnit
  }
}

export fn bind_trait_bound_self_reference(key: String, binder: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => trait_ref_key(bind_trait_bound_self_type_expr(reference, binder)),
    None => key
  }
}

fn trait_bound_vid_prefix() -> String {
  "#tpvid."
}

fn bind_trait_bound_tparam_name(name: String, tparams: Array[String], ids: Array[Int]) -> String {
  if name == trait_bound_self_marker {
    name
  } else {
    let mut i = 0
    let mut out = name
    while i < Array::length(tparams) && i < Array::length(ids) {
      if type_param_name(Array::get(tparams, i)) == name {
        out = String::concat(trait_bound_vid_prefix(), __to_string(Array::get(ids, i)))
      } else {
        ()
      }
      i = i + 1
    }
    out
  }
}

fn bind_trait_bound_tparam_names(te: TypeExpr, tparams: Array[String], ids: Array[Int]) -> TypeExpr {
  match te {
    TyName(name) => {
      let bound = bind_trait_bound_tparam_name(name, tparams, ids)
      if bound == name {
        te
      } else {
        TyName(bound)
      }
    },
    TyApp(name, args) => TyApp(bind_trait_bound_tparam_name(name, tparams, ids), for arg in args {
      bind_trait_bound_tparam_names(arg, tparams, ids)
    }),
    TyTuple(items) => TyTuple(for item in items {
      bind_trait_bound_tparam_names(item, tparams, ids)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      bind_trait_bound_tparam_names(param, tparams, ids)
    }, bind_trait_bound_tparam_names(ret, tparams, ids), effect),
    TyUnit => TyUnit
  }
}

export fn bind_trait_bound_tparams(key: String, tparams: Array[String], ids: Array[Int]) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => trait_ref_key(bind_trait_bound_tparam_names(reference, tparams, ids)),
    None => key
  }
}

fn parse_trait_bound_vid(name: String) -> Option[Int] {
  let prefix = trait_bound_vid_prefix()
  if !String::starts_with(name, prefix) {
    None
  } else {
    let rest = String::substring(name, String::length(prefix), String::length(name))
    if String::length(rest) == 0 {
      None
    } else {
      let mut i = 0
      let mut n = 0
      let mut ok = true
      while i < String::length(rest) && ok {
        let c = String::char_code_at(rest, i)
        if c >= '0' && c <= '9' {
          n = n * 10 + c - '0'
        } else {
          ok = false
        }
        i = i + 1
      }
      if ok {
        Some(n)
      } else {
        None
      }
    }
  }
}

fn replace_trait_bound_self_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(name, args) => if name == trait_bound_self_marker {
      if Array::length(args) == 0 {
        self_ty
      } else {
        apply_type_constructor(self_ty, for arg in args {
          replace_trait_bound_self_type(arg, self_ty)
        })
      }
    } else {
      CtNamed(name, for arg in args {
        replace_trait_bound_self_type(arg, self_ty)
      })
    },
    CtApplied(head, args) => apply_type_constructor(replace_trait_bound_self_type(head, self_ty), for arg in args {
      replace_trait_bound_self_type(arg, self_ty)
    }),
    CtArray(elem) => CtArray(replace_trait_bound_self_type(elem, self_ty)),
    CtOption(elem) => CtOption(replace_trait_bound_self_type(elem, self_ty)),
    CtTuple(items) => CtTuple(for item in items {
      replace_trait_bound_self_type(item, self_ty)
    }),
    CtFn(params, ret, effect) => CtFn(for param in params {
      replace_trait_bound_self_type(param, self_ty)
    }, replace_trait_bound_self_type(ret, self_ty), effect),
    _ => ty
  }
}

fn trait_bound_type_expr(ty: Type) -> Option[TypeExpr] {
  match ty {
    CtInt => Some(TyName("Int")),
    CtDouble => Some(TyName("Double")),
    CtBool => Some(TyName("Bool")),
    CtString => Some(TyName("String")),
    CtChar => Some(TyName("Char")),
    CtBytes => Some(TyName("Bytes")),
    CtUnit => Some(TyUnit),
    CtArray(elem) => match trait_bound_type_expr(elem) {
      Some(arg) => Some(TyApp("Array", [arg])),
      None => None
    },
    CtOption(elem) => match trait_bound_type_expr(elem) {
      Some(arg) => Some(TyApp("Option", [arg])),
      None => None
    },
    CtTuple(items) => {
      let out = array_empty()
      let mut ok = true
      for item in items {
        match trait_bound_type_expr(item) {
          Some(mapped) => Array::push(out, mapped),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyTuple(out))
      } else {
        None
      }
    },
    CtFn(params, ret, effect) => {
      let out = array_empty()
      let mut ok = true
      for param in params {
        match trait_bound_type_expr(param) {
          Some(mapped) => Array::push(out, mapped),
          None => {
            ok = false
          }
        }
      }
      match trait_bound_type_expr(ret) {
        Some(mapped_ret) => if ok {
          Some(TyFn(out, mapped_ret, effect))
        } else {
          None
        },
        None => None
      }
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut ok = true
      for arg in args {
        match trait_bound_type_expr(arg) {
          Some(mapped) => Array::push(out, mapped),
          None => {
            ok = false
          }
        }
      }
      if !ok {
        None
      } else if Array::length(out) == 0 {
        Some(TyName(name))
      } else {
        Some(TyApp(name, out))
      }
    },
    CtConstructor(name, _) => Some(TyName(name)),
    CtApplied(head, args) => {
      let name = type_constructor_name(head)
      let out = array_empty()
      let mut ok = name != ""
      for arg in args {
        match trait_bound_type_expr(arg) {
          Some(mapped) => Array::push(out, mapped),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyApp(name, out))
      } else {
        None
      }
    },
    CtEnum(name) => Some(TyName(name)),
    CtStruct(name) => Some(TyName(name)),
    _ => None
  }
}

fn resolve_trait_bound_arg_expr(arg: TypeExpr, self_ty: Type, s: Subst, defs: Array[TypeDef]) -> Option[TypeExpr] {
  match arg {
    TyName(name) => if name == trait_bound_self_marker {
      trait_bound_type_expr(self_ty)
    } else match parse_trait_bound_vid(name) {
      Some(vid) => trait_bound_type_expr(subst_apply(s, CtVar(vid))),
      None => trait_bound_type_expr(replace_trait_bound_self_type(resolve_type_expr(arg, defs), self_ty))
    },
    TyApp(name, args) => {
      let resolved_head = if name == trait_bound_self_marker {
        trait_bound_type_expr(self_ty)
      } else match parse_trait_bound_vid(name) {
        Some(vid) => trait_bound_type_expr(subst_apply(s, CtVar(vid))),
        None => Some(TyName(name))
      }
      let mapped = array_empty()
      let mut ok = true
      for nested in args {
        match resolve_trait_bound_arg_expr(nested, self_ty, s, defs) {
          Some(next) => Array::push(mapped, next),
          None => {
            ok = false
          }
        }
      }
      match resolved_head {
        Some(TyName(head)) => if ok {
          trait_bound_type_expr(replace_trait_bound_self_type(resolve_type_expr(TyApp(head, mapped), defs), self_ty))
        } else {
          None
        },
        _ => None
      }
    },
    TyTuple(items) => {
      let mapped = array_empty()
      let mut ok = true
      for item in items {
        match resolve_trait_bound_arg_expr(item, self_ty, s, defs) {
          Some(next) => Array::push(mapped, next),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyTuple(mapped))
      } else {
        None
      }
    },
    TyFn(params, ret, effect) => {
      let mapped = array_empty()
      let mut ok = true
      for param in params {
        match resolve_trait_bound_arg_expr(param, self_ty, s, defs) {
          Some(next) => Array::push(mapped, next),
          None => {
            ok = false
          }
        }
      }
      match resolve_trait_bound_arg_expr(ret, self_ty, s, defs) {
        Some(next_ret) => if ok {
          Some(TyFn(mapped, next_ret, effect))
        } else {
          None
        },
        None => None
      }
    },
    TyUnit => Some(TyUnit)
  }
}

export fn resolve_trait_bound_self_reference(key: String, self_ty: Type, s: Subst, defs: Array[TypeDef]) -> String {
  match trait_ref_from_key(key) {
    Some(TyApp(name, args)) => {
      let mapped = array_empty()
      let mut ok = true
      for arg in args {
        match resolve_trait_bound_arg_expr(arg, self_ty, s, defs) {
          Some(next) => Array::push(mapped, next),
          None => {
            ok = false
          }
        }
      }
      if ok {
        trait_ref_key(TyApp(name, mapped))
      } else {
        key
      }
    },
    _ => key
  }
}

fn resolve_trait_bound_args(args: Array[TypeExpr], env: TypeEnv, defs: Array[TypeDef], self_ty: Type, params: Array[String]) -> Array[Type] {
  let resolved = for arg in args {
    replace_trait_bound_self_type(replace_trait_bound_vars_from_env(resolve_type_expr(arg, defs), env), self_ty)
  }
  resolve_type_constructor_args(params, args, resolved, defs, array_empty())
}

fn trait_bound_param_names(binders: Array[String], count: Int) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < count && i < Array::length(binders) {
    Array::push(out, Array::get(binders, i))
    i = i + 1
  }
  out
}

export fn trait_reference_display(key: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => print_type_expr(reference),
    None => key
  }
}

export fn validate_trait_reference(env: TypeEnv, key: String, context: String, errors: Array[String]) -> Unit {
  let display = trait_reference_display(key)
  let args = trait_ref_args(key)
  match trait_decl_params(env, key) {
    Some(params) => {
      if Array::length(args) > 0 && Array::length(args) != Array::length(params) {
        let counts = String::concat(__to_string(Array::length(params)), String::concat(" type argument(s), got ", __to_string(Array::length(args))))
        let site = String::concat(" in ", String::concat(context, String::concat(" `", String::concat(display, "`"))))
        Array::push(errors, String::concat("trait `", String::concat(trait_ref_name(key), String::concat("` expects ", String::concat(counts, site)))))
      } else {
        let defs = env_type_defs(env)
        let mut i = 0
        while i < Array::length(args) && i < Array::length(params) {
          report_one_type_argument_kind(trait_ref_name(key), type_param_name(Array::get(params, i)), type_param_arity(Array::get(params, i)), Array::get(args, i), defs, array_empty(), context, errors)
          i = i + 1
        }
      }
    },
    None => ()
  }
}

/// Resolve a qualified identifier `T::method` where `T` is a bounded generic
/// type parameter (`[T: Trait]`). If the head resolves to a type variable whose
/// recorded bounds include a trait declaring `method`, return that method's
/// signature with `Self` substituted by T. Returns None for any other qualified
/// name (concrete `Type::method`, module-qualified names, etc.) so the existing
/// resolution paths are untouched. (PR-3 component 2.)
export fn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let method = String::substring(name, idx + 2, String::length(name))
    match env_lookup(env, head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s, vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_key = Array::get(bounds, bi)
              let trait_name = trait_ref_name(trait_key)
              let trait_args = trait_ref_args(trait_key)
              match trait_method_sig_binders_deep(env, trait_name, method) {
                Some(sig) => {
                  // #1512: the trait header's params and the method's own
                  // generics are binders, so they must shadow `defs` —
                  // otherwise `import { Hue as T }` captures the `T` of
                  // `trait Boxed[T] { unwrap(Self) -> T }`.
                  let (params_te, ret_te, binders) = sig
                  let param_names = trait_bound_param_names(binders, Array::length(trait_args))
                  let trait_params = match trait_decl_params(env, trait_key) {
                    Some(ps) => ps,
                    None => array_empty()
                  }
                  let resolved_trait_args = resolve_trait_bound_args(trait_args, env, defs, self_ty, trait_params)
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(subst_type_params(subst_self_in_type(resolve_type_expr_shadowed(pte, defs, binders), self_ty), param_names, resolved_trait_args), defs)
                  }
                  let resolved_ret = relax_unknown_named(subst_type_params(subst_self_in_type(resolve_type_expr_shadowed(ret_te, defs, binders), self_ty), param_names, resolved_trait_args), defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}

/// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,
/// `Sh::Circle`) to the variant's constructor type, confirming that `head`
/// names a known enum that actually owns `member` (so unrelated `T::method`
/// names fall through to the `unknown name` path). Callers instantiate the
/// result exactly like a bare ident. (#672 qualified ctors.)
///
/// #1455: for a MONOMORPHIC enum the constructor type is built from `head`'s
/// own `TDEnum` rather than looked up under the BARE variant name. The old
/// `env_lookup(env, member)` made the qualifier purely cosmetic: it confirmed
/// ownership and then took whatever the flat, last-registered-wins env had
/// under `member`, so `A::Mk` and `B::Mk` resolved to the same type and a
/// qualified reference could not disambiguate anything. Building from the
/// `TDEnum` reproduces exactly what the SEnum arm binds for a local enum
/// (`CtEnum(name)` nullary, `CtFn(payloads, CtEnum(name), None)` otherwise)
/// and additionally works for an IMPORTED enum, whose bare constructors are in
/// the env but whose variant list only reaches this module through
/// `enum_def_env_name`.
///
/// A PARAMETERIZED enum validates ownership through `TDEnum` and then uses
/// the imported bare constructor's checked `CtForAll` scheme. The historical
/// `Enum::__variants__` carrier is deliberately not an authority source.
export fn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef], c: Int) -> Option[Type] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    match find_enum_typedef(defs, head) {
      Some(TDEnum(ename, params, variants)) => {
        let mut found = false
        let mut payloads = array_empty()
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          if vname == member {
            found = true
            payloads = vtypes
          } else {
            ()
          }
          vi = vi + 1
        }
        if found {
          if Array::length(params) == 0 {
            if Array::length(payloads) == 0 {
              Some(CtEnum(ename))
            } else {
              Some(CtFn(payloads, CtEnum(ename), constructor_dependency_row(Array::length(payloads))))
            }
          } else {
            // The imported bare constructor is the checked `CtForAll` scheme.
            // `Enum::__variants__` is legacy data only and is never consulted
            // for authority, so a corrupt carrier cannot override EnvTypeDefs.
            env_lookup(env, member)
          }
        } else {
          None
        }
      },
      _ => None
    }
  }
}

export fn expr_ident_name_or_empty(expr: Expr) -> String {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}

/// True when a type is fully ground (mentions no type parameter / type
/// variable). An unresolved type name resolves to `CtNamed(_, _)` (see
/// resolve_type_expr), which for a struct field or function parameter means a
/// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used
/// both to restrict record struct-identity recovery to MONOMORPHIC structs (a
/// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`
/// relies on) and to gate structural-mismatch reporting to concrete types.

// #1324 removed the #941 `railway_head` / `railway_heads_conflict` pair,
// which reported an Option-vs-Result head conflict on one railway. `Result`
// is no longer a language- or prelude-provided type, so `?`/`let*` lower only
// to `Option` and there is no second built-in monad to conflict with.
//
// The mismatch #941 was written for is still reported: a `?` / `let*`
// inside a function that does not return Option is caught by the #1947
// railway-origin hook (source-level `?` / `let*` message), not by the
// generic `return None` / `Option[?]` debris of the desugar.

/// Best-effort source anchor for a (possibly desugar-generated) expr — the
/// first real char offset found walking into the value position, or -1. The
/// railway desugar (#635) threads the `?`/`let*` operand's offset into its
/// generated `None` failure-track nodes, so a diagnostic on desugar output
/// still locates at the offending operand.
export fn railway_expr_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    EString(_, off) => off,
    EIf(_, t, els) => {
      let toff = railway_expr_off(t)
      if toff >= 0 {
        toff
      } else {
        railway_expr_off(els)
      }
    },
    ECall(callee, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(base)
    },
    EBinOp(_, lhs, _, _) => railway_expr_off(lhs),
    EMatch(scrut, _) => railway_expr_off(scrut),
    ESeq(first, _) => railway_expr_off(first),
    _ => 0 - 1
  }
}
