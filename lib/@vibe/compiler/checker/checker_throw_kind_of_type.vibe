//# Functions

export fn min_int(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

// Forward the established checker API to its owning package.
export fn attach_unlocated_decl_name_marker(errors: Array[String], from: Int, name: String) -> Unit {
  diagnostics_attach_unlocated_decl_name_marker(errors = errors, from = from, name = name)
}

/// #2125: the env key prefix under which an `impl` method's body carries the
/// trait type parameters its signature may legally leave unbound. One key per
/// NAME, bound only around the value being checked -- never into the
/// environment the statement returns -- so it cannot reach a published or
/// cached env.
export let trait_erased_type_param_prefix: String = "__trait_erased_tp__"

/// True when some entry of `methods` declares a method named `method_name`.
fn trait_methods_declare(methods: Array[(String, Array[TypeExpr], TypeExpr)], method_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(methods) && !found {
    let (mname, _, _) = Array::get(methods, at = i)
    if mname == method_name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Does the impl recorded under key `tn` (a bare trait name, or the
/// `$trait$`-prefixed applied key) belong to the trait `trait_name` names
/// AND, when the binding's owner carries an `$impl$` segment, to THAT impl?
/// `EnvTraitDef` holds the trait's head name while an impl holds the key it
/// was written with -- `impl Iter[Int] for PairIter` records the applied key,
/// and `trait_defined` compares the same way (measured: comparing the raw key
/// refused `fixtures/iterator_trait_alias_operations_test.vibe`'s `self.first`
/// as an open receiver, and, #3573, gave no applied impl's methods the
/// erasures below). The owner segment was built by `impl_method_owner` from
/// the same key, so `impl_encode_name(tn)` between `$impl$` and `$`
/// identifies the impl exactly; an owner with no segment is a plain impl of a
/// bare trait for an unapplied target, and the head is all there is to match.
export fn impl_key_matches(tn: String, trait_name: String, owner_full: String) -> Bool {
  if trait_ref_name(tn) != trait_name {
    false
  } else {
    let seg = String::index_of(owner_full, needle = "$impl$")
    if seg < 0 {
      true
    } else {
      let encoded = String::concat("$impl$", String::concat(impl_encode_name(tn), "$"))
      String::index_of(owner_full, needle = encoded) >= 0
    }
  }
}

/// The key of the impl of `trait_name` for the type named `type_name` that
/// the binding owner `owner_full` belongs to (`impl_key_matches`), when `env`
/// records one -- the binder that licenses the trait's erased parameters
/// inside that impl's methods.
fn env_trait_impl_key_for(env: TypeEnv, trait_name: String, type_name: String, owner_full: String) -> Option[String] {
  match env {
    EnvEmpty => None,
    EnvBind(_, _, rest) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvTraitDef(_, _, _, _, rest, _, _) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvTraitImpl(tn, target, rest) => if impl_key_matches(tn = tn, trait_name = trait_name, owner_full = owner_full) && type_constructor_name(target) == type_name {
      Some(tn)
    } else {
      env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full)
    },
    EnvTraitImplGen(tn, _, _, target, rest) => if impl_key_matches(tn = tn, trait_name = trait_name, owner_full = owner_full) && type_constructor_name(target) == type_name {
      Some(tn)
    } else {
      env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full)
    },
    EnvShowWrappers(_, _, rest) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvMutCell(_, _, rest) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvTypeDefs(_, _, rest) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvCached(_, _, rest) => env_trait_impl_key_for(env = rest, trait_name = trait_name, type_name = type_name, owner_full = owner_full),
    EnvFlat(_) => None
  }
}

/// #3573: whether an impl's recorded target is ONE type `Self` can stand for.
/// A bare generic head (`impl [T] Len for Array`, `impl Mappable[Option] for
/// Option`, an owner whose formals the trait erases) names a family, so its
/// `Self` is left as it was.
export fn impl_self_target_is_type(target: Type, defs: Array[TypeDef]) -> Bool {
  match target {
    CtUnknown => false,
    CtConstructor(_, _) => false,
    CtApplied(_, _) => false,
    CtNamed(name, args) => if Array::length(args) > 0 {
      !Array::any(args, f = (a) -> !impl_self_target_is_type(target = a, defs = defs))
    } else {
      let builtin_generic = match compiler_owned_type_arity(name) {
        Some(arity) => arity > 0,
        None => false
      }
      let declared_generic = match find_typedef(defs = defs, name = name) {
        Some(TDStruct(_, _, _, formals)) => Array::length(formals) > 0,
        Some(TDEnum(_, formals, _)) => Array::length(formals) > 0,
        Some(TDAlias(_, formals, _)) => Array::length(formals) > 0,
        _ => false
      }
      !builtin_generic && !declared_generic
    },
    CtArray(e) => impl_self_target_is_type(target = e, defs = defs),
    CtOption(e) => impl_self_target_is_type(target = e, defs = defs),
    CtTuple(items) => !Array::any(items, f = (i) -> !impl_self_target_is_type(target = i, defs = defs)),
    _ => true
  }
}

/// #3573: the edit for `Owner::method` when that name is unbound because the
/// method belongs to an impl that binds its methods under its own key -- an
/// applied impl (`impl It[Int] for P`) or one for an applied target (`impl
/// Tr for Box[Int]`). Two such impls may define the same method for one
/// owner, so neither binds `P::pass`, and the trait's dispatcher is the
/// spelling that reaches them. Empty for any other name.
export fn impl_method_spelling_hint(name: String, env: TypeEnv) -> String {
  let sep = String::index_of(name, needle = "::")
  if sep <= 0 || String::index_of(name, needle = "$") >= 0 {
    ""
  } else {
    impl_method_spelling_hint_walk(chain = env, full = env, owner = String::substring(name, start = 0, end = sep), method = String::substring(name, start = sep + 2, end = String::length(name)))
  }
}

fn impl_method_spelling_hint_at(full: TypeEnv, tn: String, target: Type, owner: String, method: String) -> String {
  let applied_target = match target {
    CtNamed(_, args) => Array::length(args) > 0,
    _ => false
  }
  let keyed = Array::length(trait_ref_args(tn)) > 0 || applied_target
  let trait_head = trait_ref_name(tn)
  let declares = match trait_method_sig_deep(env = full, trait_name = trait_head, method_name = method) {
    Some(_) => true,
    None => false
  }
  if keyed && declares && type_constructor_name(target) == owner {
    String::join([
      " -- `impl ",
      trait_reference_display(tn),
      " for ",
      type_to_string(target),
      "` defines `",
      method,
      "` but binds no `",
      owner,
      "::",
      method,
      "`; call it through the trait: `",
      trait_head,
      "::",
      method,
      "(..)`"
    ], sep = "")
  } else {
    ""
  }
}

fn impl_method_spelling_hint_walk(chain: TypeEnv, full: TypeEnv, owner: String, method: String) -> String {
  match chain {
    EnvEmpty => "",
    EnvBind(_, _, rest) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvTraitDef(_, _, _, _, rest, _, _) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvTraitImpl(tn, target, rest) => {
      let here = impl_method_spelling_hint_at(full = full, tn = tn, target = target, owner = owner, method = method)
      if here == "" {
        impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method)
      } else {
        here
      }
    },
    EnvTraitImplGen(tn, _, _, target, rest) => {
      let here = impl_method_spelling_hint_at(full = full, tn = tn, target = target, owner = owner, method = method)
      if here == "" {
        impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method)
      } else {
        here
      }
    },
    EnvShowWrappers(_, _, rest) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvMutCell(_, _, rest) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvTypeDefs(_, _, rest) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvCached(_, _, rest) => impl_method_spelling_hint_walk(chain = rest, full = full, owner = owner, method = method),
    EnvFlat(_) => ""
  }
}

fn collect_impl_erased_type_params(chain: TypeEnv, full: TypeEnv, type_name: String, owner_full: String, method_name: String, out: Array[String]) -> Unit {
  match chain {
    EnvEmpty => (),
    EnvBind(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvTraitDef(trait_name, params, _, methods, rest, header_params, _) => {
      let impl_key = if trait_methods_declare(methods = methods, method_name = method_name) {
        env_trait_impl_key_for(env = full, trait_name = trait_name, type_name = type_name, owner_full = owner_full)
      } else {
        None
      }
      match impl_key {
        Some(key) => {
          // An applied impl (`impl It[Int] for P`) fills the trait's own
          // parameters, so nothing erases them there: its methods write
          // `Int`, and `A` names nothing.
          if Array::length(trait_ref_args(key)) == 0 {
            let mut pi = 0
            while pi < Array::length(params) {
              Array::push(out, value = Array::get(params, at = pi))
              pi = pi + 1
            }
            let mut hi = 0
            while hi < Array::length(header_params) {
              Array::push(out, value = Array::get(header_params, at = hi))
              hi = hi + 1
            }
          } else {
            ()
          }
          // `Self` is erased the same way (Codex round 4 on #2147): the
          // trait-dict desugar copies the trait signature's parameter types
          // onto the lowered impl-method lambda, so a genuine impl method's
          // `self` parameter arrives annotated `Self` with no binder of its
          // own. Outside this provenance `Self` is a wildcard and is reported.
          // A `Self` the method WRITES in its signature is the impl's target
          // by now (`impl_self_as_target`, #3573).
          Array::push(out, value = "Self")
        },
        None => ()
      }
      collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out)
    },
    EnvTraitImpl(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvTraitImplGen(_, _, _, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvShowWrappers(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvMutCell(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvTypeDefs(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvCached(_, _, rest) => collect_impl_erased_type_params(chain = rest, full = full, type_name = type_name, owner_full = owner_full, method_name = method_name, out = out),
    EnvFlat(_) => ()
  }
}

/// #2125: bind the erased type parameters an IMPL METHOD's signature may
/// legally spell without a binder of its own -- the `T` of
/// `trait Iterator[T]` in `impl Iterator for LazyIter { next(self) ->
/// Option[(T, LazyIter)] }`. The uniform representation erases those
/// parameters and `relax_unknown_named` relaxes every use to `CtUnknown`, so
/// they resolve to nothing and look exactly like a typo.
///
/// Codex on #2147 (round 2): PROVENANCE, not a name shape. `parse_impl_methods`
/// lowers an impl to `let <Type>::<method> = (..) -> ..` emitted after its
/// `SImpl`, so the impl is already in the env when the method is checked --
/// this asks the env the question the impl answers: does a trait in scope
/// declare a method of THIS name, carry type parameters, and have an impl for
/// THIS type? A qualified name alone is not that question, and treating it as
/// one exempted every associated function: `fn Array::bad(x: T) -> Int { 1 }`
/// compiled clean whenever any in-scope trait declared a `T` (measured).
export fn trait_erased_type_param_env(env: TypeEnv, binding_name: String) -> TypeEnv {
  let sep = String::index_of(binding_name, needle = "::")
  if sep < 0 {
    env
  } else {
    let owner_full = String::substring(binding_name, start = 0, end = sep)
    let type_name = impl_method_owner_head(owner_full)
    let method_name = String::substring(binding_name, start = sep + 2, end = String::length(binding_name))
    let names = array_empty()
    collect_impl_erased_type_params(chain = env, full = env, type_name = type_name, owner_full = owner_full, method_name = method_name, out = names)
    // The impl's own target, under a name no type can spell: only it may be
    // written bare where its formals are erased (`bare_head_erased_by_impl`).
    if Array::length(names) > 0 {
      Array::push(names, value = String::concat("#owner.", type_name))
    } else {
      ()
    }
    let mut out = env
    let mut i = 0
    while i < Array::length(names) {
      out = env_bind(env = out, name = String::concat(trait_erased_type_param_prefix, Array::get(names, at = i)), ty = CtUnit)
      i = i + 1
    }
    out
  }
}

/// #2125: report every type name in `te` that resolves to NOTHING, so a typo
/// stops behaving as a wildcard. `resolve_type_expr_shadowed` turns such a
/// name into `CtNamed(name, [])` -- the same shape as an un-instantiated
/// generic formal, whose unify failures `check_assignable` must tolerate so as
/// not to over-reject polymorphic code.
///
/// Every exemption below is a BINDER in scope for this annotation, which is
/// the whole rule -- an unresolved name that no binder introduces is a typo:
///
///   1. a type formal. `shadow` is not the authority on what one is: a lambda
///      nested in a generic function resolves its own parameters with its OWN
///      (empty) `tparams`, so the enclosing `T` is invisible there. The env is
///      -- whichever binder introduced the formal bound it to a `CtVar`, which
///      is exactly what `resolve_tparams_in` reads.
///   2. a trait's own erased type parameter, and only where an actual IMPL
///      binds it -- see `trait_erased_type_param_env`, which asks the env for
///      the impl rather than inferring one from the binding's name.
///
/// Those two are TYPES, so they are exempt wherever a type may appear. The
/// other two binders are NOT types, so their exemption is positional as well
/// as name-based -- `collect_unknown_type_names_regionwise` accepts them only
/// in a region-argument slot (Codex round 3 on #2147; before that,
/// `fn f(x: r) -> Int with r { 1 }` accepted both `f(1)` and `f("s")`):
///
///   3. a REGION TOKEN bound by an enclosing `region r { .. }` (ADR-0090),
///      spelled in the region slot of `MutList[Int, r]`. Recognised by the
///      rigid skolem the region binder binds it to (`#region_<n>`, a name no
///      source can spell), NOT by "some value has this name" -- that would let
///      `let Intt = 1` excuse `x: Intt`.
///   4. a region ROW VARIABLE declared by this very signature:
///      `fn fill(l: MutList[Int, r]) -> Unit with r`. Nothing binds `r` as a
///      value there; the binder is the row, so the call site passes its
///      variables in `row_binders`.
/// Collect type applications whose head the caller classifies as a type
/// formal (`F[A]` under `[F, A]`). Used to detect mixed-kind (`F` and
/// `F[A]` together). Constructor-only `F[A]` is well-kinded HKT.
export fn collect_formal_applications_by(te: TypeExpr, is_formal: (String) -> Bool, out: Array[String]) -> Unit {
  collect_formal_kind_uses(te = te, is_formal = is_formal, applied = out, unapplied = array_empty())
}

// Forward the established checker API to its owning package.
export fn formal_application_error(fname: String, where_label: String) -> String {
  annotations_formal_application_error(fname = fname, where_label = where_label)
}

// Forward the established checker API to its owning package.
export fn report_formal_applications_across(tes: Array[TypeExpr], formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  annotations_report_formal_applications_across(tes = tes, formals = formals, where_label = where_label, errors = errors)
}

/// #2268: the reporting face of `collect_formal_applications_by`. `formals`
/// must be the declaration's OWN type binders -- never the merged shadow
/// `report_unknown_type_names` takes, which also carries deferred
/// cross-package names (`Map` in a `.vpkg`-derived struct) that are types,
/// not formals (the Codex round-2 false positive on #2267: every
/// `Map[String, String]` field in `@vibe/http`'s synthesized types was
/// rejected) -- and never an env lookup: a VALUE binding whose type is a
/// `CtVar` is indistinguishable from a type formal by env alone, so
/// `fn f[T](Array: T, xs: Array[Int])` would reject the valid builtin head
/// (Codex round 4). Binder provenance is the only test. The one
/// non-declaration site -- a let annotation inside a generic fn -- is
/// covered separately through the `fapp_formal_marker_prefix` markers the
/// EFn arm binds (Codex round 5), which are also binder provenance.
export fn report_formal_applications(te: TypeExpr, formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  let tes = array_empty()
  Array::push(tes, value = te)
  report_formal_applications_across(tes = tes, formals = formals, where_label = where_label, errors = errors)
  report_kinded_formal_applications(te = te, formals = formals, where_label = where_label, errors = errors)
}

export fn formals_source_arity(formals: Array[String], name: String) -> Int {
  let mut i = 0
  let mut arity = 0 - 1
  while i < Array::length(formals) {
    if type_param_name(Array::get(formals, at = i)) == name {
      arity = type_param_arity(Array::get(formals, at = i))
    } else {
      ()
    }
    i = i + 1
  }
  arity
}

// Forward the established checker API to its owning package.
export fn report_map_key_types(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], where_label: String, errors: Array[String]) -> Unit {
  annotations_report_map_key_types(te = te, defs = defs, shadow = shadow, where_label = where_label, errors = errors)
}

/// #3536: `report_bare_generic_heads` for a function signature checked in
/// `env`. A name is in scope when an enclosing binder bound it as a type
/// formal (a `CtVar`, or its rigid spelling), and `#erased.<name>` when an
/// impl erases it in this method (`trait_erased_type_param_env`).
export fn report_bare_generic_heads_in_env(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, where_label: String, errors: Array[String]) -> Unit {
  annotations_report_bare_generic_heads(te = te, defs = defs, shadow = shadow, in_scope = signature_type_scope(env), where_label = where_label, errors = errors)
}

/// An impl method `val` with its owner written bare in the signature read as
/// the owner applied to its erased formals (`expand_erased_owner_heads`), so
/// the method is typed -- and held to its trait's signature -- at that
/// application rather than at a wildcard (#3551 review). `env` is the one
/// `trait_erased_type_param_env` built for the binding; any other value is
/// returned as it is.
export fn expand_impl_owner_bare_heads(val: Expr, defs: Array[TypeDef], env: TypeEnv) -> Expr {
  match val {
    EFn(tps, bounds, params, ret, eff, body) => {
      let shadow: Array[String] = []
      for tp in tps {
        Array::push(shadow, value = type_param_name(tp))
      }
      let in_scope = signature_type_scope(env)
      let expand = (te: TypeExpr) -> TypeExpr {
        annotations_expand_erased_owner_heads(te = te, defs = defs, shadow = shadow, in_scope = in_scope)
      }
      EFn(tps, bounds, for p in params {
        let (pname, ann) = p
        (pname, match ann {
          Some(te) => Some(expand(te)),
          None => None
        })
      }, match ret {
        Some(te) => Some(expand(te)),
        None => None
      }, eff, body)
    },
    _ => val
  }
}

/// Whether a name is in scope at a signature checked in `env`: a type formal
/// an enclosing binder bound, or `#erased.<name>` for what an impl erases in
/// this method (`trait_erased_type_param_env`).
fn signature_type_scope(_ env: TypeEnv) -> (String) -> Bool {
  (name) -> {
    if String::starts_with(name, prefix = "#erased.") {
      match env_lookup(env = env, name = String::concat(trait_erased_type_param_prefix, String::substring(name, start = 8, end = String::length(name)))) {
        Some(_) => true,
        None => false
      }
    } else {
      match env_lookup(env = env, name = name) {
        Some(t) => match t {
          CtVar(_) => true,
          CtNamed(bound_name, bargs) => Array::length(bargs) == 0 && (bound_name == name || bound_name == String::concat("#hktformal.", name)),
          _ => false
        },
        None => false
      }
    }
  }
}

/// #3536: `report_bare_generic_heads` for a DECLARATION's type -- a struct
/// field, an enum or error payload, an effect operation, an extern, a type
/// alias body. (A trait method is judged as the signature of the dispatcher
/// the trait declares.) Every type formal the declaration binds is in
/// `shadow`, so no other name is in scope. A bare head there is as rigid as in
/// a function signature: `struct Box { xs: Array }` stored an `Array[String]`
/// that a reader took back as an `Array[Int]`.
export fn report_decl_bare_generic_heads(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], where_label: String, errors: Array[String]) -> Unit {
  annotations_report_bare_generic_heads(te = te, defs = defs, shadow = shadow, in_scope = (_name) -> false, where_label = where_label, errors = errors)
}

fn report_unknown_type_names_only(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  // Which of the unresolved names are region-ish binders at all. Asked over
  // the name candidates first because the positional walk below takes a set,
  // and `#region_` skolem membership is an env question this file owns.
  let candidates = array_empty()
  collect_unknown_type_names(te = te, defs = defs, shadow = shadow, out = candidates)
  let region_binders = array_empty()
  let mut ci = 0
  while ci < Array::length(candidates) {
    let candidate = Array::get(candidates, at = ci)
    let is_region_token = match env_lookup(env = env, name = candidate) {
      Some(t) => match t {
        CtNamed(bound_name, _) => String::starts_with(bound_name, prefix = "#region_"),
        _ => false
      },
      None => false
    }
    if (is_region_token || checker_string_array_has(items = row_binders, wanted = candidate)) && !checker_string_array_has(items = region_binders, wanted = candidate) {
      Array::push(region_binders, value = candidate)
    } else {
      ()
    }
    ci = ci + 1
  }
  let out = array_empty()
  collect_unknown_type_names_regionwise(te = te, defs = defs, shadow = shadow, region_binders = region_binders, out = out)
  // #3574: a row variable the signature's own row declares, passed to a
  // struct's row parameter (`j: Job[e]` beside `-> Int with e`), is that row
  // variable, as `f: () -> Int with e` is. Each such occurrence is excused
  // once; the same name anywhere else is still an unknown type.
  // (With no row binder the empty `row_binders` stands in: nothing is taken
  // from it.)
  let row_slot_names = if Array::length(row_binders) > 0 && Array::length(out) > 0 {
    let names = array_empty()
    collect_struct_row_slot_names(te = te, defs = defs, binders = row_binders, out = names)
    names
  } else {
    row_binders
  }
  let mut i = 0
  while i < Array::length(out) {
    let name = Array::get(out, at = i)
    let at_row_slot = take_string_once(names = row_slot_names, name = name)
    let is_type_formal = match env_lookup(env = env, name = name) {
      Some(t) => match t {
        CtVar(_) => true,
        CtNamed(bound_name, bargs) => Array::length(bargs) == 0 && (bound_name == name || bound_name == String::concat("#hktformal.", name)),
        _ => false
      },
      None => false
    }
    let trait_erased_by_impl = match env_lookup(env = env, name = String::concat(trait_erased_type_param_prefix, name)) {
      Some(_) => true,
      None => false
    }
    if is_type_formal || trait_erased_by_impl || at_row_slot {
      ()
    } else {
      Array::push(errors, value = String::concat(String::concat(String::concat(String::concat("unknown type `", name), "` in "), where_label), sized_int_spelling_hint(name)))
    }
    i = i + 1
  }
}

/// The edit for a fixed-width integer spelling that vibe does not define
/// (`i32`, `u8`, `usize`, ...), appended to its unknown-type message; "" for
/// any other name. The parser already refuses the ones that used to resolve
/// (`i32` #3727; `i64`, `i16`, `u8`..`u64` #3793), with the same edit.
fn sized_int_spelling_hint(_ name: String) -> String {
  let sized = [
    "i8",
    "i32",
    "i64",
    "i16",
    "u8",
    "u16",
    "u32",
    "u64",
    "i128",
    "u128",
    "isize",
    "usize"
  ]
  let mut hit = false
  for s in sized {
    if s == name {
      hit = true
    } else {
      ()
    }
  }
  if hit {
    " -- write `Int`: vibe's integer type is 63-bit and wraps at 63 bits, and there is no `\{name}`"
  } else {
    ""
  }
}

/// #3574: each bare name among `binders` that `te` passes to a row parameter
/// of a declared struct, once per occurrence.
fn collect_struct_row_slot_names(te: TypeExpr, defs: Array[TypeDef], binders: Array[String], out: Array[String]) -> Unit {
  match te {
    TyApp(head, args) => {
      let mut i = 0
      while i < Array::length(args) {
        match Array::get(args, at = i) {
          TyName(n) => if checker_string_array_has(items = binders, wanted = n) && struct_row_param(defs = defs, m = head, k = i) {
            Array::push(out, value = n)
          },
          _ => collect_struct_row_slot_names(te = Array::get(args, at = i), defs = defs, binders = binders, out = out)
        }
        i = i + 1
      }
    },
    TyTuple(items) => {
      for item in items {
        collect_struct_row_slot_names(te = item, defs = defs, binders = binders, out = out)
      }
      ()
    },
    TyFn(params, ret, _) => {
      for p in params {
        collect_struct_row_slot_names(te = p, defs = defs, binders = binders, out = out)
      }
      collect_struct_row_slot_names(te = ret, defs = defs, binders = binders, out = out)
    },
    _ => ()
  }
}

/// Remove one occurrence of `name` from `names`; true when there was one.
fn take_string_once(names: Array[String], name: String) -> Bool {
  let mut at = 0 - 1
  let mut i = 0
  while i < Array::length(names) && at < 0 {
    if Array::get(names, at = i) == name {
      at = i
    }
    i = i + 1
  }
  if at < 0 {
    false
  } else {
    Array::set(names, at = at, value = "")
    true
  }
}

/// Reports unresolved type names while leaving Map-key and structural-head
/// arity validation to a later completed-definition pass. Type declaration
/// payloads use this because a nested declaration can still claim a spelling
/// that currently looks like a compiler-owned builtin head.
export fn report_unknown_type_names_deferred_validation(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_unknown_type_names_only(te = te, defs = defs, shadow = shadow, env = env, row_binders = row_binders, where_label = where_label, errors = errors)
  // A struct field's or enum payload's function row names exception kinds too.
  // Their resolutions are recorded once the declarations are complete
  // (`record_decl_exception_kinds`): `shadow` here also holds the names of
  // types declared later, which are not formals.
  report_exception_kinds_in_type_expr(te = te, defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = false)
}

/// #3028 / #3033: record how every exception kind in a type declaration's
/// function rows resolves -- an alias body, a struct field, an enum payload --
/// with the declaration's own type parameters as the formals, so the
/// declaration's published types carry the resolved kinds.
///
/// `complete` is true once the statement list's type declarations are all in
/// `defs`: then an alias body's kinds are also CHECKED as types (the one
/// declaration whose rows went unchecked; earlier, a later alias would read
/// as unknown), and an EXPORTED declaration whose row names a kind no row can
/// spell is refused (`refuse_unpublishable_exception_row`). Called per
/// declaration as it is checked, with `complete` false, and for the whole
/// list at the phase boundary.
export fn record_decl_exception_kinds(stmts: Array[Stmt], defs: Array[TypeDef], env: TypeEnv, errors: Array[String], complete: Bool) -> Unit {
  let scratch = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STypeAlias(exported, name, params, te) => {
        report_exception_kinds_in_type_expr(te = te, defs = defs, shadow = params, env = env, errors = if complete {
          errors
        } else {
          scratch
        }, record_kinds = true)
        if complete && exported {
          refuse_unpublishable_exception_row(t = resolve_type_expr_shadowed(te = te, defs = defs, shadow = params), owner = name, anchor = name, defs = defs, errors = errors)
        } else {
          ()
        }
      },
      SStruct(exported, name, fields, _, _, params) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fte) = Array::get(fields, at = fi)
          report_exception_kinds_in_type_expr(te = fte, defs = defs, shadow = params, env = env, errors = scratch, record_kinds = true)
          if complete && exported {
            refuse_unpublishable_exception_row(t = resolve_type_expr_shadowed(te = fte, defs = defs, shadow = params), owner = String::concat(name, String::concat(".", fname)), anchor = name, defs = defs, errors = errors)
          } else {
            ()
          }
          fi = fi + 1
        }
      },
      SEnum(exported, name, params, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, payloads) = Array::get(variants, at = vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            report_exception_kinds_in_type_expr(te = Array::get(payloads, at = pi), defs = defs, shadow = params, env = env, errors = scratch, record_kinds = true)
            if complete && exported {
              refuse_unpublishable_exception_row(t = resolve_type_expr_shadowed(te = Array::get(payloads, at = pi), defs = defs, shadow = params), owner = String::concat(name, String::concat("::", vname)), anchor = name, defs = defs, errors = errors)
            } else {
              ()
            }
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

export fn report_unknown_type_names(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, row_binders: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_map_key_types(te = te, defs = defs, shadow = shadow, where_label = where_label, errors = errors)
  report_unknown_type_names_only(te = te, defs = defs, shadow = shadow, env = env, row_binders = row_binders, where_label = where_label, errors = errors)
  report_exception_kinds_in_type_expr(te = te, defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = true)
}

/// #3017: the exception kind a resolved payload type names, spelled the way a
/// kinded row writes it (`Int`, `Array[Int]`, `Option[P]`, `P`). "" for
/// anything else -- an unresolved variable, a type formal, a tuple -- which
/// leaves the syntactic answer standing. A generic nominal keeps its
/// arguments (`Box[Int]`, #3029). A function type is spelled
/// `(Int) -> Int` (#3033): it had no kind, so a function payload was an
/// erased requirement that `with Exception[Callback]` could never cover.
///
/// This is also how the checker spells a written kind's RESOLUTION
/// (`record_exception_kind_resolution`), so a payload and a row that name one
/// type compare equal.
export fn throw_kind_of_type(_ t: Type) -> String {
  match t {
    CtNamed(n, args) => if Array::length(args) == 0 || String::starts_with(n, prefix = "#") || String::starts_with(n, prefix = "__") {
      ""
    } else {
      let parts = array_empty()
      let mut ok = true
      let mut ai = 0
      while ai < Array::length(args) {
        let k = throw_kind_of_type(Array::get(args, at = ai))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, value = k)
        ai = ai + 1
      }
      if ok {
        String::concat(n, String::concat("[", String::concat(String::join(parts, sep = ", "), "]")))
      } else {
        ""
      }
    },
    CtInt => "Int",
    CtInt32 => "Int32",
    CtUInt32 => "UInt32",
    CtDouble => "Float64",
    CtFloat => "Float32",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtBytes => "Bytes",
    CtStruct(n) => if String::starts_with(n, prefix = "#") {
      ""
    } else {
      n
    },
    CtEnum(n) => n,
    CtArray(e) => {
      let k = throw_kind_of_type(e)
      if String::length(k) > 0 {
        String::concat("Array[", String::concat(k, "]"))
      } else {
        ""
      }
    },
    CtOption(e) => {
      let k = throw_kind_of_type(e)
      if String::length(k) > 0 {
        String::concat("Option[", String::concat(k, "]"))
      } else {
        ""
      }
    },
    CtFn(params, ret, row) => {
      let parts = array_empty()
      let mut ok = true
      let mut pi = 0
      while pi < Array::length(params) {
        let k = throw_kind_of_fn_slot(Array::get(params, at = pi))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, value = k)
        pi = pi + 1
      }
      let rk = throw_kind_of_fn_slot(ret)
      if ok && String::length(rk) > 0 {
        let head = String::concat("(", String::concat(String::join(parts, sep = ", "), String::concat(") -> ", rk)))
        // The checker's own provenance labels (`#param[0]`, `#capture[..]`)
        // are not part of the type a row names.
        // A row is a SET: `with Fs + Env` and `with Env + Fs` name one type,
        // so the labels are sorted. They are joined the way a row is WRITTEN,
        // so the kind stays the spelling of a type a reader could declare.
        let labels = array_empty()
        match row {
          Some(r) => {
            let parts = row_items_top_level(r)
            let mut li = 0
            while li < Array::length(parts) {
              let l = Array::get(parts, at = li)
              if !String::starts_with(l, prefix = "#") {
                insert_sorted_label(labels = labels, l = l)
              } else {
                ()
              }
              li = li + 1
            }
          },
          None => ()
        }
        if Array::length(labels) > 0 {
          String::concat(head, String::concat(" with ", String::join(labels, sep = " + ")))
        } else {
          head
        }
      } else {
        ""
      }
    },
    _ => ""
  }
}

/// A parameter or result of a function-type kind: `Unit` has a spelling
/// there even though a bare `Unit` payload keeps having none.
fn throw_kind_of_fn_slot(_ t: Type) -> String {
  match t {
    CtUnit => "Unit",
    // A tuple is no kind on its own (a row cannot spell one), but it is a
    // parameter or result a function-type kind has to spell, or two aliases
    // of `((Int, Int)) -> Int` never meet.
    CtTuple(elems) => {
      let parts = array_empty()
      let mut ok = Array::length(elems) > 0
      let mut i = 0
      while i < Array::length(elems) {
        let k = throw_kind_of_fn_slot(Array::get(elems, at = i))
        if String::length(k) == 0 {
          ok = false
        }
        Array::push(parts, value = k)
        i = i + 1
      }
      if ok {
        String::concat("(", String::concat(String::join(parts, sep = ", "), ")"))
      } else {
        ""
      }
    },
    _ => throw_kind_of_type(t)
  }
}

fn insert_sorted_label(labels: Array[String], l: String) -> Unit {
  Array::push(labels, value = l)
  let mut i = Array::length(labels) - 1
  while i > 0 && str_lt(a = l, b = Array::get(labels, at = i - 1)) {
    Array::set(labels, at = i, value = Array::get(labels, at = i - 1))
    i = i - 1
  }
  Array::set(labels, at = i, value = l)
}

/// The KIND of an exception label names a type, so it gets the unknown-name
/// check an annotation gets. A handler arm's kind already did
/// (`an exception kind`); a function's `with` row, the row of a function type
/// written in an annotation, and a struct field's or enum payload's row did
/// not, so `fn f() -> Int with Exception[Nope]` was accepted with no `Nope`
/// anywhere. A kind the type parser cannot read is left alone. Type formals
/// in a kind are `collect_formal_exception_kind_errors`' subject, and are
/// exempt here through `shadow` and the env.
/// `record_kinds`: also record each kind's resolution (#3033), with `shadow` as the
/// formals in scope.
/// A generic effect's type argument in the same row is checked too
/// (`report_generic_effect_row_arg_names`, #3319).
export fn report_exception_kinds_in_row(row: Option[String], defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String], record_kinds: Bool) -> Unit {
  let labels = row_labels(row)
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, at = i)
    let kind = exception_label_kind(label)
    if is_exception_label(label) && String::length(kind) > 0 {
      let parsed = handle {
        let (kind_te, _) = parse_type(tokens = lex(kind), pos = 0)
        Some(kind_te)
      } with { Exception::Throw(_unreadable) => None }
      match parsed {
        Some(kind_te) => {
          report_map_key_types(te = kind_te, defs = defs, shadow = shadow, where_label = "an exception kind", errors = errors)
          report_unknown_type_names_only(te = kind_te, defs = defs, shadow = shadow, env = env, row_binders = array_empty(), where_label = "an exception kind", errors = errors)
          if record_kinds {
            record_exception_kind_resolution(kind = kind, kind_te = kind_te, defs = defs, formals = formal_shadow(te = kind_te, env = env, own = shadow))
          } else {
            ()
          }
        },
        None => ()
      }
    } else if !is_exception_label(label) {
      report_generic_effect_row_arg_names(label = label, defs = defs, shadow = shadow, env = env, errors = errors)
    } else {
      ()
    }
    i = i + 1
  }
}

/// #3319: the type argument of a declared generic effect in a row
/// (`with Box[Nope]`) names a type, so it gets the unknown-name check an
/// annotation gets. Nothing looked at it: the row binder read `Nope` as a bare
/// name, the perform kept a fresh instantiation, and the program checked clean
/// as if the row said `with Box`. A kinded parameter (`F` of `Read[F[_]]`)
/// takes a constructor, and the row binder reports its argument
/// (`kinded_row_inst`); a label of an undeclared or non-generic effect is the
/// row-item check's subject. Formals in scope are exempt through `shadow` and
/// the env, as in an annotation.
fn report_generic_effect_row_arg_names(label: String, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String]) -> Unit {
  let bi = String::index_of(label, needle = "[")
  if bi > 0 && String::ends_with(label, suffix = "]") {
    let plain_generic = match find_typedef(defs = defs, name = String::trim(label[0: bi])) {
      Some(TDEffect(_, _, all_etps, ekinds, _)) => {
        let etps = effect_type_param_names(params = all_etps, kinds = ekinds)
        Array::length(etps) == 1 && type_param_arity(Array::get(etps, at = 0)) == 0
      },
      _ => false
    }
    if plain_generic {
      let parsed = handle {
        let (arg_te, _) = parse_type(tokens = lex(label[bi + 1: String::length(label) - 1]), pos = 0)
        Some(arg_te)
      } with { Exception::Throw(_unreadable) => None }
      match parsed {
        Some(arg_te) => report_unknown_type_names_only(te = arg_te, defs = defs, shadow = shadow, env = env, row_binders = array_empty(), where_label = String::concat("the effect row item `", String::concat(label, "` (declare or import the type, or fix its spelling)")), errors = errors),
        None => ()
      }
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #3033: record how the kind written `kind` (parsed as `kind_te`) resolves,
/// so every comparison of kinds in this module sees the type it names
/// (`exception_kinds_same`): `Es[IoErr]` with `type Es[T] = Array[T]` is
/// `Array[IoErr]`. `formals` are the type formals in scope; a kind that names
/// one is POISONED instead -- a formal is not the type a same-named alias or
/// import denotes, so that spelling keeps being compared as written. A kind
/// whose type has no kind spelling (a tuple) records nothing.
export fn record_exception_kind_resolution(kind: String, kind_te: TypeExpr, defs: Array[TypeDef], formals: Array[String]) -> Unit {
  if type_expr_names_any(te = kind_te, names = formals) {
    exception_kind_resolution_record(written = kind, resolved = "")
  } else {
    let resolved = throw_kind_of_type(resolve_type_expr_shadowed(te = kind_te, defs = defs, shadow = formals))
    if String::length(resolved) > 0 {
      exception_kind_resolution_record(written = kind, resolved = resolved)
    } else {
      ()
    }
  }
}

/// #3033 / #3028: `t` with every function row's exception kinds written as
/// the types they resolve to (`exception_row_resolved`). A declaration's
/// PUBLISHED type goes through this -- a binding, a struct field, an enum
/// payload and its constructor, a type alias's body -- so a module importing
/// it compares types, not a kind spelled through an alias that is private to
/// this module (or means another type in the importer).
export fn type_exception_rows_resolved(_ t: Type) -> Type {
  if exception_kind_resolution_count() == 0 {
    t
  } else {
    type_exception_rows_resolved_walk(t)
  }
}

fn type_exception_rows_resolved_walk(_ t: Type) -> Type {
  match t {
    CtFn(params, ret, row) => CtFn(for p in params {
      type_exception_rows_resolved_walk(p)
    }, type_exception_rows_resolved_walk(ret), match row {
      Some(r) => Some(exception_row_resolved(r)),
      None => None
    }),
    CtForAll(ids, bounds, body) => CtForAll(ids, bounds, type_exception_rows_resolved_walk(body)),
    CtArray(e) => CtArray(type_exception_rows_resolved_walk(e)),
    CtOption(e) => CtOption(type_exception_rows_resolved_walk(e)),
    CtTuple(items) => CtTuple(for item in items {
      type_exception_rows_resolved_walk(item)
    }),
    CtNamed(n, args) => if Array::length(args) == 0 {
      t
    } else {
      CtNamed(n, for a in args {
        type_exception_rows_resolved_walk(a)
      })
    },
    CtApplied(head, args) => CtApplied(type_exception_rows_resolved_walk(head), for a in args {
      type_exception_rows_resolved_walk(a)
    }),
    CtRecord(fields) => CtRecord(for field in fields {
      let (fname, fty) = field
      (fname, type_exception_rows_resolved_walk(fty))
    }),
    _ => t
  }
}

/// #3033 / #3028: refuse an EXPORTED type whose function row names an
/// exception kind through a type alias that resolves to a type no row can
/// spell -- a tuple (`type Pair = (Int, Int)`), or anything with a comma,
/// since rows are split on commas. Its published row would keep the alias
/// NAME, which an importer cannot resolve (or resolves to its own type of
/// that name). `owner` names the export in the message (`f`, `S.field`,
/// `E::Variant`); `anchor` is the declaration name the diagnostic points at.
export fn refuse_unpublishable_exception_row(t: Type, owner: String, anchor: String, defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let found = array_empty()
  collect_unpublishable_exception_kinds(t = t, defs = defs, out = found)
  if Array::length(found) > 0 {
    let (kind, shown) = Array::get(found, at = 0)
    Array::push(errors, value = String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat(String::concat("`Exception[", kind), "]` in the row of exported `"), owner), "`: `"), kind), "` is `"), shown), "`, which a published row cannot spell -- throw a struct or enum that wraps it instead [@fn="), anchor), "]"))
  } else {
    ()
  }
}

fn collect_unpublishable_exception_kinds(t: Type, defs: Array[TypeDef], out: Array[(String, String)]) -> Unit {
  match t {
    CtFn(params, ret, row) => {
      match row {
        Some(r) => {
          let kinds = exception_row_kinds(r)
          let mut i = 0
          while i < Array::length(kinds) {
            let kind = Array::get(kinds, at = i)
            let resolved = exception_kind_resolution(kind)
            if String::length(resolved) > 0 && !String::contains(resolved, needle = ",") {
              ()
            } else {
              match exception_kind_through_alias(kind = kind, defs = defs) {
                Some(shown) => Array::push(out, value = (kind, shown)),
                None => ()
              }
            }
            i = i + 1
          }
        },
        None => ()
      }
      let mut pi = 0
      while pi < Array::length(params) {
        collect_unpublishable_exception_kinds(t = Array::get(params, at = pi), defs = defs, out = out)
        pi = pi + 1
      }
      collect_unpublishable_exception_kinds(t = ret, defs = defs, out = out)
    },
    CtForAll(_, _, body) => collect_unpublishable_exception_kinds(t = body, defs = defs, out = out),
    CtArray(e) => collect_unpublishable_exception_kinds(t = e, defs = defs, out = out),
    CtOption(e) => collect_unpublishable_exception_kinds(t = e, defs = defs, out = out),
    CtTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_unpublishable_exception_kinds(t = Array::get(items, at = i), defs = defs, out = out)
        i = i + 1
      }
    },
    CtNamed(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_unpublishable_exception_kinds(t = Array::get(args, at = i), defs = defs, out = out)
        i = i + 1
      }
    },
    CtApplied(head, args) => {
      collect_unpublishable_exception_kinds(t = head, defs = defs, out = out)
      let mut i = 0
      while i < Array::length(args) {
        collect_unpublishable_exception_kinds(t = Array::get(args, at = i), defs = defs, out = out)
        i = i + 1
      }
    },
    CtRecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, at = i)
        collect_unpublishable_exception_kinds(t = fty, defs = defs, out = out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// When `kind` names a type ALIAS of `defs` anywhere in its spelling, the
/// type it resolves to, as printed; None otherwise (a kind with no alias in
/// it publishes the names it was written with, which are the types' own).
fn exception_kind_through_alias(kind: String, defs: Array[TypeDef]) -> Option[String] {
  let parsed = handle {
    let (kind_te, _) = parse_type(tokens = lex(kind), pos = 0)
    Some(kind_te)
  } with { Exception::Throw(_unreadable) => None }
  match parsed {
    Some(kind_te) => if type_expr_names_alias(te = kind_te, defs = defs) {
      Some(type_to_string(resolve_type_expr(te = kind_te, defs = defs)))
    } else {
      None
    },
    None => None
  }
}

fn type_expr_names_alias(te: TypeExpr, defs: Array[TypeDef]) -> Bool {
  let is_alias = (n: String) -> Bool {
    match find_typedef(defs = defs, name = n) {
      Some(TDAlias(_, _, _)) => true,
      _ => false
    }
  }
  match te {
    TyName(n) => is_alias(n),
    TyApp(n, args) => {
      let mut found = is_alias(n)
      let mut i = 0
      while i < Array::length(args) && !found {
        found = type_expr_names_alias(te = Array::get(args, at = i), defs = defs)
        i = i + 1
      }
      found
    },
    TyTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) && !found {
        found = type_expr_names_alias(te = Array::get(items, at = i), defs = defs)
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = type_expr_names_alias(te = ret, defs = defs)
      let mut i = 0
      while i < Array::length(params) && !found {
        found = type_expr_names_alias(te = Array::get(params, at = i), defs = defs)
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

/// Does `te` name any of `names` (as a type name or an applied head)?
fn type_expr_names_any(te: TypeExpr, names: Array[String]) -> Bool {
  if Array::length(names) == 0 {
    false
  } else {
    match te {
      TyName(n) => checker_string_array_has(items = names, wanted = n),
      TyApp(n, args) => {
        let mut found = checker_string_array_has(items = names, wanted = n)
        let mut i = 0
        while i < Array::length(args) && !found {
          found = type_expr_names_any(te = Array::get(args, at = i), names = names)
          i = i + 1
        }
        found
      },
      TyTuple(items) => {
        let mut found = false
        let mut i = 0
        while i < Array::length(items) && !found {
          found = type_expr_names_any(te = Array::get(items, at = i), names = names)
          i = i + 1
        }
        found
      },
      TyFn(params, ret, _) => {
        let mut found = type_expr_names_any(te = ret, names = names)
        let mut i = 0
        while i < Array::length(params) && !found {
          found = type_expr_names_any(te = Array::get(params, at = i), names = names)
          i = i + 1
        }
        found
      },
      TyUnit => false
    }
  }
}

/// The rows of every function type written inside an annotation, checked by
/// `report_exception_kinds_in_row`.
fn report_exception_kinds_in_type_expr(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], env: TypeEnv, errors: Array[String], record_kinds: Bool) -> Unit {
  match te {
    TyApp(_, targs) => {
      let mut i = 0
      while i < Array::length(targs) {
        report_exception_kinds_in_type_expr(te = Array::get(targs, at = i), defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = record_kinds)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        report_exception_kinds_in_type_expr(te = Array::get(elems, at = i), defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = record_kinds)
        i = i + 1
      }
    },
    TyFn(ps, ret, row) => {
      let mut i = 0
      while i < Array::length(ps) {
        report_exception_kinds_in_type_expr(te = Array::get(ps, at = i), defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = record_kinds)
        i = i + 1
      }
      report_exception_kinds_in_type_expr(te = ret, defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = record_kinds)
      report_exception_kinds_in_row(row = row, defs = defs, shadow = shadow, env = env, errors = errors, record_kinds = record_kinds)
    },
    _ => ()
  }
}

/// ADR-0090 MutBytes: reject a known-wrong receiver head instead of letting
/// codegen alias the op onto Bytes::* and reinterpret an arbitrary value as
/// a buffer pointer (Codex review on #1801). Unresolved vars and CtUnknown
/// stay tolerant -- enforcement is the "silent when unsure" side (ADR-0100).
export fn check_mutbytes_receiver(op: String, zonked: Type, errors: Array[String], callee_off: Int) -> Unit {
  match zonked {
    CtNamed(mb_name, _) => if mb_name == "MutBytes" {
      ()
    } else {
      Array::push(errors, value = String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(off = callee_off, len = String::length(op))))
    },
    CtVar(_) => (),
    CtUnknown => (),
    _ => Array::push(errors, value = String::concat(String::concat(String::concat(op, " expects a region-bound MutBytes (from `MutBytes::empty(r)`), got "), type_to_string(zonked)), off_marker_len(off = callee_off, len = String::length(op))))
  }
}

export fn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, value = first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, value = Array::get(rest, at = i))
    i = i + 1
  }
  out
}

/// Replace the abstract `Self` type (resolved as `CtNamed("Self", _)`) inside a
/// trait-method signature with the concrete receiver type, when typing a
/// `T::method` call against a bounded generic parameter T.
fn subst_self_in_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(ty = a, self_ty = self_ty)
      }
      CtNamed(n, ra)
    },
    CtApplied(head, args) => apply_type_constructor(head = subst_self_in_type(ty = head, self_ty = self_ty), args = for arg in args {
      subst_self_in_type(ty = arg, self_ty = self_ty)
    }),
    CtArray(e) => CtArray(subst_self_in_type(ty = e, self_ty = self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(ty = e, self_ty = self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(ty = e, self_ty = self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(ty = p, self_ty = self_ty)
    }, subst_self_in_type(ty = ret, self_ty = self_ty), eff),
    _ => ty
  }
}

/// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->
/// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that
/// resolves to a real type (primitive or declared) is kept; only truly-unknown
/// named types — the trait's own element type params, which the uniform
/// representation erases — are relaxed. (#636.)
fn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs = defs, name = n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(ty = a, defs = defs)
        })
      } else {
        CtUnknown
      }
    },
    CtApplied(head, args) => apply_type_constructor(head = relax_unknown_named(ty = head, defs = defs), args = for arg in args {
      relax_unknown_named(ty = arg, defs = defs)
    }),
    CtArray(e) => CtArray(relax_unknown_named(ty = e, defs = defs)),
    CtOption(e) => CtOption(relax_unknown_named(ty = e, defs = defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(ty = e, defs = defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(ty = p, defs = defs)
    }, relax_unknown_named(ty = r, defs = defs), eff),
    _ => ty
  }
}

fn replace_trait_bound_vars_from_env(ty: Type, env: TypeEnv) -> Type {
  match ty {
    CtNamed(name, args) => if Array::length(args) == 0 {
      match env_lookup(env = env, name = name) {
        Some(CtVar(id)) => CtVar(id),
        _ => ty
      }
    } else {
      CtNamed(name, for arg in args {
        replace_trait_bound_vars_from_env(ty = arg, env = env)
      })
    },
    CtApplied(head, args) => apply_type_constructor(head = replace_trait_bound_vars_from_env(ty = head, env = env), args = for arg in args {
      replace_trait_bound_vars_from_env(ty = arg, env = env)
    }),
    CtArray(elem) => CtArray(replace_trait_bound_vars_from_env(ty = elem, env = env)),
    CtOption(elem) => CtOption(replace_trait_bound_vars_from_env(ty = elem, env = env)),
    CtTuple(items) => CtTuple(for item in items {
      replace_trait_bound_vars_from_env(ty = item, env = env)
    }),
    CtFn(params, ret, effect) => CtFn(for param in params {
      replace_trait_bound_vars_from_env(ty = param, env = env)
    }, replace_trait_bound_vars_from_env(ty = ret, env = env), effect),
    _ => ty
  }
}

let trait_bound_self_marker: String = "$trait_bound_self$"

fn bind_trait_bound_self_type_expr(te: TypeExpr, binder: String) -> TypeExpr {
  match te {
    TyName(name) => if name == binder {
      TyName(trait_bound_self_marker)
    } else {
      te
    },
    TyApp(name, args) => TyApp(if name == binder {
      trait_bound_self_marker
    } else {
      name
    }, for arg in args {
      bind_trait_bound_self_type_expr(te = arg, binder = binder)
    }),
    TyTuple(items) => TyTuple(for item in items {
      bind_trait_bound_self_type_expr(te = item, binder = binder)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      bind_trait_bound_self_type_expr(te = param, binder = binder)
    }, bind_trait_bound_self_type_expr(te = ret, binder = binder), effect),
    TyUnit => TyUnit
  }
}

export fn bind_trait_bound_self_reference(key: String, binder: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => trait_ref_key(bind_trait_bound_self_type_expr(te = reference, binder = binder)),
    None => key
  }
}

fn trait_bound_vid_prefix() -> String {
  "#tpvid."
}

fn bind_trait_bound_tparam_name(name: String, tparams: Array[String], ids: Array[Int]) -> String {
  if name == trait_bound_self_marker {
    name
  } else {
    let mut i = 0
    let mut out = name
    while i < Array::length(tparams) && i < Array::length(ids) {
      if type_param_name(Array::get(tparams, at = i)) == name {
        out = String::concat(trait_bound_vid_prefix(), __to_string(Array::get(ids, at = i)))
      } else {
        ()
      }
      i = i + 1
    }
    out
  }
}

fn bind_trait_bound_tparam_names(te: TypeExpr, tparams: Array[String], ids: Array[Int]) -> TypeExpr {
  match te {
    TyName(name) => {
      let bound = bind_trait_bound_tparam_name(name = name, tparams = tparams, ids = ids)
      if bound == name {
        te
      } else {
        TyName(bound)
      }
    },
    TyApp(name, args) => TyApp(bind_trait_bound_tparam_name(name = name, tparams = tparams, ids = ids), for arg in args {
      bind_trait_bound_tparam_names(te = arg, tparams = tparams, ids = ids)
    }),
    TyTuple(items) => TyTuple(for item in items {
      bind_trait_bound_tparam_names(te = item, tparams = tparams, ids = ids)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      bind_trait_bound_tparam_names(te = param, tparams = tparams, ids = ids)
    }, bind_trait_bound_tparam_names(te = ret, tparams = tparams, ids = ids), effect),
    TyUnit => TyUnit
  }
}

export fn bind_trait_bound_tparams(key: String, tparams: Array[String], ids: Array[Int]) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => trait_ref_key(bind_trait_bound_tparam_names(te = reference, tparams = tparams, ids = ids)),
    None => key
  }
}

fn parse_trait_bound_vid(_ name: String) -> Option[Int] {
  let prefix = trait_bound_vid_prefix()
  if !String::starts_with(name, prefix = prefix) {
    None
  } else {
    let rest = String::substring(name, start = String::length(prefix), end = String::length(name))
    if String::length(rest) == 0 {
      None
    } else {
      let mut i = 0
      let mut n = 0
      let mut ok = true
      while i < String::length(rest) && ok {
        let c = String::char_code_at(rest, at = i)
        if c >= '0' && c <= '9' {
          n = n * 10 + c - '0'
        } else {
          ok = false
        }
        i = i + 1
      }
      if ok {
        Some(n)
      } else {
        None
      }
    }
  }
}

fn replace_trait_bound_self_type(ty: Type, self_ty: Type) -> Type {
  match ty {
    CtNamed(name, args) => if name == trait_bound_self_marker {
      if Array::length(args) == 0 {
        self_ty
      } else {
        apply_type_constructor(head = self_ty, args = for arg in args {
          replace_trait_bound_self_type(ty = arg, self_ty = self_ty)
        })
      }
    } else {
      CtNamed(name, for arg in args {
        replace_trait_bound_self_type(ty = arg, self_ty = self_ty)
      })
    },
    CtApplied(head, args) => apply_type_constructor(head = replace_trait_bound_self_type(ty = head, self_ty = self_ty), args = for arg in args {
      replace_trait_bound_self_type(ty = arg, self_ty = self_ty)
    }),
    CtArray(elem) => CtArray(replace_trait_bound_self_type(ty = elem, self_ty = self_ty)),
    CtOption(elem) => CtOption(replace_trait_bound_self_type(ty = elem, self_ty = self_ty)),
    CtTuple(items) => CtTuple(for item in items {
      replace_trait_bound_self_type(ty = item, self_ty = self_ty)
    }),
    CtFn(params, ret, effect) => CtFn(for param in params {
      replace_trait_bound_self_type(ty = param, self_ty = self_ty)
    }, replace_trait_bound_self_type(ty = ret, self_ty = self_ty), effect),
    _ => ty
  }
}

fn trait_bound_type_expr(_ ty: Type) -> Option[TypeExpr] {
  canonical_trait_arg_type_expr(ty)
}

fn resolve_trait_bound_arg_expr(arg: TypeExpr, self_ty: Type, s: Subst, defs: Array[TypeDef]) -> Option[TypeExpr] {
  match arg {
    TyName(name) => if name == trait_bound_self_marker {
      trait_bound_type_expr(self_ty)
    } else match parse_trait_bound_vid(name) {
      Some(vid) => trait_bound_type_expr(subst_apply(s = s, ty = CtVar(vid))),
      None => trait_bound_type_expr(replace_trait_bound_self_type(ty = resolve_type_expr(te = arg, defs = defs), self_ty = self_ty))
    },
    TyApp(name, args) => {
      let resolved_head = if name == trait_bound_self_marker {
        trait_bound_type_expr(self_ty)
      } else match parse_trait_bound_vid(name) {
        Some(vid) => trait_bound_type_expr(subst_apply(s = s, ty = CtVar(vid))),
        None => Some(TyName(name))
      }
      let mapped = array_empty()
      let mut ok = true
      for nested in args {
        match resolve_trait_bound_arg_expr(arg = nested, self_ty = self_ty, s = s, defs = defs) {
          Some(next) => Array::push(mapped, value = next),
          None => {
            ok = false
          }
        }
      }
      match resolved_head {
        Some(TyName(head)) => if ok {
          trait_bound_type_expr(replace_trait_bound_self_type(ty = resolve_type_expr(te = TyApp(head, mapped), defs = defs), self_ty = self_ty))
        } else {
          None
        },
        _ => None
      }
    },
    TyTuple(items) => {
      let mapped = array_empty()
      let mut ok = true
      for item in items {
        match resolve_trait_bound_arg_expr(arg = item, self_ty = self_ty, s = s, defs = defs) {
          Some(next) => Array::push(mapped, value = next),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyTuple(mapped))
      } else {
        None
      }
    },
    TyFn(params, ret, effect) => {
      let mapped = array_empty()
      let mut ok = true
      for param in params {
        match resolve_trait_bound_arg_expr(arg = param, self_ty = self_ty, s = s, defs = defs) {
          Some(next) => Array::push(mapped, value = next),
          None => {
            ok = false
          }
        }
      }
      match resolve_trait_bound_arg_expr(arg = ret, self_ty = self_ty, s = s, defs = defs) {
        Some(next_ret) => if ok {
          Some(TyFn(mapped, next_ret, effect))
        } else {
          None
        },
        None => None
      }
    },
    TyUnit => Some(TyUnit)
  }
}

/// #3947: the key an impl is registered under, with each type argument that
/// names none of the impl's own parameters resolved the way a bound's key is
/// (`resolve_trait_bound_self_reference`). A bound `[V: Value[Alias]]` is
/// judged as `Value[Int]` once `type Alias = Int` expands, so an impl written
/// `impl Value[Alias] for Note` has to be found under that same key; before,
/// it stayed `Value[Alias]` and the bound reported no impl. An argument that
/// does not resolve to a type a key can spell keeps its written form.
export fn canonical_impl_trait_key(key: String, tparams: Array[String], defs: Array[TypeDef]) -> String {
  canonical_trait_key(key = key, binders = tparams, defs = defs)
}

export fn resolve_trait_bound_self_reference(key: String, self_ty: Type, s: Subst, defs: Array[TypeDef]) -> String {
  match trait_ref_from_key(key) {
    Some(TyApp(name, args)) => {
      let mapped = array_empty()
      let mut ok = true
      for arg in args {
        match resolve_trait_bound_arg_expr(arg = arg, self_ty = self_ty, s = s, defs = defs) {
          Some(next) => Array::push(mapped, value = next),
          None => {
            ok = false
          }
        }
      }
      if ok {
        trait_ref_key(TyApp(name, mapped))
      } else {
        key
      }
    },
    _ => key
  }
}

fn resolve_trait_bound_args(args: Array[TypeExpr], env: TypeEnv, defs: Array[TypeDef], self_ty: Type, params: Array[String]) -> Array[Type] {
  let resolved = for arg in args {
    replace_trait_bound_self_type(ty = replace_trait_bound_vars_from_env(ty = resolve_type_expr(te = arg, defs = defs), env = env), self_ty = self_ty)
  }
  resolve_type_constructor_args(params = params, source_args = args, resolved_args = resolved, defs = defs, shadow = array_empty())
}

fn trait_bound_param_names(binders: Array[String], count: Int) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < count && i < Array::length(binders) {
    Array::push(out, value = Array::get(binders, at = i))
    i = i + 1
  }
  out
}

export fn trait_reference_display(_ key: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => print_type_expr(reference),
    None => key
  }
}

export fn validate_trait_reference(env: TypeEnv, key: String, context: String, errors: Array[String]) -> Unit {
  let display = trait_reference_display(key)
  let args = trait_ref_args(key)
  match trait_decl_params(env = env, name = key) {
    Some(params) => {
      if Array::length(args) > 0 && Array::length(args) != Array::length(params) {
        let counts = String::concat(__to_string(Array::length(params)), String::concat(" type argument(s), got ", __to_string(Array::length(args))))
        let site = String::concat(" in ", String::concat(context, String::concat(" `", String::concat(display, "`"))))
        Array::push(errors, value = String::concat("trait `", String::concat(trait_ref_name(key), String::concat("` expects ", String::concat(counts, site)))))
      } else {
        let defs = env_type_defs(env)
        let mut i = 0
        while i < Array::length(args) && i < Array::length(params) {
          report_one_type_argument_kind(owner = trait_ref_name(key), formal = type_param_name(Array::get(params, at = i)), expected = type_param_arity(Array::get(params, at = i)), actual_expr = Array::get(args, at = i), defs = defs, shadow = array_empty(), where_label = context, errors = errors)
          i = i + 1
        }
      }
    },
    None => ()
  }
}

/// Resolve a qualified identifier `T::method` where `T` is a bounded generic
/// type parameter (`[T: Trait]`). If the head resolves to a type variable whose
/// recorded bounds include a trait declaring `method`, return that method's
/// signature with `Self` substituted by T. Returns None for any other qualified
/// name (concrete `Type::method`, module-qualified names, etc.) so the existing
/// resolution paths are untouched. (PR-3 component 2.)
export fn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {
  let idx = String::index_of(name, needle = "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, start = 0, end = idx)
    let method = String::substring(name, start = idx + 2, end = String::length(name))
    match env_lookup(env = env, name = head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s = s, id = vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_key = Array::get(bounds, at = bi)
              let trait_name = trait_ref_name(trait_key)
              let trait_args = trait_ref_args(trait_key)
              match trait_method_sig_binders_deep(env = env, trait_name = trait_name, method_name = method) {
                Some(sig) => {
                  // #1512: the trait header's params and the method's own
                  // generics are binders, so they must shadow `defs` —
                  // otherwise `import { Hue as T }` captures the `T` of
                  // `trait Boxed[T] { unwrap(Self) -> T }`.
                  let (params_te, ret_te, binders) = sig
                  let param_names = trait_bound_param_names(binders = binders, count = Array::length(trait_args))
                  let trait_params = match trait_decl_params(env = env, name = trait_key) {
                    Some(ps) => ps,
                    None => array_empty()
                  }
                  let resolved_trait_args = resolve_trait_bound_args(args = trait_args, env = env, defs = defs, self_ty = self_ty, params = trait_params)
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(ty = subst_type_params(ty = subst_self_in_type(ty = resolve_type_expr_shadowed(te = pte, defs = defs, shadow = binders), self_ty = self_ty), params = param_names, args = resolved_trait_args), defs = defs)
                  }
                  let resolved_ret = relax_unknown_named(ty = subst_type_params(ty = subst_self_in_type(ty = resolve_type_expr_shadowed(te = ret_te, defs = defs, shadow = binders), self_ty = self_ty), params = param_names, args = resolved_trait_args), defs = defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}

/// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,
/// `Sh::Circle`) to the variant's constructor type, confirming that `head`
/// names a known enum that actually owns `member` (so unrelated `T::method`
/// names fall through to the `unknown name` path). Callers instantiate the
/// result exactly like a bare ident. (#672 qualified ctors.)
///
/// #1455: for a MONOMORPHIC enum the constructor type is built from `head`'s
/// own `TDEnum` rather than looked up under the BARE variant name. The old
/// `env_lookup(env, member)` made the qualifier purely cosmetic: it confirmed
/// ownership and then took whatever the flat, last-registered-wins env had
/// under `member`, so `A::Mk` and `B::Mk` resolved to the same type and a
/// qualified reference could not disambiguate anything. Building from the
/// `TDEnum` reproduces exactly what the SEnum arm binds for a local enum
/// (`CtEnum(name)` nullary, `CtFn(payloads, CtEnum(name), None)` otherwise)
/// and additionally works for an IMPORTED enum, whose bare constructors are in
/// the env but whose variant list only reaches this module through
/// `enum_def_env_name`.
///
/// A PARAMETERIZED enum validates ownership through `TDEnum` and then uses
/// the imported bare constructor's checked `CtForAll` scheme. The historical
/// `Enum::__variants__` carrier is deliberately not an authority source.
export fn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef], c: Int) -> Option[Type] {
  let idx = String::index_of(name, needle = "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, start = 0, end = idx)
    let member = String::substring(name, start = idx + 2, end = String::length(name))
    match find_enum_typedef(defs = defs, name = head) {
      Some(TDEnum(ename, params, variants)) => {
        let mut found = false
        let mut payloads = array_empty()
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, at = vi)
          if vname == member {
            found = true
            payloads = vtypes
          } else {
            ()
          }
          vi = vi + 1
        }
        if found {
          if Array::length(params) == 0 {
            if Array::length(payloads) == 0 {
              Some(CtEnum(ename))
            } else {
              Some(CtFn(payloads, CtEnum(ename), constructor_dependency_row(Array::length(payloads))))
            }
          } else {
            // The imported bare constructor is the checked `CtForAll` scheme.
            // `Enum::__variants__` is legacy data only and is never consulted
            // for authority, so a corrupt carrier cannot override EnvTypeDefs.
            env_lookup(env = env, name = member)
          }
        } else {
          None
        }
      },
      _ => host_effect_operation_type(defs = defs, qname = name)
    }
  }
}

/// ADR-0124 (#2656): the declaration of `name` when it is an `extern effect`,
/// whose operations the host provides.
fn host_effect_def(defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  match find_typedef(defs = defs, name = name) {
    Some(TDEffect(ename, ops, params, kinds, HostProvided)) => Some(TDEffect(ename, ops, params, kinds, HostProvided)),
    _ => None
  }
}

/// True when `name` is an `extern effect` (ADR-0124).
export fn effect_is_host_provided(defs: Array[TypeDef], name: String) -> Bool {
  match host_effect_def(defs = defs, name = name) {
    Some(_) => true,
    None => false
  }
}

/// ADR-0124 (#2656): an operation of an `extern effect` is a host function on
/// the capability track, called as `Kv::get(k)` the way `Fs::read_file(p)`
/// is: its type is the declared signature with the effect as its row.
export fn host_effect_operation_type(defs: Array[TypeDef], qname: String) -> Option[Type] {
  let at = String::index_of(qname, needle = "::")
  if at <= 0 {
    None
  } else {
    let eff = String::substring(qname, start = 0, end = at)
    let op = String::substring(qname, start = at + 2, end = String::length(qname))
    match host_effect_def(defs = defs, name = eff) {
      Some(TDEffect(_, ops, _, _, _)) => {
        let mut found: Option[Type] = None
        for entry in ops {
          let (oname, oparams, oret) = entry
          if oname == op {
            found = Some(CtFn(oparams, oret, Some(eff)))
          }
        }
        found
      },
      _ => None
    }
  }
}

/// ADR-0124 (#2656): `perform` and `handle` reach only program-handled
/// effects. The refusal for an operation of an `extern effect`, or None.
export fn host_effect_operation_misuse(defs: Array[TypeDef], qname: String, use_kind: String) -> Option[String] {
  let at = String::index_of(qname, needle = "::")
  if at <= 0 {
    None
  } else {
    let eff = String::substring(qname, start = 0, end = at)
    if effect_is_host_provided(defs = defs, name = eff) {
      if use_kind == "perform" {
        Some("call `\{qname}(..)` without `perform`: `\{eff}` is an `extern effect`, so its operations are host functions rather than performed operations")
      } else {
        Some("remove this handler arm: `\{eff}` is an `extern effect`, so the host provides `\{qname}` and a program cannot handle it -- to replace it in a test, bind a mock provider instead (#2656)")
      }
    } else {
      None
    }
  }
}

export fn expr_ident_name_or_empty(_ expr: Expr) -> String {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}

/// True when a type is fully ground (mentions no type parameter / type
/// variable). An unresolved type name resolves to `CtNamed(_, _)` (see
/// resolve_type_expr), which for a struct field or function parameter means a
/// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used
/// both to restrict record struct-identity recovery to MONOMORPHIC structs (a
/// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`
/// relies on) and to gate structural-mismatch reporting to concrete types.

// #1324 removed the #941 `railway_head` / `railway_heads_conflict` pair,
// which reported an Option-vs-Result head conflict on one railway. `Result`
// is no longer a language- or prelude-provided type, so `?`/`let*` lower only
// to `Option` and there is no second built-in monad to conflict with.
//
// The mismatch #941 was written for is still reported: a `?` / `let*`
// inside a function that does not return Option is caught by the #1947
// railway-origin hook (source-level `?` / `let*` message), not by the
// generic `return None` / `Option[?]` debris of the desugar.

/// Best-effort source anchor for a (possibly desugar-generated) expr — the
/// first real char offset found walking into the value position, or -1. The
/// railway desugar (#635) threads the `?`/`let*` operand's offset into its
/// generated `None` failure-track nodes, so a diagnostic on desugar output
/// still locates at the offending operand.
export fn railway_expr_off(_ e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    EString(_, off) => off,
    EIf(_, t, els) => {
      let toff = railway_expr_off(t)
      if toff >= 0 {
        toff
      } else {
        railway_expr_off(els)
      }
    },
    ECall(callee, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_expr_off(base)
    },
    EBinOp(_, lhs, _, _) => railway_expr_off(lhs),
    EMatch(scrut, _) => railway_expr_off(scrut),
    ESeq(first, _) => railway_expr_off(first),
    _ => 0 - 1
  }
}
