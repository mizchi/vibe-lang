/// True when a UNARY operator's operand is concrete enough to reject: the
/// operand cannot be the primitive the operator needs, whatever else is still
/// unresolved about it. Shared by `!`, unary `-` and `~` (#2408) -- they take
/// different primitives, but each has already matched its own accepting arms
/// (`CtBool` / `CtInt` / `CtDouble` / `CtVar`) before consulting this, so the
/// question left is the same one for all three.
///
/// `type_is_ground` alone is NOT that question, and the gap was silently
/// wrong: it answers `false` for every `CtNamed` and for a container whose
/// element is not ground, so `-x` on a `Cell[Int]` or a `Map` compiled clean
/// and complemented the heap pointer, returning -237 as an ordinary `Int`.
///
/// The four rows below are the routes into that `false`, each measured
/// separately (#2403 found them one at a time for `~`):
///   * a name that resolves to a DECLARED struct or enum -- not a type formal,
///     so never a primitive
///   * a name with no `TypeDef` at all but which IS a builtin head -- `Map`,
///     `MutMap`, `StringBuilder`, and the width primitives `i64`/`u8`/`v128`.
///     A raw `i64` is not a 63-bit tagged `Int`
///   * a container / tuple / function value -- the OUTER constructor settles
///     it; `type_is_ground` asks about the contents, so `Array[T]` slipped
///   * anything else ground
///
/// What must stay permissive: a bare `CtNamed(nm, [])` with no declaration is
/// a rigid type formal and may yet be the primitive. `Int` / `i32` / `Bool` /
/// `Double` never arrive here at all -- they resolve to `CtInt` / `CtBool` /
/// `CtDouble` and are taken by the accepting arms above.
export fn unary_operand_is_definitely_wrong(t: Type, defs: Array[TypeDef]) -> Bool {
  match t {
    CtUnknown => false,
    CtNamed(nm, _) => match find_typedef(defs, nm) {
      Some(TDStruct(_, _, _, _)) => true,
      Some(TDEnum(_, _, _)) => true,
      _ => is_builtin_type_name(nm)
    },
    CtArray(_) => true,
    CtOption(_) => true,
    CtTuple(_) => true,
    CtFn(_, _, _) => true,
    _ => type_is_ground(t)
  }
}

/// #1340 (ADR-0071): ground modulo a set of rigid names — a generic effect's
/// declared op return type is usable as the perform's value type when its
/// only non-ground parts are the effect's OWN type params (which the caller
/// substitutes with fresh inference vars before use). Any other CtNamed /
/// CtVar / CtForAll keeps the conservative fresh-var fallback, exactly like
/// type_is_ground does for non-generic effects.
export fn type_is_ground_except(t: Type, allowed: Array[String]) -> Bool {
  match t {
    CtNamed(nm, targs) => if Array::length(targs) == 0 {
      let mut found = false
      let mut i = 0
      while i < Array::length(allowed) {
        if Array::get(allowed, i) == nm {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    } else {
      false
    },
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground_except(Array::get(items, i), allowed) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground_except(e, allowed),
    CtOption(e) => type_is_ground_except(e, allowed),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground_except(r, allowed)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground_except(Array::get(ps, i), allowed) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

/// #1081 step 3: does a FULLY-ZONKED type contain a `CtNamed` with exactly
/// this name anywhere in its structure? Used to detect a region skolem
/// (`"#region_<n>"`, unforgeable by parsed source) escaping its
/// `TaskGroup::run` call. The caller must `subst_apply` before calling this
/// — an un-zonked `CtVar` cannot be inspected here (deliberately no
/// substitution lookup: this function has no `Subst` to chase, and the two
/// call sites both already pass zonked input).
export fn type_mentions_named(ty: Type, name: String) -> Bool {
  match ty {
    CtNamed(n, targs) => if n == name {
      true
    } else {
      let mut found = false
      let mut i = 0
      while i < Array::length(targs) {
        if type_mentions_named(Array::get(targs, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) {
        if type_mentions_named(Array::get(items, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtArray(e) => type_mentions_named(e, name),
    CtOption(e) => type_mentions_named(e, name),
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, field_ty) = field
        if type_mentions_named(field_ty, name) {
          found = true
        } else {
          ()
        }
      }
      found
    },
    CtFn(ps, ret, eff) => {
      let mut found = type_mentions_named(ret, name)
      match eff {
        Some(row) => {
          let labels = String::split(row, ",")
          let mut ei = 0
          while ei < Array::length(labels) {
            if String::trim(Array::get(labels, ei)) == name {
              found = true
            }
            ei = ei + 1
          }
        },
        None => ()
      }
      let mut i = 0
      while i < Array::length(ps) {
        if type_mentions_named(Array::get(ps, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    CtForAll(_, _, body) => type_mentions_named(body, name),
    _ => false
  }
}

export fn merge_provenance_row(expected: Option[String], actual: Option[String]) -> Option[String] {
  merge_provenance_row_at(expected, actual, false)
}

fn merge_provenance_row_at(expected: Option[String], actual: Option[String], join_values: Bool) -> Option[String] {
  let labels = match expected {
    Some(row) => for raw in String::split(row, ",") {
      String::trim(raw)
    },
    None => array_empty()
  }
  match actual {
    Some(row) => for raw in String::split(row, ",") {
      let label = String::trim(raw)
      if (String::starts_with(label, "#region_") || String::starts_with(label, "#capture[") || String::starts_with(label, "#param[") || String::starts_with(label, "#aliasparam[") || String::starts_with(label, "#fieldparam[") || is_effect_inst_label(label) || (join_values && effect_payload_row_item(label))) && !checker_string_array_has(labels, label) {
        Array::push(labels, label)
      }
    },
    None => array_empty()
  }
  if Array::length(labels) == 0 {
    None
  } else {
    Some(String::join(labels, ", "))
  }
}

/// Constructor results retain every payload. Record that dependency in the
/// same checker-only row used by field-projection helpers, so direct,
/// qualified, imported, and first-class enum constructors share one contract.
export fn constructor_dependency_row(arity: Int) -> Option[String] {
  if arity <= 0 {
    None
  } else if arity == 1 {
    Some("#fieldparam[0]")
  } else if arity == 2 {
    Some("#fieldparam[0], #fieldparam[1]")
  } else if arity == 3 {
    Some("#fieldparam[0], #fieldparam[1], #fieldparam[2]")
  } else {
    let labels = array_empty()
    let mut i = 0
    while i < arity {
      Array::push(labels, String::concat("#fieldparam[", String::concat(__to_string(i), "]")))
      i = i + 1
    }
    Some(String::join(labels, ", "))
  }
}

/// An explicit return annotation constrains the public shape but must not
/// erase checker-only capture provenance synthesized on the returned value.
export fn merge_capture_provenance(expected: Type, actual: Type) -> Type {
  merge_capture_provenance_at(expected, actual, false)
}

/// Value-producing alternatives retain every possible effect payload, even
/// when ordinary function-row compatibility compares only the effect base.
/// No carrier-bearing type means no substitution walk or aggregate rebuild.
export fn merge_value_effect_provenance(expected: Type, actual: Type, s: Subst) -> Type {
  if type_has_effect_payload(actual, s) {
    merge_capture_provenance_at(subst_apply(s, expected), subst_apply(s, actual), true)
  } else {
    expected
  }
}

fn effect_payload_row_item(label: String) -> Bool {
  !String::starts_with(label, "#") && String::index_of(label, "[") > 0
}

fn type_has_effect_payload(t: Type, s: Subst) -> Bool {
  match t {
    CtVar(_) => {
      let resolved = subst_apply(s, t)
      match resolved {
        CtVar(_) => false,
        _ => type_has_effect_payload(resolved, s)
      }
    },
    CtFn(params, ret, row) => {
      let mut hit = false
      match row {
        Some(text) => if String::contains(text, "#einst:") {
          hit = true
        } else if String::contains(text, "[") {
          for raw in String::split(text, ",") {
            if effect_payload_row_item(String::trim(raw)) {
              hit = true
            }
          }
        },
        None => ()
      }
      hit || types_have_effect_payload(params, s) || type_has_effect_payload(ret, s)
    },
    CtArray(item) => type_has_effect_payload(item, s),
    CtOption(item) => type_has_effect_payload(item, s),
    CtTuple(items) => types_have_effect_payload(items, s),
    CtNamed(_, items) => types_have_effect_payload(items, s),
    CtApplied(head, items) => type_has_effect_payload(head, s) || types_have_effect_payload(items, s),
    CtForAll(_, _, body) => type_has_effect_payload(body, s),
    CtRecord(fields) => {
      let mut hit = false
      for field in fields {
        let (_, item) = field
        if type_has_effect_payload(item, s) {
          hit = true
        }
      }
      hit
    },
    _ => false
  }
}

fn types_have_effect_payload(items: Array[Type], s: Subst) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(items) && !hit {
    hit = type_has_effect_payload(Array::get(items, i), s)
    i = i + 1
  }
  hit
}

fn merge_capture_provenance_at(expected: Type, actual: Type, join_values: Bool) -> Type {
  match expected {
    CtFn(eps, eret, eeff) => match actual {
      CtFn(aps, aret, aeff) => {
        let params = array_empty()
        let mut i = 0
        while i < Array::length(eps) {
          if i < Array::length(aps) {
            Array::push(params, merge_capture_provenance_at(Array::get(eps, i), Array::get(aps, i), join_values))
          } else {
            Array::push(params, Array::get(eps, i))
          }
          i = i + 1
        }
        CtFn(params, merge_capture_provenance_at(eret, aret, join_values), merge_provenance_row_at(eeff, aeff, join_values))
      },
      _ => expected
    },
    CtArray(ee) => match actual {
      CtArray(ae) => CtArray(merge_capture_provenance_at(ee, ae, join_values)),
      _ => expected
    },
    CtOption(ee) => match actual {
      CtOption(ae) => CtOption(merge_capture_provenance_at(ee, ae, join_values)),
      _ => expected
    },
    CtTuple(es) => match actual {
      CtTuple(as_) => {
        let items = array_empty()
        let mut i = 0
        while i < Array::length(es) {
          if i < Array::length(as_) {
            Array::push(items, merge_capture_provenance_at(Array::get(es, i), Array::get(as_, i), join_values))
          } else {
            Array::push(items, Array::get(es, i))
          }
          i = i + 1
        }
        CtTuple(items)
      },
      _ => expected
    },
    CtRecord(efields) => match actual {
      CtRecord(afields) => {
        let fields = array_empty()
        let mut i = 0
        while i < Array::length(efields) {
          let (name, field_ty) = Array::get(efields, i)
          let merged = if i < Array::length(afields) {
            let (actual_name, actual_ty) = Array::get(afields, i)
            if name == actual_name {
              merge_capture_provenance_at(field_ty, actual_ty, join_values)
            } else {
              field_ty
            }
          } else {
            field_ty
          }
          Array::push(fields, (name, merged))
          i = i + 1
        }
        CtRecord(fields)
      },
      _ => expected
    },
    CtNamed(name, eargs) => match actual {
      CtNamed(aname, aargs) => if name == aname {
        let args = array_empty()
        let mut i = 0
        while i < Array::length(eargs) {
          if i < Array::length(aargs) {
            Array::push(args, merge_capture_provenance_at(Array::get(eargs, i), Array::get(aargs, i), join_values))
          } else {
            Array::push(args, Array::get(eargs, i))
          }
          i = i + 1
        }
        CtNamed(name, args)
      } else expected,
      _ => expected
    },
    _ => expected
  }
}

/// #1081 step 3: every (name, type) binding currently visible in `env`,
/// walking the same cons-chain shape `env_cache` (core/types.vibe) already
/// walks — trait-def/impl layers carry no ordinary value binding and are
/// skipped, matching that traversal. Used by the `TaskGroup::run` escape
/// check to scan every OUTER binding (never a binding local to the nursery
/// body itself, since those live in a DERIVED env built while checking the
/// body, not in the `env` captured at the call site) for a leaked region
/// skolem after the body has been checked.
export fn collect_env_bindings(env: TypeEnv, acc: Array[(String, Type)]) -> Unit {
  match env {
    EnvEmpty => (),
    EnvBind(n, binding, rest) => {
      Array::push(acc, (n, binding.ty))
      collect_env_bindings(rest, acc)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => collect_env_bindings(rest, acc),
    EnvTraitImpl(_, _, rest) => collect_env_bindings(rest, acc),
    EnvShowWrappers(_, _, rest) => collect_env_bindings(rest, acc),
    EnvMutCell(_, _, rest) => collect_env_bindings(rest, acc),
    EnvTraitImplGen(_, _, _, _, rest) => collect_env_bindings(rest, acc),
    EnvTypeDefs(_, _, rest) => collect_env_bindings(rest, acc),
    EnvFlat(bindings) => {
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, i)
        Array::push(acc, (name, binding.ty))
        i = i + 1
      }
    },
    EnvCached(names, types, rest) => {
      let mut i = 0
      while i < env_name_index_length(names) {
        Array::push(acc, (env_name_index_at(names, i), Array::get(types, i).ty))
        i = i + 1
      }
      collect_env_bindings(rest, acc)
    }
  }
}

export fn checker_string_array_has(items: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if Array::get(items, i) == wanted {
      found = true
    }
    i = i + 1
  }
  found
}

fn collect_region_skolems(ty: Type, out: Array[String]) -> Unit {
  match ty {
    CtNamed(name, args) => {
      if String::starts_with(name, "#region_") && !checker_string_array_has(out, name) {
        Array::push(out, name)
      }
      for arg in args {
        collect_region_skolems(arg, out)
      }
      ()
    },
    CtFn(params, ret, eff) => {
      for param in params {
        collect_region_skolems(param, out)
      }
      collect_region_skolems(ret, out)
      match eff {
        Some(row) => {
          for raw in String::split(row, ",") {
            let label = String::trim(raw)
            if String::starts_with(label, "#region_") && !checker_string_array_has(out, label) {
              Array::push(out, label)
            }
          }
          ()
        },
        None => ()
      }
    },
    CtArray(elem) => collect_region_skolems(elem, out),
    CtOption(elem) => collect_region_skolems(elem, out),
    CtTuple(items) => {
      for item in items {
        collect_region_skolems(item, out)
      }
      ()
    },
    CtRecord(fields) => {
      for field in fields {
        let (_, field_ty) = field
        collect_region_skolems(field_ty, out)
      }
      ()
    },
    CtForAll(_, _, body) => collect_region_skolems(body, out),
    _ => ()
  }
}

/// Region-backed handles can erase the captured region from a closure's
/// result through operations such as `to_array`. Recognize that nominal shape
/// even when a helper is checked before a region-tagged call site exists.
fn type_has_region_handle_shape(ty: Type) -> Bool {
  match ty {
    CtNamed(name, args) => {
      let mut found = name == "MutList" || name == "MutBytes"
      for arg in args {
        if type_has_region_handle_shape(arg) {
          found = true
        }
      }
      found
    },
    CtFn(params, ret, _) => {
      let mut found = type_has_region_handle_shape(ret)
      for param in params {
        if type_has_region_handle_shape(param) {
          found = true
        }
      }
      found
    },
    CtArray(elem) => type_has_region_handle_shape(elem),
    CtOption(elem) => type_has_region_handle_shape(elem),
    CtTuple(items) => {
      let mut found = false
      for item in items {
        if type_has_region_handle_shape(item) {
          found = true
        }
      }
      found
    },
    CtRecord(fields) => {
      let mut found = false
      for field in fields {
        let (_, field_ty) = field
        if type_has_region_handle_shape(field_ty) {
          found = true
        }
      }
      found
    },
    CtForAll(_, _, body) => type_has_region_handle_shape(body),
    _ => false
  }
}

export fn append_row_label(labels: Array[String], label: String) -> Unit {
  if !checker_string_array_has(labels, label) {
    Array::push(labels, label)
  }
}

/// The FREE type variables of a value. A scheme's own bound ids are excluded
/// -- they belong to another scope's counter domain, and `instantiate` renames
/// them precisely because they can collide with locally fresh ids (#743) --
/// but its body IS walked, because what a scheme leaves free is an enclosing
/// binding's slot showing through.
///
/// Codex P1 on #2458 asked for exactly this. It was implemented, measured to
/// change no answer for #2455's binder check, and reverted rather than shipped
/// on faith. #2459 supplied the input that makes it load-bearing: `let g2 = g`
/// where `g` captures `let xs = []` reads `g`'s scheme, and the slot that must
/// not be quantified is precisely the one free variable inside it. Without the
/// descent `env_reachable_tvars` returns nothing there and the alias
/// generalizes a captured array -- measured, `1 | s` in one array at runtime.
///
/// The #829 hazard the revert cited is real but narrower than it reads: a
/// scheme's free ids are not renamed by `instantiate`, so an IMPORTED
/// scheme's free id can collide with a local one. That costs a spurious
/// exclusion (a binding stays monomorphic) rather than a wrong answer, which
/// is the safe direction for both callers.
export fn escape_tvars_into(ty: Type, out: Array[Int]) -> Unit {
  match ty {
    CtVar(id) => if !esc_int_has(out, id) {
      Array::push(out, id)
    } else {
      ()
    },
    CtFn(ps, r, _) => {
      let mut i = 0
      while i < Array::length(ps) {
        escape_tvars_into(Array::get(ps, i), out)
        i = i + 1
      }
      escape_tvars_into(r, out)
    },
    CtArray(elem) => escape_tvars_into(elem, out),
    CtOption(elem) => escape_tvars_into(elem, out),
    CtTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        escape_tvars_into(Array::get(elems, i), out)
        i = i + 1
      }
    },
    CtRecord(rfields) => {
      let mut i = 0
      while i < Array::length(rfields) {
        let (_, rft) = Array::get(rfields, i)
        escape_tvars_into(rft, out)
        i = i + 1
      }
    },
    CtNamed(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        escape_tvars_into(Array::get(args, i), out)
        i = i + 1
      }
    },
    CtApplied(head, args) => {
      escape_tvars_into(head, out)
      let mut i = 0
      while i < Array::length(args) {
        escape_tvars_into(Array::get(args, i), out)
        i = i + 1
      }
    },
    CtForAll(bound, _, scheme_body) => {
      let inner = array_empty()
      escape_tvars_into(scheme_body, inner)
      let mut i = 0
      while i < Array::length(inner) {
        let id = Array::get(inner, i)
        if esc_int_has(bound, id) || esc_int_has(out, id) {
          ()
        } else {
          Array::push(out, id)
        }
        i = i + 1
      }
    },
    _ => ()
  }
}

export fn esc_int_has(xs: Array[Int], v: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) && !found {
    if Array::get(xs, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn binding_predates_active_region(name: String, env: TypeEnv) -> Bool {
  match env {
    EnvShowWrappers(_, _, rest) => binding_predates_active_region(name, rest),
    EnvEmpty => false,
    EnvBind(n, _, rest) => if n == name {
      false
    } else if n == "#active_region" {
      match env_lookup(rest, name) {
        Some(_) => true,
        None => false
      }
    } else {
      binding_predates_active_region(name, rest)
    },
    EnvMutCell(n, _, rest) => if n == name {
      false
    } else {
      binding_predates_active_region(name, rest)
    },
    EnvTraitDef(_, _, _, _, rest, _, _) => binding_predates_active_region(name, rest),
    EnvTraitImpl(_, _, rest) => binding_predates_active_region(name, rest),
    EnvTraitImplGen(_, _, _, _, rest) => binding_predates_active_region(name, rest),
    EnvTypeDefs(_, _, rest) => binding_predates_active_region(name, rest),
    EnvCached(_, _, rest) => binding_predates_active_region(name, rest),
    EnvFlat(_) => false
  }
}

fn push_unique_dependency_index(out: Array[Int], index: Int) -> Unit {
  let mut found = false
  for existing in out {
    if existing == index {
      found = true
    }
  }
  if !found {
    Array::push(out, index)
  }
}

fn alias_result_reaches_outer_binding(ty: Type, args: Array[Expr], env: TypeEnv) -> Bool {
  match ty {
    CtForAll(_, _, body) => alias_result_reaches_outer_binding(body, args, env),
    CtFn(_, _, effect) => match effect {
      Some(row) => if String::contains(row, "#aliasparam[") {
        let mut found = false
        for raw in String::split(row, ",") {
          if !found {
            let label = String::trim(raw)
            if String::starts_with(label, "#aliasparam[") {
              let close = String::index_of(label, "]")
              let mut id = 0
              let mut p = 12
              while p < close {
                id = id * 10 + (String::char_code_at(label, p) - 48)
                p = p + 1
              }
              if id >= 0 && id < Array::length(args) && expression_aliases_outer_binding(Array::get(args, id), env) {
                found = true
              }
            }
          }
        }
        found
      } else {
        false
      },
      None => false
    },
    _ => false
  }
}

export fn decimal_index(text: String) -> Int {
  let mut out = 0
  let mut i = 0
  while i < String::length(text) {
    out = out * 10 + (String::char_code_at(text, i) - 48)
    i = i + 1
  }
  out
}

export fn expression_aliases_outer_binding(expr: Expr, env: TypeEnv) -> Bool {
  match expr {
    EIdent(name, _) => binding_predates_active_region(name, env) || match env_lookup(env, String::concat("__region_outer_alias__", name)) {
      Some(_) => true,
      None => false
    },
    ECall(EIdent(callee, _), args, _, _) => match env_lookup(env, callee) {
      Some(callee_ty) => {
        let mut found = false
        match env_lookup(env, String::concat("__alias_contract__", callee)) {
          Some(CtNamed(index_text, _)) => {
            let index = decimal_index(index_text)
            if index >= 0 && index < Array::length(args) {
              found = expression_aliases_outer_binding(Array::get(args, index), env)
            }
          },
          _ => ()
        }
        if !found && alias_result_reaches_outer_binding(callee_ty, args, env) {
          found = true
        }
        found
      },
      None => false
    },
    ECall(EFn(_, _, params, _, _, body), args, _, _) => {
      let mut found = false
      for index in direct_result_param_indices(body, params) {
        if index >= 0 && index < Array::length(args) && expression_aliases_outer_binding(Array::get(args, index), env) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

export fn collect_result_param_indices(body: Expr, params: Array[(String, Option[TypeExpr])], alias_names: Array[String], alias_indices: Array[Int], found: Array[Int]) -> Unit {
  match body {
    EIdent(name, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (raw_name, _) = Array::get(params, i)
        let nlen = String::length(raw_name)
        let param_name = if nlen > 0 {
          let last = String::char_code_at(raw_name, nlen - 1)
          if last == '~' || last == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        if name == param_name {
          push_unique_dependency_index(found, i)
        }
        i = i + 1
      }
      let mut alias_i = 0
      while alias_i < Array::length(alias_names) {
        if name == Array::get(alias_names, alias_i) {
          push_unique_dependency_index(found, Array::get(alias_indices, alias_i))
        }
        alias_i = alias_i + 1
      }
    },
    ELet(name, value, rest, _) => {
      let found_mark = Array::length(found)
      let alias_mark = Array::length(alias_names)
      collect_result_param_indices(value, params, alias_names, alias_indices, found)
      let mut i = found_mark
      while i < Array::length(found) {
        Array::push(alias_names, name)
        Array::push(alias_indices, Array::get(found, i))
        i = i + 1
      }
      Array::truncate(found, found_mark)
      collect_result_param_indices(rest, params, alias_names, alias_indices, found)
      Array::truncate(alias_names, alias_mark)
      Array::truncate(alias_indices, alias_mark)
    },
    ESeq(_, right) => collect_result_param_indices(right, params, alias_names, alias_indices, found),
    EIf(_, then_expr, else_expr) => {
      collect_result_param_indices(then_expr, params, alias_names, alias_indices, found)
      collect_result_param_indices(else_expr, params, alias_names, alias_indices, found)
    },
    _ => ()
  }
}

export fn direct_result_param_indices(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Array[Int] {
  let found = array_empty()
  collect_result_param_indices(body, params, array_empty(), array_empty(), found)
  found
}

export fn direct_result_param_index(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Option[Int] {
  let indices = direct_result_param_indices(body, params)
  if Array::length(indices) > 0 {
    Some(Array::get(indices, 0))
  } else {
    None
  }
}

fn result_field_param_index(body: Expr, params: Array[(String, Option[TypeExpr])], alias_names: Array[String], alias_indices: Array[Int]) -> Option[Int] {
  match body {
    EDot(EIdent(name, _), _, _, _) => {
      let mut found = None
      let mut i = 0
      while i < Array::length(params) {
        let (raw_name, _) = Array::get(params, i)
        if name == raw_name {
          found = Some(i)
        }
        i = i + 1
      }
      found
    },
    EIdent(name, _) => {
      let mut found = None
      let mut i = 0
      while i < Array::length(alias_names) {
        if Array::get(alias_names, i) == name {
          found = Some(Array::get(alias_indices, i))
        }
        i = i + 1
      }
      found
    },
    ELet(name, value, rest, _) => {
      let mark = Array::length(alias_names)
      match result_field_param_index(value, params, alias_names, alias_indices) {
        Some(index) => {
          Array::push(alias_names, name)
          Array::push(alias_indices, index)
        },
        None => ()
      }
      let found = result_field_param_index(rest, params, alias_names, alias_indices)
      Array::truncate(alias_names, mark)
      Array::truncate(alias_indices, mark)
      found
    },
    ESeq(_, right) => result_field_param_index(right, params, alias_names, alias_indices),
    EIf(_, then_expr, else_expr) => match result_field_param_index(then_expr, params, alias_names, alias_indices) {
      Some(index) => Some(index),
      None => result_field_param_index(else_expr, params, alias_names, alias_indices)
    },
    _ => None
  }
}

export fn direct_result_field_param_index(body: Expr, params: Array[(String, Option[TypeExpr])]) -> Option[Int] {
  result_field_param_index(body, params, array_empty(), array_empty())
}

export fn return_provenance_key(id: Int) -> Int {
  0 - id - 1000000000
}

/// #2386: the return-provenance keys written to the type table of the check
/// in progress. `return_provenance_was_written` scanned the WHOLE table --
/// one row per recorded expression of the module -- once per function body
/// checked, with no early exit; the only writer of such a key is
/// `append_legacy_typed_occurrence` at its one ReturnProvenance site, and
/// every program check starts from a fresh table, so the set is reset where
/// the table is (`reset_return_provenance_index`, the three creation sites
/// in checker_stmt.vibe) and marked where the row is pushed.
export let return_provenance_index: Array[MutMap[String, Int]] = [
  MutMap::new_string()
]

export fn reset_return_provenance_index() -> Unit {
  Array::set(return_provenance_index, 0, MutMap::new_string())
}

/// #3017: every `throw` payload's inferred type, keyed by the `perform` call's
/// offset plus a short spelling of the payload (`throw_payload_site_key`). The
/// effects pass is syntactic, so a builtin call's result, an unannotated `let`
/// and a field projection have no exception kind there; this table hands it
/// the type the checker already inferred. Reset per check with the other
/// per-run tables, and resolved under the final substitution by
/// `checker_stmt.vibe` before the effects pass reads it.
export let throw_payload_sites: Array[(String, Type)] = []

export fn reset_throw_payload_sites() -> Unit {
  Array::truncate(throw_payload_sites, 0)
  // #3033: a module's kind resolutions never answer for the next module.
  exception_kind_resolutions_clear()
}

export fn throw_payload_site_types() -> Array[(String, Type)] {
  throw_payload_sites
}

/// #3050: the value type of every local `let` / `let mut`, keyed by the
/// offset of its `let` keyword (the offset the parser gives `ELet` /
/// `ELetMut`). `vibe type-at` answers a local binder's declaration with it
/// when no use of the binder carries a row of its own -- a closure whose every
/// use is a call has none, because a callee's row is the CALL RESULT. Kept
/// apart from the per-node table so no consumer keyed by an expression offset
/// can read one of these rows; the types are raw, resolved by the caller
/// through the program's final substitution. Recorded only between
/// `local_let_types_begin` and `local_let_types_end`, which only
/// `check_program_type_table` calls, so a production check records nothing.
let local_let_type_rows: Array[(Int, Type)] = []
let local_let_type_recording: Array[Bool] = [false]

/// #3106: the same for a local `let rec`, keyed by the value's first located
/// node, or by the continuation's when the value has none (#3208). A separate
/// table keeps this key apart from ordinary `let` keyword offsets.
let local_let_rec_type_rows: Array[(Int, Type)] = []

export fn local_let_types_begin() -> Unit {
  Array::truncate(local_let_type_rows, 0)
  Array::truncate(local_let_rec_type_rows, 0)
  Array::set(local_let_type_recording, 0, true)
}

export fn local_let_types_end() -> Unit {
  Array::set(local_let_type_recording, 0, false)
}

/// The rows the last `check_program_type_table` recorded.
export fn local_let_types() -> Array[(Int, Type)] {
  local_let_type_rows
}

export fn record_local_let_type(let_off: Int, ty: Type, lane: String) -> Unit {
  if let_off >= 0 && lane == "Primary" && Array::get(local_let_type_recording, 0) {
    Array::push(local_let_type_rows, (let_off, ty))
  } else {
    ()
  }
}

/// The `let rec` rows the last `check_program_type_table` recorded (#3106).
export fn local_let_rec_types() -> Array[(Int, Type)] {
  local_let_rec_type_rows
}

export fn record_local_let_rec_type(value: Expr, body: Expr, ty: Type, lane: String) -> Unit {
  // The anchor walks the whole value, so it is taken only while recording.
  if lane == "Primary" && Array::get(local_let_type_recording, 0) {
    let anchor = let_rec_binding_anchor(value, body)
    if anchor >= 0 {
      Array::push(local_let_rec_type_rows, (anchor, ty))
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #2474 (a): the type-parameter variables bound so far in this check --
/// `(var id, formal name)` for every `[T]` an `EFn` header introduced. A plain
/// formal is a unification variable inside its body (#2130), so at a `==`
/// site nothing else distinguishes "the erased `T` of this function" from an
/// ordinary not-yet-solved inference variable (`[] == []`). The former is what
/// `==` cannot compare by content once lowered (one lowering serves every
/// instantiation, so the raw compare answers by reference identity for an
/// aggregate -- #2474); the latter is the untyped-empty channel's business.
/// Reset per check with the other per-run tables; variable ids restart with
/// the counter, so a stale row would alias a fresh variable.
export let eq_formal_vars: Array[(Int, String)] = []

/// Parallel to `eq_formal_vars`: the binder's arity (`F[_]` records 1, a
/// plain `T` records 0), so the suggested bound keeps the binder's kind --
/// `[F[_]: Eq]`, not `[F: Eq]`, which would re-declare `F` at kind `Type`
/// and invalidate every `F[A]` annotation (Codex on #2529).
export let eq_formal_arity: Array[Int] = []

/// Parallel to `eq_formal_vars`: the generic DECLARATION that introduced the
/// binder -- one id per `EFn` header with type parameters. `eq_group_stack`
/// holds the ids of the generic declarations whose bodies are being checked,
/// innermost last, so a binder's distance from a `==` site is its group's
/// position from the top: 0 is the declaration the site is written in, 1 the
/// enclosing one, and so on. Ownership by declaration, not by spelling, is
/// what lets the message place each edit (Codex on #2530: an outer `T` and an
/// inner `U` are two declarations' edits, a value parameter spelled `T` is not
/// a type binder, and two rigid `F[_]` binders are two binders).
export let eq_formal_group: Array[Int] = []

/// Parallel to `eq_formal_vars`: whether the binder is rigid in its body (the
/// `#hktformal.` spelling an unbounded HKT-related formal takes -- BOTH `F`
/// and `A` of `F[A]`). A rigid mention in a type carries the spelling only,
/// so it is attributed to every open rigid binder of that spelling.
let eq_formal_rigid: Array[Bool] = []

/// #3101: parallel to `eq_formal_vars`: how many generic declarations were
/// already open around the binder's own -- 0 for a top-level `fn f[S]`, 1 for
/// a generic lambda directly inside it, and so on. Two binders in scope at
/// once never share a depth, so the depth tells an outer `S` from an inner
/// `S` where the spelling cannot; the effects pass counts its own lexical
/// formal scope the same way (`row_scope_generic_depth_of`).
export let eq_formal_depth: Array[Int] = []
let eq_group_stack: Array[Int] = []
let eq_group_next: Array[Int] = [0]

/// #2848 (Codex on #2864): field reads whose receiver was STILL an unsolved
/// variable when the `EDot` arm judged them -- `(variable id, field, field
/// offset, dot offset)`. An unannotated lambda parameter is such a variable,
/// and it is unified with its argument only when the lambda is applied, which
/// may be after the read has been checked: `let f = (p) -> { p.payload };
/// f(m)` inside `fn read[T](m: T)` typed the read with `p` unsolved, accepted
/// it for good, and codegen then resolved the field by spelling -- the exact
/// silent-wrong answer the immediate refusal closes for `m.payload`. Each row
/// is judged again by `resolve_deferred_field_reads` with the same arms once
/// the enclosing function body has been checked, and once more with the
/// program's final substitution; a row that resolves is dropped, a row that
/// is still a variable stays tolerated. The fifth slot is the receiver's
/// spelling when it is a plain identifier (`p`), so the generalization
/// refusal (`refuse_generalized_field_reads`) can name the parameter to
/// annotate; "" otherwise. The sixth is the RESULT variable the read was
/// typed with (Codex on #2864, round 2): the projection used to type as
/// `CtUnknown`, which unifies with anything, so `(p) -> { p.v }` passed where
/// `(Holder) -> String` was expected and the `Int` field flowed on as a
/// `String`. The read now types as a fresh variable, and the pass that
/// resolves the receiver unifies that variable with the field's real type --
/// a use that already fixed it to something else is a located mismatch, and
/// a chained projection (`p.a.b`) is recorded against it and resolves in
/// turn. Reset with the other per-run tables.
export let deferred_field_reads: Array[(Int, String, Int, Int, String, Int)] = [
]

/// #3297: `==` / `!=` sites whose operand type still mentioned a type
/// variable when the operator was checked -- `(diagnostic anchor, operand
/// type, operator)`. A `let`-bound lambda's unannotated parameter is such a
/// variable, and `let_generalize` may QUANTIFY it afterwards, at which point
/// the body is lowered once for callers of every type and the comparison has
/// no type to compare by. `refuse_generalized_eq_sites` judges the rows after
/// each generalization; a row whose type has resolved is dropped there. Reset
/// with the other per-run tables.
export let deferred_eq_sites: Array[(Int, Type, String)] = []

/// #3297 (Codex P2 on #3324): the declared types whose `::equals` the
/// program writes itself, filled by `note_source_comparator_heads` from each
/// statement list the checker walks. Reset with the other per-run tables.
export let eq_source_comparator_heads: Array[String] = []

/// #3149: the generic formals whose scheme the body constrained (bound to a
/// concrete head, so the declaration's scheme substitutes them) AND whose
/// every caller is known to have been checked against that scheme: a
/// non-exported top-level declaration no earlier statement of its list
/// references. A caller written ABOVE the declaration was checked against the
/// hoisted signature, which knows nothing of the body; an exported one may be
/// called through a contract that says the same. For these formals the
/// #3145 / #3148 build-time refusal is redundant -- a Map argument is already
/// a type error at the call -- and is not filed. Reset per run.
let scheme_constrained_formals: Array[Int] = []

/// #3149: the formals each generic `EFn` substituted into its scheme, pending
/// until the enclosing top-level declaration decides whether they count as
/// constrained (`efn_head_bound_commit`).
export let efn_substituted_formals: Array[Int] = []

export fn efn_head_bound_mark() -> Int {
  Array::length(efn_substituted_formals)
}

/// Commit (or drop) the formals the declaration's value substituted since
/// `mark`. `callers_checked` is the declaration-level answer described at
/// `scheme_constrained_formals`.
export fn efn_head_bound_commit(mark: Int, callers_checked: Bool) -> Unit {
  if callers_checked {
    let mut i = mark
    while i < Array::length(efn_substituted_formals) {
      Array::push(scheme_constrained_formals, Array::get(efn_substituted_formals, i))
      i = i + 1
    }
  } else {
    ()
  }
  if mark <= Array::length(efn_substituted_formals) {
    Array::truncate(efn_substituted_formals, mark)
  } else {
    ()
  }
}

export fn scheme_formal_constrained(vid: Int) -> Bool {
  int_array_has(scheme_constrained_formals, vid)
}

export fn reset_eq_formal_vars() -> Unit {
  Array::truncate(scheme_constrained_formals, 0)
  Array::truncate(efn_substituted_formals, 0)
  Array::truncate(eq_formal_vars, 0)
  Array::truncate(eq_formal_arity, 0)
  Array::truncate(eq_formal_group, 0)
  Array::truncate(eq_formal_rigid, 0)
  Array::truncate(eq_formal_depth, 0)
  Array::truncate(eq_group_stack, 0)
  Array::set(eq_group_next, 0, 0)
  Array::truncate(deferred_field_reads, 0)
  Array::truncate(deferred_eq_sites, 0)
  Array::truncate(eq_source_comparator_heads, 0)
  Array::truncate(effect_inst_used_vars, 0)
}

/// #3341: the instantiation variables a generic effect's perform (or a call
/// of a function that performs it) has read from the environment in this
/// check. A lambda records in its type only the instantiations its body
/// used. Reset per run with the other tables, since variable ids restart.
export let effect_inst_used_vars: Array[Int] = []

/// #3341: note that the instantiation `targs` was read from the environment.
export fn note_effect_inst_used(targs: Array[Type]) -> Unit {
  for t in targs {
    match t {
      CtVar(id) => if !int_array_has(effect_inst_used_vars, id) {
        Array::push(effect_inst_used_vars, id)
      } else {
        ()
      },
      _ => ()
    }
  }
  ()
}

/// Open a generic declaration: allocate its group id and push it.
export fn eq_group_begin() -> Int {
  let gid = Array::get(eq_group_next, 0)
  Array::set(eq_group_next, 0, gid + 1)
  Array::push(eq_group_stack, gid)
  gid
}

export fn eq_group_end() -> Unit {
  if Array::length(eq_group_stack) > 0 {
    Array::truncate(eq_group_stack, Array::length(eq_group_stack) - 1)
  } else {
    ()
  }
}

/// Distance of declaration `gid` from the site: 0 for the innermost open
/// declaration, 1 for the one enclosing it, ...; 1 when the stack does not
/// hold it (a binder that is not the visible one is at least enclosing).
export fn eq_group_distance(gid: Int) -> Int {
  let n = Array::length(eq_group_stack)
  let mut i = n - 1
  let mut found = 0 - 1
  while i >= 0 {
    if Array::get(eq_group_stack, i) == gid {
      found = n - 1 - i
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  if found < 0 {
    1
  } else {
    found
  }
}

/// #3101: the index of declaration `gid` on the open-declaration stack (its
/// number of enclosing generic declarations), or -1 when it is not open.
fn eq_group_depth_of(gid: Int) -> Int {
  let mut found = 0 - 1
  let mut i = Array::length(eq_group_stack) - 1
  while i >= 0 {
    if Array::get(eq_group_stack, i) == gid {
      found = i
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  found
}

export fn eq_group_is_open(gid: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(eq_group_stack) {
    if Array::get(eq_group_stack, i) == gid {
      found = true
      i = Array::length(eq_group_stack)
    } else {
      i = i + 1
    }
  }
  found
}

/// A `__Vfp_`-spelled formal is the desugar's re-spelling of a user formal
/// inside a synthesized helper (`scope_formal_mark_prefix`,
/// normalize/desugar_trait_dict.vibe -- the `__arr_equals__` helper a generic
/// `Array[T]` comparison or a derived `equals` expands to). Those helpers
/// compare elements with a raw `==` by construction, and on the lane that
/// desugars before it checks (the single-source compile) the checker sees
/// them; the user's own site was already judged where it was written, so the
/// synthesized copy is not recorded. The spelling is sound as the signal
/// because the parser refuses a user-written `__Vfp_` type parameter
/// (parse_type_param_kind) -- only AST the compiler built can carry it.
export fn record_eq_formal_var(vid: Int, name: String, arity: Int, gid: Int, rigid: Bool) -> Unit {
  if String::starts_with(name, "__Vfp_") {
    ()
  } else {
    Array::push(eq_formal_vars, (vid, name))
    Array::push(eq_formal_arity, arity)
    Array::push(eq_formal_group, gid)
    Array::push(eq_formal_rigid, rigid)
    Array::push(eq_formal_depth, eq_group_depth_of(gid))
  }
}

/// The table row recording binder `vid`, or -1. Scanned from the most recent
/// row backwards and preferring a row whose declaration is still open: an
/// auxiliary re-check (`check_resume_values` re-checks each `resume(..)`
/// value of a handler arm with the same counter) can allocate one variable
/// id to two sibling binders, and the closed sibling's row must not answer
/// for the open one (Codex on #2530).
export fn eq_formal_row_of(vid: Int) -> Int {
  let mut i = Array::length(eq_formal_vars) - 1
  let mut found = 0 - 1
  let mut found_open = false
  while i >= 0 && !found_open {
    let (v, _) = Array::get(eq_formal_vars, i)
    if v == vid {
      if eq_group_is_open(Array::get(eq_formal_group, i)) {
        found = i
        found_open = true
      } else if found < 0 {
        found = i
      } else {
        ()
      }
    } else {
      ()
    }
    i = i - 1
  }
  found
}

/// The row a rigid `#hktformal.` mention stands for: the INNERMOST open rigid
/// binder spelled `name` -- the one the spelling denotes where the site is
/// written. The types carry the spelling only, so a value captured from an
/// enclosing declaration whose own rigid `F[_]` shares it cannot be told
/// apart; that case is named by `eq_formal_rigid_outer_exists` and surfaced
/// as a hint rather than as an edit on a declaration the site may not use.
export fn eq_formal_rigid_row(name: String) -> Int {
  let mut i = 0
  let mut best = 0 - 1
  let mut best_d = 0 - 1
  while i < Array::length(eq_formal_vars) {
    let (_, n) = Array::get(eq_formal_vars, i)
    if n == name && Array::get(eq_formal_rigid, i) && eq_group_is_open(Array::get(eq_formal_group, i)) {
      let d = eq_group_distance(Array::get(eq_formal_group, i))
      if best < 0 || d < best_d {
        best = i
        best_d = d
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  best
}

/// Whether an enclosing declaration also has an open rigid binder spelled
/// `name` (other than row `chosen`).
export fn eq_formal_rigid_outer_exists(name: String, chosen: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(eq_formal_vars) {
    let (_, n) = Array::get(eq_formal_vars, i)
    if i != chosen && n == name && Array::get(eq_formal_rigid, i) && eq_group_is_open(Array::get(eq_formal_group, i)) {
      found = true
      i = Array::length(eq_formal_vars)
    } else {
      i = i + 1
    }
  }
  found
}

/// Whether a binder spelled `name` sits in an open declaration NEARER the
/// site than distance `d` -- i.e. the spelling is genuinely shadowed there.
export fn eq_formal_name_shadowed_within(name: String, d: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(eq_formal_vars) {
    let (_, n) = Array::get(eq_formal_vars, i)
    if n == name && eq_group_is_open(Array::get(eq_formal_group, i)) && eq_group_distance(Array::get(eq_formal_group, i)) < d {
      found = true
      i = Array::length(eq_formal_vars)
    } else {
      i = i + 1
    }
  }
  found
}

export fn int_array_has(items: Array[Int], wanted: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if Array::get(items, i) == wanted {
      found = true
      i = Array::length(items)
    } else {
      i = i + 1
    }
  }
  found
}

/// `F[_]` for arity 1, `F[_, _]` for arity 2, bare `T` for arity 0.
export fn eq_formal_binder_spelling(name: String, arity: Int) -> String {
  if arity <= 0 {
    name
  } else {
    let mut out = String::concat(name, "[_")
    let mut i = 1
    while i < arity {
      out = String::concat(out, ", _")
      i = i + 1
    }
    String::concat(out, "]")
  }
}

/// Does `bound` entail `Eq` -- by name, or through its declared supertraits
/// (`trait Ord: Eq` in the builtin registry, a user `trait Key: Eq`)? Walks
/// `trait_supers` with a visited set, so a cyclic declaration terminates.
fn bound_entails_eq(env: TypeEnv, bound: String) -> Bool {
  let pending: Array[String] = [trait_ref_name(bound)]
  let seen: Array[String] = []
  let mut found = false
  while !found && Array::length(pending) > 0 {
    let cur = Array::get(pending, Array::length(pending) - 1)
    Array::truncate(pending, Array::length(pending) - 1)
    if cur == "Eq" {
      found = true
    } else if checker_string_array_has(seen, cur) {
      ()
    } else {
      Array::push(seen, cur)
      let supers = trait_supers(env, cur)
      let mut i = 0
      while i < Array::length(supers) {
        Array::push(pending, trait_ref_name(Array::get(supers, i)))
        i = i + 1
      }
    }
  }
  found
}

fn bounds_entail_eq(env: TypeEnv, bounds: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) {
    if bound_entails_eq(env, Array::get(bounds, i)) {
      found = true
      i = Array::length(bounds)
    } else {
      i = i + 1
    }
  }
  found
}

/// The recorded formals that `id` stands for under `s` -- `id` itself, or a
/// formal whose variable unify has since bound to `id` (unify picks a
/// representative in either direction, so `fn f[T](x: T) { let y = g(); y == x }`
/// may leave `y`'s variable as the survivor with `T` pointing at it). The
/// `Eq` bound is read off both the formal's own variable and the survivor:
/// `[T: Eq]` records its bound on `T`'s id, and `rigid_trait_bound_binop`
/// (order / `+`) may have transferred one onto the survivor. Collected as
/// `(var id, name)` and deduplicated by id, so two binders that share a
/// spelling stay two entries (the message tells them apart).
export fn eq_formal_names_for_var(id: Int, s: Subst, env: TypeEnv, out: Array[(Int, String)]) -> Unit {
  let rep_bounded = bounds_entail_eq(env, subst_bounds_for(s, id))
  let mut i = 0
  while i < Array::length(eq_formal_vars) {
    let (vid, name) = Array::get(eq_formal_vars, i)
    let stands_for = if vid == id {
      true
    } else {
      match subst_apply(s, CtVar(vid)) {
        CtVar(rid) => rid == id,
        _ => false
      }
    }
    if stands_for && !rep_bounded && !bounds_entail_eq(env, subst_bounds_for(s, vid)) && !eq_formals_has_vid(out, vid) {
      Array::push(out, (vid, name))
    } else {
      ()
    }
    i = i + 1
  }
}

/// #2066: the variables that stand for a type parameter of an open generic
/// declaration with no `Send` bound, resolved through `s`. The spawn-capture
/// check treats a `Future` payload that is one of these as possibly owning a
/// host stream (Codex on #3091); a `Send` bound rules that out, since a
/// `HostResponse` is not `Send`, and the call site checks the bound.
export fn unsent_open_formal_vars(s: Subst) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(eq_formal_vars) {
    let (vid, _) = Array::get(eq_formal_vars, i)
    if eq_group_is_open(Array::get(eq_formal_group, i)) {
      match subst_apply(s, CtVar(vid)) {
        CtVar(rep) => if !bounds_name_send(subst_bounds_for(s, vid)) && !bounds_name_send(subst_bounds_for(s, rep)) {
          Array::push(out, rep)
        } else {
          ()
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn bounds_name_send(bounds: Array[String]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(bounds) && !hit {
    hit = Array::get(bounds, i) == "Send"
    i = i + 1
  }
  hit
}

fn eq_formals_has_vid(items: Array[(Int, String)], vid: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    let (v, _) = Array::get(items, i)
    if v == vid {
      found = true
      i = Array::length(items)
    } else {
      i = i + 1
    }
  }
  found
}

// A marker bound carries no callable renderer. Read the method's actual
// signature, including inherited methods, rather than the trait's spelling.
fn interp_bounds_have_renderer(env: TypeEnv, bounds: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) && !found {
    match trait_method_sig_deep(env, trait_ref_name(Array::get(bounds, i)), "to_string") {
      Some((params, ret)) => if Array::length(params) == 1 {
        found = match (Array::get(params, 0), ret) {
          (TyName("Self"), TyName("String")) => true,
          _ => false
        }
      },
      None => ()
    }
    i = i + 1
  }
  found
}

// Reuse the checker's binder identities: aliases and inferred expression types
// retain a formal's identity even when its source spelling is shadowed.
export fn interp_erased_formal(ty: Type, s: Subst, env: TypeEnv) -> String {
  match subst_apply(s, ty) {
    CtVar(id) => {
      let mut i = Array::length(eq_formal_vars) - 1
      let mut found = ""
      while i >= 0 && found == "" {
        let (vid, name) = Array::get(eq_formal_vars, i)
        if eq_group_is_open(Array::get(eq_formal_group, i)) {
          match subst_apply(s, CtVar(vid)) {
            CtVar(rep) => if rep == id && !interp_bounds_have_renderer(env, subst_bounds_for(s, vid)) && !interp_bounds_have_renderer(env, subst_bounds_for(s, id)) {
              found = name
            },
            _ => ()
          }
        }
        i = i - 1
      }
      found
    },
    CtNamed(n, args) => if String::starts_with(n, "#hktformal.") {
      String::substring(n, 11, String::length(n))
    } else {
      interp_erased_formal_in(args, s, env)
    },
    CtArray(element) => interp_erased_formal(element, s, env),
    CtOption(element) => interp_erased_formal(element, s, env),
    CtTuple(items) => interp_erased_formal_in(items, s, env),
    CtRecord(fields) => {
      let mut found = ""
      let mut i = 0
      while i < Array::length(fields) && found == "" {
        let (_, field_type) = Array::get(fields, i)
        found = interp_erased_formal(field_type, s, env)
        i = i + 1
      }
      found
    },
    CtApplied(head, args) => {
      let found = interp_erased_formal(head, s, env)
      if found == "" {
        interp_erased_formal_in(args, s, env)
      } else {
        found
      }
    },
    _ => ""
  }
}

fn interp_erased_formal_in(types: Array[Type], s: Subst, env: TypeEnv) -> String {
  let mut found = ""
  let mut i = 0
  while i < Array::length(types) && found == "" {
    found = interp_erased_formal(Array::get(types, i), s, env)
    i = i + 1
  }
  found
}

/// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit
/// index string. Returns None for a non-numeric field (a real `.method`/.field)
/// so only genuine tuple projections are bounds-checked.
export fn parse_tuple_index(s: String) -> Option[Int] {
  let len = String::length(s)
  if len == 0 {
    None
  } else {
    let mut i = 0
    let mut val = 0
    let mut ok = true
    while i < len {
      let cc = String::char_code_at(s, i)
      if cc >= 48 && cc <= 57 {
        val = val * 10 + (cc - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(val)
    } else {
      None
    }
  }
}

// Forward the established checker API to its owning package.
export fn pat_binds_resume(p: Pat) -> Bool {
  resume_pat_binds_resume(p)
}

// Forward the established checker API to its owning package.
export fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {
  resume_reject_resume_outside_handler(e, sh, errors)
}

/// A lambda parameter's binder name without its `~` (labeled) / `?`
/// (optional) suffix, for the resume-value walk above.
export fn resume_walk_param_base(pn: String) -> String {
  let ln = String::length(pn)
  if ln > 0 && (pn[ln - 1: ln] == "~" || pn[ln - 1: ln] == "?") {
    pn[0: ln - 1]
  } else {
    pn
  }
}

/// The names in a kinded exception arm's kind (`Exception[Array[T]]`) that
/// the env binds as a type FORMAL of an enclosing declaration -- a plain
/// formal is a `CtVar`, a kinded one the `#hktformal.` marker (the EFn arm's
/// `tp_env`). They are handed to `resolve_type_expr_shadowed` so a
/// same-named import alias in `defs` cannot capture them (#1510).
/// #3011: `own` (a declaration's own formals) plus every name in `te` that the
/// env binds as an ENCLOSING declaration's formal -- the shadow set a
/// body-level `TypeExpr` must resolve under, so an import alias spelled like a
/// formal in scope cannot capture it.
export fn formal_shadow(te: TypeExpr, env: TypeEnv, own: Array[String]) -> Array[String] {
  let acc: Array[String] = []
  let mut i = 0
  while i < Array::length(own) {
    Array::push(acc, Array::get(own, i))
    i = i + 1
  }
  exception_kind_formals_in_env(te, env, acc)
}

export fn exception_kind_formals_in_env(te: TypeExpr, env: TypeEnv, acc: Array[String]) -> Array[String] {
  let note = (name: String) -> Unit {
    // A CtVar is a TYPE formal only when a binder recorded it under this
    // name; an unannotated VALUE parameter is a CtVar too, and treating it as
    // a formal let `let y: T = 1` shadow a real `type T` (#3022 review).
    let is_formal = match env_lookup(env, name) {
      Some(t) => match t {
        CtVar(vid) => {
          let row = eq_formal_row_of(vid)
          if row >= 0 {
            let (_, rname) = Array::get(eq_formal_vars, row)
            rname == name
          } else {
            false
          }
        },
        CtNamed(n, _) => String::starts_with(n, "#hktformal."),
        _ => false
      },
      None => false
    }
    if is_formal && !checker_string_array_has(acc, name) {
      Array::push(acc, name)
    } else {
      ()
    }
  }
  match te {
    TyName(name) => note(name),
    TyApp(name, args) => {
      note(name)
      let mut i = 0
      while i < Array::length(args) {
        exception_kind_formals_in_env(Array::get(args, i), env, acc)
        i = i + 1
      }
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        exception_kind_formals_in_env(Array::get(items, i), env, acc)
        i = i + 1
      }
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        exception_kind_formals_in_env(Array::get(params, i), env, acc)
        i = i + 1
      }
      exception_kind_formals_in_env(ret, env, acc)
    },
    TyUnit => ()
  }
  acc
}

/// #3187: `T::default()` where `T` is bounded by `Default` and no declaration
/// of `Default` is in sight. The prelude's impls satisfy the bound on their
/// own (`register_builtin_traits_for` seeds them), but the method-bearing
/// `trait Default { default() -> Self }` lives in `@vibe/core`, so there is no
/// `default` to dispatch. "unknown name: T::default" named the symptom; this
/// names the import. A program that declares its own `Default` without the
/// method keeps the plain `unknown name`, which is then the honest answer.
export fn marker_default_dispatch_error(name: String, env: TypeEnv, s: Subst) -> Option[String] {
  let idx = String::index_of(name, "::")
  if idx <= 0 || String::substring(name, idx + 2, String::length(name)) != "default" || trait_defined(env, "Default") {
    None
  } else {
    let head = String::substring(name, 0, idx)
    match env_lookup(env, head) {
      Some(CtVar(vid)) => {
        let bounds = subst_bounds_for(s, vid)
        let mut bounded = false
        let mut bi = 0
        while bi < Array::length(bounds) {
          if trait_ref_name(Array::get(bounds, bi)) == "Default" {
            bounded = true
          }
          bi = bi + 1
        }
        if bounded {
          Some(String::concat("add `import @vibe/core { Default }` to call `", String::concat(name, String::concat("()`: without it `Default` is only the prelude's marker trait, which satisfies `[", String::concat(head, ": Default]` but declares no `default` method to dispatch")))))
        } else {
          None
        }
      },
      _ => None
    }
  }
}

/// #2900: four `Array::` spellings the checker used to admit had no lowering
/// anywhere, so a call type-checked clean and then died in codegen with
/// `reached code generation unresolved` -- a message that blames the compiler
/// and asks the reader to file a bug about their own correct-looking program.
/// They are no longer admitted, so a call now reaches `unknown name`. That is
/// honest but answers the wrong question for someone who reasonably expected
/// the name to exist, so say what to write instead (the `_` case below is the
/// same shape). Empty for every other name, and the caller appends nothing.
export fn builtin_no_lowering_hint(name: String) -> String {
  if name == "Array::contains" {
    " -- there is no `Array::contains`; write `Array::any(xs, (v) -> v == needle)`, which compares by content"
  } else if name == "Array::join" {
    " -- there is no `Array::join`; write `String::join(xs, sep)`"
  } else if name == "Array::foreach" {
    " -- there is no `Array::foreach`; write `for x in xs { .. }`"
  } else if name == "Array::sort" {
    " -- there is no `Array::sort`; `@vibe/core` sorts `Array[String]` (`sorted_names_of`, `sort_perm_by_names`) and `PriorityQueue::to_sorted_array` sorts by a key, otherwise write the sort you need"
  } else if name == "String::iter_length" {
    // #2913: the six rows below were admitted by `lookup_iter_intrinsic` and
    // lowered nowhere, so each one ICE'd after a clean `vibe check`. They now
    // reach `unknown name`, which is honest; these hints say what to write.
    " -- there is no `String::iter_length`; write `String::length(s)`"
  } else if name == "String::iter_get" {
    " -- there is no `String::iter_get`; write `String::char_code_at(s, i)`"
  } else if name == "Map::iter_length" {
    " -- there is no `Map::iter_length`; write `Map::size(m)`"
  } else if name == "iter_length" || name == "iter_get" || name == "iter_require" {
    // The bare spellings predate #1445's qualified protocol: `xs |> iter_length`
    // inside a `[C: Iterator[T]]` combinator used to compile to a bare call that
    // had to exist in the merged program. The protocol is qualified now.
    String::concat(String::concat(" -- the iteration protocol is spelled qualified: inside `[C: Iterator[T]]` write `C::iter_length(xs)` / `C::iter_get(xs, i)`, not a bare `", name), "`")
  } else if name == "Http::accept" || name == "Http::listen" || name == "Http::respond" || name == "Http::request_method" || name == "Http::request_header" {
    // #2913: these five are library functions in `@vibe/http`, not host-import
    // builtins. The other five `Http::` names ARE builtins and still resolve
    // bare; the split is measured, not assumed.
    String::concat(String::concat(" -- it is a library function, not a builtin: add `import @vibe/http { ", name), " }`")
  } else if name == "__neg" {
    // #2913: `__neg` is admitted nowhere now. It never had a lowering, so a
    // call ICEd instead of running; unary minus is spelled with the operator.
    " -- there is no `__neg`; write `-x`"
  } else if name == "Lines::parse" || name == "Lines::stringify" || name == "PromptText::new" {
    // #2913: same family as #2900's below. These are exported functions in
    // `lib/@vibe/builtin/string.vibe`, and they used to be typed by a checker
    // fallback -- so a call without the import checked clean and reached
    // codegen unresolved.
    String::concat(String::concat(" -- it is a library function, not a builtin: add `import @vibe/builtin { ", name), " }`")
  } else if name == "String::to_lower" || name == "String::to_upper" || name == "String::replace" || name == "String::replace_all" || name == "String::trim_start" || name == "String::trim_end" || name == "String::count" {
    // #2900: these are library functions, not builtins. The bare `unknown
    // name` is true but answers the wrong question for someone who reasonably
    // expected a String operation to be there; the edit is one line.
    String::concat(String::concat(" -- it is a library function, not a builtin: add `import @vibe/builtin { ", name), " }`")
  } else {
    ""
  }
}
