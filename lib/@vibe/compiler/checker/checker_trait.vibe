//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_lookup,
  find_typedef,
  impls_overlap_for,
  subst_apply,
  trait_defined,
  type_implements_trait,
  type_to_string
}

import ./checker_resolve.vibe {
  subst_type_params
}

//# Functions

fn one_super(name: String) -> Array[String] {
  [
    name
  ]
}

fn no_trait_methods() -> Array[(String, Array[TypeExpr], TypeExpr)] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn no_trait_method_gens() -> Array[(String, Array[String], Array[(String, Array[String])])] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn no_type_args() -> Array[Type] {
  array_empty()
}

fn empty_strings() -> Array[String] {
  array_empty()
}

export fn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool {
  type_implements_trait(env, s, ty, bound)
}

/// ADR-0068: `Send` is a compiler-judged structural marker, not a user
/// trait (docs/concurrency.md "`Send` と capture safety"). A type is Send
/// when a value can cross a task/channel boundary as a deep-copy
/// snapshot. Initial allowlist, conservative:
///   Send    — Unit/Bool/Int/Double/String/Char; tuples, Option, and
///             user structs/enums (incl. Result) whose components are all
///             Send and which have no `mut` field.
///   not Send — Array/Bytes (mutable interior), closures, mut-field
///             structs, effects, unresolved vars/unknowns, and any named
///             type without a visible definition (host resources etc.).
/// Recursive types are handled coinductively: a recursive occurrence of a
/// type already being checked does not fail the check on its own.
export fn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool {
  send_ok_rec(env, s, defs, ty, empty_strings())
}

fn send_seen_has(seen: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(seen) {
    if Array::get(seen, i) == name {
      found = true
    }
    i = i + 1
  }
  found
}

fn send_seen_with(seen: Array[String], name: String) -> Array[String] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(seen) {
    ArrayBuilder::push(b, Array::get(seen, i))
    i = i + 1
  }
  ArrayBuilder::push(b, name)
  ArrayBuilder::freeze(b)
}

fn send_ok_all(env: TypeEnv, s: Subst, defs: Array[TypeDef], tys: Array[Type], seen: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(tys) {
    if not(send_ok_rec(env, s, defs, Array::get(tys, i), seen)) {
      ok = false
    }
    i = i + 1
  }
  ok
}

/// Render the coinductive-guard key for a named type INCLUDING its type
/// arguments (#1090 review): keying on the constructor name alone let a
/// recursive occurrence with DIFFERENT arguments (e.g. `Loop[Array[Int]]`
/// inside `Loop[Int]`) be treated as already-proven, skipping the check
/// of the new arguments entirely.
fn send_seen_key(s: Subst, name: String, targs: Array[Type]) -> String {
  let mut key = name
  let mut i = 0
  while i < Array::length(targs) {
    key = String::concat(key, String::concat("|", type_to_string(subst_apply(s, Array::get(targs, i)))))
    i = i + 1
  }
  key
}

fn send_ok_named(env: TypeEnv, s: Subst, defs: Array[TypeDef], name: String, targs: Array[Type], seen: Array[String]) -> Bool {
  let key = send_seen_key(s, name, targs)
  if send_seen_has(seen, key) {
    true
  } else if Array::length(seen) >= 32 {
    // Non-regular recursion (each level instantiating a NEW key, e.g.
    // W[T] containing W[Array[T]]) never revisits a key — cap the descent
    // and reject conservatively instead of diverging.
    false
  } else {
    match find_typedef(defs, name) {
      Some(td) => match td {
        TDStruct(_, fields, mut_fields, tparams) => {
          if Array::length(mut_fields) > 0 {
            false
          } else if Array::length(tparams) != Array::length(targs) {
            false
          } else {
            let inner = send_seen_with(seen, key)
            let mut i = 0
            let mut ok = true
            while i < Array::length(fields) {
              let (_, ft) = Array::get(fields, i)
              let inst = subst_type_params(ft, tparams, targs)
              if not(send_ok_rec(env, s, defs, inst, inner)) {
                ok = false
              }
              i = i + 1
            }
            ok
          }
        },
        TDEnum(_, tparams, variants) => {
          if Array::length(tparams) != Array::length(targs) {
            false
          } else if Array::length(tparams) == 0 {
            // Monomorphic enum: TDEnum payloads are stored as resolved
            // concrete/named types — recurse directly.
            let inner = send_seen_with(seen, key)
            let mut vi = 0
            let mut ok = true
            while vi < Array::length(variants) {
              let (_, payloads) = Array::get(variants, vi)
              let mut pi = 0
              while pi < Array::length(payloads) {
                if not(send_ok_rec(env, s, defs, Array::get(payloads, pi), inner)) {
                  ok = false
                }
                pi = pi + 1
              }
              vi = vi + 1
            }
            ok
          } else {
            // Generic enum: the SEnum handler stores payload types with the
            // declaration's FRESH CtVar ids (not the param names), so
            // name-based substitution cannot instantiate them. Recover the
            // var ids from the constructor's env binding —
            // `CtForAll(param_var_ids, _, CtFn(payloads, _))` — and
            // substitute those ids with targs.
            let inner = send_seen_with(seen, key)
            let mut vi = 0
            let mut ok = true
            while vi < Array::length(variants) {
              let (vname, payloads) = Array::get(variants, vi)
              if Array::length(payloads) > 0 {
                match env_lookup(env, vname) {
                  Some(cty) => match cty {
                    CtForAll(vids, _, inner_ty) => match inner_ty {
                      CtFn(args, _, _) => {
                        let mut pi = 0
                        while pi < Array::length(args) {
                          let inst = send_subst_vars(Array::get(args, pi), vids, targs)
                          if not(send_ok_rec(env, s, defs, inst, inner)) {
                            ok = false
                          }
                          pi = pi + 1
                        }
                      },
                      _ => {
                        ok = false
                      }
                    },
                    _ => {
                      ok = false
                    }
                  },
                  None => {
                    ok = false
                  }
                }
              } else {
                ()
              }
              vi = vi + 1
            }
            ok
          }
        },
        TDAlias(_, params, body) => {
          if Array::length(params) != Array::length(targs) {
            false
          } else {
            send_ok_rec(env, s, defs, subst_type_params(body, params, targs), send_seen_with(seen, key))
          }
        },
        TDEffect(_, _, _) => false,
        TDEffectSet(_, _) => false
      },
      None => false
    }
  }
}

/// Substitute declaration-scoped CtVar ids (a generic enum ctor's
/// CtForAll binder list) with concrete type arguments, positionally.
/// Exported for checker_pattern.vibe's PCtor arm (#1081 step 3 Phase B
/// investigation): see its call site for why pattern-matching a generic
/// enum ctor needs THIS var-id substitution, not checker_resolve.vibe's
/// name-based `subst_type_params`.
export fn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type {
  match ty {
    CtVar(v) => {
      let mut idx = 0 - 1
      let mut i = 0
      while i < Array::length(vids) {
        if Array::get(vids, i) == v {
          idx = i
        }
        i = i + 1
      }
      if idx >= 0 && idx < Array::length(args) {
        Array::get(args, idx)
      } else {
        ty
      }
    },
    CtArray(e) => CtArray(send_subst_vars(e, vids, args)),
    CtOption(e) => CtOption(send_subst_vars(e, vids, args)),
    CtTuple(es) => CtTuple(for e in es {
      send_subst_vars(e, vids, args)
    }),
    CtNamed(nm, targs) => CtNamed(nm, for a in targs {
      send_subst_vars(a, vids, args)
    }),
    CtFn(ps, ret, eff) => {
      let rp = for p in ps {
        send_subst_vars(p, vids, args)
      }
      CtFn(rp, send_subst_vars(ret, vids, args), eff)
    },
    _ => ty
  }
}

fn send_ok_rec(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, seen: Array[String]) -> Bool {
  match subst_apply(s, ty) {
    CtInt => true,
    CtDouble => true,
    CtBool => true,
    CtString => true,
    CtChar => true,
    CtUnit => true,
    CtTuple(ts) => send_ok_all(env, s, defs, ts, seen),
    // #1839: an anonymous record is an immutable aggregate (no mut fields),
    // so like a tuple it is Send exactly when every field type is.
    CtRecord(rfs) => send_ok_all(env, s, defs, for rf in rfs {
      let (_, rft) = rf
      rft
    }, seen),
    CtOption(e) => send_ok_rec(env, s, defs, e, seen),
    CtArray(_) => false,
    CtBytes => false,
    CtFn(_, _, _) => false,
    CtEnum(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),
    CtStruct(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),
    // #906: FrozenArray[T] is a checker-only phantom-type wrapper over
    // Array[T]'s exact same (mutable-looking, but never mutated through this
    // type) runtime layout -- see checker.vibe's FrozenArray::* ECall
    // branches and codegen/gc/backend_body.vibe's identity-cast aliasing.
    // Unlike Array[T] (always rejected, CtArray(_) => false above), a
    // FrozenArray is Send exactly when its element type is, since nothing
    // reachable through it can mutate after capture. Must be checked before
    // the generic CtNamed(...) fallback below, which only resolves
    // user-defined struct/enum typedefs and would reject FrozenArray as an
    // unknown name.
    CtNamed(name, targs) => if name == "FrozenArray" && Array::length(targs) == 1 {
      send_ok_rec(env, s, defs, Array::get(targs, 0), seen)
    } else {
      send_ok_named(env, s, defs, name, targs, seen)
    },
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtUnknown => false
  }
}

export fn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String] {
  let result = empty_strings()
  let len = Array::length(bounds)
  let rec go: (Int) -> Int = (i) -> {
    if i >= len {
      0
    } else {
      let bound = Array::get(bounds, i)
      if not(satisfies_bound(env, s, ty, bound)) {
        Array::push(result, bound)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

export fn register_builtin_traits(env: TypeEnv) -> TypeEnv {
  let no_supers = empty_strings()
  let eq_supers = one_super("Eq")
  let i64_type = CtNamed("i64", no_type_args())
  let u8_type = CtNamed("u8", no_type_args())
  let u16_type = CtNamed("u16", no_type_args())
  let u32_type = CtNamed("u32", no_type_args())
  let u64_type = CtNamed("u64", no_type_args())
  let i16_type = CtNamed("i16", no_type_args())
  let nm = no_trait_methods()
  // Keep each transparent environment node's mutable array independent.
  let e1 = EnvTraitDef("Eq", no_supers, false, nm, env, empty_strings(), no_trait_method_gens())
  let e2 = EnvTraitDef("Ord", eq_supers, false, nm, e1, empty_strings(), no_trait_method_gens())
  let e3 = EnvTraitDef("Add", no_supers, false, nm, e2, empty_strings(), no_trait_method_gens())
  let e4 = EnvTraitDef("Sub", no_supers, false, nm, e3, empty_strings(), no_trait_method_gens())
  let e5 = EnvTraitDef("Mul", no_supers, false, nm, e4, empty_strings(), no_trait_method_gens())
  let e6 = EnvTraitDef("Div", no_supers, false, nm, e5, empty_strings(), no_trait_method_gens())
  let e7 = EnvTraitImpl("Eq", CtInt, e6)
  let e8 = EnvTraitImpl("Eq", CtDouble, e7)
  let e9 = EnvTraitImpl("Eq", CtString, e8)
  let e10 = EnvTraitImpl("Eq", CtBool, e9)
  let e11 = EnvTraitImpl("Ord", CtInt, e10)
  let e12 = EnvTraitImpl("Ord", CtDouble, e11)
  let e13 = EnvTraitImpl("Ord", CtString, e12)
  let e14 = EnvTraitImpl("Add", CtInt, e13)
  let e15 = EnvTraitImpl("Add", CtDouble, e14)
  let e16 = EnvTraitImpl("Sub", CtInt, e15)
  let e17 = EnvTraitImpl("Sub", CtDouble, e16)
  let e18 = EnvTraitImpl("Mul", CtInt, e17)
  let e19 = EnvTraitImpl("Mul", CtDouble, e18)
  let e20 = EnvTraitImpl("Div", CtInt, e19)
  let e21 = EnvTraitImpl("Div", CtDouble, e20)
  let e22 = EnvTraitImpl("Eq", i64_type, e21)
  let e23 = EnvTraitImpl("Eq", u8_type, e22)
  let e24 = EnvTraitImpl("Eq", u16_type, e23)
  let e25 = EnvTraitImpl("Eq", u32_type, e24)
  let e26 = EnvTraitImpl("Eq", u64_type, e25)
  let e27 = EnvTraitImpl("Eq", i16_type, e26)
  let e28 = EnvTraitImpl("Ord", i64_type, e27)
  let e29 = EnvTraitImpl("Ord", u8_type, e28)
  let e30 = EnvTraitImpl("Ord", u16_type, e29)
  let e31 = EnvTraitImpl("Ord", u32_type, e30)
  let e32 = EnvTraitImpl("Ord", u64_type, e31)
  let e33 = EnvTraitImpl("Ord", i16_type, e32)
  let e34 = EnvTraitImpl("Add", i64_type, e33)
  let e35 = EnvTraitImpl("Add", u8_type, e34)
  let e36 = EnvTraitImpl("Add", u16_type, e35)
  let e37 = EnvTraitImpl("Add", u32_type, e36)
  let e38 = EnvTraitImpl("Add", u64_type, e37)
  let e39 = EnvTraitImpl("Add", i16_type, e38)
  let e40 = EnvTraitImpl("Sub", i64_type, e39)
  let e41 = EnvTraitImpl("Sub", u8_type, e40)
  let e42 = EnvTraitImpl("Sub", u16_type, e41)
  let e43 = EnvTraitImpl("Sub", u32_type, e42)
  let e44 = EnvTraitImpl("Sub", u64_type, e43)
  let e45 = EnvTraitImpl("Sub", i16_type, e44)
  let e46 = EnvTraitImpl("Mul", i64_type, e45)
  let e47 = EnvTraitImpl("Mul", u8_type, e46)
  let e48 = EnvTraitImpl("Mul", u16_type, e47)
  let e49 = EnvTraitImpl("Mul", u32_type, e48)
  let e50 = EnvTraitImpl("Mul", u64_type, e49)
  let e51 = EnvTraitImpl("Mul", i16_type, e50)
  let e52 = EnvTraitImpl("Div", i64_type, e51)
  let e53 = EnvTraitImpl("Div", u8_type, e52)
  let e54 = EnvTraitImpl("Div", u16_type, e53)
  let e55 = EnvTraitImpl("Div", u32_type, e54)
  let e56 = EnvTraitImpl("Div", u64_type, e55)
  let e57 = EnvTraitImpl("Div", i16_type, e56)
  // ADR-0068 `Send`: register the trait def (so `[T: Send]` bounds are
  // known) plus nominal impls for the sendable primitives, which keeps
  // the non-structural resolution paths (generic-impl bounds, UFCS
  // helpers) working for primitive instantiations. Composite structural
  // judgment lives in type_send_ok; user `impl Send` is rejected in the
  // SImpl handler.
  let e58 = EnvTraitDef("Send", no_supers, false, nm, e57, empty_strings(), no_trait_method_gens())
  let e59 = EnvTraitImpl("Send", CtInt, e58)
  let e60 = EnvTraitImpl("Send", CtDouble, e59)
  let e61 = EnvTraitImpl("Send", CtString, e60)
  let e62 = EnvTraitImpl("Send", CtBool, e61)
  let e63 = EnvTraitImpl("Send", CtUnit, e62)
  let e64 = EnvTraitImpl("Send", CtChar, e63)
  e64
}

export fn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String] {
  let result = empty_strings()
  let len = Array::length(supers)
  let rec go: (Int) -> Int = (i) -> {
    if i >= len {
      0
    } else {
      let name = Array::get(supers, i)
      if not(trait_defined(env, name)) {
        Array::push(result, name)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

export fn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool {
  not(impls_overlap_for(env, trait_name, target))
}
