//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let builders_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let builders_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = builders_no_params()
  Array::push(arr, a)
  arr
}

let builders_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = builders_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let lookup_array_builder_new: (String) -> Option[Type] = (name) -> {
  if name == "ArrayBuilder::new" {
    Some(CtFn(builders_no_params(), CtUnknown, None))
  }
  else None
}

let lookup_array_builder_push: (String) -> Option[Type] = (name) -> {
  if name == "ArrayBuilder::push" {
    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_string_builder_new: (String) -> Option[Type] = (name) -> {
  if name == "StringBuilder::new" {
    Some(CtFn(builders_no_params(), CtUnknown, None))
  }
  else None
}

let lookup_string_builder_push: (String) -> Option[Type] = (name) -> {
  if name == "StringBuilder::push" {
    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))
  }
  else None
}

let lookup_array_builder_freeze: (String) -> Option[Type] = (name) -> {
  if name == "ArrayBuilder::freeze" {
    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

export let lookup_array_builder: (String) -> Option[Type] = (name) -> {
  match lookup_array_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_array_builder_freeze(name)
    }
  }
}

let lookup_string_builder_freeze: (String) -> Option[Type] = (name) -> {
  if name == "StringBuilder::freeze" {
    Some(CtFn(builders_one_param(CtUnknown), CtString, None))
  }
  else None
}

export let lookup_string_builder: (String) -> Option[Type] = (name) -> {
  match lookup_string_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_string_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_string_builder_freeze(name)
    }
  }
}
