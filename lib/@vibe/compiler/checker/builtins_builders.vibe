//# Imports

import ../core/index.vibe {
  Type
}

import ../../../../lib/@vibe/core {
  array_empty
}

//# Functions

fn builders_no_params() -> Array[Type] {
  array_empty()
}

fn builders_one_param(a: Type) -> Array[Type] {
  let arr = builders_no_params()
  Array::push(arr, a)
  arr
}

fn builders_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = builders_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn lookup_array_builder_new(name: String) -> Option[Type] {
  if name == "ArrayBuilder::new" {
    Some(CtFn(builders_no_params(), CtUnknown, None))
  }
  else None
}

fn lookup_array_builder_push(name: String) -> Option[Type] {
  if name == "ArrayBuilder::push" {
    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))
  }
  else None
}

fn lookup_string_builder_new(name: String) -> Option[Type] {
  if name == "StringBuilder::new" {
    Some(CtFn(builders_no_params(), CtUnknown, None))
  }
  else None
}

fn lookup_string_builder_push(name: String) -> Option[Type] {
  if name == "StringBuilder::push" {
    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))
  }
  else None
}

fn lookup_array_builder_freeze(name: String) -> Option[Type] {
  if name == "ArrayBuilder::freeze" {
    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

export fn lookup_array_builder(name: String) -> Option[Type] {
  match lookup_array_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_array_builder_freeze(name)
    }
  }
}

fn lookup_string_builder_freeze(name: String) -> Option[Type] {
  if name == "StringBuilder::freeze" {
    Some(CtFn(builders_one_param(CtUnknown), CtString, None))
  }
  else None
}

export fn lookup_string_builder(name: String) -> Option[Type] {
  match lookup_string_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_string_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_string_builder_freeze(name)
    }
  }
}
