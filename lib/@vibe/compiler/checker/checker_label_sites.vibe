// ADR-0120 Phase 2a (#3679): the call sites a label codemod may edit.
//
// While the capture is on, the checker records each call it resolves to a
// declaration header or a builtin: the call's offset, the callee spelling,
// what kind of declaration answered, the parameter names that the written
// arguments bind to (a method call's receiver already removed), and which
// written arguments carry a label. The codemod applies its slot policy to
// these rows; nothing here decides which slots get a label. The capture is
// off unless a codemod asks for it, so ordinary checking pays one array read
// per call.

import ./checker_call_header.vibe {
  checker_call_header_is_declaration, checker_call_header_names, checker_header_name_is_positional
}

import @vibe/compiler/checker/diagnostics {
  off_marker_len
}

import ./checker_call_header_flow.vibe {
  checker_call_header_is_probe
}

import @vibe/compiler/core {
  Expr, TypeEnv, __to_string, builtin_param_labels, canonical_builtin_name, env_lookup_binding
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_resolves_at, lookup_builtin
}

import @vibe/core {
  struct MutMap
}

/// A declaration of the module being checked (or a local binding of the same
/// shape -- the codemod tells them apart).
export let label_site_declared: Int = 0

/// A builtin; its names are `builtin_param_labels`, with `_` for a positional
/// slot.
export let label_site_builtin: Int = 1

/// A function imported from another module.
export let label_site_imported: Int = 2

/// One resolved call: (call offset, callee spelling, kind, parameter names of
/// the written arguments' slots, labeled flag per written argument, whether a
/// method receiver was removed from the names).
// `LabelSite` is defined in the package contract (index.vpkg), its single
// definition site.

let label_sites_active: Array[Bool] = [false]
let label_sites: Array[LabelSite] = []
let label_site_offsets: Array[MutMap[Int, Bool]] = [MutMap::new_int()]

/// Start recording, forgetting any earlier capture.
export fn label_sites_begin() -> Unit {
  Array::truncate(label_sites, length = 0)
  Array::set(label_site_offsets, at = 0, value = MutMap::new_int())
  Array::set(label_sites_active, at = 0, value = true)
}

/// Stop recording and hand back what was recorded, in the order the checker
/// first reached each call.
export fn label_sites_end() -> Array[LabelSite] {
  Array::set(label_sites_active, at = 0, value = false)
  for site in label_sites {
    site
  }
}

fn label_site_imported_origin(env: TypeEnv, name: String) -> Bool {
  match env_lookup_binding(env = env, name = name) {
    Some(binding) => match binding.origin {
      BindingOriginModuleExport(_, _) => true,
      BindingOriginModuleFunctionHeader(_, _, _, _) => true,
      _ => false
    },
    None => false
  }
}

/// Record the call at `offset` to `name`, resolved in `env`. A call through a
/// value (no declaration header) is not recorded: ADR-0120 keeps those
/// positional. A call reached twice (a re-entered qualified call, a body
/// checked again) keeps its first record.
export fn checker_note_label_site(env: TypeEnv, name: String, ident_offset: Int, offset: Int, args: Array[Expr], method_call: Bool) -> Unit {
  if !Array::get(label_sites_active, at = 0) || checker_call_header_is_probe() || offset < 0 || MutMap::has(Array::get(label_site_offsets, at = 0), k = offset) {
    ()
  } else {
    let found = if builtin_resolves_at(env = env, name = name, ident_off = ident_offset) && (lookup_builtin(name) is Some(_)) {
      match builtin_param_labels(name) {
        Some(names) => Some((label_site_builtin, names)),
        None => None
      }
    } else {
      match checker_call_header_names(env = env, name = name) {
        Some(all_names) => {
          let names = if method_call && Array::length(all_names) > 0 {
            Array::slice(all_names, start = 1, end = Array::length(all_names))
          } else {
            all_names
          }
          let kind = if label_site_imported_origin(env = env, name = name) {
            label_site_imported
          } else {
            label_site_declared
          }
          Some((kind, names))
        },
        None => None
      }
    }
    match found {
      Some((kind, names)) => {
        MutMap::set(Array::get(label_site_offsets, at = 0), k = offset, v = true)
        let labeled = for arg in args {
          match arg {
            ELabeledArg(_, _, _) => true,
            _ => false
          }
        }
        Array::push(label_sites, value = LabelSite::{
          offset: offset,
          callee: name,
          kind: kind,
          names: names,
          labeled: labeled,
          method_call: method_call
        })
      },
      None => ()
    }
  }
}

//# Required labels (ADR-0120 Phase 4)

fn missing_label_name(_ raw: String) -> String {
  let size = String::length(raw)
  if String::ends_with(raw, suffix = "~") || String::ends_with(raw, suffix = "?") {
    raw[0: size - 1]
  } else {
    raw
  }
}

/// The parameter names the written arguments of a call to `name` bind to,
/// when every one of them must be labeled unless it is declared `_`: a
/// builtin, or a declaration (`checker_call_header_is_declaration`). A local
/// lambda or a value answers None: those calls stay positional.
fn required_label_names(env: TypeEnv, name: String, ident_offset: Int, method_call: Bool) -> Option[Array[String]] {
  if builtin_resolves_at(env = env, name = name, ident_off = ident_offset) && (lookup_builtin(name) is Some(_)) {
    if canonical_builtin_name(name) == "sh_lines" {
      None
    } else {
      builtin_param_labels(name)
    }
  } else if checker_call_header_is_declaration(env = env, name = name) {
    match checker_call_header_names(env = env, name = name) {
      Some(all_names) => Some(if method_call && Array::length(all_names) > 0 {
        Array::slice(all_names, start = 1, end = Array::length(all_names))
      } else {
        all_names
      }),
      None => None
    }
  } else {
    None
  }
}

/// ADR-0120 Phase 4: an argument to a parameter that is not declared `_` names
/// it. The message lists every label the call is missing, in written order.
export fn checker_check_required_labels(env: TypeEnv, name: String, ident_offset: Int, offset: Int, args: Array[Expr], method_call: Bool, errors: Array[String]) -> Unit {
  if checker_call_header_is_probe() || offset < 0 || ident_offset < 0 {
    ()
  } else {
    match required_label_names(env = env, name = name, ident_offset = ident_offset, method_call = method_call) {
      // More arguments than parameters is an arity error, and a declaration's
      // call that labels some arguments and not others is reported as mixing:
      // either says what to fix first.
      Some(names) => if Array::length(args) > Array::length(names) || (!(lookup_builtin(name) is Some(_)) && checker_args_mix_labels(args)) {
        ()
      } else {
        let missing: Array[String] = []
        let mut i = 0
        while i < Array::length(args) && i < Array::length(names) {
          let positional = match Array::get(args, at = i) {
            ELabeledArg(_, _, _) => false,
            _ => true
          }
          let raw = Array::get(names, at = i)
          if positional && raw != "_" && !checker_header_name_is_positional(raw) {
            Array::push(missing, value = "`" + missing_label_name(raw) + " = ` before argument " + __to_string(i + 1))
          } else {
            ()
          }
          i = i + 1
        }
        if Array::length(missing) > 0 {
          Array::push(errors, value = "label the arguments of " + name + ": write " + String::join(missing, sep = ", ") + off_marker_len(off = ident_offset, len = String::length(name)))
        } else {
          ()
        }
      },
      None => ()
    }
  }
}

fn checker_args_mix_labels(_ args: Array[Expr]) -> Bool {
  let mut labeled = false
  let mut plain = false
  for arg in args {
    match arg {
      ELabeledArg(_, _, _) => labeled = true,
      _ => plain = true
    }
  }
  labeled && plain
}
