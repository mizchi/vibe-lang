//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let string2_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let string2_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = string2_no_params()
  Array::push(arr, a)
  arr
}

let string2_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = string2_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let string2_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = string2_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_string_replace: (String) -> Option[Type] = (name) -> {
  if name == "String::replace" {
    Some(CtFn(string2_three_params(CtString, CtString, CtString), CtString, None))
  }
  else None
}

let lookup_string_trim: (String) -> Option[Type] = (name) -> {
  if name == "String::trim" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string_split: (String) -> Option[Type] = (name) -> {
  if name == "String::split" {
    Some(CtFn(string2_two_params(CtString, CtString), CtArray(CtString), None))
  }
  else None
}

let lookup_string_contains: (String) -> Option[Type] = (name) -> {
  if name == "String::contains" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_index_of: (String) -> Option[Type] = (name) -> {
  if name == "String::index_of" {
    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))
  }
  else None
}

let lookup_string_to_lower: (String) -> Option[Type] = (name) -> {
  if name == "String::to_lower" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string_to_upper: (String) -> Option[Type] = (name) -> {
  if name == "String::to_upper" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string_group_c: (String) -> Option[Type] = (name) -> {
  match lookup_string_trim(name) {
    Some(t) => Some(t),
    None => match lookup_string_to_upper(name) {
      Some(t) => Some(t),
      None => lookup_string_to_lower(name)
    }
  }
}

let lookup_string_ends_with: (String) -> Option[Type] = (name) -> {
  if name == "String::ends_with" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_starts_with: (String) -> Option[Type] = (name) -> {
  if name == "String::starts_with" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string2_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_string_index_of(name) {
    Some(t) => Some(t),
    None => match lookup_string_contains(name) {
      Some(t) => Some(t),
      None => match lookup_string_starts_with(name) {
        Some(t) => Some(t),
        None => lookup_string_ends_with(name)
      }
    }
  }
}

let lookup_string_char_code_at: (String) -> Option[Type] = (name) -> {
  if name == "String::char_code_at" {
    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))
  }
  else None
}

let lookup_string_last_index_of: (String) -> Option[Type] = (name) -> {
  if name == "String::last_index_of" {
    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))
  }
  else None
}

let lookup_string_from_char_code: (String) -> Option[Type] = (name) -> {
  if name == "String::from_char_code" {
    Some(CtFn(string2_one_param(CtInt), CtString, None))
  }
  else None
}

let lookup_string2_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_string_from_char_code(name) {
    Some(t) => Some(t),
    None => match lookup_string_char_code_at(name) {
      Some(t) => Some(t),
      None => match lookup_string_last_index_of(name) {
        Some(t) => Some(t),
        None => lookup_string_split(name)
      }
    }
  }
}

export let lookup_string2: (String) -> Option[Type] = (name) -> {
  match lookup_string2_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_string2_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_string_group_c(name) {
        Some(t) => Some(t),
        None => lookup_string_replace(name)
      }
    }
  }
}
