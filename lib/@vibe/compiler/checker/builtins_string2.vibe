//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn string2_one_param(a: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  arr
}

/// Case-conversion helpers remain fallback-only. The other String signatures
/// formerly in this lane are checker-visible registry rows (#1593).
export fn lookup_string2(name: String) -> Option[Type] {
  if name == "String::to_lower" || name == "String::to_upper" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}
