//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn string2_one_param(a: Type) -> Array[Type] {
  let arr = array_empty()
  Array::push(arr, a)
  arr
}

/// The other String signatures formerly in this lane are checker-visible
/// registry rows (#1593).
///
/// #2900: `String::to_lower` / `String::to_upper` were typed HERE, and they
/// are not builtins -- they are ordinary vibe functions in
/// `lib/@vibe/builtin/string.vibe`, like `String::replace`, `trim_start`,
/// `trim_end` and `count`. Typing them unconditionally made the name resolve
/// whether or not anything supplied a body, so the three cases came apart:
///
///   no import               checker ok, no body  -> codegen ICE
///   any import (unnamed)    checker ok, module linked by accident -> worked
///   named import            worked
///
/// The first is the bug -- `reached code generation unresolved`, which tells
/// the reader their correct-looking program is a compiler bug to report, when
/// the whole fault is a missing import. The second is why it survived: the
/// fixtures that call `String::to_upper` import `String::replace` and never
/// name it, so the accidental linkage kept them green. Measured: the five
/// siblings do NOT resolve that way -- `String::replace` under an import
/// naming only `String::count` is `unknown name`.
///
/// They are not typed here any more, so all three cases follow the same rule
/// as the siblings: the name must be imported by name. Only this lookup is
/// removed; the classifier lists that give an ALREADY-RESOLVED call its arity,
/// return type and directness still serve the imported case and are untouched.
///
/// This exact defect was worked around four separate times rather than fixed
/// -- #774 (`@vibe/http`), #777 (`@vibex/shell`), #778 (`@vibe/wasi/p3`) and
/// `@vibe/lsp`, each of which hand-rolled an ASCII fold with a comment
/// describing this failure.
export fn lookup_string2(name: String) -> Option[Type] {
  if name == "String::unicode_length" || name == "String::utf16_length" || name == "String::utf8_length" {
    // #2630: the three length VIEWS of a byte string (ADR-0098) -- code
    // points, UTF-16 code units, bytes. Fallback-typed like `Double::parse`
    // rather than registry rows: they sit in neither lane's func table (a
    // registry row must claim a lane, scripts/check_builtin_parity.sh), and
    // both backends serve them by a callsite lowering (the shared synthesis
    // in codegen/common_base/string_length_exprs.vibe; `utf8_length` lowers
    // onto `String::length`). They were declared in builtins/declarations.vibe
    // and published from @vibe/builtin for a long time with no type here and
    // no lowering anywhere, so a direct call was `unknown name` and an
    // aliased import reached codegen unresolved.
    Some(CtFn(string2_one_param(CtString), CtInt, None))
  }
  else None
}
