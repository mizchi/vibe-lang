//# Imports

import ../core {
  Type
}

import ../../../../lib/@vibe/core {
  array_empty
}

//# Functions

fn string2_no_params() -> Array[Type] {
  array_empty()
}

fn string2_one_param(a: Type) -> Array[Type] {
  let arr = string2_no_params()
  Array::push(arr, a)
  arr
}

fn string2_two_params(a: Type, b: Type) -> Array[Type] {
  let arr = string2_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

fn lookup_string_trim(name: String) -> Option[Type] {
  if name == "String::trim" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

fn lookup_string_split(name: String) -> Option[Type] {
  if name == "String::split" {
    Some(CtFn(string2_two_params(CtString, CtString), CtArray(CtString), None))
  }
  else None
}

fn lookup_string_contains(name: String) -> Option[Type] {
  if name == "String::contains" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

fn lookup_string_index_of(name: String) -> Option[Type] {
  if name == "String::index_of" {
    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))
  }
  else None
}

fn lookup_string_to_lower(name: String) -> Option[Type] {
  if name == "String::to_lower" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

fn lookup_string_to_upper(name: String) -> Option[Type] {
  if name == "String::to_upper" {
    Some(CtFn(string2_one_param(CtString), CtString, None))
  }
  else None
}

fn lookup_string_group_c(name: String) -> Option[Type] {
  match lookup_string_trim(name) {
    Some(t) => Some(t),
    None => match lookup_string_to_upper(name) {
      Some(t) => Some(t),
      None => lookup_string_to_lower(name)
    }
  }
}

fn lookup_string_ends_with(name: String) -> Option[Type] {
  if name == "String::ends_with" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

fn lookup_string_starts_with(name: String) -> Option[Type] {
  if name == "String::starts_with" {
    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))
  }
  else None
}

fn lookup_string2_group_a(name: String) -> Option[Type] {
  match lookup_string_index_of(name) {
    Some(t) => Some(t),
    None => match lookup_string_contains(name) {
      Some(t) => Some(t),
      None => match lookup_string_starts_with(name) {
        Some(t) => Some(t),
        None => lookup_string_ends_with(name)
      }
    }
  }
}

fn lookup_string_char_code_at(name: String) -> Option[Type] {
  if name == "String::char_code_at" {
    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))
  }
  else None
}

fn lookup_string_last_index_of(name: String) -> Option[Type] {
  if name == "String::last_index_of" {
    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))
  }
  else None
}

fn lookup_string_from_char_code(name: String) -> Option[Type] {
  if name == "String::from_char_code" {
    Some(CtFn(string2_one_param(CtInt), CtString, None))
  }
  else None
}

fn lookup_string2_group_b(name: String) -> Option[Type] {
  match lookup_string_from_char_code(name) {
    Some(t) => Some(t),
    None => match lookup_string_char_code_at(name) {
      Some(t) => Some(t),
      None => match lookup_string_last_index_of(name) {
        Some(t) => Some(t),
        None => lookup_string_split(name)
      }
    }
  }
}

export fn lookup_string2(name: String) -> Option[Type] {
  match lookup_string2_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_string2_group_b(name) {
      Some(t) => Some(t),
      None => lookup_string_group_c(name)
    }
  }
}
