/// Validate a parsed raw-source API input before any checker or lowering pass
/// can interpret compiler-only source-boundary metadata as trusted provenance.
export fn validate_user_source_stmts(stmts: Array[Stmt]) -> Unit with Exception {
  reject_user_iterator_serialized_boundaries(stmts)
}

/// Declared arity of a type constructor used by an impl target. Keep builtin
/// container authority here; user declarations come from defs.
fn impl_target_declared_arity(defs: Array[TypeDef], name: String) -> Option[Int] {
  match find_typedef(defs, name) {
    Some(td) => match td {
      TDEnum(_, params, _) => Some(Array::length(params)),
      TDStruct(_, _, _, params) => Some(Array::length(params)),
      TDAlias(_, params, _) => Some(Array::length(params)),
      TDEffect(_, _, params) => Some(Array::length(params)),
      TDEffectSet(_, _) => Some(0)
    },
    None => match compiler_owned_type_arity(name) {
      Some(arity) => Some(arity),
      None => match resolve_builtin(name) {
        Some(_) => Some(0),
        None => None
      }
    }
  }
}

fn impl_target_mentions(target: TypeExpr, wanted: String) -> Bool {
  match target {
    TyName(name) => name == wanted,
    TyApp(name, args) => if name == wanted {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) && !found {
        found = impl_target_mentions(Array::get(args, i), wanted)
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      let mut found = impl_target_mentions(ret, wanted)
      while i < Array::length(params) && !found {
        found = impl_target_mentions(Array::get(params, i), wanted)
        i = i + 1
      }
      found
    },
    TyTuple(items) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(items) && !found {
        found = impl_target_mentions(Array::get(items, i), wanted)
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

//# Types

/// Successful production-check boundary. `checked_stmts` is the same
/// in-place post-desugar program consumed by existing codegen callers;
/// `typed_occurrences` is only the offset/type information that the production
/// checker already records (it is not a complete elaborated typed IR).
export struct CheckedProgram {
  checked_stmts: Array[Stmt];
  final_env: TypeEnv;
  type_defs: Array[TypeDef];
  final_subst: Subst;
  typed_occurrences: Array[(Int, Type)]
}

/// Observation-only provenance aligned with `checked_program.type_defs`.
/// `type_def_binders` contains generic TDEnum binder CtVar ids in declaration
/// order. This is deliberately separate so CheckedProgram remains source
/// compatible with its original production-result shape.
export struct CheckedProgramTypeDefsObservation {
  checked_program: CheckedProgram;
  type_def_binders: Array[Array[Int]]
}

/// Statement-owner-only typed-occurrence observation. Each entry retains the
/// post-desugar CheckedProgram statement path, its capture ordinal, and the raw
/// checker type. It deliberately does not claim expression/role provenance,
/// source offsets, edit stability, typed IR, cache, trace, interface, or codec
/// semantics. The first erasure point is each statement's expression tree.
export struct CheckedTypedOccurrenceStatementObservation {
  checked_program: CheckedProgram;
  entries: Array[(Array[Int], Int, Type)]
}

/// Opaque append-time role/lane observation. Its rows are exactly aligned to
/// the retained legacy typed_occurrences table, but expose no offsets or types.
export struct CheckedTypedOccurrenceRoleLaneObservation {
  checked_program: CheckedProgram;
  entries: TypedOccurrenceRoleLaneCapture
}

/// Opaque append-time structural provenance. Every row combines its retained
/// statement path, exact `expr_children` path, role, and lane. It is returned
/// only when every retained legacy row has an honest path.
export struct CheckedTypedOccurrenceExpressionPathObservation {
  checked_program: CheckedProgram;
  entries: TypedOccurrenceRoleLaneCapture
}

/// Complete-or-none direct primary checker-return types for every retained
/// post-desugar expression coordinate. This is an observation, not typed IR.
export struct CheckedDirectExpressionReturnObservation {
  checked_program: CheckedProgram;
  entries: Array[(Array[Int], Array[Int], Type)]
}

enum CheckerStatementCapture {
  StatementTypedOccurrences(Array[(Array[Int], Int, Type)]);
  StatementRootTypes(Array[(Array[Int], String, Type)]);
  StatementDirectExpressionReturns
}

struct CheckerObservationCheckpoint {
  tytab_len: Int;
  statement_entries_len: Int;
  role_entries_len: Int;
  role_provenance_len: Int;
  role_direct_len: Int;
  role_statement_path: Array[Int];
  role_frame_paths_len: Int;
  role_frame_next_len: Int;
  role_frame_expected_len: Int;
  role_frame_direct_len: Int;
  role_frame_depth: Int;
  role_complete: Bool
}

fn checker_observation_checkpoint(capture: Option[CheckerStatementCapture], role_capture: Option[TypedOccurrenceRoleLaneCapture], tytab: Array[(Int, Type)]) -> CheckerObservationCheckpoint {
  let statement_entries_len = match capture {
    Some(StatementTypedOccurrences(entries)) => Array::length(entries),
    Some(StatementRootTypes(entries)) => Array::length(entries),
    _ => 0
  }
  match role_capture {
    Some(role) => CheckerObservationCheckpoint::{
      tytab_len: Array::length(tytab),
      statement_entries_len: statement_entries_len,
      role_entries_len: Array::length(role.entries),
      role_provenance_len: Array::length(role.provenance_entries),
      role_direct_len: Array::length(role.direct_entries),
      role_statement_path: Array::slice(role.statement_path, 0, Array::length(role.statement_path)),
      role_frame_paths_len: Array::length(role.frame_paths),
      role_frame_next_len: Array::length(role.frame_next_children),
      role_frame_expected_len: Array::length(role.frame_expected_children),
      role_frame_direct_len: Array::length(role.frame_direct_recorded),
      role_frame_depth: role.frame_depth,
      role_complete: role.complete
    },
    None => CheckerObservationCheckpoint::{
      tytab_len: Array::length(tytab),
      statement_entries_len: statement_entries_len,
      role_entries_len: 0,
      role_provenance_len: 0,
      role_direct_len: 0,
      role_statement_path: array_empty(),
      role_frame_paths_len: 0,
      role_frame_next_len: 0,
      role_frame_expected_len: 0,
      role_frame_direct_len: 0,
      role_frame_depth: 0,
      role_complete: true
    }
  }
}

fn restore_checker_observation(checkpoint: CheckerObservationCheckpoint, capture: Option[CheckerStatementCapture], role_capture: Option[TypedOccurrenceRoleLaneCapture], tytab: Array[(Int, Type)]) -> Unit {
  Array::truncate(tytab, checkpoint.tytab_len)
  match capture {
    Some(StatementTypedOccurrences(entries)) => Array::truncate(entries, checkpoint.statement_entries_len),
    Some(StatementRootTypes(entries)) => Array::truncate(entries, checkpoint.statement_entries_len),
    _ => ()
  }
  match role_capture {
    Some(role) => {
      Array::truncate(role.entries, checkpoint.role_entries_len)
      Array::truncate(role.provenance_entries, checkpoint.role_provenance_len)
      Array::truncate(role.direct_entries, checkpoint.role_direct_len)
      role.statement_path = Array::slice(checkpoint.role_statement_path, 0, Array::length(checkpoint.role_statement_path))
      Array::truncate(role.frame_paths, checkpoint.role_frame_paths_len)
      Array::truncate(role.frame_next_children, checkpoint.role_frame_next_len)
      Array::truncate(role.frame_expected_children, checkpoint.role_frame_expected_len)
      Array::truncate(role.frame_direct_recorded, checkpoint.role_frame_direct_len)
      role.frame_depth = checkpoint.role_frame_depth
      role.complete = checkpoint.role_complete
    },
    None => ()
  }
}

/// Successful-check-only direct root types for retained expression-bearing
/// statements. Entries retain `(statement_path, closed_statement_kind, raw_type)`;
/// canonical consumers apply `checked_program.final_subst` after checking.
export struct CheckedStatementRootTypeObservation {
  checked_program: CheckedProgram;
  entries: Array[(Array[Int], String, Type)]
}

fn copy_ints(items: Array[Int]) -> Array[Int] {
  Array::slice(items, 0, Array::length(items))
}

/// Capture the legacy table rows appended by exactly one retained statement.
/// This observes the checker-time append range rather than reconstructing any
/// association from offsets. Module containers never own their child rows.
fn capture_statement_rows(entries: Array[(Array[Int], Int, Type)], tytab: Array[(Int, Type)], start: Int, path: Array[Int]) -> Unit {
  let mut i = start
  let mut ordinal = 0
  while i < Array::length(tytab) {
    let (_, ty) = Array::get(tytab, i)
    Array::push(entries, (copy_ints(path), ordinal, ty))
    i = i + 1
    ordinal = ordinal + 1
  }
}

fn typed_occurrence_statement_observation_from_capture(checked: CheckedProgram, entries: Array[(Array[Int], Int, Type)]) -> Option[CheckedTypedOccurrenceStatementObservation] {
  Some(CheckedTypedOccurrenceStatementObservation::{
    checked_program: checked,
    entries: entries
  })
}

fn typed_occurrence_role_lane_observation_from_capture(checked: CheckedProgram, entries: TypedOccurrenceRoleLaneCapture) -> Option[CheckedTypedOccurrenceRoleLaneObservation] {
  if Array::length(entries.entries) == Array::length(checked.typed_occurrences) {
    Some(CheckedTypedOccurrenceRoleLaneObservation::{
      checked_program: checked,
      entries: entries
    })
  } else {
    None
  }
}

fn typed_occurrence_expression_path_observation_from_capture(checked: CheckedProgram, entries: TypedOccurrenceRoleLaneCapture) -> Option[CheckedTypedOccurrenceExpressionPathObservation] {
  if entries.complete && Array::length(entries.provenance_entries) == Array::length(checked.typed_occurrences) {
    Some(CheckedTypedOccurrenceExpressionPathObservation::{
      checked_program: checked,
      entries: entries
    })
  } else {
    None
  }
}

fn capture_statement_root_type(capture: Option[CheckerStatementCapture], statement_path: Option[Array[Int]], kind: String, ty: Type) -> Unit {
  match capture {
    Some(StatementRootTypes(entries)) => match statement_path {
      Some(path) => Array::push(entries, (path, kind, ty)),
      None => ()
    },
    _ => ()
  }
}

fn statement_capture_is_root(capture: Option[CheckerStatementCapture]) -> Bool {
  match capture {
    Some(StatementRootTypes(_)) => true,
    Some(StatementDirectExpressionReturns) => true,
    _ => false
  }
}

fn root_type_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn root_type_capture_entries_valid_stmts(entries: Array[(Array[Int], String, Type)], stmts: Array[Stmt], parent: Array[Int], next: Int) -> (Bool, Int) {
  let mut valid = true
  let mut row = next
  let mut i = 0
  while i < Array::length(stmts) && valid {
    let stmt = Array::get(stmts, i)
    let path = copy_ints(parent)
    Array::push(path, i)
    match stmt {
      SLet(_, _, _, _, _) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SLet"
          row = row + 1
        } else {
          valid = false
        }
      },
      SLetMut(_, _, _) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SLetMut"
          row = row + 1
        } else {
          valid = false
        }
      },
      SLetPat(_, _) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SLetPat"
          row = row + 1
        } else {
          valid = false
        }
      },
      STest(_, _) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "STest"
          row = row + 1
        } else {
          valid = false
        }
      },
      SBench(_, _) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SBench"
          row = row + 1
        } else {
          valid = false
        }
      },
      SExpr(EIdent(name, _)) => {
        if String::starts_with(name, "@zero_alloc") {
          valid = false
        } else if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SExpr"
          row = row + 1
        } else {
          valid = false
        }
      },
      SExpr(_) => {
        if row < Array::length(entries) {
          let (actual_path, kind, _) = Array::get(entries, row)
          valid = root_type_paths_equal(actual_path, path) && kind == "SExpr"
          row = row + 1
        } else {
          valid = false
        }
      },
      SModule(_, _, body) => {
        let (nested_valid, nested_row) = root_type_capture_entries_valid_stmts(entries, body, path, row)
        valid = nested_valid
        row = nested_row
      },
      _ => ()
    }
    i = i + 1
  }
  (valid, row)
}

fn statement_root_type_observation_from_capture(checked: CheckedProgram, entries: Array[(Array[Int], String, Type)]) -> Option[CheckedStatementRootTypeObservation] {
  let (valid, consumed) = root_type_capture_entries_valid_stmts(entries, checked.checked_stmts, array_empty(), 0)
  if valid && consumed == Array::length(entries) {
    Some(CheckedStatementRootTypeObservation::{
      checked_program: checked,
      entries: entries
    })
  } else {
    None
  }
}

//# Functions

/// ADR-0069 Phase 1: locate a top-level statement for the reject diagnostics
/// below — first available source char-offset of the statement's value
/// expression (same walk as codegen's first_offset; duplicated locally to keep
/// checker → codegen imports out). -1 when no offset-carrying node exists; the
/// `[@off=N]` marker convention (see checker.vibe off_marker) then simply
/// stays off the message.
fn top_stmt_expr_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      top_stmt_expr_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      top_stmt_expr_off(base)
    },
    EBinOp(_, lhs, _) => top_stmt_expr_off(lhs),
    EUnaryOp(_, inner) => top_stmt_expr_off(inner),
    ELet(_, val, _, _) => top_stmt_expr_off(val),
    ELetRec(_, val, _) => top_stmt_expr_off(val),
    ELetMut(_, val, _, _) => top_stmt_expr_off(val),
    EAssign(_, val, _) => top_stmt_expr_off(val),
    EAssignOp(_, _, val, _) => top_stmt_expr_off(val),
    ESeq(first, _) => top_stmt_expr_off(first),
    EIf(cond, _, _) => top_stmt_expr_off(cond),
    EMatch(scrut, _) => top_stmt_expr_off(scrut),
    EReturn(inner) => top_stmt_expr_off(inner),
    _ => 0 - 1
  }
}

// ADR-0071 step 2 (#755) resolver core: effectset member-expansion cycle
// detection and qualified-name/operation collision detection, kept local to
// this file (no new cross-file function -- see docs/effectset.md's
// "Bootstrap gotcha" note on why introducing a brand new cross-file
// function+its first caller in the same change once broke
// generate_bundle.sh's flatten step). Full resolution (actually authorizing
// `with EffectsetName`) is still step 3; this only powers the two
// specific checks the ADR's Decision section calls out by name (cycle
// rejection, operation/effectset member-namespace collision) so the
// checker's current blanket "not yet supported" rejection at least
// distinguishes a genuinely invalid definition from one that is merely
// unresolved.

fn es_index_of(names: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) {
    if Array::get(names, i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn es_string_array_contains(arr: Array[String], v: String) -> Bool {
  es_index_of(arr, v) >= 0
}

/// "Effect::Name" -> (Some("Effect"), "Name"); unqualified -> (None, name).
fn es_split_qualified(name: String) -> (Option[String], String) {
  let idx = String::index_of(name, "::")
  if idx > 0 {
    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))
  } else {
    (None, name)
  }
}

fn es_join_arrow(names: Array[String]) -> String {
  let mut result = ""
  let mut i = 0
  while i < Array::length(names) {
    if i == 0 {
      result = Array::get(names, i)
    } else {
      result = String::concat(result, String::concat(" -> ", Array::get(names, i)))
    }
    i = i + 1
  }
  result
}

/// DFS over effectset member references. `path` is the chain of effectset
/// names visited in the CURRENT recursion (not a global visited set) so two
/// independent effectsets sharing a common, acyclic member is fine -- only
/// re-visiting a name already on the current path is a genuine cycle.
/// Members that are not themselves a known effectset name (an ordinary
/// effect name or a qualified operation) are leaves -- es_index_of returns
/// -1 for them, ending that branch.
fn es_detect_cycle(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String]) -> Option[String] {
  if es_string_array_contains(path, name) {
    Some(String::concat("effectset cycle: ", String::concat(es_join_arrow(path), String::concat(" -> ", name))))
  } else {
    let idx = es_index_of(es_names, name)
    if idx < 0 {
      None
    } else {
      let members = Array::get(es_members_list, idx)
      Array::push(path, name)
      let mut mi = 0
      let mut result = None
      while mi < Array::length(members) {
        match result {
          None => {
            result = es_detect_cycle(es_names, es_members_list, Array::get(members, mi), path)
          },
          Some(_) => ()
        }
        mi = mi + 1
      }
      Array::truncate(path, Array::length(path) - 1)
      result
    }
  }
}

/// `Env::Read` collides with `Env` if `Env` separately declares an operation
/// named `Read` -- the ADR's Decision section calls this out explicitly:
/// operation and effectset names share the effect-row member namespace, so a
/// reference to `Env::Read` would be ambiguous between the two.
fn es_qualified_collision(ed_names: Array[String], ed_ops_list: Array[Array[String]], qualified_name: String) -> Bool {
  let (eff_opt, member_name) = es_split_qualified(qualified_name)
  match eff_opt {
    Some(eff) => {
      let idx = es_index_of(ed_names, eff)
      if idx < 0 {
        false
      } else {
        es_string_array_contains(Array::get(ed_ops_list, idx), member_name)
      }
    },
    None => false
  }
}

/// Collect every effectset (name -> raw member list) and effect (name ->
/// operation names) declared at or after `from_idx` in `stmts`, in one pass.
/// Shared by check_stmts' own pre-pass (order-independent cycle/collision
/// checking) and collect_async_effect_errors' row-expansion pass below (step
/// 3) so both walks agree on exactly the same tables.
fn es_append_imported_tables(defs: Array[TypeDef], es_names: Array[String], es_members_list: Array[Array[String]], ed_names: Array[String], ed_ops_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(defs) {
    match Array::get(defs, i) {
      TDEffect(name, ops, _) => {
        let op_names = array_empty()
        let mut oi = 0
        while oi < Array::length(ops) {
          let (op, _, _) = Array::get(ops, oi)
          Array::push(op_names, op)
          oi = oi + 1
        }
        Array::push(ed_names, name)
        Array::push(ed_ops_list, op_names)
      },
      TDEffectSet(name, members) => {
        Array::push(es_names, name)
        Array::push(es_members_list, members)
      },
      _ => ()
    }
    i = i + 1
  }
}

fn es_collect_tables(stmts: Array[Stmt], from_idx: Int) -> (Array[String], Array[Array[String]], Array[String], Array[Array[String]]) {
  let es_names = array_empty()
  let es_members_list = array_empty()
  let ed_names = array_empty()
  let ed_ops_list = array_empty()
  let mut i = from_idx
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectSet(exported, esname, esmembers) => {
        Array::push(es_names, esname)
        Array::push(es_members_list, esmembers)
      },
      SEffectDef(_, edname, _, edops) => {
        let opnames = for op in edops {
          let (opname, _, _) = op
          opname
        }
        Array::push(ed_names, edname)
        Array::push(ed_ops_list, opnames)
      },
      _ => ()
    }
    i = i + 1
  }
  (es_names, es_members_list, ed_names, ed_ops_list)
}

/// ADR-0075 Phase 2 / ADR-0094 実装順 2 (#1343): validate the `resource Name :
/// Kind` declarations in one statement list.
///
/// Two rules, both about IDENTITY -- a resource declaration names a logical
/// thing the executable requires a binding for, so two declarations must not
/// be able to name the same thing under different names, nor one thing twice:
///
///   * a name may be declared once. The predeclared resources
///     (`Process::Root`) count as already-declared, so a program cannot
///     shadow the ambient process root with its own.
///   * a SINGLETON kind (`Process::Root`) already has its one inhabitant, so
///     nothing may be declared of it. `resource Home : Process::Root` would
///     be a second name for the one process, which ADR-0075's alias check
///     exists to prevent -- rejecting it at the declaration is cheaper than
///     detecting the alias at bind time.
///
/// Kind names themselves are NOT checked against a registry: there is no
/// resource-kind declaration syntax yet, so `S3::Bucket` (ADR-0075's own
/// example) has nowhere to be declared. The parser's qualified-path
/// requirement is the only well-formedness rule the kind carries today.
fn resource_decl_errors(stmts: Array[Stmt], from_idx: Int, errors: Array[String]) -> Unit {
  let seen = array_empty()
  let pre = predeclared_resources()
  let mut p = 0
  while p < Array::length(pre) {
    let (pname, _) = Array::get(pre, p)
    Array::push(seen, pname)
    p = p + 1
  }
  let mut i = from_idx
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SResource(rname, rkind) => {
        // String::concat rather than `\{}` interpolation: this module imports
        // @vibe/compiler/core, whose `__to_string(Int)` is what the
        // interpolation desugar resolves to here, so a String hole is a type
        // error. Same reason every other diagnostic in this file is built by
        // concat.
        if es_string_array_contains(seen, rname) {
          Array::push(errors, String::concat("resource '", String::concat(rname, "' is already declared -- a logical resource identity is declared once (ADR-0075)")))
        } else {
          Array::push(seen, rname)
        }
        if is_singleton_resource_kind(rkind) {
          Array::push(errors, String::concat("resource kind '", String::concat(rkind, String::concat("' is a singleton: its one inhabitant is '", String::concat(rkind, String::concat("' itself, so declaring '", String::concat(rname, "' of it would be a second name for the same thing (ADR-0075)")))))))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #1464: reject a value name declared twice in one DECLARATION list (the
/// top level of a file, or a `module { ... }` body). `fn` declarations are
/// lowered to `SLet` before the checker, so this covers `fn f` twice,
/// `let x` twice, and any mix of the two with `let mut` / `extern let`.
///
/// Deliberately NOT a shadowing check: this walk only ever sees declaration
/// lists (check_stmts_with_binders' two callers are the program root and the
/// SModule arm), never a function body, so the legal and widespread
/// `let x = ...; let x = f(x)` inside a block is untouched. At the top level
/// there is no sequencing to shadow -- declarations are hoisted (see the
/// hoist_i pre-pass), so both `x`s are in scope for the whole file and every
/// reference resolves to the last one, silently.
///
/// `_` is skipped: `let _ = ...` is a discard, not a name.
fn duplicate_value_decl_note(seen: Array[String], dname: String, errors: Array[String]) -> Unit {
  if dname == "_" {
    ()
  } else if es_string_array_contains(seen, dname) {
    Array::push(errors, String::concat("duplicate declaration: ", dname))
  } else {
    Array::push(seen, dname)
  }
}

fn import_bound_name(item: ImportItem) -> String {
  match item.alias {
    Some(a) => a,
    None => item.name
  }
}

fn import_item_is_value_binding(item: ImportItem) -> Bool {
  match item.kind {
    None => true,
    Some(_) => false
  }
}

fn name_is_type_head(n: String) -> Bool {
  if String::length(n) == 0 {
    false
  } else if String::contains(n, "::") {
    false
  } else {
    let c = String::char_code_at(n, 0)
    c >= 65 && c <= 90
  }
}

fn duplicate_import_value_note(seen: Array[String], item: ImportItem, errors: Array[String]) -> Unit {
  if !import_item_is_value_binding(item) {
    ()
  } else {
    let local = import_bound_name(item)
    // The source name, not its local alias, distinguishes the unkinded
    // type-head form (`HashMap as Shared`) from a value (`abs as Abs`).
    if name_is_type_head(item.name) {
      ()
    } else {
      duplicate_value_decl_note(seen, local, errors)
    }
  }
}

fn duplicate_value_decl_errors(stmts: Array[Stmt], from_idx: Int, errors: Array[String]) -> Unit {
  let let_seen = array_empty()
  let import_seen = array_empty()
  let mut i = from_idx
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => duplicate_value_decl_note(let_seen, n, errors),
      SLetMut(n, _, _) => duplicate_value_decl_note(let_seen, n, errors),
      SExternLet(n, _) => duplicate_value_decl_note(let_seen, n, errors),
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          duplicate_import_value_note(import_seen, Array::get(items, j), errors)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

/// ADR-0071 step 3 (#755) row expansion: recursively expand `name` into leaf
/// labels (ordinary effect/operation names -- not further-expandable
/// effectset names) via es_names/es_members_list, appending each freshly
/// seen leaf into `out` (deduped). `path` guards against cycles the SAME way
/// es_detect_cycle does (a name already on the current recursion path is
/// skipped, not re-expanded) so a cyclic definition -- already flagged as an
/// error by es_detect_cycle elsewhere in the SAME check_stmts pass -- cannot
/// hang this walk even though this function does not itself re-validate
/// acyclicity.
fn es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {
  if es_string_array_contains(path, name) {
    ()
  } else {
    let idx = es_index_of(es_names, name)
    if idx < 0 {
      if es_string_array_contains(out, name) {
        ()
      } else {
        Array::push(out, name)
      }
    } else {
      Array::push(path, name)
      let members = Array::get(es_members_list, idx)
      let mut mi = 0
      while mi < Array::length(members) {
        es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)
        mi = mi + 1
      }
      Array::truncate(path, Array::length(path) - 1)
    }
  }
}

fn es_expand_label(es_names: Array[String], es_members_list: Array[Array[String]], name: String) -> Array[String] {
  let out = array_empty()
  es_expand_into(es_names, es_members_list, name, array_empty(), out)
  out
}

fn es_join_comma(names: Array[String]) -> String {
  let mut result = ""
  let mut i = 0
  while i < Array::length(names) {
    if i == 0 {
      result = Array::get(names, i)
    } else {
      result = String::concat(result, String::concat(", ", Array::get(names, i)))
    }
    i = i + 1
  }
  result
}

/// Expand every effectset-name token in a raw comma-joined effect row
/// (TyFn/EFn's `Option[String]` field) into its flat leaf-label expansion,
/// leaving ordinary effect/operation labels and row variables untouched
/// (es_expand_label is a no-op passthrough for any name that isn't a known
/// effectset). `with AskAll + Fs` where `effectset AskAll = { Ask }`
/// becomes `"Ask, Fs"` -- from that point on, the EXISTING string-label-based
/// containment machinery (decl_authorizes_effect et al., unmodified) sees
/// only base labels, so `AskAll` now genuinely authorizes what it expands to
/// instead of needing to be literally re-declared verbatim by every caller.
fn es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  if Array::length(es_names) == 0 {
    row
  } else {
    let raw = String::split(row, ", ")
    let out = array_empty()
    let mut i = 0
    while i < Array::length(raw) {
      let expanded = es_expand_label(es_names, es_members_list, Array::get(raw, i))
      let mut j = 0
      while j < Array::length(expanded) {
        let e = Array::get(expanded, j)
        if es_string_array_contains(out, e) {
          ()
        } else {
          Array::push(out, e)
        }
        j = j + 1
      }
      i = i + 1
    }
    es_join_comma(out)
  }
}

fn es_expand_opt_row(eff: Option[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[String] {
  match eff {
    Some(row) => Some(es_expand_row_string(row, es_names, es_members_list)),
    None => None
  }
}

fn es_expand_texpr(te: TypeExpr, es_names: Array[String], es_members_list: Array[Array[String]]) -> TypeExpr {
  match te {
    TyFn(params, ret, eff) => TyFn(params, ret, es_expand_opt_row(eff, es_names, es_members_list)),
    _ => te
  }
}

fn es_expand_opt_texpr(ty: Option[TypeExpr], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[TypeExpr] {
  match ty {
    Some(te) => Some(es_expand_texpr(te, es_names, es_members_list)),
    None => None
  }
}

/// Also expands a PARAMETER's own function-typed annotation (the #885
/// callback-overlay case, e.g. `run(f: () -> Int with AskAll) -> Int`) --
/// es_expand_opt_texpr already handles any TypeExpr generically (it only
/// touches TyFn's effect slot, passing every other shape through unchanged),
/// so reusing it here for each param needs no new logic.
fn es_expand_top_value(e: Expr, es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {
  match e {
    EFn(tps, tbs, params, ret, eff, body) => {
      let expanded_params = for p in params {
        let (pname, pty) = p
        (pname, es_expand_opt_texpr(pty, es_names, es_members_list))
      }
      EFn(tps, tbs, expanded_params, ret, es_expand_opt_row(eff, es_names, es_members_list), body)
    },
    _ => e
  }
}

/// Rewrite a top-level binding's OWN declared effect row(s) -- the `ty`
/// annotation (`let f: () -> T with Es = ...`), the EFn value's own
/// inline row (`let f = () -> T with Es { ... }`), and every
/// PARAMETER's own function-typed row -- expanding any effectset-name token
/// before check_perform_effects_stmts_env (unmodified) sees it. A parameter
/// nested more than one level deep (a function-typed field inside a struct
/// parameter, for instance) is not covered -- a further, smaller follow-up.
fn es_expand_stmt_effect_rows(stmt: Stmt, es_names: Array[String], es_members_list: Array[Array[String]]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),
    SLetMut(name, ty, body) => SLetMut(name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),
    _ => stmt
  }
}

fn es_expand_stmts_effect_rows(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[Stmt] {
  if Array::length(es_names) == 0 {
    stmts
  } else {
    for s in stmts {
      es_expand_stmt_effect_rows(s, es_names, es_members_list)
    }
  }
}

/// Expand root-level effectset rows on a non-mutating checker input copy.
/// The retained CheckedProgram statements deliberately remain the original
/// post-desugar source representation, while all checking passes see this
/// identical expanded copy on both ordinary and imported-environment paths.
fn es_expand_top_level_effectset_rows(stmts: Array[Stmt], initial_env: TypeEnv) -> Array[Stmt] {
  let (top_es_names, top_es_members_list, top_ed_names, top_ed_ops) = es_collect_tables(stmts, 0)
  es_append_imported_tables(env_type_defs(initial_env), top_es_names, top_es_members_list, top_ed_names, top_ed_ops)
  es_expand_stmts_effect_rows(stmts, top_es_names, top_es_members_list)
}

/// String::concat only (never `+` / interpolation — NUL-miscodegen hazard
/// here, same rule as checker.vibe off_marker).
fn top_level_reject_msg(what: String, e: Expr) -> String {
  let base = String::concat(what, " (ADR-0069)")
  let off = top_stmt_expr_off(e)
  if off >= 0 {
    String::concat(base, String::concat(" [@off=", String::concat(__to_string(off), "]")))
  } else {
    base
  }
}

fn import_cache_lookup(cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {
  if i >= Array::length(cache) {
    None
  }
  else {
    let (cached_name, cached_ty) = Array::get(cache, i)
    if cached_name == name {
      Some(cached_ty)
    }
    else import_cache_lookup(cache, name, i + 1)
  }
}

fn bind_stmt_imports(env: TypeEnv, names: Array[ImportItem]) -> TypeEnv {
  let env_bindings = env_flat_bindings(env)
  let import_cache = array_empty()
  let nlen = Array::length(names)
  let mut i = 0
  let mut acc = env
  while i < nlen {
    let item = Array::get(names, i)
    let name = item.name
    let alias = item.alias
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let ty = match import_cache_lookup(import_cache, name, 0) {
      Some(t) => t,
      None => {
        let resolved = match env_lookup_flat(env_bindings, name) {
          Some(t) => t,
          None => CtUnknown
        }
        Array::push(import_cache, (name, resolved))
        resolved
      }
    }
    let acc_with_name = env_bind(acc, bound_name, ty)
    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {
      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),
      None => acc_with_name
    }
    i = i + 1
  }
  acc
}

fn annotation_return_type(ann: Option[TypeExpr], defs: Array[TypeDef]) -> Option[Type] {
  match ann {
    Some(te) => match te {
      TyFn(params, ret, _) => {
        let ret_box = Array::slice([ret], 0, 1)
        let _ = Array::length(params)
        Some(resolve_type_expr(Array::get(ret_box, 0), defs))
      },
      _ => None
    },
    None => None
  }
}

fn fn_expr_return_type(expr: Expr, defs: Array[TypeDef]) -> Option[Type] {
  match expr {
    EFn(_, _, _, ret_ty, _, _) => match ret_ty {
      Some(te) => Some(resolve_type_expr(te, defs)),
      None => None
    },
    _ => None
  }
}

fn bind_fn_return(env: TypeEnv, name: String, ret_ty: Type) -> TypeEnv {
  env_bind(env, fn_return_env_name(name), ret_ty)
}

fn bind_annotation_return(env: TypeEnv, name: String, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {
  match annotation_return_type(ann, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => env
  }
}

fn bind_value_or_annotation_return(env: TypeEnv, name: String, val: Expr, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {
  match fn_expr_return_type(val, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => bind_annotation_return(env, name, ann, defs)
  }
}

fn struct_derives_has(derives: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(derives) {
    if Array::get(derives, i) == name {
      found = true
      i = Array::length(derives)
    } else {
      i = i + 1
    }
  }
  found
}

/// The derivable traits the structural `derive(...)` desugar understands. Any
/// other name in a `derive(...)` clause is rejected with `unknown trait: <name>`
/// (#638) so a typo / unsupported trait fails the compile instead of silently
/// generating nothing.
fn derive_name_is_known(name: String) -> Bool {
  name == "Eq" || name == "Ord" || name == "Show" || name == "Hash" || name == "Default"
}

/// #1464: reject a constructor name declared twice by the SAME enum /
/// suberror. #1078's `find_other_enum_declaring_variant` deliberately skips
/// the declaration being registered (`other_name != enum_name`), so the
/// within-one-declaration case fell between the two checks and nothing
/// caught it.
///
/// It has to be an error rather than last-wins: `env_bind` is
/// last-registered-wins, so `enum E { A(Int); A(String) }` silently binds
/// only the second `A` and the first payload type becomes unreachable --
/// `A(1)` then reports `argument type mismatch for A: expected String, got
/// Int` pointing at a constructor the source really does declare with an
/// `Int`. Codegen is worse: variant TAGS are assigned by position, so a
/// `match` arm written against the first `A` gets the second one's tag.
///
/// `variants` is scanned rather than the registered `defs` entry because
/// both callers push their TDEnum before binding, which would make every
/// variant its own duplicate.
fn duplicate_ctor_errors(kind: String, name: String, variants: Array[(String, Array[TypeExpr])], errors: Array[String]) -> Unit {
  let seen = array_empty()
  let mut i = 0
  while i < Array::length(variants) {
    let (vname, _) = Array::get(variants, i)
    if es_string_array_contains(seen, vname) {
      Array::push(errors, String::concat("type definition: duplicate ctor: ", String::concat(vname, String::concat(" is declared more than once by ", String::concat(kind, String::concat(" ", name))))))
    } else {
      Array::push(seen, vname)
    }
    i = i + 1
  }
}

/// Every enum declared by THIS statement list. #1455 uses it to keep an
/// imported enum from shadowing a same-named local one: `find_typedef` is
/// first-match-wins and the seeded entries sit at the front of `defs`.
/// `SSuberror` is included because it registers constructors the same way an
/// enum does, and `SModule` bodies are walked because they check against the
/// same flat `defs` -- an enum declared inside one is just as local.
fn local_enum_names(stmts: Array[Stmt], variant_names: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SModule(_, _, body) => {
        let nested = local_enum_names(body, variant_names)
        let mut ni = 0
        while ni < Array::length(nested) {
          Array::push(out, Array::get(nested, ni))
          ni = ni + 1
        }
      },
      SEnum(_, name, _, variants, _) => {
        Array::push(out, name)
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          Array::push(variant_names, vname)
          vi = vi + 1
        }
      },
      SSuberror(_, name, variants) => {
        Array::push(out, name)
        let mut si = 0
        while si < Array::length(variants) {
          let (sname, _) = Array::get(variants, si)
          Array::push(variant_names, sname)
          si = si + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Gather every `(qualifier, variant)` pair the parser recorded for this
/// program, from the `SQualifiedPatternRefs` markers its parse appended.
///
/// A merged/linked unit concatenates several modules' statement arrays, so
/// there can be more than one marker; all of them describe patterns that this
/// compilation is about to check, and all of them are validated against the
/// same finished enum table.
fn collect_qualified_pattern_refs(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SQualifiedPatternRefs(refs) => {
        let mut ri = 0
        while ri < Array::length(refs) {
          Array::push(out, Array::get(refs, ri))
          ri = ri + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Seed imported declaration authority before checking. The published
/// `EnvTypeDefs` chain is the sole source for enum, struct, and alias defs;
/// the old `Enum::__variants__` value carrier is intentionally not consulted.
/// Generic enum payloads are name-parameterized on the wire and rebound to
/// this check's fresh ids here, exactly once.
fn local_type_def_names(stmts: Array[Stmt]) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, name, _, _, _) => Array::push(names, name),
      SSuberror(_, name, _) => Array::push(names, name),
      SStruct(_, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(_, name, _, _) => Array::push(names, name),
      SEffectDef(_, name, _, _) => Array::push(names, name),
      SEffectSet(_, name, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// #2125: index of the first `TypeDef` in `defs` at or after `from` named
/// `name`, or -1. With `from = 0` this mirrors `find_typedef`'s
/// first-match-wins rule.
fn typedef_index_of_from(defs: Array[TypeDef], name: String, from: Int) -> Int {
  let mut i = from
  let mut found = 0 - 1
  while i < Array::length(defs) && found < 0 {
    let matched = match Array::get(defs, i) {
      TDEnum(n, _, _) => n == name,
      TDStruct(n, _, _, _) => n == name,
      TDAlias(n, _, _) => n == name,
      TDEffect(n, _, _) => n == name,
      TDEffectSet(n, _) => n == name
    }
    if matched {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #2125: the `defs` slot THIS declaration owns. Codex review on #2147: the
/// arms below overwrite their slot with `Array::set`, so taking any
/// same-named slot would let one declaration replace another's definition --
/// a nested statement list shares the caller's `defs` array (the `SModule`
/// arm recurses with it), and a repeated name inside one list would resolve
/// to whichever declaration ran last instead of the first, as `find_typedef`
/// promises.
///
/// So a declaration only ever takes a slot that (a) this list's own pre-pass
/// claimed -- everything at or after `preclaim_from` -- and (b) no earlier
/// declaration in this list has taken. Otherwise it appends its own, which is
/// exactly what the code did before the pre-pass existed.
fn own_typedef_slot(defs: Array[TypeDef], type_def_binders: Array[Array[Int]], taken: Array[Int], name: String, preclaim_from: Int, placeholder: TypeDef) -> Int {
  let mut idx = typedef_index_of_from(defs, name, preclaim_from)
  while idx >= 0 && int_array_contains(taken, idx) {
    idx = typedef_index_of_from(defs, name, idx + 1)
  }
  if idx >= 0 {
    Array::push(taken, idx)
    idx
  } else {
    Array::push(defs, placeholder)
    Array::push(type_def_binders, array_empty())
    let fresh = Array::length(defs) - 1
    Array::push(taken, fresh)
    fresh
  }
}

fn int_array_contains(items: Array[Int], wanted: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == wanted {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #2125: claim a `defs` slot for every enum/struct/suberror
/// DECLARED IN THIS statement list, before anything resolves a type
/// expression. Without it, `resolve_type_expr` falls through to
/// `CtNamed(name, [])` for (a) a type's reference to ITSELF (its payloads are
/// resolved before its own `Array::push(defs, ..)`) and (b) a reference to a
/// type declared later in the same list. Both are indistinguishable from an
/// un-instantiated generic formal, which `check_assignable` tolerates.
///
/// `STypeAlias` is deliberately NOT pre-claimed: a placeholder alias body
/// would be a lie (an alias resolves THROUGH to its target, so an empty
/// placeholder would silently retarget every early reference), whereas a
/// placeholder enum/struct only needs its head to resolve. A forward
/// reference to a later alias therefore stays unresolved.
/// ONE SLOT PER DECLARATION, not per name (Codex review on #2147). Claiming
/// unconditionally is what makes `own_typedef_slot` able to hand every
/// declaration a slot of its own, and it reproduces the pre-#2125 `defs`
/// ORDER exactly: the old code pushed one entry per declaration at the point
/// the walk reached it, and `find_typedef` is first-match-wins, so a name that
/// an enclosing list or a repeat in this list already declared keeps
/// resolving to that earlier entry either way.
fn preclaim_local_type_defs(stmts: Array[Stmt], from: Int, defs: Array[TypeDef], type_def_binders: Array[Array[Int]]) -> Unit {
  let mut i = from
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, name, params, _, _) => {
        Array::push(defs, TDEnum(name, params, array_empty()))
        Array::push(type_def_binders, array_empty())
      },
      SSuberror(_, name, _) => {
        Array::push(defs, TDEnum(name, array_empty(), array_empty()))
        Array::push(type_def_binders, array_empty())
      },
      SStruct(_, name, _, _, mut_fields, tparams) => {
        Array::push(defs, TDStruct(name, array_empty(), mut_fields, tparams))
        Array::push(type_def_binders, array_empty())
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #2125 (field enforcement): erased names each trait's synthesized
/// `<Trait>Dict` witness struct may spell in its fields -- `Self`, the
/// trait's type parameters, and each method's own generic binders.
/// `desugar_trait_dict`'s `make_dict_struct_stmt` copies the trait method
/// signatures verbatim; the pass runs after checking in the ordinary lane,
/// but whole-program lanes re-check its output, so the checker does see
/// those fields. Provenance, not name shape alone (the #1869/#2147 lesson):
/// the struct name must be the trait's dict spelling AND the field must be a
/// method that trait declares. One row per trait:
/// (dict struct name, method names, erased names).
fn collect_trait_dict_erasures(stmts: Array[Stmt]) -> Array[(String, String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, methods, method_gens, tparams) => {
        let dict_name = String::concat(tname, "Dict")
        // One row PER METHOD (Codex on #2162): `Self` and the trait's own
        // params are trait-wide, but a method's generic binders are in scope
        // only for that method's field -- a trait-wide union let field `a`
        // spell method `b`'s binder and stay a wildcard.
        let mut mi = 0
        while mi < Array::length(methods) {
          let (mname, _, _) = Array::get(methods, mi)
          let erased = array_empty()
          Array::push(erased, "Self")
          let mut ti = 0
          while ti < Array::length(tparams) {
            Array::push(erased, Array::get(tparams, ti))
            ti = ti + 1
          }
          let mut gi = 0
          while gi < Array::length(method_gens) {
            let (gmname, gnames, _) = Array::get(method_gens, gi)
            if gmname == mname {
              let mut gni = 0
              while gni < Array::length(gnames) {
                Array::push(erased, Array::get(gnames, gni))
                gni = gni + 1
              }
            } else {
              ()
            }
            gi = gi + 1
          }
          Array::push(out, (dict_name, mname, erased))
          mi = mi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #2125 (field/payload enforcement): the deferred-name sentinels in this
/// statement list. A materialized vpkg types module references names it can
/// neither declare nor import (a contract-`opaque` name defined in a sibling
/// impl -- types -> impl would be an import cycle -- or a name from another
/// package); those resolve to the intentional bare-`CtNamed` contract
/// artifact, and `contract_types_module_text` carries them IN-BAND as a
/// `let __vpkg_deferred_type_names_<uniq>__: String = "N1 N2"` binding, so
/// the exemption travels with the text through every lane -- per-module,
/// cached, or injected into a whole-program merge (where the names resolve
/// anyway and the exemption is inert).
fn collect_deferred_type_name_sentinels(stmts: Array[Stmt]) -> Array[(Array[String], Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, lname, _, value) => if String::starts_with(lname, "__vpkg_deferred_type_names_") {
        match value {
          EString(names) => {
            // `<protected decls> : <deferred names>` -- names before the `:`
            // are the declarations the exemption applies to (Codex round 3 on
            // #2162: unscoped, a merge-lane sentinel excused an unrelated
            // declaration misspelling one of these names). A sentinel with no
            // `:` protects nothing.
            let protected = array_empty()
            let deferred = array_empty()
            let parts = String::split(names, " ")
            let mut seen_sep = false
            let mut pi = 0
            while pi < Array::length(parts) {
              let p = Array::get(parts, pi)
              if p == ":" {
                seen_sep = true
              } else if p == "" {
                ()
              } else if seen_sep {
                Array::push(deferred, p)
              } else {
                Array::push(protected, p)
              }
              pi = pi + 1
            }
            if seen_sep && Array::length(deferred) > 0 {
              Array::push(out, (protected, deferred))
            } else {
              ()
            }
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The deferred names whose sentinel protects `decl_name`, or empty.
fn deferred_names_for_decl(rows: Array[(Array[String], Array[String])], decl_name: String) -> Array[String] {
  let mut i = 0
  let mut found = array_empty()
  while i < Array::length(rows) {
    let (protected, deferred) = Array::get(rows, i)
    if string_array_contains(protected, decl_name) {
      found = deferred
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}

/// #2125 (field/payload enforcement): the shadow list for a DECLARATION's
/// unknown-type report -- the declaration's own type parameters, any
/// trait-dict erased names, plus this statement list's deferred-name
/// sentinels (see `collect_deferred_type_name_sentinels`).
fn decl_report_shadow(tparams: Array[String], dict_erased: Array[String], deferred: Array[String]) -> Array[String] {
  if Array::length(dict_erased) == 0 && Array::length(deferred) == 0 {
    tparams
  } else {
    let s2 = array_empty()
    let mut si = 0
    while si < Array::length(tparams) {
      Array::push(s2, Array::get(tparams, si))
      si = si + 1
    }
    let mut di = 0
    while di < Array::length(dict_erased) {
      Array::push(s2, Array::get(dict_erased, di))
      di = di + 1
    }
    let mut fi = 0
    while fi < Array::length(deferred) {
      Array::push(s2, Array::get(deferred, fi))
      fi = fi + 1
    }
    s2
  }
}

/// The erased-name row for `struct_name`/`field_name`, or empty when no
/// trait in this statement list declares that dict/method pair.
fn trait_dict_erasure_for(erasures: Array[(String, String, Array[String])], struct_name: String, field_name: String) -> Array[String] {
  let mut i = 0
  let mut found = array_empty()
  while i < Array::length(erasures) {
    let (dname, mname, erased) = Array::get(erasures, i)
    if dname == struct_name && mname == field_name {
      found = erased
      i = Array::length(erasures)
    } else {
      i = i + 1
    }
  }
  found
}

fn string_array_contains(items: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == wanted {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn imported_decl_kind(item: ImportItem, expected: ImportKind, initial_env: TypeEnv, builtin_authority: Bool) -> Option[String] {
  let defs = env_type_defs(initial_env)
  let selectable_defs = env_selectable_type_defs(initial_env)
  let mut found: Option[String] = None
  let mut matching: Option[String] = None
  let mut i = 0
  while i < Array::length(defs) {
    let candidate = if string_array_contains(selectable_defs, item.name) {
      match Array::get(defs, i) {
        TDAlias(name, _, _) => if name == item.name {
          Some("type alias")
        } else {
          None
        },
        TDStruct(name, _, _, _) => if name == item.name {
          Some("struct")
        } else {
          None
        },
        TDEnum(name, _, _) => if name == item.name {
          Some("enum")
        } else {
          None
        },
        TDEffect(name, _, _) => if name == item.name {
          Some("effect")
        } else {
          None
        },
        TDEffectSet(name, _) => if name == item.name {
          Some("effect set")
        } else {
          None
        }
      }
    } else {
      None
    }
    match candidate {
      Some(kind) => {
        if found == None {
          found = Some(kind)
        } else {
          ()
        }
        if import_kind_matches(expected, kind) {
          matching = Some(kind)
        } else {
          ()
        }
      },
      None => ()
    }
    i = i + 1
  }
  let has_trait = trait_defined(initial_env, item.name)
  if has_trait && import_kind_matches(expected, "trait") {
    Some("trait")
  } else {
    match matching {
      Some(kind) => Some(kind),
      None => match found {
        Some(kind) => Some(kind),
        None => {
          if has_trait {
            Some("trait")
          } else if (builtin_authority || string_array_contains(selectable_defs, item.name)) && resolve_builtin(item.name) != None {
            // Opaque primitive declarations from @vibe/builtin are represented
            // by their canonical value-type binding rather than a TypeDef row.
            // Their contract spelling is still `type Int`, `type String`, etc.
            Some("type alias")
          } else if env_lookup_flat(env_flat_bindings(initial_env), item.name) != None {
            Some("value")
          } else {
            None
          }
        }
      }
    }
  }
}

fn import_kind_label(kind: ImportKind) -> String {
  match kind {
    ImportType => "type alias",
    ImportStruct => "struct",
    ImportEnum => "enum",
    ImportEffect => "effect",
    ImportTrait => "trait"
  }
}

fn import_kind_matches(expected: ImportKind, actual: String) -> Bool {
  actual == import_kind_label(expected)
}

fn import_kind_article(label: String) -> String {
  if label == "enum" || label == "effect" || label == "effect set" {
    "an"
  } else {
    "a"
  }
}

fn check_import_item_kinds(items: Array[ImportItem], initial_env: TypeEnv, builtin_authority: Bool, errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    match item.kind {
      None => (),
      Some(expected) => match imported_decl_kind(item, expected, initial_env, builtin_authority) {
        None => (),
        Some(actual) => {
          let wanted = import_kind_label(expected)
          if !import_kind_matches(expected, actual) {
            Array::push(errors, "import kind mismatch: `\{item.name}` is \{import_kind_article(actual)} \{actual}, not \{import_kind_article(wanted)} \{wanted}")
          }
        }
      }
    }
    i = i + 1
  }
}

export fn import_item_kind_errors(items: Array[ImportItem], initial_env: TypeEnv, builtin_authority: Bool) -> Array[String] {
  let errors = array_empty()
  check_import_item_kinds(items, initial_env, builtin_authority, errors)
  errors
}

fn check_import_kinds(stmts: Array[Stmt], initial_env: TypeEnv, errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => check_import_item_kinds(items, initial_env, path == "@vibe/builtin", errors),
      SReExport(path, items) => check_import_item_kinds(items, initial_env, path == "@vibe/builtin", errors),
      SModule(_, _, body) => check_import_kinds(body, initial_env, errors),
      _ => ()
    }
    i = i + 1
  }
}

fn seed_imported_type_defs(stmts: Array[Stmt], initial_env: TypeEnv, defs: Array[TypeDef], type_def_binders: Array[Array[Int]]) -> (Int, Int) {
  let imported = env_type_defs(initial_env)
  // `find_typedef` is first-match-wins. Local declarations are checked after
  // this seed, so omit same-named imported authority up front; otherwise an
  // imported typedef would permanently win over the lexical local declaration.
  let local_names = local_type_def_names(stmts)
  let mut next_c = 0
  let mut i = 0
  while i < Array::length(imported) {
    let def = Array::get(imported, i)
    let name = match def {
      TDEnum(n, _, _) => n,
      TDStruct(n, _, _, _) => n,
      TDAlias(n, _, _) => n,
      TDEffect(n, _, _) => n,
      TDEffectSet(n, _) => n
    }
    // First declaration wins, matching find_typedef and the import cache's
    // first-match rule. A projected interface never contains effects here.
    match find_typedef(defs, name) {
      Some(_) => (),
      None => if string_array_contains(local_names, name) {
        ()
      } else match def {
        TDEnum(enum_name, params, variants) => {
          let ids = array_empty()
          let vars = array_empty()
          let mut pi = 0
          while pi < Array::length(params) {
            Array::push(ids, next_c + pi)
            Array::push(vars, CtVar(next_c + pi))
            pi = pi + 1
          }
          next_c = next_c + Array::length(params)
          let rebound = array_empty()
          let mut vi = 0
          while vi < Array::length(variants) {
            let (variant, fields) = Array::get(variants, vi)
            let rebound_fields = array_empty()
            let mut fi = 0
            while fi < Array::length(fields) {
              Array::push(rebound_fields, subst_type_params(Array::get(fields, fi), params, vars))
              fi = fi + 1
            }
            Array::push(rebound, (variant, rebound_fields))
            vi = vi + 1
          }
          Array::push(defs, TDEnum(enum_name, params, rebound))
          Array::push(type_def_binders, ids)
        },
        TDStruct(struct_name, fields, mut_fields, params) => {
          Array::push(defs, TDStruct(struct_name, fields, mut_fields, params))
          Array::push(type_def_binders, array_empty())
        },
        TDAlias(alias_name, params, target) => {
          Array::push(defs, TDAlias(alias_name, params, target))
          Array::push(type_def_binders, array_empty())
        },
        TDEffect(effect_name, ops, params) => {
          Array::push(defs, TDEffect(effect_name, ops, params))
          Array::push(type_def_binders, array_empty())
        },
        TDEffectSet(_, _) => ()
      }
    }
    i = i + 1
  }
  (Array::length(defs), next_c)
}

/// #1078: the name of a DIFFERENT enum (already registered in `defs`) that
/// declares a variant named `vname`, or None. Used to reject bare-name
/// constructor collisions at declaration time -- see the SEnum arm's
/// comment for why last-registered-wins shadowing makes these silently
/// wrong rather than merely ambiguous.
///
/// #1455: the scan starts at `local_defs_start`, so only enums declared by
/// THIS unit collide. Shadowing an imported constructor is ordinary,
/// already-working code (the local binding wins); the collision #1078 is
/// about only arises when both declarations land in one compiled unit via
/// the merge/flatten lane, where both are local.
///
/// `seed_imported_enum_defs` already drops any imported enum whose variant
/// names clash with a locally declared one, so there should be nothing here
/// for an unscoped scan to find; the bound is what makes that a guarantee
/// rather than a coincidence of the two scans agreeing.
fn find_other_enum_declaring_variant(defs: Array[TypeDef], local_defs_start: Int, enum_name: String, vname: String) -> Option[String] {
  let mut i = local_defs_start
  let mut found = None
  while i < Array::length(defs) {
    match Array::get(defs, i) {
      TDEnum(other_name, _, other_variants) => if other_name != enum_name {
        let mut vi = 0
        while vi < Array::length(other_variants) {
          let (ovn, _) = Array::get(other_variants, vi)
          if ovn == vname {
            found = Some(other_name)
          } else {
            ()
          }
          vi = vi + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// #2317: exported so the single-buffer contract lane reports an unknown
/// `derive` with the SAME message the build does (`unknown trait: X`), rather
/// than a second implementation of the same rule that could drift from it.
export fn validate_derives(derives: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(derives) {
    let name = Array::get(derives, i)
    if name != "" && !derive_name_is_known(name) {
      Array::push(errors, String::concat("unknown trait: ", name))
    } else {
      ()
    }
    i = i + 1
  }
}

fn stmt_is_type_decl(stmt: Stmt) -> Bool {
  match stmt {
    SEnum(_, _, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SStruct(_, _, _, _, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    SEffectDef(_, _, _, _) => true,
    _ => false
  }
}

/// #613: process type declarations (enum / struct / type-alias / suberror /
/// effect) before value definitions so a `let` or impl may reference a type
/// or constructor
/// declared LATER in the same statement list (a forward reference). check_stmts
/// records each type into `defs` and binds its constructors into `env` only when
/// the declaration statement is reached, so without this a value defined before
/// its enum saw neither the type nor its constructors and aborted the compile
/// with an opaque trap (e.g. an imported module whose function constructs an enum
/// value lands before the enum in the merged statement list). Codegen is already
/// order-independent (the ctor table scans every statement up front), so this
/// check-side reorder is sufficient. The partition is STABLE, so already-ordered
/// (type-before-value) code is processed exactly as before, and relative order
/// within each group is preserved.
fn reorder_type_decls_first(stmts: Array[Stmt], start: Int) -> Array[Stmt] {
  let out = Array::slice(stmts, 0, start)
  let n = Array::length(stmts)
  let mut i = start
  while i < n {
    let st = Array::get(stmts, i)
    if stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    i = i + 1
  }
  let mut j = start
  while j < n {
    let st = Array::get(stmts, j)
    if !stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    j = j + 1
  }
  out
}

/// Re-hoist the value declarations owned by one FS-merged source after its
/// re-export lookup barriers. The ordinary list-wide hoist sits below those
/// barriers, so without this pass a legitimate same-source declaration named
/// like a re-export would be hidden together with dependency definitions.
fn hoisted_binding_type(annotation: Option[TypeExpr], defs: Array[TypeDef]) -> Type {
  match annotation {
    Some(type_expr) => resolve_type_expr(type_expr, defs),
    None => CtUnknown
  }
}

/// #2318: the signature of a top-level `fn`, for the hoist.
///
/// A top-level `fn f(a: Int) -> Int { .. }` is an `SLet` whose types live on
/// the EFn's parameter list, NOT on a binding annotation -- so it hoisted as
/// `CtUnknown`, and a call placed ABOVE it saw a non-`CtFn` callee and fell
/// into the `_` arm of the call checker, which returns `CtUnknown` and reports
/// nothing. Measured: argument types, ARITY, and the return type were all
/// unchecked, and an arity-short forward call emitted a module wasm refuses to
/// instantiate (`not enough arguments on the stack for call`) with `vibe check`
/// silent. The same call written BELOW the definition was rejected, so the
/// verdict depended on source order.
///
/// A missing parameter or return annotation does NOT disqualify the signature:
/// that slot resolves to `CtUnknown`, which unifies with anything, so the
/// unannotated position goes unchecked exactly as before while arity and the
/// annotated positions are checked. `hoisted_binding_type` is what turns each
/// `Option[TypeExpr]` into a type, so there is one implementation of that rule
/// rather than a copy per slot.
///
/// Two shapes ARE excluded, because for them a synthesized signature would be
/// WRONG rather than merely imprecise:
///
///   - a type parameter makes a concrete `CtFn` a lie at every call site;
///   - an optional or labeled parameter (a trailing `~`/`?` in the raw AST
///     name, see `labeled_param_base_name`) may be omitted by a legitimate
///     call, so a strict arity would report a false error.
///
/// Both keep the `CtUnknown` the hoist gave everything before this. Ordered
/// (backward-reference) code is unaffected either way: the binding's own
/// statement fills in the precise type when it is reached and shadows this
/// pre-binding.
fn hoisted_fn_signature(value: Expr, defs: Array[TypeDef]) -> Type {
  match value {
    EFn(tparams, _bounds, params, ret, eff, _body) => if Array::length(tparams) > 0 {
      CtUnknown
    } else {
      let ptys = array_empty()
      let mut usable = true
      let mut i = 0
      while i < Array::length(params) {
        let (pname, pann) = Array::get(params, i)
        if labeled_param_base_name(pname) != pname {
          usable = false
        } else {
          Array::push(ptys, hoisted_binding_type(pann, defs))
        }
        i = i + 1
      }
      if usable {
        CtFn(ptys, hoisted_binding_type(ret, defs), eff)
      } else {
        CtUnknown
      }
    },
    _ => CtUnknown
  }
}

/// The type to pre-bind for a hoisted `SLet`: its annotation when it has one,
/// otherwise a `fn`'s own signature (#2318), otherwise unknown.
fn hoisted_value_type(annotation: Option[TypeExpr], value: Expr, defs: Array[TypeDef]) -> Type {
  match annotation {
    Some(type_expr) => resolve_type_expr(type_expr, defs),
    None => hoisted_fn_signature(value, defs)
  }
}

fn hoist_merged_source_values(stmts: Array[Stmt], start: Int, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  let mut out = env
  let mut i = start
  while i < Array::length(stmts) && !(Array::get(stmts, i) is SReExportSourceBoundary(_, _)) {
    match Array::get(stmts, i) {
      SLet(_, _, name, annotation, value) => {
        let ty = hoisted_value_type(annotation, value, defs)
        out = env_bind(out, name, ty)
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Map the stable type-declaration schedule back to the retained statement
/// coordinates. `checked_stmts` stays in source/post-desugar order even though
/// declaration checking is scheduled type-first.
fn reordered_type_decl_positions(stmts: Array[Stmt], start: Int) -> Array[Int] {
  let out = array_empty()
  let mut i = 0
  while i < start {
    Array::push(out, i)
    i = i + 1
  }
  while i < Array::length(stmts) {
    if stmt_is_type_decl(Array::get(stmts, i)) {
      Array::push(out, i)
    } else {
      ()
    }
    i = i + 1
  }
  let mut j = start
  while j < Array::length(stmts) {
    if !stmt_is_type_decl(Array::get(stmts, j)) {
      Array::push(out, j)
    } else {
      ()
    }
    j = j + 1
  }
  out
}

fn next_type_def_binder_id(type_def_binders: Array[Array[Int]], floor: Int) -> Int {
  let mut next = floor
  let mut i = 0
  while i < Array::length(type_def_binders) {
    let binders = Array::get(type_def_binders, i)
    let mut j = 0
    while j < Array::length(binders) {
      let candidate = Array::get(binders, j) + 1
      if candidate > next {
        next = candidate
      } else {
        ()
      }
      j = j + 1
    }
    i = i + 1
  }
  next
}

fn check_stmts_with_binders(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], type_def_binders: Array[Array[Int]], local_defs_start: Int, s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], statement_parent_path: Option[Array[Int]], capture: Option[CheckerStatementCapture], role_lane_capture: Option[TypedOccurrenceRoleLaneCapture], imports_already_projected: Bool, validate_completed_decls: Bool) -> (TypeEnv, Subst, Int) {
  let stmts = reorder_type_decls_first(raw_stmts, i)
  let completed_decl_error_insert_at = Array::length(errors)
  let observation_checkpoint = checker_observation_checkpoint(capture, role_lane_capture, tytab)
  // Retained coordinates exist solely for the opt-in observation. Keep the
  // ordinary checker path free of its position-map allocation.
  let retained_positions = match capture {
    Some(_) => Some(reordered_type_decl_positions(raw_stmts, i)),
    None => match role_lane_capture {
      Some(_) => Some(reordered_type_decl_positions(raw_stmts, i)),
      None => None
    }
  }
  let mut idx = i
  // #2125: see preclaim_local_type_defs.
  let preclaim_from = Array::length(defs)
  preclaim_local_type_defs(stmts, idx, defs, type_def_binders)
  let mut local_defs_end = preclaim_from
  // #2125 (field enforcement): see collect_trait_dict_erasures. Computed from
  // the statement LIST because reorder_type_decls_first hoists a synthesized
  // `<Trait>Dict` struct above its trait declaration, so the env cannot
  // answer at the struct's own check point.
  let trait_dict_erasures = collect_trait_dict_erasures(stmts)
  let deferred_type_names = collect_deferred_type_name_sentinels(stmts)
  // Slots this list's declarations have already taken (see own_typedef_slot).
  let taken_type_def_slots = array_empty()
  let mut cur_env = env
  let mut cur_s = s
  let mut cur_c = c
  // A nested module extends the definition table after earlier outer/module
  // values have already been checked. Record that condition so the root can
  // rebuild the value environment once from the completed type graph.
  let mut nested_defs_extended = false
  // #602: hoist top-level binding signatures so a `let` may reference another
  // top-level `let` defined later in the same statement list (a forward
  // reference). Without this, checking the earlier binding's body raised
  // "unknown name" and aborted the whole compile with an opaque trap.
  // check_stmts is only used for program / module statement lists — local
  // `let`s are ELet expressions checked in check_expr — so this does not affect
  // block scoping. An annotated binding hoists its declared type; an
  // un-annotated one hoists as CtUnknown (its precise type is filled in when its
  // own statement is reached, which shadows this pre-binding). Pre-binding only
  // adds names, and a later real binding shadows it, so ordered
  // (backward-reference) code is checked exactly as before.
  let mut hoist_i = idx
  while hoist_i < Array::length(stmts) {
    match Array::get(stmts, hoist_i) {
      SLet(_, _, hname, hann, hval) => {
        let ht = hoisted_value_type(hann, hval, defs)
        cur_env = env_bind(cur_env, hname, ht)
      },
      _ => ()
    }
    hoist_i = hoist_i + 1
  }
  // ADR-0071 step 2 (#755): collect every effectset (name -> raw member
  // list) and effect (name -> operation names) declared in THIS statement
  // list up front, mirroring the hoist_i pre-pass above, so a later
  // SEffectSet arm below can run es_detect_cycle/es_qualified_collision
  // regardless of declaration order (an effectset may reference another one
  // defined later in the same file, exactly like the SLet forward-reference
  // case this hoist mirrors). Shared with collect_async_effect_errors below
  // (step 3's row-expansion pass) via es_collect_tables so both walks stay
  // in sync from one implementation.
  let (es_names, es_members_list, ed_names, ed_ops_list) = es_collect_tables(stmts, idx)
  es_append_imported_tables(defs, es_names, es_members_list, ed_names, ed_ops_list)
  // ADR-0075 Phase 2 (#1343): resource identity rules need the WHOLE list
  // (duplicate detection), so they run here rather than in the SResource arm
  // below -- which is why that arm has nothing left to do.
  resource_decl_errors(stmts, idx, errors)
  // #1464: same shape -- duplicate value declarations need the WHOLE list.
  duplicate_value_decl_errors(stmts, idx, errors)
  // #942 (Codex P2 on #969): if any top-level declaration in this statement
  // list binds the name `resume` (fn/let — fn decls are lowered to SLet
  // before the checker — let-pattern, extern let, or an import), codegen's
  // prefer_bound_call routes every `resume(x)` in the file to that BOUND
  // function (a global name match, see codegen/expr/compile_call.vibe), so
  // the #942 misuse walks must stand down for the whole list.
  let mut resume_shadowed_top = false
  let mut rst_i = idx
  while rst_i < Array::length(stmts) {
    match Array::get(stmts, rst_i) {
      SLet(_, _, rstname, _, _) => if rstname == "resume" {
        resume_shadowed_top = true
      } else {
        ()
      },
      SLetMut(rstname, _, _) => if rstname == "resume" {
        resume_shadowed_top = true
      } else {
        ()
      },
      SExternLet(rstname, _) => if rstname == "resume" {
        resume_shadowed_top = true
      } else {
        ()
      },
      SLetPat(rstpat, _) => if pat_binds_resume(rstpat) {
        resume_shadowed_top = true
      } else {
        ()
      },
      SImport(_, rstnames) => {
        let mut rn_i = 0
        while rn_i < Array::length(rstnames) {
          let item = Array::get(rstnames, rn_i)
          let rn_name = item.name
          let rn_alias = item.alias
          let rn_bound = match rn_alias {
            Some(a) => a,
            None => rn_name
          }
          if rn_bound == "resume" {
            resume_shadowed_top = true
          } else {
            ()
          }
          rn_i = rn_i + 1
        }
      },
      SReExport(_, rstnames) => {
        let mut rn_i = 0
        while rn_i < Array::length(rstnames) {
          let item = Array::get(rstnames, rn_i)
          let rn_name = item.name
          let rn_alias = item.alias
          // A plain re-export can resolve to the dependency's merged
          // definition. An alias is publication-only and introduces no local
          // binder, so it must not shadow the special `resume` call (#2287).
          if rn_name == "resume" && rn_alias == None {
            resume_shadowed_top = true
          } else {
            ()
          }
          rn_i = rn_i + 1
        }
      },
      _ => ()
    }
    rst_i = rst_i + 1
  }
  while idx < Array::length(stmts) {
    let env = cur_env
    let s = cur_s
    let c = cur_c
    let stmt = Array::get(stmts, idx)
    let defs_before_stmt = Array::length(defs)
    // Do not construct paths or read the legacy append boundary on the normal
    // checker path. The parent/current coordinate is observation-only.
    let statement_path = match capture {
      Some(_) => match retained_positions {
        Some(positions) => match statement_parent_path {
          Some(parent_path) => {
            let path = copy_ints(parent_path)
            Array::push(path, Array::get(positions, idx))
            Some(path)
          },
          None => None
        },
        None => None
      },
      None => match role_lane_capture {
        Some(_) => match retained_positions {
          Some(positions) => match statement_parent_path {
            Some(parent_path) => {
              let path = copy_ints(parent_path)
              Array::push(path, Array::get(positions, idx))
              Some(path)
            },
            None => None
          },
          None => None
        },
        None => None
      }
    }
    match statement_path {
      Some(path) => typed_occurrence_capture_begin_statement(role_lane_capture, path),
      None => ()
    }
    let capture_start = match capture {
      Some(StatementTypedOccurrences(_)) => Some(Array::length(tytab)),
      _ => None
    }
    // #942 (ADR-0050): resume-misuse walk — a call-position `resume(...)`
    // outside any handler arm is rejected, and inside a (non-Error) arm it
    // must sit in tail position. Runs on a throwaway lane per statement
    // (only ADDS diagnostics; inference flow untouched). SModule bodies are
    // covered by the recursive check_stmts call below. `resume_shadowed_top`
    // (computed above): when a top-level declaration binds the name `resume`,
    // codegen's prefer_bound_call routes every `resume(x)` to the bound
    // function, so the misuse walk stands down (Codex P2 on #969).
    match stmt {
      SLet(_, _, _, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),
      SLetMut(_, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),
      SLetPat(_, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),
      STest(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),
      SBench(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),
      SExpr(re) => reject_resume_outside_handler(re, resume_shadowed_top, errors),
      _ => ()
    }
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let err_before = Array::length(errors)
        // #2125: an `impl` method is parsed as `let <Type>::<method> = ..`
        // (parser.vibe's parse_impl_methods), and its signature may spell the
        // trait's own erased type parameter with no binder of its own. Bind
        // those names -- and only the ones an actual impl licenses -- into the
        // environment the VALUE is checked in, never `env1` below, so they
        // cannot reach a published or cached environment.
        let val_env = trait_erased_type_param_env(env, name)
        let (vt, ns0, nc) = if is_rec {
          check_expr_capture(val, env_bind(val_env, name, CtUnknown), defs, s, c, errors, tytab, role_lane_capture, "Primary")
        } else {
          check_expr_capture(val, val_env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
        }
        attach_unlocated_decl_name_marker(errors, err_before, name)
        // The value must be assignable to a declared annotation (previously
        // unchecked — `let x: Int = "s"` was accepted).
        let (ns, t) = match ann {
          Some(te) => {
            let resolved_te = resolve_type_expr(te, defs)
            let actual_v = subst_apply(ns0, vt)
            // #844/#981: `check_assignable` itself now reports the same-name
            // concrete generic instantiation mismatch (its tolerate branch
            // calls `detect_narrowed_generic_mismatch` — see checker.vibe),
            // so the explicit second call this site used to make would
            // double-report the same diagnostic — dropped.
            // Anchor on the VALUE being bound, not the annotation: `let x: Int
            // = f()` is wrong at `f()`, and that is also where the edit goes.
            // -1 (unlocated, as before) for a literal RHS -- EInt/EString/
            // EBool/EFloat carry no offset in the AST.
            let ann_err_before = Array::length(errors)
            // #2125: a top-level binding's annotation. Reported HERE and not
            // at the forward-reference hoist above, which runs before any
            // declaration in this list has been walked -- at that point every
            // locally declared alias and effect name is still absent from
            // `defs` and would be reported as unknown. Inside the
            // `ann_err_before` window so the binder name anchors it.
            report_unknown_type_names(te, defs, array_empty(), env, array_empty(), String::concat(String::concat("the annotation of `", name), "`"), errors)
            let ns_b = check_assignable(resolved_te, actual_v, ns0, errors, String::concat("binding type mismatch for ", name), top_stmt_expr_off(val))
            // #1941: a literal value carries no offset, so anchor the binder
            // name instead of emitting the one unlocated diagnostic left in
            // this lane.
            attach_unlocated_decl_name_marker(errors, ann_err_before, name)
            // Prefer the RHS's real instantiated type over the erasing bare
            // annotation when `resolved_te` is a bare generic-struct
            // reference that `actual_v` already concretely instantiates, so a
            // LATER statement's lookup of this binding sees real type args
            // instead of an erased placeholder (see
            // `preserve_generic_instantiation`'s doc comment in checker.vibe).
            (ns_b, preserve_generic_instantiation(resolved_te, subst_apply(ns_b, vt)))
          },
          None => {
            let vt_resolved = subst_apply(ns0, vt)
            if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {
              // #938 value restriction: keep a builder's element var
              // un-quantified so pushes constrain each other (see the ELet
              // arm in checker.vibe). #1081 step 3 Phase B: a region-tagged
              // endpoint needs the identical treatment (see
              // is_region_tagged_ty's doc comment in checker.vibe).
              (ns0, vt)
            } else {
              (ns0, generalize(ns0, vt))
            }
          }
        }
        let env1 = bind_function_dependency_contracts(env_bind(env, name, t), name, val)
        capture_statement_root_type(capture, statement_path, "SLet", vt)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetMut(name, ann, val) => {
        // ADR-0069 Phase 1: top level is declarations only. A top-level
        // `let mut` was never soundly implemented (the linear backend
        // miscompiles cross-function references); reject it, but keep
        // checking/binding below for error recovery.
        Array::push(errors, top_level_reject_msg("top-level `let mut` bindings are not allowed; move it into fn main", val))
        let err_before = Array::length(errors)
        let (vt, ns0, nc) = check_expr_capture(val, env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
        attach_unlocated_decl_name_marker(errors, err_before, name)
        let ns = match ann {
          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat("binding type mismatch for ", name), 0 - 1),
          None => ns0
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => vt
        }
        let env1 = env_bind(env, name, t)
        capture_statement_root_type(capture, statement_path, "SLetMut", vt)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetPat(pat, val) => {
        let (vt, ns, nc) = check_expr_capture(val, env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
        let new_env = match pat {
          PTuple(pats) => match vt {
            CtTuple(types) => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => if pi < Array::length(types) {
                    e = env_bind(e, name, Array::get(types, pi))
                  } else {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            },
            _ => {
              // A tuple pattern can only destructure a tuple value. `let (a, b) =
              // 5` was accepted and bound `a`/`b` to garbage. When the value
              // resolves to a concrete NON-tuple type (a scalar, array, option,
              // fn, struct, enum), this is a real error. Type vars / unknown /
              // named (generic) values stay tolerated.
              let concrete_non_tuple = match subst_apply(ns, vt) {
                CtInt => true,
                CtDouble => true,
                CtBool => true,
                CtString => true,
                CtChar => true,
                CtUnit => true,
                CtBytes => true,
                CtArray(_) => true,
                CtOption(_) => true,
                CtFn(_, _, _) => true,
                CtStruct(_) => true,
                CtEnum(_) => true,
                _ => false
              }
              if concrete_non_tuple {
                Array::push(errors, "tuple pattern cannot destructure a non-tuple value")
              } else {
                ()
              }
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            }
          },
          PBind(name) => env_bind(env, name, vt),
          PStruct(_, fields) => {
            let mut e = env
            let mut fi = 0
            while fi < Array::length(fields) {
              let (_, fpat) = Array::get(fields, fi)
              match fpat {
                PBind(name) => {
                  e = env_bind(e, name, CtUnknown)
                },
                _ => ()
              }
              fi = fi + 1
            }
            e
          },
          _ => env
        }
        capture_statement_root_type(capture, statement_path, "SLetPat", vt)
        (new_env, ns, nc)
      },
      SEnum(exported, name, params, variants, enum_derives) => {
        validate_derives(enum_derives, errors)
        duplicate_ctor_errors("enum", name, variants, errors)
        let param_len = Array::length(params)
        let param_var_ids = array_empty()
        let param_var_types = array_empty()
        let mut pi = 0
        while pi < param_len {
          let vid = c + pi
          Array::push(param_var_ids, vid)
          Array::push(param_var_types, CtVar(vid))
          pi = pi + 1
        }
        let ctor_result_type = if param_len == 0 {
          CtEnum(name)
        } else {
          CtNamed(name, param_var_types)
        }
        let ctor_bounds = array_empty()
        let resolved_variants = array_empty()
        // The local TDEnum uses this check's ids; published authority retains
        // the name-parameterized shape and rebinds it at each importer.
        let published_variants = array_empty()
        let enum_payload_tes = array_empty()
        let mut fvi = 0
        while fvi < Array::length(variants) {
          let (_, payloads) = Array::get(variants, fvi)
          let mut fpi = 0
          while fpi < Array::length(payloads) {
            Array::push(enum_payload_tes, Array::get(payloads, fpi))
            fpi = fpi + 1
          }
          fvi = fvi + 1
        }
        report_formal_applications_across(enum_payload_tes, params, String::concat(String::concat("enum `", name), "`"), errors)
        // #2125: this enum's slot in `defs` is already claimed (see
        // preclaim_local_type_defs), so a recursive occurrence of `name` in
        // its own payloads resolves to `CtEnum(name)` instead of falling
        // through to `CtNamed(name, [])`. The ctor-signature loop below
        // resolves the same payload text AFTER the registration and therefore
        // already saw the resolved form; the two disagreed.
        let self_def_index = own_typedef_slot(defs, type_def_binders, taken_type_def_slots, name, preclaim_from, TDEnum(name, params, array_empty()))
        Array::set(type_def_binders, self_def_index, param_var_ids)
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          let resolved_vtypes = array_empty()
          let named_vtypes = array_empty()
          let mut ti = 0
          while ti < Array::length(vtypes) {
            // #2125: an unknown name in a payload otherwise becomes a wildcard
            // `CtNamed` -- same hole as the annotation sites.
            report_unknown_type_names_deferred_validation(Array::get(vtypes, ti), defs, decl_report_shadow(params, array_empty(), deferred_names_for_decl(deferred_type_names, name)), env, array_empty(), String::concat(String::concat(String::concat("the payload of `", name), String::concat("::", vname)), "`"), errors)
            // #1512: `params` shadow `defs`, so the substitution below still
            // finds `CtNamed(<param>, [])` when an import bound that name.
            let named_vt = resolve_type_expr_shadowed(Array::get(vtypes, ti), defs, params)
            Array::push(named_vtypes, named_vt)
            Array::push(resolved_vtypes, subst_type_params(named_vt, params, param_var_types))
            ti = ti + 1
          }
          Array::push(resolved_variants, (vname, resolved_vtypes))
          Array::push(published_variants, (vname, named_vtypes))
          vi = vi + 1
        }
        Array::set(defs, self_def_index, TDEnum(name, params, resolved_variants))
        let mut env1 = env_bind(env, name, CtEnum(name))
        let mut ci2 = 0
        while ci2 < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, ci2)
          // #1078: a variant name already declared by a DIFFERENT enum in
          // this (possibly whole-program-merged) unit is a hard error.
          // The checker env is flat and name-keyed with last-registered-
          // wins shadowing, and qualified CONSTRUCTION is not supported
          // syntax -- so a bare `Mk(..)` in code written against the
          // earlier enum silently resolves to this one's signature,
          // producing an arity/argument-type mismatch pointing at the
          // WRONG declaration (or, same-signature, a silent wrong-tag
          // miscompile). Two unrelated packages only meet in one unit via
          // the merge/flatten lane, which is exactly how #1078 was hit
          // (@vibe/json's RpcMessage vs another merged package).
          match find_other_enum_declaring_variant(defs, local_defs_start, name, vname) {
            Some(other) => Array::push(errors, String::concat(String::concat(String::concat(String::concat("constructor name collision: ", vname), " is declared by both "), other), String::concat(" and ", String::concat(name, " in the same compiled unit; bare constructor references are ambiguous (qualified construction is not supported) -- rename one variant")))),
            None => ()
          }
          let ctor_ty = if Array::length(vtypes) == 0 {
            ctor_result_type
          } else {
            let resolved_args = array_empty()
            let mut ai = 0
            while ai < Array::length(vtypes) {
              // #1512: shadow `params` here too -- this resolves the SAME
              // variant payloads as the `TDEnum` above, independently, and the
              // `subst_type_params` right here needs the rigid formal to survive.
              let arg_ty = subst_type_params(resolve_type_expr_shadowed(Array::get(vtypes, ai), defs, params), params, param_var_types)
              Array::push(resolved_args, arg_ty)
              ai = ai + 1
            }
            CtFn(resolved_args, ctor_result_type, constructor_dependency_row(Array::length(resolved_args)))
          }
          let exported_ctor_ty = if param_len == 0 {
            ctor_ty
          } else {
            CtForAll(param_var_ids, ctor_bounds, ctor_ty)
          }
          env1 = env_bind(env1, vname, exported_ctor_ty)
          match ctor_ty {
            CtFn(_, ret, _) => {
              let exported_ret_ty = if param_len == 0 {
                ret
              } else {
                CtForAll(param_var_ids, ctor_bounds, ret)
              }
              env1 = bind_fn_return(env1, vname, exported_ret_ty)
            },
            _ => ()
          }
          ci2 = ci2 + 1
        }
        // #672: pre-bind the generated structural `E::equals` (every enum gets
        // one) so `==` dispatch call sites resolve at check time.
        let env_eq = env_bind(env1, String::concat(name, "::equals"), CtFn([
          ctor_result_type,
          ctor_result_type
        ], CtBool, None))
        // #638: pre-bind the signatures the enum-derive desugar will generate, so
        // `E::compare` / `E::to_string` / `E::default` resolve at check time (the
        // FS-compile path checks before the codegen-time desugar runs).
        let env_ord = if struct_derives_has(enum_derives, "Ord") {
          env_bind(env_eq, String::concat(name, "::compare"), CtFn([
            ctor_result_type,
            ctor_result_type
          ], CtInt, None))
        } else {
          env_eq
        }
        let env_show = if struct_derives_has(enum_derives, "Show") || struct_derives_has(enum_derives, "Hash") {
          let env_show_base = if struct_derives_has(enum_derives, "Show") {
            EnvTraitImpl("Show", ctor_result_type, env_ord)
          } else {
            env_ord
          }
          env_bind(env_show_base, String::concat(name, "::to_string"), CtFn([
            ctor_result_type
          ], CtString, None))
        } else {
          env_ord
        }
        // #694: `derive(Hash)` generates `E::hash_key(Self) -> String` (the
        // structural Map key), so pre-bind its signature at check time too, AND
        // register `impl Hash for E` so a `[K: Hash]` bound is satisfied by the
        // derived enum.
        let env_hash = if struct_derives_has(enum_derives, "Hash") {
          let env_h = EnvTraitImpl("Hash", ctor_result_type, env_show)
          env_bind(env_h, String::concat(name, "::hash_key"), CtFn([
            ctor_result_type
          ], CtString, None))
        } else {
          env_show
        }
        // #1847: like Hash above, ALSO register `impl Default for E` so a
        // `[T: Default]` bound is satisfied by the derived enum (previously
        // only the `E::default` signature was bound, so the bound check
        // reported `no impl Default for E`).
        let env_default = if struct_derives_has(enum_derives, "Default") {
          let env_d = EnvTraitImpl("Default", ctor_result_type, env_hash)
          env_bind(env_d, String::concat(name, "::default"), CtFn(array_empty(), ctor_result_type, None))
        } else {
          env_hash
        }
        (EnvTypeDefs([TDEnum(name, params, published_variants)], if exported {
          [name]
        } else {
          array_empty()
        }, env_default), s, c + param_len)
      },
      SSuberror(_, name, variants) => {
        // #786: a `suberror Name(payload...)` declaration is structurally a
        // single-typed enum whose constructors produce a throwable value. It
        // was parsed (SSuberror) but never bound, so `KeyInvalid("x")` was an
        // "unknown name". Register it exactly like a no-type-param enum: record
        // a TDEnum def (so `match` + type resolution work) and bind each
        // constructor name as `CtFn(payload, CtEnum(name))`. `throw` accepts the
        // resulting value (its param is CtUnknown, see builtins_misc).
        duplicate_ctor_errors("suberror", name, variants, errors)
        let ctor_result_type = CtEnum(name)
        let resolved_variants = array_empty()
        let mut vi = 0
        // #2125: see the SEnum arm.
        let self_suberr_index = own_typedef_slot(defs, type_def_binders, taken_type_def_slots, name, preclaim_from, TDEnum(name, array_empty(), array_empty()))
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          let resolved_vtypes = array_empty()
          let mut ti = 0
          while ti < Array::length(vtypes) {
            let payload_type = Array::get(vtypes, ti)
            Array::push(resolved_vtypes, resolve_type_expr(payload_type, defs))
            ti = ti + 1
          }
          Array::push(resolved_variants, (vname, resolved_vtypes))
          vi = vi + 1
        }
        Array::set(defs, self_suberr_index, TDEnum(name, array_empty(), resolved_variants))
        let mut env1 = env_bind(env, name, CtEnum(name))
        let mut ci2 = 0
        while ci2 < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, ci2)
          let ctor_ty = if Array::length(vtypes) == 0 {
            ctor_result_type
          } else {
            let resolved_args = array_empty()
            let mut ai = 0
            while ai < Array::length(vtypes) {
              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))
              ai = ai + 1
            }
            CtFn(resolved_args, ctor_result_type, constructor_dependency_row(Array::length(resolved_args)))
          }
          env1 = env_bind(env1, vname, ctor_ty)
          match ctor_ty {
            CtFn(_, ret, _) => {
              env1 = bind_fn_return(env1, vname, ret)
            },
            _ => ()
          }
          ci2 = ci2 + 1
        }
        let env_eq = env_bind(env1, String::concat(name, "::equals"), CtFn([
          ctor_result_type,
          ctor_result_type
        ], CtBool, None))
        (env_eq, s, c)
      },
      SStruct(exported, name, field_defs, derives, mut_fields, tparams) => {
        validate_derives(derives, errors)
        let resolved_fields = array_empty()
        let field_tes = array_empty()
        // #2125: this struct's slot is already claimed before its own field
        // types are resolved, so a recursive occurrence resolves to
        // `CtStruct(name)`.
        let self_struct_index = own_typedef_slot(defs, type_def_binders, taken_type_def_slots, name, preclaim_from, TDStruct(name, array_empty(), mut_fields, tparams))
        let mut fi = 0
        while fi < Array::length(field_defs) {
          let (fname, ftype_expr) = Array::get(field_defs, fi)
          // #2125: an unknown name in a field type otherwise becomes a
          // wildcard `CtNamed` -- same hole as the annotation sites. A
          // synthesized `<Trait>Dict` witness struct spells `Self` and the
          // trait's erased params verbatim (whole-program lanes re-check the
          // desugar's output); those are shadowed under the provenance
          // `collect_trait_dict_erasures` establishes.
          let dict_erased = trait_dict_erasure_for(trait_dict_erasures, name, fname)
          let report_shadow = decl_report_shadow(tparams, dict_erased, deferred_names_for_decl(deferred_type_names, name))
          report_unknown_type_names_deferred_validation(ftype_expr, defs, report_shadow, env, array_empty(), struct_field_decl_label(name, fname), errors)
          Array::push(field_tes, ftype_expr)
          // #1512: `tparams` shadow `defs` -- the #829 comment below assumes a
          // param name resolves to a rigid `CtNamed(param, [])` because no
          // typedef/builtin claims it, which an import alias otherwise breaks.
          let ftype = resolve_type_expr_shadowed(ftype_expr, defs, tparams)
          Array::push(resolved_fields, (fname, ftype))
          fi = fi + 1
        }
        // Mixed-kind is a property of the whole struct (`raw: F` next to
        // `inner: F[Int]`), not of one field TypeExpr.
        report_formal_applications_across(field_tes, tparams, String::concat(String::concat("struct `", name), "`"), errors)
        // #829: record the declared type params — a param name resolves above
        // to a rigid `CtNamed(param, [])` (no such typedef/builtin), which is
        // exactly what the checker's literal instantiation substitutes.
        Array::set(defs, self_struct_index, TDStruct(name, resolved_fields, mut_fields, tparams))
        let field_types = array_empty()
        let mut fj = 0
        while fj < Array::length(resolved_fields) {
          let (_, fty) = Array::get(resolved_fields, fj)
          Array::push(field_types, fty)
          fj = fj + 1
        }
        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))
        // #638: pre-bind the signatures of the structural functions that the
        // derive desugar will generate, so `Type::compare` / `Type::to_string`
        // resolve at check time (the FS-compile path checks before the
        // codegen-time desugar runs).
        let env2 = if struct_derives_has(derives, "Ord") {
          env_bind(env1, String::concat(name, "::compare"), CtFn([
            CtStruct(name),
            CtStruct(name)
          ], CtInt, None))
        } else {
          env1
        }
        let env3 = if struct_derives_has(derives, "Show") || struct_derives_has(derives, "Hash") {
          let env_show_base = if struct_derives_has(derives, "Show") {
            EnvTraitImpl("Show", CtStruct(name), env2)
          } else {
            env2
          }
          env_bind(env_show_base, String::concat(name, "::to_string"), CtFn([
            CtStruct(name)
          ], CtString, None))
        } else {
          env2
        }
        // #672: every struct gets a generated structural `T::equals` (the `==`
        // dispatch relies on it), so pre-bind its signature unconditionally.
        let env4 = env_bind(env3, String::concat(name, "::equals"), CtFn([
          CtStruct(name),
          CtStruct(name)
        ], CtBool, None))
        // #694: `derive(Hash)` generates `T::hash_key(Self) -> String` (the
        // structural Map key), so pre-bind its signature at check time too, AND
        // register `impl Hash for T` so a `[K: Hash]` bound (e.g. `get_by`) is
        // satisfied by the derived type.
        let env_hash = if struct_derives_has(derives, "Hash") {
          let env_h = EnvTraitImpl("Hash", CtStruct(name), env4)
          env_bind(env_h, String::concat(name, "::hash_key"), CtFn([
            CtStruct(name)
          ], CtString, None))
        } else {
          env4
        }
        // #638: `derive(Default)` generates `T::default() -> T` (a zero-arg fn,
        // so the CtFn parameter list is empty). #1847: like Hash above, ALSO
        // register `impl Default for T` so a `[T: Default]` bound is satisfied
        // by the derived type.
        let env5 = if struct_derives_has(derives, "Default") {
          let env_d = EnvTraitImpl("Default", CtStruct(name), env_hash)
          env_bind(env_d, String::concat(name, "::default"), CtFn(array_empty(), CtStruct(name), None))
        } else {
          env_hash
        }
        (EnvTypeDefs([TDStruct(name, resolved_fields, mut_fields, tparams)], if exported {
          [name]
        } else {
          array_empty()
        }, bind_fn_return(env5, name, CtStruct(name))), s, c)
      },
      STypeAlias(exported, name, params, te) => {
        // #2290: map-key and builtin-arity validation is deferred to
        // check_completed_decl_map_keys. At this point a later alias is not
        // in `defs`, so judging ownership here made valid programs depend on
        // declaration order. Preflight before resolving too: dependency-first
        // alias declarations can already carry a completed exponential DAG at
        // this initial registration point, before the completion refresh runs.
        let t = if type_expr_expansion_node_count(te, defs, params, array_empty(), alias_expansion_node_limit()) > alias_expansion_node_limit() {
          report_alias_expansion_limit(name, errors)
          CtNamed(name, array_empty())
        } else {
          resolve_type_expr_shadowed(te, defs, params)
        }
        // Record the alias (with its formal params) so an applied use
        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.
        Array::push(defs, TDAlias(name, params, t))
        Array::push(type_def_binders, array_empty())
        (EnvTypeDefs([TDAlias(name, params, t)], if exported {
          [name]
        } else {
          array_empty()
        }, env_bind(env, name, t)), s, c)
      },
      SExternLet(name, te) => {
        report_map_key_types(te, defs, array_empty(), String::concat(String::concat("extern declaration `", name), "`"), errors)
        let t = resolve_type_expr(te, defs)
        let env1 = env_bind(env, name, t)
        (bind_annotation_return(env1, name, Some(te), defs), s, c)
      },
      STest(_, body) => {
        let (vt, ns, nc) = check_expr_capture(body, env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
        capture_statement_root_type(capture, statement_path, "STest", vt)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (vt, ns, nc) = check_expr_capture(body, env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
        capture_statement_root_type(capture, statement_path, "SBench", vt)
        (env, ns, nc)
      },
      SExpr(expr) => {
        // ADR-0091 Phase 1: canonical `#zero_alloc` and legacy `@zero_alloc`
        // normalize here as one top-level expression marker. It is an attribute
        // marker for the following fn declaration, consumed by the
        // codegen-stage allocation check (common_analysis.vibe's
        // zero_alloc_check) -- skip both the ADR-0069 reject below and name
        // resolution (the `@`-spelled ident resolves nowhere).
        let is_zero_alloc_marker = match expr {
          EIdent(id_name, _) => String::starts_with(id_name, "@zero_alloc"),
          _ => false
        }
        if is_zero_alloc_marker {
          (env, s, c)
        } else {
          // ADR-0069 Phase 1: top level is declarations only. A top-level
          // expression statement was silently DROPPED by the linear backend;
          // reject it (still type-check the expression for error recovery).
          Array::push(errors, top_level_reject_msg("top-level expressions are not allowed; move it into fn main", expr))
          let (vt, ns, nc) = check_expr_capture(expr, env, defs, s, c, errors, tytab, role_lane_capture, "Primary")
          capture_statement_root_type(capture, statement_path, "SExpr", vt)
          (env, ns, nc)
        }
      },
      SModule(_, _, body) => {
        // `statement_path` is None in ordinary checking, so nested modules
        // recurse without allocating retained path state.
        let (_, nested_s, nested_c) = check_stmts_with_binders(body, 0, env, defs, type_def_binders, local_defs_start, s, c, errors, tytab, statement_path, capture, role_lane_capture, false, false)
        // Preserve the historical checker flow when this opt-in observation is
        // absent. The root observation alone needs nested substitutions to
        // canonicalize its nested raw types; module bindings remain lexical.
        if statement_capture_is_root(capture) {
          (env, nested_s, nested_c)
        } else {
          (env, s, c)
        }
      },
      SImport(_, names) => if imports_already_projected {
        (env, s, c)
      } else {
        (bind_stmt_imports(env, names), s, c)
      },
      SReExport(_, names) => if imports_already_projected {
        (env, s, c)
      } else {
        (bind_stmt_imports(env, names), s, c)
      },
      SReExportSourceBoundary(_, surface_only_names) => {
        let blocked = env_with_reexport_surface_blockers(env, surface_only_names)
        (hoist_merged_source_values(stmts, idx + 1, blocked, defs), s, c)
      },
      SAliasDecl(_, _) => (env, s, c)
      ,
      STrait(_, name, supers, methods, method_gens, tparams) => {
        let mut mi = 0
        while mi < Array::length(methods) {
          let (mname, mparams, mret) = Array::get(methods, mi)
          let shadow = Array::slice(["Self"], 0, 1)
          let mut ti = 0
          while ti < Array::length(tparams) {
            Array::push(shadow, Array::get(tparams, ti))
            ti = ti + 1
          }
          let mut gi = 0
          while gi < Array::length(method_gens) {
            let (gname, gtparams, _) = Array::get(method_gens, gi)
            if gname == mname {
              let mut gj = 0
              while gj < Array::length(gtparams) {
                Array::push(shadow, Array::get(gtparams, gj))
                gj = gj + 1
              }
            } else {
              ()
            }
            gi = gi + 1
          }
          let where_label = fapp_decl_label(name, mname)
          let mut pi = 0
          while pi < Array::length(mparams) {
            report_map_key_types(Array::get(mparams, pi), defs, shadow, where_label, errors)
            pi = pi + 1
          }
          report_map_key_types(mret, defs, shadow, where_label, errors)
          mi = mi + 1
        }
        let is_open = false
        (EnvTraitDef(name, supers, is_open, methods, env, tparams, method_gens), s, c)
      },
      SImpl(tparams, tbounds, trait_name, target_expr) => {
        validate_trait_reference(env, trait_name, "impl head", errors)
        let type_name = match target_expr {
          TyName(name) => name,
          TyApp(name, _) => name,
          _ => ""
        }
        // ADR-0068: `Send` is compiler-judged (structural); user impls
        // would let a non-sendable type cross task/channel boundaries.
        if trait_ref_name(trait_name) == "Send" {
          Array::push(errors, "`Send` is a compiler-judged structural marker and cannot be implemented; remove `impl Send`")
        } else {
          ()
        }
        let implicit_target_params = match target_expr {
          TyName(name) => match impl_target_declared_arity(defs, name) {
            Some(arity) => arity > 0 && arity == Array::length(tparams),
            None => false
          },
          _ => false
        }
        let mut tpi = 0
        while tpi < Array::length(tparams) {
          let tparam = Array::get(tparams, tpi)
          if !implicit_target_params && !impl_target_mentions(target_expr, tparam) {
            Array::push(errors, String::concat("impl type parameter `", String::concat(tparam, "` is not used in its target; remove it, or use it in the target type")))
          } else {
            ()
          }
          tpi = tpi + 1
        }
        let target_arity = match target_expr {
          TyApp(_, args) => Array::length(args),
          _ => Array::length(tparams)
        }
        if target_arity > 0 {
          match impl_target_declared_arity(defs, type_name) {
            Some(want) => if want != target_arity {
              Array::push(errors, String::concat("type `", String::concat(type_name, String::concat("` expects ", String::concat(__to_string(want), String::concat(" type argument(s), got ", String::concat(__to_string(target_arity), " in impl target")))))))
            } else {
              ()
            },
            None => ()
          }
        } else {
          ()
        }
        let target = resolve_type_expr_shadowed(target_expr, defs, tparams)
        match overlapping_impl_target_for(env, trait_name, tparams, target) {
          Some(existing_target) => Array::push(errors, String::concat("overlapping impls for `", String::concat(trait_reference_display(trait_name), String::concat("`: existing target `", String::concat(type_to_string(existing_target), String::concat("` overlaps new target `", String::concat(type_to_string(target), "`"))))))),
          None => ()
        }
        // A generic impl `impl [T] Trait for C[T]` (type parameters present) is
        // registered as `EnvTraitImplGen` so trait resolution can match the
        // family `C[..]` against a concrete `C[K]`. A plain impl stays a
        // nominal `EnvTraitImpl`. The complete target is retained so concrete
        // specializations and reordered generic parameters cannot widen.
        let new_env = if Array::length(tparams) > 0 {
          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)
        } else {
          EnvTraitImpl(trait_name, target, env)
        }
        (new_env, s, c)
      },
      SEffectDef(exported, ename, eparams, ops) => {
        // #813: register the effect's operation signatures (resolved to
        // checker Types) so perform arguments, handler arm names/arity/
        // payload binds, and resume values can be validated. #1340
        // (ADR-0071): generic effects register too — a declared type param
        // has no typedef/builtin, so resolve_type_expr turns it into a rigid
        // `CtNamed(param, [])` inside the signatures (the same convention
        // TDStruct uses, #829), and the perform/handle consumers substitute
        // those names with fresh inference vars per use site.
        let resolved_ops = array_empty()
        let mut oi = 0
        while oi < Array::length(ops) {
          let (opname, opparams, opret) = Array::get(ops, oi)
          let rp = array_empty()
          let mut pi = 0
          while pi < Array::length(opparams) {
            // #1512: `eparams` shadow `defs` -- the rigid-`CtNamed` convention
            // the comment above relies on is only true while no import alias
            // has claimed the formal's name.
            let op_param = Array::get(opparams, pi)
            Array::push(rp, resolve_type_expr_shadowed(op_param, defs, eparams))
            pi = pi + 1
          }
          Array::push(resolved_ops, (opname, rp, resolve_type_expr_shadowed(opret, defs, eparams)))
          oi = oi + 1
        }
        Array::push(defs, TDEffect(ename, resolved_ops, eparams))
        Array::push(type_def_binders, array_empty())
        (EnvTypeDefs([TDEffect(ename, resolved_ops, eparams)], if exported {
          [ename]
        } else {
          array_empty()
        }, env), s, c)
      },
      SEffectSet(exported, esname, esmembers) => {
        // ADR-0071 (#755): the ADR's Decision section calls out two specific
        // invalid-definition cases by name -- a cycle through member
        // references, and a qualified name colliding with an operation of
        // the same effect (shared member namespace) -- rejected here with
        // their own specific diagnostics via the resolver-core helpers
        // above (using the whole-list pre-pass tables, order-independent).
        // A definition that is neither is now ACCEPTED (step 3): its
        // members are used to expand any `with EffectsetName` row item
        // that references it, via es_expand_stmts_effect_rows in
        // collect_async_effect_errors below -- an accepted effectset
        // genuinely has capability now, unlike step 2's placeholder
        // "not yet supported" rejection for every definition regardless of
        // validity. What full resolution does NOT yet cover: handler-level
        // operation-level discharge (step 4), contract/WIT operation-level
        // surface (step 5), and expanding a row inside a function
        // PARAMETER's own type (the #885 callback-overlay case) -- those
        // remain unimplemented, not silently wrong, since nothing consumes
        // an effectset there yet.
        if es_qualified_collision(ed_names, ed_ops_list, esname) {
          Array::push(errors, String::concat("effectset '", String::concat(esname, "' collides with an operation of the same name declared on its effect (operations and effectsets share the effect-row member namespace) -- rename the effectset or the operation")))
        } else {
          match es_detect_cycle(es_names, es_members_list, esname, array_empty()) {
            Some(msg) => Array::push(errors, msg),
            None => ()
          }
        }
        (EnvTypeDefs([TDEffectSet(esname, esmembers)], if exported {
          [esname]
        } else {
          array_empty()
        }, env), s, c)
      },
      _ => (env, s, c)
    }
    match capture {
      Some(StatementTypedOccurrences(entries)) => match stmt {
        SModule(_, _, _) => (),
        _ => match (capture_start, statement_path) {
          (Some(start), Some(path)) => capture_statement_rows(entries, tytab, start, path),
          _ => ()
        }
      },
      _ => ()
    }
    typed_occurrence_capture_end_statement(role_lane_capture)
    cur_env = new_env
    cur_s = s1
    cur_c = c1
    // #2290: the stable partition puts every type declaration first. Validate
    // alias bodies at that phase boundary: `defs` is now complete for this
    // statement list, while no value/signature use-site diagnostic has run
    // yet. A type-only list validates after its final declaration.
    if stmt_is_type_decl(stmt) && (idx + 1 >= Array::length(stmts) || !stmt_is_type_decl(Array::get(stmts, idx + 1))) {
      local_defs_end = Array::length(defs)
      refresh_completed_alias_defs(stmts, defs, preclaim_from, local_defs_end, errors)
      refresh_completed_payload_defs(stmts, defs, type_def_binders, preclaim_from, local_defs_end)
      cur_env = refresh_completed_suberror_env(stmts, cur_env, defs, preclaim_from, local_defs_end)
      cur_env = refresh_completed_type_env(cur_env, defs, preclaim_from, local_defs_end, array_empty(), local_defs_end - preclaim_from)
    } else {
      match stmt {
        // A nested module shares `defs` with this statement list. Its type
        // declarations can settle aliases and payloads in any already-checked
        // sibling scope, so refresh and validate the combined visible range.
        SModule(_, _, _) => {
          let visible_types = array_empty()
          collect_visible_type_stmts(stmts, idx + 1, visible_types)
          let visible_defs_end = Array::length(defs)
          if visible_defs_end > defs_before_stmt {
            nested_defs_extended = true
            refresh_completed_alias_defs(visible_types, defs, preclaim_from, visible_defs_end, errors)
            refresh_completed_payload_defs(visible_types, defs, type_def_binders, preclaim_from, visible_defs_end)
            cur_env = refresh_completed_suberror_env(stmts, cur_env, defs, preclaim_from, local_defs_end)
            cur_env = refresh_completed_type_env(cur_env, defs, preclaim_from, local_defs_end, array_empty(), local_defs_end - preclaim_from)
          } else {
            ()
          }
        },
        _ => ()
      }
    }
    idx = idx + 1
  }
  if validate_completed_decls {
    let visible_types = array_empty()
    collect_visible_type_stmts(stmts, Array::length(stmts), visible_types)
    let visible_defs_end = Array::length(defs)
    let completed_decl_errors = array_empty()
    refresh_completed_alias_defs(visible_types, defs, preclaim_from, visible_defs_end, completed_decl_errors)
    refresh_completed_payload_defs(visible_types, defs, type_def_binders, preclaim_from, visible_defs_end)
    cur_env = refresh_completed_suberror_env(stmts, cur_env, defs, preclaim_from, local_defs_end)
    cur_env = refresh_completed_type_env(cur_env, defs, preclaim_from, local_defs_end, array_empty(), local_defs_end - preclaim_from)
    // Map-key validation eagerly resolves alias arguments. Once alias
    // expansion has already been rejected, replaying those same expressions
    // here can perform the forbidden allocation while only collecting a
    // secondary diagnostic. Preserve the actionable expansion error and stop
    // this completed-declaration diagnostic lane from re-expanding it.
    if errors_contain_alias_expansion_limit(completed_decl_errors) {
      ()
    } else {
      check_completed_decl_map_keys(visible_types, defs, completed_decl_errors)
    }
    if nested_defs_extended {
      // The first pass is required to discover the complete shared definition
      // graph. Re-run the root list against a copy of that graph so every value
      // statement -- outer or nested -- sees completed aliases from its first
      // lookup, and so later bindings inherit rebuilt rather than wildcard
      // types. The copied tables keep this verification pass from appending
      // duplicate declarations to the authoritative result.
      let recheck_defs = Array::slice(defs, 0, Array::length(defs))
      let recheck_binders = Array::slice(type_def_binders, 0, Array::length(type_def_binders))
      let recheck_errors = array_empty()
      let recheck_c = next_type_def_binder_id(recheck_binders, c)
      restore_checker_observation(observation_checkpoint, capture, role_lane_capture, tytab)
      let (rechecked_env, rechecked_s, rechecked_c) = check_stmts_with_binders(raw_stmts, i, env, recheck_defs, recheck_binders, local_defs_start, SubstEmpty, recheck_c, recheck_errors, tytab, statement_parent_path, capture, role_lane_capture, imports_already_projected, false)
      // First-pass statement diagnostics may have judged a compiler-owned
      // spelling before a nested declaration claimed it. Replace that whole
      // lane with the completed declaration diagnostics plus the completed
      // second-pass statement diagnostics; incoming caller diagnostics stay
      // ahead of this check's insertion boundary.
      Array::truncate(errors, completed_decl_error_insert_at)
      push_unique_error_strings(completed_decl_errors, errors)
      push_unique_error_strings(recheck_errors, errors)
      cur_env = rechecked_env
      cur_s = rechecked_s
      cur_c = rechecked_c
    } else {
      insert_unique_error_strings(completed_decl_errors, errors, completed_decl_error_insert_at)
    }
  } else {
    ()
  }
  (cur_env, cur_s, cur_c)
}

/// #1503: `no impl `Eq` for `Array[Int]`` is flatly false when the program
/// declares that impl three lines above -- what actually happened is that the
/// impl was found and then refused by the marker-trait gate (a marker trait has
/// no methods, so it dispatches to the builtin `==` / `<`, and those are
/// REFERENCE equality on `Array` / `Bytes`: a bare `[1, 2] == [1, 2]` is
/// `false`). Say so, and name the edit that fixes it.
///
/// Returns "" when no impl for this trait mentions the type's constructor, i.e.
/// when "no impl" is the whole truth.
fn unsatisfied_bound_hint(env: TypeEnv, trait_name: String, resolved: Type) -> String {
  if trait_impl_declared_for_ctor(env, trait_name, resolved) && trait_is_marker(env, trait_name) {
    let display = trait_reference_display(trait_name)
    String::concat(": an `impl ", String::concat(display, String::concat(" for ", String::concat(type_constructor_name(resolved), String::concat("` IS declared, but `", String::concat(display, String::concat("` is a marker trait (declared with no methods) so it dispatches to the builtin `==` / `<`, and those are REFERENCE equality on `Array` / `Bytes` -- honouring the impl would make the comparison silently wrong. Give `", String::concat(display, "` at least one method so the impl dispatches through the witness dictionary, or drop the bound"))))))))
  } else {
    ""
  }
}

/// #641 PR-2: enforce trait bounds. After inference, every bounded type variable
/// recorded in the final substitution that resolved to a CONCRETE type must
/// satisfy its bounds. Unresolved (still-polymorphic) vars are inherited by the
/// caller, not violated, so they are skipped. One `no impl `Trait` for `Type``
/// error per unsatisfied bound (matches fixtures/err_type_trait_*bound* messages).
/// Import projection supplies the selected trait authority and implementations,
/// so this is enforced identically for standalone and FS/import checking.
fn push_error_strings(msgs: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(msgs) {
    Array::push(errors, Array::get(msgs, i))
    i = i + 1
  }
}

fn check_program_bounds(env: TypeEnv, s: Subst, defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let pairs = collect_subst_bounds_pairs(s)
  let n = Array::length(pairs)
  let mut i = 0
  while i < n {
    let (vid, bounds) = Array::get(pairs, i)
    let resolved = subst_apply(s, CtVar(vid))
    match resolved {
      CtVar(_) => (),
      CtUnknown => (),
      _ => {
        let bn = Array::length(bounds)
        let mut bi = 0
        while bi < bn {
          let b = Array::get(bounds, bi)
          let resolved_bound = resolve_trait_bound_self_reference(b, resolved, s, defs)
          let sat = if resolved_bound == "" {
            true
          } else if resolved_bound == "Send" {
            // ADR-0068: `Send` is judged structurally from the type
            // definitions (type_send_ok), not from user impls.
            type_send_ok(env, s, defs, resolved)
          } else {
            type_implements_trait(env, s, resolved, resolved_bound)
          }
          if resolved_bound != "" && not(sat) {
            Array::push(errors, String::concat("no impl `", String::concat(trait_reference_display(resolved_bound), String::concat("` for `", String::concat(type_to_string(resolved), String::concat("`", unsatisfied_bound_hint(env, resolved_bound, resolved)))))))
          }
          bi = bi + 1
        }
      }
    }
    i = i + 1
  }
}

/// #1340 (ADR-0071): validate a generic-instantiation row item
/// (`State[Int]`) against the module's effect declarations. The base must
/// not be an effectset, and when it names a DECLARED effect it must have
/// exactly one type parameter matched by exactly one bracket argument
/// (multi-param instantiations are rejected at parse; empty brackets are
/// rejected here). Unknown bases are skipped — imported effects are
/// invisible here, the same permissive stance the containment checker
/// takes.
fn geff_arg_kind_arity(name: String, ctor_names: Array[String], ctor_arities: Array[Int], formal_keys: Array[String]) -> Int {
  match compiler_owned_type_arity(name) {
    Some(arity) => arity,
    None => {
      let mut i = 0
      let mut found = 0 - 1
      while i < Array::length(ctor_names) {
        if Array::get(ctor_names, i) == name {
          found = Array::get(ctor_arities, i)
        } else {
          ()
        }
        i = i + 1
      }
      if found >= 0 {
        found
      } else {
        let mut j = 0
        let mut farity = 0 - 1
        while j < Array::length(formal_keys) {
          if type_param_name(Array::get(formal_keys, j)) == name {
            farity = type_param_arity(Array::get(formal_keys, j))
          } else {
            ()
          }
          j = j + 1
        }
        if farity >= 0 {
          farity
        } else {
          0
        }
      }
    }
  }
}

fn geff_row_targ_errors_into(row: Option[String], ed_names: Array[String], ed_tpcounts: Array[Int], ed_tparities: Array[Int], es_names: Array[String], ctor_names: Array[String], ctor_arities: Array[Int], formal_keys: Array[String], errors: Array[String]) -> Unit {
  match row {
    None => (),
    Some(r) => {
      let raw = String::split(r, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = String::trim(Array::get(raw, i))
        let bi = String::index_of(label, "[")
        if bi > 0 {
          let base = label[0: bi]
          let inner = String::trim(label[bi + 1: String::length(label) - 1])
          let mut is_es = false
          let mut esi = 0
          while esi < Array::length(es_names) {
            if Array::get(es_names, esi) == base {
              is_es = true
            } else {
              ()
            }
            esi = esi + 1
          }
          if is_es {
            Array::push(errors, String::concat("effect row item `", String::concat(label, String::concat("`: `", String::concat(base, "` is an effectset — effectset instantiation in a row is not supported yet (ADR-0071)")))))
          } else if String::length(inner) == 0 {
            Array::push(errors, String::concat("effect row item `", String::concat(label, "` needs a type argument between the brackets")))
          } else {
            let mut edi = 0
            let mut tpc = 0 - 1
            let mut expected_kind = 0
            while edi < Array::length(ed_names) {
              if Array::get(ed_names, edi) == base {
                tpc = Array::get(ed_tpcounts, edi)
                expected_kind = Array::get(ed_tparities, edi)
              } else {
                ()
              }
              edi = edi + 1
            }
            if tpc == 0 {
              Array::push(errors, String::concat("effect row item `", String::concat(label, String::concat("`: effect ", String::concat(base, " declares no type parameters")))))
            } else if tpc > 1 {
              Array::push(errors, String::concat("effect row item `", String::concat(label, String::concat("`: effect ", String::concat(base, String::concat(" declares ", String::concat(__to_string(tpc), " type parameters; a row item supports exactly one type argument for now")))))))
            } else if expected_kind > 0 {
              let actual_kind = geff_arg_kind_arity(inner, ctor_names, ctor_arities, formal_keys)
              if actual_kind != expected_kind {
                Array::push(errors, String::concat("effect row item `", String::concat(label, String::concat("`: effect ", String::concat(base, String::concat(" expects a constructor with ", String::concat(__to_string(expected_kind), String::concat(" argument(s), but `", String::concat(inner, String::concat("` has ", String::concat(__to_string(actual_kind), " -- pass a bare constructor with the required arity")))))))))))
              } else {
                ()
              }
            } else {
              ()
            }
          }
        } else {
          ()
        }
        i = i + 1
      }
    }
  }
}

/// #1340: walk the same row slots es_expand_stmts_effect_rows covers — a
/// top-level binding's declared TyFn rows (including nested function types
/// in parameter/return position) and an EFn value's inline row + parameter
/// annotations. Nested closure literals inside bodies are not walked (same
/// coverage boundary as the effectset expansion pass).
fn geff_check_texpr_rows(te: TypeExpr, ed_names: Array[String], ed_tpcounts: Array[Int], ed_tparities: Array[Int], es_names: Array[String], ctor_names: Array[String], ctor_arities: Array[Int], formal_keys: Array[String], errors: Array[String]) -> Unit {
  match te {
    TyFn(params, ret, eff) => {
      geff_row_targ_errors_into(eff, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors)
      let mut i = 0
      while i < Array::length(params) {
        geff_check_texpr_rows(Array::get(params, i), ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors)
        i = i + 1
      }
      geff_check_texpr_rows(ret, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors)
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        geff_check_texpr_rows(Array::get(args, i), ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        geff_check_texpr_rows(Array::get(elems, i), ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn geff_check_opt_texpr_rows(te: Option[TypeExpr], ed_names: Array[String], ed_tpcounts: Array[Int], ed_tparities: Array[Int], es_names: Array[String], ctor_names: Array[String], ctor_arities: Array[Int], formal_keys: Array[String], errors: Array[String]) -> Unit {
  match te {
    Some(t) => geff_check_texpr_rows(t, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formal_keys, errors),
    None => ()
  }
}

fn geff_expr_formals(e: Expr) -> Array[String] {
  match e {
    EFn(tparams, _, _, _, _, _) => tparams,
    _ => array_empty()
  }
}

fn geff_check_value_rows(e: Expr, ed_names: Array[String], ed_tpcounts: Array[Int], ed_tparities: Array[Int], es_names: Array[String], ctor_names: Array[String], ctor_arities: Array[Int], errors: Array[String]) -> Unit {
  match e {
    EFn(tparams, _, params, ret, eff, _) => {
      geff_row_targ_errors_into(eff, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, tparams, errors)
      let mut i = 0
      while i < Array::length(params) {
        let (_, pty) = Array::get(params, i)
        geff_check_opt_texpr_rows(pty, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, tparams, errors)
        i = i + 1
      }
      geff_check_opt_texpr_rows(ret, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, tparams, errors)
    },
    _ => ()
  }
}

fn geff_validate_row_targs(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let ed_names = array_empty()
  let ed_tpcounts = array_empty()
  let ed_tparities = array_empty()
  let es_names = array_empty()
  let ctor_names = array_empty()
  let ctor_arities = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, ename, eparams, _) => {
        Array::push(ed_names, ename)
        Array::push(ed_tpcounts, Array::length(eparams))
        let first_arity = if Array::length(eparams) > 0 {
          type_param_arity(Array::get(eparams, 0))
        } else {
          0
        }
        Array::push(ed_tparities, first_arity)
      },
      SEffectSet(_, esname, _) => Array::push(es_names, esname),
      SStruct(_, sname, _, _, _, tparams) => {
        Array::push(ctor_names, sname)
        Array::push(ctor_arities, Array::length(tparams))
      },
      SEnum(_, ename, tparams, _, _) => {
        Array::push(ctor_names, ename)
        Array::push(ctor_arities, Array::length(tparams))
      },
      STypeAlias(_, aname, tparams, _) => {
        Array::push(ctor_names, aname)
        Array::push(ctor_arities, Array::length(tparams))
      },
      _ => ()
    }
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(stmts) {
    match Array::get(stmts, j) {
      SLet(_, _, _, ty, body) => {
        let formals = geff_expr_formals(body)
        geff_check_opt_texpr_rows(ty, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formals, errors)
        geff_check_value_rows(body, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, errors)
      },
      SLetMut(_, ty, body) => {
        let formals = geff_expr_formals(body)
        geff_check_opt_texpr_rows(ty, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, formals, errors)
        geff_check_value_rows(body, ed_names, ed_tpcounts, ed_tparities, es_names, ctor_names, ctor_arities, errors)
      },
      _ => ()
    }
    j = j + 1
  }
}

/// Canonicalize only the imported `StdinStream as S` type head before the
/// ordinary checker runs. This makes `S::next(..)` the same exact direct-call
/// AST as `StdinStream::next(..)`, so existing Async authority checks apply;
/// value imports remain distinct and are rejected at the merged compile
/// boundary rather than becoming first-class provider operations.
fn canonicalize_stdin_provider_type_import_heads_reporting_change(stmts: Array[Stmt]) -> Bool {
  let aliases: Array[(String, String)] = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let original = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => if original == "StdinStream" {
              Array::push(aliases, (alias, original))
            } else {
              ()
            },
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let mut changed = false
  if Array::length(aliases) > 0 {
    let mut k = 0
    while k < Array::length(stmts) {
      match Array::get(stmts, k) {
        SImport(_, _) => (),
        _ => {
          Array::set(stmts, k, rewrite_import_alias_stmt(Array::get(stmts, k), aliases))
          changed = true
        }
      }
      k = k + 1
    }
  } else {
    ()
  }
  changed
}

fn canonicalize_stdin_provider_type_import_heads(stmts: Array[Stmt]) -> Unit {
  let _changed = canonicalize_stdin_provider_type_import_heads_reporting_change(stmts)
  ()
}

/// Reject stdin provider operation values before inference can replace the
/// actionable safety diagnostic with a secondary type mismatch. This syntactic
/// gate intentionally precedes artifact production and generic effect flow.
fn collect_stdin_provider_direct_call_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let direct_errors = check_stdin_provider_direct_calls_stmts(stmts)
  let mut i = 0
  while i < Array::length(direct_errors) {
    Array::push(errors, effect_error_to_string(Array::get(direct_errors, i)))
    i = i + 1
  }
}

/// Append `Async`-escape diagnostics (an async primitive used outside an
/// `{Async}` context) to the type-error list, but only when type checking is
/// otherwise clean so we surface the real error first.
fn collect_async_effect_errors(stmts: Array[Stmt], env: TypeEnv, frozen_errors: Array[String]) -> Unit {
  if Array::length(frozen_errors) == 0 {
    let eff_errs = check_async_effects_stmts(stmts, env)
    let mut i = 0
    while i < Array::length(eff_errs) {
      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))
      i = i + 1
    }
    if Array::length(frozen_errors) == 0 {
      // #1340 (ADR-0071): generic-instantiation row items are validated
      // against the effect declarations before the containment pass sees
      // them (which compares instantiation-insensitively by base name).
      geff_validate_row_targs(stmts, frozen_errors)
    }
    if Array::length(frozen_errors) == 0 {
      // ADR-0071 step 3 (#755): expand any effectset-name token in a
      // top-level binding's OWN declared effect row into its flat
      // leaf-label set BEFORE the (otherwise unmodified)
      // check_perform_effects_stmts_env sees it -- `with AskAll`
      // becomes e.g. `with Ask`, so the existing string-label
      // containment machinery authorizes what AskAll actually expands to
      // instead of requiring callers to re-declare it verbatim. Pure AST
      // rewrite local to this file (see es_expand_stmts_effect_rows);
      // check_perform_effects_stmts_env itself is untouched.
      let (perform_es_names, perform_es_members_list, perform_ed_names, perform_ed_ops) = es_collect_tables(stmts, 0)
      es_append_imported_tables(env_type_defs(env), perform_es_names, perform_es_members_list, perform_ed_names, perform_ed_ops)
      let expanded_stmts = es_expand_stmts_effect_rows(stmts, perform_es_names, perform_es_members_list)
      let perform_errs = check_perform_effects_stmts_env(expanded_stmts, env)
      let mut j = 0
      while j < Array::length(perform_errs) {
        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))
        j = j + 1
      }
    }
    if Array::length(frozen_errors) == 0 {
      let mut_errs = check_mutability_stmts(stmts)
      let mut k = 0
      while k < Array::length(mut_errs) {
        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))
        k = k + 1
      }
    }
  }
}

/// #986: labeled-argument NAME validation. Codegen binds call arguments
/// positionally after desugar_labeled_args has reordered fully-labeled calls
/// into declared parameter order, so any labeled argument that survives to a
/// position whose parameter has a DIFFERENT base name would silently bind the
/// wrong parameter (or, for a label naming no parameter at all, is a typo the
/// user meant to be caught). This walk runs AFTER desugar_labeled_args (see
/// check_program) and rejects both shapes with a located error. Resolution
/// scope deliberately mirrors collect_fn_param_labels / relabel_expr in
/// desugar_trait_dict.vibe: only calls whose callee is an EIdent naming a
/// top-level `let`-bound function are validated — builtins with decorative
/// flag labels (`sh_lines("ls", a = true)`), local closures, and method calls
/// are left untouched, exactly like the reorder pass leaves them untouched.
fn labeled_name_marker(off: Int, len: Int) -> String {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

/// Strip a trailing `~` (labeled) / `?` (optional) marker off a raw parameter
/// name — same convention as the EFn arm in checker.vibe.
fn labeled_param_base_name(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

/// fname -> ordered parameter base names for EVERY top-level `let f = (..) -> ..`
/// (labeled or not — a labeled call against an unlabeled fn still binds
/// positionally, so its labels must line up too).
fn collect_labeled_check_fns(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, params, _, _, _) => {
          let names = array_empty()
          let mut pi = 0
          while pi < Array::length(params) {
            let (pn, _) = Array::get(params, pi)
            Array::push(names, labeled_param_base_name(pn))
            pi = pi + 1
          }
          Array::push(out, (fname, names))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_labeled_check_fn(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(tbl) {
    let (n, names) = Array::get(tbl, i)
    if n == fname {
      found = Some(names)
      i = Array::length(tbl)
    } else {
      i = i + 1
    }
  }
  found
}

/// #1001: the Oracle (formal/VibeFormal/Typing/Call.lean's `resolveArguments`)
/// rejects a call whose arguments mix `ELabeledArg` (`x=1`) and plain
/// positional (`"ok"`) forms UNCONDITIONALLY -- a call must be either
/// uniformly positional or uniformly labeled, regardless of whether a label
/// happens to already sit at its own declared parameter position. This check
/// MUST run on the ORIGINAL, pre-desugar argument list (see the `pre_desugar`
/// branch in `labeled_name_check_expr` above): `desugar_labeled_args`'s
/// `strip_in_position_labels` (desugar_trait_dict.vibe) silently unwraps any
/// label that already matches its own position, on the theory that it is a
/// harmless "decorative" label on an otherwise-fully-positional call -- so
/// `f(x=1, "ok")` desugars to the ordinary positional `f(1, "ok")`,
/// indistinguishable by the time codegen or a post-desugar checker pass would
/// see it from a call that was never labeled at all. Checking here, before
/// that stripping runs, is the only point where the genuine mix is still
/// observable.
fn check_mixed_argument_modes(fname: String, fname_off: Int, args: Array[Expr], errors: Array[String]) -> Unit {
  let mut has_labeled = false
  let mut has_plain = false
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(_, _, _) => {
        has_labeled = true
      },
      _ => {
        has_plain = true
      }
    }
    i = i + 1
  }
  if has_labeled && has_plain {
    let marker = labeled_name_marker(fname_off, String::length(fname))
    Array::push(errors, String::concat("call to ", String::concat(fname, String::concat(" mixes positional and labeled arguments — use either all positional or all labeled arguments", marker))))
  } else {
    ()
  }
}

fn labeled_name_check_call(fname: String, fname_off: Int, args: Array[Expr], pnames: Array[String], errors: Array[String]) -> Unit {
  let mut ai = 0
  while ai < Array::length(args) {
    match Array::get(args, ai) {
      ELabeledArg(lbl, _, _) => {
        let in_position = if ai < Array::length(pnames) {
          Array::get(pnames, ai) == lbl
        } else {
          false
        }
        if in_position {
          ()
        } else {
          let mut known = false
          let mut pi = 0
          while pi < Array::length(pnames) {
            if Array::get(pnames, pi) == lbl {
              known = true
            } else {
              ()
            }
            pi = pi + 1
          }
          let marker = labeled_name_marker(fname_off, String::length(fname))
          if known {
            Array::push(errors, String::concat("labeled argument `", String::concat(lbl, String::concat("` for ", String::concat(fname, String::concat(" is out of declared parameter order", marker))))))
          } else {
            Array::push(errors, String::concat("unknown labeled argument `", String::concat(lbl, String::concat("` for ", String::concat(fname, marker)))))
          }
        }
      },
      _ => ()
    }
    ai = ai + 1
  }
}

/// #986 (Codex P2-2 on #993): the walk tracks lexical shadowing — a local
/// binding (`let f = ..`, fn param, pattern bind, loop var) of a table name
/// suppresses validation for calls in its scope, since those calls resolve to
/// the local value whose parameter names the top-level table does not describe.
/// Same discipline as relabel_expr's `shadows` stack in desugar_trait_dict.vibe.
fn labeled_walk_shadowed(shadows: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(shadows) {
    if Array::get(shadows, i) == name {
      found = true
      i = Array::length(shadows)
    } else {
      i = i + 1
    }
  }
  found
}

fn labeled_walk_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {
  match pat {
    PBind(n) => Array::push(shadows, n),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        labeled_walk_pat_binds(Array::get(ps, i), shadows)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        labeled_walk_pat_binds(Array::get(ps, i), shadows)
        i = i + 1
      }
    },
    POr(a, b) => {
      labeled_walk_pat_binds(a, shadows)
      labeled_walk_pat_binds(b, shadows)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        labeled_walk_pat_binds(fp, shadows)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn labeled_name_check_expr(e: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], errors: Array[String], pre_desugar: Bool) -> Unit {
  match e {
    ECall(callee, args, _) => {
      labeled_name_check_expr(callee, tbl, shadows, errors, pre_desugar)
      let mut i = 0
      while i < Array::length(args) {
        labeled_name_check_expr(Array::get(args, i), tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
      match callee {
        EIdent(fname, fname_off) => {
          let mut has_labeled = false
          let mut li = 0
          while li < Array::length(args) {
            match Array::get(args, li) {
              ELabeledArg(_, _, _) => {
                has_labeled = true
              },
              _ => ()
            }
            li = li + 1
          }
          if has_labeled {
            if pre_desugar {
              // #1001 review (Codex P2): mixed-mode is a purely syntactic
              // call-shape check that needs no parameter-name resolution at
              // all, so it must NOT be gated behind the same
              // tbl-membership + not-shadowed lookup the position/unknown-
              // label checks need (those genuinely require knowing the
              // callee's real param names). Gating it that way let a call to
              // any LOCAL closure with labeled params bypass the check
              // entirely: `labeled_walk_shadowed` returns true for such a
              // callee (it tracks every local let/param binding in scope,
              // not just names that collide with a top-level table entry),
              // so the check never ran. Run it whenever the callee resolves
              // to a genuine user-level closure -- a local binding OR a
              // known top-level fn -- either of which can legitimately
              // declare labeled params. A callee that is neither (a genuine
              // BUILTIN, some of which use a deliberate decorative
              // flag-label convention -- `sh_lines("ls", a = true)` -- or an
              // import/erroneous reference) stays tolerated, exactly like
              // the post-desugar branch below already tolerates those
              // shapes.
              if labeled_walk_shadowed(shadows, fname) {
                check_mixed_argument_modes(fname, fname_off, args, errors)
              } else {
                match lookup_labeled_check_fn(tbl, fname) {
                  Some(_) => check_mixed_argument_modes(fname, fname_off, args, errors),
                  None => ()
                }
              }
            } else if !labeled_walk_shadowed(shadows, fname) {
              match lookup_labeled_check_fn(tbl, fname) {
                Some(pnames) => labeled_name_check_call(fname, fname_off, args, pnames, errors),
                None => ()
              }
            } else {
              ()
            }
          } else {
            ()
          }
        },
        _ => ()
      }
    },
    ELabeledArg(_, _, v) => labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar),
    EBinOp(_, l, r) => {
      labeled_name_check_expr(l, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(r, tbl, shadows, errors, pre_desugar)
    },
    EUnaryOp(_, inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
    },
    ESpread(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fv) = Array::get(fields, i)
        labeled_name_check_expr(fv, tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
    },
    EMap(pairs) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, pv) = Array::get(pairs, i)
        labeled_name_check_expr(pv, tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
    },
    EIf(cnd, thn, els) => {
      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(thn, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(els, tbl, shadows, errors, pre_desugar)
    },
    ELet(name, v, b, _) => {
      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    ELetRec(name, v, b) => {
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    ELetMut(name, v, b, _) => {
      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    EAssign(_, v, k) => {
      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)
    },
    EAssignOp(_, _, v, k) => {
      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)
    },
    ESeq(a, b) => {
      labeled_name_check_expr(a, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)
    },
    EMatch(scrut, arms) => {
      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(shadows)
        labeled_walk_pat_binds(ap, shadows)
        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)
        Array::truncate(shadows, mark)
        i = i + 1
      }
    },
    EHandle(scrut, arms) => {
      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(shadows)
        labeled_walk_pat_binds(ap, shadows)
        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)
        Array::truncate(shadows, mark)
        i = i + 1
      }
    },
    EWhile(cnd, body) => {
      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)
      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)
    },
    ELoop(inits, body) => {
      let mut i = 0
      while i < Array::length(inits) {
        let (_, iv) = Array::get(inits, i)
        labeled_name_check_expr(iv, tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
      let mark = Array::length(shadows)
      let mut pi = 0
      while pi < Array::length(inits) {
        let (pname, _) = Array::get(inits, pi)
        Array::push(shadows, pname)
        pi = pi + 1
      }
      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    EForIn(name, idx, iter, body) => {
      labeled_name_check_expr(iter, tbl, shadows, errors, pre_desugar)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      match idx {
        Some(ix) => Array::push(shadows, ix),
        None => ()
      }
      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    EFn(_, _, fparams, _, _, body) => {
      let mark = Array::length(shadows)
      let mut pi = 0
      while pi < Array::length(fparams) {
        let (pn, _) = Array::get(fparams, pi)
        Array::push(shadows, labeled_param_base_name(pn))
        pi = pi + 1
      }
      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)
      Array::truncate(shadows, mark)
    },
    EDot(obj, _, _, _) => labeled_name_check_expr(obj, tbl, shadows, errors, pre_desugar),
    EReturn(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),
    EBreak(opt) => match opt {
      Some(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),
      None => ()
    },
    EContinue(exprs) => {
      let mut i = 0
      while i < Array::length(exprs) {
        labeled_name_check_expr(Array::get(exprs, i), tbl, shadows, errors, pre_desugar)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn labeled_name_check_stmt(stmt: Stmt, tbl: Array[(String, Array[String])], errors: Array[String], pre_desugar: Bool) -> Unit {
  match stmt {
    SLet(_, _, _, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),
    SFnDecl(_, _, body, _, _) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),
    SLetMut(_, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),
    STest(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),
    SBench(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),
    SExpr(e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),
    SLetPat(_, e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),
    SModule(_, _, ms) => {
      let mut i = 0
      while i < Array::length(ms) {
        labeled_name_check_stmt(Array::get(ms, i), tbl, errors, pre_desugar)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// #1001: `pre_desugar` selects which of the two labeled-call checks runs (see
/// `labeled_name_check_expr`'s `pre_desugar` branch): `true` for the mixed-
/// argument-modes check, called BEFORE `desugar_labeled_args` in
/// `check_program`/`check_program_with_env` so it still sees each call's
/// original argument list; `false` (the pre-existing behavior) for the
/// unknown/out-of-order label checks, which must run AFTER desugar so a
/// validly-reordered fully-labeled call is not misjudged against its
/// original call-site order.
fn check_labeled_arg_names_stmts(stmts: Array[Stmt], errors: Array[String], pre_desugar: Bool) -> Unit {
  if pre_desugar {
    ()
  } else {
    report_unresolved_mut_labeled_calls(errors)
  }
  let tbl = collect_labeled_check_fns(stmts)
  if Array::length(tbl) == 0 {
    ()
  } else {
    let mut i = 0
    while i < Array::length(stmts) {
      labeled_name_check_stmt(Array::get(stmts, i), tbl, errors, pre_desugar)
      i = i + 1
    }
  }
}

/// #1994: a labeled call whose callee is a `let mut` binding that the program
/// assigns lambdas with DIFFERENT parameter names. `desugar_labeled_args` walks
/// past it -- there is no single declared order to reorder into -- and codegen
/// then binds the arguments in written order, which is the right answer only
/// when the written order happens to match whichever lambda runs. Report it
/// here rather than let it compile: the walk in this file cannot find these on
/// its own, because it validates against a table of top-level functions and
/// deliberately skips every locally-bound callee.
fn report_unresolved_mut_labeled_calls(errors: Array[String]) -> Unit {
  let sites = unresolved_mut_labeled_calls()
  let mut i = 0
  while i < Array::length(sites) {
    let (fname, off) = Array::get(sites, i)
    let marker = labeled_name_marker(off, String::length(fname))
    Array::push(errors, String::concat("cannot resolve labeled arguments for ", String::concat(fname, String::concat(": a branch, loop or closure assigns it a lambda with different parameter names, so a label does not name a position here — call ", String::concat(fname, String::concat(" positionally, or give every lambda assigned to ", String::concat(fname, String::concat(" the same parameter names", marker))))))))
    i = i + 1
  }
}

/// Compatibility statement checker. It intentionally preserves the historical
/// signature; production result APIs use the provenance-aware internal helper.
export fn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int) {
  let ignored_type_def_binders = array_empty()
  // #1455: this compatibility entry point is handed a caller-owned `defs`
  // that never contains seeded imported enums, so every declaration in it is
  // local and the #1078 scan starts at 0.
  check_stmts_with_binders(raw_stmts, i, env, defs, ignored_type_def_binders, 0, s, c, errors, tytab, None, None, None, false, true)
}

/// Run the production whole-program check and retain every successful output
/// the checker actually produces. This deliberately does not use the
/// hover-only `check_program_type_table` path.
/// #2141 (interim guard): reject a type-parameter binder that shares its
/// spelling with a struct/enum declared in the SAME module. The desugar's
/// generated generic helpers resolve type names by SPELLING
/// (`dtd_type_param_names` subtracts declared type names program-wide), so a
/// formal `T` next to a declared `struct T` makes
/// `fn same[T](a: Array[T], b: Array[T]) { a == b }` compare with the
/// STRUCT's semantics over non-struct elements -- `same([1,2], [1,3])`
/// answered true with no diagnostic anywhere. Until that classification is
/// scope-precise, the collision itself is rejected at the binder.
///
/// LOCAL declarations only, on purpose: a formal shadowing an IMPORTED type
/// is measured behaviorally harmless (the helper over-binds and element
/// comparison stays structural; pinned by
/// derive_array_helper_interference_test.vibe), and rejecting it would break
/// working programs whose dependency happens to export a colliding name.
fn tps_local_type_names_into(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => Array::push(out, name),
      SEnum(_, name, _, _, _) => Array::push(out, name),
      // #2141: `module` blocks are rejected by the parser (#728), so source
      // cannot produce an SModule -- recursed anyway so a synthetic or
      // legacy producer stays covered.
      SModule(_, _, body) => tps_local_type_names_into(body, out),
      _ => ()
    }
    i = i + 1
  }
}

fn tps_local_type_names(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  tps_local_type_names_into(stmts, out)
  out
}

fn tps_names_contains(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if Array::get(names, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn tps_report(tparams: Array[String], local_types: Array[String], where_label: String, anchor: String, errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(tparams) {
    let tp = type_param_name(Array::get(tparams, i))
    if tps_names_contains(local_types, tp) {
      // The ` [@fn=name]` suffix is the #1941 side-channel marker: binder
      // lists carry no offset of their own, so the diagnostic anchors on the
      // declaration name and locate_type_error turns it into a real line:col
      // at the CLI boundary (find_fn_anchor_off prefers `fn name`/`let name`
      // and falls back to the name's first occurrence, which for a struct or
      // enum label is its declaration). Attached only when the label names a
      // real identifier -- a test's string title is not a word the locator
      // can find, and an unresolved marker is stripped, never printed.
      let located = if String::length(anchor) > 0 {
        String::concat(" [@fn=", String::concat(anchor, "]"))
      } else {
        ""
      }
      Array::push(errors, String::concat("type parameter `", String::concat(tp, String::concat("` of ", String::concat(where_label, String::concat(" shadows the declared type `", String::concat(tp, String::concat("`; rename the type parameter or the declared type -- generated generic helpers resolve type names by spelling, so a shadowed formal silently takes the declared type's semantics (#2141)", located))))))))
    } else {
      ()
    }
    i = i + 1
  }
}

fn tps_scan_expr(e: Expr, local_types: Array[String], where_label: String, anchor: String, errors: Array[String]) -> Unit {
  match e {
    EFn(tparams, _, _, _, _, _) => tps_report(tparams, local_types, where_label, anchor, errors),
    _ => ()
  }
  let kids = expr_children(e)
  let mut i = 0
  while i < Array::length(kids) {
    tps_scan_expr(Array::get(kids, i), local_types, where_label, anchor, errors)
    i = i + 1
  }
}

fn tps_decl_label(kind: String, name: String) -> String {
  String::concat(kind, String::concat(" `", String::concat(name, "`")))
}

/// #2141 (Codex P1 on #2183): the `__Vfp_` prefix is the desugar's re-spelling
/// of a type-parameter -- `is_marked_formal_name` treats any matching spelling
/// as compiler-generated, so a USER-DECLARED type borrowing the prefix
/// (`struct __Vfp_Point`) would be classified as a variable and its arrays
/// silently compared with erased equality. Reserve the prefix at the one place
/// user source can introduce a colliding meaning: a type DECLARATION. Binders
/// and annotations need no rule of their own -- a binder spelled `__Vfp_X` is
/// genuinely a formal (nothing declared can collide once declarations are
/// rejected), and an undeclared annotation is already an unknown type (#2125).
/// Generated code never declares a `__Vfp_`-prefixed type (helpers are `let`
/// functions; witness structs are `<Trait>Dict`), so the post-desugar merged
/// re-check lane stays clean.
fn tps_reserved_prefix_report(kind: String, name: String, errors: Array[String]) -> Unit {
  if String::starts_with(name, "__Vfp_") {
    Array::push(errors, String::concat(kind, String::concat(" `", String::concat(name, "` uses the reserved `__Vfp_` prefix (compiler-generated type-variable spellings) -- rename the type (#2141)"))))
  } else {
    ()
  }
}

fn collect_reserved_type_prefix_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => tps_reserved_prefix_report("struct", name, errors),
      SEnum(_, name, _, _, _) => tps_reserved_prefix_report("enum", name, errors),
      STypeAlias(_, name, _, _) => tps_reserved_prefix_report("type alias", name, errors),
      // #2141: unreachable from source (#728 removed module blocks);
      // recursed for any synthetic/legacy producer.
      SModule(_, _, body) => collect_reserved_type_prefix_errors(body, errors),
      _ => ()
    }
    i = i + 1
  }
}

fn tps_scan_stmts(stmts: Array[Stmt], local_types: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, tparams) => tps_report(tparams, local_types, tps_decl_label("struct", name), name, errors),
      SEnum(_, name, tparams, _, _) => tps_report(tparams, local_types, tps_decl_label("enum", name), name, errors),
      SLet(_, _, name, _, e) => tps_scan_expr(e, local_types, tps_decl_label("declaration", name), name, errors),
      SLetMut(name, _, e) => tps_scan_expr(e, local_types, tps_decl_label("declaration", name), name, errors),
      SLetPat(_, e) => tps_scan_expr(e, local_types, "a `let` pattern binding", "", errors),
      SExpr(e) => tps_scan_expr(e, local_types, "a top-level expression", "", errors),
      STest(name, e) => tps_scan_expr(e, local_types, tps_decl_label("test", name), "", errors),
      SBench(name, e) => tps_scan_expr(e, local_types, tps_decl_label("bench", name), "", errors),
      // #2141: unreachable from source (#728 removed module blocks);
      // recursed for any synthetic/legacy producer.
      SModule(_, _, body) => tps_scan_stmts(body, local_types, errors),
      _ => ()
    }
    i = i + 1
  }
}

/// Mixed-kind only (`F` unapplied and `F[A]` applied on the same TypeExpr).
/// Alias / effect / trait / struct-field `F[A]` is a well-kinded constructor
/// use; `report_formal_applications` is the shared rule with fn signatures.
fn fapp_report(te: TypeExpr, formals: Array[String], where_label: String, errors: Array[String]) -> Unit {
  report_formal_applications(te, formals, where_label, errors)
}

/// #2286: the label for a struct FIELD diagnostic.
///
/// Normally ``field `f` of struct `S` ``. But when `S` is a witness struct the
/// trait-dict desugar synthesized, that names a declaration the author never
/// wrote and cannot act on -- and in the whole-program lane it is the only
/// diagnostic emitted, because the trait statement is gone by the time this
/// walk runs. So it carries the trait's label instead, the same
/// ``the signature of `Store::lookup` `` that `vibe check` reports, and the
/// two lanes stop disagreeing about the same file.
///
/// `synthesized_dict_field_trait` answers from what the desugar RECORDED, not
/// from the `+ "Dict"` name convention. A hand-written `StoreDict` is never
/// synthesized (the desugar's `struct_decl_exists` guard skips it), so it is
/// absent from the record and keeps the field label -- by construction rather
/// than by a name test, which is what #2276's attempt got wrong.
///
/// Keyed by (struct, FIELD): `flatten_traits` copies a supertrait's methods
/// into the child's dict, so `ChildDict` carries fields only `Base` declares.
/// Keying by struct alone reported ``the signature of `Child::lookup` `` for
/// one of those -- a declaration that does not exist (Codex review on #2313).
fn struct_field_decl_label(struct_name: String, field_name: String) -> String {
  let owning_trait = synthesized_dict_field_trait(struct_name, field_name)
  if owning_trait == "" {
    String::concat(String::concat(String::concat("field `", field_name), "` of struct `"), String::concat(struct_name, "`"))
  } else {
    fapp_decl_label(owning_trait, field_name)
  }
}

fn fapp_decl_label(owner: String, member: String) -> String {
  String::concat(String::concat(String::concat("the signature of `", owner), String::concat("::", member)), "`")
}

/// Does this method declare a generic of its own with this name -- i.e. does it
/// shadow a trait header parameter spelled the same way?
fn fapp_method_binds_name(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], mname: String, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(method_gens) && !found {
    let (gname, gtp, _) = Array::get(method_gens, i)
    if gname == mname && fapp_formals_have_name(gtp, name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Does any of `formals` bind this NAME? They are type-param keys (`A[_]`), so
/// an exact string compare misses a kinded binder -- which is the shadow this
/// question exists to find.
fn fapp_formals_have_name(formals: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(formals) && !found {
    if type_param_name(Array::get(formals, i)) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn fapp_applied_formals_across(tes: Array[TypeExpr], formals: Array[String]) -> Array[String] {
  let applied = array_empty()
  let is_formal = (head) -> {
    string_array_contains_exact(formals, head)
  }
  let mut i = 0
  while i < Array::length(tes) {
    collect_formal_applications_by(Array::get(tes, i), is_formal, applied)
    i = i + 1
  }
  applied
}

/// An applied formal (`F[A]`) in a trait method signature whose parameter is
/// declared as a COMPLETE type. Such a trait can be declared but never
/// implemented: measured, every impl head that supplies a constructor for it is
/// rejected ("type parameter `F` of `Functor` expects a complete type, but
/// `Array` is a constructor with 1 argument(s)"). The declaration is therefore
/// where to say so, and the fix is to declare the parameter kinded -- a kinded
/// `F[_]` applied as `F[A]` stays legal (#2351).
fn fapp_unkinded_application_error(tname: String, mname: String, formal: String) -> String {
  let head = String::concat(String::concat("constructor parameter `", formal), "` is applied in ")
  let mid = String::concat(String::concat(", but `", formal), "` is declared as a complete type that no impl can satisfy")
  let tail = String::concat(String::concat("; declare it as a type constructor -- spell it `", formal), String::concat(String::concat("[_]` in trait `", tname), "`'s parameter list"))
  String::concat(String::concat(head, fapp_decl_label(tname, mname)), String::concat(mid, tail))
}

fn collect_decl_formal_application_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STypeAlias(_, name, params, te) => fapp_report(te, params, String::concat(String::concat("the body of type alias `", name), "`"), errors),
      SEffectDef(_, ename, eparams, ops) => {
        let effect_tes = array_empty()
        let mut oi = 0
        while oi < Array::length(ops) {
          let (_, opparams, opret) = Array::get(ops, oi)
          let mut pi = 0
          while pi < Array::length(opparams) {
            Array::push(effect_tes, Array::get(opparams, pi))
            pi = pi + 1
          }
          Array::push(effect_tes, opret)
          oi = oi + 1
        }
        report_formal_applications_across(effect_tes, eparams, String::concat(String::concat("effect `", ename), "`"), errors)
      },
      STrait(_, tname, _, methods, method_gens, tparams) => {
        // A header parameter's kind is aggregated across the whole trait, so
        // it has to be aggregated over the methods that actually MENTION it.
        // A method generic of the same name is a different binder with its own
        // kind, and pooling both made
        //
        //   trait Scoped[A] { raw(A) -> A; project[A[_], B](A[B]) -> A[B] }
        //
        // look like one `A` used unapplied by `raw` and applied by `project`,
        // reported as a mixed-kind error against a valid declaration (Codex
        // review). One pass per header parameter, over the methods that do not
        // rebind it.
        let trait_label = String::concat(String::concat("trait `", tname), "`")
        let mut hi = 0
        while hi < Array::length(tparams) {
          let header_key = Array::get(tparams, hi)
          let header_name = type_param_name(header_key)
          let visible_tes = array_empty()
          let mut mj = 0
          while mj < Array::length(methods) {
            let (mname_j, mparams_j, mret_j) = Array::get(methods, mj)
            if !fapp_method_binds_name(method_gens, mname_j, header_name) {
              let mut pj = 0
              while pj < Array::length(mparams_j) {
                Array::push(visible_tes, Array::get(mparams_j, pj))
                pj = pj + 1
              }
              Array::push(visible_tes, mret_j)
            } else {
              ()
            }
            mj = mj + 1
          }
          let header_only = array_empty()
          Array::push(header_only, header_key)
          report_formal_applications_across(visible_tes, header_only, trait_label, errors)
          hi = hi + 1
        }
        let mut mi = 0
        while mi < Array::length(methods) {
          let (mname, mparams, mret) = Array::get(methods, mi)
          // Method-local formals are checked per method. Header formals were
          // checked across the whole trait above because their kind belongs
          // to the trait declaration, not one member.
          let formals = array_empty()
          Array::push(formals, "Self")
          let mut gi = 0
          while gi < Array::length(method_gens) {
            let (gname, gtp, _) = Array::get(method_gens, gi)
            if gname == mname {
              let mut gj = 0
              while gj < Array::length(gtp) {
                Array::push(formals, Array::get(gtp, gj))
                gj = gj + 1
              }
            } else {
              ()
            }
            gi = gi + 1
          }
          let method_tes = array_empty()
          let mut pi = 0
          while pi < Array::length(mparams) {
            Array::push(method_tes, Array::get(mparams, pi))
            pi = pi + 1
          }
          Array::push(method_tes, mret)
          report_formal_applications_across(method_tes, formals, fapp_decl_label(tname, mname), errors)
          let applied_method_formals = fapp_applied_formals_across(method_tes, formals)
          let mut afi = 0
          while afi < Array::length(applied_method_formals) {
            let applied_name = Array::get(applied_method_formals, afi)
            if applied_name == "Self" {
              Array::push(errors, String::concat(String::concat("`Self` is a complete type and cannot be applied in ", fapp_decl_label(tname, mname)), "; write `Self`, not `Self[...]`"))
            } else {
              Array::push(errors, fapp_unkinded_application_error(tname, mname, applied_name))
            }
            afi = afi + 1
          }
          // Only the header parameters this method does NOT shadow. A method
          // generic of the same name is a different binder with its own kind:
          // `trait Scoped[A] { project[A[_], B](A[B]) -> A[B] }` applies the
          // method's kinded `A`, not the header's complete-type `A`, and
          // reporting it produced a diagnostic that told the author to write
          // `A[_]` -- which is what they had written (Codex review).
          let unshadowed_tparams = array_empty()
          let mut ti = 0
          while ti < Array::length(tparams) {
            let tparam = Array::get(tparams, ti)
            if !fapp_formals_have_name(formals, type_param_name(tparam)) {
              Array::push(unshadowed_tparams, tparam)
            } else {
              ()
            }
            ti = ti + 1
          }
          let applied_header_formals = fapp_applied_formals_across(method_tes, unshadowed_tparams)
          let mut ahi = 0
          while ahi < Array::length(applied_header_formals) {
            Array::push(errors, fapp_unkinded_application_error(tname, mname, Array::get(applied_header_formals, ahi)))
            ahi = ahi + 1
          }
          mi = mi + 1
        }
      },
      SModule(_, _, body) => collect_decl_formal_application_errors(body, errors),
      _ => ()
    }
    i = i + 1
  }
}

fn collect_type_param_shadowing_errors(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  collect_reserved_type_prefix_errors(stmts, errors)
  collect_decl_formal_application_errors(stmts, errors)
  let local_types = tps_local_type_names(stmts)
  if Array::length(local_types) == 0 {
    ()
  } else {
    tps_scan_stmts(stmts, local_types, errors)
  }
}

fn push_unique_error_strings(found: Array[String], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(found) {
    let message = Array::get(found, i)
    if string_array_contains_exact(errors, message) {
      ()
    } else {
      Array::push(errors, message)
    }
    i = i + 1
  }
}

fn insert_unique_error_strings(found: Array[String], errors: Array[String], at: Int) -> Unit {
  if Array::length(found) == 0 {
    ()
  } else {
    let suffix = Array::slice(errors, at, Array::length(errors))
    Array::truncate(errors, at)
    push_unique_error_strings(found, errors)
    push_unique_error_strings(suffix, errors)
  }
}

/// Checks every declaration payload after the current statement list's
/// complete type-definition table exists. Each nested module invokes this from
/// its own phase boundary, and a sibling completion invokes it again over the
/// combined visible declarations. Without the completed table, a later alias
/// can leave a `Map` key looking nominal and defer a diagnostic forever.
fn check_completed_decl_map_keys(stmts: Array[Stmt], defs: Array[TypeDef], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let found = array_empty()
    match Array::get(stmts, i) {
      STypeAlias(_, name, params, te) => {
        report_map_key_types(te, defs, params, String::concat(String::concat("the body of type alias `", name), "`"), found)
      },
      SStruct(_, name, fields, _, _, params) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (field_name, field_type) = Array::get(fields, fi)
          report_map_key_types(field_type, defs, params, struct_field_decl_label(name, field_name), found)
          fi = fi + 1
        }
      },
      SEnum(_, name, params, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (variant_name, payloads) = Array::get(variants, vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            report_map_key_types(Array::get(payloads, pi), defs, params, String::concat(String::concat(String::concat("the payload of `", name), String::concat("::", variant_name)), "`"), found)
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      SSuberror(_, name, variants) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (variant_name, payloads) = Array::get(variants, vi)
          let mut pi = 0
          while pi < Array::length(payloads) {
            report_map_key_types(Array::get(payloads, pi), defs, array_empty(), String::concat(String::concat(String::concat("the payload of `", name), String::concat("::", variant_name)), "`"), found)
            pi = pi + 1
          }
          vi = vi + 1
        }
      },
      SEffectDef(_, name, params, ops) => {
        let mut oi = 0
        while oi < Array::length(ops) {
          let (op_name, op_params, op_ret) = Array::get(ops, oi)
          let where_label = fapp_decl_label(name, op_name)
          let mut pi = 0
          while pi < Array::length(op_params) {
            report_map_key_types(Array::get(op_params, pi), defs, params, where_label, found)
            pi = pi + 1
          }
          report_map_key_types(op_ret, defs, params, where_label, found)
          oi = oi + 1
        }
      },
      _ => ()
    }
    push_unique_error_strings(found, errors)
    i = i + 1
  }
}

fn string_array_contains_exact(items: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == wanted {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn alias_decl_body(stmts: Array[Stmt], name: String) -> Option[(Array[String], TypeExpr)] {
  let mut i = 0
  let mut result = None
  while i < Array::length(stmts) && result is None {
    match Array::get(stmts, i) {
      STypeAlias(_, alias_name, params, body) => if alias_name == name {
        result = Some((params, body))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  result
}

fn alias_type_expr_reaches(stmts: Array[Stmt], te: TypeExpr, shadow: Array[String], target: String, seen: Array[String]) -> Bool {
  let refs = array_empty()
  collect_texpr_ref_names(te, refs)
  let mut i = 0
  let mut reaches = false
  while i < Array::length(refs) && !reaches {
    let name = Array::get(refs, i)
    if string_array_contains_exact(shadow, name) {
      ()
    } else if name == target {
      reaches = true
    } else if string_array_contains_exact(seen, name) {
      ()
    } else {
      match alias_decl_body(stmts, name) {
        Some((params, body)) => {
          Array::push(seen, name)
          if alias_type_expr_reaches(stmts, body, params, target, seen) {
            reaches = true
          } else {
            ()
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  reaches
}

fn alias_decl_is_recursive(stmts: Array[Stmt], name: String, params: Array[String], body: TypeExpr) -> Bool {
  alias_type_expr_reaches(stmts, body, params, name, array_empty())
}

fn collect_visible_type_stmts(stmts: Array[Stmt], to: Int, out: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < to {
    let stmt = Array::get(stmts, i)
    if stmt_is_type_decl(stmt) {
      Array::push(out, stmt)
    } else {
      ()
    }
    i = i + 1
  }
  i = 0
  while i < to {
    match Array::get(stmts, i) {
      SModule(_, _, body) => collect_visible_type_stmts(body, Array::length(body), out),
      _ => ()
    }
    i = i + 1
  }
}

fn recursive_alias_flags(stmts: Array[Stmt]) -> Array[Bool] {
  let flags = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STypeAlias(_, name, params, body) => Array::push(flags, alias_decl_is_recursive(stmts, name, params, body)),
      _ => Array::push(flags, false)
    }
    i = i + 1
  }
  flags
}

fn alias_expansion_node_limit() -> Int {
  262144
}

fn capped_type_node_add(total: Int, extra: Int, limit: Int) -> Int {
  if total > limit || extra > limit || total > limit - extra {
    limit + 1
  } else {
    total + extra
  }
}

fn type_param_index(params: Array[String], name: String) -> Int {
  let mut found = 0 - 1
  let mut i = 0
  while i < Array::length(params) && found < 0 {
    if type_param_name(Array::get(params, i)) == name {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// Counts the tree that `resolve_type_alias_params` would materialize without
/// allocating it. Counts saturate above `limit`, including duplicated formal
/// arguments, so a generic alias cannot hide the same exponential shape.
fn substituted_type_node_count(ty: Type, params: Array[String], arg_counts: Array[Int], limit: Int) -> Int {
  match ty {
    CtNamed(name, args) => {
      let param_idx = type_param_index(params, name)
      if param_idx >= 0 && param_idx < Array::length(arg_counts) {
        Array::get(arg_counts, param_idx)
      } else {
        let mut total = 1
        let mut i = 0
        while i < Array::length(args) && total <= limit {
          total = capped_type_node_add(total, substituted_type_node_count(Array::get(args, i), params, arg_counts, limit), limit)
          i = i + 1
        }
        total
      }
    },
    CtArray(elem) => capped_type_node_add(1, substituted_type_node_count(elem, params, arg_counts, limit), limit),
    CtOption(elem) => capped_type_node_add(1, substituted_type_node_count(elem, params, arg_counts, limit), limit),
    CtTuple(elems) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(elems) && total <= limit {
        total = capped_type_node_add(total, substituted_type_node_count(Array::get(elems, i), params, arg_counts, limit), limit)
        i = i + 1
      }
      total
    },
    CtFn(fn_params, ret, _) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(fn_params) && total <= limit {
        total = capped_type_node_add(total, substituted_type_node_count(Array::get(fn_params, i), params, arg_counts, limit), limit)
        i = i + 1
      }
      if total <= limit {
        total = capped_type_node_add(total, substituted_type_node_count(ret, params, arg_counts, limit), limit)
      } else {
        ()
      }
      total
    },
    CtForAll(_, _, body) => capped_type_node_add(1, substituted_type_node_count(body, array_empty(), array_empty(), limit), limit),
    CtRecord(fields) => {
      let mut total = 1
      let mut i = 0
      while i < Array::length(fields) && total <= limit {
        let (_, field_type) = Array::get(fields, i)
        total = capped_type_node_add(total, substituted_type_node_count(field_type, array_empty(), array_empty(), limit), limit)
        i = i + 1
      }
      total
    },
    _ => 1
  }
}

fn type_expr_arg_expansion_stats(args: Array[TypeExpr], defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> Array[(Int, Int)] {
  let stats = array_empty()
  let mut i = 0
  while i < Array::length(args) {
    Array::push(stats, type_expr_expansion_stats(Array::get(args, i), defs, shadow, capped_aliases, limit))
    i = i + 1
  }
  stats
}

fn type_expr_result_sizes(stats: Array[(Int, Int)]) -> Array[Int] {
  let sizes = array_empty()
  let mut i = 0
  while i < Array::length(stats) {
    Array::push(sizes, Array::get(stats, i).0)
    i = i + 1
  }
  sizes
}

/// Combines eagerly evaluated children. Previously resolved child results stay
/// live while the next child's transient allocation is evaluated.
fn type_expr_children_expansion_stats(child_stats: Array[(Int, Int)], root_size: Int, limit: Int) -> (Int, Int) {
  let mut result_sum = 0
  let mut peak = 0
  let mut i = 0
  while i < Array::length(child_stats) && result_sum <= limit {
    let child = Array::get(child_stats, i)
    let child_peak = capped_type_node_add(result_sum, child.1, limit)
    if child_peak > peak {
      peak = child_peak
    } else {
      ()
    }
    result_sum = capped_type_node_add(result_sum, child.0, limit)
    i = i + 1
  }
  let result_size = capped_type_node_add(root_size, result_sum, limit)
  if result_size > peak {
    peak = result_size
  } else {
    ()
  }
  (result_size, peak)
}

fn named_type_expr_expansion_stats(name: String, arg_stats: Array[(Int, Int)], defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> (Int, Int) {
  let arg_counts = type_expr_result_sizes(arg_stats)
  let args = type_expr_children_expansion_stats(arg_stats, 0, limit)
  if string_array_contains_exact(shadow, name) {
    type_expr_children_expansion_stats(arg_stats, 1, limit)
  } else {
    let idx = typedef_index_of_from(defs, name, 0)
    if idx >= 0 && int_array_contains(capped_aliases, idx) {
      (limit + 1, limit + 1)
    } else if idx >= 0 {
      match Array::get(defs, idx) {
        TDAlias(_, params, body) => {
          // `resolve_type_expr_core_shadowed` eagerly materializes every
          // argument before substituting the alias body, even when a formal is
          // unused. Direct argument results and the cloned result coexist, but
          // a nested argument's transient peak does not remain live afterward.
          let result_size = substituted_type_node_count(body, params, arg_counts, limit)
          let own_peak = capped_type_node_add(args.0, result_size, limit)
          let peak = if args.1 > own_peak {
            args.1
          } else {
            own_peak
          }
          (result_size, peak)
        },
        _ => type_expr_children_expansion_stats(arg_stats, 1, limit)
      }
    } else {
      type_expr_children_expansion_stats(arg_stats, 1, limit)
    }
  }
}

/// Preflights resolved tree size and transient allocation peak with saturation.
/// The first tuple field is the retained result size; the second is the peak.
/// This must run
/// before `resolve_type_expr_shadowed`: measuring the returned tree would
/// already have paid the exponential allocation this guard exists to avoid.
fn type_expr_expansion_stats(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> (Int, Int) {
  match te {
    TyUnit => (1, 1),
    TyName(name) => match resolve_builtin(name) {
      Some(_) => (1, 1),
      None => named_type_expr_expansion_stats(name, array_empty(), defs, shadow, capped_aliases, limit)
    },
    TyApp(name, args) => {
      let arg_stats = type_expr_arg_expansion_stats(args, defs, shadow, capped_aliases, limit)
      if name == "Array" && Array::length(arg_stats) == 1 {
        type_expr_children_expansion_stats(arg_stats, 1, limit)
      } else if name == "Option" && Array::length(arg_stats) == 1 {
        type_expr_children_expansion_stats(arg_stats, 1, limit)
      } else if name == "StringMap" && Array::length(arg_stats) == 1 && !string_array_contains_exact(shadow, name) && typedef_index_of_from(defs, name, 0) < 0 {
        type_expr_children_expansion_stats(arg_stats, 2, limit)
      } else {
        named_type_expr_expansion_stats(name, arg_stats, defs, shadow, capped_aliases, limit)
      }
    },
    TyTuple(elems) => type_expr_children_expansion_stats(type_expr_arg_expansion_stats(elems, defs, shadow, capped_aliases, limit), 1, limit),
    TyFn(fn_params, ret, _) => {
      let children = type_expr_arg_expansion_stats(fn_params, defs, shadow, capped_aliases, limit)
      Array::push(children, type_expr_expansion_stats(ret, defs, shadow, capped_aliases, limit))
      type_expr_children_expansion_stats(children, 1, limit)
    }
  }
}

fn type_expr_expansion_node_count(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String], capped_aliases: Array[Int], limit: Int) -> Int {
  type_expr_expansion_stats(te, defs, shadow, capped_aliases, limit).1
}

fn report_alias_expansion_limit(name: String, errors: Array[String]) -> Unit {
  let message = String::concat(String::concat(String::concat("type alias expansion exceeds ", __to_string(alias_expansion_node_limit())), String::concat(" nodes for `", name)), "`; replace the shared alias DAG with a nominal struct or enum")
  if string_array_contains_exact(errors, message) {
    ()
  } else {
    Array::push(errors, message)
  }
}

fn errors_contain_alias_expansion_limit(errors: Array[String]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(errors) && !found {
    if String::starts_with(Array::get(errors, i), "type alias expansion exceeds ") {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Re-resolves acyclic aliases from their source expressions until every
/// dependency edge has had a chance to observe the completed body. Recursive
/// declarations are skipped by statement identity, so a recursive alias in one
/// scope cannot freeze an acyclic same-name alias in another; the alias-count
/// bound cannot exponentially expand a cycle. Acyclic DAGs are preflighted
/// against a node limit before allocation, then rejected with an actionable
/// diagnostic instead of exhausting memory.
fn refresh_completed_alias_defs(stmts: Array[Stmt], defs: Array[TypeDef], from: Int, to: Int, errors: Array[String]) -> Unit {
  let rounds = local_alias_def_count(defs, from, to)
  let recursive = recursive_alias_flags(stmts)
  let capped_aliases = array_empty()
  let limit = alias_expansion_node_limit()
  let mut round = 0
  while round < rounds {
    let taken = array_empty()
    let mut i = Array::length(stmts) - 1
    while i >= 0 {
      match Array::get(stmts, i) {
        STypeAlias(_, name, params, te) => {
          let idx = completed_alias_index_reverse(defs, name, from, to, taken)
          if idx >= 0 && !Array::get(recursive, i) && !int_array_contains(capped_aliases, idx) {
            if type_expr_expansion_node_count(te, defs, params, capped_aliases, limit) > limit {
              Array::push(capped_aliases, idx)
              report_alias_expansion_limit(name, errors)
            } else {
              Array::set(defs, idx, TDAlias(name, params, resolve_type_expr_shadowed(te, defs, params)))
            }
          } else {
            ()
          }
        },
        _ => ()
      }
      i = i - 1
    }
    round = round + 1
  }
}

/// Rebuilds declaration payloads that may have consumed an alias before that
/// alias reached its completed body. Unlike alias definitions, enum payloads
/// keep checker-local CtVar binder ids, so their original binder table is
/// reused while resolving the source expressions again.
fn refresh_completed_payload_defs(stmts: Array[Stmt], defs: Array[TypeDef], type_def_binders: Array[Array[Int]], from: Int, to: Int) -> Unit {
  let taken = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, fields, _, mut_fields, params) => {
        let idx = completed_type_def_index(defs, TDStruct(name, array_empty(), mut_fields, params), from, to, taken)
        if idx >= 0 {
          let resolved = for field in fields {
            let (field_name, field_type) = field
            (field_name, resolve_type_expr_shadowed(field_type, defs, params))
          }
          Array::set(defs, idx, TDStruct(name, resolved, mut_fields, params))
        } else {
          ()
        }
      },
      SEnum(_, name, params, variants, _) => {
        let idx = completed_type_def_index(defs, TDEnum(name, params, array_empty()), from, to, taken)
        if idx >= 0 {
          let binder_types = if idx < Array::length(type_def_binders) {
            for binder in Array::get(type_def_binders, idx) {
              CtVar(binder)
            }
          } else {
            array_empty()
          }
          let resolved = for variant in variants {
            let (variant_name, payloads) = variant
            (variant_name, for payload in payloads {
              subst_type_params(resolve_type_expr_shadowed(payload, defs, params), params, binder_types)
            })
          }
          Array::set(defs, idx, TDEnum(name, params, resolved))
        } else {
          ()
        }
      },
      SSuberror(_, name, variants) => {
        let idx = completed_type_def_index(defs, TDEnum(name, array_empty(), array_empty()), from, to, taken)
        if idx >= 0 {
          let resolved = for variant in variants {
            let (variant_name, payloads) = variant
            (variant_name, for payload in payloads {
              resolve_type_expr(payload, defs)
            })
          }
          Array::set(defs, idx, TDEnum(name, array_empty(), resolved))
        } else {
          ()
        }
      },
      SEffectDef(_, name, params, ops) => {
        let idx = completed_type_def_index(defs, TDEffect(name, array_empty(), params), from, to, taken)
        if idx >= 0 {
          let resolved = for op in ops {
            let (op_name, op_params, ret) = op
            (op_name, for param in op_params {
              resolve_type_expr_shadowed(param, defs, params)
            }, resolve_type_expr_shadowed(ret, defs, params))
          }
          Array::set(defs, idx, TDEffect(name, resolved, params))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
}

fn replace_first_env_binding(env: TypeEnv, wanted: String, ty: Type, replaced: Array[Bool]) -> TypeEnv {
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => if !Array::get(replaced, 0) && name == wanted {
      Array::set(replaced, 0, true)
      EnvBind(name, env_value_binding_with_origin(ty, binding.origin), rest)
    } else {
      EnvBind(name, binding, replace_first_env_binding(rest, wanted, ty, replaced))
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, replace_first_env_binding(rest, wanted, ty, replaced), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, replace_first_env_binding(rest, wanted, ty, replaced)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, replace_first_env_binding(rest, wanted, ty, replaced)),
    EnvTypeDefs(node_defs, selectable, rest) => EnvTypeDefs(node_defs, selectable, replace_first_env_binding(rest, wanted, ty, replaced)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, replace_first_env_binding(rest, wanted, ty, replaced)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => EnvCached(names, bindings, replace_first_env_binding(rest, wanted, ty, replaced))
  }
}

fn stmt_owns_equals_marker(stmt: Stmt, type_name: String) -> Bool {
  match stmt {
    SEnum(_, name, _, _, _) => name == type_name,
    SSuberror(_, name, _) => name == type_name,
    SStruct(_, name, _, _, _, _) => name == type_name,
    _ => false
  }
}

fn later_equals_owner_count(stmts: Array[Stmt], after: Int, type_name: String) -> Int {
  let mut count = 0
  let mut i = after + 1
  while i < Array::length(stmts) {
    if stmt_owns_equals_marker(Array::get(stmts, i), type_name) {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

fn refresh_suberror_owned_bindings(env: TypeEnv, suberror_name: String, variants: Array[(String, Array[Type])], markers_to_skip: Int) -> TypeEnv {
  let marker = String::concat(suberror_name, "::equals")
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => if name == marker {
      if markers_to_skip > 0 {
        EnvBind(name, binding, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip - 1))
      } else {
        let mut refreshed_rest = rest
        let mut vi = Array::length(variants) - 1
        while vi >= 0 {
          let (variant_name, payloads) = Array::get(variants, vi)
          let ctor_ty = if Array::length(payloads) == 0 {
            CtEnum(suberror_name)
          } else {
            CtFn(payloads, CtEnum(suberror_name), constructor_dependency_row(Array::length(payloads)))
          }
          refreshed_rest = replace_first_env_binding(refreshed_rest, variant_name, ctor_ty, [
            false
          ])
          if Array::length(payloads) > 0 {
            refreshed_rest = replace_first_env_binding(refreshed_rest, fn_return_env_name(variant_name), CtEnum(suberror_name), [
              false
            ])
          } else {
            ()
          }
          vi = vi - 1
        }
        EnvBind(name, binding, refreshed_rest)
      }
    } else {
      EnvBind(name, binding, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip))
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip)),
    EnvTypeDefs(node_defs, selectable, rest) => EnvTypeDefs(node_defs, selectable, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => EnvCached(names, bindings, refresh_suberror_owned_bindings(rest, suberror_name, variants, markers_to_skip))
  }
}

fn refresh_completed_suberror_env(stmts: Array[Stmt], env: TypeEnv, defs: Array[TypeDef], from: Int, to: Int) -> TypeEnv {
  let taken = array_empty()
  let mut refreshed = env
  let mut i = Array::length(stmts) - 1
  while i >= 0 {
    match Array::get(stmts, i) {
      SSuberror(_, name, _) => {
        let idx = completed_type_def_index_reverse(defs, TDEnum(name, array_empty(), array_empty()), from, to, taken)
        if idx >= 0 {
          match Array::get(defs, idx) {
            TDEnum(_, _, variants) => {
              refreshed = refresh_suberror_owned_bindings(refreshed, name, variants, later_equals_owner_count(stmts, i, name))
            },
            _ => ()
          }
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i - 1
  }
  refreshed
}

fn local_alias_def_count(defs: Array[TypeDef], from: Int, to: Int) -> Int {
  let mut count = 0
  let mut i = from
  while i < to {
    match Array::get(defs, i) {
      TDAlias(_, _, _) => {
        count = count + 1
      },
      _ => ()
    }
    i = i + 1
  }
  count
}

/// The environment chain is newest-first, while `defs` is declaration order.
/// Find the newest unclaimed local alias so replacing an `EnvTypeDefs` node
/// preserves duplicate-name and cross-kind shadowing exactly.
fn completed_alias_index_reverse(defs: Array[TypeDef], name: String, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = to - 1
  let mut found = 0 - 1
  while i >= from && found < 0 {
    let matches = match Array::get(defs, i) {
      TDAlias(n, _, _) => n == name,
      _ => false
    }
    if matches && !int_array_contains(taken, i) {
      found = i
    } else {
      i = i - 1
    }
  }
  if found >= 0 {
    Array::push(taken, found)
  } else {
    ()
  }
  found
}

fn type_def_same_head(left: TypeDef, right: TypeDef) -> Bool {
  match (left, right) {
    (TDEnum(a, _, _), TDEnum(b, _, _)) => a == b,
    (TDStruct(a, _, _, _), TDStruct(b, _, _, _)) => a == b,
    (TDAlias(a, _, _), TDAlias(b, _, _)) => a == b,
    (TDEffect(a, _, _), TDEffect(b, _, _)) => a == b,
    (TDEffectSet(a, _), TDEffectSet(b, _)) => a == b,
    _ => false
  }
}

fn completed_type_def_index(defs: Array[TypeDef], probe: TypeDef, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = from
  let mut found = 0 - 1
  while i < to && found < 0 {
    if type_def_same_head(Array::get(defs, i), probe) && !int_array_contains(taken, i) {
      found = i
    } else {
      i = i + 1
    }
  }
  if found >= 0 {
    Array::push(taken, found)
  } else {
    ()
  }
  found
}

fn completed_type_def_index_reverse(defs: Array[TypeDef], probe: TypeDef, from: Int, to: Int, taken: Array[Int]) -> Int {
  let mut i = to - 1
  let mut found = 0 - 1
  while i >= from && found < 0 {
    if type_def_same_head(Array::get(defs, i), probe) && !int_array_contains(taken, i) {
      found = i
    } else {
      i = i - 1
    }
  }
  if found >= 0 {
    Array::push(taken, found)
  } else {
    ()
  }
  found
}

fn refresh_completed_type(ty: Type, defs: Array[TypeDef], shadow: Array[String], seen: Array[String]) -> Type {
  match ty {
    CtNamed(name, args) => {
      let refreshed_args = for arg in args {
        refresh_completed_type(arg, defs, shadow, seen)
      }
      if string_array_contains_exact(shadow, name) || string_array_contains_exact(seen, name) {
        CtNamed(name, refreshed_args)
      } else match find_typedef(defs, name) {
        Some(TDAlias(_, params, target)) => {
          let next_seen = Array::slice(seen, 0, Array::length(seen))
          Array::push(next_seen, name)
          refresh_completed_type(subst_type_params(target, params, refreshed_args), defs, shadow, next_seen)
        },
        _ => CtNamed(name, refreshed_args)
      }
    },
    CtTuple(items) => CtTuple(for item in items {
      refresh_completed_type(item, defs, shadow, seen)
    }),
    CtArray(item) => CtArray(refresh_completed_type(item, defs, shadow, seen)),
    CtOption(item) => CtOption(refresh_completed_type(item, defs, shadow, seen)),
    CtApplied(head, args) => apply_type_constructor(refresh_completed_type(head, defs, shadow, seen), for arg in args {
      refresh_completed_type(arg, defs, shadow, seen)
    }),
    CtFn(params, ret, row) => CtFn(for param in params {
      refresh_completed_type(param, defs, shadow, seen)
    }, refresh_completed_type(ret, defs, shadow, seen), row),
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, refresh_completed_type(body, defs, shadow, seen)),
    CtRecord(fields) => CtRecord(for field in fields {
      let (name, field_ty) = field
      (name, refresh_completed_type(field_ty, defs, shadow, seen))
    }),
    _ => ty
  }
}

fn refresh_completed_env_type_def(node_def: TypeDef, completed_def: TypeDef, defs: Array[TypeDef]) -> TypeDef {
  match node_def {
    TDAlias(name, params, old_body) => match completed_def {
      TDAlias(_, _, body) => TDAlias(name, params, body),
      _ => TDAlias(name, params, old_body)
    },
    TDStruct(name, fields, mut_fields, params) => TDStruct(name, for field in fields {
      let (field_name, field_ty) = field
      (field_name, refresh_completed_type(field_ty, defs, params, array_empty()))
    }, mut_fields, params),
    TDEnum(name, params, variants) => TDEnum(name, params, for variant in variants {
      let (variant_name, payloads) = variant
      (variant_name, for payload in payloads {
        refresh_completed_type(payload, defs, params, array_empty())
      })
    }),
    TDEffect(name, ops, params) => TDEffect(name, for op in ops {
      let (op_name, op_params, ret) = op
      (op_name, for param in op_params {
        refresh_completed_type(param, defs, params, array_empty())
      }, refresh_completed_type(ret, defs, params, array_empty()))
    }, params),
    TDEffectSet(name, members) => TDEffectSet(name, members)
  }
}

fn refresh_alias_env_binding(env: TypeEnv, name: String, body: Type) -> TypeEnv {
  match env {
    EnvBind(bound_name, binding, rest) => if bound_name == name {
      EnvBind(bound_name, env_value_binding_with_origin(body, binding.origin), rest)
    } else {
      env
    },
    EnvCached(names, bindings, rest) => EnvCached(names, bindings, refresh_alias_env_binding(rest, name, body)),
    _ => env
  }
}

fn refresh_type_env_prefix(env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  match env {
    EnvBind(name, binding, rest) => EnvBind(name, env_value_binding_with_origin(refresh_completed_type(binding.ty, defs, array_empty(), array_empty()), binding.origin), refresh_type_env_prefix(rest, defs)),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, refresh_completed_type(target, defs, array_empty(), array_empty()), refresh_type_env_prefix(rest, defs)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, refresh_completed_type(target, defs, params, array_empty()), refresh_type_env_prefix(rest, defs)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_type_env_prefix(rest, defs)),
    EnvCached(names, bindings, rest) => EnvCached(names, bindings, refresh_type_env_prefix(rest, defs)),
    _ => env
  }
}

/// Refreshes the completed local declaration payloads and their companion
/// value signatures without restacking the environment. The exact local type
/// count provides the boundary that keeps imported and outer nodes untouched.
fn refresh_completed_type_env(env: TypeEnv, defs: Array[TypeDef], from: Int, to: Int, taken: Array[Int], local_count: Int) -> TypeEnv {
  if Array::length(taken) >= local_count {
    env
  } else match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => EnvBind(name, binding, refresh_completed_type_env(rest, defs, from, to, taken, local_count)),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, refresh_completed_type_env(rest, defs, from, to, taken, local_count), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, refresh_completed_type_env(rest, defs, from, to, taken, local_count)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, refresh_completed_type_env(rest, defs, from, to, taken, local_count)),
    EnvTypeDefs(node_defs, selectable, rest) => {
      let refreshed = array_empty()
      let mut refreshed_rest = rest
      let mut refresh_prefix = false
      let mut i = 0
      while i < Array::length(node_defs) {
        let node_def = Array::get(node_defs, i)
        let idx = completed_type_def_index_reverse(defs, node_def, from, to, taken)
        if idx >= 0 {
          let completed_def = Array::get(defs, idx)
          Array::push(refreshed, refresh_completed_env_type_def(node_def, completed_def, defs))
          match completed_def {
            TDAlias(name, _, body) => {
              refreshed_rest = refresh_alias_env_binding(refreshed_rest, name, body)
            },
            _ => {
              refresh_prefix = true
            }
          }
        } else {
          Array::push(refreshed, node_def)
        }
        i = i + 1
      }
      let completed_rest = if refresh_prefix {
        refresh_type_env_prefix(refreshed_rest, defs)
      } else {
        refreshed_rest
      }
      EnvTypeDefs(refreshed, selectable, refresh_completed_type_env(completed_rest, defs, from, to, taken, local_count))
    },
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, refresh_completed_type_env(rest, defs, from, to, taken, local_count)),
    EnvFlat(bindings) => EnvFlat(bindings),
    EnvCached(names, bindings, rest) => EnvCached(names, bindings, refresh_completed_type_env(rest, defs, from, to, taken, local_count))
  }
}

fn check_program_type_defs_observation_impl(stmts: Array[Stmt], capture: Option[CheckerStatementCapture], role_lane_capture: Option[TypedOccurrenceRoleLaneCapture]) -> CheckedProgramTypeDefsObservation with Exception {
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  push_error_strings(collect_trait_namespace_conflict_errors(stmts, EnvEmpty), frozen_errors)
  derive_trait_namespace_operations(stmts)
  // Rank-1 method generics (#684): re-attach trait-method `[X: Bound]` binders
  // to impl free functions before checking, so `X::method` in an impl body
  // resolves on every path (the FS-compile path type-checks before the codegen
  // desugar runs). In-place + idempotent + inert without a method-level binder.
  inject_trait_method_generics(stmts)
  // #635: lower `let*`/`?` railway sentinels (`__try_bind`/`__try_op`) by the
  // operand's head type BEFORE checking, so the checker never sees the
  // sentinels (the codegen-time desugar runs later, but the FS-compile path
  // type-checks first). In-place, idempotent, inert without `let*`/`?`.
  desugar_railway_binds(stmts)
  canonicalize_stdin_provider_type_import_heads(stmts)
  collect_stdin_provider_direct_call_errors(stmts, frozen_errors)
  // #1455 step 3: the `Enum::Variant` pattern qualifiers the parser folded into
  // a trailing `SQualifiedPatternRefs` marker (see attach_qualified_pattern_refs).
  // Collected up front; validating them needs the enum table, which only exists
  // once check_stmts_with_binders below has run.
  let qualified_pattern_refs = collect_qualified_pattern_refs(stmts)
  // #1001: mixed positional/labeled argument-mode validation. Must run BEFORE
  // desugar_labeled_args below — it silently strips a label that already
  // matches its own declared position, which erases the only evidence that a
  // call genuinely mixed argument modes (see check_mixed_argument_modes).
  check_labeled_arg_names_stmts(stmts, frozen_errors, true)
  // #986: reorder fully-labeled calls into declared parameter order BEFORE
  // checking, so the checker unifies each labeled argument against the same
  // parameter position codegen will bind it to (the codegen-time desugar runs
  // this pass again later — it is in-place and idempotent). Without this the
  // checker would see `add(y=2, x=1)` in call order while codegen binds the
  // reordered form.
  desugar_labeled_args(stmts)
  // #1571: expand `inspect(..)` here, before the checker and before every
  // pre-codegen scan, so the snapshot assertion is import-free (see
  // desugar_inspect_calls).
  desugar_inspect_calls(stmts)
  // #2141: loud guard at the binder, before checking -- see the pass doc.
  collect_type_param_shadowing_errors(stmts, frozen_errors)
  let empty_defs = array_empty()
  let type_def_binders = array_empty()
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let tytab = array_empty()
  // #986: labeled-argument name validation (unknown / out-of-order labels).
  // Must run after desugar_labeled_args above.
  check_labeled_arg_names_stmts(stmts, frozen_errors, false)
  // ADR-0071 step 3 (#755): expand any effectset-name token in EVERY
  // declared effect row (function signatures AND parameter types) into its
  // flat leaf-label set ONCE here, before type-checking -- not just before
  // collect_async_effect_errors below. Argument-compatibility checking
  // (check_assignable's effect-row subtyping, checker.vibe) runs as part of
  // check_stmts and independently compares raw row strings; feeding it an
  // unexpanded "AskAll" against an already-expanded "Ask::Get" callee would
  // report a false "effect would be dropped" mismatch even though the
  // effectset actually covers it. A non-mutating copy (stmts itself, and
  // whatever the caller does with it after check_program returns, are
  // unaffected) is enough: codegen never reads the row's text content.
  let expanded_stmts = es_expand_top_level_effectset_rows(stmts, EnvEmpty)
  let statement_parent_path = match capture {
    Some(_) => Some(array_empty()),
    None => match role_lane_capture {
      Some(_) => Some(array_empty()),
      None => None
    }
  }
  let (env, final_s, _) = check_stmts_with_binders(expanded_stmts, 0, seeded_env, empty_defs, type_def_binders, 0, SubstEmpty, 0, frozen_errors, tytab, statement_parent_path, capture, role_lane_capture, false, true)
  check_program_bounds(env, final_s, empty_defs, frozen_errors)
  // #1858: a bounded generic whose body calls `T::m` but whose signature has
  // no witness-carrying parameter would sail through checking and ICE in
  // codegen (`T::m reached code generation unresolved`) — reject it here with
  // an actionable message instead. The capability predicate lives next to
  // build_gens in desugar_trait_dict.vibe.
  push_error_strings(collect_undispatchable_trait_method_errors(stmts, env), frozen_errors)
  collect_async_effect_errors(expanded_stmts, env, frozen_errors)
  // #1455 step 3: `empty_defs` is the finished enum table by now, so the
  // qualifiers drained above can finally be checked against it.
  check_qualified_pattern_refs(qualified_pattern_refs, empty_defs, frozen_errors)
  if Array::length(frozen_errors) > 0 {
    throw(Array::get(frozen_errors, 0))
  }
  // #1947: `__try_none` is a checker-only origin marker. Codegen resolves
  // constructors by name and would ICE on it (`reached code generation
  // unresolved`). Erase after a clean check so later stages see `None`.
  erase_railway_origin_markers(stmts)
  CheckedProgramTypeDefsObservation::{
    checked_program: CheckedProgram::{
      checked_stmts: stmts,
      final_env: env,
      type_defs: empty_defs,
      final_subst: final_s,
      typed_occurrences: tytab
    },
    type_def_binders: type_def_binders
  }
}

fn direct_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

/// Append an injective decimal path encoding. Length and per-element
/// delimiters make `[1, 23]`, `[12, 3]`, and signed coordinates distinct.
/// This is a complete coordinate value, never a hash used as an identity.
fn direct_coordinate_key_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, ":")
  let mut i = 0
  while i < Array::length(path) {
    StringBuilder::push(out, __to_string(Array::get(path, i)))
    StringBuilder::push(out, ":")
    i = i + 1
  }
}

/// Collision-safe total key for one retained statement/expression coordinate.
/// The tags prevent the two independently length-prefixed paths from merging.
fn direct_coordinate_key(statement_path: Array[Int], expression_path: Array[Int]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "S")
  direct_coordinate_key_push_path(out, statement_path)
  StringBuilder::push(out, "E")
  direct_coordinate_key_push_path(out, expression_path)
  StringBuilder::freeze(out)
}

/// Reconcile checker-return frames against authoritative retained preorder in
/// O(n log n): stable bottom-up sorts arrange complete coordinate keys, then
/// an exact merge detects missing and duplicate frames. The final assembly
/// walks the skeleton's original preorder, never checker scheduling order.
/// Any synthetic lane, skipped child, duplicate, or missing frame is invisible
/// as `None`; normal checker errors have already propagated to the caller.
fn direct_expression_return_observation_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> Option[CheckedDirectExpressionReturnObservation] {
  if !capture.complete {
    None
  } else {
    match checked_expression_structure_rows(checked.checked_stmts) {
      None => None,
      Some(skeleton) => if Array::length(skeleton) != Array::length(capture.direct_entries) {
        None
      } else {
        let skeleton_keys = array_empty()
        let direct_keys = array_empty()
        let mut i = 0
        while i < Array::length(skeleton) {
          let (statement_path, expression_path, _) = Array::get(skeleton, i)
          let (direct_statement_path, direct_expression_path, _) = Array::get(capture.direct_entries, i)
          Array::push(skeleton_keys, direct_coordinate_key(statement_path, expression_path))
          Array::push(direct_keys, direct_coordinate_key(direct_statement_path, direct_expression_path))
          i = i + 1
        }
        let skeleton_perm = sort_perm_by_names(skeleton_keys)
        let direct_perm = sort_perm_by_names(direct_keys)
        let direct_index_for_skeleton = array_empty()
        let mut fill = 0
        while fill < Array::length(skeleton) {
          Array::push(direct_index_for_skeleton, -1)
          fill = fill + 1
        }
        let mut sorted = 0
        let mut valid = true
        while sorted < Array::length(skeleton) && valid {
          let skeleton_index = Array::get(skeleton_perm, sorted)
          let direct_index = Array::get(direct_perm, sorted)
          let skeleton_key = Array::get(skeleton_keys, skeleton_index)
          let direct_key = Array::get(direct_keys, direct_index)
          let duplicate_skeleton = sorted > 0 && skeleton_key == Array::get(skeleton_keys, Array::get(skeleton_perm, sorted - 1))
          let duplicate_direct = sorted > 0 && direct_key == Array::get(direct_keys, Array::get(direct_perm, sorted - 1))
          let (statement_path, expression_path, _) = Array::get(skeleton, skeleton_index)
          let (actual_statement_path, actual_expression_path, _) = Array::get(capture.direct_entries, direct_index)
          if duplicate_skeleton || duplicate_direct || skeleton_key != direct_key || !direct_paths_equal(statement_path, actual_statement_path) || !direct_paths_equal(expression_path, actual_expression_path) {
            valid = false
          } else {
            Array::set(direct_index_for_skeleton, skeleton_index, direct_index)
          }
          sorted = sorted + 1
        }
        if valid {
          let entries = array_empty()
          let mut row = 0
          while row < Array::length(skeleton) {
            let (statement_path, expression_path, _) = Array::get(skeleton, row)
            let (_, _, ty) = Array::get(capture.direct_entries, Array::get(direct_index_for_skeleton, row))
            Array::push(entries, (copy_ints(statement_path), copy_ints(expression_path), ty))
            row = row + 1
          }
          Some(CheckedDirectExpressionReturnObservation::{
            checked_program: checked,
            entries: entries
          })
        } else {
          None
        }
      }
    }
  }
}

fn direct_expression_return_capture() -> TypedOccurrenceRoleLaneCapture {
  TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: true,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
}

/// Run the production checker once and expose retained type-definition binder
/// provenance for canonical observation.
export fn check_program_type_defs_observation(stmts: Array[Stmt]) -> CheckedProgramTypeDefsObservation with Exception {
  check_program_type_defs_observation_impl(stmts, None, None)
}

/// Observe every legacy typed-occurrence row at checker time by its owning
/// retained statement. Paths are relative only to this post-desugar
/// CheckedProgram; they are not original-source or edit-stable coordinates.
export fn check_program_typed_occurrence_statement_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceStatementObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_type_defs_observation_impl(stmts, Some(StatementTypedOccurrences(entries)), None).checked_program
  typed_occurrence_statement_observation_from_capture(checked, entries)
}

/// Capture the direct checker-returned root type for every retained
/// expression-bearing statement. Marker or alignment failures are hidden as
/// None so no partial observation escapes.
export fn check_program_statement_root_type_observation(stmts: Array[Stmt]) -> Option[CheckedStatementRootTypeObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_type_defs_observation_impl(stmts, Some(StatementRootTypes(entries)), None).checked_program
  statement_root_type_observation_from_capture(checked, entries)
}

/// Append-time role/lane capture. Failure or an alignment mismatch is hidden as
/// None, so no partial observation can escape.
export fn check_program_typed_occurrence_role_lane_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceRoleLaneObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(entries)).checked_program
  typed_occurrence_role_lane_observation_from_capture(checked, entries)
}

/// Complete-or-none structural expression-path provenance. Synthetic rewrites
/// and auxiliary resume-value rechecks deliberately make this return None.
export fn check_program_typed_occurrence_expression_path_observation(stmts: Array[Stmt]) -> Option[CheckedTypedOccurrenceExpressionPathObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(entries)).checked_program
  typed_occurrence_expression_path_observation_from_capture(checked, entries)
}

/// Opt-in complete direct-primary return observation. The bounded retained
/// skeleton is preflighted before checking; unsupported routes return None only
/// after a successful ordinary checker run.
export fn check_program_direct_expression_return_observation(stmts: Array[Stmt]) -> Option[CheckedDirectExpressionReturnObservation] with Exception {
  match checked_expression_structure_rows(stmts) {
    None => None,
    Some(_) => {
      let capture = direct_expression_return_capture()
      let checked = check_program_type_defs_observation_impl(stmts, Some(StatementDirectExpressionReturns), Some(capture)).checked_program
      direct_expression_return_observation_from_capture(checked, capture)
    }
  }
}

/// Successful production-check result, preserving the original public shape.
export fn check_program_result(stmts: Array[Stmt]) -> CheckedProgram with Exception {
  check_program_type_defs_observation_impl(stmts, None, None).checked_program
}

/// ONE process-wide entries-only capture for the Double observations, reset
/// before every use. A fresh capture per module made the bump high-water grow
/// with the SUM of every module's typed occurrences; truncating and reusing
/// the same backing arrays bounds it by the LARGEST module instead, which is
/// what keeps the wasm32 CLI-core build (already within a few MB of the 4GB
/// linear-memory ceiling) standing. The wave loop runs module checks
/// serially, and every consumer copies its answer out before the next reset.
let shared_double_call_capture: TypedOccurrenceRoleLaneCapture = double_call_result_role_lane_capture()

fn reset_double_call_capture() -> TypedOccurrenceRoleLaneCapture {
  let capture = shared_double_call_capture
  Array::truncate(capture.entries, 0)
  Array::truncate(capture.entries_flags, 0)
  Array::truncate(capture.binop_offsets, 0)
  Array::truncate(capture.binop_kinds, 0)
  Array::truncate(capture.binop_types, 0)
  Array::truncate(capture.provenance_entries, 0)
  Array::truncate(capture.statement_path, 0)
  Array::truncate(capture.frame_paths, 0)
  Array::truncate(capture.frame_next_children, 0)
  Array::truncate(capture.frame_expected_children, 0)
  Array::truncate(capture.frame_direct_recorded, 0)
  Array::truncate(capture.direct_entries, 0)
  capture.frame_depth = 0
  capture.complete = true
  capture
}

fn double_call_result_role_lane_capture() -> TypedOccurrenceRoleLaneCapture {
  TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    // Entries-only: the Double observation reads (role, lane) aligned with
    // typed_occurrences and nothing else, so the per-expression path and
    // per-occurrence provenance allocation stays off. Run once per module
    // across a compiler-sized closure, that allocation tripped the CI
    // selfcompile KPI heap gate (see the struct field's note).
    provenance_enabled: false,
    frame_depth: 0,
    complete: true
  }
}

/// Shared extraction half of the #2158 observation: retain only source-located
/// primary call results whose checker-confirmed instantiated type is Double,
/// plus the two counts that say whether the AST was located at all. `None`
/// means the capture did not line up with the typed occurrences and nothing
/// can be classified. Reads the entries-only FLAG array (one Int per
/// occurrence; see the struct's entries_flags note), not the role/lane
/// tuples -- the Double captures run with provenance_enabled = false.
fn double_call_result_offsets_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> Option[(Array[Int], Int, Int)] {
  if Array::length(capture.entries_flags) != Array::length(checked.typed_occurrences) {
    None
  } else {
    let out: Array[Int] = []
    let mut primary_calls = 0
    let mut located_primary_calls = 0
    let mut i = 0
    while i < Array::length(checked.typed_occurrences) {
      let (off, raw_ty) = Array::get(checked.typed_occurrences, i)
      // The primary-call-result test comes FIRST, and the type query is the
      // cheap head form. Both are about cost, and the cost is not
      // incidental: this loop used to resolve EVERY typed occurrence through
      // `subst_apply`, which rebuilds the whole substituted type, and then
      // throw all but the head away. On a single file that is invisible; on
      // a merged program it is quadratic, because `subst_lookup` walks a
      // substitution that grows with the program. Measured on
      // `lib/@vibe/compiler/tests/compiler_fs_test.vibe` (import closure:
      // the whole compiler), compiling it went 6.1s -> 77.5s with the old
      // shape and back to a small delta with this one.
      if Array::get(capture.entries_flags, i) == 1 {
        primary_calls = primary_calls + 1
        if off >= 0 {
          located_primary_calls = located_primary_calls + 1
          if subst_resolves_to_double(checked.final_subst, raw_ty) {
            let mut seen = false
            let mut j = 0
            while j < Array::length(out) {
              if Array::get(out, j) == off {
                seen = true
                j = Array::length(out)
              } else {
                j = j + 1
              }
            }
            if !seen {
              Array::push(out, off)
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    Some((out, primary_calls, located_primary_calls))
  }
}

/// #2391 slice 2: extract the String binop tables from the capture's side
/// arrays. Rows come in consecutive PAIRS -- one binop pushes its left and
/// right operand types under the same (anchor, kind) -- and a binop
/// classifies as String when EITHER type resolves to String under the final
/// substitution: the same either-operand rule as the desugar tracker, but
/// answered by the checker. Returns (relational anchors, `+` anchors).
///
/// An anchor claimed by MORE THAN ONE binop of the same kind is kept only
/// when every claimant classifies the same way, and POISONED otherwise
/// (Codex round 1 on #2429): the rewrite pass rewrites every same-kind binop
/// at a matching anchor, which is correct exactly when the claimants agree.
/// The channel anchor already refuses to descend into sequence/match
/// operands, so a disagreeing collision needs a shape the checker tolerates
/// with mixed types -- the poison turns any such residue into a degrade
/// (syntactic classifiers), never a wrong rewrite.
fn string_binop_offsets_from_capture(checked: CheckedProgram, capture: TypedOccurrenceRoleLaneCapture) -> (Array[Int], Array[Int]) {
  let rels: Array[Int] = []
  let pluses: Array[Int] = []
  let keys: Array[Int] = []
  let verdicts: Array[Int] = []
  let poisoned: Array[Bool] = []
  let n = Array::length(capture.binop_offsets)
  let mut i = 0
  while i + 1 < n {
    let off = Array::get(capture.binop_offsets, i)
    let kind = Array::get(capture.binop_kinds, i)
    let is_string = subst_resolves_to_string(checked.final_subst, Array::get(capture.binop_types, i)) || subst_resolves_to_string(checked.final_subst, Array::get(capture.binop_types, i + 1))
    let key = off * 4 + kind
    let verdict = if is_string {
      1
    } else {
      0
    }
    let mut idx = 0 - 1
    let mut k = 0
    while k < Array::length(keys) {
      if Array::get(keys, k) == key {
        idx = k
        k = Array::length(keys)
      } else {
        k = k + 1
      }
    }
    if idx < 0 {
      Array::push(keys, key)
      Array::push(verdicts, verdict)
      Array::push(poisoned, false)
    } else if Array::get(verdicts, idx) != verdict {
      Array::set(poisoned, idx, true)
    } else {
      ()
    }
    i = i + 2
  }
  let mut out_i = 0
  while out_i < Array::length(keys) {
    if Array::get(verdicts, out_i) == 1 && !Array::get(poisoned, out_i) {
      let key = Array::get(keys, out_i)
      let off = key / 4
      if key - off * 4 == 1 {
        Array::push(rels, off)
      } else {
        Array::push(pluses, off)
      }
    } else {
      ()
    }
    out_i = out_i + 1
  }
  (rels, pluses)
}

//# #2424: Int render/equality argument offsets

/// #2424: does `ty` resolve to `Int` under `s`, WITHOUT building the
/// substituted type?
///
/// The Double twin (`subst_resolves_to_double`, core/types.vibe) carries the
/// full argument for why this is a variable-chain walk rather than
/// `subst_apply`: asked once per candidate on a merged program, the rebuild
/// dominated everything -- 6.1s to 77.5s measured on the compiler's own import
/// closure. `CtInt` takes no arguments, so a type that is not already `CtInt`
/// at its head cannot become one by substituting inside it, and following the
/// variable chain is the whole job. Cycle handling matches `subst_apply`'s: a
/// variable already seen ends the walk instead of looping.
///
/// Local rather than a sibling export next to `subst_resolves_to_double`: it
/// has exactly one caller, in this file.
fn irc_resolves_to_int(s: Subst, ty: Type) -> Bool {
  let mut cur = ty
  let seen: Array[Int] = []
  let mut done = false
  let mut result = false
  while !done {
    match cur {
      CtInt => {
        result = true
        done = true
      },
      CtVar(vid) => {
        let mut sj = 0
        let mut already = false
        while sj < Array::length(seen) {
          if Array::get(seen, sj) == vid {
            already = true
          } else {
            ()
          }
          sj = sj + 1
        }
        if already {
          done = true
        } else {
          Array::push(seen, vid)
          match subst_lookup(s, vid) {
            Some(next) => {
              cur = next
            },
            None => {
              done = true
            }
          }
        }
      },
      _ => {
        done = true
      }
    }
  }
  result
}

/// The source offset an expression carries, or -1. Only the four
/// offset-bearing shapes an Int-rendering argument can take are listed --
/// a name, a call result, and a dot projection cover every open row in #2424
/// except the erased type variable, which has no type to look up in the first
/// place.
fn irc_expr_offset(e: Expr) -> Int {
  match e {
    EIdent(_, o) => o,
    ECall(_, _, o) => o,
    EDot(_, _, o, _) => o,
    _ => 0 - 1
  }
}

/// The builtins whose argument codegen must know is an `Int`: the renderer
/// (both spellings) and the untyped equality. `\{...}` interpolation is
/// already `__to_string` HERE -- the parser builds the call
/// (`parser_expr_primary.vibe`), so a per-module check sees it, which is what
/// makes this walk usable on the FS lane where interpolation is otherwise
/// expanded only on the merged program.
fn irc_is_render_callee(n: String) -> Bool {
  n == "__to_string" || n == "Int::to_string" || n == "eq"
}

fn irc_collect_expr(e: Expr, out: Array[Int]) -> Unit {
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(cn, _) => if irc_is_render_callee(cn) {
        let mut ai = 0
        while ai < Array::length(args) {
          let aoff = irc_expr_offset(Array::get(args, ai))
          if aoff >= 0 {
            Array::push(out, aoff)
          } else {
            ()
          }
          ai = ai + 1
        }
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
  let kids = expr_children(e)
  let mut i = 0
  while i < Array::length(kids) {
    irc_collect_expr(Array::get(kids, i), out)
    i = i + 1
  }
}

fn irc_collect_stmts(stmts: Array[Stmt], out: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, e) => irc_collect_expr(e, out),
      SLetMut(_, _, e) => irc_collect_expr(e, out),
      SLetPat(_, e) => irc_collect_expr(e, out),
      SExpr(e) => irc_collect_expr(e, out),
      STest(_, e) => irc_collect_expr(e, out),
      SBench(_, e) => irc_collect_expr(e, out),
      // `parse_program` lowers `SExample` to `STest` before anything checks
      // the program, so this arm is inert on every compile path today
      // (measured: a render of an `Array::get` result inside an `example`
      // block already answers correctly). It is here so the walk does not
      // depend on that ordering -- `parse_program_preserving` keeps the
      // variant, and an executable block form must not be silently skipped.
      SExample(_, e) => irc_collect_expr(e, out),
      // A render inside a nested module is checked with the rest of the
      // program and its occurrences are in the same table, so skipping the
      // body would leave that code with no classification at all (Codex
      // review on #2434). `count_call_offsets_stmts` recurses the same way.
      SModule(_, _, inner) => irc_collect_stmts(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

/// Insertion-sorted unique copy. The candidate set is one entry per render or
/// `eq` argument in the module, so it is small enough for an insertion sort
/// and the sort is what keeps the scan below off a quadratic path: one binary
/// search per typed occurrence instead of one linear membership test.
fn irc_sorted_unique(xs: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(xs) {
    let v = Array::get(xs, i)
    let mut lo = 0
    let mut hi = Array::length(out)
    while lo < hi {
      let mid = (lo + hi) / 2
      if Array::get(out, mid) < v {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let dup = lo < Array::length(out) && Array::get(out, lo) == v
    if dup {
      ()
    } else {
      Array::push(out, v)
      let mut j = Array::length(out) - 1
      while j > lo {
        Array::set(out, j, Array::get(out, j - 1))
        j = j - 1
      }
      Array::set(out, lo, v)
    }
    i = i + 1
  }
  out
}

fn irc_index_of(sorted: Array[Int], v: Int) -> Int {
  let mut lo = 0
  let mut hi = Array::length(sorted)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(sorted, mid) < v {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(sorted) && Array::get(sorted, lo) == v {
    lo
  } else {
    0 - 1
  }
}

/// #2424: the source offsets of expressions that a render (`__to_string` /
/// `Int::to_string`) or `eq` call takes as an argument AND whose
/// checker-confirmed type is `Int`.
///
/// This is the answer codegen cannot compute for itself. Both lanes classify a
/// render argument syntactically -- `ts_known_int` on linear,
/// `bc_expr_is_intish` on gc -- from a slot log seeded at binding sites, so
/// correctness is exactly the set of binding forms someone remembered to seed,
/// and everything else renders the empty string with no diagnostic. The type is
/// already computed right here; this hands it over instead of asking codegen to
/// re-derive it.
///
/// FAIL CLOSED on disagreement. An offset can carry more than one typed
/// occurrence (a dot-call receiver and its result share one), so an offset is
/// emitted only when it has at least one occurrence and EVERY occurrence there
/// resolves to `Int`. A candidate with no occurrence at all -- which is what an
/// unlocated `parse_program(lex(source))` AST produces for the whole program --
/// is simply absent, and an absent offset classifies nothing, leaving the
/// pre-existing syntactic answer exactly as it was.
export fn checked_int_render_offsets(checked: CheckedProgram) -> Array[Int] {
  let raw: Array[Int] = []
  irc_collect_stmts(checked.checked_stmts, raw)
  let cands = irc_sorted_unique(raw)
  let n = Array::length(cands)
  if n == 0 {
    []
  } else {
    let seen_any: Array[Int] = []
    let all_int: Array[Int] = []
    let mut k = 0
    while k < n {
      Array::push(seen_any, 0)
      Array::push(all_int, 1)
      k = k + 1
    }
    let mut oi = 0
    while oi < Array::length(checked.typed_occurrences) {
      let (ooff, oty) = Array::get(checked.typed_occurrences, oi)
      if ooff >= 0 {
        let idx = irc_index_of(cands, ooff)
        if idx >= 0 {
          Array::set(seen_any, idx, 1)
          if irc_resolves_to_int(checked.final_subst, oty) {
            ()
          } else {
            Array::set(all_int, idx, 0)
          }
        } else {
          ()
        }
      } else {
        ()
      }
      oi = oi + 1
    }
    let out: Array[Int] = []
    let mut m = 0
    while m < n {
      if Array::get(seen_any, m) == 1 && Array::get(all_int, m) == 1 {
        Array::push(out, Array::get(cands, m))
      } else {
        ()
      }
      m = m + 1
    }
    out
  }
}

/// #2391 slice 2: the typed-lowering channel's value encoding. One table
/// carries all three per-module channels so the memo/sidecar/rebase carrier
/// stays a flat Array[Int]: enc = offset * 4 + tag, with tag 0 = Double call
/// result, 1 = String relational binop anchor, 2 = String `+` binop anchor.
/// Rebasing a module table by a merge base B therefore adds B * 4. The
/// decoder lives in file_compile's split; keep the two in lockstep.
export fn typed_lowering_enc(offset: Int, tag: Int) -> Int {
  offset * 4 + tag
}

export fn typed_lowering_enc_offset(enc: Int) -> Int {
  enc / 4
}

export fn typed_lowering_enc_tag(enc: Int) -> Int {
  enc - (enc / 4) * 4
}

/// Check once and retain only source-located primary call results whose
/// checker-confirmed instantiated type is Double, plus the two counts that say
/// whether the AST was located at all: how many primary call results the
/// program has, and how many of those carry a source offset.
///
/// The counts exist because an EMPTY offset array is ambiguous. `check_program`
/// records an occurrence for every primary call result either way, but
/// `tab_call_ty` (checker.vibe) only files one under an offset when that offset
/// is `>= 0` -- so an AST built by `parse_program(lex(source))` produces an
/// empty table BY CONSTRUCTION, indistinguishable from a program that simply
/// has no Double call results. A caller that cannot tell those apart wires the
/// channel up green and inert; `check_program_double_call_result_located_observation`
/// below is the caller-facing form that refuses the first case.
fn check_program_double_call_result_observation_impl(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int], Int, Int)] with Exception {
  let capture = reset_double_call_capture()
  let checked = check_program_type_defs_observation_impl(stmts, None, Some(capture)).checked_program
  match double_call_result_offsets_from_capture(checked, capture) {
    None => None,
    Some((out, primary_calls, located_primary_calls)) => Some((checked, out, primary_calls, located_primary_calls))
  }
}

/// #2391: the modular form of the #2158 observation, for the per-module check
/// the FS lanes already run (check_module). One checker invocation answers
/// both questions: the CheckedProgram every consumer of the module check needs,
/// and this module's typed-lowering table -- Double call-result offsets plus
/// String relational/`+` binop anchors, tag-encoded per typed_lowering_enc,
/// in the module's OWN offset space (the FS merge rebases them per file
/// before consumption).
///
/// The table is `None` exactly when the located form below would refuse the
/// channel: the program has primary call results and not one is located (an
/// unlocated `parse_program(lex(source))` AST), or the capture did not line up.
/// `Some([])` stays the honest "located, and nothing classifies".
///
/// `initial_env` follows check_module's two production entries: `EnvEmpty`
/// delegates to the plain whole-program check, anything else takes the
/// projected-import-env path (`imports_already_projected`), so the checked
/// program is identical to what check_program_result /
/// check_program_with_projected_import_env_result produce today.
export fn check_program_with_projected_import_env_typed_lowering_located_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> (CheckedProgram, Option[Array[Int]]) with Exception {
  let capture = reset_double_call_capture()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(capture), true).checked_program
  match double_call_result_offsets_from_capture(checked, capture) {
    None => (checked, None),
    Some((out, primary_calls, located_primary_calls)) => if primary_calls > 0 && located_primary_calls == 0 {
      (checked, None)
    } else {
      // #2391 slice 2: one encoded table carries the Double call-result
      // offsets (tag 0) and the String relational/`+` binop anchors
      // (tags 1/2) -- see typed_lowering_enc. The located-channel refusal
      // above is decided by the Double half alone: it observes every module
      // the same way (a flag per typed occurrence), so "primary calls exist
      // and none is located" identifies an unlocated AST for the String
      // half too.
      let (rels, pluses) = string_binop_offsets_from_capture(checked, capture)
      let enc: Array[Int] = []
      let mut fi = 0
      while fi < Array::length(out) {
        Array::push(enc, typed_lowering_enc(Array::get(out, fi), 0))
        fi = fi + 1
      }
      let mut ri = 0
      while ri < Array::length(rels) {
        Array::push(enc, typed_lowering_enc(Array::get(rels, ri), 1))
        ri = ri + 1
      }
      let mut pi = 0
      while pi < Array::length(pluses) {
        Array::push(enc, typed_lowering_enc(Array::get(pluses, pi), 2))
        pi = pi + 1
      }
      // #2424: tag 3 -- render (`__to_string` / `Int::to_string`) and `eq`
      // ARGUMENT offsets the checker typed as `Int`. Riding this table rather
      // than a second one is the whole point of the slice-2 encoding: the
      // memo, the sidecar, the per-file rebase and the reuse arms are already
      // built and already require the sidecar before skipping a check.
      let int_renders = checked_int_render_offsets(checked)
      let mut ii = 0
      while ii < Array::length(int_renders) {
        Array::push(enc, typed_lowering_enc(Array::get(int_renders, ii), 3))
        ii = ii + 1
      }
      (checked, Some(enc))
    }
  }
}

/// Check once and retain only source-located primary call results whose
/// checker-confirmed instantiated type is Double. Offset alone is not enough:
/// a dot-call receiver and its non-Double result can share the same offset.
export fn check_program_double_call_result_observation(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int])] with Exception {
  match check_program_double_call_result_observation_impl(stmts) {
    None => None,
    Some((checked, out, _, _)) => Some((checked, out))
  }
}

/// #2158: the same observation with an explicit "this AST carried source
/// offsets" signal, for callers that would otherwise silently accept an inert
/// channel.
///
/// `None` means the offset space is UNUSABLE -- the program has primary call
/// results and not one of them is located, which is exactly what an unlocated
/// `parse_program(lex(source))` produces. `Some((checked, []))` still means the
/// honest "located, and no call result is a Double". A program with no calls at
/// all is located-vacuously and answers `Some((checked, []))` too; an empty set
/// classifies nothing either way, so that direction cannot be wrong.
export fn check_program_double_call_result_located_observation(stmts: Array[Stmt]) -> Option[(CheckedProgram, Array[Int])] with Exception {
  match check_program_double_call_result_observation_impl(stmts) {
    None => None,
    Some((checked, out, primary_calls, located_primary_calls)) => if primary_calls > 0 && located_primary_calls == 0 {
      None
    } else {
      Some((checked, out))
    }
  }
}

/// Compatibility API: preserve the historical TypeEnv result and error
/// behavior while delegating through the successful production result.
export fn check_program(stmts: Array[Stmt]) -> TypeEnv with Exception {
  check_program_result(stmts).final_env
}

/// Collecting variant of check_program for typed hover (vibe type-at): runs the
/// same inference but RETURNS the recorded (offset, Type) table plus the FINAL
/// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades
/// gracefully: any type error is swallowed and whatever table was collected so
/// far is returned, so hovering inside a partially-bad file still resolves the
/// names that were checked before the error. The table holds RAW (pre-final
/// subst) types; callers resolve via subst_apply(finalSubst, ty).
export fn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with Exception {
  derive_trait_namespace_operations(stmts)
  let empty_defs = array_empty()
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = array_empty()
  handle {
    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
    (tytab, final_s)
  } with { Exception::Throw(_) => (tytab, SubstEmpty) }
}

/// As `check_program_result`, seeded with an importing module's environment.
/// The non-empty path intentionally keeps the existing imported-module checks
/// and error behavior unchanged.
fn check_program_with_env_type_defs_observation_impl(stmts: Array[Stmt], initial_env: TypeEnv, capture: Option[CheckerStatementCapture], role_lane_capture: Option[TypedOccurrenceRoleLaneCapture], imports_already_projected: Bool) -> CheckedProgramTypeDefsObservation with Exception {
  match initial_env {
    EnvEmpty => check_program_type_defs_observation_impl(stmts, capture, role_lane_capture),
    _ => {
      let errors = ArrayBuilder::new()
      let frozen_errors = ArrayBuilder::freeze(errors)
      push_error_strings(collect_trait_namespace_conflict_errors(stmts, initial_env), frozen_errors)
      derive_imported_trait_namespace_operations(stmts, initial_env)
      derive_trait_namespace_operations(stmts)
      inject_trait_method_generics(stmts)
      // #635: lower `let*`/`?` railway sentinels before checking (see
      // check_program). This path checks each imported/entry file pre-codegen.
      desugar_railway_binds(stmts)
      check_import_kinds(stmts, initial_env, frozen_errors)
      canonicalize_stdin_provider_type_import_heads(stmts)
      collect_stdin_provider_direct_call_errors(stmts, frozen_errors)
      // #1455 step 3: see check_program.
      let qualified_pattern_refs = collect_qualified_pattern_refs(stmts)
      // #1001: mixed argument-mode validation before desugar (see check_program).
      check_labeled_arg_names_stmts(stmts, frozen_errors, true)
      // #986: reorder fully-labeled calls before checking (see check_program).
      desugar_labeled_args(stmts)
      // #1571: see check_program.
      desugar_inspect_calls(stmts)
      // #2141: loud guard at the binder, before checking -- see the pass doc.
      collect_type_param_shadowing_errors(stmts, frozen_errors)
      let empty_defs = array_empty()
      let type_def_binders = array_empty()
      // #1455: register the imported enums BEFORE checking, so
      // `Enum::Variant`, exhaustiveness and pattern-payload checking all see
      // the same `TDEnum`s a same-file declaration would have produced.
      // `seed_next_c` is the first type-variable id seeding did NOT consume;
      // checking has to start there or a parameterized imported enum's formals
      // would be handed out a second time.
      let (local_defs_start, seed_next_c) = seed_imported_type_defs(stmts, initial_env, empty_defs, type_def_binders)
      let cached_env = env_cache(initial_env)
      let seeded_raw_env = if trait_defined(cached_env, "Eq") {
        cached_env
      } else {
        register_builtin_traits(cached_env)
      }
      let seeded_env = env_cache(seeded_raw_env)
      let tytab = array_empty()
      // #986: labeled-argument name validation (see check_program).
      check_labeled_arg_names_stmts(stmts, frozen_errors, false)
      // Keep CheckedProgram.checked_stmts as the original post-desugar source,
      // but match the ordinary path by checking and validating an expanded copy.
      let expanded_stmts = es_expand_top_level_effectset_rows(stmts, initial_env)
      let statement_parent_path = match capture {
        Some(_) => Some(array_empty()),
        None => match role_lane_capture {
          Some(_) => Some(array_empty()),
          None => None
        }
      }
      let (env, final_s, _) = check_stmts_with_binders(expanded_stmts, 0, seeded_env, empty_defs, type_def_binders, local_defs_start, SubstEmpty, seed_next_c, frozen_errors, tytab, statement_parent_path, capture, role_lane_capture, imports_already_projected, true)
      // Selected import projection carries trait definitions and impls into
      // this environment, so user-trait bounds are checked here with the same
      // rule as the standalone path.
      check_program_bounds(env, final_s, empty_defs, frozen_errors)
      // #1858: same witness-carrier validation as the standalone path — the
      // projected env supplies imported traits' method tables, so a module
      // using an imported method-bearing trait (e.g. @vibe/core's Default)
      // is covered too.
      push_error_strings(collect_undispatchable_trait_method_errors(stmts, env), frozen_errors)
      collect_async_effect_errors(expanded_stmts, env, frozen_errors)
      // #1455 step 3: `empty_defs` holds the imported enums seeded above plus
      // this module's own, which is exactly the set a qualifier may name.
      check_qualified_pattern_refs(qualified_pattern_refs, empty_defs, frozen_errors)
      if Array::length(frozen_errors) > 0 {
        throw(Array::get(frozen_errors, 0))
      }
      // #1947: see the standalone path — marker is gone before codegen.
      erase_railway_origin_markers(stmts)
      CheckedProgramTypeDefsObservation::{
        checked_program: CheckedProgram::{
          checked_stmts: stmts,
          final_env: env,
          type_defs: empty_defs,
          final_subst: final_s,
          typed_occurrences: tytab
        },
        type_def_binders: type_def_binders
      }
    }
  }
}

/// Run the production checker once with an initial environment and expose
/// retained type-definition binder provenance for canonical observation.
export fn check_program_with_env_type_defs_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgramTypeDefsObservation with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, false)
}

/// As the ordinary statement-owner observation, seeded with an importing
/// environment. Validation failure is fail-closed as None.
export fn check_program_with_env_typed_occurrence_statement_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceStatementObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementTypedOccurrences(entries)), None, false).checked_program
  typed_occurrence_statement_observation_from_capture(checked, entries)
}

/// With-env form of the direct root-type observation. The initial environment
/// seeds checking only; nested module environments remain lexical.
export fn check_program_with_env_statement_root_type_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedStatementRootTypeObservation] with Exception {
  let entries = array_empty()
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementRootTypes(entries)), None, false).checked_program
  statement_root_type_observation_from_capture(checked, entries)
}

export fn check_program_with_env_typed_occurrence_role_lane_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceRoleLaneObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(entries), false).checked_program
  typed_occurrence_role_lane_observation_from_capture(checked, entries)
}

export fn check_program_with_env_typed_occurrence_expression_path_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedTypedOccurrenceExpressionPathObservation] with Exception {
  let entries = TypedOccurrenceRoleLaneCapture::{
    entries: array_empty(),
    entries_flags: array_empty(),
    binop_offsets: array_empty(),
    binop_kinds: array_empty(),
    binop_types: array_empty(),
    provenance_entries: array_empty(),
    statement_path: array_empty(),
    frame_paths: array_empty(),
    frame_next_children: array_empty(),
    frame_expected_children: array_empty(),
    frame_direct_recorded: array_empty(),
    direct_entries: array_empty(),
    direct_enabled: false,
    provenance_enabled: true,
    frame_depth: 0,
    complete: true
  }
  let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, Some(entries), false).checked_program
  typed_occurrence_expression_path_observation_from_capture(checked, entries)
}

fn binder_scope_lookup(scope: Array[SourceBinder], name: String) -> Option[SourceBinder] {
  let mut i = Array::length(scope)
  let mut found = None
  while i > 0 && match found {
    Some(_) => false,
    None => true
  } {
    i = i - 1
    let binder = Array::get(scope, i)
    match binder {
      SourceToken(n, _, _) => if n == name {
        found = Some(binder)
      } else {
        ()
      },
      Synthetic(n, _) => if n == name {
        found = Some(binder)
      } else {
        ()
      }
    }
  }
  found
}

fn binder_scope_push(scope: Array[SourceBinder], binder: SourceBinder) -> Array[SourceBinder] {
  let next = Array::slice(scope, 0, Array::length(scope))
  Array::push(next, binder)
  next
}

fn binder_first_slot(node: BinderAuthorityNode) -> Option[SourceBinder] {
  let slots = binder_authority_node_slots(node)
  if Array::length(slots) == 0 {
    None
  } else {
    Some(binder_authority_slot_binder(Array::get(slots, 0)))
  }
}

fn collect_pattern_binders(node: BinderAuthorityNode, out: Array[SourceBinder]) -> Unit {
  let slots = binder_authority_node_slots(node)
  let mut i = 0
  while i < Array::length(slots) {
    Array::push(out, binder_authority_slot_binder(Array::get(slots, i)))
    i = i + 1
  }
  let children = binder_authority_node_children(node)
  let mut j = 0
  while j < Array::length(children) {
    collect_pattern_binders(Array::get(children, j), out)
    j = j + 1
  }
}

fn walk_binder_match_like(head: Expr, arms: Array[(Pat, Expr)], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let achildren = binder_authority_node_children(node)
  let n = Array::length(arms)
  if Array::length(achildren) != 1 + 2 * n {
    false
  } else {
    let mut ok = walk_binder_expr(head, Array::get(achildren, 0), scope, out)
    let mut i = 0
    while i < n && ok {
      let pat_node = Array::get(achildren, 1 + 2 * i)
      let body_node = Array::get(achildren, 2 + 2 * i)
      let (_, body) = Array::get(arms, i)
      let binders = array_empty()
      collect_pattern_binders(pat_node, binders)
      let mut inner = scope
      let mut bi = 0
      while bi < Array::length(binders) {
        inner = binder_scope_push(inner, Array::get(binders, bi))
        bi = bi + 1
      }
      ok = walk_binder_expr(body, body_node, inner, out)
      i = i + 1
    }
    ok
  }
}

fn walk_binder_for_in(iter: Expr, body: Expr, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let achildren = binder_authority_node_children(node)
  let slots = binder_authority_node_slots(node)
  if Array::length(achildren) != 2 || Array::length(slots) == 0 {
    false
  } else {
    if walk_binder_expr(iter, Array::get(achildren, 0), scope, out) {
      let mut inner = scope
      let mut i = 0
      while i < Array::length(slots) {
        inner = binder_scope_push(inner, binder_authority_slot_binder(Array::get(slots, i)))
        i = i + 1
      }
      walk_binder_expr(body, Array::get(achildren, 1), inner, out)
    } else {
      false
    }
  }
}

fn walk_binder_expr(expr: Expr, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  let children = expr_children(expr)
  let achildren = binder_authority_node_children(node)
  match expr {
    EIdent(name, off) => match binder_scope_lookup(scope, name) {
      Some(SourceToken(_, start, end)) => {
        if off >= 0 {
          Array::push(out, (off, start, end))
        } else {
          ()
        }
        true
      },
      // Lowering-only identifiers have no source occurrence to publish. A
      // source-located use resolving to a synthetic binder would be an
      // unsupported provenance lane and must invalidate the observation.
      Some(Synthetic(_, _)) => off < 0,
      None => true
    },
    ELet(_, _, _, _) => walk_binder_let_like(children, achildren, node, scope, out, false),
    ELetMut(_, _, _, _) => walk_binder_let_like(children, achildren, node, scope, out, false),
    ELetRec(_, _, _) => walk_binder_let_like(children, achildren, node, scope, out, true),
    EFn(_, _, _, _, _, _) => walk_binder_fn(children, achildren, node, scope, out),
    EMatch(scrut, arms) => walk_binder_match_like(scrut, arms, node, scope, out),
    EHandle(body, arms) => walk_binder_match_like(body, arms, node, scope, out),
    EForIn(_, _, iter, body) => walk_binder_for_in(iter, body, node, scope, out),
    ELoop(_, _) => false,
    _ => {
      if Array::length(children) != Array::length(achildren) {
        false
      } else {
        let mut i = 0
        let mut ok = true
        while i < Array::length(children) && ok {
          ok = walk_binder_expr(Array::get(children, i), Array::get(achildren, i), scope, out)
          i = i + 1
        }
        ok
      }
    }
  }
}

fn walk_binder_let_like(children: Array[Expr], achildren: Array[BinderAuthorityNode], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)], recursive: Bool) -> Bool {
  if Array::length(children) != 2 || Array::length(achildren) != 2 {
    false
  } else {
    match binder_first_slot(node) {
      Some(binder) => {
        let inner = binder_scope_push(scope, binder)
        let value_scope = if recursive {
          inner
        } else {
          scope
        }
        walk_binder_expr(Array::get(children, 0), Array::get(achildren, 0), value_scope, out) && walk_binder_expr(Array::get(children, 1), Array::get(achildren, 1), inner, out)
      },
      None => false
    }
  }
}

fn walk_binder_fn(children: Array[Expr], achildren: Array[BinderAuthorityNode], node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> Bool {
  if Array::length(children) == 0 || Array::length(achildren) != Array::length(children) {
    false
  } else {
    let mut inner = scope
    let slots = binder_authority_node_slots(node)
    let mut si = 0
    while si < Array::length(slots) {
      inner = binder_scope_push(inner, binder_authority_slot_binder(Array::get(slots, si)))
      si = si + 1
    }
    let mut i = 0
    let mut ok = true
    let last = Array::length(children) - 1
    while i < Array::length(children) && ok {
      let child_scope = if i == last {
        inner
      } else {
        scope
      }
      ok = walk_binder_expr(Array::get(children, i), Array::get(achildren, i), child_scope, out)
      i = i + 1
    }
    ok
  }
}

fn walk_binder_stmt(stmt: Stmt, node: BinderAuthorityNode, scope: Array[SourceBinder], out: Array[(Int, Int, Int)]) -> (Bool, Array[SourceBinder]) {
  match stmt {
    SLet(_, _, _, _, value) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 1 {
          (false, scope)
        } else {
          let ok = walk_binder_expr(value, Array::get(children, 0), scope, out)
          (ok, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    SLetMut(_, _, value) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 1 {
          (false, scope)
        } else {
          let ok = walk_binder_expr(value, Array::get(children, 0), scope, out)
          (ok, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    SExpr(value) => {
      let children = binder_authority_node_children(node)
      if Array::length(children) != 1 {
        (false, scope)
      } else {
        (walk_binder_expr(value, Array::get(children, 0), scope, out), scope)
      }
    },
    SImport(_, _) => {
      let children = binder_authority_node_children(node)
      if Array::length(children) != 0 {
        (false, scope)
      } else {
        let slots = binder_authority_node_slots(node)
        let mut next = scope
        let mut i = 0
        while i < Array::length(slots) {
          next = binder_scope_push(next, binder_authority_slot_binder(Array::get(slots, i)))
          i = i + 1
        }
        (true, next)
      }
    },
    SAliasDecl(_, _) => match binder_first_slot(node) {
      Some(binder) => {
        let children = binder_authority_node_children(node)
        if Array::length(children) != 0 {
          (false, scope)
        } else {
          (true, binder_scope_push(scope, binder))
        }
      },
      None => (false, scope)
    },
    _ => (false, scope)
  }
}

/// #1957: checker occurrence provenance from validated parser authority.
/// Each local identifier use is `(use_offset, binder_start, binder_end)`.
/// Distinct binders with the same name stay distinct. Free/builtin names
/// are not claimed. Shape mismatch fails closed.
export fn check_program_binder_occurrence_observation(authority: LocatedProgramBinderAuthority) -> Option[Array[(Int, Int, Int)]] with Exception {
  let program = located_program_binder_authority_program(authority)
  let roots = located_program_binder_authority_nodes(authority)
  if Array::length(roots) != Array::length(program) {
    None
  } else {
    let out = array_empty()
    let mut scope = array_empty()
    let mut i = 0
    let mut ok = true
    while i < Array::length(program) && ok {
      let walked = walk_binder_stmt(Array::get(program, i), Array::get(roots, i), scope, out)
      ok = walked.0
      scope = walked.1
      i = i + 1
    }
    if ok {
      Some(out)
    } else {
      None
    }
  }
}

/// With-env variant of the complete direct-primary return observation.
export fn check_program_with_env_direct_expression_return_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> Option[CheckedDirectExpressionReturnObservation] with Exception {
  match checked_expression_structure_rows(stmts) {
    None => None,
    Some(_) => {
      let capture = direct_expression_return_capture()
      let checked = check_program_with_env_type_defs_observation_impl(stmts, initial_env, Some(StatementDirectExpressionReturns), Some(capture), false).checked_program
      direct_expression_return_observation_from_capture(checked, capture)
    }
  }
}

/// Successful production-check result, preserving the original public shape.
export fn check_program_with_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, false).checked_program
}

/// Production-only checker entry for an environment already projected from
/// this root module's import declarations. Root import statements must not
/// replay type-only bindings over that authoritative environment; nested
/// modules deliberately retain the historical replay path.
export fn check_program_with_projected_import_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with Exception {
  check_program_with_env_type_defs_observation_impl(stmts, initial_env, None, None, true).checked_program
}

/// Compatibility API: preserve the historical TypeEnv result and error
/// behavior while delegating through the successful production result.
export fn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with Exception {
  check_program_with_env_result(stmts, initial_env).final_env
}

//# Import-usage / discarded-value diagnostics (#1129, and the companion
// "unbound non-Unit return value" request from the same batch). Both are
// syntactic-plus-type-table post-passes over an already-parsed/checked
// program, kept in THIS file (not checker_warning.vibe, which lives in the
// top-level @vibe/compiler package) so `collect_all_diagnostics`
// (runtime/typecheck_fs.vibe, already a `@vibe/compiler/checker` consumer
// via check_program/check_program_type_table) can reach them without
// introducing a cross-package import back from a subpackage into the
// top-level package (the direction checker_trait.vibe's relocation into
// this package, noted above, was moved to avoid).

fn warning_names_contains(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, i) == s {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

fn push_ref_name(out: Array[String], name: String) -> Unit {
  if warning_names_contains(out, name) {
    ()
  } else {
    Array::push(out, name)
  }
}

/// Every name referenced in `te`'s type positions (`TyName`/`TyApp`'s own
/// name, plus recursively into `TyApp` args, `TyFn` params/return, and
/// `TyTuple` members) -- so an imported `type X` counted "used" only via a
/// type ANNOTATION (e.g. `fn f(x: X) -> Unit`) is not misreported as unused
/// just because it never appears as a value-position `EIdent`.
fn collect_texpr_ref_names(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyName(name) => push_ref_name(out, name),
    TyApp(name, args) => {
      push_ref_name(out, name)
      let mut i = 0
      while i < Array::length(args) {
        collect_texpr_ref_names(Array::get(args, i), out)
        i = i + 1
      }
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        collect_texpr_ref_names(Array::get(params, i), out)
        i = i + 1
      }
      collect_texpr_ref_names(ret, out)
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_texpr_ref_names(Array::get(items, i), out)
        i = i + 1
      }
    },
    TyUnit => ()
  }
}

fn collect_opt_texpr_ref_names(ty: Option[TypeExpr], out: Array[String]) -> Unit {
  match ty {
    Some(te) => collect_texpr_ref_names(te, out),
    None => ()
  }
}

/// Every `EIdent` name reachable from `expr` (value-position references,
/// including qualified `Type::method` spellings -- the parser already folds
/// those into a single `EIdent("Type::method", off)`, see
/// parser_expr_primary.vibe), PLUS every type name reachable through an
/// `EFn`'s own parameter/return annotations, an `ERecord`'s own type name
/// and explicit type-argument list -- both otherwise invisible to a
/// value-only walk. `bound` is the stack of names currently shadowed by an
/// enclosing binder (function param, `let`/`let rec`/`let mut`, `for`/`loop`
/// var, or match/handle pattern bind) -- an `EIdent` matching one of these is
/// a reference to the LOCAL binding, never the import, so it must not count
/// (Codex review on #1204: a param named the same as an imported value used
/// to suppress that import's own unused warning). Each scope-introducing
/// case pushes its bound name(s) before recursing into the scope they cover
/// and truncates back to the saved length afterward, so a name is only
/// shadowed for the span of code it actually covers.
fn collect_referenced_names_expr(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match expr {
    EIdent(name, _) => if labeled_walk_shadowed(bound, name) {
      ()
    } else {
      push_ref_name(out, name)
    },
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EUnit => (),
    EBreak(opt) => match opt {
      Some(e) => collect_referenced_names_expr(e, bound, out),
      None => ()
    },
    EContinue(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_referenced_names_expr(Array::get(items, i), bound, out)
        i = i + 1
      }
    },
    EReturn(e) => collect_referenced_names_expr(e, bound, out),
    EUnaryOp(_, e) => collect_referenced_names_expr(e, bound, out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_referenced_names_expr(Array::get(items, i), bound, out)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_referenced_names_expr(Array::get(items, i), bound, out)
        i = i + 1
      }
    },
    ERecord(name, fields, targs) => {
      // #1204 Codex review: the record's OWN name (`Type::{ .. }`) is a real
      // reference to `Type` -- struct/enum names are top-level-only (never
      // locally bound), so no `bound` check applies here.
      push_ref_name(out, name)
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_referenced_names_expr(val, bound, out)
        i = i + 1
      }
      let mut ti = 0
      while ti < Array::length(targs) {
        collect_texpr_ref_names(Array::get(targs, ti), out)
        ti = ti + 1
      }
    },
    EBinOp(_, l, r) => {
      collect_referenced_names_expr(l, bound, out)
      collect_referenced_names_expr(r, bound, out)
    },
    ECall(callee, args, _) => {
      collect_referenced_names_expr(callee, bound, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_referenced_names_expr(Array::get(args, i), bound, out)
        i = i + 1
      }
    },
    EIf(cond, then_e, else_e) => {
      collect_referenced_names_expr(cond, bound, out)
      collect_referenced_names_expr(then_e, bound, out)
      collect_referenced_names_expr(else_e, bound, out)
    },
    ELet(name, val, body, _) => {
      // `val` is evaluated BEFORE `name` is bound (not visible to itself).
      collect_referenced_names_expr(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetRec(name, val, body) => {
      // Recursive: `name` is visible in its OWN value too.
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_referenced_names_expr(val, bound, out)
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    ELetMut(name, val, body, _) => {
      collect_referenced_names_expr(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    EAssign(_, val, body) => {
      collect_referenced_names_expr(val, bound, out)
      collect_referenced_names_expr(body, bound, out)
    },
    EAssignOp(_, _, val, body) => {
      collect_referenced_names_expr(val, bound, out)
      collect_referenced_names_expr(body, bound, out)
    },
    ESeq(l, r) => {
      collect_referenced_names_expr(l, bound, out)
      collect_referenced_names_expr(r, bound, out)
    },
    EMatch(scr, arms) => {
      collect_referenced_names_expr(scr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let mark = Array::length(bound)
        labeled_walk_pat_binds(pat, bound)
        collect_referenced_names_expr(body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
    },
    EHandle(body_expr, arms) => {
      collect_referenced_names_expr(body_expr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let mark = Array::length(bound)
        labeled_walk_pat_binds(pat, bound)
        collect_referenced_names_expr(arm_body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
    },
    EWhile(cond, body) => {
      collect_referenced_names_expr(cond, bound, out)
      collect_referenced_names_expr(body, bound, out)
    },
    ELoop(params, body) => {
      // Every init is evaluated against the OUTER scope (no loop var is
      // visible to any init, including its own), then all loop vars come
      // into scope together for `body`.
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        collect_referenced_names_expr(init, bound, out)
        i = i + 1
      }
      let mut j = 0
      while j < Array::length(params) {
        let (pname, _) = Array::get(params, j)
        Array::push(bound, pname)
        j = j + 1
      }
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    EForIn(name, idx_opt, iter, body) => {
      // #1205 Codex review: `for x, i in items { .. }` binds BOTH the item
      // name and the optional index name as loop locals -- only pushing
      // `name` let an import shadowed solely by the index (`i` above) keep
      // reading as "used" via the body's own reference to its own index var.
      collect_referenced_names_expr(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match idx_opt {
        Some(idx) => Array::push(bound, idx),
        None => ()
      }
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    EFn(_, _, params, ret, _, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, pty) = Array::get(params, i)
        collect_opt_texpr_ref_names(pty, out)
        Array::push(bound, labeled_param_base_name(pname))
        i = i + 1
      }
      collect_opt_texpr_ref_names(ret, out)
      collect_referenced_names_expr(body, bound, out)
      Array::truncate(bound, mark)
    },
    EDot(obj, _, _, _) => collect_referenced_names_expr(obj, bound, out),
    ELabeledArg(_, _, e) => collect_referenced_names_expr(e, bound, out),
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_referenced_names_expr(val, bound, out)
        i = i + 1
      }
    },
    ESpread(e) => collect_referenced_names_expr(e, bound, out),
    EStringInterp(_) => ()
  }
}

fn collect_referenced_names_expr_top(expr: Expr, out: Array[String]) -> Unit {
  collect_referenced_names_expr(expr, array_empty(), out)
}

/// Broader than check_stmts' own local hoist walks: every place a name from
/// an `import`/`import @pkg @alias` could legitimately be referenced --
/// value positions in every statement kind that carries an `Expr`, PLUS type
/// positions in struct/enum/suberror field types, a type alias's own
/// target, trait method signatures, extern-let/effect-op types, and
/// (recursively) nested `SModule` bodies.
fn collect_referenced_names_stmts(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, ann, val) => {
        collect_opt_texpr_ref_names(ann, out)
        collect_referenced_names_expr_top(val, out)
      },
      SLetMut(_, ann, val) => {
        collect_opt_texpr_ref_names(ann, out)
        collect_referenced_names_expr_top(val, out)
      },
      SLetPat(_, val) => collect_referenced_names_expr_top(val, out),
      SEnum(_, _, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (_, vtypes) = Array::get(variants, vi)
          let mut ti = 0
          while ti < Array::length(vtypes) {
            collect_texpr_ref_names(Array::get(vtypes, ti), out)
            ti = ti + 1
          }
          vi = vi + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (_, vtypes) = Array::get(variants, vi)
          let mut ti = 0
          while ti < Array::length(vtypes) {
            collect_texpr_ref_names(Array::get(vtypes, ti), out)
            ti = ti + 1
          }
          vi = vi + 1
        }
      },
      SStruct(_, _, fields, _, _, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fty) = Array::get(fields, fi)
          collect_texpr_ref_names(fty, out)
          fi = fi + 1
        }
      },
      STypeAlias(_, _, _, te) => collect_texpr_ref_names(te, out),
      STrait(_, _, _, methods, _, _) => {
        let mut mi = 0
        while mi < Array::length(methods) {
          let (_, ptypes, rty) = Array::get(methods, mi)
          let mut pi = 0
          while pi < Array::length(ptypes) {
            collect_texpr_ref_names(Array::get(ptypes, pi), out)
            pi = pi + 1
          }
          collect_texpr_ref_names(rty, out)
          mi = mi + 1
        }
      },
      SExternLet(_, te) => collect_texpr_ref_names(te, out),
      SEffectDef(_, _, _, ops) => {
        let mut oi = 0
        while oi < Array::length(ops) {
          let (_, ptypes, rty) = Array::get(ops, oi)
          let mut pi = 0
          while pi < Array::length(ptypes) {
            collect_texpr_ref_names(Array::get(ptypes, pi), out)
            pi = pi + 1
          }
          collect_texpr_ref_names(rty, out)
          oi = oi + 1
        }
      },
      STest(_, val) => collect_referenced_names_expr_top(val, out),
      SBench(_, val) => collect_referenced_names_expr_top(val, out),
      SExpr(val) => collect_referenced_names_expr_top(val, out),
      SModule(_, _, body) => collect_referenced_names_stmts(body, out),
      _ => ()
    }
    i = i + 1
  }
}

fn unused_alias_referenced(used: Array[String], bare: String, qualified_prefix: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(used) {
    let name = Array::get(used, i)
    if name == bare || String::starts_with(name, qualified_prefix) {
      found = true
      i = Array::length(used)
    } else {
      i = i + 1
    }
  }
  found
}

/// #1129: an `import ./f.vibe { a, b }` name (its local alias, or the
/// original if unaliased) that is never referenced anywhere else in the
/// SAME file, or an `import @pkg @alias` whose alias is never referenced
/// (as `@alias`, or qualified `@alias::member`). Both are WARNING-level (not
/// hard errors -- see the issue's own caution about the "merge a package's
/// exports whole-program with no local call site" pattern): this only flags
/// what is invisible to THIS file, and a caller relying on the
/// whole-program merge lane is expected to judge each hit, not have the
/// compile fail. Only reached after a clean type-check
/// (collect_all_diagnostics only calls this on the success path), so the
/// AST it sees already has #1001/#986's labeled-arg desugars and #760's
/// Result-prelude injection applied -- neither touches import/alias
/// statements, so this is inert either way.
export fn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let used = array_empty()
  collect_referenced_names_stmts(stmts, used)
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let orig = item.name
          let alias = item.alias
          let local = match alias {
            Some(a) => a,
            None => orig
          }
          if unused_alias_referenced(used, local, String::concat(local, "::")) {
            ()
          } else {
            let msg = String::concat("imported name '", String::concat(local, String::concat("' from '", String::concat(path, "' is never used in this file"))))
            Array::push(out, ("unused_import", local, msg))
          }
          j = j + 1
        }
      },
      SAliasDecl(alias, path) => {
        let qualified_prefix = String::concat("@", String::concat(alias, "::"))
        let bare = String::concat("@", alias)
        if unused_alias_referenced(used, bare, qualified_prefix) {
          ()
        } else {
          let msg = String::concat("import alias '", String::concat(bare, String::concat("' for '", String::concat(path, "' is never used in this file (referenced elsewhere in a whole-program merge? consider a named import instead)"))))
          Array::push(out, ("unused_import", alias, msg))
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn import_items_have_unaliased_owner(items: Array[ImportItem], owner: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    let item = Array::get(items, i)
    if item.name == owner && item.alias == None {
      found = true
      i = Array::length(items)
    } else {
      i = i + 1
    }
  }
  found
}

/// An unaliased owner import activates its exported namespace, so spelling
/// an unaliased `Owner::member` beside it adds no binding. Keep aliased
/// members: they intentionally introduce a distinct local name.
export fn detect_redundant_namespace_imports(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let sep = String::index_of(item.name, "::")
          if sep > 0 && item.alias == None {
            let owner = String::substring(item.name, 0, sep)
            if import_items_have_unaliased_owner(items, owner) {
              let msg = String::concat("imported name '", String::concat(item.name, String::concat("' from '", String::concat(path, String::concat("' is redundant because '", String::concat(owner, String::concat("' activates its namespace; remove '", String::concat(item.name, "' from the import list"))))))))
              Array::push(out, ("redundant_import", item.name, msg))
            } else {
              ()
            }
          } else {
            ()
          }
          j = j + 1
        }
      },
      SModule(_, _, body) => {
        let nested = detect_redundant_namespace_imports(body)
        let mut j = 0
        while j < Array::length(nested) {
          Array::push(out, Array::get(nested, j))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The offset of every `ESeq(left, _)` where `left` is itself an `ECall` --
/// a bare call statement in the middle of a block whose result is thrown
/// away. Recurses into every other expression shape so a discard nested
/// inside an `if`/`match`/`while`/closure body etc. is still found; the
/// match only special-cases `ESeq` because that is the ONLY shape where a
/// value is silently dropped (a `let`/`let mut`/assignment BINDS its value
/// by construction, so is never a discard site).
fn collect_discard_call_offsets_expr(expr: Expr, out: Array[Int]) -> Unit {
  match expr {
    ESeq(left, right) => {
      match left {
        ECall(_, _, call_off) => if call_off >= 0 {
          Array::push(out, call_off)
        } else {
          ()
        },
        _ => ()
      }
      collect_discard_call_offsets_expr(left, out)
      collect_discard_call_offsets_expr(right, out)
    },
    EIf(cond, then_e, else_e) => {
      collect_discard_call_offsets_expr(cond, out)
      collect_discard_call_offsets_expr(then_e, out)
      collect_discard_call_offsets_expr(else_e, out)
    },
    ELet(_, val, body, _) => {
      collect_discard_call_offsets_expr(val, out)
      collect_discard_call_offsets_expr(body, out)
    },
    ELetRec(_, val, body) => {
      collect_discard_call_offsets_expr(val, out)
      collect_discard_call_offsets_expr(body, out)
    },
    ELetMut(_, val, body, _) => {
      collect_discard_call_offsets_expr(val, out)
      collect_discard_call_offsets_expr(body, out)
    },
    EAssign(_, val, body) => {
      collect_discard_call_offsets_expr(val, out)
      collect_discard_call_offsets_expr(body, out)
    },
    EAssignOp(_, _, val, body) => {
      collect_discard_call_offsets_expr(val, out)
      collect_discard_call_offsets_expr(body, out)
    },
    EMatch(scr, arms) => {
      collect_discard_call_offsets_expr(scr, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, i)
        collect_discard_call_offsets_expr(body, out)
        i = i + 1
      }
    },
    EHandle(body_expr, arms) => {
      collect_discard_call_offsets_expr(body_expr, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        collect_discard_call_offsets_expr(arm_body, out)
        i = i + 1
      }
    },
    EWhile(cond, body) => {
      collect_discard_call_offsets_expr(cond, out)
      collect_discard_call_offsets_expr(body, out)
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        collect_discard_call_offsets_expr(init, out)
        i = i + 1
      }
      collect_discard_call_offsets_expr(body, out)
    },
    EForIn(_, _, iter, body) => {
      collect_discard_call_offsets_expr(iter, out)
      collect_discard_call_offsets_expr(body, out)
    },
    ECall(callee, args, _) => {
      collect_discard_call_offsets_expr(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_discard_call_offsets_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      collect_discard_call_offsets_expr(l, out)
      collect_discard_call_offsets_expr(r, out)
    },
    EUnaryOp(_, e) => collect_discard_call_offsets_expr(e, out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_discard_call_offsets_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_discard_call_offsets_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_discard_call_offsets_expr(val, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, body) => collect_discard_call_offsets_expr(body, out),
    EDot(obj, _, _, _) => collect_discard_call_offsets_expr(obj, out),
    ELabeledArg(_, _, e) => collect_discard_call_offsets_expr(e, out),
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_discard_call_offsets_expr(val, out)
        i = i + 1
      }
    },
    ESpread(e) => collect_discard_call_offsets_expr(e, out),
    EReturn(e) => collect_discard_call_offsets_expr(e, out),
    EBreak(opt) => match opt {
      Some(e) => collect_discard_call_offsets_expr(e, out),
      None => ()
    },
    EContinue(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_discard_call_offsets_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn collect_discard_call_offsets_stmts(stmts: Array[Stmt], out: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, val) => collect_discard_call_offsets_expr(val, out),
      SLetMut(_, _, val) => collect_discard_call_offsets_expr(val, out),
      SLetPat(_, val) => collect_discard_call_offsets_expr(val, out),
      STest(_, val) => collect_discard_call_offsets_expr(val, out),
      SBench(_, val) => collect_discard_call_offsets_expr(val, out),
      SExpr(val) => collect_discard_call_offsets_expr(val, out),
      SModule(_, _, body) => collect_discard_call_offsets_stmts(body, out),
      _ => ()
    }
    i = i + 1
  }
}

fn lookup_tytab_offset(tytab: Array[(Int, Type)], off: Int) -> Option[Type] {
  let mut i = 0
  let mut found = None
  while i < Array::length(tytab) {
    let (o, t) = Array::get(tytab, i)
    if o == off {
      found = Some(t)
      i = Array::length(tytab)
    } else {
      i = i + 1
    }
  }
  found
}

fn discard_type_worth_warning(ty: Type) -> Bool {
  match ty {
    CtUnit => false,
    CtUnknown => false,
    CtVar(_) => false,
    _ => true
  }
}

/// The companion "unbound non-Unit return value" request: a bare call
/// statement (`foo();` mid-block, not bound via `let`/`let _`) whose
/// resolved return type is neither `Unit` nor still-polymorphic/unresolved.
/// Scoped to CALL expressions specifically (not `if`/`match`/`while` used as
/// a statement) because only `ECall` nodes get a `tytab` entry keyed by
/// their own offset (checker.vibe's `tab_call_ty`) -- an `if`/`match` used
/// for its side effects has no such entry to look up, so it is silently
/// skipped rather than false-positiving. `let _ = foo()` is already how
/// this codebase spells "discard intentionally" (see e.g.
/// `annotation_return_type` above) and is unaffected: it is an `ELet`
/// binding, never the left side of an `ESeq`, so it is never a candidate.
export fn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String] {
  let offsets = array_empty()
  collect_discard_call_offsets_stmts(stmts, offsets)
  let out = array_empty()
  let mut i = 0
  while i < Array::length(offsets) {
    let off = Array::get(offsets, i)
    match lookup_tytab_offset(tytab, off) {
      Some(ty) => {
        let resolved = subst_apply(final_s, ty)
        if discard_type_worth_warning(resolved) {
          let marker = labeled_name_marker(off, 0)
          Array::push(out, String::concat("expression result of type `", String::concat(type_to_string(resolved), String::concat("` is unused -- bind it (e.g. `let _ = ...`) if this is intentional", marker))))
        } else {
          ()
        }
      },
      None => ()
    }
    i = i + 1
  }
  out
}
