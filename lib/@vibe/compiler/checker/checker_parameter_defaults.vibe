import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}
import @vibe/ast {
  builtin_ref_offset
}

fn defaults_scrutinee(expr: Expr, name: String) -> Bool {
  match expr {
    EMatch(EIdent(found, _), _) => found == name,
    _ => false
  }
}

fn mark_defaults(expr: Expr, params: Array[(String, Option[TypeExpr])], flags: Array[Bool]) -> Unit {
  match expr {
    ELet(name, ECall(EFn(_, _, ascribed, _, _, EIdent(result, _)), args, _, _), rest, offset) => {
      if offset == builtin_ref_offset() && result == "__asc" && Array::length(ascribed) == 1 && Array::length(args) == 1 && defaults_scrutinee(expr = Array::get(args, at = 0), name = name) {
        let mut i = 0
        while i < Array::length(params) {
          if Array::get(params, at = i).0 == name + "?" {
            Array::set(flags, at = i, value = true)
          } else {
            ()
          }
          i = i + 1
        }
        mark_defaults(expr = rest, params = params, flags = flags)
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn opens_default(_ expr: Expr) -> Bool {
  match expr {
    ELet(name, ECall(EFn(_, _, ascribed, _, _, EIdent(result, _)), args, _, _), _, offset) => offset == builtin_ref_offset() && result == "__asc" && Array::length(ascribed) == 1 && Array::length(args) == 1 && defaults_scrutinee(expr = Array::get(args, at = 0), name = name),
    _ => false
  }
}

/// The parser's default unwrap prefix belongs to this declaration. Ordinary
/// lambdas cannot declare defaults, and no spelling-based call table is needed.
export fn checker_parameter_defaults(_ value: Expr) -> Option[Array[Bool]] {
  match value {
    EFn(_, _, params, _, _, body) => if opens_default(body) {
      let flags = for _ in params {
        false
      }
      mark_defaults(expr = body, params = params, flags = flags)
      let mut any = false
      for flag in flags {
        any = any || flag
      }
      if any {
        Some(flags)
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// Method restrictions belong to the declaration that owns the defaults;
/// they do not require a label-name walk through expression bodies.
///
/// An EXPORTED declaration is not refused (#3440): its default bits travel
/// with the imported header (`BindingOriginModuleFunctionHeader`), so an
/// importer refuses a written `None` / `Some(..)` for a defaulted parameter
/// and refuses the function as a value exactly as this module does.
export fn checker_check_default_declarations(stmts: Array[Stmt], errors: Array[String]) -> Unit {
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, value) => match checker_parameter_defaults(value) {
        Some(_) => if String::contains(name, needle = "::") {
          Array::push(errors, value = "`" + name + "` is a namespaced function with parameter defaults, which apply only to a direct call by name and not to a method call (`x.f(..)`); declare the parameter `x?: T` and match on the `Option`, or make it a plain top-level `fn`")
        } else {
          ()
        },
        None => ()
      },
      SModule(_, _, children) => checker_check_default_declarations(stmts = children, errors = errors),
      _ => ()
    }
  }
  ()
}
