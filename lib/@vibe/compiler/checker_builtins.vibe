//# Imports

import @vibe/compiler/core {
  Type
}

//# Functions

export fn infer_map_op(op_name: String) -> Type {
  if op_name == "Map::get" {
    CtUnknown
  }
  else if op_name == "map_has" {
    CtBool
  }
  else if op_name == "Map::keys" {
    CtArray(CtString)
  }
  else if op_name == "MapBuilder::new" {
    CtUnknown
  }
  else if op_name == "MapBuilder::set" {
    CtUnit
  }
  else if op_name == "MapBuilder::freeze" {
    CtUnknown
  }
  else CtUnknown
}

export fn infer_array_get(array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}

export fn infer_string_op(op_name: String) -> Type {
  if op_name == "String::length" {
    CtInt
  }
  else if op_name == "String::concat" {
    CtString
  }
  else if op_name == "String::equals" {
    CtBool
  }
  else if op_name == "string_slice" {
    CtString
  }
  else if op_name == "string_char_at" {
    CtString
  }
  else if op_name == "String::index_of" {
    CtInt
  }
  else if op_name == "String::contains" {
    CtBool
  }
  else if op_name == "String::starts_with" {
    CtBool
  }
  else if op_name == "String::ends_with" {
    CtBool
  }
  else CtUnknown
}

export fn infer_array_slice(array_ty: Type) -> Type {
  match array_ty {
    CtArray(_) => array_ty,
    _ => CtUnknown
  }
}

export fn infer_array_length() -> Type {
  CtInt
}

export fn infer_builtin_call(name: String, arg_types: Array[Type]) -> Type {
  if name == "array_new" {
    CtArray(CtUnknown)
  }
  else if name == "Array::get" {
    if Array::length(arg_types) > 0 {
      infer_array_get(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if name == "Array::length" {
    CtInt
  }
  else if name == "Array::push" {
    CtUnit
  }
  else if name == "Array::slice" {
    if Array::length(arg_types) > 0 {
      infer_array_slice(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if name == "Array::set" {
    CtUnit
  }
  else if name == "Array::concat" {
    if Array::length(arg_types) > 0 {
      let first = Array::get(arg_types, 0)
      match first {
        CtArray(_) => first,
        _ => CtUnknown
      }
    } else CtUnknown
  }
  else if name == "String::length" {
    CtInt
  }
  else if name == "String::concat" {
    CtString
  }
  else if name == "String::equals" {
    CtBool
  }
  else if name == "string_slice" {
    CtString
  }
  else if name == "String::substring" {
    CtString
  }
  else if name == "string_char_at" {
    CtString
  }
  else if name == "String::index_of" {
    CtInt
  }
  else if name == "String::last_index_of" {
    CtInt
  }
  else if name == "String::contains" {
    CtBool
  }
  else if name == "String::starts_with" {
    CtBool
  }
  else if name == "String::ends_with" {
    CtBool
  }
  else if name == "String::from_char_code" {
    CtString
  }
  else if name == "String::char_code_at" {
    CtInt
  }
  else if name == "Map::get" {
    CtUnknown
  }
  else if name == "map_has" {
    CtBool
  }
  else if name == "Map::keys" {
    CtArray(CtString)
  }
  else if name == "MapBuilder::new" {
    CtUnknown
  }
  else if name == "MapBuilder::set" {
    CtUnit
  }
  else if name == "MapBuilder::freeze" {
    CtUnknown
  }
  else if name == "FixedArray::make" {
    CtUnknown
  }
  else if name == "FixedArray::length" {
    CtInt
  }
  else if name == "FixedArray::get" {
    if Array::length(arg_types) > 0 {
      infer_array_get(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if name == "FixedArray::set" {
    CtUnit
  }
  else if name == "FixedArray::unsafe_set" {
    CtUnit
  }
  else if name == "FixedArray::blit" {
    CtUnit
  }
  else if name == "int_to_string" {
    CtString
  }
  else if name == "__to_string" {
    CtString
  }
  // #1374: the exception-kind read. Checker-only -- desugar_trait_dicts lowers
  // it to a module-cell read before either backend sees it.
  else if name == "__exn_kind" || name == "__exn_message" {
    CtString
  }
  else if name == "Int::to_double" {
    CtDouble
  }
  else if name == "Double::to_int" {
    CtInt
  }
  else if name == "print" {
    CtUnit
  }
  else if name == "println" {
    CtUnit
  }
  else if name == "assert" {
    CtUnit
  }
  else if name == "eq" {
    CtBool
  }
  else if name == "not" {
    CtBool
  }
  else if name == "sh" {
    CtString
  }
  else if name == "sh_lines" {
    CtArray(CtString)
  }
  else if name == "Path::to_string" {
    CtString
  }
  else if name == "Path::is_absolute" {
    CtBool
  }
  else if name == "PromptText::new" {
    CtString
  }
  else if name == "Stdin::read_char" {
    CtInt
  }
  else if name == "Stdin::read_stream" {
    CtString
  }
  else if name == "Stdout::write_char" {
    CtUnit
  }
  else if name == "Stdout::write_stream" {
    CtUnit
  }
  else if name == "Env::get" {
    CtString
  }
  else if name == "Env::args_len" {
    CtInt
  }
  else if name == "Env::args_get" {
    CtString
  }
  // #1227: row-free sibling of `sleep`; same result type.
  else if name == "sleep_blocking" {
    CtUnit
  }
  else if name == "sleep" {
    CtUnit
  }
  else if name == "Path::resolve" {
    CtString
  }
  else if name == "Fs::read_file" {
    CtString
  }
  else if name == "Fs::write_file" {
    CtUnit
  }
  else if name == "Fs::read_bytes" {
    CtBytes
  }
  else if name == "Fs::write_bytes" {
    CtUnit
  }
  else if name == "Fs::exists" {
    CtBool
  }
  else if name == "Fs::stat_token" {
    CtInt
  }
  else if name == "Fs::readdir" {
    CtArray(CtString)
  }
  else if name == "Fs::is_dir" {
    CtBool
  }
  else if name == "Fs::is_file" {
    CtBool
  }
  else if name == "Fs::mkdir" {
    CtUnit
  }
  else if name == "Fs::getcwd" {
    CtString
  }
  else if name == "Fs::chdir" {
    CtUnit
  }
  else if name == "Fs::remove" {
    CtUnit
  }
  else if name == "Fs::copy" {
    CtUnit
  }
  else if name == "Fs::append" {
    CtUnit
  }
  else if name == "vibe_tcp_connect_raw" {
    CtInt
  }
  else if name == "vibe_tcp_read_raw" {
    CtString
  }
  else if name == "vibe_tcp_write_raw" {
    CtUnit
  }
  else if name == "vibe_tcp_close_raw" {
    CtUnit
  }
  else if name == "Http::request" {
    CtUnknown
  }
  else if name == "Http::response_status" {
    CtInt
  }
  else if name == "Http::response_header" {
    CtString
  }
  else if name == "Http::response_body" {
    CtString
  }
  else if name == "Http::close" {
    CtUnit
  }
  else if name == "Http::listen" {
    CtUnknown
  }
  else if name == "Http::accept" {
    CtUnknown
  }
  else if name == "Http::request_method" {
    CtString
  }
  else if name == "Http::request_header" {
    CtString
  }
  else if name == "Http::respond" {
    CtUnit
  }
  else CtUnknown
}

export fn infer_array_element(array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}
