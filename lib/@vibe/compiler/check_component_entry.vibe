//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Functions

fn check_source_status_impl(source: String) -> Int with Exception {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  0
}

export fn check_source_report(source: String) -> String {
  handle {
    let _ = check_source_status_impl(source)
    "ok"
  } with { Exception::Throw(msg) => String::concat("error:", msg) }
}
