import @vibe/compiler/core {
  executable_exports_stripped
}

import @vibe/compiler/cache {
  compact_string_fingerprint, load_persistent_artifact, store_persistent_artifact
}

//# Exact no-op rebuild: the linked-output memo (#2825)
//
// The user-visible KPI contract's first row is "an exact no-op does no
// semantic work". Before this, an unchanged rebuild skipped the whole module
// walk (every module's typing reused) and then ran the entire back end again:
// effect lowering, trait-dict desugar, borrow / Perceus, codegen, DCE and
// assembly. Measured on main at bcb306a, warm over cold: 84 % of the wall time
// for a two-module project and 47 % for the compiler's own 677-module CLI
// closure (12.5 s).
//
// The memo stores the finished module under the compile's complete input
// identity and replays it when every input matches. The identity is the
// output's whole domain:
//
// - the compiler itself: the persistent store's namespace already carries the
//   hash of the compiler sources and the cfg flags (`persistent_cache_version_tag`);
// - the lane, the entry path and entry name, the capability grants, and
//   whether the executable's exports will be stripped;
// - every source the loader resolved, by group, path and content
//   fingerprint, in load order -- a typed wasm import is in here too, as the
//   binding text the loader synthesized from its bytes;
// - the value of every environment variable the compiler reads
//   (`linked_output_memo_env_names`).
//
// That last list is where a memo goes silently wrong: a setting that changes
// the output but is not in the key replays a module built for the other
// setting. So the list is not curated by judgement. Every variable name the
// compiler's sources mention is either in it or in
// `linked_output_memo_env_exempt` with the reason the value cannot reach the
// output, and `scripts/check_linked_output_memo_env.sh` fails when a name in
// the tree is in neither. Including a variable that does not matter costs a
// miss; omitting one that does would cost a wrong program.
//
// The lookup runs AFTER the typing walk, not before. A no-op still pays the
// loader and the (fully reused) checker, which is what records the closure
// for the unstable-surface gate, reports the typing telemetry and raises a
// type error -- a program that fails to check never reaches the memo.
//
// One slot per (lane, entry path): the store replaces it, so the memo holds
// one module per root, like the body cache.

/// `VIBE_LINKED_OUTPUT_MEMO`: `on` replays a stored module, `off` neither
/// reads nor writes, and `verify` compiles anyway and refuses a stored module
/// that differs from the fresh one. Unset is the caller's `default_mode`:
/// `on` for `vibe run` / `build` / `test`, `off` for the launcher's internal
/// FS lane, whose warm compiles are the back end's own measurements.
export fn linked_output_memo_mode(default_mode: String) -> String with Env + Exception {
  let raw = Env::get("VIBE_LINKED_OUTPUT_MEMO")
  if raw == "" {
    default_mode
  } else if raw == "on" || raw == "off" || raw == "verify" {
    raw
  } else {
    throw(String::concat("VIBE_LINKED_OUTPUT_MEMO must be on, off or verify, got: ", raw))
  }
}

