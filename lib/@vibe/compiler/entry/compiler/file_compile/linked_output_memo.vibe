/// Variables the compiler reads whose value cannot reach the compiled module,
/// each with the reason. The gate refuses a name that is in both lists.
///
/// - where the cache and its sidecars live: `VIBE_BUILD_CACHE_DIR` (the memo
///   itself lives there, so a different directory is a different memo);
/// - where the module is written: `VIBE_OUTPUT`, which the runner sets from
///   the output argument. Keying it would make every build into a fresh
///   temporary path miss;
/// - per-run output paths and nonces of observation sidecars, which a run
///   writes beside the module and never into it: the `*_TELEMETRY_OUT`,
///   `*_TRACE_OUT`, `*_NONCE` and `VIBE_HOST_ACTION_OUT` / `VIBE_TESTMETA_OUT`
///   / `VIBE_ENTRY_TESTMETA_OUT` paths, `VIBE_SCHEDULER_TRACE`;
/// - `VIBE_PROFILE_MEMORY_MARK`, the prefix of the host-hook names a profiled
///   build reads to mark a phase boundary (the answer is ignored);
/// - this switch itself.
export fn linked_output_memo_env_exempt() -> Array[String] {
  [
    "VIBE_ARTIFACT_INPUT_TRACE_NONCE",
    "VIBE_ARTIFACT_INPUT_TRACE_OUT",
    "VIBE_BUILD_CACHE_DIR",
    "VIBE_ENTRY_TESTMETA_OUT",
    "VIBE_HOST_ACTION_OUT",
    "VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE",
    "VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT",
    "VIBE_INCREMENTAL_TELEMETRY_OUT",
    "VIBE_INGESTION_PIPELINE_TELEMETRY_NONCE",
    "VIBE_INGESTION_PIPELINE_TELEMETRY_OUT",
    "VIBE_INGESTION_TELEMETRY_NONCE",
    "VIBE_INGESTION_TELEMETRY_OUT",
    "VIBE_LINKED_OUTPUT_MEMO",
    "VIBE_OUTPUT",
    "VIBE_PROFILE_MEMORY_MARK",
    "VIBE_SCHEDULER_TRACE",
    "VIBE_TESTMETA_OUT"
  ]
}

fn lom_field(sb: StringBuilder, tag: String, value: String) -> Unit {
  // Length-prefixed, so no value (a path, an env value with a newline) can
  // forge the boundary of the next field.
  StringBuilder::push(sb, tag)
  StringBuilder::push(sb, " ")
  StringBuilder::push(sb, __to_string(String::length(value)))
  StringBuilder::push(sb, ":")
  StringBuilder::push(sb, value)
  StringBuilder::push(sb, "\n")
}

/// The compile's complete input identity, as text. Two compiles with equal
/// identities produce the same module; see the section comment for why each
/// part is here.
export fn linked_output_memo_identity(lane: String, entry_path: String, entry_name: String, grants: Array[(String, String)], source_groups: Array[(String, Array[(String, String)])]) -> String with Env {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "linked-output-memo-v1\n")
  lom_field(sb, "lane", lane)
  lom_field(sb, "entry_path", entry_path)
  lom_field(sb, "entry_name", entry_name)
  lom_field(sb, "stripped", if executable_exports_stripped() {
    "1"
  } else {
    "0"
  })
  let mut g = 0
  while g < Array::length(grants) {
    let (op, grant) = Array::get(grants, g)
    lom_field(sb, "grant_op", op)
    lom_field(sb, "grant", grant)
    g = g + 1
  }
  let names = linked_output_memo_env_names()
  let mut e = 0
  while e < Array::length(names) {
    let name = Array::get(names, e)
    lom_field(sb, "env", name)
    lom_field(sb, "val", Env::get(name))
    e = e + 1
  }
  let mut s = 0
  while s < Array::length(source_groups) {
    let (group, files) = Array::get(source_groups, s)
    lom_field(sb, "group", group)
    let mut f = 0
    while f < Array::length(files) {
      let (path, text) = Array::get(files, f)
      lom_field(sb, "path", path)
      lom_field(sb, "src", compact_string_fingerprint(text))
      f = f + 1
    }
    s = s + 1
  }
  StringBuilder::freeze(sb)
}

fn lom_slot(lane: String, entry_path: String) -> String {
  compact_string_fingerprint(String::concat("linked-output-memo-slot\n", String::concat(lane, String::concat("\n", entry_path))))
}

/// The stored artifact is `<identity length>\n<identity><module>`. The
/// identity is compared in full, byte for byte, not by a hash of it.
fn lom_decode(stored: Bytes, identity: String) -> Option[Bytes] {
  let n = Bytes::length(stored)
  let mut at = 0
  let mut len = 0
  let mut ok = true
  let mut done = false
  while !done && ok {
    if at >= n || at > 20 {
      ok = false
    } else {
      let c = Bytes::get(stored, at)
      if c == 10 {
        done = true
      } else if c >= 48 && c <= 57 {
        len = len * 10 + (c - 48)
      } else {
        ok = false
      }
      at = at + 1
    }
  }
  if !ok || at == 1 || len != String::length(identity) || at + len > n {
    None
  } else {
    let mut i = 0
    let mut same = true
    while same && i < len {
      if Bytes::get(stored, at + i) != String::byte_at(identity, i) {
        same = false
      } else {
        i = i + 1
      }
    }
    if same {
      Some(Bytes::slice(stored, at + len, n))
    } else {
      None
    }
  }
}

fn lom_push_text(buf: Bytes, text: String) -> Unit {
  let mut i = 0
  while i < String::length(text) {
    Bytes::push(buf, String::byte_at(text, i))
    i = i + 1
  }
}

/// The module stored for exactly this identity, if there is one.
export fn linked_output_memo_lookup(lane: String, entry_path: String, entry_name: String, identity: String) -> Option[Bytes] with Env + Exception + Fs {
  match load_persistent_artifact("linked-output-memo", entry_name, lom_slot(lane, entry_path)) {
    Some(stored) => lom_decode(stored, identity),
    None => None
  }
}

/// Replace this root's slot with `wasm` under `identity`.
export fn linked_output_memo_store(lane: String, entry_path: String, entry_name: String, identity: String, wasm: Bytes) -> Unit with Env + Exception + Fs {
  let buf = Bytes::new()
  lom_push_text(buf, String::concat(__to_string(String::length(identity)), "\n"))
  lom_push_text(buf, identity)
  Bytes::append(buf, wasm)
  store_persistent_artifact("linked-output-memo", entry_name, lom_slot(lane, entry_path), buf)
}

/// An observation hook, never an input: the node runner prints every
/// `Env::get` under `VIBE_DEBUG_ENV=1` (and a `[profile-memory]` line under
/// `VIBE_PROFILE_MEMORY_MARKS=1`), so a caller can tell a replay from a
/// compile without a new channel. The variable is never set and the answer
/// is ignored.
fn lom_mark(event: String) -> Unit with Env {
  let _ = Env::get(String::concat("VIBE_PROFILE_MEMORY_MARK:", event))
  ()
}

/// `compile` behind the memo, in the given mode. `verify` always compiles and
/// throws when a stored module for the same identity differs from the fresh
/// one -- that would mean the identity is missing an input -- after replacing
/// the slot with the fresh module, so a later `on` build cannot replay it.
export fn linked_output_memo_run(mode: String, lane: String, entry_path: String, entry_name: String, identity: String, compile: () -> Bytes with Env + Exception + Fs) -> Bytes with Env + Exception + Fs {
  if mode == "off" {
    compile()
  } else {
    // `on` replays what the identity licenses; `verify` checks the licence.
    let replay = mode == "on"
    let stored = linked_output_memo_lookup(lane, entry_path, entry_name, identity)
    match stored {
      Some(bytes) => if replay {
        lom_mark("linked_output_memo_hit")
        bytes
      } else {
        let fresh = compile()
        if fresh == bytes {
          fresh
        } else {
          // Replace the slot before refusing: the next build defaults to
          // `on`, and must not replay the module this run just proved wrong.
          linked_output_memo_store(lane, entry_path, entry_name, identity, fresh)
          throw(String::concat("linked-output memo verify: the stored module for ", String::concat(entry_path, " differed from a fresh compile with the same input identity, so the identity is missing an input. The slot now holds the fresh module; set VIBE_LINKED_OUTPUT_MEMO=off to compile without the memo, and report this")))
        }
      },
      None => {
        let fresh = compile()
        linked_output_memo_store(lane, entry_path, entry_name, identity, fresh)
        fresh
      }
    }
  }
}
