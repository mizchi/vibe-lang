fn prelude_module_oracle_report_fs(entry_path: String, entry_name: String, pass_limit: Int, checked_error_row: Bool) -> String with Env + Exception + Fs
fn prelude_module_full_oracle_report_fs(entry_path: String, entry_name: String, checked_error_row: Bool) -> String with Env + Exception + Fs
fn prelude_module_import_closure_report_fs(_ entry_path: String, checked_error_row: Bool) -> String with Env + Exception + Fs
fn prelude_ordinary_lane_prov_report_fs(_ entry_path: String, checked_error_row: Bool) -> String with Env + Exception + Fs
fn compile_file_fs_mode_rc_body_cached(entry_path: String, entry_name: String, cache_mode: String, exports_stripped: Bool, checked_error_row: Bool) -> Bytes with Env + Exception + Fs
// #2575 item 2 step 3b: the same lane with the per-module prelude selectable.
// `use_split` false is byte-for-byte the lane above; true builds the
// `ModuleSplit` from the merge's own file counts and the resolved import
// closure, and FAILS OPEN to whole-program on any unresolved edge.
fn compile_file_fs_mode_rc_body_cached_split(entry_path: String, entry_name: String, cache_mode: String, use_split: Bool, exports_stripped: Bool, checked_error_row: Bool) -> Bytes with Env + Exception + Fs
// #2826 item 3: the shadow lane (use-after-free / double-free traps) with
// the per-module prelude selectable, prepared like the lane above.
fn compile_file_fs_mode_rc_shadow_split(entry_path: String, entry_name: String, use_split: Bool, exports_stripped: Bool, checked_error_row: Bool) -> Bytes with Env + Exception + Fs
// #2669 step 2b: the same lane plus `[offered, recompiled]` -- what the file
// table let through and what the compile actually rebuilt. The reuse claim is
// about those numbers and is invisible in the returned bytes.
fn compile_file_fs_mode_rc_body_cached_counted(entry_path: String, entry_name: String, cache_mode: String, counts_out: Array[Int], exports_stripped: Bool, checked_error_row: Bool) -> Bytes with Env + Exception + Fs
