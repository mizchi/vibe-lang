name = @vibe/compiler/entry/compiler/file_compile
version = 0.0.1
description =
  #|@vibe/compiler/entry/compiler/file_compile — the path-driven compile drivers: collect an entry's import closure from the filesystem, check it, and compile it. The one home of `compile_file_fs*` (#1872 boundary 4).
deps = {
  @vibe/ast : 0.2.0
  @vibe/compiler/cache : 0.0.1
  @vibe/compiler/checker : 0.0.1
  @vibe/compiler/codegen : 0.0.1
  @vibe/compiler/codegen/common_base : 0.0.1
  @vibe/compiler/codegen/wasi : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/compiler/entry/compiler/file_compile/oracle : 0.0.1
  @vibe/compiler/entry/source_compile/gc_only : 0.0.1
  @vibe/compiler/linker/import_closure : 0.0.1
  @vibe/compiler/linker/merge : 0.0.1
  @vibe/compiler/loader : 0.0.1
  @vibe/compiler/runtime : 0.0.1
  @vibe/compiler/syntax : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

// Filesystem compilation orchestration: collect and check source groups,
// select the compilation lane and manage its artifacts and body cache.
// Program construction lives in @vibe/compiler/linker/merge, source visibility
// in @vibe/compiler/linker/import_closure, and observation-only reports in the
// nested oracle package. Public filesystem entry points prepare the sources
// before calling those lower owners.

fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with Env + Exception + Fs
