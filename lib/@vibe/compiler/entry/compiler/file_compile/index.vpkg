// #2825: the same lane behind the linked-output memo; `memo_mode` is
// `linked_output_memo_mode`'s answer (`on`, `off` or `verify`).
fn compile_file_fs_mode_rc_grants_memo(entry_path: String, entry_name: String, grants: Array[(String, String)], memo_mode: String, exports_stripped: Bool, checked_error_row: Bool) -> Bytes with Env + Exception + Fs
fn linked_output_memo_mode(_ default_mode: String) -> String with Env + Exception
fn linked_output_memo_identity(lane: String, entry_path: String, entry_name: String, grants: Array[(String, String)], source_groups: Array[(String, Array[(String, String)])], exports_stripped: Bool) -> String with Env
fn linked_output_memo_env_names() -> Array[String]
fn linked_output_memo_env_exempt() -> Array[String]
