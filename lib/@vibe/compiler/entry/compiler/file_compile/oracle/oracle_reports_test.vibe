import @vibe/compiler/entry/compiler/file_compile/oracle {
  prelude_module_import_closure_report, prelude_module_oracle_report, prelude_ordinary_lane_prov_report
}

test "prepared source groups produce parity and provenance reports" {
  let path = "/tmp/vibe_linker_prepared_oracle.vibe"
  let source = "fn run() -> Int { 42 }\n"
  let groups = [(path, [(path, source)])]
  Fs::write_file(path, contents = source)
  let passes = prelude_module_oracle_report(source_groups = groups, entry_name = "run", pass_limit = 0, checked_error_row = false)
  assert(String::starts_with(passes, prefix = "PASS "))
  assert(String::contains(passes, needle = "status=same"))
  let prov = prelude_ordinary_lane_prov_report(groups, checked_error_row = false)
  assert(String::starts_with(prov, prefix = "PROV stmts="))
  assert(String::contains(prov, needle = " files=1\n"))
  assert_eq(prelude_module_import_closure_report(groups, checked_error_row = false), "CLOSURE files=1 edges=0 unresolved=0\n")
}
