//# Types

export effect Profiler {
  NowUs -> Int
}

//# Functions

/// Direct builtin call (ADR-0076 追記31 Vertical C) — see
/// lib/@vibe/cli/dispatch.vibe::profiler_now_us for why the perform form
/// was retired (replay re-execution + memoized resume(0) zeros).
fn profiler_now_us() -> Int with Profiler {
  Profiler::now_us()
}

fn elapsed_us_since(start_us: Int) -> Int with Profiler {
  let elapsed = profiler_now_us() - start_us
  if elapsed < 0 {
    0
  } else {
    elapsed
  }
}

fn artifact_fingerprint_from_source(source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

fn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {
  let mut seeded = db
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      seeded = db_set_source(seeded, path, source)
      si = si + 1
    }
    gi = gi + 1
  }
  seeded
}

fn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {
  let flat = array_empty()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(flat, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  flat
}

fn string_array_contains(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn lookup_source_stmts_by_path(sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], target_path: String) -> Option[Array[Stmt]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    if path == target_path {
      found = Some(Array::get(source_stmts, i))
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

/// #1100: was a byte-for-byte duplicate of runtime's parse_program_with_path
/// (same located lex+parse, same `<path>: <msg>` wrapping), so a cold compile
/// parsed every source twice -- once for the typecheck walk and once here for
/// the merge. Route both through the memoized one; it hands back a fresh
/// top-level array each call, which is what the in-place desugars downstream
/// require. Interior-line breakpoints (span-arc step5) still get their real
/// EIdent char-offsets: the memoized parse is the same located one.
fn parse_program_for_path(path: String, source: String) -> Array[Stmt] with Exception {
  parse_program_with_path(path, source)
}

/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
/// are the locals the export-rename plan already rewrites; the inline copy gets
/// the target file's export renames applied first.
fn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, fallback_clone_offset_delta: Array[Int], fallback_clone_offset_span: Int, excluded_locals: Array[String], flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets_out: Array[Int]) -> Unit with Exception {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      match lookup_source_stmts_by_path(sources, source_stmts, resolved) {
        Some(parsed_source_stmts) => {
          // Reuse the merge's authoritative parsed copy. In the GC lane this
          // copy already carries the provider file's rebased offsets; reparsing
          // the raw source here would silently return to source-relative
          // offsets only for alias-collision fallback definitions.
          let provider_stmts = namespace_private_value_stmts_after_renames(resolved, parsed_source_stmts, export_plan_renames_for(plan, resolved))
          let mut j = 0
          let mut done = false
          while j < Array::length(provider_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(Array::get(provider_stmts, j), original, local) {
              Some(local_stmt) => {
                let located_local_stmt = if fallback_clone_offset_span > 0 {
                  // A fallback is a real second copy of the provider body, so
                  // it needs a second location range too. Reusing the provider
                  // offsets would make the fail-closed call-result filter drop
                  // both the original and the clone's Double observations.
                  let delta = Array::get(fallback_clone_offset_delta, 0)
                  Array::set(fallback_clone_offset_delta, 0, delta + fallback_clone_offset_span)
                  // #2391 (#2425 review): the clone is a second copy of
                  // provider CODE in a fresh offset range, so it needs a
                  // second copy of the provider's Double call-result offsets
                  // too, or a Double-returning call inside the clone's body
                  // falls back to the syntactic classifier and prints raw
                  // bits. The clone's node offsets are the provider's
                  // MERGE-SPACE offsets (its file base plus its module-space
                  // offset -- source_stmts is the rebased table) plus this
                  // clone's delta; entries for provider statements the clone
                  // does not contain match no call node and stay inert.
                  match lookup_flat_base(flat_paths, flat_bases, resolved) {
                    Some(provider_base) => match module_typed_lowering_offsets_for_path(resolved) {
                      Some(provider_offsets) => {
                        let mut k = 0
                        while k < Array::length(provider_offsets) {
                          // The table is tag-encoded (offset * 8 + tag, see
                          // typed_lowering_enc), so shifting a row by the
                          // clone's merge-space delta adds (base + delta) * 8
                          // -- the tag bits stay untouched.
                          Array::push(clone_float_offsets_out, Array::get(provider_offsets, k) + (provider_base + delta) * 8)
                          k = k + 1
                        }
                      },
                      None => ()
                    },
                    None => ()
                  }
                  shift_stmt_offsets(local_stmt, delta)
                } else {
                  local_stmt
                }
                Array::push(merged, located_local_stmt)
                Array::push(emitted, local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
}

/// The disjoint-merge offset base recorded for `path`, or None when the merge
/// runs without disjoint offset spaces (the callers then pass empty tables).
fn lookup_flat_base(flat_paths: Array[String], flat_bases: Array[Int], path: String) -> Option[Int] {
  let n = Array::length(flat_paths)
  let mut i = 0
  let mut found: Option[Int] = None
  while i < n {
    if Array::get(flat_paths, i) == path {
      found = Some(Array::get(flat_bases, i))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #716: parse every source once and build the export-rename plan for the whole
/// program (the merge output of one file depends on the export surfaces of ALL
/// files: ambiguous exported names are renamed at their defs and at importing
/// files' references).
fn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with Exception {
  let file_paths = array_empty()
  let file_stmts = array_empty()
  let mut si = 0
  while si < Array::length(sources) {
    let (path, source) = Array::get(sources, si)
    Array::push(file_paths, path)
    Array::push(file_stmts, parse_program_for_path(path, source))
    si = si + 1
  }
  (file_paths, file_stmts)
}

/// One file's contribution to the merged program. `stmts` are the file's parsed
/// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule
/// (entry keeps its private names), and `plan`/`sources` drive the export-name
/// rewriting and the collision-def fallback.
fn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], fallback_clone_offset_delta: Array[Int], fallback_clone_offset_span: Int, flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets_out: Array[Int]) -> Unit with Exception {
  // Preserve the proof that an optimized trait namespace came from the
  // standard module. Desugaring consumes this source-local marker before
  // codegen; it is not part of the runtime program.
  let import_renames = if stmts_have_import_deep(stmts) {
    collect_import_value_renames(plan, path, stmts)
  } else {
    array_empty()
  }
  let (boundary_locals, boundary_surface_only) = merged_source_boundary_names(stmts)
  append_builtin_iterator_plan_operation_markers(boundary_locals, import_renames, plan)
  Array::push(merged, SReExportSourceBoundary(boundary_locals, boundary_surface_only))
  let collision_renames = if is_entry_source {
    trait_import_local_operation_renames_preserving_exports(stmts, path)
  } else {
    trait_import_local_operation_renames(stmts, path)
  }
  let collision_renamed = apply_export_renames_stmts(stmts, collision_renames)
  let namespaced_stmts = if is_entry_source {
    collision_renamed
  } else {
    namespace_private_value_stmts_after_renames(path, collision_renamed, export_plan_renames_for(plan, path))
  }
  if stmts_have_import_deep(stmts) {
    let skipped_locals = collect_import_alias_collision_locals(stmts)
    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, source_stmts, plan, fallback_clone_offset_delta, fallback_clone_offset_span, import_value_rename_locals(import_renames), flat_paths, flat_bases, clone_float_offsets_out)
    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
  } else {
    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
  }
}

fn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  // #2205: the rename table describes ONE merged program.
  namespace_rename_originals_reset()
  let merged = array_empty()
  let source_count = Array::length(sources)
  let (file_paths, file_stmts) = parse_sources_for_merge(sources)
  let plan_entry = if entry_path == "" {
    if source_count > 0 {
      Array::get(file_paths, source_count - 1)
    } else {
      ""
    }
  } else {
    entry_path
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let fallback_clone_offset_delta = [0]
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, si)
    let is_entry_source = if entry_path == "" {
      si == source_count - 1
    } else {
      path == entry_path
    }
    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources, file_stmts, fallback_clone_offset_delta, 0, array_empty(), array_empty(), array_empty())
    si = si + 1
  }
  merged
}

/// #2388: `stmt_file_id_out[s]` is the flat source index of merged statement
/// `s` -- which module owns it. Filled on EVERY lane, at one Int per top-level
/// statement, because a consumer that has to place something in the merged
/// program (the break lane's file map today, a per-module prelude tomorrow)
/// otherwise has to reconstruct it, and reconstructing it is what the two
/// defects behind this issue both did wrong.
///
/// It used to exist only in a second, near-identical copy of this function
/// (`build_grouped_merged_stmts_prov`), whose sameness was asserted in a
/// comment -- "so `merged` stays identical to the normal merge" -- and
/// enforced by nothing. That copy is now a thin wrapper over this one, so the
/// assertion is a fact.
fn build_grouped_merged_stmts_impl(source_groups: Array[(String, Array[(String, String)])], disjoint_offset_spaces: Bool, flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int], stmt_file_id_out: Array[Int]) -> Array[Stmt] with Exception {
  // #2205: the rename table describes ONE merged program.
  namespace_rename_originals_reset()
  let merged = array_empty()
  // #716: the plan spans ALL groups (imports cross group boundaries), so the
  // flat source list is parsed once here and reused per group.
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  let fallback_clone_offset_delta = [0]
  // Keep one authoritative parsed copy per file for both the ordinary merge
  // contribution and alias-collision fallback definitions. The GC variant
  // rebases the whole table up front, so no later helper can accidentally
  // reintroduce source-relative offsets by reparsing a provider.
  let located_file_stmts = if disjoint_offset_spaces {
    let out = array_empty()
    let mut offset_base = 0
    let mut source_idx = 0
    while source_idx < Array::length(flat_sources) {
      Array::push(out, shift_stmts_offsets(Array::get(file_stmts, source_idx), offset_base))
      // #2391: report each flat file's offset base so a caller can shift
      // per-module offset tables (module_typed_lowering_offsets_for_path, keyed
      // in each file's OWN offset space) into this merge's space.
      Array::push(flat_paths_out, Array::get(file_paths, source_idx))
      Array::push(flat_bases_out, offset_base)
      let (_, source) = Array::get(flat_sources, source_idx)
      // A source of N bytes occupies [base, base + N). The extra byte keeps
      // even an offset exactly at EOF disjoint from the following file.
      offset_base = offset_base + String::length(source) + 1
      source_idx = source_idx + 1
    }
    Array::set(fallback_clone_offset_delta, 0, offset_base)
    out
  } else {
    file_stmts
  }
  let fallback_clone_offset_span = Array::get(fallback_clone_offset_delta, 0)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  // #740: the is-entry flag must mean "the LAST file of the WHOLE merge"
  // (the plan entry, whose exports stay unrenamed). It was `si ==
  // source_count - 1` — the last file of EVERY GROUP — so every group
  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its
  // export renames while callers were rewritten to the renamed names:
  // "undefined variable (local): <name>_exp_<path>" at codegen.
  let flat_total = Array::length(file_paths)
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let path = Array::get(file_paths, flat_idx)
      let stmts = Array::get(located_file_stmts, flat_idx)
      let before = Array::length(merged)
      // Every parser offset is relative to one file. The GC checker's
      // call-result table is keyed by those offsets, so merging files without
      // rebasing lets one file's Double call classify another file's Int call.
      // Shift before the namespace/import rewrites; they preserve locations.
      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources, located_file_stmts, fallback_clone_offset_delta, fallback_clone_offset_span, flat_paths_out, flat_bases_out, clone_float_offsets_out)
      // Everything this file contributed, including the alias-collision
      // fallback definitions it pulls in from providers, belongs to it: they
      // are emitted into this file's region and rewritten against its imports.
      let mut prov_k = before
      while prov_k < Array::length(merged) {
        Array::push(stmt_file_id_out, flat_idx)
        prov_k = prov_k + 1
      }
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  merged
}

fn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with Exception {
  build_grouped_merged_stmts_impl(source_groups, false, array_empty(), array_empty(), array_empty(), array_empty())
}

fn build_grouped_merged_stmts_gc(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with Exception {
  build_grouped_merged_stmts_impl(source_groups, true, array_empty(), array_empty(), array_empty(), array_empty())
}

/// #2388 measurement: run every pre-codegen pass on the entry's closure both
/// whole-program and one file at a time from the same state, and report per
/// pass whether the two render identically (prelude_pass_module_oracle_step).
/// Same load, check and merge as compile_file_fs_mode_rc; the split side is
/// re-merged fresh for every pass so the two programs never share a node.
export fn prelude_module_oracle_report_fs(entry_path: String, entry_name: String, pass_limit: Int) -> String with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let (a, _, _, _) = prelude_oracle_merge(source_groups, lc_ignored_paths())
  let mut report = ""
  let mut k = 0
  while k <= pass_limit {
    let (c, files, c_file_id, eq) = prelude_oracle_merge(source_groups, lc_ignored_paths())
    let (eq_offs, eq_keys) = eq
    report = String::concat(report, prelude_pass_module_oracle_step(k, a, c, c_file_id, Array::length(files), entry_name, eq_offs, eq_keys, print_stmt))
    k = k + 1
  }
  report
}

/// #2388 measurement: the same closure through the WHOLE prelude per module.
/// `prelude_module_oracle_report_fs` reports pass by pass from a whole-program
/// state; this one splits once and runs every pass on each file alone, which is
/// the property a real per-module driver needs. One `FULL ...` line plus the
/// keyed comparison.
export fn prelude_module_full_oracle_report_fs(entry_path: String, entry_name: String) -> String with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let (a, _, _, _) = prelude_oracle_merge(source_groups, lc_ignored_paths())
  let module_paths: Array[String] = []
  let (c, files, c_file_id, eq) = prelude_oracle_merge(source_groups, module_paths)
  let (eq_offs, eq_keys) = eq
  // #2633: the closure PRODUCTION uses (`ordinary_lane_module_split`), not the
  // direct-edge-only one. The oracle answers "does the per-module lane
  // reproduce the whole-program one", and the per-module lane production runs
  // has direct imports plus re-export chains, taken from the loader via
  // `module_reexport_deps_fs`.
  //
  // The objection recorded in `oracle_import_closure` is against a TRANSITIVE
  // closure -- A imports B, B imports C privately, and a transitive closure
  // hands A the declarations of C, which no real compile of A exposes. It does
  // not reach this one: direct plus RE-EXPORT edges only is exactly what a real
  // compile of that module sees, so this is not context a module lacks.
  //
  // Measured on `lib/@vibe/cli/entry.vibe`, 369 modules (2026-09-12), the two
  // closures side by side:
  //
  //                        direct-only   exact
  //   keyed content                  1       0
  //   unresolved_exp                83       0
  //   invisible_split                8       2
  //   zero (modules given none)     37      30
  //   decls handed out         121 981 167 382
  //   seen (denominator)        25 556  25 556
  //   missing / extra / collisions 0/0/0   0/0/0
  //
  // `content` reaching 0 is the per-module lane reproducing the whole-program
  // prelude exactly. The row that closed was
  // `parse_contract_program_spans`, whose thrown payload's type comes through
  // `fn_returns` from `allows_outside_entry_error` -- declared in
  // `@vibe/parser/parser_base.vibe` and reaching `contract.vibe` via a
  // RE-EXPORT. It was recorded on #2633 three times as the `__exn_kind_cell`
  // family (#2510's); the shape is that, the cause was this closure.
  //
  // The direct-only figures are a stricter lower bound on what a module needs.
  // That signal is kept HERE, in writing, rather than by measuring a lane
  // production does not run.
  let (import_closure, unresolved_edges) = exact_import_closure(source_groups)
  // The closure is indexed by FLAT SOURCE, the oracle by MERGED FILE ID. They
  // are the same space only because the merge keeps one file entry per flat
  // source; if that ever stops holding, every row would be read for the wrong
  // module and the comparison would be quietly meaningless rather than wrong
  // in a way anyone could see.
  if Array::length(import_closure) != Array::length(files) {
    throw(String::concat("prelude oracle: import closure is indexed by flat source but the merge reports a different file count -- ", String::concat(Int::to_string(Array::length(import_closure)), String::concat(" vs ", Int::to_string(Array::length(files))))))
  } else {
    ()
  }
  let line = prelude_module_full_oracle_line(a, c, c_file_id, Array::length(files), entry_name, eq_offs, eq_keys, import_closure, print_stmt, module_paths)
  String::concat(String::concat(line, "edges_unresolved="), String::concat(Int::to_string(unresolved_edges), "\n"))
}

fn lc_fresh_str_row() -> Array[String] {
  []
}

/// #2388: a dependency naming a `.vpkg` CONTRACT reaches that package's sibling
/// implementations, because the contract is a surface and the merge carries the
/// implementations.
///
/// This is not "siblings share scope" -- they do not, and an explicit relative
/// import is required between them (`scripts/check_package_sibling_scope.sh`).
/// It is that an import OF THE PACKAGE reaches everything the package's
/// contract publishes, which is implemented next to it. Without this a module
/// importing `@vibe/compiler/runtime` got the contract's materialized surface
/// and not the sibling whose return types the prelude reads, which manufactured
/// a difference the per-module lane does not really have.
///
/// NEAREST contract wins: a source under a deeper package belongs to that one,
/// so `runtime/eval_loader/x.vibe` is not reached by importing `runtime`.
fn oracle_expand_contract_dep(dep: String, own: Array[Int], flat: Array[(String, String)], contract_dirs: Array[String]) -> Array[Int] {
  if !String::ends_with(dep, "/index.vpkg") {
    own
  } else {
    let dir = String::substring(dep, 0, String::length(dep) - 11)
    let out = lc_fresh_int_row()
    let mut k = 0
    while k < Array::length(own) {
      Array::push(out, Array::get(own, k))
      k = k + 1
    }
    let mut i = 0
    while i < Array::length(flat) {
      let (path, _) = Array::get(flat, i)
      if String::starts_with(path, String::concat(dir, "/")) && oracle_nearest_contract_dir(path, contract_dirs) == dir && !lc_int_row_has(out, i) {
        Array::push(out, i)
      } else {
        ()
      }
      i = i + 1
    }
    out
  }
}

/// The longest contract directory that is a prefix of `path`.
fn oracle_nearest_contract_dir(path: String, contract_dirs: Array[String]) -> String {
  let mut best = ""
  let mut i = 0
  while i < Array::length(contract_dirs) {
    let d = Array::get(contract_dirs, i)
    if String::starts_with(path, String::concat(d, "/")) && String::length(d) > String::length(best) {
      best = d
    } else {
      ()
    }
    i = i + 1
  }
  best
}

fn lc_fresh_int_row() -> Array[Int] {
  []
}

fn lc_int_row_has(xs: Array[Int], v: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) && !found {
    if Array::get(xs, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #2575 item 2: does the ORDINARY compile lane carry a usable statement to
/// module map? `PROV stmts=<n> ids=<n> files=<n>`, where `ids` equal to `stmts`
/// is the property -- one module id per merged top-level statement, aligned
/// with the array codegen receives.
///
/// This exists because the answer used to be "no, and silently": the lane
/// computed the map, passed `array_empty()` for it, and handed codegen an
/// `empty_dbg_prov()`. Nothing said so. A per-module production driver is
/// blocked on this and not on the driver, so it is worth a counter rather than
/// a comment.
export fn prelude_ordinary_lane_prov_report_fs(entry_path: String) -> String with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let stmt_file_id: Array[Int] = []
  let (merged, _, _, _, _, _) = merged_stmts_and_offsets_prov(source_groups, stmt_file_id)
  let files = flatten_source_groups_local(source_groups)
  String::concat(String::concat("PROV stmts=", Int::to_string(Array::length(merged))), String::concat(String::concat(" ids=", Int::to_string(Array::length(stmt_file_id))), String::concat(" files=", String::concat(Int::to_string(Array::length(files)), "\n"))))
}

/// #2388 measurement: the shape of the import closure the per-module oracle
/// runs under, on its own. `files edges unresolved` -- the number of sources,
/// the total size of the transitive closure, and the dependency edges that
/// could not be placed in the source list.
///
/// Separate from `prelude_module_full_oracle_report_fs` because a per-module
/// run that THROWS (the link finding two different bodies under one key is
/// exactly the outcome worth reporting) would take the count with it, and a
/// narrowing caused by dropped edges reads identically to one caused by the
/// real import graph.
export fn prelude_module_import_closure_report_fs(entry_path: String) -> String with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  // #2633: the closure the full oracle ACTUALLY runs under, so this report
  // cannot describe a different one than the lane it is named for.
  let (closure, unresolved) = exact_import_closure(source_groups)
  let mut edges = 0
  let mut i = 0
  while i < Array::length(closure) {
    edges = edges + Array::length(Array::get(closure, i))
    i = i + 1
  }
  String::concat(String::concat(String::concat("CLOSURE files=", Int::to_string(Array::length(closure))), String::concat(" edges=", Int::to_string(edges))), String::concat(" unresolved=", String::concat(Int::to_string(unresolved), "\n")))
}

/// #2388: for each flat source, the indices of the sources it can see -- its
/// own resolved imports, transitively -- plus the number of dependency edges
/// this could NOT place in that source list.
///
/// This is what turns the per-module oracle's green from the weaker claim ("no
/// module needed anything the whole program did not have") into the real one
/// ("no module needed anything it imports"). The edges come from the LOADER
/// (`load_or_parse_module_header_fs`, the same header scan the FS typecheck
/// lane plans module order with), because the merge drops `SImport` /
/// `SReExport` as already resolved, so they cannot be read back off the merged
/// program.
///
/// ONE HOP. A dep naming a `.vpkg` contract expands to that group's sibling
/// implementations, which are the sources the merge actually carries; nothing
/// else is followed. See the note at the closure itself for why transitive is
/// wrong here.
///
/// The unresolved count is returned rather than swallowed. A dropped edge
/// narrows a module's context, so it can only manufacture a `missing`, never
/// hide one -- but a caller that does not print it cannot tell a closure built
/// from every edge from one built from half of them, and those two greens are
/// not the same claim.
fn oracle_import_closure(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Array[Int]], Int) with Exception + Fs {
  let flat = flatten_source_groups_local(source_groups)
  let n = Array::length(flat)
  // path -> EVERY flat index carrying it, and group key -> that group's flat
  // indices. Every index, not the first: a source that appears in two groups
  // is two modules in the merged program, and an edge to only one of them
  // would give a dependent the declarations of one copy and not the other --
  // a narrowing that looks exactly like a real import boundary (ARCH011).
  let index_of: MutMap[String, Array[Int]] = MutMap::new_string()
  let mut i = 0
  while i < n {
    let (path, _) = Array::get(flat, i)
    match MutMap::get(index_of, path) {
      Some(seats) => Array::push(seats, i),
      None => MutMap::set(index_of, path, [i])
    }
    i = i + 1
  }
  // Every `.vpkg` contract in the flat list, by its directory. An import names
  // a PACKAGE; the declarations it publishes are implemented by that package's
  // sibling sources, and it is those the merge carries.
  let contract_dirs = lc_fresh_str_row()
  i = 0
  while i < n {
    let (path, _) = Array::get(flat, i)
    if String::ends_with(path, "/index.vpkg") {
      Array::push(contract_dirs, String::substring(path, 0, String::length(path) - 11))
    } else {
      ()
    }
    i = i + 1
  }
  let group_members: MutMap[String, Array[Int]] = MutMap::new_string()
  let mut gi = 0
  let mut flat_at = 0
  while gi < Array::length(source_groups) {
    let (key, sources) = Array::get(source_groups, gi)
    let members: Array[Int] = []
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(members, flat_at + si)
      si = si + 1
    }
    flat_at = flat_at + Array::length(sources)
    if MutMap::has(group_members, key) {
      ()
    } else {
      MutMap::set(group_members, key, members)
    }
    gi = gi + 1
  }
  // Direct edges, from the loader's own header scan.
  let direct: Array[Array[Int]] = []
  let mut unresolved = 0
  i = 0
  while i < n {
    let (path, source) = Array::get(flat, i)
    let (dep_paths, _, _) = load_or_parse_module_header_fs(path, source, 0)
    let row: Array[Int] = []
    let mut d = 0
    while d < Array::length(dep_paths) {
      let dep = Array::get(dep_paths, d)
      // A dep names a source, or a `.vpkg` group whose sibling implementations
      // are what the merge actually carries. Either way it resolves to a SET
      // of seats, and every one of them is an edge.
      let seats = match MutMap::get(index_of, dep) {
        Some(found) => oracle_expand_contract_dep(dep, found, flat, contract_dirs),
        None =>
        match MutMap::get(group_members, dep) {
          Some(members) => members,
          None => {
            unresolved = unresolved + 1
            []
          }
        }
      }
      let mut m = 0
      while m < Array::length(seats) {
        let at = Array::get(seats, m)
        if at == i {
          ()
        } else {
          Array::push(row, at)
        }
        m = m + 1
      }
      d = d + 1
    }
    Array::push(direct, row)
    i = i + 1
  }
  // DIRECT edges only -- a module's own imports, not its dependencies'.
  //
  // This used to close transitively, justified as "a module sees what its
  // dependencies re-export". That is wrong as implemented (Codex round on
  // #2623): when A imports B and B imports C PRIVATELY, a transitive closure
  // hands A the declarations of C, which no real compile of A exposes. The
  // oracle could then report agreement only because it was given context a
  // module does not have -- the one failure mode that makes a green
  // meaningless.
  //
  // Closing only across re-export edges would be the exact rule, and the
  // loader's header scan does not distinguish them: it returns a module's deps
  // and its export NAMES, with no record of which deps a dep re-exports. So
  // this takes the safe side instead: direct-only is an UNDER-approximation,
  // and `unresolved` is reported rather than swallowed for the same reason.
  //
  // The approximation is NOT one-sided: it can hide a difference as well as
  // manufacture one, so do not restore an "only manufactures" claim here.
  // Narrowing a module's context changes the EXECUTION PATH, not just the
  // inputs -- a module that cannot see enough defers, and
  // `eq_mint_deferred_into` builds the helper at the link against the
  // concatenated program, which is the whole program. A module that would have
  // synthesized a DIFFERING helper under exact context receives the
  // whole-program one instead, green over a real difference.
  // `prelude_module_oracle_test.vibe` relies on exactly that to make a module
  // defer on demand.
  //
  // So the oracle's zero supports "the LINKED program equals the whole-program
  // one" -- the question a per-module driver has -- and not "every module
  // synthesized faithfully". `SYNTH deferred=` / `minted=` separate the two by
  // counting how much of the green is the link's work.
  // Measured on the compiler's own CLI closure, and the transitivity was very
  // much load-bearing -- 32017 reachable pairs against 1415 one-hop ones, 22x
  // wider. Under it the split read `missing=1 content=4 invisible_split=2`;
  // with real one-hop context it reads `missing=6 content=9
  // invisible_split=15`. Every one of those extra differences was being hidden
  // by context no module has.
  let out: Array[Array[Int]] = []
  i = 0
  while i < n {
    let row = lc_fresh_int_row()
    let dr = Array::get(direct, i)
    let mut d = 0
    while d < Array::length(dr) {
      let at = Array::get(dr, d)
      if at == i || lc_int_row_has(row, at) {
        ()
      } else {
        Array::push(row, at)
      }
      d = d + 1
    }
    Array::push(out, row)
    i = i + 1
  }
  (out, unresolved)
}

fn eic_dir_of(path: String) -> String {
  let mut cut = 0 - 1
  let mut i = 0
  while i < String::length(path) {
    if String::char_code_at(path, i) == 47 {
      cut = i
    } else {
      ()
    }
    i = i + 1
  }
  if cut < 0 {
    ""
  } else {
    String::substring(path, 0, cut)
  }
}

fn eic_row_holds(row: Array[Int], v: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(row) {
    if Array::get(row, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Is flat index `jpath` reached through one of `re_paths` -- a module's
/// RE-EXPORTED deps?
///
/// The directory arm mirrors `oracle_expand_contract_dep`: a dep naming a
/// `.vpkg` contract expands to that package's sibling implementations, and it
/// is those the merge carries, so a re-exported contract has to admit its
/// siblings or the edge disappears exactly where packages are involved.
fn eic_reexport_admits(re_paths: Array[String], jpath: String) -> Bool {
  let mut ok = false
  let mut i = 0
  while !ok && i < Array::length(re_paths) {
    let rp = Array::get(re_paths, i)
    if rp == jpath {
      ok = true
    } else if String::ends_with(rp, "/index.vpkg") && eic_dir_of(rp) == eic_dir_of(jpath) {
      ok = true
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Everything reachable from `start` across RE-EXPORT edges, accumulated into
/// `row`. Worklist rather than recursion because a re-export cycle is a
/// legal shape and would not otherwise terminate.
fn eic_add_reexport_reach(reexport_rows: Array[Array[Int]], start: Int, self_i: Int, row: Array[Int]) -> Unit {
  let pending: Array[Int] = []
  let seen: Array[Int] = []
  Array::push(pending, start)
  let mut head = 0
  while head < Array::length(pending) {
    let at = Array::get(pending, head)
    head = head + 1
    if eic_row_holds(seen, at) {
      ()
    } else {
      Array::push(seen, at)
      let rr = Array::get(reexport_rows, at)
      let mut k = 0
      while k < Array::length(rr) {
        let next = Array::get(rr, k)
        if next != self_i && !eic_row_holds(row, next) {
          Array::push(row, next)
        } else {
          ()
        }
        Array::push(pending, next)
        k = k + 1
      }
    }
  }
}

/// The closure a PRODUCTION split needs (#2658): a module's direct imports,
/// plus everything reachable from them across RE-EXPORT edges only.
///
/// `oracle_import_closure` is direct-edges-only and explains why at length.
/// That under-approximation is right for a MEASUREMENT and wrong for codegen:
/// a module that imports B and cannot see what B re-exports from C lowers a
/// call to C's bounded generic without the witness argument C's rewritten
/// generic requires (#2647 Codex round 9).
///
/// Closing over ALL edges instead is wrong in both directions. It hands a
/// module its dependencies' PRIVATE imports, which no real compile of it
/// exposes -- and, the reason it matters here rather than only for the
/// oracle, it gives every module the whole program's declarations, which is
/// precisely the live set #2494 exists to bound. The re-export closure is the
/// point that is both correct and minimal.
///
/// The re-export subset comes from the LOADER (`module_reexport_deps_fs`),
/// not from re-reading source text here, so it cannot drift from what the
/// loader actually resolves.
fn exact_import_closure(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Array[Int]], Int) with Exception + Fs {
  let (direct, unresolved) = oracle_import_closure(source_groups)
  let flat = flatten_source_groups_local(source_groups)
  let n = Array::length(flat)
  if Array::length(direct) != n {
    (direct, unresolved)
  } else {
    // Which of each module's direct edges are RE-EXPORT edges. Derived by
    // testing the oracle's already-expanded indices against the loader's
    // resolved re-export paths, so contract expansion is not re-implemented.
    let reexport_rows: Array[Array[Int]] = []
    let mut i = 0
    while i < n {
      let (path, source) = Array::get(flat, i)
      let re_paths = module_reexport_deps_fs(path, source)
      let row: Array[Int] = []
      let dr = Array::get(direct, i)
      let mut d = 0
      while d < Array::length(dr) {
        let j = Array::get(dr, d)
        let (jpath, _) = Array::get(flat, j)
        if eic_reexport_admits(re_paths, jpath) {
          Array::push(row, j)
        } else {
          ()
        }
        d = d + 1
      }
      Array::push(reexport_rows, row)
      i = i + 1
    }
    let out: Array[Array[Int]] = []
    i = 0
    while i < n {
      let row: Array[Int] = []
      let dr = Array::get(direct, i)
      let mut d = 0
      while d < Array::length(dr) {
        let j = Array::get(dr, d)
        if j != i && !eic_row_holds(row, j) {
          Array::push(row, j)
        } else {
          ()
        }
        eic_add_reexport_reach(reexport_rows, j, i, row)
        d = d + 1
      }
      Array::push(out, row)
      i = i + 1
    }
    (out, unresolved)
  }
}

/// A throwaway sink for the path out-param, for callers that do not want it.
fn lc_ignored_paths() -> Array[String] {
  []
}

fn prelude_oracle_merge(source_groups: Array[(String, Array[(String, String)])], out_paths: Array[String]) -> (Array[Stmt], Array[String], Array[Int], (Array[Int], Array[String])) with Exception {
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let (merged, files, _, stmt_file_id) = build_grouped_merged_stmts_prov(source_groups, flat_paths, flat_bases, clone_float_offsets)
  let (_, rels, pluses, _, _) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths, flat_bases, clone_float_offsets))
  let (eq_offs, eq_keys) = union_module_typed_eq_rows(flat_paths, flat_bases)
  let stmts = rewrite_string_binops_stmts(merged, rels, pluses, typed_lowering_binop_anchor)
  if Array::length(stmts) != Array::length(stmt_file_id) {
    throw("prelude oracle: the binop rewrite changed the statement count")
  } else {
    ()
  }
  // #2704: the SOURCE PATHS, in merged-file-id order. `flat_paths` is filled
  // from the very `file_paths` array the merge mangles with
  // (`build_grouped_merged_stmts_impl` pushes `file_paths[source_idx]`), so
  // `sanitize_namespace_path` of one of these IS a module's stamp -- no
  // parsing, no ambiguity. `files` is NOT this: it is `path_basename(...)`.
  let mut fp = 0
  while fp < Array::length(flat_paths) {
    Array::push(out_paths, Array::get(flat_paths, fp))
    fp = fp + 1
  }
  (stmts, files, stmt_file_id, (eq_offs, eq_keys))
}

/// #2391: the merge every offsets-consuming linear FS lane shares -- each file
/// rebased into a disjoint offset range (same rebase as the gc lane, #2226) so
/// the per-module offset tables union without collisions. Returns the merged
/// program -- with the typed String-binop rewrite (slice 2) already applied:
/// `a < b` becomes `str_lex_diff(a, b) < 0` and `a + b` becomes
/// `String::concat(a, b)` exactly where the modular check recorded a String
/// operand, the same forms the desugar tracker emits for the shapes it can
/// classify syntactically -- plus the Double call-result offset table for
/// codegen. The rewrite anchors with the checker's own channel anchor
/// (typed_lowering_binop_anchor), so
/// both sides compute the anchor identically by construction.
fn merged_stmts_and_offsets(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Exception {
  merged_stmts_and_offsets_prov(source_groups, array_empty())
}

/// #2575 item 2: the same merge, keeping the per-statement MODULE id.
///
/// The ordinary lane computed that map and threw it away -- the out-parameter
/// was `array_empty()` -- and then handed codegen an `empty_dbg_prov()`. So the
/// information a per-module driver needs was being produced and discarded on
/// the one path that matters, which is why "wire the per-module prelude" looked
/// like a driver problem and is really a plumbing one.
///
/// `stmt_file_id_out` stays optional: a caller that does not want the map
/// passes `array_empty()` and pays nothing. One `Int` per top-level statement
/// when it does -- about 79 kB on the compiler's own closure, against a
/// selfcompile heap of ~814 MiB.
///
/// The binop rewrite below does not change the statement count (the oracle's
/// merge asserts exactly that), so the ids stay aligned with what it returns.
fn merged_stmts_and_offsets_prov(source_groups: Array[(String, Array[(String, String)])], stmt_file_id_out: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Exception {
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let merged = build_grouped_merged_stmts_impl(source_groups, true, flat_paths, flat_bases, clone_float_offsets, stmt_file_id_out)
  let (floats, rels, pluses, int_renders, bool_renders) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths, flat_bases, clone_float_offsets))
  // #2441: the typed-`==` rows ride the same disjoint offset spaces.
  let (eq_offs, eq_keys) = union_module_typed_eq_rows(flat_paths, flat_bases)
  (rewrite_string_binops_stmts(merged, rels, pluses, typed_lowering_binop_anchor), floats, int_renders, bool_renders, eq_offs, eq_keys)
}

/// The statement filter `build_module_source` (runtime.vibe) applies while
/// reprinting: a module keeps its top-level function bindings and the
/// serialized builtin-iterator boundary markers, and nothing else.
///
/// #2437: lifted out of the reprint so the statement merge can be filtered
/// directly. Selecting statements preserves every node offset, which is what
/// lets the rebased typed-lowering tables still name the right nodes. Kept
/// byte-identical to `fs_compile`'s copy on purpose -- the two lanes must
/// agree on what a module contains.
/// #2621 review: the typed-lowering tables belong IN the artifact key.
///
/// The key is derived from `print_program(filtered)`, and
/// `module_lane_filter_stmts` drops everything that is not a top-level function
/// binding -- type aliases included. So two programs that differ only in a
/// DROPPED declaration print identically:
///
///   type Value = Int      let render: (Value) -> String = (v) -> { __to_string(v) }
///   type Value = Bool     let render: (Value) -> String = (v) -> { __to_string(v) }
///
/// The retained text is the same; the Int-render and Bool-render channels are
/// not. On a shared `TypeDb`, the second compile would hit the first's artifact
/// and emit the first program's lowering for the second program's types.
///
/// Folding the tables in costs one pass over three small Int arrays and makes
/// the key a function of everything codegen actually reads, rather than of the
/// text alone. Cheaper and narrower than hashing the whole checked input.
fn typed_offsets_key(floats: Array[Int], ints: Array[Int], bools: Array[Int]) -> String {
  let out = StringBuilder::new()
  let mut k = 0
  while k < 3 {
    let table = if k == 0 {
      floats
    } else if k == 1 {
      ints
    } else {
      bools
    }
    StringBuilder::push(out, "|")
    let mut i = 0
    while i < Array::length(table) {
      StringBuilder::push(out, Int::to_string(Array::get(table, i)))
      StringBuilder::push(out, ",")
      i = i + 1
    }
    k = k + 1
  }
  StringBuilder::freeze(out)
}

fn module_lane_filter_stmts(stmts: Array[Stmt]) -> Array[Stmt] {
  let filtered = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let keep = match stmt {
      SLet(_, _, _, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => true,
        _ => false
      },
      _ => builtin_iterator_serialized_boundary_markers(stmt) is Some(_)
    }
    if keep {
      Array::push(filtered, stmt)
    } else {
      ()
    }
    i = i + 1
  }
  filtered
}

/// Interior-line breakpoints (span-arc step5): the basename of a file path (text
/// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a
/// `--break <file>:<line>` spec against. String::concat-free (substring only).
fn path_basename(p: String) -> String {
  let n = String::length(p)
  let mut last = 0 - 1
  let mut i = 0
  while i < n {
    if String::char_code_at(p, i) == 47 {
      last = i
    } else {
      ()
    }
    i = i + 1
  }
  String::substring(p, last + 1, n)
}

/// Interior-line breakpoints: sorted char-offsets of each '\n' in `src` (local
/// copy of the codegen helper, to avoid an entry->codegen import).
fn file_newline_offsets(src: String) -> Array[Int] {
  let arr = array_empty()
  let n = String::length(src)
  let mut i = 0
  while i < n {
    if String::char_code_at(src, i) == 10 {
      Array::push(arr, i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}

/// Interior-line breakpoints (span-arc step5, multi-file): like
/// build_grouped_merged_stmts but ALSO records, per merged top-level statement,
/// which SOURCE FILE it came from — so codegen can map each statement's char
/// offset to a line IN ITS OWN FILE (offsets from different files collide after
/// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):
///   file_basenames[k] / file_newlines[k]  — the k-th distinct source file
///   stmt_file_id[s]                        — file id of merged top-level stmt s
/// Provenance is captured by measuring the merged-array length delta around each
/// source's append, so it stays aligned no matter how many statements a source
/// contributes; the append calls themselves mirror the ordinary offsets merge
/// exactly, so `merged` is identical to the normal (rc/bump) path.
///
/// #2391: the merge is disjoint-rebased like the ordinary path, and each
/// file's NEWLINE table is shifted by the same base. `offset_to_line` only
/// compares newline offsets against statement offsets, so shifting both
/// sides by one base leaves every computed line number unchanged -- the
/// break lane keeps its per-file line mapping with no codegen change, and
/// the float-offset union (via the caller-passed sinks, same contract as
/// build_grouped_merged_stmts_impl) speaks the same offset space.
/// #2388: the merge plus the per-file debug provenance the break lane needs --
/// `files[k]` the basename of flat source k, `file_nls[k]` its newline offsets
/// already shifted into the merge's offset space, `stmt_file_id[s]` the flat
/// source that owns merged statement s.
///
/// This used to be a SECOND COPY of build_grouped_merged_stmts_impl with the
/// provenance collection interleaved, carrying a comment promising that its
/// `merged` "stays identical to the normal (non-break) merge" -- a property
/// nothing checked, between two bodies that had to be edited in step. It is a
/// wrapper now, so the promise holds by construction.
///
/// `files` and `file_nls` are derived here rather than inside the merge
/// because a newline table costs a scan of every source byte, and only the
/// break lane reads one. The bases come from the merge's own
/// `flat_bases_out`: its first `Array::length(flat_sources)` entries are the
/// per-source offset bases, recorded before the append loop runs (the
/// alias-collision fallback appends further entries after those, which is why
/// the count is taken from the sources and not from the array's length).
fn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])], flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with Exception {
  let stmt_file_id = array_empty()
  let merged = build_grouped_merged_stmts_impl(source_groups, true, flat_paths_out, flat_bases_out, clone_float_offsets_out, stmt_file_id)
  let flat_sources = flatten_source_groups_local(source_groups)
  let files = array_empty()
  let file_nls = array_empty()
  let mut si = 0
  while si < Array::length(flat_sources) {
    let (flat_path, flat_source) = Array::get(flat_sources, si)
    Array::push(files, path_basename(flat_path))
    let base = if si < Array::length(flat_bases_out) {
      Array::get(flat_bases_out, si)
    } else {
      0
    }
    let nls = file_newline_offsets(flat_source)
    let mut nli = 0
    while nli < Array::length(nls) {
      Array::set(nls, nli, Array::get(nls, nli) + base)
      nli = nli + 1
    }
    Array::push(file_nls, nls)
    si = si + 1
  }
  (merged, files, file_nls, stmt_file_id)
}

fn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck(seeded, entry_path)
}

fn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception + Fs {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck_fs(seeded, entry_path)
}

export fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
}

/// #946 P1 (Codex, PR #1006): `vibe check`'s "linked" dep collection
/// (collect_linked_dep_inputs_for_stmts, in linked_artifacts.vibe) exists to
/// feed the wasm import-linking codegen boundary -- it copies a dependency's
/// SEnum/struct declarations into the checked stmts but never a `let rec fn`
/// signature, so check_program never learned an imported function's real
/// type and a wrong-typed call site (e.g. `f("x")` against `fn f(x: Int)`)
/// typechecked cleanly no matter what was passed. Reuse prepare_file_fs_cached's
/// fs-mode source-group + db_typecheck_fs pipeline instead -- the same one
/// compile_file_fs_mode already relies on for a real compile's (working)
/// typecheck pass -- and stop before build_grouped_merged_stmts/codegen.
export fn check_file_fs_mode_from_source_groups(entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception + Fs {
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  // #1536(c) / #1511(b): after the typecheck passes, run the ADR-0076
  // effect-lowering eligibility passes (suspend CPS split + evidence-passing
  // migration) on the SAME merged program a release compile lowers
  // (build_grouped_merged_stmts over the same source_groups), via the same
  // shared prelude compile_wasi_module_linked_impl runs — so a handle/suspend
  // shape codegen would reject is reported here, at `vibe check`, instead of
  // typechecking cleanly and first failing in codegen. The merged AST is
  // discarded afterwards (the prelude rewrites it in place); no wasm is
  // produced. Entry name "main" matches what `vibe build`/`vibe run` compile
  // with; a program with no `main` simply has no entry-keyed boundary
  // machinery installed, same as its real compile would.
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  let lowering_errs = effect_lowering_prelude(merged_stmts, "main", array_empty(), array_empty(), array_empty(), array_empty(), array_empty())
  if Array::length(lowering_errs) > 0 {
    throw(Array::get(lowering_errs, 0))
  } else {
    ()
  }
  0
}

export fn check_file_fs_mode(entry_path: String) -> Int with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  check_file_fs_mode_from_source_groups(entry_path, source_groups)
}

/// #2158/#2391: this lane's codegen is untyped, so a `Double` that arrives
/// through a call renders as its raw f64 bits without help.
/// `CompileCtx.float_call_offsets` is the channel that fixes it -- the
/// checker's per-call-site type, keyed by source offset -- and here it is fed
/// by the MODULAR check this lane already runs
/// (`prepare_file_fs_from_source_groups_persistent_cached`): check_module
/// retains each module's Double call-result offsets in that module's own
/// offset space, and `merged_stmts_and_float_offsets` rebases every file into
/// a disjoint offset range (the same rebase the gc lane uses, #2226) and
/// unions the tables. No whole-program re-check is involved.
///
/// That shape is a MEASURED choice, twice. Adding a whole-program re-check of
/// the merged program instead cost 6.12s -> 77.55s at #2158 time; re-measured
/// on 2026-08-30 (this repo, codegen_lexer_test's full-compiler closure,
/// interleaved runs) it still cost ~5.6x warm (5.8s -> 32.6s) and ~3.8x cold,
/// needed a 128MB host stack (the recursive whole-program checker exhausts
/// the default stack on a compiler-sized merged program), and mutated the
/// merged AST enough to change the emitted wasm. The modular carry costs a
/// per-module capture inside a check that was already running, and the
/// persistent halves (TypeEnv + offsets sidecar) are required TOGETHER by
/// every reuse arm, so cache state can never change what a compile emits.
/// `unique_typed_lowering_offsets_in_stmts` (codegen/common_analysis) still drops any
/// offset that names more than one call node, so a partial answer degrades to
/// the pre-#2158 syntactic classifier rather than to a wrong one.
export fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl_with_typed_offsets(pruned_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

/// Import-resolving wasm-gc compilation. Module discovery, projected import
/// environments, and namespace projection are the same ones used by the
/// linear filesystem lane. The GC variant additionally rebases every file's
/// located AST into a disjoint offset range before merging. The checker and
/// codegen can then share a call-result table without either transferring a
/// Double classification to an Int call or discarding a valid Double hint.
export fn compile_file_fs_mode_gc(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts_gc(source_groups)
  compile_generated_stmts_gc_only(merged_stmts, entry_name)
}

/// #701 RC variant: same load/merge as compile_file_fs_mode "no-dce" but routes
/// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an
/// import-resolving / `vibe run` program actually honors VIBE_RC. Without this
/// the FS-compile path silently used the bump allocator regardless of VIBE_RC.
export fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  // #2158/#2391: this is the lane `vibe test` and `vibe run` actually take --
  // the adapter routes anything but an explicit `VIBE_RC=0` here, since
  // `VIBE_RC` unset is `"" != "0"`. The checker's Double call-result offsets
  // ride the modular check; see compile_file_fs_mode above for the design and
  // the measurements.
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_rc_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
}

/// #2388 step 3: like the rc lane's merge, but ALSO reports, per flat source
/// file, its path, its content fingerprint, how many merged top-level
/// statements it contributed -- measured by length delta around each append,
/// the same technique build_grouped_merged_stmts_prov uses, so the counts
/// stay aligned however many statements a file contributes -- and (#2391) its
/// disjoint offset base for the float-offset union. `merged` is identical to
/// the ordinary rc lane's (merged_stmts_and_float_offsets).
fn build_grouped_merged_stmts_counted(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[String], Array[Int], Array[Int], Array[Int]) with Exception {
  namespace_rename_originals_reset()
  let merged = array_empty()
  let out_paths = array_empty()
  let out_fps = array_empty()
  let out_counts = array_empty()
  let clone_float_offsets_out: Array[Int] = []
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  // #2391: mirror build_grouped_merged_stmts_impl's disjoint-offset rebase,
  // so the body-cached lane's `merged` stays byte-identical to the ordinary
  // rc lane's (codegen_body_cache_persist_test compares the two), and record
  // each file's base for the float-offset union. The paths/fps rows are
  // filled HERE, not in the append loop below, so the table is complete
  // before the first append -- an alias-collision clone may reference a
  // provider LATER in the flat order than the importing file.
  let located_file_stmts = array_empty()
  let out_bases: Array[Int] = []
  let mut offset_base = 0
  let mut source_idx = 0
  while source_idx < Array::length(flat_sources) {
    Array::push(located_file_stmts, shift_stmts_offsets(Array::get(file_stmts, source_idx), offset_base))
    let (flat_path, flat_source) = Array::get(flat_sources, source_idx)
    Array::push(out_paths, flat_path)
    Array::push(out_fps, compact_source_fingerprint_memo(flat_path, flat_source))
    Array::push(out_bases, offset_base)
    offset_base = offset_base + String::length(flat_source) + 1
    source_idx = source_idx + 1
  }
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let fallback_clone_offset_delta = [offset_base]
  let fallback_clone_offset_span = offset_base
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let (path, _) = Array::get(sources, si)
      let before = Array::length(merged)
      append_merged_stmts_for_file(merged, path, Array::get(located_file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources, located_file_stmts, fallback_clone_offset_delta, fallback_clone_offset_span, out_paths, out_bases, clone_float_offsets_out)
      Array::push(out_counts, Array::length(merged) - before)
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  (merged, out_paths, out_fps, out_counts, out_bases, clone_float_offsets_out)
}

//# #2388 step 3: codegen body-cache artifact (wrapper codec)
//
// The stored artifact is self-describing: a per-file table (path, content
// fingerprint, merged-statement count, in merge order) followed by the
// CodegenBodyCache blob. It is stored under ONE fixed artifact fingerprint
// per entry -- the point is to be loadable when the sources DID change --
// and the per-file table inside decides how much of the cache is still
// valid. The persistent-cache version tag already keys the store on the
// compiler's own codegen fingerprint, so an artifact can never cross
// compiler versions.

fn bcw_push_int(buf: Bytes, v: Int) -> Unit with Exception {
  if v < 0 {
    throw(String::concat("body-cache wrapper: negative field ", __to_string(v)))
  } else {
    ()
  }
  let mut x = v
  let mut more = true
  while more {
    let low = x&127
    x = x>>7
    if x == 0 {
      Bytes::push(buf, low)
      more = false
    } else {
      Bytes::push(buf, low|128)
    }
  }
}

fn bcw_push_string(buf: Bytes, s: String) -> Unit with Exception {
  bcw_push_int(buf, String::length(s))
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(buf, String::char_code_at(s, i))
    i = i + 1
  }
}

fn bcw_read_int(b: Bytes, pos: Int) -> (Int, Int) {
  let n = Bytes::length(b)
  let mut p = pos
  let mut shift = 0
  let mut acc = 0
  let mut done = false
  let mut bad = false
  while !done && !bad {
    if p >= n || shift > 34 {
      bad = true
    } else {
      let byte = Bytes::get(b, p)
      p = p + 1
      acc = acc|((byte&127)<<shift)
      shift = shift + 7
      if (byte&128) == 0 {
        done = true
      } else {
        ()
      }
    }
  }
  if bad {
    (0, 0 - 1)
  } else {
    (acc, p)
  }
}

fn bcw_read_string(b: Bytes, pos: Int) -> (String, Int) {
  let (len, p0) = bcw_read_int(b, pos)
  if p0 < 0 || len < 0 || p0 + len > Bytes::length(b) {
    ("", 0 - 1)
  } else {
    let parts = array_empty()
    let mut i = 0
    while i < len {
      Array::push(parts, String::from_byte(Bytes::get(b, p0 + i)))
      i = i + 1
    }
    (String::join(parts, ""), p0 + len)
  }
}

/// Content checksum over `b[start..)`: the same dual-modulus rolling shape
/// as compact_string_fingerprint, over bytes. Guards the artifact against
/// same-length corruption that the length-prefixed framing cannot see -- a
/// bit flip inside a cached body would otherwise replay as wrong
/// instructions under `on` mode.
fn bcw_checksum(b: Bytes, start: Int) -> (Int, Int) {
  let mut h1 = 17
  let mut h2 = 29
  let n = Bytes::length(b)
  let mut i = start
  while i < n {
    let byte = Bytes::get(b, i)
    h1 = (h1 * 131 + byte) % 2147483647
    h2 = (h2 * 137 + byte) % 2147483629
    i = i + 1
  }
  (h1, h2)
}

fn encode_body_cache_artifact(paths: Array[String], fps: Array[String], counts: Array[Int], cache: CodegenBodyCache) -> Bytes with Exception {
  // Payload first, so the header can carry its checksum. The checksum
  // covers the WHOLE payload -- the per-file table included, because a
  // corrupted statement count would corrupt the replay limit just as
  // silently as a corrupted body.
  let payload = Bytes::new()
  bcw_push_int(payload, Array::length(paths))
  let mut i = 0
  while i < Array::length(paths) {
    bcw_push_string(payload, Array::get(paths, i))
    bcw_push_string(payload, Array::get(fps, i))
    bcw_push_int(payload, Array::get(counts, i))
    i = i + 1
  }
  Bytes::append(payload, codegen_body_cache_to_bytes(cache))
  let (h1, h2) = bcw_checksum(payload, 0)
  let buf = Bytes::new()
  Bytes::push(buf, 'V')
  Bytes::push(buf, 'B')
  Bytes::push(buf, 'W')
  Bytes::push(buf, '2')
  bcw_push_int(buf, h1)
  bcw_push_int(buf, h2)
  Bytes::append(buf, payload)
  buf
}

/// Decode the stored artifact and cut it down to what the CURRENT compile may
/// replay: the longest leading run of files whose path, content fingerprint,
/// and merged-statement count all match gives the unchanged merged-statement
/// prefix, and only cached bodies compiled from below that boundary survive
/// (codegen_body_cache_filter_src_below also drops synthesized and pad
/// entries via the recorded guards). Anything malformed answers an empty
/// cache -- a damaged artifact costs a recompile, never a wrong body.
fn decode_body_cache_artifact_for(b: Bytes, paths: Array[String], fps: Array[String], counts: Array[Int]) -> CodegenBodyCache {
  if Bytes::length(b) < 4 || Bytes::get(b, 0) != 'V' || Bytes::get(b, 1) != 'B' || Bytes::get(b, 2) != 'W' || Bytes::get(b, 3) != '2' {
    codegen_body_cache_new()
  } else {
    let (stored_h1, ph1) = bcw_read_int(b, 4)
    let (stored_h2, ph2) = if ph1 < 0 {
      (0, 0 - 1)
    } else {
      bcw_read_int(b, ph1)
    }
    let checksum_ok = if ph2 < 0 {
      false
    } else {
      let (h1, h2) = bcw_checksum(b, ph2)
      h1 == stored_h1 && h2 == stored_h2
    }
    if !checksum_ok {
      codegen_body_cache_new()
    } else {
      decode_body_cache_payload_for(b, ph2, paths, fps, counts)
    }
  }
}

fn decode_body_cache_payload_for(b: Bytes, payload_start: Int, paths: Array[String], fps: Array[String], counts: Array[Int]) -> CodegenBodyCache {
  let (file_n, p0) = bcw_read_int(b, payload_start)
  if p0 < 0 {
    codegen_body_cache_new()
  } else {
    let mut p = p0
    let mut i = 0
    let mut limit = 0
    let mut still_matching = true
    let mut malformed = false
    // #2669 step 2b. `layout_same` is the condition under which this build's
    // FILE INDICES are the harvest's: every file present, in order,
    // contributing the same number of merged statements. Only the file
    // CONTENTS may differ. A cached entry names its file by index
    // (`fn_files`), so without this the map below would be read against a
    // different file list -- and the statement counts are in it because a
    // changed count moves the pin region and the synthesized statements with
    // it, which the codegen guards would reject anyway.
    let mut layout_same = file_n == Array::length(paths)
    let keep_file = array_empty()
    while !malformed && i < file_n {
      let (spath, p1) = bcw_read_string(b, p)
      let (sfp, p2) = if p1 < 0 {
        ("", 0 - 1)
      } else {
        bcw_read_string(b, p1)
      }
      let (scount, p3) = if p2 < 0 {
        (0, 0 - 1)
      } else {
        bcw_read_int(b, p2)
      }
      if p3 < 0 {
        malformed = true
      } else {
        p = p3
        let positioned = i < Array::length(paths) && spath == Array::get(paths, i) && scount == Array::get(counts, i)
        let unchanged = positioned && sfp == Array::get(fps, i)
        if !positioned {
          layout_same = false
        } else {
          ()
        }
        Array::push(keep_file, if unchanged {
          1
        } else {
          0
        })
        if still_matching && unchanged {
          limit = limit + scount
        } else {
          still_matching = false
        }
      }
      i = i + 1
    }
    if malformed || (!layout_same && limit == 0) {
      codegen_body_cache_new()
    } else {
      match codegen_body_cache_from_bytes(Bytes::slice(b, p, Bytes::length(b))) {
        Some(cache) => {
          let kept = if layout_same {
            codegen_body_cache_filter_src_keep(cache, keep_file)
          } else {
            codegen_body_cache_filter_src_below(cache, limit)
          }
          // What the leading unchanged run was, for the body loop to narrow
          // back to if the layout guards it checks do not hold. Set on both
          // branches: the wide set is a superset of the prefix, so the
          // fallback is meaningful either way.
          Array::push(kept.consumer_src_limit, limit)
          kept
        },
        None => codegen_body_cache_new()
      }
    }
  }
}

/// #2388 step 3: compile_file_fs_mode_rc with the cross-compile codegen body
/// cache. `cache_mode` comes from the CLI adapter's VIBE_CODEGEN_BODY_CACHE
/// read (this layer stays Env-free, #634):
///
///   "verify" -- compile everything fresh, then compile AGAIN replaying the
///     persisted bodies, and throw on the first byte the two outputs differ
///     at. Proves the replay lane end-to-end on real edits at double compile
///     cost; the returned bytes are always the fresh compile's.
///   "on" -- replay persisted bodies directly. The recorded guards
///     (pin region shape, lambda slot base, synthesized names and
///     positions) drop the cache wholesale on any layout drift.
///
/// Either way the artifact is refreshed with this compile's harvest, under
/// an artifact key scoped to the entry PATH but not to source content --
/// the per-file table INSIDE the artifact is what decides validity next
/// time, because the whole point is to be usable when the sources changed
/// (a source-keyed fingerprint would only ever hit when nothing changed at
/// all). The artifact carries a payload checksum; any corruption -- a
/// same-length bit flip in a cached body included -- decodes as an empty
/// cache and recompiles.
/// #2388 step 3: full guard-set equality between two caches. Used where the
/// consuming compile's own validation cannot run: the verify lane's second
/// compile re-feeds the already-lowered stmts, where linked_compile's guard
/// validation legitimately stands down (the pin reorder is a no-op there),
/// so expected guard drift from an edit must be turned into a cache miss
/// HERE, against the fresh harvest's guards -- not left to throw as a
/// verify mismatch. Also decides whether a consumed cache may be merged
/// back into the refreshed artifact.
///
/// #2669 step 2b: `guard_typed_lowering` is deliberately NOT part of this.
/// It is a per-FILE vector, and the file that was edited legitimately moves
/// its own slot on every edit -- comparing it elementwise would refuse every
/// merge there is. That comparison happens where the file list is, at the
/// decode, and drops exactly the files whose classification moved.
fn body_cache_guards_equal(a: CodegenBodyCache, b: CodegenBodyCache) -> Bool {
  body_cache_guards_equal_except_layout(a, b) && bcc_int_lists_equal(a.guard_layout, b.guard_layout)
}

/// #2669 step 2b: the guard set MINUS `guard_layout`, which is exactly the
/// set that decides whether the leading PREFIX was replayable.
///
/// The body loop narrows to that prefix when a layout guard drifts, so those
/// functions are replayed and therefore absent from the fresh harvest. Asking
/// the full set before merging would then persist an artifact with a hole in
/// it, and the next completely unchanged build would recompile the prefix for
/// no reason (Codex P2 on this PR).
fn body_cache_guards_equal_except_layout(a: CodegenBodyCache, b: CodegenBodyCache) -> Bool {
  Array::length(a.guard_meta) == 5 && bcc_int_lists_equal(a.guard_meta, b.guard_meta) && bcc_string_lists_equal(a.guard_synth_names, b.guard_synth_names) && bcc_int_lists_equal(a.guard_synth_stmts, b.guard_synth_stmts) && bcc_string_lists_equal(a.guard_import_names, b.guard_import_names) && bcc_string_lists_equal(a.guard_borrow_names, b.guard_borrow_names) && bcc_int_lists_equal(a.guard_borrow_masks, b.guard_borrow_masks) && bcc_string_lists_equal(a.guard_unmangled_names, b.guard_unmangled_names)
}

/// #2669 step 2b (Codex P0): stamp this compile's per-module classification
/// onto a harvest, but only one that recorded the rest of the guards -- a
/// harvest with no `guard_meta` is in-process-only and must not look
/// cross-compile usable because of a column this layer added.
fn record_typed_lowering_guard(cache: CodegenBodyCache, rows: Array[Int]) -> Unit {
  Array::truncate(cache.guard_typed_lowering, 0)
  if Array::length(cache.guard_meta) == 5 {
    let mut i = 0
    while i < Array::length(rows) {
      Array::push(cache.guard_typed_lowering, Array::get(rows, i))
      i = i + 1
    }
  } else {
    ()
  }
}

/// #2669 step 2b (Codex P0): the checker's per-module typed-lowering tables,
/// fingerprinted in each module's OWN coordinates, six slots per file.
///
/// The merged tables `union_module_typed_lowering_with_clones` produces are
/// positions in the MERGED text, so a comment anywhere shifts every offset
/// after it -- folding those into the codegen guard made a comment-only edit
/// decline the whole widened lane. These are the same rows before the rebase,
/// so a file's contribution moves only when THAT file's own classification
/// moves, which is the property the guard needs.
///
/// It is the CLASSIFICATION that has to be pinned, not the positions: a callee
/// that changes from `Int` to `Bool` keeps its name, arity and scalar-return
/// classification, so no name-keyed table separates the two, while every
/// render and `eq` argument fed by it changes tag.
///
/// Measured on a two-file chain, reading the UNTOUCHED consumer's rows while
/// editing the callee's file: a comment, a same-length body edit and a body
/// edit that lengthens the file all leave them at `[715]`, and the `Int` to
/// `Bool` change moves them to `[717]`. So the rows track the interfaces a
/// module reads and not the bytes anyone else adds -- which is what makes the
/// per-file comparison at the decode both able to see the interface change and
/// quiet on every ordinary edit. Pinned by
/// `tests/typed_lowering_rows_interface_test.vibe`.
///
/// The memo these read is populated by the check that just ran and reset at
/// the start of each walk, so a file with no row contributes an empty slot --
/// which is what a module that classified nothing has, and is stable.
fn typed_lowering_guard_for_files(file_paths: Array[String]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(file_paths) {
    let path = Array::get(file_paths, i)
    match module_typed_lowering_offsets_for_path(path) {
      Some(offsets) => bcc_layout_fp_ints(out, offsets),
      None => bcc_layout_fp_ints(out, array_empty())
    }
    match module_typed_eq_rows_for_path(path) {
      Some((eq_offs, eq_keys)) => {
        bcc_layout_fp_ints(out, eq_offs)
        bcc_layout_fp_strings(out, eq_keys)
      },
      None => {
        bcc_layout_fp_ints(out, array_empty())
        bcc_layout_fp_strings(out, array_empty())
      }
    }
    i = i + 1
  }
  out
}

/// #2575 item 2: the ordinary lane's statement-to-module map, as a `DbgProv`.
///
/// This is the input `prelude_run_per_module` needs and no production compile
/// could give it: `effect_lowering_prelude` takes only the merged statement
/// array, so nothing downstream can split it by module.
///
/// It costs an expansion and no new merge work. `file_counts[i]` is how many
/// merged top-level statements flat file `i` contributed, in merge order --
/// `build_grouped_merged_stmts_counted` already produces it because the
/// codegen body cache needs the same table -- so the per-statement ids are a
/// run-length decode of something this lane holds either way.
///
/// `file_nls` is deliberately EMPTY. The per-file newline tables are the
/// expensive half of the break lane's provenance (one offset array per source,
/// rebased) and exist to map a LINE; a per-module prelude needs only which
/// module a statement came from.
///
/// Alignment holds across `elaborate_heap_params`, which runs between this and
/// the owner scan that reads it: that pass pushes exactly one statement per
/// input statement, so the count and order it hands on are the merge's.
/// `linked_compile_prov_inert_test.vibe` pins that, because an edit there
/// would silently misalign every id rather than fail.
fn ordinary_lane_dbg_prov(file_paths: Array[String], file_counts: Array[Int]) -> DbgProv {
  let files = array_empty()
  let stmt_file_id = array_empty()
  let mut i = 0
  while i < Array::length(file_paths) && i < Array::length(file_counts) {
    Array::push(files, path_basename(Array::get(file_paths, i)))
    let n = Array::get(file_counts, i)
    let mut k = 0
    while k < n {
      Array::push(stmt_file_id, i)
      k = k + 1
    }
    i = i + 1
  }
  DbgProv::{ files: files, file_nls: array_empty(), stmt_file_id: stmt_file_id }
}

/// #2575 item 2 step 3b: the ordinary FS lane's `ModuleSplit`, or an unusable
/// one.
///
/// `stmt_file_id` is the same run-length decode `ordinary_lane_dbg_prov` does,
/// over the same `file_counts`, so the two describe one partition of one
/// array.
///
/// The closure comes from `oracle_import_closure`, and TWO conditions make this
/// return `module_split_none()` -- which is the whole-program prelude:
///
///   * `unresolved > 0`. A dropped edge narrows a module's context, and
///     narrowing silently is the one failure that produces a wrong program
///     rather than a slow one.
///   * the closure's length disagrees with the merge's file count. The closure
///     is indexed by FLAT SOURCE and this lane by MERGED FILE ID; they are the
///     same space only because the merge keeps one file entry per flat source.
///     If that ever stops holding, every row would be read for the wrong
///     module -- quietly meaningless rather than wrong in a way anyone sees.
///
/// `use_split` is a parameter rather than an env read: production lanes stay
/// Env-free (the #634 layering note), and `cache_mode` is the established shape
/// for a decision the CLI adapter makes and passes down.
fn ordinary_lane_module_split(file_paths: Array[String], file_counts: Array[Int], source_groups: Array[(String, Array[(String, String)])], use_split: Bool) -> ModuleSplit with Exception + Fs {
  if !use_split {
    module_split_none()
  } else {
    let (closure, unresolved) = exact_import_closure(source_groups)
    if unresolved > 0 || Array::length(closure) != Array::length(file_paths) {
      module_split_none()
    } else {
      let stmt_file_id = array_empty()
      let mut i = 0
      while i < Array::length(file_paths) && i < Array::length(file_counts) {
        let n = Array::get(file_counts, i)
        let mut k = 0
        while k < n {
          Array::push(stmt_file_id, i)
          k = k + 1
        }
        i = i + 1
      }
      ModuleSplit::{
        closure_exact: true,
        file_count: Array::length(file_paths),
        stmt_file_id: stmt_file_id,
        import_closure: closure
      }
    }
  }
}

/// Total edges in the closure the PRODUCTION split would build for this entry
/// (#2658). Exported so a test can tell an exact re-export closure from a
/// direct-edges-only one, which byte comparison cannot: both fail open to the
/// same program, so only the SHAPE distinguishes them.
export fn ordinary_lane_closure_edges(entry_path: String) -> Int with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let (closure, unresolved) = exact_import_closure(source_groups)
  if unresolved > 0 {
    0 - 1
  } else {
    let mut edges = 0
    let mut i = 0
    while i < Array::length(closure) {
      edges = edges + Array::length(Array::get(closure, i))
      i = i + 1
    }
    edges
  }
}

/// The shape of the split this lane WOULD build for `entry_path`: the module
/// count and the number of statements mapped, or `(0, 0)` when the split is
/// not usable and the lane falls back to the whole-program prelude.
///
/// Exported because a byte-equality test between the two lanes is VACUOUS if
/// the split path is never taken, and "I checked by mutating the source" is not
/// a property a test can keep. A caller can also use it to ask whether a given
/// root would split at all.
export fn ordinary_lane_split_shape(entry_path: String) -> (Int, Int) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let (_, file_paths, _, file_counts, _, _) = build_grouped_merged_stmts_counted(source_groups)
  let split = ordinary_lane_module_split(file_paths, file_counts, source_groups, true)
  (split.file_count, Array::length(split.stmt_file_id))
}

/// The ordinary RC lane with the per-module prelude selectable (#2575 item 2
/// step 3b). `use_split` false is byte-for-byte the lane below it.
export fn compile_file_fs_mode_rc_body_cached_split(entry_path: String, entry_name: String, cache_mode: String, use_split: Bool) -> Bytes with Exception + Fs {
  compile_file_fs_mode_rc_body_cached_impl(entry_path, entry_name, cache_mode, use_split, array_empty())
}

export fn compile_file_fs_mode_rc_body_cached(entry_path: String, entry_name: String, cache_mode: String) -> Bytes with Exception + Fs {
  compile_file_fs_mode_rc_body_cached_impl(entry_path, entry_name, cache_mode, false, array_empty())
}

/// #2669 step 2b: the same lane, plus the two numbers that say what it reused
/// -- `[offered, recompiled]`, appended to `counts_out`.
///
/// `offered` is how many cached bodies the file table let through; `recompiled`
/// is `body_cache_out`'s length, which IS the compiled set because
/// `codegen_body_cache_record` runs only on the non-replay branch. The claim
/// this step makes -- an edit recompiles its own file, not everything after it
/// -- is a statement about those numbers and is not observable from the
/// returned bytes, which are identical either way. That is what this entry
/// point exists for; `ordinary_lane_split_shape` above is the same kind of
/// observation seam for the same reason.
export fn compile_file_fs_mode_rc_body_cached_counted(entry_path: String, entry_name: String, cache_mode: String, counts_out: Array[Int]) -> Bytes with Exception + Fs {
  compile_file_fs_mode_rc_body_cached_impl(entry_path, entry_name, cache_mode, false, counts_out)
}

fn compile_file_fs_mode_rc_body_cached_impl(entry_path: String, entry_name: String, cache_mode: String, use_split: Bool, counts_out: Array[Int]) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts_raw, file_paths, file_fps, file_counts, file_bases, clone_float_offsets) = build_grouped_merged_stmts_counted(source_groups)
  let (float_offsets, tl_rels, tl_pluses, int_offsets, bool_offsets) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(file_paths, file_bases, clone_float_offsets))
  let (eq_offsets, eq_keys) = union_module_typed_eq_rows(file_paths, file_bases)
  let merged_stmts = rewrite_string_binops_stmts(merged_stmts_raw, tl_rels, tl_pluses, typed_lowering_binop_anchor)
  // #2575 item 2. The binop rewrite above preserves the statement count (it
  // rewrites in place), so the map built from the merge's counts still indexes
  // `merged_stmts`.
  let lane_prov = ordinary_lane_dbg_prov(file_paths, file_counts)
  let lane_split = ordinary_lane_module_split(file_paths, file_counts, source_groups, use_split)
  // The key is independent of source CONTENT (the point is to hit after an
  // edit) but scoped to the entry PATH: two roots that share a conventional
  // entry name (`run`, `main`) must not share one artifact slot, or their
  // concurrent stores race on the same temp file and one aborts.
  let artifact_key = String::concat("self-describing-", compact_string_fingerprint(entry_path))
  // `"off"` IS OFF (#2647 Codex round 5). It used to load the artifact, compile
  // against it and store the result -- only `"verify"` was special-cased, so
  // every other value behaved like `"on"` while reading as a bypass. The
  // adapter only ever passes `"verify"` or `"on"`, so nothing in production
  // changes; what this fixes is a caller that asks for no cache and gets one.
  //
  // A parity test between two compiles of the SAME program is the case that
  // makes it matter: the first call populates the shared artifact under a key
  // derived from the entry path, and the second can replay those bodies. A
  // body-level difference between the lanes would then be cached away and the
  // comparison would pass while measuring nothing.
  let caching = cache_mode != "off"
  // #2669 step 2b (Codex P0): computed here, after the check has published
  // every module's table and before any decision reads the cache.
  let typed_lowering_guard = typed_lowering_guard_for_files(file_paths)
  let cache_in_decoded = if caching {
    match load_persistent_artifact("codegen-body-cache", entry_name, artifact_key) {
      Some(stored) => decode_body_cache_artifact_for(stored, file_paths, file_fps, file_counts),
      None => codegen_body_cache_new()
    }
  } else {
    codegen_body_cache_new()
  }
  // The guard is compared PER FILE, and a file whose classification moved is
  // dropped exactly like a file whose bytes changed -- not by standing the
  // whole widened lane down.
  //
  // That distinction is the whole of it. An edit to a body shifts that file's
  // own offsets, so a whole-program comparison declines on every edit there is
  // -- measured, before this was per-file: every row in
  // `tests/body_cache_edit_classes_test.vibe` that reuses went to reusing
  // nothing. The file whose slot moved is the one being edited, whose entries
  // the content fingerprint already drops; what has to be caught is a
  // DIFFERENT file's classification moving because the edit changed an
  // interface it reads, and that is its own slot.
  //
  // A stored guard of another shape -- an older artifact, a different file
  // count -- cannot be read per file, so it narrows to the prefix instead.
  let tl_slots_per_file = 6
  let tl_comparable = Array::length(cache_in_decoded.guard_typed_lowering) == Array::length(typed_lowering_guard) && Array::length(typed_lowering_guard) == tl_slots_per_file * Array::length(file_paths)
  let cache_in = if Array::length(cache_in_decoded.guard_typed_lowering) == 0 {
    cache_in_decoded
  } else if tl_comparable {
    let tl_keep_file: Array[Int] = []
    let mut tl_f = 0
    while tl_f < Array::length(file_paths) {
      let mut tl_same = 1
      let mut tl_k = 0
      while tl_k < tl_slots_per_file {
        let at = tl_f * tl_slots_per_file + tl_k
        if Array::get(cache_in_decoded.guard_typed_lowering, at) != Array::get(typed_lowering_guard, at) {
          tl_same = 0
        } else {
          ()
        }
        tl_k = tl_k + 1
      }
      Array::push(tl_keep_file, tl_same)
      tl_f = tl_f + 1
    }
    let kept = codegen_body_cache_filter_src_keep(cache_in_decoded, tl_keep_file)
    let mut tl_c = 0
    while tl_c < Array::length(cache_in_decoded.consumer_src_limit) {
      Array::push(kept.consumer_src_limit, Array::get(cache_in_decoded.consumer_src_limit, tl_c))
      tl_c = tl_c + 1
    }
    kept
  } else if Array::length(cache_in_decoded.consumer_src_limit) == 1 {
    let narrowed = codegen_body_cache_filter_src_below(cache_in_decoded, Array::get(cache_in_decoded.consumer_src_limit, 0))
    Array::push(narrowed.consumer_src_limit, Array::get(cache_in_decoded.consumer_src_limit, 0))
    narrowed
  } else {
    codegen_body_cache_new()
  }
  Array::push(counts_out, Array::length(cache_in.fn_indices))
  if !caching {
    let uncached = compile_wasi_module_rc_cached_impl_with_split(merged_stmts, entry_name, codegen_body_cache_new(), codegen_body_cache_new(), lane_prov, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys, lane_split, print_stmt)
    Array::push(counts_out, 0)
    uncached
  } else if cache_mode == "verify" {
    let fresh_out = codegen_body_cache_new()
    let fresh = compile_wasi_module_rc_cached_impl_with_split(merged_stmts, entry_name, codegen_body_cache_new(), fresh_out, lane_prov, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys, lane_split, print_stmt)
    // #2669 step 2b (Codex P2): the count this lane reports must be the REPLAY
    // compile's, not the fresh one's. `fresh_out` is the harvest of a compile
    // handed an empty cache, so it always holds every function -- reporting it
    // would label a full recompile as this temperature's reuse, which is what
    // `scripts/body_cache_reuse.sh` prints under `mode=verify`. One element
    // means a replay compile ran and recompiled that many; EMPTY means no
    // replay compile ran at all (the guards rejected the cache), and the
    // reported count is -1 rather than a number that reads like reuse.
    let verify_replay_recompiled: Array[Int] = []
    record_typed_lowering_guard(fresh_out, typed_lowering_guard)
    if Array::length(cache_in.fn_indices) > 0 && body_cache_guards_equal(cache_in, fresh_out) {
      // Guard drift (an edit flipped a whole-program fact the guards pin)
      // is an EXPECTED cache miss, checked above against the fresh
      // harvest's guards -- the second compile below re-feeds the
      // already-lowered stmts, where linked_compile's own validation
      // stands down, so it must never see a drifted cache.
      //
      // Second compile of the SAME (now already-lowered) stmts: the #1259
      // replay/sliced gates prove that recompile is byte-identical to the
      // first, so any difference here is attributable to the persisted
      // bodies being replayed.
      let replay_out = codegen_body_cache_new()
      let replayed = compile_wasi_module_rc_cached_impl_with_split(merged_stmts, entry_name, cache_in, replay_out, lane_prov, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys, lane_split, print_stmt)
      Array::push(verify_replay_recompiled, Array::length(replay_out.fn_indices))
      let fresh_n = Bytes::length(fresh)
      let rn = Bytes::length(replayed)
      if fresh_n != rn {
        throw(String::concat("codegen body-cache verify: length mismatch (fresh ", String::concat(__to_string(fresh_n), String::concat(" B, replayed ", String::concat(__to_string(rn), " B) -- a persisted body replayed wrong; unset VIBE_CODEGEN_BODY_CACHE and report this")))))
      } else {
        ()
      }
      let mut i = 0
      let mut bad = 0 - 1
      while bad < 0 && i < fresh_n {
        if Bytes::get(fresh, i) != Bytes::get(replayed, i) {
          bad = i
        } else {
          i = i + 1
        }
      }
      if bad >= 0 {
        throw(String::concat("codegen body-cache verify: byte mismatch at offset ", String::concat(__to_string(bad), " -- a persisted body replayed wrong; unset VIBE_CODEGEN_BODY_CACHE and report this")))
      } else {
        ()
      }
    } else {
      ()
    }
    store_persistent_artifact("codegen-body-cache", entry_name, artifact_key, encode_body_cache_artifact(file_paths, file_fps, file_counts, fresh_out))
    Array::push(counts_out, if Array::length(verify_replay_recompiled) == 1 {
      Array::get(verify_replay_recompiled, 0)
    } else {
      0 - 1
    })
    fresh
  } else {
    let cache_out = codegen_body_cache_new()
    let bytes = compile_wasi_module_rc_cached_impl_with_split(merged_stmts, entry_name, cache_in, cache_out, lane_prov, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys, lane_split, print_stmt)
    // Replayed entries are not re-recorded, so the refreshed artifact is
    // the new harvest plus the entries it replayed -- but ONLY when the
    // cache was actually consumed (its guards match the new harvest's).
    // Merging a guard-rejected cache would re-persist every entry the
    // compile just recompiled, growing the artifact by a full duplicate
    // set on each guard-flipping edit.
    let refreshed = if Array::length(cache_in.fn_indices) > 0 && body_cache_guards_equal(cache_out, cache_in) {
      codegen_body_cache_merge(cache_out, cache_in)
    } else if Array::length(cache_in.fn_indices) > 0 && Array::length(cache_in.consumer_src_limit) == 1 && body_cache_guards_equal_except_layout(cache_out, cache_in) {
      // A layout guard drifted, so the body loop replayed only the leading
      // prefix -- and a replayed function is not re-recorded, so `cache_out`
      // has a hole exactly there. Carry that prefix back in, or the next
      // completely unchanged build recompiles it for nothing. The subset is
      // the SAME one the body loop narrowed to, computed from the same
      // annotation, so the two cannot disagree about which entries were
      // replayed.
      codegen_body_cache_merge(cache_out, codegen_body_cache_filter_src_below(cache_in, Array::get(cache_in.consumer_src_limit, 0)))
    } else {
      cache_out
    }
    // Stamp the merged harvest, so the artifact records THIS build's per-file
    // classification rather than whatever the consumed cache carried.
    record_typed_lowering_guard(refreshed, typed_lowering_guard)
    store_persistent_artifact("codegen-body-cache", entry_name, artifact_key, encode_body_cache_artifact(file_paths, file_fps, file_counts, refreshed))
    Array::push(counts_out, Array::length(cache_out.fn_indices))
    bytes
  }
}

/// #1553: emit a named heap mark for the FS-compile memory measurement. The
/// node runner intercepts `Env::get` of "VIBE_PROFILE_MEMORY_MARK:<phase>"
/// (scripts/wasm_vibe_host_runner.js maybeEmitEnvMemoryMark) and prints one
/// `[profile-memory] ... name=<phase>` line with the current bump-heap
/// pointer / linear-memory pages — but only under VIBE_PROFILE_MEMORY_MARKS=1;
/// otherwise the env read returns "" and nothing is printed. The env var
/// spelled here is never set, so the read is a pure observation signal.
fn fs_heap_mark(phase: String) -> Unit with Env {
  let _ = Env::get(String::concat("VIBE_PROFILE_MEMORY_MARK:", phase))
  ()
}

/// #1553 heap-measurement variant of compile_file_fs_mode_rc: byte-identical
/// pipeline with a named memory mark at each observable call boundary. Selected
/// by the CLI adapter ONLY under VIBE_PROFILE_MEMORY_MARKS=1 (the production
/// lanes stay Env-free per the #634 layering note; this observation-only lane
/// carries Env solely to reach the runner's mark hook). The labels name the
/// completed call, not an inferred compiler phase:
///   start         — before this FS compile helper does work
///   source_groups — after collect_source_groups_fs
///   prepared_db   — after prepare_file_fs_from_source_groups_persistent_cached
///   merged_stmts  — after build_grouped_merged_stmts
///   codegen_rc    — after compile_wasi_module_rc
/// In particular these marks do not attribute unobservable normalize or link
/// phases. heap_ptr is a bump-heap high-water; it is monotonic for this run.
export fn compile_file_fs_mode_rc_heap_marked(entry_path: String, entry_name: String) -> Bytes with Exception + Fs + Env {
  fs_heap_mark("start")
  let source_groups = collect_source_groups_fs(entry_path)
  fs_heap_mark("source_groups")
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  fs_heap_mark("prepared_db")
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  fs_heap_mark("merged_stmts")
  let bytes = compile_wasi_module_rc_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  fs_heap_mark("codegen_rc")
  bytes
}

/// #1553 observation-only bump counterpart of
/// compile_file_fs_mode_rc_heap_marked. It deliberately mirrors the ordinary
/// compile_file_fs_mode "no-dce" path, including its call boundaries, but is
/// only selected when VIBE_RC=0 and VIBE_PROFILE_MEMORY_MARKS=1. Production
/// bump compiles remain Env-free and continue to use compile_file_fs_mode.
export fn compile_file_fs_mode_bump_heap_marked(entry_path: String, entry_name: String) -> Bytes with Exception + Fs + Env {
  fs_heap_mark("start")
  let source_groups = collect_source_groups_fs(entry_path)
  fs_heap_mark("source_groups")
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  fs_heap_mark("prepared_db")
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  fs_heap_mark("merged_stmts")
  let bytes = compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  fs_heap_mark("codegen_bump")
  bytes
}

/// #715/#768 debug variant (VIBE_RC=shadow): same load/merge as
/// compile_file_fs_mode_rc but with shadow-liveness double-free traps, so an
/// import-resolving test build's "moving target" free-list corruption becomes a
/// deterministic trap at the first bad dup/drop.
export fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_rc_shadow_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
}

/// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test
/// cache verdict to `meta_out` (when non-empty) before codegen — computed on the
/// MERGED stmts, so transitive imported-function effect rows are visible. "1" =
/// every test block is transitively effect-free → `vibe test` may cache/skip it.
/// Reached only on a successful compile (the program type-checks), so reading the
/// declared effect rows is sound. Env is read by the caller (the CLI adapter),
/// keeping this layer free of the Env effect.
export fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)
  // but write it only AFTER codegen succeeds, so a failed compile leaves no
  // stale sidecar.
  let cacheable = if meta_out != "" {
    file_tests_cacheable(merged_stmts)
  } else {
    false
  }
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl_with_typed_offsets(pruned_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  if meta_out != "" {
    Fs::write_file(meta_out, if cacheable {
      "1"
    } else {
      "0"
    })
  } else {
    ()
  }
  bytes
}

/// #819 (Codex review, PR #1214): standalone cacheability query for an
/// ENTRY-function compile (e.g. `fn main`), used by scripts/vibe_md.vibex's
/// ```vibe run block execute-cache. Deliberately its OWN parse/merge pass
/// rather than threading a value through cli_adapter.vibe's existing
/// backend-selection branch (coverage/break/trace/rc/rc-shadow/bump) --
/// this can never affect which bytes an actual compile emits, at the cost
/// of a redundant frontend pass (negligible next to the child-process
/// compile/execute round trips vibe_md.vibex already pays per block).
export fn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  file_entry_cacheable(merged_stmts, entry_name)
}

/// Coverage (#cov): FS-mode compile with function-level hit instrumentation.
/// Same load/merge as compile_file_fs_mode "no-dce" but routes through the
/// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`
/// section. Used by `cli_main` under VIBE_COVERAGE=1.
export fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_with_sources_coverage_impl_with_typed_offsets(merged_stmts, entry_name, array_empty(), float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
}

/// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call
/// execution-trace instrumentation. Same load/merge as compile_file_fs_mode
/// "no-dce" but routes through the trace codegen so the output wasm carries the
/// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under
/// VIBE_DEBUG=1.
export fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_with_sources_trace_impl_with_typed_offsets(merged_stmts, entry_name, array_empty(), float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
}

/// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook
/// instrumentation at each user function entry. Same load/merge as
/// compile_file_fs_mode "no-dce" but routes through the break codegen so the
/// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under
/// VIBE_DEBUG_BREAK=1.
export fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so
  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every
  // statement boundary, mapping each statement's char offset to a line in its OWN
  // source file (multi-file: offsets from different files collide). `merged` is
  // identical to the non-break merge.
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let (merged_stmts_raw, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups, flat_paths, flat_bases, clone_float_offsets)
  let (float_offsets, tl_rels, tl_pluses, int_offsets, bool_offsets) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths, flat_bases, clone_float_offsets))
  let (eq_offsets, eq_keys) = union_module_typed_eq_rows(flat_paths, flat_bases)
  // The String-binop rewrite keeps every surviving node's offset, so the
  // per-file newline tables and stmt->file mapping stay valid: a rewritten
  // binop's operands keep their offsets and the injected call nodes carry -1.
  let merged_stmts = rewrite_string_binops_stmts(merged_stmts_raw, tl_rels, tl_pluses, typed_lowering_binop_anchor)
  compile_wasi_module_with_sources_break_impl_with_typed_offsets(merged_stmts, entry_name, array_empty(), DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  }, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
}

export fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let load_us = elapsed_us_since(load_start)
  let type_start = profiler_now_us()
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let type_us = elapsed_us_since(type_start)
  let bundle_start = profiler_now_us()
  let _ = build_source_groups_fingerprint(source_groups)
  let bundle_us = elapsed_us_since(bundle_start)
  let parse_start = profiler_now_us()
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  let parse_us = elapsed_us_since(parse_start)
  let compile_start = profiler_now_us()
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl_with_typed_offsets(pruned_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let compile_us = elapsed_us_since(compile_start)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
}

fn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  // The ingested source-group fingerprint is the authoritative identity for
  // both cache layers. Keep it beside the collected sources instead of
  // re-hashing every source once for the persistent lookup and again for the
  // TypeDb lookup below. The `_from_group_fingerprint` constructor is
  // byte-for-byte equivalent to the legacy source-taking constructor.
  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)
  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),
    None => {
      let load_us = elapsed_us_since(load_start)
      let type_start = profiler_now_us()
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let type_us = elapsed_us_since(type_start)
      let bundle_start = profiler_now_us()
      let merge_fingerprint = source_groups_fingerprint
      let bundle_us = elapsed_us_since(bundle_start)
      let artifact_fingerprint = merge_fingerprint
      let artifact_kind = if mode == "mvp" {
        "wasi-mvp"
      } else if mode == "no-dce" {
        "wasi"
      } else {
        throw(String::concat("unsupported compile mode: ", mode))
      }
      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),
        None => {
          let parse_start = profiler_now_us()
          let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
          let parse_us = elapsed_us_since(parse_start)
          let compile_start = profiler_now_us()
          let bytes = if mode == "mvp" {
            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
            compile_wasi_module_impl_with_typed_offsets(pruned_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
          } else {
            compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
          }
          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)
          let compile_us = elapsed_us_since(compile_start)
          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)
        }
      }
    }
  }
}

/// The unprofiled cached path's slow-branch persistent-artifact lookup. Its
/// observation fields are derived at the lookup that returns bytes (or proceeds
/// to compile them), so the trace lane cannot preflight then delegate to a
/// second production lookup.
fn compile_file_fs_mode_cached_slow_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, String, String, String) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)
  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let artifact_fingerprint = source_groups_fingerprint
      let artifact_kind = if mode == "mvp" {
        "wasi-mvp"
      } else if mode == "no-dce" {
        "wasi"
      } else {
        throw(String::concat("unsupported compile mode: ", mode))
      }
      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, source_groups_fingerprint, persistent_artifact_fingerprint, "miss"),
        None => {
          let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
          let bytes = if mode == "mvp" {
            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
            compile_wasi_module_impl_with_typed_offsets(pruned_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
          } else {
            compile_wasi_module_no_dce_impl_with_typed_offsets(merged_stmts, entry_name, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys)
          }
          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), source_groups_fingerprint, persistent_artifact_fingerprint, "miss")
        }
      }
    }
  }
}

fn compile_file_fs_mode_cached_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, String, String, String) with Exception + Fs {
  let persistent_artifact_kind = if mode == "mvp" {
    "file-compile-wasi-mvp"
  } else if mode == "no-dce" {
    "file-compile-wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) => {
      let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)
      match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
        Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
        // Preserve the ordinary cached path's validation/slow-path sequence;
        // the observation comes from this lookup, not an additional probe.
        None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)
      }
    },
    None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)
  }
}

export fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with Exception + Fs {
  let (bytes, next_db, _, _, _) = compile_file_fs_mode_cached_observed(db, entry_path, entry_name, mode)
  (bytes, next_db)
}

export fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with Exception + Fs {
  compile_file_fs_mode_cached(db, entry_path, entry_name, "no-dce")
}

/// JSON string escaping for the bounded artifact-input observation sidecar.
/// Keep this local: it is not a general JSON API and must stay exact about
/// control characters so an arbitrary entry path or nonce cannot corrupt it.
fn artifact_input_trace_json_string(text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "\"")
  let mut i = 0
  while i < String::length(text) {
    let c = String::char_code_at(text, i)
    if c == '"' {
      StringBuilder::push(out, "\\\"")
    } else if c == '\\' {
      StringBuilder::push(out, "\\\\")
    } else if c == '\n' {
      StringBuilder::push(out, "\\n")
    } else if c == '\r' {
      StringBuilder::push(out, "\\r")
    } else if c == '\t' {
      StringBuilder::push(out, "\\t")
    } else if c < 32 {
      let hex = "0123456789abcdef"
      StringBuilder::push(out, "\\u00")
      StringBuilder::push(out, String::substring(hex, c / 16, c / 16 + 1))
      StringBuilder::push(out, String::substring(hex, c % 16, c % 16 + 1))
    } else {
      StringBuilder::push(out, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::push(out, "\"")
  StringBuilder::freeze(out)
}

fn artifact_input_trace_push_length_prefixed(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, __to_string(String::length(text)))
  StringBuilder::push(out, ":")
  StringBuilder::push(out, text)
}

/// Composite observation identity. Its fixed-order, length-prefixed preimage
/// is intentionally separate from every production cache/reuse identity.
fn artifact_input_trace_shadow_fingerprint(production_fingerprint: String, source_groups_fingerprint: String, compiler_cache_version_tag: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String, dependency_plan_fingerprint: String, resolution_seed: String, resolution_context_fingerprint: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-artifact-input-observation:v2\n")
  artifact_input_trace_push_length_prefixed(out, production_fingerprint)
  artifact_input_trace_push_length_prefixed(out, source_groups_fingerprint)
  artifact_input_trace_push_length_prefixed(out, compiler_cache_version_tag)
  artifact_input_trace_push_length_prefixed(out, checked_error_row_mode)
  artifact_input_trace_push_length_prefixed(out, diagnostics_mode)
  artifact_input_trace_push_length_prefixed(out, dep_order_seed)
  artifact_input_trace_push_length_prefixed(out, "wasi")
  artifact_input_trace_push_length_prefixed(out, "bump")
  artifact_input_trace_push_length_prefixed(out, "no-dce")
  artifact_input_trace_push_length_prefixed(out, "pre-strip")
  artifact_input_trace_push_length_prefixed(out, "uninstrumented")
  artifact_input_trace_push_length_prefixed(out, dependency_plan_fingerprint)
  artifact_input_trace_push_length_prefixed(out, resolution_seed)
  artifact_input_trace_push_length_prefixed(out, resolution_context_fingerprint)
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// Observation-only wrapper for the file_compile persistent pre-strip WASI
/// bump lane. Production compilation/lookup happens first and is unchanged.
/// The graph/context reads below are trace-only extra I/O and never select
/// cache namespaces, lookup/store keys, or reuse decisions.
export fn compile_file_fs_mode_cached_artifact_input_trace(entry_path: String, entry_name: String, mode: String, run_nonce: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String) -> (Bytes, String) with Exception + Fs {
  if mode != "no-dce" {
    throw("artifact-input trace only supports file_compile WASI no-dce")
  } else if run_nonce == "" {
    throw("artifact-input trace requires a non-empty run nonce")
  } else if (checked_error_row_mode != "checked" && checked_error_row_mode != "unchecked") || (diagnostics_mode != "all" && diagnostics_mode != "fail-fast") {
    throw("artifact-input trace received invalid effective compile configuration")
  } else {
    let persistent_artifact_kind = "file-compile-wasi"
    let (bytes, _, source_groups_fingerprint, production_artifact_input_fingerprint, persistent_lookup) = compile_file_fs_mode_cached_observed(db_new(), entry_path, entry_name, mode)
    // Exact existing authorities, intentionally outside production work.
    let source_groups = collect_source_groups_fs(entry_path)
    let resolution_context_fingerprint = artifact_input_trace_resolution_context_fingerprint_fs(entry_path, source_groups)
    let (dependency_plan_fingerprint, dependency_plan_module_count, dependency_plan_edge_occurrence_count) = artifact_input_trace_dependency_plan_evidence_fs(entry_path)
    let resolution_seed = resolution_env_seed()
    let compiler_cache_version_tag = persistent_cache_version_tag_for_observation()
    let shadow_artifact_input_fingerprint = artifact_input_trace_shadow_fingerprint(production_artifact_input_fingerprint, source_groups_fingerprint, compiler_cache_version_tag, checked_error_row_mode, diagnostics_mode, dep_order_seed, dependency_plan_fingerprint, resolution_seed, resolution_context_fingerprint)
    let out = StringBuilder::new()
    StringBuilder::push(out, "{\"schema\":2,\"run_nonce\":")
    StringBuilder::push(out, artifact_input_trace_json_string(run_nonce))
    StringBuilder::push(out, ",\"scope_disclaimer\":\"observation-only file_compile persistent pre-strip WASI bump lane; trace-only graph/context work; not a production cache key, format, or reuse decision\",\"compile_lane\":\"file_compile.persistent_pre_strip_wasi_cached_bump\",\"persistent_artifact_kind\":")
    StringBuilder::push(out, artifact_input_trace_json_string(persistent_artifact_kind))
    StringBuilder::push(out, ",\"entry\":{\"path\":")
    StringBuilder::push(out, artifact_input_trace_json_string(entry_path))
    StringBuilder::push(out, ",\"name\":")
    StringBuilder::push(out, artifact_input_trace_json_string(entry_name))
    StringBuilder::push(out, ",\"mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(mode))
    StringBuilder::push(out, "},\"source_groups_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(source_groups_fingerprint))
    StringBuilder::push(out, ",\"source_groups_fingerprint_kind\":\"build_source_groups_fingerprint(source_groups)\",\"production_artifact_input_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(production_artifact_input_fingerprint))
    StringBuilder::push(out, ",\"production_artifact_input_fingerprint_kind\":\"build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\",\"compiler_cache_version_tag\":")
    StringBuilder::push(out, artifact_input_trace_json_string(compiler_cache_version_tag))
    StringBuilder::push(out, ",\"compiler_cache_version_tag_kind\":\"persistent_cache_version_tag()\",\"effective_config\":{\"checked_error_row_mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(checked_error_row_mode))
    StringBuilder::push(out, ",\"diagnostics_mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(diagnostics_mode))
    StringBuilder::push(out, ",\"dep_order_seed\":")
    StringBuilder::push(out, artifact_input_trace_json_string(dep_order_seed))
    StringBuilder::push(out, ",\"target\":\"wasi\",\"memory\":\"bump\",\"dce_mode\":\"no-dce\",\"strip_stage\":\"pre-strip\",\"instrumentation\":\"uninstrumented\"},\"dependency_plan\":{\"fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(dependency_plan_fingerprint))
    StringBuilder::push(out, ",\"fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-dependency-plan:v1 length-prefixed planned order/ranks/dependency occurrences)\",\"module_count\":")
    StringBuilder::push(out, __to_string(dependency_plan_module_count))
    StringBuilder::push(out, ",\"edge_occurrence_count\":")
    StringBuilder::push(out, __to_string(dependency_plan_edge_occurrence_count))
    StringBuilder::push(out, "},\"resolution\":{\"env_seed\":")
    StringBuilder::push(out, artifact_input_trace_json_string(resolution_seed))
    StringBuilder::push(out, ",\"env_seed_kind\":\"resolution_env_seed()\",\"context_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(resolution_context_fingerprint))
    StringBuilder::push(out, ",\"context_fingerprint_kind\":\"persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(source_groups))\"},\"shadow_artifact_input_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(shadow_artifact_input_fingerprint))
    StringBuilder::push(out, ",\"shadow_artifact_input_fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-observation:v2 fixed-order length-prefixed components)\",\"persistent_lookup\":")
    StringBuilder::push(out, artifact_input_trace_json_string(persistent_lookup))
    StringBuilder::push(out, "}")
    (bytes, StringBuilder::freeze(out))
  }
}

export fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)
  bytes
}

export fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let persistent_artifact_kind = if mode == "mvp" {
    "file-compile-wasi-mvp"
  } else if mode == "no-dce" {
    "file-compile-wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let load_start = profiler_now_us()
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact(persistent_artifact_kind, entry_name, build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)) {
      Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),
      None => {
        let prefix_load_us = elapsed_us_since(load_start)
        let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)
        (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
      }
    },
    None => {
      let prefix_load_us = elapsed_us_since(load_start)
      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)
      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
    }
  }
}

/// #2437: the last FS caller to leave the reprint.
///
/// It used to print the merge into `merged_source`, reparse + filter + print
/// THAT into `module_source`, reparse the result UNLOCATED, and hand it to
/// `compile_module` -- so every node offset was -1, the per-module
/// typed-lowering rows had no offset space to be rebased into, and this lane
/// compiled with every channel EMPTY. What that costs is the pre-#2158
/// syntactic answer: a large `Int` rendering as the empty string, a `Double`
/// through a projection not rendering as a Double, `a < b` on Strings
/// comparing pointers wherever the desugar tracker cannot classify the shape
/// syntactically.
///
/// It now takes the route #2449 gave the inline entries, one layer up:
/// `merged_stmts_and_offsets` rebases the rows the check above already
/// published, so this is PLUMBING rather than the second whole-program check
/// this issue measured at +330 ms on a 960-function program (superlinear --
/// seconds per cold compile at compiler size). Two prints and two parses go
/// away with it; the reprint's statement filter is applied to the merge
/// instead (`module_lane_filter_stmts`), which preserves every node offset.
///
/// The precondition the inline siblings have to argue for is free here. The
/// memo is keyed by PATH, and `ensure_fingerprint_fs_impl` RESETS it and then
/// leaves a row for every module of the closure: a module served from the
/// persistent type-env cache counts as reused only if its offsets sidecar
/// loads too (`ensure_module_typed_lowering_offsets`), and otherwise it is
/// rechecked. So there is no window where a row left by an earlier compile of
/// a different source at the same path can be read.
///
/// Two deliberate consequences:
///
///   - The in-db artifact kind is `module-typed`, not `module`. `fs_compile`
///     carries a second copy of this entry that still compiles WITHOUT the
///     tables and still writes `module`; sharing a kind would let one entry
///     silently return the other's lowering on a shared `TypeDb`. The two
///     PERSISTENT kinds were already distinct (`file-compile-module` vs
///     `fs-compile-module`) and that key folds in `codegen_fingerprint()`, a
///     hash of every compiler source, so entries written before this change
///     cold-miss on their own.
///   - `db_grouped_merged_source` / `db_module_source` are no longer called
///     here, so this entry no longer bumps their counters. Those counters were
///     this lane's only behavioural coverage, so the tests that read them were
///     rewritten rather than deleted.
///
/// The artifact key keeps exactly the strength it had. It is derived from the
/// merged program's own text, not from the input sources: private namespacing
/// mangles names with the file PATH (`namespace_private_value_stmts`), so two
/// programs whose sources are identical can merge to different statements, and
/// a key hashed from the sources alone would hand the second call the first
/// call's bytes. Printing here costs one print of a program that used to be
/// printed TWICE -- and unlike before, nothing REPARSES that text, so the
/// offsets survive.
fn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups, entry_path)
  match load_persistent_artifact("file-compile-module", "", persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_stmts, float_offsets, int_offsets, bool_offsets, _, _) = merged_stmts_and_offsets(source_groups)
      let filtered = module_lane_filter_stmts(merged_stmts)
      let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(print_program(filtered), typed_offsets_key(float_offsets, int_offsets, bool_offsets)))
      match db_load_artifact(next_db, entry_path, "module-typed", "", artifact_fingerprint) {
        Some(bytes) => (bytes, next_db),
        None => {
          let bytes = compile_module_with_typed_offsets(filtered, float_offsets, int_offsets, bool_offsets)
          store_persistent_artifact("file-compile-module", "", persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(next_db, entry_path, "module-typed", "", artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact("file-compile-module", "", build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path)) {
      Some(bytes) => (bytes, db),
      None => compile_file_fs_module_cached_slow(db, entry_path)
    },
    None => compile_file_fs_module_cached_slow(db, entry_path)
  }
}

export fn compile_file_fs_module(entry_path: String) -> Bytes with Exception + Fs {
  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)
  bytes
}
