//# Types

export effect Profiler {
  NowUs -> Int
}

//# Functions

/// Direct builtin call (ADR-0076 追記31 Vertical C) — see
/// lib/@vibe/cli/dispatch.vibe::profiler_now_us for why the perform form
/// was retired (replay re-execution + memoized resume(0) zeros).
fn profiler_now_us() -> Int with Profiler {
  Profiler::now_us()
}

fn elapsed_us_since(start_us: Int) -> Int with Profiler {
  let elapsed = profiler_now_us() - start_us
  if elapsed < 0 {
    0
  } else {
    elapsed
  }
}

fn artifact_fingerprint_from_source(source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

fn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {
  let mut seeded = db
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      seeded = db_set_source(seeded, path, source)
      si = si + 1
    }
    gi = gi + 1
  }
  seeded
}

fn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {
  let flat = array_empty()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(flat, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  flat
}

fn string_array_contains(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

/// #1100: was a byte-for-byte duplicate of runtime's parse_program_with_path
/// (same located lex+parse, same `<path>: <msg>` wrapping), so a cold compile
/// parsed every source twice -- once for the typecheck walk and once here for
/// the merge. Route both through the memoized one; it hands back a fresh
/// top-level array each call, which is what the in-place desugars downstream
/// require. Interior-line breakpoints (span-arc step5) still get their real
/// EIdent char-offsets: the memoized parse is the same located one.
fn parse_program_for_path(path: String, source: String) -> Array[Stmt] with Exception {
  parse_program_with_path(path, source)
}

/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
/// are the locals the export-rename plan already rewrites; the inline copy gets
/// the target file's export renames applied first.
fn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with Exception {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      match lookup_source_by_path(sources, resolved) {
        Some(source) => {
          let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program_for_path(resolved, source), export_plan_renames_for(plan, resolved)))
          let mut j = 0
          let mut done = false
          while j < Array::length(source_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
              Some(local_stmt) => {
                Array::push(merged, local_stmt)
                Array::push(emitted, local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
}

/// #716: parse every source once and build the export-rename plan for the whole
/// program (the merge output of one file depends on the export surfaces of ALL
/// files: ambiguous exported names are renamed at their defs and at importing
/// files' references).
fn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with Exception {
  let file_paths = array_empty()
  let file_stmts = array_empty()
  let mut si = 0
  while si < Array::length(sources) {
    let (path, source) = Array::get(sources, si)
    Array::push(file_paths, path)
    Array::push(file_stmts, parse_program_for_path(path, source))
    si = si + 1
  }
  (file_paths, file_stmts)
}

/// One file's contribution to the merged program. `stmts` are the file's parsed
/// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule
/// (entry keeps its private names), and `plan`/`sources` drive the export-name
/// rewriting and the collision-def fallback.
fn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)]) -> Unit with Exception {
  let export_renamed = if is_entry_source {
    stmts
  } else {
    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))
  }
  let namespaced_stmts = if is_entry_source {
    export_renamed
  } else {
    namespace_private_value_stmts(path, export_renamed)
  }
  if stmts_have_import_deep(stmts) {
    let import_renames = collect_import_value_renames(plan, path, stmts)
    let skipped_locals = collect_import_alias_collision_locals(stmts)
    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))
    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
  } else {
    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
  }
}

fn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  let merged = array_empty()
  let source_count = Array::length(sources)
  let (file_paths, file_stmts) = parse_sources_for_merge(sources)
  let plan_entry = if entry_path == "" {
    if source_count > 0 {
      Array::get(file_paths, source_count - 1)
    } else {
      ""
    }
  } else {
    entry_path
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, si)
    let is_entry_source = if entry_path == "" {
      si == source_count - 1
    } else {
      path == entry_path
    }
    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)
    si = si + 1
  }
  merged
}

fn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with Exception {
  let merged = array_empty()
  // #716: the plan spans ALL groups (imports cross group boundaries), so the
  // flat source list is parsed once here and reused per group.
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  // #740: the is-entry flag must mean "the LAST file of the WHOLE merge"
  // (the plan entry, whose exports stay unrenamed). It was `si ==
  // source_count - 1` — the last file of EVERY GROUP — so every group
  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its
  // export renames while callers were rewritten to the renamed names:
  // "undefined variable (local): <name>_exp_<path>" at codegen.
  let flat_total = Array::length(file_paths)
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let path = Array::get(file_paths, flat_idx)
      let stmts = Array::get(file_stmts, flat_idx)
      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  merged
}

/// Interior-line breakpoints (span-arc step5): the basename of a file path (text
/// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a
/// `--break <file>:<line>` spec against. String::concat-free (substring only).
fn path_basename(p: String) -> String {
  let n = String::length(p)
  let mut last = 0 - 1
  let mut i = 0
  while i < n {
    if String::char_code_at(p, i) == 47 {
      last = i
    } else {
      ()
    }
    i = i + 1
  }
  String::substring(p, last + 1, n)
}

/// Interior-line breakpoints: sorted char-offsets of each '\n' in `src` (local
/// copy of the codegen helper, to avoid an entry->codegen import).
fn file_newline_offsets(src: String) -> Array[Int] {
  let arr = array_empty()
  let n = String::length(src)
  let mut i = 0
  while i < n {
    if String::char_code_at(src, i) == 10 {
      Array::push(arr, i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}

/// Interior-line breakpoints (span-arc step5, multi-file): like
/// build_grouped_merged_stmts but ALSO records, per merged top-level statement,
/// which SOURCE FILE it came from — so codegen can map each statement's char
/// offset to a line IN ITS OWN FILE (offsets from different files collide after
/// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):
///   file_basenames[k] / file_newlines[k]  — the k-th distinct source file
///   stmt_file_id[s]                        — file id of merged top-level stmt s
/// Provenance is captured by measuring the merged-array length delta around each
/// source's append, so it stays aligned no matter how many statements a source
/// contributes; the append calls themselves mirror build_merged_stmts_from_sources
/// exactly, so `merged` is identical to the normal path.
fn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with Exception {
  let merged = array_empty()
  let files = array_empty()
  let file_nls = array_empty()
  let stmt_file_id = array_empty()
  // #716: same whole-program plan as build_grouped_merged_stmts, so `merged`
  // stays identical to the normal (non-break) merge.
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let (path, source) = Array::get(sources, si)
      let file_id = Array::length(files)
      Array::push(files, path_basename(path))
      Array::push(file_nls, file_newline_offsets(source))
      let before = Array::length(merged)
      // #740: last-of-WHOLE-merge, not last-of-group (see the note in
      // build_grouped_merged_stmts).
      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)
      let after = Array::length(merged)
      let mut k = before
      while k < after {
        Array::push(stmt_file_id, file_id)
        k = k + 1
      }
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  (merged, files, file_nls, stmt_file_id)
}

fn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck(seeded, entry_path)
}

fn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception + Fs {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck_fs(seeded, entry_path)
}

export fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
}

/// #946 P1 (Codex, PR #1006): `vibe check`'s "linked" dep collection
/// (collect_linked_dep_inputs_for_stmts, in linked_artifacts.vibe) exists to
/// feed the wasm import-linking codegen boundary -- it copies a dependency's
/// SEnum/struct declarations into the checked stmts but never a `let rec fn`
/// signature, so check_program never learned an imported function's real
/// type and a wrong-typed call site (e.g. `f("x")` against `fn f(x: Int)`)
/// typechecked cleanly no matter what was passed. Reuse prepare_file_fs_cached's
/// fs-mode source-group + db_typecheck_fs pipeline instead -- the same one
/// compile_file_fs_mode already relies on for a real compile's (working)
/// typecheck pass -- and stop before build_grouped_merged_stmts/codegen.
export fn check_file_fs_mode(entry_path: String) -> Int with Exception + Fs {
  let _ = prepare_file_fs_cached(db_new(), entry_path)
  0
}

export fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [
      entry_name
    ])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

/// #701 RC variant: same load/merge as compile_file_fs_mode "no-dce" but routes
/// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an
/// import-resolving / `vibe run` program actually honors VIBE_RC. Without this
/// the FS-compile path silently used the bump allocator regardless of VIBE_RC.
export fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_rc(merged_stmts, entry_name)
}

/// #715/#768 debug variant (VIBE_RC=shadow): same load/merge as
/// compile_file_fs_mode_rc but with shadow-liveness double-free traps, so an
/// import-resolving test build's "moving target" free-list corruption becomes a
/// deterministic trap at the first bad dup/drop.
export fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_rc_shadow(merged_stmts, entry_name)
}

/// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test
/// cache verdict to `meta_out` (when non-empty) before codegen — computed on the
/// MERGED stmts, so transitive imported-function effect rows are visible. "1" =
/// every test block is transitively effect-free → `vibe test` may cache/skip it.
/// Reached only on a successful compile (the program type-checks), so reading the
/// declared effect rows is sound. Env is read by the caller (the CLI adapter),
/// keeping this layer free of the Env effect.
export fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)
  // but write it only AFTER codegen succeeds, so a failed compile leaves no
  // stale sidecar.
  let cacheable = if meta_out != "" {
    file_tests_cacheable(merged_stmts)
  } else {
    false
  }
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [
      entry_name
    ])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  if meta_out != "" {
    Fs::write_file(meta_out, if cacheable {
      "1"
    } else {
      "0"
    })
  } else {
    ()
  }
  bytes
}

/// #819 (Codex review, PR #1214): standalone cacheability query for an
/// ENTRY-function compile (e.g. `fn main`), used by scripts/vibe_md.vibex's
/// ```vibe run block execute-cache. Deliberately its OWN parse/merge pass
/// rather than threading a value through cli_adapter.vibe's existing
/// backend-selection branch (coverage/break/trace/rc/rc-shadow/bump) --
/// this can never affect which bytes an actual compile emits, at the cost
/// of a redundant frontend pass (negligible next to the child-process
/// compile/execute round trips vibe_md.vibex already pays per block).
export fn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  file_entry_cacheable(merged_stmts, entry_name)
}

/// Coverage (#cov): FS-mode compile with function-level hit instrumentation.
/// Same load/merge as compile_file_fs_mode "no-dce" but routes through the
/// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`
/// section. Used by `cli_main` under VIBE_COVERAGE=1.
export fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_coverage(merged_stmts, entry_name)
}

/// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call
/// execution-trace instrumentation. Same load/merge as compile_file_fs_mode
/// "no-dce" but routes through the trace codegen so the output wasm carries the
/// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under
/// VIBE_DEBUG=1.
export fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_trace(merged_stmts, entry_name)
}

/// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook
/// instrumentation at each user function entry. Same load/merge as
/// compile_file_fs_mode "no-dce" but routes through the break codegen so the
/// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under
/// VIBE_DEBUG_BREAK=1.
export fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so
  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every
  // statement boundary, mapping each statement's char offset to a line in its OWN
  // source file (multi-file: offsets from different files collide). `merged` is
  // identical to the non-break merge.
  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)
  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  })
}

export fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let load_us = elapsed_us_since(load_start)
  let type_start = profiler_now_us()
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let type_us = elapsed_us_since(type_start)
  let bundle_start = profiler_now_us()
  let _ = build_source_groups_fingerprint(source_groups)
  let bundle_us = elapsed_us_since(bundle_start)
  let parse_start = profiler_now_us()
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  let parse_us = elapsed_us_since(parse_start)
  let compile_start = profiler_now_us()
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [
      entry_name
    ])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let compile_us = elapsed_us_since(compile_start)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
}

fn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups, entry_path, entry_name, mode)
  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),
    None => {
      let load_us = elapsed_us_since(load_start)
      let type_start = profiler_now_us()
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let type_us = elapsed_us_since(type_start)
      let bundle_start = profiler_now_us()
      let merge_fingerprint = build_source_groups_fingerprint(source_groups)
      let bundle_us = elapsed_us_since(bundle_start)
      let artifact_fingerprint = merge_fingerprint
      let artifact_kind = if mode == "mvp" {
        "wasi-mvp"
      } else if mode == "no-dce" {
        "wasi"
      } else {
        throw(String::concat("unsupported compile mode: ", mode))
      }
      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),
        None => {
          let parse_start = profiler_now_us()
          let merged_stmts = build_grouped_merged_stmts(source_groups)
          let parse_us = elapsed_us_since(parse_start)
          let compile_start = profiler_now_us()
          let bytes = if mode == "mvp" {
            let pruned_stmts = dce_stmts(merged_stmts, [
              entry_name
            ])
            compile_wasi_module_impl(pruned_stmts, entry_name)
          } else {
            compile_wasi_module(merged_stmts, entry_name)
          }
          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)
          let compile_us = elapsed_us_since(compile_start)
          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)
        }
      }
    }
  }
}

/// The unprofiled cached path's slow-branch persistent-artifact lookup. Its
/// observation fields are derived at the lookup that returns bytes (or proceeds
/// to compile them), so the trace lane cannot preflight then delegate to a
/// second production lookup.
fn compile_file_fs_mode_cached_slow_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, String, String, String) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)
  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let artifact_fingerprint = source_groups_fingerprint
      let artifact_kind = if mode == "mvp" {
        "wasi-mvp"
      } else if mode == "no-dce" {
        "wasi"
      } else {
        throw(String::concat("unsupported compile mode: ", mode))
      }
      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, source_groups_fingerprint, persistent_artifact_fingerprint, "miss"),
        None => {
          let merged_stmts = build_grouped_merged_stmts(source_groups)
          let bytes = if mode == "mvp" {
            let pruned_stmts = dce_stmts(merged_stmts, [
              entry_name
            ])
            compile_wasi_module_impl(pruned_stmts, entry_name)
          } else {
            compile_wasi_module(merged_stmts, entry_name)
          }
          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), source_groups_fingerprint, persistent_artifact_fingerprint, "miss")
        }
      }
    }
  }
}

fn compile_file_fs_mode_cached_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, String, String, String) with Exception + Fs {
  let persistent_artifact_kind = if mode == "mvp" {
    "file-compile-wasi-mvp"
  } else if mode == "no-dce" {
    "file-compile-wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) => {
      let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)
      match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {
        Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
        // Preserve the ordinary cached path's validation/slow-path sequence;
        // the observation comes from this lookup, not an additional probe.
        None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)
      }
    },
    None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)
  }
}

export fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with Exception + Fs {
  let (bytes, next_db, _, _, _) = compile_file_fs_mode_cached_observed(db, entry_path, entry_name, mode)
  (bytes, next_db)
}

export fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with Exception + Fs {
  compile_file_fs_mode_cached(db, entry_path, entry_name, "no-dce")
}

/// JSON string escaping for the bounded artifact-input observation sidecar.
/// Keep this local: it is not a general JSON API and must stay exact about
/// control characters so an arbitrary entry path or nonce cannot corrupt it.
fn artifact_input_trace_json_string(text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "\"")
  let mut i = 0
  while i < String::length(text) {
    let c = String::char_code_at(text, i)
    if c == '"' {
      StringBuilder::push(out, "\\\"")
    } else if c == '\\' {
      StringBuilder::push(out, "\\\\")
    } else if c == '\n' {
      StringBuilder::push(out, "\\n")
    } else if c == '\r' {
      StringBuilder::push(out, "\\r")
    } else if c == '\t' {
      StringBuilder::push(out, "\\t")
    } else if c < 32 {
      let hex = "0123456789abcdef"
      StringBuilder::push(out, "\\u00")
      StringBuilder::push(out, String::substring(hex, c / 16, c / 16 + 1))
      StringBuilder::push(out, String::substring(hex, c % 16, c % 16 + 1))
    } else {
      StringBuilder::push(out, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::push(out, "\"")
  StringBuilder::freeze(out)
}

fn artifact_input_trace_push_length_prefixed(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, __to_string(String::length(text)))
  StringBuilder::push(out, ":")
  StringBuilder::push(out, text)
}

/// Composite observation identity. Its fixed-order, length-prefixed preimage
/// is intentionally separate from every production cache/reuse identity.
fn artifact_input_trace_shadow_fingerprint(production_fingerprint: String, source_groups_fingerprint: String, compiler_cache_version_tag: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String, dependency_plan_fingerprint: String, resolution_seed: String, resolution_context_fingerprint: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-artifact-input-observation:v2\n")
  artifact_input_trace_push_length_prefixed(out, production_fingerprint)
  artifact_input_trace_push_length_prefixed(out, source_groups_fingerprint)
  artifact_input_trace_push_length_prefixed(out, compiler_cache_version_tag)
  artifact_input_trace_push_length_prefixed(out, checked_error_row_mode)
  artifact_input_trace_push_length_prefixed(out, diagnostics_mode)
  artifact_input_trace_push_length_prefixed(out, dep_order_seed)
  artifact_input_trace_push_length_prefixed(out, "wasi")
  artifact_input_trace_push_length_prefixed(out, "bump")
  artifact_input_trace_push_length_prefixed(out, "no-dce")
  artifact_input_trace_push_length_prefixed(out, "pre-strip")
  artifact_input_trace_push_length_prefixed(out, "uninstrumented")
  artifact_input_trace_push_length_prefixed(out, dependency_plan_fingerprint)
  artifact_input_trace_push_length_prefixed(out, resolution_seed)
  artifact_input_trace_push_length_prefixed(out, resolution_context_fingerprint)
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// Observation-only wrapper for the file_compile persistent pre-strip WASI
/// bump lane. Production compilation/lookup happens first and is unchanged.
/// The graph/context reads below are trace-only extra I/O and never select
/// cache namespaces, lookup/store keys, or reuse decisions.
export fn compile_file_fs_mode_cached_artifact_input_trace(entry_path: String, entry_name: String, mode: String, run_nonce: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String) -> (Bytes, String) with Exception + Fs {
  if mode != "no-dce" {
    throw("artifact-input trace only supports file_compile WASI no-dce")
  } else if run_nonce == "" {
    throw("artifact-input trace requires a non-empty run nonce")
  } else if (checked_error_row_mode != "checked" && checked_error_row_mode != "unchecked") || (diagnostics_mode != "all" && diagnostics_mode != "fail-fast") {
    throw("artifact-input trace received invalid effective compile configuration")
  } else {
    let persistent_artifact_kind = "file-compile-wasi"
    let (bytes, _, source_groups_fingerprint, production_artifact_input_fingerprint, persistent_lookup) = compile_file_fs_mode_cached_observed(db_new(), entry_path, entry_name, mode)
    // Exact existing authorities, intentionally outside production work.
    let source_groups = collect_source_groups_fs(entry_path)
    let resolution_context_fingerprint = artifact_input_trace_resolution_context_fingerprint_fs(entry_path, source_groups)
    let (dependency_plan_fingerprint, dependency_plan_module_count, dependency_plan_edge_occurrence_count) = artifact_input_trace_dependency_plan_evidence_fs(entry_path)
    let resolution_seed = resolution_env_seed()
    let compiler_cache_version_tag = persistent_cache_version_tag_for_observation()
    let shadow_artifact_input_fingerprint = artifact_input_trace_shadow_fingerprint(production_artifact_input_fingerprint, source_groups_fingerprint, compiler_cache_version_tag, checked_error_row_mode, diagnostics_mode, dep_order_seed, dependency_plan_fingerprint, resolution_seed, resolution_context_fingerprint)
    let out = StringBuilder::new()
    StringBuilder::push(out, "{\"schema\":2,\"run_nonce\":")
    StringBuilder::push(out, artifact_input_trace_json_string(run_nonce))
    StringBuilder::push(out, ",\"scope_disclaimer\":\"observation-only file_compile persistent pre-strip WASI bump lane; trace-only graph/context work; not a production cache key, format, or reuse decision\",\"compile_lane\":\"file_compile.persistent_pre_strip_wasi_cached_bump\",\"persistent_artifact_kind\":")
    StringBuilder::push(out, artifact_input_trace_json_string(persistent_artifact_kind))
    StringBuilder::push(out, ",\"entry\":{\"path\":")
    StringBuilder::push(out, artifact_input_trace_json_string(entry_path))
    StringBuilder::push(out, ",\"name\":")
    StringBuilder::push(out, artifact_input_trace_json_string(entry_name))
    StringBuilder::push(out, ",\"mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(mode))
    StringBuilder::push(out, "},\"source_groups_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(source_groups_fingerprint))
    StringBuilder::push(out, ",\"source_groups_fingerprint_kind\":\"build_source_groups_fingerprint(source_groups)\",\"production_artifact_input_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(production_artifact_input_fingerprint))
    StringBuilder::push(out, ",\"production_artifact_input_fingerprint_kind\":\"build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\",\"compiler_cache_version_tag\":")
    StringBuilder::push(out, artifact_input_trace_json_string(compiler_cache_version_tag))
    StringBuilder::push(out, ",\"compiler_cache_version_tag_kind\":\"persistent_cache_version_tag()\",\"effective_config\":{\"checked_error_row_mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(checked_error_row_mode))
    StringBuilder::push(out, ",\"diagnostics_mode\":")
    StringBuilder::push(out, artifact_input_trace_json_string(diagnostics_mode))
    StringBuilder::push(out, ",\"dep_order_seed\":")
    StringBuilder::push(out, artifact_input_trace_json_string(dep_order_seed))
    StringBuilder::push(out, ",\"target\":\"wasi\",\"memory\":\"bump\",\"dce_mode\":\"no-dce\",\"strip_stage\":\"pre-strip\",\"instrumentation\":\"uninstrumented\"},\"dependency_plan\":{\"fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(dependency_plan_fingerprint))
    StringBuilder::push(out, ",\"fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-dependency-plan:v1 length-prefixed planned order/ranks/dependency occurrences)\",\"module_count\":")
    StringBuilder::push(out, __to_string(dependency_plan_module_count))
    StringBuilder::push(out, ",\"edge_occurrence_count\":")
    StringBuilder::push(out, __to_string(dependency_plan_edge_occurrence_count))
    StringBuilder::push(out, "},\"resolution\":{\"env_seed\":")
    StringBuilder::push(out, artifact_input_trace_json_string(resolution_seed))
    StringBuilder::push(out, ",\"env_seed_kind\":\"resolution_env_seed()\",\"context_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(resolution_context_fingerprint))
    StringBuilder::push(out, ",\"context_fingerprint_kind\":\"persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(source_groups))\"},\"shadow_artifact_input_fingerprint\":")
    StringBuilder::push(out, artifact_input_trace_json_string(shadow_artifact_input_fingerprint))
    StringBuilder::push(out, ",\"shadow_artifact_input_fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-observation:v2 fixed-order length-prefixed components)\",\"persistent_lookup\":")
    StringBuilder::push(out, artifact_input_trace_json_string(persistent_lookup))
    StringBuilder::push(out, "}")
    (bytes, StringBuilder::freeze(out))
  }
}

export fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with Exception + Fs {
  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)
  bytes
}

export fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let persistent_artifact_kind = if mode == "mvp" {
    "file-compile-wasi-mvp"
  } else if mode == "no-dce" {
    "file-compile-wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let load_start = profiler_now_us()
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact(persistent_artifact_kind, entry_name, build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)) {
      Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),
      None => {
        let prefix_load_us = elapsed_us_since(load_start)
        let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)
        (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
      }
    },
    None => {
      let prefix_load_us = elapsed_us_since(load_start)
      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)
      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
    }
  }
}

fn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups, entry_path)
  match load_persistent_artifact("file-compile-module", "", persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)
      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)
      match db_load_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint) {
        Some(bytes) => (bytes, codegen_db),
        None => {
          let merged_stmts = parse_program(lex(module_source))
          let bytes = compile_module(merged_stmts)
          store_persistent_artifact("file-compile-module", "", persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact("file-compile-module", "", build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path)) {
      Some(bytes) => (bytes, db),
      None => compile_file_fs_module_cached_slow(db, entry_path)
    },
    None => compile_file_fs_module_cached_slow(db, entry_path)
  }
}

export fn compile_file_fs_module(entry_path: String) -> Bytes with Exception + Fs {
  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)
  bytes
}
