//# Types

export effect Profiler {
  NowUs -> Int
}

//# Functions

/// Direct builtin call (ADR-0076 追記31 Vertical C) — see
/// lib/@vibe/cli/dispatch.vibe::profiler_now_us for why the perform form
/// was retired (replay re-execution + memoized resume(0) zeros).
fn profiler_now_us() -> Int with Profiler {
  Profiler::now_us()
}

fn elapsed_us_since(_ start_us: Int) -> Int with Profiler {
  let elapsed = profiler_now_us() - start_us
  if elapsed < 0 {
    0
  } else {
    elapsed
  }
}

fn artifact_fingerprint_from_source(_ source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, at = i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

fn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {
  let mut seeded = db
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, at = si)
      seeded = db_set_source(db = seeded, path = path, source = source)
      si = si + 1
    }
    gi = gi + 1
  }
  seeded
}

/// #2388 measurement: run every pre-codegen pass on the entry's closure both
/// whole-program and one file at a time from the same state, and report per
/// pass whether the two render identically (prelude_pass_module_oracle_step).
/// Same load, check and merge as compile_file_fs_mode_rc; the split side is
/// re-merged fresh for every pass so the two programs never share a node.
export fn prelude_module_oracle_report_fs(entry_path: String, entry_name: String, pass_limit: Int) -> String with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  prelude_module_oracle_report(source_groups = source_groups, entry_name = entry_name, pass_limit = pass_limit)
}

/// #2388 measurement: the same closure through the WHOLE prelude per module.
/// `prelude_module_oracle_report_fs` reports pass by pass from a whole-program
/// state; this one splits once and runs every pass on each file alone, which is
/// the property a real per-module driver needs. One `FULL ...` line plus the
/// keyed comparison.
export fn prelude_module_full_oracle_report_fs(entry_path: String, entry_name: String) -> String with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  prelude_module_full_oracle_report(source_groups = source_groups, entry_name = entry_name)
}

/// #2575 item 2: does the ORDINARY compile lane carry a usable statement to
/// module map? `PROV stmts=<n> ids=<n> files=<n>`, where `ids` equal to `stmts`
/// is the property -- one module id per merged top-level statement, aligned
/// with the array codegen receives.
///
/// This exists because the answer used to be "no, and silently": the lane
/// computed the map, passed `array_empty()` for it, and handed codegen an
/// `empty_dbg_prov()`. Nothing said so. A per-module production driver is
/// blocked on this and not on the driver, so it is worth a counter rather than
/// a comment.
export fn prelude_ordinary_lane_prov_report_fs(_ entry_path: String) -> String with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  prelude_ordinary_lane_prov_report(source_groups)
}

/// #2388 measurement: the shape of the import closure the per-module oracle
/// runs under, on its own. `files edges unresolved` -- the number of sources,
/// the total size of the transitive closure, and the dependency edges that
/// could not be placed in the source list.
///
/// Separate from `prelude_module_full_oracle_report_fs` because a per-module
/// run that THROWS (the link finding two different bodies under one key is
/// exactly the outcome worth reporting) would take the count with it, and a
/// narrowing caused by dropped edges reads identically to one caused by the
/// real import graph.
export fn prelude_module_import_closure_report_fs(_ entry_path: String) -> String with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  prelude_module_import_closure_report(source_groups)
}

/// The statement filter `build_module_source` (runtime.vibe) applies while
/// reprinting: a module keeps its top-level function bindings and the
/// serialized builtin-iterator boundary markers, and nothing else.
///
/// #2437: lifted out of the reprint so the statement merge can be filtered
/// directly. Selecting statements preserves every node offset, which is what
/// lets the rebased typed-lowering tables still name the right nodes. Kept
/// byte-identical to `fs_compile`'s copy on purpose -- the two lanes must
/// agree on what a module contains.
/// #2621 review: the typed-lowering tables belong IN the artifact key.
///
/// The key is derived from `print_program(filtered)`, and
/// `module_lane_filter_stmts` drops everything that is not a top-level function
/// binding -- type aliases included. So two programs that differ only in a
/// DROPPED declaration print identically:
///
///   type Value = Int      let render: (Value) -> String = (v) -> { __to_string(v) }
///   type Value = Bool     let render: (Value) -> String = (v) -> { __to_string(v) }
///
/// The retained text is the same; the Int-render and Bool-render channels are
/// not. On a shared `TypeDb`, the second compile would hit the first's artifact
/// and emit the first program's lowering for the second program's types.
///
/// Folding the tables in costs one pass over three small Int arrays and makes
/// the key a function of everything codegen actually reads, rather than of the
/// text alone. Cheaper and narrower than hashing the whole checked input.
fn typed_offsets_key(floats: Array[Int], ints: Array[Int], bools: Array[Int]) -> String {
  let out = StringBuilder::new()
  let mut k = 0
  while k < 3 {
    let table = if k == 0 {
      floats
    } else if k == 1 {
      ints
    } else {
      bools
    }
    StringBuilder::push(out, value = "|")
    let mut i = 0
    while i < Array::length(table) {
      StringBuilder::push(out, value = Int::to_string(Array::get(table, at = i)))
      StringBuilder::push(out, value = ",")
      i = i + 1
    }
    k = k + 1
  }
  StringBuilder::freeze(out)
}

fn module_lane_filter_stmts(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let filtered = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    let keep = match stmt {
      SLet(_, _, _, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => true,
        _ => false
      },
      _ => builtin_iterator_serialized_boundary_markers(stmt) is Some(_)
    }
    if keep {
      Array::push(filtered, value = stmt)
    } else {
      ()
    }
    i = i + 1
  }
  filtered
}

fn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Env + Exception + Fs {
  let seeded = seed_type_db_from_source_groups(db = db, source_groups = source_groups)
  db_typecheck_fs(db = seeded, path = entry_path)
}

export fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db = db, entry_path = entry_path, source_groups = source_groups)
}

/// #946 P1 (Codex, PR #1006): `vibe check`'s "linked" dep collection
/// (collect_linked_dep_inputs_for_stmts, in linked_artifacts.vibe) exists to
/// feed the wasm import-linking codegen boundary -- it copies a dependency's
/// SEnum/struct declarations into the checked stmts but never a `let rec fn`
/// signature, so check_program never learned an imported function's real
/// type and a wrong-typed call site (e.g. `f("x")` against `fn f(x: Int)`)
/// typechecked cleanly no matter what was passed. Reuse prepare_file_fs_cached's
/// fs-mode source-group + db_typecheck_fs pipeline instead -- the same one
/// compile_file_fs_mode already relies on for a real compile's (working)
/// typecheck pass -- and stop before build_grouped_merged_stmts/codegen.
export fn check_file_fs_mode_from_source_groups(entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Env + Exception + Fs {
  // #3456: the merge below records the offset space its markers index. A
  // diagnostic the walk throws first indexes its own file, so it must not be
  // read against an earlier check's record (`vibe lsp` checks repeatedly).
  merged_offset_space_reset()
  let _ = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_walk")
  // #1536(c) / #1511(b): after the typecheck passes, run the ADR-0076
  // effect-lowering eligibility passes (suspend CPS split + evidence-passing
  // migration) on the SAME merged program a release compile lowers
  // (build_grouped_merged_stmts over the same source_groups), via the same
  // shared prelude compile_wasi_module_linked_impl runs — so a handle/suspend
  // shape codegen would reject is reported here, at `vibe check`, instead of
  // typechecking cleanly and first failing in codegen. The merged AST is
  // discarded afterwards (the prelude rewrites it in place); no wasm is
  // produced. Entry name "main" matches what `vibe build`/`vibe run` compile
  // with; a program with no `main` simply has no entry-keyed boundary
  // machinery installed, same as its real compile would.
  //
  // #3456: merged into the DISJOINT offset space with the walk's typed rows,
  // the way the build merges. The prelude's interpolation pass reads the rows,
  // so an untyped shadowing `let` is rendered -- and refused or not -- through
  // its own type, as the build does. Without them it read the outer binding's
  // entry: `vibe check` refused a `b: Raw` rebound to an `Int` that the build
  // compiles, and passed an `Int` rebound to a `Raw` with no Show that the
  // build refuses. The merge records the space, so a marker the prelude
  // throws is mapped back to its file (cli_support `marker_in_file_space`).
  let flat_paths: Array[String] = array_empty()
  let flat_bases: Array[Int] = array_empty()
  let merged_stmts = build_grouped_merged_stmts_with_offsets(source_groups = source_groups, flat_paths = flat_paths, flat_bases = flat_bases)
  let (eq_offs, eq_keys) = union_module_typed_eq_rows(flat_paths = flat_paths, flat_bases = flat_bases)
  let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_merge")
  let lowering_errs = effect_lowering_prelude(stmts = merged_stmts, entry_name = "main", linked_imports = array_empty(), iw_names = array_empty(), iw_wats = array_empty(), checker_eq_offsets = eq_offs, checker_eq_type_keys = eq_keys)
  let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_effect_prelude")
  if Array::length(lowering_errs) > 0 {
    throw(Array::get(lowering_errs, at = 0))
  } else {
    ()
  }
  0
}

export fn check_file_fs_mode(_ entry_path: String) -> Int with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  check_file_fs_mode_from_source_groups(entry_path = entry_path, source_groups = source_groups)
}

/// #2158/#2391: this lane's codegen is untyped, so a `Double` that arrives
/// through a call renders as its raw f64 bits without help.
/// `CompileCtx.float_call_offsets` is the channel that fixes it -- the
/// checker's per-call-site type, keyed by source offset -- and here it is fed
/// by the MODULAR check this lane already runs
/// (`prepare_file_fs_from_source_groups_persistent_cached`): check_module
/// retains each module's Double call-result offsets in that module's own
/// offset space, and `merged_stmts_and_float_offsets` rebases every file into
/// a disjoint offset range (the same rebase the gc lane uses, #2226) and
/// unions the tables. No whole-program re-check is involved.
///
/// That shape is a MEASURED choice, twice. Adding a whole-program re-check of
/// the merged program instead cost 6.12s -> 77.55s at #2158 time; re-measured
/// on 2026-08-30 (this repo, codegen_lexer_test's full-compiler closure,
/// interleaved runs) it still cost ~5.6x warm (5.8s -> 32.6s) and ~3.8x cold,
/// needed a 128MB host stack (the recursive whole-program checker exhausts
/// the default stack on a compiler-sized merged program), and mutated the
/// merged AST enough to change the emitted wasm. The modular carry costs a
/// per-module capture inside a check that was already running, and the
/// persistent halves (TypeEnv + offsets sidecar) are required TOGETHER by
/// every reuse arm, so cache state can never change what a compile emits.
/// `unique_typed_lowering_offsets_in_stmts` (codegen/common_analysis) still drops any
/// offset that names more than one call node, so a partial answer degrades to
/// the pre-#2158 syntactic classifier rather than to a wrong one.
/// The codegen half of a compile mode, in ONE place.
///
/// This dispatch was copied at four call sites and the artifact-kind dispatch
/// at four more. Adding `dce-root` to `compile_file_fs_mode` alone left the
/// CACHED lane throwing `unsupported compile mode: dce-root`, so the `.vibex`
/// CLI's `build --component` failed under `VIBE_UNSTABLE=1` with the artifact
/// cache on while the launcher adapter succeeded (Codex review of #2863).
///
/// Worse, two of the four codegen copies had NO `no-dce` arm and no throw:
/// they fell through for any non-`mvp` mode, so once the throw above was
/// lifted they would have compiled `dce-root` as `no-dce` and emitted an
/// UNPRUNED artifact with no error at all. A mode is a three-way fact and now
/// has one spelling.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
fn compile_merged_for_mode(mode: String, merged_stmts: Array[Stmt], entry_name: String, float_offsets: Array[Int], int_offsets: Array[Int], bool_offsets: Array[Int], eq_offsets: Array[Int], eq_keys: Array[String]) -> Bytes with Exception {
  compile_merged_for_mode_grants(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity.
fn compile_merged_for_mode_grants(mode: String, merged_stmts: Array[Stmt], entry_name: String, float_offsets: Array[Int], int_offsets: Array[Int], bool_offsets: Array[Int], eq_offsets: Array[Int], eq_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  if mode == "mvp" {
    let pruned_stmts = dce_stmts_before_trait_desugar(stmts = merged_stmts, entry_names = [
      entry_name
    ])
    compile_wasi_module_impl_with_typed_offsets_grants(stmts = pruned_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, grants = grants)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl_with_typed_offsets(stmts = merged_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
  } else if mode == "dce-root" {
    // Prune from a NAMED root, then emit as a library. `mvp` roots the DCE at
    // `entry_name` and hands the SAME name to a codegen that requires a
    // 0-parameter WASI entry; `no-dce` keeps every statement. A command
    // component is exactly the shape neither serves -- its surface is
    // `vibe_command`, which takes a parameter. Measured on this tree, a
    // command calling `check_linked_file` was a 40.4 MB component under
    // `no-dce` and is 2.6 MB rooted here.
    //
    // `entry_name` is the DCE ROOT; the codegen entry is the library sentinel.
    let pruned_stmts = dce_stmts_before_trait_desugar(stmts = merged_stmts, entry_names = [
      entry_name
    ])
    compile_wasi_module_no_dce_impl_with_typed_offsets(stmts = pruned_stmts, entry_name = "__no_entry__", checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

/// The in-memory artifact cache's namespace for a mode.
///
/// This MUST differ per mode: `db_load_artifact` keys on
/// (entry_path, kind, entry_name, source_groups_fingerprint) and that
/// fingerprint does NOT carry the mode, so a shared kind would hand a
/// `no-dce` artifact back for a `dce-root` request.
fn artifact_kind_for_mode(_ mode: String) -> String with Exception {
  if mode == "mvp" {
    "wasi-mvp"
  } else if mode == "no-dce" {
    "wasi"
  } else if mode == "dce-root" {
    "wasi-dce-root"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

/// The persistent artifact cache's namespace for a mode. Its fingerprint
/// (`build_file_compile_wasi_artifact_fingerprint_*`) does carry the mode, so
/// this is defence in depth rather than the only separator -- but a kind per
/// mode keeps the two caches reading the same way.
fn persistent_artifact_kind_for_mode(_ mode: String) -> String with Exception {
  if mode == "mvp" {
    "file-compile-wasi-mvp"
  } else if mode == "no-dce" {
    "file-compile-wasi"
  } else if mode == "dce-root" {
    "file-compile-wasi-dce-root"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_grants(entry_path = entry_path, entry_name = entry_name, mode = mode, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity.
export fn compile_file_fs_mode_grants(entry_path: String, entry_name: String, mode: String, grants: Array[(String, String)]) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_merged_for_mode_grants(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys, grants = grants)
}

/// Import-resolving wasm-gc compilation. Module discovery, projected import
/// environments, and namespace projection are the same ones used by the
/// linear filesystem lane. The GC variant additionally rebases every file's
/// located AST into a disjoint offset range before merging. The checker and
/// codegen can then share a call-result table without either transferring a
/// Double classification to an Int call or discarding a valid Double hint.
export fn compile_file_fs_mode_gc(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts_gc(source_groups)
  // Protect dependency builtins from the entry's private names before the
  // whole-program check, while retaining source names for method checking.
  // The normal post-check rename still owns definitions and ABI tables.
  mark_private_builtin_references(merged_stmts)
  compile_generated_stmts_gc_only(stmts = merged_stmts, entry_name = entry_name)
}

/// #701 RC variant: same load/merge as compile_file_fs_mode "no-dce" but routes
/// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an
/// import-resolving / `vibe run` program actually honors VIBE_RC. Without this
/// the FS-compile path silently used the bump allocator regardless of VIBE_RC.
/// Pre-#2828-rung-2 arity: no launcher grants, so `perform?` resolves
/// `NotGranted` exactly as before. Every caller but `vibe run` uses this.
export fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_grants(entry_path = entry_path, entry_name = entry_name, grants = array_empty())
}

/// #2828 rung 2: ADR-0088's L1 grants, frozen by the launcher before the
/// artifact is built, reach the optional-capability lowering through here.
export fn compile_file_fs_mode_rc_grants(entry_path: String, entry_name: String, grants: Array[(String, String)]) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_grants_memo(entry_path = entry_path, entry_name = entry_name, grants = grants, memo_mode = "off")
}

/// The same lane behind the linked-output memo (#2825, linked_output_memo.vibe):
/// `vibe run`, `vibe build` and `vibe test` pass `on`, so an exact no-op
/// replays the module the last identical compile produced. The typing walk
/// runs first either way, so a no-op still reports a type error, records the
/// closure for the unstable-surface gate and fills the typing telemetry.
export fn compile_file_fs_mode_rc_grants_memo(entry_path: String, entry_name: String, grants: Array[(String, String)], memo_mode: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  if memo_mode == "off" {
    compile_rc_grants_back_end(entry_name = entry_name, grants = grants, source_groups = source_groups)
  } else {
    let identity = linked_output_memo_identity(lane = "rc", entry_path = entry_path, entry_name = entry_name, grants = grants, source_groups = source_groups)
    linked_output_memo_run(mode = memo_mode, lane = "rc", entry_path = entry_path, entry_name = entry_name, identity = identity, compile = () -> compile_rc_grants_back_end(entry_name = entry_name, grants = grants, source_groups = source_groups))
  }
}

fn compile_rc_grants_back_end(entry_name: String, grants: Array[(String, String)], source_groups: Array[(String, Array[(String, String)])]) -> Bytes with Env + Exception + Fs {
  // #2158/#2391: this is the lane `vibe test` and `vibe run` actually take --
  // the adapter routes anything but an explicit `VIBE_RC=0` here, since
  // `VIBE_RC` unset is `"" != "0"`. The checker's Double call-result offsets
  // ride the modular check; see compile_file_fs_mode above for the design and
  // the measurements.
  // #2199: merge WITH per-file newline tables so production wasm carries a
  // compact `vibe.linemap` (no debug-break probes). `merged` stays the same
  // program as `merged_stmts_and_offsets`; only the DbgProv is filled.
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let (merged_stmts_raw, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups = source_groups, flat_paths_out = flat_paths, flat_bases_out = flat_bases, clone_float_offsets_out = clone_float_offsets)
  let (float_offsets, tl_rels, tl_pluses, int_offsets, bool_offsets) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets = clone_float_offsets))
  let (eq_offsets, eq_keys) = union_module_typed_eq_rows(flat_paths = flat_paths, flat_bases = flat_bases)
  let merged_stmts = rewrite_string_binops_stmts(stmts = merged_stmts_raw, rels = tl_rels, pluses = tl_pluses, anchor = typed_lowering_binop_anchor)
  // The out-cache is dropped the moment this returns, so it declines to
  // collect: `codegen_body_cache_record` would otherwise fill one row per
  // function plus one per `vibe.linemap` site, on the lane every `vibe run`
  // and `vibe test` takes, for nobody (#2199 follow-up).
  compile_wasi_module_rc_cached_impl_with_prov_grants(stmts_in = merged_stmts, entry_name = entry_name, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), prov = DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  }, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, grants = grants)
}

//# #2388 step 3: codegen body-cache artifact (wrapper codec)
//
// The stored artifact is self-describing: a per-file table (path, content
// fingerprint, merged-statement count, in merge order) followed by the
// CodegenBodyCache blob. It is stored under ONE fixed artifact fingerprint
// per entry -- the point is to be loadable when the sources DID change --
// and the per-file table inside decides how much of the cache is still
// valid. The persistent-cache version tag already keys the store on the
// compiler's own codegen fingerprint, so an artifact can never cross
// compiler versions.

fn bcw_push_int(buf: Bytes, v: Int) -> Unit with Exception {
  if v < 0 {
    throw(String::concat("body-cache wrapper: negative field ", __to_string(v)))
  } else {
    ()
  }
  let mut x = v
  let mut more = true
  while more {
    let low = x&127
    x = x>>7
    if x == 0 {
      Bytes::push(buf, value = low)
      more = false
    } else {
      Bytes::push(buf, value = low|128)
    }
  }
}

fn bcw_push_string(buf: Bytes, s: String) -> Unit with Exception {
  bcw_push_int(buf = buf, v = String::length(s))
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(buf, value = String::char_code_at(s, at = i))
    i = i + 1
  }
}

fn bcw_read_int(b: Bytes, pos: Int) -> (Int, Int) {
  let n = Bytes::length(b)
  let mut p = pos
  let mut shift = 0
  let mut acc = 0
  let mut done = false
  let mut bad = false
  while !done && !bad {
    if p >= n || shift > 34 {
      bad = true
    } else {
      let byte = Bytes::get(b, at = p)
      p = p + 1
      acc = acc|((byte&127)<<shift)
      shift = shift + 7
      if (byte&128) == 0 {
        done = true
      } else {
        ()
      }
    }
  }
  if bad {
    (0, 0 - 1)
  } else {
    (acc, p)
  }
}

fn bcw_read_string(b: Bytes, pos: Int) -> (String, Int) {
  let (len, p0) = bcw_read_int(b = b, pos = pos)
  if p0 < 0 || len < 0 || p0 + len > Bytes::length(b) {
    ("", 0 - 1)
  } else {
    let parts = array_empty()
    let mut i = 0
    while i < len {
      Array::push(parts, value = String::from_byte(Bytes::get(b, at = p0 + i)))
      i = i + 1
    }
    (String::join(parts, sep = ""), p0 + len)
  }
}

/// Content checksum over `b[start..)`: the same dual-modulus rolling shape
/// as compact_string_fingerprint, over bytes. Guards the artifact against
/// same-length corruption that the length-prefixed framing cannot see -- a
/// bit flip inside a cached body would otherwise replay as wrong
/// instructions under `on` mode.
fn bcw_checksum(b: Bytes, start: Int) -> (Int, Int) {
  let mut h1 = 17
  let mut h2 = 29
  let n = Bytes::length(b)
  let mut i = start
  while i < n {
    let byte = Bytes::get(b, at = i)
    h1 = (h1 * 131 + byte) % 2147483647
    h2 = (h2 * 137 + byte) % 2147483629
    i = i + 1
  }
  (h1, h2)
}

fn encode_body_cache_artifact(paths: Array[String], fps: Array[String], counts: Array[Int], cache: CodegenBodyCache) -> Bytes with Exception {
  // Payload first, so the header can carry its checksum. The checksum
  // covers the WHOLE payload -- the per-file table included, because a
  // corrupted statement count would corrupt the replay limit just as
  // silently as a corrupted body.
  let payload = Bytes::new()
  bcw_push_int(buf = payload, v = Array::length(paths))
  let mut i = 0
  while i < Array::length(paths) {
    bcw_push_string(buf = payload, s = Array::get(paths, at = i))
    bcw_push_string(buf = payload, s = Array::get(fps, at = i))
    bcw_push_int(buf = payload, v = Array::get(counts, at = i))
    i = i + 1
  }
  codegen_body_cache_write_to(buf = payload, cache = cache)
  let (h1, h2) = bcw_checksum(b = payload, start = 0)
  let buf = Bytes::new()
  Bytes::push(buf, value = 'V')
  Bytes::push(buf, value = 'B')
  Bytes::push(buf, value = 'W')
  Bytes::push(buf, value = '2')
  bcw_push_int(buf = buf, v = h1)
  bcw_push_int(buf = buf, v = h2)
  Bytes::append(buf, bytes = payload)
  buf
}

/// Decode the stored artifact and cut it down to what the CURRENT compile may
/// replay: the longest leading run of files whose path, content fingerprint,
/// and merged-statement count all match gives the unchanged merged-statement
/// prefix, and only cached bodies compiled from below that boundary survive
/// (codegen_body_cache_filter_src_below also drops synthesized and pad
/// entries via the recorded guards). Anything malformed answers an empty
/// cache -- a damaged artifact costs a recompile, never a wrong body.
fn decode_body_cache_artifact_for(b: Bytes, paths: Array[String], fps: Array[String], counts: Array[Int]) -> CodegenBodyCache {
  if Bytes::length(b) < 4 || Bytes::get(b, at = 0) != 'V' || Bytes::get(b, at = 1) != 'B' || Bytes::get(b, at = 2) != 'W' || Bytes::get(b, at = 3) != '2' {
    codegen_body_cache_new()
  } else {
    let (stored_h1, ph1) = bcw_read_int(b = b, pos = 4)
    let (stored_h2, ph2) = if ph1 < 0 {
      (0, 0 - 1)
    } else {
      bcw_read_int(b = b, pos = ph1)
    }
    let checksum_ok = if ph2 < 0 {
      false
    } else {
      let (h1, h2) = bcw_checksum(b = b, start = ph2)
      h1 == stored_h1 && h2 == stored_h2
    }
    if !checksum_ok {
      codegen_body_cache_new()
    } else {
      decode_body_cache_payload_for(b = b, payload_start = ph2, paths = paths, fps = fps, counts = counts)
    }
  }
}

fn decode_body_cache_payload_for(b: Bytes, payload_start: Int, paths: Array[String], fps: Array[String], counts: Array[Int]) -> CodegenBodyCache {
  let (file_n, p0) = bcw_read_int(b = b, pos = payload_start)
  if p0 < 0 {
    codegen_body_cache_new()
  } else {
    let mut p = p0
    let mut i = 0
    let mut limit = 0
    let mut still_matching = true
    let mut malformed = false
    // #2669 step 2b. `layout_same` is the condition under which this build's
    // FILE INDICES are the harvest's: every file present, in order,
    // contributing the same number of merged statements. Only the file
    // CONTENTS may differ. A cached entry names its file by index
    // (`fn_files`), so without this the map below would be read against a
    // different file list -- and the statement counts are in it because a
    // changed count moves the pin region and the synthesized statements with
    // it, which the codegen guards would reject anyway.
    let mut layout_same = file_n == Array::length(paths)
    let keep_file = array_empty()
    while !malformed && i < file_n {
      let (spath, p1) = bcw_read_string(b = b, pos = p)
      let (sfp, p2) = if p1 < 0 {
        ("", 0 - 1)
      } else {
        bcw_read_string(b = b, pos = p1)
      }
      let (scount, p3) = if p2 < 0 {
        (0, 0 - 1)
      } else {
        bcw_read_int(b = b, pos = p2)
      }
      if p3 < 0 {
        malformed = true
      } else {
        p = p3
        let positioned = i < Array::length(paths) && spath == Array::get(paths, at = i) && scount == Array::get(counts, at = i)
        let unchanged = positioned && sfp == Array::get(fps, at = i)
        if !positioned {
          layout_same = false
        } else {
          ()
        }
        Array::push(keep_file, value = if unchanged {
          1
        } else {
          0
        })
        if still_matching && unchanged {
          limit = limit + scount
        } else {
          still_matching = false
        }
      }
      i = i + 1
    }
    if malformed || (!layout_same && limit == 0) {
      codegen_body_cache_new()
    } else {
      match codegen_body_cache_from_bytes_at(b = b, start = p) {
        Some(cache) => {
          let kept = if layout_same {
            codegen_body_cache_filter_src_keep(cache = cache, keep_file = keep_file)
          } else {
            codegen_body_cache_filter_src_below(cache = cache, limit = limit)
          }
          // What the leading unchanged run was, for the body loop to narrow
          // back to if the layout guards it checks do not hold. Set on both
          // branches: the wide set is a superset of the prefix, so the
          // fallback is meaningful either way.
          Array::push(kept.consumer_src_limit, value = limit)
          kept
        },
        None => codegen_body_cache_new()
      }
    }
  }
}

/// #2388 step 3: compile_file_fs_mode_rc with the cross-compile codegen body
/// cache. `cache_mode` comes from the CLI adapter's VIBE_CODEGEN_BODY_CACHE
/// read (this layer stays Env-free, #634):
///
///   "verify" -- compile everything fresh, then compile AGAIN replaying the
///     persisted bodies, and throw on the first byte the two outputs differ
///     at. Proves the replay lane end-to-end on real edits at double compile
///     cost; the returned bytes are always the fresh compile's.
///   "on" -- replay persisted bodies directly. The recorded guards
///     (pin region shape, lambda slot base, synthesized names and
///     positions) drop the cache wholesale on any layout drift.
///
/// Either way the artifact is refreshed with this compile's harvest, under
/// an artifact key scoped to the entry PATH but not to source content --
/// the per-file table INSIDE the artifact is what decides validity next
/// time, because the whole point is to be usable when the sources changed
/// (a source-keyed fingerprint would only ever hit when nothing changed at
/// all). The artifact carries a payload checksum; any corruption -- a
/// same-length bit flip in a cached body included -- decodes as an empty
/// cache and recompiles.
/// #2388 step 3: full guard-set equality between two caches. Used where the
/// consuming compile's own validation cannot run: the verify lane's second
/// compile re-feeds the already-lowered stmts, where linked_compile's guard
/// validation legitimately stands down (the pin reorder is a no-op there),
/// so expected guard drift from an edit must be turned into a cache miss
/// HERE, against the fresh harvest's guards -- not left to throw as a
/// verify mismatch. Also decides whether a consumed cache may be merged
/// back into the refreshed artifact.
///
/// #2669 step 2b: `guard_typed_lowering` is deliberately NOT part of this.
/// It is a per-FILE vector, and the file that was edited legitimately moves
/// its own slot on every edit -- comparing it elementwise would refuse every
/// merge there is. That comparison happens where the file list is, at the
/// decode, and drops exactly the files whose classification moved.
fn body_cache_guards_equal(a: CodegenBodyCache, b: CodegenBodyCache) -> Bool {
  body_cache_guards_equal_except_layout(a = a, b = b) && bcc_int_lists_equal(a = a.guard_layout, b = b.guard_layout)
}

/// #2669 step 2b: the guard set MINUS `guard_layout`, which is exactly the
/// set that decides whether the leading PREFIX was replayable.
///
/// The body loop narrows to that prefix when a layout guard drifts, so those
/// functions are replayed and therefore absent from the fresh harvest. Asking
/// the full set before merging would then persist an artifact with a hole in
/// it, and the next completely unchanged build would recompile the prefix for
/// no reason (Codex P2 on this PR).
fn body_cache_guards_equal_except_layout(a: CodegenBodyCache, b: CodegenBodyCache) -> Bool {
  Array::length(a.guard_meta) == 5 && bcc_int_lists_equal(a = a.guard_meta, b = b.guard_meta) && bcc_string_lists_equal(a = a.guard_synth_names, b = b.guard_synth_names) && bcc_int_lists_equal(a = a.guard_synth_stmts, b = b.guard_synth_stmts) && bcc_string_lists_equal(a = a.guard_import_names, b = b.guard_import_names) && bcc_string_lists_equal(a = a.guard_borrow_names, b = b.guard_borrow_names) && bcc_int_lists_equal(a = a.guard_borrow_masks, b = b.guard_borrow_masks) && bcc_string_lists_equal(a = a.guard_unmangled_names, b = b.guard_unmangled_names)
}

/// #2669 step 2b (Codex P0): stamp this compile's per-module classification
/// onto a harvest, but only one that recorded the rest of the guards -- a
/// harvest with no `guard_meta` is in-process-only and must not look
/// cross-compile usable because of a column this layer added.
fn record_typed_lowering_guard(cache: CodegenBodyCache, rows: Array[Int]) -> Unit {
  Array::truncate(cache.guard_typed_lowering, length = 0)
  if Array::length(cache.guard_meta) == 5 {
    let mut i = 0
    while i < Array::length(rows) {
      Array::push(cache.guard_typed_lowering, value = Array::get(rows, at = i))
      i = i + 1
    }
  } else {
    ()
  }
}

/// #2575 item 2 step 3b: the ordinary FS lane's `ModuleSplit`, or an unusable
/// one.
///
/// `stmt_file_id` is the same run-length decode `ordinary_lane_dbg_prov` does,
/// over the same `file_counts`, so the two describe one partition of one
/// array.
///
/// The closure comes from `exact_import_closure`, and TWO conditions make this
/// return `module_split_none()` -- which is the whole-program prelude:
///
///   * `unresolved > 0`. A dropped edge narrows a module's context, and
///     narrowing silently is the one failure that produces a wrong program
///     rather than a slow one.
///   * the closure's length disagrees with the merge's file count. The closure
///     is indexed by FLAT SOURCE and this lane by MERGED FILE ID; they are the
///     same space only because the merge keeps one file entry per flat source.
///     If that ever stops holding, every row would be read for the wrong
///     module -- quietly meaningless rather than wrong in a way anyone sees.
///
/// `use_split` is a parameter rather than an env read: production lanes stay
/// Env-free (the #634 layering note), and `cache_mode` is the established shape
/// for a decision the CLI adapter makes and passes down.
fn ordinary_lane_module_split(file_paths: Array[String], file_counts: Array[Int], source_groups: Array[(String, Array[(String, String)])], use_split: Bool) -> ModuleSplit with Env + Exception + Fs {
  if !use_split {
    module_split_none()
  } else {
    let (closure, unresolved) = exact_import_closure(source_groups)
    if unresolved > 0 || Array::length(closure) != Array::length(file_paths) {
      module_split_none()
    } else {
      let stmt_file_id = array_empty()
      let mut i = 0
      while i < Array::length(file_paths) && i < Array::length(file_counts) {
        let n = Array::get(file_counts, at = i)
        let mut k = 0
        while k < n {
          Array::push(stmt_file_id, value = i)
          k = k + 1
        }
        i = i + 1
      }
      ModuleSplit::{
        closure_exact: true,
        file_count: Array::length(file_paths),
        stmt_file_id: stmt_file_id,
        import_closure: closure
      }
    }
  }
}

/// Total edges in the closure the PRODUCTION split would build for this entry
/// (#2658). Exported so a test can tell an exact re-export closure from a
/// direct-edges-only one, which byte comparison cannot: both fail open to the
/// same program, so only the SHAPE distinguishes them.
export fn ordinary_lane_closure_edges(_ entry_path: String) -> Int with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let (closure, unresolved) = exact_import_closure(source_groups)
  if unresolved > 0 {
    0 - 1
  } else {
    let mut edges = 0
    let mut i = 0
    while i < Array::length(closure) {
      edges = edges + Array::length(Array::get(closure, at = i))
      i = i + 1
    }
    edges
  }
}

/// The one flat index whose path ends with `suffix`, or `-1` when that is not
/// exactly one. AMBIGUITY IS NOT RESOLVED: two matches answer `-1` like zero
/// matches, so a caller that names a file loosely gets a failing lookup rather
/// than whichever entry happened to come last.
fn eic_index_of_suffix(flat: Array[(String, String)], suffix: String) -> Int {
  let mut found = 0 - 1
  let mut hits = 0
  let mut i = 0
  while i < Array::length(flat) {
    let (p, _) = Array::get(flat, at = i)
    if String::ends_with(p, suffix = suffix) {
      found = i
      hits = hits + 1
    } else {
      ()
    }
    i = i + 1
  }
  if hits == 1 {
    found
  } else {
    0 - 1
  }
}

/// #2658: is `member` in `owner`'s row of the closure the production split
/// would build for `entry_path`? Both are matched by path SUFFIX, so a caller
/// can name a file without spelling its directory.
///
/// `ordinary_lane_closure_edges` cannot answer this, and the difference is not
/// cosmetic. Dropping a re-exported module from a row and admitting a
/// privately-imported one are opposite errors OF THE SAME SIZE, so they cancel
/// in the total: a closure that gets both wrong sums to exactly what an exact
/// one sums to. The total was a proxy; membership is the property (Codex on
/// #2814).
///
/// Answers `false` for a path that is not in the program or is not unique, so
/// a caller must pin every name it asserts `false` for with a `true` assertion
/// elsewhere -- otherwise a typo reads as "correctly excluded".
export fn ordinary_lane_closure_admits(entry_path: String, owner: String, member: String) -> Bool with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let (closure, unresolved) = exact_import_closure(source_groups)
  if unresolved > 0 {
    false
  } else {
    let flat = flatten_group_sources(source_groups)
    let oi = eic_index_of_suffix(flat = flat, suffix = owner)
    let mi = eic_index_of_suffix(flat = flat, suffix = member)
    if oi < 0 || mi < 0 || oi >= Array::length(closure) {
      false
    } else {
      import_closure_row_has(row = Array::get(closure, at = oi), v = mi)
    }
  }
}

/// The shape of the split this lane WOULD build for `entry_path`: the module
/// count and the number of statements mapped, or `(0, 0)` when the split is
/// not usable and the lane falls back to the whole-program prelude.
///
/// Exported because a byte-equality test between the two lanes is VACUOUS if
/// the split path is never taken, and "I checked by mutating the source" is not
/// a property a test can keep. A caller can also use it to ask whether a given
/// root would split at all.
export fn ordinary_lane_split_shape(_ entry_path: String) -> (Int, Int) with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let (_, file_paths, _, file_counts, _, _) = build_grouped_merged_stmts_counted(source_groups)
  let split = ordinary_lane_module_split(file_paths = file_paths, file_counts = file_counts, source_groups = source_groups, use_split = true)
  (split.file_count, Array::length(split.stmt_file_id))
}

/// The ordinary RC lane with the per-module prelude selectable (#2575 item 2
/// step 3b). `use_split` false is byte-for-byte the lane below it.
export fn compile_file_fs_mode_rc_body_cached_split(entry_path: String, entry_name: String, cache_mode: String, use_split: Bool) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_body_cached_impl(entry_path = entry_path, entry_name = entry_name, source_groups = checked_source_groups_fs(entry_path), cache_mode = cache_mode, use_split = use_split, counts_out = array_empty())
}

/// The launcher's `VIBE_CODEGEN_BODY_CACHE` lane. The linked-output memo is
/// off here unless `VIBE_LINKED_OUTPUT_MEMO` asks for it: this is the lane the
/// incremental KPI and the compiler's own measurements compile through, and
/// their warm rows measure the back end's reuse, which a replayed module would
/// hide.
export fn compile_file_fs_mode_rc_body_cached(entry_path: String, entry_name: String, cache_mode: String) -> Bytes with Env + Exception + Fs {
  let source_groups = checked_source_groups_fs(entry_path)
  let memo_mode = linked_output_memo_mode("off")
  if memo_mode == "off" {
    compile_file_fs_mode_rc_body_cached_impl(entry_path = entry_path, entry_name = entry_name, source_groups = source_groups, cache_mode = cache_mode, use_split = false, counts_out = array_empty())
  } else {
    let identity = linked_output_memo_identity(lane = "rc-body-cached", entry_path = entry_path, entry_name = entry_name, grants = array_empty(), source_groups = source_groups)
    linked_output_memo_run(mode = memo_mode, lane = "rc-body-cached", entry_path = entry_path, entry_name = entry_name, identity = identity, compile = () -> compile_file_fs_mode_rc_body_cached_impl(entry_path = entry_path, entry_name = entry_name, source_groups = source_groups, cache_mode = cache_mode, use_split = false, counts_out = array_empty()))
  }
}

/// #2669 step 2b: the same lane, plus the two numbers that say what it reused
/// -- `[offered, recompiled]`, appended to `counts_out`.
///
/// `offered` is how many cached bodies the file table let through; `recompiled`
/// is `body_cache_out`'s length, which IS the compiled set because
/// `codegen_body_cache_record` runs only on the non-replay branch. The claim
/// this step makes -- an edit recompiles its own file, not everything after it
/// -- is a statement about those numbers and is not observable from the
/// returned bytes, which are identical either way. That is what this entry
/// point exists for; `ordinary_lane_split_shape` above is the same kind of
/// observation seam for the same reason.
export fn compile_file_fs_mode_rc_body_cached_counted(entry_path: String, entry_name: String, cache_mode: String, counts_out: Array[Int]) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_body_cached_impl(entry_path = entry_path, entry_name = entry_name, source_groups = checked_source_groups_fs(entry_path), cache_mode = cache_mode, use_split = false, counts_out = counts_out)
}

/// #2818: may this harvest ever be replayed by a LATER compile?
///
/// `bcc_src_region_n` reads `guard_meta[0]` and answers 0 for anything that is
/// not exactly five values, so a guardless harvest loses every entry to
/// `codegen_body_cache_filter_src_keep` / `_filter_src_below` before it can
/// cross a compile. Persisting one would write the program's whole body set
/// for a cache guaranteed to drop it -- measured on the compiler's own CLI
/// closure when the constant-Bool fold still withheld the guards, 6.9 MB
/// written and then read and discarded on every build, for `offered=0`.
///
/// A folded compile records its guards now (each entry carries its fold
/// signature, `codegen_body_cache_filter_fold_sigs`); what still lands here is
/// a compile that did not run the pin reorder.
fn body_cache_harvest_is_replayable(_ cache: CodegenBodyCache) -> Bool {
  Array::length(cache.guard_meta) == 5
}

/// The loader's source groups for `entry_path`, after the typing walk has
/// checked them: what every lane below starts from.
fn checked_source_groups_fs(_ entry_path: String) -> Array[(String, Array[(String, String)])] with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  source_groups
}

fn prepare_file_body_inputs_fs(source_groups: Array[(String, Array[(String, String)])], use_split: Bool) -> FileBodyPreparation with Env + Exception + Fs {
  let (merged_stmts_raw, file_paths, file_fps, file_counts, file_bases, clone_float_offsets) = build_grouped_merged_stmts_counted(source_groups)
  let (float_offsets, tl_rels, tl_pluses, int_offsets, bool_offsets) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths = file_paths, flat_bases = file_bases, clone_float_offsets = clone_float_offsets))
  let (eq_offsets, eq_keys) = union_module_typed_eq_rows(flat_paths = file_paths, flat_bases = file_bases)
  let merged_stmts = rewrite_string_binops_stmts(stmts = merged_stmts_raw, rels = tl_rels, pluses = tl_pluses, anchor = typed_lowering_binop_anchor)
  // #2575 item 2. The binop rewrite above preserves the statement count (it
  // rewrites in place), so the map built from the merge's counts still indexes
  // `merged_stmts`.
  let lane_prov = ordinary_lane_dbg_prov(file_paths = file_paths, file_counts = file_counts, source_groups = source_groups, file_bases = file_bases)
  let lane_split = ordinary_lane_module_split(file_paths = file_paths, file_counts = file_counts, source_groups = source_groups, use_split = use_split)
  FileBodyPreparation::{
    stmts: merged_stmts,
    paths: file_paths,
    fingerprints: file_fps,
    counts: file_counts,
    floats: float_offsets,
    int_renders: int_offsets,
    bool_renders: bool_offsets,
    eq_offsets: eq_offsets,
    eq_keys: eq_keys,
    prov: lane_prov,
    split: lane_split,
    typed_guard: typed_lowering_guard_for_files(file_paths)
  }
}

/// The cache-off production filesystem prefix, returned before body execution.
/// Configuration and input-observation ownership stay with the calling phase.
export fn prepare_file_fs_mode_rc_body(entry_path: String, entry_name: String) -> LinkedModulePreparation with Env + Exception + Fs {
  let prepared = prepare_file_body_inputs_fs(source_groups = checked_source_groups_fs(entry_path), use_split = false)
  lc_prepare_wasi_module_rc_cached_with_split_grants(stmts_in = prepared.stmts, entry_name = entry_name, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), prov = prepared.prov, checker_float_call_offsets = prepared.floats, checker_int_render_offsets = prepared.int_renders, checker_bool_render_offsets = prepared.bool_renders, checker_eq_offsets = prepared.eq_offsets, checker_eq_type_keys = prepared.eq_keys, split = prepared.split, render = print_stmt, grants = [
  ])
}

fn compile_file_fs_mode_rc_body_cached_impl(entry_path: String, entry_name: String, source_groups: Array[(String, Array[(String, String)])], cache_mode: String, use_split: Bool, counts_out: Array[Int]) -> Bytes with Env + Exception + Fs {
  let prepared = prepare_file_body_inputs_fs(source_groups = source_groups, use_split = use_split)
  let merged_stmts = prepared.stmts
  let file_paths = prepared.paths
  let file_fps = prepared.fingerprints
  let file_counts = prepared.counts
  let float_offsets = prepared.floats
  let int_offsets = prepared.int_renders
  let bool_offsets = prepared.bool_renders
  let eq_offsets = prepared.eq_offsets
  let eq_keys = prepared.eq_keys
  let lane_prov = prepared.prov
  let lane_split = prepared.split
  // The key is independent of source CONTENT (the point is to hit after an
  // edit) but scoped to the entry PATH: two roots that share a conventional
  // entry name (`run`, `main`) must not share one artifact slot, or their
  // concurrent stores race on the same temp file and one aborts.
  let artifact_key = String::concat("self-describing-", compact_string_fingerprint(entry_path))
  // `"off"` IS OFF (#2647 Codex round 5). It used to load the artifact, compile
  // against it and store the result -- only `"verify"` was special-cased, so
  // every other value behaved like `"on"` while reading as a bypass. The
  // adapter only ever passes `"verify"` or `"on"`, so nothing in production
  // changes; what this fixes is a caller that asks for no cache and gets one.
  //
  // A parity test between two compiles of the SAME program is the case that
  // makes it matter: the first call populates the shared artifact under a key
  // derived from the entry path, and the second can replay those bodies. A
  // body-level difference between the lanes would then be cached away and the
  // comparison would pass while measuring nothing.
  let caching = cache_mode != "off"
  // #2669 step 2b (Codex P0): captured by the shared preparation after the
  // check publishes every module's table, before any cache decision.
  let typed_lowering_guard = prepared.typed_guard
  let cache_in_decoded = if caching {
    match load_persistent_artifact(kind = "codegen-body-cache", entry_name = entry_name, fingerprint = artifact_key) {
      Some(stored) => decode_body_cache_artifact_for(b = stored, paths = file_paths, fps = file_fps, counts = file_counts),
      None => codegen_body_cache_new()
    }
  } else {
    codegen_body_cache_new()
  }
  // The guard is compared PER FILE, and a file whose classification moved is
  // dropped exactly like a file whose bytes changed -- not by standing the
  // whole widened lane down.
  //
  // That distinction is the whole of it. An edit to a body shifts that file's
  // own offsets, so a whole-program comparison declines on every edit there is
  // -- measured, before this was per-file: every row in
  // `tests/body_cache_edit_classes_test.vibe` that reuses went to reusing
  // nothing. The file whose slot moved is the one being edited, whose entries
  // the content fingerprint already drops; what has to be caught is a
  // DIFFERENT file's classification moving because the edit changed an
  // interface it reads, and that is its own slot.
  //
  // A stored guard of another shape -- an older artifact, a different file
  // count -- cannot be read per file, so it narrows to the prefix instead.
  let tl_slots_per_file = 6
  let tl_comparable = Array::length(cache_in_decoded.guard_typed_lowering) == Array::length(typed_lowering_guard) && Array::length(typed_lowering_guard) == tl_slots_per_file * Array::length(file_paths)
  let cache_in = if Array::length(cache_in_decoded.guard_typed_lowering) == 0 {
    cache_in_decoded
  } else if tl_comparable {
    let tl_keep_file: Array[Int] = []
    let mut tl_f = 0
    while tl_f < Array::length(file_paths) {
      let mut tl_same = 1
      let mut tl_k = 0
      while tl_k < tl_slots_per_file {
        let at = tl_f * tl_slots_per_file + tl_k
        if Array::get(cache_in_decoded.guard_typed_lowering, at = at) != Array::get(typed_lowering_guard, at = at) {
          tl_same = 0
        } else {
          ()
        }
        tl_k = tl_k + 1
      }
      Array::push(tl_keep_file, value = tl_same)
      tl_f = tl_f + 1
    }
    if !codegen_body_cache_src_keep_drops_any(cache = cache_in_decoded, keep_file = tl_keep_file) {
      // The common case: nothing moved, so the copy would be the input.
      cache_in_decoded
    } else {
      let kept = codegen_body_cache_filter_src_keep(cache = cache_in_decoded, keep_file = tl_keep_file)
      let mut tl_c = 0
      while tl_c < Array::length(cache_in_decoded.consumer_src_limit) {
        Array::push(kept.consumer_src_limit, value = Array::get(cache_in_decoded.consumer_src_limit, at = tl_c))
        tl_c = tl_c + 1
      }
      kept
    }
  } else if Array::length(cache_in_decoded.consumer_src_limit) == 1 {
    let narrowed = codegen_body_cache_filter_src_below(cache = cache_in_decoded, limit = Array::get(cache_in_decoded.consumer_src_limit, at = 0))
    Array::push(narrowed.consumer_src_limit, value = Array::get(cache_in_decoded.consumer_src_limit, at = 0))
    narrowed
  } else {
    codegen_body_cache_new()
  }
  Array::push(counts_out, value = Array::length(cache_in.fn_indices))
  if !caching {
    let uncached = compile_wasi_module_rc_cached_impl_with_split(stmts_in = merged_stmts, entry_name = entry_name, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), prov = lane_prov, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, split = lane_split, render = print_stmt)
    Array::push(counts_out, value = 0)
    uncached
  } else if cache_mode == "verify" {
    let fresh_out = codegen_body_cache_new()
    let fresh = compile_wasi_module_rc_cached_impl_with_split(stmts_in = merged_stmts, entry_name = entry_name, body_cache_in = codegen_body_cache_new(), body_cache_out = fresh_out, prov = lane_prov, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, split = lane_split, render = print_stmt)
    // #2669 step 2b (Codex P2): the count this lane reports must be the REPLAY
    // compile's, not the fresh one's. `fresh_out` is the harvest of a compile
    // handed an empty cache, so it always holds every function -- reporting it
    // would label a full recompile as this temperature's reuse, which is what
    // `scripts/body_cache_reuse.sh` prints under `mode=verify`. One element
    // means a replay compile ran and recompiled that many; EMPTY means no
    // replay compile ran at all (the guards rejected the cache), and the
    // reported count is -1 rather than a number that reads like reuse.
    let verify_replay_recompiled: Array[Int] = []
    record_typed_lowering_guard(cache = fresh_out, rows = typed_lowering_guard)
    // #2818: the re-fed second compile below stands its fold-signature
    // filter down, so apply it here against the fresh compile's fold table.
    let cache_in_v = codegen_body_cache_filter_fold_sigs(cache = cache_in, names = fresh_out.guard_fold_names, sigs = fresh_out.guard_fold_sigs)
    if Array::length(cache_in_v.fn_indices) > 0 && body_cache_guards_equal(a = cache_in_v, b = fresh_out) {
      // Guard drift (an edit flipped a whole-program fact the guards pin)
      // is an EXPECTED cache miss, checked above against the fresh
      // harvest's guards -- the second compile below re-feeds the
      // already-lowered stmts, where linked_compile's own validation
      // stands down, so it must never see a drifted cache.
      //
      // Second compile of the SAME (now already-lowered) stmts: the #1259
      // replay/sliced gates prove that recompile is byte-identical to the
      // first, so any difference here is attributable to the persisted
      // bodies being replayed.
      let replay_out = codegen_body_cache_new()
      let replayed = compile_wasi_module_rc_cached_impl_with_split(stmts_in = merged_stmts, entry_name = entry_name, body_cache_in = cache_in_v, body_cache_out = replay_out, prov = lane_prov, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, split = lane_split, render = print_stmt)
      Array::push(verify_replay_recompiled, value = Array::length(replay_out.fn_indices))
      let fresh_n = Bytes::length(fresh)
      let rn = Bytes::length(replayed)
      if fresh_n != rn {
        throw(String::concat("codegen body-cache verify: length mismatch (fresh ", String::concat(__to_string(fresh_n), String::concat(" B, replayed ", String::concat(__to_string(rn), " B) -- a persisted body replayed wrong; unset VIBE_CODEGEN_BODY_CACHE and report this")))))
      } else {
        ()
      }
      let mut i = 0
      let mut bad = 0 - 1
      while bad < 0 && i < fresh_n {
        if Bytes::get(fresh, at = i) != Bytes::get(replayed, at = i) {
          bad = i
        } else {
          i = i + 1
        }
      }
      if bad >= 0 {
        throw(String::concat("codegen body-cache verify: byte mismatch at offset ", String::concat(__to_string(bad), " -- a persisted body replayed wrong; unset VIBE_CODEGEN_BODY_CACHE and report this")))
      } else {
        ()
      }
    } else {
      ()
    }
    if body_cache_harvest_is_replayable(fresh_out) {
      store_persistent_artifact(kind = "codegen-body-cache", entry_name = entry_name, fingerprint = artifact_key, bytes = encode_body_cache_artifact(paths = file_paths, fps = file_fps, counts = file_counts, cache = fresh_out))
    } else {
      ()
    }
    Array::push(counts_out, value = if Array::length(verify_replay_recompiled) == 1 {
      Array::get(verify_replay_recompiled, at = 0)
    } else {
      0 - 1
    })
    fresh
  } else {
    let cache_out = codegen_body_cache_new()
    let bytes = compile_wasi_module_rc_cached_impl_with_split(stmts_in = merged_stmts, entry_name = entry_name, body_cache_in = cache_in, body_cache_out = cache_out, prov = lane_prov, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, split = lane_split, render = print_stmt)
    // Replayed entries are not re-recorded, so the refreshed artifact is
    // the new harvest plus the entries it replayed -- but ONLY when the
    // cache was actually consumed (its guards match the new harvest's).
    // Merging a guard-rejected cache would re-persist every entry the
    // compile just recompiled, growing the artifact by a full duplicate
    // set on each guard-flipping edit.
    // #2818: an entry this compile folds differently was recompiled into
    // `cache_out`; carrying it back too would persist a duplicate per flip.
    let cache_in_m = codegen_body_cache_filter_fold_sigs(cache = cache_in, names = cache_out.guard_fold_names, sigs = cache_out.guard_fold_sigs)
    let refreshed = if Array::length(cache_in.fn_indices) > 0 && body_cache_guards_equal(a = cache_out, b = cache_in) {
      codegen_body_cache_merge(a = cache_out, b = cache_in_m)
    } else {
      cache_out
    }
    // Stamp the merged harvest, so the artifact records THIS build's per-file
    // classification rather than whatever the consumed cache carried.
    record_typed_lowering_guard(cache = refreshed, rows = typed_lowering_guard)
    if body_cache_harvest_is_replayable(refreshed) {
      store_persistent_artifact(kind = "codegen-body-cache", entry_name = entry_name, fingerprint = artifact_key, bytes = encode_body_cache_artifact(paths = file_paths, fps = file_fps, counts = file_counts, cache = refreshed))
    } else {
      ()
    }
    Array::push(counts_out, value = Array::length(cache_out.fn_indices))
    bytes
  }
}

/// #1553: emit a named heap mark for the FS-compile memory measurement. The
/// node runner intercepts `Env::get` of "VIBE_PROFILE_MEMORY_MARK:<phase>"
/// (scripts/wasm_vibe_host_runner.js maybeEmitEnvMemoryMark) and prints one
/// `[profile-memory] ... name=<phase>` line with the current bump-heap
/// pointer / linear-memory pages — but only under VIBE_PROFILE_MEMORY_MARKS=1;
/// otherwise the env read returns "" and nothing is printed. The env var
/// spelled here is never set, so the read is a pure observation signal.
fn fs_heap_mark(_ phase: String) -> Unit with Env {
  let _ = Env::get(String::concat("VIBE_PROFILE_MEMORY_MARK:", phase))
  ()
}

/// #1553 heap-measurement variant of compile_file_fs_mode_rc: byte-identical
/// pipeline with a named memory mark at each observable call boundary. Selected
/// by the CLI adapter ONLY under VIBE_PROFILE_MEMORY_MARKS=1 (the production
/// lanes stay Env-free per the #634 layering note; this observation-only lane
/// carries Env solely to reach the runner's mark hook). The labels name the
/// completed call, not an inferred compiler phase:
///   start         — before this FS compile helper does work
///   source_groups — after collect_source_groups_fs
///   prepared_db   — after prepare_file_fs_from_source_groups_persistent_cached
///   merged_stmts  — after build_grouped_merged_stmts
///   codegen_rc    — after compile_wasi_module_rc
/// In particular these marks do not attribute unobservable normalize or link
/// phases. heap_ptr is a bump-heap high-water; it is monotonic for this run.
export fn compile_file_fs_mode_rc_heap_marked(entry_path: String, entry_name: String) -> Bytes with Exception + Fs + Env {
  fs_heap_mark("start")
  let source_groups = collect_source_groups_fs(entry_path)
  fs_heap_mark("source_groups")
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  fs_heap_mark("prepared_db")
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  fs_heap_mark("merged_stmts")
  let bytes = compile_wasi_module_rc_impl_with_typed_offsets(stmts_in = merged_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
  fs_heap_mark("codegen_rc")
  bytes
}

/// #1553 observation-only bump counterpart of
/// compile_file_fs_mode_rc_heap_marked. It deliberately mirrors the ordinary
/// compile_file_fs_mode "no-dce" path, including its call boundaries, but is
/// only selected when VIBE_RC=0 and VIBE_PROFILE_MEMORY_MARKS=1. Production
/// bump compiles remain Env-free and continue to use compile_file_fs_mode.
export fn compile_file_fs_mode_bump_heap_marked(entry_path: String, entry_name: String) -> Bytes with Exception + Fs + Env {
  fs_heap_mark("start")
  let source_groups = collect_source_groups_fs(entry_path)
  fs_heap_mark("source_groups")
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  fs_heap_mark("prepared_db")
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  fs_heap_mark("merged_stmts")
  let bytes = compile_wasi_module_no_dce_impl_with_typed_offsets(stmts = merged_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
  fs_heap_mark("codegen_bump")
  bytes
}

/// #715/#768 debug variant (VIBE_RC=shadow): same load/merge as
/// compile_file_fs_mode_rc but with shadow-liveness double-free traps, so an
/// import-resolving test build's "moving target" free-list corruption becomes a
/// deterministic trap at the first bad dup/drop.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_shadow_grants(entry_path = entry_path, entry_name = entry_name, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity.
export fn compile_file_fs_mode_rc_shadow_grants(entry_path: String, entry_name: String, grants: Array[(String, String)]) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_rc_shadow_impl_with_typed_offsets_grants(stmts_in = merged_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys, grants = grants)
}

/// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test
/// cache verdict to `meta_out` (when non-empty) before codegen — computed on the
/// MERGED stmts, so transitive imported-function effect rows are visible. "1" =
/// every test block is transitively effect-free → `vibe test` may cache/skip it.
/// Reached only on a successful compile (the program type-checks), so reading the
/// declared effect rows is sound. Env is read by the caller (the CLI adapter),
/// keeping this layer free of the Env effect.
export fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)
  // but write it only AFTER codegen succeeds, so a failed compile leaves no
  // stale sidecar.
  let cacheable = if meta_out != "" {
    file_tests_cacheable(merged_stmts)
  } else {
    false
  }
  let bytes = compile_merged_for_mode(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys)
  if meta_out != "" {
    Fs::write_file(meta_out, contents = if cacheable {
      "1"
    } else {
      "0"
    })
  } else {
    ()
  }
  bytes
}

/// #819 (Codex review, PR #1214): standalone cacheability query for an
/// ENTRY-function compile (e.g. `fn main`), used by scripts/vibe_md.vibex's
/// ```vibe run block execute-cache. Deliberately its OWN parse/merge pass
/// rather than threading a value through cli_adapter.vibe's existing
/// backend-selection branch (coverage/break/trace/rc/rc-shadow/bump) --
/// this can never affect which bytes an actual compile emits, at the cost
/// of a redundant frontend pass (negligible next to the child-process
/// compile/execute round trips vibe_md.vibex already pays per block).
export fn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  file_entry_cacheable(stmts = merged_stmts, entry_name = entry_name)
}

/// Coverage (#cov): FS-mode compile with function-level hit instrumentation.
/// Same load/merge as compile_file_fs_mode "no-dce" but routes through the
/// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`
/// section. Used by `cli_main` under VIBE_COVERAGE=1.
export fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_with_sources_coverage_impl_with_typed_offsets(stmts = merged_stmts, entry_name = entry_name, srcs = array_empty(), checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
}

/// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call
/// execution-trace instrumentation. Same load/merge as compile_file_fs_mode
/// "no-dce" but routes through the trace codegen so the output wasm carries the
/// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under
/// VIBE_DEBUG=1.
export fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  compile_wasi_module_with_sources_trace_impl_with_typed_offsets(stmts = merged_stmts, entry_name = entry_name, srcs = array_empty(), checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
}

/// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook
/// instrumentation at each user function entry. Same load/merge as
/// compile_file_fs_mode "no-dce" but routes through the break codegen so the
/// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under
/// VIBE_DEBUG_BREAK=1.
export fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so
  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every
  // statement boundary, mapping each statement's char offset to a line in its OWN
  // source file (multi-file: offsets from different files collide). `merged` is
  // identical to the non-break merge.
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let (merged_stmts_raw, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups = source_groups, flat_paths_out = flat_paths, flat_bases_out = flat_bases, clone_float_offsets_out = clone_float_offsets)
  let (float_offsets, tl_rels, tl_pluses, int_offsets, bool_offsets) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets = clone_float_offsets))
  let (eq_offsets, eq_keys) = union_module_typed_eq_rows(flat_paths = flat_paths, flat_bases = flat_bases)
  // The String-binop rewrite keeps every surviving node's offset, so the
  // per-file newline tables and stmt->file mapping stay valid: a rewritten
  // binop's operands keep their offsets and the injected call nodes carry -1.
  let merged_stmts = rewrite_string_binops_stmts(stmts = merged_stmts_raw, rels = tl_rels, pluses = tl_pluses, anchor = typed_lowering_binop_anchor)
  compile_wasi_module_with_sources_break_impl_with_typed_offsets(stmts = merged_stmts, entry_name = entry_name, srcs = array_empty(), prov = DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  }, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
}

export fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Env + Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let load_us = elapsed_us_since(load_start)
  let type_start = profiler_now_us()
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db_new(), entry_path = entry_path, source_groups = source_groups)
  let _ = next_db
  let type_us = elapsed_us_since(type_start)
  let bundle_start = profiler_now_us()
  let _ = build_source_groups_fingerprint(source_groups)
  let bundle_us = elapsed_us_since(bundle_start)
  let parse_start = profiler_now_us()
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
  let parse_us = elapsed_us_since(parse_start)
  let compile_start = profiler_now_us()
  let bytes = compile_merged_for_mode(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys)
  let compile_us = elapsed_us_since(compile_start)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
}

fn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with Env + Exception + Fs + Profiler {
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  // The ingested source-group fingerprint is the authoritative identity for
  // both cache layers. Keep it beside the collected sources instead of
  // re-hashing every source once for the persistent lookup and again for the
  // TypeDb lookup below. The `_from_group_fingerprint` constructor is
  // byte-for-byte equivalent to the legacy source-taking constructor.
  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint = source_groups_fingerprint, entry_path = entry_path, entry_name = entry_name, mode = mode)
  match load_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),
    None => {
      let load_us = elapsed_us_since(load_start)
      let type_start = profiler_now_us()
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db, entry_path = entry_path, source_groups = source_groups)
      let type_us = elapsed_us_since(type_start)
      let bundle_start = profiler_now_us()
      let merge_fingerprint = source_groups_fingerprint
      let bundle_us = elapsed_us_since(bundle_start)
      let artifact_fingerprint = merge_fingerprint
      let artifact_kind = artifact_kind_for_mode(mode)
      match db_load_artifact(db = next_db, _path = entry_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),
        None => {
          let parse_start = profiler_now_us()
          let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
          let parse_us = elapsed_us_since(parse_start)
          let compile_start = profiler_now_us()
          let bytes = compile_merged_for_mode(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys)
          store_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = persistent_artifact_fingerprint, bytes = bytes)
          let compile_us = elapsed_us_since(compile_start)
          (bytes, db_store_artifact(db = next_db, _path = entry_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes), load_us, type_us, bundle_us, parse_us, compile_us)
        }
      }
    }
  }
}

/// The unprofiled cached path's slow-branch persistent-artifact lookup. Its
/// observation fields are derived at the lookup that returns bytes (or proceeds
/// to compile them), so the trace lane cannot preflight then delegate to a
/// second production lookup.
fn compile_file_fs_mode_cached_slow_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, String, String, String) with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint = source_groups_fingerprint, entry_path = entry_path, entry_name = entry_name, mode = mode)
  match load_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db, entry_path = entry_path, source_groups = source_groups)
      let artifact_fingerprint = source_groups_fingerprint
      let artifact_kind = artifact_kind_for_mode(mode)
      match db_load_artifact(db = next_db, _path = entry_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, source_groups_fingerprint, persistent_artifact_fingerprint, "miss"),
        None => {
          let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets(source_groups)
          let bytes = compile_merged_for_mode(mode = mode, merged_stmts = merged_stmts, entry_name = entry_name, float_offsets = float_offsets, int_offsets = int_offsets, bool_offsets = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys)
          store_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = persistent_artifact_fingerprint, bytes = bytes)
          (bytes, db_store_artifact(db = next_db, _path = entry_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes), source_groups_fingerprint, persistent_artifact_fingerprint, "miss")
        }
      }
    }
  }
}

fn compile_file_fs_mode_cached_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, String, String, String) with Env + Exception + Fs {
  let persistent_artifact_kind = persistent_artifact_kind_for_mode(mode)
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) => {
      let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint = source_groups_fingerprint, entry_path = entry_path, entry_name = entry_name, mode = mode)
      match load_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = persistent_artifact_fingerprint) {
        Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, "hit"),
        // Preserve the ordinary cached path's validation/slow-path sequence;
        // the observation comes from this lookup, not an additional probe.
        None => compile_file_fs_mode_cached_slow_observed(db = db, entry_path = entry_path, entry_name = entry_name, mode = mode, persistent_artifact_kind = persistent_artifact_kind)
      }
    },
    None => compile_file_fs_mode_cached_slow_observed(db = db, entry_path = entry_path, entry_name = entry_name, mode = mode, persistent_artifact_kind = persistent_artifact_kind)
  }
}

export fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with Env + Exception + Fs {
  let (bytes, next_db, _, _, _) = compile_file_fs_mode_cached_observed(db = db, entry_path = entry_path, entry_name = entry_name, mode = mode)
  (bytes, next_db)
}

export fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with Env + Exception + Fs {
  compile_file_fs_mode_cached(db = db, entry_path = entry_path, entry_name = entry_name, mode = "no-dce")
}

/// JSON string escaping for the bounded artifact-input observation sidecar.
/// Keep this local: it is not a general JSON API and must stay exact about
/// control characters so an arbitrary entry path or nonce cannot corrupt it.
fn artifact_input_trace_json_string(_ text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "\"")
  let mut i = 0
  while i < String::length(text) {
    let c = String::char_code_at(text, at = i)
    if c == '"' {
      StringBuilder::push(out, value = "\\\"")
    } else if c == '\\' {
      StringBuilder::push(out, value = "\\\\")
    } else if c == '\n' {
      StringBuilder::push(out, value = "\\n")
    } else if c == '\r' {
      StringBuilder::push(out, value = "\\r")
    } else if c == '\t' {
      StringBuilder::push(out, value = "\\t")
    } else if c < 32 {
      let hex = "0123456789abcdef"
      StringBuilder::push(out, value = "\\u00")
      StringBuilder::push(out, value = String::substring(hex, start = c / 16, end = c / 16 + 1))
      StringBuilder::push(out, value = String::substring(hex, start = c % 16, end = c % 16 + 1))
    } else {
      StringBuilder::push(out, value = String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::push(out, value = "\"")
  StringBuilder::freeze(out)
}

fn artifact_input_trace_push_length_prefixed(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, value = __to_string(String::length(text)))
  StringBuilder::push(out, value = ":")
  StringBuilder::push(out, value = text)
}

/// Composite observation identity. Its fixed-order, length-prefixed preimage
/// is intentionally separate from every production cache/reuse identity.
fn artifact_input_trace_shadow_fingerprint(production_fingerprint: String, source_groups_fingerprint: String, compiler_cache_version_tag: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String, dependency_plan_fingerprint: String, resolution_seed: String, resolution_context_fingerprint: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-artifact-input-observation:v2\n")
  artifact_input_trace_push_length_prefixed(out = out, text = production_fingerprint)
  artifact_input_trace_push_length_prefixed(out = out, text = source_groups_fingerprint)
  artifact_input_trace_push_length_prefixed(out = out, text = compiler_cache_version_tag)
  artifact_input_trace_push_length_prefixed(out = out, text = checked_error_row_mode)
  artifact_input_trace_push_length_prefixed(out = out, text = diagnostics_mode)
  artifact_input_trace_push_length_prefixed(out = out, text = dep_order_seed)
  artifact_input_trace_push_length_prefixed(out = out, text = "wasi")
  artifact_input_trace_push_length_prefixed(out = out, text = "bump")
  artifact_input_trace_push_length_prefixed(out = out, text = "no-dce")
  artifact_input_trace_push_length_prefixed(out = out, text = "pre-strip")
  artifact_input_trace_push_length_prefixed(out = out, text = "uninstrumented")
  artifact_input_trace_push_length_prefixed(out = out, text = dependency_plan_fingerprint)
  artifact_input_trace_push_length_prefixed(out = out, text = resolution_seed)
  artifact_input_trace_push_length_prefixed(out = out, text = resolution_context_fingerprint)
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// Observation-only wrapper for the file_compile persistent pre-strip WASI
/// bump lane. Production compilation/lookup happens first and is unchanged.
/// The graph/context reads below are trace-only extra I/O and never select
/// cache namespaces, lookup/store keys, or reuse decisions.
export fn compile_file_fs_mode_cached_artifact_input_trace(entry_path: String, entry_name: String, mode: String, run_nonce: String, checked_error_row_mode: String, diagnostics_mode: String, dep_order_seed: String) -> (Bytes, String) with Env + Exception + Fs {
  if mode != "no-dce" {
    throw("artifact-input trace only supports file_compile WASI no-dce")
  } else if run_nonce == "" {
    throw("artifact-input trace requires a non-empty run nonce")
  } else if (checked_error_row_mode != "checked" && checked_error_row_mode != "unchecked") || (diagnostics_mode != "all" && diagnostics_mode != "fail-fast") {
    throw("artifact-input trace received invalid effective compile configuration")
  } else {
    let persistent_artifact_kind = "file-compile-wasi"
    let (bytes, _, source_groups_fingerprint, production_artifact_input_fingerprint, persistent_lookup) = compile_file_fs_mode_cached_observed(db = db_new(), entry_path = entry_path, entry_name = entry_name, mode = mode)
    // Exact existing authorities, intentionally outside production work.
    let source_groups = collect_source_groups_fs(entry_path)
    let resolution_context_fingerprint = artifact_input_trace_resolution_context_fingerprint_fs(entry_path = entry_path, groups = source_groups)
    let (dependency_plan_fingerprint, dependency_plan_module_count, dependency_plan_edge_occurrence_count) = artifact_input_trace_dependency_plan_evidence_fs(entry_path)
    let resolution_seed = resolution_env_seed()
    let compiler_cache_version_tag = persistent_cache_version_tag_for_observation()
    let shadow_artifact_input_fingerprint = artifact_input_trace_shadow_fingerprint(production_fingerprint = production_artifact_input_fingerprint, source_groups_fingerprint = source_groups_fingerprint, compiler_cache_version_tag = compiler_cache_version_tag, checked_error_row_mode = checked_error_row_mode, diagnostics_mode = diagnostics_mode, dep_order_seed = dep_order_seed, dependency_plan_fingerprint = dependency_plan_fingerprint, resolution_seed = resolution_seed, resolution_context_fingerprint = resolution_context_fingerprint)
    let out = StringBuilder::new()
    StringBuilder::push(out, value = "{\"schema\":2,\"run_nonce\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(run_nonce))
    StringBuilder::push(out, value = ",\"scope_disclaimer\":\"observation-only file_compile persistent pre-strip WASI bump lane; trace-only graph/context work; not a production cache key, format, or reuse decision\",\"compile_lane\":\"file_compile.persistent_pre_strip_wasi_cached_bump\",\"persistent_artifact_kind\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(persistent_artifact_kind))
    StringBuilder::push(out, value = ",\"entry\":{\"path\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(entry_path))
    StringBuilder::push(out, value = ",\"name\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(entry_name))
    StringBuilder::push(out, value = ",\"mode\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(mode))
    StringBuilder::push(out, value = "},\"source_groups_fingerprint\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(source_groups_fingerprint))
    StringBuilder::push(out, value = ",\"source_groups_fingerprint_kind\":\"build_source_groups_fingerprint(source_groups)\",\"production_artifact_input_fingerprint\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(production_artifact_input_fingerprint))
    StringBuilder::push(out, value = ",\"production_artifact_input_fingerprint_kind\":\"build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\",\"compiler_cache_version_tag\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(compiler_cache_version_tag))
    StringBuilder::push(out, value = ",\"compiler_cache_version_tag_kind\":\"persistent_cache_version_tag()\",\"effective_config\":{\"checked_error_row_mode\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(checked_error_row_mode))
    StringBuilder::push(out, value = ",\"diagnostics_mode\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(diagnostics_mode))
    StringBuilder::push(out, value = ",\"dep_order_seed\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(dep_order_seed))
    StringBuilder::push(out, value = ",\"target\":\"wasi\",\"memory\":\"bump\",\"dce_mode\":\"no-dce\",\"strip_stage\":\"pre-strip\",\"instrumentation\":\"uninstrumented\"},\"dependency_plan\":{\"fingerprint\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(dependency_plan_fingerprint))
    StringBuilder::push(out, value = ",\"fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-dependency-plan:v1 length-prefixed planned order/ranks/dependency occurrences)\",\"module_count\":")
    StringBuilder::push(out, value = __to_string(dependency_plan_module_count))
    StringBuilder::push(out, value = ",\"edge_occurrence_count\":")
    StringBuilder::push(out, value = __to_string(dependency_plan_edge_occurrence_count))
    StringBuilder::push(out, value = "},\"resolution\":{\"env_seed\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(resolution_seed))
    StringBuilder::push(out, value = ",\"env_seed_kind\":\"resolution_env_seed()\",\"context_fingerprint\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(resolution_context_fingerprint))
    StringBuilder::push(out, value = ",\"context_fingerprint_kind\":\"persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(source_groups))\"},\"shadow_artifact_input_fingerprint\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(shadow_artifact_input_fingerprint))
    StringBuilder::push(out, value = ",\"shadow_artifact_input_fingerprint_kind\":\"compact_string_fingerprint(vibe-artifact-input-observation:v2 fixed-order length-prefixed components)\",\"persistent_lookup\":")
    StringBuilder::push(out, value = artifact_input_trace_json_string(persistent_lookup))
    StringBuilder::push(out, value = "}")
    (bytes, StringBuilder::freeze(out))
  }
}

export fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with Env + Exception + Fs {
  let (bytes, _) = compile_file_fs_cached(db = db_new(), entry_path = entry_path, entry_name = entry_name)
  bytes
}

export fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with Env + Exception + Fs + Profiler {
  let total_start = profiler_now_us()
  let persistent_artifact_kind = persistent_artifact_kind_for_mode(mode)
  let load_start = profiler_now_us()
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact(kind = persistent_artifact_kind, entry_name = entry_name, fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint = source_groups_fingerprint, entry_path = entry_path, entry_name = entry_name, mode = mode)) {
      Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),
      None => {
        let prefix_load_us = elapsed_us_since(load_start)
        let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db = db, entry_path = entry_path, entry_name = entry_name, mode = mode, persistent_artifact_kind = persistent_artifact_kind)
        (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
      }
    },
    None => {
      let prefix_load_us = elapsed_us_since(load_start)
      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db = db, entry_path = entry_path, entry_name = entry_name, mode = mode, persistent_artifact_kind = persistent_artifact_kind)
      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
    }
  }
}

/// #2437: the last FS caller to leave the reprint.
///
/// It used to print the merge into `merged_source`, reparse + filter + print
/// THAT into `module_source`, reparse the result UNLOCATED, and hand it to
/// `compile_module` -- so every node offset was -1, the per-module
/// typed-lowering rows had no offset space to be rebased into, and this lane
/// compiled with every channel EMPTY. What that costs is the pre-#2158
/// syntactic answer: a large `Int` rendering as the empty string, a `Double`
/// through a projection not rendering as a Double, `a < b` on Strings
/// comparing pointers wherever the desugar tracker cannot classify the shape
/// syntactically.
///
/// It now takes the route #2449 gave the inline entries, one layer up:
/// `merged_stmts_and_offsets` rebases the rows the check above already
/// published, so this is PLUMBING rather than the second whole-program check
/// this issue measured at +330 ms on a 960-function program (superlinear --
/// seconds per cold compile at compiler size). Two prints and two parses go
/// away with it; the reprint's statement filter is applied to the merge
/// instead (`module_lane_filter_stmts`), which preserves every node offset.
///
/// The precondition the inline siblings have to argue for is free here. The
/// memo is keyed by PATH, and `ensure_fingerprint_fs_impl` RESETS it and then
/// leaves a row for every module of the closure: a module served from the
/// persistent type-env cache counts as reused only if its offsets sidecar
/// loads too (`ensure_module_typed_lowering_offsets`), and otherwise it is
/// rechecked. So there is no window where a row left by an earlier compile of
/// a different source at the same path can be read.
///
/// Two deliberate consequences:
///
///   - The in-db artifact kind is `module-typed`, not `module`. `fs_compile`
///     carries a second copy of this entry that still compiles WITHOUT the
///     tables and still writes `module`; sharing a kind would let one entry
///     silently return the other's lowering on a shared `TypeDb`. The two
///     PERSISTENT kinds were already distinct (`file-compile-module` vs
///     `fs-compile-module`) and that key folds in `codegen_fingerprint()`, a
///     hash of every compiler source, so entries written before this change
///     cold-miss on their own.
///   - `db_grouped_merged_source` / `db_module_source` are no longer called
///     here, so this entry no longer bumps their counters. Those counters were
///     this lane's only behavioural coverage, so the tests that read them were
///     rewritten rather than deleted.
///
/// The artifact key keeps exactly the strength it had. It is derived from the
/// merged program's own text, not from the input sources: private namespacing
/// mangles names with the file PATH (`namespace_private_value_stmts`), so two
/// programs whose sources are identical can merge to different statements, and
/// a key hashed from the sources alone would hand the second call the first
/// call's bytes. Printing here costs one print of a program that used to be
/// printed TWICE -- and unlike before, nothing REPARSES that text, so the
/// offsets survive.
fn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Env + Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups = source_groups, entry_path = entry_path)
  match load_persistent_artifact(kind = "file-compile-module", entry_name = "", fingerprint = persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db = db, entry_path = entry_path, source_groups = source_groups)
      let (merged_stmts, float_offsets, int_offsets, bool_offsets, _, _) = merged_stmts_and_offsets(source_groups)
      let filtered = module_lane_filter_stmts(merged_stmts)
      let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(print_program(filtered), typed_offsets_key(floats = float_offsets, ints = int_offsets, bools = bool_offsets)))
      match db_load_artifact(db = next_db, _path = entry_path, kind = "module-typed", entry_name = "", fingerprint = artifact_fingerprint) {
        Some(bytes) => (bytes, next_db),
        None => {
          let bytes = compile_module_with_typed_offsets(stmts = filtered, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets)
          store_persistent_artifact(kind = "file-compile-module", entry_name = "", fingerprint = persistent_artifact_fingerprint, bytes = bytes)
          (bytes, db_store_artifact(db = next_db, _path = entry_path, kind = "module-typed", entry_name = "", fingerprint = artifact_fingerprint, bytes = bytes))
        }
      }
    }
  }
}

export fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Env + Exception + Fs {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact(kind = "file-compile-module", entry_name = "", fingerprint = build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint = source_groups_fingerprint, entry_path = entry_path)) {
      Some(bytes) => (bytes, db),
      None => compile_file_fs_module_cached_slow(db = db, entry_path = entry_path)
    },
    None => compile_file_fs_module_cached_slow(db = db, entry_path = entry_path)
  }
}

export fn compile_file_fs_module(_ entry_path: String) -> Bytes with Env + Exception + Fs {
  let (bytes, _) = compile_file_fs_module_cached(db = db_new(), entry_path = entry_path)
  bytes
}
