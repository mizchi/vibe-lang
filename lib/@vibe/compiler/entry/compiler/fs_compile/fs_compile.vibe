//# Functions

fn empty_stmt_array() -> Array[Stmt] {
  array_empty()
}

fn seed_type_db(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb {
  let mut seeded = db
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    seeded = db_set_source(seeded, path, source)
    i = i + 1
  }
  db_set_source(seeded, main_path, main_source)
}

fn flatten_source_groups(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {
  let flat = array_empty()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(flat, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  flat
}

fn normalize_source_groups(source_groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {
  let normalized = array_empty()
  let mut found = false
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, gi)
    let next_sources = array_empty()
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == main_path {
        Array::push(next_sources, (path, main_source))
        found = true
      } else {
        Array::push(next_sources, (path, source))
      }
      si = si + 1
    }
    Array::push(normalized, (group_name, next_sources))
    gi = gi + 1
  }
  if !found {
    let entry_sources = array_empty()
    Array::push(entry_sources, (main_path, main_source))
    Array::push(normalized, ("entry", entry_sources))
  }
  normalized
}

fn contains_source_path(sources: Array[(String, String)], target_path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) && !found {
    let (path, _) = Array::get(sources, i)
    if path == target_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn filter_source_groups(source_groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {
  let filtered_groups = array_empty()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, gi)
    let next_sources = array_empty()
    let mut si = 0
    while si < Array::length(sources) {
      let pair = Array::get(sources, si)
      let (path, _) = pair
      if contains_source_path(ordered_sources, path) {
        Array::push(next_sources, pair)
      }
      si = si + 1
    }
    if Array::length(next_sources) > 0 {
      Array::push(filtered_groups, (group_name, next_sources))
    }
    gi = gi + 1
  }
  filtered_groups
}

export fn source_group_total_source_count(source_groups: Array[(String, Array[(String, String)])]) -> Int {
  let mut total = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    total = total + Array::length(sources)
    gi = gi + 1
  }
  total
}

export fn source_group_ordered_source_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  Array::length(ordered_sources)
}

export fn source_group_filtered_group_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  Array::length(filtered_groups)
}

fn string_array_contains_local(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
/// are the locals the export-rename plan already rewrites; the inline copy gets
/// the target file's export renames applied first.
fn append_inline_import_alias_collision_defs(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with Exception {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      let source = source_lookup_or_throw(sources, resolved)
      let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program(lex(source)), export_plan_renames_for(plan, resolved)))
      let mut j = 0
      let mut done = false
      while j < Array::length(source_stmts) && !done {
        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
          Some(local_stmt) => {
            Array::push(merged, local_stmt)
            Array::push(emitted, local)
            done = true
          },
          None => ()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
}

export fn prepare_modules_cached(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with Exception {
  let seeded = seed_type_db(db, main_path, main_source, sources)
  db_typecheck(seeded, main_path)
}

fn prepare_modules_persistent_fs_cached(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with Exception + Fs {
  let seeded = seed_type_db(db, main_path, main_source, sources)
  db_typecheck_fs(seeded, main_path)
}

export fn source_group_prepare_typecheck_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  db_typecheck_count(next_db)
}

export fn grouped_source_merged_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)
  String::length(merged_source)
}

export fn source_group_module_source_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)
  String::length(module_source)
}

export fn compile_with_modules(main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with Exception {
  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)
  bytes
}

export fn compile_with_modules_wasi(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with Exception {
  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)
  bytes
}

fn artifact_fingerprint_from_source(source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

fn build_merge_fingerprint_inline(sources: Array[(String, String)]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = String::concat(acc, String::concat("|", artifact_fingerprint_from_source(source)))
    acc = artifact_fingerprint_from_source(next)
    i = i + 1
  }
  acc
}

fn build_merged_stmts_inline(sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  // #2205: the rename table describes ONE merged program.
  namespace_rename_originals_reset()
  let merged = empty_stmt_array()
  let source_count = Array::length(sources)
  // #716: parse once, then build the whole-program export-rename plan (last
  // source is the entry) before appending any file.
  let file_paths = array_empty()
  let file_stmts = array_empty()
  let mut pi = 0
  while pi < source_count {
    let (path, source) = Array::get(sources, pi)
    Array::push(file_paths, path)
    Array::push(file_stmts, parse_program(lex(source)))
    pi = pi + 1
  }
  let plan_entry = if source_count > 0 {
    Array::get(file_paths, source_count - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, si)
    let stmts = Array::get(file_stmts, si)
    let is_entry_source = si == source_count - 1
    let import_renames = collect_import_value_renames(plan, path, stmts)
    let (boundary_locals, boundary_surface_only) = merged_source_boundary_names(stmts)
    append_builtin_iterator_plan_operation_markers(boundary_locals, import_renames, plan)
    Array::push(merged, SReExportSourceBoundary(boundary_locals, boundary_surface_only))
    let collision_renames = if is_entry_source {
      trait_import_local_operation_renames_preserving_exports(stmts, path)
    } else {
      trait_import_local_operation_renames(stmts, path)
    }
    let collision_renamed = apply_export_renames_stmts(stmts, collision_renames)
    let export_renamed = if is_entry_source {
      collision_renamed
    } else {
      apply_export_renames_stmts(collision_renamed, export_plan_renames_for(plan, path))
    }
    let namespaced_stmts = if is_entry_source {
      export_renamed
    } else {
      namespace_private_value_stmts(path, export_renamed)
    }
    let skipped_locals = collect_import_alias_collision_locals(stmts)
    append_inline_import_alias_collision_defs(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))
    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
    si = si + 1
  }
  merged
}

fn prune_entry_stmts(stmts: Array[Stmt], entry_name: String) -> Array[Stmt] {
  dce_stmts(stmts, [entry_name])
}

export fn closure_ordered_source_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with Exception {
  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))
}

fn count_executable_merge_stmts(stmts: Array[Stmt]) -> Int {
  let mut count = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SReExportSourceBoundary(_, _) => (),
      _ => count = count + 1
    }
    i = i + 1
  }
  count
}

/// The import-resolved in-memory merge used by closure-source compilation.
/// Source boundary metadata remains present so diagnostics and optimizer
/// inspection observe the same AST consumed by codegen.
export fn closure_merged_stmts(main_source: String, main_path: String, sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  build_merged_stmts_inline(collect_inline_sources_ordered(main_path, main_source, sources))
}

export fn closure_merged_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with Exception {
  count_executable_merge_stmts(closure_merged_stmts(main_source, main_path, sources))
}

export fn closure_pruned_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Int with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
  count_executable_merge_stmts(pruned_stmts)
}

export fn source_group_pruned_stmt_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let _ = db
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
  count_executable_merge_stmts(pruned_stmts)
}

export fn compile_with_modules_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)]) -> (Bytes, TypeDb) with Exception {
  let next_db = prepare_modules_cached(db, main_path, main_source, sources)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)
  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)
  match db_load_artifact(codegen_db, main_path, "module", "", artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let stmts = parse_program(lex(module_source))
      let bytes = compile_module(stmts)
      (bytes, db_store_artifact(codegen_db, main_path, "module", "", artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_modules_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let next_db = prepare_modules_cached(db, main_path, main_source, sources)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_kind = if mode == "mvp" {
    "wasi-mvp"
  } else if mode == "no-dce" {
    "wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode)))))
  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let bytes = if mode == "mvp" {
        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
        compile_wasi_module_impl(pruned_stmts, entry_name)
      } else {
        compile_wasi_module_no_dce_impl(merged_stmts, entry_name)
      }
      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_kind = if mode == "mvp" {
    "wasi-mvp-unchecked"
  } else if mode == "no-dce" {
    "wasi-unchecked"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode)))))
  match db_load_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let bytes = if mode == "mvp" {
        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
        compile_wasi_module_impl(pruned_stmts, entry_name)
      } else {
        compile_wasi_module_no_dce_impl(merged_stmts, entry_name)
      }
      (bytes, db_store_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_unchecked(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with Exception {
  let (bytes, _) = compile_with_closure_sources_wasi_mode_unchecked_cached(db_new(), main_source, main_path, sources, entry_name, mode)
  bytes
}

export fn compile_with_closure_sources_wasi_mode_uncached(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  if mode == "mvp" {
    let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

export fn compile_with_source_groups_wasi_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(next_db, filtered_groups)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(codegen_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let merged_stmts = parse_program(lex(merged_source))
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(codegen_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_source_groups_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db, filtered_groups)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(merge_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, merge_db),
    None => {
      let merged_stmts = parse_program(lex(merged_source))
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(merge_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export fn compile_with_source_groups_via_module_source_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(module_source, String::concat("|", entry_name)))
  match db_load_artifact(codegen_db, main_path, "wasi-module-source", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)
      let bytes = compile_wasi_module_impl(pruned_stmts, entry_name)
      (bytes, db_store_artifact(codegen_db, main_path, "wasi-module-source", entry_name, artifact_fingerprint, bytes))
    }
  }
}

/// ADR-0055 #493 cutover: RC-codegen variant of the module-source self-compile
/// path. Identical pipeline to the function above, but emits via the Perceus RC
/// backend (compile_wasi_module_rc_impl). This is the real vehicle the compiler
/// uses to compile *itself* (build_cli_adapter_bytes), so an
/// RC variant gives the whole-compiler-under-RC validity signal for the cutover.
/// A distinct artifact key ("wasi-module-source-rc") keeps the RC and default
/// caches from colliding.
export fn compile_with_source_groups_via_module_source_wasi_unchecked_rc(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Exception {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, flatten_source_groups(normalized_groups))
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(module_source, String::concat("|", entry_name)))
  match db_load_artifact(codegen_db, main_path, "wasi-module-source-rc", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)
      let bytes = compile_wasi_module_rc_impl(pruned_stmts, entry_name)
      (bytes, db_store_artifact(codegen_db, main_path, "wasi-module-source-rc", entry_name, artifact_fingerprint, bytes))
    }
  }
}

/// #769: the compile chain below bottoms out in compile_file_fs_cached_slow's
/// `Env::get("VIBE_DUMP_FS_MERGED")` debug hook (#740) — that call was never
/// declared in ANY of these signatures. It went unnoticed because this
/// unreached-from-cli_main slow path is only actually type-checked in full
/// when something (e.g. the #769 unit-test corpus scan) compiles a program
/// whose import closure reaches it directly, rather than via the pre-flattened
/// bundle the real self-build/CLI binaries compile from.
export fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with Exception + Fs + Env {
  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)
  bytes
}

export fn compile_file_fs_module(entry_path: String) -> Bytes with Exception + Fs {
  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)
  bytes
}

export fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
}

fn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception {
  let sources = flatten_source_groups(source_groups)
  let main_source = source_lookup_or_throw(sources, entry_path)
  prepare_modules_cached(db, entry_path, main_source, sources)
}

fn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with Exception + Fs {
  let sources = flatten_source_groups(source_groups)
  let main_source = source_lookup_or_throw(sources, entry_path)
  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)
}

fn compile_file_fs_cached_slow(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with Exception + Fs + Env {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups, entry_path, entry_name)
  match load_persistent_artifact("fs-compile-wasi", entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)
      // #740 debug hook: dump the grouped-merge output for lane forensics
      // (the flatten lane has VIBE_EMIT_MERGED_SOURCE; this lane had no
      // equivalent, which made its rename/visibility bugs opaque).
      let dump_path = Env::get("VIBE_DUMP_FS_MERGED")
      if dump_path == "" {
        ()
      } else {
        Fs::write_file(dump_path, merged_source)
      }
      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)
      match db_load_artifact(codegen_db, entry_path, "wasi", entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, codegen_db),
        None => {
          let merged_stmts = parse_program(lex(merged_source))
          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
          let bytes = compile_wasi_module(pruned_stmts, entry_name)
          store_persistent_artifact("fs-compile-wasi", entry_name, persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(codegen_db, entry_path, "wasi", entry_name, artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with Exception + Fs + Env {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact("fs-compile-wasi", entry_name, build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name)) {
      Some(bytes) => (bytes, db),
      None => compile_file_fs_cached_slow(db, entry_path, entry_name)
    },
    None => compile_file_fs_cached_slow(db, entry_path, entry_name)
  }
}

fn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint_for_entry_path(source_groups, entry_path)
  match load_persistent_artifact("fs-compile-module", "", persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)
      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)
      match db_load_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint) {
        Some(bytes) => (bytes, codegen_db),
        None => {
          let merged_stmts = parse_program(lex(module_source))
          let bytes = compile_module(merged_stmts)
          store_persistent_artifact("fs-compile-module", "", persistent_artifact_fingerprint, bytes)
          (bytes, db_store_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with Exception + Fs {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
    match load_persistent_artifact("fs-compile-module", "", build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path)) {
      Some(bytes) => (bytes, db),
      None => compile_file_fs_module_cached_slow(db, entry_path)
    },
    None => compile_file_fs_module_cached_slow(db, entry_path)
  }
}
