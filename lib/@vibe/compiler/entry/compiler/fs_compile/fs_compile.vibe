//# Functions

fn empty_stmt_array() -> Array[Stmt] {
  array_empty()
}

fn seed_type_db(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb {
  let mut seeded = db
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, at = i)
    seeded = db_set_source(db = seeded, path = path, source = source)
    i = i + 1
  }
  db_set_source(db = seeded, path = main_path, source = main_source)
}

fn normalize_source_groups(source_groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {
  let normalized = array_empty()
  let mut found = false
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, at = gi)
    let next_sources = array_empty()
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, at = si)
      if path == main_path {
        Array::push(next_sources, value = (path, main_source))
        found = true
      } else {
        Array::push(next_sources, value = (path, source))
      }
      si = si + 1
    }
    Array::push(normalized, value = (group_name, next_sources))
    gi = gi + 1
  }
  if !found {
    let entry_sources = array_empty()
    Array::push(entry_sources, value = (main_path, main_source))
    Array::push(normalized, value = ("entry", entry_sources))
  }
  normalized
}

fn contains_source_path(sources: Array[(String, String)], target_path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) && !found {
    let (path, _) = Array::get(sources, at = i)
    if path == target_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn filter_source_groups(source_groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {
  let filtered_groups = array_empty()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, at = gi)
    let next_sources = array_empty()
    let mut si = 0
    while si < Array::length(sources) {
      let pair = Array::get(sources, at = si)
      let (path, _) = pair
      if contains_source_path(sources = ordered_sources, target_path = path) {
        Array::push(next_sources, value = pair)
      }
      si = si + 1
    }
    if Array::length(next_sources) > 0 {
      Array::push(filtered_groups, value = (group_name, next_sources))
    }
    gi = gi + 1
  }
  filtered_groups
}

export fn source_group_total_source_count(_ source_groups: Array[(String, Array[(String, String)])]) -> Int {
  let mut total = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, at = gi)
    total = total + Array::length(sources)
    gi = gi + 1
  }
  total
}

export fn source_group_ordered_source_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  Array::length(ordered_sources)
}

export fn source_group_filtered_group_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  Array::length(filtered_groups)
}

export fn prepare_modules_cached(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with Env + Exception {
  let seeded = seed_type_db(db = db, main_path = main_path, main_source = main_source, sources = sources)
  db_typecheck(db = seeded, path = main_path)
}

export fn source_group_prepare_typecheck_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = ordered_sources)
  db_typecheck_count(next_db)
}

export fn grouped_source_merged_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = ordered_sources)
  let (merged_source, _, _) = db_grouped_merged_source(db = next_db, groups = filtered_groups)
  String::length(merged_source)
}

export fn source_group_module_source_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db = db, groups = filtered_groups)
  let (module_source, _) = db_module_source(db = module_db, fingerprint = merge_fingerprint, source = merged_source)
  String::length(module_source)
}

export fn compile_with_modules(main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with Env + Exception {
  let (bytes, _) = compile_with_modules_cached(db = db_new(), main_source = main_source, main_path = main_path, sources = sources)
  bytes
}

export fn compile_with_modules_wasi(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with Env + Exception {
  let (bytes, _) = compile_with_modules_wasi_cached(db = db_new(), main_source = main_source, main_path = main_path, sources = sources, entry_name = entry_name)
  bytes
}

fn build_merge_fingerprint_inline(_ sources: Array[(String, String)]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, at = i)
    let next = String::concat(acc, String::concat("|", artifact_fingerprint_from_source(source)))
    acc = artifact_fingerprint_from_source(next)
    i = i + 1
  }
  acc
}

/// The merge WITHOUT the offset tables: statement counts, and the entries that
/// deliberately skip the per-module check. Both merges are the same program --
/// this one just discards the bases, so nothing downstream can read rows that
/// were not proven for these sources (see merged_stmts_and_offsets_inline).
fn build_merged_stmts_inline(_ sources: Array[(String, String)]) -> Array[Stmt] with Exception {
  build_merged_stmts_inline_impl(sources = sources, flat_paths_out = array_empty(), flat_bases_out = array_empty(), clone_float_offsets_out = array_empty())
}

/// #2449: the inline-source merge, with each file rebased into its own
/// disjoint offset range and its base reported -- the same shape
/// `build_grouped_merged_stmts_impl` (entry/compiler/file_compile) has had
/// since #2391, one layer down.
///
/// Before this the merge parsed with `parse_program(lex(source))`, so every
/// node offset was -1 and there was no offset space at all: every entry built
/// on this merge compiled with each typed-lowering channel EMPTY, the linked
/// lane included. An empty table classifies nothing, so what those entries got
/// was the pre-#2158 syntactic answer -- a large `Int` rendering as the empty
/// string, a `Double` reached through a projection not rendering as a Double,
/// `a < b` on Strings comparing pointers wherever the desugar tracker cannot
/// see the shape syntactically.
///
/// The parse is now `parse_program_with_path`, which is BOTH located and the
/// same memoized parse the per-module check already performed, so this reads
/// one merge's worth of parsing rather than adding a second one.
fn build_merged_stmts_inline_impl(sources: Array[(String, String)], flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int]) -> Array[Stmt] with Exception {
  // #1872 boundary 4: one merge implementation (linker/merge).
  build_inline_merged_stmts(sources = sources, flat_paths_out = flat_paths_out, flat_bases_out = flat_bases_out, clone_float_offsets_out = clone_float_offsets_out)
}

/// #2449: the inline merge plus the typed-lowering tables the per-module check
/// recorded, rebased into the merge's offset space -- the inline-source
/// sibling of `merged_stmts_and_offsets` (entry/compiler/file_compile).
///
/// Only entries that actually ran `prepare_modules_cached` may use this. The
/// memo is process-global and keyed by PATH, so an entry that deliberately
/// skips the check (the `*_unchecked_*` family) must keep the empty tables:
/// reading rows an earlier compile of a DIFFERENT source at the same path left
/// behind is exactly the silently-wrong shape these tables exist to remove.
fn merged_stmts_and_offsets_inline(_ sources: Array[(String, String)]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Env + Exception {
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let merged = build_merged_stmts_inline_impl(sources = sources, flat_paths_out = flat_paths, flat_bases_out = flat_bases, clone_float_offsets_out = clone_float_offsets)
  let (floats, rels, pluses, int_renders, bool_renders) = split_typed_lowering_offsets(union_module_typed_lowering_with_clones(flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets = clone_float_offsets))
  let (eq_offs, eq_keys) = union_module_typed_eq_rows(flat_paths = flat_paths, flat_bases = flat_bases)
  (rewrite_string_binops_stmts(stmts = merged, rels = rels, pluses = pluses, anchor = typed_lowering_binop_anchor), floats, int_renders, bool_renders, eq_offs, eq_keys)
}

fn prune_entry_stmts(stmts: Array[Stmt], entry_name: String) -> Array[Stmt] {
  dce_stmts_before_trait_desugar(stmts = stmts, entry_names = [entry_name])
}

export fn closure_ordered_source_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with Exception {
  Array::length(collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources))
}

fn count_executable_merge_stmts(_ stmts: Array[Stmt]) -> Int {
  let mut count = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SReExportSourceBoundary(_, _) => (),
      _ => count = count + 1
    }
    i = i + 1
  }
  count
}

/// The import-resolved in-memory merge used by closure-source compilation.
/// Source boundary metadata remains present so diagnostics and optimizer
/// inspection observe the same AST consumed by codegen.
export fn closure_merged_stmts(main_source: String, main_path: String, sources: Array[(String, String)]) -> Array[Stmt] with Env + Exception {
  build_merged_stmts_inline(collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources))
}

export fn closure_merged_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with Env + Exception {
  count_executable_merge_stmts(closure_merged_stmts(main_source = main_source, main_path = main_path, sources = sources))
}

export fn closure_pruned_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Int with Env + Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
  count_executable_merge_stmts(pruned_stmts)
}

export fn source_group_pruned_stmt_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> Int with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let _ = db
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
  count_executable_merge_stmts(pruned_stmts)
}

/// #2437/#2449: the last of the three inline entries to leave the reprint.
///
/// It used to build `merged_source` by printing the merge, reparse that text
/// UNLOCATED, and hand the result to `compile_module` -- so every node offset
/// was -1, the per-module typed-lowering rows had no offset space to be
/// rebased into, and this lane compiled with each channel EMPTY. What that
/// costs is the pre-#2158 syntactic answer: a large `Int` rendering as the
/// empty string, a `Double` through a projection not rendering as a Double,
/// `a < b` on Strings comparing pointers wherever the desugar tracker cannot
/// classify the shape syntactically.
///
/// It now takes the same route the two wasi entries below took under #2449:
/// `merged_stmts_and_offsets_inline` rebases the rows `prepare_modules_cached`
/// already published, so this is plumbing rather than a second check. The
/// reprint's statement filter is applied to the merge instead
/// (`module_lane_filter_stmts`).
///
/// Two deliberate consequences:
///
///   - The artifact kind is `module-typed`, not `module`. Same reason #2449
///     split `wasi-typed` off `wasi`: this entry now emits DIFFERENT bytes for
///     the same sources, and sharing a kind with an entry that compiles
///     without the tables would let one silently return the other's lowering.
///   - `db_merged_source` / `db_module_source` are no longer called here, so
///     this entry no longer bumps their counters. It also no longer reprints
///     the program twice.
///
/// The artifact key keeps EXACTLY the strength it had. It is derived from the
/// merged program's own text, not from the input sources: private namespacing
/// mangles names with the file PATH (`namespace_private_value_stmts`), so two
/// programs whose sources are identical can merge to different statements, and
/// a key hashed from the sources alone would hand the second call the first
/// call's bytes. Printing here costs one print of a program that used to be
/// printed TWICE -- and unlike before, nothing REPARSES that text, so the
/// offsets survive.
export fn compile_with_modules_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)]) -> (Bytes, TypeDb) with Env + Exception {
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = sources)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let (merged_stmts, float_offsets, int_offsets, bool_offsets, _, _) = merged_stmts_and_offsets_inline(ordered_sources)
  let filtered = module_lane_filter_stmts(merged_stmts)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(print_program(filtered), typed_offsets_key(floats = float_offsets, ints = int_offsets, bools = bool_offsets)))
  match db_load_artifact(db = next_db, _path = main_path, kind = "module-typed", entry_name = "", fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let bytes = compile_module_with_typed_offsets(stmts = filtered, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets)
      (bytes, db_store_artifact(db = next_db, _path = main_path, kind = "module-typed", entry_name = "", fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

/// #2449 (Codex review on #2453): the artifact kind is `wasi-typed`, not
/// `wasi`. The `wasi` kind is what an entry that compiles WITHOUT the
/// typed-lowering tables writes, and this one now emits different bytes for the
/// same sources -- the fingerprint is derived from the sources alone, so
/// sharing the kind means the second of two entries called on one `TypeDb`
/// silently gets the first's lowering. Measured before the split, unchecked
/// then checked on a shared db: the checked call returned the UNCHECKED bytes,
/// which differed from what it produces on a fresh db.
export fn compile_with_modules_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = sources)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db = next_db, _path = main_path, kind = "wasi-typed", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      // #2449: `next_db` is `prepare_modules_cached`'s, so every module of this
      // program has been checked in this process and published its
      // typed-lowering rows. The merge rebases them into one offset space and
      // hands them to codegen -- the tables the linked lane exists to consume.
      let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module_impl_with_typed_offsets(stmts = pruned_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
      (bytes, db_store_artifact(db = next_db, _path = main_path, kind = "wasi-typed", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db = next_db, _path = main_path, kind = "wasi-typed", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      // #2449: `next_db` is `prepare_modules_cached`'s, so every module of this
      // program has been checked in this process and published its
      // typed-lowering rows. The merge rebases them into one offset space and
      // hands them to codegen -- the tables the linked lane exists to consume.
      let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module_impl_with_typed_offsets(stmts = pruned_stmts, entry_name = entry_name, checker_float_call_offsets = float_offsets, checker_int_render_offsets = int_offsets, checker_bool_render_offsets = bool_offsets, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
      (bytes, db_store_artifact(db = next_db, _path = main_path, kind = "wasi-typed", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with Env + Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  // #2449 (Codex review on #2453): `-typed` for the same reason the two
  // entries above carry it -- this entry now compiles WITH the typed-lowering
  // tables, so it must not share a cache key with one that does not.
  let selected_mode = checked_wasi_mode(mode)
  let artifact_kind = checked_wasi_artifact_kind(selected_mode)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode)))))
  match db_load_artifact(db = next_db, _path = main_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      // #2449: checked entry -- see compile_with_modules_wasi_cached above.
      let (merged_stmts, float_offsets, int_offsets, bool_offsets, eq_offsets, eq_keys) = merged_stmts_and_offsets_inline(ordered_sources)
      let bytes = emit_checked_wasi(mode = selected_mode, stmts = merged_stmts, entry_name = entry_name, floats = float_offsets, ints = int_offsets, bools = bool_offsets, eq_offsets = eq_offsets, eq_keys = eq_keys)
      (bytes, db_store_artifact(db = next_db, _path = main_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db = db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module(stmts = pruned_stmts, entry_name = entry_name)
      (bytes, db_store_artifact(db = db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with Env + Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_kind = if mode == "mvp" {
    "wasi-mvp-unchecked"
  } else if mode == "no-dce" {
    "wasi-unchecked"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode)))))
  match db_load_artifact(db = db, _path = main_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let bytes = if mode == "mvp" {
        let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
        compile_wasi_module_impl(stmts = pruned_stmts, entry_name = entry_name)
      } else {
        compile_wasi_module_no_dce_impl(stmts = merged_stmts, entry_name = entry_name)
      }
      (bytes, db_store_artifact(db = db, _path = main_path, kind = artifact_kind, entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_closure_sources_wasi_mode_unchecked(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with Env + Exception {
  let (bytes, _) = compile_with_closure_sources_wasi_mode_unchecked_cached(db = db_new(), main_source = main_source, main_path = main_path, sources = sources, entry_name = entry_name, mode = mode)
  bytes
}

/// The in-memory closure compile with no `Env`: what a portable host that
/// supplies its own sources reaches. scripts/check_portable_boundary.sh pins
/// its row.
export fn compile_with_closure_sources_wasi_mode_uncached(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with Exception {
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  if mode == "mvp" {
    let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
    compile_wasi_module_impl(stmts = pruned_stmts, entry_name = entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module_no_dce_impl(stmts = merged_stmts, entry_name = entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

export fn compile_with_source_groups_wasi_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let next_db = prepare_modules_cached(db = db, main_path = main_path, main_source = main_source, sources = ordered_sources)
  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(db = next_db, groups = filtered_groups)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db = codegen_db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let merged_stmts = parse_program(lex(merged_source))
      let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module(stmts = pruned_stmts, entry_name = entry_name)
      (bytes, db_store_artifact(db = codegen_db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_source_groups_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db = db, groups = filtered_groups)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(merge_fingerprint, String::concat("|", entry_name)))
  match db_load_artifact(db = merge_db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, merge_db),
    None => {
      let merged_stmts = parse_program(lex(merged_source))
      let pruned_stmts = prune_entry_stmts(stmts = merged_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module(stmts = pruned_stmts, entry_name = entry_name)
      (bytes, db_store_artifact(db = merge_db, _path = main_path, kind = "wasi", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

export fn compile_with_source_groups_via_module_source_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db = db, groups = filtered_groups)
  let (module_source, codegen_db) = db_module_source(db = module_db, fingerprint = merge_fingerprint, source = merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(module_source, String::concat("|", entry_name)))
  match db_load_artifact(db = codegen_db, _path = main_path, kind = "wasi-module-source", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(stmts = module_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module_impl(stmts = pruned_stmts, entry_name = entry_name)
      (bytes, db_store_artifact(db = codegen_db, _path = main_path, kind = "wasi-module-source", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

/// ADR-0055 #493 cutover: RC-codegen variant of the module-source self-compile
/// path. Identical pipeline to the function above, but emits via the Perceus RC
/// backend (compile_wasi_module_rc_impl). This is the real vehicle the compiler
/// uses to compile *itself* (build_cli_adapter_bytes), so an
/// RC variant gives the whole-compiler-under-RC validity signal for the cutover.
/// A distinct artifact key ("wasi-module-source-rc") keeps the RC and default
/// caches from colliding.
export fn compile_with_source_groups_via_module_source_wasi_unchecked_rc(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with Env + Exception {
  let normalized_groups = normalize_source_groups(source_groups = source_groups, main_path = main_path, main_source = main_source)
  let ordered_sources = collect_inline_sources_ordered(main_path = main_path, main_source = main_source, sources = flatten_group_sources(normalized_groups))
  let filtered_groups = filter_source_groups(source_groups = normalized_groups, ordered_sources = ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db = db, groups = filtered_groups)
  let (module_source, codegen_db) = db_module_source(db = module_db, fingerprint = merge_fingerprint, source = merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(String::concat(module_source, String::concat("|", entry_name)))
  match db_load_artifact(db = codegen_db, _path = main_path, kind = "wasi-module-source-rc", entry_name = entry_name, fingerprint = artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(stmts = module_stmts, entry_name = entry_name)
      let bytes = compile_wasi_module_rc_impl(stmts_in = pruned_stmts, entry_name = entry_name)
      (bytes, db_store_artifact(db = codegen_db, _path = main_path, kind = "wasi-module-source-rc", entry_name = entry_name, fingerprint = artifact_fingerprint, bytes = bytes))
    }
  }
}

enum CheckedWasiMode {
  CheckedWasiMvp;
  CheckedWasiNoDce;
  CheckedWasiRc;
  CheckedWasiRcShadow
}

fn checked_wasi_mode(_ mode: String) -> CheckedWasiMode with Exception {
  if mode == "mvp" {
    CheckedWasiMvp
  } else if mode == "no-dce" {
    CheckedWasiNoDce
  } else if mode == "rc" {
    CheckedWasiRc
  } else if mode == "rc-shadow" {
    CheckedWasiRcShadow
  } else {
    throw("unsupported compile mode: " + mode + "; choose mvp, no-dce, rc or rc-shadow")
  }
}

fn checked_wasi_artifact_kind(_ mode: CheckedWasiMode) -> String {
  match mode {
    CheckedWasiMvp => "wasi-mvp-typed",
    CheckedWasiNoDce => "wasi-typed",
    CheckedWasiRc => "wasi-rc-typed",
    CheckedWasiRcShadow => "wasi-rc-shadow-typed"
  }
}

fn emit_checked_wasi(mode: CheckedWasiMode, stmts: Array[Stmt], entry_name: String, floats: Array[Int], ints: Array[Int], bools: Array[Int], eq_offsets: Array[Int], eq_keys: Array[String]) -> Bytes with Exception {
  match mode {
    CheckedWasiMvp => compile_wasi_module_impl_with_typed_offsets(stmts = prune_entry_stmts(stmts = stmts, entry_name = entry_name), entry_name = entry_name, checker_float_call_offsets = floats, checker_int_render_offsets = ints, checker_bool_render_offsets = bools, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys),
    CheckedWasiNoDce => compile_wasi_module_no_dce_impl_with_typed_offsets(stmts = stmts, entry_name = entry_name, checker_float_call_offsets = floats, checker_int_render_offsets = ints, checker_bool_render_offsets = bools, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys),
    CheckedWasiRc => compile_wasi_module_rc_impl_with_typed_offsets(stmts_in = stmts, entry_name = entry_name, checker_float_call_offsets = floats, checker_int_render_offsets = ints, checker_bool_render_offsets = bools, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys),
    CheckedWasiRcShadow => compile_wasi_module_rc_shadow_impl_with_typed_offsets(stmts_in = stmts, entry_name = entry_name, checker_float_call_offsets = floats, checker_int_render_offsets = ints, checker_bool_render_offsets = bools, checker_eq_offsets = eq_offsets, checker_eq_type_keys = eq_keys)
  }
}

/// Emit one checked invocation without reading ambient flags or lowering rows.
/// Callers supply its exact checked closure and capture inputs before another
/// check. Merge/codegen scratch remains owned by this serial phase; no artifact
/// cache, source discovery, recheck or launcher authority is acquired here.
export fn compile_checked_source_groups_wasi_with_config(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String, cfg: TargetCfg, inputs: CheckedLoweringInputs) -> Bytes with Exception {
  let selected_mode = checked_wasi_mode(mode)
  let (stmts, floats, ints, bools, eq_offsets, eq_keys) = merged_stmts_and_offsets_with_config(source_groups = source_groups, cfg = cfg, inputs = inputs)
  emit_checked_wasi(mode = selected_mode, stmts = stmts, entry_name = entry_name, floats = floats, ints = ints, bools = bools, eq_offsets = eq_offsets, eq_keys = eq_keys)
}

/// Capture target flags once; a mismatched checked product asks for a recheck.
/// This effect grants neither generated-source trust nor unstable imports.
export fn compile_checked_source_groups_wasi_configured(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String, inputs: CheckedLoweringInputs) -> Bytes with Config + Exception {
  let cfg = target_cfg_capture()
  compile_checked_source_groups_wasi_with_config(source_groups = source_groups, entry_name = entry_name, mode = mode, cfg = cfg, inputs = inputs)
}
