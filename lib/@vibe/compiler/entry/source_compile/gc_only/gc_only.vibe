//# Imports

import @vibe/compiler/syntax {
  Token, lex, parse_program, parse_stmt
}

import @vibe/core {
  array_empty
}
import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/codegen {
  desugar_trait_dicts
}

import @vibe/compiler/codegen/gc {
  compile_wasi_module_gc,
  gc_direct_abi_pre_erasure_generic_names,
  gc_float_returning_names_pre_erasure,
  gc_to_string_resolves_to_show_wrapper
}

// #847 Phase C exception: this file drives the wasm-gc backend
// (codegen/gc, imported above), which still has its own, unpatched
// capture-analysis path (codegen/gc/backend_lambda_collect.vibe,
// codegen/gc/backend_expr.vibe) mirroring the two #875 miscompile bugs
// already fixed for the linear/RC backends (compile_call.vibe,
// common_analysis/common_analysis.vibe + compile_lambda.vibe + compile_expr_tail.vibe).
// Routing this leaf import through core/index.vibe (now core/'s index.vpkg,
// #897) would grow this file's whole-program-merge graph the same way the
// fixed #875 cases did; until the gc-backend capture-analysis path gets its
// own fix (or a dedicated gc-selfbuild regression gate exists --
// scripts/test_gc_selfbuild.sh is not part of compiler_gate.sh today), avoid
// core/'s directory-shared-scope package entirely. #897: core/ast.vibe is
// itself now only a re-export shim of @vibe/ast (`export
// ../../../../lib/@vibe/ast { Expr, Pat, Stmt, TypeExpr }`), and importing a
// non-facade leaf inside a `.vpkg`-owned directory from OUTSIDE that
// directory is rejected by loader.vibe's package-boundary enforcement
// (enforce_incoming_boundary_fs) now that core/ has an index.vpkg -- so this
// import is redirected straight to @vibe/ast, core/ast.vibe's own real
// source, bypassing core/ (and its boundary) altogether. Same merge-graph
// weight as before (core/ast.vibe added no real code of its own), still
// skips types.vibe/import_alias_rewrite.vibe/dce.vibe/... entirely.
import @vibe/ast {
  Expr, Stmt, TypeExpr
}

//# Functions

// #897: gc_only/wasi_only are SIBLING packages under entry/source_compile/,
// each with its own index.vpkg. This file used to leaf-import
// wasi_only/preprocess_interp.vibe + preprocess_strip.vibe directly (a
// pre-existing #729 boundary violation that predates this migration batch,
// simply never exercised because nothing previously validated
// lib/@vibe/compiler/'s top-level directory as a real package -- cli_adapter.vibe,
// a member of that new package, needs compile_source_gc_only from HERE,
// so this file's own imports are now part of that package's validation
// closure). Routing through `import ../wasi_only { .. }` (the boundary-
// legal fix used for wasi_only's OTHER external callers, see that
// package's index.vpkg header) instead produces a genuine `type_db: import
// cycle detected at lib/@vibe/compiler/index.vpkg`: compiler.vibe (a
// sibling of cli_adapter.vibe in that same top-level package) already
// depends on wasi_only directly, and cli_adapter.vibe -> gc_only ->
// wasi_only is a second, simultaneous path to the same package from
// within the same top-level package's dependency-cycle-detection stack.
// Neither the leaf import nor the package import works from inside that
// closure. expand_interp_stmts/strip_generic_type_params (and the small
// interpolation-rewrite chain expand_interp_stmts needs) are pure,
// self-contained AST-rewrite helpers with no state and no interesting
// external dependents beyond wasi_only's own preprocess_compile.vibe/
// preprocess.vibe, so they are inlined here as private `gc_`-prefixed
// duplicates rather than moved to a shared ancestor package (that would
// mean relocating wasi_only's whole ~14-file preprocess_interp_*.vibe
// cluster, real behavior-preserving but far larger surface than this
// PR's scope) or left broken (blocking every external consumer of the
// new lib/@vibe/compiler/index.vpkg package, which is the whole point of
// this migration). If wasi_only's copies change, keep these in sync by
// hand -- same tradeoff as gc_only's other #847-Phase-C direct-dependency
// exceptions documented on the @vibe/ast import below.

fn gc_concat_exprs(lhs: Expr, rhs: Expr) -> Expr {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, lhs)
  ArrayBuilder::push(b, rhs)
  let args = ArrayBuilder::freeze(b)
  ECall(EIdent("String::concat", -1), args, -1)
}

fn gc_fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {
  let mut result = result0
  let mut j = j0
  while j < result_len {
    let rhs = Array::get(result_arr, j)
    result = gc_concat_exprs(result, rhs)
    j = j + 1
  }
  result
}

fn gc_fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr {
  let first = Array::get(result_arr, 0)
  gc_fold_interp_exprs_loop(result_arr, result_len, first, 1)
}

fn gc_fold_interp_exprs(result_arr: Array[Expr]) -> Expr {
  let result_len = Array::length(result_arr)
  if result_len == 0 {
    EString("")
  } else {
    gc_fold_interp_exprs_nonempty(result_arr, result_len)
  }
}

fn gc_parse_interp_expr(tokens: Array[Token]) -> Expr with Exception {
  let (stmt, _) = parse_stmt(tokens, [], 0)
  match stmt {
    SExpr(expr) => expr,
    _ => throw("expected interpolation expression")
  }
}

fn gc_collect_interp_exprs(parts: Array[String]) -> Array[Expr] with Exception {
  let plen = Array::length(parts)
  let exprs = ArrayBuilder::new()
  let mut i = 0
  while i < plen {
    let lit = Array::get(parts, i)
    if String::length(lit) > 0 {
      ArrayBuilder::push(exprs, EString(lit))
    }
    if i + 1 < plen {
      let expr_src = Array::get(parts, i + 1)
      let part_tokens = lex(expr_src)
      let part_expr = gc_parse_interp_expr(part_tokens)
      ArrayBuilder::push(exprs, ECall(EIdent("__to_string", -1), [part_expr], -1))
    }
    i = i + 2
  }
  ArrayBuilder::freeze(exprs)
}

fn gc_rewrite_interp_string(parts: Array[String]) -> Expr with Exception {
  let result_arr = gc_collect_interp_exprs(parts)
  gc_fold_interp_exprs(result_arr)
}

fn gc_rewrite_interp(e: Expr) -> Expr with Exception {
  match e {
    EStringInterp(parts) => gc_rewrite_interp_string(parts),
    ELet(name, val, body, soff) => ELet(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),
    ELetMut(name, val, body, soff) => ELetMut(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),
    ELetRec(name, val, body) => ELetRec(name, gc_rewrite_interp(val), gc_rewrite_interp(body)),
    ESeq(a, b) => ESeq(gc_rewrite_interp(a), gc_rewrite_interp(b)),
    ECall(callee, args, off) => ECall(gc_rewrite_interp(callee), for arg in args {
      gc_rewrite_interp(arg)
    }, off),
    EIf(c, t, e2) => EIf(gc_rewrite_interp(c), gc_rewrite_interp(t), gc_rewrite_interp(e2)),
    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, gc_rewrite_interp(body)),
    EMatch(scrut, arms) => EMatch(gc_rewrite_interp(scrut), for arm in arms {
      let (pat, body) = arm; (pat, gc_rewrite_interp(body))
    }),
    _ => e
  }
}

fn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, gc_rewrite_interp(expr)))
      ,
      STest(name, expr) => Array::set(stmts, i, STest(name, gc_rewrite_interp(expr)))
      ,
      SBench(name, expr) => Array::set(stmts, i, SBench(name, gc_rewrite_interp(expr)))
      ,
      _ => ()
    }
    i = i + 1
  }
  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the
  // program declares a trait with method signatures.
  desugar_trait_dicts(stmts)
}

/// #2141: see the wasi_only twin (preprocess_strip.vibe) -- a stripped
/// binder's spelling left in an annotation lets a same-spelled imported
/// struct claim the erased value at codegen's annotation-driven shape
/// seeding. Re-spell the stripped formals (`__Vfp_<name>`).
fn gc_strip_subst_ty(ty: TypeExpr, formals: Array[String]) -> TypeExpr {
  match ty {
    TyName(n) => if gc_strip_names_contains(formals, n) {
      TyName(String::concat("__Vfp_", n))
    } else {
      ty
    },
    TyApp(n, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, gc_strip_subst_ty(Array::get(args, i), formals))
        i = i + 1
      }
      if gc_strip_names_contains(formals, n) {
        TyApp(String::concat("__Vfp_", n), out)
      } else {
        TyApp(n, out)
      }
    },
    TyTuple(ts) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(ts) {
        Array::push(out, gc_strip_subst_ty(Array::get(ts, i), formals))
        i = i + 1
      }
      TyTuple(out)
    },
    _ => ty
  }
}

fn gc_strip_names_contains(names: Array[String], n: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if Array::get(names, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn gc_strip_subst_params(params: Array[(String, Option[TypeExpr])], formals: Array[String]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, pann) = Array::get(params, i)
    let pann2 = match pann {
      Some(te) => Some(gc_strip_subst_ty(te, formals)),
      None => None
    }
    Array::push(out, (pname, pann2))
    i = i + 1
  }
  out
}

fn strip_generic_type_params(stmts: Array[Stmt]) -> Unit {
  let empty_tp = array_empty()
  let empty_bounds = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          let params2 = gc_strip_subst_params(params, tparams)
          let ret2 = match ret {
            Some(rte) => Some(gc_strip_subst_ty(rte, tparams)),
            None => None
          }
          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params2, ret2, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #683: test/bench-block lowering for the gc lane, mirroring the linear
/// backend's in-codegen rewrite (codegen/wasi/linked_compile.vibe): each
/// `test "name" { body }` becomes `let __test_name = () -> { body; 0 }`,
/// and when the requested entry does not exist (the `vibe test` sentinel
/// path) a `_start` running every test/bench function in order is
/// synthesized at the AST level. Returns the effective entry name. This is
/// what lets `VIBE_TEST_BACKEND=gc bash scripts/vibe_test.sh file` run a
/// *_test.vibe on the wasm-gc backend under wasmtime.
fn lower_test_blocks_gc(stmts: Array[Stmt], entry_name: String) -> String with Exception {
  let empty_tp = array_empty()
  let empty_bounds = array_empty()
  let empty_params = array_empty()
  let test_fn_names = array_empty()
  let mut has_entry = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(_, _, name, _, _) => if name == entry_name {
        has_entry = true
      },
      _ => ()
    }
    i = i + 1
  }
  if has_entry || Array::length(test_fn_names) == 0 {
    entry_name
  } else {
    // Synthesize `_start` calling each test/bench fn in declaration order.
    let mut body = EInt(0)
    let mut ti = Array::length(test_fn_names) - 1
    while ti >= 0 {
      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), array_empty(), 0 - 1), body)
      ti = ti - 1
    }
    Array::push(stmts, SLet(true, false, "_start", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))
    "_start"
  }
}

/// #538 P4.5: the SAME source pipeline as compile_source_wasi_only — interp
/// expansion, check, trait-dict desugar, generic-param strip — in front of the
/// gc backend. The trait-dict desugar is what expands `a == b` on enum/struct
/// operands into the derived structural Eq walk (and Show's Int::to_string
/// etc.); without it the gc lane compared ctor POINTERS, so the gc-compiled
/// checker's Option/effect-row comparisons were silently wrong.
export fn compile_source_gc_only(source: String, entry_name: String) -> Bytes with Exception {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  // #683: lower test/bench blocks BEFORE the check so the synthesized
  // `__test_*` lets and the no-entry `_start` runner are type-checked like
  // ordinary functions.
  //
  // The order matters in both directions, so neither is free to change:
  // lowering FIRST is what makes a `handle` written inside a test block
  // eligible for the ADR-0076 direct-perform lowering (it wants a named
  // top-level `fn`; `fixtures/effect_effectset_expansion.vibe` is that
  // shape and compiles on this lane only for this reason), while the
  // checker's ambient test-effect grant is keyed off the STest / SBench
  // node this erases. #2107 closed the second half in the checker instead:
  // `lowered_test_ambient_effects` recognizes these two prefixes, so the
  // grant survives the lowering without changing what CODEGEN sees.
  let effective_entry = lower_test_blocks_gc(stmts, entry_name)
  let _ = check_program(stmts)
  // #1015: MUST run before strip_generic_type_params below -- that pass
  // unconditionally zeroes every top-level generic fn's type_params/bounds
  // (erasure, not specific to `to_string`), so checking the Show-bounded
  // generic-wrapper shape after stripping would always see 0 type params
  // and always return false, permanently disabling the gc-lane
  // to_string(Bool) call-site fast path (codegen/gc/backend_call.vibe).
  // See the doc comment on gc_to_string_resolves_to_show_wrapper.
  let gc_to_string_is_wrapper = gc_to_string_resolves_to_show_wrapper(stmts)
  let direct_abi_generic_names = gc_direct_abi_pre_erasure_generic_names(stmts)
  // #2178: this table must retain the function's type binders. Once the
  // erasure below removes them, a return type parameter that shadows a
  // Double alias is indistinguishable from that alias and is misclassified.
  let gc_float_ret_fn_names = gc_float_returning_names_pre_erasure(stmts)
  // Same effective order as the linear lane: strip source-level generic
  // params, then the trait-dict desugar (compile_wasi_module_linked_impl
  // runs it as its first step).
  strip_generic_type_params(stmts)
  desugar_trait_dicts(stmts)
  compile_wasi_module_gc(stmts, effective_entry, gc_to_string_is_wrapper, direct_abi_generic_names, gc_float_ret_fn_names)
}
