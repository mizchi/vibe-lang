// #847 Phase C exception: this file drives the wasm-gc backend
// (codegen/gc, imported above), which still has its own, unpatched
// capture-analysis path (codegen/gc/backend_lambda_collect.vibe,
// codegen/gc/backend_expr.vibe) mirroring the two #875 miscompile bugs
// already fixed for the linear/RC backends (compile_call.vibe,
// common_analysis/common_analysis.vibe + compile_lambda.vibe + compile_expr_tail.vibe).
// Routing this leaf import through core/index.vibe (now core/'s index.vpkg,
// #897) would grow this file's whole-program-merge graph the same way the
// fixed #875 cases did; until the gc-backend capture-analysis path gets its
// own fix (or a dedicated gc-selfbuild regression gate exists --
// scripts/test_gc_selfbuild.sh is not part of compiler_gate.sh today), avoid
// core/'s directory-shared-scope package entirely. #897: core/ast.vibe is
// itself now only a re-export shim of @vibe/ast (`export
// ../../../../lib/@vibe/ast { Expr, Pat, Stmt, TypeExpr }`), and importing a
// non-facade leaf inside a `.vpkg`-owned directory from OUTSIDE that
// directory is rejected by loader.vibe's package-boundary enforcement
// (enforce_incoming_boundary_fs) now that core/ has an index.vpkg -- so this
// import is redirected straight to @vibe/ast, core/ast.vibe's own real
// source, bypassing core/ (and its boundary) altogether. Same merge-graph
// weight as before (core/ast.vibe added no real code of its own), still
// skips types.vibe/import_alias_rewrite.vibe/dce.vibe/... entirely.
import @vibe/ast {
  Expr, Stmt
}

import @vibe/compiler/entry/source_compile/rewrite {
  expand_interp_only, strip_generic_type_params
}

//# Functions

/// #683: test/bench-block lowering for the gc lane, mirroring the linear
/// backend's in-codegen rewrite (codegen/wasi/linked_compile.vibe): each
/// `test "name" { body }` becomes `let __test_name = () -> { body; 0 }`,
/// and when the requested entry does not exist (the `vibe test` sentinel
/// path) a `_start` running every test/bench function in order is
/// synthesized at the AST level. Returns the effective entry name and whether
/// it is a compiler-generated test artifact. This is
/// what lets `VIBE_TEST_BACKEND=gc bash scripts/vibe_test.sh file` run a
/// *_test.vibe on the wasm-gc backend under wasmtime.
/// #2762 (Codex P1 round 3 on #2806): the third component is the list of
/// names this pass SYNTHESIZED, handed out so the export validation can
/// discount them. It is the list the pass already built for the `_start`
/// synthesis below, not a second derivation -- a `__test_` spelling rule would
/// have to keep agreeing with the two `String::concat` calls here, and would
/// refuse a user's own `let __test_probe`.
fn lower_test_blocks_gc(stmts: Array[Stmt], entry_name: String) -> (String, Bool, Array[String]) with Exception {
  let empty_tp = array_empty()
  let empty_bounds = array_empty()
  let empty_params = array_empty()
  let test_fn_names = array_empty()
  let mut has_entry = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(_, _, name, _, _) => if name == entry_name {
        has_entry = true
      },
      _ => ()
    }
    i = i + 1
  }
  if has_entry || Array::length(test_fn_names) == 0 {
    (entry_name, false, test_fn_names)
  } else {
    // Synthesize `_start` calling each test/bench fn in declaration order.
    let mut body = EInt(0)
    let mut ti = Array::length(test_fn_names) - 1
    while ti >= 0 {
      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), array_empty(), 0 - 1, [
      ]), body)
      ti = ti - 1
    }
    Array::push(stmts, SLet(true, false, "_start", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))
    // #2762 round 4 (Codex): `_start` is synthesized HERE, so it belongs in the
    // reported set too. Returning only `test_fn_names` left it out, and
    // `export { _start }` in a file with a test and no `main` was accepted by
    // this lane while the FS lane refused it -- measured, the same disagreement
    // the round-3 finding was about, one binding later.
    Array::push(test_fn_names, "_start")
    ("_start", true, test_fn_names)
  }
}

/// #538 P4.5: the SAME source pipeline as compile_source_wasi_only — interp
/// expansion, check, trait-dict desugar, generic-param strip — in front of the
/// gc backend. The trait-dict desugar is what expands `a == b` on enum/struct
/// operands into the derived structural Eq walk (and Show's Int::to_string
/// etc.); without it the gc lane compared ctor POINTERS, so the gc-compiled
/// checker's Option/effect-row comparisons were silently wrong.
/// #2762 (Codex P1 round 2 on #2806): `validate_exports` is the USER-source
/// gate, threaded in rather than re-derived -- this lane publishes no export
/// surface, so the refusal at publication never reaches it (measured: it
/// compiled `export { NotDeclaredAnywhere }` while every FS lane refused), and
/// a compiler-GENERATED statement graph must not be validated because merging
/// renames its declarations while the export list keeps its written spelling.
fn compile_stmts_gc_only_impl(stmts: Array[Stmt], entry_name: String, merged_offset_spaces: Bool, validate_exports: Bool) -> Bytes with Exception {
  expand_interp_only(stmts)
  // #683: lower test/bench blocks BEFORE the check so the synthesized
  // `__test_*` lets and the no-entry `_start` runner are type-checked like
  // ordinary functions.
  //
  // The order matters in both directions, so neither is free to change:
  // lowering FIRST is what makes a `handle` written inside a test block
  // eligible for the ADR-0076 direct-perform lowering (it wants a named
  // top-level `fn`; `fixtures/effect_effectset_expansion.vibe` is that
  // shape and compiles on this lane only for this reason), while the
  // checker's ambient test-effect grant is keyed off the STest / SBench
  // node this erases. #2107 closed the second half in the checker instead:
  // `lowered_test_ambient_effects` recognizes these two prefixes, so the
  // grant survives the lowering without changing what CODEGEN sees.
  let (effective_entry, generated_test_artifact, lowered_test_names) = lower_test_blocks_gc(stmts, entry_name)
  // #2441: the same observation carries the typed-`==` rows. On this lane
  // they need no rename mapping (the check runs on the POST-merge,
  // post-rename statements, so the keys already name the merged
  // declarations) and no uniqueness filter (the extraction poisons an
  // offset claimed by binops of different types; with the same type,
  // rewriting both is correct).
  let (checked, gc_float_call_offsets, gc_eq_offsets, gc_eq_keys) = match check_program_double_call_result_observation(stmts) {
    Some(observation) => observation,
    None => throw("internal compiler error: incomplete GC call-result type observation")
  }
  if validate_exports {
    // #2762 round 3: `lowered_test_names` are the bindings the test-block
    // lowering above introduced. Without discounting them the checked env made
    // `export { __test_probe }` look resolved and this lane ACCEPTED it while
    // the FS lane refused -- measured, and the lane disagreement this issue is
    // about.
    validate_user_source_exports_excluding(stmts, checked.final_env, lowered_test_names)
  } else {
    ()
  }
  // #3144 round 4: move a program's own `Array::length` / `Map::keys` / ...
  // aside HERE, right after the source-level check and export validation (the
  // two things that must see the program's spelling), and before the first
  // name-keyed table below. `direct_abi_generic_names` and
  // `gc_float_ret_fn_names` are collected from declaration names and read back
  // in codegen against the renamed ones; collected before the rename (inside
  // the desugar), a generic `fn Array::length[T](..)` read as monomorphic and
  // was admitted to the native Array-reference ABI, which excludes generic
  // signatures. The desugar and the backend repeat it (re-runnable, see
  // rename_builtin_shadow_defs).
  gc_rename_builtin_shadow_defs(stmts)
  // #1015: MUST run before strip_generic_type_params below -- that pass
  // unconditionally zeroes every top-level generic fn's type_params/bounds
  // (erasure, not specific to `to_string`), so checking the Show-bounded
  // generic-wrapper shape after stripping would always see 0 type params
  // and always return false, permanently disabling the gc-lane
  // to_string(Bool) call-site fast path (codegen/gc/backend_call.vibe).
  // See the doc comment on gc_to_string_resolves_to_show_wrapper.
  let gc_to_string_is_wrapper = gc_to_string_resolves_to_show_wrapper(stmts)
  let direct_abi_generic_names = gc_direct_abi_pre_erasure_generic_names(stmts)
  // #2178: this table must retain the function's type binders. Once the
  // erasure below removes them, a return type parameter that shadows a
  // Double alias is indistinguishable from that alias and is misclassified.
  let gc_float_ret_fn_names = gc_float_returning_names_pre_erasure(stmts)
  let gc_pre_hoist_fn_names = gc_top_level_function_names(stmts)
  // Same effective order as the linear lane: check the source contract first,
  // lower trait witnesses while generic binders are still present, then erase
  // those binders for codegen. GC previously lowered inside
  // expand_interp_stmts BEFORE checking, so the checker reinterpreted a
  // rank-1 witness field such as `map[A, B]` as a monomorphic struct field.
  // Constructor-indexed pipeline calls then rejected `Array[Int]` against the
  // generated `Array[A]`, despite the original source checking cleanly.
  desugar_trait_dicts_with_typed_eq(stmts, gc_eq_offsets, gc_eq_keys)
  // Trait-dict desugaring hoists capture-free effectful lambdas after the
  // pre-erasure snapshot. Add only those generated declarations; ordinary
  // declarations must keep the binder-aware pre-erasure answer.
  gc_add_hoisted_float_returning_names(stmts, gc_pre_hoist_fn_names, gc_float_ret_fn_names)
  strip_generic_type_params(stmts)
  // Located offsets are relative to one source file. The filesystem GC lane
  // merges several such ASTs, so the same integer can name unrelated calls.
  // Keep only keys that identify exactly one call in the final statements;
  // a collision then loses a float hint instead of misclassifying an Int call.
  let unique_gc_float_call_offsets = if merged_offset_spaces {
    unique_typed_lowering_offsets_in_stmts(stmts, gc_float_call_offsets)
  } else {
    // Direct source parsing has one offset space already. Avoid an extra AST
    // walk on the performance-sensitive selfbuild path.
    gc_float_call_offsets
  }
  // #2424: the Int render-argument table from the SAME checked program. No
  // uniqueness filter of its own -- the checker already refuses an offset
  // whose typed occurrences disagree, which is the fail-closed condition a
  // consumer keyed on offset needs.
  // #3068: the tag-6 rows (a render argument the checker typed as a shape the
  // runtime renderer cannot print) ride the Int array under a negative key,
  // exactly as on the linear lanes (#2987). This lane used to request only
  // tags 3 and 5, so its `__to_string` lowering never saw a refusal row and
  // printed the argument's address where linear refused the build.
  let (gc_int_only, gc_bool_render_offsets, gc_unrenderable) = checked_int_bool_and_unrenderable_render_offsets(checked)
  let gc_int_render_offsets = merge_unrenderable_render_offsets(gc_int_only, gc_unrenderable)
  compile_wasi_module_gc(stmts, effective_entry, generated_test_artifact, gc_to_string_is_wrapper, direct_abi_generic_names, gc_float_ret_fn_names, unique_gc_float_call_offsets, gc_int_render_offsets, gc_bool_render_offsets)
}

fn compile_source_gc_only_impl(source: String, entry_name: String, trusted_generated: Bool) -> Bytes with Exception {
  gc_merged_offset_space_reset()
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  if !trusted_generated {
    validate_user_source_stmts(stmts)
  } else {
    ()
  }
  compile_stmts_gc_only_impl(stmts, entry_name, false, !trusted_generated)
}

export fn compile_source_gc_only(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_gc_only_impl(source, entry_name, false)
}

export fn compile_generated_source_gc_only(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_gc_only_impl(source, entry_name, true)
}

/// Compile an import-resolved, compiler-generated statement graph without a
/// source round trip. Module merging may use internal identifier spellings
/// that are valid in the AST but deliberately not accepted by the user lexer.
export fn compile_generated_stmts_gc_only(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_stmts_gc_only_impl(stmts, entry_name, true, false)
}
