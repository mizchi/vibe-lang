//# Functions

// #683: test/bench-block lowering for the gc lane, mirroring the linear
// backend's in-codegen rewrite (codegen/wasi/linked_compile.vibe): each
// `test "name" { body }` becomes `let __test_name = () -> { body; 0 }`,
// and when the requested entry does not exist (the `vibe test` sentinel
// path) a `_start` running every test/bench function in order is
// synthesized at the AST level. Returns the effective entry name. This is
// what lets `VIBE_TEST_BACKEND=gc bash scripts/vibe_test.sh file` run a
// *_test.vibe on the wasm-gc backend under wasmtime.
fn lower_test_blocks_gc(stmts: Array[Stmt], entry_name: String) -> String with { Error } {
  let empty_tp = Array::slice([
    ""
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let empty_params = Array::slice([
    ("", None)
  ], 0, 0)
  let test_fn_names = Array::slice([
    ""
  ], 0, 0)
  let mut has_entry = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(_, _, name, _, _) => if name == entry_name {
        has_entry = true
      },
      _ => ()
    }
    i = i + 1
  }
  if has_entry || Array::length(test_fn_names) == 0 {
    entry_name
  } else {
    // Synthesize `_start` calling each test/bench fn in declaration order.
    let mut body = EInt(0)
    let mut ti = Array::length(test_fn_names) - 1
    while ti >= 0 {
      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), Array::slice([
        EUnit
      ], 0, 0), 0 - 1), body)
      ti = ti - 1
    }
    Array::push(stmts, SLet(true, false, "_start", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))
    "_start"
  }
}

// #538 P4.5: the SAME source pipeline as compile_source_wasi_only — interp
// expansion, check, trait-dict desugar, generic-param strip — in front of the
// gc backend. The trait-dict desugar is what expands `a == b` on enum/struct
// operands into the derived structural Eq walk (and Show's Int::to_string
// etc.); without it the gc lane compared ctor POINTERS, so the gc-compiled
// checker's Option/effect-row comparisons were silently wrong.
export fn compile_source_gc_only(source: String, entry_name: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  // #683: lower test/bench blocks BEFORE the check so the synthesized
  // `__test_*` lets and the no-entry `_start` runner are type-checked like
  // ordinary functions (the linear lane checks STest bodies directly and
  // rewrites inside codegen; pre-check rewriting is equivalent here).
  let effective_entry = lower_test_blocks_gc(stmts, entry_name)
  let _ = check_program(stmts)
  // Same effective order as the linear lane: strip source-level generic
  // params, then the trait-dict desugar (compile_wasi_module_linked_impl
  // runs it as its first step).
  strip_generic_type_params(stmts)
  desugar_trait_dicts(stmts)
  compile_wasi_module_gc(stmts, effective_entry)
}
