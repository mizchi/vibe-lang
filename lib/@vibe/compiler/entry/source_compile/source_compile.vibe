//# Imports

import @vibe/compiler/syntax {
  lex, lex_with_offsets, parse_program, parse_program_located
}
import @vibe/compiler/checker {
  check_program, check_program_double_call_result_located_observation, checked_int_render_offsets, validate_user_source_stmts
}

import @vibe/compiler/codegen {
  compile_module_with_typed_offsets
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_impl, compile_wasi_module_no_dce_impl
}

import @vibe/compiler/core {
  Stmt, dce_stmts
}

//# Functions

/// #2437: a LOCATED lex+parse, and the check that already ran here now runs as
/// the typed-lowering observation instead. `parse_program(lex(source))` leaves
/// every node offset at -1, so both offset-keyed tables were empty BY
/// CONSTRUCTION on this entry -- the channel was wired up and permanently
/// inert. The observation is the same `check_program` with the two tables
/// harvested from the CheckedProgram it already builds, so nothing new is
/// checked; `None` is it refusing an unlocated AST, and empty tables classify
/// nothing.
export fn compile_source(source: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  validate_user_source_stmts(stmts)
  let (float_call_offsets, int_render_offsets) = module_typed_offsets(stmts)
  compile_module_with_typed_offsets(stmts, float_call_offsets, int_render_offsets)
}

/// #2437: the Double call-result table and the Int render / `eq` table from
/// ONE check. `checked_int_render_offsets` is a pure function of the
/// CheckedProgram the observation already returns, so the two cost one check
/// between them.
///
/// `None` is the observation refusing an unlocated AST, and two empty tables
/// are the fail-closed answer: they classify nothing, leaving the syntactic
/// answer in codegen exactly as it was.
fn module_typed_offsets(stmts: Array[Stmt]) -> (Array[Int], Array[Int]) with Exception {
  match check_program_double_call_result_located_observation(stmts) {
    Some((checked, offsets)) => (offsets, checked_int_render_offsets(checked)),
    None => ([], [])
  }
}

export fn compile_source_wasi(source: String, entry_name: String) -> Bytes with Exception {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  validate_user_source_stmts(stmts)
  let _ = check_program(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

export fn compile_source_wasi_mode(source: String, entry_name: String, mode: String) -> Bytes with Exception {
  if mode == "mvp" {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    validate_user_source_stmts(stmts)
    let _ = check_program(stmts)
    let pruned_stmts = dce_stmts(stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    validate_user_source_stmts(stmts)
    let _ = check_program(stmts)
    compile_wasi_module_no_dce_impl(stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}
