//# Imports

import @vibe/compiler/syntax {
  lex, parse_program
}
import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/codegen {
  compile_module
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_impl
}

import @vibe/compiler/core {
  dce_stmts
}

//# Functions

export fn compile_source(source: String) -> Bytes with Error {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_module(stmts)
}

export fn compile_source_wasi(source: String, entry_name: String) -> Bytes with Error {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

export fn compile_source_wasi_mode(source: String, entry_name: String, mode: String) -> Bytes with Error {
  if mode == "mvp" {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _ = check_program(stmts)
    let pruned_stmts = dce_stmts(stmts, [
      entry_name
    ])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_source_wasi(source, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}
