import ./component_codegen.vibe {
  comp_emit_wasi_cli_stdin_import_surface_for_test
}

fn first_component_byte_mismatch(actual: Bytes, expected: Array[Int]) -> String {
  let actual_len = Bytes::length(actual)
  let expected_len = Array::length(expected)
  if actual_len != expected_len {
    String::concat("length mismatch: actual=", String::concat(Int::to_string(actual_len), String::concat(" expected=", Int::to_string(expected_len))))
  } else {
    let mut i = 0
    let mut mismatch = ""
    while (i < expected_len) && (mismatch == "") {
      let actual_byte = Bytes::get(actual, i)
      let expected_byte = Array::get(expected, i)
      if actual_byte != expected_byte {
        mismatch = String::concat("byte mismatch at index ", String::concat(Int::to_string(i), String::concat(": actual=", String::concat(Int::to_string(actual_byte), String::concat(" expected=", Int::to_string(expected_byte))))))
      }
      i = i + 1
    }
    mismatch
  }
}

