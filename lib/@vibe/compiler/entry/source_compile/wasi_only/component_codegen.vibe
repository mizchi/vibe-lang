/// ADR-0089 step 2: component valtype u8 (0x7d) -- the element type of
/// `ByteStream` = `stream<u8>` (docs/spec/wasi-p3-async.md §4).
let comp_valtype_u8 = 125

/// ADR-0089 step 2: component type section defining `(stream <T>)`.
/// Byte shape from wasm-tools dump of stream_value/component.wat:
/// defvaltype stream = 0x66 (102), then option tag 0x01 + the element's
/// component valtype -- same layout as the future type, one opcode apart.
fn emit_comp_stream_type_section(buf: Bytes, elem_valtype: Int) -> Unit {
  bytebuf_push(buf, section_type)
