//# Functions

fn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {
  let mut value = 0
  let mut shift = 0
  let mut i = start
  let len = Bytes::length(bytes)
  let mut done = false
  while (i < len) && (done == false) {
    let b = Bytes::get(bytes, i)
    value = value|((b&127)<<shift)
    i = i + 1
    if (b&128) == 0 {
      done = true
    } else {
      shift = shift + 7
    }
  }
  (value, i)
}

let section_type = 7

let core_sort_mem = 2

fn new_int_array() -> Array[Int] {
  array_empty()
}

let section_alias = 6

let section_canon = 8

let core_sort_func = 0

fn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {
  read_uleb(bytes, start)
}

fn skip_name(bytes: Bytes, start: Int) -> Int {
  let (name_len, after_len) = read_name_info(bytes, start)
  after_len + name_len
}

let section_export = 11

let section_import = 10

let section_module = 1

fn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {
  let mut j = sec_start
  let (type_count, next_j) = read_uleb(bytes, j)
  j = next_j
  let mut t = 0
  while t < type_count {
    if j >= sec_end {
      t = type_count
    }
    else {
      let form = Bytes::get(bytes, j)
      j = j + 1
      if form != 96 {
        t = type_count
      }
      else {
        let sig = new_int_array()
        let (param_count, next_j2) = read_uleb(bytes, j)
        j = next_j2
        Array::push(sig, param_count)
        let mut p = 0
        while p < param_count {
          if j >= sec_end {
            p = param_count
          }
          else {
            Array::push(sig, Bytes::get(bytes, j))
            j = j + 1
            p = p + 1
          }
        }
        let (result_count, next_j3) = read_uleb(bytes, j)
        j = next_j3
        Array::push(sig, result_count)
        let mut rv = 0
        while rv < result_count {
          if j >= sec_end {
            rv = result_count
          }
          else {
            Array::push(sig, Bytes::get(bytes, j))
            j = j + 1
            rv = rv + 1
          }
        }
        Array::push(out_sigs, sig)
        t = t + 1
      }
    }
  }
}

let comp_extern_func = 1

let comp_valtype_f32 = 118

let comp_valtype_f64 = 117

let comp_valtype_s32 = 122

let comp_valtype_s64 = 120

fn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {
  leb128_encode_u32(buf, Bytes::length(content))
  bytebuf_push_buf(buf, content)
}

fn read_name_string(bytes: Bytes, start: Int) -> String {
  let (name_len, after_len) = read_name_info(bytes, start)
  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on
  // the name length (which can be hundreds of chars for mangled
  // identifiers).
  let buf = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

fn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {
  let mut i = start
  if i >= end_pos {
    end_pos
  }
  else {
    let flags = Bytes::get(bytes, i)
    i = i + 1
    let (min_limit, next_i1) = read_uleb(bytes, i)
    let _ = min_limit
    i = next_i1
    if (flags&1) != 0 {
      let (max_limit, next_i2) = read_uleb(bytes, i)
      let _ = max_limit
      i = next_i2
    }
    if (flags&4) != 0 {
      let (page_size, next_i3) = read_uleb(bytes, i)
      let _ = page_size
      i = next_i3
    }
    if i > end_pos {
      end_pos
    } else {
      i
    }
  }
}

let component_magic_0 = 0

let component_magic_1 = 97

let component_magic_2 = 115

let component_magic_3 = 109

fn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {
  let count = Array::length(names)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_alias)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 0)
      bytebuf_push(content, Array::get(sorts, i))
      bytebuf_push(content, 1)
      leb128_encode_u32(content, core_instance_idx)
      emit_name(content, Array::get(names, i))
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

let comp_valtype_string = 115

let component_version_0 = 13

let component_version_1 = 0

let component_version_2 = 1

let component_version_3 = 0

fn core_to_comp_valtype(v: Int) -> Int {
  if v == 127 {
    comp_valtype_s32
  }
  else {
    if v == 126 {
      comp_valtype_s64
    }
    else {
      if v == 125 {
        comp_valtype_f32
      }
      else {
        if v == 124 {
          comp_valtype_f64
        }
        else {
          0 - 1
        }
      }
    }
  }
}

fn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, core_func_idx)
  if need_string != 0 {
    leb128_encode_u32(content, 3)
    bytebuf_push(content, 0)
    bytebuf_push(content, 3)
    leb128_encode_u32(content, memory_idx)
    bytebuf_push(content, 4)
    leb128_encode_u32(content, realloc_idx)
  } else {
    leb128_encode_u32(content, 0)
  }
  leb128_encode_u32(content, type_idx)
}

fn emit_component_header(buf: Bytes) -> Unit {
  bytebuf_push(buf, component_magic_0)
  bytebuf_push(buf, component_magic_1)
  bytebuf_push(buf, component_magic_2)
  bytebuf_push(buf, component_magic_3)
  bytebuf_push(buf, component_version_0)
  bytebuf_push(buf, component_version_1)
  bytebuf_push(buf, component_version_2)
  bytebuf_push(buf, component_version_3)
}

let section_core_instance = 2

fn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {
  let mut i = start
  if kind == 1 {
    if i < end_pos {
      i = i + 1
    }
    i = skip_wasm_limits(bytes, i, end_pos)
  } else {
    if kind == 2 {
      i = skip_wasm_limits(bytes, i, end_pos)
    } else {
      if kind == 3 {
        if (i + 2) <= end_pos {
          i = i + 2
        } else {
          i = end_pos
        }
      } else {
        if kind == 4 {
          if i < end_pos {
            i = i + 1
          }
          let (type_idx, next_i) = read_uleb(bytes, i)
          let _ = type_idx
          i = next_i
        } else {
          i = end_pos
        }
      }
    }
  }
  if i > end_pos {
    end_pos
  } else {
    i
  }
}

fn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let type_sigs = array_empty()
    let func_type_indices = new_int_array()
    let mut import_func_count = 0
    let mut i = 8
    let mut export_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(core_wasm, i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(core_wasm, i, sec_end, type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(core_wasm, j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                j = skip_name(core_wasm, j)
                j = skip_name(core_wasm, j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(core_wasm, j)
                    let _ = type_idx
                    j = next_j2
                    import_func_count = import_func_count + 1
                  } else {
                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          } else {
            if sec_id == 3 {
              let mut j = i
              let (func_count, next_j) = read_uleb(core_wasm, j)
              j = next_j
              let mut f = 0
              while f < func_count {
                if j >= sec_end {
                  f = func_count
                }
                else {
                  let (type_idx, next_j2) = read_uleb(core_wasm, j)
                  Array::push(func_type_indices, type_idx)
                  j = next_j2
                  f = f + 1
                }
              }
            } else {
              if sec_id == 7 {
                let mut j = i
                let (exp_count, next_j) = read_uleb(core_wasm, j)
                j = next_j
                let mut e = 0
                while e < exp_count {
                  if j >= sec_end {
                    e = exp_count
                  }
                  else {
                    let name = read_name_string(core_wasm, j)
                    j = skip_name(core_wasm, j)
                    if j >= sec_end {
                      e = exp_count
                    }
                    else {
                      let kind = Bytes::get(core_wasm, j)
                      j = j + 1
                      let (index, next_j2) = read_uleb(core_wasm, j)
                      j = next_j2
                      if kind == 0 {
                        let type_idx = if index < import_func_count {
                          0 - 1
                        }
                        else {
                          let local_idx = index - import_func_count
                          if local_idx < Array::length(func_type_indices) {
                            Array::get(func_type_indices, local_idx)
                          } else {
                            0 - 1
                          }
                        }
                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {
                          Array::push(out_names, name)
                          Array::push(out_func_indices, index)
                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))
                          export_count = export_count + 1
                        }
                      }
                      e = e + 1
                    }
                  }
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    export_count
  }
}

fn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let mut i = 8
    let mut import_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(core_wasm, i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(core_wasm, j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                let mod_name = read_name_string(core_wasm, j)
                j = skip_name(core_wasm, j)
                let fn_name = read_name_string(core_wasm, j)
                j = skip_name(core_wasm, j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(core_wasm, j)
                    j = next_j2
                    Array::push(out_module_names, mod_name)
                    Array::push(out_func_names, fn_name)
                    Array::push(out_type_indices, type_idx)
                    import_count = import_count + 1
                  } else {
                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    import_count
  }
}

fn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {
  let imp_module_names = array_empty()
  let imp_func_names = array_empty()
  let imp_type_indices = new_int_array()
  let type_sigs = array_empty()
  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)
  let seen_keys = array_empty()
  let module_idx_map_keys = array_empty()
  let module_idx_map_vals = new_int_array()
  let mut binding_count = 0
  let mut i = 0
  while i < Array::length(imp_module_names) {
    let mod_name = Array::get(imp_module_names, i)
    let fn_name = Array::get(imp_func_names, i)
    let key = "\{mod_name}||\{fn_name}"
    let mut already = false
    let mut s = 0
    while s < Array::length(seen_keys) {
      if Array::get(seen_keys, s) == key {
        already = true
      }
      s = s + 1
    }
    if already == false {
      Array::push(seen_keys, key)
      let type_idx = Array::get(imp_type_indices, i)
      if type_idx < Array::length(type_sigs) {
        let sig = Array::get(type_sigs, type_idx)
        let param_count = Array::get(sig, 0)
        let result_count_index = 1 + param_count
        let result_count = Array::get(sig, result_count_index)
        let comp_params = new_int_array()
        let mut valid = true
        let mut p = 0
        while p < param_count {
          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_params, cv)
          }
          p = p + 1
        }
        let comp_results = new_int_array()
        let mut r = 0
        while r < result_count {
          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_results, cv)
          }
          r = r + 1
        }
        if valid {
          let mut mod_idx = 0 - 1
          let mut mi = 0
          while mi < Array::length(module_idx_map_keys) {
            if Array::get(module_idx_map_keys, mi) == mod_name {
              mod_idx = Array::get(module_idx_map_vals, mi)
            }
            mi = mi + 1
          }
          if mod_idx < 0 {
            mod_idx = Array::length(out_unique_module_names)
            Array::push(out_unique_module_names, mod_name)
            Array::push(out_module_binding_counts, 0)
            Array::push(module_idx_map_keys, mod_name)
            Array::push(module_idx_map_vals, mod_idx)
          }
          let import_name = "import-\{binding_count}"
          Array::push(out_import_names, import_name)
          Array::push(out_binding_func_names, fn_name)
          Array::push(out_binding_func_indices, binding_count)
          Array::push(out_comp_params, comp_params)
          let empty_names = array_empty()
          Array::push(out_comp_param_names, empty_names)
          Array::push(out_comp_results, comp_results)
          let cur = Array::get(out_module_binding_counts, mod_idx)
          Array::set(out_module_binding_counts, mod_idx, cur + 1)
          binding_count = binding_count + 1
        }
      }
    }
    i = i + 1
  }
  binding_count
}

let comp_inst_arg_instance = 18

fn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)
  emit_raw_content(buf, content)
}

fn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_canon)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 1)
      bytebuf_push(content, 0)
      leb128_encode_u32(content, i)
      leb128_encode_u32(content, 0)
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

fn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_import)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 0)
      emit_name(content, Array::get(import_names, i))
      bytebuf_push(content, comp_extern_func)
      leb128_encode_u32(content, i)
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

fn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {
  bytebuf_push(buf, section_module)
  let wasm_len = Bytes::length(core_wasm)
  leb128_encode_u32(buf, wasm_len)
  bytebuf_push_buf(buf, core_wasm)
}

fn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {
  emit_alias_section(buf, core_instance_idx, [
    "_start",
    "memory"
  ], [
    core_sort_func,
    core_sort_mem
  ])
}

// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the
// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file
// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).
fn comp_underscores_to_dashes(name: String) -> String {
  let len = String::length(name)
  let mut out = ""
  let mut i = 0
  while i < len {
    let c = String::char_code_at(name, i)
    if c == 95 {
      out = String::concat(out, "-")
    } else {
      out = String::concat(out, String::from_char_code(c))
    }
    i = i + 1
  }
  out
}

fn normalize_comp_param_name(name: String) -> String {
  comp_underscores_to_dashes(name)
}

fn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {
  if is_async != 0 {
    bytebuf_push(content, 67)
  } else {
    bytebuf_push(content, 64)
  }
  leb128_encode_u32(content, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    let name = if i < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, i))
    }
    else {
      "p\{i}"
    }
    emit_name(content, name)
    bytebuf_push(content, Array::get(param_types, i))
    i = i + 1
  }
  if Array::length(result_types) == 0 {
    bytebuf_push(content, 1)
    leb128_encode_u32(content, 0)
  } else {
    if Array::length(result_types) == 1 {
      bytebuf_push(content, 0)
      bytebuf_push(content, Array::get(result_types, 0))
    } else {
      bytebuf_push(content, 1)
      leb128_encode_u32(content, Array::length(result_types))
      let mut r = 0
      while r < Array::length(result_types) {
        emit_name(content, "r\{r}")
        bytebuf_push(content, Array::get(result_types, r))
        r = r + 1
      }
    }
  }
}

fn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {
  let count = Array::length(sigs_params)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_type)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

fn emit_comp_type_section_run(buf: Bytes) -> Unit {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  emit_comp_func_type(content, array_empty(), array_empty(), [
    comp_valtype_s64
  ], 0)
  emit_raw_content(buf, content)
}

fn normalize_comp_export_name(name: String) -> String {
  comp_underscores_to_dashes(name)
}

fn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {
  let export_name = normalize_comp_export_name(name)
  bytebuf_push(buf, section_export)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  emit_name(content, export_name)
  bytebuf_push(content, comp_extern_func)
  leb128_encode_u32(content, func_idx)
  leb128_encode_u32(content, 0)
  emit_raw_content(buf, content)
}

export fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {
  let buf = bytebuf_new()
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 97)
  bytebuf_push(buf, 115)
  bytebuf_push(buf, 109)
  bytebuf_push(buf, 1)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  let body = bytebuf_new()
  let type_sec = bytebuf_new()
  leb128_encode_u32(type_sec, if call_run_init != 0 {
    4
  } else {
    3
  })
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count + 1)
  let mut ti = 0
  while ti < string_param_count {
    bytebuf_push(type_sec, 126)
    ti = ti + 1
  }
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  bytebuf_push(type_sec, 96)
  bytebuf_push(type_sec, 4)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count * 2)
  let mut ci = 0
  while ci < (string_param_count * 2) {
    bytebuf_push(type_sec, 127)
    ci = ci + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  if call_run_init != 0 {
    bytebuf_push(type_sec, 96)
    leb128_encode_u32(type_sec, 0)
    bytebuf_push(type_sec, 1)
    bytebuf_push(type_sec, 126)
  }
  bytebuf_push_section(body, 1, type_sec)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(import_sec, "env")
  emit_name(import_sec, "target_func")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "cabi_realloc")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 1)
  if call_run_init != 0 {
    emit_name(import_sec, "env")
    emit_name(import_sec, "run_init")
    bytebuf_push(import_sec, 0)
    leb128_encode_u32(import_sec, 3)
  }
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(body, 2, import_sec)
  let func_sec = bytebuf_new()
  leb128_encode_u32(func_sec, 1)
  leb128_encode_u32(func_sec, 2)
  bytebuf_push_section(body, 3, func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, "canon_func")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, if call_run_init != 0 {
    3
  } else {
    2
  })
  bytebuf_push_section(body, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let func_body = bytebuf_new()
  leb128_encode_u32(func_body, 2)
  leb128_encode_u32(func_body, string_param_count)
  bytebuf_push(func_body, 126)
  leb128_encode_u32(func_body, string_param_count)
  bytebuf_push(func_body, 127)
  if call_run_init != 0 {
    bytebuf_push(func_body, 16)
    leb128_encode_u32(func_body, 2)
    bytebuf_push(func_body, 26)
  }
  let tagged_base = string_param_count * 2
  let obj_base = tagged_base + string_param_count
  let mut si = 0
  while si < string_param_count {
    let ptr_local = si * 2
    let len_local = (si * 2) + 1
    let tagged_local = tagged_base + si
    let obj_local = obj_base + si
    emit_i32_const(func_body, 0)
    emit_i32_const(func_body, 0)
    emit_i32_const(func_body, 4)
    emit_local_get(func_body, len_local)
    emit_i32_const(func_body, 8)
    emit_i32_add(func_body)
    bytebuf_push(func_body, 16)
    leb128_encode_u32(func_body, 1)
    emit_local_set(func_body, obj_local)
    emit_local_get(func_body, obj_local)
    emit_i32_const(func_body, 1)
    emit_i32_store(func_body, 0, 0)
    emit_local_get(func_body, obj_local)
    emit_local_get(func_body, len_local)
    emit_i32_store(func_body, 0, 4)
    emit_local_get(func_body, obj_local)
    emit_i32_const(func_body, 8)
    emit_i32_add(func_body)
    emit_local_get(func_body, ptr_local)
    emit_local_get(func_body, len_local)
    bytebuf_push(func_body, 252)
    leb128_encode_u32(func_body, 10)
    bytebuf_push(func_body, 0)
    bytebuf_push(func_body, 0)
    emit_local_get(func_body, obj_local)
    bytebuf_push(func_body, 173)
    bytebuf_push(func_body, 66)
    leb128_encode_s64(func_body, 1)
    bytebuf_push(func_body, 132)
    emit_local_set(func_body, tagged_local)
    si = si + 1
  }
  let mut ci2 = 0
  while ci2 < string_param_count {
    emit_local_get(func_body, tagged_base + ci2)
    ci2 = ci2 + 1
  }
  emit_i32_const(func_body, 0)
  bytebuf_push(func_body, 16)
  leb128_encode_u32(func_body, 0)
  bytebuf_push(func_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(func_body))
  bytebuf_push_buf(code_sec, func_body)
  bytebuf_push_section(body, 10, code_sec)
  bytebuf_push_buf(buf, body)
  bytebuf_to_bytes(buf)
}

fn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {
  if num_modules == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_core_instance)
    let content = bytebuf_new()
    leb128_encode_u32(content, num_modules)
    let mut offset = 0
    let mut m = 0
    while m < num_modules {
      let count = Array::get(module_binding_counts, m)
      bytebuf_push(content, 1)
      leb128_encode_u32(content, count)
      let mut b = 0
      while b < count {
        emit_name(content, Array::get(binding_func_names, offset + b))
        bytebuf_push(content, core_sort_func)
        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))
        b = b + 1
      }
      offset = offset + count
      m = m + 1
    }
    emit_raw_content(buf, content)
  }
}

fn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, module_index)
  leb128_encode_u32(content, Array::length(module_names))
  let mut i = 0
  while i < Array::length(module_names) {
    emit_name(content, Array::get(module_names, i))
    bytebuf_push(content, comp_inst_arg_instance)
    leb128_encode_u32(content, i)
    i = i + 1
  }
  emit_raw_content(buf, content)
}

export fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_instance_instantiate_section(buf, 0, array_empty())
  emit_alias_run_and_memory(buf, 0)
  bytebuf_to_bytes(buf)
}

export fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {
  let import_names = array_empty()
  let binding_func_names = array_empty()
  let binding_func_indices = new_int_array()
  let unique_module_names = array_empty()
  let module_binding_counts = new_int_array()
  let comp_params = array_empty()
  let comp_param_names = array_empty()
  let comp_results = array_empty()
  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)
  let main_instance_idx = Array::length(unique_module_names)
  let run_core_func_idx = import_func_count
  let run_type_idx = import_func_count
  let run_func_idx = import_func_count
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, 0)
    af = af + 1
  }
  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)
  emit_comp_import_section(buf, import_names, import_func_count)
  emit_canon_lower_section(buf, import_func_count)
  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)
  emit_core_instance_instantiate_section(buf, 0, unique_module_names)
  emit_alias_run_and_memory(buf, main_instance_idx)
  emit_comp_type_section_run(buf)
  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)
  emit_comp_export_section(buf, export_name, run_func_idx)
  bytebuf_to_bytes(buf)
}

export fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {
  let import_names = array_empty()
  let binding_func_names = array_empty()
  let binding_func_indices = new_int_array()
  let unique_module_names = array_empty()
  let module_binding_counts = new_int_array()
  let comp_params = array_empty()
  let comp_param_names = array_empty()
  let comp_results = array_empty()
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut call_run_init = 0
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == "_start" {
      call_run_init = 1
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  let has_distinct_run_alias =
  if (call_run_init != 0) && (target_func_name != "_start") {
    1
  } else {
    0
  }
  let main_instance_idx = Array::length(unique_module_names)
  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, trampoline_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, 0)
    af = af + 1
  }
  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)
  emit_comp_import_section(buf, import_names, import_func_count)
  emit_canon_lower_section(buf, import_func_count)
  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)
  emit_core_instance_instantiate_section(buf, 0, unique_module_names)
  let alias_names = array_empty()
  let alias_sorts = new_int_array()
  Array::push(alias_names, target_func_name)
  Array::push(alias_sorts, core_sort_func)
  Array::push(alias_names, "cabi_realloc")
  Array::push(alias_sorts, core_sort_func)
  if has_distinct_run_alias != 0 {
    Array::push(alias_names, "_start")
    Array::push(alias_sorts, core_sort_func)
  }
  Array::push(alias_names, "memory")
  Array::push(alias_sorts, core_sort_mem)
  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)
  let target_func_core_idx = import_func_count
  let cabi_realloc_core_idx = import_func_count + 1
  let run_init_core_idx =
  if call_run_init != 0 {
    if has_distinct_run_alias != 0 {
      import_func_count + 2
    } else {
      target_func_core_idx
    }
  } else {
    0 - 1
  }
  bytebuf_push(buf, section_core_instance)
  let tramp_env = bytebuf_new()
  leb128_encode_u32(tramp_env, 1)
  bytebuf_push(tramp_env, 1)
  leb128_encode_u32(tramp_env, if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(tramp_env, "target_func")
  bytebuf_push(tramp_env, core_sort_func)
  leb128_encode_u32(tramp_env, target_func_core_idx)
  emit_name(tramp_env, "cabi_realloc")
  bytebuf_push(tramp_env, core_sort_func)
  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)
  if call_run_init != 0 {
    emit_name(tramp_env, "run_init")
    bytebuf_push(tramp_env, core_sort_func)
    leb128_encode_u32(tramp_env, run_init_core_idx)
  }
  emit_name(tramp_env, "memory")
  bytebuf_push(tramp_env, core_sort_mem)
  leb128_encode_u32(tramp_env, 0)
  emit_raw_content(buf, tramp_env)
  let env_instance_idx = main_instance_idx + 1
  bytebuf_push(buf, section_core_instance)
  let tramp_inst = bytebuf_new()
  leb128_encode_u32(tramp_inst, 1)
  bytebuf_push(tramp_inst, 0)
  leb128_encode_u32(tramp_inst, 1)
  leb128_encode_u32(tramp_inst, 1)
  emit_name(tramp_inst, "env")
  bytebuf_push(tramp_inst, comp_inst_arg_instance)
  leb128_encode_u32(tramp_inst, env_instance_idx)
  emit_raw_content(buf, tramp_inst)
  let trampoline_instance_idx = env_instance_idx + 1
  emit_alias_section(buf, trampoline_instance_idx, [
    "canon_func"
  ], [
    core_sort_func
  ])
  let alias_func_count = if has_distinct_run_alias != 0 {
    3
  } else {
    2
  }
  let canon_func_core_idx = import_func_count + alias_func_count
  bytebuf_push(buf, section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(type_content, 1)
  if is_async != 0 {
    bytebuf_push(type_content, 67)
  } else {
    bytebuf_push(type_content, 64)
  }
  leb128_encode_u32(type_content, string_param_count)
  let mut pi = 0
  while pi < string_param_count {
    let pname = if pi < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, pi))
    }
    else {
      "p\{pi}"
    }
    emit_name(type_content, pname)
    bytebuf_push(type_content, comp_valtype_string)
    pi = pi + 1
  }
  bytebuf_push(type_content, 0)
  bytebuf_push(type_content, comp_valtype_s64)
  emit_raw_content(buf, type_content)
  let component_type_idx = import_func_count
  bytebuf_push(buf, section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(canon_content, 1)
  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)
  emit_raw_content(buf, canon_content)
  let lifted_func_idx = import_func_count
  emit_comp_export_section(buf, export_name, lifted_func_idx)
  bytebuf_to_bytes(buf)
}

// WASI 0.3 async (M1b, docs/spec/wasi-p3-async.md §3.2). The `task.return`
// canonical built-in lowers to a core func `(param <result>) -> ()` that
// delivers an async-lifted export's result. Encoding verified byte-for-byte
// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):
// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result
// Some(valtype); empty options).
fn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 9)
  bytebuf_push(content, 0)
  bytebuf_push(content, result_valtype)
  bytebuf_push(content, 0)
  emit_raw_content(buf, content)
}

// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it
// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>
// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).
fn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, core_func_idx)
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 6)
  leb128_encode_u32(content, type_idx)
  emit_raw_content(buf, content)
}

// Component type section with a single async func type `() -> <result>`.
// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;
// 0 params; result-form 0x00 + valtype).
fn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 67)
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  bytebuf_push(content, result_valtype)
  emit_raw_content(buf, content)
}

// Wrap a core module that imports ("cm","task-return") and exports a void `run`
// into an async-lifted component export. Section order mirrors
// cm_async_lift_probe.wat (verified to run on wasmtime 45 with
// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).
// `result_valtype` is the component valtype of the lifted result (e.g.
// comp_valtype_s64 for vibe Int).
export fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_canon_task_return(buf, result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_core_instance_instantiate_section(buf, 0, [
    "cm"
  ])
  emit_comp_async_functype_section(buf, result_valtype)
  emit_alias_section(buf, 1, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 1, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

// Map a component valtype to the core valtype it lowers from (inverse of
// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.
fn comp_valtype_to_core(v: Int) -> Int {
  if v == comp_valtype_s64 {
    126
  }
  else {
    if v == comp_valtype_s32 {
      127
    }
    else {
      if v == comp_valtype_f32 {
        125
      }
      else {
        if v == comp_valtype_f64 {
          124
        }
        else {
          127
        }
      }
    }
  }
}

// M1b-2 (docs/spec/wasi-p3-async.md §3.4). Async trampoline core module: imports
// the normally-compiled entry ("main","run" : () -> <core_valtype>) and
// ("cm","task-return" : (<core_valtype>) -> ()), and exports a void `run` that
// calls the entry and forwards its result to task.return. Byte template verified
// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).
fn comp_generate_async_trampoline(core_valtype: Int) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result
  // (the i64 is the unit argument), so the trampoline passes a dummy i64.
  emit_func_type_raw(tc, [
    126
  ], [
    core_valtype
  ])
  emit_func_type_raw(tc, [
    core_valtype
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 2)
  emit_name(ic, "main")
  emit_name(ic, "run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "cm")
  emit_name(ic, "task-return")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    2
  ])
  emit_export_section(out, "run", 2)
  let body = bytebuf_new()
  emit_i64_const(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 1)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

// Instantiate a core module with explicit (arg-name -> core-instance-index) args.
// Unlike emit_core_instance_instantiate_section, the arg instance indices need
// not be sequential.
fn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, module_index)
  leb128_encode_u32(content, Array::length(arg_names))
  let mut i = 0
  while i < Array::length(arg_names) {
    emit_name(content, Array::get(arg_names, i))
    bytebuf_push(content, comp_inst_arg_instance)
    leb128_encode_u32(content, Array::get(arg_instance_indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}

// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value
// returned directly) into an async-lifted component export via the trampoline
// (two-module) approach — no change to the core module / linked_compile needed.
// `comp_result_valtype` is the component valtype of the lifted result
// (comp_valtype_s64 for vibe Int). Section order mirrors
// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).
export fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  emit_core_instance_instantiate_section(buf, 0, array_empty())
  emit_canon_task_return(buf, comp_result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_alias_section(buf, 0, [
    "run"
  ], [
    core_sort_func
  ])
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "run"
  ], [
    1
  ])
  emit_core_instance_instantiate_args(buf, 1, [
    "main",
    "cm"
  ], [
    2,
    1
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  emit_alias_section(buf, 3, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 2, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module
// (`(i32,i32,i32,i32) -> i32` returning 0). Compiled core modules
// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the
// stub satisfies that import so the async component is self-contained and
// instantiable without an external preview1 adapter.
fn comp_generate_wasi_fd_write_stub() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "fd_write", 0)
  let body = bytebuf_new()
  emit_i32_const(body, 0)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

// Like comp_emit_component_wasm_async_trampolined, but for a main core module
// that imports `wasi_snapshot_preview1.fd_write` (every compiled core does). A
// fd_write stub module is instantiated first and supplied to the main module's
// instantiation, making the async component fully self-contained / runnable.
// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),
// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.
export fn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1"
  ], [
    0
  ])
  emit_canon_task_return(buf, comp_result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_alias_section(buf, 1, [
    "run"
  ], [
    core_sort_func
  ])
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "run"
  ], [
    1
  ])
  emit_core_instance_instantiate_args(buf, 1, [
    "main",
    "cm"
  ], [
    3,
    2
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  emit_alias_section(buf, 4, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 2, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

// #537: core:sort for globals (func=0, table=1, mem=2, global=3).
let core_sort_global = 3

// #537: from-exports core instance with per-item sorts (the older
// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string
// env instance also carries the main memory and the __heap_ptr global).
fn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 1)
  leb128_encode_u32(content, Array::length(names))
  let mut i = 0
  while i < Array::length(names) {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, Array::get(sorts, i))
    leb128_encode_u32(content, Array::get(indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}

// #537: string trampoline for the CURRENT wasi linear backend ABI.
// A vibe string value is the packed i64 `(byte_offset << 32) | byte_len`
// (mode-invariant: identical under bump and RC; see gen_str_len_body /
// gen_str_char_code_at_body). The legacy comp_generate_string_trampoline
// predates this and builds retired-host heap-object strings, so it cannot
// call today's core modules.
//
// Imports (module "env", all supplied from the main core instance):
//   target_func : (i64 x N) -> i64      the exported vibe handler
//   memory      : the main linear memory
//   __heap_ptr  : mut i32 global        the main module's bump frontier
// Exports:
//   cabi_realloc : (i32,i32,i32,i32) -> i32
//     Canonical-ABI allocator used by the host to lower string params into
//     the main memory (and by canon_func for the string-result ret area).
//     Bumps __heap_ptr (align-adjusted) and memory.grows as needed. Fresh
//     allocations only (old_ptr is ignored) — the canonical lowering of
//     bare string params/results never reallocates.
//   canon_func : (i32 x 2N) -> i32
//     Canonical-ABI core shape of `(string x N) -> string`: N (ptr,len)
//     pairs in, retptr out. Packs each pair into a vibe string value, calls
//     target_func, unpacks the returned value into an 8-byte (ptr,len)
//     return area allocated via cabi_realloc.
export fn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_header(buf)
  // types: 0 = target_func (i64 x N) -> i64; 1 = canon_func (i32 x 2N) -> i32;
  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32
  let type_sec = bytebuf_new()
  bytebuf_push_vec_header(type_sec, 3)
  bytebuf_push(type_sec, 96)
  // +1: top-level vibe functions carry a trailing closure-env i64 param
  // (callers pass 0); see linked_compile's entry invocation.
  leb128_encode_u32(type_sec, string_param_count + 1)
  let mut ti = 0
  while ti < (string_param_count + 1) {
    bytebuf_push(type_sec, 126)
    ti = ti + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count * 2)
  let mut ci = 0
  while ci < (string_param_count * 2) {
    bytebuf_push(type_sec, 127)
    ci = ci + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, 4)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push_section(buf, 1, type_sec)
  // imports: env.target_func (func 0), env.__heap_ptr (mut i32 global), env.memory
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 3)
  emit_name(import_sec, "env")
  emit_name(import_sec, "target_func")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "__heap_ptr")
  bytebuf_push(import_sec, 3)
  bytebuf_push(import_sec, 127)
  bytebuf_push(import_sec, 1)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(buf, 2, import_sec)
  // funcs: 1 = canon_func (type 1), 2 = cabi_realloc (type 2)
  let func_sec = bytebuf_new()
  leb128_encode_u32(func_sec, 2)
  leb128_encode_u32(func_sec, 1)
  leb128_encode_u32(func_sec, 2)
  bytebuf_push_section(buf, 3, func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "canon_func")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, "cabi_realloc")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 2)
  bytebuf_push_section(buf, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  // canon_func body. locals: params 0..2N-1 (i32); 2N = result i64; 2N+1 = retptr i32
  let canon_body = bytebuf_new()
  leb128_encode_u32(canon_body, 2)
  leb128_encode_u32(canon_body, 1)
  bytebuf_push(canon_body, 126)
  leb128_encode_u32(canon_body, 1)
  bytebuf_push(canon_body, 127)
  let result_local = string_param_count * 2
  let retptr_local = result_local + 1
  let mut si = 0
  while si < string_param_count {
    // (extend_u(ptr) << 32) | extend_u(len)
    emit_local_get(canon_body, si * 2)
    bytebuf_push(canon_body, 173)
    emit_i64_const(canon_body, 32)
    bytebuf_push(canon_body, 134)
    emit_local_get(canon_body, (si * 2) + 1)
    bytebuf_push(canon_body, 173)
    bytebuf_push(canon_body, 132)
    si = si + 1
  }
  // Trailing closure-env argument (0 for a top-level function).
  emit_i64_const(canon_body, 0)
  bytebuf_push(canon_body, 16)
  leb128_encode_u32(canon_body, 0)
  emit_local_set(canon_body, result_local)
  // retptr = cabi_realloc(0, 0, 4, 8)
  emit_i32_const(canon_body, 0)
  emit_i32_const(canon_body, 0)
  emit_i32_const(canon_body, 4)
  emit_i32_const(canon_body, 8)
  bytebuf_push(canon_body, 16)
  leb128_encode_u32(canon_body, 2)
  emit_local_set(canon_body, retptr_local)
  // [retptr] = wrap(result >> 32); [retptr+4] = wrap(result & 0xFFFFFFFF)
  emit_local_get(canon_body, retptr_local)
  emit_local_get(canon_body, result_local)
  emit_i64_const(canon_body, 32)
  bytebuf_push(canon_body, 136)
  bytebuf_push(canon_body, 167)
  emit_i32_store(canon_body, 2, 0)
  emit_local_get(canon_body, retptr_local)
  emit_local_get(canon_body, result_local)
  bytebuf_push(canon_body, 167)
  emit_i32_store(canon_body, 2, 4)
  emit_local_get(canon_body, retptr_local)
  bytebuf_push(canon_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(canon_body))
  bytebuf_push_buf(code_sec, canon_body)
  // cabi_realloc body. params: 0=old_ptr 1=old_size 2=align 3=new_size;
  // local 4 = aligned ptr.
  let realloc_body = bytebuf_new()
  leb128_encode_u32(realloc_body, 1)
  leb128_encode_u32(realloc_body, 1)
  bytebuf_push(realloc_body, 127)
  // p = (heap + align - 1) & (0 - align)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_local_get(realloc_body, 2)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 1)
  bytebuf_push(realloc_body, 107)
  emit_i32_const(realloc_body, 0)
  emit_local_get(realloc_body, 2)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 113)
  emit_local_set(realloc_body, 4)
  // __heap_ptr = p + new_size
  emit_local_get(realloc_body, 4)
  emit_local_get(realloc_body, 3)
  emit_i32_add(realloc_body)
  bytebuf_push(realloc_body, 36)
  leb128_encode_u32(realloc_body, 0)
  // if (__heap_ptr > memory.size << 16) memory.grow(pages needed)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 116)
  bytebuf_push(realloc_body, 75)
  bytebuf_push(realloc_body, 4)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 65535)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 118)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 26)
  bytebuf_push(realloc_body, 11)
  emit_local_get(realloc_body, 4)
  bytebuf_push(realloc_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(realloc_body))
  bytebuf_push_buf(code_sec, realloc_body)
  bytebuf_push_section(buf, 10, code_sec)
  bytebuf_to_bytes(buf)
}

// #537: wrap a compiled core module into a component exporting
//   <export_name> : func(<param_names>: string, ...) -> string
// via the packed-string trampoline above. This is the replacement
// for the retired host's `--compose-p3` handler-side componentization: the
// result plugs into the P3 HTTP adapter's `import handler: func(method, url,
// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).
//
// The core module must export `target_func_name` with signature
// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and
// `__heap_ptr` (any normal non-library compile does). Host imports
// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are
// rejected: a serve handler must be a pure function of its request params.
export fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {
  let string_param_count = Array::length(param_names)
  // Validate the target export exists with the packed-string core signature.
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut target_sig_ok = false
  let mut target_found = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == target_func_name {
      target_found = true
      let sig = Array::get(export_type_sigs, ei)
      // sig = [param_count, params..., result_count, results...]. Core shape
      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.
      let core_param_count = string_param_count + 1
      if Array::length(sig) == (core_param_count + 3) {
        let mut ok = Array::get(sig, 0) == core_param_count
        let mut pi = 0
        while pi < core_param_count {
          if Array::get(sig, 1 + pi) != 126 {
            ok = false
          }
          pi = pi + 1
        }
        if Array::get(sig, 1 + core_param_count) != 1 {
          ok = false
        }
        if Array::get(sig, 2 + core_param_count) != 126 {
          ok = false
        }
        target_sig_ok = ok
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !target_found {
    throw("component: core module does not export '\{target_func_name}'")
  }
  if !target_sig_ok {
    throw("component: '\{target_func_name}' must take \{string_param_count} String params and return String")
  }
  // Reject host imports the stub cannot satisfy.
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else {
      throw("component: handler uses host import '\{im}.\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)")
    }
    ii = ii + 1
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  // core instance 0: fd_write stub (module 2)
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  // core instance 1: main (module 0), wasi_snapshot_preview1 satisfied by the
  // stub when the core imports it (an argument for an import the module does
  // not declare is legal and ignored).
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1"
  ], [
    0
  ])
  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr
  emit_alias_section(buf, 1, [
    target_func_name
  ], [
    core_sort_func
  ])
  emit_alias_section(buf, 1, [
    "memory"
  ], [
    core_sort_mem
  ])
  emit_alias_section(buf, 1, [
    "__heap_ptr"
  ], [
    core_sort_global
  ])
  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [
    core_sort_func,
    core_sort_global,
    core_sort_mem
  ], [
    0,
    0,
    0
  ])
  // core instance 3: trampoline (module 1) with env
  emit_core_instance_instantiate_args(buf, 1, [
    "env"
  ], [
    2
  ])
  // core func 1 = canon_func, core func 2 = cabi_realloc
  emit_alias_section(buf, 3, [
    "canon_func",
    "cabi_realloc"
  ], [
    core_sort_func,
    core_sort_func
  ])
  // component type 0: (param_names: string...) -> string
  bytebuf_push(buf, section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(type_content, 1)
  let comp_param_types = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_types, comp_valtype_string)
    pt = pt + 1
  }
  emit_comp_func_type(type_content, comp_param_types, param_names, [
    comp_valtype_string
  ], 0)
  emit_raw_content(buf, type_content)
  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)
  bytebuf_push(buf, section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(canon_content, 1)
  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)
  emit_raw_content(buf, canon_content)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}
