}

/// ADR-0089 step 2: component valtype u8 (0x7d) -- the element type of
/// `ByteStream` = `stream<u8>` (docs/spec/wasi-p3-async.md §4).
let comp_valtype_u8 = 125

/// ADR-0089 step 2: component type section defining `(stream <T>)`.
/// Byte shape from wasm-tools dump of stream_value/component.wat:
/// defvaltype stream = 0x66 (102), then option tag 0x01 + the element's
/// component valtype -- same layout as the future type, one opcode apart.
fn emit_comp_stream_type_section(buf: Bytes, elem_valtype: Int) -> Unit {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 102)
  bytebuf_push(content, 1)
  bytebuf_push(content, elem_valtype)
  emit_raw_content(buf, content)
}

/// ADR-0089 step 2: canon stream.new <ty> -- opcode 0x0e (14) + the
/// component type index of the `(stream T)` type. Core signature
/// `[] -> [i64]`, packed exactly like future.new: readable end in the LOW
/// 32 bits, writable in the high.
fn emit_canon_stream_new(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 14)
  leb128_encode_u32(content, type_idx)
  emit_raw_content(buf, content)
}

/// ADR-0089 step 2: canon stream.read <ty> async (memory M) -- opcode 0x0f
/// (15) + type index + 2 canonopts (async, memory). Core signature
/// `[handle, buf_ptr, count] -> [status]` -- one param more than
/// future.read (the element count). With the async canonopt a read with no
/// pending writer returns BLOCKED (0xffffffff) and parks the readable end
/// as a waitable; a completed copy packs `(amount << 4) | code`.
fn emit_canon_stream_read(buf: Bytes, type_idx: Int, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 15)
  leb128_encode_u32(content, type_idx)
  leb128_encode_u32(content, 2)
  bytebuf_push(content, 6)
  bytebuf_push(content, 3)
  leb128_encode_u32(content, memory_core_idx)
  emit_raw_content(buf, content)
}

/// ADR-0089 step 2: canon stream.write <ty> async (memory M) -- opcode 0x10
/// (16), same shape as stream.read. A write against an already-pending
/// read copies min(counts) elements inside the call and returns the packed
/// completed status, not BLOCKED.
fn emit_canon_stream_write(buf: Bytes, type_idx: Int, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 16)
  leb128_encode_u32(content, type_idx)
  leb128_encode_u32(content, 2)
  bytebuf_push(content, 6)
  bytebuf_push(content, 3)
  leb128_encode_u32(content, memory_core_idx)
  emit_raw_content(buf, content)
}

/// ADR-0089 step 2: canon stream.drop-readable <ty> -- opcode 0x13 (19) +
/// type index. Core signature `[handle] -> []`.
fn emit_canon_stream_drop_readable(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 19)
  leb128_encode_u32(content, type_idx)
