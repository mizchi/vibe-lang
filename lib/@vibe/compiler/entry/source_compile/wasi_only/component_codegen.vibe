/// #1230 M1b-3c-1b: standalone memory-hosting core module (mirrors
/// spawned_future/component.wat's `$memhost`) -- exists purely so a
/// concrete memory instance is available to hand to every async canon
/// built-in's `(memory ...)` option (and to the guest module's own memory
/// IMPORT, see comp_generate_spawned_future_guest_core_module) before the
/// guest module itself is instantiated, breaking the "canon options need
/// memory before the guest/memory exists" circularity documented in
/// tools/wasip3_component_probe/stackful/README.md bug #2.
fn comp_generate_memhost_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_memory_section(out, 1)
  emit_export_memory(out, "memory", 0)
  bytebuf_to_bytes(out)
}

/// #1230 M1b-3c-1b: blocking-await guest core module with the wait loop
/// factored into its own function -- a direct translation of
/// tools/wasip3_component_probe/spawned_future/component.wat's `$guest`
/// module. `$writer` performs the async-lowered host call + waitable-set
/// retry loop; `$run` calls it and forwards the result to task.return.
///
/// SCOPE / WHAT THIS DOES AND DOES NOT PROVE (#1240 review). `$writer` is
/// an ORDINARY internal wasm function that `$run` calls synchronously --
/// NOT a second Component-Model task. So this shape only models
/// `spawn(f); await(t)` in the degenerate case where nothing observable
/// happens in the parent between the spawn and the join: the "spawn" is
/// then semantically a no-op and compiles away to a direct call, and the
/// canon set needed is exactly the simpler stackful/ probe's
/// (task.return, async-lowered host import, waitable-set.new/.wait/.drop,
/// waitable.join, subtask.drop) -- which the probe verifies end-to-end
/// against a genuinely blocking host import.
///
/// It does NOT establish that a REAL spawn -- a second guest computation
/// that interleaves with parent work before the join -- needs no extra
/// machinery. It cannot: one stackful fiber runs one call chain, so
/// concurrent guest work requires either another task or a guest-side
/// poll executor. The Phase A probe's evidence points the other way: a
/// genuine `wit_bindgen::spawn_local` pulls in a FuturesUnordered
/// executor plus `context.get/set` and `waitable-set.poll`. Any
/// parent/child handshake, or observable work between spawn and join,
/// would therefore reorder or deadlock under this lowering -- the same
/// limitation the linear backend's eager `Task::spawn` already carries
/// (docs/spec/wasi-p3-async.md §2.5). Real interleaving spawn stays open
/// (M-conc-2 / the M1b-3c-2 follow-up).
///
/// Local func indices: 7 = $writer (type1: () -> i32; performs the
/// async-lowered host call + waitable-set retry loop and returns the
/// resolved value like an ordinary helper function), 8 = $run
/// (type5: () -> (); exported "run"; calls $writer and forwards its result
/// to task.return). Import func indices 0-6 occupy the func index space
/// before them (0=[async-lower]get-async, 1=[waitable-set-new],
/// 2=[waitable-join], 3=[waitable-set-wait], 4=[waitable-set-drop],
/// 5=[subtask-drop], 6=[task-return]run).
fn comp_generate_spawned_future_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 (i32)->(i32) get_async; 1 ()->(i32) ws_new & $writer;
  // 2 (i32,i32)->() waitable_join; 3 (i32,i32)->(i32) ws_wait;
  // 4 (i32)->() ws_drop/subtask_drop/task_return; 5 ()->() $run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 6)
  emit_func_type_raw(tc, [
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  // imports: 7 core funcs (indices 0-6) + memory (module "env", IMPORTED
  // rather than declared/exported -- probe bug #2: every async canon
  // built-in's (memory ...) option must reference the SAME memory instance
  // the guest's own code reads/writes through).
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 8)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower]get-async")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[subtask-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    1,
    5
  ])
  emit_export_section(out, "run", 8)
  // Code section built by hand (not via emit_code_section/
  // emit_code_section_with_locals -- neither supports declaring i32-typed
  // locals): $writer needs 5 i32 locals, matching the string-trampoline
  // functions above's own manual code-section convention.
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  // $writer (func idx 7). locals: 0=packed, 1=code, 2=subtask, 3=ws,
  // 4=event0, 5=has_ws (all i32). Direct translation of component.wat's
  // $writer body. `has_ws` (zero-initialized like every wasm local) records
  // whether the BLOCKED path actually allocated a waitable set, so the
  // epilogue can drop it -- #1240 review: without it every blocking call
  // leaks one canonical waitable-set handle, eventually exhausting the
  // instance's handle space. (The stackful/ probe has the same latent leak;
  // it imports [waitable-set-drop] and never calls it. Harmless there --
  // one-shot probe -- but not in emitted code.)
  let writer_body = bytebuf_new()
  leb128_encode_u32(writer_body, 1)
  leb128_encode_u32(writer_body, 6)
  bytebuf_push(writer_body, 127)
  emit_i32_const(writer_body, 0)
  emit_call(writer_body, 0)
  emit_local_set(writer_body, 0)
  emit_local_get(writer_body, 0)
  emit_i32_const(writer_body, 15)
  emit_i32_and(writer_body)
  emit_local_set(writer_body, 1)
  emit_local_get(writer_body, 0)
  emit_i32_const(writer_body, 4)
  emit_i32_shr_u(writer_body)
  emit_local_set(writer_body, 2)
  emit_block_void(writer_body)
  emit_local_get(writer_body, 1)
  emit_i32_const(writer_body, 2)
  emit_i32_eq(writer_body)
  emit_br_if(writer_body, 0)
  emit_call(writer_body, 1)
  emit_local_set(writer_body, 3)
  emit_i32_const(writer_body, 1)
  emit_local_set(writer_body, 5)
  emit_local_get(writer_body, 2)
  emit_local_get(writer_body, 3)
  emit_call(writer_body, 2)
  emit_loop_void(writer_body)
  emit_local_get(writer_body, 3)
  emit_i32_const(writer_body, 8)
  emit_call(writer_body, 3)
  emit_local_set(writer_body, 4)
  emit_local_get(writer_body, 4)
  emit_i32_const(writer_body, 1)
  emit_i32_eq(writer_body)
  emit_if_void(writer_body)
  emit_i32_const(writer_body, 12)
  emit_i32_load(writer_body, 2, 0)
  emit_local_set(writer_body, 1)
  emit_local_get(writer_body, 1)
  emit_i32_const(writer_body, 2)
  emit_i32_eq(writer_body)
  emit_br_if(writer_body, 2)
  emit_end(writer_body)
  emit_br(writer_body, 0)
  emit_end(writer_body)
  emit_end(writer_body)
  // epilogue: on the BLOCKED path only, drop the subtask FIRST and then the
  // waitable set; then load the host's result from the results area.
  //
  // Both drops are guarded by the same flag (local 5) because both resources
  // come into existence together, in the same straight-line blocked-path
  // sequence: an async-lowered call that completes EAGERLY (status RETURNED
  // straight out of the call, the `br_if $done` above) creates NO subtask --
  // the handle bits of the packed result are 0 -- and allocates no waitable
  // set. #1230 M1b-3c-2: dropping unconditionally therefore traps with
  // "unknown handle index 0" the moment a host import resolves without
  // suspending, which is an entirely ordinary thing for a real host to do
  // (a cached value, a zero timeout, a socket read whose data already
  // arrived). Found live by driving this component through runtime/viberun
  // with a zero-delay host import; the probe's own host always slept 300ms,
  // so it only ever exercised the blocked path.
  //
  // Order matters within the guard: the subtask was `waitable.join`ed into
  // the set, so dropping the set while it still holds the subtask traps with
  // "resource has children" (observed live on wasmtime 47).
  emit_local_get(writer_body, 5)
  emit_if_void(writer_body)
  emit_local_get(writer_body, 2)
  emit_call(writer_body, 5)
  emit_local_get(writer_body, 3)
  emit_call(writer_body, 4)
  emit_end(writer_body)
  emit_i32_const(writer_body, 0)
  emit_i32_load(writer_body, 2, 0)
  bytebuf_push(writer_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(writer_body))
  bytebuf_push_buf(code_sec, writer_body)
  // $run (func idx 8): call $writer, forward its result to task_return.
  let run_body = bytebuf_new()
  leb128_encode_u32(run_body, 0)
  emit_call(run_body, 7)
  emit_call(run_body, 6)
  bytebuf_push(run_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(run_body))
  bytebuf_push_buf(code_sec, run_body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// #1230 M1b-3c-3: guest core module for "two host operations genuinely in
/// flight at the same time" -- a byte-level port of
/// tools/wasip3_component_probe/concurrent_awaits/component.wat.
///
/// Same imports, same types, same canon set as the spawned-future module
/// above; only $both's body differs. That is the finding this milestone
/// records: real concurrency needs NO canon built-in beyond the ones
/// M1b-3c-1b already proved. What produces it is purely the ORDER of
/// operations -- issue both async-lowered calls BEFORE waiting on either.
/// A "start A, wait A, start B, wait B" body emits the identical
/// instructions and returns the identical value, and takes twice as long.
///
/// Note this is NOT M1b-3c-1c ("interleaving spawn"). Here one guest
/// computation waits on several host operations, which a waitable set with
/// several joined subtasks expresses directly. Two concurrent GUEST
/// computations still need a second task or a guest-side poll executor and
/// remain open.
///
/// Memory layout (the shared memhost page):
///    0  result slot for call A       16  waitable-set.wait payload[0]
///    4  result slot for call B            = which waitable fired
///                                    20  payload[1] = its status code
///
/// $both's locals (all i32): 0=packed_a 1=packed_b 2=code_a 3=code_b
/// 4=sub_a 5=sub_b 6=ws 7=pending 8=event0 9=handle 10=status 11=has_ws.
fn comp_generate_concurrent_awaits_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 6)
  emit_func_type_raw(tc, [
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 8)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower]get-async")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[subtask-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    1,
    5
  ])
  emit_export_section(out, "run", 8)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  let b = bytebuf_new()
  leb128_encode_u32(b, 1)
  leb128_encode_u32(b, 12)
  bytebuf_push(b, 127)
  // --- start BOTH calls before waiting on either ---------------------------
  emit_i32_const(b, 0)
  emit_call(b, 0)
  emit_local_set(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 15)
  emit_i32_and(b)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i32_const(b, 4)
  emit_i32_shr_u(b)
  emit_local_set(b, 4)
  emit_i32_const(b, 4)
  emit_call(b, 0)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_i32_const(b, 15)
  emit_i32_and(b)
  emit_local_set(b, 3)
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_shr_u(b)
  emit_local_set(b, 5)
  // --- count how many actually blocked -------------------------------------
  // A call that completed eagerly (status RETURNED, code 2) created no
  // subtask, so it is neither joined nor dropped -- the eager path the
  // spawned-future shape got wrong before M1b-3c-2.
  emit_i32_const(b, 0)
  emit_local_set(b, 7)
  emit_local_get(b, 2)
  emit_i32_const(b, 2)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 7)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_end(b)
  emit_local_get(b, 3)
  emit_i32_const(b, 2)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 7)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_end(b)
  // --- join the pending ones into one set and drain it ---------------------
  emit_local_get(b, 7)
  emit_i32_const(b, 0)
  emit_i32_gt_u(b)
  emit_if_void(b)
  emit_call(b, 1)
  emit_local_set(b, 6)
  emit_i32_const(b, 1)
  emit_local_set(b, 11)
  emit_local_get(b, 2)
  emit_i32_const(b, 2)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 6)
  emit_call(b, 2)
  emit_end(b)
  emit_local_get(b, 3)
  emit_i32_const(b, 2)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 5)
  emit_local_get(b, 6)
  emit_call(b, 2)
  emit_end(b)
  // One wait loop retires BOTH subtasks. payload[0] (addr 16) names the
  // waitable that fired, so either completion order works.
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 6)
  emit_i32_const(b, 16)
  emit_call(b, 3)
  emit_local_set(b, 8)
  emit_local_get(b, 8)
  emit_i32_const(b, 1)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_i32_const(b, 16)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 9)
  emit_i32_const(b, 20)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 10)
  emit_local_get(b, 10)
  emit_i32_const(b, 2)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 9)
  emit_call(b, 5)
  emit_local_get(b, 7)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 7)
  emit_local_get(b, 7)
  emit_i32_eqz(b)
  // depth 3 = the enclosing `block`: 0 = this if(status==2),
  // 1 = if(event0==1), 2 = loop, 3 = block. (The spawned-future module's
  // equivalent branch is depth 2 because it has one fewer nested if.)
  emit_br_if(b, 3)
  emit_end(b)
  emit_end(b)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 6)
  emit_call(b, 4)
  emit_end(b)
  // --- both results are in memory now; return their sum --------------------
  emit_i32_const(b, 0)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_load(b, 2, 0)
  emit_i32_add(b)
  bytebuf_push(b, 11)
  leb128_encode_u32(code_sec, Bytes::length(b))
  bytebuf_push_buf(code_sec, b)
  let run_body = bytebuf_new()
  leb128_encode_u32(run_body, 0)
  emit_call(run_body, 7)
  emit_call(run_body, 6)
  bytebuf_push(run_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(run_body))
  bytebuf_push_buf(code_sec, run_body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// #1230 M1b-3c-1b: wrap the fixed-shape blocking-await guest module
/// (above) into a fully self-contained async component -- a byte-exact port
/// of tools/wasip3_component_probe/spawned_future/component.wat, verified
/// via `wasm-tools dump`/`wasm-tools validate` and the probe's Rust host
/// driver (genuinely non-ready wait, resolves to the host import's value).
/// Unlike comp_emit_component_wasm_async_trampolined_p1 this does not wrap
/// an arbitrary compiled `.vibe` core module -- it is the M1b-1-shaped half
/// of this milestone (emitter, byte-exact verified), not the M1b-2c-shaped
/// half (wiring into real `.vibe` source), which is left to a follow-up
/// once vibe-source-level spawn/future syntax exists. See the guest
/// module's own doc comment for what the "spawn" framing does and does NOT
/// cover -- notably, real interleaving spawn is still open.
/// `comp_result_valtype` must be comp_valtype_u32 (the probe-verified
/// shape); anything else throws, see the guard in the body.
///
/// Core instance indices (in emission order): 0=memhost, 1=root ($root
/// bindings), 2=export-root ([export]$root binding), 3=env (memory
/// binding), 4=guest. Core func indices: 0=lower(get-async),
/// 1=task-return, 2=waitable-set.new, 3=waitable.join, 4=waitable-set.wait,
/// 5=waitable-set.drop, 6=subtask.drop, 7=alias(guest-inst, "run"). Core
/// memory alias index: 0 (memhost's "memory" export, reused for every
/// canon (memory ...) option and for the "env" instantiation arg). Component
/// func indices: 0=the "get-async" import, 1=the lifted "run" export.
/// Component type indices: 0=the import's async functype, 1=the export's.
/// #1230 M1b-3c-3: the composition shared by the two fixed-shape
/// self-contained async components (spawned-future and concurrent-awaits).
/// They differ ONLY in the guest core module -- same imports, same canon
/// set, same instance/index layout -- so the wrapper lives here once and
/// each public emitter supplies its own guest bytes plus a `shape` label
/// for the diagnostic.
fn comp_emit_self_contained_async_component(export_name: String, comp_result_valtype: Int, guest_module: Bytes, shape: String) -> Bytes with { Error } {
  // #1240 review: the guest core modules are hard-coded to an i32-shaped
  // result (an `(i32) -> ()` [task-return] import, an i32-returning body,
  // and `i32.load` of the results area), so a caller asking for any other
  // lowering -- notably the project's ordinary `Int` = s64 -- would get a
  // component whose task.return canon disagrees with the guest's own import
  // type and fail validation. Reject that up front rather than emit an
  // invalid component. Parameterizing the guest core types off
  // comp_result_valtype is possible but unverified, so it waits for a real
  // caller (the M1b-2c-shaped follow-up) to pin it against a probe.
  if comp_result_valtype != comp_valtype_u32 {
    throw("component(\{shape}): only comp_valtype_u32 (\{comp_valtype_u32}) is supported, got \{comp_result_valtype} -- the guest core module is hard-coded to an i32-shaped result")
  }
  else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_comp_async_functype_section(buf, comp_result_valtype)
  emit_comp_import_section(buf, [
    "get-async"
  ], 1)
  emit_core_module_section(buf, guest_module)
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, [
    "memory"
  ], [
    core_sort_mem
  ])
  emit_canon_lower_async_section(buf, 0, mem_alias_idx)
  emit_canon_task_return(buf, comp_result_valtype)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  emit_canon_subtask_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [
    6
  ], [
    "[async-lower]get-async",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]",
    "[subtask-drop]"
  ], [
    0,
    2,
    3,
    4,
    5,
    6
  ])
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "[task-return]run"
  ], [
    1
  ])
  emit_core_instance_from_exports_sorted(buf, [
    "memory"
  ], [
    core_sort_mem
  ], [
    mem_alias_idx
  ])
  let env_inst = 3
  let guest_inst = 4
  emit_core_instance_instantiate_args(buf, 0, [
    "$root",
    "[export]$root",
    "env"
  ], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  let run_func_alias_idx = 7
  emit_alias_section(buf, guest_inst, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, run_func_alias_idx, 1)
  emit_comp_export_section(buf, export_name, 1)
  bytebuf_to_bytes(buf)
}

export fn comp_emit_component_wasm_async_spawned_future(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {
  comp_emit_self_contained_async_component(export_name, comp_result_valtype, comp_generate_spawned_future_guest_core_module(), "spawned-future")
}

/// #1230 M1b-3c-3: the same self-contained component shape, but with the
/// guest that starts BOTH host calls before waiting on either -- so the two
/// host operations are genuinely in flight at the same time.
///
/// The emitted component imports and exports exactly what the
/// spawned-future one does; the entire difference is the order of
/// operations inside the guest. Verified against
/// tools/wasip3_component_probe/concurrent_awaits/component.wat and, at
/// runtime, by scripts/test_concurrent_awaits_component_gate.sh: with a
/// host that suspends 300ms per call, `run` returns 84 (= 42 + 42, so both
/// calls really completed and each result slot was really written) in
/// ~300ms rather than ~600ms.
///
/// `comp_result_valtype` must be comp_valtype_u32; anything else throws.
export fn comp_emit_component_wasm_async_concurrent_awaits(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {
  comp_emit_self_contained_async_component(export_name, comp_result_valtype, comp_generate_concurrent_awaits_guest_core_module(), "concurrent-awaits")
}

/// ADR-0089 step 2 (#1218): guest core module for the SELF-CONTAINED
/// future<u32> value round-trip -- a byte-level port of
/// tools/wasip3_component_probe/future_value/component.wat's $guest. One
/// task, no host import, no subtask:
///
///   1. future.new -> packed i64, readable end in the low 32 bits
///   2. async future.read on the readable end -> BLOCKED (no writer yet)
///   3. waitable.join(readable, ws)
///   4. async future.write of 42 -> completes EAGERLY (a read is pending,
///      so the runtime performs the copy inside the write call)
///   5. waitable-set.wait -> FUTURE_READ (event code 4) on the readable end
///   6. load the value from the read buffer, drop both ends then the set,
///      task.return it
///
/// This is the rendezvous the M2c-3 stream spike could not reach with
/// BLOCKING reads (docs/spec/wasi-p3-async.md §3.3 "self round-trip
/// deadlocks"): with the `async` canonopt on both copies, one side parks
/// as a waitable instead of parking the fiber, so a single task completes
/// the exchange with itself.
///
/// Memory layout (shared memhost page): 0 = read buffer (the u32 landing
/// slot), 4 = write buffer (pre-loaded with 42), 16 = waitable-set.wait
/// payload area. Unexpected statuses are reported through task.return
/// rather than traps, with distinctive values -- 1000 + low result bits
/// (read did not block), 2015 (write came back BLOCKED), 3000 + event
/// code (wait delivered something other than FUTURE_READ).
///
/// Import func indices 0-9, local func 10 = `run` (exported):
/// 0=[future-new-0]make, 1=[async-lower][future-read-0]make,
/// 2=[async-lower][future-write-0]make, 3=[future-drop-readable-0]make,
/// 4=[future-drop-writable-0]make, 5=[waitable-set-new],
/// 6=[waitable-join], 7=[waitable-set-wait], 8=[waitable-set-drop],
/// 9=[task-return]run. The future.* import names follow the wit-bindgen
/// convention the future_value probe captured ([future-<op>-N]<func>) for
/// documentation value only -- this emitter authors both sides of the
/// instantiation, so the strings just have to agree with the composer's.
fn comp_generate_future_value_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 ()->(i64) future.new; 1 (i32,i32)->(i32) future.read/write &
  // ws_wait; 2 (i32)->() drops & task_return; 3 ()->(i32) ws_new;
  // 4 (i32,i32)->() waitable_join; 5 ()->() run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 6)
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  // imports: 10 core funcs (indices 0-9) + the shared memhost memory
  // (imported, not declared -- every async canon built-in's (memory ...)
  // option must reference the same memory instance the guest reads/writes
  // through; see comp_generate_spawned_future_guest_core_module).
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 11)
  emit_name(ic, "$root")
  emit_name(ic, "[future-new-0]make")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][future-read-0]make")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][future-write-0]make")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[future-drop-readable-0]make")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[future-drop-writable-0]make")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    5
  ])
  emit_export_section(out, "run", 10)
  // Code section built by hand (same convention as the spawned-future
  // guest: the shared emit_code_section helpers cannot declare typed
  // locals). run's locals: 0=packed (the only i64), 1=readable, 2=writable,
  // 3=st, 4=ws, 5=ev.
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let body = bytebuf_new()
  leb128_encode_u32(body, 2)
  leb128_encode_u32(body, 1)
  bytebuf_push(body, 126)
  leb128_encode_u32(body, 5)
  bytebuf_push(body, 127)
  // packed = future.new(); readable = low 32 bits, writable = high 32.
  emit_call(body, 0)
  emit_local_set(body, 0)
  emit_local_get(body, 0)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 1)
  emit_local_get(body, 0)
  emit_i64_const(body, 32)
  emit_i64_shr_s(body)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 2)
  // stage the value to send: mem[4] = 42
  emit_i32_const(body, 4)
  emit_i32_const(body, 42)
  emit_i32_store(body, 2, 0)
  // st = future.read(readable, 0) -- must block (no writer yet)
  emit_local_get(body, 1)
  emit_i32_const(body, 0)
  emit_call(body, 1)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 1000)
  emit_local_get(body, 3)
  emit_i32_const(body, 15)
  emit_i32_and(body)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // register the pending read's waitable before writing
  emit_call(body, 5)
  emit_local_set(body, 4)
  emit_local_get(body, 1)
  emit_local_get(body, 4)
  emit_call(body, 6)
  // st = future.write(writable, 4) -- a read is pending, so the copy
  // happens inside this call; anything except BLOCKED is acceptable
  emit_local_get(body, 2)
  emit_i32_const(body, 4)
  emit_call(body, 2)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_eq(body)
  emit_if_void(body)
  emit_i32_const(body, 2015)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // collect the pending read's completion event (FUTURE_READ = 4)
  emit_local_get(body, 4)
  emit_i32_const(body, 16)
  emit_call(body, 7)
  emit_local_set(body, 5)
  emit_local_get(body, 5)
  emit_i32_const(body, 4)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 3000)
  emit_local_get(body, 5)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // teardown: drop the ends BEFORE the set (the readable end is a member
  // of the set; dropping a set that still has members traps with
  // "resource has children" -- same ordering rule the spawned-future
  // epilogue pinned for subtask.drop vs waitable-set.drop), then return
  // the value that landed in the read buffer.
  emit_local_get(body, 1)
  emit_call(body, 3)
  emit_local_get(body, 2)
  emit_call(body, 4)
  emit_local_get(body, 4)
  emit_call(body, 8)
  emit_i32_const(body, 0)
  emit_i32_load(body, 2, 0)
  emit_call(body, 9)
  bytebuf_push(body, 11)
  leb128_encode_u32(code_sec, Bytes::length(body))
  bytebuf_push_buf(code_sec, body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// ADR-0089 step 2 (#1218): fixed-shape component exercising the literal
/// `future.*` canonical built-ins end to end -- the canon family the
/// future_value probe measured by name (step 1) and this milestone makes
/// the compiler able to EMIT. Self-contained: no component import at all
/// (unlike the spawned-future/concurrent-awaits shapes, whose canon lower
/// needs a host async import), so it runs under plain
/// `wasmtime --invoke run()` with
/// `-W component-model-more-async-builtins=y` (still feature-gated in
/// wasmtime 47; the other async flags alone reject the future.* canons).
///
/// Byte shapes verified via `wasm-tools dump` against the probe's
/// compiled output; runtime behavior (returns 42 through a genuine
/// BLOCKED read -> waitable-set wait -> FUTURE_READ event cycle) is gated
/// by scripts/test_future_value_component_gate.sh.
///
/// Core module indices: 0=guest, 1=memhost. Core instance indices:
/// 0=memhost, 1=root ($root bindings), 2=export-root, 3=env, 4=guest.
/// Core func indices: 0=future.new, 1=future.read, 2=future.write,
/// 3=future.drop-readable, 4=future.drop-writable, 5=task-return,
/// 6=waitable-set.new, 7=waitable.join, 8=waitable-set.wait,
/// 9=waitable-set.drop, 10=alias(guest-inst, "run"). Component type
/// indices: 0=(future u32), 1=the export's async functype. Component func
/// indices: 0=the lifted "run" (no imports precede it).
///
/// `comp_result_valtype` must be comp_valtype_u32: it is both the future's
/// payload type and the task.return result type, and the guest core module
/// is hard-coded to the i32 lowering of both (same guard rationale as
/// comp_emit_self_contained_async_component).
export fn comp_emit_component_wasm_future_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {
  if comp_result_valtype != comp_valtype_u32 {
    throw("component(future-value): only comp_valtype_u32 (\{comp_valtype_u32}) is supported, got \{comp_result_valtype} -- the guest core module is hard-coded to an i32-shaped future payload and result")
  }
  else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, comp_generate_future_value_guest_core_module())
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, [
    "memory"
  ], [
    core_sort_mem
  ])
  let future_type_idx = 0
  emit_comp_future_type_section(buf, comp_result_valtype)
  emit_canon_future_new(buf, future_type_idx)
  emit_canon_future_read(buf, future_type_idx, mem_alias_idx)
  emit_canon_future_write(buf, future_type_idx, mem_alias_idx)
  emit_canon_future_drop_readable(buf, future_type_idx)
  emit_canon_future_drop_writable(buf, future_type_idx)
  emit_canon_task_return(buf, comp_result_valtype)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [
    9
  ], [
    "[future-new-0]make",
    "[async-lower][future-read-0]make",
    "[async-lower][future-write-0]make",
    "[future-drop-readable-0]make",
    "[future-drop-writable-0]make",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [
    0,
    1,
    2,
    3,
    4,
    6,
    7,
    8,
    9
  ])
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "[task-return]run"
  ], [
    5
  ])
  emit_core_instance_from_exports_sorted(buf, [
    "memory"
  ], [
    core_sort_mem
  ], [
    mem_alias_idx
  ])
  let env_inst = 3
  let guest_inst = 4
  emit_core_instance_instantiate_args(buf, 0, [
    "$root",
    "[export]$root",
    "env"
  ], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  let run_func_alias_idx = 10
  emit_alias_section(buf, guest_inst, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, run_func_alias_idx, 1)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

/// ADR-0089 Decision 2 / step 4 (#1218): component type section with a
/// single async func type `() -> <type index>` -- the variant of
/// emit_comp_async_functype_section whose RESULT is a component type
/// index (a defined type such as `(future u32)`) rather than a primitive
/// valtype. Byte shape recovered via `wasm-tools dump` against
/// tools/wasip3_component_probe/host_future_value/component.wat's
/// compiled output: `43 00 00 <s33 type index>` -- same async-functype
/// opcode 0x43, 0 params, result-form 0x00, and the positive s33 type
/// index where a primitive result carries its (negative-range) valtype
/// byte. Single-byte LEB is exact for every index this file mints.
fn emit_comp_async_functype_section_result_type(buf: Bytes, result_type_idx: Int) -> Unit {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 67)
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, result_type_idx)
  emit_raw_content(buf, content)
}

/// ADR-0089 Decision 2 / step 4 (#1218): single component import with an
/// EXPLICIT functype index. emit_comp_import_section above assumes import
/// i uses functype i (true for the shapes that only mint functypes); a
/// component whose type space also holds defined types (the future type
/// precedes the import's functype here) needs the index spelled out.
/// Byte shape from the host_future_value probe dump: extern-name tag 0x00,
/// name, externdesc func (comp_extern_func = 1), functype index.
fn emit_comp_import_section_typed(buf: Bytes, import_name: String, functype_idx: Int) -> Unit {
  bytebuf_push(buf, section_import)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  emit_name(content, import_name)
  bytebuf_push(content, comp_extern_func)
  leb128_encode_u32(content, functype_idx)
  emit_raw_content(buf, content)
}

/// ADR-0089 Decision 2 / step 4 (#1218): guest core module for the
/// HOST-SUPPLIED future<u32> value -- a byte-level port of
/// tools/wasip3_component_probe/host_future_value/component.wat's $guest.
/// The counterpart of comp_generate_future_value_guest_core_module with
/// the write end living in the HOST (runtime/viberun's `get-future`
/// import, a wasmtime FutureReader producer that resolves only after a
/// genuine timer suspend):
///
///   1. [async-lower]get-future -> must complete eagerly (RETURNED, code
///      2): creating the future pair suspends nothing host-side. The
///      future READABLE-end handle lands in the results buffer.
///   2. async future.read -> BLOCKED (the producer's timer has not fired)
///   3. waitable.join(fut, ws); waitable-set.wait -> the task genuinely
///      SUSPENDS until the host producer resolves; the completion arrives
///      as a FUTURE_READ (= 4) event in completion order
///   4. read buffer -> value; drop the READABLE end only (the host owns
///      the write side) then the set; task.return
///
/// This is the `waitable-set.wait` backend of Decision 1's three-backend
/// split measured end-to-end: park-as-waitable instead of poll-retry,
/// woken by host completion. Diagnostics via task.return (5000 + code:
/// get-future not eager; 1000 + low bits: read did not block; 3000 + ev:
/// unexpected wait event).
///
/// Memory layout: 0 = read buffer, 8 = async-lower results (the future
/// handle), 16 = waitable-set.wait payload area. Import func indices 0-7,
/// local func 8 = `run` (exported): 0=[async-lower]get-future,
/// 1=[async-lower][future-read-0]get-future,
/// 2=[future-drop-readable-0]get-future, 3=[waitable-set-new],
/// 4=[waitable-join], 5=[waitable-set-wait], 6=[waitable-set-drop],
/// 7=[task-return]run. Import names follow the wit-bindgen capture
/// convention ([future-<op>-N]<introducing WIT function>,
/// future_value/canon-imports-exports.wit-abi.txt) -- and unlike the
/// self-contained shapes they are load-bearing here: `get-future` is the
/// real component-level import name the host links against.
fn comp_generate_host_future_value_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 (i32)->(i32) async-lowered get-future; 1 (i32,i32)->(i32)
  // future.read & ws_wait; 2 (i32)->() drop/ws_drop/task_return;
  // 3 ()->(i32) ws_new; 4 (i32,i32)->() waitable_join; 5 ()->() run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 6)
  emit_func_type_raw(tc, [
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  // imports: 8 core funcs (indices 0-7) + the shared memhost memory.
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 9)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][future-read-0]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[future-drop-readable-0]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    5
  ])
  emit_export_section(out, "run", 8)
  // Code section built by hand (same convention as the future-value
  // guest). run's locals (all i32): 0=packed, 1=code, 2=fut, 3=st, 4=ws,
  // 5=ev.
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let body = bytebuf_new()
  leb128_encode_u32(body, 1)
  leb128_encode_u32(body, 6)
  bytebuf_push(body, 127)
  // packed = get-future(results at 8); code = packed & 0xf
  emit_i32_const(body, 8)
  emit_call(body, 0)
  emit_local_set(body, 0)
  emit_local_get(body, 0)
  emit_i32_const(body, 15)
  emit_i32_and(body)
  emit_local_set(body, 1)
  // if code != RETURNED (2): report 5000 + code -- there is no
  // subtask-wait epilogue in this shape, eagerness is the contract.
  emit_local_get(body, 1)
  emit_i32_const(body, 2)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 5000)
  emit_local_get(body, 1)
  emit_i32_add(body)
  emit_call(body, 7)
  emit_return(body)
  emit_end(body)
  // fut = mem[8]
  emit_i32_const(body, 8)
  emit_i32_load(body, 2, 0)
  emit_local_set(body, 2)
  // st = future.read(fut, 0) -- must block (>= 1ms producer delay)
  emit_local_get(body, 2)
  emit_i32_const(body, 0)
  emit_call(body, 1)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 1000)
  emit_local_get(body, 3)
  emit_i32_const(body, 15)
  emit_i32_and(body)
  emit_i32_add(body)
  emit_call(body, 7)
  emit_return(body)
  emit_end(body)
  // park as a waitable: ws = ws_new(); join(fut, ws); ev = wait(ws, 16)
  emit_call(body, 3)
  emit_local_set(body, 4)
  emit_local_get(body, 2)
  emit_local_get(body, 4)
  emit_call(body, 4)
  emit_local_get(body, 4)
  emit_i32_const(body, 16)
  emit_call(body, 5)
  emit_local_set(body, 5)
  // this task owns exactly one waitable, so the first event must be
  // FUTURE_READ (= 4)
  emit_local_get(body, 5)
  emit_i32_const(body, 4)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 3000)
  emit_local_get(body, 5)
  emit_i32_add(body)
  emit_call(body, 7)
  emit_return(body)
  emit_end(body)
  // teardown: drop the READABLE end (ours) before the set, then return
  // the value that landed in the read buffer.
  emit_local_get(body, 2)
  emit_call(body, 2)
  emit_local_get(body, 4)
  emit_call(body, 6)
  emit_i32_const(body, 0)
  emit_i32_load(body, 2, 0)
  emit_call(body, 7)
  bytebuf_push(body, 11)
  leb128_encode_u32(code_sec, Bytes::length(body))
  bytebuf_push_buf(code_sec, body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// ADR-0089 Decision 2 / step 4 (#1218): fixed-shape component that reads
/// a HOST-SUPPLIED `future<u32>` -- imports `get-future: func() ->
/// future<u32>` (async-typed at the component level: the `async` canon
/// lower option validates only against an async function type) and parks
/// on the read via waitable-set.wait until the host's producer resolves.
/// Byte-verified against tools/wasip3_component_probe/host_future_value/
/// component.wat; runtime behavior (42 through a genuine BLOCKED read ->
/// host timer -> completion-order FUTURE_READ wake, wall clock >= the
/// producer delay) is gated by
/// scripts/test_host_future_value_component_gate.sh, driven by
/// runtime/viberun's `get-future` FutureReader import.
///
/// Component type indices: 0=(future u32), 1=import functype (async,
/// result = type 0), 2=export functype (async, result u32). Component
/// func indices: 0=the import, 1=the lifted "run". Core func indices:
/// 0=lowered get-future, 1=future.read, 2=future.drop-readable,
/// 3=task-return, 4=waitable-set.new, 5=waitable.join,
/// 6=waitable-set.wait, 7=waitable-set.drop, 8=alias(guest, "run").
/// Core instance indices: 0=memhost, 1=root, 2=export-root, 3=env,
/// 4=guest.
///
/// `comp_result_valtype` must be comp_valtype_u32 (it is both the
/// future's payload type and the task.return result type; the guest core
/// module is hard-coded to the i32 lowering of both).
export fn comp_emit_component_wasm_host_future_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {
  if comp_result_valtype != comp_valtype_u32 {
    throw("component(host-future-value): only comp_valtype_u32 (\{comp_valtype_u32}) is supported, got \{comp_result_valtype} -- the guest core module is hard-coded to an i32-shaped future payload and result")
  }
  else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  let future_type_idx = 0
  emit_comp_future_type_section(buf, comp_result_valtype)
  emit_comp_async_functype_section_result_type(buf, future_type_idx)
  emit_comp_import_section_typed(buf, "get-future", 1)
  emit_core_module_section(buf, comp_generate_host_future_value_guest_core_module())
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, [
    "memory"
  ], [
    core_sort_mem
  ])
  emit_canon_lower_async_section(buf, 0, mem_alias_idx)
  emit_canon_future_read(buf, future_type_idx, mem_alias_idx)
  emit_canon_future_drop_readable(buf, future_type_idx)
  emit_canon_task_return(buf, comp_result_valtype)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [
    7
  ], [
    "[async-lower]get-future",
    "[async-lower][future-read-0]get-future",
    "[future-drop-readable-0]get-future",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [
    0,
    1,
    2,
    4,
    5,
    6,
    7
  ])
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "[task-return]run"
  ], [
    3
  ])
  emit_core_instance_from_exports_sorted(buf, [
    "memory"
  ], [
    core_sort_mem
  ], [
    mem_alias_idx
  ])
  let env_inst = 3
  let guest_inst = 4
  emit_core_instance_instantiate_args(buf, 0, [
    "$root",
    "[export]$root",
    "env"
  ], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  let run_func_alias_idx = 8
  emit_alias_section(buf, guest_inst, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, run_func_alias_idx, 2)
  emit_comp_export_section(buf, export_name, 1)
  bytebuf_to_bytes(buf)
}

/// ADR-0089 step 4 (#1218): does a compiled core module import the
/// host-future pair (`vibe.host_future_get`)? This is the wrap-time key
/// that routes an async entry to comp_emit_component_wasm_async_hostfuture
/// instead of the plain trampolined-p1 shape -- the import is emitted by
/// linked_compile exactly when the program calls `host_future_get`, so
/// sniffing the BYTES is exact where an AST scan could be fooled by
/// shadowing.
export fn comp_core_imports_host_future(core_wasm: Bytes) -> Bool {
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut found = false
  let mut i = 0
  while i < import_count {
    if Array::get(imp_modules, i) == "vibe" && Array::get(imp_names, i) == "host_future_get" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// ADR-0089 step 4 (#1218): the ADAPTER core module that implements the
/// guest's `vibe.host_future_get` / `vibe.host_future_wait` raw imports
/// over the canon built-ins (spec §3.13's sequence, factored out of the
/// fixed-shape comp_generate_host_future_value_guest_core_module and
/// re-targeted at a REAL compiled core module).
///
/// Values are value-passed (i64) in the guest's TAGGED convention
/// (internal Int = value << 1, the generic vibe.* call path): the adapter
/// shifts on entry/exit, so no compile_call shim is needed and the raw ABI
/// stays pointer-free -- which is what makes this composition acyclic
/// (buffers live in the memhost memory, never the guest's; the vfs
/// shim/fixup dance is not needed).
///
/// Import func indices 0-6 + env.memory (memhost); local funcs
/// 7 = host_future_get () -> i64, 8 = host_future_wait (i64) -> i64.
/// Scratch layout in memhost memory: 0 = future.read landing slot,
/// 8 = async-lower results slot, 16 = waitable-set.wait payload area.
/// Contract violations (non-eager get-future, non-FUTURE_READ wake) trap
/// with `unreachable`: the adapter runs inside the lifted task, so the
/// fixed-shape's task.return diagnostic bands are not available here.
fn comp_generate_hostfuture_adapter_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 (i32)->(i32) async-lowered get-future; 1 (i32,i32)->(i32)
  // future.read & ws_wait; 2 (i32)->() drop-readable/ws_drop; 3 ()->(i32)
  // ws_new; 4 (i32,i32)->() waitable_join; 5 ()->(i64) host_future_get;
  // 6 (i64)->(i64) host_future_wait.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 7)
  emit_func_type_raw(tc, [
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  // imports: 7 core funcs (indices 0-6) + the memhost memory.
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 8)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][future-read-0]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[future-drop-readable-0]get-future")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    5,
    6
  ])
  emit_export_section_multi(out, [
    "host_future_get",
    "host_future_wait"
  ], [
    7,
    8
  ])
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  // func 7: host_future_get. locals (i32): 0=packed, 1=code.
  let get_body = bytebuf_new()
  leb128_encode_u32(get_body, 1)
  leb128_encode_u32(get_body, 2)
  bytebuf_push(get_body, 127)
  // packed = get-future(results at 8); code = packed & 0xf
  emit_i32_const(get_body, 8)
  emit_call(get_body, 0)
  emit_local_set(get_body, 0)
  emit_local_get(get_body, 0)
  emit_i32_const(get_body, 15)
  emit_i32_and(get_body)
  emit_local_set(get_body, 1)
  // pair creation is synchronous by contract: code must be RETURNED (2)
  emit_local_get(get_body, 1)
  emit_i32_const(get_body, 2)
  emit_i32_ne(get_body)
  emit_if_void(get_body)
  bytebuf_push(get_body, 0)
  emit_end(get_body)
  // return the handle from mem[8], tagged (i64.extend_i32_u = 0xad, << 1)
  emit_i32_const(get_body, 8)
  emit_i32_load(get_body, 2, 0)
  bytebuf_push(get_body, 173)
  emit_i64_const(get_body, 1)
  emit_i64_shl(get_body)
  bytebuf_push(get_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(get_body))
  bytebuf_push_buf(code_sec, get_body)
  // func 8: host_future_wait. param 0 = tagged handle (i64); locals (i32):
  // 1=fut, 2=st, 3=ws, 4=ev.
  let wait_body = bytebuf_new()
  leb128_encode_u32(wait_body, 1)
  leb128_encode_u32(wait_body, 4)
  bytebuf_push(wait_body, 127)
  // fut = wrap(param >> 1)
  emit_local_get(wait_body, 0)
  emit_i64_const(wait_body, 1)
  emit_i64_shr_s(wait_body)
  emit_i32_wrap_i64(wait_body)
  emit_local_set(wait_body, 1)
  // st = future.read(fut, 0)
  emit_local_get(wait_body, 1)
  emit_i32_const(wait_body, 0)
  emit_call(wait_body, 1)
  emit_local_set(wait_body, 2)
  // BLOCKED (-1): park as a waitable -- ws = ws_new(); join(fut, ws);
  // ev = wait(ws, 16); the only waitable in the set, so the event must be
  // FUTURE_READ (4). Any other status means the read completed eagerly
  // (host resolved before we read) and the value is already at mem[0].
  emit_local_get(wait_body, 2)
  emit_i32_const(wait_body, -1)
  emit_i32_eq(wait_body)
  emit_if_void(wait_body)
  emit_call(wait_body, 3)
  emit_local_set(wait_body, 3)
  emit_local_get(wait_body, 1)
  emit_local_get(wait_body, 3)
  emit_call(wait_body, 4)
  emit_local_get(wait_body, 3)
  emit_i32_const(wait_body, 16)
  emit_call(wait_body, 5)
  emit_local_set(wait_body, 4)
  emit_local_get(wait_body, 4)
  emit_i32_const(wait_body, 4)
  emit_i32_ne(wait_body)
  emit_if_void(wait_body)
  bytebuf_push(wait_body, 0)
  emit_end(wait_body)
  emit_end(wait_body)
  // teardown: drop the READABLE end (ours; the writable end is host-owned),
  // then the set if one was created (ends before sets, the children rule)
  emit_local_get(wait_body, 1)
  emit_call(wait_body, 2)
  emit_local_get(wait_body, 2)
  emit_i32_const(wait_body, -1)
  emit_i32_eq(wait_body)
  emit_if_void(wait_body)
  emit_local_get(wait_body, 3)
  emit_call(wait_body, 6)
  emit_end(wait_body)
  // return the value that landed in the read buffer, tagged
  emit_i32_const(wait_body, 0)
  emit_i32_load(wait_body, 2, 0)
  bytebuf_push(wait_body, 173)
  emit_i64_const(wait_body, 1)
  emit_i64_shl(wait_body)
  bytebuf_push(wait_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(wait_body))
  bytebuf_push_buf(code_sec, wait_body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// ADR-0089 step 4 (#1218): async trampoline for a REAL compiled entry
/// with a u32-lifted result -- imports ("main","run") in the compiled core
/// shape `(i64) -> i64` (closure-env param, untagged result) and
/// ("cm","task-return") `(i32) -> ()`, exports a void `run` that calls the
/// entry with a dummy env, wraps the i64 to i32 and forwards it to
/// task.return. The u32 result type (unlike trampolined-p1's s64) matches
/// viberun's typed `run` driver -- the only host that provides the
/// `get-future` import this composition needs.
fn comp_generate_async_trampoline_hostfuture() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 2)
  emit_name(ic, "main")
  emit_name(ic, "run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "cm")
  emit_name(ic, "task-return")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    2
  ])
  emit_export_section(out, "run", 2)
  let body = bytebuf_new()
  emit_i64_const(body, 0)
  emit_call(body, 0)
  emit_i32_wrap_i64(body)
  emit_call(body, 1)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

/// ADR-0089 step 4 (#1218): wrap a REAL compiled core module -- one whose
/// program calls `host_future_get`, so the core imports
/// `vibe.host_future_get` / `vibe.host_future_wait` -- into an async
/// component that imports `get-future: func() -> future<u32>` from the
/// host and satisfies the core's imports with the adapter module above.
/// This is the step-4 wiring: real `.vibe`-source `await` (lowered by
/// await_poll_pass + the entry boundary to the reserved waitable Suspend
/// payload) reaches `waitable-set.wait` through the adapter, where the
/// canonical ABI genuinely suspends the task until the host resolves the
/// future (measured by scripts/test_hostfuture_source_component_gate.sh).
///
/// Composition (acyclic -- buffers live in memhost memory, values cross
/// as i64s): memhost -> canon defs over its memory -> adapter($root, env)
/// -> fd_write stub -> main(wasi=stub, vibe=adapter) -> trampoline(main,
/// cm) -> async lift (u32) -> export.
///
/// Component type indices: 0=(future u32), 1=import functype (async,
/// result = type 0), 2=export functype (async, result u32). Component
/// func indices: 0=the import, 1=the lifted run. Core func indices:
/// 0=lowered get-future, 1=future.read, 2=future.drop-readable,
/// 3=task-return, 4=waitable-set.new, 5=waitable.join,
/// 6=waitable-set.wait, 7=waitable-set.drop, 8=alias(main, "run"),
/// 9=alias(trampoline, "run"). Core instances: 0=memhost, 1=$root,
/// 2=env(memory), 3=adapter, 4=wasi-stub, 5=main, 6=main-arg, 7=cm-arg,
/// 8=trampoline.
export fn comp_emit_component_wasm_async_hostfuture(main_core_wasm: Bytes, export_name: String) -> Bytes with { Error } {
  // The compiled entry must be exported as `run : (i64) -> i64` (entry
  // name "run" -- the same constraint the trampolined-p1 wrap has).
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(main_core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut run_ok = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == "run" {
      let sig = Array::get(export_type_sigs, ei)
      if Array::length(sig) == 4 {
        run_ok = Array::get(sig, 0) == 1 && Array::get(sig, 1) == 126 && Array::get(sig, 2) == 1 && Array::get(sig, 3) == 126
      } else {
        ()
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !run_ok {
    throw("component(async-hostfuture): core module must export 'run : (i64) -> i64' (compile with entry name \"run\")")
  } else {
    ()
  }
  // Import allowlist: the preview1 preamble stub plus the two adapter
  // imports. Anything else (fs, http, sleep, ...) has no provider in this
  // self-contained composition -- reject with a clear message instead of a
  // late instantiation error.
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(main_core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if im == "vibe" && (ifn == "host_future_get" || ifn == "host_future_wait") {
      ()
    } else {
      throw("component(async-hostfuture): core module uses host import '\{im}.\{ifn}' (only fd_write and the host-future pair are satisfiable in this composition)")
    }
    ii = ii + 1
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  let future_type_idx = 0
  emit_comp_future_type_section(buf, comp_valtype_u32)
  emit_comp_async_functype_section_result_type(buf, future_type_idx)
  emit_comp_import_section_typed(buf, "get-future", 1)
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_memhost_module())
  emit_core_module_section(buf, comp_generate_hostfuture_adapter_core_module())
  emit_core_module_section(buf, comp_generate_async_trampoline_hostfuture())
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, [
    "memory"
  ], [
    core_sort_mem
  ])
  emit_canon_lower_async_section(buf, 0, mem_alias_idx)
  emit_canon_future_read(buf, future_type_idx, mem_alias_idx)
  emit_canon_future_drop_readable(buf, future_type_idx)
  emit_canon_task_return(buf, comp_valtype_u32)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [
    7
  ], [
    "[async-lower]get-future",
    "[async-lower][future-read-0]get-future",
    "[future-drop-readable-0]get-future",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [
    0,
    1,
    2,
    4,
    5,
    6,
    7
  ])
  let env_inst = 2
  emit_core_instance_from_exports_sorted(buf, [
    "memory"
  ], [
    core_sort_mem
  ], [
    mem_alias_idx
  ])
  let adapter_inst = 3
  emit_core_instance_instantiate_args(buf, 2, [
    "$root",
    "env"
  ], [
    root_inst,
    env_inst
  ])
  let stub_inst = 4
  emit_core_instance_instantiate_section(buf, 4, array_empty())
  let main_inst = 5
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1",
    "vibe"
  ], [
    stub_inst,
    adapter_inst
  ])
  let main_run_func_idx = 8
  emit_alias_section(buf, main_inst, [
    "run"
  ], [
    core_sort_func
  ])
  let main_arg_inst = 6
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "run"
  ], [
    main_run_func_idx
  ])
  let cm_arg_inst = 7
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    3
  ])
  let tramp_inst = 8
  emit_core_instance_instantiate_args(buf, 3, [
    "main",
    "cm"
  ], [
    main_arg_inst,
    cm_arg_inst
  ])
  emit_comp_async_functype_section(buf, comp_valtype_u32)
  let tramp_run_func_idx = 9
  emit_alias_section(buf, tramp_inst, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, tramp_run_func_idx, 2)
  emit_comp_export_section(buf, export_name, 1)
  bytebuf_to_bytes(buf)
}

/// ADR-0089 step 2 (#1218): guest core module for the SELF-CONTAINED
/// stream<u8> round-trip -- a byte-level port of
/// tools/wasip3_component_probe/stream_value/component.wat's $guest. Same
/// single-task rendezvous as comp_generate_future_value_guest_core_module
/// (async read BLOCKED -> join -> async write completes eagerly -> wait ->
/// STREAM_READ), with the stream-specific differences: read/write carry an
/// element COUNT (core sig (handle, ptr, n) -> status), the completion
/// status packs (amount << 4) | code, and the expected event code is
/// STREAM_READ = 2. This probe/emitter pair moves exactly 1 element (the
/// byte 42).
///
/// Import func indices 0-9, local func 10 = `run` (exported):
/// 0=[stream-new-0]pipe, 1=[async-lower][stream-read-0]pipe,
/// 2=[async-lower][stream-write-0]pipe, 3=[stream-drop-readable-0]pipe,
/// 4=[stream-drop-writable-0]pipe, 5=[waitable-set-new],
/// 6=[waitable-join], 7=[waitable-set-wait], 8=[waitable-set-drop],
/// 9=[task-return]run. Memory layout: 0 = 1-byte read landing slot,
/// 4 = staged write byte, 16 = wait payload area. Diagnostics through
/// task.return: 1000 + low bits (read did not block), 2015 (write
/// blocked), 3000 + event code (not STREAM_READ).
fn comp_generate_stream_value_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 ()->(i64) stream.new; 1 (i32,i32,i32)->(i32)
  // stream.read/write; 2 (i32)->() drops & task_return; 3 ()->(i32)
  // ws_new; 4 (i32,i32)->() waitable_join; 5 ()->() run;
  // 6 (i32,i32)->(i32) ws_wait.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 7)
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  emit_func_type_raw(tc, [
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 11)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-new-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][stream-read-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][stream-write-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-drop-readable-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-drop-writable-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 6)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    5
  ])
  emit_export_section(out, "run", 10)
  // run's locals: 0=packed (i64), 1=readable, 2=writable, 3=st, 4=ws, 5=ev.
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let body = bytebuf_new()
  leb128_encode_u32(body, 2)
  leb128_encode_u32(body, 1)
  bytebuf_push(body, 126)
  leb128_encode_u32(body, 5)
  bytebuf_push(body, 127)
  // packed = stream.new(); readable = low 32 bits, writable = high 32.
  emit_call(body, 0)
  emit_local_set(body, 0)
  emit_local_get(body, 0)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 1)
  emit_local_get(body, 0)
  emit_i64_const(body, 32)
  emit_i64_shr_s(body)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 2)
  // stage the byte to send: mem[4] = 42
  emit_i32_const(body, 4)
  emit_i32_const(body, 42)
  emit_i32_store8(body, 0, 0)
  // st = stream.read(readable, 0, 1) -- must block (no writer yet)
  emit_local_get(body, 1)
  emit_i32_const(body, 0)
  emit_i32_const(body, 1)
  emit_call(body, 1)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 1000)
  emit_local_get(body, 3)
  emit_i32_const(body, 15)
  emit_i32_and(body)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // register the pending read's waitable before writing
  emit_call(body, 5)
  emit_local_set(body, 4)
  emit_local_get(body, 1)
  emit_local_get(body, 4)
  emit_call(body, 6)
  // st = stream.write(writable, 4, 1) -- copies against the pending read
  emit_local_get(body, 2)
  emit_i32_const(body, 4)
  emit_i32_const(body, 1)
  emit_call(body, 2)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_eq(body)
  emit_if_void(body)
  emit_i32_const(body, 2015)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // collect the pending read's completion event (STREAM_READ = 2)
  emit_local_get(body, 4)
  emit_i32_const(body, 16)
  emit_call(body, 7)
  emit_local_set(body, 5)
  emit_local_get(body, 5)
  emit_i32_const(body, 2)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 3000)
  emit_local_get(body, 5)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // teardown (ends before the set), then return the delivered byte
  emit_local_get(body, 1)
  emit_call(body, 3)
  emit_local_get(body, 2)
  emit_call(body, 4)
  emit_local_get(body, 4)
  emit_call(body, 8)
  emit_i32_const(body, 0)
  emit_i32_load8_u(body, 0, 0)
  emit_call(body, 9)
  bytebuf_push(body, 11)
  leb128_encode_u32(code_sec, Bytes::length(body))
  bytebuf_push_buf(code_sec, body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// ADR-0089 step 2 (#1218): fixed-shape component exercising the literal
/// `stream.*` canonical built-ins end to end -- the stream twin of
/// comp_emit_component_wasm_future_value, byte-verified against
/// tools/wasip3_component_probe/stream_value/component.wat (wasmtime 47,
/// returns 42 with -W component-model-more-async-builtins=y). Identical
/// composition and index layout; the differences are the (stream u8)
/// component type (elem = comp_valtype_u8 -- the ByteStream element type,
/// NOT the task.return result type, which stays u32) and the stream guest
/// module. Gate: scripts/test_stream_value_component_gate.sh.
export fn comp_emit_component_wasm_stream_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {
  if comp_result_valtype != comp_valtype_u32 {
    throw("component(stream-value): only comp_valtype_u32 (\{comp_valtype_u32}) is supported, got \{comp_result_valtype} -- the guest core module is hard-coded to a u8 element and an i32-shaped result")
  }
  else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, comp_generate_stream_value_guest_core_module())
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, [
    "memory"
  ], [
    core_sort_mem
  ])
  let stream_type_idx = 0
  emit_comp_stream_type_section(buf, comp_valtype_u8)
  emit_canon_stream_new(buf, stream_type_idx)
  emit_canon_stream_read(buf, stream_type_idx, mem_alias_idx)
  emit_canon_stream_write(buf, stream_type_idx, mem_alias_idx)
  emit_canon_stream_drop_readable(buf, stream_type_idx)
  emit_canon_stream_drop_writable(buf, stream_type_idx)
  emit_canon_task_return(buf, comp_result_valtype)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [
    9
  ], [
    "[stream-new-0]pipe",
    "[async-lower][stream-read-0]pipe",
    "[async-lower][stream-write-0]pipe",
    "[stream-drop-readable-0]pipe",
    "[stream-drop-writable-0]pipe",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [
    0,
    1,
    2,
    3,
    4,
    6,
    7,
    8,
    9
  ])
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "[task-return]run"
  ], [
    5
  ])
  emit_core_instance_from_exports_sorted(buf, [
    "memory"
  ], [
    core_sort_mem
  ], [
    mem_alias_idx
  ])
  let env_inst = 3
  let guest_inst = 4
  emit_core_instance_instantiate_args(buf, 0, [
    "$root",
    "[export]$root",
    "env"
  ], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  let run_func_alias_idx = 10
  emit_alias_section(buf, guest_inst, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, run_func_alias_idx, 1)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

/// #537: core:sort for globals (func=0, table=1, mem=2, global=3).
let core_sort_global = 3

/// #537: from-exports core instance with per-item sorts (the older
/// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string
/// env instance also carries the main memory and the __heap_ptr global).
fn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 1)
  leb128_encode_u32(content, Array::length(names))
  let mut i = 0
  while i < Array::length(names) {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, Array::get(sorts, i))
    leb128_encode_u32(content, Array::get(indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}

/// #537: string trampoline for the CURRENT wasi linear backend ABI.
/// A vibe string value is the packed i64 `(byte_offset << 32) | byte_len`
/// (mode-invariant: identical under bump and RC; see gen_str_len_body /
/// gen_str_char_code_at_body). The legacy comp_generate_string_trampoline
/// predates this and builds retired-host heap-object strings, so it cannot
/// call today's core modules.
///
/// Imports (module "env", all supplied from the main core instance):
///   target_func : (i64 x N) -> i64      the exported vibe handler
///   memory      : the main linear memory
///   __heap_ptr  : mut i32 global        the main module's bump frontier
/// Exports:
///   cabi_realloc : (i32,i32,i32,i32) -> i32
///     Canonical-ABI allocator used by the host to lower string params into
///     the main memory (and by canon_func for the string-result ret area).
///     Bumps __heap_ptr (align-adjusted) and memory.grows as needed. Fresh
///     allocations only (old_ptr is ignored) — the canonical lowering of
///     bare string params/results never reallocates.
///   canon_func : (i32 x 2N) -> i32
///     Canonical-ABI core shape of `(string x N) -> string`: N (ptr,len)
///     pairs in, retptr out. Packs each pair into a vibe string value, calls
///     target_func, unpacks the returned value into an 8-byte (ptr,len)
///     return area allocated via cabi_realloc.
export fn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_header(buf)
  // types: 0 = target_func (i64 x N) -> i64; 1 = canon_func (i32 x 2N) -> i32;
  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32
  let type_sec = bytebuf_new()
  bytebuf_push_vec_header(type_sec, 3)
  bytebuf_push(type_sec, 96)
  // +1: top-level vibe functions carry a trailing closure-env i64 param
  // (callers pass 0); see linked_compile's entry invocation.
  leb128_encode_u32(type_sec, string_param_count + 1)
  let mut ti = 0
  while ti < (string_param_count + 1) {
    bytebuf_push(type_sec, 126)
    ti = ti + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count * 2)
  let mut ci = 0
  while ci < (string_param_count * 2) {
    bytebuf_push(type_sec, 127)
    ci = ci + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, 4)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push_section(buf, 1, type_sec)
  // imports: env.target_func (func 0), env.__heap_ptr (mut i32 global), env.memory
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 3)
  emit_name(import_sec, "env")
  emit_name(import_sec, "target_func")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "__heap_ptr")
  bytebuf_push(import_sec, 3)
  bytebuf_push(import_sec, 127)
  bytebuf_push(import_sec, 1)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(buf, 2, import_sec)
  // funcs: 1 = canon_func (type 1), 2 = cabi_realloc (type 2)
  let func_sec = bytebuf_new()
  leb128_encode_u32(func_sec, 2)
  leb128_encode_u32(func_sec, 1)
  leb128_encode_u32(func_sec, 2)
  bytebuf_push_section(buf, 3, func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "canon_func")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, "cabi_realloc")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 2)
  bytebuf_push_section(buf, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  // canon_func body. locals: params 0..2N-1 (i32); 2N = result i64; 2N+1 = retptr i32
  let canon_body = bytebuf_new()
  leb128_encode_u32(canon_body, 2)
  leb128_encode_u32(canon_body, 1)
  bytebuf_push(canon_body, 126)
  leb128_encode_u32(canon_body, 1)
  bytebuf_push(canon_body, 127)
  let result_local = string_param_count * 2
  let retptr_local = result_local + 1
  let mut si = 0
  while si < string_param_count {
    // (extend_u(ptr) << 32) | extend_u(len)
    emit_local_get(canon_body, si * 2)
    bytebuf_push(canon_body, 173)
    emit_i64_const(canon_body, 32)
    bytebuf_push(canon_body, 134)
    emit_local_get(canon_body, (si * 2) + 1)
    bytebuf_push(canon_body, 173)
    bytebuf_push(canon_body, 132)
    si = si + 1
  }
  // Trailing closure-env argument (0 for a top-level function).
  emit_i64_const(canon_body, 0)
  bytebuf_push(canon_body, 16)
  leb128_encode_u32(canon_body, 0)
  emit_local_set(canon_body, result_local)
  // retptr = cabi_realloc(0, 0, 4, 8)
  emit_i32_const(canon_body, 0)
  emit_i32_const(canon_body, 0)
  emit_i32_const(canon_body, 4)
  emit_i32_const(canon_body, 8)
  bytebuf_push(canon_body, 16)
  leb128_encode_u32(canon_body, 2)
  emit_local_set(canon_body, retptr_local)
  // [retptr] = wrap(result >> 32); [retptr+4] = wrap(result & 0xFFFFFFFF)
  emit_local_get(canon_body, retptr_local)
  emit_local_get(canon_body, result_local)
  emit_i64_const(canon_body, 32)
  bytebuf_push(canon_body, 136)
  bytebuf_push(canon_body, 167)
  emit_i32_store(canon_body, 2, 0)
  emit_local_get(canon_body, retptr_local)
  emit_local_get(canon_body, result_local)
  bytebuf_push(canon_body, 167)
  emit_i32_store(canon_body, 2, 4)
  emit_local_get(canon_body, retptr_local)
  bytebuf_push(canon_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(canon_body))
  bytebuf_push_buf(code_sec, canon_body)
  // cabi_realloc body. params: 0=old_ptr 1=old_size 2=align 3=new_size;
  // local 4 = aligned ptr.
  let realloc_body = bytebuf_new()
  leb128_encode_u32(realloc_body, 1)
  leb128_encode_u32(realloc_body, 1)
  bytebuf_push(realloc_body, 127)
  // p = (heap + align - 1) & (0 - align)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_local_get(realloc_body, 2)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 1)
  bytebuf_push(realloc_body, 107)
  emit_i32_const(realloc_body, 0)
  emit_local_get(realloc_body, 2)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 113)
  emit_local_set(realloc_body, 4)
  // __heap_ptr = p + new_size
  emit_local_get(realloc_body, 4)
  emit_local_get(realloc_body, 3)
  emit_i32_add(realloc_body)
  bytebuf_push(realloc_body, 36)
  leb128_encode_u32(realloc_body, 0)
  // if (__heap_ptr > memory.size << 16) memory.grow(pages needed)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 116)
  bytebuf_push(realloc_body, 75)
  bytebuf_push(realloc_body, 4)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 65535)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 118)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 26)
  bytebuf_push(realloc_body, 11)
  emit_local_get(realloc_body, 4)
  bytebuf_push(realloc_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(realloc_body))
  bytebuf_push_buf(code_sec, realloc_body)
  bytebuf_push_section(buf, 10, code_sec)
  bytebuf_to_bytes(buf)
}

/// #537: wrap a compiled core module into a component exporting
///   <export_name> : func(<param_names>: string, ...) -> string
/// via the packed-string trampoline above. This is the replacement
/// for the retired host's `--compose-p3` handler-side componentization: the
/// result plugs into the P3 HTTP adapter's `import handler: func(method, url,
/// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).
///
/// The core module must export `target_func_name` with signature
/// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and
/// `__heap_ptr` (any normal non-library compile does). Host imports
/// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are
/// rejected: a serve handler must be a pure function of its request params.
export fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {
  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, false)
}

/// #1107 Phase 5 (vibec, the implementation shape of #857): like
/// comp_emit_component_wasm_string_handler, but SATISFIES the core's `vibe.*`
/// host imports with local stubs instead of rejecting them — `env-get` returns
/// the raw-ABI empty string (i64 0 = ptr 0 / len 0, i.e. "unset", the same
/// value an unset variable yields on a real host) and every other `vibe.*`
/// import traps (`unreachable`). Intended for cores whose lifted entry's
/// effect row proves those imports dynamically unreachable: the vibec core's
/// `compile_cli_request` carries no Env/Fs row (sources arrive inline, output
/// leaves as hex chunks), so its `vibe.env-get`/`vibe.fs_*` imports exist only
/// because SIBLING exports of the library build reference them. The serve
/// path stays on the strict-reject variant above so an impure handler still
/// fails at componentize time, not at runtime.
export fn comp_emit_component_wasm_string_handler_stubbed(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {
  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, true)
}

/// One stub core module exporting `fd_write` plus a same-signature stub for
/// each requested `vibe.*` import (see comp_emit_component_wasm_string_handler_stubbed).
/// With empty inputs it degenerates to the fd_write-only stub.
fn comp_generate_host_stub_module(vibe_names: Array[String], vibe_sigs: Array[Array[Int]]) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let n = Array::length(vibe_names)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, n + 1)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  let mut ti = 0
  while ti < n {
    let sig = Array::get(vibe_sigs, ti)
    let pc = Array::get(sig, 0)
    let params = new_int_array()
    let mut pi = 0
    while pi < pc {
      Array::push(params, Array::get(sig, 1 + pi))
      pi = pi + 1
    }
    let rc = Array::get(sig, 1 + pc)
    let results = new_int_array()
    let mut ri = 0
    while ri < rc {
      Array::push(results, Array::get(sig, 2 + pc + ri))
      ri = ri + 1
    }
    emit_func_type_raw(tc, params, results)
    ti = ti + 1
  }
  bytebuf_push_section(out, 1, tc)
  let ftypes = new_int_array()
  Array::push(ftypes, 0)
  let mut fsi = 0
  while fsi < n {
    Array::push(ftypes, fsi + 1)
    fsi = fsi + 1
  }
  emit_function_section(out, ftypes)
  let exp_names = array_empty()
  let exp_idxs = new_int_array()
  Array::push(exp_names, "fd_write")
  Array::push(exp_idxs, 0)
  let mut ei = 0
  while ei < n {
    Array::push(exp_names, Array::get(vibe_names, ei))
    Array::push(exp_idxs, ei + 1)
    ei = ei + 1
  }
  emit_export_section_multi(out, exp_names, exp_idxs)
  let bodies = Array::slice([
    (bytebuf_new())
  ], 0, 0)
  let fd_body = bytebuf_new()
  emit_i32_const(fd_body, 0)
  Array::push(bodies, fd_body)
  let mut bi = 0
  while bi < n {
    let body = bytebuf_new()
    let sn = Array::get(vibe_names, bi)
    // Zero-stubs: env-get -> raw-ABI empty string ("unset"); the fs WRITE
    // pair -> silently dropped (the only writer on the compile path is the
    // persistent header/artifact cache, and dropping a cache write is
    // semantically a cache miss); profile-now-us -> 0 (no clock). Everything
    // else traps (`unreachable`) — those imports are dynamically dead per
    // the lifted entry's effect row, and trapping (instead of fabricating a
    // value) surfaces any violation of that proof immediately.
    if sn == "env-get" || sn == "fs_write_file" || sn == "fs_write_bytes" || sn == "profile-now-us" {
      // Match the import's declared result shape: nothing for void, a typed
      // zero otherwise (i64 for the raw ABI, i32 defensively).
      let sig = Array::get(vibe_sigs, bi)
      let pc = Array::get(sig, 0)
      let rc = Array::get(sig, 1 + pc)
      if rc >= 1 {
        if Array::get(sig, 2 + pc) == 127 {
          emit_i32_const(body, 0)
        } else {
          emit_i64_const(body, 0)
        }
      } else {
        ()
      }
    } else {
      bytebuf_push(body, 0)
    }
    Array::push(bodies, body)
    bi = bi + 1
  }
  emit_code_section(out, bodies)
  bytebuf_to_bytes(out)
}

fn comp_emit_string_handler_impl(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String], stub_vibe: Bool) -> Bytes with { Error } {
  let string_param_count = Array::length(param_names)
  // Validate the target export exists with the packed-string core signature.
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut target_sig_ok = false
  let mut target_found = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == target_func_name {
      target_found = true
      let sig = Array::get(export_type_sigs, ei)
      // sig = [param_count, params..., result_count, results...]. Core shape
      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.
      let core_param_count = string_param_count + 1
      if Array::length(sig) == (core_param_count + 3) {
        let mut ok = Array::get(sig, 0) == core_param_count
        let mut pi = 0
        while pi < core_param_count {
          if Array::get(sig, 1 + pi) != 126 {
            ok = false
          }
          pi = pi + 1
        }
        if Array::get(sig, 1 + core_param_count) != 1 {
          ok = false
        }
        if Array::get(sig, 2 + core_param_count) != 126 {
          ok = false
        }
        target_sig_ok = ok
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !target_found {
    throw("component: core module does not export '\{target_func_name}'")
  }
  if !target_sig_ok {
    throw("component: '\{target_func_name}' must take \{string_param_count} String params and return String")
  }
  // Reject host imports the stub cannot satisfy (stub_vibe additionally
  // hosts `vibe.*` imports with local stubs — see the _stubbed wrapper).
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let vibe_stub_names = array_empty()
  let vibe_stub_sigs = array_empty()
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if stub_vibe && im == "vibe" {
      Array::push(vibe_stub_names, ifn)
      Array::push(vibe_stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))
    } else {
      throw("component: handler uses host import '\{im}.\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)")
    }
    ii = ii + 1
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))
  emit_core_module_section(buf, comp_generate_host_stub_module(vibe_stub_names, vibe_stub_sigs))
  // core instance 0: host stub (module 2): fd_write (+ vibe.* stubs when
  // stub_vibe collected any)
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  // core instance 1: main (module 0), wasi_snapshot_preview1 / vibe satisfied
  // by the stub instance when the core imports them (an argument for an
  // import the module does not declare is legal and ignored).
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1",
    "vibe"
  ], [
    0,
    0
  ])
  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr
  emit_alias_section(buf, 1, [
    target_func_name
  ], [
    core_sort_func
  ])
  emit_alias_section(buf, 1, [
    "memory"
  ], [
    core_sort_mem
  ])
  emit_alias_section(buf, 1, [
    "__heap_ptr"
  ], [
    core_sort_global
  ])
  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [
    core_sort_func,
    core_sort_global,
    core_sort_mem
  ], [
    0,
    0,
    0
  ])
  // core instance 3: trampoline (module 1) with env
  emit_core_instance_instantiate_args(buf, 1, [
    "env"
  ], [
    2
  ])
  // core func 1 = canon_func, core func 2 = cabi_realloc
  emit_alias_section(buf, 3, [
    "canon_func",
    "cabi_realloc"
  ], [
    core_sort_func,
    core_sort_func
  ])
  // component type 0: (param_names: string...) -> string
  bytebuf_push(buf, section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(type_content, 1)
  let comp_param_types = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_types, comp_valtype_string)
    pt = pt + 1
  }
  emit_comp_func_type(type_content, comp_param_types, param_names, [
    comp_valtype_string
  ], 0)
  emit_raw_content(buf, type_content)
  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)
  bytebuf_push(buf, section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(canon_content, 1)
  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)
  emit_raw_content(buf, canon_content)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

// ============================================================================
// #1109-2 (vibec-hosted, the vfs face of #857): component whose FILESYSTEM
// comes from a WIT-imported vfs interface. The core's `vibe.fs_*` host
// imports are routed to canon-LOWERED component imports:
//
//   import read-file:  func(path: string) -> string
//   import exists:     func(path: string) -> bool
//   import read-dir:   func(path: string) -> string   (newline-joined names)
//   import stat-token: func(path: string) -> s64      (-1 = non-regular)
//
// Instantiation is circular on paper (main imports vfs; lowering vfs needs
// main's memory), so we break it with wit-component's shim/fixup dance:
//   shim (table + raw-sig forwarders) -> main(vibe=shim+stubs) -> alias
//   memory/__heap_ptr -> realloc module -> canon lower (memory+realloc) ->
//   adapter module (raw i64 <-> canonical ptr/len trampolines) whose ACTIVE
//   ELEMENT segment plants its impls into the shim's table.
// The compile-face export is lifted exactly like the string handler.
// ============================================================================

/// Raw-sig forwarder module: table 4 funcref (exported "t") + one (i64)->i64
/// forwarder per vfs function, each `call_indirect` through its fixed slot
/// (0 read_file, 1 exists, 2 read_dir, 3 stat_token). Slots are planted later
/// by the adapter module's active element segment.
fn comp_generate_vfs_shim() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [
    0,
    0,
    0,
    0
  ])
  let table_sec = bytebuf_new()
  leb128_encode_u32(table_sec, 1)
  bytebuf_push(table_sec, 112)
  bytebuf_push(table_sec, 0)
  leb128_encode_u32(table_sec, 4)
  bytebuf_push_section(out, 4, table_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 5)
  emit_name(export_sec, "fs_read_file")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 0)
  emit_name(export_sec, "fs_exists")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, "fs_read_dir")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "fs_stat_token")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 3)
  emit_name(export_sec, "t")
  bytebuf_push(export_sec, 1)
  leb128_encode_u32(export_sec, 0)
  bytebuf_push_section(out, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 4)
  let mut slot = 0
  while slot < 4 {
    let body = bytebuf_new()
    leb128_encode_u32(body, 0)
    emit_local_get(body, 0)
    emit_i32_const(body, slot)
    bytebuf_push(body, 17)
    leb128_encode_u32(body, 0)
    leb128_encode_u32(body, 0)
    bytebuf_push(body, 11)
    leb128_encode_u32(code_sec, Bytes::length(body))
    bytebuf_push_buf(code_sec, body)
    slot = slot + 1
  }
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// Standalone bump cabi_realloc over the MAIN module's memory + __heap_ptr
/// (imported as env.*) — the same body comp_generate_string_trampoline_packed
/// embeds, needed here BEFORE the trampoline exists because the canon-lowered
/// vfs imports allocate their result strings through it.
fn comp_generate_vfs_realloc() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, tc)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 2)
  emit_name(import_sec, "env")
  emit_name(import_sec, "__heap_ptr")
  bytebuf_push(import_sec, 3)
  bytebuf_push(import_sec, 127)
  bytebuf_push(import_sec, 1)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(out, 2, import_sec)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "cabi_realloc", 0)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let realloc_body = bytebuf_new()
  leb128_encode_u32(realloc_body, 1)
  leb128_encode_u32(realloc_body, 1)
  bytebuf_push(realloc_body, 127)
  // Unlike the trampoline's realloc (which only ever serves its own 8-byte
  // retptr), THIS one is the canonical-lowering allocator for vfs result
  // strings, which request align=1/exact length — and the raw ABI requires
  // __heap_ptr to STAY 8-aligned (heap pointers carry low-bit tags; an
  // unaligned bump poisons every later allocation into "tagged" garbage).
  // So: p = (heap + 7) & ~7; heap = p + ((new_size + 7) & ~7).
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 7)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, -8)
  bytebuf_push(realloc_body, 113)
  emit_local_set(realloc_body, 4)
  emit_local_get(realloc_body, 4)
  emit_local_get(realloc_body, 3)
  emit_i32_const(realloc_body, 7)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, -8)
  bytebuf_push(realloc_body, 113)
  emit_i32_add(realloc_body)
  bytebuf_push(realloc_body, 36)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 116)
  bytebuf_push(realloc_body, 75)
  bytebuf_push(realloc_body, 4)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 65535)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 118)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 26)
  bytebuf_push(realloc_body, 11)
  emit_local_get(realloc_body, 4)
  bytebuf_push(realloc_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(realloc_body))
  bytebuf_push_buf(code_sec, realloc_body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// Adapter/fixup module: converts the raw ABI ((ptr<<32)|len i64 strings) to
/// the canonical lowered signatures and plants its impls into the shim's
/// table via an active element segment at instantiation time.
fn comp_generate_vfs_adapter() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 = (i32,i32,i32)->() lowered string->string
  //        1 = (i32,i32)->i32   lowered string->bool
  //        2 = (i32,i32)->i64   lowered string->s64
  //        3 = (i64)->i64       raw impls
  //        4 = (i32 x4)->i32    cabi_realloc
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 5)
  emit_func_type_raw(tc, [
    127,
    127,
    127
  ], array_empty())
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    127,
    127
  ], [
    126
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, tc)
  // imports: vfs.read-file f0 t0, vfs.exists f1 t1, vfs.read-dir f2 t0,
  // vfs.stat-token f3 t2, env.cabi_realloc f4 t4, env.memory, env.t (table)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 7)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "read-file")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "exists")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 1)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "read-dir")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "stat-token")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 2)
  emit_name(import_sec, "env")
  emit_name(import_sec, "cabi_realloc")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 4)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "t")
  bytebuf_push(import_sec, 1)
  bytebuf_push(import_sec, 112)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 4)
  bytebuf_push_section(out, 2, import_sec)
  // funcs: f5 impl_read_file, f6 impl_exists, f7 impl_read_dir, f8 impl_stat
  emit_function_section(out, [
    3,
    3,
    3,
    3
  ])
  // active elem: table 0 offset 0 -> [f5, f6, f7, f8]
  let elem_sec = bytebuf_new()
  leb128_encode_u32(elem_sec, 1)
  bytebuf_push(elem_sec, 0)
  emit_i32_const(elem_sec, 0)
  bytebuf_push(elem_sec, 11)
  leb128_encode_u32(elem_sec, 4)
  leb128_encode_u32(elem_sec, 5)
  leb128_encode_u32(elem_sec, 6)
  leb128_encode_u32(elem_sec, 7)
  leb128_encode_u32(elem_sec, 8)
  bytebuf_push_section(out, 9, elem_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 4)
  // impl_read_file / impl_read_dir (string result via retptr)
  let mut sri = 0
  while sri < 2 {
    let body = bytebuf_new()
    leb128_encode_u32(body, 1)
    leb128_encode_u32(body, 1)
    bytebuf_push(body, 127)
    // retptr = cabi_realloc(0,0,4,8)
    emit_i32_const(body, 0)
    emit_i32_const(body, 0)
    emit_i32_const(body, 4)
    emit_i32_const(body, 8)
    bytebuf_push(body, 16)
    leb128_encode_u32(body, 4)
    emit_local_set(body, 1)
    // ptr = wrap(arg >> 32); len = wrap(arg)
    emit_local_get(body, 0)
    emit_i64_const(body, 32)
    bytebuf_push(body, 136)
    bytebuf_push(body, 167)
    emit_local_get(body, 0)
    bytebuf_push(body, 167)
    emit_local_get(body, 1)
    bytebuf_push(body, 16)
    leb128_encode_u32(body, if sri == 0 {
      0
    } else {
      2
    })
    // (extend_u([retptr]) << 32) | extend_u([retptr+4])
    emit_local_get(body, 1)
    bytebuf_push(body, 40)
    leb128_encode_u32(body, 2)
    leb128_encode_u32(body, 0)
    bytebuf_push(body, 173)
    emit_i64_const(body, 32)
    bytebuf_push(body, 134)
    emit_local_get(body, 1)
    bytebuf_push(body, 40)
    leb128_encode_u32(body, 2)
    leb128_encode_u32(body, 4)
    bytebuf_push(body, 173)
    bytebuf_push(body, 132)
    bytebuf_push(body, 11)
    // impl order in the code section is f5(read_file), f6(exists),
    // f7(read_dir), f8(stat) — emit exists between the two string impls.
    if sri == 0 {
      leb128_encode_u32(code_sec, Bytes::length(body))
      bytebuf_push_buf(code_sec, body)
      let exists_body = bytebuf_new()
      leb128_encode_u32(exists_body, 0)
      emit_local_get(exists_body, 0)
      emit_i64_const(exists_body, 32)
      bytebuf_push(exists_body, 136)
      bytebuf_push(exists_body, 167)
      emit_local_get(exists_body, 0)
      bytebuf_push(exists_body, 167)
      bytebuf_push(exists_body, 16)
      leb128_encode_u32(exists_body, 1)
      bytebuf_push(exists_body, 173)
      bytebuf_push(exists_body, 11)
      leb128_encode_u32(code_sec, Bytes::length(exists_body))
      bytebuf_push_buf(code_sec, exists_body)
    } else {
      leb128_encode_u32(code_sec, Bytes::length(body))
      bytebuf_push_buf(code_sec, body)
      let stat_body = bytebuf_new()
      leb128_encode_u32(stat_body, 0)
      emit_local_get(stat_body, 0)
      emit_i64_const(stat_body, 32)
      bytebuf_push(stat_body, 136)
      bytebuf_push(stat_body, 167)
      emit_local_get(stat_body, 0)
      bytebuf_push(stat_body, 167)
      bytebuf_push(stat_body, 16)
      leb128_encode_u32(stat_body, 3)
      bytebuf_push(stat_body, 11)
      leb128_encode_u32(code_sec, Bytes::length(stat_body))
      bytebuf_push_buf(code_sec, stat_body)
    }
    sri = sri + 1
  }
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

export fn comp_emit_component_wasm_string_handler_vfs(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {
  let string_param_count = Array::length(param_names)
  // Validate the target export exists with the packed-string core signature
  // (same contract as comp_emit_string_handler_impl).
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut target_sig_ok = false
  let mut target_found = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == target_func_name {
      target_found = true
      let sig = Array::get(export_type_sigs, ei)
      let core_param_count = string_param_count + 1
      if Array::length(sig) == (core_param_count + 3) {
        let mut ok = Array::get(sig, 0) == core_param_count
        let mut pi = 0
        while pi < core_param_count {
          if Array::get(sig, 1 + pi) != 126 {
            ok = false
          }
          pi = pi + 1
        }
        if Array::get(sig, 1 + core_param_count) != 1 {
          ok = false
        }
        if Array::get(sig, 2 + core_param_count) != 126 {
          ok = false
        }
        target_sig_ok = ok
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !target_found {
    throw("component(vfs): core module does not export '\{target_func_name}'")
  }
  if !target_sig_ok {
    throw("component(vfs): '\{target_func_name}' must take \{string_param_count} String params and return String")
  }
  // Classify the core's imports: the four fs_* vfs functions route to the
  // shim, every other vibe.* import gets a local stub, fd_write is the
  // usual wasi stub, anything else is rejected.
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let vibe_import_names = array_empty()
  let stub_names = array_empty()
  let stub_sigs = array_empty()
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if im == "vibe" {
      Array::push(vibe_import_names, ifn)
      if ifn == "fs_read_file" || ifn == "fs_exists" || ifn == "fs_read_dir" || ifn == "fs_stat_token" {
        ()
      } else {
        Array::push(stub_names, ifn)
        Array::push(stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))
      }
    } else {
      throw("component(vfs): unsupported host import '\{im}.\{ifn}'")
    }
    ii = ii + 1
  }
  let stub_count = Array::length(stub_names)
  // Core func index plan (aliases + lowers appear in emission order):
  //   0..3            shim forwarders (fs_read_file/exists/read_dir/stat_token)
  //   4..3+S          stub funcs
  //   4+S             target func (from main)
  //   5+S             vfs cabi_realloc (realloc module)
  //   6+S..9+S        canon-lowered vfs imports
  //   10+S, 11+S      trampoline canon_func + trampoline cabi_realloc
  let f_target = 4 + stub_count
  let f_realloc = 5 + stub_count
  let f_lower0 = 6 + stub_count
  let f_canon = 10 + stub_count
  let f_tramp_realloc = 11 + stub_count
  let buf = bytebuf_new()
  emit_component_header(buf)
  // S1: component types 0-3 for the vfs imports.
  bytebuf_push(buf, section_type)
  let vfs_types = bytebuf_new()
  leb128_encode_u32(vfs_types, 4)
  let path_param = array_empty()
  Array::push(path_param, "path")
  emit_comp_func_type(vfs_types, [
    comp_valtype_string
  ], path_param, [
    comp_valtype_string
  ], 0)
  emit_comp_func_type(vfs_types, [
    comp_valtype_string
  ], path_param, [
    comp_valtype_bool
  ], 0)
  emit_comp_func_type(vfs_types, [
    comp_valtype_string
  ], path_param, [
    comp_valtype_string
  ], 0)
  emit_comp_func_type(vfs_types, [
    comp_valtype_string
  ], path_param, [
    comp_valtype_s64
  ], 0)
  emit_raw_content(buf, vfs_types)
  // S2: component imports read-file/exists/read-dir/stat-token -> funcs 0-3.
  let vfs_import_names = array_empty()
  Array::push(vfs_import_names, "read-file")
  Array::push(vfs_import_names, "exists")
  Array::push(vfs_import_names, "read-dir")
  Array::push(vfs_import_names, "stat-token")
  emit_comp_import_section(buf, vfs_import_names, 4)
  // S3-S8: core modules 0..5.
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))
  emit_core_module_section(buf, comp_generate_host_stub_module(stub_names, stub_sigs))
  emit_core_module_section(buf, comp_generate_vfs_shim())
  emit_core_module_section(buf, comp_generate_vfs_realloc())
  emit_core_module_section(buf, comp_generate_vfs_adapter())
  // S9: instance 0 = stub, S10: instance 1 = shim.
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  emit_core_instance_instantiate_section(buf, 3, array_empty())
  // S11: alias the shim forwarders (core funcs 0-3).
  let shim_fn_names = array_empty()
  Array::push(shim_fn_names, "fs_read_file")
  Array::push(shim_fn_names, "fs_exists")
  Array::push(shim_fn_names, "fs_read_dir")
  Array::push(shim_fn_names, "fs_stat_token")
  emit_alias_section(buf, 1, shim_fn_names, [
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func
  ])
  // S12: alias the stub funcs (core funcs 4..3+S).
  let stub_sorts = new_int_array()
  let mut ssi = 0
  while ssi < stub_count {
    Array::push(stub_sorts, core_sort_func)
    ssi = ssi + 1
  }
  emit_alias_section(buf, 0, stub_names, stub_sorts)
  // S13: synthetic "vibe" instance covering every vibe.* import of the core.
  let vibe_inst_names = array_empty()
  let vibe_inst_sorts = new_int_array()
  let vibe_inst_indices = new_int_array()
  let mut vi = 0
  while vi < Array::length(vibe_import_names) {
    let vn = Array::get(vibe_import_names, vi)
    Array::push(vibe_inst_names, vn)
    Array::push(vibe_inst_sorts, core_sort_func)
    if vn == "fs_read_file" {
      Array::push(vibe_inst_indices, 0)
    } else if vn == "fs_exists" {
      Array::push(vibe_inst_indices, 1)
    } else if vn == "fs_read_dir" {
      Array::push(vibe_inst_indices, 2)
    } else if vn == "fs_stat_token" {
      Array::push(vibe_inst_indices, 3)
    } else {
      let mut sj = 0
      let mut found_at = -1
      while sj < stub_count {
        if Array::get(stub_names, sj) == vn && found_at == -1 {
          found_at = sj
        }
        sj = sj + 1
      }
      Array::push(vibe_inst_indices, 4 + found_at)
    }
    vi = vi + 1
  }
  emit_core_instance_from_exports_sorted(buf, vibe_inst_names, vibe_inst_sorts, vibe_inst_indices)
  // S14: instance 3 = main, wasi from the stub instance, vibe from instance 2.
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1",
    "vibe"
  ], [
    0,
    2
  ])
  // S15: alias target func + memory + __heap_ptr from main (instance 3).
  let main_alias_names = array_empty()
  Array::push(main_alias_names, target_func_name)
  Array::push(main_alias_names, "memory")
  Array::push(main_alias_names, "__heap_ptr")
  emit_alias_section(buf, 3, main_alias_names, [
    core_sort_func,
    core_sort_mem,
    core_sort_global
  ])
  // S16/S17: realloc env (instance 4) + realloc module (instance 5).
  let renv_names = array_empty()
  Array::push(renv_names, "__heap_ptr")
  Array::push(renv_names, "memory")
  emit_core_instance_from_exports_sorted(buf, renv_names, [
    core_sort_global,
    core_sort_mem
  ], [
    0,
    0
  ])
  emit_core_instance_instantiate_args(buf, 4, [
    "env"
  ], [
    4
  ])
  // S18: alias cabi_realloc (core func 5+S) from instance 5.
  let realloc_names = array_empty()
  Array::push(realloc_names, "cabi_realloc")
  emit_alias_section(buf, 5, realloc_names, [
    core_sort_func
  ])
  // S19: canon lower the four vfs imports (core funcs 6+S..9+S). String
  // results (read-file/read-dir) need memory + realloc; the scalar-result
  // ones need memory only (their string PARAM is read out of core memory).
  bytebuf_push(buf, section_canon)
  let lower_content = bytebuf_new()
  leb128_encode_u32(lower_content, 4)
  let mut li = 0
  while li < 4 {
    bytebuf_push(lower_content, 1)
    bytebuf_push(lower_content, 0)
    leb128_encode_u32(lower_content, li)
    if li == 0 || li == 2 {
      leb128_encode_u32(lower_content, 3)
      bytebuf_push(lower_content, 0)
      bytebuf_push(lower_content, 3)
      leb128_encode_u32(lower_content, 0)
      bytebuf_push(lower_content, 4)
      leb128_encode_u32(lower_content, f_realloc)
    } else {
      leb128_encode_u32(lower_content, 2)
      bytebuf_push(lower_content, 0)
      bytebuf_push(lower_content, 3)
      leb128_encode_u32(lower_content, 0)
    }
    li = li + 1
  }
  emit_raw_content(buf, lower_content)
  // S20: alias the shim's table (table 0).
  let table_names = array_empty()
  Array::push(table_names, "t")
  emit_alias_section(buf, 1, table_names, [
    1
  ])
  // S21: synthetic "vfs" instance of the lowered funcs (instance 6).
  let vfs_inst_names = array_empty()
  Array::push(vfs_inst_names, "read-file")
  Array::push(vfs_inst_names, "exists")
  Array::push(vfs_inst_names, "read-dir")
  Array::push(vfs_inst_names, "stat-token")
  emit_core_instance_from_exports_sorted(buf, vfs_inst_names, [
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func
  ], [
    f_lower0,
    f_lower0 + 1,
    f_lower0 + 2,
    f_lower0 + 3
  ])
  // S22: synthetic adapter env {cabi_realloc, memory, t} (instance 7).
  let aenv_names = array_empty()
  Array::push(aenv_names, "cabi_realloc")
  Array::push(aenv_names, "memory")
  Array::push(aenv_names, "t")
  emit_core_instance_from_exports_sorted(buf, aenv_names, [
    core_sort_func,
    core_sort_mem,
    1
  ], [
    f_realloc,
    0,
    0
  ])
  // S23: instance 8 = adapter (fixup: its active elem plants the impls).
  emit_core_instance_instantiate_args(buf, 5, [
    "vfs",
    "env"
  ], [
    6,
    7
  ])
  // S24: synthetic trampoline env (instance 9).
  let tenv_names = array_empty()
  Array::push(tenv_names, "target_func")
  Array::push(tenv_names, "__heap_ptr")
  Array::push(tenv_names, "memory")
  emit_core_instance_from_exports_sorted(buf, tenv_names, [
    core_sort_func,
    core_sort_global,
    core_sort_mem
  ], [
    f_target,
    0,
    0
  ])
  // S25: instance 10 = trampoline; S26: alias canon_func + its realloc.
  emit_core_instance_instantiate_args(buf, 1, [
    "env"
  ], [
    9
  ])
  let tramp_names = array_empty()
  Array::push(tramp_names, "canon_func")
  Array::push(tramp_names, "cabi_realloc")
  emit_alias_section(buf, 10, tramp_names, [
    core_sort_func,
    core_sort_func
  ])
  // S27: component type 4 = the export's (string...) -> string.
  bytebuf_push(buf, section_type)
  let export_type = bytebuf_new()
  leb128_encode_u32(export_type, 1)
  let comp_param_types = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_types, comp_valtype_string)
    pt = pt + 1
  }
  emit_comp_func_type(export_type, comp_param_types, param_names, [
    comp_valtype_string
  ], 0)
  emit_raw_content(buf, export_type)
  // S28: canon lift (memory 0 + trampoline realloc); S29: export (comp func 4).
  bytebuf_push(buf, section_canon)
  let lift_content = bytebuf_new()
  leb128_encode_u32(lift_content, 1)
  emit_canon_lift_func(lift_content, f_canon, 4, 1, 0, f_tramp_realloc)
  emit_raw_content(buf, lift_content)
  emit_comp_export_section(buf, export_name, 4)
  bytebuf_to_bytes(buf)
}
