fn emit_canon_stream_drop_writable(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 20)
