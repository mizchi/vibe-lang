/// #2066: the service handler's export tail, after `main` is instantiated as
/// core instance `main_inst` and the next core func index is `next_func`.
/// It is the stream lane's export (comp_emit_component_wasm_stream_handler):
/// the handler's result string and lowered params live in MAIN's memory, so
/// `task.return` and the lift take main's memory (core memory 1; 0 is the
/// memhost page the canons use) and the trampoline's `cabi_realloc`, which
/// writes main's `__heap_ptr` back.
///
///   core func      next = alias(main, target), +1 = task.return (string),
///                  +2 = alias(trampoline, canon_func), +3 = cabi_realloc
///   core instance  main_inst+1 = env {target, __heap_ptr, memory},
///                  +2 = [export]$root, +3 = the trampoline (module 3)
export fn comp_emit_service_handler_export(buf: Bytes, main_inst: Int, next_func: Int, target_func_name: String, export_name: String, param_names: Array[String], stream_type_idx: Int, functype_idx: Int, comp_func_count: Int) -> Unit with Exception {
  let string_param_count = Array::length(param_names) - 1
  emit_alias_section(buf, main_inst, [target_func_name], [core_sort_func])
  emit_alias_section(buf, main_inst, ["memory"], [core_sort_mem])
  emit_alias_section(buf, main_inst, ["__heap_ptr"], [core_sort_global])
  let main_mem = 1
  emit_canon_task_return_opts(buf, comp_valtype_string, main_mem, true)
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [core_sort_func, core_sort_global, core_sort_mem], [next_func, 0, main_mem])
  emit_core_instance_from_exports(buf, 1, [1], [
    String::concat("[task-return]", export_name)
  ], [next_func + 1])
  emit_core_instance_instantiate_args(buf, 3, ["env", "[export]$root"], [
    main_inst + 1,
    main_inst + 2
  ])
  emit_alias_section(buf, main_inst + 3, ["canon_func", "cabi_realloc"], [
    core_sort_func,
    core_sort_func
  ])
  let comp_param_valtypes = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_valtypes, comp_valtype_string)
    pt = pt + 1
  }
  // The body param's valtype is the stream TYPE INDEX -- the same
  // `stream<u8>` the response bodies use, so one canon read serves both.
  Array::push(comp_param_valtypes, stream_type_idx)
  emit_comp_async_functype_params(buf, param_names, comp_param_valtypes, comp_valtype_string)
  emit_canon_lift_async_opts(buf, next_func + 2, functype_idx, main_mem, next_func + 3, true)
  emit_comp_export_section(buf, export_name, comp_func_count)
}

/// ADR-0089 step 2 (#1218): guest core module for the SELF-CONTAINED
/// stream<u8> round-trip -- a byte-level port of
/// tools/wasip3_component_probe/stream_value/component.wat's $guest. Same
/// single-task rendezvous as comp_generate_future_value_guest_core_module
/// (async read BLOCKED -> join -> async write completes eagerly -> wait ->
/// STREAM_READ), with the stream-specific differences: read/write carry an
/// element COUNT (core sig (handle, ptr, n) -> status), the completion
/// status packs (amount << 4) | code, and the expected event code is
/// STREAM_READ = 2. This probe/emitter pair moves exactly 1 element (the
/// byte 42).
///
/// Import func indices 0-9, local func 10 = `run` (exported):
/// 0=[stream-new-0]pipe, 1=[async-lower][stream-read-0]pipe,
/// 2=[async-lower][stream-write-0]pipe, 3=[stream-drop-readable-0]pipe,
/// 4=[stream-drop-writable-0]pipe, 5=[waitable-set-new],
/// 6=[waitable-join], 7=[waitable-set-wait], 8=[waitable-set-drop],
/// 9=[task-return]run. Memory layout: 0 = 1-byte read landing slot,
/// 4 = staged write byte, 16 = wait payload area. Diagnostics through
/// task.return: 1000 + low bits (read did not block), 2015 (write
/// blocked), 3000 + event code (not STREAM_READ).
fn comp_generate_stream_value_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 ()->(i64) stream.new; 1 (i32,i32,i32)->(i32)
  // stream.read/write; 2 (i32)->() drops & task_return; 3 ()->(i32)
  // ws_new; 4 (i32,i32)->() waitable_join; 5 ()->() run;
  // 6 (i32,i32)->(i32) ws_wait.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 7)
  emit_func_type_raw(tc, array_empty(), [126])
  emit_func_type_raw(tc, [127, 127, 127], [127])
  emit_func_type_raw(tc, [127], array_empty())
  emit_func_type_raw(tc, array_empty(), [127])
  emit_func_type_raw(tc, [127, 127], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  emit_func_type_raw(tc, [127, 127], [127])
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 11)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-new-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][stream-read-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[async-lower][stream-write-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-drop-readable-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[stream-drop-writable-0]pipe")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-new]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 3)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-join]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 4)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-wait]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 6)
  emit_name(ic, "$root")
  emit_name(ic, "[waitable-set-drop]")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "[export]$root")
  emit_name(ic, "[task-return]run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "env")
  emit_name(ic, "memory")
  bytebuf_push(ic, 2)
  bytebuf_push(ic, 0)
  leb128_encode_u32(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [5])
  emit_export_section(out, "run", 10)
  // run's locals: 0=packed (i64), 1=readable, 2=writable, 3=st, 4=ws, 5=ev.
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let body = bytebuf_new()
  leb128_encode_u32(body, 2)
  leb128_encode_u32(body, 1)
  bytebuf_push(body, 126)
  leb128_encode_u32(body, 5)
  bytebuf_push(body, 127)
  // packed = stream.new(); readable = low 32 bits, writable = high 32.
  emit_call(body, 0)
  emit_local_set(body, 0)
  emit_local_get(body, 0)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 1)
  emit_local_get(body, 0)
  emit_i64_const(body, 32)
  emit_i64_shr_s(body)
  emit_i32_wrap_i64(body)
  emit_local_set(body, 2)
  // stage the byte to send: mem[4] = 42
  emit_i32_const(body, 4)
  emit_i32_const(body, 42)
  emit_i32_store8(body, 0, 0)
  // st = stream.read(readable, 0, 1) -- must block (no writer yet)
  emit_local_get(body, 1)
  emit_i32_const(body, 0)
  emit_i32_const(body, 1)
  emit_call(body, 1)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 1000)
  emit_local_get(body, 3)
  emit_i32_const(body, 15)
  emit_i32_and(body)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // register the pending read's waitable before writing
  emit_call(body, 5)
  emit_local_set(body, 4)
  emit_local_get(body, 1)
  emit_local_get(body, 4)
  emit_call(body, 6)
  // st = stream.write(writable, 4, 1) -- copies against the pending read
  emit_local_get(body, 2)
  emit_i32_const(body, 4)
  emit_i32_const(body, 1)
  emit_call(body, 2)
  emit_local_set(body, 3)
  emit_local_get(body, 3)
  emit_i32_const(body, -1)
  emit_i32_eq(body)
  emit_if_void(body)
  emit_i32_const(body, 2015)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // collect the pending read's completion event (STREAM_READ = 2)
  emit_local_get(body, 4)
  emit_i32_const(body, 16)
  emit_call(body, 7)
  emit_local_set(body, 5)
  emit_local_get(body, 5)
  emit_i32_const(body, 2)
  emit_i32_ne(body)
  emit_if_void(body)
  emit_i32_const(body, 3000)
  emit_local_get(body, 5)
  emit_i32_add(body)
  emit_call(body, 9)
  emit_return(body)
  emit_end(body)
  // teardown (ends before the set), then return the delivered byte
  emit_local_get(body, 1)
  emit_call(body, 3)
  emit_local_get(body, 2)
  emit_call(body, 4)
  emit_local_get(body, 4)
  emit_call(body, 8)
  emit_i32_const(body, 0)
  emit_i32_load8_u(body, 0, 0)
  emit_call(body, 9)
  bytebuf_push(body, 11)
  leb128_encode_u32(code_sec, Bytes::length(body))
  bytebuf_push_buf(code_sec, body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// ADR-0089 step 2 (#1218): fixed-shape component exercising the literal
/// `stream.*` canonical built-ins end to end -- the stream twin of
/// comp_emit_component_wasm_future_value, byte-verified against
/// tools/wasip3_component_probe/stream_value/component.wat (wasmtime 47,
/// returns 42 with -W component-model-more-async-builtins=y). Identical
/// composition and index layout; the differences are the (stream u8)
/// component type (elem = comp_valtype_u8 -- the ByteStream element type,
/// NOT the task.return result type, which stays u32) and the stream guest
/// module. Gate: scripts/test_stream_value_component_gate.sh.
export fn comp_emit_component_wasm_stream_value(export_name: String, comp_result_valtype: Int) -> Bytes with Exception {
  if comp_result_valtype != comp_valtype_u32 {
    throw("component(stream-value): only comp_valtype_u32 (\{comp_valtype_u32}) is supported, got \{comp_result_valtype} -- the guest core module is hard-coded to a u8 element and an i32-shaped result")
  }
  else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, comp_generate_stream_value_guest_core_module())
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, ["memory"], [core_sort_mem])
  let stream_type_idx = 0
  emit_comp_stream_type_section(buf, comp_valtype_u8)
  emit_canon_stream_new(buf, stream_type_idx)
  emit_canon_stream_read(buf, stream_type_idx, mem_alias_idx)
  emit_canon_stream_write(buf, stream_type_idx, mem_alias_idx)
  emit_canon_stream_drop_readable(buf, stream_type_idx)
  emit_canon_stream_drop_writable(buf, stream_type_idx)
  emit_canon_task_return(buf, comp_result_valtype)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [9], [
    "[stream-new-0]pipe",
    "[async-lower][stream-read-0]pipe",
    "[async-lower][stream-write-0]pipe",
    "[stream-drop-readable-0]pipe",
    "[stream-drop-writable-0]pipe",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [0, 1, 2, 3, 4, 6, 7, 8, 9])
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [1], ["[task-return]run"], [5])
  emit_core_instance_from_exports_sorted(buf, ["memory"], [core_sort_mem], [
    mem_alias_idx
  ])
  let env_inst = 3
  let guest_inst = 4
  emit_core_instance_instantiate_args(buf, 0, ["$root", "[export]$root", "env"], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  let run_func_alias_idx = 10
  emit_alias_section(buf, guest_inst, ["run"], [core_sort_func])
  emit_canon_lift_async_section(buf, run_func_alias_idx, 1)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

/// #537: core:sort for globals (func=0, table=1, mem=2, global=3).
export let core_sort_global: Int = 3

/// #537: from-exports core instance with per-item sorts (the older
/// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string
/// env instance also carries the main memory and the __heap_ptr global).
export fn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 1)
  leb128_encode_u32(content, Array::length(names))
  let mut i = 0
  while i < Array::length(names) {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, Array::get(sorts, i))
    leb128_encode_u32(content, Array::get(indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}

/// #1540 scope 4: the ASYNC twin of `comp_generate_string_trampoline_packed`.
///
/// Same job -- turn the canonical ABI's (ptr, len) pairs into packed vibe
/// string values, call the handler, hand the result back -- with the one
/// difference an async lift forces: the core function returns NOTHING and the
/// result leaves through `task.return`, so there is no return area to allocate
/// and no retptr to hand back.
///
/// `cabi_realloc` stays, because the LIFT still needs it to lower the caller's
/// string params into the main memory. Only the result path changes.
///
/// Imports (func 0 = target_func, func 1 = task-return), then local funcs
/// 2 = canon_func and 3 = cabi_realloc -- the extra import shifts every call
/// index by one against the sync trampoline, which is why this is a separate
/// generator rather than a flag on that one.
fn comp_generate_string_trampoline_packed_async(string_param_count: Int, export_name: String) -> Bytes {
  comp_generate_string_trampoline_packed_async_opt(string_param_count, export_name, false)
}

/// #1540 scope 3: the same trampoline, with an optional trailing STREAM
/// parameter.
///
/// The canonical ABI flattens a `stream<u8>` param to ONE i32 handle after the
/// strings' (ptr, len) pairs (measured: tools/wasip3_component_probe/
/// http_body_read). vibe sees it as a `HostStream`, whose cell the lowering
/// prelude builds from the bare handle -- so what the handler's core function
/// wants in that slot is the handle as a TAGGED vibe Int.
///
/// Tagging is `<< 1`, because the host-stream adapter untags with `param >> 1`
/// before using the handle. Getting it wrong hands every read a handle twice
/// or half the real one -- a wrong answer, not a trap.
export fn comp_generate_string_trampoline_packed_async_opt(string_param_count: Int, export_name: String, stream_param: Bool) -> Bytes {
  let buf = bytebuf_new()
  emit_header(buf)
  // types: 0 = target_func (i64 x N+1) -> i64; 1 = canon_func (i32 x 2N) -> ();
  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32; 3 = task.return (i32, i32) -> ()
  let type_sec = bytebuf_new()
  bytebuf_push_vec_header(type_sec, 4)
  let target_i64_count = if stream_param {
    string_param_count + 2
  } else {
    string_param_count + 1
  }
  let canon_i32_count = if stream_param {
    (string_param_count * 2) + 1
  } else {
    string_param_count * 2
  }
  emit_func_type_raw(type_sec, comp_repeat_valtype(126, target_i64_count), [126])
  emit_func_type_raw(type_sec, comp_repeat_valtype(127, canon_i32_count), array_empty())
  emit_func_type_raw(type_sec, comp_repeat_valtype(127, 4), [127])
  emit_func_type_raw(type_sec, comp_repeat_valtype(127, 2), array_empty())
  bytebuf_push_section(buf, 1, type_sec)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 4)
  emit_name(import_sec, "env")
  emit_name(import_sec, "target_func")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "[export]$root")
  emit_name(import_sec, String::concat("[task-return]", export_name))
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 3)
  emit_name(import_sec, "env")
  emit_name(import_sec, "__heap_ptr")
  bytebuf_push(import_sec, 3)
  bytebuf_push(import_sec, 127)
  bytebuf_push(import_sec, 1)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(buf, 2, import_sec)
  let func_sec = bytebuf_new()
  leb128_encode_u32(func_sec, 2)
  leb128_encode_u32(func_sec, 1)
  leb128_encode_u32(func_sec, 2)
  bytebuf_push_section(buf, 3, func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "canon_func")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "cabi_realloc")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 3)
  bytebuf_push_section(buf, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 2)
  // canon_func: params 0..2N-1 (i32), local 2N = the packed result (i64).
  let canon_body = bytebuf_new()
  leb128_encode_u32(canon_body, 1)
  leb128_encode_u32(canon_body, 1)
  bytebuf_push(canon_body, 126)
  let result_local = canon_i32_count
  let mut si = 0
  while si < string_param_count {
    // (extend_u(ptr) << 32) | extend_u(len)
    emit_local_get(canon_body, si * 2)
    bytebuf_push(canon_body, 173)
    emit_i64_const(canon_body, 32)
    bytebuf_push(canon_body, 134)
    emit_local_get(canon_body, (si * 2) + 1)
    bytebuf_push(canon_body, 173)
    bytebuf_push(canon_body, 132)
    si = si + 1
  }
  if stream_param {
    // The stream handle as a PLAIN i64 -- zero-extended, NOT tagged.
    //
    // `vibe.*` Int imports are usually described as "guest-tagged on the
    // wire", and that is true of the lane those words were written for: the
    // named-host-stream adapter talks to a core the CLI compiled with RC on,
    // where an Int is `value << 1` (linked_compile's tag_mode). THIS lane's
    // core is compiled by `compile_release_file_mode(.., "release")` ->
    // `compile_wasi_module_no_dce_impl`, which passes enable_rc = false, so
    // an Int here is a plain i64. Tagging the handle would hand the guest
    // twice the handle it must hand back.
    emit_local_get(canon_body, string_param_count * 2)
    bytebuf_push(canon_body, 173)
  } else {
    ()
  }
  // Trailing closure-env argument (0 for a top-level function).
  emit_i64_const(canon_body, 0)
  emit_call(canon_body, 0)
  emit_local_set(canon_body, result_local)
  // task.return(ptr, len) -- the two halves of the packed string value, which
  // already point into the main memory the canon lifts from. Nothing is
  // copied and nothing is allocated: this is the whole reason the async shape
  // needs no return area.
  emit_local_get(canon_body, result_local)
  emit_i64_const(canon_body, 32)
  bytebuf_push(canon_body, 136)
  bytebuf_push(canon_body, 167)
  emit_local_get(canon_body, result_local)
  bytebuf_push(canon_body, 167)
  emit_call(canon_body, 1)
  bytebuf_push(canon_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(canon_body))
  bytebuf_push_buf(code_sec, canon_body)
  bytebuf_push_buf(code_sec, comp_generate_bump_realloc_body())
  bytebuf_push_section(buf, 10, code_sec)
  bytebuf_to_bytes(buf)
}

/// #1540 scope 3: byte-shape fixture for the stream-parameter trampoline.
///
/// Exists because the stream slot cannot be checked any other way yet: nothing
/// assembles this trampoline into a component until the host-stream adapter is
/// wired into the serve lane, and by then a wrong tag would be a wrong ANSWER
/// (every read seeing half or twice the real handle) rather than a trap.
export fn comp_emit_stream_trampoline_fixture(string_param_count: Int) -> Bytes {
  comp_generate_string_trampoline_packed_async_opt(string_param_count, "handler", true)
}

/// #537: wrap a compiled core module into a component exporting
///   <export_name> : func(<param_names>: string, ...) -> string
/// via the packed-string trampoline above. This is the replacement
/// for the retired host's `--compose-p3` handler-side componentization: the
/// result plugs into the P3 HTTP adapter's `import handler: func(method, url,
/// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).
///
/// The core module must export `target_func_name` with signature
/// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and
/// `__heap_ptr` (any normal non-library compile does). Host imports
/// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are
/// rejected: a serve handler must be a pure function of its request params.
export fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, false)
}

/// #1107 Phase 5 (vibec, the implementation shape of #857): like
/// comp_emit_component_wasm_string_handler, but SATISFIES the core's `vibe.*`
/// host imports with local stubs instead of rejecting them — `env-get` returns
/// the raw-ABI empty string (i64 0 = ptr 0 / len 0, i.e. "unset", the same
/// value an unset variable yields on a real host) and every other `vibe.*`
/// import traps (`unreachable`). Intended for cores whose lifted entry's
/// effect row proves those imports dynamically unreachable: the vibec core's
/// `compile_cli_request` carries no Env/Fs row (sources arrive inline, output
/// leaves as hex chunks), so its `vibe.env-get`/`vibe.fs_*` imports exist only
/// because SIBLING exports of the library build reference them. The serve
/// path stays on the strict-reject variant above so an impure handler still
/// fails at componentize time, not at runtime.
export fn comp_emit_component_wasm_string_handler_stubbed(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, true)
}

/// The plain stream lane's `vibe` instance supplies the body reader and
/// nothing else. A core importing anything more (a sleep, a host stream by
/// name) used to compose into a component that failed validation while the
/// build reported success; name the import instead (#2066).
export fn comp_check_stream_handler_vibe_imports(core_wasm: Bytes) -> Unit with Exception {
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut i = 0
  while i < count {
    let m = Array::get(imp_modules, i)
    let n = Array::get(imp_names, i)
    if m == "vibe" && n != "host_stream_read" && n != "host_stream_close" {
      throw("component(async-stream-handler): the handler uses host import 'vibe.\{n}', which `vibe serve` cannot provide; a serve handler may read its body and await WIT responses (`from_wit` bindings), nothing else yet")
    } else {
      ()
    }
    i = i + 1
  }
}

/// #1540 scope 4: the stream handler's target-export contract.
///
/// Same as the string handler's, plus one: the core signature carries an extra
/// i64 for the stream handle. Every param is an i64 either way, so what this
/// really pins is the COUNT -- and getting it wrong would hand the handler a
/// shifted argument list rather than fail.
export fn comp_check_stream_handler_target(core_wasm: Bytes, target_func_name: String, string_param_count: Int) -> Unit with Exception {
  comp_check_string_handler_target(core_wasm, target_func_name, string_param_count + 1)
}

/// #1540 scope 4: the ASYNC serve component -- same handler surface as
/// `comp_emit_component_wasm_string_handler`, lifted async so the handler may
/// suspend.
///
/// A handler that awaits anything (a sleep today, a body read next) cannot go
/// under the sync lift: it would have to return before it resumes. Async
/// lifting is what makes suspension expressible, and it moves the result off
/// the core function's return path onto `task.return`
/// (tools/wasip3_component_probe/async_string_lift).
///
/// There is NO instantiation cycle here, unlike the standalone async shapes:
/// `task.return` needs a memory, and the memory it needs belongs to the MAIN
/// core module, which does not import `[task-return]` -- only the trampoline
/// does, and the trampoline is instantiated after it. That is why this lane
/// needs no memhost.
///
/// Index layout, in emission order:
///   core module    0 = main, 1 = async trampoline, 2 = host stub
///   core instance  0 = stub, 1 = main, 2 = env {target, __heap_ptr, memory},
///                  3 = [export]$root (task-return), 4 = trampoline
///   core func      0 = alias(main, target), 1 = task.return,
///                  2 = alias(trampoline, canon_func),
///                  3 = alias(trampoline, cabi_realloc)
///   component type 0 = the async functype; component func 0 = the lift
export fn comp_emit_component_wasm_string_handler_async(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  let string_param_count = Array::length(param_names)
  comp_check_string_handler_target(core_wasm, target_func_name, string_param_count)
  let vibe_stub_names = array_empty()
  let vibe_stub_sigs = array_empty()
  comp_collect_handler_host_imports(core_wasm, true, vibe_stub_names, vibe_stub_sigs)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed_async(string_param_count, export_name))
  emit_core_module_section(buf, comp_generate_host_stub_module(vibe_stub_names, vibe_stub_sigs))
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    0,
    0
  ])
  emit_alias_section(buf, 1, [target_func_name], [core_sort_func])
  emit_alias_section(buf, 1, ["memory"], [core_sort_mem])
  emit_alias_section(buf, 1, ["__heap_ptr"], [core_sort_global])
  // task.return lifts the result OUT of the main memory, so it reads but never
  // allocates -- `realloc` on this built-in is a hard wasmtime error.
  emit_canon_task_return_opts(buf, comp_valtype_string, 0, true)
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [core_sort_func, core_sort_global, core_sort_mem], [0, 0, 0])
  emit_core_instance_from_exports(buf, 1, [1], [
    String::concat("[task-return]", export_name)
  ], [1])
  emit_core_instance_instantiate_args(buf, 1, ["env", "[export]$root"], [2, 3])
  emit_alias_section(buf, 4, ["canon_func", "cabi_realloc"], [
    core_sort_func,
    core_sort_func
  ])
  let comp_param_valtypes = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_valtypes, comp_valtype_string)
    pt = pt + 1
  }
  // The functype must ALSO be async: wasmtime rejects the `async` canonopt
  // against a sync one ("the `async` canonical option requires an async
  // function type").
  emit_comp_async_functype_params(buf, param_names, comp_param_valtypes, comp_valtype_string)
  emit_canon_lift_async_opts(buf, 2, 0, 0, 3, true)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

/// #1540: the packed-string handler's target-export contract, shared by the
/// sync and async serve lanes so they cannot disagree about what a handler is.
///
/// Core shape is `(i64 x N+1) -> i64`: one i64 per String param plus the
/// trailing closure-env param every top-level vibe function carries.
fn comp_check_string_handler_target(core_wasm: Bytes, target_func_name: String, string_param_count: Int) -> Unit with Exception {
  // Validate the target export exists with the packed-string core signature.
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut target_sig_ok = false
  let mut target_found = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == target_func_name {
      target_found = true
      let sig = Array::get(export_type_sigs, ei)
      // sig = [param_count, params..., result_count, results...]. Core shape
      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.
      let core_param_count = string_param_count + 1
      if Array::length(sig) == (core_param_count + 3) {
        let mut ok = Array::get(sig, 0) == core_param_count
        let mut pi = 0
        while pi < core_param_count {
          if Array::get(sig, 1 + pi) != 126 {
            ok = false
          }
          pi = pi + 1
        }
        if Array::get(sig, 1 + core_param_count) != 1 {
          ok = false
        }
        if Array::get(sig, 2 + core_param_count) != 126 {
          ok = false
        }
        target_sig_ok = ok
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !target_found {
    throw("component: core module does not export '\{target_func_name}'")
  }
  if !target_sig_ok {
    throw("component: '\{target_func_name}' must take \{string_param_count} String params and return String")
  }
}

/// #1540: the handler's host-import contract, shared by both serve lanes.
///
/// `fd_write` is the one host import a handler may keep (stdout). With
/// `stub_vibe`, `vibe.*` imports are collected for the local stub module
/// instead of rejected.
fn comp_collect_handler_host_imports(core_wasm: Bytes, stub_vibe: Bool, vibe_stub_names: Array[String], vibe_stub_sigs: Array[Array[Int]]) -> Unit with Exception {
  // Reject host imports the stub cannot satisfy (stub_vibe additionally
  // hosts `vibe.*` imports with local stubs — see the _stubbed wrapper).
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if stub_vibe && im == "vibe" {
      Array::push(vibe_stub_names, ifn)
      Array::push(vibe_stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))
    } else {
      throw("component: handler uses host import '\{im}.\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)")
    }
    ii = ii + 1
  }
}

fn comp_emit_string_handler_impl(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String], stub_vibe: Bool) -> Bytes with Exception {
  let string_param_count = Array::length(param_names)
  comp_check_string_handler_target(core_wasm, target_func_name, string_param_count)
  let vibe_stub_names = array_empty()
  let vibe_stub_sigs = array_empty()
  comp_collect_handler_host_imports(core_wasm, stub_vibe, vibe_stub_names, vibe_stub_sigs)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))
  emit_core_module_section(buf, comp_generate_host_stub_module(vibe_stub_names, vibe_stub_sigs))
  // core instance 0: host stub (module 2): fd_write (+ vibe.* stubs when
  // stub_vibe collected any)
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  // core instance 1: main (module 0), wasi_snapshot_preview1 / vibe satisfied
  // by the stub instance when the core imports them (an argument for an
  // import the module does not declare is legal and ignored).
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    0,
    0
  ])
  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr
  emit_alias_section(buf, 1, [target_func_name], [core_sort_func])
  emit_alias_section(buf, 1, ["memory"], [core_sort_mem])
  emit_alias_section(buf, 1, ["__heap_ptr"], [core_sort_global])
  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [core_sort_func, core_sort_global, core_sort_mem], [0, 0, 0])
  // core instance 3: trampoline (module 1) with env
  emit_core_instance_instantiate_args(buf, 1, ["env"], [2])
  // core func 1 = canon_func, core func 2 = cabi_realloc
  emit_alias_section(buf, 3, ["canon_func", "cabi_realloc"], [
    core_sort_func,
    core_sort_func
  ])
  // component type 0: (param_names: string...) -> string
  bytebuf_push(buf, section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(type_content, 1)
  let comp_param_types = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_types, comp_valtype_string)
    pt = pt + 1
  }
  emit_comp_func_type(type_content, comp_param_types, param_names, [
    comp_valtype_string
  ], 0)
  emit_raw_content(buf, type_content)
  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)
  bytebuf_push(buf, section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(canon_content, 1)
  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)
  emit_raw_content(buf, canon_content)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

// ============================================================================
// #1109-2 (vibec-hosted, the vfs face of #857): component whose FILESYSTEM
// comes from a WIT-imported vfs interface. The core's `vibe.fs_*` host
// imports are routed to canon-LOWERED component imports:
//
//   import read-file:  func(path: string) -> string
//   import exists:     func(path: string) -> bool
//   import read-dir-nul: func(path: string) -> string (NUL-joined names)
//   import stat-token: func(path: string) -> s64      (-1 = non-regular)
//
// `read-dir-nul` joins entry names with NUL, the one byte a POSIX name cannot
// contain (#2957); its "\n"-joined predecessor `read-dir` split a name holding
// a newline into fake entries. The name changed with the framing so that a
// component and a host that disagree about it fail to link instead of
// answering wrongly. Inside the component the adapter module still calls the
// lowered function `vfs.read-dir`; that name is private to this layout.
//
// A core built by a compiler from before #2957 (the committed seed, which
// `build_vibec.sh` uses by default) still imports `vibe.fs_read_dir` and
// splits on "\n". Such a core is wrapped with the legacy `read-dir` import
// instead, so each side keeps the framing it was built for; routing it to the
// stub would trap on the first directory walk (#3107 review).
//
// Instantiation is circular on paper (main imports vfs; lowering vfs needs
// main's memory), so we break it with wit-component's shim/fixup dance:
//   shim (table + raw-sig forwarders) -> main(vibe=shim+stubs) -> alias
//   memory/__heap_ptr -> realloc module -> canon lower (memory+realloc) ->
//   adapter module (raw i64 <-> canonical ptr/len trampolines) whose ACTIVE
//   ELEMENT segment plants its impls into the shim's table.
// The compile-face export is lifted exactly like the string handler.
// ============================================================================

/// Raw-sig forwarder module: table 4 funcref (exported "t") + one (i64)->i64
/// forwarder per vfs function, each `call_indirect` through its fixed slot
/// (0 read_file, 1 exists, 2 read_dir_nul, 3 stat_token). Slots are planted later
/// by the adapter module's active element segment.
fn comp_generate_vfs_shim(read_dir_fn: String) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [126], [126])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [0, 0, 0, 0])
  let table_sec = bytebuf_new()
  leb128_encode_u32(table_sec, 1)
  bytebuf_push(table_sec, 112)
  bytebuf_push(table_sec, 0)
  leb128_encode_u32(table_sec, 4)
  bytebuf_push_section(out, 4, table_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 5)
  emit_name(export_sec, "fs_read_file")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 0)
  emit_name(export_sec, "fs_exists")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, read_dir_fn)
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 2)
  emit_name(export_sec, "fs_stat_token")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, 3)
  emit_name(export_sec, "t")
  bytebuf_push(export_sec, 1)
  leb128_encode_u32(export_sec, 0)
  bytebuf_push_section(out, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 4)
  let mut slot = 0
  while slot < 4 {
    let body = bytebuf_new()
    leb128_encode_u32(body, 0)
    emit_local_get(body, 0)
    emit_i32_const(body, slot)
    bytebuf_push(body, 17)
    leb128_encode_u32(body, 0)
    leb128_encode_u32(body, 0)
    bytebuf_push(body, 11)
    leb128_encode_u32(code_sec, Bytes::length(body))
    bytebuf_push_buf(code_sec, body)
    slot = slot + 1
  }
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// Standalone bump cabi_realloc over the MAIN module's memory + __heap_ptr
/// (imported as env.*) — the same body comp_generate_string_trampoline_packed
/// embeds, needed here BEFORE the trampoline exists because the canon-lowered
/// vfs imports allocate their result strings through it.
fn comp_generate_vfs_realloc() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [127, 127, 127, 127], [127])
  bytebuf_push_section(out, 1, tc)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 2)
  emit_name(import_sec, "env")
  emit_name(import_sec, "__heap_ptr")
  bytebuf_push(import_sec, 3)
  bytebuf_push(import_sec, 127)
  bytebuf_push(import_sec, 1)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(out, 2, import_sec)
  emit_function_section(out, [0])
  emit_export_section(out, "cabi_realloc", 0)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let realloc_body = bytebuf_new()
  leb128_encode_u32(realloc_body, 1)
  leb128_encode_u32(realloc_body, 1)
  bytebuf_push(realloc_body, 127)
  // Unlike the trampoline's realloc (which only ever serves its own 8-byte
  // retptr), THIS one is the canonical-lowering allocator for vfs result
  // strings, which request align=1/exact length — and the raw ABI requires
  // __heap_ptr to STAY 8-aligned (heap pointers carry low-bit tags; an
  // unaligned bump poisons every later allocation into "tagged" garbage).
  // So: p = (heap + 7) & ~7; heap = p + ((new_size + 7) & ~7).
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 7)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, -8)
  bytebuf_push(realloc_body, 113)
  emit_local_set(realloc_body, 4)
  emit_local_get(realloc_body, 4)
  emit_local_get(realloc_body, 3)
  emit_i32_const(realloc_body, 7)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, -8)
  bytebuf_push(realloc_body, 113)
  emit_i32_add(realloc_body)
  bytebuf_push(realloc_body, 36)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 116)
  bytebuf_push(realloc_body, 75)
  bytebuf_push(realloc_body, 4)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 35)
  leb128_encode_u32(realloc_body, 0)
  emit_i32_const(realloc_body, 65535)
  emit_i32_add(realloc_body)
  emit_i32_const(realloc_body, 16)
  bytebuf_push(realloc_body, 118)
  bytebuf_push(realloc_body, 63)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 107)
  bytebuf_push(realloc_body, 64)
  bytebuf_push(realloc_body, 0)
  bytebuf_push(realloc_body, 26)
  bytebuf_push(realloc_body, 11)
  emit_local_get(realloc_body, 4)
  bytebuf_push(realloc_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(realloc_body))
  bytebuf_push_buf(code_sec, realloc_body)
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// Adapter/fixup module: converts the raw ABI ((ptr<<32)|len i64 strings) to
/// the canonical lowered signatures and plants its impls into the shim's
/// table via an active element segment at instantiation time.
fn comp_generate_vfs_adapter() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 = (i32,i32,i32)->() lowered string->string
  //        1 = (i32,i32)->i32   lowered string->bool
  //        2 = (i32,i32)->i64   lowered string->s64
  //        3 = (i64)->i64       raw impls
  //        4 = (i32 x4)->i32    cabi_realloc
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 5)
  emit_func_type_raw(tc, [127, 127, 127], array_empty())
  emit_func_type_raw(tc, [127, 127], [127])
  emit_func_type_raw(tc, [127, 127], [126])
  emit_func_type_raw(tc, [126], [126])
  emit_func_type_raw(tc, [127, 127, 127, 127], [127])
  bytebuf_push_section(out, 1, tc)
  // imports: vfs.read-file f0 t0, vfs.exists f1 t1, vfs.read-dir f2 t0,
  // vfs.stat-token f3 t2, env.cabi_realloc f4 t4, env.memory, env.t (table)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, 7)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "read-file")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "exists")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 1)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "read-dir")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "vfs")
  emit_name(import_sec, "stat-token")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 2)
  emit_name(import_sec, "env")
  emit_name(import_sec, "cabi_realloc")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 4)
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "t")
  bytebuf_push(import_sec, 1)
  bytebuf_push(import_sec, 112)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 4)
  bytebuf_push_section(out, 2, import_sec)
  // funcs: f5 impl_read_file, f6 impl_exists, f7 impl_read_dir, f8 impl_stat
  emit_function_section(out, [3, 3, 3, 3])
  // active elem: table 0 offset 0 -> [f5, f6, f7, f8]
  let elem_sec = bytebuf_new()
  leb128_encode_u32(elem_sec, 1)
  bytebuf_push(elem_sec, 0)
  emit_i32_const(elem_sec, 0)
  bytebuf_push(elem_sec, 11)
  leb128_encode_u32(elem_sec, 4)
  leb128_encode_u32(elem_sec, 5)
  leb128_encode_u32(elem_sec, 6)
  leb128_encode_u32(elem_sec, 7)
  leb128_encode_u32(elem_sec, 8)
  bytebuf_push_section(out, 9, elem_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 4)
  // impl_read_file / impl_read_dir (string result via retptr)
  let mut sri = 0
  while sri < 2 {
    let body = bytebuf_new()
    leb128_encode_u32(body, 1)
    leb128_encode_u32(body, 1)
    bytebuf_push(body, 127)
    // retptr = cabi_realloc(0,0,4,8)
    emit_i32_const(body, 0)
    emit_i32_const(body, 0)
    emit_i32_const(body, 4)
    emit_i32_const(body, 8)
    bytebuf_push(body, 16)
    leb128_encode_u32(body, 4)
    emit_local_set(body, 1)
    // ptr = wrap(arg >> 32); len = wrap(arg)
    emit_local_get(body, 0)
    emit_i64_const(body, 32)
    bytebuf_push(body, 136)
    bytebuf_push(body, 167)
    emit_local_get(body, 0)
    bytebuf_push(body, 167)
    emit_local_get(body, 1)
    bytebuf_push(body, 16)
    leb128_encode_u32(body, if sri == 0 {
      0
    } else {
      2
    })
    // (extend_u([retptr]) << 32) | extend_u([retptr+4])
    emit_local_get(body, 1)
    bytebuf_push(body, 40)
    leb128_encode_u32(body, 2)
    leb128_encode_u32(body, 0)
    bytebuf_push(body, 173)
    emit_i64_const(body, 32)
    bytebuf_push(body, 134)
    emit_local_get(body, 1)
    bytebuf_push(body, 40)
    leb128_encode_u32(body, 2)
    leb128_encode_u32(body, 4)
    bytebuf_push(body, 173)
    bytebuf_push(body, 132)
    bytebuf_push(body, 11)
    // impl order in the code section is f5(read_file), f6(exists),
    // f7(read_dir), f8(stat) — emit exists between the two string impls.
    if sri == 0 {
      leb128_encode_u32(code_sec, Bytes::length(body))
      bytebuf_push_buf(code_sec, body)
      let exists_body = bytebuf_new()
      leb128_encode_u32(exists_body, 0)
      emit_local_get(exists_body, 0)
      emit_i64_const(exists_body, 32)
      bytebuf_push(exists_body, 136)
      bytebuf_push(exists_body, 167)
      emit_local_get(exists_body, 0)
      bytebuf_push(exists_body, 167)
      bytebuf_push(exists_body, 16)
      leb128_encode_u32(exists_body, 1)
      bytebuf_push(exists_body, 173)
      bytebuf_push(exists_body, 11)
      leb128_encode_u32(code_sec, Bytes::length(exists_body))
      bytebuf_push_buf(code_sec, exists_body)
    } else {
      leb128_encode_u32(code_sec, Bytes::length(body))
      bytebuf_push_buf(code_sec, body)
      let stat_body = bytebuf_new()
      leb128_encode_u32(stat_body, 0)
      emit_local_get(stat_body, 0)
      emit_i64_const(stat_body, 32)
      bytebuf_push(stat_body, 136)
      bytebuf_push(stat_body, 167)
      emit_local_get(stat_body, 0)
      bytebuf_push(stat_body, 167)
      bytebuf_push(stat_body, 16)
      leb128_encode_u32(stat_body, 3)
      bytebuf_push(stat_body, 11)
      leb128_encode_u32(code_sec, Bytes::length(stat_body))
      bytebuf_push_buf(code_sec, stat_body)
    }
    sri = sri + 1
  }
  bytebuf_push_section(out, 10, code_sec)
  bytebuf_to_bytes(out)
}

/// #2957: the vfs component import that carries this core's directory
/// listing -- `read-dir-nul` (NUL-joined names) for a core that imports
/// `vibe.fs_read_dir_nul`, or the legacy "\n"-joined `read-dir` for one built
/// by a pre-#2957 compiler (the committed seed) that still imports
/// `vibe.fs_read_dir`. `build_vibec.sh` declares the same name in the WIT it
/// ships beside the component.
export fn comp_vfs_read_dir_import(core_wasm: Bytes) -> String {
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut legacy = false
  let mut i = 0
  while i < import_count {
    if Array::get(imp_modules, i) == "vibe" && Array::get(imp_names, i) == "fs_read_dir" {
      legacy = true
    }
    i = i + 1
  }
  if legacy {
    "read-dir"
  } else {
    "read-dir-nul"
  }
}

export fn comp_emit_component_wasm_string_handler_vfs(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_emit_string_handler_vfs_impl(core_wasm, target_func_name, export_name, param_names, true)
}

/// The vfs wrap with EVERY non-read `vibe.*` import trapping -- no benign
/// zero-stub for `env-get` / the fs write pair / `profile-now-us`.
///
/// `vibe build --component` takes this one. The permissive wrap above exists
/// for the vibec core, whose only writer is the persistent cache, so dropping
/// a write there is a cache miss. A command module's write is what the caller
/// asked for: dropped, `Fs::write_file(p, s)` built, dispatched, printed its
/// own success line and exited 0 having written nothing (#2861, Codex review).
export fn comp_emit_component_wasm_string_handler_vfs_trapping(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_emit_string_handler_vfs_impl(core_wasm, target_func_name, export_name, param_names, false)
}

fn comp_emit_string_handler_vfs_impl(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String], zero_stub_benign: Bool) -> Bytes with Exception {
  let string_param_count = Array::length(param_names)
  // Validate the target export exists with the packed-string core signature
  // (same contract as comp_emit_string_handler_impl).
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut target_sig_ok = false
  let mut target_found = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == target_func_name {
      target_found = true
      let sig = Array::get(export_type_sigs, ei)
      let core_param_count = string_param_count + 1
      if Array::length(sig) == (core_param_count + 3) {
        let mut ok = Array::get(sig, 0) == core_param_count
        let mut pi = 0
        while pi < core_param_count {
          if Array::get(sig, 1 + pi) != 126 {
            ok = false
          }
          pi = pi + 1
        }
        if Array::get(sig, 1 + core_param_count) != 1 {
          ok = false
        }
        if Array::get(sig, 2 + core_param_count) != 126 {
          ok = false
        }
        target_sig_ok = ok
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !target_found {
    throw("component(vfs): core module does not export '\{target_func_name}'")
  }
  if !target_sig_ok {
    throw("component(vfs): '\{target_func_name}' must take \{string_param_count} String params and return String")
  }
  // Classify the core's imports: the four fs_* vfs functions route to the
  // shim, every other vibe.* import gets a local stub, fd_write is the
  // usual wasi stub, anything else is rejected.
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  // The directory import this core was built with (see
  // `comp_vfs_read_dir_import`).
  let read_dir_wit = comp_vfs_read_dir_import(core_wasm)
  let read_dir_fn = if read_dir_wit == "read-dir" {
    "fs_read_dir"
  } else {
    "fs_read_dir_nul"
  }
  let vibe_import_names = array_empty()
  let stub_names = array_empty()
  let stub_sigs = array_empty()
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if im == "vibe" {
      Array::push(vibe_import_names, ifn)
      if ifn == "fs_read_file" || ifn == "fs_exists" || ifn == read_dir_fn || ifn == "fs_stat_token" {
        ()
      } else {
        Array::push(stub_names, ifn)
        Array::push(stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))
      }
    } else {
      throw("component(vfs): unsupported host import '\{im}.\{ifn}'")
    }
    ii = ii + 1
  }
  let stub_count = Array::length(stub_names)
  // Core func index plan (aliases + lowers appear in emission order):
  //   0..3            shim forwarders (fs_read_file/exists/read_dir/stat_token)
  //   4..3+S          stub funcs
  //   4+S             target func (from main)
  //   5+S             vfs cabi_realloc (realloc module)
  //   6+S..9+S        canon-lowered vfs imports
  //   10+S, 11+S      trampoline canon_func + trampoline cabi_realloc
  let f_target = 4 + stub_count
  let f_realloc = 5 + stub_count
  let f_lower0 = 6 + stub_count
  let f_canon = 10 + stub_count
  let f_tramp_realloc = 11 + stub_count
  let buf = bytebuf_new()
  emit_component_header(buf)
  // S1: component types 0-3 for the vfs imports.
  bytebuf_push(buf, section_type)
  let vfs_types = bytebuf_new()
  leb128_encode_u32(vfs_types, 4)
  let path_param = array_empty()
  Array::push(path_param, "path")
  emit_comp_func_type(vfs_types, [comp_valtype_string], path_param, [
    comp_valtype_string
  ], 0)
  emit_comp_func_type(vfs_types, [comp_valtype_string], path_param, [
    comp_valtype_bool
  ], 0)
  emit_comp_func_type(vfs_types, [comp_valtype_string], path_param, [
    comp_valtype_string
  ], 0)
  emit_comp_func_type(vfs_types, [comp_valtype_string], path_param, [
    comp_valtype_s64
  ], 0)
  emit_raw_content(buf, vfs_types)
  // S2: component imports read-file/exists/read-dir/stat-token -> funcs 0-3.
  let vfs_import_names = array_empty()
  Array::push(vfs_import_names, "read-file")
  Array::push(vfs_import_names, "exists")
  Array::push(vfs_import_names, read_dir_wit)
  Array::push(vfs_import_names, "stat-token")
  emit_comp_import_section(buf, vfs_import_names, 4)
  // S3-S8: core modules 0..5.
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))
  emit_core_module_section(buf, comp_generate_host_stub_module_with_policy(stub_names, stub_sigs, zero_stub_benign))
  emit_core_module_section(buf, comp_generate_vfs_shim(read_dir_fn))
  emit_core_module_section(buf, comp_generate_vfs_realloc())
  emit_core_module_section(buf, comp_generate_vfs_adapter())
  // S9: instance 0 = stub, S10: instance 1 = shim.
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  emit_core_instance_instantiate_section(buf, 3, array_empty())
  // S11: alias the shim forwarders (core funcs 0-3).
  let shim_fn_names = array_empty()
  Array::push(shim_fn_names, "fs_read_file")
  Array::push(shim_fn_names, "fs_exists")
  Array::push(shim_fn_names, read_dir_fn)
  Array::push(shim_fn_names, "fs_stat_token")
  emit_alias_section(buf, 1, shim_fn_names, [
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func
  ])
  // S12: alias the stub funcs (core funcs 4..3+S).
  let stub_sorts = new_int_array()
  let mut ssi = 0
  while ssi < stub_count {
    Array::push(stub_sorts, core_sort_func)
    ssi = ssi + 1
  }
  emit_alias_section(buf, 0, stub_names, stub_sorts)
  // S13: synthetic "vibe" instance covering every vibe.* import of the core.
  let vibe_inst_names = array_empty()
  let vibe_inst_sorts = new_int_array()
  let vibe_inst_indices = new_int_array()
  let mut vi = 0
  while vi < Array::length(vibe_import_names) {
    let vn = Array::get(vibe_import_names, vi)
    Array::push(vibe_inst_names, vn)
    Array::push(vibe_inst_sorts, core_sort_func)
    if vn == "fs_read_file" {
      Array::push(vibe_inst_indices, 0)
    } else if vn == "fs_exists" {
      Array::push(vibe_inst_indices, 1)
    } else if vn == read_dir_fn {
      Array::push(vibe_inst_indices, 2)
    } else if vn == "fs_stat_token" {
      Array::push(vibe_inst_indices, 3)
    } else {
      let mut sj = 0
      let mut found_at = -1
      while sj < stub_count {
        if Array::get(stub_names, sj) == vn && found_at == -1 {
          found_at = sj
        }
        sj = sj + 1
      }
      Array::push(vibe_inst_indices, 4 + found_at)
    }
    vi = vi + 1
  }
  emit_core_instance_from_exports_sorted(buf, vibe_inst_names, vibe_inst_sorts, vibe_inst_indices)
  // S14: instance 3 = main, wasi from the stub instance, vibe from instance 2.
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    0,
    2
  ])
  // S15: alias target func + memory + __heap_ptr from main (instance 3).
  let main_alias_names = array_empty()
  Array::push(main_alias_names, target_func_name)
  Array::push(main_alias_names, "memory")
  Array::push(main_alias_names, "__heap_ptr")
  emit_alias_section(buf, 3, main_alias_names, [
    core_sort_func,
    core_sort_mem,
    core_sort_global
  ])
  // S16/S17: realloc env (instance 4) + realloc module (instance 5).
  let renv_names = array_empty()
  Array::push(renv_names, "__heap_ptr")
  Array::push(renv_names, "memory")
  emit_core_instance_from_exports_sorted(buf, renv_names, [
    core_sort_global,
    core_sort_mem
  ], [0, 0])
  emit_core_instance_instantiate_args(buf, 4, ["env"], [4])
  // S18: alias cabi_realloc (core func 5+S) from instance 5.
  let realloc_names = array_empty()
  Array::push(realloc_names, "cabi_realloc")
  emit_alias_section(buf, 5, realloc_names, [core_sort_func])
  // S19: canon lower the four vfs imports (core funcs 6+S..9+S). String
  // results (read-file/read-dir) need memory + realloc; the scalar-result
  // ones need memory only (their string PARAM is read out of core memory).
  bytebuf_push(buf, section_canon)
  let lower_content = bytebuf_new()
  leb128_encode_u32(lower_content, 4)
  let mut li = 0
  while li < 4 {
    bytebuf_push(lower_content, 1)
    bytebuf_push(lower_content, 0)
    leb128_encode_u32(lower_content, li)
    if li == 0 || li == 2 {
      leb128_encode_u32(lower_content, 3)
      bytebuf_push(lower_content, 0)
      bytebuf_push(lower_content, 3)
      leb128_encode_u32(lower_content, 0)
      bytebuf_push(lower_content, 4)
      leb128_encode_u32(lower_content, f_realloc)
    } else {
      leb128_encode_u32(lower_content, 2)
      bytebuf_push(lower_content, 0)
      bytebuf_push(lower_content, 3)
      leb128_encode_u32(lower_content, 0)
    }
    li = li + 1
  }
  emit_raw_content(buf, lower_content)
  // S20: alias the shim's table (table 0).
  let table_names = array_empty()
  Array::push(table_names, "t")
  emit_alias_section(buf, 1, table_names, [1])
  // S21: synthetic "vfs" instance of the lowered funcs (instance 6).
  let vfs_inst_names = array_empty()
  Array::push(vfs_inst_names, "read-file")
  Array::push(vfs_inst_names, "exists")
  Array::push(vfs_inst_names, "read-dir")
  Array::push(vfs_inst_names, "stat-token")
  emit_core_instance_from_exports_sorted(buf, vfs_inst_names, [
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func
  ], [f_lower0, f_lower0 + 1, f_lower0 + 2, f_lower0 + 3])
  // S22: synthetic adapter env {cabi_realloc, memory, t} (instance 7).
  let aenv_names = array_empty()
  Array::push(aenv_names, "cabi_realloc")
  Array::push(aenv_names, "memory")
  Array::push(aenv_names, "t")
  emit_core_instance_from_exports_sorted(buf, aenv_names, [
    core_sort_func,
    core_sort_mem,
    1
  ], [f_realloc, 0, 0])
  // S23: instance 8 = adapter (fixup: its active elem plants the impls).
  emit_core_instance_instantiate_args(buf, 5, ["vfs", "env"], [6, 7])
  // S24: synthetic trampoline env (instance 9).
  let tenv_names = array_empty()
  Array::push(tenv_names, "target_func")
  Array::push(tenv_names, "__heap_ptr")
  Array::push(tenv_names, "memory")
  emit_core_instance_from_exports_sorted(buf, tenv_names, [
    core_sort_func,
    core_sort_global,
    core_sort_mem
  ], [f_target, 0, 0])
  // S25: instance 10 = trampoline; S26: alias canon_func + its realloc.
  emit_core_instance_instantiate_args(buf, 1, ["env"], [9])
  let tramp_names = array_empty()
  Array::push(tramp_names, "canon_func")
  Array::push(tramp_names, "cabi_realloc")
  emit_alias_section(buf, 10, tramp_names, [core_sort_func, core_sort_func])
  // S27: component type 4 = the export's (string...) -> string.
  bytebuf_push(buf, section_type)
  let export_type = bytebuf_new()
  leb128_encode_u32(export_type, 1)
  let comp_param_types = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_types, comp_valtype_string)
    pt = pt + 1
  }
  emit_comp_func_type(export_type, comp_param_types, param_names, [
    comp_valtype_string
  ], 0)
  emit_raw_content(buf, export_type)
  // S28: canon lift (memory 0 + trampoline realloc); S29: export (comp func 4).
  bytebuf_push(buf, section_canon)
  let lift_content = bytebuf_new()
  leb128_encode_u32(lift_content, 1)
  emit_canon_lift_func(lift_content, f_canon, 4, 1, 0, f_tramp_realloc)
  emit_raw_content(buf, lift_content)
  emit_comp_export_section(buf, export_name, 4)
  bytebuf_to_bytes(buf)
}

//# Misc

// Same-package sibling-test visibility only. Keep this private fn absent from
// index.vpkg so it cannot become part of the package contract.
