/// ADR-0089 step 4 (#1218): async trampoline for a REAL compiled entry
/// with a u32-lifted result -- imports ("main","run") in the compiled core
/// shape `(i64) -> i64` (closure-env param, untagged result) and
/// ("cm","task-return") `(i32) -> ()`, exports a void `run` that calls the
/// entry with a dummy env, wraps the i64 to i32 and forwards it to
/// task.return. The u32 result type (unlike trampolined-p1's s64) matches
/// viberun's typed `run` driver -- the only host that provides the
/// `get-future` import this composition needs.
fn comp_generate_async_trampoline_hostfuture() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [126], [126])
  emit_func_type_raw(tc, [127], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 2)
  emit_name(ic, "main")
  emit_name(ic, "run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "cm")
  emit_name(ic, "task-return")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [2])
  emit_export_section(out, "run", 2)
  let body = bytebuf_new()
  emit_i64_const(body, 0)
  emit_call(body, 0)
  emit_i32_wrap_i64(body)
  emit_call(body, 1)
  emit_code_section(out, [body])
  bytebuf_to_bytes(out)
}

fn comp_core_sig_is_p0_i64(sig: Array[Int]) -> Bool {
  Array::length(sig) == 3 && Array::get(sig, 0) == 0 && Array::get(sig, 1) == 1 && Array::get(sig, 2) == 126
}

fn comp_core_sig_is_p1_i64_i64(sig: Array[Int]) -> Bool {
  Array::length(sig) == 4 && Array::get(sig, 0) == 1 && Array::get(sig, 1) == 126 && Array::get(sig, 2) == 1 && Array::get(sig, 3) == 126
}

fn comp_core_sig_is_fd_write(sig: Array[Int]) -> Bool {
  Array::length(sig) == 7 && Array::get(sig, 0) == 4 && Array::get(sig, 1) == 127 && Array::get(sig, 2) == 127 && Array::get(sig, 3) == 127 && Array::get(sig, 4) == 127 && Array::get(sig, 5) == 1 && Array::get(sig, 6) == 127
}

/// #1342 routing key: the compiled core imports the blocking host sleep, so
/// it needs the adapter's sleep half and cannot be composed self-contained.
export fn comp_core_imports_sleep(core_wasm: Bytes) -> Bool {
  comp_core_imports_func(core_wasm, "vibe", "sleep")
}

/// #1342: what the SELF-CONTAINED async wrap can actually satisfy.
///
/// That composition instantiates the compiled core with a preview1 fd_write
/// stub and (when the exception boundary needs it) a trapping
/// `vibe.stderr_write_stream`. Any other host import has no provider, and the
/// component the wrap emits for one is not instantiable -- `wasm-tools
/// validate` reports "missing module instantiation argument named `vibe`".
/// The compiler used to write that artifact and exit 0, which is the worst
/// available answer: a build that reports success and hands back a file the
/// runtime rejects. Name the unsatisfiable import instead.
export fn comp_reject_unsatisfiable_selfcontained_imports(core_wasm: Bytes) -> Unit with Exception {
  let modules = array_empty()
  let names = array_empty()
  let type_indices = new_int_array()
  let type_sigs = array_empty()
  let count = parse_core_imports(core_wasm, modules, names, type_indices, type_sigs)
  // `process_exit` is satisfiable only as the exception boundary's exit, which
  // always comes with its stderr import (see the trampolined emitter). The
  // import section cannot tell that exit from one the program wrote beside its
  // own stderr write; the source lane refuses the latter before calling this.
  let mut has_stderr = false
  let mut si = 0
  while si < count {
    if Array::get(modules, si) == "vibe" && Array::get(names, si) == "stderr_write_stream" {
      has_stderr = true
    }
    si = si + 1
  }
  let mut i = 0
  while i < count {
    let im = Array::get(modules, i)
    let ifn = Array::get(names, i)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if im == "vibe" && (ifn == "stderr_write_stream" || (ifn == "process_exit" && has_stderr)) {
      ()
    } else {
      throw("component(async): core module uses host import '\{im}.\{ifn}', which nothing in this component provides -- an async component entry can use sleep, host futures and host streams; other host capabilities have no provider inside the component (#1342)")
    }
    i = i + 1
  }
}

fn comp_is_stdin_provider_import_name(name: String) -> Bool {
  name == "stdin_provider_acquire" || name == "stdin_provider_read" || name == "stdin_provider_close"
}

/// Wrap a compiled core into a COMMAND component -- the artifact
/// `viberun --commands` dispatches (docs/internal/design/component-lazy-dispatch.md).
///
/// The face is chosen from the core's own import section, never from a flag,
/// so the two callers that build a command component (`vibe build --component`
/// through the launcher's `VIBE_BUILD_COMPONENT` lane, and the same verb on
/// the user CLI) cannot disagree about what a given module gets: a core with
/// no `vibe.*` import takes the strict wrap, which REFUSES one, and a core
/// that has them takes the TRAPPING vfs wrap, whose four read operations
/// become component imports and whose every other `vibe.*` import traps.
///
/// Trapping, not the permissive vfs wrap vibec uses: that one answers
/// `env-get` / `fs_write_file` / `fs_write_bytes` / `profile-now-us` with a
/// benign zero, which is right for a core whose only writer is a cache and
/// silently wrong for a command, where the write is the point.
export fn comp_emit_component_wasm_command(core_wasm: Bytes, target_func_name: String, export_name: String) -> Bytes with Exception {
  let params = ["args"]
  if comp_core_imports_vibe_host(core_wasm) {
    comp_emit_component_wasm_string_handler_vfs_trapping(core_wasm, target_func_name, export_name, params)
  } else {
    comp_emit_component_wasm_string_handler(core_wasm, target_func_name, export_name, params)
  }
}

/// Does a compiled core module reach the HOST at all -- i.e. does it import
/// anything from the `vibe` module?
///
/// `vibe build --component` reads this to choose between the two command
/// faces: a core with no host imports gets the pure wrap (which REJECTS a
/// `vibe.*` import, so a command that grew one cannot slip through), and a
/// core that has them gets the vfs wrap, whose four read operations become
/// component imports and whose remaining `vibe.*` imports become traps.
/// Choosing from the core's own import section rather than from a flag is
/// what keeps the two answers from disagreeing.
export fn comp_core_imports_vibe_host(core_wasm: Bytes) -> Bool {
  let modules = array_empty()
  let names = array_empty()
  let indices = new_int_array()
  let sigs = array_empty()
  let count = parse_core_imports(core_wasm, modules, names, indices, sigs)
  let mut found = false
  let mut i = 0
  while i < count {
    if Array::get(modules, i) == "vibe" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #1539 exact parsed-import routing key. A malformed exact provider import
/// still returns true so the stdin composer, rather than an unrelated wrapper,
/// produces the actionable signature diagnostic.
export fn comp_core_imports_stdin_provider(core_wasm: Bytes) -> Bool {
  let modules = array_empty()
  let names = array_empty()
  let indices = new_int_array()
  let sigs = array_empty()
  let count = parse_core_imports(core_wasm, modules, names, indices, sigs)
  let mut found = false
  let mut i = 0
  while i < count {
    if Array::get(modules, i) == "vibe" && comp_is_stdin_provider_import_name(Array::get(names, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #1539 bounded arbitrary-core composer. The nominal stdin instance and
/// canonical handles terminate at the shadow lifecycle instance; a distinct
/// tagged-i64 bridge is the only `vibe` instance passed to the compiled guest.
export fn comp_emit_component_wasm_async_stdin_provider(main_core_wasm: Bytes, export_name: String) -> Bytes with Exception {
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_sigs = array_empty()
  let _ = parse_core_exports(main_core_wasm, export_names, export_func_indices, export_sigs)
  let mut run_ok = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == "run" {
      let sig = Array::get(export_sigs, ei)
      run_ok = Array::length(sig) == 4 && Array::get(sig, 0) == 1 && Array::get(sig, 1) == 126 && Array::get(sig, 2) == 1 && Array::get(sig, 3) == 126
    } else {
      ()
    }
    ei = ei + 1
  }
  if !run_ok {
    throw("component(async-stdin-provider): core module must export 'run : (i64) -> i64' (compile with entry name \"run\")")
  } else {
    ()
  }
  let modules = array_empty()
  let names = array_empty()
  let indices = new_int_array()
  let sigs = array_empty()
  let count = parse_core_imports(main_core_wasm, modules, names, indices, sigs)
  // Diagnose the bounded-slice composition conflict before the allowlist walk:
  // linked_compile emits the shared stream/future operations before some
  // per-name getters, so waiting for declaration order could produce a generic
  // unsupported-import error instead of the required explicit rejection.
  if comp_core_imports_host_future(main_core_wasm) || comp_core_imports_host_stream(main_core_wasm) {
    throw("component(async-stdin-provider): mixing stdin-provider imports with named host future/stream imports is not supported in this bounded route")
  } else {
    ()
  }
  let mut acquire_count = 0
  let mut read_count = 0
  let mut close_count = 0
  let mut i = 0
  while i < count {
    let module_name = Array::get(modules, i)
    let name = Array::get(names, i)
    let type_idx = Array::get(indices, i)
    if type_idx < 0 || type_idx >= Array::length(sigs) {
      throw("component(async-stdin-provider): import '\{module_name}.\{name}' has an invalid core type index")
    } else {
      ()
    }
    let sig = Array::get(sigs, type_idx)
    if module_name == "wasi_snapshot_preview1" && name == "fd_write" {
      if !comp_core_sig_is_fd_write(sig) {
        throw("component(async-stdin-provider): wasi_snapshot_preview1.fd_write must have signature (i32, i32, i32, i32) -> i32")
      } else {
        ()
      }
    } else if module_name == "vibe" && name == "stdin_provider_acquire" {
      acquire_count = acquire_count + 1
      if !comp_core_sig_is_p0_i64(sig) {
        throw("component(async-stdin-provider): vibe.stdin_provider_acquire must have signature () -> i64")
      } else {
        ()
      }
    } else if module_name == "vibe" && name == "stdin_provider_read" {
      read_count = read_count + 1
      if !comp_core_sig_is_p1_i64_i64(sig) {
        throw("component(async-stdin-provider): vibe.stdin_provider_read must have signature (i64) -> i64")
      } else {
        ()
      }
    } else if module_name == "vibe" && name == "stdin_provider_close" {
      close_count = close_count + 1
      if !comp_core_sig_is_p1_i64_i64(sig) {
        throw("component(async-stdin-provider): vibe.stdin_provider_close must have signature (i64) -> i64")
      } else {
        ()
      }
    } else {
      throw("component(async-stdin-provider): core module uses host import '\{module_name}.\{name}' (only fd_write and the three exact vibe.stdin_provider_* imports are satisfiable)")
    }
    i = i + 1
  }
  if acquire_count > 1 || read_count > 1 || close_count > 1 {
    throw("component(async-stdin-provider): duplicate stdin-provider core import")
  } else if acquire_count == 0 {
    throw("component(async-stdin-provider): stdin_provider_read/close requires exactly one stdin_provider_acquire import")
  } else if read_count + close_count == 0 {
    throw("component(async-stdin-provider): stdin_provider_acquire requires at least one consuming read or close import")
  } else {
    ()
  }
  let buf = bytebuf_new()
  emit_component_header(buf)
  // Keep #1620/#1623's exact 208-byte nominal prefix first.
  emit_comp_wasi_cli_stdin_import_prefix(buf)
  // modules: 0 main, 1 lifecycle shadow, 2 tagged bridge, 3 trampoline,
  // 4 fd_write stub, 5 memhost.
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_stdin_provider_adapter_core_module())
  emit_core_module_section(buf, comp_generate_stdin_provider_tagged_bridge_core_module())
  emit_core_module_section(buf, comp_generate_async_trampoline_hostfuture())
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  emit_core_module_section(buf, comp_generate_memhost_module())
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 5, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, ["memory"], [core_sort_mem])
  let stream_type_idx = 3
  let completion_result_type_idx = 4
  let completion_future_type_idx = 5
  emit_comp_stream_type_section(buf, comp_valtype_u8)
  emit_comp_result_error_type_section(buf, 1)
  emit_comp_future_type_section(buf, completion_result_type_idx)
  emit_canon_lower_memory_section(buf, 0, mem_alias_idx)
  emit_canon_stream_read(buf, stream_type_idx, mem_alias_idx)
  emit_canon_stream_drop_readable(buf, stream_type_idx)
  emit_canon_future_read(buf, completion_future_type_idx, mem_alias_idx)
  emit_canon_future_drop_readable(buf, completion_future_type_idx)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  emit_canon_task_return(buf, comp_valtype_u32)
  let root_inst = 1
  emit_core_instance_from_exports(buf, 1, [9], [
    "read-via-stream",
    "[async-lower][stream-read-0]read-via-stream",
    "[stream-drop-readable-0]read-via-stream",
    "[async-lower][future-read-1]read-via-stream",
    "[future-drop-readable-1]read-via-stream",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [0, 1, 2, 3, 4, 5, 6, 7, 8])
  // The scenario imports exist only because the proven lifecycle module is
  // reused byte-for-byte. They all bind the same unreachable-from-production
  // task-return function and are never passed to the main guest.
  let export_root_inst = 2
  emit_core_instance_from_exports(buf, 1, [6], [
    "[task-return]drain",
    "[task-return]early-close",
    "[task-return]forced-completion-tag-control",
    "[task-return]foreign-provider-control",
    "[task-return]wrong-byte-cleanup-control",
    "[task-return]extra-byte-cleanup-control"
  ], [9, 9, 9, 9, 9, 9])
  let env_inst = 3
  emit_core_instance_from_exports_sorted(buf, ["memory"], [core_sort_mem], [
    mem_alias_idx
  ])
  let shadow_inst = 4
  emit_core_instance_instantiate_args(buf, 1, ["$root", "[export]$root", "env"], [
    root_inst,
    export_root_inst,
    env_inst
  ])
  let bridge_inst = 5
  emit_core_instance_instantiate_args(buf, 2, ["shadow"], [shadow_inst])
  let stub_inst = 6
  emit_core_instance_instantiate_section(buf, 4, array_empty())
  let main_inst = 7
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    stub_inst,
    bridge_inst
  ])
  let main_run_func_idx = 10
  emit_alias_section(buf, main_inst, ["run"], [core_sort_func])
  let main_arg_inst = 8
  emit_core_instance_from_exports(buf, 1, [1], ["run"], [main_run_func_idx])
  let cm_arg_inst = 9
  emit_core_instance_from_exports(buf, 1, [1], ["task-return"], [9])
  let tramp_inst = 10
  emit_core_instance_instantiate_args(buf, 3, ["main", "cm"], [
    main_arg_inst,
    cm_arg_inst
  ])
  let async_type_idx = 6
  emit_comp_async_functype_section(buf, comp_valtype_u32)
  let tramp_run_func_idx = 11
  emit_alias_section(buf, tramp_inst, ["run"], [core_sort_func])
  emit_canon_lift_async_section(buf, tramp_run_func_idx, async_type_idx)
  emit_comp_export_section(buf, export_name, 1)
  bytebuf_to_bytes(buf)
}

/// Internal runtime-gate fixture: 0=drain (42), 1=early close (43), and
/// 2/3/4=odd/out-of-u32/high-bit malformed tagged-wire trap controls.
export fn comp_emit_component_wasm_async_stdin_provider_fixture(mode: Int) -> Bytes with Exception {
  comp_emit_component_wasm_async_stdin_provider(comp_generate_stdin_provider_synthetic_core(mode), "run")
}

/// ADR-0089 step 4 (#1218): wrap a REAL compiled core module -- one whose
/// program calls `host_future_get`, so the core imports
/// `vibe.host_future_get` / `vibe.host_future_wait` -- into an async
/// component that imports `get-future: func() -> future<u32>` from the
/// host and satisfies the core's imports with the adapter module above.
/// This is the step-4 wiring: real `.vibe`-source `await` (lowered by
/// await_poll_pass + the entry boundary to the reserved waitable Suspend
/// payload) reaches `waitable-set.wait` through the adapter, where the
/// canonical ABI genuinely suspends the task until the host resolves the
/// future (measured by scripts/test_hostfuture_source_component_gate.sh).
///
/// Composition (acyclic -- buffers live in memhost memory, values cross
/// as i64s): memhost -> canon defs over its memory -> adapter($root, env)
/// -> fd_write stub -> main(wasi=stub, vibe=adapter) -> trampoline(main,
/// cm) -> async lift (u32) -> export.
///
/// ADR-0089 (c) (#1218): generalized to K host futures, K = the number of
/// `vibe.host_future_get[$name]` core imports (spec §3.16). Each becomes its
/// own component import `<label>: func() -> future<u32>` -- the shape a
/// WIT-derived async import has -- so a program can hold several host
/// futures in flight at once. K=1 with the anonymous name is exactly the
/// step-4 component's shape.
///
/// Component type indices: 0=(future u32), 1=import functype (async,
/// result = type 0), 2=export functype (async, result u32). Component
/// func indices: 0..K-1 = the imports, K = the lifted run. Core func
/// indices: 0..K-1=lowered imports, K=future.read, K+1=future.drop-readable,
/// K+2=task-return, K+3=waitable-set.new, K+4=waitable.join,
/// K+5=waitable-set.wait, K+6=waitable-set.drop, K+7=alias(main, "run"),
/// K+8=alias(trampoline, "run"). Core instances: 0=memhost, 1=$root,
/// 2=env(memory), 3=adapter, 4=wasi-stub, 5=main, 6=main-arg, 7=cm-arg,
/// 8=trampoline.
export fn comp_emit_component_wasm_async_hostfuture(main_core_wasm: Bytes, export_name: String) -> Bytes with Exception {
  comp_emit_async_host_composition(main_core_wasm, export_name, "", [])
}

/// #2066: the `wasi:http/service` shape -- a serve handler that is ALSO a
/// client. The handler takes the request body as a `stream<u8>` (the serve
/// stream lane's export) and awaits WIT responses (the run lane's imports), so
/// one component exports `handler` and imports the client interface. Both
/// halves already existed; this composes them: the run lane's import, adapter
/// and canon sections, then the stream lane's string trampoline, `task.return`
/// and async lift in place of the `run` export.
///
/// The request body and every response body are the same `stream<u8>` type,
/// so the adapter's one stream half reads both. The core is compiled with
/// plain i64 values (the serve lane's convention), which the adapter follows
/// through `vibe.tagmode`.
export fn comp_emit_component_wasm_service_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_emit_async_host_composition(core_wasm, export_name, target_func_name, param_names)
}

/// Whether a serve core awaits a host future or response, which routes it to
/// the service composer: the plain stream lane has no provider for either.
fn comp_core_awaits_host_future(core_wasm: Bytes) -> Bool with Exception {
  Array::length(comp_core_host_future_names(core_wasm)) > 0
}

/// `handler_target` empty: the `run` export. Otherwise the serve handler
/// export of `comp_emit_component_wasm_service_handler`.
fn comp_emit_async_host_composition(main_core_wasm: Bytes, export_name: String, handler_target: String, handler_params: Array[String]) -> Bytes with Exception {
  let handler_mode = handler_target != ""
  let handler_string_count = Array::length(handler_params) - 1
  if handler_mode {
    comp_require_tag_mode(main_core_wasm, 0, "component(service-handler)")
    comp_check_stream_handler_target(main_core_wasm, handler_target, handler_string_count)
  } else {
    ()
  }
  // The compiled entry must be exported as `run : (i64) -> i64` (entry
  // name "run" -- the same constraint the trampolined-p1 wrap has).
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let _ = parse_core_exports(main_core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut run_ok = false
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == "run" {
      let sig = Array::get(export_type_sigs, ei)
      if Array::length(sig) == 4 {
        run_ok = Array::get(sig, 0) == 1 && Array::get(sig, 1) == 126 && Array::get(sig, 2) == 1 && Array::get(sig, 3) == 126
      } else {
        ()
      }
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  if !run_ok && !handler_mode {
    throw("component(async-hostfuture): core module must export 'run : (i64) -> i64' (compile with entry name \"run\")")
  } else {
    ()
  }
  // Import allowlist: the preview1 preamble stub plus the two adapter
  // imports. Anything else (fs, http, sleep, ...) has no provider in this
  // self-contained composition -- reject with a clear message instead of a
  // late instantiation error.
  let imp_modules = array_empty()
  let imp_names = array_empty()
  let imp_type_indices = new_int_array()
  let imp_type_sigs = array_empty()
  let import_count = parse_core_imports(main_core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)
  let mut ii = 0
  while ii < import_count {
    let im = Array::get(imp_modules, ii)
    let ifn = Array::get(imp_names, ii)
    if im == "wasi_snapshot_preview1" && ifn == "fd_write" {
      ()
    } else if im == "vibe" && (comp_is_host_future_get_import(ifn) || ifn == "host_future_wait" || ifn == "host_future_arm" || ifn == "host_future_wait_any" || ifn == "host_stream_arm" || ifn == "host_sleep_arm" || ifn == "host_future_cancel" || ifn == "host_stream_cancel" || ifn == "host_arg_push" || ifn == "host_sleep_cancel" || ifn == "host_stream_claim" || comp_is_host_stream_get_import(ifn) || ifn == "host_stream_read" || ifn == "host_stream_close" || ifn == "sleep" || ifn == "stderr_write_stream" || (ifn == "process_exit" && comp_core_imports_func(main_core_wasm, "vibe", "stderr_write_stream"))) {
      ()
    } else {
      throw("component(async-hostfuture): core module uses host import '\{im}.\{ifn}' (only fd_write, sleep and the host-future/host-stream imports are satisfiable in this composition)")
    }
    ii = ii + 1
  }
  let hf_names = comp_core_host_future_names(main_core_wasm)
  let nhf = Array::length(hf_names)
  let mut nwit = 0
  let mut wit_i = 0
  while wit_i < nhf {
    if comp_is_wit_future_get_import(Array::get(hf_names, wit_i)) {
      nwit = nwit + 1
    } else {
      ()
    }
    wit_i = wit_i + 1
  }
  // Root futures carry u32 while WIT Future[Int] carries canonical s64. Keep
  // those adapter payload contracts separate instead of silently selecting one
  // width for a mixed program.
  if nwit > 0 && nwit != nhf {
    throw("component(wit-async-import): cannot mix runner-private future<u32> root imports with WIT-derived future<s64> interface imports; migrate all async imports in this component to versioned WIT interfaces")
  } else {
    ()
  }
  let future_s64 = nwit > 0
  let wit_interfaces = comp_wit_future_interfaces(hf_names)
  let nwit_interfaces = Array::length(wit_interfaces)
  // #2066: WIT RESPONSES -- `async func() -> response` whose payload is
  // `record{status: s32, body: stream<u8>}`, declared in the package's
  // `types` interface. The first slice composes them on their own: every
  // future is a response and they share one interface.
  let mut nresp = 0
  let mut resp_i = 0
  while resp_i < nhf {
    if comp_is_wit_response_get_import(Array::get(hf_names, resp_i)) {
      nresp = nresp + 1
    } else {
      ()
    }
    resp_i = resp_i + 1
  }
  let response_mode = nresp > 0
  // #2066: responses may share the component with scalar WIT futures of the
  // same interface (MIXED); the adapter then keys each handle's canon pair and
  // encoding on its kind.
  let mixed = response_mode && nresp != nhf
  let response_kinds: Array[Bool] = []
  if mixed {
    let mut rk_i = 0
    while rk_i < nhf {
      Array::push(response_kinds, comp_is_wit_response_get_import(Array::get(hf_names, rk_i)))
      rk_i = rk_i + 1
    }
  } else {
    ()
  }
  if handler_mode && !response_mode {
    throw("component(service-handler): a serve handler composed with host imports must await a WIT response (`Future[HostResponse]` from a `from_wit` binding); other host futures have no provider behind `wasmtime serve`")
  } else {
    ()
  }
  if response_mode && nwit_interfaces != 1 {
    throw("component(wit-async-import): a component awaiting WIT responses imports every async function from one WIT interface; move the other futures into that interface or split the program")
  } else {
    ()
  }
  // ADR-0089 Decision 3 (#1218): host STREAMS ride the same composition --
  // per-name `stream<u8>` component imports after the future imports, the
  // stream canon pair after the waitable quartet, and the shared adapter
  // (spec §3.18). Either kind alone keys the wrap; the future-only shape
  // is byte-identical to the pre-stream composer.
  let hs_names = comp_core_host_stream_names(main_core_wasm)
  // ADR-0089 Decision 3 follow-up (#1218): only a program that calls
  // `host_stream_close` gets the adapter's drop func, so every stream
  // composition that predates this surface keeps its exact bytes.
  let hs_wants_close = comp_core_imports_host_stream_close(main_core_wasm)
  let nhs = Array::length(hs_names)
  let nt = nhf + nhs
  // #1342: `vibe.sleep` keys this composition too. A sleep-only program used
  // to land in the self-contained trampolined-p1 wrap, which has no `vibe`
  // instance to satisfy it -- and emitted an unvalidatable component with a
  // zero exit status rather than saying so.
  let want_sleep = comp_core_imports_sleep(main_core_wasm)
  if nt == 0 && !want_sleep {
    throw("component(async-hostfuture): core module imports no vibe.host_future_get[$name] / vibe.host_stream_get$name / vibe.sleep (this wrap is keyed on those imports)")
  } else {
    ()
  }
  let tag_mode = comp_core_tag_mode(main_core_wasm)
  let buf = bytebuf_new()
  emit_component_header(buf)
  // Component type indices: root futures use the historical pair. WIT futures
  // use one shared future<s64> type plus one instance type per unique interface.
  // #2066 response mode: 0 = the types interface's instance type, 1 = its
  // exported `payload` record (aliased), 2 = future<payload> for the canon
  // read, 3 = the API instance type, 4 = stream<u8> for the body's canon
  // read. The two instance imports sit between them, in that order.
  let future_type_idx = if response_mode {
    2
  } else {
    0
  }
  let fut_functype_idx = 1
  if response_mode {
    let api_interface = Array::get(wit_interfaces, 0)
    emit_comp_wit_payload_types_instance_type_named(buf, comp_wit_response_payload_descriptor(), comp_wit_response_type_name())
    emit_comp_instance_import_section(buf, comp_wit_types_interface_id(api_interface), 0)
    emit_comp_instance_export_alias_section(buf, 0, comp_wit_response_type_name(), 3)
    bytebuf_push(buf, section_type)
    let fut_content = bytebuf_new()
    leb128_encode_u32(fut_content, 1)
    bytebuf_push(fut_content, 101)
    bytebuf_push(fut_content, 1)
    leb128_encode_u32(fut_content, 1)
    emit_raw_content(buf, fut_content)
    if comp_any_wit_response_arg(hf_names) {
      emit_comp_wit_async_api_type_general(buf, hf_names)
    } else if mixed {
      emit_comp_wit_async_mixed_api_type(buf, comp_wit_future_funcs_of_kind(hf_names, api_interface, true), comp_wit_future_funcs_of_kind(hf_names, api_interface, false))
    } else {
      emit_comp_wit_async_response_api_type(buf, comp_wit_future_funcs(hf_names, api_interface))
    }
    emit_comp_stream_type_section(buf, comp_valtype_u8)
    emit_comp_instance_import_section(buf, api_interface, 3)
    if mixed {
      // 5 = future<s64>, the scalar functions' canon read/drop type
      emit_comp_future_type_section(buf, comp_valtype_s64)
    } else {
      ()
    }
  } else if nhf > 0 {
    emit_comp_future_type_section(buf, if future_s64 {
      comp_valtype_s64
    } else {
      comp_valtype_u32
    })
    if future_s64 {
      let mut wit_ty_i = 0
      while wit_ty_i < nwit_interfaces {
        let interface_id = Array::get(wit_interfaces, wit_ty_i)
        emit_comp_wit_async_future_instance_type(buf, comp_wit_future_funcs(hf_names, interface_id))
        wit_ty_i = wit_ty_i + 1
      }
    } else {
      emit_comp_async_functype_section_result_type(buf, future_type_idx)
    }
  } else {
    ()
  }
  let future_type_count = if mixed {
    6
  } else if response_mode {
    5
  } else if nhf > 0 {
    if future_s64 {
      1 + nwit_interfaces
    } else {
      2
    }
  } else {
    0
  }
  let stream_type_idx = if response_mode {
    4
  } else {
    future_type_count
  }
  // #2066: response mode already declared `stream<u8>` (type 4) for the
  // body, so a named stream there adds only its getter's functype.
  let stream_functype_idx = if response_mode {
    future_type_count
  } else {
    stream_type_idx + 1
  }
  let stream_type_slots = if nhs == 0 {
    0
  } else if response_mode {
    1
  } else {
    2
  }
  if nhs > 0 {
    if response_mode {
      ()
    } else {
      emit_comp_stream_type_section(buf, comp_valtype_u8)
    }
    emit_comp_async_functype_section_result_type(buf, stream_type_idx)
  } else {
    ()
  }
  // #1342: `sleep-for: async func(ms: u32) -> u32`. Unlike the future/stream
  // imports this one takes a PARAM (the delay) and has no future value type of
  // its own, so it is one functype and no defined type. Both halves may be
  // absent, so count the emitted types rather than assuming a fixed offset.
  let sleep_functype_idx = future_type_count + stream_type_slots
  if want_sleep {
    emit_comp_async_functype_params(buf, ["ms"], [comp_valtype_u32], comp_valtype_u32)
  } else {
    ()
  }
  let export_functype_idx = if want_sleep {
    sleep_functype_idx + 1
  } else {
    sleep_functype_idx
  }
  // One component import per host future then per host stream, each kind in
  // its core module's declaration order, so component func index i is the
  // import the composer's lowered core func i belongs to. `sleep-for` follows
  // them, so it is component func index nt.
  if response_mode {
    ()
  } else if future_s64 {
    let mut wi = 0
    while wi < nwit_interfaces {
      emit_comp_instance_import_section(buf, Array::get(wit_interfaces, wi), 1 + wi)
      wi = wi + 1
    }
  } else {
    let mut himp_i = 0
    while himp_i < nhf {
      let core_name = Array::get(hf_names, himp_i)
      emit_comp_import_section_typed(buf, comp_hostfuture_import_label(core_name), fut_functype_idx)
      himp_i = himp_i + 1
    }
  }
  let mut simp_i = 0
  while simp_i < nhs {
    emit_comp_import_section_typed(buf, comp_hoststream_import_label(Array::get(hs_names, simp_i)), stream_functype_idx)
    simp_i = simp_i + 1
  }
  if want_sleep {
    emit_comp_import_section_typed(buf, "sleep-for", sleep_functype_idx)
  } else {
    ()
  }
  let nimports = if want_sleep {
    nt + 1
  } else {
    nt
  }
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_memhost_module())
  // #1537: tasks awaiting host futures wait on them together.
  let want_wait_any = comp_core_imports_vibe_name(main_core_wasm, "host_future_arm") || comp_core_imports_vibe_name(main_core_wasm, "host_future_wait_any")
  let want_stream_arm = comp_core_imports_vibe_name(main_core_wasm, "host_stream_arm")
  let want_sleep_arm = comp_core_imports_vibe_name(main_core_wasm, "host_sleep_arm")
  let want_cancel = comp_core_imports_vibe_name(main_core_wasm, "host_future_cancel")
  if want_cancel && nhf == 0 {
    throw("component(async-hostfuture): core module imports vibe.host_future_cancel without a host future")
  } else {
    ()
  }
  let want_stream_cancel = comp_core_imports_vibe_name(main_core_wasm, "host_stream_cancel")
  let want_arg_push = comp_core_imports_vibe_name(main_core_wasm, "host_arg_push")
  let want_timer_cancel = comp_core_imports_vibe_name(main_core_wasm, "host_sleep_cancel")
  if want_sleep_arm && !want_sleep {
    throw("component(async-hostfuture): core module imports vibe.host_sleep_arm without vibe.sleep; the timer arm lowers through the sleep half")
  } else {
    ()
  }
  // #1537: an entry whose row carries `Exception` exits through its boundary
  // (stderr diagnosis, then process_exit); the adapter serves both as
  // trapping stubs, as the p1 wrap does (#2976). A program's own
  // process_exit without the boundary's stderr import was refused above.
  let exit_stubs: Array[String] = []
  if comp_core_imports_func(main_core_wasm, "vibe", "stderr_write_stream") {
    Array::push(exit_stubs, "stderr_write_stream")
  } else {
    ()
  }
  if comp_core_imports_func(main_core_wasm, "vibe", "process_exit") {
    Array::push(exit_stubs, "process_exit")
  } else {
    ()
  }
  emit_core_module_section(buf, comp_generate_hostfuture_adapter_core_module(hf_names, hs_names, hs_wants_close, want_sleep, tag_mode, future_s64, response_mode, want_wait_any, want_stream_arm, want_sleep_arm, want_cancel, want_stream_cancel, response_kinds, want_arg_push, want_timer_cancel, exit_stubs, comp_core_imports_vibe_name(main_core_wasm, "host_stream_claim")))
  if handler_mode {
    emit_core_module_section(buf, comp_generate_string_trampoline_packed_async_opt(handler_string_count, export_name, true))
  } else {
    emit_core_module_section(buf, comp_generate_async_trampoline_hostfuture())
  }
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  // A component-instance export alias must follow embedded core-module
  // sections. Root function imports need no alias; the WIT instance route does.
  if future_s64 {
    let mut wai = 0
    while wai < nhf {
      let core_name = Array::get(hf_names, wai)
      let interface_id = comp_wit_future_interface(core_name)
      let instance_idx = if response_mode {
        1
      } else {
        comp_string_array_index(wit_interfaces, interface_id)
      }
      emit_comp_instance_export_alias_section(buf, instance_idx, comp_wit_future_func(core_name), comp_extern_func)
      wai = wai + 1
    }
  } else {
    ()
  }
  let memhost_inst = 0
  emit_core_instance_instantiate_section(buf, 1, array_empty())
  let mem_alias_idx = 0
  emit_alias_section(buf, memhost_inst, ["memory"], [core_sort_mem])
  // Core func indices 0..K+L-1: the lowered imports, emitted in the same
  // order (futures then streams; the root instance exports map them by
  // name for the adapter).
  // #1537: WIT futures are INSTANCE export aliases, which follow the core
  // module sections, so a root `sleep-for` import (declared with the imports,
  // before them) is component func 0 and the futures are 1..K. Root futures
  // and streams keep the historical order (imports i, then sleep-for at nt).
  // Named streams are ROOT imports too, so with WIT futures the component
  // funcs run: streams 0..L-1, `sleep-for` at L, then the futures' aliases.
  // The lowers keep the core order (futures, then streams).
  let wit_root_funcs = if future_s64 {
    nhs + (if want_sleep {
      1
    } else {
      0
    })
  } else {
    0
  }
  let mut hlow_i = 0
  while hlow_i < nt {
    let comp_func = if !future_s64 {
      hlow_i
    } else if hlow_i < nhf {
      wit_root_funcs + hlow_i
    } else {
      hlow_i - nhf
    }
    emit_canon_lower_async_section(buf, comp_func, mem_alias_idx)
    hlow_i = hlow_i + 1
  }
  let fut_extra = if mixed {
    4
  } else if nhf > 0 {
    2
  } else {
    0
  }
  if nhf > 0 {
    emit_canon_future_read(buf, future_type_idx, mem_alias_idx)
    emit_canon_future_drop_readable(buf, future_type_idx)
  } else {
    ()
  }
  if mixed {
    emit_canon_future_read(buf, 5, mem_alias_idx)
    emit_canon_future_drop_readable(buf, 5)
  } else {
    ()
  }
  // Core func index bookkeeping past the lowers: (future read/drop when
  // K > 0), task-return, the waitable quartet, then (stream read/drop when
  // L > 0), then the two aliases below. K-only reproduces the pre-stream
  // indices exactly (task-return = K+2, quartet K+3..K+6, run K+7/K+8).
  let task_return_core_idx = nt + fut_extra
  emit_canon_task_return(buf, comp_valtype_u32)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, mem_alias_idx)
  emit_canon_waitable_set_drop(buf)
  let stream_read_core_idx = task_return_core_idx + 5
  // #2066: a response body is a stream too, so response mode needs the
  // stream canon pair even with no named stream.
  let stream_half = nhs > 0 || response_mode
  if stream_half {
    emit_canon_stream_read(buf, stream_type_idx, mem_alias_idx)
    emit_canon_stream_drop_readable(buf, stream_type_idx)
  } else {
    ()
  }
  // #1342: the sleep half's canon defs come after everything else, so a
  // composition without sleep keeps its exact core func indices.
  let sleep_lower_core_idx = if stream_half {
    stream_read_core_idx + 2
  } else {
    task_return_core_idx + 5
  }
  if want_sleep {
    emit_canon_lower_async_section(buf, if future_s64 {
      nhs
    } else {
      nt
    }, mem_alias_idx)
    emit_canon_subtask_drop(buf)
  } else {
    ()
  }
  // #1537: the cancel half's canon def, after the sleep pair.
  let cancel_read_core_idx = if want_sleep {
    sleep_lower_core_idx + 2
  } else {
    sleep_lower_core_idx
  }
  if want_cancel {
    emit_canon_future_cancel_read(buf, future_type_idx)
    if mixed {
      emit_canon_future_cancel_read(buf, 5)
    } else {
      ()
    }
  } else {
    ()
  }
  let scancel_read_core_idx = if want_cancel {
    if mixed {
      cancel_read_core_idx + 2
    } else {
      cancel_read_core_idx + 1
    }
  } else {
    cancel_read_core_idx
  }
  if want_stream_cancel {
    if !stream_half {
      throw("component(async-hostfuture): core module imports vibe.host_stream_cancel without a host stream")
    } else {
      ()
    }
    emit_canon_stream_cancel_read(buf, stream_type_idx)
  } else {
    ()
  }
  // #1537: the timer cancel half's canon def, last of all.
  let subtask_cancel_core_idx = if want_stream_cancel {
    scancel_read_core_idx + 1
  } else {
    scancel_read_core_idx
  }
  if want_timer_cancel {
    emit_canon_subtask_cancel(buf)
  } else {
    ()
  }
  // #3131: the WIT slot half's subtask pair, last of all.
  let wit_subtask_core_idx = if want_timer_cancel {
    subtask_cancel_core_idx + 1
  } else {
    subtask_cancel_core_idx
  }
  if future_s64 {
    emit_canon_subtask_drop(buf)
    emit_canon_subtask_cancel(buf)
  } else {
    ()
  }
  let root_inst = 1
  // $root's exports: the K lowered imports under the adapter's
  // `[async-lower]<label>` spellings, then the shared read/drop (named after
  // the FIRST label -- one canon def covers every future<u32>) and the
  // waitable-set quartet. task-return (core func K+2) is not here: it goes
  // to the trampoline through cm-arg below.
  let root_export_names = array_empty()
  let root_export_indices = new_int_array()
  let mut rex_i = 0
  while rex_i < nhf {
    Array::push(root_export_names, String::concat("[async-lower]", comp_hostfuture_import_label(Array::get(hf_names, rex_i))))
    Array::push(root_export_indices, rex_i)
    rex_i = rex_i + 1
  }
  if nhf > 0 {
    let hf_first_label = comp_hostfuture_import_label(Array::get(hf_names, 0))
    Array::push(root_export_names, String::concat("[async-lower][future-read-0]", hf_first_label))
    Array::push(root_export_indices, nt)
    Array::push(root_export_names, String::concat("[future-drop-readable-0]", hf_first_label))
    Array::push(root_export_indices, nt + 1)
    if mixed {
      let hf_scalar_label = comp_hostfuture_import_label(Array::get(hf_names, comp_first_kind_index(response_kinds, false)))
      Array::push(root_export_names, String::concat("[async-lower][future-read-1]", hf_scalar_label))
      Array::push(root_export_indices, nt + 2)
      Array::push(root_export_names, String::concat("[future-drop-readable-1]", hf_scalar_label))
      Array::push(root_export_indices, nt + 3)
    } else {
      ()
    }
  } else {
    ()
  }
  Array::push(root_export_names, "[waitable-set-new]")
  Array::push(root_export_indices, task_return_core_idx + 1)
  Array::push(root_export_names, "[waitable-join]")
  Array::push(root_export_indices, task_return_core_idx + 2)
  Array::push(root_export_names, "[waitable-set-wait]")
  Array::push(root_export_indices, task_return_core_idx + 3)
  Array::push(root_export_names, "[waitable-set-drop]")
  Array::push(root_export_indices, task_return_core_idx + 4)
  let mut srex_i = 0
  while srex_i < nhs {
    Array::push(root_export_names, String::concat("[async-lower]", comp_hoststream_import_label(Array::get(hs_names, srex_i))))
    Array::push(root_export_indices, nhf + srex_i)
    srex_i = srex_i + 1
  }
  if stream_half {
    let hs_first_label = if nhs > 0 {
      comp_hoststream_import_label(Array::get(hs_names, 0))
    } else {
      comp_response_stream_label()
    }
    Array::push(root_export_names, String::concat("[async-lower][stream-read-0]", hs_first_label))
    Array::push(root_export_indices, stream_read_core_idx)
    Array::push(root_export_names, String::concat("[stream-drop-readable-0]", hs_first_label))
    Array::push(root_export_indices, stream_read_core_idx + 1)
  } else {
    ()
  }
  if want_sleep {
    Array::push(root_export_names, "[async-lower]sleep-for")
    Array::push(root_export_indices, sleep_lower_core_idx)
    Array::push(root_export_names, "[subtask-drop]")
    Array::push(root_export_indices, sleep_lower_core_idx + 1)
  } else {
    ()
  }
  if want_cancel {
    Array::push(root_export_names, String::concat("[future-cancel-read-0]", comp_hostfuture_import_label(Array::get(hf_names, 0))))
    Array::push(root_export_indices, cancel_read_core_idx)
    if mixed {
      Array::push(root_export_names, String::concat("[future-cancel-read-1]", comp_hostfuture_import_label(Array::get(hf_names, comp_first_kind_index(response_kinds, false)))))
      Array::push(root_export_indices, cancel_read_core_idx + 1)
    } else {
      ()
    }
  } else {
    ()
  }
  if want_stream_cancel {
    Array::push(root_export_names, String::concat("[stream-cancel-read-0]", if nhs > 0 {
      comp_hoststream_import_label(Array::get(hs_names, 0))
    } else {
      comp_response_stream_label()
    }))
    Array::push(root_export_indices, scancel_read_core_idx)
  } else {
    ()
  }
  if want_timer_cancel {
    Array::push(root_export_names, "[subtask-cancel]")
    Array::push(root_export_indices, subtask_cancel_core_idx)
  } else {
    ()
  }
  if future_s64 {
    Array::push(root_export_names, "[subtask-drop-wit]")
    Array::push(root_export_indices, wit_subtask_core_idx)
    Array::push(root_export_names, "[subtask-cancel-wit]")
    Array::push(root_export_indices, wit_subtask_core_idx + 1)
  } else {
    ()
  }
  emit_core_instance_from_exports(buf, 1, [Array::length(root_export_names)], root_export_names, root_export_indices)
  let env_inst = 2
  emit_core_instance_from_exports_sorted(buf, ["memory"], [core_sort_mem], [
    mem_alias_idx
  ])
  let adapter_inst = 3
  emit_core_instance_instantiate_args(buf, 2, ["$root", "env"], [
    root_inst,
    env_inst
  ])
  let stub_inst = 4
  emit_core_instance_instantiate_section(buf, 4, array_empty())
  let main_inst = 5
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    stub_inst,
    adapter_inst
  ])
  let main_run_func_idx = if future_s64 {
    wit_subtask_core_idx + 2
  } else {
    wit_subtask_core_idx
  }
  if handler_mode {
    comp_emit_service_handler_export(buf, main_inst, main_run_func_idx, handler_target, export_name, handler_params, stream_type_idx, export_functype_idx, nimports)
  } else {
    emit_alias_section(buf, main_inst, ["run"], [core_sort_func])
    let main_arg_inst = 6
    emit_core_instance_from_exports(buf, 1, [1], ["run"], [main_run_func_idx])
    let cm_arg_inst = 7
    emit_core_instance_from_exports(buf, 1, [1], ["task-return"], [
      task_return_core_idx
    ])
    let tramp_inst = 8
    emit_core_instance_instantiate_args(buf, 3, ["main", "cm"], [
      main_arg_inst,
      cm_arg_inst
    ])
    emit_comp_async_functype_section(buf, comp_valtype_u32)
    let tramp_run_func_idx = main_run_func_idx + 1
    emit_alias_section(buf, tramp_inst, ["run"], [core_sort_func])
    emit_canon_lift_async_section(buf, tramp_run_func_idx, export_functype_idx)
    emit_comp_export_section(buf, export_name, nimports)
  }
  bytebuf_to_bytes(buf)
}

/// Validation fixture for #2064's first end-to-end WIT-derived import route.
/// The synthetic core carries the same metadata import linked_compile will
/// eventually derive from parsed WIT, then the production composer turns it
/// into a versioned interface instance import and the s64 future adapter.
export fn comp_emit_component_wasm_async_wit_future_fixture() -> Bytes with Exception {
  comp_emit_component_wasm_async_hostfuture(comp_generate_async_wit_future_fixture_core(false), "run")
}

/// Negative fixture: the payload widths differ, so mixed root/WIT futures must
/// fail with the composer's migration diagnostic before any component is emit.
export fn comp_emit_component_wasm_async_wit_future_mixed_fixture() -> Bytes with Exception {
  comp_emit_component_wasm_async_hostfuture(comp_generate_async_wit_future_fixture_core(true), "run")
}

fn comp_generate_async_wit_future_fixture_core(include_root: Bool) -> Bytes {
  let core = bytebuf_new()
  emit_header(core)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [127, 127, 127, 127], [127])
  emit_func_type_raw(tc, [126], [126])
  emit_func_type_raw(tc, array_empty(), [126])
  bytebuf_push_section(core, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, if include_root {
    6
  } else {
    5
  })
  emit_name(ic, "wasi_snapshot_preview1")
  emit_name(ic, "fd_write")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_wait")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "vibe")
  emit_name(ic, "wit_future_get$example:prices/api@1.0.0#get-price")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "vibe")
  emit_name(ic, "wit_future_get$example:prices/api@1.0.0#get-tax")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "vibe")
  emit_name(ic, "wit_future_get$example:inventory/api@2.1.0#get-stock")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  if include_root {
    emit_name(ic, "vibe")
    emit_name(ic, "host_future_get$legacy")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 2)
  } else {
    ()
  }
  bytebuf_push_section(core, 2, ic)
  emit_function_section(core, [1])
  emit_export_section(core, "run", if include_root {
    6
  } else {
    5
  })
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(core, [body])
  let tagged = bytebuf_new()
  bytebuf_push_buf(tagged, core)
  let metadata = bytebuf_new()
  emit_name(metadata, "vibe.tagmode")
  bytebuf_push(metadata, 1)
  bytebuf_push(metadata, 0)
  bytebuf_push(metadata, 0)
  bytebuf_push(metadata, 0)
  bytebuf_push_section(tagged, 0, metadata)
  bytebuf_to_bytes(tagged)
}

/// #1540 scope 4: the serve component for a handler whose last parameter is a
/// `HostStream` -- the request body, read without ever materializing it.
///
/// This is the join of everything the issue built: the async lift and string
/// `task.return` of the sync-shaped async lane, the stream parameter's
/// type-index encoding, the trampoline that tags the handle, and the adapter
/// above that turns `vibe.host_stream_read` into real canon calls.
///
/// TWO memories, on purpose. The canons need one for the read landing slot and
/// the wait payload; the only other memory here is the vibe heap, and fixed
/// addresses in that would corrupt whatever the program had there. So the
/// canons get a memhost page and `task.return` / the lift keep the MAIN memory,
/// which is where the result string and the lowered params actually live.
///
/// Nothing here is a cycle: the adapter depends on the canons, main depends on
/// the adapter, the trampoline depends on main -- and only the trampoline
/// imports `[task-return]`, so the memory that canon needs (main's) exists
/// before the instance that imports it.
///
/// Index layout, in emission order:
///   core module    0 = main, 1 = trampoline, 2 = host stub, 3 = adapter,
///                  4 = memhost
///   core memory    0 = memhost page, 1 = main memory
///   core func      0..5 = stream.read, drop-readable, ws.new, join, ws.wait,
///                  ws.drop; 6 = adapter's host_stream_read,
///                  7 = adapter's host_stream_close; 8 = main's target;
///                  9 = task.return; 10 = canon_func, 11 = cabi_realloc
///   core instance  0 = memhost, 1 = $root, 2 = adapter env, 3 = adapter,
///                  4 = stub, 5 = vibe imports, 6 = main, 7 = tramp env,
///                  8 = [export]$root, 9 = trampoline
///   component type 0 = stream u8, 1 = the async functype
export fn comp_emit_component_wasm_stream_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  if comp_core_awaits_host_future(core_wasm) {
    comp_emit_component_wasm_service_handler(core_wasm, target_func_name, export_name, param_names)
  } else {
    comp_emit_component_wasm_stream_handler_plain(core_wasm, target_func_name, export_name, param_names)
  }
}

fn comp_emit_component_wasm_stream_handler_plain(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception {
  comp_require_tag_mode(core_wasm, 0, "component(async-stream-handler)")
  comp_check_stream_handler_vibe_imports(core_wasm)
  let string_param_count = Array::length(param_names) - 1
  comp_check_stream_handler_target(core_wasm, target_func_name, string_param_count)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, comp_generate_string_trampoline_packed_async_opt(string_param_count, export_name, true))
  emit_core_module_section(buf, comp_generate_host_stub_module(array_empty(), array_empty()))
  emit_core_module_section(buf, comp_generate_serve_stream_adapter_module())
  emit_core_module_section(buf, comp_generate_memhost_module())
  emit_core_instance_instantiate_section(buf, 4, array_empty())
  emit_alias_section(buf, 0, ["memory"], [core_sort_mem])
  emit_comp_stream_type_section(buf, comp_valtype_u8)
  emit_canon_stream_read(buf, 0, 0)
  emit_canon_stream_drop_readable(buf, 0)
  emit_canon_waitable_set_new(buf)
  emit_canon_waitable_join(buf)
  emit_canon_waitable_set_wait(buf, 0)
  emit_canon_waitable_set_drop(buf)
  emit_core_instance_from_exports_sorted(buf, [
    "[async-lower][stream-read-0]body",
    "[stream-drop-readable-0]body",
    "[waitable-set-new]",
    "[waitable-join]",
    "[waitable-set-wait]",
    "[waitable-set-drop]"
  ], [
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func,
    core_sort_func
  ], [0, 1, 2, 3, 4, 5])
  emit_core_instance_from_exports_sorted(buf, ["memory"], [core_sort_mem], [0])
  emit_core_instance_instantiate_args(buf, 3, ["$root", "env"], [1, 2])
  emit_core_instance_instantiate_section(buf, 2, array_empty())
  emit_alias_section(buf, 3, ["host_stream_read", "host_stream_close"], [
    core_sort_func,
    core_sort_func
  ])
  // BOTH halves in the `vibe` instance. A handler that stops reading early
  // lowers `host_stream_close` to a core import of that name, and a core
  // instance cannot be given fewer bindings than it imports -- so leaving the
  // close half out would make "read four bytes and hang up" a shape this lane
  // refuses to compose. Handing over a binding the core never imports is free.
  emit_core_instance_from_exports(buf, 1, [2], [
    "host_stream_read",
    "host_stream_close"
  ], [6, 7])
  emit_core_instance_instantiate_args(buf, 0, ["wasi_snapshot_preview1", "vibe"], [
    4,
    5
  ])
  emit_alias_section(buf, 6, [target_func_name], [core_sort_func])
  emit_alias_section(buf, 6, ["memory"], [core_sort_mem])
  emit_alias_section(buf, 6, ["__heap_ptr"], [core_sort_global])
  // Memory 1 is main's: the result string the lift reads lives in the vibe
  // heap, not in the memhost page the canons use.
  emit_canon_task_return_opts(buf, comp_valtype_string, 1, true)
  emit_core_instance_from_exports_sorted(buf, [
    "target_func",
    "__heap_ptr",
    "memory"
  ], [core_sort_func, core_sort_global, core_sort_mem], [8, 0, 1])
  emit_core_instance_from_exports(buf, 1, [1], [
    String::concat("[task-return]", export_name)
  ], [9])
  emit_core_instance_instantiate_args(buf, 1, ["env", "[export]$root"], [7, 8])
  emit_alias_section(buf, 9, ["canon_func", "cabi_realloc"], [
    core_sort_func,
    core_sort_func
  ])
  let comp_param_valtypes = new_int_array()
  let mut pt = 0
  while pt < string_param_count {
    Array::push(comp_param_valtypes, comp_valtype_string)
    pt = pt + 1
  }
  // The body param's valtype is the stream TYPE INDEX (0), not a primitive.
  Array::push(comp_param_valtypes, 0)
  emit_comp_async_functype_params(buf, param_names, comp_param_valtypes, comp_valtype_string)
  emit_canon_lift_async_opts(buf, 10, 1, 1, 11, true)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}
