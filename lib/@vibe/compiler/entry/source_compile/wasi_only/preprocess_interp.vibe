//# Imports

import @vibe/compiler/core {
  Stmt
}

import ./preprocess_interp_rewrite.vibe {
  rewrite_interp
}

import @vibe/compiler/codegen {
  desugar_trait_dicts
}

//# Functions

/// The interpolation half of `expand_interp_stmts`, WITHOUT its trait
/// dictionary desugar (#3069, #3098). A lane that checks the program must
/// expand interpolation first (the render-offset tables are keyed on the
/// `__to_string` calls the expansion writes), then check, and only then
/// desugar: running the desugar before the check hands the checker its own
/// output -- impl methods rewritten against `Self` (``no impl `T` for `Self` ``),
/// bounded generics carrying synthesized `__dict_<Trait>_<T>` parameters (the
/// reserved-prefix rule), and `[T: Eq]` already dispatched through
/// `EqDict::equals` at arity 3.
export fn expand_interp_only(stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr))),
      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr))),
      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr))),
      _ => ()
    }
    i = i + 1
  }
}

/// Interpolation expansion followed by the trait-dictionary desugar. Only for
/// a caller that does NOT check the program afterwards (`vibe check
/// --single-file` checks before it calls this); a checking lane uses
/// `expand_interp_only` and desugars after its check.
export fn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with Exception {
  expand_interp_only(stmts)
  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the
  // program declares a trait with method signatures.
  desugar_trait_dicts(stmts)
}
