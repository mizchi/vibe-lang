//# Imports

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/entry/source_compile/rewrite {
  expand_interp_only
}

import @vibe/compiler/codegen {
  desugar_trait_dicts
}

import @vibe/compiler/normalize {
  desugar_trait_dicts_with_typed_eq
}

export ../rewrite {
  expand_interp_only, strip_generic_type_params
}

//# Functions

/// Interpolation expansion followed by the trait-dictionary desugar. Only for
/// a caller that does NOT check the program afterwards (`vibe check
/// --single-file` checks before it calls this); a checking lane uses
/// `expand_interp_only` and desugars after its check.
export fn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with Exception {
  expand_interp_only(stmts)
  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the
  // program declares a trait with method signatures.
  desugar_trait_dicts(stmts)
}

/// #3456: the same, for a caller whose check handed it the typed rows for
/// these statements (`check_program_double_call_result_located_observation`
/// on a located parse). An untyped shadowing `let` then renders through the
/// type the checker gave it, as on the build lanes; without the rows it is
/// read through the outer binding's type, and `vibe check --single-file`
/// refused `"\{b}"` for a `b: Raw` rebound to an `Int` that the build
/// compiles, and missed the refusal the other way round.
export fn expand_interp_stmts_with_rows(stmts: Array[Stmt], typed_eq_offsets: Array[Int], typed_eq_keys: Array[String]) -> Unit with Exception {
  expand_interp_only(stmts)
  desugar_trait_dicts_with_typed_eq(stmts, typed_eq_offsets, typed_eq_keys)
}
