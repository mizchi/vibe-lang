import @vibe/compiler/syntax {
  lex, parse_program
}
import @vibe/compiler/entry/source_compile/wasi_only {
  entry_declares_async_int
}

fn parse_entry(source: String) -> Array[Stmt] with Exception {
  parse_program(lex(source))
}

test "async component entry detection uses exact effect labels (#1289)" {
  let exact = parse_entry("fn run() -> Int with Async { 0 }")
  let mixed = parse_entry("fn run() -> Int with Fs + Async { 0 }")
  let prefixed = parse_entry("fn run() -> Int with NotAsync { 0 }")
  let suffixed = parse_entry("fn run() -> Int with AsyncLike { 0 }")
  assert(entry_declares_async_int(exact, "run"))
  assert(entry_declares_async_int(mixed, "run"))
  assert(!entry_declares_async_int(prefixed, "run"))
  assert(!entry_declares_async_int(suffixed, "run"))
}
