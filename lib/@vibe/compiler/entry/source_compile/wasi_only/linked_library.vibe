//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_linked_impl_with_typed_offsets
}

import @vibe/compiler/codegen/common_base {
  codegen_body_cache_discard, codegen_body_cache_new, empty_dbg_prov
}

import @vibe/compiler/core {
  Expr, Stmt, path_set_new
}

import @vibe/compiler/syntax {
  lex, parse_program
}

import ./merge_sources.vibe {
  collect_located_merged_stmts
}

import ./path_utils.vibe {
  empty_stmt_array
}

import ./preprocess.vibe {
  expand_interp_only, strip_generic_type_params
}

import ./preprocess_compile.vibe {
  source_offsets
}

import @vibe/compiler/normalize {
  desugar_trait_dicts_with_typed_eq
}

//# Functions

export fn compile_file_wasi_library(dep_path: String) -> Bytes with Env + Exception + Fs {
  let stmts = empty_stmt_array()
  let visited = path_set_new()
  // #3625: located and rebased into one offset space, so the check below
  // answers with typed tables, as on the single-source lane.
  collect_located_merged_stmts(dep_path, stmts, visited)
  // #3098: interpolation only, then check, then the trait-dictionary desugar,
  // then strip generic binders -- the #3069 order. Desugaring before the check
  // handed the checker its own lowering, so a library with a trait impl or a
  // `[T: Tr]` function was refused (``no impl `Tr` for `Self` ``, the
  // `__dict_` reserved-prefix rule, `EqDict::equals` at arity 3).
  expand_interp_only(stmts)
  // Check before stripping generic type params (see merge_sources.vibe).
  // #3625: the Double/`Float` value offsets codegen reads, the render rows
  // that type an interpolated untyped shadow (#3456), and the `Float`
  // arithmetic rows the desugar rounds to f32 (#3543).
  let (float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys, _) = source_offsets(stmts)
  desugar_trait_dicts_with_typed_eq(stmts, eq_offsets, eq_keys)
  strip_generic_type_params(stmts)
  compile_wasi_module_linked_impl_with_typed_offsets(stmts, "_start", array_empty(), array_empty(), true, false, false, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_discard(), 0, 0 - 1, float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys)
}
