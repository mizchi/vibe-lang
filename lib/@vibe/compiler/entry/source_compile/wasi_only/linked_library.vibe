//# Imports

import ../../../checker/index.vibe {
  check_program
}

import ../../../codegen/wasi {
  compile_wasi_module_linked_impl
}

import ../../../codegen/common_base {
  empty_dbg_prov
}

import ../../../core/ast.vibe {
  Expr, Stmt
}

import ../../../syntax {
  lex, parse_program
}
import ../../../module_graph_path.vibe {
  path_set_new
}

import ./merge_sources.vibe {
  collect_merged_stmts_recursive
}

import ./path_utils.vibe {
  empty_stmt_array
}

import ./preprocess.vibe {
  expand_interp_stmts, strip_generic_type_params
}

//# Functions

export fn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs } {
  let stmts = empty_stmt_array()
  let visited = path_set_new()
  collect_merged_stmts_recursive(dep_path, stmts, visited)
  expand_interp_stmts(stmts)
  // Check before stripping generic type params (see merge_sources.vibe).
  let _ = check_program(stmts)
  strip_generic_type_params(stmts)
  compile_wasi_module_linked_impl(stmts, "_start", Array::slice([
    ("", "")
  ], 0, 0), Array::slice([
    ("", "", 0, 0)
  ], 0, 0), true, false, false, false, false, false, empty_dbg_prov())
}
