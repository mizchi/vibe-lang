//# Imports

import @vibe/compiler/core {
  Expr, Stmt
}

import @vibe/compiler/syntax {
  parse_stmt, Token
}
//# Functions

export fn parse_interp_expr(tokens: Array[Token]) -> Expr with { Error } {
  let (stmt, _) = parse_stmt(tokens, [], 0)
  match stmt {
    SExpr(expr) => expr,
    _ => throw("expected interpolation expression")
  }
}
