//# Imports

import @vibe/compiler/core {
  Expr, Stmt
}

import @vibe/compiler/syntax {
  Token, parse_stmt
}
//# Functions

export fn parse_interp_expr(tokens: Array[Token]) -> Expr with Exception {
  let (stmt, _) = parse_stmt(tokens, [
  ], 0)
  match stmt {
    SExpr(expr) => expr,
    _ => throw("expected interpolation expression")
  }
}
