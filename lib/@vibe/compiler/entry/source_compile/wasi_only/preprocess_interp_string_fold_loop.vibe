//# Imports

import ../../../core/index.vibe {
  Expr
}

//# Functions

fn concat_exprs(lhs: Expr, rhs: Expr) -> Expr {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, lhs)
  ArrayBuilder::push(b, rhs)
  let args = ArrayBuilder::freeze(b)
  ECall(EIdent("String::concat", -1), args, -1)
}

export fn fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {
  let mut result = result0
  let mut j = j0
  while j < result_len {
    let rhs = Array::get(result_arr, j)
    result = concat_exprs(result, rhs)
    j = j + 1
  }
  result
}
