//# Imports

import @vibe/compiler/core {
  Expr
}

import ./preprocess_interp_string_collect.vibe {
  collect_interp_exprs
}

import ./preprocess_interp_string_fold.vibe {
  fold_interp_exprs
}

//# Functions

export fn rewrite_interp_string(parts: Array[String]) -> Expr with Error {
  let result_arr = collect_interp_exprs(parts)
  fold_interp_exprs(result_arr)
}
