//# Functions

/// M1b-2c (docs/internal/design/wasi-p3-async.md): does the entry declare
/// `() -> Int with Async` (no params)? If so its compiled core wasm should be
/// wrapped into an async-lifted WASM component. Detected from the declared TyFn
/// effect annotation (before generic-param stripping).
fn entry_expr_declares_async_int(value: Expr) -> Bool {
  match value {
    EFn(_, _, params, ret, eff, _) => match ret {
      Some(TyName(rn)) => rn == "Int" && Array::length(params) == 0 && match eff {
        Some(row) => effect_row_contains_label(Some(row), "Async"),
        None => false
      },
      _ => false
    },
    _ => false
  }
}

export fn entry_declares_async_int(stmts: Array[Stmt], entry_name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, opt_ty, value) => if name == entry_name {
        // Flattened patterns: the pinned selfhost seed does not bind variables
        // inside nested constructor patterns (e.g. `Some(ty)` as a sub-pattern),
        // so match each Option level separately to stay seed-buildable
        // (docs/selfhost-bootstrap.md, new-feature rule).
        match opt_ty {
          Some(ty) => match ty {
            TyFn(params, ret, opt_eff) => match opt_eff {
              Some(eff) => if effect_row_contains_label(Some(eff), "Async") && Array::length(params) == 0 {
                match ret {
                  TyName(rn) => if rn == "Int" {
                    found = true
                  } else {
                    ()
                  },
                  _ => ()
                }
              } else {
                ()
              },
              None => ()
            },
            _ => ()
          },
          None => if entry_expr_declares_async_int(value) {
            // `fn run() -> Int with Async { ... }` stores its signature on the
            // EFn rather than an SLet annotation. #1539's public source gate
            // uses that canonical spelling, so detect both AST forms.
            found = true
          } else {
            ()
          }
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Wrap the core wasm into an async component when the entry is async. The
/// trampoline imports/aliases the main export by name "run", so this narrow PoC
/// only triggers for an entry named "run".
///
/// ADR-0089 step 4 (#1218): a program that calls `host_future_get` compiles
/// to a core importing `vibe.host_future_get` -- route THAT core to the
/// host-future composition (adapter-provided imports + `get-future`
/// component import + u32 lift, driven by viberun); everything else keeps
/// the self-contained trampolined-p1 shape byte-identically.
fn stdin_provider_component_only_diagnostic(mode: String) -> String {
  String::concat("StdinStream is component-only; ", String::concat(mode, " cannot emit its component-private stdin provider imports. Use an Async component entry named run without this instrumentation mode"))
}

/// Reject an exact compiled-core stdin-provider import before a caller can
/// publish that core as a standalone artifact. The import detector parses the
/// core import section; it does not guess from source names, so shadowed/user
/// identifiers cannot trigger this boundary.
export fn reject_stdin_provider_core(bytes: Bytes, mode: String) -> Bytes with Exception {
  if comp_core_imports_stdin_provider(bytes) {
    throw(stdin_provider_component_only_diagnostic(mode))
  } else {
    bytes
  }
}

/// Route an arbitrary compiled core through the production stdin-provider
/// composer when (and only when) its parsed imports contain the exact private
/// provider ABI. Used by the import-resolving CLI lane, whose frontend cannot
/// use compile_source_wasi_only's source-local async wrapper decision.
export fn maybe_wrap_stdin_provider_core(bytes: Bytes, entry_name: String) -> Bytes with Exception {
  if comp_core_imports_stdin_provider(bytes) {
    if entry_name == "run" {
      comp_emit_component_wasm_async_stdin_provider(bytes, "run")
    } else {
      throw("StdinStream is component-only and requires an Async component entry named run")
    }
  } else if entry_name == "run" && (comp_core_imports_host_future(bytes) || comp_core_imports_host_stream(bytes)) {
    // #2064: the file lane composes the host-future / host-stream adapter too,
    // as `maybe_wrap_async_component` does on the single-file lane. Without
    // it, a program that imports its bindings -- the WIT-derived ones of
    // `from_wit_future_imports` among them -- compiled to a core module whose
    // `vibe.*_get$` imports nothing can satisfy. Keyed on the imports the core
    // actually has: an `Async` `run` entry that awaits no host future or
    // stream is left as it was.
    comp_emit_component_wasm_async_hostfuture(bytes, "run")
  } else {
    bytes
  }
}

/// Does the program itself reach the host exit builtin? Read from the parsed
/// statements before normalization: the exception boundary's exit is
/// generated later, so it never appears here, and any reference that does is
/// the program's own. A name the program binds itself -- a top-level
/// declaration, a local, a parameter, a pattern -- is that binding, not the
/// builtin (#3030), so an unused local named `vibe_process_exit_raw` no longer
/// refuses the build.
fn stmts_reach_process_exit(stmts: Array[Stmt]) -> Bool {
  let exit_name = "vibe_process_exit_raw"
  let mut declared = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => if n == exit_name {
        declared = true
      },
      SLetMut(n, _, _) => if n == exit_name {
        declared = true
      },
      _ => ()
    }
    i = i + 1
  }
  if declared {
    false
  } else {
    let mut found = false
    let mut j = 0
    while j < Array::length(stmts) && !found {
      match Array::get(stmts, j) {
        SLet(_, _, _, _, v) => found = expr_reaches_name(v, exit_name, false),
        SLetMut(_, _, v) => found = expr_reaches_name(v, exit_name, false),
        STest(_, b) => found = expr_reaches_name(b, exit_name, false),
        SBench(_, b) => found = expr_reaches_name(b, exit_name, false),
        _ => ()
      }
      j = j + 1
    }
    found
  }
}

/// Is `name` referenced in `e` where no enclosing binder in `e` rebinds it?
/// `hidden` is true once such a binder is in scope.
fn expr_reaches_name(e: Expr, name: String, hidden: Bool) -> Bool {
  if hidden {
    false
  } else {
    match e {
      EIdent(n, _) => n == name,
      ELet(n, v, rest, _) => expr_reaches_name(v, name, false) || expr_reaches_name(rest, name, n == name),
      ELetMut(n, v, rest, _) => expr_reaches_name(v, name, false) || expr_reaches_name(rest, name, n == name),
      ELetRec(n, v, rest) => n != name && (expr_reaches_name(v, name, false) || expr_reaches_name(rest, name, false)),
      EFn(_, _, params, _, _, body) => {
        let mut rebound = false
        let mut pi = 0
        while pi < Array::length(params) {
          let (pn, _) = Array::get(params, pi)
          if pn == name {
            rebound = true
          }
          pi = pi + 1
        }
        expr_reaches_name(body, name, rebound)
      },
      EForIn(n, n2, iter, body) => expr_reaches_name(iter, name, false) || expr_reaches_name(body, name, n == name || n2 == Some(name)),
      EMatch(scrut, arms) => {
        let mut hit = expr_reaches_name(scrut, name, false)
        let mut ai = 0
        while ai < Array::length(arms) && !hit {
          let (pat, arm) = Array::get(arms, ai)
          hit = expr_reaches_name(arm, name, pat_binds_name(pat, name))
          ai = ai + 1
        }
        hit
      },
      EHandle(body, arms) => {
        let mut hit = expr_reaches_name(body, name, false)
        let mut ai = 0
        while ai < Array::length(arms) && !hit {
          let (pat, arm) = Array::get(arms, ai)
          hit = expr_reaches_name(arm, name, pat_binds_name(pat, name))
          ai = ai + 1
        }
        hit
      },
      _ => {
        let kids = expr_children(e)
        let mut hit = false
        let mut ki = 0
        while ki < Array::length(kids) && !hit {
          hit = expr_reaches_name(Array::get(kids, ki), name, false)
          ki = ki + 1
        }
        hit
      }
    }
  }
}

fn pat_binds_name(p: Pat, name: String) -> Bool {
  match p {
    PBind(n) => n == name,
    PCtor(_, subs) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(subs) && !hit {
        hit = pat_binds_name(Array::get(subs, i), name)
        i = i + 1
      }
      hit
    },
    PTuple(subs) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(subs) && !hit {
        hit = pat_binds_name(Array::get(subs, i), name)
        i = i + 1
      }
      hit
    },
    POr(l, r) => pat_binds_name(l, name) || pat_binds_name(r, name),
    PStruct(_, fields) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(fields) && !hit {
        let (_, fp) = Array::get(fields, i)
        hit = pat_binds_name(fp, name)
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn maybe_wrap_async_component(bytes: Bytes, wrap_async: Bool, user_exits: Bool) -> Bytes with Exception {
  if wrap_async {
    // #1539: provider routing is first because its nominal stdin lifecycle
    // cannot be satisfied by (or safely mixed into) generic named streams.
    // The dedicated composer validates signatures and rejects mixing.
    if comp_core_imports_stdin_provider(bytes) {
      comp_emit_component_wasm_async_stdin_provider(bytes, "run")
    } else if comp_core_imports_host_future(bytes) || comp_core_imports_host_stream(bytes) || comp_core_imports_sleep(bytes) {
      // ADR-0089 Decision 3 (#1218): host STREAMS
      // (`vibe.host_stream_get$<name>`) key the same composition -- the
      // composer emits per-name `stream<u8>` component imports alongside
      // any `future<u32>` ones (spec §3.18).
      //
      // #1342: `sleep` keys it as well. The self-contained wrap below has no
      // `vibe` instance, so a sleeping component has to come from the adapter
      // composition -- which now carries a sleep half of its own.
      comp_emit_component_wasm_async_hostfuture(bytes, "run")
    } else {
      // #1342: nothing below provides a host import, so prove there is none
      // before emitting an artifact that could not be instantiated.
      // #2976: the self-contained wrap satisfies `process_exit` with a
      // trapping stub, which is right only for the exception boundary's
      // failing exit. An exit the program wrote itself would turn `exit(0)`
      // into a trap, so refuse it here, where provenance is still known.
      if user_exits {
        throw("component(async): the program calls the host exit, which nothing in this component provides -- an async component entry reports its outcome through the `Int` it returns; return the status from `run` instead of exiting (#1342)")
      } else {
        ()
      }
      comp_reject_unsatisfiable_selfcontained_imports(bytes)
      comp_emit_component_wasm_async_trampolined_p1(bytes, "run", 120)
    }
  } else {
    bytes
  }
}

/// #3069: method-bearing-trait dictionary passing, on the CHECKED program and
/// while its generic binders are still present (so it must run before
/// `strip_generic_type_params`). The typed-`==` rows come from the same check,
/// exactly as the gc lane passes them. The linked prelude's own call later is
/// idempotent on the already-desugared program.
fn desugar_after_check(stmts: Array[Stmt], eq_offsets: Array[Int], eq_keys: Array[String]) -> Unit with Exception {
  desugar_trait_dicts_with_typed_eq(stmts, eq_offsets, eq_keys)
}

/// #2158: the checker's Double call-result offsets for a SINGLE-SOURCE program.
///
/// Codegen is untyped, so the only thing that made a `Double` look like one was
/// the shape of the expression producing it. That covers a direct call to a
/// top-level `fn` with a literal `-> Double` annotation and nothing else: an
/// inferred lambda's result, a generic instantiated at Double, a call through a
/// local alias or a lambda binding, and `Array::get` on an `Array[Double]` all
/// rendered the f64 bits as a plausible-looking integer. The checker knows all
/// of them; this is the wire that carries the answer to codegen.
///
/// Two properties, both load-bearing:
///
///   - ONE offset space. This lane lexes and parses one text, so an offset
///     names one position and there is nothing to collide with. (The FS merge
///     lanes re-establish the same property by rebasing each file into a
///     disjoint offset range and feeding the per-module answers from the
///     modular check -- see `compile_file_fs_mode`'s comment, #2391.)
///     `unique_typed_lowering_offsets_in_stmts` re-establishes the property downstream
///     anyway, on the post-lowering statements codegen actually walks.
///   - Fail CLOSED. `check_program_double_call_result_located_observation`
///     answers `None` when the AST carried no offsets at all -- the case a
///     plain `parse_program(lex(source))` produces, where an empty table is
///     indistinguishable from "no Double call results" -- and `None` becomes an
///     empty table here, which classifies nothing and leaves the pre-#2158
///     syntactic answer exactly as it was.
///
/// The observation replaces the `check_program` that already ran on this path,
/// so no second pass over the program is introduced.
/// #2424, #2462/#2464: every table from the SAME observation.
/// `checked_int_and_bool_render_offsets` is a pure function of the
/// CheckedProgram it already returns, so they all cost one check between them
/// -- and the Int and Bool halves cost ONE walk, not two: they share a
/// candidate set exactly. `None` is the observation refusing an
/// unlocated AST, and an empty table classifies nothing.
/// #2441: the typed-`==` rows ride the same observation. One text, one
/// offset space, no merge and no renames -- the rows apply as-is, and an
/// unlocated AST yields no rows by construction (the record site's
/// `anchor_off >= 0` guard).
/// #2762: the checked env rides along as an `Option`, for
/// `validate_source_exports_if_user` below. `None` is the observation refusing
/// an unlocated AST -- `EnvEmpty` would have no bindings, so validating
/// against it would refuse every legitimate aggregate export.
fn source_offsets(stmts: Array[Stmt]) -> (Array[Int], Array[Int], Array[Int], Array[Int], Array[String], Option[TypeEnv]) with Exception {
  match check_program_double_call_result_located_observation(stmts) {
    Some((checked, offsets, eq_offs, eq_keys)) => {
      // #2987: tag 6 folds into the Int array under a negative key.
      let (int_only, bool_renders, unrenderable) = checked_int_bool_and_unrenderable_render_offsets(checked)
      let int_renders = merge_unrenderable_render_offsets(int_only, unrenderable)
      (offsets, int_renders, bool_renders, eq_offs, eq_keys, Some(checked.final_env))
    },
    None => ([], [], [], [], [], None)
  }
}

fn validate_source_if_user(stmts: Array[Stmt], trusted_generated: Bool) -> Unit with Exception {
  if !trusted_generated {
    validate_user_source_stmts(stmts)
  } else {
    ()
  }
}

/// #2762 (Codex P1 round 2 on #2806): this lane publishes no export surface,
/// so the refusal at publication never reaches it -- measured, it compiled
/// `export { NotDeclaredAnywhere }` while every FS lane refused. USER source
/// only, the same gate `validate_source_if_user` sits behind: a
/// compiler-GENERATED statement graph is merged and renamed, so its export
/// list is not the user's text.
fn validate_source_exports_if_user(stmts: Array[Stmt], env: Option[TypeEnv], trusted_generated: Bool) -> Unit with Exception {
  if trusted_generated {
    ()
  } else {
    match env {
      Some(checked_env) => validate_user_source_exports(stmts, checked_env),
      None => ()
    }
  }
}

fn compile_source_wasi_only_impl(source: String, entry_name: String, trusted_generated: Bool) -> Bytes with Exception {
  // #2158: located lex+parse. `parse_program(lex(source))` leaves every node's
  // offset at -1, which makes the checker's offset-keyed table empty BY
  // CONSTRUCTION -- the channel would be wired up and permanently inert.
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  // Before anything rewrites the statements: the exception boundary's own
  // exit is generated later and must not count as the program's (#3030).
  let user_exits = stmts_reach_process_exit(stmts)
  validate_source_if_user(stmts, trusted_generated)
  expand_interp_only(stmts)
  // Check before stripping generic type params (see merge_sources.vibe).
  let (float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys, checked_env) = source_offsets(stmts)
  validate_source_exports_if_user(stmts, checked_env, trusted_generated)
  desugar_after_check(stmts, eq_offsets, eq_keys)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_impl_with_typed_offsets(stmts, entry_name, float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys), wrap_async, user_exits)
}

export fn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_impl(source, entry_name, false)
}

export fn compile_generated_source_wasi_only(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_impl(source, entry_name, true)
}

/// Coverage (#cov): same source pipeline as compile_source_wasi_only but routes
/// through the coverage codegen, so compiling the flat compiler source under
/// VIBE_COVERAGE=1 yields an instrumented compiler (per-function hit bitmap +
/// `vibe_cov` section).
fn compile_source_wasi_only_coverage_impl(source: String, entry_name: String, trusted_generated: Bool) -> Bytes with Exception {
  // #2469: located parse + the checker's typed-lowering offsets, same as the
  // production sibling above. The instrumented build compiles the SAME program
  // the ordinary one does, so with the plain `lex`/`parse_program` every node
  // was at offset -1 and the tables came out empty by construction -- a
  // coverage build rendered a Double, an Int or a Bool by the syntactic
  // classifier alone while the build it is meant to measure rendered it by
  // type.
  //
  // `compile_wasi_module_coverage_impl(stmts, e)` is by definition
  // `compile_wasi_module_with_sources_coverage_impl(stmts, e, array_empty())`
  // (wasi.vibe), and the two `*_with_sources_coverage_*` bodies pass the same
  // arguments to `compile_wasi_module_linked_impl*`, so going through the
  // `srcs`-taking typed entry with an empty `srcs` is the same compile.
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  validate_source_if_user(stmts, trusted_generated)
  expand_interp_only(stmts)
  let (float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys, checked_env) = source_offsets(stmts)
  validate_source_exports_if_user(stmts, checked_env, trusted_generated)
  desugar_after_check(stmts, eq_offsets, eq_keys)
  strip_generic_type_params(stmts)
  // Coverage consumers require a standalone instrumented core. StdinStream's
  // raw provider ABI is satisfiable only inside the dedicated component, so
  // parse the emitted core imports and fail before returning any artifact.
  reject_stdin_provider_core(compile_wasi_module_with_sources_coverage_impl_with_typed_offsets(stmts, entry_name, array_empty(), float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys), "VIBE_COVERAGE=1")
}

export fn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_coverage_impl(source, entry_name, false)
}

export fn compile_generated_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_coverage_impl(source, entry_name, true)
}

/// ADR-0055 #493 cutover: same pipeline on the Perceus RC codegen path. Lets the
/// selfbuild / bootstrap / e2e gates compile real programs (incl. the whole
/// compiler) under RC via an env toggle in cli_main — the full-scale validity +
/// correctness signal the memory-limited test probes cannot produce.
fn compile_source_wasi_only_rc_impl(source: String, entry_name: String, trusted_generated: Bool) -> Bytes with Exception {
  // #2158: same located parse + checker offsets as the bump sibling above. RC
  // is the production representation, so leaving it on the syntactic
  // classifier alone would mean the two lanes rendered the same program's
  // Doubles differently.
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  // Before anything rewrites the statements: the exception boundary's own
  // exit is generated later and must not count as the program's (#3030).
  let user_exits = stmts_reach_process_exit(stmts)
  validate_source_if_user(stmts, trusted_generated)
  expand_interp_only(stmts)
  let (float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys, checked_env) = source_offsets(stmts)
  validate_source_exports_if_user(stmts, checked_env, trusted_generated)
  desugar_after_check(stmts, eq_offsets, eq_keys)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_rc_impl_with_typed_offsets(stmts, entry_name, float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys), wrap_async, user_exits)
}

export fn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_rc_impl(source, entry_name, false)
}

export fn compile_generated_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_rc_impl(source, entry_name, true)
}

/// #715 recurrence guard: same RC pipeline, but the produced module carries
/// shadow-liveness instrumentation -- a byte per heap address marking freed
/// blocks, with an `unreachable` trap on the FIRST dup-of-freed or
/// drop-of-freed operation. Turns "moving target" free-list corruption into a
/// deterministic trap at the faulting operation. Debug-only (VIBE_RC=shadow):
/// adds a memory-reservation pad and per-dup/drop checks, so never the default.
fn compile_source_wasi_only_rc_shadow_impl(source: String, entry_name: String, trusted_generated: Bool) -> Bytes with Exception {
  // #2469: located parse + typed-lowering offsets, as in the RC sibling above.
  // A shadow build exists to reproduce an RC bug, so it has to lower the
  // program the way the RC build does; on the unlocated parse the tables were
  // empty and the two lanes disagreed on exactly the renders this channel
  // carries.
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  // Before anything rewrites the statements: the exception boundary's own
  // exit is generated later and must not count as the program's (#3030).
  let user_exits = stmts_reach_process_exit(stmts)
  validate_source_if_user(stmts, trusted_generated)
  expand_interp_only(stmts)
  let (float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys, checked_env) = source_offsets(stmts)
  validate_source_exports_if_user(stmts, checked_env, trusted_generated)
  desugar_after_check(stmts, eq_offsets, eq_keys)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_rc_shadow_impl_with_typed_offsets(stmts, entry_name, float_call_offsets, int_render_offsets, bool_render_offsets, eq_offsets, eq_keys), wrap_async, user_exits)
}

export fn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_rc_shadow_impl(source, entry_name, false)
}

export fn compile_generated_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with Exception {
  compile_source_wasi_only_rc_shadow_impl(source, entry_name, true)
}
