//# Imports

import @vibe/compiler/core {
  Expr
}

import ./preprocess_interp_string_fold_loop.vibe {
  fold_interp_exprs_loop
}

//# Functions

export fn fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr {
  let first = Array::get(result_arr, 0)
  fold_interp_exprs_loop(result_arr, result_len, first, 1)
}
