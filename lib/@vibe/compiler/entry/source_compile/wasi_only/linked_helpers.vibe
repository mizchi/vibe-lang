//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_linked_impl
}

import @vibe/compiler/core {
  Expr, Stmt, contains_name, dir_of_path, get_export_name, path_to_module_name, resolve_import_path
}

import @vibe/compiler/syntax {
  lex, parse_program
}
import ./preprocess.vibe {
  expand_interp_stmts, strip_generic_type_params
}

//# Functions

fn efn_param_count(expr: Expr) -> Int {
  match expr {
    EFn(_, _, params, _, _, _) => Array::length(params),
    _ => -1
  }
}

fn resolve_reexport_chain(source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with Error + Fs {
  if depth > 10 {
    ()
  }
  else {
    // #768/#778: direct-call form, not `perform Fs::ReadFile` -- the
    // perform/effect-op codegen path for magic host effects can crash with an
    // uncaught wasm exception in a small/narrow-effect-surface compiled unit
    // (see #778's fix + notes). No mock-handler test exercises this function
    // through `handle ... with Fs { ... }`, so direct-call is safe here.
    let source = Fs::read_file(source_path)
    let stmts = parse_program(lex(source))
    let source_dir = dir_of_path(source_path)
    let wanted_names = array_empty()
    let mut wi = 0
    while wi < Array::length(items) {
      let (name, _) = Array::get(items, wi)
      Array::push(wanted_names, name)
      wi = wi + 1
    }
    let mut si = 0
    while si < Array::length(stmts) {
      match Array::get(stmts, si) {
        SLet(true, _, name, _, expr) => if contains_name(wanted_names, name) {
          let param_count = efn_param_count(expr)
          if param_count >= 0 {
            let export_name = get_export_name(items, name)
            Array::push(linked_imports, (module_name, export_name, param_count, 1))
          }
        }
        ,
        SEnum(true, name, _, _, _) => if contains_name(wanted_names, name) {
          Array::push(type_stmts, Array::get(stmts, si))
        }
        ,
        SReExport(raw_path, inner_items) => {
          let filtered = array_empty()
          let mut fi = 0
          while fi < Array::length(inner_items) {
            let (iname, irename) = Array::get(inner_items, fi)
            if contains_name(wanted_names, iname) {
              Array::push(filtered, (iname, irename))
            }
            fi = fi + 1
          }
          if Array::length(filtered) > 0 {
            let resolved = resolve_import_path(source_dir, raw_path)
            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)
          }
        },
        _ => ()
      }
      si = si + 1
    }
  }
}

//# Misc

export {
  path_to_module_name, resolve_reexport_chain
}
