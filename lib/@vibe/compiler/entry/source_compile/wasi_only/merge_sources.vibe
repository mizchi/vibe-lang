//# Functions

fn string_array_contains_local(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #726: directory-style imports (`import ../core { .. }` -> core/index.vibe)
/// need the CANDIDATE list + existence probe; the single-candidate
/// resolve_import_path returns `core.vibe`, which does not exist. Falls back
/// to the first candidate so a genuinely missing import still reports its
/// plain-file path.
fn resolve_existing_import_path(base_dir: String, raw_path: String, self_path: String) -> String with Fs {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  let mut fallback = ""
  while i < Array::length(candidates) {
    let candidate = Array::get(candidates, i)
    // Skip a candidate that IS the importing file: `export ./codegen` inside
    // codegen.vibe means the codegen/ directory, never a self-import (which
    // would only recurse/cycle). Mirrors loader/header_cache.resolve_path_fs.
    if candidate == self_path {
      i = i + 1
    } else if Fs::exists(candidate) {
      found = candidate
      i = Array::length(candidates)
    } else {
      if fallback == "" {
        fallback = candidate
      } else {
        ()
      }
      i = i + 1
    }
  }
  if found == "" {
    if fallback == "" {
      Array::get(candidates, 0)
    } else {
      fallback
    }
  } else {
    found
  }
}

/// #716: collision-def fallback. `excluded_locals` are the import locals the
/// export-rename plan already rewrites — emitting an inline copy for those too
/// would double-bind the local. The copy gets the target file's export renames
/// applied first, so its body's references to renamed sibling exports stay
/// consistent with the merged program.
fn append_fs_import_alias_collision_defs(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with Error + Fs {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {
      let resolved = resolve_existing_import_path(base_dir, raw_path, current_path)
      // Builtin read + ingest, same as collect_parsed_sources_recursive
      // (flatten-lane wiring constraint / #741).
      let source = ingest_source_text_fs(resolved, Fs::read_file(resolved))
      let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program(lex(source)), export_plan_renames_for(plan, resolved)))
      let mut j = 0
      let mut done = false
      while j < Array::length(source_stmts) && !done {
        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
          Some(local_stmt) => {
            Array::push(merged, local_stmt)
            Array::push(emitted, local)
            done = true
          },
          None => ()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
}

/// `visited` is a `path_set` (#533): this recursion runs once per import
/// EDGE, so a linear `contains_path` scan against a visited list that
/// grows to every module of the program was O(edges × modules). The set
/// is membership-only here — file order comes from the recursion itself
/// (dependencies first), so no ordering constraint is lost.
///
/// #716: the recursion only PARSES and orders the files; appending happens in
/// a second pass once the whole program is known, because the export-rename
/// plan (ambiguous exported names + re-export facades) needs every file's
/// export surface before any file can be rewritten.
fn collect_parsed_sources_recursive(path: String, file_paths: Array[String], file_stmts: Array[Array[Stmt]], visited: Array[Array[String]]) -> Unit with Error + Fs {
  if path_set_contains(visited, path) {
    ()
  }
  else {
    path_set_add(visited, path)
    // Builtin read, NOT `perform Fs::ReadFile`. The original reason (#737's
    // deep-continuation resume corruption) no longer reproduces — the
    // compiler gate keeps a recursive-perform + in-language-handler canary —
    // but the FLATTEN lane (the adapter binary run with
    // VIBE_EMIT_MERGED_SOURCE=1) installs no Fs handler and does not wire
    // this path's performs to host imports, so a perform here throws an
    // unhandled effect at flatten time. Mockable reads need that lane's
    // effect wiring first.
    // #741: ingestion (require-pin blanking + .vibei contract desugar) applies
    // in THIS lane too, so a contract package in the graph resolves to its
    // conformance-checked facade instead of a parse error on bodyless decls.
    let source = ingest_source_text_fs(path, Fs::read_file(path))
    let stmts = parse_program(lex(source))
    let base_dir = dir_of_path(path)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SImport(raw_path, _) => {
          let resolved = resolve_existing_import_path(base_dir, raw_path, path)
          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)
        },
        SReExport(raw_path, _) => {
          let resolved = resolve_existing_import_path(base_dir, raw_path, path)
          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)
        },
        _ => ()
      }
      i = i + 1
    }
    Array::push(file_paths, path)
    Array::push(file_stmts, stmts)
  }
}

fn collect_merged_stmts_recursive(entry_path: String, merged: Array[Stmt], visited: Array[Array[String]]) -> Unit with Error + Fs {
  let file_paths = array_empty()
  let file_stmts = array_empty()
  collect_parsed_sources_recursive(entry_path, file_paths, file_stmts, visited)
  let plan = build_export_rename_plan(file_paths, file_stmts, entry_path)
  let mut fi = 0
  while fi < Array::length(file_paths) {
    let path = Array::get(file_paths, fi)
    let stmts = Array::get(file_stmts, fi)
    let export_renamed = if path == entry_path {
      stmts
    } else {
      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))
    }
    let namespaced_stmts = if path == entry_path {
      export_renamed
    } else {
      namespace_private_value_stmts(path, export_renamed)
    }
    if stmts_have_import_deep(stmts) {
      let import_renames = collect_import_value_renames(plan, path, stmts)
      let skipped_locals = collect_import_alias_collision_locals(stmts)
      append_fs_import_alias_collision_defs(merged, path, stmts, plan, import_value_rename_locals(import_renames))
      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
    } else {
      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
    }
    fi = fi + 1
  }
}

/// #726: the merged whole program AS SOURCE TEXT. Resolves imports from the
/// FS, runs the full merge machinery (export-rename plan, private
/// namespacing, import-alias rewriting — the same pipeline the FS compile
/// uses), and prints the merged statements. This replaces the Python
/// flattener that used to live in scripts/generate_bundle.sh: the old flattener
/// stripped import/export lines and concatenated files verbatim, leaving
/// duplicate top-level defs resolved by fn-table first-match roulette; the
/// merge machinery renames them so the flat source has ZERO duplicates and
/// carries the #716 visibility guarantees. Comments are dropped (printer
/// output) — acceptable for a generated bundle artifact.
export fn merged_program_source_fs(entry_path: String) -> String with Error + Fs {
  let stmts = empty_stmt_array()
  let visited = path_set_new()
  collect_merged_stmts_recursive(entry_path, stmts, visited)
  print_program(stmts)
}

export fn compile_file_wasi_only(entry_path: String, entry_name: String) -> Bytes with Error + Fs {
  let stmts = empty_stmt_array()
  let visited = path_set_new()
  collect_merged_stmts_recursive(entry_path, stmts, visited)
  expand_interp_stmts(stmts)
  // Type-check BEFORE stripping generic type params: a generic function like
  // `[T: Ord](a: T, b: T) -> T { a < b }` only checks if `T` is a bound type
  // variable. Stripping first leaves `T` a concrete `CtNamed("T")`, so the
  // Ord-constrained `<` fails to resolve. Stripping happens after the check,
  // for monomorphic codegen.
  let _ = check_program(stmts)
  strip_generic_type_params(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

//# Misc

export {
  collect_merged_stmts_recursive
}

export {
  collect_merged_stmts_recursive, compile_file_wasi_only
}
