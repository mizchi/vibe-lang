//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program, print_program
}
//# Functions

fn roundtrip(source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let printed = print_program(stmts)
    let tokens2 = lex(printed)
    let stmts2 = parse_program(tokens2)
    let printed2 = print_program(stmts2)
    String::equals(printed, printed2)
  } with Error {
    Throw(_) => false
  }
}

let _rt1 = roundtrip("let x = 1 + 2\nx")

let _rt2 = roundtrip("let f: (Int) -> Int = (x) -> { x * 2 }\nf(5)")

let _rt3 = roundtrip("enum Color { Red; Green; Blue }\nmatch Red { Red => 1, _ => 0 }")

let _rt4 = roundtrip("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 1, y: 2 }\np.x")

let _rt5 = roundtrip("let mut s = 0\nfor x in [1, 2, 3] { s = s + x }\ns")

let _rt6 = roundtrip("struct Vec2 { x: Int; y: Int }\nlet p = Vec2::{ x: 3, y: 4 }\nlet Vec2::{ x, y } = p\nx + y")

let _rt7 = roundtrip("loop (i = 0, acc = 0) { if i >= 5 { break(acc) }\ncontinue(i + 1, acc + i) }")

let _rt8 = roundtrip("struct Vec2 { x: Int; y: Int } derive(Eq)\nlet a = Vec2::{ x: 1, y: 2 }\na == a")

fn check_source(source: String) -> String {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    let _printed = print_program(stmts)
    "ok"
  } with Error {
    Throw(msg) => String::concat("err:", msg)
  }
}

let _a1 = check_source("let arr = [1, 2, 3, 4, 5]\nArray::length(arr)")

let _a2 = check_source("let b = ArrayBuilder::new()\nArrayBuilder::push(b, 10)\nArrayBuilder::push(b, 20)\nArray::length(ArrayBuilder::freeze(b))")

let _a3 = check_source("let arr = [1, 2, 3]\nArray::push(arr, 4)\nArray::get(arr, 3)")

let _a4 = check_source("let arr = [1, 2, 3, 4, 5]\nlet s = Array::slice(arr, 1, 3)\nArray::length(s)")

let _a5 = check_source("let a = [1, 2]\nlet b = [3, 4]\nArray::length(Array::concat(a, b))")

let _b1 = check_source("let b = Bytes::new()\nBytes::push(b, 65)\nArray::length(Bytes::to_array(b))")

let _b2 = check_source("let b = Bytes::from_array([1, 2, 3])\nArray::length(Bytes::to_array(b))")

let _c1 = check_source("let apply: ((Int) -> Int, Int) -> Int = (f, x) -> { f(x) }\nlet double: (Int) -> Int = (x) -> { x * 2 }\napply(double, 5)")

let _c2 = check_source("let make_adder: (Int) -> (Int) -> Int = (n) -> { (x: Int) -> Int { x + n } }\nlet add5 = make_adder(5)\nadd5(10)")

let _c3 = check_source("let compose: ((Int) -> Int, (Int) -> Int) -> (Int) -> Int = (f, g) -> { (x: Int) -> Int { f(g(x)) } }\ncompose((x: Int) -> Int { x + 1 }, (x: Int) -> Int { x * 2 })(3)")

let _e1 = check_source("enum Color { Red; Green; Blue }\nmatch Red { Red => 1, Green => 2, Blue => 3 }")

let _e2 = check_source("enum Shape { Circle(Int); Rect(Int, Int) }\nlet area: (Shape) -> Int = (s) -> { match s { Circle(r) => r * r, Rect(w, h) => w * h } }\narea(Circle(5))")

let _e3 = check_source("enum List { Nil; Cons(Int, List) }\nlet rec len: (List) -> Int = (l) -> { match l { Nil => 0, Cons(_, t) => 1 + len(t) } }\nlen(Cons(1, Cons(2, Nil)))")

let _e4 = check_source("enum Expr { Num(Int); Add(Expr, Expr) }\nlet rec eval_e: (Expr) -> Int = (e) -> { match e { Num(n) => n, Add(a, b) => eval_e(a) + eval_e(b) } }\neval_e(Add(Num(1), Num(2)))")

let _g1 = check_source("let id: [T](T) -> T = (x) -> { x }\nid(42)")

let _g2 = check_source("let fst: [A, B](A, B) -> A = (a, b) -> { a }\nfst(1, \"hi\")")

let _g3 = check_source("let opt_map: [A, B](Option[A], (A) -> B) -> Option[B] = (opt, f) -> { match opt { Some(v) => Some(f(v)), None => None } }\nmatch opt_map(Some(5), (x: Int) -> Int { x * 10 }) { Some(n) => n, None => 0 }")

let _h1 = check_source("handle { 42 } with Error { Throw(_) => -1 }")

let _h2 = check_source("handle { throw(\"oops\")\n0 } with Error { Throw(msg) => String::length(msg) }")

let _h3 = check_source("let risky: () -> Int with Error = () -> { throw(\"fail\")\n0 }\nhandle { risky() } with Error { Throw(_) => 99 }")

let _h4 = check_source("let inner: () -> Int with Error = () -> { throw(\"err\")\n0 }\nlet outer: () -> Int with Error = () -> { inner() + 1 }\nhandle { outer() } with Error { Throw(_) => -1 }")

let _m1 = check_source("let m = Map::from_pairs([(\"a\", 1), (\"b\", 2)])\nMap::get(m, \"a\")")

let _m2 = check_source("let b = MapBuilder::new()\nMapBuilder::set(b, \"x\", 42)\nMap::get(MapBuilder::freeze(b), \"x\")")

let _m3 = check_source("let m = Map::from_pairs([(\"k\", 1)])\nMap::keys(m)")

let _p1 = check_source("let abs: (Int) -> Int = (n) -> { if n < 0 { 0 - n } else { n } }\nabs(-5)")

let _p2 = check_source("let max: (Int, Int) -> Int = (a, b) -> { if a > b { a } else { b } }\nmax(3, 7)")

let _p3 = check_source("let clamp: (Int, Int, Int) -> Int = (n, lo, hi) -> { if n < lo { lo } else if n > hi { hi } else { n } }\nclamp(15, 0, 10)")

let _r1 = check_source("let p = record { x: 3, y: 4 }\np.x + p.y")

let _s1 = check_source("String::length(\"hello world\")")

