// --- recently added features ---

/// struct destructuring via let
let _sd1 = check_source("struct Vec2 { x: Int; y: Int }\nlet p = Vec2::{ x: 3, y: 4 }\nlet Vec2::{ x, y } = p\nx + y")

/// derive(Eq) for struct and enum
let _de1 = check_source("struct Vec2 { x: Int; y: Int } derive(Eq)\nlet a = Vec2::{ x: 1, y: 2 }\nlet b = Vec2::{ x: 1, y: 2 }\na == b")

let _de2 = check_source("enum Color { Red; Green; Blue } derive(Eq)\nlet a = Red\nlet b = Red\na == b")

/// Map with Int keys
let _mi1 = check_source("let b = MapBuilder::new()\nMapBuilder::set(b, 1, 100)\nMapBuilder::set(b, 2, 200)\nlet m = MapBuilder::freeze(b)\nMap::get(m, 2)")

let _mi2 = check_source("let b = MapBuilder::new()\nMapBuilder::set(b, 10, 42)\nlet m = MapBuilder::freeze(b)\nMap::has_key(m, 10)")

let _mi3 = check_source("let b = MapBuilder::new()\nMapBuilder::set(b, 1, 10)\nMapBuilder::set(b, 2, 20)\nlet m = MapBuilder::freeze(b)\nArray::length(Map::keys(m))")

/// loop break(value)
let _lb1 = check_source("loop (i = 0, acc = 0) { if i >= 10 { break(acc) }\ncontinue(i + 1, acc + i) }")

/// while break(value)
let _wb1 = check_source("let mut i = 0\nwhile true { if i >= 5 { break }\ni = i + 1 }\ni")

/// nested for-in with map result
let _fm1 = check_source("for x in [1, 2, 3] { x * 10 }")

/// trait impl basic
let _tr1 = check_source("trait Greet { greet(Self) -> Int }\nstruct Dog { age: Int }\nimpl Greet for Dog { let greet: (Dog) -> Int = (self) -> { self.age } }\nDog::greet(Dog::{ age: 5 })")

/// is expression
let _is1 = check_source("let x = Some(42)\nif x is Some(v) { v } else { 0 }")

/// guard binding (#1283 -- replaced the retired `let PAT = e else { .. }`)
let _le1 = check_source("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v) else { return 0 }\n  v }\nf(Some(42))")

/// or-pattern in match
let _or1 = check_source("let classify: (Int) -> Int = (n) -> { match n { 0 | 1 => 0, _ => 1 } }\nclassify(0) + classify(5)")

/// for-in with index
let _fi1 = check_source("let mut total = 0\nfor i, x in [10, 20, 30] { total = total + i + x }\ntotal")

/// while with mutable capture
let _wc1 = check_source("let mut x = 0\nlet mut i = 0\nwhile i < 3 { x = x + i\ni = i + 1 }\nx")

/// ADR-0069: top level is declarations only — keep the "touch every probe
/// binding" result as a named let (was a bare top-level expression).
let _coverage_probe_count = Array::length([
  _bc1,
  _bc2,
  _bw2,
  _cf1,
  _mp2,
  _mp3,
  _sd1,
  _de1,
  _de2,
  _mi1,
  _mi2,
  _mi3,
  _lb1,
  _wb1,
  _fm1,
  _tr1,
  _is1,
  _le1,
  _or1,
  _fi1,
  _wc1
])
