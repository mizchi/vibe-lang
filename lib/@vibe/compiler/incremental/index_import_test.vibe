//# Imports

import .{
  RippleDb, ripple_eval_count, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source
}

//# Misc

test "compiler ripple index exports symbols" {
  let db0 = ripple_new()
  let db1 = ripple_set_source(db = db0, path = "a.vibe", source = "let x = 1")
  let db2 = ripple_record_eval(db = db1, path = "a.vibe", fingerprint = "fp1", deps = [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db2), 1))
  match ripple_get_source(db = db2, path = "a.vibe") {
    Some(src) => assert(src == "let x = 1"),
    None => assert(false)
  }
}
