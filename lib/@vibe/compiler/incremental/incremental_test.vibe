//# Imports

import ./incremental.vibe {
  RippleDb, ripple_eval_count, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source
}

//# Misc

/// Insert many distinct keys (forcing several keys per hash bucket) and read
/// them all back. Guards the hash-bucket RippleDb against collisions / bucket
/// aliasing.
test "compiler ripple many keys roundtrip" {
  let n = 300
  let rec fill: (RippleDb, Int) -> RippleDb = (db, i) -> {
    if i >= n {
      db
    } else {
      let path = String::concat("m", Int::to_string(i))
      let src = String::concat("src", Int::to_string(i))
      fill(ripple_set_source(db, path, src), i + 1)
    }
  }
  let db = fill(ripple_new(), 0)
  let rec check: (Int) -> Bool = (i) -> {
    if i >= n {
      true
    } else {
      let path = String::concat("m", Int::to_string(i))
      let expect = String::concat("src", Int::to_string(i))
      match ripple_get_source(db, path) {
        Some(src) => {
          if src == expect {
            check(i + 1)
          } else {
            false
          }
        },
        None => false
      }
    }
  }
  assert(check(0))
  match ripple_get_source(db, "nope.vibe") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

/// Re-setting an existing key overwrites in place (no duplicate / growth bug).
test "compiler ripple overwrite same key" {
  let db0 = ripple_new()
  let db1 = ripple_set_source(db0, "a.vibe", "v1")
  let db2 = ripple_set_source(db1, "a.vibe", "v2")
  match ripple_get_source(db2, "a.vibe") {
    Some(src) => assert(src == "v2"),
    None => assert(false)
  }
}

test "compiler ripple set/get source" {
  let db0 = ripple_new()
  let db1 = ripple_set_source(db0, "a.vibe", "let x = 1")
  match ripple_get_source(db1, "a.vibe") {
    Some(src) => assert(src == "let x = 1"),
    None => assert(false)
  }
}

test "compiler ripple record eval increments only on fingerprint change" {
  let db0 = ripple_new()
  let db1 = ripple_record_eval(db0, "a.vibe", "fp1", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db1), 1))
  let db2 = ripple_record_eval(db1, "a.vibe", "fp1", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db2), 1))
  let db3 = ripple_record_eval(db2, "a.vibe", "fp2", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db3), 2))
}

test "compiler ripple stores latest fingerprint" {
  let db0 = ripple_new()
  let db1 = ripple_record_eval(db0, "a.vibe", "fp1", [
    "b.vibe"
  ])
  let db2 = ripple_record_eval(db1, "a.vibe", "fp2", [
    "c.vibe"
  ])
  match ripple_get_fingerprint(db2, "a.vibe") {
    Some(fp) => assert(fp == "fp2"),
    None => assert(false)
  }
}
