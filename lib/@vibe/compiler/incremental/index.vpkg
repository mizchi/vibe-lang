name = @vibe/compiler/incremental
version = 0.0.1
description =
  #|@vibe/compiler/incremental — RippleDb, the selfhost compiler's
deps = {}

generated_hash =

// @vibe/compiler/incremental — RippleDb, the selfhost compiler's
// incremental module DB (ADR-0070 Phase 3, #897 / #1353): maps module
// path -> source, path -> fingerprint, path -> dependency list, plus an
// eval counter, as one fixed-bucket hash-map-backed linear value
// (callers must thread the returned db, not reuse a stale one -- see
// incremental.vibe's header comment). `RippleDb` is declared `opaque`:
// no consumer ever constructs or pattern-matches it directly, only
// through ripple_new/ripple_get_*/ripple_set_source/ripple_record_eval.
// `StrMap`/`DepsMap` (internal bucket-map representation) are likewise
// never referenced outside incremental.vibe -- but `check_contract`
// still requires every exported type declared regardless of external
// usage, so they're declared `opaque` here too.
// Relocated from @vibe/graph (#1353): that package was compiler-only.

opaque type StrMap
opaque type DepsMap
opaque type RippleDb

fn ripple_new() -> RippleDb
fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb
fn ripple_get_source(db: RippleDb, path: String) -> Option[String]
fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String]
fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]]
fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb
fn ripple_eval_count(db: RippleDb) -> Int
