//# Types

// @vibe/compiler/incremental — RippleDb, the selfhost compiler's incremental module DB: it maps module
// path -> source, path -> fingerprint, and path -> dependency list.
//
// Previously each map was a flat association array (`Array[(String, _)]`):
// every lookup was O(n) and every upsert rebuilt the whole array O(n), so
// threading the DB through N modules was O(N^2) time AND allocations (matching
// the alloc-bound compile profile from moon-pprof). This replaces them with
// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan
// only that (small) bucket. Lookup/insert are O(1) amortized, so a full
// N-module compile is O(N).
//
// The maps mutate their buckets in place, so the DB is *linear*: callers must
// use the returned db and discard the old one. The selfhost compiler always
// threads `next_db`, so this is safe. eval_count lives in a 1-element array so
// it is bumped without rebuilding the enum payload.

//# Values

//# Types

export enum StrMap {
  StrMap(Array[Array[(String, String)]])
}

export enum DepsMap {
  DepsMap(Array[Array[(String, Array[String])]])
}

export enum RippleDb {
  RippleDb(StrMap, StrMap, DepsMap, Array[Int])
}

//# Functions

fn nbuckets() -> Int {
  256
}

fn bucket_mask() -> Int {
  255
}

/// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is
/// a power of two so we mask with `& 255` instead of `%`. Intermediate values
/// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.
fn hash_bucket(key: String) -> Int {
  let len = String::length(key)
  let rec go: (Int, Int) -> Int = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let c = String::char_code_at(key, i)
      let mixed = (acc^c) * 16777619
      let bounded = mixed&1073741823
      go(i + 1, bounded)
    }
  }
  let h = go(0, 2166136261&1073741823)
  h&bucket_mask()
}

fn empty_strings() -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

fn empty_string_pairs() -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

fn empty_deps_pairs() -> Array[(String, Array[String])] {
  Array::slice([
    ("", empty_strings())
  ], 0, 0)
}

/// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make
/// would alias one array across every slot, so push fresh empties instead.)
fn new_string_buckets() -> Array[Array[(String, String)]] {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_string_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}

fn new_deps_buckets() -> Array[Array[(String, Array[String])]] {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_deps_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}

fn strmap_new() -> StrMap {
  StrMap(new_string_buckets())
}

fn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_string(bucket, key, i + 1)
    }
  }
}

fn strmap_get(m: StrMap, key: String) -> Option[String] {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_string(bucket, key, 0)
    }
  }
}

/// In-place upsert into the bucket for `key`.
fn strmap_set(m: StrMap, key: String, value: String) -> Unit {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, value))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, value))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}

fn depsmap_new() -> DepsMap {
  DepsMap(new_deps_buckets())
}

fn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_deps(bucket, key, i + 1)
    }
  }
}

fn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_deps(bucket, key, 0)
    }
  }
}

fn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, deps))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, deps))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}

export fn ripple_new() -> RippleDb {
  let count = ArrayBuilder::new()
  ArrayBuilder::push(count, 0)
  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))
}

export fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {
  match db {
    RippleDb(sources, _, _, _) => strmap_get(sources, path)
  }
}

export fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {
  match db {
    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)
  }
}

export fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {
  match db {
    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)
  }
}

export fn ripple_eval_count(db: RippleDb) -> Int {
  match db {
    RippleDb(_, _, _, count) => Array::get(count, 0)
  }
}

export fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {
  match db {
    RippleDb(sources, _, _, _) => {
      strmap_set(sources, path, source)
      db
    }
  }
}

export fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {
  match db {
    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {
      Some(prev_fp) => {
        if prev_fp == fingerprint {
          db
        } else {
          strmap_set(fingerprints, path, fingerprint)
          depsmap_set(deps_map, path, deps)
          Array::set(count, 0, Array::get(count, 0) + 1)
          db
        }
      },
      None => {
        strmap_set(fingerprints, path, fingerprint)
        depsmap_set(deps_map, path, deps)
        Array::set(count, 0, Array::get(count, 0) + 1)
        db
      }
    }
  }
}
