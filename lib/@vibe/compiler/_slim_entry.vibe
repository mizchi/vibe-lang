//# Imports

import @vibe/compiler/entry/source_compile/wasi_only {
  compile_source_wasi_only
}

import ./selfbuild_runtime_entry_bundle.vibe {
  selfbuild_runtime_entry_source
}

import ./compiler_sources_bundle.vibe {
  compiler_source_groups, compiler_sources
}

//# Functions

export fn selfbuild_compile_stage2() -> Bytes with Exception {
  let main_source = selfbuild_runtime_entry_source()
  if main_source == "" {
    throw("selfbuild_runtime_entry_source is empty")
  }
  compile_source_wasi_only(main_source, "selfbuild_entry")
}
