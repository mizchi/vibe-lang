//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

//# Functions

fn append_all(dst: Array[String], src: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

fn empty_pairs() -> Array[(String, String)] {
  array_empty()
}

fn empty_strings() -> Array[String] {
  array_empty()
}

fn bound_with(bound: Array[String], extras: Array[String]) -> Array[String] {
  let result = empty_strings()
  let mut i = 0
  while i < Array::length(bound) {
    Array::push(result, Array::get(bound, i))
    i = i + 1
  }
  i = 0
  while i < Array::length(extras) {
    Array::push(result, Array::get(extras, i))
    i = i + 1
  }
  result
}

fn clone_strings(items: Array[String]) -> Array[String] {
  let result = empty_strings()
  let mut i = 0
  while i < Array::length(items) {
    Array::push(result, Array::get(items, i))
    i = i + 1
  }
  result
}

fn pair_contains(arr: Array[(String, String)], item: (String, String)) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    let current = Array::get(arr, i)
    if current.0 == item.0 && current.1 == item.1 {
      found = true
    }
    i = i + 1
  }
  found
}

fn bound_with_one(bound: Array[String], name: String) -> Array[String] {
  bound_with(bound, [
    name
  ])
}

fn add_unique_pair(arr: Array[(String, String)], item: (String, String)) -> Unit {
  if not(pair_contains(arr, item)) {
    Array::push(arr, item)
  }
}

fn append_all_pairs(dst: Array[(String, String)], src: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    add_unique_pair(dst, Array::get(src, i))
    i = i + 1
  }
}

fn array_contains_str(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    }
    i = i + 1
  }
  found
}

fn add_unique(arr: Array[String], s: String) -> Unit {
  if not(array_contains_str(arr, s)) {
    Array::push(arr, s)
  }
}

export fn collect_mut_bindings(expr: Expr) -> Array[String] {
  let result = empty_strings()
  match expr {
    ELetMut(name, val, body, _) => {
      Array::push(result, name)
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ELet(_, val, body, _) => {
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ELetRec(_, val, body) => {
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ESeq(a, b) => {
      append_all(result, collect_mut_bindings(a))
      append_all(result, collect_mut_bindings(b))
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all(result, collect_mut_bindings(cond))
      append_all(result, collect_mut_bindings(then_e))
      append_all(result, collect_mut_bindings(else_e))
      result
    },
    _ => result
  }
}

fn collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      collect_pat_bindings(a, out)
      collect_pat_bindings(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        collect_pat_bindings(fpat, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

export fn collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {
  let result = empty_strings()
  match expr {
    EIdent(name, _) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      result
    },
    EInt(_) => result,
    EFloat(_) => result,
    EString(_) => result,
    EBool(_) => result,
    EUnit => result,
    ELet(name, val, body, _) => {
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(body, bound_with_one(bound, name)))
      result
    },
    ELetRec(name, val, body) => {
      let new_bound = bound_with_one(bound, name)
      append_all(result, collect_free_vars(val, new_bound))
      append_all(result, collect_free_vars(body, new_bound))
      result
    },
    ELetMut(name, val, body, _) => {
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(body, bound_with_one(bound, name)))
      result
    },
    EAssign(name, val, cont) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(cont, bound))
      result
    },
    EAssignOp(name, _, val, cont) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(cont, bound))
      result
    },
    EFn(_, _, params, _, _, body) => {
      let param_names = empty_strings()
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(param_names, pname)
        i = i + 1
      }
      append_all(result, collect_free_vars(body, bound_with(bound, param_names)))
      result
    },
    ECall(callee, args, _) => {
      append_all(result, collect_free_vars(callee, bound))
      let mut i = 0
      while i < Array::length(args) {
        append_all(result, collect_free_vars(Array::get(args, i), bound))
        i = i + 1
      }
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all(result, collect_free_vars(cond, bound))
      append_all(result, collect_free_vars(then_e, bound))
      append_all(result, collect_free_vars(else_e, bound))
      result
    },
    ESeq(a, b) => {
      append_all(result, collect_free_vars(a, bound))
      append_all(result, collect_free_vars(b, bound))
      result
    },
    EBinOp(_, left, right) => {
      append_all(result, collect_free_vars(left, bound))
      append_all(result, collect_free_vars(right, bound))
      result
    },
    EUnaryOp(_, operand) => {
      append_all(result, collect_free_vars(operand, bound))
      result
    },
    EWhile(cond, body) => {
      append_all(result, collect_free_vars(cond, bound))
      append_all(result, collect_free_vars(body, bound))
      result
    },
    ELoop(params, body) => {
      let bound2 = clone_strings(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        append_all(result, collect_free_vars(init, bound2))
        Array::push(bound2, name)
        i = i + 1
      }
      append_all(result, collect_free_vars(body, bound2))
      result
    },
    EForIn(name, index_name, iter, body) => {
      append_all(result, collect_free_vars(iter, bound))
      let bound2 = bound_with_one(bound, name)
      let bound3 = match index_name {
        Some(index_name) => bound_with_one(bound2, index_name),
        None => bound2
      }
      append_all(result, collect_free_vars(body, bound3))
      result
    },
    EMatch(scrut, arms) => {
      append_all(result, collect_free_vars(scrut, bound))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = empty_strings()
        collect_pat_bindings(pat, pat_binds)
        append_all(result, collect_free_vars(arm_body, bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    EHandle(body, arms) => {
      append_all(result, collect_free_vars(body, bound))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        let pat_binds = empty_strings()
        collect_pat_bindings(pat, pat_binds)
        append_all(result, collect_free_vars(arm_body, bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        append_all(result, collect_free_vars(Array::get(elems, i), bound))
        i = i + 1
      }
      result
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        append_all(result, collect_free_vars(Array::get(elems, i), bound))
        i = i + 1
      }
      result
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        append_all(result, collect_free_vars(fval, bound))
        i = i + 1
      }
      result
    },
    EDot(obj, _, _, _) => {
      append_all(result, collect_free_vars(obj, bound))
      result
    },
    EReturn(e) => {
      append_all(result, collect_free_vars(e, bound))
      result
    },
    ELabeledArg(_, _, e) => {
      append_all(result, collect_free_vars(e, bound))
      result
    },
    EBreak(opt) => {
      match opt {
        Some(e) => append_all(result, collect_free_vars(e, bound)),
        None => ()
      }
      result
    },
    EContinue(exprs) => {
      let mut i = 0
      while i < Array::length(exprs) {
        append_all(result, collect_free_vars(Array::get(exprs, i), bound))
        i = i + 1
      }
      result
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        append_all(result, collect_free_vars(fval, bound))
        i = i + 1
      }
      result
    },
    ESpread(e) => {
      append_all(result, collect_free_vars(e, bound))
      result
    },
    EStringInterp(_) => result
  }
}

export fn check_mut_capture(fn_body: Expr, outer_muts: Array[String]) -> Array[String] {
  let free = collect_free_vars(fn_body, empty_strings())
  let captured_muts = empty_strings()
  let mut i = 0
  while i < Array::length(free) {
    let name = Array::get(free, i)
    if array_contains_str(outer_muts, name) {
      add_unique(captured_muts, name)
    }
    i = i + 1
  }
  captured_muts
}

fn analyze_captures_with_muts(expr: Expr, outer_muts: Array[String]) -> Array[(String, String)] {
  let result = empty_pairs()
  match expr {
    ELetMut(name, val, body, _) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      let new_muts = empty_strings()
      append_all(new_muts, outer_muts)
      Array::push(new_muts, name)
      append_all_pairs(result, analyze_captures_with_muts(body, new_muts))
      result
    },
    EFn(_, _, params, _, _, body) => {
      let param_names = empty_strings()
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        Array::push(param_names, pname)
        pi = pi + 1
      }
      let free = collect_free_vars(body, param_names)
      let mut i = 0
      while i < Array::length(free) {
        let name = Array::get(free, i)
        if array_contains_str(outer_muts, name) {
          add_unique_pair(result, ("lambda", name))
        }
        i = i + 1
      }
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ELet(_, val, body, _) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ELetRec(_, val, body) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ESeq(a, b) => {
      append_all_pairs(result, analyze_captures_with_muts(a, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(b, outer_muts))
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all_pairs(result, analyze_captures_with_muts(cond, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(then_e, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(else_e, outer_muts))
      result
    },
    ECall(callee, args, _) => {
      append_all_pairs(result, analyze_captures_with_muts(callee, outer_muts))
      let mut i = 0
      while i < Array::length(args) {
        append_all_pairs(result, analyze_captures_with_muts(Array::get(args, i), outer_muts))
        i = i + 1
      }
      result
    },
    EWhile(cond, body) => {
      append_all_pairs(result, analyze_captures_with_muts(cond, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        append_all_pairs(result, analyze_captures_with_muts(init, outer_muts))
        i = i + 1
      }
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    EForIn(_, _, iter, body) => {
      append_all_pairs(result, analyze_captures_with_muts(iter, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    EMatch(scrut, arms) => {
      append_all_pairs(result, analyze_captures_with_muts(scrut, outer_muts))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_all_pairs(result, analyze_captures_with_muts(arm_body, outer_muts))
        ai = ai + 1
      }
      result
    },
    EAssign(_, val, cont) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(cont, outer_muts))
      result
    },
    EAssignOp(_, _, val, cont) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(cont, outer_muts))
      result
    },
    EBinOp(_, left, right) => {
      append_all_pairs(result, analyze_captures_with_muts(left, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(right, outer_muts))
      result
    },
    EUnaryOp(_, operand) => {
      append_all_pairs(result, analyze_captures_with_muts(operand, outer_muts))
      result
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        append_all_pairs(result, analyze_captures_with_muts(Array::get(elems, i), outer_muts))
        i = i + 1
      }
      result
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        append_all_pairs(result, analyze_captures_with_muts(Array::get(elems, i), outer_muts))
        i = i + 1
      }
      result
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        append_all_pairs(result, analyze_captures_with_muts(fval, outer_muts))
        i = i + 1
      }
      result
    },
    EHandle(body, arms) => {
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_all_pairs(result, analyze_captures_with_muts(arm_body, outer_muts))
        ai = ai + 1
      }
      result
    },
    EDot(obj, _, _, _) => {
      append_all_pairs(result, analyze_captures_with_muts(obj, outer_muts))
      result
    },
    EReturn(e) => {
      append_all_pairs(result, analyze_captures_with_muts(e, outer_muts))
      result
    },
    _ => result
  }
}

export fn analyze_captures(expr: Expr) -> Array[(String, String)] {
  analyze_captures_with_muts(expr, empty_strings())
}

export fn analyze_captures_stmts(stmts: Array[Stmt]) -> Array[(String, String)] {
  let result = empty_pairs()
  let muts = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLetMut(name, _, val) => {
        append_all_pairs(result, analyze_captures_with_muts(val, muts))
        Array::push(muts, name)
      },
      SLet(_, _, _, _, body) => append_all_pairs(result, analyze_captures_with_muts(body, muts))
      ,
      SExpr(e) => append_all_pairs(result, analyze_captures_with_muts(e, muts))
      ,
      STest(_, body) => append_all_pairs(result, analyze_captures_with_muts(body, muts))
      ,
      _ => ()
    }
    i = i + 1
  }
  result
}

export fn collect_mut_bindings_stmts(stmts: Array[Stmt]) -> Array[String] {
  let result = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLetMut(name, _, _) => Array::push(result, name),
      SLet(_, _, _, _, body) => append_all(result, collect_mut_bindings(body)),
      SExpr(e) => append_all(result, collect_mut_bindings(e)),
      _ => ()
    }
    i = i + 1
  }
  result
}
