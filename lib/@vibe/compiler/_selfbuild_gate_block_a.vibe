fn probe_parse_stmt_progress_source_by_path(path: String) -> Int with { Error } {
  let sources = compiler_sources()
  if Array::length(sources) == 0 {
    throw("sources is empty (stub)")
  }
  let source = lookup_source(sources, path)
  let tokens = lex(source)
  let mut pos = 0
  let mut stmt_index = 0
  let mut result = -1
  let mut done = false
  while !done {
    if pos >= Array::length(tokens) {
      result = stmt_index * 100000 + pos
      done = true
    } else {
      match Array::get(tokens, pos) {
        TEof => {
          result = stmt_index * 100000 + pos
          done = true
        },
        _ => handle {
          let (_, next) = parse_stmt(tokens, [
          ], pos)
          pos = next
          stmt_index = stmt_index + 1
        } with Error {
          Throw(_) => {
            result = stmt_index * 100000 + pos
            done = true
          }
        }
      }
    }
  }
  result
}

