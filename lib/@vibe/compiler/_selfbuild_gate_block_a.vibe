fn find_unexpected_control_char(source: String) -> Int {
  let len = String::length(source)
  let mut i = 0
  let mut result = -1
  while i < len && result < 0 {
    let c = String::char_code_at(source, i)
    let allowed = c == 9 || c == 10 || c == 13 || c >= 32
    if !allowed {
      result = i * 1000 + c
    }
    i = i + 1
  }
  result
}

fn probe_source_control_by_path(path: String) -> Int with { Error } {
  let sources = compiler_sources()
  if Array::length(sources) == 0 {
    throw("sources is empty (stub)")
  }
  let source = lookup_source(sources, path)
  find_unexpected_control_char(source)
}

fn selfbuild_probe_compile_first(n: Int) -> Int with { Error } {
  let sources = compiler_sources()
  let first = Array::slice(sources, 0, n)
  let merged = collect_merged_stmts(first)
  let entry_tokens = lex("export let __probe_entry: () -> Int = () -> { 0 }")
  let entry_stmts = parse_program(entry_tokens)
  let mut j = 0
  while j < Array::length(entry_stmts) {
    Array::push(merged, Array::get(entry_stmts, j))
    j = j + 1
  }
  let bytes = compile_wasi_module(merged, "__probe_entry")
  Bytes::length(bytes)
}

fn load_cli_adapter_merged_source() -> String with { Error } {
  let sources = cli_adapter_sources()
  if Array::length(sources) == 0 {
    throw("cli_adapter_sources is empty")
  }
  let adapter_path = "lib/@vibe/compiler/cli_adapter.vibe"
  let adapter_source = lookup_source(sources, adapter_path)
  let prepared = prepare_modules_cached(db_new(), adapter_path, adapter_source, sources)
  let (merged_source, _, _) = db_merged_source(prepared, adapter_path, sources)
  merged_source
}

