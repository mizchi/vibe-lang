}

export fn selfbuild_probe_token_tag() -> Int with { Error } {
  let tokens = lex("let x = 42")
  let first = Array::get(tokens, 0)
  let tag = match first {
    TLet => 1,
    TEof => 2,
    _ => 0
  }
  Array::length(tokens) * 100 + tag
}

