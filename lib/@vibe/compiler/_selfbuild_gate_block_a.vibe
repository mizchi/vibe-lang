fn probe_parse_sources_first_failure(sources: Array[(String, String)]) -> Int with { Error } {
  let mut i = 0
  let mut result = -1
  while i < Array::length(sources) && result < 0 {
    let (_, source) = Array::get(sources, i)
    handle {
      let _ = parse_program(lex(source))
      ()
    } with Error {
      Throw(_) => {
        result = i * 1000000 + probe_parse_stmt_progress_source(source)
      }
    }
    i = i + 1
  }
  result
}

fn probe_all_source_controls() -> Int with { Error } {
  let sources = compiler_sources()
  if Array::length(sources) == 0 {
    throw("sources is empty (stub)")
  }
  let mut i = 0
  let mut result = -1
  while i < Array::length(sources) && result < 0 {
    let (_, source) = Array::get(sources, i)
    let control = find_unexpected_control_char(source)
    if control >= 0 {
      result = i * 1000000 + control
    }
    i = i + 1
  }
  result
}

