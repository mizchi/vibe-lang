//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn probe_lex_source(source: String) -> Int with { Error } {
  Array::length(lex(source))
}

fn probe_check_source(source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  1
}

fn probe_parse_source(source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  Array::length(stmts)
}

fn probe_prepare_source(main_source: String, main_path: String) -> Int with { Error } {
  let sources = compiler_sources()
  if Array::length(sources) == 0 {
    throw("sources is empty (stub)")
  }
  let prepared = prepare_modules_cached(db_new(), main_path, main_source, sources)
  db_typecheck_count(prepared)
}

/// #768/#778: direct-call form, not `perform Fs::Exists`/`perform Fs::Remove`
/// -- matches the working sibling copies of this exact helper in
/// cache_probe_support.vibe / entry/cli_cache and every
/// tests/*_test.vibe copy, avoiding the perform/effect-op crash risk in a
/// narrow-effect-surface compiled unit.
fn remove_file_if_exists(path: String) -> Unit with { Fs } {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

export fn selfbuild_probe_check() -> Int with { Error } {
  let tokens = lex("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  1
}

fn lookup_source(sources: Array[(String, String)], path: String) -> String with { Error } {
  let mut i = 0
  let mut found = false
  let mut result = ""
  while i < Array::length(sources) && !found {
    let (candidate_path, source) = Array::get(sources, i)
    if candidate_path == path {
      result = source
      found = true
    }
    i = i + 1
  }
  if found {
    result
  } else {
    throw(String::concat("source not found: ", path))
  }
}

fn probe_parse_import_stmt(source: String) -> Int with { Error } {
  let tokens = lex(source)
  let (_, next) = parse_stmt(tokens, [
  ], 0)
  next
}

