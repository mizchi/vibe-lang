export fn selfbuild_probe_deep_if() -> Int with { Error } {
  let c = 40
  let result = if c == 43 {
    1
  }
  else if c == 45 {
    2
  }
  else if c == 42 {
    3
  }
  else if c == 47 {
    4
  }
  else if c == 37 {
    5
  }
  else if c == 61 {
    6
  }
  else if c == 33 {
    7
  }
  else if c == 60 {
    8
  }
  else if c == 62 {
    9
  }
  else if c == 38 {
    10
  }
  else if c == 124 {
    11
  }
  else if c == 94 {
    12
  }
  else if c == 40 {
    13
  }
  else if c == 41 {
    14
  }
  else if c == 123 {
    15
  }
  else 0
  result
}

fn probe_compile_source_len(source: String, entry_name: String) -> Int with { Error } {
  let bytes = compile_source_wasi_only(source, entry_name)
  Bytes::length(bytes)
}

export fn selfbuild_probe_fn_count() -> Int with { Error } {
  let sources = compiler_sources()
  let merged = collect_merged_stmts(sources)
  let mut count = 0
  let mut i = 0
  while i < Array::length(merged) {
    let stmt = Array::get(merged, i)
    match stmt {
      SLet(_, _, _, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => {
          count = count + 1
        },
        _ => ()
      }
      ,
      _ => ()
    }
    i = i + 1
  }
  count
}

fn build_type_db_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let (dep_path, dep_fp) = Array::get(dep_fps, i)
    acc = compact_string_fingerprint(String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp)))))
    i = i + 1
  }
  acc
}

