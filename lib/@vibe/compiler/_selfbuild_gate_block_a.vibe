export fn selfbuild_probe_linked_compile() -> Int with { Error } {
  let source = "let result = add(1, 2)\nresult"
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let linked = Array::slice([
    ("lib", "add", 2, 1)
  ], 0, 1)
  let no_srcs = array_empty()
  let bytes = compile_wasi_module_linked_impl(stmts, "run", no_srcs, linked, false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new())
  Bytes::length(bytes)
}

