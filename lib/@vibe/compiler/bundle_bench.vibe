//# Imports

import ./type_db.vibe {
  TypeDb, db_grouped_merged_source, db_merge_count, db_new
}

import @vibe/core {
  array_empty
}

//# Functions

let empty_sources: () -> Array[(String, String)] = () -> {
  array_empty()
}

let empty_groups: () -> Array[(String, Array[(String, String)])] = () -> {
  array_empty()
}

let source_file_name: (String, Int) -> String = (prefix, index) -> {
  String::concat(prefix, String::concat("_", String::concat(__to_string(index), ".vibe")))
}

let source_fn_name: (String, Int) -> String = (prefix, index) -> {
  String::concat(prefix, String::concat("_", __to_string(index)))
}

let source_body: (String, Int) -> String = (prefix, index) -> {
  let name = source_fn_name(prefix = prefix, index = index)
  String::concat("export let ", String::concat(name, String::concat(": () -> Int = () -> { ", String::concat(__to_string(index), " }\n"))))
}

let synthetic_group_sources: (String, Int) -> Array[(String, String)] = (prefix, count) -> {
  let sources = empty_sources()
  let mut i = 0
  while i < count {
    Array::push(sources, value = (source_file_name(prefix = prefix, index = i), source_body(prefix = prefix, index = i)))
    i = i + 1
  }
  sources
}

let synthetic_groups: () -> Array[(String, Array[(String, String)])] = () -> {
  [
    ("syntax", synthetic_group_sources(prefix = "syntax", count = 48)),
    ("loader", synthetic_group_sources(prefix = "loader", count = 48)),
    ("entry", synthetic_group_sources(prefix = "entry", count = 16)),
  ]
}

let synthetic_many_groups: (Int, Int) -> Array[(String, Array[(String, String)])] = (group_count, sources_per_group) -> {
  let groups = empty_groups()
  let mut i = 0
  while i < group_count {
    let group_name = String::concat("group_", __to_string(i))
    Array::push(groups, value = (group_name, synthetic_group_sources(prefix = group_name, count = sources_per_group)))
    i = i + 1
  }
  groups
}

//# Misc

let bench_groups: Array[Array[(String, Array[(String, String)])]] = [
  synthetic_groups()
]
let bench_many_groups: Array[Array[(String, Array[(String, String)])]] = [
  synthetic_many_groups(group_count = 96, sources_per_group = 2)
]
let warm_dbs: Array[TypeDb] = [db_new(checked_error_row = false)]
let warm_many_dbs: Array[TypeDb] = [db_new(checked_error_row = false)]

let bench_setup: () -> Int with Exception = () -> {
  let groups = synthetic_groups()
  let (_, _, warm_db) = db_grouped_merged_source(db = db_new(checked_error_row = false), groups = groups)
  let many_groups = synthetic_many_groups(group_count = 96, sources_per_group = 2)
  let (_, _, warm_many_db) = db_grouped_merged_source(db = db_new(checked_error_row = false), groups = many_groups)
  bench_groups[0] = groups
  bench_many_groups[0] = many_groups
  warm_dbs[0] = warm_db
  warm_many_dbs[0] = warm_many_db
  0
}

bench "bundle_grouped_merge_cold" {
  let (source, _, _) = db_grouped_merged_source(db = db_new(checked_error_row = false), groups = bench_groups[0])
  let _ = String::length(source)
}

bench "bundle_grouped_merge_warm" {
  let (source, _, db2) = db_grouped_merged_source(db = warm_dbs[0], groups = bench_groups[0])
  let _ = String::length(source) + db_merge_count(db2)
}

bench "bundle_many_groups_cold" {
  let (source, _, _) = db_grouped_merged_source(db = db_new(checked_error_row = false), groups = bench_many_groups[0])
  let _ = String::length(source)
}

bench "bundle_many_groups_warm" {
  let (source, _, db2) = db_grouped_merged_source(db = warm_many_dbs[0], groups = bench_many_groups[0])
  let _ = String::length(source) + db_merge_count(db2)
}
