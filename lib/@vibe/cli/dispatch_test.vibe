//# Imports

import ./dispatch.vibe {
  parse_build_args,
  parse_check_args,
  parse_compile_args,
  parse_compile_lite_args,
  selfhost_cli_build_args,
  selfhost_cli_check_args,
  selfhost_cli_compile_args,
  selfhost_cli_compile_lite_args,
  selfhost_cli_low_level_args_profiled
}

import ./entry.vibe {
  run_cli_main_with_args
}

//# Effects

effect Profiler {
  NowUs -> Int
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn run_compile_lite_with_fake_profiler(args: Array[String]) -> Int with Error + Fs + Env {
  let mut tick = 1000
  handle {
    selfhost_cli_compile_lite_args(args)
  } with Profiler {
    NowUs => {
      tick = tick + 1000
      resume(tick)
    }
  }
}

fn run_low_level_with_fake_profiler(input_path: String, output_path: String, entry_name: String, mode: String, profile_path: String, callstack_path: String) -> Int with Error + Fs + Env {
  let mut tick = 1000
  handle {
    selfhost_cli_low_level_args_profiled(input_path, output_path, entry_name, mode, profile_path, callstack_path)
  } with Profiler {
    NowUs => {
      tick = tick + 1000
      resume(tick)
    }
  }
}

//# Misc

test "selfhost cli parses compile-lite command args" {
  let (input_path, output_path, entry_name, mode, in_memory) = parse_compile_lite_args([
    "compile-lite",
    "--wasm-linear",
    "--entry",
    "answer",
    "--no-dce",
    "main.vibe",
    "-o",
    "out.wasm"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "out.wasm")
  assert(entry_name == "answer")
  assert(mode == "no-dce")
  assert(!in_memory)
}

test "selfhost cli compile-lite selects main for vibex" {
  let (input_path, output_path, entry_name, mode, in_memory) = parse_compile_lite_args([
    "compile-lite",
    "--wasm-linear",
    "app.vibex",
    "-o",
    "app.wasm"
  ])
  assert(input_path == "app.vibex")
  assert(output_path == "app.wasm")
  assert(entry_name == "main")
  assert(mode == "mvp")
  assert(!in_memory)
}

test "selfhost cli compile-lite rejects entry override for vibex" {
  let result = handle {
    let _ = parse_compile_lite_args([
      "compile-lite",
      "--wasm-linear",
      "--entry",
      "answer",
      "app.vibex",
      "-o",
      "app.wasm"
    ])
    "OK"
  } with Error {
    Throw(e) => e
  }
  assert(result == "compile-lite: --entry is not allowed for .vibex; the entry is always main")
}

