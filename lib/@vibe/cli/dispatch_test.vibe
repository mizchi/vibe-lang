test "selfhost cli check command writes profile tsv" {
  let main_path = "/tmp/vibe_selfhost_cli_check_profile_main.vibe"
  let profile_path = "/tmp/vibe_selfhost_cli_check_profile.tsv"
  let callstack_path = "/tmp/vibe_selfhost_cli_check_callstack.tsv"
  let source = "let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_check_args([
    "check",
    "--profile-tsv",
    profile_path,
    "--profile-callstack",
    callstack_path,
    main_path
  ])
  assert(status == 0)
  assert(Fs::exists(profile_path))
  assert(Fs::exists(callstack_path))
  let profile = Fs::read_file(profile_path)
  assert(String::contains(profile, "stage\telapsed_ms\telapsed_us"))
  assert(String::contains(profile, "type\t0\t0"))
  assert(String::contains(profile, "total\t0\t0"))
}
