test "profile command plans a versioned host action without losing spaces" {
  let plan_path = "/tmp/vibe_selfhost_cli_profile_action.txt"
  let status = selfhost_cli_profile_plan_args([
    "profile",
    "program.vibex",
    "--out",
    "/tmp/cpu profiles/run.json",
    "--interval-us=250",
    "--",
    "guest arg"
  ], plan_path)
  assert(status == 0)
  let plan = Fs::read_file(plan_path)
  assert(plan == "vibe-host-action-v1\nrun-guest-profile\nprogram.vibex\n/tmp/cpu profiles/run.json\n250\nguest arg\n")
}

test "profile command rejects an empty output path" {
  for args in [
    ["profile", "program.vibex", "--out", ""],
    ["profile", "program.vibex", "--out="]
  ] {
    let result = handle {
      let _ = selfhost_cli_profile_plan_args(args, "/tmp/vibe_empty_profile_action.txt")
      "OK"
    } with { Exception::Throw(e) => e }
    assert(result == "profile: --out must not be empty")
  }
}

test "profile command rejects an --out that aliases the source" {
  let result = handle {
    let _ = selfhost_cli_user_dispatch_args([
      "profile",
      "program.vibex",
      "--out",
      "program.vibex"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "profile: --out must not alias the source")
}

test "user run plan keeps arguments after --" {
  let plan_path = "/tmp/vibe_user_dispatch_run_separator.txt"
  let src_path = "/tmp/vibe_user_dispatch_run_separator.vibex"
  Fs::write_bytes(src_path, string_to_bytes("fn main allows Console {\n  println(\"42\")\n}\n"))
  let status = selfhost_cli_run_plan_args(["run", src_path, "--", "guest arg"], plan_path)
  assert(status == 0)
  let plan = Fs::read_file(plan_path)
  assert(String::contains(plan, "guest arg\n"))
}

test "user bench refuses an empty --guest-profile" {
  let result = handle {
    let _ = selfhost_cli_user_dispatch_args([
      "bench",
      "--guest-profile=",
      "missing.vibe"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "bench: --guest-profile must not be empty")
}

//# Effects

effect Profiler {
  NowUs -> Int
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = Array::slice([0], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn run_compile_lite_with_fake_profiler(args: Array[String]) -> Int with Exception + Fs + Env {
  let mut tick = 1000
  handle {
    selfhost_cli_compile_lite_args(args)
  } with { Profiler::NowUs => {
    tick = tick + 1000
    resume(tick)
  } }
}

fn run_low_level_with_fake_profiler(input_path: String, output_path: String, entry_name: String, mode: String, profile_path: String, callstack_path: String) -> Int with Exception + Fs + Env {
  let mut tick = 1000
  handle {
    selfhost_cli_low_level_args_profiled(input_path, output_path, entry_name, mode, profile_path, callstack_path)
  } with { Profiler::NowUs => {
    tick = tick + 1000
    resume(tick)
  } }
}

