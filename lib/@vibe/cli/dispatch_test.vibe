test "selfhost cli compile-lite command writes wasm" {
  let main_path = "/tmp/vibe_selfhost_cli_compile_lite_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_compile_lite_out.wasm"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = run_compile_lite_with_fake_profiler([
    "compile-lite",
    "--wasm",
    "--entry",
    "answer",
    main_path,
    "-o",
    output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli compile-lite command does not profile without profile args" {
  let main_path = "/tmp/vibe_selfhost_cli_compile_lite_no_profile_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_compile_lite_no_profile_out.wasm"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let mut profiler_calls = 0
  let status = handle {
    selfhost_cli_compile_lite_args([
      "compile-lite",
      "--wasm",
      "--entry",
      "answer",
      main_path,
      "-o",
      output_path
    ])
  } with Profiler {
    NowUs => {
      profiler_calls = profiler_calls + 1
      resume(1000)
    }
  }
  assert(status == 0)
  assert(Fs::exists(output_path))
  assert(profiler_calls == 0)
}

test "selfhost cli compile-lite command writes profile tsv" {
  let main_path = "/tmp/vibe_selfhost_cli_compile_lite_profile_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_compile_lite_profile_out.wasm"
  let profile_path = "/tmp/vibe_selfhost_cli_compile_lite_profile.tsv"
  let callstack_path = "/tmp/vibe_selfhost_cli_compile_lite_callstack.tsv"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = run_compile_lite_with_fake_profiler([
    "compile-lite",
    "--wasm",
    "--entry",
    "answer",
    "--profile-tsv",
    profile_path,
    "--profile-callstack",
    callstack_path,
    main_path,
    "-o",
    output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
  assert(Fs::exists(profile_path))
  assert(Fs::exists(callstack_path))
  let profile = Fs::read_file(profile_path)
  assert(String::contains(profile, "stage\telapsed_ms\telapsed_us"))
  assert(String::contains(profile, "load\t"))
  assert(String::contains(profile, "type\t"))
  assert(String::contains(profile, "bundle\t"))
  assert(String::contains(profile, "parse\t"))
  assert(String::contains(profile, "compile\t"))
  assert(String::contains(profile, "write\t"))
  assert(String::contains(profile, "total\t"))
  assert(!String::contains(profile, "write\t0\t0"))
  assert(!String::contains(profile, "total\t0\t0"))
  let callstack = Fs::read_file(callstack_path)
  assert(String::contains(callstack, "compile\t"))
  assert(!String::contains(callstack, "compile\t0\t0"))
}

/// Regression: the cli_main handler nesting (Profiler inner / Error outer) must
/// keep a *successful* `--profile-tsv` compile returning 0. The #543 reorder
/// (Error inner) made `perform NowUs` unwind through the Error handler and the
/// miscompiled resume corrupted the result to 1, breaking selfhost-perf-kpi.
/// This drives the production entry wrapper `run_cli_main_with_args` directly, so
/// flipping the handler order in entry.vibe fails this test.
test "cli_main nesting: profiled compile succeeds (exit 0)" {
  let main_path = "/tmp/vibe_selfhost_cli_main_nest_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_main_nest_out.wasm"
  let profile_path = "/tmp/vibe_selfhost_cli_main_nest_profile.tsv"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = run_cli_main_with_args([
    "compile-lite",
    "--wasm",
    "--entry",
    "answer",
    "--profile-tsv",
    profile_path,
    main_path,
    "-o",
    output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
  assert(Fs::exists(profile_path))
}

test "selfhost cli low-level entry writes profile tsv from env" {
  let main_path = "/tmp/vibe_selfhost_cli_low_level_profile_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_low_level_profile_out.wasm"
  let profile_path = "/tmp/vibe_selfhost_cli_low_level_profile.tsv"
  let callstack_path = "/tmp/vibe_selfhost_cli_low_level_callstack.tsv"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = run_low_level_with_fake_profiler(main_path, output_path, "answer", "mvp", profile_path, callstack_path)
  assert(status == 0)
  assert(Fs::exists(output_path))
  assert(Fs::exists(profile_path))
  assert(Fs::exists(callstack_path))
  let profile = Fs::read_file(profile_path)
  assert(String::contains(profile, "stage\telapsed_ms\telapsed_us"))
  assert(String::contains(profile, "compile\t"))
  assert(String::contains(profile, "write\t"))
  assert(String::contains(profile, "total\t"))
  assert(!String::contains(profile, "total\t0\t0"))
  let callstack = Fs::read_file(callstack_path)
  assert(String::contains(callstack, "compile\t"))
}

test "selfhost cli parses compile command args" {
  let (input_path, output_path, entry_name, mode) = parse_compile_args([
    "compile",
    "--wasm-linear",
    "--no-dce",
    "main.vibe",
    "-o",
    "out.wasm"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "out.wasm")
  assert(entry_name == "_start")
  assert(mode == "no-dce")
}

test "selfhost cli compile selects main and strips vibex suffix" {
  let (input_path, output_path, entry_name, mode) = parse_compile_args([
    "compile",
    "--wasm-linear",
    "app.vibex"
  ])
  assert(input_path == "app.vibex")
  assert(output_path == "dist/app.wasm")
  assert(entry_name == "main")
  assert(mode == "mvp")
}

