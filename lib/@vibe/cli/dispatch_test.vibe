test "selfhost cli check command accepts valid file" {
  let main_path = "/tmp/vibe_selfhost_cli_check_main.vibe"
  let source = "let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_check_args(["check", main_path])
  assert(status == 0)
}

test "selfhost cli check accepts a require pin head" {
  // #2227: the build lane always blanked `require ... = #pkg:sha1:` heads
  // before parsing; check's own pre-parse did not, so it reported
  // `unexpected token: =` for a file the build compiles. The two lanes
  // must answer alike -- check is the designated authority on "does this
  // compile".
  let main_path = "/tmp/vibe_selfhost_cli_check_pin_head.vibe"
  let source = "require @vibe/core 0.2.0 = #pkg:sha1:0000000000000000000000000000000000000000\n\nlet answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_check_args(["check", main_path])
  assert(status == 0)
}

test "selfhost cli check command writes profile tsv" {
  let main_path = "/tmp/vibe_selfhost_cli_check_profile_main.vibe"
  let profile_path = "/tmp/vibe_selfhost_cli_check_profile.tsv"
  let callstack_path = "/tmp/vibe_selfhost_cli_check_callstack.tsv"
  let source = "let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_check_args([
    "check",
    "--profile-tsv",
    profile_path,
    "--profile-callstack",
    callstack_path,
    main_path
  ])
  assert(status == 0)
  assert(Fs::exists(profile_path))
  assert(Fs::exists(callstack_path))
  let profile = Fs::read_file(profile_path)
  assert(String::contains(profile, "stage\telapsed_ms\telapsed_us"))
  assert(String::contains(profile, "type\t0\t0"))
  assert(String::contains(profile, "total\t0\t0"))
}

/// #1888: check throws a String payload (`Throw(e) => e` is String, same as
/// the other dispatch_test handlers). `run_cli_main_with_args` is the
/// production wrapper that used to drop that payload and exit 1 silently.
test "cli_main nesting: check usage throw is a printable String and exits 1" {
  let thrown = handle {
    let _ = selfhost_cli_check_args(["check"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(thrown == "check: expected <file...>")
  let status = run_cli_main_with_args(["check"])
  assert(status == 1)
}

/// #2361: the positional low-level form returned a bare `1` for every way of
/// being wrong -- no input, no output, no entry, a file that is not there, an
/// unrecognized mode. The exit code is unchanged; what was missing is the
/// reason, and "the file is broken", "this verb is not supported" and "the
/// toolchain is not built" were indistinguishable from the output.
///
/// The unknown-verb case arrives here because dispatch falls through to the
/// positional form for anything that is not a subcommand, so `vibe_cli.sh deps
/// foo.vibe` compiles a file named `deps`. Saying what was read as what is what
/// makes that visible.
fn low_level_throw(input_path: String, output_path: String, entry_name: String, mode: String) -> String with Env + Exception + Fs + Profiler {
  handle {
    let _ = selfhost_cli_low_level_args(input_path, output_path, entry_name, mode)
    "OK"
  } with { Exception::Throw(e) => e }
}

test "low-level form names what it read when an argument is missing" {
  assert(String::contains(low_level_throw("", "", "", ""), "no input path"))
  let no_output = low_level_throw("deps", "", "", "")
  assert(String::contains(no_output, "no output path"))
  assert(String::contains(no_output, "read `deps` as the input path"))
  // `vibe_cli.sh deps foo.vibe`: not a subcommand, so `deps` became the input.
  let no_entry = low_level_throw("deps", "lib/x.vibe", "", "")
  assert(String::contains(no_entry, "no entry name"))
  assert(String::contains(no_entry, "read `deps` as the input path"))
  assert(String::contains(no_entry, "`lib/x.vibe` as the output path"))
  // Every one of them points at the two things that ARE accepted.
  for message in [no_output, no_entry] {
    assert(String::contains(message, "<input> <output> <entry> [mode]"))
    assert(String::contains(message, "build, check, compile, compile-lite, profile, serve"))
  }
}

test "low-level form names a missing input file and an unknown mode" {
  let missing = low_level_throw("/tmp/vibe_no_such_input_2361.vibe", "/tmp/vibe_2361_out.wasm", "main", "")
  assert(String::contains(missing, "no such input file: /tmp/vibe_no_such_input_2361.vibe"))
  let real_path = "/tmp/vibe_selfhost_cli_2361_mode.vibe"
  Fs::write_bytes(real_path, string_to_bytes("export let answer: () -> Int = () -> { 42 }\n"))
  let bad_mode = low_level_throw(real_path, "/tmp/vibe_2361_out.wasm", "answer", "frobnicate")
  assert(String::contains(bad_mode, "unknown mode `frobnicate`"))
  assert(String::contains(bad_mode, "release, no-dce, mvp, debug, check"))
  // The control: the same call with a mode that IS recognized does not throw.
  assert(low_level_throw(real_path, "/tmp/vibe_2361_out.wasm", "answer", "release") == "OK")
}

/// The exit code these carry is the one they always had -- 1, via the entry
/// wrapper's Exception arm. Only the printed reason is new.
test "an unexplained low-level failure still exits 1" {
  assert(run_cli_main_with_args([
    "/tmp/vibe_no_such_input_2361.vibe",
    "/tmp/vibe_2361_out.wasm",
    "main"
  ]) == 1)
}

/// Same framing as `runtime/vibe` `emit_check_diagnostics`: `error: ` on a
/// diagnostic start, `hint:` / leading whitespace indented so
/// `grep -c '^error: '` stays an exact count.
test "format_check_report prefixes diagnostic starts and indents hint continuations" {
  assert(format_check_report("type mismatch") == "error: type mismatch")
  assert(format_check_report("parse a\nparse b") == "error: parse a\nerror: parse b")
  assert(format_check_report("effect row mismatch\nhint: add 'with Env' to 'f'") == "error: effect row mismatch\n  hint: add 'with Env' to 'f'")
  assert(format_check_report("msg\n  more") == "error: msg\n    more")
}

/// #1888: the reported hole — type error through the production check path.
test "cli_main nesting: check type error throws a diagnostic and exits 1" {
  let main_path = "/tmp/vibe_selfhost_cli_check_type_error.vibe"
  let source = "fn f() -> Int {\n  \"s\"\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let thrown = handle {
    let _ = selfhost_cli_check_args(["check", main_path])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(thrown != "OK")
  assert(String::length(thrown) > 0)
  let report = format_check_report(thrown)
  assert(String::starts_with(report, "error: "))
  assert(!String::starts_with(report, "error: error:"))
  let status = run_cli_main_with_args(["check", main_path])
  assert(status == 1)
}

/// #1888 review: a thrown check diagnostic that carries a `hint:`
/// continuation must stay one `error: ` start (the installed-launcher
/// contract pinned by tests/integration/install/install_test.sh).
test "cli_main nesting: check effect-row diagnostic frames hint as a continuation" {
  let main_path = "/tmp/vibe_selfhost_cli_check_effect_hint.vibe"
  let source = "fn leaky() -> String {\n  Env::get(\"HOME\")\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let thrown = handle {
    let _ = selfhost_cli_check_args(["check", main_path])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(thrown, "effect row mismatch"))
  assert(String::contains(thrown, "hint: "))
  let report = format_check_report(thrown)
  assert(String::starts_with(report, "error: "))
  assert(String::contains(report, "\n  hint: "))
  let lines = String::split(report, "\n")
  let mut error_starts = 0
  let mut i = 0
  while i < Array::length(lines) {
    if String::starts_with(Array::get(lines, i), "error: ") {
      error_starts = error_starts + 1
    }
    i = i + 1
  }
  assert(error_starts == 1)
  let status = run_cli_main_with_args(["check", main_path])
  assert(status == 1)
}

test "user dispatch recognizes launcher verbs" {
  assert(user_dispatch_is_verb("check"))
  assert(user_dispatch_is_verb("compile"))
  assert(user_dispatch_is_verb("build"))
  assert(user_dispatch_is_verb("fmt"))
  assert(user_dispatch_is_verb("normalize"))
  assert(user_dispatch_is_verb("type-at"))
  assert(user_dispatch_is_verb("doc-at"))
  assert(user_dispatch_is_verb("binding-at"))
  assert(user_dispatch_is_verb("symbols"))
  assert(user_dispatch_is_verb("escapes"))
  assert(user_dispatch_is_verb("rc-classify"))
  assert(user_dispatch_is_verb("rc-plan"))
  assert(user_dispatch_is_verb("allocs"))
  assert(user_dispatch_is_verb("deps"))
  assert(user_dispatch_is_verb("diagnostics"))
  assert(user_dispatch_is_verb("grep"))
  assert(user_dispatch_is_verb("run"))
  assert(user_dispatch_is_verb("test"))
  assert(user_dispatch_is_verb("bench"))
  assert(user_dispatch_is_verb("serve"))
  assert(user_dispatch_is_verb("profile"))
  assert(user_dispatch_is_verb("lsp"))
  assert(user_dispatch_is_verb("hash"))
  assert(user_dispatch_is_verb("inspect-update"))
  assert(user_dispatch_is_verb("help"))
  assert(user_dispatch_is_verb("--help"))
  assert(user_dispatch_is_verb("-h"))
  assert(!user_dispatch_is_verb("compile-lite"))
  assert(!user_dispatch_is_verb("new"))
  assert(!user_dispatch_is_verb(""))
}

test "display_under_root reports the default build dir relative to the project" {
  assert(display_under_root(".vibe/build/out/deep.wasm", ".vibe/build") == ".vibe/build/out/deep.wasm")
  assert(display_under_root("/proj/.vibe/build/out/deep.wasm", "/proj/.vibe/build") == ".vibe/build/out/deep.wasm")
  assert(display_under_root("/tmp/bd/out/deep.wasm", "/tmp/bd") == "/tmp/bd/out/deep.wasm")
  assert(display_under_root("sub/out.wasm", "/proj/.vibe/build") == "sub/out.wasm")
}

test "root_rel_from_invoke prefixes relative paths and leaves absolute paths" {
  assert(root_rel_from_invoke("sub", "deep.vibex") == "sub/deep.vibex")
  assert(root_rel_from_invoke("sub", "./deep.vibex") == "sub/deep.vibex")
  assert(root_rel_from_invoke("sub", ".") == "sub")
  assert(root_rel_from_invoke("sub", "/abs/x.vibe") == "/abs/x.vibe")
  assert(root_rel_from_invoke("", "deep.vibex") == "deep.vibex")
  assert(root_rel_from_invoke("", ".") == ".")
}

test "rewrite_user_argv prefixes relative paths with the invoke dir" {
  let root = "/tmp/vibe_user_dispatch_rewrite_root"
  let sub = "/tmp/vibe_user_dispatch_rewrite_root/sub"
  Fs::mkdir_p(sub)
  Fs::write_bytes(String::concat(sub, "/deep.vibex"), string_to_bytes("fn main allows Console {\n  println(\"42\")\n}\n"))
  let run_args = rewrite_user_argv(["run", "deep.vibex"], sub, root)
  assert(Array::length(run_args) == 2)
  assert(Array::get(run_args, 0) == "run")
  assert(Array::get(run_args, 1) == "sub/deep.vibex")
  let build_args = rewrite_user_argv(["build", "deep.vibex", "-o", "out.wasm"], sub, root)
  assert(Array::get(build_args, 1) == "sub/deep.vibex")
  assert(Array::get(build_args, 3) == "sub/out.wasm")
  let guest = rewrite_user_argv(["run", "deep.vibex", "--", "rel.txt"], sub, root)
  assert(Array::get(guest, 3) == "rel.txt")
  let abs = rewrite_user_argv([
    "check",
    "/tmp/vibe_user_dispatch_rewrite_root/sub/deep.vibex"
  ], sub, root)
  assert(Array::get(abs, 1) == "/tmp/vibe_user_dispatch_rewrite_root/sub/deep.vibex")
  let at_root = rewrite_user_argv(["run", "deep.vibex"], root, root)
  assert(Array::get(at_root, 1) == "deep.vibex")
  let type_at = rewrite_user_argv(["type-at", "deep.vibex", "1", "2"], sub, root)
  assert(Array::get(type_at, 1) == "sub/deep.vibex")
  assert(Array::get(type_at, 2) == "1")
  assert(Array::get(type_at, 3) == "2")
  let jobs = rewrite_user_argv(["test", "--jobs", "4", "deep.vibex"], sub, root)
  assert(Array::get(jobs, 2) == "4")
  assert(Array::get(jobs, 3) == "sub/deep.vibex")
  let entry = rewrite_user_argv(["compile", "--entry", "foo", "deep.vibex"], sub, root)
  assert(Array::get(entry, 2) == "foo")
  assert(Array::get(entry, 3) == "sub/deep.vibex")
  let gp = rewrite_user_argv(["run", "--guest-profile=out.json", "deep.vibex"], sub, root)
  assert(Array::get(gp, 1) == "--guest-profile=sub/out.json")
  assert(Array::get(gp, 2) == "sub/deep.vibex")
}

test "expand_user_test_inputs collects *_test.vibe under a directory" {
  let dir = "/tmp/vibe_user_dispatch_test_dir"
  let nested = "/tmp/vibe_user_dispatch_test_dir/nested"
  Fs::mkdir_p(nested)
  Fs::write_bytes(String::concat(dir, "/a_test.vibe"), string_to_bytes("test { assert(true) }\n"))
  Fs::write_bytes(String::concat(dir, "/skip.vibe"), string_to_bytes("fn f() -> Int { 1 }\n"))
  Fs::write_bytes(String::concat(nested, "/b_test.vibe"), string_to_bytes("test { assert(true) }\n"))
  let files = expand_user_test_inputs([dir])
  assert(Array::length(files) == 2)
  assert(Array::get(files, 0) == "/tmp/vibe_user_dispatch_test_dir/a_test.vibe")
  assert(Array::get(files, 1) == "/tmp/vibe_user_dispatch_test_dir/nested/b_test.vibe")
  let named = expand_user_test_inputs([
    "/tmp/vibe_user_dispatch_test_dir/skip.vibe"
  ])
  assert(Array::length(named) == 1)
  assert(Array::get(named, 0) == "/tmp/vibe_user_dispatch_test_dir/skip.vibe")
  let missing = handle {
    let _ = expand_user_test_inputs([
      "/tmp/vibe_user_dispatch_test_dir/nope.vibe"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::starts_with(missing, "not found: "))
  let empty_dir = "/tmp/vibe_user_dispatch_empty_test_dir"
  Fs::mkdir_p(empty_dir)
  let empty = handle {
    let _ = expand_user_test_inputs([empty_dir])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(empty == "vibe test: no test files found")
}

test "user dispatch inspect-update patches a stale inspect content literal" {
  let src = "/tmp/vibe_user_dispatch_inspect_update.vibe"
  let cap = "/tmp/vibe_user_dispatch_inspect_update.out"
  Fs::write_bytes(src, string_to_bytes("test {\n  inspect(1, \"0\")\n}\n"))
  Fs::write_bytes(cap, string_to_bytes("inspect mismatch:\n  actual:   1\n  expected: 0\n"))
  let status = selfhost_cli_user_dispatch_args(["inspect-update", src, cap])
  assert(status == 0)
  assert(Fs::read_file(src) == "test {\n  inspect(1, \"1\")\n}\n")
}

test "user test plan expands a directory to *_test.vibe files" {
  let dir = "/tmp/vibe_user_dispatch_test_plan_dir"
  Fs::mkdir_p(dir)
  Fs::write_bytes(String::concat(dir, "/cwd_test.vibe"), string_to_bytes("test \"n\" {\n  assert_eq(1, 1)\n}\n"))
  let plan_path = "/tmp/vibe_user_dispatch_test_plan.txt"
  let status = selfhost_cli_test_plan_args(["test", dir], plan_path)
  assert(status == 0)
  let plan = Fs::read_file(plan_path)
  assert(String::starts_with(plan, "vibe-host-action-v1\nrun-tests\n"))
  assert(String::contains(plan, "/tmp/vibe_user_dispatch_test_plan_dir/cwd_test.vibe"))
  assert(!String::contains(plan, "/tmp/vibe_user_dispatch_test_plan_dir\t"))
}

test "user compile parse defaults to the build-dir artifact" {
  let (input_path, output_path, entry_name, wit, minify, component) = parse_user_compile_args([
    "compile",
    "app.vibe"
  ])
  assert(input_path == "app.vibe")
  assert(output_path == ".vibe/build/out/app.wasm")
  assert(entry_name == "main")
  assert(!wit)
  assert(!minify)
  assert(!component)
}

test "user compile parse honors -o and --wit" {
  let (input_path, output_path, entry_name, wit, minify, component) = parse_user_compile_args([
    "compile",
    "--wit",
    "srv.vibe",
    "-o",
    "out.wit"
  ])
  assert(input_path == "srv.vibe")
  assert(output_path == "out.wit")
  assert(entry_name == "main")
  assert(wit)
  assert(!minify)
  assert(!component)
}

/// `--component` reaches the door the LAUNCHER uses.
///
/// It landed on `parse_build_args` (#2861/#2863), and moving argv parsing into
/// `user_dispatch.vibe` left that function reachable only from this file --
/// so its `--component` tests kept passing while `vibe build --component`
/// answered `unsupported option: --component`. A test that can only be reached
/// by calling the function directly certifies nothing about the CLI, which is
/// why the pair below asks `user_dispatch_is_verb` WHICH door is live and then
/// tests that one.
test "build/compile go to the user-dispatch door, so that is where --component has to be" {
  assert(user_dispatch_is_verb("build"))
  assert(user_dispatch_is_verb("compile"))
}

test "user compile parse accepts --component on the shared lane" {
  let (input_path, output_path, entry_name, wit, minify, component) = parse_user_compile_args([
    "build",
    "--component",
    "cmd.vibe"
  ])
  assert(input_path == "cmd.vibe")
  assert(output_path == ".vibe/build/out/cmd.component.wasm")
  // Not the literal "vibe_command": the point is that BOTH doors read the one
  // spelling in cli_support.vibe, so a change there moves both or neither.
  assert(entry_name == command_component_entry())
  assert(!wit)
  assert(!minify)
  assert(component)
}

test "user compile parse refuses --component with --wit" {
  let result = handle {
    let _ = parse_user_compile_args([
      "build",
      "--component",
      "--wit",
      "cmd.vibe"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "--component and --wit produce different artifacts from the same file; run them separately")
}

test "user compile parse refuses --component with --entry" {
  let result = handle {
    let _ = parse_user_compile_args([
      "build",
      "--component",
      "--entry",
      "foo",
      "cmd.vibe"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "--component has no command entry; its surface is the lifted `run` export, so --entry is not allowed")
}

test "user compile parse refuses --component with --minify" {
  let result = handle {
    let _ = parse_user_compile_args([
      "build",
      "--component",
      "--minify",
      "cmd.vibe"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "--component and --minify cannot be combined: the minifier takes a core module, not a component")
}

test "user compile parse refuses --component on a vibex" {
  let result = handle {
    let _ = parse_user_compile_args(["build", "--component", "app.vibex"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::starts_with(result, "--component needs a .vibe module:"))
}

/// The mode is the OTHER half of the shared lane. #2863 measured the same flag
/// producing 40 MB through one door and 2.6 MB through the other, because each
/// door spelled the compile mode for itself; this pins that the name still
/// resolves rather than that it equals some literal.
test "the command-component compile mode is the one cli_support.vibe names" {
  assert(command_component_compile_mode() == "dce-root")
  assert(command_component_entry() == "vibe_command")
}

test "user compile parse rejects --entry on vibex" {
  let result = handle {
    let _ = parse_user_compile_args(["compile", "--entry", "foo", "app.vibex"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == ".vibex entry is always main; --entry is not allowed")
}

test "user check parse accepts --single-file and --json" {
  let (path, single, json) = parse_user_check_args([
    "check",
    "--single-file",
    "--json",
    "a.vibe"
  ])
  assert(path == "a.vibe")
  assert(single)
  assert(json)
}

test "user fmt parse accepts --stdout and --check" {
  let (path, mode) = parse_user_fmt_args(["fmt", "--stdout", "a.vibe"])
  assert(path == "a.vibe")
  assert(mode == "stdout")
  let (path2, mode2) = parse_user_fmt_args(["fmt", "--check", "b.vibe"])
  assert(path2 == "b.vibe")
  assert(mode2 == "check")
}

test "user type-at parse takes file line col" {
  let (path, line, col) = parse_user_type_at_args([
    "type-at",
    "a.vibe",
    "2",
    "4"
  ])
  assert(path == "a.vibe")
  assert(line == 2)
  assert(col == 4)
}

test "user dispatch check on a clean file is empty stdout and exit 0" {
  let main_path = "/tmp/vibe_user_dispatch_check_clean.vibe"
  Fs::write_bytes(main_path, string_to_bytes("fn f() -> Int {\n  1 + 2\n}\n"))
  let status = selfhost_cli_user_dispatch_args(["check", main_path])
  assert(status == 0)
  let wrapped = run_cli_main_with_args(["check", main_path])
  assert(wrapped == 0)
}

test "user dispatch check on an ill-typed file exits 1" {
  let main_path = "/tmp/vibe_user_dispatch_check_bad.vibe"
  Fs::write_bytes(main_path, string_to_bytes("fn f() -> Int {\n  \"s\"\n}\n"))
  let status = run_cli_main_with_args(["check", main_path])
  assert(status == 1)
}

test "user dispatch compile writes a wasm artifact" {
  let main_path = "/tmp/vibe_user_dispatch_compile_main.vibex"
  let output_path = "/tmp/vibe_user_dispatch_compile_out.wasm"
  Fs::write_bytes(main_path, string_to_bytes("fn main allows Console {\n  println(\"42\")\n}\n"))
  let status = selfhost_cli_user_dispatch_args([
    "compile",
    main_path,
    "-o",
    output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "user dispatch fmt --stdout reprints a fixpoint" {
  let main_path = "/tmp/vibe_user_dispatch_fmt.vibe"
  let source = "fn f() -> Int {\n  1\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_user_dispatch_args(["fmt", "--stdout", main_path])
  assert(status == 0)
}

test "user dispatch type-at answers Int for a literal" {
  let main_path = "/tmp/vibe_user_dispatch_type_at.vibe"
  let source = "let answer: Int = 40 + 2\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let (path, line, col) = parse_user_type_at_args([
    "type-at",
    main_path,
    "1",
    "5"
  ])
  assert(path == main_path)
  assert(line == 1)
  assert(col == 5)
  let status = selfhost_cli_user_dispatch_args(["type-at", main_path, "1", "5"])
  assert(status == 0)
}

test "user dispatch run plans a versioned host action" {
  let plan_path = "/tmp/vibe_user_dispatch_run_plan.txt"
  let src_path = "/tmp/vibe_user_dispatch_run.vibex"
  Fs::write_bytes(src_path, string_to_bytes("fn main allows Console {\n  println(\"42\")\n}\n"))
  let status = selfhost_cli_run_plan_args(["run", src_path], plan_path)
  assert(status == 0)
  let plan = Fs::read_file(plan_path)
  assert(String::starts_with(plan, "vibe-host-action-v1\nrun-guest\n"))
  assert(String::contains(plan, src_path))
}
