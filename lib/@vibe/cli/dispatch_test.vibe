test "selfhost cli build requires explicit vibex main effect row" {
  let main_path = "/tmp/vibe_selfhost_cli_inferred_main_row.vibex"
  Fs::write_bytes(main_path, string_to_bytes("fn main { () }\n"))
  let result = handle {
    let _ = selfhost_cli_build_args([
      "build",
      main_path,
      "-o",
      "/tmp/vibe_selfhost_cli_inferred_main_row.wasm"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, ".vibex fn main requires an explicit effect row"))
  // ADR-0088: the edit is the canonical pure entry, not the legacy `with ()`.
  assert(String::contains(result, "write 'allows ()' for a pure entry"))
}

test "selfhost cli build rejects non-main export in vibex" {
  // #2229 (ADR-0075): nothing can import a .vibex, so an export in one is
  // unreachable by construction. The diagnostic names the move.
  let main_path = "/tmp/vibe_selfhost_cli_vibex_export.vibex"
  Fs::write_bytes(main_path, string_to_bytes("export fn helper() -> Int { 7 }\nfn main allows () { () }\n"))
  let result = handle {
    let _ = selfhost_cli_build_args([
      "build",
      main_path,
      "-o",
      "/tmp/vibe_selfhost_cli_vibex_export.wasm"
    ])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, ".vibex is an executable root and has no export surface"))
  assert(String::contains(result, "move 'export fn helper' to a .vibe module"))
}

test "selfhost cli build accepts vibex with require pin head" {
  // #2227: a `require ... = #pkg:sha1:` head is a directive, not statement
  // grammar. It used to be read as an unknown `#` directive on this lane.
  let main_path = "/tmp/vibe_selfhost_cli_vibex_pin_head.vibex"
  let output_path = "/tmp/vibe_selfhost_cli_vibex_pin_head.wasm"
  Fs::write_bytes(main_path, string_to_bytes("require @vibe/core 0.2.0 = #pkg:sha1:0000000000000000000000000000000000000000\n\nfn main allows () { () }\n"))
  let status = selfhost_cli_build_args(["build", main_path, "-o", output_path])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli build consumes profile flag" {
  let (input_path, output_path, entry_name, mode, component) = parse_build_args([
    "build",
    "--profile",
    "/tmp/build.pprof",
    "main.vibe"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "main.wasm")
  assert(entry_name == "_start")
  assert(mode == "mvp")
  assert(!component)
}

test "selfhost cli build --component defaults to a .component.wasm beside the source" {
  let (input_path, output_path, entry_name, mode, component) = parse_build_args([
    "build",
    "--component",
    "cmd/check.vibe"
  ])
  assert(input_path == "cmd/check.vibe")
  assert(output_path == "cmd/check.component.wasm")
  // Under `dce-root` this name is the DCE ROOT, not the codegen entry: the
  // core is still emitted as a library so the lifted export survives ADR-0077
  // stripping, but what the root cannot reach is pruned.
  assert(entry_name == "vibe_command")
  assert(mode == "dce-root")
  assert(component)
}

test "selfhost cli build --component takes the SAME lane as the launcher adapter" {
  // The two front doors of `vibe build --component` must not be able to
  // disagree. They had independent literals for one commit, and the same flag
  // produced a 40 MB artifact through the `.vibex` CLI and 2.6 MB through the
  // launcher's `VIBE_BUILD_COMPONENT` adapter. Both now read the pair from
  // `cli_support.vibe`, and this asserts the door actually uses it rather than
  // a literal that happens to match today.
  let (_, _, entry_name, mode, _) = parse_build_args([
    "build",
    "--component",
    "cmd/check.vibe"
  ])
  assert(entry_name == command_component_entry())
  assert(mode == command_component_compile_mode())
}

test "selfhost cli build --component overrides --release with the command lane" {
  let (_, _, entry_name, mode, component) = parse_build_args([
    "build",
    "--release",
    "--component",
    "cmd/check.vibe"
  ])
  assert(entry_name == command_component_entry())
  assert(mode == command_component_compile_mode())
  assert(component)
}

test "selfhost cli build --component honours an explicit -o" {
  let (input_path, output_path, entry_name, mode, component) = parse_build_args([
    "build",
    "--component",
    "cmd/check.vibe",
    "-o",
    "dist/check.component.wasm"
  ])
  assert(input_path == "cmd/check.vibe")
  assert(output_path == "dist/check.component.wasm")
  assert(entry_name == command_component_entry())
  assert(component)
}

test "selfhost cli build --component refuses a vibex" {
  // A .vibex is an executable root with no export surface (ADR-0075 / #2229),
  // so it can never carry the `export fn vibe_command` a command component is
  // made of. The refusal names the module kind to write instead.
  let result = handle {
    let _ = parse_build_args(["build", "--component", "cmd/check.vibex"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::index_of(result, "--component needs a .vibe module") >= 0)
  assert(String::index_of(result, "export fn vibe_command(args: String) -> String") >= 0)
}

test "selfhost cli build refuses --component with --debug" {
  let result = handle {
    let _ = parse_build_args(["build", "--component", "--debug", "main.vibe"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::index_of(result, "--component and --debug cannot be combined") >= 0)
}

test "selfhost cli build rejects missing profile path" {
  let result = handle {
    let _ = parse_build_args(["build", "--profile"])
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == "build: missing path after --profile")
}

test "selfhost cli build release command writes wasm" {
  let main_path = "/tmp/vibe_selfhost_cli_build_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_build_out.wasm"
