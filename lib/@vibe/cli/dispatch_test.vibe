test "selfhost cli parses check command args" {
  let paths = parse_check_args([
    "check",
    "--profile-tsv",
    "/tmp/check.tsv",
    "a.vibe",
    "b.vibe"
  ])
  assert(Array::length(paths) == 2)
  assert(Array::get(paths, 0) == "a.vibe")
  assert(Array::get(paths, 1) == "b.vibe")
}

test "selfhost cli check consumes profile flag" {
  let paths = parse_check_args([
    "check",
    "--profile",
    "/tmp/check.pprof",
    "a.vibe"
  ])
  assert(Array::length(paths) == 1)
  assert(Array::get(paths, 0) == "a.vibe")
}

