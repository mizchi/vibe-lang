  let status = selfhost_cli_build_args([
    "build",
    main_path,
    "-o",
    output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli build rejects vibex without main" {
  let main_path = "/tmp/vibe_selfhost_cli_missing_main.vibex"
  Fs::write_bytes(main_path, string_to_bytes("fn helper() -> Unit { () }\n"))
  let result = handle {
    let _ = selfhost_cli_build_args([
      "build",
      main_path,
      "-o",
      "/tmp/vibe_selfhost_cli_missing_main.wasm"
    ])
    "OK"
  } with Error {
    Throw(e) => e
  }
  assert(String::contains(result, ".vibex executable requires exactly one fn main"))
}

test "selfhost cli build rejects multiple vibex main declarations" {
  let main_path = "/tmp/vibe_selfhost_cli_multiple_main.vibex"
