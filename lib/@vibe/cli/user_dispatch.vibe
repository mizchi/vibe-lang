fn array_contains(items: Array[String], needle: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if Array::get(items, i) == needle {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn join_dep_paths(groups: Array[(String, Array[(String, String)])], entry_path: String) -> String {
  let acc = StringBuilder::new()
  let seen = Array::slice([""], 0, 0)
  let mut first = true
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      let (path, _) = Array::get(gsources, si)
      if path == entry_path || array_contains(seen, path) {
        ()
      } else {
        Array::push(seen, path)
        if first {
          StringBuilder::push(acc, path)
          first = false
        } else {
          StringBuilder::push(acc, "\n")
          StringBuilder::push(acc, path)
        }
      }
      si = si + 1
    }
    gi = gi + 1
  }
  StringBuilder::freeze(acc)
}

fn selfhost_cli_user_deps_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let mut direct = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--direct" {
      direct = true
      ()
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("deps: unknown flag: ", arg))
    } else if src == "" {
      src = arg
      ()
    } else {
      throw("usage: vibe deps [--direct] <file.vibe>")
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe deps [--direct] <file.vibe>")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else if direct {
    let ingested = ingest_source_text_fs(src, Fs::read_file(src))
    let (deps, _, _) = load_or_parse_module_header_fs(src, ingested, 0)
    print_text(String::join(deps, "\n"))
    0
  } else {
    print_text(join_dep_paths(collect_source_groups_fs(src), src))
    0
  }
}

