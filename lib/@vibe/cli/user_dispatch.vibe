//# Helpers

fn cli_bytes(value: String) -> Bytes {
  let out = Array::slice([0], 0, 0)
  let mut i = 0
  while i < String::length(value) {
    Array::push(out, String::char_code_at(value, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn last_slash_index(path: String) -> Int {
  let len = String::length(path)
  let mut last = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last = i
    }
    i = i + 1
  }
  last
}

fn dirname_of(path: String) -> String {
  let slash = last_slash_index(path)
  if slash <= 0 {
    ""
  } else {
    path[0: slash]
  }
}

fn basename_of(path: String) -> String {
  let slash = last_slash_index(path)
  let len = String::length(path)
  if slash >= 0 {
    path[slash + 1: len]
  } else {
    path
  }
}

fn strip_vibe_suffix(path: String) -> String {
  let len = String::length(path)
  if len >= 6 && path[len - 6: len] == ".vibex" {
    path[0: len - 6]
  } else if len >= 5 && path[len - 5: len] == ".vibe" {
    path[0: len - 5]
  } else {
    path
  }
}

fn is_vibex_path(path: String) -> Bool {
  String::ends_with(path, ".vibex")
}

fn path_has_suffix(s: String, suffix: String) -> Bool {
  let n = String::length(s)
  let m = String::length(suffix)
  n >= m && String::substring(s, n - m, n) == suffix
}

fn ensure_parent_dir(path: String) -> Unit with Fs {
  let dir = dirname_of(path)
  if dir == "" {
    ()
  } else {
    Fs::mkdir_p(dir)
  }
}

fn default_build_dir() -> String with Env {
  let override_dir = Env::get("VIBE_BUILD_DIR")
  if override_dir == "" {
    ".vibe/build"
  } else {
    override_dir
  }
}

export fn display_under_root(path: String, build_dir: String) -> String {
  if build_dir != "" && String::starts_with(path, build_dir) && String::ends_with(build_dir, "/.vibe/build") {
    String::concat(".vibe/build", path[String::length(build_dir): String::length(path)])
  } else {
    path
  }
}

fn default_out_wasm(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/out/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wasm")))
}

fn default_run_wasm(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/run/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wasm")))
}

fn default_wit_path(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/out/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wit")))
}

fn parse_int_or(s: String, default: Int) -> Int {
  let len = String::length(s)
  if len == 0 {
    default
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while ok && i < len {
      let c = String::char_code_at(s, i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok && i == len {
      acc
    } else {
      default
    }
  }
}

fn need_value(args: Array[String], index: Int, command: String, flag: String) -> String with Exception {
  if index >= Array::length(args) {
    throw(String::concat(command, String::concat(": missing value after ", flag)))
  } else {
    Array::get(args, index)
  }
}

fn line_terminated(text: String) -> String {
  let n = String::length(text)
  if n == 0 {
    text
  } else if String::char_code_at(text, n - 1) == 10 {
    text
  } else {
    String::concat(text, "\n")
  }
}

fn print_text(text: String) -> Unit with Stdout {
  if text == "" {
    ()
  } else {
    print(line_terminated(text))
  }
}

fn program_parses(src: String) -> Bool {
  handle {
    let _ = parse_program(lex(src))
    true
  } with { Exception::Throw(_) => false }
}

fn parse_error_of(src: String) -> String {
  handle {
    let _ = parse_program(lex(src))
    ""
  } with { Exception::Throw(msg) => msg }
}

fn is_warning_line(line: String) -> Bool {
  if String::starts_with(line, "warning: ") {
    true
  } else if String::starts_with(line, "line ") {
    String::contains(line, " warning: ")
  } else {
    false
  }
}

fn unstable_opt_in() -> Bool with Env {
  Env::get("VIBE_UNSTABLE") == "1"
}

fn compile_user_wasm(input_path: String, entry_name: String, kind: String) -> Bytes with Exception + Fs + Env {
  if kind == "trace" {
    compile_file_fs_mode_trace(input_path, entry_name)
  } else if kind == "break" {
    compile_file_fs_mode_break(input_path, entry_name)
  } else if kind == "gc" {
    compile_file_fs_mode_gc(input_path, entry_name)
  } else {
    compile_file_fs_mode(input_path, entry_name, "mvp")
  }
}

fn write_wasm(output_path: String, bytes: Bytes) -> Unit with Fs {
  ensure_parent_dir(output_path)
  Fs::write_bytes(output_path, bytes)
}

fn write_host_action(action_path: String, body: String) -> Int with Exception + Fs {
  if action_path == "" {
    throw("this command requires a host launcher to execute the planned action")
  } else {
    Fs::write_bytes(action_path, cli_bytes(body))
    0
  }
}

fn path_is_absolute(path: String) -> Bool {
  String::length(path) > 0 && String::char_code_at(path, 0) == 47
}

fn join_path(dir: String, name: String) -> String {
  if dir == "" {
    name
  } else if String::ends_with(dir, "/") {
    String::concat(dir, name)
  } else {
    String::concat(dir, String::concat("/", name))
  }
}

fn strip_dot_slash(path: String) -> String {
  if String::starts_with(path, "./") {
    path[2: String::length(path)]
  } else {
    path
  }
}

fn invoke_rel_of(invoke_dir: String, project_root: String) -> String {
  if invoke_dir == "" || project_root == "" || invoke_dir == project_root {
    ""
  } else {
    let prefix = String::concat(project_root, "/")
    if String::starts_with(invoke_dir, prefix) {
      invoke_dir[String::length(prefix): String::length(invoke_dir)]
    } else {
      ""
    }
  }
}

export fn root_rel_from_invoke(invoke_rel: String, path: String) -> String {
  if path_is_absolute(path) {
    path
  } else if path == "." {
    if invoke_rel == "" {
      "."
    } else {
      invoke_rel
    }
  } else {
    let stripped = strip_dot_slash(path)
    if invoke_rel == "" {
      stripped
    } else {
      String::concat(invoke_rel, String::concat("/", stripped))
    }
  }
}

fn flag_takes_output_path(flag: String) -> Bool {
  flag == "-o" || flag == "--output" || flag == "--out" || flag == "--guest-profile" || flag == "--adapter" || flag == "--cli-wasm" || flag == "--changed"
}

fn flag_takes_non_path(flag: String) -> Bool {
  flag == "--break" || flag == "--fn" || flag == "--pattern" || flag == "--where" || flag == "--where-row" || flag == "--entry" || flag == "--addr" || flag == "--port" || flag == "--iters" || flag == "--warmup" || flag == "--interval-us" || flag == "--jobs" || flag == "--guest-profile-interval-us" || flag == "--mem-sample" || flag == "--alloc-site" || flag == "--toolchain"
}

fn invoke_arg_exists(invoke_dir: String, arg: String) -> Bool with Fs {
  if path_is_absolute(arg) {
    Fs::exists(arg)
  } else {
    Fs::exists(join_path(invoke_dir, strip_dot_slash(arg)))
  }
}

fn looks_like_user_path(arg: String, invoke_dir: String) -> Bool with Fs {
  if String::contains(arg, "/") || String::contains(arg, ".") {
    true
  } else {
    Fs::is_dir(join_path(invoke_dir, arg))
  }
}

export fn rewrite_user_argv(args: Array[String], invoke_dir: String, project_root: String) -> Array[String] with Fs {
  let invoke_rel = invoke_rel_of(invoke_dir, project_root)
  if invoke_rel == "" || Array::length(args) == 0 {
    args
  } else {
    let out: Array[String] = []
    Array::push(out, Array::get(args, 0))
    let mut prev = ""
    let mut passthrough = false
    let mut i = 1
    while i < Array::length(args) {
      let a = Array::get(args, i)
      if passthrough {
        Array::push(out, a)
      } else if a == "--" {
        passthrough = true
        Array::push(out, a)
        prev = ""
      } else if flag_takes_output_path(prev) {
        Array::push(out, root_rel_from_invoke(invoke_rel, a))
        prev = ""
      } else if flag_takes_non_path(prev) {
        Array::push(out, a)
        prev = ""
      } else if String::starts_with(a, "--guest-profile=") {
        Array::push(out, String::concat("--guest-profile=", root_rel_from_invoke(invoke_rel, a[16: String::length(a)])))
        prev = ""
      } else if String::length(a) > 0 && String::char_code_at(a, 0) == 45 {
        Array::push(out, a)
        prev = a
      } else if looks_like_user_path(a, invoke_dir) && invoke_arg_exists(invoke_dir, a) {
        Array::push(out, root_rel_from_invoke(invoke_rel, a))
        prev = ""
      } else {
        Array::push(out, a)
        prev = ""
      }
      i = i + 1
    }
    out
  }
}

fn path_bytes_lt(a: String, b: String) -> Bool {
  let na = String::length(a)
  let nb = String::length(b)
  let n = if na < nb {
    na
  } else {
    nb
  }
  let mut i = 0
  let mut decided = 0
  while decided == 0 && i < n {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca < cb {
      decided = 1
    } else if ca > cb {
      decided = 2
    } else {
      i = i + 1
    }
  }
  if decided == 1 {
    true
  } else if decided == 2 {
    false
  } else {
    na < nb
  }
}

fn sort_paths(items: Array[String]) -> Unit {
  let len = Array::length(items)
  let mut i = 0
  while i + 1 < len {
    let mut min_index = i
    let mut j = i + 1
    while j < len {
      if path_bytes_lt(Array::get(items, j), Array::get(items, min_index)) {
        min_index = j
      } else {
        ()
      }
      j = j + 1
    }
    if min_index != i {
      let tmp = Array::get(items, i)
      Array::set(items, i, Array::get(items, min_index))
      Array::set(items, min_index, tmp)
    } else {
      ()
    }
    i = i + 1
  }
}

fn collect_star_test_vibe(dir: String, out: Array[String]) -> Unit with Fs {
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if name == "." || name == ".." {
      ()
    } else {
      let child = join_path(dir, name)
      if Fs::is_dir(child) {
        collect_star_test_vibe(child, out)
      } else if String::ends_with(name, "_test.vibe") {
        Array::push(out, child)
      } else {
        ()
      }
    }
    i = i + 1
  }
}

export fn expand_user_test_inputs(files: Array[String]) -> Array[String] with Exception + Fs {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(files) {
    let src = Array::get(files, i)
    if Fs::is_dir(src) {
      collect_star_test_vibe(src, out)
    } else if Fs::exists(src) {
      Array::push(out, src)
    } else {
      throw(String::concat("not found: ", src))
    }
    i = i + 1
  }
  sort_paths(out)
  if Array::length(out) == 0 {
    throw("vibe test: no test files found")
  } else {
    out
  }
}

//# Verb table

export fn user_dispatch_is_verb(name: String) -> Bool {
  name == "check" || name == "compile" || name == "build" || name == "fmt" || name == "normalize" || name == "type-at" || name == "doc-at" || name == "binding-at" || name == "symbols" || name == "escapes" || name == "rc-classify" || name == "rc-plan" || name == "allocs" || name == "deps" || name == "diagnostics" || name == "grep" || name == "run" || name == "test" || name == "bench" || name == "serve" || name == "profile" || name == "lsp" || name == "hash" || name == "inspect-update" || name == "help" || name == "--help" || name == "-h"
}

//# check

export fn parse_user_check_args(args: Array[String]) -> (String, Bool, Bool) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "check" {
    throw("check: expected command")
  } else {
    let mut src = ""
    let mut single = false
    let mut json = false
    let mut missing_vpkg = false
    let mut deps_missing = false
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--single-file" {
        single = true
        ()
      } else if arg == "--json" {
        json = true
        ()
      } else if arg == "--jobs" {
        i = i + 1
        let _ = need_value(args, i, "check", arg)
        ()
      } else if arg == "--missing-vpkg" {
        missing_vpkg = true
        ()
      } else if arg == "--deps-missing" {
        deps_missing = true
        ()
      } else if arg == "--profile" || arg == "--profile-tsv" || arg == "--profile-callstack" {
        i = i + 1
        let _ = need_value(args, i, "check", arg)
        ()
      } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
        throw(String::concat("check: unsupported option: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("usage: vibe check [--jobs N] [--single-file] [--json] <file.vibe>")
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe check [--jobs N] [--single-file] [--json] <file.vibe>")
    } else if json && !single && !missing_vpkg && !deps_missing {
      throw("check --json needs --single-file today: the import-resolving lane has no per-diagnostic ranges to emit (#1567)")
    } else {
      (src, single, json)
    }
  }
}

fn user_check_scan(root: String, missing_vpkg: Bool) -> Int with Exception + Fs + Stdout {
  let rows = if missing_vpkg {
    find_missing_vpkg_dirs(root)
  } else {
    find_deps_missing(root)
  }
  if Array::length(rows) == 0 {
    if missing_vpkg {
      print(String::concat("ok: no directories missing index.vpkg under ", String::concat(root, "\n")))
    } else {
      print(String::concat("ok: no missing deps declarations under ", String::concat(root, "\n")))
    }
    0
  } else {
    print(line_terminated(String::join(rows, "\n")))
    1
  }
}

fn user_check_single(src: String, json: Bool) -> Int with Exception + Fs + Env + Stdout {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let text = Fs::read_file(src)
    let diags = handle {
      collect_all_diagnostics_with_unstable_for_path(src, text, unstable_opt_in())
    } with { Exception::Throw(_) => {
      let empty: Array[String] = []
      empty
    } }
    if json {
      print(line_terminated(lsp_diagnostics_json_of_messages(text, diags)))
      let mut has_error = false
      let mut i = 0
      while i < Array::length(diags) {
        if !is_warning_line(Array::get(diags, i)) {
          has_error = true
        }
        i = i + 1
      }
      if has_error {
        1
      } else {
        0
      }
    } else {
      let errors: Array[String] = []
      let mut i = 0
      while i < Array::length(diags) {
        let line = Array::get(diags, i)
        if is_warning_line(line) {
          ()
        } else {
          Array::push(errors, line)
        }
        i = i + 1
      }
      if Array::length(errors) == 0 {
        0
      } else {
        throw(String::join(errors, "\n"))
      }
    }
  }
}

fn user_check_linked(src: String) -> Int with Exception + Fs + Env {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    check_file_fs_mode(src)
  }
}

fn selfhost_cli_user_check_args(args: Array[String]) -> Int with Exception + Fs + Env + Stdout {
  let mut missing_vpkg = false
  let mut deps_missing = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--missing-vpkg" {
      missing_vpkg = true
    } else if arg == "--deps-missing" {
      deps_missing = true
    } else {
      ()
    }
    i = i + 1
  }
  if missing_vpkg || deps_missing {
    let (root, _, _) = parse_user_check_args(args)
    user_check_scan(root, missing_vpkg)
  } else {
    let (src, single, json) = parse_user_check_args(args)
    if single {
      user_check_single(src, json)
    } else {
      user_check_linked(src)
    }
  }
}

//# compile / build

export fn parse_user_compile_args(args: Array[String]) -> (String, String, String, Bool, Bool) with Exception {
  if Array::length(args) == 0 {
    throw("compile: expected command")
  } else {
    let cmd = Array::get(args, 0)
    if cmd != "compile" && cmd != "build" {
      throw("compile: expected command")
    } else {
      let mut src = ""
      let mut out = ""
      let mut entry = "main"
      let mut entry_override = false
      let mut wit = false
      let mut minify = false
      let mut i = 1
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if arg == "-o" || arg == "--output" || arg == "--out" {
          i = i + 1
          out = need_value(args, i, cmd, arg)
          ()
        } else if arg == "--entry" {
          i = i + 1
          entry = need_value(args, i, cmd, arg)
          entry_override = true
          ()
        } else if arg == "--wit" {
          wit = true
          ()
        } else if arg == "--minify" {
          minify = true
          ()
        } else if arg == "--jobs" {
          i = i + 1
          let _ = need_value(args, i, cmd, arg)
          ()
        } else if arg == "--wasm" || arg == "--wasm-linear" || arg == "--release" {
          ()
        } else if arg == "--debug" {
          ()
        } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
          throw(String::concat(cmd, String::concat(": unsupported option: ", arg)))
        } else if src == "" {
          src = arg
          ()
        } else {
          throw(String::concat(cmd, ": too many input files"))
        }
        i = i + 1
      }
      if src == "" {
        throw(String::concat("usage: vibe ", String::concat(cmd, " <file.vibe|file.vibex> [-o <out.wasm>] [--entry <name>] [--wit] [--minify] [--jobs N]")))
      } else if is_vibex_path(src) && entry_override {
        throw(".vibex entry is always main; --entry is not allowed")
      } else if wit && is_vibex_path(src) {
        throw("--wit for .vibex requires semantic contract emission")
      } else {
        let resolved_entry = if is_vibex_path(src) {
          "main"
        } else {
          entry
        }
        let resolved_out = if out == "" {
          if wit {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wit"))
          } else {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wasm"))
          }
        } else {
          out
        }
        (src, resolved_out, resolved_entry, wit, minify)
      }
    }
  }
}

fn selfhost_cli_user_compile_args(args: Array[String]) -> Int with Exception + Fs + Env + Stdout {
  let (src, out, entry, wit, minify) = parse_user_compile_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else if wit {
    let resolved = out
    let stmts = parse_program(lex(Fs::read_file(src)))
    ensure_parent_dir(resolved)
    Fs::write_file(resolved, wit_from_program(stmts, stmts, basename_of(strip_vibe_suffix(src))))
    println(String::concat("wit ", String::concat(src, String::concat(" -> ", resolved))))
    0
  } else {
    let resolved = if String::starts_with(out, ".vibe/build/") {
      String::concat(default_build_dir(), out[11: String::length(out)])
    } else {
      out
    }
    let bytes = compile_user_wasm(src, entry, "mvp")
    write_wasm(resolved, bytes)
    println(String::concat("compiled ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    if minify {
      let action = Env::get("VIBE_HOST_ACTION_OUT")
      write_host_action(action, String::concat("vibe-host-action-v1\nminify\n", String::concat(resolved, "\n")))
    } else {
      0
    }
  }
}

//# fmt / normalize

export fn parse_user_fmt_args(args: Array[String]) -> (String, String) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "fmt" {
    throw("vibe fmt: expected command")
  } else {
    let mut mode = "write"
    let mut src = ""
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--check" {
        mode = "check"
        ()
      } else if arg == "--stdout" {
        mode = "stdout"
        ()
      } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
        throw(String::concat("vibe fmt: unknown flag: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("vibe fmt: takes ONE file")
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe fmt [--check|--stdout] <file.vibe>")
    } else {
      (src, mode)
    }
  }
}

fn selfhost_cli_user_fmt_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let (src, mode) = parse_user_fmt_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let raw = Fs::read_file(src)
    let pre = fill_require_pins_lenient(raw)
    let formatted = format_source(src, pre)
    let is_vpkg = path_has_suffix(src, ".vpkg")
    let head_end = if is_vpkg {
      0
    } else {
      let e = source_header_end(pre)
      if e > 0 {
        e
      } else {
        0
      }
    }
    let body = String::substring(pre, head_end, String::length(pre))
    let formatted_body = String::substring(formatted, head_end, String::length(formatted))
    if !is_vpkg {
      let err = parse_error_of(body)
      if String::length(err) > 0 {
        throw(String::concat("vibe fmt: refusing to format ", String::concat(src, String::concat(": it does not parse\n  ", err))))
      } else if !program_parses(formatted_body) {
        throw(String::concat("vibe fmt: refusing to rewrite ", src))
      } else {
        ()
      }
    } else {
      ()
    }
    if mode == "stdout" {
      print(formatted)
      0
    } else if mode == "check" {
      if raw == formatted {
        0
      } else {
        println(String::concat("not formatted: ", src))
        1
      }
    } else {
      if raw != formatted {
        Fs::write_file(src, formatted)
      } else {
        ()
      }
      0
    }
  }
}

fn parse_user_normalize_args(args: Array[String]) -> (String, String) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "normalize" {
    throw("vibe normalize: expected command")
  } else {
    let mut mode = "write"
    let mut src = ""
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--check" {
        mode = "check"
        ()
      } else if arg == "--stdout" {
        mode = "stdout"
        ()
      } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
        throw(String::concat("vibe normalize: unknown flag: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("vibe normalize: takes ONE file")
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe normalize [--check|--stdout] <file.vibe>")
    } else {
      (src, mode)
    }
  }
}

fn selfhost_cli_user_normalize_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let (src, mode) = parse_user_normalize_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let raw = Fs::read_file(src)
    let normalized = normalize_source(raw)
    if mode == "stdout" {
      print(normalized)
      0
    } else if mode == "check" {
      if raw == normalized {
        0
      } else {
        println(String::concat("not normalized: ", src))
        1
      }
    } else {
      if raw != normalized {
        Fs::write_file(src, normalized)
      } else {
        ()
      }
      0
    }
  }
}

