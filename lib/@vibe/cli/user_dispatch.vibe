export fn parse_user_type_at_args(args: Array[String]) -> (String, Int, Int) with Exception {
  if Array::length(args) < 4 {
    throw(String::concat("usage: vibe ", String::concat(Array::get(args, 0), " <file.vibe> <line> <col>")))
  } else {
    let src = Array::get(args, 1)
    let line = parse_int_or(Array::get(args, 2), 0)
    let col = parse_int_or(Array::get(args, 3), 0)
    if line < 1 || col < 1 {
      throw(String::concat("usage: vibe ", String::concat(Array::get(args, 0), " <file.vibe> <line> <col>")))
    } else {
      (src, line, col)
    }
  }
}

