fn selfhost_cli_user_grep_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let mut pattern = ""
  let mut json = false
  let mut only = ""
  let wheres: Array[String] = []
  let where_rows: Array[String] = []
  let paths: Array[String] = []
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--help" || arg == "-h" {
      println("usage: vibe grep --pattern '<pat>' [paths]")
      return 0
    } else if arg == "--pattern" {
      i = i + 1
      pattern = need_value(args, i, "grep", arg)
      ()
    } else if arg == "--json" || arg == "--output-json" {
      json = true
      ()
    } else if arg == "--where" {
      i = i + 1
      Array::push(wheres, need_value(args, i, "grep", arg))
      ()
    } else if arg == "--where-row" {
      i = i + 1
      Array::push(where_rows, need_value(args, i, "grep", arg))
      ()
    } else if arg == "--only-ill-typed" {
      only = "ill"
      ()
    } else if arg == "--only-well-typed" {
      only = "well"
      ()
    } else if arg == "--" {
      i = i + 1
      while i < Array::length(args) {
        Array::push(paths, Array::get(args, i))
        i = i + 1
      }
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("vibe grep: unknown flag: ", arg))
    } else {
      Array::push(paths, arg)
    }
    i = i + 1
  }
  if pattern == "" {
    throw("vibe grep: --pattern needs an argument")
  } else {
    if Array::length(paths) == 0 {
      Array::push(paths, ".")
    } else {
      ()
    }
    let acc = StringBuilder::new()
    let mut first = true
    let mut pi = 0
    while pi < Array::length(paths) {
      let (text, warnings) = grep_scan_fs_report(Array::get(paths, pi), pattern, wheres, where_rows, only, json)
      let _ = warnings
      if text != "" {
        if first {
          StringBuilder::push(acc, text)
          first = false
        } else {
          StringBuilder::push(acc, "\n")
          StringBuilder::push(acc, text)
        }
      } else {
        ()
      }
      pi = pi + 1
    }
    print_text(StringBuilder::freeze(acc))
    0
  }
}

//# run / test / bench / serve / profile

fn parse_run_flags(args: Array[String]) -> (String, String, Bool, String, Bool, String, Bool, String, String, String, Array[String]) with Exception {
  let mut src = ""
  let mut trace = false
  let mut brk = false
  let mut break_spec = ""
  let mut mem = false
  let mut mem_sample = ""
  let mut allocsite = false
  let mut allocsite_top = ""
  let mut guest_profile = ""
  let mut guest_interval = "1000"
  let guest_args: Array[String] = []
  let mut after_separator = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if after_separator {
      Array::push(guest_args, arg)
      i = i + 1
    } else if arg == "--" {
      after_separator = true
      i = i + 1
    } else if arg == "--trace" {
      trace = true
      i = i + 1
    } else if arg == "--break" {
      i = i + 1
      brk = true
      break_spec = need_value(args, i, "run", arg)
      i = i + 1
    } else if String::starts_with(arg, "--break=") {
      brk = true
      break_spec = arg[8: String::length(arg)]
      i = i + 1
    } else if arg == "--mem" {
      mem = true
      i = i + 1
    } else if arg == "--mem-sample" {
      mem_sample = "1"
      i = i + 1
    } else if String::starts_with(arg, "--mem-sample=") {
      mem_sample = arg[13: String::length(arg)]
      i = i + 1
    } else if arg == "--alloc-site" {
      allocsite = true
      i = i + 1
    } else if String::starts_with(arg, "--alloc-site=") {
      allocsite = true
      allocsite_top = arg[13: String::length(arg)]
      i = i + 1
    } else if String::starts_with(arg, "--guest-profile=") {
      guest_profile = arg[16: String::length(arg)]
      i = i + 1
    } else if String::starts_with(arg, "--guest-profile-interval-us=") {
      guest_interval = arg[28: String::length(arg)]
      i = i + 1
    } else if String::starts_with(arg, "-") {
      throw(String::concat("run: unknown option ", arg))
    } else if src == "" {
      src = arg
      i = i + 1
    } else {
      throw(".vibex entry is always main; arbitrary entry names are not allowed")
    }
  }
  if src == "" {
    throw("usage: vibe run [--trace] [--break <fn>[,<fn>...]] [--mem] [--alloc-site[=N]] <file.vibex> [-- args]")
  } else if !is_vibex_path(src) {
    throw(String::concat("vibe run requires a .vibex executable root: ", src))
  } else if brk && break_spec == "" {
    throw("usage: vibe run --break <fn>[,<fn>...] <file.vibex>")
  } else {
    (src, "", trace, break_spec, mem, mem_sample, allocsite, allocsite_top, guest_profile, guest_interval, guest_args)
  }
}

export fn selfhost_cli_run_plan_args(args: Array[String], action_path: String) -> Int with Exception + Fs + Env {
  let (src, _, trace, break_spec, mem, mem_sample, allocsite, allocsite_top, guest_profile, guest_interval, guest_args) = parse_run_flags(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let out = default_run_wasm(src)
    let kind = if trace {
      "trace"
    } else if break_spec != "" || allocsite {
      "break"
    } else {
      "mvp"
    }
    let bytes = compile_user_wasm(src, "main", kind)
    write_wasm(out, bytes)
    let acc = StringBuilder::new()
    StringBuilder::push(acc, "vibe-host-action-v1\nrun-guest\n")
    StringBuilder::push(acc, out)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, src)
    StringBuilder::push(acc, "\n")
    if trace {
      StringBuilder::push(acc, "1\n")
    } else {
      StringBuilder::push(acc, "0\n")
    }
    StringBuilder::push(acc, break_spec)
    StringBuilder::push(acc, "\n")
    if mem {
      StringBuilder::push(acc, "1\n")
    } else {
      StringBuilder::push(acc, "0\n")
    }
    StringBuilder::push(acc, mem_sample)
    StringBuilder::push(acc, "\n")
    if allocsite {
      StringBuilder::push(acc, "1\n")
    } else {
      StringBuilder::push(acc, "0\n")
    }
    StringBuilder::push(acc, allocsite_top)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, guest_profile)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, guest_interval)
    StringBuilder::push(acc, "\n")
    let mut gi = 0
    while gi < Array::length(guest_args) {
      StringBuilder::push(acc, Array::get(guest_args, gi))
      StringBuilder::push(acc, "\n")
      gi = gi + 1
    }
    write_host_action(action_path, StringBuilder::freeze(acc))
  }
}

fn selfhost_cli_user_run_args(args: Array[String]) -> Int with Exception + Fs + Env {
  selfhost_cli_run_plan_args(args, Env::get("VIBE_HOST_ACTION_OUT"))
}

export fn selfhost_cli_test_plan_args(args: Array[String], action_path: String) -> Int with Exception + Fs + Env {
  let mut update = false
  let mut no_cache = false
  let files: Array[String] = []
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--update" {
      update = true
      no_cache = true
      ()
    } else if arg == "--no-cache" {
      no_cache = true
      ()
    } else if arg == "--jobs" {
      i = i + 1
      let _ = need_value(args, i, "test", arg)
      ()
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("test: unknown flag: ", arg))
    } else {
      Array::push(files, arg)
    }
    i = i + 1
  }
  if Array::length(files) == 0 {
    throw("usage: vibe test [--no-cache] [--update] [--jobs N] <file_test.vibe | dir> [more...]")
  } else {
    let expanded = expand_user_test_inputs(files)
    let acc = StringBuilder::new()
    StringBuilder::push(acc, "vibe-host-action-v1\nrun-tests\n")
    if update {
      StringBuilder::push(acc, "1\n")
    } else {
      StringBuilder::push(acc, "0\n")
    }
    if no_cache {
      StringBuilder::push(acc, "1\n")
    } else {
      StringBuilder::push(acc, "0\n")
    }
    let mut fi = 0
    while fi < Array::length(expanded) {
      let src = Array::get(expanded, fi)
      let out = String::concat(default_build_dir(), String::concat("/test/", String::concat(strip_vibe_suffix(src), ".wasm")))
      let meta = String::concat(out, ".testmeta")
      ensure_parent_dir(out)
      let bytes = compile_file_fs_mode_testmeta(src, "__no_entry__", "mvp", meta)
      write_wasm(out, bytes)
      StringBuilder::push(acc, src)
      StringBuilder::push(acc, "\t")
      StringBuilder::push(acc, out)
      StringBuilder::push(acc, "\n")
      fi = fi + 1
    }
    write_host_action(action_path, StringBuilder::freeze(acc))
  }
}

fn selfhost_cli_user_test_args(args: Array[String]) -> Int with Exception + Fs + Env {
  selfhost_cli_test_plan_args(args, Env::get("VIBE_HOST_ACTION_OUT"))
}

fn selfhost_cli_user_bench_args(args: Array[String]) -> Int with Exception + Fs + Env {
  let mut src = ""
  let mut iters = "0"
  let mut warmup = "0"
  let mut guest_profile_dir = ""
  let mut guest_profile_requested = false
  let mut guest_interval = "1000"
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--iters" {
      i = i + 1
      iters = need_value(args, i, "bench", arg)
      ()
    } else if arg == "--warmup" {
      i = i + 1
      warmup = need_value(args, i, "bench", arg)
      ()
    } else if arg == "--guest-profile" {
      guest_profile_requested = true
      i = i + 1
      guest_profile_dir = need_value(args, i, "bench", arg)
      ()
    } else if String::starts_with(arg, "--guest-profile=") {
      guest_profile_requested = true
      guest_profile_dir = arg[16: String::length(arg)]
      ()
    } else if arg == "--interval-us" {
      i = i + 1
      guest_interval = need_value(args, i, "bench", arg)
      ()
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("bench: unknown flag: ", arg))
    } else {
      src = arg
    }
    i = i + 1
  }
  if guest_profile_requested && guest_profile_dir == "" {
    throw("bench: --guest-profile must not be empty")
  } else if src == "" {
    throw("usage: vibe bench <file.vibe> [--iters N] [--warmup N]")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let bench_keep_names = if guest_profile_requested {
      "1"
    } else {
      ""
    }
    let out = String::concat(default_build_dir(), String::concat("/bench/", String::concat(basename_of(strip_vibe_suffix(src)), ".wasm")))
    let bytes = compile_user_wasm(src, "__no_entry__", "mvp")
    write_wasm(out, bytes)
    let acc = StringBuilder::new()
    StringBuilder::push(acc, "vibe-host-action-v1\nrun-benches\n")
    StringBuilder::push(acc, src)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, out)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, iters)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, warmup)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, guest_profile_dir)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, guest_interval)
    StringBuilder::push(acc, "\n")
    StringBuilder::push(acc, bench_keep_names)
    StringBuilder::push(acc, "\n")
    write_host_action(Env::get("VIBE_HOST_ACTION_OUT"), StringBuilder::freeze(acc))
  }
}

fn selfhost_cli_user_serve_args(args: Array[String]) -> Int with Exception + Fs + Env + Stdout {
  let mut src = ""
  let mut out = ""
  let mut addr = "127.0.0.1:8080"
  let mut adapter = ""
  let mut no_run = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--addr" {
      i = i + 1
      addr = need_value(args, i, "serve", arg)
      ()
    } else if arg == "--port" {
      i = i + 1
      addr = String::concat("127.0.0.1:", need_value(args, i, "serve", arg))
      ()
    } else if arg == "-o" || arg == "--output" {
      i = i + 1
      out = need_value(args, i, "serve", arg)
      ()
    } else if arg == "--adapter" {
      i = i + 1
      adapter = need_value(args, i, "serve", arg)
      ()
    } else if arg == "--no-run" {
      no_run = true
      ()
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("serve: unknown flag: ", arg))
    } else {
      src = arg
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe serve <handler.vibe> [--addr host:port] [--port N] [-o out.component.wasm] [--adapter adapter.component.wasm] [--no-run]")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let resolved = if out == "" {
      String::concat(default_build_dir(), String::concat("/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".component.wasm")))
    } else {
      out
    }
    let entry_stmts = parse_program(lex(Fs::read_file(src)))
    validate_serve_handler(entry_stmts)
    let core = compile_user_wasm(src, "__no_entry__", "mvp")
    let component = if serve_handler_takes_body_stream(entry_stmts) {
      comp_emit_component_wasm_stream_handler(core, "handler", "handler", serve_handler_param_names())
    } else {
      comp_emit_component_wasm_string_handler(core, "handler", "handler", serve_handler_param_names())
    }
    write_wasm(resolved, component)
    let wit_path = String::concat(String::substring(resolved, 0, String::length(resolved) - 15), ".wit")
    if path_has_suffix(resolved, ".component.wasm") {
      Fs::write_file(String::concat(resolved[0: String::length(resolved) - 15], ".wit"), wit_from_program(entry_stmts, entry_stmts, basename_of(strip_vibe_suffix(src))))
    } else {
      Fs::write_file(wit_path, wit_from_program(entry_stmts, entry_stmts, basename_of(strip_vibe_suffix(src))))
    }
    println(String::concat("component ", String::concat(src, String::concat(" -> ", resolved))))
    if no_run {
      0
    } else {
      let acc = StringBuilder::new()
      StringBuilder::push(acc, "vibe-host-action-v1\nwasmtime-serve\n")
      StringBuilder::push(acc, resolved)
      StringBuilder::push(acc, "\n")
      StringBuilder::push(acc, addr)
      StringBuilder::push(acc, "\n")
      StringBuilder::push(acc, adapter)
      StringBuilder::push(acc, "\n")
      write_host_action(Env::get("VIBE_HOST_ACTION_OUT"), StringBuilder::freeze(acc))
    }
  }
}

fn selfhost_cli_user_profile_args(args: Array[String]) -> Int with Exception + Fs + Env {
  let mut source = ""
  let mut output = "profile.json"
  let mut interval = "1000"
  let guest_args = Array::slice([""], 0, 0)
  let mut after_separator = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if after_separator {
      Array::push(guest_args, arg)
      i = i + 1
    } else if arg == "--" {
      after_separator = true
      i = i + 1
    } else if arg == "--out" || arg == "--interval-us" {
      let value = need_value(args, i + 1, "profile", arg)
      if arg == "--out" {
        output = value
      } else {
        interval = value
      }
      i = i + 2
    } else if String::starts_with(arg, "--out=") {
      output = arg[6: String::length(arg)]
      i = i + 1
    } else if String::starts_with(arg, "--interval-us=") {
      interval = arg[14: String::length(arg)]
      i = i + 1
    } else if String::starts_with(arg, "-") {
      throw(String::concat("profile: unknown option ", arg))
    } else if source == "" {
      source = arg
      i = i + 1
    } else {
      throw(String::concat("profile: unexpected argument ", arg))
    }
  }
  if source == "" {
    throw("usage: vibe profile <file.vibex> [--out FILE] [--interval-us N]")
  } else if output == "" {
    throw("profile: --out must not be empty")
  } else if source == output {
    throw("profile: --out must not alias the source")
  } else {
    let mut plan = String::concat("vibe-host-action-v1\nrun-guest-profile\n", String::concat(source, "\n"))
    plan = String::concat(plan, String::concat(output, "\n"))
    plan = String::concat(plan, String::concat(interval, "\n"))
    let mut gi = 0
    while gi < Array::length(guest_args) {
      plan = String::concat(plan, String::concat(Array::get(guest_args, gi), "\n"))
      gi = gi + 1
    }
    write_host_action(Env::get("VIBE_HOST_ACTION_OUT"), plan)
  }
}

fn selfhost_cli_user_lsp_args(_args: Array[String]) -> Int with Stdin + Stdout {
  lsp_main(false)
}

fn selfhost_cli_user_hash_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let mut write = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--write" {
      write = true
      ()
    } else {
      src = arg
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe hash [--write] <index.vpkg>")
  } else if write {
    let rewritten = write_generated_hash_fs(src)
    Fs::write_file(src, rewritten)
    0
  } else {
    throw("usage: vibe hash --write <index.vpkg>")
  }
}

fn user_help_text() -> String {
  "vibe — selfhost toolchain launcher\n\nSubcommands:\n  vibe run     <file.vibex> [-- args]   compile fixed main, then run\n  vibe compile <file.vibe> [-o <out>]   compile to a .wasm\n  vibe build   <file.vibe> [-o <out>]   alias of compile\n  vibe check   [--single-file] [--json] <file.vibe>\n  vibe fmt     [--check|--stdout] <file.vibe|file.vpkg>\n  vibe test    <file_test.vibe|dir>...\n  vibe bench   <file.vibe>\n  vibe help                             this message\n"
}

fn selfhost_cli_user_help_args(_args: Array[String]) -> Int with Stdout {
  print(user_help_text())
  0
}

fn selfhost_cli_user_inspect_update_args(args: Array[String]) -> Int with Exception + Fs {
  if Array::length(args) < 3 {
    throw("usage: vibe inspect-update <file.vibe> <captured-stdout>")
  } else {
    let src = Array::get(args, 1)
    let captured = Fs::read_file(Array::get(args, 2))
    let original = Fs::read_file(src)
    let patched = match compute_updated_source(original, captured) {
      Some(new_src) => new_src,
      None => original
    }
    Fs::write_file(src, patched)
    0
  }
}

//# Dispatch

export fn selfhost_cli_user_dispatch_args(args: Array[String]) -> Int with Exception + Fs + Env + Stdin + Stdout {
  let argv = rewrite_user_argv(args, Env::get("VIBE_INVOKE_DIR"), Fs::getcwd())
  let first = if Array::length(argv) == 0 {
    "help"
  } else {
    Array::get(argv, 0)
  }
  match first {
    "check" => selfhost_cli_user_check_args(argv),
    "compile" => selfhost_cli_user_compile_args(argv),
    "build" => selfhost_cli_user_compile_args(argv),
    "fmt" => selfhost_cli_user_fmt_args(argv),
    "normalize" => selfhost_cli_user_normalize_args(argv),
    "type-at" => selfhost_cli_user_type_at_args(argv),
    "doc-at" => selfhost_cli_user_doc_at_args(argv),
    "binding-at" => selfhost_cli_user_binding_at_args(argv),
    "symbols" => selfhost_cli_user_symbols_args(argv),
    "escapes" => selfhost_cli_user_escapes_args(argv),
    "rc-classify" => selfhost_cli_user_rc_classify_args(argv),
    "rc-plan" => selfhost_cli_user_rc_plan_args(argv),
    "allocs" => selfhost_cli_user_allocs_args(argv),
    "deps" => selfhost_cli_user_deps_args(argv),
    "diagnostics" => selfhost_cli_user_diagnostics_args(argv),
    "grep" => selfhost_cli_user_grep_args(argv),
    "run" => selfhost_cli_user_run_args(argv),
    "test" => selfhost_cli_user_test_args(argv),
    "bench" => selfhost_cli_user_bench_args(argv),
    "serve" => selfhost_cli_user_serve_args(argv),
    "profile" => selfhost_cli_user_profile_args(argv),
    "lsp" => selfhost_cli_user_lsp_args(argv),
    "hash" => selfhost_cli_user_hash_args(argv),
    "inspect-update" => selfhost_cli_user_inspect_update_args(argv),
    "help" => selfhost_cli_user_help_args(argv),
    "--help" => selfhost_cli_user_help_args(argv),
    "-h" => selfhost_cli_user_help_args(argv),
    _ => throw(String::concat("unknown command: ", String::concat(first, " (try 'vibe help')")))
  }
}
