fn join_binding(occ: Array[(Int, Int)]) -> String {
  let n = Array::length(occ)
  if n == 0 {
    ""
  } else {
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      let (s, e) = Array::get(occ, i)
      if i > 0 {
        StringBuilder::push(acc, "\n")
      } else {
        ()
      }
      StringBuilder::push(acc, __to_string(s))
      StringBuilder::push(acc, " ")
      StringBuilder::push(acc, __to_string(e))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn selfhost_cli_user_binding_at_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  let (src, line, col) = parse_user_type_at_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    print_text(join_binding(binding_occurrences(Fs::read_file(src), line, col)))
    0
  }
}

fn escape_doc_field(text: String) -> String {
  let n = String::length(text)
  let acc = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::char_code_at(text, i)
    if c == 92 {
      StringBuilder::push(acc, "\\\\")
    } else if c == 10 {
      StringBuilder::push(acc, "\\n")
    } else if c == 13 {
      ()
    } else {
      StringBuilder::push(acc, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn name_field_needs_escape(text: String) -> Bool {
  let n = String::length(text)
  let mut i = 0
  let mut found = false
  while i < n && !found {
    let c = String::char_code_at(text, i)
    if c == 92 || c == 32 || (c >= 9 && c <= 13) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn name_field_escape_of(c: Int) -> String {
  if c == 92 {
    "\\\\"
  } else if c == 32 {
    "\\s"
  } else if c == 9 {
    "\\t"
  } else if c == 10 {
    "\\n"
  } else if c == 11 {
    "\\v"
  } else if c == 12 {
    "\\f"
  } else if c == 13 {
    "\\r"
  } else {
    String::from_char_code(c)
  }
}

fn escape_name_field(text: String) -> String {
  if !name_field_needs_escape(text) {
    text
  } else {
    let n = String::length(text)
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      StringBuilder::push(acc, name_field_escape_of(String::char_code_at(text, i)))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn join_symbol_spans(syms: Array[(String, Int, Int, Int, String)]) -> String {
  let n = Array::length(syms)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, kind, s, e, doc) = Array::get(syms, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn join_symbol_spans_with_path(rows: Array[(String, String, Int, Int, Int, String)]) -> String {
  let n = Array::length(rows)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (path, name, kind, s, e, doc) = Array::get(rows, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(path, String::concat(" ", String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn symbols_legend() -> String {
  "2 Module\n6 Method\n10 Enum\n11 Interface\n12 Function\n13 Variable\n23 Struct\n24 Event\n26 TypeParameter\n27 Test\n28 Bench"
}

fn selfhost_cli_user_symbols_args(args: Array[String]) -> Int with Exception + Fs + Stdout {
  if Array::length(args) >= 2 && Array::get(args, 1) == "--legend" {
    println(symbols_legend())
    0
  } else if Array::length(args) >= 2 && (Array::get(args, 1) == "--help" || Array::get(args, 1) == "-h") {
    println("usage: vibe symbols [--with-path] <path>...\n       vibe symbols --legend")
    0
  } else {
    let mut with_path = false
    let paths: Array[String] = []
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--with-path" {
        with_path = true
        ()
      } else if arg == "--" {
        i = i + 1
        while i < Array::length(args) {
          Array::push(paths, Array::get(args, i))
          i = i + 1
        }
      } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
        throw(String::concat("symbols: unknown flag: ", arg))
      } else {
        Array::push(paths, arg)
      }
      i = i + 1
    }
    if Array::length(paths) == 0 {
      throw("usage: vibe symbols [--with-path] <path>...")
    } else {
      let many = with_path || Array::length(paths) > 1
      if many {
        let acc = StringBuilder::new()
        let fails: Array[String] = []
        let mut first = true
        let mut pi = 0
        while pi < Array::length(paths) {
          let (rows, failures) = symbol_spans_fs_report(Array::get(paths, pi))
          let chunk = join_symbol_spans_with_path(rows)
          if chunk != "" {
            if first {
              StringBuilder::push(acc, chunk)
              first = false
            } else {
              StringBuilder::push(acc, "\n")
              StringBuilder::push(acc, chunk)
            }
          } else {
            ()
          }
          let mut fi = 0
          while fi < Array::length(failures) {
            Array::push(fails, Array::get(failures, fi))
            fi = fi + 1
          }
          pi = pi + 1
        }
        print_text(StringBuilder::freeze(acc))
        if Array::length(fails) > 0 {
          throw(String::join(fails, "\n"))
        } else {
          0
        }
      } else {
        let src = Array::get(paths, 0)
        if !Fs::exists(src) {
          throw(String::concat("not found: ", src))
        } else {
          print_text(join_symbol_spans(symbol_spans_with_docs(Fs::read_file(src))))
          0
        }
      }
    }
  }
}

