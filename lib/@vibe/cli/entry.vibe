//# Imports

import ./dispatch.vibe {
  collect_cli_args, selfhost_cli_dispatch_args
}

// `format_check_report` moved next to the verb dispatcher (#2858) so this
// door and cli_adapter.vibe's verb branch frame a diagnostic identically.
import ../compiler {
  format_check_report
}

//# Effects

effect Profiler {
  NowUs -> Int
}

//# Functions

/// Run the CLI for an explicit argv array, discharging the compile pipeline's
/// Profiler and Error effects into a process exit code.
///
/// Profiler must be the *inner* handler so `perform NowUs` is caught directly
/// without unwinding through the Error handler: a resume that crosses an
/// unrelated effect handler is miscompiled (the continuation returns garbage
/// and the outer handler's result is corrupted, so `compile-lite --profile-tsv`
/// wrongly exits non-zero; see #543). `throw` from the compile pipeline still
/// unwinds correctly through the inner Profiler handler to the outer Error
/// handler thanks to the dedicated exception tag (#544).
///
/// cli_main and the dispatch_test.vibe regression tests both go through this
/// single wrapper, so the tests observe the real handler order — flipping it
/// here fails them.
/// #2107: `Stdout` is in the row because the dispatcher prints; `Stderr`
/// because the Exception arm below reports there (#2858) -- a verb's
/// machine-readable stdout (symbols rows, grep matches) must not carry the
/// failure that ended it, and `runtime/vibe` printed the adapter's `.diag`
/// sidecar to stderr before the verbs moved.
export fn run_cli_main_with_args(args: Array[String]) -> Int with Fs + Env + Stdin + Console + Stderr {
  handle {
    handle {
      selfhost_cli_dispatch_args(args)
    } with { Profiler::NowUs => resume(0) }
  } with {
    // #1888: print the thrown diagnostic then exit 1. Frame it the same way
    // `runtime/vibe` emit_check_diagnostics does (`error: ` on each start,
    // `hint:` indented) so `grep -c '^error: '` stays an exact count.
    Exception::Throw(e) => {
      Stderr::write_stream(String::concat(format_check_report(e), "\n"))
      1
    }
  }
}

export fn cli_main() -> Int with Fs + Env + Stdin + Console + Stderr {
  run_cli_main_with_args(collect_cli_args())
}
