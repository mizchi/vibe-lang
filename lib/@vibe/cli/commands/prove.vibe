//# Imports

import @vibe/prove {
  Obligation::report_line, prove_line_col, prove_obligations
}

import @vibe/compiler/core {
  external_lib_roots
}

import @vibe/lsp {
  lsp_diagnostics_json_of_messages_for
}

import ./plans.vibe {
  line_terminated, selfhost_cli_run_plan_args
}

//# Functions

/// #3717 (ADR-0121): `vibe check --prove <file>...`. Each obligation of each
/// contracted function becomes one SMT-LIB query. The report follows `vibe
/// check`'s contract: one line per obligation that is not proved, empty
/// output when every one is, exit 1 otherwise. Only `unsat` proves;
/// `unknown`, an exhausted bound and a construct outside the provable
/// fragment are failures, never skipped.
///
/// `solver` picks who answers (#3719):
///   - `z3`: an external `z3` on PATH, with a 5 s limit, fed on standard input
///     so no query file is shared with another run;
///   - `wasm`: z3_wasi.wasm in the same process as the prover (@vibex/z3_wasi,
///     built by scripts/build_z3_wasi.sh), bounded by `rlimit` because that
///     module has no clock. This writes a run plan for its entry, which the
///     launcher runs;
///   - `auto` (the default): `z3` when it is on PATH, else `wasm` when
///     @vibex/z3_wasi is installed, else an error naming both.
/// Both lanes report through `Obligation::report_line`, so they print the same
/// lines; an `unknown` line names the bound the solver ran under.
///
/// With `json`, each file's report is the LSP Diagnostic array `vibe check
/// --json` prints, one array per file and `[]` when every obligation is
/// proved, built from the same lines through the same writer.
export fn selfhost_cli_user_check_prove(paths: Array[String], json: Bool, solver: String, checked_error_row: Bool) -> Int with Exception + Fs + Env + Process + Console {
  if solver != "auto" && solver != "z3" && solver != "wasm" {
    throw("check --prove: `--solver=\{solver}` is not a solver; use `--solver=z3` (an external z3 on PATH), `--solver=wasm` (z3_wasi.wasm in-process) or `--solver=auto`")
  } else {
    ()
  }
  let external = solver != "wasm" && z3_available()
  if solver == "z3" && !external {
    throw("check --prove: `z3` is not on PATH; install it (for example `nix shell nixpkgs#z3`, `apt install z3` or `brew install z3`) and run again, or run the solver in-process with `--solver=wasm`")
  } else {
    ()
  }
  if external {
    prove_with_external_z3(paths = paths, json = json)
  } else {
    prove_in_process(paths = paths, json = json, asked = solver == "wasm", checked_error_row = checked_error_row)
  }
}

fn prove_with_external_z3(paths: Array[String], json: Bool) -> Int with Exception + Fs + Process + Console {
  let mut code = 0
  for path in paths {
    let source = Fs::read_file(path)
    let lines: Array[(Int, String)] = []
    for o in prove_obligations(source) {
      let answer = if o.kind == "unsupported" {
        ""
      } else {
        run_z3(o.query)
      }
      match Obligation::report_line(o, answer = answer, limit = "5000 ms limit") {
        Some(l) => Array::push(lines, value = l),
        None => ()
      }
    }
    if Array::length(lines) > 0 {
      code = 1
    } else {
      ()
    }
    if json {
      let msgs = Array::map(lines, f = (l) -> "line \{prove_line_col(source = source, off = l.0)}: \{l.1}")
      print(line_terminated(lsp_diagnostics_json_of_messages_for(path = path, source = source, msgs = msgs)))
    } else {
      for l in lines {
        println("\{path}:\{prove_line_col(source = source, off = l.0)}: \{l.1}")
      }
      ()
    }
  }
  code
}

/// The in-process lane: a run plan for @vibex/z3_wasi's `prove_main.vibex`
/// with `[--json] <file>...`, which the launcher runs; its exit status is
/// the command's. `asked` is whether `--solver=wasm` was given, which only
/// changes the wording when the module cannot be found.
fn prove_in_process(paths: Array[String], json: Bool, asked: Bool, checked_error_row: Bool) -> Int with Exception + Fs + Env {
  let dir = z3_wasi_package_dir()
  let why = if asked {
    "check --prove --solver=wasm"
  } else {
    "check --prove: `z3` is not on PATH, and for the in-process solver"
  }
  if dir == "" {
    throw("\{why}: @vibex/z3_wasi was not found in the workspace `lib/` or in VIBE_LIB; install `z3` on PATH (for example `nix shell nixpkgs#z3`, `apt install z3` or `brew install z3`) and run again")
  } else if !Fs::exists("\{dir}/z3_wasi.wasm") {
    throw("\{why}: \{dir}/z3_wasi.wasm is not built; run `bash scripts/build_z3_wasi.sh`, or install `z3` on PATH and run again")
  } else {
    ()
  }
  let args: Array[String] = ["run", "\{dir}/prove_main.vibex", "--"]
  if json {
    Array::push(args, value = "--json")
  } else {
    ()
  }
  // The launcher runs the plan's program in the invocation directory, but
  // `rewrite_user_argv` has already made each source path relative to the
  // project root, where this command runs. The guest reads them under
  // `--root` and reports them as given, the way the external lane does
  // (Codex review on #3883).
  Array::push(args, value = "--root")
  Array::push(args, value = Fs::getcwd())
  for p in paths {
    Array::push(args, value = p)
  }
  selfhost_cli_run_plan_args(args = args, action_path = Env::get("VIBE_HOST_ACTION_OUT"), checked_error_row = checked_error_row)
}

/// Where `import @vibex/z3_wasi` resolves from the project root: the
/// workspace `lib/`, then each VIBE_LIB root; "" when none holds it.
fn z3_wasi_package_dir() -> String with Fs + Env {
  let roots: Array[String] = ["lib"]
  for r in external_lib_roots() {
    Array::push(roots, value = r)
  }
  let mut found = ""
  for r in roots {
    if found == "" && Fs::exists("\{r}/@vibex/z3_wasi/prove_main.vibex") {
      found = "\{r}/@vibex/z3_wasi"
    } else {
      ()
    }
  }
  found
}

fn z3_available() -> Bool with Process {
  let h = vibe_sh_capture_raw("command -v z3 >/dev/null 2>&1")
  let status = vibe_sh_capture_exit_code_raw(h)
  vibe_sh_capture_close_raw(h)
  status == 0
}

/// The query reaches z3 on standard input through a quoted heredoc. Its
/// SMT-LIB symbols are `|name|`-quoted program identifiers, so no line of it
/// can be the terminator.
fn run_z3(_ query: String) -> String with Process {
  let h = vibe_sh_capture_raw("z3 -T:5 -in 2>&1 <<'VIBE_PROVE_EOF'\n\{query}VIBE_PROVE_EOF\n")
  let out = vibe_sh_capture_stdout_raw(h)
  vibe_sh_capture_close_raw(h)
  out
}
