//# `vibe`-adjacent coverage-corpus accumulator tool: native-vibe port of two
//# near-identical Python heredocs that both did a LOCAL (per-function,
//# occurrence-order) branch-coverage merge, as opposed to
//# lib/@vibe/cli/coverage_acc_tool.vibe's GLOBAL-branch-id merge:
//#   * scripts/coverage_drivers.sh's own merge.py: merges ONE driver run's
//#     raw coverage dump into acc.json.
//#   * scripts/coverage_unittests.sh's embedded heredoc: merges a whole LIST
//#     of unit-test run dumps (one path per line of a runs.txt) into acc.json
//#     in one pass.
//# Consolidated here (not scripts/) for the same reason as
//# coverage_acc_tool.vibe: the merge algorithm itself is generic beyond this
//# repo, so it's a reusable lib/@vibe/cli tool rather than a scripts/-private
//# one. Driven by scripts/coverage_local_merge_run.sh.
//#
//# WHY local, not global: coverage_acc_tool.vibe's merge assumes the run and
//# acc were compiled from the SAME source (so a branch's global id lines up
//# directly between the two dumps). Here the run was compiled from a
//# DIFFERENT source (a driver/test file concatenated onto a merged base, not
//# acc's own flat compiler source), so global ids do NOT line up -- but a
//# given function's branches still appear in the SAME RELATIVE ORDER within
//# that function's body regardless of which file surrounds it. So: group
//# acc's branches by (owning function NAME, 0-based occurrence index among
//# that function's own branches), do the same grouping for the run's
//# branches, and OR by matching (name, occurrence index) pairs instead of by
//# global id.
//#
//# Usage: argv[0] = subcommand, rest = args.
//#   merge <acc_path> <run_path>
//#     Single-run local merge (coverage_drivers.sh's use case). Prints
//#     "<base> <now> <tot>" (ints) -- callers format their own human report
//#     line (mirrors coverage_acc_tool.vibe's `stat` subcommand design: the
//#     tool computes, the caller formats, since the two real call sites want
//#     slightly different report-line text).
//#   merge-list <acc_path> <list_path>
//#     Multi-run local merge (coverage_unittests.sh's use case): list_path is
//#     a text file with one run-json path per line (blank lines ignored,
//#     matching Python's `if l.strip()`); every run is merged into ONE
//#     in-memory acc before a single write, matching the original's single
//#     json.dump at the end of its loop. Also prints "<base> <now> <tot>".
//#
//# Design differences from the Python heredocs, forced by vibe's actual
//# capabilities rather than an exact translation:
//#   * the Python originals group by function NAME (a string) via a
//#     `defaultdict(list)`, appending as they scan -- vibe's MapBuilder has
//#     no mid-build `get` (index.vpkg only declares new/set/freeze), so
//#     incrementally growing a per-name list through repeated
//#     read-modify-write isn't directly available, and Map::set was
//#     confirmed empirically NOT to mutate in place (`Map::set(m1, ...)`
//#     leaves `m1` itself unchanged -- functional update, not a mutator).
//#     Repeatedly freezing/re-querying a Map across ~20000 acc branches would
//#     also cost far more than this needs. Instead: build_index below groups
//#     by acc's own INTEGER function-id (fn_names' array index) using plain
//#     `Array[Int]` counting + a single flat `gid_for` lookup array (sized
//#     `len(fn_names) * max_occurrences`, one linear pass to size it, one
//#     more to fill it) -- O(N) instead of a hashmap-of-lists, with exactly
//#     one MapBuilder::set per DISTINCT function name (building the
//#     name->id lookup itself, not the per-name group). This is only
//#     behaviorally identical to the Python originals' string-keyed grouping
//#     if every entry in `fn_names` is unique -- confirmed empirically on a
//#     real coverage dump (2800/2800 distinct) and expected structurally
//#     (fn_names entries are the compiler's own fully-qualified function
//#     names, emitted once per user function by the coverage instrumentation
//#     pass) but not mechanically guaranteed; a hypothetical future duplicate
//#     name would silently let the later index win the name->id slot instead
//#     of merging both functions' occurrence sequences together the way the
//#     Python originals' `defaultdict(list)` does.
//#   * atomic write / Fs::rename / deliberately-no-`@vibe/fs`-import: see
//#     coverage_acc_tool.vibe's header comment (same reasoning).

import @vibe/json {
  Json, json_as_arr
}

//# Functions

fn is_truthy(_ j: Json) -> Bool {
  let ty = Json::type_of(j)
  if ty == "boolean" {
    Json::bool(j)
  } else if ty == "number" {
    let n = Json::number(j)
    n > 0.0000001 || n < (0.0 - 0.0000001)
  } else {
    false
  }
}

fn make_int_array(n: Int, fill: Int) -> Array[Int] {
  let a = array_new()
  let mut i = 0
  while i < n {
    Array::push(a, value = fill)
    i = i + 1
  }
  a
}

/// #1324 slice 3: `json_as_arr` throws instead of returning `Result`, so the
/// default-to-empty shape is a `handle`. This is the direction of the
/// migration that gets LONGER -- call sites that deliberately ignore the
/// failure pay for it, while the ones that propagated get shorter.
fn json_arr_or_empty(_ j: Json) -> Array[Json] {
  handle {
    json_as_arr(j)
  } with { Exception::Throw(_) => [] }
}

fn json_int_array(_ j: Json) -> Array[Int] {
  let arr = json_arr_or_empty(j)
  let n = Array::length(arr)
  let out = array_new()
  let mut i = 0
  while i < n {
    Array::push(out, value = Float64::to_int(Json::number(Array::get(arr, at = i))))
    i = i + 1
  }
  out
}

fn json_str_array(_ j: Json) -> Array[String] {
  let arr = json_arr_or_empty(j)
  let n = Array::length(arr)
  let out = array_new()
  let mut i = 0
  while i < n {
    Array::push(out, value = Json::string(Array::get(arr, at = i)))
    i = i + 1
  }
  out
}

fn sum_br(_ arr: Array[Json]) -> Int {
  let n = Array::length(arr)
  let mut i = 0
  let mut s = 0
  while i < n {
    if is_truthy(Array::get(arr, at = i)) {
      s = s + 1
    } else {
      ()
    }
    i = i + 1
  }
  s
}

fn write_json_atomic(path: String, j: Json) -> Unit with Fs {
  let tmp = path + ".tmp"
  Fs::write_file(tmp, contents = Json::stringify(j))
  Fs::rename(tmp, to = path)
}

/// name_to_fid: acc function name -> its index into fn_names.
/// gid_for: flat lookup, size len(fn_names)*occ_stride; gid_for[fid*occ_stride
/// + local_occurrence_index] = the acc branch's global id, or -1 if none.
fn build_index(fnC: Array[String], owC: Array[Int]) -> (Map[String, Int], Array[Int], Int) {
  let nf = Array::length(fnC)
  let no = Array::length(owC)
  let mb = MapBuilder::new()
  let mut ni = 0
  while ni < nf {
    MapBuilder::set(mb, key = Array::get(fnC, at = ni), value = ni)
    ni = ni + 1
  }
  let name_to_fid = MapBuilder::freeze(mb)
  let counts = make_int_array(n = nf, fill = 0)
  let local_idx = make_int_array(n = no, fill = -1)
  let mut g = 0
  let mut max_occ = 0
  while g < no {
    let fid = Array::get(owC, at = g)
    if fid >= 0 && fid < nf {
      let c = Array::get(counts, at = fid)
      Array::set(local_idx, at = g, value = c)
      Array::set(counts, at = fid, value = c + 1)
      if c + 1 > max_occ {
        max_occ = c + 1
      } else {
        ()
      }
    } else {
      ()
    }
    g = g + 1
  }
  let occ_stride = if max_occ > 0 {
    max_occ
  } else {
    1
  }
  let gid_for = make_int_array(n = nf * occ_stride, fill = -1)
  let mut g2 = 0
  while g2 < no {
    let fid2 = Array::get(owC, at = g2)
    if fid2 >= 0 && fid2 < nf {
      let li = Array::get(local_idx, at = g2)
      if li >= 0 {
        Array::set(gid_for, at = fid2 * occ_stride + li, value = g2)
      } else {
        ()
      }
    } else {
      ()
    }
    g2 = g2 + 1
  }
  (name_to_fid, gid_for, occ_stride)
}

/// OR one run's raw dump into br_arr (acc's mutable "br" array) via the
/// (name, occurrence-index) correlation built by build_index.
fn apply_run(br_arr: Array[Json], name_to_fid: Map[String, Int], gid_for: Array[Int], occ_stride: Int, raw: Json) -> Unit {
  let nT = json_str_array(Json::field(raw, key = "fn_names"))
  let owT = json_int_array(Json::field(raw, key = "branch_owners"))
  let bmT = Json::field(raw, key = "branch_bitmap")
  let ntf = Array::length(nT)
  let n_owT = Array::length(owT)
  let counts_run = make_int_array(n = ntf, fill = 0)
  let gid_for_len = Array::length(gid_for)
  let mut i = 0
  while i < n_owT {
    let fid_run = Array::get(owT, at = i)
    if fid_run >= 0 && fid_run < ntf {
      let li = Array::get(counts_run, at = fid_run)
      Array::set(counts_run, at = fid_run, value = li + 1)
      if is_truthy(Json::index(bmT, idx = i)) {
        let nm = Array::get(nT, at = fid_run)
        if Map::has_key(name_to_fid, key = nm) {
          let fid_acc = Map::get(name_to_fid, key = nm)
          if li < occ_stride {
            let idx = fid_acc * occ_stride + li
            if idx >= 0 && idx < gid_for_len {
              let gid = Array::get(gid_for, at = idx)
              if gid >= 0 {
                Array::set(br_arr, at = gid, value = JNum(1.0))
              } else {
                ()
              }
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

/// Loads acc + its br array + the correlation index once; returns them for
/// the caller to apply one or more runs against before a single write.
fn load_acc(_ acc_path: String) -> (Json, Array[Json], Map[String, Int], Array[Int], Int) with Fs {
  let acc = Json::parse(Fs::read_file(acc_path))
  let fnC = json_str_array(Json::field(acc, key = "fn_names"))
  let owC = json_int_array(Json::field(acc, key = "br_owners"))
  let br_arr = json_arr_or_empty(Json::field(acc, key = "br"))
  let idx = build_index(fnC = fnC, owC = owC)
  let (name_to_fid, gid_for, occ_stride) = idx
  (acc, br_arr, name_to_fid, gid_for, occ_stride)
}

fn merge_one_run(br_arr: Array[Json], name_to_fid: Map[String, Int], gid_for: Array[Int], occ_stride: Int, run_path: String) -> Unit with Fs {
  if Fs::exists(run_path) {
    let run = Json::parse(Fs::read_file(run_path))
    let raw = Json::field(run, key = "raw")
    if Json::is_null(raw) {
      ()
    } else {
      apply_run(br_arr = br_arr, name_to_fid = name_to_fid, gid_for = gid_for, occ_stride = occ_stride, raw = raw)
    }
  } else {
    ()
  }
}

fn cmd_merge(acc_path: String, run_path: String) -> Unit with Fs + Console {
  let loaded = load_acc(acc_path)
  let (acc, br_arr, name_to_fid, gid_for, occ_stride) = loaded
  let base = sum_br(br_arr)
  merge_one_run(br_arr = br_arr, name_to_fid = name_to_fid, gid_for = gid_for, occ_stride = occ_stride, run_path = run_path)
  write_json_atomic(path = acc_path, j = acc)
  let now = sum_br(br_arr)
  let tot = Array::length(br_arr)
  println(Int::to_string(base) + " " + Int::to_string(now) + " " + Int::to_string(tot) + "")
}

fn cmd_merge_list(acc_path: String, list_path: String) -> Unit with Fs + Console {
  let loaded = load_acc(acc_path)
  let (acc, br_arr, name_to_fid, gid_for, occ_stride) = loaded
  let base = sum_br(br_arr)
  let lines = String::split(Fs::read_file(list_path), sep = "\n")
  let n = Array::length(lines)
  let mut i = 0
  while i < n {
    let trimmed = String::trim(Array::get(lines, at = i))
    if trimmed != "" {
      merge_one_run(br_arr = br_arr, name_to_fid = name_to_fid, gid_for = gid_for, occ_stride = occ_stride, run_path = trimmed)
    } else {
      ()
    }
    i = i + 1
  }
  write_json_atomic(path = acc_path, j = acc)
  let now = sum_br(br_arr)
  let tot = Array::length(br_arr)
  println(Int::to_string(base) + " " + Int::to_string(now) + " " + Int::to_string(tot) + "")
}

fn main allows Fs + Env + Console + Stderr + Process::exit {
  let argc = Env::args_len()
  if argc < 1 {
    Stderr::write_stream("usage: coverage_local_merge merge <acc> <run> | merge-list <acc> <list>\n")
    Process::exit(2)
  } else {
    let sub = Env::args_get(0)
    if sub == "merge" && argc >= 3 {
      cmd_merge(acc_path = Env::args_get(1), run_path = Env::args_get(2))
    } else if sub == "merge-list" && argc >= 3 {
      cmd_merge_list(acc_path = Env::args_get(1), list_path = Env::args_get(2))
    } else {
      Stderr::write_stream("usage: coverage_local_merge merge <acc> <run> | merge-list <acc> <list>\n")
      Process::exit(2)
    }
  }
}
