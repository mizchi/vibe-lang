//# Dispatch

fn profile_tsv_env() -> String with Env {
  Env::get("VIBE_PROFILE_TSV")
}

fn profile_callstack_env() -> String with Env {
  Env::get("VIBE_PROFILE_CALLSTACK")
}

export fn selfhost_cli_low_level_args_profiled(input_path: String, output_path: String, entry_name: String, mode: String, profile_tsv_path: String, profile_callstack_path: String) -> Int with Exception + Fs + Env + Profiler {
  if !input_file_exists(input_path) {
    throw(String::concat("no such input file: ", input_path))
  } else {
    let total_start = profiler_now_us()
    let (bytes, load_us, type_us, bundle_us, parse_us, compile_us, _compile_total_us) = compile_release_file_mode_for_cli_profiled(input_path = input_path, entry_name = entry_name, mode = mode)
    let write_start = profiler_now_us()
    write_executable_wasm(output_path = output_path, bytes = bytes, entry_name = entry_name)
    let write_us = elapsed_profile_us_since(write_start)
    let total_us = elapsed_profile_us_since(total_start)
    write_optional_profile(path = profile_tsv_path, content = compile_lite_profile_tsv(load_us = load_us, type_us = type_us, bundle_us = bundle_us, parse_us = parse_us, compile_us = compile_us, write_us = write_us, total_us = total_us))
    write_optional_profile(path = profile_callstack_path, content = compile_lite_callstack_profile_tsv(total_us))
    0
  }
}

fn low_level_compile_release_profiled(input_path: String, output_path: String, entry_name: String, mode: String, profile_tsv_path: String, profile_callstack_path: String) -> Int with Exception + Fs + Env + Profiler {
  if artifact_cache_disabled() {
    selfhost_cli_low_level_args_profiled(input_path = input_path, output_path = output_path, entry_name = entry_name, mode = mode, profile_tsv_path = profile_tsv_path, profile_callstack_path = profile_callstack_path)
  } else {
    let total_start = profiler_now_us()
    let (bytes, load_us, type_us, bundle_us, parse_us, compile_us, _compile_total_us) = compile_release_file_mode_for_cli_profiled(input_path = input_path, entry_name = entry_name, mode = mode)
    let write_start = profiler_now_us()
    write_executable_wasm(output_path = output_path, bytes = bytes, entry_name = entry_name)
    let write_us = elapsed_profile_us_since(write_start)
    let total_us = elapsed_profile_us_since(total_start)
    write_optional_profile(path = profile_tsv_path, content = compile_lite_profile_tsv(load_us = load_us, type_us = type_us, bundle_us = bundle_us, parse_us = parse_us, compile_us = compile_us, write_us = write_us, total_us = total_us))
    write_optional_profile(path = profile_callstack_path, content = compile_lite_callstack_profile_tsv(total_us))
    0
  }
}

/// What the positional low-level form takes, and what to type instead. Named
/// here rather than in a wrapper script so it cannot drift from the dispatch
/// `match` a few lines below, which is the only place the subcommands exist.
fn low_level_usage() -> String {
  "usage: <input> <output> <entry> [mode], or a subcommand: build, check, compile, compile-lite, profile, serve"
}

/// `deps foo.vibe` is not a subcommand, so dispatch reads it as the positional
/// form and `deps` becomes the input path. Say what was read as what, so a
/// mistyped or unported verb is visible instead of being an exit code (#2361).
fn low_level_read_as(input_path: String, output_path: String, entry_name: String) -> String {
  String::concat(String::concat(String::concat("read `", input_path), "` as the input path, `"), String::concat(String::concat(output_path, "` as the output path, `"), String::concat(entry_name, "` as the entry name")))
}

export fn selfhost_cli_low_level_args(input_path: String, output_path: String, entry_name: String, mode: String) -> Int with Exception + Fs + Env + Profiler {
  if input_path == "" {
    throw(String::concat("no input path -- ", low_level_usage()))
  }
  else if output_path == "" {
    throw(String::concat(String::concat("no output path (", low_level_read_as(input_path = input_path, output_path = output_path, entry_name = entry_name)), String::concat(") -- ", low_level_usage())))
  }
  else if entry_name == "" {
    throw(String::concat(String::concat("no entry name (", low_level_read_as(input_path = input_path, output_path = output_path, entry_name = entry_name)), String::concat(") -- ", low_level_usage())))
  }
  else if is_vibex_path(input_path) && entry_name != "main" {
    throw(".vibex executable entry is always main; arbitrary entry names are not allowed")
  }
  else if mode == "" || mode == "release" || mode == "no-dce" || mode == "mvp" {
    if !input_file_exists(input_path) {
      throw(String::concat(String::concat("no such input file: ", input_path), String::concat(" -- ", low_level_usage())))
    } else {
      let profile_tsv_path = profile_tsv_env()
      let profile_callstack_path = profile_callstack_env()
      if profile_tsv_path == "" && profile_callstack_path == "" {
        let bytes = compile_release_file_mode_for_cli(input_path = input_path, entry_name = entry_name, mode = mode)
        write_executable_wasm(output_path = output_path, bytes = bytes, entry_name = entry_name)
        0
      } else {
        low_level_compile_release_profiled(input_path = input_path, output_path = output_path, entry_name = entry_name, mode = mode, profile_tsv_path = profile_tsv_path, profile_callstack_path = profile_callstack_path)
      }
    }
  }
  else if mode == "debug" {
    // #2305: the GATED builder -- it checks the closure its own compile
    // ingested, so the verdict covers exactly the bytes it is about to write.
    // The earlier preflight authorized one filesystem snapshot and let the
    // builder emit a second (Codex review), and paid for a second traversal.
    reject_unstable_entry(input_path)
    write_linked_debug_build_checked(input_path = input_path, output_path = output_path, entry_name = entry_name, allow_unstable = unstable_opt_in_granted())
    0
  }
  else if mode == "check" {
    // #2305 (Codex review): the positional `<input> <output> <entry> check`
    // fallback is a public path too, and it went straight to
    // `check_linked_file` while the command-style `check` above was gated.
    reject_unstable_entry(input_path)
    unstable_closure_reset()
    let status = check_linked_file(input_path = input_path)
    reject_unstable_closure()
    status
  }
  else {
    throw(String::concat(String::concat("unknown mode `", mode), "`: expected one of release, no-dce, mvp, debug, check"))
  }
}

fn low_level_cli_main() -> Int with Exception + Fs + Env + Profiler {
  let input_path = own_host_string(read_arg_or_env(index = 0, env_name = "VIBE_INPUT"))
  let output_path = own_host_string(read_arg_or_env(index = 1, env_name = "VIBE_OUTPUT"))
  let entry_name = own_host_string(read_arg_or_env(index = 2, env_name = "VIBE_ENTRY"))
  let mode = read_arg(3)
  selfhost_cli_low_level_args(input_path = input_path, output_path = output_path, entry_name = entry_name, mode = mode)
}

/// Dispatch on an explicit argv array (element 0 is the subcommand). Kept
/// argv-driven rather than reading Env directly so callers/tests can drive the
/// real CLI command routing with injected args. cli_main (entry.vibe)
/// wraps this with the Profiler/Error handlers; the regression tests in
/// dispatch_test.vibe drive it through that same wrapper.
export fn selfhost_cli_dispatch_args(_ args: Array[String]) -> Int with Exception + Fs + Env + Profiler + Stdin + Console + Stderr {
  // #2513: the `#cfg` flag set for every module this invocation parses and
  // every cache key it touches. Same call as cli_adapter.vibe's cli_main;
  // this dispatcher never passes through that entry.
  configure_compiler_cfg_flags()
  let first_arg = if Array::length(args) == 0 {
    ""
  } else {
    Array::get(args, at = 0)
  }
  if user_dispatch_is_verb(name = first_arg) {
    selfhost_cli_user_dispatch_args(args = args)
  } else {
    match first_arg {
      "compile-lite" => selfhost_cli_compile_lite_args(args),
      _ => low_level_cli_main()
    }
  }
}

export fn selfhost_cli_main() -> Int with Exception + Fs + Env + Profiler + Stdin + Console + Stderr {
  selfhost_cli_dispatch_args(collect_cli_args())
}

export fn cli_main() -> Int with Exception + Fs + Env + Profiler + Stdin + Console + Stderr {
  selfhost_cli_main()
}
