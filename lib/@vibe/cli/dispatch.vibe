//# Imports

import @vibe/cli/support {
  check_linked_file,
  check_unstable_surface_warnings_from_closure,
  check_unstable_surface_warnings_from_path,
  compile_release_file_mode,
  compile_release_file_mode_profiled,
  compile_release_file_mode_uncached,
  compile_release_file_mode_uncached_profiled,
  unstable_closure_reset,
  write_linked_debug_build,
  write_linked_debug_build_checked
}

import @vibe/compiler/codegen/executable {
  strip_executable_wasm_env
}

import @vibe/compiler/config {
  configure_compiler_cfg_flags
}

import @vibe/cli/commands {
  selfhost_cli_user_dispatch_args, user_dispatch_is_verb
}

//# Effects

effect Profiler {
  NowUs -> Int
}

//# Args

export fn read_arg(_ index: Int) -> String with Env {
  Env::args_get(index)
}

fn read_arg_or_env(index: Int, env_name: String) -> String with Env {
  let value = read_arg(index)
  if value != "" {
    value
  } else {
    Env::get(env_name)
  }
}

fn own_host_string(_ value: String) -> String {
  String::concat("", value)
}

export fn collect_cli_args() -> Array[String] with Env {
  let out = Array::slice([""], start = 0, end = 0)
  let argc = Env::args_len()
  let mut i = 0
  while i < argc {
    Array::push(out, value = own_host_string(read_arg(i)))
    i = i + 1
  }
  out
}

//# Path helpers

fn is_opt_level_arg(_ arg: String) -> Bool {
  String::length(arg) >= 2 && arg[0: 2] == "-O"
}

fn is_vibex_path(_ path: String) -> Bool {
  String::ends_with(path, suffix = ".vibex")
}

fn read_next_arg(args: Array[String], index: Int, flag: String) -> String with Exception {
  if index >= Array::length(args) {
    throw(String::concat("compile-lite: missing value after ", flag))
  } else {
    Array::get(args, at = index)
  }
}

fn read_next_arg_for(args: Array[String], index: Int, command: String, flag: String) -> String with Exception {
  if index >= Array::length(args) {
    throw(String::concat(command, String::concat(": missing value after ", flag)))
  } else {
    Array::get(args, at = index)
  }
}

fn read_next_path_after(args: Array[String], index: Int, command: String, flag: String) -> String with Exception {
  if index >= Array::length(args) {
    throw(String::concat(command, String::concat(": missing path after ", flag)))
  } else {
    Array::get(args, at = index)
  }
}

//# compile-lite

/// Direct builtin call (ADR-0076 追記31 Vertical C): the previous
/// `perform Profiler::NowUs` routed through the replay handler in
/// entry.vibe, which re-executed the ENTIRE handle body (the whole CLI
/// dispatch) once per perform and memoized the arm's `resume(0)` — every
/// timestamp read back 0. The builtin's own row keeps `Profiler` in every
/// signature, so this is row-neutral; the entry/test handlers stay valid
/// but their arms are now dead (no throw ever reaches them).
fn profiler_now_us() -> Int with Profiler {
  Profiler::now_us()
}

fn elapsed_profile_us_since(_ start_us: Int) -> Int with Profiler {
  let elapsed = profiler_now_us() - start_us
  if elapsed < 0 {
    0
  } else {
    elapsed
  }
}

fn profile_row(stage: String, elapsed_us: Int) -> String {
  let us = if elapsed_us < 0 {
    0
  } else {
    elapsed_us
  }
  let ms = us / 1000
  String::concat(stage, String::concat("\t", String::concat(__to_string(ms), String::concat("\t", String::concat(__to_string(us), "\n")))))
}

fn compile_lite_profile_tsv(load_us: Int, type_us: Int, bundle_us: Int, parse_us: Int, compile_us: Int, write_us: Int, total_us: Int) -> String {
  String::concat("stage\telapsed_ms\telapsed_us\n", String::concat(profile_row(stage = "load", elapsed_us = load_us), String::concat(profile_row(stage = "type", elapsed_us = type_us), String::concat(profile_row(stage = "bundle", elapsed_us = bundle_us), String::concat(profile_row(stage = "parse", elapsed_us = parse_us), String::concat(profile_row(stage = "compile", elapsed_us = compile_us), String::concat(profile_row(stage = "write", elapsed_us = write_us), profile_row(stage = "total", elapsed_us = total_us))))))))
}

fn compile_lite_callstack_profile_tsv(_ total_us: Int) -> String {
  String::concat("stage\telapsed_ms\telapsed_us\n", profile_row(stage = "compile", elapsed_us = total_us))
}

fn write_optional_profile(path: String, content: String) -> Unit with Fs {
  if path == "" {
    ()
  } else {
    Fs::write_file(path, contents = content)
  }
}

fn artifact_cache_disabled() -> Bool with Env {
  Env::get("VIBE_DISABLE_PERSISTENT_ARTIFACT_CACHE") == "1"
}

fn compile_release_file_mode_for_cli(input_path: String, entry_name: String, mode: String) -> Bytes with Exception + Fs + Env {
  // #2305: without the ADR-0068 opt-in, take the UNCACHED lane.
  //
  // `compile_file_fs_mode_cached` returns on a persistent-artifact hit before
  // it loads anything, so `ingest_source_text_fs` -- which is what populates
  // the closure record -- never runs. `reject_unstable_closure()` then asks an
  // empty record and answers "clean". Measured on this CLI before this line:
  // build with VIBE_UNSTABLE=1 to warm the cache, drop the opt-in, and the
  // artifact is produced anyway. Silently permissive, which is worse than no
  // gate at all.
  //
  // Uncached is PARITY, not a regression: the shipped adapter's VIBE_FS_COMPILE
  // lane uses the uncached `compile_file_fs_mode`, which is precisely why it
  // has no such hole. The artifact cache on this path is something the split
  // CLI added, and it is what opened it.
  //
  // Only the un-opted-in path pays. With the opt-in the gate is a no-op, so
  // the cache is safe and is still used. Getting the cache back for everyone
  // needs the verdict folded into the artifact fingerprint (so a no-opt-in
  // compile cannot hit an artifact built with it) -- a wider change than this,
  // and tracked on #2305.
  //
  // #2305 (Codex review): the gate lives HERE, not in each handler. Placing it
  // per-handler is what let `compile-lite` and the positional low-level path
  // ship ungated -- both call this helper and then write its bytes, and
  // neither had a check. Every artifact-producing path in this dispatcher goes
  // through this function, so gating it covers them by construction instead of
  // by remembering.
  reject_unstable_entry(input_path)
  unstable_closure_reset()
  let bytes = if artifact_cache_disabled() || !unstable_opt_in_granted() {
    compile_release_file_mode_uncached(input_path = input_path, entry_name = entry_name, mode = mode)
  } else {
    compile_release_file_mode(input_path = input_path, entry_name = entry_name, mode = mode)
  }
  reject_unstable_closure()
  bytes
}

/// The profiled twin, gated identically. The profiled paths produce artifacts
/// too, and gating only the plain helper left `compile-lite --profile` and the
/// positional profiled path writing wasm with no opt-in.
fn compile_release_file_mode_for_cli_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with Exception + Fs + Env + Profiler {
  reject_unstable_entry(input_path)
  unstable_closure_reset()
  let result = if artifact_cache_disabled() || !unstable_opt_in_granted() {
    compile_release_file_mode_uncached_profiled(input_path = input_path, entry_name = entry_name, mode = mode)
  } else {
    compile_release_file_mode_profiled(input_path = input_path, entry_name = entry_name, mode = mode)
  }
  reject_unstable_closure()
  result
}

fn input_file_exists(_ input_path: String) -> Bool with Fs {
  Fs::exists(input_path)
}

/// Binary-size (#1100): every EXECUTABLE artifact this dispatch layer writes
/// goes through the release strip (drop the name section, keep only the
/// exports runners address by name). serve stays on a plain write — its core
/// module's exports are lifted by name into the component. Debug builds go
/// through write_linked_debug_build, not here. VIBE_WASM_NAMES=1 /
/// VIBE_WASM_KEEP_EXPORTS=1 opt out (see strip_executable_wasm_env).
fn write_executable_wasm(output_path: String, bytes: Bytes, entry_name: String) -> Unit with Fs + Env {
  Fs::write_bytes(output_path, bytes = strip_executable_wasm_env(wasm = bytes, entry_name = entry_name))
}

fn parse_compile_lite_args_with_profile(_ args: Array[String]) -> (String, String, String, String, Bool, String, String) with Exception {
  if Array::length(args) == 0 || Array::get(args, at = 0) != "compile-lite" {
    throw("compile-lite: expected command")
  } else {
    let mut input_path = ""
    let mut output_path = ""
    let mut entry_name = "_start"
    let mut saw_entry = false
    let mut mode = "mvp"
    let mut in_memory = false
    let mut profile_tsv_path = ""
    let mut profile_callstack_path = ""
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, at = i)
      match arg {
        "--wasm" => (),
        "--wasm-linear" => (),
        "--wasm-gc" => {
          throw("compile-lite: --wasm-gc is not supported by selfhost cli yet")
          ()
        },
        "--coverage" => {
          throw("compile-lite: --coverage/--coverage-run-tests are not supported")
          ()
        },
        "--coverage-run-tests" => {
          throw("compile-lite: --coverage/--coverage-run-tests are not supported")
          ()
        },
        "--debug-errors" => {
          throw("compile-lite: --debug-errors is not supported")
          ()
        },
        "--http-host-imports" => {
          throw("compile-lite: --http-host-imports is not supported")
          ()
        },
        "--force-cabi-realloc" => {
          throw("compile-lite: --force-cabi-realloc is not supported")
          ()
        },
        "--async" => {
          throw("compile-lite: --async is not supported")
          ()
        },
        "--adapter" => {
          i = i + 1
          let _ = read_next_arg_for(args = args, index = i, command = "compile", flag = arg)
          throw("compile-lite: --adapter is not supported")
          ()
        },
        "--no-dce" => {
          mode = "no-dce"
          ()
        },
        "--entry" => {
          i = i + 1
          entry_name = read_next_arg(args = args, index = i, flag = arg)
          saw_entry = true
          ()
        },
        "-o" => {
          i = i + 1
          output_path = read_next_arg(args = args, index = i, flag = arg)
          ()
        },
        "--out" => {
          i = i + 1
          output_path = read_next_arg(args = args, index = i, flag = arg)
          ()
        },
        "--in-memory" => {
          in_memory = true
          ()
        },
        "--profile-tsv" => {
          i = i + 1
          profile_tsv_path = read_next_path_after(args = args, index = i, command = "compile-lite", flag = arg)
          ()
        },
        "--profile-callstack" => {
          i = i + 1
          profile_callstack_path = read_next_path_after(args = args, index = i, command = "compile-lite", flag = arg)
          ()
        },
        _ => if is_opt_level_arg(arg) {
          ()
        }
        else if String::length(arg) > 0 && String::char_code_at(arg, at = 0) == 45 {
          throw(String::concat("compile-lite: unsupported option: ", arg))
          ()
        }
        else if input_path == "" {
          input_path = arg
          ()
        }
        else {
          throw(String::concat("compile-lite: unexpected argument: ", arg))
        }
      }
      i = i + 1
    }
    if input_path == "" {
      throw("compile-lite: input path is required")
    } else if !in_memory && output_path == "" {
      throw("compile-lite: -o/--out is required")
    } else if is_vibex_path(input_path) && saw_entry {
      throw("compile-lite: --entry is not allowed for .vibex; the entry is always main")
    } else {
      let resolved_entry = if is_vibex_path(input_path) {
        "main"
      } else {
        entry_name
      }
      (input_path, output_path, resolved_entry, mode, in_memory, profile_tsv_path, profile_callstack_path)
    }
  }
}

export fn parse_compile_lite_args(_ args: Array[String]) -> (String, String, String, String, Bool) with Exception {
  let (input_path, output_path, entry_name, mode, in_memory, _, _) = parse_compile_lite_args_with_profile(args)
  (input_path, output_path, entry_name, mode, in_memory)
}

export fn selfhost_cli_compile_lite_args(_ args: Array[String]) -> Int with Exception + Fs + Env + Profiler {
  let (input_path, output_path, entry_name, mode, in_memory, profile_tsv_path, profile_callstack_path) = parse_compile_lite_args_with_profile(args)
  if !input_file_exists(input_path) {
    1
  } else if profile_tsv_path == "" && profile_callstack_path == "" {
    let bytes = compile_release_file_mode_for_cli(input_path = input_path, entry_name = entry_name, mode = mode)
    if in_memory {
      0
    } else {
      write_executable_wasm(output_path = output_path, bytes = bytes, entry_name = entry_name)
      0
    }
  } else {
    let total_start = profiler_now_us()
    let (bytes, load_us, type_us, bundle_us, parse_us, compile_us, _compile_total_us) = compile_release_file_mode_for_cli_profiled(input_path = input_path, entry_name = entry_name, mode = mode)
    if in_memory {
      let total_us = elapsed_profile_us_since(total_start)
      write_optional_profile(path = profile_tsv_path, content = compile_lite_profile_tsv(load_us = load_us, type_us = type_us, bundle_us = bundle_us, parse_us = parse_us, compile_us = compile_us, write_us = 0, total_us = total_us))
      write_optional_profile(path = profile_callstack_path, content = compile_lite_callstack_profile_tsv(total_us))
      0
    } else {
      let write_start = profiler_now_us()
      write_executable_wasm(output_path = output_path, bytes = bytes, entry_name = entry_name)
      let write_us = elapsed_profile_us_since(write_start)
      let total_us = elapsed_profile_us_since(total_start)
      write_optional_profile(path = profile_tsv_path, content = compile_lite_profile_tsv(load_us = load_us, type_us = type_us, bundle_us = bundle_us, parse_us = parse_us, compile_us = compile_us, write_us = write_us, total_us = total_us))
      write_optional_profile(path = profile_callstack_path, content = compile_lite_callstack_profile_tsv(total_us))
      0
    }
  }
}

//# compile

//# ADR-0068 opt-in gate (#2305)

/// The split CLI had no ADR-0068 boundary at all. Measured on a stage1 CLI
/// core built from this tree: `check` on a program whose sibling imports
/// `@vibe/concurrent` returned 0 with no diagnostic, and so did `check` on an
/// entry that imports it directly -- while the shipped adapter refuses both
/// and names the file that spells the import. Both halves were missing, not
/// just the closure one.
///
/// Same two-lane shape as `cli_adapter.vibe`, and for its reasons:
///
///   - the ENTRY pre-check rejects this file's own import before any compile
///     work, which keeps the common rejection fast;
///   - the CLOSURE check is the complete one -- a sibling carrying the import
///     is invisible until the loader has walked it -- so it runs after the
///     compile and before the artifact is written. A rejected build wastes
///     the compile, which is the right trade against a second full traversal
///     on every build.
///
/// Reported by `throw`, the way every other error in this dispatcher is: the
/// entry wrapper renders it as `error: <msg>` with a non-zero exit.
fn unstable_opt_in_granted() -> Bool with Env {
  Env::get("VIBE_UNSTABLE") == "1"
}

fn reject_unstable_entry(_ input_path: String) -> Unit with Exception + Fs + Env {
  if unstable_opt_in_granted() {
    ()
  } else {
    let diags = check_unstable_surface_warnings_from_path(input_path = input_path)
    if Array::length(diags) > 0 {
      throw(String::join(diags, sep = "\n"))
    } else {
      ()
    }
  }
}

/// Call `unstable_closure_reset()` before the compile that populates the
/// record, or this reports a PREVIOUS compile's dependency against this one.
fn reject_unstable_closure() -> Unit with Exception + Fs + Env {
  if unstable_opt_in_granted() {
    ()
  } else {
    let diags = check_unstable_surface_warnings_from_closure()
    if Array::length(diags) > 0 {
      throw(String::join(diags, sep = "\n"))
    } else {
      ()
    }
  }
}

