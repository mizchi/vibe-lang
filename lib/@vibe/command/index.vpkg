// @vibe/command — the guest half of the `vibe-command-result-v1` wire format
// viberun's `--commands` lane speaks (runtime/viberun/src/commands.rs).
//
// No deps on purpose. A command component is meant to be SMALL -- that is the
// entire reason the lane exists -- so the package a command module has to
// import to speak the protocol must not drag a closure in behind it.

import ./protocol.vibe {
}

fn command_arg_separator() -> String
fn command_args(raw: String) -> Array[String]
fn command_result(exit: Int, output: String) -> String
fn command_ok(output: String) -> String
fn command_failed(exit: Int, message: String) -> String
