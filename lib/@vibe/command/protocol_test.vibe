import ./protocol.vibe {
  command_arg_separator, command_args, command_failed, command_ok, command_result
}

test "the separator is one NUL byte" {
  let sep = command_arg_separator()
  assert_eq(String::length(sep), 1)
  assert_eq(String::char_code_at(sep, 0), 0)
}

test "argv round-trips through the NUL join viberun performs" {
  let sep = command_arg_separator()
  let joined = String::concat("check", String::concat(sep, "a b.vibe"))
  let argv = command_args(joined)
  assert_eq(Array::length(argv), 2)
  assert_eq(Array::get(argv, 0), "check")
  // The space survives: NUL is the separator, so a spaced argument is one
  // argument, which is the whole reason NUL was picked over a space.
  assert_eq(Array::get(argv, 1), "a b.vibe")
}

test "a lone verb is one argument" {
  let argv = command_args("check")
  assert_eq(Array::length(argv), 1)
  assert_eq(Array::get(argv, 0), "check")
}

test "an empty parameter is no arguments, not one empty argument" {
  assert_eq(Array::length(command_args("")), 0)
}

test "an empty trailing argument is preserved" {
  let sep = command_arg_separator()
  let argv = command_args(String::concat("check", sep))
  assert_eq(Array::length(argv), 2)
  assert_eq(Array::get(argv, 1), "")
}

test "the frame carries the exit code and then the output verbatim" {
  assert_eq(command_result(0, "hi\n"), "vibe-command-result-v1\t0\nhi\n")
  assert_eq(command_ok("hi\n"), "vibe-command-result-v1\t0\nhi\n")
  assert_eq(command_failed(2, "bad\n"), "vibe-command-result-v1\t2\nbad\n")
}

test "output with no trailing newline stays without one" {
  assert_eq(command_ok(""), "vibe-command-result-v1\t0\n")
}

test "a multi-line payload is not re-framed per line" {
  let framed = command_ok("a\nb\n")
  assert_eq(framed, "vibe-command-result-v1\t0\na\nb\n")
}
