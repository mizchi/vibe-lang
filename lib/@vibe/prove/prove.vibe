//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr, index_site_offset, is_builtin_ref_offset
}

import @vibe/parser {
  lex_with_offsets, parse_program_preserving_located, print_expr, print_type_expr
}

import ./solver.vibe {
  arr_data, arr_datatype_decl, arr_len, arr_sort, model_terms, smt_unquote
}

import ./walk.vibe {
  binder_inits,
  builtin_imports,
  call_graph,
  collect_assigned,
  construct_name,
  contains_name,
  decl_offset,
  expr_kids,
  expr_off,
  is_array_literal,
  reaches_cycle,
  shown_index_reads,
  strip_label
}

import ./int_terms.vibe {
  pow2_text, shift_count, trunc_div
}

import ./word.vibe {
  adapt_word, is_word_sort, smt_sort_text, word_binop, word_of_int, word_to_int, word_unary, word_zero
}

//# Types

/// A path through a function: the conditions that lead to it, the value it
/// produced (an SMT-LIB term), that value's sort (`Int`, `Bool`, `Unit`),
/// whether it left the function by `return`, and the names in scope.
struct Outcome {
  pc: Array[String];
  value: String;
  sort: String;
  returned: Bool;
  env: Array[(String, String, String)]
}

/// A contracted function of the file, as the prover reads it at a call.
struct FnSig {
  name: String;
  params: Array[(String, String)];
  ret: String;
  requires: Array[Expr];
  ensures: Array[Expr];
  pure: Bool
}

/// The function being proved. `assumes` grows as the walk reaches calls;
/// an obligation records how many of them precede it, so a later call's
/// assumption can never discharge an earlier obligation.
struct Ctx {
  fn_name: String;
  adts: Array[Adt];
  decls: Array[(String, String)];
  assumes: Array[String];
  pending: Array[(String, String, Int, String, Int)];
  fns: Array[FnSig];
  counter: Array[Int];
  /// The checkpoint closures of the contracted `for` loops being proved
  /// (`attach_for_contract`). A call of one is the runtime check of the
  /// loop's clauses, which `sym_for` owes as obligations instead.
  checkpoints: Array[String];
  /// The local arrays the function writes (`writable_arrays`): each bound
  /// once to an array literal and named only as the array of a builtin read
  /// or write, so no other name holds it and a write is an update of its
  /// one binding.
  writable: Array[String];
  /// The names the file imports from `@vibe/builtin` under their own
  /// spelling (`builtin_imports`): `Int::range_all` / `Int::range_any` are
  /// read as quantifiers only when they are that package's.
  builtins: Array[String]
}

/// #3719: a struct or enum of the file the prover reads as an SMT datatype:
/// non-generic, without `mut` fields, and every field `Int`, `Bool` or
/// another such type. A struct is one constructor; an enum one per variant.
struct Adt {
  name: String;
  is_struct: Bool;
  ctors: Array[(String, Array[(String, String)])];
  /// The type, or one it contains, has its own `equals`: `==` runs that
  /// comparator, which SMT `=` does not model.
  custom_eq: Bool
}

//# Constants

fn int_min() -> String {
  "(- 4611686018427387904)"
}

fn int_max() -> String {
  "4611686018427387903"
}

fn unsupported_marker() -> String {
  "__vibe_prove_unsupported:"
}

//# Entry

/// Every obligation of every function in `source` that carries a `where`
/// contract, in source order. A function outside the provable fragment
/// yields one `unsupported` obligation instead of being skipped.
export fn prove_obligations(_ source: String) -> Array[Obligation] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_preserving_located(tokens = tokens, starts = starts, source = source)
  let adts = collect_adts(stmts)
  let fns = collect_sigs(stmts = stmts, adts = adts)
  let graph = call_graph(stmts)
  let builtins = builtin_imports(stmts)
  let out: Array[Obligation] = []
  for s in stmts {
    match s {
      SFnDecl(_, name, value, reqs, enss) => if Array::length(reqs) + Array::length(enss) == 0 {
        ()
      } else if reaches_cycle(graph = graph, node = name, path = [], done = []) {
        // A modular call assumes the callee's `ensures`; around a cycle that
        // assumption is circular, so `ensures: false` on both of two
        // mutually recursive functions would "prove" each other.
        Array::push(out, value = Obligation::{
          fn_name: name,
          kind: "unsupported",
          label: "`\{name}` is part of, or calls into, a recursive cycle: termination is not proved, so the result would be partial correctness only",
          off: decl_offset(source = source, name = name),
          query: ""
        })
      } else {
        prove_fn(name = name, value = value, fns = fns, adts = adts, builtins = builtins, decl_off = decl_offset(source = source, name = name), out = out)
      },
      _ => ()
    }
  }
  out
}

fn collect_sigs(stmts: Array[Stmt], adts: Array[Adt]) -> Array[FnSig] {
  let out: Array[FnSig] = []
  for s in stmts {
    match s {
      SFnDecl(_, name, value, reqs, enss) => match value {
        EFn(tps, _, params, ret, eff, _) => {
          let ps: Array[(String, String)] = []
          let mut ok = Array::length(tps) == 0 && match eff {
            Some(_) => false,
            None => true
          }
          for p in params {
            let (pn, pty) = p
            let sort = sort_of(adts = adts, ty = pty)
            if sort == "" {
              ok = false
            } else {
              Array::push(ps, value = (pn, sort))
            }
          }
          let rs = sort_of(adts = adts, ty = ret)
          Array::push(out, value = FnSig::{
            name: name,
            params: ps,
            ret: rs,
            requires: reqs,
            ensures: enss,
            pure: ok && rs != ""
          })
        },
        _ => ()
      },
      _ => ()
    }
  }
  out
}

fn sort_of(adts: Array[Adt], ty: Option[TypeExpr]) -> String {
  match ty {
    Some(TyName(n)) => name_sort(adts = adts, name = n),
    Some(TyApp("Array", args)) => if Array::length(args) == 1 && match Array::get(args, at = 0) {
      TyName("Int") => true,
      _ => false
    } {
      arr_sort()
    } else {
      ""
    },
    _ => ""
  }
}

/// The SMT sort of a type spelled `n`: `Int`, `Bool`, a datatype of the
/// file, or "" when it is none of them.
fn name_sort(adts: Array[Adt], name: String) -> String {
  if name == "Int" {
    "Int"
  } else if name == "Int32" || name == "UInt32" {
    // #3827: a 32-bit word (word.vibe).
    name
  } else if name == "Bool" {
    "Bool"
  } else {
    match find_adt(adts = adts, name = name) {
      Some(_) => adt_sort(name),
      None => ""
    }
  }
}

fn find_sig(fns: Array[FnSig], name: String) -> Option[FnSig] {
  let mut found = None
  for f in fns {
    if f.name == name {
      found = Some(f)
    } else {
      ()
    }
  }
  found
}

//# One function

fn prove_fn(name: String, value: Expr, fns: Array[FnSig], adts: Array[Adt], builtins: Array[String], decl_off: Int, out: Array[Obligation]) -> Unit with Exception {
  let ctx = Ctx::{
    fn_name: name,
    adts: adts,
    decls: [],
    assumes: [],
    pending: [],
    fns: fns,
    counter: [0],
    checkpoints: [],
    writable: [],
    builtins: builtins
  }
  let result = handle {
    prove_fn_body(ctx = ctx, value = value)
    ""
  } with { Exception::Throw(msg) => msg }
  let marker = unsupported_marker()
  if String::starts_with(result, prefix = marker) {
    let rest = String::substring(result, start = String::length(marker), end = String::length(result))
    let colon = String::index_of(rest, needle = ":")
    let off = match Int::parse(String::substring(rest, start = 0, end = colon)) {
      Some(n) => n,
      None => 0 - 1
    }
    Array::push(out, value = Obligation::{
      fn_name: name,
      kind: "unsupported",
      label: String::substring(rest, start = colon + 1, end = String::length(rest)),
      off: if off < 0 {
        decl_off
      } else {
        off
      },
      query: ""
    })
  } else if String::length(result) > 0 {
    throw(result)
  } else {
    for p in ctx.pending {
      let (kind, label, off, goal, upto) = p
      Array::push(out, value = Obligation::{
        fn_name: name,
        kind: kind,
        label: label,
        off: if off < 0 {
          decl_off
        } else {
          off
        },
        query: build_query(ctx = ctx, goal = goal, upto = upto)
      })
    }
    ()
  }
}

fn unsupported(off: Int, reason: String) -> Unit with Exception {
  throw("\{unsupported_marker()}\{off}:\{reason}")
}

fn prove_fn_body(ctx: Ctx, value: Expr) -> Unit with Exception {
  match value {
    EFn(tps, _, params, ret, eff, body) => {
      if Array::length(tps) > 0 {
        unsupported(off = 0 - 1, reason = "a generic function is outside the provable fragment")
      } else {
        ()
      }
      match eff {
        Some(row) => unsupported(off = 0 - 1, reason = "a function with an effect row (`with \{row}`) is outside the provable fragment"),
        None => ()
      }
      let ret_sort = sort_of(adts = ctx.adts, ty = ret)
      if ret_sort == "" {
        unsupported(off = 0 - 1, reason = "only an `Int`, `Bool`, struct or enum result is provable")
      } else {
        ()
      }
      let env: Array[(String, String, String)] = []
      for p in params {
        let (pn, pty) = p
        let sort = sort_of(adts = ctx.adts, ty = pty)
        if sort == "" {
          unsupported(off = 0 - 1, reason = "parameter `\{pn}` is not `Int`, `Bool`, `Array[Int]`, or a struct / enum of this file (non-generic, every field `Int`, `Bool` or such a type)")
        } else {
          ()
        }
        let smt = smt_symbol(pn)
        if is_word_sort(sort) {
          // #3827: declared as the `Int` it reads as, so a counterexample
          // shows the number the program sees, and the body uses a word
          // declared beside it that the `Int` is the reading of. That link
          // also bounds the `Int` to the word's range. Converting the `Int`
          // to the word instead (`int2bv`) is what z3 is slow at: a
          // one-comparison `UInt32` claim took 5 s, the gate's whole limit.
          let w = word_symbol(pn)
          Array::push(ctx.decls, value = (smt, "Int"))
          Array::push(ctx.decls, value = (w, sort))
          Array::push(ctx.assumes, value = "(= \{smt} \{word_to_int(sort = sort, t = w)})")
          Array::push(env, value = (pn, w, sort))
        } else {
          Array::push(ctx.decls, value = (smt, sort))
          assume_range(ctx = ctx, term = smt, sort = sort, pc = [])
          Array::push(env, value = (pn, smt, sort))
        }
      }
      for w in writable_arrays(ctx = ctx, params = params, body = body) {
        Array::push(ctx.writable, value = w)
      }
      match find_sig(fns = ctx.fns, name = ctx.fn_name) {
        Some(sig) => {
          for r in sig.requires {
            let f = clause_formula(ctx = ctx, clause = r, state = start_state(env))
            Array::push(ctx.assumes, value = f)
          }
          let outs = sym(ctx = ctx, e = body, st = start_state(env))
          for o0 in outs {
            // #3827: a literal returned where a word is declared is that word.
            let adapted = adapt_word(value = o0.value, sort = o0.sort, want = ret_sort)
            let o = if adapted != "" && adapted != o0.value {
              with_value(st = o0, value = adapted, sort = ret_sort)
            } else {
              o0
            }
            let v_sort = o.sort
            if is_loop_jump(o) {
              unsupported(off = 0 - 1, reason = "`break` / `continue` outside a proved `while`")
            } else {
              ()
            }
            if v_sort != ret_sort {
              unsupported(off = 0 - 1, reason = "a path ends with a `\{v_sort}` where `\{ret_sort}` is returned")
            } else {
              ()
            }
            for c in sig.ensures {
              // The parameters as they were at entry, as the runtime check
              // reads them (`ensures_checked_body`): a body that shadows one
              // does not change what the clause says.
              let renv = env_bind(env = env, name = "result", term = o.value, sort = ret_sort)
              let goal = clause_formula(ctx = ctx, clause = c, state = Outcome::{
                pc: o.pc,
                value: "",
                sort: "Unit",
                returned: false,
                env: renv
              })
              push_obligation(ctx = ctx, kind = "ensures", label = print_expr(c), off = expr_off(c), goal = goal)
            }
          }
          ()
        },
        None => ()
      }
    },
    _ => unsupported(off = 0 - 1, reason = "not a function")
  }
}

fn start_state(_ env: Array[(String, String, String)]) -> Outcome {
  Outcome::{ pc: [], value: "", sort: "Unit", returned: false, env: env }
}

//# Obligations and queries

fn push_obligation(ctx: Ctx, kind: String, label: String, off: Int, goal: String) -> Unit {
  // The printer spells an index read by its builtin `__index`; a report
  // names it the way a program can (`Array::get(xs, i)`).
  Array::push(ctx.pending, value = (kind, shown_index_reads(label), off, goal, Array::length(ctx.assumes)))
}

/// An `Int` term holds a 63-bit value, so it may be assumed in range -- but
/// only on the path that computes it. An assumption is global to the query,
/// so one taken unguarded on one branch would also constrain its siblings and
/// could leave a reachable path's obligation vacuous.
fn assume_range(ctx: Ctx, term: String, sort: String, pc: Array[String]) -> Unit {
  if sort == "Int" {
    Array::push(ctx.assumes, value = guarded(pc = pc, goal = in_range(term)))
  } else if sort == arr_sort() {
    // A length is a non-negative `Int`.
    Array::push(ctx.assumes, value = guarded(pc = pc, goal = "(and (<= 0 \{arr_len(term)}) \{in_range(arr_len(term))})"))
  } else {
    ()
  }
}

fn in_range(_ term: String) -> String {
  "(and (<= \{int_min()} \{term}) (<= \{term} \{int_max()}))"
}

fn guarded(pc: Array[String], goal: String) -> String {
  if Array::length(pc) == 0 {
    goal
  } else {
    "(=> (and true \{String::join(pc, sep = " ")}) \{goal})"
  }
}

/// The SMT-LIB query that `goal` holds under the function's first `upto`
/// assumptions: `unsat` proves it, a model is a counterexample.
fn build_query(ctx: Ctx, goal: String, upto: Int) -> String {
  let lines: Array[String] = [
    "(set-option :produce-models true)",
    arr_datatype_decl()
  ]
  if Array::length(ctx.adts) > 0 {
    Array::push(lines, value = datatypes_decl(ctx.adts))
  } else {
    ()
  }
  for d in ctx.decls {
    let (n, s) = d
    Array::push(lines, value = "(declare-const \{n} \{smt_sort_text(s)})")
  }
  let mut i = 0
  while i < upto {
    Array::push(lines, value = "(assert \{Array::get(ctx.assumes, at = i)})")
    i = i + 1
  }
  Array::push(lines, value = "(assert (not \{goal}))")
  Array::push(lines, value = "(check-sat)")
  let names: Array[String] = []
  for d in ctx.decls {
    let (n, s) = d
    if !String::starts_with(n, prefix = "|r!") && !String::starts_with(n, prefix = "|w!") {
      for t in model_terms(name = n, sort = s) {
        Array::push(names, value = t)
      }
    } else {
      ()
    }
  }
  if Array::length(names) > 0 {
    Array::push(lines, value = "(get-value (\{String::join(names, sep = " ")}))")
  } else {
    ()
  }
  String::join(lines, sep = "\n") + "\n"
}

/// A program name as an SMT-LIB quoted symbol (`|x|`), so no spelling can
/// collide with an SMT-LIB keyword.
fn smt_symbol(_ name: String) -> String {
  "|\{name}|"
}

/// The word a parameter of `Int32` / `UInt32` named `name` is used as. A
/// program name holds no `!`, so this cannot collide with one, and
/// `build_query` leaves it out of the model it asks for: the counterexample
/// names the parameter's `Int`.
fn word_symbol(_ name: String) -> String {
  "|w!\{name}|"
}

fn smt_int(_ n: Int) -> String {
  if n < 0 {
    "(- \{0 - n})"
  } else {
    "\{n}"
  }
}

//# Clauses

/// A clause as one formula: every path through it ends in a true value.
/// Its arithmetic is checked for overflow like the body's, since the runtime
/// assert evaluates it with the same 63-bit `Int`.
fn clause_formula(ctx: Ctx, clause: Expr, state: Outcome) -> String with Exception {
  let outs = sym(ctx = ctx, e = clause, st = state)
  let parts: Array[String] = []
  for o in outs {
    // A clause is read as a formula, which has no way out of the function;
    // a `return` inside one would leave it at run time with a value no
    // `ensures` was checked against.
    if o.returned {
      unsupported(off = expr_off(clause), reason = "a contract clause that leaves the function with `return`")
    } else if o.sort != "Bool" {
      unsupported(off = expr_off(clause), reason = "a contract clause must be a `Bool`")
    } else {
      ()
    }
    Array::push(parts, value = guarded(pc = o.pc, goal = o.value))
  }
  if Array::length(parts) == 1 {
    Array::get(parts, at = 0)
  } else {
    "(and true \{String::join(parts, sep = " ")})"
  }
}

//# Symbolic execution

fn env_bind(env: Array[(String, String, String)], name: String, term: String, sort: String) -> Array[(String, String, String)] {
  let out = Array::slice(env, start = 0, end = Array::length(env))
  Array::push(out, value = (name, term, sort))
  out
}

fn env_lookup(env: Array[(String, String, String)], name: String) -> Option[(String, String)] {
  let mut i = Array::length(env)
  let mut found = None
  let mut done = false
  while i > 0 && !done {
    i = i - 1
    let (n, t, s) = Array::get(env, at = i)
    if n == name {
      found = Some((t, s))
      done = true
    } else {
      ()
    }
  }
  found
}

fn with_value(st: Outcome, value: String, sort: String) -> Outcome {
  Outcome::{ pc: st.pc, value: value, sort: sort, returned: false, env: st.env }
}

fn with_pc(st: Outcome, cond: String) -> Outcome {
  let pc = Array::slice(st.pc, start = 0, end = Array::length(st.pc))
  Array::push(pc, value = cond)
  Outcome::{
    pc: pc,
    value: st.value,
    sort: st.sort,
    returned: st.returned,
    env: st.env
  }
}

fn fresh(ctx: Ctx, sort: String) -> String {
  let k = Array::get(ctx.counter, at = 0)
  Array::set(ctx.counter, at = 0, value = k + 1)
  let name = "|r!\{k}|"
  Array::push(ctx.decls, value = (name, sort))
  name
}

/// Every path through `e` from `st`. A path that already left by `return`
/// is carried through unchanged by every enclosing form.
fn sym(ctx: Ctx, e: Expr, st: Outcome) -> Array[Outcome] with Exception {
  match e {
    EInt(n) => [with_value(st = st, value = smt_int(n), sort = "Int")],
    EBool(b) => [
      with_value(st = st, value = if b {
        "true"
      } else {
        "false"
      }, sort = "Bool")
    ],
    EUnit => [with_value(st = st, value = "true", sort = "Unit")],
    EIdent(name, off) => match env_lookup(env = st.env, name = name) {
      Some((t, s)) => [with_value(st = st, value = t, sort = s)],
      None => match resolve_ctor(adts = ctx.adts, name = name) {
        Some((adt, ctor)) => {
          let (_, fields) = ctor
          if Array::length(fields) > 0 {
            unsupported(off = off, reason = "constructor `\{name}` used without its fields")
          } else {
            ()
          }
          [
            with_value(st = st, value = ctor_smt(adt = adt, ctor = ctor), sort = adt_sort(adt.name))
          ]
        },
        None => {
          unsupported(off = off, reason = "`\{name}` is not a parameter or local of the provable fragment")
          []
        }
      }
    },
    EUnaryOp(op, x) => {
      let out: Array[Outcome] = []
      for o in sym(ctx = ctx, e = x, st = st) {
        if o.returned {
          Array::push(out, value = o)
        } else if op == "!" && o.sort == "Bool" {
          Array::push(out, value = with_value(st = o, value = "(not \{o.value})", sort = "Bool"))
        } else if is_word_sort(o.sort) && word_unary(op = op, t = o.value) != "" {
          Array::push(out, value = with_value(st = o, value = word_unary(op = op, t = o.value), sort = o.sort))
        } else if op == "-" && o.sort == "Int" {
          let t = "(- \{o.value})"
          push_obligation(ctx = ctx, kind = "overflow", label = print_expr(e), off = expr_off(e), goal = guarded(pc = o.pc, goal = in_range(t)))
          Array::push(out, value = with_value(st = o, value = t, sort = "Int"))
        } else {
          unsupported(off = expr_off(e), reason = "unary `\{op}` on a `\{o.sort}`")
        }
      }
      out
    },
    EBinOp(op, l, r, off) => sym_binop(ctx = ctx, e = e, op = op, l = l, r = r, off = off, st = st),
    EIf(c, t, f) => {
      let out: Array[Outcome] = []
      for o in sym(ctx = ctx, e = c, st = st) {
        if o.returned {
          Array::push(out, value = o)
        } else {
          for a in sym(ctx = ctx, e = t, st = with_pc(st = o, cond = o.value)) {
            Array::push(out, value = a)
          }
          for b in sym(ctx = ctx, e = f, st = with_pc(st = o, cond = "(not \{o.value})")) {
            Array::push(out, value = b)
          }
          ()
        }
      }
      join_word_outcomes(outs = out, off = expr_off(c))
    },
    ELet(name, v, b, _) => match contracted_for(name = name, lam = v, inner = b) {
      Some(fl) => sym_for(ctx = ctx, fl = fl, st = st),
      None => sym_let(ctx = ctx, name = name, v = v, b = b, st = st)
    },
    ELetMut(name, v, b, _) => match contracted_loop_cells(name = name, inner = b) {
      Some(lp) => sym_loop(ctx = ctx, lp = lp, st = st),
      None => match contracted_for_cells(name = name, inner = b) {
        Some(fl) => sym_for(ctx = ctx, fl = fl, st = st),
        None => sym_let(ctx = ctx, name = name, v = v, b = b, st = st)
      }
    },
    // A `for` without a contract: an iteration over an array ends, so no
    // measure is owed, and with no invariant nothing is known of what the
    // body assigns.
    EForIn(v, i, it, b, _) => sym_for(ctx = ctx, fl = ForLoop::{
      value_name: v,
      index_name: i,
      iterable: it,
      body: b,
      check: "",
      invariants: [],
      measure: None
    }, st = st),
    EAssign(name, v, c, off) => sym_assign(ctx = ctx, name = name, v = v, c = c, off = off, st = st),
    EAssignOp(name, op, v, c, off) => sym_assign(ctx = ctx, name = name, v = EBinOp(op, EIdent(name, off), v, off), c = c, off = off, st = st),
    EWhile(c, b) => match decode_while(cond = c, body = b) {
      Some(lp) => sym_loop(ctx = ctx, lp = lp, st = st),
      None => {
        unsupported(off = expr_off(c), reason = "a `while` without a `where { decreases: .. }` measure: termination is not proved, so the result would be partial correctness only")
        []
      }
    },
    // A `break` / `continue` leaves the rest of the iteration like a
    // `return` leaves the function: a marked outcome every construct passes
    // up, which the contracted `while` around it consumes (`sym_loop`).
    EBreak(v) => match v {
      Some(_) => {
        unsupported(off = 0 - 1, reason = "`break` with a value, which only a `loop` takes")
        []
      },
      None => [loop_jump(st = st, kind = loop_break())]
    },
    EContinue(args) => if Array::length(args) > 0 {
      unsupported(off = 0 - 1, reason = "`continue` with arguments, which only a `loop` takes")
      []
    } else {
      [loop_jump(st = st, kind = loop_continue())]
    },
    ESeq(a, b) => {
      let out: Array[Outcome] = []
      for o in sym(ctx = ctx, e = a, st = st) {
        if o.returned {
          Array::push(out, value = o)
        } else {
          for x in sym(ctx = ctx, e = b, st = o) {
            Array::push(out, value = x)
          }
          ()
        }
      }
      out
    },
    EReturn(v) => {
      let out: Array[Outcome] = []
      for o in sym(ctx = ctx, e = v, st = st) {
        Array::push(out, value = Outcome::{
          pc: o.pc,
          value: o.value,
          sort: o.sort,
          returned: true,
          env: o.env
        })
      }
      out
    },
    ECall(callee, args, off, _) => match callee {
      // The checkpoint call before a `continue` of a contracted `for`: the
      // `continue` itself makes `sym_for` owe the clauses.
      EIdent(fname, coff) => if Array::length(args) == 0 && contains_name(xs = ctx.checkpoints, x = fname) {
        [with_value(st = st, value = "true", sort = "Unit")]
      } else if (fname == "Int::to_int32" || fname == "Int::to_uint32") && match find_sig(fns = ctx.fns, name = fname) {
        Some(_) => false,
        None => true
      } {
        unsupported(off = off, reason = "`\{fname}` answers an `Option`, which is not modelled; test the range and use `\{if fname == "Int::to_int32" {
          "Int::wrap_int32"
        } else {
          "Int::wrap_uint32"
        }}`")
        []
      } else if is_word_conversion(ctx = ctx, fname = fname, callee_off = coff) {
        sym_word_conversion(ctx = ctx, fname = fname, args = args, off = off, st = st)
      } else if is_array_write_name(ctx = ctx, fname = fname, callee_off = coff) {
        let at = if index_site_offset(coff) >= 0 {
          index_site_offset(coff)
        } else {
          off
        }
        sym_array_write(ctx = ctx, e = e, fname = fname, args = args, off = at, indexed = index_site_offset(coff) >= 0, st = st)
      } else if is_quantifier_call(ctx = ctx, st = st, fname = fname) {
        sym_quantifier(ctx = ctx, fname = fname, args = args, off = off, st = st)
      } else if is_builtin_array_read(ctx = ctx, st = st, fname = fname, callee_off = coff) {
        let at = if fname == "__index" {
          index_site_offset(coff)
        } else {
          off
        }
        sym_array_read(ctx = ctx, e = e, fname = fname, args = args, off = at, st = st)
      } else {
        match resolve_ctor(adts = ctx.adts, name = fname) {
          Some((adt, ctor)) => sym_construct(ctx = ctx, adt = adt, ctor = ctor, named = [
          ], args = args, off = off, st = st),
          None => sym_call(ctx = ctx, fname = fname, args = args, off = off, st = st)
        }
      },
      _ => match ascription_type(callee) {
        Some(ty) => if Array::length(args) == 1 {
          sym_ascription(ctx = ctx, ty = ty, arg = strip_label(Array::get(args, at = 0)), off = off, st = st)
        } else {
          unsupported(off = off, reason = "only a call to a named function is provable")
          []
        },
        None => {
          unsupported(off = off, reason = "only a call to a named function is provable")
          []
        }
      }
    },
    ERecord(rname, fields, _) => match find_adt(adts = ctx.adts, name = rname) {
      Some(adt) => if adt.is_struct {
        sym_construct(ctx = ctx, adt = adt, ctor = Array::get(adt.ctors, at = 0), named = fields, args = [
        ], off = expr_off(e), st = st)
      } else {
        unsupported(off = expr_off(e), reason = "`\{rname}` is not a struct")
        []
      },
      None => {
        unsupported(off = expr_off(e), reason = "struct `\{rname}` is not a struct of this file whose fields are `Int`, `Bool`, or such a struct / enum")
        []
      }
    },
    EDot(x, field, off, _) => {
      let out: Array[Outcome] = []
      for o in sym(ctx = ctx, e = x, st = st) {
        if o.returned {
          Array::push(out, value = o)
        } else {
          match adt_of_sort(adts = ctx.adts, sort = o.sort) {
            Some(adt) => if adt.is_struct {
              let (_, fs) = Array::get(adt.ctors, at = 0)
              let mut found = false
              for f in fs {
                let (fname, fsort) = f
                if fname == field {
                  found = true
                  let t = "(\{sel_smt(adt = adt, ctor = Array::get(adt.ctors, at = 0), field = fname)} \{o.value})"
                  assume_range(ctx = ctx, term = t, sort = fsort, pc = o.pc)
                  Array::push(out, value = with_value(st = o, value = t, sort = fsort))
                } else {
                  ()
                }
              }
              if !found {
                unsupported(off = off, reason = "`\{adt.name}` has no field `\{field}`")
              } else {
                ()
              }
            } else {
              unsupported(off = off, reason = "a field read on the enum `\{adt.name}`")
            },
            None => unsupported(off = off, reason = "a field read on a `\{o.sort}`")
          }
        }
      }
      out
    },
    EArray(items) => sym_array_literal(ctx = ctx, items = items, off = expr_off(e), st = st),
    EMatch(scr, arms) => join_word_outcomes(outs = sym_match(ctx = ctx, scr = scr, arms = arms, off = expr_off(scr), st = st), off = expr_off(scr)),
    _ => {
      unsupported(off = expr_off(e), reason = "`\{construct_name(e)}` is outside the provable fragment")
      []
    }
  }
}

fn sym_binop(ctx: Ctx, e: Expr, op: String, l: Expr, r: Expr, off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let out: Array[Outcome] = []
  for lo in sym(ctx = ctx, e = l, st = st) {
    if lo.returned {
      Array::push(out, value = lo)
    } else if op == "&&" || op == "||" {
      if lo.sort != "Bool" {
        unsupported(off = off, reason = "`\{op}` on a `\{lo.sort}`")
      } else {
        ()
      }
      // Short-circuit: the right side runs only where it decides.
      let (stop_cond, stop_value, go_cond) = if op == "&&" {
        ("(not \{lo.value})", "false", lo.value)
      } else {
        (lo.value, "true", "(not \{lo.value})")
      }
      Array::push(out, value = with_value(st = with_pc(st = lo, cond = stop_cond), value = stop_value, sort = "Bool"))
      for ro in sym(ctx = ctx, e = r, st = with_pc(st = lo, cond = go_cond)) {
        Array::push(out, value = ro)
      }
      ()
    } else {
      for ro in sym(ctx = ctx, e = r, st = lo) {
        if ro.returned {
          Array::push(out, value = ro)
        } else {
          Array::push(out, value = binop_value(ctx = ctx, e = e, op = op, a = lo, b = ro, off = off))
        }
      }
      ()
    }
  }
  out
}

fn binop_value(ctx: Ctx, e: Expr, op: String, a: Outcome, b: Outcome, off: Int) -> Outcome with Exception {
  let ints = a.sort == "Int" && b.sort == "Int"
  if is_word_sort(a.sort) || is_word_sort(b.sort) {
    word_binop_value(ctx = ctx, e = e, op = op, a = a, b = b, off = off)
  } else if (op == "+" || op == "-" || op == "*") && ints {
    let t = "(\{op} \{a.value} \{b.value})"
    push_obligation(ctx = ctx, kind = "overflow", label = print_expr(e), off = off, goal = guarded(pc = b.pc, goal = in_range(t)))
    with_value(st = b, value = t, sort = "Int")
  } else if (op == "/" || op == "%") && ints {
    // Runtime `/` and `%` truncate toward zero (`-7 / 2 == -3`,
    // `-7 % 2 == -1`), and a zero divisor aborts, so a path continues past
    // the operator only where the divisor is not zero. SMT-LIB `div` is
    // Euclidean: the quotient is taken on a non-negative dividend and
    // negated back, and the remainder is what that quotient leaves.
    // `MIN / -1` leaves the range, so the result carries the overflow
    // obligation `+` / `-` / `*` do.
    let nonzero = "(not (= \{b.value} 0))"
    push_obligation(ctx = ctx, kind = "divisor", label = print_expr(e), off = off, goal = guarded(pc = b.pc, goal = nonzero))
    let st = with_pc(st = b, cond = nonzero)
    let q = trunc_div(a = a.value, b = b.value)
    let t = if op == "/" {
      q
    } else {
      "(- \{a.value} (* \{b.value} \{q}))"
    }
    push_obligation(ctx = ctx, kind = "overflow", label = print_expr(e), off = off, goal = guarded(pc = st.pc, goal = in_range(t)))
    with_value(st = st, value = t, sort = "Int")
  } else if (op == "<<" || op == ">>") && ints {
    // A shift by a constant count `k` in 0..62 is exact over the integers:
    // `x << k` is `x * 2^k` (its wrap is the overflow obligation) and the
    // arithmetic `x >> k` is the FLOORED quotient by `2^k`, which SMT-LIB
    // `div` computes for a positive divisor. Any other count answers
    // irregularly at run time (`1 << 63` is 0, so is `8 >> -1`) and is not
    // encoded.
    let k = shift_count(b.value)
    if k < 0 {
      unsupported(off = off, reason = "`\{op}` by a count that is not a constant from 0 to 62")
      b
    } else {
      let pow = pow2_text(k)
      if op == "<<" {
        let t = "(* \{a.value} \{pow})"
        push_obligation(ctx = ctx, kind = "overflow", label = print_expr(e), off = off, goal = guarded(pc = b.pc, goal = in_range(t)))
        with_value(st = b, value = t, sort = "Int")
      } else {
        with_value(st = b, value = "(div \{a.value} \{pow})", sort = "Int")
      }
    }
  } else if (op == "<" || op == "<=" || op == ">" || op == ">=") && ints {
    with_value(st = b, value = "(\{op} \{a.value} \{b.value})", sort = "Bool")
  } else if (op == "==" || op == "!=") && a.sort == arr_sort() {
    unsupported(off = off, reason = "`\{op}` on arrays: their contents past the length are not modelled, so equality is not encoded")
    b
  } else if (op == "==" || op == "!=") && a.sort == b.sort && a.sort != "Unit" && adt_has_custom_eq(adts = ctx.adts, sort = a.sort) {
    unsupported(off = off, reason = "`\{op}` on `\{smt_unquote(a.sort)}` calls a program-written `equals` (on that type or one it contains), which the prover does not read")
    b
  } else if (op == "==" || op == "!=") && a.sort == b.sort && a.sort != "Unit" {
    let eq = "(= \{a.value} \{b.value})"
    with_value(st = b, value = if op == "==" {
      eq
    } else {
      "(not \{eq})"
    }, sort = "Bool")
  } else {
    unsupported(off = off, reason = "`\{op}` on `\{a.sort}` and `\{b.sort}` is outside the provable fragment")
    b
  }
}

/// #3827: `a op b` where an operand is a 32-bit word. The other operand is a
/// word of the same type, or a literal written beside it, which the checker
/// typed as that word and keeps in range; any other `Int` beside a word is
/// refused rather than guessed. `/` and `%` owe a non-zero divisor, since
/// one aborts, and continue past it only where it is not zero; everything
/// else wraps as the runtime does, so no overflow is owed.
fn word_binop_value(ctx: Ctx, e: Expr, op: String, a: Outcome, b: Outcome, off: Int) -> Outcome with Exception {
  let sort = if is_word_sort(a.sort) {
    a.sort
  } else {
    b.sort
  }
  let av = word_operand(o = a, sort = sort, op = op, off = off)
  let bv = word_operand(o = b, sort = sort, op = op, off = off)
  let (t, rsort) = word_binop(op = op, sort = sort, a = av, b = bv)
  if t == "" {
    unsupported(off = off, reason = "`\{op}` on `\{sort}`")
    b
  } else if op == "/" || op == "%" {
    let nonzero = "(not (= \{bv} \{word_zero()}))"
    push_obligation(ctx = ctx, kind = "divisor", label = print_expr(e), off = off, goal = guarded(pc = b.pc, goal = nonzero))
    with_value(st = with_pc(st = b, cond = nonzero), value = t, sort = rsort)
  } else {
    with_value(st = b, value = t, sort = rsort)
  }
}

/// #3827: the paths of one `if` / `match` carry one type, which the checker
/// joins over its branches: `if c { x } else { 2147483647 }` is an `Int32`
/// when `x` is. A path's own sort says `Int` for the literal branch, so the
/// paths are re-read at the word one of them gives, as `adapt_word` reads a
/// literal; an `Int` there that is not a literal means the paths disagree
/// with the checker's type, which is refused rather than computed as an
/// unbounded `Int`.
fn join_word_outcomes(outs: Array[Outcome], off: Int) -> Array[Outcome] with Exception {
  let mut word = ""
  for o in outs {
    if !o.returned && is_word_sort(o.sort) {
      if word == "" {
        word = o.sort
      } else if word != o.sort {
        unsupported(off = off, reason = "branches that give both `\{word}` and `\{o.sort}`")
      } else {
        ()
      }
    } else {
      ()
    }
  }
  if word == "" {
    outs
  } else {
    let joined: Array[Outcome] = []
    for o in outs {
      if !o.returned && o.sort == "Int" {
        let w = adapt_word(value = o.value, sort = o.sort, want = word)
        if w == "" {
          unsupported(off = off, reason = "branches that give a `\{word}` and an `Int` that is not a literal")
        } else {
          ()
        }
        Array::push(joined, value = with_value(st = o, value = w, sort = word))
      } else {
        Array::push(joined, value = o)
      }
    }
    joined
  }
}

/// An operand of a word operator as a word of `sort`: itself, or a literal
/// written beside one.
fn word_operand(o: Outcome, sort: String, op: String, off: Int) -> String with Exception {
  let w = adapt_word(value = o.value, sort = o.sort, want = sort)
  if w == "" {
    unsupported(off = off, reason = "`\{op}` with a `\{sort}` and a `\{o.sort}` that is not a literal")
  } else {
    ()
  }
  w
}

/// #3827: `Int32::to_int` / `UInt32::to_int` / `Int::wrap_int32` /
/// `Int::wrap_uint32`, exact: a word read as the `Int` it holds, signed or
/// not, and an `Int` cut to its low 32 bits. `Int::to_int32` /
/// `Int::to_uint32` answer an `Option`, which is not modelled.
fn is_word_conversion(ctx: Ctx, fname: String, callee_off: Int) -> Bool {
  (fname == "Int32::to_int" || fname == "UInt32::to_int" || fname == "Int::wrap_int32" || fname == "Int::wrap_uint32") && (is_builtin_ref_offset(callee_off) || match find_sig(fns = ctx.fns, name = fname) {
    Some(_) => false,
    None => true
  })
}

fn sym_word_conversion(ctx: Ctx, fname: String, args: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  if Array::length(args) != 1 {
    unsupported(off = off, reason = "`\{fname}` with \{Array::length(args)} argument(s)")
  } else {
    ()
  }
  let (from, to) = if fname == "Int32::to_int" {
    ("Int32", "Int")
  } else if fname == "UInt32::to_int" {
    ("UInt32", "Int")
  } else if fname == "Int::wrap_int32" {
    ("Int", "Int32")
  } else {
    ("Int", "UInt32")
  }
  let out: Array[Outcome] = []
  let arg = strip_label(Array::get(args, at = 0))
  for o in sym(ctx = ctx, e = arg, st = st) {
    // A literal written as the word a conversion takes is that word.
    let word = adapt_word(value = o.value, sort = o.sort, want = from)
    if o.returned {
      Array::push(out, value = o)
    } else if word == "" {
      unsupported(off = off, reason = "`\{fname}` of a `\{o.sort}`")
    } else if to == "Int" {
      Array::push(out, value = with_value(st = o, value = word_to_int(sort = from, t = word), sort = "Int"))
    } else {
      Array::push(out, value = with_value(st = o, value = word_of_int(o.value), sort = to))
    }
  }
  out
}

/// #3827: `((__asc: T) -> __asc)(e)`, the parser's spelling of `let x: T =
/// e`, as `e` read at `T`: unchanged when the sorts agree, and a literal
/// written where a word is expected as that word. Anything else is refused.
fn ascription_type(_ callee: Expr) -> Option[TypeExpr] {
  match callee {
    EFn(tps, _, params, _, _, EIdent(body_name, _)) => if Array::length(tps) == 0 && Array::length(params) == 1 {
      let (pn, pty) = Array::get(params, at = 0)
      if pn == body_name && String::starts_with(pn, prefix = "__") {
        pty
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

fn sym_ascription(ctx: Ctx, ty: TypeExpr, arg: Expr, off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let want = sort_of(adts = ctx.adts, ty = Some(ty))
  let out: Array[Outcome] = []
  // `let xs: Array[Int] = []`: the annotation is what an empty literal lacks.
  let empty = match arg {
    EArray(items) => Array::length(items) == 0 && want == arr_sort(),
    _ => false
  }
  if empty {
    Array::push(out, value = with_value(st = st, value = "(|Array[Int]::mk| ((as const (Array Int Int)) 0) 0)", sort = arr_sort()))
    return out
  } else {
    ()
  }
  for o in sym(ctx = ctx, e = arg, st = st) {
    let w = adapt_word(value = o.value, sort = o.sort, want = want)
    if o.returned {
      Array::push(out, value = o)
    } else if w != "" {
      Array::push(out, value = with_value(st = o, value = w, sort = want))
    } else {
      unsupported(off = off, reason = "a `\{o.sort}` read as `\{print_type_expr(ty)}`")
    }
  }
  out
}

/// `x` once a scope opened at `outer` closes: the names it bound are gone,
/// and an assignment it made to an enclosing binding stays. Bindings are only
/// appended inside a scope and assignments replace in place, so the enclosing
/// names are exactly the first `outer` entries.
fn leave_scope(x: Outcome, outer: Array[(String, String, String)]) -> Outcome {
  Outcome::{
    pc: x.pc,
    value: x.value,
    sort: x.sort,
    returned: x.returned,
    env: Array::slice(x.env, start = 0, end = min_int(a = Array::length(outer), b = Array::length(x.env)))
  }
}

fn min_int(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

/// `env` with the innermost binding of `name` now holding `term`, or `None`
/// when nothing in scope has that name.
fn env_assign(env: Array[(String, String, String)], name: String, term: String, sort: String) -> Option[Array[(String, String, String)]] {
  let mut i = Array::length(env)
  let mut at = 0 - 1
  while i > 0 && at < 0 {
    i = i - 1
    let (n, _, _) = Array::get(env, at = i)
    if n == name {
      at = i
    } else {
      ()
    }
  }
  if at < 0 {
    None
  } else {
    let out = Array::slice(env, start = 0, end = Array::length(env))
    Array::set(out, at = at, value = (name, term, sort))
    Some(out)
  }
}

/// `name = v` followed by `c`: the assigned value replaces the binding, and
/// the rest of the path reads it.
fn sym_let(ctx: Ctx, name: String, v: Expr, b: Expr, st: Outcome) -> Array[Outcome] with Exception {
  let out: Array[Outcome] = []
  // `let xs = []` for an array the function writes: empty, whatever its
  // element type. Its elements only come from `Array::push`, which takes an
  // `Int` (an index write needs an index below the length), so reading it as
  // an `Array[Int]` cannot say anything false about another element type.
  let init = match v {
    EArray(items) => if Array::length(items) == 0 && contains_name(xs = ctx.writable, x = name) {
      [
        with_value(st = st, value = "(|Array[Int]::mk| ((as const (Array Int Int)) 0) 0)", sort = arr_sort())
      ]
    } else {
      sym(ctx = ctx, e = v, st = st)
    },
    _ => sym(ctx = ctx, e = v, st = st)
  }
  for o in init {
    if o.returned {
      Array::push(out, value = o)
    } else {
      let bound = Outcome::{
        pc: o.pc,
        value: "",
        sort: "Unit",
        returned: false,
        env: env_bind(env = o.env, name = name, term = o.value, sort = o.sort)
      }
      // The binding's scope ends with the `let`: what follows sees the
      // enclosing names again, with any assignment the body made to them.
      for x in sym(ctx = ctx, e = b, st = bound) {
        Array::push(out, value = leave_scope(x = x, outer = o.env))
      }
      ()
    }
  }
  out
}

fn sym_assign(ctx: Ctx, name: String, v: Expr, c: Expr, off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let out: Array[Outcome] = []
  for o in sym(ctx = ctx, e = v, st = st) {
    if o.returned {
      Array::push(out, value = o)
    } else {
      // #3827: a literal assigned to a word is that word.
      let (term, tsort) = match env_lookup(env = o.env, name = name) {
        Some((_, sort)) => {
          let w = adapt_word(value = o.value, sort = o.sort, want = sort)
          if w == "" {
            unsupported(off = off, reason = "`\{name}` is assigned a `\{o.sort}` where it holds a `\{sort}`")
            (o.value, o.sort)
          } else {
            (w, sort)
          }
        },
        None => {
          unsupported(off = off, reason = "`\{name}` is not a local of the provable fragment")
          (o.value, o.sort)
        }
      }
      match env_assign(env = o.env, name = name, term = term, sort = tsort) {
        Some(env) => for x in sym(ctx = ctx, e = c, st = Outcome::{
          pc: o.pc,
          value: "",
          sort: "Unit",
          returned: false,
          env: env
        }) {
          Array::push(out, value = x)
        },
        None => ()
      }
      ()
    }
  }
  out
}

/// A contracted `while`, read back from the parser's lowering (#3716): the
/// loop's condition and body, its `invariant` clauses and its one
/// `decreases` measure.
struct Loop {
  cond: Expr;
  body: Expr;
  invariants: Array[Expr];
  measure: Expr
}

/// The parser lowers `while c where { invariant: i.., decreases: m } { b }`
/// (`attach_while_contract`) to
/// `let mut S_dec_prev = 0; let mut S_dec_seen = false;
/// while { assert(i1); ..; let S_dec_now = m; <measure checks> ; c } { b }`,
/// each clause passed through an identity lambda over `__vibe_clause`. The
/// two cells are what makes the runtime check the measure; the prover reads
/// the clauses themselves, so the cells are not modelled.
fn contracted_loop_cells(name: String, inner: Expr) -> Option[Loop] {
  if String::starts_with(name, prefix = "__loop") && String::ends_with(name, suffix = "_dec_prev") {
    match inner {
      ELetMut(seen, EBool(false), EWhile(c, b), _) => if String::ends_with(seen, suffix = "_dec_seen") {
        decode_while(cond = c, body = b)
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

fn decode_while(cond: Expr, body: Expr) -> Option[Loop] {
  match cond {
    ESeq(checkpoint, c) => {
      let invariants: Array[Expr] = []
      match decode_checkpoint(e = checkpoint, invariants = invariants) {
        Some(m) => Some(Loop::{
          cond: c,
          body: body,
          invariants: invariants,
          measure: m
        }),
        None => None
      }
    },
    _ => None
  }
}

/// The invariants (collected into `invariants`) and the measure of a lowered
/// checkpoint; `None` when there is no measure or the shape is not the
/// lowering's.
fn decode_checkpoint(e: Expr, invariants: Array[Expr]) -> Option[Expr] {
  match decode_clauses(e = e, invariants = invariants) {
    Some(Some(m)) => Some(m),
    _ => None
  }
}

/// A lowered checkpoint (`contract_checkpoint`): `Some(measure)` once the
/// invariants are collected into `invariants`, the measure `None` when the
/// loop has none; `None` when the shape is not the lowering's.
fn decode_clauses(e: Expr, invariants: Array[Expr]) -> Option[Option[Expr]] {
  match e {
    ESeq(ECall(EIdent("assert", _), args, _, _), rest) => if Array::length(args) == 1 {
      match typed_clause_arg(Array::get(args, at = 0)) {
        Some(inv) => {
          Array::push(invariants, value = inv)
          decode_clauses(e = rest, invariants = invariants)
        },
        None => None
      }
    } else {
      None
    },
    ELet(now, v, _, _) => if String::ends_with(now, suffix = "_dec_now") {
      match typed_clause_arg(v) {
        Some(m) => Some(Some(m)),
        None => None
      }
    } else {
      None
    },
    EUnit => Some(None),
    _ => None
  }
}

/// The clause inside `((__vibe_clause: T) -> __vibe_clause)(clause)`.
fn typed_clause_arg(_ e: Expr) -> Option[Expr] {
  match e {
    ECall(EFn(_, _, params, _, _, EIdent("__vibe_clause", _)), args, _, _) => if Array::length(params) == 1 && Array::length(args) == 1 {
      Some(Array::get(args, at = 0))
    } else {
      None
    },
    _ => None
  }
}

/// A contracted loop, proved by induction. The invariants and the measure's
/// `>= 0` are owed on entry. Then every binding the body assigns takes a
/// fresh value, which stands for the state at an arbitrary checkpoint where
/// the invariants hold and the measure `m0` is `>= 0`. One iteration from
/// there, wherever it ends normally, owes the invariants again and a measure
/// in `0 <= m < m0`, which is what bounds the iteration count. The path past
/// the loop is that same arbitrary state with the condition false. A `return`
/// inside the body leaves the function as it does anywhere.
fn sym_loop(ctx: Ctx, lp: Loop, st: Outcome) -> Array[Outcome] with Exception {
  let out: Array[Outcome] = []
  // A clause is read as a formula, so an assignment inside one would be
  // dropped while the runtime performs it.
  let clause_writes: Array[String] = []
  for inv in lp.invariants {
    collect_assigned(e = inv, out = clause_writes)
  }
  collect_assigned(e = lp.measure, out = clause_writes)
  if Array::length(clause_writes) > 0 {
    unsupported(off = expr_off(lp.measure), reason = "a loop's `invariant` or `decreases` clause assigns `\{Array::get(clause_writes, at = 0)}`")
  } else {
    ()
  }
  for inv in lp.invariants {
    push_obligation(ctx = ctx, kind = "invariant-entry", label = print_expr(inv), off = expr_off(inv), goal = clause_formula(ctx = ctx, clause = inv, state = st))
  }
  let m_entry = single_int(ctx = ctx, e = lp.measure, st = st)
  push_obligation(ctx = ctx, kind = "measure-entry", label = print_expr(lp.measure), off = expr_off(lp.measure), goal = guarded(pc = st.pc, goal = "(>= \{m_entry} 0)"))
  // The arbitrary checkpoint. The condition runs after it on every
  // iteration, so what the condition assigns varies too.
  let assigned: Array[String] = []
  collect_assigned(e = lp.cond, out = assigned)
  collect_assigned(e = lp.body, out = assigned)
  let h = Outcome::{
    pc: st.pc,
    value: "",
    sort: "Unit",
    returned: false,
    env: havoc_assigned(ctx = ctx, names = assigned, st = st)
  }
  for inv in lp.invariants {
    Array::push(ctx.assumes, value = clause_formula(ctx = ctx, clause = inv, state = h))
  }
  let m0 = single_int(ctx = ctx, e = lp.measure, st = h)
  Array::push(ctx.assumes, value = guarded(pc = st.pc, goal = "(>= \{m0} 0)"))
  for c in sym(ctx = ctx, e = lp.cond, st = h) {
    if is_loop_jump(c) {
      unsupported(off = expr_off(lp.cond), reason = "a `break` / `continue` in a loop condition")
    } else if c.returned {
      Array::push(out, value = c)
    } else if c.sort != "Bool" {
      unsupported(off = expr_off(lp.cond), reason = "a loop condition must be a `Bool`")
    } else {
      for b in sym(ctx = ctx, e = lp.body, st = with_pc(st = c, cond = c.value)) {
        if b.returned && b.sort == loop_break() {
          // `break` leaves without a checkpoint: the path past the loop is
          // the state it broke in, and owes nothing here.
          let left = leave_scope(x = b, outer = h.env)
          Array::push(out, value = Outcome::{
            pc: left.pc,
            value: "true",
            sort: "Unit",
            returned: false,
            env: left.env
          })
        } else if b.returned && b.sort != loop_continue() {
          Array::push(out, value = b)
        } else {
          // The end of the body, or a `continue`: the condition runs again,
          // and with it the checkpoint. A `continue` is consumed here, so the
          // checkpoint starts from an ordinary, uninterrupted path.
          let left = leave_scope(x = b, outer = h.env)
          let after = Outcome::{
            pc: left.pc,
            value: "true",
            sort: "Unit",
            returned: false,
            env: left.env
          }
          for inv in lp.invariants {
            push_obligation(ctx = ctx, kind = "invariant", label = print_expr(inv), off = expr_off(inv), goal = clause_formula(ctx = ctx, clause = inv, state = after))
          }
          let m1 = single_int(ctx = ctx, e = lp.measure, st = after)
          push_obligation(ctx = ctx, kind = "measure", label = print_expr(lp.measure), off = expr_off(lp.measure), goal = guarded(pc = after.pc, goal = "(and (>= \{m1} 0) (< \{m1} \{m0}))"))
        }
      }
      let exit = with_pc(st = c, cond = "(not \{c.value})")
      Array::push(out, value = with_value(st = leave_scope(x = exit, outer = h.env), value = "true", sort = "Unit"))
    }
  }
  out
}

fn loop_break() -> String {
  "__break"
}

fn loop_continue() -> String {
  "__continue"
}

/// A path that left the iteration by `break` / `continue` (`kind`).
fn loop_jump(st: Outcome, kind: String) -> Outcome {
  Outcome::{ pc: st.pc, value: "true", sort: kind, returned: true, env: st.env }
}

fn is_loop_jump(_ o: Outcome) -> Bool {
  o.returned && (o.sort == loop_break() || o.sort == loop_continue())
}

/// `st`'s bindings with each of `names` given a fresh value of its sort: the
/// state at an arbitrary checkpoint of a loop that assigns them.
fn havoc_assigned(ctx: Ctx, names: Array[String], st: Outcome) -> Array[(String, String, String)] {
  let mut env = st.env
  for name in names {
    match env_lookup(env = env, name = name) {
      Some((_, sort)) => {
        let t = fresh(ctx = ctx, sort = sort)
        assume_range(ctx = ctx, term = t, sort = sort, pc = st.pc)
        match env_assign(env = env, name = name, term = t, sort = sort) {
          Some(e2) => env = e2,
          None => ()
        }
      },
      None => ()
    }
  }
  env
}

/// A `for` over an `Array[Int]`, with the clauses of its contract
/// (`invariants` empty and `measure` `None` without one). `check` names the
/// lowering's checkpoint closure, `""` for a `for` without a contract.
struct ForLoop {
  value_name: String;
  index_name: Option[String];
  iterable: Expr;
  body: Expr;
  check: String;
  invariants: Array[Expr];
  measure: Option[Expr]
}

/// The parser lowers `for x in xs where { .. } { b }` (`attach_for_contract`)
/// to `let S_check = () -> <checkpoint>; S_check();
/// for x in xs { let S_body = b'; S_check(); S_body }`, where `b'` is `b`
/// with `S_check()` before each `continue` of this loop; with a `decreases`
/// clause, inside the two measure cells `contracted_loop_cells` names.
fn contracted_for(name: String, lam: Expr, inner: Expr) -> Option[ForLoop] {
  if String::starts_with(name, prefix = "__loop") && String::ends_with(name, suffix = "_check") {
    match (lam, inner) {
      (EFn(_, _, params, _, _, checkpoint), ESeq(ECall(EIdent(c1, _), a1, _, _), EForIn(v, i, it, ELet(bv, body, ESeq(ECall(EIdent(c2, _), a2, _, _), EIdent(bv2, _)), _), _))) => if Array::length(params) == 0 && c1 == name && c2 == name && bv2 == bv && Array::length(a1) == 0 && Array::length(a2) == 0 {
        let invariants: Array[Expr] = []
        match decode_clauses(e = checkpoint, invariants = invariants) {
          Some(measure) => Some(ForLoop::{
            value_name: v,
            index_name: i,
            iterable: it,
            body: body,
            check: name,
            invariants: invariants,
            measure: measure
          }),
          None => None
        }
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

/// A contracted `for` with a `decreases` measure, inside its measure cells.
fn contracted_for_cells(name: String, inner: Expr) -> Option[ForLoop] {
  if String::starts_with(name, prefix = "__loop") && String::ends_with(name, suffix = "_dec_prev") {
    match inner {
      ELetMut(seen, EBool(false), ELet(check, lam, b, _), _) => if String::ends_with(seen, suffix = "_dec_seen") {
        contracted_for(name = check, lam = lam, inner = b)
      } else {
        None
      },
      _ => None
    }
  } else {
    None
  }
}

/// A `for` over an `Array[Int]`, proved by induction like a `while`
/// (`sym_loop`). The checkpoint runs before the iterand is evaluated, then
/// after every iteration, one ended by `continue` included. The arbitrary
/// checkpoint is a state where every binding the body assigns has a fresh
/// value, the invariants hold, and the measure is `>= 0`; an iteration from
/// there reads the element at some index `0 <= k < length`, and wherever it
/// ends normally owes the invariants and a smaller measure. The clauses
/// cannot name the element or the index (they are read in the loop's scope),
/// so `k` is otherwise free. The path past the loop is that arbitrary state.
/// The value of the `for` is `Unit`: an array a `for` collects is not
/// modelled, and nothing reads a `Unit` as one.
fn sym_for(ctx: Ctx, fl: ForLoop, st: Outcome) -> Array[Outcome] with Exception {
  let out: Array[Outcome] = []
  let clause_writes: Array[String] = []
  for inv in fl.invariants {
    collect_assigned(e = inv, out = clause_writes)
  }
  match fl.measure {
    Some(m) => collect_assigned(e = m, out = clause_writes),
    None => ()
  }
  if Array::length(clause_writes) > 0 {
    unsupported(off = expr_off(fl.iterable), reason = "a loop's `invariant` or `decreases` clause assigns `\{Array::get(clause_writes, at = 0)}`")
  } else {
    ()
  }
  let contracted = Array::length(fl.invariants) > 0 || match fl.measure {
    Some(_) => true,
    None => false
  }
  if contracted {
    // The entry checkpoint runs before the iterand, so the first iteration
    // starts from the state the iterand leaves.
    let iterand_writes: Array[String] = []
    collect_assigned(e = fl.iterable, out = iterand_writes)
    if Array::length(iterand_writes) > 0 {
      unsupported(off = expr_off(fl.iterable), reason = "the iterand of a contracted `for` assigns `\{Array::get(iterand_writes, at = 0)}`")
    } else {
      ()
    }
  } else {
    ()
  }
  if fl.check != "" {
    Array::push(ctx.checkpoints, value = fl.check)
  } else {
    ()
  }
  for inv in fl.invariants {
    push_obligation(ctx = ctx, kind = "invariant-entry", label = print_expr(inv), off = expr_off(inv), goal = clause_formula(ctx = ctx, clause = inv, state = st))
  }
  match fl.measure {
    Some(m) => {
      let m_entry = single_int(ctx = ctx, e = m, st = st)
      push_obligation(ctx = ctx, kind = "measure-entry", label = print_expr(m), off = expr_off(m), goal = guarded(pc = st.pc, goal = "(>= \{m_entry} 0)"))
    },
    None => ()
  }
  for o in sym(ctx = ctx, e = fl.iterable, st = st) {
    if o.returned {
      // A `return`, or a `break` / `continue` of an enclosing loop.
      Array::push(out, value = o)
    } else if o.sort != arr_sort() {
      unsupported(off = expr_off(fl.iterable), reason = "a `for` over a `\{smt_unquote(o.sort)}`: only an `Array[Int]` iterand is modelled")
    } else {
      let assigned: Array[String] = []
      collect_assigned(e = fl.body, out = assigned)
      let h = Outcome::{
        pc: o.pc,
        value: "",
        sort: "Unit",
        returned: false,
        env: havoc_assigned(ctx = ctx, names = assigned, st = o)
      }
      for inv in fl.invariants {
        Array::push(ctx.assumes, value = clause_formula(ctx = ctx, clause = inv, state = h))
      }
      let m0 = match fl.measure {
        Some(m) => {
          let t = single_int(ctx = ctx, e = m, st = h)
          Array::push(ctx.assumes, value = guarded(pc = h.pc, goal = "(>= \{t} 0)"))
          t
        },
        None => ""
      }
      let k = fresh(ctx = ctx, sort = "Int")
      let iter = with_pc(st = h, cond = "(and (<= 0 \{k}) (< \{k} \{arr_len(o.value)}))")
      let elem = "(select \{arr_data(o.value)} \{k})"
      assume_range(ctx = ctx, term = elem, sort = "Int", pc = iter.pc)
      let with_elem = env_bind(env = iter.env, name = fl.value_name, term = elem, sort = "Int")
      let body_env = match fl.index_name {
        Some(i) => env_bind(env = with_elem, name = i, term = k, sort = "Int"),
        None => with_elem
      }
      let entered = Outcome::{
        pc: iter.pc,
        value: "",
        sort: "Unit",
        returned: false,
        env: body_env
      }
      for b in sym(ctx = ctx, e = fl.body, st = entered) {
        if b.returned && b.sort == loop_break() {
          let left = leave_scope(x = b, outer = h.env)
          Array::push(out, value = Outcome::{
            pc: left.pc,
            value: "true",
            sort: "Unit",
            returned: false,
            env: left.env
          })
        } else if b.returned && b.sort != loop_continue() {
          Array::push(out, value = b)
        } else {
          let left = leave_scope(x = b, outer = h.env)
          let after = Outcome::{
            pc: left.pc,
            value: "true",
            sort: "Unit",
            returned: false,
            env: left.env
          }
          for inv in fl.invariants {
            push_obligation(ctx = ctx, kind = "invariant", label = print_expr(inv), off = expr_off(inv), goal = clause_formula(ctx = ctx, clause = inv, state = after))
          }
          match fl.measure {
            Some(m) => {
              let m1 = single_int(ctx = ctx, e = m, st = after)
              push_obligation(ctx = ctx, kind = "measure", label = print_expr(m), off = expr_off(m), goal = guarded(pc = after.pc, goal = "(and (>= \{m1} 0) (< \{m1} \{m0}))"))
            },
            None => ()
          }
        }
      }
      Array::push(out, value = with_value(st = h, value = "true", sort = "Unit"))
    }
  }
  out
}

/// The one value an `Int` clause has from `st`; a clause that forks the path
/// or is not an `Int` is unsupported.
fn single_int(ctx: Ctx, e: Expr, st: Outcome) -> String with Exception {
  let outs = sym(ctx = ctx, e = e, st = st)
  if Array::length(outs) != 1 || Array::get(outs, at = 0).sort != "Int" || Array::get(outs, at = 0).returned {
    unsupported(off = expr_off(e), reason = "a `decreases` measure must be one `Int` expression without branches")
    ""
  } else {
    Array::get(outs, at = 0).value
  }
}

/// Whether a call of `fname` is the builtin array read. These names can be
/// shadowed: a program's own `fn Array::length` (or a local of the name) is
/// what a direct call reaches, so it goes through `sym_call` like any other
/// function. `xs[i]` is the parser's `__index` with a bracket key
/// (`index_site_key`), which stays the builtin read whatever the program
/// declares; a written `__index(..)` is an ordinary call.
fn is_builtin_array_read(ctx: Ctx, st: Outcome, fname: String, callee_off: Int) -> Bool {
  let builtin_name = fname == "Array::length" || fname == "Array::get" || fname == "__index"
  let shadowed = match find_sig(fns = ctx.fns, name = fname) {
    Some(_) => true,
    None => match env_lookup(env = st.env, name = fname) {
      Some(_) => true,
      None => false
    }
  }
  if !builtin_name {
    false
  } else if fname == "__index" {
    index_site_offset(callee_off) >= 0
  } else {
    !shadowed
  }
}

/// `Array::length(xs)`, and `Array::get(xs, at = i)` / `xs[i]`: a read owes
/// `0 <= i < length`, since an index outside it aborts, and the path past it
/// assumes that; the element read is an `Int` in range.
fn sym_array_read(ctx: Ctx, e: Expr, fname: String, args: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let want = if fname == "Array::length" {
    1
  } else {
    2
  }
  if Array::length(args) != want {
    unsupported(off = off, reason = "`\{fname}` with \{Array::length(args)} argument(s)")
  } else {
    ()
  }
  let out: Array[Outcome] = []
  for o in sym(ctx = ctx, e = strip_label(Array::get(args, at = 0)), st = st) {
    if o.returned {
      Array::push(out, value = o)
    } else if o.sort != arr_sort() {
      unsupported(off = off, reason = "`\{fname}` on a `\{o.sort}`: only `Array[Int]` is modelled")
    } else if want == 1 {
      Array::push(out, value = with_value(st = o, value = arr_len(o.value), sort = "Int"))
    } else {
      for p in sym(ctx = ctx, e = strip_label(Array::get(args, at = 1)), st = o) {
        if p.returned {
          Array::push(out, value = p)
        } else if p.sort != "Int" {
          unsupported(off = off, reason = "an array index that is a `\{p.sort}`")
        } else {
          // The read sees the array as the index left it: an index that
          // writes a local array has already done so (`writable_arrays`).
          let arr = match strip_label(Array::get(args, at = 0)) {
            EIdent(n, _) => if contains_name(xs = ctx.writable, x = n) {
              match env_lookup(env = p.env, name = n) {
                Some((t, _)) => t,
                None => o.value
              }
            } else {
              o.value
            },
            _ => o.value
          }
          let inside = "(and (<= 0 \{p.value}) (< \{p.value} \{arr_len(arr)}))"
          let label = if fname == "__index" {
            "\{print_expr(strip_label(Array::get(args, at = 0)))}[\{print_expr(strip_label(Array::get(args, at = 1)))}]"
          } else {
            print_expr(e)
          }
          push_obligation(ctx = ctx, kind = "index", label = label, off = off, goal = guarded(pc = p.pc, goal = inside))
          let q = with_pc(st = p, cond = inside)
          let v = "(select \{arr_data(arr)} \{p.value})"
          assume_range(ctx = ctx, term = v, sort = "Int", pc = q.pc)
          Array::push(out, value = with_value(st = q, value = v, sort = "Int"))
        }
      }
      ()
    }
  }
  out
}

//# Quantifiers (#3719)

/// Whether a call of `fname` is the builtin `Array::all` / `Array::any`, or
/// `@vibe/builtin`'s `Int::range_all` / `Int::range_any` imported as such
/// (by name or with the `Int` namespace),
/// unless the file declares a function of the name or binds a local to it.
fn is_quantifier_call(ctx: Ctx, st: Outcome, fname: String) -> Bool {
  (fname == "Array::all" || fname == "Array::any" || (fname == "Int::range_all" || fname == "Int::range_any") && (contains_name(xs = ctx.builtins, x = fname) || contains_name(xs = ctx.builtins, x = "Int"))) && match find_sig(fns = ctx.fns, name = fname) {
    Some(_) => false,
    None => match env_lookup(env = st.env, name = fname) {
      Some(_) => false,
      None => true
    }
  }
}

/// `Array::all(xs, f = (x) -> p)` as `(forall ((q Int)) (=> (and (<= 0 q)
/// (< q len)) p[x := xs[q]]))`, and `Array::any` as the `exists`, so a
/// contract states a property of every element without a new spelling: at
/// run time the call is the same function. The predicate is a one-parameter
/// lambda written at the call; one that returns, assigns, writes an array or
/// calls a function (whose fresh result would be one value for every
/// element) is refused. What its body owes or assumes is quantified the
/// same way: owing it for an element the call stops before is stronger than
/// the runtime needs, never weaker. `Int::range_all(lo, hi, f = (i) -> p)`
/// quantifies `i` itself over `lo <= i < hi`, which states what an element
/// owes its neighbour (`xs[i] <= xs[i + 1]`).
fn sym_quantifier(ctx: Ctx, fname: String, args: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let ranged = String::starts_with(fname, prefix = "Int::")
  let arity = if ranged {
    3
  } else {
    2
  }
  if Array::length(args) != arity {
    unsupported(off = off, reason = "`\{fname}` with \{Array::length(args)} argument(s)")
  } else {
    ()
  }
  let (pname, body) = match strip_label(Array::get(args, at = arity - 1)) {
    EFn(tps, _, params, _, _, b) => if Array::length(tps) == 0 && Array::length(params) == 1 {
      let (pn, pty) = Array::get(params, at = 0)
      match pty {
        None => (),
        Some(_) => if sort_of(adts = ctx.adts, ty = pty) != "Int" {
          unsupported(off = off, reason = "`\{fname}`'s predicate takes an `Int`")
        } else {
          ()
        }
      }
      (pn, b)
    } else {
      unsupported(off = off, reason = "`\{fname}`'s predicate must take one parameter")
      ("", b)
    },
    _ => {
      unsupported(off = off, reason = "`\{fname}`'s predicate must be a lambda written at the call")
      ("", EBool(true))
    }
  }
  let assigned: Array[String] = []
  collect_assigned(e = body, out = assigned)
  array_write_targets(ctx = ctx, e = body, out = assigned)
  if Array::length(assigned) > 0 {
    unsupported(off = off, reason = "`\{fname}`'s predicate assigns `\{Array::get(assigned, at = 0)}`")
  } else {
    ()
  }
  let out: Array[Outcome] = []
  for o in sym(ctx = ctx, e = strip_label(Array::get(args, at = 0)), st = st) {
    if o.returned {
      Array::push(out, value = o)
    } else if ranged {
      for h in sym(ctx = ctx, e = strip_label(Array::get(args, at = 1)), st = o) {
        if h.returned {
          Array::push(out, value = h)
        } else if o.sort != "Int" || h.sort != "Int" {
          unsupported(off = off, reason = "`\{fname}`'s bounds must be `Int`s")
        } else {
          let q = fresh_bound(ctx)
          let range = "(and (<= \{o.value} \{q}) (< \{q} \{h.value}))"
          Array::push(out, value = with_value(st = h, value = quantified(ctx = ctx, fname = fname, pname = pname, body = body, off = off, o = h, q = q, range = range, elem = q), sort = "Bool"))
        }
      }
      ()
    } else if o.sort != arr_sort() {
      unsupported(off = off, reason = "`\{fname}` on a `\{o.sort}`: only `Array[Int]` is modelled")
    } else {
      let q = fresh_bound(ctx)
      let range = "(and (<= 0 \{q}) (< \{q} \{arr_len(o.value)}))"
      let elem = "(select \{arr_data(o.value)} \{q})"
      Array::push(out, value = with_value(st = o, value = quantified(ctx = ctx, fname = fname, pname = pname, body = body, off = off, o = o, q = q, range = range, elem = elem), sort = "Bool"))
    }
  }
  out
}

/// A bound variable no other quantifier of the function spells.
fn fresh_bound(_ ctx: Ctx) -> String {
  let k = Array::get(ctx.counter, at = 0)
  Array::set(ctx.counter, at = 0, value = k + 1)
  "|q!\{k}|"
}

/// The quantified formula of one call from the state `o`: `q` ranges over
/// `range` and the predicate's parameter is `elem`. What the predicate owes
/// or assumes, an element's range among them, is quantified the same way.
fn quantified(ctx: Ctx, fname: String, pname: String, body: Expr, off: Int, o: Outcome, q: String, range: String, elem: String) -> String with Exception {
  let n_decls = Array::length(ctx.decls)
  let n_pending = Array::length(ctx.pending)
  let n_assumes = Array::length(ctx.assumes)
  assume_range(ctx = ctx, term = elem, sort = "Int", pc = o.pc)
  let inner = Outcome::{
    pc: o.pc,
    value: "true",
    sort: "Unit",
    returned: false,
    env: env_bind(env = o.env, name = pname, term = elem, sort = "Int")
  }
  let parts: Array[String] = []
  for b in sym(ctx = ctx, e = body, st = inner) {
    if b.returned {
      unsupported(off = off, reason = "a `return` inside `\{fname}`'s predicate")
    } else if b.sort != "Bool" {
      unsupported(off = off, reason = "`\{fname}`'s predicate must be a `Bool`")
    } else {
      // The conditions the predicate's own branches added: its paths
      // partition the state the call started from.
      let conds = Array::slice(b.pc, start = Array::length(o.pc), end = Array::length(b.pc))
      Array::push(parts, value = if Array::length(conds) == 0 {
        b.value
      } else {
        "(and \{String::join(conds, sep = " ")} \{b.value})"
      })
    }
  }
  if Array::length(ctx.decls) != n_decls {
    unsupported(off = off, reason = "a call inside `\{fname}`'s predicate: its result would be one value for every element")
  } else {
    ()
  }
  let mut i = n_pending
  while i < Array::length(ctx.pending) {
    let (pk, pl, po, pg, pn) = Array::get(ctx.pending, at = i)
    Array::set(ctx.pending, at = i, value = (pk, pl, po, "(forall ((\{q} Int)) (=> \{range} \{pg}))", pn))
    i = i + 1
  }
  let mut j = n_assumes
  while j < Array::length(ctx.assumes) {
    Array::set(ctx.assumes, at = j, value = "(forall ((\{q} Int)) (=> \{range} \{Array::get(ctx.assumes, at = j)}))")
    j = j + 1
  }
  let p = if Array::length(parts) == 1 {
    Array::get(parts, at = 0)
  } else {
    "(or false \{String::join(parts, sep = " ")})"
  }
  if fname == "Array::all" || fname == "Int::range_all" {
    "(forall ((\{q} Int)) (=> \{range} \{p}))"
  } else {
    "(exists ((\{q} Int)) (and \{range} \{p}))"
  }
}

//# Array writes

/// Whether a call of `fname` is the builtin `Array::set` / `Array::push`:
/// an index write (`xs[i] = v`) always is, and a written call is unless the
/// program declares a function of that name.
fn is_array_write_name(ctx: Ctx, fname: String, callee_off: Int) -> Bool {
  (fname == "Array::set" || fname == "Array::push") && (is_builtin_ref_offset(callee_off) || match find_sig(fns = ctx.fns, name = fname) {
    Some(_) => false,
    None => true
  })
}

/// Whether a call of `fname` is a builtin array read or write, judged
/// without the environment (a local cannot be named `Array::..`).
fn is_array_op_name(ctx: Ctx, fname: String, callee_off: Int) -> Bool {
  if fname == "__index" {
    index_site_offset(callee_off) >= 0
  } else {
    // `Array::all` / `Array::any` read the array's current value, as a quantifier
    // over its elements: a written local may be the subject (#3719).
    (fname == "Array::get" || fname == "Array::length" || fname == "Array::set" || fname == "Array::push" || fname == "Array::all" || fname == "Array::any") && (is_builtin_ref_offset(callee_off) || match find_sig(fns = ctx.fns, name = fname) {
      Some(_) => false,
      None => true
    })
  }
}

/// The arrays `body` writes, each checked to be one the prover can update
/// in place: a local bound once, by `let` or `let mut`, to an array literal,
/// and otherwise named only as the array a builtin read or write takes. A
/// second name for it (`let ys = xs`, a reassignment, an argument, the
/// iterand of a `for`) would see the write while the prover updates one
/// binding, and a parameter's caller would see it too, so each is
/// unsupported.
fn writable_arrays(ctx: Ctx, params: Array[(String, Option[TypeExpr])], body: Expr) -> Array[String] with Exception {
  let targets: Array[String] = []
  array_write_targets(ctx = ctx, e = body, out = targets)
  for n in targets {
    for p in params {
      let (pn, _) = p
      if pn == n {
        unsupported(off = 0 - 1, reason = "a write to the parameter `\{n}`, which its caller holds: only a local array is written")
      } else {
        ()
      }
    }
    let inits: Array[Option[Expr]] = []
    binder_inits(e = body, name = n, out = inits)
    let literal = Array::length(inits) == 1 && match Array::get(inits, at = 0) {
      Some(v) => is_array_literal(v),
      None => false
    }
    if !literal {
      unsupported(off = 0 - 1, reason = "a write to `\{n}`, which is not bound exactly once, by `let`, to an array literal")
    } else {
      ()
    }
    match array_use_violation(ctx = ctx, e = body, name = n) {
      Some(why) => unsupported(off = 0 - 1, reason = "`\{n}` is written, and \{why}: a written array is named only as the array of `Array::get`, `Array::length`, `xs[i]`, `Array::set`, `Array::push`, `Array::all` or `Array::any`"),
      None => ()
    }
  }
  targets
}

fn array_write_targets(ctx: Ctx, e: Expr, out: Array[String]) -> Unit with Exception {
  match e {
    ECall(EIdent(f, coff), args, off, _) => if is_array_write_name(ctx = ctx, fname = f, callee_off = coff) {
      let target = if Array::length(args) > 0 {
        strip_label(Array::get(args, at = 0))
      } else {
        EUnit
      }
      match target {
        EIdent(n, _) => if contains_name(xs = out, x = n) {
          ()
        } else {
          Array::push(out, value = n)
        },
        _ => unsupported(off = off, reason = "`\{f}` on an array that is not named by a local")
      }
    } else {
      ()
    },
    _ => ()
  }
  for k in expr_kids(e) {
    array_write_targets(ctx = ctx, e = k, out = out)
  }
  ()
}

/// The first use of `name` in `e` other than as the array of a builtin read
/// or write, described for the diagnostic.
fn array_use_violation(ctx: Ctx, e: Expr, name: String) -> Option[String] {
  match e {
    EIdent(m, _) => if m == name {
      Some("is also used as a value")
    } else {
      None
    },
    EAssign(m, _, _, _) => if m == name {
      Some("is also reassigned")
    } else {
      first_use_violation(ctx = ctx, es = expr_kids(e), name = name)
    },
    EAssignOp(m, _, _, _, _) => if m == name {
      Some("is also reassigned")
    } else {
      first_use_violation(ctx = ctx, es = expr_kids(e), name = name)
    },
    ECall(EIdent(f, coff), args, _, _) => if is_array_op_name(ctx = ctx, fname = f, callee_off = coff) && Array::length(args) > 0 && match strip_label(Array::get(args, at = 0)) {
      EIdent(m, _) => m == name,
      _ => false
    } {
      first_use_violation(ctx = ctx, es = Array::slice(args, start = 1, end = Array::length(args)), name = name)
    } else {
      first_use_violation(ctx = ctx, es = expr_kids(e), name = name)
    },
    _ => first_use_violation(ctx = ctx, es = expr_kids(e), name = name)
  }
}

fn first_use_violation(ctx: Ctx, es: Array[Expr], name: String) -> Option[String] {
  let mut found: Option[String] = None
  for x in es {
    match found {
      Some(_) => (),
      None => found = array_use_violation(ctx = ctx, e = x, name = name)
    }
  }
  found
}

/// `Array::set(xs, at = i, value = v)` / `xs[i] = v` owes `0 <= i < length`,
/// as an index outside it aborts, and `Array::push(xs, value = v)` appends;
/// either replaces the one binding of `xs` (`writable_arrays`). The
/// arguments are evaluated in the order written, which is the order the
/// labels take here (a reordering one is unsupported).
fn sym_array_write(ctx: Ctx, e: Expr, fname: String, args: Array[Expr], off: Int, indexed: Bool, st: Outcome) -> Array[Outcome] with Exception {
  let labels = if fname == "Array::set" {
    ["at", "value"]
  } else {
    ["value"]
  }
  if Array::length(args) != Array::length(labels) + 1 {
    unsupported(off = off, reason = "`\{fname}` with \{Array::length(args)} argument(s)")
  } else {
    ()
  }
  let mut k = 0
  for want in labels {
    k = k + 1
    match Array::get(args, at = k) {
      ELabeledArg(l, _, _) => if l != want {
        unsupported(off = off, reason = "`\{fname}` with its arguments in another order than `\{String::join(labels, sep = ", ")}`")
      } else {
        ()
      },
      _ => ()
    }
  }
  let name = match strip_label(Array::get(args, at = 0)) {
    EIdent(n, _) => n,
    _ => ""
  }
  if !contains_name(xs = ctx.writable, x = name) {
    unsupported(off = off, reason = "`\{fname}` on an array that is not a written local")
  } else {
    ()
  }
  let out: Array[Outcome] = []
  for a in sym(ctx = ctx, e = strip_label(Array::get(args, at = 0)), st = st) {
    if a.returned {
      Array::push(out, value = a)
    } else if a.sort != arr_sort() {
      unsupported(off = off, reason = "`\{fname}` on a `\{smt_unquote(a.sort)}`: only `Array[Int]` is modelled")
    } else {
      // The index (for `Array::set`), then the value.
      let idx_states: Array[Outcome] = if fname == "Array::set" {
        sym(ctx = ctx, e = strip_label(Array::get(args, at = 1)), st = a)
      } else {
        [with_value(st = a, value = "", sort = "Int")]
      }
      for p in idx_states {
        if p.returned {
          Array::push(out, value = p)
        } else if p.sort != "Int" {
          unsupported(off = off, reason = "an array index that is a `\{p.sort}`")
        } else {
          let index = p.value
          for q in sym(ctx = ctx, e = strip_label(Array::get(args, at = Array::length(args) - 1)), st = p) {
            if q.returned {
              Array::push(out, value = q)
            } else if q.sort != "Int" {
              unsupported(off = off, reason = "`\{fname}` of a `\{q.sort}` into an `Array[Int]`")
            } else {
              // The write lands on the array as the arguments left it: an
              // index or value that writes it too has already done so.
              let current = match env_lookup(env = q.env, name = name) {
                Some((t, _)) => t,
                None => a.value
              }
              let len = arr_len(current)
              let index = if fname == "Array::set" {
                index
              } else {
                len
              }
              let state = if fname == "Array::set" {
                let inside = "(and (<= 0 \{index}) (< \{index} \{len}))"
                let label = if indexed {
                  "\{print_expr(strip_label(Array::get(args, at = 0)))}[\{print_expr(strip_label(Array::get(args, at = 1)))}]"
                } else {
                  print_expr(e)
                }
                push_obligation(ctx = ctx, kind = "index", label = label, off = off, goal = guarded(pc = q.pc, goal = inside))
                with_pc(st = q, cond = inside)
              } else {
                q
              }
              let new_len = if fname == "Array::set" {
                len
              } else {
                "(+ \{len} 1)"
              }
              let updated = "(|Array[Int]::mk| (store \{arr_data(current)} \{index} \{q.value}) \{new_len})"
              // A length is bounded by memory far below the `Int` range.
              assume_range(ctx = ctx, term = updated, sort = arr_sort(), pc = state.pc)
              match env_assign(env = state.env, name = name, term = updated, sort = arr_sort()) {
                Some(env2) => Array::push(out, value = Outcome::{
                  pc: state.pc,
                  value: "true",
                  sort: "Unit",
                  returned: false,
                  env: env2
                }),
                None => unsupported(off = off, reason = "`\{name}` is not a local of the provable fragment")
              }
            }
          }
          ()
        }
      }
      ()
    }
  }
  out
}

/// `[a, b, ..]` of `Int`s: its items in order, as written. A bare empty
/// literal is unsupported: nothing in it says its element type. An annotated
/// one (`let xs: Array[Int] = []`) is read by `sym_ascription`.
fn sym_array_literal(ctx: Ctx, items: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  if Array::length(items) == 0 {
    unsupported(off = off, reason = "an empty array literal, whose element type the prover does not read")
  } else {
    ()
  }
  let mut states: Array[(Outcome, String)] = [
    (st, "((as const (Array Int Int)) 0)")
  ]
  let out: Array[Outcome] = []
  let mut k = 0
  for item in items {
    let next: Array[(Outcome, String)] = []
    for pair in states {
      let (s0, data) = pair
      for o in sym(ctx = ctx, e = item, st = s0) {
        if o.returned {
          Array::push(out, value = o)
        } else if o.sort != "Int" {
          unsupported(off = off, reason = "an array literal of `\{o.sort}`: only `Array[Int]` is modelled")
        } else {
          Array::push(next, value = (o, "(store \{data} \{k} \{o.value})"))
        }
      }
      ()
    }
    states = next
    k = k + 1
  }
  for pair in states {
    let (s1, data) = pair
    Array::push(out, value = with_value(st = s1, value = "(|Array[Int]::mk| \{data} \{k})", sort = arr_sort()))
  }
  out
}

/// A call is modular: the callee's `requires` become obligations at the
/// call, and its `ensures` an assumption about a fresh result.
fn sym_call(ctx: Ctx, fname: String, args: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  if fname == ctx.fn_name {
    unsupported(off = off, reason = "a recursive call: termination is not proved, so the result would be partial correctness only")
  } else {
    ()
  }
  let sig = match find_sig(fns = ctx.fns, name = fname) {
    Some(s) => s,
    None => {
      unsupported(off = off, reason = "`\{fname}` is not a function of this file with an `Int` / `Bool` signature")
      FnSig::{
        name: "",
        params: [],
        ret: "",
        requires: [],
        ensures: [],
        pure: false
      }
    }
  }
  // A callee is summarized by its contract, which this run proves too, so
  // the call stands on that proof. A callee with no contract has nothing to
  // stand on: its body is not proved here, and it may loop forever or trap
  // on a precondition it breaks, so assuming it returns would be unsound.
  if Array::length(sig.requires) + Array::length(sig.ensures) == 0 {
    unsupported(off = off, reason = "`\{fname}` has no `where` contract, so the call cannot be checked modularly; give it one (`ensures: true` at least), and its body is proved too")
  } else {
    ()
  }
  if !sig.pure || Array::length(sig.params) != Array::length(args) {
    unsupported(off = off, reason = "`\{fname}` is not a pure function with `Int` / `Bool` parameters and result")
  } else {
    ()
  }
  // Arguments run left to right, in the order written; each path carries
  // the values so far. A labeled argument (`f(x = e)`) is matched to the
  // parameter of that name afterwards.
  let mut states: Array[(Outcome, Array[(String, String)])] = [(st, [])]
  let out: Array[Outcome] = []
  let slots: Array[Int] = []
  let mut pos = 0
  for a in args {
    match a {
      ELabeledArg(label, _, _) => Array::push(slots, value = param_index(sig = sig, name = label, off = off)),
      _ => {
        Array::push(slots, value = pos)
        pos = pos + 1
      }
    }
  }
  for a0 in args {
    let a = match a0 {
      ELabeledArg(_, _, v) => v,
      _ => a0
    }
    let next: Array[(Outcome, Array[(String, String)])] = []
    for pair in states {
      let (s0, vals) = pair
      for o in sym(ctx = ctx, e = a, st = s0) {
        if o.returned {
          Array::push(out, value = o)
        } else {
          let vs = Array::slice(vals, start = 0, end = Array::length(vals))
          Array::push(vs, value = (o.value, o.sort))
          Array::push(next, value = (o, vs))
        }
      }
      ()
    }
    states = next
  }
  for pair in states {
    let (s1, vals) = pair
    let callee_env: Array[(String, String, String)] = []
    let mut i = 0
    while i < Array::length(sig.params) {
      let (pn, ps) = Array::get(sig.params, at = i)
      let mut j = 0
      let mut v = ""
      while j < Array::length(slots) {
        if Array::get(slots, at = j) == i {
          let (val, vsort) = Array::get(vals, at = j)
          // #3827: a word parameter takes a word, or a literal written for
          // it; an `Int` value there is a sort the checker would not admit.
          let w = adapt_word(value = val, sort = vsort, want = ps)
          v = if !is_word_sort(ps) {
            val
          } else if w != "" {
            w
          } else {
            unsupported(off = off, reason = "`\{fname}` passes a `\{vsort}` for its `\{ps}` parameter `\{pn}`")
            val
          }
        } else {
          ()
        }
        j = j + 1
      }
      if v == "" {
        unsupported(off = off, reason = "a call to `\{fname}` that does not pass `\{pn}` (a default argument) is outside the provable fragment")
      } else {
        ()
      }
      Array::push(callee_env, value = (pn, v, ps))
      i = i + 1
    }
    let at_call = Outcome::{
      pc: s1.pc,
      value: "",
      sort: "Unit",
      returned: false,
      env: callee_env
    }
    for r in sig.requires {
      let goal = clause_formula(ctx = ctx, clause = r, state = at_call)
      push_obligation(ctx = ctx, kind = "requires", label = "\{fname}: \{print_expr(r)}", off = off, goal = goal)
    }
    let res = fresh(ctx = ctx, sort = sig.ret)
    assume_range(ctx = ctx, term = res, sort = sig.ret, pc = s1.pc)
    let ens_env = env_bind(env = callee_env, name = "result", term = res, sort = sig.ret)
    for c in sig.ensures {
      let f = clause_formula(ctx = ctx, clause = c, state = Outcome::{
        pc: s1.pc,
        value: "",
        sort: "Unit",
        returned: false,
        env: ens_env
      })
      Array::push(ctx.assumes, value = f)
    }
    Array::push(out, value = with_value(st = s1, value = res, sort = sig.ret))
  }
  out
}

fn param_index(sig: FnSig, name: String, off: Int) -> Int with Exception {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(sig.params) {
    let (pn, _) = Array::get(sig.params, at = i)
    if pn == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  if found < 0 {
    unsupported(off = off, reason = "`\{sig.name}` has no parameter `\{name}`")
  } else {
    ()
  }
  found
}

//# Datatypes (#3719)

fn adt_sort(_ name: String) -> String {
  "|\{name}|"
}

/// The SMT constructor of `ctor` of `adt`: `|Shape::Circle|` for a variant,
/// `|Point::{}|` for a struct. `::` cannot appear in a type or variant name,
/// so no two constructors share a spelling.
fn ctor_smt(adt: Adt, ctor: (String, Array[(String, String)])) -> String {
  let (cname, _) = ctor
  if adt.is_struct {
    "|\{adt.name}::{}|"
  } else {
    "|\{adt.name}::\{cname}|"
  }
}

/// The selector of `field` of `ctor`: `|Point.x|` for a struct field,
/// `|Shape::Circle.0|` for a variant's payload position.
fn sel_smt(adt: Adt, ctor: (String, Array[(String, String)]), field: String) -> String {
  let (cname, _) = ctor
  if adt.is_struct {
    "|\{adt.name}.\{field}|"
  } else {
    "|\{adt.name}::\{cname}.\{field}|"
  }
}

fn find_adt(adts: Array[Adt], name: String) -> Option[Adt] {
  let mut found = None
  for a in adts {
    if a.name == name {
      found = Some(a)
    } else {
      ()
    }
  }
  found
}

fn adt_of_sort(adts: Array[Adt], sort: String) -> Option[Adt] {
  let mut found = None
  for a in adts {
    if adt_sort(a.name) == sort {
      found = Some(a)
    } else {
      ()
    }
  }
  found
}

/// A constructor spelled `name` -- `Shape::Circle`, or a bare `Circle` that
/// exactly one enum of the file declares.
fn resolve_ctor(adts: Array[Adt], name: String) -> Option[(Adt, (String, Array[(String, String)]))] {
  let sep = String::index_of(name, needle = "::")
  let (owner, member) = if sep >= 0 {
    (String::substring(name, start = 0, end = sep), String::substring(name, start = sep + 2, end = String::length(name)))
  } else {
    ("", name)
  }
  let hits: Array[(Adt, (String, Array[(String, String)]))] = []
  for a in adts {
    if !a.is_struct && (owner == "" || owner == a.name) {
      for c in a.ctors {
        let (cname, _) = c
        if cname == member {
          Array::push(hits, value = (a, c))
        } else {
          ()
        }
      }
      ()
    } else {
      ()
    }
  }
  if Array::length(hits) == 1 {
    Some(Array::get(hits, at = 0))
  } else {
    None
  }
}

/// The structs and enums of the file the prover reads as datatypes. A type
/// that mentions one that does not qualify is dropped too, until nothing
/// changes, so every field sort names `Int`, `Bool` or a kept datatype.
fn collect_adts(_ stmts: Array[Stmt]) -> Array[Adt] {
  let raw: Array[(String, Bool, Array[(String, Array[(String, TypeExpr)])])] = [
  ]
  for st in stmts {
    match st {
      SStruct(_, name, fields, _, muts, tparams) => if Array::length(tparams) == 0 && Array::length(muts) == 0 {
        Array::push(raw, value = (name, true, [(name, fields)]))
      } else {
        ()
      },
      SEnum(_, name, tparams, variants, _) => if Array::length(tparams) == 0 {
        let cs: Array[(String, Array[(String, TypeExpr)])] = []
        for v in variants {
          let (vname, payload) = v
          let fs: Array[(String, TypeExpr)] = []
          let mut i = 0
          for t in payload {
            Array::push(fs, value = (Int::to_string(i), t))
            i = i + 1
          }
          Array::push(cs, value = (vname, fs))
        }
        Array::push(raw, value = (name, false, cs))
      } else {
        ()
      },
      _ => ()
    }
  }
  let mut kept: Array[String] = for r in raw {
    let (n, _, _) = r
    n
  }
  // Both conditions are re-run until neither drops anything: a type
  // dropped as uninhabited can leave another naming an undeclared sort.
  let mut outer = true
  while outer {
    let before = Array::length(kept)
    let mut changed = true
    while changed {
      changed = false
      let next: Array[String] = []
      for r in raw {
        let (n, _, cs) = r
        if contains_name(xs = kept, x = n) {
          let mut ok = true
          for c in cs {
            let (_, fs) = c
            for f in fs {
              let (_, t) = f
              match t {
                TyName(tn) => if tn != "Int" && tn != "Bool" && !contains_name(xs = kept, x = tn) {
                  ok = false
                } else {
                  ()
                },
                _ => ok = false
              }
            }
            ()
          }
          if ok {
            Array::push(next, value = n)
          } else {
            changed = true
          }
        } else {
          ()
        }
      }
      kept = next
    }
    kept = adt_inhabited(raw = raw, kept = kept)
    outer = Array::length(kept) != before
  }
  let out: Array[Adt] = []
  for r in raw {
    let (n, is_struct, cs) = r
    if contains_name(xs = kept, x = n) {
      let ctors: Array[(String, Array[(String, String)])] = for c in cs {
        let (cname, fs) = c
        (cname, for f in fs {
          let (fname, t) = f
          let sort = match t {
            TyName(tn) => if tn == "Int" || tn == "Bool" {
              tn
            } else {
              adt_sort(tn)
            },
            _ => ""
          }
          (fname, sort)
        })
      }
      Array::push(out, value = Adt::{
        name: n,
        is_struct: is_struct,
        ctors: ctors,
        custom_eq: false
      })
    } else {
      ()
    }
  }
  mark_custom_eq(stmts = stmts, adts = out)
}

/// The datatypes with a program-written `equals` (`fn T::equals`, or an
/// `impl Eq for T` method, which binds the same name), and every datatype
/// with a field of one, to a fixpoint.
fn mark_custom_eq(stmts: Array[Stmt], adts: Array[Adt]) -> Array[Adt] {
  let names: Array[String] = []
  for st in stmts {
    match st {
      SFnDecl(_, name, _, _, _) => Array::push(names, value = name),
      SLet(_, _, name, _, _) => Array::push(names, value = name),
      _ => ()
    }
  }
  let marked: Array[String] = []
  for a in adts {
    if contains_name(xs = names, x = "\{a.name}::equals") {
      Array::push(marked, value = a.name)
    } else {
      ()
    }
  }
  let mut changed = true
  while changed {
    changed = false
    for a in adts {
      if !contains_name(xs = marked, x = a.name) {
        let mut hit = false
        for c in a.ctors {
          let (_, fs) = c
          for f in fs {
            let (_, fsort) = f
            for m in marked {
              if fsort == adt_sort(m) {
                hit = true
              } else {
                ()
              }
            }
          }
          ()
        }
        if hit {
          Array::push(marked, value = a.name)
          changed = true
        } else {
          ()
        }
      } else {
        ()
      }
    }
  }
  for a in adts {
    Adt::{
      name: a.name,
      is_struct: a.is_struct,
      ctors: a.ctors,
      custom_eq: contains_name(xs = marked, x = a.name)
    }
  }
}

/// The kept types an SMT datatype can declare: each needs a constructor whose
/// every field is `Int`, `Bool` or a type already shown inhabited, found to a
/// least fixpoint. An empty enum, or a struct that only contains itself, has
/// none and would make z3 reject the whole declaration -- and with it every
/// query of the file.
fn adt_inhabited(raw: Array[(String, Bool, Array[(String, Array[(String, TypeExpr)])])], kept: Array[String]) -> Array[String] {
  let inhabited: Array[String] = []
  let mut changed = true
  while changed {
    changed = false
    for r in raw {
      let (n, _, cs) = r
      if contains_name(xs = kept, x = n) && !contains_name(xs = inhabited, x = n) {
        let mut any = false
        for c in cs {
          let (_, fs) = c
          let mut all = true
          for f in fs {
            let (_, t) = f
            match t {
              TyName(tn) => if tn != "Int" && tn != "Bool" && !contains_name(xs = inhabited, x = tn) {
                all = false
              } else {
                ()
              },
              _ => all = false
            }
          }
          if all {
            any = true
          } else {
            ()
          }
        }
        if any {
          Array::push(inhabited, value = n)
          changed = true
        } else {
          ()
        }
      } else {
        ()
      }
    }
  }
  inhabited
}

/// One `declare-datatypes` for every datatype of the file, so a type may
/// name another declared after it.
fn datatypes_decl(_ adts: Array[Adt]) -> String {
  let heads: Array[String] = for a in adts {
    "(\{adt_sort(a.name)} 0)"
  }
  let bodies: Array[String] = for a in adts {
    let cs: Array[String] = for c in a.ctors {
      let (_, fs) = c
      let sels: Array[String] = for f in fs {
        let (fname, fsort) = f
        " (\{sel_smt(adt = a, ctor = c, field = fname)} \{fsort})"
      }
      "(\{ctor_smt(adt = a, ctor = c)}\{String::join(sels, sep = "")})"
    }
    "(\{String::join(cs, sep = " ")})"
  }
  "(declare-datatypes (\{String::join(heads, sep = " ")}) (\{String::join(bodies, sep = " ")}))"
}

/// A constructor applied to its fields: positional `args` for a variant,
/// `named` fields for a struct literal (evaluated as written, placed in
/// declaration order).
fn sym_construct(ctx: Ctx, adt: Adt, ctor: (String, Array[(String, String)]), named: Array[(String, Expr)], args: Array[Expr], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  let (cname, fields) = ctor
  let exprs: Array[Expr] = if adt.is_struct {
    if Array::length(named) != Array::length(fields) {
      unsupported(off = off, reason = "struct `\{adt.name}` built without every field")
    } else {
      ()
    }
    for f in fields {
      let (fname, _) = f
      let mut hit = None
      for nf in named {
        let (nn, ne) = nf
        if nn == fname {
          hit = Some(ne)
        } else {
          ()
        }
      }
      match hit {
        Some(x) => x,
        None => {
          unsupported(off = off, reason = "struct `\{adt.name}` built without field `\{fname}`")
          EUnit
        }
      }
    }
  } else {
    if Array::length(args) != Array::length(fields) {
      unsupported(off = off, reason = "`\{cname}` takes \{Array::length(fields)} field(s)")
    } else {
      ()
    }
    args
  }
  let out: Array[Outcome] = []
  for done in sym_list(ctx = ctx, items = exprs, st = st) {
    let (o, values) = done
    if o.returned {
      Array::push(out, value = o)
    } else {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fsort) = Array::get(fields, at = i)
        let (_, vsort) = Array::get(values, at = i)
        if fsort != vsort {
          unsupported(off = off, reason = "field \{i} of `\{cname}` is a `\{vsort}` where `\{fsort}` is declared")
        } else {
          ()
        }
        i = i + 1
      }
      let terms: Array[String] = for v in values {
        let (t, _) = v
        t
      }
      let value = if Array::length(terms) == 0 {
        ctor_smt(adt = adt, ctor = ctor)
      } else {
        "(\{ctor_smt(adt = adt, ctor = ctor)} \{String::join(terms, sep = " ")})"
      }
      Array::push(out, value = with_value(st = o, value = value, sort = adt_sort(adt.name)))
    }
  }
  out
}

/// `items` evaluated left to right: each outcome with the value and sort of
/// every item on its path. A path that returns early carries no values.
fn sym_list(ctx: Ctx, items: Array[Expr], st: Outcome) -> Array[(Outcome, Array[(String, String)])] with Exception {
  let mut paths: Array[(Outcome, Array[(String, String)])] = [(st, [])]
  for it in items {
    let next: Array[(Outcome, Array[(String, String)])] = []
    for p in paths {
      let (o, values) = p
      if o.returned {
        Array::push(next, value = p)
      } else {
        for r in sym(ctx = ctx, e = it, st = o) {
          if r.returned {
            Array::push(next, value = (r, []))
          } else {
            let vs: Array[(String, String)] = for v in values {
              v
            }
            Array::push(vs, value = (r.value, r.sort))
            Array::push(next, value = (r, vs))
          }
        }
        ()
      }
    }
    paths = next
  }
  paths
}

/// `match` as a case split: each arm's path has its own pattern holding and
/// every earlier arm's failing, as the first matching arm runs.
fn sym_match(ctx: Ctx, scr: Expr, arms: Array[(Pat, Expr)], off: Int, st: Outcome) -> Array[Outcome] with Exception {
  if Array::length(arms) == 0 {
    unsupported(off = off, reason = "a `match` with no arms")
  } else {
    ()
  }
  let out: Array[Outcome] = []
  for o in sym(ctx = ctx, e = scr, st = st) {
    if o.returned {
      Array::push(out, value = o)
    } else {
      let earlier: Array[String] = []
      for arm in arms {
        let (pat, body) = arm
        let binds: Array[(String, String, String)] = []
        let cond = pattern_cond(ctx = ctx, pat = pat, term = o.value, sort = o.sort, binds = binds, off = off, pc = o.pc)
        let mut arm_st = with_pc(st = o, cond = cond)
        for prior in earlier {
          arm_st = with_pc(st = arm_st, cond = "(not \{prior})")
        }
        let mut env = arm_st.env
        for b in binds {
          let (bn, bt, bs) = b
          env = env_bind(env = env, name = bn, term = bt, sort = bs)
        }
        let bound = Outcome::{
          pc: arm_st.pc,
          value: "",
          sort: "Unit",
          returned: false,
          env: env
        }
        for x in sym(ctx = ctx, e = body, st = bound) {
          // The arm's bindings end with the arm; an assignment it made to an
          // enclosing binding does not.
          Array::push(out, value = leave_scope(x = x, outer = o.env))
        }
        Array::push(earlier, value = cond)
      }
      // A value no arm matches traps at run time, so some arm must hold on
      // every path that reaches the `match`.
      push_obligation(ctx = ctx, kind = "coverage", label = print_expr(scr), off = off, goal = guarded(pc = o.pc, goal = "(or false \{String::join(earlier, sep = " ")})"))
      ()
    }
  }
  out
}

/// The condition under which `pat` matches `term`, binding its names into
/// `binds`. A shape the prover does not read is unsupported.
fn pattern_cond(ctx: Ctx, pat: Pat, term: String, sort: String, binds: Array[(String, String, String)], off: Int, pc: Array[String]) -> String with Exception {
  match pat {
    PWild => "true",
    PBind(n) => {
      Array::push(binds, value = (n, term, sort))
      "true"
    },
    PInt(n) => if sort == "Int" {
      "(= \{term} \{smt_int(n)})"
    } else {
      unsupported(off = off, reason = "an integer pattern on a `\{sort}`")
      "false"
    },
    PBool(b) => if sort == "Bool" {
      if b {
        term
      } else {
        "(not \{term})"
      }
    } else {
      unsupported(off = off, reason = "a Bool pattern on a `\{sort}`")
      "false"
    },
    PCtor(name, subs) => match adt_of_sort(adts = ctx.adts, sort = sort) {
      Some(adt) => {
        let sep = String::index_of(name, needle = "::")
        let base = if sep >= 0 {
          String::substring(name, start = sep + 2, end = String::length(name))
        } else {
          name
        }
        let mut found = None
        for c in adt.ctors {
          let (cname, _) = c
          if !adt.is_struct && cname == base {
            found = Some(c)
          } else {
            ()
          }
        }
        match found {
          Some(ctor) => {
            let (_, fields) = ctor
            if Array::length(fields) != Array::length(subs) {
              unsupported(off = off, reason = "pattern `\{name}` with \{Array::length(subs)} field(s) where \{Array::length(fields)} are declared")
            } else {
              ()
            }
            let conds: Array[String] = [
              "((_ is \{ctor_smt(adt = adt, ctor = ctor)}) \{term})"
            ]
            let mut i = 0
            while i < Array::length(fields) {
              let (fname, fsort) = Array::get(fields, at = i)
              let t = "(\{sel_smt(adt = adt, ctor = ctor, field = fname)} \{term})"
              assume_range(ctx = ctx, term = t, sort = fsort, pc = pc)
              Array::push(conds, value = pattern_cond(ctx = ctx, pat = Array::get(subs, at = i), term = t, sort = fsort, binds = binds, off = off, pc = pc))
              i = i + 1
            }
            "(and \{String::join(conds, sep = " ")})"
          },
          None => {
            unsupported(off = off, reason = "`\{name}` is not a variant of `\{adt.name}`")
            "false"
          }
        }
      },
      None => {
        unsupported(off = off, reason = "a constructor pattern on a `\{sort}`")
        "false"
      }
    },
    PStruct(sname, fpats) => match adt_of_sort(adts = ctx.adts, sort = sort) {
      Some(adt) => if adt.is_struct && adt.name == sname {
        let ctor = Array::get(adt.ctors, at = 0)
        let (_, fields) = ctor
        let conds: Array[String] = ["true"]
        for fp in fpats {
          let (fname, sub) = fp
          let mut fsort = ""
          for f in fields {
            let (n, s) = f
            if n == fname {
              fsort = s
            } else {
              ()
            }
          }
          if fsort == "" {
            unsupported(off = off, reason = "`\{sname}` has no field `\{fname}`")
          } else {
            ()
          }
          let t = "(\{sel_smt(adt = adt, ctor = ctor, field = fname)} \{term})"
          assume_range(ctx = ctx, term = t, sort = fsort, pc = pc)
          Array::push(conds, value = pattern_cond(ctx = ctx, pat = sub, term = t, sort = fsort, binds = binds, off = off, pc = pc))
        }
        "(and \{String::join(conds, sep = " ")})"
      } else {
        unsupported(off = off, reason = "a `\{sname}` pattern on a `\{sort}`")
        "false"
      },
      None => {
        unsupported(off = off, reason = "a struct pattern on a `\{sort}`")
        "false"
      }
    },
    POr(a, b) => {
      let before = Array::length(binds)
      let ca = pattern_cond(ctx = ctx, pat = a, term = term, sort = sort, binds = binds, off = off, pc = pc)
      let cb = pattern_cond(ctx = ctx, pat = b, term = term, sort = sort, binds = binds, off = off, pc = pc)
      if Array::length(binds) != before {
        unsupported(off = off, reason = "an or-pattern that binds names")
      } else {
        ()
      }
      "(or \{ca} \{cb})"
    },
    _ => {
      unsupported(off = off, reason = "this pattern is outside the provable fragment")
      "false"
    }
  }
}

fn adt_has_custom_eq(adts: Array[Adt], sort: String) -> Bool {
  match adt_of_sort(adts = adts, sort = sort) {
    Some(a) => a.custom_eq,
    None => false
  }
}
