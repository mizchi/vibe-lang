//# Imports

import .{
  Obligation, Obligation::report_line, prove_line_col, prove_obligations, prove_verdict
}

//# Helpers

fn kinds(_ source: String) -> String with Exception {
  let out: Array[String] = []
  for o in prove_obligations(source) {
    Array::push(out, value = "\{o.fn_name}:\{o.kind}:\{o.label}")
  }
  String::join(out, sep = " | ")
}

//# Tests

test "a contracted function yields its ensures and its overflow obligations" {
  let src = "fn inc(x: Int) -> Int where { requires: x >= 0, ensures: result > x } {\n  x + 1\n}\n"
  inspect(kinds(src), content = "inc:overflow:(x + 1) | inc:ensures:(result > x)")
}

test "a function without a contract is not a claim" {
  inspect(kinds("fn plain(x: Int) -> Int {\n  x\n}\n"), content = "")
}

test "every return is an exit the ensures covers" {
  let src = "fn abs(x: Int) -> Int where { requires: x > 0 - 100, ensures: result >= 0 } {\n  if x < 0 {\n    return 0 - x\n  } else {\n    ()\n  }\n  x\n}\n"
  inspect(kinds(src), content = "abs:overflow:(0 - 100) | abs:overflow:(0 - x) | abs:ensures:(result >= 0) | abs:ensures:(result >= 0)")
}

test "a call assumes the callee's ensures and owes its requires" {
  let src = "fn half(x: Int) -> Int where { requires: x >= 0, ensures: result >= 0 } {\n  x\n}\nfn use(y: Int) -> Int where { requires: y >= 2, ensures: result >= 0 } {\n  half(y)\n}\n"
  inspect(kinds(src), content = "half:ensures:(result >= 0) | use:requires:half: (x >= 0) | use:ensures:(result >= 0)")
}

test "outside the fragment is unsupported, never skipped" {
  inspect(kinds("fn f(xs: Array[Bool]) -> Int where { ensures: result >= 0 } {\n  0\n}\n"), content = "f:unsupported:parameter `xs` is not `Int`, `Bool`, `Array[Int]`, or a struct / enum of this file (non-generic, every field `Int`, `Bool` or such a type)")
  inspect(kinds("fn g(x: Int) -> Int where { ensures: result >= 0 } {\n  while false {\n    ()\n  }\n  0\n}\n"), content = "g:unsupported:a `while` without a `where { decreases: .. }` measure: termination is not proved, so the result would be partial correctness only")
  inspect(kinds("fn h(x: Int) -> Int where { ensures: result >= 0 } {\n  h(x)\n}\n"), content = "h:unsupported:`h` is part of, or calls into, a recursive cycle: termination is not proved, so the result would be partial correctness only")
}

test "a recursive cycle is unsupported, not assumed" {
  let src = "fn ping(x: Int) -> Int where { ensures: false } {\n  pong(x)\n}\nfn pong(x: Int) -> Int where { ensures: false } {\n  ping(x)\n}\nfn helper(x: Int) -> Int {\n  helper(x)\n}\nfn uses(x: Int) -> Int where { ensures: true } {\n  helper(x)\n}\n"
  inspect(kinds(src), content = "ping:unsupported:`ping` is part of, or calls into, a recursive cycle: termination is not proved, so the result would be partial correctness only | pong:unsupported:`pong` is part of, or calls into, a recursive cycle: termination is not proved, so the result would be partial correctness only | uses:unsupported:`uses` is part of, or calls into, a recursive cycle: termination is not proved, so the result would be partial correctness only")
}

test "a call to an uncontracted function is unsupported, not assumed to return" {
  let src = "fn spin(x: Int) -> Int {\n  x\n}\nfn uses(x: Int) -> Int where { ensures: result == 0 } {\n  let _ = spin(x)\n  0\n}\n"
  inspect(kinds(src), content = "uses:unsupported:`spin` has no `where` contract, so the call cannot be checked modularly; give it one (`ensures: true` at least), and its body is proved too")
}

test "#3719: structs and enums of the file are datatypes; match is a case split" {
  let src = "enum Shape {\n  Circle(Int);\n  Empty\n}\nstruct Point {\n  x: Int;\n  y: Int\n}\nfn radius(s: Shape) -> Int where { ensures: result >= 0 } {\n  match s {\n    Circle(r) => if r >= 0 { r } else { 0 },\n    Empty => 0\n  }\n}\nfn swap(p: Point) -> Point where { ensures: result.x == p.y } {\n  Point::{ x: p.y, y: p.x }\n}\n"
  inspect(kinds(src), content = "radius:coverage:s | radius:ensures:(result >= 0) | radius:ensures:(result >= 0) | radius:ensures:(result >= 0) | swap:ensures:(result.x == p.y)")
}

test "#3719: a generic enum, or one with a field outside the fragment, is unsupported" {
  let src = "enum Box[T] {\n  Full(T)\n}\nenum Named {\n  Tag(String)\n}\nfn f(b: Box[Int]) -> Int where { ensures: true } {\n  0\n}\nfn g(n: Named) -> Int where { ensures: true } {\n  0\n}\n"
  inspect(kinds(src), content = "f:unsupported:parameter `b` is not `Int`, `Bool`, `Array[Int]`, or a struct / enum of this file (non-generic, every field `Int`, `Bool` or such a type) | g:unsupported:parameter `n` is not `Int`, `Bool`, `Array[Int]`, or a struct / enum of this file (non-generic, every field `Int`, `Bool` or such a type)")
}

test "#3719: a counterexample is shown as the program spells it" {
  inspect(prove_verdict("sat\n((|s| (|Shape::Circle| (- 3))) (|p| (|Point::{}| 1 2)) (|e| |Shape::Empty|))\n"), content = "(unproved, s = Shape::Circle(-3), p = Point::{ 1, 2 }, e = Shape::Empty)")
}

test "#3719: an uninhabited type is not declared, so it cannot spoil another proof" {
  let src = "enum Never {}\nstruct Loop {\n  next: Loop\n}\nenum Wrap {\n  W(Never)\n}\nstruct Point {\n  x: Int\n}\nfn inc(x: Int) -> Int where { requires: x >= 0 && x < 100, ensures: result > x } {\n  x + 1\n}\n"
  let mut mentions = 0
  let mut declared = 0
  for o in prove_obligations(src) {
    if String::contains(o.query, needle = "|Never|") || String::contains(o.query, needle = "|Loop|") || String::contains(o.query, needle = "|Wrap|") {
      mentions = mentions + 1
    } else {
      ()
    }
    if String::contains(o.query, needle = "(|Point| 0)") {
      declared = declared + 1
    } else {
      ()
    }
  }
  inspect((mentions, declared > 0), content = "(0, true)")
}

test "only unsat proves" {
  inspect(prove_verdict("unsat\n"), content = "(proved, )")
  inspect(prove_verdict("sat\n((|x| (- 1))\n (|y| 0))\n"), content = "(unproved, x = -1, y = 0)")
  inspect(prove_verdict("sat\n()\n"), content = "(unproved, none needed, the function has no inputs and fails on every run)")
  inspect(prove_verdict("unknown\n"), content = "(unknown, z3 returned unknown)")
  inspect(prove_verdict("timeout\n"), content = "(unknown, z3 timed out)")
  inspect(prove_verdict(""), content = "(unknown, z3 did not answer: )")
}

test "#3719: one report wording for every solver; only unsat is silent" {
  let o = Obligation::{
    fn_name: "dec",
    kind: "ensures",
    label: "(result > x)",
    off: 7,
    query: ""
  }
  inspect(Obligation::report_line(o, answer = "unsat\n", limit = "rlimit 9"), content = "None")
  inspect(Obligation::report_line(o, answer = "sat\n((|x| 1))\n", limit = "rlimit 9"), content = "Some((7, unproved: ensures (result > x) of `dec` -- counterexample: x = 1))")
  inspect(Obligation::report_line(o, answer = "unknown\n", limit = "rlimit 9"), content = "Some((7, unknown: ensures (result > x) of `dec` -- z3 returned unknown (rlimit 9)))")
  inspect(Obligation::report_line(o, answer = "(error \"bad\")\n", limit = "5000 ms limit"), content = "Some((7, unknown: ensures (result > x) of `dec` -- z3 did not answer: (error \"bad\") (5000 ms limit)))")
  let u = Obligation::{
    fn_name: "f",
    kind: "unsupported",
    label: "a reason",
    off: -1,
    query: ""
  }
  inspect(Obligation::report_line(u, answer = "unsat\n", limit = "rlimit 9"), content = "Some((-1, unsupported: a reason (in `f`)))")
  inspect((prove_line_col(source = "ab\ncd", off = 4), prove_line_col(source = "ab", off = -1)), content = "(2:2, 1:1)")
}

test "#3717: a contracted while owes its invariants and measure on entry and after an iteration" {
  let src = "fn c(n: Int) -> Int where { requires: n >= 0, ensures: result == n } {\n  let mut i = 0\n  while i < n where {\n    invariant: 0 <= i && i <= n,\n    decreases: n - i,\n  } {\n    i = i + 1\n  }\n  i\n}\n"
  inspect(kinds(src), content = "c:invariant-entry:((0 <= i) && (i <= n)) | c:overflow:(n - i) | c:measure-entry:(n - i) | c:overflow:(n - i) | c:overflow:(i + 1) | c:invariant:((0 <= i) && (i <= n)) | c:overflow:(n - i) | c:measure:(n - i) | c:ensures:(result == n)")
}

test "#3717: an array read owes its index inside the length" {
  let src = "fn g(xs: Array[Int], i: Int) -> Int where { requires: i >= 0 && i < Array::length(xs), ensures: true } {\n  xs[i] + Array::get(xs, at = i) - Array::length([1, 2])\n}\n"
  inspect(kinds(src), content = "g:index:xs[i] | g:index:Array::get(xs, at=i) | g:overflow:(Array::get(xs, i) + Array::get(xs, at=i)) | g:overflow:((Array::get(xs, i) + Array::get(xs, at=i)) - Array::length([1, 2])) | g:ensures:true")
}
