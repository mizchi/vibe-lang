// The pure half of `vibe check --prove`: it reads a source's contracted
// functions and returns one query per obligation. Running the solver is the
// CLI's (it needs `Process`); deciding what the solver's answer means is
// `prove_verdict`'s, so the rule that only `unsat` proves lives here.

/// One verification condition. `kind` is `ensures`, `requires` (a callee's
/// precondition at a call), `overflow` (an `Int` operation must stay in the
/// 63-bit range) or `unsupported` (the function leaves the provable
/// fragment; `query` is empty and `label` says why). `off` is the source
/// byte offset the report points at, -1 when none is known.
struct Obligation {
  fn_name: String;
  kind: String;
  label: String;
  off: Int;
  query: String
}

fn prove_obligations(_ source: String) -> Array[Obligation] with Exception
fn prove_verdict(_ z3_out: String) -> (String, String)
fn smt_unquote(_ t: String) -> String
fn call_graph(_ stmts: Array[Stmt]) -> Array[(String, Array[String])]
fn contains_name(xs: Array[String], x: String) -> Bool
fn reaches_cycle(graph: Array[(String, Array[String])], node: String, path: Array[String], done: Array[String]) -> Bool
fn expr_kids(_ e: Expr) -> Array[Expr]
fn expr_off(_ e: Expr) -> Int
fn construct_name(_ e: Expr) -> String
fn shift_count(_ term: String) -> Int
fn pow2_text(_ k: Int) -> String
fn trunc_div(a: String, b: String) -> String
fn is_word_sort(_ sort: String) -> Bool
fn smt_sort_text(_ sort: String) -> String
fn word_int_range(_ sort: String) -> (String, String)
fn word_of_int(_ t: String) -> String
fn is_int_constant_term(_ t: String) -> Bool
fn adapt_word(value: String, sort: String, want: String) -> String
fn word_to_int(sort: String, t: String) -> String
fn word_zero() -> String
fn word_unary(op: String, t: String) -> String
fn word_binop(op: String, sort: String, a: String, b: String) -> (String, String)
