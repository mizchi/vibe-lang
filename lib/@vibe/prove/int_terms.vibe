// SMT terms for `Int` arithmetic the prover builds (#3717, ADR-0121): the
// truncating division the runtime computes, and the constant shift counts it
// admits. Split from prove.vibe.

//# Terms

/// The count of a shift when its SMT term is a decimal constant from 0 to
/// 62, and -1 otherwise.
export fn shift_count(_ term: String) -> Int {
  let n = String::length(term)
  if n == 0 || n > 2 {
    0 - 1
  } else {
    let mut k = 0
    let mut ok = true
    let mut i = 0
    while i < n {
      let c = String::byte_at(term, at = i)
      if c >= '0' && c <= '9' {
        k = k * 10 + (Char::to_int(c) - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok && k <= 62 {
      k
    } else {
      0 - 1
    }
  }
}

/// `2^k` as a decimal SMT literal. `2^62` is one past `Int`'s maximum, so it
/// is spelled out rather than computed.
export fn pow2_text(_ k: Int) -> String {
  if k == 62 {
    return "4611686018427387904"
  } else {
    ()
  }
  let mut p = 1
  let mut i = 0
  while i < k {
    p = p * 2
    i = i + 1
  }
  "\{p}"
}

/// The quotient `a / b` truncated toward zero, as the runtime computes it.
export fn trunc_div(a: String, b: String) -> String {
  "(ite (>= \{a} 0) (div \{a} \{b}) (- (div (- \{a}) \{b})))"
}
