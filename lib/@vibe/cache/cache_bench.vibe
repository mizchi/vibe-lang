//# Imports

import ./cache.vibe {
  compact_string_fingerprint
}

//# Helpers

/// Same 1KiB/8KiB + baseline cases as @vibex/blake3/blake3_bench.vibe and
/// @vibe/core/sha1_bench.vibe, so the current cache-key hash compares
/// like-for-like against the cryptographic candidates.
fn make_a(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, "a")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Misc

bench "compact_string_fingerprint empty" {
  let _ = compact_string_fingerprint("")
}

bench "compact_string_fingerprint medium" {
  let _ = compact_string_fingerprint("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789")
}

bench "compact_string_fingerprint 1KiB" {
  let _ = compact_string_fingerprint(make_a(1024))
}

bench "compact_string_fingerprint 8KiB" {
  let _ = compact_string_fingerprint(make_a(8192))
}

bench "baseline make_a 1KiB" {
  let _ = make_a(1024)
}

bench "baseline make_a 8KiB" {
  let _ = make_a(8192)
}
