}

export fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String, mode: String) -> String {
  compact_string_fingerprint(String::concat("file-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_path, String::concat("|", String::concat(entry_name, String::concat("|", mode))))))))
}

export fn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {
