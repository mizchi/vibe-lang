//# Functions

/// #849/Codex review (PR #899): this package is a general, dependency-free
/// disk-cache primitive (#766) that pure/component consumers can import for
/// just `compact_string_fingerprint` etc. `collect_used_builtin_names` scans
/// every top-level statement of the WHOLE linked program for builtin free
/// names, not just ones reachable from the entry point (#799 perf note in
/// linked_helpers.vibe) — so an `Env::get` reference ANYWHERE in this module,
/// even in dead/unused code, would force a `vibe.env_get` host import onto
/// every consumer of this package, breaking pure/component targets that don't
/// provide it. VIBE_BUILD_CACHE_DIR override support therefore lives in the
/// compiler-specific wrapper (lib/@vibe/compiler/cache/cache_underlying.vibe)
/// instead, which rebases the path string this returns — that layer already
/// requires host Fs/Error imports, so adding Env costs it nothing.
fn cache_root_prefix() -> String {
  "_build/vibe_"
}

export fn compact_string_fingerprint(source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

/// `version_tag` folds in whatever cache-invalidation identity the caller
/// needs (cache format version, codegen fingerprint, ...) — this package has
/// no opinion on what belongs in it, it only mixes it into the key.
export fn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String {
  let raw = compact_string_fingerprint(String::concat("persistent-cache-", String::concat(version_tag, String::concat("|", seed))))
  // O(N) build via StringBuilder; the previous `token = String::concat(token, ...)`
  // per char was O(N²) over the fingerprint length (issue #366).
  let token_sb = StringBuilder::new()
  let mut i = 0
  while i < String::length(raw) {
    let c = String::char_code_at(raw, i)
    let piece = if c == 58 {
      "_"
    } else {
      String::from_char_code(c)
    }
    StringBuilder::push(token_sb, piece)
    i = i + 1
  }
  let token = StringBuilder::freeze(token_sb)
  String::concat(cache_root_prefix(), String::concat(prefix, String::concat("_", String::concat(token, suffix))))
}

/// Canonical compilation-input identity. Paths and contents are paired in
/// caller order (the merge order is semantic), and the selected entry is
/// included because private-name rewriting treats it specially.
export fn compilation_input_fingerprint(sources: Array[(String, String)], entry_path: String) -> String {
  let mut acc = String::concat("compilation-input|entry=", entry_path)
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    let pair = String::concat(path, String::concat("=", compact_string_fingerprint(source)))
    acc = compact_string_fingerprint(String::concat(acc, String::concat("|", pair)))
    i = i + 1
  }
  acc
}

fn build_sources_fingerprint(sources: Array[(String, String)]) -> String {
  compilation_input_fingerprint(sources, "")
}

export fn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {
  stable_cache_path(version_tag, "selfhost_artifact", String::concat(kind, String::concat("|", String::concat(entry_name, String::concat("|", fingerprint)))), ".bin")
}

export fn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {
  let path = persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint)
  Fs::write_bytes(path, bytes)
}

export fn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {
  stable_cache_path(version_tag, "selfhost_dep_list", String::concat(path, String::concat("|", String::concat(source_fingerprint, resolution_seed))), ".tsv")
}

export fn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {
  stable_cache_path(version_tag, "selfhost_type_env_v2", fingerprint, ".tsv")
}

export fn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, i)
    let fingerprint = build_sources_fingerprint(sources)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export fn normalize_persistent_cache_text(text: String) -> String {
  let len = String::length(text)
  let mut start = 0
  while start < len && String::char_code_at(text, start) == 0 {
    start = start + 1
  }
  if start == 0 {
    text
  } else {
    text[start: len]
  }
}

export fn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {
  let path = persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    Some(Fs::read_bytes(path))
  }
}

export fn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {
  stable_cache_path(version_tag, "selfhost_source_list", String::concat(entry_path, resolution_seed), ".tsv")
}

export fn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {
  stable_cache_path(version_tag, "selfhost_source_groups", String::concat(entry_path, resolution_seed), ".tsv")
}

export fn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {
  stable_cache_path(version_tag, "selfhost_module_header_v2", String::concat(path, String::concat("|", String::concat(source_fingerprint, resolution_seed))), ".tsv")
}

export fn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {
  stable_cache_path(version_tag, "selfhost_manifest_headers", entry_path, ".tsv")
}

export fn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {
  stable_cache_path(version_tag, "selfhost_leaf_fp_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}

fn build_sources_fingerprint_from_compact_fingerprints(source_fingerprints: Array[String]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(source_fingerprints) {
    let next = String::concat(acc, String::concat("|", Array::get(source_fingerprints, i)))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export fn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, specs) = Array::get(groups, i)
    let source_fingerprints = Array::slice([
      ""
    ], 0, 0)
    let mut j = 0
    while j < Array::length(specs) {
      let (_, source_fingerprint) = Array::get(specs, j)
      Array::push(source_fingerprints, source_fingerprint)
      j = j + 1
    }
    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export fn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String {
  compact_string_fingerprint(String::concat("fs-compile|", String::concat(source_groups_fingerprint, String::concat("|", entry_name))))
}

export fn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String {
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)
}

export fn build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String) -> String {
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(build_source_groups_fingerprint(source_groups), entry_path, entry_name)
}

export fn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String) -> String {
  compact_string_fingerprint(String::concat("fs-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_path, String::concat("|", entry_name))))))
}

export fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String {
  compact_string_fingerprint(String::concat("file-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode))))))
}

export fn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String {
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)
}

export fn build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String, mode: String) -> String {
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(build_source_groups_fingerprint(source_groups), entry_path, entry_name, mode)
}

export fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String, mode: String) -> String {
  compact_string_fingerprint(String::concat("file-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_path, String::concat("|", String::concat(entry_name, String::concat("|", mode))))))))
}

export fn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {
  compact_string_fingerprint(String::concat("fs-compile-module|", source_groups_fingerprint))
}

export fn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {
  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}

export fn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {
  compact_string_fingerprint(String::concat("file-compile-module|", source_groups_fingerprint))
}

export fn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}

export fn build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String {
  compact_string_fingerprint(String::concat("file-compile-module|", String::concat(build_source_groups_fingerprint(source_groups), String::concat("|", entry_path))))
}

export fn build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String {
  compact_string_fingerprint(String::concat("file-compile-module|", String::concat(source_groups_fingerprint, String::concat("|", entry_path))))
}
