//# Imports

import ./tcp.vibe {
  tcp_close, tcp_connect, tcp_read, tcp_write
}

//# Values

//# Types

// #897 (ADR-0070 Phase 3): `TcpEndpoint`/`TcpConnection` are defined
// transparently in ./index.vpkg (the contract IS the definition —
// socket_test.vibe asserts their fields directly) — referenced here by name
// only, same convention as ShResult in lib/@vibe/process/process.vibe.

//# Functions

/// read: (TcpConnection, Int) -> String with { Socket }
export fn read(conn: TcpConnection, max_bytes: Int) -> String with Socket {
  tcp_read(conn.fd, max_bytes)
}

/// close: (TcpConnection) -> Unit with { Socket }
export fn close(conn: TcpConnection) -> Unit with Socket {
  tcp_close(conn.fd)
}

/// write: (TcpConnection, String) -> Unit with { Socket }
export fn write(conn: TcpConnection, data: String) -> Unit with Socket {
  tcp_write(conn.fd, data)
}

export fn endpoint(host: String, port: Int) -> TcpEndpoint {
  TcpEndpoint::{
    host: host,
    port: port
  }
}

export fn connection(fd: Int) -> TcpConnection {
  TcpConnection::{
    fd: fd
  }
}

/// connect: (TcpEndpoint) -> TcpConnection with { Socket }
export fn connect(target: TcpEndpoint) -> TcpConnection with Socket {
  connection(tcp_connect(target.host, target.port))
}

export fn connection_fd(conn: TcpConnection) -> Int {
  conn.fd
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): the old index.vibe facade defined these as plain
/// `export let socket_connect = connect` VALUE aliases (real importable
/// bindings, not re-exports) directly in the facade file itself. A `.vpkg`
/// facade only allocates a declared name to an EXPORTED FN/type def in a
/// sibling impl file (a bare name-to-name alias has no fn body to match), so
/// these are re-expressed here as real thin wrapper functions with the exact
/// same signatures/effects (same pattern as @vibe/process's process_*
/// aliases, PR #920) — no behavior change for callers.
export fn socket_connect(target: TcpEndpoint) -> TcpConnection with Socket {
  connect(target)
}

export fn socket_read(conn: TcpConnection, max_bytes: Int) -> String with Socket {
  read(conn, max_bytes)
}

export fn socket_write(conn: TcpConnection, data: String) -> Unit with Socket {
  write(conn, data)
}

export fn socket_close(conn: TcpConnection) -> Unit with Socket {
  close(conn)
}
