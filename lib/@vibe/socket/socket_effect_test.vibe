//# Imports

import ./socket_effect.vibe {
  TcpSocket
}

//# Misc

test "tcp mock connect + write + read" {
  let result = handle {
    let fd = perform TcpSocket::Connect("localhost", 8080)
    perform TcpSocket::Write(fd, "hello")
    let resp = perform TcpSocket::Read(fd, 1024)
    perform TcpSocket::Close(fd)
    String::length(resp)
  } with { TcpSocket::Connect(_host, _port) => resume(42); TcpSocket::Read(_fd, _max) => resume("world"); TcpSocket::Write(_fd, _data) => resume(0); TcpSocket::Close(_fd) => resume(0) }
  assert(result == 5)
}
