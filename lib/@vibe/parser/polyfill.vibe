// @vibe/parser-private int-to-string polyfill (#753). A verbatim copy of the
// compiler's core/polyfill.vibe __to_string: the parser package cannot
// depend on compiler internals, and the printer/token error paths need it.
// Private via the bare export block (a contract-undeclared `export let`
// would be a conformance violation); version is the declared contract value.

fn __to_string(n: Int) -> String {
  if n == 0 {
    "0"
  } else {
    let mut val = n
    let mut neg = false
    if val < 0 {
      neg = true
      val = 0 - val
    }
    let digits = Array::slice([""], 0, 0)
    while val > 0 {
      let d = val - (val / 10) * 10
      let ch = if d == 0 {
        "0"
      }
      else if d == 1 {
        "1"
      }
      else if d == 2 {
        "2"
      }
      else if d == 3 {
        "3"
      }
      else if d == 4 {
        "4"
      }
      else if d == 5 {
        "5"
      }
      else if d == 6 {
        "6"
      }
      else if d == 7 {
        "7"
      }
      else if d == 8 {
        "8"
      }
      else {
        "9"
      }
      Array::push(digits, ch)
      val = val / 10
    }
    let mut result = if neg {
      "-"
    } else {
      ""
    }
    let mut i = Array::length(digits) - 1
    while i >= 0 {
      result = String::concat(result, Array::get(digits, i))
      i = i - 1
    }
    result
  }
}

export {
  __to_string
}
