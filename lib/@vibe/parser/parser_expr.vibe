//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./parser_base.vibe {
  _no_tb,
  _no_tp,
  collect_effect_names,
  collect_import_path,
  empty_exprs,
  empty_fields,
  empty_import_items,
  empty_params,
  expect_tk,
  is_tk,
  mode_block,
  parse_binding_name,
  parse_effect_row,
  parse_effect_stmt,
  parse_enum_stmt,
  parse_impl_stmt_dispatch,
  parse_import_item,
  parse_param_list,
  parse_pattern,
  parse_struct_field,
  parse_suberror_stmt,
  parse_trait_stmt,
  parse_type,
  parse_type_alias_stmt,
  parse_type_impl,
  peek,
  skip_braced_body,
  tk_name
}

import ./parser_expr_core.vibe {
  parse_infix
}

import ./parser_expr_dispatch.vibe {
  parse_impl_dispatch
}

import ./token.vibe {
  Token
}

//# Functions

export fn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int) -> (Expr, Int) with Error {
  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with Error = (rtoks, rpos, rmode) -> {
    if rmode >= 0 && rmode <= 10 {
      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)
    } else {
      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)
    }
  }
  parse_recur(tokens, pos, mode)
}

export fn parse(tokens: Array[Token]) -> Expr with Error {
  let (e, next) = parse_impl(tokens, [
  ], 0, 0)
  match peek(tokens, next) {
    TEof => e,
    _ => {
      let actual = tk_name(peek(tokens, next))
      throw("unexpected after expression: \{actual}")
    }
  }
}

export fn parse_ok(tokens: Array[Token]) -> Bool {
  handle {
    let _ = parse(tokens)
    true
  } with Error {
    Throw(_) => false
  }
}

export fn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with Error {
  parse_impl(tokens, [
  ], pos, 0)
}

fn parse_type_param_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Error {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

fn parse_let_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with Error {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

fn parse_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with Error {
  match peek(tokens, pos) {
    TLBracket => {
      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)
      let (ty, next) = parse_type_impl(tokens, after_params, 0)
      (type_params, type_bounds, ty, next)
    },
    _ => {
      let (ty, next) = parse_type_impl(tokens, pos, 0)
      (_no_tp(), _no_tb(), ty, next)
    }
  }
}

fn apply_fn_annotation_params(params: Array[(String, Option[TypeExpr])], param_types: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {
  if Array::length(params) != Array::length(param_types) {
    params
  } else {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(params) {
      let (name, ann) = Array::get(params, i)
      let next_ann = match ann {
        Some(_) => ann,
        None => Some(Array::get(param_types, i))
      }
      ArrayBuilder::push(out, (name, next_ann))
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
}

fn apply_generic_fn_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr, param_types: Array[TypeExpr], ret_ty: TypeExpr, effect_name: Option[String]) -> (Option[TypeExpr], Expr) {
  match val {
    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {
      let next_params = apply_fn_annotation_params(params, param_types)
      let next_ret = match ret_opt {
        Some(_) => ret_opt,
        None => Some(ret_ty)
      }
      let next_effect = match effect_opt {
        Some(_) => effect_opt,
        None => effect_name
      }
      let next_type_params = if Array::length(type_params) > 0 {
        type_params
      } else existing_type_params
      let next_type_bounds = if Array::length(type_params) > 0 {
        type_bounds
      } else existing_type_bounds
      let next_ann = if Array::length(type_params) > 0 {
        None
      } else ann
      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))
    },
    _ => (ann, val)
  }
}

fn apply_generic_let_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr) -> (Option[TypeExpr], Expr) {
  match ann {
    Some(ann_ty) => match ann_ty {
      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),
      _ => (ann, val)
    },
    _ => (ann, val)
  }
}

/// Inject a value-position type-parameter header `[T: Ord]` (from
/// `let f = [T: Ord](...)`) into the resulting lambda's EFn type_params/bounds.
/// Previously these were skipped and discarded, so the lambda had no type
/// params: the body checked with `T` as a concrete `CtNamed("T")` rather than a
/// bound type variable. That happened to work standalone (unresolved type names
/// are tolerated) but broke once the module was re-exported and re-checked.
fn apply_value_bracket_type_params(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {
  if Array::length(tps) == 0 {
    val
  } else {
    match val {
      EFn(existing_tp, existing_tb, params, ret, eff, body) => {
        let next_tp = if Array::length(existing_tp) > 0 {
          existing_tp
        } else tps
        let next_tb = if Array::length(existing_tp) > 0 {
          existing_tb
        } else tbs
        EFn(next_tp, next_tb, params, ret, eff, body)
      },
      _ => val
    }
  }
}

fn skip_generic_value_start(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TLBracket => match peek(tokens, pos + 1) {
      TIdent(_) => {
        let maybe_generic = match peek(tokens, pos + 2) {
          TRBracket => match peek(tokens, pos + 3) {
            TLParen => true,
            _ => false
          },
          TColon => true,
          TComma => true,
          _ => false
        }
        if maybe_generic {
          let mut scan_pos = pos + 1
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, scan_pos) {
              TLBracket => {
                depth = depth + 1
              },
              TRBracket => {
                depth = depth - 1
              },
              _ => ()
            }
            scan_pos = scan_pos + 1
          }
          scan_pos
        } else {
          pos
        }
      },
      _ => pos
    },
    _ => pos
  }
}

/// Parse a value-position generic header `[T: Ord]` at `pos` (just after `=`)
/// when one is present, returning its type params/bounds plus the position of
/// the value that follows. When there is no generic header (e.g. an array
/// literal `[1, 2]`), returns empty params and `pos` unchanged.
fn parse_value_bracket_header(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with Error {
  let skipped = skip_generic_value_start(tokens, pos)
  if skipped == pos {
    (_no_tp(), _no_tb(), pos)
  } else {
    match peek(tokens, pos) {
      TLBracket => {
        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)
        (tps, tbs, skipped)
      },
      _ => (_no_tp(), _no_tb(), skipped)
    }
  }
}

/// #1281: is this pattern irrefutable — i.e. can it fail to match? A top-level
/// binding has nowhere to fail to, so only shapes that always match are
/// allowed: bindings, `_`, tuples and struct/record patterns of those. Enum
/// variants (`Some(x)`), literals and `|` alternatives are refutable.
fn is_irrefutable_top_level_pat(p: Pat) -> Bool {
  match p {
    PBind(_) => true,
    PWild => true,
    PTuple(elems) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(elems) {
        if !is_irrefutable_top_level_pat(Array::get(elems, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    PStruct(_, fields) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(fields) {
        let (_fname, fpat) = Array::get(fields, i)
        if !is_irrefutable_top_level_pat(fpat) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => false
  }
}

fn refutable_top_level_pat_error() -> Unit with Error {
  throw("top-level 'let <pattern> = <expr>' requires an irrefutable pattern -- tuple / struct / record of bindings (#1281). Enum-variant, literal and '|' patterns can fail to match; destructure them with 'match' inside a function instead")
}

fn require_irrefutable_top_level_pat(p: Pat) -> Unit with Error {
  if is_irrefutable_top_level_pat(p) {
    ()
  } else {
    refutable_top_level_pat_error()
  }
}

/// A top-level pattern `let` takes no type annotation: there is no single
/// binding to hang it on. Reject the `let (a, b): T = e` spelling explicitly
/// rather than letting `expect_tk` report a bare "expected = but got :".
fn reject_pattern_let_annotation(tokens: Array[Token], pos: Int) -> Int with Error {
  match peek(tokens, pos) {
    TColon => throw("a top-level 'let <pattern> = <expr>' takes no type annotation (#1281); annotate the value expression's own binding instead"),
    _ => pos
  }
}

/// Tag an anonymous-record destructure so `expand_top_level_pattern_lets` can
/// tell it from a real tuple pattern (both arrive as `PTuple`). Field names
/// are not recovered by `parse_pattern` — the record path is positional, the
/// same convention the block-level `__rec_field` desugar uses — so the marker
/// carries empty names and the expansion reads by index.
fn record_destr_marker(p: Pat) -> Pat {
  match p {
    PTuple(elems) => {
      let fields = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(elems) {
        ArrayBuilder::push(fields, ("", Array::get(elems, i)))
        i = i + 1
      }
      PStruct("record", ArrayBuilder::freeze(fields))
    },
    _ => p
  }
}

/// `SLetPat` carries no `exported` flag, so an exported pattern `let` has
/// nowhere to record that; point at the two-statement spelling instead of
/// silently dropping the export.
fn top_level_pattern_let(exported: Bool, pat: Pat, val: Expr) -> Stmt with Error {
  if exported {
    throw("top-level 'export let <pattern> = <expr>' is not supported (#1281); write 'let <pattern> = <expr>' and export the names with a separate 'export { a, b }'")
  } else {
    SLetPat(pat, val)
  }
}

/// #1281: expand top-level `SLetPat` into plain top-level bindings.
///
///   let (a, b) = e     ==>   let __dst0 = e
///                            let a = __dst0.0
///                            let b = __dst0.1
///
/// The value expression moves into ONE hidden binding, so it is evaluated
/// exactly once no matter how many names the pattern binds, and every
/// projection is an ordinary top-level `SLet` — codegen still needs no
/// `SLetPat` case (#859). Nested patterns get their own hidden binding per
/// level. Struct fields project by name (`<tmp>.field`); anonymous-record
/// fields project positionally through `__rec_field`, the same read the
/// block-level destructure emits.
export fn expand_top_level_pattern_lets(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLetPat(pat, val) => {
        let tmp = String::concat("__dst", __to_string(i))
        ArrayBuilder::push(out, SLet(false, false, tmp, None, val))
        emit_top_level_pat_bindings(out, pat, tmp)
      },
      _ => ArrayBuilder::push(out, Array::get(stmts, i))
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

/// Bind every name in `pat` from the already-bound `src` binding.
fn emit_top_level_pat_bindings(out: ArrayBuilder[Stmt], pat: Pat, src: String) -> Unit {
  match pat {
    PBind(name) => ArrayBuilder::push(out, SLet(false, false, name, None, EIdent(src, 0 - 1))),
    PWild => (),
    PTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        emit_top_level_pat_projection(out, Array::get(elems, i), EDot(EIdent(src, 0 - 1), __to_string(i), 0 - 1, 0 - 1), src, i)
        i = i + 1
      }
    },
    PStruct(sname, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fpat) = Array::get(fields, i)
        let read = if sname == "record" {
          ECall(EIdent("__rec_field", 0 - 1), [
            EIdent(src, 0 - 1),
            EInt(i)
          ], 0 - 1)
        } else {
          EDot(EIdent(src, 0 - 1), fname, 0 - 1, 0 - 1)
        }
        emit_top_level_pat_projection(out, fpat, read, src, i)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// One field of a destructured value: bind it directly when the sub-pattern is
/// a name, drop it when it is `_`, otherwise park it in a hidden binding and
/// keep destructuring from there.
fn emit_top_level_pat_projection(out: ArrayBuilder[Stmt], sub: Pat, read: Expr, src: String, index: Int) -> Unit {
  match sub {
    PBind(name) => ArrayBuilder::push(out, SLet(false, false, name, None, read)),
    PWild => (),
    _ => {
      let nested = String::concat(src, String::concat("_", __to_string(index)))
      ArrayBuilder::push(out, SLet(false, false, nested, None, read))
      emit_top_level_pat_bindings(out, sub, nested)
    }
  }
}

fn parse_let_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with Error {
  match peek(tokens, pos) {
    TRec => {
      let (name, name_next) = parse_binding_name(tokens, pos + 1)
      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)
          (tparams, tbounds, Some(ty), tp)
        },
        _ => (_no_tp(), _no_tb(), None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)
      let val_pair = parse_impl(tokens, starts, val_start_r, 0)
      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)
      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)
      let val_next = val_pair.1
      (SLet(exported, true, name, final_ty_opt, val), val_next)
    },
    TMut => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)
            (Some(ty), tp)
          },
          _ => (None, pos + 2)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let val_pair = parse_impl(tokens, starts, ep, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        (SLetMut(name, ty_opt, val), val_next)
      },
      _ => throw("expected name after 'let mut'")
    },
    // #1281 (was #859): top-level irrefutable pattern `let` — the tuple form
    // `let (a, b) = pair` here, plus the `record { .. }` / `Name::{ .. }`
    // forms below. Codegen still has no top-level `SLetPat` case, so the
    // statement produced here is expanded by `expand_top_level_pattern_lets`
    // (below) into a hidden binding holding the value plus one projection
    // binding per name: the value is evaluated exactly ONCE and codegen only
    // ever sees plain top-level `SLet`s. Refutable shapes (enum variants,
    // literals, `|`) are rejected here — they can fail, and a top-level
    // binding has nowhere to fail to.
    TLParen => {
      let (pat, after_pat) = parse_pattern(tokens, pos)
      require_irrefutable_top_level_pat(pat)
      let ep = expect_tk(tokens, reject_pattern_let_annotation(tokens, after_pat), "=")
      let val_pair = parse_impl(tokens, starts, ep, 0)
      (top_level_pattern_let(exported, pat, val_pair.0), val_pair.1)
    },
    TIdent(_name0) => {
      // #1281 (was #830): `let record { a, b } = r` — the anonymous-record
      // form of the top-level pattern `let`. `parse_pattern` returns the
      // field patterns POSITIONALLY (a `PTuple`, exactly like the block-level
      // StepRecordDestr path, which reads them back with positional
      // `__rec_field`), so the expansion below needs to tell this apart from a
      // real tuple pattern: it is re-wrapped as `PStruct("record", ..)`. A
      // lowercase name can never be a real struct pattern (`parse_pattern`
      // only takes the `PStruct` branch for an uppercase head), so the marker
      // is unambiguous.
      let is_top_level_record_destr = match peek(tokens, pos + 1) {
        TLBrace => _name0 == "record",
        _ => false
      }
      let is_struct_destructure = match peek(tokens, pos + 1) {
        TDoubleColon => match peek(tokens, pos + 2) {
          TLBrace => true,
          _ => false
        },
        _ => false
      }
      // #1281 (was #859): `let Name::{ x, y } = v` — the named-struct form.
      // `parse_pattern` returns `PStruct(name, [(field, PBind field), ..])`,
      // which the expansion turns into one `<tmp>.field` projection each.
      if is_top_level_record_destr || is_struct_destructure {
        let (ppat, after_ppat) = parse_pattern(tokens, pos)
        require_irrefutable_top_level_pat(ppat)
        let pep = expect_tk(tokens, reject_pattern_let_annotation(tokens, after_ppat), "=")
        let pval_pair = parse_impl(tokens, starts, pep, 0)
        let marked = if is_top_level_record_destr {
          record_destr_marker(ppat)
        } else {
          ppat
        }
        (top_level_pattern_let(exported, marked, pval_pair.0), pval_pair.1)
      } else {
        // `let Some(x) = e` and friends: a variant pattern reads as a binding
        // name followed by `(`, which used to surface as a bare
        // "expected = but got (". Name the real problem (#1281).
        let refutable_ctor_head = match peek(tokens, pos + 1) {
          TLParen => {
            let head_code = String::char_code_at(_name0, 0)
            head_code >= 65 && head_code <= 90
          },
          _ => false
        }
        if refutable_ctor_head {
          refutable_top_level_pat_error()
        } else {
          ()
        }
        let (name, name_next) = parse_binding_name(tokens, pos)
        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {
          TColon => {
            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)
            (tparams, tbounds, Some(ty), tp)
          },
          _ => (_no_tp(), _no_tb(), None, name_next)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)
        let val_pair = parse_impl(tokens, starts, val_start, 0)
        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)
        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)
        let val_next = val_pair.1
        (SLet(exported, false, name, final_ty_opt, val), val_next)
      }
    },
    _ => throw("expected name after 'let'")
  }
}

/// #727 (ADR-0064 Phase A): top-level `fn` sugar.
///   fn name[T: Eq](x: Int, y: Int) -> Int with E where { ... } { body }
/// desugars to the same SLet + EFn shape impl methods lower to
/// (SLet(exported, rec, name, None, EFn(tps, tbs, params, Some(ret), eff, body))),
/// so checker/codegen are untouched. Full annotations are required (every
/// param typed + explicit return type): ADR-0037's forward-reference
/// conditions then always hold, so the binding is always `rec`. The
/// `where { ... }` contract clause is brace-balance skipped for now —
/// retention + assert semantics land with Phase E (#731); until then
/// fmt/normalize reject it (same guardrail pattern as #cfg, ADR-0061).
/// Shared fn-signature head: `name[T: Eq](x: Int, y: Int) -> Ret with E
/// where { ... }` starting AFTER the `fn` keyword. Returns
/// ((name, tps, tbs), (params, ret_ty, eff_opt), (requires, ensures), next)
/// with `next` positioned after the where clause — at the body `{` for a
/// definition, or at the following statement for a .vibei contract
/// declaration (#729). The `where { requires: e, ensures: e }` contract
/// clause (#731, ADR-0064 §7) parses each condition as an ordinary Bool
/// expression; `ensures` conditions may reference the function result as
/// `result`. Multiple requires/ensures entries are allowed.
export fn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with Error {
  let (name, name_next) = parse_binding_name(tokens, pos)
  let (tps, tbs, after_gen) = parse_value_bracket_header(tokens, name_next)
  let lp = expect_tk(tokens, after_gen, "(")
  let (params, after_params) = parse_param_list(tokens, lp)
  let mut pi = 0
  while pi < Array::length(params) {
    let param = Array::get(params, pi)
    let pty = param.1
    match pty {
      Some(_) => (),
      None => throw("fn parameter '\{param.0}' requires a type annotation")
    }
    pi = pi + 1
  }
  let arrow = expect_tk(tokens, after_params, "->")
  let (ret_ty, ret_next) = parse_type_impl(tokens, arrow, 0)
  let (eff_opt, eff_next) = match peek(tokens, ret_next) {
    TWith => {
      let (eff_names, en) = parse_effect_row(tokens, ret_next + 1)
      (Some(eff_names), en)
    },
    _ => (None, ret_next)
  }
  let reqs = Array::slice([
    EIdent("", 0 - 1)
  ], 0, 0)
  let enss = Array::slice([
    EIdent("", 0 - 1)
  ], 0, 0)
  let where_next = match peek(tokens, eff_next) {
    TIdent(w) => if w == "where" {
      let mut wp = expect_tk(tokens, eff_next + 1, "{")
      let mut wdone = false
      while !wdone {
        match peek(tokens, wp) {
          TRBrace => {
            wp = wp + 1
            wdone = true
          },
          TIdent(kind) => {
            let cp = expect_tk(tokens, wp + 1, ":")
            let (cond, cnext) = parse_impl(tokens, [
            ], cp, 0)
            if kind == "requires" {
              Array::push(reqs, cond)
            } else if kind == "ensures" {
              Array::push(enss, cond)
            } else {
              throw("expected 'requires' or 'ensures' in where clause, got '\{kind}'")
            }
            wp = match peek(tokens, cnext) {
              TComma => cnext + 1,
              _ => cnext
            }
          },
          _ => throw("expected 'requires', 'ensures', or '}' in where clause")
        }
      }
      wp
    } else eff_next,
    _ => eff_next
  }
  ((name, tps, tbs), (params, ret_ty, eff_opt), (reqs, enss), where_next)
}

/// ADR-0069 Phase 1: `fn main { ... }` / `fn main with Fs { ... }` — the ONE
/// fn form allowed to omit the parens and all annotations. It is a pure sugar
/// for `fn main() -> Unit [with { .. }] { ... }`: the branch below builds the
/// exact SFnDecl shape the general path would produce for that spelling
/// (EFn([], [], [], Some(TyName("Unit")), eff_opt, body)), so lower_fn_decl_stmt,
/// checker, codegen, and the printer round-trip (which prints the annotated
/// `fn main() -> Unit` spelling — same meaning) are all untouched.
fn parse_fn_main_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with Error {
  // pos points at the `main` identifier; the caller verified the next token
  // is `{` (body) or `with` (capability row then body).
  let (eff_opt, body_start) = match peek(tokens, pos + 1) {
    TWith => {
      let (eff_names, en) = parse_effect_row(tokens, pos + 2)
      (Some(eff_names), en)
    },
    _ => (None, pos + 1)
  }
  let br = expect_tk(tokens, body_start, "{")
  let (body, end) = parse_impl(tokens, starts, br, mode_block)
  (SFnDecl(exported, "main", EFn(_no_tp(), _no_tb(), empty_params(), Some(TyName("Unit")), eff_opt, body), empty_exprs(), empty_exprs()), end)
}

fn parse_fn_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with Error {
  // ADR-0069 Phase 1: dispatch the `fn main {` / `fn main with {` special form
  // before the general signature parse (which requires `(`). `fn main(` still
  // takes the general path, so an explicit signature keeps working.
  let is_main_special = match peek(tokens, pos) {
    TIdent(n0) => if n0 == "main" {
      match peek(tokens, pos + 1) {
        TLBrace => true,
        TWith => true,
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
  if is_main_special {
    parse_fn_main_stmt(tokens, starts, pos, exported)
  } else {
    parse_fn_stmt_general(tokens, starts, pos, exported)
  }
}

/// #805 (ADR-0072): `fn name(a: Int, b: Int) -> Int = wasm "(...)"` — an
/// inline-wasm-bodied fn (linear backend only). The declared signature is
/// TRUSTED, extern-let style; the body is raw WAT text carried through the
/// existing AST as the unspoofable marker call `%wasm("<text>")` (a real
/// `%`-ident can never be parsed in expression position — TPercent is only
/// the mod operator — so user source cannot forge it). Multiple adjacent
/// string literals are joined with newlines (the lexer has no raw/multiline
/// strings). v0.3 slice restrictions enforced here: monomorphic, empty
/// effect row, no where-contracts, and every param + the return type spelled
/// literally `Int` (raw 62-bit tagged i64 at the boundary, ADR-0055).
fn parse_fn_wasm_body(tokens: Array[Token], pos: Int, exported: Bool, name: String, tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String], reqs: Array[Expr], enss: Array[Expr]) -> (Stmt, Int) with Error {
  // pos is at the token AFTER `= wasm`.
  if Array::length(tps) > 0 {
    throw("inline wasm fn '\{name}' cannot take type parameters (v0.3: monomorphic only) at #\{pos}")
  } else {
    ()
  }
  match eff_opt {
    Some(_) => throw("inline wasm fn '\{name}' must have an empty effect row (remove the 'with { ... }' clause) at #\{pos}"),
    None => ()
  }
  if Array::length(reqs) > 0 || Array::length(enss) > 0 {
    throw("inline wasm fn '\{name}' cannot declare where-contracts at #\{pos}")
  } else {
    ()
  }
  let mut wi = 0
  while wi < Array::length(params) {
    let (pn, pt) = Array::get(params, wi)
    // Int params cross the boundary as raw 62-bit tagged i64 (ADR-0055).
    // Bytes params (#805 SIMD follow-up) pass the raw UNTAGGED object
    // pointer — the WAT body reads the length at obj+4 and the data pointer
    // at obj+8 (linear backend heap layout), e.g. to feed v128.load.
    let ok = match pt {
      Some(TyName(tn)) => tn == "Int" || tn == "Bytes",
      _ => false
    }
    if !ok {
      throw("inline wasm fn '\{name}': param '\{pn}' must be typed Int or Bytes (raw i64 at the boundary) at #\{pos}")
    } else {
      ()
    }
    wi = wi + 1
  }
  let ret_ok = match ret_ty {
    TyName(rn) => rn == "Int",
    _ => false
  }
  if !ret_ok {
    throw("inline wasm fn '\{name}': return type must be Int (v0.3 slice: raw tagged i64 result only) at #\{pos}")
  } else {
    ()
  }
  match peek(tokens, pos) {
    TString(first) => {
      let mut text = first
      let mut sp = pos + 1
      let mut more = true
      while more {
        match peek(tokens, sp) {
          TString(nxt) => {
            text = String::concat(text, String::concat("\n", nxt))
            sp = sp + 1
          },
          _ => {
            more = false
          }
        }
      }
      let marker = ECall(EIdent("%wasm", -1), [
        EString(text)
      ], -1);
      (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), None, marker), reqs, enss), sp)
    },
    _ => throw("expected WAT string literal after '= wasm' in fn '\{name}' at #\{pos}")
  }
}

fn parse_fn_stmt_general(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with Error {
  let (head, sig, contracts, where_next) = parse_fn_signature(tokens, pos)
  let (name, tps, tbs) = head
  let (params, ret_ty, eff_opt) = sig
  let (reqs, enss) = contracts
  // #805: `= wasm "..."` inline-wasm body form (see parse_fn_wasm_body).
  let is_wasm_body = match peek(tokens, where_next) {
    TEq => match peek(tokens, where_next + 1) {
      TIdent(kw) => kw == "wasm",
      _ => false
    },
    _ => false
  }
  if is_wasm_body {
    parse_fn_wasm_body(tokens, where_next + 2, exported, name, tps, tbs, params, ret_ty, eff_opt, reqs, enss)
  } else {
    let br = expect_tk(tokens, where_next, "{")
    let (body, end) = parse_impl(tokens, starts, br, mode_block)
    // ADR-0064 (#727/#731): keep the declaration form — including the where
    // contract's requires/ensures conditions — in the AST so the printer and
    // normalize can round-trip `fn`. The runtime contract desugar (identical
    // semantics to the old parse-time inline form) lives in
    // lower_fn_decl_stmt, applied by parse_stmt / parse_program before the
    // checker/codegen ever see the program.
    (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), eff_opt, body), reqs, enss), end)
  }
}

/// #731 (ADR-0064 §7 Phase 1): where-contract desugar + fn-declaration
/// lowering to the legacy `let rec` shape. requires conditions assert at
/// entry; ensures conditions bind the body's value as `result` and assert at
/// exit. v1 semantics are Eiffel-style ALWAYS-ON runtime checks (a violating
/// call traps); compile-time stripping for release builds is a later
/// refinement. Known limits (documented): an early `return` inside the body
/// bypasses ensures; `result` shadows any user binding of that name inside
/// ensures conditions. Applied by the default parse entry points
/// (parse_stmt / parse_program*) so checker/codegen keep seeing the
/// pre-#727 `SLet(exported, true, name, None, EFn(..))` shape; only the
/// *_preserving entry points hand out SFnDecl.
export fn lower_fn_decl_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SFnDecl(exported, name, fn_value, reqs, enss) => match fn_value {
      EFn(tps, tbs, params, ret_opt, eff_opt, body) => {
        let body_with_ensures = if Array::length(enss) == 0 {
          body
        } else {
          let mut exit_expr = EIdent("result", 0 - 1)
          let mut ei = Array::length(enss)
          while ei > 0 {
            ei = ei - 1
            exit_expr = ESeq(ECall(EIdent("assert", 0 - 1), [
              Array::get(enss, ei)
            ], 0 - 1), exit_expr)
          }
          ELet("result", body, exit_expr, -1)
        }
        let mut guarded = body_with_ensures
        let mut qi = Array::length(reqs)
        while qi > 0 {
          qi = qi - 1
          guarded = ESeq(ECall(EIdent("assert", 0 - 1), [
            Array::get(reqs, qi)
          ], 0 - 1), guarded)
        }
        SLet(exported, true, name, None, EFn(tps, tbs, params, ret_opt, eff_opt, guarded))
      },
      _ => SLet(exported, true, name, None, fn_value)
    },
    // #819: an example is compiled and run as a test. Lowering it here (rather
    // than teaching every downstream pass about a third block form) is what
    // keeps the ~106 STest sites untouched; the distinction survives only for
    // the *_preserving consumers.
    SExample(name, body) => STest(name, body),
    _ => stmt
  }
}

export fn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt] {
  for s in stmts {
    lower_fn_decl_stmt(s)
  }
}

