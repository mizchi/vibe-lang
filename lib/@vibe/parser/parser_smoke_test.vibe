//# Imports

import ./lexer.vibe {
  lex, lex_ok, lex_with_offsets
}

import ./parser.vibe {
  parse_program, parse_program_located, parse_program_preserving, parse_program_recovering, parse_program_spans
}

import ./printer.vibe {
  print_program
}

import @vibe/ast {
  Expr, ImportItem, Stmt
}

//# Tests
// #881: lib/@vibe/parser had zero direct tests -- every existing check ran
// indirectly through the compiler's syntax/ shims (tests/parser_*_test.vibe
// in lib/@vibe/compiler). These exercise the package's own lex/parse_program
// entry points directly, with no compiler layer in between.

fn fn_generic_lanes_at(stmts: Array[Stmt], index: Int) -> (Array[String], Array[(String, Array[String])]) {
  match Array::get(stmts, index) {
    SLet(_, _, _, _, EFn(type_params, type_bounds, _, _, _, _)) => (type_params, type_bounds),
    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()))
  }
}

test "lex: simple token stream is non-empty" {
  let tokens = lex("let x = 1")
  assert(Array::length(tokens) > 0)
}

test "lex_ok: well-formed source lexes cleanly" {
  assert(lex_ok("let x = 1 + 2"))
}

test "parse_program: single let binding" {
  let tokens = lex("let x = 42")
  let stmts = parse_program(tokens)
  assert(Array::length(stmts) == 1)
}

test "#2127: an untyped no-arrow lambda says the parameter needs a type" {
  let src = "let f = (n) { n + 1 }\n"
  let msg = handle {
    let (tokens, starts, _) = lex_with_offsets(src)
    let _ = parse_program_located(tokens, starts, src)
    "ok"
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "needs a type"))
  assert(String::contains(msg, "n"))
  assert(!String::contains(msg, "unknown name: n"))
}

test "#2127: parenthesized if-condition is not a missing-type lambda" {
  let src = "let n = true\nlet v = if (n) { 1 } else { 0 }\n"
  let msg = handle {
    let _ = parse_program(lex(src))
    "ok"
  } with { Exception::Throw(m) => m }
  assert(msg == "ok")
}

test "#2127: if !(n) { is not a missing-type lambda" {
  let src = "let n = true\nlet v = if !(n) { 1 } else { 0 }\n"
  let msg = handle {
    let _ = parse_program(lex(src))
    "ok"
  } with { Exception::Throw(m) => m }
  assert(msg == "ok")
}

test "#2127: if true && (n) { is not a missing-type lambda" {
  let src = "let n = true\nlet v = if true && (n) { 1 } else { 0 }\n"
  let msg = handle {
    let _ = parse_program(lex(src))
    "ok"
  } with { Exception::Throw(m) => m }
  assert(msg == "ok")
}

test "#2264: an effect operation with its own row names the rule at `with`" {
  let src = "effect E {\n  Op(n: Int) -> Int with Fs\n}\n"
  let msg = handle {
    let (tokens, starts, _) = lex_with_offsets(src)
    let _ = parse_program_located(tokens, starts, src)
    "ok"
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "cannot declare its own effect row"))
  assert(String::contains(msg, "handler"))
  assert(!String::contains(msg, "expected effect operation name or '}'"))
  assert(!String::starts_with(msg, "line 1:1:"))
}

test "#2265: statement-form throw names the call form" {
  let src = "fn f() -> Int with Exception { throw NotFound(\"x\") }\n"
  let msg = handle {
    let (tokens, starts, _) = lex_with_offsets(src)
    let _ = parse_program_located(tokens, starts, src)
    "ok"
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "called like a function"))
  assert(String::contains(msg, "throw("))
  assert(!String::contains(msg, "expected ("))
  assert(!String::starts_with(msg, "line 1:1:"))
}

test "parse_program: #zero_alloc normalizes to the allocation-check marker" {
  let stmts = parse_program(lex("#zero_alloc\nfn hot(x: Int) -> Int { x + 1 }"))
  assert(Array::length(stmts) == 2)
  let marker = match Array::get(stmts, 0) {
    SExpr(EIdent(name, _)) => name,
    _ => ""
  }
  assert_eq(marker, "@zero_alloc")
}

test "parse_program: #zero_alloc accepts an exported fn" {
  let stmts = parse_program(lex("#zero_alloc\nexport fn hot(x: Int) -> Int { x + 1 }"))
  assert(Array::length(stmts) == 2)
}

test "parse_program: #zero_alloc rejects a non-fn target before linking" {
  let result = handle {
    let _ = parse_program(lex("#zero_alloc\nlet hot = 1"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "#zero_alloc must immediately precede a fn declaration"))
}

test "parse_program: legacy @zero_alloc remains accepted during migration" {
  let stmts = parse_program(lex("@zero_alloc\nfn hot(x: Int) -> Int { x + 1 }"))
  assert(Array::length(stmts) == 2)
}

test "an ordinary export named like the old boundary sentinel stays an export" {
  let source = "export { __vibe_reexport_boundary__, assert_eq }"
  let stmts = parse_program(lex(source))
  match Array::get(stmts, 0) {
    SExport(names) => {
      inspect(Array::length(names), "2")
      inspect(Array::get(names, 0), "__vibe_reexport_boundary__")
      inspect(Array::get(names, 1), "assert_eq")
    },
    _ => assert(false)
  }
  inspect(print_program(stmts), source)
}

test "a boundary-looking comment remains trivia" {
  let source = "//#reexport_source_boundary\nexport { assert_eq, inspect }\nexport { inspect }"
  let stmts = parse_program(lex(source))
  inspect(Array::length(stmts), "2")
  match Array::get(stmts, 0) {
    SExport(names) => {
      inspect(Array::length(names), "2")
      inspect(Array::get(names, 0), "assert_eq")
      inspect(Array::get(names, 1), "inspect")
    },
    _ => assert(false)
  }
  match Array::get(stmts, 1) {
    SExport(names) => inspect(Array::get(names, 0), "inspect"),
    _ => assert(false)
  }
  inspect(print_program(stmts), "export { assert_eq, inspect }\nexport { inspect }")
}

fn zero_alloc_marker_name(stmts: Array[Stmt]) -> String {
  match Array::get(stmts, 0) {
    SExpr(EIdent(name, _)) => name,
    _ => ""
  }
}

test "parse_program: #zero_alloc(strict) and (assume) become distinct markers" {
  let strict_stmts = parse_program(lex("#zero_alloc(strict)\nfn hot(x: Int) -> Int { x + 1 }"))
  let assume_stmts = parse_program(lex("#zero_alloc(assume)\nfn hot(x: Int) -> Int { x + 1 }"))
  let bare_stmts = parse_program(lex("#zero_alloc\nfn hot(x: Int) -> Int { x + 1 }"))
  assert_eq(zero_alloc_marker_name(strict_stmts), "@zero_alloc_strict")
  assert_eq(zero_alloc_marker_name(assume_stmts), "@zero_alloc_assume")
  assert_eq(zero_alloc_marker_name(bare_stmts), "@zero_alloc")
}

test "parse_program: unknown #zero_alloc mode fails closed" {
  let result = handle {
    let _ = parse_program(lex("#zero_alloc(loose)\nfn hot(x: Int) -> Int { x + 1 }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "#zero_alloc unknown mode"))
}

test "parse surfaces agree on #zero_alloc(strict) marker" {
  let src = "#zero_alloc(strict)\nfn hot(x: Int) -> Int { x + 1 }"
  let tokens = lex(src)
  let (otokens, starts, ends) = lex_with_offsets(src)
  let via_program = zero_alloc_marker_name(parse_program(tokens))
  let via_preserving = zero_alloc_marker_name(parse_program_preserving(tokens))
  let via_located = zero_alloc_marker_name(parse_program_located(otokens, starts, src))
  let (recovered, rec_errs) = parse_program_recovering(otokens, starts, src)
  let via_recovering = zero_alloc_marker_name(recovered)
  let (span_stmts, span_starts, _) = parse_program_spans(otokens, starts, ends)
  assert_eq(via_program, "@zero_alloc_strict")
  assert_eq(via_preserving, "@zero_alloc_strict")
  assert_eq(via_located, "@zero_alloc_strict")
  assert_eq(via_recovering, "@zero_alloc_strict")
  assert_eq(Array::length(rec_errs), 0)
  assert(Array::length(span_stmts) == 1)
  assert(Array::get(span_starts, 0) == 0)
}

test "parse_program: multiple top-level statements" {
  let tokens = lex("let x = 1\nlet y = 2\nlet z = x + y")
  let stmts = parse_program(tokens)
  assert(Array::length(stmts) == 3)
}

test "parse_program: function declaration" {
  let tokens = lex("fn add(a: Int, b: Int) -> Int { a + b }")
  let stmts = parse_program(tokens)
  assert(Array::length(stmts) == 1)
}

test "parse_program: empty generic lanes stay fresh per declaration" {
  let stmts = parse_program(lex("fn first() -> Int { 1 }\nfn second() -> Int { 2 }"))
  let (first_params, first_bounds) = fn_generic_lanes_at(stmts, 0)
  let (second_params, second_bounds) = fn_generic_lanes_at(stmts, 1)
  Array::push(first_params, "Injected")
  Array::push(first_bounds, ("Injected", ["Eq"]))
  assert_eq(Array::length(second_params), 0)
  assert_eq(Array::length(second_bounds), 0)
}

test "parse_program: empty import item arrays stay fresh per declaration" {
  let stmts = parse_program(lex("import ./first.vibe {}\nimport ./second.vibe {}"))
  let first_items = match Array::get(stmts, 0) {
    SImport(_, items) => items,
    _ => ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let second_items = match Array::get(stmts, 1) {
    SImport(_, items) => items,
    _ => ArrayBuilder::freeze(ArrayBuilder::new())
  }
  Array::push(first_items, ImportItem::{
    kind: None,
    name: "Injected",
    alias: None
  })
  assert_eq(Array::length(second_items), 0)
}

test "parse_program: import item kinds survive parse and print" {
  let source = "import ./dep.vibe { type Alias, struct Point as P, enum Color, effect Console, trait Show, println }"
  assert_eq(print_program(parse_program(lex(source))), source)
}

test "parse_program: re-export item kinds survive parse and print" {
  let source = "export ./dep.vibe { type Alias, struct Point, enum Color, effect Console, trait Show, println }"
  assert_eq(print_program(parse_program(lex(source))), source)
}

test "parse_program: taskgroup accepts the empty source-offset lane (#1780)" {
  let stmts =
  parse_program(lex("fn run() -> Int { taskgroup { g => 7 } }"))
  assert(Array::length(stmts) == 1)
}

test "parse_program: region accepts the empty source-offset lane (#1780)" {
  let stmts = parse_program(lex("fn build() -> Array[Int] { region r { [7] } }"))
  assert(Array::length(stmts) == 1)
}

test "parse_program: vibex import is rejected" {
  let result = handle {
    let _ = parse_program(lex("import ./tool.vibex { run }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(result == ".vibex is an executable root and cannot be imported: ./tool.vibex")
}

//# #1455 step 3: the qualified-pattern log lives with the parsed program

/// The `(qualifier, variant)` pairs the parse attached, as `Q::V` strings.
fn qualified_pattern_refs_of(stmts: Array[Stmt]) -> Array[String] {
  let out = Array::slice([""], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SQualifiedPatternRefs(refs) => {
        let mut ri = 0
        while ri < Array::length(refs) {
          let (q, v) = Array::get(refs, ri)
          Array::push(out, String::concat(q, String::concat("::", v)))
          ri = ri + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn contains_ref(refs: Array[String], want: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(refs) {
    if Array::get(refs, i) == want {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn color_program() -> String {
  "enum Color { Red; Green }\nfn f(c: Color) -> Int { match c { Color::Red => 1, Color::Green => 2 } }"
}

test "#1455: a qualified variant pattern is recorded on the parsed program" {
  let refs = qualified_pattern_refs_of(parse_program(lex(color_program())))
  assert(contains_ref(refs, "Color::Red"))
  assert(contains_ref(refs, "Color::Green"))
}

test "#1455: EVERY parse of the same source carries the refs" {
  // The pairs used to live in a process-global log that the checker drained.
  // runtime/typecheck_fs.vibe memoizes statements by (path, source) and hands
  // out a copy WITHOUT re-running the parser, so a second check found an
  // empty log and skipped validation silently. Riding the statement array is
  // what makes the second parse -- and a memo replay of the first -- carry the
  // same pairs as the first.
  let first = qualified_pattern_refs_of(parse_program(lex(color_program())))
  let second = qualified_pattern_refs_of(parse_program(lex(color_program())))
  assert_eq(Array::length(second), Array::length(first))
  assert(contains_ref(second, "Color::Red"))
}

test "#1455: one parse's refs do not leak into the next program" {
  // A parse whose module is never type-checked (`vibe fmt`, an unchecked LSP
  // buffer) must not leave its pairs for a later, unrelated program to be
  // validated against.
  let _first = parse_program(lex(color_program()))
  let plain = qualified_pattern_refs_of(parse_program(lex("fn g() -> Int { 1 }")))
  assert_eq(Array::length(plain), 0)
}

test "#1455: a program with no qualified pattern carries no marker" {
  let refs = qualified_pattern_refs_of(parse_program(lex("enum Color { Red; Green }\nfn f(c: Color) -> Int { match c { Red => 1, Green => 2 } }")))
  assert_eq(Array::length(refs), 0)
}

// #1461 retired `Error` as an effect spelling; #1501 extended the rejection
// from row items to the handled-effect name. Before #1501 the two positions
// disagreed -- `with Error` in a signature was a parse error while
// `handle .. with Error { .. }` compiled -- and nothing tested either one, so
// the asymmetry was invisible. These pin all four cases: reject in both
// positions, and DON'T reject the two spellings that are not row labels.

test "parse_program: `Error` is rejected as a row label" {
  let result = handle {
    let _ = parse_program(lex("fn f() -> Int with Error { throw(\"x\") }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "`Error` was retired as an effect spelling in #1461"))
}

test "parse_program: `Error` is rejected as a handled-effect name (#1501)" {
  let result = handle {
    let _ =
    parse_program(lex("fn g() -> Int { handle { 1 } with Error { Throw(_) => 0 } }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "`Error` was retired as an effect spelling in #1461"))
}

test "parse_program: `Exception` is accepted in both positions" {
  let src = "fn f() -> Int with Exception { throw(\"x\") }\nfn g() -> Int { handle { f() } with Exception { Throw(_) => 0 } }"
  let stmts = parse_program(lex(src))
  assert(Array::length(stmts) == 2)
}

test "#2335: impl targets preserve concrete, reordered, and generic arguments" {
  let accepted = parse_program(lex("trait M\nimpl [K, V] M for Map[K, V]"))
  assert(Array::length(accepted) == 2)
  assert(String::contains(print_program(accepted), "impl [K, V] M for Map[K, V]"))
  let trailing = parse_program(lex("trait M\nimpl [T] M for Array[T,]"))
  assert(Array::length(trailing) == 2)
  let grouped = parse_program(lex("trait M\nimpl [T] M for Array[((T))]"))
  assert(Array::length(grouped) == 2)
  let concrete = parse_program(lex("trait M\nimpl M for Array[Int]"))
  assert(String::contains(print_program(concrete), "impl M for Array[Int]"))
  let reordered = parse_program(lex("trait M\nimpl [K, V] M for Map[V, K]"))
  assert(String::contains(print_program(reordered), "impl [K, V] M for Map[V, K]"))
}

test "parse_program: an empty handler arm set is rejected (#1678)" {
  let result = handle {
    let _ =
    parse_program(lex("fn g() -> Int { handle { 1 } with Exception { } }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "handler for `Exception` must contain at least one arm"))
}

test "parse_program: an empty qualified handler set is rejected (#1678)" {
  let result = handle {
    let _ = parse_program(lex("fn g() -> Int { handle { 1 } with { } }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "handler set must contain at least one arm"))
}

test "parse_program: handler-set arms must name an exact operation" {
  let result = handle {
    let _ = parse_program(lex("fn g() -> Int { handle { 1 } with { Throw(_) => 0 } }"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::contains(result, "fully qualified operation"))
}

test "parse_program: `perform Error::Throw` stays legal (operation qualifier)" {
  // Not a row item: it names the operation the runtime dispatches, so the
  // #1461 retirement deliberately does not reach it.
  let tokens = lex("fn f() -> Int with Exception { perform Error::Throw(\"x\") }")
  let stmts = parse_program(tokens)
  assert(Array::length(stmts) == 1)
}

fn unexpected_token_probe_source() -> String {
  "test \"p\" {\n  let ys = Array::map([1,2,3], fn(x) { x * 2 })\n}\n"
}

fn assert_unexpected_token_clean(result: String) -> Unit {
  assert(String::contains(result, "unexpected token: fn"))
  assert(!String::contains(result, " at #"))
  assert(!String::contains(result, "prev="))
  assert(!String::contains(result, "next="))
}

fn recovered_let_named(stmts: Array[Stmt], want: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => {
        found = name == want
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

test "#1862: raw parse_program unexpected-token has no token-index debris" {
  // tokens-only parse_program has empty starts, so it cannot honestly
  // locate. It must still drop the token index and lexer (prev/next)
  // debris instead of inventing a line:col from a leftover source.
  let result = handle {
    let _ = parse_program(lex("let x = fn"))
    "OK"
  } with { Exception::Throw(e) => e }
  assert_eq(result, "unexpected token: fn")
  let probe = handle {
    let _ = parse_program(lex(unexpected_token_probe_source()))
    "OK"
  } with { Exception::Throw(e) => e }
  assert_unexpected_token_clean(probe)
  assert(!String::contains(probe, "line "))
}

test "#1862: tokens-only parse does not claim a location from a later lex" {
  let tokens_a = lex("let x = fn")
  let _ = lex("\n\n\n\n\nlet y = fn")
  let result = handle {
    let _ = parse_program(tokens_a)
    "OK"
  } with { Exception::Throw(e) => e }
  assert_eq(result, "unexpected token: fn")
  assert(!String::contains(result, "line "))
}

test "#1862: parse_program_located unexpected-token stays single-located" {
  let src = unexpected_token_probe_source()
  let result = handle {
    let (tokens, starts, _) = lex_with_offsets(src)
    let _ = lex("\n\n\n\n\nlet y = fn")
    let _ = parse_program_located(tokens, starts, src)
    "OK"
  } with { Exception::Throw(e) => e }
  assert_unexpected_token_clean(result)
  assert(String::starts_with(result, "line "))
  let rest = String::substring(result, 5, String::length(result))
  assert(String::index_of(rest, "line ") < 0)
}

test "#1862: recovering unexpected-token resyncs at the failing token" {
  // Inner `let` looks like a recovery point. Resyncing from the statement
  // start (the old `at #N` extract now returns start_pos) re-parses that
  // `let` and duplicates the diagnostic. The throw site keeps the failing
  // token index aside so recovery skips to `let ok`.
  let src = "test \"p\" {\n  let ys = Array::map([1,2,3], fn(x) { x * 2 })\n}\nlet ok = 1\n"
  let (tokens, starts, _) = lex_with_offsets(src)
  let (stmts, diags) = parse_program_recovering(tokens, starts, src)
  assert_eq(Array::length(diags), 1)
  assert_unexpected_token_clean(Array::get(diags, 0))
  assert(String::starts_with(Array::get(diags, 0), "line "))
  assert(recovered_let_named(stmts, "ok"))
}

// A reserved word in a binder position. `fn test() ...` already named the word
// and the escape (`r#test`); `let test = 1` and `fn f(test: Int)` said only
// that a name was expected -- and at a `let` the name IS there, so the message
// pointed at the one thing that was fine. Six binder positions, one
// explanation. `fn` is the single word `r#` does not rescue, and the message
// says that instead of offering an escape that does not work.
fn parse_error(src: String) -> String {
  handle {
    let _ = parse_program(lex(src))
    "OK: accepted"
  } with { Exception::Throw(e) => e }
}

test "reserved word: every binder position names the word and the escape" {
  let cases = [
    ("let test = 1", "binding"),
    ("fn main() -> Unit { let test = 1 }", "binding"),
    ("fn main() -> Unit { let mut test = 1 }", "binding"),
    ("fn main() -> Unit { let* test = 1 }", "binding"),
    ("fn test() -> Int { 1 }", "function"),
    ("fn f(test: Int) -> Int { 1 }", "parameter")
  ]
  let mut i = 0
  while i < Array::length(cases) {
    let (src, kind) = Array::get(cases, i)
    let msg = parse_error(src)
    assert(String::contains(msg, "`test` is a reserved word and cannot be used as a \{kind} name"))
    assert(String::contains(msg, "write `r#test` to use it as a name"))
    i = i + 1
  }
}

test "reserved word: the escape actually works" {
  assert(Array::length(parse_program(lex("let r#test = 1"))) == 1)
  assert(Array::length(parse_program(lex("fn r#test() -> Int { 1 }"))) == 1)
  assert(Array::length(parse_program(lex("fn f(r#test: Int) -> Int { r#test }"))) == 1)
}

test "reserved word: `fn` is the one word `r#` does not rescue" {
  let plain = parse_error("let fn = 1")
  let raw = parse_error("let r#fn = 1")
  assert(String::contains(plain, "this keyword cannot be escaped"))
  assert(String::contains(raw, "this keyword cannot be escaped"))
  // ...and it must NOT offer `r#fn`, which does not work.
  assert(!String::contains(plain, "write `r#fn`"))
  assert(!String::contains(raw, "write `r#fn`"))
}

test "reserved word: a non-word token still gets the plain expectation" {
  assert(String::contains(parse_error("let 42 = 1"), "expected binding name after 'let', got 'int'"))
  assert(String::contains(parse_error("fn f( -> Int { 1 }"), "expected parameter name, got '->'"))
}

// #2126 regression. The parser's six binder-error sites bind the offending
// token in a catch-all arm (`token => ..`) and hand it to `tk_name`, which
// OWNS its parameter (`tk_name tok drop 1` in the Perceus plan). Before the
// codegen fix that binding carried no reference of its own, so the callee
// released one the binder never held and freed the scrutinee -- an element of
// the token array. A later read of the same index then got freed memory whose
// tag matched no constructor, and `tk_name`'s exhaustive match reported it as
// `RuntimeError: unreachable`, from a DIFFERENT function than the one that
// bound it.
//
// The tree used to spell these `_ =>` plus a second `peek` to dodge it. That
// workaround is gone, so these tests are what keeps it gone: they run the
// RECOVERING parser, which continues past the first error and re-reads the
// token array afterwards, which is what made the free observable.
test "2126: the recovering parser survives a reserved word in a parameter" {
  let src = "fn f(test: Int) -> Int { 1 }"
  let (toks, starts, _ends) = lex_with_offsets(src)
  let (_stmts, errs) = parse_program_recovering(toks, starts, src)
  assert(Array::length(errs) > 0)
  assert(String::contains(Array::get(errs, 0), "reserved word"))
}

test "2126: ...and at the other binder positions" {
  let cases = [
    "let test = 1",
    "fn main() -> Unit { let test = 1 }",
    "fn test() -> Int { 1 }"
  ]
  let mut i = 0
  while i < Array::length(cases) {
    let src = Array::get(cases, i)
    let (toks, starts, _ends) = lex_with_offsets(src)
    let (_stmts, errs) = parse_program_recovering(toks, starts, src)
    assert(Array::length(errs) > 0)
    i = i + 1
  }
}
