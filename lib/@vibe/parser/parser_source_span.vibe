import @vibe/ast {
  Expr, Pat, TypeExpr
}
import ./parser_binder_context.vibe {
  ParserBinderContext, SourceBinder, binder_capture_context
}

// Source annotations exist only in the opt-in tooling parse. The sentinel is
// not a source identifier. Ordinary parsing and compilation never emit it.
//
// Metadata layouts (all intervals are half-open byte offsets):
// - Expr: ECall(EIdent(marker, start), [node, end, name_slots,
//   syntax_start, syntax_end], start). Each name slot is a (start, end) tuple.
// - Pat: PCtor(marker, [node, start, end, head_start, head_end,
//   qualifier_start, qualifier_end]). Bounds use PInt.
// - Type: TyApp(marker, [node, start, end, head_start, head_end]). Bounds use
//   decimal TyName strings; TyUnit denotes a missing head token.
//
// Accessors keep these details out of consumers. A replacement that preserves
// an occurrence must retain its wrapper; generated children remain unwrapped.
export fn source_expr(_ expr: Expr) -> Expr {
  match expr {
    ECall(EIdent("$source_span", _), args, _, _) => Array::get(args, at = 0),
    _ => expr
  }
}

export fn source_expr_range(_ expr: Expr) -> (Int, Int) {
  match expr {
    ECall(EIdent("$source_span", start), args, _, _) => match Array::get(args, at = 1) {
      EInt(end) => if start >= 0 && end >= start {
        (start, end)
      } else {
        (-1, -1)
      },
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

fn source_annotate(expr: Expr, start: Int, end: Int, c: ParserBinderContext) -> Expr {
  match expr {
    // Grouping changes the syntactic extent used by a surrounding operator,
    // not the occurrence of the already parsed child expression.
    ECall(EIdent("$source_span", core_start), args, _, _) => ECall(EIdent("$source_span", core_start), [
      Array::get(args, at = 0),
      Array::get(args, at = 1),
      Array::get(args, at = 2),
      EInt(start),
      EInt(end)
    ], core_start, []),
    _ => ECall(EIdent("$source_span", start), [
      expr,
      EInt(end),
      EArray(source_direct_slots(expr = expr, start = start, end = end, c = c)),
      EInt(start),
      EInt(end)
    ], start, [])
  }
}

export fn source_expr_syntax_range(_ expr: Expr) -> (Int, Int) {
  match expr {
    ECall(EIdent("$source_span", _), args, _, _) => match (Array::get(args, at = 3), Array::get(args, at = 4)) {
      (EInt(start), EInt(end)) => (start, end),
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

export fn source_expr_context(starts: Array[Int], ends: Array[Int]) -> ParserBinderContext {
  let c = binder_capture_context(starts = starts, ends = ends)
  ParserBinderContext::{
    rows: c.rows,
    starts_stack: c.starts_stack,
    ends_stack: c.ends_stack,
    bases: c.bases,
    eligible: c.eligible,
    capture_source_spans: true,
    source_slots: c.source_slots
  }
}

export fn source_wrap_expr(expr: Expr, first: Int, next: Int, context: Option[ParserBinderContext]) -> Expr {
  match context {
    Some(c) => if c.capture_source_spans && first >= 0 && next > first {
      let depth = Array::length(c.starts_stack) - 1
      let starts = Array::get(c.starts_stack, at = depth)
      let ends = Array::get(c.ends_stack, at = depth)
      if next <= Array::length(ends) {
        let base = Array::get(c.bases, at = depth)
        source_annotate(expr = expr, start = base + Array::get(starts, at = first), end = base + Array::get(ends, at = next - 1), c = c)
      } else {
        expr
      }
    } else {
      expr
    },
    None => expr
  }
}

export fn source_pat(_ pat: Pat) -> Pat {
  match pat {
    PCtor("$source_span", args) => Array::get(args, at = 0),
    _ => pat
  }
}

export fn source_pat_range(_ pat: Pat) -> (Int, Int) {
  match pat {
    PCtor("$source_span", args) => match (Array::get(args, at = 1), Array::get(args, at = 2)) {
      (PInt(start), PInt(end)) => (start, end),
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

// Ordinary and binder-only parses carry no tooling ranges. Check the mode
// before constructing the temporary expression and range pair.
fn source_captures_spans(_ context: Option[ParserBinderContext]) -> Bool {
  match context {
    Some(c) => c.capture_source_spans,
    None => false
  }
}

export fn source_wrap_pat(pat: Pat, first: Int, next: Int, context: Option[ParserBinderContext]) -> Pat {
  if !source_captures_spans(context) {
    pat
  } else {
    let (start, end) = source_expr_range(source_wrap_expr(expr = EUnit, first = first, next = next, context = context))
    if start < 0 {
      pat
    } else {
      match pat {
        PCtor("$source_span", args) => PCtor("$source_span", [
          Array::get(args, at = 0),
          PInt(start),
          PInt(end),
          Array::get(args, at = 3),
          Array::get(args, at = 4),
          Array::get(args, at = 5),
          Array::get(args, at = 6)
        ]),
        _ => {
          let name = match pat {
            PCtor(n, _) => n,
            PStruct(n, _) => n,
            _ => ""
          }
          let slot = match context {
            Some(c) => source_named_slot(kind = "pat_head", name = name, lo = start, hi = end, c = c),
            None => source_slot_node(start = -1, end = -1)
          }
          let (head_start, head_end) = source_slot_range(slot)
          PCtor("$source_span", [
            pat,
            PInt(start),
            PInt(end),
            PInt(head_start),
            PInt(head_end),
            PInt(-1),
            PInt(-1)
          ])
        }
      }
    }
  }
}

export fn source_type(_ ty: TypeExpr) -> TypeExpr {
  match ty {
    TyApp("$source_span", args) => Array::get(args, at = 0),
    _ => ty
  }
}

fn source_span_number(_ ty: TypeExpr) -> Int {
  match ty {
    TyName(digits) => {
      let mut value = 0
      let mut i = 0
      while i < String::length(digits) {
        value = value * 10 + String::char_code_at(digits, at = i) - '0'
        i = i + 1
      }
      value
    },
    _ => -1
  }
}

export fn source_type_range(_ ty: TypeExpr) -> (Int, Int) {
  match ty {
    TyApp("$source_span", args) => (source_span_number(Array::get(args, at = 1)), source_span_number(Array::get(args, at = 2))),
    _ => (-1, -1)
  }
}

export fn source_wrap_type(ty: TypeExpr, first: Int, next: Int, context: Option[ParserBinderContext]) -> TypeExpr {
  if !source_captures_spans(context) {
    ty
  } else {
    let (start, end) = source_expr_range(source_wrap_expr(expr = EUnit, first = first, next = next, context = context))
    if start < 0 {
      ty
    } else {
      match ty {
        TyApp("$source_span", _) => ty,
        _ => {
          let name = match ty {
            TyApp(n, _) => n,
            TyName(n) => n,
            _ => ""
          }
          let slot = match context {
            Some(c) => source_named_slot(kind = "type_head", name = name, lo = start, hi = end, c = c),
            None => source_slot_node(start = -1, end = -1)
          }
          let (head_start, head_end) = source_slot_range(slot)
          TyApp("$source_span", [
            ty,
            TyName(__to_string(start)),
            TyName(__to_string(end)),
            source_span_type_number(head_start),
            source_span_type_number(head_end)
          ])
        }
      }
    }
  }
}

// A direct name slot is recorded at its grammar production, independently of
// the binder-authority rows. Later transformations cannot turn a same-spelled
// name elsewhere into this occurrence's source range.
export fn source_record_slot(kind: String, name: String, first: Int, next: Int, context: Option[ParserBinderContext]) -> Unit {
  match context {
    Some(c) => if c.capture_source_spans {
      let depth = Array::length(c.starts_stack) - 1
      let starts = Array::get(c.starts_stack, at = depth)
      let ends = Array::get(c.ends_stack, at = depth)
      if first >= 0 && next > first && next <= Array::length(ends) {
        let base = Array::get(c.bases, at = depth)
        Array::push(c.source_slots, value = (kind, name, base + Array::get(starts, at = first), base + Array::get(ends, at = next - 1)))
      }
    },
    None => ()
  }
}

fn source_slot_node(start: Int, end: Int) -> Expr {
  ETuple([EInt(start), EInt(end)])
}

fn source_named_slot(kind: String, name: String, lo: Int, hi: Int, c: ParserBinderContext) -> Expr {
  let mut start = -1
  let mut end = -1
  for row in c.source_slots {
    let (role, spelling, first, next) = row
    if lo >= 0 && role == kind && spelling == name && first >= lo && next <= hi && (start < 0 || first < start) {
      start = first
      end = next
    }
  }
  source_slot_node(start = start, end = end)
}

fn source_binding_slot(name: String, lo: Int, hi: Int, c: ParserBinderContext) -> Expr {
  let mut start = -1
  let mut end = -1
  for row in c.rows {
    match row {
      SourceToken(spelling, first, next) => if lo >= 0 && spelling == name && first >= lo && next <= hi && (start < 0 || first < start) {
        start = first
        end = next
      },
      _ => ()
    }
  }
  source_slot_node(start = start, end = end)
}

fn source_token_slot(offset: Int, c: ParserBinderContext) -> Expr {
  let depth = Array::length(c.starts_stack) - 1
  let starts = Array::get(c.starts_stack, at = 0)
  let active_starts = Array::get(c.starts_stack, at = depth)
  let ends = Array::get(c.ends_stack, at = depth)
  let base = Array::get(c.bases, at = depth)
  let mut lo = 0
  let mut hi = Array::length(starts)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(starts, at = mid) < offset {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(starts) && lo < Array::length(ends) && Array::get(starts, at = lo) == offset {
    source_slot_node(start = base + Array::get(active_starts, at = lo), end = base + Array::get(ends, at = lo))
  } else {
    source_slot_node(start = -1, end = -1)
  }
}

fn source_direct_slots(expr: Expr, start: Int, end: Int, c: ParserBinderContext) -> Array[Expr] {
  match expr {
    EDot(receiver, field, _, _) => [
      source_named_slot(kind = "dot_field", name = field, lo = source_expr_syntax_range(receiver).1, hi = end, c = c)
    ],
    ELet(name, _, _, off) => [
      if off < 0 {
        source_slot_node(start = -1, end = -1)
      } else {
        source_binding_slot(name = name, lo = start, hi = end, c = c)
      }
    ],
    ELetMut(name, _, _, off) => [
      if off < 0 {
        source_slot_node(start = -1, end = -1)
      } else {
        source_binding_slot(name = name, lo = start, hi = end, c = c)
      }
    ],
    ELetRec(name, _, _) => [
      source_binding_slot(name = name, lo = start, hi = end, c = c)
    ],
    EFn(_, _, params, _, _, body) => {
      let body_start = source_expr_range(body).0
      for param in params {
        source_named_slot(kind = "param", name = param.0, lo = start, hi = body_start, c = c)
      }
    },
    EAssign(name, value, _, _) => [
      source_named_slot(kind = "target", name = name, lo = start, hi = source_expr_range(value).0, c = c)
    ],
    EAssignOp(name, _, value, _, _) => [
      source_named_slot(kind = "target", name = name, lo = start, hi = source_expr_range(value).0, c = c)
    ],
    ELabeledArg(name, _, value) => [
      source_named_slot(kind = "label", name = name, lo = start, hi = source_expr_range(value).0, c = c)
    ],
    ERecord(name, fields, _) => {
      let slots = [
        if name == "" {
          source_slot_node(start = -1, end = -1)
        } else {
          source_token_at_start(start = start, c = c)
        }
      ]
      let mut cursor = start
      for field in fields {
        let value_range = source_expr_range(field.1)
        Array::push(slots, value = source_named_slot(kind = "field", name = field.0, lo = cursor, hi = value_range.1, c = c))
        cursor = value_range.1
      }
      slots
    },
    EForIn(name, index, value, _) => {
      let hi = source_expr_range(value).0
      let primary = source_binding_slot(name = name, lo = start, hi = hi, c = c)
      let secondary = match index {
        Some(n) => source_binding_slot(name = n, lo = start, hi = hi, c = c),
        None => source_slot_node(start = -1, end = -1)
      }
      [primary, secondary]
    },
    _ => []
  }
}

export fn source_expr_slot(expr: Expr, index: Int) -> (Int, Int) {
  match expr {
    ECall(EIdent("$source_span", _), args, _, _) => match Array::get(args, at = 2) {
      EArray(slots) => if index >= 0 && index < Array::length(slots) {
        match Array::get(slots, at = index) {
          ETuple(bounds) => match (Array::get(bounds, at = 0), Array::get(bounds, at = 1)) {
            (EInt(start), EInt(end)) => (start, end),
            _ => (-1, -1)
          },
          _ => (-1, -1)
        }
      } else {
        (-1, -1)
      },
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

/// Preserve the source occurrence when parser normalization replaces a node
/// without introducing new syntax (for example distributing a lambda type).
export fn source_rewrap_expr(original: Expr, replacement: Expr) -> Expr {
  match original {
    ECall(EIdent("$source_span", start), args, _, _) => ECall(EIdent("$source_span", start), [
      replacement,
      Array::get(args, at = 1),
      Array::get(args, at = 2),
      Array::get(args, at = 3),
      Array::get(args, at = 4)
    ], start, []),
    _ => replacement
  }
}

/// A railway binder is source syntax; its continuation lambda is generated.
/// Keep the real binder token on that lambda's parameter slot without giving
/// the generated lambda itself a fabricated expression range.
export fn source_wrap_bind(expr: Expr, name: String, off: Int, value: Expr, context: Option[ParserBinderContext]) -> Expr {
  match context {
    Some(c) => if c.capture_source_spans {
      let start = match source_token_slot(offset = off, c = c) {
        ETuple(bounds) => match Array::get(bounds, at = 0) {
          EInt(n) => n,
          _ => -1
        },
        _ => -1
      }
      let value_span = source_expr_syntax_range(value)
      match expr {
        ECall(callee, args, call_off, callee_resolution) => {
          let continuation = Array::get(args, at = 1)
          let slot = source_binding_slot(name = name, lo = start, hi = value_span.0, c = c)
          let located_continuation = ECall(EIdent("$source_span", -1), [
            continuation,
            EInt(-1),
            EArray([slot]),
            EInt(-1),
            EInt(-1)
          ], -1, [])
          source_annotate(expr = ECall(callee, [value, located_continuation], call_off, callee_resolution), start = start, end = value_span.1, c = c)
        },
        _ => expr
      }
    } else {
      expr
    },
    None => expr
  }
}

fn source_span_type_number(_ n: Int) -> TypeExpr {
  if n < 0 {
    TyUnit
  } else {
    TyName(__to_string(n))
  }
}

fn source_slot_range(_ slot: Expr) -> (Int, Int) {
  match slot {
    ETuple(bounds) => match (Array::get(bounds, at = 0), Array::get(bounds, at = 1)) {
      (EInt(start), EInt(end)) => (start, end),
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

export fn source_pat_head(_ pat: Pat) -> (Int, Int) {
  match pat {
    PCtor("$source_span", args) => match (Array::get(args, at = 3), Array::get(args, at = 4)) {
      (PInt(start), PInt(end)) => (start, end),
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}

export fn source_type_head(_ ty: TypeExpr) -> (Int, Int) {
  match ty {
    TyApp("$source_span", args) => (source_span_number(Array::get(args, at = 3)), source_span_number(Array::get(args, at = 4))),
    _ => (-1, -1)
  }
}

export fn source_rewrap_pat(original: Pat, replacement: Pat) -> Pat {
  match original {
    PCtor("$source_span", args) => PCtor("$source_span", [
      replacement,
      Array::get(args, at = 1),
      Array::get(args, at = 2),
      Array::get(args, at = 3),
      Array::get(args, at = 4),
      Array::get(args, at = 5),
      Array::get(args, at = 6)
    ]),
    _ => replacement
  }
}

// Unlike raw checker offsets (which interpolation remaps later), this start
// already belongs to the current source frame.
fn source_token_at_start(start: Int, c: ParserBinderContext) -> Expr {
  let depth = Array::length(c.starts_stack) - 1
  let starts = Array::get(c.starts_stack, at = depth)
  let ends = Array::get(c.ends_stack, at = depth)
  let base = Array::get(c.bases, at = depth)
  let mut lo = 0
  let mut hi = Array::length(starts)
  while lo < hi {
    let mid = (lo + hi) / 2
    if base + Array::get(starts, at = mid) < start {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(ends) && base + Array::get(starts, at = lo) == start {
    source_slot_node(start = start, end = base + Array::get(ends, at = lo))
  } else {
    source_slot_node(start = -1, end = -1)
  }
}

export fn source_clear_type_head(_ ty: TypeExpr) -> TypeExpr {
  match ty {
    TyApp("$source_span", args) => TyApp("$source_span", [
      Array::get(args, at = 0),
      Array::get(args, at = 1),
      Array::get(args, at = 2),
      TyUnit,
      TyUnit
    ]),
    _ => ty
  }
}

/// Preserve the independently spelled effect qualifier when handler parsing
/// prefixes an operation name. Its interval may live in the `with E` header.
export fn source_set_pat_qualifier(pat: Pat, first: Int, next: Int, context: Option[ParserBinderContext]) -> Pat {
  match pat {
    PCtor("$source_span", args) => {
      let (start, end) = source_expr_range(source_wrap_expr(expr = EUnit, first = first, next = next, context = context))
      PCtor("$source_span", [
        Array::get(args, at = 0),
        Array::get(args, at = 1),
        Array::get(args, at = 2),
        Array::get(args, at = 3),
        Array::get(args, at = 4),
        PInt(start),
        PInt(end)
      ])
    },
    _ => pat
  }
}

export fn source_pat_qualifier(_ pat: Pat) -> (Int, Int) {
  match pat {
    PCtor("$source_span", args) => match (Array::get(args, at = 5), Array::get(args, at = 6)) {
      (PInt(start), PInt(end)) => (start, end),
      _ => (-1, -1)
    },
    _ => (-1, -1)
  }
}
