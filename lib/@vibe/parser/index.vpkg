generated_hash =

// @vibe/parser — the vibe lexer / parser / printer (ADR-0065 Phase 3, #753).
// Depends on @vibe/ast (the impl files import ../ast for the node types;
// Expr/Pat/Stmt/TypeExpr in the signatures below are those types). Token is
// a bodyless type declaration: the enum definition lives in token.vibe (the
// lexer/parser construct and match it, so a transparent contract definition
// would hit the impl-before-facade check order, #752 rule), and the facade
// re-exports it with ctors intact.
//
// The surface deliberately includes the parser-combinator primitives
// (peek/tk_name/parse_type/parse_fn_signature/...) — the compiler's contract
// engine, cst lowering, and editor tooling build on them, and conformance
// requires every `export let` of the impl files to be declared here.

type Token

// --- polyfill

// --- token
fn token_to_string(t: Token) -> String

// --- float_format
fn double_to_string_compiler(d: Double) -> String
fn parse_decimal_float(int_str: String, frac_str: String) -> Double

// --- lexer
fn lex(src: String) -> Array[Token] with { Error }
fn lex_ok(src: String) -> Bool
fn lex_with_offsets(src: String) -> (Array[Token], Array[Int], Array[Int]) with { Error }
fn lex_with_offsets_recovering(src: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String])
fn offset_to_line_col(src: String, offset: Int) -> (Int, Int)
fn collect_doc_comments(src: String) -> Array[(Int, String)]

// --- parser_base
fn peek(tokens: Array[Token], pos: Int) -> Token
fn tk_name(t: Token) -> String
fn skip_semi(tokens: Array[Token], pos: Int) -> Int
fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error }
fn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error }
fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int
fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error }
fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error }

// --- parser_expr (+ primary/core/dispatch stages)
fn parse(tokens: Array[Token]) -> Expr with { Error }
fn parse_ok(tokens: Array[Token]) -> Bool
fn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error }
fn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int) -> (Expr, Int) with { Error }
fn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error }
fn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }
fn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }
fn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }
fn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }

// --- parser_expr (fn-declaration lowering, ADR-0064 #727/#731)
fn lower_fn_decl_stmt(stmt: Stmt) -> Stmt
fn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt]

// --- parser_expr (#1281): expand a top-level irrefutable pattern `let` into a
// hidden binding holding the value plus one projection binding per name, so
// the value is evaluated once and codegen sees only plain top-level `SLet`s.
// Applied by every parse_program* variant that feeds the checker/codegen.
fn expand_top_level_pattern_lets(stmts: Array[Stmt]) -> Array[Stmt]

// --- parser
fn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }
fn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }
fn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error }
fn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error }
fn parse_program_located(tokens: Array[Token], starts: Array[Int], src: String) -> Array[Stmt] with { Error }
fn parse_program_recovering(tokens: Array[Token], starts: Array[Int], src: String) -> (Array[Stmt], Array[String]) with { Error }
fn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error }

// --- expand_interp
fn resolve_interp_expr(e: Expr) -> Expr with { Error }
fn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error }

// --- printer
fn print_pat(p: Pat) -> String
fn print_type_expr(t: TypeExpr) -> String
fn print_expr(e: Expr) -> String
fn print_stmt(s: Stmt) -> String
fn print_program(stmts: Array[Stmt]) -> String
