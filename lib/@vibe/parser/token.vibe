//# Imports

import ./polyfill.vibe {
  __to_string
}

import ./float_format.vibe {
  double_to_string_compiler
}

//# Types

export enum Token {
  TInt(Int);
  TFloat(Double);
  TString(String);
  TIdent(String);
  TLet;
  TRec;
  TMut;
  TFn;
  TIf;
  TElse;
  TMatch;
  TIs;
  TDo;
  TEnum;
  TStruct;
  TType;
  TTrait;
  TImpl;
  TExport;
  TTest;
  TWhile;
  TFor;
  TIn;
  TLoop;
  TBreak;
  TContinue;
  TReturn;
  TWith;
  THandle;
  TTaskGroup;
  TRegion;
  TThrow;
  TRaise;
  TYield;
  TBench;
  TDeclare;
  TAs;
  TModule;
  TSuberror;
  TDerive;
  TOpen;
  TImport;
  TPlus;
  TMinus;
  TStar;
  TSlash;
  TPercent;
  TEqEq;
  TNeq;
  TLt;
  TLte;
  TGt;
  TGte;
  TAnd;
  TOr;
  TNot;
  TBitAnd;
  TBitOr;
  TBitXor;
  TLShift;
  TRShift;
  TPipeGt;
  TArrow;
  TThinArrow;
  TEq;
  TDot;
  TColon;
  TDoubleColon;
  TComma;
  TSemicolon;
  THash;
  TTilde;
  TQuestion;
  TPlusEq;
  TMinusEq;
  TStarEq;
  TSlashEq;
  TPercentEq;
  TLParen;
  TRParen;
  TLBrace;
  TRBrace;
  TLBracket;
  TRBracket;
  TDotDot;
  TDotDotDot;
  // #947: the second array carries, in lockstep with `parts`, the ABSOLUTE
  // source offset of each part's start (odd indices = embedded expression
  // fragments, the ones that matter; even/literal indices carry -1, unused).
  // Without this, re-lexing a fragment in isolation (build_interp_expr)
  // produces offsets relative to the fragment (starting at 0), so hovering an
  // identifier inside `\{...}` used to resolve to a bogus span at the file
  // start instead of the identifier's real location.
  TStringInterp(Array[String], Array[Int]);
  TEof
}

//# Functions

export fn token_to_string(t: Token) -> String {
  match t {
    TInt(n) => String::concat("TInt(", String::concat(__to_string(n), ")")),
    TFloat(n) =>
    String::concat("TFloat(", String::concat(double_to_string_compiler(n), ")")),
    TString(s) => String::concat("TString(\"", String::concat(s, "\")")),
    TIdent(s) => String::concat("TIdent(", String::concat(s, ")")),
    TLet => "TLet",
    TRec => "TRec",
    TMut => "TMut",
    TFn => "TFn",
    TIf => "TIf",
    TElse => "TElse",
    TMatch => "TMatch",
    TIs => "TIs",
    TDo => "TDo",
    TEnum => "TEnum",
    TStruct => "TStruct",
    TType => "TType",
    TTrait => "TTrait",
    TImpl => "TImpl",
    TExport => "TExport",
    TTest => "TTest",
    TWhile => "TWhile",
    TFor => "TFor",
    TIn => "TIn",
    TLoop => "TLoop",
    TBreak => "TBreak",
    TContinue => "TContinue",
    TReturn => "TReturn",
    TWith => "TWith",
    THandle => "THandle",
    TTaskGroup => "TTaskGroup",
    TRegion => "TRegion",
    TThrow => "TThrow",
    TRaise => "TRaise",
    TYield => "TYield",
    TBench => "TBench",
    TDeclare => "TDeclare",
    TAs => "TAs",
    TModule => "TModule",
    TSuberror => "TSuberror",
    TDerive => "TDerive",
    TOpen => "TOpen",
    TImport => "TImport",
    TPlus => "TPlus",
    TMinus => "TMinus",
    TStar => "TStar",
    TSlash => "TSlash",
    TPercent => "TPercent",
    TEqEq => "TEqEq",
    TNeq => "TNeq",
    TLt => "TLt",
    TLte => "TLte",
    TGt => "TGt",
    TGte => "TGte",
    TAnd => "TAnd",
    TOr => "TOr",
    TNot => "TNot",
    TBitAnd => "TBitAnd",
    TBitOr => "TBitOr",
    TBitXor => "TBitXor",
    TLShift => "TLShift",
    TRShift => "TRShift",
    TPipeGt => "TPipeGt",
    TArrow => "TArrow",
    TThinArrow => "TThinArrow",
    TEq => "TEq",
    TDot => "TDot",
    TColon => "TColon",
    TDoubleColon => "TDoubleColon",
    TComma => "TComma",
    TSemicolon => "TSemicolon",
    THash => "THash",
    TTilde => "TTilde",
    TQuestion => "TQuestion",
    TPlusEq => "TPlusEq",
    TMinusEq => "TMinusEq",
    TStarEq => "TStarEq",
    TSlashEq => "TSlashEq",
    TPercentEq => "TPercentEq",
    TLParen => "TLParen",
    TRParen => "TRParen",
    TLBrace => "TLBrace",
    TRBrace => "TRBrace",
    TLBracket => "TLBracket",
    TRBracket => "TRBracket",
    TDotDot => "TDotDot",
    TDotDotDot => "TDotDotDot",
    TStringInterp(_, _) => "TStringInterp",
    TEof => "TEof"
  }
}
