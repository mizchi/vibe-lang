//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./token.vibe {
  Token
}

//# Functions

export fn peek(tokens: Array[Token], pos: Int) -> Token {
  if pos < Array::length(tokens) {
    Array::get(tokens, pos)
  } else TEof
}

fn _no_tp() -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

fn _no_tb() -> Array[(String, Array[String])] {
  Array::slice([
    ("", _no_tp())
  ], 0, 0)
}

let mode_if = 21

export fn tk_name(tok: Token) -> String {
  match tok {
    TInt(_) => "int",
    TFloat(_) => "float",
    TString(_) => "string",
    TStringInterp(_, _) => "string",
    TIdent(_) => "ident",
    TLet => "let",
    TRec => "rec",
    TMut => "mut",
    TFn => "fn",
    TIf => "if",
    TElse => "else",
    TMatch => "match",
    TIs => "is",
    TGuard => "guard",
    TDo => "do",
    TEnum => "enum",
    TStruct => "struct",
    TType => "type",
    TTrait => "trait",
    TImpl => "impl",
    TExport => "export",
    TTest => "test",
    TExample => "example",
    TWhile => "while",
    TFor => "for",
    TIn => "in",
    TLoop => "loop",
    TBreak => "break",
    TContinue => "continue",
    TReturn => "return",
    TWith => "with",
    THandle => "handle",
    TTaskGroup => "taskgroup",
    TRegion => "region",
    TThrow => "throw",
    TRaise => "raise",
    TYield => "yield",
    TBench => "bench",
    TDeclare => "declare",
    TAs => "as",
    TModule => "module",
    TSuberror => "suberror",
    TDerive => "derive",
    TOpen => "open",
    TImport => "import",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TAnd => "&&",
    TOr => "||",
    TNot => "!",
    TBitAnd => "&",
    TBitOr => "|",
    TBitXor => "^",
    TLShift => "<<",
    TRShift => ">>",
    TPipeGt => "|>",
    TArrow => "=>",
    TThinArrow => "->",
    TEq => "=",
    TDot => ".",
    TColon => ":",
    TDoubleColon => "::",
    TComma => ",",
    TSemicolon => ";",
    THash => "#",
    TTilde => "~",
    TQuestion => "?",
    TPlusEq => "+=",
    TMinusEq => "-=",
    TStarEq => "*=",
    TSlashEq => "/=",
    TPercentEq => "%=",
    TLParen => "(",
    TRParen => ")",
    TLBrace => "{",
    TRBrace => "}",
    TLBracket => "[",
    TRBracket => "]",
    TDotDot => "..",
    TDotDotDot => "...",
    TStringInterp(_, _) => "string",
    TEof => "eof"
  }
}

fn is_tk(tok: Token, name: String) -> Bool {
  tk_name(tok) == name
}

fn expect_tk(tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {
  if is_tk(peek(tokens, pos), expected) {
    pos + 1
  } else {
    let actual = tk_name(peek(tokens, pos))
    // #816: carry the failing TOKEN index; parse_program_located decodes it
    // to a real line:col (and strips it from the user-facing message).
    throw("expected \{expected} but got \{actual} at #\{pos}")
  }
}

export fn skip_semi(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TSemicolon => pos + 1,
    _ => pos
  }
}

fn empty_arms() -> Array[(Pat, Expr)] {
  Array::slice([
    (PWild, EUnit)
  ], 0, 0)
}

fn empty_pats() -> Array[Pat] {
  Array::slice([
    PWild
  ], 0, 0)
}

let mode_block = 20

let mode_match = 22

let mode_while = 23

fn empty_ctors() -> Array[(String, Array[TypeExpr])] {
  Array::slice([
    ("_", Array::slice([
      TyUnit
    ], 0, 0))
  ], 0, 0)
}

fn empty_exprs() -> Array[Expr] {
  Array::slice([
    EUnit
  ], 0, 0)
}

let mode_for_in = 25

let mode_handle = 24

/// Parse a `derive(A, B, ...)` clause into the list of derived trait names plus
/// the position after the clause. Any identifier is accepted (the set of
/// structurally-derivable traits is validated later); a missing clause yields an
/// empty list. Supports multiple comma-separated names (#638).
export fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {
  let names = Array::slice([
    ""
  ], 0, 0)
  match peek(tokens, pos) {
    TDerive => match peek(tokens, pos + 1) {
      TLParen => {
        let mut dp = pos + 2
        let mut dd = true
        while dd {
          match peek(tokens, dp) {
            TRParen => {
              dd = false
              dp = dp + 1
            },
            TComma => {
              dp = dp + 1
            },
            TIdent(name) => {
              Array::push(names, name)
              dp = dp + 1
            },
            _ => throw("expected derive identifier")
          }
        }
        (names, dp)
      },
      _ => (names, pos)
    },
    _ => (names, pos)
  }
}

export fn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error } {
  let (_, next) = parse_derive_names(tokens, pos)
  next
}

fn empty_fields() -> Array[(String, TypeExpr)] {
  Array::slice([
    ("_", TyUnit)
  ], 0, 0)
}

fn empty_params() -> Array[(String, Option[TypeExpr])] {
  Array::slice([
    ("", None)
  ], 0, 0)
}

fn parse_pattern(tokens: Array[Token], pos: Int) -> (Pat, Int) with { Error } {
  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {
    match peek(tokens, pos) {
      TComma => {
        let (p, pn) = parse_pattern(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_pat_cont(tokens, pn, b)
      },
      TRParen => (ArrayBuilder::freeze(b), pos + 1),
      _ => throw("expected ',' or ')' in pattern list")
    }
  }
  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {
    match peek(tokens, pos) {
      TRParen => (empty_pats(), pos + 1),
      _ => {
        let (f, fn1) = parse_pattern(tokens, pos)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, f)
        parse_pat_cont(tokens, fn1, b)
      }
    }
  }
  let (pat, next) = match peek(tokens, pos) {
    TInt(n) => (PInt(n), pos + 1),
    // A negative literal pattern `-5` / `-1.5` (lexed as TMinus + number).
    // Float literal patterns used to silently become PWild — the first
    // float arm then matched EVERYTHING (`match d { 0.0 => .., 1.0 => .. }`
    // always took "0.0"); they are real PFloat patterns now (bit-exact via
    // f64.eq at codegen, so 0.0 == -0.0 and NaN never matches, like `==`).
    TMinus => match peek(tokens, pos + 1) {
      TInt(n) => (PInt(0 - n), pos + 2),
      TFloat(n) => (PFloat(0.0 - n), pos + 2),
      _ => throw("expected number literal after '-' in pattern")
    },
    TFloat(n) => (PFloat(n), pos + 1),
    TString(s) => (PString(s), pos + 1),
    TIdent(name) => {
      let next_is_lbrace = match peek(tokens, pos + 1) {
        TLBrace => true,
        _ => false
      }
      if name == "true" {
        (PBool(true), pos + 1)
      }
      else if name == "false" {
        (PBool(false), pos + 1)
      }
      else if name == "_" {
        (PWild, pos + 1)
      }
      else if name == "record" && next_is_lbrace {
        let mut rp = pos + 2
        let field_pats_b = ArrayBuilder::new()
        let mut rd = true
        while rd {
          match peek(tokens, rp) {
            TRBrace => {
              rd = false
            },
            TIdent(fname) => {
              match peek(tokens, rp + 1) {
                TColon => {
                  let (fp, fnext) = parse_pattern(tokens, rp + 2)
                  ArrayBuilder::push(field_pats_b, fp)
                  rp = fnext
                },
                TComma => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                },
                TRBrace => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                },
                _ => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                }
              }
              match peek(tokens, rp) {
                TComma => {
                  rp = rp + 1
                },
                _ => ()
              }
            },
            _ => {
              rp = rp + 1
            }
          }
        }
        let rp2 = rp + 1
        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)
      }
      else {
        let fc = String::char_code_at(name, 0)
        if fc >= 65 && fc <= 90 {
          match peek(tokens, pos + 1) {
            TLParen => {
              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);
              (PCtor(name, args), end)
            },
            TDoubleColon => match peek(tokens, pos + 2) {
              TLBrace => {
                let mut sp = pos + 3
                let field_pats = ArrayBuilder::new()
                let mut sd = true
                while sd {
                  match peek(tokens, sp) {
                    TRBrace => {
                      sd = false
                    },
                    TIdent(fname) => {
                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))
                      sp = sp + 1
                      match peek(tokens, sp) {
                        TComma => {
                          sp = sp + 1
                        },
                        _ => ()
                      }
                    },
                    _ => {
                      sd = false
                    }
                  }
                }
                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)
              },
              // #742: qualified variant pattern `Enum::Variant(..)` /
              // `Enum::Variant`. The qualifier is dropped, mirroring the
              // expression side (#672): codegen's ctor table is keyed
              // unqualified, and handle-arm dispatch re-prefixes the effect
              // name onto a bare op pattern, so `Fs::ReadFile(p)` in a
              // `with Fs` arm also lands on the same name it does today.
              TIdent(vname) => {
                let vc = String::char_code_at(vname, 0)
                if vc >= 65 && vc <= 90 {
                  match peek(tokens, pos + 3) {
                    TLParen => {
                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);
                      (PCtor(vname, args), end)
                    },
                    _ => (PCtor(vname, empty_pats()), pos + 3)
                  }
                } else {
                  (PCtor(name, empty_pats()), pos + 1)
                }
              },
              _ => (PCtor(name, empty_pats()), pos + 1)
            },
            _ => (PCtor(name, empty_pats()), pos + 1)
          }
        } else (PBind(name), pos + 1)
      }
    },
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (PTuple(empty_pats()), pos + 2),
      _ => {
        let (f, n1) = parse_pattern(tokens, pos + 1)
        match peek(tokens, n1) {
          TRParen => (f, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, f)
            let (rest, end) = parse_pat_cont(tokens, n1, b);
            (PTuple(rest), end)
          },
          _ => throw("expected ')' or ',' in pattern")
        }
      }
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected in pattern: \{actual}")
    }
  }
  match peek(tokens, next) {
    TBitOr => {
      let (right, end) = parse_pattern(tokens, next + 1);
      (POr(pat, right), end)
    },
    _ => (pat, next)
  }
}

fn empty_type_exprs() -> Array[TypeExpr] {
  Array::slice([
    TyUnit
  ], 0, 0)
}

export fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TLBrace => {
      let mut bp = pos + 1
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, bp) {
          TLBrace => {
            depth = depth + 1
            bp = bp + 1
          },
          TRBrace => {
            depth = depth - 1
            bp = bp + 1
          },
          _ => {
            bp = bp + 1
          }
        }
      }
      bp
    },
    _ => pos
  }
}

/// Parse `Bound + Bound2 + ...` (one type parameter's bound trait names) in a
/// method-level `[X: Bound]` binder. Local equivalent of parser_expr's
/// `parse_type_param_bound_names` (not visible from parser_base).
fn parse_method_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

/// Parse a method-level `[X: Bound, Y, ...]` binder (the first param name token
/// is at `pos`, the `[` already consumed). Local equivalent of parser_expr's
/// `parse_let_type_params`. Returns (type-param names, per-param bounds, next
/// position after `]`).
fn parse_method_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in method type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

fn parse_trait_methods(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } {
  match peek(tokens, pos) {
    TLBrace => {
      let sigs_b = ArrayBuilder::new()
      let gens_b = ArrayBuilder::new()
      let mut p = pos + 1
      while true {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(method_name) => {
            // Optional `:` after the method name, so both
            // `m(Self) -> R` and `m: [X: Bound](Self, X) -> R` parse (#684).
            let after_colon = match peek(tokens, p + 1) {
              TColon => p + 2,
              _ => p + 1
            }
            // Optional method-level generic binder `[X: Bound]`, declared on the
            // trait method only (rank-1 method generics, #684). The impl never
            // repeats it; the desugar reattaches it to the impl's free function.
            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {
              TLBracket => parse_method_type_params(tokens, after_colon + 1),
              _ => (_no_tp(), _no_tb(), after_colon)
            }
            let (params, after_method_params) = match peek(tokens, after_binder) {
              TLParen => {
                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)
                let params = match params_ty {
                  TyUnit => empty_type_exprs(),
                  TyTuple(elems) => elems,
                  _ => [
                    params_ty
                  ]
                }
                (params, after_paren)
              },
              _ => (empty_type_exprs(), after_binder)
            }
            let arrow_pos = expect_tk(tokens, after_method_params, "->")
            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)
            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))
            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))
            p = match peek(tokens, after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected trait method signature or '}'")
        }
      }
      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)
    },
    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)
  }
}

fn parse_trait_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  match peek(tokens, pos) {
    TIdent(name) => {
      // Retain the declared bare header names while preserving the existing
      // accepting grammar: parse_tparam_names still skips non-name header
      // details such as bounds rather than giving them new semantics.
      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)
      match peek(tokens, after_name) {
        TColon => {
          let supers = empty_strings
          let mut p = after_name + 1
          let mut done = false
          while !done {
            match peek(tokens, p) {
              TIdent(sname) => match peek(tokens, p + 1) {
                TPlus => {
                  Array::push(supers, sname)
                  p = p + 2
                },
                _ => {
                  Array::push(supers, sname)
                  p = p + 1
                  done = true
                }
              },
              _ => {
                done = true
              }
            }
          }
          let np = p
          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)
          (STrait(exported, name, supers, methods, method_gens, tparams), body_end)
        },
        _ => {
          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)
          (STrait(exported, name, empty_strings, methods, method_gens, tparams), body_end)
        }
      }
    },
    _ => throw("expected trait name")
  }
}

fn is_expr_end_token(tok: Token) -> Bool {
  match tok {
    TInt(_) => true,
    TFloat(_) => true,
    TString(_) => true,
    TStringInterp(_, _) => true,
    TIdent(_) => true,
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

fn is_non_pipe_infix(tok: Token) -> Bool {
  match tok {
    TOr => true,
    TAnd => true,
    TEqEq => true,
    TNeq => true,
    TLt => true,
    TLte => true,
    TGt => true,
    TGte => true,
    TBitOr => true,
    TBitXor => true,
    TBitAnd => true,
    TLShift => true,
    TRShift => true,
    TPlus => true,
    TMinus => true,
    TStar => true,
    TSlash => true,
    TPercent => true,
    _ => false
  }
}

fn parse_import_item(tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int) with { Error } {
  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {
    match peek(tokens, name_pos) {
      TIdent(name) => {
        let (base, after) = match peek(tokens, name_pos + 1) {
          TDoubleColon => match peek(tokens, name_pos + 2) {
            TIdent(member) =>
            (String::concat(name, String::concat("::", member)), name_pos + 3),
            _ => throw("expected qualified member name after '::'")
          },
          _ => (name, name_pos + 1)
        }
        match peek(tokens, after) {
          TAs => match peek(tokens, after + 1) {
            TIdent(alias) => ((base, Some(alias)), after + 2),
            _ => throw("expected alias name after 'as'")
          },
          _ => ((base, None), after)
        }
      },
      _ => throw("expected import item name")
    }
  }
  match peek(tokens, pos) {
    TIdent(_) => parse_import_name(pos),
    TType => parse_import_name(pos + 1),
    TTrait => parse_import_name(pos + 1),
    _ => throw("expected import item name")
  }
}

fn empty_import_items() -> Array[(String, Option[String])] {
  Array::slice([
    ("_", None)
  ], 0, 0)
}

fn parse_binding_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name after 'let'")
  }
}

export fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {
  match peek(tokens, pos) {
    TLBrace => (acc, pos),
    // #897: `as <mod> only { ... }` starts right after the path -- stop here
    // (mirrors the TLBrace/`@alias` early-outs above) so parse_import_path_tail
    // sees the 'as' token instead of this loop absorbing it as path text.
    TAs => (acc, pos),
    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, ".")),
    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, "..")),
    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, "/")),
    // #769: a `@name` identifier only continues the PATH when it directly
    // follows a '/' (a scoped package segment, e.g. `lib/@vibe/json`). One
    // that follows a completed path with no separating '/' is the trailing
    // `import <path> @alias` alias token (parse_import_stmt peeks for it
    // right after this call returns) — stop here and let the caller see it,
    // instead of silently absorbing it into the path text and running on
    // into the NEXT statement's tokens looking for a '{' that will never
    // come (surfaced as "unexpected token in import path: import").
    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, 0) == '@' && !String::ends_with(acc, "/") {
      (acc, pos)
    } else {
      collect_import_path(tokens, pos + 1, String::concat(acc, name))
    },
    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, "-")),
    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, "module")),
    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, "impl")),
    TType => collect_import_path(tokens, pos + 1, String::concat(acc, "type")),
    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, "match")),
    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, "test")),
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw(String::concat("unexpected token in import path: ", actual))
    }
  }
}

fn skip_bracketed_args(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TLBracket => {
      let mut bp = pos + 1
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, bp) {
          TLBracket => {
            depth = depth + 1
            bp = bp + 1
          },
          TRBracket => {
            depth = depth - 1
            bp = bp + 1
          },
          TEof => {
            depth = 0
          },
          _ => {
            bp = bp + 1
          }
        }
      }
      bp
    },
    _ => pos
  }
}

/// #829: collect the declared type-parameter NAMES of a `[T, U, ...]` header
/// (returning ([], pos) when there is no bracket). Mirrors parse_enum_stmt's
/// inline collector: only depth-1 identifiers in name position are kept, so a
/// bound like `[T: Eq]` still records just `T`.
fn parse_tparam_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) {
  match peek(tokens, pos) {
    TLBracket => {
      let b = ArrayBuilder::new()
      let mut skip = pos + 1
      let mut depth = 1
      let mut expect_name = true
      while depth > 0 {
        match peek(tokens, skip) {
          TLBracket => {
            depth = depth + 1; skip = skip + 1
          },
          TRBracket => {
            depth = depth - 1; skip = skip + 1
          },
          TComma => {
            if depth == 1 {
              expect_name = true
            }
            skip = skip + 1
          },
          TIdent(nm) => {
            if depth == 1 && expect_name {
              ArrayBuilder::push(b, nm)
              expect_name = false
            }
            skip = skip + 1
          },
          TEof => {
            depth = 0
          },
          _ => {
            skip = skip + 1
          }
        }
      }
      (ArrayBuilder::freeze(b), skip)
    },
    _ => (Array::slice([
      ""
    ], 0, 0), pos)
  }
}

/// #1340 (ADR-0071): capture a generic row item's bracketed type-argument
/// group (`State[Int]`, `Exception[MyErr]`, nested `State[Array[Int]]`)
/// back into the row string. COMMAS ARE REJECTED: the whole row pipeline
/// (checker/core splitters, effectset expansion) splits row strings on ","
/// -- a comma inside a label would silently shear it apart -- so a row item
/// takes exactly ONE type argument for now (single-param generic effects:
/// `State[S]`, `Exception[E]`). Only type names and nested brackets are
/// accepted inside the group. Entered just after the opening '[' with
/// depth 1 and `acc` already holding `name[`.
fn collect_row_item_targs(tokens: Array[Token], pos: Int, depth: Int, acc: String) -> (String, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(nm) => collect_row_item_targs(tokens, pos + 1, depth, String::concat(acc, nm)),
    TComma => throw("a generic effect row item takes exactly one type argument for now (multi-argument instantiations in `with { ... }` are not yet supported)"),
    TLBracket => collect_row_item_targs(tokens, pos + 1, depth + 1, String::concat(acc, "[")),
    TRBracket => if depth == 1 {
      (String::concat(acc, "]"), pos + 1)
    } else {
      collect_row_item_targs(tokens, pos + 1, depth - 1, String::concat(acc, "]"))
    },
    _ => throw("expected a type name or ']' in the effect row item's type arguments")
  }
}

/// ADR-0071 (effectset): a row item is either a bare effect/effectset/row-var
/// identifier (`Env`), a qualified single operation (`Env::get`) -- same
/// `Ident (:: Ident)?` qualification already used by parse_import_item and
/// parse_binding_name -- or (#1340) a generic effect instantiation
/// (`State[Int]`, via collect_row_item_targs above). The row itself stays a
/// plain comma-joined `String` (see TyFn/EFn's `Option[String]` field) so a
/// qualified item round-trips through the printer for free -- it just
/// splices the text back verbatim, no re-parsing. Checker-side recognition
/// of `Effect::op` items (expanding them to a single-operation row instead
/// of rejecting as an unknown effect name) is a separate, larger change
/// (ADR-0071 step 3), not attempted here.
fn collect_effect_names(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {
  match peek(tokens, pos) {
    TRBrace => (acc, pos + 1),
    TIdent(name) => {
      let (item, after_item) = match peek(tokens, pos + 1) {
        TDoubleColon => match peek(tokens, pos + 2) {
          TIdent(member) => (String::concat(name, String::concat("::", member)), pos + 3),
          _ => throw("expected qualified operation name after '::' in effect list")
        },
        TLBracket => collect_row_item_targs(tokens, pos + 2, 1, String::concat(name, "[")),
        _ => (name, pos + 1)
      }
      let new_acc = if String::length(acc) == 0 {
        item
      } else "\{acc}, \{item}"
      match peek(tokens, after_item) {
        TComma => collect_effect_names(tokens, after_item + 1, new_acc),
        TRBrace => (new_acc, after_item + 1),
        _ => throw("expected ',' or '}' in effect list")
      }
    },
    _ => throw("expected effect name or '}'")
  }
}

fn parse_type_impl(tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int) with { Error } {
  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {
    match peek(tokens, pos) {
      TComma => match peek(tokens, pos + 1) {
        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),
        _ => {
          let ts = match peek(tokens, pos + 1) {
            TIdent(_) => match peek(tokens, pos + 2) {
              TColon => pos + 3,
              TTilde => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              TQuestion => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              _ => pos + 1
            },
            _ => pos + 1
          }
          let (ty, next) = parse_type_impl(tokens, ts, 0)
          ArrayBuilder::push(b, ty)
          type_list_rest(tokens, next, b)
        }
      }
      ,
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  // The optional `with { E1, E2 }` effect row after a function type's return.
  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {
    match peek(tokens, rn) {
      TWith => {
        let with_pos = expect_tk(tokens, rn + 1, "{")
        let effect_name_pair = collect_effect_names(tokens, with_pos, "")
        (Some(effect_name_pair.0), effect_name_pair.1)
      },
      _ => (None, rn)
    }
  }
  if mode == 0 {
    // Leading-paren handling parses the group's TOP-LEVEL elements with arity
    // preserved, so a function parameter list is read by element count rather
    // than by reinterpreting a (already-unwrapped) tuple atom. This keeps
    // `(A, B) -> R` (two params) distinct from `((A, B)) -> R` (one tuple
    // param): the latter's outer group has a single element `(A, B)`. (#664-adjacent
    // type-annotation fix: previously both flattened to a two-param list.)
    match peek(tokens, pos) {
      TLParen => match peek(tokens, pos + 1) {
        TRParen => {
          // `()` — empty group: a zero-param function `() -> R`, else Unit.
          let after = pos + 2
          match peek(tokens, after) {
            TThinArrow => {
              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)
              let eff = parse_effect_suffix(tokens, rn)
              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)
            },
            _ => (TyUnit, after)
          }
        },
        _ => {
          // A first element may be a labeled param (`x: T` / `x~: T` / `x?: T`);
          // skip the label so the element's TYPE is what gets recorded.
          let ty_start = match peek(tokens, pos + 1) {
            TIdent(_) => match peek(tokens, pos + 2) {
              TColon => pos + 3,
              TTilde => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              TQuestion => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              _ => pos + 1
            },
            _ => pos + 1
          }
          let (first, n1) = parse_type_impl(tokens, ty_start, 0)
          let (elems, after) = match peek(tokens, n1) {
            TRParen => ([
              first
            ], n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, first)
              let (rest, end) = type_list_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, ")");
              (rest, en)
            },
            _ => throw("expected ')' or ',' in type")
          }
          match peek(tokens, after) {
            TThinArrow => {
              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)
              let eff = parse_effect_suffix(tokens, rn)
              (TyFn(elems, ret, eff.0), eff.1)
            },
            _ => {
              // Not a function: a single element is a parenthesized type (the
              // parens are just grouping); two or more elements are a tuple.
              let atom = if Array::length(elems) == 1 {
                Array::get(elems, 0)
              } else {
                TyTuple(elems)
              }
              match peek(tokens, after) {
                TQuestion => (TyApp("Option", [
                  atom
                ]), after + 1),
                _ => (atom, after)
              }
            }
          }
        }
      },
      _ => {
        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)
        match peek(tokens, atom_next) {
          TThinArrow => {
            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)
            let eff = parse_effect_suffix(tokens, rn)
            (TyFn([
              atom_ty
            ], ret, eff.0), eff.1)
          },
          _ => (atom_ty, atom_next)
        }
      }
    }
  } else {
    let (base_ty, base_next) = match peek(tokens, pos) {
      TLParen => match peek(tokens, pos + 1) {
        TRParen => (TyUnit, pos + 2),
        _ => {
          let ty_start = match peek(tokens, pos + 1) {
            TIdent(_) => match peek(tokens, pos + 2) {
              TColon => pos + 3,
              TTilde => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              TQuestion => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              _ => pos + 1
            },
            _ => pos + 1
          }
          let (first, n1) = parse_type_impl(tokens, ty_start, 0)
          match peek(tokens, n1) {
            TRParen => (first, n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, first)
              let (rest, end) = type_list_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, ")");
              (TyTuple(rest), en)
            },
            _ => throw("expected ')' or ',' in type")
          }
        }
      },
      TIdent(name) => match peek(tokens, pos + 1) {
        TLBracket => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          match peek(tokens, n1) {
            TRBracket => (TyApp(name, [
              first
            ]), n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, first)
              let (rest, end) = type_list_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, "]");
              (TyApp(name, rest), en)
            },
            _ => throw("expected ']' or ',' in type application")
          }
        },
        _ => (TyName(name), pos + 1)
      },
      _ => {
        let actual = tk_name(peek(tokens, pos))
        throw("expected type but got \{actual}")
      }
    }
    match peek(tokens, base_next) {
      TQuestion => (TyApp("Option", [
        base_ty
      ]), base_next + 1),
      _ => (base_ty, base_next)
    }
  }
}

export fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error } {
  parse_type_impl(tokens, pos, 0)
}

fn parse_one_param(tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TTilde => {
        let labeled_name = "\{name}~"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((labeled_name, Some(ty)), tp)
          },
          _ => ((labeled_name, None), pos + 2)
        }
      },
      TQuestion => {
        let opt_name = "\{name}?"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((opt_name, Some(ty)), tp)
          },
          _ => ((opt_name, None), pos + 2)
        }
      },
      TColon => {
        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);
        let tp2 = match peek(tokens, tp) {
          TColon => {
            let mut bp = tp + 1
            let mut bd = true
            while bd {
              match peek(tokens, bp) {
                TIdent(_) => {
                  bp = bp + 1; match peek(tokens, bp) {
                    TPlus => {
                      bp = bp + 1
                    },
                    _ => {
                      bd = false
                    }
                  }
                },
                _ => {
                  bd = false
                }
              }
            }
            bp
          },
          _ => tp
        }
        ((name, Some(ty)), tp2)
      },
      _ => ((name, None), pos + 1)
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("expected parameter name at #\{pos} token=\{actual}")
    }
  }
}

fn parse_param_cont(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRParen => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (p, pn) = parse_one_param(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_param_cont(tokens, pn, b)
      }
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("expected ',' or ')' in param list at #\{pos} token=\{actual}")
    }
  }
}

fn parse_param_list(tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {
  match peek(tokens, pos) {
    TRParen => (empty_params(), pos + 1),
    _ => {
      let (f, fn1) = parse_one_param(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, f)
      parse_param_cont(tokens, fn1, b)
    }
  }
}

fn parse_struct_field(tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Bool, Int) with { Error } {
  let (is_mut, p) = match peek(tokens, pos) {
    TMut => (true, pos + 1),
    _ => (false, pos)
  }
  match peek(tokens, p) {
    TIdent(name) => {
      let cn = expect_tk(tokens, p + 1, ":")
      let (ty, next) = parse_type_impl(tokens, cn, 0);
      ((name, ty), is_mut, next)
    },
    _ => throw("expected field name")
  }
}

fn is_lambda_start_impl(tokens: Array[Token], pos: Int, depth: Int, bdepth: Int, has_colon: Bool) -> Bool {
  match peek(tokens, pos) {
    // A colon only signals an annotated lambda param when it sits directly
    // inside the candidate parens — a colon inside BRACKETS is a slice bound
    // (`raw_path[0: 2]`), and counting it made `(len >= 2 && s[0: 2] == x) {`
    // (a parenthesized if-condition followed by the if body's brace) parse as
    // a no-arrow lambda, failing with "expected ',' or ')' in param list".
    TColon => if depth == 0 && bdepth == 0 {
      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)
    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),
    TRParen => if depth == 0 {
      match peek(tokens, pos + 1) {
        TThinArrow => true,
        TLBrace => has_colon,
        _ => false
      }
    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),
    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),
    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),
    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),
    TEof => false,
    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)
  }
}

fn is_lambda_start(tokens: Array[Token], pos: Int) -> Bool {
  is_lambda_start_impl(tokens, pos, 0, 0, false)
}

fn parse_ctor_types_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } {
  match peek(tokens, pos) {
    TComma => {
      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)
      ArrayBuilder::push(b, ty)
      parse_ctor_types_rest(tokens, next, b)
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in constructor types")
  }
}

fn parse_enum_ctor(tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => ((name, empty_type_exprs()), pos + 3),
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (types, end) = parse_ctor_types_rest(tokens, n1, b);
          ((name, types), end)
        }
      },
      _ => ((name, empty_type_exprs()), pos + 1)
    },
    _ => throw("expected constructor name")
  }
}

fn parse_enum_ctors_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body
    // separator (canonical form is ';'; printer/docs/compiler tree all use it).
    // The " at #pos" suffix anchors the located wrapper (#816) at the comma.
    TComma => throw("use ';' to separate declaration members; ',' was removed in 0.3.0 at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';' or '}' in enum at #\{pos}")
  }
}

fn parse_enum_ctors(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_ctors(), pos + 1),
    _ => {
      let (first, next) = parse_enum_ctor(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_enum_ctors_rest(tokens, next, b)
    }
  }
}

fn parse_enum_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (params, after_name) = match peek(tokens, pos + 1) {
        TLBracket => {
          let b = ArrayBuilder::new()
          let mut skip = pos + 2
          let mut depth = 1
          let mut expect_name = true
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => {
                depth = depth + 1; skip = skip + 1
              },
              TRBracket => {
                depth = depth - 1; skip = skip + 1
              },
              TComma => {
                if depth == 1 {
                  expect_name = true
                }
                skip = skip + 1
              },
              TIdent(nm) => {
                if depth == 1 && expect_name {
                  ArrayBuilder::push(b, nm)
                  expect_name = false
                }
                skip = skip + 1
              },
              _ => {
                skip = skip + 1
              }
            }
          }
          (ArrayBuilder::freeze(b), skip)
        },
        _ => (Array::slice([
          ""
        ], 0, 0), pos + 1)
      }
      let br = expect_tk(tokens, after_name, "{")
      let (ctors, end) = parse_enum_ctors(tokens, br);
      let (derives, final_pos) = parse_derive_names(tokens, end)
      (SEnum(exported, name, params, ctors, derives), final_pos)
    },
    _ => throw("expected enum name")
  }
}

fn parse_suberror_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, (name, empty_type_exprs()))
          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)
        },
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let args_b = ArrayBuilder::new()
          ArrayBuilder::push(args_b, first)
          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)
          let ctors_b = ArrayBuilder::new()
          ArrayBuilder::push(ctors_b, (name, args))
          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)
        }
      },
      TLBrace => {
        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);
        (SSuberror(exported, name, ctors), end)
      },
      _ => throw("expected '(' or '{' after suberror name")
    },
    _ => throw("expected suberror name")
  }
}

fn parse_impl_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

fn parse_impl_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in impl type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

fn parse_impl_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {
  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {
    TLBracket => parse_impl_type_params(tokens, pos + 1),
    _ => (_no_tp(), _no_tb(), pos)
  }
  match peek(tokens, after_tp) {
    TIdent(trait_name) => {
      let fp = expect_tk(tokens, after_tp + 1, "for")
      match peek(tokens, fp) {
        TIdent(type_name) => {
          // Return the position at the impl body `{` (or the next token when
          // the impl is body-less). The caller (parser.vibe) either expands the
          // method block into `Type::method` let-bindings or skips it; this
          // parser layer cannot reach `parse_expr` to parse method bodies.
          let after_targs = skip_bracketed_args(tokens, fp + 1)
          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)
        },
        _ => throw("expected type name after 'for'")
      }
    },
    _ => throw("expected trait name after 'impl'")
  }
}

fn parse_type_params_list(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {
  let b = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

/// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }
fn parse_effect_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (type_params, after_params) = match peek(tokens, pos + 1) {
        TLBracket => parse_type_params_list(tokens, pos + 2),
        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)
      }
      let br = expect_tk(tokens, after_params, "{")
      let ops_b = ArrayBuilder::new()
      let mut p = br
      while true {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(op_name) => {
            let (params, after_op_params) = match peek(tokens, p + 1) {
              TLParen => {
                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)
                let params = match params_ty {
                  TyUnit => empty_type_exprs(),
                  TyTuple(elems) => elems,
                  _ => [
                    params_ty
                  ]
                }
                (params, after_paren)
              },
              _ => (empty_type_exprs(), p + 1)
            }
            let arrow_pos = expect_tk(tokens, after_op_params, "->")
            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)
            ArrayBuilder::push(ops_b, (op_name, params, ret_type))
            p = match peek(tokens, after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected effect operation name or '}'")
        }
      }
      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)
    },
    _ => throw("expected effect name")
  }
}

fn parse_type_alias_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (params, after_name) = match peek(tokens, pos + 1) {
        TLBracket => parse_type_params_list(tokens, pos + 2),
        _ => (Array::slice([
          ""
        ], 0, 0), pos + 1)
      }
      let ep = expect_tk(tokens, after_name, "=")
      let (ty, next) = parse_type_impl(tokens, ep, 0);
      (STypeAlias(exported, name, params, ty), next)
    },
    _ => throw("expected type alias name")
  }
}

fn parse_impl_stmt_dispatch(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {
  parse_impl_stmt(tokens, pos)
}

fn push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {
  if is_mut {
    let (fname, _) = field
    ArrayBuilder::push(mb, fname)
  } else {
    ()
  }
}

fn parse_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        push_mut_name(mb, field, is_mut)
        parse_struct_fields_rest(tokens, next, b, mb)
      }
    },
    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body
    // separator (see parse_enum_ctors_rest).
    TComma => throw("use ';' to separate declaration members; ',' was removed in 0.3.0 at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),
    _ => throw("expected ';' or '}' in struct at #\{pos}")
  }
}

fn parse_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), Array::slice([
      ""
    ], 0, 0), pos + 1),
    _ => {
      let (first, is_mut, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      let mb = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      push_mut_name(mb, first, is_mut)
      parse_struct_fields_rest(tokens, next, b, mb)
    }
  }
}

fn parse_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      // #829: keep the `[T]` type-parameter names (previously skipped and
      // discarded) so the checker can instantiate generic struct literals.
      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)
      let br = expect_tk(tokens, after_name, "{")
      let (fields, mut_names, end) = parse_struct_fields(tokens, br);
      let (derives, final_pos) = parse_derive_names(tokens, end)
      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)
    },
    _ => throw("expected struct name")
  }
}

