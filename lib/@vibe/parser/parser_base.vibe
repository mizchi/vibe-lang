//# Functions

export fn peek(tokens: Array[Token], pos: Int) -> Token {
  if pos < Array::length(tokens) {
    Array::get(tokens, at = pos)
  } else TEof
}

/// Parse the optional constructor-kind suffix of a type binder. `F` has kind
/// Type, `F[_]` has kind Type -> Type, and each additional underscore adds one
/// input. The returned String is the AST contract key, not source spelling.
/// #3727: `i32` used to be a second spelling of the 63-bit `Int`, so a program
/// declaring 32 bits got 63-bit arithmetic with a clean check. It is no type
/// at all now, and no declaration may take the name, so EVERY type position
/// can refuse it on sight; the parser is the one place all of them pass
/// through (`parse_type`, plus the row arguments collected as text).
///
/// ADR-0122 (#3729): the retired float spellings are refused the same way and
/// at the same places, naming the width-named type to write.
fn refuse_retired_type(_ name: String) -> Unit with Exception {
  if Array::length(retired_type_refusal_holds) == 0 {
    refuse_retired_type_name(name)
  } else {
    ()
  }
}

fn refuse_retired_type_name(_ name: String) -> Unit with Exception {
  if name == "i32" {
    throw("unknown type `i32` -- write `Int`: vibe's integer type is 63-bit and wraps at 63 bits, and there is no `i32`")
  } else {
    let renamed = retired_float_type_replacement(name)
    if String::length(renamed) > 0 {
      throw("unknown type `" + name + "` -- write `" + renamed + "`: the float types are named by width (`Float64`, `Float32`)")
    } else {
      ()
    }
  }
}

/// A lambda's `->` is followed by EITHER a return type or the body, and the
/// parser decides which by parsing a type and looking at what follows it
/// (`{` / `with` means a type). Until then `f64` in `() -> f64(x)` or the
/// constructor `Double` in `() -> Double` is an expression that merely parses
/// as a type, so the retired-name refusal must not fire during that look: it
/// broke `let f31 = () -> f32()` (#3729). The refusal is held while
/// `parse_type_tentatively` runs, and a caller that commits to the type asks
/// `refuse_retired_in_type` afterwards. A log rather than a flag, like
/// `compiler_spelled_type_params` below (top-level bindings are immutable).
let retired_type_refusal_holds: Array[Int] = Array::slice([0], start = 0, end = 0)

/// `parse_type_with_source_context` at mode 0 with the retired-name refusal
/// held; a parse error still propagates. Pair it with
/// `refuse_retired_in_type` once the type is known to be one.
export fn parse_type_tentatively(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (TypeExpr, Int) with Exception {
  let depth = Array::length(retired_type_refusal_holds)
  Array::push(retired_type_refusal_holds, value = 1)
  let (parsed, msg) = handle {
    let (ty, next) = parse_type_with_source_context(tokens = tokens, pos = pos, mode = 0, context = context)
    (Some((ty, next)), "")
  } with { Exception::Throw(m) => (None, m) }
  Array::truncate(retired_type_refusal_holds, length = depth)
  match parsed {
    Some(pair) => pair,
    None => throw(msg)
  }
}

/// The refusal `parse_type_tentatively` held, applied to a type the caller
/// has committed to: the first retired name in it, left to right, including
/// the names inside a function type's effect row.
export fn refuse_retired_in_type(_ ty: TypeExpr) -> Unit with Exception {
  match ty {
    TyName(name) => refuse_retired_type_name(name),
    TyApp(name, args) => {
      refuse_retired_type_name(name)
      for arg in args {
        refuse_retired_in_type(arg)
      }
    },
    TyFn(params, ret, row) => {
      for p in params {
        refuse_retired_in_type(p)
      }
      refuse_retired_in_type(ret)
      match row {
        Some(text) => refuse_retired_in_row_text(text),
        None => ()
      }
    },
    TyTuple(items) => for item in items {
      refuse_retired_in_type(item)
    },
    TyUnit => ()
  }
}

fn row_text_ident_byte(_ b: Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn refuse_retired_in_row_text(_ text: String) -> Unit with Exception {
  let n = String::length(text)
  let mut i = 0
  while i < n {
    if row_text_ident_byte(String::byte_at(text, at = i)) {
      let start = i
      while i < n && row_text_ident_byte(String::byte_at(text, at = i)) {
        i = i + 1
      }
      refuse_retired_type_name(String::substring(text, start = start, end = i))
    } else {
      i = i + 1
    }
  }
}

export fn parse_type_param_kind(tokens: Array[Token], pos: Int, name: String) -> (String, Int) with Exception {
  // ADR-0122 (#3728): `Float64` / `Float32` are the builtin float types'
  // width-named spellings, read as `Double` / `Float` in every type position.
  // A type parameter spelled with any name of a builtin float type would
  // capture or be captured by that reading -- `[Float64]` could not be told
  // apart from the builtin, and in `struct R[Double] { w: Float64 }` the
  // field meant as a float would name the parameter -- so all six spellings
  // are refused here, the one place every type-parameter collector goes
  // through.
  if name == "Float64" || name == "Float32" || name == "Double" || name == "Float" || name == "f64" || name == "f32" {
    throw("rename this type parameter: `" + name + "` is the builtin float type's name, and every `" + name + "` in a type names that builtin")
  } else {
    ()
  }
  // #3727: `i32` is no type and no declaration may take it, so a type
  // parameter of that name would make `i32` mean something again.
  if name == "i32" {
    throw("rename this type parameter: `i32` is reserved (the integer type is `Int`)")
  } else {
    ()
  }
  // #2141 / #2474: `__Vfp_` is how normalize/desugar_trait_dict re-spells a
  // formal inside a synthesized `__arr_equals__` helper, and the checker's
  // `==`-needs-`Eq` rule exempts exactly that spelling because the helper's
  // raw element compare is the compiler's, not the author's. Synthesized
  // helpers are built as AST and never pass through here, so this is the one
  // place a USER binder could borrow the spelling and slip past that rule.
  // Every type-parameter collector (struct / enum / fn / lambda / impl) goes
  // through this function. The one parse that reads such a binder
  // legitimately -- the module-source builder re-reading the merged program
  // the compiler printed itself -- says so first (`compiler_spelled_type_params`).
  if String::starts_with(name, prefix = "__Vfp_") && !reads_compiler_spelled_type_params() {
    throw(String::concat("type parameter `", String::concat(name, "` uses the reserved `__Vfp_` prefix (compiler-generated type-variable spellings) -- rename it (#2141)")))
  } else {
    ()
  }
  match peek(tokens = tokens, pos = pos) {
    TLBracket => {
      let mut p = pos + 1
      let mut arity = 0
      let mut done = false
      while !done {
        match peek(tokens = tokens, pos = p) {
          TIdent(hole) => if hole == "_" {
            arity = arity + 1
            p = p + 1
            match peek(tokens = tokens, pos = p) {
              TComma => {
                p = p + 1
              },
              TRBracket => {
                p = p + 1
                done = true
              },
              _ => throw("expected ',' or ']' after '_' in a constructor type parameter")
            }
          } else {
            throw("a constructor type parameter kind contains only '_' placeholders, such as F[_]")
          },
          TRBracket => throw("a constructor type parameter needs at least one '_' placeholder"),
          _ => throw("expected '_' in a constructor type parameter, such as F[_]")
        }
      }
      (type_param_key(name = name, arity = arity), p)
    },
    _ => (type_param_key(name = name, arity = 0), pos)
  }
}

fn _no_tp() -> Array[String] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn _no_tb() -> Array[(String, Array[String])] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let mode_if = 21

export fn tk_name(_ tok: Token) -> String {
  match tok {
    TInt(_) => "int",
    TFloat(_) => "float",
    TFloat32(_) => "float",
    TString(_) => "string",
    TStringInterp(_, _) => "string",
    TIdent(_) => "ident",
    TLet => "let",
    TRec => "rec",
    TMut => "mut",
    TFn => "fn",
    TIf => "if",
    TElse => "else",
    TMatch => "match",
    TIs => "is",
    TGuard => "guard",
    TDo => "do",
    TEnum => "enum",
    TStruct => "struct",
    TType => "type",
    TTrait => "trait",
    TImpl => "impl",
    TExport => "export",
    TTest => "test",
    TExample => "example",
    TWhile => "while",
    TFor => "for",
    TIn => "in",
    TLoop => "loop",
    TBreak => "break",
    TContinue => "continue",
    TReturn => "return",
    TWith => "with",
    THandle => "handle",
    TTaskGroup => "taskgroup",
    TRegion => "region",
    TThrow => "throw",
    TRaise => "raise",
    TYield => "yield",
    TBench => "bench",
    TDeclare => "declare",
    TAs => "as",
    TModule => "module",
    TSuberror => "suberror",
    TDerive => "derive",
    TOpen => "open",
    TImport => "import",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TAnd => "&&",
    TOr => "||",
    TNot => "!",
    TBitAnd => "&",
    TBitOr => "|",
    TBitXor => "^",
    TLShift => "<<",
    TRShift => ">>",
    TPipeGt => "|>",
    TArrow => "=>",
    TThinArrow => "->",
    TEq => "=",
    TDot => ".",
    TColon => ":",
    TDoubleColon => "::",
    TComma => ",",
    TSemicolon => ";",
    THash => "#",
    TTilde => "~",
    TQuestion => "?",
    TPlusEq => "+=",
    TMinusEq => "-=",
    TStarEq => "*=",
    TSlashEq => "/=",
    TPercentEq => "%=",
    TLParen => "(",
    TRParen => ")",
    TLBrace => "{",
    TRBrace => "}",
    TLBracket => "[",
    TRBracket => "]",
    TDotDot => "..",
    TDotDotDot => "...",
    TEof => "eof"
  }
}

fn is_tk(tok: Token, name: String) -> Bool {
  tk_name(tok) == name
}

fn expect_tk(tokens: Array[Token], pos: Int, expected: String) -> Int with Exception {
  if is_tk(tok = peek(tokens = tokens, pos = pos), name = expected) {
    pos + 1
  } else {
    // A `;` here is usually the lexer's line break (#3546), so name both.
    let actual = match peek(tokens = tokens, pos = pos) {
      TSemicolon => "the end of the line (or `;`)",
      other => tk_name(other)
    }
    // #816: carry the failing TOKEN index; parse_program_located decodes it
    // to a real line:col (and strips it from the user-facing message).
    throw("expected \{expected} but got \{actual} at #\{pos}")
  }
}

fn is_lowercase_start(_ n: String) -> Bool {
  String::length(n) > 0 && String::byte_at(n, at = 0) >= 'a' && String::byte_at(n, at = 0) <= 'z'
}

/// The builtin namespaces a program calls as `Name::op` without importing
/// anything. An import alias with one of these names shadowed the namespace.
///
/// The parser cannot import the compiler's builtin tables, so this is a copy:
/// `lib/@vibe/compiler/tests/import_alias_namespace_test.vibe` walks every
/// `Name::op` spelling of the builtin registry, the checker's by-name call
/// arms and the builtin-shadow rename list, and fails naming any head missing
/// here.
let builtin_namespace_names: Array[String] = [
  "Array",
  "ArrayBuilder",
  "Bool",
  "ByteStream",
  "Bytes",
  "Char",
  "Console",
  "Double",
  "Env",
  "FixedArray",
  "Float",
  "Float32",
  "Float64",
  "FrozenArray",
  "Fs",
  "Future",
  "HostResponse",
  "HostStream",
  "Http",
  "Int",
  "Int64Array",
  "Map",
  "MapBuilder",
  "MutBytes",
  "MutList",
  "Path",
  "Process",
  "Profiler",
  "Stderr",
  "Stdin",
  "StdinStream",
  "Stdout",
  "String",
  "StringBuilder",
  "StringMap",
  "TaskGroup"
]

/// Whether `n` is one of `builtin_namespace_names`. The checker asks it too,
/// for the import aliases the parser cannot classify (see
/// `import_item_is_value`).
export fn is_builtin_namespace_name(_ n: String) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(builtin_namespace_names) {
    found = Array::get(builtin_namespace_names, at = i) == n
    i = i + 1
  }
  found
}

/// Whether an import item brings in a VALUE rather than a type. An item with
/// a kind keyword (`struct`, `enum`, `type`, `trait`, `effect`) is a type. A
/// qualified item (`Record::make`) is a member -- a method or an operation --
/// so a value however it is spelled, and a plain item is a value when it is
/// spelled in lowercase (`pub_f`).
///
/// A plain CAPITALIZED item is undecided here: it is a type (`Record`) or a
/// function (`MakeTag`), and only the providing module knows which. The parser
/// lets it through and the checker refuses it under a builtin namespace's name
/// once the import is resolved (`import_item_namespace_alias_errors`).
fn import_item_is_value(kind: Option[ImportKind], name: String) -> Bool {
  match kind {
    Some(_) => false,
    None => String::contains(name, needle = "::") || is_lowercase_start(name)
  }
}

export fn skip_semi(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens = tokens, pos = pos) {
    TSemicolon => pos + 1,
    _ => pos
  }
}

fn empty_arms() -> Array[(Pat, Expr)] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn empty_pats() -> Array[Pat] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

//# Qualified variant pattern side channel (#1455 step 3)

/// Every `Enum::Variant` seen in pattern position, as `(qualifier, variant)`.
///
/// `parse_pattern` lowers `Color::Red` to the SAME `PCtor("Red", ..)` the bare
/// spelling produces (see the #742 note there), so nothing downstream can tell
/// the two apart -- and nothing ever checks that `Color` actually owns `Red`.
/// `Zzz::Mk(n)` type-checks and compiles today.
///
/// Carrying the qualifier inside `Pat` instead would put a qualified name in
/// front of the ~80 sites that read a `PCtor` name (codegen's ctor table,
/// exhaustiveness, perceus, DCE, the trait-dict desugar); every one of them
/// would have to unqualify, and a missed one is a silent miscompile rather
/// than a build error. Recording the pair out of band keeps the AST the parser
/// produces byte-identical to before this channel existed, and leaves the
/// membership check to the checker, which already builds the enum table.
let qualified_pattern_refs: Array[(String, String)] = Array::slice([("", "")], start = 0, end = 0)
let bare_pattern_refs: Array[String] = []

export fn pattern_ref_mark() -> (Int, Int) {
  (Array::length(qualified_pattern_refs), Array::length(bare_pattern_refs))
}

/// The pattern refs and the positional log for a fresh program, without
/// building a mark: every parse entry calls it.
export fn reset_pattern_refs() -> Unit {
  Array::truncate(qualified_pattern_refs, length = 0)
  Array::truncate(bare_pattern_refs, length = 0)
  Array::truncate(positional_param_rows, length = 0)
}

export fn restore_pattern_refs(_ mark: (Int, Int)) -> Unit {
  Array::truncate(qualified_pattern_refs, length = mark.0)
  Array::truncate(bare_pattern_refs, length = mark.1)
}

/// A handler's operation pattern is qualified in the AST itself. Its parser
/// side-channel row would falsely compete with an enum constructor pattern.
/// Keep any nested constructor refs in the operation's payload.
export fn discard_handler_operation_ref(mark: (Int, Int), qualifier: String, variant: String) -> Unit {
  if qualifier == "" {
    let mut i = mark.1
    let n = Array::length(bare_pattern_refs)
    while i < n {
      if Array::get(bare_pattern_refs, at = i) == variant {
        let mut j = i
        while j + 1 < n {
          Array::set(bare_pattern_refs, at = j, value = Array::get(bare_pattern_refs, at = j + 1))
          j = j + 1
        }
        Array::truncate(bare_pattern_refs, length = n - 1)
        i = n
      } else {
        i = i + 1
      }
    }
  } else {
    let mut i = mark.0
    let n = Array::length(qualified_pattern_refs)
    while i < n {
      let row = Array::get(qualified_pattern_refs, at = i)
      if row.0 == qualifier && row.1 == variant {
        let mut j = i
        while j + 1 < n {
          Array::set(qualified_pattern_refs, at = j, value = Array::get(qualified_pattern_refs, at = j + 1))
          j = j + 1
        }
        Array::truncate(qualified_pattern_refs, length = n - 1)
        i = n
      } else {
        i = i + 1
      }
    }
  }
}

fn note_bare_pattern_ref(_ variant: String) -> Unit {
  let mut seen = false
  for name in bare_pattern_refs {
    if name == variant {
      seen = true
    }
  }
  if !seen {
    Array::push(bare_pattern_refs, value = variant)
  }
}

/// Record one `qualifier::variant` pattern occurrence.
///
/// Deduped on push. The log is normally drained by the checker, but a
/// parse-only consumer (`vibe fmt`, an LSP that never type-checks the buffer)
/// leaves its entries behind, so growth has to be bounded by the number of
/// DISTINCT pairs rather than by the number of occurrences.
fn note_qualified_pattern_ref(qualifier: String, variant: String) -> Unit {
  let n = Array::length(qualified_pattern_refs)
  let mut i = 0
  let mut seen = false
  while i < n {
    let (q, v) = Array::get(qualified_pattern_refs, at = i)
    if q == qualifier && v == variant {
      seen = true
    } else {
      ()
    }
    i = i + 1
  }
  if seen {
    ()
  } else {
    Array::push(qualified_pattern_refs, value = (qualifier, variant))
  }
}

/// #2654: the module-source builder (`build_module_source_from_source`, the
/// emit-module-source step of scripts/generate_bundle.sh) re-reads the merged
/// program the compiler printed one step earlier, in which a synthesized
/// `__arr_equals__` / `__map_equals__` helper keeps the desugar's `__Vfp_`
/// spelling on its formal. parse_type_param_kind refuses that spelling in
/// authored source (#2141 / #2474), so the builder switches this on around
/// its parses and off again; every other parse keeps the refusal. Measured
/// with the 0ebddad stage2 as the seed: the merged compiler carried four such
/// helpers and the seed refused its own output. A log rather than a flag,
/// like `qualified_pattern_refs` above (top-level bindings are immutable).
let compiler_spelled_type_params: Array[Int] = Array::slice([0], start = 0, end = 0)

export fn set_compiler_spelled_type_params(_ on: Bool) -> Unit {
  Array::truncate(compiler_spelled_type_params, length = 0)
  if on {
    Array::push(compiler_spelled_type_params, value = 1)
  } else {
    ()
  }
}

fn reads_compiler_spelled_type_params() -> Bool {
  Array::length(compiler_spelled_type_params) > 0
}

/// #1508: `(test name, effect row text)` for every `test "n" allows A + B { .. }`
/// / `bench "n" allows .. { .. }` this parse saw. Same log-then-fold-into-a-marker
/// shape as `qualified_pattern_refs` above, and for the same reason: the row has
/// nowhere to live on `STest` / `SBench` without widening ~200 read sites.
let test_effect_rows: Array[(String, String)] = Array::slice([("", "")], start = 0, end = 0)

///|
export fn record_test_effect_row(name: String, row: String) -> Unit {
  Array::push(test_effect_rows, value = (name, row))
}

///|
#zero_alloc
export fn has_test_effect_rows() -> Bool {
  Array::length(test_effect_rows) > 0
}

///|
export fn take_test_effect_rows() -> Array[(String, String)] {
  let n = Array::length(test_effect_rows)
  let out = Array::slice(test_effect_rows, start = 0, end = n)
  Array::truncate(test_effect_rows, length = 0)
  out
}

/// ADR-0120 D3 (#3681): `(declaration name, slot indices)` for every `fn`
/// declaration this parse saw with a `_` before a parameter. Same
/// log-then-fold-into-a-marker shape as `test_effect_rows` above: the slots
/// travel in a trailing `SPositionalParams` statement, not on the parameter.
let positional_param_rows: Array[(String, Array[Int])] = Array::slice([("", [0])], start = 0, end = 0)

export fn record_positional_params(name: String, slots: Array[Int]) -> Unit {
  Array::push(positional_param_rows, value = (name, slots))
}

#zero_alloc
export fn has_positional_params() -> Bool {
  Array::length(positional_param_rows) > 0
}

/// `let f = (_ x: Int) -> ..`: the top-level `let` arms this just before its
/// initializer, and the first lambda parameter list parsed after that takes
/// it -- the initializer's own, when the initializer is a lambda. Any other
/// list that writes `_` before a parameter is refused, so the marker can
/// never ride a nested lambda unread.
let lambda_positional_armed: Array[Bool] = Array::slice([false, false], start = 0, end = 1)
let lambda_positional_slots: Array[Int] = Array::slice([0], start = 0, end = 0)

export fn arm_lambda_positional() -> Unit {
  Array::set(lambda_positional_armed, at = 0, value = true)
  Array::truncate(lambda_positional_slots, length = 0)
}

/// Disarm and hand back the slots the armed list wrote.
export fn disarm_lambda_positional() -> Array[Int] {
  Array::set(lambda_positional_armed, at = 0, value = false)
  // Every top-level statement disarms, so the common case hands back the
  // shared empty array and allocates nothing.
  if Array::length(lambda_positional_slots) == 0 {
    no_lambda_positional_slots
  } else {
    let out = Array::slice(lambda_positional_slots, start = 0, end = Array::length(lambda_positional_slots))
    Array::truncate(lambda_positional_slots, length = 0)
    out
  }
}

let no_lambda_positional_slots: Array[Int] = Array::slice([0], start = 0, end = 0)

/// Is the token at `pos` a `_` written before a parameter's name? Nested
/// matches, not a match on a tuple: this runs for every parameter parsed, and
/// the tuple was a per-parameter allocation the parser benches caught.
export fn positional_marker_at(tokens: Array[Token], pos: Int) -> Bool {
  match peek(tokens = tokens, pos = pos) {
    TIdent(u) => u == "_" && match peek(tokens = tokens, pos = pos + 1) {
      TIdent(_) => true,
      _ => false
    },
    _ => false
  }
}

fn take_lambda_positional_armed() -> Bool {
  let armed = Array::get(lambda_positional_armed, at = 0)
  Array::set(lambda_positional_armed, at = 0, value = false)
  armed
}

/// A `_` before a lambda parameter's name: skipped and recorded when this
/// list took the arming, refused otherwise.
fn lambda_param_marker(tokens: Array[Token], pos: Int, index: Int, armed: Bool) -> Int with Exception {
  let marked = positional_marker_at(tokens = tokens, pos = pos)
  if !marked {
    pos
  } else if armed {
    Array::push(lambda_positional_slots, value = index)
    pos + 1
  } else {
    throw("`_` before a parameter marks a positional slot, which only a `fn` declaration or the lambda a top-level `let` is bound to can declare: remove `_ `, or declare the function with `fn` (`fn f(_ x: T) -> R { .. }`) at #\{pos}")
  }
}

/// The positional log's length, for `take_positional_params_since`.
export fn positional_params_mark() -> Int {
  Array::length(positional_param_rows)
}

/// Drop the rows recorded since `mark` (ADR-0120 D3): a discarded parse, such
/// as an inactive `#cfg` statement, must not leave a `fn f(_ x: Int)`'s slots
/// for an active `fn f(x: Int)` of the same name. An `Int` mark beside the
/// pattern-ref pair rather than a third member of it: the recovering parse
/// takes that pair for every statement, and the parser benches gate bytes
/// per op.
export fn restore_positional_params(_ mark: Int) -> Unit {
  Array::truncate(positional_param_rows, length = mark)
}

/// The rows recorded since `mark`, removed from the log.
export fn take_positional_params_since(_ mark: Int) -> Array[(String, Array[Int])] {
  let n = Array::length(positional_param_rows)
  let out = Array::slice(positional_param_rows, start = mark, end = n)
  Array::truncate(positional_param_rows, length = mark)
  out
}

export fn take_positional_params() -> Array[(String, Array[Int])] {
  let n = Array::length(positional_param_rows)
  let out = Array::slice(positional_param_rows, start = 0, end = n)
  Array::truncate(positional_param_rows, length = 0)
  out
}

/// Drain the log recorded since the last drain.
///
/// Consume-and-clear, and the checker drains BEFORE it walks the program:
/// a check that throws part way through must not leave its own entries behind
/// for the next, unrelated check to re-report. Entries that survive a
/// parse-only path stay inert because the validator only fires when the
/// qualifier names an enum that is actually in scope for the compilation doing
/// the checking.
export fn take_qualified_pattern_refs() -> Array[(String, String)] {
  let n = Array::length(qualified_pattern_refs)
  let out = Array::slice(qualified_pattern_refs, start = 0, end = n)
  for bare in bare_pattern_refs {
    let mut shares_variant = false
    for row in qualified_pattern_refs {
      if row.1 == bare {
        shares_variant = true
      }
    }
    if shares_variant {
      Array::push(out, value = ("", bare))
    }
  }
  Array::truncate(qualified_pattern_refs, length = 0)
  Array::truncate(bare_pattern_refs, length = 0)
  out
}

/// True when this parse recorded at least one qualified variant pattern.
///
/// The overwhelmingly common program has none, and `take_qualified_pattern_refs`
/// allocates a fresh array even to hand back an empty one -- once per parse,
/// which parser_bench saw as allocation drift on inputs containing no qualified
/// pattern at all (parse_deep_binop_chain +1.80%, parse_wide_match +1.42%, both
/// back to +-0 once callers check this first and skip the drain).
#zero_alloc
export fn has_qualified_pattern_refs() -> Bool {
  if Array::length(qualified_pattern_refs) > 0 {
    true
  } else {
    Array::truncate(bare_pattern_refs, length = 0)
    false
  }
}

let mode_block = 20

let mode_match = 22

let mode_while = 23

fn empty_ctors() -> Array[(String, Array[TypeExpr])] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn empty_exprs() -> Array[Expr] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let mode_for_in = 25

let mode_handle = 24

/// Parse a `derive(A, B, ...)` clause into the list of derived trait names plus
/// the position after the clause. Any identifier is accepted (the set of
/// structurally-derivable traits is validated later); a missing clause yields an
/// empty list. Supports multiple comma-separated names (#638).
export fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Exception {
  let names = ArrayBuilder::freeze(ArrayBuilder::new())
  match peek(tokens = tokens, pos = pos) {
    TDerive => match peek(tokens = tokens, pos = pos + 1) {
      TLParen => {
        let mut dp = pos + 2
        let mut dd = true
        while dd {
          match peek(tokens = tokens, pos = dp) {
            TRParen => {
              dd = false
              dp = dp + 1
            },
            TComma => {
              dp = dp + 1
            },
            TIdent(name) => {
              Array::push(names, value = name)
              dp = dp + 1
            },
            _ => throw("expected derive identifier")
          }
        }
        (names, dp)
      },
      _ => (names, pos)
    },
    _ => (names, pos)
  }
}

export fn skip_derive(tokens: Array[Token], pos: Int) -> Int with Exception {
  let (_, next) = parse_derive_names(tokens = tokens, pos = pos)
  next
}

fn empty_fields() -> Array[(String, TypeExpr)] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn empty_params() -> Array[(String, Option[TypeExpr])] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export fn parse_pattern_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Pat, Int) with Exception {
  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat], Option[ParserBinderContext]) -> (Array[Pat], Int) with Exception = (tokens, pos, b, context) -> {
    match peek(tokens = tokens, pos = pos) {
      TComma => {
        let (p, pn) = parse_pattern_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        ArrayBuilder::push(b, value = p)
        parse_pat_cont(tokens, pn, b, context)
      },
      TRParen => (ArrayBuilder::freeze(b), pos + 1),
      _ => throw("expected ',' or ')' in pattern list")
    }
  }
  let parse_pats_until_rparen: (Array[Token], Int, Option[ParserBinderContext]) -> (Array[Pat], Int) with Exception = (tokens, pos, context) -> {
    match peek(tokens = tokens, pos = pos) {
      TRParen => (empty_pats(), pos + 1),
      _ => {
        let (f, fn1) = parse_pattern_with_binder_context(tokens = tokens, pos = pos, context = context)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, value = f)
        parse_pat_cont(tokens, fn1, b, context)
      }
    }
  }
  let (pat, next) = match peek(tokens = tokens, pos = pos) {
    TInt(n) => (PInt(n), pos + 1),
    // A negative literal pattern `-5` / `-1.5` (lexed as TMinus + number).
    // Float literal patterns used to silently become PWild — the first
    // float arm then matched EVERYTHING (`match d { 0.0 => .., 1.0 => .. }`
    // always took "0.0"); they are real PFloat patterns now (bit-exact via
    // f64.eq at codegen, so 0.0 == -0.0 and NaN never matches, like `==`).
    TMinus => match peek(tokens = tokens, pos = pos + 1) {
      TInt(n) => (PInt(0 - n), pos + 2),
      TFloat(n) => (PFloat(0.0 - n), pos + 2),
      TFloat32(n) => (PFloat(0.0 - n), pos + 2),
      _ => throw("expected number literal after '-' in pattern")
    },
    TFloat(n) => (PFloat(n), pos + 1),
    // #3543: the payload is already the f32 value; the checker accepts it
    // against a `Float` scrutinee because it IS one.
    TFloat32(n) => (PFloat(n), pos + 1),
    TString(s) => (PString(s), pos + 1),
    TIdent(name) => {
      let next_is_lbrace = match peek(tokens = tokens, pos = pos + 1) {
        TLBrace => true,
        _ => false
      }
      if name == "true" {
        (PBool(true), pos + 1)
      }
      else if name == "false" {
        (PBool(false), pos + 1)
      }
      else if name == "_" {
        (PWild, pos + 1)
      }
      else if name == "record" && next_is_lbrace {
        let mut rp = pos + 2
        let field_pats_b = ArrayBuilder::new()
        let mut rd = true
        while rd {
          match peek(tokens = tokens, pos = rp) {
            TRBrace => {
              rd = false
            },
            TIdent(fname) => {
              match peek(tokens = tokens, pos = rp + 1) {
                TColon => {
                  let (fp, fnext) = parse_pattern_with_binder_context(tokens = tokens, pos = rp + 2, context = context)
                  ArrayBuilder::push(field_pats_b, value = fp)
                  rp = fnext
                },
                TComma => {
                  binder_capture_source(context = context, name = fname, first_token = rp, last_token = rp)
                  ArrayBuilder::push(field_pats_b, value = source_wrap_pat(pat = PBind(fname), first = rp, next = rp + 1, context = context)); rp = rp + 1
                },
                TRBrace => {
                  binder_capture_source(context = context, name = fname, first_token = rp, last_token = rp)
                  ArrayBuilder::push(field_pats_b, value = source_wrap_pat(pat = PBind(fname), first = rp, next = rp + 1, context = context)); rp = rp + 1
                },
                _ => {
                  binder_capture_source(context = context, name = fname, first_token = rp, last_token = rp)
                  ArrayBuilder::push(field_pats_b, value = source_wrap_pat(pat = PBind(fname), first = rp, next = rp + 1, context = context)); rp = rp + 1
                }
              }
              match peek(tokens = tokens, pos = rp) {
                TComma => {
                  rp = rp + 1
                },
                _ => ()
              }
            },
            _ => {
              rp = rp + 1
            }
          }
        }
        let rp2 = rp + 1
        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)
      }
      else {
        let fc = String::char_code_at(name, at = 0)
        if fc >= 65 && fc <= 90 {
          match peek(tokens = tokens, pos = pos + 1) {
            TLParen => {
              let (args, end) = parse_pats_until_rparen(tokens, pos + 2, context);
              note_bare_pattern_ref(name)
              (PCtor(name, args), end)
            },
            TDoubleColon => match peek(tokens = tokens, pos = pos + 2) {
              TLBrace => {
                let mut sp = pos + 3
                let field_pats = ArrayBuilder::new()
                let mut sd = true
                while sd {
                  match peek(tokens = tokens, pos = sp) {
                    TRBrace => {
                      sd = false
                    },
                    TIdent(fname) => {
                      binder_capture_source(context = context, name = fname, first_token = sp, last_token = sp)
                      ArrayBuilder::push(field_pats, value = (fname, source_wrap_pat(pat = PBind(fname), first = sp, next = sp + 1, context = context)))
                      sp = sp + 1
                      match peek(tokens = tokens, pos = sp) {
                        TComma => {
                          sp = sp + 1
                        },
                        _ => ()
                      }
                    },
                    // A struct pattern field binds its own name and nothing
                    // else. Anything but a name or `}` used to be taken as
                    // the closing brace, so the error landed on a later token
                    // (`expected = but got ident`) and named no edit.
                    TColon => {
                      let field = match peek(tokens = tokens, pos = sp - 1) {
                        TIdent(f) => f,
                        _ => "field"
                      }
                      throw("bind the field by its own name (`\{name}::{ \{field} }`) and match its value in the body (`match \{field} { .. }`): a struct pattern field binds a name, not a sub-pattern or a new name at #\{sp}")
                    },
                    _ => throw("expected a field name or `}` in the `\{name}::{ .. }` pattern at #\{sp}")
                  }
                }
                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)
              },
              // #742: qualified variant pattern `Enum::Variant(..)` /
              // `Enum::Variant`. The qualifier is dropped, mirroring the
              // expression side (#672): codegen's ctor table is keyed
              // unqualified, and handle-arm dispatch re-prefixes the effect
              // name onto a bare op pattern, so `Fs::ReadFile(p)` in a
              // `with Fs` arm also lands on the same name it does today.
              //
              // #1455 step 3: dropping it also dropped the only chance to
              // check that the qualifier owns the variant, so the pair goes
              // to the side channel above on its way out. Handle-arm op
              // patterns come through here too (`Fs::ReadFile(p)` records
              // `("Fs", "ReadFile")`); the checker ignores a qualifier that
              // does not name an enum, which is what makes that harmless.
              TIdent(vname) => {
                let vc = String::char_code_at(vname, at = 0)
                if vc >= 65 && vc <= 90 {
                  note_qualified_pattern_ref(qualifier = name, variant = vname)
                  // #3422: `Maybe::Some` / `Maybe::None` keep their owner, so
                  // the checker can tell them from the builtin `Some` /
                  // `None` at this pattern rather than program-wide. Every
                  // other reader compares the bare name
                  // (`pattern_ctor_base_name`).
                  let pname = if (vname == "Some" || vname == "None") && name != "Option" {
                    intern_qualified(ns = name, member = vname)
                  } else {
                    vname
                  }
                  match peek(tokens = tokens, pos = pos + 3) {
                    TLParen => {
                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4, context);
                      (PCtor(pname, args), end)
                    },
                    _ => (PCtor(pname, empty_pats()), pos + 3)
                  }
                } else {
                  note_bare_pattern_ref(name)
                  (PCtor(name, empty_pats()), pos + 1)
                }
              },
              _ => {
                note_bare_pattern_ref(name)
                (PCtor(name, empty_pats()), pos + 1)
              }
            },
            _ => {
              note_bare_pattern_ref(name)
              (PCtor(name, empty_pats()), pos + 1)
            }
          }
        } else {
          binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
          (PBind(name), pos + 1)
        }
      }
    },
    TLParen => match peek(tokens = tokens, pos = pos + 1) {
      TRParen => (PTuple(empty_pats()), pos + 2),
      _ => {
        let (f, n1) = parse_pattern_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        match peek(tokens = tokens, pos = n1) {
          TRParen => (f, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, value = f)
            let (rest, end) = parse_pat_cont(tokens, n1, b, context);
            (PTuple(rest), end)
          },
          _ => throw("expected ')' or ',' in pattern")
        }
      }
    },
    _ => {
      let actual = tk_name(peek(tokens = tokens, pos = pos))
      throw("unexpected in pattern: \{actual}")
    }
  }
  match pat {
    PCtor(name, _) => {
      let head = match peek(tokens = tokens, pos = pos + 1) {
        TDoubleColon => pos + 2,
        _ => pos
      }
      source_record_slot(kind = "pat_head", name = name, first = head, next = head + 1, context = context)
    },
    PStruct(name, _) => source_record_slot(kind = "pat_head", name = name, first = pos, next = pos + 1, context = context),
    _ => ()
  }
  let pat = source_wrap_pat(pat = pat, first = pos, next = next, context = context)
  let (result, end) = match peek(tokens = tokens, pos = next) {
    TBitOr => {
      binder_capture_mark_ineligible(context)
      let (right, end) = parse_pattern_with_binder_context(tokens = tokens, pos = next + 1, context = context);
      (POr(pat, right), end)
    },
    _ => (pat, next)
  }
  (source_wrap_pat(pat = result, first = pos, next = end, context = context), end)
}

fn parse_pattern(tokens: Array[Token], pos: Int) -> (Pat, Int) with Exception {
  parse_pattern_with_binder_context(tokens = tokens, pos = pos, context = None)
}

fn empty_type_exprs() -> Array[TypeExpr] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens = tokens, pos = pos) {
    TLBrace => {
      let mut bp = pos + 1
      let mut depth = 1
      while depth > 0 {
        match peek(tokens = tokens, pos = bp) {
          TLBrace => {
            depth = depth + 1
            bp = bp + 1
          },
          TRBrace => {
            depth = depth - 1
            bp = bp + 1
          },
          _ => {
            bp = bp + 1
          }
        }
      }
      bp
    },
    _ => pos
  }
}

/// Parse `Bound + Bound2 + ...` trait references for a bounded type parameter.
// Trait-bound names are references, not source binders.
fn parse_trait_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Exception {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens = tokens, pos = p) {
      TIdent(_) => {
        let (reference, next) = parse_type_impl(tokens = tokens, pos = p, mode = 0)
        let key = match reference {
          TyName(_) => trait_ref_key(reference),
          TyApp(_, _) => trait_ref_key(reference),
          _ => throw("a trait bound must be a named trait, such as `Eq` or `Iter[Int]`")
        }
        ArrayBuilder::push(b, value = key)
        p = next
        match peek(tokens = tokens, pos = p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

/// Parse a `[X: Bound, Y, ...]` binder after `[`. `separator_error` preserves
/// each caller's existing diagnostic; `allow_bounds = false` leaves `:` for
/// that separator diagnostic instead of accepting a bound.
fn parse_bounded_type_params_with_binder_context(tokens: Array[Token], pos: Int, allow_bounds: Bool, separator_error: String, context: Option[ParserBinderContext]) -> (Array[String], Array[(String, Array[String])], Int) with Exception {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens = tokens, pos = p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        binder_capture_source(context = context, name = name, first_token = p, last_token = p)
        let (param_key, after_kind) = parse_type_param_kind(tokens = tokens, pos = p + 1, name = name)
        ArrayBuilder::push(names, value = param_key)
        p = after_kind
        match peek(tokens = tokens, pos = p) {
          TColon => if allow_bounds {
            let (bound_names, next) = parse_trait_bound_names(tokens = tokens, pos = p + 1)
            ArrayBuilder::push(bounds, value = (param_key, bound_names))
            p = next
          } else {
            ()
          },
          _ => ()
        }
        match peek(tokens = tokens, pos = p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw(separator_error)
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

fn parse_trait_methods_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TLBrace => {
      let sigs_b = ArrayBuilder::new()
      let gens_b = ArrayBuilder::new()
      let mut p = pos + 1
      while true {
        match peek(tokens = tokens, pos = p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(method_name) => {
            binder_capture_source(context = context, name = method_name, first_token = p, last_token = p)
            // Optional `:` after the method name, so both
            // `m(Self) -> R` and `m: [X: Bound](Self, X) -> R` parse (#684).
            let after_colon = match peek(tokens = tokens, pos = p + 1) {
              TColon => p + 2,
              _ => p + 1
            }
            // Optional method-level generic binder `[X: Bound]`, declared on the
            // trait method only (rank-1 method generics, #684). The impl never
            // repeats it; the desugar reattaches it to the impl's free function.
            let (mtparams, mtbounds, after_binder) = match peek(tokens = tokens, pos = after_colon) {
              TLBracket => parse_bounded_type_params_with_binder_context(tokens = tokens, pos = after_colon + 1, allow_bounds = true, separator_error = "expected ',' or ']' in method type params", context = context),
              _ => (_no_tp(), _no_tb(), after_colon)
            }
            let (params, after_method_params) = match peek(tokens = tokens, pos = after_binder) {
              TLParen => {
                let (params_ty, after_paren) = parse_type_impl(tokens = tokens, pos = after_binder, mode = 1)
                let params = match params_ty {
                  TyUnit => empty_type_exprs(),
                  TyTuple(elems) => elems,
                  _ => [params_ty]
                }
                (params, after_paren)
              },
              _ => (empty_type_exprs(), after_binder)
            }
            let arrow_pos = expect_tk(tokens = tokens, pos = after_method_params, expected = "->")
            let (ret_type, after_ret) = parse_type_impl(tokens = tokens, pos = arrow_pos, mode = 0)
            ArrayBuilder::push(sigs_b, value = (method_name, params, ret_type))
            ArrayBuilder::push(gens_b, value = (method_name, mtparams, mtbounds))
            p = match peek(tokens = tokens, pos = after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected trait method signature or '}'")
        }
      }
      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)
    },
    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)
  }
}

export fn parse_trait_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  let empty_strings = ArrayBuilder::freeze(ArrayBuilder::new())
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      // Retain the declared bare header names while preserving the existing
      // accepting grammar: parse_tparam_names still skips non-name header
      // details such as bounds rather than giving them new semantics.
      let (tparams, after_name) = parse_tparam_names_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
      match peek(tokens = tokens, pos = after_name) {
        TColon => {
          let supers = empty_strings
          let mut p = after_name + 1
          let mut done = false
          while !done {
            match peek(tokens = tokens, pos = p) {
              TIdent(sname) => match peek(tokens = tokens, pos = p + 1) {
                TPlus => {
                  Array::push(supers, value = sname)
                  p = p + 2
                },
                _ => {
                  Array::push(supers, value = sname)
                  p = p + 1
                  done = true
                }
              },
              _ => {
                done = true
              }
            }
          }
          let np = p
          let (methods, method_gens, body_end) = parse_trait_methods_with_binder_context(tokens = tokens, pos = np, context = context)
          (STrait(exported, name, supers, methods, method_gens, tparams), body_end)
        },
        _ => {
          let (methods, method_gens, body_end) = parse_trait_methods_with_binder_context(tokens = tokens, pos = after_name, context = context)
          (STrait(exported, name, empty_strings, methods, method_gens, tparams), body_end)
        }
      }
    },
    _ => throw("expected trait name")
  }
}

fn parse_trait_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_trait_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
fn is_expr_end_token(_ tok: Token) -> Bool {
  match tok {
    TInt(_) => true,
    TFloat(_) => true,
    TFloat32(_) => true,
    TString(_) => true,
    TStringInterp(_, _) => true,
    TIdent(_) => true,
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

fn is_non_pipe_infix(_ tok: Token) -> Bool {
  match tok {
    TOr => true,
    TAnd => true,
    TEqEq => true,
    TNeq => true,
    TLt => true,
    TLte => true,
    TGt => true,
    TGte => true,
    TBitOr => true,
    TBitXor => true,
    TBitAnd => true,
    TLShift => true,
    TRShift => true,
    TPlus => true,
    TMinus => true,
    TStar => true,
    TSlash => true,
    TPercent => true,
    _ => false
  }
}

export fn parse_import_item_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (ImportItem, Int) with Exception {
  let parse_import_name: (Int, Option[ImportKind]) -> (ImportItem, Int) with Exception = (name_pos, kind) -> {
    match peek(tokens = tokens, pos = name_pos) {
      TIdent(name) => {
        let (base, after) = match peek(tokens = tokens, pos = name_pos + 1) {
          TDoubleColon => match peek(tokens = tokens, pos = name_pos + 2) {
            TIdent(member) => {
              refuse_retired_qualified(ns = name, member = member)
              (intern_qualified(ns = name, member = member), name_pos + 3)
            },
            _ => throw("expected qualified member name after '::'")
          },
          _ => (name, name_pos + 1)
        }
        match peek(tokens = tokens, pos = after) {
          TAs => match peek(tokens = tokens, pos = after + 1) {
            TIdent(alias) => {
              // A TYPE imported under a builtin's name is a source-owned type
              // (`{ struct Box as StringMap }`, wit_gen_test); a VALUE under one
              // shadows the namespace's operations. A qualified value
              // (`Record::make as Array`) is a value too.
              if is_builtin_namespace_name(alias) && import_item_is_value(kind = kind, name = base) {
                throw("choose another name than `\{alias}` for this import: `\{alias}` names the builtin `\{alias}::` operations, and an imported value under that name would take the `\{alias}::...` calls instead at #\{after + 1}")
              }
              binder_capture_source(context = context, name = alias, first_token = after + 1, last_token = after + 1)
              (ImportItem::{ kind, name: base, alias: Some(alias) }, after + 2)
            },
            _ => throw("expected alias name after 'as'")
          },
          _ => {
            binder_capture_source(context = context, name = base, first_token = name_pos, last_token = after - 1)
            (ImportItem::{ kind, name: base, alias: None }, after)
          }
        }
      },
      _ => throw("expected import item name")
    }
  }
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => if name == "effect" {
      parse_import_name(pos + 1, Some(ImportEffect))
    } else {
      parse_import_name(pos, None)
    },
    TType => parse_import_name(pos + 1, Some(ImportType)),
    TStruct => parse_import_name(pos + 1, Some(ImportStruct)),
    TEnum => parse_import_name(pos + 1, Some(ImportEnum)),
    TTrait => parse_import_name(pos + 1, Some(ImportTrait)),
    _ => throw("expected import item name")
  }
}

fn parse_import_item(tokens: Array[Token], pos: Int) -> (ImportItem, Int) with Exception {
  parse_import_item_with_binder_context(tokens = tokens, pos = pos, context = None)
}
fn empty_import_items() -> Array[ImportItem] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export fn parse_binding_name_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => match peek(tokens = tokens, pos = pos + 1) {
      TDoubleColon => match peek(tokens = tokens, pos = pos + 2) {
        TIdent(member) => {
          refuse_retired_qualified(ns = name, member = member)
          let qualified = intern_qualified(ns = name, member = member)
          match context {
            Some(_) => binder_capture_source(context = context, name = qualified, first_token = pos, last_token = pos + 2),
            None => ()
          }
          (qualified, pos + 3)
        },
        _ => throw("expected qualified member name after '::'")
      },
      _ => {
        match context {
          Some(_) => binder_capture_source(context = context, name = name, first_token = pos, last_token = pos),
          None => ()
        }
        (name, pos + 1)
      }
    },
    token => throw(binder_name_error(actual = tk_name(token), kind = "binding", pos = pos))
  }
}

/// A `let` / `fn` / parameter binder position holding something that is not a
/// name. `fn` already said which word was in the way and how to escape it
/// (`r#test`); every other position said only that a name was expected, which
/// names neither -- and at a `let`, the name IS there, so the message pointed
/// at the one thing that was fine. Measured 2026-08-19: `fn test() -> Int { 1 }`
/// explained itself; `let test = 1` and `fn f(test: Int)` did not, though
/// `r#test` works in all three. One spelling for all of them; `kind` is the
/// only difference.
export fn binder_name_error(actual: String, kind: String, pos: Int) -> String {
  let first = if String::length(actual) > 0 {
    String::char_code_at(actual, at = 0)
  } else {
    0
  }
  let word_token = (first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z')
  let literal_or_eof = actual == "int" || actual == "float" || actual == "string" || actual == "eof"
  if actual == "fn" {
    "`fn` is a reserved word and cannot be used as a \{kind} name; this keyword cannot be escaped, so choose a different name at #\{pos}"
  } else if word_token && !literal_or_eof {
    "`\{actual}` is a reserved word and cannot be used as a \{kind} name; write `r#\{actual}` to use it as a name at #\{pos}"
  } else {
    "expected \{kind} name\{binder_keyword_clause(kind)}, got '\{actual}' at #\{pos}"
  }
}

/// The keyword that opened the binder position, when there is one. A parameter
/// position is not opened by a keyword, so it gets no clause.
fn binder_keyword_clause(_ kind: String) -> String {
  if kind == "function" {
    " after 'fn'"
  } else if kind == "binding" {
    " after 'let'"
  } else {
    ""
  }
}

fn parse_binding_name(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  parse_binding_name_with_binder_context(tokens = tokens, pos = pos, context = None)
}
export fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TLBrace => (acc, pos),
    // #897: `as <mod> only { ... }` starts right after the path -- stop here
    // (mirrors the TLBrace/`@alias` early-outs above) so parse_import_path_tail
    // sees the 'as' token instead of this loop absorbing it as path text.
    TAs => (acc, pos),
    TDot => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, ".")),
    TDotDot => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "..")),
    TSlash => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "/")),
    // #769: a `@name` identifier only continues the PATH when it directly
    // follows a '/' (a scoped package segment, e.g. `lib/@vibe/json`). One
    // that follows a completed path with no separating '/' is the trailing
    // `import <path> @alias` alias token (parse_import_stmt peeks for it
    // right after this call returns) — stop here and let the caller see it,
    // instead of silently absorbing it into the path text and running on
    // into the NEXT statement's tokens looking for a '{' that will never
    // come (surfaced as "unexpected token in import path: import").
    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, at = 0) == '@' && !String::ends_with(acc, suffix = "/") {
      (acc, pos)
    } else {
      collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, name))
    },
    TMinus => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "-")),
    TModule => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "module")),
    TImpl => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "impl")),
    TType => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "type")),
    TMatch => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "match")),
    TTest => collect_import_path(tokens = tokens, pos = pos + 1, acc = String::concat(acc, "test")),
    _ => {
      let actual = tk_name(peek(tokens = tokens, pos = pos))
      throw(String::concat("unexpected token in import path: ", actual))
    }
  }
}

/// #829: collect the declared type-parameter NAMES of a `[T, U, ...]` header
/// (returning ([], pos) when there is no bracket). Mirrors parse_enum_stmt's
/// inline collector: only depth-1 identifiers in name position are kept, so a
/// bound like `[T: Eq]` still records just `T`.
export fn parse_tparam_names_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TLBracket => {
      let b = ArrayBuilder::new()
      let mut skip = pos + 1
      let mut depth = 1
      let mut expect_name = true
      while depth > 0 {
        match peek(tokens = tokens, pos = skip) {
          TLBracket => {
            depth = depth + 1; skip = skip + 1
          },
          TRBracket => {
            depth = depth - 1; skip = skip + 1
          },
          TComma => {
            if depth == 1 {
              expect_name = true
            }
            skip = skip + 1
          },
          TIdent(nm) => {
            if depth == 1 && expect_name {
              binder_capture_source(context = context, name = nm, first_token = skip, last_token = skip)
              let (param_key, after_kind) = parse_type_param_kind(tokens = tokens, pos = skip + 1, name = nm)
              ArrayBuilder::push(b, value = param_key)
              expect_name = false
              skip = after_kind
            } else {
              skip = skip + 1
            }
          },
          TEof => {
            depth = 0
          },
          _ => {
            skip = skip + 1
          }
        }
      }
      (ArrayBuilder::freeze(b), skip)
    },
    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos)
  }
}

fn parse_tparam_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Exception {
  parse_tparam_names_with_binder_context(tokens = tokens, pos = pos, context = None)
}

/// #1340 (ADR-0071): capture a generic row item's bracketed type-argument
/// group (`State[Int]`, `Exception[MyErr]`, nested `State[Array[Int]]`)
/// back into the row string. COMMAS ARE REJECTED: the whole row pipeline
/// (checker/core splitters, effectset expansion) splits row strings on ","
/// -- a comma inside a label would silently shear it apart -- so a row item
/// takes exactly ONE type argument for now (single-param generic effects:
/// `State[S]`, `Exception[E]`). Only type names and nested brackets are
/// accepted inside the group. Entered just after the opening '[' with
/// depth 1 and `acc` already holding `name[`.
fn collect_row_item_targs(tokens: Array[Token], pos: Int, depth: Int, acc: String) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    // ADR-0122 (#3728): a row's type arguments are collected as text, outside
    // `parse_type`, so the width-named float spellings are canonicalized here
    // too: `with Box[Float64]` names the same row as `with Box[Double]`.
    TIdent(nm) => {
      refuse_retired_type(nm)
      collect_row_item_targs(tokens = tokens, pos = pos + 1, depth = depth, acc = String::concat(acc, nm))
    },
    TComma => throw("a generic effect row item takes exactly one type argument for now (multi-argument instantiations in `with { ... }` are not yet supported)"),
    TLBracket => collect_row_item_targs(tokens = tokens, pos = pos + 1, depth = depth + 1, acc = String::concat(acc, "[")),
    TRBracket => if depth == 1 {
      (String::concat(acc, "]"), pos + 1)
    } else {
      collect_row_item_targs(tokens = tokens, pos = pos + 1, depth = depth - 1, acc = String::concat(acc, "]"))
    },
    _ => throw("expected a type name or ']' in the effect row item's type arguments")
  }
}

/// ADR-0071 (effectset): a row item is either a bare effect/effectset/row-var
/// identifier (`Env`), a qualified single operation (`Env::get`) -- same
/// `Ident (:: Ident)?` qualification already used by parse_import_item and
/// parse_binding_name -- or (#1340) a generic effect instantiation
/// (`State[Int]`, via collect_row_item_targs above). The row itself stays a
/// plain comma-joined `String` (see TyFn/EFn's `Option[String]` field) so a
/// qualified item round-trips through the printer for free -- it just
/// splices the text back verbatim, no re-parsing. Checker-side recognition
/// of `Effect::op` items (expanding them to a single-operation row instead
/// of rejecting as an unknown effect name) is a separate, larger change
/// (ADR-0071 step 3), not attempted here.
fn collect_effect_names(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TRBrace => (acc, pos + 1),
    TIdent(name) => {
      let (item, after_item) = match peek(tokens = tokens, pos = pos + 1) {
        TDoubleColon => match peek(tokens = tokens, pos = pos + 2) {
          TIdent(member) => (intern_qualified(ns = name, member = member), pos + 3),
          _ => throw("expected qualified operation name after '::' in effect list")
        },
        TLBracket => collect_row_item_targs(tokens = tokens, pos = pos + 2, depth = 1, acc = String::concat(name, "[")),
        _ => (name, pos + 1)
      }
      let new_acc = if String::length(acc) == 0 {
        item
      } else "\{acc}, \{item}"
      match peek(tokens = tokens, pos = after_item) {
        TComma => collect_effect_names(tokens = tokens, pos = after_item + 1, acc = new_acc),
        TRBrace => (new_acc, after_item + 1),
        _ => throw("expected ',' or '}' in effect list")
      }
    },
    _ => throw("expected effect name or '}'")
  }
}

/// #1429: one effect-row item -- `Name`, `Name::Op`, or `Name[T, ..]`. Split
/// out of collect_effect_names so the braced and braceless spellings read the
/// same item grammar rather than drifting apart.
/// #1461 final stage: `Error` is no longer a spelling. It was the original name
/// of the core ambient exception effect and rode along as an accepted alias
/// through the migration; ADR-0085 made `Exception` the one name, and every row
/// in this tree was converted.
///
/// A row item (`parse_effect_item`, right here) is the one caller. The other
/// place a source effect name was produced, the `handle { .. } with E { .. }`
/// header, was removed in #3530: mode 24 refuses that header outright and
/// names `Exception` for `Error`, and a qualified handler arm
/// (`parse_qualified_handle_arm`) refuses `Error::Throw` itself (#1501, #3284).
///
/// `perform Error::Throw(x)` is deliberately NOT covered: an operation
/// qualifier is not a row item, it names the operation the runtime dispatches,
/// and no row is being spelled there.
///
/// This is a SURFACE rejection and nothing more. `is_exception_effect_name`
/// still answers true for the label internally, the taxonomy table still
/// carries its row, and `printer.vibe` still re-sugars both spellings -- a
/// pinned seed from before the bump prints `Error`, and re-sugar must keep
/// reading it. What changes is only what a `.vibe` file may say.
///
/// Named, like #1429's braced-row rejection, for the same reason: a reader who
/// gets "expected an effect name" has no way to learn that the name moved.
/// #1514: `pos` is the LABEL's token index, carried in the ` at #N` side channel
/// `parse_program_located` decodes (and strips). Without it this reported the
/// enclosing declaration's start -- `Error` at 6:24 was blamed on `6:1`, the
/// `fn` keyword. Measured in eval/lang-review/repair/02.
fn reject_retired_effect_label(name: String, pos: Int) -> Unit with Exception {
  if name == "Error" {
    throw("`Error` was retired as an effect spelling in #1461 -- write `Exception` (or `Exception[Kind]` for a typed row). at #\{pos}")
  } else if name == "Mut" {
    // #3045: `Mut` is reserved for a future marker of argument mutation. Every
    // `with` / `allows` row item passes through here, whatever construct the
    // row sits in (a declaration, a closure, an impl target, a test), so this
    // is the one place that covers them all; the checker's scans remain for
    // effect and effectset declarations, which are not rows.
    throw("remove `Mut` from the row: the label is reserved for a future marker of argument mutation, and a function may already mutate values reachable from its arguments without declaring anything at #\{pos}")
  } else {
    ()
  }
}

fn parse_effect_item(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      // Covers every shape the label can take: bare (`Error`), qualified
      // (`Error::Throw`), and applied (`Error[IoError]`) -- the check is on the
      // HEAD, which all three share.
      reject_retired_effect_label(name = name, pos = pos)
      match peek(tokens = tokens, pos = pos + 1) {
        TDoubleColon => match peek(tokens = tokens, pos = pos + 2) {
          TIdent(member) =>
          (intern_qualified(ns = name, member = member), pos + 3),
          _ => throw("expected qualified operation name after '::' in effect row")
        },
        TLBracket => collect_row_item_targs(tokens = tokens, pos = pos + 2, depth = 1, acc = String::concat(name, "[")),
        _ => (name, pos + 1)
      }
    },
    _ => throw("expected an effect name in the effect row after 'with'")
  }
}

/// ADR-0088: `?` is the Optional grade. On an entry's `allows` row it marks a
/// GRANT optional (`fn main allows Fs::read_file?`); on a called function's
/// `with` row it marks a REQUIREMENT optional (`fn cached() -> .. with
/// Fs::read_file?`), which a caller satisfies with either grade of the same
/// label. The checker treats `Op?` as never authorizing a plain perform/call
/// of `Op`, and refuses `?` on anything but a host capability.

/// #1429: the braceless row `A + B`. Items are separated by `+` and the row
/// ends at the first token that is not `+` -- which is why the separator is
/// `+` and not `,`: in a nested function TYPE a comma cannot be told apart
/// from the enclosing list's comma (`((Int) -> Int with A, B)` would be either
/// one row of two labels or a two-element tuple), while `+` can start neither
/// a type nor a parameter, so the row's end is unambiguous in every position
/// with no lookahead. `+` is also already the language's "and another one"
/// separator, in trait bounds (`[T: A + B]`).
fn collect_effect_names_plus(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with Exception {
  collect_effect_names_plus_grade(tokens = tokens, pos = pos, acc = acc, allow_optional = true)
}

fn collect_allows_names_plus(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with Exception {
  collect_effect_names_plus_grade(tokens = tokens, pos = pos, acc = acc, allow_optional = true)
}

fn collect_effect_names_plus_grade(tokens: Array[Token], pos: Int, acc: String, allow_optional: Bool) -> (String, Int) with Exception {
  let (item0, after_item0) = parse_effect_item(tokens = tokens, pos = pos)
  let (item, after_item) = if allow_optional {
    match peek(tokens = tokens, pos = after_item0) {
      TQuestion => (String::concat(item0, "?"), after_item0 + 1),
      _ => (item0, after_item0)
    }
  } else {
    (item0, after_item0)
  }
  let new_acc = if String::length(acc) == 0 {
    item
  } else "\{acc}, \{item}"
  match peek(tokens = tokens, pos = after_item) {
    TPlus => collect_effect_names_plus_grade(tokens = tokens, pos = after_item + 1, acc = new_acc, allow_optional = allow_optional),
    _ => (new_acc, after_item)
  }
}

/// #1429: parse the effect row that follows `with`. `pos` is the token AFTER
/// the `with` keyword. There is now exactly ONE spelling, plus a spelling for
/// the empty row:
///
///   with A + B      the row
///   with ()         the explicitly empty row
///
/// The braced `with { A, B }` was accepted through the migration and is now
/// REJECTED by name. Both were parsed into the same comma-joined internal
/// string, so nothing downstream ever observed the difference -- which is what
/// let them coexist while the tree was converted, and why removing one costs
/// nothing but the error below.
///
/// The rejection is a named diagnostic rather than "expected an effect name",
/// because the reader of that generic message has no way to know the syntax
/// moved.
///
/// `()` is the empty row and NOTHING else: a parenthesised non-empty row is
/// rejected rather than accepted as a second grouping syntax, because allowing
/// it would put the brace-vs-no-brace choice straight back into the language
/// under different punctuation.
///
/// NOTE: `effectset Name = { A, B }` still uses braces and still shares
/// collect_effect_names' item grammar. Whether that brace should follow the row
/// is deliberately UNDECIDED -- an `effectset` is a declaration of a set, not a
/// row, so the two are not obviously the same question.
fn parse_effect_row_base(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    // #1514: blame the `{` itself, not the enclosing declaration's start.
    TLBrace => throw("the braced effect row `with { A, B }` was removed in #1429 -- write `with A + B` (and `with ()` for the empty row). at #\{pos}"),
    TLParen => match peek(tokens = tokens, pos = pos + 1) {
      TRParen => ("", pos + 2),
      _ => throw("`with (` spells the EMPTY effect row `with ()` and nothing else -- a parenthesised non-empty row is not a spelling. Write `with A + B` (#1429) at #\{pos}")
    },
    _ => collect_effect_names_plus(tokens = tokens, pos = pos, acc = "")
  }
}

/// The row of an ENTRY POINT, introduced by the contextual keyword `allows`
/// (`fn main allows Console + Fs::read_file?`, `test "n" allows Http { .. }`).
/// `pos` is the token AFTER `allows`.
///
/// An entry point has no caller to require effects from, so its row is a
/// GRANT: `allows` names the authority the run brings in -- the host
/// capabilities, `Exception` for a failure the runtime boundary may diagnose,
/// `Async` for the runtime driver, or an `effectset` of those. The row is
/// stored exactly like a `with` row (comma-joined labels), so every consumer
/// -- entry admission, the Async / exception boundaries, WIT, the entry
/// execution cache -- reads ONE representation and the two spellings cannot
/// drift apart. What differs from `with` is where the clause may appear (an
/// entry head only; see parse_fn_signature_with_binder_context and
/// parse_test_row_suffix) and that the Optional grade `?` is legal on an item.
///
/// `allows` is CONTEXTUAL, deliberately not reserved: it is recognized only
/// where an entry row may begin, so `let allows = 7` keeps compiling.
/// `allows ()` spells the explicitly empty grant, like `with ()`.
export fn parse_allows_row(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    // #1514: blame the `{` itself, not the enclosing declaration's start.
    TLBrace => throw("the braced row `allows { A, B }` is not a spelling -- write `allows A + B` (and `allows ()` for the empty row) at #\{pos}"),
    TLParen => match peek(tokens = tokens, pos = pos + 1) {
      TRParen => ("", pos + 2),
      _ => throw("`allows (` spells the EMPTY row `allows ()` and nothing else -- a parenthesised non-empty row is not a spelling. Write `allows A + B` at #\{pos}")
    },
    _ => collect_allows_names_plus(tokens = tokens, pos = pos, acc = "")
  }
}

/// Is `tokens[pos]` the contextual keyword `allows`?
export fn peek_is_allows(tokens: Array[Token], pos: Int) -> Bool {
  match peek(tokens = tokens, pos = pos) {
    TIdent(kw) => kw == "allows",
    _ => false
  }
}

/// The program entry names whose `fn` head may carry an `allows` row. `test`
/// / `bench` / `example` blocks are entry points too, parsed elsewhere.
export fn is_entry_fn_name(_ name: String) -> Bool {
  name == "main" || name == "_start"
}

/// The message for an `allows` written where only `with` may appear. It leads
/// with the edit: `what` names the declaration ("`helper`") or the position
/// ("a function type").
export fn allows_outside_entry_error(what: String, pos: Int) -> String {
  String::concat("`allows` grants authority and is written on an entry point only (`fn main`, `fn _start`, `test`, `example`, `bench`); ", String::concat(what, " requires its effects from the caller -- write `with` here and grant the effect at the entry at #\{pos}"))
}

/// The message for a `with` written at the row position of an ENTRY head
/// (`pos` is the `with` token). An entry has no caller to require an effect
/// from, so its row is a grant and the keyword is `allows` (ADR-0088, #2654).
/// The row is read first -- braced or not -- so the message names the whole
/// edit (`fn main allows Console + Fs`) rather than a keyword to change and
/// then a row to rewrite; the split form `with .. allows ..` and a
/// parenthesised non-empty row keep their own diagnostics. `head` names the
/// entry for the reader ("`fn main`", "`test \"n\"`"), `edit` is the head as
/// it must be written ("fn main", "fn main(..) -> ..", "test \"n\"").
export fn entry_with_row_message(tokens: Array[Token], pos: Int, head: String, edit: String) -> String with Exception {
  let (row, _after) = match peek(tokens = tokens, pos = pos + 1) {
    TLBrace => collect_effect_names(tokens = tokens, pos = pos + 2, acc = ""),
    _ => parse_effect_row(tokens = tokens, pos = pos + 1)
  }
  let spelled = if String::length(row) == 0 {
    "()"
  } else {
    row_plus_spelling(row)
  }
  String::concat(head, String::concat(" is an entry point and grants its row, so the keyword is `allows`: write `", String::concat(edit, String::concat(" allows ", String::concat(spelled, "` (a called function requires an effect from its caller with `with`; an entry has no caller) at #\{pos}")))))
}

/// The comma-joined row (`"A, B"`, the stored form) back in its source
/// spelling (`A + B`).
fn row_plus_spelling(_ row: String) -> String {
  let parts = String::split(row, sep = ", ")
  let mut out = ""
  let mut i = 0
  while i < Array::length(parts) {
    out = if i == 0 {
      Array::get(parts, at = i)
    } else {
      String::concat(out, String::concat(" + ", Array::get(parts, at = i)))
    }
    i = i + 1
  }
  out
}

export fn parse_effect_row(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  let (row, after_row) = parse_effect_row_base(tokens = tokens, pos = pos)
  if peek_is_allows(tokens = tokens, pos = after_row) {
    // `with A allows C` was ADR-0088's split form. A row is either a
    // requirement (`with`, on a called function or a function type) or a
    // grant (`allows`, on an entry head), never both -- so the combination
    // is refused by name rather than falling into "expected {".
    throw("`with .. allows ..` is not a spelling: an entry point writes its whole row as `allows A + B`, and a called function or a function type requires with `with A + B` at #\{after_row}")
  } else {
    (row, after_row)
  }
}

// Carry the optional tooling context as an argument: allocating a capturing
// recursive closure for every type also charges atomic, comma-free types.
fn parse_type_list_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr], context: Option[ParserBinderContext]) -> (Array[TypeExpr], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TComma => match peek(tokens = tokens, pos = pos + 1) {
      TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),
      _ => {
        let (ts, ts_opt) = labeled_type_start(tokens = tokens, p = pos + 1)
        let (ty, next) = parse_type_with_source_context(tokens = tokens, pos = ts, mode = 0, context = context)
        ArrayBuilder::push(b, value = optional_param_type(ty = ty, is_optional = ts_opt))
        parse_type_list_rest(tokens = tokens, pos = next, b = b, context = context)
      }
    }
    ,
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

export fn parse_type_with_source_context(tokens: Array[Token], pos: Int, mode: Int, context: Option[ParserBinderContext]) -> (TypeExpr, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => source_record_slot(kind = "type_head", name = name, first = pos, next = pos + 1, context = context),
    _ => ()
  }
  // The optional effect row after a function type's return (#1429: `with
  // A + B`, or `with ()` for the empty row).
  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with Exception = (tokens, rn) -> {
    match peek(tokens = tokens, pos = rn) {
      TWith => {
        let effect_name_pair = parse_effect_row(tokens = tokens, pos = rn + 1)
        (Some(effect_name_pair.0), effect_name_pair.1)
      },
      TIdent(kw) => if kw == "allows" {
        throw(allows_outside_entry_error(what = "a function type", pos = rn))
      } else {
        (None, rn)
      },
      _ => (None, rn)
    }
  }
  let (ty, next) = if mode == 0 {
    // Leading-paren handling parses the group's TOP-LEVEL elements with arity
    // preserved, so a function parameter list is read by element count rather
    // than by reinterpreting a (already-unwrapped) tuple atom. This keeps
    // `(A, B) -> R` (two params) distinct from `((A, B)) -> R` (one tuple
    // param): the latter's outer group has a single element `(A, B)`. (#664-adjacent
    // type-annotation fix: previously both flattened to a two-param list.)
    match peek(tokens = tokens, pos = pos) {
      TLParen => match peek(tokens = tokens, pos = pos + 1) {
        TRParen => {
          // `()` — empty group: a zero-param function `() -> R`, else Unit.
          let after = pos + 2
          match peek(tokens = tokens, pos = after) {
            TThinArrow => {
              let (ret, rn) = parse_type_with_source_context(tokens = tokens, pos = after + 1, mode = 0, context = context)
              let eff = parse_effect_suffix(tokens, rn)
              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)
            },
            _ => (TyUnit, after)
          }
        },
        _ => {
          // A first element may be a labeled param (`x: T` / `x~: T` / `x?: T`);
          // skip the label so the element's TYPE is what gets recorded. `?`
          // additionally wraps it in `Option` (#1500).
          let (ty_start, ty_opt) = labeled_type_start(tokens = tokens, p = pos + 1)
          let (first_raw, n1) = parse_type_with_source_context(tokens = tokens, pos = ty_start, mode = 0, context = context)
          let first = optional_param_type(ty = first_raw, is_optional = ty_opt)
          let (elems, after) = match peek(tokens = tokens, pos = n1) {
            TRParen => ([first], n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, value = first)
              let (rest, end) = parse_type_list_rest(tokens = tokens, pos = n1, b = b, context = context)
              let en = expect_tk(tokens = tokens, pos = end, expected = ")");
              (rest, en)
            },
            _ => throw("expected ')' or ',' in type")
          }
          match peek(tokens = tokens, pos = after) {
            TThinArrow => {
              let (ret, rn) = parse_type_with_source_context(tokens = tokens, pos = after + 1, mode = 0, context = context)
              let eff = parse_effect_suffix(tokens, rn)
              (TyFn(elems, ret, eff.0), eff.1)
            },
            _ => {
              // Not a function: a single element is a parenthesized type (the
              // parens are just grouping); two or more elements are a tuple.
              let atom = if Array::length(elems) == 1 {
                Array::get(elems, at = 0)
              } else {
                TyTuple(elems)
              }
              match peek(tokens = tokens, pos = after) {
                TQuestion => (TyApp("Option", [
                  source_wrap_type(ty = atom, first = pos, next = after, context = context)
                ]), after + 1),
                _ => (atom, after)
              }
            }
          }
        }
      },
      _ => {
        let (atom_ty, atom_next) = parse_type_with_source_context(tokens = tokens, pos = pos, mode = 1, context = context)
        match peek(tokens = tokens, pos = atom_next) {
          TThinArrow => {
            let (ret, rn) = parse_type_with_source_context(tokens = tokens, pos = atom_next + 1, mode = 0, context = context)
            let eff = parse_effect_suffix(tokens, rn)
            (TyFn([atom_ty], ret, eff.0), eff.1)
          },
          _ => (atom_ty, atom_next)
        }
      }
    }
  } else {
    let (base_ty, base_next) = match peek(tokens = tokens, pos = pos) {
      TLParen => match peek(tokens = tokens, pos = pos + 1) {
        TRParen => (TyUnit, pos + 2),
        _ => {
          let (ty_start, ty_opt) = labeled_type_start(tokens = tokens, p = pos + 1)
          let (first_raw, n1) = parse_type_with_source_context(tokens = tokens, pos = ty_start, mode = 0, context = context)
          let first = optional_param_type(ty = first_raw, is_optional = ty_opt)
          match peek(tokens = tokens, pos = n1) {
            TRParen => (first, n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, value = first)
              let (rest, end) = parse_type_list_rest(tokens = tokens, pos = n1, b = b, context = context)
              let en = expect_tk(tokens = tokens, pos = end, expected = ")");
              (TyTuple(rest), en)
            },
            _ => throw("expected ')' or ',' in type")
          }
        }
      },
      TIdent(name) => match peek(tokens = tokens, pos = pos + 1) {
        TLBracket => {
          refuse_retired_type(name)
          let (first, n1) = parse_type_with_source_context(tokens = tokens, pos = pos + 2, mode = 0, context = context)
          match peek(tokens = tokens, pos = n1) {
            TRBracket => (TyApp(name, [first]), n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, value = first)
              let (rest, end) = parse_type_list_rest(tokens = tokens, pos = n1, b = b, context = context)
              let en = expect_tk(tokens = tokens, pos = end, expected = "]");
              (TyApp(name, rest), en)
            },
            _ => throw("expected ']' or ',' in type application")
          }
        },
        _ => {
          refuse_retired_type(name)
          (TyName(name), pos + 1)
        }
      },
      _ => {
        let actual = tk_name(peek(tokens = tokens, pos = pos))
        throw("expected type but got \{actual}")
      }
    }
    match peek(tokens = tokens, pos = base_next) {
      TQuestion => (TyApp("Option", [
        source_wrap_type(ty = base_ty, first = pos, next = base_next, context = context)
      ]), base_next + 1),
      _ => (base_ty, base_next)
    }
  }
  let located = source_wrap_type(ty = ty, first = pos, next = next, context = context)
  let result = match peek(tokens = tokens, pos = next - 1) {
    TQuestion => source_clear_type_head(located),
    _ => located
  }
  (result, next)
}

fn parse_type_impl(tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int) with Exception {
  parse_type_with_source_context(tokens = tokens, pos = pos, mode = mode, context = None)
}

export fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with Exception {
  parse_type_impl(tokens = tokens, pos = pos, mode = 0)
}

/// #1500: where a labeled parameter's TYPE starts inside a function type, and
/// whether the label carried the `?` (optional) marker.
///
/// `x~: T` and `x?: T` both put the type after the label, and every caller used
/// to just skip to it -- which silently dropped the `?`, so a function TYPE
/// could not express optionality at all (`(Int, z?: Int) -> String` parsed as
/// `(Int, Int) -> String`) even though the parameter LIST kept the marker on
/// the name. Optional parameters are declared as `Option[T]`, so the flag has
/// to reach the caller for it to wrap.
///
/// `p` is the position of the label identifier. Returns `(p, false)` for
/// anything that is not `label: T` / `label~: T` / `label?: T` -- that is a
/// bare type, and it starts right where the caller is looking.
fn labeled_type_start(tokens: Array[Token], p: Int) -> (Int, Bool) {
  match peek(tokens = tokens, pos = p) {
    TIdent(_) => match peek(tokens = tokens, pos = p + 1) {
      TColon => (p + 2, false),
      TTilde => match peek(tokens = tokens, pos = p + 2) {
        TColon => (p + 3, false),
        _ => (p, false)
      },
      TQuestion => match peek(tokens = tokens, pos = p + 2) {
        TColon => (p + 3, true),
        _ => (p, false)
      },
      _ => (p, false)
    },
    _ => (p, false)
  }
}

/// Wrap a labeled parameter's declared type when its label carried `?`.
fn optional_param_type(ty: TypeExpr, is_optional: Bool) -> TypeExpr {
  if is_optional {
    TyApp("Option", [ty])
  } else {
    ty
  }
}

export fn parse_one_param_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> ((String, Option[TypeExpr]), Int) with Exception {
  let ((name, ty), next) = match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      match peek(tokens = tokens, pos = pos + 1) {
        TTilde => {
          let labeled_name = "\{name}~"
          binder_capture_source(context = context, name = labeled_name, first_token = pos, last_token = pos + 1)
          match peek(tokens = tokens, pos = pos + 2) {
            TColon => {
              let (ty, tp) = parse_type_with_source_context(tokens = tokens, pos = pos + 3, mode = 0, context = context);
              match peek(tokens = tokens, pos = tp) {
                // #3120 (Codex on #3438): a default is not supported on a
                // labeled parameter yet.
                TEq => throw("parameter '\{name}~' is labeled, and a labeled parameter cannot carry a default yet; drop the `~`, or declare it `\{name}?: T` and match on the `Option`"),
                _ => ((labeled_name, Some(ty)), tp)
              }
            },
            _ => ((labeled_name, None), pos + 2)
          }
        },
        TQuestion => {
          let opt_name = "\{name}?"
          binder_capture_source(context = context, name = opt_name, first_token = pos, last_token = pos + 1)
          match peek(tokens = tokens, pos = pos + 2) {
            TColon => {
              let (ty, tp) = parse_type_with_source_context(tokens = tokens, pos = pos + 3, mode = 0, context = context);
              // #1500: an optional parameter is declared `Option[T]`. The body
              // sees an `Option` (that is what the omitted case has to produce),
              // and `desugar_optional_args` makes the call site agree -- omitted
              // slots become `None`, supplied ones `Some(v)`. The `?` used to be
              // recorded only on the NAME, so the declared type stayed `T` and
              // the parameter was optional in spelling alone.
              match peek(tokens = tokens, pos = tp) {
                // #3120: `x?: T` already means "omitted is `None`"; a default
                // is spelled without the `?`.
                TEq => throw("parameter '\{name}?' is optional and also has a default; write `\{name}: T = value` (without `?`) to get the default"),
                _ => ((opt_name, Some(optional_param_type(ty = ty, is_optional = true))), tp)
              }
            },
            _ => ((opt_name, None), pos + 2)
          }
        },
        TColon => {
          binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
          let (ty, tp) = parse_type_with_source_context(tokens = tokens, pos = pos + 2, mode = 0, context = context);
          let tp2 = match peek(tokens = tokens, pos = tp) {
            TColon => {
              let mut bp = tp + 1
              let mut bd = true
              while bd {
                match peek(tokens = tokens, pos = bp) {
                  TIdent(_) => {
                    bp = bp + 1; match peek(tokens = tokens, pos = bp) {
                      TPlus => {
                        bp = bp + 1
                      },
                      _ => {
                        bd = false
                      }
                    }
                  },
                  _ => {
                    bd = false
                  }
                }
              }
              bp
            },
            _ => tp
          }
          match peek(tokens = tokens, pos = tp2) {
            // #3120: `name: T = default`. The parameter becomes the optional
            // `name?: Option[T]` (#1500), so call sites, the checker and
            // codegen see exactly what `name?: T` gives them; the `fn`
            // declaration parser reads the default expression at `tp2` and
            // unwraps the parameter at the top of the body. The binder row
            // captured above names `name`, not `name?`, and the body gains
            // synthetic binders, so this declaration takes the
            // capture-ineligible path rather than hand misaligned rows to the
            // binder authority.
            TEq => {
              binder_capture_mark_ineligible(context)
              (("\{name}?", Some(optional_param_type(ty = ty, is_optional = true))), tp2)
            },
            _ => ((name, Some(ty)), tp2)
          }
        },
        _ => {
          binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
          ((name, None), pos + 1)
        }
      }
    },
    token => throw(binder_name_error(actual = tk_name(token), kind = "parameter", pos = pos))
  }
  let name_end = match peek(tokens = tokens, pos = pos + 1) {
    TTilde|TQuestion => pos + 2,
    _ => pos + 1
  }
  source_record_slot(kind = "param", name = name, first = pos, next = name_end, context = context)
  ((name, ty), next)
}

fn parse_param_cont_with_binder_context(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])], context: Option[ParserBinderContext], armed: Bool, count: Int) -> (Array[(String, Option[TypeExpr])], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TComma => match peek(tokens = tokens, pos = pos + 1) {
      TRParen => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let at = lambda_param_marker(tokens = tokens, pos = pos + 1, index = count, armed = armed)
        let (p, pn) = parse_one_param_with_binder_context(tokens = tokens, pos = at, context = context)
        ArrayBuilder::push(b, value = p)
        parse_param_cont_with_binder_context(tokens = tokens, pos = pn, b = b, context = context, armed = armed, count = count + 1)
      }
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    // #3120: only a `fn` declaration reads a default; a lambda's parameter
    // list ends here.
    TEq => throw("a parameter default (`x: T = value`) is allowed only on a `fn` declaration; for a lambda, declare `x?: T` and match on the `Option`"),
    _ => {
      let actual = tk_name(peek(tokens = tokens, pos = pos))
      throw("expected ',' or ')' in param list at #\{pos} token=\{actual}")
    }
  }
}

export fn parse_param_list_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[(String, Option[TypeExpr])], Int) with Exception {
  let armed = take_lambda_positional_armed()
  match peek(tokens = tokens, pos = pos) {
    TRParen => (empty_params(), pos + 1),
    _ => {
      let at = lambda_param_marker(tokens = tokens, pos = pos, index = 0, armed = armed)
      let (f, fn1) = parse_one_param_with_binder_context(tokens = tokens, pos = at, context = context)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, value = f)
      parse_param_cont_with_binder_context(tokens = tokens, pos = fn1, b = b, context = context, armed = armed, count = 1)
    }
  }
}

fn parse_param_list(tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int) with Exception {
  parse_param_list_with_binder_context(tokens = tokens, pos = pos, context = None)
}
export fn parse_struct_field_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> ((String, TypeExpr), Bool, Int) with Exception {
  let (is_mut, p) = match peek(tokens = tokens, pos = pos) {
    TMut => (true, pos + 1),
    _ => (false, pos)
  }
  match peek(tokens = tokens, pos = p) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = p, last_token = p)
      let cn = expect_tk(tokens = tokens, pos = p + 1, expected = ":")
      let (ty, next) = parse_type_impl(tokens = tokens, pos = cn, mode = 0);
      ((name, ty), is_mut, next)
    },
    _ => throw("expected field name")
  }
}

fn parse_struct_field(tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Bool, Int) with Exception {
  parse_struct_field_with_binder_context(tokens = tokens, pos = pos, context = None)
}
fn is_lambda_start_impl(tokens: Array[Token], pos: Int, depth: Int, bdepth: Int, has_colon: Bool) -> Bool {
  match peek(tokens = tokens, pos = pos) {
    // A colon only signals an annotated lambda param when it sits directly
    // inside the candidate parens — a colon inside BRACKETS is a slice bound
    // (`raw_path[0: 2]`), and counting it made `(len >= 2 && s[0: 2] == x) {`
    // (a parenthesized if-condition followed by the if body's brace) parse as
    // a no-arrow lambda, failing with "expected ',' or ')' in param list".
    TColon => if depth == 0 && bdepth == 0 {
      is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth, bdepth = bdepth, has_colon = true)
    } else is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth, bdepth = bdepth, has_colon = has_colon),
    TRParen => if depth == 0 {
      match peek(tokens = tokens, pos = pos + 1) {
        TThinArrow => true,
        TLBrace => has_colon,
        _ => false
      }
    } else is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth - 1, bdepth = bdepth, has_colon = has_colon),
    TLParen => is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth + 1, bdepth = bdepth, has_colon = has_colon),
    TLBracket => is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth, bdepth = bdepth + 1, has_colon = has_colon),
    TRBracket => is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth, bdepth = bdepth - 1, has_colon = has_colon),
    TEof => false,
    _ => is_lambda_start_impl(tokens = tokens, pos = pos + 1, depth = depth, bdepth = bdepth, has_colon = has_colon)
  }
}

fn is_lambda_start(tokens: Array[Token], pos: Int) -> Bool {
  is_lambda_start_impl(tokens = tokens, pos = pos, depth = 0, bdepth = 0, has_colon = false)
}

/// `(n) { ... }` with no colon and no `->` is the no-arrow lambda shape, but
/// `is_lambda_start` only accepts that brace when a colon is present so
/// `(cond) {` after `if`/`while`/`match` stays a parenthesized condition.
/// When the parens are an untyped ident list and `{` follows, the reader
/// meant a lambda whose parameter needs a type (#2127). `None` when the
/// previous token owns the brace: a control keyword, or a prefix/infix
/// operator (`if !(n) {`, `if true && (n) {`). `=` is not skipped -- that
/// is `let f = (n) {`.
fn untyped_brace_lambda_param(tokens: Array[Token], paren_pos: Int) -> Option[(String, Int)] {
  let brace_owned_by_enclosing = if paren_pos <= 0 {
    false
  } else {
    match peek(tokens = tokens, pos = paren_pos - 1) {
      TIf => true,
      TWhile => true,
      TMatch => true,
      THandle => true,
      TIn => true,
      TNot => true,
      // #2344: `~` is a prefix operator like `!`, so in `if ~(n) { ... }` the
      // parens are its operand and the brace belongs to the `if`, not to a
      // lambda. Without this row the reader got `lambda parameter `n` needs a
      // type` for a program that has no lambda in it.
      TTilde => true,
      tok => is_non_pipe_infix(tok)
    }
  }
  if brace_owned_by_enclosing {
    None
  } else {
    untyped_brace_lambda_param_scan(tokens = tokens, pos = paren_pos + 1)
  }
}

fn untyped_brace_lambda_param_scan(tokens: Array[Token], pos: Int) -> Option[(String, Int)] {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => untyped_brace_lambda_param_rest(tokens = tokens, pos = pos + 1, first = name),
    _ => None
  }
}

fn untyped_brace_lambda_param_rest(tokens: Array[Token], pos: Int, first: String) -> Option[(String, Int)] {
  match peek(tokens = tokens, pos = pos) {
    TTilde => untyped_brace_lambda_param_rest(tokens = tokens, pos = pos + 1, first = first),
    TQuestion => untyped_brace_lambda_param_rest(tokens = tokens, pos = pos + 1, first = first),
    TComma => match peek(tokens = tokens, pos = pos + 1) {
      TIdent(_) => untyped_brace_lambda_param_rest(tokens = tokens, pos = pos + 2, first = first),
      _ => None
    },
    TRParen => match peek(tokens = tokens, pos = pos + 1) {
      TLBrace => Some((first, pos + 1)),
      _ => None
    },
    _ => None
  }
}

fn parse_ctor_types_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TComma => {
      let (ty, next) = parse_type_impl(tokens = tokens, pos = pos + 1, mode = 0)
      ArrayBuilder::push(b, value = ty)
      parse_ctor_types_rest(tokens = tokens, pos = next, b = b)
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in constructor types")
  }
}

fn parse_enum_ctor_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> ((String, Array[TypeExpr]), Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      match peek(tokens = tokens, pos = pos + 1) {
        TLParen => match peek(tokens = tokens, pos = pos + 2) {
          TRParen => ((name, empty_type_exprs()), pos + 3),
          _ => {
            let (first, n1) = parse_type_impl(tokens = tokens, pos = pos + 2, mode = 0)
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, value = first)
            let (types, end) = parse_ctor_types_rest(tokens = tokens, pos = n1, b = b);
            ((name, types), end)
          }
        },
        _ => ((name, empty_type_exprs()), pos + 1)
      }
    },
    _ => throw("expected constructor name")
  }
}

fn parse_enum_ctors_rest_with_binder_context(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])], context: Option[ParserBinderContext]) -> (Array[(String, Array[TypeExpr])], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TSemicolon => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        ArrayBuilder::push(b, value = ctor)
        parse_enum_ctors_rest_with_binder_context(tokens = tokens, pos = next, b = b, context = context)
      }
    },
    // Redundant-syntax removal: ',' is not a declaration-body
    // separator (canonical form is ';'; printer/docs/compiler tree all use it).
    // The " at #pos" suffix anchors the located wrapper (#816) at the comma.
    TComma => throw("use ';' to separate declaration members; ',' is not a separator at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';' or '}' in enum at #\{pos}")
  }
}

fn parse_enum_ctors_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[(String, Array[TypeExpr])], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TRBrace => (empty_ctors(), pos + 1),
    _ => {
      let (first, next) = parse_enum_ctor_with_binder_context(tokens = tokens, pos = pos, context = context)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, value = first)
      parse_enum_ctors_rest_with_binder_context(tokens = tokens, pos = next, b = b, context = context)
    }
  }
}

export fn parse_enum_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      let (params, after_name) = parse_tparam_names_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
      let br = expect_tk(tokens = tokens, pos = after_name, expected = "{")
      let (ctors, end) = parse_enum_ctors_with_binder_context(tokens = tokens, pos = br, context = context);
      let (derives, final_pos) = parse_derive_names(tokens = tokens, pos = end)
      (SEnum(exported, name, params, ctors, derives), final_pos)
    },
    _ => throw("expected enum name")
  }
}

fn parse_enum_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_enum_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
export fn parse_suberror_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      match peek(tokens = tokens, pos = pos + 1) {
        TLParen => match peek(tokens = tokens, pos = pos + 2) {
          TRParen => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, value = (name, empty_type_exprs()))
            (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)
          },
          _ => {
            let (first, n1) = parse_type_impl(tokens = tokens, pos = pos + 2, mode = 0)
            let args_b = ArrayBuilder::new()
            ArrayBuilder::push(args_b, value = first)
            let (args, end) = parse_ctor_types_rest(tokens = tokens, pos = n1, b = args_b)
            let ctors_b = ArrayBuilder::new()
            ArrayBuilder::push(ctors_b, value = (name, args))
            (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)
          }
        },
        TLBrace => {
          let (ctors, end) = parse_enum_ctors_with_binder_context(tokens = tokens, pos = pos + 2, context = context);
          (SSuberror(exported, name, ctors), end)
        },
        _ => throw("expected '(' or '{' after suberror name")
      }
    },
    _ => throw("expected suberror name")
  }
}

fn parse_suberror_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_suberror_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
fn parse_impl_stmt_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  let (type_params, type_bounds, after_tp) = match peek(tokens = tokens, pos = pos) {
    TLBracket => parse_bounded_type_params_with_binder_context(tokens = tokens, pos = pos + 1, allow_bounds = true, separator_error = "expected ',' or ']' in impl type params", context = context),
    _ => (_no_tp(), _no_tb(), pos)
  }
  match peek(tokens = tokens, pos = after_tp) {
    TIdent(_) => {
      let (trait_reference, after_trait) = parse_type_impl(tokens = tokens, pos = after_tp, mode = 0)
      let trait_name = match trait_reference {
        TyName(_) => trait_ref_key(trait_reference),
        TyApp(_, _) => trait_ref_key(trait_reference),
        _ => throw("an impl trait must be a named trait, such as `Eq` or `Iter[Int]`")
      }
      let fp = expect_tk(tokens = tokens, pos = after_trait, expected = "for")
      let (target, after_target) = parse_type_impl(tokens = tokens, pos = fp, mode = 0)
      match target {
        TyName(_) => (SImpl(type_params, type_bounds, trait_name, target), after_target),
        TyApp(_, _) => (SImpl(type_params, type_bounds, trait_name, target), after_target),
        _ => throw("an impl target must be a named type, such as `Int` or `Array[T]`")
      }
    },
    _ => throw("expected trait name after 'impl'")
  }
}

/// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }
export fn parse_effect_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      let (type_params, after_params) = match peek(tokens = tokens, pos = pos + 1) {
        TLBracket => {
          let (names, _, next) = parse_bounded_type_params_with_binder_context(tokens = tokens, pos = pos + 2, allow_bounds = false, separator_error = "expected ',' or ']' in type params", context = context)
          (names, next)
        },
        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)
      }
      let br = expect_tk(tokens = tokens, pos = after_params, expected = "{")
      let ops_b = ArrayBuilder::new()
      let mut p = br
      while true {
        match peek(tokens = tokens, pos = p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(op_name) => {
            binder_capture_source(context = context, name = op_name, first_token = p, last_token = p)
            let (params, after_op_params) = match peek(tokens = tokens, pos = p + 1) {
              TLParen => {
                let (params_ty, after_paren) = parse_type_impl(tokens = tokens, pos = p + 1, mode = 1)
                let params = match params_ty {
                  TyUnit => empty_type_exprs(),
                  TyTuple(elems) => elems,
                  _ => [params_ty]
                }
                (params, after_paren)
              },
              _ => (empty_type_exprs(), p + 1)
            }
            let arrow_pos = expect_tk(tokens = tokens, pos = after_op_params, expected = "->")
            let (ret_type, after_ret) = parse_type_impl(tokens = tokens, pos = arrow_pos, mode = 0)
            // #2264: `Op(n: Int) -> Int with Fs` — parse_type_impl does not
            // consume `with` after a non-function return type, so the next
            // loop iteration used to throw "expected effect operation name
            // or '}'" with no token index (file-only 1:1). An operation
            // cannot carry a row; handlers and effectful payload types can.
            match peek(tokens = tokens, pos = after_ret) {
              TWith => throw("an effect operation cannot declare its own effect row -- effects are carried by the handler that interprets it (put the row on the handling function), or take an effectful function as the operation's parameter at #\{after_ret}"),
              _ => ()
            }
            ArrayBuilder::push(ops_b, value = (op_name, params, ret_type))
            p = match peek(tokens = tokens, pos = after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected effect operation name or '}' at #\{p}")
        }
      }
      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)
    },
    _ => throw("expected effect name")
  }
}

fn parse_effect_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_effect_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
export fn parse_type_alias_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      let (params, after_name) = match peek(tokens = tokens, pos = pos + 1) {
        TLBracket => {
          let (names, _, next) = parse_bounded_type_params_with_binder_context(tokens = tokens, pos = pos + 2, allow_bounds = false, separator_error = "expected ',' or ']' in type params", context = context)
          (names, next)
        },
        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)
      }
      let ep = expect_tk(tokens = tokens, pos = after_name, expected = "=")
      let (ty, next) = parse_type_impl(tokens = tokens, pos = ep, mode = 0);
      (STypeAlias(exported, name, params, ty), next)
    },
    _ => throw("expected type alias name")
  }
}

fn parse_type_alias_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_type_alias_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
export fn parse_impl_stmt_dispatch_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  parse_impl_stmt_with_binder_context(tokens = tokens, pos = pos, context = context)
}

fn parse_impl_stmt_dispatch(tokens: Array[Token], pos: Int) -> (Stmt, Int) with Exception {
  parse_impl_stmt_dispatch_with_binder_context(tokens = tokens, pos = pos, context = None)
}
fn push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {
  if is_mut {
    let (fname, _) = field
    ArrayBuilder::push(mb, value = fname)
  } else {
    ()
  }
}

fn parse_struct_fields_rest_with_binder_context(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String], context: Option[ParserBinderContext]) -> (Array[(String, TypeExpr)], Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TSemicolon => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        ArrayBuilder::push(b, value = field)
        push_mut_name(mb = mb, field = field, is_mut = is_mut)
        parse_struct_fields_rest_with_binder_context(tokens = tokens, pos = next, b = b, mb = mb, context = context)
      }
    },
    // Redundant-syntax removal: ',' is not a declaration-body
    // separator (see parse_enum_ctors_rest).
    TComma => throw("use ';' to separate declaration members; ',' is not a separator at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),
    _ => throw("expected ';' or '}' in struct at #\{pos}")
  }
}

fn parse_struct_fields_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[(String, TypeExpr)], Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TRBrace => (empty_fields(), ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1),
    _ => {
      let (first, is_mut, next) = parse_struct_field_with_binder_context(tokens = tokens, pos = pos, context = context)
      let b = ArrayBuilder::new()
      let mb = ArrayBuilder::new()
      ArrayBuilder::push(b, value = first)
      push_mut_name(mb = mb, field = first, is_mut = is_mut)
      parse_struct_fields_rest_with_binder_context(tokens = tokens, pos = next, b = b, mb = mb, context = context)
    }
  }
}

export fn parse_struct_stmt_with_binder_context(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      // #829: keep the `[T]` type-parameter names (previously skipped and
      // discarded) so the checker can instantiate generic struct literals.
      let (tparams, after_name) = parse_tparam_names_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
      let br = expect_tk(tokens = tokens, pos = after_name, expected = "{")
      let (fields, mut_names, end) = parse_struct_fields_with_binder_context(tokens = tokens, pos = br, context = context);
      let (derives, final_pos) = parse_derive_names(tokens = tokens, pos = end)
      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)
    },
    _ => throw("expected struct name")
  }
}

fn parse_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with Exception {
  parse_struct_stmt_with_binder_context(tokens = tokens, pos = pos, exported = exported, context = None)
}
