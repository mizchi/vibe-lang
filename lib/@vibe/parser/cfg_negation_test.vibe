import ./lexer.vibe {
  lex, lex_with_offsets
}
import ./parser.vibe {
  parse_program,
  parse_program_located_with_cfg,
  parse_program_preserving,
  parse_program_preserving_located_with_cfg,
  parse_program_preserving_with_cfg,
  parse_program_recovering,
  parse_program_spans,
  parse_program_with_cfg,
  set_cfg_ambient_flags
}
import @vibe/ast {
  Stmt
}

let alternatives = "#cfg(telemetry)\nlet enabled = 1\n#cfg(not(telemetry))\nlet disabled = 2\nlet tail = 3\n"

fn assert_selected(stmts: Array[Stmt], name: String) -> Unit {
  assert_eq(Array::length(stmts), 2)
  match Array::get(stmts, at = 0) {
    SLet(_, _, got, _, _) => assert_eq(got, name),
    _ => assert(false)
  }
  match Array::get(stmts, at = 1) {
    SLet(_, _, got, _, _) => assert_eq(got, "tail"),
    _ => assert(false)
  }
}

test "positive and negative guards select complementary declarations in every parser" {
  let (tokens, starts, ends) = lex_with_offsets(alternatives)
  let mut enabled = false
  let mut round = 0
  while round < 4 {
    let flags = if enabled {
      ["telemetry"]
    } else {
      []
    }
    let name = if enabled {
      "enabled"
    } else {
      "disabled"
    }
    set_cfg_ambient_flags(flags)
    assert_selected(stmts = parse_program(tokens), name = name)
    assert_selected(stmts = parse_program_preserving(tokens), name = name)
    assert_selected(stmts = parse_program_with_cfg(tokens, cfg_flags = flags), name = name)
    assert_selected(stmts = parse_program_preserving_with_cfg(tokens, cfg_flags = flags), name = name)
    assert_selected(stmts = parse_program_located_with_cfg(tokens = tokens, starts = starts, source = alternatives, cfg_flags = flags), name = name)
    assert_selected(stmts = parse_program_preserving_located_with_cfg(tokens = tokens, starts = starts, source = alternatives, cfg_flags = flags), name = name)
    let (recovered, errors) = parse_program_recovering(tokens = tokens, starts = starts, source = alternatives)
    assert_eq(Array::length(errors), 0)
    assert_selected(stmts = recovered, name = name)
    let (spanned, from, to) = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
    assert_selected(stmts = spanned, name = name)
    assert_eq(Array::length(from), 2)
    assert_eq(Array::length(to), 2)
    let selected = String::substring(alternatives, start = Array::get(from, at = 0), end = Array::get(to, at = 0))
    assert_eq(selected, if enabled {
      "let enabled = 1"
    } else {
      "let disabled = 2"
    })
    enabled = !enabled
    round = round + 1
  }
  set_cfg_ambient_flags([])
}

test "file-local enables participate in negation regardless of directive position" {
  let src = String::concat(alternatives, "#cfg_enable(telemetry)\n")
  assert_selected(stmts = parse_program_with_cfg(lex(src), cfg_flags = []), name = "enabled")
}

test "explicit flags ignore ambient flags for both polarities" {
  set_cfg_ambient_flags(["telemetry"])
  let flags: Array[String] = []
  handle {
    let (tokens, starts, _) = lex_with_offsets(alternatives)
    assert_selected(stmts = parse_program_with_cfg(tokens, cfg_flags = flags), name = "disabled")
    assert_selected(stmts = parse_program_located_with_cfg(tokens = tokens, starts = starts, source = alternatives, cfg_flags = flags), name = "disabled")
    assert_selected(stmts = parse_program_preserving_located_with_cfg(tokens = tokens, starts = starts, source = alternatives, cfg_flags = flags), name = "disabled")
    assert_selected(stmts = parse_program(tokens), name = "enabled")
    assert_eq(Array::length(flags), 0)
    set_cfg_ambient_flags([])
  } with { Exception::Throw(msg) => {
    set_cfg_ambient_flags([])
    throw(msg)
  } }
}

test "not remains a legal positive flag name" {
  let tokens = lex("#cfg(not)\nlet a = 1\n#cfg(not(not))\nlet b = 2\n")
  let off = parse_program_with_cfg(tokens, cfg_flags = [])
  let on = parse_program_with_cfg(tokens, cfg_flags = ["not"])
  assert_eq(Array::length(off), 1)
  assert_eq(Array::length(on), 1)
  match Array::get(off, at = 0) {
    SLet(_, _, name, _, _) => assert_eq(name, "b"),
    _ => assert(false)
  }
  match Array::get(on, at = 0) {
    SLet(_, _, name, _, _) => assert_eq(name, "a"),
    _ => assert(false)
  }
}

test "malformed negations and cfg_enable expressions are rejected at the directive" {
  let directives = [
    "#cfg(not())",
    "#cfg(not(telemetry)",
    "#cfg(not(telemetry, other))",
    "#cfg(not(not(telemetry)))",
    "#cfg_enable(not(telemetry))",
    "#cfg()"
  ]
  let mut i = 0
  while i < Array::length(directives) {
    let src = String::concat("let before = 1\n", String::concat(Array::get(directives, at = i), "\nlet after = 2\n"))
    let (tokens, starts, _) = lex_with_offsets(src)
    let msg = handle {
      let _ = parse_program_located_with_cfg(tokens = tokens, starts = starts, source = src, cfg_flags = [
      ])
      "accepted"
    } with { Exception::Throw(msg) => msg }
    assert(String::contains(msg, needle = "line 2:1:"))
    assert(String::contains(msg, needle = "expected"))
    let (_, errors) = parse_program_recovering(tokens = tokens, starts = starts, source = src)
    assert(Array::length(errors) > 0)
    i = i + 1
  }
}

test "an inactive negative guard still checks syntax" {
  let src = "#cfg(not(telemetry))\nlet =\n"
  let failed = handle {
    let _ = parse_program_with_cfg(lex(src), cfg_flags = ["telemetry"])
    false
  } with { Exception::Throw(_) => true }
  assert(failed)
  let (tokens, starts, _) = lex_with_offsets(src)
  set_cfg_ambient_flags(["telemetry"])
  handle {
    let (_, errors) = parse_program_recovering(tokens = tokens, starts = starts, source = src)
    assert_eq(Array::length(errors), 1)
    assert(String::contains(Array::get(errors, at = 0), needle = "line 2:"))
    set_cfg_ambient_flags([])
  } with { Exception::Throw(msg) => {
    set_cfg_ambient_flags([])
    throw(msg)
  } }
}
