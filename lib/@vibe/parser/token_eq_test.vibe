    TTrait,
    TImpl,
    TExport,
    TTest,
    TExample,
    TWhile,
    TFor,
    TIn,
    TLoop,
    TBreak,
    TContinue,
    TReturn,
    TWith,
    THandle,
    TTaskGroup,
    TRegion,
    TThrow,
    TRaise,
    TYield,
    TBench,
    TDeclare,
    TAs,
    TModule,
    TSuberror,
    TDerive,
    TOpen,
    TImport,
    TPlus,
    TMinus,
    TStar,
    TSlash,
    TPercent,
    TEqEq,
    TNeq,
    TLt,
    TLte,
    TGt,
    TGte,
    TAnd,
    TOr,
    TNot,
    TBitAnd,
    TBitOr,
    TBitXor,
    TLShift,
    TRShift,
    TPipeGt,
    TArrow,
