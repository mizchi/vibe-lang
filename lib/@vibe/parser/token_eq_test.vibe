    TExample,
    TWhile,
    TFor,
    TIn,
    TLoop,
    TBreak,
    TContinue,
    TReturn,
    TWith,
    THandle,
    TTaskGroup,
    TRegion,
    TThrow,
    TRaise,
    TYield,
    TBench,
    TDeclare,
    TAs,
    TModule,
    TSuberror,
    TDerive,
    TOpen,
    TImport,
    TPlus,
    TMinus,
    TStar,
    TSlash,
    TPercent,
    TEqEq,
    TNeq,
    TLt,
    TLte,
    TGt,
    TGte,
    TAnd,
    TOr,
    TNot,
    TBitAnd,
    TBitOr,
    TBitXor,
    TLShift,
    TRShift,
    TPipeGt,
    TArrow,
    TThinArrow,
    TEq,
    TDot,
    TColon,
    TDoubleColon,
    TComma,
    TSemicolon,
    THash,
    TTilde,
    TQuestion,
    TPlusEq,
    TMinusEq,
    TStarEq,
    TSlashEq,
    TPercentEq,
    TLParen,
    TRParen,
    TLBrace,
    TRBrace,
    TLBracket,
    TRBracket,
    TDotDot,
    TDotDotDot,
    TStringInterp(["p"], [3]),
    TEof
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_token`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_token_alt() -> Array[Token] {
  [
    TInt(8),
    TFloat(2.5),
    TString("t"),
    TIdent("t"),
    TLet,
    TRec,
    TMut,
    TFn,
    TIf,
    TElse,
    TMatch,
    TIs,
