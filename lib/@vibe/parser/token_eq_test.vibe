    TPlus,
    TMinus,
    TStar,
    TSlash,
    TPercent,
    TEqEq,
    TNeq,
    TLt,
    TLte,
    TGt,
    TGte,
    TAnd,
    TOr,
    TNot,
    TBitAnd,
    TBitOr,
    TBitXor,
    TLShift,
    TRShift,
    TPipeGt,
