}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_token()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
/// separates "compares fields" from "compares identity".
fn every_token_same() -> Array[Token] {
  [
    TInt(7),
    TFloat(1.5),
    TString("s"),
    TIdent("s"),
    TLet,
    TRec,
    TMut,
    TFn,
    TIf,
    TElse,
    TMatch,
    TIs,
    TGuard,
    TDo,
    TEnum,
    TStruct,
    TType,
    TTrait,
    TImpl,
