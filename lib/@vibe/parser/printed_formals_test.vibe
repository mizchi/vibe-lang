// The recursive callback runs inside the outer parse, after its first reserved
// formal and before its second. Both parses use the same Wasm instance.
import ./lexer.vibe { lex, lex_with_offsets }
import ./parser.vibe { parse_printed_module_source, parse_program, parse_program_spans }
import ./parser_base.vibe { struct PrintedModuleSyntax }
import ./parser_binder_context.vibe { ParserBinderContext }
import ./parser_expr.vibe { parse_impl_in_source }
import ./parser_expr_primary.vibe { parse_primary_in_source }
import ./printer.vibe { print_expr }
import ./token.vibe { Token }

test "nested authored and printed parses keep independent formal syntax" {
  let outer = "[__Vfp_A](x: Int) -> Int { struct Local[__Vfp_Local] { value: Int } let f = [__Vfp_B](y: Int) -> Int { y }; f(x) }"
  let nested = "fn inner[__Vfp_C](x: Int) -> Int { x }"
  let (tokens, starts, _) = lex_with_offsets(outer)
  let syntax = Some(PrintedModuleSyntax::{})
  let calls = [0]
  let body = (ts: Array[Token], pos: Int, mode: Int, context: Option[ParserBinderContext]) -> {
    Array::set(calls, at = 0, value = Array::get(calls, at = 0) + 1)
    let rejection = handle {
      let _ = parse_program(lex(nested))
      ""
    } with { Exception::Throw(msg) => msg }
    assert(String::contains(rejection, needle = "uses the reserved `__Vfp_` prefix"))
    let (spanned, _, _, full) = parse_printed_module_source(nested)
    assert_eq(Array::length(spanned), 1)
    assert_eq(Array::length(full), 1)
    let bad = handle {
      let _ = parse_printed_module_source(nested + "\nlet unfinished = (")
      ""
    } with { Exception::Throw(msg) => msg }
    assert(String::length(bad) > 0)
    parse_impl_in_source(tokens = ts, starts = starts, pos = pos, mode = mode, context = context, printed_formals = syntax)
  }
  let (expr, end) = parse_primary_in_source(tokens = tokens, starts = starts, pos = 0, parse_recur = body, context = None, printed_formals = syntax)
  assert_eq(Array::get(calls, at = 0), 1)
  assert_eq(end, Array::length(tokens) - 1)
  assert(String::contains(print_expr(expr), needle = "__Vfp_B"))
}

test "printed syntax reaches declaration, expression and interpolation binders" {
  let sources = [
    "struct Box[__Vfp_A] { value: __Vfp_A }",
    "enum Choice[__Vfp_A] { Pick(__Vfp_A) }",
    "type Alias[__Vfp_A] = Array[__Vfp_A]",
    "trait Read[__Vfp_A] { get(Self) -> __Vfp_A }",
    "effect Cell[__Vfp_A] { Put(__Vfp_A) -> Int }",
    "let id: [__Vfp_A](__Vfp_A) -> __Vfp_A = (x) -> { x }",
    "fn nested() -> Int { let id = [__Vfp_A](x: Int) -> Int { x }; id(1) }",
    "let shown = \"\\{([__Vfp_A](x: Int) -> Int { x })(2)}\""
  ]
  for source in sources {
    let (stmts, _, _, full) = parse_printed_module_source(source)
    assert(Array::length(stmts) > 0 && Array::length(full) > 0)
    let (tokens, starts, ends) = lex_with_offsets(source)
    let msg = handle {
      let _ = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
      ""
    } with { Exception::Throw(m) => m }
    assert(String::contains(msg, needle = "uses the reserved `__Vfp_` prefix"))
  }
  let builtin_error = handle {
    let _ = parse_printed_module_source("fn bad[Float64](x: Int) -> Int { x }")
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(builtin_error, needle = "builtin float type"))
}
