//# Functions

/// #947: rewrite every LOCATED offset in an interpolation fragment's parsed
/// Expr tree (EIdent, ECall, ELet/ELetMut, EDot, ...) through `f`, so hover /
/// go-to-def / rename on an identifier referenced inside `\{...}` resolves to
/// its real file position (see `remap_frag_off` below for the mapping used).
/// Every Expr variant is enumerated so a new variant is a compile error here,
/// keeping this walker in sync with the AST. Non-located constructs
/// (string/int/bool literals, bare structural nodes) pass through unchanged;
/// -1 (synthetic/non-located) offsets stay -1 and never reach `f`.
fn map_located_off(off: Int, f: (Int) -> Int) -> Int {
  if off < 0 {
    off
  } else {
    f(off)
  }
}

fn map_expr_offsets(expr: Expr, f: (Int) -> Int, context: Option[ParserBinderContext]) -> Expr {
  {
    match expr {
      EInt(_) => expr,
      EFloat(_) => expr,
      EString(_) => expr,
      EBool(_) => expr,
      EUnit => expr,
      EIdent(name, off) => EIdent(name, map_located_off(off, f)),
      ETuple(items) => ETuple(map_exprs(items, f, context)),
      EArray(items) => EArray(map_exprs(items, f, context)),
      ERecord(rn, fields, targs) => ERecord(rn, map_named_exprs(fields, f, context), targs),
      EIf(c, t, e) => EIf(map_expr_offsets(c, f, context), map_expr_offsets(t, f, context), map_expr_offsets(e, f, context)),
      ELet(n, v, b, soff) => ELet(n, map_expr_offsets(v, f, context), map_expr_offsets(b, f, context), map_located_off(soff, f)),
      ELetRec(n, v, b) => ELetRec(n, map_expr_offsets(v, f, context), map_expr_offsets(b, f, context)),
      ELetMut(n, v, b, soff) => ELetMut(n, map_expr_offsets(v, f, context), map_expr_offsets(b, f, context), map_located_off(soff, f)),
      EAssign(n, v, b) => EAssign(n, map_expr_offsets(v, f, context), map_expr_offsets(b, f, context)),
      EAssignOp(n, op, v, b) => EAssignOp(n, op, map_expr_offsets(v, f, context), map_expr_offsets(b, f, context)),
      ESeq(a, b) => ESeq(map_expr_offsets(a, f, context), map_expr_offsets(b, f, context)),
      EMatch(s, arms) => EMatch(map_expr_offsets(s, f, context), map_arm_exprs(arms, f, context)),
      EHandle(s, arms) => EHandle(map_expr_offsets(s, f, context), map_arm_exprs(arms, f, context)),
      EWhile(c, b) => EWhile(map_expr_offsets(c, f, context), map_expr_offsets(b, f, context)),
      ELoop(params, b) => ELoop(map_named_exprs(params, f, context), map_expr_offsets(b, f, context)),
      EForIn(n, idx, it, b) => EForIn(n, idx, map_expr_offsets(it, f, context), map_expr_offsets(b, f, context)),
      ECall(callee, args, off) => ECall(map_expr_offsets(callee, f, context), map_exprs(args, f, context), map_located_off(off, f)),
      EBinOp(op, l, r) => EBinOp(op, map_expr_offsets(l, f, context), map_expr_offsets(r, f, context)),
      EUnaryOp(op, e) => EUnaryOp(op, map_expr_offsets(e, f, context)),
      EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, map_expr_offsets(body, f, context)),
      EDot(e, field, off, fdoff) => EDot(map_expr_offsets(e, f, context), field, map_located_off(off, f), map_located_off(fdoff, f)),
      ELabeledArg(l, n, v) => ELabeledArg(l, n, map_expr_offsets(v, f, context)),
      EReturn(e) => EReturn(map_expr_offsets(e, f, context)),
      EBreak(opt) => match opt {
        Some(v) => EBreak(Some(map_expr_offsets(v, f, context))),
        None => expr
      },
      EContinue(args) => EContinue(map_exprs(args, f, context)),
      EMap(fields) => EMap(map_named_exprs(fields, f, context)),
      ESpread(e) => ESpread(map_expr_offsets(e, f, context)),
      EStringInterp(_) => expr
    }
  }
}

fn map_exprs(items: Array[Expr], f: (Int) -> Int, context: Option[ParserBinderContext]) -> Array[Expr] {
  for it in items {
    map_expr_offsets(it, f, context)
  }
}

fn map_named_exprs(fields: Array[(String, Expr)], f: (Int) -> Int, context: Option[ParserBinderContext]) -> Array[(String, Expr)] {
  for fld in fields {
    let (n, v) = fld
    (n, map_expr_offsets(v, f, context))
  }
}

fn map_arm_exprs(arms: Array[(Pat, Expr)], f: (Int) -> Int, context: Option[ParserBinderContext]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, e) = a
    (p, map_expr_offsets(e, f, context))
  }
}

/// Invert `offset_at(outer_starts, p)`: parse_recur (a closure over the
/// OUTER file's token-starts table) anchors every located node in a
/// fragment parse at `outer_starts[p]` where p is a FRAGMENT token index —
/// meaningless as a file position (Codex P2 on #975; only the
/// single-token-at-fragment-start case lined up by accident). outer_starts
/// is nondecreasing, so binary-search the smallest p with
/// outer_starts[p] == off, then re-anchor at the fragment's OWN start for
/// that token (frag_starts[p], from lex_with_offsets on the fragment text)
/// plus the fragment's absolute base. Anything unrecoverable becomes -1
/// (unlocated) rather than pointing at the wrong character.
fn remap_frag_off(off: Int, outer_starts: Array[Int], frag_starts: Array[Int], frag_base: Int) -> Int {
  let n = Array::length(outer_starts)
  let mut lo = 0
  let mut hi = n - 1
  let mut found = -1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = Array::get(outer_starts, mid)
    if v < off {
      lo = mid + 1
    } else {
      if v == off {
        found = mid
      } else {
        ()
      }
      hi = mid - 1
    }
  }
  if found >= 0 && found < Array::length(frag_starts) {
    frag_base + Array::get(frag_starts, found)
  } else {
    -1
  }
}

/// Desugar a string-interpolation token's parts into a `String::concat` chain.
/// Parts alternate literal/expression by index (even = literal chunk, odd =
/// embedded expression SOURCE). The embedded expression is lexed and parsed as a
/// full expression (not treated as a bare identifier), so `"\{1 + 1}"`,
/// `"\{f(x)}"`, `"\{p.field}"` etc. all work — matching the documented behavior.
/// Each interpolated value is rendered via `__to_string`. Bare-identifier parts
/// parse to the same `EIdent` the previous (ident-only) path produced, so
/// existing interpolations are unchanged.
///
/// `offsets` (#947) carries, in lockstep with `parts`, the absolute source
/// offset of each part's start (-1 for literal/even parts, which don't need
/// one). Each fragment is lexed in isolation with its OWN token-starts table
/// (lex_with_offsets), parsed via `parse_recur` — which anchors located nodes
/// using the OUTER file's starts table it closed over, i.e. at
/// outer_starts[fragment-token-index] — and then remapped node-by-node via
/// `remap_frag_off` (invert outer_starts, re-anchor at frag_starts[p] +
/// fragment base), so identifiers referenced inside `\{...}` carry their real
/// file position for any fragment shape (leading spaces, multi-token
/// expressions), not just a single token at the fragment start.
fn build_interp_expr(parts: Array[String], offsets: Array[Int], outer_starts: Array[Int], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> Expr with Exception {
  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {
    ECall(EIdent("String::concat", -1), [
      a,
      b
    ], -1)
  }
  let plen = Array::length(parts)
  let mut result = EString("")
  let mut has_val = false
  let mut i = 0
  while i < plen {
    let part = Array::get(parts, i)
    if i % 2 == 0 {
      if String::length(part) > 0 {
        let piece = EString(part)
        result = if has_val {
          concat_expr(result, piece)
        } else {
          piece
        }
        has_val = true
      } else {
        ()
      }
    } else {
      let (ftoks, fstarts, fends) = lex_with_offsets(part)
      let frag_off = if i < Array::length(offsets) {
        Array::get(offsets, i)
      } else {
        -1
      }
      if frag_off >= 0 {
        binder_capture_push_fragment(context, fstarts, fends, frag_off)
      } else {
        binder_capture_mark_ineligible(context)
      }
      let (pe0, _) = parse_recur(ftoks, 0, 0, context)
      if frag_off >= 0 {
        binder_capture_pop_fragment(context)
      } else {
        ()
      }
      let pe = if frag_off >= 0 {
        map_expr_offsets(pe0, (o) -> remap_frag_off(o, outer_starts, fstarts, frag_off), context)
      } else {
        pe0
      }
      let piece = ECall(EIdent("__to_string", -1), [
        pe
      ], -1)
      result = if has_val {
        concat_expr(result, piece)
      } else {
        piece
      }
      has_val = true
    }
    i = i + 1
  }
  result
}

/// Render a loop's parameter list for the #1284 arity diagnostic: `i, sum`.
fn join_loop_params(param_names: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(param_names) {
    out = if i == 0 {
      Array::get(param_names, i)
    } else {
      String::concat(out, String::concat(", ", Array::get(param_names, i)))
    }
    i = i + 1
  }
  out
}

/// Transform break(val) and continue(args) inside a loop body for desugaring.
/// break(val) → { __loop_result = val; break }
/// continue(a, b) → { let __lt0 = a; let __lt1 = b; p0 = __lt0; p1 = __lt1; continue }
///
/// #1284: `continue` and `break` are deliberately NOT symmetric, because they
/// name different things — `continue(a, b)` supplies the loop's PARAMETERS (as
/// many as `loop (..)` declares) while `break e` supplies the loop's single
/// RESULT (a `loop` is an expression with one value, so `break (a, b)` is one
/// tuple, not two values). The arity check below is what makes that rule
/// observable: before it, an argument list that did not match the parameter
/// list was accepted and silently miscompiled — too many arguments fell into a
/// pass-through arm that dropped the payload entirely (a compile-clean
/// infinite loop, the same failure mode #808 fixed for match arms), and too
/// few updated a positional PREFIX of the parameters and left the rest
/// unchanged, which no document ever specified.
fn desugar_loop_body(expr: Expr, param_names: Array[String], context: Option[ParserBinderContext]) -> Expr with Exception {
  match expr {
    EBreak(opt) => match opt {
      Some(val) => EAssign("__loop_result", desugar_loop_body(val, param_names, context), EBreak(None)),
      None => EBreak(None)
    },
    EContinue(args) => {
      if Array::length(args) == 0 {
        // Bare `continue`: repeat with every parameter unchanged.
        EContinue(args)
      } else {
        let nargs = Array::length(args)
        let nparams = Array::length(param_names)
        if nargs != nparams {
          throw(String::concat("continue: this loop declares ", String::concat(__to_string(nparams), String::concat(" parameter(s) (", String::concat(join_loop_params(param_names), String::concat("), but continue was given ", String::concat(__to_string(nargs), " argument(s). `continue` passes a new value for EVERY loop parameter; use a bare `continue` to repeat with the current values unchanged. `break` is NOT symmetric with this — it takes the loop's single result value, so `break (a, b)` is one tuple. (#1284)")))))))
        } else {
          let mut result = EContinue(Array::slice([
            EUnit
          ], 0, 0))
          let mut ci = nargs - 1
          while ci >= 0 {
            result = EAssign(Array::get(param_names, ci), EIdent(String::concat("__lt", __to_string(ci)), -1), result)
            ci = ci - 1
          }
          let mut ci2 = nargs - 1
          while ci2 >= 0 {
            result = ELet(String::concat("__lt", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names, context), result, -1)
            ci2 = ci2 - 1
          }
          result
        }
      }
    },
    EWhile(_, _) => expr,
    ELoop(_, _) => expr,
    EFn(_, _, _, _, _, _) => expr,
    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names, context), desugar_loop_body(t, param_names, context), desugar_loop_body(e, param_names, context)),
    ELet(n, v, b, soff) => ELet(n, desugar_loop_body(v, param_names, context), desugar_loop_body(b, param_names, context), soff),
    ELetMut(n, v, b, soff) => ELetMut(n, desugar_loop_body(v, param_names, context), desugar_loop_body(b, param_names, context), soff),
    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names, context), desugar_loop_body(b, param_names, context)),
    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names, context), desugar_loop_body(c, param_names, context)),
    // #808: recurse into match/handle arm bodies so `break v` / `continue(args)`
    // inside an arm get the loop desugar (the raw EBreak/EContinue otherwise
    // reach codegen with their payloads dropped — `continue(i + 1)` looped
    // without updating `i` = compile-clean infinite loop). The old pass-through
    // was a workaround for the retired MoonBit host (#594) crashing on
    // (Pat, Expr) tuple ops; the selfhost parser handles arm tuples fine
    // (same idiom as expand_interp.vibe). Patterns are left untouched.
    EMatch(s, arms) => EMatch(desugar_loop_body(s, param_names, context), for a in arms {
      let (p, ex) = a
      (p, desugar_loop_body(ex, param_names, context))
    }),
    EHandle(body, arms) => EHandle(desugar_loop_body(body, param_names, context), for a in arms {
      let (p, ex) = a
      (p, desugar_loop_body(ex, param_names, context))
    }),
    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names, context), desugar_loop_body(r, param_names, context)),
    ECall(callee, args, off) => ECall(desugar_loop_body(callee, param_names, context), for arg in args {
      desugar_loop_body(arg, param_names, context)
    }, off),
    ETuple(items) => ETuple(for item in items {
      desugar_loop_body(item, param_names, context)
    }),
    EArray(items) => EArray(for item in items {
      desugar_loop_body(item, param_names, context)
    }),
    ERecord(name, fields, targs) => ERecord(name, for field in fields {
      let (field_name, value) = field
      (field_name, desugar_loop_body(value, param_names, context))
    }, targs),
    EMap(fields) => EMap(for field in fields {
      let (field_name, value) = field
      (field_name, desugar_loop_body(value, param_names, context))
    }),
    ELabeledArg(label, name, value) => ELabeledArg(label, name, desugar_loop_body(value, param_names, context)),
    ESpread(value) => ESpread(desugar_loop_body(value, param_names, context)),
    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names, context), desugar_loop_body(b, param_names, context)),
    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names, context)),
    EDot(obj, field, off, fdoff) => EDot(desugar_loop_body(obj, param_names, context), field, off, fdoff),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names, context), desugar_loop_body(c, param_names, context)),
    _ => expr
  }
}

fn parse_loop_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TLParen => {
      let param_names_b = ArrayBuilder::new()
      let param_inits_b = ArrayBuilder::new()
      let mut cur = pos + 2
      let mut done = false
      while !done {
        match peek(tokens, cur) {
          TRParen => {
            cur = cur + 1
            done = true
          },
          TIdent(name) => {
            binder_capture_source(context, name, cur, cur)
            let eq_pos = expect_tk(tokens, cur + 1, "=")
            let (init, next_pos) = parse_recur(tokens, eq_pos, 0, context)
            ArrayBuilder::push(param_names_b, name)
            ArrayBuilder::push(param_inits_b, init)
            match peek(tokens, next_pos) {
              TComma => {
                cur = next_pos + 1
              },
              TRParen => {
                cur = next_pos + 1
                done = true
              },
              _ => throw("expected ',' or ')' in loop params")
            }
          },
          _ => throw("expected loop parameter name or ')'")
        }
      }
      let body_pos = expect_tk(tokens, cur, "{")
      let body_mark = binder_capture_mark(context)
      let (body, end_pos) = parse_recur(tokens, body_pos, 20, context)
      binder_capture_insert_synthetic_at(context, body_mark, "__loop_result")
      // Desugar ELoop into ELetMut + EWhile
      let pnames = ArrayBuilder::freeze(param_names_b)
      let pinits = ArrayBuilder::freeze(param_inits_b)
      let transformed_body = desugar_loop_body(body, pnames, context)
      let while_expr = EWhile(EBool(true), transformed_body)
      let result = ELetMut("__loop_result", EInt(0), ESeq(while_expr, EIdent("__loop_result", -1)), -1)
      let mut wrapped = result
      let mut wi = Array::length(pnames) - 1
      while wi >= 0 {
        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped, -1)
        wi = wi - 1
      }
      (wrapped, end_pos)
    },
    _ => {
      let body_pos = expect_tk(tokens, pos + 1, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, 20, context)
      (EWhile(EBool(true), body), end_pos)
    }
  }
}

fn parse_break_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TRBrace => (EBreak(None), pos + 1),
    TSemicolon => (EBreak(None), pos + 1),
    TEof => (EBreak(None), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0, context)
      (EBreak(Some(expr)), next_pos)
    }
  }
}

/// #640 Stage 2: `throw(x)` is sugar for `perform Exception::Throw(x)` — the
/// parser desugars it to the exact AST shape parse_perform_primary produces
/// for the explicit spelling (ECall(EIdent("perform"), [ECall(
/// EIdent("Exception::Throw"), [x])])), so every downstream stage (checker,
/// normalize, both codegen backends) sees ONE form. The printer re-sugars
/// this shape back to `throw(x)` (printer.vibe), keeping print round-trips
/// and the regenerated flat module source spelling-stable (no seed bump
/// needed). The `EThrow` AST node this desugar replaced was fully retired
/// in #640 Stage 4 (ctor removed from @vibe/ast); this parse shape is now
/// the only form of `throw`. All synthesized nodes carry the `throw`
/// token's offset so located diagnostics keep pointing at the keyword.
///
/// #1461: the operation label the desugar SYNTHESIZES is the canonical
/// `Exception::Throw`. This is what a row-mismatch diagnostic for an
/// un-annotated `throw` reports -- the single most-seen exception diagnostic
/// there is -- so leaving it at `Exception::Throw` would have made the canonical
/// flip invisible exactly where it is read most. Every consumer of the label
/// goes through is_exception_throw_operation, which accepts both spellings;
/// the printer's re-sugar is the one exact comparison and it now matches both
/// (it cannot import the predicate -- @vibe/parser must not depend on the
/// compiler package).
fn parse_throw_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let open_pos = expect_tk(tokens, pos + 1, "(")
  let (expr, next_pos) = parse_recur(tokens, open_pos, 0, context)
  let close_pos = expect_tk(tokens, next_pos, ")")
  let off = offset_at(starts, pos)
  (ECall(EIdent("perform", off), [
    ECall(EIdent("Exception::Throw", off), [
      expr
    ], off)
  ], off), close_pos)
}

fn parse_return_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TRBrace => (EReturn(EUnit), pos + 1),
    TSemicolon => (EReturn(EUnit), pos + 1),
    TEof => (EReturn(EUnit), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0, context)
      (EReturn(expr), next_pos)
    }
  }
}

fn parse_perform_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TRParen => (EIdent("perform", -1), pos + 1),
    TRBracket => (EIdent("perform", -1), pos + 1),
    TRBrace => (EIdent("perform", -1), pos + 1),
    TComma => (EIdent("perform", -1), pos + 1),
    TSemicolon => (EIdent("perform", -1), pos + 1),
    TEof => (EIdent("perform", -1), pos + 1),
    TQuestion => {
      // ADR-0088: `perform? Op(...)` is not postfix `expr?` (`__try_op`).
      let (arg, next_pos) = parse_recur(tokens, pos + 2, 10, context)
      (ECall(EIdent("perform?", offset_at(starts, pos)), [
        arg
      ], offset_at(starts, pos)), next_pos)
    },
    _ => {
      // `perform` binds tighter than binary operators: parse only the
      // effect-op application (primary + postfix), not a trailing binary
      // expression, so `perform A::Op + perform B::Op` groups as
      // `(perform A::Op) + (perform B::Op)` rather than
      // `perform (A::Op + perform B::Op)` (#550). min_prec 10 is above the
      // highest binop precedence (9, see binop_prec), so parse_infix_loop
      // stops before consuming any operator.
      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10, context)
      (ECall(EIdent("perform", -1), [
        arg
      ], offset_at(starts, pos)), next_pos)
    }
  }
}

fn parse_array_elems_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[Expr], Int) with Exception {
  match peek(tokens, pos) {
    TComma => {
      let next_pos = pos + 1
      match peek(tokens, next_pos) {
        TRBracket => (ArrayBuilder::freeze(b), next_pos),
        TDotDotDot => {
          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0, context)
          ArrayBuilder::push(b, ESpread(expr))
          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur, context)
        },
        _ => {
          let (expr, end_pos) = parse_recur(tokens, next_pos, 0, context)
          ArrayBuilder::push(b, expr)
          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur, context)
        }
      }
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

fn parse_array_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TRBracket => (EArray(empty_exprs()), pos + 2),
    TDotDotDot => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 2, 0, context)
      ArrayBuilder::push(b, ESpread(first))
      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur, context)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    },
    _ => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0, context)
      ArrayBuilder::push(b, first)
      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur, context)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    }
  }
}

fn parse_comma_exprs_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[Expr], Int) with Exception {
  match peek(tokens, pos) {
    TComma => {
      // Allow a trailing comma before the closing `)` in tuples and call
      // argument lists (`(a, b,)` / `f(a, b,)`).
      match peek(tokens, pos + 1) {
        TRParen => (ArrayBuilder::freeze(b), pos + 1),
        _ => {
          let (e, next) = parse_recur(tokens, pos + 1, 0, context)
          ArrayBuilder::push(b, e)
          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur, context)
        }
      }
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

fn parse_continue_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TLParen => {
      let b = ArrayBuilder::new()
      let marks = ArrayBuilder::new()
      match peek(tokens, pos + 2) {
        TRParen => (EContinue(empty_exprs()), pos + 3),
        _ => {
          let mut p = pos + 2
          let mut done = false
          while !done {
            ArrayBuilder::push(marks, binder_capture_mark(context))
            let (arg, next) = parse_recur(tokens, p, 0, context)
            ArrayBuilder::push(b, arg)
            match peek(tokens, next) {
              TComma => match peek(tokens, next + 1) {
                TRParen => {
                  p = next + 2
                  done = true
                },
                _ => {
                  p = next + 1
                }
              },
              TRParen => {
                p = next + 1
                done = true
              },
              _ => throw("expected ',' or ')' after continue argument")
            }
          }
          let args = ArrayBuilder::freeze(b)
          let row_marks = ArrayBuilder::freeze(marks)
          let mut i = Array::length(args) - 1
          while i >= 0 {
            binder_capture_insert_synthetic_at(context, Array::get(row_marks, i), String::concat("__lt", __to_string(i)))
            i = i - 1
          }
          (EContinue(args), p)
        }
      }
    },
    _ => (EContinue(empty_exprs()), pos + 1)
  }
}

fn parse_control_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TLBrace => parse_recur(tokens, pos + 1, 20, context),
    TIf => parse_recur(tokens, pos + 1, 21, context),
    TMatch => parse_recur(tokens, pos + 1, 22, context),
    THandle => parse_recur(tokens, pos + 1, 24, context),
    TWhile => parse_recur(tokens, pos + 1, 23, context),
    TFor => parse_recur(tokens, pos + 1, 25, context),
    TTaskGroup => parse_recur(tokens, pos + 1, 26, context),
    TRegion => parse_recur(tokens, pos + 1, 27, context),
    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur, context),
    TBreak => parse_break_primary(tokens, starts, pos, parse_recur, context),
    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur, context),
    TRaise => throw("'raise' is deprecated, use 'throw(expr)' instead"),
    TReturn => parse_return_primary(tokens, starts, pos, parse_recur, context),
    TDo => throw("'do' is reserved; use 'while' or 'for' instead"),
    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur, context),
    TYield => throw("'yield' is not supported"),
    TDeclare => throw("'declare' is not supported"),
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw(format_unexpected_token(starts, pos, actual))
    }
  }
}

/// #836: named struct constructor literals (`Name::{ ... }`) accept the same
/// field-shorthand as anonymous record literals (`record { ... }`, see
/// `parse_record_literal_fields` below) — `Name::{ left, right }` desugars to
/// `Name::{ left: left, right: right }` by matching a bare identifier field to
/// an in-scope binding of the same name. Mirrors `parse_record_literal_fields`
/// exactly so both literal forms stay in sync.
fn parse_ctor_record_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[(String, Expr)], Int) with Exception {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let (val, next_pos) = match peek(tokens, pos + 1) {
        TComma => (EIdent(fname, -1), pos + 1),
        TRBrace => (EIdent(fname, -1), pos + 1),
        _ => {
          let colon_pos = expect_tk(tokens, pos + 1, ":")
          parse_recur(tokens, colon_pos, 0, context)
        }
      }
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur, context),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

// Trait-bound names are references, not binders.
fn parse_generic_type_param_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Exception {
  let bounds = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(bounds, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(bounds), p)
}

/// Parse an expression-position `[T: Bound, U]` header. This intentionally
/// stays private to the primary-expression parser: unlike declaration headers,
/// it is not part of the public parser contract.
fn parse_generic_fn_type_params_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[String], Array[(String, Array[String])], Int) with Exception {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        // Only the depth-one identifier is a binder. Capture its exact token
        // before advancing into trait-bound references, value params, or body.
        binder_capture_source(context, name, p, p)
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_generic_type_param_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']' in type params")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

fn parse_generic_fn_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let (type_params, type_bounds, after_header) = parse_generic_fn_type_params_with_binder_context(tokens, pos + 1, context)
  let params_pos = expect_tk(tokens, after_header, "(")
  let (params, after_params) = parse_param_list_with_binder_context(tokens, params_pos, context)
  match peek(tokens, after_params) {
    TThinArrow => {
      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)
      let effect_pair = match peek(tokens, ret_pos) {
        TWith => {
          let effect_name_pair = parse_effect_row(tokens, ret_pos + 1)
          let effect_name = effect_name_pair.0
          let end_pos = effect_name_pair.1
          (Some(effect_name), end_pos)
        },
        _ => (None, ret_pos)
      }
      let effect = effect_pair.0
      let effect_next = effect_pair.1
      let body_pos = expect_tk(tokens, effect_next, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, 20, context)
      (EFn(type_params, type_bounds, params, Some(ret_ty), effect, body), end_pos)
    },
    TLBrace => {
      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20, context)
      (EFn(type_params, type_bounds, params, None, None, body), end_pos)
    },
    _ => throw("expected '->' or '{' after generic function params")
  }
}

fn is_generic_fn_start(tokens: Array[Token], pos: Int) -> Bool {
  match peek(tokens, pos + 1) {
    TIdent(_) => {
      let mut p = pos + 2
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, p) {
          TLBracket => {
            depth = depth + 1
          },
          TRBracket => {
            depth = depth - 1
          },
          TEof => {
            depth = 0
          },
          _ => ()
        }
        p = p + 1
      }
      match peek(tokens, p) {
        TLParen => true,
        _ => false
      }
    },
    _ => false
  }
}

fn parse_bracket_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  if is_generic_fn_start(tokens, pos) {
    parse_generic_fn_primary(tokens, starts, pos, parse_recur, context)
  } else {
    parse_array_primary(tokens, starts, pos, parse_recur, context)
  }
}

fn parse_paren_tuple_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos + 1) {
    TRParen => (EUnit, pos + 2),
    _ => {
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0, context)
      match peek(tokens, next_pos) {
        TRParen => (first, next_pos + 1),
        TComma => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur, context)
          let close_pos = expect_tk(tokens, end_pos, ")")
          (ETuple(items), close_pos)
        },
        _ => throw("expected ')' or ','")
      }
    }
  }
}

fn parse_paren_lambda_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let (params, after_params) = parse_param_list_with_binder_context(tokens, pos + 1, context)
  match peek(tokens, after_params) {
    TThinArrow => {
      let after_arrow = after_params + 1
      match peek(tokens, after_arrow) {
        TIdent(_) => {
          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
          match peek(tokens, ty_pos) {
            TLBrace => {
              let (body, end) = parse_recur(tokens, ty_pos + 1, 20, context)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)
            },
            TWith => {
              let effect_pair = parse_effect_row(tokens, ty_pos + 1)
              let effect_name = effect_pair.0
              let effect_next = effect_pair.1
              let body_pos = expect_tk(tokens, effect_next, "{")
              let (body, end) = parse_recur(tokens, body_pos, 20, context)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)
            },
            _ => {
              let (body, end) = parse_recur(tokens, after_arrow, 0, context)
              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
            }
          }
        },
        TLParen => {
          // The parens after `->` are ambiguous: a return-type annotation
          // `(A, B) { body }` / `(A, B) with E { body }` (incl. a curried
          // `(A) -> B { body }`), OR a body that merely starts with `(`, e.g.
          // `(t) -> (t.1, t.0)`. Speculatively parse a type; a body expression
          // makes parse_type_impl throw ("expected ')' or ',' in type" at the
          // `.`), so recover and parse the parens as the body instead. When the
          // type parse SUCCEEDS but is not followed by `{`/`with` it is likewise
          // a body (the `_` arm) — e.g. a nested-lambda body `(x) -> f`. #788.
          let ty_opt = handle {
            let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
            Some((ty, ty_pos))
          } with Exception {
            Throw(_) => None
          }
          match ty_opt {
            Some(pair) => {
              let (ty, ty_pos) = pair
              match peek(tokens, ty_pos) {
                TLBrace => {
                  let (body, end) = parse_recur(tokens, ty_pos + 1, 20, context)
                  (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)
                },
                TWith => {
                  let effect_pair = parse_effect_row(tokens, ty_pos + 1)
                  let effect_name = effect_pair.0
                  let effect_next = effect_pair.1
                  let body_pos = expect_tk(tokens, effect_next, "{")
                  let (body, end) = parse_recur(tokens, body_pos, 20, context)
                  (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)
                },
                _ => {
                  let (body, end) = parse_recur(tokens, after_arrow, 0, context)
                  (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
                }
              }
            },
            None => {
              let (body, end) = parse_recur(tokens, after_arrow, 0, context)
              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
            }
          }
        },
        _ => {
          let (body, end) = parse_recur(tokens, after_arrow, 0, context)
          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
        }
      }
    },
    TLBrace => {
      let (body, end) = parse_recur(tokens, after_params + 1, 20, context)
      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
    },
    _ => throw("expected '->' or '{' after fn params")
  }
}

fn parse_paren_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  if is_lambda_start(tokens, pos + 1) {
    parse_paren_lambda_primary(tokens, starts, pos, parse_recur, context)
  } else {
    parse_paren_tuple_primary(tokens, starts, pos, parse_recur, context)
  }
}

fn parse_record_literal_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[(String, Expr)], Int) with Exception {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let (val, next_pos) = match peek(tokens, pos + 1) {
        TComma => (EIdent(fname, -1), pos + 1),
        TRBrace => (EIdent(fname, -1), pos + 1),
        _ => {
          let colon_pos = expect_tk(tokens, pos + 1, ":")
          parse_recur(tokens, colon_pos, 0, context)
        }
      }
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur, context),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

/// Look up the source char offset of the token at position `p` in the
/// parallel `starts` array produced by the offset-tracking lexer. Returns
/// -1 when `starts` has no entry for `p` (e.g. the empty-array entry points
/// `parse`/`parse_expr` that do not thread real offsets).
fn offset_at(starts: Array[Int], p: Int) -> Int {
  if p >= 0 && p < Array::length(starts) {
    Array::get(starts, p)
  } else {
    -1
  }
}

/// #836/#886: detect `Name[...]::{` (explicit struct type arguments on a named
/// struct constructor literal, e.g. `Pair[Int]::{ left: 1, right: 2 }`).
/// `pos` is the TLBracket immediately after the constructor name. Skips the
/// balanced `[...]` span (mirrors `is_generic_fn_start`'s bracket-depth scan)
/// and checks whether it is immediately followed by `::{`. Disambiguates the
/// explicit-type-args constructor form from postfix indexing (`arr[i]`) before
/// `parse_ident_primary` commits to parsing the type-argument list (#886).
fn is_struct_targs_ctor_start(tokens: Array[Token], pos: Int) -> Bool {
  let mut p = pos + 1
  let mut depth = 1
  while depth > 0 {
    match peek(tokens, p) {
      TLBracket => {
        depth = depth + 1
      },
      TRBracket => {
        depth = depth - 1
      },
      TEof => {
        depth = 0
      },
      _ => ()
    }
    p = p + 1
  }
  match peek(tokens, p) {
    TDoubleColon => match peek(tokens, p + 1) {
      TLBrace => true,
      _ => false
    },
    _ => false
  }
}

/// #886: parse the comma-separated type-argument list of an explicit struct
/// constructor literal `Name[T1, T2, ...]::{ ... }`. `pos` is the token just
/// after the opening `[`. Returns the parsed arguments and the position just
/// after the closing `]`. Full type grammar (nested generics, tuples, fn
/// types) via `parse_type_impl`, same as annotation positions.
fn parse_struct_ctor_targs(tokens: Array[Token], pos: Int, name: String) -> (Array[TypeExpr], Int) with Exception {
  match peek(tokens, pos) {
    TRBracket => throw("expected at least one type argument in `\{name}[...]::{ ... }` at #\{pos}: write `\{name}::{ ... }` to infer the type arguments from the field values"),
    _ => {
      let (first, after_first) = parse_type_impl(tokens, pos, 0)
      let targs = [
        first
      ]
      let mut p = after_first
      while tk_name(peek(tokens, p)) == "," {
        let (next, after_next) = parse_type_impl(tokens, p + 1, 0)
        Array::push(targs, next)
        p = after_next
      }
      let end_pos = expect_tk(tokens, p, "]")
      (targs, end_pos)
    }
  }
}

fn parse_ident_primary(tokens: Array[Token], starts: Array[Int], pos: Int, name: String, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  if name == "true" {
    (EBool(true), pos + 1)
  } else if name == "false" {
    (EBool(false), pos + 1)
  } else if name == "perform" {
    parse_perform_primary(tokens, starts, pos, parse_recur, context)
  } else if name == "record" {
    match peek(tokens, pos + 1) {
      TLBrace => {
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur, context)
        (ERecord("", fields, empty_type_exprs()), end_pos)
      },
      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)
    }
  } else if name == "map" {
    match peek(tokens, pos + 1) {
      // #960 Stage 2: the `map { ... }` literal is retired. `map` before `{`
      // stays detected here solely to give a located, actionable diagnostic
      // (a plain unknown-name error would be misleading). Everywhere else
      // `map` is an ordinary identifier (Iterator::map etc. need no `r#`).
      TLBrace => throw("the `map { ... }` literal was removed (#960): use Map::from_pairs([(\"key\", value), ...]) or Map::new() at #\{pos}"),
      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)
    }
  } else {
    match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (EIdent(String::concat(name, String::concat("::", member)), offset_at(starts, pos)), pos + 3),
        TLBrace => {
          let b = ArrayBuilder::new()
          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur, context)
          (ERecord(name, fields, empty_type_exprs()), end_pos)
        },
        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)
      },
      // #886: `Name[Args]::{ ... }` — explicit struct type arguments on a
      // named struct constructor literal (deferred from #836). The bracket
      // scan disambiguates from postfix indexing (`arr[i]`): only a balanced
      // `[...]` immediately followed by `::{` parses as type arguments. The
      // parsed list rides in ERecord's third slot; the checker validates it
      // against the struct's declared type params and pins the instantiation
      // (#829's inference otherwise derives the args from the field values).
      TLBracket => if is_struct_targs_ctor_start(tokens, pos + 1) {
        let (targs, after_targs) = parse_struct_ctor_targs(tokens, pos + 2, name)
        let dc_pos = expect_tk(tokens, after_targs, "::")
        let brace_pos = expect_tk(tokens, dc_pos, "{")
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, brace_pos, b, parse_recur, context)
        (ERecord(name, fields, targs), end_pos)
      } else {
        (EIdent(name, offset_at(starts, pos)), pos + 1)
      },
      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)
    }
  }
}

export fn parse_primary_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TInt(n) => (EInt(n), pos + 1),
    TFloat(n) => (EFloat(n), pos + 1),
    TString(s) => (EString(s), pos + 1),
    TStringInterp(parts, offs) => (build_interp_expr(parts, offs, starts, parse_recur, context), pos + 1),
    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur, context),
    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur, context),
    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur, context),
    _ => parse_control_primary(tokens, starts, pos, parse_recur, context)
  }
}

export fn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with Exception) -> (Expr, Int) with Exception {
  let adapted = (rtoks, rpos, rmode, _context) -> parse_recur(rtoks, rpos, rmode)
  parse_primary_with_binder_context(tokens, starts, pos, adapted, None)
}
