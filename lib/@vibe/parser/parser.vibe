  offset_to_line_col
}

//# Functions

let parser_mode_block = 20

fn empty_names() -> Array[String] {
  Array::slice([
    "_"
  ], 0, 0)
}

fn parse_test_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);
      (STest(name, body), end)
    },
    _ => throw("expected test name string")
  }
}

/// #819: `example "name" { .. }` -- a documentation example. Same shape as
/// `test`, and the default parse entry points lower it to STest so it is
/// compiled and run by the same machinery (an example that does not compile is
/// the failure mode this form exists to remove). The separate node survives
/// only through parse_*_preserving, for LSP hover and doc extraction.
fn parse_example_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);
      (SExample(name, body), end)
    },
    _ => throw("expected example name string")
  }
}

fn parse_bench_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);
      (SBench(name, body), end)
    },
    _ => throw("expected bench name string")
  }
}

/// Parse one export-list name, accepting a qualified `Ns::member`
/// (e.g. `JsonSchema::validate`) in addition to a bare ident.
fn parse_export_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) =>
        (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name in export list")
  }
}

fn parse_export_names_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int) with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      TIdent(_) => {
        let (nm, after) = parse_export_name(tokens, pos + 1)
        ArrayBuilder::push(b, nm)
        parse_export_names_rest(tokens, after, b)
      },
      _ => throw("expected name in export list")
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in export list")
  }
}

fn parse_import_items_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (item, next) = parse_import_item(tokens, pos + 1)
        ArrayBuilder::push(b, item)
        parse_import_items_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in import list")
  }
}

fn parse_import_items(tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int) with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_import_items(), pos + 1),
    _ => {
      let (first, next) = parse_import_item(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_import_items_rest(tokens, next, b)
    }
  }
}

/// #897: `import <path> as <mod> only { x, y }` binds the imported items
/// under a namespace, accessed as `mod.x`/`mod.y` in the importing file.
/// No new Stmt/Expr variant: each item's local alias is desugared to the
/// dot-joined string "mod.x" (real identifiers can never contain '.', so
/// this can't collide with anything a user could type) and stored as an
/// ordinary SImport — the existing import_alias_rewrite.vibe machinery
/// resolves it exactly like any other aliased import. `only` is a
/// contextual keyword (matched by ident text, not a reserved token) to
/// avoid reserving "only" globally.
fn qualify_import_items(mod_name: String, items: Array[(String, Option[String])]) -> Array[(String, Option[String])] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(items) {
    let (name, alias_opt) = Array::get(items, i)
    let local = match alias_opt {
      Some(alias) => alias,
      None => name
    }
    ArrayBuilder::push(b, (name, Some(String::concat(mod_name, String::concat(".", local)))))
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

fn parse_qualified_import_tail(tokens: Array[Token], pos: Int, path: String, mod_name: String) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(only_kw) => if only_kw == "only" {
      let br = expect_tk(tokens, pos + 1, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, qualify_import_items(mod_name, items)), end)
    } else {
      throw("expected 'only' after 'as <name>' in qualified import")
    },
    _ => throw("expected 'only' after 'as <name>' in qualified import")
  }
}

fn reject_executable_import_path(path: String) -> Unit with { Error } {
  if String::ends_with(path, ".vibex") {
    throw(".vibex is an executable root and cannot be imported: \{path}")
  } else {
    ()
  }
}

/// #769: a trailing `import <path> @alias` alias token must be recognized
/// regardless of what the path itself starts with. This used to be checked
/// only on the branch for a path starting with a bare identifier (`import
/// pkg_name @alias`); a path starting with `.`/`..` (the common case for the
/// compiler's own facades, e.g. `import ../../../lib/@vibe/json @json`) fell
/// through the catch-all `_` arm below, which always demanded a `{` next and
/// never looked for an alias — surfacing as "expected { but got ident" once
/// collect_import_path correctly stopped just before the alias token.
fn parse_import_path_tail(tokens: Array[Token], bp: Int, path: String) -> (Stmt, Int) with { Error } {
  match peek(tokens, bp) {
    TAs => match peek(tokens, bp + 1) {
      TIdent(mod_name) => parse_qualified_import_tail(tokens, bp + 2, path, mod_name),
      _ => throw("expected namespace name after 'as' in import")
    },
    TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {
      let alias_str = String::substring(alias_name, 1, String::length(alias_name))
      (SAliasDecl(alias_str, path), bp + 1)
    } else {
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, items), end)
    },
    _ => {
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, items), end)
    }
  }
}

fn parse_import_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {
      parse_import_path_tail(tokens, pos + 1, name)
    } else {
      let (path, bp) = collect_import_path(tokens, pos, "")
      reject_executable_import_path(path)
      parse_import_path_tail(tokens, bp, path)
    },
    _ => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      reject_executable_import_path(path)
      parse_import_path_tail(tokens, bp, path)
    }
  }
}

fn tl_push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {
  if is_mut {
    let (fname, _) = field
    ArrayBuilder::push(mb, fname)
  } else {
    ()
  }
}

fn parse_toplevel_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        tl_push_mut_name(mb, field, is_mut)
        parse_toplevel_struct_fields_rest(tokens, next, b, mb)
      }
    },
    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body
    // separator (see parser_base.vibe parse_enum_ctors_rest).
    TComma => throw("use ';' to separate declaration members; ',' was removed in 0.3.0 at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),
    _ => throw("expected ';' or '}' in struct at #\{pos}")
  }
}

fn parse_toplevel_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), Array::slice([
      ""
    ], 0, 0), pos + 1),
    _ => {
      let (first, is_mut, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      let mb = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      tl_push_mut_name(mb, first, is_mut)
      parse_toplevel_struct_fields_rest(tokens, next, b, mb)
    }
  }
}

fn parse_toplevel_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      // Optional type-parameter header `struct Foo[T] { ... }`. #829: the
      // param NAMES are kept on the SStruct (they used to be discarded) so
      // the checker can instantiate generic struct literals; representation
      // stays uniform/tagged like enum type params.
      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)
      let br = expect_tk(tokens, after_name, "{")
      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);
      let (derives, final_pos) = parse_derive_names(tokens, end)
      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)
    },
    _ => throw("expected struct name")
  }
}

/// ADR-0071 step 2: `effectset Name = { A, B, Effect::op }` / the qualified
/// form `effectset Effect::Name = { ... }` (name itself may be `Ident ::
/// Ident`, same qualification as parse_binding_name). Body reuses
/// collect_effect_names' item grammar (bare identifier or `Effect::op`) --
/// it already returns a comma-joined String, so the member list is
/// recovered by splitting that back into an Array[String]; no separate
/// item-collector needed. No type params yet (generic effectsets like
/// `State::Read[T]` are deferred to a later revision).
fn parse_effectset_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  let (name, after_name) = parse_binding_name(tokens, pos)
  let ep = expect_tk(tokens, after_name, "=")
  let bp = expect_tk(tokens, ep, "{")
  let (joined, next) = collect_effect_names(tokens, bp, "")
  let members = if String::length(joined) == 0 {
    Array::slice([
      ""
    ], 0, 0)
  } else {
    String::split(joined, ", ")
  }
  (SEffectSet(exported, name, members), next)
}

fn parse_export_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TLet => parse_let_stmt(tokens, starts, pos + 1, true),
    TEnum => parse_enum_stmt(tokens, pos + 1, true),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),
    // #1280: `fn` lexes as TFn (reserved word), no longer TIdent("fn").
    TFn => parse_fn_stmt(tokens, starts, pos + 1, true),
    TIdent(ident_name) => if ident_name == "effect" {
      parse_effect_stmt(tokens, pos + 1, true)
    } else if ident_name == "effectset" {
      parse_effectset_stmt(tokens, pos + 1, true)
    } else {
      throw(String::concat("unexpected token in export: ", ident_name))
    },
    TType => parse_type_alias_stmt(tokens, pos + 1, true),
    TTrait => parse_trait_stmt(tokens, pos + 1, true),
    TOpen => match peek(tokens, pos + 1) {
      TTrait => parse_trait_stmt(tokens, pos + 2, true),
      _ => throw("expected 'trait' after 'open'")
    },
    TLBrace => match peek(tokens, pos + 1) {
      TRBrace => (SExport(empty_names()), pos + 2),
      TIdent(_) => {
        let (first, after) = parse_export_name(tokens, pos + 1)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, first)
        let (names, end) = parse_export_names_rest(tokens, after, b);
        (SExport(names), end)
      },
      _ => throw("expected name in export list")
    },
    TDot => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      reject_executable_import_path(path)
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SReExport(path, items), end)
    },
    // #769: `export ../foo/index.vibe { .. }` (a re-export that climbs OUT of
    // the current directory, as used by entry/compiler/index.vibe) is exactly
    // as valid an import-path start as `export ./foo { .. }` — only the
    // single-dot case was wired up here, so a leading `..` fell through to
    // the catch-all "unexpected after 'export'" error.
    TDotDot => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      reject_executable_import_path(path)
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SReExport(path, items), end)
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected after 'export': \{actual}")
    }
  }
}

fn parse_percent_symbol_name(tokens: Array[Token], pos: Int, label: String) -> (String, Int) with { Error } {
  let pp = expect_tk(tokens, pos, "%")
  match peek(tokens, pp) {
    TIdent(name) => ("%\{name}", pp + 1),
    _ => throw("expected \{label} after '%'")
  }
}

fn parse_extern_let_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {
  let lp = expect_tk(tokens, pos, "let")
  let (name, np) = parse_percent_symbol_name(tokens, lp, "extern symbol name")
  let cp = expect_tk(tokens, np, ":")
  let (ty, end) = parse_type(tokens, cp);
  (SExternLet(name, ty), end)
}

/// Statement parser that KEEPS `fn` declarations in declaration form
/// (SFnDecl, contracts un-desugared) — the input to printer/normalize
/// round-tripping (ADR-0064 #727). Everything that feeds the checker or
/// codegen should use `parse_stmt` / `parse_program*` below, which lower
/// SFnDecl to the legacy SLet shape.
export fn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  let head = peek(tokens, pos)
  match head {
    TLet => parse_let_stmt(tokens, starts, pos + 1, false),
    TExport => match peek(tokens, pos + 1) {
      // ADR-0063 Phase B (#728): module blocks are removed.
      TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
      _ => parse_export_stmt(tokens, starts, pos + 1)
    },
    TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
    TEnum => parse_enum_stmt(tokens, pos + 1, false),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),
    TType => parse_type_alias_stmt(tokens, pos + 1, false),
    TTrait => parse_trait_stmt(tokens, pos + 1, false),
    TTest => parse_test_stmt(tokens, starts, pos + 1),
    TExample => parse_example_stmt(tokens, starts, pos + 1),
    TBench => parse_bench_stmt(tokens, starts, pos + 1),
    TImport => parse_import_stmt(tokens, pos + 1),
    // #1280: `fn` lexes as TFn (reserved word), no longer TIdent("fn").
    TFn => parse_fn_stmt(tokens, starts, pos + 1, false),
    TIdent(name) => match name {
      "effect" => parse_effect_stmt(tokens, pos + 1, false),
      "effectset" => parse_effectset_stmt(tokens, pos + 1, false),
      "extern" => parse_extern_let_stmt(tokens, pos + 1),
      "use" => throw("'use' syntax is removed; use 'import <module-ref> { ... }'"),
      _ => {
        let (e, next) = parse_impl(tokens, starts, pos, 0)
        match peek(tokens, next) {
          TEq => match e {
            EIdent(name, _) => {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              (SExpr(EAssign(name, val, EUnit)), vn)
            },
            ECall(idx_callee, idx_args, _) => {
              // `arr[i] = v` at statement level: `__index(arr, i)` receiver
              // desugars to Array::set (same as the block-expr TEq arm).
              let is_index = match idx_callee {
                EIdent(icn, _) => icn == "__index",
                _ => false
              }
              if is_index && Array::length(idx_args) == 2 {
                let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
                let set_args = Array::slice([
                  EUnit
                ], 0, 0)
                Array::push(set_args, Array::get(idx_args, 0))
                Array::push(set_args, Array::get(idx_args, 1))
                Array::push(set_args, val)
                (SExpr(ECall(EIdent("Array::set", -1), set_args, -1)), vn)
              } else {
                (SExpr(e), next)
              }
            },
            _ => (SExpr(e), next)
          },
          TPlusEq => match e {
            EIdent(name, _) => {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              (SExpr(EAssignOp(name, "+", val, EUnit)), vn)
            },
            _ => (SExpr(e), next)
          },
          TMinusEq => match e {
            EIdent(name, _) => {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              (SExpr(EAssignOp(name, "-", val, EUnit)), vn)
            },
            _ => (SExpr(e), next)
          },
          TStarEq => match e {
            EIdent(name, _) => {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              (SExpr(EAssignOp(name, "*", val, EUnit)), vn)
            },
            _ => (SExpr(e), next)
          },
          TSlashEq => match e {
            EIdent(name, _) => {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              (SExpr(EAssignOp(name, "/", val, EUnit)), vn)
            },
            _ => (SExpr(e), next)
          },
          _ => (SExpr(e), next)
        }
      }
    },
    _ => {
      let (e, next) = parse_impl(tokens, starts, pos, 0);
      (SExpr(e), next)
    }
  }
}

/// Default statement entry: identical to parse_stmt_preserving except that a
/// `fn` declaration is lowered to the legacy `SLet(exported, true, name,
/// None, EFn(..))` shape with its where-contract desugared to runtime
/// asserts — i.e. exactly what this function returned before #727 kept the
/// declaration form. All existing consumers (checker, codegen, symbols,
/// contract engine, ...) keep seeing the pre-#727 AST.
export fn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {
  let (stmt, next) = parse_stmt_preserving(tokens, starts, pos)
  (lower_fn_decl_stmt(stmt), next)
}

/// Expand an impl body `{ method(params) -> ret { body } ... }` into the impl
/// marker plus one `let Type::method = (params) -> ret { body }` per method
/// (#641 Phase 1: concrete-receiver dispatch). Trait stays marker-only; the
/// methods become ordinary qualified free functions resolved by name. `pos` is
/// at the body `{` (or the next token for a body-less impl). Needs `parse_expr`,
/// which is why this lives here rather than in parser_base.
fn parse_impl_methods(tokens: Array[Token], pos: Int, simpl: Stmt) -> (Array[Stmt], Int) with { Error } {
  let out = ArrayBuilder::new()
  ArrayBuilder::push(out, simpl)
  match peek(tokens, pos) {
    TLBrace => {
      let type_name = match simpl {
        SImpl(_, _, _, tn) => tn,
        _ => ""
      }
      // A generic impl `impl [T: Bound] Trait for C { method(self){..} }` binds
      // `T` (and its bound) over each method body, so inject the impl's type
      // parameters + bounds into every method's `EFn`. This lets the body
      // dispatch `T::m(elem)` (resolved via the threaded witness dict, #5
      // Increment B). Non-generic impls have an empty list → methods unchanged.
      let impl_tparams = match simpl {
        SImpl(tp, _, _, _) => tp,
        _ => Array::slice([
          ""
        ], 0, 0)
      }
      let impl_tbounds = match simpl {
        SImpl(_, tb, _, _) => tb,
        _ => Array::slice([
          ("", Array::slice([
            ""
          ], 0, 0))
        ], 0, 0)
      }
      let mut p = pos + 1
      let mut done = false
      while !done {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            done = true
          },
          TIdent(mname) => {
            let (efn, p2) = parse_expr(tokens, p + 1)
            let efn2 = if Array::length(impl_tparams) > 0 {
              match efn {
                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),
                _ => efn
              }
            } else {
              efn
            }
            let qname = String::concat(type_name, String::concat("::", mname))
            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))
            p = match peek(tokens, p2) {
              TSemicolon => p2 + 1,
              _ => p2
            }
          },
          _ => throw("expected impl method name or '}'")
        }
      }
      (ArrayBuilder::freeze(out), p)
    },
    _ => (ArrayBuilder::freeze(out), pos)
  }
}

// Compile-time conditional compilation (#cfg). A top-level statement may be
// prefixed with `#cfg(flag)`; the statement is KEPT only when `flag` is
// active, and otherwise parsed (syntax must stay valid, like Rust's cfg) and
// DISCARDED before checking/codegen -- so disabled debug code adds zero bytes
// to the output. Flags are activated by `#cfg_enable(flag)` directives, which
// the CLI appends to the source when `VIBE_CFG=flag1,flag2` is set (appending
// at the END keeps every source offset -- and thus diagnostics -- unchanged).
// A pre-scan collects the active set so `#cfg_enable` position is irrelevant.
//
// NOTE: `#cfg` must not be used in the compiler's own source until the seed
// compiler understands it (docs/selfhost-bootstrap.md bump procedure).

/// Parse the directive after a THash: `cfg(name)` or `cfg_enable(name)`.
/// Returns (directive_kind, flag_name, next_pos).
fn parse_cfg_directive(tokens: Array[Token], pos: Int) -> (String, String, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(dname) => {
      if dname == "cfg" || dname == "cfg_enable" {
        match peek(tokens, pos + 1) {
          TLParen => match peek(tokens, pos + 2) {
            TIdent(flag) => match peek(tokens, pos + 3) {
              TRParen => (dname, flag, pos + 4),
              _ => throw("expected ')' after #cfg flag name")
            },
            _ => throw("expected flag name in #cfg(...)")
          },
          _ => throw("expected '(' after #cfg")
        }
      } else {
        throw(String::concat("unknown # directive: ", dname))
      }
    },
    _ => throw("expected directive name after '#'")
  }
}

/// Pre-scan the whole token stream for `#cfg_enable(name)` directives and
/// return the active flag set. O(tokens), no allocation unless a THash exists.
fn cfg_scan_enabled(tokens: Array[Token]) -> Array[String] with { Error } {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  let n = Array::length(tokens)
  while i < n {
    match Array::get(tokens, i) {
      THash => {
        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)
        if dname == "cfg_enable" {
          Array::push(out, flag)
        } else {
          ()
        }
        i = next
      },
      _ => {
        i = i + 1
      }
    }
  }
  out
}

fn cfg_flag_active(active: Array[String], flag: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(active) {
    if Array::get(active, i) == flag {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Program parser that KEEPS `fn` declarations as SFnDecl (see
/// parse_stmt_preserving) — used by the printer/normalize round-trip so
/// `vibe normalize` re-emits `fn name(..) -> T where { .. } { .. }` instead
/// of rewriting it to `let rec` form (ADR-0064 #727).
export fn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error } {
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
        if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
          // enable directive consumed, or active #cfg: keep the next stmt.
          pos = dnext
        } else {
          // Inactive #cfg: parse the guarded statement and discard it.
          match peek(tokens, dnext) {
            TImpl => {
              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
              pos = dn
            },
            _ => {
              let (_dropped, dn) = parse_stmt_preserving(tokens, [
              ], dnext)
              pos = dn
            }
          }
        }
      },
      TImpl => {
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)
        let mut ii = 0
        while ii < Array::length(impl_stmts) {
          ArrayBuilder::push(b, Array::get(impl_stmts, ii))
          ii = ii + 1
        }
        pos = next
      },
      _ => {
        let (stmt, next) = parse_stmt_preserving(tokens, [
        ], pos)
        ArrayBuilder::push(b, stmt)
        pos = next
      }
    }
  }
  ArrayBuilder::freeze(b)
}

/// Default program entry: `fn` declarations lowered to the legacy SLet shape
/// (where-contracts desugared to runtime asserts) — the exact pre-#727
/// output, so every checker/codegen consumer is unchanged.
export fn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error } {
  expand_top_level_pattern_lets(lower_fn_decl_stmts(parse_program_preserving(tokens)))
}

/// Like parse_program but, on a syntax error, prefixes the message with the
/// failing statement's `line:col` (from `lex_with_offsets` token start offsets).
/// Per-statement wrapping keeps the change local. Build the prefix with
/// String::concat (not `+` or interpolation) to avoid selfhost string-concat
/// NUL fragility. Source-span foundation: located parse diagnostics.
/// #816: in-body parse errors carry the failing TOKEN index as "at #N"
/// (expect_tk and the primary-dispatch "unexpected token" throw). Decode it so
/// the located wrapper anchors the diagnostic at the OFFENDING token instead
/// of the enclosing statement's start (an error on line 6 used to report
/// "line 2:1"), and strip the index + the lexer-internal "(prev=..., next=...)"
/// debris from the user-facing message.
fn extract_err_token_pos(msg: String, fallback_pos: Int) -> (Int, String) {
  let mi = String::index_of(msg, " at #")
  if mi < 0 {
    (fallback_pos, msg)
  } else {
    let mlen = String::length(msg)
    let mut di = mi + 5
    let mut n = 0
    let mut any = false
    let mut scanning = true
    while scanning {
      if di < mlen {
        let ch = String::char_code_at(msg, di)
        if ch >= 48 && ch <= 57 {
          n = n * 10 + (ch - 48)
          any = true
          di = di + 1
        } else {
          scanning = false
        }
      } else {
        scanning = false
      }
    }
    if !any {
      (fallback_pos, msg)
    } else {
      let head = String::substring(msg, 0, mi)
      let tail = String::substring(msg, di, mlen)
      let joined = String::concat(head, tail)
      let pi = String::index_of(joined, " (prev=")
      let cleaned = if pi >= 0 {
        String::substring(joined, 0, pi)
      } else {
        joined
      }
      (n, cleaned)
    }
  }
}

export fn parse_program_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with { Error } {
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
        if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
          pos = dnext
        } else {
          match peek(tokens, dnext) {
            TImpl => {
              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
              pos = dn
            },
            _ => {
              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)
              pos = dn
            }
          }
        }
      },
      _ => {
        let start_pos = pos
        let (stmts, next) = handle {
          match peek(tokens, pos) {
            TImpl => {
              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
              parse_impl_methods(tokens, hp, simpl)
            },
            _ => {
              let (stmt, n) = parse_stmt(tokens, starts, pos)
              ([
                stmt
              ], n)
            }
          }
        } with Error {
          Throw(msg) => {
            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)
            let anchor_pos = if err_pos < Array::length(starts) {
              err_pos
            } else {
              start_pos
            }
            let off = if anchor_pos < Array::length(starts) {
              Array::get(starts, anchor_pos)
            } else {
              0
            }
            let (line, col) = offset_to_line_col(source, off)
            let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
            throw(String::concat(loc, cleaned_msg))
          }
        }
        let mut ii = 0
        while ii < Array::length(stmts) {
          ArrayBuilder::push(b, Array::get(stmts, ii))
          ii = ii + 1
        }
        pos = next
      }
    }
  }
  expand_top_level_pattern_lets(ArrayBuilder::freeze(b))
}

/// True when `t` is a resynchronization point for `parse_program_recovering`:
/// it begins a top-level statement, OR is a statement separator (TSemicolon),
/// OR ends input (TEof). Folding TSemicolon/TEof in here lets the resync loop
/// use a single `if is_recovery_point(...)` test instead of a mixed
/// constructor/catch-all `match` (the latter traps the seed codegen on this
/// shape — keep this a flat function returning Bool).
fn is_recovery_point(t: Token) -> Bool {
  match t {
    TLet => true,
    TExport => true,
    TModule => true,
    TEnum => true,
    TSuberror => true,
    TStruct => true,
    TType => true,
    TTrait => true,
    TTest => true,
    TExample => true,
    TBench => true,
    TImport => true,
    TImpl => true,
    TDeclare => true,
    TOpen => true,
    TSemicolon => true,
    TEof => true,
    _ => false
  }
}

/// Like `parse_program_located`, but NEVER rethrows. On a per-statement syntax
/// error it records the located (`line:col`) message into a diagnostics array,
/// then resynchronizes by advancing `pos` to the next top-level statement start
/// (or TSemicolon / TEof). At least one token is always consumed to guarantee
/// progress. Returns the partial AST plus all collected diagnostics. Build all
/// strings with String::concat (not `+`/interpolation) to avoid selfhost
/// string-concat NUL fragility. Foundation: collect-all parse diagnostics (LSP).
export fn parse_program_recovering(tokens: Array[Token], starts: Array[Int], source: String) -> (Array[Stmt], Array[String]) with { Error } {
  let cfg_active = handle {
    cfg_scan_enabled(tokens)
  } with Error {
    Throw(_) => Array::slice([
      ""
    ], 0, 0)
  }
  let b = ArrayBuilder::new()
  let diags = ArrayBuilder::new()
  let n = Array::length(tokens)
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // #cfg directive: on any malformed directive fall through to the
        // recovery machinery below by treating it like a failed statement.
        let cfg_res = handle {
          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
          if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
            dnext
          } else {
            match peek(tokens, dnext) {
              TImpl => {
                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
                dn
              },
              _ => {
                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)
                dn
              }
            }
          }
        } with Error {
          Throw(_) => 0 - 1
        }
        if cfg_res >= 0 {
          pos = cfg_res
        } else {
          // resync: skip to the next recovery point (mirrors the stmt path).
          let mut rp = pos + 1
          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {
            rp = rp + 1
          }
          pos = rp
        }
      },
      _ => {
        let start_pos = pos
        let res = handle {
          let (stmts, next) = match peek(tokens, pos) {
            TImpl => {
              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
              parse_impl_methods(tokens, hp, simpl)
            },
            _ => {
              let (stmt, n) = parse_stmt(tokens, starts, pos)
              ([
                stmt
              ], n)
            }
          }
          Some((stmts, next))
        } with Error {
          Throw(msg) => {
            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)
            let anchor_pos = if err_pos >= start_pos && err_pos < Array::length(starts) {
              err_pos
            } else {
              start_pos
            }
            let off = if anchor_pos < Array::length(starts) {
              Array::get(starts, anchor_pos)
            } else {
              0
            }
            let (line, col) = offset_to_line_col(source, off)
            let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
            ArrayBuilder::push(diags, String::concat(loc, cleaned_msg))
            // #946: resynchronize from the ERROR ANCHOR, not the statement
            // start. Every token before the anchor was already consumed as
            // part of this failed statement, so restarting the parse at each
            // intervening recovery-point-looking token (e.g. the TLet inside
            // a failed `export let ...`) re-reported the SAME error 4-5x with
            // stray positions. Skip at least one token (progress guarantee),
            // then advance to the next recovery point (top-level statement
            // start, TSemicolon, or TEof — see is_recovery_point) and hand
            // the position back through the normal Some path (zero stmts).
            // #963: if the anchor token IS itself a recovery point (the
            // failed statement ran into the start of the NEXT top-level
            // statement, e.g. `export let a =` followed by `test ...`),
            // resume AT the anchor so that statement is parsed, not skipped.
            // Progress stays guaranteed: this branch is only taken when
            // anchor_pos > start_pos (the clamp above enforces
            // anchor_pos >= start_pos), and the anchor+1 path always
            // consumes at least one token.
            let resync_pos = if anchor_pos > start_pos && is_recovery_point(peek(tokens, anchor_pos)) {
              anchor_pos
            } else {
              let mut rp = anchor_pos + 1
              let mut sync = false
              while !sync {
                if rp >= n {
                  sync = true
                } else {
                  let t = peek(tokens, rp)
                  if is_recovery_point(t) {
                    sync = true
                  } else {
                    rp = rp + 1
                  }
                }
              }
              rp
            }
            Some((Array::slice([
              SExport(empty_names())
            ], 0, 0), resync_pos))
          }
        }
        match res {
          Some((stmts, next)) => {
            let mut ii = 0
            while ii < Array::length(stmts) {
              ArrayBuilder::push(b, Array::get(stmts, ii))
              ii = ii + 1
            }
            pos = next
          },
          None => {
            // Unreachable: the Throw handler above always returns Some with
            // an empty statement list and the resync position. Kept only for
            // match exhaustiveness; consume one token if ever reached.
            pos = start_pos + 1
          }
        }
      }
    }
  }
  (expand_top_level_pattern_lets(ArrayBuilder::freeze(b)), ArrayBuilder::freeze(diags))
}

/// Like `parse_program`, but also returns per top-level statement its source
/// byte span (start, end), derived from the token offset arrays produced by
/// `lex_with_offsets`. start = first token's start offset; end = last token's
/// end offset. The three returned arrays are parallel (one entry per stmt).
export fn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } {
  let b = ArrayBuilder::new()
  let span_start = ArrayBuilder::new()
  let span_end = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // Module-source (flat source) emission re-emits statement spans; a
        // #cfg directive sits OUTSIDE its statement's span, so passing it
        // through would silently change semantics between the original and
        // the re-emitted source. Refuse loudly instead (the compiler's own
        // source must not use #cfg until the seed understands it).
        throw("#cfg directives are not supported in module-source emission")
      },
      TImpl => {
        let st = Array::get(starts, pos)
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
        let next = skip_braced_body(tokens, hp)
        ArrayBuilder::push(b, simpl)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      },
      _ => {
        let st = Array::get(starts, pos)
        let (stmt, next) = parse_stmt(tokens, starts, pos)
        ArrayBuilder::push(b, stmt)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      }
    }
  }
  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))
}

