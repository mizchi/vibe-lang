//# Imports

import ../ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./parser_base.vibe {
  collect_import_path, empty_fields, empty_import_items, expect_tk, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_derive_names, peek, skip_braced_body, skip_derive, tk_name
}

import ./parser_expr.vibe {
  parse, parse_expr, parse_fn_stmt, parse_impl, parse_let_stmt, parse_ok
}

import ./token.vibe {
  Token
}

import ./lexer.vibe {
  offset_to_line_col
}

//# Functions

let parser_mode_block = 20

let empty_names: () -> Array[String] = () -> {
  Array::slice([
    "_"
  ], 0, 0)
}

let parse_test_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);
      (STest(name, body), end)
    },
    _ => throw("expected test name string")
  }
}

let parse_bench_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);
      (SBench(name, body), end)
    },
    _ => throw("expected bench name string")
  }
}

// Parse one export-list name, accepting a qualified `Ns::member`
// (e.g. `JsonSchema::validate`) in addition to a bare ident.
let parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) =>
          (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name in export list")
  }
}

let rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      TIdent(_) => {
        let (nm, after) = parse_export_name(tokens, pos + 1)
        ArrayBuilder::push(b, nm)
        parse_export_names_rest(tokens, after, b)
      },
      _ => throw("expected name in export list")
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in export list")
  }
}

let rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (item, next) = parse_import_item(tokens, pos + 1)
        ArrayBuilder::push(b, item)
        parse_import_items_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in import list")
  }
}

let parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_import_items(), pos + 1),
    _ => {
      let (first, next) = parse_import_item(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_import_items_rest(tokens, next, b)
    }
  }
}

let parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {
      let br = expect_tk(tokens, pos + 1, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(name, items), end)
    } else {
      let (path, bp) = collect_import_path(tokens, pos, "")
      match peek(tokens, bp) {
        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {
          let alias_str = String::substring(alias_name, 1, String::length(alias_name))
          (SAliasDecl(alias_str, path), bp + 1)
        } else {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        },
        _ => {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        }
      }
    },
    _ => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, items), end)
    }
  }
}

let tl_push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {
  if is_mut {
    let (fname, _) = field
    ArrayBuilder::push(mb, fname)
  } else {
    ()
  }
}

let rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        tl_push_mut_name(mb, field, is_mut)
        parse_toplevel_struct_fields_rest(tokens, next, b, mb)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        tl_push_mut_name(mb, field, is_mut)
        parse_toplevel_struct_fields_rest(tokens, next, b, mb)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),
    _ => throw("expected ';', ',' or '}' in struct")
  }
}

let parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), Array::slice([
      ""
    ], 0, 0), pos + 1),
    _ => {
      let (first, is_mut, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      let mb = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      tl_push_mut_name(mb, first, is_mut)
      parse_toplevel_struct_fields_rest(tokens, next, b, mb)
    }
  }
}

let parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      // Optional type-parameter header `struct Foo[T] { ... }`. Consumed and
      // discarded (uniform tagged representation, like enum type params).
      let after_name = match peek(tokens, pos + 1) {
        TLBracket => {
          let mut skip = pos + 2
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => {
                depth = depth + 1; skip = skip + 1
              },
              TRBracket => {
                depth = depth - 1; skip = skip + 1
              },
              TEof => {
                depth = 0
              },
              _ => {
                skip = skip + 1
              }
            }
          }
          skip
        },
        _ => pos + 1
      }
      let br = expect_tk(tokens, after_name, "{")
      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);
      let (derives, final_pos) = parse_derive_names(tokens, end)
      (SStruct(exported, name, fields, derives, mut_names), final_pos)
    },
    _ => throw("expected struct name")
  }
}

let parse_export_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {
  match peek(tokens, pos) {
    TLet => parse_let_stmt(tokens, starts, pos + 1, true),
    TEnum => parse_enum_stmt(tokens, pos + 1, true),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),
    TIdent(ident_name) => if ident_name == "effect" {
      parse_effect_stmt(tokens, pos + 1, true)
    } else if ident_name == "fn" {
      parse_fn_stmt(tokens, starts, pos + 1, true)
    } else {
      throw(String::concat("unexpected token in export: ", ident_name))
    },
    TType => parse_type_alias_stmt(tokens, pos + 1, true),
    TTrait => parse_trait_stmt(tokens, pos + 1, true),
    TOpen => match peek(tokens, pos + 1) {
      TTrait => parse_trait_stmt(tokens, pos + 2, true),
      _ => throw("expected 'trait' after 'open'")
    },
    TLBrace => match peek(tokens, pos + 1) {
      TRBrace => (SExport(empty_names()), pos + 2),
      TIdent(_) => {
        let (first, after) = parse_export_name(tokens, pos + 1)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, first)
        let (names, end) = parse_export_names_rest(tokens, after, b);
        (SExport(names), end)
      },
      _ => throw("expected name in export list")
    },
    TDot => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SReExport(path, items), end)
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected after 'export': \{actual}")
    }
  }
}

let parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {
  let pp = expect_tk(tokens, pos, "%")
  match peek(tokens, pp) {
    TIdent(name) => ("%\{name}", pp + 1),
    _ => throw("expected \{label} after '%'")
  }
}

let parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  let lp = expect_tk(tokens, pos, "let")
  let (name, np) = parse_percent_symbol_name(tokens, lp, "extern symbol name")
  let cp = expect_tk(tokens, np, ":")
  let (ty, end) = parse_type(tokens, cp);
  (SExternLet(name, ty), end)
}

export let rec parse_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {
  let head = peek(tokens, pos)
  match head {
    TLet => parse_let_stmt(tokens, starts, pos + 1, false),
    TExport => match peek(tokens, pos + 1) {
      // ADR-0063 Phase B (#728): module blocks are removed.
      TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
      _ => parse_export_stmt(tokens, starts, pos + 1)
    },
    TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
    TEnum => parse_enum_stmt(tokens, pos + 1, false),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),
    TType => parse_type_alias_stmt(tokens, pos + 1, false),
    TTrait => parse_trait_stmt(tokens, pos + 1, false),
    TTest => parse_test_stmt(tokens, starts, pos + 1),
    TBench => parse_bench_stmt(tokens, starts, pos + 1),
    TImport => parse_import_stmt(tokens, pos + 1),
    TIdent(name) => match name {
      "effect" => parse_effect_stmt(tokens, pos + 1, false),
      "extern" => parse_extern_let_stmt(tokens, pos + 1),
      "fn" => parse_fn_stmt(tokens, starts, pos + 1, false),
      "use" => throw("'use' syntax is removed; use 'import <module-ref> { ... }'"),
      _ => {
      let (e, next) = parse_impl(tokens, starts, pos, 0)
      match peek(tokens, next) {
        TEq => match e {
          EIdent(name, _) => {
            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
            (SExpr(EAssign(name, val, EUnit)), vn)
          },
          ECall(idx_callee, idx_args, _) => {
            // `arr[i] = v` at statement level: `__index(arr, i)` receiver
            // desugars to Array::set (same as the block-expr TEq arm).
            let is_index = match idx_callee {
              EIdent(icn, _) => icn == "__index",
              _ => false
            }
            if is_index && Array::length(idx_args) == 2 {
              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
              let set_args = Array::slice([
                EUnit
              ], 0, 0)
              Array::push(set_args, Array::get(idx_args, 0))
              Array::push(set_args, Array::get(idx_args, 1))
              Array::push(set_args, val)
              (SExpr(ECall(EIdent("Array::set", -1), set_args, -1)), vn)
            } else {
              (SExpr(e), next)
            }
          },
          _ => (SExpr(e), next)
        },
        TPlusEq => match e {
          EIdent(name, _) => {
            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
            (SExpr(EAssignOp(name, "+", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TMinusEq => match e {
          EIdent(name, _) => {
            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
            (SExpr(EAssignOp(name, "-", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TStarEq => match e {
          EIdent(name, _) => {
            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
            (SExpr(EAssignOp(name, "*", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TSlashEq => match e {
          EIdent(name, _) => {
            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)
            (SExpr(EAssignOp(name, "/", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        _ => (SExpr(e), next)
      }
      }
    },
    _ => {
      let (e, next) = parse_impl(tokens, starts, pos, 0);
      (SExpr(e), next)
    }
  }
}

// Expand an impl body `{ method(params) -> ret { body } ... }` into the impl
// marker plus one `let Type::method = (params) -> ret { body }` per method
// (#641 Phase 1: concrete-receiver dispatch). Trait stays marker-only; the
// methods become ordinary qualified free functions resolved by name. `pos` is
// at the body `{` (or the next token for a body-less impl). Needs `parse_expr`,
// which is why this lives here rather than in parser_base.
let parse_impl_methods: (Array[Token], Int, Stmt) -> (Array[Stmt], Int) with { Error } = (tokens, pos, simpl) -> {
  let out = ArrayBuilder::new()
  ArrayBuilder::push(out, simpl)
  match peek(tokens, pos) {
    TLBrace => {
      let type_name = match simpl {
        SImpl(_, _, _, tn) => tn,
        _ => ""
      }
      // A generic impl `impl [T: Bound] Trait for C { method(self){..} }` binds
      // `T` (and its bound) over each method body, so inject the impl's type
      // parameters + bounds into every method's `EFn`. This lets the body
      // dispatch `T::m(elem)` (resolved via the threaded witness dict, #5
      // Increment B). Non-generic impls have an empty list → methods unchanged.
      let impl_tparams = match simpl {
        SImpl(tp, _, _, _) => tp,
        _ => Array::slice([
          ""
        ], 0, 0)
      }
      let impl_tbounds = match simpl {
        SImpl(_, tb, _, _) => tb,
        _ => Array::slice([
          ("", Array::slice([
            ""
          ], 0, 0))
        ], 0, 0)
      }
      let mut p = pos + 1
      let mut done = false
      while !done {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            done = true
          },
          TIdent(mname) => {
            let (efn, p2) = parse_expr(tokens, p + 1)
            let efn2 = if Array::length(impl_tparams) > 0 {
              match efn {
                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),
                _ => efn
              }
            } else {
              efn
            }
            let qname = String::concat(type_name, String::concat("::", mname))
            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))
            p = match peek(tokens, p2) {
              TSemicolon => p2 + 1,
              _ => p2
            }
          },
          _ => throw("expected impl method name or '}'")
        }
      }
      (ArrayBuilder::freeze(out), p)
    },
    _ => (ArrayBuilder::freeze(out), pos)
  }
}

// Compile-time conditional compilation (#cfg). A top-level statement may be
// prefixed with `#cfg(flag)`; the statement is KEPT only when `flag` is
// active, and otherwise parsed (syntax must stay valid, like Rust's cfg) and
// DISCARDED before checking/codegen -- so disabled debug code adds zero bytes
// to the output. Flags are activated by `#cfg_enable(flag)` directives, which
// the CLI appends to the source when `VIBE_CFG=flag1,flag2` is set (appending
// at the END keeps every source offset -- and thus diagnostics -- unchanged).
// A pre-scan collects the active set so `#cfg_enable` position is irrelevant.
//
// NOTE: `#cfg` must not be used in the compiler's own source until the seed
// compiler understands it (docs/selfhost-bootstrap.md bump procedure).

// Parse the directive after a THash: `cfg(name)` or `cfg_enable(name)`.
// Returns (directive_kind, flag_name, next_pos).
let parse_cfg_directive: (Array[Token], Int) -> (String, String, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(dname) => {
      if dname == "cfg" || dname == "cfg_enable" {
        match peek(tokens, pos + 1) {
          TLParen => match peek(tokens, pos + 2) {
            TIdent(flag) => match peek(tokens, pos + 3) {
              TRParen => (dname, flag, pos + 4),
              _ => throw("expected ')' after #cfg flag name")
            },
            _ => throw("expected flag name in #cfg(...)")
          },
          _ => throw("expected '(' after #cfg")
        }
      } else {
        throw(String::concat("unknown # directive: ", dname))
      }
    },
    _ => throw("expected directive name after '#'")
  }
}

// Pre-scan the whole token stream for `#cfg_enable(name)` directives and
// return the active flag set. O(tokens), no allocation unless a THash exists.
let cfg_scan_enabled: (Array[Token]) -> Array[String] with { Error } = (tokens) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  let n = Array::length(tokens)
  while i < n {
    match Array::get(tokens, i) {
      THash => {
        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)
        if dname == "cfg_enable" {
          Array::push(out, flag)
        } else {
          ()
        }
        i = next
      },
      _ => {
        i = i + 1
      }
    }
  }
  out
}

let cfg_flag_active: (Array[String], String) -> Bool = (active, flag) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(active) {
    if Array::get(active, i) == flag {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
        if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
          // enable directive consumed, or active #cfg: keep the next stmt.
          pos = dnext
        } else {
          // Inactive #cfg: parse the guarded statement and discard it.
          match peek(tokens, dnext) {
            TImpl => {
              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
              pos = dn
            },
            _ => {
              let (_dropped, dn) = parse_stmt(tokens, [], dnext)
              pos = dn
            }
          }
        }
      },
      TImpl => {
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)
        let mut ii = 0
        while ii < Array::length(impl_stmts) {
          ArrayBuilder::push(b, Array::get(impl_stmts, ii))
          ii = ii + 1
        }
        pos = next
      },
      _ => {
        let (stmt, next) = parse_stmt(tokens, [], pos)
        ArrayBuilder::push(b, stmt)
        pos = next
      }
    }
  }
  ArrayBuilder::freeze(b)
}

// Like parse_program but, on a syntax error, prefixes the message with the
// failing statement's `line:col` (from `lex_with_offsets` token start offsets).
// Per-statement wrapping keeps the change local. Build the prefix with
// String::concat (not `+` or interpolation) to avoid selfhost string-concat
// NUL fragility. Source-span foundation: located parse diagnostics.
export let parse_program_located: (Array[Token], Array[Int], String) -> Array[Stmt] with { Error } = (tokens, starts, source) -> {
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
        if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
          pos = dnext
        } else {
          match peek(tokens, dnext) {
            TImpl => {
              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
              pos = dn
            },
            _ => {
              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)
              pos = dn
            }
          }
        }
      },
      _ => {
        let start_pos = pos
        let (stmts, next) = handle {
          match peek(tokens, pos) {
            TImpl => {
              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
              parse_impl_methods(tokens, hp, simpl)
            },
            _ => {
              let (stmt, n) = parse_stmt(tokens, starts, pos)
              ([
                stmt
              ], n)
            }
          }
        } with Error {
          Throw(msg) => {
            let off = if start_pos < Array::length(starts) {
              Array::get(starts, start_pos)
            } else {
              0
            }
            let (line, col) = offset_to_line_col(source, off)
            let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
            throw(String::concat(loc, msg))
          }
        }
        let mut ii = 0
        while ii < Array::length(stmts) {
          ArrayBuilder::push(b, Array::get(stmts, ii))
          ii = ii + 1
        }
        pos = next
      }
    }
  }
  ArrayBuilder::freeze(b)
}

// True when `t` is a resynchronization point for `parse_program_recovering`:
// it begins a top-level statement, OR is a statement separator (TSemicolon),
// OR ends input (TEof). Folding TSemicolon/TEof in here lets the resync loop
// use a single `if is_recovery_point(...)` test instead of a mixed
// constructor/catch-all `match` (the latter traps the seed codegen on this
// shape — keep this a flat function returning Bool).
let is_recovery_point: (Token) -> Bool = (t) -> {
  match t {
    TLet => true,
    TExport => true,
    TModule => true,
    TEnum => true,
    TSuberror => true,
    TStruct => true,
    TType => true,
    TTrait => true,
    TTest => true,
    TBench => true,
    TImport => true,
    TImpl => true,
    TDeclare => true,
    TOpen => true,
    TSemicolon => true,
    TEof => true,
    _ => false
  }
}

// Like `parse_program_located`, but NEVER rethrows. On a per-statement syntax
// error it records the located (`line:col`) message into a diagnostics array,
// then resynchronizes by advancing `pos` to the next top-level statement start
// (or TSemicolon / TEof). At least one token is always consumed to guarantee
// progress. Returns the partial AST plus all collected diagnostics. Build all
// strings with String::concat (not `+`/interpolation) to avoid selfhost
// string-concat NUL fragility. Foundation: collect-all parse diagnostics (LSP).
export let parse_program_recovering: (Array[Token], Array[Int], String) -> (Array[Stmt], Array[String]) with { Error } = (tokens, starts, source) -> {
  let cfg_active = handle {
    cfg_scan_enabled(tokens)
  } with Error {
    Throw(_) => Array::slice([
      ""
    ], 0, 0)
  }
  let b = ArrayBuilder::new()
  let diags = ArrayBuilder::new()
  let n = Array::length(tokens)
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // #cfg directive: on any malformed directive fall through to the
        // recovery machinery below by treating it like a failed statement.
        let cfg_res = handle {
          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)
          if dname == "cfg_enable" || cfg_flag_active(cfg_active, flag) {
            dnext
          } else {
            match peek(tokens, dnext) {
              TImpl => {
                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)
                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)
                dn
              },
              _ => {
                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)
                dn
              }
            }
          }
        } with Error {
          Throw(_) => 0 - 1
        }
        if cfg_res >= 0 {
          pos = cfg_res
        } else {
          // resync: skip to the next recovery point (mirrors the stmt path).
          let mut rp = pos + 1
          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {
            rp = rp + 1
          }
          pos = rp
        }
      },
      _ => {
        let start_pos = pos
        let res = handle {
          let (stmts, next) = match peek(tokens, pos) {
            TImpl => {
              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
              parse_impl_methods(tokens, hp, simpl)
            },
            _ => {
              let (stmt, n) = parse_stmt(tokens, starts, pos)
              ([
                stmt
              ], n)
            }
          }
          Some((stmts, next))
        } with Error {
          Throw(msg) => {
            let off = if start_pos < Array::length(starts) {
              Array::get(starts, start_pos)
            } else {
              0
            }
            let (line, col) = offset_to_line_col(source, off)
            let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
            ArrayBuilder::push(diags, String::concat(loc, msg))
            None
          }
        }
        match res {
          Some((stmts, next)) => {
            let mut ii = 0
            while ii < Array::length(stmts) {
              ArrayBuilder::push(b, Array::get(stmts, ii))
              ii = ii + 1
            }
            pos = next
          },
          None => {
            // Resynchronize: skip at least one token (guarantee progress),
            // then advance to the next recovery point (top-level statement
            // start, TSemicolon, or TEof — see is_recovery_point).
            let mut rp = start_pos + 1
            let mut sync = false
            while !sync {
              if rp >= n {
                sync = true
              } else {
                let t = peek(tokens, rp)
                if is_recovery_point(t) {
                  sync = true
                } else {
                  rp = rp + 1
                }
              }
            }
            pos = rp
          }
        }
      }
    }
  }
  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))
}

// Like `parse_program`, but also returns per top-level statement its source
// byte span (start, end), derived from the token offset arrays produced by
// `lex_with_offsets`. start = first token's start offset; end = last token's
// end offset. The three returned arrays are parallel (one entry per stmt).
export let parse_program_spans: (Array[Token], Array[Int], Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } = (tokens, starts, ends) -> {
  let b = ArrayBuilder::new()
  let span_start = ArrayBuilder::new()
  let span_end = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // Module-source (flat source) emission re-emits statement spans; a
        // #cfg directive sits OUTSIDE its statement's span, so passing it
        // through would silently change semantics between the original and
        // the re-emitted source. Refuse loudly instead (the compiler's own
        // source must not use #cfg until the seed understands it).
        throw("#cfg directives are not supported in module-source emission")
      },
      TImpl => {
        let st = Array::get(starts, pos)
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)
        let next = skip_braced_body(tokens, hp)
        ArrayBuilder::push(b, simpl)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      },
      _ => {
        let st = Array::get(starts, pos)
        let (stmt, next) = parse_stmt(tokens, starts, pos)
        ArrayBuilder::push(b, stmt)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      }
    }
  }
  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))
}

//# Misc

export {
  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program
}

export {
  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program
}
