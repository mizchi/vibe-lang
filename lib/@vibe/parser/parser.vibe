//# Functions

let parser_mode_block = 20

/// #3573: `Self` in an impl method's signature read as the impl's target.
/// Left as written, it was a wildcard: `mk(self: Self) -> Self` in `impl W for
/// P` returned a `Q` and compiled clean, and in an applied impl (`impl It[Int]
/// for P`) it was refused as an unknown type. A constructor application
/// `Self[A]` takes the target as its head when the target is a bare name.
fn impl_self_as_target(te: TypeExpr, target: TypeExpr) -> TypeExpr {
  match te {
    TyName(name) => if name == "Self" {
      target
    } else {
      te
    },
    TyApp(head, args) => {
      let mapped = for a in args {
        impl_self_as_target(te = a, target = target)
      }
      match target {
        TyName(tn) => if head == "Self" {
          TyApp(tn, mapped)
        } else {
          TyApp(head, mapped)
        },
        _ => TyApp(head, mapped)
      }
    },
    TyFn(params, ret, eff) => TyFn(for p in params {
      impl_self_as_target(te = p, target = target)
    }, impl_self_as_target(te = ret, target = target), eff),
    TyTuple(items) => TyTuple(for i in items {
      impl_self_as_target(te = i, target = target)
    }),
    TyUnit => TyUnit
  }
}

fn empty_names() -> Array[String] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

/// `allows <row>` between the name and the body widens this test's ambient
/// effect row (`docs/internal/design/test-example-capabilities.md`, #1508). A test,
/// bench or example is an entry point: nothing calls it, so its row is a
/// GRANT and `allows` is the word (ADR-0088). The row is logged and folded
/// into a trailing `STestEffectRows` marker rather than stored on `STest` --
/// see the marker's declaration in @vibe/ast for why.
///
/// `with <row>` here is refused with the `allows` edit (#2654); `kind` names
/// the block for the message ("test", "bench", "example").
fn parse_test_row_suffix(tokens: Array[Token], kind: String, name: String, pos: Int) -> Int with Exception {
  if peek_is_allows(tokens = tokens, pos = pos) {
    let (row, after) = parse_allows_row(tokens = tokens, pos = pos + 1)
    record_test_effect_row(name = name, row = row)
    after
  } else {
    match peek(tokens = tokens, pos = pos) {
      TWith => {
        let edit = String::concat(kind, String::concat(" \"", String::concat(name, "\"")))
        throw(entry_with_row_message(tokens = tokens, pos = pos, head = String::concat("`", String::concat(edit, "`")), edit = edit))
      },
      _ => pos
    }
  }
}

fn parse_test_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TString(name) => {
      let after_row = parse_test_row_suffix(tokens = tokens, kind = "test", name = name, pos = pos + 1)
      let br = expect_tk(tokens = tokens, pos = after_row, expected = "{")
      let (body, end) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = br, mode = parser_mode_block, context = context);
      (STest(name, body), end)
    },
    // #1514: blame the token that must become a string literal.
    _ => throw("expected test name string at #\{pos}")
  }
}

/// #819: `example "name" { .. }` -- a documentation example. Same shape as
/// `test`, and the default parse entry points lower it to STest so it is
/// compiled and run by the same machinery (an example that does not compile is
/// the failure mode this form exists to remove). The separate node survives
/// only through parse_*_preserving, for LSP hover and doc extraction.
fn parse_example_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TString(name) => {
      // An example is an entry point like a test and grants its row the same
      // way (`example "n" allows Console { .. }`); the row is keyed on the
      // name, which the STest lowering keeps.
      let after_row = parse_test_row_suffix(tokens = tokens, kind = "example", name = name, pos = pos + 1)
      let br = expect_tk(tokens = tokens, pos = after_row, expected = "{")
      let (body, end) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = br, mode = parser_mode_block, context = context);
      (SExample(name, body), end)
    },
    _ => throw("expected example name string")
  }
}

fn parse_bench_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TString(name) => {
      let after_row = parse_test_row_suffix(tokens = tokens, kind = "bench", name = name, pos = pos + 1)
      let br = expect_tk(tokens = tokens, pos = after_row, expected = "{")
      let (body, end) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = br, mode = parser_mode_block, context = context);
      (SBench(name, body), end)
    },
    _ => throw("expected bench name string")
  }
}

/// Parse one export-list name, accepting a qualified `Ns::member`
/// (e.g. `JsonSchema::validate`) in addition to a bare ident.
fn parse_export_name(tokens: Array[Token], pos: Int) -> (String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => match peek(tokens = tokens, pos = pos + 1) {
      TDoubleColon => match peek(tokens = tokens, pos = pos + 2) {
        TIdent(member) =>
        (intern_qualified(ns = name, member = member), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      // `export { Float }` publishes the type every `Float` names as
      // `Float32` (ADR-0122), like the import item it pairs with.
      _ => (float_width_type_name(name = name), pos + 1)
    },
    _ => throw("expected name in export list")
  }
}

fn parse_export_names_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TComma => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      TIdent(_) => {
        let (nm, after) = parse_export_name(tokens = tokens, pos = pos + 1)
        ArrayBuilder::push(b, value = nm)
        parse_export_names_rest(tokens = tokens, pos = after, b = b)
      },
      _ => throw("expected name in export list")
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in export list")
  }
}

fn parse_import_items_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[ImportItem], context: Option[ParserBinderContext]) -> (Array[ImportItem], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TComma => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (item, next) = parse_import_item_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        ArrayBuilder::push(b, value = item)
        parse_import_items_rest(tokens = tokens, pos = next, b = b, context = context)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in import list")
  }
}

fn parse_import_items(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[ImportItem], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TRBrace => (empty_import_items(), pos + 1),
    _ => {
      let (first, next) = parse_import_item_with_binder_context(tokens = tokens, pos = pos, context = context)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, value = first)
      parse_import_items_rest(tokens = tokens, pos = next, b = b, context = context)
    }
  }
}

/// #897: `import <path> as <mod> only { x, y }` binds the imported items
/// under a namespace, accessed as `mod.x`/`mod.y` in the importing file.
/// No new Stmt/Expr variant: each item's local alias is desugared to the
/// dot-joined string "mod.x" (real identifiers can never contain '.', so
/// this can't collide with anything a user could type) and stored as an
/// ordinary SImport — the existing import_alias_rewrite.vibe machinery
/// resolves it exactly like any other aliased import. `only` is a
/// contextual keyword (matched by ident text, not a reserved token) to
/// avoid reserving "only" globally.
fn qualify_import_items(mod_name: String, items: Array[ImportItem]) -> Array[ImportItem] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    let name = item.name
    let alias_opt = item.alias
    let local = match alias_opt {
      Some(alias) => alias,
      None => name
    }
    ArrayBuilder::push(b, value = ImportItem::{
      kind: item.kind,
      name,
      alias: Some(String::concat(mod_name, String::concat(".", local)))
    })
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

fn parse_qualified_import_tail(tokens: Array[Token], pos: Int, path: String, mod_name: String, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(only_kw) => if only_kw == "only" {
      let br = expect_tk(tokens = tokens, pos = pos + 1, expected = "{")
      let (items, end) = parse_import_items(tokens = tokens, pos = br, context = context);
      (SImport(path, qualify_import_items(mod_name = mod_name, items = items)), end)
    } else {
      throw("expected 'only' after 'as <name>' in qualified import")
    },
    _ => throw("expected 'only' after 'as <name>' in qualified import")
  }
}

fn reject_executable_import_path(_ path: String) -> Unit with Exception {
  if String::ends_with(path, suffix = ".vibex") {
    throw(".vibex is an executable root and cannot be imported: \{path}")
  } else {
    ()
  }
}

/// #769: a trailing `import <path> @alias` alias token must be recognized
/// regardless of what the path itself starts with. This used to be checked
/// only on the branch for a path starting with a bare identifier (`import
/// pkg_name @alias`); a path starting with `.`/`..` (the common case for the
/// compiler's own facades, e.g. `import ../../../lib/@vibe/json @json`) fell
/// through the catch-all `_` arm below, which always demanded a `{` next and
/// never looked for an alias — surfacing as "expected { but got ident" once
/// collect_import_path correctly stopped just before the alias token.
fn parse_import_path_tail(tokens: Array[Token], bp: Int, path: String, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = bp) {
    TAs => match peek(tokens = tokens, pos = bp + 1) {
      TIdent(mod_name) => parse_qualified_import_tail(tokens = tokens, pos = bp + 2, path = path, mod_name = mod_name, context = context),
      _ => throw("expected namespace name after 'as' in import")
    },
    TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, at = 0) == '@' {
      let alias_str = String::substring(alias_name, start = 1, end = String::length(alias_name))
      binder_capture_source(context = context, name = alias_str, first_token = bp, last_token = bp)
      (SAliasDecl(alias_str, path), bp + 1)
    } else {
      let br = expect_tk(tokens = tokens, pos = bp, expected = "{")
      let (items, end) = parse_import_items(tokens = tokens, pos = br, context = context);
      (SImport(path, items), end)
    },
    _ => {
      let br = expect_tk(tokens = tokens, pos = bp, expected = "{")
      let (items, end) = parse_import_items(tokens = tokens, pos = br, context = context);
      (SImport(path, items), end)
    }
  }
}

fn parse_import_stmt(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => if name == "symbol" || name == "version" {
      // #2127: `import symbol@...` / `import version@...` are retired
      // specs. Without this, `symbol@fixture/missing` is absorbed as path
      // `symbol` plus an `@alias`, and `{ value }` is then parsed as a
      // top-level record ("move it into fn main") — an edit that cannot help.
      throw("`import \{name}@...` is not a valid import spec -- use `import @scope/pkg { names }` or `import ./path.vibe { names }` at #\{pos}")
    } else if String::length(name) > 1 && String::char_code_at(name, at = 0) == '@' {
      parse_import_path_tail(tokens = tokens, bp = pos + 1, path = name, context = context)
    } else {
      let (path, bp) = collect_import_path(tokens = tokens, pos = pos, acc = "")
      reject_executable_import_path(path)
      parse_import_path_tail(tokens = tokens, bp = bp, path = path, context = context)
    },
    _ => {
      let (path, bp) = collect_import_path(tokens = tokens, pos = pos, acc = "")
      reject_executable_import_path(path)
      parse_import_path_tail(tokens = tokens, bp = bp, path = path, context = context)
    }
  }
}

fn tl_push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {
  if is_mut {
    let (fname, _) = field
    ArrayBuilder::push(mb, value = fname)
  } else {
    ()
  }
}

fn parse_toplevel_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String], context: Option[ParserBinderContext]) -> (Array[(String, TypeExpr)], Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TSemicolon => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),
      _ => {
        let (field, is_mut, next) = parse_struct_field_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
        ArrayBuilder::push(b, value = field)
        tl_push_mut_name(mb = mb, field = field, is_mut = is_mut)
        parse_toplevel_struct_fields_rest(tokens = tokens, pos = next, b = b, mb = mb, context = context)
      }
    },
    // Redundant-syntax removal: ',' is not a declaration-body
    // separator (see parser_base.vibe parse_enum_ctors_rest).
    TComma => throw("use ';' to separate declaration members; ',' is not a separator at #\{pos}"),
    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),
    _ => throw("expected ';' or '}' in struct at #\{pos}")
  }
}

fn parse_toplevel_struct_fields(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[(String, TypeExpr)], Array[String], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TRBrace => (empty_fields(), ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1),
    _ => {
      let (first, is_mut, next) = parse_struct_field_with_binder_context(tokens = tokens, pos = pos, context = context)
      let b = ArrayBuilder::new()
      let mb = ArrayBuilder::new()
      ArrayBuilder::push(b, value = first)
      tl_push_mut_name(mb = mb, field = first, is_mut = is_mut)
      parse_toplevel_struct_fields_rest(tokens = tokens, pos = next, b = b, mb = mb, context = context)
    }
  }
}

fn parse_toplevel_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  binder_capture_mark_ineligible(context)
  match peek(tokens = tokens, pos = pos) {
    TIdent(name) => {
      binder_capture_source(context = context, name = name, first_token = pos, last_token = pos)
      // Optional type-parameter header `struct Foo[T] { ... }`. #829: the
      // param NAMES are kept on the SStruct (they used to be discarded) so
      // the checker can instantiate generic struct literals; representation
      // stays uniform/tagged like enum type params.
      let (tparams, after_name) = parse_tparam_names_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
      let br = expect_tk(tokens = tokens, pos = after_name, expected = "{")
      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens = tokens, pos = br, context = context);
      let (derives, final_pos) = parse_derive_names(tokens = tokens, pos = end)
      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)
    },
    _ => throw("expected struct name")
  }
}

/// ADR-0071 step 2: `effectset Name = { A, B, Effect::op }` / the qualified
/// form `effectset Effect::Name = { ... }` (name itself may be `Ident ::
/// Ident`, same qualification as parse_binding_name). Body reuses
/// collect_effect_names' item grammar (bare identifier or `Effect::op`) --
/// it already returns a comma-joined String, so the member list is
/// recovered by splitting that back into an Array[String]; no separate
/// item-collector needed. No type params yet (generic effectsets like
/// `State::Read[T]` are deferred to a later revision).
fn parse_effectset_stmt(tokens: Array[Token], pos: Int, exported: Bool, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  let (name, after_name) = parse_binding_name_with_binder_context(tokens = tokens, pos = pos, context = context)
  let ep = expect_tk(tokens = tokens, pos = after_name, expected = "=")
  let bp = expect_tk(tokens = tokens, pos = ep, expected = "{")
  let (joined, next) = collect_effect_names(tokens = tokens, pos = bp, acc = "")
  let members = if String::length(joined) == 0 {
    ArrayBuilder::freeze(ArrayBuilder::new())
  } else {
    String::split(joined, sep = ", ")
  }
  (SEffectSet(exported, name, members), next)
}

/// True when the tokens at `pos` (just past the word `resource`) start a
/// resource declaration -- i.e. an identifier follows.
///
/// One token of lookahead, and it is exact rather than heuristic: at STATEMENT
/// position no expression can be two adjacent identifiers. A `resource` used
/// as an ordinary name is always followed by an operator, a delimiter, or
/// nothing (`resource = f()`, `resource(x)`, `resource + 1`), never by another
/// identifier. `effect`/`effectset` claim their word unconditionally; this one
/// does not, because `resource` is a far more plausible variable name.
///
/// Deliberately does NOT also require the `:`, so that `resource S3::Posts :
/// Bucket` (name and kind swapped) still reaches parse_resource_stmt and gets
/// its own diagnostic instead of a generic expression-parse error.
fn is_resource_decl_head(tokens: Array[Token], pos: Int) -> Bool {
  match peek(tokens = tokens, pos = pos) {
    TIdent(_) => true,
    _ => false
  }
}

/// ADR-0075 Phase 2 (#1343 実装順 2): `resource Posts : S3::Bucket`.
///
/// The kind must be QUALIFIED (`Owner::Kind`). That is not cosmetic: an
/// unqualified name here would be indistinguishable from a type, and ADR-0075
/// is explicit that a resource kind is not a type and a resource name is not a
/// `String` to be authority-checked. The qualified form makes every kind read
/// as belonging to some provider (`S3::Bucket`, `Process::Root`).
fn parse_resource_stmt(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  let name = match peek(tokens = tokens, pos = pos) {
    TIdent(n) => {
      binder_capture_source(context = context, name = n, first_token = pos, last_token = pos)
      n
    },
    _ => throw("expected a resource name after 'resource'")
  }
  match peek(tokens = tokens, pos = pos + 1) {
    TDoubleColon => throw("a resource NAME is unqualified (`resource Posts : S3::Bucket`) -- the qualified path goes after the ':' and names the resource KIND (ADR-0075)"),
    _ => ()
  }
  let cp = expect_tk(tokens = tokens, pos = pos + 1, expected = ":")
  let (kind, end) = parse_binding_name(tokens = tokens, pos = cp)
  if !String::contains(kind, needle = "::") {
    throw("resource kind '\{kind}' must be qualified as `Owner::Kind` (e.g. `S3::Bucket`, `Process::Root`) -- an unqualified name would be indistinguishable from a type, and a resource kind is not a type (ADR-0075)")
  } else {
    ()
  }
  (SResource(name, kind), end)
}

fn parse_export_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TLet => parse_let_stmt_with_binder_context(tokens = tokens, starts = starts, pos = pos + 1, exported = true, context = context),
    TEnum => parse_enum_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = true, context = context),
    TSuberror => parse_suberror_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = true, context = context),
    TStruct => parse_toplevel_struct_stmt(tokens = tokens, pos = pos + 1, exported = true, context = context),
    // #1280: `fn` lexes as TFn (reserved word), no longer TIdent("fn").
    TFn => parse_fn_stmt_with_binder_context(tokens = tokens, starts = starts, pos = pos + 1, exported = true, context = context),
    TIdent(ident_name) => if ident_name == "effect" {
      parse_effect_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = true, context = context)
    } else if ident_name == "effectset" {
      parse_effectset_stmt(tokens = tokens, pos = pos + 1, exported = true, context = context)
    } else if ident_name == "resource" && is_resource_decl_head(tokens = tokens, pos = pos + 1) {
      throw("a `resource` declaration cannot be exported: ADR-0075 puts it at the `.vibex` root only, and a reusable module abstracts over a resource KIND parameter instead of naming a resource")
    } else {
      throw(String::concat("unexpected token in export: ", ident_name))
    },
    TType => parse_type_alias_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = true, context = context),
    TTrait => parse_trait_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = true, context = context),
    TOpen => match peek(tokens = tokens, pos = pos + 1) {
      TTrait => parse_trait_stmt_with_binder_context(tokens = tokens, pos = pos + 2, exported = true, context = context),
      _ => throw("expected 'trait' after 'open'")
    },
    TLBrace => match peek(tokens = tokens, pos = pos + 1) {
      TRBrace => (SExport(empty_names()), pos + 2),
      TIdent(_) => {
        let (first, after) = parse_export_name(tokens = tokens, pos = pos + 1)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, value = first)
        let (names, end) = parse_export_names_rest(tokens = tokens, pos = after, b = b);
        (SExport(names), end)
      },
      _ => throw("expected name in export list")
    },
    TDot => {
      let (path, bp) = collect_import_path(tokens = tokens, pos = pos, acc = "")
      reject_executable_import_path(path)
      let br = expect_tk(tokens = tokens, pos = bp, expected = "{")
      // Re-export items name the dependency's public surface; unlike import
      // items, neither their source names nor aliases bind locals here.
      let (items, end) = parse_import_items(tokens = tokens, pos = br, context = None);
      (SReExport(path, items), end)
    },
    // #769: `export ../foo/index.vibe { .. }` (a re-export that climbs OUT of
    // the current directory, as used by entry/compiler/index.vibe) is exactly
    // as valid an import-path start as `export ./foo { .. }` — only the
    // single-dot case was wired up here, so a leading `..` fell through to
    // the catch-all "unexpected after 'export'" error.
    TDotDot => {
      let (path, bp) = collect_import_path(tokens = tokens, pos = pos, acc = "")
      reject_executable_import_path(path)
      let br = expect_tk(tokens = tokens, pos = bp, expected = "{")
      // Re-export items name the dependency's public surface; unlike import
      // items, neither their source names nor aliases bind locals here.
      let (items, end) = parse_import_items(tokens = tokens, pos = br, context = None);
      (SReExport(path, items), end)
    },
    _ => {
      let actual = tk_name(peek(tokens = tokens, pos = pos))
      throw("unexpected after 'export': \{actual}")
    }
  }
}

fn parse_percent_symbol_name(tokens: Array[Token], pos: Int, label: String, context: Option[ParserBinderContext]) -> (String, Int) with Exception {
  let pp = expect_tk(tokens = tokens, pos = pos, expected = "%")
  match peek(tokens = tokens, pos = pp) {
    TIdent(name) => {
      let full_name = "%\{name}"
      binder_capture_source(context = context, name = full_name, first_token = pos, last_token = pp)
      (full_name, pp + 1)
    },
    _ => throw("expected \{label} after '%'")
  }
}

fn parse_extern_let_stmt(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  let lp = expect_tk(tokens = tokens, pos = pos, expected = "let")
  let (name, np) = parse_percent_symbol_name(tokens = tokens, pos = lp, label = "extern symbol name", context = context)
  let cp = expect_tk(tokens = tokens, pos = np, expected = ":")
  let (ty, end) = parse_type(tokens = tokens, pos = cp);
  (SExternLet(name, ty), end)
}

/// Statement parser that KEEPS `fn` declarations in declaration form
/// (SFnDecl, contracts un-desugared) — the input to printer/normalize
/// round-tripping (ADR-0064 #727). Everything that feeds the checker or
/// codegen should use `parse_stmt` / `parse_program*` below, which lower
/// SFnDecl to the legacy SLet shape.
export fn parse_stmt_preserving_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  // A `let` that threw mid-initializer must not leave its arming for the
  // next statement's first lambda (ADR-0120 D3).
  let _ = disarm_lambda_positional()
  let raw_head = peek(tokens = tokens, pos = pos)
  // #1343: rewrite `resource` to a name no identifier can have UNLESS it
  // starts a declaration, so the dispatch below routes `resource = f()` /
  // `resource(x)` to its expression arm unchanged. Done on the token rather
  // than as an extra arm because that arm is a ~60-line block of
  // assignment-operator handling with no way to fall through into it.
  let head = match raw_head {
    TIdent(hn) => if hn == "resource" && !is_resource_decl_head(tokens = tokens, pos = pos + 1) {
      TIdent("")
    } else {
      raw_head
    },
    _ => raw_head
  }
  match head {
    TLet => parse_let_stmt_with_binder_context(tokens = tokens, starts = starts, pos = pos + 1, exported = false, context = context),
    TExport => match peek(tokens = tokens, pos = pos + 1) {
      // ADR-0063 Phase B (#728): module blocks are removed.
      TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
      _ => parse_export_stmt(tokens = tokens, starts = starts, pos = pos + 1, context = context)
    },
    TModule => throw("'module' blocks are removed (#728); use file boundaries + import/export"),
    TEnum => parse_enum_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = false, context = context),
    TSuberror => parse_suberror_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = false, context = context),
    TStruct => parse_toplevel_struct_stmt(tokens = tokens, pos = pos + 1, exported = false, context = context),
    TType => parse_type_alias_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = false, context = context),
    TTrait => parse_trait_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = false, context = context),
    TTest => parse_test_stmt(tokens = tokens, starts = starts, pos = pos + 1, context = context),
    TExample => parse_example_stmt(tokens = tokens, starts = starts, pos = pos + 1, context = context),
    TBench => parse_bench_stmt(tokens = tokens, starts = starts, pos = pos + 1, context = context),
    TImport => parse_import_stmt(tokens = tokens, pos = pos + 1, context = context),
    // #1280: `fn` lexes as TFn (reserved word), no longer TIdent("fn").
    TFn => parse_fn_stmt_with_binder_context(tokens = tokens, starts = starts, pos = pos + 1, exported = false, context = context),
    TIdent(name) => match name {
      "effect" => parse_effect_stmt_with_binder_context(tokens = tokens, pos = pos + 1, exported = false, context = context),
      "effectset" => parse_effectset_stmt(tokens = tokens, pos = pos + 1, exported = false, context = context),
      "resource" => parse_resource_stmt(tokens = tokens, pos = pos + 1, context = context),
      "extern" => parse_extern_let_stmt(tokens = tokens, pos = pos + 1, context = context),
      "use" => throw("'use' syntax is removed; use 'import <module-ref> { ... }'"),
      _ => {
        let (e, next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = pos, mode = 0, context = context)
        match peek(tokens = tokens, pos = next) {
          TEq => match source_expr(e) {
            EIdent(name, target_at) => {
              let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
              source_record_slot(kind = "target", name = name, first = pos, next = pos + 1, context = context)
              (SExpr(source_wrap_expr(expr = EAssign(name, val, EUnit, target_at), first = pos, next = vn, context = context)), vn)
            },
            ECall(idx_callee, idx_args, _, callee_resolution) => {
              // `arr[i] = v` at statement level: `__index(arr, i)` receiver
              // desugars to Array::set (same as the block-expr TEq arm).
              let is_index = match source_expr(idx_callee) {
                EIdent(icn, _) => icn == "__index",
                _ => false
              }
              if is_index && Array::length(idx_args) == 2 {
                let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
                let set_args = ArrayBuilder::freeze(ArrayBuilder::new())
                Array::push(set_args, value = Array::get(idx_args, at = 0))
                Array::push(set_args, value = Array::get(idx_args, at = 1))
                Array::push(set_args, value = val)
                (SExpr(source_wrap_expr(expr = ECall(index_write_callee(source_expr(idx_callee)), set_args, -1, callee_resolution), first = pos, next = vn, context = context)), vn)
              } else {
                (SExpr(e), next)
              }
            },
            _ => (SExpr(e), next)
          },
          TPlusEq => match source_expr(e) {
            EIdent(name, target_at) => {
              let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
              source_record_slot(kind = "target", name = name, first = pos, next = pos + 1, context = context)
              (SExpr(source_wrap_expr(expr = EAssignOp(name, "+", val, EUnit, target_at), first = pos, next = vn, context = context)), vn)
            },
            _ => (SExpr(e), next)
          },
          TMinusEq => match source_expr(e) {
            EIdent(name, target_at) => {
              let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
              source_record_slot(kind = "target", name = name, first = pos, next = pos + 1, context = context)
              (SExpr(source_wrap_expr(expr = EAssignOp(name, "-", val, EUnit, target_at), first = pos, next = vn, context = context)), vn)
            },
            _ => (SExpr(e), next)
          },
          TStarEq => match source_expr(e) {
            EIdent(name, target_at) => {
              let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
              source_record_slot(kind = "target", name = name, first = pos, next = pos + 1, context = context)
              (SExpr(source_wrap_expr(expr = EAssignOp(name, "*", val, EUnit, target_at), first = pos, next = vn, context = context)), vn)
            },
            _ => (SExpr(e), next)
          },
          TSlashEq => match source_expr(e) {
            EIdent(name, target_at) => {
              let (val, vn) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = next + 1, mode = 0, context = context)
              source_record_slot(kind = "target", name = name, first = pos, next = pos + 1, context = context)
              (SExpr(source_wrap_expr(expr = EAssignOp(name, "/", val, EUnit, target_at), first = pos, next = vn, context = context)), vn)
            },
            _ => (SExpr(e), next)
          },
          _ => (SExpr(e), next)
        }
      }
    },
    _ => {
      let (e, next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = pos, mode = 0, context = context);
      (SExpr(e), next)
    }
  }
}

export fn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with Exception {
  parse_stmt_preserving_with_binder_context(tokens = tokens, starts = starts, pos = pos, context = None)
}

/// Default statement entry: identical to parse_stmt_preserving except that a
/// `fn` declaration is lowered to the legacy `SLet(exported, true, name,
/// None, EFn(..))` shape with its where-contract desugared to runtime
/// asserts — i.e. exactly what this function returned before #727 kept the
/// declaration form. All existing consumers (checker, codegen, symbols,
/// contract engine, ...) keep seeing the pre-#727 AST.
export fn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with Exception {
  let (stmt, next) = parse_stmt_preserving(tokens = tokens, starts = starts, pos = pos)
  (lower_fn_decl_stmt(stmt), next)
}

export fn parse_stmt_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, context: Option[ParserBinderContext]) -> (Stmt, Int) with Exception {
  let (stmt, next) = parse_stmt_preserving_with_binder_context(tokens = tokens, starts = starts, pos = pos, context = context)
  (lower_fn_decl_stmt_with_binder_context(stmt = stmt, context = context), next)
}

/// Expand an impl body `{ method(params) -> ret { body } ... }` into the impl
/// marker plus one `let Type::method = (params) -> ret { body }` per method
/// (#641 Phase 1: concrete-receiver dispatch). Trait stays marker-only; the
/// methods become ordinary qualified free functions resolved by name. `pos` is
/// at the body `{` (or the next token for a body-less impl). Needs `parse_expr`,
/// which is why this lives here rather than in parser_base.
// `starts` are the token offsets. Only the tooling parse (a binder context)
// reads them here: it records each method body's source ranges, which `vibe
// mutants` and the span queries need. A compile parse keeps passing none, so
// the AST it hands the checker and codegen is unchanged.
fn parse_impl_methods(tokens: Array[Token], starts: Array[Int], pos: Int, simpl: Stmt, context: Option[ParserBinderContext]) -> (Array[Stmt], Int) with Exception {
  let method_starts = match context {
    Some(_) => starts,
    None => []
  }
  let out = ArrayBuilder::new()
  ArrayBuilder::push(out, value = simpl)
  match peek(tokens = tokens, pos = pos) {
    TLBrace => {
      let impl_trait = match simpl {
        SImpl(_, _, trait_name, _) => trait_name,
        _ => ""
      }
      let impl_target = match simpl {
        SImpl(_, _, _, target) => target,
        _ => TyName("")
      }
      // A generic impl `impl [T: Bound] Trait for C { method(self){..} }` binds
      // `T` (and its bound) over each method body, so inject the impl's type
      // parameters + bounds into every method's `EFn`. This lets the body
      // dispatch `T::m(elem)` (resolved via the threaded witness dict, #5
      // Increment B). Non-generic impls have an empty list → methods unchanged.
      let impl_tparams = match simpl {
        SImpl(tp, _, _, _) => tp,
        _ => ArrayBuilder::freeze(ArrayBuilder::new())
      }
      let impl_tbounds = match simpl {
        SImpl(_, tb, _, _) => tb,
        _ => ArrayBuilder::freeze(ArrayBuilder::new())
      }
      let mut p = pos + 1
      let mut done = false
      while !done {
        match peek(tokens = tokens, pos = p) {
          TRBrace => {
            p = p + 1
            done = true
          },
          TIdent(mname) => {
            let (efn_written, p2) = parse_impl_with_binder_context(tokens = tokens, starts = method_starts, pos = p + 1, mode = 0, context = context)
            // #3573: `Self` in the method's signature is the impl's target.
            let efn = match source_expr(efn_written) {
              EFn(mtp, mtb, mparams, mret, meff, mbody) => if impl_self_spellable(impl_tparams = impl_tparams, target = impl_target, method_tparams = mtp) {
                let as_target = (te: TypeExpr) -> TypeExpr {
                  impl_self_as_target(te = te, target = impl_target)
                }
                source_rewrap_expr(original = efn_written, replacement = EFn(mtp, mtb, for mp in mparams {
                  let (pname, pann) = mp
                  (pname, match pann {
                    Some(te) => Some(as_target(te)),
                    None => None
                  })
                }, match mret {
                  Some(te) => Some(as_target(te)),
                  None => None
                }, meff, mbody))
              } else {
                efn_written
              },
              _ => efn_written
            }
            let efn2 = if Array::length(impl_tparams) > 0 {
              match source_expr(efn) {
                EFn(mtp, mtb, mparams, mret, meff, mbody) => source_rewrap_expr(original = efn, replacement = EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody)),
                _ => efn
              }
            } else {
              efn
            }
            let qname = impl_method_binding_name(tparams = impl_tparams, trait_name = impl_trait, target = impl_target, method = mname)
            ArrayBuilder::push(out, value = SLet(false, true, qname, None, efn2))
            p = match peek(tokens = tokens, pos = p2) {
              TSemicolon => p2 + 1,
              _ => p2
            }
          },
          _ => throw("expected impl method name or '}'")
        }
      }
      (ArrayBuilder::freeze(out), p)
    },
    _ => (ArrayBuilder::freeze(out), pos)
  }
}

// Compile-time conditional compilation (#cfg). A top-level statement may be
// prefixed with `#cfg(flag)`; the statement is KEPT only when `flag` is
// active, and otherwise parsed (syntax must stay valid, like Rust's cfg) and
// DISCARDED before checking/codegen -- so disabled debug code adds zero bytes
// to the output. Flags are activated by `#cfg_enable(flag)` directives, which
// the CLI appends to the source when `VIBE_CFG=flag1,flag2` is set (appending
// at the END keeps every source offset -- and thus diagnostics -- unchanged).
// A pre-scan collects the active set so `#cfg_enable` position is irrelevant.
//
// The active set is the union of two sources: the `#cfg_enable` directives in
// the file itself, and the AMBIENT set below, which the CLI fills once per
// process from `VIBE_CFG` (#2513). Before the ambient set existed the flags
// reached only the entry file: the CLI appended `#cfg_enable` to the entry
// source, and every imported module scanned its own token stream, saw no
// directive, and dropped all of its `#cfg` statements whatever `VIBE_CFG`
// said. A dependency that spells `#cfg(dev) export fn f` could therefore
// never be imported. The same set has to be part of every persistent cache
// key (persistent_cache_version_tag folds it in), or a module parsed under
// one flag set is replayed under another.
//
// The compiler's own sources may use `#cfg`: `scripts/generate_bundle.sh`
// flattens the self-build with the COMMITTED SEED's module-source emission,
// and the seed resolves the directives in `parse_program_spans` since
// seed/cfg-spans-emission-2026-09-04 (#2497 step 0).

let cfg_ambient_flags: Array[String] = []

let cfg_ambient_flags_csv_cell: Array[String] = [""]

/// Replace the process-wide ambient `#cfg` flag set. Called once per CLI
/// invocation from the environment; every subsequent parse of any module
/// treats these flags as active in addition to the file's own `#cfg_enable`.
export fn set_cfg_ambient_flags(_ flags: Array[String]) -> Unit {
  Array::truncate(cfg_ambient_flags, length = 0)
  let mut i = 0
  while i < Array::length(flags) {
    Array::push(cfg_ambient_flags, value = Array::get(flags, at = i))
    i = i + 1
  }
  Array::set(cfg_ambient_flags_csv_cell, at = 0, value = String::join(flags, sep = ","))
}

/// The ambient set as one string, in the caller's order (the same spelling
/// the persistent caches namespace by, #2513). A parse is a function of the
/// text AND this set, so anything that remembers a parse across calls keys on
/// both (#2386's loader memos, Codex review on #2520).
export fn cfg_ambient_flags_csv() -> String {
  Array::get(cfg_ambient_flags_csv_cell, at = 0)
}

/// Parse the directive after a THash: `cfg(name)`, `cfg_enable(name)`,
/// `zero_alloc`, or `deprecated` (#1262 ADR-0101 migration marker; optional
/// `("message")` argument). Returns (directive_kind, payload, next_pos).
fn parse_cfg_directive(tokens: Array[Token], pos: Int) -> (String, String, Int) with Exception {
  // A directive stands on its own line above the declaration it marks, so
  // the lexer's synthetic line `;` (#3546) may follow it.
  let (kind, payload, next) = parse_cfg_directive_tokens(tokens = tokens, pos = pos)
  (kind, payload, skip_semi(tokens = tokens, pos = next))
}

fn parse_cfg_directive_tokens(tokens: Array[Token], pos: Int) -> (String, String, Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TIdent(dname) => {
      if dname == "cfg" || dname == "cfg_enable" {
        match peek(tokens = tokens, pos = pos + 1) {
          TLParen => match peek(tokens = tokens, pos = pos + 2) {
            TIdent(flag) => match peek(tokens = tokens, pos = pos + 3) {
              TRParen => (dname, flag, pos + 4),
              _ => throw("expected ')' after #cfg flag name")
            },
            _ => throw("expected flag name in #cfg(...)")
          },
          _ => throw("expected '(' after #cfg")
        }
      } else if dname == "zero_alloc" {
        match peek(tokens = tokens, pos = pos + 1) {
          TLParen => match peek(tokens = tokens, pos = pos + 2) {
            TIdent(mode) => match peek(tokens = tokens, pos = pos + 3) {
              TRParen => if mode == "strict" || mode == "assume" {
                (dname, mode, pos + 4)
              } else {
                throw(String::concat("#zero_alloc unknown mode '", String::concat(mode, "'; use (strict) or (assume)")))
              },
              _ => throw("expected ')' after #zero_alloc mode")
            },
            _ => throw("expected #zero_alloc mode name (strict or assume)")
          },
          _ => (dname, "", pos + 1)
        }
      } else if dname == "deprecated" {
        match peek(tokens = tokens, pos = pos + 1) {
          TLParen => match peek(tokens = tokens, pos = pos + 2) {
            TString(msg) => match peek(tokens = tokens, pos = pos + 3) {
              TRParen => (dname, msg, pos + 4),
              _ => throw("expected ')' after #deprecated message")
            },
            _ => throw("expected string message in #deprecated(...)")
          },
          _ => (dname, "", pos + 1)
        }
      } else {
        throw(String::concat("unknown # directive: ", dname))
      }
    },
    _ => throw("expected directive name after '#'")
  }
}

/// Pre-scan the whole token stream for `#cfg_enable(name)` directives and
/// return the active flag set: the ambient set first, then the file's own
/// directives. O(tokens), with one fresh result allocation; the result does
/// not grow unless a THash enables a flag or the ambient set is non-empty.
fn cfg_scan_enabled(_ tokens: Array[Token]) -> Array[String] with Exception {
  let out = ArrayBuilder::freeze(ArrayBuilder::new())
  let mut a = 0
  while a < Array::length(cfg_ambient_flags) {
    Array::push(out, value = Array::get(cfg_ambient_flags, at = a))
    a = a + 1
  }
  let mut i = 0
  let n = Array::length(tokens)
  while i < n {
    match Array::get(tokens, at = i) {
      THash => {
        let (dname, flag, next) = parse_cfg_directive(tokens = tokens, pos = i + 1)
        if dname == "cfg_enable" {
          Array::push(out, value = flag)
        } else {
          ()
        }
        i = next
      },
      _ => {
        i = i + 1
      }
    }
  }
  out
}

/// `cfg_scan_enabled` for the located parsers: a malformed directive
/// (`#cfg(`, an unknown `#name`) throws before any per-statement locator
/// runs, and its message carries no position, so the locator is applied here
/// at the directive's own `#` (Codex on #3047). A separate loop rather than a
/// flag on the one above: that one runs on every tokens-only parse, and an
/// extra argument there showed up in parser_bench's B/op.
fn cfg_scan_enabled_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[String] with Exception {
  let out = ArrayBuilder::freeze(ArrayBuilder::new())
  let mut a = 0
  while a < Array::length(cfg_ambient_flags) {
    Array::push(out, value = Array::get(cfg_ambient_flags, at = a))
    a = a + 1
  }
  let mut i = 0
  let n = Array::length(tokens)
  while i < n {
    match Array::get(tokens, at = i) {
      THash => {
        let hash_pos = i
        let (dname, flag, next) = handle {
          parse_cfg_directive(tokens = tokens, pos = i + 1)
        } with { Exception::Throw(msg) => {
          throw(locate_parse_error(msg = msg, fallback_pos = hash_pos, starts = starts, source = source))
        } }
        if dname == "cfg_enable" {
          Array::push(out, value = flag)
        } else {
          ()
        }
        i = next
      },
      _ => {
        i = i + 1
      }
    }
  }
  out
}

#zero_alloc
fn cfg_flag_active(active: Array[String], flag: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(active) {
    if Array::get(active, at = i) == flag {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Canonical allocation contracts attach to exactly one declaration. Reject
/// any other placement while the files are still separate, so a marker at
/// one file's EOF can never bind to the first function of a linked file.
fn zero_alloc_target_is_fn(tokens: Array[Token], pos: Int) -> Bool {
  match peek(tokens = tokens, pos = pos) {
    TFn => true,
    TExport => match peek(tokens = tokens, pos = pos + 1) {
      TFn => true,
      _ => false
    },
    _ => false
  }
}

fn require_zero_alloc_target(tokens: Array[Token], pos: Int) -> Unit with Exception {
  if zero_alloc_target_is_fn(tokens = tokens, pos = pos) {
    ()
  } else {
    throw("#zero_alloc must immediately precede a fn declaration")
  }
}

fn zero_alloc_marker_ident(_ mode: String) -> String {
  if mode == "strict" {
    "@zero_alloc_strict"
  } else if mode == "assume" {
    "@zero_alloc_assume"
  } else {
    "@zero_alloc"
  }
}

/// One top-level statement of the preserving parse: an `impl` block expands
/// to its method statements, anything else is a single statement.
fn parse_preserving_top_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Array[Stmt], Int) with Exception {
  match peek(tokens = tokens, pos = pos) {
    TImpl => {
      let (simpl, hp) = parse_impl_stmt_dispatch(tokens = tokens, pos = pos + 1)
      parse_impl_methods(tokens = tokens, starts = [], pos = hp, simpl = simpl, context = None)
    },
    _ => {
      let (stmt, n) = parse_stmt_preserving(tokens = tokens, starts = starts, pos = pos)
      ([stmt], n)
    }
  }
}

/// Program parser that KEEPS `fn` declarations as SFnDecl (see
/// parse_stmt_preserving) — used by the printer/normalize round-trip so
/// `vibe normalize` re-emits `fn name(..) -> T where { .. } { .. }` instead
/// of rewriting it to `let rec` form (ADR-0064 #727).
///
/// The parse's two logs -- the qualified-pattern refs and the `test` /
/// `bench` / `example` rows (#1508, ADR-0088) -- are folded into their
/// trailing markers at the end, exactly as `parse_program` folds them: this
/// entry used to return without draining either, so the rows a block
/// declared never reached the printer (`vibe normalize` dropped them) and
/// leaked into the NEXT parse's marker instead (Codex review on PR #2653).
/// `parse_program` runs its own fold after lowering, which then finds the
/// logs already drained; the markers were appended last here and the
/// lowerings keep statement order, so they stay last.
export fn parse_program_preserving(_ tokens: Array[Token]) -> Array[Stmt] with Exception {
  reset_pattern_refs()
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens = tokens, pos = pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        let (dname, flag, dnext) = parse_cfg_directive(tokens = tokens, pos = pos + 1)
        if dname == "zero_alloc" {
          require_zero_alloc_target(tokens = tokens, pos = dnext)
          ArrayBuilder::push(b, value = SExpr(EIdent(zero_alloc_marker_ident(flag), 0)))
          pos = dnext
        } else if dname == "deprecated" || dname == "cfg_enable" || cfg_flag_active(active = cfg_active, flag = flag) {
          // enable directive consumed, or active #cfg: keep the next stmt.
          pos = dnext
        } else {
          // Inactive #cfg: parse the guarded statement and discard it.
          let ref_mark = pattern_ref_mark()
          let slot_mark = positional_params_mark()
          match peek(tokens = tokens, pos = dnext) {
            TImpl => {
              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens = tokens, pos = dnext + 1)
              let (_dropped, dn) = parse_impl_methods(tokens = tokens, starts = [
              ], pos = hp_d, simpl = simpl_d, context = None)
              pos = dn
            },
            _ => {
              let (_dropped, dn) = parse_stmt_preserving(tokens = tokens, starts = [
              ], pos = dnext)
              pos = dn
            }
          }
          restore_pattern_refs(ref_mark)
          restore_positional_params(slot_mark)
        }
      },
      TImpl => {
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens = tokens, pos = pos + 1)
        let (impl_stmts, next) = parse_impl_methods(tokens = tokens, starts = [], pos = hp, simpl = simpl, context = None)
        let mut ii = 0
        while ii < Array::length(impl_stmts) {
          ArrayBuilder::push(b, value = Array::get(impl_stmts, at = ii))
          ii = ii + 1
        }
        pos = next
      },
      _ => {
        let (stmt, next) = parse_stmt_preserving(tokens = tokens, starts = [], pos = pos)
        ArrayBuilder::push(b, value = stmt)
        pos = next
      }
    }
  }
  // Copied before the markers are appended, so the builder's frozen result
  // is never pushed to -- and only when there is a marker to append: the
  // common program has neither log, and the copy showed up as a +2% B/op
  // drift on parser_bench's parse_deep_binop_chain.
  let raw = ArrayBuilder::freeze(b)
  if has_test_effect_rows() || has_qualified_pattern_refs() || has_positional_params() {
    attach_qualified_pattern_refs(Array::slice(raw, start = 0, end = Array::length(raw)))
  } else {
    raw
  }
}

/// `parse_program_preserving` with positions (#2948): the statements keep
/// `fn` as SFnDecl, and a syntax error carries `line L:col C:` exactly as
/// `parse_program_located` reports it. A `.vibex` entry is validated on the
/// preserving shape (ADR-0075 inspects SFnDecl / SExport, which the located
/// parser lowers away), and that validation parse used to take tokens only --
/// so its parse errors had no position, and a token index encoded as `at #N`
/// reached the reader verbatim.
export fn parse_program_preserving_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with Exception {
  parse_program_preserving_impl(tokens = tokens, starts = starts, source = source, located = true)
}

/// One `#name` directive at `pos` for the located preserving parse: pushes
/// what it keeps into `b` and answers the position after it (an inactive
/// `#cfg` consumes -- and so parses -- the statement it guards).
fn preserving_cfg_directive(tokens: Array[Token], starts: Array[Int], pos: Int, cfg_active: Array[String], b: ArrayBuilder[Stmt]) -> Int with Exception {
  let (dname, flag, dnext) = parse_cfg_directive(tokens = tokens, pos = pos + 1)
  if dname == "zero_alloc" {
    require_zero_alloc_target(tokens = tokens, pos = dnext)
    ArrayBuilder::push(b, value = SExpr(EIdent(zero_alloc_marker_ident(flag), 0)))
    dnext
  } else if dname == "deprecated" || dname == "cfg_enable" || cfg_flag_active(active = cfg_active, flag = flag) {
    dnext
  } else {
    let ref_mark = pattern_ref_mark()
    let slot_mark = positional_params_mark()
    let dn = match peek(tokens = tokens, pos = dnext) {
      TImpl => {
        let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens = tokens, pos = dnext + 1)
        let (_dropped, dn) = parse_impl_methods(tokens = tokens, starts = [], pos = hp_d, simpl = simpl_d, context = None)
        dn
      },
      _ => {
        let (_dropped, dn) = parse_stmt_preserving(tokens = tokens, starts = starts, pos = dnext)
        dn
      }
    }
    restore_pattern_refs(ref_mark)
    restore_positional_params(slot_mark)
    dn
  }
}

fn parse_program_preserving_impl(tokens: Array[Token], starts: Array[Int], source: String, located: Bool) -> Array[Stmt] with Exception {
  reset_pattern_refs()
  if located {
    remember_parse_source(source)
  } else {
    ()
  }
  let cfg_active = if located {
    cfg_scan_enabled_located(tokens = tokens, starts = starts, source = source)
  } else {
    cfg_scan_enabled(tokens)
  }
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens = tokens, pos = pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // An inactive `#cfg` still parses the statement it guards, so its
        // syntax error is located like any other statement's (Codex on
        // #3047 -- it used to escape the wrapper with a bare `at #N`).
        let start_pos = pos
        pos = if located {
          handle {
            preserving_cfg_directive(tokens = tokens, starts = starts, pos = pos, cfg_active = cfg_active, b = b)
          } with { Exception::Throw(msg) => {
            throw(locate_parse_error(msg = msg, fallback_pos = start_pos, starts = starts, source = source))
          } }
        } else {
          preserving_cfg_directive(tokens = tokens, starts = starts, pos = pos, cfg_active = cfg_active, b = b)
        }
      },
      _ => if located {
        // Same per-statement wrapper as `parse_program_located`, so both
        // lanes name the same position for the same error.
        let start_pos = pos
        let (stmts, next) = handle {
          parse_preserving_top_stmt(tokens = tokens, starts = starts, pos = pos)
        } with { Exception::Throw(msg) => {
          throw(locate_parse_error(msg = msg, fallback_pos = start_pos, starts = starts, source = source))
        } }
        let mut ii = 0
        while ii < Array::length(stmts) {
          ArrayBuilder::push(b, value = Array::get(stmts, at = ii))
          ii = ii + 1
        }
        pos = next
      } else {
        // The tokens-only path (every `parse_program`) keeps its original
        // shape: no handler and no per-statement array.
        match peek(tokens = tokens, pos = pos) {
          TImpl => {
            let (simpl, hp) = parse_impl_stmt_dispatch(tokens = tokens, pos = pos + 1)
            let (impl_stmts, next) = parse_impl_methods(tokens = tokens, starts = [
            ], pos = hp, simpl = simpl, context = None)
            let mut ii = 0
            while ii < Array::length(impl_stmts) {
              ArrayBuilder::push(b, value = Array::get(impl_stmts, at = ii))
              ii = ii + 1
            }
            pos = next
          },
          _ => {
            let (stmt, next) = parse_stmt_preserving(tokens = tokens, starts = [
            ], pos = pos)
            ArrayBuilder::push(b, value = stmt)
            pos = next
          }
        }
      }
    }
  }
  // Copied before the markers are appended, so the builder's frozen result
  // is never pushed to -- and only when there is a marker to append: the
  // common program has neither log, and the copy showed up as a +2% B/op
  // drift on parser_bench's parse_deep_binop_chain.
  let raw = ArrayBuilder::freeze(b)
  if has_test_effect_rows() || has_qualified_pattern_refs() || has_positional_params() {
    attach_qualified_pattern_refs(Array::slice(raw, start = 0, end = Array::length(raw)))
  } else {
    raw
  }
}

/// #1455 step 3: fold the qualified-variant-pattern log this parse produced
/// into a trailing `SQualifiedPatternRefs` marker, so the pairs travel WITH the
/// statement array instead of sitting in parser state.
///
/// That placement is what makes the check survive two things a process-global
/// log did not. `runtime/typecheck_fs.vibe`'s `parse_program_with_path`
/// memoizes statements by `(path, exact source)` and hands out a copy WITHOUT
/// re-running the parser, so a re-check would have found an already-drained
/// log and skipped validation silently; and a parse whose module is never
/// type-checked (`vibe fmt`, an LSP buffer) would have left its pairs for some
/// later, unrelated check to report against its own enums. Draining here ends
/// the log's life at the end of the parse that filled it.
///
/// Appended LAST so no existing statement index moves (the checker's capture
/// paths and `reorder_type_decls_first` are index-based), and omitted entirely
/// when the parse saw no qualified pattern.
fn attach_qualified_pattern_refs(_ stmts: Array[Stmt]) -> Array[Stmt] {
  // Emptiness first: the drain allocates even when it has nothing to hand
  // back, and a program with no qualified pattern is the common case.
  let with_refs = if has_qualified_pattern_refs() {
    Array::push(stmts, value = SQualifiedPatternRefs(take_qualified_pattern_refs()))
    stmts
  } else {
    stmts
  }
  // #1508: same placement rule -- appended LAST so no existing statement index
  // moves, and omitted entirely when no test declared a row.
  let with_rows = if has_test_effect_rows() {
    Array::push(with_refs, value = STestEffectRows(take_test_effect_rows()))
    with_refs
  } else {
    with_refs
  }
  // ADR-0120 D3 (#3681): the same placement rule, for `_` parameter slots.
  if has_positional_params() {
    Array::push(with_rows, value = SPositionalParams(take_positional_params()))
    with_rows
  } else {
    with_rows
  }
}

/// Default program entry: `fn` declarations lowered to the legacy SLet shape
/// (where-contracts desugared to runtime asserts) — the exact pre-#727
/// output, so every checker/codegen consumer is unchanged.
export fn parse_program(_ tokens: Array[Token]) -> Array[Stmt] with Exception {
  attach_qualified_pattern_refs(expand_top_level_pattern_lets(lower_fn_decl_stmts(parse_program_preserving(tokens))))
}

/// Like parse_program but, on a syntax error, prefixes the message with the
/// failing statement's `line:col` (from `lex_with_offsets` token start offsets).
/// Per-statement wrapping keeps the change local. Build the prefix with
/// String::concat (not `+` or interpolation) to avoid selfhost string-concat
/// NUL fragility. Source-span foundation: located parse diagnostics.
/// #816: in-body parse errors still carry the failing TOKEN index as "at #N"
/// (expect_tk and the remaining encode sites). Decode it so recovery and the
/// located wrapper anchor at the OFFENDING token instead of the enclosing
/// statement's start. Converted unexpected-token throws keep that index in
/// `last_unexpected_token_pos` rather than the user-facing message.
fn extract_err_token_pos(msg: String, fallback_pos: Int) -> (Int, String) {
  let mi = String::index_of(msg, needle = " at #")
  if mi < 0 {
    if String::index_of(msg, needle = "unexpected token") >= 0 {
      let remembered = last_unexpected_token_pos()
      if remembered >= 0 {
        (remembered, msg)
      } else {
        (fallback_pos, msg)
      }
    } else {
      (fallback_pos, msg)
    }
  } else {
    let mlen = String::length(msg)
    let mut di = mi + 5
    let mut n = 0
    let mut any = false
    let mut scanning = true
    while scanning {
      if di < mlen {
        let ch = String::char_code_at(msg, at = di)
        if ch >= 48 && ch <= 57 {
          n = n * 10 + (ch - 48)
          any = true
          di = di + 1
        } else {
          scanning = false
        }
      } else {
        scanning = false
      }
    }
    if !any {
      (fallback_pos, msg)
    } else {
      let head = String::substring(msg, start = 0, end = mi)
      let tail = String::substring(msg, start = di, end = mlen)
      let joined = String::concat(head, tail)
      let pi = String::index_of(joined, needle = " (prev=")
      let cleaned = if pi >= 0 {
        String::substring(joined, start = 0, end = pi)
      } else {
        joined
      }
      (n, cleaned)
    }
  }
}

/// Prefix `line L:col C:` when the throw site has not already located the
/// message. Located unexpected-token throws emit the final form themselves;
/// re-prefixing those would double the location (`line 3:1: line 2:32: ...`).
fn locate_parse_error(msg: String, fallback_pos: Int, starts: Array[Int], source: String) -> String {
  if String::index_of(msg, needle = "line ") == 0 {
    msg
  } else {
    let (err_pos, cleaned_msg) = extract_err_token_pos(msg = msg, fallback_pos = fallback_pos)
    let anchor_pos = if err_pos < Array::length(starts) {
      err_pos
    } else {
      fallback_pos
    }
    let off = if anchor_pos < Array::length(starts) {
      Array::get(starts, at = anchor_pos)
    } else {
      0
    }
    let (line, col) = offset_to_line_col(source = source, offset = off)
    let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
    String::concat(loc, cleaned_msg)
  }
}

fn parse_program_located_with_context_impl(tokens: Array[Token], starts: Array[Int], source: String, context: Option[ParserBinderContext]) -> (Array[Stmt], Int) with Exception {
  reset_pattern_refs()
  remember_parse_source(source)
  let cfg_active = cfg_scan_enabled_located(tokens = tokens, starts = starts, source = source)
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens = tokens, pos = pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // A directive runs inside the same locator as a statement: a
        // misplaced `#zero_alloc` (before a `let`, or at EOF) threw a bare
        // message from here with no line:col (Codex on #3047).
        let hash_pos = pos
        pos = handle {
          let (dname, flag, dnext) = parse_cfg_directive(tokens = tokens, pos = pos + 1)
          if dname == "zero_alloc" {
            require_zero_alloc_target(tokens = tokens, pos = dnext)
            let marker_offset = if hash_pos < Array::length(starts) {
              Array::get(starts, at = hash_pos)
            } else {
              0
            }
            ArrayBuilder::push(b, value = SExpr(EIdent(zero_alloc_marker_ident(flag), marker_offset)))
            dnext
          } else if dname == "deprecated" || dname == "cfg_enable" || cfg_flag_active(active = cfg_active, flag = flag) {
            dnext
          } else {
            let capture_mark = binder_capture_mark(context)
            let eligibility_mark = binder_capture_eligibility_mark(context)
            let ref_mark = pattern_ref_mark()
            let slot_mark = positional_params_mark()
            let dn = match peek(tokens = tokens, pos = dnext) {
              TImpl => {
                let (simpl_d, hp_d) = parse_impl_stmt_dispatch_with_binder_context(tokens = tokens, pos = dnext + 1, context = context)
                let (_dropped, dn_impl) = parse_impl_methods(tokens = tokens, starts = starts, pos = hp_d, simpl = simpl_d, context = context)
                dn_impl
              },
              _ => {
                let (_dropped, dn_stmt) = parse_stmt_with_binder_context(tokens = tokens, starts = starts, pos = dnext, context = context)
                dn_stmt
              }
            }
            binder_capture_discard_from(context = context, mark = capture_mark)
            binder_capture_restore_eligibility(context = context, eligible = eligibility_mark)
            restore_pattern_refs(ref_mark)
            restore_positional_params(slot_mark)
            dn
          }
        } with { Exception::Throw(msg) => {
          throw(locate_parse_error(msg = msg, fallback_pos = hash_pos, starts = starts, source = source))
        } }
      },
      _ => {
        let start_pos = pos
        let (stmts, next) = handle {
          match peek(tokens = tokens, pos = pos) {
            TImpl => {
              binder_capture_mark_ineligible(context)
              let (simpl, hp) = parse_impl_stmt_dispatch_with_binder_context(tokens = tokens, pos = pos + 1, context = context)
              parse_impl_methods(tokens = tokens, starts = starts, pos = hp, simpl = simpl, context = context)
            },
            _ => {
              let (stmt, n) = parse_stmt_with_binder_context(tokens = tokens, starts = starts, pos = pos, context = context)
              ([stmt], n)
            }
          }
        } with { Exception::Throw(msg) => {
          throw(locate_parse_error(msg = msg, fallback_pos = start_pos, starts = starts, source = source))
        } }
        let mut ii = 0
        while ii < Array::length(stmts) {
          ArrayBuilder::push(b, value = Array::get(stmts, at = ii))
          ii = ii + 1
        }
        pos = next
      }
    }
  }
  (attach_qualified_pattern_refs(expand_top_level_pattern_lets_with_binder_context(stmts = ArrayBuilder::freeze(b), context = context)), pos)
}

/// True when `t` is a resynchronization point for `parse_program_recovering`:
/// it begins a top-level statement, OR is a statement separator (TSemicolon),
/// OR ends input (TEof). Folding TSemicolon/TEof in here lets the resync loop
/// use a single `if is_recovery_point(...)` test instead of a mixed
/// constructor/catch-all `match` (the latter traps the seed codegen on this
/// shape — keep this a flat function returning Bool).
#zero_alloc
fn is_recovery_point(_ t: Token) -> Bool {
  match t {
    TLet => true,
    TExport => true,
    TModule => true,
    TEnum => true,
    TSuberror => true,
    TStruct => true,
    TType => true,
    TTrait => true,
    TTest => true,
    TExample => true,
    TBench => true,
    TImport => true,
    TImpl => true,
    TDeclare => true,
    TOpen => true,
    TSemicolon => true,
    TEof => true,
    _ => false
  }
}

/// A failed inactive `#cfg` statement must be discarded as one unit. Recovery
/// keywords inside its parameters or body are still part of that statement.
fn recover_after_inactive_cfg_stmt(tokens: Array[Token], start: Int) -> Int {
  let n = Array::length(tokens)
  let mut depth = 0
  let mut i = start
  while i < n {
    let t = peek(tokens = tokens, pos = i)
    if i > start && depth == 0 {
      if is_recovery_point(t) {
        return i
      }
      match t {
        TFn => return i,
        _ => ()
      }
    }
    match t {
      TLParen => depth = depth + 1,
      TLBrace => depth = depth + 1,
      TLBracket => depth = depth + 1,
      TRParen => if depth > 0 {
        depth = depth - 1
      },
      TRBrace => if depth > 0 {
        depth = depth - 1
      },
      TRBracket => if depth > 0 {
        depth = depth - 1
      },
      TEof => return i,
      _ => ()
    }
    i = i + 1
  }
  n - 1
}

/// #3548: how many `{` are still open at token `upto`, counted from `from`.
fn recovery_brace_depth(tokens: Array[Token], from: Int, upto: Int) -> Int {
  let mut depth = 0
  let mut i = from
  let n = Array::length(tokens)
  while i < upto && i < n {
    match peek(tokens = tokens, pos = i) {
      TLBrace => depth = depth + 1,
      TRBrace => if depth > 0 {
        depth = depth - 1
      },
      _ => ()
    }
    i = i + 1
  }
  depth
}

/// #3548: the token after the `}` that closes `depth` open braces, scanning
/// from `from`; the final token (EOF) when they never close.
fn recovery_skip_to_close(tokens: Array[Token], from: Int, depth: Int) -> Int {
  let n = Array::length(tokens)
  let mut d = depth
  let mut i = from
  let mut out = n - 1
  let mut done = false
  while !done && i < n {
    match peek(tokens = tokens, pos = i) {
      TLBrace => d = d + 1,
      TRBrace => {
        d = d - 1
        if d == 0 {
          out = i + 1
          done = true
        }
      },
      TEof => {
        out = i
        done = true
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Like `parse_program_located`, but NEVER rethrows. On a per-statement syntax
/// error it records the located (`line:col`) message into a diagnostics array,
/// then resynchronizes by advancing `pos` to the next top-level statement start
/// (or TSemicolon / TEof). At least one token is always consumed to guarantee
/// progress. Returns the partial AST plus all collected diagnostics. Build all
/// strings with String::concat (not `+`/interpolation) to avoid selfhost
/// string-concat NUL fragility. Foundation: collect-all parse diagnostics (LSP).

export fn parse_program_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with Exception {
  parse_program_located_with_context_impl(tokens = tokens, starts = starts, source = source, context = None).0
}

/// Explicit test/tooling seam for parser-context transport. The supplied
/// context is forgeable and untrusted: this function never reads it and it
/// cannot authorize binder rows, semantic artifacts, reuse, or codegen. The
/// returned token position proves successful parsing consumed through TEof.
export fn parse_program_located_with_untrusted_binder_context(tokens: Array[Token], starts: Array[Int], source: String, context: Option[ParserBinderContext]) -> (Array[Stmt], Int) with Exception {
  parse_program_located_with_context_impl(tokens = tokens, starts = starts, source = source, context = context)
}

/// Compatibility API retained authority-free: caller-provided token arrays are
/// never a source of binder authority.
export fn parse_program_located_with_binder_context(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with Exception {
  parse_program_located_with_context_impl(tokens = tokens, starts = starts, source = source, context = None).0
}

export fn parse_program_recovering(tokens: Array[Token], starts: Array[Int], source: String) -> (Array[Stmt], Array[String]) with Exception {
  reset_pattern_refs()
  remember_parse_source(source)
  let cfg_active = handle {
    cfg_scan_enabled(tokens)
  } with { Exception::Throw(_) => ArrayBuilder::freeze(ArrayBuilder::new()) }
  let b = ArrayBuilder::new()
  let diags = ArrayBuilder::new()
  let n = Array::length(tokens)
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens = tokens, pos = pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // #cfg directive: on any malformed directive fall through to the
        // recovery machinery below by treating it like a failed statement.
        let ref_mark = pattern_ref_mark()
        let slot_mark = positional_params_mark()
        let mut cfg_stmt_start = 0 - 1
        let cfg_res = handle {
          let (dname, flag, dnext) = parse_cfg_directive(tokens = tokens, pos = pos + 1)
          if dname == "zero_alloc" {
            require_zero_alloc_target(tokens = tokens, pos = dnext)
            let marker_offset = if pos < Array::length(starts) {
              Array::get(starts, at = pos)
            } else {
              0
            }
            ArrayBuilder::push(b, value = SExpr(EIdent(zero_alloc_marker_ident(flag), marker_offset)))
            dnext
          } else if dname == "deprecated" || dname == "cfg_enable" || cfg_flag_active(active = cfg_active, flag = flag) {
            dnext
          } else {
            cfg_stmt_start = dnext
            let dn = match peek(tokens = tokens, pos = dnext) {
              TImpl => {
                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens = tokens, pos = dnext + 1)
                let (_dropped, dn) = parse_impl_methods(tokens = tokens, starts = [
                ], pos = hp_d, simpl = simpl_d, context = None)
                dn
              },
              _ => {
                let (_dropped, dn) = parse_stmt(tokens = tokens, starts = starts, pos = dnext)
                dn
              }
            }
            restore_pattern_refs(ref_mark)
            restore_positional_params(slot_mark)
            dn
          }
        } with { Exception::Throw(_) => {
          restore_pattern_refs(ref_mark)
          restore_positional_params(slot_mark)
          0 - 1
        } }
        if cfg_res >= 0 {
          pos = cfg_res
        } else if cfg_stmt_start >= 0 {
          pos = recover_after_inactive_cfg_stmt(tokens = tokens, start = cfg_stmt_start)
        } else {
          // A malformed directive has no guarded statement to skip.
          let mut rp = pos + 1
          while rp < n && !is_recovery_point(Array::get(tokens, at = rp)) {
            rp = rp + 1
          }
          pos = rp
        }
      },
      _ => {
        let start_pos = pos
        let ref_mark = pattern_ref_mark()
        let slot_mark = positional_params_mark()
        let res = handle {
          let (stmts, next) = match peek(tokens = tokens, pos = pos) {
            TImpl => {
              let (simpl, hp) = parse_impl_stmt_dispatch(tokens = tokens, pos = pos + 1)
              parse_impl_methods(tokens = tokens, starts = [], pos = hp, simpl = simpl, context = None)
            },
            _ => {
              let (stmt, n) = parse_stmt(tokens = tokens, starts = starts, pos = pos)
              ([stmt], n)
            }
          }
          Some((stmts, next))
        } with { Exception::Throw(msg) => {
          restore_pattern_refs(ref_mark)
          restore_positional_params(slot_mark)
          let err_pos = extract_err_token_pos(msg = msg, fallback_pos = start_pos).0
          let anchor_pos = if err_pos >= start_pos && err_pos < Array::length(starts) {
            err_pos
          } else {
            start_pos
          }
          ArrayBuilder::push(diags, value = locate_parse_error(msg = msg, fallback_pos = start_pos, starts = starts, source = source))
          // #946: resynchronize from the ERROR ANCHOR, not the statement
          // start. Every token before the anchor was already consumed as
          // part of this failed statement, so restarting the parse at each
          // intervening recovery-point-looking token (e.g. the TLet inside
          // a failed `export let ...`) re-reported the SAME error 4-5x with
          // stray positions. Skip at least one token (progress guarantee),
          // then advance to the next recovery point (top-level statement
          // start, TSemicolon, or TEof — see is_recovery_point) and hand
          // the position back through the normal Some path (zero stmts).
          // #963: if the anchor token IS itself a recovery point (the
          // failed statement ran into the start of the NEXT top-level
          // statement, e.g. `export let a =` followed by `test ...`),
          // resume AT the anchor so that statement is parsed, not skipped.
          // Progress stays guaranteed: this branch is only taken when
          // anchor_pos > start_pos (the clamp above enforces
          // anchor_pos >= start_pos), and the anchor+1 path always
          // consumes at least one token.
          // #3548: an error inside a body (`fn main() { .. }`) resumes after
          // the brace that closes the failed declaration. Resuming at the
          // next `let` inside that body parsed it as a top-level statement
          // and reported the same broken line a second time, at the wrong
          // position.
          let open_depth = recovery_brace_depth(tokens = tokens, from = start_pos, upto = anchor_pos)
          let resync_pos = if open_depth > 0 {
            recovery_skip_to_close(tokens = tokens, from = anchor_pos, depth = open_depth)
          } else if anchor_pos > start_pos && is_recovery_point(peek(tokens = tokens, pos = anchor_pos)) {
            anchor_pos
          } else {
            let mut rp = anchor_pos + 1
            let mut sync = false
            while !sync {
              if rp >= n {
                sync = true
              } else {
                let t = peek(tokens = tokens, pos = rp)
                if is_recovery_point(t) {
                  sync = true
                } else {
                  rp = rp + 1
                }
              }
            }
            rp
          }
          Some((ArrayBuilder::freeze(ArrayBuilder::new()), resync_pos))
        } }
        match res {
          Some((stmts, next)) => {
            let mut ii = 0
            while ii < Array::length(stmts) {
              ArrayBuilder::push(b, value = Array::get(stmts, at = ii))
              ii = ii + 1
            }
            pos = next
          },
          None => {
            // Unreachable: the Throw handler above always returns Some with
            // an empty statement list and the resync position. Kept only for
            // match exhaustiveness; consume one token if ever reached.
            pos = start_pos + 1
          }
        }
      }
    }
  }
  (attach_qualified_pattern_refs(expand_top_level_pattern_lets(ArrayBuilder::freeze(b))), ArrayBuilder::freeze(diags))
}

/// Like `parse_program`, but also returns per top-level statement its source
/// byte span (start, end), derived from the token offset arrays produced by
/// `lex_with_offsets`. start = first token's start offset; end = last token's
/// end offset. The three returned arrays are parallel (one entry per stmt).
export fn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with Exception {
  reset_pattern_refs()
  let cfg_active = cfg_scan_enabled(tokens)
  let b = ArrayBuilder::new()
  let span_start = ArrayBuilder::new()
  let span_end = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  // Set by an inactive `#cfg`: the next statement is parsed by the ordinary
  // arm below (syntax must stay valid) and then not recorded. Routing it
  // through the same arm instead of a second `parse_stmt` call site matters:
  // measured on the selfcompile KPI, one extra `parse_stmt(...)` call in this
  // function costs the compiler +48 MB of heap and +10k pages to compile
  // parser.vibe (#2516).
  let mut drop_next = false
  while !done {
    match peek(tokens = tokens, pos = pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      THash => {
        // `#zero_alloc` is part of the following declaration's source span.
        // Module-source emission therefore preserves the directive without
        // adding a synthetic statement that would desynchronise span arrays.
        let (dname, flag, dnext) = parse_cfg_directive(tokens = tokens, pos = pos + 1)
        if dname == "zero_alloc" {
          require_zero_alloc_target(tokens = tokens, pos = dnext)
          let st = Array::get(starts, at = pos)
          let (stmt, next) = parse_stmt(tokens = tokens, starts = starts, pos = dnext)
          ArrayBuilder::push(b, value = stmt)
          ArrayBuilder::push(span_start, value = st)
          ArrayBuilder::push(span_end, value = Array::get(ends, at = next - 1))
          pos = next
        } else if dname == "deprecated" || dname == "cfg_enable" || cfg_flag_active(active = cfg_active, flag = flag) {
          // Resolved at this parse, the same way `parse_program` resolves
          // them: the directive itself owns no span, and the statement an
          // active `#cfg` / `#deprecated` guards is emitted by the next
          // iteration as itself. Module-source emission therefore produces a
          // directive-free flat source for the active set it was given
          // (#2497), and the span tools see exactly the statements the
          // checker sees.
          pos = dnext
        } else {
          // Inactive `#cfg`: the guarded statement must still parse (the
          // TImpl / ordinary arms below do that, an impl through its
          // methods), and gets no span, so it is absent from the emitted
          // source rather than emitted under a directive the next compile
          // would have to resolve again. `parse_program` hands the position
          // after the directive to `parse_stmt`, which rejects a directive or
          // EOF there; say the same.
          match peek(tokens = tokens, pos = dnext) {
            THash => throw("#cfg must be followed by a statement"),
            TEof => throw("#cfg must be followed by a statement"),
            _ => {
              drop_next = true
              pos = dnext
            }
          }
        }
      },
      TImpl => {
        // One statement, one span, for the whole impl (the emitted text is
        // the source itself), but the body is parsed through its methods as
        // `parse_program` does: brace balancing accepted malformed method
        // syntax and never terminated at EOF.
        let st = Array::get(starts, at = pos)
        let ref_mark = if drop_next {
          pattern_ref_mark()
        } else {
          (0, 0)
        }
        let slot_mark = positional_params_mark()
        let (simpl, hp) = parse_impl_stmt_dispatch(tokens = tokens, pos = pos + 1)
        let (_impl_stmts, next) = parse_impl_methods(tokens = tokens, starts = [
        ], pos = hp, simpl = simpl, context = None)
        if drop_next {
          restore_pattern_refs(ref_mark)
          restore_positional_params(slot_mark)
          drop_next = false
        } else {
          ArrayBuilder::push(b, value = simpl)
          ArrayBuilder::push(span_start, value = st)
          ArrayBuilder::push(span_end, value = Array::get(ends, at = next - 1))
        }
        pos = next
      },
      _ => {
        let st = Array::get(starts, at = pos)
        let ref_mark = if drop_next {
          pattern_ref_mark()
        } else {
          (0, 0)
        }
        let slot_mark = positional_params_mark()
        let (stmt, next) = parse_stmt(tokens = tokens, starts = starts, pos = pos)
        if drop_next {
          restore_pattern_refs(ref_mark)
          restore_positional_params(slot_mark)
          drop_next = false
        } else {
          ArrayBuilder::push(b, value = stmt)
          ArrayBuilder::push(span_start, value = st)
          ArrayBuilder::push(span_end, value = Array::get(ends, at = next - 1))
        }
        pos = next
      }
    }
  }
  // #1455 step 3: this entry feeds editor tooling (spans, symbols, type-at),
  // which never type-checks, so there is no marker to attach the qualified
  // pattern refs to -- drop them rather than let them outlive this parse and
  // be reported against some later file's enums.
  if has_test_effect_rows() {
    let _dropped_rows = take_test_effect_rows()
  } else {
    ()
  }
  if has_qualified_pattern_refs() {
    let _dropped = take_qualified_pattern_refs()
  } else {
    ()
  }
  if has_positional_params() {
    let _dropped_slots = take_positional_params()
  } else {
    ()
  }
  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))
}

//# Misc

export {
  Expr,
  Pat,
  Stmt,
  TypeExpr,
  parse,
  parse_expr,
  parse_ok,
  parse_program,
  parse_program_preserving,
  parse_stmt,
  parse_stmt_preserving,
  parse_type
}

/// Parse the source once, retaining exact token extents for editor queries.
/// Annotations are never passed to the checker or code generator.
export fn parse_source_with_ranges(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let context = source_expr_context(starts = starts, ends = ends)
  parse_program_located_with_context_impl(tokens = tokens, starts = starts, source = source, context = Some(context)).0
}
