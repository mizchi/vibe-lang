//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, type_param_name
}

import ./ast_detach.vibe {
  detach_stmts
}

import ./lexer.vibe {
  lex_with_offsets
}

import ./parser.vibe {
  parse_program_located_with_untrusted_binder_context
}

import ./parser_base.vibe {
  peek
}

import ./parser_binder_context.vibe {
  SourceBinder, binder_capture_context, binder_capture_is_eligible, binder_capture_rows
}

//# Types

/// Closed final-AST constructor inventory for the recursive binder sidecar.
/// Arity is the exact length of a node's ordered children array.
export enum BinderAuthorityNodeKind {
  AuthorityPatWild;
  AuthorityPatBind;
  AuthorityPatInt;
  AuthorityPatFloat;
  AuthorityPatString;
  AuthorityPatBool;
  AuthorityPatCtor;
  AuthorityPatTuple;
  AuthorityPatStruct;
  AuthorityExprInt;
  AuthorityExprFloat;
  AuthorityExprString;
  AuthorityExprBool;
  AuthorityExprIdent;
  AuthorityExprTuple;
  AuthorityExprArray;
  AuthorityExprRecord;
  AuthorityExprIf;
  AuthorityExprLet;
  AuthorityExprLetRec;
  AuthorityExprLetMut;
  AuthorityExprAssign;
  AuthorityExprAssignOp;
  AuthorityExprSeq;
  AuthorityExprMatch;
  AuthorityExprHandle;
  AuthorityExprFn;
  AuthorityExprForIn;
  AuthorityExprWhile;
  AuthorityExprCall;
  AuthorityExprBinOp;
  AuthorityExprUnaryOp;
  AuthorityExprDot;
  AuthorityExprLabeledArg;
  AuthorityExprReturn;
  AuthorityExprBreak;
  AuthorityExprContinue;
  AuthorityExprMap;
  AuthorityExprSpread;
  AuthorityExprStringInterp;
  AuthorityExprUnit;
  AuthorityStmtLet;
  AuthorityStmtLetMut;
  AuthorityStmtExternLet;
  AuthorityStmtImport;
  AuthorityStmtAliasDecl;
  AuthorityStmtTypeAlias;
  AuthorityStmtEffectSet;
  AuthorityStmtResource;
  AuthorityStmtTest;
  AuthorityStmtBench;
  AuthorityStmtExample;
  AuthorityStmtExpr;
  AuthorityStmtExport;
  AuthorityStmtReExport;
  AuthorityStmtQualifiedPatternRefs;
  AuthorityStmtTestEffectRows;
  AuthorityStmtPositionalParams
}

/// Closed semantic role of one binder slot on its exact final-AST node.
export enum BinderSemanticRole {
  StatementLetBinder;
  StatementLetMutBinder;
  StatementExternBinder;
  StatementImportBinder;
  StatementAliasBinder;
  StatementTypeBinder;
  StatementTypeParameterBinder;
  StatementEffectSetBinder;
  StatementResourceBinder;
  ExpressionLetBinder;
  ExpressionLetRecBinder;
  ExpressionLetMutBinder;
  ExpressionFunctionTypeParameterBinder;
  ExpressionFunctionParameterBinder;
  ExpressionForValueBinder;
  ExpressionForIndexBinder;
  PatternBinder
}

/// Forgeable data pairing one semantic slot role with its existing flat row.
export struct BinderAuthoritySlot {
  role: BinderSemanticRole;
  binder: SourceBinder
}

/// Forgeable recursive data sidecar. Possession never grants authority.
export struct BinderAuthorityNode {
  kind: BinderAuthorityNodeKind;
  slots: Array[BinderAuthoritySlot];
  children: Array[BinderAuthorityNode]
}

enum StoredLocatedProgram {
  StoredLocatedProgramValue(Array[Stmt])
}

/// Private persistent representation retained by the validated aggregate.
/// No mutable Array is reachable from this topology. Public forgeable nodes
/// are materialized only as detached data copies at the accessor boundary.
enum StoredBinderAuthority {
  StoredAuthorityNil;
  StoredAuthoritySlot(BinderAuthoritySlot, StoredBinderAuthority);
  StoredAuthorityNode(BinderAuthorityNodeKind, StoredBinderAuthority, StoredBinderAuthority);
  StoredAuthorityChild(StoredBinderAuthority, StoredBinderAuthority)
}

/// Atomically produced exact-source parse result, compatibility rows, and the
/// sidecar built in the same exhaustive walk against that exact final AST.
export struct LocatedProgramBinderAuthority {
  source: String;
  program: StoredLocatedProgram;
  binders: Array[SourceBinder];
  nodes: StoredBinderAuthority
}

//# Data accessors

export fn binder_authority_node_kind(_ node: BinderAuthorityNode) -> BinderAuthorityNodeKind {
  node.kind
}

export fn binder_authority_node_slots(_ node: BinderAuthorityNode) -> Array[BinderAuthoritySlot] {
  Array::slice(node.slots, start = 0, end = Array::length(node.slots))
}

export fn binder_authority_node_children(_ node: BinderAuthorityNode) -> Array[BinderAuthorityNode] {
  Array::slice(node.children, start = 0, end = Array::length(node.children))
}

export fn binder_authority_slot_role(_ slot: BinderAuthoritySlot) -> BinderSemanticRole {
  slot.role
}

export fn binder_authority_slot_binder(_ slot: BinderAuthoritySlot) -> SourceBinder {
  slot.binder
}

export fn located_program_binder_authority_program(_ authority: LocatedProgramBinderAuthority) -> Array[Stmt] {
  match authority.program {
    StoredLocatedProgramValue(program) => detach_stmts(program)
  }
}

/// Exact parser-owned bytes from which this authority was atomically built.
export fn located_program_binder_authority_source(_ authority: LocatedProgramBinderAuthority) -> String {
  authority.source
}

/// Exact parser-owned bytes from which this authority was atomically built.
export fn LocatedProgramBinderAuthority::located_program_binder_authority_source(_ authority: LocatedProgramBinderAuthority) -> String {
  located_program_binder_authority_source(authority)
}

export fn located_program_binder_authority_rows(_ authority: LocatedProgramBinderAuthority) -> Array[SourceBinder] {
  Array::slice(authority.binders, start = 0, end = Array::length(authority.binders))
}

fn append_materialized_slots(stored: StoredBinderAuthority, out: ArrayBuilder[BinderAuthoritySlot]) -> Unit {
  match stored {
    StoredAuthoritySlot(slot, rest) => {
      ArrayBuilder::push(out, value = slot)
      append_materialized_slots(stored = rest, out = out)
    },
    _ => ()
  }
}

fn materialize_authority_node(_ stored: StoredBinderAuthority) -> BinderAuthorityNode {
  match stored {
    StoredAuthorityNode(kind, slots, children) => {
      let slot_out = ArrayBuilder::new()
      append_materialized_slots(stored = slots, out = slot_out)
      let child_out = ArrayBuilder::new()
      append_materialized_nodes(stored = children, out = child_out)
      BinderAuthorityNode::{
        kind,
        slots: ArrayBuilder::freeze(slot_out),
        children: ArrayBuilder::freeze(child_out)
      }
    },
    // Private stored values are created only by stored_authority_node. Keep a
    // total fallback so malformed public data is never involved in recursion.
    _ => BinderAuthorityNode::{
      kind: AuthorityExprUnit,
      slots: ArrayBuilder::freeze(ArrayBuilder::new()),
      children: ArrayBuilder::freeze(ArrayBuilder::new())
    }
  }
}

fn append_materialized_nodes(stored: StoredBinderAuthority, out: ArrayBuilder[BinderAuthorityNode]) -> Unit {
  match stored {
    StoredAuthorityChild(node, rest) => {
      ArrayBuilder::push(out, value = materialize_authority_node(node))
      append_materialized_nodes(stored = rest, out = out)
    },
    _ => ()
  }
}

/// Materialize a fresh recursive public data tree on every call. Every slots
/// and children array at every depth is detached from the aggregate and from
/// arrays returned by previous calls.
export fn located_program_binder_authority_nodes(_ authority: LocatedProgramBinderAuthority) -> Array[BinderAuthorityNode] {
  let out = ArrayBuilder::new()
  append_materialized_nodes(stored = authority.nodes, out = out)
  ArrayBuilder::freeze(out)
}

//# Exhaustive final-AST validation and sidecar construction

fn no_slots() -> Array[BinderAuthoritySlot] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn no_nodes() -> Array[BinderAuthorityNode] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn one_node(_ node: BinderAuthorityNode) -> Array[BinderAuthorityNode] {
  [node]
}

fn two_nodes(first: BinderAuthorityNode, second: BinderAuthorityNode) -> Array[BinderAuthorityNode] {
  [first, second]
}

fn authority_node(kind: BinderAuthorityNodeKind, slots: Array[BinderAuthoritySlot], children: Array[BinderAuthorityNode]) -> BinderAuthorityNode {
  BinderAuthorityNode::{
    kind,
    slots,
    children
  }
}

fn leaf(_ kind: BinderAuthorityNodeKind) -> BinderAuthorityNode {
  authority_node(kind = kind, slots = no_slots(), children = no_nodes())
}

fn validate_slot(name: String, role: BinderSemanticRole, rows: Array[SourceBinder], source: String, at: Int) -> Option[(BinderAuthoritySlot, Int)] {
  if at < 0 || at >= Array::length(rows) {
    None
  } else match Array::get(rows, at = at) {
    SourceToken(row_name, start, end) => {
      let n = String::length(source)
      let valid_span = start >= 0 && start < end && end <= n
      let exact = if valid_span {
        let spelling = String::substring(source, start = start, end = end)
        spelling == name || spelling == String::concat("@", name) || spelling == String::concat("r#", name)
      } else false
      if row_name == name && exact {
        Some((BinderAuthoritySlot::{
          role,
          binder: Array::get(rows, at = at)
        }, at + 1))
      } else None
    },
    // Approved parser lowerings already represented in the exact final AST
    // retain their compatibility row at this exact semantic slot. Synthetic
    // topology with no supported final-AST branch (for example ELoop) still
    // fails closed in the exhaustive node walk.
    Synthetic(row_name, _) => if row_name == name {
      Some((BinderAuthoritySlot::{
        role,
        binder: Array::get(rows, at = at)
      }, at + 1))
    } else None
  }
}

fn validate_pattern(pat: Pat, rows: Array[SourceBinder], source: String, at: Int) -> Option[(BinderAuthorityNode, Int)] {
  match pat {
    PBind(name) => match validate_slot(name = name, role = PatternBinder, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityPatBind, slots = [
        result.0
      ], children = no_nodes()), result.1)),
      None => None
    },
    PCtor(_, args) => match validate_patterns(pats = args, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityPatCtor, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    PTuple(args) => match validate_patterns(pats = args, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityPatTuple, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    PStruct(_, fields) => {
      let children = ArrayBuilder::new()
      let mut next = at
      for field in fields {
        match validate_pattern(pat = field.1, rows = rows, source = source, at = next) {
          Some(result) => {
            ArrayBuilder::push(children, value = result.0)
            next = result.1
          },
          None => return None
        }
      }
      Some((authority_node(kind = AuthorityPatStruct, slots = no_slots(), children = ArrayBuilder::freeze(children)), next))
    },
    // POr has two source declarations for one semantic binding and remains
    // deliberately unsupported until that semantic contract exists.
    POr(_, _) => None,
    PWild => Some((leaf(AuthorityPatWild), at)),
    PInt(_) => Some((leaf(AuthorityPatInt), at)),
    PFloat(_) => Some((leaf(AuthorityPatFloat), at)),
    PString(_) => Some((leaf(AuthorityPatString), at)),
    PBool(_) => Some((leaf(AuthorityPatBool), at))
  }
}

fn validate_patterns(pats: Array[Pat], rows: Array[SourceBinder], source: String, at: Int) -> Option[(Array[BinderAuthorityNode], Int)] {
  let children = ArrayBuilder::new()
  let mut next = at
  for pat in pats {
    match validate_pattern(pat = pat, rows = rows, source = source, at = next) {
      Some(result) => {
        ArrayBuilder::push(children, value = result.0)
        next = result.1
      },
      None => return None
    }
  }
  Some((ArrayBuilder::freeze(children), next))
}

fn validate_exprs(exprs: Array[Expr], rows: Array[SourceBinder], source: String, at: Int) -> Option[(Array[BinderAuthorityNode], Int)] {
  let children = ArrayBuilder::new()
  let mut next = at
  for expr in exprs {
    match validate_expr(expr = expr, rows = rows, source = source, at = next) {
      Some(result) => {
        ArrayBuilder::push(children, value = result.0)
        next = result.1
      },
      None => return None
    }
  }
  Some((ArrayBuilder::freeze(children), next))
}

fn validate_arms(arms: Array[(Pat, Expr)], rows: Array[SourceBinder], source: String, at: Int) -> Option[(Array[BinderAuthorityNode], Int)] {
  let children = ArrayBuilder::new()
  let mut next = at
  for arm in arms {
    match validate_pattern(pat = arm.0, rows = rows, source = source, at = next) {
      Some(pattern) => {
        ArrayBuilder::push(children, value = pattern.0)
        match validate_expr(expr = arm.1, rows = rows, source = source, at = pattern.1) {
          Some(body) => {
            ArrayBuilder::push(children, value = body.0)
            next = body.1
          },
          None => return None
        }
      },
      None => return None
    }
  }
  Some((ArrayBuilder::freeze(children), next))
}

fn validate_named_exprs(items: Array[(String, Expr)], rows: Array[SourceBinder], source: String, at: Int) -> Option[(Array[BinderAuthorityNode], Int)] {
  let children = ArrayBuilder::new()
  let mut next = at
  for item in items {
    match validate_expr(expr = item.1, rows = rows, source = source, at = next) {
      Some(result) => {
        ArrayBuilder::push(children, value = result.0)
        next = result.1
      },
      None => return None
    }
  }
  Some((ArrayBuilder::freeze(children), next))
}

fn validate_expr(expr: Expr, rows: Array[SourceBinder], source: String, at: Int) -> Option[(BinderAuthorityNode, Int)] {
  match expr {
    ELet(name, value, body, _) => match validate_slot(name = name, role = ExpressionLetBinder, rows = rows, source = source, at = at) {
      Some(slot) => match validate_expr(expr = value, rows = rows, source = source, at = slot.1) {
        Some(v) => match validate_expr(expr = body, rows = rows, source = source, at = v.1) {
          Some(b) => Some((authority_node(kind = AuthorityExprLet, slots = [
            slot.0
          ], children = two_nodes(first = v.0, second = b.0)), b.1)),
          None => None
        },
        None => None
      },
      None => None
    },
    ELetRec(name, value, body) => match validate_slot(name = name, role = ExpressionLetRecBinder, rows = rows, source = source, at = at) {
      Some(slot) => match validate_expr(expr = value, rows = rows, source = source, at = slot.1) {
        Some(v) => match validate_expr(expr = body, rows = rows, source = source, at = v.1) {
          Some(b) => Some((authority_node(kind = AuthorityExprLetRec, slots = [
            slot.0
          ], children = two_nodes(first = v.0, second = b.0)), b.1)),
          None => None
        },
        None => None
      },
      None => None
    },
    ELetMut(name, value, body, _) => match validate_slot(name = name, role = ExpressionLetMutBinder, rows = rows, source = source, at = at) {
      Some(slot) => match validate_expr(expr = value, rows = rows, source = source, at = slot.1) {
        Some(v) => match validate_expr(expr = body, rows = rows, source = source, at = v.1) {
          Some(b) => Some((authority_node(kind = AuthorityExprLetMut, slots = [
            slot.0
          ], children = two_nodes(first = v.0, second = b.0)), b.1)),
          None => None
        },
        None => None
      },
      None => None
    },
    EMatch(scrutinee, arms) => match validate_expr(expr = scrutinee, rows = rows, source = source, at = at) {
      Some(s) => match validate_arms(arms = arms, rows = rows, source = source, at = s.1) {
        Some(a) => {
          let children = ArrayBuilder::new()
          ArrayBuilder::push(children, value = s.0)
          for child in a.0 {
            ArrayBuilder::push(children, value = child)
          }
          Some((authority_node(kind = AuthorityExprMatch, slots = no_slots(), children = ArrayBuilder::freeze(children)), a.1))
        },
        None => None
      },
      None => None
    },
    EHandle(body, arms) => match validate_expr(expr = body, rows = rows, source = source, at = at) {
      Some(b) => match validate_arms(arms = arms, rows = rows, source = source, at = b.1) {
        Some(a) => {
          let children = ArrayBuilder::new()
          ArrayBuilder::push(children, value = b.0)
          for child in a.0 {
            ArrayBuilder::push(children, value = child)
          }
          Some((authority_node(kind = AuthorityExprHandle, slots = no_slots(), children = ArrayBuilder::freeze(children)), a.1))
        },
        None => None
      },
      None => None
    },
    EFn(type_params, _, params, _, _, body) => {
      let slots = ArrayBuilder::new()
      let mut next = at
      for name in type_params {
        match validate_slot(name = type_param_name(name), role = ExpressionFunctionTypeParameterBinder, rows = rows, source = source, at = next) {
          Some(result) => {
            ArrayBuilder::push(slots, value = result.0)
            next = result.1
          },
          None => return None
        }
      }
      for param in params {
        match validate_slot(name = param.0, role = ExpressionFunctionParameterBinder, rows = rows, source = source, at = next) {
          Some(result) => {
            ArrayBuilder::push(slots, value = result.0)
            next = result.1
          },
          None => return None
        }
      }
      match validate_expr(expr = body, rows = rows, source = source, at = next) {
        Some(result) => Some((authority_node(kind = AuthorityExprFn, slots = ArrayBuilder::freeze(slots), children = one_node(result.0)), result.1)),
        None => None
      }
    },
    EForIn(name, index_name, iter, body, _) => match validate_slot(name = name, role = ExpressionForValueBinder, rows = rows, source = source, at = at) {
      Some(first) => {
        let slots = ArrayBuilder::new()
        ArrayBuilder::push(slots, value = first.0)
        let mut next = first.1
        match index_name {
          Some(index) => match validate_slot(name = index, role = ExpressionForIndexBinder, rows = rows, source = source, at = next) {
            Some(second) => {
              ArrayBuilder::push(slots, value = second.0)
              next = second.1
            },
            None => return None
          },
          None => ()
        }
        match validate_expr(expr = iter, rows = rows, source = source, at = next) {
          Some(i) => match validate_expr(expr = body, rows = rows, source = source, at = i.1) {
            Some(b) => Some((authority_node(kind = AuthorityExprForIn, slots = ArrayBuilder::freeze(slots), children = two_nodes(first = i.0, second = b.0)), b.1)),
            None => None
          },
          None => None
        }
      },
      None => None
    },
    // Loop lowering synthesizes binders and remains fail-closed.
    ELoop(_, _) => None,
    ETuple(items) => match validate_exprs(exprs = items, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprTuple, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    EArray(items) => match validate_exprs(exprs = items, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprArray, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    ERecord(_, fields, _) => match validate_named_exprs(items = fields, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprRecord, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    EIf(cond, yes, no) => match validate_expr(expr = cond, rows = rows, source = source, at = at) {
      Some(c) => match validate_expr(expr = yes, rows = rows, source = source, at = c.1) {
        Some(y) => match validate_expr(expr = no, rows = rows, source = source, at = y.1) {
          Some(n) => Some((authority_node(kind = AuthorityExprIf, slots = no_slots(), children = [
            c.0,
            y.0,
            n.0
          ]), n.1)),
          None => None
        },
        None => None
      },
      None => None
    },
    EAssign(_, value, body, _) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(v) => match validate_expr(expr = body, rows = rows, source = source, at = v.1) {
        Some(b) => Some((authority_node(kind = AuthorityExprAssign, slots = no_slots(), children = two_nodes(first = v.0, second = b.0)), b.1)),
        None => None
      },
      None => None
    },
    EAssignOp(_, _, value, body, _) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(v) => match validate_expr(expr = body, rows = rows, source = source, at = v.1) {
        Some(b) => Some((authority_node(kind = AuthorityExprAssignOp, slots = no_slots(), children = two_nodes(first = v.0, second = b.0)), b.1)),
        None => None
      },
      None => None
    },
    ESeq(first, second) => match validate_expr(expr = first, rows = rows, source = source, at = at) {
      Some(f) => match validate_expr(expr = second, rows = rows, source = source, at = f.1) {
        Some(s) => Some((authority_node(kind = AuthorityExprSeq, slots = no_slots(), children = two_nodes(first = f.0, second = s.0)), s.1)),
        None => None
      },
      None => None
    },
    EWhile(cond, body) => match validate_expr(expr = cond, rows = rows, source = source, at = at) {
      Some(c) => match validate_expr(expr = body, rows = rows, source = source, at = c.1) {
        Some(b) => Some((authority_node(kind = AuthorityExprWhile, slots = no_slots(), children = two_nodes(first = c.0, second = b.0)), b.1)),
        None => None
      },
      None => None
    },
    ECall(callee, args, _, _) => match validate_expr(expr = callee, rows = rows, source = source, at = at) {
      Some(c) => match validate_exprs(exprs = args, rows = rows, source = source, at = c.1) {
        Some(a) => {
          let children = ArrayBuilder::new()
          ArrayBuilder::push(children, value = c.0)
          for child in a.0 {
            ArrayBuilder::push(children, value = child)
          }
          Some((authority_node(kind = AuthorityExprCall, slots = no_slots(), children = ArrayBuilder::freeze(children)), a.1))
        },
        None => None
      },
      None => None
    },
    EBinOp(_, left, right, _) => match validate_expr(expr = left, rows = rows, source = source, at = at) {
      Some(l) => match validate_expr(expr = right, rows = rows, source = source, at = l.1) {
        Some(r) => Some((authority_node(kind = AuthorityExprBinOp, slots = no_slots(), children = two_nodes(first = l.0, second = r.0)), r.1)),
        None => None
      },
      None => None
    },
    EUnaryOp(_, value) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprUnaryOp, slots = no_slots(), children = one_node(result.0)), result.1)),
      None => None
    },
    EDot(value, _, _, _) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprDot, slots = no_slots(), children = one_node(result.0)), result.1)),
      None => None
    },
    ELabeledArg(_, _, value) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprLabeledArg, slots = no_slots(), children = one_node(result.0)), result.1)),
      None => None
    },
    EReturn(value) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprReturn, slots = no_slots(), children = one_node(result.0)), result.1)),
      None => None
    },
    EBreak(value) => match value {
      Some(v) => match validate_expr(expr = v, rows = rows, source = source, at = at) {
        Some(result) => Some((authority_node(kind = AuthorityExprBreak, slots = no_slots(), children = one_node(result.0)), result.1)),
        None => None
      },
      None => Some((leaf(AuthorityExprBreak), at))
    },
    EContinue(values) => match validate_exprs(exprs = values, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprContinue, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    EMap(items) => match validate_named_exprs(items = items, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprMap, slots = no_slots(), children = result.0), result.1)),
      None => None
    },
    ESpread(value) => match validate_expr(expr = value, rows = rows, source = source, at = at) {
      Some(result) => Some((authority_node(kind = AuthorityExprSpread, slots = no_slots(), children = one_node(result.0)), result.1)),
      None => None
    },
    EInt(_) => Some((leaf(AuthorityExprInt), at)),
    EFloat(_) => Some((leaf(AuthorityExprFloat), at)),
    EString(_, _) => Some((leaf(AuthorityExprString), at)),
    EBool(_) => Some((leaf(AuthorityExprBool), at)),
    EIdent(_, _) => Some((leaf(AuthorityExprIdent), at)),
    EStringInterp(_) => Some((leaf(AuthorityExprStringInterp), at)),
    EUnit => Some((leaf(AuthorityExprUnit), at))
  }
}

fn validate_stmt(stmt: Stmt, rows: Array[SourceBinder], source: String, at: Int) -> Option[(BinderAuthorityNode, Int)] {
  match stmt {
    SLet(_, _, name, _, value) => match validate_slot(name = name, role = StatementLetBinder, rows = rows, source = source, at = at) {
      Some(slot) => match validate_expr(expr = value, rows = rows, source = source, at = slot.1) {
        Some(expr) => Some((authority_node(kind = AuthorityStmtLet, slots = [
          slot.0
        ], children = one_node(expr.0)), expr.1)),
        None => None
      },
      None => None
    },
    SLetMut(name, _, value) => match validate_slot(name = name, role = StatementLetMutBinder, rows = rows, source = source, at = at) {
      Some(slot) => match validate_expr(expr = value, rows = rows, source = source, at = slot.1) {
        Some(expr) => Some((authority_node(kind = AuthorityStmtLetMut, slots = [
          slot.0
        ], children = one_node(expr.0)), expr.1)),
        None => None
      },
      None => None
    },
    SExternLet(name, _) => match validate_slot(name = name, role = StatementExternBinder, rows = rows, source = source, at = at) {
      Some(slot) => Some((authority_node(kind = AuthorityStmtExternLet, slots = [
        slot.0
      ], children = no_nodes()), slot.1)),
      None => None
    },
    SImport(_, items) => {
      let slots = ArrayBuilder::new()
      let mut next = at
      for item in items {
        let local = match item.alias {
          Some(alias) => alias,
          None => item.name
        }
        match validate_slot(name = local, role = StatementImportBinder, rows = rows, source = source, at = next) {
          Some(slot) => {
            ArrayBuilder::push(slots, value = slot.0)
            next = slot.1
          },
          None => return None
        }
      }
      Some((authority_node(kind = AuthorityStmtImport, slots = ArrayBuilder::freeze(slots), children = no_nodes()), next))
    },
    SAliasDecl(name, _) => match validate_slot(name = name, role = StatementAliasBinder, rows = rows, source = source, at = at) {
      Some(slot) => Some((authority_node(kind = AuthorityStmtAliasDecl, slots = [
        slot.0
      ], children = no_nodes()), slot.1)),
      None => None
    },
    STypeAlias(_, name, params, _) => match validate_slot(name = name, role = StatementTypeBinder, rows = rows, source = source, at = at) {
      Some(first) => {
        let slots = ArrayBuilder::new()
        ArrayBuilder::push(slots, value = first.0)
        let mut next = first.1
        for param in params {
          match validate_slot(name = type_param_name(param), role = StatementTypeParameterBinder, rows = rows, source = source, at = next) {
            Some(slot) => {
              ArrayBuilder::push(slots, value = slot.0)
              next = slot.1
            },
            None => return None
          }
        }
        Some((authority_node(kind = AuthorityStmtTypeAlias, slots = ArrayBuilder::freeze(slots), children = no_nodes()), next))
      },
      None => None
    },
    SEffectSet(_, name, _) => match validate_slot(name = name, role = StatementEffectSetBinder, rows = rows, source = source, at = at) {
      Some(slot) => Some((authority_node(kind = AuthorityStmtEffectSet, slots = [
        slot.0
      ], children = no_nodes()), slot.1)),
      None => None
    },
    SResource(name, _) => match validate_slot(name = name, role = StatementResourceBinder, rows = rows, source = source, at = at) {
      Some(slot) => Some((authority_node(kind = AuthorityStmtResource, slots = [
        slot.0
      ], children = no_nodes()), slot.1)),
      None => None
    },
    STest(_, body) => match validate_expr(expr = body, rows = rows, source = source, at = at) {
      Some(expr) => Some((authority_node(kind = AuthorityStmtTest, slots = no_slots(), children = one_node(expr.0)), expr.1)),
      None => None
    },
    SBench(_, body) => match validate_expr(expr = body, rows = rows, source = source, at = at) {
      Some(expr) => Some((authority_node(kind = AuthorityStmtBench, slots = no_slots(), children = one_node(expr.0)), expr.1)),
      None => None
    },
    SExample(_, body) => match validate_expr(expr = body, rows = rows, source = source, at = at) {
      Some(expr) => Some((authority_node(kind = AuthorityStmtExample, slots = no_slots(), children = one_node(expr.0)), expr.1)),
      None => None
    },
    SExpr(body) => match validate_expr(expr = body, rows = rows, source = source, at = at) {
      Some(expr) => Some((authority_node(kind = AuthorityStmtExpr, slots = no_slots(), children = one_node(expr.0)), expr.1)),
      None => None
    },
    SExport(_) => Some((leaf(AuthorityStmtExport), at)),
    SReExport(_, _) => Some((leaf(AuthorityStmtReExport), at)),
    SQualifiedPatternRefs(_) => Some((leaf(AuthorityStmtQualifiedPatternRefs), at)),
    STestEffectRows(_) => Some((leaf(AuthorityStmtTestEffectRows), at)),
    SPositionalParams(_) => Some((leaf(AuthorityStmtPositionalParams), at)),
    // Remaining declaration/lowering lanes are deliberately ineligible.
    _ => None
  }
}

/// Compatibility validator. It delegates to the same exhaustive constructor
/// walk used by the source-owning aggregate and discards only the data tree.
export fn validate_program_binder_rows(program: Array[Stmt], rows: Array[SourceBinder], source: String) -> Bool {
  match build_program_binder_authority(program = program, rows = rows, source = source) {
    Some(_) => true,
    None => false
  }
}

fn stored_authority_slots(slots: Array[BinderAuthoritySlot], at: Int) -> StoredBinderAuthority {
  if at >= Array::length(slots) {
    StoredAuthorityNil
  } else {
    StoredAuthoritySlot(Array::get(slots, at = at), stored_authority_slots(slots = slots, at = at + 1))
  }
}

fn stored_authority_node(_ node: BinderAuthorityNode) -> StoredBinderAuthority {
  StoredAuthorityNode(node.kind, stored_authority_slots(slots = node.slots, at = 0), stored_authority_nodes(nodes = node.children, at = 0),)
}

fn stored_authority_nodes(nodes: Array[BinderAuthorityNode], at: Int) -> StoredBinderAuthority {
  if at >= Array::length(nodes) {
    StoredAuthorityNil
  } else {
    StoredAuthorityChild(stored_authority_node(Array::get(nodes, at = at)), stored_authority_nodes(nodes = nodes, at = at + 1))
  }
}

fn build_program_binder_authority(program: Array[Stmt], rows: Array[SourceBinder], source: String) -> Option[Array[BinderAuthorityNode]] {
  let nodes = ArrayBuilder::new()
  let mut next = 0
  for stmt in program {
    match validate_stmt(stmt = stmt, rows = rows, source = source, at = next) {
      Some(result) => {
        ArrayBuilder::push(nodes, value = result.0)
        next = result.1
      },
      None => return None
    }
  }
  if next == Array::length(rows) {
    Some(ArrayBuilder::freeze(nodes))
  } else None
}

//# Source-owning authority entry

/// Only this entry owns lexing, context creation, parse-to-EOF, and the direct
/// validation control flow that can publish the aggregate. All exposed values
/// and accessors remain forgeable data.
export fn parse_source_located_with_binder_authority(_ source: String) -> Option[LocatedProgramBinderAuthority] with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let context = binder_capture_context(starts = starts, ends = ends)
  let (program, next) = parse_program_located_with_untrusted_binder_context(tokens = tokens, starts = starts, source = source, context = Some(context))
  let rows = binder_capture_rows(context)
  if match peek(tokens = tokens, pos = next) {
    TEof => true,
    _ => false
  } && binder_capture_is_eligible(context) {
    match build_program_binder_authority(program = program, rows = rows, source = source) {
      Some(nodes) => Some(LocatedProgramBinderAuthority::{
        source: source,
        program: StoredLocatedProgramValue(program),
        binders: rows,
        nodes: stored_authority_nodes(nodes = nodes, at = 0)
      }),
      None => None
    }
  } else None
}
