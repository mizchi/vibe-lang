//# Imports

import @vibe/ast {
  Expr, Pat
}

import ./parser_base.vibe {
  _no_tb, _no_tp, empty_exprs, expect_tk, is_expr_end_token, is_non_pipe_infix, parse_pattern_with_binder_context, peek
}

import ./parser_expr_primary.vibe {
  parse_primary_with_binder_context
}

import ./token.vibe {
  Token
}

import ./parser_binder_context.vibe {
  ParserBinderContext, binder_capture_insert_synthetic_at, binder_capture_mark, binder_capture_source
}

//# Functions

fn binop_op(tok: Token) -> String with Exception {
  match tok {
    TOr => "||",
    TAnd => "&&",
    TPipeGt => "|>",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TBitOr => "|",
    TBitXor => "^",
    TBitAnd => "&",
    TLShift => "<<",
    TRShift => ">>",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    _ => throw("internal parser error: not a binary operator")
  }
}

fn binop_prec(tok: Token) -> Int {
  match tok {
    TOr => 0,
    TAnd => 1,
    TPipeGt => 2,
    TEqEq => 3,
    TNeq => 3,
    TLt => 3,
    TLte => 3,
    TGt => 3,
    TGte => 3,
    TBitOr => 4,
    TBitXor => 5,
    TBitAnd => 6,
    TLShift => 7,
    TRShift => 7,
    TPlus => 8,
    TMinus => 8,
    TStar => 9,
    TSlash => 9,
    TPercent => 9,
    _ => -1
  }
}

/// Extract the source char offset of a callee expression so that the ECall
/// node can carry the call-site offset (callee start). Mirrors how EIdent
/// threads `offset_at(starts, pos)`. Falls back to -1 for callees that do
/// not carry an offset (synthetic / nested forms).
fn callee_offset(callee: Expr) -> Int {
  match callee {
    EIdent(_, off) => off,
    EDot(inner, _, off, _) => if off >= 0 {
      off
    } else {
      callee_offset(inner)
    },
    ECall(inner, _, off) => if off >= 0 {
      off
    } else {
      callee_offset(inner)
    },
    _ => -1
  }
}

/// Source char offset of the token at `p` (#645: the field-name token of an
/// EDot). Mirrors parser_expr_primary's offset_at; -1 when `starts` has no
/// entry (offset-less parse entry points).
fn field_offset_at(starts: Array[Int], p: Int) -> Int {
  if p >= 0 && p < Array::length(starts) {
    Array::get(starts, p)
  } else {
    -1
  }
}

fn index_expr(cur_expr: Expr, idx: Expr) -> Expr {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, idx)
  ECall(EIdent("__index", -1), args, -1)
}

/// `x |> f(a, _)` substitutes the piped value at each bare `_` placeholder
/// (`f(a, x)`) instead of prepending. With no `_`, the piped value is
/// prepended as the first argument (`x |> f(a)` => `f(x, a)`). Bare `_`
/// call arguments are preserved as `EIdent("_")` holes by
/// `desugar_placeholder_args`; compound placeholders like `_ * 2` are already
/// lowered to section lambdas before they reach here.
fn pipe_arg_is_hole(arg: Expr) -> Bool {
  match arg {
    EIdent(n, _) => n == "_",
    _ => false
  }
}

fn pipe_desugar(lhs: Expr, rhs: Expr) -> Expr {
  match rhs {
    ECall(callee, args, off) => {
      let mut has_hole = false
      let mut i = 0
      while i < Array::length(args) {
        if pipe_arg_is_hole(Array::get(args, i)) {
          has_hole = true
          i = Array::length(args)
        } else {
          i = i + 1
        }
      }
      if has_hole {
        let out = empty_exprs()
        let mut j = 0
        while j < Array::length(args) {
          let a = Array::get(args, j)
          if pipe_arg_is_hole(a) {
            Array::push(out, lhs)
          } else {
            Array::push(out, a)
          }
          j = j + 1
        }
        ECall(callee, out, off)
      } else {
        ECall(callee, Array::concat([lhs], args), off)
      }
    },
    _ => {
      // #770: route the bare-callee case through the same `Array::concat`
      // path as the arg-bearing case above. Storing an array *literal*
      // `[lhs]` directly as the ECall args field trips an RC double-free when
      // `lhs` is a value accumulated through `parse_infix_loop`'s tail
      // recursion (chained `a |> f |> g`): the literal aliases the moved
      // accumulator without a retain, so printing the resulting tree later
      // reads freed memory. `Array::concat` dups its inputs, so the same
      // single-element array built via concat is RC-safe. `off` is hoisted so
      // `rhs` is read once before being moved into the ECall callee slot.
      let off = callee_offset(rhs)
      ECall(rhs, Array::concat([lhs], empty_exprs()), off)
    }
  }
}

fn parse_call_arg(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TThinArrow => {
        binder_capture_source(context, name, pos, pos)
        let (body, end) = parse_recur(tokens, pos + 2, 0, context)
        (EFn(_no_tp(), _no_tb(), [(name, None)], None, None, body), end)
      },
      TTilde => match peek(tokens, pos + 2) {
        TEq => {
          let (val, end) = parse_recur(tokens, pos + 3, 0, context)
          (ELabeledArg(name, "~", val), end)
        },
        _ => parse_recur(tokens, pos, 0, context)
      },
      TQuestion => match peek(tokens, pos + 2) {
        TEq => {
          let (val, end) = parse_recur(tokens, pos + 3, 0, context)
          (ELabeledArg(name, "?", val), end)
        },
        _ => parse_recur(tokens, pos, 0, context)
      },
      TEq => {
        let (val, end) = parse_recur(tokens, pos + 2, 0, context)
        (ELabeledArg(name, "~", val), end)
      },
      _ => parse_recur(tokens, pos, 0, context)
    },
    _ => parse_recur(tokens, pos, 0, context)
  }
}

/// Recurses into nested EBinOp trees so placeholders buried below the
/// top-level operator (e.g. `_ % 2 == 0`, where `_` sits inside the `%`
/// sub-expression of the outer `==`) are still detected.
fn has_placeholder_arg(arg: Expr) -> Bool {
  match arg {
    EIdent(n, _) => n == "_",
    EBinOp(_, l, r) => has_placeholder_arg(l) || has_placeholder_arg(r),
    _ => false
  }
}

fn slice_from_idx_expr(cur_expr: Expr, idx: Expr, end_expr: Expr) -> Expr {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, idx)
  Array::push(args, end_expr)
  ECall(EIdent("__slice", -1), args, -1)
}

fn has_placeholder_args(args: Array[Expr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(args) {
    if has_placeholder_arg(Array::get(args, i)) {
      found = true
      i = Array::length(args)
    } else {
      i = i + 1
    }
  }
  found
}

fn parse_call_args_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], row_marks: Option[ArrayBuilder[Int]], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[Expr], Int) with Exception {
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TComma => match peek(tokens, p + 1) {
        TRParen => {
          p = p + 1
          done = true
        },
        _ => {
          match row_marks {
            Some(marks) => ArrayBuilder::push(marks, binder_capture_mark(context)),
            None => ()
          }
          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur, context)
          ArrayBuilder::push(b, e)
          p = next
        }
      }
      ,
      _ => {
        done = true
      }
    }
  }
  (ArrayBuilder::freeze(b), p)
}

fn slice_from_zero_expr(cur_expr: Expr, end_expr: Expr) -> Expr {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, EInt(0))
  Array::push(args, end_expr)
  ECall(EIdent("__slice", -1), args, -1)
}

fn wrap_placeholder_arg(arg: Expr, _context: Option[ParserBinderContext]) -> Expr {
  let mut pc = 0
  let params = Array::slice([("", None)], 0, 0)
  // Walks nested EBinOp trees (mirrors has_placeholder_arg) so every `_`
  // hole, however deeply nested under binary operators, becomes its own
  // lambda parameter in left-to-right order.
  let rec replace_placeholders: (Expr) -> Expr = (e) -> {
    match e {
      EIdent(n, _) => if n == "_" {
        let pn = String::concat("__ph", __to_string(pc))
        Array::push(params, (pn, None))
        pc = pc + 1
        EIdent(pn, -1)
      } else {
        e
      }
      ,
      EBinOp(op, l, r) => {
        let nl = replace_placeholders(l)
        let nr = replace_placeholders(r)
        EBinOp(op, nl, nr)
      },
      _ => e
    }
  }
  let replaced = replace_placeholders(arg)
  EFn(_no_tp(), _no_tb(), params, None, None, replaced)
}

fn has_non_pipe_infix_top(tokens: Array[Token], start: Int, end: Int) -> Bool {
  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {
    if i >= end {
      false
    } else {
      let tok = peek(tokens, i)
      if depth == 0 {
        if is_non_pipe_infix(tok) {
          if prev_top_end {
            true
          } else {
            go(i + 1, 0, false)
          }
        } else {
          match tok {
            TLParen => go(i + 1, 1, false),
            TLBracket => go(i + 1, 1, false),
            TLBrace => go(i + 1, 1, false),
            _ => go(i + 1, 0, is_expr_end_token(tok))
          }
        }
      } else {
        match tok {
          TLParen => go(i + 1, depth + 1, prev_top_end),
          TLBracket => go(i + 1, depth + 1, prev_top_end),
          TLBrace => go(i + 1, depth + 1, prev_top_end),
          TRParen => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          TRBracket => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          TRBrace => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          _ => go(i + 1, depth, prev_top_end)
        }
      }
    }
  }
  go(start, 0, false)
}

fn placeholder_count(arg: Expr) -> Int {
  match arg {
    EIdent(n, _) => if n == "_" {
      1
    } else {
      0
    },
    EBinOp(_, l, r) => placeholder_count(l) + placeholder_count(r),
    _ => 0
  }
}

fn insert_placeholder_rows(args: Array[Expr], row_marks: Array[Int], context: Option[ParserBinderContext]) -> Unit {
  let mut i = Array::length(args) - 1
  while i >= 0 {
    let arg = Array::get(args, i)
    if !pipe_arg_is_hole(arg) {
      let mut p = placeholder_count(arg) - 1
      while p >= 0 {
        binder_capture_insert_synthetic_at(context, Array::get(row_marks, i), String::concat("__ph", __to_string(p)))
        p = p - 1
      }
    } else {
      ()
    }
    i = i - 1
  }
}

fn desugar_placeholder_args(args: Array[Expr], context: Option[ParserBinderContext]) -> Array[Expr] {
  let out = Array::slice([EUnit], 0, 0)
  let mut i = 0
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if pipe_arg_is_hole(arg) {
      // Bare `_` stays a hole so a surrounding `|>` can substitute the
      // piped value at this position; compound placeholders still lower.
      Array::push(out, arg)
    } else if has_placeholder_arg(arg) {
      Array::push(out, wrap_placeholder_arg(arg, context))
    } else {
      Array::push(out, arg)
    }
    i = i + 1
  }
  out
}

/// #960: `Map::new()` / `Map::from_pairs([("k", v), ...])` are the ONLY
/// spellings for building a string-keyed map (Stage 2 removed the
/// `map { ... }` literal; the printer emits these spellings for EMap). They
/// are desugared HERE, at the parse-postfix call-build site — the same layer
/// as the `throw(x)` -> `perform Exception::Throw(x)` desugar (#640 Stage 2) —
/// into the exact `EMap` node the literal used to produce, so every
/// downstream stage (checker, normalize, both codegen backends) sees ONE
/// form and needs ZERO changes. Parse-level
/// placement also keeps the two names from ever reaching the checker's
/// generic `Map::` builtin lookup (a residual non-call mention, e.g.
/// `x |> Map::from_pairs`, is rejected there as `unknown name` — an error,
/// never a silent miscompile). Only an array LITERAL of (string-literal,
/// value) tuple LITERALS is accepted for now; anything else throws a located
/// parse error. `pos` is the token index of the call's `(`, the "at #N"
/// located-diagnostic anchor (#816).
fn empty_map_fields() -> Array[(String, Expr)] {
  Array::slice([("", EUnit)], 0, 0)
}

fn map_from_pairs_fields(args: Array[Expr], pos: Int) -> Array[(String, Expr)] with Exception {
  if Array::length(args) != 1 {
    throw("Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\{pos}")
  }
  match Array::get(args, 0) {
    EArray(elems) => {
      let b = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(elems) {
        match Array::get(elems, i) {
          ETuple(kv) => if Array::length(kv) == 2 {
            match Array::get(kv, 0) {
              EString(k) => ArrayBuilder::push(b, (k, Array::get(kv, 1))),
              _ => throw("Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): pair key is not a string literal at #\{pos}")
            }
          } else {
            throw("Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each pair must be a 2-tuple literal at #\{pos}")
          },
          _ => throw("Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each element must be a tuple literal at #\{pos}")
        }
        i = i + 1
      }
      ArrayBuilder::freeze(b)
    },
    _ => throw("Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\{pos}")
  }
}

/// #2231: `lparen_off` is the source offset of the `(` that opens this call's
/// argument list, used ONLY when the callee carries none of its own.
///
/// The ECall offset is the key `CompileCtx.float_call_offsets` uses to hand
/// codegen the checker's per-call-site `Double` answer (#2158), and the
/// checker records an occurrence only when the offset is >= 0. A callee that
/// is not a name has no offset to lend -- an immediately-invoked lambda is the
/// smallest such shape -- so its call was never recorded, and a `Double`
/// returned through one printed its raw f64 bits.
///
/// The callee's own offset is still preferred where it exists: `[@off=N:M]`
/// diagnostics point at the callee (#1514), which is the better edit point,
/// and moving every call to the `(` would move all of them.
fn build_call_expr(expr: Expr, args: Array[Expr], pos: Int, lparen_off: Int) -> Expr with Exception {
  let ctor_name = match expr {
    EIdent(name, _) => name,
    _ => ""
  }
  if ctor_name == "Map::new" {
    if Array::length(args) == 0 {
      EMap(empty_map_fields())
    } else {
      throw("Map::new takes no arguments (#960): use Map::from_pairs([(\"key\", value), ...]) to build a non-empty map at #\{pos}")
    }
  } else if ctor_name == "Map::from_pairs" {
    EMap(map_from_pairs_fields(args, pos))
  } else {
    let own = callee_offset(expr)
    ECall(expr, args, if own >= 0 {
      own
    } else {
      lparen_off
    })
  }
}

fn parse_postfix(tokens: Array[Token], starts: Array[Int], pos: Int, expr: Expr, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TLParen => match expr {
      // NOTE: an ECall left is deliberately NOT blocked here — a same-line
      // `(` after a call/index result is a chained call (`f()()`, `arr[i](x)`,
      // `f()()()`). The statement-boundary case (`f(1)` then `(2)` on the next
      // line) is already separated by the lexer, which inserts a synthetic `;`
      // for a newline-then-`(` after an expr-ending token (see is_expr_ending_tok
      // + the synthetic-`;` insertion in lexer.vibe), so no newline-merge can
      // reach here. `arr[i]` desugars to `ECall(__index, ...)`, so this also
      // enables subscript-then-call.
      EArray(_) => (expr, pos),
      ETuple(_) => (expr, pos),
      ERecord(_, _, _) => (expr, pos),
      EMap(_) => (expr, pos),
      EInt(_) => (expr, pos),
      EFloat(_) => (expr, pos),
      EString(_) => (expr, pos),
      EStringInterp(_) => (expr, pos),
      EBool(_) => (expr, pos),
      EUnit => (expr, pos),
      EWhile(_, _) => (expr, pos),
      EIf(_, _, _) => (expr, pos),
      EMatch(_, _) => (expr, pos),
      ELoop(_, _) => (expr, pos),
      EForIn(_, _, _, _) => (expr, pos),
      EHandle(_, _) => (expr, pos),
      _ => match peek(tokens, pos + 1) {
        TRParen => parse_postfix(tokens, starts, pos + 2, build_call_expr(expr, empty_exprs(), pos, field_offset_at(starts, pos)), parse_recur, context),
        _ => {
          let b = ArrayBuilder::new()
          let row_marks = match context {
            Some(_) => Some(ArrayBuilder::new()),
            None => None
          }
          match row_marks {
            Some(marks) => ArrayBuilder::push(marks, binder_capture_mark(context)),
            None => ()
          }
          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur, context)
          ArrayBuilder::push(b, first_arg)
          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, row_marks, parse_recur, context)
          let close_pos = expect_tk(tokens, end_pos, ")")
          let call_args = if has_placeholder_args(args) {
            match row_marks {
              Some(marks) => insert_placeholder_rows(args, ArrayBuilder::freeze(marks), context),
              None => ()
            }
            desugar_placeholder_args(args, context)
          } else {
            args
          }
          parse_postfix(tokens, starts, close_pos, build_call_expr(expr, call_args, pos, field_offset_at(starts, pos)), parse_recur, context)
        }
      },
    },
    TLBracket => match peek(tokens, pos + 1) {
      TColon => match peek(tokens, pos + 2) {
        TRBracket => {
          let end_expr = ECall(EIdent("__len", -1), [expr], -1)
          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur, context)
        },
        _ => {
          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0, context)
          let close_pos = match peek(tokens, end_next) {
            TRBracket => end_next + 1,
            _ => throw("expected ']'")
          }
          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur, context)
        }
      },
      _ => {
        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0, context)
        match peek(tokens, idx_next) {
          TColon => match peek(tokens, idx_next + 1) {
            TRBracket => {
              let end_expr = ECall(EIdent("__len", -1), [expr], -1)
              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur, context)
            },
            _ => {
              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0, context)
              let close_pos = match peek(tokens, end_next) {
                TRBracket => end_next + 1,
                _ => throw("expected ']'")
              }
              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur, context)
            }
          },
          _ => {
            let close_pos = match peek(tokens, idx_next) {
              TRBracket => idx_next + 1,
              _ => throw("expected ']'")
            }
            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur, context)
          }
        }
      }
    },
    TDot => match peek(tokens, pos + 1) {
      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur, context),
      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur, context),
      _ => (expr, pos)
    },
    // `expr?` (railway try, #635): emit the type-directed sentinel
    // `__try_op(expr)` that the pre-check desugar lowers by `expr`'s head type —
    // Option -> yield inner on Some, early-`return None` on None; Result (the
    // default) -> yield inner on Ok, early-`return Err(e)` on Err. The parser
    // has no type info, so it defers the choice to the desugar. Continue postfix
    // parsing so `f(x)?.field` chains.
    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent("__try_op", -1), [
      expr
    ], -1), parse_recur, context),
    _ => (expr, pos)
  }
}

fn parse_prefix(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TMinus => {
      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur, context)
      (EUnaryOp("-", e), next)
    },
    TNot => {
      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur, context)
      (EUnaryOp("!", e), next)
    },
    _ => {
      let (e, next) = parse_primary_with_binder_context(tokens, starts, pos, parse_recur, context)
      parse_postfix(tokens, starts, next, e, parse_recur, context)
    }
  }
}

/// #760(5): a loop-form expression (while / loop / for-in) evaluates to Unit,
/// so it can never be a meaningful left operand of an infix operator. When one
/// appears at statement position followed by a new line beginning with `-`/`+`
/// (e.g. a bare `-1` after a `while` loop, or `return -1` mis-split), the
/// greedy infix ladder used to fold it into `loop_result - 1`, which then failed
/// as `Unit - Int`. Treat such a left as a completed statement and stop the
/// ladder, so the `-1` parses as the next statement's unary-minus literal.
fn left_is_stmt_form(e: Expr) -> Bool {
  match e {
    EWhile(_, _) => true,
    ELoop(_, _) => true,
    EForIn(_, _, _, _) => true,
    _ => false
  }
}

/// #979: `is` used to be checked ONLY once, after the whole infix ladder
/// (including `&&`/`||`) had already folded -- so `a && b is None` parsed as
/// `(a && b) is None` instead of the natural `a && (b is None)`. `is` now
/// binds at the same tier as the comparison operators (tier 3: `==`, `<`,
/// ...), i.e. strictly tighter than `&&`/`||`/`|>` (tiers 0-2) and no
/// tighter than arithmetic/bitwise (tiers 4-9) -- matching how a normal
/// comparison composes with the rest of the ladder. `is_is_token` recognizes
/// both the dedicated `TIs` keyword token and (defensively, matching the
/// pre-existing fallback below) a soft-keyword `TIdent("is")`.
fn is_is_token(tok: Token) -> Bool {
  match tok {
    TIs => true,
    TIdent(kw) => kw == "is",
    _ => false
  }
}

fn parse_infix_loop(tokens: Array[Token], starts: Array[Int], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool, consume_is: Bool, is_top_atom: Bool, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let tok = peek(tokens, next)
  if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) && is_top_atom {
    // #979 review (if-cond): a trailing `is pattern` on the UNFOLDED top
    // atom (nothing combined onto `left` yet, e.g. bare `x is Some(v)`) is
    // left unconsumed here for `parse_infix_if_cond`'s caller to special-case
    // as the `if EXPR is PAT { bind } ` binding form. Once anything has been
    // folded onto `left` (a `&&`/`||`/comparison/... already applied,
    // `is_top_atom` false) or we're in a plain (non-if-cond) expression
    // (`is_top_atom` always false from `parse_infix`), `is` falls through to
    // the normal tier-3 fold below and yields a plain Bool with no binding.
    (left, next)
  } else if consume_is && !cmp_locked && 3 >= min_prec && is_is_token(tok) {
    // Attach `is pattern` directly to `left` at comparison tightness, then
    // keep looping (cmp_locked, like a comparison, so a further `is`/`==`
    // right after would need explicit parens) so the resulting Bool can
    // still fold into an enclosing `&&`/`||`/`|>` at a looser tier.
    let (pat, pn) = parse_pattern_with_binder_context(tokens, next + 1, context)
    let combined = EMatch(left, [(pat, EBool(true)), (PWild, EBool(false))])
    parse_infix_loop(tokens, starts, combined, pn, min_prec, expr_start, true, consume_is, false, parse_recur, context)
  } else {
    let prec = binop_prec(tok)
    let should_stop = if prec < min_prec {
      true
    } else if cmp_locked {
      prec == 3
    } else if left_is_stmt_form(left) {
      // #760(5): a loop-form (while/loop/for-in) at statement position must not
      // swallow a trailing unary `-1`/`+1` on the next line as binary +/-. Only
      // `+`/`-` are ambiguous (they double as unary prefixes that begin a fresh
      // statement); an unambiguously-infix operator must still fold, so a
      // for-expression (which yields an array) stays pipeable, e.g.
      // `(for x in xs { x }) |> Array::length`. (#763 review)
      match tok {
        TPlus => true,
        TMinus => true,
        _ => false
      }
    } else {
      false
    }
    if should_stop {
      (left, next)
    } else {
      let is_pipe = match tok {
        TPipeGt => true,
        _ => false
      }
      let op = binop_op(tok)
      if is_pipe {
        if has_non_pipe_infix_top(tokens, expr_start, next) {
          throw("cannot mix '|>' with other infix operators without explicit parentheses")
        }
      }
      let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur, context)
      let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, consume_is, false, parse_recur, context)
      if is_pipe {
        if has_non_pipe_infix_top(tokens, next + 1, rn) {
          throw("cannot mix '|>' with other infix operators without explicit parentheses")
        }
      }
      let combined = if is_pipe {
        pipe_desugar(left, right)
      } else {
        EBinOp(op, left, right)
      }
      let next_cmp_locked = if prec == 3 {
        true
      } else {
        cmp_locked
      }
      parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, consume_is, false, parse_recur, context)
    }
  }
}

/// #979 P2 follow-up (Codex): `parse_infix_no_is` used to disable `is`
/// consumption at EVERY tier, so a nested `is` inside a `&&`/`||` (e.g.
/// `if ready && value is None { ... }`) never folded at comparison
/// tightness either -- the whole `ready && value` folded first (since `is`
/// wasn't recognized as an operator anywhere in this ladder), and the
/// trailing `is None` then bound against that whole (Bool) expression,
/// reproducing exactly the bug this issue's main fix already closed for
/// plain (non-if) expressions. Fixed by reusing the SAME tier-3 `is` fold
/// as `parse_infix` (`consume_is = true`, so `value is None` folds onto
/// `value` before combining with `&&`), gated by `is_top_atom = true`: a
/// trailing `is pattern` is left UNCONSUMED here only when it appears
/// directly on the unfolded top atom (nothing combined yet, e.g. bare
/// `x is Some(v)`) -- exactly the shape `parse_impl_dispatch` mode_if's
/// caller (below) still special-cases into the `if EXPR is PAT { bind }`
/// binding form. Once anything (`&&`/`||`/a comparison/...) has already
/// folded onto `left`, `is_top_atom` flips to `false` (see
/// `parse_infix_loop` above) and a subsequent `is` folds as a normal
/// tier-3 Bool test with no binding -- so `if ready && value is None { }`
/// now parses as `if (ready && (value is None)) { }`, matching the
/// documented precedence, while `if x is Some(v) { use(v) }` still binds
/// `v` in the then-branch exactly as before.
export fn parse_infix_no_is_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur, context)
  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, true, parse_recur, context)
}

export fn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with Exception) -> (Expr, Int) with Exception {
  let adapted = (rtoks, rpos, rmode, _context) -> parse_recur(rtoks, rpos, rmode)
  parse_infix_no_is_with_binder_context(tokens, starts, pos, min_prec, expr_start, adapted, None)
}

/// #979: `is` is folded directly into the precedence ladder (tier 3, same as
/// `==`/`<`/...) instead of being checked only once at the very end, so
/// `a && b is None` now parses as `a && (b is None)` rather than
/// `(a && b) is None`. `is_top_atom = false` unconditionally here -- outside
/// an if-condition there is no special pattern-binding form, so even a bare
/// `x is Some(v)` folds straight to a Bool `EMatch` with no binding.
export fn parse_infix_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur, context)
  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, true, false, parse_recur, context)
}

export fn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with Exception) -> (Expr, Int) with Exception {
  let adapted = (rtoks, rpos, rmode, _context) -> parse_recur(rtoks, rpos, rmode)
  parse_infix_with_binder_context(tokens, starts, pos, min_prec, expr_start, adapted, None)
}
