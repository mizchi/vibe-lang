//# Functions

let no_dispatch_binder_rows: Array[SourceBinder] = []

/// Wrap `val` so that `((__asc: ty) -> __asc)(val)` forces `val` to have type
/// `ty` (enforced by the call-argument check) while evaluating to `val` itself.
/// Used to type-check a local `let x: T = e`, whose annotation `ELet` cannot
/// store. Uses only EFn/ECall, so every downstream pass handles it unchanged.
///
/// `binder_off` is the byte offset of the binder NAME. The synthetic ECall used
/// to carry `-1`, which was fine while the checker anchored its mismatch on the
/// bound value -- until the bound value is a literal, and literals have no
/// offset slot. `let a: Int = "not an int"` then came out with no `line:col` at
/// all, on both `vibe check` lanes, which is the most basic type error a
/// newcomer writes. The binder name is an identifier, so it always has one.
/// The checker still prefers the value's own offset when the value has one
/// (checker.vibe, `asc_off`) -- this is the fallback, not a replacement.
fn ascribe_wrap(val: Expr, ty: TypeExpr, capture_mark: Int, context: Option[ParserBinderContext], binder_off: Int) -> Expr {
  binder_capture_insert_synthetic_at(context, capture_mark, "__asc")
  let tparams = _no_tp()
  let tbounds = _no_tb()
  let params = [("__asc", Some(ty))]
  let lam = EFn(tparams, tbounds, params, None, None, EIdent("__asc", 0 - 1))
  ECall(lam, [val], binder_off)
}

/// #705: a local `let f: (A) -> R = (x) -> ..` must behave like the top-level
/// form (parse_let_stmt / apply_generic_let_annotation): distribute the TyFn
/// annotation onto the lambda's unannotated params / ret / effect. Hiding the
/// lambda behind ascribe_wrap's `((__asc: T) -> __asc)(lam)` instead means the
/// Perceus param heap-inference (fill_lambda_params / param_is_heap_in_body)
/// never sees an annotation for the lambda's params, plans a heap param as
/// scalar, and under-provisions its rc dups -- the callee-owns drops inside the
/// body then free a still-live argument (use-after-free under VIBE_RC=1).
/// Returns None when the annotation is not a TyFn, the value is not a lambda,
/// or the arity does not match; callers fall back to ascribe_wrap (plain let)
/// or the bare value (let rec, which previously discarded the annotation).
fn distribute_local_fn_ann(ann_ty: TypeExpr, val: Expr, context: Option[ParserBinderContext]) -> Option[Expr] {
  match ann_ty {
    TyFn(param_types, ret_ty, effect_name) => match val {
      EFn(tp, tb, params, ret_opt, effect_opt, body) => {
        if Array::length(params) != Array::length(param_types) {
          None
        } else {
          let out = ArrayBuilder::new()
          let mut i = 0
          while i < Array::length(params) {
            let (pname, pann) = Array::get(params, i)
            let next_ann = match pann {
              Some(_) => pann,
              None => Some(Array::get(param_types, i))
            }
            ArrayBuilder::push(out, (pname, next_ann))
            i = i + 1
          }
          let next_ret = match ret_opt {
            Some(_) => ret_opt,
            None => Some(ret_ty)
          }
          let next_eff = match effect_opt {
            Some(_) => effect_opt,
            None => effect_name
          }
          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))
        }
      },
      _ => None
    },
    _ => None
  }
}

/// #789: `[T: A + B]` trait references (first name at `pos`).
fn dispatch_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with Exception {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(bname) => {
        ArrayBuilder::push(b, bname)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

/// #789: parse a `[T, U: Bound]` binder (`[` already consumed; first name token at
/// `pos`). Private copy of parser_base.parse_method_type_params. Returns
/// (type-param names, per-param bounds, next-after-`]`).
fn dispatch_type_params_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[String], Array[(String, Array[String])], Int) with Exception {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        done = true
      },
      TIdent(name) => {
        binder_capture_source(context, name, p, p)
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = dispatch_tp_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            done = true
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

/// #789: parse a local `let f: TYPE = ..` annotation, consuming an optional
/// generic binder `[T, U: Bound]` first (like the top-level parse_let_annotation /
/// parse_let_type_params, which the local block-let path previously lacked — a
/// leading `[` gave `expected type but got [`). `pos` is the first annotation
/// token (just after `:`). Returns (type-param names, per-param bounds, type,
/// next position).
fn parse_local_let_annotation_with_binder_context(tokens: Array[Token], pos: Int, context: Option[ParserBinderContext]) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with Exception {
  match peek(tokens, pos) {
    TLBracket => {
      let (tps, tbs, after_binder) = dispatch_type_params_with_binder_context(tokens, pos + 1, context)
      let (ty, next) = parse_type_impl(tokens, after_binder, 0)
      (tps, tbs, ty, next)
    },
    _ => {
      let (ty, next) = parse_type_impl(tokens, pos, 0)
      let no_tp = _no_tp()
      let no_tb = _no_tb()
      (no_tp, no_tb, ty, next)
    }
  }
}

/// #789: attach a local generic-let's `[T]` binder to its (annotation-distributed)
/// lambda, mirroring apply_generic_fn_annotation so the local function stays
/// polymorphic. No-op when there are no type params or the value is not a lambda.
fn apply_local_let_tp(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr, annotation_mark: Int, value_mark: Int, context: Option[ParserBinderContext]) -> Expr {
  let annotation_count = Array::length(tps)
  if annotation_count > 0 {
    match val {
      EFn(existing_tps, _, params, ret, eff, body) => {
        // The annotation header supplies the final EFn header. A direct value
        // generic-lambda header is later in the row log, so remove it first.
        binder_capture_discard_segment(context, value_mark, value_mark + Array::length(existing_tps))
        EFn(tps, tbs, params, ret, eff, body)
      },
      _ => {
        binder_capture_discard_segment(context, annotation_mark, annotation_mark + annotation_count)
        val
      }
    }
  } else {
    val
  }
}

/// #644: source char offset of the token at `p` (the `let` keyword of a block
/// statement) -- ELet/ELetMut carry it so break-mode codegen can emit a
/// dbg_line probe even when the bound value is a bare literal with no offset.
fn blk_offset_at(starts: Array[Int], p: Int) -> Int {
  if p >= 0 && p < Array::length(starts) {
    Array::get(starts, p)
  } else {
    -1
  }
}

enum BlockStep {
  StepSeq(Expr);
  StepValue(Expr);
  StepLet(String, Expr, Int);
  StepLetMut(String, Expr, Int);
  StepLetRec(String, Expr);
  StepAssign(String, Expr);
  StepAssignOp(String, String, Expr);
  StepPattern(Pat, Expr);
  StepPatternElse(Pat, Expr, Expr, Array[SourceBinder]);
  StepStructDestr(Pat, Expr);
  StepRecordDestr(Pat, Expr);
  StepBind(String, Expr, Int)
}

/// #666: desugar match-arm guards into existing constructs. `arms` is the
/// collected arm list as (pattern, guard-or-EBool(true)-sentinel, body). A
/// guarded arm `pat if g => body` becomes `pat => if g { body } else { match
/// scrut { remaining } }` so a FAILED guard falls through to later arms; the
/// remaining arms are also appended (for the pattern-doesn't-match case). The
/// guard's Bool-check and codegen come for free via `EIf`. `scrut` must be a
/// re-evaluable reference (the caller binds the scrutinee to a temp), so the
/// nested match never re-runs a side-effecting scrutinee.
fn desugar_guarded(arms: Array[(Pat, Expr, Expr)], i: Int, scrut: Expr, context: Option[ParserBinderContext]) -> Array[(Pat, Expr)] {
  if i >= Array::length(arms) {
    empty_arms()
  } else {
    let (pat, arm_guard, body) = Array::get(arms, i)
    let rest = desugar_guarded(arms, i + 1, scrut, context)
    let no_guard = match arm_guard {
      EBool(bv) => bv,
      _ => false
    }
    let arm_body = if no_guard {
      body
    } else {
      EIf(arm_guard, body, EMatch(scrut, rest))
    }
    let out = ArrayBuilder::new()
    ArrayBuilder::push(out, (pat, arm_body))
    let mut j = 0
    while j < Array::length(rest) {
      ArrayBuilder::push(out, Array::get(rest, j))
      j = j + 1
    }
    ArrayBuilder::freeze(out)
  }
}

/// #666: parse all match arms into `b` as (pattern, guard|EBool(true), body).
/// A negative return encodes `-end - 1` when any arm carries a guard, avoiding
/// an allocation-only mutable Bool cell on the ordinary no-capture path.
fn collect_match_arms(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(Pat, Expr, Expr)], row_b: Option[ArrayBuilder[(Array[SourceBinder], Array[SourceBinder], Array[SourceBinder])]], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> Int with Exception {
  let pat_mark = binder_capture_mark(context)
  let (pat, pa) = parse_pattern_with_binder_context(tokens, pos, context)
  let pat_rows = binder_capture_take_from(context, pat_mark)
  let arm_has_guard = match peek(tokens, pa) {
    TIf => true,
    _ => false
  }
  let guard_mark = binder_capture_mark(context)
  let (arm_guard, after_g) = match peek(tokens, pa) {
    TIf => parse_recur(tokens, pa + 1, 0, context),
    _ => (EBool(true), pa)
  }
  let guard_rows = if arm_has_guard {
    binder_capture_take_from(context, guard_mark)
  } else {
    no_dispatch_binder_rows
  }
  let arrow = expect_tk(tokens, after_g, "=>")
  let body_mark = binder_capture_mark(context)
  let (body, bn) = parse_recur(tokens, arrow, 0, context)
  let body_rows = binder_capture_take_from(context, body_mark)
  ArrayBuilder::push(b, (pat, arm_guard, body))
  match row_b {
    Some(rows) => ArrayBuilder::push(rows, (pat_rows, guard_rows, body_rows)),
    None => ()
  }
  let encoded_end = match peek(tokens, bn) {
    TComma => match peek(tokens, bn + 1) {
      TRBrace => bn + 2,
      _ => collect_match_arms(tokens, starts, bn + 1, b, row_b, parse_recur, context)
    },
    TRBrace => bn + 1,
    _ => collect_match_arms(tokens, starts, bn, b, row_b, parse_recur, context)
  }
  if arm_has_guard && encoded_end >= 0 {
    0 - encoded_end - 1
  } else {
    encoded_end
  }
}

fn append_source_rows(out: ArrayBuilder[SourceBinder], rows: Array[SourceBinder]) -> Unit {
  for row in rows {
    ArrayBuilder::push(out, row)
  }
  ()
}

fn desugar_guarded_rows(arms: Array[(Pat, Expr, Expr)], rows: Array[(Array[SourceBinder], Array[SourceBinder], Array[SourceBinder])], i: Int) -> Array[SourceBinder] {
  if i >= Array::length(arms) {
    no_dispatch_binder_rows
  } else {
    let (_, arm_guard, _) = Array::get(arms, i)
    let (pat_rows, guard_rows, body_rows) = Array::get(rows, i)
    let rest = desugar_guarded_rows(arms, rows, i + 1)
    let no_guard = match arm_guard {
      EBool(bv) => bv,
      _ => false
    }
    let out = ArrayBuilder::new()
    append_source_rows(out, pat_rows)
    if no_guard {
      append_source_rows(out, body_rows)
    } else {
      append_source_rows(out, guard_rows)
      append_source_rows(out, body_rows)
      append_source_rows(out, rest)
    }
    append_source_rows(out, rest)
    ArrayBuilder::freeze(out)
  }
}

fn qualify_handle_arm_pattern(effect_name: String, pat: Pat, context: Option[ParserBinderContext]) -> Pat {
  match pat {
    PCtor(name, args) => if String::contains(name, "::") {
      PCtor(name, args)
    } else {
      PCtor(String::concat(effect_name, String::concat("::", name)), args)
    },
    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left, context), qualify_handle_arm_pattern(effect_name, right, context)),
    _ => pat
  }
}

fn parse_handle_arm(tokens: Array[Token], starts: Array[Int], pos: Int, effect_name: String, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> ((Pat, Expr), Int) with Exception {
  let (pat, pat_next) = parse_pattern_with_binder_context(tokens, pos, context)
  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat, context)
  let arrow_pos = expect_tk(tokens, pat_next, "=>")
  let (expr, next) = parse_recur(tokens, arrow_pos, 0, context)
  ((qualified_pat, expr), next)
}

fn parse_handle_rest(tokens: Array[Token], starts: Array[Int], pos: Int, body: Expr, effect_name: String, b: ArrayBuilder[(Pat, Expr)], parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),
      _ => {
        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur, context)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur, context)
      }
    },
    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),
    _ => throw("expected ';' or '}' in handle arm list")
  }
}

fn parse_block_after_expr(tokens: Array[Token], pos: Int, e: Expr, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  match peek(tokens, pos) {
    TRBrace => (e, pos + 1),
    TSemicolon => {
      let (rest, end) = parse_recur(tokens, pos + 1, 20, context)
      (ESeq(e, rest), end)
    },
    TEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssign(name, val, rest), end)
      },
      EDot(obj, field, _, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        let set_args = empty_exprs()
        Array::push(set_args, obj)
        Array::push(set_args, EString(field))
        Array::push(set_args, val)
        (ESeq(ECall(EIdent("__set_field", -1), set_args, -1), rest), end)
      },
      ECall(idx_callee, idx_args, _) => {
        // `arr[i] = v` (indexing parses as `__index(arr, i)`) desugars to
        // `Array::set(arr, i, v)` — host-era index assignment used across
        // vibe/shell and vibe/wasm sources previously died here with
        // "invalid assignment target". Array-only: a non-Array receiver
        // fails in the checker on Array::set's signature.
        let is_index = match idx_callee {
          EIdent(icn, _) => icn == "__index",
          _ => false
        }
        if is_index && Array::length(idx_args) == 2 {
          let val_pair = parse_recur(tokens, pos + 1, 0, context)
          let val = val_pair.0
          let val_next = val_pair.1
          let a = skip_semi(tokens, val_next)
          let (rest, end) = parse_recur(tokens, a, 20, context)
          let set_args = empty_exprs()
          Array::push(set_args, Array::get(idx_args, 0))
          Array::push(set_args, Array::get(idx_args, 1))
          Array::push(set_args, val)
          (ESeq(ECall(EIdent("Array::set", -1), set_args, -1), rest), end)
        } else {
          throw("invalid assignment target")
        }
      },
      _ => throw("invalid assignment target")
    },
    TPlusEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssignOp(name, "+", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TMinusEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssignOp(name, "-", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TStarEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssignOp(name, "*", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TSlashEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssignOp(name, "/", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TPercentEq => match e {
      EIdent(name, _) => {
        let val_pair = parse_recur(tokens, pos + 1, 0, context)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20, context)
        (EAssignOp(name, "%", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    _ => {
      let (rest, end) = parse_recur(tokens, pos, 20, context)
      if end <= pos {
        throw("internal parser error: block continuation did not advance")
      } else {
        (ESeq(e, rest), end)
      }
    }
  }
}

fn parse_block_value_body(tokens: Array[Token], eq: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Expr, Int, Int) with Exception {
  let val_pair = parse_recur(tokens, eq, 0, context)
  let val = val_pair.0
  let val_next = val_pair.1
  let a = skip_semi(tokens, val_next)
  let (body, end) = parse_recur(tokens, a, 20, context)
  (val, body, end, a)
}

fn parse_block_value_only(tokens: Array[Token], value_pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let val_pair = parse_recur(tokens, value_pos, 0, context)
  (val_pair.0, skip_semi(tokens, val_pair.1))
}

fn remap_struct_destr_rows(pat: Pat, rows: Array[SourceBinder], context: Option[ParserBinderContext]) -> Array[SourceBinder] {
  let out = ArrayBuilder::new()
  let mut at = 0
  match pat {
    PStruct(_, fields) => for field in fields {
      match field.1 {
        PBind(_) => {
          if at < Array::length(rows) {
            ArrayBuilder::push(out, Array::get(rows, at))
            at = at + 1
          } else {
            binder_capture_mark_ineligible(context)
          }
        },
        PWild => (),
        _ => binder_capture_mark_ineligible(context)
      }
    },
    _ => binder_capture_mark_ineligible(context)
  }
  if at != Array::length(rows) {
    binder_capture_mark_ineligible(context)
  } else {
    ()
  }
  ArrayBuilder::freeze(out)
}

fn remap_record_destr_rows(pat: Pat, rows: Array[SourceBinder], context: Option[ParserBinderContext]) -> Array[SourceBinder] {
  let out = ArrayBuilder::new()
  let mut at = 0
  match pat {
    PTuple(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        match Array::get(fields, i) {
          PBind(_) => {
            if at < Array::length(rows) {
              ArrayBuilder::push(out, Array::get(rows, at))
              at = at + 1
            } else {
              binder_capture_mark_ineligible(context)
            }
          },
          PWild => (),
          PTuple(sub) => {
            ArrayBuilder::push(out, Synthetic(String::concat("__rec_sub_", __to_string(i)), ParserSynthetic))
            for item in sub {
              match item {
                PBind(_) => {
                  if at < Array::length(rows) {
                    ArrayBuilder::push(out, Array::get(rows, at))
                    at = at + 1
                  } else {
                    binder_capture_mark_ineligible(context)
                  }
                },
                PWild => (),
                _ => binder_capture_mark_ineligible(context)
              }
            }
          },
          _ => binder_capture_mark_ineligible(context)
        }
        i = i + 1
      }
    },
    _ => binder_capture_mark_ineligible(context)
  }
  if at != Array::length(rows) {
    binder_capture_mark_ineligible(context)
  } else {
    ()
  }
  ArrayBuilder::freeze(out)
}

fn apply_struct_destr(pat: Pat, val: Expr, rest: Expr, context: Option[ParserBinderContext]) -> Expr {
  let val_name = "__struct_destr"
  let mut desugar = rest
  match pat {
    PStruct(_, fields) => {
      let mut di = Array::length(fields) - 1
      while di >= 0 {
        let (fname, fpat) = Array::get(fields, di)
        match fpat {
          PBind(bname) => {
            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1, -1), desugar, -1)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar, -1)
}

fn apply_record_destr(pat: Pat, val: Expr, rest: Expr, context: Option[ParserBinderContext]) -> Expr {
  let val_name = "__rec_destr"
  let mut desugar = rest
  match pat {
    PTuple(field_pats) => {
      let mut di = Array::length(field_pats) - 1
      while di >= 0 {
        let fp = Array::get(field_pats, di)
        match fp {
          PBind(bname) => {
            desugar = ELet(bname, ECall(EIdent("__rec_field", -1), [
              EIdent(val_name, -1),
              EInt(di)
            ], -1), desugar, -1)
          },
          PTuple(sub_pats) => {
            let sub_name = String::concat("__rec_sub_", __to_string(di))
            let mut si = Array::length(sub_pats) - 1
            while si >= 0 {
              match Array::get(sub_pats, si) {
                PBind(sname) => {
                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1, -1), desugar, -1)
                },
                _ => ()
              }
              si = si - 1
            }
            desugar = ELet(sub_name, ECall(EIdent("__rec_field", -1), [
              EIdent(val_name, -1),
              EInt(di)
            ], -1), desugar, -1)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar, -1)
}

fn apply_block_step(step: BlockStep, rest: Expr, context: Option[ParserBinderContext]) -> Expr {
  match step {
    StepSeq(expr) => ESeq(expr, rest),
    StepValue(expr) => expr,
    StepLet(name, val, soff) => ELet(name, val, rest, soff),
    StepLetMut(name, val, soff) => ELetMut(name, val, rest, soff),
    StepLetRec(name, val) => ELetRec(name, val, rest),
    StepAssign(name, val) => EAssign(name, val, rest),
    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),
    StepPattern(pat, val) => EMatch(val, [(pat, rest)]),
    // #760(1): `let PAT = val else { alt }` — bind on match, else run the
    // diverging fallback. Desugars to a two-arm match whose wildcard arm is
    // the else body; the checker unifies both arms, so a fallback that
    // `return`s / `break`s / `throw`s (or yields the same type) type-checks.
    StepPatternElse(pat, val, alt, alt_rows) => {
      // Parsing sees the fallback before the rest of the block, but the final
      // match visits the success continuation first. The fallback segment was
      // retained while parsing; append it now, as reverse folding reaches the
      // guard after the complete continuation has been captured.
      binder_capture_append(context, alt_rows)
      EMatch(val, [(pat, rest), (PWild, alt)])
    },
    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest, context),
    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest, context),
    // `let* x = e` (railway bind, #635): short-circuit on the failure case,
    // continue on the success case. The parser has no type info, so it emits a
    // type-directed sentinel `__try_bind(val, (x) -> rest)` that the pre-check
    // desugar (`desugar_trait_dict.vibe::rewrite_expr`) lowers by `val`'s head
    // type: `Option` -> `match val { Some(x) => rest, None => None }`, else
    // (`Result` or undeterminable) the original Result match
    //   `match val { Ok(x) => rest, Err(__bind_err) => Err(__bind_err) }`.
    // The continuation closure carries `x` + `rest` so `rest`'s scope is exact.
    StepBind(name, val, off) => ECall(EIdent("__try_bind", off), [
      val,
      EFn(_no_tp(), _no_tb(), [(name, None)], None, None, rest)
    ], off)
  }
}

fn fold_block_steps(steps: Array[BlockStep], context: Option[ParserBinderContext]) -> Expr {
  let mut result = EUnit
  let mut i = Array::length(steps) - 1
  while i >= 0 {
    result = apply_block_step(Array::get(steps, i), result, context)
    i = i - 1
  }
  result
}

/// #1283: does EVERY exit of this expression leave the enclosing function?
/// This is what makes a `guard`'s binding safe to publish to the rest of the
/// block: the else arm never falls through to the continuation, so there is no
/// path on which the name would be unbound.
///
/// The property is syntactic, and it has to be decided HERE rather than in the
/// checker, because `guard` desugars to `match` in this file — by the time the
/// checker sees the tree, nothing distinguishes a guard's else arm from an
/// ordinary match arm that happens to exit.
///
/// `return` and the direct `perform Exception::Throw(payload)` AST shape both
/// exit. `throw(payload)` is already desugared to that exact shape, and the
/// legacy `Error::Throw` operation spelling remains compatible. Do not widen
/// this to arbitrary `perform`: ordinary operations are resumptive. A handled
/// throw is likewise not direct — its EHandle wrapper can produce a value and
/// continue. `break` and `continue` escape a loop rather than this function.
fn expr_always_exits_guard(e: Expr) -> Bool {
  match e {
    EReturn(_) => true,
    ECall(EIdent("perform", _), args, _) => if Array::length(args) == 1 {
      match Array::get(args, 0) {
        ECall(EIdent(op_name, _), op_args, _) =>
        (op_name == "Exception::Throw" || op_name == "Error::Throw") && Array::length(op_args) == 1,
        _ => false
      }
    } else {
      false
    },
    ESeq(_, b) => expr_always_exits_guard(b),
    ELet(_, _, b, _) => expr_always_exits_guard(b),
    ELetMut(_, _, b, _) => expr_always_exits_guard(b),
    ELetRec(_, _, b) => expr_always_exits_guard(b),
    EAssign(_, _, c) => expr_always_exits_guard(c),
    EAssignOp(_, _, _, c) => expr_always_exits_guard(c),
    // An `if` with no `else` parses with EUnit in the else slot, which does
    // not exit — so a one-armed `if` correctly fails the check.
    EIf(_, t, f) => expr_always_exits_guard(t) && expr_always_exits_guard(f),
    EMatch(_, arms) => {
      let mut all = Array::length(arms) > 0
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, i)
        if !expr_always_exits_guard(body) {
          all = false
        }
        i = i + 1
      }
      all
    },
    _ => false
  }
}

/// #1283: `guard <scrutinee> is <pattern> else <block>` — the canonical
/// refutable binding form, replacing `let PAT = value else { .. }`.
///
/// Returns the pieces of a StepPatternElse: the caller folds them so the
/// pattern's bindings scope over the REST of the block, and the else arm
/// becomes the fallthrough. Scrutinee is evaluated exactly once (it is bound
/// into the match's discriminant position, not re-parsed per arm).
fn parse_guard_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Pat, Expr, Expr, Array[SourceBinder], Int) with Exception {
  // Parse the scrutinee with the no-is variant, exactly as `if` does (mode
  // 21): otherwise a trailing `is pattern` collapses into a Bool match instead
  // of landing in the guard's pattern slot.
  let (scrut, sn) = parse_infix_no_is_with_binder_context(tokens, starts, pos, 0, pos, parse_recur, context)
  let after_is = match peek(tokens, sn) {
    TIs => sn + 1,
    TIdent(kw) => if kw == "is" {
      sn + 1
    } else {
      throw("guard: expected `is <pattern>` after the scrutinee, as in `guard x is Some(v) else { return -1 }` (#1283)")
    },
    _ => throw("guard: expected `is <pattern>` after the scrutinee, as in `guard x is Some(v) else { return -1 }` (#1283)")
  }
  let (pat, pn) = parse_pattern_with_binder_context(tokens, after_is, context)
  let else_pos = match peek(tokens, pn) {
    TElse => pn + 1,
    _ => throw("guard: expected `else { .. }` after the pattern (#1283)")
  }
  let br = expect_tk(tokens, else_pos, "{")
  let alt_mark = binder_capture_mark(context)
  let (alt, end) = parse_recur(tokens, br, 20, context)
  let alt_rows = binder_capture_take_from(context, alt_mark)
  if expr_always_exits_guard(alt) {
    (pat, scrut, alt, alt_rows, end)
  } else {
    throw("guard: the `else` block must leave the enclosing function on every path with `return` or a direct `throw(...)` -- that is exactly what makes the bound name safe to use in the rest of the block. Other `perform` operations and handled throws can return to the continuation. Use `if <scrutinee> is <pattern> { .. } else { .. }` when the fallback produces a value instead of exiting. (#1283)")
  }
}

/// #1283: `let PAT = value else { .. }` (the #760(1) let-else) was retired in
/// favour of `guard value is PAT else { .. }`. The two are not spelled
/// differently for taste — let-else's else block produced the value of the
/// WHOLE remaining block, so `let Some(v) = o else { 0 }` silently turned the
/// rest of the function into `0`, while `guard` requires the else arm to
/// diverge and therefore cannot do that. Rejecting the old spelling by name
/// keeps that from being a confusing generic parse error.
fn reject_let_else(tokens: Array[Token], pos: Int) -> Int with Exception {
  match peek(tokens, pos) {
    TElse => throw("`let PAT = value else { .. }` (let-else) was replaced by `guard value is PAT else { .. }` (#1283). The guard form requires the `else` block to `return`; if you relied on let-else's else block supplying a fallback VALUE for the rest of the block, write `if value is PAT { .. } else { .. }` instead."),
    _ => pos
  }
}

/// Push a refutable pattern-let step. Returns the position past it.
fn push_pattern_let_step(tokens: Array[Token], steps: ArrayBuilder[BlockStep], pat: Pat, val: Expr, next_pos: Int, context: Option[ParserBinderContext]) -> Int with Exception {
  let after = reject_let_else(tokens, next_pos)
  ArrayBuilder::push(steps, StepPattern(pat, val))
  after
}

fn parse_impl_block(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  let steps = ArrayBuilder::new()
  let mut p = pos
  let mut end_pos = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TRBrace => {
        end_pos = p + 1
        done = true
      },
      TEof => throw("unexpected eof in block"),
      // #1525: a block-local `enum` used to be DISCARDED here and replaced by
      // one `let <Variant> = <index>` per nullary variant. No type and no
      // constructors were created, so:
      //
      //   * `match c { Red|Green => .., _ => .. }` matched NOTHING -- `Red` in
      //     pattern position is a `PCtor`, and there was no such constructor,
      //     so every value silently took the `_` arm (and trapped when there
      //     was no `_` arm to take)
      //   * a payload variant was dropped entirely (`unknown name: A`)
      //   * only "declare it, then use a variant as a bare value" worked, and
      //     that worked because the variant WAS a plain Int
      //
      // Rejecting is the honest lowering: the local form never had constructor
      // semantics to begin with, nothing in the repo used it, and the silent
      // `match` failure is exactly the defect class the repair corpus exists to
      // keep out. Hoisting to top level instead would make one function's local
      // type visible to the whole file and collide across functions, which is a
      // language decision, not a parser fix (noted on #1525).
      TEnum => {
        let (enum_stmt, _) = parse_enum_stmt_with_binder_context(tokens, p + 1, false, context)
        let ename = match enum_stmt {
          SEnum(_, n, _, _, _) => n,
          _ => "the enum"
        }
        throw("a block-local `enum` declaration is not supported -- move `\{ename}` to the top level and refer to it from here. Inside a block it had no constructors at all: `match` against them matched nothing (silently taking the `_` arm, or trapping without one). #1525 at #\{p}")
      },
      TStruct => {
        let (_, struct_end) = parse_struct_stmt_with_binder_context(tokens, p + 1, false, context)
        p = struct_end
      },
      TLet => {
        let next = p + 1
        match peek(tokens, next) {
          TRec => match peek(tokens, next + 1) {
            TIdent(name) => {
              binder_capture_source(context, name, next + 1, next + 1)
              let annotation_mark = binder_capture_mark(context)
              // #789: consume an optional `[T]` binder before the type, as for
              // the plain local let below.
              let (rtps, rtbs, rec_ann, eq_pos_r) = match peek(tokens, next + 2) {
                TColon => {
                  let (tps, tbs, rty, tp) = parse_local_let_annotation_with_binder_context(tokens, next + 3, context)
                  (tps, tbs, Some(rty), tp)
                },
                _ => {
                  let no_tp = _no_tp()
                  let no_tb = _no_tb()
                  (no_tp, no_tb, None, next + 2)
                }
              }
              let eq = expect_tk(tokens, eq_pos_r, "=")
              let value_mark = binder_capture_mark(context)
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
              if next_pos <= eq {
                throw("internal parser error: block let-rec parser did not advance")
              } else {
                // #705: same TyFn-annotation distribution as the plain local
                // let below. The annotation used to be parsed and discarded
                // here; keep that as the fallback (no ascribe_wrap -- a
                // wrapped value would break letrec's direct-lambda shape).
                // #789: re-attach a `[T]` binder to the distributed lambda.
                let val2 = match rec_ann {
                  Some(the_type) => match distribute_local_fn_ann(the_type, val, context) {
                    Some(distributed) => apply_local_let_tp(rtps, rtbs, distributed, annotation_mark, value_mark, context),
                    None => {
                      binder_capture_discard_segment(context, annotation_mark, annotation_mark + Array::length(rtps))
                      val
                    }
                  },
                  None => val
                }
                ArrayBuilder::push(steps, StepLetRec(name, val2))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let rec'")
          },
          TMut => match peek(tokens, next + 1) {
            TIdent(name) => {
              // #824: the annotation used to be parsed only to locate `=` and
              // then discarded — `let mut x: Bool = 5` compiled silently.
              // Enforce it exactly like the immutable branch: distribute a
              // TyFn annotation onto a lambda value, otherwise ascribe-wrap.
              let (m_ann, eq_pos_m) = match peek(tokens, next + 2) {
                TColon => {
                  let (mty, tp) = parse_type_impl(tokens, next + 3, 0)
                  (Some(mty), tp)
                },
                _ => (None, next + 2)
              }
              binder_capture_source(context, name, next + 1, next + 1)
              let eq = expect_tk(tokens, eq_pos_m, "=")
              let value_mark = binder_capture_mark(context)
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
              if next_pos <= eq {
                throw("internal parser error: block let-mut parser did not advance")
              } else {
                let val2 = match m_ann {
                  Some(the_type) => match distribute_local_fn_ann(the_type, val, context) {
                    Some(distributed) => distributed,
                    None => ascribe_wrap(val, the_type, value_mark, context, blk_offset_at(starts, next + 1))
                  },
                  None => val
                }
                ArrayBuilder::push(steps, StepLetMut(name, val2, blk_offset_at(starts, next - 1)))
                p = next_pos
              }
            },
            _ => throw(binder_name_error(tk_name(peek(tokens, next + 1)), "binding", next + 1))
          },
          TStar => match peek(tokens, next + 1) {
            TIdent(name) => {
              let bind_mark = binder_capture_mark(context)
              binder_capture_source(context, name, next + 1, next + 1)
              let value_mark = binder_capture_mark(context)
              let eq = expect_tk(tokens, next + 2, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
              binder_capture_swap_segments(context, bind_mark, value_mark)
              if next_pos <= eq {
                throw("internal parser error: block let* parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepBind(name, val, blk_offset_at(starts, p)))
                p = next_pos
              }
            },
            _ => throw(binder_name_error(tk_name(peek(tokens, next + 1)), "binding", next + 1))
          },
          TIdent(name) => {
            let after_name = peek(tokens, next + 1)
            let next_is_struct_destr = match after_name {
              TDoubleColon => {
                let fc = String::char_code_at(name, 0)
                if fc >= 65 && fc <= 90 {
                  match peek(tokens, next + 2) {
                    TLBrace => true,
                    _ => false
                  }
                } else {
                  false
                }
              },
              _ => false
            }
            let next_is_record_destr = match after_name {
              TLBrace => name == "record",
              _ => false
            }
            if next_is_struct_destr {
              let pattern_mark = binder_capture_mark(context)
              let (pat, pn) = parse_pattern_with_binder_context(tokens, next, context)
              let pattern_rows = binder_capture_take_from(context, pattern_mark)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
              binder_capture_insert_synthetic_at(context, pattern_mark, "__struct_destr")
              binder_capture_append(context, remap_struct_destr_rows(pat, pattern_rows, context))
              ArrayBuilder::push(steps, StepStructDestr(pat, val))
              p = next_pos
            } else if next_is_record_destr {
              let pattern_mark = binder_capture_mark(context)
              let (pat, pn) = parse_pattern_with_binder_context(tokens, next, context)
              let pattern_rows = binder_capture_take_from(context, pattern_mark)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
              binder_capture_insert_synthetic_at(context, pattern_mark, "__rec_destr")
              binder_capture_append(context, remap_record_destr_rows(pat, pattern_rows, context))
              ArrayBuilder::push(steps, StepRecordDestr(pat, val))
              p = next_pos
            } else {
              match after_name {
                TLParen => {
                  let pattern_mark = binder_capture_mark(context)
                  let (pat, pn) = parse_pattern_with_binder_context(tokens, next, context)
                  let value_mark = binder_capture_mark(context)
                  let eq = expect_tk(tokens, pn, "=")
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
                  binder_capture_swap_segments(context, pattern_mark, value_mark)
                  if next_pos <= eq {
                    throw("internal parser error: block let-ctor-pat parser did not advance")
                  } else {
                    p = push_pattern_let_step(tokens, steps, pat, val, next_pos, context)
                  }
                },
                _ => {
                  // ELet traversal visits its name before its value's EFn type
                  // parameters. Capture the local name before parsing a generic
                  // annotation, which is where `[T]` rows are collected.
                  binder_capture_source(context, name, next, next)
                  let annotation_mark = binder_capture_mark(context)
                  // #789: parse an optional `[T]` binder before the type so a
                  // local generic `let f: [T](T) -> T = ..` parses like top-level.
                  let (ltps, ltbs, ann_type, eq_pos) = match after_name {
                    TColon => {
                      let (tps, tbs, the_type, tp) = parse_local_let_annotation_with_binder_context(tokens, next + 2, context)
                      (tps, tbs, Some(the_type), tp)
                    },
                    _ => {
                      let no_tp = _no_tp()
                      let no_tb = _no_tb()
                      (no_tp, no_tb, None, next + 1)
                    }
                  }
                  let eq = expect_tk(tokens, eq_pos, "=")
                  let value_mark = binder_capture_mark(context)
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
                  if next_pos <= eq {
                    throw("internal parser error: block let parser did not advance")
                  } else {
                    // A local `let x: T = e` carries no type field on `ELet`, so
                    // enforce `e : T` by wrapping the value in an identity
                    // application `((__asc: T) -> __asc)(e)` whose argument check
                    // (unify_call_args) rejects a mismatch — no new AST node, and
                    // codegen sees only ordinary EFn/ECall. Exception (#705): a
                    // TyFn annotation on a lambda value is distributed onto the
                    // lambda itself instead (see distribute_local_fn_ann) so the
                    // Perceus param heap-inference sees the param types. #789: a
                    // `[T]` binder is re-attached to the distributed lambda.
                    let val2 = match ann_type {
                      Some(the_type) => match distribute_local_fn_ann(the_type, val, context) {
                        Some(distributed) => apply_local_let_tp(ltps, ltbs, distributed, annotation_mark, value_mark, context),
                        None => {
                          // Insert the wrapper at the still-current higher mark,
                          // then remove the erased annotation segment below it.
                          let wrapped = ascribe_wrap(val, the_type, value_mark, context, blk_offset_at(starts, next))
                          binder_capture_discard_segment(context, annotation_mark, annotation_mark + Array::length(ltps))
                          wrapped
                        }
                      },
                      None => val
                    }
                    ArrayBuilder::push(steps, StepLet(name, val2, blk_offset_at(starts, next - 1)))
                    p = next_pos
                  }
                }
              }
            }
          },
          TLParen => {
            let pattern_mark = binder_capture_mark(context)
            let (pat, pn) = parse_pattern_with_binder_context(tokens, next, context)
            let value_mark = binder_capture_mark(context)
            let eq = expect_tk(tokens, pn, "=")
            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur, context)
            binder_capture_swap_segments(context, pattern_mark, value_mark)
            if next_pos <= eq {
              throw("internal parser error: block let-pat parser did not advance")
            } else {
              p = push_pattern_let_step(tokens, steps, pat, val, next_pos, context)
            }
          },
          _ => throw(binder_name_error(tk_name(peek(tokens, next)), "binding", next))
        }
      },
      // #1283: `guard <scrutinee> is <pattern> else { .. }`. Folded as a
      // StepPatternElse so the pattern's bindings scope over the REST of the
      // block (the continuation) and the else arm is the fallthrough -- the
      // same shape the retired let-else used, now with a divergence
      // requirement on the else arm that makes the binding unconditional.
      TGuard => {
        let (gpat, gscrut, galt, galt_rows, gnext) = parse_guard_stmt(tokens, starts, p + 1, parse_recur, context)
        ArrayBuilder::push(steps, StepPatternElse(gpat, gscrut, galt, galt_rows))
        // A guard is a statement, so consume the separator the lexer's ASI
        // inserts after the else block's `}` — without this, the next
        // statement starts on a `;` the block loop has no arm for.
        p = skip_semi(tokens, gnext)
      },
      _ => {
        let (e, next) = parse_recur(tokens, p, 0, context)
        if next <= p {
          throw("internal parser error: block expr parser did not advance")
        } else {
          match peek(tokens, next) {
            TRBrace => {
              ArrayBuilder::push(steps, StepValue(e))
              end_pos = next + 1
              done = true
            },
            TSemicolon => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next + 1
            },
            TEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssign(name, val))
                p = next_pos
              },
              EDot(obj, field, _, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                let set_args = empty_exprs()
                Array::push(set_args, obj)
                Array::push(set_args, EString(field))
                Array::push(set_args, val)
                ArrayBuilder::push(steps, StepSeq(ECall(EIdent("__set_field", -1), set_args, -1)))
                p = next_pos
              },
              ECall(sidx_callee, sidx_args, _) => {
                // `arr[i] = v` in the step-block path (same desugar as the
                // parse_block_after_expr TEq arm above).
                let s_is_index = match sidx_callee {
                  EIdent(sicn, _) => sicn == "__index",
                  _ => false
                }
                if s_is_index && Array::length(sidx_args) == 2 {
                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                  let set_args = empty_exprs()
                  Array::push(set_args, Array::get(sidx_args, 0))
                  Array::push(set_args, Array::get(sidx_args, 1))
                  Array::push(set_args, val)
                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent("Array::set", -1), set_args, -1)))
                  p = next_pos
                } else {
                  throw("invalid assignment target")
                }
              },
              _ => throw("invalid assignment target")
            },
            TPlusEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssignOp(name, "+", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TMinusEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssignOp(name, "-", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TStarEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssignOp(name, "*", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TSlashEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssignOp(name, "/", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TPercentEq => match e {
              EIdent(name, _) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur, context)
                ArrayBuilder::push(steps, StepAssignOp(name, "%", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            _ => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next
            }
          }
        }
      }
    }
  }
  (fold_block_steps(ArrayBuilder::freeze(steps), context), end_pos)
}

// #1350: `for await x in s` was RETIRED. It parsed to
// `EForIn(x, _, __await_iter(s), body)` -- the iterable wrapped in a marker
// carrying the `await` intent past the parser to the dict-passing desugar.
// The marker was never load-bearing: the desugar's choice between the sync
// and the await-wrapped loop is made from `C::next`'s return type (Future or
// not), which is type information the marker does not add. A syntactic
// `await` on the loop was therefore a second spelling of what the effect row
// (`with Async`) already states -- the same function-coloring duplication
// ADR-0089 D1 removed from `sleep`. Plain `for x in s` now drives both kinds
// (see classify_sync_for_loop in desugar_trait_dict.vibe), and `await` in
// that position is an ordinary binding name again.

export fn parse_impl_dispatch_with_binder_context(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Expr, Int) with Exception {
  if mode == 20 {
    parse_impl_block(tokens, starts, pos, parse_recur, context)
  } else if mode == 21 {
    // Parse cond with the no-is variant so a trailing `is pattern` belongs
    // to the if-cond pattern slot rather than collapsing into a Bool match.
    let (cond, cn) = parse_infix_no_is_with_binder_context(tokens, starts, pos, 0, pos, parse_recur, context)
    let mut is_mode = false
    let mut is_pat_val = PWild
    let mut brace_pos = cn
    match peek(tokens, cn) {
      TIs => {
        let (pat, pn) = parse_pattern_with_binder_context(tokens, cn + 1, context)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      TIdent(kw) => if kw == "is" {
        let (pat, pn) = parse_pattern_with_binder_context(tokens, cn + 1, context)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      _ => ()
    }
    let br = expect_tk(tokens, brace_pos, "{")
    let (then_e, tn) = parse_recur(tokens, br, 20, context)
    let (else_e, end_pos) = match peek(tokens, tn) {
      TElse => match peek(tokens, tn + 1) {
        TIf => parse_recur(tokens, tn + 2, 21, context),
        TLBrace => parse_recur(tokens, tn + 2, 20, context),
        _ => parse_recur(tokens, tn + 1, 0, context)
      },
      _ => (EUnit, tn)
    }
    if is_mode {
      (EMatch(cond, [(is_pat_val, then_e), (PWild, else_e)]), end_pos)
    } else {
      (EIf(cond, then_e, else_e), end_pos)
    }
  } else if mode == 22 {
    let match_mark = binder_capture_mark(context)
    let (scrutinee, sn) = parse_recur(tokens, pos, 0, context)
    let br = expect_tk(tokens, sn, "{")
    match peek(tokens, br) {
      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),
      _ => {
        // #666: collect arms as (pattern, guard|EBool(true), body). If any arm
        // carries a guard, bind the scrutinee to a temp `__mg` (so a failed
        // guard can re-match it without re-evaluating a side-effecting
        // scrutinee) and desugar guards into nested EIf/EMatch. Otherwise emit
        // a plain EMatch.
        let ab = ArrayBuilder::new()
        let row_b = match context {
          Some(_) => Some(ArrayBuilder::new()),
          None => None
        }
        let encoded_end = collect_match_arms(tokens, starts, br, ab, row_b, parse_recur, context)
        let has_guard = encoded_end < 0
        let endpos = if has_guard {
          0 - encoded_end - 1
        } else {
          encoded_end
        }
        let arms3 = ArrayBuilder::freeze(ab)
        if has_guard {
          match row_b {
            Some(rows) => {
              let arm_rows = ArrayBuilder::freeze(rows)
              binder_capture_insert_synthetic_at(context, match_mark, "__mg")
              binder_capture_append(context, desugar_guarded_rows(arms3, arm_rows, 0))
            },
            None => ()
          }
          let final_arms = desugar_guarded(arms3, 0, EIdent("__mg", 0 - 1), context)
          (ELet("__mg", scrutinee, EMatch(EIdent("__mg", 0 - 1), final_arms), -1), endpos)
        } else {
          let arm_rows = match row_b {
            Some(rows) => Some(ArrayBuilder::freeze(rows)),
            None => None
          }
          let plain = ArrayBuilder::new()
          let mut k = 0
          while k < Array::length(arms3) {
            let (p, _, bd) = Array::get(arms3, k)
            match arm_rows {
              Some(rows) => {
                let (pat_rows, _, body_rows) = Array::get(rows, k)
                binder_capture_append(context, pat_rows)
                binder_capture_append(context, body_rows)
              },
              None => ()
            }
            ArrayBuilder::push(plain, (p, bd))
            k = k + 1
          }
          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)
        }
      }
    }
  } else if mode == 23 {
    let (cond, cn) = parse_recur(tokens, pos, 0, context)
    let br = expect_tk(tokens, cn, "{")
    let (body, end) = parse_recur(tokens, br, 20, context)
    (EWhile(cond, body), end)
  } else if mode == 24 {
    let br = expect_tk(tokens, pos, "{")
    let (body, bn) = parse_recur(tokens, br, 20, context)
    let wp = expect_tk(tokens, bn, "with")
    // ADR-0085 (#1344): the handled effect may be a generic INSTANTIATION
    // (`handle { .. } with Exception[IoError] { Throw(e) => .. }`), so the
    // name is read with the same one-type-argument grammar `with <row>` row
    // items use (collect_row_item_targs, parser_base.vibe) rather than a bare
    // identifier. The bracketed spelling rides straight into the arm patterns
    // via qualify_handle_arm_pattern -- `Exception[IoError]::Throw` -- which
    // is what lets collect_handle_effects publish the KIND the handle
    // discharges. Runtime lowering is unaffected: every exception spelling
    // shares one Wasm tag (is_exception_throw_operation, core/
    // exception_effect.vibe).
    let (effect_name, effect_next) = match peek(tokens, wp) {
      TIdent(name) => {
        // #1501: the handled-effect name is a source effect NAME, so the #1461
        // retirement applies here exactly as it does to a row item. It did not
        // until now only because this path never called the check.
        reject_retired_effect_label(name, wp)
        match peek(tokens, wp + 1) {
          TLBracket => collect_row_item_targs(tokens, wp + 2, 1, String::concat(name, "[")),
          _ => (name, wp + 1)
        }
      },
      _ => throw("expected effect name after 'with'")
    }
    let hb = expect_tk(tokens, effect_next, "{")
    match peek(tokens, hb) {
      // ADR-0102 / #1678: an empty arm set used to erase the source effect
      // row while codegen emitted the body unchanged. Reject it before the
      // handled-effect spelling is discarded from EHandle.
      TRBrace => throw(String::concat("handler for `", String::concat(effect_name, "` must contain at least one arm"))),
      _ => {
        let b = ArrayBuilder::new()
        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur, context)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur, context)
      }
    }
  } else if mode == 25 {
    // `for x in e { ... }` / `for k, v in e { ... }`. #1350 retired the
    // `for await` spelling (see this file's header comment): the loop kind is
    // decided from the iterand's TYPE in desugar_trait_dict.vibe, never from
    // syntax, so `await` here is again just a binding name.
    let start = pos
    match peek(tokens, start) {
      TIdent(first_name) => match peek(tokens, start + 1) {
        TComma => match peek(tokens, start + 2) {
          TIdent(second_name) => {
            binder_capture_source(context, second_name, start + 2, start + 2)
            binder_capture_source(context, first_name, start, start)
            let ip = expect_tk(tokens, start + 3, "in")
            match parse_recur(tokens, ip, 0, context) {
              (iterable, after_iter) => {
                let bb = expect_tk(tokens, after_iter, "{")
                let (body, end) = parse_recur(tokens, bb, 20, context)
                (EForIn(second_name, Some(first_name), iterable, body), end)
              },
              _ => throw("unreachable: parse_recur for for-in")
            }
          },
          _ => throw("expected value binding name after ','")
        },
        _ => {
          binder_capture_source(context, first_name, start, start)
          let ip = expect_tk(tokens, start + 1, "in")
          match parse_recur(tokens, ip, 0, context) {
            (iterable, after_iter) => {
              let bb = expect_tk(tokens, after_iter, "{")
              let (body, end) = parse_recur(tokens, bb, 20, context)
              (EForIn(first_name, None, iterable, body), end)
            },
            _ => throw("unreachable: parse_recur for for-in")
          }
        }
      }
      ,
      _ => throw("expected identifier after 'for'")
    }
  } else if mode == 26 {
    // `taskgroup { g => body }` is pure sugar for `TaskGroup::run((g) -> {
    // body })` -- no dedicated AST node, no desugar pass, no checker
    // special-casing. Resolves through the ordinary `TaskGroup::run` name
    // lookup, so the caller still needs `import @vibe/concurrent {
    // TaskGroup }` in scope (matching every hand-written call site today;
    // there is no auto-import mechanism in this compiler to inject one).
    let off = blk_offset_at(starts, pos)
    let br = expect_tk(tokens, pos, "{")
    let (gname, gn) = match peek(tokens, br) {
      TIdent(name) => (name, br + 1),
      _ => throw("expected a binder name after 'taskgroup {'")
    }
    let arrow = expect_tk(tokens, gn, "=>")
    binder_capture_source(context, gname, br, br)
    let (body, bn) = parse_recur(tokens, arrow, 0, context)
    let close = expect_tk(tokens, bn, "}")
    let tparams = _no_tp()
    let tbounds = _no_tb()
    let lam = EFn(tparams, tbounds, [(gname, None)], None, None, body)
    (ECall(EIdent("TaskGroup::run", off), [lam], off), close)
  } else if mode == 27 {
    // ADR-0090 Phase 1: `region r { body }` lowers to
    // `__region_run((r) -> { body })`. `__region_run` is reserved internal
    // ABI (only this syntax emits the name -- __no_entry__/__set_field
    // convention), so the checker's literal-name special case cannot be
    // bypassed by aliasing: the hole ADR-0090 records for TaskGroup::run
    // does not exist here by construction.
    let off = blk_offset_at(starts, pos)
    let (rname, rn) = match peek(tokens, pos) {
      TIdent(name) => (name, pos + 1),
      _ => throw("expected a region binder name after 'region'")
    }
    let br = expect_tk(tokens, rn, "{")
    binder_capture_source(context, rname, pos, pos)
    // Mode 20 parses a full statement block (let/expr sequence) and
    // consumes the closing brace -- region bodies are blocks, not single
    // expressions.
    let (body, close) = parse_recur(tokens, br, 20, context)
    let tparams = _no_tp()
    let tbounds = _no_tb()
    let lam = EFn(tparams, tbounds, [(rname, None)], None, None, body)
    (ECall(EIdent("__region_run", off), [lam], off), close)
  } else {
    let actual = tk_name(peek(tokens, pos))
    throw("internal parser error: unknown parse mode \{mode} at #\{pos} token=\{actual}")
  }
}

export fn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with Exception) -> (Expr, Int) with Exception {
  let adapted = (rtoks, rpos, rmode, _context) -> parse_recur(rtoks, rpos, rmode)
  parse_impl_dispatch_with_binder_context(tokens, starts, pos, mode, adapted, None)
}
