//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./polyfill.vibe {
  __to_string
}

import ./float_format.vibe {
  double_to_string_compiler
}

//# Functions

fn join(arr: Array[String], sep: String) -> String {
  let len = Array::length(arr)
  if len == 0 {
    ""
  } else {
    let b = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      if i > 0 {
        ArrayBuilder::push(b, sep)
      }
      ArrayBuilder::push(b, Array::get(arr, i))
      i = i + 1
    }
    String::join(ArrayBuilder::freeze(b), "")
  }
}

/// Render a parser generic binder in parameter declaration order. Bounds are
/// keyed by parameter name in the AST; scan them in AST order so the printer is
/// deterministic without making an unrelated semantic ordering decision.
fn print_bounded_type_params(params: Array[String], bounds: Array[(String, Array[String])]) -> String {
  if Array::length(params) == 0 {
    ""
  } else {
    let parts = for param in params {
      let labels = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(bounds) {
        let (bound_param, bound_labels) = Array::get(bounds, i)
        if bound_param == param {
          let mut j = 0
          while j < Array::length(bound_labels) {
            ArrayBuilder::push(labels, Array::get(bound_labels, j))
            j = j + 1
          }
        } else {
          ()
        }
        i = i + 1
      }
      let labels = ArrayBuilder::freeze(labels)
      if Array::length(labels) == 0 {
        param
      } else {
        String::concat(param, String::concat(": ", join(labels, " + ")))
      }
    }
    String::concat("[", String::concat(join(parts, ", "), "]"))
  }
}

/// #741: `r#loop`-style raw identifiers lex to a bare TIdent — the r# prefix
/// is not kept in the AST — so a binding named after a keyword must be
/// re-escaped on print or the emitted program fails to re-parse (the merge
/// flatten hit "expected identifier after 'let rec'" on @vibe/core set.vibe's
/// `let rec r#loop`). Mirror of the lexer's keyword table.
fn is_keyword_name(name: String) -> Bool {
  name == "fn" || name == "if" || name == "in" || name == "is" || name == "do" ||
  name == "as" || name == "let" || name == "rec" || name == "mut" || name == "for" ||
  name == "else" || name == "enum" || name == "true" || name == "type" || name == "test" ||
  name == "with" || name == "loop" || name == "open" || name == "impl" || name == "false" ||
  name == "match" || name == "trait" || name == "throw" || name == "while" || name == "break" ||
  name == "bench" || name == "raise" || name == "yield" || name == "struct" || name == "export" ||
  name == "return" || name == "handle" || name == "module" || name == "derive" || name == "import" ||
  name == "declare" || name == "continue" || name == "suberror"
}

fn print_name(name: String) -> String {
  if is_keyword_name(name) {
    String::concat("r#", name)
  } else name
}

fn escape_string(s: String) -> String {
  let len = String::length(s)
  let b = ArrayBuilder::new()
  let push_chunk: (Int, Int) -> Unit = (start, end) -> {
    if end > start {
      ArrayBuilder::push(b, s[start: end])
    }
  }
  let mut i = 0
  let mut start = 0
  while i < len {
    let c = String::char_code_at(s, i)
    if c == '"' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\"")
      i = i + 1
      start = i
    } else if c == '\\' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\\")
      i = i + 1
      start = i
    } else if c == '\n' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\n")
      i = i + 1
      start = i
    } else if c == '\t' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\t")
      i = i + 1
      start = i
    } else if c == 13 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\r")
      i = i + 1
      start = i
    } else if c == 0 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\0")
      i = i + 1
      start = i
    } else {
      i = i + 1
    }
  }
  push_chunk(start, len)
  String::join(ArrayBuilder::freeze(b), "")
}

export fn print_pat(p: Pat) -> String {
  match p {
    PWild => "_",
    PBind(name) => print_name(name),
    PInt(n) => __to_string(n),
    PFloat(v) => {
      // Same int-reparse guard as the EFloat printer arm below.
      let fs = double_to_string_compiler(v)
      if String::contains(fs, ".") || fs == "nan" {
        fs
      } else {
        String::concat(fs, ".0")
      }
    },
    PString(s) => String::concat("\"", String::concat(escape_string(s), "\"")),
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    },
    POr(left, right) => String::concat(print_pat(left), String::concat(" | ", print_pat(right))),
    // #1281: `PStruct("record", ..)` is the anonymous-record destructure
    // marker a top-level `let record { a, b } = r` parses to. Its fields are
    // positional (no names survive `parse_pattern`), so print the field
    // patterns themselves — which is exactly the source spelling back.
    PStruct(name, fields) => if name == "record" {
      let field_parts = for f in fields {
        print_pat(f.1)
      }
      String::concat("record { ", String::concat(join(field_parts, ", "), " }"))
    } else {
      String::concat(name, "::{...}")
    }
  }
}

fn handle_effect_name_from_ctor(name: String) -> Option[String] {
  let idx = String::last_index_of(name, "::")
  if idx < 0 {
    None
  } else {
    Some(name[0: idx])
  }
}

fn infer_handle_effect_name_from_pat(pat: Pat) -> Option[String] {
  match pat {
    PCtor(name, _) => handle_effect_name_from_ctor(name),
    POr(left, right) => match infer_handle_effect_name_from_pat(left) {
      Some(name) => Some(name),
      None => infer_handle_effect_name_from_pat(right)
    },
    _ => None
  }
}

fn infer_handle_effect_name(arms: Array[(Pat, Expr)]) -> String {
  let mut i = 0
  let mut effect_name = "Error"
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, _) = Array::get(arms, i)
    match infer_handle_effect_name_from_pat(pat) {
      Some(name) => {
        effect_name = name
        found = true
      },
      None => {
        i = i + 1
      }
    }
  }
  effect_name
}

fn strip_handle_effect_ctor(effect_name: String, ctor_name: String) -> String {
  let prefix = String::concat(effect_name, "::")
  if String::starts_with(ctor_name, prefix) {
    let prefix_len = String::length(prefix)
    let ctor_len = String::length(ctor_name)
    ctor_name[prefix_len: ctor_len]
  } else {
    ctor_name
  }
}

fn print_handle_pat(effect_name: String, pat: Pat) -> String {
  match pat {
    PCtor(name, args) => {
      let short_name = strip_handle_effect_ctor(effect_name, name)
      if Array::length(args) == 0 {
        short_name
      } else {
        let parts = for arg in args {
          print_pat(arg)
        }
        String::concat(short_name, String::concat("(", String::concat(join(parts, ", "), ")")))
      }
    },
    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(" | ", print_handle_pat(effect_name, right))),
    _ => print_pat(pat)
  }
}

fn map_to_strings(exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {
  for expr in exprs {
    f(expr)
  }
}

export fn print_type_expr(ty: TypeExpr) -> String {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      String::concat(name, String::concat("[", String::concat(join(parts, ", "), "]")))
    },
    TyFn(params, ret, effect_name) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      let base = String::concat("(", String::concat(join(parts, ", "), String::concat(") -> ", print_type_expr(ret))))
      match effect_name {
        Some(name) => String::concat(base, String::concat(" with { ", String::concat(name, " }"))),
        None => base
      }
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    }
  }
}

fn print_ctor(name: String, args: Array[TypeExpr]) -> String {
  if Array::length(args) == 0 {
    name
  }
  else {
    let parts = for arg in args {
      print_type_expr(arg)
    }
    String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))
  }
}

/// Render a function/lambda type-parameter header `[T: Ord, U]` from the EFn
/// type_params + bounds. Returns "" when there are no type params. Without
/// this, print_program (used to round-trip a merged multi-module program back
/// to source) would drop `[T: Ord]`, so a re-parsed generic function loses its
/// type-parameter scope and `T` resolves to a concrete `CtNamed("T", [])`
/// instead of a bound type variable.
fn print_fn_type_params(type_params: Array[String], bounds: Array[(String, Array[String])]) -> String {
  if Array::length(type_params) == 0 {
    ""
  } else {
    let parts = for tp in type_params {
      let mut found = Array::slice([
        ""
      ], 0, 0)
      let mut bi = 0
      while bi < Array::length(bounds) {
        let (bname, blist) = Array::get(bounds, bi)
        if bname == tp {
          found = blist
        }
        bi = bi + 1
      }
      if Array::length(found) == 0 {
        tp
      } else {
        String::concat(tp, String::concat(": ", join(found, " + ")))
      }
    }
    String::concat("[", String::concat(join(parts, ", "), "]"))
  }
}

export fn print_expr(e: Expr) -> String {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => {
      // #726: a whole double printed as "2" re-parses as an INT literal —
      // `EFloat(2.0)` round-tripped to `EInt(2)` (the merge-flatten stage
      // rejected the compiler's own `EFloat(...)` ctor calls; normalize had
      // the same silent semantic corruption). Keep the float-ness explicit.
      let s = double_to_string_compiler(n)
      if String::contains(s, ".") || s == "nan" {
        s
      } else {
        String::concat(s, ".0")
      }
    },
    EString(s) => String::concat("\"", String::concat(escape_string(s), "\"")),
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name, _) => print_name(name),
    EUnit => "()",
    ETuple(elems) => String::concat("(", String::concat(join(map_to_strings(elems, print_expr), ", "), ")")),
    EArray(elems) => String::concat("[", String::concat(join(map_to_strings(elems, print_expr), ", "), "]")),
    ERecord(rn, fields, targs) => {
      let parts = for field in fields {
        let (name, val) = field
        String::concat(name, String::concat(": ", print_expr(val)))
      }
      // #886: re-emit explicit struct type arguments (`Pair[Int]::{ .. }`)
      // so the normalize round-trip preserves the pinned instantiation.
      let head = if Array::length(targs) > 0 {
        String::concat(rn, String::concat("[", String::concat(join(for ta in targs {
          print_type_expr(ta)
        }, ", "), "]")))
      } else {
        rn
      }
      let prefix = if rn == "" {
        "record { "
      } else String::concat(head, "::{ ")
      String::concat(prefix, String::concat(join(parts, ", "), " }"))
    },
    EIf(cond, then_e, else_e) => match else_e {
      EUnit => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), " }")))),
      _ => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), String::concat(" } else { ", String::concat(print_expr(else_e), " }"))))))
    },
    ELet(name, val, body, _) => String::concat("{ let ", String::concat(print_name(name), String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    ELetRec(name, val, body) => String::concat("{ let rec ", String::concat(print_name(name), String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    ELetMut(name, val, body, _) => String::concat("{ let mut ", String::concat(print_name(name), String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    EAssign(name, val, body) => String::concat("{ ", String::concat(print_name(name), String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    EAssignOp(name, op, val, body) => String::concat("{ ", String::concat(print_name(name), String::concat(" ", String::concat(op, String::concat("= ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))))),
    ESeq(a, b) => String::concat("{ ", String::concat(print_expr(a), String::concat("; ", String::concat(print_expr(b), " }")))),
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_pat(pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("match ", String::concat(print_expr(scrutinee), String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    EHandle(body, arms) => {
      let effect_name = infer_handle_effect_name(arms)
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_handle_pat(effect_name, pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("handle { ", String::concat(print_expr(body), String::concat(" } with ", String::concat(effect_name, String::concat(" { ", String::concat(join(parts, "; "), " }"))))))
    },
    EWhile(cond, body) => String::concat("while ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(body), " }")))),
    ELoop(params, body) => {
      let parts = for param in params {
        let (name, init) = param
        String::concat(print_name(name), String::concat(" = ", print_expr(init)))
      }
      String::concat("loop (", String::concat(join(parts, ", "), String::concat(") { ", String::concat(print_expr(body), " }"))))
    },
    EForIn(value_name, index_name, iterable, body) => {
      let binding = match index_name {
        Some(index_name) => String::concat(print_name(index_name), String::concat(", ", print_name(value_name))),
        None => print_name(value_name)
      }
      String::concat("for ", String::concat(binding, String::concat(" in ", String::concat(print_expr(iterable), String::concat(" { ", String::concat(print_expr(body), " }"))))))
    },
    ECall(callee, args, _) => match callee {
      EIdent("perform", _) => if Array::length(args) == 1 {
        // #640 Stage 2: re-sugar the parser's `throw(x)` desugar (`perform
        // Error::Throw(x)` shape) back to `throw(x)`. This keeps print
        // round-trips stable for the ubiquitous `throw(` spelling and keeps
        // the regenerated flat module source seed-compatible (the committed
        // seed predates the Stage-1 tag-2 routing of the perform spelling).
        // The explicit no-call `perform Error::Throw` (EIdent op) keeps its
        // perform rendering below.
        let resugar = match Array::get(args, 0) {
          ECall(op_callee, op_args, _) => match op_callee {
            EIdent(op_name, _) => if op_name == "Error::Throw" && Array::length(op_args) == 1 {
              Some(Array::get(op_args, 0))
            } else {
              None
            },
            _ => None
          },
          _ => None
        }
        match resugar {
          Some(payload) => String::concat("throw(", String::concat(print_expr(payload), ")")),
          None => String::concat("perform ", print_expr(Array::get(args, 0)))
        }
      } else {
        String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")))
      },
      // #726: an immediately-invoked lambda callee must be parenthesized —
      // `(x: T) -> { x }(args)` re-parses with the CALL inside the lambda
      // body (`{ x }(args)`, "calling a non-function value"), so print
      // `((x: T) -> { x })(args)`.
      EFn(_, _, _, _, _, _) => String::concat("(", String::concat(print_expr(callee), String::concat(")(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")))),
      _ => String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")))
    },
    EBinOp(op, left, right) => String::concat("(", String::concat(print_expr(left), String::concat(" ", String::concat(op, String::concat(" ", String::concat(print_expr(right), ")")))))),
    EUnaryOp(op, expr) => String::concat("(", String::concat(op, String::concat(print_expr(expr), ")"))),
    EFn(type_params, bounds, params, ret_ty, effect, body) => {
      let tp_str = print_fn_type_params(type_params, bounds)
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => String::concat(print_name(name), String::concat(": ", print_type_expr(ty))),
          None => print_name(name)
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => String::concat(" with { ", String::concat(e, " }")),
            None => ""
          }
          String::concat(") -> ", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(" { ", String::concat(print_expr(body), " }")))))
        },
        None => String::concat(") -> { ", String::concat(print_expr(body), " }"))
      }
      String::concat(tp_str, String::concat("(", String::concat(join(parts, ", "), ret_str)))
    },
    EDot(expr, field, _, _) => String::concat(print_expr(expr), String::concat(".", field)),
    EReturn(e) => String::concat("return ", print_expr(e)),
    EBreak(opt) => match opt {
      None => "break",
      Some(v) => String::concat("break ", print_expr(v))
    },
    EContinue(args) => if Array::length(args) == 0 {
      "continue"
    } else String::concat("continue(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")),
    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat("=", print_expr(val))),
    // #960 Stage 2: the `map { ... }` literal is retired, so EMap prints as
    // the replacement API — the parser desugars these spellings back into the
    // same EMap node, keeping flat module source round-trippable.
    EMap(fields) => if Array::length(fields) == 0 {
      "Map::new()"
    } else {
      let parts = for field in fields {
        let (k, v) = field
        String::concat("(\"", String::concat(escape_string(k), String::concat("\", ", String::concat(print_expr(v), ")"))))
      }
      String::concat("Map::from_pairs([", String::concat(join(parts, ", "), "])"))
    },
    ESpread(inner) => String::concat("...", print_expr(inner)),
    EStringInterp(parts) => String::concat("\"", String::concat(join(parts, ""), "\""))
  }
}

fn print_annotated_let_value(ty_opt: Option[TypeExpr], val: Expr) -> String {
  match ty_opt {
    Some(TyFn(_, _, _)) => match val {
      EFn(type_params, bounds, params, _, _, body) => {
        // Type params live only on the EFn (the `: (T) -> T` annotation does
        // not carry `[T: Ord]`); emit them so a re-parse keeps the
        // type-parameter scope. Without this, print_program round-tripping a
        // merged multi-module program drops `[T: Ord]` and `T` resolves to a
        // concrete CtNamed instead of a bound type variable.
        let tp_str = print_fn_type_params(type_params, bounds)
        let parts = for param in params {
          let (name, _) = param
          print_name(name)
        }
        String::concat(tp_str, String::concat("(", String::concat(join(parts, ", "), String::concat(") -> { ", String::concat(print_expr(body), " }")))))
      },
      _ => print_expr(val)
    },
    _ => print_expr(val)
  }
}

fn print_ctor_list(ctors: Array[(String, Array[TypeExpr])]) -> String {
  let parts = for ctor in ctors {
    let (name, args) = ctor
    print_ctor(name, args)
  }
  join(parts, "; ")
}

export fn print_stmt(s: Stmt) -> String {
  let prefix: (Bool) -> String = (exported) -> {
    if exported {
      "export "
    } else ""
  }
  match s {
    SLet(exported, is_rec, name, ty_opt, val) => {
      let p = prefix(exported)
      let r = if is_rec {
        "let rec "
      } else "let "
      let t = match ty_opt {
        Some(ty) => String::concat(": ", print_type_expr(ty)),
        None => ""
      }
      String::concat(p, String::concat(r, String::concat(print_name(name), String::concat(t, String::concat(" = ", print_annotated_let_value(ty_opt, val))))))
    },
    // ADR-0064 (#727): a preserved `fn` declaration —
    //   fn name[T](x: Int) -> R with { E } where { requires: c, ensures: c } { body }
    // Only produced by the *_preserving parse entry points; the default
    // pipeline lowers SFnDecl to SLet before printing ever matters.
    SFnDecl(exported, name, fn_value, reqs, enss) => {
      let p = prefix(exported)
      match fn_value {
        EFn(type_params, bounds, params, ret_ty, effect, body) => {
          let tp_str = print_fn_type_params(type_params, bounds)
          let parts = for param in params {
            let (pn, ty_opt) = param
            match ty_opt {
              Some(ty) => String::concat(print_name(pn), String::concat(": ", print_type_expr(ty))),
              None => print_name(pn)
            }
          }
          let ret_str = match ret_ty {
            Some(rt) => print_type_expr(rt),
            None => "()"
          }
          let eff_str = match effect {
            Some(e) => String::concat(" with { ", String::concat(e, " }")),
            None => ""
          }
          let where_str = if Array::length(reqs) == 0 && Array::length(enss) == 0 {
            ""
          } else {
            let conds = ArrayBuilder::new()
            let mut qi = 0
            while qi < Array::length(reqs) {
              ArrayBuilder::push(conds, String::concat("requires: ", print_expr(Array::get(reqs, qi))))
              qi = qi + 1
            }
            let mut ei = 0
            while ei < Array::length(enss) {
              ArrayBuilder::push(conds, String::concat("ensures: ", print_expr(Array::get(enss, ei))))
              ei = ei + 1
            }
            String::concat(" where { ", String::concat(join(ArrayBuilder::freeze(conds), ", "), " }"))
          }
          let head = String::concat(p, String::concat("fn ", String::concat(print_name(name), tp_str)))
          let sig = String::concat("(", String::concat(join(parts, ", "), String::concat(") -> ", String::concat(ret_str, String::concat(eff_str, where_str)))))
          // #805 (ADR-0072): an inline-wasm body (the parser-internal
          // `%wasm("<WAT>")` marker call) round-trips as `= wasm "..."` —
          // printing the marker as a call would not re-parse (`%` is not an
          // ident start in expression position).
          let wasm_text = match body {
            ECall(wcal, wargs, _) => match wcal {
              EIdent(wname, _) => if wname == "%wasm" && Array::length(wargs) == 1 {
                match Array::get(wargs, 0) {
                  EString(wt) => Some(wt),
                  _ => None
                }
              } else {
                None
              },
              _ => None
            },
            _ => None
          }
          match wasm_text {
            Some(wt) => String::concat(head, String::concat(sig, String::concat(" = wasm \"", String::concat(escape_string(wt), "\"")))),
            None => String::concat(head, String::concat(sig, String::concat(" { ", String::concat(print_expr(body), " }"))))
          }
        },
        // Defensive: a non-EFn value cannot be spelled in fn syntax; fall
        // back to the lowered let-rec form so output stays parseable.
        _ => String::concat(p, String::concat("let rec ", String::concat(print_name(name), String::concat(" = ", print_expr(fn_value)))))
      }
    },
    SLetMut(name, ty_opt, val) => {
      let t = match ty_opt {
        Some(ty) => String::concat(": ", print_type_expr(ty)),
        None => ""
      }
      String::concat("let mut ", String::concat(print_name(name), String::concat(t, String::concat(" = ", print_expr(val)))))
    },
    SEnum(exported, name, params, ctors, derives) => {
      // #735: `[T]` type params and `derive(...)` were dropped, so a printed
      // generic enum (e.g. a contract facade embedding `enum List[T]`)
      // round-tripped to an ill-typed nullary declaration.
      let tp = if Array::length(params) == 0 {
        ""
      } else {
        String::concat("[", String::concat(join(params, ", "), "]"))
      }
      let base = String::concat(prefix(exported), String::concat("enum ", String::concat(name, String::concat(tp, String::concat(" { ", String::concat(print_ctor_list(ctors), " }"))))))
      if Array::length(derives) == 0 {
        base
      } else {
        String::concat(base, String::concat(" derive(", String::concat(join(derives, ", "), ")")))
      }
    },
    SSuberror(exported, name, ctors) => {
      let p = prefix(exported)
      if Array::length(ctors) == 1 {
        let (ctor_name, ctor_args) = Array::get(ctors, 0)
        if ctor_name == name {
          let parts = for arg in ctor_args {
            print_type_expr(arg)
          }
          String::concat(p, String::concat("suberror ", String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))))
        }
        else String::concat(p, String::concat("suberror ", String::concat(name, String::concat(" { ", String::concat(print_ctor_list(ctors), " }")))))
      } else String::concat(p, String::concat("suberror ", String::concat(name, String::concat(" { ", String::concat(print_ctor_list(ctors), " }")))))
    },
    SStruct(exported, name, fields, derives, mut_names, tparams) => {
      let parts = for field in fields {
        let (fn1, ty) = field
        let mut is_mut = false
        let mut mi = 0
        while mi < Array::length(mut_names) {
          if Array::get(mut_names, mi) == fn1 {
            is_mut = true
          }
          mi = mi + 1
        }
        let mp = if is_mut {
          "mut "
        } else {
          ""
        }
        String::concat(mp, String::concat(fn1, String::concat(": ", print_type_expr(ty))))
      }
      // #829 (same class as SEnum/#735): keep `[T]` params on printed structs
      // so a generic struct round-trips instead of degrading to a nullary one.
      let tp = if Array::length(tparams) == 0 {
        ""
      } else {
        String::concat("[", String::concat(join(tparams, ", "), "]"))
      }
      let base = String::concat(prefix(exported), String::concat("struct ", String::concat(name, String::concat(tp, String::concat(" { ", String::concat(join(parts, "; "), " }"))))))
      if Array::length(derives) == 0 {
        base
      } else {
        String::concat(base, String::concat(" derive(", String::concat(join(derives, ", "), ")")))
      }
    },
    STypeAlias(exported, name, params, ty) => {
      // #735 (same class as SEnum): keep `[T]` params on printed aliases.
      let tp = if Array::length(params) == 0 {
        ""
      } else {
        String::concat("[", String::concat(join(params, ", "), "]"))
      }
      String::concat(prefix(exported), String::concat("type ", String::concat(name, String::concat(tp, String::concat(" = ", print_type_expr(ty))))))
    },
    STrait(exported, name, supers, methods, method_gens) => {
      let base = String::concat(prefix(exported), String::concat("trait ", name))
      let head = if Array::length(supers) == 0 {
        base
      }
      else String::concat(base, String::concat(": ", join(supers, " + ")))
      if Array::length(methods) == 0 {
        head
      } else {
        let method_parts = for m in methods {
          let (method_name, params, ret) = m
          // Method generic metadata is stored separately from signatures.
          // Pair it by method name and retain both binder order and bound
          // order so print_program does not collapse semantic bound changes.
          let type_params = ArrayBuilder::new()
          let bounds = ArrayBuilder::new()
          let mut g = 0
          while g < Array::length(method_gens) {
            let (generic_method, generic_params, generic_bounds) = Array::get(method_gens, g)
            if generic_method == method_name {
              let mut p = 0
              while p < Array::length(generic_params) {
                ArrayBuilder::push(type_params, Array::get(generic_params, p))
                p = p + 1
              }
              let mut b = 0
              while b < Array::length(generic_bounds) {
                ArrayBuilder::push(bounds, Array::get(generic_bounds, b))
                b = b + 1
              }
            } else {
              ()
            }
            g = g + 1
          }
          let generic_header = print_bounded_type_params(ArrayBuilder::freeze(type_params), ArrayBuilder::freeze(bounds))
          let params_str = if Array::length(params) > 0 {
            String::concat("(", String::concat(join(for pt in params {
              print_type_expr(pt)
            }, ", "), ")"))
          } else ""
          String::concat("  ", String::concat(method_name, String::concat(generic_header, String::concat(params_str, String::concat(" -> ", print_type_expr(ret))))))
        }
        String::concat(head, String::concat(" {\n", String::concat(join(method_parts, ";\n"), "\n}")))
      }
    },
    SImpl(tparams, tbounds, trait_name, type_name) => {
      let generic_header = print_bounded_type_params(tparams, tbounds)
      let head = if generic_header == "" {
        "impl "
      } else {
        String::concat("impl ", String::concat(generic_header, " "))
      }
      String::concat(head, String::concat(trait_name, String::concat(" for ", type_name)))
    },
    SExternLet(name, ty) => String::concat("extern let ", String::concat(name, String::concat(": ", print_type_expr(ty)))),
    SImport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => String::concat(name, String::concat(" as ", a)),
          None => name
        }
      }
      String::concat("import ", String::concat(path, String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    STest(name, body) => String::concat("test \"", String::concat(name, String::concat("\" { ", String::concat(print_expr(body), " }")))),
    SBench(name, body) => String::concat("bench \"", String::concat(name, String::concat("\" { ", String::concat(print_expr(body), " }")))),
    SExpr(e) => print_expr(e),
    SExport(names) => String::concat("export { ", String::concat(join(names, ", "), " }")),
    SReExport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => String::concat(name, String::concat(" as ", a)),
          None => name
        }
      }
      String::concat("export ", String::concat(path, String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    SAliasDecl(alias_name, source_path) => String::concat("import ", String::concat(source_path, String::concat(" @", alias_name))),
    SLetPat(pat, expr) => String::concat("let ", String::concat(print_pat(pat), String::concat(" = ", print_expr(expr)))),
    SModule(exported, name, stmts) => {
      let parts = for s in stmts {
        print_stmt(s)
      }
      let p = if exported {
        "export "
      } else ""
      String::concat(p, String::concat("module ", String::concat(name, String::concat(" { ", String::concat(join(parts, "\n"), " }")))))
    },
    SEffectDef(exported, name, type_params, ops) => {
      let p = if exported {
        "export "
      } else ""
      let tp = if Array::length(type_params) > 0 {
        String::concat("[", String::concat(join(type_params, ", "), "]"))
      } else ""
      let op_parts = for op in ops {
        let (op_name, params, ret) = op
        let params_str = if Array::length(params) > 0 {
          String::concat("(", String::concat(join(for pt in params {
            print_type_expr(pt)
          }, ", "), ")"))
        } else ""
        String::concat("  ", String::concat(op_name, String::concat(params_str, String::concat(" -> ", print_type_expr(ret)))))
      }
      String::concat(p, String::concat("effect ", String::concat(name, String::concat(tp, String::concat(" {\n", String::concat(join(op_parts, ";\n"), "\n}"))))))
    },
    SEffectSet(exported, name, members) => {
      let p = if exported {
        "export "
      } else ""
      String::concat(p, String::concat("effectset ", String::concat(name, String::concat(" = { ", String::concat(join(members, ", "), " }")))))
    }
  }
}

fn needs_program_separator(stmt_text: String) -> Bool {
  if String::length(stmt_text) == 0 {
    false
  } else {
    let c = String::char_code_at(stmt_text, 0)
    c == '(' || c == '['
  }
}

export fn print_program(stmts: Array[Stmt]) -> String {
  let len = Array::length(stmts)
  // O(N) build via ArrayBuilder (matching this file's join/escape_string idiom);
  // the previous `out = String::concat(out, ...)` per statement was O(N²) over
  // the total printed size, which dominates emit-module-source (issue #366).
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < len {
    let stmt_text = print_stmt(Array::get(stmts, i))
    if i > 0 {
      let sep = if needs_program_separator(stmt_text) {
        ";\n"
      } else "\n"
      ArrayBuilder::push(b, sep)
    }
    ArrayBuilder::push(b, stmt_text)
    i = i + 1
  }
  String::join(ArrayBuilder::freeze(b), "")
}
