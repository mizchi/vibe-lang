//# Imports

import ./polyfill.vibe {
  __to_string
}

//# Functions

// ---- #956 / #3543: correctly-rounded decimal -> Double literal construction ----
//
// A float literal's value is the IEEE-754 double nearest its decimal digits,
// ties to the even significand: exactly what `Double::parse` answers for the
// same text (#2652), and it must be byte-identical to it, so a literal and a
// parsed string never disagree.
//
//   - <= 15 significant digits and |exp10| <= 22: the exact fast path. The
//     digits are exact in an Int, so `Int::to_double` is exact; 10^k is exact
//     through 1e22; the one multiply or divide is therefore the only rounding,
//     and IEEE-754 rounds it to nearest-even. That is the correctly rounded
//     answer, so it equals `Double::parse`'s.
//   - otherwise: `Double::parse` itself. Its runtime reads the digits exactly
//     and refines a first approximation against the candidate's exact rounding
//     interval (`codegen/common_base/double_runtime.vibe`), so the slow path is
//     the same algorithm, not a second one that has to be kept in step.
//
// #3543: the slow path used to be a separate double-double construction that
// kept 31 significant digits and folded the rest into a sticky half unit. It
// was not correctly rounded at a rounding boundary: the 309-digit integer just
// below DBL_MAX + half an ulp lexed to `Infinity` (it is DBL_MAX), and an
// exact halfway case written with more than 31 digits rounded away from even
// (`1.00000000000000033306690738754696212708950042724609375`, the midpoint of
// 1.0000000000000002 and 1.0000000000000004, gave the odd one), while
// `Double::parse` of the same text answered correctly.
// fixtures/double_literal_rounding_test.vibe pins each literal against
// `Double::parse` of its own text and against the expected bits.
//
// NOTE on style: the fast path is written over `let mut` locals rooted at
// float literals, with every float binop containing a tracked-floatish
// operand. The linear/RC backends classify float ops syntactically
// (#772/#797: `expr_is_floatish`), so keep it in this shape.

export fn parse_decimal_float(int_str: String, frac_str: String) -> Double with Exception {
  let flen = String::length(frac_str)
  let all = String::concat(int_str, frac_str)
  let total = String::length(all)
  let mut exp10 = 0 - flen
  let mut start = 0
  while start < total - 1 && String::char_code_at(all, start) == '0' {
    start = start + 1
  }
  let mut end = total
  while end - start > 1 && String::char_code_at(all, end - 1) == '0' {
    end = end - 1
    exp10 = exp10 + 1
  }
  if String::char_code_at(all, start) == '0' {
    0.0
  } else {
    let nsig = end - start
    if nsig <= 15 && exp10 + 22 >= 0 && exp10 <= 22 {
      let mut m = 0
      let mut k = start
      while k < end {
        m = m * 10 + (String::char_code_at(all, k) - 48)
        k = k + 1
      }
      let mut pw = 1.0
      let mut pj = 0
      let pe = if exp10 >= 0 {
        exp10
      } else {
        0 - exp10
      }
      while pj < pe {
        pw = pw * 10.0
        pj = pj + 1
      }
      if exp10 >= 0 {
        Int::to_double(m) * pw
      } else {
        Int::to_double(m) / pw
      }
    } else {
      let text = if flen == 0 {
        int_str
      } else {
        String::concat(int_str, String::concat(".", frac_str))
      }
      match Double::parse(text) {
        Some(v) => v,
        // Unreachable for a digit string; refuse rather than invent a value.
        None => throw(String::concat("internal error: `Double::parse` refused the digits of the float literal ", text))
      }
    }
  }
}

// ---- #956: exact decimal printing for doubles past the Int range ----
//
// `double_to_string_compiler` used `Double::to_int` on the integer part,
// which breaks past 2^61. For such values (all of which are exact integers —
// every double >= 2^53 is) we print the EXACT decimal expansion instead:
// halve the value into the Int-safe range (exact), take the mantissa digits,
// and double the decimal digit array back up. The exact expansion re-parses
// bit-identically under `parse_decimal_float`.

fn big_double_exact_int_decimal(abs_d: Double) -> String {
  // 2^61 built by doubling a tracked literal-rooted mut (see the style NOTE
  // above parse_decimal_float — annotated lets / big literals miscompile).
  let mut two_61 = 1.0
  let mut t61i = 0
  while t61i < 61 {
    two_61 = two_61 * 2.0
    t61i = t61i + 1
  }
  let mut x = abs_d
  let mut halvings = 0
  // int-condition loop: a float-compare `while` condition miscompiles in the
  // imported-module lane (see style NOTE above parse_decimal_float); the
  // equivalent `if` compare inside an int-condition loop compiles correctly.
  let mut halving_go = 1
  while halving_go == 1 {
    if x >= two_61 * 1.0 {
      x = x * 0.5
      halvings = halvings + 1
    } else {
      halving_go = 0
    }
  }
  let m = Double::to_int(x)
  let ms = __to_string(m)
  let mlen = String::length(ms)
  // decimal digits, least-significant first (finite doubles need <= 309)
  let digits = Int64Array::make(340, 0)
  let mut i = 0
  while i < mlen {
    Int64Array::set(digits, i, String::char_code_at(ms, mlen - 1 - i) - 48)
    i = i + 1
  }
  let mut ndig = mlen
  let mut h = 0
  while h < halvings {
    let mut carry = 0
    let mut j = 0
    while j < ndig {
      let v = Int64Array::get(digits, j) * 2 + carry
      Int64Array::set(digits, j, v % 10)
      carry = v / 10
      j = j + 1
    }
    if carry > 0 {
      Int64Array::set(digits, ndig, carry)
      ndig = ndig + 1
    }
    h = h + 1
  }
  let b = ArrayBuilder::new()
  let mut j2 = ndig - 1
  while j2 >= 0 {
    ArrayBuilder::push(b, String::from_char_code(Int64Array::get(digits, j2) + 48))
    j2 = j2 - 1
  }
  String::join(ArrayBuilder::freeze(b), "")
}

fn pos_inf_decimal_string() -> String {
  // 10^309 overflows every double, so this re-parses to +inf
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, "1")
  let mut i = 0
  while i < 309 {
    ArrayBuilder::push(b, "0")
    i = i + 1
  }
  String::join(ArrayBuilder::freeze(b), "")
}

fn zero_pad_6(n: Int) -> String {
  let s = __to_string(n)
  let len = String::length(s)
  if len >= 6 {
    s
  } else {
    let mut out = ""
    let mut i = len
    while i < 6 {
      out = String::concat(out, "0")
      i = i + 1
    }
    String::concat(out, s)
  }
}

fn trim_trailing_zeros(s: String) -> String {
  let mut end = String::length(s)
  while end > 0 && String::char_code_at(s, end - 1) == 48 {
    end = end - 1
  }
  if end <= 0 {
    ""
  } else {
    s[0: end]
  }
}

export fn double_to_string_compiler(d: Double) -> String {
  if d != d {
    "nan"
  } else {
    let neg = d < 0.0
    let abs_d = if neg {
      0.0 - d
    } else {
      d
    }
    let mut two_61 = 1.0
    let mut t61i = 0
    while t61i < 61 {
      two_61 = two_61 * 2.0
      t61i = t61i + 1
    }
    if abs_d >= two_61 * 1.0 {
      // #956: Double::to_int overflows past 2^61 — print the exact decimal
      // expansion instead (re-parses bit-identically; infinities print as
      // 10^309, which re-parses to inf).
      let body = if abs_d * 0.5 == abs_d {
        pos_inf_decimal_string()
      } else {
        big_double_exact_int_decimal(abs_d)
      }
      if neg {
        String::concat("-", body)
      } else {
        body
      }
    } else {
      let int_part = Double::to_int(abs_d)
      let frac = abs_d - Int::to_double(int_part)
      let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)
      let int_norm = if scaled_raw == 1000000 {
        int_part + 1
      } else {
        int_part
      }
      let frac_norm = if scaled_raw == 1000000 {
        0
      } else {
        scaled_raw
      }
      let int_s = __to_string(int_norm)
      let frac_s = if frac_norm == 0 {
        ""
      } else {
        trim_trailing_zeros(zero_pad_6(frac_norm))
      }
      let body = if String::length(frac_s) == 0 {
        int_s
      } else {
        String::concat(int_s, String::concat(".", frac_s))
      }
      if neg {
        String::concat("-", body)
      } else {
        body
      }
    }
  }
}
