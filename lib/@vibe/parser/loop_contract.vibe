//# Imports

import @vibe/ast {
  Expr, TypeExpr
}

import ./token.vibe {
  Token
}

import ./parser_base.vibe {
  _no_tb, _no_tp, expect_tk, peek
}

import ./parser_binder_context.vibe {
  ParserBinderContext
}

import ./printer.vibe {
  print_expr
}

//# Functions

/// #3716 (ADR-0121 Phase 0): the clauses of a loop's `where { .. }` block,
/// read after a `while` condition, a `for` iterand or a `loop` header. Returns
/// the `invariant` conditions, the `decreases` measures (at most one) and the
/// position of the loop body's `{`. With no `where` it returns two empty
/// arrays and `pos` unchanged.
fn parse_loop_where(tokens: Array[Token], pos: Int, parse_recur: (Array[Token], Int, Int, Option[ParserBinderContext]) -> (Expr, Int) with Exception, context: Option[ParserBinderContext]) -> (Array[Expr], Array[Expr], Int) with Exception {
  let invariants: Array[Expr] = []
  let decreases: Array[Expr] = []
  match peek(tokens = tokens, pos = pos) {
    TIdent(w) => if w == "where" {
      let mut wp = expect_tk(tokens = tokens, pos = pos + 1, expected = "{")
      let mut done = false
      while !done {
        match peek(tokens = tokens, pos = wp) {
          TRBrace => {
            wp = wp + 1
            done = true
          },
          TIdent(kind) => {
            if kind == "requires" || kind == "ensures" {
              throw("a loop's where clause takes `invariant` and `decreases`; `\{kind}` belongs in a function's where clause")
            } else if kind != "invariant" && kind != "decreases" {
              throw("expected 'invariant' or 'decreases' in a loop's where clause, got '\{kind}'")
            } else {
              ()
            }
            let cp = expect_tk(tokens = tokens, pos = wp + 1, expected = ":")
            let (cond, cnext) = parse_recur(tokens, cp, 0, context)
            if kind == "invariant" {
              Array::push(invariants, value = cond)
            } else if Array::length(decreases) > 0 {
              throw("a loop's where clause takes one `decreases` measure; combine them into one Int expression")
            } else {
              Array::push(decreases, value = cond)
            }
            wp = match peek(tokens = tokens, pos = cnext) {
              TComma => cnext + 1,
              _ => cnext
            }
          },
          _ => throw("expected 'invariant', 'decreases', or '}' in a loop's where clause")
        }
      }
      (invariants, decreases, wp)
    } else {
      (invariants, decreases, pos)
    },
    _ => (invariants, decreases, pos)
  }
}

fn contract_assert(_ cond: Expr) -> Expr {
  ECall(EIdent("assert", 0 - 1), [cond], 0 - 1, [])
}

/// A clause passed through an identity lambda whose parameter is typed `ty`,
/// so a clause of the wrong type is ONE located error at the clause
/// (`expected Bool, got Int`) rather than a mismatch reported against the
/// `assert` / measure cells this lowering introduces, which the program
/// never wrote.
///
/// The parameter is spelled with the compiler's reserved `__vibe_` prefix:
/// the editor's binding recovery matches a parameter to the next source token
/// of its name, so a plain `v` would claim a later `let v` of the program.
fn typed_clause(clause: Expr, ty: String) -> Expr {
  ECall(EFn(_no_tp(), _no_tb(), [("__vibe_clause", Some(TyName(ty)))], Some(TyName(ty)), None, EIdent("__vibe_clause", 0 - 1)), [
    clause
  ], 0 - 1, [])
}

/// One checkpoint: every invariant holds, and the measure is non-negative and
/// below the previous checkpoint's. `prev` / `seen` are the loop's own
/// mutable cells (`seen` is false until the first checkpoint has recorded a
/// measure).
fn contract_checkpoint(invariants: Array[Expr], decreases: Array[Expr], stem: String) -> Expr {
  let mut acc = if Array::length(decreases) == 0 {
    EUnit
  } else {
    let prev = "\{stem}_dec_prev"
    let seen = "\{stem}_dec_seen"
    let now = "\{stem}_dec_now"
    let record = EAssign(prev, EIdent(now, 0 - 1), EAssign(seen, EBool(true), EUnit, 0 - 1), 0 - 1)
    let below = EIf(EIdent(seen, 0 - 1), contract_assert(EBinOp("<", EIdent(now, 0 - 1), EIdent(prev, 0 - 1), 0 - 1)), EUnit)
    ELet(now, typed_clause(clause = Array::get(decreases, at = 0), ty = "Int"), ESeq(contract_assert(EBinOp(">=", EIdent(now, 0 - 1), EInt(0), 0 - 1)), ESeq(below, record)), 0 - 1)
  }
  let mut i = Array::length(invariants)
  while i > 0 {
    i = i - 1
    acc = ESeq(contract_assert(typed_clause(clause = Array::get(invariants, at = i), ty = "Bool")), acc)
  }
  acc
}

/// The prefix of every name a contracted loop's lowering binds around the
/// loop: `__loop_T`, or `__loop<N>_T` for the first N, where `__loop<N>`
/// occurs NOWHERE in the loop's printed parts (condition or iterand, body,
/// clauses, a `for`'s variables). Those bindings enclose the loop, so a fixed
/// spelling could capture a name the loop mentions; a prefix the text never
/// uses changes no binding (the printer's own rule for its match temporary).
/// `T` is the loop's token position, which keeps nested loops apart.
fn loop_stem(exprs: Array[Expr], names: Array[String], invariants: Array[Expr], decreases: Array[Expr], tag: Int) -> String {
  let text = StringBuilder::new()
  for e in exprs {
    StringBuilder::push(text, value = print_expr(e))
    StringBuilder::push(text, value = " ")
  }
  for e in invariants {
    StringBuilder::push(text, value = print_expr(e))
    StringBuilder::push(text, value = " ")
  }
  for e in decreases {
    StringBuilder::push(text, value = print_expr(e))
    StringBuilder::push(text, value = " ")
  }
  for n in names {
    StringBuilder::push(text, value = n)
    StringBuilder::push(text, value = " ")
  }
  let seen = StringBuilder::freeze(text)
  let mut base = "__loop"
  let mut k = 0
  while String::contains(seen, needle = base) {
    k = k + 1
    base = "__loop\{k}"
  }
  "\{base}_\{tag}"
}

/// The cells a `decreases` measure needs, around `inner`. The previous
/// measure starts at 0 only so the cell is an `Int`; `seen` says it was never
/// read before the first checkpoint stores one.
fn with_measure_cells(inner: Expr, decreases: Array[Expr], stem: String) -> Expr {
  if Array::length(decreases) == 0 {
    inner
  } else {
    ELetMut("\{stem}_dec_prev", EInt(0), ELetMut("\{stem}_dec_seen", EBool(false), inner, 0 - 1), 0 - 1)
  }
}

/// #3716: a `while` (or a desugared `loop`) with a contract. The checkpoint
/// joins the condition, `while { checkpoint; cond }`: the condition is
/// evaluated on entry and after every iteration -- one ended by `continue`
/// included -- and always in the loop's own scope, so a clause never reads a
/// binding the body shadows. The clause expressions appear once.
fn attach_while_contract(cond: Expr, body: Expr, invariants: Array[Expr], decreases: Array[Expr], tag: Int) -> Expr {
  if Array::length(invariants) == 0 && Array::length(decreases) == 0 {
    EWhile(cond, body)
  } else {
    let stem = loop_stem(exprs = [cond, body], names = [], invariants = invariants, decreases = decreases, tag = tag)
    with_measure_cells(inner = EWhile(ESeq(contract_checkpoint(invariants = invariants, decreases = decreases, stem = stem), cond), body), decreases = decreases, stem = stem)
  }
}

/// #3716: a `for` with a contract. Its iteration is decided from the
/// iterand's type after checking, so there is no condition to join; the
/// checkpoint is a closure defined before the loop -- in the loop's own scope,
/// for the reason `attach_while_contract` gives -- and called on entry, at the
/// end of the body, and before each `continue` that targets this loop. The
/// loop ends up the tail of that wrapper, which the checker treats as a
/// statement where the wrapper stands as one (`check_seq_spine`).
fn attach_for_contract(value_name: String, index_name: Option[String], iterable: Expr, body: Expr, invariants: Array[Expr], decreases: Array[Expr], tag: Int) -> Expr {
  if Array::length(invariants) == 0 && Array::length(decreases) == 0 {
    EForIn(value_name, index_name, iterable, body)
  } else {
    let names = match index_name {
      Some(i) => [value_name, i],
      None => [value_name]
    }
    let stem = loop_stem(exprs = [iterable, body], names = names, invariants = invariants, decreases = decreases, tag = tag)
    let check = "\{stem}_check"
    let call = () -> ECall(EIdent(check, 0 - 1), [], 0 - 1, [])
    let lam = EFn(_no_tp(), _no_tb(), [], None, None, contract_checkpoint(invariants = invariants, decreases = decreases, stem = stem))
    // The body's value is kept across the checkpoint: a `for` over an Array
    // collects it.
    let body_value = "\{stem}_body"
    let looped = EForIn(value_name, index_name, iterable, ELet(body_value, check_before_continue(expr = body, check = check), ESeq(call(), EIdent(body_value, 0 - 1)), 0 - 1))
    with_measure_cells(inner = ELet(check, lam, ESeq(call(), looped), 0 - 1), decreases = decreases, stem = stem)
  }
}

/// Every `continue` that targets the loop whose body this is gets a call to
/// `check` first. A nested loop's `continue` targets that loop, and a lambda's
/// body is not this loop's, so neither is entered -- except what a nested
/// loop evaluates before it starts: a `for`'s iterand and a `loop`'s initial
/// parameter values, where a `continue` still targets this loop. (A `while`
/// condition is the nested loop's own: a `continue` there re-tests it.) Every variant is listed so
/// a new one is a compile error here rather than a skipped checkpoint.
fn check_before_continue(expr: Expr, check: String) -> Expr {
  let go = (e: Expr) -> check_before_continue(expr = e, check = check)
  match expr {
    EContinue(args) => ESeq(ECall(EIdent(check, 0 - 1), [], 0 - 1, []), EContinue(for a in args {
      go(a)
    })),
    EWhile(_, _) => expr,
    ELoop(params, b) => ELoop(for p in params {
      let (pname, pv) = p
      (pname, go(pv))
    }, b),
    EForIn(v, i, it, b) => EForIn(v, i, go(it), b),
    EFn(_, _, _, _, _, _) => expr,
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for x in items {
      go(x)
    }),
    EArray(items) => EArray(for x in items {
      go(x)
    }),
    ERecord(name, fields, targs) => ERecord(name, for f in fields {
      let (fname, v) = f
      (fname, go(v))
    }, targs),
    EMap(fields) => EMap(for f in fields {
      let (fname, v) = f
      (fname, go(v))
    }),
    EIf(c, t, e) => EIf(go(c), go(t), go(e)),
    ELet(n, v, b, off) => ELet(n, go(v), go(b), off),
    ELetRec(n, v, b) => ELetRec(n, go(v), go(b)),
    ELetMut(n, v, b, off) => ELetMut(n, go(v), go(b), off),
    EAssign(n, v, c, off) => EAssign(n, go(v), go(c), off),
    EAssignOp(n, op, v, c, off) => EAssignOp(n, op, go(v), go(c), off),
    ESeq(a, b) => ESeq(go(a), go(b)),
    EMatch(s, arms) => EMatch(go(s), for a in arms {
      let (p, ex) = a
      (p, go(ex))
    }),
    EHandle(b, arms) => EHandle(go(b), for a in arms {
      let (p, ex) = a
      (p, go(ex))
    }),
    ECall(callee, args, off, cell) => ECall(go(callee), for a in args {
      go(a)
    }, off, cell),
    EBinOp(op, l, r, off) => EBinOp(op, go(l), go(r), off),
    EUnaryOp(op, e) => EUnaryOp(op, go(e)),
    EDot(obj, field, off, foff) => EDot(go(obj), field, off, foff),
    ELabeledArg(label, name, v) => ELabeledArg(label, name, go(v)),
    EReturn(v) => EReturn(go(v)),
    EBreak(v) => EBreak(match v {
      Some(x) => Some(go(x)),
      None => None
    }),
    ESpread(v) => ESpread(go(v))
  }
}

export {
  attach_for_contract, attach_while_contract, parse_loop_where
}
