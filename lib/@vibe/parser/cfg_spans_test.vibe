//# `parse_program_spans` resolves `#cfg` / `#cfg_enable` / `#deprecated`
// (#2497 step 0). Module-source emission and the span tools go through this
// entry, so an active guarded statement gets its own span (directive
// excluded) and an inactive one gets none.

import ./lexer.vibe {
  lex_with_offsets
}

import ./parser.vibe {
  parse_program_spans, set_cfg_ambient_flags
}

let src: String = "#cfg_enable(dev)\n#cfg(dev)\nlet a = 1\n#cfg(release)\nlet b = 2\n#deprecated(\"use c2\")\nlet c = 3\n#cfg(release)\nimpl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n}\nlet d = 4\n"

fn slices(_ source: String) -> Array[String] with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let (stmts, span_start, span_end) = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
  assert_eq(Array::length(stmts), Array::length(span_start))
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, value = String::substring(source, start = Array::get(span_start, at = i), end = Array::get(span_end, at = i)))
    i = i + 1
  }
  out
}

test "file-level #cfg_enable selects; inactive #cfg gets no span; #deprecated is consumed" {
  set_cfg_ambient_flags([])
  let got = slices(src)
  assert_eq(Array::length(got), 3)
  assert_eq(Array::get(got, at = 0), "let a = 1")
  assert_eq(Array::get(got, at = 1), "let c = 3")
  assert_eq(Array::get(got, at = 2), "let d = 4")
}

test "ambient flags select too, including a guarded impl" {
  set_cfg_ambient_flags(["release"])
  let got = slices(src)
  set_cfg_ambient_flags([])
  assert_eq(Array::length(got), 5)
  assert_eq(Array::get(got, at = 0), "let a = 1")
  assert_eq(Array::get(got, at = 1), "let b = 2")
  assert_eq(Array::get(got, at = 2), "let c = 3")
  assert_eq(Array::get(got, at = 3), "impl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n}")
  assert_eq(Array::get(got, at = 4), "let d = 4")
}

test "a negative guard keeps or drops a whole impl and excludes the directive from its span" {
  let source = "#cfg(not(telemetry))\nimpl Show for Foo {\n  show(self) -> String { \"quiet\" }\n}\nlet tail = 3\n"
  set_cfg_ambient_flags([])
  let off = slices(source)
  assert_eq(Array::length(off), 2)
  assert_eq(Array::get(off, at = 0), "impl Show for Foo {\n  show(self) -> String { \"quiet\" }\n}")
  set_cfg_ambient_flags(["telemetry"])
  handle {
    let on = slices(source)
    assert_eq(Array::length(on), 1)
    assert_eq(Array::get(on, at = 0), "let tail = 3")
    set_cfg_ambient_flags([])
  } with { Exception::Throw(msg) => {
    set_cfg_ambient_flags([])
    throw(msg)
  } }
}

test "an inactive guarded statement must still parse" {
  set_cfg_ambient_flags([])
  let bad = "#cfg(never)\nlet = \nlet d = 4\n"
  let (tokens, starts, ends) = lex_with_offsets(bad)
  let failed = handle {
    let _ = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
    false
  } with { Exception::Throw(_) => true }
  assert(failed)
}

test "an inactive guarded impl must still parse its methods" {
  set_cfg_ambient_flags([])
  let bad_method = "#cfg(never)\nimpl Show for Foo {\n  show(self -> String {\n    \"x\"\n  }\n}\nlet d = 4\n"
  let (tokens, starts, ends) = lex_with_offsets(bad_method)
  let failed = handle {
    let _ = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
    false
  } with { Exception::Throw(_) => true }
  assert(failed)
}

test "an unterminated inactive guarded impl is a diagnostic, not a hang" {
  set_cfg_ambient_flags([])
  let unterminated = "#cfg(never)\nimpl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n"
  let (tokens, starts, ends) = lex_with_offsets(unterminated)
  let failed = handle {
    let _ = parse_program_spans(tokens = tokens, starts = starts, ends = ends)
    false
  } with { Exception::Throw(_) => true }
  assert(failed)
}

test "an active impl is parsed through its methods too: malformed or unterminated is a diagnostic" {
  set_cfg_ambient_flags([])
  let bad_method = "impl Show for Foo {\n  show(self -> String {\n    \"x\"\n  }\n}\nlet d = 4\n"
  let (t1, s1, e1) = lex_with_offsets(bad_method)
  let failed_bad = handle {
    let _ = parse_program_spans(tokens = t1, starts = s1, ends = e1)
    false
  } with { Exception::Throw(_) => true }
  assert(failed_bad)
  let unterminated = "impl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n"
  let (t2, s2, e2) = lex_with_offsets(unterminated)
  let failed_unterminated = handle {
    let _ = parse_program_spans(tokens = t2, starts = s2, ends = e2)
    false
  } with { Exception::Throw(_) => true }
  assert(failed_unterminated)
  let good = "impl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n}\nlet d = 4\n"
  let got = slices(good)
  assert_eq(Array::length(got), 2)
  assert_eq(Array::get(got, at = 0), "impl Show for Foo {\n  show(self) -> String {\n    \"x\"\n  }\n}")
  assert_eq(Array::get(got, at = 1), "let d = 4")
}
