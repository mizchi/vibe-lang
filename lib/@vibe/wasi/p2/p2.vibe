// WASI Preview 2: fd-based HTTP and TCP socket surface — synchronous,
// pollable-based interfaces, re-exported from @vibe/http / @vibe/socket.
//
// #897 (ADR-0070 Phase 3): this file holds what the old hand-written
// index.vibe facade held. The HTTP surface is a straight re-export of the
// @vibe/http facade (directory form — both packages are .vpkg contract
// packages now, so their internal files are sealed); #847's re-export
// trust is what discharges the contract's fn declarations and the
// `opaque type HttpRequest`/`HttpResponse` declarations (the transparent
// definitions live in @vibe/http's contract and ride the re-export chain,
// so p2 consumers see the same single struct def as http consumers).
//
// The old facade's `socket_*` aliases (`export let socket_connect =
// connect`, ...) are re-exported from @vibe/socket's own identically-named
// canonical wrappers (PR #923 moved them into socket.vibe) instead of
// re-aliasing `connect`/... locally — same bindings, one definition. The
// `Socket::` qualified aliases stay local as real thin wrapper fns: safe
// here because, unlike `Http::*`/`Socket::tcp_*`, the names
// `Socket::endpoint`/`Socket::connection`/`Socket::connection_fd` are NOT
// checker/codegen builtins (checker/builtins_net.vibe), so no perform
// lowering or raw-builtin binding exists for a fn def to hijack.

export ../../http {
  close, accept, listen, request, respond,
  request_url, request_body, response_body,
  request_header, request_method, response_header, response_status,
  HttpRequest, HttpResponse, headers_empty, headers_get, headers_set,
  headers_to_wire, make_request, make_response,
  status_ok, status_not_found, status_internal_server_error,
  request_with, respond_with
}

export ../../socket {
  socket_connect, socket_read, socket_write, socket_close
}

import @vibe/socket {
  connection, connection_fd, endpoint, struct TcpConnection, struct TcpEndpoint
}

// #897: moved from the old index.vibe facade — a real importable binding,
// not just contract metadata (Codex review precedent, PR #914).

/// Canonical collision-safe aliases (prefix avoids collision with
/// Http::close; see header comment for why wrapper fns are safe here).
export fn Socket::endpoint(host: String, port: Int) -> TcpEndpoint {
  endpoint(host, port)
}

export fn Socket::connection(fd: Int) -> TcpConnection {
  connection(fd)
}

export fn Socket::connection_fd(conn: TcpConnection) -> Int {
  connection_fd(conn)
}
