name = @vibe/wasi/p2
version = 0.0.1
description =
  #|@vibe/wasi/p2 — WASI Preview 2 surface: fd-based HTTP re-exported from
deps = {
  @vibe/http : 0.0.1
  @vibe/socket : 0.0.1
}

generated_hash =

// @vibe/wasi/p2 — WASI Preview 2 surface: fd-based HTTP re-exported from
// @vibe/http and the TCP socket client surface re-exported from
// @vibe/socket (ADR-0070 Phase 3, #897).
//
// This package defines almost nothing of its own: every HTTP name and the
// four `socket_*` wrappers are RE-EXPORTS (p2.vibe) of the source
// packages' .vpkg facades, accepted against the declarations below by
// #847's re-export trust (a re-exported name has no signature/arity of its
// own to compare — its OWN package's contract vouches for it). That is why
// `HttpRequest`/`HttpResponse` are declared `opaque type` HERE even though
// they are transparent structs in @vibe/http's contract: a transparent
// definition in THIS contract would emit a second struct def into this
// package's facade, colliding with @vibe/http's when both reach one merged
// program via the re-export chain. The opaque declaration re-exports the
// name instead, so p2 consumers resolve the exact same (transparent)
// definition http consumers do — field access included.
//
// The signature texts below are copied verbatim from @vibe/http's /
// @vibe/socket's contracts so this contract stays an honest description of
// the surface, but note check_contract never fingerprint-compares them for
// re-exported names (trust at face value). `Http`/`Socket` in the effect
// rows are the checker-builtin effects.
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (p2.vibe) with a
// matching bodyless declaration here (Codex review precedent, PR #914).
// The old facade's `Socket::` qualified aliases became real thin wrapper
// fns in p2.vibe (safe — not builtin names, see the comment there).
//
// Nested-package note (ADR-0070): this index.vpkg starts its OWN package
// under lib/@vibe/wasi/ — the parent @vibe/wasi contract does not own p2's
// sources, and imports in both directions must go through the respective
// facades.

opaque type HttpRequest
opaque type HttpResponse

// --- HTTP (re-exported from @vibe/http)
fn close(fd: Int) -> Unit with Http
fn accept(server_fd: Int) -> Int with Http
fn listen(port: Int) -> Int with Http
fn request(method: String, url: String, headers: String, body: String) -> Int with Http
fn respond(req_fd: Int, status: Int, headers: String, body: String) -> Unit with Http
fn request_url(fd: Int) -> String with Http
fn request_body(fd: Int) -> String with Http
fn response_body(fd: Int) -> String with Http
fn request_header(fd: Int, name: String) -> String with Http
fn request_method(fd: Int) -> String with Http
fn response_header(fd: Int, name: String) -> String with Http
fn response_status(fd: Int) -> Int with Http
fn headers_empty() -> Map[String, String]
fn headers_get(headers: Map[String, String], name: String) -> Option[String]
fn headers_set(headers: Map[String, String], name: String, value: String) -> Map[String, String]
fn headers_to_wire(headers: Map[String, String]) -> String
fn make_request(method: String, url: String, headers: Map[String, String], body: String) -> HttpRequest
fn make_response(status: Int, headers: Map[String, String], body: String) -> HttpResponse
fn status_ok() -> Int
fn status_not_found() -> Int
fn status_internal_server_error() -> Int
fn request_with(request_data: HttpRequest) -> Int with Http
fn respond_with(req_fd: Int, response_data: HttpResponse) -> Unit with Http

// --- Socket (re-exported from @vibe/socket, prefix avoids Http::close)
fn socket_connect(target: TcpEndpoint) -> TcpConnection with Socket
fn socket_read(conn: TcpConnection, max_bytes: Int) -> String with Socket
fn socket_write(conn: TcpConnection, data: String) -> Unit with Socket
fn socket_close(conn: TcpConnection) -> Unit with Socket

// --- Socket (canonical collision-safe aliases)
fn Socket::endpoint(host: String, port: Int) -> TcpEndpoint
fn Socket::connection(fd: Int) -> TcpConnection
fn Socket::connection_fd(conn: TcpConnection) -> Int
