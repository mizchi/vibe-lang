//# Imports

// #897 (ADR-0070 Phase 3): retargeted from a literal
// `../../http/index.vibe` import to this package's OWN facade (`.`), so the
// test exercises the p2 contract's re-export chain (p2 index.vpkg ->
// p2.vibe -> @vibe/http's facade) rather than reaching around it — the
// field accesses below only work because `HttpRequest`/`HttpResponse`
// resolve through the chain to @vibe/http's transparent definitions.
import .{
  HttpRequest, HttpResponse, headers_empty, headers_get, headers_set, make_request, make_response, status_not_found, status_ok, socket_connect, socket_read, socket_write, socket_close, Socket::endpoint, Socket::connection, Socket::connection_fd, version
}

//# Misc

test "p2 make_request" {
  let req = make_request("GET", "/", headers_empty(), "")
  assert(String::equals(req.method, "GET"))
  assert(String::equals(req.url, "/"))
}

test "p2 make_response" {
  let resp = make_response(200, headers_empty(), "ok")
  assert(resp.status == 200)
  assert(String::equals(resp.body, "ok"))
}

test "p2 headers" {
  let h = headers_set(headers_empty(), "x-test", "value")
  match headers_get(h, "x-test") {
    Some(v) => assert(String::equals(v, "value")),
    None => assert(false)
  }
}

test "p2 status codes" {
  assert(status_ok() == 200)
  assert(status_not_found() == 404)
}

test "p2 socket surface is importable" {
  // Reference-only (no real network): the socket_* re-exports and the
  // Socket:: wrapper aliases must resolve through the facade.
  let _ = socket_connect
  let _ = socket_read
  let _ = socket_write
  let _ = socket_close
  let ep = Socket::endpoint("localhost", 8080)
  let conn = Socket::connection(42)
  assert(Socket::connection_fd(conn) == 42)
  assert(String::equals(ep.host, "localhost"))
  assert(String::equals(version, "0.0.1"))
}
