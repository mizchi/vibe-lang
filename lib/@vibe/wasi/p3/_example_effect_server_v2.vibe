//# Imports

// #897: retargeted from a direct ./http_effect.vibe import to the package
// facade — `HttpResponse`'s transparent definition now lives in index.vpkg.
import .{
  HttpResponse, json, serialize_response, text
}

//# Functions

fn route() -> HttpResponse with HttpReq {
  let method = perform HttpReq::Method
  let url = perform HttpReq::Url
  if String::equals(url, "/") {
    text(200, "Welcome to vibe P3!")
  } else if String::equals(url, "/health") {
    json(200, "{\"status\":\"ok\"}")
  } else if String::equals(url, "/api/echo") {
    if String::equals(method, "GET") {
      json(200, String::concat("{\"method\":\"", String::concat(method, String::concat("\",\"url\":\"", String::concat(url, "\"}")))))
    } else {
      text(405, "Method Not Allowed")
    }
  } else {
    text(404, "Not Found")
  }
}

export fn handler(method: String, url: String) -> String {
  let resp = handle {
    route()
  } with HttpReq {
    Method => resume(method);
    Url => resume(url)
  }
  serialize_response(resp)
}

/// Compile-time smoke of the export (top-level bare expressions are rejected
/// since ADR-0069; hosts invoke the `handler` export directly).
let _smoke = handler("GET", "/")
