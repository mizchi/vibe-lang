//# Imports

// #897: retargeted from a direct ./handler.vibe import to the package
// facade — `Handler`/`Request`/`Response`'s transparent definitions now
// live in index.vpkg, which a direct impl-file import would not include.
import .{
  Handler,
  Request,
  Response,
  request_body,
  request_header,
  request_method,
  request_url,
  respond_empty,
  respond_json,
  respond_text,
  status_internal_server_error,
  status_not_found,
  status_ok
}

//# Misc

test "respond_text" {
  let resp = respond_text(200, "hello")
  assert(resp.status == 200)
  assert(String::equals(resp.body, "hello"))
}

test "respond_json" {
  let resp = respond_json(200, "{\"ok\":true}")
  assert(resp.status == 200)
  assert(String::contains(resp.body, "ok"))
}

test "respond_empty" {
  let resp = respond_empty(204)
  assert(resp.status == 204)
  assert(String::equals(resp.body, ""))
}

test "request accessors" {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "text/plain")
  let req = Request::{
    method: "GET",
    url: "/api/hello",
    headers: MapBuilder::freeze(headers),
    body: ""
  }
  assert(String::equals(request_method(req), "GET"))
  assert(String::equals(request_url(req), "/api/hello"))
  assert(String::equals(request_body(req), ""))
}

test "request header" {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "x-custom", "foo")
  let req = Request::{
    method: "POST",
    url: "/",
    headers: MapBuilder::freeze(headers),
    body: "data"
  }
  match request_header(req, "x-custom") {
    Some(v) => assert(String::equals(v, "foo")),
    None => assert(false)
  }
  match request_header(req, "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "handler" {
  let h = Handler::{
    serve: (req: Request) -> Response {
      match request_url(req) {
        "/hello" => respond_text(200, "world"),
        _ => respond_empty(404)
      }
    }
  }
  let req_hello = Request::{
    method: "GET",
    url: "/hello",
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
  let resp = (h.serve)(req_hello)
  assert(resp.status == 200)
  assert(String::equals(resp.body, "world"))
  let req_missing = Request::{
    method: "GET",
    url: "/missing",
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
  let resp2 = (h.serve)(req_missing)
  assert(resp2.status == 404)
}

test "status codes" {
  assert(status_ok() == 200)
  assert(status_not_found() == 404)
  assert(status_internal_server_error() == 500)
}
