//# Types

effect HttpReq {
  Method -> String;
  Url -> String
}

//# Misc

test "route / inline" {
  let status = handle {
    let url = perform HttpReq::Url
    if String::equals(url, "/") {
      200
    } else {
      404
    }
  } with { HttpReq::Method => resume("GET"); HttpReq::Url => resume("/") }
  assert(status == 200)
}

test "route /missing inline" {
  let status = handle {
    let url = perform HttpReq::Url
    if String::equals(url, "/") {
      200
    } else {
      404
    }
  } with { HttpReq::Method => resume("GET"); HttpReq::Url => resume("/missing") }
  assert(status == 404)
}

test "method check inline" {
  let status = handle {
    let method = perform HttpReq::Method
    if String::equals(method, "GET") {
      200
    } else {
      405
    }
  } with { HttpReq::Method => resume("POST"); HttpReq::Url => resume("/") }
  assert(status == 405)
}

test "combined route inline" {
  let status = handle {
    let method = perform HttpReq::Method
    let url = perform HttpReq::Url
    if String::equals(url, "/health") {
      200
    } else if String::equals(method, "POST") {
      405
    } else {
      404
    }
  } with { HttpReq::Method => resume("GET"); HttpReq::Url => resume("/health") }
  assert(status == 200)
}
