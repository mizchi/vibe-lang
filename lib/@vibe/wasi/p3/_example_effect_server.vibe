//# Imports

// #897: retargeted from a direct ./http_effect.vibe import to the package
// facade — `HttpRequest`/`HttpResponse`'s transparent definitions now live
// in index.vpkg (`empty` kept even though unused, matching the original
// import list).
import .{
  HttpRequest, HttpResponse, empty, json, serialize_response, text
}

//# Functions

fn route(req: HttpRequest) -> HttpResponse {
  if String::equals(req.url, "/") {
    text(200, "Welcome to vibe P3!")
  } else if String::equals(req.url, "/health") {
    json(200, "{\"status\":\"ok\"}")
  } else if String::equals(req.url, "/api/echo") {
    if String::equals(req.method, "GET") {
      json(200, String::concat("{\"method\":\"", String::concat(req.method, String::concat("\",\"url\":\"", String::concat(req.url, "\"}")))))
    } else {
      text(405, "Method Not Allowed")
    }
  } else {
    text(404, "Not Found")
  }
}

export fn handler(method: String, url: String) -> String {
  serialize_response(route(HttpRequest::{
    method: method,
    url: url,
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }))
}

/// Compile-time smoke of the export (top-level bare expressions are rejected
/// since ADR-0069; hosts invoke the `handler` export directly).
let _smoke = handler("GET", "/")
