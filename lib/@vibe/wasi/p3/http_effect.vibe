//# Types

// #897 (ADR-0070 Phase 3): `HttpRequest` / `HttpResponse` are declared
// TRANSPARENT in index.vpkg (http_effect_test.vibe asserts
// `.status`/`.body` directly), so their definitions moved there; this file
// references them by name only. (These deliberately shadow-name @vibe/http's
// high-level structs — the two packages never meet in one merged program.)

//# Functions

export fn html(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, key = "content-type", value = "text/html; charset=utf-8")
  HttpResponse::{
    status: status,
    headers: MapBuilder::freeze(h),
    body: body
  }
}

export fn json(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, key = "content-type", value = "application/json; charset=utf-8")
  HttpResponse::{
    status: status,
    headers: MapBuilder::freeze(h),
    body: body
  }
}

export fn text(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, key = "content-type", value = "text/plain; charset=utf-8")
  HttpResponse::{
    status: status,
    headers: MapBuilder::freeze(h),
    body: body
  }
}

export fn empty(_ status: Int) -> HttpResponse {
  HttpResponse::{
    status: status,
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
}

export fn redirect(_ url: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, key = "location", value = url)
  HttpResponse::{
    status: 302,
    headers: MapBuilder::freeze(h),
    body: ""
  }
}

export fn error_to_response(_ err: String) -> HttpResponse {
  if String::starts_with(err, prefix = "BadRequest") {
    text(status = 400, body = err)
  } else if String::starts_with(err, prefix = "NotFound") {
    text(status = 404, body = "Not Found")
  } else if String::starts_with(err, prefix = "MethodNotAllowed") {
    text(status = 405, body = "Method Not Allowed")
  } else if String::starts_with(err, prefix = "Forbidden") {
    text(status = 403, body = "Forbidden")
  } else if String::starts_with(err, prefix = "InternalError") {
    text(status = 500, body = err)
  } else {
    text(status = 500, body = String::concat("Internal Server Error: ", err))
  }
}

export fn serialize_response(_ resp: HttpResponse) -> String {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, value = __to_string(resp.status))
  let keys = Map::keys(resp.headers)
  let len = Array::length(keys)
  let mut i = 0
  while i < len {
    let key = Array::get(keys, at = i)
    StringBuilder::push(sb, value = "\n")
    StringBuilder::push(sb, value = key)
    StringBuilder::push(sb, value = ": ")
    StringBuilder::push(sb, value = Map::get(resp.headers, key = key))
    i = i + 1
  }
  StringBuilder::push(sb, value = "\n\n")
  StringBuilder::push(sb, value = resp.body)
  StringBuilder::freeze(sb)
}

export fn harness(_ user_handler: (HttpRequest) -> HttpResponse with Exception) -> (String, String) -> String {
  (method: String, url: String) -> String {
    let resp = handle {
      user_handler(HttpRequest::{
        method: method,
        url: url,
        headers: MapBuilder::freeze(MapBuilder::new()),
        body: ""
      })
    } with { Exception::Throw(err) => error_to_response(err) }
    serialize_response(resp)
  }
}
