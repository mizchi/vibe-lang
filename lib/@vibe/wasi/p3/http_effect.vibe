//# Types

// #897 (ADR-0070 Phase 3): `HttpRequest` / `HttpResponse` are declared
// TRANSPARENT in index.vpkg (http_effect_test.vibe asserts
// `.status`/`.body` directly), so their definitions moved there; this file
// references them by name only. (These deliberately shadow-name @vibe/http's
// high-level structs — the two packages never meet in one merged program.)

//# Functions

export fn html(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, "content-type", "text/html; charset=utf-8")
  HttpResponse::{
    status: status, headers: MapBuilder::freeze(h), body: body
  }
}

export fn json(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, "content-type", "application/json; charset=utf-8")
  HttpResponse::{
    status: status, headers: MapBuilder::freeze(h), body: body
  }
}

export fn text(status: Int, body: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, "content-type", "text/plain; charset=utf-8")
  HttpResponse::{
    status: status, headers: MapBuilder::freeze(h), body: body
  }
}

export fn empty(status: Int) -> HttpResponse {
  HttpResponse::{
    status: status, headers: MapBuilder::freeze(MapBuilder::new()), body: ""
  }
}

export fn redirect(url: String) -> HttpResponse {
  let h = MapBuilder::new()
  MapBuilder::set(h, "location", url)
  HttpResponse::{
    status: 302, headers: MapBuilder::freeze(h), body: ""
  }
}

export fn error_to_response(err: String) -> HttpResponse {
  if String::starts_with(err, "BadRequest") {
    text(400, err)
  } else if String::starts_with(err, "NotFound") {
    text(404, "Not Found")
  } else if String::starts_with(err, "MethodNotAllowed") {
    text(405, "Method Not Allowed")
  } else if String::starts_with(err, "Forbidden") {
    text(403, "Forbidden")
  } else if String::starts_with(err, "InternalError") {
    text(500, err)
  } else {
    text(500, String::concat("Internal Server Error: ", err))
  }
}

export fn serialize_response(resp: HttpResponse) -> String {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, __to_string(resp.status))
  let keys = Map::keys(resp.headers)
  let len = Array::length(keys)
  let mut i = 0
  while i < len {
    let key = Array::get(keys, i)
    StringBuilder::push(sb, "\n")
    StringBuilder::push(sb, key)
    StringBuilder::push(sb, ": ")
    StringBuilder::push(sb, Map::get(resp.headers, key))
    i = i + 1
  }
  StringBuilder::push(sb, "\n\n")
  StringBuilder::push(sb, resp.body)
  StringBuilder::freeze(sb)
}

export fn harness(user_handler: (HttpRequest) -> HttpResponse with Exception) -> (String, String) -> String {
  (method: String, url: String) -> String {
    let resp = handle {
      user_handler(HttpRequest::{
        method: method, url: url, headers: MapBuilder::freeze(MapBuilder::new()), body: ""
      })
    } with Exception {
      Throw(err) => error_to_response(err)
    }
    serialize_response(resp)
  }
}
