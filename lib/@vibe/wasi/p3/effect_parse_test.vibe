//# Imports

import @vibe/compiler {
  lex, parse_program, print_program
}

//# Functions

fn parse_ok(source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _ = print_program(stmts)
    true
  } with Exception {
    Throw(_) => false
  }
}

//# Misc

test "effect basic" {
  assert(parse_ok("effect Console {\n  Print(String) -> Unit;\n  ReadLine -> String\n}\n0"))
}

test "effect generic" {
  assert(parse_ok("effect State[S] {\n  Get -> S;\n  Put(S) -> Unit\n}\n0"))
}

test "effect multi param" {
  assert(parse_ok("effect Channel[T, E] {\n  Send(T) -> Unit;\n  Receive -> T;\n  Close -> Unit\n}\n0"))
}

test "effect http request" {
  assert(parse_ok("effect HttpRequest {\n  Method -> String;\n  Url -> String\n}\n0"))
}

test "export effect" {
  assert(parse_ok("export effect Logger {\n  Info(String) -> Unit\n}\n0"))
}

test "effect roundtrip" {
  handle {
    let source = "effect Mut[T] {\n  Get -> T;\n  Set(T) -> Unit\n}\n0"
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let printed = print_program(stmts)
    let tokens2 = lex(printed)
    let stmts2 = parse_program(tokens2)
    let printed2 = print_program(stmts2)
    assert(String::equals(printed, printed2))
  } with Exception {
    Throw(e) => assert(false)
  }
}
