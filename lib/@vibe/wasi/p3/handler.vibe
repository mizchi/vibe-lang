//# Types

export struct Request {
  method: String;
  url: String;
  headers: Map[String, String];
  body: String
}

export struct Response {
  status: Int;
  headers: Map[String, String];
  body: String
}

export struct Handler {
  serve: (Request) -> Response
}

//# Functions

export let status_ok = () -> Int {
  200
}

export let request_url = (req: Request) -> String {
  req.url
}

export let request_body = (req: Request) -> String {
  req.body
}

export let respond_json = (status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "application/json; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export let respond_text = (status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "text/plain; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export let respond_empty = (status: Int) -> Response {
  Response::{
    status: status,
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
}

// #778: `String::to_lower` is a checker-recognized builtin name with no
// codegen implementation (undefined variable (local): String::to_lower
// @call). Normalize header names with an explicit char-code loop instead of
// relying on the broken builtin.
let ascii_lower = (s: String) -> String {
  let len = String::length(s)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    }
    else {
      let code = String::char_code_at(s, i)
      let lower_code = if code >= 65 && code <= 90 {
        code + 32
      } else code
      go(i + 1, String::concat(acc, String::from_char_code(lower_code)))
    }
  }
  go(0, "")
}

export let request_header = (req: Request, name: String) -> Option[String] {
  let key = ascii_lower(name)
  if Map::has_key(req.headers, key) {
    Some(Map::get(req.headers, key))
  } else None
}

export let request_method = (req: Request) -> String {
  req.method
}

export let status_created = () -> Int {
  201
}

export let status_not_found = () -> Int {
  404
}

export let status_no_content = () -> Int {
  204
}

export let status_bad_request = () -> Int {
  400
}

export let status_method_not_allowed = () -> Int {
  405
}

export let status_internal_server_error = () -> Int {
  500
}
