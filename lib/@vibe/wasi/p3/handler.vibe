//# Types

// #897 (ADR-0070 Phase 3): `Request` / `Response` / `Handler` are declared
// TRANSPARENT in index.vpkg (handler_test.vibe constructs them and asserts
// `.status`/`.body`/`.serve` directly), so their definitions moved there;
// this file references them by name only (types are global in the merged
// program, same convention as ShResult in @vibe/process, PR #920).

//# Functions

// #897: moved from the old index.vibe facade — a real importable binding,
// not just contract metadata (Codex review precedent, PR #914).

export fn status_ok() -> Int {
  200
}

export fn request_url(req: Request) -> String {
  req.url
}

export fn request_body(req: Request) -> String {
  req.body
}

export fn respond_json(status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "application/json; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export fn respond_text(status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "text/plain; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export fn respond_empty(status: Int) -> Response {
  Response::{
    status: status,
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
}

// #778: `String::to_lower` is a checker-recognized builtin name with no
// codegen implementation (undefined variable (local): String::to_lower
// @call). Normalize header names with an explicit char-code loop instead of
// relying on the broken builtin.
fn ascii_lower(s: String) -> String {
  let len = String::length(s)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    }
    else {
      let code = String::char_code_at(s, i)
      let lower_code = if code >= 65 && code <= 90 {
        code + 32
      } else code
      go(i + 1, String::concat(acc, String::from_char_code(lower_code)))
    }
  }
  go(0, "")
}

export fn request_header(req: Request, name: String) -> Option[String] {
  let key = ascii_lower(name)
  if Map::has_key(req.headers, key) {
    Some(Map::get(req.headers, key))
  } else None
}

export fn request_method(req: Request) -> String {
  req.method
}

export fn status_created() -> Int {
  201
}

export fn status_not_found() -> Int {
  404
}

export fn status_no_content() -> Int {
  204
}

export fn status_bad_request() -> Int {
  400
}

export fn status_method_not_allowed() -> Int {
  405
}

export fn status_internal_server_error() -> Int {
  500
}
