// #897 (ADR-0070 Phase 3): the parent @vibe/wasi umbrella package's only
// surface is `version` — this test exists so the index.vpkg contract is
// actually conformance-checked somewhere (nothing else imports the parent
// facade; the real APIs live in the NESTED @vibe/wasi/p2 and @vibe/wasi/p3
// packages, covered by their own tests).

import .{
  version
}

test "wasi umbrella facade exports version" {
  assert(String::equals(version, "0.0.1"))
}
