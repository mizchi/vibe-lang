//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./symbol_index.vibe {
  collect_refs, collect_refs_stmts, collect_symbols, filter_by_kind, filter_exported, find_referenced_symbols, find_symbol
}

//# Functions

fn _use_pat(p: Pat) -> Pat {
  p
}

let no_tparams = Array::slice([""], 0, 0)

let no_bounds = Array::slice([("", no_tparams)], 0, 0)

fn mk_fn_body() -> Expr {
  EFn(no_tparams, no_bounds, [("x", None)], None, None, EIdent("x", -1))
}

fn _use_type_expr(t: TypeExpr) -> TypeExpr {
  t
}

//# Misc

test "collect_symbols finds SLet function (kind=0)" {
  let stmts = [SLet(true, false, "add", None, mk_fn_body())]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "add")
  assert(kind == 0)
  assert(exported)
}

test "collect_symbols finds SLet value (kind=1)" {
  let stmts = [SLet(false, false, "x", None, EInt(42))]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "x")
  assert(kind == 1)
  assert(not(exported))
}

test "collect_symbols finds SEnum type (kind=2) and constructors (kind=3)" {
  let no_types = Array::slice([TyName("_")], 0, 0)
  let variants = [("Some", [TyName("Int")]), ("None", no_types)]
  let stmts = [
    SEnum(true, "Option", Array::slice([""], 0, 0), variants, Array::slice([""], 0, 0))
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 3)
  let (n0, k0, _) = Array::get(syms, 0)
  assert(n0 == "Option")
  assert(k0 == 2)
  let (n1, k1, _) = Array::get(syms, 1)
  assert(n1 == "Some")
  assert(k1 == 3)
  let (n2, k2, _) = Array::get(syms, 2)
  assert(n2 == "None")
  assert(k2 == 3)
}

test "collect_symbols finds SStruct (kind=2)" {
  let stmts = [
    SStruct(true, "Point", [("x", TyName("Int")), ("y", TyName("Int"))], Array::slice([
      ""
    ], 0, 0), Array::slice([""], 0, 0), Array::slice([""], 0, 0))
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "Point")
  assert(kind == 2)
  assert(exported)
}

test "collect_symbols finds STrait (kind=4)" {
  let stmts = [
    STrait(true, "Show", ["show"], ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()))
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "Show")
  assert(kind == 4)
  assert(exported)
}

test "collect_symbols respects exported flag" {
  let stmts = [
    SLet(true, false, "pub_fn", None, mk_fn_body()),
    SLet(false, false, "priv_fn", None, mk_fn_body())
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 2)
  let (_, _, e0) = Array::get(syms, 0)
  assert(e0)
  let (_, _, e1) = Array::get(syms, 1)
  assert(not(e1))
}

test "filter_by_kind filters correctly" {
  let stmts = [
    SLet(true, false, "add", None, mk_fn_body()),
    SLet(false, false, "x", None, EInt(42)),
    SStruct(true, "Point", [("x", TyName("Int"))], Array::slice([""], 0, 0), Array::slice([
      ""
    ], 0, 0), Array::slice([""], 0, 0))
  ]
  let syms = collect_symbols(stmts)
  let fns = filter_by_kind(syms, 0)
  assert(Array::length(fns) == 1)
  let (name, _, _) = Array::get(fns, 0)
  assert(name == "add")
  let types = filter_by_kind(syms, 2)
  assert(Array::length(types) == 1)
}

test "filter_exported filters exported only" {
  let stmts = [
    SLet(true, false, "pub_fn", None, mk_fn_body()),
    SLet(false, false, "priv_fn", None, mk_fn_body()),
    SStruct(true, "Point", [("x", TyName("Int"))], Array::slice([""], 0, 0), Array::slice([
      ""
    ], 0, 0), Array::slice([""], 0, 0))
  ]
  let syms = collect_symbols(stmts)
  let exported = filter_exported(syms)
  assert(Array::length(exported) == 2)
}

test "find_symbol finds existing symbol" {
  let stmts = [
    SLet(true, false, "add", None, mk_fn_body()),
    SLet(false, false, "x", None, EInt(42))
  ]
  let syms = collect_symbols(stmts)
  match find_symbol(syms, "x") {
    Some(entry) => {
      let (name, kind, _) = entry
      assert(name == "x")
      assert(kind == 1)
    },
    None => assert(false)
  }
}

test "find_symbol returns None for missing" {
  let stmts = [SLet(true, false, "add", None, mk_fn_body())]
  let syms = collect_symbols(stmts)
  match find_symbol(syms, "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "collect_refs finds identifiers in expression" {
  let expr = ECall(EIdent("add", -1), [EIdent("x", -1), EIdent("y", -1)], -1)
  let refs = collect_refs(expr)
  assert(Array::length(refs) == 3)
}

test "find_referenced_symbols intersects symbols and refs" {
  let stmts = [
    SLet(true, false, "add", None, mk_fn_body()),
    SLet(false, false, "unused", None, EInt(0)),
    SLet(false, false, "x", None, EInt(1))
  ]
  let syms = collect_symbols(stmts)
  let refs = ["add", "x"]
  let referenced = find_referenced_symbols(syms, refs)
  assert(Array::length(referenced) == 2)
  let (n0, _, _) = Array::get(referenced, 0)
  assert(n0 == "add")
  let (n1, _, _) = Array::get(referenced, 1)
  assert(n1 == "x")
}

test "collect_symbols finds SModule (kind=5)" {
  let stmts = [
    SModule(true, "MyMod", [SLet(false, false, "inner", None, EInt(1))])
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "MyMod")
  assert(kind == 5)
  assert(exported)
}

test "collect_symbols finds SExternLet (kind=1)" {
  let stmts = [
    SExternLet("print", TyFn([TyName("String")], TyName("Unit"), None))
  ]
  let syms = collect_symbols(stmts)
  assert(Array::length(syms) == 1)
  let (name, kind, exported) = Array::get(syms, 0)
  assert(name == "print")
  assert(kind == 1)
  assert(not(exported))
}

test "collect_refs deduplicates" {
  let expr = EBinOp("+", EIdent("x", -1), EIdent("x", -1), -1)
  let refs = collect_refs(expr)
  assert(Array::length(refs) == 1)
}

test "collect_refs_stmts across multiple stmts" {
  let stmts = [
    SLet(false, false, "a", None, ECall(EIdent("f", -1), [EIdent("x", -1)], -1)),
    SLet(false, false, "b", None, EIdent("y", -1))
  ]
  let refs = collect_refs_stmts(stmts)
  assert(Array::length(refs) == 3)
}
