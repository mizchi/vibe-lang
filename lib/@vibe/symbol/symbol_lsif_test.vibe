//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

import ./symbol_index.vibe {
  collect_symbols
}

import ./symbol_lsif.vibe {
  find_references_in,
  format_symbol,
  format_symbols,
  generate_def_index,
  generate_lsif_report,
  generate_ref_index,
  hover_info,
  kind_to_string
}

//# Functions

fn _use_pat(_ p: Pat) -> Pat {
  p
}

let no_tparams = Array::slice([""], start = 0, end = 0)

let no_bounds = Array::slice([("", no_tparams)], start = 0, end = 0)

fn mk_fn_body() -> Expr {
  EFn(no_tparams, no_bounds, [("x", None)], None, None, EIdent("x", -1))
}

fn _use_type_expr(_ t: TypeExpr) -> TypeExpr {
  t
}

//# Misc

test "kind_to_string returns function for 0" {
  assert(kind_to_string(0) == "function")
}

test "kind_to_string returns type for 2" {
  assert(kind_to_string(2) == "type")
}

test "format_symbol produces correct format" {
  let sym = ("foo", 0, true)
  let result = format_symbol(sym)
  assert(result == "function:foo:true")
}

test "format_symbols joins with newlines" {
  let syms = [("foo", 0, true), ("bar", 1, false)]
  let result = format_symbols(syms)
  assert(String::contains(result, needle = "function:foo:true"))
  assert(String::contains(result, needle = "value:bar:false"))
}

test "generate_def_index includes function definitions" {
  let stmts = [SLet(true, false, "add", None, mk_fn_body())]
  let result = generate_def_index(stmts)
  assert(String::contains(result, needle = "function:add:true"))
}

test "generate_def_index includes enum types and constructors" {
  let no_types = Array::slice([TyName("_")], start = 0, end = 0)
  let variants = [("Some", [TyName("Int")]), ("None", no_types)]
  let stmts = [
    SEnum(true, "Option", Array::slice([""], start = 0, end = 0), variants, Array::slice([
      ""
    ], start = 0, end = 0))
  ]
  let result = generate_def_index(stmts)
  assert(String::contains(result, needle = "type:Option:true"))
  assert(String::contains(result, needle = "constructor:Some:true"))
  assert(String::contains(result, needle = "constructor:None:true"))
}

test "hover_info for existing symbol" {
  let syms = [("add", 0, true)]
  let result = hover_info(symbols = syms, name = "add")
  assert(String::contains(result, needle = "function"))
  assert(String::contains(result, needle = "add"))
  assert(String::contains(result, needle = "(exported)"))
}

test "hover_info for unknown returns unknown" {
  let syms = [("add", 0, true)]
  let result = hover_info(symbols = syms, name = "missing")
  assert(result == "unknown")
}

test "find_references_in finds referencing functions" {
  let stmts = [
    SLet(true, false, "helper", None, mk_fn_body()),
    SLet(false, false, "caller", None, ECall(EIdent("helper", -1), [EInt(1)], -1, [
    ]))
  ]
  let refs = find_references_in(stmts = stmts, target_name = "helper")
  assert(Array::length(refs) == 1)
  assert(Array::get(refs, at = 0) == "caller")
}

test "find_references_in target not referenced returns empty" {
  let stmts = [
    SLet(false, false, "a", None, EInt(1)),
    SLet(false, false, "b", None, EInt(2))
  ]
  let refs = find_references_in(stmts = stmts, target_name = "missing")
  assert(Array::length(refs) == 0)
}

test "generate_ref_index marks defined and undefined" {
  let stmts = [
    SLet(true, false, "helper", None, mk_fn_body()),
    SLet(false, false, "caller", None, ECall(EIdent("helper", -1), [
      EIdent("unknown_var", -1)
    ], -1, []))
  ]
  let result = generate_ref_index(stmts)
  assert(String::contains(result, needle = "ref:helper:defined"))
  assert(String::contains(result, needle = "ref:unknown_var:undefined"))
}

test "generate_lsif_report contains both sections" {
  let stmts = [
    SLet(true, false, "foo", None, mk_fn_body()),
    SLet(false, false, "bar", None, ECall(EIdent("foo", -1), [EInt(1)], -1, []))
  ]
  let result = generate_lsif_report(stmts)
  assert(String::contains(result, needle = "=== Definitions ==="))
  assert(String::contains(result, needle = "=== References ==="))
  assert(String::contains(result, needle = "function:foo:true"))
  assert(String::contains(result, needle = "ref:foo:defined"))
}
