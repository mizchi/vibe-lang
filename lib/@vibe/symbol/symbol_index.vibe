//# Imports

import @vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

//# Values

//# Functions

export fn find_symbol(symbols: Array[(String, Int, Bool)], name: String) -> Option[(String, Int, Bool)] {
  let len = Array::length(symbols)
  let rec search: (Int) -> Option[(String, Int, Bool)] = (i) -> {
    if i >= len {
      None
    }
    else {
      let entry = Array::get(symbols, at = i)
      let (n, _, _) = entry
      if n == name {
        Some(entry)
      }
      else search(i + 1)
    }
  }
  search(0)
}

fn empty_symbols() -> Array[(String, Int, Bool)] {
  Array::slice([("", 0, false)], start = 0, end = 0)
}

export fn filter_by_kind(symbols: Array[(String, Int, Bool)], kind: Int) -> Array[(String, Int, Bool)] {
  let out = empty_symbols()
  let mut i = 0
  while i < Array::length(symbols) {
    let (name, k, exported) = Array::get(symbols, at = i)
    if k == kind {
      Array::push(out, value = (name, k, exported))
    }
    i = i + 1
  }
  out
}

export fn collect_symbols(_ stmts: Array[Stmt]) -> Array[(String, Int, Bool)] {
  let out = empty_symbols()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(exported, _, name, _, body) => {
        let is_fn = match body {
          EFn(_, _, _, _, _, _) => true,
          _ => false
        }
        let kind = if is_fn {
          0
        } else {
          1
        }
        Array::push(out, value = (name, kind, exported))
      },
      SLetMut(name, _, _) => Array::push(out, value = (name, 1, false))
      ,
      SEnum(exported, name, _, variants, _) => {
        Array::push(out, value = (name, 2, exported))
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = j)
          Array::push(out, value = (vname, 3, exported))
          j = j + 1
        }
      },
      SSuberror(exported, name, variants) => {
        Array::push(out, value = (name, 2, exported))
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = j)
          Array::push(out, value = (vname, 3, exported))
          j = j + 1
        }
      },
      SEffectDef(exported, name, _, _, _) => Array::push(out, value = (name, 2, exported))
      ,
      SStruct(exported, name, _, _, _, _) => Array::push(out, value = (name, 2, exported))
      ,
      STypeAlias(exported, name, _, _) => Array::push(out, value = (name, 2, exported))
      ,
      STrait(exported, name, _, _, _, _) => Array::push(out, value = (name, 4, exported))
      ,
      SModule(exported, name, _) => Array::push(out, value = (name, 5, exported))
      ,
      SExternLet(name, _) => Array::push(out, value = (name, 1, false))
      ,
      _ => {
      }
    }
    i = i + 1
  }
  out
}

export fn filter_exported(_ symbols: Array[(String, Int, Bool)]) -> Array[(String, Int, Bool)] {
  let out = empty_symbols()
  let mut i = 0
  while i < Array::length(symbols) {
    let (name, k, exported) = Array::get(symbols, at = i)
    if exported {
      Array::push(out, value = (name, k, exported))
    }
    i = i + 1
  }
  out
}

fn array_contains_str(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let rec search: (Int) -> Bool = (i) -> {
    if i >= len {
      false
    }
    else if Array::get(arr, at = i) == s {
      true
    }
    else search(i + 1)
  }
  search(0)
}

fn collect_refs_into(expr: Expr, out: Array[String]) -> Int {
  match expr {
    EIdent(name, _) => {
      if not(array_contains_str(arr = out, s = name)) {
        Array::push(out, value = name)
      }
      0
    },
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => collect_refs_into(expr = e, out = out),
    EUnaryOp(_, e) => collect_refs_into(expr = e, out = out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_refs_into(expr = val, out = out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r, _) => {
      collect_refs_into(expr = l, out = out)
      collect_refs_into(expr = r, out = out)
      0
    },
    ECall(callee, args, _, _) => {
      collect_refs_into(expr = callee, out = out)
      let mut i = 0
      while i < Array::length(args) {
        collect_refs_into(expr = Array::get(args, at = i), out = out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_refs_into(expr = cond, out = out)
      collect_refs_into(expr = then_e, out = out)
      collect_refs_into(expr = else_e, out = out)
      0
    },
    ELet(_, val, body, _) => {
      collect_refs_into(expr = val, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    ELetRec(_, val, body) => {
      collect_refs_into(expr = val, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    ELetMut(_, val, body, _) => {
      collect_refs_into(expr = val, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    EAssign(_, val, body, _) => {
      collect_refs_into(expr = val, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    EAssignOp(_, _, val, body, _) => {
      collect_refs_into(expr = val, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    ESeq(l, r) => {
      collect_refs_into(expr = l, out = out)
      collect_refs_into(expr = r, out = out)
      0
    },
    EMatch(scr, arms) => {
      collect_refs_into(expr = scr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, at = i)
        collect_refs_into(expr = body, out = out)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_refs_into(expr = body_expr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, at = i)
        collect_refs_into(expr = arm_body, out = out)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_refs_into(expr = cond, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, at = i)
        collect_refs_into(expr = init, out = out)
        i = i + 1
      }
      collect_refs_into(expr = body, out = out)
      0
    },
    EForIn(_, _, iter, body) => {
      collect_refs_into(expr = iter, out = out)
      collect_refs_into(expr = body, out = out)
      0
    },
    EFn(_, _, _, _, _, body) => {
      collect_refs_into(expr = body, out = out)
      0
    },
    EDot(obj, _, _, _) => {
      collect_refs_into(expr = obj, out = out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_refs_into(expr = e, out = out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_refs_into(expr = val, out = out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_refs_into(expr = e, out = out)
      0
    },
    EStringInterp(_) => 0
  }
}

export fn collect_refs(_ expr: Expr) -> Array[String] {
  let out = Array::slice([""], start = 0, end = 0)
  collect_refs_into(expr = expr, out = out)
  out
}

export fn collect_refs_stmts(_ stmts: Array[Stmt]) -> Array[String] {
  let out = Array::slice([""], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, _, _, body) => collect_refs_into(expr = body, out = out)
      ,
      SLetMut(_, _, body) => collect_refs_into(expr = body, out = out)
      ,
      SExpr(e) => collect_refs_into(expr = e, out = out)
      ,
      STest(_, e) => collect_refs_into(expr = e, out = out)
      ,
      SBench(_, e) => collect_refs_into(expr = e, out = out)
      ,
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn find_referenced_symbols(symbols: Array[(String, Int, Bool)], refs: Array[String]) -> Array[(String, Int, Bool)] {
  let out = empty_symbols()
  let mut i = 0
  while i < Array::length(symbols) {
    let (name, kind, exported) = Array::get(symbols, at = i)
    if array_contains_str(arr = refs, s = name) {
      Array::push(out, value = (name, kind, exported))
    }
    i = i + 1
  }
  out
}
