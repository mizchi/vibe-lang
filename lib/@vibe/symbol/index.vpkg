version 0.0.1

// @vibe/symbol — declaration outline / reference collection / LSIF report
// generation over the compiler's own AST (ADR-0070 Phase 3, #897), the
// engine behind `vibe symbols` / editor go-to-def / hover. Both impl files
// (symbol_index.vibe, symbol_lsif.vibe) import ../ast for Expr/Pat/Stmt/
// TypeExpr; the contract's own fn declarations below name Expr/Stmt as
// plain type syntax without re-importing them — same precedent as
// @vibe/parser's index.vpkg, whose declared signatures use Expr/Stmt/
// TypeExpr with no `import ../ast` line, since a contract's type
// occurrences are structural signature text, resolved against the real
// implementation import when the facade is merged in. Each file's private
// helpers (empty_symbols/array_contains_str/collect_refs_into in
// symbol_index.vibe; array_contains_str in symbol_lsif.vibe) are not
// exported and so are intentionally not part of this contract.

import ./symbol_index.vibe {}
import ./symbol_lsif.vibe {}

// --- symbol_index
fn find_symbol(symbols: Array[(String, Int, Bool)], name: String) -> Option[(String, Int, Bool)]
fn filter_by_kind(symbols: Array[(String, Int, Bool)], kind: Int) -> Array[(String, Int, Bool)]
fn collect_symbols(stmts: Array[Stmt]) -> Array[(String, Int, Bool)]
fn filter_exported(symbols: Array[(String, Int, Bool)]) -> Array[(String, Int, Bool)]
fn collect_refs(expr: Expr) -> Array[String]
fn collect_refs_stmts(stmts: Array[Stmt]) -> Array[String]
fn find_referenced_symbols(symbols: Array[(String, Int, Bool)], refs: Array[String]) -> Array[(String, Int, Bool)]

// --- symbol_lsif
fn kind_to_string(kind: Int) -> String
fn hover_info(symbols: Array[(String, Int, Bool)], name: String) -> String
fn format_symbol(sym: (String, Int, Bool)) -> String
fn format_symbols(symbols: Array[(String, Int, Bool)]) -> String
fn find_references_in(stmts: Array[Stmt], target_name: String) -> Array[String]
fn generate_def_index(stmts: Array[Stmt]) -> String
fn generate_ref_index(stmts: Array[Stmt]) -> String
fn generate_lsif_report(stmts: Array[Stmt]) -> String
