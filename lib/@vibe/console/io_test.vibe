//# Imports

import ./io.vibe {
  eprint, eprintln, ewrite_char, print, println, read, read_char, read_line, write_char
}

//# Misc

test "println and print run with Stdout effect" {
  let run: () -> Unit with Stdout = () -> {
    {
      print("hello")
      println(" world")
    }
  }
  run()
  assert(true)
}

test "write_char runs with Stdout effect" {
  let run: () -> Unit with Stdout = () -> {
    write_char(65)
  }
  run()
  assert(true)
}

/// #865: eprint/eprintln/ewrite_char, mirroring the print/println/write_char
/// tests above but under the `Stderr` effect. Whether the bytes actually land
/// on fd 2 (not fd 1) is a process-level property a `.vibe` test block cannot
/// observe from inside itself -- see fixtures/runtime/stderr_write_check.vibe
/// and the #865 report for the shell-level (`vibe_run.sh ... 1>only_stdout`)
/// confirmation that Stderr writes land on the real stderr fd.
test "eprintln and eprint run with Stderr effect" {
  let run: () -> Unit with Stderr = () -> {
    {
      eprint("hello")
      eprintln(" world")
    }
  }
  run()
  assert(true)
}

test "ewrite_char runs with Stderr effect" {
  let run: () -> Unit with Stderr = () -> {
    ewrite_char(65)
  }
  run()
  assert(true)
}

test "read_line returns empty on eof" {
  assert(read_line() == "")
}

test "read returns empty for zero bytes" {
  let result = read(0)
  assert(result == "")
}

test "read_char returns -1 on eof" {
  let c = read_char()
  assert(c < 0)
}
