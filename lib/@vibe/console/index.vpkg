name = @vibe/console
version = 0.0.1
description =
  #|@vibe/console — stdin/stdout/stderr line- and byte-level I/O primitives
deps = {
  @vibe/builtin : 0.0.1
}

generated_hash =

// @vibe/console — stdin/stdout/stderr line- and byte-level I/O primitives
// (ADR-0070 Phase 3, #897). #1539 adds one compiler-owned opaque type,
// StdinStream; it is represented by an unforgeable scalar provider token and
// cannot be constructed as a struct/enum or converted to generic HostStream.
//
// `read`/`print`/`println`/`read_char`/`read_line`/`read_n`/`read_all`/
// `write_char` carry the checker-builtin `Stdin`/`Stdout` effects (no import
// needed — see checker/builtins_system.vibe); `eprint`/`eprintln`/
// `ewrite_char` (#865) carry `Stderr` the same way.
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a REAL importable binding, not just metadata — so it
// is preserved verbatim as an implementation-file value (io.vibe) with a
// matching bodyless declaration here (Codex review, PR #914).
//
// The old index.vibe facade ALSO defined its "canonical collision-safe
// aliases" (io_read, io_print, ...) as plain `export let io_read = read`
// VALUE aliases directly in the facade file — real importable bindings,
// same trap as `version`. A `.vpkg` facade only allocates a declared name to
// an EXPORTED FN/type def in a sibling impl file (contract/index.vibe's
// `contract_facade_source`/`collect_impl_fn_defs` matches an `SLet` whose
// value is an `EFn`; a bare alias has no fn body), so these are re-expressed
// as real thin wrapper functions in io.vibe (same names, signatures, and
// effect rows) rather than value aliases — behaviorally identical for every
// caller (see io/index_import_test.vibe, which only ever calls them).
//
// stdin_stream_main.vibe's `print_stdin_sum`/`echo_stdin`/`split_stdin` are
// `export fn` in the impl
// file but were never re-exported by the old index.vibe facade — like
// @vibe/path's `ref.vibe` (PR #914), conformance still requires every
// exported def declared here regardless of what the old hand-written facade
// happened to surface.
//
// example_io.vibe (Codex review, PR #915) held only non-exported `fn`s
// (greet/echo_line/write_abc) backing its own side-effecting `test` blocks
// (stdin reads, stdout prints) — it was never a real package member, just
// misnamed. Under implicit membership, ANY plain `.vibe` sibling not
// matching the `_test.vibe`/`_bench.vibe`/`.draft.vibe`/`_`-prefix exclusion
// gets merged into every consumer of this package, which would compile (and
// on a no-entry `vibe test` run, EXECUTE) those side-effecting example tests
// as a hidden side effect of merely importing @vibe/io. Renamed to
// example_io_test.vibe so it's excluded like any other test file.

// --- atomic stdin provider lifecycle (#1539)
type StdinStream
fn Stdin::read_via_stream() -> StdinStream with Stdin
fn StdinStream::next(stream: StdinStream) -> Int with Async
fn StdinStream::close(stream: StdinStream) -> Unit with Async
fn StdinStream::read_chunk(stream: StdinStream, chunk_size: Int) -> Option[String] with Async

// --- io
fn read(max_bytes: Int) -> String with Stdin
fn print(s: String) -> Unit with Stdout
fn println(s: String) -> Unit with Stdout
fn read_char() -> Int with Stdin
fn read_line() -> String with Stdin
fn read_n(n: Int) -> String with Stdin
fn read_all() -> String with Stdin
fn write_char(code: Int) -> Unit with Stdout
fn eprint(s: String) -> Unit with Stderr
fn eprintln(s: String) -> Unit with Stderr
fn ewrite_char(code: Int) -> Unit with Stderr

// --- io (canonical collision-safe aliases)
fn io_read(max_bytes: Int) -> String with Stdin
fn io_read_all() -> String with Stdin
fn io_read_n(n: Int) -> String with Stdin
fn io_print(s: String) -> Unit with Stdout
fn io_println(s: String) -> Unit with Stdout
fn io_read_char() -> Int with Stdin
fn io_read_line() -> String with Stdin
fn io_write_char(code: Int) -> Unit with Stdout
fn io_eprint(s: String) -> Unit with Stderr
fn io_eprintln(s: String) -> Unit with Stderr
fn io_ewrite_char(code: Int) -> Unit with Stderr

// --- stdin_stream_main
fn print_stdin_sum() -> Unit with Stdin + Stdout
fn echo_stdin() -> Unit with Stdin + Stdout
fn split_stdin() -> Unit with Stdin + Stdout

// --- tui (#2102: moved from @vibe/builtin/io.vibe)
// Every one carries `Stdout` in its signature, which is the line between this
// package and the language's own helpers -- they were never `Int::abs`'s
// neighbours. The stdio wrappers that came with them (`stdout_write` /
// `stdout_writeln` / `stdin_read` / `stdin_read_line`) are NOT here: each
// duplicated a name this contract already publishes above.
fn ansi_escape(suffix: String) -> Unit with Stdout
fn tui_cursor_home() -> Unit with Stdout
fn tui_clear_screen() -> Unit with Stdout
fn tui_enter_alt_screen() -> Unit with Stdout
fn tui_leave_alt_screen() -> Unit with Stdout
fn tap[T](x: T, f: (v: T) -> Unit with Stdout) -> T with Stdout
fn tap_some[T](opt: Option[T], f: (v: T) -> Unit with Stdout) -> Option[T] with Stdout
