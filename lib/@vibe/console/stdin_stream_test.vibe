// #761 regression: byte_stream's pull closures are
// `() -> Option[String] with Stdin` values threaded through HOF terminals,
// and this test drains them at the (host-effectful) test top level — both paths
// the selfhost effect checker now accepts.

//# Imports

import ./io.vibe {
  read_all, read_char, read_n
}
import ./byte_stream.vibe {
  stdin_stream, stream_byte_length, stream_collect, stream_to_string
}

//# Functions

/// Drain the host stdin byte stream via repeated read_char() until EOF (-1),
/// summing the byte values. This is the consume-loop shape M2c-3 uses to read a
/// host-provided byte stream (docs/spec/wasi-p3-async.md §3.3); with the WASI
/// 0.2 input-stream bridge the host (node runner) feeds the bytes.
export fn sum_stdin_bytes() -> Int with Stdin {
  let mut sum = 0
  let mut done = false
  while not(done) {
    let c = read_char()
    if c < 0 {
      done = true
    } else {
      sum = sum + c
    }
  }
  sum
}

//# Misc

test "sum_stdin_bytes drains to EOF (empty stdin -> 0)" {
  // Without VIBE_STDIN_BYTES the host stream is empty, so the loop must
  // terminate at EOF with sum 0. The feed case (sum 198 for "ABC") is checked
  // end-to-end by scripts/test_host_stream_bridge.sh.
  assert(sum_stdin_bytes() == 0)
}

test "read_all drains to EOF (empty stdin -> \"\")" {
  // Same EOF guarantee for the whole-body reader; the feed round-trip
  // ("hello world" echoed back) is checked by the host-stream-bridge gate.
  assert(read_all() == "")
}

test "read_n stops at EOF / zero (empty stdin -> \"\")" {
  // read_n(0) reads nothing; read_n(n) on empty stdin stops at EOF with "".
  // The chunked-read cursor advance (read_n(3) then read_all) is checked
  // end-to-end by scripts/test_host_stream_bridge.sh.
  assert(read_n(0) == "")
  assert(read_n(8) == "")
}

test "ByteStream over empty stdin yields nothing" {
  // An empty host stream produces no chunks: fold keeps init, collect is empty.
  // The fed case (stream_echo / stream_total over a real body) is checked
  // end-to-end by scripts/test_host_stream_bridge.sh.
  assert(stream_byte_length(stdin_stream(4)) == 0)
  assert(Array::length(stream_collect(stdin_stream(4))) == 0)
  assert(stream_to_string(stdin_stream(4)) == "")
}

test "for over empty host stream yields no iterations" {
  // `for x in <pull-closure>` desugars to a pull-to-EOF loop. With no
  // VIBE_STDIN_BYTES the stream is empty, so zero iterations. Non-Array
  // iterator loops are statement-shaped; use stream_collect when an Array is
  // wanted (covered immediately above).
  // The fed case (echo a body) is checked by scripts/test_host_stream_bridge.sh.
  let mut seen = 0
  for _chunk in stdin_stream(4) {
    seen = seen + 1
  }
  assert(seen == 0)
}
