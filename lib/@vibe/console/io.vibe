//# Values

//# Functions

export fn read(max_bytes: Int) -> String with Stdin {
  Stdin::read_stream(max_bytes)
}

export fn print(s: String) -> Unit with Stdout {
  Stdout::write_stream(s)
}

export fn println(s: String) -> Unit with Stdout {
  {
    Stdout::write_stream(s)
    Stdout::write_char(10)
  }
}

export fn read_char() -> Int with Stdin {
  Stdin::read_char()
}

export fn read_line() -> String with Stdin {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = Stdin::read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else "\{acc}\{String::from_char_code(c)}"
    }
    acc
  }
}

/// Read up to `n` bytes from the input stream, returning whatever is available
/// in a single bounded pull (a short read while the stream is open is returned
/// as-is; "" signals EOF). This is the "pull a chunk" primitive a stream.read
/// loop / Stream::next uses: `Stdin::read_stream` issues ONE
/// input-stream.blocking-read with len=n rather than n single-byte reads, so it
/// preserves short reads and avoids per-byte host-call overhead
/// (docs/spec/wasi-p3-async.md §3.3). The stream cursor advances, so repeated
/// calls read successive chunks. `n <= 0` yields "".
export fn read_n(n: Int) -> String with Stdin {
  Stdin::read_stream(n)
}

/// Drain the input stream to EOF and return the whole body as a String — the
/// "read the entire request body" primitive a WASI HTTP handler needs. Pulls
/// bounded chunks via read_n until EOF ("") and accumulates into a StringBuilder
/// (frozen once), so large bodies cost O(n) and a bounded number of host calls.
export fn read_all() -> String with Stdin {
  {
    let sb = StringBuilder::new()
    let mut done = false
    while not(done) {
      let chunk = read_n(65536)
      if String::length(chunk) == 0 {
        done = true
      } else {
        StringBuilder::push(sb, chunk)
      }
    }
    StringBuilder::freeze(sb)
  }
}

export fn write_char(code: Int) -> Unit with Stdout {
  Stdout::write_char(code)
}

/// #865: Stderr counterparts of print/println/write_char above, so error
/// messages can go to fd 2 instead of stdout (the gap that forced
/// scripts/cache_clean.vibex and scripts/wasmtime_bin.vibex's error paths to
/// print to stdout).
export fn eprint(s: String) -> Unit with Stderr {
  Stderr::write_stream(s)
}

export fn eprintln(s: String) -> Unit with Stderr {
  {
    Stderr::write_stream(s)
    Stderr::write_char(10)
  }
}

export fn ewrite_char(code: Int) -> Unit with Stderr {
  Stderr::write_char(code)
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): the old index.vibe facade defined these as plain
/// `export let io_read = read` VALUE aliases (real importable bindings, not
/// re-exports) directly in the facade file itself. A `.vpkg` facade is
/// synthesized purely from declared contract names resolved to an
/// EXPORTED DEF in a sibling impl file (contract/index.vibe's
/// `contract_facade_source`/`collect_impl_fn_defs`, which only recognizes an
/// `SLet` whose value is an `EFn` — a bare name-to-name alias has no fn body
/// to match), so an unannotated value alias can no longer live in the facade
/// itself. Re-expressed here as real thin wrapper functions with the exact
/// same names/signatures/effects as the aliased functions above — callers
/// that only ever used the `io_*` names (see index_import_test.vibe) see no
/// behavior change.
export fn io_read(max_bytes: Int) -> String with Stdin {
  read(max_bytes)
}

export fn io_read_all() -> String with Stdin {
  read_all()
}

export fn io_read_n(n: Int) -> String with Stdin {
  read_n(n)
}

export fn io_print(s: String) -> Unit with Stdout {
  print(s)
}

export fn io_println(s: String) -> Unit with Stdout {
  println(s)
}

export fn io_read_char() -> Int with Stdin {
  read_char()
}

export fn io_read_line() -> String with Stdin {
  read_line()
}

export fn io_write_char(code: Int) -> Unit with Stdout {
  write_char(code)
}

export fn io_eprint(s: String) -> Unit with Stderr {
  eprint(s)
}

export fn io_eprintln(s: String) -> Unit with Stderr {
  eprintln(s)
}

export fn io_ewrite_char(code: Int) -> Unit with Stderr {
  ewrite_char(code)
}
