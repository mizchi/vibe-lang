//# Imports

import ./io.vibe {
  print, println, read, read_char, read_line, write_char
}

//# Functions

fn greet(name: String) -> Unit with Stdout {
  {
    print("Hello, ")
    println(name)
  }
}

fn echo_line() -> Unit with Stdin + Stdout {
  {
    let line = read_line()
    println(line)
  }
}

fn write_abc() -> Unit with Stdout {
  {
    write_char(65)
    write_char(66)
    write_char(67)
    write_char(10)
  }
}

//# Misc

test "greet writes to stdout" {
  greet("vibe")
  assert(true)
}

test "write_abc writes A B C" {
  write_abc()
  assert(true)
}

test "echo_line reads and writes" {
  echo_line()
  assert(true)
}

test "read returns empty for zero bytes" {
  let result = read(0)
  assert(result == "")
}

test "read_char returns eof in test" {
  let c = read_char()
  assert(c < 0)
}
