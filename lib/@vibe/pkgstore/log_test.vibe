//# Imports

import @vibe/builtin {
  String::join, String::replace
}
import ./log.vibe {
  LogAbsent,
  LogHead,
  LogPublished,
  log_check_extends,
  log_check_served,
  log_format_head,
  log_has_publish,
  log_inclusion_proof,
  log_is_yanked,
  log_leaf_hash,
  log_leaves,
  log_lookup,
  log_parse_head,
  log_record,
  log_record_lines,
  log_root,
  log_seen_file_name,
  log_verify_inclusion
}

//# Fixture

// Five records and the roots / proofs below were produced by the shell
// implementation's own functions (its merkle_* functions before
// #3673), so these tests pin byte compatibility with log files it wrote.

fn fixture_records() -> Array[String] {
  [
    log_record(0, "publish", "@a/x@1.0.0", "pkg:b3:aa", "ct:b3:11", "local", "-"),
    log_record(1, "publish", "@a/x@1.1.0", "pkg:b3:bb", "ct:b3:22", "local", "-"),
    log_record(2, "yank", "@a/x@1.1.0", "pkg:b3:bb", "-", "-", "-"),
    log_record(3, "publish", "@a/y@0.1.0", "pkg:b3:cc", "ct:b3:33", "github:o/r@abc", "0123"),
    log_record(4, "publish", "@a/x@1.2.0", "pkg:b3:dd", "ct:b3:44", "local", "-")
  ]
}

fn fixture_body() -> String {
  String::concat(String::join(fixture_records(), "\n"), "\n")
}

fn root_of_first(n: Int) -> String {
  log_root(log_leaves(fixture_records(), n))
}

fn proof_text(index: Int) -> String {
  let proof = log_inclusion_proof(log_leaves(fixture_records(), 5), index)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(proof) {
    let step = Array::get(proof, i)
    StringBuilder::push(sb, if step.sibling_right {
      "R "
    } else {
      "L "
    })
    StringBuilder::push(sb, step.hash)
    StringBuilder::push(sb, "|")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn error_of(f: () -> Unit with Exception) -> String {
  handle {
    f()
    "ok"
  } with { Exception::Throw(e) => e }
}

//# Hashing

test "leaf hash of the first record" {
  inspect(log_leaf_hash(Array::get(fixture_records(), 0)), content = "813c5cc4ca882fdb95f315179daf1149368dfaa795c571450bd4f4150a7373a4")
}

test "roots of every prefix match the shell" {
  inspect(root_of_first(0), content = "2e1cfa82b035c26cbbbdae632cea070514eb8b773f616aaeaf668e2f0be8f10d")
  inspect(root_of_first(1), content = "813c5cc4ca882fdb95f315179daf1149368dfaa795c571450bd4f4150a7373a4")
  inspect(root_of_first(2), content = "2e552fadb2338fb875e856e302a4df51a2f36bcb9a7b3fbdaf256574111117fc")
  inspect(root_of_first(3), content = "2e9bf57d87edda9e6c4352005624907fea29fffd178844ef5b37b27a0b7d482b")
  inspect(root_of_first(4), content = "4dfceca2ab06b2512c5c688777389f96315669263884ccf3647fad0299bd490b")
  inspect(root_of_first(5), content = "9655a06430fb65ed252cdfb85bc69d3be4d08c365589accd5dd3fa49b7680ab5")
}

test "inclusion proofs match the shell for every leaf of five" {
  inspect(proof_text(0), content = "R df040d67961ff973ecbd498ff83258dd44624b0f7735fa4005fe7feba684a3f1|R dcd45b69fbedb729a71c5930c91476bff349081c0d033fb022e8a4b9f5d9ee2a|R 88f282c564a6d367330ba36efcaa5a1d9f348c9624389808070f5bfeb132dc77|")
  inspect(proof_text(1), content = "L 813c5cc4ca882fdb95f315179daf1149368dfaa795c571450bd4f4150a7373a4|R dcd45b69fbedb729a71c5930c91476bff349081c0d033fb022e8a4b9f5d9ee2a|R 88f282c564a6d367330ba36efcaa5a1d9f348c9624389808070f5bfeb132dc77|")
  inspect(proof_text(2), content = "R fe6d9789d61570fc1ce7258966148f0f846819020ed9caf9be4d647127e75947|L 2e552fadb2338fb875e856e302a4df51a2f36bcb9a7b3fbdaf256574111117fc|R 88f282c564a6d367330ba36efcaa5a1d9f348c9624389808070f5bfeb132dc77|")
  inspect(proof_text(3), content = "L 3c2b94fcf5e5cbb4989c9887a0d188039fa11df94af5898650c1485c57da872b|L 2e552fadb2338fb875e856e302a4df51a2f36bcb9a7b3fbdaf256574111117fc|R 88f282c564a6d367330ba36efcaa5a1d9f348c9624389808070f5bfeb132dc77|")
  inspect(proof_text(4), content = "L 4dfceca2ab06b2512c5c688777389f96315669263884ccf3647fad0299bd490b|")
}

test "every proof verifies, and a proof for another leaf does not" {
  let leaves = log_leaves(fixture_records(), 5)
  let root = log_root(leaves)
  let mut i = 0
  while i < 5 {
    assert(log_verify_inclusion(Array::get(leaves, i), root, log_inclusion_proof(leaves, i)))
    i = i + 1
  }
  assert(!log_verify_inclusion(Array::get(leaves, 0), root, log_inclusion_proof(leaves, 1)))
  assert(!log_verify_inclusion(Array::get(leaves, 2), root_of_first(4), log_inclusion_proof(leaves, 2)))
}

//# Files

test "record lines split newline-terminated records" {
  inspect(Array::length(log_record_lines(fixture_body())), content = "5")
  inspect(Array::length(log_record_lines("")), content = "0")
}

test "head round-trips" {
  let head = log_parse_head(log_format_head(5, "abc"))
  inspect(head.size, content = "5")
  inspect(head.root, content = "abc")
  inspect(error_of(() -> {
    let _ = log_parse_head("5 abc")
  }), content = "malformed log head: expected `<size>\\t<root>`, got `5 abc`")
}

test "seen-head file name matches the shell's" {
  inspect(log_seen_file_name("/tmp/reg/log"), content = "log-head.seen.b1bfb039c936")
}

//# Checks

test "a served log that is consistent passes" {
  inspect(error_of(() -> log_check_served(None, None)), content = "ok")
  inspect(error_of(() -> log_check_served(Some(fixture_body()), Some(log_format_head(5, root_of_first(5))))), content = "ok")
}

test "tampered served logs are refused" {
  inspect(error_of(() -> log_check_served(Some(fixture_body()), None)), content = "tampered log head: records.tsv exists but head is missing")
  inspect(error_of(() -> log_check_served(None, Some("0\tx\n"))), content = "tampered log head: head exists but records.tsv is missing")
  inspect(error_of(() -> log_check_served(Some(fixture_body()), Some(log_format_head(4, root_of_first(5))))), content = "tampered log head: head claims 4 record(s), records.tsv has 5")
  inspect(error_of(() -> log_check_served(Some(String::replace(fixture_body(), "pkg:b3:cc", "pkg:b3:ee")), Some(log_format_head(5, root_of_first(5))))), content = "tampered log head: head root 9655a06430fb65ed252cdfb85bc69d3be4d08c365589accd5dd3fa49b7680ab5 does not match recomputed b8ef25517018eac1174f9f5fe85e4404ab09478add7a1b71ab972f507b87aa1b")
}

test "a head may only extend the one this client saw" {
  let head = LogHead::{ size: 5, root: root_of_first(5) }
  inspect(error_of(() -> log_check_extends(fixture_body(), head, None)), content = "ok")
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(LogHead::{
    size: 3,
    root: root_of_first(3)
  }))), content = "ok")
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(LogHead::{
    size: 0,
    root: root_of_first(0)
  }))), content = "ok")
  inspect(error_of(() -> log_check_extends(fixture_body(), LogHead::{
    size: 2,
    root: root_of_first(2)
  }, Some(LogHead::{ size: 3, root: root_of_first(3) }))), content = "log consistency violation: head regressed to 2 record(s), this client already saw 3 (append-only log was truncated/rewritten)")
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(LogHead::{
    size: 3,
    root: root_of_first(2)
  }))), content = "log consistency violation: the first 3 record(s) no longer hash to the head this client saw (append-only history was rewritten)")
}

test "lookup takes the last publish and a yank after it" {
  let recs = fixture_records()
  inspect(match log_lookup(recs, "@a/x@1.0.0") {
    LogAbsent => "absent",
    LogPublished(i, h, y) => "\{Int::to_string(i)} \{h} \{if y {
      "yanked"
    } else {
      "live"
    }}"
  }, content = "0 pkg:b3:aa live")
  inspect(match log_lookup(recs, "@a/x@1.1.0") {
    LogAbsent => "absent",
    LogPublished(i, h, y) => "\{Int::to_string(i)} \{h} \{if y {
      "yanked"
    } else {
      "live"
    }}"
  }, content = "1 pkg:b3:bb yanked")
  inspect(match log_lookup(recs, "@a/z@1.0.0") {
    LogAbsent => "absent",
    LogPublished(_, _, _) => "published"
  }, content = "absent")
}

test "a re-publish after a yank is live again" {
  let recs = fixture_records()
  Array::push(recs, log_record(5, "publish", "@a/x@1.1.0", "pkg:b3:bb", "ct:b3:22", "local", "-"))
  inspect(match log_lookup(recs, "@a/x@1.1.0") {
    LogAbsent => "absent",
    LogPublished(i, _, y) => "\{Int::to_string(i)} \{if y {
      "yanked"
    } else {
      "live"
    }}"
  }, content = "5 live")
  assert(!log_is_yanked(recs, "@a/x@1.1.0"))
}

test "has_publish and is_yanked" {
  let recs = fixture_records()
  assert(log_has_publish(recs, "@a/y@0.1.0"))
  assert(!log_has_publish(recs, "@a/y@0.2.0"))
  assert(log_is_yanked(recs, "@a/x@1.1.0"))
  assert(!log_is_yanked(recs, "@a/x@1.0.0"))
}

//# Edges found by `vibe mutate`

test "a leaf limit above the record count takes every record" {
  inspect(Array::length(log_leaves(fixture_records(), 10)), content = "5")
  inspect(log_root(log_leaves(fixture_records(), 10)), content = "9655a06430fb65ed252cdfb85bc69d3be4d08c365589accd5dd3fa49b7680ab5")
}

test "a head line that starts with its tab has no size" {
  inspect(error_of(() -> {
    let _ = log_parse_head("\tabc")
  }), content = "malformed log head: size is not a number in `\tabc`")
}

test "a records file that ends inside a record is refused" {
  let body = String::join(fixture_records(), "\n")
  inspect(error_of(() -> log_check_served(Some(body), Some(log_format_head(5, root_of_first(5))))), content = "tampered log head: records.tsv ends inside a record (no final newline)")
  // A head whose size matches the newline count but whose root commits to
  // the unterminated record as well (Codex review of #3678).
  let one = Array::get(fixture_records(), 0)
  inspect(error_of(() -> log_check_served(Some(one), Some(log_format_head(0, root_of_first(1))))), content = "tampered log head: records.tsv ends inside a record (no final newline)")
  inspect(error_of(() -> log_check_served(Some(one), Some(log_format_head(0, root_of_first(0))))), content = "tampered log head: records.tsv ends inside a record (no final newline)")
}

test "an unterminated last line is not a record" {
  inspect(Array::length(log_record_lines("a\nb")), content = "1")
  inspect(Array::length(log_record_lines("a\nb\n")), content = "2")
}

test "a head equal to the seen one is consistent" {
  let head = LogHead::{ size: 5, root: root_of_first(5) }
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(head))), content = "ok")
}

test "a seen head of size 0 carries no prefix to check, and size 1 does" {
  let head = LogHead::{ size: 5, root: root_of_first(5) }
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(LogHead::{
    size: 0,
    root: "anything"
  }))), content = "ok")
  inspect(error_of(() -> log_check_extends(fixture_body(), head, Some(LogHead::{
    size: 1,
    root: "wrong"
  }))), content = "log consistency violation: the first 1 record(s) no longer hash to the head this client saw (append-only history was rewritten)")
}

test "short and unknown records do not count as publish or yank" {
  let recs = [
    "garbage",
    log_record(0, "publish", "@a/x@1.0.0", "pkg:b3:aa", "ct", "local", "-"),
    log_record(1, "note", "@a/x@1.0.0", "-", "-", "-", "-")
  ]
  inspect(match log_lookup(recs, "@a/x@1.0.0") {
    LogAbsent => "absent",
    LogPublished(i, _, y) => "\{Int::to_string(i)} \{if y {
      "yanked"
    } else {
      "live"
    }}"
  }, content = "1 live")
  assert(!log_is_yanked(recs, "garbage"))
}

test "a yank as the first record is seen" {
  let recs = [log_record(0, "yank", "@a/x@1.0.0", "pkg:b3:aa", "-", "-", "-")]
  assert(log_is_yanked(recs, "@a/x@1.0.0"))
}
