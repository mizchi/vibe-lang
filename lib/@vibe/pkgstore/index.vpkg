name = @vibe/pkgstore
version = 0.0.1
description =
  #|@vibe/pkgstore — the local package store behind `vibe pkg` (#3673).
deps = {
  @vibe/core : 0.2.0
}

generated_hash =

// @vibe/pkgstore — the local package store behind `vibe pkg` (#754, #755,
// #805, ADR-0065 / ADR-0093): the registry transparency log, package
// identities and the fetch CAS, the version / provenance index, and source
// specs. Every function reads or produces file CONTENTS and paths; the
// command layer does the IO. Manifest headers are not parsed here: the
// compiler's own header scanner is the authority for those. The types are
// bodyless declarations re-exporting the impl's transparent definitions,
// the @vibe/semver shape, because the impl constructs them itself.

// --- transparency log (log.vibe)
type LogProofStep
type LogHead
type LogLookup

fn log_leaf_hash(record: String) -> String
fn log_node_hash(left: String, right: String) -> String
fn log_root(leaves: Array[String]) -> String
fn log_leaves(records: Array[String], limit: Int) -> Array[String]
fn log_inclusion_proof(leaves: Array[String], index: Int) -> Array[LogProofStep]
fn log_verify_inclusion(leaf: String, root: String, proof: Array[LogProofStep]) -> Bool
fn log_record_lines(text: String) -> Array[String]
fn log_record(ordinal: Int, op: String, key: String, hash: String, contract_hash: String, source: String, commit: String) -> String
fn log_format_head(size: Int, root: String) -> String
fn log_parse_head(text: String) -> LogHead with Exception
fn log_check_served(records: Option[String], head: Option[String]) -> Unit with Exception
fn log_check_extends(records: String, head: LogHead, seen: Option[LogHead]) -> Unit with Exception
fn log_lookup(records: Array[String], key: String) -> LogLookup
fn log_has_publish(records: Array[String], key: String) -> Bool
fn log_is_yanked(records: Array[String], key: String) -> Bool
fn log_seen_file_name(log_dir: String) -> String

// --- identities, CAS, version and provenance index (store.vibe)
type PkgId

fn parse_pkg_id(text: String) -> Option[PkgId]
fn PkgId::to_string(id: PkgId) -> String
fn cas_dir(cache_dir: String, id: PkgId) -> String
fn is_package_file(name: String) -> Bool
fn versions_lookup(versions: String, key: String) -> String
fn versions_of(versions: String, name: String) -> Array[(String, String)]
fn latest_version_of(versions: String, name: String) -> String
fn versions_row(key: String, id: String) -> String
fn provenance_line(key: String, id: String, spec: String, commit: String) -> String
fn provenance_has(provenance: String, line: String) -> Bool

// --- source specs (spec.vibe)
type SourceSpec

fn parse_source_spec(spec: String) -> SourceSpec with Exception
fn SourceSpec::pinned(s: SourceSpec, commit: String) -> String
