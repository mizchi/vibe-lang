//# Functions

export fn abs(_ n: Int) -> Int {
  if n < 0 {
    0 - n
  } else {
    n
  }
}

export fn gcd(a: Int, b: Int) -> Int {
  let mut x = abs(a)
  let mut y = abs(b)
  while y > 0 {
    let t = y
    y = x - (x / y) * y
    x = t
  }
  x
}

export fn lcm(a: Int, b: Int) -> Int {
  let g = gcd(a = a, b = b)
  if g == 0 {
    0
  } else {
    abs(a) / g * abs(b)
  }
}

export fn max(a: Int, b: Int) -> Int {
  if a >= b {
    a
  } else {
    b
  }
}

export fn min(a: Int, b: Int) -> Int {
  if a <= b {
    a
  } else {
    b
  }
}

export fn pow(base: Int, exp: Int) -> Int {
  if exp < 0 {
    0
  }
  else {
    let mut result = 1
    let mut b = base
    let mut e = exp
    while e > 0 {
      if (e&1) == 1 {
        result = result * b
      }
      b = b * b
      e = e>>1
    }
    result
  }
}

export fn comb(n: Int, k: Int) -> Int {
  if k < 0 || k > n {
    0
  } else {
    let mut kk = k
    if kk > n - kk {
      kk = n - kk
    }
    let mut result = 1
    let mut i = 0
    while i < kk {
      result = result * (n - i) / (i + 1)
      i = i + 1
    }
    result
  }
}

export fn log2(_ n: Int) -> Int {
  let mut v = n
  let mut r = 0
  while v > 1 {
    v = v>>1
    r = r + 1
  }
  r
}

export fn perm(n: Int, k: Int) -> Int {
  if k < 0 || k > n {
    0
  } else {
    let mut result = 1
    let mut i = 0
    while i < k {
      result = result * (n - i)
      i = i + 1
    }
    result
  }
}

export fn sign(_ n: Int) -> Int {
  if n > 0 {
    1
  } else if n < 0 {
    -1
  } else {
    0
  }
}

export fn clamp(n: Int, lo: Int, hi: Int) -> Int {
  if n < lo {
    lo
  } else if n > hi {
    hi
  } else {
    n
  }
}

export fn divmod(a: Int, d: Int) -> (Int, Int) {
  let q = a / d
  let r = a - (q * d)
  (q, r)
}

export fn is_odd(_ n: Int) -> Bool {
  (n&1) == 1
}

export fn is_even(_ n: Int) -> Bool {
  (n&1) == 0
}

export fn product(_ arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut total = 1
  let mut i = 0
  while i < len {
    total = total * Array::get(arr, at = i)
    i = i + 1
  }
  total
}

export fn sqrt_int(_ n: Int) -> Int {
  if n <= 0 {
    0
  } else {
    let mut x = n
    let mut y = (x + 1) / 2
    while y < x {
      x = y
      y = (x + n / x) / 2
    }
    x
  }
}

export fn max_array(_ arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut m = Array::get(arr, at = 0)
  let mut i = 1
  while i < len {
    let v = Array::get(arr, at = i)
    if v > m {
      m = v
    }
    i = i + 1
  }
  m
}

export fn min_array(_ arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut m = Array::get(arr, at = 0)
  let mut i = 1
  while i < len {
    let v = Array::get(arr, at = i)
    if v < m {
      m = v
    }
    i = i + 1
  }
  m
}

export fn is_power_of_two(_ n: Int) -> Bool {
  n > 0 && (n&(n - 1)) == 0
}
