name = @vibe/core
version = 0.2.0
description =
  #|@vibe/core — vibe standard core library (ADR-0063 contract package).
deps = {}

generated_hash =

// @vibe/core — vibe standard core library (ADR-0063 contract package).
// Modeled on moonbitlang/core's per-domain organization. The top level of
// this contract IS the public API: transparent type definitions + fn
// declarations, implemented by the sibling .vibe files. Consumed in-repo
// via a bare directory import (`import ../lib/@vibe/core { ... }`) and
// externally via the content-addressed store (`require @vibe/core ...` +
// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).
//
// v1 contents: sha1, leb128, list, set, hex, maps. map.vibe's `[K: Hash]`
// generic-key family is now declared below (#897/#912): trait-bounded
// bodyless fn declarations parse and fingerprint through the same
// parse_fn_signature/fn_sig_text path as unbounded ones (verified
// empirically — the ".vibei grammar cannot express a trait" note that
// used to live here was stale). `Hash` itself is declared `opaque type
// Hash` — a trait has no SStruct/SEnum implementation for conformance to
// find, but maps.vibe's `export ./r#map.vibe { ..., trait Hash }`
// re-export discharges the declaration at face value (#847's re-export
// trust), and the trait rides the merged program globally, so consumers
// can `import @vibe/core { Hash }` and `impl Hash for TheirType`.
//
// map.vibe's `is_empty` (Map[String, V]) stays UNDECLARED: it collides
// with StringSet's same-named declaration below, and the facade can only
// allocate a declared name to one definer. The exported-but-undeclared
// conformance sweep matches by NAME, so the export is legal — it remains
// reachable only from files inside this package (map_test.vibe imports the
// impl file directly). map.vibe's `length` and math_extra.vibe's `sum`
// used to sit in the same bucket, but #1843 removed the bare List
// spellings they collided with, so both are declared normally now.
//
// v2 (#766): base64, math (+ math_double), diff, uuid folded in from
// @vibex (pure algorithms, zero prior consumers).
//
// v3 (#841): bigint (arbitrary-precision signed integers) and rational
// (arbitrary-precision rationals, built directly on bigint — both now
// live in this same package so rational's `import ./bigint.vibe` needs no
// cross-package directory import). Both promoted straight from @vibex with
// no @vibex stop (moved in during #841's data-structure sweep).
//
// v4: MutMap/MutSet (open-addressing) and MutSortedMap/MutSortedSet (AVL),
// promoted from @vibex/collections (no prior consumers, same no-@vibex-stop
// promotion as v3). Key hashing/equality/ordering is explicit-dict style
// (functions passed as arguments) — see key.vibe's hash_int/eq_int/
// compare_int/hash_string/eq_string/compare_string. keys/values/to_array
// order is unspecified for MutMap/MutSet, ascending for MutSortedMap/
// MutSortedSet; MutSortedMap::range/MutSortedSet::range are inclusive on both ends.

// ADR-0088 decision 3 (#1345): the outcome of an OPTIONAL capability
// operation, returned by `perform?`. An ordinary closed enum -- the compiler
// only knows that `perform?` produces one. Constructors are `NotGranted`,
// `Errored(E)`, `Granted(T)`; the ADR spells the last two `Failed`/`Ok`, both
// of which are already taken by @vibe/concurrent's TaskError and
// @vibe/wit_runtime's Result (see attempt.vibe for the measurement).
type Attempt[T, E]
fn Attempt::unwrap_or[T, E](a: Attempt[T, E], fallback: T) -> T
fn Attempt::is_granted[T, E](a: Attempt[T, E]) -> Bool
fn Attempt::is_not_granted[T, E](a: Attempt[T, E]) -> Bool
fn Attempt::to_option[T, E](a: Attempt[T, E]) -> Option[T]

type List[T]
type StringSet
type Set[T]
type BigInt
type Rational
type MutMap[K, V]
type MutSet[T]
type MutSortedMap[K, V]
type MutSortedSet[T]

// --- map (the [K: Hash] generic-key family; see header comment)
opaque type Hash

// --- default (#1847): method-bearing `trait Default { default() -> Self }`,
// declared and discharged exactly like Hash above (`defaults.vibe`'s
// `export ./default.vibe { trait Default }` re-export). Primitive impls
// (Int/Float/Double/Bool/String) live in default.vibe; `derive(Default)`
// registers the impl for user structs/enums.
opaque type Default

fn map_key_to_string[K: Hash](key: K) -> String
fn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V]
