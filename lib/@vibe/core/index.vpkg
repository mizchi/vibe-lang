fn SortedSet::new_string() -> MutSortedSet[String]
fn SortedSet::add[T](s: MutSortedSet[T], x: T) -> Unit
fn SortedSet::has[T](s: MutSortedSet[T], x: T) -> Bool
fn SortedSet::delete[T](s: MutSortedSet[T], x: T) -> Bool
fn SortedSet::size[T](s: MutSortedSet[T]) -> Int
fn SortedSet::min[T](s: MutSortedSet[T]) -> Option[T]
fn SortedSet::max[T](s: MutSortedSet[T]) -> Option[T]
fn SortedSet::to_array[T](s: MutSortedSet[T]) -> Array[T]
fn SortedSet::range[T](s: MutSortedSet[T], lo: T, hi: T) -> Array[T]
fn SortedSet::union[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T]
fn SortedSet::intersect[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T]
fn SortedSet::difference[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T]

// --- pqueue (#1842, promoted from @vibex/pqueue). Binary min-heap with an
// explicit comparator closure: `cmp(a, b) < 0` dequeues first, so a
// numeric-ascending comparator is a MIN-heap (`new_int_min`); `new_int_max`
// flips it. Equal keys have no order among themselves (not stable).
// push/pop O(log n), peek O(1), from_array O(n) (Floyd heapify,
// non-destructive), to_sorted_array O(n log n) (non-destructive).
type PriorityQueue[T]

fn PriorityQueue::new[T](cmp: (T, T) -> Int) -> PriorityQueue[T]
fn PriorityQueue::new_int_min() -> PriorityQueue[Int]
fn PriorityQueue::new_int_max() -> PriorityQueue[Int]
fn PriorityQueue::push[T](q: PriorityQueue[T], x: T) -> Unit
fn PriorityQueue::pop[T](q: PriorityQueue[T]) -> Option[T]
fn PriorityQueue::peek[T](q: PriorityQueue[T]) -> Option[T]
fn PriorityQueue::length[T](q: PriorityQueue[T]) -> Int
fn PriorityQueue::is_empty[T](q: PriorityQueue[T]) -> Bool
fn PriorityQueue::from_array[T](arr: Array[T], cmp: (T, T) -> Int) -> PriorityQueue[T]
fn PriorityQueue::to_sorted_array[T](q: PriorityQueue[T]) -> Array[T]
fn PriorityQueue::clear[T](q: PriorityQueue[T]) -> Unit
fn int_cmp_asc(a: Int, b: Int) -> Int
fn int_cmp_desc(a: Int, b: Int) -> Int

// --- deque (#1842, promoted from @vibex/deque). Double-ended queue on a
// growable ring buffer (head/len + doubling): O(1) at both ends. The
// backing buffer stays empty until the first push (no default value exists
// for an arbitrary T — #1847); `with_capacity(n)` is a hint the first push
// consumes. Popped slots keep their old element until overwritten.
type Deque[T]

fn Deque::new[T]() -> Deque[T]
fn Deque::with_capacity[T](n: Int) -> Deque[T]
fn Deque::push_back[T](d: Deque[T], x: T) -> Unit
fn Deque::push_front[T](d: Deque[T], x: T) -> Unit
fn Deque::pop_back[T](d: Deque[T]) -> Option[T]
fn Deque::pop_front[T](d: Deque[T]) -> Option[T]
fn Deque::front[T](d: Deque[T]) -> Option[T]
fn Deque::back[T](d: Deque[T]) -> Option[T]
fn Deque::get[T](d: Deque[T], i: Int) -> Option[T]
fn Deque::length[T](d: Deque[T]) -> Int
fn Deque::is_empty[T](d: Deque[T]) -> Bool
fn Deque::to_array[T](d: Deque[T]) -> Array[T]
fn Deque::clear[T](d: Deque[T]) -> Unit
