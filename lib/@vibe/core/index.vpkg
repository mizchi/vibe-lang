version 0.1.0

// @vibe/core — vibe standard core library (ADR-0063 contract package).
// Modeled on moonbitlang/core's per-domain organization. The top level of
// this contract IS the public API: transparent type definitions + fn
// declarations, implemented by the sibling .vibe files. Consumed in-repo
// via a bare directory import (`import ../lib/@vibe/core { ... }`) and
// externally via the content-addressed store (`require @vibe/core ...` +
// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).
//
// v1 contents: sha1, leb128, list, set, hex, maps. map.vibe's `[K: Hash]`
// generic-key family is now declared below (#897/#912): trait-bounded
// bodyless fn declarations parse and fingerprint through the same
// parse_fn_signature/fn_sig_text path as unbounded ones (verified
// empirically — the ".vibei grammar cannot express a trait" note that
// used to live here was stale). `Hash` itself is declared `opaque type
// Hash` — a trait has no SStruct/SEnum implementation for conformance to
// find, but maps.vibe's `export ./r#map.vibe { ..., trait Hash }`
// re-export discharges the declaration at face value (#847's re-export
// trust), and the trait rides the merged program globally, so consumers
// can `import @vibe/core { Hash }` and `impl Hash for TheirType`.
//
// map.vibe's `length`/`is_empty` (Map[String, V]) and math_extra.vibe's
// `sum` (Array[Int]) stay UNDECLARED: each collides with a same-named
// declaration for a different type below (List's length/sum, StringSet's
// is_empty), and the facade can only allocate a declared name to one
// definer. The exported-but-undeclared conformance sweep matches by NAME,
// so these exports are legal — they remain reachable only from files
// inside this package (map_test.vibe / math_prop_test.vibe import the
// impl files directly), exactly the pre-.vpkg status quo.
//
// v2 (#766): base64, math (+ math_double), diff, uuid folded in from
// @vibex (pure algorithms, zero prior consumers).
//
// v3 (#841): bigint (arbitrary-precision signed integers) and rational
// (arbitrary-precision rationals, built directly on bigint — both now
// live in this same package so rational's `import ./bigint.vibe` needs no
// cross-package directory import). Both promoted straight from @vibex with
// no @vibex stop (moved in during #841's data-structure sweep).

import ./sha1.vibe {}
import ./leb128.vibe {}
import ./list.vibe {}
import ./set.vibe {}
import ./hex.vibe {}
import ./map_get.vibe {}
import ./map.vibe {}
import ./maps.vibe {}
import ./math_extra.vibe {}
import ./base64.vibe {}
import ./diff.vibe {}
import ./uuid.vibe {}
import ./math.vibe {}
import ./math_double.vibe {}
import ./bigint.vibe {}
import ./rational.vibe {}

type List[T]
type StringSet
type BigInt
type Rational

// --- map (the [K: Hash] generic-key family; see header comment)
opaque type Hash

fn map_key_to_string[K: Hash](key: K) -> String
fn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V]
fn has_by[K: Hash, V](m: Map[String, V], key: K) -> Bool
fn get_or_by[K: Hash, V](m: Map[String, V], key: K, default: V) -> V
fn get_or_else_by[K: Hash, V](m: Map[String, V], key: K, default: () -> V) -> V

// --- sha1
fn sha1(msg: String) -> String

// --- hex
fn hex_encode(s: String) -> String
fn hex_decode(hex: String) -> String with { Error }

// --- leb128
fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int)
fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int)
fn sleb128_size(n: Int) -> Int
fn uleb128_size(n: Int) -> Int
fn write_sleb128(buf: Bytes, n: Int) -> Unit
fn write_uleb128(buf: Bytes, n: Int) -> Unit
fn encode_sleb128(n: Int) -> Bytes
fn encode_uleb128(n: Int) -> Bytes

// --- list
fn list_nth[T](xs: List[T], n: Int) -> Option[T]
fn nth[T](xs: List[T], n: Int) -> Option[T]
fn list_of3[T](a: T, b: T, c: T) -> List[T]
fn of3[T](a: T, b: T, c: T) -> List[T]
fn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]
fn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]
fn list_cons[T](x: T, xs: List[T]) -> List[T]
fn list_drop[T](n: Int, xs: List[T]) -> List[T]
fn drop[T](xs: List[T], n: Int) -> List[T]
fn list_fold[A, B](f: (B, A) -> B, init: B, xs: List[A]) -> B
fn list_sum(xs: List[Int]) -> Int
fn sum(xs: List[Int]) -> Int
fn list_head[T](xs: List[T]) -> Option[T]
fn head[T](xs: List[T]) -> Option[T]
fn list_iter[T, R](f: (T) -> R, xs: List[T]) -> Int
fn iter[T, R](xs: List[T], f: (T) -> R) -> Int
fn list_tail[T](xs: List[T]) -> List[T]
fn tail[T](xs: List[T]) -> List[T]
fn list_empty[T]() -> List[T]
fn list_length[T](xs: List[T]) -> Int
fn length[T](xs: List[T]) -> Int
fn iter_length[T](xs: List[T]) -> Int
fn list_reverse[T](xs: List[T]) -> List[T]
fn reverse[T](xs: List[T]) -> List[T]
fn list_map[A, B](f: (A) -> B, xs: List[A]) -> List[B]
fn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn list_take[T](n: Int, xs: List[T]) -> List[T]
fn take[T](xs: List[T], n: Int) -> List[T]
fn list_append[T](xs: List[T], ys: List[T]) -> List[T]
fn append[T](xs: List[T], ys: List[T]) -> List[T]
fn list_filter[T](pred: (T) -> Bool, xs: List[T]) -> List[T]
fn filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]
fn list_flatmap[A, B](f: (A) -> List[B], xs: List[A]) -> List[B]
fn flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]
fn list_is_empty[T](xs: List[T]) -> Bool
fn list_iter_get[T](xs: List[T], index: Int) -> T
fn iter_get[T](xs: List[T], index: Int) -> T
fn list_singleton[T](x: T) -> List[T]
fn singleton[T](x: T) -> List[T]
fn list_contains_by[T](eq: (T, T) -> Bool, value: T, xs: List[T]) -> Bool
fn List::nth[T](xs: List[T], n: Int) -> Option[T]
fn List::sum(xs: List[Int]) -> Int
fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn List::drop[T](xs: List[T], n: Int) -> List[T]
fn List::head[T](xs: List[T]) -> Option[T]
fn List::iter[T, R](xs: List[T], f: (T) -> R) -> Int
fn List::tail[T](xs: List[T]) -> List[T]
fn List::take[T](xs: List[T], n: Int) -> List[T]
fn List::append[T](xs: List[T], ys: List[T]) -> List[T]
fn List::filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]
fn List::length[T](xs: List[T]) -> Int
fn List::flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]
fn List::reverse[T](xs: List[T]) -> List[T]
fn List::is_empty[T](xs: List[T]) -> Bool
fn List::iter_get[T](xs: List[T], index: Int) -> T
fn List::contains_by[T](xs: List[T], eq: (T, T) -> Bool, value: T) -> Bool
fn List::iter_length[T](xs: List[T]) -> Int

// --- set
fn size(s: StringSet) -> Int
fn empty() -> StringSet
fn remove(s: StringSet, value: String) -> StringSet
fn contains(s: StringSet, value: String) -> Bool
fn add(s: StringSet, value: String) -> StringSet
fn is_empty(s: StringSet) -> Bool
fn set_union(a: StringSet, b: StringSet) -> StringSet
fn from_array(values: Array[String]) -> StringSet
fn set_intersect(a: StringSet, b: StringSet) -> StringSet
fn set_difference(a: StringSet, b: StringSet) -> StringSet
fn set_value_to_string[T](value: T) -> String
fn add_by[T](s: StringSet, value: T) -> StringSet
fn remove_by[T](s: StringSet, value: T) -> StringSet
fn contains_by[T](s: StringSet, value: T) -> Bool
fn from_array_by[T](values: Array[T]) -> StringSet

// --- maps (plain Map[String, V] helpers; the `[K: Hash]` generic-key
// variants and the Hash trait itself are not part of this contract yet)
fn get[V](m: Map[String, V], key: String) -> Option[V]
fn get_or[V](m: Map[String, V], key: String, default: V) -> V
fn get_or_else[V](m: Map[String, V], key: String, default: () -> V) -> V
fn has_key[V](m: Map[String, V], key: String) -> Bool
fn keys[V](m: Map[String, V]) -> Array[String]
fn values[V](m: Map[String, V]) -> Array[V]

// --- base64
fn decode(input: String) -> String
fn encode(input: String) -> String
fn encode_url_safe(input: String) -> String

// --- diff
type DiffOp
fn diff_lines(old_text: String, new_text: String) -> Array[DiffOp]
fn format_unified(ops: Array[DiffOp]) -> String
fn has_changes(ops: Array[DiffOp]) -> Bool
fn count_additions(ops: Array[DiffOp]) -> Int
fn count_deletions(ops: Array[DiffOp]) -> Int

// --- uuid
fn v4(seed_state: Int) -> (String, Int)
fn is_valid_v4(s: String) -> Bool

// --- math (Int)
fn abs(n: Int) -> Int
fn gcd(a: Int, b: Int) -> Int
fn lcm(a: Int, b: Int) -> Int
fn max(a: Int, b: Int) -> Int
fn min(a: Int, b: Int) -> Int
fn pow(base: Int, exp: Int) -> Int
fn comb(n: Int, k: Int) -> Int
fn log2(n: Int) -> Int
fn perm(n: Int, k: Int) -> Int
fn sign(n: Int) -> Int
fn clamp(n: Int, lo: Int, hi: Int) -> Int
fn divmod(a: Int, d: Int) -> (Int, Int)
fn is_odd(n: Int) -> Bool
fn is_even(n: Int) -> Bool
fn product(arr: Array[Int]) -> Int
fn sqrt_int(n: Int) -> Int
fn max_array(arr: Array[Int]) -> Int
fn min_array(arr: Array[Int]) -> Int
fn is_power_of_two(n: Int) -> Bool

// --- math (Double)
fn ln(x: Double) -> Double
fn sqrt(x: Double) -> Double
fn hypot(x: Double, y: Double) -> Double
fn log10(x: Double) -> Double
fn degrees(rad: Double) -> Double
fn radians(deg: Double) -> Double
fn atan(x: Double) -> Double
fn asin(x: Double) -> Double
fn acos(x: Double) -> Double
fn atan2(y: Double, x: Double) -> Double
fn exp_double(x: Double) -> Double
fn pow_double(base: Double, exponent: Double) -> Double
fn log2_double(x: Double) -> Double
fn sin(x: Double) -> Double
fn cos(x: Double) -> Double
fn tan(x: Double) -> Double
let pi: Double
let tau: Double
let e_const: Double

// --- bigint (arbitrary-precision signed integers)
fn BigInt::from_int(n: Int) -> BigInt
fn BigInt::to_int(a: BigInt) -> Option[Int]
fn BigInt::parse(s: String) -> Option[BigInt]
fn BigInt::to_string(a: BigInt) -> String
fn BigInt::add(a: BigInt, b: BigInt) -> BigInt
fn BigInt::sub(a: BigInt, b: BigInt) -> BigInt
fn BigInt::mul(a: BigInt, b: BigInt) -> BigInt
fn BigInt::divmod(a: BigInt, b: BigInt) -> Option[(BigInt, BigInt)]
fn BigInt::div(a: BigInt, b: BigInt) -> Option[BigInt]
fn BigInt::mod(a: BigInt, b: BigInt) -> Option[BigInt]
fn BigInt::cmp(a: BigInt, b: BigInt) -> Int
fn BigInt::equals(a: BigInt, b: BigInt) -> Bool
fn BigInt::neg(a: BigInt) -> BigInt
fn BigInt::abs(a: BigInt) -> BigInt
fn BigInt::is_zero(a: BigInt) -> Bool
fn BigInt::pow(base_v: BigInt, exp: Int) -> BigInt

// --- rational (arbitrary-precision rationals, built on bigint)
fn Rational::from_int(n: Int) -> Rational
fn Rational::from_ints(num: Int, den: Int) -> Option[Rational]
fn Rational::from_bigints(num: BigInt, den: BigInt) -> Option[Rational]
fn Rational::parse(s: String) -> Option[Rational]
fn Rational::to_string(a: Rational) -> String
fn Rational::add(a: Rational, b: Rational) -> Rational
fn Rational::sub(a: Rational, b: Rational) -> Rational
fn Rational::mul(a: Rational, b: Rational) -> Rational
fn Rational::div(a: Rational, b: Rational) -> Option[Rational]
fn Rational::cmp(a: Rational, b: Rational) -> Int
fn Rational::equals(a: Rational, b: Rational) -> Bool
fn Rational::neg(a: Rational) -> Rational
fn Rational::abs(a: Rational) -> Rational
fn Rational::is_zero(a: Rational) -> Bool
