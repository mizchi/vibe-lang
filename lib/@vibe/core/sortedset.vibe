// @vibex/collections — MutSortedSet[T]: ordered set on MutSortedMap's AVL tree.
//
// Thin wrapper over MutSortedMap[T, Int] (values are a constant 0); see
// sortedmap.vibe. The struct keeps its own copy of `cmp` so the set-algebra
// operations can build result sets without reading through the nested
// generic struct's fields (#829 caution). to_array / range are ascending;
// range(s, lo, hi) is inclusive on both ends.

//# Imports

import ./key.vibe {
  compare_int, compare_string
}
import ./sortedmap.vibe {
  struct MutSortedMap
}

//# Types

export struct MutSortedSet[T] {
  inner: MutSortedMap[T, Int];
  cmp: (T, T) -> Int
}

//# Constructors

export fn MutSortedSet::new[T](cmp: (T, T) -> Int) -> MutSortedSet[T] {
  let inner: MutSortedMap[T, Int] = MutSortedMap::new(cmp)
  MutSortedSet::{
    inner: inner,
    cmp: cmp
  }
}

/// Specialized constructors (annotation workaround as in hashmap.vibe).
export fn MutSortedSet::new_int() -> MutSortedSet[Int] {
  let s: MutSortedSet[Int] = MutSortedSet::new(compare_int)
  s
}

export fn MutSortedSet::new_string() -> MutSortedSet[String] {
  let s: MutSortedSet[String] = MutSortedSet::new(compare_string)
  s
}

//# Operations

export fn MutSortedSet::add[T](s: MutSortedSet[T], x: T) -> Unit {
  MutSortedMap::set(s.inner, x, 0)
}

export fn MutSortedSet::has[T](s: MutSortedSet[T], x: T) -> Bool {
  MutSortedMap::has(s.inner, x)
}

export fn MutSortedSet::delete[T](s: MutSortedSet[T], x: T) -> Bool {
  MutSortedMap::delete(s.inner, x)
}

export fn MutSortedSet::size[T](s: MutSortedSet[T]) -> Int {
  MutSortedMap::size(s.inner)
}

export fn MutSortedSet::min[T](s: MutSortedSet[T]) -> Option[T] {
  match MutSortedMap::min(s.inner) {
    Some(kv) => {
      let (k, _) = kv
      Some(k)
    },
    None => None
  }
}

export fn MutSortedSet::max[T](s: MutSortedSet[T]) -> Option[T] {
  match MutSortedMap::max(s.inner) {
    Some(kv) => {
      let (k, _) = kv
      Some(k)
    },
    None => None
  }
}

/// Ascending order.
export fn MutSortedSet::to_array[T](s: MutSortedSet[T]) -> Array[T] {
  MutSortedMap::keys(s.inner)
}

/// Ascending; lo <= x <= hi (both ends inclusive).
export fn MutSortedSet::range[T](s: MutSortedSet[T], lo: T, hi: T) -> Array[T] {
  let entries = MutSortedMap::range(s.inner, lo, hi)
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(entries) {
    let (k, _) = Array::get(entries, i)
    ArrayBuilder::push(b, k)
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

//# Set algebra (result sets use the left operand's cmp)

export fn MutSortedSet::union[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  let out = MutSortedSet::new(a.cmp)
  let xs = MutSortedSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    MutSortedSet::add(out, Array::get(xs, i))
    i = i + 1
  }
  let ys = MutSortedSet::to_array(b)
  let mut j = 0
  while j < Array::length(ys) {
    MutSortedSet::add(out, Array::get(ys, j))
    j = j + 1
  }
  out
}

export fn MutSortedSet::intersect[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  let out = MutSortedSet::new(a.cmp)
  let xs = MutSortedSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if MutSortedSet::has(b, x) {
      MutSortedSet::add(out, x)
    }
    i = i + 1
  }
  out
}

export fn MutSortedSet::difference[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  let out = MutSortedSet::new(a.cmp)
  let xs = MutSortedSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if not(MutSortedSet::has(b, x)) {
      MutSortedSet::add(out, x)
    }
    i = i + 1
  }
  out
}

//# Deprecated legacy spellings (ADR-0100 (3) / #1262)
//#
//# ADR-0082 read the `Hash-` / `Sorted-` PREFIX as "this one is mutable",
//# which collided head-on with ADR-0090's `Mut-` prefix and made one word
//# carry two independent axes. ADR-0100 (3) splits them: **mutability is the
//# prefix** (bare = persistent / `Mut` = mutable handle / `Frozen` /
//# `-Builder`) and the implementation/performance story is a suffix or the
//# module it lives in. `SortedSet` therefore became `MutSortedSet`, and `Sorted` went
//# back to naming an ORDERED INTERFACE rather than mutability.
//#
//# Everything below is a transparent alias kept for source compatibility and
//# marked `#deprecated`, so `vibe check` names the replacement at every use
//# without breaking anyone. The type alias being TRANSPARENT is what makes the
//# migration safe to do file by file: an old annotation and a new one are the
//# SAME type, so the two spellings can meet at any boundary.

#deprecated("use MutSortedSet::new")
export fn SortedSet::new[T](cmp: (T, T) -> Int) -> MutSortedSet[T] {
  MutSortedSet::new(cmp)
}

#deprecated("use MutSortedSet::new_int")
export fn SortedSet::new_int() -> MutSortedSet[Int] {
  MutSortedSet::new_int()
}

#deprecated("use MutSortedSet::new_string")
export fn SortedSet::new_string() -> MutSortedSet[String] {
  MutSortedSet::new_string()
}

#deprecated("use MutSortedSet::add")
export fn SortedSet::add[T](s: MutSortedSet[T], x: T) -> Unit {
  MutSortedSet::add(s, x)
}

#deprecated("use MutSortedSet::has")
export fn SortedSet::has[T](s: MutSortedSet[T], x: T) -> Bool {
  MutSortedSet::has(s, x)
}

#deprecated("use MutSortedSet::delete")
export fn SortedSet::delete[T](s: MutSortedSet[T], x: T) -> Bool {
  MutSortedSet::delete(s, x)
}

#deprecated("use MutSortedSet::size")
export fn SortedSet::size[T](s: MutSortedSet[T]) -> Int {
  MutSortedSet::size(s)
}

#deprecated("use MutSortedSet::min")
export fn SortedSet::min[T](s: MutSortedSet[T]) -> Option[T] {
  MutSortedSet::min(s)
}

#deprecated("use MutSortedSet::max")
export fn SortedSet::max[T](s: MutSortedSet[T]) -> Option[T] {
  MutSortedSet::max(s)
}

#deprecated("use MutSortedSet::to_array")
export fn SortedSet::to_array[T](s: MutSortedSet[T]) -> Array[T] {
  MutSortedSet::to_array(s)
}

#deprecated("use MutSortedSet::range")
export fn SortedSet::range[T](s: MutSortedSet[T], lo: T, hi: T) -> Array[T] {
  MutSortedSet::range(s, lo, hi)
}

#deprecated("use MutSortedSet::union")
export fn SortedSet::union[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  MutSortedSet::union(a, b)
}

#deprecated("use MutSortedSet::intersect")
export fn SortedSet::intersect[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  MutSortedSet::intersect(a, b)
}

#deprecated("use MutSortedSet::difference")
export fn SortedSet::difference[T](a: MutSortedSet[T], b: MutSortedSet[T]) -> MutSortedSet[T] {
  MutSortedSet::difference(a, b)
}
