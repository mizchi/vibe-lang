//# Imports

import ./maps.vibe {
  delete_by, get, get_by, get_or, get_or_by, get_or_else, get_or_else_by, has_by, has_key, is_empty, keys, length, set_by, values
}

//# Misc

test "map_accessors" {
  let m: Map[String, Int] = Map::from_pairs([("a", 1), ("b", 2)])
  assert(has_key(m, "a"))
  assert(not(has_key(m, "x")))
  match get(m, "b") {
    Some(v) => assert(eq(v, 2)),
    _ => assert(false)
  }
  match get(m, "x") {
    None => assert(true),
    _ => assert(false)
  }
  assert(eq(get_or(m, "a", 99), 1))
  assert(eq(get_or(m, "x", 99), 99))
  assert(eq(get_or_else(m, "x", () -> Int {
    42
  }), 42))
  assert(eq(length(m), 2))
  assert(not(is_empty(m)))
  assert(is_empty(Map::new()))
  let ks = keys(m)
  let vs = values(m)
  assert(eq(Array::length(ks), 2))
  assert(eq(Array::length(vs), 2))
}

test "map_function_and_method_style_parity" {
  let m: Map[String, Int] = Map::from_pairs([("a", 1), ("b", 2)])
  assert(eq(length(m), m |> length))
  assert(is_empty(m) == (m |> is_empty))
  assert(has_key(m, "a") == (m |> has_key("a")))
  assert(has_key(m, "x") == (m |> has_key("x")))
  assert(eq(get_or(m, "a", 0), m |> get_or("a", 0)))
  assert(eq(get_or(m, "x", 9), m |> get_or("x", 9)))
  let fallback = () -> Int {
    42
  }
  assert(eq(get_or_else(m, "x", fallback), m |> get_or_else("x", fallback)))
  match (get(m, "b"), m |> get("b")) {
    (Some(a), Some(b)) => assert(eq(a, b)),
    _ => assert(false)
  }
}

test "map_trait_key_accessors" {
  let m: Map[String, Int] = Map::from_pairs([("1", 10), ("2", 20)])
  assert(has_by(m, 1))
  assert(not(has_by(m, 9)))
  match get_by(m, 2) {
    Some(v) => assert(eq(v, 20)),
    _ => assert(false)
  }
  match get_by(m, 3) {
    None => assert(true),
    _ => assert(false)
  }
  assert(eq(get_or_by(m, 1, 99), 10))
  assert(eq(get_or_by(m, 3, 99), 99))
  assert(eq(get_or_else_by(m, 4, () -> Int {
    77
  }), 77))
}

test "map_trait_key_mutators" {
  // Write-side counterparts of get_by/has_by: previously there was no way to
  // populate a Hash-keyed Map without manually calling Map::set with a raw
  // String key.
  let e: Map[String, Int] = Map::new()
  let m1 = set_by(e, 1, 10)
  assert(has_by(m1, 1))
  assert(eq(get_or_by(m1, 1, -1), 10))
  // set_by on an existing key overwrites the value (same as Map::set).
  let m2 = set_by(m1, 1, 20)
  assert(eq(get_or_by(m2, 1, -1), 20))
  assert(eq(length(m2), 1))
  // set_by on a new key appends.
  let m3 = set_by(m2, 2, 30)
  assert(eq(length(m3), 2))
  assert(has_by(m3, 2))
  // delete_by removes the entry addressed by the hashed key, leaving others.
  let m4 = delete_by(m3, 1)
  assert(not(has_by(m4, 1)))
  assert(has_by(m4, 2))
  assert(eq(length(m4), 1))
  // set_by/delete_by are functional (persistent) like Map::set/Map::delete --
  // the original map is untouched by later writes.
  assert(eq(length(m3), 2))
  assert(has_by(m3, 1))
}

test "map_from_pairs_and_new (#960)" {
  // #960 Stage 1: `Map::from_pairs` / `Map::new` are the replacement API for
  // the `map { ... }` literal — same runtime representation, so the builtin
  // accessors behave identically on both spellings.
  let m = Map::from_pairs([("a", 1), ("b", 2)])
  assert(eq(Map::size(m), 2))
  assert(eq(Map::get(m, "a"), 1))
  assert(eq(Map::get(m, "b"), 2))
  assert(Map::has_key(m, "a"))
  assert(not(Map::has_key(m, "x")))
  let ks = Map::keys(m)
  assert(eq(Array::length(ks), 2))
  assert(Array::get(ks, 0) == "a")
  assert(Array::get(ks, 1) == "b")
  let e: Map[String, Int] = Map::new()
  assert(eq(Map::size(e), 0))
  assert(not(Map::has_key(e, "z")))
  let e2 = Map::set(e, "z", 9)
  assert(eq(Map::get(e2, "z"), 9))
  assert(eq(Map::size(e2), 1))
  // A second from_pairs build is interchangeable with the first (#960
  // Stage 2 removed the literal spelling).
  let lit = Map::from_pairs([("a", 1), ("b", 2)])
  assert(eq(Map::size(lit), Map::size(m)))
  assert(eq(Map::get(lit, "a"), Map::get(m, "a")))
  assert(eq(Map::get(lit, "b"), Map::get(m, "b")))
}
