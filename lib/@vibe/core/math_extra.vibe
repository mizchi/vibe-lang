//# Functions

// Split from math.vibe (#766): `sum` would collide with the bare `sum`
// already declared for `List[Int]` in ../index.vibei, so it stays
// undeclared here — reachable only from files inside this package
// (math_test.vibe / math_bench.vibe import it directly).

export fn sum(arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut total = 0
  let mut i = 0
  while i < len {
    total = total + Array::get(arr, i)
    i = i + 1
  }
  total
}
