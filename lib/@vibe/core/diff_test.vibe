//# Imports

import ./diff.vibe {
  count_additions, count_deletions, diff_lines, format_unified, has_changes
}

//# Misc

test "identical texts no changes" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "a\nb\nc")
  assert(not(has_changes(ops)))
  assert(count_additions(ops) == 0)
  assert(count_deletions(ops) == 0)
}

test "single line identical" {
  let ops = diff_lines(old_text = "hello", new_text = "hello")
  assert(not(has_changes(ops)))
}

test "addition at end" {
  let ops = diff_lines(old_text = "a\nb", new_text = "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
  assert(count_deletions(ops) == 0)
}

test "addition in middle" {
  let ops = diff_lines(old_text = "a\nc", new_text = "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
  assert(count_deletions(ops) == 0)
}

test "addition at start" {
  let ops = diff_lines(old_text = "b\nc", new_text = "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
}

test "deletion from end" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "a\nb")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 1)
  assert(count_additions(ops) == 0)
}

test "deletion from middle" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "a\nc")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 1)
  assert(count_additions(ops) == 0)
}

test "modification is add + remove" {
  let ops = diff_lines(old_text = "hello", new_text = "world")
  assert(has_changes(ops))
  assert(count_additions(ops) >= 1)
  assert(count_deletions(ops) >= 1)
}

test "multiple additions" {
  let ops = diff_lines(old_text = "a", new_text = "a\nb\nc\nd")
  assert(count_additions(ops) == 3)
  assert(count_deletions(ops) == 0)
}

test "multiple deletions" {
  let ops = diff_lines(old_text = "a\nb\nc\nd", new_text = "a")
  assert(count_additions(ops) == 0)
  assert(count_deletions(ops) == 3)
}

test "complete replacement" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "x\ny\nz")
  assert(has_changes(ops))
  assert(count_additions(ops) == 3)
  assert(count_deletions(ops) == 3)
}

test "format_unified output keeps" {
  let ops = diff_lines(old_text = "a\nb", new_text = "a\nc")
  let output = format_unified(ops)
  assert(String::contains(output, needle = " a"))
  assert(String::contains(output, needle = "-b"))
  assert(String::contains(output, needle = "+c"))
}

test "format_unified identical has only keeps" {
  let ops = diff_lines(old_text = "a\nb", new_text = "a\nb")
  let output = format_unified(ops)
  assert(String::contains(output, needle = " a"))
  assert(String::contains(output, needle = " b"))
  assert(not(String::contains(output, needle = "+")))
  assert(not(String::contains(output, needle = "-")))
}

test "empty to content" {
  let ops = diff_lines(old_text = "", new_text = "hello\nworld")
  assert(has_changes(ops))
  assert(count_additions(ops) == 2)
}

test "content to empty" {
  let ops = diff_lines(old_text = "hello\nworld", new_text = "")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 2)
}

test "reorder lines" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "c\nb\na")
  assert(has_changes(ops))
}

test "duplicate lines" {
  let ops = diff_lines(old_text = "a\na\na", new_text = "a\na\na")
  assert(not(has_changes(ops)))
}

test "mixed diffs come back in document order" {
  // Exact output, not counts: an op list built backwards and never reversed,
  // or a table that ignores the left neighbour, still has the right counts.
  // Found by `vibe mutate lib/@vibe/core/diff.vibe`.
  assert(format_unified(diff_lines(old_text = "a\nb\nc", new_text = "a\nx\nc")) == " a\n-b\n+x\n c\n")
  assert(format_unified(diff_lines(old_text = "a\nb\nc\nd\ne", new_text = "a\nc\ne\nf")) == " a\n-b\n c\n-d\n e\n+f\n")
  assert(format_unified(diff_lines(old_text = "a\nb", new_text = "a\nc\na")) == " a\n-b\n+c\n+a\n")
  // A text that opens with a newline has an empty first line.
  assert(format_unified(diff_lines(old_text = "\nb", new_text = "\nc")) == " \n-b\n+c\n")
}
