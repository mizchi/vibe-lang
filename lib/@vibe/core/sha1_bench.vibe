//# Imports

import ./sha1.vibe {
  sha1
}

//# Helpers

/// Same 1KiB/8KiB + baseline cases as @vibex/blake3/blake3_bench.vibe, so the
/// two digest benches compare like-for-like (input construction happens inside
/// the bench block in both; the baselines isolate that construction cost).
fn make_a(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, "a")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Misc

bench "sha1 empty" {
  let _ = sha1("")
}

bench "sha1 short" {
  let _ = sha1("Hello, SHA-1!")
}

bench "sha1 medium" {
  let _ = sha1("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789")
}

bench "sha1 abc" {
  let _ = sha1("abc")
}

bench "sha1 1KiB" {
  let _ = sha1(make_a(1024))
}

bench "sha1 8KiB" {
  let _ = sha1(make_a(8192))
}

bench "baseline make_a 1KiB" {
  let _ = make_a(1024)
}

bench "baseline make_a 8KiB" {
  let _ = make_a(8192)
}
