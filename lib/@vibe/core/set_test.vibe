//# Imports

import ./set.vibe {
  StringSet,
  add,
  contains,
  contains_by,
  empty,
  from_array,
  from_array_by,
  is_empty,
  remove,
  remove_by,
  set_difference,
  set_intersect,
  set_union,
  size
}

//# Misc

test "set_basic" {
  let s0: StringSet = empty()
  assert(is_empty(s0))
  assert(eq(size(s0), 0))
  let s1 = add(s0, "a")
  assert(contains(s1, "a"))
  assert(eq(size(s1), 1))
  let s2 = add(s1, "a")
  assert(eq(size(s2), 1))
  let s3 = remove(s2, "a")
  assert(not(contains(s3, "a")))
  assert(is_empty(s3))
}

test "set_ops" {
  let u = set_union(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(u), 3))
  assert(contains(u, "a"))
  assert(contains(u, "b"))
  assert(contains(u, "c"))
  let i = set_intersect(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(i), 1))
  assert(contains(i, "b"))
  let d = set_difference(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(d), 1))
  assert(contains(d, "a"))
}

test "set_generic_int" {
  let s = from_array_by([
    1,
    2,
    2,
    3
  ])
  assert(eq(size(s), 3))
  assert(contains_by(s, 1))
  assert(contains_by(s, 2))
  assert(contains_by(s, 3))
  let s2 = remove_by(s, 2)
  assert(not(contains_by(s2, 2)))
}

// #1189/#1194: `StringSet` gained `StringSet::xxx` qualified companions
// alongside its existing bare names (same pattern as List's `List::xxx`),
// so method-style dot-calls (#641/#736) now resolve on it. Only `StringSet`
// itself needs to be imported for this -- the qualified companions don't
// need a separate import (mirrors cheatsheet.md #736's `List::of3(..) |>
// length` example).
test "set_method_style_parity" {
  let s0: StringSet = empty()
  assert(s0.is_empty())
  assert(eq(s0.size(), 0))
  let s1 = s0.add("a")
  assert(s1.contains("a"))
  assert(eq(s1.size(), 1))
  let s2 = s1.remove("a")
  assert(not(s2.contains("a")))
  let u = s1.union(from_array([
    "b"
  ]))
  assert(eq(u.size(), 2))
  let i = u.intersect(from_array([
    "a"
  ]))
  assert(eq(i.size(), 1))
  assert(i.contains("a"))
  let d = u.difference(from_array([
    "a"
  ]))
  assert(eq(d.size(), 1))
  assert(d.contains("b"))
}
