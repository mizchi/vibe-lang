//# Imports

import ./set.vibe {
  StringSet,
  add,
  contains,
  contains_by,
  empty,
  from_array,
  from_array_by,
  is_empty,
  remove,
  remove_by,
  set_difference,
  set_intersect,
  set_union,
  size
}

//# Misc

test "set_basic" {
  let s0: StringSet = empty()
  assert(is_empty(s0))
  assert(eq(size(s0), 0))
  let s1 = add(s = s0, value = "a")
  assert(contains(s = s1, value = "a"))
  assert(eq(size(s1), 1))
  let s2 = add(s = s1, value = "a")
  assert(eq(size(s2), 1))
  let s3 = remove(s = s2, value = "a")
  assert(not(contains(s = s3, value = "a")))
  assert(is_empty(s3))
  // Removing one element keeps the rest (a remove that dropped everything
  // passed the lines above).
  let s4 = remove(s = from_array(["a", "b", "c"]), value = "b")
  assert(eq(size(s4), 2))
  assert(contains(s = s4, value = "a"))
  assert(contains(s = s4, value = "c"))
}

test "set_ops" {
  let u = set_union(a = from_array(["a", "b", "b"]), b = from_array(["b", "c"]))
  assert(eq(size(u), 3))
  assert(contains(s = u, value = "a"))
  assert(contains(s = u, value = "b"))
  assert(contains(s = u, value = "c"))
  let i = set_intersect(a = from_array(["a", "b", "b"]), b = from_array([
    "b",
    "c"
  ]))
  assert(eq(size(i), 1))
  assert(contains(s = i, value = "b"))
  let d = set_difference(a = from_array(["a", "b", "b"]), b = from_array([
    "b",
    "c"
  ]))
  assert(eq(size(d), 1))
  assert(contains(s = d, value = "a"))
}

test "set_generic_int" {
  let s = from_array_by(values = [1, 2, 2, 3], key = int_key)
  assert(eq(size(s), 3))
  assert(contains_by(s = s, key = int_key, value = 1))
  assert(contains_by(s = s, key = int_key, value = 2))
  assert(contains_by(s = s, key = int_key, value = 3))
  let s2 = remove_by(s = s, key = int_key, value = 2)
  assert(not(contains_by(s = s2, key = int_key, value = 2)))
  assert(contains_by(s = s2, key = int_key, value = 1))
  assert(contains_by(s = s2, key = int_key, value = 3))
}

// #1189/#1194: `StringSet` gained `StringSet::xxx` qualified companions
// alongside its existing bare names (same pattern as List's `List::xxx`),
// so method-style dot-calls (#641/#736) now resolve on it. Only `StringSet`
// itself needs to be imported for this -- the qualified companions don't
// need a separate import (mirrors cheatsheet.md #736's `List::of3(..) |>
// length` example).
test "set_method_style_parity" {
  let s0: StringSet = empty()
  assert(s0.is_empty())
  assert(eq(s0.size(), 0))
  let s1 = s0.add(value = "a")
  assert(s1.contains(value = "a"))
  assert(eq(s1.size(), 1))
  let s2 = s1.remove(value = "a")
  assert(not(s2.contains(value = "a")))
  let u = s1.union(b = from_array(["b"]))
  assert(eq(u.size(), 2))
  let i = u.intersect(b = from_array(["a"]))
  assert(eq(i.size(), 1))
  assert(i.contains(value = "a"))
  let d = u.difference(b = from_array(["a"]))
  assert(eq(d.size(), 1))
  assert(d.contains(value = "b"))
}

fn int_key(_ value: Int) -> String {
  Int::to_string(value)
}
