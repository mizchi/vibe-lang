import @vibe/core {
  struct MutMap, struct MutSet
}

test "insert_if_absent preserves the original owned value and set still replaces it" {
  let m: MutMap[String, Array[Int]] = MutMap::new_string()
  let first = [7]
  assert(MutMap::insert_if_absent(m, k = "key", v = first))
  assert(!MutMap::insert_if_absent(m, k = String::concat("ke", "y"), v = [9]))
  Array::set(first, at = 0, value = 8)
  match MutMap::get(m, k = "key") {
    Some(value) => assert(Array::get(value, at = 0) == 8),
    None => assert(false)
  }
  MutMap::set(m, k = "key", v = [11])
  match MutMap::get(m, k = "key") {
    Some(value) => assert(Array::get(value, at = 0) == 11),
    None => assert(false)
  }
  assert(MutMap::size(m) == 1)
}

test "insert_if_absent handles collisions across growth and skips tombstones before a hit" {
  let m: MutMap[Int, Int] = MutMap::with_capacity(hash_fn = (k: Int) -> Int {
    0 - 1
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  }, capacity = 17)
  let mut i = 0
  while i < 200 {
    assert(MutMap::insert_if_absent(m, k = i, v = i * 10))
    i = i + 1
  }
  assert(MutMap::delete(m, k = 0))
  assert(!MutMap::insert_if_absent(m, k = 199, v = 9999))
  assert(m.tombs == 1)
  assert(MutMap::insert_if_absent(m, k = 300, v = 3000))
  assert(m.tombs == 0)
  assert(MutMap::size(m) == 200)
  let mut j = 1
  while j < 200 {
    assert(MutMap::get(m, k = j) == Some(j * 10))
    j = j + 1
  }
  assert(MutMap::get(m, k = 300) == Some(3000))
  assert(!MutMap::has(m, k = 0))
}

test "insertion hashes once without growth and a duplicate at the growth boundary keeps capacity" {
  let calls = [0]
  let m: MutMap[Int, Int] = MutMap::with_capacity(hash_fn = (k: Int) -> Int {
    Array::set(calls, at = 0, value = Array::get(calls, at = 0) + 1)
    k
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  }, capacity = 8)
  let mut i = 0
  while i < 5 {
    assert(MutMap::insert_if_absent(m, k = i, v = i))
    i = i + 1
  }
  assert(Array::get(calls, at = 0) == 5)
  Array::set(calls, at = 0, value = 0)
  let inserted = MutMap::insert_if_absent(m, k = 4, v = 99)
  assert(!inserted)
  assert(Array::get(calls, at = 0) == 1)
  assert(Bytes::length(m.ctrl) == 8)
  assert(MutMap::get(m, k = 4) == Some(4))
  assert(MutMap::insert_if_absent(m, k = 5, v = 5))
  assert(Bytes::length(m.ctrl) > 8)
  assert(MutMap::size(m) == 6)
}

test "set insertion reports only new contents and interoperates with add and delete" {
  let s: MutSet[String] = MutSet::new_string()
  assert(MutSet::insert(s, x = ""))
  assert(!MutSet::insert(s, x = ""))
  MutSet::add(s, x = "alpha")
  assert(!MutSet::insert(s, x = String::concat("al", "pha")))
  assert(MutSet::delete(s, x = ""))
  assert(MutSet::insert(s, x = ""))
  assert(MutSet::has(s, x = "alpha"))
  assert(MutSet::size(s) == 2)
}
