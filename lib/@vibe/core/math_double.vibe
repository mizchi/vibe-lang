//# Functions

export fn ln(x: Double) -> Double {
  if x <= 0.0 {
    0.0 - 1.0 / 0.0
  }
  else {
    let ln2 = 0.6931471805599453
    let mut k = 0
    let mut m = x
    // #772: as with `sin`'s range reduction below, a Double comparison
    // (`>=`/`<`) directly in a `while` header hits the codegen's
    // type-oblivious while-loop fast path and gets compiled as an *integer*
    // comparison, which is meaningless on a boxed Double. Route through a
    // `let mut` Bool re-evaluated each iteration instead.
    let mut too_large = m >= 2.0
    while too_large {
      m = m * 0.5
      k = k + 1
      too_large = m >= 2.0
    }
    let mut too_small_m = m < 0.5
    while too_small_m {
      m = m * 2.0
      k = k - 1
      too_small_m = m < 0.5
    }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    let mut term = t
    let mut result = t
    let mut i = 1
    while i < 30 {
      let nd = Int::to_double(i * 2 + 1)
      term = term * t2
      result = result + term / nd
      i = i + 1
    }
    Int::to_double(k) * ln2 + 2.0 * result
  }
}

export let pi: Double = 3.14159265358979323846

export let tau: Double = 6.28318530717958647692

export fn sqrt(x: Double) -> Double {
  if x <= 0.0 {
    0.0
  } else {
    // #949: Newton from guess = x with a fixed iteration count fails for
    // large inputs (each iteration only halves the exponent gap, so e.g.
    // sqrt(1e40) needs ~66 halvings and 60 iterations aren't enough).
    // Pre-scale the initial guess to a power of two just below sqrt(x):
    // bring g up to >= 1, then halve while g*g still exceeds x. That
    // leaves g in (sqrt(x)/2, sqrt(x)], so a handful of Newton steps
    // converge quadratically for any finite magnitude.
    //
    // #772: Double comparisons must not sit directly in a `while` header
    // (integer-compare fast-path miscompile) -- route through `let mut`
    // Bools re-evaluated each iteration, as in `ln` above.
    let mut g = x
    let mut g_below_one = g < 1.0
    while g_below_one {
      g = g * 2.0
      g_below_one = g < 1.0
    }
    let mut gg_above_x = g * g > x
    while gg_above_x {
      g = g * 0.5
      gg_above_x = g * g > x
    }
    let mut i = 0
    while i < 8 {
      g = (g + x / g) * 0.5
      i = i + 1
    }
    g
  }
}

export fn hypot(x: Double, y: Double) -> Double {
  sqrt(x * x + y * y)
}

export fn log10(x: Double) -> Double {
  let log10e = 2.302585092994046
  ln(x) / log10e
}

export fn degrees(rad: Double) -> Double {
  rad * 180.0 / pi
}

export let e_const: Double = 2.71828182845904523536

let half_pi: Double = 1.5707963267948966

export fn radians(deg: Double) -> Double {
  deg * pi / 180.0
}

fn atan_small(x: Double) -> Double {
  let xx = x * x
  let mut result = x
  let mut term = x
  let mut i = 1
  while i < 20 {
    let n = i * 2 + 1
    let nd = Int::to_double(n)
    term = 0.0 - term * xx
    result = result + term / nd
    i = i + 1
  }
  result
}

export fn atan(x: Double) -> Double {
  if x > 1.0 {
    // #772: `half_pi` (a global) minus a call result (`atan(...)`) --
    // neither operand is a literal or a parameter, so the codegen's
    // syntactic `expr_is_floatish` heuristic (which has no real type
    // information) can't recognize this subtraction as float arithmetic and
    // silently compiles it as an *integer* subtraction on the two boxed
    // Double bit patterns/pointers instead. `+ 0.0` forces recognition
    // without changing the value.
    //
    // #949: recurse into the full `atan` (not `atan_small`) so that
    // 1/x values in (0.5, 1) go through the argument reduction below --
    // the bare 20-term Taylor series is ~1% off as |arg| approaches 1.
    (half_pi + 0.0) - atan(1.0 / x)
  }
  else if x < -1.0 {
    0.0 - half_pi - atan(1.0 / x)
  }
  else if x > 0.5 {
    // #949: the 20-term Taylor series converges too slowly near |x| = 1
    // (atan(0.99) was off by ~1%). Reduce via the half-angle identity
    // atan(x) = 2*atan(x / (1 + sqrt(1 + x^2))); for |x| <= 1 the reduced
    // argument is <= sqrt(2) - 1 ~ 0.414, so one reduction step always
    // lands in atan_small's fast-converging range.
    let y = x / (1.0 + sqrt(1.0 + x * x))
    2.0 * atan_small(y)
  }
  else if x < -0.5 {
    let y = x / (1.0 + sqrt(1.0 + x * x))
    2.0 * atan_small(y)
  }
  else {
    atan_small(x)
  }
}

export fn asin(x: Double) -> Double {
  if x >= 1.0 {
    half_pi
  }
  else if x <= -1.0 {
    0.0 - half_pi
  }
  else {
    atan(x / sqrt(1.0 - x * x))
  }
}

export fn acos(x: Double) -> Double {
  // #772: same `expr_is_floatish` blind spot as `atan` above -- `half_pi`
  // (global) minus a call result (`asin(x)`), neither recognized, silently
  // compiled as integer subtraction without the `+ 0.0` nudge.
  (half_pi + 0.0) - asin(x)
}

export fn atan2(y: Double, x: Double) -> Double {
  if x > 0.0 {
    atan(y / x)
  }
  else if x < 0.0 {
    // #772: same `expr_is_floatish` blind spot -- a call result
    // (`atan(y / x)`) combined with a global (`pi`), neither recognized by
    // the syntactic floatish heuristic, silently compiled as integer
    // arithmetic without the `+ 0.0` nudge on `pi`.
    if y >= 0.0 {
      atan(y / x) + (pi + 0.0)
    } else {
      atan(y / x) - (pi + 0.0)
    }
  }
  else {
    if y > 0.0 {
      half_pi
    }
    else if y < 0.0 {
      0.0 - half_pi
    }
    else {
      0.0
    }
  }
}

export fn exp_double(x: Double) -> Double {
  // #949: a fixed 30-term Maclaurin series diverges for x <~ -8
  // (catastrophic cancellation between huge alternating terms: exp(-10)
  // came back negative) and loses precision for large positive x (the
  // series is truncated long before the terms decay: exp(20) was off by
  // ~2%). Fix both by (a) mapping negative arguments through
  // 1/exp(-x), and (b) splitting the non-negative argument into integer
  // + fractional parts: exp(k + f) = e^k * exp(f) with e^k built by
  // repeated multiplication and the Maclaurin series only ever evaluated
  // on f in [0, 1), where 30 terms give full double precision.
  if x < (0.0 - 709.0) {
    // Codex P2 on #958: 1/exp(-x) divides by +inf once -x overflows
    // (~709.78) and flushes the still-representable subnormal tail
    // (exp underflows to true 0 only below ~-744). Square the
    // half-argument instead — gradual underflow handles the subnormal
    // range, and below ~-744 the product reaches 0 naturally.
    // (`+ 0.0` on the call result and the Double annotation on the
    // product: #772 — arithmetic with no literal/param operand is not
    // recognized as float by the checker/codegen heuristics.)
    let h = exp_double(x * 0.5) + 0.0
    let hh: Double = h * h
    hh
  }
  else if x < 0.0 {
    1.0 / exp_double(0.0 - x)
  }
  else if x > 710.0 {
    // exp overflows double range well before 710 (ln(DBL_MAX) ~ 709.78);
    // return +inf directly instead of walking the integer-part loop.
    1.0 / 0.0
  }
  else {
    let mut int_pow = 1.0
    let mut f = x
    // #772: comparison routed through a `let mut` Bool, not the `while`
    // header (integer-compare fast-path miscompile) -- see `ln` above.
    let mut has_int_part = f >= 1.0
    while has_int_part {
      f = f - 1.0
      int_pow = int_pow * e_const
      has_int_part = f >= 1.0
    }
    let mut result = 1.0
    let mut term = 1.0
    let mut i = 1
    while i < 30 {
      let id = Int::to_double(i)
      term = term * f / id
      result = result + term
      i = i + 1
    }
    int_pow * result
  }
}

export fn pow_double(base: Double, exponent: Double) -> Double {
  exp_double(exponent * ln(base))
}

export fn log2_double(x: Double) -> Double {
  let ln2 = 0.6931471805599453
  ln(x) / ln2
}

export fn sin(x: Double) -> Double {
  // #772: range-reduce `x` into `[-pi, pi]` before the Taylor series below.
  // This used to be a separate `normalize_angle` helper with
  // `while a > pi { a = a - tau }` / `while a < 0.0 - pi { a = a + tau }`,
  // which hit two independent pre-existing compiler bugs (never exercised
  // before because this test file was never wired into any CI battery):
  //
  // 1. A Double comparison (`EBinOp` with op `<`/`>`) directly in a `while`
  //    header hits the codegen's while-loop fast path
  //    (lib/@vibe/compiler/codegen/expr/compile_expr_tail3.vibe), which
  //    special-cases exactly that shape (cond is a top-level
  //    `<`/`>`/`<=`/`>=` EBinOp) but always emits *integer* i64.lt_s /
  //    i64.gt_s comparisons, with no check for Double operands -- unlike the
  //    general expression path, which dispatches on `expr_is_floatish` and
  //    correctly uses f64.lt / f64.gt. Doubles are boxed/tagged in the
  //    linear-memory backend, so comparing two Double bit-patterns with a
  //    signed-integer compare is meaningless: the loop-exit condition
  //    effectively never evaluated "false", so the loop body ran forever,
  //    each iteration bump-allocating a boxed Double until linear memory
  //    (grown to the 4GB / 65535-page ceiling) was exhausted and the next
  //    allocation trapped with "memory access out of bounds" -- reproducible
  //    even for `sin(0.0)`, since the second loop's condition
  //    (`a < 0.0 - pi`) is evaluated regardless of the actual value of `a`.
  //    Fix: route the comparison through a `let mut` Bool re-evaluated at
  //    the end of each iteration, so the `while` header itself is a plain
  //    identifier (not a top-level comparison `EBinOp`), sidestepping the
  //    buggy fast path and going through the normal (correct, type-aware)
  //    codegen path instead.
  // 2. Separately, calling a private (non-exported) helper function from
  //    inside an *exported* function that also contains a Double-arithmetic
  //    `while` loop -- exactly the `sin` / `normalize_angle` shape -- trips
  //    a second, independent codegen bug when `sin` is invoked across a
  //    module-import boundary (as every caller of this exported `sin`
  //    necessarily does): the call reproduces even with a trivial
  //    `identity` helper in place of `normalize_angle`, so it is unrelated
  //    to bug (1) or to the trig math itself, and traps with the same
  //    "memory access out of bounds" symptom in the exported wrapper.
  //    Fix: inline the range-reduction directly into `sin`'s body instead
  //    of factoring it into a separately-called helper, which avoids the
  //    private-call + Double-loop combination that triggers it.
  let mut a = x
  let mut too_big = a > pi
  while too_big {
    a = a - tau
    too_big = a > pi
  }
  let mut too_small = a < (0.0 - pi)
  while too_small {
    a = a + tau
    too_small = a < (0.0 - pi)
  }
  let aa = a * a
  let mut term = a
  let mut result = a
  let mut i = 1
  while i < 13 {
    let n = i * 2 * (i * 2 + 1)
    let nd = Int::to_double(n)
    term = 0.0 - term * aa / nd
    result = result + term
    i = i + 1
  }
  result
}

export fn cos(x: Double) -> Double {
  sin(x + half_pi)
}

export fn tan(x: Double) -> Double {
  // #772: `let c = cos(x)` -- the initializer is an unrecognized call, so
  // the codegen's `expr_is_floatish` heuristic marks `c`'s local slot as
  // non-float; the later `sin(x) / c` then has *no* recognized-floatish
  // operand (another unrecognized call divided by a non-float-tagged slot)
  // and gets compiled as integer division on the two boxed Double
  // pointers/bit-patterns. `+ 0.0` on the initializer marks `c`'s slot
  // floatish so the division is correctly recognized.
  let c = cos(x) + 0.0
  sin(x) / c
}
