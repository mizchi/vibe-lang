// @vibex/collections — HashSet[T]: mutable hash set.
//
// Thin wrapper over HashMap[T, Int] (values are a constant 0); see
// hashmap.vibe for the open-addressing details. The struct keeps its own
// copies of hash_fn / eq_fn so union / intersect / difference can build
// result sets without reading through the nested generic struct's fields
// (#829 caution). Element order of to_array is unspecified.

//# Imports

import ./hashmap.vibe {
  type HashMap, HashMap::delete, HashMap::has, HashMap::keys, HashMap::new, HashMap::set, HashMap::size, HashMap::with_capacity
}
import ./key.vibe { eq_int, eq_string, hash_int, hash_string }

//# Types

export struct HashSet[T] {
  inner: HashMap[T, Int];
  hash_fn: (T) -> Int;
  eq_fn: (T, T) -> Bool
}

//# Constructors

export fn HashSet::with_capacity[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool, capacity: Int) -> HashSet[T] {
  let inner: HashMap[T, Int] = HashMap::with_capacity(hash_fn, eq_fn, capacity)
  HashSet::{
    inner: inner,
    hash_fn: hash_fn,
    eq_fn: eq_fn
  }
}

export fn HashSet::new[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool) -> HashSet[T] {
  HashSet::with_capacity(hash_fn, eq_fn, 16)
}

// Specialized constructors (same annotation workaround as hashmap.vibe).
export fn HashSet::new_int() -> HashSet[Int] {
  let s: HashSet[Int] = HashSet::new(hash_int, eq_int)
  s
}

export fn HashSet::new_string() -> HashSet[String] {
  let s: HashSet[String] = HashSet::new(hash_string, eq_string)
  s
}

//# Operations

export fn HashSet::add[T](s: HashSet[T], x: T) -> Unit {
  HashMap::set(s.inner, x, 0)
}

export fn HashSet::has[T](s: HashSet[T], x: T) -> Bool {
  HashMap::has(s.inner, x)
}

export fn HashSet::delete[T](s: HashSet[T], x: T) -> Bool {
  HashMap::delete(s.inner, x)
}

export fn HashSet::size[T](s: HashSet[T]) -> Int {
  HashMap::size(s.inner)
}

export fn HashSet::to_array[T](s: HashSet[T]) -> Array[T] {
  HashMap::keys(s.inner)
}

//# Set algebra (result sets use the left operand's key functions)

export fn HashSet::union[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T] {
  let out = HashSet::new(a.hash_fn, a.eq_fn)
  let xs = HashSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    HashSet::add(out, Array::get(xs, i))
    i = i + 1
  }
  let ys = HashSet::to_array(b)
  let mut j = 0
  while j < Array::length(ys) {
    HashSet::add(out, Array::get(ys, j))
    j = j + 1
  }
  out
}

export fn HashSet::intersect[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T] {
  let out = HashSet::new(a.hash_fn, a.eq_fn)
  let xs = HashSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if HashSet::has(b, x) {
      HashSet::add(out, x)
    }
    i = i + 1
  }
  out
}

export fn HashSet::difference[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T] {
  let out = HashSet::new(a.hash_fn, a.eq_fn)
  let xs = HashSet::to_array(a)
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if not(HashSet::has(b, x)) {
      HashSet::add(out, x)
    }
    i = i + 1
  }
  out
}
