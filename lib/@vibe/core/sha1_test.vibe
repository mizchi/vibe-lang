//# Imports

import ./sha1.vibe {
  sha1
}

//# Functions

fn repeat_a(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, "a")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Misc

// Each vector reaches padding or length bytes the others do not; picked with
// `vibe mutate lib/@vibe/core/sha1.vibe lib/@vibe/core/sha1_test.vibe`.

test "sha1 empty string" {
  assert(sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
}

test "sha1 abc" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "sha1 of 56 bytes pads into a second block" {
  // FIPS 180 test vector: 56 bytes leave no room for the length in the first
  // block, so the padding loop and the multi-block schedule both run.
  assert(sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
}

test "sha1 of 10000 bytes sets the second and third length bytes" {
  // 80000 bits = 0x013880: the length field's bytes above the lowest are
  // non-zero only for a message this long.
  assert(sha1(repeat_a(10000)) == "a080cbda64850abb7b7f67ee875ba068074ff6fe")
}
