//# Imports

import ./sha1.vibe {
  String, sha1
}

//# Helpers

fn repeat_char(c: String, n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, c)
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Misc

test "sha1 empty string" {
  assert(sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
}

test "sha1 abc" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "sha1 message digest" {
  assert(sha1("message digest") == "c12252ceda8be8994d5fa0290a47231c1d16aae3")
}

test "sha1 abcdefghijklmnopqrstuvwxyz" {
  assert(sha1("abcdefghijklmnopqrstuvwxyz") == "32d10c7b8cf96570ca04ce37f2a19d84240d3a89")
}

test "sha1 single char" {
  assert(sha1("a") == "86f7e437faa5a7fce15d1ddcb9eaeaea377667b8")
}

test "String::sha1" {
  assert(("abc" |> sha1()) == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

// Multi-block coverage (#1392-adjacent perf work reuses `sched`/`result`
// `Bytes` buffers across every block in `process_blocks` — these pin down
// that a 2nd/3rd block carries the right chaining state, not just the
// first-block-only shapes above).
test "sha1 exactly one block boundary (64 bytes)" {
  assert(sha1(repeat_char("a", 64)) == "0098ba824b5c16427bd7a1122a5a442a25ec644d")
}

test "sha1 spans two blocks (100 bytes)" {
  assert(sha1(repeat_char("abcdefghij", 10)) == "40d72e0cd92274db512e66102ff125c0c7342408")
}

test "sha1 1KiB (multi-block)" {
  assert(sha1(repeat_char("a", 1024)) == "8eca554631df9ead14510e1a70ae48c70f9b9384")
}

test "sha1 8KiB (many blocks)" {
  assert(sha1(repeat_char("a", 8192)) == "2727756cfee3fbfe24bf5650123fd7743d7b3465")
}
