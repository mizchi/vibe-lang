version 0.1.0

// @vibe/core — vibe standard core library (ADR-0063 contract package).
// Modeled on moonbitlang/core's per-domain organization. The top level of
// this contract IS the public API: transparent type definitions + fn
// declarations, implemented by the sibling .vibe files. Consumed in-repo
// via a bare directory import (`import ../lib/@vibe/core { ... }`) and
// externally via the content-addressed store (`require @vibe/core ...` +
// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).
//
// v1 contents: sha1, leb128, list, set, hex. maps/map (the derive(Hash)
// machinery) stays in vibe/collection until the contract grammar can
// declare traits; prelude consolidation is the same follow-up track.

import ./sha1.vibe {}
import ./leb128.vibe {}
import ./list.vibe {}
import ./set.vibe {}
import ./hex.vibe {}

type List[T]
type StringSet

// --- sha1
fn sha1(msg: String) -> String

// --- hex
fn hex_encode(s: String) -> String
fn hex_decode(hex: String) -> String with { Error }

// --- leb128
fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int)
fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int)
fn sleb128_size(n: Int) -> Int
fn uleb128_size(n: Int) -> Int
fn write_sleb128(buf: Bytes, n: Int) -> Unit
fn write_uleb128(buf: Bytes, n: Int) -> Unit
fn encode_sleb128(n: Int) -> Bytes
fn encode_uleb128(n: Int) -> Bytes

// --- list
fn list_nth[T](xs: List[T], n: Int) -> Option[T]
fn nth[T](xs: List[T], n: Int) -> Option[T]
fn list_of3[T](a: T, b: T, c: T) -> List[T]
fn of3[T](a: T, b: T, c: T) -> List[T]
fn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]
fn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]
fn list_cons[T](x: T, xs: List[T]) -> List[T]
fn list_drop[T](n: Int, xs: List[T]) -> List[T]
fn drop[T](xs: List[T], n: Int) -> List[T]
fn list_fold[A, B](f: (B, A) -> B, init: B, xs: List[A]) -> B
fn list_sum(xs: List[Int]) -> Int
fn sum(xs: List[Int]) -> Int
fn list_head[T](xs: List[T]) -> Option[T]
fn head[T](xs: List[T]) -> Option[T]
fn list_iter[T, R](f: (T) -> R, xs: List[T]) -> Int
fn iter[T, R](xs: List[T], f: (T) -> R) -> Int
fn list_tail[T](xs: List[T]) -> List[T]
fn tail[T](xs: List[T]) -> List[T]
fn list_empty[T]() -> List[T]
fn list_length[T](xs: List[T]) -> Int
fn length[T](xs: List[T]) -> Int
fn iter_length[T](xs: List[T]) -> Int
fn list_reverse[T](xs: List[T]) -> List[T]
fn reverse[T](xs: List[T]) -> List[T]
fn list_map[A, B](f: (A) -> B, xs: List[A]) -> List[B]
fn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn list_take[T](n: Int, xs: List[T]) -> List[T]
fn take[T](xs: List[T], n: Int) -> List[T]
fn list_append[T](xs: List[T], ys: List[T]) -> List[T]
fn append[T](xs: List[T], ys: List[T]) -> List[T]
fn list_filter[T](pred: (T) -> Bool, xs: List[T]) -> List[T]
fn filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]
fn list_flatmap[A, B](f: (A) -> List[B], xs: List[A]) -> List[B]
fn flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]
fn list_is_empty[T](xs: List[T]) -> Bool
fn list_iter_get[T](xs: List[T], index: Int) -> T
fn iter_get[T](xs: List[T], index: Int) -> T
fn list_singleton[T](x: T) -> List[T]
fn singleton[T](x: T) -> List[T]
fn list_contains_by[T](eq: (T, T) -> Bool, value: T, xs: List[T]) -> Bool
fn List::nth[T](xs: List[T], n: Int) -> Option[T]
fn List::sum(xs: List[Int]) -> Int
fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]
fn List::drop[T](xs: List[T], n: Int) -> List[T]
fn List::head[T](xs: List[T]) -> Option[T]
fn List::iter[T, R](xs: List[T], f: (T) -> R) -> Int
fn List::tail[T](xs: List[T]) -> List[T]
fn List::take[T](xs: List[T], n: Int) -> List[T]
fn List::append[T](xs: List[T], ys: List[T]) -> List[T]
fn List::filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]
fn List::length[T](xs: List[T]) -> Int
fn List::flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]
fn List::reverse[T](xs: List[T]) -> List[T]
fn List::is_empty[T](xs: List[T]) -> Bool
fn List::iter_get[T](xs: List[T], index: Int) -> T
fn List::contains_by[T](xs: List[T], eq: (T, T) -> Bool, value: T) -> Bool
fn List::iter_length[T](xs: List[T]) -> Int

// --- set
fn size(s: StringSet) -> Int
fn empty() -> StringSet
fn remove(s: StringSet, value: String) -> StringSet
fn contains(s: StringSet, value: String) -> Bool
fn add(s: StringSet, value: String) -> StringSet
fn is_empty(s: StringSet) -> Bool
fn set_union(a: StringSet, b: StringSet) -> StringSet
fn from_array(values: Array[String]) -> StringSet
fn set_intersect(a: StringSet, b: StringSet) -> StringSet
fn set_difference(a: StringSet, b: StringSet) -> StringSet
fn set_value_to_string[T](value: T) -> String
fn add_by[T](s: StringSet, value: T) -> StringSet
fn remove_by[T](s: StringSet, value: T) -> StringSet
fn contains_by[T](s: StringSet, value: T) -> Bool
fn from_array_by[T](values: Array[T]) -> StringSet
