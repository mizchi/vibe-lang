//# Imports

import ./uuid.vibe {
  is_valid_v4, v4
}

//# Misc

bench "uuid/v4_generate" {
  let _ = v4(12345)
}

bench "uuid/v4_chain_3" {
  let (_, s1) = v4(42)
  let (_, s2) = v4(s1)
  let _ = v4(s2)
}

bench "uuid/is_valid_v4" {
  let (uuid, _) = v4(99999)
  let _ = is_valid_v4(uuid)
}

bench "uuid/is_valid_v4_reject" {
  let _ = is_valid_v4("not-a-uuid-at-all")
}
