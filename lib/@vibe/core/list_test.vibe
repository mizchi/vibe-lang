//# Imports

import ./list.vibe {
  List
}

//# Misc

test "List::empty" {
  let empty: List[Int] = List::empty()
  assert(List::is_empty(empty))
  assert(not(List::is_empty(List::singleton(1))))
}

test "List::singleton" {
  let xs = List::singleton(42)
  assert(eq(List::length(xs), 1))
  match List::head(xs) {
    Some(v) => assert(eq(v, 42)),
    _ => assert(false)
  }
}

test "List::cons" {
  let xs = List::cons(1, List::cons(2, List::empty()))
  assert(eq(List::length(xs), 2))
  match List::head(xs) {
    Some(v) => assert(eq(v, 1)),
    _ => assert(false)
  }
}

test "List::length" {
  let empty: List[Int] = List::empty()
  assert(eq(List::length(empty), 0))
  assert(eq(List::length(List::of3(1, 2, 3)), 3))
  assert(eq(List::length(List::of5(1, 2, 3, 4, 5)), 5))
}

test "List::reverse" {
  let xs = List::of3(1, 2, 3)
  let rev = List::reverse(xs)
  match List::head(rev) {
    Some(v) => assert(eq(v, 3)),
    _ => assert(false)
  }
}

test "List::map" {
  let xs = List::of3(1, 2, 3)
  let doubled = List::map(xs, (x: Int) -> Int {
    x * 2
  })
  assert(eq(List::sum(doubled), 12))
}

test "List::map generic" {
  let xs = List::of3("a", "bb", "ccc")
  let lengths = List::map(xs, (s: String) -> Int {
    String::length(s)
  })
  assert(eq(List::sum(lengths), 6))
}

test "List::fold" {
  let xs = List::of5(1, 2, 3, 4, 5)
  let total = List::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(total, 15))
  assert(eq(List::sum(xs), 15))
}

test "List::filter" {
  let xs = List::of5(1, 2, 3, 4, 5)
  let evens = List::filter(xs, (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(List::length(evens), 2))
  assert(eq(List::sum(evens), 6))
}

test "List::append" {
  let xs = List::of3(1, 2, 3)
  let ys = List::of3(4, 5, 6)
  let zs = List::append(xs, ys)
  assert(eq(List::length(zs), 6))
  assert(eq(List::sum(zs), 21))
}

test "List::nth" {
  let xs = List::of5(10, 20, 30, 40, 50)
  match List::nth(xs, 2) {
    Some(v) => assert(eq(v, 30)),
    _ => assert(false)
  }
  match List::nth(xs, 10) {
    None => assert(true),
    _ => assert(false)
  }
}

test "List::take" {
  let xs = List::of5(1, 2, 3, 4, 5)
  let taken = List::take(xs, 3)
  assert(eq(List::length(taken), 3))
  assert(eq(List::sum(taken), 6))
}

test "List::drop" {
  let xs = List::of5(1, 2, 3, 4, 5)
  let dropped = List::drop(xs, 2)
  assert(eq(List::length(dropped), 3))
  assert(eq(List::sum(dropped), 12))
}

test "List::contains_by" {
  let xs = List::of3("a", "bb", "ccc")
  let eq_string = (a: String, b: String) -> Bool {
    a == b
  }
  assert(List::contains_by(xs, eq_string, "bb"))
  assert(not(List::contains_by(xs, eq_string, "z")))
}

test "list method style via type members" {
  // #1080: importing the List type binds its `List::` companions, so
  // method-style pipes resolve without importing bare names. #1908: the
  // companion call's return type drives dispatch — no annotation needed.
  let xs = List::of3(1, 2, 3)
  assert(eq(xs |> length, 3))
  assert(eq(xs |> sum, 6))
}

test "List iter / zip / flatmap" {
  let threshold = 0
  let nums = List::of3(1, 2, 3)
  let count = List::iter(nums, (x: Int) -> Bool {
    x > threshold
  })
  let count_method = nums |> iter((x: Int) -> Bool {
    x > threshold
  })
  assert(eq(count, 3))
  assert(eq(count_method, 3))
  let letters = List::of3("a", "b", "c")
  let paired = List::zip(letters, List::of3(10, 20, 30))
  let paired_method = letters |> zip(List::of3(10, 20, 30))
  assert(eq(List::length(paired), 3))
  assert(eq(List::length(paired_method), 3))
  match List::nth(paired, 1) {
    Some(("b", 20)) => assert(true),
    _ => assert(false)
  }
  match List::nth(paired_method, 0) {
    Some(("a", 10)) => assert(true),
    _ => assert(false)
  }
  let odds = List::of3(1, 3, 5)
  let duplicated = List::flatmap(odds, (x: Int) -> List[Int] {
    List::append(List::singleton(x), List::singleton(x + 1))
  })
  let duplicated_method = odds |> flatmap((x: Int) -> List[Int] {
    List::append(List::singleton(x), List::singleton(x + 1))
  })
  assert(eq(List::length(duplicated), 6))
  assert(eq(List::length(duplicated_method), 6))
  assert(eq(List::sum(duplicated), 21))
  assert(eq(List::sum(duplicated_method), 21))
}

test "list for-in iterable" {
  let mut total = 0
  for x in List::of3(1, 2, 3) {
    total = total + x
  }
  assert(eq(total, 6))
}

test "list for-in iterable with index" {
  // #726 review follow-up: the indexed-Iterator for desugar must bind the
  // optional index name (`for i, x in ...`) to the loop counter. #1908
  // regression: the companion-call iterand types without an annotation.
  let mut weighted = 0
  for i, x in List::of3(10, 20, 30) {
    weighted = weighted + i * x
  }
  // 0*10 + 1*20 + 2*30 = 80
  assert(eq(weighted, 80))
}
