//# @vibe/core/hex — lowercase hex encode/decode over byte-strings (one char
//# code per byte, the same convention sha1's padding and the compiler's
//# `.hex` artifacts use). decode throws on odd length / non-hex digits.

//# Functions

let hex_chars: String = "0123456789abcdef"

export fn hex_encode(s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let b = String::char_code_at(s, i)&255
    let hi = (b>>4)&15
    let lo = b&15
    StringBuilder::push(sb, String::substring(hex_chars, hi, hi + 1))
    StringBuilder::push(sb, String::substring(hex_chars, lo, lo + 1))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn hex_digit_value(c: Int) -> Int with Exception {
  if c >= '0' && c <= '9' {
    c - '0'
  } else if c >= 'a' && c <= 'f' {
    c - 'a' + 10
  } else if c >= 'A' && c <= 'F' {
    c - 'A' + 10
  } else {
    throw("invalid hex digit")
  }
}

export fn hex_decode(hex: String) -> String with Exception {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("odd-length hex string")
  } else {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < len {
      let hi = hex_digit_value(String::char_code_at(hex, i))
      let lo = hex_digit_value(String::char_code_at(hex, i + 1))
      StringBuilder::push(sb, String::from_char_code((hi<<4)|lo))
      i = i + 2
    }
    StringBuilder::freeze(sb)
  }
}
