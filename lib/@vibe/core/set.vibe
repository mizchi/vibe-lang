//# @vibe/core/set — string set + generic Set[T] (#1140, ADR-0082). Both are
//# backed by the compiler-builtin persistent `Map` (#841 item E2: the prior
//# recursive linked-list enum made every operation O(n); the builtin map's
//# hash index gives O(1)-avg contains/add). `StringSet` predates `Set[T]`
//# and is kept as-is for backward compatibility -- `Set[String]` is
//# representationally equivalent (String's `Hash::hash_key` is the
//# identity, so `map_key_to_string` adds no conversion) but is the
//# moonbitlang/core-style generic spelling going forward. The contract
//# (index.vpkg) re-exports both as opaque `type` declarations, so this file
//# is free to choose its own internal representation.

//# Imports

import ./map.vibe {
  Hash, map_key_to_string
}

//# Types

export struct StringSet {
  entries: Map[String, Bool]
}

/// Generic persistent set, `T: Hash` (moonbitlang/core `immut/sorted_set`
/// is the reference design: purely applicative, every op returns a new
/// value). Backed by `Map[String, T]` -- keyed by `T::hash_key`, valued by
/// the ORIGINAL element -- rather than `Map[String, Bool]` like `StringSet`,
/// specifically so `to_array`/`from_array` round-trip losslessly for any
/// `T` (a `Bool`-valued map can't reconstruct `T` from its hash string
/// alone once `T != String`).
export struct Set[T] {
  entries: Map[String, T]
}

//# Functions

export fn size(s: StringSet) -> Int {
  Array::length(Map::keys(s.entries))
}

export fn empty() -> StringSet {
  StringSet::{
    entries: Map::new()
  }
}

export fn contains(s: StringSet, value: String) -> Bool {
  Map::has_key(s.entries, value)
}

export fn add(s: StringSet, value: String) -> StringSet {
  StringSet::{
    entries: Map::set(s.entries, value, true)
  }
}

export fn remove(s: StringSet, value: String) -> StringSet {
  let keys = Map::keys(s.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      if k == value {
        go(i + 1, acc)
      } else go(i + 1, Map::set(acc, k, true))
    }
  }
  StringSet::{
    entries: go(0, Map::new())
  }
}

export fn is_empty(s: StringSet) -> Bool {
  Array::length(Map::keys(s.entries)) == 0
}

export fn set_union(a: StringSet, b: StringSet) -> StringSet {
  let keys = Map::keys(b.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {
    if i >= len {
      acc
    } else go(i + 1, Map::set(acc, Array::get(keys, i), true))
  }
  StringSet::{
    entries: go(0, a.entries)
  }
}

export fn from_array(values: Array[String]) -> StringSet {
  let len = Array::length(values)
  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {
    if i >= len {
      acc
    } else go(i + 1, Map::set(acc, Array::get(values, i), true))
  }
  StringSet::{
    entries: go(0, Map::new())
  }
}

export fn set_intersect(a: StringSet, b: StringSet) -> StringSet {
  let keys = Map::keys(a.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      if Map::has_key(b.entries, k) {
        go(i + 1, Map::set(acc, k, true))
      } else go(i + 1, acc)
    }
  }
  StringSet::{
    entries: go(0, Map::new())
  }
}

export fn set_difference(a: StringSet, b: StringSet) -> StringSet {
  let keys = Map::keys(a.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      if Map::has_key(b.entries, k) {
        go(i + 1, acc)
      } else go(i + 1, Map::set(acc, k, true))
    }
  }
  StringSet::{
    entries: go(0, Map::new())
  }
}

export fn set_value_to_string[T](value: T) -> String {
  __to_string(value)
}

export fn add_by[T](s: StringSet, value: T) -> StringSet {
  add(s, set_value_to_string(value))
}

export fn remove_by[T](s: StringSet, value: T) -> StringSet {
  remove(s, set_value_to_string(value))
}

export fn contains_by[T](s: StringSet, value: T) -> Bool {
  contains(s, set_value_to_string(value))
}

export fn from_array_by[T](values: Array[T]) -> StringSet {
  let len = Array::length(values)
  let rec go = (i: Int, acc: StringSet) -> StringSet {
    if i >= len {
      acc
    } else go(i + 1, add_by(acc, Array::get(values, i)))
  }
  go(0, empty())
}

// Method-style (#1189/#1194) qualified companions -- same pattern as
// list.vibe's `List::xxx`: each just delegates to the existing bare
// implementation above, so `s.size()` / `s |> StringSet::add(v)` resolve and
// `vibe normalize` has a qualified spelling to rewrite bare dot-calls to.
// Bare names above are unchanged (kept for pipe ergonomics + back-compat).

export fn StringSet::size(s: StringSet) -> Int {
  size(s)
}

export fn StringSet::contains(s: StringSet, value: String) -> Bool {
  contains(s, value)
}

export fn StringSet::add(s: StringSet, value: String) -> StringSet {
  add(s, value)
}

export fn StringSet::remove(s: StringSet, value: String) -> StringSet {
  remove(s, value)
}

export fn StringSet::is_empty(s: StringSet) -> Bool {
  is_empty(s)
}

export fn StringSet::union(a: StringSet, b: StringSet) -> StringSet {
  set_union(a, b)
}

export fn StringSet::intersect(a: StringSet, b: StringSet) -> StringSet {
  set_intersect(a, b)
}

export fn StringSet::difference(a: StringSet, b: StringSet) -> StringSet {
  set_difference(a, b)
}

export fn StringSet::add_by[T](s: StringSet, value: T) -> StringSet {
  add_by(s, value)
}

export fn StringSet::remove_by[T](s: StringSet, value: T) -> StringSet {
  remove_by(s, value)
}

export fn StringSet::contains_by[T](s: StringSet, value: T) -> Bool {
  contains_by(s, value)
}

// Generic Set[T] (#1140, ADR-0082) -- see the file header for the
// StringSet-vs-Set[T] relationship.

export fn Set::new[T]() -> Set[T] {
  Set::{
    entries: Map::new()
  }
}

export fn Set::size[T](s: Set[T]) -> Int {
  Array::length(Map::keys(s.entries))
}

export fn Set::is_empty[T](s: Set[T]) -> Bool {
  eq(Set::size(s), 0)
}

export fn Set::contains[T: Hash](s: Set[T], value: T) -> Bool {
  Map::has_key(s.entries, map_key_to_string(value))
}

export fn Set::add[T: Hash](s: Set[T], value: T) -> Set[T] {
  Set::{
    entries: Map::set(s.entries, map_key_to_string(value), value)
  }
}

export fn Set::remove[T: Hash](s: Set[T], value: T) -> Set[T] {
  Set::{
    entries: Map::delete(s.entries, map_key_to_string(value))
  }
}

export fn Set::to_array[T](s: Set[T]) -> Array[T] {
  // `Map::values` is a dead builtin declaration (no codegen, same gap
  // Set[T] itself had before this file) -- collect via keys + get, which
  // are real, same technique as map_get.vibe's `values`.
  let keys = Map::keys(s.entries)
  let len = Array::length(keys)
  let out = ArrayBuilder::new()
  let rec go = (i: Int) -> Unit {
    if i >= len {
      ()
    } else {
      ArrayBuilder::push(out, Map::get(s.entries, Array::get(keys, i)))
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(out)
}

export fn Set::from_array[T: Hash](values: Array[T]) -> Set[T] {
  // Was previously worked around with type-erased `__to_string(v)` instead
  // of `map_key_to_string(v)` (#1199 bug 1: calling a `[K: Hash]`-bounded
  // generic on a value obtained from `Array::get`/`values[i]` over a
  // generic `Array[T]` parameter broke wasm codegen). Fixed upstream in
  // desugar_trait_dict.vibe (array-element receiver dict threading); this
  // is back to the straightforward Hash-bounded implementation.
  let len = Array::length(values)
  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {
    if i >= len {
      acc
    } else {
      let v = Array::get(values, i)
      go(i + 1, Map::set(acc, map_key_to_string(v), v))
    }
  }
  Set::{
    entries: go(0, Map::new())
  }
}

export fn Set::union[T](a: Set[T], b: Set[T]) -> Set[T] {
  let keys = Map::keys(b.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      go(i + 1, Map::set(acc, k, Map::get(b.entries, k)))
    }
  }
  Set::{
    entries: go(0, a.entries)
  }
}

export fn Set::intersect[T](a: Set[T], b: Set[T]) -> Set[T] {
  let keys = Map::keys(a.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      if Map::has_key(b.entries, k) {
        go(i + 1, Map::set(acc, k, Map::get(a.entries, k)))
      } else go(i + 1, acc)
    }
  }
  Set::{
    entries: go(0, Map::new())
  }
}

export fn Set::difference[T](a: Set[T], b: Set[T]) -> Set[T] {
  let keys = Map::keys(a.entries)
  let len = Array::length(keys)
  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {
    if i >= len {
      acc
    } else {
      let k = Array::get(keys, i)
      if Map::has_key(b.entries, k) {
        go(i + 1, acc)
      } else go(i + 1, Map::set(acc, k, Map::get(a.entries, k)))
    }
  }
  Set::{
    entries: go(0, Map::new())
  }
}
