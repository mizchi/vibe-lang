//# @vibe/core/set — string set. The contract (index.vibei) re-exports the
//# StringSet enum via its bodyless `type StringSet` declaration.

//# Types

export enum StringSet {
  Empty;
  Node(String, StringSet)
}

//# Functions

export let rec size: (StringSet) -> Int = (s: StringSet) -> Int {
  match s {
    Empty => 0,
    Node(_, tail) => 1 + size(tail)
  }
}

export let empty: () -> StringSet = () -> {
  Empty
}

export let rec remove: (StringSet, String) -> StringSet = (s: StringSet, value: String) -> StringSet {
  match s {
    Empty => Empty,
    Node(head, tail) => if head == value {
      tail
    } else Node(head, remove(tail, value))
  }
}

export let rec contains: (StringSet, String) -> Bool = (s: StringSet, value: String) -> Bool {
  match s {
    Empty => false,
    Node(head, tail) => if head == value {
      true
    } else contains(tail, value)
  }
}

export let add: (StringSet, String) -> StringSet = (s, value) -> {
  if contains(s, value) {
    s
  } else Node(value, s)
}

export let is_empty: (StringSet) -> Bool = (s) -> {
  s is Empty
}

export let set_union: (StringSet, StringSet) -> StringSet = (a, b) -> {
  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => go(tail, add(acc, head))
    }
  }
  go(b, a)
}

export let from_array: (Array[String]) -> StringSet = (values) -> {
  let len = Array::length(values)
  let rec go = (i: Int, acc: StringSet) -> StringSet {
    if i >= len {
      acc
    } else go(i + 1, add(acc, Array::get(values, i)))
  }
  go(0, Empty)
}

export let set_intersect: (StringSet, StringSet) -> StringSet = (a, b) -> {
  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => if contains(b, head) {
        go(tail, add(acc, head))
      } else go(tail, acc)
    }
  }
  go(a, Empty)
}

export let set_difference: (StringSet, StringSet) -> StringSet = (a, b) -> {
  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => if contains(b, head) {
        go(tail, acc)
      } else go(tail, add(acc, head))
    }
  }
  go(a, Empty)
}

export let set_value_to_string = [T](value: T) -> String {
  __to_string(value)
}

export let add_by = [T](s: StringSet, value: T) -> StringSet {
  add(s, set_value_to_string(value))
}

export let remove_by = [T](s: StringSet, value: T) -> StringSet {
  remove(s, set_value_to_string(value))
}

export let contains_by = [T](s: StringSet, value: T) -> Bool {
  contains(s, set_value_to_string(value))
}

export let from_array_by = [T](values: Array[T]) -> StringSet {
  let len = Array::length(values)
  let rec go = (i: Int, acc: StringSet) -> StringSet {
    if i >= len {
      acc
    } else go(i + 1, add_by(acc, Array::get(values, i)))
  }
  go(0, Empty)
}
