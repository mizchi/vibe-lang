//# Imports

import ./math.vibe {
  abs,
  clamp,
  comb,
  divmod,
  gcd,
  is_even,
  is_odd,
  is_power_of_two,
  lcm,
  log2,
  max,
  max_array,
  min,
  min_array,
  perm,
  pow,
  product,
  sign,
  sqrt_int
}

import ./math_extra.vibe {
  sum
}

//# Functions

fn empty_ints() -> Array[Int] {
  Array::slice([0], 0, 0)
}

//# Misc

test "abs positive" {
  assert(abs(5) == 5)
}

test "abs negative" {
  assert(abs(-5) == 5)
}

test "abs zero" {
  assert(abs(0) == 0)
}

test "min" {
  assert(min(3, 7) == 3)
  assert(min(7, 3) == 3)
  assert(min(5, 5) == 5)
}

test "max" {
  assert(max(3, 7) == 7)
  assert(max(7, 3) == 7)
  assert(max(5, 5) == 5)
}

test "clamp" {
  assert(clamp(5, 0, 10) == 5)
  assert(clamp(-5, 0, 10) == 0)
  assert(clamp(15, 0, 10) == 10)
  assert(clamp(0, 0, 10) == 0)
  assert(clamp(10, 0, 10) == 10)
}

test "sign" {
  assert(sign(42) == 1)
  assert(sign(-7) == -1)
  assert(sign(0) == 0)
}

test "gcd" {
  assert(gcd(12, 8) == 4)
  assert(gcd(7, 13) == 1)
  assert(gcd(0, 5) == 5)
  assert(gcd(5, 0) == 5)
  assert(gcd(100, 75) == 25)
}

test "gcd negative" {
  assert(gcd(-12, 8) == 4)
  assert(gcd(12, -8) == 4)
}

test "lcm" {
  assert(lcm(4, 6) == 12)
  assert(lcm(3, 7) == 21)
  assert(lcm(0, 5) == 0)
  assert(lcm(12, 18) == 36)
}

test "pow" {
  assert(pow(2, 0) == 1)
  assert(pow(2, 1) == 2)
  assert(pow(2, 10) == 1024)
  assert(pow(3, 4) == 81)
  assert(pow(5, 3) == 125)
}

test "pow negative exponent" {
  assert(pow(2, -1) == 0)
}

test "sum" {
  assert(sum([1, 2, 3, 4, 5]) == 15)
  assert(sum([]) == 0)
  assert(sum([10]) == 10)
}

test "product" {
  assert(product([1, 2, 3, 4]) == 24)
  assert(product([]) == 1)
  assert(product([7]) == 7)
}

test "is_even" {
  assert(is_even(0))
  assert(is_even(2))
  assert(is_even(-4))
  assert(not(is_even(1)))
  assert(not(is_even(-3)))
}

test "is_odd" {
  assert(is_odd(1))
  assert(is_odd(3))
  assert(is_odd(-5))
  assert(not(is_odd(0)))
  assert(not(is_odd(2)))
}

test "divmod" {
  let (q, r) = divmod(17, 5)
  assert(q == 3)
  assert(r == 2)
}

test "divmod exact" {
  let (q, r) = divmod(10, 5)
  assert(q == 2)
  assert(r == 0)
}

test "max_array" {
  assert(max_array([1, 5, 3, 9, 2]) == 9)
  assert(max_array([42]) == 42)
  assert(max_array([-3, -1, -7]) == -1)
}

test "min_array" {
  assert(min_array([1, 5, 3, 9, 2]) == 1)
  assert(min_array([42]) == 42)
  assert(min_array([-3, -1, -7]) == -7)
}

test "is_power_of_two" {
  assert(is_power_of_two(1))
  assert(is_power_of_two(2))
  assert(is_power_of_two(4))
  assert(is_power_of_two(1024))
  assert(not(is_power_of_two(0)))
  assert(not(is_power_of_two(3)))
  assert(not(is_power_of_two(6)))
  assert(not(is_power_of_two(-4)))
}

test "log2" {
  assert(log2(1) == 0)
  assert(log2(2) == 1)
  assert(log2(4) == 2)
  assert(log2(8) == 3)
  assert(log2(1024) == 10)
  assert(log2(7) == 2)
  assert(log2(15) == 3)
}

test "sqrt_int" {
  assert(sqrt_int(0) == 0)
  assert(sqrt_int(1) == 1)
  assert(sqrt_int(4) == 2)
  assert(sqrt_int(9) == 3)
  assert(sqrt_int(16) == 4)
  assert(sqrt_int(100) == 10)
  assert(sqrt_int(10) == 3)
  assert(sqrt_int(99) == 9)
}

test "comb" {
  assert(comb(5, 0) == 1)
  assert(comb(5, 1) == 5)
  assert(comb(5, 2) == 10)
  assert(comb(5, 3) == 10)
  assert(comb(5, 5) == 1)
  assert(comb(10, 3) == 120)
  assert(comb(3, 5) == 0)
}

test "perm" {
  assert(perm(5, 0) == 1)
  assert(perm(5, 1) == 5)
  assert(perm(5, 2) == 20)
  assert(perm(5, 3) == 60)
  assert(perm(5, 5) == 120)
  assert(perm(3, 5) == 0)
}
