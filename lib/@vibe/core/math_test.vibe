//# Imports

import ./math.vibe {
  abs,
  clamp,
  comb,
  divmod,
  gcd,
  is_even,
  is_odd,
  is_power_of_two,
  lcm,
  log2,
  max,
  max_array,
  min,
  min_array,
  perm,
  pow,
  product,
  sign,
  sqrt_int
}

import ./math_extra.vibe {
  sum
}

//# Functions

fn empty_ints() -> Array[Int] {
  Array::slice([0], start = 0, end = 0)
}

//# Misc

test "abs positive" {
  assert(abs(5) == 5)
}

test "abs negative" {
  assert(abs(-5) == 5)
}

test "abs zero" {
  assert(abs(0) == 0)
}

test "min" {
  assert(min(a = 3, b = 7) == 3)
  assert(min(a = 7, b = 3) == 3)
  assert(min(a = 5, b = 5) == 5)
}

test "max" {
  assert(max(a = 3, b = 7) == 7)
  assert(max(a = 7, b = 3) == 7)
  assert(max(a = 5, b = 5) == 5)
}

test "clamp" {
  assert(clamp(n = 5, lo = 0, hi = 10) == 5)
  assert(clamp(n = -5, lo = 0, hi = 10) == 0)
  assert(clamp(n = 15, lo = 0, hi = 10) == 10)
  assert(clamp(n = 0, lo = 0, hi = 10) == 0)
  assert(clamp(n = 10, lo = 0, hi = 10) == 10)
}

test "sign" {
  assert(sign(42) == 1)
  // sign(1): a `> 1` test would still pass 42.
  assert(sign(1) == 1)
  assert(sign(-7) == -1)
  assert(sign(0) == 0)
}

test "gcd" {
  assert(gcd(a = 12, b = 8) == 4)
  assert(gcd(a = 7, b = 13) == 1)
  assert(gcd(a = 0, b = 5) == 5)
  assert(gcd(a = 5, b = 0) == 5)
  assert(gcd(a = 100, b = 75) == 25)
}

test "gcd negative" {
  assert(gcd(a = -12, b = 8) == 4)
  assert(gcd(a = 12, b = -8) == 4)
}

test "lcm" {
  assert(lcm(a = 4, b = 6) == 12)
  assert(lcm(a = 3, b = 7) == 21)
  assert(lcm(a = 0, b = 5) == 0)
  // gcd(0, 0) is 0: lcm must not divide by it.
  assert(lcm(a = 0, b = 0) == 0)
  assert(lcm(a = 12, b = 18) == 36)
}

test "pow" {
  assert(pow(base = 2, exp = 0) == 1)
  assert(pow(base = 2, exp = 1) == 2)
  assert(pow(base = 2, exp = 10) == 1024)
  assert(pow(base = 3, exp = 4) == 81)
  assert(pow(base = 5, exp = 3) == 125)
}

test "pow negative exponent" {
  assert(pow(base = 2, exp = -1) == 0)
}

test "sum" {
  assert(sum([1, 2, 3, 4, 5]) == 15)
  assert(sum([]) == 0)
  assert(sum([10]) == 10)
}

test "product" {
  assert(product([1, 2, 3, 4]) == 24)
  assert(product([]) == 1)
  assert(product([7]) == 7)
}

test "is_even" {
  assert(is_even(0))
  assert(is_even(2))
  assert(is_even(-4))
  assert(not(is_even(1)))
  assert(not(is_even(-3)))
}

test "is_odd" {
  assert(is_odd(1))
  assert(is_odd(3))
  assert(is_odd(-5))
  assert(not(is_odd(0)))
  assert(not(is_odd(2)))
}

test "divmod" {
  let (q, r) = divmod(a = 17, d = 5)
  assert(q == 3)
  assert(r == 2)
}

test "divmod exact" {
  let (q, r) = divmod(a = 10, d = 5)
  assert(q == 2)
  assert(r == 0)
}

test "max_array" {
  assert(max_array([1, 5, 3, 9, 2]) == 9)
  assert(max_array([42]) == 42)
  assert(max_array([-3, -1, -7]) == -1)
}

test "min_array" {
  assert(min_array([1, 5, 3, 9, 2]) == 1)
  assert(min_array([42]) == 42)
  assert(min_array([-3, -1, -7]) == -7)
}

test "is_power_of_two" {
  assert(is_power_of_two(1))
  assert(is_power_of_two(2))
  assert(is_power_of_two(4))
  assert(is_power_of_two(1024))
  assert(not(is_power_of_two(0)))
  assert(not(is_power_of_two(3)))
  assert(not(is_power_of_two(6)))
  assert(not(is_power_of_two(-4)))
}

test "log2" {
  assert(log2(1) == 0)
  assert(log2(2) == 1)
  assert(log2(4) == 2)
  assert(log2(8) == 3)
  assert(log2(1024) == 10)
  assert(log2(7) == 2)
  assert(log2(15) == 3)
}

test "sqrt_int" {
  assert(sqrt_int(0) == 0)
  assert(sqrt_int(-4) == 0)
  assert(sqrt_int(1) == 1)
  assert(sqrt_int(4) == 2)
  assert(sqrt_int(9) == 3)
  assert(sqrt_int(16) == 4)
  assert(sqrt_int(100) == 10)
  assert(sqrt_int(10) == 3)
  assert(sqrt_int(99) == 9)
}

test "comb" {
  assert(comb(n = 5, k = 0) == 1)
  assert(comb(n = 5, k = 1) == 5)
  assert(comb(n = 5, k = 2) == 10)
  assert(comb(n = 5, k = 3) == 10)
  assert(comb(n = 5, k = 5) == 1)
  assert(comb(n = 10, k = 3) == 120)
  assert(comb(n = 3, k = 5) == 0)
  assert(comb(n = 5, k = -1) == 0)
}

test "perm" {
  assert(perm(n = 5, k = 0) == 1)
  assert(perm(n = 5, k = 1) == 5)
  assert(perm(n = 5, k = 2) == 20)
  assert(perm(n = 5, k = 3) == 60)
  assert(perm(n = 5, k = 5) == 120)
  assert(perm(n = 3, k = 5) == 0)
  assert(perm(n = 5, k = -1) == 0)
}
