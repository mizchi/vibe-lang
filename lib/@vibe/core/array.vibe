//# Functions

/// A fresh, empty, growable Array[T] in a single allocation. `ArrayBuilder`
/// and `Array` share the same runtime representation -- `freeze` compiles to
/// the zero-cost `identity` op (checker.vibe #938's ArrayBuilder typing) --
/// so this is ONE allocation where the common `Array::slice([placeholder],
/// 0, 0)` idiom (a throwaway one-element literal, then a slice-copy) does
/// two. Prefer this over hand-rolling either form.
export fn array_empty[T]() -> Array[T] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}
