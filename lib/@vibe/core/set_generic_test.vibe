//# Imports

// #1140/ADR-0082: generic persistent Set[T] (T: Hash), the moonbitlang/core
// -style spelling alongside the pre-existing StringSet (see set.vibe's
// header comment for the relationship between the two).
//
// NOTE: most tests below call the Hash-bounded methods
// (add/contains/remove/from_array) via their explicit `Set::method(...)`
// form rather than dot-call sugar (`s.add(...)`) -- left as-is from when
// #1199 bug 2 made dot-call sugar on a `[T: Hash]`-bounded method produce
// invalid wasm (desugar_trait_dict.vibe's EDot-derived qualified-call
// rewrite skipped the same dict-synthesis step the literal `Type::method(..)`
// spelling went through, undershooting the rewritten function's real
// parameter count). Fixed in desugar_trait_dict.vibe's `as_recv_method`
// arm (routes through `lookup_gen`/`synth_dicts` like the EIdent arm does).
// `set_generic_dot_call_hash_bound` below exercises the now-fixed dot-call
// path directly as a regression test.
import ./set.vibe {
  Set
}

//# Functions

fn arr_has_int(arr: Array[Int], v: Int) -> Bool {
  let n = Array::length(arr)
  let rec go = (i: Int) -> Bool {
    if i >= n {
      false
    } else if eq(Array::get(arr, i), v) {
      true
    } else go(i + 1)
  }
  go(0)
}

fn arr_has_str(arr: Array[String], v: String) -> Bool {
  let n = Array::length(arr)
  let rec go = (i: Int) -> Bool {
    if i >= n {
      false
    } else if Array::get(arr, i) == v {
      true
    } else go(i + 1)
  }
  go(0)
}

//# Misc

test "set_generic_int_basic" {
  let s0: Set[Int] = Set::new()
  assert(s0.is_empty())
  assert(eq(s0.size(), 0))
  let s1 = Set::add(s0, 1)
  assert(Set::contains(s1, 1))
  assert(not(Set::contains(s1, 2)))
  assert(eq(s1.size(), 1))
  let s2 = Set::add(s1, 1)
  assert(eq(s2.size(), 1))
  let s3 = Set::add(s2, 2)
  assert(eq(s3.size(), 2))
  let s4 = Set::remove(s3, 1)
  assert(not(Set::contains(s4, 1)))
  assert(Set::contains(s4, 2))
  assert(eq(s4.size(), 1))
}

test "set_generic_to_array_from_array_round_trip" {
  // Unlike a Map[String, Bool]-backed set, Set[T] stores the ORIGINAL
  // element (Map[String, T]) so to_array recovers real Int values, not
  // their hash-key strings.
  let s = Set::from_array([
    3,
    1,
    2,
    2,
    1
  ])
  assert(eq(s.size(), 3))
  let arr = s.to_array()
  assert(eq(Array::length(arr), 3))
  assert(arr_has_int(arr, 1))
  assert(arr_has_int(arr, 2))
  assert(arr_has_int(arr, 3))
}

test "set_generic_union_intersect_difference" {
  let a = Set::from_array([
    1,
    2,
    3
  ])
  let b = Set::from_array([
    2,
    3,
    4
  ])
  let u = a.union(b)
  assert(eq(u.size(), 4))
  assert(Set::contains(u, 1))
  assert(Set::contains(u, 4))
  let i = a.intersect(b)
  assert(eq(i.size(), 2))
  assert(Set::contains(i, 2))
  assert(Set::contains(i, 3))
  assert(not(Set::contains(i, 1)))
  let d = a.difference(b)
  assert(eq(d.size(), 1))
  assert(Set::contains(d, 1))
  assert(not(Set::contains(d, 2)))
}

test "set_generic_string_instantiation" {
  // The specific case the naming issue (#1140) asked for: Set[String] as
  // the generic spelling of what StringSet already provides.
  let s: Set[String] = Set::new()
  let s1 = Set::add(Set::add(s, "a"), "b")
  let s2 = Set::add(s1, "a")
  assert(eq(s2.size(), 2))
  assert(Set::contains(s2, "a"))
  assert(Set::contains(s2, "b"))
  let arr = s2.to_array()
  assert(eq(Array::length(arr), 2))
  assert(arr_has_str(arr, "a"))
  assert(arr_has_str(arr, "b"))
}

test "set_generic_dot_call_hash_bound" {
  // Regression test for #1199 bug 2: dot-call sugar on a [T: Hash]-bounded
  // method (add/contains/remove) used to produce invalid wasm. Chained
  // dot-calls exercise the EDot-derived qualified-call rewrite repeatedly.
  let s0: Set[Int] = Set::new()
  let s1 = s0.add(1).add(2).add(2)
  assert(eq(s1.size(), 2))
  assert(s1.contains(1))
  assert(s1.contains(2))
  assert(not(s1.contains(3)))
  let s2 = s1.remove(1)
  assert(not(s2.contains(1)))
  assert(s2.contains(2))
}
