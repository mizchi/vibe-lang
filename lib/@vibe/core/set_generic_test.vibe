//# Imports

// #1140/ADR-0082: generic persistent Set[T] (T: Hash), the moonbitlang/core
// -style spelling alongside the pre-existing StringSet (see set.vibe's
// header comment for the relationship between the two).
//
// The Hash-bounded methods (add/contains/remove) are exercised via
// dot-call sugar (`s.add(x)`) below, same as the non-generic methods --
// #1199 fixed the trait-dictionary-passing gap that used to break dot-call
// specifically for `[T: Hash]` generics (desugar_trait_dict.vibe's EDot
// rewrite never synthesized the witness dictionary the qualified spelling
// got). `from_array` stays `Set::from_array(...)`: it has no receiver value
// to dot-call on, same shape as `Json::parse`.
import ./set.vibe {
  Set
}

//# Functions

fn arr_has_int(arr: Array[Int], v: Int) -> Bool {
  let n = Array::length(arr)
  let rec go = (i: Int) -> Bool {
    if i >= n {
      false
    } else if eq(Array::get(arr, i), v) {
      true
    } else go(i + 1)
  }
  go(0)
}

fn arr_has_str(arr: Array[String], v: String) -> Bool {
  let n = Array::length(arr)
  let rec go = (i: Int) -> Bool {
    if i >= n {
      false
    } else if Array::get(arr, i) == v {
      true
    } else go(i + 1)
  }
  go(0)
}

//# Misc

test "set_generic_int_basic" {
  let s0: Set[Int] = Set::new()
  assert(s0.is_empty())
  assert(eq(s0.size(), 0))
  let s1: Set[Int] = s0.add(1)
  assert(s1.contains(1))
  assert(not(s1.contains(2)))
  assert(eq(s1.size(), 1))
  let s2: Set[Int] = s1.add(1)
  assert(eq(s2.size(), 1))
  let s3: Set[Int] = s2.add(2)
  assert(eq(s3.size(), 2))
  let s4: Set[Int] = s3.remove(1)
  assert(not(s4.contains(1)))
  assert(s4.contains(2))
  assert(eq(s4.size(), 1))
}

test "set_generic_to_array_from_array_round_trip" {
  // Unlike a Map[String, Bool]-backed set, Set[T] stores the ORIGINAL
  // element (Map[String, T]) so to_array recovers real Int values, not
  // their hash-key strings.
  let s = Set::from_array([
    3,
    1,
    2,
    2,
    1
  ])
  assert(eq(s.size(), 3))
  let arr = s.to_array()
  assert(eq(Array::length(arr), 3))
  assert(arr_has_int(arr, 1))
  assert(arr_has_int(arr, 2))
  assert(arr_has_int(arr, 3))
}

test "set_generic_from_array_let_bound" {
  // #1199 Codex follow-up: Set::from_array's receiver was only inferable
  // when the argument was a function parameter (seed_var_types) or an
  // inline array literal (infer_arg_elem_type_name's EArray case) --
  // a plain let-bound local array had no recorded element type, so the
  // Hash dict synthesis silently failed and the call was emitted without
  // its dict argument (invalid wasm). array_elem_bind closes this gap.
  let xs = [
    5,
    6,
    5
  ]
  let s = Set::from_array(xs)
  assert(eq(s.size(), 2))
  assert(s.contains(5))
  assert(s.contains(6))
}

test "set_generic_union_intersect_difference" {
  let a: Set[Int] = Set::from_array([
    1,
    2,
    3
  ])
  let b: Set[Int] = Set::from_array([
    2,
    3,
    4
  ])
  let u: Set[Int] = a.union(b)
  assert(eq(u.size(), 4))
  assert(u.contains(1))
  assert(u.contains(4))
  let i: Set[Int] = a.intersect(b)
  assert(eq(i.size(), 2))
  assert(i.contains(2))
  assert(i.contains(3))
  assert(not(i.contains(1)))
  let d: Set[Int] = a.difference(b)
  assert(eq(d.size(), 1))
  assert(d.contains(1))
  assert(not(d.contains(2)))
}

test "set_generic_string_instantiation" {
  // The specific case the naming issue (#1140) asked for: Set[String] as
  // the generic spelling of what StringSet already provides.
  let s: Set[String] = Set::new()
  let s0: Set[String] = s.add("a")
  let s1: Set[String] = s0.add("b")
  let s2: Set[String] = s1.add("a")
  assert(eq(s2.size(), 2))
  assert(s2.contains("a"))
  assert(s2.contains("b"))
  let arr = s2.to_array()
  assert(eq(Array::length(arr), 2))
  assert(arr_has_str(arr, "a"))
  assert(arr_has_str(arr, "b"))
}
