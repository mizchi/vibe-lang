//# @vibe/core/list — cons-list. The contract (index.vibei) re-exports the
//# List enum via its bodyless `type List[T]` declaration.

//# Types

export enum List[T] {
  Nil;
  Cons(T, List[T])
}

impl [T] Iterable for List[T]

//# Functions

export fn list_nth[T](xs: List[T], n: Int) -> Option[T] {
  match xs {
    Nil => None,
    Cons(h, t) => if n == 0 {
      Some(h)
    } else list_nth(t, n - 1)
  }
}

export fn nth[T](xs: List[T], n: Int) -> Option[T] {
  list_nth(xs, n)
}

export fn list_of3[T](a: T, b: T, c: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Nil)))
}

export fn of3[T](a: T, b: T, c: T) -> List[T] {
  list_of3(a, b, c)
}

export fn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))
}

export fn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {
  list_of5(a, b, c, d, e)
}

export fn list_cons[T](x: T, xs: List[T]) -> List[T] {
  Cons(x, xs)
}

export fn list_drop[T](n: Int, xs: List[T]) -> List[T] {
  if n <= 0 {
    xs
  }
  else match xs {
    Nil => Nil,
    Cons(_, t) => list_drop(n - 1, t)
  }
}

export fn drop[T](xs: List[T], n: Int) -> List[T] {
  list_drop(n, xs)
}

export fn list_fold[A, B](f: (acc: B, x: A) -> B, init: B, xs: List[A]) -> B {
  let rec go = (acc: B, rest: List[A]) -> B {
    match rest {
      Nil => acc,
      Cons(h, t) => go(f(acc, h), t)
    }
  }
  go(init, xs)
}

export fn list_sum(xs: List[Int]) -> Int {
  list_fold((acc: Int, x: Int) -> Int {
    acc + x
  }, 0, xs)
}

export fn sum(xs: List[Int]) -> Int {
  list_sum(xs)
}

export fn list_head[T](xs: List[T]) -> Option[T] {
  match xs {
    Cons(h, _) => Some(h),
    _ => None
  }
}

export fn head[T](xs: List[T]) -> Option[T] {
  list_head(xs)
}

export fn list_iter[T, R](f: (x: T) -> R, xs: List[T]) -> Int {
  let rec go = (count: Int, rest: List[T]) -> Int {
    match rest {
      Nil => count,
      Cons(h, t) => {
        f(h)
        go(count + 1, t)
      }
    }
  }
  go(0, xs)
}

export fn iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {
  list_iter(f, xs)
}

export fn list_tail[T](xs: List[T]) -> List[T] {
  match xs {
    Cons(_, t) => t,
    _ => Nil
  }
}

export fn tail[T](xs: List[T]) -> List[T] {
  list_tail(xs)
}

export fn list_empty[T]() -> List[T] {
  Nil
}

/// package-private: bare alias collides with set.vibe in the flat
/// @vibe/core contract; the canonical name is list_empty.
fn empty[T]() -> List[T] {
  list_empty()
}

export fn list_length[T](xs: List[T]) -> Int {
  match xs {
    Nil => 0,
    Cons(_, t) => 1 + list_length(t)
  }
}

export fn length[T](xs: List[T]) -> Int {
  list_length(xs)
}

export fn iter_length[T](xs: List[T]) -> Int {
  list_length(xs)
}

export fn list_reverse[T](xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(Nil, xs)
}

export fn reverse[T](xs: List[T]) -> List[T] {
  list_reverse(xs)
}

export fn list_map[A, B](f: (x: A) -> B, xs: List[A]) -> List[B] {
  let rec go = (acc: List[B], rest: List[A]) -> List[B] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(f(h), acc), t)
    }
  }
  list_reverse(go(Nil, xs))
}

export fn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {
    match (left, right) {
      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),
      _ => list_reverse(acc)
    }
  }
  go(Nil, xs, ys)
}

export fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  list_zip(xs, ys)
}

export fn list_take[T](n: Int, xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {
    if count <= 0 {
      acc
    }
    else match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t, count - 1)
    }
  }
  list_reverse(go(Nil, xs, n))
}

export fn take[T](xs: List[T], n: Int) -> List[T] {
  list_take(n, xs)
}

export fn list_append[T](xs: List[T], ys: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(ys, list_reverse(xs))
}

export fn append[T](xs: List[T], ys: List[T]) -> List[T] {
  list_append(xs, ys)
}

export fn list_filter[T](pred: (x: T) -> Bool, xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) =>
      if pred(h) {
        go(Cons(h, acc), t)
      }
      else go(acc, t)
    }
  }
  list_reverse(go(Nil, xs))
}

export fn filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {
  list_filter(pred, xs)
}

export fn list_flatmap[A, B](f: (x: A) -> List[B], xs: List[A]) -> List[B] {
  let rec go = (rest: List[A]) -> List[B] {
    match rest {
      Nil => Nil,
      Cons(h, t) => list_append(f(h), go(t))
    }
  }
  go(xs)
}

export fn flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {
  list_flatmap(f, xs)
}

export fn list_is_empty[T](xs: List[T]) -> Bool {
  xs is Nil
}

/// package-private: bare alias collides with set.vibe in the flat
/// @vibe/core contract; the canonical name is list_is_empty.
fn is_empty[T](xs: List[T]) -> Bool {
  list_is_empty(xs)
}

export fn list_iter_get[T](xs: List[T], index: Int) -> T {
  match xs {
    Cons(h, t) =>
    if index == 0 {
      h
    } else list_iter_get(t, index - 1)
    Nil => list_iter_get(xs, index)
  }
}

export fn iter_get[T](xs: List[T], index: Int) -> T {
  list_iter_get(xs, index)
}

export fn list_singleton[T](x: T) -> List[T] {
  Cons(x, Nil)
}

export fn singleton[T](x: T) -> List[T] {
  list_singleton(x)
}

export fn list_contains_by[T](eq: (a: T, b: T) -> Bool, value: T, xs: List[T]) -> Bool {
  match xs {
    Nil => false,
    Cons(h, t) => if eq(h, value) {
      true
    } else list_contains_by(eq, value, t)
  }
}

/// package-private: bare alias collides with set.vibe in the flat
/// @vibe/core contract; the canonical name is list_contains_by.
fn contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {
  list_contains_by(eq, value, xs)
}

export fn List::nth[T](xs: List[T], n: Int) -> Option[T] {
  list_nth(xs, n)
}

export fn List::sum(xs: List[Int]) -> Int {
  list_sum(xs)
}

export fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  list_zip(xs, ys)
}

export fn List::drop[T](xs: List[T], n: Int) -> List[T] {
  list_drop(n, xs)
}

export fn List::head[T](xs: List[T]) -> Option[T] {
  list_head(xs)
}

export fn List::iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {
  list_iter(f, xs)
}

export fn List::tail[T](xs: List[T]) -> List[T] {
  list_tail(xs)
}

export fn List::take[T](xs: List[T], n: Int) -> List[T] {
  list_take(n, xs)
}

export fn List::append[T](xs: List[T], ys: List[T]) -> List[T] {
  list_append(xs, ys)
}

export fn List::filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {
  list_filter(pred, xs)
}

export fn List::length[T](xs: List[T]) -> Int {
  list_length(xs)
}

export fn List::flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {
  list_flatmap(f, xs)
}

export fn List::reverse[T](xs: List[T]) -> List[T] {
  list_reverse(xs)
}

export fn List::is_empty[T](xs: List[T]) -> Bool {
  list_is_empty(xs)
}

export fn List::iter_get[T](xs: List[T], index: Int) -> T {
  iter_get(xs, index)
}

export fn List::contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {
  list_contains_by(eq, value, xs)
}

export fn List::iter_length[T](xs: List[T]) -> Int {
  iter_length(xs)
}
