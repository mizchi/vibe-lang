//# @vibe/core/list — cons-list. The contract (index.vpkg) re-exports the
//# List enum via its bodyless `type List[T]` declaration.
//#
//# #1843: `List::` is the ONE spelling. The historical triple surface
//# (`list_nth` / bare `nth` / `List::nth`, with `drop` even differing in
//# argument order between spellings) is gone — every operation is a
//# receiver-first `List::` function, matching the Array / String / Map
//# surfaces. `for x in xs` iterates via `List::iter_length` /
//# `List::iter_get` (the checker resolves `<Type>::iter_length` /
//# `<Type>::iter_get` for an Iterable receiver).

//# Types

export enum List[T] {
  Nil;
  Cons(T, List[T])
}

impl [T] Iterable for List[T]

//# Functions

export fn List::empty[T]() -> List[T] {
  Nil
}

export fn List::singleton[T](x: T) -> List[T] {
  Cons(x, Nil)
}

export fn List::cons[T](x: T, xs: List[T]) -> List[T] {
  Cons(x, xs)
}

export fn List::of3[T](a: T, b: T, c: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Nil)))
}

export fn List::of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))
}

export fn List::nth[T](xs: List[T], n: Int) -> Option[T] {
  match xs {
    Nil => None,
    Cons(h, t) => if n == 0 {
      Some(h)
    } else List::nth(t, n - 1)
  }
}

export fn List::head[T](xs: List[T]) -> Option[T] {
  match xs {
    Cons(h, _) => Some(h),
    _ => None
  }
}

export fn List::tail[T](xs: List[T]) -> List[T] {
  match xs {
    Cons(_, t) => t,
    _ => Nil
  }
}

export fn List::drop[T](xs: List[T], n: Int) -> List[T] {
  if n <= 0 {
    xs
  }
  else match xs {
    Nil => Nil,
    Cons(_, t) => List::drop(t, n - 1)
  }
}

export fn List::fold[A, B](xs: List[A], init: B, f: (acc: B, x: A) -> B) -> B {
  let rec go = (acc: B, rest: List[A]) -> B {
    match rest {
      Nil => acc,
      Cons(h, t) => go(f(acc, h), t)
    }
  }
  go(init, xs)
}

export fn List::sum(xs: List[Int]) -> Int {
  List::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  })
}

export fn List::iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {
  let rec go = (count: Int, rest: List[T]) -> Int {
    match rest {
      Nil => count,
      Cons(h, t) => {
        f(h)
        go(count + 1, t)
      }
    }
  }
  go(0, xs)
}

export fn List::length[T](xs: List[T]) -> Int {
  match xs {
    Nil => 0,
    Cons(_, t) => 1 + List::length(t)
  }
}

export fn List::iter_length[T](xs: List[T]) -> Int {
  List::length(xs)
}

export fn List::reverse[T](xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(Nil, xs)
}

export fn List::map[A, B](xs: List[A], f: (x: A) -> B) -> List[B] {
  let rec go = (acc: List[B], rest: List[A]) -> List[B] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(f(h), acc), t)
    }
  }
  List::reverse(go(Nil, xs))
}

export fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {
    match (left, right) {
      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),
      _ => List::reverse(acc)
    }
  }
  go(Nil, xs, ys)
}

export fn List::take[T](xs: List[T], n: Int) -> List[T] {
  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {
    if count <= 0 {
      acc
    }
    else match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t, count - 1)
    }
  }
  List::reverse(go(Nil, xs, n))
}

export fn List::append[T](xs: List[T], ys: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(ys, List::reverse(xs))
}

export fn List::filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) =>
      if pred(h) {
        go(Cons(h, acc), t)
      }
      else go(acc, t)
    }
  }
  List::reverse(go(Nil, xs))
}

export fn List::flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {
  let rec go = (rest: List[A]) -> List[B] {
    match rest {
      Nil => Nil,
      Cons(h, t) => List::append(f(h), go(t))
    }
  }
  go(xs)
}

export fn List::is_empty[T](xs: List[T]) -> Bool {
  xs is Nil
}

/// Total only for an in-bounds index: an out-of-bounds read recurses on Nil
/// forever by design (the Iterable convention pairs it with
/// `List::iter_length`, which bounds the loop).
export fn List::iter_get[T](xs: List[T], index: Int) -> T {
  match xs {
    Cons(h, t) =>
    if index == 0 {
      h
    } else List::iter_get(t, index - 1)
    Nil => List::iter_get(xs, index)
  }
}

export fn List::contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {
  match xs {
    Nil => false,
    Cons(h, t) => if eq(h, value) {
      true
    } else List::contains_by(t, eq, value)
  }
}
