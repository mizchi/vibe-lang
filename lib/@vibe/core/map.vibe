//# Imports

// get/has_key/get_or/get_or_else moved to ./map_get.vibe (#766): that file
// is header-imported by ../index.vibei (contract), so every export there
// must be a declared contract fn. Hash, the `[K: Hash]` generic-key family,
// and length/is_empty (name collisions with List::length / StringSet's
// bare is_empty) stay here, undeclared — reachable only from inside this
// package (../index.vibei's `import ./r#map.vibe {}` header line pulls
// this file in too, but only the map_get.vibe subset is contract-checked).
import ./map_get.vibe {
  get, has_key, get_or, get_or_else
}

//# Types

// `Hash` is method-bearing (#694): a key's stable Map-key string is produced by
// `hash_key(Self) -> String`. For scalars this is the value's decimal/identity
// string; `derive(Hash)` generates a STRUCTURAL `Type::hash_key` so two distinct
// but field-equal aggregates produce the same key. Because the method threads a
// witness dictionary (#684), `get_by`/`has_by`/`get_or_by` dispatch the right
// `hash_key` for the concrete key type instead of the type-erased `__to_string`
// pointer heuristic.
export trait Hash {
  hash_key(Self) -> String
}

impl Hash for Int {
  hash_key(self) -> String { __to_string(self) }
}

impl Hash for Float {
  hash_key(self) -> String { __to_string(self) }
}

impl Hash for Double {
  hash_key(self) -> String { __to_string(self) }
}

impl Hash for Bool {
  hash_key(self) -> String { __to_string(self) }
}

impl Hash for Char {
  hash_key(self) -> String { __to_string(self) }
}

impl Hash for String {
  hash_key(self) -> String { self }
}

//# Functions

export let length = [V](m: Map[String, V]) -> Int {
  Array::length(Map::keys(m))
}

export let is_empty = [V](m: Map[String, V]) -> Bool {
  length(m) == 0
}

export let map_key_to_string = [K: Hash](key: K) -> String {
  K::hash_key(key)
}

export let get_by = [K: Hash, V](m: Map[String, V], key: K) -> Option[V] {
  get(m, map_key_to_string(key))
}

export let has_by = [K: Hash, V](m: Map[String, V], key: K) -> Bool {
  has_key(m, map_key_to_string(key))
}

export let get_or_by = [K: Hash, V](m: Map[String, V], key: K, default: V) -> V {
  get_or(m, map_key_to_string(key), default)
}

export let get_or_else_by = [K: Hash, V](m: Map[String, V], key: K, default: () -> V,) -> V {
  get_or_else(m, map_key_to_string(key), default)
}
