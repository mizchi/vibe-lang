//# Imports

// get/has_key/get_or/get_or_else moved to ./map_get.vibe (#766): that file
// is header-imported by ../index.vibei (contract), so every export there
// must be a declared contract fn. Hash, the `[K: Hash]` generic-key family,
// and length/is_empty (name collisions with List::length / StringSet's
// bare is_empty) stay here, undeclared — reachable only from inside this
// package (../index.vibei's `import ./r#map.vibe {}` header line pulls
// this file in too, but only the map_get.vibe subset is contract-checked).
import ./map_get.vibe {
  get, get_or, get_or_else, has_key
}

//# Types

/// `Hash` is method-bearing (#694): a key's stable Map-key string is produced by
/// `hash_key(Self) -> String`. For scalars this is the value's decimal/identity
/// string; `derive(Hash)` generates a STRUCTURAL `Type::hash_key` so two distinct
/// but field-equal aggregates produce the same key. Because the method threads a
/// witness dictionary (#684), `get_by`/`has_by`/`get_or_by` dispatch the right
/// `hash_key` for the concrete key type instead of the type-erased `__to_string`
/// pointer heuristic.
export trait Hash {
  hash_key(Self) -> String
}

impl Hash for Int {
  hash_key(self) -> String {
    __to_string(self)
  }
}

/// `-0.0 + 0.0` is `+0.0`: the two zeros `==` equates share one key (#3544).
impl Hash for Double {
  hash_key(self) -> String {
    Double::to_string(self + 0.0)
  }
}

/// The f32 twin of `Double`'s key (#3625): `-0.0f + 0.0f` is `+0.0f`, and the
/// sum of an f32 and zero is exact, so it is the same f32. The key is that
/// value's shortest f32 digits (`0.1f` keys as `0.1`), every NaN keys as `NaN`.
impl Hash for Float {
  hash_key(self) -> String {
    Float::to_string(self + 0.0f)
  }
}

impl Hash for Bool {
  hash_key(self) -> String {
    __to_string(self)
  }
}

impl Hash for Char {
  hash_key(self) -> String {
    __to_string(self)
  }
}

impl Hash for String {
  hash_key(self) -> String {
    self
  }
}

//# Functions

export fn length[V](m: Map[String, V]) -> Int {
  Array::length(Map::keys(m))
}

export fn is_empty[V](m: Map[String, V]) -> Bool {
  length(m) == 0
}

export fn map_key_to_string[K: Hash](key: K) -> String {
  K::hash_key(key)
}

export fn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V] {
  get(m, map_key_to_string(key))
}

export fn has_by[K: Hash, V](m: Map[String, V], key: K) -> Bool {
  has_key(m, map_key_to_string(key))
}

export fn get_or_by[K: Hash, V](m: Map[String, V], key: K, default: V) -> V {
  get_or(m, map_key_to_string(key), default)
}

export fn get_or_else_by[K: Hash, V](m: Map[String, V], key: K, default: () -> V) -> V {
  get_or_else(m, map_key_to_string(key), default)
}

/// Write-side counterparts of get_by/has_by/get_or_by/get_or_else_by: the
/// read family let a Hash key query a Map[String, V], but there was no way
/// to ever populate one with a Hash key (Map::set/Map::delete are the
/// selfhost builtins and only ever take a literal String key).
export fn set_by[K: Hash, V](m: Map[String, V], key: K, value: V) -> Map[String, V] {
  Map::set(m, map_key_to_string(key), value)
}

export fn delete_by[K: Hash, V](m: Map[String, V], key: K) -> Map[String, V] {
  Map::delete(m, map_key_to_string(key))
}
