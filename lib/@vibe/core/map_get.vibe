//# Functions

// Split from map.vibe (#766): everything here is declared in ../index.vibei
// and header-imported by it, so every export in this file MUST match a
// contract decl exactly (undeclared exports are a conformance violation).
// `length`/`is_empty` stay in map.vibe instead — they'd collide with the
// bare `length` (List) / `is_empty` (StringSet) contract names already taken.

export let get = [V](m: Map[String, V], key: String) -> Option[V] {
  if Map::has_key(m, key) {
    Some(Map::get(m, key))
  } else None
}

export let keys = [V](m: Map[String, V]) -> Array[String] {
  Map::keys(m)
}

export let get_or = [V](m: Map[String, V], key: String, default: V) -> V {
  match get(m, key) {
    Some(value) => value,
    _ => default
  }
}

export let values = [V](m: Map[String, V]) -> Array[V] {
  // `Map::values` is not a selfhost builtin (host-era relic); collect via
  // keys + get, which are.
  let ks = Map::keys(m)
  let out = ArrayBuilder::new()
  let n = Array::length(ks)
  let mut i = 0
  while i < n {
    ArrayBuilder::push(out, Map::get(m, Array::get(ks, i)))
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

export let has_key = [V](m: Map[String, V], key: String) -> Bool {
  Map::has_key(m, key)
}

export let get_or_else = [V](m: Map[String, V], key: String, default: () -> V) -> V {
  match get(m, key) {
    Some(value) => value,
    _ => default()
  }
}
