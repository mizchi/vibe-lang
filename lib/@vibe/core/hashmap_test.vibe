//# Imports

import ./hashmap.vibe {
  struct MutMap
}
import ./key.vibe {
  hash_int, hash_string
}

//# Helpers

fn get_or[K, V](_ m: MutMap[K, V], k: K, dflt: V) -> V {
  match MutMap::get(m, k = k) {
    Some(v) => v,
    None => dflt
  }
}

//# Misc

test "empty map" {
  let m: MutMap[Int, String] = MutMap::new_int()
  assert_eq(MutMap::size(m), 0)
  assert_eq(MutMap::has(m, k = 1), false)
  assert_eq(MutMap::delete(m, k = 1), false)
  assert_eq(Array::length(MutMap::keys(m)), 0)
  assert_eq(Array::length(MutMap::values(m)), 0)
  assert_eq(Array::length(MutMap::to_array(m)), 0)
  match MutMap::get(m, k = 1) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}

test "single element int map" {
  let m: MutMap[Int, String] = MutMap::new_int()
  MutMap::set(m, k = 42, v = "answer")
  assert_eq(MutMap::size(m), 1)
  assert_eq(MutMap::has(m, k = 42), true)
  assert_eq(MutMap::has(m, k = 43), false)
  assert_eq(get_or(m, k = 42, dflt = "?"), "answer")
  assert_eq(get_or(m, k = -42, dflt = "?"), "?")
  let ks = MutMap::keys(m)
  assert_eq(Array::length(ks), 1)
  assert_eq(Array::get(ks, at = 0), 42)
}

test "duplicate set overwrites without growing" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, k = 7, v = 1)
  MutMap::set(m, k = 7, v = 2)
  MutMap::set(m, k = 7, v = 3)
  assert_eq(MutMap::size(m), 1)
  assert_eq(get_or(m, k = 7, dflt = -1), 3)
}

test "negative keys" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, k = -5, v = 50)
  MutMap::set(m, k = -1000000000000, v = 60)
  assert_eq(get_or(m, k = -5, dflt = -1), 50)
  assert_eq(get_or(m, k = -1000000000000, dflt = -1), 60)
  assert_eq(MutMap::size(m), 2)
}

test "delete then reinsert reuses tombstone" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, k = 1, v = 10)
  MutMap::set(m, k = 2, v = 20)
  assert_eq(MutMap::delete(m, k = 1), true)
  assert_eq(MutMap::size(m), 1)
  assert_eq(MutMap::has(m, k = 1), false)
  assert_eq(get_or(m, k = 2, dflt = -1), 20)
  MutMap::set(m, k = 1, v = 11)
  assert_eq(MutMap::size(m), 2)
  assert_eq(get_or(m, k = 1, dflt = -1), 11)
  // repeated delete/reinsert of the same key must not grow the table's
  // live count (tombstone accounting)
  let mut round = 0
  while round < 200 {
    assert_eq(MutMap::delete(m, k = 1), true)
    MutMap::set(m, k = 1, v = round)
    round = round + 1
  }
  assert_eq(MutMap::size(m), 2)
  assert_eq(get_or(m, k = 1, dflt = -1), 199)
}

test "rehash across growth with 300 int keys" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  let mut i = 0
  while i < 300 {
    MutMap::set(m, k = i * 7, v = i)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 300)
  let mut j = 0
  while j < 300 {
    assert_eq(get_or(m, k = j * 7, dflt = -1), j)
    j = j + 1
  }
  assert_eq(MutMap::has(m, k = 1), false)
  // delete every even entry, survivors intact
  let mut d = 0
  while d < 300 {
    assert_eq(MutMap::delete(m, k = d * 7), true)
    d = d + 2
  }
  assert_eq(MutMap::size(m), 150)
  let mut c = 1
  while c < 300 {
    assert_eq(get_or(m, k = c * 7, dflt = -1), c)
    c = c + 2
  }
  // keys/values/to_array agree with size
  assert_eq(Array::length(MutMap::keys(m)), 150)
  assert_eq(Array::length(MutMap::values(m)), 150)
  assert_eq(Array::length(MutMap::to_array(m)), 150)
}

test "keys and values are consistent" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  let mut i = 0
  while i < 20 {
    MutMap::set(m, k = i, v = i * 100)
    i = i + 1
  }
  // slot order is unspecified: check by sum, not position
  let ks = MutMap::keys(m)
  let vs = MutMap::values(m)
  let mut key_sum = 0
  let mut val_sum = 0
  let mut j = 0
  while j < Array::length(ks) {
    key_sum = key_sum + Array::get(ks, at = j)
    val_sum = val_sum + Array::get(vs, at = j)
    j = j + 1
  }
  assert_eq(key_sum, 190)
  assert_eq(val_sum, 19000)
  let entries = MutMap::to_array(m)
  let mut pair_ok = 0
  let mut p = 0
  while p < Array::length(entries) {
    let (k, v) = Array::get(entries, at = p)
    if v == k * 100 {
      pair_ok = pair_ok + 1
    }
    p = p + 1
  }
  assert_eq(pair_ok, 20)
}

test "string keys basic and collisions" {
  let m: MutMap[String, Int] = MutMap::new_string()
  MutMap::set(m, k = "", v = 0)
  MutMap::set(m, k = "a", v = 1)
  MutMap::set(m, k = "b", v = 2)
  MutMap::set(m, k = "ab", v = 3)
  MutMap::set(m, k = "ba", v = 4)
  assert_eq(MutMap::size(m), 5)
  assert_eq(get_or(m, k = "", dflt = -1), 0)
  assert_eq(get_or(m, k = "a", dflt = -1), 1)
  assert_eq(get_or(m, k = "b", dflt = -1), 2)
  assert_eq(get_or(m, k = "ab", dflt = -1), 3)
  assert_eq(get_or(m, k = "ba", dflt = -1), 4)
  assert_eq(MutMap::has(m, k = "aa"), false)
  assert_eq(MutMap::delete(m, k = "ab"), true)
  assert_eq(MutMap::has(m, k = "ab"), false)
  assert_eq(get_or(m, k = "ba", dflt = -1), 4)
}

test "string keys rehash across growth" {
  let m: MutMap[String, Int] = MutMap::new_string()
  let mut i = 0
  while i < 150 {
    MutMap::set(m, k = "key-\{i}", v = i)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 150)
  let mut j = 0
  while j < 150 {
    assert_eq(get_or(m, k = "key-\{j}", dflt = -1), j)
    j = j + 1
  }
  assert_eq(MutMap::has(m, k = "key-150"), false)
}

test "with_capacity clamps tiny capacity" {
  let m: MutMap[Int, Int] = MutMap::with_capacity_int(1)
  let mut i = 0
  while i < 50 {
    MutMap::set(m, k = i, v = i + 1)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 50)
  assert_eq(get_or(m, k = 49, dflt = -1), 50)
}

test "explicit dict custom key functions" {
  // custom equivalence: int keys compared by their last decimal digit
  let digit_hash: (Int) -> Int = (k) -> {
    let d = k % 10
    if d < 0 {
      d + 10
    } else {
      d
    }
  }
  let digit_eq: (Int, Int) -> Bool = (a, b) -> {
    digit_hash(a) == digit_hash(b)
  }
  let m: MutMap[Int, String] = MutMap::new(hash_fn = digit_hash, eq_fn = digit_eq)
  MutMap::set(m, k = 13, v = "three")
  assert_eq(get_or(m, k = 3, dflt = "?"), "three")
  assert_eq(get_or(m, k = 23, dflt = "?"), "three")
  MutMap::set(m, k = 103, v = "THREE")
  assert_eq(MutMap::size(m), 1)
  assert_eq(get_or(m, k = 13, dflt = "?"), "THREE")
  assert_eq(MutMap::has(m, k = 4), false)
  // first-string key dictionary using the exported hash_string directly
  let sm: MutMap[String, Int] = MutMap::new(hash_fn = hash_string, eq_fn = (a: String, b: String) -> Bool {
    a == b
  })
  MutMap::set(sm, k = "x", v = 9)
  assert_eq(get_or(sm, k = "x", dflt = -1), 9)
}

test "generic explicit constructor with_capacity" {
  let m: MutMap[Int, String] = MutMap::with_capacity(hash_fn = (k: Int) -> Int {
    k
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  }, capacity = 4)
  MutMap::set(m, k = 0, v = "zero")
  MutMap::set(m, k = 4, v = "four")
  MutMap::set(m, k = 8, v = "eight")
  assert_eq(get_or(m, k = 4, dflt = "?"), "four")
  assert_eq(get_or(m, k = 8, dflt = "?"), "eight")
  assert_eq(MutMap::size(m), 3)
}

test "rehash spare key slots stay None, not a copy of the last insert" {
  let m: MutMap[Int, Int] = MutMap::with_capacity_int(8)
  let mut i = 0
  while i < 20 {
    MutMap::set(m, k = i, v = i)
    i = i + 1
  }
  MutMap::set(m, k = 99, v = 99)
  let mut n99 = 0
  let mut j = 0
  while j < Array::length(m.keys) {
    match Array::get(m.keys, at = j) {
      Some(99) => {
        n99 = n99 + 1
      },
      _ => ()
    }
    j = j + 1
  }
  assert(eq(n99, 1))
}

//# Control-byte / fingerprint invariants (#2346)

/// Every key hashes to the SAME value, so every key shares both a home slot
/// and a fingerprint. The control byte therefore filters NOTHING and
/// correctness rests entirely on `eq_fn` still being consulted on a
/// fingerprint match: if a matching fingerprint were ever taken as proof of a
/// matching key, every lookup here would return the first key's value.
///
/// THIS IS THE ONE STATE THE REST OF THE FILE NEVER REACHES, and that is the
/// whole reason it exists. Three further tests were written alongside it
/// (negative hashes, rehash-heavy insertion, tombstone churn) and then
/// deleted: measured against eight mutations of the implementation, each of
/// them failed in exactly the cases "negative keys", "delete then reinsert
/// reuses tombstone" and "rehash across growth with 300 int keys" above
/// already failed, so they restated existing coverage. This one does not.
/// Truncating the probe walk to a hundred steps (`steps > cap` -> `steps >
/// 100`) leaves the other thirteen tests GREEN, because a well-spread hash
/// never probes that far, and fails here.
fn hash_const(_ x: Int) -> Int {
  if x < 0 {
    7
  } else {
    7
  }
}

fn eq_i(a: Int, b: Int) -> Bool {
  a == b
}

test "fingerprint collision: identical hash for every key" {
  let m: MutMap[Int, Int] = MutMap::new(hash_fn = hash_const, eq_fn = eq_i)
  let mut i = 0
  while i < 200 {
    MutMap::set(m, k = i, v = i * 10)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 200)
  let mut j = 0
  while j < 200 {
    assert_eq(get_or(m, k = j, dflt = -1), j * 10)
    j = j + 1
  }
  assert_eq(MutMap::has(m, k = 200), false)
  assert_eq(MutMap::delete(m, k = 137), true)
  assert_eq(MutMap::has(m, k = 137), false)
  assert_eq(get_or(m, k = 138, dflt = -1), 1380)
  assert_eq(MutMap::size(m), 199)
  assert_eq(Array::length(MutMap::keys(m)), 199)
}

test "an insert probing past a tombstone in the last slot wraps to find the key" {
  // Identity hash, 8 slots: 7 and 15 both home on slot 7, so 15 lands in
  // slot 0. Deleting 7 leaves a tombstone in the last slot; setting 15 again
  // must step past it and wrap to slot 0 to find the existing key, not insert
  // a second 15 in the tombstone. Found by `vibe mutate`: no other test
  // probes off the end of the table through a tombstone.
  let m: MutMap[Int, String] = MutMap::with_capacity(hash_fn = (k: Int) -> Int {
    k
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  }, capacity = 8)
  MutMap::set(m, k = 7, v = "seven")
  MutMap::set(m, k = 15, v = "fifteen")
  assert(MutMap::delete(m, k = 7))
  MutMap::set(m, k = 15, v = "FIFTEEN")
  assert_eq(MutMap::size(m), 1)
  assert_eq(get_or(m, k = 15, dflt = "?"), "FIFTEEN")
  assert_eq(MutMap::keys(m), [15])
}

test "the key hashes separate distinct keys" {
  // A map stays correct when every key collides, so no other test notices a
  // hash that collapsed to a constant -- only the probe lengths do.
  assert(hash_string("a") != hash_string("b"))
  assert(hash_string("") != hash_string("a"))
  assert(hash_string("ab") != hash_string("ba"))
  assert(hash_int(1) != hash_int(2))
}

test "rehash keeps colliding boxed values alive through deletion and regrowth" {
  let m: MutMap[Int, Array[Int]] = MutMap::with_capacity(hash_fn = (k: Int) -> 0, eq_fn = (a: Int, b: Int) -> a == b, capacity = 8)
  let shared = [7]
  MutMap::set(m, k = -1, v = shared)
  let mut i = 0
  while i < 80 {
    MutMap::set(m, k = i, v = [i - 11])
    i = i + 1
  }
  i = 0
  while i < 80 {
    assert(MutMap::delete(m, k = i))
    i = i + 2
  }
  while i < 400 {
    MutMap::set(m, k = i, v = [i - 11])
    i = i + 1
  }
  Array::push(shared, value = 13)
  assert(get_or(m, k = -1, dflt = []) == [7, 13])
  i = 0
  while i < 400 {
    if i < 80 && i % 2 == 0 {
      assert(!MutMap::has(m, k = i))
    } else {
      assert(get_or(m, k = i, dflt = []) == [i - 11])
    }
    i = i + 1
  }
  MutMap::set(m, k = -1, v = [31])
  assert(get_or(m, k = -1, dflt = []) == [31])
  assert(shared == [7, 13])
}

test "lookup results survive replacement and a miss skips tombstones" {
  let m: MutMap[Int, Array[Int]] = MutMap::with_capacity(hash_fn = (k: Int) -> 0, eq_fn = (a: Int, b: Int) -> a == b, capacity = 8)
  MutMap::set(m, k = 1, v = [3])
  let missing = MutMap::get(m, k = 2)
  let saved = MutMap::get(m, k = 1)
  MutMap::set(m, k = 2, v = [5])
  MutMap::set(m, k = 1, v = [7])
  assert(missing is None)
  assert(saved == Some([3]))
  assert(MutMap::delete(m, k = 1))
  assert(MutMap::get(m, k = 2) == Some([5]))
  assert(MutMap::get(m, k = 3) is None)
}

test "a full corrupted table still gives a bounded lookup miss" {
  let m: MutMap[Int, Int] = MutMap::with_capacity(hash_fn = (k: Int) -> 0, eq_fn = (a: Int, b: Int) -> a == b, capacity = 8)
  let mut i = 0
  while i < 8 {
    Array::set(m.keys, at = i, value = Some(i))
    Array::set(m.vals, at = i, value = Some(i + 10))
    Bytes::set(m.ctrl, at = i, value = 128)
    i = i + 1
  }
  assert(MutMap::get(m, k = 99) is None)
  assert(!MutMap::has(m, k = 99))
}
