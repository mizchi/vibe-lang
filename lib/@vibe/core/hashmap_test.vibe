//# Imports

import ./hashmap.vibe {
  type MutMap,
  MutMap::delete,
  MutMap::get,
  MutMap::has,
  MutMap::keys,
  MutMap::new,
  MutMap::new_int,
  MutMap::new_string,
  MutMap::set,
  MutMap::size,
  MutMap::to_array,
  MutMap::values,
  MutMap::with_capacity,
  MutMap::with_capacity_int
}
import ./key.vibe {
  hash_string
}

//# Helpers

fn get_or[K, V](m: MutMap[K, V], k: K, dflt: V) -> V {
  match MutMap::get(m, k) {
    Some(v) => v,
    None => dflt
  }
}

//# Misc

test "empty map" {
  let m: MutMap[Int, String] = MutMap::new_int()
  assert_eq(MutMap::size(m), 0)
  assert_eq(MutMap::has(m, 1), false)
  assert_eq(MutMap::delete(m, 1), false)
  assert_eq(Array::length(MutMap::keys(m)), 0)
  assert_eq(Array::length(MutMap::values(m)), 0)
  assert_eq(Array::length(MutMap::to_array(m)), 0)
  match MutMap::get(m, 1) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}

test "single element int map" {
  let m: MutMap[Int, String] = MutMap::new_int()
  MutMap::set(m, 42, "answer")
  assert_eq(MutMap::size(m), 1)
  assert_eq(MutMap::has(m, 42), true)
  assert_eq(MutMap::has(m, 43), false)
  assert_eq(get_or(m, 42, "?"), "answer")
  assert_eq(get_or(m, -42, "?"), "?")
  let ks = MutMap::keys(m)
  assert_eq(Array::length(ks), 1)
  assert_eq(Array::get(ks, 0), 42)
}

test "duplicate set overwrites without growing" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, 7, 1)
  MutMap::set(m, 7, 2)
  MutMap::set(m, 7, 3)
  assert_eq(MutMap::size(m), 1)
  assert_eq(get_or(m, 7, -1), 3)
}

test "negative keys" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, -5, 50)
  MutMap::set(m, -1000000000000, 60)
  assert_eq(get_or(m, -5, -1), 50)
  assert_eq(get_or(m, -1000000000000, -1), 60)
  assert_eq(MutMap::size(m), 2)
}

test "delete then reinsert reuses tombstone" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  MutMap::set(m, 1, 10)
  MutMap::set(m, 2, 20)
  assert_eq(MutMap::delete(m, 1), true)
  assert_eq(MutMap::size(m), 1)
  assert_eq(MutMap::has(m, 1), false)
  assert_eq(get_or(m, 2, -1), 20)
  MutMap::set(m, 1, 11)
  assert_eq(MutMap::size(m), 2)
  assert_eq(get_or(m, 1, -1), 11)
  // repeated delete/reinsert of the same key must not grow the table's
  // live count (tombstone accounting)
  let mut round = 0
  while round < 200 {
    assert_eq(MutMap::delete(m, 1), true)
    MutMap::set(m, 1, round)
    round = round + 1
  }
  assert_eq(MutMap::size(m), 2)
  assert_eq(get_or(m, 1, -1), 199)
}

test "rehash across growth with 300 int keys" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  let mut i = 0
  while i < 300 {
    MutMap::set(m, i * 7, i)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 300)
  let mut j = 0
  while j < 300 {
    assert_eq(get_or(m, j * 7, -1), j)
    j = j + 1
  }
  assert_eq(MutMap::has(m, 1), false)
  // delete every even entry, survivors intact
  let mut d = 0
  while d < 300 {
    assert_eq(MutMap::delete(m, d * 7), true)
    d = d + 2
  }
  assert_eq(MutMap::size(m), 150)
  let mut c = 1
  while c < 300 {
    assert_eq(get_or(m, c * 7, -1), c)
    c = c + 2
  }
  // keys/values/to_array agree with size
  assert_eq(Array::length(MutMap::keys(m)), 150)
  assert_eq(Array::length(MutMap::values(m)), 150)
  assert_eq(Array::length(MutMap::to_array(m)), 150)
}

test "keys and values are consistent" {
  let m: MutMap[Int, Int] = MutMap::new_int()
  let mut i = 0
  while i < 20 {
    MutMap::set(m, i, i * 100)
    i = i + 1
  }
  // slot order is unspecified: check by sum, not position
  let ks = MutMap::keys(m)
  let vs = MutMap::values(m)
  let mut key_sum = 0
  let mut val_sum = 0
  let mut j = 0
  while j < Array::length(ks) {
    key_sum = key_sum + Array::get(ks, j)
    val_sum = val_sum + Array::get(vs, j)
    j = j + 1
  }
  assert_eq(key_sum, 190)
  assert_eq(val_sum, 19000)
  let entries = MutMap::to_array(m)
  let mut pair_ok = 0
  let mut p = 0
  while p < Array::length(entries) {
    let (k, v) = Array::get(entries, p)
    if v == k * 100 {
      pair_ok = pair_ok + 1
    }
    p = p + 1
  }
  assert_eq(pair_ok, 20)
}

test "string keys basic and collisions" {
  let m: MutMap[String, Int] = MutMap::new_string()
  MutMap::set(m, "", 0)
  MutMap::set(m, "a", 1)
  MutMap::set(m, "b", 2)
  MutMap::set(m, "ab", 3)
  MutMap::set(m, "ba", 4)
  assert_eq(MutMap::size(m), 5)
  assert_eq(get_or(m, "", -1), 0)
  assert_eq(get_or(m, "a", -1), 1)
  assert_eq(get_or(m, "b", -1), 2)
  assert_eq(get_or(m, "ab", -1), 3)
  assert_eq(get_or(m, "ba", -1), 4)
  assert_eq(MutMap::has(m, "aa"), false)
  assert_eq(MutMap::delete(m, "ab"), true)
  assert_eq(MutMap::has(m, "ab"), false)
  assert_eq(get_or(m, "ba", -1), 4)
}

test "string keys rehash across growth" {
  let m: MutMap[String, Int] = MutMap::new_string()
  let mut i = 0
  while i < 150 {
    MutMap::set(m, "key-\{i}", i)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 150)
  let mut j = 0
  while j < 150 {
    assert_eq(get_or(m, "key-\{j}", -1), j)
    j = j + 1
  }
  assert_eq(MutMap::has(m, "key-150"), false)
}

test "with_capacity clamps tiny capacity" {
  let m: MutMap[Int, Int] = MutMap::with_capacity_int(1)
  let mut i = 0
  while i < 50 {
    MutMap::set(m, i, i + 1)
    i = i + 1
  }
  assert_eq(MutMap::size(m), 50)
  assert_eq(get_or(m, 49, -1), 50)
}

test "explicit dict custom key functions" {
  // custom equivalence: int keys compared by their last decimal digit
  let digit_hash: (Int) -> Int = (k) -> {
    let d = k % 10
    if d < 0 {
      d + 10
    } else {
      d
    }
  }
  let digit_eq: (Int, Int) -> Bool = (a, b) -> {
    digit_hash(a) == digit_hash(b)
  }
  let m: MutMap[Int, String] = MutMap::new(digit_hash, digit_eq)
  MutMap::set(m, 13, "three")
  assert_eq(get_or(m, 3, "?"), "three")
  assert_eq(get_or(m, 23, "?"), "three")
  MutMap::set(m, 103, "THREE")
  assert_eq(MutMap::size(m), 1)
  assert_eq(get_or(m, 13, "?"), "THREE")
  assert_eq(MutMap::has(m, 4), false)
  // first-string key dictionary using the exported hash_string directly
  let sm: MutMap[String, Int] = MutMap::new(hash_string, (a: String, b: String) -> Bool {
    a == b
  })
  MutMap::set(sm, "x", 9)
  assert_eq(get_or(sm, "x", -1), 9)
}

test "generic explicit constructor with_capacity" {
  let m: MutMap[Int, String] = MutMap::with_capacity((k: Int) -> Int {
    k
  }, (a: Int, b: Int) -> Bool {
    a == b
  }, 4)
  MutMap::set(m, 0, "zero")
  MutMap::set(m, 4, "four")
  MutMap::set(m, 8, "eight")
  assert_eq(get_or(m, 4, "?"), "four")
  assert_eq(get_or(m, 8, "?"), "eight")
  assert_eq(MutMap::size(m), 3)
}
