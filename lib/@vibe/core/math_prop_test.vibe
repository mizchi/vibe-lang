// #766: NOT in scripts/selfhost_unit_test_allowlist.txt — discovered during
// the @vibex/math -> @vibe/core migration that this traps ("unreachable")
// inside @vibex/quickcheck's own check_int/is_ok, unrelated to math.vibe.
// Pre-existing bug in @vibex/quickcheck, never exercised because this test
// file was never wired into any CI battery before. Out of scope here.

//# Imports

import @vibex/quickcheck {
  check_int, check_int2, check_nat, is_ok
}

import ./math.vibe {
  abs, gcd, is_even, is_odd, max, min
}

//# Misc

test "prop: abs non-negative" {
  let r = check_int("abs>=0", 42, 200, (n: Int) -> Bool {
    abs(n) >= 0
  })
  assert(is_ok(r))
}

test "prop: min commutative" {
  let r = check_int2("min_comm", 42, 200, (a: Int, b: Int) -> Bool {
    min(a, b) == min(b, a)
  })
  assert(is_ok(r))
}

test "prop: max commutative" {
  let r = check_int2("max_comm", 42, 200, (a: Int, b: Int) -> Bool {
    max(a, b) == max(b, a)
  })
  assert(is_ok(r))
}

test "prop: min <= max" {
  let r = check_int2("min<=max", 42, 200, (a: Int, b: Int) -> Bool {
    min(a, b) <= max(a, b)
  })
  assert(is_ok(r))
}

test "prop: gcd divides both" {
  let r = check_nat("gcd_div", 42, 200, (n: Int) -> Bool {
    if n == 0 {
      true
    } else {
      let g = gcd(n, n * 2)g > 0
    }
  })
  assert(is_ok(r))
}

test "prop: even/odd partition" {
  let r = check_int("even_odd", 42, 200, (n: Int) -> Bool {
    is_even(n) == not(is_odd(n))
  })
  assert(is_ok(r))
}
