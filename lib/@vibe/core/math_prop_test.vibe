//# Imports

import @vibex/quickcheck {
  check_int, check_int2, check_nat, is_ok
}

import ./math.vibe {
  abs, gcd, is_even, is_odd, max, min
}

//# Misc

test "prop: abs non-negative" {
  let r = check_int(name = "abs>=0", seed = 42, count = 200, prop = (n: Int) -> Bool {
    abs(n) >= 0
  })
  assert(is_ok(result = r))
}

test "prop: min commutative" {
  let r = check_int2(name = "min_comm", seed = 42, count = 200, prop = (a: Int, b: Int) -> Bool {
    min(a = a, b = b) == min(a = b, b = a)
  })
  assert(is_ok(result = r))
}

test "prop: max commutative" {
  let r = check_int2(name = "max_comm", seed = 42, count = 200, prop = (a: Int, b: Int) -> Bool {
    max(a = a, b = b) == max(a = b, b = a)
  })
  assert(is_ok(result = r))
}

test "prop: min <= max" {
  let r = check_int2(name = "min<=max", seed = 42, count = 200, prop = (a: Int, b: Int) -> Bool {
    min(a = a, b = b) <= max(a = a, b = b)
  })
  assert(is_ok(result = r))
}

test "prop: gcd divides both" {
  let r = check_nat(name = "gcd_div", seed = 42, count = 200, prop = (n: Int) -> Bool {
    if n == 0 {
      true
    } else {
      let g = gcd(a = n, b = n * 2)
      g > 0 && n % g == 0
    }
  })
  assert(is_ok(result = r))
}

test "prop: even/odd partition" {
  let r = check_int(name = "even_odd", seed = 42, count = 200, prop = (n: Int) -> Bool {
    is_even(n) == not(is_odd(n))
  })
  assert(is_ok(result = r))
}
