//# Imports

import ./hashset.vibe {
  MutSet::add,
  MutSet::delete,
  MutSet::difference,
  MutSet::has,
  MutSet::intersect,
  MutSet::new,
  MutSet::new_int,
  MutSet::new_string,
  MutSet::size,
  MutSet::to_array,
  MutSet::union,
  MutSet::with_capacity,
  struct MutSet
}

//# Helpers

fn sum_of[T](xs: Array[Int]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(xs) {
    total = total + Array::get(xs, i)
    i = i + 1
  }
  total
}

//# Misc

test "empty set" {
  let s: MutSet[Int] = MutSet::new_int()
  assert_eq(MutSet::size(s), 0)
  assert_eq(MutSet::has(s, 0), false)
  assert_eq(MutSet::delete(s, 0), false)
  assert_eq(Array::length(MutSet::to_array(s)), 0)
}

test "single element and duplicate add" {
  let s: MutSet[Int] = MutSet::new_int()
  MutSet::add(s, 5)
  MutSet::add(s, 5)
  MutSet::add(s, 5)
  assert_eq(MutSet::size(s), 1)
  assert_eq(MutSet::has(s, 5), true)
  assert_eq(MutSet::has(s, 6), false)
  let xs = MutSet::to_array(s)
  assert_eq(Array::length(xs), 1)
  assert_eq(Array::get(xs, 0), 5)
}

test "delete then re-add" {
  let s: MutSet[Int] = MutSet::new_int()
  MutSet::add(s, 1)
  MutSet::add(s, 2)
  assert_eq(MutSet::delete(s, 1), true)
  assert_eq(MutSet::delete(s, 1), false)
  assert_eq(MutSet::size(s), 1)
  MutSet::add(s, 1)
  assert_eq(MutSet::size(s), 2)
  assert_eq(MutSet::has(s, 1), true)
}

test "rehash across growth with 250 elements" {
  let s: MutSet[Int] = MutSet::new_int()
  let mut i = 0
  while i < 250 {
    MutSet::add(s, i * 3)
    i = i + 1
  }
  assert_eq(MutSet::size(s), 250)
  let mut j = 0
  while j < 250 {
    assert_eq(MutSet::has(s, j * 3), true)
    j = j + 1
  }
  assert_eq(MutSet::has(s, 1), false)
  assert_eq(MutSet::has(s, 250 * 3), false)
  // to_array covers everything exactly once (check by sum)
  let xs = MutSet::to_array(s)
  assert_eq(Array::length(xs), 250)
  assert_eq(sum_of(xs), 3 * 249 * 250 / 2)
}

test "string set specialization" {
  let s: MutSet[String] = MutSet::new_string()
  MutSet::add(s, "alpha")
  MutSet::add(s, "beta")
  MutSet::add(s, "alpha")
  MutSet::add(s, "")
  assert_eq(MutSet::size(s), 3)
  assert_eq(MutSet::has(s, "alpha"), true)
  assert_eq(MutSet::has(s, ""), true)
  assert_eq(MutSet::has(s, "gamma"), false)
  assert_eq(MutSet::delete(s, "beta"), true)
  assert_eq(MutSet::size(s), 2)
}

test "union intersect difference" {
  let a: MutSet[Int] = MutSet::new_int()
  let b: MutSet[Int] = MutSet::new_int()
  let mut i = 0
  while i < 10 {
    MutSet::add(a, i)
    // a = {0..9}
    MutSet::add(b, i + 5)
    // b = {5..14}
    i = i + 1
  }
  let u = MutSet::union(a, b)
  assert_eq(MutSet::size(u), 15)
  assert_eq(MutSet::has(u, 0), true)
  assert_eq(MutSet::has(u, 14), true)
  assert_eq(MutSet::has(u, 15), false)
  let n = MutSet::intersect(a, b)
  assert_eq(MutSet::size(n), 5)
  assert_eq(MutSet::has(n, 5), true)
  assert_eq(MutSet::has(n, 9), true)
  assert_eq(MutSet::has(n, 4), false)
  assert_eq(MutSet::has(n, 10), false)
  let d = MutSet::difference(a, b)
  assert_eq(MutSet::size(d), 5)
  assert_eq(MutSet::has(d, 0), true)
  assert_eq(MutSet::has(d, 4), true)
  assert_eq(MutSet::has(d, 5), false)
  // operands are untouched
  assert_eq(MutSet::size(a), 10)
  assert_eq(MutSet::size(b), 10)
}

test "set algebra with empty sets" {
  let a: MutSet[Int] = MutSet::new_int()
  let e: MutSet[Int] = MutSet::new_int()
  MutSet::add(a, 1)
  MutSet::add(a, 2)
  assert_eq(MutSet::size(MutSet::union(a, e)), 2)
  assert_eq(MutSet::size(MutSet::union(e, a)), 2)
  assert_eq(MutSet::size(MutSet::intersect(a, e)), 0)
  assert_eq(MutSet::size(MutSet::difference(a, e)), 2)
  assert_eq(MutSet::size(MutSet::difference(e, a)), 0)
}

test "explicit dict generic constructor" {
  let s: MutSet[Int] = MutSet::new((k: Int) -> Int {
    k
  }, (a: Int, b: Int) -> Bool {
    a == b
  })
  MutSet::add(s, 100)
  assert_eq(MutSet::has(s, 100), true)
  let t: MutSet[Int] = MutSet::with_capacity((k: Int) -> Int {
    k
  }, (a: Int, b: Int) -> Bool {
    a == b
  }, 2)
  let mut i = 0
  while i < 40 {
    MutSet::add(t, i)
    i = i + 1
  }
  assert_eq(MutSet::size(t), 40)
}
