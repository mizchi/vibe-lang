//# Imports

import ./hashset.vibe {
  struct MutSet
}

//# Helpers

fn sum_of[T](_ xs: Array[Int]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(xs) {
    total = total + Array::get(xs, at = i)
    i = i + 1
  }
  total
}

//# Misc

test "empty set" {
  let s: MutSet[Int] = MutSet::new_int()
  assert_eq(MutSet::size(s), 0)
  assert_eq(MutSet::has(s, x = 0), false)
  assert_eq(MutSet::delete(s, x = 0), false)
  assert_eq(Array::length(MutSet::to_array(s)), 0)
}

test "single element and duplicate add" {
  let s: MutSet[Int] = MutSet::new_int()
  MutSet::add(s, x = 5)
  MutSet::add(s, x = 5)
  MutSet::add(s, x = 5)
  assert_eq(MutSet::size(s), 1)
  assert_eq(MutSet::has(s, x = 5), true)
  assert_eq(MutSet::has(s, x = 6), false)
  let xs = MutSet::to_array(s)
  assert_eq(Array::length(xs), 1)
  assert_eq(Array::get(xs, at = 0), 5)
}

test "delete then re-add" {
  let s: MutSet[Int] = MutSet::new_int()
  MutSet::add(s, x = 1)
  MutSet::add(s, x = 2)
  assert_eq(MutSet::delete(s, x = 1), true)
  assert_eq(MutSet::delete(s, x = 1), false)
  assert_eq(MutSet::size(s), 1)
  MutSet::add(s, x = 1)
  assert_eq(MutSet::size(s), 2)
  assert_eq(MutSet::has(s, x = 1), true)
}

test "rehash across growth with 250 elements" {
  let s: MutSet[Int] = MutSet::new_int()
  let mut i = 0
  while i < 250 {
    MutSet::add(s, x = i * 3)
    i = i + 1
  }
  assert_eq(MutSet::size(s), 250)
  let mut j = 0
  while j < 250 {
    assert_eq(MutSet::has(s, x = j * 3), true)
    j = j + 1
  }
  assert_eq(MutSet::has(s, x = 1), false)
  assert_eq(MutSet::has(s, x = 250 * 3), false)
  // to_array covers everything exactly once (check by sum)
  let xs = MutSet::to_array(s)
  assert_eq(Array::length(xs), 250)
  assert_eq(sum_of(xs), 3 * 249 * 250 / 2)
}

test "string set specialization" {
  let s: MutSet[String] = MutSet::new_string()
  MutSet::add(s, x = "alpha")
  MutSet::add(s, x = "beta")
  MutSet::add(s, x = "alpha")
  MutSet::add(s, x = "")
  assert_eq(MutSet::size(s), 3)
  assert_eq(MutSet::has(s, x = "alpha"), true)
  assert_eq(MutSet::has(s, x = ""), true)
  assert_eq(MutSet::has(s, x = "gamma"), false)
  assert_eq(MutSet::delete(s, x = "beta"), true)
  assert_eq(MutSet::size(s), 2)
}

test "union intersect difference" {
  let a: MutSet[Int] = MutSet::new_int()
  let b: MutSet[Int] = MutSet::new_int()
  let mut i = 0
  while i < 10 {
    MutSet::add(a, x = i)
    // a = {0..9}
    MutSet::add(b, x = i + 5)
    // b = {5..14}
    i = i + 1
  }
  let u = MutSet::union(a, b = b)
  assert_eq(MutSet::size(u), 15)
  assert_eq(MutSet::has(u, x = 0), true)
  assert_eq(MutSet::has(u, x = 14), true)
  assert_eq(MutSet::has(u, x = 15), false)
  let n = MutSet::intersect(a, b = b)
  assert_eq(MutSet::size(n), 5)
  assert_eq(MutSet::has(n, x = 5), true)
  assert_eq(MutSet::has(n, x = 9), true)
  assert_eq(MutSet::has(n, x = 4), false)
  assert_eq(MutSet::has(n, x = 10), false)
  // Every element is shared, so an intersect that skips the first element it
  // visits (in hash order, whatever that is) comes up one short.
  assert_eq(MutSet::size(MutSet::intersect(a, b = a)), 10)
  let d = MutSet::difference(a, b = b)
  assert_eq(MutSet::size(d), 5)
  assert_eq(MutSet::has(d, x = 0), true)
  assert_eq(MutSet::has(d, x = 4), true)
  assert_eq(MutSet::has(d, x = 5), false)
  // operands are untouched
  assert_eq(MutSet::size(a), 10)
  assert_eq(MutSet::size(b), 10)
}

test "set algebra with empty sets" {
  let a: MutSet[Int] = MutSet::new_int()
  let e: MutSet[Int] = MutSet::new_int()
  MutSet::add(a, x = 1)
  MutSet::add(a, x = 2)
  assert_eq(MutSet::size(MutSet::union(a, b = e)), 2)
  assert_eq(MutSet::size(MutSet::union(e, b = a)), 2)
  assert_eq(MutSet::size(MutSet::intersect(a, b = e)), 0)
  assert_eq(MutSet::size(MutSet::difference(a, b = e)), 2)
  assert_eq(MutSet::size(MutSet::difference(e, b = a)), 0)
}

test "explicit dict generic constructor" {
  let s: MutSet[Int] = MutSet::new(hash_fn = (k: Int) -> Int {
    k
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  })
  MutSet::add(s, x = 100)
  assert_eq(MutSet::has(s, x = 100), true)
  let t: MutSet[Int] = MutSet::with_capacity(hash_fn = (k: Int) -> Int {
    k
  }, eq_fn = (a: Int, b: Int) -> Bool {
    a == b
  }, capacity = 2)
  let mut i = 0
  while i < 40 {
    MutSet::add(t, x = i)
    i = i + 1
  }
  assert_eq(MutSet::size(t), 40)
}
