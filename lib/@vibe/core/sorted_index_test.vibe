//# Imports

import ./sorted_index.vibe {
  apply_perm_strings, bsearch_leftmost, sort_perm_by_names, sorted_names_of, str_lt
}

//# Misc

test "str_lt is lexicographic, not length-first" {
  assert(str_lt(a = "a", b = "aa"))
  assert(str_lt(a = "ab", b = "b"))
  assert(!str_lt(a = "b", b = "ab"))
  assert(!str_lt(a = "same", b = "same"))
}

test "sort_perm_by_names is stable on equal keys" {
  let names = ["b", "a", "b", "c"]
  let perm = sort_perm_by_names(names)
  assert(eq(Array::length(perm), 4))
  assert(eq(Array::get(perm, at = 0), 1))
  assert(eq(Array::get(perm, at = 1), 0))
  assert(eq(Array::get(perm, at = 2), 2))
  assert(eq(Array::get(perm, at = 3), 3))
}

test "sort_perm_by_names merges an exhausted left run and a short tail" {
  // [a c][b d]: the left run empties while the right still holds two, so the
  // merge must keep drawing from the right. Five names leave a one-element
  // tail run at every width. Neither shape appears in the test above.
  assert(sort_perm_by_names(["a", "c", "b", "d"]) == [0, 2, 1, 3])
  assert(sort_perm_by_names(["e", "d", "c", "b", "a"]) == [4, 3, 2, 1, 0])
}

test "bsearch_leftmost returns the leftmost equal slot" {
  let sorted = ["a", "b", "b", "c"]
  assert(eq(bsearch_leftmost(sorted = sorted, name = "b"), 1))
  assert(eq(bsearch_leftmost(sorted = sorted, name = "a"), 0))
  assert(eq(bsearch_leftmost(sorted = sorted, name = "missing"), -1))
}

test "sorted_names_of and apply_perm_strings agree" {
  let names = ["z", "m", "a"]
  let sorted = sorted_names_of(names)
  let via_perm = apply_perm_strings(names = names, perm = sort_perm_by_names(names))
  assert(eq(Array::get(sorted, at = 0), "a"))
  assert(eq(Array::get(sorted, at = 1), "m"))
  assert(eq(Array::get(sorted, at = 2), "z"))
  assert(eq(Array::get(via_perm, at = 0), Array::get(sorted, at = 0)))
  assert(eq(Array::get(via_perm, at = 1), Array::get(sorted, at = 1)))
  assert(eq(Array::get(via_perm, at = 2), Array::get(sorted, at = 2)))
}

test "preallocated permutations retain empty and singleton semantics" {
  let empty = sort_perm_by_names([])
  assert(Array::length(empty) == 0)
  let single = sort_perm_by_names(["one"])
  assert(Array::length(single) == 1)
  assert(Array::get(single, at = 0) == 0)
  let reordered = apply_perm_strings(names = [], perm = empty)
  assert(Array::length(reordered) == 0)
}

fn preallocated_temporary_names() -> Array[String] {
  let names = [String::concat("z", "ebra"), String::concat("a", "pple")]
  let sorted = apply_perm_strings(names = names, perm = sort_perm_by_names(names))
  Array::set(names, at = 0, value = "changed")
  sorted
}

test "preallocated reordered strings survive caller mutation and temporary inputs" {
  let names = preallocated_temporary_names()
  let pressure: Array[String] = []
  let mut i = 0
  while i < 200 {
    Array::push(pressure, value = String::concat("replacement", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(pressure) == 200)
  assert(Array::length(names) == 2)
  assert(Array::get(names, at = 0) == "apple")
  assert(Array::get(names, at = 1) == "zebra")
}
