//# Imports

import ./sorted_index.vibe {
  apply_perm_strings, bsearch_leftmost, sort_perm_by_names, sorted_names_of, str_lt
}

//# Misc

test "str_lt is lexicographic, not length-first" {
  assert(str_lt("a", "aa"))
  assert(str_lt("ab", "b"))
  assert(!str_lt("b", "ab"))
  assert(!str_lt("same", "same"))
}

test "sort_perm_by_names is stable on equal keys" {
  let names = ["b", "a", "b", "c"]
  let perm = sort_perm_by_names(names)
  assert(eq(Array::length(perm), 4))
  assert(eq(Array::get(perm, 0), 1))
  assert(eq(Array::get(perm, 1), 0))
  assert(eq(Array::get(perm, 2), 2))
  assert(eq(Array::get(perm, 3), 3))
}

test "bsearch_leftmost returns the leftmost equal slot" {
  let sorted = ["a", "b", "b", "c"]
  assert(eq(bsearch_leftmost(sorted, "b"), 1))
  assert(eq(bsearch_leftmost(sorted, "a"), 0))
  assert(eq(bsearch_leftmost(sorted, "missing"), -1))
}

test "sorted_names_of and apply_perm_strings agree" {
  let names = ["z", "m", "a"]
  let sorted = sorted_names_of(names)
  let via_perm = apply_perm_strings(names, sort_perm_by_names(names))
  assert(eq(Array::get(sorted, 0), "a"))
  assert(eq(Array::get(sorted, 1), "m"))
  assert(eq(Array::get(sorted, 2), "z"))
  assert(eq(Array::get(via_perm, 0), Array::get(sorted, 0)))
  assert(eq(Array::get(via_perm, 1), Array::get(sorted, 1)))
  assert(eq(Array::get(via_perm, 2), Array::get(sorted, 2)))
}

test "preallocated permutations retain empty and singleton semantics" {
  let empty = sort_perm_by_names([])
  assert(Array::length(empty) == 0)
  let single = sort_perm_by_names(["one"])
  assert(Array::length(single) == 1)
  assert(Array::get(single, 0) == 0)
  let reordered = apply_perm_strings([], empty)
  assert(Array::length(reordered) == 0)
}

fn preallocated_temporary_names() -> Array[String] {
  let names = [String::concat("z", "ebra"), String::concat("a", "pple")]
  let sorted = apply_perm_strings(names, sort_perm_by_names(names))
  Array::set(names, 0, "changed")
  sorted
}

test "preallocated reordered strings survive caller mutation and temporary inputs" {
  let names = preallocated_temporary_names()
  let pressure: Array[String] = []
  let mut i = 0
  while i < 200 {
    Array::push(pressure, String::concat("replacement", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(pressure) == 200)
  assert(Array::length(names) == 2)
  assert(Array::get(names, 0) == "apple")
  assert(Array::get(names, 1) == "zebra")
}
