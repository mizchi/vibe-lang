//# Imports

import ./assert.vibe {
  assert_false, inspect
}

//# Misc

test "assert_false passes on a false condition" {
  assert_false(1 == 2)
  assert_false(false)
}

test "inspect passes when the stringified value matches content" {
  inspect(1 + 1, "2", int_key)
  inspect("abc", "abc", (s: String) -> String {
    s
  })
}

test "#2840: imported inspect uses the explicit renderer for Bool" {
  inspect(true, "yes", (value: Bool) -> String {
    if value {
      "yes"
    } else {
      "no"
    }
  })
}

fn int_key(value: Int) -> String {
  Int::to_string(value)
}
