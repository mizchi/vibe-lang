//# @vibe/core/sha256 — SHA-256 digest (FIPS 180-4), lowercase hex.
//# 32-bit words are emulated on the 63-bit tagged Int and folded back with
//# `sha256_mask32`, the same way sha1.vibe and @vibe/blake3 do. The input is
//# a byte string (ADR-0098), read one byte per `String::byte_at`.

//# Constants

let sha256_mask32: Int = 0xFFFFFFFF

let sha256_hex_table: String = "0123456789abcdef"

/// The 64 round constants: the first 32 bits of the fractional parts of the
/// cube roots of the first 64 primes.
fn sha256_round_constants() -> Array[Int] {
  [
    0x428A2F98,
    0x71374491,
    0xB5C0FBCF,
    0xE9B5DBA5,
    0x3956C25B,
    0x59F111F1,
    0x923F82A4,
    0xAB1C5ED5,
    0xD807AA98,
    0x12835B01,
    0x243185BE,
    0x550C7DC3,
    0x72BE5D74,
    0x80DEB1FE,
    0x9BDC06A7,
    0xC19BF174,
    0xE49B69C1,
    0xEFBE4786,
    0x0FC19DC6,
    0x240CA1CC,
    0x2DE92C6F,
    0x4A7484AA,
    0x5CB0A9DC,
    0x76F988DA,
    0x983E5152,
    0xA831C66D,
    0xB00327C8,
    0xBF597FC7,
    0xC6E00BF3,
    0xD5A79147,
    0x06CA6351,
    0x14292967,
    0x27B70A85,
    0x2E1B2138,
    0x4D2C6DFC,
    0x53380D13,
    0x650A7354,
    0x766A0ABB,
    0x81C2C92E,
    0x92722C85,
    0xA2BFE8A1,
    0xA81A664B,
    0xC24B8B70,
    0xC76C51A3,
    0xD192E819,
    0xD6990624,
    0xF40E3585,
    0x106AA070,
    0x19A4C116,
    0x1E376C08,
    0x2748774C,
    0x34B0BCB5,
    0x391C0CB3,
    0x4ED8AA4A,
    0x5B9CCA4F,
    0x682E6FF3,
    0x748F82EE,
    0x78A5636F,
    0x84C87814,
    0x8CC70208,
    0x90BEFFFA,
    0xA4506CEB,
    0xBEF9A3F7,
    0xC67178F2
  ]
}

/// The initial hash value: the first 32 bits of the fractional parts of the
/// square roots of the first 8 primes.
fn sha256_initial_state() -> Array[Int] {
  [
    0x6A09E667,
    0xBB67AE85,
    0x3C6EF372,
    0xA54FF53A,
    0x510E527F,
    0x9B05688C,
    0x1F83D9AB,
    0x5BE0CD19
  ]
}

//# Word helpers

/// Rotate a 32-bit word right by n (1 <= n <= 31). `x` is always kept in
/// [0, 2^32), so the arithmetic `>>` is the logical one.
fn sha256_rotr(x: Int, n: Int) -> Int {
  ((x>>n)|(x<<(32 - n)))&sha256_mask32
}

fn sha256_add(a: Int, b: Int) -> Int {
  (a + b)&sha256_mask32
}

fn sha256_byte_hex(_ b: Int) -> String {
  String::concat(String::substring(sha256_hex_table, start = (b>>4)&15, end = ((b>>4)&15) + 1), String::substring(sha256_hex_table, start = b&15, end = (b&15) + 1))
}

fn sha256_push_word_hex(sb: StringBuilder, w: Int) -> Unit {
  StringBuilder::push(sb, value = sha256_byte_hex((w>>24)&255))
  StringBuilder::push(sb, value = sha256_byte_hex((w>>16)&255))
  StringBuilder::push(sb, value = sha256_byte_hex((w>>8)&255))
  StringBuilder::push(sb, value = sha256_byte_hex(w&255))
}

//# Padding

/// Pad to a multiple of 64 bytes: a 0x80 byte, zeros, then the 64-bit
/// big-endian bit length.
fn sha256_pad(_ msg: String) -> String {
  let len = String::length(msg)
  let bit_len = len * 8
  let sb = StringBuilder::new()
  StringBuilder::push(sb, value = msg)
  StringBuilder::push(sb, value = String::from_byte(128))
  let mut cur = len + 1
  while cur % 64 != 56 {
    StringBuilder::push(sb, value = String::from_byte(0))
    cur = cur + 1
  }
  let mut shift = 56
  while shift >= 0 {
    StringBuilder::push(sb, value = String::from_byte((bit_len>>shift)&255))
    shift = shift - 8
  }
  StringBuilder::freeze(sb)
}

//# Compression

/// Run one 64-byte block starting at `start` through the compression
/// function, updating `h` in place. `w` is the 64-word schedule scratch.
fn sha256_block(padded: String, start: Int, h: Array[Int], w: Array[Int], k: Array[Int]) -> Unit {
  let mut i = 0
  while i < 16 {
    let o = start + i * 4
    let b0 = String::byte_at(padded, at = o)
    let b1 = String::byte_at(padded, at = o + 1)
    let b2 = String::byte_at(padded, at = o + 2)
    let b3 = String::byte_at(padded, at = o + 3)
    Int64Array::set(w, at = i, value = ((b0<<24)|(b1<<16)|(b2<<8)|b3)&sha256_mask32)
    i = i + 1
  }
  while i < 64 {
    let w15 = Int64Array::get(w, at = i - 15)
    let w2 = Int64Array::get(w, at = i - 2)
    let s0 = sha256_rotr(x = w15, n = 7)^sha256_rotr(x = w15, n = 18)^(w15>>3)
    let s1 = sha256_rotr(x = w2, n = 17)^sha256_rotr(x = w2, n = 19)^(w2>>10)
    Int64Array::set(w, at = i, value = sha256_add(a = sha256_add(a = Int64Array::get(w, at = i - 16), b = s0), b = sha256_add(a = Int64Array::get(w, at = i - 7), b = s1)))
    i = i + 1
  }
  let mut a = Int64Array::get(h, at = 0)
  let mut b = Int64Array::get(h, at = 1)
  let mut c = Int64Array::get(h, at = 2)
  let mut d = Int64Array::get(h, at = 3)
  let mut e = Int64Array::get(h, at = 4)
  let mut f = Int64Array::get(h, at = 5)
  let mut g = Int64Array::get(h, at = 6)
  let mut hh = Int64Array::get(h, at = 7)
  let mut r = 0
  while r < 64 {
    let big_s1 = sha256_rotr(x = e, n = 6)^sha256_rotr(x = e, n = 11)^sha256_rotr(x = e, n = 25)
    let ch = (e&f)^((e^sha256_mask32)&g)
    let t1 = sha256_add(a = sha256_add(a = sha256_add(a = hh, b = big_s1), b = sha256_add(a = ch, b = Int64Array::get(k, at = r))), b = Int64Array::get(w, at = r))
    let big_s0 = sha256_rotr(x = a, n = 2)^sha256_rotr(x = a, n = 13)^sha256_rotr(x = a, n = 22)
    let maj = (a&b)^(a&c)^(b&c)
    let t2 = sha256_add(a = big_s0, b = maj)
    hh = g
    g = f
    f = e
    e = sha256_add(a = d, b = t1)
    d = c
    c = b
    b = a
    a = sha256_add(a = t1, b = t2)
    r = r + 1
  }
  Int64Array::set(h, at = 0, value = sha256_add(a = Int64Array::get(h, at = 0), b = a))
  Int64Array::set(h, at = 1, value = sha256_add(a = Int64Array::get(h, at = 1), b = b))
  Int64Array::set(h, at = 2, value = sha256_add(a = Int64Array::get(h, at = 2), b = c))
  Int64Array::set(h, at = 3, value = sha256_add(a = Int64Array::get(h, at = 3), b = d))
  Int64Array::set(h, at = 4, value = sha256_add(a = Int64Array::get(h, at = 4), b = e))
  Int64Array::set(h, at = 5, value = sha256_add(a = Int64Array::get(h, at = 5), b = f))
  Int64Array::set(h, at = 6, value = sha256_add(a = Int64Array::get(h, at = 6), b = g))
  Int64Array::set(h, at = 7, value = sha256_add(a = Int64Array::get(h, at = 7), b = hh))
}

//# Entry

/// SHA-256 of a byte string, as 64 lowercase hex characters.
export fn sha256(_ msg: String) -> String {
  let padded = sha256_pad(msg)
  let h = sha256_initial_state()
  let w = Int64Array::make(64, value = 0)
  let k = sha256_round_constants()
  let blocks = String::length(padded) / 64
  let mut i = 0
  while i < blocks {
    sha256_block(padded = padded, start = i * 64, h = h, w = w, k = k)
    i = i + 1
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < 8 {
    sha256_push_word_hex(sb = sb, w = Int64Array::get(h, at = j))
    j = j + 1
  }
  StringBuilder::freeze(sb)
}
