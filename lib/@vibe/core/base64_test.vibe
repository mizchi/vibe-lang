//# Imports

import ./base64.vibe {
  decode, encode, encode_url_safe
}

//# Misc

test "encode empty" {
  assert(encode("") == "")
}

test "encode single char" {
  assert(encode("A") == "QQ==")
}

test "encode two chars" {
  assert(encode("AB") == "QUI=")
}

test "encode three chars" {
  assert(encode("ABC") == "QUJD")
}

test "encode hello" {
  assert(encode("Hello") == "SGVsbG8=")
}

test "encode hello world" {
  assert(encode("Hello, World!") == "SGVsbG8sIFdvcmxkIQ==")
}

test "encode foobar incremental" {
  assert(encode("f") == "Zg==")
  assert(encode("fo") == "Zm8=")
  assert(encode("foo") == "Zm9v")
  assert(encode("foob") == "Zm9vYg==")
  assert(encode("fooba") == "Zm9vYmE=")
  assert(encode("foobar") == "Zm9vYmFy")
}

test "decode empty" {
  assert(decode("") == "")
}

test "decode hello" {
  assert(decode("SGVsbG8=") == "Hello")
}

test "decode hello world" {
  assert(decode("SGVsbG8sIFdvcmxkIQ==") == "Hello, World!")
}

test "decode foobar incremental" {
  assert(decode("Zg==") == "f")
  assert(decode("Zm8=") == "fo")
  assert(decode("Zm9v") == "foo")
  assert(decode("Zm9vYg==") == "foob")
  assert(decode("Zm9vYmE=") == "fooba")
  assert(decode("Zm9vYmFy") == "foobar")
}

test "roundtrip ascii" {
  let input = "The quick brown fox jumps over the lazy dog"
  assert(decode(encode(input)) == input)
}

test "roundtrip numbers" {
  let input = "0123456789"
  assert(decode(encode(input)) == input)
}

test "encode_url_safe" {
  // Standard base64 uses + and /, URL-safe uses - and _
  // Also strips padding =
  let result = encode_url_safe("Hello, World!")
  assert(not(String::contains(result, "+")))
  assert(not(String::contains(result, "/")))
  assert(not(String::contains(result, "=")))
}
