//# Imports

import ./base64.vibe {
  decode, encode, encode_url_safe
}

//# Misc

// RFC 4648 section 10 test vectors. The single-purpose encode/decode tests
// this file used to carry (empty, "A", "AB", "ABC", "Hello", ...) killed no
// mutant of base64.vibe that these vectors and the cases below do not.

test "encode foobar incremental" {
  assert(encode("") == "")
  assert(encode("f") == "Zg==")
  assert(encode("fo") == "Zm8=")
  assert(encode("foo") == "Zm9v")
  assert(encode("foob") == "Zm9vYg==")
  assert(encode("fooba") == "Zm9vYmE=")
  assert(encode("foobar") == "Zm9vYmFy")
}

test "decode foobar incremental" {
  assert(decode("") == "")
  assert(decode("Zg==") == "f")
  assert(decode("Zm8=") == "fo")
  assert(decode("Zm9v") == "foo")
  assert(decode("Zm9vYg==") == "foob")
  assert(decode("Zm9vYmE=") == "fooba")
  assert(decode("Zm9vYmFy") == "foobar")
}

test "roundtrip ascii" {
  let input = "The quick brown fox jumps over the lazy dog"
  assert(decode(encode(input)) == input)
}

test "encode_url_safe maps + and / and drops padding" {
  // ">>>???" encodes to "Pj4+Pz8/" and "??" to "Pz8=": each URL-safe
  // substitution, and the padding, is visible in the expected text.
  assert(encode_url_safe(">>>???") == "Pj4-Pz8_")
  assert(encode_url_safe("??") == "Pz8")
  assert(encode_url_safe("Hello") == "SGVsbG8")
}

test "decode reaches every alphabet range and both symbols" {
  // "YXA0" holds an `A` in the third place and a `0`; "YWFA" an `A` in the
  // fourth; "Pj4+Pz8/" both symbols. A decoder off by one at a range edge
  // or missing a symbol gets one of these wrong.
  assert(decode("YXA0") == "ap4")
  assert(decode("YWFA") == "aa@")
  assert(decode("Pj4+Pz8/") == ">>>???")
}

test "decode accepts input with the padding left off" {
  assert(decode("Zm8") == "fo")
  assert(decode("Zg") == "f")
}
