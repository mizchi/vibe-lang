// Linear-allocator observation. The portable map/set semantics and hash
// counts are covered separately in hashmap_insert_test.vibe, also on wasm-gc.
import @vibe/core {
  struct MutMap
}

test "a duplicate at the growth boundary allocates no replacement or table" {
  let m: MutMap[Int, Int] = MutMap::with_capacity_int(8)
  let mut i = 0
  while i < 5 {
    assert(MutMap::insert_if_absent(m, i, i))
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  let inserted = MutMap::insert_if_absent(m, 4, 99)
  let after = Profiler::heap_bytes()
  assert(!inserted)
  assert(after == before)
}
