//# Imports

import ./diff.vibe {
  count_additions, count_deletions, diff_lines, format_unified, has_changes
}

//# Fixtures

// 200 near-identical lines with one changed line near the end: exercises
// format_unified's output-assembly cost at a size where an O(N^2) string
// accumulator (vs. StringBuilder) is measurable, unlike the tiny fixtures
// above.
fn repeat_line(line: String, n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, line)
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

let large_old: String = repeat_line("line\n", 200)

let large_new: String = {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, repeat_line("line\n", 199))
  StringBuilder::push(sb, "changed\n")
  StringBuilder::freeze(sb)
}

//# Misc

bench "diff/identical_short" {
  let _ = diff_lines("a\nb\nc", "a\nb\nc")
}

bench "diff/single_addition" {
  let _ = diff_lines("a\nb", "a\nb\nc")
}

bench "diff/single_deletion" {
  let _ = diff_lines("a\nb\nc", "a\nb")
}

bench "diff/modification" {
  let _ = diff_lines("a\nb\nc\nd\ne", "a\nB\nc\nD\ne")
}

bench "diff/format_unified" {
  let ops = diff_lines("a\nb\nc", "a\nx\nc")
  let _ = format_unified(ops)
}

bench "diff/format_unified_large" {
  let ops = diff_lines(large_old, large_new)
  let _ = format_unified(ops)
}
