//# Imports

import ./diff.vibe {
  count_additions, count_deletions, diff_lines, format_unified, has_changes
}

//# Misc

bench "diff/identical_short" {
  let _ = diff_lines(old_text = "a\nb\nc", new_text = "a\nb\nc")
}

bench "diff/single_addition" {
  let _ = diff_lines(old_text = "a\nb", new_text = "a\nb\nc")
}

bench "diff/single_deletion" {
  let _ = diff_lines(old_text = "a\nb\nc", new_text = "a\nb")
}

bench "diff/modification" {
  let _ = diff_lines(old_text = "a\nb\nc\nd\ne", new_text = "a\nB\nc\nD\ne")
}

bench "diff/format_unified" {
  let ops = diff_lines(old_text = "a\nb\nc", new_text = "a\nx\nc")
  let _ = format_unified(ops)
}
