//# Imports

import ./diff.vibe {
  type DiffOp, count_additions, count_deletions, diff_lines, format_unified, has_changes
}

//# Setup

// Fixed-size fixture for format_unified_large, built once at module init so
// the bench body measures only format_unified itself (not the fixture).
fn build_numbered_lines(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, "line \{i} content")
    if i < n - 1 {
      StringBuilder::push(sb, "\n")
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

let large_ops: Array[DiffOp] = diff_lines(build_numbered_lines(300), build_numbered_lines(300))

//# Misc

bench "diff/identical_short" {
  let _ = diff_lines("a\nb\nc", "a\nb\nc")
}

bench "diff/single_addition" {
  let _ = diff_lines("a\nb", "a\nb\nc")
}

bench "diff/single_deletion" {
  let _ = diff_lines("a\nb\nc", "a\nb")
}

bench "diff/modification" {
  let _ = diff_lines("a\nb\nc\nd\ne", "a\nB\nc\nD\ne")
}

bench "diff/format_unified" {
  let ops = diff_lines("a\nb\nc", "a\nx\nc")
  let _ = format_unified(ops)
}

bench "diff/format_unified_large" {
  let _ = format_unified(large_ops)
}
