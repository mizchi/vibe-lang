//# Imports

import ./array.vibe {
  Array::make, Array::make_with, array_empty
}

//# Misc

test "array_empty starts at length 0" {
  let a: Array[Int] = array_empty()
  assert(eq(Array::length(a), 0))
}

test "array_empty is a normal mutable array afterwards" {
  let a: Array[Int] = array_empty()
  Array::push(a, value = 1)
  Array::push(a, value = 2)
  assert(eq(Array::length(a), 2))
  assert(eq(Array::get(a, at = 0), 1))
  assert(eq(Array::get(a, at = 1), 2))
}

test "array_empty infers its element type from usage" {
  let a: Array[String] = array_empty()
  Array::push(a, value = "x")
  assert(eq(Array::get(a, at = 0), "x"))
}

test "Array::make fills n slots with the given init, not a pusher later" {
  let a = Array::make(n = 4, init = 0)
  assert(eq(Array::length(a), 4))
  assert(eq(Array::get(a, at = 0), 0))
  assert(eq(Array::get(a, at = 3), 0))
  Array::set(a, at = 0, value = 99)
  assert(eq(Array::get(a, at = 1), 0))
  assert(eq(Array::get(a, at = 2), 0))
  assert(eq(Array::get(a, at = 3), 0))
}

test "Array::make of None is the shared empty-slot encoding" {
  let none_slot: Option[Int] = None
  let a = Array::make(n = 3, init = none_slot)
  assert(eq(Array::length(a), 3))
  assert(Array::get(a, at = 0) is None)
  assert(Array::get(a, at = 2) is None)
  Array::set(a, at = 1, value = Some(7))
  assert(Array::get(a, at = 0) is None)
  assert(Array::get(a, at = 1) == Some(7))
}

test "Array::make n<=0 is empty" {
  let a: Array[Int] = Array::make(n = 0, init = 1)
  assert(eq(Array::length(a), 0))
  let b: Array[Int] = Array::make(n = 0 - 3, init = 1)
  assert(eq(Array::length(b), 0))
  // The smallest non-empty size: a bound off by one at the bottom drops it.
  let c: Array[Int] = Array::make(n = 1, init = 7)
  assert(eq(Array::length(c), 1))
  assert(eq(Array::get(c, at = 0), 7))
}

test "Array::make_with n<=0 is empty and never calls f" {
  let a: Array[Int] = Array::make_with(n = 0, f = (i: Int) -> i)
  assert(eq(Array::length(a), 0))
  let b: Array[Int] = Array::make_with(n = 0 - 2, f = (i: Int) -> i)
  assert(eq(Array::length(b), 0))
}

test "Array::make_with fills by index" {
  let a = Array::make_with(n = 4, f = (i: Int) -> i * 10)
  assert(eq(Array::length(a), 4))
  assert(eq(Array::get(a, at = 0), 0))
  assert(eq(Array::get(a, at = 1), 10))
  assert(eq(Array::get(a, at = 3), 30))
}

test "make preserves a shared heap initializer and remains growable" {
  let init = [4]
  let made = Array::make(n = 3, init = init)
  Array::push(Array::get(made, at = 0), value = 9)
  assert(Array::get(made, at = 2) == [4, 9])
  Array::push(made, value = [17])
  assert(Array::length(made) == 4)
  assert(Array::get(made, at = 3) == [17])
}

test "make_with calls each index in order and preserves independent values" {
  let order: Array[Int] = []
  let made = Array::make_with(n = 4, f = (i: Int) -> {
    Array::push(order, value = i)
    [i]
  })
  assert(order == [0, 1, 2, 3])
  Array::push(Array::get(made, at = 0), value = 9)
  assert(Array::get(made, at = 0) == [0, 9])
  assert(Array::get(made, at = 1) == [1])
  Array::push(made, value = [23])
  assert(Array::get(made, at = 4) == [23])
  let empty = Array::make_with(n = -3, f = (i: Int) -> {
    Array::push(order, value = i)
    [i]
  })
  assert(Array::length(empty) == 0)
  assert(order == [0, 1, 2, 3])
}
