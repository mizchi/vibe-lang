//# Imports

import ./array.vibe {
  array_empty
}

//# Misc

test "array_empty starts at length 0" {
  let a: Array[Int] = array_empty()
  assert(eq(Array::length(a), 0))
}

test "array_empty is a normal mutable array afterwards" {
  let a: Array[Int] = array_empty()
  Array::push(a, 1)
  Array::push(a, 2)
  assert(eq(Array::length(a), 2))
  assert(eq(Array::get(a, 0), 1))
  assert(eq(Array::get(a, 1), 2))
}

test "array_empty infers its element type from usage" {
  let a: Array[String] = array_empty()
  Array::push(a, "x")
  assert(eq(Array::get(a, 0), "x"))
}
