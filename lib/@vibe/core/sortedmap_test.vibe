//# Imports

import ./sortedmap.vibe {
  MutSortedMap::delete,
  MutSortedMap::get,
  MutSortedMap::has,
  MutSortedMap::keys,
  MutSortedMap::max,
  MutSortedMap::min,
  MutSortedMap::new,
  MutSortedMap::new_int,
  MutSortedMap::new_string,
  MutSortedMap::range,
  MutSortedMap::set,
  MutSortedMap::size,
  MutSortedMap::to_array,
  MutSortedMap::values,
  struct MutSortedMap
}
import ./key.vibe {
  compare_int, compare_string
}

//# Helpers

fn get_or[K, V](m: MutSortedMap[K, V], k: K, dflt: V) -> V {
  match MutSortedMap::get(m, k) {
    Some(v) => v,
    None => dflt
  }
}

fn is_ascending_ints(xs: Array[Int]) -> Bool {
  let mut ok = true
  let mut i = 1
  while i < Array::length(xs) {
    if Array::get(xs, i - 1) >= Array::get(xs, i) {
      ok = false
    }
    i = i + 1
  }
  ok
}

//# Misc

test "String comparator is lexical and normalized" {
  assert(compare_string("a", "aa") == -1)
  assert(compare_string("aa", "a") == 1)
  assert(compare_string("ab", "b") == -1)
  assert(compare_string("b", "ab") == 1)
  assert(compare_string("same", "same") == 0)
}

test "empty map" {
  let m: MutSortedMap[Int, String] = MutSortedMap::new_int()
  assert_eq(MutSortedMap::size(m), 0)
  assert_eq(MutSortedMap::has(m, 1), false)
  assert_eq(MutSortedMap::delete(m, 1), false)
  assert_eq(Array::length(MutSortedMap::keys(m)), 0)
  match MutSortedMap::min(m) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
  match MutSortedMap::max(m) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}

test "single element" {
  let m: MutSortedMap[Int, String] = MutSortedMap::new_int()
  MutSortedMap::set(m, 5, "five")
  assert_eq(MutSortedMap::size(m), 1)
  assert_eq(get_or(m, 5, "?"), "five")
  match MutSortedMap::min(m) {
    Some(kv) => {
      let (k, v) = kv
      assert_eq(k, 5)
      assert_eq(v, "five")
    },
    None => assert_eq(1, 2)
  }
  match MutSortedMap::max(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, 5)
    },
    None => assert_eq(1, 2)
  }
}

test "duplicate set overwrites" {
  let m: MutSortedMap[Int, Int] = MutSortedMap::new_int()
  MutSortedMap::set(m, 3, 30)
  MutSortedMap::set(m, 3, 31)
  assert_eq(MutSortedMap::size(m), 1)
  assert_eq(get_or(m, 3, -1), 31)
}

test "random insertion yields ascending keys" {
  let m: MutSortedMap[Int, Int] = MutSortedMap::new_int()
  // pseudo-random permutation of 0..150: i -> (i * 37) % 151
  let mut i = 0
  while i < 151 {
    let k = (i * 37) % 151
    MutSortedMap::set(m, k, k * 2)
    i = i + 1
  }
  assert_eq(MutSortedMap::size(m), 151)
  let ks = MutSortedMap::keys(m)
  assert_eq(Array::length(ks), 151)
  assert_eq(is_ascending_ints(ks), true)
  assert_eq(Array::get(ks, 0), 0)
  assert_eq(Array::get(ks, 150), 150)
  // every key readable
  let mut j = 0
  while j < 151 {
    assert_eq(get_or(m, j, -1), j * 2)
    j = j + 1
  }
  // values come out in key order
  let vs = MutSortedMap::values(m)
  assert_eq(Array::get(vs, 0), 0)
  assert_eq(Array::get(vs, 150), 300)
  // min / max
  match MutSortedMap::min(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, 0)
    },
    None => assert_eq(1, 2)
  }
  match MutSortedMap::max(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, 150)
    },
    None => assert_eq(1, 2)
  }
}

test "delete keeps order and balance" {
  let m: MutSortedMap[Int, Int] = MutSortedMap::new_int()
  let mut i = 0
  while i < 100 {
    MutSortedMap::set(m, i, i)
    i = i + 1
  }
  // delete every third key (0, 3, 6, ...)
  let mut d = 0
  while d < 100 {
    assert_eq(MutSortedMap::delete(m, d), true)
    d = d + 3
  }
  assert_eq(MutSortedMap::delete(m, 0), false)
  assert_eq(MutSortedMap::size(m), 66)
  let ks = MutSortedMap::keys(m)
  assert_eq(Array::length(ks), 66)
  assert_eq(is_ascending_ints(ks), true)
  // survivors intact, deleted gone
  assert_eq(MutSortedMap::has(m, 1), true)
  assert_eq(MutSortedMap::has(m, 3), false)
  assert_eq(MutSortedMap::has(m, 99), false)
  assert_eq(MutSortedMap::has(m, 98), true)
  // delete down to empty
  let mut r = 0
  while r < 100 {
    MutSortedMap::delete(m, r)
    r = r + 1
  }
  assert_eq(MutSortedMap::size(m), 0)
  match MutSortedMap::min(m) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
  // reinsert after emptying works
  MutSortedMap::set(m, 42, 1)
  assert_eq(MutSortedMap::size(m), 1)
  assert_eq(get_or(m, 42, -1), 1)
}

test "range boundaries" {
  let m: MutSortedMap[Int, Int] = MutSortedMap::new_int()
  let mut i = 0
  while i < 20 {
    MutSortedMap::set(m, i * 2, i)
    // keys 0, 2, ..., 38
    i = i + 1
  }
  // inclusive on both ends
  let r1 = MutSortedMap::range(m, 4, 10)
  assert_eq(Array::length(r1), 4)
  // 4, 6, 8, 10
  let (k0, _) = Array::get(r1, 0)
  assert_eq(k0, 4)
  let (k3, _) = Array::get(r1, 3)
  assert_eq(k3, 10)
  // bounds not present in the map
  let r2 = MutSortedMap::range(m, 3, 9)
  assert_eq(Array::length(r2), 3)
  // 4, 6, 8
  // full cover
  let r3 = MutSortedMap::range(m, -100, 100)
  assert_eq(Array::length(r3), 20)
  // empty window between keys
  let r4 = MutSortedMap::range(m, 39, 100)
  assert_eq(Array::length(r4), 0)
  // inverted bounds
  let r5 = MutSortedMap::range(m, 10, 4)
  assert_eq(Array::length(r5), 0)
  // single-point range on a present key
  let r6 = MutSortedMap::range(m, 8, 8)
  assert_eq(Array::length(r6), 1)
  // ascending inside the range
  let mut a = 1
  let mut asc = true
  while a < Array::length(r3) {
    let (prev, _) = Array::get(r3, a - 1)
    let (cur, _) = Array::get(r3, a)
    if prev >= cur {
      asc = false
    }
    a = a + 1
  }
  assert_eq(asc, true)
}

test "string keys sort lexicographically" {
  let m: MutSortedMap[String, Int] = MutSortedMap::new_string()
  MutSortedMap::set(m, "banana", 2)
  MutSortedMap::set(m, "apple", 1)
  MutSortedMap::set(m, "cherry", 3)
  MutSortedMap::set(m, "app", 0)
  MutSortedMap::set(m, "", -1)
  assert_eq(MutSortedMap::size(m), 5)
  let ks = MutSortedMap::keys(m)
  assert_eq(Array::get(ks, 0), "")
  assert_eq(Array::get(ks, 1), "app")
  // prefix sorts before extension
  assert_eq(Array::get(ks, 2), "apple")
  assert_eq(Array::get(ks, 3), "banana")
  assert_eq(Array::get(ks, 4), "cherry")
  assert_eq(get_or(m, "app", -99), 0)
  match MutSortedMap::min(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, "")
    },
    None => assert_eq(1, 2)
  }
  match MutSortedMap::max(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, "cherry")
    },
    None => assert_eq(1, 2)
  }
  let r = MutSortedMap::range(m, "app", "banana")
  assert_eq(Array::length(r), 3)
  // app, apple, banana
}

test "explicit cmp descending order" {
  // explicit-dict: reversed comparator makes keys come out descending
  let rev: (Int, Int) -> Int = (a, b) -> {
    compare_int(b, a)
  }
  let m: MutSortedMap[Int, Int] = MutSortedMap::new(rev)
  MutSortedMap::set(m, 1, 1)
  MutSortedMap::set(m, 3, 3)
  MutSortedMap::set(m, 2, 2)
  let ks = MutSortedMap::keys(m)
  assert_eq(Array::get(ks, 0), 3)
  assert_eq(Array::get(ks, 1), 2)
  assert_eq(Array::get(ks, 2), 1)
  // min/max follow the comparator, not numeric order
  match MutSortedMap::min(m) {
    Some(kv) => {
      let (k, _) = kv
      assert_eq(k, 3)
    },
    None => assert_eq(1, 2)
  }
}

test "to_array pairs in key order" {
  let m: MutSortedMap[Int, String] = MutSortedMap::new_int()
  MutSortedMap::set(m, 2, "two")
  MutSortedMap::set(m, 1, "one")
  MutSortedMap::set(m, 3, "three")
  let entries = MutSortedMap::to_array(m)
  assert_eq(Array::length(entries), 3)
  let (k0, v0) = Array::get(entries, 0)
  assert_eq(k0, 1)
  assert_eq(v0, "one")
  let (k2, v2) = Array::get(entries, 2)
  assert_eq(k2, 3)
  assert_eq(v2, "three")
}
