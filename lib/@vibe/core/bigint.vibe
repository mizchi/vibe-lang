// @vibe/core/bigint — arbitrary-precision signed integers.
//
// Representation: sign (-1 / 0 / 1) + little-endian limbs in base 2^30
// (1073741824). A 30-bit limb keeps every intermediate product below 2^60,
// which is safely inside vibe's 62-bit tagged Int range (±2^61). All public
// operations return normalized values: no leading (most-significant) zero
// limbs, and zero is always { sign: 0, limbs: [] }.
//
// Algorithms are the textbook ones — schoolbook multiplication and binary
// long division — chosen for correctness and readability over speed.
// Decimal parse/to_string work in 9-digit chunks (10^9 < 2^30) via
// small-divisor helpers.

//# Types

export struct BigInt {
  sign: Int;
  limbs: Array[Int]
}

//# Magnitude helpers (little-endian Array[Int] limbs, base 2^30)

fn empty_limbs() -> Array[Int] {
  Array::slice([0], 0, 0)
}

fn zeros(n: Int) -> Array[Int] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < n {
    ArrayBuilder::push(b, 0)
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

/// Drop leading (most-significant) zero limbs.
fn norm_limbs(limbs: Array[Int]) -> Array[Int] {
  let mut n = Array::length(limbs)
  while n > 0 && Array::get(limbs, n - 1) == 0 {
    n = n - 1
  }
  if n == Array::length(limbs) {
    limbs
  } else {
    Array::slice(limbs, 0, n)
  }
}

fn make_bigint(sign: Int, limbs: Array[Int]) -> BigInt {
  let t = norm_limbs(limbs)
  if Array::length(t) == 0 {
    BigInt::{
      sign: 0,
      limbs: t
    }
  } else {
    BigInt::{
      sign: sign,
      limbs: t
    }
  }
}

fn bigint_zero() -> BigInt {
  BigInt::{
    sign: 0,
    limbs: empty_limbs()
  }
}

fn bigint_one() -> BigInt {
  BigInt::{
    sign: 1,
    limbs: [1]
  }
}

/// Compare normalized magnitudes: -1 / 0 / 1.
fn cmp_mag(a: Array[Int], b: Array[Int]) -> Int {
  let la = Array::length(a)
  let lb = Array::length(b)
  if la != lb {
    if la > lb {
      1
    } else {
      -1
    }
  } else {
    let mut i = la - 1
    let mut result = 0
    while i >= 0 && result == 0 {
      let x = Array::get(a, i)
      let y = Array::get(b, i)
      if x > y {
        result = 1
      } else if x < y {
        result = -1
      }
      i = i - 1
    }
    result
  }
}

fn add_mag(a: Array[Int], b: Array[Int]) -> Array[Int] {
  let la = Array::length(a)
  let lb = Array::length(b)
  let n = if la > lb {
    la
  } else {
    lb
  }
  let out = ArrayBuilder::new()
  let mut carry = 0
  let mut i = 0
  while i < n {
    let x = if i < la {
      Array::get(a, i)
    } else {
      0
    }
    let y = if i < lb {
      Array::get(b, i)
    } else {
      0
    }
    let cur = x + y + carry
    ArrayBuilder::push(out, cur&1073741823)
    carry = cur>>30
    i = i + 1
  }
  if carry > 0 {
    ArrayBuilder::push(out, carry)
  }
  ArrayBuilder::freeze(out)
}

/// Requires cmp_mag(a, b) >= 0. Result is normalized.
fn sub_mag(a: Array[Int], b: Array[Int]) -> Array[Int] {
  let la = Array::length(a)
  let lb = Array::length(b)
  let out = ArrayBuilder::new()
  let mut borrow = 0
  let mut i = 0
  while i < la {
    let x = Array::get(a, i)
    let y = if i < lb {
      Array::get(b, i)
    } else {
      0
    }
    let d = x - y - borrow
    if d < 0 {
      ArrayBuilder::push(out, d + 1073741824)
      borrow = 1
    } else {
      ArrayBuilder::push(out, d)
      borrow = 0
    }
    i = i + 1
  }
  norm_limbs(ArrayBuilder::freeze(out))
}

/// Schoolbook multiplication. Each partial product a[i]*b[j] < 2^60 and the
/// running column value stays below 2^61, so plain Int arithmetic is safe.
fn mul_mag(a: Array[Int], b: Array[Int]) -> Array[Int] {
  let la = Array::length(a)
  let lb = Array::length(b)
  if la == 0 || lb == 0 {
    return empty_limbs()
  }
  let out = zeros(la + lb)
  let mut i = 0
  while i < la {
    let ai = Array::get(a, i)
    if ai != 0 {
      let mut carry = 0
      let mut j = 0
      while j < lb {
        let cur = Array::get(out, i + j) + ai * Array::get(b, j) + carry
        Array::set(out, i + j, cur&1073741823)
        carry = cur>>30
        j = j + 1
      }
      let mut k = i + lb
      while carry > 0 {
        let cur2 = Array::get(out, k) + carry
        Array::set(out, k, cur2&1073741823)
        carry = cur2>>30
        k = k + 1
      }
    }
    i = i + 1
  }
  norm_limbs(out)
}

/// Multiply a magnitude by a small factor 0 <= m < 2^30.
fn mul_small(a: Array[Int], m: Int) -> Array[Int] {
  if m == 0 {
    return empty_limbs()
  }
  let n = Array::length(a)
  let out = ArrayBuilder::new()
  let mut carry = 0
  let mut i = 0
  while i < n {
    let cur = Array::get(a, i) * m + carry
    ArrayBuilder::push(out, cur&1073741823)
    carry = cur>>30
    i = i + 1
  }
  while carry > 0 {
    ArrayBuilder::push(out, carry&1073741823)
    carry = carry>>30
  }
  norm_limbs(ArrayBuilder::freeze(out))
}

/// Add a small non-negative Int (s < 2^30) to a magnitude.
fn add_small(a: Array[Int], s: Int) -> Array[Int] {
  let n = Array::length(a)
  let out = ArrayBuilder::new()
  let mut carry = s
  let mut i = 0
  while i < n {
    let cur = Array::get(a, i) + carry
    ArrayBuilder::push(out, cur&1073741823)
    carry = cur>>30
    i = i + 1
  }
  while carry > 0 {
    ArrayBuilder::push(out, carry&1073741823)
    carry = carry>>30
  }
  norm_limbs(ArrayBuilder::freeze(out))
}

/// Divide a magnitude by a small divisor 1 <= d < 2^30.
/// Returns (quotient, remainder). rem * 2^30 + limb < 2^60 stays in range.
fn divmod_small(a: Array[Int], d: Int) -> (Array[Int], Int) {
  let n = Array::length(a)
  let q = zeros(n)
  let mut rem = 0
  let mut i = n - 1
  while i >= 0 {
    let cur = rem * 1073741824 + Array::get(a, i)
    Array::set(q, i, cur / d)
    rem = cur % d
    i = i - 1
  }
  (norm_limbs(q), rem)
}

fn mag_bit_length(a: Array[Int]) -> Int {
  let n = Array::length(a)
  if n == 0 {
    0
  } else {
    let mut top = Array::get(a, n - 1)
    let mut bits = 0
    while top > 0 {
      bits = bits + 1
      top = top>>1
    }
    (n - 1) * 30 + bits
  }
}

/// (a << 1) + bit, where bit is 0 or 1. Keeps normalization.
fn mag_shl1_add(a: Array[Int], bit: Int) -> Array[Int] {
  let n = Array::length(a)
  let out = ArrayBuilder::new()
  let mut carry = bit
  let mut i = 0
  while i < n {
    let cur = (Array::get(a, i)<<1) + carry
    ArrayBuilder::push(out, cur&1073741823)
    carry = cur>>30
    i = i + 1
  }
  if carry > 0 {
    ArrayBuilder::push(out, carry)
  }
  ArrayBuilder::freeze(out)
}

/// Binary long division over the bits of a (most-significant first).
/// Requires Array::length(b) > 0. Returns (quotient, remainder) magnitudes.
fn divmod_mag(a: Array[Int], b: Array[Int]) -> (Array[Int], Array[Int]) {
  let abits = mag_bit_length(a)
  if abits == 0 {
    return (empty_limbs(), empty_limbs())
  }
  let qlimbs = zeros((abits + 29) / 30)
  let mut rem = empty_limbs()
  let mut i = abits - 1
  while i >= 0 {
    let bit = (Array::get(a, i / 30)>>(i % 30))&1
    rem = mag_shl1_add(rem, bit)
    if cmp_mag(rem, b) >= 0 {
      rem = sub_mag(rem, b)
      let qi = i / 30
      Array::set(qlimbs, qi, Array::get(qlimbs, qi)|(1<<(i % 30)))
    }
    i = i - 1
  }
  (norm_limbs(qlimbs), rem)
}

//# Construction / conversion

export fn BigInt::from_int(n: Int) -> BigInt {
  if n == 0 {
    return bigint_zero()
  }
  let out = ArrayBuilder::new()
  let mut v = n
  if n > 0 {
    while v > 0 {
      ArrayBuilder::push(out, v % 1073741824)
      v = v / 1073741824
    }
    make_bigint(1, ArrayBuilder::freeze(out))
  } else {
    // Work on the negative value so Int::min (-2^61) needs no Int negation.
    // vibe's % is truncated: for v < 0 the remainder is in (-2^30, 0].
    while v < 0 {
      let r = v % 1073741824
      ArrayBuilder::push(out, 0 - r)
      v = v / 1073741824
    }
    make_bigint(-1, ArrayBuilder::freeze(out))
  }
}

/// Some(n) when the value fits in vibe's Int range [-2^61, 2^61-1], else None.
export fn BigInt::to_int(a: BigInt) -> Option[Int] {
  if a.sign == 0 {
    return Some(0)
  }
  let n = Array::length(a.limbs)
  if a.sign > 0 {
    // #1877: 63-bit Int max, seed-safe spelling (see prelude/int.vibe).
    let limit = (2305843009213693951<<1)|1
    let mut val = 0
    let mut i = n - 1
    while i >= 0 {
      let limb = Array::get(a.limbs, i)
      // val * 2^30 + limb <= limit  <=>  val <= floor((limit - limb) / 2^30)
      if val > (limit - limb) / 1073741824 {
        return None
      }
      val = val * 1073741824 + limb
      i = i - 1
    }
    Some(val)
  } else {
    // #1877: 63-bit Int min, seed-safe spelling (see prelude/int.vibe).
    let min_val = 0 - ((2305843009213693951<<1)|1) - 1
    let mut val = 0
    let mut i = n - 1
    while i >= 0 {
      let limb = Array::get(a.limbs, i)
      // val * 2^30 - limb >= min  <=>  val >= ceil((min + limb) / 2^30);
      // truncated `/` on the negative numerator IS the ceiling here.
      if val < (min_val + limb) / 1073741824 {
        return None
      }
      val = val * 1073741824 - limb
      i = i - 1
    }
    Some(val)
  }
}

/// Decimal parse: optional leading '-', digits only. Returns None on empty
/// input, a bare "-", or any non-digit. "-0" parses to zero (sign 0).
export fn BigInt::parse(s: String) -> Option[BigInt] {
  let len = String::length(s)
  if len == 0 {
    return None
  }
  let neg = String::char_code_at(s, 0) == '-'
  let start = if neg {
    1
  } else {
    0
  }
  if start >= len {
    return None
  }
  let mut i = start
  while i < len {
    let c = String::char_code_at(s, i)
    if c < '0' || c > '9' {
      return None
    }
    i = i + 1
  }
  // Fold 9-digit chunks: mag = mag * 10^k + chunk (10^9 < 2^30 keeps
  // mul_small/add_small in range).
  let mut mag = empty_limbs()
  let mut pos = start
  while pos < len {
    let chunk_end = if pos + 9 < len {
      pos + 9
    } else {
      len
    }
    let mut chunk = 0
    let mut p10 = 1
    let mut k = pos
    while k < chunk_end {
      chunk = chunk * 10 + (String::char_code_at(s, k) - '0')
      p10 = p10 * 10
      k = k + 1
    }
    mag = add_small(mul_small(mag, p10), chunk)
    pos = chunk_end
  }
  let sign = if neg {
    -1
  } else {
    1
  }
  Some(make_bigint(sign, mag))
}

fn pad9(r: Int) -> String {
  let s = Int::to_string(r)
  let mut pad = ""
  let mut i = String::length(s)
  while i < 9 {
    pad = "\{pad}0"
    i = i + 1
  }
  "\{pad}\{s}"
}

export fn BigInt::to_string(a: BigInt) -> String {
  if a.sign == 0 {
    return "0"
  }
  let mut mag = a.limbs
  let mut out = ""
  while Array::length(mag) > 0 {
    let (q, r) = divmod_small(mag, 1000000000)
    if Array::length(q) == 0 {
      out = "\{Int::to_string(r)}\{out}"
    } else {
      out = "\{pad9(r)}\{out}"
    }
    mag = q
  }
  if a.sign < 0 {
    "-\{out}"
  } else {
    out
  }
}

//# Comparison / sign

export fn BigInt::cmp(a: BigInt, b: BigInt) -> Int {
  if a.sign != b.sign {
    if a.sign > b.sign {
      1
    } else {
      -1
    }
  } else if a.sign == 0 {
    0
  } else if a.sign > 0 {
    cmp_mag(a.limbs, b.limbs)
  } else {
    0 - cmp_mag(a.limbs, b.limbs)
  }
}

export fn BigInt::equals(a: BigInt, b: BigInt) -> Bool {
  BigInt::cmp(a, b) == 0
}

export fn BigInt::is_zero(a: BigInt) -> Bool {
  a.sign == 0
}

export fn BigInt::neg(a: BigInt) -> BigInt {
  if a.sign == 0 {
    a
  } else {
    BigInt::{
      sign: 0 - a.sign,
      limbs: a.limbs
    }
  }
}

export fn BigInt::abs(a: BigInt) -> BigInt {
  if a.sign < 0 {
    BigInt::neg(a)
  } else {
    a
  }
}

//# Arithmetic

export fn BigInt::add(a: BigInt, b: BigInt) -> BigInt {
  if a.sign == 0 {
    return b
  }
  if b.sign == 0 {
    return a
  }
  if a.sign == b.sign {
    make_bigint(a.sign, add_mag(a.limbs, b.limbs))
  } else {
    let c = cmp_mag(a.limbs, b.limbs)
    if c == 0 {
      bigint_zero()
    } else if c > 0 {
      make_bigint(a.sign, sub_mag(a.limbs, b.limbs))
    } else {
      make_bigint(b.sign, sub_mag(b.limbs, a.limbs))
    }
  }
}

export fn BigInt::sub(a: BigInt, b: BigInt) -> BigInt {
  BigInt::add(a, BigInt::neg(b))
}

export fn BigInt::mul(a: BigInt, b: BigInt) -> BigInt {
  if a.sign == 0 || b.sign == 0 {
    return bigint_zero()
  }
  make_bigint(a.sign * b.sign, mul_mag(a.limbs, b.limbs))
}

/// Truncated division: quotient rounds toward zero, remainder takes the
/// dividend's sign (|r| < |b|). None when b is zero.
export fn BigInt::divmod(a: BigInt, b: BigInt) -> Option[(BigInt, BigInt)] {
  if b.sign == 0 {
    return None
  }
  if a.sign == 0 {
    return Some((bigint_zero(), bigint_zero()))
  }
  let (qm, rm) = divmod_mag(a.limbs, b.limbs)
  let q = make_bigint(a.sign * b.sign, qm)
  let r = make_bigint(a.sign, rm)
  Some((q, r))
}

export fn BigInt::div(a: BigInt, b: BigInt) -> Option[BigInt] {
  match BigInt::divmod(a, b) {
    Some((q, _)) => Some(q),
    None => None
  }
}

export fn BigInt::mod(a: BigInt, b: BigInt) -> Option[BigInt] {
  match BigInt::divmod(a, b) {
    Some((_, r)) => Some(r),
    None => None
  }
}

/// Binary exponentiation. exp < 0 yields zero (no fractional values);
/// exp == 0 yields one (including 0^0 == 1).
export fn BigInt::pow(base_v: BigInt, exp: Int) -> BigInt {
  if exp < 0 {
    return bigint_zero()
  }
  let mut result = bigint_one()
  let mut acc = base_v
  let mut e = exp
  while e > 0 {
    if e % 2 == 1 {
      result = BigInt::mul(result, acc)
    }
    acc = BigInt::mul(acc, acc)
    e = e / 2
  }
  result
}
