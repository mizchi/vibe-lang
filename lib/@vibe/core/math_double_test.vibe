//# Imports

import ./math_double.vibe {
  acos, asin, atan, atan2, cos, degrees, exp_double, hypot, ln, log10, log2_double, pi, pow_double, radians, sin, sqrt, tan
}

//# Functions

fn approx(a: Float64, b: Float64) -> Bool {
  let diff = a - b
  let d = if diff < 0.0 {
    0.0 - diff
  } else {
    diff
  }
  d < 0.0001
}

/// #949: integer micro-unit comparison (v * 1e6, truncated toward zero) —
/// sidesteps the #772 raw-double comparison miscompiles entirely by asserting
/// on Ints. Tolerance: ±2 micro-units around the IEEE-truncated expectation.
fn micro_in(v: Float64, expected: Int) -> Bool {
  let n = Float64::to_int(v * 1000000.0)
  n >= expected - 2 && n <= expected + 2
}

/// Build 10^n programmatically: float literals above ~2^61 miscompile (the
/// mantissa is parsed through Int), so 1e20 / 1e40 cannot be written directly.
fn pow10(_ n: Int) -> Float64 {
  let mut r = 1.0
  let mut i = 0
  while i < n {
    r = r * 10.0
    i = i + 1
  }
  r
}

//# Misc

test "sin 0" {
  assert(approx(a = sin(0.0), b = 0.0))
}

test "sin pi/2" {
  assert(approx(a = sin(pi / 2.0), b = 1.0))
}

test "sin pi" {
  assert(approx(a = sin(pi), b = 0.0))
}

test "sin -pi/2" {
  assert(approx(a = sin(0.0 - pi / 2.0), b = -1.0))
}

test "cos 0" {
  assert(approx(a = cos(0.0), b = 1.0))
}

test "cos pi/2" {
  assert(approx(a = cos(pi / 2.0), b = 0.0))
}

test "cos pi" {
  assert(approx(a = cos(pi), b = -1.0))
}

test "tan 0" {
  assert(approx(a = tan(0.0), b = 0.0))
}

test "tan pi/4" {
  assert(approx(a = tan(pi / 4.0), b = 1.0))
}

test "sqrt 4" {
  assert(approx(a = sqrt(4.0), b = 2.0))
}

test "sqrt 2" {
  assert(approx(a = sqrt(2.0), b = 1.4142))
}

test "sqrt 0" {
  assert(approx(a = sqrt(0.0), b = 0.0))
}

test "atan 0" {
  assert(approx(a = atan(0.0), b = 0.0))
}

test "atan 1" {
  assert(approx(a = atan(1.0), b = pi / 4.0))
}

test "atan -1" {
  assert(approx(a = atan(-1.0), b = 0.0 - pi / 4.0))
}

test "atan large" {
  // atan(100) ≈ pi/2 - 0.01 ≈ 1.5608
  let v = atan(100.0)
  assert(v > 1.5)
  assert(v < 1.58)
}

test "atan2 quadrants" {
  assert(approx(a = atan2(y = 1.0, x = 1.0), b = pi / 4.0))
  assert(approx(a = atan2(y = 1.0, x = -1.0), b = 3.0 * pi / 4.0))
  assert(approx(a = atan2(y = -1.0, x = -1.0), b = 0.0 - 3.0 * pi / 4.0))
  assert(approx(a = atan2(y = -1.0, x = 1.0), b = 0.0 - pi / 4.0))
}

test "atan2 axes" {
  assert(approx(a = atan2(y = 1.0, x = 0.0), b = pi / 2.0))
  assert(approx(a = atan2(y = -1.0, x = 0.0), b = 0.0 - pi / 2.0))
  assert(approx(a = atan2(y = 0.0, x = 1.0), b = 0.0))
}

test "asin 0" {
  assert(approx(a = asin(0.0), b = 0.0))
}

test "asin 1" {
  assert(approx(a = asin(1.0), b = pi / 2.0))
}

test "asin -1" {
  assert(approx(a = asin(-1.0), b = 0.0 - pi / 2.0))
}

test "acos 1" {
  assert(approx(a = acos(1.0), b = 0.0))
}

test "acos 0" {
  assert(approx(a = acos(0.0), b = pi / 2.0))
}

test "acos -1" {
  assert(approx(a = acos(-1.0), b = pi))
}

test "exp 0" {
  assert(approx(a = exp_double(0.0), b = 1.0))
}

test "exp 1" {
  assert(approx(a = exp_double(1.0), b = 2.7182))
}

test "ln 1" {
  assert(approx(a = ln(1.0), b = 0.0))
}

test "ln e" {
  assert(approx(a = ln(2.71828), b = 1.0))
}

test "log10 100" {
  assert(approx(a = log10(100.0), b = 2.0))
}

test "log10 1000" {
  assert(approx(a = log10(1000.0), b = 3.0))
}

test "pow_double" {
  assert(approx(a = pow_double(base = 2.0, exponent = 3.0), b = 8.0))
  assert(approx(a = pow_double(base = 2.0, exponent = 0.5), b = 1.4142))
}

test "hypot" {
  assert(approx(a = hypot(x = 3.0, y = 4.0), b = 5.0))
  assert(approx(a = hypot(x = 5.0, y = 12.0), b = 13.0))
}

test "degrees" {
  assert(approx(a = degrees(pi), b = 180.0))
  assert(approx(a = degrees(pi / 2.0), b = 90.0))
}

test "radians" {
  assert(approx(a = radians(180.0), b = pi))
  assert(approx(a = radians(90.0), b = pi / 2.0))
}

test "sin/asin roundtrip" {
  assert(approx(a = asin(sin(0.5)), b = 0.5))
  assert(approx(a = asin(sin(1.0)), b = 1.0))
}

test "cos/acos roundtrip" {
  assert(approx(a = acos(cos(0.5)), b = 0.5))
  assert(approx(a = acos(cos(1.0)), b = 1.0))
}

test "exp/ln roundtrip" {
  assert(approx(a = ln(exp_double(2.0)), b = 2.0))
  assert(approx(a = exp_double(ln(5.0)), b = 5.0))
}

test "exp negative args (#949)" {
  // exp(-10) = 4.539993e-5, exp(-20) = 2.061154e-9 (both used to come back
  // hugely wrong, even negative, from the truncated alternating series)
  assert(micro_in(v = exp_double(-10.0) * 1000.0, expected = 45399))
  assert(micro_in(v = exp_double(-20.0) * 1000000000.0, expected = 2061153))
  assert(micro_in(v = exp_double(-1.0), expected = 367879))
}

test "exp large positive args (#949)" {
  // exp(5) = 148.4131591 (pre-#949 regression guard), exp(20) = 4.851652e8
  // (used to be ~2% off from series truncation)
  assert(micro_in(v = exp_double(5.0), expected = 148413159))
  assert(micro_in(v = exp_double(20.0) / 100000000.0, expected = 4851651))
  assert(micro_in(v = exp_double(0.0), expected = 1000000))
}

test "sqrt large args (#949)" {
  // sqrt(1e40) = 1e20 (used to return ~8.7e21: Newton from guess = x could
  // not close a 66-halving exponent gap in 60 fixed iterations)
  // #772: `+ 0.0` marks the slots floatish (initializer is a call result).
  let e20 = pow10(20) + 0.0
  let e40 = pow10(40) + 0.0
  assert(micro_in(v = sqrt(e40) / e20, expected = 1000000))
  assert(micro_in(v = sqrt(10000000000.0) / 100000.0, expected = 1000000))
  assert(micro_in(v = sqrt(0.0000000001) * 100000.0, expected = 1000000))
}

test "hypot large args (#949)" {
  // #772: `+ 0.0` marks the slot floatish (initializer is a call result).
  let e20 = pow10(20) + 0.0
  assert(micro_in(v = hypot(x = 3.0 * e20, y = 4.0 * e20) / e20, expected = 5000000))
  assert(micro_in(v = hypot(x = 3.0, y = 4.0), expected = 5000000))
}

test "atan near one (#949)" {
  // atan(0.99) = 0.7803731, atan(0.999) = 0.7848975 (used to be ~1% off:
  // the bare 20-term Taylor series converges too slowly as |x| -> 1)
  assert(micro_in(v = atan(0.99), expected = 780373))
  assert(micro_in(v = atan(0.999), expected = 784897))
  assert(micro_in(v = atan(-0.99), expected = -780373))
  assert(micro_in(v = atan(1.01), expected = 790373))
}

test "atan regression guard (#949)" {
  assert(micro_in(v = atan(0.5), expected = 463647))
  assert(micro_in(v = atan(1.0), expected = 785398))
  assert(micro_in(v = atan(2.0), expected = 1107148))
  assert(micro_in(v = atan(-2.0), expected = -1107148))
  assert(micro_in(v = atan(0.7), expected = 610725))
}

test "atan2 quadrants micro (#949)" {
  assert(micro_in(v = atan2(y = 1.0, x = 1.0), expected = 785398))
  assert(micro_in(v = atan2(y = 1.0, x = -1.0), expected = 2356194))
  assert(micro_in(v = atan2(y = -1.0, x = -1.0), expected = -2356194))
  assert(micro_in(v = atan2(y = -1.0, x = 1.0), expected = -785398))
}

test "asin/acos micro (#949)" {
  assert(micro_in(v = asin(0.5), expected = 523598))
  assert(micro_in(v = acos(0.5), expected = 1047197))
  assert(micro_in(v = asin(0.9), expected = 1119769))
  assert(micro_in(v = acos(0.9), expected = 451026))
}

//# Cases `vibe mutate lib/@vibe/core/math_double.vibe` found unpinned

test "ln below 0.5 normalizes the mantissa upward" {
  // The mantissa loop that doubles m below 0.5 never ran for any other test.
  assert(micro_in(v = ln(0.25), expected = -1386294))
  assert(micro_in(v = ln(0.001), expected = -6907755))
}

test "ln of zero is negative infinity and of a negative is NaN" {
  // #3549: a negative argument is a domain error (C99 Annex F), not the
  // pole at zero; it used to answer -Infinity too.
  let z = ln(0.0) + 0.0
  let n = ln(0.0 - 3.0)
  assert(z < 0.0 - pow10(300))
  inspect(n, content = "NaN")
}

test "log2_double" {
  assert(micro_in(v = log2_double(8.0), expected = 3000000))
  assert(micro_in(v = log2_double(10.0), expected = 3321928))
}

test "sin and cos reduce arguments beyond pi" {
  assert(micro_in(v = sin(10.0), expected = -544021))
  assert(micro_in(v = sin(0.0 - 10.0), expected = 544021))
  assert(micro_in(v = cos(10.0), expected = -839071))
}

test "atan2 off the diagonal and on the negative x axis" {
  // y / x != x * y here, so a swapped operator shows; (0, -1) is pi, not
  // -pi; (0, 0) is 0.
  assert(micro_in(v = atan2(y = 1.0, x = 2.0), expected = 463647))
  assert(micro_in(v = atan2(y = 1.0, x = 0.0 - 2.0), expected = 2677945))
  assert(micro_in(v = atan2(y = 0.0 - 1.0, x = 0.0 - 2.0), expected = -2677945))
  assert(micro_in(v = atan2(y = 0.0, x = 0.0 - 1.0), expected = 3141592))
  assert(micro_in(v = atan2(y = 0.0, x = 0.0), expected = 0))
}

test "exp overflows to infinity and keeps the subnormal tail" {
  let big = exp_double(800.0) + 0.0
  assert(big > pow10(300))
  // exp(-720) = 2.03e-313 is subnormal, not 0: 1 / exp(720) would flush it.
  let tiny = exp_double(0.0 - 720.0) + 0.0
  assert(tiny > 0.0)
  let scaled = tiny * pow10(300) + 0.0
  assert(scaled < 1.0)
}

