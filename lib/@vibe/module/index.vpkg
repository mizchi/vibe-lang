version 0.0.1

// @vibe/module — module-path resolution helpers used by the loader/checker's
// import-path handling (ADR-0070 Phase 3, #897). `dir_of`/`resolve_path` are
// pure String->String functions over relative import-path strings, no
// opaque/transparent type surface. `version` was `export let version =
// "0.0.1"` directly in the old index.vibe facade — a real importable
// binding, not just contract metadata — so it is preserved verbatim as an
// implementation-file value (path.vibe) with a matching bodyless declaration
// here (Codex review precedent, PR #914).

import ./path.vibe {}

let version: String

fn dir_of(file_path: String) -> String
fn resolve_path(base_dir: String, raw_path: String) -> String
