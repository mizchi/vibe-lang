import ./shared_transport.vibe {
  PreludeSharedContext, decode_prelude_shared_context, decode_prelude_shared_job, write_prelude_shared_context, write_prelude_shared_job
}
import ./prelude_job.vibe {
  run_prelude_module_job
}
import @vibe/compiler/codegen/wasi {
  oracle_stmt_key, prelude_batch_context_indices
}
import @vibe/compiler/core {
  Stmt, namespace_rename_original, namespace_rename_originals_restore
}
import @vibe/compiler/normalize/desugar {
  module_trait_facts_none
}
import @vibe/compiler/syntax {
  lex, parse_program, print_stmt
}

fn context() -> PreludeSharedContext with Exception {
  PreludeSharedContext::{
    interfaces: parse_program(lex("struct Point { x: Int }\nfn foreign() -> Int { 0 }")),
    typed_offsets: [17],
    typed_keys: ["row"],
    facts: module_trait_facts_none(),
    namespace_originals: [("Point", "SourcePoint")],
    alias_renames: [("old", "new")],
    calls_host_future: false,
    waiter_hooks: true,
    aw_note: "note"
  }
}
fn wire(own: Array[Stmt], indices: Array[Int]) -> Bytes with Exception {
  let b = Bytes::new()
  write_prelude_shared_job(b = b, own = own, indices = indices, tag = "f7", entry = "", digest = "expected")
  b
}
fn rendered(_ stmts: Array[Stmt]) -> String {
  let rows: Array[String] = []
  for stmt in stmts {
    Array::push(rows, value = print_stmt(stmt))
  }
  String::join(rows, sep = "\n")
}

test "shared context roundtrip and ordered repeated interface positions" {
  let b = Bytes::new()
  write_prelude_shared_context(b = b, context = context())
  let decoded = decode_prelude_shared_context(b)
  let again = Bytes::new()
  write_prelude_shared_context(b = again, context = decoded)
  inspect(again == b, content = "true")
  let job = decode_prelude_shared_job(bytes = wire(own = [], indices = [1, 0, 1]), context = decoded, digest = "expected")
  inspect(Array::length(job.trait_job.interfaces), content = "3")
  inspect(print_stmt(Array::get(job.trait_job.interfaces, at = 0)) == print_stmt(Array::get(decoded.interfaces, at = 1)), content = "true")
  inspect(print_stmt(Array::get(job.trait_job.interfaces, at = 1)) == print_stmt(Array::get(decoded.interfaces, at = 0)), content = "true")
  inspect(Array::get(job.trait_job.typed_offsets, at = 0), content = "17")
  inspect(Array::get(job.trait_job.typed_keys, at = 0), content = "row")
  inspect(Array::get(job.alias_renames, at = 0).0, content = "old")
  inspect(Array::get(job.alias_renames, at = 0).1, content = "new")
  inspect(job.waiter_hooks, content = "true")
  inspect(job.aw_note, content = "note")
}

test "shared jobs refuse mismatched context bounds suffix and truncation" {
  let shared = context()
  let mismatch = handle {
    let _ = decode_prelude_shared_job(bytes = wire(own = [], indices = []), context = shared, digest = "different"); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(String::contains(mismatch, needle = "context digest"), content = "true")
  let bounds = handle {
    let _ = decode_prelude_shared_job(bytes = wire(own = [], indices = [2]), context = shared, digest = "expected"); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(String::contains(bounds, needle = "interface index"), content = "true")
  let b = wire(own = [], indices = [])
  Bytes::push(b, value = 0)
  let suffix = handle {
    let _ = decode_prelude_shared_job(bytes = b, context = shared, digest = "expected"); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(suffix, content = "shared lowering: trailing bytes")
  let truncated = handle {
    let _ = decode_prelude_shared_context(Bytes::new()); false
  } with { Exception::Throw(_) => true }
  inspect(truncated, content = "true")
}

test "shared positions above 63 use unsigned encoding" {
  let shared = context()
  let mut i = 0
  while i < 100 {
    Array::push(shared.interfaces, value = Array::get(shared.interfaces, at = 0)); i = i + 1
  }
  let job = decode_prelude_shared_job(bytes = wire(own = [], indices = [64, 101]), context = shared, digest = "expected")
  inspect(Array::length(job.trait_job.interfaces), content = "2")
}

test "shared pool preserves provenance visibility exclusion and closure order" {
  let own = parse_program(lex("fn owned() -> Int { 1 }"))
  let first = parse_program(lex("fn same() -> Int { 10 }\nfn owned() -> Int { 0 }"))
  let second = parse_program(lex("fn same() -> Int { 20 }"))
  let (pool, indices) = prelude_batch_context_indices(parts = [own, [], []], interfaces = [
    [],
    first,
    second
  ], interface_keys = [
    [],
    [
      oracle_stmt_key(Array::get(first, at = 0)),
      oracle_stmt_key(Array::get(first, at = 1))
    ],
    [oracle_stmt_key(Array::get(second, at = 0))]
  ], closure = [[2, 1, 2, 0, -1, 9], [], []])
  inspect(Array::length(pool), content = "3")
  inspect(Array::get(indices, at = 0) == [2, 0, 2], content = "true")
  inspect(print_stmt(Array::get(pool, at = 0)) != print_stmt(Array::get(pool, at = 2)), content = "true")
}

test "two lowered jobs leave the shared context and parent namespace unchanged" {
  let shared = context()
  let before = Bytes::new()
  write_prelude_shared_context(b = before, context = shared)
  namespace_rename_originals_restore([("Point", "ParentPoint")])
  let own = "struct Point { x: Int } derive (Show)"
  let one = run_prelude_module_job(decode_prelude_shared_job(bytes = wire(own = parse_program(lex(own)), indices = [
    1
  ]), context = shared, digest = "expected"))
  let two = run_prelude_module_job(decode_prelude_shared_job(bytes = wire(own = parse_program(lex(own)), indices = [
    1
  ]), context = shared, digest = "expected"))
  inspect(rendered(one.own) == rendered(two.own), content = "true")
  inspect(String::contains(rendered(one.own), needle = "SourcePoint"), content = "true")
  let after = Bytes::new()
  write_prelude_shared_context(b = after, context = shared)
  inspect(after == before, content = "true")
  inspect(namespace_rename_original("Point"), content = "ParentPoint")
  namespace_rename_originals_restore([])
}
