import ./module_job.vibe {
  ModuleLoweringDeferred,
  ModuleLoweringJob,
  module_lowering_deferred_merge,
  module_lowering_deferred_snapshot,
  run_module_lowering_job,
  run_module_lowering_job_deferring
}
import @vibe/compiler/normalize/desugar {
  DesugarModuleReports,
  desugar_module_reports_begin,
  desugar_module_reports_merge,
  desugar_module_reports_take,
  desugar_trait_dicts_module_with_facts,
  eq_deferred_requests_list,
  eq_deferred_reset,
  module_trait_facts_none
}
import @vibe/compiler/core {
  Stmt, TypeExpr, namespace_rename_original, namespace_rename_originals_restore, namespace_rename_originals_snapshot
}
import @vibe/compiler/syntax {
  lex, parse_program, print_stmt
}

fn job(src: String, renames: Array[(String, String)]) -> ModuleLoweringJob with Exception {
  ModuleLoweringJob::{
    own: parse_program(lex(src)),
    interfaces: [],
    module_tag: "f0",
    typed_offsets: [],
    typed_keys: [],
    facts: module_trait_facts_none(),
    namespace_originals: renames
  }
}
fn rendered(_ stmts: Array[Stmt]) -> String {
  let rows: Array[String] = []
  for st in stmts {
    Array::push(rows, value = print_stmt(st))
  }
  String::join(rows, sep = "\n")
}

test "module job produces the sequential trait dictionary AST" {
  let src = "struct Pt { x: Int } derive (Eq)\nfn same(a: Pt, b: Pt) -> Bool { a == b }\n"
  let old = parse_program(lex(src))
  let synth = desugar_trait_dicts_module_with_facts(own = old, ctx = [], module_tag = "f0", typed_eq_offsets = [
  ], typed_eq_keys = [], facts = module_trait_facts_none())
  let product = run_module_lowering_job(job(src = src, renames = []))
  inspect(rendered(old) == rendered(product.own), content = "true")
  inspect(rendered(synth) == rendered(product.synthesized), content = "true")
}

test "module job keeps coordinator deferrals outside its result" {
  eq_deferred_reset()
  let ledger = ModuleLoweringDeferred::{
    requests: [("foreign", TyApp("Array", [TyName("String")]))],
    refusals: ["foreign-refusal"]
  }
  module_lowering_deferred_merge(ledger)
  let product = run_module_lowering_job(job(src = "fn answer() -> Int { 42 }", renames = [
  ]))
  inspect(Array::length(product.deferred.requests), content = "0")
  inspect(Array::length(product.deferred.refusals), content = "0")
  let after = module_lowering_deferred_snapshot()
  inspect(Array::length(after.requests), content = "1")
  inspect(Array::get(after.requests, at = 0).0, content = "foreign")
  inspect(Array::length(after.refusals), content = "1")
  inspect(Array::get(after.refusals, at = 0), content = "foreign-refusal")
  eq_deferred_reset()
}

test "module job imports source names and restores coordinator names" {
  namespace_rename_originals_restore([("Point", "ParentPoint")])
  let product = run_module_lowering_job(job(src = "struct Point { x: Int } derive (Show)", renames = [
    ("Point", "WorkerPoint")
  ]))
  inspect(String::contains(rendered(product.own) + rendered(product.synthesized), needle = "WorkerPoint"), content = "true")
  inspect(namespace_rename_original("Point"), content = "ParentPoint")
  namespace_rename_originals_restore([])
}

test "module job restores boundary state after a refused comparison" {
  namespace_rename_originals_restore([("Point", "ParentPoint")])
  eq_deferred_reset()
  module_lowering_deferred_merge(ModuleLoweringDeferred::{
    requests: [("parent", TyApp("Array", [TyName("Int")]))],
    refusals: []
  })
  let failed_message = handle {
    let _ = run_module_lowering_job(job(src = "struct F {\n  f: () -> Int\n} derive (Eq)\n\nfn mk1() -> () -> Int {\n  () -> {\n    1\n  }\n}\n\nexport fn _start() -> Int {\n  let left = []\n  Array::push(left, F::{\n    f: mk1()\n  })\n  let right = []\n  Array::push(right, F::{\n    f: mk1()\n  })\n  if left == right {\n    1\n  } else {\n    0\n  }\n}\n", renames = [
      ("Point", "WorkerPoint")
    ]))
    "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(String::contains(failed_message, needle = "structural `==`"), content = "true")
  inspect(namespace_rename_original("Point"), content = "ParentPoint")
  let requests: Array[String] = eq_deferred_requests_list()
  inspect(Array::length(requests), content = "1")
  inspect(Array::get(requests, at = 0), content = "parent")
  let product = run_module_lowering_job(job(src = "fn next() -> Int { 7 }", renames = [
  ]))
  inspect(Array::length(product.deferred.requests), content = "0")
  namespace_rename_originals_restore([])
  eq_deferred_reset()
}

/// A module whose `==` over a derived struct with a function field is refused.
fn refused_eq_source() -> String {
  "struct F {\n  f: () -> Int\n} derive (Eq)\n\nfn mk1() -> () -> Int {\n  () -> {\n    1\n  }\n}\n\nexport fn _start() -> Int {\n  let left = []\n  Array::push(left, F::{\n    f: mk1()\n  })\n  let right = []\n  Array::push(right, F::{\n    f: mk1()\n  })\n  if left == right {\n    1\n  } else {\n    0\n  }\n}\n"
}

test "deferring module job returns its refusal and keeps the coordinator's program reports" {
  // #2826: a coordinator has filed one module's refusal for the program; the
  // next module's job, run in the same instance, sends its own back without
  // throwing and leaves the program's as they were.
  desugar_module_reports_begin()
  desugar_module_reports_merge(DesugarModuleReports::{
    eq: ["earlier module"],
    show: [],
    index: [],
    add32_offs: [7],
    add32_types: ["Int32"],
    add32_used: [false]
  })
  let product = run_module_lowering_job_deferring(job(src = refused_eq_source(), renames = [
  ]))
  let sent = Array::length(product.reports.eq) == 1 && String::contains(Array::get(product.reports.eq, at = 0), needle = "untyped empty-array bindings")
  let program = desugar_module_reports_take()
  // Filed after the earlier module, in module order.
  desugar_module_reports_merge(product.reports)
  let merged = desugar_module_reports_take()
  desugar_module_reports_begin()
  inspect("sent=\{sent} program=\{String::join(program.eq, sep = "|")} rows=\{Array::length(program.add32_offs)} merged=\{Array::length(merged.eq)} first=\{Array::get(merged.eq, at = 0)}", content = "sent=true program=earlier module rows=1 merged=2 first=earlier module")
}

test "a module job that is not deferring still throws its refusal and sends no reports" {
  desugar_module_reports_begin()
  let thrown = handle {
    let _ = run_module_lowering_job(job(src = refused_eq_source(), renames = []))
    "accepted"
  } with { Exception::Throw(msg) => msg }
  let accepted = run_module_lowering_job(job(src = "fn seven() -> Int { 7 }", renames = [
  ]))
  let sent = Array::length(accepted.reports.eq) + Array::length(accepted.reports.add32_offs)
  let filed = Array::length(desugar_module_reports_take().eq)
  inspect("thrown=\{String::contains(thrown, needle = "structural `==` cannot be decided here")} sent=\{sent} filed=\{filed}", content = "thrown=true sent=0 filed=0")
}
