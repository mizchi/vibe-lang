import ./string_reader.vibe {
  linear_string_reader, linear_write_string, linear_write_string_index
}
import @vibe/compiler/cache {
  ast_binary_read_byte,
  ast_binary_read_string,
  ast_binary_read_string_checked,
  ast_binary_reader_new,
  ast_binary_reader_remaining,
  ast_binary_reader_take,
  ast_binary_reader_with_string_pool,
  ast_binary_write_string,
  ast_binary_write_varint
}

test "linear string reference: exact capacity, checked pool and unchanged refusal" {
  let value = "pooled é🍣" + String::from_byte(0)
  let bytes = Bytes::with_capacity(64)
  let mut padding = 0
  while padding < 54 {
    Bytes::push(bytes, 127); padding = padding + 1
  }
  linear_write_string_index(bytes, 0)
  assert_eq(Bytes::length(bytes), 64)
  let reader = ast_binary_reader_with_string_pool(linear_string_reader(bytes), FrozenArray::from_array([
    value
  ]))
  reader.pos = 54
  assert(ast_binary_read_string_checked(reader) == value)
  assert_eq(ast_binary_reader_remaining(reader), 0)
  let short = Bytes::with_capacity(64)
  padding = 0
  while padding < 55 {
    Bytes::push(short, 127); padding = padding + 1
  }
  let error = handle {
    linear_write_string_index(short, 0); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(error, "linear string writer: insufficient reserved capacity")
  assert_eq(Bytes::length(short), 55)
  assert_eq(Bytes::get(short, 54), 127)
  let invalid = handle {
    linear_write_string_index(short, -1); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(invalid, "linear string writer: invalid pool index")
  assert_eq(Bytes::length(short), 55)
  let absent = handle {
    let missing = ast_binary_reader_with_string_pool(linear_string_reader(bytes), FrozenArray::from_array([
    ]))
    missing.pos = 54
    ast_binary_read_string_checked(missing); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(absent, "ast_binary: string reference is outside the immutable pool")
}

test "linear string writes: capacity boundary is identical on bump and RC" {
  let full = Bytes::with_capacity(64)
  let mut i = 0
  while i < 62 {
    Bytes::push(full, 127); i = i + 1
  }
  linear_write_string(full, "a")
  assert_eq(Bytes::length(full), 64)
  let error = handle {
    linear_write_string(full, ""); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(error, "linear string writer: insufficient reserved capacity")
  assert_eq(Bytes::length(full), 64)
  assert_eq(Bytes::get(full, 63), 97)
  for index in [0, 127, 128, 16383, 16384, 1152921504606846976] {
    let ordinary = Bytes::new()
    ast_binary_write_varint(ordinary, 1152921504606846976)
    ast_binary_write_varint(ordinary, index)
    let encoded = Bytes::with_capacity(64)
    linear_write_string_index(encoded, index)
    assert_eq(Bytes::length(encoded), Bytes::length(ordinary))
    i = 0
    while i < Bytes::length(ordinary) {
      assert_eq(Bytes::get(encoded, i), Bytes::get(ordinary, i)); i = i + 1
    }
  }
}

test "linear string writer: byte-identical UTF-8 and NUL framing" {
  for size in [0, 1, 126, 127, 128, 16383, 16384, 65536] {
    let chunks: Array[String] = []
    let mut i = 0
    while i < size {
      Array::push(chunks, "x"); i = i + 1
    }
    let value = String::concat(String::join(chunks, ""), String::concat("é🍣", String::from_byte(0)))
    let ordinary = Bytes::new()
    ast_binary_write_string(ordinary, value)
    let bytes = Bytes::with_capacity(String::length(value) + 16)
    linear_write_string(bytes, value)
    assert_eq(Bytes::length(bytes), Bytes::length(ordinary))
    let mut j = 0
    while j < Bytes::length(bytes) {
      assert_eq(Bytes::get(bytes, j), Bytes::get(ordinary, j)); j = j + 1
    }
    let reader = linear_string_reader(bytes)
    assert(ast_binary_read_string_checked(reader) == value)
    assert_eq(ast_binary_reader_remaining(reader), 0)
  }
}

test "linear string writer: insufficient capacity preserves the complete prefix" {
  let bytes = Bytes::with_capacity(128)
  linear_write_string(bytes, "first")
  let before = Bytes::slice(bytes, 0, Bytes::length(bytes))
  let mut value = "x"
  while String::length(value) < 256 {
    value = String::concat(value, value)
  }
  let error = handle {
    linear_write_string(bytes, value); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(error, "linear string writer: insufficient reserved capacity")
  assert_eq(Bytes::length(bytes), Bytes::length(before))
  let mut i = 0
  while i < Bytes::length(before) {
    assert_eq(Bytes::get(bytes, i), Bytes::get(before, i)); i = i + 1
  }
  linear_write_string(bytes, "second")
  let reader = linear_string_reader(bytes)
  assert(ast_binary_read_string_checked(reader) == "first")
  assert(ast_binary_read_string_checked(reader) == "second")
}

test "linear string reader: owned UTF-8 and NUL survive input reuse" {
  for padding in [0, 1016, 1017, 1018, 65536] {
    let bytes = Bytes::new()
    ast_binary_write_varint(bytes, padding + 7)
    let mut i = 0
    while i < padding {
      Bytes::push(bytes, 97); i = i + 1
    }
    for byte in [195, 169, 240, 159, 141, 163, 0] {
      Bytes::push(bytes, byte)
    }
    Bytes::push(bytes, 127)
    let slow = ast_binary_read_string_checked(ast_binary_reader_new(bytes))
    let reader = linear_string_reader(bytes)
    let fast = ast_binary_read_string_checked(reader)
    assert(fast == slow)
    inspect(ast_binary_read_byte(reader), content = "127")
    Bytes::fill(bytes, 0, Bytes::length(bytes))
    assert(fast == slow)
    inspect(String::length(fast) == padding + 7, content = "true")
    inspect(String::byte_at(fast, padding + 1), content = "169")
  }
}

test "linear string reader: child boundaries and malformed UTF-8 are checked" {
  for raw in [
    [1, 194, 162],
    [2, 194, 127],
    [1, 128],
    [2, 192, 128],
    [3, 237, 160, 128],
    [4, 244, 144, 128, 128]
  ] {
    let bytes = Bytes::from_array(raw)
    let slow = handle {
      ast_binary_read_string_checked(ast_binary_reader_new(bytes)); "accepted"
    } with { Exception::Throw(msg) => msg }
    let fast = handle {
      ast_binary_read_string_checked(linear_string_reader(bytes)); "accepted"
    } with { Exception::Throw(msg) => msg }
    assert(fast == slow)
    assert(fast != "accepted")
  }
  let reader = linear_string_reader(Bytes::from_array([2, 195, 169, 127]))
  let child = ast_binary_reader_take(reader, 2)
  let error = handle {
    ast_binary_read_string_checked(child); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(error, content = "ast_binary: string length exceeds remaining input")
  inspect(ast_binary_read_byte(reader), content = "169")
  let nested = ast_binary_reader_take(reader, 1)
  inspect(ast_binary_read_byte(nested), content = "127")
  inspect(ast_binary_reader_remaining(reader), content = "0")
}

test "linear string reader: raw clipping and empty strings keep cursor behavior" {
  for raw in [[0, 127], [1, 97, 127], [5, 97, 98, 195, 169], [3, 0, 0, 127]] {
    let bytes = Bytes::from_array(raw)
    let slow = ast_binary_reader_new(bytes)
    let fast = linear_string_reader(bytes)
    assert(ast_binary_read_string(fast) == ast_binary_read_string(slow))
    inspect(ast_binary_reader_remaining(fast) == ast_binary_reader_remaining(slow), content = "true")
    inspect(ast_binary_read_byte(fast) == ast_binary_read_byte(slow), content = "true")
  }
}

test "linear string reader: valid child strings stay owned after buffer reuse" {
  let bytes = Bytes::from_array([3, 195, 169, 0, 127])
  let reader = linear_string_reader(bytes)
  let child = ast_binary_reader_take(reader, 4)
  let value = ast_binary_read_string_checked(child)
  inspect(ast_binary_reader_remaining(child), content = "0")
  inspect(ast_binary_read_byte(reader), content = "127")
  Bytes::fill(bytes, 0, Bytes::length(bytes))
  inspect(String::length(value), content = "3")
  inspect(String::byte_at(value, 0), content = "195")
  inspect(String::byte_at(value, 1), content = "169")
  inspect(String::byte_at(value, 2), content = "0")
}
