import ./transport.vibe {
  decode_module_lowering_job, decode_module_lowering_product, encode_module_lowering_job, encode_module_lowering_product
}
import ./module_job.vibe {
  ModuleLoweringDeferred, ModuleLoweringJob, ModuleLoweringProduct, run_module_lowering_job
}
import @vibe/compiler/normalize/desugar {
  DesugarModuleReports, module_trait_facts_none
}
import @vibe/compiler/syntax {
  lex, parse_program, print_stmt
}

test "module job wire preserves owned bodies and source names" {
  let job = ModuleLoweringJob::{
    own: parse_program(lex("struct Point { x: Int } derive (Show)")),
    interfaces: [],
    module_tag: "f7",
    typed_offsets: [17],
    typed_keys: ["row"],
    facts: module_trait_facts_none(),
    namespace_originals: [("Point", "SourcePoint")]
  }
  let bytes = encode_module_lowering_job(job)
  let decoded = decode_module_lowering_job(bytes)
  inspect(encode_module_lowering_job(decoded) == bytes, content = "true")
  let product = run_module_lowering_job(decoded)
  let wire = encode_module_lowering_product(product)
  inspect(encode_module_lowering_product(decode_module_lowering_product(wire)) == wire, content = "true")
}

test "module job wire refuses suffixes and truncated products" {
  let job = ModuleLoweringJob::{
    own: [],
    interfaces: [],
    module_tag: "f7",
    typed_offsets: [],
    typed_keys: [],
    facts: module_trait_facts_none(),
    namespace_originals: []
  }
  let bytes = encode_module_lowering_job(job)
  Bytes::push(bytes, value = 0)
  let message = handle {
    let _ = decode_module_lowering_job(bytes); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(message, content = "module lowering: trailing bytes")
  let refused = handle {
    let _ = decode_module_lowering_product(Bytes::new()); false
  } with { Exception::Throw(_) => true }
  inspect(refused, content = "true")
}

test "module product wire carries the module's refusals and 32-bit rows" {
  // #2826: version 2 of the product carries what the coordinator reports
  // once for the program.
  let product = ModuleLoweringProduct::{
    own: [],
    synthesized: [],
    synthesis_requests: [],
    deferred: ModuleLoweringDeferred::{ requests: [], refusals: [] },
    invisible_nominals: [],
    reports: DesugarModuleReports::{
      eq: ["eq one", "eq two"],
      show: ["renderer"],
      index: ["index"],
      add32_offs: [12, 0 - 1],
      add32_types: ["Int32", "mixed"],
      add32_used: [true, false]
    }
  }
  let wire = encode_module_lowering_product(product)
  let back = decode_module_lowering_product(wire)
  let r = back.reports
  let rows = "\{Array::get(r.add32_offs, at = 0)}:\{Array::get(r.add32_types, at = 0)}:\{Array::get(r.add32_used, at = 0)},\{Array::get(r.add32_offs, at = 1)}:\{Array::get(r.add32_types, at = 1)}:\{Array::get(r.add32_used, at = 1)}"
  inspect(String::join(r.eq, sep = "|") + ";" + String::join(r.show, sep = "|") + ";" + String::join(r.index, sep = "|") + ";" + rows + "; stable=\{encode_module_lowering_product(back) == wire}", content = "eq one|eq two;renderer;index;12:Int32:true,-1:mixed:false; stable=true")
}
