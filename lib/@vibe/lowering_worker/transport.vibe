// Wire boundary for one independent trait-dictionary lowering job.
import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_count_checked,
  ast_binary_read_module,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_read_type_expr,
  ast_binary_reader_new,
  ast_binary_reader_remaining,
  ast_binary_write_bool,
  ast_binary_write_module,
  ast_binary_write_string,
  ast_binary_write_svarint,
  ast_binary_write_type_expr,
  ast_binary_write_varint
}
import ./module_job.vibe {
  ModuleLoweringDeferred, ModuleLoweringJob, ModuleLoweringProduct
}
import @vibe/compiler/normalize/desugar {
  DesugarModuleReports, ModuleTraitFacts
}
import @vibe/compiler/core {
  Stmt, TypeExpr
}

fn write_strings(b: Bytes, values: Array[String]) -> Unit {
  ast_binary_write_varint(buf = b, v = Array::length(values))
  for value in values {
    ast_binary_write_string(buf = b, s = value)
  }
  ()
}
fn read_strings(_ r: AstBinaryReader) -> Array[String] with Exception {
  let values: Array[String] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(values, value = ast_binary_read_string_checked(r)); i = i + 1
  }
  values
}
fn read_magic(r: AstBinaryReader, expected: String) -> Unit with Exception {
  if ast_binary_read_string_checked(r) != expected {
    throw("module lowering: unsupported wire format")
  } else ()
}
fn require_end(_ r: AstBinaryReader) -> Unit with Exception {
  if ast_binary_reader_remaining(r) != 0 {
    throw("module lowering: trailing bytes")
  } else ()
}
export fn encode_module_lowering_job(_ job: ModuleLoweringJob) -> Bytes with Exception {
  let b = Bytes::new()
  write_module_lowering_job(b = b, job = job)
  b
}

/// Append the canonical job to a caller-owned buffer.
export fn write_module_lowering_job(b: Bytes, job: ModuleLoweringJob) -> Unit with Exception {
  if Array::length(job.typed_offsets) != Array::length(job.typed_keys) {
    throw("module lowering: typed row lengths differ")
  } else ()
  ast_binary_write_string(buf = b, s = "vibe-module-trait-job-1")
  ast_binary_write_string(buf = b, s = job.module_tag)
  ast_binary_write_module(buf = b, stmts = job.own)
  ast_binary_write_module(buf = b, stmts = job.interfaces)
  ast_binary_write_varint(buf = b, v = Array::length(job.typed_offsets))
  let mut i = 0
  while i < Array::length(job.typed_offsets) {
    ast_binary_write_svarint(buf = b, v = Array::get(job.typed_offsets, at = i))
    ast_binary_write_string(buf = b, s = Array::get(job.typed_keys, at = i))
    i = i + 1
  }
  write_strings(b = b, values = job.facts.wrapper_names)
  write_strings(b = b, values = job.facts.explicit_ops)
  ast_binary_write_varint(buf = b, v = Array::length(job.namespace_originals))
  for pair in job.namespace_originals {
    ast_binary_write_string(buf = b, s = pair.0); ast_binary_write_string(buf = b, s = pair.1)
  }
  ()
}
export fn decode_module_lowering_job(_ b: Bytes) -> ModuleLoweringJob with Exception {
  let r = ast_binary_reader_new(b)
  read_magic(r = r, expected = "vibe-module-trait-job-1")
  let tag = ast_binary_read_string_checked(r)
  let own = ast_binary_read_module(r)
  let interfaces = ast_binary_read_module(r)
  let offsets: Array[Int] = []
  let keys: Array[String] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let offset = ast_binary_read_svarint_checked(r)
    let key = ast_binary_read_string_checked(r)
    Array::push(offsets, value = offset); Array::push(keys, value = key)
    i = i + 1
  }
  let wrappers = read_strings(r)
  let ops = read_strings(r)
  let renames: Array[(String, String)] = []
  let pairs = ast_binary_read_count_checked(r)
  i = 0
  while i < pairs {
    let mangled = ast_binary_read_string_checked(r)
    let original = ast_binary_read_string_checked(r)
    Array::push(renames, value = (mangled, original)); i = i + 1
  }
  require_end(r)
  ModuleLoweringJob::{
    own: own,
    interfaces: interfaces,
    module_tag: tag,
    typed_offsets: offsets,
    typed_keys: keys,
    facts: ModuleTraitFacts::{ wrapper_names: wrappers, explicit_ops: ops },
    namespace_originals: renames
  }
}
/// The product's wire format. Version 2 (#2826) appends the module's
/// trait-dict refusals (`write_module_reports`).
fn module_product_magic() -> String {
  "vibe-module-trait-product-2"
}

/// One module's refusals: the `==`, renderer and index refusals in the order
/// the run filed them, then each 32-bit `Add` row as (offset, type,
/// consumed).
fn write_module_reports(b: Bytes, reports: DesugarModuleReports) -> Unit {
  write_strings(b = b, values = reports.eq)
  write_strings(b = b, values = reports.show)
  write_strings(b = b, values = reports.index)
  ast_binary_write_varint(buf = b, v = Array::length(reports.add32_offs))
  let mut i = 0
  while i < Array::length(reports.add32_offs) {
    ast_binary_write_svarint(buf = b, v = Array::get(reports.add32_offs, at = i))
    ast_binary_write_string(buf = b, s = Array::get(reports.add32_types, at = i))
    ast_binary_write_bool(buf = b, b = Array::get(reports.add32_used, at = i))
    i = i + 1
  }
  ()
}

fn read_module_reports(_ r: AstBinaryReader) -> DesugarModuleReports with Exception {
  let eq = read_strings(r)
  let show = read_strings(r)
  let index = read_strings(r)
  let offs: Array[Int] = []
  let types: Array[String] = []
  let used: Array[Bool] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(offs, value = ast_binary_read_svarint_checked(r))
    Array::push(types, value = ast_binary_read_string_checked(r))
    Array::push(used, value = ast_binary_read_bool_checked(r))
    i = i + 1
  }
  DesugarModuleReports::{
    eq: eq,
    show: show,
    index: index,
    add32_offs: offs,
    add32_types: types,
    add32_used: used
  }
}

export fn encode_module_lowering_product(_ product: ModuleLoweringProduct) -> Bytes {
  let b = Bytes::new()
  ast_binary_write_string(buf = b, s = module_product_magic())
  ast_binary_write_module(buf = b, stmts = product.own)
  ast_binary_write_module(buf = b, stmts = product.synthesized)
  write_strings(b = b, values = product.synthesis_requests)
  ast_binary_write_varint(buf = b, v = Array::length(product.deferred.requests))
  for pair in product.deferred.requests {
    ast_binary_write_string(buf = b, s = pair.0); ast_binary_write_type_expr(buf = b, t = pair.1)
  }
  write_strings(b = b, values = product.deferred.refusals)
  write_strings(b = b, values = product.invisible_nominals)
  write_module_reports(b = b, reports = product.reports)
  b
}
export fn decode_module_lowering_product(_ b: Bytes) -> ModuleLoweringProduct with Exception {
  read_module_lowering_product(ast_binary_reader_new(b))
}

/// Decode exactly one product from a bounded cursor, including its end check.
export fn read_module_lowering_product(_ r: AstBinaryReader) -> ModuleLoweringProduct with Exception {
  read_magic(r = r, expected = module_product_magic())
  let own = ast_binary_read_module(r)
  let synthesized = ast_binary_read_module(r)
  let synthesis_requests = read_strings(r)
  let requests: Array[(String, TypeExpr)] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let key = ast_binary_read_string_checked(r)
    let ty = ast_binary_read_type_expr(r)
    Array::push(requests, value = (key, ty)); i = i + 1
  }
  let refusals = read_strings(r)
  let invisible = read_strings(r)
  let reports = read_module_reports(r)
  require_end(r)
  ModuleLoweringProduct::{
    own: own,
    synthesized: synthesized,
    synthesis_requests: synthesis_requests,
    deferred: ModuleLoweringDeferred::{ requests: requests, refusals: refusals },
    invisible_nominals: invisible,
    reports: reports
  }
}

export fn ModuleLoweringJob::encode_module_lowering_job(_ recv: ModuleLoweringJob) -> Bytes with Exception {
  encode_module_lowering_job(recv)
}

export fn ModuleLoweringProduct::encode_module_lowering_product(_ recv: ModuleLoweringProduct) -> Bytes {
  encode_module_lowering_product(recv)
}
