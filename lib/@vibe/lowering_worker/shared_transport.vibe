import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_count_checked,
  ast_binary_read_module,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_read_varint_checked,
  ast_binary_reader_new,
  ast_binary_reader_remaining,
  ast_binary_write_bool,
  ast_binary_write_module,
  ast_binary_write_string,
  ast_binary_write_svarint,
  ast_binary_write_varint
}
import @vibe/compiler/core {
  Stmt
}
import @vibe/compiler/normalize/desugar {
  ModuleTraitFacts
}
import ./module_job.vibe {
  ModuleLoweringJob
}
import ./prelude_job.vibe {
  PreludeModuleJob
}

/// Read-only state decoded once per worker instance, outside its job loop.
/// Pool positions preserve declaration provenance; equal names are not deduplicated.
export struct PreludeSharedContext {
  interfaces: Array[Stmt];
  typed_offsets: Array[Int];
  typed_keys: Array[String];
  facts: ModuleTraitFacts;
  namespace_originals: Array[(String, String)];
  alias_renames: Array[(String, String)];
  calls_host_future: Bool;
  waiter_hooks: Bool;
  aw_note: String
}

fn put_strings(b: Bytes, values: Array[String]) -> Unit {
  ast_binary_write_varint(b, Array::length(values))
  for value in values {
    ast_binary_write_string(b, value)
  }
  ()
}
fn get_strings(r: AstBinaryReader) -> Array[String] with Exception {
  let values: Array[String] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(values, ast_binary_read_string_checked(r)); i = i + 1
  }
  values
}
fn put_pairs(b: Bytes, values: Array[(String, String)]) -> Unit {
  ast_binary_write_varint(b, Array::length(values))
  for value in values {
    ast_binary_write_string(b, value.0); ast_binary_write_string(b, value.1)
  }
  ()
}
fn get_pairs(r: AstBinaryReader) -> Array[(String, String)] with Exception {
  let values: Array[(String, String)] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let from = ast_binary_read_string_checked(r)
    let to = ast_binary_read_string_checked(r)
    Array::push(values, (from, to)); i = i + 1
  }
  values
}
fn magic(r: AstBinaryReader, expected: String) -> Unit with Exception {
  if ast_binary_read_string_checked(r) != expected {
    throw("shared lowering: unsupported wire format")
  } else ()
}
fn end(r: AstBinaryReader) -> Unit with Exception {
  if ast_binary_reader_remaining(r) != 0 {
    throw("shared lowering: trailing bytes")
  } else ()
}

/// Append the context once to a caller-owned buffer.
export fn write_prelude_shared_context(b: Bytes, context: PreludeSharedContext) -> Unit with Exception {
  if Array::length(context.typed_offsets) != Array::length(context.typed_keys) {
    throw("shared lowering: typed row lengths differ")
  } else ()
  ast_binary_write_string(b, "vibe-prelude-shared-context-1")
  ast_binary_write_module(b, context.interfaces)
  ast_binary_write_varint(b, Array::length(context.typed_offsets))
  let mut i = 0
  while i < Array::length(context.typed_offsets) {
    ast_binary_write_svarint(b, Array::get(context.typed_offsets, i))
    ast_binary_write_string(b, Array::get(context.typed_keys, i)); i = i + 1
  }
  put_strings(b, context.facts.wrapper_names)
  put_strings(b, context.facts.explicit_ops)
  put_pairs(b, context.namespace_originals)
  put_pairs(b, context.alias_renames)
  ast_binary_write_bool(b, context.calls_host_future)
  ast_binary_write_bool(b, context.waiter_hooks)
  ast_binary_write_string(b, context.aw_note)
}

/// Decode the immutable context independently of owned module bodies.
export fn decode_prelude_shared_context(bytes: Bytes) -> PreludeSharedContext with Exception {
  read_prelude_shared_context(ast_binary_reader_new(bytes))
}

/// Decode through the supplied bounded reader and retain its string-copy policy.
export fn read_prelude_shared_context(r: AstBinaryReader) -> PreludeSharedContext with Exception {
  magic(r, "vibe-prelude-shared-context-1")
  let interfaces = ast_binary_read_module(r)
  let offsets: Array[Int] = []
  let keys: Array[String] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let offset = ast_binary_read_svarint_checked(r)
    let key = ast_binary_read_string_checked(r)
    Array::push(offsets, offset); Array::push(keys, key); i = i + 1
  }
  let wrappers = get_strings(r)
  let ops = get_strings(r)
  let names = get_pairs(r)
  let aliases = get_pairs(r)
  let future = ast_binary_read_bool_checked(r)
  let waiter = ast_binary_read_bool_checked(r)
  let note = ast_binary_read_string_checked(r)
  end(r)
  PreludeSharedContext::{
    interfaces: interfaces,
    typed_offsets: offsets,
    typed_keys: keys,
    facts: ModuleTraitFacts::{ wrapper_names: wrappers, explicit_ops: ops },
    namespace_originals: names,
    alias_renames: aliases,
    calls_host_future: future,
    waiter_hooks: waiter,
    aw_note: note
  }
}

/// Only owned bodies and ordered interface positions cross each job boundary.
/// The expected context digest is part of the parent-validated input receipt.
export fn write_prelude_shared_job(b: Bytes, own: Array[Stmt], indices: Array[Int], tag: String, entry: String, digest: String) -> Unit with Exception {
  ast_binary_write_string(b, "vibe-prelude-shared-job-1")
  ast_binary_write_string(b, digest)
  ast_binary_write_string(b, tag)
  ast_binary_write_string(b, entry)
  ast_binary_write_module(b, own)
  ast_binary_write_varint(b, Array::length(indices))
  for index in indices {
    if index < 0 {
      throw("shared lowering: negative interface index")
    } else ()
    ast_binary_write_varint(b, index)
  }
  ()
}

/// Bind a job to the exact context bytes and preserve its visibility and order.
export fn decode_prelude_shared_job(bytes: Bytes, context: PreludeSharedContext, digest: String) -> PreludeModuleJob with Exception {
  read_prelude_shared_job(ast_binary_reader_new(bytes), context, digest)
}

/// Decode through the supplied bounded reader and retain its string-copy policy.
export fn read_prelude_shared_job(r: AstBinaryReader, context: PreludeSharedContext, digest: String) -> PreludeModuleJob with Exception {
  magic(r, "vibe-prelude-shared-job-1")
  if ast_binary_read_string_checked(r) != digest {
    throw("shared lowering: context digest does not match the prepared input")
  } else ()
  let tag = ast_binary_read_string_checked(r)
  let entry = ast_binary_read_string_checked(r)
  let own = ast_binary_read_module(r)
  let interfaces: Array[Stmt] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let index = ast_binary_read_varint_checked(r)
    if index < 0 || index >= Array::length(context.interfaces) {
      throw("shared lowering: interface index outside the context")
    } else ()
    Array::push(interfaces, Array::get(context.interfaces, index)); i = i + 1
  }
  end(r)
  PreludeModuleJob::{
    trait_job: ModuleLoweringJob::{
      own: own,
      interfaces: interfaces,
      module_tag: tag,
      typed_offsets: context.typed_offsets,
      typed_keys: context.typed_keys,
      facts: context.facts,
      namespace_originals: context.namespace_originals
    },
    entry_name: entry,
    alias_renames: context.alias_renames,
    calls_host_future: context.calls_host_future,
    waiter_hooks: context.waiter_hooks,
    aw_note: context.aw_note
  }
}
