import ./prelude_job.vibe {
  PreludeModuleJob, run_prelude_module_job
}
import ./module_job.vibe {
  ModuleLoweringJob, ModuleLoweringProduct
}
import @vibe/compiler/cache {
  ast_binary_write_string, ast_binary_write_varint
}
import ./transport.vibe {
  encode_module_lowering_product
}
import @vibe/compiler/normalize/desugar {
  module_trait_facts_none
}
import @vibe/compiler/syntax {
  lex, parse_program, print_stmt
}
import ./prelude_transport.vibe {
  decode_prelude_module_job, decode_prelude_module_product, encode_prelude_module_job, encode_prelude_module_product
}

fn sample_job() -> PreludeModuleJob with Exception {
  PreludeModuleJob::{
    trait_job: ModuleLoweringJob::{
      own: parse_program(lex("fn raw() -> Int = wasm \"(i64.const 7)\"\nfn answer() -> Int { raw() }\n")),
      interfaces: [],
      module_tag: "f0",
      typed_offsets: [],
      typed_keys: [],
      facts: module_trait_facts_none(),
      namespace_originals: []
    },
    entry_name: "answer",
    alias_renames: [],
    calls_host_future: false,
    waiter_hooks: false,
    aw_note: ""
  }
}

test "module prelude wire carries extracted inline wasm separately" {
  let job = sample_job()
  let wire = encode_prelude_module_job(job)
  let decoded = decode_prelude_module_job(wire)
  inspect(encode_prelude_module_job(decoded) == wire, content = "true")
  let product = run_prelude_module_job(decoded)
  inspect(Array::length(product.inline_names), content = "1")
  inspect(Array::get(product.inline_names, 0), content = "raw")
  inspect(Array::get(product.inline_wats, 0), content = "(i64.const 7)")
  let body = print_stmt(Array::get(product.own, 0))
  inspect(String::contains(body, "%wasm"), content = "false")
  let bytes = encode_prelude_module_product(product)
  inspect(encode_prelude_module_product(decode_prelude_module_product(bytes)) == bytes, content = "true")
}

test "module prelude wire refuses trailing input" {
  let wire = encode_prelude_module_job(sample_job())
  Bytes::push(wire, 0)
  let outcome = handle {
    let _ = decode_prelude_module_job(wire); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(outcome, content = "prelude module: trailing bytes")
}

test "module product child length cannot consume the following envelope fields" {
  let product = run_prelude_module_job(sample_job())
  let inner = encode_module_lowering_product(ModuleLoweringProduct::{
    own: product.own,
    synthesized: [],
    synthesis_requests: product.synthesis_requests,
    deferred: product.deferred,
    invisible_nominals: product.invisible_nominals
  })
  for delta in [0 - 1, 1] {
    let bytes = Bytes::new()
    ast_binary_write_string(bytes, "vibe-prelude-module-product-1")
    ast_binary_write_string(bytes, product.module_tag)
    ast_binary_write_varint(bytes, Bytes::length(inner) + delta)
    Bytes::append(bytes, inner)
    // Keep all envelope fields physically present; only the child bound changes.
    let mut i = 0
    while i < 7 {
      Bytes::push(bytes, 0); i = i + 1
    }
    let outcome = handle {
      let _ = decode_prelude_module_product(bytes); "accepted"
    } with { Exception::Throw(msg) => msg }
    inspect(outcome == "accepted", content = "false")
  }
}

test "decoded module products own their strings across input buffer reuse" {
  let product = run_prelude_module_job(sample_job())
  let bytes = encode_prelude_module_product(product)
  let decoded = decode_prelude_module_product(bytes)
  let expected = encode_prelude_module_product(decoded)
  let mut i = 0
  while i < Bytes::length(bytes) {
    Bytes::set(bytes, i, 0); i = i + 1
  }
  inspect(encode_prelude_module_product(decoded) == expected, content = "true")
  inspect(Array::get(decoded.inline_names, 0), content = "raw")
  inspect(Array::get(decoded.inline_wats, 0), content = "(i64.const 7)")
}
