import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_byte_checked,
  ast_binary_read_count_checked,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_reader_new,
  ast_binary_reader_remaining,
  ast_binary_reader_take,
  ast_binary_write_bool,
  ast_binary_write_string,
  ast_binary_write_svarint,
  ast_binary_write_varint
}
import ./prelude_job.vibe {
  PreludeModuleJob, PreludeModuleProduct
}
import @vibe/compiler/codegen/wasi {
  PreludeTail
}
import ./module_job.vibe {
  ModuleLoweringProduct
}
import ./transport.vibe {
  decode_module_lowering_job, encode_module_lowering_product, read_module_lowering_product, write_module_lowering_job
}
fn put_blob(b: Bytes, bytes: Bytes) -> Unit {
  ast_binary_write_varint(buf = b, v = Bytes::length(bytes)); Bytes::append(b, bytes = bytes)
}
fn get_blob(_ r: AstBinaryReader) -> Bytes with Exception {
  let n = ast_binary_read_count_checked(r)
  let b = Bytes::new()
  let mut i = 0
  while i < n {
    Bytes::push(b, value = ast_binary_read_byte_checked(r)); i = i + 1
  }
  b
}
fn put_strings(b: Bytes, strings: Array[String]) -> Unit {
  ast_binary_write_varint(buf = b, v = Array::length(strings))
  for s in strings {
    ast_binary_write_string(buf = b, s = s)
  }
  ()
}
fn get_strings(_ r: AstBinaryReader) -> Array[String] with Exception {
  let n = ast_binary_read_count_checked(r)
  let strings: Array[String] = []
  let mut i = 0
  while i < n {
    Array::push(strings, value = ast_binary_read_string_checked(r)); i = i + 1
  }
  strings
}
fn expect_magic(r: AstBinaryReader, magic: String) -> Unit with Exception {
  if ast_binary_read_string_checked(r) != magic {
    throw("prelude module: unsupported wire format")
  } else ()
}
fn expect_end(_ r: AstBinaryReader) -> Unit with Exception {
  if ast_binary_reader_remaining(r) != 0 {
    throw("prelude module: trailing bytes")
  } else ()
}
export fn encode_prelude_module_job(_ job: PreludeModuleJob) -> Bytes with Exception {
  let b = Bytes::new()
  write_prelude_module_job(b = b, inner = Bytes::new(), job = job)
  b
}

/// Write the canonical envelope using two distinct empty caller-owned buffers.
export fn write_prelude_module_job(b: Bytes, inner: Bytes, job: PreludeModuleJob) -> Unit with Exception {
  if Bytes::length(b) != 0 || Bytes::length(inner) != 0 {
    throw("prelude module: job buffers must be empty")
  } else ()
  ast_binary_write_string(buf = b, s = "vibe-prelude-module-job-1")
  write_module_lowering_job(b = inner, job = job.trait_job)
  put_blob(b = b, bytes = inner)
  ast_binary_write_string(buf = b, s = job.entry_name)
  ast_binary_write_varint(buf = b, v = Array::length(job.alias_renames))
  for pair in job.alias_renames {
    ast_binary_write_string(buf = b, s = pair.0); ast_binary_write_string(buf = b, s = pair.1)
  }
  ast_binary_write_bool(buf = b, b = job.calls_host_future)
  ast_binary_write_bool(buf = b, b = job.waiter_hooks)
  ast_binary_write_string(buf = b, s = job.aw_note)
  ()
}
export fn decode_prelude_module_job(_ bytes: Bytes) -> PreludeModuleJob with Exception {
  let r = ast_binary_reader_new(bytes)
  expect_magic(r = r, magic = "vibe-prelude-module-job-1")
  let job = decode_module_lowering_job(get_blob(r))
  let entry = ast_binary_read_string_checked(r)
  let n = ast_binary_read_count_checked(r)
  let renames: Array[(String, String)] = []
  let mut i = 0
  while i < n {
    let from = ast_binary_read_string_checked(r)
    let to = ast_binary_read_string_checked(r)
    Array::push(renames, value = (from, to)); i = i + 1
  }
  let future = ast_binary_read_bool_checked(r)
  let waiter = ast_binary_read_bool_checked(r)
  let note = ast_binary_read_string_checked(r)
  expect_end(r)
  PreludeModuleJob::{
    trait_job: job,
    entry_name: entry,
    alias_renames: renames,
    calls_host_future: future,
    waiter_hooks: waiter,
    aw_note: note
  }
}
export fn encode_prelude_module_product(_ product: PreludeModuleProduct) -> Bytes {
  let b = Bytes::new()
  ast_binary_write_string(buf = b, s = "vibe-prelude-module-product-1")
  ast_binary_write_string(buf = b, s = product.module_tag)
  put_blob(b = b, bytes = encode_module_lowering_product(ModuleLoweringProduct::{
    own: product.own,
    synthesized: [],
    synthesis_requests: product.synthesis_requests,
    deferred: product.deferred,
    invisible_nominals: product.invisible_nominals,
    reports: product.reports
  }))
  put_strings(b = b, strings = product.synth_keys)
  put_strings(b = b, strings = product.tail.keys)
  ast_binary_write_varint(buf = b, v = Array::length(product.tail.passes))
  for pass in product.tail.passes {
    ast_binary_write_svarint(buf = b, v = pass)
  }
  put_strings(b = b, strings = product.diagnostics)
  put_strings(b = b, strings = product.inline_names)
  put_strings(b = b, strings = product.inline_wats)
  b
}
export fn decode_prelude_module_product(_ bytes: Bytes) -> PreludeModuleProduct with Exception {
  read_prelude_module_product(ast_binary_reader_new(bytes))
}

/// Decode through the supplied bounded reader and retain its string-copy policy.
export fn read_prelude_module_product(_ r: AstBinaryReader) -> PreludeModuleProduct with Exception {
  expect_magic(r = r, magic = "vibe-prelude-module-product-1")
  let tag = ast_binary_read_string_checked(r)
  let length = ast_binary_read_count_checked(r)
  let base = read_module_lowering_product(ast_binary_reader_take(r = r, length = length))
  let keys = get_strings(r)
  let tail_keys = get_strings(r)
  let n = ast_binary_read_count_checked(r)
  let ranks: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(ranks, value = ast_binary_read_svarint_checked(r)); i = i + 1
  }
  let diagnostics = get_strings(r)
  let names = get_strings(r)
  let wats = get_strings(r)
  expect_end(r)
  if Array::length(tail_keys) != n || Array::length(names) != Array::length(wats) || Array::length(base.synthesized) != 0 {
    throw("prelude module: inconsistent product arrays")
  } else ()
  PreludeModuleProduct::{
    module_tag: tag,
    own: base.own,
    synth_keys: keys,
    tail: PreludeTail::{ keys: tail_keys, passes: ranks },
    diagnostics: diagnostics,
    synthesis_requests: base.synthesis_requests,
    deferred: base.deferred,
    inline_names: names,
    inline_wats: wats,
    invisible_nominals: base.invisible_nominals,
    reports: base.reports
  }
}

export fn PreludeModuleJob::encode_prelude_module_job(_ recv: PreludeModuleJob) -> Bytes with Exception {
  encode_prelude_module_job(recv)
}

export fn PreludeModuleProduct::encode_prelude_module_product(_ recv: PreludeModuleProduct) -> Bytes {
  encode_prelude_module_product(recv)
}
