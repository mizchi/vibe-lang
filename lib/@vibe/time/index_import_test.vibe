// now_utc_iso / now_local_date shell out via sh_lines (Process effect); the
// `handle ... with Process` blocks discharge that effect for the checker (the
// arms are never invoked — sh_lines lowers to a direct host-import call). The
// Process effect declaration is imported from the process package.

import .{
  now_local_date, now_utc_iso, sleep_ms
}
import @vibe/process {
  Process
}

fn iso_len_and_seps() -> Bool with Process {
  let iso = now_utc_iso()
  eq(String::length(iso), 20)
  && eq(String::char_code_at(iso, 4), 45)
  && eq(String::char_code_at(iso, 7), 45)
  && eq(String::char_code_at(iso, 10), 84)
  && eq(String::char_code_at(iso, 13), 58)
  && eq(String::char_code_at(iso, 16), 58)
  && eq(String::char_code_at(iso, 19), 90)
}

fn date_len_and_seps() -> Bool with Process {
  let date = now_local_date()
  eq(String::length(date), 10)
  && eq(String::char_code_at(date, 4), 45)
  && eq(String::char_code_at(date, 7), 45)
}

test "now_utc_iso is ISO8601 UTC (YYYY-MM-DDThh:mm:ssZ)" {
  let ok = handle {
    iso_len_and_seps()
  } with Process {
    Exec(_c) => resume("");
    Env(_k) => resume("");
    Exit(_x) => resume(0)
  }
  assert(ok)
}

test "now_local_date is YYYY-MM-DD" {
  let ok = handle {
    date_len_and_seps()
  } with Process {
    Exec(_c) => resume("");
    Env(_k) => resume("");
    Exit(_x) => resume(0)
  }
  assert(ok)
}

test "sleep_ms is exported" {
  let _sleep_fn = sleep_ms
  assert(true)
}
