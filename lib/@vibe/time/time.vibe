//# Values

//# Functions

export fn sleep_ms(ms: Int) -> Unit with Async {
  sleep(ms)
}

fn first_line(lines: Array[String]) -> String {
  if Array::length(lines) == 0 {
    ""
  } else Array::get(lines, 0)
}

/// now_utc_iso: () -> String with Process
export fn now_utc_iso() -> String with Process {
  let lines = sh_lines("date -u +%Y-%m-%dT%H:%M:%SZ")
  first_line(lines)
}

/// now_local_date: () -> String with Process
export fn now_local_date() -> String with Process {
  let lines = sh_lines("date +%Y-%m-%d")
  first_line(lines)
}
