name = @vibe/checker/transport
version = 0.0.1
description =
  #|Pure checked-lowering transport shared by workers and compiler publication.
deps = {
  @vibe/cache : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

// This unit owns the existing strict v8 wire codec. It has no filesystem,
// graph scheduling or codegen responsibility; runtime keeps disk adapters.
fn append_checked_lowering_text(parts: Array[String], offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit
fn encode_checked_lowering(offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> String
fn decode_checked_lowering(text: String) -> Option[(Array[Int], Array[Int], Array[String])]
