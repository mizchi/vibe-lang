import @vibe/cache {
  compact_string_fingerprint, normalize_persistent_cache_text
}
import @vibe/core {
  array_empty
}
import @vibe/compiler/core {
  BindingOrigin,
  EffectOwner,
  EnvValueBinding,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_cache,
  env_name_index_at,
  env_name_index_length,
  env_value_binding,
  env_value_binding_with_origin,
  freeze_call_header_origin
}
import @vibe/checker/transport {
  append_checked_lowering_text, decode_checked_lowering
}

fn parse_int_strict(_ raw: String) -> Int with Exception {
  let len = String::length(raw)
  if len == 0 {
    throw("invalid persistent type env integer")
  } else {
    let mut i = 0
    if String::char_code_at(raw, at = 0) == '-' {
      if len == 1 || String::char_code_at(raw, at = 1) == '0' {
        throw("invalid persistent type env integer")
      } else {
        i = 1
      }
    } else if String::char_code_at(raw, at = 0) == '0' && len > 1 {
      throw("invalid persistent type env integer")
    } else {
      ()
    }
    while i < len {
      let c = String::char_code_at(raw, at = i)
      if c < '0' || c > '9' {
        throw("invalid persistent type env integer")
      } else {
        i = i + 1
      }
    }
    match Int::parse(raw) {
      Some(value) => value,
      None => throw("invalid persistent type env integer")
    }
  }
}

/// One compile-owned sequence of pieces. Nested segments reserve a prefix
/// slot, emit their children once, and fill the slot with the measured byte
/// length. No nested payload String or second traversal is needed. The only
/// payload copy is the final join; pieces and prefix slots live until then.
struct CacheTextWriter {
  parts: Array[String];
  mut byte_count: Int
}

// Only empty backing arrays are retained, never serialized values or an env.
// Nested digest writers lease separate arrays; the pool bounds daemon state.
let cache_text_parts_pool: Array[Array[String]] = []

fn cache_text_writer() -> CacheTextWriter {
  let count = Array::length(cache_text_parts_pool)
  let parts = if count > 0 {
    let reused = Array::get(cache_text_parts_pool, at = count - 1)
    Array::truncate(cache_text_parts_pool, length = count - 1)
    reused
  } else {
    array_empty()
  }
  CacheTextWriter::{ parts: parts, byte_count: 0 }
}

fn cache_text_finish(_ out: CacheTextWriter) -> String {
  let text = String::join(out.parts, sep = "")
  if Array::length(out.parts) <= 262144 && Array::length(cache_text_parts_pool) < 4 {
    Array::truncate(out.parts, length = 0)
    Array::push(cache_text_parts_pool, value = out.parts)
  } else ()
  text
}

fn cache_push(out: CacheTextWriter, text: String) -> Unit {
  Array::push(out.parts, value = text)
  out.byte_count = out.byte_count + String::length(text)
}

fn cache_segment(out: CacheTextWriter, text: String) -> Unit {
  cache_push(out = out, text = __to_string(String::length(text)))
  cache_push(out = out, text = ":")
  cache_push(out = out, text = text)
}

fn cache_reserve_segment(_ out: CacheTextWriter) -> Int {
  let slot = Array::length(out.parts)
  Array::push(out.parts, value = "")
  slot
}

fn cache_finish_segment(out: CacheTextWriter, slot: Int, body_start: Int) -> Unit {
  let prefix = String::concat(__to_string(out.byte_count - body_start), ":")
  Array::set(out.parts, at = slot, value = prefix)
  out.byte_count = out.byte_count + String::length(prefix)
}

fn write_count(out: CacheTextWriter, count: Int) -> Unit {
  cache_push(out = out, text = __to_string(count))
  cache_push(out = out, text = "[")
}

fn write_int_array(out: CacheTextWriter, items: Array[Int]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    cache_segment(out = out, text = __to_string(Array::get(items, at = i)))
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_string_array(out: CacheTextWriter, items: Array[String]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    cache_segment(out = out, text = Array::get(items, at = i))
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_bounds_array(out: CacheTextWriter, items: Array[(Int, Array[String])]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, at = i)
    cache_segment(out = out, text = __to_string(id))
    write_string_array(out = out, items = bounds)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_type_segment(out: CacheTextWriter, ty: Type) -> Unit {
  let slot = cache_reserve_segment(out)
  let start = out.byte_count
  write_type(out = out, ty = ty)
  cache_finish_segment(out = out, slot = slot, body_start = start)
}

fn write_type_array(out: CacheTextWriter, items: Array[Type]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    write_type_segment(out = out, ty = Array::get(items, at = i))
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_type(out: CacheTextWriter, ty: Type) -> Unit {
  match ty {
    CtInt => cache_push(out = out, text = "I"),
    CtInt32 => cache_push(out = out, text = "L"),
    CtUInt32 => cache_push(out = out, text = "M"),
    CtDouble => cache_push(out = out, text = "D"),
    CtFloat => cache_push(out = out, text = "W"),
    CtBool => cache_push(out = out, text = "B"),
    CtString => cache_push(out = out, text = "G"),
    CtChar => cache_push(out = out, text = "H"),
    CtUnit => cache_push(out = out, text = "U"),
    CtBytes => cache_push(out = out, text = "Y"),
    CtUnknown => cache_push(out = out, text = "X"),
    CtVar(id) => {
      cache_push(out = out, text = "V")
      cache_segment(out = out, text = __to_string(id))
    },
    CtConstructor(name, arity) => {
      cache_push(out = out, text = "J")
      cache_segment(out = out, text = name)
      cache_segment(out = out, text = __to_string(arity))
    },
    CtApplied(head, args) => {
      cache_push(out = out, text = "P")
      write_type_segment(out = out, ty = head)
      write_type_array(out = out, items = args)
    },
    CtEnum(name) => {
      cache_push(out = out, text = "E"); cache_segment(out = out, text = name)
    },
    CtStruct(name) => {
      cache_push(out = out, text = "R"); cache_segment(out = out, text = name)
    },
    CtArray(elem) => {
      cache_push(out = out, text = "A"); write_type(out = out, ty = elem)
    },
    CtOption(elem) => {
      cache_push(out = out, text = "O"); write_type(out = out, ty = elem)
    },
    CtTuple(elems) => {
      cache_push(out = out, text = "T"); write_type_array(out = out, items = elems)
    },
    CtFn(params, ret, effect_name) => {
      cache_push(out = out, text = "F")
      cache_segment(out = out, text = match effect_name {
        Some(name) => name,
        None => ""
      })
      write_type_array(out = out, items = params)
      write_type(out = out, ty = ret)
    },
    CtNamed(name, args) => {
      cache_push(out = out, text = "N")
      cache_segment(out = out, text = name)
      write_type_array(out = out, items = args)
    },
    CtForAll(vars, bounds, body) => {
      cache_push(out = out, text = "Q")
      write_int_array(out = out, items = vars)
      write_bounds_array(out = out, items = bounds)
      write_type(out = out, ty = body)
    },
    CtRecord(fields) => {
      cache_push(out = out, text = "K")
      write_count(out = out, count = Array::length(fields))
      let mut i = 0
      while i < Array::length(fields) {
        let (name, field_type) = Array::get(fields, at = i)
        cache_segment(out = out, text = name)
        write_type_segment(out = out, ty = field_type)
        i = i + 1
      }
      cache_push(out = out, text = "]")
    }
  }
}

fn write_type_expr_array(out: CacheTextWriter, items: Array[TypeExpr]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let slot = cache_reserve_segment(out)
    let start = out.byte_count
    write_type_expr(out = out, ty = Array::get(items, at = i))
    cache_finish_segment(out = out, slot = slot, body_start = start)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_type_expr(out: CacheTextWriter, ty: TypeExpr) -> Unit {
  match ty {
    TyName(name) => {
      cache_push(out = out, text = "n"); cache_segment(out = out, text = name)
    },
    TyApp(name, args) => {
      cache_push(out = out, text = "a")
      cache_segment(out = out, text = name)
      write_type_expr_array(out = out, items = args)
    },
    TyFn(params, ret, effect_name) => {
      cache_push(out = out, text = "f")
      match effect_name {
        Some(name) => {
          cache_push(out = out, text = "1"); cache_segment(out = out, text = name)
        },
        None => cache_push(out = out, text = "0")
      }
      write_type_expr_array(out = out, items = params)
      write_type_expr(out = out, ty = ret)
    },
    TyTuple(elems) => {
      cache_push(out = out, text = "t"); write_type_expr_array(out = out, items = elems)
    },
    TyUnit => cache_push(out = out, text = "u")
  }
}

fn write_string_bounds(out: CacheTextWriter, items: Array[(String, Array[String])]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, bounds) = Array::get(items, at = i)
    cache_segment(out = out, text = name)
    write_string_array(out = out, items = bounds)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_trait_methods(out: CacheTextWriter, items: Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, ret) = Array::get(items, at = i)
    cache_segment(out = out, text = name)
    write_type_expr_array(out = out, items = params)
    write_type_expr(out = out, ty = ret)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_trait_method_gens(out: CacheTextWriter, items: Array[(String, Array[String], Array[(String, Array[String])])]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, bounds) = Array::get(items, at = i)
    cache_segment(out = out, text = name)
    write_string_array(out = out, items = params)
    write_string_bounds(out = out, items = bounds)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_bindings(out: CacheTextWriter, items: Array[(String, Type)]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, ty) = Array::get(items, at = i)
    cache_segment(out = out, text = name)
    write_type(out = out, ty = ty)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

fn write_type_def(out: CacheTextWriter, def: TypeDef) -> Unit {
  match def {
    TDEnum(name, params, variants) => {
      cache_push(out = out, text = "E")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      write_count(out = out, count = Array::length(variants))
      let mut i = 0
      while i < Array::length(variants) {
        let (variant, fields) = Array::get(variants, at = i)
        cache_segment(out = out, text = variant)
        write_type_array(out = out, items = fields)
        i = i + 1
      }
      cache_push(out = out, text = "]")
    },
    TDStruct(name, fields, mut_fields, params) => {
      cache_push(out = out, text = "S")
      cache_segment(out = out, text = name)
      write_bindings(out = out, items = fields)
      write_string_array(out = out, items = mut_fields)
      write_string_array(out = out, items = params)
    },
    TDAlias(name, params, target) => {
      cache_push(out = out, text = "A")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      write_type(out = out, ty = target)
    },
    TDEffect(name, ops, params, kinds, owner) => {
      // ADR-0094: `Q` is an effect with a resource parameter, which also
      // carries its kinds; `K` keeps the earlier bytes for every other one.
      // ADR-0124: `H` is a host-provided `extern effect`, kinds included.
      let host = match owner {
        HostProvided => true,
        ProgramHandled => false
      }
      let resourced = host || env_codec_any_kind(kinds)
      cache_push(out = out, text = if host {
        "H"
      } else if resourced {
        "Q"
      } else {
        "K"
      })
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      if resourced {
        write_string_array(out = out, items = kinds)
      } else {
        ()
      }
      write_count(out = out, count = Array::length(ops))
      let mut i = 0
      while i < Array::length(ops) {
        let (op, args, ret) = Array::get(ops, at = i)
        cache_segment(out = out, text = op)
        write_type_array(out = out, items = args)
        write_type(out = out, ty = ret)
        i = i + 1
      }
      cache_push(out = out, text = "]")
    },
    TDEffectSet(name, members) => {
      cache_push(out = out, text = "Z")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = members)
    },
    // #4115: name, params, identity.
    TDOpaque(name, params, identity, origin) => {
      cache_push(out = out, text = "O")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      write_type(out = out, ty = identity)
      cache_segment(out = out, text = origin)
    }
  }
}

fn write_type_defs(out: CacheTextWriter, defs: Array[TypeDef]) -> Unit {
  write_count(out = out, count = Array::length(defs))
  let mut i = 0
  while i < Array::length(defs) {
    let slot = cache_reserve_segment(out)
    let start = out.byte_count
    write_type_def(out = out, def = Array::get(defs, at = i))
    cache_finish_segment(out = out, slot = slot, body_start = start)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

/// Parameter-default bits as one `0`/`1` character per parameter.
fn default_bits_text(_ flags: Array[Bool]) -> String {
  let bits = StringBuilder::new()
  for flag in flags {
    StringBuilder::push(bits, value = if flag {
      "1"
    } else {
      "0"
    })
  }
  StringBuilder::freeze(bits)
}

/// The inverse of `default_bits_text` for a header of `count` parameters.
/// A cache cannot invent a bit for an absent parameter, and an all-`0`
/// vector is a header without defaults spelled differently, so both refuse.
fn parse_default_bits(bits: String, count: Int) -> Array[Bool] with Exception {
  if String::length(bits) != count {
    throw("invalid persistent parameter defaults")
  } else {
    ()
  }
  let flags: Array[Bool] = []
  let mut any = false
  let mut i = 0
  while i < String::length(bits) {
    let bit = String::byte_at(bits, at = i)
    if bit != 48 && bit != 49 {
      throw("invalid persistent parameter default bit")
    } else {
      ()
    }
    Array::push(flags, value = bit == 49)
    any = any || bit == 49
    i = i + 1
  }
  if !any {
    throw("empty persistent parameter defaults")
  } else {
    ()
  }
  flags
}

fn write_binding_origin(out: CacheTextWriter, origin: BindingOrigin) -> Unit {
  match origin {
    BindingOriginMutableFunctionHeader(_) => write_binding_origin(out = out, origin = freeze_call_header_origin(origin)),
    BindingOriginUncertainFunctionHeader => cache_push(out = out, text = "A"),
    BindingOriginUnavailable => cache_push(out = out, text = "U"),
    BindingOriginDefaultedFunctionHeader(params, flags) => {
      cache_push(out = out, text = "D")
      write_string_array(out = out, items = params)
      cache_segment(out = out, text = default_bits_text(flags))
    },
    BindingOriginFunctionHeader(params) => {
      cache_push(out = out, text = "L")
      write_string_array(out = out, items = params)
    },
    // #3440: a header with parameter defaults takes its own tag (`H` / `J`)
    // and appends the bits, so a header without defaults keeps its bytes.
    BindingOriginModuleFunctionHeader(path, name, params, defaults) => {
      cache_push(out = out, text = if Array::length(defaults) > 0 {
        "H"
      } else {
        "F"
      })
      cache_segment(out = out, text = path)
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      if Array::length(defaults) > 0 {
        cache_segment(out = out, text = default_bits_text(defaults))
      } else {
        ()
      }
    },
    BindingOriginReExportFunctionHeader(path, name, params, defaults) => {
      cache_push(out = out, text = if Array::length(defaults) > 0 {
        "J"
      } else {
        "G"
      })
      cache_segment(out = out, text = path)
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      if Array::length(defaults) > 0 {
        cache_segment(out = out, text = default_bits_text(defaults))
      } else {
        ()
      }
    },
    BindingOriginModuleExport(path, name) => {
      cache_push(out = out, text = "M")
      cache_segment(out = out, text = path)
      cache_segment(out = out, text = name)
    },
    BindingOriginReExportSurface(path, name) => {
      cache_push(out = out, text = "R")
      cache_segment(out = out, text = path)
      cache_segment(out = out, text = name)
    }
  }
}

fn write_value_bindings(out: CacheTextWriter, items: Array[(String, EnvValueBinding)]) -> Unit {
  write_count(out = out, count = Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, binding) = Array::get(items, at = i)
    cache_segment(out = out, text = name)
    write_type(out = out, ty = binding.ty)
    write_binding_origin(out = out, origin = binding.origin)
    i = i + 1
  }
  cache_push(out = out, text = "]")
}

/// Bind both known and unavailable-name rows to the exact serialized facts.
/// A damaged empty/nonempty distinction must not become a trusted empty set.
fn show_wrapper_facts_digest(wrappers: Array[String], unknown: Array[String]) -> String {
  let out = cache_text_writer()
  write_string_array(out = out, items = wrappers)
  write_string_array(out = out, items = unknown)
  compact_string_fingerprint(cache_text_finish(out))
}

fn write_type_env(out: CacheTextWriter, env: TypeEnv) -> Unit {
  match env {
    EnvShowWrappers(wrappers, unknown, rest) => {
      cache_push(out = out, text = "H")
      write_string_array(out = out, items = wrappers)
      write_string_array(out = out, items = unknown)
      cache_segment(out = out, text = show_wrapper_facts_digest(wrappers = wrappers, unknown = unknown))
      write_type_env(out = out, env = rest)
    },
    EnvEmpty => cache_push(out = out, text = "0"),
    EnvBind(name, binding, rest) => {
      cache_push(out = out, text = "B")
      cache_segment(out = out, text = name)
      write_type(out = out, ty = binding.ty)
      write_binding_origin(out = out, origin = binding.origin)
      write_type_env(out = out, env = rest)
    },
    EnvMutCell(name, escapes, rest) => {
      cache_push(out = out, text = "M")
      cache_segment(out = out, text = name)
      cache_push(out = out, text = if escapes {
        "1"
      } else {
        "0"
      })
      write_type_env(out = out, env = rest)
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => {
      cache_push(out = out, text = "D")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = supers)
      cache_push(out = out, text = if is_auto {
        "1"
      } else {
        "0"
      })
      write_trait_methods(out = out, items = methods)
      write_type_env(out = out, env = rest)
      write_string_array(out = out, items = params)
      write_trait_method_gens(out = out, items = method_gens)
    },
    EnvTraitImpl(name, target, rest) => {
      cache_push(out = out, text = "I")
      cache_segment(out = out, text = name)
      write_type(out = out, ty = target)
      write_type_env(out = out, env = rest)
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => {
      cache_push(out = out, text = "G")
      cache_segment(out = out, text = name)
      write_string_array(out = out, items = params)
      write_string_bounds(out = out, items = bounds)
      write_type(out = out, ty = target)
      write_type_env(out = out, env = rest)
    },
    EnvTypeDefs(defs, selectable, rest) => {
      cache_push(out = out, text = "P")
      write_type_defs(out = out, defs = defs)
      write_string_array(out = out, items = selectable)
      write_type_env(out = out, env = rest)
    },
    EnvFlat(bindings) => {
      cache_push(out = out, text = "L"); write_value_bindings(out = out, items = bindings)
    },
    EnvCached(_, _, rest) => {
      // Rebuild from the authoritative chain once. Stale accelerator arrays
      // must never become persisted semantics, including their type rows.
      match env_cache(rest) {
        EnvCached(names, bindings, _) => {
          cache_push(out = out, text = "C")
          write_count(out = out, count = env_name_index_length(names))
          let mut i = 0
          while i < env_name_index_length(names) {
            cache_segment(out = out, text = env_name_index_at(index = names, row = i))
            i = i + 1
          }
          cache_push(out = out, text = "]")
          write_count(out = out, count = Array::length(bindings))
          i = 0
          while i < Array::length(bindings) {
            write_type_segment(out = out, ty = Array::get(bindings, at = i).ty)
            i = i + 1
          }
          cache_push(out = out, text = "]")
          write_type_env(out = out, env = rest)
        },
        _ => write_type_env(out = out, env = rest)
      }
    }
  }
}

fn write_type_env_segment(out: CacheTextWriter, env: TypeEnv) -> Unit {
  let slot = cache_reserve_segment(out)
  let start = out.byte_count
  write_type_env(out = out, env = env)
  cache_finish_segment(out = out, slot = slot, body_start = start)
}

fn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with Exception {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, at = i) != terminator {
    i = i + 1
  }
  if i == pos || i >= len {
    throw("invalid persistent type env payload")
  } else {
    let raw = text[pos: i]
    let count = parse_int_strict(raw)
    if count < 0 {
      throw("invalid persistent type env count")
    } else {
      (count, i + 1)
    }
  }
}

fn parse_segment(text: String, pos: Int) -> (String, Int) with Exception {
  let (seg_len, start) = parse_count_header(text = text, pos = pos, terminator = ':')
  let end = start + seg_len
  if end < start || end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (text[start: end], end)
  }
}

fn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text = text, pos = cursor)
    Array::push(items, value = parse_int_strict(raw))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next) = parse_segment(text = text, pos = cursor)
    Array::push(items, value = item)
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, after_id) = parse_segment(text = text, pos = cursor)
    let (bounds, next) = parse_string_array(text = text, pos = after_id)
    Array::push(items, value = (parse_int_strict(raw_id), bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_type_array(text: String, pos: Int) -> (Array[Type], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text = text, pos = cursor)
    let (item, end) = parse_cached_type(source = raw, pos = 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type")
    } else {
      Array::push(items, value = item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env type array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_cached_type(source: String, pos: Int) -> (Type, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    match String::char_code_at(source, at = pos) {
      'I' => (CtInt, pos + 1),
      'D' => (CtDouble, pos + 1),
      'W' => (CtFloat, pos + 1),
      'L' => (CtInt32, pos + 1),
      'M' => (CtUInt32, pos + 1),
      'B' => (CtBool, pos + 1),
      'G' => (CtString, pos + 1),
      'H' => (CtChar, pos + 1),
      'U' => (CtUnit, pos + 1),
      'Y' => (CtBytes, pos + 1),
      'X' => (CtUnknown, pos + 1),
      'V' => {
        let (raw, next) = parse_segment(text = source, pos = pos + 1)
        (CtVar(parse_int_strict(raw)), next)
      },
      'J' => {
        let (name, after_name) = parse_segment(text = source, pos = pos + 1)
        let (raw_arity, next) = parse_segment(text = source, pos = after_name)
        let arity = parse_int_strict(raw_arity)
        if arity <= 0 {
          throw("invalid persistent type constructor arity")
        } else {
          (CtConstructor(name, arity), next)
        }
      },
      'P' => {
        let (head_raw, after_head) = parse_segment(text = source, pos = pos + 1)
        let (head, head_end) = parse_cached_type(source = head_raw, pos = 0)
        if head_end != String::length(head_raw) {
          throw("invalid persistent applied type head")
        } else {
          let (args, next) = parse_type_array(text = source, pos = after_head)
          if Array::length(args) == 0 {
            throw("invalid persistent applied type arguments")
          } else {
            (CtApplied(head, args), next)
          }
        }
      },
      'E' => {
        let (name, next) = parse_segment(text = source, pos = pos + 1)
        (CtEnum(name), next)
      },
      'R' => {
        let (name, next) = parse_segment(text = source, pos = pos + 1)
        (CtStruct(name), next)
      },
      'A' => {
        let (elem, next) = parse_cached_type(source = source, pos = pos + 1)
        (CtArray(elem), next)
      },
      'O' => {
        let (elem, next) = parse_cached_type(source = source, pos = pos + 1)
        (CtOption(elem), next)
      },
      'T' => {
        let (elems, next) = parse_type_array(text = source, pos = pos + 1)
        (CtTuple(elems), next)
      },
      'F' => {
        let (effect, after_effect) = parse_segment(text = source, pos = pos + 1)
        let (params, after_params) = parse_type_array(text = source, pos = after_effect)
        let (ret, next) = parse_cached_type(source = source, pos = after_params)
        let effect_name = if String::length(effect) == 0 {
          None
        } else {
          Some(effect)
        }
        (CtFn(params, ret, effect_name), next)
      },
      'N' => {
        let (name, after_name) = parse_segment(text = source, pos = pos + 1)
        let (args, next) = parse_type_array(text = source, pos = after_name)
        (CtNamed(name, args), next)
      },
      'Q' => {
        let (vars, after_vars) = parse_int_array(text = source, pos = pos + 1)
        let (bounds, after_bounds) = parse_bounds_array(text = source, pos = after_vars)
        let (body, next) = parse_cached_type(source = source, pos = after_bounds)
        (CtForAll(vars, bounds, body), next)
      },
      // #1839: anonymous record — count-headed list of (name segment, type
      // segment) pairs, literal field order preserved.
      'K' => {
        let (count, start) = parse_count_header(text = source, pos = pos + 1, terminator = '[')
        let rfields = array_empty()
        let mut ki = 0
        let mut kcursor = start
        while ki < count {
          let (kname, after_name) = parse_segment(text = source, pos = kcursor)
          let (kraw, after_ty) = parse_segment(text = source, pos = after_name)
          let (kty, kend) = parse_cached_type(source = kraw, pos = 0)
          if kend != String::length(kraw) {
            throw("invalid persistent type env record field type")
          } else {
            Array::push(rfields, value = (kname, kty))
            kcursor = after_ty
            ki = ki + 1
          }
        }
        if kcursor >= String::length(source) || String::char_code_at(source, at = kcursor) != ']' {
          throw("invalid persistent type env record field list")
        } else {
          (CtRecord(rfields), kcursor + 1)
        }
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}

fn parse_type_expr_array(text: String, pos: Int) -> (Array[TypeExpr], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text = text, pos = cursor)
    let (item, end) = parse_type_expr(source = raw, pos = 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type expr")
    } else {
      Array::push(items, value = item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env type expr array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_type_expr(source: String, pos: Int) -> (TypeExpr, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type expr")
  } else {
    match String::char_code_at(source, at = pos) {
      'n' => {
        let (name, next) = parse_segment(text = source, pos = pos + 1)
        (TyName(name), next)
      },
      'a' => {
        let (name, after_name) = parse_segment(text = source, pos = pos + 1)
        let (args, next) = parse_type_expr_array(text = source, pos = after_name)
        (TyApp(name, args), next)
      },
      'f' => {
        let effect_pos = pos + 1
        if effect_pos >= String::length(source) {
          throw("invalid persistent type env function type expr")
        } else {
          let tag = String::char_code_at(source, at = effect_pos)
          let (effect_name, after_effect) = if tag == '0' {
            (None, effect_pos + 1)
          } else if tag == '1' {
            let (name, next) = parse_segment(text = source, pos = effect_pos + 1)
            (Some(name), next)
          } else {
            throw("invalid persistent type env function effect")
          }
          let (params, after_params) = parse_type_expr_array(text = source, pos = after_effect)
          let (ret, next) = parse_type_expr(source = source, pos = after_params)
          (TyFn(params, ret, effect_name), next)
        }
      },
      't' => {
        let (elems, next) = parse_type_expr_array(text = source, pos = pos + 1)
        (TyTuple(elems), next)
      },
      'u' => (TyUnit, pos + 1),
      _ => throw("invalid persistent type env type expr tag")
    }
  }
}

fn parse_string_bounds(text: String, pos: Int) -> (Array[(String, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text = text, pos = cursor)
    let (bounds, next) = parse_string_array(text = text, pos = after_name)
    Array::push(items, value = (name, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env generic bounds")
  } else {
    (items, cursor + 1)
  }
}

fn parse_trait_methods(text: String, pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text = text, pos = cursor)
    let (params, after_params) = parse_type_expr_array(text = text, pos = after_name)
    let (ret, next) = parse_type_expr(source = text, pos = after_params)
    Array::push(items, value = (name, params, ret))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env trait methods")
  } else {
    (items, cursor + 1)
  }
}

fn parse_trait_method_gens(text: String, pos: Int) -> (Array[(String, Array[String], Array[(String, Array[String])])], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text = text, pos = cursor)
    let (params, after_params) = parse_string_array(text = text, pos = after_name)
    let (bounds, next) = parse_string_bounds(text = text, pos = after_params)
    Array::push(items, value = (name, params, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env trait method generics")
  } else {
    (items, cursor + 1)
  }
}

/// An effect definition: `K` without resource kinds, `Q` with them
/// (ADR-0094, `with_kinds`).
fn parse_effect_type_def(text: String, pos: Int, with_kinds: Bool, owner: EffectOwner) -> (TypeDef, Int) with Exception {
  let (name, after_name) = parse_segment(text = text, pos = pos + 1)
  let (params, after_param_names) = parse_string_array(text = text, pos = after_name)
  let (kinds, after_params) = if with_kinds {
    parse_string_array(text = text, pos = after_param_names)
  } else {
    let none: Array[String] = []
    for _p in params {
      Array::push(none, value = "")
    }
    (none, after_param_names)
  }
  if Array::length(kinds) != Array::length(params) {
    throw("invalid persistent effect definition")
  } else {
    ()
  }
  let (count, start) = parse_count_header(text = text, pos = after_params, terminator = '[')
  let ops = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (op, after_op) = parse_segment(text = text, pos = cursor)
    let (args, after_args) = parse_type_array(text = text, pos = after_op)
    let (ret, next) = parse_cached_type(source = text, pos = after_args)
    Array::push(ops, value = (op, args, ret))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent effect definition")
  } else {
    (TDEffect(name, ops, params, kinds, owner), cursor + 1)
  }
}

fn parse_type_def(text: String, pos: Int) -> (TypeDef, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type definition")
  } else {
    match String::char_code_at(text, at = pos) {
      'E' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (count, start) = parse_count_header(text = text, pos = after_params, terminator = '[')
        let variants = array_empty()
        let mut i = 0
        let mut cursor = start
        while i < count {
          let (variant, after_variant) = parse_segment(text = text, pos = cursor)
          let (fields, next) = parse_type_array(text = text, pos = after_variant)
          Array::push(variants, value = (variant, fields))
          cursor = next
          i = i + 1
        }
        if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
          throw("invalid persistent enum definition")
        } else {
          (TDEnum(name, params, variants), cursor + 1)
        }
      },
      'S' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (fields, after_fields) = parse_bindings(text = text, pos = after_name)
        let (mut_fields, after_mut_fields) = parse_string_array(text = text, pos = after_fields)
        let (params, next) = parse_string_array(text = text, pos = after_mut_fields)
        (TDStruct(name, fields, mut_fields, params), next)
      },
      'A' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (target, next) = parse_cached_type(source = text, pos = after_params)
        (TDAlias(name, params, target), next)
      },
      'K' => parse_effect_type_def(text = text, pos = pos, with_kinds = false, owner = ProgramHandled),
      'Q' => parse_effect_type_def(text = text, pos = pos, with_kinds = true, owner = ProgramHandled),
      'H' => parse_effect_type_def(text = text, pos = pos, with_kinds = true, owner = HostProvided),
      'Z' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (members, next) = parse_string_array(text = text, pos = after_name)
        (TDEffectSet(name, members), next)
      },
      'O' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (identity, after_identity) = parse_cached_type(source = text, pos = after_params)
        let (origin, next) = parse_segment(text = text, pos = after_identity)
        (TDOpaque(name, params, identity, origin), next)
      },
      _ => throw("invalid persistent type definition tag")
    }
  }
}

fn parse_type_defs(text: String, pos: Int) -> (Array[TypeDef], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let defs = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, after_raw) = parse_segment(text = text, pos = cursor)
    let (def, end) = parse_type_def(text = raw, pos = 0)
    if end != String::length(raw) {
      throw("invalid persistent type definition payload")
    } else {
      Array::push(defs, value = def)
      cursor = after_raw
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type definitions")
  } else {
    (defs, cursor + 1)
  }
}

fn parse_binding_origin(text: String, pos: Int) -> (BindingOrigin, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent binding origin")
  } else {
    match String::char_code_at(text, at = pos) {
      'U' => (BindingOriginUnavailable, pos + 1),
      'A' => (BindingOriginUncertainFunctionHeader, pos + 1),
      'D' => {
        let (params, after_params) = parse_string_array(text = text, pos = pos + 1)
        let (bits, next) = parse_segment(text = text, pos = after_params)
        (BindingOriginDefaultedFunctionHeader(params, parse_default_bits(bits = bits, count = Array::length(params))), next)
      },
      'L' => {
        let (params, next) = parse_string_array(text = text, pos = pos + 1)
        (BindingOriginFunctionHeader(params), next)
      },
      'F' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, after_name) = parse_segment(text = text, pos = after_path)
        let (params, next) = parse_string_array(text = text, pos = after_name)
        (BindingOriginModuleFunctionHeader(path, name, params, []), next)
      },
      'H' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, after_name) = parse_segment(text = text, pos = after_path)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (bits, next) = parse_segment(text = text, pos = after_params)
        (BindingOriginModuleFunctionHeader(path, name, params, parse_default_bits(bits = bits, count = Array::length(params))), next)
      },
      'G' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, after_name) = parse_segment(text = text, pos = after_path)
        let (params, next) = parse_string_array(text = text, pos = after_name)
        (BindingOriginReExportFunctionHeader(path, name, params, []), next)
      },
      'J' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, after_name) = parse_segment(text = text, pos = after_path)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (bits, next) = parse_segment(text = text, pos = after_params)
        (BindingOriginReExportFunctionHeader(path, name, params, parse_default_bits(bits = bits, count = Array::length(params))), next)
      },
      'M' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, next) = parse_segment(text = text, pos = after_path)
        (BindingOriginModuleExport(path, name), next)
      },
      'R' => {
        let (path, after_path) = parse_segment(text = text, pos = pos + 1)
        let (name, next) = parse_segment(text = text, pos = after_path)
        (BindingOriginReExportSurface(path, name), next)
      },
      _ => throw("invalid persistent binding origin tag")
    }
  }
}

fn parse_value_bindings(text: String, pos: Int) -> (Array[(String, EnvValueBinding)], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text = text, pos = cursor)
    let (ty, after_ty) = parse_cached_type(source = text, pos = after_name)
    let (origin, next) = parse_binding_origin(text = text, pos = after_ty)
    Array::push(items, value = (name, env_value_binding_with_origin(ty = ty, origin = origin)))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent TypeEnv value bindings")
  } else {
    (items, cursor + 1)
  }
}

fn parse_bindings(text: String, pos: Int) -> (Array[(String, Type)], Int) with Exception {
  let (count, start) = parse_count_header(text = text, pos = pos, terminator = '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text = text, pos = cursor)
    let (ty, next) = parse_cached_type(source = text, pos = after_name)
    Array::push(items, value = (name, ty))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, at = cursor) != ']' {
    throw("invalid persistent type env bindings")
  } else {
    (items, cursor + 1)
  }
}

fn parse_persistent_type_env_payload(text: String, pos: Int) -> (TypeEnv, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type env")
  } else {
    match String::char_code_at(text, at = pos) {
      'H' => {
        let (wrappers, after_wrappers) = parse_string_array(text = text, pos = pos + 1)
        let (unknown, after_unknown) = parse_string_array(text = text, pos = after_wrappers)
        let (digest, after_digest) = parse_segment(text = text, pos = after_unknown)
        if digest != show_wrapper_facts_digest(wrappers = wrappers, unknown = unknown) {
          throw("invalid persistent Show-wrapper facts digest")
        }
        let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_digest)
        (EnvShowWrappers(wrappers, unknown, rest), next)
      },
      '0' => (EnvEmpty, pos + 1),
      'B' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (ty, after_ty) = parse_cached_type(source = text, pos = after_name)
        let (origin, after_origin) = parse_binding_origin(text = text, pos = after_ty)
        let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_origin)
        (EnvBind(name, env_value_binding_with_origin(ty = ty, origin = origin), rest), next)
      },
      'M' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        if after_name >= String::length(text) {
          throw("invalid persistent type env mut escape flag")
        } else {
          let esc_tag = String::char_code_at(text, at = after_name)
          let escapes = if esc_tag == '0' {
            false
          } else if esc_tag == '1' {
            true
          } else {
            throw("invalid persistent type env mut escape flag")
          }
          let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_name + 1)
          (EnvMutCell(name, escapes, rest), next)
        }
      },
      'D' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (supers, after_supers) = parse_string_array(text = text, pos = after_name)
        if after_supers >= String::length(text) {
          throw("invalid persistent type env trait auto flag")
        } else {
          let auto_tag = String::char_code_at(text, at = after_supers)
          let is_auto = if auto_tag == '0' {
            false
          } else if auto_tag == '1' {
            true
          } else {
            throw("invalid persistent type env trait auto flag")
          }
          let (methods, after_methods) = parse_trait_methods(text = text, pos = after_supers + 1)
          let (rest, after_rest) = parse_persistent_type_env_payload(text = text, pos = after_methods)
          let (params, after_params) = parse_string_array(text = text, pos = after_rest)
          let (method_gens, next) = parse_trait_method_gens(text = text, pos = after_params)
          (EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens), next)
        }
      },
      'I' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (target, after_target) = parse_cached_type(source = text, pos = after_name)
        let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_target)
        (EnvTraitImpl(name, target, rest), next)
      },
      'G' => {
        let (name, after_name) = parse_segment(text = text, pos = pos + 1)
        let (params, after_params) = parse_string_array(text = text, pos = after_name)
        let (bounds, after_bounds) = parse_string_bounds(text = text, pos = after_params)
        let (target, after_target) = parse_cached_type(source = text, pos = after_bounds)
        let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_target)
        (EnvTraitImplGen(name, params, bounds, target, rest), next)
      },
      'P' => {
        let (defs, after_defs) = parse_type_defs(text = text, pos = pos + 1)
        let (selectable, after_selectable) = parse_string_array(text = text, pos = after_defs)
        let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_selectable)
        (EnvTypeDefs(defs, selectable, rest), next)
      },
      'L' => {
        let (bindings, next) = parse_value_bindings(text = text, pos = pos + 1)
        (EnvFlat(bindings), next)
      },
      'C' => {
        let (names, after_names) = parse_string_array(text = text, pos = pos + 1)
        let (types, after_types) = parse_type_array(text = text, pos = after_names)
        if Array::length(names) != Array::length(types) {
          throw("invalid persistent type env cached shape")
        } else {
          let (rest, next) = parse_persistent_type_env_payload(text = text, pos = after_types)
          // Serialized cached arrays are untrusted acceleration data. Rebuild
          // them from the decoded chain so malformed indexes cannot change
          // lookup semantics.
          (env_cache(rest), next)
        }
      },
      _ => throw("invalid persistent type env tag")
    }
  }
}

/// Encode dependency occurrences in order, retaining duplicates.
export fn encode_checked_dependency_paths(_ deps: Array[String]) -> String {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, at = 0))
  } else {
    let out = cache_text_writer()
    cache_push(out = out, text = "version\t2\n")
    write_string_array(out = out, items = deps)
    cache_text_finish(out)
  }
}

/// Decode only the strict v10 environment envelope; malformed payloads throw.
export fn decode_checked_environment(_ text: String) -> Option[TypeEnv] with Exception {
  let normalized = normalize_persistent_cache_text(text)
  let header = "version\t10\nenv\t"
  let header_len = String::length(header)
  if String::length(normalized) < header_len || normalized[0: header_len] != header {
    None
  } else {
    let (payload, after_payload) = parse_segment(text = normalized, pos = header_len)
    if after_payload + 1 != String::length(normalized) || String::char_code_at(normalized, at = after_payload) != '\n' {
      throw("invalid persistent type env v10 envelope")
    } else {
      let (env, end) = parse_persistent_type_env_payload(text = payload, pos = 0)
      if end != String::length(payload) {
        throw("invalid persistent type env v10 payload")
      } else {
        Some(env)
      }
    }
  }
}

/// Encode the canonical v10 worker/dependency environment representation.
export fn encode_checked_environment(_ env: TypeEnv) -> String {
  let out = cache_text_writer()
  cache_push(out = out, text = "version\t10\nenv\t")
  write_type_env_segment(out = out, env = env)
  cache_push(out = out, text = "\n")
  cache_text_finish(out)
}

/// Encode a v11 environment with absent or complete v8 lowering.
export fn encode_checked_module_product(env: TypeEnv, lowering: Option[(Array[Int], Array[Int], Array[String])]) -> String {
  let out = cache_text_writer()
  cache_push(out = out, text = "version\t11\nenv\t")
  write_type_env_segment(out = out, env = env)
  cache_push(out = out, text = "\n")
  match lowering {
    Some((offsets, eq_offs, eq_keys)) => append_checked_lowering_text(parts = out.parts, offsets = offsets, eq_offs = eq_offs, eq_keys = eq_keys),
    None => cache_push(out = out, text = "lowering\tmissing\n")
  }
  cache_text_finish(out)
}

/// Reject an entire v11 product when its environment or lowering is malformed.
export fn decode_checked_module_product(_ text: String) -> Option[(TypeEnv, Option[(Array[Int], Array[Int], Array[String])])] {
  handle {
    let normalized = normalize_persistent_cache_text(text)
    let header = "version\t11\nenv\t"
    if !String::starts_with(normalized, prefix = header) {
      None
    } else {
      let (payload, end) = parse_segment(text = normalized, pos = String::length(header))
      if end >= String::length(normalized) || String::char_code_at(normalized, at = end) != '\n' {
        None
      } else {
        let (env, consumed) = parse_persistent_type_env_payload(text = payload, pos = 0)
        if consumed != String::length(payload) {
          None
        } else {
          let section = normalized[end + 1: String::length(normalized)]
          if section == "lowering\tmissing\n" {
            Some((env, None))
          } else {
            match decode_checked_lowering(section) {
              Some(rows) => Some((env, Some(rows))),
              None => None
            }
          }
        }
      }
    }
  } with { Exception::Throw(_) => None }
}

/// Decode dependency bytes; runtime validates current package resolution.
export fn decode_checked_dependency_paths(text: String, cache_path: String) -> Array[String] with Exception {
  let normalized = normalize_persistent_cache_text(text)
  if String::length(normalized) == 0 {
    array_empty()
  } else {
    let v2_prefix = "version\t2\n"
    let v3_prefix = "version\t3\n"
    if String::starts_with(normalized, prefix = v2_prefix) {
      let body = normalized[String::length(v2_prefix): String::length(normalized)]
      let (deps, end_pos) = parse_string_array(text = body, pos = 0)
      if end_pos == String::length(body) {
        deps
      } else {
        throw(String::concat("invalid persistent dep list body: ", cache_path))
      }
    } else if String::starts_with(normalized, prefix = v3_prefix) {
      let dep = normalized[String::length(v3_prefix): String::length(normalized)]
      if String::length(dep) == 0 {
        array_empty()
      } else {
        [dep]
      }
    } else {
      throw(String::concat("invalid persistent dep list header: ", cache_path))
    }
  }
}

fn env_codec_any_kind(_ kinds: Array[String]) -> Bool {
  let mut found = false
  for k in kinds {
    if k != "" {
      found = true
    }
  }
  found
}
