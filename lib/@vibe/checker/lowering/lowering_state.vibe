import @vibe/core {
  array_empty
}
import @vibe/ast {
  TypeExpr, impl_target_from_key, impl_target_key
}
import @vibe/compiler/core {
  namespace_private_renamer_for_path, resolved_callee_row_rebase, typed_render_refuse_key
}
import @vibe/compiler/checker {
  typed_lowering_enc_offset, typed_lowering_enc_tag
}

let module_typed_lowering_memo_paths: Array[String] = []

let module_typed_lowering_memo_fps: Array[String] = []

// Exact source witnesses belong to the same row as its checked fingerprint.
// A path alone must never authorize restoring identities into another text.
let module_typed_lowering_memo_sources: Array[Option[String]] = []

let module_typed_lowering_memo_offsets: Array[Array[Int]] = []

// #2441: the typed-`==` rows ride the same memo lifecycle as the Int table
// above -- same reset, same put/lookup keys -- as two parallel per-module
// arrays: anchor offsets and the impl_target_key of the operand TypeExpr.
let module_typed_lowering_memo_eq_offs: Array[Array[Int]] = []

let module_typed_lowering_memo_eq_keys: Array[Array[String]] = []

export fn reset_checked_lowering_memo() -> Unit {
  Array::truncate(module_typed_lowering_memo_paths, 0)
  Array::truncate(module_typed_lowering_memo_fps, 0)
  Array::truncate(module_typed_lowering_memo_sources, 0)
  Array::truncate(module_typed_lowering_memo_offsets, 0)
  Array::truncate(module_typed_lowering_memo_eq_offs, 0)
  Array::truncate(module_typed_lowering_memo_eq_keys, 0)
}

export fn record_checked_lowering(path: String, fingerprint: String, offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found = false
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      if Array::get(module_typed_lowering_memo_fps, i) != fingerprint {
        Array::set(module_typed_lowering_memo_sources, i, None)
      }
      Array::set(module_typed_lowering_memo_fps, i, fingerprint)
      Array::set(module_typed_lowering_memo_offsets, i, offsets)
      Array::set(module_typed_lowering_memo_eq_offs, i, eq_offs)
      Array::set(module_typed_lowering_memo_eq_keys, i, eq_keys)
      found = true
      i = n
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(module_typed_lowering_memo_paths, path)
    Array::push(module_typed_lowering_memo_fps, fingerprint)
    Array::push(module_typed_lowering_memo_sources, None)
    Array::push(module_typed_lowering_memo_offsets, offsets)
    Array::push(module_typed_lowering_memo_eq_offs, eq_offs)
    Array::push(module_typed_lowering_memo_eq_keys, eq_keys)
  } else {
    ()
  }
}

// Publish only after the checker or cache acceptance validated this source
// against fingerprint. An unbound legacy row cannot restore callee identities.
export fn bind_checked_lowering_source(path: String, fingerprint: String, source: String) -> Unit {
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_paths) {
    if Array::get(module_typed_lowering_memo_paths, i) == path && Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      Array::set(module_typed_lowering_memo_sources, i, Some(source))
    }
    i = i + 1
  }
}

fn module_typed_lowering_source_for_fp(fingerprint: String) -> Option[String] {
  let mut result: Option[String] = None
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_fps) {
    if Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      match Array::get(module_typed_lowering_memo_sources, i) {
        Some(source) => {
          result = Some(source)
          i = Array::length(module_typed_lowering_memo_fps)
        },
        None => i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  result
}

export fn checked_lowering_for_source(path: String, source: String) -> Option[Array[Int]] {
  let mut result: Option[Array[Int]] = None
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_paths) {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      if Array::get(module_typed_lowering_memo_sources, i) == Some(source) {
        result = Some(Array::get(module_typed_lowering_memo_offsets, i))
      }
      i = Array::length(module_typed_lowering_memo_paths)
    } else {
      i = i + 1
    }
  }
  result
}

/// #2449: the in-memory module walk's publication point. `ensure_fingerprint`
/// (runtime.vibe) checks each module of the "sources passed in memory" family
/// with the same observation the FS lane uses, and this is where its table
/// reaches the memo the merge consumers read by path.
///
/// It is a thin wrapper rather than an exported `record_checked_lowering`
/// so the `None` case -- the parse carried no offsets, which the located-channel
/// refusal reports -- is normalized HERE, in the file that owns the memo, to the
/// empty table that classifies nothing.
export fn publish_checked_lowering(path: String, fingerprint: String, offsets: Option[Array[Int]], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit {
  record_checked_lowering(path, fingerprint, match offsets {
    Some(table) => table,
    None => array_empty()
  }, eq_offs, eq_keys)
}

export fn checked_lowering_by_fingerprint(fingerprint: String) -> Option[(Array[Int], Array[Int], Array[String])] {
  let n = Array::length(module_typed_lowering_memo_fps)
  let mut i = 0
  let mut found: Option[(Array[Int], Array[Int], Array[String])] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      found = Some((Array::get(module_typed_lowering_memo_offsets, i), Array::get(module_typed_lowering_memo_eq_offs, i), Array::get(module_typed_lowering_memo_eq_keys, i)))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// The consumer query: this module's Double call-result offsets, in its own
/// offset space, as recorded by the most recent check (or unified-record load) of
/// `path` in this process. `None` means the module was never stepped here --
/// the FS lanes treat that file as contributing no offsets, which degrades
/// that file's calls to the pre-#2158 syntactic classifier rather than to a
/// wrong answer.
export fn checked_lowering_for_path(path: String) -> Option[Array[Int]] {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found: Option[Array[Int]] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      found = Some(Array::get(module_typed_lowering_memo_offsets, i))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #2441: the typed-`==` sibling of the query above -- this module's
/// `(anchor offset, operand TypeExpr key)` rows, in its own offset space.
/// `None` degrades that file's `==` sites to the syntactic classifiers,
/// exactly like the Int table's consumer.
export fn checked_eq_rows_for_path(path: String) -> Option[(Array[Int], Array[String])] {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found: Option[(Array[Int], Array[String])] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      found = Some((Array::get(module_typed_lowering_memo_eq_offs, i), Array::get(module_typed_lowering_memo_eq_keys, i)))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #2391: shift each file's per-module typed-lowering table (recorded by the
/// modular check in the file's OWN offset space) by that file's base in a
/// disjoint-offset merge, and union them into one table. Rows are tag-encoded
/// (offset * 8 + tag, see typed_lowering_enc in the checker), so the rebase
/// uses core/resolved_callee for all tags, retaining the tag and
/// operation identity bits. A file the modular check
/// never stepped in this process contributes nothing, which degrades ITS
/// sites to the syntactic classifiers -- deterministically, because the reuse
/// arms in typecheck_fs.vibe re-check a module whose checked lowering table is
/// missing rather than reusing half a cache entry.
///
/// #2449: this lives beside the memo it reads rather than in one merge's
/// file, because BOTH merges need it -- the grouped file merge
/// (entry/compiler/file_compile) and the inline-source merge
/// (entry/compiler/fs_compile). A second copy of the decoder below is the
/// shape that goes wrong quietly: a tag added on one side classifies nothing
/// on the other, and an empty channel looks exactly like "nothing to
/// classify".
export fn union_checked_lowering(flat_paths: Array[String], flat_bases: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(flat_paths) {
    match checked_lowering_for_path(Array::get(flat_paths, i)) {
      Some(offsets) => {
        let base = Array::get(flat_bases, i)
        let mut j = 0
        while j < Array::length(offsets) {
          let row = Array::get(offsets, j)
          Array::push(out, resolved_callee_row_rebase(row, base))
          j = j + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
  out
}

/// The per-file union plus the alias-collision clones' duplicated entries
/// (already in merge space and encoded, see the clone emission in each merge).
export fn union_checked_lowering_with_clones(flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets: Array[Int]) -> Array[Int] {
  let out = union_checked_lowering(flat_paths, flat_bases)
  let mut ci = 0
  while ci < Array::length(clone_float_offsets) {
    Array::push(out, Array::get(clone_float_offsets, ci))
    ci = ci + 1
  }
  out
}

/// #2441 (Codex round 1 on #2443): a module-PRIVATE nominal type in an eq
/// row must follow the merge's private-type rename, or the row still names
/// the source spelling while the merged declarations name the mangled one.
/// Measured before this mapping: a dependency's private `Point` row, with
/// the ENTRY declaring a different `Point`, dispatched the entry's
/// `Point::equals` on the dependency's values -- `true` for content-unequal
/// pairs. The mapping consults the SAME rename record the merge populated
/// (#2205): a name is rewritten to `namespace_private_name(path, name)`
/// exactly when that mangled spelling is recorded as a rename of this name,
/// so an exported (unrenamed) type, a builtin head, and the entry file's
/// own types all pass through unchanged. `rename` is
/// `namespace_private_renamer_for_path(path)`, built once per file.
fn eq_key_rename_ty(rename: (String) -> String, te: TypeExpr) -> TypeExpr {
  match te {
    TyName(n) => TyName(rename(n)),
    TyApp(n, args) => TyApp(rename(n), for a in args {
      eq_key_rename_ty(rename, a)
    }),
    TyTuple(items) => TyTuple(for a in items {
      eq_key_rename_ty(rename, a)
    }),
    _ => te
  }
}

/// #2441: the typed-`==` union -- the same per-file walk as
/// union_checked_lowering, but the rows are (offset, TypeExpr
/// key) pairs, so the rebase adds the plain byte base (no tag bits to
/// preserve) and each key's nominal names are rebased through the merge's
/// rename record (eq_key_rename_ty above). A key that does not parse is
/// dropped rather than passed through -- fail closed. Alias-collision clone
/// statements contribute no eq rows -- a cloned definition's `==` sites
/// simply degrade to the syntactic classifiers, which is today's behavior
/// for every site, never a wrong comparator.
export fn union_checked_eq_rows(flat_paths: Array[String], flat_bases: Array[Int]) -> (Array[Int], Array[String]) {
  let out_offs: Array[Int] = []
  let out_keys: Array[String] = []
  let mut i = 0
  while i < Array::length(flat_paths) {
    match checked_eq_rows_for_path(Array::get(flat_paths, i)) {
      Some((eq_offs, eq_keys)) => {
        let rename = namespace_private_renamer_for_path(Array::get(flat_paths, i))
        let base = Array::get(flat_bases, i)
        let mut j = 0
        while j < Array::length(eq_offs) {
          match impl_target_from_key(Array::get(eq_keys, j)) {
            Some(te) => {
              Array::push(out_offs, Array::get(eq_offs, j) + base)
              Array::push(out_keys, impl_target_key(eq_key_rename_ty(rename, te)))
            },
            None => ()
          }
          j = j + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
  (out_offs, out_keys)
}

/// #2391 slice 2: decode one merged typed-lowering table into its channels --
/// Double call-result offsets (tag 0) for `CompileCtx.float_call_offsets`,
/// String relational anchors (tag 1) and String `+` anchors (tag 2) for the
/// rewrite pass, and the render/`eq` argument offsets the checker typed as
/// `Int` (tag 3), `Double` (tag 4) or `Bool` (tag 5). The encoding is the
/// checker's typed_lowering_enc; the enc/dec pair lives on the checker boundary
/// so the two sides cannot drift.
export fn split_checked_lowering(enc: Array[Int]) -> (Array[Int], Array[Int], Array[Int], Array[Int], Array[Int]) {
  let floats: Array[Int] = []
  let rels: Array[Int] = []
  let pluses: Array[Int] = []
  let int_renders: Array[Int] = []
  let bool_renders: Array[Int] = []
  let mut i = 0
  while i < Array::length(enc) {
    let value = Array::get(enc, i)
    let tag = typed_lowering_enc_tag(value)
    let off = typed_lowering_enc_offset(value)
    if tag == 0 {
      Array::push(floats, off)
    } else if tag == 1 {
      Array::push(rels, off)
    } else if tag == 2 {
      Array::push(pluses, off)
    } else if tag == 3 {
      // #2424: render (`__to_string` / `Int::to_string`) and `eq` ARGUMENT
      // offsets the checker typed as `Int`.
      Array::push(int_renders, off)
    } else if tag == 4 {
      // #2424: the Double half of the same argument set, unioned into the
      // Double channel. The two tags stay distinct through the encoding
      // because their KEYS differ -- tag 0 is a call node's own offset, tag 4
      // is `typed_lowering_arg_offset` (a projection answers with its
      // field-name offset) -- and they can share one array here because the
      // consumers read it with `typed_lowering_arg_offset`, which agrees with
      // the call offset on a call node.
      Array::push(floats, off)
    } else if tag == 5 {
      // #2462/#2464: the Bool half of the same argument set. Its own array
      // rather than unioned into another: the consumers are the
      // `*_expr_is_boolish` predicates, and a Bool offset reaching
      // `ts_known_int` would render `true` as a number -- the exact failure
      // this channel exists to stop.
      Array::push(bool_renders, off)
    } else if tag == 6 {
      // #2987: a render argument the checker typed as a shape the runtime
      // renderer cannot print. It rides the Int array under a NEGATIVE key
      // (`typed_render_refuse_key`), which no Int lookup can ask for, and the
      // `__to_string` lowering refuses the site instead of printing an address.
      Array::push(int_renders, typed_render_refuse_key(off))
    } else {
      // Tag 7 restores resolved callees before merge, outside these channels.
      // Dropping an unknown row degrades its site to
      // the syntactic classifiers rather than misclassifying another offset.
      ()
    }
    i = i + 1
  }
  (floats, rels, pluses, int_renders, bool_renders)
}

/// #2449 (Codex review on #2453): rebind `path`'s typed-lowering rows from the
/// memo BY FINGERPRINT, and report whether it could.
///
/// The in-memory module walk (`ensure_fingerprint`, runtime.vibe) skips the
/// check when the `TypeDb` already holds this module's fingerprint, and a skip
/// publishes nothing -- so the merge downstream reads whatever
/// `checked_lowering_for_path` happens to hold for that path,
/// which another compile in the same process may have overwritten. Measured
/// before this: rows for a path went 1 -> 0 across a warm-db re-prepare.
///
/// `false` means the rows are not available for this fingerprint, and the
/// caller must fall through to a real check rather than proceed -- the same
/// fail-closed rule `ensure_checked_lowering` gives the FS lane.
/// This is the memo-only sibling of that function: the in-memory walk carries
/// no `Fs` effect, so there is no disk record to fall back on.
///
/// Binding the hit to THIS path (not just proving the fingerprint) is the
/// #2425 rule: `build_fingerprint` excludes the module's own path, so two
/// byte-identical modules share a fingerprint and the consumer looks up by
/// path.
export fn rebind_checked_lowering(path: String, fingerprint: String) -> Bool {
  match checked_lowering_by_fingerprint(fingerprint) {
    Some((offsets, eq_offs, eq_keys)) => {
      let source = module_typed_lowering_source_for_fp(fingerprint)
      record_checked_lowering(path, fingerprint, offsets, eq_offs, eq_keys)
      match source {
        Some(text) => bind_checked_lowering_source(path, fingerprint, text),
        None => ()
      }
      true
    },
    None => false
  }
}

/// The unified cache loader has already validated and hydrated both outputs.
/// Rebind by fingerprint so byte-identical modules at distinct paths agree.
export fn ensure_checked_lowering(path: String, fingerprint: String) -> Bool {
  rebind_checked_lowering(path, fingerprint)
}

// The accepting caller has validated a persistent/transported fingerprint for
// its current source. Bind that witness before any subsequent merge parse.
export fn ensure_checked_lowering_for_source(path: String, fingerprint: String, source: String) -> Bool {
  if rebind_checked_lowering(path, fingerprint) {
    bind_checked_lowering_source(path, fingerprint, source)
    true
  } else {
    false
  }
}
