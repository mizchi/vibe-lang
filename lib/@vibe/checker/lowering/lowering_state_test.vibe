import ./lowering_state.vibe {
  bind_checked_lowering_source,
  checked_eq_rows_for_path,
  checked_eq_rows_for_source,
  checked_lowering_for_path,
  checked_lowering_for_source,
  ensure_checked_lowering_for_source,
  publish_checked_lowering,
  rebind_checked_lowering,
  record_checked_lowering,
  reset_checked_lowering_memo,
  split_checked_lowering,
  union_checked_lowering
}

test "a changed fingerprint cannot reuse another source's lowering identities" {
  reset_checked_lowering_memo()
  record_checked_lowering(path = "module", fingerprint = "first", offsets = [80], eq_offs = [
    11
  ], eq_keys = ["Int"])
  bind_checked_lowering_source(path = "module", fingerprint = "first", source = "first source")
  assert(checked_lowering_for_source(path = "module", source = "first source") == Some([
    80
  ]))
  assert(checked_lowering_for_source(path = "module", source = "other source") == None)
  bind_checked_lowering_source(path = "module", fingerprint = "wrong", source = "other source")
  assert(checked_lowering_for_source(path = "module", source = "other source") == None)
  record_checked_lowering(path = "module", fingerprint = "first", offsets = [88], eq_offs = [
    12
  ], eq_keys = ["Int"])
  assert(checked_lowering_for_source(path = "module", source = "first source") == Some([
    88
  ]))
  record_checked_lowering(path = "module", fingerprint = "second", offsets = [
    96
  ], eq_offs = [], eq_keys = [])
  assert(checked_lowering_for_source(path = "module", source = "first source") == None)
}

test "typed-eq rows answer only for the source text that was checked (#3625)" {
  reset_checked_lowering_memo()
  record_checked_lowering(path = "entry", fingerprint = "fp", offsets = [80], eq_offs = [
    11,
    17
  ], eq_keys = ["Int", "Float"])
  assert(checked_eq_rows_for_source(path = "entry", source = "checked text") == None)
  bind_checked_lowering_source(path = "entry", fingerprint = "fp", source = "checked text")
  assert(checked_eq_rows_for_source(path = "entry", source = "checked text") == Some(([
    11,
    17
  ], ["Int", "Float"])))
  assert(checked_eq_rows_for_source(path = "entry", source = "edited text") == None)
  assert(checked_eq_rows_for_source(path = "other", source = "checked text") == None)
  record_checked_lowering(path = "entry", fingerprint = "fp2", offsets = [88], eq_offs = [
    12
  ], eq_keys = ["Int"])
  assert(checked_eq_rows_for_source(path = "entry", source = "checked text") == None)
}

test "fingerprint rebinding transfers the accepted source witness to another path" {
  reset_checked_lowering_memo()
  record_checked_lowering(path = "left", fingerprint = "same", offsets = [80], eq_offs = [
    11
  ], eq_keys = ["Int"])
  bind_checked_lowering_source(path = "left", fingerprint = "same", source = "same source")
  assert(rebind_checked_lowering(path = "right", fingerprint = "same"))
  assert(checked_lowering_for_source(path = "right", source = "same source") == Some([
    80
  ]))
  assert(checked_eq_rows_for_path("right") == Some(([11], ["Int"])))
  assert(!rebind_checked_lowering(path = "missing", fingerprint = "unknown"))
  assert(checked_lowering_for_path("missing") == None)
}

test "a declined lowering observation stays distinct from an absent fingerprint" {
  reset_checked_lowering_memo()
  publish_checked_lowering(path = "empty", fingerprint = "checked", offsets = None, eq_offs = [
  ], eq_keys = [])
  assert(ensure_checked_lowering_for_source(path = "empty", fingerprint = "checked", source = "empty source"))
  assert(checked_lowering_for_source(path = "empty", source = "empty source") == Some([
    14
  ]))
  assert(!ensure_checked_lowering_for_source(path = "absent", fingerprint = "unknown", source = "source"))
  reset_checked_lowering_memo()
  assert(checked_lowering_for_source(path = "empty", source = "empty source") == None)
}

test "merged lowering preserves builtin identity payloads and ignores unchecked modules" {
  reset_checked_lowering_memo()
  record_checked_lowering(path = "checked", fingerprint = "fp", offsets = [
    160,
    177,
    2097303
  ], eq_offs = [], eq_keys = [])
  assert(union_checked_lowering(flat_paths = ["unchecked", "checked"], flat_bases = [
    99,
    5
  ]) == [240, 257, 7340183])
}

test "render refusal and resolved callees keep distinct merged channels" {
  let (floats, relations, pluses, ints, bools) = split_checked_lowering([
    160,
    177,
    194,
    211,
    228,
    245,
    326,
    2097303
  ])
  assert(floats == [10, 14])
  assert(relations == [11])
  assert(pluses == [12])
  assert(ints == [13, -21])
  assert(bools == [15])
}
