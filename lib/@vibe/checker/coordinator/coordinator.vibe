import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

// The native bridge supplies worker batches. TaskGroup owns every wait,
// failure and child lifetime. The component needs no filesystem access.
export fn run() -> Int with Async + Exception {
  let response = await(host_response_named("vibe:checker/worker@0.0.1#load-plan"))
  if HostResponse::status(response) != 0 {
    throw("checker: load-plan failed")
  } else ()
  let mut text = ""
  for b in HostResponse::body(response) {
    let digit = if b == 44 {
      ","
    } else if b >= 48 && b <= 57 {
      String::substring("0123456789", start = b - 48, end = b - 47)
    } else {
      throw("checker: malformed wave counts")
    }
    text = String::concat(text, digit)
  }
  let rows = String::split(text, sep = ",")
  if Array::length(rows) != 5 {
    throw("checker: unsupported wave plan")
  } else ()
  let version = Array::get(rows, at = 0)
  let ready_mode = version == "2"
  if version != "1" && !ready_mode {
    throw("checker: unsupported wave plan")
  } else ()
  let counts: Array[Int] = []
  let mut i = 1
  while i < 5 {
    let count = match Int::parse(Array::get(rows, at = i)) {
      Some(n) => n,
      None => throw("checker: invalid wave count")
    }
    Array::push(counts, value = count)
    i = i + 1
  }
  TaskGroup::run((g) -> {
    let handles = []
    let mut slot = 0
    while slot < 4 {
      let worker_slot = slot
      let batches = Array::get(counts, at = slot)
      let task = TaskGroup::spawn_suspend(g, f = () -> Int with Async + Exception {
        let mut failed = 0
        let mut batch = 0
        let mut accepting = batches > 0
        while accepting && (ready_mode || batch < batches) {
          let result = await(host_response_named_with("vibe:checker/worker@0.0.1#check?slot", body = __to_string(worker_slot)))
          host_stream_close(HostResponse::body(result))
          let status = HostResponse::status(result)
          if ready_mode && status == -1 {
            accepting = false
          } else {
            failed = failed + status
            batch = batch + 1
          }
        }
        failed
      })
      Array::push(handles, value = task)
      slot = slot + 1
    }
    TaskGroup::pump_all(g)
    let mut failed = 0
    for task in handles {
      failed = failed + TaskHandle::join(task)
    }
    failed
  })
}
