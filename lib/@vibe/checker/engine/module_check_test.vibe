import @vibe/compiler/core {
  BindingOrigin, env_lookup, env_lookup_binding_including_surface
}

import @vibe/checker/engine {
  CheckJob,
  ModuleOutcome,
  engine_check_module,
  engine_check_module_with_typing_artifact_observation,
  engine_checked_module_typing_artifact_construction_attempt_count,
  engine_checked_module_typing_artifact_observation,
  engine_checked_module_typing_artifact_observation_is_fresh_for_job,
  engine_interface_effect_set_with_vars,
  engine_reset_checked_module_typing_artifact_construction_attempt_count
}

test "the ordinary engine check retains published values without allocating shadow artifacts" {
  engine_reset_checked_module_typing_artifact_construction_attempt_count()
  let job = CheckJob::{
    path: "leaf.vibe",
    source: "export fn value() -> Int { 42 }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  let outcome = engine_check_module(job)
  assert(engine_checked_module_typing_artifact_observation(outcome) == None)
  assert(engine_checked_module_typing_artifact_construction_attempt_count() == 0)
  match outcome {
    Checked(path, fingerprint, _, _, _, _, _) => {
      assert(path == "leaf.vibe")
      assert(String::length(fingerprint) > 0)
    },
    Diagnosed(_, _) => assert(false)
  }
}

test "the engine's observed product is bound to the exact current job" {
  let job = CheckJob::{
    path: "observed.vibe",
    source: "export fn value() -> Int { 42 }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  let outcome = engine_check_module_with_typing_artifact_observation(job)
  assert(engine_checked_module_typing_artifact_observation_is_fresh_for_job(job, outcome))
  let changed = CheckJob::{
    path: job.path,
    source: "export fn value() -> Int { 43 }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  assert(!engine_checked_module_typing_artifact_observation_is_fresh_for_job(changed, outcome))
}

test "diagnosed engine outcomes preserve the source path and location" {
  let job = CheckJob::{
    path: "bad.vibe",
    source: "export fn value() -> Int { \"wrong\" }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  match engine_check_module(job) {
    Diagnosed(path, diagnostics) => {
      assert(path == "bad.vibe")
      assert(Array::length(diagnostics) > 0)
      assert(String::contains(Array::get(diagnostics, 0), "bad.vibe: line 1:"))
    },
    Checked(_, _, _, _, _, _, _) => assert(false)
  }
}

test "dependent checks consume the first module's actual published environment" {
  let first = CheckJob::{
    path: "a.vibe",
    source: "export fn value() -> Int { 42 }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  match engine_check_module(first) {
    Checked(_, fingerprint, env, _, _, _, _) => {
      let second = CheckJob::{
        path: "b.vibe",
        source: "import ./a.vibe { value }\nexport fn result() -> Int { value() }",
        deps: ["a.vibe"],
        dep_fps: [("a.vibe", fingerprint)],
        dep_envs: [("a.vibe", env)],
        ships_owned_heads: false
      }
      match engine_check_module(second) {
        Checked(_, _, _, _, _, _, _) => (),
        Diagnosed(_, _) => assert(false)
      }
    },
    Diagnosed(_, _) => assert(false)
  }
}

test "published engine rows omit checker instantiations and preserve named captures" {
  let row = Some("IO,#einst:Box:17,#region_9,#param[0],#capture[12],IO")
  assert(engine_interface_effect_set_with_vars(row, [12], ["T"]) == "[#capture[T],IO]")
  assert(engine_interface_effect_set_with_vars(Some("#einst:Box:17"), [], []) == "[]")
}

/// Imported calls consume the selected declaration's header, including facade aliases.
test "ordinary imported declaration labels survive projection and reexport" {
  let first = CheckJob::{
    path: "labels.vibe",
    source: "export fn select(first: Int, second: String) -> Int { first }",
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  match engine_check_module(first) {
    Checked(_, fingerprint, env, _, _, _, _) => {
      let facade = CheckJob::{
        path: "facade.vibe",
        source: "export ./labels.vibe { select as choose }",
        deps: ["labels.vibe"],
        dep_fps: [("labels.vibe", fingerprint)],
        dep_envs: [("labels.vibe", env)],
        ships_owned_heads: false
      }
      match engine_check_module(facade) {
        Checked(_, facade_fp, facade_env, _, _, _, _) => {
          assert(env_lookup(facade_env, "#params:choose") is None)
          match env_lookup_binding_including_surface(facade_env, "choose") {
            Some(binding) => match binding.origin {
              BindingOriginReExportFunctionHeader(_, source, names) => {
                assert(source == "select")
                assert(names == ["first", "second"])
              },
              _ => assert(false)
            },
            None => assert(false)
          }
          let good = CheckJob::{
            path: "consumer.vibe",
            source: "import ./facade.vibe { choose as pick }\nexport fn result() -> Int { pick(second = \"ok\", first = 42) }",
            deps: ["facade.vibe"],
            dep_fps: [("facade.vibe", facade_fp)],
            dep_envs: [("facade.vibe", facade_env)],
            ships_owned_heads: false
          }
          match engine_check_module(good) {
            Checked(_, _, _, _, _, _, _) => (),
            Diagnosed(_, _) => assert(false)
          }
          let bad = CheckJob::{
            path: good.path,
            source: "import ./facade.vibe { choose as pick }\nexport fn result() -> Int { pick(second = 42, first = \"wrong\") }",
            deps: good.deps,
            dep_fps: good.dep_fps,
            dep_envs: good.dep_envs,
            ships_owned_heads: false
          }
          match engine_check_module(bad) {
            Diagnosed(_, _) => (),
            Checked(_, _, _, _, _, _, _) => assert(false)
          }
        },
        Diagnosed(_, _) => assert(false)
      }
    },
    Diagnosed(_, _) => assert(false)
  }
}
