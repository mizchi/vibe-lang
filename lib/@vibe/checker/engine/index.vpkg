name = @vibe/checker/engine
version = 0.0.1
description =
  #|Production module checking, published dependency projection and worker job transport.
deps = {
  @vibe/ast : 0.2.0
  @vibe/checker/lowering : 0.0.1
  @vibe/checker/transport/env : 0.0.1
  @vibe/compiler/cache : 0.0.1
