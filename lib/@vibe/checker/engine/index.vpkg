  @vibe/compiler/checker/artifacts : 0.0.1
  @vibe/compiler/checker/artifacts/module : 0.0.1
  @vibe/compiler/checker/artifacts/program : 0.0.1
  @vibe/compiler/contract : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/compiler/loader : 0.0.1
  @vibe/compiler/runtime/checked_module_cache : 0.0.1
  @vibe/compiler/runtime/eval_loader : 0.0.1
  @vibe/compiler/syntax : 0.0.1
  @vibe/core : 0.2.0
}

