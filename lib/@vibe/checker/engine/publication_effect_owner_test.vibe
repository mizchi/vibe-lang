// ADR-0124 (#2656): the published declaration of an effect carries its owner,
// so turning `effect Kv` into `extern effect Kv` changes the interface
// identity dependents are rechecked against.
import @vibe/checker/engine {
  engine_interface_decl_lines
}

import @vibe/compiler/syntax {
  lex, parse_program
}

fn decl_lines(_ src: String) -> String with Exception {
  String::join(engine_interface_decl_lines(stmts = parse_program(lex(src)), include_private = false, aggregate = [
  ]), sep = "\n")
}

test "an extern effect publishes another declaration than a program-handled one" {
  let handled = decl_lines("export effect Kv {\n  Fetch() -> String\n}\n")
  let hosted = decl_lines("export extern effect Kv {\n  Fetch() -> String\n}\n")
  assert(handled != hosted)
  assert(String::contains(hosted, needle = "extern-effect:"))
  assert(!String::contains(handled, needle = "extern-effect:"))
}
