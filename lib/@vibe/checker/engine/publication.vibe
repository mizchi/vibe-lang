fn engine_interface_effect_set(_ effect_name: Option[String]) -> String {
  engine_interface_effect_set_with_vars(effect_name = effect_name, ids = array_empty(), names = array_empty())
}
fn engine_interface_lookup_var(ids: Array[Int], names: Array[String], id: Int) -> String {
  let mut i = 0
  let mut result = String::concat("free", __to_string(id))
  let mut found = false
  while i < Array::length(ids) && !found {
    if Array::get(ids, at = i) == id {
      result = Array::get(names, at = i)
      found = true
    } else {
      i = i + 1
    }
  }
  result
}
fn engine_interface_canonical_type(ty: Type, ids: Array[Int], names: Array[String]) -> String {
  let rec types: (Array[Type], Array[Int], Array[String]) -> String = (items, vars, labels) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, value = "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, value = engine_interface_segment(engine_interface_canonical_type(ty = Array::get(items, at = i), ids = vars, names = labels)))
      i = i + 1
    }
    StringBuilder::push(out, value = "]")
    StringBuilder::freeze(out)
  }
  match ty {
    CtInt => "int",
    CtInt32 => "int32",
    CtUInt32 => "uint32",
    CtDouble => "double",
    CtFloat => "float",
    CtBool => "bool",
    CtString => "string",
    CtChar => "char",
    CtUnit => "unit",
    CtBytes => "bytes",
    CtUnknown => "unknown",
    CtVar(id) => String::concat("var:", engine_interface_lookup_var(ids = ids, names = names, id = id)),
    CtConstructor(name, arity) => String::concat("constructor:", String::concat(engine_interface_segment(name), __to_string(arity))),
    CtApplied(head, args) => String::concat("applied:", String::concat(engine_interface_segment(engine_interface_canonical_type(ty = head, ids = ids, names = names)), types(args, ids, names))),
    CtEnum(name) => String::concat("enum:", engine_interface_segment(name)),
    CtStruct(name) => String::concat("struct:", engine_interface_segment(name)),
    CtArray(elem) => String::concat("array:", engine_interface_segment(engine_interface_canonical_type(ty = elem, ids = ids, names = names))),
    CtOption(elem) => String::concat("option:", engine_interface_segment(engine_interface_canonical_type(ty = elem, ids = ids, names = names))),
    CtTuple(items) => String::concat("tuple:", types(items, ids, names)),
    // #1839: anonymous record — names are part of the canonical form.
    CtRecord(rfields) => {
      let mut kacc = "record:"
      let mut ki = 0
      while ki < Array::length(rfields) {
        let (kname, kty) = Array::get(rfields, at = ki)
        kacc = String::concat(kacc, String::concat(engine_interface_segment(kname), engine_interface_segment(engine_interface_canonical_type(ty = kty, ids = ids, names = names))))
        ki = ki + 1
      }
      kacc
    },
    CtNamed(name, args) => String::concat("named:", String::concat(engine_interface_segment(name), types(args, ids, names))),
    CtFn(params, ret, effects) => String::concat("fn:", String::concat(types(params, ids, names), String::concat(engine_interface_segment(engine_interface_canonical_type(ty = ret, ids = ids, names = names)), engine_interface_effect_set_with_vars(effect_name = effects, ids = ids, names = names)))),
    CtForAll(vars, bounds, body) => {
      let all_ids = Array::slice(ids, start = 0, end = Array::length(ids))
      let all_names = Array::slice(names, start = 0, end = Array::length(names))
      let mut i = 0
      while i < Array::length(vars) {
        Array::push(all_ids, value = Array::get(vars, at = i))
        Array::push(all_names, value = String::concat("q", __to_string(Array::length(all_names))))
        i = i + 1
      }
      let bound_rows = array_empty()
      let mut b = 0
      while b < Array::length(vars) {
        let id = Array::get(vars, at = b)
        let labels = array_empty()
        let mut j = 0
        while j < Array::length(bounds) {
          let (bound_id, raw_labels) = Array::get(bounds, at = j)
          if bound_id == id {
            let mut k = 0
            while k < Array::length(raw_labels) {
              Array::push(labels, value = Array::get(raw_labels, at = k))
              k = k + 1
            }
          } else {
            ()
          }
          j = j + 1
        }
        Array::push(bound_rows, value = String::concat(engine_interface_lookup_var(ids = all_ids, names = all_names, id = id), String::concat("=", String::join(engine_interface_sorted_unique(labels), sep = ","))))
        b = b + 1
      }
      String::concat("forall:", String::concat("[", String::concat(String::join(bound_rows, sep = ";"), String::concat("]", engine_interface_segment(engine_interface_canonical_type(ty = body, ids = all_ids, names = all_names))))))
    }
  }
}
export fn engine_interface_lookup_type_param(params: Array[String], name: String) -> String {
  let mut i = 0
  let mut result = name
  let mut found = false
  while i < Array::length(params) && !found {
    if type_param_name(Array::get(params, at = i)) == name {
      result = String::concat("p", String::concat(__to_string(i), String::concat("/", __to_string(type_param_arity(Array::get(params, at = i))))))
      found = true
    } else {
      i = i + 1
    }
  }
  result
}
/// Resolve a trait-method signature name with explicit lexical scope.
/// Method binders shadow trait-header binders; names outside both scopes stay
/// free (rather than being accidentally alpha-normalized as a binder).
fn engine_interface_lookup_trait_type_param(header_params: Array[String], method_params: Array[String], name: String) -> String {
  let mut i = 0
  let mut method_result = String::concat("free:", name)
  let mut found_method = false
  while i < Array::length(method_params) && !found_method {
    if type_param_name(Array::get(method_params, at = i)) == name {
      method_result = String::concat("method:", String::concat(__to_string(i), String::concat("/", __to_string(type_param_arity(Array::get(method_params, at = i))))))
      found_method = true
    } else {
      i = i + 1
    }
  }
  if found_method {
    method_result
  } else {
    let mut j = 0
    let mut header_result = String::concat("free:", name)
    let mut found_header = false
    while j < Array::length(header_params) && !found_header {
      if type_param_name(Array::get(header_params, at = j)) == name {
        header_result = String::concat("header:", String::concat(__to_string(j), String::concat("/", __to_string(type_param_arity(Array::get(header_params, at = j))))))
        found_header = true
      } else {
        j = j + 1
      }
    }
    header_result
  }
}
/// Canonicalize a trait method signature. Unlike ordinary declaration
/// signatures, this has nested binders: method generics take precedence over
/// the surrounding trait-header binders. This observation consumes both
/// binder lists from source `STrait`; method generic provenance is not retained
/// by TypeEnv or the full checked artifact.
fn engine_interface_canonical_trait_method_type_expr(ty: TypeExpr, header_params: Array[String], method_params: Array[String]) -> String {
  let rec exprs: (Array[TypeExpr], Array[String], Array[String]) -> String = (items, header_scope, method_scope) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, value = "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, value = engine_interface_segment(engine_interface_canonical_trait_method_type_expr(ty = Array::get(items, at = i), header_params = header_scope, method_params = method_scope)))
      i = i + 1
    }
    StringBuilder::push(out, value = "]")
    StringBuilder::freeze(out)
  }
  match ty {
    TyName(name) => String::concat("name:", engine_interface_segment(engine_interface_lookup_trait_type_param(header_params = header_params, method_params = method_params, name = name))),
    TyApp(name, args) => String::concat("app:", String::concat(engine_interface_segment(engine_interface_lookup_trait_type_param(header_params = header_params, method_params = method_params, name = name)), exprs(args, header_params, method_params))),
    TyFn(args, ret, effects) => String::concat("fn:", String::concat(exprs(args, header_params, method_params), String::concat(engine_interface_segment(engine_interface_canonical_trait_method_type_expr(ty = ret, header_params = header_params, method_params = method_params)), engine_interface_effect_set(effects)))),
    TyTuple(items) => String::concat("tuple:", exprs(items, header_params, method_params)),
    TyUnit => "unit"
  }
}
export fn engine_interface_trait_header_malformed_rows(_ header_params: Array[String]) -> Array[String] {
  let rows = array_empty()
  let mut p = 0
  while p < Array::length(header_params) {
    let param_name = type_param_name(Array::get(header_params, at = p))
    let mut matches = 0
    let mut p2 = 0
    while p2 < Array::length(header_params) {
      if type_param_name(Array::get(header_params, at = p2)) == param_name {
        matches = matches + 1
      } else {
        ()
      }
      p2 = p2 + 1
    }
    if matches > 1 {
      // Encode the binder position, not its source spelling, so malformed
      // duplicate groups remain alpha-invariant while staying distinct from
      // a valid header of the same arity.
      Array::push(rows, value = String::concat("ambiguous-header-param:", __to_string(p)))
    } else {
      ()
    }
    p = p + 1
  }
  rows
}
export fn engine_interface_trait_generic_malformed_rows(method_params: Array[String], generic_bounds: Array[(String, Array[String])]) -> Array[String] {
  let rows = array_empty()
  let mut p = 0
  while p < Array::length(method_params) {
    let param_name = Array::get(method_params, at = p)
    let mut matches = 0
    let mut p2 = 0
    while p2 < Array::length(method_params) {
      if Array::get(method_params, at = p2) == param_name {
        matches = matches + 1
      } else {
        ()
      }
      p2 = p2 + 1
    }
    if matches > 1 {
      Array::push(rows, value = String::concat("ambiguous-method-param:", engine_interface_segment(param_name)))
    } else {
      ()
    }
    p = p + 1
  }
  let mut b = 0
  while b < Array::length(generic_bounds) {
    let (bound_name, bound_labels) = Array::get(generic_bounds, at = b)
    let mut matches = 0
    let mut p3 = 0
    while p3 < Array::length(method_params) {
      if Array::get(method_params, at = p3) == bound_name {
        matches = matches + 1
      } else {
        ()
      }
      p3 = p3 + 1
    }
    if matches == 0 {
      Array::push(rows, value = String::concat("unbound-bound:", String::concat(engine_interface_segment(bound_name), engine_interface_bracketed(items = engine_interface_sorted_unique(bound_labels), separator = ","))))
    } else if matches > 1 {
      Array::push(rows, value = String::concat("ambiguous-bound:", String::concat(engine_interface_segment(bound_name), engine_interface_bracketed(items = engine_interface_sorted_unique(bound_labels), separator = ","))))
    } else {
      ()
    }
    b = b + 1
  }
  rows
}
export fn engine_interface_surplus_method_generic_rows(method_count: Int, method_gens: Array[(String, Array[String], Array[(String, Array[String])])]) -> Array[String] {
  let rows = array_empty()
  let mut surplus = method_count
  while surplus < Array::length(method_gens) {
    let (surplus_name, surplus_params, surplus_bounds) = Array::get(method_gens, at = surplus)
    let raw_params = array_empty()
    let mut sp = 0
    while sp < Array::length(surplus_params) {
      Array::push(raw_params, value = engine_interface_segment(Array::get(surplus_params, at = sp)))
      sp = sp + 1
    }
    let raw_bounds = array_empty()
    let mut sb = 0
    while sb < Array::length(surplus_bounds) {
      let (bound_name, bound_labels) = Array::get(surplus_bounds, at = sb)
      Array::push(raw_bounds, value = String::concat(engine_interface_segment(bound_name), engine_interface_bracketed(items = engine_interface_sorted_unique(bound_labels), separator = ",")))
      sb = sb + 1
    }
    Array::push(rows, value = String::concat("surplus-method-generic:", String::concat(engine_interface_segment(surplus_name), String::concat(engine_interface_bracketed(items = raw_params, separator = ";"), engine_interface_bracketed(items = raw_bounds, separator = ";")))))
    surplus = surplus + 1
  }
  rows
}
export fn engine_interface_canonical_type_expr(ty: TypeExpr, params: Array[String]) -> String {
  let rec exprs: (Array[TypeExpr], Array[String]) -> String = (items, type_params) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, value = "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, value = engine_interface_segment(engine_interface_canonical_type_expr(ty = Array::get(items, at = i), params = type_params)))
      i = i + 1
    }
    StringBuilder::push(out, value = "]")
    StringBuilder::freeze(out)
  }
  match ty {
    TyName(name) => String::concat("name:", engine_interface_segment(engine_interface_lookup_type_param(params = params, name = name))),
    TyApp(name, args) => String::concat("app:", String::concat(engine_interface_segment(engine_interface_lookup_type_param(params = params, name = name)), exprs(args, params))),
    TyFn(args, ret, effects) => String::concat("fn:", String::concat(exprs(args, params), String::concat(engine_interface_segment(engine_interface_canonical_type_expr(ty = ret, params = params)), engine_interface_effect_set(effects)))),
    TyTuple(items) => String::concat("tuple:", exprs(items, params)),
    TyUnit => "unit"
  }
}
fn engine_interface_public_value_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, _, name, _, _) => if exported {
        Array::push(names, value = name)
      } else {
        ()
      },
      SFnDecl(exported, name, _, _, _) => if exported {
        Array::push(names, value = name)
      } else {
        ()
      },
      SExport(exported_names) => {
        let mut j = 0
        while j < Array::length(exported_names) {
          Array::push(names, value = Array::get(exported_names, at = j))
          j = j + 1
        }
      },
      SReExport(_, reexports) => {
        let mut j = 0
        while j < Array::length(reexports) {
          let item = Array::get(reexports, at = j)
          let name = item.name
          let alias = item.alias
          Array::push(names, value = match alias {
            Some(value) => value,
            None => name
          })
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  engine_interface_sorted_unique(names)
}
/// Trait and impl authority is published only for explicitly exported traits,
/// plus traits required by exported value schemes and their supertrait closure.
/// This mirrors selected import projection without widening the interface to
/// typedef or effect transport.
fn engine_interface_public_trait_names(stmts: Array[Stmt], checked_env: TypeEnv) -> Array[String] {
  let mappings = array_empty()
  env_trait_def_names_into(env = checked_env, out = engine_ipt_trait_names)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STrait(true, name, _, _, _, _) => engine_trait_projection_add_mapping(mappings = mappings, canonical = name, local_name = name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, at = j)
          if engine_trait_in_list(traits = engine_ipt_trait_names, name = name) {
            engine_trait_projection_add_mapping(mappings = mappings, canonical = name, local_name = name)
          } else {
            ()
          }
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let source_name = item.name
          let alias = item.alias
          let local_name = match alias {
            Some(value) => value,
            None => source_name
          }
          if engine_trait_in_list(traits = engine_ipt_trait_names, name = local_name) {
            engine_trait_projection_add_mapping(mappings = mappings, canonical = local_name, local_name = local_name)
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let values = engine_interface_public_value_names(stmts)
  i = 0
  while i < Array::length(values) {
    match env_lookup(env = checked_env, name = Array::get(values, at = i)) {
      Some(ty) => engine_trait_projection_collect_type_bounds(ty = ty, mappings = mappings, traits = engine_ipt_trait_names),
      None => ()
    }
    i = i + 1
  }
  let mut cursor = 0
  while cursor < Array::length(mappings) {
    let (name, _) = Array::get(mappings, at = cursor)
    let supers = engine_trait_projection_supers(env = checked_env, name = name)
    engine_trait_projection_collect_generic_impl_bounds(dep_env = checked_env, trait_name = name, mappings = mappings, traits = engine_ipt_trait_names)
    let mut j = 0
    while j < Array::length(supers) {
      let super_name = Array::get(supers, at = j)
      if engine_trait_in_list(traits = engine_ipt_trait_names, name = super_name) {
        engine_trait_projection_add_mapping(mappings = mappings, canonical = super_name, local_name = super_name)
      } else {
        ()
      }
      j = j + 1
    }
    cursor = cursor + 1
  }
  let names = array_empty()
  i = 0
  while i < Array::length(mappings) {
    let (name, _) = Array::get(mappings, at = i)
    Array::push(names, value = name)
    i = i + 1
  }
  engine_interface_sorted_unique(names)
}
fn engine_interface_public_type_names(stmts: Array[Stmt], checked_env: TypeEnv) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(true, name, _, _, _) => Array::push(names, value = name),
      // #3070: `suberror` is sugar for an enum (#2983); `export suberror K`
      // publishes `K` exactly as `export enum K` does. Missing here, the
      // type was never selectable, so `import ./m { K }` answered "is not
      // exported" while the interface below already carried its line.
      SSuberror(true, name, _) => Array::push(names, value = name),
      SStruct(true, name, _, _, _, _) => Array::push(names, value = name),
      STypeAlias(true, name, _, _) => Array::push(names, value = name),
      SEffectDef(true, name, _, _, _) => Array::push(names, value = name),
      SEffectSet(true, name, _) => Array::push(names, value = name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          Array::push(names, value = Array::get(items, at = j))
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let source = item.name
          let alias = item.alias
          Array::push(names, value = match alias {
            Some(local) => local,
            None => source
          })
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let defs = env_type_defs(checked_env)
  let out = array_empty()
  let mut ni = 0
  while ni < Array::length(names) {
    let name = Array::get(names, at = ni)
    // Publish only the name the module selected. Its declaration closure is
    // retained separately by restrict_env_to_export_surface so a private
    // field/signature type remains interpretable without becoming selectable.
    if engine_typedef_projection_contains(defs = defs, name = name) || is_explicit_builtin_declaration(name) {
      // Builtin/registry declarations have no user TypeDef payload, but an
      // explicit export gives them the same selected-surface authority as a
      // contract declaration. They are never accepted merely by import name.
      Array::push(out, value = name)
    } else {
      ()
    }
    ni = ni + 1
  }
  engine_interface_sorted_unique(out)
}
/// #1533: the environment a module PUBLISHES to its importers is its export
/// surface, not its full checked environment. The checked environment binds
/// every top-level `let`/`fn` -- and, via the import env at its base, every
/// name the module itself imported -- so testing an import against it let
/// `import ./dep.vibe { private_fn }` through to die in codegen. Dropping
/// the non-exported bindings here, at the single point every publication
/// path flows through (persistent store, env cache, worker env.out, TDRE9),
/// makes the existing membership check in
/// bind_import_names_from_cache_collecting the export test itself.
///
/// Value bindings are retained only when they are explicitly exported.
/// Type/constructor authority travels separately through `EnvTypeDefs`; an
/// uppercase spelling is never authority to import a private declaration.
///
/// Trait definitions and implementations are published only for the selected
/// trait surface. EnvCached wrappers are rebuilt from the restricted chain
/// (their arrays are acceleration state, same rule as the serializer's).
fn engine_restrict_env_to_export_surface_with_defs(value_surface: Array[String], trait_surface: Array[String], type_surface: Array[String], env: TypeEnv, all_defs: Array[TypeDef], members: Array[String], strict: Bool) -> TypeEnv {
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => {
      let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
      if bsearch_leftmost(sorted = value_surface, name = name) >= 0 || engine_is_selected_type_companion(name = name, binding = binding, type_surface = type_surface, all_defs = all_defs, members = members, strict = strict) {
        EnvBind(name, publish_type_constructor_binding_rows(name = name, binding = binding, defs = all_defs), restricted)
      } else {
        restricted
      }
    },
    // #1262: `let mut` escape markers are function-local, so a module's export
    // surface never carries one. Drop it with its scope rather than inventing
    // a rule for publishing mutability across a boundary.
    EnvShowWrappers(_, _, rest) => engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict),
    EnvMutCell(_, _, rest) => engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => {
      let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
      if bsearch_leftmost(sorted = trait_surface, name = name) >= 0 {
        EnvTraitDef(name, supers, is_auto, methods, restricted, params, method_gens)
      } else {
        restricted
      }
    },
    EnvTraitImpl(name, target, rest) => {
      let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
      if bsearch_leftmost(sorted = trait_surface, name = trait_ref_name(name)) >= 0 {
        EnvTraitImpl(name, target, restricted)
      } else {
        restricted
      }
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => {
      let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
      if bsearch_leftmost(sorted = trait_surface, name = trait_ref_name(name)) >= 0 {
        EnvTraitImplGen(name, params, bounds, target, restricted)
      } else {
        restricted
      }
    },
    EnvTypeDefs(defs, _, rest) => {
      let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
      let kept = array_empty()
      let mut i = 0
      while i < Array::length(defs) {
        let def = Array::get(defs, at = i)
        if bsearch_leftmost(sorted = type_surface, name = engine_typedef_projection_name(def)) >= 0 {
          let closure = array_empty()
          engine_typedef_projection_add_named(name = engine_typedef_projection_name(def), dep_defs = all_defs, selected = closure)
          let mut ci = 0
          while ci < Array::length(closure) {
            let closure_def = Array::get(closure, at = ci)
            if !engine_typedef_projection_contains(defs = kept, name = engine_typedef_projection_name(closure_def)) {
              Array::push(kept, value = publish_type_def_row_nominals(d = closure_def, defs = all_defs))
            } else {
              ()
            }
            ci = ci + 1
          }
        } else {
          ()
        }
        i = i + 1
      }
      if Array::length(kept) == 0 {
        restricted
      } else {
        EnvTypeDefs(kept, type_surface, restricted)
      }
    },
    EnvFlat(bindings) => {
      let kept = array_empty()
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, at = i)
        if bsearch_leftmost(sorted = value_surface, name = name) >= 0 || engine_is_selected_type_companion(name = name, binding = binding, type_surface = type_surface, all_defs = all_defs, members = members, strict = strict) {
          Array::push(kept, value = (name, publish_type_constructor_binding_rows(name = name, binding = binding, defs = all_defs)))
        } else {
          ()
        }
        i = i + 1
      }
      EnvFlat(kept)
    },
    // The wrapper is DROPPED, not rebuilt. Its arrays are acceleration
    // state (the codec re-derives them via env_cache on both serialize and
    // parse), and every consumer of a published env either flat-walks the
    // chain or serializes it, so nothing loses correctness. Rebuilding here
    // would need core's `env_cache` -- a name this file cannot import: it
    // collides with the ubiquitous `env_cache` PARAMETERS, and the FS
    // module lane resolves an import over a same-named local (the merge
    // lane shadows correctly), while an `as` alias broke the
    // collect_merged_stmts lane instead. Both are their own bugs.
    EnvCached(_, _, rest) => engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = rest, all_defs = all_defs, members = members, strict = strict)
  }
}
fn engine_restrict_env_to_export_surface(value_surface: Array[String], trait_surface: Array[String], type_surface: Array[String], env: TypeEnv, strict: Bool) -> TypeEnv {
  let all_defs = env_type_defs(env)
  let restricted = engine_restrict_env_to_export_surface_with_defs(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = env, all_defs = all_defs, members = engine_env_type_member_names(env), strict = strict)
  if Array::length(type_surface) > 0 && Array::length(env_selectable_type_defs(restricted)) == 0 {
    // Opaque builtins and re-exported contracts can grant type authority
    // without carrying a forgeable TypeDef payload. Keep one surface node for
    // that case; concrete closures already carry their own surface node.
    EnvTypeDefs(array_empty(), type_surface, restricted)
  } else {
    restricted
  }
}
/// Builtin values are resolved outside a module's ordinary TypeEnv, so an
/// explicit export of one needs a marker binding in the published environment.
/// The marker never grants unexported builtin authority: its source is the
/// already-filtered explicit value surface.
fn engine_prepend_explicit_builtin_value_markers(value_surface: Array[String], env: TypeEnv) -> TypeEnv {
  let mut out = env
  let mut i = 0
  while i < Array::length(value_surface) {
    let name = Array::get(value_surface, at = i)
    if is_explicit_builtin_declaration(name) && env_lookup(env = env, name = name) == None {
      out = EnvBind(name, env_value_binding(CtUnknown), out)
    } else {
      ()
    }
    i = i + 1
  }
  out
}
/// Build the single published environment shared by the filesystem and
/// in-memory TypeDb lanes. Only declarations named by this module's explicit
/// export surface leave the check; imported authority stays local unless the
/// module re-exports it.
fn engine_append_env_tail(head: TypeEnv, tail: TypeEnv) -> TypeEnv {
  match head {
    EnvEmpty => tail,
    EnvBind(name, binding, rest) => EnvBind(name, binding, engine_append_env_tail(head = rest, tail = tail)),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, engine_append_env_tail(head = rest, tail = tail), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, engine_append_env_tail(head = rest, tail = tail)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, engine_append_env_tail(head = rest, tail = tail)),
    EnvTypeDefs(defs, selectable, rest) => EnvTypeDefs(defs, selectable, engine_append_env_tail(head = rest, tail = tail)),
    EnvShowWrappers(wrappers, unknown, rest) => EnvShowWrappers(wrappers, unknown, engine_append_env_tail(head = rest, tail = tail)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, engine_append_env_tail(head = rest, tail = tail)),
    EnvFlat(bindings) => {
      let mut out = tail
      let mut i = Array::length(bindings) - 1
      while i >= 0 {
        let (name, binding) = Array::get(bindings, at = i)
        out = EnvBind(name, binding, out)
        i = i - 1
      }
      out
    },
    // Cached names are derived acceleration state. Reattaching the semantic
    // chain and letting publication discard/rebuild caches preserves meaning.
    EnvCached(_, _, rest) => engine_append_env_tail(head = rest, tail = tail)
  }
}
/// Publish the strict export surface, preserving origins, type companions and Show facts.
/// Publication for the module at `path`. A package contract (`index.vpkg`)
/// publishes exactly what it declares: a type it re-exports carries its enum
/// variants, its derived methods and the methods of its impls, not every
/// function of the implementation that shares its prefix or returns it
/// (`is_selected_type_companion`). That is what keeps `@vibe/concurrent`,
/// which re-exports the stable subset of `@vibe/concurrent/experimental`,
/// from publishing `TaskGroup::spawn_suspend` through `TaskGroup`. An ordinary
/// module keeps the older companion rule.
export fn engine_checked_module_public_env_for_path(path: String, stmts: Array[Stmt], full_checked_env: TypeEnv, reexport_declarations: TypeEnv) -> TypeEnv with Exception {
  engine_checked_module_public_env_publishing(stmts = stmts, full_checked_env = full_checked_env, reexport_declarations = reexport_declarations, strict = is_contract_ext(path))
}
export fn engine_checked_module_public_env_publishing(stmts: Array[Stmt], full_checked_env: TypeEnv, reexport_declarations: TypeEnv, strict: Bool) -> TypeEnv with Exception {
  // Local declarations stay ahead of the publication-only projection, which
  // preserves lexical shadowing when both select the same public spelling.
  let publication_env = engine_bind_type_member_markers(env = engine_append_env_tail(head = full_checked_env, tail = reexport_declarations), markers = engine_local_type_member_markers(stmts = stmts, env = full_checked_env))
  let value_surface = engine_interface_public_value_names(stmts)
  let trait_surface = engine_interface_public_trait_names(stmts = stmts, checked_env = publication_env)
  let type_surface = engine_interface_public_type_names(stmts = stmts, checked_env = publication_env)
  let published = engine_bind_type_reference_definitions(value_surface = value_surface, publication_env = publication_env, published = env_preserve_type_definition_origins(env = engine_restrict_env_to_export_surface(value_surface = value_surface, trait_surface = trait_surface, type_surface = type_surface, env = publication_env, strict = strict), source = publication_env))
  // Builtin declarations have no TypeDef node to survive the restriction.
  // Their explicit selected surface still needs a transport node, otherwise
  // the importer cannot distinguish this export from an empty dependency.
  let with_builtin_types = if Array::length(type_surface) > 0 && Array::length(env_type_defs(published)) == 0 {
    EnvTypeDefs(array_empty(), type_surface, published)
  } else {
    published
  }
  // #2378: plus one marker per `fn` this module defines at a qualified
  // builtin name, read by whichever module imports it -- see
  // builtin_shadow_marker_prefix. Bound HERE, in the one publication every
  // lane goes through (the FS wave loop, the #906 worker, and the in-memory
  // walk in runtime.vibe), so no lane can publish an unmarked env.
  let published_env = engine_bind_builtin_shadow_markers(env = engine_prepend_explicit_builtin_value_markers(value_surface = value_surface, env = with_builtin_types), names = collect_builtin_shadowing_names(stmts))
  match unresolved_aggregate_export_name(stmts = stmts, env = published_env) {
    Some(name) => throw(unresolved_export_message(name)),
    None => ()
  }
  let (wrappers, unknown) = irc_show_wrapper_facts(stmts = stmts, env = full_checked_env)
  let exported_wrappers: Array[String] = []
  let exported_unknown: Array[String] = []
  for name in wrappers {
    if contains_str(arr = value_surface, target = name) {
      Array::push(exported_wrappers, value = name)
    } else {
      ()
    }
  }
  for name in unknown {
    if contains_str(arr = value_surface, target = name) {
      Array::push(exported_unknown, value = name)
    } else {
      ()
    }
  }
  env_with_show_wrapper_facts(env = engine_bind_erased_kinds_markers(publication_env = publication_env, published = engine_bind_retention_summary_markers(publication_env = publication_env, published = engine_bind_param_name_markers(stmts = stmts, publication_env = publication_env, published = published_env))), wrappers = exported_wrappers, unknown = exported_unknown)
}
/// #3601: the kinds other than the message each published function's erased
/// `with Exception` row lets out, for an importer that calls it. A function
/// of this module carries what its effect check charged; a re-exported one
/// carries what its own import brought in. A function of this module that
/// shadows an imported one of its name is bound an empty marker by the
/// checker (`env_bind_erased_kinds`), which is the nearest row, so the
/// imported marker is not published for it; an empty one is not published
/// at all (Codex on #3605).
fn engine_bind_erased_kinds_markers(publication_env: TypeEnv, published: TypeEnv) -> TypeEnv {
  let mut acc = published
  for row in env_erased_kinds_rows(publication_env) {
    let (fname, ty) = row
    let carries = match ty {
      CtNamed(_, items) => Array::length(items) > 0,
      _ => false
    }
    if carries && engine_env_has_value(env = published, name = fname) {
      acc = env_bind(env = acc, name = erased_kinds_marker(fname), ty = ty)
    } else {
      ()
    }
  }
  acc
}
/// #3360: the summary of what each published function keeps of its
/// arguments, for an importer that calls it inside a region. A function of
/// this module carries the one its check found; a re-exported one carries the
/// one its own import brought in, so both are read off the same chain.
fn engine_bind_retention_summary_markers(publication_env: TypeEnv, published: TypeEnv) -> TypeEnv {
  let mut acc = published
  for row in env_retention_summary_rows(publication_env) {
    let (fname, ty) = row
    if engine_env_has_value(env = published, name = fname) {
      acc = env_bind(env = acc, name = retention_summary_marker(fname), ty = ty)
    } else {
      ()
    }
  }
  acc
}
/// #3432: one `param_names_marker` per published function with an optional
/// (`x?`) parameter, so an importer can omit it or pass it by label the way
/// the defining module can. The test is whether the NAME is published, not
/// whether it is in the value surface: a type companion (`fn Box::make`)
/// rides out with its type (Codex on #3441). A re-exported function carries
/// the marker its own import brought in.
fn engine_bind_param_name_markers(stmts: Array[Stmt], publication_env: TypeEnv, published: TypeEnv) -> TypeEnv {
  // Allocates nothing for a module without an optional parameter in sight:
  // this runs at every publication, and the self-compile heap budget is
  // measured across all of them.
  let mut acc = published
  for stmt in stmts {
    match stmt {
      SLet(_, _, fname, _, EFn(_, _, params, _, _, _)) => if engine_params_have_optional(params) && engine_env_has_value(env = published, name = fname) {
        let fields: Array[(String, Type)] = []
        for param in params {
          let (pn, _) = param
          Array::push(fields, value = (pn, CtUnit))
        }
        acc = env_bind(env = acc, name = param_names_marker(fname), ty = CtRecord(fields))
      } else {
        ()
      },
      _ => ()
    }
  }
  // The markers this module's imports brought in, for what it re-publishes:
  // a re-exported function, or the companions of a re-exported type. An own
  // top-level binding of the same name hides the imported marker.
  for row in env_param_name_rows(publication_env) {
    let (fname, names) = row
    if engine_env_has_value(env = published, name = fname) && !engine_stmts_bind_top_level(stmts = stmts, name = fname) {
      let fields: Array[(String, Type)] = []
      for pn in names {
        Array::push(fields, value = (pn, CtUnit))
      }
      acc = env_bind(env = acc, name = param_names_marker(fname), ty = CtRecord(fields))
    } else {
      ()
    }
  }
  acc
}

fn engine_params_have_optional(_ params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut found = false
  for param in params {
    let (pn, _) = param
    found = found || String::ends_with(pn, suffix = "?")
  }
  found
}

/// Whether the module binds `name` at top level: a local `fn` or `let` of
/// that name is what gets published, so it hides an imported marker even
/// when it is not written as a lambda (`export let f: (Int) -> Int = g`,
/// Codex on #3441).
fn engine_stmts_bind_top_level(stmts: Array[Stmt], name: String) -> Bool {
  let mut found = false
  for stmt in stmts {
    let bound = match stmt {
      SLet(_, _, n, _, _) => n == name,
      SLetMut(n, _, _) => n == name,
      SExternLet(n, _) => n == name,
      SFnDecl(_, n, _, _, _) => n == name,
      _ => false
    }
    found = found || bound
  }
  found
}

fn engine_env_has_value(env: TypeEnv, name: String) -> Bool {
  // An aliased re-export (`export ./lib.vibe { greet as salute }`) is bound
  // surface-only, which `env_lookup` does not resolve: its markers were
  // dropped, so an importer of `salute` could not omit its optional argument.
  match env_lookup_binding_including_surface(env = env, name = name) {
    Some(_) => true,
    None => false
  }
}
/// Every declaration line, with its declared type-parameter ARITY.
///
/// `params` used to reach a line only through
/// `interface_canonical_type_expr(payload, params)`, so a declaration whose
/// payloads never mention a parameter serialized identically at every arity --
/// `enum E[A] { Only }` and `enum E[A, B] { Only }` were one line, while the
/// checker registers a derived witness against `E[A]` and `E[A, B]`
/// respectively (Codex on #2742, P1). Measured, the same hole was open in the
/// enum, struct, alias and effect arms.
///
/// Taking `params` as a PARAMETER rather than folding the count in at each arm
/// is the point: every arm has to state its own, so a new one cannot quietly
/// omit it. Forms with no type parameters pass an empty array.
///
/// The COUNT, not the names: `E[A]` and `E[B]` are the same declaration, so
/// recording names would report a rename as a change. That is the same
/// invariant `trait_impl_identity_line` already records for an impl's own
/// parameters.
fn engine_interface_decl_line(prefix: String, name: String, params: Array[String], body: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = prefix)
  StringBuilder::push(out, value = engine_interface_segment(name))
  StringBuilder::push(out, value = engine_interface_segment("\{Array::length(params)}"))
  StringBuilder::push(out, value = body)
  StringBuilder::freeze(out)
}
export fn engine_interface_bracketed(items: Array[String], separator: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "[")
  StringBuilder::push(out, value = String::join(items, sep = separator))
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}
/// The export FLAG belongs on the line exactly when `include_private` is on.
///
/// With it off every emitted line is exported by construction, so the flag is
/// constant and recording it would only churn the interface identity's
/// preimage. With it on BOTH kinds are in the list, and the flag is then the
/// only thing telling them apart -- which matters because it is not
/// decoration: `interface_public_trait_names` puts a trait in the export
/// surface only when its declaration is exported (or an `SExport` names it),
/// and `restrict_env_to_export_surface` keeps an `EnvTraitImpl` only when its
/// trait is in that surface. Flipping `export trait Marker` to `trait Marker`
/// therefore withdraws every `Marker` impl from the published environment with
/// the trait's own text unchanged (Codex on #2742, P1: the same mechanism it
/// found for `SExport`).
///
/// Every arm goes through this one door so a new one cannot quietly emit an
/// unstamped line.
fn engine_interface_push_decl_line(lines: Array[String], exported: Bool, include_private: Bool, line: String) -> Unit {
  if include_private {
    Array::push(lines, value = String::concat(if exported {
      "pub:"
    } else {
      "prv:"
    }, line))
  } else {
    Array::push(lines, value = line)
  }
}
/// The 7 statement kinds below ARE the type-level namespace of a module: the
/// declarations that introduce a name a type expression can resolve to. The
/// interface identity wants only the exported ones; the witness set
/// (`trait_witness_module_row`) wants them all, because a PRIVATE declaration
/// can shadow an imported name and re-resolve an impl target without appearing
/// in any interface (Codex on #2742, P1). One serializer, two callers, so the
/// two cannot drift apart.
/// Whether one declaration belongs in the serialized list.
///
/// An aggregate `export { Name }` publishes a declaration that does not carry
/// `export` itself -- `interface_public_trait_names` and
/// `interface_public_type_names` both already put such a name in the export
/// surface, and `restrict_env_to_export_surface` publishes accordingly. The
/// serializer did not agree: it read the declaration's OWN flag, so an
/// aggregate-exported declaration's contents were omitted from the interface
/// identity while its contents were published (Codex on #2756, P2).
///
/// Measured on the head before the fix, one probe module per kind, comparing
/// the module's `interface_fingerprint` across a body edit:
///
/// | aggregate-exported private declaration | edit | fingerprint |
/// |---|---|---|
/// | `trait Marker` | method renamed, method added | UNCHANGED |
/// | `effect Log` | operation renamed | UNCHANGED |
/// | `struct Point` | `derive(Eq)` -> `derive(Eq, Show)` | UNCHANGED |
/// | `enum Hue` | a whole variant added | UNCHANGED |
///
/// so it was not confined to the kinds with no value binding. A struct's and
/// an alias's TYPE still moved the identity through the `value:` row its
/// constructor produces, which is why the hole is easy to miss: the parts that
/// row cannot carry -- derives, enum variants, trait methods, effect
/// operations, effectset members -- were the ones that went unrecorded.
///
/// Taking the set as a PARAMETER rather than computing it inside is what keeps
/// the two callers honest about their own policy: the identity passes the real
/// set, and `trait_witness_module_row` passes an empty one because it already
/// emits every declaration under `include_private` and records the aggregate
/// export as its own `export:` row -- so its preimage is unchanged by this.
fn engine_interface_decl_selected(exported: Bool, name: String, aggregate: Array[String], include_private: Bool) -> Bool {
  exported || include_private || contains_str(arr = aggregate, target = name)
}
export fn engine_interface_decl_lines(stmts: Array[Stmt], include_private: Bool, aggregate: Array[String]) -> Array[String] {
  let lines = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(exported, name, params, variants, derives) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        let vs = array_empty()
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, fields) = Array::get(variants, at = j)
          let fs = array_empty()
          let mut k = 0
          while k < Array::length(fields) {
            Array::push(fs, value = engine_interface_canonical_type_expr(ty = Array::get(fields, at = k), params = params))
            k = k + 1
          }
          Array::push(vs, value = String::concat(engine_interface_segment(vname), String::concat("[", String::concat(String::join(fs, sep = ";"), "]"))))
          j = j + 1
        }
        let enum_body = StringBuilder::new()
        StringBuilder::push(enum_body, value = engine_interface_bracketed(items = vs, separator = ";"))
        StringBuilder::push(enum_body, value = "derive")
        StringBuilder::push(enum_body, value = engine_interface_bracketed(items = engine_interface_sorted_unique(derives), separator = ","))
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "enum:", name = name, params = params, body = StringBuilder::freeze(enum_body)))
      } else {
        ()
      },
      SSuberror(exported, name, variants) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        let vs = array_empty()
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, fields) = Array::get(variants, at = j)
          let fs = array_empty()
          let mut k = 0
          while k < Array::length(fields) {
            Array::push(fs, value = engine_interface_canonical_type_expr(ty = Array::get(fields, at = k), params = array_empty()))
            k = k + 1
          }
          Array::push(vs, value = String::concat(engine_interface_segment(vname), String::concat("[", String::concat(String::join(fs, sep = ";"), "]"))))
          j = j + 1
        }
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "suberror:", name = name, params = array_empty(), body = engine_interface_bracketed(items = vs, separator = ";")))
      } else {
        ()
      },
      SStruct(exported, name, fields, derives, mut_fields, params) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        let fs = array_empty()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, ftype) = Array::get(fields, at = j)
          let field_mutability = if contains_str(arr = mut_fields, target = fname) {
            "mut"
          } else {
            "imm"
          }
          Array::push(fs, value = String::concat(engine_interface_segment(fname), String::concat(":", String::concat(field_mutability, String::concat(":", engine_interface_canonical_type_expr(ty = ftype, params = params))))))
          j = j + 1
        }
        let struct_body = StringBuilder::new()
        StringBuilder::push(struct_body, value = engine_interface_bracketed(items = fs, separator = ";"))
        StringBuilder::push(struct_body, value = "derive")
        StringBuilder::push(struct_body, value = engine_interface_bracketed(items = engine_interface_sorted_unique(derives), separator = ","))
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "struct:", name = name, params = params, body = StringBuilder::freeze(struct_body)))
      } else {
        ()
      },
      STypeAlias(exported, name, params, body) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "alias:", name = name, params = params, body = engine_interface_canonical_type_expr(ty = body, params = params)))
      } else {
        ()
      },
      STrait(exported, name, supers, methods, method_gens, header_params) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        let ms = array_empty()
        let mut j = 0
        while j < Array::length(methods) {
          let (mname, args, ret) = Array::get(methods, at = j)
          // `parse_trait_methods` records a generic row for every method in
          // source order, including an empty row. Pair positionally rather
          // than by name so binder ownership remains observable even for
          // duplicate method spellings in an otherwise accepted source AST.
          let (generic_method, method_params, generic_bounds) = if j < Array::length(method_gens) {
            Array::get(method_gens, at = j)
          } else {
            ("<missing-method-generic-provenance>", array_empty(), array_empty())
          }
          let bound_rows = array_empty()
          let malformed_rows = engine_interface_trait_generic_malformed_rows(method_params = method_params, generic_bounds = generic_bounds)
          let mut p = 0
          while p < Array::length(method_params) {
            let param_name = Array::get(method_params, at = p)
            let labels = array_empty()
            let mut b = 0
            while b < Array::length(generic_bounds) {
              let (bound_name, bound_labels) = Array::get(generic_bounds, at = b)
              if bound_name == param_name {
                let mut q = 0
                while q < Array::length(bound_labels) {
                  Array::push(labels, value = Array::get(bound_labels, at = q))
                  q = q + 1
                }
              } else {
                ()
              }
              b = b + 1
            }
            Array::push(bound_rows, value = String::concat(String::concat("method:", __to_string(p)), String::concat("=", String::join(engine_interface_sorted_unique(labels), sep = ","))))
            p = p + 1
          }
          let arg_lines = array_empty()
          let mut k = 0
          while k < Array::length(args) {
            Array::push(arg_lines, value = engine_interface_canonical_trait_method_type_expr(ty = Array::get(args, at = k), header_params = header_params, method_params = method_params))
            k = k + 1
          }
          let method_body = StringBuilder::new()
          // Keep the source row's method spelling in the serialization. It is
          // normally equal to mname, but retaining it makes malformed or
          // manually-constructed AST binder association fail closed.
          StringBuilder::push(method_body, value = "source-method")
          StringBuilder::push(method_body, value = engine_interface_segment(generic_method))
          StringBuilder::push(method_body, value = "gens")
          StringBuilder::push(method_body, value = engine_interface_bracketed(items = bound_rows, separator = ";"))
          StringBuilder::push(method_body, value = "malformed")
          StringBuilder::push(method_body, value = engine_interface_bracketed(items = malformed_rows, separator = ";"))
          StringBuilder::push(method_body, value = "args")
          StringBuilder::push(method_body, value = engine_interface_bracketed(items = arg_lines, separator = ";"))
          StringBuilder::push(method_body, value = "ret")
          StringBuilder::push(method_body, value = engine_interface_segment(engine_interface_canonical_trait_method_type_expr(ty = ret, header_params = header_params, method_params = method_params)))
          Array::push(ms, value = String::concat(engine_interface_segment(mname), StringBuilder::freeze(method_body)))
          j = j + 1
        }
        let surplus_method_rows = engine_interface_surplus_method_generic_rows(method_count = Array::length(methods), method_gens = method_gens)
        let header_rows = array_empty()
        let mut h = 0
        while h < Array::length(header_params) {
          Array::push(header_rows, value = String::concat("header:", __to_string(h)))
          h = h + 1
        }
        let trait_body = StringBuilder::new()
        StringBuilder::push(trait_body, value = "header-gens")
        StringBuilder::push(trait_body, value = engine_interface_bracketed(items = header_rows, separator = ";"))
        StringBuilder::push(trait_body, value = "header-malformed")
        StringBuilder::push(trait_body, value = engine_interface_bracketed(items = engine_interface_trait_header_malformed_rows(header_params), separator = ";"))
        StringBuilder::push(trait_body, value = "super")
        StringBuilder::push(trait_body, value = engine_interface_bracketed(items = engine_interface_sorted_unique(supers), separator = ","))
        StringBuilder::push(trait_body, value = "methods")
        StringBuilder::push(trait_body, value = engine_interface_bracketed(items = ms, separator = ";"))
        StringBuilder::push(trait_body, value = "surplus-method-generics")
        StringBuilder::push(trait_body, value = engine_interface_bracketed(items = surplus_method_rows, separator = ";"))
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "trait:", name = name, params = header_params, body = StringBuilder::freeze(trait_body)))
      } else {
        ()
      },
      SEffectDef(exported, name, params, ops, owner) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        let os = array_empty()
        let mut j = 0
        while j < Array::length(ops) {
          let (opname, args, ret) = Array::get(ops, at = j)
          let arg_lines = array_empty()
          let mut k = 0
          while k < Array::length(args) {
            Array::push(arg_lines, value = engine_interface_canonical_type_expr(ty = Array::get(args, at = k), params = params))
            k = k + 1
          }
          Array::push(os, value = String::concat(engine_interface_segment(opname), String::concat("[", String::concat(String::join(arg_lines, sep = ";"), String::concat("]", engine_interface_canonical_type_expr(ty = ret, params = params))))))
          j = j + 1
        }
        // ADR-0124 (#2656): the owner is part of the published declaration.
        let prefix = match owner {
          HostProvided => "extern-effect:",
          ProgramHandled => "effect:"
        }
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = prefix, name = name, params = params, body = engine_interface_bracketed(items = os, separator = ";")))
      } else {
        ()
      },
      SEffectSet(exported, name, members) => if engine_interface_decl_selected(exported = exported, name = name, aggregate = aggregate, include_private = include_private) {
        engine_interface_push_decl_line(lines = lines, exported = exported, include_private = include_private, line = engine_interface_decl_line(prefix = "effectset:", name = name, params = array_empty(), body = engine_interface_bracketed(items = engine_interface_sorted_unique(members), separator = ",")))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  engine_interface_sorted_unique(lines)
}
fn engine_interface_public_decl_lines(_ stmts: Array[Stmt]) -> Array[String] {
  engine_interface_decl_lines(stmts = stmts, include_private = false, aggregate = aggregate_export_names(stmts))
}
/// A trace-only canonical token-stream identity. It length-delimits each token's
/// kind and exact source lexeme, retaining every parser-visible distinction even
/// where today's unlocated AST or printer is lossy. Whitespace and comments
/// between tokens, spans, and the module filesystem path are omitted. The
/// successful parse is repeated here only for the opt-in observation path so a
/// malformed or incomplete stream fails closed. This is deliberately
/// provisional syntax identity, not normalized typed IR.
export fn engine_incremental_implementation_identity(_ source: String) -> String with Exception {
  engine_incremental_implementation_identity_with_config(source, cfg = target_cfg_ambient())
}

/// Use this invocation's target flags for parsing and cache identity.
export fn engine_incremental_implementation_identity_with_config(_ source: String, cfg: TargetCfg) -> String with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let _ = parse_program_located_with_cfg(tokens = tokens, starts = starts, source = source, cfg_flags = target_cfg_flags(cfg))
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-module-token-stream:v1\n")
  let mut i = 0
  while i < Array::length(tokens) {
    StringBuilder::push(out, value = engine_interface_segment(token_to_string(Array::get(tokens, at = i))))
    let start = Array::get(starts, at = i)
    let end = Array::get(ends, at = i)
    StringBuilder::push(out, value = engine_interface_segment(source[start: end]))
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}
/// The ONE spelling of the interface identity's preimage version.
///
/// It was two: the preimage itself, and the `interface_fingerprint_kind` the
/// invalidation trace advertises. Bumping v4 to v5 for the arity fix moved the
/// first and left the second, so every trace claimed to be a v4 fingerprint
/// while carrying a v5 one -- and nothing caught it, because the oracle pins
/// the advertised label and both copies of the lie agreed (Codex on #2747, P2).
///
/// A version that can be bumped in one place and not the other is not a
/// version. Both sites read this.
export fn engine_interface_identity_version() -> String {
  "vibe-module-interface:v7"
}
/// What an aggregate `export { .. }` names when it does NOT name a value.
///
/// #2762: the interface identity ROW for one exported name, or `None` when the
/// module resolves nothing under that name.
///
/// The classifier is `export_local_nonvalue_kind`, imported from the checker
/// -- the SAME function the refusal consults (`unresolved_aggregate_export_name`
/// there is defined in terms of it). That is what keeps the identity and the
/// refusal from drifting: a kind added to the classifier starts producing a row
/// here AND stops being refused there, in one edit. Before #2762 only the
/// identity existed, so `export { NotDeclaredAnywhere }` checked CLEAN on the
/// lane every build uses and threw `exported name missing from checked
/// environment` on the lane the invalidation trace uses -- the two disagreed
/// about whether the module was a program.
fn engine_interface_export_row(stmts: Array[Stmt], bindings: Array[(String, Type)], name: String) -> Option[String] {
  match env_lookup_flat(bindings = bindings, name = name) {
    Some(ty) => Some(String::concat("value:", String::concat(engine_interface_segment(name), String::concat(":", engine_interface_canonical_type(ty = ty, ids = array_empty(), names = array_empty()))))),
    None => match export_local_nonvalue_kind(stmts = stmts, name = name) {
      Some(kind) => Some(String::concat("export-", String::concat(kind, String::concat(":", engine_interface_segment(name))))),
      None => None
    }
  }
}
export fn engine_incremental_interface_identity(source: String, env: TypeEnv) -> String with Env + Exception {
  engine_incremental_interface_identity_with_config(source = source, env = env, cfg = target_cfg_ambient())
}

/// Use this invocation's target flags for parsing and cache identity.
export fn engine_incremental_interface_identity_with_config(source: String, env: TypeEnv, cfg: TargetCfg) -> String with Env + Exception {
  let stmts = engine_parse_program_with_path_with_config(path = "<incremental-interface-observation>", source = source, cfg = cfg)
  let out = StringBuilder::new()
  StringBuilder::push(out, value = String::concat(engine_interface_identity_version(), "\n"))
  let names = engine_interface_public_value_names(stmts)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    match engine_interface_export_row(stmts = stmts, bindings = env_flat_bindings(env), name = name) {
      Some(row) => StringBuilder::push(out, value = row),
      // #2762 made this unreachable from the checker's own lanes: a module
      // whose `export { }` names nothing is refused before it can be
      // observed. It stays fail-closed for the re-export and
      // declaration-exported names this list also carries, which the checker
      // refuses elsewhere (or not at all, if a route is ever found).
      None => throw(String::concat("incremental interface observation: exported name missing from checked environment: ", name))
    }
    StringBuilder::push(out, value = "\n")
    i = i + 1
  }
  let decls = engine_interface_public_decl_lines(stmts)
  let mut d = 0
  while d < Array::length(decls) {
    StringBuilder::push(out, value = Array::get(decls, at = d))
    StringBuilder::push(out, value = "\n")
    d = d + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}
/// A trace-only canonical identity for the checked effective value environment.
/// `env_flat_bindings` deliberately excludes trait/impl/type/effect declarations;
/// duplicate names resolve through the same first-binding lookup used by the
/// checker. The existing canonical Type serializer alpha-normalizes quantified
/// variables and sorts/deduplicates bounds and effects. This is not the
/// persistent TypeEnv codec and is never read by a cache lookup.
export fn engine_incremental_checked_env_identity(_ env: TypeEnv) -> String with Exception {
  let bindings = env_flat_bindings(env)
  let raw_names = array_empty()
  let mut b = 0
  while b < Array::length(bindings) {
    let (name, _) = Array::get(bindings, at = b)
    // The checker records each declared function's return annotation under
    // this private bookkeeping name. It is not a user value binding (and can
    // retain source spelling such as a generic parameter), so including it
    // would violate the observation's alpha-normal value-env contract.
    if !String::starts_with(name, prefix = "__fn_ret__:") {
      Array::push(raw_names, value = name)
    } else {
      ()
    }
    b = b + 1
  }
  let names = engine_interface_sorted_unique(raw_names)
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-module-checked-env:v3\n")
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    match env_lookup_flat(bindings = bindings, name = name) {
      Some(ty) => {
        StringBuilder::push(out, value = "value:")
        StringBuilder::push(out, value = engine_interface_segment(name))
        StringBuilder::push(out, value = engine_interface_segment(engine_interface_canonical_type(ty = ty, ids = array_empty(), names = array_empty())))
        StringBuilder::push(out, value = "\n")
      },
      None => throw(String::concat("incremental checked environment observation: effective value missing from flattened environment: ", name))
    }
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}
/// A trace-only observation of the complete persistent TypeEnv v9 transport.
/// The canonical cache-text bytes are the sole input. This is not a
/// CheckedProgram, typed IR, exported interface, cache key, or reuse decision.
export fn engine_incremental_persistent_type_env_transport_identity(_ env: TypeEnv) -> String {
  compact_string_fingerprint(encode_checked_environment(env))
}
