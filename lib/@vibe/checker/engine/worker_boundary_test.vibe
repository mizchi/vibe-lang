import @vibe/compiler/loader {
  collect_source_groups_fs
}

test "the real worker imports the engine without compiler codegen or entry packages" {
  let groups = collect_source_groups_fs("lib/@vibe/checker/worker/worker.vibe")
  let mut found_engine = false
  let mut found_worker = false
  for group in groups {
    for row in group.1 {
      let path = row.0
      assert(!String::contains(path, "/compiler/codegen/"))
      assert(!String::contains(path, "/compiler/entry/"))
      assert(path != "lib/@vibe/compiler/runtime/index.vpkg")
      if path == "lib/@vibe/checker/engine/module_check.vibe" {
        found_engine = true
      }
      if path == "lib/@vibe/checker/worker/worker.vibe" {
        found_worker = true
      }
    }
  }
  assert(found_engine)
  assert(found_worker)
}
