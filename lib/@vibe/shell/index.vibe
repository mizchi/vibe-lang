export let version = "0.0.1"
export ./types.vibe { type FileEntry }
export ./commands.vibe { cd, cp, ls, mv, rm, cat, env, pwd, tee, echo, exec, find, mkdir, print, touch, append, env_or, exists, is_dir, ls_all, is_file, mkdir_p, println, realpath, sleep_ms, read_line, exec_lines, write_file }
export ./commands_extra.vibe { df, du, tree, which, diff_files }
export ./glob.vibe { glob }
export ./pipeline.vibe { jq, nl, tr, wc, cut, len, seq, tac, grep, trim, uniq, wc_l, count, lines, lower, names, paste, split, upper, expand, jq_arr, jq_num, jq_str, char_at, dirname, extname, grep_re, map_str, replace, rev_str, basename, drop_str, head_str, index_of, join_str, pad_left, seq_step, sort_str, tail_str, take_str, count_str, ends_with, pad_right, filter_str, repeat_str, starts_with, where_entry, contains_str, take_entries, count_entries, last_index_of }
export ./from_csv.vibe { from_csv }
export ./from_yaml.vibe { from_yaml }

// Canonical collision-safe aliases
//
// #768/#778: each of these was missing its `with { ... }` effect annotation
// entirely (checker error: "use of undeclared effect"), and used
// `perform <Effect>::<Op>` bodies -- the perform/effect-op codegen path for
// magic host effects can crash with an uncaught wasm exception when no
// handler is installed (see #778). Both fixed: added the effect row and
// switched to the direct-call builtin form every other working call site
// in the compiler uses.
export fn shell_print(text: String) -> Unit with { Stdout } {
  Stdout::write_stream(text)
}

export fn shell_println(text: String) -> Unit with { Stdout } {
  Stdout::write_stream(text)
  Stdout::write_char(10)
}

export fn shell_read_line() -> String with { Stdin } {
  Stdin::read_stream(4096)
}

export fn shell_exists(path: String) -> Bool with { Fs } {
  Fs::exists(path)
}

export fn shell_is_dir(path: String) -> Bool with { Fs } {
  Fs::is_dir(path)
}

export fn shell_is_file(path: String) -> Bool with { Fs } {
  Fs::is_file(path)
}

export fn shell_write_file(path: String, content: String) -> Unit with { Fs } {
  Fs::write_file(path, content)
}
