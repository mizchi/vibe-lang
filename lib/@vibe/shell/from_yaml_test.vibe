//# Imports

import ./from_yaml.vibe {
  from_yaml
}

// #777: these `Json::xxx(...)` calls were written against the MoonBit
// host's builtin `Json` type (auto-imported methods, no explicit import
// needed). The selfhost `@vibe/json` package only ships Result-based
// primitives, so use the direct-value convenience wrappers instead
// (`Json::field`, not `Json::get` — see json_convenience.vibe's header for
// why the name differs from the host-era API these tests were written
// against).
import ../json/index.vibe {
  Json::field, Json::index, Json::length, Json::number, Json::string, Json::bool, Json::is_null
}

//# Misc

test "yaml simple key-value" {
  let data = from_yaml("name: vibe")
  assert(Json::string(Json::field(data, "name")) == "vibe")
}

test "yaml number value" {
  let data = from_yaml("port: 8080")
  assert(eq(Json::number(Json::field(data, "port")), 8080.0))
}

test "yaml bool and null" {
  let data = from_yaml("flag: true\nval: null")
  assert(Json::bool(Json::field(data, "flag")))
  assert(Json::is_null(Json::field(data, "val")))
}

test "yaml nested object" {
  let data = from_yaml("db:\n  host: localhost\n  port: 5432")
  assert(Json::string(Json::field(Json::field(data, "db"), "host")) == "localhost")
  assert(eq(Json::number(Json::field(Json::field(data, "db"), "port")), 5432.0))
}

test "yaml list" {
  let data = from_yaml("- a\n- b\n- c")
  assert(Json::length(data) == 3)
  assert(Json::string(Json::index(data, 0)) == "a")
  assert(Json::string(Json::index(data, 2)) == "c")
}

test "yaml list in mapping" {
  let data = from_yaml("items:\n  - x\n  - y")
  let items = Json::field(data, "items")
  assert(Json::length(items) == 2)
}

test "yaml quoted string with colon" {
  let data = from_yaml("msg: 'hello: world'")
  assert(Json::string(Json::field(data, "msg")) == "hello: world")
}

test "yaml comment stripping" {
  let data = from_yaml("key: val # this is a comment")
  assert(Json::string(Json::field(data, "key")) == "val")
}

test "yaml tilde is null" {
  let data = from_yaml("x: ~")
  assert(Json::is_null(Json::field(data, "x")))
}

test "yaml scalar document values" {
  assert(eq(Json::number(from_yaml("42")), 42.0))
  assert(Json::bool(from_yaml("true")))
  assert(Json::is_null(from_yaml("null")))
  assert(Json::string(from_yaml("hello")) == "hello")
}

test "yaml numeric scalar detection includes negative and decimal" {
  let data = from_yaml("neg: -12\npi: 3.5")
  assert(eq(Json::number(Json::field(data, "neg")), -12.0))
  assert(eq(Json::number(Json::field(data, "pi")), 3.5))
}

test "yaml keeps hash inside quoted values" {
  let data = from_yaml("msg: \"a # b\"")
  assert(Json::string(Json::field(data, "msg")) == "a # b")
}

test "yaml multiple keys" {
  let data = from_yaml("a: 1\nb: 2\nc: 3")
  assert(eq(Json::number(Json::field(data, "a")), 1.0))
  assert(eq(Json::number(Json::field(data, "b")), 2.0))
  assert(eq(Json::number(Json::field(data, "c")), 3.0))
}
