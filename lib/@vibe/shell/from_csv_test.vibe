//# Imports

// #897: retargeted from direct impl-file imports to the package directory —
// pipeline.vibe references `FileEntry`, whose transparent definition now
// lives in index.vpkg's facade; a direct impl-file import would merge
// pipeline.vibe without that definition.
import .{
  _csv_escape_json, _csv_is_number, _csv_parse_line, from_csv, jq_arr, jq_str, map_str
}

// #777: these `Json::xxx(...)` calls were written against the MoonBit
// host's builtin `Json` type (auto-imported methods, no explicit import
// needed). The selfhost `@vibe/json` package only ships Result-based
// primitives, so use the direct-value convenience wrappers instead
// (`Json::field`, not `Json::get` — see json_convenience.vibe's header for
// why the name differs from the host-era API these tests were written
// against).
// #897: directory form (not `../json/index.vibe`) — json is a .vpkg
// contract package now.
import ../json {
  Json::field, Json::index, Json::length, Json::number, Json::stringify, Json::string
}

//# Misc

test "csv basic: name and age" {
  let data = from_csv("name,age\nalice,30\nbob,25")
  assert(Json::length(data) == 2)
  assert(Json::string(Json::field(Json::index(data, 0), "name")) == "alice")
  assert(Json::string(Json::field(Json::index(data, 1), "name")) == "bob")
}

test "csv number detection" {
  let data = from_csv("name,age\nalice,30")
  let row = Json::index(data, 0)
  assert(eq(Json::number(Json::field(row, "age")), 30.0))
}

test "csv quoted field with comma" {
  let data = from_csv("name,desc\nalice,\"hello, world\"")
  let row = Json::index(data, 0)
  assert(Json::string(Json::field(row, "desc")) == "hello, world")
}

test "csv escaped double quote" {
  let data = from_csv("name,desc\nalice,\"say \"\"hi\"\"\"")
  let row = Json::index(data, 0)
  assert(Json::string(Json::field(row, "desc")) == "say \"hi\"")
}

test "csv empty field" {
  let data = from_csv("a,b,c\n1,,3")
  let row = Json::index(data, 0)
  assert(Json::string(Json::field(row, "b")) == "")
}

test "csv pipeline: from_csv |> Json::stringify |> jq_arr |> map_str" {
  let names = Json::stringify(from_csv("name,age\nalice,30\nbob,25"))
  |>jq_arr()
  |>map_str((row: String) -> String {
    jq_str(row, "name")
  })
  assert(Array::length(names) == 2)
  assert(Array::get(names, 0) == "alice")
  assert(Array::get(names, 1) == "bob")
}

test "_csv_is_number" {
  assert(_csv_is_number("42"))
  assert(_csv_is_number("3.14"))
  assert(_csv_is_number("-1"))
  assert(not(_csv_is_number("")))
  assert(not(_csv_is_number("abc")))
  assert(not(_csv_is_number("1.2.3")))
}

test "_csv_parse_line basic" {
  let fields = _csv_parse_line("a,b,c")
  assert(Array::length(fields) == 3)
  assert(Array::get(fields, 0) == "a")
  assert(Array::get(fields, 1) == "b")
  assert(Array::get(fields, 2) == "c")
}

test "_csv_escape_json" {
  assert(_csv_escape_json("hello") == "hello")
  assert(_csv_escape_json("a\"b") == "a\\\"b")
  assert(_csv_escape_json("a\\b") == "a\\\\b")
}
