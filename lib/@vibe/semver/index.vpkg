fn gte(a: Semver, b: Semver) -> Bool
fn lte(a: Semver, b: Semver) -> Bool
fn bump_major(_ v: Semver) -> Semver
fn bump_minor(_ v: Semver) -> Semver
fn bump_patch(_ v: Semver) -> Semver
fn Semver::major(_ v: Semver) -> Int
fn Semver::minor(_ v: Semver) -> Int
fn Semver::patch(_ v: Semver) -> Int
fn Semver::to_string(_ v: Semver) -> String
fn Semver::prerelease(_ v: Semver) -> String

