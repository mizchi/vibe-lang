//# Imports

import ./semver.vibe {
  Semver::major,
  Semver::minor,
  Semver::patch,
  Semver::prerelease,
  Semver::to_string,
  bump_major,
  bump_minor,
  bump_patch,
  compare,
  eq,
  gt,
  gte,
  lt,
  lte,
  parse
}

//# Misc

test "parse basic version" {
  let v = parse("1.2.3")
  assert(Semver::major(v) == 1)
  assert(Semver::minor(v) == 2)
  assert(Semver::patch(v) == 3)
  assert(Semver::prerelease(v) == "")
}

test "parse with v prefix" {
  let v = parse("v2.0.1")
  assert(Semver::major(v) == 2)
  assert(Semver::minor(v) == 0)
  assert(Semver::patch(v) == 1)
}

test "parse zero version" {
  let v = parse("0.0.0")
  assert(Semver::major(v) == 0)
  assert(Semver::minor(v) == 0)
  assert(Semver::patch(v) == 0)
}

test "parse major only" {
  let v = parse("5")
  assert(Semver::major(v) == 5)
  assert(Semver::minor(v) == 0)
  assert(Semver::patch(v) == 0)
}

test "parse major.minor only" {
  let v = parse("3.7")
  assert(Semver::major(v) == 3)
  assert(Semver::minor(v) == 7)
  assert(Semver::patch(v) == 0)
}

test "parse with prerelease" {
  let v = parse("1.0.0-alpha")
  assert(Semver::major(v) == 1)
  assert(Semver::prerelease(v) == "alpha")
}

test "parse dotted prerelease" {
  let v = parse("1.0.0-alpha.1")
  assert(Semver::prerelease(v) == "alpha.1")
}

test "parse complex prerelease" {
  let v = parse("2.1.0-rc.3.build.456")
  assert(Semver::major(v) == 2)
  assert(Semver::minor(v) == 1)
  assert(Semver::patch(v) == 0)
  assert(Semver::prerelease(v) == "rc.3.build.456")
}

test "parse large version numbers" {
  let v = parse("100.200.300")
  assert(Semver::major(v) == 100)
  assert(Semver::minor(v) == 200)
  assert(Semver::patch(v) == 300)
}

test "parse v prefix with prerelease" {
  let v = parse("v1.0.0-beta")
  assert(Semver::major(v) == 1)
  assert(Semver::prerelease(v) == "beta")
}

test "to_string roundtrip basic" {
  let v = parse("3.2.1")
  assert(Semver::to_string(v) == "3.2.1")
}

test "to_string roundtrip with prerelease" {
  let v = parse("1.0.0-beta.1")
  assert(Semver::to_string(v) == "1.0.0-beta.1")
}

test "to_string zero version" {
  assert(Semver::to_string(parse("0.0.0")) == "0.0.0")
}

test "to_string strips v prefix" {
  assert(Semver::to_string(parse("v1.2.3")) == "1.2.3")
}

test "to_string large numbers" {
  assert(Semver::to_string(parse("99.88.77")) == "99.88.77")
}

test "compare equal versions" {
  assert(eq(a = parse("1.2.3"), b = parse("1.2.3")))
  assert(eq(a = parse("0.0.0"), b = parse("0.0.0")))
  assert(eq(a = parse("1.0.0-alpha"), b = parse("1.0.0-alpha")))
}

test "compare patch difference" {
  assert(lt(a = parse("1.2.3"), b = parse("1.2.4")))
  assert(gt(a = parse("1.2.4"), b = parse("1.2.3")))
}

test "compare minor difference" {
  assert(lt(a = parse("1.2.9"), b = parse("1.3.0")))
  assert(gt(a = parse("1.3.0"), b = parse("1.2.9")))
}

test "compare major difference" {
  assert(lt(a = parse("1.9.9"), b = parse("2.0.0")))
  assert(gt(a = parse("2.0.0"), b = parse("1.9.9")))
}

test "compare major takes precedence over minor" {
  assert(gt(a = parse("2.0.0"), b = parse("1.99.99")))
}

test "compare minor takes precedence over patch" {
  assert(gt(a = parse("1.1.0"), b = parse("1.0.99")))
}

test "prerelease less than release" {
  assert(lt(a = parse("1.0.0-alpha"), b = parse("1.0.0")))
  assert(gt(a = parse("1.0.0"), b = parse("1.0.0-alpha")))
}

test "prerelease alpha less than beta" {
  assert(lt(a = parse("1.0.0-alpha"), b = parse("1.0.0-beta")))
  assert(gt(a = parse("1.0.0-beta"), b = parse("1.0.0-alpha")))
}

test "prerelease ordering alpha < beta < rc" {
  assert(lt(a = parse("1.0.0-alpha"), b = parse("1.0.0-beta")))
  assert(lt(a = parse("1.0.0-beta"), b = parse("1.0.0-rc")))
  assert(lt(a = parse("1.0.0-alpha"), b = parse("1.0.0-rc")))
}

test "prerelease dotted ordering" {
  assert(lt(a = parse("1.0.0-alpha.1"), b = parse("1.0.0-alpha.2")))
  assert(lt(a = parse("1.0.0-alpha.2"), b = parse("1.0.0-beta.1")))
}

test "prerelease equal" {
  assert(eq(a = parse("1.0.0-beta"), b = parse("1.0.0-beta")))
  assert(eq(a = parse("1.0.0-rc.1"), b = parse("1.0.0-rc.1")))
}

test "both no prerelease are equal" {
  assert(eq(a = parse("2.3.4"), b = parse("2.3.4")))
}

test "gte lte functions" {
  assert(gte(a = parse("1.2.3"), b = parse("1.2.3")))
  assert(gte(a = parse("1.2.4"), b = parse("1.2.3")))
  assert(not(gte(a = parse("1.2.2"), b = parse("1.2.3"))))
  assert(lte(a = parse("1.2.3"), b = parse("1.2.3")))
  assert(lte(a = parse("1.2.3"), b = parse("1.2.4")))
  assert(not(lte(a = parse("1.2.4"), b = parse("1.2.3"))))
}

test "compare returns negative for less" {
  assert(compare(a = parse("1.0.0"), b = parse("2.0.0")) < 0)
  assert(compare(a = parse("1.0.0"), b = parse("1.1.0")) < 0)
  assert(compare(a = parse("1.0.0"), b = parse("1.0.1")) < 0)
}

test "compare returns positive for greater" {
  assert(compare(a = parse("2.0.0"), b = parse("1.0.0")) > 0)
  assert(compare(a = parse("1.1.0"), b = parse("1.0.0")) > 0)
  assert(compare(a = parse("1.0.1"), b = parse("1.0.0")) > 0)
}

test "compare returns zero for equal" {
  assert(compare(a = parse("1.2.3"), b = parse("1.2.3")) == 0)
}

test "bump_major resets minor and patch" {
  let v = bump_major(parse("1.2.3"))
  assert(Semver::to_string(v) == "2.0.0")
  assert(Semver::minor(v) == 0)
  assert(Semver::patch(v) == 0)
}

test "bump_minor resets patch" {
  let v = bump_minor(parse("1.2.3"))
  assert(Semver::to_string(v) == "1.3.0")
  assert(Semver::patch(v) == 0)
}

test "bump_patch increments only patch" {
  let v = bump_patch(parse("1.2.3"))
  assert(Semver::major(v) == 1)
  assert(Semver::minor(v) == 2)
  assert(Semver::patch(v) == 4)
}

test "bump_major clears prerelease" {
  let v = bump_major(parse("1.0.0-alpha"))
  assert(Semver::prerelease(v) == "")
  assert(Semver::to_string(v) == "2.0.0")
}

test "bump_minor clears prerelease" {
  let v = bump_minor(parse("1.0.0-beta"))
  assert(Semver::prerelease(v) == "")
  assert(Semver::to_string(v) == "1.1.0")
}

test "bump_patch clears prerelease" {
  let v = bump_patch(parse("1.0.0-rc.1"))
  assert(Semver::prerelease(v) == "")
  assert(Semver::to_string(v) == "1.0.1")
}

test "bump from zero" {
  assert(Semver::to_string(bump_major(parse("0.0.0"))) == "1.0.0")
  assert(Semver::to_string(bump_minor(parse("0.0.0"))) == "0.1.0")
  assert(Semver::to_string(bump_patch(parse("0.0.0"))) == "0.0.1")
}

test "chained bumps" {
  let v = bump_patch(bump_minor(bump_major(parse("0.0.0"))))
  assert(Semver::to_string(v) == "1.1.1")
}

test "npm-style versions" {
  assert(gt(a = parse("16.14.0"), b = parse("16.13.2")))
  assert(lt(a = parse("14.21.3"), b = parse("16.0.0")))
}

test "go module versions" {
  assert(lt(a = parse("v1.21.0"), b = parse("v1.22.0")))
  assert(gt(a = parse("v1.22.0"), b = parse("v1.21.5")))
}

test "prerelease workflow" {
  let alpha = parse("2.0.0-alpha")
  let beta = parse("2.0.0-beta")
  let rc1 = parse("2.0.0-rc.1")
  let rc2 = parse("2.0.0-rc.2")
  let release = parse("2.0.0")
  assert(lt(a = alpha, b = beta))
  assert(lt(a = beta, b = rc1))
  assert(lt(a = rc1, b = rc2))
  assert(lt(a = rc2, b = release))
}
