//# Values

//# Functions

/// #768/#778 revert (2026-07-10): these MUST stay `perform Fs::<Op>`, not
/// direct-call. Unlike the compiler-internal call sites this pattern was
/// fixed at, this package's whole design purpose is to be a mockable thin
/// wrapper -- lib/@vibe/fs/index_import_test.vibe drives these through a
/// `handle ... with Fs { ... }` mock handler to test the aliases without
/// touching the real filesystem, which only works if the body actually
/// performs the effect. Switching to direct-call form bypasses the handler
/// entirely and silently talks to the real host instead, which is exactly
/// what broke that test when tried here. `stat_token` is deliberately
/// direct-call (no mock-handler test exercises it) -- but via
/// `vibe_fs_stat_token_raw`, NOT `Fs::stat_token`: index.vibe exports an alias
/// function with that exact name and qualified exports are exempt from the
/// #716 rename, so in a unit bundling the index a free `Fs::stat_token`
/// ident bound to the alias and recursed forever (#795).
export fn exists(path: String) -> Bool with Fs {
  perform Fs::Exists(path)
}

export fn read_file(path: String) -> String with Fs {
  perform Fs::ReadFile(path)
}

export fn stat_token(path: String) -> Int with Fs {
  vibe_fs_stat_token_raw(path)
}

export fn write_file(path: String, content: String) -> Unit with Fs {
  perform Fs::WriteFile(path, content)
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): moved verbatim from the old index.vibe facade.
/// These MUST stay bare VALUE aliases (`export let Fs::exists = exists`),
/// NOT wrapper fns: `perform Fs::<Op>` in the bodies above lowers to a call
/// of the builtin NAME `Fs::<op>` (builtin_name.vibe, e.g. "Fs::Exists" =>
/// "Fs::exists"), and a real fn DEF occupying that exact name hijacks the
/// lowering — empirically, wrapper-fn aliases made `exists` compile to an
/// arity-broken wasm call ("not enough arguments on the stack") in every
/// facade-including unit. A value alias does not participate in that
/// name-to-fn-def resolution (the old index.vibe proves this shape safe).
/// Conformance-wise a bare alias has no signature to fingerprint, so
/// fs_aliases.vibe re-exports these names — #847's re-export trust is what
/// discharges the contract's fn declarations for them.
export let Fs::exists = exists
export let Fs::read_file = read_file
export let Fs::stat_token = stat_token
export let Fs::write_file = write_file
