//# Functions

// #768/#778: direct-call form, not `perform Fs::<Op>` -- the perform/
// effect-op codegen path for magic host effects can crash with an uncaught
// wasm exception in a small compiled unit (see #778's fix + notes).
// `stat_token` below already used the direct-call form; the other three
// didn't, which was an inconsistency within this same file.
export let exists = (path: String) -> Bool with { Fs } {
  Fs::exists(path)
}

export let read_file = (path: String) -> String with { Fs } {
  Fs::read_file(path)
}

export let stat_token = (path: String) -> Int with { Fs } {
  Fs::stat_token(path)
}

export let write_file = (path: String, content: String) -> Unit with { Fs } {
  Fs::write_file(path, content)
}
