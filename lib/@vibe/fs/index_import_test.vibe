// The package index re-exports fs.vibe's perform-based wrappers under the
// canonical `Fs::` alias names. These perform the Fs effect, so drive them
// through a mock handler (as in fs_effect_test.vibe) to confirm the aliases are
// importable and dispatch the effect. Real-FS behaviour is covered by
// fs_test.vibe.

import .{
  Fs::exists, Fs::read_file, Fs::stat_token, Fs::write_file
}
import ./fs_effect.vibe {
  Fs
}

test "fs index re-exports canonical aliases" {
  let content = handle {
    Fs::write_file("/tmp/vibe_fs_index_alias.txt", "ok")
    Fs::read_file("/tmp/vibe_fs_index_alias.txt")
  } with { Fs::ReadFile(_path) => resume("ok"); Fs::WriteFile(_path, _content) => resume(0); Fs::Exists(_path) => resume(true); Fs::Mkdir(_path) => resume(0) }
  assert(content == "ok")
  let present = handle {
    Fs::exists("/tmp/vibe_fs_index_alias.txt")
  } with { Fs::ReadFile(_path) => resume(""); Fs::WriteFile(_path, _content) => resume(0); Fs::Exists(_path) => resume(true); Fs::Mkdir(_path) => resume(0) }
  assert(present)
}

/// #795 regression: the alias function is literally named `Fs::stat_token`,
/// which used to capture fs.vibe's own free `Fs::stat_token` builtin ident
/// (qualified exports are exempt from the #716 rename) -- calling the alias
/// recursed until stack overflow. stat_token is the one deliberate
/// direct-call wrapper (no mock handler), so this CALL hits the real host
/// and must terminate with a real token.
test "Fs::stat_token alias calls the host without recursing" {
  let tok = Fs::stat_token("Taskfile.pkl")
  assert(tok != 0)
}
