// The package index re-exports fs.vibe's perform-based wrappers under the
// canonical `Fs::` alias names. These perform the Fs effect, so drive them
// through a mock handler (as in fs_effect_test.vibe) to confirm the aliases are
// importable and dispatch the effect. Real-FS behaviour is covered by
// fs_test.vibe.

import .{
  Fs::exists, Fs::read_file, Fs::write_file
}
import ./fs_effect.vibe {
  Fs
}

test "fs index re-exports canonical aliases" {
  let content = handle {
    Fs::write_file("/tmp/vibe_fs_index_alias.txt", "ok")
    Fs::read_file("/tmp/vibe_fs_index_alias.txt")
  } with Fs {
    ReadFile(_path) => resume("ok");
    WriteFile(_path, _content) => resume(0);
    Exists(_path) => resume(true);
    Mkdir(_path) => resume(0)
  }
  assert(content == "ok")
  let present = handle {
    Fs::exists("/tmp/vibe_fs_index_alias.txt")
  } with Fs {
    ReadFile(_path) => resume("");
    WriteFile(_path, _content) => resume(0);
    Exists(_path) => resume(true);
    Mkdir(_path) => resume(0)
  }
  assert(present)
}
