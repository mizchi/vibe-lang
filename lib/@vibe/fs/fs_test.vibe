// Real-FS exercise of the Fs builtins against the preopen filesystem. A test
// block is granted the host effects, so the calls below reach the real
// filesystem with no handler around them. They used to sit under `handle`
// blocks whose arms answered "" / false "for the checker only"; since #1962 a
// handler intercepts the operations it names, direct calls included, so those
// arms would now answer. (fs.vibe's perform-based wrappers are covered,
// mocked, by fs_effect_test.vibe.)

import ./fs_effect.vibe {
  Fs
}

fn do_roundtrip() -> Bool with Fs {
  Fs::write_file("_build/vibe_fs_test.txt", "hello vibe")
  Fs::read_file("_build/vibe_fs_test.txt") == "hello vibe"
}

fn do_exists_true() -> Bool with Fs {
  Fs::write_file("_build/vibe_fs_test_exists.txt", "test")
  Fs::exists("_build/vibe_fs_test_exists.txt")
}

fn do_exists_false() -> Bool with Fs {
  Fs::exists("_build/vibe_fs_nonexistent_file_12345")
}

fn do_stat_stable() -> Bool with Fs {
  Fs::write_file("_build/vibe_fs_test_stat_stable.txt", "a")
  let token1 = Fs::stat_token("_build/vibe_fs_test_stat_stable.txt")
  let token2 = Fs::stat_token("_build/vibe_fs_test_stat_stable.txt")
  eq(token1, token2)
}

fn do_stat_changed() -> Bool with Fs {
  Fs::write_file("_build/vibe_fs_test_stat_changed.txt", "a")
  let token1 = Fs::stat_token("_build/vibe_fs_test_stat_changed.txt")
  Fs::write_file("_build/vibe_fs_test_stat_changed.txt", "longer content")
  let token2 = Fs::stat_token("_build/vibe_fs_test_stat_changed.txt")
  not(eq(token1, token2))
}

test "write_file and read_file roundtrip" {
  let ok = do_roundtrip()
  assert(ok)
}

test "exists returns true for existing file" {
  let ok = do_exists_true()
  assert(ok)
}

test "exists returns false for nonexistent file" {
  let absent = do_exists_false()
  assert(not(absent))
}

test "stat_token is stable for unchanged file" {
  let ok = do_stat_stable()
  assert(ok)
}

test "stat_token changes after write" {
  let changed = do_stat_changed()
  assert(changed)
}
