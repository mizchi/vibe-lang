//# Imports

import ./fs_effect.vibe {
  Fs
}

//# Misc

test "fs mock read + write" {
  let len = handle {
    perform Fs::WriteFile("/tmp/test.txt", "hello world")
    let content = perform Fs::ReadFile("/tmp/test.txt")
    String::length(content)
  } with { Fs::ReadFile(_path) => resume("mock content"); Fs::WriteFile(_path, _content) => resume(0); Fs::Exists(_path) => resume(true); Fs::Mkdir(_path) => resume(0) }
  assert(len == 12)
}

test "fs mock exists check" {
  let exists = handle {
    perform Fs::Exists("/tmp/test.txt")
  } with { Fs::ReadFile(_path) => resume(""); Fs::WriteFile(_path, _content) => resume(0); Fs::Exists(_path) => resume(false); Fs::Mkdir(_path) => resume(0) }
  assert(exists == false)
}
