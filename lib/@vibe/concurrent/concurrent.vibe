//# The stable subset of @vibe/concurrent/experimental (see index.vpkg).

export ./experimental {
  Channel,
  Channel::bounded,
  ChannelConfigError,
  Parallel,
  Parallel::map,
  Receiver,
  Receiver::recv,
  SendError,
  Sender,
  Sender::clone,
  Sender::release,
  Sender::send,
  TaskError,
  TaskGroup,
  TaskGroup::run,
  TaskGroup::spawn,
  TaskHandle,
  TaskHandle::cancel,
  TaskHandle::join
}
