//# The stable subset of @vibe/concurrent/experimental (see index.vpkg).

export ./experimental {
  Channel,
  Channel::bounded,
  ChannelConfigError,
  Parallel,
  Parallel::map,
  Receiver,
  Receiver::recv,
  SendError,
  Sender,
  Sender::clone,
  Sender::release,
  Sender::send,
  TaskError,
  TaskGroup,
  TaskGroup::run,
  TaskGroup::spawn,
  TaskHandle,
  TaskHandle::cancel,
  TaskHandle::join,
  __aw_note,
  __aw_notify_resolve,
  __aw_wait,
  __conc_host_arm,
  __conc_host_cancel,
  __conc_host_sleep_arm,
  __conc_host_sleep_cancel,
  __conc_host_take,
  __conc_host_wait_any,
  __conc_stream_claim
}
