//# Imports

import .{
  TaskGroup::run, TaskGroup::spawn, TaskHandle::join
}

//# Misc

test "x/concurrent index exports the task group API" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      21 * 2
    })
    TaskHandle::join(t)
  })
  assert_eq(r, 42)
}

/// #3155: a local alias of `TaskGroup::run` checks like the direct call. Its
/// row variable used to reach the test as an open `{ e }`.
test "a local alias of TaskGroup::run" {
  let go = TaskGroup::run
  let r = go((n) -> {
    TaskHandle::join(TaskGroup::spawn(n, () -> {
      50 - 8
    }))
  })
  assert_eq(r, 42)
}
