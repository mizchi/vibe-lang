name = @vibe/concurrent/experimental
version = 0.0.1
description =
  #|UNSTABLE: importing this package requires VIBE_UNSTABLE=1. It is the
  #|whole concurrency runtime -- the stable core that @vibe/concurrent
  #|re-exports, plus the suspendable-task lane (spawn_suspend, pump,
  #|sleep_wait, send_wait / recv_wait, ...) whose surface is still moving.
  #|Outside the SemVer promise; see docs/user/reference/stable-surface.md.
deps = {}

generated_hash =

// @vibe/concurrent/experimental -- ADR-0068 shared-nothing structured
// concurrency, cooperative run-to-completion slice
// (docs/internal/design/concurrency.md): deferred spawn and a FIFO,
// deterministic scheduler. A blocking operation (join / send / recv / closing
// a task group) drives the ready queue on the caller's stack
// (thread-of-control borrowing). When continuations land (the ADR-0076
// Phase 3 suspend IR) the internals are replaced and the surface kept.
// `@vibe/concurrent` re-exports the stable subset of this contract.
//
// `r` (#1081 step 3): a generative region tag. `TaskGroup::run` mints a
// fresh, compiler-rigid region per call and rejects the call if the
// nursery's own `TaskGroup[rg]`/`TaskHandle[r,_]`/`Sender[r,_]`/
// `Receiver[r,_]` escapes via the body's RETURN VALUE. That is the ONLY
// return-escape guarantee today — do not rely on more than this:
//   - an outer `let mut` capture (e.g. stashing an endpoint into an array
//     bound before the nursery) is NOT caught: this checker generalizes
//     `let`/`let mut` bindings, so each reference inside the body gets an
//     independent, disconnected type instantiation the escape check cannot
//     see (confirmed by direct test, not assumed).
//   - `TaskGroup::spawn`/`::spawn_suspend` DO enforce `Spawnable[rg]`
//     (same-region-endpoint-or-Send capture checking) at every call whose
//     callee has spawn's shape -- a `TaskGroup` first and a closure last,
//     which `Parallel::map` shares -- whether it is spelled literally, as a
//     local `let` alias, a renamed import, or a wrapper (#3125). The closure
//     argument must be one whose captures can be seen: a literal, a local
//     `let` closure, a top-level function, or the closure parameter of an
//     enclosing spawn-shaped function (its callers are checked); anything
//     else is refused (#3152). Taking the function as any other value is
//     refused. `adopt` / `settle` are out of scope.
//   - the `run` check is selected the same way, by the callee's type
//     (`((TaskGroup[rg, e]) -> T) -> T`), so an alias, a renamed import and
//     a wrapper of that shape mint a fresh region too, and `run` taken as
//     any other value is refused (#3153).
// See the dated implementation notes in docs/internal/design/concurrency.md
// for the exact scope and the still-open gaps.
//
// Not implemented yet (later in ADR-0068's order): escape detection for an
// outer generalized `let` / `let mut` capture, a general `Region` bound (today
// `TaskGroup::run` / `::spawn` are recognized by their shape), `Spawnable` for
// `adopt` / `settle`, an `Async::suspend` row on the blocking API, observing a
// mid-run cancel, deep-copied messages (there is one heap -- send immutable
// values), and `Task::yield`. The task handle is spelled `TaskHandle` to stay
// clear of the builtin `Task::*` (the eager prototype due to be retired).

type TaskGroup[rg, e]
type TaskHandle[rg, e, T]
type TaskError
type SendError
type ChannelConfigError
type Channel[rg, e, T]
type Sender[rg, e, T]
type Receiver[rg, e, T]

// internal representation types (exported for same-package tests only;
// opaque with type params is not yet supported, #729)
opaque type TaskCell
type ResCell[T]
type Ring[T]

fn TaskGroup::run[T, rg, e](body: (TaskGroup[rg, e]) -> T with e) -> T with Exception[TaskError] + e
// #1181: spawned thunks may perform the enclosing TaskGroup's own `e`
// capability row alongside Error. `e` is threaded through TaskGroup[rg, e]
// (see concurrent.vibe's TaskGroup.runners field comment) rather than
// fixed, so a nursery that spawns nothing beyond `{ Error }` still
// requires no extra capability from its caller.
fn TaskGroup::spawn[rg, e, T: Send](n: TaskGroup[rg, e], f: () -> T with Exception + e) -> TaskHandle[rg, e, T]
fn TaskHandle::join[rg, e, T](h: TaskHandle[rg, e, T]) -> T with Exception[TaskError] + e
fn TaskHandle::cancel[rg, e, T](h: TaskHandle[rg, e, T]) -> Unit
fn Channel::bounded[rg, e, T: Send](n: TaskGroup[rg, e], capacity: Int) -> (Sender[rg, e, T], Receiver[rg, e, T]) with Exception[ChannelConfigError]
fn Sender::send[rg, e, T](s: Sender[rg, e, T], v: T) -> Unit with Exception[SendError] + e
fn Sender::clone[rg, e, T](s: Sender[rg, e, T]) -> Sender[rg, e, T]
fn Sender::release[rg, e, T](s: Sender[rg, e, T]) -> Unit
fn Receiver::recv[rg, e, T](rh: Receiver[rg, e, T]) -> Option[T] with e

// combinators (index-ordered results; completion order not observable)
type Parallel
fn Parallel::map[rg, e, T: Send, U: Send](n: TaskGroup[rg, e], xs: Array[T], f: (T) -> U with Exception + e) -> Array[U] with Exception[TaskError] + e

// --- suspendable tasks (ADR-0068 implementation note 3c; built on the
// first-class resume of ADR-0076 Phase 3a/3b). A task body runs inside the
// adoption site's `handle ... with Async`, whose arm stores `resume` in the
// task's continuation slot through TaskHandle::park; pump / wake run a stored
// continuation up to its next suspend. A transparent effect declaration
// (#752): the definition is the contract.
effect Async {
  Suspend(Int) -> Int
}

type TaskStep[T]

fn TaskGroup::adopt[rg, e, T: Send](n: TaskGroup[rg, e]) -> TaskHandle[rg, e, T]
// closure-CPS (ADR-0076 addendum 31, Vertical B): the handle site is inside
// the library, and the caller passes a plain closure body. An escaping
// Exception::Throw becomes `Failed` and fails fast (parked siblings are
// cancelled).
fn TaskGroup::spawn_suspend[rg, e, T: Send](n: TaskGroup[rg, e], f: () -> T with Async + Exception) -> TaskHandle[rg, e, T]
fn TaskGroup::pump[rg, e](n: TaskGroup[rg, e]) -> Bool
fn TaskGroup::pump_all[rg, e](n: TaskGroup[rg, e]) -> Unit
// blocking channel ops for suspendable tasks (suspend+retry; the
// stack-driving Sender::send / Receiver::recv stay unchanged)
fn Sender::send_wait[rg, e, T](s: Sender[rg, e, T], v: T) -> Unit with Exception[SendError] + Async
fn Receiver::recv_wait[rg, e, T](rh: Receiver[rg, e, T]) -> Option[T] with Async
fn TaskHandle::settle[rg, e, T](h: TaskHandle[rg, e, T], step: TaskStep[T]) -> Unit
fn TaskHandle::park[rg, e, T](h: TaskHandle[rg, e, T], k: (Int) -> TaskStep[T]) -> Unit
// park with an explicit wait kind: poll=true marks an external-condition
// wait (deadlock-trap eligible). Suspend payload convention: 0 = yield,
// 1 = poll wait (the blocking channel ops use 1).
fn TaskHandle::park_poll[rg, e, T](h: TaskHandle[rg, e, T], k: (Int) -> TaskStep[T], poll: Bool) -> Unit
fn TaskHandle::park_kind[rg, e, T](h: TaskHandle[rg, e, T], k: (Int) -> TaskStep[T], poll: Bool, sleep_ms: Int) -> Unit
// #1227: suspending sleep -- parks the task so siblings run, instead of
// blocking the whole instance the way the `sleep` builtin does.
fn sleep_wait(ms: Int) -> Unit with Async
fn TaskHandle::wake[rg, e, T](h: TaskHandle[rg, e, T], v: Int) -> Bool
// ADR-0089 D2 (#1218): suspendable-lane join -- a task handle IS a future;
// polls the sibling's terminal status, parking with Suspend(1) otherwise.
// Since the direct-wake slice the awaiter parks REGISTERED on the target
// cell and the pump skips it until the completion notify (semantics
// unchanged -- see concurrent.vibe's TaskCell.direct_wait).
fn TaskHandle::result_wait[rg, e, T](h: TaskHandle[rg, e, T]) -> T with Exception[TaskError] + Async

// --- builtin-future await hooks (ADR-0089 #1218, resolve -> direct wake).
// COMPILER-FACING, not user API: the linked-compile lane auto-links these
// whenever a program imports anything from a file exporting them, routes
// each `await` poll round through __aw_wait, and appends
// __aw_notify_resolve to every `Future::resolve` lowering. The `f`
// parameter is the builtin future's [state, payload] cell (typed here as
// its runtime shape, Array[Int]).
fn __aw_wait(f: Array[Int]) -> Int with Async
fn __aw_notify_resolve(f: Array[Int]) -> Unit
fn __aw_note(f: Array[Int]) -> Int
fn __conc_stream_claim(f: Array[Int]) -> Int

// --- host-waitable hooks (#1537). COMPILER-FACING, not user API: a task
// that awaits a host future parks on its handle, and the group waits on all
// pending handles at once through these. The bodies here mean "no host
// waitables"; linked_compile replaces them with the component adapter's
// calls exactly when the entry boundary settles host futures.
fn __conc_host_arm(waitable: Int) -> Int
fn __conc_host_cancel(waitable: Int) -> Int
fn __conc_host_sleep_arm(ms: Int) -> Int
fn __conc_host_sleep_cancel(timer: Int) -> Int
fn __conc_host_wait_any() -> Int
fn __conc_host_take(waitable: Int) -> Int
