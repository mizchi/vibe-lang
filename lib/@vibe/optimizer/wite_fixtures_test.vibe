test "wite: rume_gain_fixture.wasm has functions" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/rume_gain_fixture.wasm")
  assert(count_functions(bytes) > 0)
}

test "wite: zlib.wasm minify_fast matches strip_custom" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/zlib.wasm")
  let fast = minify_fast(bytes)
  let stripped = strip_custom_sections(bytes)
  // minify_fast should produce same result as strip_custom (+ remove empty)
  assert(binary_size(fast) <= binary_size(stripped))
}

test "wite: minify is deterministic" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  let opt1 = minify_fast(bytes)
  let opt2 = minify_fast(bytes)
  assert(binary_size(opt1) == binary_size(opt2))
}

test "wite: all fixtures valid magic" {
  let fixtures = [
    "lib/@vibe/optimizer/__fixtures/empty.wasm",
    "lib/@vibe/optimizer/__fixtures/br_to_exit.wasm",
    "lib/@vibe/optimizer/__fixtures/elided-br.wasm",
    "lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm",
    "lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm",
    "lib/@vibe/optimizer/__fixtures/rume_gain_fixture.wasm"
  ]
  let mut i = 0
  while i < Array::length(fixtures) {
    let bytes = Fs::read_bytes(Array::get(fixtures, i))
    assert(bytes[0] == 0)
    assert(bytes[1] == 97)
    assert(bytes[2] == 115)
    assert(bytes[3] == 109)
    assert(bytes[4] == 1)
    i = i + 1
  }
}

test "wite: all fixtures minify_fast valid output" {
  let fixtures = [
    "lib/@vibe/optimizer/__fixtures/empty.wasm",
    "lib/@vibe/optimizer/__fixtures/br_to_exit.wasm",
    "lib/@vibe/optimizer/__fixtures/elided-br.wasm",
    "lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm",
    "lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm",
    "lib/@vibe/optimizer/__fixtures/rume_gain_fixture.wasm"
  ]
  let mut i = 0
  while i < Array::length(fixtures) {
    let bytes = Fs::read_bytes(Array::get(fixtures, i))
    let opt = minify_fast(bytes)
    // Output must be valid WASM
    assert(opt[0] == 0)
    assert(opt[4] == 1)
    // Must not increase size
    assert(binary_size(opt) <= binary_size(bytes))
    i = i + 1
  }
}

test "wite: strip then dce on complexBinaryNames" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = dce(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}

test "wite: strip then dce on rume fixture" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/rume_gain_fixture.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = dce(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}

test "wite: strip then types on directize fixture" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = remove_unused_types(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}

test "directize: no-op on module without table" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/empty.wasm")
  let opt = directize(bytes)
  assert(binary_size(opt) == binary_size(bytes))
}

test "directize: directize_gain_fixture reduces" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm")
  let opt = directize(bytes)
  // directize should convert call_indirect to call, reducing size
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
  assert(opt[4] == 1)
}

test "directize: output valid wasm" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm")
  let opt = directize(bytes)
  assert(opt[0] == 0)
  assert(opt[1] == 97)
  assert(opt[2] == 115)
  assert(opt[3] == 109)
}

test "call_forwarding: no-op on simple module" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/empty.wasm")
  let opt = call_forwarding(bytes)
  assert(binary_size(opt) == binary_size(bytes))
}

test "call_forwarding: no-op on module without forwarders" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  let opt = call_forwarding(bytes)
  // May or may not reduce, but must be valid
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
}

test "directize + call_forwarding pipeline on directize fixture" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm")
  let s1 = directize(bytes)
  let s2 = call_forwarding(s1)
  assert(binary_size(s2) <= binary_size(bytes))
  assert(s2[0] == 0)
  assert(s2[4] == 1)
}

test "minify with directize reduces directize fixture" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/directize_gain_fixture.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) < binary_size(bytes))
  assert(opt[0] == 0)
}
