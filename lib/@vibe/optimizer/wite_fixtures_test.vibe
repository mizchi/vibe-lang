test "wite: complexBinaryNames.wasm strip custom" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  assert(binary_size(bytes) == 73)
  let stripped = strip_custom_sections(bytes)
  // Has custom sections that get stripped
  assert(binary_size(stripped) < 73)
  assert(stripped[0] == 0)
}

test "wite: complexBinaryNames.wasm minify_fast" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  let opt = minify_fast(bytes)
  // wite reduces to ~41 bytes (44% reduction)
  assert(binary_size(opt) < 73)
  assert(opt[0] == 0)
}

test "wite: complexBinaryNames.wasm minify" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/complexBinaryNames.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) < 73)
  assert(opt[0] == 0)
}

