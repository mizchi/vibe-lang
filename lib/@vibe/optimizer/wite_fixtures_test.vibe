//# Imports

import ./index.vibe {
  binary_size, call_forwarding, coalesce_locals, count_exports, count_functions, count_types, dce, directize, minify, minify_fast, optimize_code_section, remove_empty_sections, remove_unused_types, strip_custom_sections
}

//# Misc

test "wite: empty.wasm no change" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/empty.wasm")
  assert(binary_size(bytes) == 8)
  let opt = minify_fast(bytes)
  // Empty module: nothing to optimize
  assert(binary_size(opt) == 8)
}

test "wite: empty.wasm valid" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/empty.wasm")
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[4] == 1)
}

test "wite: br_to_exit.wasm reduces" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/br_to_exit.wasm")
  assert(binary_size(bytes) == 26)
  let opt = minify_fast(bytes)
  // wite reduces to 8 bytes (69% reduction)
  assert(binary_size(opt) <= 26)
  assert(opt[0] == 0)
  assert(opt[4] == 1)
}

test "wite: br_to_exit.wasm minify" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/br_to_exit.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
}

test "wite: elided-br.wasm reduces" {
  let bytes = Fs::read_bytes("lib/@vibe/optimizer/__fixtures/elided-br.wasm")
