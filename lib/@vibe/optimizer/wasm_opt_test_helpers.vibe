fn bytes_eq(x: Bytes, y: Bytes) -> Bool {
  if Bytes::length(x) != Bytes::length(y) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Bytes::length(x) {
      if x[i] != y[i] {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

