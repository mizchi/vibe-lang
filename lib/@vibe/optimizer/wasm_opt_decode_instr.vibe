// lib/@vibe/optimizer/wasm_opt.vibe — decode instr.

//# Functions

// Preserved from the old index.vibe facade (Codex review precedent, PR
// #914): this was a real importable binding, not just contract metadata.

export fn copy_bytes(src: Bytes, start: Int, end_pos: Int) -> Bytes {
  Bytes::slice(src, start, end_pos)
}

export fn binary_size(bytes: Bytes) -> Int {
  Bytes::length(bytes)
}

fn append_bytes(out: Bytes, src: Bytes) -> Unit {
  let mut i = 0
  while i < Bytes::length(src) {
    Bytes::push(out, src[i])
    i = i + 1
  }
}

fn is_i32_binop(op: Int) -> Bool {
  (op == 0x6A) || (op == 0x6B) || (op == 0x6C) || (op == 0x71) || (op == 0x72) || (op == 0x73)
}

/// i32.shl / i32.shr_s / i32.shr_u. Kept separate from is_i32_binop so callers
/// can ask for "binop" vs "shift" specifically; apply_i32_fold handles both
/// (with wasm's 32-bit shift-amount masking and wraparound).
fn is_i32_shift(op: Int) -> Bool {
  (op == 0x74) || (op == 0x75) || (op == 0x76)
}

/// Opcodes whose `i32.const a; i32.const b; OP` triple can be constant-folded.
/// div/rem are excluded: folding `x / 0` would silently drop a wasm trap.
fn is_i32_foldable(op: Int) -> Bool {
  is_i32_binop(op) || is_i32_shift(op)
}

/// i32 relational ops (eq/ne and signed/unsigned lt/gt/le/ge), 0x46..0x4F.
/// Folding `i32.const a; i32.const b; CMP` yields `i32.const 0|1`.
fn is_i32_cmp(op: Int) -> Bool {
  (op >= 0x46) && (op <= 0x4F)
}

/// i64 identity: `x OP <i64.const k>` collapses to `x` when (OP, k) is an
/// identity. Mirrors is_identity_op for the i64 opcodes: add/sub/or/xor/shl/
/// shr_s/shr_u with k == 0, and mul with k == 1. `and` is intentionally absent
/// (x & 0 == 0, not x). Pure elimination, no arithmetic computed.
fn is_i64_identity_op(op: Int, imm: Int) -> Bool {
  if (op == 0x7C) || (op == 0x7D) || (op == 0x84) || (op == 0x85) || (op == 0x86) || (op == 0x87) || (op == 0x88) {
    imm == 0
  }
  else {
    if op == 0x7E {
      imm == 1
    }
    else {
      false
    }
  }
}

export fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    shift = shift + 7
    i = i + 1
    if (byte&0x80) == 0 {
      if (byte&0x40) > 0 {
        result = result|((-1)<<shift)
      }
      done = true
    }
  }
  (result, i)
}

export fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    i = i + 1
    if (byte&0x80) == 0 {
      done = true
    }
    else {
      shift = shift + 7
    }
  }
  (result, i)
}

export fn read_name(bytes: Bytes, offset: Int) -> (String, Int) {
  let (name_len, pos) = read_uleb128(bytes, offset)
  // O(N) build via StringBuilder; per-char String::concat was O(L²) (issue #366).
  let s = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(s, String::from_char_code(bytes[pos + i]))
    i = i + 1
  }
  (StringBuilder::freeze(s), pos + name_len)
}

export fn minify_fast(bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    while i < len {
      let sec_id = bytes[i]
      let raw_start = i
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if (sec_id != 0) && (sec_size > 0) {
          let should_keep = if (sec_id >= 1) && (sec_id <= 11) && (sec_id != 8) {
            let (cnt, _) = read_uleb128(bytes, content_start)
            cnt > 0
          } else {
            true
          }
          if should_keep {
            let mut j = raw_start
            while j < sec_end {
              Bytes::push(out, bytes[j])
              j = j + 1
            }
          } else {
            ()
          }
        } else {
          ()
        }
        i = sec_end
      }
    }
    out
  }
}

export fn decode_instr(body: Bytes, pos: Int) -> (Int, Int, Int) {
  let op = body[pos]
  if op == 0x08 {
    // throw <tagidx>
    let (_, next) = read_uleb128(body, pos + 1)
    (op, 0, next)
  }
  else if op == 0xD2 {
    // ref.func <funcidx>
    let (val, next) = read_uleb128(body, pos + 1)
    (op, val, next)
  }
  else if op == 0xD0 {
    // ref.null <heaptype> (single sleb byte for func/extern, sleb for gc)
    let (_, next) = read_sleb128(body, pos + 1)
    (op, 0, next)
  }
  else if op == 0x1F {
    // try_table <blocktype> vec(catch): catch/catch_ref take tag+label,
    // catch_all/catch_all_ref take label only.
    let (_, p1) = read_sleb128(body, pos + 1)
    let (cnt, p2) = read_uleb128(body, p1)
    let mut pp = p2
    let mut ci = 0
    while ci < cnt {
      let kind = body[pp]
      pp = pp + 1
      if (kind == 0) || (kind == 1) {
        let (_, pa) = read_uleb128(body, pp)
        let (_, pb) = read_uleb128(body, pa)
        pp = pb
      } else {
        let (_, pa) = read_uleb128(body, pp)
        pp = pa
      }
      ci = ci + 1
    }
    (op, 0, pp)
  }
  else if op == 0x41 {
    let (val, next) = read_sleb128(body, pos + 1)
    (0x41, val, next)
  } else {
    if op == 0x42 {
      let (val, next) = read_sleb128(body, pos + 1)
      (0x42, val, next)
    } else {
      if op == 0x20 {
        let (val, next) = read_uleb128(body, pos + 1)
        (0x20, val, next)
      } else {
        if op == 0x21 {
          let (val, next) = read_uleb128(body, pos + 1)
          (0x21, val, next)
        } else {
          if op == 0x22 {
            let (val, next) = read_uleb128(body, pos + 1)
            (0x22, val, next)
          } else {
            if op == 0x23 {
              let (val, next) = read_uleb128(body, pos + 1)
              (0x23, val, next)
            } else {
              if op == 0x24 {
                let (val, next) = read_uleb128(body, pos + 1)
                (0x24, val, next)
              } else {
                if op == 0x10 {
                  let (val, next) = read_uleb128(body, pos + 1)
                  (0x10, val, next)
                } else {
                  if op == 0x0C {
                    let (val, next) = read_uleb128(body, pos + 1)
                    (0x0C, val, next)
                  } else {
                    if op == 0x0D {
                      let (val, next) = read_uleb128(body, pos + 1)
                      (0x0D, val, next)
                    } else {
                      if (op == 0x02) || (op == 0x03) || (op == 0x04) {
                        let (val, next) = read_sleb128(body, pos + 1)
                        (op, val, next)
                      } else {
                        if (op == 0x28) || (op == 0x29) || (op == 0x2A) || (op == 0x2B) ||
                        (op == 0x2C) || (op == 0x2D) || (op == 0x2E) || (op == 0x2F) ||
                        (op == 0x30) || (op == 0x31) || (op == 0x32) || (op == 0x33) ||
                        (op == 0x34) || (op == 0x35) ||
                        (op == 0x36) || (op == 0x37) || (op == 0x38) || (op == 0x39) ||
                        (op == 0x3A) || (op == 0x3B) || (op == 0x3C) || (op == 0x3D) || (op == 0x3E) {
                          let (_, p1) = read_uleb128(body, pos + 1)
                          let (_, next) = read_uleb128(body, p1)
                          (op, 0, next)
                        } else {
                          if op == 0x11 {
                            let (_, p1) = read_uleb128(body, pos + 1)
                            let (_, next) = read_uleb128(body, p1)
                            (op, 0, next)
                          } else {
                            if op == 0x0E {
                              let (cnt, p1) = read_uleb128(body, pos + 1)
                              let mut pp = p1
                              let mut bi = 0
                              while bi <= cnt {
                                let (_, np) = read_uleb128(body, pp)
                                pp = np
                                bi = bi + 1
                              }
                              (op, 0, pp)
                            } else {
                              if op == 0x43 {
                                // f32.const: 4 raw little-endian bytes. Without
                                // this (and 0x44 below) the span walk treats
                                // constant bytes as opcodes; a byte that looks
                                // like local.get/set/tee then gets "remapped"
                                // by inline_calls' +base rewrite, silently
                                // corrupting float constants (caught by
                                // scripts/minify_gate.sh on variant_float).
                                (op, 0, pos + 5)
                              } else if op == 0x44 {
                                // f64.const: 8 raw little-endian bytes.
                                (op, 0, pos + 9)
                              } else if (op == 0x3F) || (op == 0x40) {
                                (op, 0, pos + 2)
                              } else {
                                if op == 0xFC {
                                  let (sub_op, p1) = read_uleb128(body, pos + 1)
                                  if sub_op <= 7 {
                                    (op, 0, p1)
                                  } else if sub_op == 8 {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2 + 1)
                                  } else if sub_op == 9 {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2)
                                  } else if sub_op == 10 {
                                    (op, 0, p1 + 2)
                                  } else if sub_op == 11 {
                                    (op, 0, p1 + 1)
                                  } else if (sub_op == 12) || (sub_op == 14) {
                                    let (_, p2) = read_uleb128(body, p1)
                                    let (_, p3) = read_uleb128(body, p2)
                                    (op, 0, p3)
                                  } else {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2)
                                  }
                                } else {
                                  (op, 0, pos + 1)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

export fn list_sections(bytes: Bytes) -> Array[(Int, Int, Int)] {
  let len = Bytes::length(bytes)
  let result = Array::slice([(0, 0, 0)], 0, 0)
  if len < 8 {
    result
  }
  else {
    let mut i = 8
    while i < len {
      let sec_id = bytes[i]
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        Array::push(result, (sec_id, content_start, sec_size))
        i = sec_end
      }
    }
    result
  }
}

export fn count_types(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, _) = Array::get(sections, s)
    if sid == 1 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

export fn count_exports(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

export fn section_sizes(bytes: Bytes) -> Array[(Int, Int)] {
  let sections = list_sections(bytes)
  let result = Array::slice([(0, 0)], 0, 0)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, _, sz) = Array::get(sections, s)
    Array::push(result, (sid, sz))
    s = s + 1
  }
  result
}

export fn write_sleb128(buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val&0x7F
    val = val>>7
    if ((val == 0) && ((byte&0x40) == 0)) || ((val == (-1)) && ((byte&0x40) > 0)) {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|0x80)
    }
  }
}

export fn write_uleb128(buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val&0x7F
    val = (val>>7)&((1<<25) - 1)
    if val == 0 {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|0x80)
    }
  }
}

export fn emit_section(out: Bytes, sec_id: Int, content: Bytes) -> Unit {
  Bytes::push(out, sec_id)
  write_uleb128(out, Bytes::length(content))
  append_bytes(out, content)
}

fn is_identity_op(op: Int, imm: Int) -> Bool {
  if op == 0x6A {
    imm == 0
  }
  else {
    if op == 0x6B {
      imm == 0
    }
    else {
      if op == 0x6C {
        imm == 1
      }
      else {
        if op == 0x72 {
          imm == 0
        }
        else {
          if op == 0x73 {
            imm == 0
          }
          else {
            if (op == 0x74) || (op == 0x75) || (op == 0x76) {
              imm == 0
            }
            else {
              false
            }
          }
        }
      }
    }
  }
}

/// Normalize a 62-bit Int result to a signed wasm i32 (two's complement,
/// -2^31 .. 2^31-1) so constant folding matches wasm's wraparound semantics
/// instead of leaking out-of-range values into the rewritten i32.const.
fn wrap_i32(v: Int) -> Int {
  let m = v&0xFFFFFFFF
  if (m&0x80000000) != 0 {
    m - 4294967296
  }
  else {
    m
  }
}

fn apply_i32_fold(op: Int, a: Int, b: Int) -> Int {
  if op == 0x6A {
    wrap_i32(a + b)
  }
  else if op == 0x6B {
    wrap_i32(a - b)
  }
  else if op == 0x6C {
    wrap_i32(a * b)
  }
  else if op == 0x71 {
    wrap_i32(a&b)
  }
  else if op == 0x72 {
    wrap_i32(a|b)
  }
  else if op == 0x73 {
    wrap_i32(a^b)
  }
  else if op == 0x74 {
    wrap_i32(a<<(b&31))
  }
  else if op == 0x75 {
    // shr_s: arithmetic shift of the signed 32-bit value (vibe >> sign-extends)
    wrap_i32(wrap_i32(a)>>(b&31))
  }
  else {
    // shr_u (0x76): logical shift of the unsigned 32-bit value
    let ua = a&0xFFFFFFFF
    wrap_i32(ua>>(b&31))
  }
}

/// Evaluate an i32 relational op on two constants, returning 0 or 1. Signed
/// ops compare the sign-extended i32 values; unsigned ops compare the low
/// 32 bits as non-negative magnitudes.
fn apply_i32_cmp(op: Int, a: Int, b: Int) -> Int {
  let sa = wrap_i32(a)
  let sb = wrap_i32(b)
  let ua = a&0xFFFFFFFF
  let ub = b&0xFFFFFFFF
  if op == 0x46 {
    if sa == sb {
      1
    } else {
      0
    }
  }
  else if op == 0x47 {
    if sa != sb {
      1
    } else {
      0
    }
  }
  else if op == 0x48 {
    if sa < sb {
      1
    } else {
      0
    }
  }
  else if op == 0x49 {
    if ua < ub {
      1
    } else {
      0
    }
  }
  else if op == 0x4A {
    if sa > sb {
      1
    } else {
      0
    }
  }
  else if op == 0x4B {
    if ua > ub {
      1
    } else {
      0
    }
  }
  else if op == 0x4C {
    if sa <= sb {
      1
    } else {
      0
    }
  }
  else if op == 0x4D {
    if ua <= ub {
      1
    } else {
      0
    }
  }
  else if op == 0x4E {
    if sa >= sb {
      1
    } else {
      0
    }
  }
  else {
    if ua >= ub {
      1
    } else {
      0
    }
  }
}

export fn copy_span_bytes(out: Bytes, body: Bytes, start: Int, end_pos: Int) -> Unit {
  let mut k = start
  while k < end_pos {
    Bytes::push(out, body[k])
    k = k + 1
  }
}

export fn count_functions(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut defined_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            pos = end_pos
          }
        }
        i = i + 1
      }
    } else {
      if sid == 3 {
        let (cnt, _) = read_uleb128(bytes, off)
        defined_funcs = cnt
      }
    }
    s = s + 1
  }
  import_funcs + defined_funcs
}

export fn parse_body_spans(body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int, Int)] {
  let spans = Array::slice([(0, 0, 0)], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, _, next) = decode_instr(body, pos)
    Array::push(spans, (pos, next, op))
    pos = next
  }
  spans
}

export fn is_table_exported(bytes: Bytes) -> Bool {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut found = false
  while (s < Array::length(sections)) && (found == false) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (_, np) = read_name(bytes, pos)
        pos = np
        if pos < end_pos {
          let kind = bytes[pos]
          pos = pos + 1
          let (_, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 1 {
            found = true
          }
          else {
            ()
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  found
}

fn parse_body_instrs(body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int)] {
  let instrs = Array::slice([(0, 0)], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, imm, next) = decode_instr(body, pos)
    Array::push(instrs, (op, imm))
    pos = next
  }
  instrs
}

export fn parse_code_bodies(bytes: Bytes, offset: Int, size: Int) -> Array[Bytes] {
  let end_pos = offset + size
  let (func_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let result = Array::slice([(Bytes::new())], 0, 0)
  let mut fi = 0
  while (fi < func_count) && (pos < end_pos) {
    let (body_size, bp) = read_uleb128(bytes, pos)
    Array::push(result, copy_bytes(bytes, bp, bp + body_size))
    pos = bp + body_size
    fi = fi + 1
  }
  result
}

export fn array_contains_int(arr: Array[Int], target: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target {
      found = true
    }
    i = i + 1
  }
  found
}

fn array_contains_str(arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target {
      found = true
    }
    i = i + 1
  }
  found
}

fn rewrite_exports(bytes: Bytes, offset: Int, size: Int, keep_names: Array[String]) -> Bytes {
  let end_pos = offset + size
  let kept = Array::slice([("", 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      let (index, np2) = read_uleb128(bytes, pos)
      pos = np2
      if array_contains_str(keep_names, name) {
        Array::push(kept, (name, kind, index))
      }
    }
    i = i + 1
  }
  let out = Bytes::new()
  write_uleb128(out, Array::length(kept))
  let mut k = 0
  while k < Array::length(kept) {
    let (name, kind, index) = Array::get(kept, k)
    write_uleb128(out, String::length(name))
    let mut ci = 0
    while ci < String::length(name) {
      Bytes::push(out, String::char_code_at(name, ci))
      ci = ci + 1
    }
    Bytes::push(out, kind)
    write_uleb128(out, index)
    k = k + 1
  }
  out
}

export fn filter_exports(bytes: Bytes, keep_names: Array[String]) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 7 {
        let new_content = rewrite_exports(bytes, off, sz, keep_names)
        emit_section(out, 7, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

export fn count_import_funcs(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            if kind == 1 {
              let (_, np) = read_uleb128(bytes, pos); pos = np
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  pos = pos + 2
                } else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  import_funcs
}

export fn build_call_graph(bytes: Bytes) -> Array[(Int, Array[Int])] {
  let result = Array::slice([(0, Array::slice([(0)], 0, 0))], 0, 0)
  let import_count = count_import_funcs(bytes)
  let total_funcs = count_functions(bytes)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 10 {
      let end_pos = off + sz
      let (func_count, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut fi = 0
      while (fi < func_count) && (pos < end_pos) {
        let func_idx = import_count + fi
        let (body_size, bp) = read_uleb128(bytes, pos)
        let body_end = bp + body_size
        let callees = Array::slice([(0)], 0, 0)
        let callee_seen = FixedArray::make(total_funcs + 1, 0)
        let body = copy_bytes(bytes, bp, body_end)
        let body_len = Bytes::length(body)
        let mut bpos = 0
        let (local_count, lp) = read_uleb128(body, 0)
        bpos = lp
        let mut lc = 0
        while lc < local_count {
          let (_, tp) = read_uleb128(body, bpos)
          bpos = tp + 1
          lc = lc + 1
        }
        while bpos < body_len {
          let (op, imm, next) = decode_instr(body, bpos)
          if op == 0x10 {
            if (imm >= 0) && (imm <= total_funcs) {
              if FixedArray::get(callee_seen, imm) == 0 {
                FixedArray::set(callee_seen, imm, 1)
                Array::push(callees, imm)
              }
            } else {
              if array_contains_int(callees, imm) == false {
                Array::push(callees, imm)
              }
            }
          }
          bpos = next
        }
        Array::push(result, (func_idx, callees))
        pos = body_end
        fi = fi + 1
      }
    }
    s = s + 1
  }
  result
}

export fn count_local_tables(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut count = 0
  while s < Array::length(sections) {
    let (sid, off, _) = Array::get(sections, s)
    if sid == 4 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

fn expand_local_count(local_types: Array[(Int, Int)]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(local_types) {
    let (cnt, _) = Array::get(local_types, i)
    total = total + cnt
    i = i + 1
  }
  total
}

export fn remap_func_section(bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (tidx, np) = read_uleb128(bytes, pos)
    let new_tidx = if tidx < Array::length(type_map) {
      Array::get(type_map, tidx)
    } else {
      tidx
    }
    write_uleb128(out, new_tidx)
    pos = np
    i = i + 1
  }
  out
}

fn span_read_sleb_imm(body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_sleb128(body, span_start + 1)
  val
}

fn directize_body(body: Bytes, slot_to_func: Array[Int], max_slot: Int, func_type_by_idx: Array[Int]) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let n = Array::length(spans)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < n {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if (i + 1) < n {
          let (s_next, e_next, op_next) = Array::get(spans, i + 1)
          if (op_i == 0x41) && (op_next == 0x11) {
            let slot = span_read_sleb_imm(body, s_i)
            let (type_idx, p1) = read_uleb128(body, s_next + 1)
            let (table_idx, _) = read_uleb128(body, p1)
            if (table_idx == 0) && (slot >= 0) && (slot <= max_slot) {
              let target = Array::get(slot_to_func, slot)
              if target >= 0 {
                let type_matches = if target < Array::length(func_type_by_idx) {
                  Array::get(func_type_by_idx, target) == type_idx
                } else {
                  false
                }
                if type_matches {
                  Bytes::push(out, 0x10)
                  write_uleb128(out, target)
                  i = i + 2
                } else {
                  copy_span_bytes(out, body, s_i, e_i)
                  i = i + 1
                }
              } else {
                copy_span_bytes(out, body, s_i, e_i)
                i = i + 1
              }
            } else {
              copy_span_bytes(out, body, s_i, e_i)
              i = i + 1
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 1
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
          i = i + 1
        }
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

export fn span_read_uleb_imm(body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_uleb128(body, span_start + 1)
  val
}

fn coalesce_body(body: Bytes, param_count: Int) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_decl_count, lp) = read_uleb128(body, 0)
    pos = lp
    let local_types = Array::slice([(0, 0)], 0, 0)
    let mut lc = 0
    while lc < local_decl_count {
      let (cnt, tp) = read_uleb128(body, pos)
      let ltype = body[tp]
      Array::push(local_types, (cnt, ltype))
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    let total_locals = param_count + expand_local_count(local_types)
    let local_type_arr = Array::slice([(0)], 0, 0)
    let mut li = 0
    while li < param_count {
      Array::push(local_type_arr, (-1))
      li = li + 1
    }
    let mut di = 0
    while di < Array::length(local_types) {
      let (cnt, ltype) = Array::get(local_types, di)
      let mut ci = 0
      while ci < cnt {
        Array::push(local_type_arr, ltype)
        ci = ci + 1
      }
      di = di + 1
    }
    let used_flags = FixedArray::make(total_locals + 1, 0)
    let mut pi = 0
    while pi < param_count {
      FixedArray::set(used_flags, pi, 1)
      pi = pi + 1
    }
    if code_start < code_end {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let mut ii = 0
      while ii < Array::length(instrs) {
        let (op, imm) = Array::get(instrs, ii)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          if (imm >= 0) && (imm < total_locals) {
            FixedArray::set(used_flags, imm, 1)
          } else {
            ()
          }
        } else {
          ()
        }
        ii = ii + 1
      }
    } else {
      ()
    }
    let index_map = Array::slice([(0)], 0, 0)
    let mut new_idx = 0
    let mut oi = 0
    while oi < total_locals {
      if FixedArray::get(used_flags, oi) == 1 {
        Array::push(index_map, new_idx)
        new_idx = new_idx + 1
      } else {
        Array::push(index_map, (-1))
      }
      oi = oi + 1
    }
    let new_local_entries = Array::slice([(0, 0)], 0, 0)
    let mut nli = param_count
    while nli < total_locals {
      if FixedArray::get(used_flags, nli) == 1 {
        let ltype = Array::get(local_type_arr, nli)
        let nle_len = Array::length(new_local_entries)
        if nle_len > 0 {
          let (prev_cnt, prev_type) = Array::get(new_local_entries, nle_len - 1)
          if prev_type == ltype {
            Array::set(new_local_entries, nle_len - 1, (prev_cnt + 1, prev_type))
          } else {
            Array::push(new_local_entries, (1, ltype))
          }
        } else {
          Array::push(new_local_entries, (1, ltype))
        }
      } else {
        ()
      }
      nli = nli + 1
    }
    let out = Bytes::new()
    write_uleb128(out, Array::length(new_local_entries))
    let mut ei = 0
    while ei < Array::length(new_local_entries) {
      let (cnt, ltype) = Array::get(new_local_entries, ei)
      write_uleb128(out, cnt)
      Bytes::push(out, ltype)
      ei = ei + 1
    }
    if code_start < code_end {
      let spans = parse_body_spans(body, code_start, code_end)
      let mut si = 0
      while si < Array::length(spans) {
        let (s_start, s_end, op) = Array::get(spans, si)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          let imm = span_read_uleb_imm(body, s_start)
          let new_imm = if imm < Array::length(index_map) {
            Array::get(index_map, imm)
          } else {
            imm
          }
          Bytes::push(out, op)
          write_uleb128(out, new_imm)
        } else {
          copy_span_bytes(out, body, s_start, s_end)
        }
        si = si + 1
      }
    } else {
      ()
    }
    Bytes::push(out, 0x0B)
    out
  }
}

fn peephole_try2(out: Bytes, body: Bytes, spans: Array[(Int, Int, Int)], i: Int, n: Int) -> Bool {
  if (i + 1) >= n {
    false
  }
  else {
    let (s_i, _, op_i) = Array::get(spans, i)
    let (s_next, _, op_next) = Array::get(spans, i + 1)
    if (op_i == 0x21) && (op_next == 0x20) {
      let imm_i = span_read_uleb_imm(body, s_i)
      let imm_next = span_read_uleb_imm(body, s_next)
      if imm_i == imm_next {
        Bytes::push(out, 0x22)
        write_uleb128(out, imm_i)
        true
      } else {
        false
      }
    } else {
      if (op_i == 0x41) && (op_next == 0x0D) {
        let imm_i = span_read_sleb_imm(body, s_i)
        if imm_i == 0 {
          true
        }
        else {
          false
        }
      } else {
        if (op_i == 0x41) && (op_next == 0x45) {
          // i32.const c; i32.eqz  ->  i32.const (c == 0 ? 1 : 0)
          let c = span_read_sleb_imm(body, s_i)
          Bytes::push(out, 0x41)
          write_sleb128(out, if wrap_i32(c) == 0 {
            1
          } else {
            0
          })
          true
        }
        else if (op_i == 0x45) && (op_next == 0x45) {
          true
        }
        else if (op_i == 0x22) && (op_next == 0x1A) {
          // local.tee N; drop  ->  local.set N (the tee's pushed value is dropped)
          let idx = span_read_uleb_imm(body, s_i)
          Bytes::push(out, 0x21)
          write_uleb128(out, idx)
          true
        }
        else if ((op_i == 0x41) || (op_i == 0x20)) && (op_next == 0x1A) {
          true
        }
        else {
          false
        }
      }
    }
  }
}

fn peephole_spans(body: Bytes, spans: Array[(Int, Int, Int)]) -> (Bytes, Bool) {
  let n = Array::length(spans)
  let out = Bytes::new()
  let mut changed = false
  let mut i = 0
  while i < n {
    let (s_i, e_i, op_i) = Array::get(spans, i)
    if op_i == 0x01 {
      // nop: drop it (always a no-op)
      i = i + 1
      changed = true
    }
    else if (i + 2) < n {
      let (s_j, _, op_j) = Array::get(spans, i + 1)
      let (_, _, op_k) = Array::get(spans, i + 2)
      if (op_i == 0x41) && (op_j == 0x41) && (is_i32_foldable(op_k) || is_i32_cmp(op_k)) {
        let imm_i = span_read_sleb_imm(body, s_i)
        let imm_j = span_read_sleb_imm(body, s_j)
        let folded = if is_i32_cmp(op_k) {
          apply_i32_cmp(op_k, imm_i, imm_j)
        } else {
          apply_i32_fold(op_k, imm_i, imm_j)
        }
        Bytes::push(out, 0x41)
        write_sleb128(out, folded)
        i = i + 3
        changed = true
      } else {
        let is_i32_id = (op_j == 0x41) && (is_i32_binop(op_k) || is_i32_shift(op_k)) && is_identity_op(op_k, span_read_sleb_imm(body, s_j))
        let is_i64_id = (op_j == 0x42) && is_i64_identity_op(op_k, span_read_sleb_imm(body, s_j))
        if is_i32_id || is_i64_id {
          copy_span_bytes(out, body, s_i, e_i)
          i = i + 3
          changed = true
        } else {
          let matched2 = peephole_try2(out, body, spans, i, n)
          if matched2 {
            i = i + 2
            changed = true
          } else {
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 1
          }
        }
      }
    } else {
      let matched2 = peephole_try2(out, body, spans, i, n)
      if matched2 {
        i = i + 2
        changed = true
      } else {
        copy_span_bytes(out, body, s_i, e_i)
        i = i + 1
      }
    }
  }
  (out, changed)
}

export fn peephole_body(body: Bytes) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    } else {
      let mut current_body = body
      let mut current_start = code_start
      let mut current_end = code_end
      let mut keep_going = true
      let mut pass_count = 0
      while keep_going && (pass_count < 3) {
        pass_count = pass_count + 1
        let spans = parse_body_spans(current_body, current_start, current_end)
        let (optimized_code, did_change) = peephole_spans(current_body, spans)
        if did_change {
          let new_body = Bytes::new()
          let mut ci = 0
          while ci < current_start {
            Bytes::push(new_body, current_body[ci])
            ci = ci + 1
          }
          let opt_len = Bytes::length(optimized_code)
          let mut oi = 0
          while oi < opt_len {
            Bytes::push(new_body, optimized_code[oi])
            oi = oi + 1
          }
          Bytes::push(new_body, 0x0B)
          current_body = new_body
          current_end = Bytes::length(new_body) - 1
        } else {
          keep_going = false
        }
      }
      current_body
    }
  }
}

export fn rewrite_body_calls(body: Bytes, fwd_lookup: Array[Int], max_func: Int, remap_reffunc: Bool) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let n = Array::length(spans)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < n {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if op_i == 0x10 {
          let target = span_read_uleb_imm(body, s_i)
          if (target >= 0) && (target <= max_func) {
            let new_target = Array::get(fwd_lookup, target)
            if new_target >= 0 {
              Bytes::push(out, 0x10)
              write_uleb128(out, new_target)
            } else {
              copy_span_bytes(out, body, s_i, e_i)
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
          }
        } else if remap_reffunc && (op_i == 0xD2) {
          let target = span_read_uleb_imm(body, s_i)
          if (target >= 0) && (target <= max_func) {
            let new_target = Array::get(fwd_lookup, target)
            if new_target >= 0 {
              Bytes::push(out, 0xD2)
              write_uleb128(out, new_target)
            } else {
              copy_span_bytes(out, body, s_i, e_i)
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
        }
        i = i + 1
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

export fn detect_forward_call(body: Bytes, param_count: Int) -> Int {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    (-1)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      (-1)
    }
    else {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let n = Array::length(instrs)
      let call_pos = if (n >= 2) && (n >= (param_count + 1)) {
        let (last_op, _) = Array::get(instrs, n - 1)
        if last_op == 0x0F {
          n - 2
        } else {
          n - 1
        }
      } else {
        (-1)
      }
      if call_pos < param_count {
        (-1)
      }
      else {
        if call_pos != param_count {
          (-1)
        }
        else {
          let (call_op, call_target) = Array::get(instrs, call_pos)
          if call_op != 0x10 {
            (-1)
          }
          else {
            let mut ok = true
            let mut gi = 0
            while (gi < param_count) && ok {
              let (op, imm) = Array::get(instrs, gi)
              if (op != 0x20) || (imm != gi) {
                ok = false
              }
              gi = gi + 1
            }
            if ok {
              call_target
            }
            else {
              (-1)
            }
          }
        }
      }
    }
  }
}

export fn strip_named_section(bytes: Bytes, name: String) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      let mut keep = true
      if sid == 0 {
        let (sec_name, _) = read_name(bytes, off)
        if sec_name == name {
          keep = false
        }
      }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

fn filter_data_segments(bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let end_pos = offset + size
  let segments = Array::slice([(0, 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let seg_start = pos
    let mode = bytes[pos]
    pos = pos + 1
    if mode == 0 {
      while (pos < end_pos) && (bytes[pos] != 0x0B) {
        pos = pos + 1
      }
      if pos < end_pos {
        pos = pos + 1
      }
      let (data_len, dp) = read_uleb128(bytes, pos)
      pos = dp + data_len
      Array::push(segments, (seg_start, pos, data_len))
    } else {
      if mode == 1 {
        let (data_len, dp) = read_uleb128(bytes, pos)
        pos = dp + data_len
        Array::push(segments, (seg_start, pos, data_len))
      } else {
        pos = end_pos
      }
    }
    i = i + 1
  }
  let out = Bytes::new()
  let mut kept_count = 0
  let mut si = 0
  while si < Array::length(segments) {
    let (_, _, data_len) = Array::get(segments, si)
    if data_len > 0 {
      kept_count = kept_count + 1
    }
    si = si + 1
  }
  write_uleb128(out, kept_count)
  si = 0
  while si < Array::length(segments) {
    let (seg_start, seg_end, data_len) = Array::get(segments, si)
    if data_len > 0 {
      let mut j = seg_start
      while j < seg_end {
        Bytes::push(out, bytes[j]); j = j + 1
      }
    }
    si = si + 1
  }
  out
}

export fn strip_empty_data(bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if (sid == 11) && (sz > 0) {
        let new_content = filter_data_segments(bytes, off, sz)
        if Bytes::length(new_content) > 1 {
          emit_section(out, 11, new_content)
        }
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

export fn get_type_param_count(bytes: Bytes, type_sec_off: Int, type_sec_sz: Int, type_idx: Int) -> Int {
  let end_pos = type_sec_off + type_sec_sz
  let (type_count, pos0) = read_uleb128(bytes, type_sec_off)
  let mut pos = pos0
  let mut ti = 0
  let mut result = 0
  while (ti < type_count) && (pos < end_pos) {
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if ti == type_idx {
      result = param_count
    }
    else {
      ()
    }
    ti = ti + 1
  }
  result
}

export fn get_func_param_count(bytes: Bytes, func_idx: Int, func_type_by_idx: Array[Int]) -> Int {
  if func_idx >= Array::length(func_type_by_idx) {
    (-1)
  }
  else {
    let type_idx = Array::get(func_type_by_idx, func_idx)
    let sections = list_sections(bytes)
    let mut s = 0
    let mut result = (-1)
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 1 {
        result = get_type_param_count(bytes, off, sz, type_idx)
      }
      s = s + 1
    }
    result
  }
}

export fn rebuild_code_section(bodies: Array[Bytes]) -> Bytes {
  let out = Bytes::new()
  write_uleb128(out, Array::length(bodies))
  let mut bi = 0
  while bi < Array::length(bodies) {
    let body = Array::get(bodies, bi)
    write_uleb128(out, Bytes::length(body))
    append_bytes(out, body)
    bi = bi + 1
  }
  out
}

export fn remap_import_section(bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (mlen, mp) = read_uleb128(bytes, pos)
    write_uleb128(out, mlen)
    let mut mi = 0
    while mi < mlen {
      Bytes::push(out, bytes[mp + mi]); mi = mi + 1
    }
    pos = mp + mlen
    let (flen, fp) = read_uleb128(bytes, pos)
    write_uleb128(out, flen)
    let mut fi2 = 0
    while fi2 < flen {
      Bytes::push(out, bytes[fp + fi2]); fi2 = fi2 + 1
    }
    pos = fp + flen
    if pos < end_pos {
      let kind = bytes[pos]; pos = pos + 1
      Bytes::push(out, kind)
      if kind == 0 {
        let (tidx, np) = read_uleb128(bytes, pos); pos = np
        let new_tidx = if tidx < Array::length(type_map) {
          Array::get(type_map, tidx)
        } else {
          tidx
        }
        write_uleb128(out, new_tidx)
      } else {
        if kind == 1 {
          let (reftype, np) = read_uleb128(bytes, pos); pos = np
          write_uleb128(out, reftype)
          let flag = bytes[pos]; pos = pos + 1
          Bytes::push(out, flag)
          let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
          write_uleb128(out, lim_min)
          if flag == 1 {
            let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
            write_uleb128(out, lim_max)
          } else {
            ()
          }
        } else {
          if kind == 2 {
            let flag = bytes[pos]; pos = pos + 1
            Bytes::push(out, flag)
            let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
            write_uleb128(out, lim_min)
            if flag == 1 {
              let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
              write_uleb128(out, lim_max)
            } else {
              ()
            }
          } else {
            if kind == 3 {
              Bytes::push(out, bytes[pos])
              Bytes::push(out, bytes[pos + 1])
              pos = pos + 2
            } else {
              pos = end_pos
            }
          }
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

export fn rewrite_type_section(bytes: Bytes, offset: Int, size: Int, used: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (type_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let entries = Array::slice([(0, Bytes::new())], 0, 0)
  let mut ti = 0
  while (ti < type_count) && (pos < end_pos) {
    let entry_start = pos
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if array_contains_int(used, ti) {
      let entry = copy_bytes(bytes, entry_start, pos)
      Array::push(entries, (ti, entry))
    } else {
      ()
    }
    ti = ti + 1
  }
  let out = Bytes::new()
  write_uleb128(out, Array::length(entries))
  let mut ei = 0
  while ei < Array::length(entries) {
    let (_, entry) = Array::get(entries, ei)
    append_bytes(out, entry)
    ei = ei + 1
  }
  out
}

export fn coalesce_code_section(bytes: Bytes, offset: Int, size: Int, type_sec_off: Int, type_sec_sz: Int, func_type_indices: Array[Int]) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([(Bytes::new())], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    let body = Array::get(raw_bodies, fi)
    let param_count = if fi < Array::length(func_type_indices) {
      let tidx = Array::get(func_type_indices, fi)
      get_type_param_count(bytes, type_sec_off, type_sec_sz, tidx)
    } else {
      0
    }
    Array::push(optimized, coalesce_body(body, param_count))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

export fn count_imported_tables(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut count = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
          } else {
            if kind == 1 {
              count = count + 1
              pos = pos + 1
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  pos = pos + 2
                }
                else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  count
}

export fn remove_empty_sections(bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      let mut keep = true
      if (sid >= 1) && (sid <= 12) && (sid != 5) && (sid != 8) {
        if sz > 0 {
          let (cnt, _) = read_uleb128(bytes, off)
          if cnt == 0 {
            keep = false
          } else {
            ()
          }
        } else {
          keep = false
        }
      } else {
        ()
      }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      } else {
        ()
      }
      si = si + 1
    }
    out
  }
}

export fn strip_custom_sections(bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    while i < len {
      let sec_id = bytes[i]
      let raw_start = i
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id != 0 {
          let mut j = raw_start
          while j < sec_end {
            Bytes::push(out, bytes[j])
            j = j + 1
          }
        } else {
          ()
        }
        i = sec_end
      }
    }
    out
  }
}

export fn directize_code_section(bytes: Bytes, offset: Int, size: Int, slot_to_func: Array[Int], max_slot: Int, func_type_by_idx: Array[Int]) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([(Bytes::new())], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    Array::push(optimized, directize_body(Array::get(raw_bodies, fi), slot_to_func, max_slot, func_type_by_idx))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

export fn get_export_func_indices(bytes: Bytes) -> Array[Int] {
  let result = Array::slice([(0)], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (_, np) = read_name(bytes, pos)
        pos = np
        if pos < end_pos {
          let kind = bytes[pos]
          pos = pos + 1
          let (index, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 0 {
            Array::push(result, index)
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  result
}
