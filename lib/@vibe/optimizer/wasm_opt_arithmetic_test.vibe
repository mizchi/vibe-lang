    1,
    8,
    1,
    1,
    127,
    65,
    5,
    33,
    0,
    11
  ])
  let expected = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    96,
    0,
    0,
    3,
    2,
    1,
    0,
    7,
    5,
    1,
    1,
    102,
    0,
    0,
    10,
    9,
    1,
    7,
    1,
    1,
    127,
    65,
    5,
    26,
    11
  ])
  assert(bytes_eq(eliminate_dead_stores(input), expected))
}

