name = @vibe/optimizer
version = 0.0.1
description =
  #|@vibe/optimizer — wasm-binary-level peephole/DCE/minify passes run over
deps = {}

generated_hash =

// @vibe/optimizer — wasm-binary-level peephole/DCE/minify passes run over
// the compiler's own codegen output (ADR-0070 Phase 3, #897). Every declared
// name is a pure `Bytes -> Bytes` (or `Bytes -> Int` / `Bytes -> Array[...]`)
// transform over a raw wasm module; no opaque/transparent type surface (the
// pass pipeline only ever moves `Bytes` and primitives/tuples/arrays of
// primitives around, never a struct/enum of its own). `version` was
// `export let version = "0.0.1"` directly in the old index.vibe facade — a
// real importable binding, not just contract metadata — so it is preserved
// verbatim as an implementation-file value (wasm_opt.vibe) with a matching
// bodyless declaration here (Codex review precedent, PR #914).
//
// bench.vibe (no `export` of its own — just `bench "..." { ... }` blocks
// over private helper fns) and the four `*_test.vibe` siblings all used to
// pull the pass functions in via a literal-filename `import ./index.vibe
// {...}` of this package's own facade (same trap as PR #916/#917's
// cross-package case, just intra-package here): once index.vibe is replaced
// by this index.vpkg that exact filename stops resolving, so all five were
// retargeted to `import ./wasm_opt.vibe {...}` (the impl file that actually
// defines every one of the names they import) — no behavior change, just
// pointing the literal import at the file that still exists.
//
// bench.vibe was ALSO renamed to optimizer_bench.vibe (Codex review
// precedent, #912/PR #913): a bare `bench.vibe` isn't excluded by implicit
// membership's `_bench.vibe`-suffix rule, so it would otherwise ride along
// as a real package member on every @vibe/optimizer import (harmless here
// since it exports nothing, but wasteful and inconsistent with the
// established convention).

fn binary_size(bytes: Bytes) -> Int
fn minify_fast(bytes: Bytes) -> Bytes
fn count_types(bytes: Bytes) -> Int
fn count_exports(bytes: Bytes) -> Int
fn section_sizes(bytes: Bytes) -> Array[(Int, Int)]
fn count_functions(bytes: Bytes) -> Int
fn filter_exports(bytes: Bytes, keep_names: Array[String]) -> Bytes
fn build_call_graph(bytes: Bytes) -> Array[(Int, Array[Int])]
fn strip_named_section(bytes: Bytes, name: String) -> Bytes
fn strip_empty_data(bytes: Bytes) -> Bytes
fn remove_empty_sections(bytes: Bytes) -> Bytes
fn strip_custom_sections(bytes: Bytes) -> Bytes
fn find_reachable(bytes: Bytes) -> Array[Int]
fn dce(bytes: Bytes) -> Bytes
fn dce_remove(bytes: Bytes) -> Bytes
fn coalesce_locals(bytes: Bytes) -> Bytes
fn directize(bytes: Bytes) -> Bytes
fn call_forwarding(bytes: Bytes) -> Bytes
fn remove_unused_types(bytes: Bytes) -> Bytes
fn optimize_code_section(bytes: Bytes) -> Bytes
fn remove_dead_blocks(bytes: Bytes) -> Bytes
fn inline_empty_calls(bytes: Bytes) -> Bytes
fn fold_table_size(bytes: Bytes) -> Bytes
fn drop_unused_tables(bytes: Bytes) -> Bytes
fn eliminate_dead_stores(bytes: Bytes) -> Bytes
fn inline_calls(bytes: Bytes) -> Bytes
fn drop_unused_tags(bytes: Bytes) -> Bytes
fn drop_unused_globals(bytes: Bytes) -> Bytes
fn propagate_local_copies(bytes: Bytes) -> Bytes
fn minify(bytes: Bytes) -> Bytes
fn optimize(bytes: Bytes) -> Bytes
fn minify_converge(bytes: Bytes) -> Bytes
