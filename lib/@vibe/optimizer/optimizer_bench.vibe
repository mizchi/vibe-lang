}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

fn small_fold() -> Bytes {
  make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    5,
    1,
    96,
    0,
    1,
    127,
