}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

fn minimal_module() -> Bytes {
  make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    5,
    1,
    96,
    0,
    1,
    127,
    3,
    2,
    1,
    0,
    7,
    8,
    1,
    4,
    109,
    97,
    105,
    110,
    0,
    0,
    10,
    6,
    1,
    4,
    0,
    65,
    42,
    11
  ])
}

