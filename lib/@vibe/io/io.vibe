//# Functions

export fn read(max_bytes: Int) -> String with { Stdin } {
  Stdin::read_stream(max_bytes)
}

export fn print(s: String) -> Unit with { Stdout } {
  Stdout::write_stream(s)
}

export fn println(s: String) -> Unit with { Stdout } {
  {
    Stdout::write_stream(s)
    Stdout::write_char(10)
  }
}

export fn read_char() -> Int with { Stdin } {
  Stdin::read_char()
}

export fn read_line() -> String with { Stdin } {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = Stdin::read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else "\{acc}\{String::from_char_code(c)}"
    }
    acc
  }
}

// Read up to `n` bytes from the input stream, returning whatever is available
// in a single bounded pull (a short read while the stream is open is returned
// as-is; "" signals EOF). This is the "pull a chunk" primitive a stream.read
// loop / Stream::next uses: `Stdin::read_stream` issues ONE
// input-stream.blocking-read with len=n rather than n single-byte reads, so it
// preserves short reads and avoids per-byte host-call overhead
// (docs/spec/wasi-p3-async.md §3.3). The stream cursor advances, so repeated
// calls read successive chunks. `n <= 0` yields "".
export fn read_n(n: Int) -> String with { Stdin } {
  Stdin::read_stream(n)
}

// Drain the input stream to EOF and return the whole body as a String — the
// "read the entire request body" primitive a WASI HTTP handler needs. Pulls
// bounded chunks via read_n until EOF ("") and accumulates into a StringBuilder
// (frozen once), so large bodies cost O(n) and a bounded number of host calls.
export fn read_all() -> String with { Stdin } {
  {
    let sb = StringBuilder::new()
    let mut done = false
    while not(done) {
      let chunk = read_n(65536)
      if String::length(chunk) == 0 {
        done = true
      } else {
        StringBuilder::push(sb, chunk)
      }
    }
    StringBuilder::freeze(sb)
  }
}

export fn write_char(code: Int) -> Unit with { Stdout } {
  Stdout::write_char(code)
}
