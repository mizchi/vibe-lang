//# @vibe/testrun/count — how many `test {}` blocks a compiled test module
//# holds (#948, #3703). The one counter both test runners use: the launcher's
//# `vibe test` reads it from the CLI's test plan, and scripts/vibe_test.sh from
//# scripts/test_report.vibex. Each used to carry its own copy of a Python
//# name-section parser.
//#
//# The count is a label: `N` when it was read from the wasm `name` section's
//# function names, `~N` when the module has no names to read (the wasm-gc
//# backend strips them) and the count is the number of raw `__test_`
//# occurrences instead, which over-counts. A summary adds up only exact
//# counts.

//# Reading the module

/// The unsigned LEB128 at `i`: `(value, next index)`, or `(-1, -1)` past the
/// end of the bytes.
fn uleb(b: Bytes, i: Int) -> (Int, Int) {
  let n = Bytes::length(b)
  let mut result = 0
  let mut shift = 0
  let mut k = i
  let mut done = false
  let mut bad = false
  while !done && !bad {
    if k >= n || shift > 56 {
      bad = true
    } else {
      let x = Bytes::get(b, k)
      result = result|((x&127)<<shift)
      k = k + 1
      shift = shift + 7
      if (x&128) == 0 {
        done = true
      } else ()
    }
  }
  if bad {
    (-1, -1)
  } else {
    (result, k)
  }
}

fn starts_with_at(b: Bytes, at: Int, prefix: String) -> Bool {
  let n = String::length(prefix)
  if at + n > Bytes::length(b) {
    false
  } else {
    let mut ok = true
    let mut i = 0
    while ok && i < n {
      ok = Bytes::get(b, at + i) == String::byte_at(prefix, i)
      i = i + 1
    }
    ok
  }
}

/// The `__test_` functions the `name` section's function-name subsection
/// names: `(count, found)`, `found` false when the module has no such
/// subsection.
fn name_section_tests(_ b: Bytes) -> (Int, Bool) {
  let total = Bytes::length(b)
  let mut count = 0
  let mut found = false
  let mut i = 8
  let mut stop = false
  while !stop && i < total {
    let id = Bytes::get(b, i)
    let (size, start) = uleb(b, i + 1)
    if start < 0 || start + size > total {
      stop = true
    } else {
      let end = start + size
      if id == 0 {
        let (nlen, nstart) = uleb(b, start)
        if nstart >= 0 && nlen == 4 && starts_with_at(b, nstart, "name") {
          let mut j = nstart + 4
          while j < end {
            let sub = Bytes::get(b, j)
            let (ssize, sstart) = uleb(b, j + 1)
            if sstart < 0 || sstart + ssize > end {
              j = end
            } else {
              if sub == 1 {
                found = true
                let (cnt, first) = uleb(b, sstart)
                let mut k = first
                let mut e = 0
                while k >= 0 && e < cnt {
                  let (_, after_index) = uleb(b, k)
                  let (len, name_at) = uleb(b, after_index)
                  if name_at < 0 {
                    k = -1
                  } else {
                    if starts_with_at(b, name_at, "__test_") {
                      count = count + 1
                    } else ()
                    k = name_at + len
                  }
                  e = e + 1
                }
              } else ()
              j = sstart + ssize
            }
          }
        } else ()
      } else ()
      i = end
    }
  }
  (count, found)
}

/// Every occurrence of `__test_` in the bytes: what an export or data segment
/// still carries when the names are gone.
fn raw_test_occurrences(_ b: Bytes) -> Int {
  let n = Bytes::length(b)
  let mut count = 0
  let mut i = 0
  while i + 7 <= n {
    if starts_with_at(b, i, "__test_") {
      count = count + 1
      i = i + 7
    } else {
      i = i + 1
    }
  }
  count
}

//# Counting

/// The test-count label of a compiled test module: `N` from the name section,
/// else `~N` from raw occurrences. A module whose name section names no test
/// and that carries no `__test_` bytes at all holds `0` tests, exactly -- the
/// `(no tests found)` case (#948), a typo'd block that would otherwise pass as
/// an empty `_start`.
export fn test_run_count_label(_ wasm: Bytes) -> String {
  let (named, _) = name_section_tests(wasm)
  if named > 0 {
    __to_string(named)
  } else {
    let raw = raw_test_occurrences(wasm)
    if raw > 0 {
      "~\{raw}"
    } else {
      "0"
    }
  }
}
