//# Imports

import ./count.vibe {
  test_run_count_label
}

//# Fixture

// Hand-built modules: the 8-byte header, then sections. A `name` custom
// section (id 0) holds a function-name subsection (id 1): a count, then
// `index, length, bytes` per function.

fn bytes_of(_ xs: Array[Int]) -> Bytes {
  Bytes::from_array(xs)
}

fn push_str(out: Array[Int], s: String) -> Unit {
  let mut i = 0
  while i < String::length(s) {
    Array::push(out, value = String::byte_at(s, at = i))
    i = i + 1
  }
}

fn header() -> Array[Int] {
  [0, 97, 115, 109, 1, 0, 0, 0]
}

/// A module whose name section names `names`, in order.
fn named(_ names: Array[String]) -> Bytes {
  let sub: Array[Int] = [Array::length(names)]
  let mut i = 0
  while i < Array::length(names) {
    Array::push(sub, value = i)
    Array::push(sub, value = String::length(Array::get(names, at = i)))
    push_str(out = sub, s = Array::get(names, at = i))
    i = i + 1
  }
  let body: Array[Int] = [4]
  push_str(out = body, s = "name")
  Array::push(body, value = 1)
  Array::push(body, value = Array::length(sub))
  let mut k = 0
  while k < Array::length(sub) {
    Array::push(body, value = Array::get(sub, at = k))
    k = k + 1
  }
  let m = header()
  Array::push(m, value = 0)
  Array::push(m, value = Array::length(body))
  let mut j = 0
  while j < Array::length(body) {
    Array::push(m, value = Array::get(body, at = j))
    j = j + 1
  }
  bytes_of(m)
}

/// A module with no name section whose only other bytes are `text`, in a
/// custom section of its own (where an export name would also sit).
fn unnamed(_ text: String) -> Bytes {
  let body: Array[Int] = [3]
  push_str(out = body, s = "raw")
  push_str(out = body, s = text)
  let m = header()
  Array::push(m, value = 0)
  Array::push(m, value = Array::length(body))
  let mut j = 0
  while j < Array::length(body) {
    Array::push(m, value = Array::get(body, at = j))
    j = j + 1
  }
  bytes_of(m)
}

//# Counting

test "the name section's `__test_` functions are an exact count" {
  inspect(test_run_count_label(named(["main", "__test_a", "helper", "__test_b"])), content = "2")
}

test "a module with names but no `__test_` bytes holds no tests, exactly" {
  inspect(test_run_count_label(named(["main", "helper"])), content = "0")
  inspect(test_run_count_label(bytes_of(header())), content = "0")
}

test "without names, the raw occurrences are a marked over-count" {
  inspect(test_run_count_label(unnamed("__test_a __test_b __test_c")), content = "~3")
}

test "a truncated module is read as far as it goes" {
  let whole = named(["__test_a"])
  // The section's size now runs past the end; `__test_` is still there.
  let cut = Bytes::slice(whole, start = 0, end = Bytes::length(whole) - 1)
  inspect(test_run_count_label(cut), content = "~1")
}
