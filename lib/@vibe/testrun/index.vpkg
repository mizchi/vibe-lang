name = @vibe/testrun
version = 0.0.1
description =
  #|@vibe/testrun — the command policy of scripts/vibe_test.sh (#3674).
deps = {
  @vibe/json : 0.0.1
}

generated_hash =

// @vibe/testrun — what scripts/vibe_test.sh decides, as functions of what it
// observed: the argument grammar, each file's line and result record, and the
// `[vibe-test]` summary. The script launches the compiler and the runner and
// propagates the exit status; scripts/test_report.vibex is how it asks. That
// tool is compiled with the committed seed, so this package (and
// @vibe/testreport) must stay within what the seed compiles.

fn test_run_plan(argv: Array[String], backend: String) -> String with Exception
fn test_run_normalize(src_rel: String) -> String
fn test_run_flat(src_rel: String) -> String
fn test_run_entry(root: String, src: String) -> String
fn test_run_fail_record(tests: String) -> String
fn test_run_compile_failure(src_rel: String, diag: String) -> String
fn test_run_pass(src_rel: String, tests: String, patches: Int) -> String
fn test_run_pass_record(tests: String) -> String
fn test_run_coverage_pass(src_rel: String, report: String, show_gaps: Bool) -> String
fn test_run_coverage_record(report: String, tests: String) -> String
fn test_run_coverage_missing(src_rel: String, cov_out: String) -> String
fn test_run_failure(src_rel: String, patches: Int, detail: String) -> String
fn test_run_unrecorded(src_rel: String) -> String
fn test_run_failed(records: Array[String]) -> Bool
fn test_run_summary(records: Array[String], files: Int, compile_fails: Int, backend: String, coverage: Bool, seed_default: Bool, seed: String, covdir: String) -> String
