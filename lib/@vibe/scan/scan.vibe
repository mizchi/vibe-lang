//# Types

export struct Scanner {
  input: String;
  pos: Int
}

//# Functions

export fn new(input: String) -> Scanner {
  Scanner::{
    input: input,
    pos: 0
  }
}

/// #776: `new` only had the bare form even though the module's contract
/// ("bare 形と Scanner:: 名前空間形の両方が公開面") promises both, mirroring
/// `pos`/`is_done`/`peek`/etc. below. Root imports (`import @vibe/scan { type
/// Scanner }`) only get the namespace, so `Scanner::new(...)` must resolve too.
export fn Scanner::new(input: String) -> Scanner {
  new(input)
}

fn char_at(input: String, pos: Int) -> String {
  // `input[pos]` yields the char CODE (Int, per #667 soundness hardening); a
  // single-char String needs an explicit one-char slice.
  String::substring(input, pos, pos + 1)
}

fn clamp_pos(input: String, pos: Int) -> Int {
  let len = String::length(input)
  if pos < 0 {
    0
  }
  else if pos > len {
    len
  } else pos
}

export fn Scanner::pos(scan: Scanner) -> Int {
  scan.pos
}

export fn pos(scan: Scanner) -> Int {
  Scanner::pos(scan)
}

export fn Scanner::advance(scan: Scanner, count: Int) -> Scanner {
  Scanner::{
    input: scan.input,
    pos: clamp_pos(scan.input, scan.pos + count)
  }
}

export fn Scanner::is_done(scan: Scanner) -> Bool {
  scan.pos >= String::length(scan.input)
}

export fn is_done(scan: Scanner) -> Bool {
  Scanner::is_done(scan)
}

export fn Scanner::peek(scan: Scanner) -> Option[String] {
  if Scanner::is_done(scan) {
    None
  } else Some(char_at(scan.input, scan.pos))
}

export fn peek(scan: Scanner) -> Option[String] {
  Scanner::peek(scan)
}

export fn Scanner::next(scan: Scanner) -> Option[(String, Scanner)] {
  match Scanner::peek(scan) {
    Some(ch) => Some((ch, Scanner::advance(scan, 1))),
    _ => None
  }
}

export fn next(scan: Scanner) -> Option[(String, Scanner)] {
  Scanner::next(scan)
}

export fn Scanner::eat_if(scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)] {
  match Scanner::peek(scan) {
    Some(ch) => if pred(ch) {
      Some((ch, Scanner::advance(scan, 1)))
    } else None
    ,
    _ => None
  }
}

export fn eat_if(scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)] {
  Scanner::eat_if(scan, pred)
}

export fn Scanner::remaining(scan: Scanner) -> String {
  scan.input[scan.pos: String::length(scan.input)]
}

export fn remaining(scan: Scanner) -> String {
  Scanner::remaining(scan)
}

export fn Scanner::eat(scan: Scanner, prefix: String) -> Option[Scanner] {
  if String::starts_with(Scanner::remaining(scan), prefix) {
    Some(Scanner::advance(scan, String::length(prefix)))
  } else None
}

export fn eat(scan: Scanner, prefix: String) -> Option[Scanner] {
  Scanner::eat(scan, prefix)
}

export fn Scanner::take_until(scan: Scanner, needle: String) -> (String, Scanner) {
  let rest = Scanner::remaining(scan)
  let needle_len = String::length(needle)
  if needle_len == 0 {
    ("", scan)
  } else {
    let rel = String::index_of(rest, needle)
    if rel >= 0 {
      (rest[0: rel], Scanner::advance(scan, rel),)
    } else {
      (rest, Scanner::advance(scan, String::length(rest)),)
    }
  }
}

export fn take_until(scan: Scanner, needle: String) -> (String, Scanner) {
  Scanner::take_until(scan, needle)
}

export fn Scanner::take_while(scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner) {
  let len = String::length(scan.input)
  let rec r#loop = (pos: Int) -> Int {
    if pos >= len {
      pos
    } else {
      let ch = char_at(scan.input, pos)
      if pred(ch) {
        r#loop(pos + 1)
      } else pos
    }
  }
  let end = r#loop(scan.pos)
  (scan.input[scan.pos: end], Scanner::{
    input: scan.input,
    pos: end
  },)
}

export fn take_while(scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner) {
  Scanner::take_while(scan, pred)
}

