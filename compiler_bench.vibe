// Compiler pipeline benchmarks: lex → parse stages
// Measures selfhost compiler performance on representative files

import ./vibe/compiler/lexer.vibe { lex }
import ./vibe/compiler/parser.vibe { parse, parse_program }

// Read target source files once
let small_source = fs_read_file("vibe/compiler/lexer.vibe")
let medium_source = fs_read_file("vibe/compiler/parser.vibe")
let large_source = fs_read_file("vibe/compiler/codegen.vibe")

// Pre-lex for parse benchmarks
let small_tokens = lex(small_source)
let medium_tokens = lex(medium_source)
let large_tokens = lex(large_source)

// --- Lex benchmarks ---

bench "lex_small" {
  let _tokens = lex(small_source)
  ()
}

bench "lex_medium" {
  let _tokens = lex(medium_source)
  ()
}

bench "lex_large" {
  let _tokens = lex(large_source)
  ()
}

// --- Parse benchmarks ---

bench "parse_small" {
  let _stmts = parse_program(small_tokens)
  ()
}

bench "parse_medium" {
  let _stmts = parse_program(medium_tokens)
  ()
}

bench "parse_large" {
  let _stmts = parse_program(large_tokens)
  ()
}
