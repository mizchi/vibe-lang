// The CI gate runs this header probe on the two linear RC lanes.
let table: Array[Int] = [7, 11]
let rows: Array[Array[Int]] = [[23, 29]]

fn references(_ xs: Array[Int]) -> Int = wasm
"(vibe.int.tag (i64.extend_i32_u (i32.and (i32.load (i32.sub (i32.wrap_i64 (local.get $xs)) (i32.const 4))) (i32.const 16777215))))"

fn check_local(_ table: Array[Int]) -> Int {
  Array::get(table, at = 0) + Array::get(table, at = 1)
}

fn read_second(_ unused: Int, _ xs: Array[Int]) -> Int {
  Array::get(xs, at = 1)
}

fn main() -> Int {
  let mut errors = 0
  let mut i = 0
  while i < 2000 {
    let row = Array::get(rows, at = 0)
    let other = [i, i + 1]
    if Array::get(table, at = 0) != 7 || read_second(0, table) != 11 || check_local(other) != i + i + 1 || Array::get(row, at = 1) != 29 {
      errors = errors + 1
    }
    i = i + 1
  }
  if references(table) == 1 {
    errors
  } else {
    errors + 1
  }
}
