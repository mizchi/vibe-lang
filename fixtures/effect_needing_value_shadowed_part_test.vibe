// #4065: a stored literal's names are read in the scope it was bound in.
// `pair.1` is the first `xs` (plain closures) even though a later `xs` holds
// the handle-bound closure, so handing its element to a row-free parameter
// compiles and runs.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn shadowed_part() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs = [() -> 42]
    let pair = (g, xs)
    let xs = [g]
    apply(f = Array::get(pair.1, at = 0)) + Array::length(xs)
  } with {
    Ask::Get() => resume(5)
  }
}

test "a stored part is read in the scope it was bound in" {
  inspect(shadowed_part(), content = "143")
}
