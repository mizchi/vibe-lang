import @vibe/compiler/cache {
  compact_source_fingerprint_memo, persistent_dep_list_cache_path, persistent_type_env_cache_path
}
import @vibe/compiler/core {
  Type, TypeEnv, env_bind
}
import @vibe/compiler/runtime {
  load_persistent_dep_list,
  load_persistent_module_cache,
  load_persistent_type_env,
  persistent_dep_list_text,
  persistent_module_cache_text,
  persistent_type_env_cache_text
}

test "disk adapter loads complete records and refuses damaged records" {
  let fingerprint = "env-adapter-complete-record-test"
  let env = env_bind(EnvEmpty, "answer", CtInt)
  let text = persistent_module_cache_text(env, Some(([], [], [])))
  let path = persistent_type_env_cache_path(fingerprint)
  Fs::write_file(path, text)
  match load_persistent_module_cache(fingerprint) {
    Some(record) => {
      assert(persistent_module_cache_text(record.env, record.lowering) == text)
      match record.lowering {
        Some((offs, eq_offs, eq_keys)) => {
          assert(Array::length(offs) + Array::length(eq_offs) + Array::length(eq_keys) == 0)
        },
        None => assert(false)
      }
    },
    None => assert(false)
  }
  match load_persistent_type_env(fingerprint) {
    Some(decoded) => assert(persistent_type_env_cache_text(decoded) == "version\t10\nenv\t12:B6:answerIU0\n"),
    None => assert(false)
  }
  let damaged = String::concat(text, "unexpected\n")
  assert(damaged != text)
  Fs::write_file(path, damaged)
  match load_persistent_module_cache(fingerprint) {
    None => (),
    Some(_) => assert(false)
  }
  Fs::write_file(path, persistent_type_env_cache_text(env))
  match load_persistent_module_cache(fingerprint) {
    None => (),
    Some(_) => assert(false)
  }
}

test "disk adapter preserves dependency cache versions and repeated occurrences" {
  let path = "_build/env-adapter-logical-module.vibe"
  let source = "fn answer() -> Int { 42 }"
  let cache_path = persistent_dep_list_cache_path(path, compact_source_fingerprint_memo(path, source))
  for deps in [[], ["a.vibe"], ["a.vibe", "a.vibe"]] {
    Fs::write_file(cache_path, persistent_dep_list_text(deps))
    match load_persistent_dep_list(path, source) {
      Some(decoded) => assert(decoded == deps),
      None => assert(false)
    }
  }
  Fs::write_file(cache_path, "version\t99\n")
  let message = handle {
    load_persistent_dep_list(path, source)
    "accepted"
  } with { Exception::Throw(message) => message }
  assert(message == String::concat("invalid persistent dep list header: ", cache_path))
}

test "disk adapter refuses stale resolved package index paths" {
  let path = "_build/env-adapter-stale-package-module.vibe"
  let source = "import @vibe/core { array_empty }"
  let cache_path = persistent_dep_list_cache_path(path, compact_source_fingerprint_memo(path, source))
  let stale = "_build/stale-root/@vibe/core/index.vpkg"
  for deps in [[stale], [stale, "a.vibe"]] {
    Fs::write_file(cache_path, persistent_dep_list_text(deps))
    match load_persistent_dep_list(path, source) {
      None => (),
      Some(_) => assert(false)
    }
  }
}
