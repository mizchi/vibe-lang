// #3571: two modules each extend a type a THIRD module declares with a private
// `fn Pt::shout`, and call it with dot syntax. Only a module's own private
// types are namespaced apart, so both definitions kept the name `Pt::shout`
// and the build ran whichever the import order merged first. Refused.

import ./modules/qualified_fn_overlap_pt_a.vibe {
  pt_a_name
}

import ./modules/qualified_fn_overlap_pt_b.vibe {
  pt_b_name
}

test "both modules keep their own method" {
  inspect("\{pt_a_name()} \{pt_b_name()}", content = "pt-from-a pt-from-b")
}
