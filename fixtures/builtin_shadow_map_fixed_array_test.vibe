// #3185: a program's own `Map::set` / `Map::delete` / `Map::remove`,
// `FixedArray::make` / `unsafe_set` / `blit` and `Array::concat` answers the
// calls the program wrote, on every lane. Both lanes lowered those spellings
// inline ahead of the function table, so the program's declaration was
// ignored. Each function here answers a type its builtin never does. A map
// literal and a map's structural `==`, which the compiler lowers through the
// builtins, still work beside them.

fn Map::set(m: Int, k: Int, v: Int) -> String {
  "own Map::set \{m - k - v}"
}

fn Map::delete(m: Int, k: Int) -> String {
  "own Map::delete \{m - k}"
}

fn Map::remove(m: Int, k: Int) -> Int {
  m * 10 - k
}

fn Array::concat(a: Int, b: Int) -> Int {
  a - b
}

fn FixedArray::make(n: Int, v: Int) -> String {
  "own FixedArray::make \{n - v}"
}

fn FixedArray::unsafe_set(a: Int, b: Int, c: Int) -> String {
  "own FixedArray::unsafe_set \{a - b - c}"
}

fn FixedArray::blit(a: Int, b: Int, c: Int, d: Int, e: Int) -> Int {
  a - b - c - d - e
}

test "the program's own Map functions answer its calls" {
  inspect(Map::set(m = 9, k = 2, v = 3), content = "own Map::set 4")
  inspect(Map::delete(m = 9, k = 2), content = "own Map::delete 7")
  inspect(Map::remove(m = 3, k = 4), content = "26")
}

test "the program's own FixedArray functions and Array::concat answer its calls" {
  inspect(Array::concat(a = 9, b = 4), content = "5")
  inspect(FixedArray::make(n = 9, v = 2), content = "own FixedArray::make 7")
  inspect(FixedArray::unsafe_set(a = 9, b = 2, c = 3), content = "own FixedArray::unsafe_set 4")
  inspect(FixedArray::blit(a = 20, b = 1, c = 2, d = 3, e = 4), content = "10")
}

test "a map literal and a map's structural equality still reach the builtins" {
  let a = Map::from_pairs([("x", 1), ("y", 2)])
  let b = Map::from_pairs([("y", 2), ("x", 1)])
  inspect(Map::size(a), content = "2")
  inspect(a == b, content = "true")
}
