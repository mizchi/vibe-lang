// A guarded arm after an unguarded arm for another variant. The guard's
// fallthrough match used to be checked over the whole type, so this was
// refused with "variant `Circle` ... is not handled".
enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Empty
}

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => r * r * 3,
    Rect(w, h) if w == h => 1000,
    Rect(w, h) => w * h,
    Empty => 0
  }
}

fn sign(o: Option[Int]) -> Int {
  match o {
    None => 0,
    Some(v) if v > 0 => 1,
    Some(_) => -1
  }
}

test "a failed guard falls through to the later arms" {
  inspect(area(Circle(2)), "12")
  inspect(area(Rect(3, 3)), "1000")
  inspect(area(Rect(2, 5)), "10")
  inspect(area(Empty), "0")
  inspect(sign(None), "0")
  inspect(sign(Some(4)), "1")
  inspect(sign(Some(-4)), "-1")
}
