//# Codex round 3 on #2456: `Result` is always a declared enum (#1324), and a
//# declaration whose constructors are not `Ok(T) | Err(E)` is an ordinary
//# enum (docs/adding-modules.md). `eq_for_typed`'s `Result` arm is a
//# constructor match over `Ok`/`Err`; it is gated on the DECLARED shape, so
//# this `Success`/`Failure` enum takes its derived `Result::equals` instead,
//# which is content equality for these word-sized payloads. Measured on the
//# stage2 at 7cfea5c: both comparisons below trapped (`unreachable`, the
//# `Ok`/`Err` match falling off a `Success` value).

enum Result[T, E] {
  Success(T);
  Failure(E)
}

fn fill(xs: Array[Result[Int, String]], v: Int) -> Unit {
  Array::push(xs, Success(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  let failed = []
  Array::push(failed, Failure("e"))
  assert(left == right)
  assert(left != other)
  assert(left != failed)
  0
}
