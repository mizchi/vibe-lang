// #3616: `P` has two applied impls of `It`, and the argument that says which
// one `It::pass(p, ..)` means is a `match` whose type the dictionary pass
// cannot read. The build refuses the call, naming the edit (annotate that
// argument, or go through a bound), rather than picking an impl. Bound to
// `let a: Int = match ..` first, the same call selects `impl It[Int] for P`
// (`fixtures/applied_trait_direct_call_selects_impl_test.vibe`).

trait It[A] {
  pass(self: Self, a: A) -> A
}

struct P {
  n: Int
}

impl It[Int] for P {
  pass(self: P, a: Int) -> Int {
    a + self.n
  }
}

impl It[String] for P {
  pass(_self: P, a: String) -> String {
    a
  }
}

fn main() -> Unit allows Console {
  let p = P::{ n: 1 }
  let o: Option[Int] = Some(3)
  let r = It::pass(p, match o {
    Some(v) => v,
    None => 0
  })
  println("\{r}")
}
