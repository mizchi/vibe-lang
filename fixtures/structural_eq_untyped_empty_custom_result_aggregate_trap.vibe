//# Codex round 3 on #2456, the fail-closed side. A `Result` declared with
//# constructors other than `Ok`/`Err` has only its derived `Result::equals`,
//# which compares a payload typed by a formal with the raw word `==` --
//# reference equality for an `Array`. Two content-equal, separately
//# allocated payloads must therefore TRAP once both sides are non-empty,
//# never answer `false` by identity; `Ok`/`Err` spellings, or a word-sized
//# payload, answer (see the `_typed` sibling).

enum Result[T, E] {
  Success(T);
  Failure(E)
}

fn fill(xs: Array[Result[Array[Int], String]], v: Int) -> Unit {
  Array::push(xs, Success([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
