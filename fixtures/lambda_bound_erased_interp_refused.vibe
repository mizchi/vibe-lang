// #2745 / #2840: this lambda has no renderer for its erased formal.
// Moving it to a top-level declaration would not provide one. Pass an
// explicit renderer, or interpolate at a concrete type instead.

trait Eq {
  equals(Self, Self) -> Bool
}

struct Qt {
  w: Int
}

impl Eq for Qt {
  equals(a: Qt, b: Qt) -> Bool {
    a.w == b.w
  }
}

impl Eq for Int {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

fn outer[T: Eq](x: T) -> String {
  let inner = [T: Eq](a: T) -> String {
    "\{a}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
