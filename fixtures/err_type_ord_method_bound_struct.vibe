// #3350: `<` on an erased formal has no witness to dispatch through, so a
// program's `Ord` is judged by the type alone, methods or not.
//
// The #2612 guard refused a MARKER `Ord` and stood down once `Ord` declared a
// method. `a < b` still lowered to the builtin comparison: measured on the
// #3327 stage2 (43ee1c792), `smaller(Token::{ value: 2 }, Token::{ value: 1 })`
// answered `true`, and so did the same with `compare(Self, Self) -> Int`.

trait Ord {
  rank(Self) -> Int
}

struct Token {
  value: Int
}

impl Ord for Token {
  rank(a: Token) -> Int {
    a.value
  }
}

fn smaller[T: Ord](a: T, b: T) -> Bool {
  a < b
}

fn main() -> Unit allows Console {
  println(__to_string(smaller(Token::{ value: 2 }, Token::{ value: 1 })))
}
