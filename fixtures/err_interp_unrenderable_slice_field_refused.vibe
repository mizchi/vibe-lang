// #3080: a slice (`xs[a:b]`) of an `Array` read from a struct field. Normalize
// cannot resolve the field's shape (the same gap as
// err_interp_unrenderable_field_refused), so the slice's shape is unknown too.
// The slice call carried no source offset, so the checker filed no row for it
// and both lanes printed an address; it is refused at build time now, and
// `let t: Array[Int] = bx.tags[0:1]` renders it.
struct Bx {
  tags: Array[Int]
}

export let _start: () -> Int = () -> {
  let bx = Bx::{ tags: [1, 2] }
  let s = "\{bx.tags[0:1]}"
  String::length(s)
}
