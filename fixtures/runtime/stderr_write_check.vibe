// #865 manual/e2e check fixture: writes one marker line to stdout and a
// DIFFERENT marker line to stderr. Verifying which fd each marker actually
// lands on is a process-level property no `.vibe` test block can observe
// from inside itself, so this is checked as a manual shell-level command
// (documented in the #865 report), not an automated test:
//
//   bash scripts/vibe_run.sh fixtures/runtime/stderr_write_check.vibe \
//     1>/tmp/stdout_only.txt
//   grep -q STDOUT_MARKER /tmp/stdout_only.txt   # present
//   grep -q STDERR_MARKER /tmp/stdout_only.txt   # absent (went to fd 2)
export let main = () -> Unit with Stdout + Stderr {
  Stdout::write_stream("STDOUT_MARKER\n")
  Stderr::write_stream("STDERR_MARKER\n")
}
