// #903/#865 manual/e2e check fixture: exits with a specific non-zero code
// via the new Process::exit builtin (vibe_process_exit_raw), verifying
// `vibe run fixtures/runtime/process_exit_check.vibe; echo $?` reports 42
// as the real OS exit status -- unlike a `main() -> Int` return, which
// `_start` only PRINTS the value and always exits 0 (see #903).
export let main = () -> Unit with Process {
  vibe_process_exit_raw(42)
}
