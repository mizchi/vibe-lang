//# Types

struct Point {
  x: Int; y: Int
}

//# Functions

let x = 5

let y = 10

let p = Point::{
  x, y
}

let p_x = p.x

let p_y = p.y

//# Misc

test "struct_shorthand_create" {
  assert(eq(p_x, 5))
  assert(eq(p_y, 10))
}

test "struct_shorthand_match" {
  let p2 = Point::{
    x: 7, y: 14
  }
  // A struct pattern binds through `match`, and its fields bind by SHORTHAND:
  // neither `let Point::{ ... } = p2` ("expected = but got ident") nor a
  // renaming field pattern `Point::{ x: a, ... }` ("expected => but got ident")
  // is accepted by the parser today. The binders below shadow the top-level
  // `x`/`y` inside the arm, which is the point: the pattern's fields win.
  let sum = match p2 {
    Point::{ x, y } => add(x, y),
    _ => 0
  }
  assert(eq(sum, 21))
}
