//# Types

struct Point {
  x: Int; y: Int
}

//# Functions

let x = 5

let y = 10

let p = Point::{
  x, y
}

let p_x = p.x

let p_y = p.y

__DATA__

//# Misc

test "struct_shorthand_create" {
  assert(eq(p_x, 5))
  assert(eq(p_y, 10))
}

test "struct_shorthand_match" {
  let p2 = Point::{
    x: 7, y: 14
  }
  let Point::{
    x: a, y: b
  } = p2
  assert(eq(a, 7))
  assert(eq(b, 14))
}
