// #865 manual/e2e check fixture: prints trailing argv, one per line, prefixed
// with its index -- so `bash scripts/vibe_run.sh fixtures/runtime/argv_echo_check.vibe main -- foo bar`
// can be verified to forward "foo"/"bar" through to the compiled program via
// `Env::args_len` / `Env::args_get` (see the #865 report for the exact
// commands run).
export let main = () -> Unit with Env + Stdout {
  let n = Env::args_len()
  let mut i = 0
  while i < n {
    Stdout::write_stream("arg[\{i}]=\{Env::args_get(i)}\n")
    i = i + 1
  }
}
