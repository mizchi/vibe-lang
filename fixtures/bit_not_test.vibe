// #2344 slice C: `~` (bit-not) over the 63-bit two's complement `Int`.
//
// The lowering is `x ^ -1`, but the CONSTANT is lane-dependent and that is the
// whole trap: under RC an `Int` is `n<<1`, so complementing the tagged value
// needs tagged(-1) = -2. Xoring a tagged value with a raw -1 sets the tag bit
// and hands every consumer a malformed Int -- correct-looking for some inputs,
// wrong for others. The untagged lanes use -1 directly.
//
// Every case below therefore includes a NEGATIVE input: `~` on the tagged
// value would be right for small non-negative `n` and wrong past the sign, so
// a non-negative-only test would pass against a broken lowering.

fn bit_not(x: Int) -> Int {
  ~x
}

//# Misc

test "#2344 ~ is bit-not: ~x == -x - 1" {
  assert(~0 == 0 - 1)
  assert(~(0 - 1) == 0)
  assert(~5 == 0 - 6)
  assert(~(0 - 6) == 5)
  assert(~7 == (0 - 7) - 1)
  assert(~(0 - 7) == 7 - 1)
  assert(~1 == 0 - 2)
  assert(~(0 - 2) == 1)
}

test "#2344 ~ is an involution" {
  assert(~(~0) == 0)
  assert(~(~12345) == 12345)
  assert(~(~(0 - 12345)) == 0 - 12345)
  assert(~(~1) == 1)
}

test "#2344 ~ through a function and composed with the bit operators" {
  assert(bit_not(0) == 0 - 1)
  assert(bit_not(0 - 6) == 5)
  assert((~0)&255 == 255)
  assert((5^~0) == ~5)
  assert((~0)&(~0) == ~0)
  // `~` binds tighter than the infix operators, like the other prefixes.
  assert(~0 - 1 == 0 - 2)
}

test "#2344 `~` is intish: a both-`~` equality takes the integer path" {
  // Review (#2403): `expr_is_intish` / `gc_expr_is_intish` decide whether `==`
  // uses the integer path or the generic `eq`, which reads an operand as a
  // (ptr|len) string. With `~` unregistered, two DISTINCT integers whose low
  // 32 bits are zero both looked like the empty string and the comparison
  // answered `true`.
  //
  // Every other equality in this file has an intish literal or binop on the
  // other side, so only a both-sides-`~` case reaches the classifier. These
  // are written DIRECTLY rather than through a `let`: a bare ident is
  // classified from the slot log on the linear lane and not at all on gc
  // (`gc_expr_is_intish` takes no locals), which is a pre-existing gap in the
  // runtime string-pointer heuristic and not what `~` changed.
  assert(~((0 - (64<<32)) - 1) != ~((0 - (65<<32)) - 1))
  assert(!(~((0 - (64<<32)) - 1) == ~((0 - (65<<32)) - 1)))
  assert(~((0 - (64<<32)) - 1) == ~((0 - (64<<32)) - 1))
}

test "#2344 `~` is intish: `__to_string` renders an integer, not a string" {
  // `ts_known_int` had no unary arm at all, so a direct `~` fell to the
  // runtime heuristic. (A pathological VALUE additionally traps `__to_string`
  // on the gc lane, with no `~` involved -- pre-existing, filed separately --
  // so these stay in the ordinary range.)
  assert(__to_string(~0) == "-1")
  assert(__to_string(~5) == "-6")
  assert(__to_string(~(0 - 1)) == "0")
  assert(__to_string(~(0 - 6)) == "5")
}
