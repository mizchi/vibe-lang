//# #3758: a builtin operation a package publishes (`export { Float64::floor }`)
//# is typed by the builtin's own signature once its type is imported, under
//# the type's own name (`import @vibe/builtin { Float64 }`) and through an
//# alias (`{ Float64 as D }`). Both used to check as an unknown type against
//# any argument and any result, and `D::floor(1.5)` printed the raw
//# representation (`340`) on the linear lane. #3832: a call through the alias
//# takes the builtin's labels, as the canonical spelling does.

import @vibe/builtin {
  Float32 as F, Float64, Float64::floor as fl, Float64 as D, Int::popcount as pc, Int as I, String, String::starts_with as sw, String as S
}

test "a Float64 alias reaches the published builtins with their types" {
  inspect(D::floor(1.5), content = "1")
  inspect(D::ceil(1.5), content = "2")
  inspect(D::abs(-2.5), content = "2.5")
  inspect(D::max(1.5, 2.5), content = "2.5")
  inspect(D::min(1.5, 2.5), content = "1.5")
  let a = D::floor(7.25)
  let b: Float64 = a + 0.5
  inspect(b, content = "7.5")
}

test "Int and String aliases reach their published builtins" {
  inspect(I::popcount(7), content = "3")
  inspect(I::to_float64(7), content = "7")
  inspect(S::trim("  x  "), content = "x")
  inspect(S::contains("ab", "b"), content = "true")
}

test "a Float32 alias and an item alias of a builtin" {
  inspect(F::abs(-1.5f), content = "1.5")
  inspect(fl(4.5), content = "4")
}

test "importing the type keeps the builtin's own signature" {
  inspect(Float64::floor(1.5), content = "1")
  let t: String = String::trim("  y ")
  inspect(t, content = "y")
  inspect(String::starts_with("ab", prefix = "a"), content = "true")
}

test "a call through an alias takes the builtin's labels" {
  inspect(S::starts_with("ab", prefix = "a"), content = "true")
  inspect(S::contains("ab", needle = "c"), content = "false")
  inspect(sw("ab", prefix = "b"), content = "false")
}

// Codex on #3839: a local binding that shadows the alias keeps its own labels.
test "a local binding that shadows an alias keeps its own labels" {
  let sw = (text: String, suffix: String) -> String::ends_with(text, suffix = suffix)
  inspect(sw(text = "ab", suffix = "b"), content = "true")
}

// #3833: a builtin that has a value form stays one through an alias; a
// call-only one is refused (the err_type_builtin_*_value rows).
test "a builtin with a value form is a value through an alias" {
  let a = pc
  let b = I::popcount
  let c = S::trim
  inspect(a(7), content = "3")
  inspect(b(15), content = "4")
  inspect(c(" x "), content = "x")
}
