// #3070: the exporting side of fixtures/suberror_export_test.vibe. A
// `suberror` is sugar for an enum (#2983), so `export suberror` publishes the
// type and its constructors exactly as `export enum` does -- the single-form
// declaration, the braced form, and an unexported one published through an
// export list.
export suberror Denied(Int)

export suberror AppError {
  Io(String);
  Parse(Int)
}

suberror Listed(String)

export {
  Listed
}

export fn check_access(level: Int) -> Int with Exception[Denied] {
  if level < 3 {
    throw(Denied(level))
  } else {
    level * 10
  }
}

export fn load(code: Int) -> Int with Exception[AppError] {
  if code == 0 {
    throw(Io("disk"))
  } else if code < 0 {
    throw(Parse(code))
  } else {
    code
  }
}

export fn listed(bad: Bool) -> Int with Exception[Listed] {
  if bad {
    throw(Listed("nope"))
  } else {
    1
  }
}
