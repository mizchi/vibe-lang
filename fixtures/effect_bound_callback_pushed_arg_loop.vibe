// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    apply(f = {
      for i in [0] {
        Array::push(xs, value = g)
      }
      ()
      Array::get(xs, at = 1)
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
