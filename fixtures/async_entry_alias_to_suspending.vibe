// #3534 review (Codex): the entry calls the top-level suspending `work`
// through a local alias. The scan compared only the callee name `f` with the
// suspending set, so no boundary was injected. A suspending function named
// as a VALUE now counts as reachable. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh (want 5).
import @vibe/concurrent/experimental {
  sleep_wait
}

fn work() -> Int with Async {
  sleep_wait(1)
  5
}

fn main() -> Int allows Async {
  let f = work
  f()
}
