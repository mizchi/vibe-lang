// A bounded LOCAL lambda that shadows a top-level function of the same
// spelling, named as a value: the local's own gen is the binding in scope,
// and it is supplied a witness at each call.
fn same(x: Int, y: Int) -> Bool {
  x == y
}

export let _start: () -> Int = () -> {
  let same = [T: Eq](x: T, y: T) -> Bool {
    x == y
  }
  let g = same
  if g(1, 1) {
    1
  } else {
    0
  }
}
