// #1967: was fixtures/trait_impl_multi_bound_basic.vibe + __DATA__.last "1".
// `impl [T: LocalEq + Show] LocalHash for T` cannot see Show-for-String.
// Drop Show. Generic `impl [T: LocalEq] LocalHash for T` still does not
// cover CtString, so keep accepts_hash("ok") -> 1 with a concrete local
// impl.

trait LocalEq
trait LocalHash
impl LocalEq for String
impl LocalHash for String

fn accepts_hash[U: LocalHash](x: U) -> Int {
  1
}

test "LocalHash via local LocalEq witness accepts String" {
  inspect(accepts_hash("ok"), "1")
}
