// Typed Lookup effect with separate operations per type
effect Lookup {
  FindInt(String) -> Int;
  FindStr(String) -> String
}

// Int lookup → 100 + 1 = 101
let found = handle {
  let v = perform Lookup::FindInt("key")
  v + 1
} { Lookup::FindInt(_k) => resume(100), Lookup::FindStr(_k) => resume("") }

// String lookup → length("Alice") = 5
let str_len = handle {
  let s = perform Lookup::FindStr("name")
  String::length(s)
} { Lookup::FindInt(_k) => resume(0), Lookup::FindStr(_k) => resume("Alice") }

found + str_len

__DATA__
{"last": "106"}
