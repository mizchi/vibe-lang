// #1967: was fixtures/err_type_closure_capture_mut.vibe + __DATA__.last "0".
// Comments said "captures by value". Two f() calls that increment the
// captured let mut leave x as 2 — that is the honest runtime.

test "closure captured let mut increments across calls" {
  let mut x = 0
  let f = () -> Unit {
    x = x + 1
  }
  f()
  f()
  inspect(x, "2")
}
