// Dependency module for `imported_scheme_instantiate_test.vibe` (#743).
//
// That regression needs a TWO-parameter enum whose ctor schemes are
// instantiated across a module boundary — the prelude `Result` used to
// provide it, but #1324 removed it. Declaring the same shape here keeps the
// scheme genuinely IMPORTED (which is the whole point of #743: an imported
// scheme carries bound-var ids from the exporting module's counter domain)
// rather than local to the test file.
//
// `_`-prefixed, so it is excluded from automatic build roots but stays
// reachable as an explicit relative import target (ADR-0070).

export enum Res[T, E] {
  Ok(T);
  Err(E)
}
