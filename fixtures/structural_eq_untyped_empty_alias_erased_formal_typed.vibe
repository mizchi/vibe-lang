//# Codex round 9 on #2456: a payload may pass the enum's formal through an
//# alias that does not observe its argument -- `type Ignore[X] = Int` --
//# so `enum Marker[T] { Mark(Ignore[T]); Empty }` has an `Int` payload
//# after alias expansion, and its derived `Marker::equals` is exact. The
//# payload-safety check renames the declaration's formals to sentinels,
//# expands aliases, and only then asks the allow-list: the sentinel is gone
//# here, so the comparison ANSWERS (measured on the stage2 at 081abdd: it
//# trapped, because the syntactic walk saw `T` inside `Ignore[T]`).

type Ignore[X] = Int

enum Marker[T] {
  Mark(Ignore[T]);
  Empty
}

fn fill(xs: Array[Marker[String]], v: Int) -> Unit {
  Array::push(xs, Mark(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
