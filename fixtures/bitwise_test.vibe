//# Misc

test "bitwise and" {
  assert((0xFF & 0x0F) == 0x0F)
  assert((0 & 123) == 0)
  assert((7 & 7) == 7)
}

test "bitwise or" {
  assert((0xF0 | 0x0F) == 0xFF)
  assert((0 | 0) == 0)
  assert((1 | 2 | 4) == 7)
}

test "bitwise xor" {
  assert((0xFF ^ 0xFF) == 0)
  assert((0xFF ^ 0x00) == 0xFF)
  assert((5 ^ 3) == 6)
}

test "left shift" {
  assert((1 << 0) == 1)
  assert((1 << 1) == 2)
  assert((1 << 8) == 256)
  assert((1 << 16) == 65536)
  assert((3 << 4) == 48)
}

test "right shift arithmetic" {
  assert((8 >> 1) == 4)
  assert((8 >> 2) == 2)
  assert((8 >> 3) == 1)
  assert((255 >> 4) == 15)
}

test "right shift sign extension" {
  // >> is arithmetic shift (sign-extending)
  assert((-1 >> 1) < 0)
  assert((-8 >> 1) == -4)
  assert((-16 >> 2) == -4)
}

test "unsigned right shift workaround" {
  // No unsigned right shift, use: (x >> n) & ((1 << (32 - n)) - 1)
  let x = 0xFF
  let n = 4
  let result = (x >> n) & ((1 << (32 - n)) - 1)
  assert(result == 15)
}

test "hex literal formats" {
  assert(0xFF == 255)
  assert(0Xff == 255)
  assert(0XFF == 255)
  assert(0x10 == 16)
  assert(0x0 == 0)
  assert(0x1A2B == 6699)
}

test "combined bitwise ops" {
  // Extract bits 4-7 from a value
  let val = 0xABCD
  let bits = (val >> 4) & 0xF
  assert(bits == 0xC)
}

test "bit manipulation patterns" {
  // Set bit 3
  let x = 0
  let set = x | (1 << 3)
  assert(set == 8)
  // Clear bit 3
  let cleared = set & (0xFFFFFF ^ (1 << 3))
  assert(cleared == 0)
  // Toggle bit 0
  let toggled = 5 ^ 1
  assert(toggled == 4)
  let toggled2 = toggled ^ 1
  assert(toggled2 == 5)
}

test "bitwise not" {
  // `~` IS supported (#2344). This used to be a "workaround" test whose comment
  // said otherwise; the mask form is kept as the cross-check that the two agree
  // over the bits the mask covers.
  let x = 0xFF
  let masked = x ^ 0xFFFFFFFF
  assert((masked & 0xFF) == 0)
  assert((~x & 0xFF) == 0)
  assert((~x & 0xFFFFFFFF) == (masked & 0xFFFFFFFF))
  // Past the mask the two DIFFER, which is the point of having the operator:
  // `~` complements the whole 63-bit value, so it is negative here.
  assert(~x == (0 - x) - 1)
  assert(masked > 0)
}
