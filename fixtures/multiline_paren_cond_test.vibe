// Regression: a parenthesized condition containing a slice (`s[0: 2]`)
// followed by the if body's `{` must NOT parse as a no-arrow lambda.
// is_lambda_start counted the slice's `:` (bracket depth untracked) as a
// param annotation, so `if (len >= 2 && raw_path[0: 2] == "./") || ... {`
// died with "expected ',' or ')' in param list" — this blocked every test
// importing vibe/compiler/entry/compiler/fs_compile/closure_order.vibe
// (7 files in the #531 corpus scan). Only the raw FS lane ever parsed that
// file (it is outside the adapter bundle graph), which is why bundle regen
// never caught it.

let check: (String) -> Bool = (raw_path) -> {
  let len = String::length(raw_path)
  let joined = if (len >= 2 && raw_path[0: 2] == "./") ||
  (len >= 3 && raw_path[0: 3] == "../") {
    true
  } else {
    false
  }
  joined
}

test "multiline if condition" {
  assert(check("./x"))
  assert(check("../y"))
  assert(!check("plain"))
}
