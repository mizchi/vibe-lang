import ./import_kind_phase1/private_generic_enum_alias_facade.vibe {
  Api, make_a
}

type Local = Api[Int]
type Param[T] = Api[T]

test "applied local aliases qualify private generic constructors" {
  inspect(match make_a(7) {
    Local::A(value) => value,
    Local::B => 0
  }, content = "7")
  inspect(match make_a(8) {
    Param::A(value) => value,
    Param::B => 0
  }, content = "8")
}
