// #1967: was fixtures/let_type_annotation_generic.vibe + __DATA__.last "42".
// Stale `let identity: [T](T) -> T = [T](x: T) -> { x }` is rejected.
// Current `fn identity[T](x: T) -> T` keeps the claimed value.

fn identity[T](x: T) -> T {
  x
}

test "generic identity returns the Int argument" {
  inspect(identity(42), "42")
}
