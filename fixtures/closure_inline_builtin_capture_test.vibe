/// #1218 (found during D1 increment 4): inline-lowered builtins with NO
/// func-table entry -- Future::pending/resolve (#1230) and
/// Path::to_string/is_absolute -- were missing from
/// is_inlined_async_builtin (common_analysis.vibe), so a closure calling
/// one recorded the NAME as a capturable free variable. compile_lambda
/// then allocated a captured-env slot for it and the call compiled to a
/// call_indirect of that nonexistent closure value: an
/// invalid-signature-index module (wasmtime refuses to instantiate) or a
/// "null function or function signature mismatch" trap, depending on
/// which signature the garbage index happened to name. Same mechanism as
/// the #773 scalar-intrinsic capture bug.
///
/// #1348 extends this: `Path::resolve` and `Path::ref` are now called
/// INSIDE the closures too. They had been held out because registering
/// them broke straight-line top-level `Path::is_absolute(Path::resolve(..))`
/// -- the used-builtin scan shared the same walk and therefore the same
/// skip, so registering a name also erased it from the used set and the
/// `resolve_path` host import these two lower to was never reserved. The
/// scan now runs with the skip off (collect_free_vars_used_builtins), so
/// both call sites below and the top-level one at the end must all work.
///
/// Each closure here reproduced a miscompile on the unfixed compiler.
/// 40 + 1 + 1 + 1 + 1 - 2 = 42.
fn probe() -> Int {
  let f = Future::pending()
  let resolver = (v: Int) -> Unit {
    Future::resolve(f, v)
  }
  resolver(40)
  let p = Path::resolve("/tmp")
  let abs_one = () -> Int {
    if Path::is_absolute(p) {
      1
    } else {
      0
    }
  }
  let nonempty_one = () -> Int {
    if String::length(Path::to_string(p)) > 0 {
      1
    } else {
      0
    }
  }
  // #1348: the resolve/ref calls themselves inside a closure.
  let resolved_one = () -> Int {
    if Path::is_absolute(Path::resolve("rel")) {
      1
    } else {
      0
    }
  }
  let ref_one = () -> Int {
    if Path::is_absolute(Path::ref("/abs")) {
      1
    } else {
      0
    }
  }
  // The top-level shape that registering the two names used to break.
  let top_two = if Path::is_absolute(Path::resolve("rel")) {
    2
  } else {
    0
  }
  Array::get(f, 1) + abs_one() + nonempty_one() + resolved_one() + ref_one() - top_two
}

test "inline-lowered builtins are never captured by a closure" {
  // A miscompile here is not an assertion failure: the module either fails to
  // instantiate ("invalid signature index") or traps ("null function or
  // function signature mismatch") before this line is reached.
  assert(eq(probe(), 42))
}
