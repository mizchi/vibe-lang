// #3551: a `derive (Hash)` type with a `Map` field. The derived key rendered
// the map with `__to_string`, which prints its address, so two equal,
// separately built maps gave two keys (`3:236` and `3:272`). The derive is
// refused, naming the edit.

struct S {
  m: Map[String, Int]
} derive (Hash)

export let _start: () -> Int = () -> {
  0
}
