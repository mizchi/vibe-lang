//# Misc

test "and short circuit" {
  // false && expr should not evaluate expr
  let mut count = 0
  let inc: () -> Bool = () -> {
    count += 1
    true
  }
  let _ = false && inc()
  assert(count == 0)
}

test "or short circuit" {
  // true || expr should not evaluate expr
  let mut count = 0
  let inc: () -> Bool = () -> {
    count += 1
    false
  }
  let _ = true || inc()
  assert(count == 0)
}

test "and evaluates both when first is true" {
  let mut count = 0
  let inc: () -> Bool = () -> {
    count += 1
    true
  }
  let _ = true && inc()
  assert(count == 1)
}

test "or evaluates both when first is false" {
  let mut count = 0
  let inc: () -> Bool = () -> {
    count += 1
    true
  }
  let _ = false || inc()
  assert(count == 1)
}

test "chained and" {
  assert(true && true && true)
  assert(not(true && true && false))
  assert(not(false && true && true))
}

test "chained or" {
  assert(true || false || false)
  assert(false || false || true)
  assert(not(false || false || false))
}

test "mixed and/or" {
  assert(true && true || false)
  assert(false || true && true)
  assert(not(false && true || false))
}

test "and/or with comparison" {
  let x = 5
  assert(x > 0 && x < 10)
  assert(x == 5 || x == 6)
  assert(not(x > 10 || x < 0))
}
