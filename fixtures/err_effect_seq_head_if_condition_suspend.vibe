// #1536 boundary: only a direct recognized suspension may be normalized as a
// selection input. This compound binary condition remains fail-closed.
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    if perform Ask::Get(1) > 0 {
      10
    } else {
      20
    }
    0
  } with Ask {
    Get(n) => {
      let k = resume
      k(n)
    }
  }
}
_start()

