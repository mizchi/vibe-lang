// #3105: a dependency's PRIVATE types with impls of method-bearing traits.
//
// The merge renames a private type to `Pt_dep_<path>`. Its qualified methods
// used to be renamed as a whole (`Pt::measure_dep_<path>`), a spelling no
// method lookup asks for: a `[T: Measured]` dictionary failed the build with
// "add a body for `measure` to `impl Measured for Pt_dep_...`", a direct
// `Pt::measure(p)` reached codegen unresolved, and UFCS `p.sum()` answered
// "unknown struct field". Each export below exercises one of those routes.

import ./private_type_impl_import_dep.vibe {
  described, direct_struct, measured_enum, measured_struct
}

test "private struct through a trait dictionary" {
  inspect(measured_struct(), "70")
}

test "private struct: qualified call and UFCS" {
  inspect(direct_struct(), "777")
}

test "private enum through a dictionary and directly" {
  inspect(measured_enum(), "77")
}

test "trait with several methods at private types" {
  inspect(described(), "rect:10/4 square:9/4 pt:12/0")
}
