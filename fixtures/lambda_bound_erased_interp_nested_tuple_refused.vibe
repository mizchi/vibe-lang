//# #2745: a NESTED aggregate, taken apart by a nested pattern.
//
// Codex, P1 round 11 on #2761. Measured: `{ let p = ((a, 1), 2);
// match p { ((b, _), _) => b } }` with `a: T` printed `252`.
//
// Every named-aggregate route paired each element against `EUnit`, and the
// comment on the tuple route called that deliberate -- "this route carries a
// classification, not an expression to descend into". It was not deliberate, it
// was the depth axis left open: only a `PBind` sub-pattern could take the
// recorded classification, so a nested `PTuple` blanked and the outer levels
// answered correctly about an inner level they had thrown away.
//
// The fix gives each slot a synthetic NAME (`p$0`) and pairs the sub-pattern
// against `EIdent(p$0)`, so the recursive call lands back in the same arm. A
// slot's records are spelled exactly like a binding's, which is why one change
// closes all three routes and the alias copy at once rather than adding an arm
// per depth.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = ((a, 1), 2)
    match p {
      ((b, _), _) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
