// throw string → catch → verify string is preserved
let safe = () -> String with Error {
  throw("hello_error")
  "unreachable"
}

let result = handle {
  safe()
} with Error {
  Throw(msg) => msg
}

// If string is preserved, result should be "hello_error" (length 11)
String::length(result)

