// #3327: a subtrait of the PRELUDE's marker `Ord` is judged as `Ord`.
//
// `[T: Ord]` at `Token` is refused (fixtures/err_type_ord_marker_bound_struct.vibe),
// but `trait Ordered: Ord {}` read as an unrelated name. Measured on main at
// 5f4de5023, `same` below checked clean and answered `false` for two equal
// `Token` -- even though `Token` derives `Eq` -- because `==` under the bound
// lowered to the builtin comparison.

trait Ordered: Ord {}

struct Token {
  value: Int
} derive (Eq)

impl Ord for Token {}

impl Ordered for Token {}

fn same[T: Ordered](a: T, b: T) -> Bool {
  a == b
}

fn main() -> Unit allows Console {
  println(__to_string(same(Token::{ value: 1 }, Token::{ value: 1 })))
}
