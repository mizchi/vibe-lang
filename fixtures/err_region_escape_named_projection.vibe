struct Slot {
  callback: () -> Array[Int]
}

fn unwrap(slot: Slot) -> () -> Array[Int] {
  slot.callback
}

test "nominal field projection preserves callback provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    unwrap(Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let _ = escaped()
}
