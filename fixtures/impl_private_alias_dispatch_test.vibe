// #3958: an impl keyed through a private type alias still dispatches after
// the linker expands its key (the refusal side is
// fixtures/typecheck/err_impl_overlap_private_alias_siblings.vibe).
import ./_impl_private_alias_dep.vibe {
  crate_weight, imported_tagged_weight, tagged_weight
}

test "an impl through a private alias dispatches its own method" {
  inspect(crate_weight(21), content = "42")
}

test "a private alias over an exported alias expands in its own scope" {
  inspect(tagged_weight(5), content = "10")
}

test "a private alias over an imported alias keeps its body's meaning" {
  inspect(imported_tagged_weight(5), content = "10")
}
