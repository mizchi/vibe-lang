//# #2745: a map LITERAL carrying an erased value.
//
// Codex, P1 on #2761, and the report is that an arm I added one commit earlier
// was DEAD CODE. `parser_expr_core.vibe` converts `Map::new()` and
// `Map::from_pairs([..])` into `EMap` while parsing (#960), so the call form
// the round-26 arm matched can never arrive -- and its comment said it handled
// `Map::from_pairs`, which was simply false.
//
// Measured on `dca9478`: `Map::get(Map::from_pairs([("k", a)]), "k")` printed a
// 3-digit pointer decimal, i.e. the arm was both unreachable and needed.
//
// Second time in this PR an arm of mine shipped unreachable behind a confident
// comment (round 13 put an `Array::get` case behind
// `dtd_name_is_constructor_shaped`, which is true for any name containing
// `::`). Neither was caught by a gate: the refusal fixtures only assert that a
// program fails to compile, and dead code changes nothing about that. Matching
// the node the parser actually produces is the fix and is also what makes the
// comment true.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{Map::get(Map::from_pairs([("k", a)]), "k")}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
