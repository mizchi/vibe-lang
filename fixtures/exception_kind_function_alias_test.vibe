// Codex on #3021: a kind aliased to a FUNCTION type. The payload read from a
// field is typed by the checker as the expanded `(Int) -> Int`, which the
// alias `Callback` resolves to as well, so the exact row holds.
type Callback = (Int) -> Int

struct Holder {
  cb: Callback
}

fn throw_callback(h: Holder) -> Int with Exception[Callback] {
  throw(h.cb)
}

test "a function-type alias kind" {
  let r = handle { throw_callback(Holder::{ cb: (n) -> n * 2 }) } with {
    Exception[Callback]::Throw(f) => f(21)
  }
  inspect(r, content = "42")
}
