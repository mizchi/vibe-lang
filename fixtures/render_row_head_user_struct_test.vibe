// #3066 (Codex on #3081): the checker's render rows ride the typed-`==`
// channel under a reserved head. A user may declare a type named `__render`,
// so the head must not be a spellable identifier: when it was `__render`, the
// `==` rows for this struct were taken for render rows, and two equal values
// returned by a local lambda compared by reference and answered `false`.
struct __render[T] {
  v: T
}

test "a user struct named __render compares by content" {
  let mk = (n: Int) -> __render::{ v: n }
  let a = mk(1)
  let b = mk(1)
  inspect(a == b, "true")
}
