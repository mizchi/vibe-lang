trait Callable {
  call_it(Self) -> Int
}
impl Callable for (x: Int, y~: String) -> Int {
  call_it = (f) -> Int { f(0, y="hello") }
}
impl Callable for (x: Int, z~: String) -> Int {
  call_it = (f) -> Int { f(0, z="world") }
}
let f = (x: Int, y~: String) -> Int { x }
let g = (x: Int, z~: String) -> Int { x }
Callable::call_it(f) + Callable::call_it(g)

