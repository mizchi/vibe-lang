// #4065: the closure stored into an array inside the argument that reads it back: the argument is a block that
// pushes and then reads the pushed element. That read hands the closure
// at its evidence arity to a row-free parameter, which is refused at build
// time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    apply(f = {
      Array::push(xs, value = g)
      Array::get(xs, at = 1)
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
