// Config effect: dependency injection pattern
effect Config {
  GetHost -> String;
  GetPort -> Int;
  GetDebug -> Bool
}

let connect_url = handle {
  let host = perform Config::GetHost
  let port = perform Config::GetPort
  let debug = perform Config::GetDebug
  let base = String::concat(host, String::concat(":", __to_string(port)))
  if debug {
    String::concat(base, "?debug=1")
  } else {
    base
  }
} with {
  Config::GetHost => resume("localhost");
  Config::GetPort => resume(8080);
  Config::GetDebug => resume(true)
}
// "localhost:8080?debug=1" → length 22
String::length(connect_url)

__DATA__
{"last": "22"}
