import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

struct Payload { A: Int }

effect Logger {
  A(Payload) -> Int
}

fn handle_field() -> Int {
  handle {
    1
  } with { Logger::A(Payload::{ A }) => resume(7) }
}

test "a struct payload field does not compete with a private enum pattern" {
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
