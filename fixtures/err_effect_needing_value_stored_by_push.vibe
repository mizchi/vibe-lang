// #4065: the closure stored into an array by `Array::push`, then read back.
// The push leaves the array holding the closure at its evidence arity, so
// handing the element to a row-free parameter is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    Array::push(xs, value = g)
    apply(f = Array::get(xs, at = 1))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
