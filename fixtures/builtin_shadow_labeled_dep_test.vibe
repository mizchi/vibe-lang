import ./modules/builtin_shadow_labeled_dep.vibe {
  doubled, filled, first
}

// #3816: the importer's own functions of four builtin spellings. The
// dependency's labeled calls still mean the builtins (#3185), and each keeps
// the argument placement the checker gave it. Before the fix the build failed
// with "missing or invalid checker argument placement for Array::get".

fn Array::get(_ xs: Array[Int], i: Int) -> Int {
  let _ = xs
  let _ = i
  77
}

fn Array::push(a: Int, b: Int) -> Int {
  a - b
}

fn Array::set(a: Int, b: Int, c: Int) -> Int {
  a - b - c
}

fn Array::map(_ xs: Array[Int], f: (Int) -> Int) -> Array[Int] {
  let _ = xs
  let _ = f
  [42]
}

test "a dependency's labeled builtin calls answer the builtins" {
  inspect(first([5, 6]), content = "5")
  inspect(filled(), content = "13")
  inspect(doubled([1, 2, 3]), content = "[2, 4, 6]")
}

test "the program's own functions answer the calls this file wrote" {
  inspect(Array::get([5, 6], i = 0), content = "77")
  inspect(Array::push(a = 7, b = 20), content = "-13")
  inspect(Array::set(a = 7, b = 20, c = 3), content = "-16")
  inspect(Array::length(Array::map([1, 2, 3], f = (x: Int) -> Int {
    x + 1
  })), content = "1")
}
