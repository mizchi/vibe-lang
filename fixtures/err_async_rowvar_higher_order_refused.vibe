/// #2065 wall 1 (ADR-0076 追記34): a HIGHER-ORDER row-variable callee whose
/// function-typed argument the evidence pass cannot read must stay REFUSED.
///
/// `via` takes a function-typed parameter, so an argument carrying `Async` in
/// its own row would instantiate `e` to `Async` at the call site, and the
/// perform would then happen inside `via`, where the boundary handler cannot
/// see it. The call-site argument-inertness rule (queries.vibe,
/// `edp_argcond_admits`) admits such a call only when every function-typed
/// argument is a closure LITERAL that cannot perform the effect -- that twin
/// is fixtures/async_higher_order_rowvar_literal_boundary_test.vibe, which
/// answers 42. Here the argument is a NAMED function: its row is not
/// readable at the call site, so the rule fails closed.
fn takes_async_fn[T](f: () -> T with Async) -> Int {
  0
}

fn via[T, e](x: T, g: (T) -> T) -> T with e {
  g(x)
}

fn ident(y: Int) -> Int {
  y
}

fn main() -> Int allows Async {
  sleep(1)
  via(42, ident)
}
