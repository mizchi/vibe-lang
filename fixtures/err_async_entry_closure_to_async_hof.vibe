// #3534 review (Codex): an `Async` closure handed to a parameter whose
// function type carries `Async`, of a function that propagates it
// (`apply`'s own row names `Async`), suspends on behalf of the caller. The
// entry-boundary scan skipped every such argument as if `apply` discharged it
// the way `TaskGroup::spawn_suspend` does. The suspend lowering cannot carry a
// suspension through `apply`'s call of `f`, so the program is refused at
// build time -- never compiled to a suspension nothing handles. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent/experimental {
  sleep_wait
}

fn apply(f: () -> Int with Async) -> Int with Async {
  f()
}

fn main() -> Int allows Async {
  apply(() -> {
    sleep_wait(1)
    5
  })
}
