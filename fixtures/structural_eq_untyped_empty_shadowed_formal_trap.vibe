//# Codex round 8 on #2456: an enum formal may SHADOW a declared type. The
//# #2141 guard rejects a same-file struct or enum of the formal's spelling,
//# but not a type alias: with `type T = Array[Int]` in scope, the payload of
//# `enum Wrap[T] { W(T) }` is still the formal, and the derived
//# `Wrap::equals` compares it with the raw word `==` (reference equality for
//# an array). The payload-safety check therefore rejects a payload that
//# mentions one of the declaration's own formals BEFORE consulting the
//# allow-list, where the same spelling names a content-comparable type.
//# Measured on the stage2 at 5470e99: this program returned normally with
//# `false` for two content-equal, separately allocated arrays. It must TRAP.

type T = Array[Int]

enum Wrap[T] {
  W(T);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
