// ADR-0076 Phase 3a/3b (#817): performs of the handled effect must sit
// directly on the handle body's let/seq/tail/branch-tail spine when an
// arm captures `resume` as a value.
//
// #1230 made a PLAIN `while` + `let mut` spine eligible (the loop becomes a
// recursive step-returning closure -- see effect_resume_store_loop.vibe).
// #1536 added the escape continuation that `break` / `continue` need, so
// this file -- which used to pin their REJECTION -- now pins the accepted
// behaviour instead: the arm stores `resume` and returns `0 - t` without
// resuming, so the very first perform escapes the loop with the arm's value
// (t == 0) and the `break` is never reached. `return` in a loop body is
// still rejected; err_effect_loop_return_suspend.vibe is that guardrail.
effect Async {
  Suspend(Int) -> Int
}

let sunk: Array[(Int) -> Int] = []

let _start = () -> Int {
  handle {
    let mut i = 0
    while i < 3 {
      let v = perform Async::Suspend(i)
      if v > 100 {
        break
      } else {
        ()
      }
      i = i + 1
    }
    i
  } with {
    Async::Suspend(t) => {
      Array::push(sunk, resume)
      0 - t
    }
  }
}
test "effect resume store loop break" {
  inspect(_start(), "0")
}
