enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Point
}
let area = (s: Shape) -> Int {
  match s {
    Circle(r) if r > 0 => r * r,
    Rect(w, h) if w > 0 && h > 0 => w * h,
    Circle(_) | Rect(_, _) | Point => 0
  }
}
let r1 = area(Circle(5))
let r2 = area(Rect(3, 4))
let r3 = area(Circle(0))
let r4 = area(Point)
r1 + r2 + r3 + r4

