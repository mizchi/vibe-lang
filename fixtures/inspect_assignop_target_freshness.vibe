// The inspect lowering's first temporary candidate occurs only as a compound-
// assignment target inside the value argument AST. Its freshness scan must see
// the target rather than the operator and mint a different temporary.
test "inspect temporary stays fresh against an EAssignOp target" {
  inspect((() -> Int {
    let mut __vibe_inspect_actual = 1
    __vibe_inspect_actual += 2
    __vibe_inspect_actual
  })(), "3")
}
