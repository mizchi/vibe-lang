//# #2745: a local generic lambda returning a TUPLE of its formal.
//
// Codex, P1 round 21 on #2761. Measured on `b1c3a60`:
// `let pack = [U](u: U) -> (U, Int) { (u, 0) }` then
// `{ let p = pack(a); p.0 }` printed a 3-digit pointer decimal.
//
// Round 17 handled `-> Array[U]` and wrote that a deeper shape "would need a
// type language here, and this pass has none". A tuple needs only which
// POSITIONS carry the formal, which is three numbers -- so that claim was
// wider than the fact, and this is the second time in this PR that a boundary
// I declared turned out to be one I had chosen rather than one the pass
// imposed.
//
// The binding records an ordinary tuple, so `p.0` and a destructuring pattern
// both answer through machinery that already exists. Positions the formal does
// not occupy stay blank -- `tuple_ret_other_slot` in the green control reads
// `p.1` and renders `6`, which is what fails if this over-refuses.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let pack = [U](u: U) -> (U, Int) {
      (u, 0)
    }
    "\{ { let p = pack(a)
    p.0 } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
