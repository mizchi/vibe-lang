trait Measured {
  measure(Self) -> Int
}

type Vec[T] = Array[T]

impl Measured for Vec[Int] {
  measure(_self: Vec[Int]) -> Int {
    23
  }
}

fn measure[T: Measured](value: T) -> Int {
  T::measure(value)
}

test "transparent aliases share specialized impl owners" {
  assert_eq(measure([1]), 23)
}
