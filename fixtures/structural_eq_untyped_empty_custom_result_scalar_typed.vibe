//# #2467: this used to TRAP (the generic-enum fail-closed rule of #2456,
//# rounds 5-7 -- the derived comparator read the formal-typed payload through
//# the erased `==`, where `64 << 32` and `65 << 32` compared EQUAL). A concrete
//# instantiation now takes a comparator specialized with its arguments, like a
//# generic struct (#2195), so the `Int` payload compares exactly: equal values
//# answer `true`, the two words above answer `false`.
//# Shape from the #2456 review rounds.

enum Result[T, E] {
  Success(T);
  Failure(E)
}

fn fill(xs: Array[Result[Int, String]], v: Int) -> Unit {
  Array::push(xs, Success(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  assert(left == right)
  assert(left != other)
  0
}
