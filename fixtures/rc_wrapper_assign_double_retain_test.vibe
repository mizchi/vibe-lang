// #2760 RC leak guard: a wrapper that binds the borrow's OWN SOURCE.
//
// The retain #2760 adds for a wrapped borrow must not fire when the spine
// itself binds what the borrow comes from. `x = { let ys = [..];
// Array::get(ys, 0) }` is already promoted by the inner `ELet` lowering, which
// retains the escaping element before dropping `ys` (keyed on
// `scope_tail_proj_root(body) == n`). Retaining it a second time gives the slot
// two references while its drop spends one, so every assignment leaks the
// element permanently.
//
// Found in review on #2783, not by a gate -- the answer stays CORRECT, so only
// a heap bound can see it. Measured on `6507c60` at N=20000:
//
//   | compiler                              | heap_used   |
//   |---------------------------------------|------------:|
//   | unpatched                             |       164 B |
//   | #2760 classifying from the leaf callee | 1,600,084 B |
//   | with the source test (this tree)       |       164 B |
//
// 80 B per iteration, so it SCALES -- the middle row is 20000 x 80 plus the
// steady state, and the bound below separates it by four orders of magnitude.
//
// The discriminating fact is whether the binder the borrow's root names
// ACQUIRED AN OWNED REFERENCE -- not merely whether the spine bound that name,
// which is what the first version of this guard tested. `ys` here is bound to
// an array literal, so `classify_let_value_heap` gives it `rc_kind = 2` and the
// inner lowering promotes; `xs` in the issue's own repro is a parameter, so
// nothing promoted and the retain is still required.
//
// A THIRD case sits between them and is why the name alone will not do: a
// binder that is itself a borrow (`let ys = Array::get(xss, 0)`) stays at
// `rc_kind == 0`, gets no scope-end drop, and promotes nothing -- so declining
// there frees a reference the container still owns. Measured at 850 against the
// bump lane's 770; it is asserted by value in
// `rc_wrapper_assign_borrow_test.vibe` (`assign_borrow_bound_binder`), because
// that error shows up as a wrong answer and not as a leak.
//
// The two directions are opposite errors and each needs its own lane: this file
// bounds the leak, `rc_wrapper_assign_borrow_test.vibe` and
// `rc_wrapper_assign_self_borrow_test.vibe` assert the values. Both files carry
// BOTH leaf kinds since #2796 -- the call and the projection are answered by
// different arms of `spine_leaf_unowned`, so a lane that holds only one of them
// is a lane the other arm can walk past.
//
// `main` returns 0 after checking each shape's result. The #2803 cases keep
// their answers with a leak too, so they also need the heap bound. At N=20000,
// this full fixture uses 8,000,328 B on 17874c5d8 and 408 B with the fix; at
// N=40000 those are 16,000,328 B and 408 B.
enum Node {
  Leaf(Int);
  Pair(Node, Node)
}

struct Holder {
  node: Node
}

fn total(n: Node) -> Int {
  match n {
    Pair(a, b) => total(a) + total(b),
    Leaf(v) => v
  }
}

fn once() -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let ys = [Pair(Leaf(3), Leaf(4))]
    Array::get(ys, 0)
  }
  0
}

// The same shape with a PROJECTION leaf instead of a borrow-returning call.
// `spine_leaf_unowned` answers these in two separate arms, so a suppression
// correct in one is not thereby correct in the other -- #2796 was exactly that,
// the arms disagreeing, and this row is the leak side of the arm it fixed.
// Without a shape here, the projection arm had a value lane and no leak lane,
// which is the asymmetry that let #2760 ship its leak in the first place.
//
// PROVEN ABLE TO FAIL (#2248), not merely observed to pass: built a stage2 with
// the `EDot` arm's guard deleted, so it retains unconditionally and the owning
// projection is retained twice. Measured on that compiler, N=20000:
//
//   | compiler                          | heap_used   |
//   |-----------------------------------|------------:|
//   | this tree                         |       188 B |
//   | EDot guard deleted (always retain)| 1,600,108 B |
//
// 80 B per iteration, the same rate as the call shape above, and four orders of
// magnitude clear of the row's 2000 B bound.
fn once_proj() -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let h = Holder::{ node: Pair(Leaf(3), Leaf(4)) }
    h.node
  }
  0
}

// #2786/#2799: a self-mentioning wrapper whose leaf reads out of ANOTHER
// container. This shape bounds the RELEASE half of #2786's fix, and what it
// guards is not what #2799 claimed when it added it.
//
// #2799 read the 244 B here as "the slot already has its reference, so the
// assignment arm must not retain". Measured on `b7cd8c1`, the plan says
// otherwise: `vibe rc-plan` gives this shape `once_owning_self x drop 1` and no
// dup at all, so the slot is released once and acquired never. The heap only
// looked flat because that unbalanced drop was handing `xs`'s own blocks back to
// the allocator at the same rate the overwritten value leaked, and the answer
// stayed 0 because nothing here reads `xs` again.
//
// So the retain IS required, and what this row bounds is that it arrives with
// its counterpart: the slot releases what it held. PROVEN ABLE TO FAIL (#2248),
// on a compiler built with the acquire half and no release:
//
//   | compiler                            | heap_used   |
//   |-------------------------------------|------------:|
//   | this tree                           |       352 B |
//   | acquire without release             | 1,600,164 B |
//
// 80 B per assignment, four orders of magnitude clear of the row's 2000 bound,
// and the same rate as #2760's own leak.
fn once_owning_self(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let t0 = total(x)
    Array::get(xs, t0 - 3)
  }
  0
}

// #2803: the old value must not keep a duplicate planned for a use of the
// replacement. `total` consumes its argument in this fixture: rc-classify
// reports view_ret, NOT borrow_param, and its emitted epilogue drops `n`.
fn once_read_after_store(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let t0 = total(x)
    Array::get(xs, t0 - 3)
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(xs, 0)) * 10 + total(filler) * 0
}

// The replacement is promoted by the wrapper's own local owner. Its new slot
// must keep that reference's owning lifetime rather than classifying it as a
// view merely because the last expression is a borrow.
fn once_read_local_source() -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let before = total(x)
    let ys = [Pair(Leaf(before), Leaf(4))]
    Array::get(ys, 0)
  }
  let filler = Pair(Leaf(7), Leaf(8))
  total(x) * 10 + total(filler)
}

fn once_read_local_projection() -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let before = total(x)
    let h = Holder::{ node: Pair(Leaf(before), Leaf(4)) }
    h.node
  }
  let filler = Pair(Leaf(7), Leaf(8))
  total(x) * 10 + total(filler)
}

export fn main() -> Int {
  let xs = [Pair(Leaf(3), Leaf(4))]
  let mut i = 0
  while i < 20000 {
    let r = once()
    let rp = once_proj()
    let ro = once_owning_self(xs)
    if once_read_after_store(xs) != 770 {
      return 1
    } else {
      ()
    }
    if once_read_local_source() != 85 || once_read_local_projection() != 85 {
      return 2
    } else {
      ()
    }
    i = i + r + rp + ro + 1
  }
  0
}
