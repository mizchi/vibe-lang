// #1973: was fixtures/effect_handle_nested.vibe + __DATA__.last "101".
// Nested effect handlers: inner handler shadows outer for same effect
effect Counter {
  Next -> Int
}

fn handle_nested() -> Int {
  handle {
    let a = perform Counter::Next
    let b = handle {
      perform Counter::Next
    } with Counter {
      Next => resume(100)
    }
    a + b
  } with Counter {
    Next => resume(1)
  }
}

test "inner Counter handler shadows the outer" {
  inspect(handle_nested(), "101")
}
