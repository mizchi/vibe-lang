// #1967: was fixtures/trait_hierarchy_transitive_supertrait_operator.vibe +
// __DATA__.last "true".

trait LocalEq
trait LocalOrd: LocalEq
trait LocalTotalOrd: LocalOrd
impl LocalTotalOrd for Int

fn accepts_eq[T: LocalEq](value: T) -> Bool {
  true
}

fn same[T: LocalTotalOrd](a: T, b: T) -> Bool {
  accepts_eq(a) && accepts_eq(b)
}

test "LocalTotalOrd implies LocalEq transitively" {
  inspect(same(1, 1), "true")
}
