// HTTP handler mock for testing: simulate request/response
effect HttpRequest {
  Method -> String;
  Url -> String;
  Header(String) -> String
}

effect HttpResponse {
  Status(Int) -> Unit;
  Write(String) -> Unit
}

let status = handle {
  handle {
    let method = perform HttpRequest::Method
    let url = perform HttpRequest::Url
    if String::equals(method, "GET") {
      if String::equals(url, "/health") {
        perform HttpResponse::Status(200)
        perform HttpResponse::Write("ok")
        200
      } else {
        perform HttpResponse::Status(404)
        404
      }
    } else {
      perform HttpResponse::Status(405)
      405
    }
  } with {
    HttpRequest::Method => resume("GET");
    HttpRequest::Url => resume("/health");
    HttpRequest::Header(_name) => resume("")
  }
} with {
  HttpResponse::Status(_code) => resume(0);
  HttpResponse::Write(_body) => resume(0)
}
status

__DATA__
{"last": "200"}
