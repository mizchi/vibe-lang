import ./typecheck/callback_row_result_generic_factory_dep_ok.vibe {
  consume_string, effect Box, make
}

test "a named generic factory returns a String callback" {
  assert_eq(consume_string(f = make(x = "abc")), 3)
}

test "an extracted generic factory returns a String callback" {
  assert_eq(consume_string(f = Array::get([make], at = 0)("abc")), 3)
}
