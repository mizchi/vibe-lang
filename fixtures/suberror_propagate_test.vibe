// #1973: was fixtures/suberror_propagate.vibe + __DATA__.last "99".
// Same hoist as suberror_basic_test: `suberror` stays at the top level.

suberror AppError {
  NotFound;
  BadInput(String)
}

fn inner() -> Int with Exception {
  throw(BadInput("oops"))
  0
}

fn outer() -> Int with Exception {
  inner() + 1
}

test "suberror throw from inner is caught by the outer handle" {
  let result = handle {
    outer()
  } with Exception {
    Throw(_) => 99
  }
  inspect(result, "99")
}
