// #3571: two imported modules each write a PRIVATE `fn Int::shout`. A
// type-qualified function keeps its spelling through the merge, so the linked
// program held two `Int::shout` and the build kept whichever module the import
// order merged first -- this printed `from-a from-a`, and `from-b from-b` with
// the imports swapped, with no diagnostic. It is refused, naming both
// definitions and the edit.

import ./modules/qualified_fn_overlap_a.vibe {
  a_name
}

import ./modules/qualified_fn_overlap_b.vibe {
  b_name
}

test "both modules keep their own qualified function" {
  inspect("\{a_name()} \{b_name()}", content = "from-a from-b")
}
