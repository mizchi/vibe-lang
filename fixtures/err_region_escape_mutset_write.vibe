struct MutSet[T] {
  mut marker: Int
}

fn MutSet::add[T](s: MutSet[T], x: T) -> Unit {
  ()
}

test "MutSet cannot retain region closures" {
  let outer: MutSet[() -> Array[Int]] = MutSet::{
    marker: 0
  }
  let _ = region r {
    let values = MutList::empty(r)
    MutSet::add(outer, () -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
}
