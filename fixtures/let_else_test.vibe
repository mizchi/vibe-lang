// #760(1): let-else. `let PAT = e else { alt }` binds PAT on a successful
// match and runs the `alt` fallback otherwise. It desugars to
//   match e { PAT => <rest-of-block>, _ => alt }
// so `alt` must DIVERGE (return / throw) — its arm unifies with the
// continuation's type. (The old host-era "fall through with the else value"
// shape is intentionally not supported; use an explicit match for that.)
// See lib/@vibe/parser/parser_expr_dispatch.vibe.

let unwrap_or_return: (Option[Int]) -> Int = (opt) -> {
  let Some(v) = opt else { return -1 }
  v + 100
}

// Nested pattern in the bind position.
let sum_pair_or_return: (Option[(Int, Int)]) -> Int = (opt) -> {
  let Some((a, b)) = opt else { return -1 }
  a + b
}

// else that throws instead of returning.
let unwrap_or_throw: (Option[Int]) -> Int with { Error } = (opt) -> {
  let Some(v) = opt else { throw("none") }
  v
}

test "let-else binds on Some" {
  assert_eq(unwrap_or_return(Some(5)), 105)
}

test "let-else diverges on None via return" {
  assert_eq(unwrap_or_return(None), -1)
}

test "let-else with nested tuple pattern" {
  assert_eq(sum_pair_or_return(Some((3, 4))), 7)
  assert_eq(sum_pair_or_return(None), -1)
}

test "let-else else-branch throws" {
  let got = handle {
    unwrap_or_throw(None)
  } with Error {
    Throw(_) => -99
  }
  assert_eq(got, -99)
  assert_eq(unwrap_or_throw(Some(7)), 7)
}

// A plain destructuring let (no else) must be unaffected by the new path.
test "plain pattern-let still works" {
  let (a, b) = (11, 22)
  assert_eq(a + b, 33)
  let Some(v) = Some(5)
  assert_eq(v, 5)
}
