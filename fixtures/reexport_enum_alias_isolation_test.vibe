import ./import_kind_phase1/reexport_value.vibe { answer }
import ./import_kind_phase1/local_public_choice.vibe { PublicChoice }

test "a re-export alias does not rename another module's enum" {
  inspect(answer, content = "42")
  inspect(match PublicChoice::Local {
    PublicChoice::Local => "local"
  }, content = "local")
}
