// Writer effect with CPS accumulate
effect IntWriter {
  Tell(Int) -> Unit
}

effect StrWriter {
  Tell(String) -> Unit
}

// Sum emitted Ints: 10 + 20 + 30 + 0 = 60
let int_sum = handle {
  perform IntWriter::Tell(10)
  perform IntWriter::Tell(20)
  perform IntWriter::Tell(30)
  0
} { IntWriter::Tell(v, k) => v + k(0) }

// Count emitted Strings: 1 + 1 + 1 + 0 = 3
let str_count = handle {
  perform StrWriter::Tell("a")
  perform StrWriter::Tell("b")
  perform StrWriter::Tell("c")
  0
} { StrWriter::Tell(_s, k) => 1 + k(0) }

int_sum + str_count

__DATA__
{"last": "63"}
