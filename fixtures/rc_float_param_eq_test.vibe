// RC lane boxes floats, so `a == b` on FLOAT-TYPED PARAMS must take the
// unbox + f64.eq path. Params were never seeded into float_local_slots (only
// `let`-bound floats were), so a signature- or inline-annotated float param
// fell into the scalar i64 compare — under RC that compared two box POINTERS
// and `1.5 == 1.5` came out false. `vibe test` compiles with the production
// default (RC), so these assertions exercise the boxed path.

let leq_sig: (Float, Float) -> Bool = (a, b) -> {
  a == b
}

let leq_inline = (a: Float, b: Float) -> Bool {
  a == b
}

test "float param == (signature annotation)" {
  assert(leq_sig(1.5, 1.5))
  assert(!(leq_sig(0.3, 0.4)))
}

test "float param == (inline annotation)" {
  assert(leq_inline(2.5, 2.5))
  assert(!(leq_inline(2.5, 2.75)))
}
