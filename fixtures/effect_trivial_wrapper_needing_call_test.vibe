// #1973: was fixtures/effect_trivial_wrapper_needing_call.vibe + __DATA__.last "142".
// #1385 companion: the same defect reached the way a user actually writes
// it, without ever typing an IIFE.
//
// `apply0`'s body is EXACTLY a same-arity direct call to its sole parameter,
// so dtpw_inline_trivial_wrappers (#1070) reduces `apply0(lit)` to `(lit)()`
// -- and the anonymous IIFE is what the evidence pass then refused. The
// one-argument spelling (`apply1(f) { f(1) }`, fixtures/
// effect_needing_call_in_row_slot_test.vibe) is not a same-arity forward, so it
// is left alone and always worked: that arity asymmetry is the whole reason
// this looked like a zero-argument planning gap rather than an IIFE gap.
//
// Suspend(1) -> resume(42) -> 42 + 100.
effect Async {
  Suspend(Int) -> Int
}

fn bump0() -> Int with Async {
  let w = perform Async::Suspend(1)
  w + 100
}

fn apply0(f: () -> Int with Async) -> Int with Async {
  f()
}

fn trivial_wrapper_needing_call() -> Int {
  handle {
    apply0(() -> Int with Async {
      bump0()
    })
  } with {
    Async::Suspend(t) => resume(t + 41)
  }
}

test "trivial wrapper needing call resumes to 142" {
  inspect(trivial_wrapper_needing_call(), "142")
}
