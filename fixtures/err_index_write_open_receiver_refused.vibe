// #3139: an index WRITE whose receiver's type never resolves is REFUSED at
// build time. `xs[i] = v` is `Array::set(xs, i, v)`; `c` below is the
// unannotated parameter of a let-bound lambda, which is generalised, so its
// one body serves every caller -- and handed a Map, the write lands in the
// map's backing store positionally (`Array::set: index 0 out of bounds`, or a
// silently corrupted map). The edit is an annotation, or `Map::set` for a Map.

export let _start: () -> Int = () -> {
  let put = (c, i: Int, v: Int) -> {
    c[i] = v
  }
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  put(m, 0, 99)
  Map::get(m, "a")
}
