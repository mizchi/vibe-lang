//# #2745: a let initializer gets the same walk as the body.
//
// Codex, P1 round 4 on #2761. `dtd_interp_bind_local` typed the initializer with
// a bare `infer_arg_type_name`, which answers None for every compound -- so
// `{ let b = if true { a } else { a }; b }` recorded `b` as unknown and the
// refusal declined. Measured: printed `260`.
//
// The two halves of this check now read the same language: the initializer is
// asked of the walker first, and only falls back to `infer_arg_type_name` for the
// leaf forms the walker hands over.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let b = if true { a } else { a }; b } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
