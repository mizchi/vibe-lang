// The callback's type is deliberately absent: a checked row-free function
// parameter is visible to lowering, while this inferred parameter is opaque.
effect Ask { Get() -> Int }

fn ask_once() -> Int with Ask { perform Ask::Get() }
fn pure() -> Int { 7 }

fn run() -> Int with Ask {
  handle {
    let mut f = ask_once
    let cb = (f~) -> Int { f() }
    let _ = cb(f = pure)
    perform Ask::Get()
  } with { Ask::Get() => resume(1) }
}

export fn main() -> Int {
  handle { run() } with { Ask::Get() => resume(2) }
}
