// #729 (ADR-0063 Phase C): end-to-end contract package import. The bare
// directory import resolves to ./contract_pkg/index.vpkg, which the loader
// conformance-checks against ./contract_pkg/impl.vibe and desugars to a
// facade — so this file compiles through the ordinary #716 merge machinery.
// Point is a transparent contract-defined type (constructible here);
// Counter is opaque (held and passed, produced/consumed via the fns).

import ./contract_pkg {
  add, answer, clamp, counter_get, counter_new, point_sum, scale, struct Counter, struct Point
}

test "contract package resolves and its surface works (#729)" {
  assert_eq(add(40, 2), 42)
  assert_eq(scale(k = 6, v = 7), 42)
  assert_eq(clamp(99, 0, 42), 42)
}

test "transparent and opaque contract types (#729 C-4)" {
  let p = Point::{ x: 40, y: 2 }
  assert_eq(point_sum(p), 42)
  let c = counter_new(41)
  assert_eq(counter_get(c) + 1, 42)
}

test "contract value declaration (#752)" {
  // `let answer: Int` in the contract, `export let answer: Int = 42` in the
  // implementation — values ride the same decl/facade machinery as fns.
  assert_eq(answer, 42)
}
