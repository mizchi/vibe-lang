// #729 (ADR-0063 Phase C-2): end-to-end contract package import. The bare
// directory import resolves to ./contract_pkg/index.vibei, which the loader
// conformance-checks against ./contract_pkg/impl.vibe and desugars to a
// facade — so this file compiles through the ordinary #716 merge machinery.

import ./contract_pkg { add, scale, clamp }

test "contract package resolves and its surface works (#729)" {
  assert_eq(add(40, 2), 42)
  assert_eq(scale(k=6, v=7), 42)
  assert_eq(clamp(99, 0, 42), 42)
}
