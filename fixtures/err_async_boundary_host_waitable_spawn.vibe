// #2065: an `Async` entry that settles a HOST future and also spawns a
// suspend-class task is refused, with a message that names both ways out.
//
// A sleep-only boundary admits the same shape
// (`async_boundary_spawn_suspend_test.vibe`). A host future is different: a
// spawned task that awaits it would have to park on a host waitable, which is
// ADR-0089 D2's third park kind and is not built. Compiling it anyway would
// block the whole scheduler on one task, so the program is refused rather
// than miscompiled.
//
// This is the let-bound position; `err_async_boundary_mixed_operand.vibe` has
// the operand position.
fn spawn_suspend(x: Int) -> Int {
  x
}

fn main() -> Int allows Async {
  let _fut = host_future_named("price")
  let h = spawn_suspend(41)
  h + 1
}
