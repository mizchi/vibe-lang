// #2065 / #1537: an `Async` entry that settles a HOST STREAM and also spawns a
// suspend-class task is refused, with a message that names both ways out.
//
// A host FUTURE beside such tasks now compiles: a task awaiting it parks on the
// future's handle and the group waits on all of them at once
// (fixtures/async_spawn_host_futures/main.vibe). A stream read is not yet a
// parkable waitable in the group's set, so compiling this anyway would block
// the whole scheduler on one task's read; the program is refused rather than
// miscompiled.
//
// This is the let-bound position; `err_async_boundary_mixed_operand.vibe` has
// the operand position.
fn spawn_suspend(x: Int) -> Int {
  x
}

fn main() -> Int allows Async {
  let _body = host_stream_named("body")
  let h = spawn_suspend(41)
  h + 1
}
