enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

test "enum with methods" {
  let area = (s: Shape) -> Int {
    match s {
      Circle(r) => r * r * 3,
      Rect(w, h) => w * h
    }
  }
  let perimeter = (s: Shape) -> Int {
    match s {
      Circle(r) => r * 2 * 3,
      Rect(w, h) => (w + h) * 2
    }
  }
  inspect(area(Circle(5)) + perimeter(Rect(3, 4)), "89")
}
