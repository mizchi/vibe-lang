// @vibe/core (ADR-0063): the standard core library as a contract package.
// A bare directory import resolves ../lib/@vibe/core/index.vibei, which is
// conformance-checked against its impl files and desugared to a facade.

import ../lib/@vibe/core { sha1, encode_uleb128, read_uleb128, list_of3, list_length, list_map, list_sum, from_array, contains, type List, type StringSet, BigInt::from_int, BigInt::pow, BigInt::to_string, Rational::parse, Rational::to_string, type BigInt, type Rational }

test "@vibe/core sha1 known vector" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "@vibe/core leb128 roundtrip" {
  let b = encode_uleb128(624485)
  let (v, _) = read_uleb128(b, 0)
  assert_eq(v, 624485)
}

test "@vibe/core list ops" {
  let xs = list_of3(1, 2, 3)
  assert_eq(list_length(xs), 3)
  assert_eq(list_sum(list_map((x: Int) -> Int { x * 10 }, xs)), 60)
}

test "@vibe/core string set" {
  let s = from_array(["a", "b"])
  assert(contains(s, "a"))
  assert(!contains(s, "z"))
}

test "@vibe/core bigint" {
  let p64 = BigInt::pow(BigInt::from_int(2), 64)
  assert(BigInt::to_string(p64) == "18446744073709551616")
}

test "@vibe/core rational" {
  match Rational::parse("2/4") {
    Some(r) => assert(Rational::to_string(r) == "1/2"),
    None => assert(false)
  }
}
