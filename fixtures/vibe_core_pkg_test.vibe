// @vibe/core (ADR-0063): the standard core library as a contract package.
// A bare directory import resolves ../lib/@vibe/core/index.vibei, which is
// conformance-checked against its impl files and desugared to a facade.

import ../lib/@vibe/core {
  sha1, encode_uleb128, read_uleb128, from_array, contains, type List, type StringSet, BigInt::from_int, BigInt::pow, BigInt::to_string, Rational::parse, Rational::to_string, type BigInt, type Rational, MutMap, MutMap::get, MutMap::new_int, MutMap::set, MutSet, MutSet::add, MutSet::has, MutSet::new_string, MutSortedMap, MutSortedMap::keys, MutSortedMap::new_int as sorted_map_new_int, MutSortedMap::set as sorted_map_set, MutSortedSet, MutSortedSet::add as sorted_set_add, MutSortedSet::new_int as sorted_set_new_int, MutSortedSet::to_array, compare_string, hash_int, assert_false, inspect
}

test "@vibe/core sha1 known vector" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "@vibe/core leb128 roundtrip" {
  let b = encode_uleb128(624485)
  let (v, _) = read_uleb128(b, 0)
  assert_eq(v, 624485)
}

test "@vibe/core list ops" {
  let xs = List::of3(1, 2, 3)
  assert_eq(List::length(xs), 3)
  assert_eq(List::sum(List::map(xs, (x: Int) -> Int {
    x * 10
  })), 60)
}

test "@vibe/core string set" {
  let s = from_array([
    "a",
    "b"
  ])
  assert(contains(s, "a"))
  assert(!contains(s, "z"))
}

test "@vibe/core bigint" {
  let p64 = BigInt::pow(BigInt::from_int(2), 64)
  assert(BigInt::to_string(p64) == "18446744073709551616")
}

test "@vibe/core rational" {
  match Rational::parse("2/4") {
    Some(r) => assert(Rational::to_string(r) == "1/2"),
    None => assert(false)
  }
}

test "@vibe/core collections" {
  let m: MutMap[Int, String] = MutMap::new_int()
  MutMap::set(m, 1, "one")
  match MutMap::get(m, 1) {
    Some(v) => assert_eq(v, "one"),
    None => assert(false)
  }
  let hs: MutSet[String] = MutSet::new_string()
  MutSet::add(hs, "x")
  assert_eq(MutSet::has(hs, "x"), true)
  let sm: MutSortedMap[Int, Int] = sorted_map_new_int()
  sorted_map_set(sm, 2, 20)
  sorted_map_set(sm, 1, 10)
  let ks = MutSortedMap::keys(sm)
  assert_eq(Array::get(ks, 0), 1)
  assert_eq(Array::get(ks, 1), 2)
  let ss: MutSortedSet[Int] = sorted_set_new_int()
  sorted_set_add(ss, 3)
  sorted_set_add(ss, 1)
  let xs = MutSortedSet::to_array(ss)
  assert_eq(Array::get(xs, 0), 1)
  assert_eq(Array::get(xs, 1), 3)
  assert_eq(hash_int(0), 0)
  assert_eq(compare_string("a", "b") < 0, true)
}

test "@vibe/core assert_false / inspect" {
  assert_false(1 == 2)
  inspect(1 + 1, "2")
}
