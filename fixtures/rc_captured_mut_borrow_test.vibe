// #3108 review: a `let mut` that a closure captures is stored in an RC cell,
// and dropping the cell releases its payload. A borrowed initializer --
// `Array::get(xs, i)`, or an if/match whose branch tail is one -- used to be
// stored without a reference of its own, so the cell's drop freed an element
// `xs` still owned: `drop of freed value` under VIBE_RC=shadow, and a trap on
// the default RC lane when `xs` was read again. Measured on the committed seed
// for both shapes below.

enum D {
  A(String, Array[String]);
  B(String)
}

fn name_of(d: D) -> String {
  match d {
    A(n, _) => n,
    B(n) => n
  }
}

fn scan_if(xs: Array[D], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(xs) {
    let mut d = if i % 2 == 0 {
      Array::get(xs, i)
    } else {
      Array::get(xs, i)
    }
    let f = () -> String { name_of(d) }
    Array::push(out, f())
    i = i + 1
  }
}

fn scan_direct(xs: Array[D], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(xs) {
    let mut d = Array::get(xs, i)
    let f = () -> String { name_of(d) }
    Array::push(out, f())
    i = i + 1
  }
}

fn scan_block(xs: Array[D], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(xs) {
    let mut d = {
      let j = i
      Array::get(xs, j)
    }
    let f = () -> String { name_of(d) }
    Array::push(out, f())
    i = i + 1
  }
}

struct Box {
  inner: D
}

fn scan_field(bs: Array[Box], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(bs) {
    let b = Array::get(bs, i)
    let mut d = b.inner
    let f = () -> String { name_of(d) }
    Array::push(out, f())
    i = i + 1
  }
}

fn pick_field(b: Box, first: Bool) -> String {
  let mut d = if first {
    b.inner
  } else {
    b.inner
  }
  let f = () -> String { name_of(d) }
  f()
}

fn pick_arm(b: Box) -> String {
  let mut d = match b {
    Box::{ inner } => inner
  }
  let f = () -> String { name_of(d) }
  f()
}

fn mk() -> Array[D] {
  [A(String::concat("a", "x"), ["p"]), B(String::concat("b", "y")), A(String::concat("c", "z"), [])]
}

test "a captured let mut holding an if/match borrow keeps the element alive" {
  let xs = mk()
  let out: Array[String] = []
  scan_if(xs, out)
  scan_if(xs, out)
  scan_if(xs, out)
  inspect(String::join(out, ","), content = "ax,by,cz,ax,by,cz,ax,by,cz")
}

test "a captured let mut holding a direct borrow keeps the element alive" {
  let xs = mk()
  let out: Array[String] = []
  scan_direct(xs, out)
  scan_direct(xs, out)
  scan_direct(xs, out)
  inspect(String::join(out, ","), content = "ax,by,cz,ax,by,cz,ax,by,cz")
}

test "a captured let mut holding a block that ends in a borrow keeps the element alive" {
  let xs = mk()
  let out: Array[String] = []
  scan_block(xs, out)
  scan_block(xs, out)
  scan_block(xs, out)
  inspect(String::join(out, ","), content = "ax,by,cz,ax,by,cz,ax,by,cz")
}

test "a captured let mut holding a projection keeps the field alive" {
  let bs = [Box::{ inner: A(String::concat("a", "x"), ["p"]) }, Box::{ inner: B(String::concat("b", "y")) }]
  let out: Array[String] = []
  scan_field(bs, out)
  scan_field(bs, out)
  scan_field(bs, out)
  inspect(String::join(out, ","), content = "ax,by,ax,by,ax,by")
}

test "a captured let mut holding a projection from an if arm keeps the field alive" {
  let b = Box::{ inner: A(String::concat("a", "x"), ["p"]) }
  let r1 = pick_field(b, true)
  let r2 = pick_field(b, false)
  let r3 = pick_arm(b)
  inspect(String::join([r1, r2, r3, name_of(b.inner)], ","), content = "ax,ax,ax,ax")
}
