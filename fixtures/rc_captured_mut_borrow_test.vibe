// #3130 review, third round. A `for` at the head of a sequence is lowered
// WITHOUT collecting (compile_forin_loop, collect = false): each body value is
// dropped off the stack unreleased. The for-in body marker retained a cell read
// there on every iteration, and nothing released it, so the cell's payload
// never reached a count of zero. The payload here is allocated per call, so a
// reference it never loses keeps all of it alive. Measured on a stage2 built
// from ffc4ebfa6, 200 / 400 calls after 20 warmup calls: 25600 / 51200 B, and
// 1600 / 3200 B for the control below -- its body produces nothing, and its
// growth is the per-call String the two share, which is never reclaimed.
fn discard_forin_cell(ns: Array[Int]) -> Int {
  let mut d = A(String::concat("q", "q"), ["z"])
  let f = () -> String { name_of(d) }
  let _ = f()
  for x in ns {
    d
  }
  1
}

fn discard_forin_control(ns: Array[Int]) -> Int {
  let mut d = A(String::concat("q", "q"), ["z"])
  let f = () -> String { name_of(d) }
  let _ = f()
  for x in ns {
    0
  }
  1
}

fn discard_forin_run(cell: Bool, ns: Array[Int], n: Int) -> Int {
  let mut r = 0
  let mut acc = 0
  while r < n {
    let x = if cell {
      discard_forin_cell(ns)
    } else {
      discard_forin_control(ns)
    }
    acc = acc + x
    r = r + 1
  }
  acc
}

fn discard_forin_growth(cell: Bool, n: Int) -> Int with Profiler {
  let ns = [1, 2, 3, 4]
  let _ = discard_forin_run(cell, ns, 20)
  let before = Profiler::heap_bytes()
  let _ = discard_forin_run(cell, ns, n)
  Profiler::heap_bytes() - before
}

test "a discarded for-in over a captured cell retains nothing" {
  let cell = discard_forin_growth(true, 400)
  let control = discard_forin_growth(false, 400)
  inspect(cell - control, content = "0")
}

// #3130 review, fourth round. `bx.inner = v` lowers to the internal builtin
// `__set_field`, which stores `v` into the struct. The owning-argument retain
// skipped every `__`-spelled callee, and the `__set_field` lowering stored the
// value with no retain at all, so a captured cell read -- bare, or on an
// if / match / handle tail -- left the struct and the cell sharing one
// reference. Each helper builds its own array and returns the struct, so the
// array's drop at the helper's exit is what frees an element the struct did
// not retain. Measured on a stage2 built from 8db4d114d, the same on the
// default and shadow lanes: all four answered `cz` where `ax` was stored --
// the freed element's block reused by the next allocation.
struct MBox {
  mut inner: D
}

fn set_bare(c: Bool) -> MBox {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let bx = MBox::{ inner: B("start") }
  bx.inner = d
  bx
}

fn set_if(c: Bool) -> MBox {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let bx = MBox::{ inner: B("start") }
  bx.inner = if c { d } else { B("fresh") }
  bx
}

fn set_match(c: Bool) -> MBox {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let bx = MBox::{ inner: B("start") }
  bx.inner = match c {
    true => d,
    false => B("fresh")
  }
  bx
}

fn set_handle(c: Bool) -> MBox {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let bx = MBox::{ inner: B("start") }
  bx.inner = handle {
    let _ = fail_if(!c)
    d
  } with {
    Exception::Throw(_) => B("fresh")
  }
  bx
}

fn set_names(k: Int, c: Bool) -> String {
  let bx = if k == 0 {
    set_bare(c)
  } else if k == 1 {
    set_if(c)
  } else if k == 2 {
    set_match(c)
  } else {
    set_handle(c)
  }
  let churn = mk()
  String::concat(name_of(bx.inner), names(churn))
}

test "a captured cell stored into a struct field keeps the element alive" {
  inspect(String::join([set_names(0, true), set_names(0, true)], ";"), content = "axax,by,cz;axax,by,cz")
}

test "a captured cell on an if tail stored into a struct field keeps the element alive" {
  inspect(String::join([set_names(1, true), set_names(1, false)], ";"), content = "axax,by,cz;freshax,by,cz")
}

test "a captured cell on a match arm stored into a struct field keeps the element alive" {
  inspect(String::join([set_names(2, true), set_names(2, false)], ";"), content = "axax,by,cz;freshax,by,cz")
}

test "a captured cell on a handle tail stored into a struct field keeps the element alive" {
  inspect(String::join([set_names(3, true), set_names(3, false)], ";"), content = "axax,by,cz;freshax,by,cz")
}

// #3130 review, fifth round. Exits that leave a captured cell's scope: an
// early `return` (bare, if, match-arm block, from a closure), a parameterized
// loop's `break` payload, and a thrown payload. A `return` / `throw` skips the
// cell's scope-end drop, so the cell's own reference is what the receiver
// gets and the operand is deliberately NOT retained (see `rs_map`'s table).
// Measured on a stage2 built from 7241e2386: all seven already answer
// correctly on the default and shadow lanes; these pin that.

fn exit_return_bare(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  if c {
    return d
  }
  B("fresh")
}

fn exit_return_if(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  return if c { d } else { B("fresh") }
}

fn exit_return_match_block(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  return match c {
    true => {
      let k = 1
      d
    },
    false => B("fresh")
  }
}

fn exit_closure_return(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let g = () -> D {
    let _ = f()
    if c {
      return d
    }
    B("fresh")
  }
  g()
}

fn exit_loop_break(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  let r = loop (i = 0) {
    if i >= 2 {
      break if c { d } else { B("fresh") }
    }
    continue(i + 1)
  }
  r
}

fn exit_loop_break_tail(c: Bool) -> D {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  loop (i = 0) {
    if i >= 2 {
      break if c { d } else { B("fresh") }
    }
    continue(i + 1)
  }
}

fn exit_thrower(c: Bool) -> D with Exception[D] {
  let xs = mk()
  let mut d = Array::get(xs, 0)
  let f = () -> String { name_of(d) }
  let _ = f()
  if c {
    throw(d)
  }
  B("fresh")
}

fn exit_throw_payload(c: Bool) -> D {
  handle { exit_thrower(c) } with { Exception[D]::Throw(e) => e }
}

test "an early return of a captured cell hands the element over" {
  let a = exit_return_bare(true)
  let churn = mk()
  let b = exit_return_bare(true)
  let c = exit_return_bare(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}

test "a return of an if over a captured cell hands the element over" {
  let a = exit_return_if(true)
  let churn = mk()
  let b = exit_return_if(true)
  let c = exit_return_if(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}

test "a return of a match arm block over a captured cell hands the element over" {
  let a = exit_return_match_block(true)
