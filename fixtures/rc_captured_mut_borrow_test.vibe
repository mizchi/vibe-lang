test "a thrown payload of a captured cell hands the element over" {
  let a = exit_throw_payload(true)
  let churn = mk()
  let b = exit_throw_payload(true)
  let c = exit_throw_payload(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}
