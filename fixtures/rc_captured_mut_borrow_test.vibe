  let b = exit_return_match_block(true)
  let c = exit_return_match_block(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}

test "an early return from a closure over a captured cell hands the element over" {
  let a = exit_closure_return(true)
  let churn = mk()
  let b = exit_closure_return(true)
  let c = exit_closure_return(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}

test "a loop break payload bound to a let over a captured cell hands the element over" {
  let a = exit_loop_break(true)
  let churn = mk()
  let b = exit_loop_break(true)
  let c = exit_loop_break(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
}

test "a loop break payload as the function tail over a captured cell hands the element over" {
  let a = exit_loop_break_tail(true)
  let churn = mk()
  let b = exit_loop_break_tail(true)
  let c = exit_loop_break_tail(false)
  inspect(String::join([name_of(a), name_of(b), name_of(c), names(churn)], ";"), content = "ax;ax;fresh;ax,by,cz")
