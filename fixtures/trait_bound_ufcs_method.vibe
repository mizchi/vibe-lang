// #931: UFCS method call on a trait-BOUNDED type parameter.
//
// `k.probe_key()` where `k: K` and `[K: Hash]` must dispatch through the same
// threaded witness dictionary as the qualified spelling `K::probe_key(k)`.
// Before the fix the UFCS spelling compiled clean but the call stayed a bare
// EDot, which codegen compiled as a struct-field read — a null-function call
// at runtime (linear backend). Both spellings must agree: 97 * 1000 + 97.
trait Hash {
  probe_key(Self) -> Int
}

struct Point { x: Int; y: Int }

impl Hash for Point {
  probe_key(self) -> Int { self.x * 31 + self.y }
}

let get_qualified = [K: Hash](k: K) -> Int {
  K::probe_key(k)
}

let get_ufcs = [K: Hash](k: K) -> Int {
  k.probe_key()
}

export let main = () -> Int {
  let p = Point::{ x: 3, y: 4 }
  get_qualified(p) * 1000 + get_ufcs(p)
}

// #1571: the expectation lives here, checked by `inspect` and updatable with
// `vibe test --update`, instead of in a `__DATA__` tail the gate has to `sed`
// off and compare in shell.
test "trait bound ufcs method" {
  inspect(main(), "97097")
}
