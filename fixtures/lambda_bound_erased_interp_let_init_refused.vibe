//# #2745: an aggregate built inside a let-valued INITIALIZER.
//
// Codex, P1 round 26 on #2761. Measured on `d4778b8`:
// `{ let p = { let q = (a, 0); q }; p.0 }` printed a 3-digit pointer decimal.
//
// Round 25 gave this recorder the branch wrappers and `ESeq` and stopped there,
// so the body was read in an environment where the initializer's own binding
// does not exist and `q` answered nothing. The binding is now recorded into a
// COPY of the environment -- scoped to the initializer, visible to its body and
// to nothing else -- and the body is read in the scope it actually has.
//
// That is the same sentence as rounds 3, 12 and 25, in the fourth place it was
// missing: a walk that descends into a body must carry the bindings that body
// has.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = {
      let q = (a, 0)
      q
    }
    p.0 } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
