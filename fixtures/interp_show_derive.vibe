// #1392: string interpolation renders a derive(Show) value structurally
// instead of the raw pointer decimal `__to_string` produced for every
// aggregate (measured before the fix: `"\{p}"` -> "208").
//
// The result is an ENCODED int so one expectation pins every case and a
// failure names itself by which digit is missing:
//
//   10000  scalars unchanged (Int / Bool / String)
//    1000  struct via a `let` binding
//     200  enum via a `let` binding
//      30  bare nullary constructor
//       4  annotated parameter
//
// Want 11234.
struct P {
  x: Int;
  y: Int
} derive(Show)

enum E2 {
  A;
  B(Int)
} derive(Show)

fn show_param(v: E2) -> String {
  "\{v}"
}

let _start = () -> Int {
  let scalars = if "\{1}" == "1" && "\{true}" == "true" && "\{"s"}" == "s" {
    10000
  } else {
    0
  }
  let p = P::{ x: 1, y: 2 }
  let st = if "\{p}" == "P { x: 1, y: 2 }" {
    1000
  } else {
    0
  }
  let e = B(3)
  let en = if "\{e}" == "B(3)" {
    200
  } else {
    0
  }
  let ct = if "\{A}" == "A" {
    30
  } else {
    0
  }
  let pm = if show_param(B(9)) == "B(9)" {
    4
  } else {
    0
  }
  scalars + st + en + ct + pm
}
_start()

__DATA__
{"last":"11234"}
