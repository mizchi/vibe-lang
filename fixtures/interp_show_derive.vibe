// #1392: string interpolation renders a value structurally instead of the raw
// pointer decimal `__to_string` produced for every aggregate (measured before
// slice 1: `"\{p}"` -> "208", `"\{Some(1)}"` -> "404").
//
// The result is one decimal per case, `1` = ok, so a partial regression names
// itself by which DIGIT went to zero (least significant first):
//
//    1  scalars unchanged (Int / Bool / String)
//   1e1 struct via a `let` binding                   (slice 1)
//   1e2 enum via a `let` binding                     (slice 1)
//   1e3 bare nullary constructor                     (slice 1)
//   1e4 annotated parameter                          (slice 1)
//   1e5 `Some(<literal>)`                            (slice 2)
//   1e6 bare `None`                                  (slice 2)
//   1e7 `Some(<struct>)` -- slice 2 recurses into slice 1
//   1e8 an Option held in a variable (head-only fallback)
//   1e9 `Ok(<literal>)`
//  1e10 `Err(<string>)` -- payload verbatim, matching show_for_typed
//  1e11 tuple literal
//  1e12 array literal
//  1e13 `Some(Some(..))` -- slice 2 recurses into itself
//  1e14 prelude `to_string(<enum>)`   -- the spelled-out call, not interpolation
//  1e15 prelude `to_string(<struct>)`
//  1e16 a LOCAL that shadows a pass-through shim still wins over the rewrite
//
// #1443 review (Codex P2): 1e16 is the shadowing case. The rewrite matches the
// shim by NAME, and a name is not a binding -- a parameter called `dump` in a
// module that also defines `dump(x) { __to_string(x) }` had its calls retargeted
// to `T::to_string`, silently ignoring the function the caller passed. Verified
// to fail before the fix and pass after.
//
// The last two are the asymmetry #1392 recorded: `"\{v}"` rendered
// structurally while `to_string(v)`, which prelude defines as an unconditional
// `__to_string(x)`, still printed the pointer decimal. They are digits of THIS
// fixture rather than a separate one so that a change which fixes one spelling
// and breaks the other cannot pass.
//
// Want 11111111111111111.
import @vibe/prelude {
  to_string
}

// #1324 removed the language-provided `Result`; interpolation still renders
// a two-track enum's ctor structurally, so the fixture declares its own.
enum Result[T, E] {
  Ok(T);
  Err(E)
}

struct P {
  x: Int;
  y: Int
} derive (Show)

enum E2 {
  A;
  B(Int)
} derive (Show)

fn show_param(v: E2) -> String {
  "\{v}"
}

/// A pass-through of exactly the shape the #1392 rewrite collects.
fn dump_p(x: P) -> String {
  __to_string(x)
}

/// `dump_p` here is a PARAMETER shadowing the top-level shim above. Calling it
/// must call what the caller supplied.
fn via_shadow(dump_p: (P) -> String, v: P) -> String {
  dump_p(v)
}

fn bit(ok: Bool, weight: Int) -> Int {
  if ok {
    weight
  } else {
    0
  }
}

let _start = () -> Int {
  let p = P::{
    x: 1, y: 2
  }
  let e = B(3)
  let o = Some(7)
  bit("\{1}" == "1" && "\{true}" == "true" && "\{"s"}" == "s", 1) + bit("\{p}" == "P { x: 1, y: 2 }", 10) + bit("\{e}" == "B(3)", 100) + bit("\{A}" == "A", 1000) + bit(show_param(B(9)) == "B(9)", 10000) + bit("\{Some(1)}" == "Some(1)", 100000) + bit("\{None}" == "None", 1000000) + bit("\{Some(P::{ x: 1, y: 2 })}" == "Some(P { x: 1, y: 2 })", 10000000) + bit("\{o}" == "Some(7)", 100000000) + bit("\{Ok(3)}" == "Ok(3)", 1000000000) + bit("\{Err("bad")}" == "Err(bad)", 10000000000) + bit("\{(1, "a", true)}" == "(1, a, true)", 100000000000) + bit("\{[1, 2, 3]}" == "[1, 2, 3]", 1000000000000) + bit("\{Some(Some(5))}" == "Some(Some(5))", 10000000000000) + bit(to_string(e) == "B(3)", 100000000000000) + bit(to_string(p) == "P { x: 1, y: 2 }", 1000000000000000) + bit(via_shadow((_q: P) -> String {
    "CUSTOM"
  }, p) == "CUSTOM", 10000000000000000)
}
_start()

__DATA__
{
  "last": "11111111111111111"
}
