// #2913: `String::iter_length` was typed by the checker (`lookup_iter_intrinsic`
// and the `direct_builtin_return` fast path both admitted it) and emitted by no
// lowering, so a call type-checked clean and then died with `reached code
// generation unresolved` -- the compiler blaming itself for a correct-looking
// program. It is refused here instead, and the message names what to write.
fn main() -> Unit allows Console {
  println(Int::to_string(String::iter_length("abc")))
}
