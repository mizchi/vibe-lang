// #3219: a mutable slot is reassigned after an owning call in a loop, then
// read again after the loop. Its reference count must not grow per store.
enum D {
  A(Array[Int])
}

fn hold(d: D) -> D { d }
fn first(d: D) -> Int {
  match d { A(xs) => Array::get(xs, 0) }
}
fn one_round(n: Int) -> Int {
  let mut cur = A([n])
  let mut acc = 0
  let mut i = 0
  while i < 3 {
    acc = acc + first(hold(cur))
    cur = A([n + i])
    i = i + 1
  }
  acc + first(hold(cur))
}
export fn main() -> Int {
  let mut i = 0
  let mut sum = 0
  while i < 2000 {
    sum = sum + one_round(i)
    i = i + 1
  }
  sum
}
