//# An unsupported field inside a generic struct remains fail-closed (#2218).

struct Bucket[T] {
  values: Map[String, T]
} derive (Eq)

export fn _start() -> Int {
  let left = []
  let right = []
  let lm = Map::new()
  let rm = Map::new()
  Map::set(lm, "x", 1)
  Map::set(rm, "x", 1)
  Array::push(left, Bucket[Int]::{ values: lm })
  Array::push(right, Bucket[Int]::{ values: rm })
  if left == right {
    1
  } else {
    0
  }
}
