// State + Exception interaction — handler ordering determines semantics

// Ported from polysemy test/FinalSpec.hs

// Effect outside Error: effect handler processes even after error

effect Vault {
  Deposit(Int) -> Unit;
  Balance -> Int;
}

// Deposit(100) → resume(0), throw → Error caught → -1

test "effect polysemy state error interaction" {
  let result = handle {
    handle {
      perform Vault::Deposit(100)
      throw("bank error")
      perform Vault::Balance
    } with { Exception::Throw(_msg) => -1 }
  } with { Vault::Deposit(_v) => resume(0); Vault::Balance => resume(999) }
  inspect(result, "-1")
}
