// #3284: `Error` was retired as an effect spelling (#1461). A qualified handler
// arm `Error::Throw(_)` was the one position that still accepted it, silently
// meaning `Exception`. It is a parse error naming the edit, as a row item and
// a legacy handler header already were.
fn f() -> Int with Exception {
  throw("x")
}

fn g() -> Int {
  handle {
    f()
  } with { Error::Throw(_) => 7 }
}

let main = () -> Int {
  g()
}
