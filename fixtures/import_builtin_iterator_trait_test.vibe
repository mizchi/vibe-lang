// #3769: the `trait Iterator` spelling of the builtin import binds the
// namespace's operations; the bare spelling is refused
// (fixtures/err_import_builtin_iterator_bare.vibe).
import @vibe/builtin { trait Iterator }

test "importing trait Iterator binds Iterator::map" {
  let xs = [1, 2, 3]
  inspect(Iterator::map(xs, f = (x) -> { x * 2 }), content = "[2, 4, 6]")
}
