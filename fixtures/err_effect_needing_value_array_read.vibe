// #4065: an element read out of a binding of `[g]` handed to a row-free parameter.
// Data holds a handle-bound closure at its evidence arity -- that is what lets
// a binder of it reach a parameter typed `with Ask`
// (handle_bound_closure_binder_test.vibe). A row-free parameter calls it at
// its plain arity, and no eta-expansion can stand in for the element read, so
// handing it to one is refused at build time, as #1261 refuses the bare name.
// It used to compile clean and trap in `apply` (indirect call type mismatch).
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs = [g]
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
