// #3587: the green side of the cross-module supertrait-method refusal
// (fixtures/err_eq_subtrait_equals_*_refused.vibe). A dependency's `impl Key
// for Box[Int]` writes `equals` and this entry implements `Eq` for
// `Box[String]`: no type gets two `Eq::equals`, so the program is accepted and
// each instance compares through its own one.

import ./modules/eq_subtrait_sib_types.vibe {
  struct Box
}

import ./modules/eq_subtrait_narrow_key.vibe {
  via_key
}

impl Eq for Box[String] {
  equals(self, o: Box[String]) -> Bool {
    String::length(self.v) == String::length(o.v)
  }
}

fn via_eq[U: Eq](a: U, b: U) -> Bool {
  U::equals(a, b)
}

test "each instance keeps its one equals" {
  let i1: Box[Int] = Box::{ v: 1 }
  let i2: Box[Int] = Box::{ v: 2 }
  let s1: Box[String] = Box::{ v: "ab" }
  let s2: Box[String] = Box::{ v: "cd" }
  inspect("key=\{via_key(i1, i1)},\{via_key(i1, i2)} eq=\{via_eq(s1, s2)}", content = "key=true,false eq=true")
}
