//# Types

enum Color { Red; Green; Blue } derive(Eq)

enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Point
} derive(Eq)

struct Vec2 { x: Int; y: Int } derive(Eq)

struct Named { name: String; value: Int } derive(Eq)

enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
} derive(Eq)

//# Misc

test "derive Eq simple enum" {
  assert(Color::Red == Color::Red)
  assert(Color::Red != Color::Green)
  assert(Color::Blue == Color::Blue)
}

test "derive Eq enum with data" {
  assert(Shape::Circle(5) == Shape::Circle(5))
  assert(Shape::Circle(5) != Shape::Circle(10))
  assert(Shape::Rect(3, 4) == Shape::Rect(3, 4))
  assert(Shape::Rect(3, 4) != Shape::Rect(4, 3))
  assert(Shape::Point == Shape::Point)
  assert(Shape::Circle(5) != Shape::Point)
}

test "derive Eq struct" {
  let a = Vec2::{ x: 1, y: 2 }
  let b = Vec2::{ x: 1, y: 2 }
  let c = Vec2::{ x: 3, y: 4 }
  assert(a == b)
  assert(a != c)
}

test "derive Eq struct with string" {
  let a = Named::{ name: "foo", value: 1 }
  let b = Named::{ name: "foo", value: 1 }
  let c = Named::{ name: "foo", value: 2 }
  let d = Named::{ name: "bar", value: 1 }
  assert(a == b)
  assert(a != c)
  assert(a != d)
}

test "derive Eq recursive enum" {
  let t1 = Tree::Node(Tree::Leaf(1), Tree::Leaf(2))
  let t2 = Tree::Node(Tree::Leaf(1), Tree::Leaf(2))
  let t3 = Tree::Node(Tree::Leaf(1), Tree::Leaf(3))
  assert(t1 == t2)
  assert(t1 != t3)
}

test "derive Eq with Option" {
  let a: Option[Int] = Some(42)
  let b: Option[Int] = Some(42)
  let c: Option[Int] = None
  let d: Option[Int] = Some(0)
  assert(a == b)
  assert(a != c)
  assert(a != d)
  assert(c == c)
}

test "derive Eq in match" {
  let c = Color::Green
  let result = if c == Color::Red { "red" }
    else if c == Color::Green { "green" }
    else { "blue" }
  assert(result == "green")
}

test "derive Eq enum in array" {
  let colors = [Color::Red, Color::Green, Color::Blue]
  assert(Array::any(colors, x -> x == Color::Green))
  assert(not(Array::any(colors, x -> x == Color::Red && x == Color::Blue)))
}
