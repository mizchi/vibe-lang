// Phase 3: HTTP handler with client proxy support via combined adapter.
// Returns >= 0 for direct response, -1 for proxy GET.
// The combined adapter interprets -1 as "make an outgoing client request".
export let handler = (method: String, url: String) -> Int {
  if string_equals(method, "GET") {
    if string_equals(url, "/") { 200 }
    else { if string_equals(url, "/health") { 200 }
    else { if string_starts_with(url, "/proxy") { -1 }
    else { 404 } } }
  } else {
    405
  }
}
handler("GET", "/")
