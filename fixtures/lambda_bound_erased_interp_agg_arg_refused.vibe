//# #2745: a formal nested inside an AGGREGATE ARGUMENT.
//
// Codex, P1 round 22 on #2761. Measured on `6c3b1d7`:
// `fn fst[U](p: (U, Int)) -> U` called as `fst((a, 0))` printed a 3-digit
// pointer decimal.
//
// The argument scan classified each argument as a whole, and a tuple as a
// whole classifies as "" -- so the formal sitting inside it was never seen.
//
// The scan now looks INSIDE an aggregate written at the site. That keeps the
// approximation this path already documents -- the argument carrying the
// erasure need not be the one the return names, so a formal anywhere in the
// arguments makes the result erased -- and widens only WHERE the formal may
// sit, not what is concluded from finding it.

struct Qt {
  w: Int
}

fn fst[U](p: (U, Int)) -> U {
  p.0
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{fst((a, 0))}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
