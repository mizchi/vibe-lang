test "a discarded name keeps its binding's reference" {
  let xs = [5]
  xs
  inspect(Array::get(xs, at = 0), "5")
}

test "a discarded view keeps its container's reference" {
  let xs = [[5]]
  // Index sugar, a borrow-returning call like `Array::get`: a discarded
  // `Array::get(..)` is refused as a statement that does nothing (#4146),
  // and this keeps the discarded view at the head of the sequence.
  xs[0]
  inspect(Array::get(Array::get(xs, at = 0), at = 0), "5")
}
