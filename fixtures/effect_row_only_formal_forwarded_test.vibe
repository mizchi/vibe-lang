// #3386: a formal only `run`'s rows name is fixed at the call by the row in
// scope there, so the callback performs at the caller's instantiation.
effect Box[T] {
  Put(T) -> Int
}

fn run[T](f: () -> Int with Box[T]) -> Int with Box[T] {
  f()
}

fn caller() -> Int with Box[String] {
  run(() -> {
    perform Box::Put("abcd")
  })
}

fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}

fn caller2() -> Int with Box[String] {
  mk("abc")
}

test "the callback performs at the caller's row" {
  let r = handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
  inspect(r, "4")
}

test "a written generic row is instantiated at the call" {
  let r = handle {
    caller2()
  } with { Box::Put(s) => resume(String::length(s)) }
  inspect(r, "3")
}
