// #3066: render arguments whose payload type only the CHECKER knows (a local
// lambda's result), in an imported module and in the importer, with two
// private enums of the same spelling. Before the fix every payload went
// through the pointer heuristic: `[Some(364)] (Some(1), Some(412)) Some(300)`.
import ./interp_render_rows_cross_module_dep.vibe {
  describe
}

enum Hue {
  Green
} derive (Show)

test "payload types resolve across modules" {
  let g = () -> Green
  let mine = Some(g())
  inspect("\{describe()} \{mine}", content = "[Some(Blue)] (Some(true), Some(Red)) Some(Green)")
}
