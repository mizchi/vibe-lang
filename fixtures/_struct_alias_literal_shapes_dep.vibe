// Dependency of struct_alias_literal_test.vibe (#3837): two structs with the
// same field set, so a literal that lost its struct's name could only be
// matched by shape -- and would match `SA` first.

export struct SA {
  v: Int
} derive (Show)

export struct SB {
  v: Int
} derive (Show)

export fn SA::get(_ a: SA) -> String {
  "SA"
}

export fn SB::get(_ b: SB) -> String {
  "SB"
}
