// #3544: the entry declares its own `impl Name for Int` while an imported
// module declares another. The imported one used to override the entry's even
// for the entry's own `Name::name(2)`. It is refused, naming both impls.

import ./modules/impl_overlap_trait.vibe {
  trait Name
}

import ./modules/impl_overlap_a.vibe {
  a_name
}

impl Name for Int {
  name(x: Int) -> String {
    "from-main"
  }
}

test "the entry keeps its own impl" {
  inspect(Name::name(2), "from-main")
  inspect(a_name(), "from-a")
}
