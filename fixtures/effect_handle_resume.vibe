// Effect handler with resume: mock Console for testing
effect Console {
  Print(String) -> Unit;
  ReadLine -> String
}

let greet = () -> String with { Console } {
  let name = perform Console::ReadLine
  perform Console::Print(name)
  name
}

// Handle provides mock implementations
let result = handle {
  greet()
} {
  Console::ReadLine => resume("Alice"),
  Console::Print(_msg) => resume(0)
}
String::length(result)

__DATA__
{"last": "5"}
