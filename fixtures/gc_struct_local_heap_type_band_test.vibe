fn sum_type_24() -> Int {
  let p = S10::{ a: 3, b: 4 }
  p.a + p.b
}

fn sum_type_64() -> Int {
  let p = S50::{ a: 5, b: 6 }
  p.a + p.b
}

fn sum_type_110() -> Int {
  let p = S96::{ a: 7, b: 8 }
  p.a * p.b
}

test "a struct local at type 24 still works" {
  inspect(sum_type_24(), "7")
}

test "a struct local at type 64 is declared with a signed heap type" {
  inspect(sum_type_64(), "11")
}

test "a struct local at type 110 is not read as the abstract any" {
  inspect(sum_type_110(), "56")
}
