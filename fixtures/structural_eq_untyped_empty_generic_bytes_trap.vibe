//# ADR-0097 fail-closed: a generic struct literal instantiated with `Bytes`.
//#
//# `is_scalar_type_name` answers "this name needs no generated comparator",
//# which is NOT the question the erased field of a generic struct asks. The
//# single generated `Box::equals` compares that field with a raw `==`, and for
//# `Bytes` a raw `==` is pointer equality -- two distinct allocations of equal
//# content answer `false`. The annotated `Array[Box[Bytes]]` answers `false`
//# too (#2195), so admitting this instantiation would hand that wrong answer a
//# spelling reachable from an unannotated binding.
//#
//# `raw_eq_is_content_equality` therefore rejects it and `==` traps.
//# `Box[Int]` / `Box[String]` / `Box[Bool]` / `Box[Unit]` are the measured
//# other side and ANSWER -- pinned in
//# fixtures/structural_eq_contexts_test.vibe.

struct Box[T] {
  value: T
} derive (Eq)

fn mkv(x: Int) -> Bytes {
  let b = Bytes::new()
  Bytes::push(b, x)
  b
}

export fn _start() -> Int {
  let left = []
  Array::push(left, Box[Bytes]::{
    value: mkv(65)
  })
  let right = []
  Array::push(right, Box[Bytes]::{
    value: mkv(65)
  })
  if left == right {
    1
  } else {
    0
  }
}
