// Higher-order handler: function takes effectful computation as argument
effect Ask {
  Prompt(String) -> String
}

// run_with_mock: provides handler for Ask effect
// Takes a function that uses Ask, returns result with mock answers
let run_with_mock = (body: () -> String with Ask) -> String {
  handle { body() } with Ask {
    Prompt(_question) => resume("mock_answer")
  }
}

// Business logic uses Ask effect
let greeting = () -> String with Ask {
  let name = perform Ask::Prompt("What is your name?")
  String::concat("Hello, ", name)
}

// Higher-order: pass effectful function to handler
let result = run_with_mock(greeting)
String::length(result)

