// #639 criterion 1: `perform`ing a user effect with no `with` clause at all
// on the enclosing function -- the row-mismatch message must say "no
// 'with' clause" (not pretend there's an empty declared row to diff
// against) and name the fix-it target function. Per #1161 (Codex review),
// the DIRECT check reports the qualified operation, not the base effect
// name, so a local one-off `perform` gets a minimal, precise fix-it.
// needle: "missing { Ask::Value } (no 'with' clause, requires { Ask::Value })"
// needle: "hint: declare 'fn asks(...) -> T with Ask::Value'"
effect Ask {
  Value(String) -> Int
}

fn asks() -> Int {
  perform Ask::Value("q")
}
