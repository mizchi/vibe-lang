//# #3301: nested or-pattern handler arms multiply the copies the split makes,
//# so the split refuses a `handle` it would copy more than 256 times. Nine
//# levels of two-operation arms copy the innermost `handle` exactly 256 times:
//# the limit itself still compiles, and answers as the arms written apart
//# would. Ten levels are refused
//# (`fixtures/typecheck/handler_or_pattern_nested_copies_reject.vibe`).

effect E0 {
  A0 -> Int
  B0 -> Int
}

effect E1 {
  A1 -> Int
  B1 -> Int
}

effect E2 {
  A2 -> Int
  B2 -> Int
}

effect E3 {
  A3 -> Int
  B3 -> Int
}

effect E4 {
  A4 -> Int
  B4 -> Int
}

effect E5 {
  A5 -> Int
  B5 -> Int
}

effect E6 {
  A6 -> Int
  B6 -> Int
}

effect E7 {
  A7 -> Int
  B7 -> Int
}

effect E8 {
  A8 -> Int
  B8 -> Int
}

fn nested() -> Int {
  handle {
    perform E0::A0 + perform E0::B0
  } with E0 {
    A0|B0 => {
      let f = () -> handle {
        perform E1::A1 + perform E1::B1
      } with E1 {
        A1|B1 => {
          let f = () -> handle {
            perform E2::A2 + perform E2::B2
          } with E2 {
            A2|B2 => {
              let f = () -> handle {
                perform E3::A3 + perform E3::B3
              } with E3 {
                A3|B3 => {
                  let f = () -> handle {
                    perform E4::A4 + perform E4::B4
                  } with E4 {
                    A4|B4 => {
                      let f = () -> handle {
                        perform E5::A5 + perform E5::B5
                      } with E5 {
                        A5|B5 => {
                          let f = () -> handle {
                            perform E6::A6 + perform E6::B6
                          } with E6 {
                            A6|B6 => {
                              let f = () -> handle {
                                perform E7::A7 + perform E7::B7
                              } with E7 {
                                A7|B7 => {
                                  let f = () -> handle {
                                    perform E8::A8 + perform E8::B8
                                  } with E8 {
                                    A8|B8 => {
                                      let f = () -> 1
                                      resume(f() + 1)
                                    }
                                  }
                                  resume(f() + 1)
                                }
                              }
                              resume(f() + 1)
                            }
                          }
                          resume(f() + 1)
                        }
                      }
                      resume(f() + 1)
                    }
                  }
                  resume(f() + 1)
                }
              }
              resume(f() + 1)
            }
          }
          resume(f() + 1)
        }
      }
      resume(f() + 1)
    }
  }
}

test "nine nested or-pattern arms compile at the copy limit" {
  inspect(nested(), "1534")
}
