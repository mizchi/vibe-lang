// #3347: a closure literal annotated through a type alias performs under the
// alias's row, so a `handle` around a call of it discharges the perform. It
// was refused: the perform was charged to the enclosing function.
effect Ask {
  Get() -> Int
}

type Thunk = () -> Int with Ask

fn run() -> Int {
  let side: Thunk = () -> Int {
    perform Ask::Get()
  }
  handle {
    side()
  } with {
    Ask::Get() => resume(41)
  }
}

test "the handle discharges the alias-annotated closure" {
  inspect(run(), "41")
}
