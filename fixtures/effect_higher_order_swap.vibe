// Higher-order: swap handler implementations
effect Env {
  GetValue -> Int
}

let compute = () -> Int with Env {
  let a = perform Env::GetValue
  let b = perform Env::GetValue
  a + b
}

// Handler 1: always returns 10
let with_ten = (f: () -> Int with Env) -> Int {
  handle { f() } with Env { GetValue => resume(10) }
}

// Handler 2: always returns 100
let with_hundred = (f: () -> Int with Env) -> Int {
  handle { f() } with Env { GetValue => resume(100) }
}

// Same computation, different handlers
let r1 = with_ten(compute)
let r2 = with_hundred(compute)
r1 + r2

