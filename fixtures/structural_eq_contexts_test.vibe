//# ADR-0097: aggregate equality must not depend on spelling or value path.

struct Point {
  x: Int
} derive (Eq)

enum Boxed {
  BoxedPoint(Point)
} derive (Eq)

fn make_array() -> Array[Int] {
  [
    1,
    2
  ]
}

fn make_other_array() -> Array[Int] {
  [
    1,
    3
  ]
}

fn make_tuple_array() -> (Array[Int], Int) {
  ([
    1,
    2
  ], 3)
}

fn same_nested(left: Array[Array[Int]], right: Array[Array[Int]],) -> Bool {
  left == right
}

fn same_float(left: Array[Float], right: Array[Float]) -> Bool {
  left == right
}

fn generic_same[T: Eq](left: T, right: T) -> Bool {
  left == right
}

test "function-returned arrays compare structurally" {
  assert(make_array() == make_array())
  assert(make_array() != make_other_array())
}

test "tuple-returned arrays compare structurally" {
  assert(make_tuple_array() == make_tuple_array())
}

test "empty array bindings compare structurally" {
  let left = [
  ]
  let right = [
  ]
  assert(left == right)
  assert(left != [
    1
  ])
}

test "annotated empty bindings stay structural after a push" {
  // The comparison above never mutates. This one does, because that is the
  // shape the book tells readers to write: annotate the empty literal, then
  // grow it. Pushing to one must make them differ and pushing to both must
  // make them agree again -- content, not identity.
  let left: Array[Int] = [
  ]
  let right: Array[Int] = [
  ]
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty bindings stay structural after a push" {
  // #2157: the same program without the annotation. It used to answer the
  // first comparison and then TRAP on the second, because the binding carried
  // no element type once it had grown. The element type comes from the push.
  let left = [
  ]
  let right = [
  ]
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty let mut bindings stay structural after a push" {
  // `let mut` records the same empty shape as `let`, so it needs the same
  // element type from the same place.
  let mut left = [
  ]
  let mut right = [
  ]
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty bindings compare content, not length" {
  // Equal lengths, different contents: a length-only answer would say `true`
  // here, so this is what separates the fix from the old fail-closed guard.
  let left = [
  ]
  let right = [
  ]
  Array::push(left, 1)
  Array::push(right, 2)
  assert(left != right)
  Array::push(left, 3)
  Array::push(right, 3)
  assert(left != right)
}

test "unannotated empty String bindings compare structurally" {
  let left = [
  ]
  let right = [
  ]
  Array::push(left, "a")
  Array::push(right, "a")
  assert(left == right)
  Array::push(left, "b")
  Array::push(right, "c")
  assert(left != right)
}

test "only one unannotated empty binding grows" {
  // The half of #2157 the old guard was written for: one side never left zero
  // length, so the lengths alone decide. It has to keep answering.
  let grown = [
  ]
  let stayed = [
  ]
  Array::push(grown, 1)
  assert(grown != stayed)
  assert(stayed != grown)
}

test "an inner shadow does not retype an outer empty binding" {
  // The push scan stops at a construct that re-binds the spelling, so the
  // Strings pushed onto the INNER `items` never reach the outer one. Were they
  // to, the two shapes would disagree, the outer binding would keep its empty
  // shape, and the first comparison would fall over instead of answering.
  let items = [
  ]
  let other = [
  ]
  Array::push(items, 1)
  Array::push(other, 1)
  assert(items == other)
  let items = [
  ]
  let texts = [
  ]
  Array::push(items, "a")
  Array::push(texts, "a")
  assert(items == texts)
  Array::push(texts, "b")
  assert(items != texts)
}

test "unannotated empty bindings of structs compare structurally" {
  let left = [
  ]
  let right = [
  ]
  Array::push(left, Point::{
    x: 1
  })
  Array::push(right, Point::{
    x: 1
  })
  assert(left == right)
  Array::push(left, Point::{
    x: 2
  })
  Array::push(right, Point::{
    x: 3
  })
  assert(left != right)
}

test "unannotated empty bindings of tuples compare structurally" {
  let left = [
  ]
  let right = [
  ]
  Array::push(left, (1, "a"))
  Array::push(right, (1, "a"))
  assert(left == right)
  Array::push(left, (2, "b"))
  Array::push(right, (2, "c"))
  assert(left != right)
}

test "unannotated empty bindings grown in a loop compare structurally" {
  // The pushed value is a binding introduced AFTER the empty literal, so the
  // element type is only reachable if the scan carries the environment down.
  let left = [
  ]
  let right = [
  ]
  let mut i = 0
  while i < 3 {
    Array::push(left, i)
    Array::push(right, i)
    i = i + 1
  }
  assert(left == right)
  Array::push(right, 9)
  assert(left != right)
}

test "Option variables with array payload compare structurally" {
  let left = Some([
    1,
    2
  ])
  let right = Some([
    1,
    2
  ])
  assert(left == right)
  assert(left != Some([
    1,
    3
  ]))
  let from_call_left = Some(make_array())
  let from_call_right = Some(make_array())
  assert(from_call_left == from_call_right)
}

test "annotated nested-array parameters compare structurally" {
  assert(same_nested([
    [
      1,
      2
    ]
  ], [
    [
      1,
      2
    ]
  ]))
  assert(not(same_nested([
    [
      1,
      2
    ]
  ], [
    [
      1,
      3
    ]
  ])))
}

test "Array Float parameters compare structurally" {
  assert(same_float([
    1.5,
    2.5
  ], [
    1.5,
    2.5
  ]))
  assert(not(same_float([
    1.5,
    2.5
  ], [
    1.5,
    3.5
  ])))
}

test "existing structural controls stay structural" {
  assert(Point::{
    x: 1
  } == Point::{
    x: 1
  })
  assert(BoxedPoint(Point::{
    x: 1
  }) == BoxedPoint(Point::{
    x: 1
  }))
  assert(generic_same(1, 1))
  assert([
    [
      1,
      2
    ]
  ] == [
    [
      1,
      2
    ]
  ])
}

test "inner scalar shadow masks an outer aggregate equality shape" {
  let value = [
    [
      1
    ]
  ]
  assert(value == [
    [
      1
    ]
  ])
  let value = 1
  assert(value == 1)
  assert(value != 2)
}

test "local closure return annotation directs array equality" {
  let make = () -> Array[Int] {
    [
      1,
      2
    ]
  }
  assert(make() == make())
}

// #2192 review: the push scan in desugar_trait_dict carries the binding site's
// `var_types` UNCHANGED into a closure body, a for-in body, a loop body and a
// match arm -- it checks only whether the ARRAY's spelling is rebound, not
// whether a binder there shadows the name of the pushed VALUE. A review read
// that as a silent-wrong: outer `v: Int`, closure parameter `v: String`, so
// `Array::push(xs, v)` records the Int shape for an `Array[String]` and the
// comparison answers by pointer.
//
// Measured on the merged tree, it does not: every shape below answers by
// content, including the sharpest possible mismatch (a `derive(Eq)` struct
// outside, a String parameter inside). What makes the mechanism inert is NOT
// established -- so these exist to make the answer a fixed point rather than
// an observation. If a later change makes any of them answer by pointer, that
// is the silent-wrong the review predicted and these fail on it.
//
// The strings are built through `mk` from different pieces so equal content is
// never the same allocation; comparing them as scalars would give `false`.

fn eqctx_mk(a: String, b: String) -> String {
  String::concat(a, b)
}

struct EqCtxPoint {
  x: Int;
  y: Int
} derive(Eq)

test "a closure parameter shadowing an outer Int does not scalarize a String array" {
  let v = 1
  let xs = []
  let ys = []
  let f = (v: String) -> Unit { Array::push(xs, v) }
  let g = (v: String) -> Unit { Array::push(ys, v) }
  f(eqctx_mk("ab", "c"))
  g(eqctx_mk("a", "bc"))
  assert(xs == ys)
  assert(v == 1)
}

test "a closure parameter shadowing an outer String does not mistype an Int array" {
  let v = "outer"
  let xs = []
  let ys = []
  let f = (v: Int) -> Unit { Array::push(xs, v) }
  let g = (v: Int) -> Unit { Array::push(ys, v) }
  f(3)
  g(3)
  assert(xs == ys)
  f(1)
  g(2)
  assert(xs != ys)
  assert(v == "outer")
}

test "a closure parameter shadowing an outer struct does not misread a String array" {
  let v = EqCtxPoint::{ x: 1, y: 2 }
  let xs = []
  let ys = []
  let f = (v: String) -> Unit { Array::push(xs, v) }
  let g = (v: String) -> Unit { Array::push(ys, v) }
  f(eqctx_mk("ab", "c"))
  g(eqctx_mk("a", "bc"))
  assert(xs == ys)
  assert(v.x == 1)
}

test "a match arm binder shadowing an outer Int does not scalarize a String array" {
  let v = 1
  let xs = []
  let ys = []
  let o1: Option[String] = Some(eqctx_mk("ab", "c"))
  let o2: Option[String] = Some(eqctx_mk("a", "bc"))
  match o1 {
    Some(v) => Array::push(xs, v),
    None => ()
  }
  match o2 {
    Some(v) => Array::push(ys, v),
    None => ()
  }
  assert(xs == ys)
  assert(v == 1)
}
