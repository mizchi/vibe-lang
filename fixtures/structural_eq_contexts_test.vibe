//# ADR-0097: aggregate equality must not depend on spelling or value path.

struct Point {
  x: Int
} derive (Eq)

enum Boxed {
  BoxedPoint(Point)
} derive (Eq)

fn make_array() -> Array[Int] {
  [1, 2]
}

fn make_other_array() -> Array[Int] {
  [1, 3]
}

fn make_tuple_array() -> (Array[Int], Int) {
  ([1, 2], 3)
}

fn same_nested(left: Array[Array[Int]], right: Array[Array[Int]],) -> Bool {
  left == right
}

fn same_float(left: Array[Float], right: Array[Float]) -> Bool {
  left == right
}

fn generic_same[T: Eq](left: T, right: T) -> Bool {
  left == right
}

test "function-returned arrays compare structurally" {
  assert(make_array() == make_array())
  assert(make_array() != make_other_array())
}

test "tuple-returned arrays compare structurally" {
  assert(make_tuple_array() == make_tuple_array())
}

test "empty array bindings compare structurally" {
  let left = []
  let right = []
  assert(left == right)
  assert(left != [1])
}

test "annotated empty bindings stay structural after a push" {
  // The comparison above never mutates. This one does, because that is the
  // shape the book tells readers to write: annotate the empty literal, then
  // grow it. Pushing to one must make them differ and pushing to both must
  // make them agree again -- content, not identity.
  let left: Array[Int] = []
  let right: Array[Int] = []
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty bindings stay structural after a push" {
  // #2157: the same program without the annotation. It used to answer the
  // first comparison and then TRAP on the second, because the binding carried
  // no element type once it had grown. The element type comes from the push.
  let left = []
  let right = []
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty let mut bindings stay structural after a push" {
  // `let mut` records the same empty shape as `let`, so it needs the same
  // element type from the same place.
  let mut left = []
  let mut right = []
  assert(left == right)
  Array::push(left, 1)
  assert(left != right)
  Array::push(right, 1)
  assert(left == right)
}

test "unannotated empty bindings compare content, not length" {
  // Equal lengths, different contents: a length-only answer would say `true`
  // here, so this is what separates the fix from the old fail-closed guard.
  let left = []
  let right = []
  Array::push(left, 1)
  Array::push(right, 2)
  assert(left != right)
  Array::push(left, 3)
  Array::push(right, 3)
  assert(left != right)
}

test "unannotated empty String bindings compare structurally" {
  let left = []
  let right = []
  Array::push(left, "a")
  Array::push(right, "a")
  assert(left == right)
  Array::push(left, "b")
  Array::push(right, "c")
  assert(left != right)
}

test "only one unannotated empty binding grows" {
  // The half of #2157 the old guard was written for: one side never left zero
  // length, so the lengths alone decide. It has to keep answering.
  let grown = []
  let stayed = []
  Array::push(grown, 1)
  assert(grown != stayed)
  assert(stayed != grown)
}

test "an inner shadow does not retype an outer empty binding" {
  // The push scan stops at a construct that re-binds the spelling, so the
  // Strings pushed onto the INNER `items` never reach the outer one. Were they
  // to, the two shapes would disagree, the outer binding would keep its empty
  // shape, and the first comparison would fall over instead of answering.
  let items = []
  let other = []
  Array::push(items, 1)
  Array::push(other, 1)
  assert(items == other)
  let items = []
  let texts = []
  Array::push(items, "a")
  Array::push(texts, "a")
  assert(items == texts)
  Array::push(texts, "b")
  assert(items != texts)
}

test "unannotated empty bindings of structs compare structurally" {
  let left = []
  let right = []
  Array::push(left, Point::{
    x: 1
  })
  Array::push(right, Point::{
    x: 1
  })
  assert(left == right)
  Array::push(left, Point::{
    x: 2
  })
  Array::push(right, Point::{
    x: 3
  })
  assert(left != right)
}

test "unannotated empty bindings of tuples compare structurally" {
  let left = []
  let right = []
  Array::push(left, (1, "a"))
  Array::push(right, (1, "a"))
  assert(left == right)
  Array::push(left, (2, "b"))
  Array::push(right, (2, "c"))
  assert(left != right)
}

test "unannotated empty bindings grown in a loop compare structurally" {
  // The pushed value is a binding introduced AFTER the empty literal, so the
  // element type is only reachable if the scan carries the environment down.
  let left = []
  let right = []
  let mut i = 0
  while i < 3 {
    Array::push(left, i)
    Array::push(right, i)
    i = i + 1
  }
  assert(left == right)
  Array::push(right, 9)
  assert(left != right)
}

test "Option variables with array payload compare structurally" {
  let left = Some([1, 2])
  let right = Some([1, 2])
  assert(left == right)
  assert(left != Some([1, 3]))
  let from_call_left = Some(make_array())
  let from_call_right = Some(make_array())
  assert(from_call_left == from_call_right)
}

test "annotated nested-array parameters compare structurally" {
  assert(same_nested([[1, 2]], [[1, 2]]))
  assert(not(same_nested([[1, 2]], [[1, 3]])))
}

test "Array Float parameters compare structurally" {
  assert(same_float([1.5, 2.5], [1.5, 2.5]))
  assert(not(same_float([1.5, 2.5], [1.5, 3.5])))
}

test "existing structural controls stay structural" {
  assert(Point::{
    x: 1
  } == Point::{
    x: 1
  })
  assert(BoxedPoint(Point::{
    x: 1
  }) == BoxedPoint(Point::{
    x: 1
  }))
  assert(generic_same(1, 1))
  assert([[1, 2]] == [[1, 2]])
}

test "inner scalar shadow masks an outer aggregate equality shape" {
  let value = [[1]]
  assert(value == [[1]])
  let value = 1
  assert(value == 1)
  assert(value != 2)
}

test "local closure return annotation directs array equality" {
  let make = () -> Array[Int] {
    [1, 2]
  }
  assert(make() == make())
}

// #2192 review: the push scan carries the binding site's `var_types` into a
// closure body, a for-in body, a loop body, a match arm, and a `let` whose
// value is not syntax-inferable. Each site checked only whether the ARRAY's
// spelling was rebound, never whether a binder there shadowed the name of the
// pushed VALUE -- so an outer `v: Int` was read for an inner `v` of another
// type, and `==` answered `false` for two equal arrays. Measured: a fail-closed
// trap (pre-#2157) turned into a silently wrong answer.
//
// The elements are `Array[Int]`, NOT `String`. An earlier version of these
// tests used equal-content strings built from different pieces and passed on
// the BROKEN compiler: equal strings compare equal even through a scalar
// comparator, so the probe had no discriminating power. Two separately built
// `[1, 2]` arrays are distinct objects, so a mis-selected comparator answers
// `false` and the test fails.

fn eqctx_pair(a: Int, b: Int) -> Array[Int] {
  [a, b]
}

test "a let shadow whose value is not syntax-inferable masks the outer binding" {
  let v = 1
  let flag = true
  let xs = []
  let ys = []
  let v = if flag {
    eqctx_pair(1, 2)
  } else {
    eqctx_pair(3, 4)
  }
  Array::push(xs, v)
  let v = if flag {
    eqctx_pair(1, 2)
  } else {
    eqctx_pair(3, 4)
  }
  Array::push(ys, v)
  assert(xs == ys)
}

test "a closure parameter shadowing an outer Int does not mistype the element" {
  let v = 1
  let xs = []
  let ys = []
  let f = (v: Array[Int]) -> Unit {
    Array::push(xs, v)
  }
  let g = (v: Array[Int]) -> Unit {
    Array::push(ys, v)
  }
  f(eqctx_pair(1, 2))
  g(eqctx_pair(1, 2))
  assert(xs == ys)
  assert(v == 1)
}

test "the same shadowed shape still answers false on different content" {
  let v = 1
  let xs = []
  let ys = []
  let f = (v: Array[Int]) -> Unit {
    Array::push(xs, v)
  }
  let g = (v: Array[Int]) -> Unit {
    Array::push(ys, v)
  }
  f(eqctx_pair(1, 2))
  g(eqctx_pair(9, 9))
  assert(xs != ys)
  assert(v == 1)
}

test "a match arm binder shadowing an outer Int does not mistype the element" {
  let v = 1
  let xs = []
  let ys = []
  let o1: Option[Array[Int]] = Some(eqctx_pair(1, 2))
  let o2: Option[Array[Int]] = Some(eqctx_pair(1, 2))
  match o1 {
    Some(v) => Array::push(xs, v),
    None => ()
  }
  match o2 {
    Some(v) => Array::push(ys, v),
    None => ()
  }
  assert(xs == ys)
  assert(v == 1)
}

test "no shadow at all still resolves the element type from the push" {
  let xs = []
  let ys = []
  Array::push(xs, eqctx_pair(1, 2))
  Array::push(ys, eqctx_pair(1, 2))
  assert(xs == ys)
}

test "a conditional pushed directly resolves when both branches agree" {
  let flag = true
  let xs = []
  let ys = []
  Array::push(xs, if flag {
    eqctx_pair(1, 2)
  } else {
    eqctx_pair(3, 4)
  })
  Array::push(ys, if flag {
    eqctx_pair(1, 2)
  } else {
    eqctx_pair(3, 4)
  })
  assert(xs == ys)
}

test "a conditional of scalars pushed directly resolves too" {
  let flag = true
  let xs = []
  let ys = []
  Array::push(xs, if flag {
    1
  } else {
    2
  })
  Array::push(ys, if flag {
    1
  } else {
    2
  })
  assert(xs == ys)
  Array::push(ys, 7)
  assert(xs != ys)
}
