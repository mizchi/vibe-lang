// #3163: a program that declares its own `Future::ready` calls that function.
// The await lowering's ready-future fast path used to match the spelling, so
// `await(Future::ready(5))` answered the argument, 5, and never ran the
// declaration below -- which resolves the future to 105.

fn Future::ready(x: Int) -> Future[Int] {
  let f = Future::pending()
  Future::resolve(f, x + 100)
  f
}

fn read_it() -> Int with Async {
  await(Future::ready(5))
}

test "a user-defined Future::ready is not the builtin fast path" {
  inspect(read_it(), content = "105")
}
