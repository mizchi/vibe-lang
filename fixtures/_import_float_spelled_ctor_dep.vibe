// A constructor may be spelled like a builtin float type (#3728 review): only
// a type position or a `Float::` path names the float, so `Double` and
// `Float` here are this enum's own constructors.
export enum Token {
  Double(Int)
  Float
  Word
}

export fn weight(t: Token) -> Int {
  match t {
    Double(n) => n * 2,
    Float => 1,
    Word => 0
  }
}
