// Exception + State interaction — error recovery
// Ported from koka/test/algeff/exn1.kk pattern
// Handle body has both effect performs and throw — Error caught by inner handle
effect Counter {
  Inc -> Unit;
  Count -> Int;
}

let result = handle {
  handle {
    perform Counter::Inc
    perform Counter::Inc
    let c = perform Counter::Count
    if c > 1 {
      throw("overflow")
    } else {
      c
    }
  } with Exception {
    Throw(_msg) => -1
  }
} with Counter {
  Inc => resume(0);
  Count => resume(2)
}
// Count always returns 2, 2 > 1 → throw → Error caught → -1
result

__DATA__
{"last": "-1"}
