// #3825: a generic call whose `Add`-bounded formals are one `Int32` and one
// `Int` is refused at build time. The `Int32` pass erases both to `Int`
// before the witnesses are built, so the row that makes the `Int32` sum wrap
// cannot say which formal it belongs to; answering by the `Int` witness
// would wrap neither.

fn sum2[A: Add, B: Add](a: A, b: B) -> A {
  a + a
}

fn main() -> Unit {
  let x: Int32 = 1
  println(Int::to_string(Int32::to_int(sum2(x, 5))))
}
