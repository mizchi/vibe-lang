// #3042 (Codex on #3063): importing an exact-shaped `Ordering` by name binds
// its constructors, and the checker still gives it the prelude's operations
// and Eq / Show bounds -- the same answers as the signature-only import in
// ordering_exact_shape_import_test.vibe.

import ./modules/ordering_exact_shape_ctor_dep.vibe { Ordering, sign_of }

// `Show` is a marker trait: the bound is what is checked here.
fn shown[T: Show](v: T) -> Int {
  1
}

test "the imported constructors carry the prelude's operations" {
  inspect(Ordering::to_string(sign_of(0 - 1)), "Less")
  inspect(Ordering::to_string(Ordering::compare(Greater, Less)), "Greater")
  inspect(shown(Equal), "1")
}
