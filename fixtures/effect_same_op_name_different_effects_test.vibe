// Scenario 8: Two effects with same op name — no collision

effect A {
  Get -> Int
}

effect B {
  Get -> String
}

test "effect same op name different effects" {
  let result = handle {
    handle {
      let a = perform A::Get
      let b = perform B::Get
      a + String::length(b)
    } with { B::Get => resume("hello") }
  } with { A::Get => resume(10) }
  inspect(result, "15")
}
