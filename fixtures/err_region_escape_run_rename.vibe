// #3153: a renamed import of `TaskGroup::run` keeps its region-escape check.
// The check used to be selected by the literal spelling, so returning the
// group's own `TaskHandle` out of the body through `nursery` compiled and ran
// (err_region_escape_return.vibe is the literal spelling).
import @vibe/concurrent {
  TaskGroup, TaskGroup::run as nursery, TaskHandle
}

fn main() -> Unit allows Exception {
  let h = nursery((g) -> TaskGroup::spawn(g, () -> 41))
  let _v = TaskHandle::join(h)
  ()
}
