trait IndexedKeys[T] {
  iter_length(Self) -> Int
  iter_get(Self, Int) -> T
}

impl [K, V] IndexedKeys[String] for Map[K, V] {
  iter_length(self) -> Int {
    Map::size(self)
  }
  iter_get(self, i) -> String {
    Map::iter_get(self, i)
  }
}

fn fold_keys[T, C: IndexedKeys[T], B](xs: C, init: B, f: (B, T) -> B) -> B {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, C::iter_get(xs, i))
    i = i + 1
  }
  acc
}

test "Map iterator key slots preserve insertion order" {
  let m = Map::from_pairs([("a", 1), ("b", 2), ("c", 3)])
  let joined = fold_keys(m, "", (acc: String, key: String) -> String {
    acc + key
  })
  assert(joined == "abc")
}

test "checked Map iterator access keeps user temporary bindings hygienic" {
  let m = Map::from_pairs([("a", 1), ("b", 2)])
  let __map_iter_get_map = 1
  let __map_iter_get_index = m
  assert(Map::iter_get(__map_iter_get_index, __map_iter_get_map) == "b")
}
