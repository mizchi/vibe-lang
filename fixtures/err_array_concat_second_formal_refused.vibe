// #3145 review: `Array::concat(xs, ys)` where only the SECOND operand is an
// erased formal. The call is refused, and the refusal names `ys` -- the
// operand the suggested annotation has to go on. It used to name the resolved
// first operand `xs`. The caller sits ABOVE `join`, so it was checked against
// the hoisted signature (#3149); declared first, the Map argument would be a
// type error at the call instead.

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  Array::length(join(m))
}

fn join[T](ys: T) -> Array[Int] {
  let xs: Array[Int] = [1]
  Array::concat(xs, ys)
}
