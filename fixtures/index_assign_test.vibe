// Regression: `arr[i] = v` (index assignment) parses and desugars to
// `Array::set(arr, i, v)`. Host-era sources (vibe/shell/pipeline.vibe's
// insertion sort, lib/@vibex/wasm/wit_parser) use this form; the selfhost parser
// used to die with "invalid assignment target" (#531 corpus scan, 8 tests).
// Covered in all three assignment parse contexts: statement level, block
// expression, and the step-block path.

test "index assign in block" {
  let arr = [1, 2, 3]
  arr[1] = 20
  assert(Array::get(arr, 1) == 20)
  assert(Array::get(arr, 0) == 1)
}

test "index assign with computed index" {
  let arr = [0, 0, 0, 0]
  let mut i = 0
  while i < 4 {
    arr[i] = i * 10
    i = i + 1
  }
  assert(Array::get(arr, 3) == 30)
}

test "insertion sort shape" {
  let xs = [3, 1, 2]
  let arr = xs[0: 3]
  let mut i2 = 1
  while i2 < 3 {
    let key = Array::get(arr, i2)
    let mut j = i2 - 1
    while j >= 0 {
      if key < Array::get(arr, j) {
        arr[j + 1] = Array::get(arr, j)
        j = j - 1
      } else break
    }
    arr[j + 1] = key
    i2 = i2 + 1
  }
  assert(Array::get(arr, 0) == 1)
  assert(Array::get(arr, 1) == 2)
  assert(Array::get(arr, 2) == 3)
}
