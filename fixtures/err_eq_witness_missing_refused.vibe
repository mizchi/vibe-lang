// A formal with an `Eq` bound that no parameter carries (#3302): no witness
// reaches the body, so `==` on a value of `Option[T]` there is refused at
// build time instead of comparing by identity.
fn no_carrier[T: Eq](n: Int) -> Bool {
  let x: Option[T] = None
  x == x
}

export let _start: () -> Int = () -> {
  0
}
