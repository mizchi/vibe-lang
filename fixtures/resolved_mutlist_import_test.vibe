import ./resolved_mutlist_support/operations.vibe {
  probe as direct_probe
}
import ./resolved_mutlist_support/reexport.vibe {
  probe as reexported_probe
}

fn MutList::push(a: Int, b: Int) -> Int {
  a - b
}

test "imported and re-exported MutList calls retain their module authority" {
  inspect(direct_probe(), content = "2")
  inspect(reexported_probe(), content = "2")
  inspect(MutList::push(7, 20), content = "-13")
}

test "a first-class program function retains a shadowed MutList spelling" {
  let subtract = MutList::push
  inspect(subtract(9, 2), content = "7")
}
