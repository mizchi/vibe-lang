// #3068: the same `Option[Int]` as err_interp_unrenderable_parse_call_refused,
// bound to an unannotated name first. The gc lane printed `177` here; both
// lanes now refuse the build, and the annotation named in the message fixes it.
export let _start: () -> Int = () -> {
  let p = Int::parse("42")
  let s = "\{p}"
  String::length(s)
}
