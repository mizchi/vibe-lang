// #3145: `Array::length` on an erased type parameter reached from ABOVE its
// declaration. The body binds the formal to `Array[_]` and the declaration's
// scheme carries that (#3149), but this caller was checked against the
// hoisted signature first -- measured, before the refusal this compiled and
// answered `0` for a one-entry map. Refused like the other Array readers
// (err_array_get_open_receiver_refused.vibe).
// The caller used to sit ABOVE the declaration; since #3378 that shape is
// refused at the declaration, so the caller is below it and `count` is
// exported: a caller through its contract is still only told `[T](T) -> Int`, so
// the `Array::length` on the formal is refused here.

export fn count[T](c: T) -> Int {
  Array::length(c)
}

export let _start: () -> Int = () -> {
  count([7])
}
