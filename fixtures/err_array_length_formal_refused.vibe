// #3145: `Array::length` on an erased type parameter. The checker binds the
// formal to `Array[_]` inside the body, but a caller still instantiates it
// with anything -- measured, this program compiled and answered `0` for a
// one-entry map. Refused like the other Array readers
// (err_array_get_open_receiver_refused.vibe).

fn count[T](c: T) -> Int {
  Array::length(c)
}

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  count(m)
}
