// #1720: an older inert-local proof must not authorize a same-named opaque
// binding. Before lexical classification this compiled to 3075; the source
// semantics would be 120.
effect Ask {
  Get(Int) -> Int
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  handle {
    let seed = perform Ask::Get(0)
    let pick = () -> Int {
      5
    }
    let pick = maker()
    let a = pick()
    seed + a * 10
  } with {
    Ask::Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
