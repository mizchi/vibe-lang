// Imported by match_scrutinee_temp_source_partial_let_test.vibe. An imported
// module is merged with its importer and printed back to source before the
// merged program is compiled, so this is where the printer's spelling of the
// match temporary is exercised: it must not capture the source `__mg` /
// `__mg_1` read in the arms.

export fn dep_pick(__mg: Int, __mg_1: Int, o: Option[Int]) -> Int {
  let Some(base) = Some(__mg)
  match o {
    Some(v) if v > 100 => v,
    Some(v) => match v {
      w if w > 50 => base + __mg_1,
      _ => base - __mg_1
    },
    None => __mg_1
  }
}
