// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let a = g
    let xs = [a]
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through alias in data" {
  inspect(result(), content = "106")
}
