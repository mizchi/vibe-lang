struct AliasResultSlot {
  callback: () -> Array[Int]
}

fn alias_result_identity[T](value: T) -> T {
  value
}

test "alias-result contracts preserve nominal payload provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    let slot = AliasResultSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }
    alias_result_identity(slot)
  }
  let _ = escaped.callback()
}
