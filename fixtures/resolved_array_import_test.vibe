import ./resolved_array_support/operations.vibe {
  probe as direct_probe
}
import ./resolved_array_support/reexport.vibe {
  probe as reexported_probe
}

fn Array::with_capacity(n: Int) -> Int {
  n + 20
}
fn Array::push(a: Int, b: Int) -> Int {
  a - b
}
fn Array::set(a: Int, b: Int, c: Int) -> Int {
  a - b - c
}

test "Array operations retain their authority across imports and re-exports" {
  inspect(direct_probe(), content = "13")
  inspect(reexported_probe(), content = "13")
  inspect(Array::with_capacity(4), content = "24")
  inspect(Array::push(7, 20), content = "-13")
  inspect(Array::set(7, 20, 3), content = "-16")
}

test "first-class program functions preserve shadowed Array names" {
  let reserve = Array::with_capacity
  let push = Array::push
  let set = Array::set
  inspect(reserve(3), content = "23")
  inspect(push(7, 20), content = "-13")
  inspect(set(7, 20, 3), content = "-16")
}

test "index write sugar targets the builtin under a program Array set" {
  let values = [29, 11]
  values[1] = 16
  inspect(values[0] - values[1], content = "13")
}
