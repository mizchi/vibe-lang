// JSON parsing and accessor tests
let obj = Json::parse("{\"name\":\"alice\",\"age\":30,\"active\":true,\"scores\":[1,2,3],\"meta\":null}")
let name = Json::string(Json::get(obj, "name"))
let age = Json::number(Json::get(obj, "age"))
let active = Json::bool(Json::get(obj, "active"))
let is_null = Json::is_null(Json::get(obj, "meta"))
let scores = Json::get(obj, "scores")
let s0 = Json::number(Json::index(scores, 0))
let len = Json::length(scores)
let obj_type = Json::type_of(obj)
let keys = Json::keys(obj)
let key_count = Array::length(keys)
