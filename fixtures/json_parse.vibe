// JSON parsing and accessor tests
let obj = from_json("{\"name\":\"alice\",\"age\":30,\"active\":true,\"scores\":[1,2,3],\"meta\":null}")
let name = json_string(json_get(obj, "name"))
let age = json_number(json_get(obj, "age"))
let active = json_bool(json_get(obj, "active"))
let is_null = json_is_null(json_get(obj, "meta"))
let scores = json_get(obj, "scores")
let s0 = json_number(json_index(scores, 0))
let len = json_length(scores)
let obj_type = json_type(obj)
let keys = json_keys(obj)
let key_count = array_length(keys)
key_count

