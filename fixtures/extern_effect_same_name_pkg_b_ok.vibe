// ADR-0124 (#4082): one package's `extern effect S3`, declared by its
// contract and its implementation, is one declaration, and another program
// may import the other package's `S3`
// (err_extern_effect_same_name_packages_refused.vibe imports both).
import ./modules/extern_same_name_pkg_b {
  S3, call_b
}

fn fetch(k: String) -> String with S3 {
  call_b(k = k)
}

fn main() -> Unit allows Console {
  println("ok")
}
