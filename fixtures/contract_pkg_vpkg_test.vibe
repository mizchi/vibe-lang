// #897 (ADR-0070 Phase 1): end-to-end contract package import through the
// `.vpkg` spelling. Mirrors ./contract_pkg_test.vibe (which exercises
// index.vibei) exactly, but the bare directory import here resolves to
// ./contract_pkg_vpkg/index.vpkg -- the loader must recognize `.vpkg` as an
// alternate spelling of `.vibei` for candidate resolution, conformance
// checking, and facade desugar, so this file compiles through the ordinary
// #716 merge machinery same as the .vibei package does.

import ./contract_pkg_vpkg {
  add, answer, clamp, counter_get, counter_new, point_sum, scale, struct Counter, struct Point
}

test "vpkg contract package resolves and its surface works (#897)" {
  assert_eq(add(40, 2), 42)
  assert_eq(scale(k = 6, v = 7), 42)
  assert_eq(clamp(99, 0, 42), 42)
}

test "transparent and opaque contract types via .vpkg (#897)" {
  let p = Point::{ x: 40, y: 2 }
  assert_eq(point_sum(p), 42)
  let c = counter_new(41)
  assert_eq(counter_get(c) + 1, 42)
}

test "vpkg contract value declaration (#897)" {
  // `let answer: Int` in the contract, `export let answer: Int = 42` in the
  // implementation -- values ride the same decl/facade machinery as fns.
  assert_eq(answer, 42)
}
