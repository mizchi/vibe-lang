// #763 review regression: a `for`-expression yields an array, so it must stay a
// valid left operand of an unambiguously-infix operator. The #760(5) loop-form
// ladder-stop (which keeps a trailing `-1`/`+1` a fresh statement) is now scoped
// to the `+`/`-` tokens only, so piping a for-expression parses and folds.
// See lib/@vibe/parser/parser_expr_core.vibe (left_is_stmt_form use).

test "for-expression pipes into a function" {
  let n = (for x in [1, 2, 3] { x }) |> Array::length
  assert_eq(n, 3)
}

test "for-expression result is the collected array" {
  let doubled = (for x in [1, 2, 3] { x * 2 }) |> Array::length
  assert_eq(doubled, 3)
}

// The #760(5) behaviour is preserved: a bare `-1` after a loop-form statement is
// still a fresh statement, not folded into `loop_result - 1`.
let after_for: () -> Int = () -> {
  let mut acc = 0
  for x in [1, 2, 3] {
    acc = acc + x
  }
  -1
}

test "bare -1 after a for statement is its own statement" {
  assert_eq(after_for(), -1)
}
