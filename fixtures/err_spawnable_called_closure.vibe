// #3152: a local closure CALLED inside the spawned body is a capture. The
// check used to skip every bare callee as if it were a top-level function,
// so the plain outer `Array` below crossed the spawn boundary through `bump`.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let bump = () -> {
      Array::set(seen, 0, 1)
      0
    }
    TaskHandle::join(TaskGroup::spawn(n, () -> bump()))
  })
  ()
}
