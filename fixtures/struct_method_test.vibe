// #1967: was fixtures/struct_method.vibe + __DATA__.last "52".
// Stale `let Vec2::add =` is rejected. Current `fn Vec2::add` keeps
// add(3,4)+(1,2) then length_sq as 52.

struct Vec2 { x: Int; y: Int }

fn Vec2::add(self: Vec2, other: Vec2) -> Vec2 {
  Vec2::{ x: self.x + other.x, y: self.y + other.y }
}

fn Vec2::length_sq(self: Vec2) -> Int {
  self.x * self.x + self.y * self.y
}

test "Vec2 add then length_sq is 52" {
  let a = Vec2::{ x: 3, y: 4 }
  let b = Vec2::{ x: 1, y: 2 }
  let c = Vec2::add(a, b)
  inspect(Vec2::length_sq(c), "52")
}
