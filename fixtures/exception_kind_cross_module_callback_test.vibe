// Codex on #3021: the row of a callback PARAMETER in a published type is
// resolved too, so a callback declared with the resolved kind is accepted
// even though the dependency's alias `E` is private to it.
import ./exception_kind_cross_module_callback_dep.vibe {
  IoErr, run_or_zero
}

fn fails() -> Int with Exception[IoErr] {
  throw(NotFound("x"))
}

test "a callback row's alias kind is resolved in the published type" {
  inspect(run_or_zero(fails), content = "0")
}

test "a pending throw kind inside a test block is settled" {
  // `x` is still open at the throw; `x + 1` pins it to Int afterwards.
  let r = handle {
    let go = (c: Bool, x) -> {
      if c {
        throw(x)
      } else {
        x + 1
      }
    }
    go(true, 41)
  } with { Exception[Int]::Throw(n) => n + 1 }
  inspect(r, content = "42")
}
