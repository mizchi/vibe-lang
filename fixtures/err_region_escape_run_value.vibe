// #3153: handing `TaskGroup::run` on as a value hides the body it will be
// applied to from the region-escape check, which runs at a call. Before the
// fix `apply1` returned the group's own `TaskHandle` out of its scope; the
// value is now refused where it is taken, with the edit that fixes it.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn apply1[A, B, e](f: (A) -> B with e, a: A) -> B with e {
  f(a)
}

fn main() -> Unit allows Exception {
  let h = apply1(TaskGroup::run, (g) -> TaskGroup::spawn(g, () -> 41))
  let _v = TaskHandle::join(h)
  ()
}
