// #3551: a generic `derive (Hash)` type with an `Array[T]` field and a written
// `Box::to_string`. The written renderer switched off the #3547 refusal, but
// the derived key does not call it: it keyed each element of the erased `T`
// by its address, so two equal `Box[Array[Int]]` values got two keys. The
// derive is refused unless `Box::hash_key` is written too.

struct Box[T] {
  xs: Array[T]
} derive(Hash)

fn Box::to_string(b: Box[Int]) -> String {
  "box"
}

export let _start: () -> Int = () -> {
  0
}
