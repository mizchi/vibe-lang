import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

effect Logger {
  A -> Int
  B -> Int
}

fn handle_alternatives() -> Int {
  handle {
    perform Logger::A
  } with Logger {
    A|B => resume(7)
  }
}

test "handler operation alternatives do not compete with enum patterns" {
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
