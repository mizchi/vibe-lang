struct Vec2 { x : Int; y : Int }
let Vec2::add = (self: Vec2, other: Vec2) -> Vec2 {
  Vec2::{ x: self.x + other.x, y: self.y + other.y }
}
let Vec2::length_sq = (self: Vec2) -> Int {
  self.x * self.x + self.y * self.y
}
let a = Vec2::{ x: 3, y: 4 }
let b = Vec2::{ x: 1, y: 2 }
let c = Vec2::add(a, b)
Vec2::length_sq(c)

