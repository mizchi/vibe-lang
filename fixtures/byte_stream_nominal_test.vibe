// #1954: byte conversion is exposed through the nominal ByteStream surface.
// Empty input pins EOS, and the non-ASCII case pins byte-exact round-tripping
// rather than code-point reconstruction.
test "nominal ByteStream preserves byte length" {
  let original = String::concat(String::from_char_code(195), String::from_char_code(169))
  let result = ByteStream::to_string(String::to_bytes(original))
  inspect(String::length(result), "2")
}

test "nominal ByteStream preserves the first byte" {
  let original = String::concat(String::from_char_code(195), String::from_char_code(169))
  let result = ByteStream::to_string(String::to_bytes(original))
  inspect(String::char_code_at(result, 0), "195")
}

test "nominal ByteStream preserves the second byte" {
  let original = String::concat(String::from_char_code(195), String::from_char_code(169))
  let result = ByteStream::to_string(String::to_bytes(original))
  inspect(String::char_code_at(result, 1), "169")
}

test "nominal ByteStream handles empty input as EOS" {
  inspect(String::length(ByteStream::to_string(String::to_bytes(""))), "0")
}
