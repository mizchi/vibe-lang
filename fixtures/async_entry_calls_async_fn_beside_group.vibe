// #3523 control: the boundary that an entry reaching an `Async` function now
// gets takes the suspend-class spelling, so a program that only imports the
// concurrency package and runs a plain group beside the call keeps
// compiling. The tail-resumptive spelling is lowered by the evidence pass,
// which cannot see through `TaskGroup::run`. 5 + 42 = 47. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn work() -> Int with Async {
  5
}

fn main() -> Int allows Async + Exception {
  let a = work()
  let b = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> 21 * 2)
    TaskHandle::join(h)
  })
  a + b
}
