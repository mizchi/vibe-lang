// Multi-shot: NOT possible with current implementation
// This is a documentation fixture showing the limitation
//
// Ideal:
//   effect Amb { Choose -> Bool }
//   handle {
//     let x = perform Amb::Choose
//     if x { 1 } else { 0 }
//   } { Amb::Choose(k) => k(true) + k(false) }
//   // result: 1 + 0 = 1
//
// Current: resume is single-shot (tail-resumptive only)
// Workaround: enumerate explicitly

effect Amb {
  Choose -> Bool
}

// Single-shot workaround: handler picks one branch
let a = handle {
  let x = perform Amb::Choose
  if x { 10 } else { 20 }
} { Amb::Choose => resume(true) }

let b = handle {
  let x = perform Amb::Choose
  if x { 10 } else { 20 }
} { Amb::Choose => resume(false) }

a + b

__DATA__
{"error_contains": "BadCall"}
