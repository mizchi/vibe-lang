// #3659: a builtin label that names its own slot is accepted, and the call
// answers exactly what the positional call does. Non-commutative operations
// throughout, so an argument that bound to the wrong slot would show.

test "labeled builtin calls answer like positional ones" {
  let xs: Array[Int] = [10, 20, 30]
  Array::push(xs, value = 40)
  Array::set(xs, at = 0, value = 5)
  inspect(Array::get(xs, at = 3), "40")
  inspect(Array::get(xs, at = 0), "5")
  inspect(String::substring("abcdef", start = 1, end = 4), "bcd")
  inspect(String::starts_with("vibe", prefix = "vi"), "true")
  inspect(String::index_of("banana", needle = "nan"), "2")
  inspect(Array::slice(xs, start = 1, end = 3), "[20, 30]")
  let parts = String::split("a,b,c", sep = ",")
  inspect(String::join(parts, sep = "-"), "a-b-c")
}
