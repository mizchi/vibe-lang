effect Ask {
  Get() -> Int
}

fn inner_handled() -> Int with Ask {
  handle {
    perform Ask::Get()
  } with {
    Ask::Get() => resume(42)
  }
}

fn outer(f: () -> Int with Ask) -> Int {
  handle {
    f()
  } with {
    Ask::Get() => resume(1)
  }
}

test "an explicit row-carrying closure preserves the inner handler" {
  inspect(outer(() -> Int with Ask { inner_handled() }), "42")
}
