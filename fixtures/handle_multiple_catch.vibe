let risky = (n: Int) -> Int with Error {
  if n < 0 { throw("negative") }
  if n == 0 { throw("zero") }
  n * 2
}

let a = handle { risky(5) } with Error { Throw(_) => -1 }
let b = handle { risky(0) } with Error { Throw(_) => -1 }
let c = handle { risky(-1) } with Error { Throw(_) => -1 }
a + b + c

