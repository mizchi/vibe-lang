test "MutList operations copy both exits before subsequent writes and region reuse" {
  let snapshots = region r {
    let values = MutList::empty(r)
    MutList::push(values, 7)
    MutList::push(values, 20)
    MutList::push(values, 30)
    inspect(MutList::get(values, 0) - MutList::get(values, 1), content = "-13")
    let frozen = MutList::freeze(values)
    let copied = MutList::to_array(values)
    MutList::truncate(values, 1)
    MutList::push(values, 99)
    inspect(MutList::length(values), content = "2")
    (frozen, copied)
  }
  let _ = region r {
    let replacement = MutList::empty(r)
    MutList::push(replacement, 42)
    MutList::length(replacement)
  }
  inspect(FrozenArray::length(snapshots.0), content = "3")
  inspect(FrozenArray::get(snapshots.0, 2), content = "30")
  inspect(Array::length(snapshots.1), content = "3")
  inspect(Array::get(snapshots.1, 0) - Array::get(snapshots.1, 1), content = "-13")
}
