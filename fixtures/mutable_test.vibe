//# Misc

test "let mut basic" {
  let mut x = 0
  x = 42
  assert(x == 42)
}

test "let mut increment" {
  let mut count = 0
  count += 1
  count += 1
  count += 1
  assert(count == 3)
}

test "let mut in while" {
  let sum = loop (i = 0, acc = 0) {
    if i >= 10 { break(acc) }
    continue(i + 1, acc + i)
  }
  assert(sum == 45)
}

test "let mut reassign" {
  let mut s = "hello"
  s = "world"
  assert(s == "world")
}

test "let mut with array" {
  let arr = [1, 2, 3, 4, 5]
  let total = Array::fold(arr, 0, _ + _)
  assert(total == 15)
}

test "nested mut scopes" {
  let mut a = 1
  let result = {
    let mut b = 10
    b += a
    b
  }
  assert(result == 11)
  assert(a == 1)
}

test "mut in if branches" {
  let mut x = 0
  if true {
    x = 10
  } else {
    x = 20
  }
  assert(x == 10)
}

test "mut accumulator pattern" {
  let product = loop (i = 1, acc = 1) {
    if i > 5 { break(acc) }
    continue(i + 1, acc * i)
  }
  assert(product == 120)
}

test "mut string builder pattern" {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "hello")
  StringBuilder::push(sb, " ")
  StringBuilder::push(sb, "world")
  let result = StringBuilder::freeze(sb)
  assert(result == "hello world")
}

test "mut flag pattern" {
  let arr = [3, 1, 4, 1, 5]
  let found = Array::any(arr, x -> x == 4)
  assert(found)
}
