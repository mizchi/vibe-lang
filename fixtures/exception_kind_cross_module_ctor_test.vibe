// #3028: a constructor signature and a type-alias body are published with
// their exception kinds RESOLVED. The dependency spells both through its
// private alias `E`; this module cannot see `E`, and names the type it
// stands for, `IoErr`.
import ./exception_kind_cross_module_ctor_dep.vibe {
  Callback, IoErr, Job, Run, run_callback, run_job
}

fn missing() -> Int with Exception[IoErr] {
  throw(NotFound("cfg"))
}

test "a constructor's callback row is published resolved" {
  inspect(run_job(Run(missing)), content = "3")
}

test "a type alias's function row is published resolved" {
  let f: Callback = missing
  inspect(run_callback(f), content = "103")
}
