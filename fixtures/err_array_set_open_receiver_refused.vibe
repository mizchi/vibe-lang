// #3139: `Array::set` written directly on a receiver whose type never
// resolves (here an erased type parameter) is refused like the index-write
// spelling in err_index_write_open_receiver_refused.vibe: handed a Map, it
// would write the map's backing store positionally.

fn put[T](c: T, i: Int, v: Int) -> Unit {
  Array::set(c, at = i, value = v)
}

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), key = "a", value = 1)
  put(c = m, i = 0, v = 99)
  Map::get(m, key = "a")
}
