import ./import_kind_phase1/private_enum_alias_facade.vibe { Api }
import ./import_kind_phase1/other_a_provider.vibe { Other }

test "distinct qualified patterns share a variant spelling" {
  let private_value = Api::A
  inspect(match private_value {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
  let public_value = Other::A
  inspect(match public_value {
    Other::A => 3
  }, content = "3")
}
