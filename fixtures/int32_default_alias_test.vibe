// #3824: the shipped `Default` imported under another name is the same
// trait, so `[T: D]` at `Int32` / `UInt32` is served by its `Int` impl too.
import @vibe/core {
  trait Default as D
}

fn fresh[T: D](_ witness: T) -> T {
  T::default()
}

test "an aliased shipped Default at Int32 / UInt32" {
  let a: Int32 = 9
  let z: Int32 = fresh(a)
  inspect(z, content = "0")
  let b: UInt32 = 9
  let w: UInt32 = fresh(b)
  inspect(w, content = "0")
}
