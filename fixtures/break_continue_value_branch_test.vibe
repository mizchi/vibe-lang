// `break` / `continue` as a branch of a value-position `if` / `match`.
fn sum_skipping_twos(xs: Array[Int]) -> Int {
  let mut s = 0
  for x in xs {
    let v = if x == 2 {
      continue
    } else {
      x
    }
    s = s + v
  }
  s
}

fn doubled_until_zero(xs: Array[Int]) -> Int {
  let mut s = 0
  for x in xs {
    let v = match x {
      0 => break,
      n => n * 2
    }
    s = s + v
  }
  s
}

fn count_while() -> Int {
  let mut i = 0
  let mut s = 0
  while i < 10 {
    i = i + 1
    let v = if i % 3 == 0 {
      continue
    } else if i > 7 {
      break
    } else {
      i
    }
    s = s + v
  }
  s
}

test "a diverging branch leaves the loop and the other branch is the value" {
  inspect(sum_skipping_twos([1, 2, 3, 2, 4]), "8")
  inspect(doubled_until_zero([1, 3, 0, 5]), "8")
  inspect(count_while(), "19")
}
