test "handle rethrow" {
  let fail = () -> Int with Exception {
    throw("original")
    0
  }
  let wrap = () -> Int with Exception {
    let x = handle {
      fail()
    } with { Exception::Throw(msg) => throw(String::concat("wrapped: ", msg)) }
    x
  }
  let result = handle {
    wrap()
  } with { Exception::Throw(msg) => String::length(msg) }
  inspect(result, "17")
}
