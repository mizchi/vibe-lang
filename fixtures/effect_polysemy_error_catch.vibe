// Polysemy-style Error effect with catch via handle
// Ported from polysemy test/ErrorSpec.hs
// throw/catch using handle { } with Exception { Throw(_) => ... }

let result = handle {
  let x = 10 / 2
  if x > 3 {
    throw("overflow")
  } else {
    x
  }
} with Exception {
  Throw(_msg) => -1
}
// x = 5, 5 > 3, throws "overflow", caught → -1
result

__DATA__
{"last": "-1"}
