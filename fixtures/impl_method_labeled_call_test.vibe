// An impl method body is parsed with the token offsets like any other body,
// so a labeled call in it finds the argument placement the checker recorded
// at that call. Before, the compile parse gave every call in a method body
// offset -1 and this file did not compile ("missing or invalid checker
// argument placement for `Array::get`").

trait Firstish {
  first_or(self: Self, d: Int) -> Int
}

struct Bag {
  xs: Array[Int]
}

fn scaled(_ x: Int, by: Int) -> Int {
  x * by
}

impl Firstish for Bag {
  first_or(self: Self, d: Int) -> Int {
    if Array::length(self.xs) > 0 {
      scaled(Array::get(self.xs, at = 0), by = 10)
    } else {
      d
    }
  }
}

test "a labeled call inside an impl method" {
  inspect(Bag::first_or(self = Bag::{ xs: [4, 5] }, d = 0), content = "40")
  inspect(Bag::first_or(self = Bag::{ xs: [] }, d = 7), content = "7")
}
