// ADR-0091 Phase 1 (red-first, positive): a genuinely allocation-free
// function under #zero_alloc compiles and runs. Expected: 42.
#zero_alloc
fn hot(a: Int, b: Int) -> Int {
  let s = a + b
  let t = s * 2
  t - a
}

export let main = () -> Int {
  hot(14, 14)
}

// #1571: the expectation lives here, checked by `inspect` and updatable with
// `vibe test --update`, instead of in a `__DATA__` tail the gate has to `sed`
// off and compare in shell.
test "zero alloc ok" {
  inspect(main(), "42")
}
