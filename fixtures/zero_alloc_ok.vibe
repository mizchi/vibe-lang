// ADR-0091 Phase 1 (red-first, positive): a genuinely allocation-free
// function under @zero_alloc compiles and runs. Expected: 42.
@zero_alloc
fn hot(a: Int, b: Int) -> Int {
  let s = a + b
  let t = s * 2
  t - a
}

let _start = () -> Int {
  hot(14, 14)
}

test "zero_alloc_ok.vibe produces its recorded value" {
  // #1571: the bare `_start()` call and the `__DATA__` tail collapsed into
  // this block. `vibe test --update` rewrites the literal.
  inspect(_start(), "42")
}
