// #3534 review (Codex): an alias of an alias -- `let again = spawn` after
// `let spawn = TaskGroup::spawn_suspend` -- names the same function, so a
// row-less task closure handed to `again` may `sleep` like one handed to
// `spawn`. The second alias was read as opaque, and the `sleep` was refused.
// Executed by tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh
// (want 42).
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let spawn = TaskGroup::spawn_suspend
    let again = spawn
    let h = again(g, () -> {
      sleep(1)
      41
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(h) + 1
  })
}
