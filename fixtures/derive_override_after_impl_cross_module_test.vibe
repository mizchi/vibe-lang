// #3551: a plain `P::to_string` written right after `impl Tag for P` in one
// module overrides the `derive (Show)` of `P` in another. `Tag` declares no
// `to_string`, so the definition is not the impl's method; the derive pass
// generates nothing next to it and both modules render through it. The
// overlap check used to take it for the impl's method, because it shares the
// `P::` prefix, and refused the derive as an overlapping impl.

import ./modules/derive_override_after_impl.vibe {
  after_impl_tag, after_impl_text
}

import ./modules/derive_override_owner.vibe {
  owner_text
}

test "a plain definition after an impl of another trait overrides a derive" {
  inspect("\{owner_text()} \{after_impl_text()} \{after_impl_tag()}", content = "custom custom 3")
}
