// #3032: `Iterator::map` / `Iterator::filter` results reached through the
// `trait Iterator` import render by content. They were refused at build time
// (#3212) because the interpolation pass had no shape for them; the checker's
// render row gives the element type.
import @vibe/builtin {
  trait Iterator
}

test "an Iterator::map result interpolates" {
  let mapped = Iterator::map([1, 2, 3], f = (x: Int) -> Int {
    x * 2
  })
  inspect("\{mapped}", content = "[2, 4, 6]")
}

test "an Iterator::filter result interpolates" {
  let filtered = Iterator::filter([1, 2, 3], pred = (x: Int) -> Bool {
    x > 1
  })
  inspect("\{filtered}", content = "[2, 3]")
}
