// #3538: an impl method is held to the signature its trait declares. These
// impls match it -- through `Self`, an applied trait argument, a generic
// impl's own formal and a static method -- and still compile and answer, both
// through the trait and through a bound.

trait Name {
  name(Self, Int) -> Int
}

trait Conv[A] {
  conv(Self) -> A
}

trait Measured {
  size(Self) -> Int
}

trait Make {
  make() -> Self
}

struct P { x: Int }

impl Name for P {
  name(self, k: Int) -> Int {
    k + self.x
  }
}

impl Conv[String] for P {
  conv(self) -> String {
    "P(\{self.x})"
  }
}

impl [T] Measured for Array[T] {
  size(self) -> Int {
    Array::length(self)
  }
}

impl Make for P {
  make() -> P {
    P::{ x: 7 }
  }
}

fn named[T: Name](v: T, k: Int) -> Int {
  T::name(v, k)
}

test "a matching impl answers through the trait" {
  inspect(Name::name(P::{ x: 1 }, 12345), "12346")
}

test "a matching impl answers through a bound" {
  inspect(named(P::{ x: 2 }, 40), "42")
}

test "an applied trait argument" {
  inspect(Conv::conv(P::{ x: 3 }), "P(3)")
}

test "a generic impl over Array[T]" {
  inspect(Measured::size([1, 2, 3]), "3")
}

test "a static method returning Self" {
  inspect(P::make().x, "7")
}
