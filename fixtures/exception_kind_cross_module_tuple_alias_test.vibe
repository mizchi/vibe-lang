// Codex on #3021: a tuple-alias kind in an imported row stays callable.
import ./exception_kind_cross_module_tuple_alias_dep.vibe {
  Pair, fail_pair
}

fn relay(n: Int) -> Int with Exception[Pair] {
  fail_pair(n)
}

test "an imported tuple-alias kind" {
  let r = handle { relay(1) } with { Exception[Pair]::Throw(p) => p.0 + p.1 }
  inspect(r, content = "3")
}
