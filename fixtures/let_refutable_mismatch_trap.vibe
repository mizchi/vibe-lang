// #3626: a refutable `let` whose pattern does not match names the pattern
// and its `path:line:col` before it traps, on linear and on gc. It used to
// trap with a bare `unreachable`. Pinned by the early gate: this program must
// FAIL at run time with that line.

fn next_of(o: Option[Int]) -> Int {
  let Some(v) = o
  v + 1
}

fn main allows Console {
  println("before \{next_of(Some(1))}")
  println("after \{next_of(None)}")
}
