// ADR-0071 (#755) step 5: the contract signature (below) uses the
// effectset alias `AskAll`; the implementation (impl.vibe) spells the same
// requirement out literally as `Ask::Get`. check_contract (contract.vibe)
// now expands both sides' effect row before comparing, so these are
// recognized as equivalent instead of a false "signature mismatch".
effect Ask {
  Get -> Int
}

effectset AskAll = { Ask::Get }

fn read_one() -> Int with AskAll
