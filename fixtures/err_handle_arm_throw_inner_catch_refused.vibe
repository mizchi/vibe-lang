// #3540: a handler arm's `throw` belongs to the code around its `handle`, but
// the in-place lowering ran this `Ask` arm inside `guarded`, whose
// `Exception[Int]` arm caught the String and doubled its pointer (measured
// `429496729604`). Running the arm at the handle needs the suspend driver,
// which does not take a handle that also has an exception arm, so the build
// is refused with the edit instead of answering.
effect Ask {
  Get() -> Int
}

fn guarded() -> Int with Ask {
  handle {
    perform Ask::Get() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

export let _start: () -> Int = () -> {
  handle {
    handle {
      guarded()
    } with {
      Ask::Get() => throw("mixed");
      Exception[String]::Throw(_) => -4
    }
  } with { Exception[String]::Throw(_) => -5 }
}
