// Generic effect: State with type parameter
effect State[S] {
  Get -> S;
  Put(S) -> Unit
}

// Counter using State[Int]
let count_up = () -> Int with State {
  let n = perform State::Get
  perform State::Put(n + 1)
  perform State::Get
}

let result = handle {
  count_up()
} with State {
  Get => resume(0);
  Put(_v) => resume(0)
}
result

__DATA__
{"last": "()"}
