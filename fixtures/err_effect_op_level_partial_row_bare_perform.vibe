// #1161 (Codex review of #1157's fix): when the declared row already names
// ONE operation of an effect at operation granularity (`with { Ask::Other
// }`) and the function bare-`perform`s a DIFFERENT operation of the same
// effect (`Ask::Get`), the fix-it must grant only the missing operation
// (`Ask::Get`), not widen to the whole effect (`Ask`) -- per
// docs/effectset.md's operation-level diagnostic contract, over-granting
// the whole effect needlessly expands the caller's capability surface.
// needle: "missing { Ask::Get } (declared with { Ask::Other }, requires { Ask::Get, Ask::Other })"
// needle: "hint: add 'with { Ask::Get, Ask::Other }' to 'asks'"
effect Ask {
  Get -> Int
  Other -> Int
}

fn asks() -> Int with Ask::Other {
  perform Ask::Get
}
