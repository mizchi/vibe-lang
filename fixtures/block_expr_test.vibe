//# Misc

test "block expression returns last value" {
  let result = {
    let a = 10
    let b = 20
    a + b
  }
  assert(result == 30)
}

test "block expression in if" {
  let x = 5
  let result = if x > 0 {
    let doubled = x * 2
    doubled + 1
  } else {
    0
  }
  assert(result == 11)
}

test "nested block expressions" {
  let result = {
    let a = {
      let x = 1
      x + 2
    }
    let b = {
      let y = 10
      y + 20
    }
    a + b
  }
  assert(result == 33)
}

test "block in match arm" {
  let x: Option[Int] = Some(5)
  let result = match x {
    Some(n) => {
      let doubled = n * 2
      doubled + 1
    },
    None => 0
  }
  assert(result == 11)
}

test "block with mutation" {
  let result = {
    let mut sum = 0
    let mut i = 1
    while i <= 5 {
      sum += i
      i += 1
    }
    sum
  }
  assert(result == 15)
}
