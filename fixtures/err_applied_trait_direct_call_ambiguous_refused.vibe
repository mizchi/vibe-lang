// #3616: `Both` has two applied impls of `Value`, and `Value::value(both)`
// passes nothing but the receiver, so no argument of the call says which one
// it means. The build refuses it, naming the edit (a bound fixes the trait's
// argument), rather than picking one. Before, the refusal named an edit that
// does not exist ("add a body for `value` to `impl Value for Both`"). The
// accepted side is `fixtures/applied_trait_direct_call_selects_impl_test.vibe`.

trait Value[A] {
  value(Self) -> A
}

struct Both {
  number: Int;
  text: String
}

impl Value[Int] for Both {
  value(self: Both) -> Int {
    self.number
  }
}

impl Value[String] for Both {
  value(self: Both) -> String {
    self.text
  }
}

fn main() -> Unit allows Console {
  let both = Both::{ number: 42, text: "vibe" }
  let n: Int = Value::value(both)
  println("\{n}")
}
