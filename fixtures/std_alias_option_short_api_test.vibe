import @vibe/builtin {
  is_some, map_or, unwrap_or
}

test "std alias option short api" {
  let a = Some(1) |> is_some
  let b = None |> unwrap_or(default = 7)
  let c = Some("abc") |> map_or(default = 0, f = (s) -> String::length(s))
  inspect(if a && eq(b, 7) && eq(c, 3) {
    "ok"
  } else {
    "ng"
  }, "ok")
}
