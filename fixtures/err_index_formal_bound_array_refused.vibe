// #3156 review: `x[0]` on a type formal the body has ALREADY unified with an
// Array (through `require_array`, an ordinary function taking `Array[E]`).
// The substitution answers `Array[_]` at the index, so the site was taken as
// settled array indexing and filed nothing -- but the call to `first` sits
// ABOVE its declaration and was checked against the hoisted signature
// `[T](T) -> Int`, so a Map reached the body and the index read its backing
// store by position (`Array::get: index 0 out of bounds for length 0`). The
// site is refused now; declared first, the Map argument is a type error at
// the call instead (fixtures/typecheck/index_formal_bound_array_scheme_reject).

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  first(m)
}

fn require_array[E](xs: Array[E]) -> Unit {
  ()
}

fn first[T](x: T) -> Int {
  require_array(x)
  x[0]
}
