import ./import_kind_phase1/sibling_choice.vibe {
  answer
}
import ./import_kind_phase1/reexport.vibe {
  PublicChoice, is_first
}

test "a re-exported enum keeps its origin with reversed import order" {
  inspect(answer, content = "99")
  inspect(is_first(PublicChoice::First), content = "true")
  inspect(is_first(PublicChoice::Second), content = "false")
  inspect(match PublicChoice::First {
    PublicChoice::First => "first",
    PublicChoice::Second => "second"
  }, content = "first")
}
