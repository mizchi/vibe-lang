//# Codex on #3995: an alias that expands past the canonical key's old
//# 4096-node budget but stays under the checker's alias preflight (262144).
//# The impl's key and the bound's key are both written through it and both
//# canonicalized the same way, so the impl is found.
type A0 = Int

type A1 = (A0, A0)

type A2 = (A1, A1)

type A3 = (A2, A2)

type A4 = (A3, A3)

type A5 = (A4, A4)

type A6 = (A5, A5)

type A7 = (A6, A6)

type A8 = (A7, A7)

type A9 = (A8, A8)

type A10 = (A9, A9)

type A11 = (A10, A10)

type A12 = (A11, A11)

trait Mark[X] {
  mark(Self) -> Int
}

struct Note {
  n: Int
}

impl Mark[A12] for Note {
  mark(self) -> Int {
    self.n
  }
}

fn marked[T: Mark[A12]](_ t: T) -> Int {
  T::mark(t)
}

test "a large alias in an impl and a bound" {
  inspect(marked(Note::{ n: 7 }), content = "7")
}
