struct FieldSlot {
  callback: () -> Array[Int]
}

test "bound named struct fields preserve provenance through aliases" {
  let escaped = region r {
    let values = MutList::empty(r)
    let slot = FieldSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }
    let alias = slot
    alias.callback
  }
  let _ = escaped()
}
