trait Weird {
  add(Self, Self) -> Self
}
impl Weird for Float {
  add(a: Float, b: Float) -> Float {
    99.0f
  }
}
trait First: Add + Weird
trait Second: Weird + Add
impl First for Float
impl Second for Float
fn first[T: First](a: T, b: T) -> T {
  a + b
}
fn second[T: Second](a: T, b: T) -> T {
  a + b
}
test "the first retained method controls inherited addition" {
  inspect(first(0.1f, 0.2f), content = "0.3")
  inspect(second(0.1f, 0.2f), content = "99")
}
