trait Weird {
  add(Self, Self) -> Self
}
impl Weird for Float32 {
  add(a: Float32, b: Float32) -> Float32 {
    99.0f
  }
}
trait First: Add + Weird
trait Second: Weird + Add
impl First for Float32
impl Second for Float32
fn first[T: First](a: T, b: T) -> T {
  a + b
}
fn second[T: Second](a: T, b: T) -> T {
  a + b
}
test "the first retained method controls inherited addition" {
  inspect(first(a = 0.1f, b = 0.2f), content = "0.3")
  inspect(second(a = 0.1f, b = 0.2f), content = "99")
}
