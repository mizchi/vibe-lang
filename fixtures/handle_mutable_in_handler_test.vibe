// #1973: was fixtures/handle_mutable_in_handler.vibe + __DATA__.last "0".
// The generated assertion trapped because that last value was stale: the
// handler reads `count` after the body increments it, so the result is 1.

test "Exception handler sees mut updates from the handle body" {
  let mut count = 0
  let result = handle {
    count = count + 1
    throw("err")
    0
  } with Exception {
    Throw(_) => count
  }
  inspect(result, "1")
}
