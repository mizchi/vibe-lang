// ADR-0090 MutBytes: a closure that captures the region buffer must not
// leave the region (the arena release would dangle its captured storage).
// Pins the esc_is_region_tainted_init name check in checker_escape.vibe --
// dropping "MutBytes::empty" from that predicate makes exactly this leak
// compile again.
//   error_contains: "region escapes its scope"
fn probe() -> Int {
  let f = region r {
    let b = MutBytes::empty(r)
    () -> {
      MutBytes::length(b)
    }
  }
  f()
}
