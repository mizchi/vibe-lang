// #3552 review (Codex): a row-less task closure handed to a LOCAL alias of
// `TaskGroup::spawn_suspend` runs where `Async` is handled, like one handed to
// the function by name. The checker read no parameter types through the alias,
// so the `sleep` in it was refused as "passed where no `Async` is expected".
// Executed by tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh
// (want 42).
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let spawn = TaskGroup::spawn_suspend
    let h = spawn(g, () -> {
      sleep(1)
      41
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(h) + 1
  })
}
