//# Functions

// might_fail: (Int) -> Int with Exception
fn might_fail(x: Int) -> Int with Exception {
  if x == 0 {
    throw("zero error")
  } else x
}

//# Misc

test "handle error recovery" {
  let result = handle {
    might_fail(0)
  } with Exception {
    Throw(_) => 99
  }
  assert(result == 99)
}

test "handle success passthrough" {
  let result = handle {
    might_fail(42)
  } with Exception {
    Throw(_) => 0
  }
  assert(result == 42)
}

test "throw and handle" {
  let safe_div: (Int, Int) -> Int = (a, b) -> {
    handle {
      if b == 0 {
        throw("div by zero")
        0
      } else a / b
    } with Exception {
      Throw(_) => -1
    }
  }
  assert(safe_div(10, 2) == 5)
  assert(safe_div(10, 0) == -1)
}

test "nested handle" {
  let inner: () -> Int with Exception = () -> {
    throw("inner")
    0
  }
  let outer = handle {
    handle {
      inner()
    } with Exception {
      Throw(_) => 42
    }
  } with Exception {
    Throw(_) => 0
  }
  assert(outer == 42)
}

test "error does not propagate past handle" {
  let f: () -> Int with Exception = () -> {
    throw("oops")
    0
  }
  let result = handle {
    f() + 10
  } with Exception {
    Throw(_) => 100
  }
  assert(result == 100)
}
