type Small = Float32
fn sum[T: Add](a: T, b: T) -> T {
  a + b
}
fn same_small[T: Eq](a: T, b: T) -> Bool {
  a == b
}

test "Float traits accept a source alias" {
  let a: Small = 0.1f
  let b: Small = 0.2f
  inspect(sum(a = a, b = b), content = "0.3")
  inspect(same_small(a = a, b = a), content = "true")
}
