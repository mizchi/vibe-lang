// #1541 generic coexistence: a source-level generic that never carries a
// reference-lane value no longer disables the private direct Array[Int]
// island. The generic keeps the tagged-i64 representation; the array crossing
// keeps its typed wasm-gc reference, and mutation through the callee parameter
// stays visible through the caller binding.
//
// Pair this with fixtures/gc_direct_array_argument_fallback_test.vibe: there
// the generic itself carries the Array[Int], which is the crossing that still
// has no conversion point and still clears the whole component.

fn describe[T](value: T, label: String) -> String {
  let _ = value
  label
}

fn mutate_second(values: Array[Int]) -> Unit {
  Array::set(values, 1, 3)
}

test "gc direct array island survives an unrelated generic" {
  let original = [
    40,
    2
  ]
  mutate_second(original)
  inspect(describe(7, "ok"), "ok")
  inspect(Array::get(original, 0), "40")
  inspect(Array::get(original, 1), "3")
}
