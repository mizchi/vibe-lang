// #3191: an owning call on a binding carried into a loop must take exactly
// one reference per iteration. A second call after the loop keeps that
// binding live, so the plan cannot treat the loop call as its last use.
enum D {
  A(Array[Int])
}

fn second(d: D) -> Int {
  match d {
    A(xs) => Array::get(xs, 1)
  }
}

fn hold(d: D) -> D {
  d
}

fn one_round() -> Int {
  let p = A([7, 11])
  let mut i = 0
  let mut total = 0
  while i < 3 {
    total = total + second(hold(p))
    i = i + 1
  }
  total + second(p)
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + one_round()
    i = i + 1
  }
  total
}
