// #3176: the tail-resumptive twin of
// err_pure_builtin_spelling_rowvar_suspend_refused.vibe. The evidence pass
// took the program's own row-variable `Future::ready` for the audited pure
// builtin, so it admitted a literal argument that performs `Ask`: measured on
// main at 05f044574 the program compiled and trapped at run time with `null
// function or function signature mismatch`. Spelled `relay` it is refused at
// build time, and so is this one now.

effect Ask {
  Get(Int) -> Int
}

fn Future::ready(n: Int, g: (Int) -> Int with e) -> Int with e {
  g(n) + 100
}

let run = () -> Int {
  let base = 0
  handle {
    let a = 1 + Future::ready(5, (y: Int) -> Int with Ask { perform Ask::Get(y) + base })
    a
  } with {
    Ask::Get(n) => resume(n * 2)
  }
}

let _start = () -> Int {
  run()
}
