//# Codex round 15 on #2456: a source-owned `Option` of a shape the special
//# arm does not match is an ordinary generic enum, and a phantom one --
//# `enum Option[T] { Mark(Int); Empty }` -- has a derived comparator that
//# never reads `T`. Its argument may therefore be anything the allow-list
//# rejects on its own (an opaque `StringBuilder` here): only the observed
//# positions count, exactly as for the same-shaped `enum Marker[T]`.
//# Measured on fd9cdcc: `Array[Option[StringBuilder]]` filled through a
//# helper trapped while `Array[Marker[StringBuilder]]` answered. Both ANSWER
//# now, and the `Int` payload is exact for `64 << 32` vs `65 << 32`.

enum Option[T] {
  Mark(Int);
  Empty
}

fn fill(xs: Array[Option[StringBuilder]], v: Int) -> Unit {
  Array::push(xs, Mark(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
