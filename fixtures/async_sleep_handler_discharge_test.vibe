/// ADR-0089 Decision 1, increment 2 (#1218): a `handle ... with Async`
/// discharges the builtin `Async` row -- the enclosing function needs no
/// `with Async` -- and the handler REALLY receives the operations:
/// `sleep(ms)` reaches the arm as `Suspend(-ms)` (the sleep-debt payload
/// convention) instead of blocking on the host. The arm accumulates the
/// requested milliseconds and resumes immediately, so the program proves
/// both interception (the accumulated total is part of the answer) and
/// non-blocking behavior (a wall-clock-fast run despite 35ms of nominal
/// sleep). 7 + 20 + 15 = 42.
fn main() -> Int {
  let acc = [
    0
  ]
  let r = handle {
    sleep(20)
    sleep(15)
    7
  } with Async {
    Suspend(req) => {
      Array::set(acc, 0, Array::get(acc, 0) + (0 - req))
      resume(0)
    }
  }
  r + Array::get(acc, 0)
}
