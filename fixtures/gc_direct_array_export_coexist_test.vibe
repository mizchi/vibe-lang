// #1541 export coexistence: a public declaration crosses a host boundary whose
// ABI is tagged i64, so it cannot carry a reference -- but it no longer takes
// the rest of the component down with it. The exported function keeps the
// signature it always had; private crossings beside it keep the reference lane.
//
// Piping a private reference THROUGH the exported declaration used to clear
// the whole component; #1722 monomorphized the export boundary so references
// cross it, and the fallback fixture that pinned the old behaviour was deleted
// (docs/internal/compiler/gc-value-abi.md).

export let public_array_summary: (Array[Int]) -> Int = (values) -> Array::length(values) + Array::get(values, 0)

fn mutate_second(values: Array[Int]) -> Unit {
  Array::set(values, 1, 3)
}

test "gc direct array island survives beside an exported declaration" {
  let original = [
    40,
    2
  ]
  mutate_second(original)
  inspect(Array::get(original, 0), "40")
  inspect(Array::get(original, 1), "3")
}
