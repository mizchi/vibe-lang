// #3551 review: a field keyed by an impl for its application
// (`impl Hash for Box[Int]`) is keyed by it even when the type also has a
// written `hash_key` the derived key cannot call
// (`fn Box::hash_key(x: Int) -> String`). The two have different bindings, and
// the unusable one used to refuse the field before the matching impl was
// consulted. A field only the unusable one could key is still refused
// (`typecheck/derive_hash_applied_beside_unusable_reject.vibe`).

import @vibe/core {
  has_by, set_by
}

struct Box[T] {
  v: T
} derive (Show)

fn Box::hash_key(x: Int) -> String {
  "n" + Int::to_string(x)
}

impl Hash for Box[Int] {
  hash_key(self) -> String {
    let b: Box[Int] = self
    "b" + Int::to_string(b.v)
  }
}

struct Outer {
  b: Box[Int]
} derive (Hash)

test "the matching impl keys the field beside an unusable hash_key" {
  let o = Outer::{ b: Box::{ v: 4 } }
  inspect(Outer::hash_key(o), content = "2:b4")
  inspect(has_by(set_by(Map::new(), o, 1), Outer::{ b: Box::{ v: 4 } }), content = "true")
  inspect(Box::hash_key(3), content = "n3")
}
