// Generic Channel effect: send/receive typed messages
effect Channel[T] {
  Send(T) -> Unit;
  Receive -> T
}

// Int channel: send 3 values, receive last
let result = handle {
  perform Channel::Send(10)
  perform Channel::Send(20)
  perform Channel::Receive
} with {
  Channel::Send(_v) => resume(0);
  Channel::Receive => resume(99)
}
result

__DATA__
{"last": "99"}
