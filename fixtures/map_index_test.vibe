// #760(3) / #3133: `m[k]` on a Map. The parser desugars index syntax `m[k]` to
// `__index(m, k)`, whose codegen array-indexes the receiver -- on a Map that
// reads the backing store positionally (a wrong value, or an out-of-bounds
// trap). desugar_trait_dict rewrites `__index(m, k)` to `Map::get(m, k)` when
// the CHECKER typed the receiver as a Map (#3133), whatever it is spelled: a
// `StringMap[V]` annotation, a function's result, a struct field, an
// unannotated parameter, a `match` binder, a type alias. Before #3133 only a
// `Map::new()` literal or a `Map[..]`-annotated name was recognised, from
// syntax, and every other Map was array-indexed. A receiver whose type never
// resolves is refused at build time (err_map_index_open_receiver_refused.vibe).
// A non-Map receiver is left as array indexing, so `a["x"]` on an Array is
// still a type error. See map_index_rewrite in desugar_trait_dict.vibe.

test "map index by string literal" {
  let m: Map[String, Int] = Map::from_pairs([("a", 1), ("b", 2)])
  assert_eq(m["a"], 1)
  assert_eq(m["b"], 2)
}

test "map index by string variable" {
  let m: Map[String, Int] = Map::from_pairs([("x", 10), ("y", 20)])
  let k = "y"
  assert_eq(m[k], 20)
}

test "map index and Map::get agree" {
  let m: Map[String, Int] = Map::from_pairs([("k", 42)])
  assert_eq(m["k"], Map::get(m, "k"))
}

test "map index after set" {
  let m: Map[String, Int] = Map::from_pairs([("p", 1)])
  let m2 = Map::set(m, "q", 2)
  assert_eq(m2["q"], 2)
  assert_eq(m2["p"], 1)
}

// Regression guard: ordinary Int-indexed array/bytes access must NOT be
// rewritten to Map::get.
test "array index unaffected" {
  let a = [10, 20, 30]
  assert_eq(a[0], 10)
  let i = 2
  assert_eq(a[i], 30)
}

test "bytes index unaffected" {
  let b = Bytes::from_array([65, 66, 67])
  assert_eq(b[1], 66)
}

// #3133: the receiver is a Map by TYPE, not by spelling.

struct Holder {
  tbl: StringMap[Int]
}

struct ArrHolder {
  xs: Array[Int]
}

type Env = StringMap[Int]

fn make_map() -> StringMap[Int] {
  Map::set(Map::set(Map::new(), "a", 11), "b", 22)
}

fn make_arr() -> Array[Int] {
  [4, 5, 6]
}

test "StringMap annotation" {
  let m: StringMap[Int] = Map::set(Map::new(), "k", 7)
  inspect(m["k"], content = "7")
}

test "map returned from a function" {
  inspect(make_map()["b"], content = "22")
  let m = make_map()
  inspect(m["a"], content = "11")
}

test "map in a struct field" {
  let h = Holder::{ tbl: make_map() }
  inspect(h.tbl["b"], content = "22")
  let read = (hh: Holder) -> Int {
    hh.tbl["a"]
  }
  inspect(read(h), content = "11")
}

test "annotated lambda parameter" {
  let f = (mm: StringMap[Int]) -> Int {
    mm["b"]
  }
  inspect(f(make_map()), content = "22")
}

test "map inside Option, read through a match binder" {
  let o: Option[StringMap[Int]] = Some(make_map())
  let v = match o {
    Some(mm) => mm["a"],
    None => 0
  }
  inspect(v, content = "11")
}

test "map through a type alias" {
  let e: Env = make_map()
  inspect(e["b"], content = "22")
}

test "map value type flows from the index" {
  let names: StringMap[String] = Map::set(Map::new(), "id", "vibe")
  let n = names["id"]
  inspect(String::length(n), content = "4")
}

test "array returned from a function" {
  inspect(make_arr()[2], content = "6")
  let a = make_arr()
  inspect(a[0], content = "4")
}

test "array in a struct field" {
  let h = ArrHolder::{ xs: make_arr() }
  inspect(h.xs[1], content = "5")
}

test "array inside Option, nested arrays, strings" {
  let o: Option[Array[Int]] = Some(make_arr())
  let w = match o {
    Some(xs) => xs[2],
    None => 0
  }
  inspect(w, content = "6")
  let nested = [[1, 2], [3, 4]]
  inspect(nested[1][0], content = "3")
  let s = "abc"
  inspect(s[1], content = "98")
}

// #3139: a top-level binding read and written ABOVE its declaration. The hoist
// used to type it as nothing, so the index lowering could not tell it from a
// map and refused both sites; it now hoists the literal's container head.
fn fwd_first() -> Int {
  fwd_tbl[0]
}

fn fwd_bump() -> Unit {
  fwd_tbl[1] = fwd_tbl[1] + 1
}

fn fwd_lookup() -> Int {
  fwd_map["k"]
}

let fwd_tbl = [5, 6]

let fwd_map = Map::from_pairs([("k", 9)])

test "top-level array and map referenced above their declarations" {
  inspect(fwd_first(), content = "5")
  fwd_bump()
  inspect(fwd_tbl[1], content = "7")
  inspect(fwd_lookup(), content = "9")
}

// #3139: index WRITES over a typed Array keep working; only a receiver whose
// type never resolves is refused (err_index_write_open_receiver_refused.vibe,
// err_array_set_open_receiver_refused.vibe).
test "array index write through typed receivers" {
  let a = make_arr()
  a[0] = 40
  inspect(a[0], content = "40")
  let h = ArrHolder::{ xs: make_arr() }
  h.xs[2] = 60
  inspect(h.xs[2], content = "60")
  let o: Option[Array[Int]] = Some(make_arr())
  match o {
    Some(xs) => {
      xs[1] = 50
      inspect(xs[1], content = "50")
    },
    None => ()
  }
  let set_first = (xs: Array[Int], v: Int) -> {
    Array::set(xs, 0, v)
  }
  set_first(a, 7)
  inspect(a[0], content = "7")
}

// #3145: the builtin `Array::*` readers keep working wherever the Array
// argument's type is known -- a generic `Array[T]` parameter, an annotated
// lambda parameter, a function's result. Only a receiver whose type never
// resolves is refused (err_array_get_open_receiver_refused.vibe,
// err_array_length_formal_refused.vibe).
fn arr_last[T](xs: Array[T]) -> T {
  Array::get(xs, Array::length(xs) - 1)
}

test "Array readers over typed receivers" {
  inspect(arr_last(make_arr()), content = "6")
  let total = (xs: Array[Int]) -> Int {
    Array::fold(xs, 0, (acc, x) -> acc + x)
  }
  inspect(total(make_arr()), content = "15")
  inspect(Array::length(Array::concat(make_arr(), Array::reverse(make_arr()))), content = "6")
  inspect(Array::get(Array::slice(make_arr(), 1, 3), 0), content = "5")
}
