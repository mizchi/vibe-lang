// #2652: `Double::to_string` is shortest-round-trip and `Double::parse` is
// correctly rounded, on every lane (the gate runs this file on bump, RC and
// gc).
//
// Before this, the formatter was a fixed 15-digit fraction over
// `Double::to_int`: `2.2250738585072014` printed as `2.225073858507201`,
// `1e300` as `0` and `-1e300` as `-0` -- silently, on values whose bits were
// fine (P0). The expected strings below are JavaScript's `Number::toString`
// answers (the same shortest digits Ryu produces), taken on 2026-09-12 for
// the value with exactly these bits; the parse table expects the bits
// `Number(s)` yields. `Double::from_i64_bits_lohi` (#2651) makes the inputs
// exact, so a case cannot drift with the formatter under test.
//
// The one deliberate difference from JavaScript: negative zero prints `-0`
// (JavaScript prints `0`), because that is the value held and the spelling
// that reads back as -0.0.

fn parse_desc(s: String) -> String {
  match Double::parse(s) {
    None => "None",
    Some(d) => if d != d {
      "NaN"
    } else {
      "\{Double::to_i64_bits_hi(d)}:\{Double::to_i64_bits_lo(d)}"
    }
  }
}

fn pow10(n: Int) -> Double {
  let mut r = 1.0
  let mut i = 0
  while i < n {
    r = r * 10.0
    i = i + 1
  }
  r
}

test "#2652 the values the issue measured" {
  inspect(Double::to_string(0.0), content = "0")
  inspect(Double::to_string(1.5), content = "1.5")
  inspect(Double::to_string(0.0 - 1.5), content = "-1.5")
  inspect(Double::to_string(0.1), content = "0.1")
  inspect(Double::to_string(3.141592653589793), content = "3.141592653589793")
  inspect(Double::to_string(2.2250738585072014), content = "2.2250738585072014")
  // `pow10(300)` by repeated multiplication is one ulp above 1e300 (the
  // issue's own "computed" input carries the same bits, lo = 2281731485), and
  // JavaScript prints that value exactly this way; the exact 1e300 is in the
  // bit-pattern table below.
  inspect(Double::to_string(pow10(300)), content = "1.0000000000000002e+300")
  inspect(Double::to_string(0.0 - pow10(300)), content = "-1.0000000000000002e+300")
  inspect(Double::to_string(1.0 / pow10(300)), content = "9.999999999999999e-301")
  inspect(Double::to_string(Double::from_i64_bits_lohi(2281731484, 2117592124)), content = "1e+300")
  inspect(Double::to_string(Double::from_i64_bits_lohi(2281731484, 4265075772)), content = "-1e+300")
  inspect(Double::to_string(Double::from_i64_bits_lohi(3271095129, 27618847)), content = "1e-300")
  inspect(Double::to_string(0.1 + 0.2), content = "0.30000000000000004")
  inspect(Double::to_string(1.0 / 3.0), content = "0.3333333333333333")
  inspect(Double::to_string(pow10(300) * pow10(300)), content = "Infinity")
  inspect(Double::to_string(0.0 - pow10(300) * pow10(300)), content = "-Infinity")
  inspect(Double::to_string(0.0 / 0.0), content = "NaN")
  inspect(Double::to_string(0.0 * (0.0 - 1.0)), content = "-0")
}

test "#2652 the formatter reaches interpolation and __to_string" {
  let x = 2.2250738585072014
  let big = pow10(21)
  inspect("\{x}", content = "2.2250738585072014")
  inspect("\{big}", content = "1e+21")
  inspect("\{pow10(20)}", content = "100000000000000000000")
  inspect(__to_string(1.0 / pow10(7)), content = "1e-7")
  inspect(__to_string(1.0 / pow10(6)), content = "0.000001")
  inspect(0.5, content = "0.5")
  inspect(1.0, content = "1")
}

