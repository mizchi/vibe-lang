  let mut i = 0
  while i < Array::length(bits) {
    let (lo, hi) = Array::get(bits, i)
    let d = Double::from_i64_bits_lohi(lo, hi)
    let printed = Double::to_string(d)
    match Double::parse(printed) {
      None => inspect(printed, content = "<parsed>"),
      Some(back) => {
        inspect(Double::to_i64_bits_hi(back) == hi, content = "true")
        inspect(Double::to_i64_bits_lo(back) == lo, content = "true")
      }
    }
    i = i + 1
  }
  inspect(i, content = "230")
