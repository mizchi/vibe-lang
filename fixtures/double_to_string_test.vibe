// #744 regression: `__to_string(Double)` (and thus string interpolation of a
// Double) used to stringify the raw f64 bit pattern as an integer —
// `"\{42.0}"` printed "4631107791820423168". Now a statically-floatish
// argument takes a synthesized fixed-precision formatter: exact integer part,
// 15 fractional digits with trailing zeros trimmed.

test "interpolated double literals" {
  assert("\{0.0}" == "0")
  assert("\{42.0}" == "42")
  assert("\{3.14}" == "3.14")
  assert("\{-1.5}" == "-1.5")
  assert("\{0.0125}" == "0.0125")
}

test "to_string of float-typed locals" {
  let x = 1.25 / 100.0
  assert(__to_string(x) == "0.0125")
  let y = 2.5 * 2.0
  assert("value=\{y}" == "value=5")
}

// The dispatch is SHAPE-based (float literal / float-tracked local slot /
// float arithmetic / the to_double conversion builtins / annotated float
// param). A bare USER-function call result is not tracked — bind it through
// float arithmetic (`* 1.0`) or pass it to a Double-annotated param before
// interpolating.
let fmt_param = (v: Double) -> String {
  "\{v}"
}

test "to_string of float call results" {
  assert("\{Int::to_double(7)}" == "7")
  let scale = (v: Double, by: Double) -> Double {
    v * by
  }
  assert(fmt_param(scale(1.5, 3.0)) == "4.5")
}

// Separate bug found while testing this: LAMBDA params annotated
// Float/Double were never seeded into float_local_slots (only top-level fn
// params were, after the rc_float_param_eq fix), so a local closure's
// `v * by` compiled as an INTEGER multiply of the f64 bits.
test "local lambda float params compute float math" {
  let scale2 = (v: Double, by: Double) -> Double {
    v * by
  }
  assert(eq(scale2(1.5, 3.0), 4.5))
  assert(eq(scale2(0.5, 0.25), 0.125))
}

test "negative fraction and carry" {
  assert("\{-0.25}" == "-0.25")
  // 0.1 + 0.2 = 0.30000000000000004 in f64; 15-digit rounding trims it back.
  let z = 0.1 + 0.2
  assert("\{z}" == "0.3")
}

// #1153/#1185: an explicitly `: Double`/`: Float`-ANNOTATED local `let` was
// the one shape missing from the "dispatch is SHAPE-based" list above.
// `let x: Double = e` parses to the ascription marker
// `((__asc: Double) -> __asc)(e)` (parser_expr_dispatch's ascribe_wrap) --
// expr_is_floatish's ECall case never recognized this wrapper (it already
// did for `Bool`, #815, just never extended to Double/Float), so an
// annotated Double local's slot was invisible to float_local_slots. Under
// RC a float is a BOXED heap value (#704): `__to_string`/interpolation
// read the boxed pointer as a plain Int (garbage output, #1153), and `==`
// between two such misclassified slots fell through to the generic `eq`
// fallback, which compares the two distinct boxes by pointer rather than
// unboxing and comparing values (silently `false` for equal doubles,
// #1185). A SINGLE annotated operand paired with a literal/unannotated one
// was unaffected (the literal/unannotated side's own correct
// classification was enough for the `||` dispatch to still route
// correctly) -- only two independently-annotated operands together
// triggered #1185.
test "to_string of an annotated Double local" {
  let d: Double = 3.14
  assert(__to_string(d) == "3.14")
  assert("d = \{d}" == "d = 3.14")
}

test "== between two independently-annotated Double locals" {
  let a: Double = 1.0
  let b: Double = 1.0
  assert(a == b)
  let c: Double = 1.0
  assert(c == 1.0)
  let e = 1.0
  assert(a == e)
}

// #1207 Codex review (P2): the ascription-marker match above requires the
// COMPLETE synthetic identity-lambda shape (no type params, no declared
// return type, no effect row, body exactly `EIdent(<param's own name>,
// _)`) -- not just a Double-typed param literally named `__asc`. A
// hand-written IIFE that reuses that internal marker name but has a
// DIFFERENT body (here: a non-identity String-returning body) must not be
// misread as the ascription wrapper and misclassified as floatish.
test "a non-identity __asc-named lambda is not treated as ascription" {
  let result = ((__asc: Double) -> String {
    "hello"
  })(1.0)
  assert(result == "hello")
}
