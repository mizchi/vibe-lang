test "#2652 Double::parse is correctly rounded and reads every spelling to_string writes" {
inspect(parse_desc("0"), content = "0:0")
  inspect(parse_desc("1.5"), content = "1073217536:0")
  inspect(parse_desc("-1.5"), content = "3220701184:0")
  inspect(parse_desc("0.1"), content = "1069128089:2576980378")
  inspect(parse_desc("3.141592653589793"), content = "1074340347:1413754136")
  inspect(parse_desc("2.2250738585072014"), content = "1073859827:2246822048")
  inspect(parse_desc("1e300"), content = "2117592124:2281731484")
  inspect(parse_desc("-1e300"), content = "4265075772:2281731484")
  inspect(parse_desc("1e-300"), content = "27618847:3271095129")
  inspect(parse_desc("1e+21"), content = "1145772772:3605196624")
  inspect(parse_desc("1e21"), content = "1145772772:3605196624")
  inspect(parse_desc("100000000000000000000"), content = "1142271773:2025163840")
  inspect(parse_desc("0.30000000000000004"), content = "1070805811:858993460")
  inspect(parse_desc("5e-324"), content = "0:1")
  inspect(parse_desc("4.9e-324"), content = "0:1")
  inspect(parse_desc("2.4703282292062327e-324"), content = "0:0")
  inspect(parse_desc("2.4703282292062328e-324"), content = "0:1")
  inspect(parse_desc("1.7976931348623157e308"), content = "2146435071:4294967295")
  inspect(parse_desc("1.7976931348623158e308"), content = "2146435071:4294967295")
  inspect(parse_desc("1.7976931348623159e308"), content = "2146435072:0")
  inspect(parse_desc("1e309"), content = "2146435072:0")
  inspect(parse_desc("9007199254740993"), content = "1128267776:0")
  inspect(parse_desc("9007199254740992.5"), content = "1128267776:0")
  inspect(parse_desc("9007199254740993.000000000000001"), content = "1128267776:1")
  inspect(parse_desc("0.1e-6"), content = "1048238066:2596056904")
  inspect(parse_desc("123e-20"), content = "1010217090:3256126350")
  inspect(parse_desc("+2"), content = "1073741824:0")
  inspect(parse_desc("5."), content = "1075052544:0")
  inspect(parse_desc(".5"), content = "1071644672:0")
  inspect(parse_desc("-0"), content = "2147483648:0")
  inspect(parse_desc("1e-400"), content = "0:0")
  inspect(parse_desc("0."), content = "0:0")
  inspect(parse_desc("1.00000000000000011102230246251565404236316680908203125"), content = "1072693248:0")
  inspect(parse_desc("1.00000000000000011102230246251565404236316680908203124"), content = "1072693248:0")
  inspect(parse_desc("1.00000000000000011102230246251565404236316680908203126"), content = "1072693248:1")
  inspect(parse_desc("2.2250738585072011e-308"), content = "1048575:4294967295")
  inspect(parse_desc("2.2250738585072012e-308"), content = "1048576:0")
  inspect(parse_desc("2.2250738585072014e-308"), content = "1048576:0")
  inspect(parse_desc("0.500000000000000166533453693773481063544750213623046875"), content = "1071644672:2")
  inspect(parse_desc("0.500000000000000166533453693773481063544750213623046874"), content = "1071644672:1")
  inspect(parse_desc("0.500000000000000166533453693773481063544750213623046876"), content = "1071644672:2")
  inspect(parse_desc("6.9294956446009195e15"), content = "1127784022:3999169112")
  inspect(parse_desc("3.5e-321"), content = "0:708")
  inspect(parse_desc("-300"), content = "1107468383:536870912")
  inspect(parse_desc("1e-10000"), content = "0:0")
  inspect(parse_desc("Infinity"), content = "2146435072:0")
  inspect(parse_desc("-Infinity"), content = "4293918720:0")
  inspect(parse_desc("NaN"), content = "NaN")
  inspect(parse_desc("abc"), content = "None")
  inspect(parse_desc(""), content = "None")
  inspect(parse_desc("1e"), content = "None")
  inspect(parse_desc("1e+"), content = "None")
  inspect(parse_desc("--1"), content = "None")
  inspect(parse_desc("."), content = "None")
  inspect(parse_desc("e5"), content = "None")
  inspect(parse_desc("1.2.3"), content = "None")
}

test "#2652 the spellings the old parser accepted still parse" {
  inspect(parse_desc("5."), content = "1075052544:0")
  inspect(parse_desc(".5"), content = "1071644672:0")
  inspect(parse_desc("+2"), content = "1073741824:0")
  inspect(parse_desc("-0.5"), content = "3219128320:0")
  inspect(parse_desc("abc"), content = "None")
  inspect(parse_desc("1..2"), content = "None")
  inspect(parse_desc("1e5x"), content = "None")
  inspect(parse_desc(" 1"), content = "None")
}

