// ADR-0124 decision 3 (#2656): a `test` block may name an effect the program
// declares on its row when the block handles it, directly or through a callee.
effect Db {
  Get(Int) -> Int
}

fn app() -> Int with Db {
  perform Db::Get(1) + perform Db::Get(2)
}

test "a handled effect on the row is admitted" allows Db {
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n * 10)
  }
  inspect(v, content = "30")
}

test "an operation-level label is admitted by its arm" allows Db::Get {
  let v = handle {
    perform Db::Get(4)
  } with {
    Db::Get(n) => resume(n + 1)
  }
  inspect(v, content = "5")
}
