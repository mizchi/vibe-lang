// #729 (ADR-0063 Phase C): the .vibei contract conformance engine.
// Contracts declare bodyless `fn` signatures; implementations must provide
// exactly that surface (matching param types + labels, generics, return
// type, effect row; no undeclared exports). Wiring into import resolution
// is the next #729 stage — this exercises the engine directly.

import ../lib/@vibe/compiler {
  lex, parse_program
}

import ../lib/@vibe/compiler/core {
  Stmt
}

import ../lib/@vibe/compiler/contract {
  parse_contract_program, check_contract, contract_hash, package_hash_from_sources, extract_package_version, extract_require_pins, is_strict_semver, is_package_pin, contract_surface_lines, classify_contract_change, semver_bump_kind, verify_publish_bump, contract_facade_source
}

import ../lib/@vibe/core {
  sha1
}

let no_opaques: () -> Array[(String, Int)] = () -> {
  Array::slice([
    ("", 0)
  ], 0, 0)
}

let no_type_defs: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport(Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
}

test "contract declarations parse and fingerprint (#729)" {
  let (decls, _, rest) = parse_contract_program(lex("fn add(x: Int, y: Int) -> Int\nfn read(p: String) -> String with Fs\nimport ./dep.vibe { helper }"))
  assert_eq(Array::length(decls), 2)
  assert_eq(Array::length(rest), 1)
  let (n0, s0) = decls[0]
  assert(n0 == "add")
  assert(s0 == "(Int, Int) -> Int")
  let (n1, s1) = decls[1]
  assert(n1 == "read")
  // fn_sig_text renders the contract's internal comparison key, which
  // deliberately KEEPS the braced row (#1429) -- see ctr_expand_sig_row's
  // note in contract.vibe. The declaration above is written in the new
  // spelling; the rendered key is not.
  assert(String::contains(s1, "with { Fs }"))
}

test "where clause in a declaration is skipped (#729)" {
  let (decls, _, _) = parse_contract_program(lex("fn clamp(x: Int, lo: Int, hi: Int) -> Int where {\n  requires: lo <= hi,\n}"))
  assert_eq(Array::length(decls), 1)
  let (n0, _) = decls[0]
  assert(n0 == "clamp")
}

test "conformant implementation passes (#729)" {
  let (decls, _, _) = parse_contract_program(lex("fn add(x: Int, y: Int) -> Int\nfn scale(k~: Int, v~: Int) -> Int\nfn pick[T](x: T, y: T) -> T"))
  let impls = parse_program(lex("export fn add(a: Int, b: Int) -> Int { a + b }\nexport let scale: (k~: Int, v~: Int) -> Int = (k~, v~) -> { k * v }\nexport fn pick[T](l: T, r: T) -> T { l }\nlet private_helper: (Int) -> Int = (x) -> { x }"))
  // fn-form, annotated-let-form (labeled + exported-and-declared), and a
  // generic all conform; the un-exported private helper is ignored.
  let errors = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errors), 0)
}

test "missing and mismatching implementations are reported (#729)" {
  let (decls, _, _) = parse_contract_program(lex("fn add(x: Int, y: Int) -> Int\nfn gone(x: Int) -> Int\nfn eff(x: Int) -> Int with Fs"))
  let impls = parse_program(lex("export fn add(a: Int, b: String) -> Int { a }\nexport fn eff(x: Int) -> Int { x }"))
  let errors = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errors), 3)
}

test "undeclared export is reported (#729)" {
  let (decls, _, _) = parse_contract_program(lex("fn run(x: Int) -> Int"))
  let impls = parse_program(lex("export fn run(x: Int) -> Int { x }\nexport let leak: (Int) -> Int = (x) -> { x }"))
  let errors = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errors), 1)
  assert(String::contains(errors[0], "leak"))
}

test "declared but unexported implementation is reported (#729)" {
  let (decls, _, _) = parse_contract_program(lex("fn run(x: Int) -> Int"))
  let impls = parse_program(lex("fn run(x: Int) -> Int { x }"))
  let errors = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errors), 1)
  assert(String::contains(errors[0], "not exported"))
}

test "opaque type conformance (#729 C-4)" {
  let (decls, opaques, _) = parse_contract_program(lex("opaque type Counter\nfn get(c: Counter) -> Int"))
  assert_eq(Array::length(opaques), 1)
  let (oname0, oarity0) = opaques[0]
  assert(oname0 == "Counter")
  assert_eq(oarity0, 0)
  let ok_impls = parse_program(lex("export struct Counter { n: Int }\nexport fn get(c: Counter) -> Int { c.n }"))
  assert_eq(Array::length(check_contract(decls, opaques, ok_impls, no_type_defs())), 0)
  let missing = parse_program(lex("export fn get(c: Counter) -> Int { 0 }"))
  assert_eq(Array::length(check_contract(decls, opaques, missing, no_type_defs())), 1)
  let unexported = parse_program(lex("struct Counter { n: Int }\nexport fn get(c: Counter) -> Int { c.n }"))
  let errs = check_contract(decls, opaques, unexported, no_type_defs())
  assert_eq(Array::length(errs), 1)
  assert(String::contains(errs[0], "not exported"))
}

test "bodyless type arity is tracked and enforced (#739)" {
  let (decls, opaques, _) = parse_contract_program(lex("type Box[T]\ntype Pair[A, B]\nfn boxed[T](x: T) -> Box[T]"))
  assert_eq(Array::length(opaques), 2)
  let (bname, barity) = opaques[0]
  assert(bname == "Box")
  assert_eq(barity, 1)
  let (pname2, parity2) = opaques[1]
  assert(pname2 == "Pair")
  assert_eq(parity2, 2)
  // conformant: matching arities
  let ok_impls = parse_program(lex("export enum Box[T] { BoxOf(T) }\nexport enum Pair[A, B] { PairOf(A, B) }\nexport fn boxed[T](x: T) -> Box[T] { BoxOf(x) }"))
  assert_eq(Array::length(check_contract(decls, opaques, ok_impls, no_type_defs())), 0)
  // arity mismatch: nullary Box against declared Box[T]
  let bad_impls = parse_program(lex("export enum Box { BoxNone }\nexport enum Pair[A, B] { PairOf(A, B) }\nexport fn boxed[T](x: T) -> Box[T] { BoxNone }"))
  let errs = check_contract(decls, opaques, bad_impls, no_type_defs())
  assert_eq(Array::length(errs), 1)
  assert(String::contains(errs[0], "arity mismatch"))
  // surface lines carry the arity so Box -> Box[T] classifies as major
  let l_box0 = contract_surface_lines(decls, [("Box", 0)], no_type_defs())
  let l_box1 = contract_surface_lines(decls, [("Box", 1)], no_type_defs())
  assert(classify_contract_change(l_box0, l_box1) == "major")
}

test "undeclared exported type is reported (#729 C-4)" {
  let (decls, opaques, _) = parse_contract_program(lex("fn run(x: Int) -> Int"))
  let impls = parse_program(lex("export fn run(x: Int) -> Int { x }\nexport struct Leak { n: Int }"))
  let errs = check_contract(decls, opaques, impls, no_type_defs())
  assert_eq(Array::length(errs), 1)
  assert(String::contains(errs[0], "Leak"))
}

test "vendored sha1 known vectors (#730 D-1)" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
  assert(sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
}

test "content-addressing hashes (#730 D-1)" {
  // contract_hash: deterministic, order-insensitive over declarations,
  // implementation-independent by construction (built from decls only).
  let (d1, o1, r1) = parse_contract_program(lex("fn add(x: Int, y: Int) -> Int\nopaque type Counter\nfn get(c: Counter) -> Int"))
  let (d2, o2, r2) = parse_contract_program(lex("opaque type Counter\nfn get(c: Counter) -> Int\nfn add(x: Int, y: Int) -> Int"))
  let _ = r1
  let _ = r2
  let h1 = contract_hash(d1, o1, no_type_defs())
  let h2 = contract_hash(d2, o2, no_type_defs())
  assert(h1 == h2)
  assert(String::starts_with(h1, "ct:sha1:"))
  let (d3, o3, _) = parse_contract_program(lex("fn add(x: Int, y: Int) -> String\nopaque type Counter\nfn get(c: Counter) -> Int"))
  assert(!(contract_hash(d3, o3, no_type_defs()) == h1))

  // package_hash: path-order-insensitive, content-sensitive.
  let p1 = package_hash_from_sources([("index.vibei", "fn a() -> Int"), ("./impl.vibe", "export fn a() -> Int { 1 }")])
  let p2 = package_hash_from_sources([("./impl.vibe", "export fn a() -> Int { 1 }"), ("index.vibei", "fn a() -> Int")])
  assert(p1 == p2)
  assert(String::starts_with(p1, "pkg:sha1:"))
  let p3 = package_hash_from_sources([("index.vibei", "fn a() -> Int"), ("./impl.vibe", "export fn a() -> Int { 2 }")])
  assert(!(p3 == p1))
}

test "require pin extraction and validation (#730 D-2)" {
  assert(is_strict_semver("1.2.3"))
  assert(is_strict_semver("^0.10.42"))
  assert(!is_strict_semver("^1"))
  assert(!is_strict_semver("1.2"))
  assert(!is_strict_semver("~1.2.3"))
  assert(!is_strict_semver("1.2.x"))
  assert(is_package_pin("#pkg:sha1:dfd1c758bb64203416db0b64b5854882a43abc11"))
  assert(!is_package_pin("#pkg:sha1:dfd1"))
  assert(!is_package_pin("#ct:sha1:dfd1c758bb64203416db0b64b5854882a43abc11"))

  let src = "require @d2/pkg 1.0.0 = #pkg:sha1:dfd1c758bb64203416db0b64b5854882a43abc11\n\nimport @d2/pkg { triple }\nlet x = 1"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  let (pname, pver, ppin) = pins[0]
  assert(pname == "@d2/pkg")
  assert(pver == "1.0.0")
  assert(String::starts_with(ppin, "pkg:sha1:"))
  // blanking preserves byte length (offsets stay valid for diagnostics)
  assert_eq(String::length(blanked), String::length(src))
  assert(!String::contains(blanked, "require"))
  assert(String::contains(blanked, "import @d2/pkg { triple }"))
}

test "unpinned require lines are accepted for fmt (#730 D-3)" {
  let (pins, blanked) = extract_require_pins("require @a/b 1.2.3\nlet x = 1")
  assert_eq(Array::length(pins), 1)
  let (n, v, h) = pins[0]
  assert(n == "@a/b")
  assert(v == "1.2.3")
  assert(h == "")
  assert(String::contains(blanked, "let x = 1"))
}

test "malformed require lines are rejected (#730 D-2)" {
  let bad1 = handle {
    let _ = extract_require_pins("require @a/b 1.2 = #pkg:sha1:dfd1c758bb64203416db0b64b5854882a43abc11\n")
    false
  } with Error { Throw(_) => true }
  assert(bad1)
  let bad2 = handle {
    let _ = extract_require_pins("require @a/b 1.2.3 = #bad\n")
    false
  } with Error { Throw(_) => true }
  assert(bad2)
}

test "contract change classification (#732 Phase F)" {
  let (d1, o1, _) = parse_contract_program(lex("fn a(x: Int) -> Int\nopaque type T"))
  let l1 = contract_surface_lines(d1, o1, no_type_defs())
  // identical -> patch
  assert(classify_contract_change(l1, l1) == "patch")
  // addition only -> minor
  let (d2, o2, _) = parse_contract_program(lex("fn a(x: Int) -> Int\nfn b(x: Int) -> Int\nopaque type T"))
  let l2 = contract_surface_lines(d2, o2, no_type_defs())
  assert(classify_contract_change(l1, l2) == "minor")
  // signature change -> major
  let (d3, o3, _) = parse_contract_program(lex("fn a(x: String) -> Int\nopaque type T"))
  let l3 = contract_surface_lines(d3, o3, no_type_defs())
  assert(classify_contract_change(l1, l3) == "major")
  // removal -> major
  let (d4, o4, _) = parse_contract_program(lex("opaque type T"))
  assert(classify_contract_change(l1, contract_surface_lines(d4, o4, no_type_defs())) == "major")
}

test "semver bump verification (#732 Phase F)" {
  assert(semver_bump_kind("1.2.3", "1.2.4") is Some("patch"))
  assert(semver_bump_kind("1.2.3", "1.3.0") is Some("minor"))
  assert(semver_bump_kind("1.2.3", "2.0.0") is Some("major"))
  assert(semver_bump_kind("1.2.3", "1.4.0") is None)
  assert(semver_bump_kind("1.2.3", "1.2.3") is None)

  let (d1, o1, _) = parse_contract_program(lex("fn a(x: Int) -> Int"))
  let l1 = contract_surface_lines(d1, o1, no_type_defs())
  let (d2, o2, _) = parse_contract_program(lex("fn a(x: Int) -> Int\nfn b(x: Int) -> Int"))
  let l2 = contract_surface_lines(d2, o2, no_type_defs())
  // honest minor bump for an addition
  assert_eq(Array::length(verify_publish_bump("1.0.0", "1.1.0", l1, l2)), 0)
  // dishonest patch claim for an addition
  let errs = verify_publish_bump("1.0.0", "1.0.1", l1, l2)
  assert_eq(Array::length(errs), 1)
  assert(String::contains(errs[0], "requires minor"))
}

test "contract declaration with a body is rejected (#729)" {
  let failed = handle {
    let _ = parse_contract_program(lex("fn bad(x: Int) -> Int { x }"))
    false
  } with Error {
    Throw(_) => true
  }
  assert(failed)
}

test "value decl count (#752)" {
  let (decls, _, _) = parse_contract_program(lex("let pi: Double\nfn scale(x: Double) -> Double"))
  assert_eq(Array::length(decls), 2)
}

test "value decl parses with val fingerprint (#752)" {
  let (decls, _, _) = parse_contract_program(lex("let pi: Double\nfn scale(x: Double) -> Double"))
  assert_eq(Array::length(decls), 2)
  let (n0, s0) = Array::get(decls, 0)
  // NOTE: `assert(a == b)`, not `assert_eq(a, b)` — assert_eq's lowering
  // falls back to a raw i64 compare for a tuple-destructured string operand
  // (pointer order, #746 residual class; filed separately). `==` takes the
  // desugar's string path and compares content.
  assert(n0 == "pi")
  assert(s0 == "val Double")
  let (n1, s1) = Array::get(decls, 1)
  assert(n1 == "scale")
  assert(String::starts_with(s1, "("))
}

test "value decl conformance ok (#752)" {
  let (decls, _, _) = parse_contract_program(lex("let pi: Double\nfn scale(x: Double) -> Double"))
  let ok_impls = parse_program(lex("export let pi: Double = 3.14\nexport let scale: (x: Double) -> Double = (x) -> { x * 2.0 }"))
  assert_eq(Array::length(check_contract(decls, no_opaques(), ok_impls, no_type_defs())), 0)
}

test "value decl type mismatch is an error (#752)" {
  let (decls, _, _) = parse_contract_program(lex("let pi: Double\nfn scale(x: Double) -> Double"))
  let bad_impls = parse_program(lex("export let pi: Int = 3\nexport let scale: (x: Double) -> Double = (x) -> { x * 2.0 }"))
  assert_eq(Array::length(check_contract(decls, no_opaques(), bad_impls, no_type_defs())), 1)
}

test "undeclared exported value is rejected (#752)" {
  let (decls, _, _) = parse_contract_program(lex("let pi: Double\nfn scale(x: Double) -> Double"))
  let extra_impls = parse_program(lex("export let pi: Double = 3.14\nexport let scale: (x: Double) -> Double = (x) -> { x * 2.0 }\nexport let stray: Int = 1"))
  assert_eq(Array::length(check_contract(decls, no_opaques(), extra_impls, no_type_defs())), 1)
}

test "contract value declaration with a definition is rejected (#752)" {
  let outcome = handle {
    let (_, _, _) = parse_contract_program(lex("let pi: Double = 3.14"))
    "no-throw"
  } with Error {
    Throw(msg) => if String::contains(msg, "must not have a definition") {
      "rejected"
    } else {
      "wrong-error"
    }
  }
  assert_eq(outcome, "rejected")
}

test "version directive: extracted, blanked, offset-preserving (#754)" {
  let src = "version 1.2.3\nrequire @a/b 1.0.0 = #pkg:sha1:dfd1c758bb64203416db0b64b5854882a43abc11\n\nfn f(x: Int) -> Int"
  assert(extract_package_version(src) == "1.2.3")
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  // both directive lines blank to spaces; lengths are preserved
  assert_eq(String::length(blanked), String::length(src))
  assert(!String::contains(blanked, "version 1.2.3"))
  assert(String::contains(blanked, "fn f(x: Int) -> Int"))
}

test "version directive: absent -> empty; only the leading region counts (#754)" {
  assert(extract_package_version("fn f(x: Int) -> Int") == "")
  // a later line that happens to start with "version " is ordinary source
  assert(extract_package_version("fn f(x: Int) -> Int\nversion 9.9.9") == "")
}

test "re-exported symbol not declared in the contract is reported (#847)" {
  let (decls, _, _) = parse_contract_program(lex("fn run(x: Int) -> Int"))
  let impls = parse_program(lex("export fn run(x: Int) -> Int { x }\nexport ./other.vibe { leaked }"))
  let errs = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errs), 1)
  assert(String::contains(errs[0], "leaked"))
}

test "re-exported symbol matching a declared fn is not reported (#847)" {
  let (decls, _, _) = parse_contract_program(lex("fn run(x: Int) -> Int\nfn helper(x: Int) -> Int"))
  let impls = parse_program(lex("export fn run(x: Int) -> Int { x }\nexport ./other.vibe { helper }"))
  let errs = check_contract(decls, no_opaques(), impls, no_type_defs())
  assert_eq(Array::length(errs), 0)
}

test "re-exported symbol matching a declared opaque type is not reported (#847)" {
  let (decls, opaques, _) = parse_contract_program(lex("opaque type Counter"))
  let impls = parse_program(lex("export ./other.vibe { Counter }"))
  let errs = check_contract(decls, opaques, impls, no_type_defs())
  assert_eq(Array::length(errs), 0)
}

// #847: check_contract accepting a declaration satisfied only by re-export
// is not enough on its own — contract_facade_source must ALSO allocate that
// name (into the re-exporting unit's own facade line), or a package that
// conforms would still throw "some declarations have no implementation
// file" the moment its facade is generated.
test "facade generation allocates a declaration satisfied only by re-export (#847)" {
  let (decls, _, _) = parse_contract_program(lex("fn helper(x: Int) -> Int"))
  let unit_stmts = parse_program(lex("export ./other.vibe { helper }"))
  let facade = contract_facade_source(decls, no_opaques(), no_type_defs(), [("./mid.vibe", unit_stmts)])
  assert(String::contains(facade, "helper"))
}

test "facade generation allocates a re-exported opaque type (#847)" {
  let (decls, opaques, _) = parse_contract_program(lex("opaque type Counter"))
  let unit_stmts = parse_program(lex("export ./other.vibe { Counter }"))
  let facade = contract_facade_source(decls, opaques, no_type_defs(), [("./mid.vibe", unit_stmts)])
  assert(String::contains(facade, "Counter"))
}

test "re-exported symbol checks the alias name, not the source name (#847)" {
  let (decls, _, _) = parse_contract_program(lex("fn helper(x: Int) -> Int"))
  let ok_impls = parse_program(lex("export ./other.vibe { impl_name as helper }"))
  assert_eq(Array::length(check_contract(decls, no_opaques(), ok_impls, no_type_defs())), 0)
  // aliasing the declared name AWAY (`helper as wrong_name`) is doubly wrong:
  // 'helper' itself now has no implementer, AND 'wrong_name' is undeclared.
  let bad_impls = parse_program(lex("export ./other.vibe { helper as wrong_name }"))
  let bad_errs = check_contract(decls, no_opaques(), bad_impls, no_type_defs())
  assert_eq(Array::length(bad_errs), 2)
  assert(String::contains(bad_errs[0], "helper"))
  assert(String::contains(bad_errs[1], "wrong_name"))
}

test "version directive: malformed forms are rejected (#754)" {
  let bad = handle {
    let (_, _) = extract_require_pins("version ^1.2.3\nfn f(x: Int) -> Int")
    ""
  } with Error {
    Throw(msg) => msg
  }
  assert(String::contains(bad, "exact semver"))
  let dup = handle {
    let (_, _) = extract_require_pins("version 1.0.0\nversion 1.0.1\nfn f(x: Int) -> Int")
    ""
  } with Error {
    Throw(msg) => msg
  }
  assert(String::contains(dup, "duplicate version directive"))
}
