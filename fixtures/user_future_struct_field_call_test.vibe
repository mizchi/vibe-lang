// #3198 review (Codex): `Future` is a builtin receiver head, so a dot-call on
// a guest future is refused with the function to call instead (#3163). A
// program may still declare its own type spelled `Future`, and a dot-call on
// it reads the program's function-valued field -- the builtin refusal must
// not take that call.
struct Future[T] {
  apply: (T) -> T
}

fn run_it(f: Future[Int], x: Int) -> Int {
  f.apply(x)
}

test "a program's own Future struct keeps its function-valued field call" {
  let f: Future[Int] = Future::{ apply: (n) -> n + 41 }
  inspect(run_it(f, 1), "42")
  inspect(f.apply(2), "43")
}
