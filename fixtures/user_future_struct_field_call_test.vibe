// Builtin Future constructors own that nominal spelling. A source struct
// with its own name still calls its function-valued field normally.
struct MyFuture[T] {
  apply: (T) -> T
}

fn run_it(f: MyFuture[Int], x: Int) -> Int {
  f.apply(x)
}

test "a program's own MyFuture struct keeps its function-valued field call" {
  let f: MyFuture[Int] = MyFuture::{ apply: (n) -> n + 41 }
  inspect(run_it(f, 1), "42")
  inspect(f.apply(2), "43")
}
