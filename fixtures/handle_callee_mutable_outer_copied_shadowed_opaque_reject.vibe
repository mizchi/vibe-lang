effect Ask {
  Get() -> Int
}
fn ask_once() -> Int with Ask {
  perform Ask::Get()
}
fn pure() -> Int {
  11
}
fn run() -> Int with Ask {
  let mut f = ask_once
  let g = f
  let g = pure
  handle {
    let _ = perform Ask::Get()
    g()
  } with { Ask::Get() => resume(7) }
}
fn main() -> Int {
  handle {
    run()
  } with { Ask::Get() => resume(9) }
}
