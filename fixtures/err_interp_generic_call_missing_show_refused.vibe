// #3084: a generic function's result whose type, at this call site, is a
// struct with no `Show` renderer. The render site saw only the callee's formal
// `T`, so the #1445 "missing derive(Show)" refusal never fired and the value
// printed its address. Refused, naming the edit.
struct Hidden {
  x: Int
}

fn pass[T](x: T) -> T {
  x
}

export let _start: () -> Int = () -> {
  let s = "h=\{pass(Hidden::{ x: 1 })}"
  String::length(s)
}
