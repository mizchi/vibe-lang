fn risky() -> Int with Exception {
  throw("boom")
}

fn safe() -> Int {
  with Exception::Throw(_) => 99
  risky()
}

fn safe_explicit() -> Int {
  handle {
    risky()
  } with {
    Exception::Throw(_) => 77
  }
}

test "suffix handler shorthand wraps the block tail" {
  inspect(safe(), content="99")
  inspect(safe_explicit(), content="77")
}
