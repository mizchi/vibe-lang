// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let mut total = 0
    for x in [g] {
      total = total + apply(f = x)
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through for binder" {
  inspect(result(), content = "106")
}
