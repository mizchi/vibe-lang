// #3144 round 4: a PUBLIC declaration crosses a host boundary whose ABI is
// tagged i64, so wasm-gc keeps it off the native Array-reference lane. Being
// public is read from the declaration's flag OR an `export { .. }` block, and
// the block is matched against declaration NAMES. A program's own
// `Array::length` is renamed aside (`Array::length$user`); the block kept the
// source spelling, so the declaration read as private and was admitted -- one
// native array literal where the same program under any other name has none.
// The gate row compiles this on wasm-gc and counts them (must be 0).

fn Array::length(values: Array[Int]) -> Int {
  Array::get(values, 0) + 1
}

export { Array::length }

test "a block-exported program Array::length stays public" {
  let xs = [
    41,
    2
  ]
  assert(Array::length(xs) == 42)
}
