// #3158 review: the instantiation an erased `[T: Add]` in a program handles
// correctly keeps compiling and answering -- `Int`, a tagged immediate,
// including the 63-bit wrap. The refused ones are pinned by
// err_type_add_marker_bound_{double,struct}.vibe. (`String` through the
// prelude's `num_add` is pinned by checker_trait_bound_binop_test.vibe; a
// program's OWN `[T: Add]` at `String` is not satisfied today -- #3178.)

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

test "an erased Add bound adds Ints" {
  inspect(add2(40, 2), "42")
  inspect(add2(-7, 3), "-4")
  inspect(add2(4611686018427387903, 1), "-4611686018427387904")
}
