// #3158 review: the instantiations an erased `[T: Add]` in a program handles
// correctly keep compiling and answering -- `Int`, a tagged immediate,
// including the 63-bit wrap, and `String`, which the erased `+` joins. The
// refused ones are pinned by err_type_add_marker_bound_{double,struct}.vibe.
//
// #3178: the `String` rows used to be refused with ``no impl `Add` for
// `String` ``. The prelude declares `impl Add for String`, but the checker's
// builtin trait table seeded only Int and Double, so only the prelude's own
// `num_add` (checker_trait_bound_binop_test.vibe) accepted a String.

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn add3[T: Add](a: T, b: T, c: T) -> T {
  add2(add2(a, b), c)
}

test "an erased Add bound adds Ints" {
  inspect(add2(40, 2), "42")
  inspect(add2(-7, 3), "-4")
  inspect(add2(4611686018427387903, 1), "-4611686018427387904")
}

test "an erased Add bound joins Strings" {
  inspect(add2("ab", "cd"), "abcd")
  inspect(add2("", "x"), "x")
  inspect(add2("日本", "語"), "日本語")
  inspect(String::length(add2("ab", "cd")), "4")
  inspect(add3("a", "b", "c"), "abc")
}
