// Higher-order: test double pattern — production vs test handler
effect Http {
  Fetch(String) -> String
}

// Business logic: fetches data and processes it
let process_data = () -> Int with Http {
  let raw = perform Http::Fetch("/api/data")
  String::length(raw)
}

// Production handler (would use real HTTP)
let run_production = (f: () -> Int with Http) -> Int {
  handle { f() } with Http {
    Fetch(_url) => resume("{\"items\":[1,2,3]}")
  }
}

// Test handler (fast, deterministic)
let run_test = (f: () -> Int with Http) -> Int {
  handle { f() } with Http {
    Fetch(_url) => resume("[]")
  }
}

// Same logic, different environments
let prod_result = run_production(process_data)
let test_result = run_test(process_data)
// prod: length of '{"items":[1,2,3]}' = 17
// test: length of '[]' = 2
prod_result + test_result

__DATA__
{"last": "19"}
