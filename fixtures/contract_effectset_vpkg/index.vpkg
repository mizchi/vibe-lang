// ADR-0071 (#755) step 5: `effectset` is a transparent, compile-time-only
// alias like `effect` -- classify_contract_stmts (contract.vibe) now
// passes an SEffectSet through into the facade verbatim, exported, the
// same way it already does for SEffectDef.
effect Ask {
  Get -> Int
}

effectset AskAll = { Ask::Get }

fn read_one() -> Int with Ask::Get
