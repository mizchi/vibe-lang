// #1374: the runtime exception-kind side channel.
//
// ADR-0085 lowers every exception spelling to ONE abortive Wasm tag with no
// kind discriminator, and the erased `Error` spelling is deliberately
// compatible with every kind (that is what kept #1344 additive over #786's
// suberror throws). So an erased `handle { .. } with Exception { Throw(m) => .. }`
// arm also catches a typed `Exception[E]` throw, and `m`'s static type there is
// `CtUnknown` -- using it as a String type-checks and then reads an enum
// pointer as a packed `(ptr<<32)|len` string. Measured on the #1372 review: a
// whole data segment written to stderr, and `String::length` == 2129 on a
// `Closed` payload.
//
// `__exn_kind()` closes that: `desugar_trait_dicts` records the payload's
// statically resolved type name at every throw site and lowers the read to a
// one-slot module cell. The payload's own representation is untouched, so this
// is purely additive -- every pre-existing handler behaves exactly as before.

enum Boom {
  Bang(Int)
}

enum Other {
  Second(String)
}

struct Wrapped {
  n: Int;
}

test "an erased arm sees the typed kind of an enum payload" {
  let k = handle {
    throw(Bang(7))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "Boom")
}

test "a String payload reports String, so the sinks keep printing it verbatim" {
  let k = handle {
    throw("boom")
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "String")
}

test "an Int payload reports Int" {
  let k = handle {
    throw(42)
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "Int")
}

test "a struct-literal payload reports its struct name" {
  let k = handle {
    throw(Wrapped::{
      n: 1
    })
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "Wrapped")
}

// The slot is a single global, so the ORDER in which it is written and read is
// the whole correctness argument. `Error` is non-resumable (#640): a throw
// never returns to its site, so between the write and its handler's read no
// other guest code runs. A throw nested inside a handler arm therefore writes
// first and is read first -- innermost wins -- and the outer arm still sees its
// OWN throw's kind, because that throw's write happens after the inner one
// completed.
test "a nested throw does not leak its kind to the outer arm" {
  let k = handle {
    let inner = handle {
      throw(Bang(1))
      ""
    } with Exception {
      Throw(_) => __exn_kind()
    }
    assert_eq(inner, "Boom")
    throw("outer")
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "String")
}

test "two throws in sequence each report their own kind" {
  let first = handle {
    throw(Second("x"))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  let second = handle {
    throw(Bang(2))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(first, "Other")
  assert_eq(second, "Boom")
}

// A payload whose type the throw site cannot resolve syntactically reports ""
// rather than a wrong name. Both sinks treat "" as "might be a String" and keep
// #1375's conservative `__to_string`, which is bounded either way. Applying a
// LOCAL binding is one such shape: the resolver tracks a local's own type, never
// the type of its result, and a local is not in the top-level return table.
test "an unresolvable payload reports the empty kind, never a guess" {
  let f = (x: Int) -> {
    x + 1
  }
  let k = handle {
    throw(f(1))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "")
}

// A resolvable payload right next to an unresolvable one: the "" must be the
// resolver declining, not the cell being stale from the previous throw.
test "an unresolved throw clears the previous throw's kind" {
  let first = handle {
    throw(Bang(3))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(first, "Boom")
  let g = (x: Int) -> {
    x + 1
  }
  let second = handle {
    throw(g(1))
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(second, "")
}

// #1384 review (Codex P2): the write has to happen AFTER the payload is
// evaluated. There is only ONE slot, so a payload expression that itself
// reaches a throw -- even one it catches and recovers from -- overwrites the
// kind the outer site just recorded. With the write emitted first, the arm
// below saw `Boom` (the INNER, already-handled throw) instead of `String`.
//
// Two things make the ordering observable here. The inner throw is fully
// handled, so the only exception reaching the outer arm is the outer one --
// were it to escape, `Boom` would be the RIGHT answer and the bug invisible.
// And the payload is a top-level fn with a declared return type, so the
// resolver actually produces `String`: through a local closure it declines to
// `""`, which no longer reads as a stale kind but also pins nothing.
fn exn_kind_recovering_payload() -> String {
  handle {
    throw(Bang(1))
    "unreachable"
  } with Exception {
    Throw(_) => "outer"
  }
}

test "a payload that internally handles a throw does not lose its own kind" {
  let k = handle {
    throw(exn_kind_recovering_payload())
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "String")
}

// The same ordering seen through the payload rather than the kind: the value
// the outer arm receives must be the OUTER payload. This one already passed
// before the reorder -- the payload was always evaluated correctly, it was only
// the kind slot that got clobbered -- so it is here to pin that the fix did not
// move the payload while repairing the kind.
test "the outer payload survives an inner handled throw" {
  let m = handle {
    throw(exn_kind_recovering_payload())
    ""
  } with Exception {
    Throw(msg) => msg
  }
  assert_eq(m, "outer")
}

test "a bound anonymous record publishes no internal sentinel as its kind (#1878)" {
  let r = record {
    a: 1,
    b: 2
  }
  let k = handle {
    throw(r)
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  // The var_types entry for `r` is the internal `__anonrec:` shape sentinel;
  // publishing it as the kind would leak `<__anonrec:a,b>` into erased
  // sinks. An unresolved kind ("") makes the sink fall back to the safely
  // rendered payload instead.
  assert_eq(k, "")
}

test "a bound tuple carrying a record publishes no internal sentinel (#1878)" {
  let t = (record {
    a: 1
  }, 2)
  let k = handle {
    throw(t)
    ""
  } with Exception {
    Throw(_) => __exn_kind()
  }
  assert_eq(k, "")
}
