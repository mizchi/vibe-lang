/// #2065 wall 1 (ADR-0076 追記34): a HIGHER-ORDER row-variable callee reached
/// under an injected Async entry boundary, called with a closure LITERAL.
///
/// Before the call-site argument-inertness rule, `via` was withheld from the
/// evidence pass's `pure_fns` for taking a function under a row variable, and
/// the whole program was refused with the "type-directed evidence" error --
/// this file WAS fixtures/err_async_rowvar_higher_order_refused.vibe.
///
/// The argument `(y) -> y` declares no row and performs nothing, so it cannot
/// instantiate `e` to `Async`; the call is `Async`-free for the same reason a
/// first-order one is (fixtures/async_first_order_rowvar_boundary_test.vibe),
/// the migration plans, and the program answers 42. This is the shape of
/// `TaskGroup::run((g) -> { .. })`, whose body parameter sits under a row
/// variable. The twin that must STAY refused passes a named function
/// (fixtures/err_async_rowvar_higher_order_refused.vibe).
fn takes_async_fn[T](f: () -> T with Async) -> Int {
  0
}

fn via[T, e](x: T, g: (T) -> T) -> T with e {
  g(x)
}

fn main() -> Int allows Async {
  sleep(1)
  via(42, (y) -> y)
}
