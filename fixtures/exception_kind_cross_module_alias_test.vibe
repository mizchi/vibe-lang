// Codex on #3021: a callee from another module whose row names its kind
// through an alias the caller cannot see (`Exception[Es[IoErr]]`, with
// `type Es[T] = Array[T]` left unimported) is compared as the type the alias
// resolves to, because the published row carries the resolved kind.
import ./exception_kind_cross_module_alias_dep.vibe {
  IoErr, fail
}

fn relay(n: Int) -> Int with Exception[Array[IoErr]] {
  fail(n)
}

test "an imported row's alias kind matches its resolved spelling" {
  let r = handle { relay(1) } with { Exception[Array[IoErr]]::Throw(es) => Array::length(es) }
  inspect(r, content = "2")
}
