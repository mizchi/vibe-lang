// Codex on #3021: a lambda parameter pinned only by the BINDING's annotation.
// At the throw `x` is still open; the annotation fixes it to Int, and the
// throw's kind is settled after that, so the exact `Exception[Int]` row holds.
let settled_by_annotation: (Bool, Int) -> Int with Exception[Int] = (c, x) -> {
  if c {
    throw(x)
  } else {
    0
  }
}

test "a throw kind pinned by the binding's annotation" {
  let r = handle { settled_by_annotation(true, 41) } with { Exception[Int]::Throw(n) => n + 1 }
  inspect(r, content = "42")
}
