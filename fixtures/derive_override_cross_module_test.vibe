// #3551: a plain `P::to_string` in one module overrides the `derive (Show)` of
// `P` in another, the override one module accepts. The derive pass generates
// nothing when the program defines the method (`dtd_source_op_defined`), so
// the linked program holds one `P::to_string` whatever the import order, and
// both modules render through it. #3544's overlap check refused this program,
// which built and printed `custom custom` before it.

import ./modules/derive_override_plain.vibe {
  plain_text
}

import ./modules/derive_override_owner.vibe {
  owner_text
}

test "a plain definition overrides a derive across modules" {
  inspect("\{owner_text()} \{plain_text()}", content = "custom custom")
}
