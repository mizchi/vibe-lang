fn evaluate(k: Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > 9 {
      n
    } else {
      go(n + 5)
    }
  }
  go(k)
}

fn run(count: Int) -> Int {
  let mut total = 0
  let mut i = 0
  while i < count {
    total = total + evaluate(7)
    i = i + 1
  }
  total
}

fn make_counter(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  go
}

fn evaluate_early(k: Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > 9 {
      n
    } else {
      go(n + 5)
    }
  }
  if k == 0 {
    return go(7)
  }
  go(k)
}

fn make_counter_early(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if start > 0 {
    return go
  }
  go
}

fn borrow_callback(callback: (Int) -> Int) -> (Int) -> Int {
  callback
}

fn pass_explicit(callback: (Int) -> Int) -> (Int) -> Int {
  return callback
}

fn pass2(callback: (Int) -> Int) -> (Int) -> Int {
  borrow_callback(callback)
}

fn pass_labeled(callback~: (Int) -> Int) -> (Int) -> Int {
  callback
}

effect Ping {
  Ping() -> Unit
}

effect ChooseCounter {
  Fresh -> (Int) -> Int
}

fn pass_after_ping(callback: (Int) -> Int) -> (Int) -> Int {
  handle {
    perform Ping::Ping()
    callback
  } with { Ping::Ping() => resume(()) }
}

fn make_counter_via_ping(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_after_ping(go)
}

fn make_counter_via_early_helper(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return borrow_callback(go)
}

fn make_counter_via_chain(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass2(go)
}

fn make_counter_via_labeled(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_labeled(callback = go)
}

fn pass_match(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  match choose {
    true => return callback,
    false => return callback
  }
}

fn make_counter_via_borrow(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  borrow_callback(go)
}

fn make_counter_via_explicit(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_explicit(go)
}

fn make_counter_via_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if choose {
    borrow_callback(go)
  } else {
    pass_explicit(go)
  }
}

fn make_counter_via_mixed_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if choose {
    borrow_callback(go)
  } else {
    let offset = [1]
    (n: Int) -> Int {
      n + Array::get(offset, 0)
    }
  }
}

fn make_counter_via_early_mixed_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return if choose {
    go
  } else {
    let offset = [1]
    (n: Int) -> Int {
      n + Array::get(offset, 0)
    }
  }
}

fn make_fresh_counter() -> (Int) -> Int {
  let offset = [1]
  (n: Int) -> Int {
    n + Array::get(offset, 0)
  }
}

fn make_fresh_counter_with(offset: Int) -> (Int) -> Int {
  let data = [offset]
  (n: Int) -> Int {
    n + Array::get(data, 0)
  }
}

fn pass_or_fresh(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return make_fresh_counter()
  }
  callback
}

fn pass_after_assignment(callback: (Int) -> Int) -> (Int) -> Int {
  let mut n = 0
  n = 1
  callback
}

fn make_counter_via_assignment(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_after_assignment(go)
}

fn make_counter_via_early_mixed_helper(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return pass_or_fresh(go, choose)
}

fn make_counter_via_early_mixed_call(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return if choose {
    go
  } else {
    make_fresh_counter()
  }
}

fn make_counter_via_early_parameterized_call(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return if choose {
    go
  } else {
    make_fresh_counter_with(start)
  }
}

fn make_counter_via_early_bound_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return if choose {
    let marker = 0
    go
  } else {
    make_fresh_counter()
  }
}

fn make_counter_via_wrapped_early_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return {
    let marker = 0
    if choose {
      go
    } else {
      make_fresh_counter()
    }
  }
}

fn make_counter_via_handled_early_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return handle {
    if choose {
      perform ChooseCounter::Fresh
    } else {
      go
    }
  } with { ChooseCounter::Fresh => resume(make_fresh_counter()) }
}

fn make_counter_via_handler_return(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return handle {
    if choose {
      perform Ping::Ping()
    } else {
      ()
    }
    go
  } with { Ping::Ping() => return make_fresh_counter() }
}

fn make_counter_via_early_mixed_pass(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return if choose {
    pass_explicit(go)
  } else {
    make_fresh_counter()
  }
}

fn make_counter_via_early_mixed_match(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  return match choose {
    true => go,
    false => make_fresh_counter()
  }
}

fn make_counter_via_match(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  match choose {
    true => borrow_callback(go),
    false => pass_explicit(go)
  }
}

fn make_counter_via_match_helper(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_match(go, choose)
}

test "a local recursive closure is released after its scope" {
  inspect(run(200), content = "2400")
  let before = Profiler::heap_bytes()
  inspect(run(2000), content = "24000")
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a returned recursive closure keeps its self reference and capture" {
  let counter = make_counter(8)
  inspect(counter(5), content = "9")
  inspect(counter(12), content = "12")
}

test "an early return releases the recursive closure" {
  let mut i = 0
  while i < 200 {
    let _ = evaluate_early(0)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  let mut total = 0
  while i < 2200 {
    total = total + evaluate_early(0)
    i = i + 1
  }
  inspect(total, content = "24000")
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "an early returned recursive closure stays alive" {
  let counter = make_counter_early(8)
  inspect(counter(5), content = "9")
}

test "a recursive closure returned through a borrow helper stays alive" {
  let counter = make_counter_via_borrow(8)
  inspect(counter(5), content = "9")
  inspect(counter(12), content = "12")
}

test "early, chained, and labeled helpers preserve recursive closures" {
  let early = make_counter_via_early_helper(8)
  inspect(early(5), content = "9")
  let chained = make_counter_via_chain(8)
  inspect(chained(5), content = "9")
  let labeled = make_counter_via_labeled(8)
  inspect(labeled(5), content = "9")
}

test "explicit and branch passthroughs retain recursive closures" {
  let explicit = make_counter_via_explicit(8)
  inspect(explicit(5), content = "9")
  let yes = make_counter_via_branch(8, true)
  inspect(yes(5), content = "9")
  let no = make_counter_via_branch(8, false)
  inspect(no(5), content = "9")
  let mixed_owner = make_counter_via_mixed_branch(8, true)
  inspect(mixed_owner(5), content = "9")
  let mixed_fresh = make_counter_via_mixed_branch(8, false)
  inspect(mixed_fresh(5), content = "6")
  let matched = make_counter_via_match(8, false)
  inspect(matched(5), content = "9")
  let helper_yes = make_counter_via_match_helper(8, true)
  inspect(helper_yes(5), content = "9")
  let helper_no = make_counter_via_match_helper(8, false)
  inspect(helper_no(5), content = "9")
}

test "the non-owner branch does not retain a fresh closure" {
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "an early return releases the recursive owner on its fresh branch" {
  let escaped = make_counter_via_early_mixed_branch(8, true)
  inspect(escaped(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_early_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_early_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
  let mut j = 0
  while j < 200 {
    let f = make_counter_via_early_mixed_branch(8, true)
    let _ = f(5)
    j = j + 1
  }
  let owner_before = Profiler::heap_bytes()
  while j < 2200 {
    let f = make_counter_via_early_mixed_branch(8, true)
    let _ = f(5)
    j = j + 1
  }
  inspect(Profiler::heap_bytes() - owner_before < 1000, content = "true")
  let mut k = 0
  while k < 200 {
    let f = make_counter_via_early_mixed_call(8, false)
    let _ = f(5)
    k = k + 1
  }
  let call_before = Profiler::heap_bytes()
  while k < 2200 {
    let f = make_counter_via_early_mixed_call(8, false)
    let _ = f(5)
    k = k + 1
  }
  inspect(Profiler::heap_bytes() - call_before < 1000, content = "true")
  let param_forwarded = make_counter_via_early_parameterized_call(8, true)
  inspect(param_forwarded(5), content = "9")
  let mut q = 0
  while q < 200 {
    let f = make_counter_via_early_parameterized_call(8, false)
    let _ = f(5)
    q = q + 1
  }
  let param_before = Profiler::heap_bytes()
  while q < 2200 {
    let f = make_counter_via_early_parameterized_call(8, false)
    let _ = f(5)
    q = q + 1
  }
  inspect(Profiler::heap_bytes() - param_before < 1000, content = "true")
  let bound_forwarded = make_counter_via_early_bound_branch(8, true)
  inspect(bound_forwarded(5), content = "9")
  let mut r = 0
  while r < 200 {
    let f = make_counter_via_early_bound_branch(8, false)
    let _ = f(5)
    r = r + 1
  }
  let bound_before = Profiler::heap_bytes()
  while r < 2200 {
    let f = make_counter_via_early_bound_branch(8, false)
    let _ = f(5)
    r = r + 1
  }
  inspect(Profiler::heap_bytes() - bound_before < 1000, content = "true")
  let passed = make_counter_via_early_mixed_pass(8, true)
  inspect(passed(5), content = "9")
  let mut p = 0
  while p < 200 {
    let f = make_counter_via_early_mixed_pass(8, false)
    let _ = f(5)
    p = p + 1
  }
  let pass_before = Profiler::heap_bytes()
  while p < 2200 {
    let f = make_counter_via_early_mixed_pass(8, false)
    let _ = f(5)
    p = p + 1
  }
  inspect(Profiler::heap_bytes() - pass_before < 1000, content = "true")
  let mut m = 0
  while m < 200 {
    let f = make_counter_via_early_mixed_match(8, false)
    let _ = f(5)
    m = m + 1
  }
  let match_before = Profiler::heap_bytes()
  while m < 2200 {
    let f = make_counter_via_early_mixed_match(8, false)
    let _ = f(5)
    m = m + 1
  }
  inspect(Profiler::heap_bytes() - match_before < 1000, content = "true")
  let mut h = 0
  while h < 200 {
    let f = make_counter_via_early_mixed_helper(8, true)
    let _ = f(5)
    h = h + 1
  }
  let helper_before = Profiler::heap_bytes()
  while h < 2200 {
    let f = make_counter_via_early_mixed_helper(8, true)
    let _ = f(5)
    h = h + 1
  }
  inspect(Profiler::heap_bytes() - helper_before < 1000, content = "true")
  let forwarded = make_counter_via_early_mixed_helper(8, false)
  inspect(forwarded(5), content = "9")
}

test "an assignment continuation returns a live recursive closure" {
  let f = make_counter_via_assignment(8)
  inspect(f(5), content = "9")
}

test "recursive closures returned through a borrow helper are released" {
  let mut i = 0
  while i < 200 {
    let counter = make_counter_via_borrow(8)
    let _ = counter(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let counter = make_counter_via_borrow(8)
    let _ = counter(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a non-function let rec borrowing an array element keeps its owner" {
  let xs = [[1]]
  let rec x = Array::get(xs, 0)
  inspect(Array::length(x), content = "1")
}

test "a resumptive handler forwards a recursive callback" {
  let counter = make_counter_via_ping(8)
  inspect(counter(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_ping(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_ping(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a wrapped early return releases an unselected recursive closure" {
  let forwarded = make_counter_via_wrapped_early_branch(8, true)
  inspect(forwarded(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_wrapped_early_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_wrapped_early_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a handled early return preserves the recursive closure" {
  let forwarded = make_counter_via_handled_early_branch(8, false)
  inspect(forwarded(5), content = "9")
}

test "a handled early return releases an unselected recursive closure" {
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_handled_early_branch(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_handled_early_branch(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a handler return does not drop the recursive owner twice" {
  let fresh = make_counter_via_handler_return(8, true)
  inspect(fresh(5), content = "6")
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_handler_return(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_handler_return(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}
