fn evaluate(k: Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > 9 {
      n
    } else {
      go(n + 5)
    }
  }
  go(k)
}

fn run(count: Int) -> Int {
  let mut total = 0
  let mut i = 0
  while i < count {
    total = total + evaluate(7)
    i = i + 1
  }
  total
}

fn make_counter(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  go
}

fn evaluate_early(k: Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > 9 {
      n
    } else {
      go(n + 5)
    }
  }
  if k == 0 {
    return go(7)
  }
  go(k)
}

fn make_counter_early(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if start > 0 {
    return go
  }
  go
}

fn borrow_callback(callback: (Int) -> Int) -> (Int) -> Int {
  callback
}

fn pass_explicit(callback: (Int) -> Int) -> (Int) -> Int {
  return callback
}

fn pass_match(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  match choose {
    true => return callback,
    false => return callback
  }
}

fn make_counter_via_borrow(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  borrow_callback(go)
}

fn make_counter_via_explicit(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_explicit(go)
}

fn make_counter_via_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if choose {
    borrow_callback(go)
  } else {
    pass_explicit(go)
  }
}

fn make_counter_via_mixed_branch(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  if choose {
    borrow_callback(go)
  } else {
    let offset = [1]
    (n: Int) -> Int {
      n + Array::get(offset, 0)
    }
  }
}

fn make_counter_via_match(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  match choose {
    true => borrow_callback(go),
    false => pass_explicit(go)
  }
}

fn make_counter_via_match_helper(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pass_match(go, choose)
}

test "a local recursive closure is released after its scope" {
  inspect(run(200), content = "2400")
  let before = Profiler::heap_bytes()
  inspect(run(2000), content = "24000")
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a returned recursive closure keeps its self reference and capture" {
  let counter = make_counter(8)
  inspect(counter(5), content = "9")
  inspect(counter(12), content = "12")
}

test "an early return releases the recursive closure" {
  let mut i = 0
  while i < 200 {
    let _ = evaluate_early(0)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  let mut total = 0
  while i < 2200 {
    total = total + evaluate_early(0)
    i = i + 1
  }
  inspect(total, content = "24000")
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "an early returned recursive closure stays alive" {
  let counter = make_counter_early(8)
  inspect(counter(5), content = "9")
}

test "a recursive closure returned through a borrow helper stays alive" {
  let counter = make_counter_via_borrow(8)
  inspect(counter(5), content = "9")
  inspect(counter(12), content = "12")
}

test "explicit and branch passthroughs retain recursive closures" {
  let explicit = make_counter_via_explicit(8)
  inspect(explicit(5), content = "9")
  let yes = make_counter_via_branch(8, true)
  inspect(yes(5), content = "9")
  let no = make_counter_via_branch(8, false)
  inspect(no(5), content = "9")
  let mixed_owner = make_counter_via_mixed_branch(8, true)
  inspect(mixed_owner(5), content = "9")
  let mixed_fresh = make_counter_via_mixed_branch(8, false)
  inspect(mixed_fresh(5), content = "6")
  let matched = make_counter_via_match(8, false)
  inspect(matched(5), content = "9")
  let helper_yes = make_counter_via_match_helper(8, true)
  inspect(helper_yes(5), content = "9")
  let helper_no = make_counter_via_match_helper(8, false)
  inspect(helper_no(5), content = "9")
}

test "the non-owner branch does not retain a fresh closure" {
  let mut i = 0
  while i < 200 {
    let f = make_counter_via_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = make_counter_via_mixed_branch(8, false)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "recursive closures returned through a borrow helper are released" {
  let mut i = 0
  while i < 200 {
    let counter = make_counter_via_borrow(8)
    let _ = counter(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let counter = make_counter_via_borrow(8)
    let _ = counter(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a non-function let rec borrowing an array element keeps its owner" {
  let xs = [[1]]
  let rec x = Array::get(xs, 0)
  inspect(Array::length(x), content = "1")
}
