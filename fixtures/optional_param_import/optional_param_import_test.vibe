// #3432: an imported function's optional parameter can be omitted, passed
// positionally, or passed by label, exactly as in the defining module. Before,
// `greet("hi")` was refused with `function arity mismatch for greet: expected
// 2 args, got 1`: the parameter names did not cross the module boundary.

import ./lib.vibe { greet, digits, greet as hello }

import ./facade.vibe { greet as relayed, greet_once }

test "an imported optional argument can be omitted" {
  inspect(greet("hi"), content = "hi x1")
  inspect(greet("hi", 3), content = "hi x3")
}

test "an imported optional argument can be passed by label" {
  inspect(greet("hi", times = 4), content = "hi x4")
}

test "labels on an imported function are placed by name around omissions" {
  inspect(digits(b = 4, a = 5), content = "54-")
  inspect(digits(c = 6), content = "--6")
  inspect(digits(), content = "---")
}

test "an aliased import keeps the optional parameter" {
  inspect(hello("hey"), content = "hey x1")
}

test "a re-exported function keeps the optional parameter" {
  inspect(relayed("yo"), content = "yo x1")
  inspect(relayed("yo", times = 2), content = "yo x2")
}

test "a module that re-exports a function can call it with omissions" {
  inspect(greet_once("so"), content = "so x1")
}
