// #3432: a type re-exported through facade.vibe keeps its companions'
// optional parameters. A separate file from optional_param_import_test.vibe:
// importing the same type both aliased from lib.vibe and through the facade
// hits #3443, an unrelated codegen bug.

import ./facade.vibe { Tally as Relayed }

test "a re-exported type's companion keeps the optional parameters" {
  inspect(Relayed::make(start = 5).n, content = "4")
  inspect(Relayed::make(step = 2, start = 5).n, content = "3")
  inspect(Relayed::of().n, content = "7")
}
