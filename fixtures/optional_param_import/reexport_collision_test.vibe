// #3445: collide_facade.vibe re-exports collide_a's `f` as `foo`, then
// collide_b's `foo`. The checker binds the later re-export, so the program
// must run it too. Before, the import followed the facade's FIRST edge and
// ran `f(x?: Int)` on an `Option` value, printing a pointer.

import ./collide_facade.vibe {
  foo
}

test "the later of two re-exports of one name is the one that runs" {
  inspect(foo(Some(1)), content = "101")
  inspect(foo(None), content = "-100")
}
