// #3432: functions with optional parameters, imported by
// optional_param_import_test.vibe.

export fn greet(name: String, times?: Int) -> String {
  let n = match times {
    Some(v) => v,
    None => 1
  }
  "\{name} x\{n}"
}

export fn digits(a?: Int, b?: Int, c?: Int) -> String {
  let av = match a {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  let bv = match b {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  let cv = match c {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  "\{av}\{bv}\{cv}"
}

export struct Tally {
  n: Int
}

// A type companion: importing `Tally` brings it along (Codex on #3441).
export fn Tally::make(start?: Int, step?: Int) -> Tally {
  let s = match start {
    Some(v) => v,
    None => 0
  }
  let d = match step {
    Some(v) => v,
    None => 1
  }
  Tally::{ n: s - d }
}

// An unexported companion of an exported type still rides out with it.
fn Tally::of(n?: Int) -> Tally {
  match n {
    Some(v) => Tally::{ n: v },
    None => Tally::{ n: 7 }
  }
}
