// #3360: a function re-exported under an alias keeps its optional
// parameter. Before, `salute("yo")` was refused with `function arity mismatch
// for salute: expected 2 args, got 1`: publication asked whether the module
// published `salute` with a lookup that does not resolve a surface-only
// binding, and dropped its parameter names.

import ./alias_facade.vibe { salute }

test "an aliased re-export keeps the optional parameter" {
  inspect(salute("yo"), content = "yo x1")
  inspect(salute(name = "yo", times = 2), content = "yo x2")
}
