import ./lib.vibe as helper only { greet, digits, greet as hello }

import ./facade.vibe as relayed only { greet }

test "a qualified optional argument can be omitted or passed positionally" {
  inspect(helper.greet("hi"), content = "hi x1")
  inspect(helper.greet("hi", 3), content = "hi x3")
  inspect(helper.greet("hi", None), content = "hi x1")
  inspect(helper.greet("hi", Some(4)), content = "hi x4")
  inspect(helper.hello("alias"), content = "alias x1")
}

test "qualified labels name their slots around omissions" {
  inspect(helper.greet(times = 4, name = "hi"), content = "hi x4")
  inspect(helper.digits(b = 4, a = 5), content = "54-")
  inspect(helper.digits(c = 6), content = "--6")
  inspect(helper.digits(), content = "---")
}

test "a qualified re-export preserves optional parameters" {
  inspect(relayed.greet("yo"), content = "yo x1")
  inspect(relayed.greet(times = 2, name = "yo"), content = "yo x2")
}

struct LocalHelper {
  greet: (String) -> String
}

fn call_shadow(helper: LocalHelper) -> String {
  helper.greet("param")
}

test "local values and parameters shadow the namespace" {
  let helper = LocalHelper::{ greet: (name) -> String::concat("local ", name) }
  inspect(helper.greet("value"), content = "local value")
  inspect(call_shadow(helper), content = "local param")
  inspect(match Some(helper) {
    Some(helper) => helper.greet("pattern"),
    None => ""
  }, content = "local pattern")
}
