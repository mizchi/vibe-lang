// #3432: a top-level binding shadows an imported function of the same name,
// so the import's optional parameters must not rewrite its calls (Codex on
// #3441). Before, the import's omitted `times?` was filled in, so `greet(1)`
// here was refused with `function arity mismatch for greet: expected 1 args,
// got 2`.

import ./lib.vibe { greet, digits }

fn greet(n: Int) -> Int {
  n + 100
}

let digits = (a: Int, b: Int) -> a * 10 + b

test "a local fn shadows an imported optional function" {
  inspect(greet(1), content = "101")
}

test "a local let shadows an imported optional function" {
  inspect(digits(4, 2), content = "42")
}
