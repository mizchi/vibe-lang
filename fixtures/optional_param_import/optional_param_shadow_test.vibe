// #3432: a top-level binding shadows an imported function of the same name,
// so the import's optional parameters must not rewrite its calls (Codex on
// #3441). Before, the import's omitted `times?` was filled in, so `greet(1)`
// here was refused with `function arity mismatch for greet: expected 1 args,
// got 2`.
//
// #3444: the calls also RUN the local bindings. Before, the import's rename
// rewrote every `greet` in this file to the imported definition, so `greet(1)`
// handed an `Int` to the String function and printed a pointer.

import ./lib.vibe {
  digits, greet
}

fn greet(n: Int) -> Int {
  n + 100
}

let digits = (a: Int, b: Int) -> a * 10 + b

fn local_greet_typed_as_local() -> Int {
  greet(1)
}

fn local_digits_typed_as_local() -> Int {
  digits(4, 2)
}

test "calls to a shadowing local run the local" {
  inspect(local_greet_typed_as_local(), content = "101")
  inspect(local_digits_typed_as_local(), content = "42")
  inspect(greet(7), content = "107")
}
