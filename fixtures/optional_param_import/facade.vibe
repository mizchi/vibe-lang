// #3432: re-exports `greet`, so its parameter names must travel two hops,
// and calls it itself, omitting the optional argument (a plain re-export is
// also a local binding; Codex on #3441).
export ./lib.vibe { greet }

export fn greet_once(name: String) -> String {
  greet(name)
}

// Re-exports a type whose companions have optional parameters.
export ./lib.vibe { Tally }
