// #3432: imports `greet` and publishes its own `greet` under the same name,
// written as a typed `let` rather than a lambda. The import's optional
// parameters must not ride out with it (Codex on #3441).
import ./lib.vibe { greet }

let plus_hundred = (n: Int) -> n + 100

export let greet: (Int) -> Int = plus_hundred
