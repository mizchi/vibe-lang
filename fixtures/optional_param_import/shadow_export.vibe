// #3432: imports `greet` (under an alias, since #3549 refuses importing and
// declaring one name) and publishes its own `greet`, written as a typed `let`
// rather than a lambda. The import's optional parameters must not ride out
// with it (Codex on #3441).
import ./lib.vibe { greet as lib_greet }

let plus_hundred = (n: Int) -> n + 100

export let greet: (Int) -> Int = plus_hundred

export fn lib_greeting() -> String {
  lib_greet("hey")
}
