// #3432: shadow_export.vibe publishes its own one-parameter `greet` over an
// imported optional one. Before, the import's parameter names were published
// with it, so `greet(1)` here was filled to `greet(1, None)` and refused with
// `function arity mismatch for greet: expected 1 args, got 2` (Codex on #3441).
//
// Since #3444 the call also runs the published binding.

import ./shadow_export.vibe { greet }

fn shadowing_export_typed_as_local() -> Int {
  greet(1)
}

test "a re-published shadowing binding does not carry the import's parameters" {
  inspect(shadowing_export_typed_as_local(), content = "101")
}
