// A bare `break` as a match arm body, followed by the arm separator `,`.
fn count_to_three() -> Int {
  let mut n = 0
  while true {
    match n {
      3 => break,
      _ => n = n + 1
    }
  }
  n
}

fn sum_until_zero(xs: Array[Int]) -> Int {
  let mut s = 0
  for x in xs {
    match x {
      0 => break,
      v => s = s + v
    }
  }
  s
}

test "a bare break in a match arm leaves the loop" {
  inspect(count_to_three(), "3")
  inspect(sum_until_zero([1, 2, 0, 5]), "3")
}
