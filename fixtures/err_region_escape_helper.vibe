// #1938: capture provenance must survive a locally inferred helper call.
//   error_contains: "region escapes its scope"
fn build() -> () -> Array[Int] {
  region r {
    let values = MutList::empty(r)
    let capture = (value) -> () -> Array[Int] {
      () -> Array[Int] {
        MutList::to_array(value)
      }
    }
    capture(values)
  }
}
