// An exception arm binds no `resume`: an exception is never resumed. So
// inside one, `resume` still names the top-level generic, whose `[T: Eq]`
// bound is supplied at each call, and taking it as a value is refused. An
// operation arm, which does bind `resume`, is pinned by
// `fixtures/threaded_generic_resume_test.vibe`.
fn resume[T: Eq](a: T, b: T) -> Bool {
  a == b
}

fn fails() -> Bool with Exception {
  throw("boom")
}

export let _start: () -> Int = () -> {
  let r = handle {
    fails()
  } with {
    Exception::Throw(_) => {
      let g = resume
      g(1, 1)
    }
  }
  if r {
    1
  } else {
    0
  }
}
