// #1973: was fixtures/effect_higher_order_swap.vibe + __DATA__.last "220".
// Higher-order: swap handler implementations
effect Env {
  GetValue -> Int
}

fn compute() -> Int with Env {
  let a = perform Env::GetValue
  let b = perform Env::GetValue
  a + b
}

fn with_ten(f: () -> Int with Env) -> Int {
  handle {
    f()
  } with Env {
    GetValue => resume(10)
  }
}

fn with_hundred(f: () -> Int with Env) -> Int {
  handle {
    f()
  } with Env {
    GetValue => resume(100)
  }
}

fn higher_order_swap() -> Int {
  with_ten(compute) + with_hundred(compute)
}

test "same computation under swapped handlers is 20 + 200" {
  inspect(higher_order_swap(), "220")
}
