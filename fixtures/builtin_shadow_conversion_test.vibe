// #3185: a program's own conversion or math builtin -- `Int::to_double`,
// `Char::to_int`, `Int::to_string`, `Double::abs`, `Double::floor`,
// `Int::parse`, `String::trim` -- answers the calls the program wrote, on every
// lane. The checker typed these calls from the program's declaration while
// codegen lowered the spelling to the builtin (and its renderers read the
// result type from the spelling): with `fn Int::to_double(n: Int) -> Int`,
// `Int::to_double(3)` answered 3 on linear and 1.48e-321 on wasm-gc. Each
// function here answers a value its builtin never does. The compiler's own
// renderers, which call the builtins by these names, keep working beside them.

fn Int::to_double(n: Int) -> Int {
  n * 100
}

fn Char::to_int(c: Char) -> String {
  let _ = c
  "own Char::to_int"
}

fn Int::to_string(n: Int) -> Int {
  n + 1
}

fn Double::abs(n: Int) -> Int {
  n - 1
}

fn Double::floor(n: Int) -> String {
  "own floor \{n}"
}

fn Int::parse(s: String) -> String {
  "own parse \{s}"
}

fn String::trim(s: String) -> Int {
  String::length(s) * 10
}

test "the program's own conversions answer the calls it wrote" {
  inspect(Int::to_double(3), content = "300")
  inspect(Char::to_int('a'), content = "own Char::to_int")
  inspect(Int::to_string(41), content = "42")
  inspect(Double::abs(8), content = "7")
  inspect(Double::floor(2), content = "own floor 2")
  inspect(Int::parse("12"), content = "own parse 12")
  inspect(String::trim("  ab  "), content = "60")
}

test "the compiler's renderers still reach the builtins" {
  let c: Option[Char] = Some('z')
  inspect("\{c}", content = "Some(z)")
  let d = 2.5
  inspect("\{d}", content = "2.5")
  inspect("\{7}", content = "7")
}
