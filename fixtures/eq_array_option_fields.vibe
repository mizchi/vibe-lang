// #695: derive(Eq) structural `==` must compare Array / Option / Result / tuple
// fields (and bare array literals) STRUCTURALLY, not by pointer identity. The
// runtime `eq` builtin is type-blind, so equality is type-directed at the AST
// level: per-field `eq_for_typed` + monomorphic `__arr_equals__<key>` helpers.

//# Types

struct Inner { n: Int } derive(Eq)

struct Bag {
  items: Array[Int];
  maybe: Option[Int];
  xs: Array[Inner];
  pair: (Int, Bool)
} derive(Eq)

//# Tests

test "bare array literal: equal compares true" {
  assert([1, 2] == [1, 2])
}

test "bare array literal: differing compares false" {
  assert(not([1, 2] == [1, 3]))
  assert([1, 2] != [1, 3])
}

test "bare empty array literal: equal compares true" {
  assert([] == [])
}

test "nested bare array literal: equal compares true" {
  assert([[1, 2], [3]] == [[1, 2], [3]])
  assert(not([[1, 2], [3]] == [[1, 2], [4]]))
}

test "struct Array[Int] field: empty equal" {
  assert(Bag::{ items: [], maybe: None, xs: [], pair: (0, false) } == Bag::{ items: [], maybe: None, xs: [], pair: (0, false) })
}

test "struct Array[Int] field: non-empty equal" {
  let a = Bag::{ items: [1, 2, 3], maybe: Some(5), xs: [], pair: (1, true) }
  let b = Bag::{ items: [1, 2, 3], maybe: Some(5), xs: [], pair: (1, true) }
  assert(a == b)
}

test "struct Array[Int] field: differing length false" {
  let a = Bag::{ items: [1, 2], maybe: None, xs: [], pair: (0, false) }
  let b = Bag::{ items: [1, 2, 3], maybe: None, xs: [], pair: (0, false) }
  assert(not(a == b))
}

test "struct Array[Int] field: differing element false" {
  let a = Bag::{ items: [1, 2, 3], maybe: None, xs: [], pair: (0, false) }
  let b = Bag::{ items: [1, 9, 3], maybe: None, xs: [], pair: (0, false) }
  assert(not(a == b))
}

test "Option[Int] None == None via variables" {
  let a: Option[Int] = None
  let b: Option[Int] = None
  assert(a == b)
}

test "Option[Int] struct field: None equal" {
  let a = Bag::{ items: [], maybe: None, xs: [], pair: (0, false) }
  let b = Bag::{ items: [], maybe: None, xs: [], pair: (0, false) }
  assert(a == b)
}

test "Option[Int] struct field: Some equal, differing false" {
  let a = Bag::{ items: [], maybe: Some(5), xs: [], pair: (0, false) }
  let b = Bag::{ items: [], maybe: Some(5), xs: [], pair: (0, false) }
  let c = Bag::{ items: [], maybe: Some(6), xs: [], pair: (0, false) }
  assert(a == b)
  assert(not(a == c))
}

test "syntactic ctor literals still work" {
  assert(Some(5) == Some(5))
  assert(not(Some(5) == Some(6)))
}

test "Array of aggregate struct elements: equal" {
  let a = Bag::{ items: [], maybe: None, xs: [Inner::{ n: 1 }, Inner::{ n: 2 }], pair: (0, false) }
  let b = Bag::{ items: [], maybe: None, xs: [Inner::{ n: 1 }, Inner::{ n: 2 }], pair: (0, false) }
  assert(a == b)
}

test "Array of aggregate struct elements: differing false" {
  let a = Bag::{ items: [], maybe: None, xs: [Inner::{ n: 1 }], pair: (0, false) }
  let b = Bag::{ items: [], maybe: None, xs: [Inner::{ n: 9 }], pair: (0, false) }
  assert(not(a == b))
}

test "tuple struct field: equal and differing" {
  let a = Bag::{ items: [], maybe: None, xs: [], pair: (1, true) }
  let b = Bag::{ items: [], maybe: None, xs: [], pair: (1, true) }
  let c = Bag::{ items: [], maybe: None, xs: [], pair: (1, false) }
  assert(a == b)
  assert(not(a == c))
}

test "whole-struct equality across all field kinds" {
  let a = Bag::{ items: [1, 2], maybe: Some(7), xs: [Inner::{ n: 3 }], pair: (4, true) }
  let b = Bag::{ items: [1, 2], maybe: Some(7), xs: [Inner::{ n: 3 }], pair: (4, true) }
  assert(a == b)
}

// #1526: the same structural `==` when the array is reached through a NAME.
// Only a literal operand used to resolve the element type, so binding the array
// first silently dropped to the identity-comparing runtime `eq` -- the two
// spellings below disagreed with the "bare array literal" ones at the top of
// this file. The element type comes from the binding site (`array_elem_bind`
// for a let, `seed_var_types` for an `Array[T]` parameter).

test "let-bound arrays: equal compares true" {
  let a = [1, 2]
  let b = [1, 2]
  assert(a == b)
}

test "let-bound arrays: differing element compares false" {
  let a = [1, 2]
  let b = [1, 3]
  assert(not(a == b))
  assert(a != b)
}

test "let-bound arrays: differing length compares false" {
  let a = [1, 2]
  let b = [1, 2, 3]
  assert(not(a == b))
}

test "let-bound arrays: != on equal arrays is false" {
  let a = [1, 2]
  let b = [1, 2]
  assert(not(a != b))
}

test "let-bound String arrays: equal compares true" {
  let a = ["x", "y"]
  let b = ["x", "y"]
  assert(a == b)
  assert(not(a == ["x", "z"]))
}

test "let-bound array vs literal: equal compares true" {
  let a = [1, 2]
  assert(a == [1, 2])
  assert([1, 2] == a)
}

test "Array[T] parameters: equal compares true" {
  assert(arrays_same([1, 2], [1, 2]))
  assert(not(arrays_same([1, 2], [1, 3])))
}

// Codex P1/P2 on PR #1565. What `array_elem_key` records is a bare HEAD NAME,
// and #1526 made it load-bearing at `==` sites -- so both a STALE entry and an
// entry that is not really an element type have to be rejected.

test "a shadowing rebinding does not reuse the outer element type" {
  // Measured before the fix: `__arrelem$xs -> P` survived the rebinding, so
  // this dispatched `__arr_equals__P` on Ints -- its body reads a `.n` field
  // off raw integers, and [7] == [9] came out TRUE.
  let xs = [Inner::{ n: 1 }]
  let xs = int_array(7)
  let ys = int_array(9)
  assert(not(xs == ys))
}

test "a shadowing rebinding to a differently-typed array is not miscompared" {
  let zs = [1]
  let zs = str_array("a")
  let ws = str_array("b")
  assert(not(zs == ws))
}

test "an erased element type falls back to reference equality, not a bad helper" {
  // `fn f[T](x: Array[T], ...)` records "T", which names nothing concrete.
  // The point is that this compiles and runs at all; comparing an array with
  // ITSELF is true under reference equality and under any structural rule, so
  // this pins compilability without freezing which one applies.
  let a = [1, 2]
  assert(generic_same(a, a))
}

//# Functions

/// The `Array[Int]` annotations are what let the comparison inside resolve an
/// element type at all -- both operands are plain names here.
fn arrays_same(x: Array[Int], y: Array[Int]) -> Bool {
  x == y
}

/// Returns an array whose element type this pass cannot infer at the call site
/// (a call result, not a literal) -- the documented #695 residual, and what
/// makes the shadowing tests above meaningful.
fn int_array(v: Int) -> Array[Int] {
  let out = []
  Array::push(out, v)
  out
}

fn str_array(v: String) -> Array[String] {
  let out = []
  Array::push(out, v)
  out
}

fn generic_same[T](x: Array[T], y: Array[T]) -> Bool {
  x == y
}
