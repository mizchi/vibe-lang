// #3385: a parenthesized control form is a callee like any other
// parenthesized expression. `(if c { f } else { g })(10, 20)` used to parse as
// two statements, so the call was dropped and the body answered `(10, 20)`.

fn add2(x: Int, y: Int) -> (Int, Int) {
  (x + y, 0)
}

fn sub2(x: Int, y: Int) -> (Int, Int) {
  (x - y, 0)
}

fn pick_if(c: Bool) -> (Int, Int) {
  (if c {
    add2
  } else {
    sub2
  })(10, 20)
}

fn pick_match(n: Int) -> (Int, Int) {
  (match n {
    0 => add2,
    _ => sub2
  })(10, 20)
}

fn pick_block() -> (Int, Int) {
  ({
    sub2
  })(10, 20)
}

test "a parenthesized if is called" {
  inspect(pick_if(true), "(30, 0)")
  inspect(pick_if(false), "(-10, 0)")
}

test "a parenthesized match is called" {
  inspect(pick_match(0), "(30, 0)")
  inspect(pick_match(1), "(-10, 0)")
}

test "a parenthesized block is called" {
  inspect(pick_block(), "(-10, 0)")
}
