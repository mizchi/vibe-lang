//# Codex P2 on #2456: the typed channel's admission is the declared-field
//# allow-list itself, so an element the allow-list admits -- `Option[Int]`,
//# `Map[String, Int]` -- answers by content when the
//# array is filled through a function. The push scan's own shape adoption
//# leaves `Option` out because a SHAPE has `__EqUnknown`
//# positions; a checker-typed `TypeExpr` has none, and `eq_for_typed` has a
//# structural arm for every head admitted here.

fn fill_opt(xs: Array[Option[Int]], v: Option[Int]) -> Unit {
  Array::push(xs, value = v)
}

fn fill_map(xs: Array[Map[String, Int]], v: Int) -> Unit {
  Array::push(xs, value = Map::from_pairs([("k", v)]))
}

export fn _start() -> Int {
  let ol = []
  fill_opt(xs = ol, v = Some(1))
  let or = []
  fill_opt(xs = or, v = Some(1))
  let oo = []
  fill_opt(xs = oo, v = None)
  assert(ol == or)
  assert(ol != oo)
  let ml = []
  fill_map(xs = ml, v = 1)
  let mr = []
  fill_map(xs = mr, v = 1)
  let mo = []
  fill_map(xs = mo, v = 2)
  assert(ml == mr)
  assert(ml != mo)
  0
}
