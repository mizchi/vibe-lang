//# Codex on #3995: an applied kinded parameter `F[A]` in `Apply`'s body is
//# the parameter, not the top-level alias `F`. `A18` expands to 18 nested
//# arrays, so `impl Mark[A18]` meets a bound spelled with the arrays.
type F[T] = (T, T)
type Apply[F[_], A] = F[A]
type A0 = Int
type A1 = Apply[Array, A0]
type A2 = Apply[Array, A1]
type A3 = Apply[Array, A2]
type A4 = Apply[Array, A3]
type A5 = Apply[Array, A4]
type A6 = Apply[Array, A5]
type A7 = Apply[Array, A6]
type A8 = Apply[Array, A7]
type A9 = Apply[Array, A8]
type A10 = Apply[Array, A9]
type A11 = Apply[Array, A10]
type A12 = Apply[Array, A11]
type A13 = Apply[Array, A12]
type A14 = Apply[Array, A13]
type A15 = Apply[Array, A14]
type A16 = Apply[Array, A15]
type A17 = Apply[Array, A16]
type A18 = Apply[Array, A17]
trait Mark[X] {
  mark(Self) -> Int
}
struct Note {
  n: Int
}
impl Mark[A18] for Note {
  mark(self) -> Int {
    self.n
  }
}
fn marked[V: Mark[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Int]]]]]]]]]]]]]]]]]]]](_ v: V) -> Int {
  V::mark(v)
}
test "kinded" {
  inspect(marked(Note::{ n: 7 }), content = "7")
}
