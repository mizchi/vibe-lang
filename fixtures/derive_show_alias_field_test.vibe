// #3564: a `derive (Show)` field spelled through a type alias is rendered as
// the type the alias names. The renderer matched the field type as written,
// so `v: Values` (`type Values = Array[Int]`) fell to `__to_string` and
// printed the array's address (`T { v: 328 }`). A local alias, a generic
// one, one imported from another module, and an alias inside an `Option`, a
// tuple or an enum payload all render by content. An array nested in an
// `Option` named a helper nothing generated, and stopped the build.

import ./modules/derive_hash_alias_owner.vibe {
  type Scores
}

type Values = Array[Int]

type Grid = Array[Array[Int]]

type Opt[T] = Option[T]

type Name = String

struct T {
  v: Values
} derive (Show)

struct U {
  o: Option[Values];
  g: Grid;
  p: Opt[Name];
  t: (Values, Int);
  s: Scores
} derive (Show)

struct W {
  o: Option[Array[Int]]
} derive (Show)

enum E {
  A(Values);
  B
} derive (Show)

test "an aliased array field renders its elements" {
  inspect("\{T::{ v: [1, 2] }}", content = "T { v: [1, 2] }")
}

test "aliases inside an option, a tuple, a generic alias and an import render by content" {
  let u = U::{ o: Some([3]), g: [[1], [2, 3]], p: Some("x"), t: ([4], 5), s: [0.5] }
  inspect("\{u}", content = "U { o: Some([3]), g: [[1], [2, 3]], p: Some(x), t: ([4], 5), s: [0.5] }")
}

test "an array inside an option renders its elements" {
  inspect("\{W::{ o: Some([3]) }}", content = "W { o: Some([3]) }")
}

test "an aliased enum payload renders its elements" {
  inspect("\{E::A([7, 8])}", content = "A([7, 8])")
  inspect("\{E::B}", content = "B")
}
