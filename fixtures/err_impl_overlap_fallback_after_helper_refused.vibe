// #3551 review: two modules each write a bodyless `impl Name for Int` and its
// method as `fn Int::name`, with a helper between the two. The overlap check
// read only the bindings right after an impl, so neither `Int::name` was the
// impl's; both read as plain definitions, which it never compared, and this
// built and printed `from-a from-a` (`from-b from-b` with the imports
// swapped). It is refused, naming both impls.

import ./modules/impl_overlap_fallback_a.vibe {
  fallback_a_name
}

import ./modules/impl_overlap_fallback_b.vibe {
  fallback_b_name
}

test "both modules keep their own method" {
  inspect("\{fallback_a_name()} \{fallback_b_name()}", "from-a from-b")
}
