//# ADR-0097, the shape that was left after #2157 and that the typed-`==`
//# channel (#2391, after #2447) now answers.
//#
//# An unannotated `let xs = []` normally takes its element type from the
//# `Array::push(xs, v)` calls in its own scope. Here both arrays are filled
//# inside a function they are merely passed to, so the syntactic scan has no
//# push to read. The checker still types the binding (`Array[Int]`: an empty
//# literal carries a real element slot since #2447, and `fill`'s parameter
//# binds it), records the `==` site's operand type, and the comparison
//# dispatches by CONTENT. `left` and `right` are distinct allocations (an
//# identity answer says false); `other` has the same length with a different
//# element (a length-only answer says true). Every assert traps on a wrong
//# answer.

fn fill(xs: Array[Int], v: Int) -> Unit {
  Array::push(xs, v)
}

export fn _start() -> Int {
  let left = [
  ]
  fill(left, 1)
  let right = [
  ]
  fill(right, 1)
  let other = [
  ]
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  0
}
