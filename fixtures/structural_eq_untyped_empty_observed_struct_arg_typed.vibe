//# #2467: this used to TRAP (the generic-enum fail-closed rule of #2456 --
//# the derived comparator compared a formal-typed aggregate payload by
//# reference). A concrete instantiation now takes a comparator specialized
//# with its arguments, like a generic struct (#2195), so the payload compares
//# by CONTENT: two separately allocated equal payloads answer `true`, a
//# same-shaped different one answers `false`.
//# Shape from Codex round 10 on #2456.

struct Box[X] {
  v: X
} derive (Eq)

enum Wrap[T] {
  W(Box[T]);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W(Box::{ v: [v, v + 1] }))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  0
}
