// #760(2): `Result` is available standalone — no local `enum Result` declaration
// and no import required. It is not a built-in type constructor (unlike
// Option/CtOption); the compiler appends the ordinary enum
// `enum Result[T, E] { Ok(T); Err(E) }` (mirroring lib/@vibe/prelude/result.vibe) to
// any program that neither declares nor imports it, so bare `Ok`/`Err`,
// qualified `Result::Ok`/`Result::Err`, `Result[T, E]` annotations, pattern
// matching and exhaustiveness all work through the existing user-enum machinery.
// A program that DOES declare or import its own Result is left untouched. See
// inject_prelude_result in desugar_trait_dict.vibe.

fn divide(a: Int, b: Int) -> Result[Int, String] {
  if b == 0 {
    Err("divide by zero")
  } else {
    Ok(a / b)
  }
}

test "fn returning Result, bare Ok/Err, match" {
  let v = match divide(10, 2) {
    Ok(x) => x,
    Err(_) => -1
  }
  assert_eq(v, 5)
}

test "Err branch carries its payload" {
  let e = match divide(1, 0) {
    Ok(_) => 0,
    Err(msg) => String::length(msg)
  }
  assert_eq(e, 14)
}

test "qualified Result::Ok / Result::Err construction and match" {
  let r: Result[Int, String] = Result::Ok(42)
  let s: Result[Int, String] = Result::Err("nope")
  let rv = match r {
    Result::Ok(v) => v,
    Result::Err(_) => -1
  }
  assert_eq(rv, 42)
  let sv = match s {
    Result::Ok(v) => v,
    Result::Err(_) => -7
  }
  assert_eq(sv, -7)
}

// Result with a non-String error payload (the E type parameter is real).
fn checked(n: Int) -> Result[Int, Int] {
  if n < 0 {
    Err(n)
  } else {
    Ok(n * 2)
  }
}

test "Result[Int, Int] — error payload is not String" {
  let a = match checked(4) {
    Ok(x) => x,
    Err(e) => e
  }
  assert_eq(a, 8)
  let b = match checked(-3) {
    Ok(x) => x,
    Err(e) => e
  }
  assert_eq(b, -3)
}

// Nested Result value flowing through a let binding then matched.
test "Result bound then matched" {
  let r = divide(20, 4)
  let doubled = match r {
    Ok(x) => x * 10,
    Err(_) => 0
  }
  assert_eq(doubled, 50)
}
