// #1973: was fixtures/effect_higher_order_test_double.vibe + __DATA__.last "19".
// Higher-order: test double pattern — production vs test handler
effect Http {
  Fetch(String) -> String
}

fn process_data() -> Int with Http {
  let raw = perform Http::Fetch("/api/data")
  String::length(raw)
}

fn run_production(f: () -> Int with Http) -> Int {
  handle {
    f()
  } with {
    Http::Fetch(_url) => resume("{\"items\":[1,2,3]}")
  }
}

fn run_test(f: () -> Int with Http) -> Int {
  handle {
    f()
  } with {
    Http::Fetch(_url) => resume("[]")
  }
}

fn higher_order_test_double() -> Int {
  run_production(process_data) + run_test(process_data)
}

test "production and test Http doubles add to 17 + 2" {
  inspect(higher_order_test_double(), "19")
}
