//# Codex round 15 on #2456, the `Result` spelling: `enum Result[T, E] {
//# Mark(Int); Empty }` is not the `Ok`/`Err` shape, so it is decided as an
//# ordinary generic enum by the positions its derived comparator observes --
//# none -- and an opaque argument does not cost it the answer. Measured on
//# fd9cdcc: this program trapped; it ANSWERS now.

enum Result[T, E] {
  Mark(Int);
  Empty
}

fn fill(xs: Array[Result[StringBuilder, StringBuilder]], v: Int) -> Unit {
  Array::push(xs, Mark(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
