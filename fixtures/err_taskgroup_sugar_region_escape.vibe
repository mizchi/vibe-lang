// #1081 step 4: `taskgroup { g => body }` desugars into a literal
// `TaskGroup::run` call, so the EXISTING region-escape check (checker.vibe's
// hardcoded-by-name recognition of `TaskGroup::run`, #1081 step 3 Phase A)
// applies unchanged -- no sugar-specific checker work was needed. Pins that
// a `TaskHandle` obtained inside the sugar body still cannot escape it.
import @vibex/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit with { Error } {
  let leaked = taskgroup { g => {
    let h = TaskGroup::spawn(g, () -> { 1 })
    h
  } }
  ()
}

__DATA__
{"error_contains":"region escapes its nursery scope"}
