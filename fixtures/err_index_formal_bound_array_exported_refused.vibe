// #3156 review: the exported side of err_index_formal_bound_array_refused.vibe.
// `first` is exported, so a caller may reach it through its contract, which
// says only `[T](T) -> Int` -- the body's `require_array(x)` binding does not
// constrain that caller. The index on the formal is refused rather than read
// as settled array indexing.

fn require_array[E](xs: Array[E]) -> Unit {
  ()
}

export fn first[T](x: T) -> Int {
  require_array(x)
  x[0]
}

export let _start: () -> Int = () -> {
  first([7])
}
