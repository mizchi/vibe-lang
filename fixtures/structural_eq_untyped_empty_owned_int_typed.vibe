//# Codex round 17 on #2456: a program may declare a struct whose spelling is
//# a scalar's -- `struct Int { value: String }`. The checker types these
//# bindings as the struct and the channel row spells `Array[Int]`; the
//# desugar used to read that spelling as the builtin scalar and compare the
//# reference words. Measured on 12354b8: two content-equal, separately
//# allocated values pushed by name compared `false` (the baseline trapped).
//# A source-owned spelling now takes its declared comparator, so this
//# ANSWERS by content. (A direct `a == b` already answered on both.)

struct Int {
  value: String
} derive (Eq)

export fn _start() -> Bool {
  let a = Int::{ value: "ab" }
  let b = Int::{ value: "ab" }
  let c = Int::{ value: "cd" }
  let left = []
  Array::push(left, a)
  let right = []
  Array::push(right, b)
  let other = []
  Array::push(other, c)
  assert(left == right)
  assert(left != other)
  assert(a == b)
  assert(a != c)
  true
}
