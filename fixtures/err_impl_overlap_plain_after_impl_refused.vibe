// #3551: one module writes `impl Name for Int`; another holds `impl Tag for
// Int` and, after an intervening statement, a plain `fn Int::name`. The
// overlap check used to exempt every `Int::..` definition of a unit that held
// any impl for `Int`, so this built and printed `from-a from-a` -- the linked
// program kept one `Int::name`, chosen by import order. It is refused, naming
// the plain definition and the impl.

import ./modules/impl_overlap_a.vibe {
  a_name
}

import ./modules/impl_overlap_plain_after_impl.vibe {
  plain_name
}

test "both modules keep their own method" {
  inspect("\{a_name()} \{plain_name()}", "from-a from-plain")
}
