import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

enum Payload {
  A
}

effect Logger {
  A(Payload) -> Int
}

// #3238: the operation name `A` is not a constructor reference, but a bare
// constructor `A` inside its arm is, and it cannot be told apart from the
// private `Api::A` after parsing, so the build refuses with the collision
// message. Since #3371 a handler payload is a name, so the constructor is
// matched in the arm body; the payload-position spelling is the typecheck row
// reexport_enum_alias_private_handler_nested_payload_reject.
test "a handler payload keeps its own constructor" {
  let value = handle {
    perform Logger::A(Payload::A)
  } with {
    Logger::A(payload) => match payload {
      A => resume(7)
    }
  }
  inspect(value, content = "7")
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
