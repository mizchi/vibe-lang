// #1973: was fixtures/effect_resume_call_bubbling.vibe + __DATA__.last "3131365".
// ADR-0076 Phase 3b (#817): yield bubbling -- a suspend-class handle
// body may CALL a named top-level function whose concrete row carries
// the handled effect. The callee gets a CPS clone (__scps_cps_*) whose
// performs yield steps, composed back into the caller's spine with the
// per-effect __scps_bubble combinator; the ORIGINAL function is untouched
// for every other caller. Covers: a helper that suspends mid-body
// (bubble at a let), a recursive helper (self-call bubbling, several
// suspends deep), and two handle sites sharing one per-effect step enum.
effect Async {
  Suspend(Int) -> Int
}

let conts: Array[(Int) -> Int] = []

fn step2(x: Int) -> Int with Async {
  let b = perform Async::Suspend(x + 1)
  b * 2
}

fn sumup(n: Int) -> Int with Async {
  if n == 0 {
    0
  } else {
    let v = perform Async::Suspend(n)
    let rest = sumup(n - 1)
    v + rest
  }
}

fn resume_call_bubbling() -> Int {
  let ra = handle {
    let a = perform Async::Suspend(1)
    let c = step2(a)
    c + 5
  } with Async {
    Suspend(t) => {
      Array::push(conts, resume)
      0 - t
    }
  }
  let ra2 = (Array::get(conts, 0))(10)
  let ra3 = (Array::get(conts, 1))(100)
  let val_a = (0 - ra) * 100000 + (0 - ra2) * 1000 + ra3
  let rb = handle {
    sumup(3)
  } with Async {
    Suspend(t) => {
      Array::push(conts, resume)
      0 - t
    }
  }
  let rb2 = (Array::get(conts, 2))(30)
  let rb3 = (Array::get(conts, 3))(20)
  let rb4 = (Array::get(conts, 4))(10)
  let val_b = (0 - rb) * 1000000 + (0 - rb2) * 10000 + (0 - rb3) * 100 + rb4
  val_a + val_b
}

test "yield bubbling across helper and recursive sites" {
  inspect(resume_call_bubbling(), "3131365")
}
