// #3737: an impl method's parameter written without an annotation is typed
// from the trait's signature, with `Self` read as the impl's target. Left
// unannotated, the method was generalized over it, and interpolating a
// `Double` / `Float` there printed the boxed value's address (`f64 300`).
// Each case checks the rendered VALUE.

trait Describe {
  describe(Self) -> String
}

impl Describe for Float64 {
  describe(x) -> String {
    "f64 \{x}"
  }
}

impl Describe for Float32 {
  describe(x) -> String {
    "f32 \{x}"
  }
}

impl Describe for Int {
  describe(x) -> String {
    "int \{x}"
  }
}

trait Scale {
  scale(Self, Float64) -> String
}

impl Scale for Int {
  scale(n, by) -> String {
    "\{n} x \{by}"
  }
}

trait Pair {
  pair(Self, Self) -> Bool
}

impl Pair for Float64 {
  pair(a, b) -> Bool {
    a < b
  }
}

test "an unannotated Self parameter renders by value" {
  inspect(Describe::describe(1.25), "f64 1.25")
  inspect(Describe::describe(1.25f), "f32 1.25")
  inspect(Describe::describe(7), "int 7")
}

test "an unannotated scalar parameter renders by value" {
  inspect(Scale::scale(3, 0.5), "3 x 0.5")
}

test "an unannotated Self parameter compares by value" {
  inspect(Pair::pair(1.5, 2.5), "true")
  inspect(Pair::pair(2.5, 1.5), "false")
}
