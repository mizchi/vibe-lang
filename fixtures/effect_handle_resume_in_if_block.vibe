// resume() inside if-else in handler arm
effect Gate {
  Check(Int) -> String
}

let result = handle {
  let msg = perform Gate::Check(10)
  String::length(msg)
} {
  Gate::Check(n, k) => {
    if n > 5 {
      resume("big")
    } else {
      resume("small")
    }
  }
}
result

__DATA__
{"last": "3"}
