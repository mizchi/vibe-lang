// #3730 (ADR-0122): `Int32` / `UInt32` are exact 32-bit integers. Every
// arithmetic result wraps at 32 bits, on every lane, and nothing converts
// to or from `Int` without a named conversion.

fn add32(a: Int32, b: Int32) -> Int32 {
  a + b
}

fn mul32(a: Int32, b: Int32) -> Int32 {
  a * b
}

fn sub_u32(a: UInt32, b: UInt32) -> UInt32 {
  a - b
}

fn neg32(a: Int32) -> Int32 {
  -a
}

fn not_u32(a: UInt32) -> UInt32 {
  ~a
}

fn shl32(a: Int32, n: Int32) -> Int32 {
  a << n
}

fn shr_u32(a: UInt32, n: UInt32) -> UInt32 {
  a >> n
}

fn div32(a: Int32, b: Int32) -> Int32 {
  a / b
}

fn bump(x: Int32) -> Int32 {
  let mut acc = x
  acc += 1
  acc *= 2
  acc
}

fn biggest() -> Int32 {
  2147483647
}

fn same[T: Eq](a: T, b: T) -> Bool {
  a == b
}

fn less[T: Ord](a: T, b: T) -> Bool {
  a < b
}

fn show[T: Show](x: T) -> String {
  "\{x}"
}

test "Int32 arithmetic wraps at 32 bits" {
  inspect(Int32::to_int(add32(2147483647, 1)), content = "-2147483648")
  inspect(Int32::to_int(add32(-2147483648, -1)), content = "2147483647")
  inspect(Int32::to_int(mul32(65536, 65536)), content = "0")
  inspect(Int32::to_int(mul32(123456789, 1000)), content = "-1097262584")
  inspect(Int32::to_int(neg32(-2147483648)), content = "-2147483648")
  inspect(Int32::to_int(div32(-2147483648, -1)), content = "-2147483648")
  inspect(Int32::to_int(div32(-7, 2)), content = "-3")
  inspect(Int32::to_int(bump(2147483647)), content = "0")
  inspect(Int32::to_int(biggest() + 1), content = "-2147483648")
}

test "UInt32 arithmetic wraps at 32 bits" {
  inspect(UInt32::to_int(sub_u32(0, 1)), content = "4294967295")
  inspect(UInt32::to_int(not_u32(0)), content = "4294967295")
  inspect(UInt32::to_int(not_u32(4294967295)), content = "0")
  let big: UInt32 = 4294967295
  inspect(UInt32::to_int(big + 1), content = "0")
  inspect(UInt32::to_int(big * big), content = "1")
}

test "a shift count is taken modulo 32" {
  inspect(Int32::to_int(shl32(1, 31)), content = "-2147483648")
  inspect(Int32::to_int(shl32(1, 32)), content = "1")
  inspect(UInt32::to_int(shr_u32(4294967295, 28)), content = "15")
  inspect(UInt32::to_int(shr_u32(4294967295, 36)), content = "268435455")
}

test "conversions are explicit, and narrowing says when it fails" {
  let fits: Option[Int32] = Int::to_int32(2147483647)
  inspect(fits, content = "Some(2147483647)")
  let over: Option[Int32] = Int::to_int32(2147483648)
  inspect(over, content = "None")
  let negative: Option[UInt32] = Int::to_uint32(-1)
  inspect(negative, content = "None")
  let all: Option[UInt32] = Int::to_uint32(4294967295)
  inspect(all, content = "Some(4294967295)")
  inspect(Int::to_int32(-2147483649) == None, content = "true")
  inspect(Int32::to_int(Int::wrap_int32(4294967295)), content = "-1")
  inspect(UInt32::to_int(Int::wrap_uint32(-1)), content = "4294967295")
  inspect(Int32::to_string(Int::wrap_int32(3000000000)), content = "-1294967296")
}

test "Eq, Ord and Show treat them as the scalars they are" {
  let a: Int32 = -5
  let b: Int32 = 7
  inspect(same(a, a), content = "true")
  inspect(same(a, b), content = "false")
  inspect(less(a, b), content = "true")
  inspect(show(a), content = "-5")
  inspect(a == -5, content = "true")
  inspect(a < b, content = "true")
  let xs: Array[UInt32] = [1, 2, 4294967295]
  inspect(UInt32::to_int(Array::get(xs, at = 2)) + 1, content = "4294967296")
  inspect(match b {
    7 => "seven",
    _ => "other"
  }, content = "seven")
}

test "a conversion passes as a function value" {
  let ys: Array[Int32] = Array::map([4294967295, 1], Int::wrap_int32)
  let zs: Array[Int] = Array::map(ys, Int32::to_int)
  inspect(zs, content = "[-1, 1]")
  let us: Array[UInt32] = Array::map([-1], Int::wrap_uint32)
  let ws: Array[Int] = Array::map(us, UInt32::to_int)
  inspect(ws, content = "[4294967295]")
}

fn neg_sum(x: Int32) -> Int32 {
  -(x + 1)
}

fn not_or(x: UInt32) -> UInt32 {
  ~(x | 1)
}

fn neg_neg(x: Int32) -> Int32 {
  -(-x)
}

test "a unary operator over a compound operand wraps too" {
  inspect(Int32::to_int(neg_sum(2147483646)), content = "-2147483647")
  inspect(Int32::to_int(neg_sum(-2147483648)), content = "2147483647")
  inspect(UInt32::to_int(not_or(0)), content = "4294967294")
  inspect(Int32::to_int(neg_neg(-2147483648)), content = "-2147483648")
}

fn neg_first(xs: Array[Int32]) -> Int32 {
  -xs[0]
}

fn not_first(xs: Array[UInt32]) -> UInt32 {
  ~xs[0]
}

test "a unary operator over an index wraps too" {
  let ints: Array[Int32] = [-2147483648, 5]
  inspect(Int32::to_int(neg_first(ints)), content = "-2147483648")
  let words: Array[UInt32] = [0]
  inspect(UInt32::to_int(not_first(words)), content = "4294967295")
}
