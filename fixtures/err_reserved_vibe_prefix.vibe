// PR #2708 review (Codex P1): the `__vibe_` prefix is the compiler's. With
// this definition in the program, `Double::to_string(1.5)` answered
// `hijacked` -- the by-spelling presence test for the Double runtime prelude
// took the program's function for the generated one. `vibe check` refuses the
// spelling at the binder, with the edit first (tests/gates/late/run.sh pins
// the message).
fn __vibe_double_to_string(d: Double) -> String {
  "hijacked"
}

export fn main() -> Int {
  String::length(__vibe_double_to_string(1.5))
}
