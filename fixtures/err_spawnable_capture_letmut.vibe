// #1081 step 3 Phase B (Codex review, PR #1150, P1): a spawn closure
// capturing a `let mut` binding must be a STATIC error regardless of the
// captured value's TYPE -- `type_send_ok` alone accepts a plain `Int`
// counter (Send by type), but docs/concurrency.md explicitly lists
// "captured `let mut`" as never Send: sharing a mutable cell across the
// spawn boundary is exactly what `Spawnable[r]` forbids. Mutability is
// checked separately from (and in addition to) the Send/same-region
// judgment (`check_spawnable_mut_captures`, purely AST-based).
import @vibex/concurrent { TaskGroup }

fn main() -> Unit with { Error } {
  let _r = TaskGroup::run((n) -> {
    let mut counter = 0
    let _t = TaskGroup::spawn(n, () -> {
      counter += 1
      0
    })
    0
  })
  ()
}

__DATA__
{"error_contains":"no impl `Spawnable` for a `let mut` binding"}
