// #2509: each array slot owns its element. A read of an element can also
// hand out a view whose lifetime extends across a call that writes the slot.
fn replace_first(_ rows: Array[Array[Int]], _ replacements: Array[Array[Int]]) -> Unit {
  Array::set(rows, at = 0, value = Array::get(replacements, at = 0))
}

fn saved_view() -> Int {
  let rows = [[11, 12]]
  let saved = Array::get(rows, at = 0)
  replace_first(rows, [[91, 92]])
  let scratch = [77, 78]
  Array::get(saved, at = 0) + Array::get(saved, at = 1) + Array::get(scratch, at = 0)
}

fn saved_local_view() -> Int {
  let rows = [[11, 12]]
  let saved = Array::get(rows, at = 0)
  let replacements = [[91, 92]]
  Array::set(rows, at = 0, value = Array::get(replacements, at = 0))
  let scratch = [77, 78]
  Array::get(saved, at = 0) + Array::get(saved, at = 1) + Array::get(scratch, at = 0)
}

fn copy_back(_ rows: Array[Array[Int]], _ copies: Array[Array[Int]]) -> Unit {
  Array::set(rows, at = 0, value = Array::get(copies, at = 0))
}

fn overwritten_sources() -> Array[Array[Int]] with Exception {
  let sources = [[11], [22]]
  let dest = [Array::get(sources, at = 0)]
  let mut i = 0
  while i < 20 {
    Array::set(dest, at = 0, value = Array::get(sources, at = (i + 1) % 2))
    copy_back(sources, sources)
    i = i + 1
  }
  assert_eq(Array::get(Array::get(dest, at = 0), at = 0), 11)
  sources
}

test "views survive distinct-element replacement locally and across a call" {
  inspect(saved_view(), content = "100")
  inspect(saved_local_view(), content = "100")
}

test "alternating writes preserve both source elements" {
  let sources = overwritten_sources()
  inspect(Array::get(Array::get(sources, at = 0), at = 0), content = "11")
  inspect(Array::get(Array::get(sources, at = 1), at = 0), content = "22")
}

fn main() -> Array[Array[Int]] allows Exception {
  assert_eq(saved_view(), 100)
  assert_eq(saved_local_view(), 100)
  overwritten_sources()
}
