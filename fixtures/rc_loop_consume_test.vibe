// #706 regression: a value owned outside a loop and CONSUMED inside the loop
// body (passed to a function that drops it) must be dup'd per iteration, or it
// is freed on iteration 1 and the back-edge reads dangling memory — a
// use-after-free that surfaces as an OOB trap once the same loop also allocates
// (the freed cell is handed back). The loop-borrowed dup (compile_call +
// EWhile + CompileCtx.loop_borrowed_names) keeps the loop-carried reference
// alive. This was the wat_parser parse_module_sections trap under RC.
//
// Passes on bump (no RC ops) and under RC (loop-borrowed dup) alike.

let tt = (toks: Array[Int], idx: Int) -> Int {
  Array::get(toks, idx)
}

// owned param consumed (via tt, which drops its arg) in a loop that also pushes
// a heap tuple — the allocating push is what turns the silent UAF into a trap.
let collect = (tokens: Array[Int]) -> Array[(Int, Int)] {
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let cnt = Array::length(tokens)
  let mut i = 0
  while i < cnt {
    let ty = tt(tokens, i)
    Array::push(result, (ty, i))
    i = i + 1
  }
  result
}

test "owned value consumed in a loop survives the back-edge" {
  let r = collect([
    10,
    20,
    30
  ])
  assert(Array::length(r) == 3)
  let (v0, k0) = Array::get(r, 0)
  let (v2, k2) = Array::get(r, 2)
  assert(v0 == 10)
  assert(k0 == 0)
  assert(v2 == 30)
  assert(k2 == 2)
}

// nested loops: the value is consumed at multiple depths; each consume site
// must dup, so an inner loop's consumes do not free the outer-borrowed value.
let nested = (xs: Array[Int]) -> Int {
  let n = Array::length(xs)
  let mut i = 0
  let mut total = 0
  while i < n {
    let mut j = 0
    while j < n {
      total = total + tt(xs, j)
      j = j + 1
    }
    i = i + 1
  }
  total
}

test "value consumed across nested loops" {
  assert(nested([
    1,
    2,
    3
  ]) == 18)
}

// indirect/closure call: the consuming callee is reached through a local
// function value, not a direct name. The closure consumes its args just like a
// direct call, so a loop-borrowed arg must be dup'd on the indirect path too.
let indirect = (tokens: Array[Int]) -> Array[(Int, Int)] {
  let g = tt
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let cnt = Array::length(tokens)
  let mut i = 0
  while i < cnt {
    let ty = g(tokens, i)
    Array::push(result, (ty, i))
    i = i + 1
  }
  result
}

test "owned value consumed via an indirect call in a loop" {
  let r = indirect([
    10,
    20,
    30
  ])
  assert(Array::length(r) == 3)
  let (v2, k2) = Array::get(r, 2)
  assert(v2 == 30)
  assert(k2 == 2)
}
