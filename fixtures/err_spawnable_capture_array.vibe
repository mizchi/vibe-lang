// #1081 step 3 Phase B: a spawn closure capturing a plain outer `Array`
// (not Send -- mutable interior) must be a STATIC error, even though the
// single-threaded cooperative scheduler would execute this specific
// program safely today. `Spawnable[r]` enforces the FUTURE-proof
// discipline the type system can check now, not merely today's runtime.
import @vibex/concurrent { TaskGroup }

fn main() -> Unit with Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    TaskGroup::spawn(n, () -> {
      Array::set(seen, 0, 1)
      0
    })
  })
  ()
}

