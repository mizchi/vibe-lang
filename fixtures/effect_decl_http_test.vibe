// P3 HTTP effects — capability-based design

effect HttpRequest {
  Method -> String;
  Url -> String;
  Header(String) -> Option[String];
  Body -> String
}

effect HttpResponse {
  Status(Int) -> Unit;
  SetHeader(String, String) -> Unit;
  Write(String) -> Unit
}

test "effect decl http" {
  inspect(0, "0")
}
