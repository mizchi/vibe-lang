// #3126: `x /= d` by zero traps with the same line as `/`. The compound
// assignment carries no operator position, so the location is the divisor's.
// Pinned by the early gate: this program must FAIL at run time with that line.

fn halve_by(n: Int, d: Int) -> Int {
  let mut x = n
  x /= d
  x
}

fn main allows Console {
  println("before")
  println("after \{halve_by(8, 0)}")
}
