import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

effect Logger {
  A(Api) -> Int
}

// #3371: a handler arm binds its payload and tests it in the body, so the
// qualified private pattern is matched there; written in the payload
// position it is refused (typecheck row
// reexport_enum_alias_private_qualified_payload_reject).
test "a qualified handler operation keeps a qualified private payload" {
  let value = handle {
    perform Logger::A(Api::A)
  } with {
    Logger::A(api) => match api {
      Api::A => resume(7),
      Api::B => resume(8)
    }
  }
  inspect(value, content = "7")
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
