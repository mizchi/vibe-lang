import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

effect Logger {
  A(Api) -> Int
}

test "a qualified handler operation keeps a qualified private payload" {
  let value = handle {
    perform Logger::A(Api::A)
  } with { Logger::A(Api::A) => resume(7) }
  inspect(value, content = "7")
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
