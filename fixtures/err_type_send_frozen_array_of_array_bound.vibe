// #906: FrozenArray[T]'s Send judgment recurses into T
// (checker_trait.vibe send_ok_rec's FrozenArray arm calls
// send_ok_rec(env, s, defs, elem, seen) on the element type, it does not
// unconditionally accept). Wrapping a non-Send element (Array[Int], a
// mutable interior) in a FrozenArray must NOT itself make the container
// Send -- otherwise FrozenArray would be a Send-laundering loophole for
// arbitrary mutable data. Companion positive:
// fixtures/send_bound_frozen_array.vibe (FrozenArray[Int] IS accepted).
let want_send = [T: Send](x: T) -> T { x }

fn main {
  let inner: Array[Int] = [1, 2, 3]
  let outer = [inner]
  let fa = FrozenArray::from_array(outer)
  let _ = want_send(fa)
  ()
}
