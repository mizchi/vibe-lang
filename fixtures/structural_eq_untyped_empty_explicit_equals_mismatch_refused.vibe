//# Codex round 12 on #2456: an explicit comparator is admitted only for the
//# instantiation its parameters name. This `Wrap::equals` takes
//# `Wrap[Array[Int]]`; handing it `Wrap[String]` values (the generated array
//# helper calls it after checking has finished) would read a string payload
//# as an array. Once both sides are non-empty the comparison must TRAP.

enum Wrap[T] {
  W(T);
  Empty
}

fn Wrap::equals(a: Wrap[Array[Int]], b: Wrap[Array[Int]]) -> Bool {
  match a {
    W(x) => match b {
      W(y) => x == y,
      _ => false
    },
    Empty => match b {
      Empty => true,
      _ => false
    }
  }
}

fn fill(xs: Array[Wrap[String]], v: String) -> Unit {
  Array::push(xs, W(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, "ab")
  let right = []
  fill(right, "ab")
  if left == right {
    1
  } else {
    0
  }
}
