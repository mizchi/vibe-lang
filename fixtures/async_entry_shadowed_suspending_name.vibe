// #3534 review (Codex): a local `tick` shadows the top-level suspending
// `tick`. The entry-boundary scan read the callee by name, counted the call
// as a suspension, and injected a boundary the entry's body could not be
// lowered under -- refused with "cannot see through", where the seed
// answered 5. The scan now resolves the name lexically first. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh (want 5).
import @vibe/concurrent/experimental {
  sleep_wait
}

fn tick() -> Int with Async {
  sleep_wait(1)
  1
}

fn make() -> () -> Int {
  () -> 5
}

fn main() -> Int allows Async {
  let tick = make()
  tick()
}
