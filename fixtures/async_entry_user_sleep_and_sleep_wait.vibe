// #3534 review (Codex): a program's own top-level `sleep` stands down the
// builtin sleep's retargeting, and it used to stand down the #3523 boundary
// too -- so an `Async` entry that also calls `sleep_wait` got no handler and
// trapped on the suspension. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh (want 8).
import @vibe/concurrent/experimental {
  sleep_wait
}

fn sleep(ms: Int) -> Int {
  ms * 2
}

fn main() -> Int allows Async {
  sleep_wait(1)
  sleep(3) + 2
}
