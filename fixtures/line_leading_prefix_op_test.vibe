// #3041 (Swift's rule): a token that can be a prefix operator (`-`, `!`, `~`)
// is a PREFIX operator when whitespace precedes it and none follows it. At the
// start of a line the newline is that whitespace, so a line `-1` begins a new
// expression. A binary minus still continues the previous line when written
// `- 1` (a space after it) or when the `-` ends the previous line.
//
// Both readings are pinned with Int on both lines, the shape where the old
// rule was silently wrong: `a` followed by a `-1` line type-checked either way
// and answered `a - 1`.

fn note(_x: Int) -> Unit {
  ()
}

// A block whose last line is `-1` evaluates to -1.
fn block_ends_in_negative(a: Int) -> Int {
  note(a)
  -1
}

// An expression statement followed by a `-x` line: two statements.
fn two_statements(a: Int, x: Int) -> Int {
  let _ = a
  a
  -x
}

// A line-leading `- 1` (space after) continues the previous line.
fn spaced_minus_continues(a: Int) -> Int {
  a
  - 1
}

// A `-` at the end of the previous line continues onto the next.
fn trailing_minus_continues(a: Int) -> Int {
  a -
  1
}

// Other line-leading operators keep continuing the previous line.
fn leading_plus_continues(a: Int) -> Int {
  a
  + 1
}

// A line-leading `!b` / `~n` likewise starts a new expression.
fn leading_not(a: Int, b: Bool) -> Bool {
  let _ = a
  a
  !b
}

fn leading_bit_not(a: Int, n: Int) -> Int {
  let _ = a
  a
  ~n
}

// A negative-literal pattern at the start of a match arm line.
fn classify(n: Int) -> String {
  match n {
    0 => "zero"
    -1 => "minus one"
    _ => "other"
  }
}

test "a block ending in a -1 line evaluates to -1" {
  inspect(block_ends_in_negative(10), content = "-1")
}

test "a -x line after an expression statement is a new statement" {
  inspect(two_statements(10, 3), content = "-3")
}

test "a line-leading `- 1` continues the previous line" {
  inspect(spaced_minus_continues(10), content = "9")
}

test "a trailing `-` continues onto the next line" {
  inspect(trailing_minus_continues(10), content = "9")
}

test "a line-leading `+` still continues the previous line" {
  inspect(leading_plus_continues(10), content = "11")
}

test "line-leading `!` and `~` start new expressions" {
  inspect(leading_not(1, true), content = "false")
  inspect(leading_bit_not(1, 5), content = "-6")
}

test "a negative-literal arm pattern at line start" {
  inspect(classify(0), content = "zero")
  inspect(classify(-1), content = "minus one")
  inspect(classify(7), content = "other")
}
