trait LocalEq
trait LocalOrd: LocalEq

struct Token {
  value: Int;
} derive(LocalOrd)

let same = [T: LocalOrd](a: T, b: T) -> Bool {
  true
}

let accepts_eq = [T: LocalEq](value: T) -> Bool {
  true
}

same(Token::{ value: 1 }, Token::{ value: 1 }) && accepts_eq(Token::{ value: 1 })

__DATA__
{"last":"true"}
