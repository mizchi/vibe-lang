// #1536: `return` inside a suspending loop stays fail-closed. The loop becomes
// a closure, and a closure cannot return from the function around it.
effect Ask {
  Get(Int) -> Int
}

fn loop_with_return() -> Int with Ask {
  let mut i = 0
  while i < 3 {
    let v = perform Ask::Get(i)
    if v > 1 { return v } else { () }
    i = i + 1
  }
  0
}

let _start = () -> Int {
  handle {
    loop_with_return()
  } with Ask {
    Get(n) => {
      let k = resume
      k(n + 1)
    }
  }
}
_start()

__DATA__
{
  "error_contains": "let/seq/tail/branch-tail spine"
}
