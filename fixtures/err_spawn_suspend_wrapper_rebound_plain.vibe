import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

fn my_spawn[rg, e, T: Send](n: TaskGroup[rg, e], f: () -> T with Async + Exception) -> TaskHandle[rg, e, T] {
  TaskGroup::spawn_suspend(n, f = f)
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let p = () -> Int with Async + Exception {
      5
    }
    let q = p
    let h = my_spawn(n = g, f = q)
    TaskGroup::pump_all(g)
    TaskHandle::join(h) + 1
  })
}
