// ADR-0090 MutBytes: returning the buffer itself from the region body is a
// STATIC error -- its type carries the region skolem, so the `__region_run`
// result scan rejects it. Escape is only sanctioned through the
// `MutBytes::to_bytes` copy-out.
//   error_contains: "region escapes its scope"
fn probe() -> Bytes {
  region r {
    let b = MutBytes::empty(r)
    MutBytes::push(b, 1)
    b
  }
}
