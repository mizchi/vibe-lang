// #716: dep A — exports `pick` (also exported by dep B: same-name collision)
// and `add` (collides with the builtin `add` fast-path). The merge renames
// both defs to path-suffixed names; importers' references are rewritten.

export let pick: () -> Int = () -> {
  1
}

export let add: (Int, Int) -> Int = (a, b) -> {
  a * 100 + b
}
