//# Codex round 4 on #2456: the shape check must map PAYLOADS, not just
//# constructor names and arities. `enum Result[T, E] { Ok(E); Err(T) }` has
//# the right names and arities but swaps the formals, so the special
//# `Ok`/`Err` arm -- which compares an `Ok` payload with the FIRST argument's
//# comparator -- would compare the wrong type. Such a declaration is an
//# ordinary enum: with word-scalar arguments its derived `Result::equals`
//# answers by content.

enum Result[T, E] {
  Ok(E);
  Err(T)
}

fn fill(xs: Array[Result[Int, String]], v: Int) -> Unit {
  Array::push(xs, Err(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  let oks = []
  Array::push(oks, Ok("x"))
  assert(left == right)
  assert(left != other)
  assert(left != oks)
  0
}
