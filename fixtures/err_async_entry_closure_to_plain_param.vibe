// #3523: an `Async` closure handed to a parameter that calls it plainly. Its
// suspension cannot reach the entry's handler through `apply`, so before the
// fix this compiled clean and answered 1044 (a step object read as an Int)
// where 5 is right. Now the entry's boundary walks the call and refuses it.
// Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent/experimental {
  sleep_wait
}

fn apply(f: () -> Int) -> Int {
  f()
}

fn main() -> Int allows Async {
  apply(() -> {
    sleep_wait(1)
    5
  })
}
