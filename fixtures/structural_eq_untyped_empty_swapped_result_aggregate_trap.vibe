//# Codex round 4 on #2456, the fail-closed side of the payload mapping. With
//# `enum Result[T, E] { Ok(E); Err(T) }` and an aggregate argument, the
//# special `Ok`/`Err` arm compared an `Err(Array[Int])` payload with the
//# `Int` comparator and answered `false` for two content-equal, separately
//# allocated arrays (measured on the stage2 at e529061). The declaration is
//# an ordinary enum whose derived comparator compares a formal-typed payload
//# by reference, so once both sides are non-empty the comparison must TRAP.

enum Result[T, E] {
  Ok(E);
  Err(T)
}

fn fill(xs: Array[Result[Array[Int], Int]], v: Int) -> Unit {
  Array::push(xs, Err([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
