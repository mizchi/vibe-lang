// #3085: a derived renderer in one module whose field is a `derive (Show)`
// generic declared in ANOTHER module (`b: Box[Bool]` with `Box` imported).
// The derive pass runs per module, so the imported generic's declaration has
// to be visible to it for the field to render at its argument rather than
// through the erased renderer (`Box { v: 1 }`).
import ./imported_generic_show_dep.vibe {
  Box,
  G,
  GA,
  GB,
  make_box
}

struct Outer {
  b: Box[Bool]
} derive (Show)

struct OuterG {
  g: G[Bool]
} derive (Show)

test "an imported generic struct field renders at its argument" {
  let o = Outer::{ b: Box::{ v: true } }
  inspect("\{o}", content = "Outer { b: Box { v: true } }")
}

test "an imported generic enum field renders at its argument" {
  let o = OuterG::{ g: GA(false) }
  inspect("\{o}", content = "OuterG { g: GA(false) }")
}

test "an imported generic interpolated directly" {
  let b: Box[Bool] = Box::{ v: false }
  let g: G[Double] = GA(2.5)
  inspect("\{b} \{g}", content = "Box { v: false } GA(2.5)")
}

test "an imported function returning an imported generic" {
  inspect("\{make_box(true)}", content = "Box { v: true }")
}
