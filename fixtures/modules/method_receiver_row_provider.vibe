// #2501: method calls on receivers whose type only the checker knows, inside
// a module whose struct is private (the merge renames it per file), and an
// exported struct for an importer to call methods on.

struct Tally {
  n: Int
}

fn Tally::size(self: Tally) -> Int {
  self.n
}

fn tallies() -> Array[Tally] {
  [Tally::{ n: 2 }, Tally::{ n: 30 }]
}

/// The sum of the private tallies, each read through a `for` element.
export fn tally_total() -> Int {
  let mut t = 0
  for x in tallies() {
    t = t + x.size()
  }
  t
}

/// An exported struct with a method.
export struct Gauge {
  n: Int
}

/// The gauge's reading.
export fn Gauge::read(self: Gauge) -> Int {
  self.n * 10
}

/// Two gauges, for an importer to iterate.
export fn gauges() -> Array[Gauge] {
  [Gauge::{ n: 1 }, Gauge::{ n: 4 }]
}
