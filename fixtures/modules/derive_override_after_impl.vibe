// #3551: overrides the derived `P::to_string` of `derive_override_owner.vibe`
// with a plain definition written right after an impl of another trait for
// `P`. `Tag` declares no `to_string`, so the definition is not the impl's
// method: the derive gives way to it, as it does to any plain definition.

import ./derive_override_owner.vibe {
  struct P
}

trait Tag {
  tag(Self) -> Int
}

impl Tag for P {
  tag(p: P) -> Int {
    p.x
  }
}

fn P::to_string(p: P) -> String {
  "custom"
}

export fn after_impl_text() -> String {
  "\{P::{ x: 2 }}"
}

export fn after_impl_tag() -> Int {
  Tag::tag(P::{ x: 3 })
}
