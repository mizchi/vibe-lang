// #3042 (Codex on #3063): the dependency half of
// fixtures/ordering_exact_shape_ctor_import_test.vibe -- the derive-less
// exact-shaped `Ordering`, imported by NAME so its constructors arrive bound.

export enum Ordering {
  Less;
  Equal;
  Greater
}

export fn sign_of(n: Int) -> Ordering {
  if n < 0 {
    Less
  } else if n == 0 {
    Equal
  } else {
    Greater
  }
}
