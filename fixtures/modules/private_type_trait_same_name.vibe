// Codex on #3971: a private type alias spelled like a trait of the same
// module (`type Key = Int` beside `trait Key`). Types and traits are
// separate namespaces, so the merge's per-file rename of the alias renames an
// impl key's type arguments and never its trait head.

type Key = Int

trait Key {
  key(Self) -> Int
}

trait Mark {}

type Mark = Int

impl Key for Int {
  key(self) -> Int {
    self + 1
  }
}

impl Mark for Int {}

fn via[T: Key](_ t: T) -> Int {
  T::key(t)
}

export fn run_key(_ n: Key) -> Int {
  via(n)
}
