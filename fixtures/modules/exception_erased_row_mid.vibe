// #3601: re-exports `fail` from exception_erased_row_dep.vibe, wraps it in
// a function of its own erased row, and aliases it, so an importer of this
// module reads the kind `fail` lets out through each.
import ./exception_erased_row_dep.vibe {
  fail
}

export ./exception_erased_row_dep.vibe {
  fail
}

export fn wrap() -> Int with Exception {
  fail() + 1
}

export let fail_alias = fail
