// #3551 review: a generic impl, which covers `Box[Int]` too.
import ./impl_overlap_trait.vibe { trait Name }

import ./impl_overlap_box.vibe { struct Box }

impl [T] Name for Box[T] {
  name(x: Box[T]) -> String {
    "from-generic"
  }
}

fn via[T: Name](x: T) -> String {
  Name::name(x)
}

export fn generic_name() -> String {
  via(Box::{ v: 1 })
}
