// The defining module behind fixtures/modules/contract_type_members: derived
// and impl methods, plus a free function under each type, which the contract
// must not publish by listing the type.

export struct Ver {
  major: Int;
  minor: Int
} derive (Eq, Ord)

fn Ver::helper(v: Ver) -> Int {
  v.major * 100 + v.minor
}

export fn make_ver(major: Int, minor: Int) -> Ver {
  Ver::{ major: major, minor: minor }
}

export trait Base {
  base_m(Self) -> Int
}

export trait Child: Base {
  child_m(Self) -> Int
}

export struct Node {
  v: Int
}

impl Child for Node {
  base_m(self) -> Int {
    self.v
  }
  child_m(self) -> Int {
    self.v + 1
  }
}

fn Node::helper(n: Node) -> Int {
  n.v * 10
}

export fn make_node(v: Int) -> Node {
  Node::{ v: v }
}
