// #3587: a second subtrait of `Eq` whose impl for `Box` writes another
// `equals`.

import ./eq_subtrait_sib_types.vibe {
  struct Box
}

export trait Mark: Eq {
  mark(Self) -> Int
}

impl [T] Mark for Box[T] {
  mark(self) -> Int {
    1
  }
  equals(self, o: Box[T]) -> Bool {
    true
  }
}

export fn via_mark[T: Mark](a: T, b: T) -> Bool {
  T::equals(a, b)
}
