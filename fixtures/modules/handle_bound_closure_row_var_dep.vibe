// #3594: a row-polymorphic builder for importers that call it inside a
// `handle`. The closure `forward` stores in the field calls `g`, so it
// performs whatever the call instantiates `e` to, and inherited the row of
// the call.
export struct Box {
  f: () -> Int
}

export fn forward[e](g: () -> Int with e) -> Box with e {
  Box::{ f: () -> g() }
}

export fn fallback(n: Int) -> Box {
  Box::{ f: () -> n }
}
