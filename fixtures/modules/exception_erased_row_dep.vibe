// #3601: functions declared with the erased `with Exception` row, for
// importers that call them under an erased arm that reads its binder. `fail`
// throws an `Int`, so its module publishes that its row lets `Exception[Int]`
// out; `fail_text` throws only messages and `fail_code` names its kind.
export fn fail() -> Int with Exception {
  throw(7)
}

export fn fail_text() -> Int with Exception {
  throw("seven")
}

export fn fail_code() -> Int with Exception[Int] {
  throw(7)
}
