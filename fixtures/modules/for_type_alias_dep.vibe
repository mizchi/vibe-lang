// #3642: a module that publishes an iterable struct only through a `type`
// alias, imported by fixtures/for_type_alias_iterand_test.vibe.
export struct Run {
  n: Int
}

export fn Run::iter_length(r: Run) -> Int {
  r.n
}

export fn Run::iter_get(r: Run, i: Int) -> Int {
  (i + 1) * 100
}

export type Runs = Run

export fn runs(n: Int) -> Runs {
  Run::{ n: n }
}
