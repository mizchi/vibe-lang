// #3587: `Key`'s impl for `Box` writes `equals` itself.

import ./eq_subtrait_sib_types.vibe {
  trait Key, struct Box
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

export fn via_key[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}
