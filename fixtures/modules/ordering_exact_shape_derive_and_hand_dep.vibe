// #3042 (Codex on #3063): the dependency half of
// fixtures/err_ordering_exact_shape_derive_and_hand_refused.vibe -- the
// prelude's shape WITH `derive (Ord)`, and a hand-written `compare` that
// replaces the derived one with another signature.

export enum Ordering {
  Less;
  Equal;
  Greater
} derive (Eq, Ord, Show)

fn Ordering::compare(a: Ordering, b: Ordering) -> Int {
  0
}

export fn sign_of(n: Int) -> Ordering {
  if n < 0 {
    Less
  } else {
    Greater
  }
}
