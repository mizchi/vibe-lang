// #3551: a type keyed by a `hash_key` written in an impl of a subtrait of
// `Hash`, with its result left to the trait, which another module's
// `derive (Hash)` keys a field of.

export trait FarKeyed: Hash {
}

export struct Far {
  n: Int
} derive (Show)

impl FarKeyed for Far {
  hash_key(self) -> {
    let far: Far = self
    "f" + Int::to_string(far.n)
  }
}
