// #3587: `Key`'s impl for `Box[Int]` alone writes `equals`.

import ./eq_subtrait_sib_types.vibe {
  trait Key, struct Box
}

impl Key for Box[Int] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[Int]) -> Bool {
    self.v == o.v
  }
}

export fn via_key[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}
