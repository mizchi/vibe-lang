// #3042 (Codex on #3063): the dependency half of
// fixtures/ordering_exact_shape_import_test.vibe -- an `Ordering` of exactly
// the prelude's shape, declared WITHOUT the prelude's derives.

export enum Ordering {
  Less;
  Equal;
  Greater
}

export fn sign_of(n: Int) -> Ordering {
  if n < 0 {
    Less
  } else if n == 0 {
    Equal
  } else {
    Greater
  }
}
