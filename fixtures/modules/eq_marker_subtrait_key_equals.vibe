// #3587: a program that declares its OWN marker `trait Eq {}`. `Key: Eq`'s
// impl writes an `equals`, which is that impl's own method: the marker `Eq`
// declares none. Used by eq_marker_subtrait_equals_cross_module_test.vibe.
export trait Eq {}

export trait Key: Eq {
  tag(Self) -> Int
}

export struct Box[T] {
  v: T
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    7
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

export fn box_value(b: Box[Int]) -> Int {
  b.v
}
