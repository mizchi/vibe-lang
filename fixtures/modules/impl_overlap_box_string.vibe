// #3551 review: an impl at `Box[String]` only, disjoint from `Box[Int]`.
import ./impl_overlap_trait.vibe { trait Name }

import ./impl_overlap_box.vibe { struct Box }

impl Name for Box[String] {
  name(x: Box[String]) -> String {
    "from-string"
  }
}

fn via[T: Name](x: T) -> String {
  Name::name(x)
}

export fn box_string_name() -> String {
  via(Box::{ v: "s" })
}
