// #3923 (Codex on #3930): the dependency half of
// fixtures/ordering_exact_shape_extra_derive_import_test.vibe -- the prelude's
// exact `Ordering` shape with a derive the prelude does not have, which this
// module calls itself.

export enum Ordering {
  Less;
  Equal;
  Greater
} derive (Default)

export fn sign_of(_ n: Int) -> Ordering {
  if n < 0 {
    Less
  } else if n == 0 {
    Equal
  } else {
    Greater
  }
}

export fn fallback() -> Ordering {
  Ordering::default()
}
