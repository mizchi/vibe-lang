// #3551 review: a bodyless `impl Name for Int` whose method is the
// `Int::name` declared behind another statement.

import ./impl_overlap_trait.vibe {
  trait Name
}

impl Name for Int

fn helper_a() -> Int {
  1
}

fn Int::name(x: Int) -> String {
  "from-a"
}

export fn fallback_a_name() -> String {
  Name::name(helper_a())
}
