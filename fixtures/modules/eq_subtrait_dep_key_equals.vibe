// #3587: a subtrait of `Eq` whose generic impl writes its own `equals`, and a
// function that compares through that impl's witness.

export trait Key: Eq {
  tag(Self) -> Int
}

export struct Box[T] {
  v: T
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

export fn via_key[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}
