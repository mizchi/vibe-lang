// #3311 (Codex on #3340): callees with a callback parameter whose row
// instantiates a generic effect, imported by
// fixtures/generic_effect_row_callback_imported_test.vibe.
export effect Box[T] {
  Put(T) -> Int
}

export struct Pt {
  x: Int
}

// The handler measures the payload with `len`, so it must be the `T` this
// call gives `x`.
export fn run_len[T](x: T, f: () -> Int with Box[T], len: (T) -> Int) -> Int {
  handle {
    f()
  } with {
    Box::Put(v) => resume(len(v) + len(x) * 0)
  }
}

fn run_len0[T](x: T, f: () -> Int with Box[T], len: (T) -> Int) -> Int {
  run_len(x, f, len)
}

export let run_len_alias = run_len0

// The arm's payload is annotated: an unannotated field read in an arm
// (`resume(p.x)`) fixes the formal of a generic declared after it at `Int`,
// a separate checker bug this fixture should not lean on.
export fn run_pt(f: () -> Int with Box[Pt]) -> Int {
  handle {
    f()
  } with {
    Box::Put(p) => {
      let q: Pt = p
      resume(q.x * 10)
    }
  }
}

export struct Wrap[T] {
  v: T
}

// The payload is a `Wrap[T]`, measured through `len`.
export fn run_wrap[T](x: T, f: () -> Int with Box[Wrap[T]], len: (T) -> Int) -> Int {
  handle {
    f()
  } with {
    Box::Put(w) => {
      let ww: Wrap[T] = w
      resume(len(ww.v) + len(x) * 0)
    }
  }
}
