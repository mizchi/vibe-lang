// #3042 (Codex on #3063): the dependency half of
// fixtures/err_ordering_exact_shape_hand_written_refused.vibe -- an `Ordering`
// spelled like the prelude, with a hand-written `compare` of ANOTHER
// signature that its importer never sees.

export enum Ordering {
  Less;
  Equal;
  Greater
}

fn Ordering::compare(a: Ordering, b: Ordering) -> Int {
  0
}

export fn sign_of(n: Int) -> Ordering {
  if n < 0 {
    Less
  } else {
    Greater
  }
}
