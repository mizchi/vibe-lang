// #3551 review: the other module with a bodyless `impl Name for Int` whose
// method is the `Int::name` declared behind another statement.

import ./impl_overlap_trait.vibe {
  trait Name
}

impl Name for Int

fn helper_b() -> Int {
  2
}

fn Int::name(x: Int) -> String {
  "from-b"
}

export fn fallback_b_name() -> String {
  Name::name(helper_b())
}
