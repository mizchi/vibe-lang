// #3551 review: a type keyed by an impl for one of its applications
// (`impl Hash for Pack[Int]`), which another module's `derive (Hash)` keys a
// field of (`derive_hash_applied_impl_field_test.vibe`).

export struct Pack[T] {
  v: T
} derive (Show)

impl Hash for Pack[Int] {
  hash_key(self) -> String {
    let p: Pack[Int] = self
    "p" + Int::to_string(p.v)
  }
}
