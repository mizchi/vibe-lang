// #3042 (Codex on #3063): the dependency half of
// fixtures/err_ordering_derive_imported_foreign_type_refused.vibe -- a type
// NAMED `Ordering` that is not the prelude's shape, carried by an exported
// signature.

export enum Ordering {
  Before;
  After
}

export fn order_of(n: Int) -> Ordering {
  if n < 0 {
    Before
  } else {
    After
  }
}
