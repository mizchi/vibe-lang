// #3551: parameterized aliases another module's `derive (Ord)` fields are
// spelled through (`fixtures/derive_ord_imported_alias_test.vibe`,
// `fixtures/typecheck/derive_ord_imported_alias_container_reject.vibe`).

export type Id[T] = T

export type Held[T] = Holder[T]

export type Many[T] = Array[T]

export struct Holder[T] {
  n: Int
} derive (Ord)
