// #3929: one of two dependencies of
// fixtures/type_alias_collision_import_test.vibe that each export a type alias
// spelled `Alias` (and a generic `Pair`).

export struct S {
  v: Int
}

fn S::double(_ s: S) -> Int {
  s.v * 2
}

export type Alias = S

export type Pair[T] = (T, T)

export fn mk() -> Alias {
  Alias::{ v: 5 }
}

export fn twins(_ s: Alias) -> Pair[Alias] {
  (s, s)
}

export fn all(_ xs: Array[Alias]) -> Int {
  Array::length(xs)
}

// A type parameter spelled like the colliding alias is that parameter, and a
// trait method may spell the alias (Codex on #3942).
export struct Box[Alias] {
  value: Alias
}

export trait Read {
  read(Self) -> Alias
}

export struct Note {
  n: Int
}

impl Read for Note {
  read(self) -> Alias {
    S::{ v: self.n }
  }
}

export fn note_value(_ n: Note) -> Int {
  n.read().v
}
