// #3571: the edit the qualified-function overlap refusal names -- a plain
// private `fn shout`, which the merge keeps apart from another module's.
// This module also holds the program's only `Int::yell`, called both ways.

fn shout(x: Int) -> String {
  "from-a"
}

fn Int::yell(x: Int) -> String {
  "yell-a"
}

export fn a_name() -> String {
  let n = 1
  "\{shout(n)} \{n |> shout} \{Int::yell(n)} \{n.yell()}"
}
