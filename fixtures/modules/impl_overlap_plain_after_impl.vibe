// #3551: a module holding an impl for `Int` AND, after an intervening
// statement, a plain `fn Int::name`. Only the impl's own methods are impl
// bindings; the plain one is a definition, and it collides with another
// module's `impl Name for Int`.

trait Tag {
  tag(Self) -> Int
}

impl Tag for Int {
  tag(x: Int) -> Int {
    1
  }
}

let gap = 1

fn Int::name(x: Int) -> String {
  "from-plain"
}

export fn plain_name() -> String {
  Int::name(gap)
}
