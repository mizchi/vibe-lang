// #3958: a module whose impls spell their trait arguments and bounds through
// a PRIVATE alias. The merge renames the alias per file, and the impls' keys,
// bounds and method bindings follow it, so the module's own calls still
// reach its impls.

type Alias = Int

export trait Value[A] {
  value(Self) -> A
}

export trait Scaled {
  scaled(Self) -> Int
}

export struct Note {
  n: Int
}

export struct Wrap[T] {
  inner: T
}

impl Value[Alias] for Note {
  value(self) -> Alias {
    self.n
  }
}

impl [T: Value[Alias]] Scaled for Wrap[T] {
  scaled(self) -> Int {
    T::value(self.inner) * 10
  }
}

fn through_alias[V: Value[Alias]](_ v: V) -> Int {
  V::value(v)
}

export fn direct(_ n: Int) -> Int {
  Value::value(Note::{ n: n })
}

export fn bounded(_ n: Int) -> Int {
  through_alias(Note::{ n: n })
}

export fn generic_impl(_ n: Int) -> Int {
  Scaled::scaled(Wrap::{ inner: Note::{ n: n } })
}
