// #3593: functions whose result holds a closure inside a declared type's
// field, for importers that call them inside a `handle`. `mk` and
// `Factory::build` return a closure that throws, inheriting the row of the
// call; `mk_ok` throws only while it runs and returns a closure that does
// not, and `Box::empty` / `fallback` throw nothing.
export struct Box {
  f: () -> Int
}

export fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

export fn mk_ok(n: Int) -> Box with Exception[Int] {
  let m = if n < 0 {
    throw(n)
  } else {
    n
  }
  Box::{ f: () -> m + 1 }
}

export fn Box::empty() -> Box {
  Box::{ f: () -> 0 }
}

export fn fallback(n: Int) -> Box {
  Box::{ f: () -> n }
}

export struct Factory {
  n: Int
}

export fn Factory::build(self: Factory) -> Box with Exception[Int] {
  Box::{ f: () -> throw(self.n) }
}
