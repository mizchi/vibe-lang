// #3042: the dependency half of fixtures/ordering_prelude_cross_module_test.vibe.
// It derives `Ord` and builds an `Ordering` itself, without declaring or
// importing the enum; so does its importer.

export struct Version { major: Int; minor: Int } derive (Ord)

export fn newest_first(a: Version, b: Version) -> Ordering {
  match Version::compare(a, b) {
    Less => Greater,
    Equal => Equal,
    Greater => Less
  }
}
