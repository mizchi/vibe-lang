// #3601 (Codex on #3605): imports `fail`, which lets an `Int` out through
// its erased row, and EXPORTS a `fail` of its own that throws only messages.
// A dependency module may do this: its own declaration hides the import, and
// the local `fail` is the one an importer calls. The imported function's
// `Exception[Int]` used to be published for it all the same.
// (As an ENTRY module this is refused -- an entry's exported name cannot
// share a name with an import -- so check it through an importer.)
import ./exception_erased_row_dep.vibe {
  fail
}

export fn fail() -> Int with Exception {
  throw("mine")
}
