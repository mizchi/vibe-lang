// #3601 (Codex on #3605): imports `fail`, which lets an `Int` out through
// its erased row, and EXPORTS a `fail` of its own that throws only messages.
// The import is bound as `dep_fail` (#3549 refuses importing and declaring one
// name), and the local `fail` is the one an importer calls. The imported
// function's `Exception[Int]` used to be published for it all the same.
import ./exception_erased_row_dep.vibe {
  fail as dep_fail
}

export fn fail() -> Int with Exception {
  throw("mine")
}
