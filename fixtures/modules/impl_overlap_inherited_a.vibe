// #3551: `impl Child for Int` takes its inherited `get` from the `Int::get`
// below. A binding in the supertrait's namespace (`Base::tag`) sits between
// them, and the overlap check used to end the impl's run there.

import ./impl_overlap_child_trait.vibe {
  trait Base, trait Child
}

impl Child for Int

fn Base::tag(x: Int) -> Int {
  7
}

fn Int::get(x: Int) -> String {
  "from-a"
}

export fn inherited_a_name() -> String {
  Base::get(1)
}
