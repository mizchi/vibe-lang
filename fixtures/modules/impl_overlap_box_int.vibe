// #3551 review: an impl at `Box[Int]` only.
import ./impl_overlap_trait.vibe { trait Name }

import ./impl_overlap_box.vibe { struct Box }

impl Name for Box[Int] {
  name(x: Box[Int]) -> String {
    "from-int"
  }
}

fn via[T: Name](x: T) -> String {
  Name::name(x)
}

export fn box_int_name() -> String {
  via(Box::{ v: 1 })
}
