// #3816: a dependency whose LABELED calls mean the builtins. The importer
// (fixtures/builtin_shadow_labeled_dep_test.vibe) defines its own functions of
// these spellings, which this file cannot see.
export fn first(_ xs: Array[Int]) -> Int {
  Array::get(xs, at = 0)
}

export fn filled() -> Int {
  let values: Array[Int] = []
  Array::push(values, value = 29)
  Array::push(values, value = 11)
  Array::set(values, at = 1, value = 16)
  Array::get(values, at = 0) - Array::get(values, at = 1)
}

export fn doubled(_ xs: Array[Int]) -> Array[Int] {
  Array::map(xs, f = (x: Int) -> Int {
    x * 2
  })
}
