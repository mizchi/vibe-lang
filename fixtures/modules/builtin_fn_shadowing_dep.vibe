// #2378: the dependency that leaks. `String::index_of` is a builtin the
// registry owns; a `fn` at that name replaces it for every program that links
// this file, whether or not the program imports the name. The IMPORTER
// (fixtures/err_builtin_fn_shadowing.vibe) is the one refused.
export fn String::index_of(s: String, sub: String) -> Int {
  0 - 999
}

export fn unrelated_helper() -> Int {
  1
}
