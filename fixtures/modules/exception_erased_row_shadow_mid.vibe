// #3601 (Codex on #3605): imports `fail`, which lets an `Int` out through
// its erased row, and declares a `fail` of its own that throws only messages.
// Since #3549 importing and declaring one name is refused, so the import is
// bound as `dep_fail`. A call, an alias and a value use of `fail` here all
// reach the local one, and nothing this module publishes may carry the
// imported function's `Exception[Int]`: a stale marker keyed by the source
// name charged the alias and the wrapper's value use with it, refusing an
// importer's erased arm that reads the message.
import ./exception_erased_row_dep.vibe {
  fail as dep_fail
}

fn fail() -> Int with Exception {
  throw("own")
}

fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

export fn shadow_call() -> Int with Exception {
  fail() + 1
}

export fn shadow_value() -> Int with Exception {
  run(fail)
}

export let shadow_alias = fail
