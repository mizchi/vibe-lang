// #3947: provider for fixtures/trait_bound_through_imported_alias_test.vibe --
// an impl whose applied trait spells an exported alias.

export type Alias = Int

export trait Value[A] {
  value(Self) -> A
}

export struct Note {
  n: Int
}

impl Value[Alias] for Note {
  value(self) -> Alias {
    self.n
  }
}
