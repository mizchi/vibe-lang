// vibe: contract facade (desugared from .vibei)
// #3551: an ordinary module that opens with the loader's facade marker line.
// The overlap check used to read that line as "generated, restates only" and
// skip every impl here, so this module's `impl Name for Int` and
// impl_overlap_a.vibe's linked silently.

import ./impl_overlap_trait.vibe {
  trait Name
}

impl Name for Int {
  name(x: Int) -> String {
    "from-marker"
  }
}

export fn marker_name() -> String {
  Name::name(1)
}
