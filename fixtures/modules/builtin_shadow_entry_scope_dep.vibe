// #3185: a dependency whose own calls mean the builtins. The importer
// (fixtures/builtin_shadow_entry_scope_test.vibe) defines its own functions of
// these spellings, which this file cannot see.
export fn first(xs: Array[Int]) -> Int {
  Array::get(xs, 0)
}

export fn code_of(c: Char) -> Int {
  Char::to_int(c)
}

export fn doubled(xs: Array[Int]) -> Array[Int] {
  Array::map(xs, (x: Int) -> Int {
    x * 2
  })
}
