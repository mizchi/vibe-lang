// Multiple effects composed — Logger + Config + Exception
// Demonstrates 3-effect composition in single handle
effect Logger {
  Log(String) -> Unit;
}

effect Config {
  GetHost -> String;
  GetPort -> Int;
}

let result = handle {
  handle {
    handle {
      let host = perform Config::GetHost
      let port = perform Config::GetPort
      perform Logger::Log(host)
      if port < 0 {
        throw("invalid port")
      } else {
        String::length(host) + port
      }
    } with {
      Logger::Log(_msg) => resume(0)
    }
  } with {
    Config::GetHost => resume("localhost");
    Config::GetPort => resume(8080)
  }
} with {
  Exception::Throw(_msg) => -1
}
// host = "localhost" (9), port = 8080, Log → resume(0), 9 + 8080 = 8089
result

__DATA__
{"last": "8089"}
