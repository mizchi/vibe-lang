//# ADR-0097 fail-closed: a generic struct literal instantiated with an
//# AGGREGATE type argument.
//#
//# `Box::equals` is one generated function for the struct and compares the
//# erased field with a raw `==` -- content equality when `T` is scalar,
//# identity when it is not. So the annotated `Array[Box[Array[Int]]]` already
//# answers `false` for two equal boxes, and so does a bare `a == b` with no
//# array in sight (#2195, which predates #2157). An unannotated binding must
//# not adopt this instantiation and arrive at that same wrong answer through a
//# new spelling: `eq_type_args_all_scalar` rejects it, both bindings keep the
//# `[__EqEmpty]` sentinel, and `==` traps.
//#
//# `Box[Int]` is the other side of the same rule and ANSWERS -- pinned by "a
//# generic struct literal with a scalar type argument resolves" in
//# fixtures/structural_eq_contexts_test.vibe.

struct Box[T] {
  value: T
} derive (Eq)

export fn _start() -> Int {
  let left = []
  Array::push(left, Box[Array[Int]]::{
    value: [1, 2]
  })
  let right = []
  Array::push(right, Box[Array[Int]]::{
    value: [1, 2]
  })
  if left == right {
    1
  } else {
    0
  }
}
