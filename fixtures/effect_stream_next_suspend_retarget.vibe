// #1536 (a), eager Stream slice: `Stream::next` used to stay an opaque
// builtin until compile_call, after suspend CPS had already judged this
// resume-value Async handler ineligible. The linked prelude now retargets it
// to a row-free synthetic top-level fn before that pass. The block argument
// increments once, pinning the original one-evaluation ready Future[Option[T]]
// semantics; Some(41) + 1 evaluation = 42.
let _start = () -> Int {
  let evals = [
    0
  ]
  let value = handle {
    match await(Stream::next({
      Array::set(evals, 0, Array::get(evals, 0) + 1)
      [
        41
      ]
    })) {
      Some(v) => v,
      None => 0
    }
  } with Async {
    Suspend(req) => {
      let k = resume
      k(req)
    }
  }
  value + Array::get(evals, 0)
}
_start()

__DATA__
{
  "last": "42"
}
