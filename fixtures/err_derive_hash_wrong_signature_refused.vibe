// #3551: a `derive (Hash)` field whose type's written `hash_key` takes an
// `Int`, imported from another module. The derived key called it with an
// `Inner` anyway -- the call is generated after the checker -- and keyed the
// value's address (`Outer::hash_key` answered `4:k240`). The derive is
// refused, naming the edit.

import ./modules/derive_hash_wrong_signature_owner.vibe {
  struct Inner
}

struct Outer {
  i: Inner
} derive (Hash)

export let _start: () -> Int = () -> {
  0
}
