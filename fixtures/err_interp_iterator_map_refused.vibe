// #3212: an unannotated Iterator::map result has no known render shape.
// Refuse interpolation instead of printing the array's heap address.
import @vibe/builtin {
  trait Iterator
}

export let _start: () -> Int = () -> {
  let mapped = Iterator::map([1, 2, 3], (x: Int) -> Int {
    x * 2
  })
  String::length(__to_string(mapped))
}
