// #3495: a closure captures the names a map literal's values read. Before,
// `Map::from_pairs([("k", base)])` inside a lambda stopped the build with
// "`base` reached code generation unresolved".
fn run() -> Int {
  let base = 40
  let f = (extra: Int) -> {
    let m = Map::from_pairs([("k", base), ("e", extra)])
    Map::get(m, "k") + Map::get(m, "e")
  }
  f(2)
}

test "a map literal inside a closure reads its captures" {
  inspect(run(), content = "42")
}
