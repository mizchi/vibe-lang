//# #3297: the enum twin of `err_eq_derived_generic_struct_refused.vibe`.
//# `a` and `b` are `Wr[t, T]` with `t` free and `T` the function's
//# `Eq`-bounded formal; the ladder had only the name `Wr` and called the
//# derived `Wr::equals`, which compares the `Bad` payload with the raw `==`.
//# Measured before the refusal, equal `derive (Eq)` payloads answered `false`.

enum Wr[T, E] {
  Good(T);
  Bad(E)
}

struct Pt {
  x: Int;
  tags: Array[Int]
} derive (Eq)

fn same_bad[T: Eq](x: T, y: T) -> Bool {
  let a = Bad(x)
  let b = Bad(y)
  a == b
}

test "equal payloads" {
  inspect(same_bad(Pt::{ x: 1, tags: [1] }, Pt::{ x: 1, tags: [1] }), "true")
}
