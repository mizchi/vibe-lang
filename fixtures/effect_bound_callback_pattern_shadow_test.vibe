// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let pure = () -> 7
    let data = g
    match (pure, data) {
      (data, x) => apply(f = x)
    }
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through pattern shadow" {
  inspect(result(), content = "106")
}
