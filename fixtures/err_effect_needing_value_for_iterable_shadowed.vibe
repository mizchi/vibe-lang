// #4065: a `for` binder spelled like its iterable (`for xs in xs`). The
// iterable is read again before every pass, and that read must resolve the
// OUTER `xs`, not the binder the previous pass bound: a store through an alias
// of the outer array (`ys`) puts the closure at element 1, so the second pass
// hands it to a row-free parameter at its evidence arity. Refused at build
// time, as #1261 refuses the bare name; reading the binder instead missed the
// store, and the program compiled and trapped in `apply`.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7, () -> 8]
    let ys = xs
    let mut total = 0
    for xs in xs {
      total = total + apply(f = xs)
      Array::set(ys, at = 1, value = g)
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
