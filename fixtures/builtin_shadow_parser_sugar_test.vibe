// #3132 review: `a[i]` and a record pattern's field reads are spelled by the
// parser as calls to `__index` / `__rec_field`. A program that defines its
// own function under either name must not capture that sugar, and its own
// direct calls must reach its own function rather than the builtin.

fn __index(xs: Array[Int], i: Int) -> Int {
  let _ = xs
  let _ = i
  999
}

fn __rec_field(r: Int, i: Int) -> Int {
  let _ = r
  let _ = i
  777
}

test "index sugar reaches the builtin" {
  let xs = [4, 5, 6]
  inspect(xs[2], content = "6")
  inspect(xs[0] - xs[1], content = "-1")
}

test "record destructure reaches the builtin" {
  let r = record { name: "z", ver: 42 }
  let record { name: n, ver: v } = r
  inspect(v, content = "42")
  inspect(n, content = "z")
  inspect(r.ver - 50, content = "-8")
}

test "own calls reach the program's functions" {
  inspect(__index([1], 0), content = "999")
  inspect(__rec_field(1, 0), content = "777")
}
