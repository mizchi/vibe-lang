// #3370: a callback whose performs the callee handles itself needs no row
// on the function that writes it. Both used to be refused: `producer` with
// `missing { Box::Put }`, and the test through `run_two` with "cannot
// discharge { Two2 }". A literal with no written row at a row-typed
// parameter is also given the dict its callee passes (`edp_stamp_slot_rows`):
// `run_str(() -> 3)` and a literal that calls a performing function trapped
// with `null function or function signature mismatch`.
effect Box[T] {
  Put(T) -> Int
}

fn run_str(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s)) }
}

fn producer() -> Int {
  run_str(() -> {
    perform Box::Put("abc")
  })
}

fn put_abcd() -> Int with Box[String] {
  perform Box::Put("abcd")
}

effect Two2 {
  A(Int) -> Int
  B(Int) -> Int
}

fn two_ops() -> Int with Two2 {
  perform Two2::A(2) + perform Two2::B(3)
}

fn run_two(f: () -> Int with Two2) -> Int {
  handle {
    f()
  } with { Two2::A(n) => resume(n); Two2::B(n) => resume(n + 1) }
}

test "the callee handles the callback's perform" {
  inspect(producer(), "3")
}

test "through a parameter" {
  inspect(run_two(() -> two_ops()), "6")
}

test "a pure literal at a row-typed parameter" {
  inspect(run_str(() -> 3), "3")
}

test "a literal that calls a performing function" {
  inspect(run_str(() -> put_abcd()), "4")
}

fn run_lab(f~: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s) + 10) }
}

// A local elsewhere spelled like the callee does not shadow it here.
fn unrelated_local() -> Int {
  let run_str = 1
  run_str
}

test "a literal passed by label" {
  inspect(run_lab(f = () -> 3), "3")
  inspect(run_lab(f = () -> put_abcd()), "14")
  inspect(run_lab(f = () -> {
    perform Box::Put("xy")
  }), "12")
}

test "a local of the callee's name elsewhere" {
  inspect(unrelated_local() + run_str(() -> 3), "4")
}

// A top-level destructuring `let` keeps its initializer through lowering, and
// a literal in it is stamped the same way.
let (lp_a, lp_b) = (run_str(() -> 3), 0)

test "a literal inside a top-level destructuring let" {
  inspect(lp_a + lp_b, "3")
}

// #3424: a literal that calls a local closure is given a copy of that
// closure's binding, so it can take the dict its callee passes. It was left
// at arity 0 and trapped (`null function or function signature mismatch`).
fn local_helper() -> Int {
  let helper = () -> 3
  run_str(() -> helper())
}

fn local_helper_capture() -> Int {
  let k = 4
  let add = (x: Int) -> x + k
  run_str(() -> add(1) + put_abcd())
}

fn local_helper_two() -> Int {
  let one = () -> 1
  let two = () -> 2
  run_str(() -> one() + two())
}

// A name the closure binds itself is not a capture, so a later `k` does not
// stop the copy (Codex on #3437).
fn local_helper_own_binder() -> Int {
  let helper = () -> {
    let k = 3
    k + 1
  }
  let k = 100
  run_str(() -> helper() + k)
}

// A name the literal binds in one branch does not hide the outer closure the
// other branch calls (Codex on #3437).
fn local_helper_branch(flag: Bool) -> Int {
  let helper = () -> 3
  run_str(() -> {
    if flag {
      let helper = 10
      helper
    } else {
      helper()
    }
  })
}

// A name the closure reads that is rebound before the literal, or by an
// enclosing parameter, is read through a snapshot taken right after the
// closure. Both used to decline the copy and trap.
fn local_helper_snapshot() -> Int {
  let k = 1
  let helper = () -> k
  let k = 2
  run_str(() -> helper() * 10 + k)
}

fn local_helper_snapshot_param() -> Int {
  let k = 7
  let helper = () -> k
  let run_k = (k: Int) -> run_str(() -> helper() + k)
  run_k(100)
}

// A literal that calls a row-free TOP-LEVEL function while binding the same
// name in another branch is not calling a local (Codex on #3437). Read
// unscoped, the binder made the call look local, the literal was left at
// arity 0, and the callee's dict trapped it.
fn tl_helper() -> Int {
  2
}

fn top_helper_branch(flag: Bool) -> Int {
  run_str(() -> {
    if flag {
      let tl_helper = 10
      tl_helper
    } else {
      tl_helper()
    }
  })
}

test "a literal that calls a local closure" {
  inspect(local_helper(), "3")
  inspect(local_helper_capture(), "9")
  inspect(local_helper_two(), "3")
  inspect(local_helper_own_binder(), "104")
  inspect(local_helper_branch(false), "3")
  inspect(local_helper_branch(true), "10")
  inspect(local_helper_snapshot(), "12")
  inspect(local_helper_snapshot_param(), "107")
  inspect(top_helper_branch(false), "2")
  inspect(top_helper_branch(true), "10")
  let helper = () -> 5
  inspect(run_str(() -> helper()), "5")
}

fn run_labeled_pair(prefix: String, f~: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(prefix) + String::length(s)) }
}

test "a reordered labeled callback uses its declared effect slot" {
  inspect(run_labeled_pair(f = () -> put_abcd(), prefix = "x"), "5")
  inspect(run_labeled_pair(f = () -> 3, prefix = "x"), "3")
}
