//# #3837: a builtin type imported under another name is a type. Before,
//# `import @vibe/builtin { Float64 as D }` reached `D::floor` but `fn h(x: D)`
//# was an unknown type, and a facade's `export { D }` published nothing, so
//# its importer got an unknown type and `unknown name: D::floor`.

import @vibe/builtin {
  Int as I
}

import ./_builtin_type_alias_facade.vibe {
  D, D::cube, Str
}

import ./_builtin_type_alias_plain_facade.vibe {
  Float64 as F
}

fn inc(n: I) -> I {
  n + 1
}

fn half(x: D) -> D {
  x / 2.0
}

fn shout(s: Str) -> Str {
  s + "!"
}

fn quarter(x: F) -> F {
  x / 4.0
}

test "a directly imported builtin alias is a type" {
  let n: I = 41
  inspect(inc(n = n), content = "42")
  inspect(I::popcount(7), content = "3")
}

test "a re-exported builtin alias is a type, with its companions" {
  let a: D = 1.5
  inspect(half(x = a), content = "0.75")
  inspect(D::floor(2.5), content = "2")
  inspect(D::cube(2.0), content = "8")
  inspect(shout(s = "hi"), content = "hi!")
  inspect(Str::trim("  x  "), content = "x")
}

test "an importer alias of a builtin a facade re-exports" {
  inspect(quarter(x = 1.0), content = "0.25")
}
