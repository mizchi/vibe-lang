// #3769: `import @vibe/builtin { Iterator }` without the `trait` keyword named
// the builtin trait and silenced the unknown-name check for `Iterator::map`,
// but only the `trait Iterator` spelling binds the namespace's operations. The
// program checked clean and then reached code generation with `Iterator::map`
// unresolved (an internal compiler error). The bare spelling is refused now,
// and the message names both edits.
import @vibe/builtin { Iterator }

fn main allows Console {
  let xs = [1, 2, 3]
  let d = Iterator::map(xs, f = (x) -> { x * 2 })
  println("\{d}")
}
