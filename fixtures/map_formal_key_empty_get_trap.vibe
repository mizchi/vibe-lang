// #4121: a generic `Map::get` on an empty `Map::new()` misses the way the
// concrete call does. The empty map carries no key-class mark, so the generic
// read takes the String path, finds no entry for any key, and traps with the
// same message. Pinned by the early gate (#2990's row): this program must
// FAIL at run time after printing `before`.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, key = k)
}

fn main allows Console {
  let e: Map[Int, Int] = Map::new()
  println("before: \{Map::has_key(e, key = 1)}")
  println("after: \{look(m = e, k = 1)}")
}
