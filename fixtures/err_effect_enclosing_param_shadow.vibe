// #1720: all enclosing parameters seed handle eligibility. This ordinary
// parameter masks the same-named top-level function even though its row is not
// a CPS source.
effect Ask {
  Get(Int) -> Int
}

fn pick() -> Int {
  5
}

fn outer(pick: () -> Int) -> Int {
  handle {
    let seed = perform Ask::Get(0)
    seed + pick()
  } with {
    Ask::Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}

let _start = () -> Int {
  outer(() -> Int {
    7
  })
}
