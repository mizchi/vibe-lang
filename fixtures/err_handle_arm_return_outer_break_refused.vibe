// #3547: an arm's `return` sends this handle through the lowering that runs
// the arm where the `handle` is, because the body reaches `Ask` through a
// call -- and that lowering cannot carry the body's `break` out to the loop
// around the handle. The refusal used to blame a `resume` captured as a
// value, which this program does not do; it now names the `return` and
// leads with the edits (a direct `perform` in the body compiles and
// answers 4).
effect Ask {
  Get() -> Int
}

fn ask() -> Int with Ask {
  perform Ask::Get()
}

fn count() -> Int {
  let mut n = 0
  while true {
    handle {
      n = n + 1
      if n > 3 {
        break
      } else {
        ()
      }
      ask()
    } with { Ask::Get() => if n > 10 {
      return -1
    } else {
      resume(n)
    } }
  }
  n
}

export let _start: () -> Int = () -> count()
