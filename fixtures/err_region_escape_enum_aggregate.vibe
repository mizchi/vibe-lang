struct EnumSlot {
  callback: () -> Array[Int]
}

enum Envelope[T] {
  Wrap(T)
}

test "first-class enum constructors preserve payload provenance" {
  let wrap = Wrap
  let escaped = region r {
    let values = MutList::empty(r)
    wrap(EnumSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let Wrap(slot) = escaped
  let _ = slot.callback()
}
