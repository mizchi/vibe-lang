// #729/#730: Fs::readdir(path) -> Array[String]. The host import
// (`fs_read_dir_nul`) returns the byte-sorted entry names NUL-joined as one
// string (fs_read_file's ABI); compile_call lowers the Array[String] surface
// to a String::split over it. NUL because a POSIX name may contain a newline
// but never a NUL byte: the "\n" framing this replaced split such a name into
// fake entries (#2957), which the last test below pins.
// The checker has typed Fs::readdir since the host era — this locks the
// selfhost codegen + both runners actually implementing it.
//
// A test block is granted the host effects, so the writes/reads below hit the
// real preopen FS with no handler around them. They used to sit under
// `handle` blocks whose arms answered "" / 0 "for the checker only"; since
// #1962 a handler intercepts the operations it names, direct calls included,
// so those arms would now answer and the writes would never happen.

// #897: this used to `import ../lib/@vibe/fs/fs_effect.vibe { Fs }`, but
// @vibe/fs is a .vpkg contract package now and its internal files are
// sealed behind the package boundary (#729). Importing the package facade
// instead is NOT equivalent: the facade re-exports the canonical
// `Fs::write_file`/... VALUE aliases (perform-based, mockable), and —
// qualified exports being exempt from the #716 rename — they capture this
// file's direct builtin `Fs::write_file` calls, so the writes above went to
// the mock handler instead of the real preopen FS and readdir found
// nothing. This test only needs the Fs effect ROW, so declare it locally —
// same declaration as lib/@vibe/fs/fs_effect.vibe.
effect Fs {
  ReadFile(String) -> String;
  WriteFile(String, String) -> Unit;
  Exists(String) -> Bool;
  Mkdir(String) -> Unit
}

let fixture_dir = "_build/fixture_readdir_test"

let write_and_list: () -> Int with Fs = () -> {
  Fs::write_file("\{fixture_dir}/b.txt", "b")
  Fs::write_file("\{fixture_dir}/a.txt", "a")
  Fs::write_file("\{fixture_dir}/c.vibe", "c")
  let names = Fs::readdir(fixture_dir)
  assert(Array::get(names, 0) == "a.txt")
  assert(Array::get(names, 1) == "b.txt")
  assert(Array::get(names, 2) == "c.vibe")
  Array::length(names)
}

let count_vibe_entries: () -> Int with Fs = () -> {
  let names = Fs::readdir(fixture_dir)
  let mut count = 0
  let mut i = 0
  while i < Array::length(names) {
    if String::ends_with(Array::get(names, i), ".vibe") {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

test "readdir lists entry names byte-sorted" {
  let n = write_and_list()
  assert(n == 3)
}

test "readdir result behaves as a normal array" {
  let vibes = count_vibe_entries()
  assert(vibes == 1)
}

// #2957: a file name holding a newline is ONE entry. Under the "\n" framing
// this directory listed as ["plain.txt", "we", "ird.txt"] -- three names, two
// of them files that do not exist.
let newline_dir = "_build/fixture_readdir_newline_test"

let list_newline_dir: () -> Array[String] with Fs = () -> {
  Fs::write_file("\{newline_dir}/we\nird.txt", "w")
  Fs::write_file("\{newline_dir}/plain.txt", "p")
  Fs::readdir(newline_dir)
}

test "readdir keeps a name containing a newline as one entry" {
  let names = list_newline_dir()
  inspect(Array::length(names), "2")
  inspect(Array::get(names, 0), "plain.txt")
  assert(Array::get(names, 1) == "we\nird.txt")
  // The listed name must name a real file: reading it back by that exact
  // name is what a caller walking the directory does next.
  inspect(Fs::read_file("\{newline_dir}/\{Array::get(names, 1)}"), "w")
}
