// #3370: the row pass also charges the callback to its caller. The outer
// arm discharges that charge, but answers -1; the expected 3 must come from
// the imported handler reading the actual String payload.
import ./typecheck/callback_row_lowercase_alias_dep_ok.vibe {
  effect Box, payload, run
}

test "an imported lowercase alias carries a real String into its handler" {
  let result = handle {
    run(() -> {
      perform Box::Put("abc")
    })
  } with { Box::Put(_) => resume(0 - 1) }
  assert_eq(result, 3)
}
