// #1310: MapBuilder::has_key / MapBuilder::get -- O(n) scan over the same
// handle-indirect storage MapBuilder::set already walks (see its search loop
// in codegen/expr/compile_call.vibe / codegen/gc/backend_call.vibe). Lets a
// caller test membership / read a value mid-build without freezing to a Map
// first (previously the only way to inspect a builder's contents).

test "MapBuilder::has_key on an empty builder is always false" {
  let b = MapBuilder::new()
  assert_eq(MapBuilder::has_key(b, key = "missing"), false)
}

test "MapBuilder::get on an empty builder is always None" {
  let b = MapBuilder::new()
  assert_eq(MapBuilder::get(b, key = "missing"), None)
}

test "MapBuilder::has_key / MapBuilder::get see keys set before freeze" {
  let b = MapBuilder::new()
  MapBuilder::set(b, key = "a", value = 1)
  MapBuilder::set(b, key = "b", value = 2)
  assert_eq(MapBuilder::has_key(b, key = "a"), true)
  assert_eq(MapBuilder::has_key(b, key = "b"), true)
  assert_eq(MapBuilder::has_key(b, key = "c"), false)
  assert_eq(MapBuilder::get(b, key = "a"), Some(1))
  assert_eq(MapBuilder::get(b, key = "b"), Some(2))
  assert_eq(MapBuilder::get(b, key = "c"), None)
}

test "MapBuilder::get reflects an in-place update, not a stale duplicate" {
  let b = MapBuilder::new()
  MapBuilder::set(b, key = "k", value = 1)
  MapBuilder::set(b, key = "k", value = 2)
  assert_eq(MapBuilder::get(b, key = "k"), Some(2))
  assert_eq(MapBuilder::has_key(b, key = "k"), true)
}

let make_keys: (Int) -> Array[String] = (n) -> {
  let seed = for i in [0] { "" }
  let ks = Array::slice(seed, start = 0, end = 0)
  let mut i = 0
  while i < n {
    Array::push(ks, value = String::concat("key", __to_string(i)))
    i = i + 1
  }
  ks
}

test "MapBuilder::has_key / MapBuilder::get keep working past a storage grow" {
  // Initial capacity is 8 entries in the linear lane / 32 in the gc lane
  // (see fixtures/map_builder_growth_test.vibe) -- 40 keys forces at least
  // one grow-and-copy in both, exercising the scan against the grown
  // (reallocated) storage block, not just the original one.
  let ks = make_keys(n = 40)
  let b = MapBuilder::new()
  let mut i = 0
  while i < 40 {
    MapBuilder::set(b, key = ks[i], value = i * 10)
    i = i + 1
  }
  assert_eq(MapBuilder::has_key(b, key = ks[0]), true)
  assert_eq(MapBuilder::has_key(b, key = ks[39]), true)
  assert_eq(MapBuilder::has_key(b, key = "not-a-key"), false)
  assert_eq(MapBuilder::get(b, key = ks[0]), Some(0))
  assert_eq(MapBuilder::get(b, key = ks[39]), Some(390))
  assert_eq(MapBuilder::get(b, key = "not-a-key"), None)
}

test "MapBuilder::has_key / MapBuilder::get agree with the frozen Map" {
  let b = MapBuilder::new()
  MapBuilder::set(b, key = "x", value = 10)
  MapBuilder::set(b, key = "y", value = 20)
  // Two separate assert_eq calls, not one over a `(Bool, Option[Int])`
  // tuple: structural `==` of a tuple containing an Option is a known gap
  // under the wasm-gc backend (unrelated to MapBuilder, reproduces on a
  // bare `assert_eq((true, Some(20)), (true, Some(20)))` too) -- not
  // something this fix touches.
  assert_eq(MapBuilder::has_key(b, key = "x"), true)
  assert_eq(MapBuilder::get(b, key = "y"), Some(20))
  let m = MapBuilder::freeze(b)
  assert_eq(Map::has_key(m, key = "x"), true)
  assert_eq(Map::get(m, key = "y"), 20)
}
