// An annotated local alias retains the row-free convention of its callback.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(_ f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn run() -> Int {
  let g = () -> 1
  let a: () -> Int = g
  drive(a) + drive(tick)
}

test "an annotated alias keeps a row-free calling convention" {
  inspect(run(), content = "2")
}
