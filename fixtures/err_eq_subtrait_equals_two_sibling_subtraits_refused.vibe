// #3587: two sibling modules each write `equals` in an impl of a different
// subtrait of `Eq` for `Box`. This answered `mark=true key=false` for one
// value. Refused at link time, naming both impls.

import ./modules/eq_subtrait_sib_types.vibe {
  struct Box
}

import ./modules/eq_subtrait_sib_key.vibe {
  via_key
}

import ./modules/eq_subtrait_sib_mark.vibe {
  via_mark
}

test "one equals for Box through every bound" {
  let p: Box[Int] = Box::{ v: 1 }
  inspect("mark=\{via_mark(p, p)} key=\{via_key(p, p)}", content = "mark=true key=true")
}
