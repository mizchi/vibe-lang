// ADR-0068 `Send` (#1090 review): the coinductive guard must key on the
// type constructor AND its arguments. `LoopT[Int]` reaches
// `LoopT[Array[Int]]` through its own field; with a name-only key the
// recursive occurrence was treated as already-proven and the
// `v: Array[Int]` payload was never checked.
struct LoopT[T] { v: T; next: Option[LoopT[Array[Int]]] }

let want_send = [T: Send](x: T) -> T { x }

fn main {
  let l: LoopT[Int] = LoopT::{ v: 1, next: None }
  let _ = want_send(l)
  ()
}
