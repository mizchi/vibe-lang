// #3547: an arm that leaves the function with `return` while the body reaches
// the effect through a call has to run where the `handle` is, and a call
// inside a `for` over an array the body does not build itself cannot be
// arranged that way. The refusal used to say an arm "captures `resume` as a
// value", which this arm does not do; it now names the `return` and leads
// with the edits (a direct `perform` in the body compiles and answers -1).
effect Ask {
  Get() -> Int
}

fn ask() -> Int with Ask {
  perform Ask::Get()
}

fn sum(xs: Array[Int]) -> Int {
  let mut s = 0
  handle {
    for x in xs {
      s = s + ask() + x
    }
    s
  } with { Ask::Get() => if s > 3 {
    return -1
  } else {
    resume(1)
  } }
}

export let _start: () -> Int = () -> sum([1, 2, 3, 4, 5])
