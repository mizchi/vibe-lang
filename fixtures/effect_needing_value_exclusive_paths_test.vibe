// #4065: reads the walk can show are plain closures compile and run.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

// A store in one `match` arm has not run in another, so the other arm's read
// of the element that is still a plain closure compiles.
fn other_arm(flag: Int) -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs = [() -> 42]
    match flag {
      0 => {
        Array::push(xs, value = g)
        0
      },
      _ => apply(f = Array::get(xs, at = 0))
    }
  } with {
    Ask::Get() => resume(5)
  }
}

// A binding of a projection (`let inner = pair.1`) is read through the part it
// was bound to, so `inner.1` is the plain closure beside the handle-bound one.
fn projected_binding() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let pair = (g, (g, () -> 42))
    let inner = pair.1
    apply(f = inner.1)
  } with {
    Ask::Get() => resume(5)
  }
}

test "a store in one match arm is not seen by another" {
  inspect(other_arm(flag = 1), content = "142")
}

test "a binding of a projection reads the part it was bound to" {
  inspect(projected_binding(), content = "142")
}
