// Codex on #3349: a generic impl of a SUBTRAIT names its refused bound too.
//
// `[U: Base]` at `Box[Pt]` is satisfied, if at all, by `impl [T: Eq] Child
// for Box[T]` through `trait Child: Base` (`type_implements_check_super`).
// Its marker-`Eq` bound reaches no witness at `Pt`, so the impl does not
// apply and the bound is refused -- but the hint matched only impls of `Base`
// itself, so the message was a bare "no impl `Base` for `Box[Pt]`" with no
// edit. It now names the parameter bound and the `Eq` edit, as for a direct
// impl (fixtures/err_type_eq_generic_impl_param_bound.vibe).

trait Eq {}

struct Pt {
  v: Int
}

impl Eq for Pt {}

trait Base {
  same(Self, Self) -> Bool
}

trait Child: Base {}

struct Box[T] {
  v: T
}

impl [T: Eq] Child for Box[T] {
  same(a: Box[T], b: Box[T]) -> Bool {
    a.v == b.v
  }
}

fn f[U: Base](a: U, b: U) -> Bool {
  U::same(a, b)
}

fn main() -> Unit allows Console {
  println(__to_string(f(Box::{ v: Pt::{ v: 1 } }, Box::{ v: Pt::{ v: 1 } })))
}
