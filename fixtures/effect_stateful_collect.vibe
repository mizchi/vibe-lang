// Stateful handler pattern: mutable state with inline perform
// Limitation: handler body is inlined at perform site,
// so mutable state must be in the OUTER scope (not handler scope).

effect Emit {
  Emit(Int) -> Unit
}

let collect = () -> Int {
  let mut count = 0
  // Direct perform with handler — count is in outer scope
  handle {
    count = count + 1
    perform Emit::Emit(10)
    count = count + 1
    perform Emit::Emit(20)
    count = count + 1
    perform Emit::Emit(30)
    count
  } with {
    Emit::Emit(_v) => resume(0)
  }
}
collect()

__DATA__
{"last": "3"}
