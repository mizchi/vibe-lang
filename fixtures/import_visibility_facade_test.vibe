// #716: importing through a re-export facade binds to the renamed origin,
// and a builtin-colliding export that is NOT imported here stays invisible —
// the bare name keeps its builtin meaning.

import ./import_visibility_facade.vibe {
  pick
}

import ./import_visibility_dep_b.vibe {
  pick as pick_b
}

test "re-export facade resolves to the renamed origin (#716)" {
  assert_eq(pick(), 1)
  assert_eq(pick_b(), 2)
}

test "builtin add stays builtin without an import (#716)" {
  // dep A (linked via the facade) exports `add`, but this file does not
  // import it, so `add` here is the builtin integer add.
  assert_eq(add(1, 2), 3)
}
