// The maps stay live while the host inspects the returned slot arrays.
// Reading the guest memory leaves each box's reference count intact.
import ../lib/@vibe/core {
  MutMap
}

type Slots = (Array[Option[Int]], Array[Option[Int]])

let original: MutMap[Int, Int] = MutMap::with_capacity_int(16)

let shifted: MutMap[Int, Int] = MutMap::with_capacity_int(16)

// The isolated RC validator can check a positional call through this signature.
let insert: (MutMap[Int, Int], Int, Int) -> Unit = MutMap::set

fn fill(_ table: MutMap[Int, Int], _ offset: Int) -> Slots {
  let mut i = 0
  while i < 20 {
    let key = i + offset
    insert(table, key, 100 + key)
    i = i + 1
  }
  (table.keys, table.vals)
}

fn main() -> (Slots, Slots) {
  (fill(original, 0), fill(shifted, 16))
}
