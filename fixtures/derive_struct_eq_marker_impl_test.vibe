// #1967: was fixtures/derive_struct_eq_marker_impl.vibe + __DATA__.last "true".
//
// #2523: this used to pin that `impl Eq for Point` makes a `[T: Eq]` bound
// SATISFIABLE at `Point`, with a `fn same[T: Eq](a, b) { true }` whose body
// never compared -- so it blessed the shape without observing what it answers.
// Measured then, it answered by REFERENCE: two equal, distinct `Point` gave
// `false`.
//
// `Eq` carries a method now, `derive (Eq)` registers the impl, and a bound
// dispatches through the generated `Point::equals`. The explicit `impl Eq for
// Point` that used to sit here is GONE: writing both is an overlap
// (`overlapping impls for `Eq`: existing target `Point` overlaps new target
// `Point``), which is the right answer -- the derive already supplies the one
// impl there is.
//
// What this pins is the concrete site, unaffected throughout. The BOUND at a
// derived struct is `fixtures/eq_bound_derive_test.vibe`.

struct Point {
  x: Int;
  y: Int
} derive (Eq)

test "derive(Eq) compares two Points by content" {
  let a = Point::{ x: 1, y: 1 }
  let b = Point::{ x: 1, y: 1 }
  let c = Point::{ x: 1, y: 2 }
  inspect(a == b, "true")
  inspect(a == c, "false")
  inspect(Point::equals(a, b), "true")
  inspect(Point::equals(a, c), "false")
}
