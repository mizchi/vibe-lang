enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

let area = (s: Shape) -> Int {
  match s {
    Circle(r) => r * r * 3,
    Rect(w, h) => w * h
  }
}

let perimeter = (s: Shape) -> Int {
  match s {
    Circle(r) => r * 2 * 3,
    Rect(w, h) => (w + h) * 2
  }
}

area(Circle(5)) + perimeter(Rect(3, 4))

