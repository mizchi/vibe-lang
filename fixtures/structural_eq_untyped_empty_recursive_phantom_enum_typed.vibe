//# Codex round 18 on #2456: a RECURSIVE generic enum whose formal is phantom,
//# `enum Loop[T] { End(Int); Next(Loop[T]) }`. No payload ever reads `T`; the
//# derived `Loop::equals` compares `End`'s Int and recurses into `Next`. Both
//# recursion guards answer a revisited enum coinductively: the recursive
//# occurrence is compared by the comparator under examination, and the other
//# payloads are still walked. Measured on 27640f5: the direct compare (which
//# answered on the baseline) and the untyped-empty compare both trapped; both
//# ANSWER now, and the `Int` payload is exact for `64 << 32` vs `65 << 32`.

enum Loop[T] {
  End(Int);
  Next(Loop[T])
}

fn fill(xs: Array[Loop[String]], v: Int) -> Unit {
  Array::push(xs, Next(End(v)))
}

fn mk(v: Int) -> Loop[String] {
  Next(Next(End(v)))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let shallow = []
  Array::push(shallow, End(64 << 32))
  assert(left == right)
  assert(left != other)
  assert(left != shallow)
  let a = mk(1)
  let b = mk(1)
  let c = mk(2)
  assert(a == b)
  assert(a != c)
  0
}
