// #699/#700/#701/#702 RC reclamation leak guard.
//
// A hot loop that allocates, every iteration, a tuple + a captured `let mut`
// cell + the closure that captures it + a recursive enum tree consumed by a
// recursive function — all of which must be reclaimed under the Perceus RC
// codegen (VIBE_RC=1). With reclamation the bump pointer (__heap_ptr) is reused
// each iteration, so total heap allocated stays a small constant. Without it,
// heap_used scales with the iteration count — covering regressions in tuple RC
// reclaim (#700), captured-mut cell/closure reclaim (#699), VIBE_RC being
// silently ignored in FS-compile mode (#701), and the recursive-enum
// match-destructuring double-free that trapped at scale (#702 Blocker B).
//
// The gate (scripts/selfhost_only_gate.sh step 40d) compiles this under
// VIBE_RC=1 + VIBE_FS_COMPILE=1 (the `vibe run` path), measures __heap_ptr via
// scripts/measure_selfhost_heap.mjs, and asserts heap_used stays below a small
// bound. At N=20000 a leak would be hundreds of KB; reclamation keeps it tiny.
enum Tree { Leaf(Int); Node(Tree, Tree) }

struct Box { items: Array[Int] }

let sumt = (t: Tree) -> Int {
  match t {
    Leaf(v) => v,
    Node(l, r) => sumt(l) + sumt(r)
  }
}

// #703 guard: binds the matched heap children `l`/`r` but never references them.
// Their #702 dup would be unbalanced (no consuming drop), so an unreferenced
// binding must be left un-dup'd and reclaimed by the scrutinee's recursive drop.
let ignore_children = (t: Tree) -> Int {
  match t {
    Leaf(_) => 0,
    Node(l, r) => 7
  }
}

let main = () -> Int {
  let mut total = 0
  let mut i = 0
  while i < 20000 {
    let t = (i, i + 1)
    let mut c = 0
    let bump = () -> { c = c + 1 }
    bump()
    let tr = Node(Leaf(i), Leaf(i + 1))
    // #704 projection-ownership reclamation guard: `Array::get(b.items, _)`
    // passes a heap field projection as the BORROWED arg0 of a builtin, which
    // must NOT be rc_dup'd at the call site (the builtin never drops it) — else
    // one reference leaks per iteration and heap scales with N. The struct `b`
    // and its array reclaim each iteration only when that dup is suppressed.
    let b = Box::{ items: [i, i + 1, i + 2] }
    let first = Array::get(b.items, 0)
    // #703 unused-matched-field guard (drives `ignore_children`, which binds but
    // never references the heap children — see its definition above).
    let ignored = ignore_children(Node(Leaf(i), Leaf(i + 1)))
    // #703 follow-up: inline temporary match scrutinee. The matched-on `Node`
    // value is constructed in scrutinee position with no binding to drop it; the
    // RC scrutinee-lift must reclaim it each iteration (else heap scales with N).
    let inlined = match Node(Leaf(i), Leaf(i + 1)) {
      Leaf(_) => 0,
      Node(l, r) => sumt(l) + sumt(r)
    }
    // #703-2 borrow-only matched-field guard: `xs` is bound and referenced, but
    // only as the borrowed arg0 of `Array::length` — never consumed. Its #702
    // dup must be suppressed (md_consumes) or the array leaks each iteration.
    let blen = match Some([i, i + 1]) {
      Some(xs) => Array::length(xs),
      None => 0
    }
    total = total + t.0 + t.1 + c + sumt(tr) + first + ignored + inlined + blen
    i = i + 1
  }
  total
}
