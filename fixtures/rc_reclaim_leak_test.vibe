// #699/#700/#701/#702/#706 RC reclamation leak guard.
//
// A hot loop that allocates, every iteration, a tuple + a captured `let mut`
// cell + the closure that captures it + a recursive enum tree consumed by a
// recursive function — all of which must be reclaimed under the Perceus RC
// codegen (VIBE_RC=1). With reclamation the bump pointer (__heap_ptr) is reused
// each iteration, so total heap allocated stays a small constant. Without it,
// heap_used scales with the iteration count — covering regressions in tuple RC
// reclaim (#700), captured-mut cell/closure reclaim (#699), VIBE_RC being
// silently ignored in FS-compile mode (#701), the recursive-enum
// match-destructuring double-free that trapped at scale (#702 Blocker B), and
// a heap param consumed by a normal (owning) call INSIDE a while loop — whose
// protective per-iteration dup (#706 core fix) leaves the param's OWN
// reference unspent unless the function epilogue also compensates for it
// (#706 leak follow-up; each call to `consume_in_loop` below leaked one array
// before that fix, scaling heap_used with N).
//
// The gate (scripts/selfhost_only_gate.sh step 40d) compiles this under
// VIBE_RC=1 + VIBE_FS_COMPILE=1 (the `vibe run` path), measures __heap_ptr via
// scripts/measure_selfhost_heap.mjs, and asserts heap_used stays below a small
// bound. At N=20000 a leak would be hundreds of KB; reclamation keeps it tiny.
enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
}

struct Box {
  items: Array[Int]
}

let sumt = (t: Tree) -> Int {
  match t {
    Leaf(v) => v,
    Node(l, r) => sumt(l) + sumt(r)
  }
}

// #703 guard: binds the matched heap children `l`/`r` but never references them.
// Their #702 dup would be unbalanced (no consuming drop), so an unreferenced
// binding must be left un-dup'd and reclaimed by the scrutinee's recursive drop.
let ignore_children = (t: Tree) -> Int {
  match t {
    Leaf(_) => 0,
    Node(l, r) => 7
  }
}

// #706 leak guard: `sumarr` normally (non-borrow-arg0) consumes its param `a`.
// `consume_in_loop` calls it inside a `while` loop, so `a` is a heap param
// consumed at an owning call-arg position inside a loop — the exact #706
// shape (parse_module_sections' `token_type(tokens, i)`). Each call to
// `consume_in_loop` must fully reclaim its own `a` (an array literal built at
// the call site, unreachable afterward) — a per-call leak here scales
// heap_used with N just like the earlier tuple/enum/closure guards above.
let sumarr = (a: Array[Int]) -> Int {
  Array::get(a, 0) + Array::get(a, 1) + Array::get(a, 2)
}

let consume_in_loop = (a: Array[Int]) -> Int {
  let mut k = 0
  let mut s = 0
  while k < 3 {
    s = s + sumarr(a)
    k = k + 1
  }
  s
}

// #1915 builder-return leak guard: the standard builder shape — an ANNOTATED
// fresh binding (`let out: Array[Int] = []`; the ascription parses to an
// identity application `((__asc: T) -> __asc)(e)`) returned by name — must not
// land the function in the may-return-view set. Misclassified, every CALLER
// suppresses the scope-end drop of the OWNED result and leaks one array per
// call, scaling heap_used with N.
let build_arr = (n: Int) -> Array[Int] {
  let out: Array[Int] = [
  ]
  let mut j = 0
  while j < n {
    Array::push(out, j)
    j = j + 1
  }
  out
}

// #1915 mechanism 3 leak guard: same builder, returned through an if/else
// tail. The loop borrow-use keeps the binding's remaining > 1 at branch
// entry, so each exclusive branch used to budget its OWN dup — both emitted
// unconditionally at the binding site while only one branch executes, one
// leaked array per call. pe_merge_exclusive_branch_dups folds the branch
// budgets to a per-binding max.
let build_arr_if = (n: Int) -> Array[Int] {
  let out: Array[Int] = [
  ]
  let mut j = 0
  while j < n {
    Array::push(out, j)
    j = j + 1
  }
  if n >= 0 {
    out
  } else {
    out
  }
}

enum Tri {
  L(Int);
  N2(Tri, Tri);
  N3(Tri, Tri, Tri)
}

let sumtri = (t: Tri) -> Int {
  match t {
    L(v) => v,
    N2(a, b) => sumtri(a) + sumtri(b),
    N3(a, b, c) => sumtri(a) + sumtri(b) + sumtri(c)
  }
}

// ADR-0092 / #2389 reuse-token release guard. `widen0`'s N2 arm is a
// plan-guided wide-reuse arm whose same-size constructor sits in the branch
// this call never takes (d = 0); the other branch rebuilds at a DIFFERENT
// size, so the block claimed at staging is still armed at arm end and must
// be released there (mr_emit_token_release) -- or one 32-byte N2 leaks per
// iteration and heap_used scales with N. Both binds are consumed on both
// paths (held: one reference per consume plus a base reference released at
// arm end), so the payloads balance whichever branch runs. Deliberately NOT
// a shape that consumes a let-bound value in one branch only: the planner's
// branch merge keeps the minimum remaining count, and such a value leaks on
// the non-consuming path on the normal lane too (measured: two Leaf blocks,
// 48 B per iteration), which would swamp this guard.
let widen0 = (t: Tri, d: Int) -> Tri {
  match t {
    L(v) => L(v),
    N2(a, b) => if d > 0 {
      N2(a, b)
    } else {
      N3(a, b, L(0))
    },
    N3(a, b, c) => N3(a, b, c)
  }
}

// ADR-0092 / #2389 held-bind guard: `l` is borrow-read (sumt is
// borrow-classified) AND stored into the rebuilt Node -- consumed once with
// a further read, so the wide fusion holds it (one reference for the
// consume plus a base reference released at arm end); `r` is borrow-only.
// Each iteration must balance to zero net references or the children
// leak.
let hold = (t: Tree) -> Tree {
  match t {
    Leaf(v) => Leaf(v),
    Node(l, r) => {
      let s = sumt(l)
      Node(l, Leaf(s + sumt(r)))
    }
  }
}

// #2671 HOF ownership guards. Each Array higher-order lowering (map /
// filter / fold / any / all / find / reverse / concat) consumes the array it
// is handed and owns the callback reference, so on the RC lane it must
// release the shell exactly once -- emptied on the unique path (elements
// moved out), walked on the shared path (elements retained as they are
// handed over) -- and drop the callback after the loop. Before the fix no
// lowering released anything: one shell per call (plus the callback block
// for a capturing closure) leaked, scaling heap_used with N.
let incr_tree = (t: Tree) -> Tree {
  match t {
    Leaf(v) => Leaf(v + 1),
    Node(l, r) => {
      let l2 = incr_tree(l)
      let r2 = incr_tree(r)
      Node(l2, r2)
    }
  }
}

let is_leaf = (t: Tree) -> Bool {
  match t {
    Leaf(_) => true,
    Node(_, _) => false
  }
}

let is_node = (t: Tree) -> Bool {
  match t {
    Leaf(_) => false,
    Node(_, _) => true
  }
}

let main = () -> Int {
  let mut total = 0
  let mut i = 0
  while i < 20000 {
    let t = (i, i + 1)
    let mut c = 0
    let bump = () -> {
      c = c + 1
    }
    bump()
    let tr = Node(Leaf(i), Leaf(i + 1))
    // #704 projection-ownership reclamation guard: `Array::get(b.items, _)`
    // passes a heap field projection as the BORROWED arg0 of a builtin, which
    // must NOT be rc_dup'd at the call site (the builtin never drops it) — else
    // one reference leaks per iteration and heap scales with N. The struct `b`
    // and its array reclaim each iteration only when that dup is suppressed.
    let b = Box::{
      items: [
        i,
        i + 1,
        i + 2
      ]
    }
    let first = Array::get(b.items, 0)
    // #703 unused-matched-field guard (drives `ignore_children`, which binds but
    // never references the heap children — see its definition above).
    let ignored = ignore_children(Node(Leaf(i), Leaf(i + 1)))
    // #703 follow-up: inline temporary match scrutinee. The matched-on `Node`
    // value is constructed in scrutinee position with no binding to drop it; the
    // RC scrutinee-lift must reclaim it each iteration (else heap scales with N).
    let inlined = match Node(Leaf(i), Leaf(i + 1)) {
      Leaf(_) => 0,
      Node(l, r) => sumt(l) + sumt(r)
    }
    // #703-2 borrow-only matched-field guard: `xs` is bound and referenced, but
    // only as the borrowed arg0 of `Array::length` — never consumed. Its #702
    // dup must be suppressed (md_consumes) or the array leaks each iteration.
    let blen = match Some([
      i,
      i + 1
    ]) {
      Some(xs) => Array::length(xs),
      None => 0
    }
    // #706 leak guard (see consume_in_loop above): a fresh array literal
    // consumed 3x inside consume_in_loop's own while loop, unreachable after
    // this call returns.
    let looped = consume_in_loop([
      i,
      i + 1,
      i + 2
    ])
    // #1915 leak guard (see build_arr above): the returned builder array is
    // owned by `built` and must be reclaimed at scope end each iteration.
    let built = build_arr(3)
    // #1915 mechanism 3 (see build_arr_if above): the if/else-tail builder's
    // result must also be reclaimed each iteration.
    let built_if = build_arr_if(3)
    // ADR-0092 / #2389 (see widen0 / hold above): the branch that never
    // consumes the token, and a held bind, each reclaimed every iteration.
    // sumtri(w) = 2i + 1, sumt(h) = 3i + 1.
    let w = widen0(N2(L(i), L(i + 1)), 0)
    let h = hold(Node(Leaf(i), Leaf(i + 1)))
    // #2671 (see incr_tree / is_leaf / is_node above). `ta` stays live
    // across every call, so each lowering takes the SHARED path; the
    // map-of-map and the literal-fed filter take the UNIQUE path (elements
    // moved out, the rejected Node discarded, the emptied shell released).
    // Per iteration: sumt(ta1) = 2i+1, sumt(hm21) = 2i+5, |hf| = |hf2| = 1,
    // hfold = 3i+1, hfind = 2i+1, sumt(hrev0) = 2i+1, |hcat| = 4,
    // hany + hall = 1 -- 11i + 16 in all. Accumulated in a second statement:
    // a `+` chain of 24 or more operands under a binding is compiled in
    // exponential time by desugar_trait_dict's operand-type inference and
    // runs the compiler out of memory (see the `dtd_binop_builtin_operand_type`
    // note there).
    let ta: Array[Tree] = [
      Leaf(i),
      Node(Leaf(i), Leaf(i + 1))
    ]
    let hm = Array::map(ta, incr_tree)
    let hm2 = Array::map(hm, incr_tree)
    let hf = Array::filter(ta, is_leaf)
    let hf2 = Array::filter([
      Leaf(i),
      Node(Leaf(i), Leaf(i + 1))
    ], is_leaf)
    let hfold = Array::fold(ta, 0, (acc: Int, t: Tree) -> Int {
      acc + sumt(t)
    })
    let hfind = match Array::find(ta, is_node) {
      Some(t) => sumt(t),
      None => 0
    }
    let hrev = Array::reverse(ta)
    let hcat = Array::concat(ta, hrev)
    let hany = if Array::any(ta, is_node) {
      1
    } else {
      0
    }
    let hall = if Array::all(ta, is_node) {
      1
    } else {
      0
    }
    let ta1 = Array::get(ta, 1)
    let hm21 = Array::get(hm2, 1)
    let hrev0 = Array::get(hrev, 0)
    // #2682 guard: an OWNED temporary handed straight to a BORROWED position
    // (`Array::length` borrows its argument) was dropped by nobody -- 84 B
    // per call for the three-element array, the map result and its
    // elements with it. The lowering parks the temporary and releases it
    // after the call. 3 + 2 per iteration.
    let tlen = Array::length(build_arr(3)) + Array::length(Array::map(ta, incr_tree))
    // #2683 guard: a MapBuilder (a class-9 handle over a class-0 storage
    // leaf), the Map it freezes and every Map that Map::set / Map::delete /
    // Map::new produce (class 6, with a class-0 side index once a map holds
    // 8 entries or more) are RC blocks. Each used to be a raw bump
    // allocation -- 144 B per builder, 8 + 16 B per map entry, the index
    // on top -- scaling heap_used with N. The keys are string literals
    // (data-segment fat pointers, no allocation). 5i + 21 per iteration.
    let mb = MapBuilder::new()
    MapBuilder::set(mb, "a", i)
    MapBuilder::set(mb, "b", i + 1)
    MapBuilder::set(mb, "a", i + 2)
    let fm = MapBuilder::freeze(mb)
    let m1 = Map::set(Map::new(), "x", i)
    let m2 = Map::set(m1, "y", i + 1)
    let m3 = Map::delete(m2, "x")
    let mv = Map::values(m2)
    let mk = Map::keys(fm)
    let big = MapBuilder::new()
    MapBuilder::set(big, "k0", i)
    MapBuilder::set(big, "k1", i + 1)
    MapBuilder::set(big, "k2", i + 2)
    MapBuilder::set(big, "k3", i + 3)
    MapBuilder::set(big, "k4", i + 4)
    MapBuilder::set(big, "k5", i + 5)
    MapBuilder::set(big, "k6", i + 6)
    MapBuilder::set(big, "k7", i + 7)
    MapBuilder::set(big, "k8", i + 8)
    let bm = MapBuilder::freeze(big)
    let bm2 = Map::set(bm, "k9", i + 9)
    let msum = Map::get(fm, "a") + Map::get(fm, "b") + Map::get(m3, "y") + Array::length(mv) + Array::length(mk) + Map::get(bm, "k4") + Map::get(bm2, "k9")
    // ADR-0092 for maps: an accumulator `x = f(.., x, ..)` MOVES its current
    // value into the call (the planner used to retain it and the assignment
    // lowering drops nothing for a self-referential right-hand side, so
    // every intermediate value leaked -- 864 B per iteration for nine sets
    // on a map, 420 B for four Array::concat on an array). The map one also
    // takes Map::set's in-place path. 2i + 23 per iteration.
    let mut acc = Map::new()
    let mut aj = 0
    while aj < 10 {
      acc = Map::set(acc, "a", i + aj)
      acc = Map::set(acc, "b", aj)
      aj = aj + 1
    }
    let mut xs_acc: Array[Int] = [
    ]
    xs_acc = Array::concat(xs_acc, [
      i
    ])
    xs_acc = Array::concat(xs_acc, [
      i + 1
    ])
    let asum = Map::get(acc, "a") + Map::get(acc, "b") + Map::size(acc) + Array::length(xs_acc) + Array::get(xs_acc, 1)
    total = total + t.0 + t.1 + c + sumt(tr) + first + ignored + inlined + blen + looped + Array::length(built) + Array::length(built_if) + sumtri(w) + sumt(h)
    total = total + sumt(ta1) + sumt(hm21) + Array::length(hf) + Array::length(hf2) + hfold + hfind + sumt(hrev0) + Array::length(hcat) + hany + hall + tlen + msum + asum
    i = i + 1
  }
  total
}
