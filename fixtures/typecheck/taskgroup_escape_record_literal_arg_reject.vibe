// #3488: a record literal built over the outer cell, passed straight to a
// helper that stores the handle through its field.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(w = Wrap::{ cell: c }, x = TaskGroup::spawn(n, f = () -> { 41 }))
    1
  })
  println("r=\{r}")
}
