// #3623: `h.f` performs `Box` at `Option[Int]` -- its field's row
// `Box[F[Int]]` at `Holder[Option]` -- so passing it where `Box[Array[Int]]`
// is handled is refused: that handler would read the `Option[Int]` as an
// `Array[Int]`. The accepted shapes are in
// fixtures/struct_field_row_kinded_formal_test.vibe.
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[F[_]] {
  f: () -> Int with Box[F[Int]]
}

fn drive_a(f: () -> Int with Box[Array[Int]]) -> Int {
  handle {
    f()
  } with {
    Box::Put(_) => resume(())
  }
}

fn main() -> Int {
  let h = Holder[Option]::{ f: () -> {
    perform Box::Put(Some(1))
    5
  } }
  drive_a(h.f)
}
