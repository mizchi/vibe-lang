// A struct's own type parameter written in a field's effect row. Only a
// single lowercase letter is a row variable, so `E` is read as an effect named
// `E`. It was not refused at the declaration: the program was refused at
// `main` ("entry point 'main' cannot discharge { E }", with a `handle` as the
// suggested edit), far from the cause. The refusal names the edit.
struct Holder[E] {
  run: () -> Int with E
}

fn quiet() -> Int {
  1
}

fn main() -> Unit allows Console {
  let h = Holder::{ run: quiet }
  println("\{(h.run)()}")
}
