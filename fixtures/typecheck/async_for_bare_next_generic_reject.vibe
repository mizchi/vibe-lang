// #3641: the same hole through a GENERIC receiver. `Cell::next` is bound as a
// quantified function, and the iterand comes in through a parameter.
struct Cell[T] {
  left: Int;
  value: T
}

fn Cell::next[T](c: Cell[T]) -> Future[Option[(T, Cell[T])]] {
  if c.left <= 0 {
    Future::ready(None)
  } else {
    Future::ready(Some((c.value, Cell::{ left: c.left - 1, value: c.value })))
  }
}

fn total(c: Cell[Int]) -> Int {
  let mut acc = 0
  for x in c {
    acc = acc + x
  }
  acc
}

fn main allows Console + Async {
  println("total = \{total(Cell::{ left: 3, value: 4 })}")
}
