// #3360 (Codex on #3473): `CellOf` is private and not imported, and it
// keeps the handle in its module's array. A bare call whose first argument
// has an imported type was retried as a method of that type and typed
// without a body, so this compiled and ran `CellOf`. Since #3476 (#3480) the
// retry needs a declared receiver, so the call is an unknown name and never
// reaches the retention check.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let c: Cell = CellOf(h)
    c.n
  })
  println("r=\{r}")
}
