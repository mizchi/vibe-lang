// #3360 (Codex on #3473): `CellOf` is private and not imported, but a bare
// call whose first argument has an imported type is retried as a method of
// that type and typed without a body, so this compiles and runs `CellOf`,
// which keeps the handle in its module's array. A callee nothing binds is
// opaque to the retention check.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let c: Cell = CellOf(h)
    c.n
  })
  println("r=\{r}")
}
