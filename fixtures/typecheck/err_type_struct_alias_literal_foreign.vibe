// #3837: a struct literal does not follow an alias another module declares
// and this one imports under its own name: lowering cannot see the struct it
// names, so the literal would be laid out by its field set alone.
import ../_struct_alias_literal_reexport_dep.vibe {
  R
}

fn main() -> Unit {
  let r = R::{ x: 1, y: "a", z: false }
  ()
}
