// #4050 control: the joined RESULT of a task holds no handle, so it may be
// written into an outer element through a loop variable.
// `main` answers 10 * the block's value + the outer array's length.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Int allows Exception {
  let outer: Array[Int] = []
  let boxes = [outer]
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, f = () -> { 41 })
    let got = TaskHandle::join(h)
    for a in boxes {
      Array::push(a, value = got)
    }
    1
  })
  r * 10 + Array::length(outer)
}
