// #3255: a program's own function spelled like a library wrapper is judged by
// its body, so one that DOES store its argument into the receiver is still
// refused inside a region -- now by its body rather than by its spelling.
fn MutMap::set(_ m: Array[MutList[Int]], k: Int, v: MutList[Int]) -> Unit {
  let _ = k
  Array::push(m, value = v)
}

fn shadow() -> Int {
  let outer: Array[MutList[Int]] = []
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    MutMap::set(outer, k = 1, v = cell)
    1
  }
}
