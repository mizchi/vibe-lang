//# #3549: an unannotated `let xs = []` filled with values of a struct whose
//# field holds a function. The pushes give the binding its element type, so
//# the checker sees the function behind the `Array` element and the field, and
//# refuses the `==` with the edit. Before #3549 this shape compiled through
//# `vibe check` and was refused only by the lowering's untyped-empty arm
//# (#2475), whose allow-list rejects a function field; the comparator could
//# only have answered by reference.
struct F {
  f: () -> Int
}

fn mk1() -> () -> Int {
  () -> {
    1
  }
}

export fn _start() -> Int {
  let left = []
  Array::push(left, F::{
    f: mk1()
  })
  let right = []
  Array::push(right, F::{
    f: mk1()
  })
  if left == right {
    1
  } else {
    0
  }
}
