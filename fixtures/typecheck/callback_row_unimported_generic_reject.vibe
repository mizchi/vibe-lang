// #3351: a generic callee's callback row names `Wrap[T]`, and this module
// does not import `Wrap`. The payload is checked against `Wrap[String]`.
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, run_wrap
}

fn producer() -> Int with Box {
  run_wrap(x = "abc", f = () -> {
    perform Box::Put(41)
  }, len = (s) -> String::length(s))
}
