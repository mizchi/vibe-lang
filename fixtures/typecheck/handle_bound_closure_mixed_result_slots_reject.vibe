// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The function's result declares `Ask` for its FIRST slot only
// (#1451 gives a returned closure that row), so the second, row-less slot
// takes a closure that keeps this handle's evidence: `g()` answered `6` from
// the dead handler. handle_bound_closure_rowed_tuple_slots_reject.vibe is the
// same result with both slots declaring the row.
effect Ask {
  Get() -> Int
}

fn ask() -> Int with Ask {
  perform Ask::Get()
}

fn pair() -> (() -> Int with Ask, () -> Int) {
  handle {
    (() -> ask(), () -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
}

fn main() -> Unit allows Console {
  let (_, g) = pair()
  println("g=\{g()}")
}
