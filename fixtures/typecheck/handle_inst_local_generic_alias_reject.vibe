// #3027 (Codex on #3047): a generic lambda reached through an alias
// (`let get = get0`) is generalized afresh, so the alias's scheme had no
// declaration to read its row formal through; `State[S]` stayed an open
// spelling and the `State[Int]` handler below was accepted for a call that
// requires `State[String]`. The alias now carries its source's declaration.
effect State[S] {
  Get() -> S
}

fn main() -> Int {
  let get0 = [S](x: S) -> Int with State[S] {
    1
  }
  let get = get0
  handle {
    get("abc")
  } with { State::Get() => resume(7) }
}
