// #3102 review: a top-level formal spelled `Array` passed to a generic callee
// under `with State[Array]` names the same rigid formal on both sides.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[Array](x: Array) -> Bool with State[Array] {
  get(x) > 0
}
