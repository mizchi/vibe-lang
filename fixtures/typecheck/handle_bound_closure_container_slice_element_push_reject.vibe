// #4064, Codex review on #4081: `Array::slice` builds fresh storage, but the
// elements it holds are the source's, so a push into an element read out of
// the slice is a push into the array the source holds there.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let inner: Array[() -> Int] = []
    let rows = [inner]
    let part = Array::slice(rows, start = 0, end = 1)
    Array::push(Array::get(part, at = 0), value = g)
    let _ = keep_arr(xs = inner)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()} \{plain()}")
}
