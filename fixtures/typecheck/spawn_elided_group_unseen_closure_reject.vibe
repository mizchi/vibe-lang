// #3640: a helper that takes its closure in a position other than the last is
// not spawn-shaped, so its callers are not checked and the closure it spawns
// cannot be trusted. With the group written `TaskGroup` the spawn inside used
// to skip the check, and the closure ran unexamined.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup, f: () -> Int, k: Int) -> TaskHandle[Int] {
  TaskGroup::spawn(g, f)
}

fn main() -> Unit allows Console + Exception {
  let w = TaskGroup::run((g) -> {
    let h = start(g, () -> 1, 2)
    TaskHandle::join(h)
  })
  println("w = \{w}")
}
