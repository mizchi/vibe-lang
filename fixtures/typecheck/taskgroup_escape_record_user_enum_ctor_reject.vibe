// #3488 (Codex on #3492): a user enum constructor holds its payload, so a
// `match` handing back that payload is the outer cell.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

enum Holder {
  Held(Cell)
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: match Held(c) {
      Held(x) => x
    } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
