fn make() -> Array[Array[MutList[Int]]] {
  let local: Array[Array[MutList[Int]]] = [[]]
  Array::set(local, at = 0, value = [])
  local
}

fn main() -> Unit allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let holder: Array[Array[Array[MutList[Int]]]] = [[[]]]
    Array::set(holder, at = 0, value = make())
    Array::push(Array::get(Array::get(holder, at = 0), at = 0), value = c)
    1
  }
  let _ = v
  ()
}
