// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. In a struct field: the struct's type does not show the closure, so the
// field types are read.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

struct Box {
  f: () -> Int
}

fn main() -> Unit allows Console {
  let b = handle {
    Box::{ f: () -> perform Ask::Get() + 1 }
  } with { Ask::Get() => resume(5) }
  let g = b.f
  println("g=\{g()}")
}
