// #4051: a closure that performs what a `handle` answers must not outlive
// that handle, also when it reaches a function that keeps it through a
// destructuring `let` of a tuple. The binder used to be bound as a plain
// value, so the call was not a keep route: `vibe check` was clean, and
// calling the kept closure after the handle trapped
// (`indirect call type mismatch`). `keep(f = g)` and `let x = g` were refused
// already; fixtures/handle_bound_closure_binder_test.vibe holds the binder
// shapes that stay accepted.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn main() -> Unit allows Console {
  handle {
    let g = () -> perform Ask::Get() + 1
    let (x, _) = (g, 1)
    let _ = keep(f = x)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()}")
}
