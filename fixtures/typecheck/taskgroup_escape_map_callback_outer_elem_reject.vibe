// #4050: an element callback's parameter is an element of the receiver. When
// the receiver is a container declared outside the region, writing a region
// value into the parameter keeps it in that container after the region ends,
// as `Array::get(boxes, at = 0)` is refused for. The callback re-check bound
// the parameter as a fresh binding of the region body, so this compiled.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let boxes = [outer]
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, f = () -> { 41 })
    let _ = Array::map(boxes, f = (a) -> {
      Array::push(a, value = h)
      0
    })
    1
  })
  println("r=\{r} kept=\{Array::length(outer) > 0}")
}
