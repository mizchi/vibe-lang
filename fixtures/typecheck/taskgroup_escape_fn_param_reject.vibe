// #3343: a function VALUE with no body the checker can see -- here a
// parameter of function type -- handed the group's token. Nothing about what
// it keeps is known, so the call is refused rather than trusted. This
// compiled, and the caller's closure kept the handle past its group.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn run_with(cb: (TaskHandle[Int]) -> Unit) -> Int with Exception {
  TaskGroup::run((n) -> {
    cb(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = run_with((h) -> {
    c.v = Some(h)
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
