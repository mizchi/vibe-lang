// #3888 (Codex on #3902): a value binder that spells an importer alias of a
// builtin type shadows it, so `F::ceil` there names nothing. Lowering drops
// the alias in that scope; reading the call as `Float64::ceil` anyway let it
// reach code generation unresolved.
import ../_builtin_type_alias_plain_facade.vibe {
  Float64 as F
}

fn f(F: Int) -> Float64 {
  F::ceil(1.5)
}

fn main() -> Unit {
  let x = f(F = 1)
  ()
}
