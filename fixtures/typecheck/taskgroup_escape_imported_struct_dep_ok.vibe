// #3360 (Codex on #3467): helpers whose parameter is a struct holding a task
// handle, and an exported alias of a helper that keeps its argument.
import @vibe/concurrent { TaskHandle }
import ./taskgroup_escape_imported_helper_dep_ok.vibe { put }

export struct Slot {
  h: TaskHandle[Int]
}

export struct Shelf {
  mut held: Option[Slot]
}

export fn shelve(s: Shelf, x: Slot) -> Unit {
  s.held = Some(x)
}

export let put_alias = put
