// #4121: one generic body that both reads and writes through its map-key
// parameter is restricted by the write: instantiating it at `Char` is refused
// even though its `has_key` alone would dispatch at run time.
fn upsert[K](m: Map[K, Int], k: K) -> Map[K, Int] {
  if Map::has_key(m, key = k) {
    m
  } else {
    Map::set(m, key = k, value = 0)
  }
}

fn main {
  let m: Map[Char, Int] = Map::set(Map::new(), key = 'a', value = 1)
  let _ = upsert(m = m, k = 'b')
  ()
}
