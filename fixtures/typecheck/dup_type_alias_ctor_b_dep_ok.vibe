// #3036 (Codex on #3076): half of dup_type_alias_ctor_alpha_ok.vibe -- a bare
// parameterized alias passed to a constructor slot, its binder spelled `Y`.
export struct Holder[F[_]] {
  value: F[Int]
}

type Inner[Y] = Array[Y]

export struct Wrap {
  h: Holder[Inner]
}

export fn take_b(w: Wrap) -> Int {
  1
}
