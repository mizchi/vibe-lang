//# #2807: the refusal follows the receiver's TYPE, not the shape of the
//# expression that produced it. None of these receivers is a plain name, so a
//# fix keyed on `let`-bound identifiers would let all four through.
//#
//# Measured before the fix, on a compiler built from 4905ca8: this file
//# compiled clean and answered `28` -- four reads of `Pouch`/`Sack[Int]`
//# through `Crate`'s offset, 7 apiece.
struct Crate {
  payload: Int
}

enum Pouch {
  Slack;
  Packed(Int)
}

enum Sack[T] {
  Void;
  Held(T)
}

fn make() -> Pouch {
  Packed(7)
}

fn make_generic() -> Sack[Int] {
  Held(7)
}

export fn main() -> Int {
  let from_call = make().payload
  let from_element = Array::get([Packed(7)], 0).payload
  let from_generic_call = make_generic().payload
  let from_generic_element = Array::get([Held(7)], 0).payload
  from_call + from_element + from_generic_call + from_generic_element
}
