//# #3006: a BUILTIN call on a bare type formal binds the formal, like a user
//# function's parameter does. It used to be tolerated without binding, so the
//# scheme stayed fully generic and `g(41)` read an Int as a string (`82`).
fn g[T](x: T) -> Int {
  String::length(x)
}

export fn main() -> Int {
  g(41)
}
