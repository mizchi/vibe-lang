// #3758: importing a type does not shadow its builtins. Before, the
// published `Float64::floor` marker was bound under its own name, so the
// call had no type and `let a: String = Float64::floor(1.5)` checked clean.
import @vibe/builtin {
  Float64
}

fn main() -> Unit {
  let a: String = Float64::floor(1.5)
  ()
}
