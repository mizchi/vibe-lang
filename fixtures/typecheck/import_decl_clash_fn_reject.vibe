// #3549: a top-level `fn` reusing the name of a value the file imports. Every
// call took the local declaration and the import was dead, with no
// diagnostic. Refused at the declaration.
import ./import_decl_clash_dep_ok.vibe { helper, other }

fn helper(n: Int) -> Int {
  n + 100
}

fn use_both() -> Int {
  helper(other(1))
}
