// #3036 (Codex on #3076): `Fail` is dup_type_effectset_mid_dep_ok's
// `{ Exception[Err] }` over dup_type_a_dep_ok's `Err { code: Int }`, reached
// only through the effect-set member; `Err` here is dup_type_b_dep_ok's
// `{ name: String }`. `Fail`'s handlers would read one layout through the
// other.
import ./dup_type_effectset_mid_dep_ok.vibe { Fail }
import ./dup_type_b_dep_ok.vibe { Err }

fn boom() -> Int with Fail {
  throw(Err::{ name: "x" })
}
