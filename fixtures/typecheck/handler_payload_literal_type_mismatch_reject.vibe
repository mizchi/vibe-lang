// #3371 (Codex on #3384): a literal whose type is not the operation's
// declared parameter type used to be answered with `E::P(v) => if v == 1`,
// an edit that only trades the payload refusal for a String/Int mismatch.
// The message now leads with that mismatch and offers no `==` to copy.
effect E {
  P(String) -> Int
}

fn run() -> Int {
  handle {
    perform E::P("one")
  } with {
    E::P(1) => resume(1)
  }
}
