// #3538: an impl method with a parameter the trait does not declare trapped at
// run time when called through the trait.
trait Name { name(Self) -> Int }

struct P { x: Int }

impl Name for P {
  name(self, k: Int) -> Int { k + self.x }
}

fn main allows Console {
  println("\{Name::name(P::{ x: 1 })}")
}
