// #3540: a closure that throws what a `handle` catches must not outlive
// that handle. The closure-returning function's result is bound by `let`
// and returned by name. `g()` trapped after `vibe check` was clean.
fn mk(fail: Bool) -> (() -> Int) with Exception[Int] {
  if fail {
    throw(1)
  } else {
    ()
  }
  () -> throw(7)
}

fn main() -> Unit allows Console {
  let g = handle {
    let h = mk(false)
    h
  } with { Exception[Int]::Throw(n) => () -> n }
  println("g=\{g()}")
}
