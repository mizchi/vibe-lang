// #3086: `Err` is a constructor of `Res`, and every `Err` in an expression
// resolves to it in the checker. Before the refusal, a parameter named `Err` was
// accepted, the checker typed `Err(1) + 1` through the binding, and codegen
// built the VARIANT instead: the sum printed a heap address (`257` on linear,
// `210` on gc).
enum Res {
  Ok(Int);
  Err(String)
}

fn apply(Err: (Int) -> Int) -> Int {
  Err(1) + 1
}

fn main() -> Unit {
  let _ = apply((x: Int) -> x + 1)
}
