// #3102 review: a callback parameter declared by a nested generic lambda
// itself. Its `State[T]` names that lambda's own rigid `T`, which no binder
// between the annotation and the call rebinds, so `with State[String]` does
// not cover it.
effect State[S] {
  Get() -> S
}

fn outer() -> Int {
  let g = [T](x: T, f: () -> Int with State[T]) -> Int with State[String] {
    f()
  }
  0
}
