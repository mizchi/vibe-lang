// #3518 control: keeping the effect-stripped retry's substitution only binds
// what the retry unified. A Send result through the same row-carrying
// parameter, and a plain `TaskGroup::spawn` task, still check clean.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn take[T: Send, e](f: () -> T with Exception + e) -> T with Exception + e {
  f()
}

fn main() -> Int allows Exception {
  let a: Int = take(() -> 40)
  let b = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> {
      (1, "two")
    })
    let (one, _) = TaskHandle::join(h)
    one
  })
  a + b + 1
}
