// #3343 (Codex on #3359): a body stored in a struct field. Its code was
// checked outside the group's region; this compiled and the handle was joined
// after its group closed. The call is refused with the edit.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

struct Holder[F] {
  body: F
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let holder = Holder::{
    body: (n) -> {
      c.v = Some(TaskGroup::spawn(n, () -> { 41 }))
      1
    }
  }
  let r = TaskGroup::run(holder.body)
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
