// #3562: `impl Eq for Box[T]` writes one `equals` and the later impl of
// `Key`, a subtrait of `Eq`, writes another; callers through `[U: Eq]` and
// `[T: Key]` ran different ones.
trait Key: Eq {
  tag(Self) -> Int
}

struct Box[T] {
  v: T
}

impl [T] Eq for Box[T] {
  equals(self, o: Box[T]) -> Bool {
    true
  }
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

fn outer[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn answers() -> Bool {
  let p: Box[Int] = Box::{ v: 1 }
  outer(p, p)
}
