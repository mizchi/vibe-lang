// #3408 (Codex on #3409): `mid` calls `int` (fixed at `Int`) and `late`,
// which is declared after it and resolves to `Box[String]` through `str` only
// in a later round. `mid` must require both, so an `Int`-only caller is
// refused. When the bare label was replaced in place, `mid` froze at
// `Box[Int]`, this checked clean, and the `Int` handler received the string.
effect Box[T] {
  Put(T) -> Int
}
fn int() -> Int with Box[Int] {
  perform Box::Put(1)
}
fn mid() -> Int with Box {
  int() + late()
}
fn late() -> Int with Box {
  str()
}
fn str() -> Int with Box {
  perform Box::Put("abc")
}
fn caller() -> Int with Box[Int] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(n) => resume(n + 1) }
}
