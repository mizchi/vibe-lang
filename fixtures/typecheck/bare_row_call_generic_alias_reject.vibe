// #3408 (Codex on #3409): a generic callee called through a local alias is
// instantiated under the alias's own spelling at the call. Read under the
// source's name it found no bindings and stayed `Box[T]`, which a
// `Box[String]` caller covered by base name, and the handler's
// `String::length` of the `Int` answered 24690.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn mid() -> Int with Box {
  let h = mk
  h(12345)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
