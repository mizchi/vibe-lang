// #3417: `f = g` on a `let mut f = h` compares the payloads the two rows
// write. Row labels unify by base name, so `Box[Int]` replaced `Box[String]`
// and `f()` sent an `Int` to the `Box[String]` the caller declares.
effect Box[T] {
  Put(T) -> Int
}

fn g() -> Int with Box[Int] {
  perform Box::Put(12345)
}

fn h() -> Int with Box[String] {
  perform Box::Put("a")
}

fn run() -> Int with Box[String] {
  let mut f = h
  f = g
  f()
}
