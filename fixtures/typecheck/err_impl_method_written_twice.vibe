// #3962: one impl block writes a method twice. No overlap check sees this,
// so the duplicate is reported, naming the method and the impl as written
// and located at the impl's header.

trait Value[A] {
  value(Self) -> A
}

struct Note {
  n: Int
}

impl Value[Int] for Note {
  value(self) -> Int { self.n }
  value(self) -> Int { 1 }
}
