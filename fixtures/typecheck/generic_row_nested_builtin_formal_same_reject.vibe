// #3095: the requirement is the BUILTIN `Int`, spelled like the lambda's
// formal `Int`, which is what its `with State[Int]` names. Equal spellings,
// different types.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn outer() -> Int {
  let f = [Int](v: Int) -> Bool with State[Int] {
    get(5) > 0
  }
  0
}
