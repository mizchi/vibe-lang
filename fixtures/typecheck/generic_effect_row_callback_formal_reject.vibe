// #3311: a callback row naming the callee's formal (`Box[T]`) takes the type
// this call gives `T`. The argument to the lambda's left fixes it at `String`,
// so the perform is refused, at the perform. The row is the callee's: `T` is
// not read as a formal of the caller.
effect Box[T] {
  Put(T) -> Int
}

fn run2[T: Eq](x: T, f: () -> Int with Box[T]) -> Int {
  handle {
    f()
  } with {
    Box::Put(v) => resume(if v == x {
      1
    } else {
      0
    })
  }
}

fn producer[T](y: T) -> Int with Box {
  run2("s", () -> {
    perform Box::Put(1)
  })
}
