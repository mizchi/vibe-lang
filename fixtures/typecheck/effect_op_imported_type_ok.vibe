// #4018: an imported struct and an imported alias are declared types in an
// effect operation's signature. (`--single-file` does not resolve imports,
// so there they are unknown -- as they are in a struct field.)
import ./_effect_op_imported_type_dep.vibe {
  Remote, RemoteList
}

effect Fetch {
  One(Int) -> Remote;
  All(RemoteList) -> Option[Remote]
}

fn first() -> Int with Fetch {
  let r = perform Fetch::One(1)
  r.n
}
