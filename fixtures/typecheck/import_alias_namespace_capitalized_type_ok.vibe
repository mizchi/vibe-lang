//# Controls for import_alias_namespace_capitalized_fn_reject: a TYPE under a
//# builtin namespace's name is legal, kind-less or not, and the capitalized
//# function under an ordinary name is too. `Array::length` still reaches the
//# builtin.
import ./import_alias_namespace_value_dep_ok.vibe { Record as Future, struct Record as Profiler, MakeTag as Tagger }

fn main() -> Int {
  Tagger(1) + Array::length([1, 2, 3])
}
