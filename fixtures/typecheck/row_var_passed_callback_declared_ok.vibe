// #3561: the accepted counterpart -- `wrap` declares the row it hands on, and
// its caller holds `Console`.
fn apply(f: () -> Int with e) -> Int with e {
  f()
}

fn wrap(f: () -> Int with e) -> Int with e {
  apply(f)
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn loud() -> Int with Console {
  wrap(noisy)
}
