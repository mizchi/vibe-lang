// #3962: an impl method and a top-level `fn Note::size` of the same name.
// The report names the impl and the function, and is located at the impl's
// header.

trait Size {
  size(Self) -> Int
}

struct Note {
  n: Int
}

fn Note::size(self: Note) -> Int { 1 }

impl Size for Note {
  size(self) -> Int { self.n }
}
