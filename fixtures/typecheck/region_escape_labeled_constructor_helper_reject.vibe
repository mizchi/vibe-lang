// ADR-0120: a labeled argument hid what it passes from the region-tail check.
// `pack(first = slot, second = 0)` returns a wrapper whose callback captured
// the region's list; read at the label node, the argument looked region-free
// and the escape compiled, while the unlabeled `pack(slot, 0)` is refused.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[A, B] {
  Pair(first, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(slot, _) = escaped
  Array::length(slot.callback())
}
