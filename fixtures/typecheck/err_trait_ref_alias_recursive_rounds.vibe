// Codex on #3995: a recursive alias beside many others. Building the
// canonical-key definitions resolves aliases in one round per alias, so
// `type A[T] = (A[T], A[T])` doubled every round and exhausted memory before
// the checker's recursive-alias diagnostic, even for a key that names no
// alias. A recursive alias is left out of those definitions.
type A[T] = (A[T], A[T])

type B0 = Int

type B1 = Int

