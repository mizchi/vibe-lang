// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A closure-returning function is called through a local alias
// (`let m = mk`). This was refused only by the evidence lowering, with a
// message that named neither the closure nor the edit.
effect Ask {
  Get() -> Int
}

fn mk() -> (() -> Int) with Ask {
  () -> perform Ask::Get() + 1
}

fn main() -> Unit allows Console {
  let g = handle {
    let m = mk
    m()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
