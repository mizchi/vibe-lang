// #3138: a struct literal whose declared field type is NOMINAL (here a Map)
// is typed as that struct. It used to be typed as nothing at all -- the
// struct counted as "not ground", because every `CtNamed` did -- so every use
// of the value went unchecked and this binding compiled clean.

struct Holder {
  tbl: StringMap[Int]
}

fn go(m: StringMap[Int]) -> Int {
  let s: String = Holder::{ tbl: m }
  String::length(s)
}
