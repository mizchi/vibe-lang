// #3596: the same with the alias bound before the handle. A local `let`
// that names a declaration stands for it where the handle calls it.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let g = mk
  let b = handle {
    g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
