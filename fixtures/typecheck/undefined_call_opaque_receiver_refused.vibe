// #3476: `no_such_fn` exists nowhere. With an opaque imported type
// (`TaskHandle`) as its first argument, the call was retried as a method of
// that type, typed unknown, and compiled; it trapped at run time.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let s: String = no_such_fn(h)
    String::length(s)
  })
  println("r=\{r}")
}
