// #4091: a function of this module that returns an imported getter's result
// returns that module's storage too, so a push into its result is refused.

import ./region_escape_import_getter_dep_ok.vibe { get_sink, kept_len }

fn wrap() -> Array[MutList[Int]] {
  get_sink()
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    Array::push(wrap(), value = c)
    1
  }
  println("v=\{v} kept=\{kept_len() > 0}")
}
