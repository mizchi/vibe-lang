// #2969: a Unit-returning operation's arm resumes with `resume(())` like any
// other. `Array::push(..)` as the tail is a bare value, so the arm is refused
// rather than silently resuming.
effect Log {
  Emit(String) -> Unit
}

fn work() -> Int with Log {
  perform Log::Emit("a")
  42
}

fn main() -> Int {
  let sink: Array[String] = []
  handle { work() } with { Log::Emit(msg) => Array::push(sink, msg) }
}
