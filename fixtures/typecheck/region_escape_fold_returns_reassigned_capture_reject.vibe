// A fold callback that assigns an outer array to a captured `let mut` and
// returns it. The binding was declared inside the region, but its value is
// not. 55e4d06d6 printed `kept=true`.
let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    let spare: Array[MutList[Int]] = []
    let mut last = spare
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc, value = cell)
      last = get_sink()
      last
    })
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
