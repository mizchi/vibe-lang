// #3593: a method call (`fac.mk()`) resolves to `Factory::mk`, a
// declaration of this module, but the check followed only a callee called by
// name, so the throwing closure in `Box`'s field left the handle and `f()`
// threw with no handler around it.
struct Box {
  f: () -> Int
}

struct Factory {
  n: Int
}

fn Factory::mk(self: Factory) -> Box with Exception[Int] {
  Box::{ f: () -> throw(self.n) }
}

fn main() -> Unit allows Console {
  let fac = Factory::{ n: 7 }
  let b = handle {
    fac.mk()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
