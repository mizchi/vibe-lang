// #3588: `TaskHandle[Int]` leaves its region and row to the call. Against
// `TaskHandle[rg, e, String]` the two spellings had different argument
// counts, so the pair failed to unify and was tolerated like any other
// generic head: the handle came back as a `String` handle and `join` read
// the task's `7` as a `String`. The payloads are compared now.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn conv[rg, e](h: TaskHandle[Int]) -> TaskHandle[rg, e, String] {
  h
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> 7)
    TaskHandle::join(conv(h))
  })
  println("len=\{String::length(r)}")
}
