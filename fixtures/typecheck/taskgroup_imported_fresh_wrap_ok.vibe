// #3498 control: an imported helper called on a value made inside the group
// holds nothing from outside it.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_wrap_dep_ok.vibe { Cell, Wrap, wrap }

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let inner = Cell::{ v: None }
    put(wrap(inner), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
