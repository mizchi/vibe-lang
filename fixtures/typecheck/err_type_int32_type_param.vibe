//# #3730: `Int32` names the builtin sized integer in every type position,
//# and the post-check erasure rewrites each to `Int`. A type parameter of that
//# name would be captured by that reading -- `struct Box[Int32] { value: Int32 }`
//# would compare a `Box[Array[Int]]` field as an integer -- so the name is
//# refused for a type parameter.
struct Box[Int32] {
  value: Int32
}

fn main() -> Int {
  0
}
