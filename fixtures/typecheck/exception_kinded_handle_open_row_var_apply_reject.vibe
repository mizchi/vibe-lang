// #3540: the open row variable reached through a generic helper rather than
// a direct call. `apply(f)` instantiates `apply`'s `e` with `guarded`'s own
// `e`, so the kinded arm would catch whatever exception a caller puts there.
fn apply[e](f: () -> Int with e) -> Int with e {
  f()
}

fn guarded[e](f: () -> Int with e) -> Int with e {
  handle {
    apply(f) + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn main() -> Int {
  guarded(() -> 1)
}
