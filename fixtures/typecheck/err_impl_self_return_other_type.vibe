//# #3573: `Self` in an impl method's signature is the impl's target. It used
//# to be a wildcard there: `mk(self: Self) -> Self` in `impl W for P`
//# returned a `Q`, compiled clean, and the caller read the `Q` as a `P`.
trait W {
  mk(Self) -> Self
}

struct P {
  k: Int
}

struct Q {
  a: String
  k: Int
}

impl W for P {
  mk(self: Self) -> Self {
    Q::{ a: "x", k: 5 }
  }
}

export fn main() -> Int {
  let p: P = W::mk(P::{ k: 1 })
  p.k
}
