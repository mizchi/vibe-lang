// #3590 control: an application whose differing positions are open (a
// formal or a variable on one side) is still accepted, as is one whose
// concrete positions agree; a type alias is compared by its expansion; a
// struct row parameter is not an argument to compare; and `Map` / `Array` /
// `Option` arguments agree position by position.
struct Pair[A, B] {
  a: A
  b: B
}

type IntPair[X] = Pair[X, Int]

struct Holder[r] {
  run: () -> Int with r
}

fn keep[x](h: Pair[x, Int]) -> Pair[x, Int] {
  h
}

fn first[x, y](h: Pair[x, y]) -> x {
  h.a
}

fn via_alias[x](h: IntPair[x]) -> Pair[x, Int] {
  h
}

fn back[x](h: Pair[x, Int]) -> IntPair[x] {
  h
}

fn call[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn nested[x](h: Option[Pair[x, Array[Int]]]) -> Option[Pair[x, Array[Int]]] {
  h
}

fn table[k](m: Map[String, Pair[k, Int]]) -> Map[String, Pair[k, Int]] {
  m
}

fn main() -> Unit allows Console {
  let p = keep(Pair::{ a: "s", b: 7 })
  let q = via_alias(back(p))
  let n = call(Holder::{ run: () -> 3 })
  let o = match nested(Some(Pair::{ a: 1, b: [2, 3] })) {
    Some(v) => Array::length(v.b),
    None => 0
  }
  let m: Map[String, Pair[Int, Int]] = Map::new()
  let t = table(m)
  println("\{first(q)} \{q.b} \{n} \{o} \{Map::size(t)}")
}
