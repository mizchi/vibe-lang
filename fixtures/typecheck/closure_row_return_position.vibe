// #1451: a function RETURNING an effectful function value. The closure literal
// has no row of its own (its latent row is charged by the effect pass), so the
// implicit tail-expression return used to be checked with a raw `unify`, which
// treats a pure row against a declared one as a conflict. The explicit `return`
// form went through check_assignable and behaved differently.
effect Log {
  Emit(String) -> Unit
}

fn make() -> (String) -> Unit with Log::Emit {
  (s) -> {
    perform Log::Emit(s)
  }
}

fn make_returned() -> (String) -> Unit with Log::Emit {
  return (s) -> {
    perform Log::Emit(s)
  }
}

// Nested inside a container: the row mismatch sits under Array[_].
fn make_all() -> Array[(String) -> Unit with Log::Emit] {
  [
    (s) -> {
      perform Log::Emit(s)
    }
  ]
}
