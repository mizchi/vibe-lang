let sink: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  sink
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let first: Array[MutList[Int]] = get_sink()
    let init = first
    let _ = Array::fold([cell], init = init, f = (acc, c) -> {
      Array::push(acc, value = c)
      acc
    })
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
