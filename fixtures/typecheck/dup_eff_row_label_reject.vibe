// #3036: `level` requires dup_eff_b_dep_ok's `Gauge`, and `Gauge` is imported
// from dup_eff_a_dep_ok. Rows name an effect by its bare label, so a's handler
// would discharge b's requirement. The row label is a reference to b's
// declaration exactly as a field type would be.
import ./dup_eff_a_dep_ok.vibe { Gauge }
import ./dup_eff_b_dep_ok.vibe { level }

fn caller() -> String with Gauge {
  level()
}
