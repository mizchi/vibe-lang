// #3036 (Codex on #3076): an effect set is a set, so `{ Fs, Env }` and
// `{ Env, Fs }` under one name are one declaration: importing `Caps` from
// both dup_type_effectset_order_a_dep_ok and _b_dep_ok is accepted.
import ./dup_type_effectset_order_a_dep_ok.vibe { Caps, home_a }
import ./dup_type_effectset_order_b_dep_ok.vibe { Caps, home_b }

fn both() -> Bool with Caps {
  home_a() && home_b()
}
