// #3275 follow-up (Codex on #3315): a formal in scope stands for a kinded
// effect parameter only when its declared arity is the parameter's. A plain
// `T` in `with Read[T]` takes no arguments, so it cannot be applied to `Int`
// in `F[Int]`. On a lambda nested in a body, which the row-item check does not
// walk, a first cut of the kinded row arm bound the formal without asking and
// this checked clean.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

fn outer[T](x: T) -> Int {
  let f = () -> Int with Read[T] {
    0
  }
  0
}
