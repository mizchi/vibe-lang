// #3027 (Codex on #3047): a generic lambda declared INSIDE the handled body
// that shadows a top-level generic of the same name is read through its own
// declaration. The handle's environment still answers with the top-level
// `get`, whose `S` sits where the lambda has `T` -- read that way, `State[S]`
// was `State[Int]` and the `State[Int]` handler below was accepted for a call
// that requires `State[String]`.
effect State[S] {
  Get() -> S
}

fn get[S, T](x: T, y: S) -> Int {
  0
}

fn main() -> Int {
  handle {
    let get = [S, T](x: S, y: T) -> Int with State[S] {
      1
    }
    get("abc", 1)
  } with { State::Get() => resume(7) }
}
