// #3596: a conditional alias one of whose branches is a call's result. That
// branch may be any function -- here `mk` -- so the alias is taken to stand
// for one whose closure throws.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn mk_ok() -> Box with Exception[Int] {
  Box::{ f: () -> 1 }
}

fn pick(n: Int) -> () -> Box with Exception[Int] {
  if n > 0 {
    mk
  } else {
    mk_ok
  }
}

fn main() -> Unit allows Console {
  let n = 3
  let g = if n > 5 {
    mk_ok
  } else {
    pick(n)
  }
  let b = handle {
    g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
