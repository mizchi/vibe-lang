// #3022 review: a nominal generic-effect argument is compared too. The
// handler resumes with an `A`; the callee declares `State[B]` and would read
// the `A` as a `B`.
struct A { x: Int }
struct B { name: String }

effect State[S] {
  Get() -> S
}

fn get_b() -> String with State[B] {
  let b = perform State::Get()
  b.name
}

fn main() -> Unit allows Console {
  let s = handle {
    get_b()
  } with { State::Get() => resume(A::{ x: 1 }) }
  println(s)
}
