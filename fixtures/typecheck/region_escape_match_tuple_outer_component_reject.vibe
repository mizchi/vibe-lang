// #4050 (Codex on #4061): the binder of the outer component of a tuple scrutinee is an alias of that binding.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    match (inner, outer) {
      (_, a) => Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
