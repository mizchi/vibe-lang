// #3036: both `Outer`s read `{ inner: Inner }`, but each `Inner` is a
// different declaration. `consume_outer` would read a's `{ code: Int }`
// through b's `{ name: String }` layout. Neither `Outer` nor `Inner` is
// named here: only the two signatures bring them in.
import ./dup_type_nested_a_dep_ok.vibe { make_outer }
import ./dup_type_nested_b_dep_ok.vibe { consume_outer }

fn read() -> String {
  consume_outer(make_outer())
}
