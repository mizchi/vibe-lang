// A `handle` ending a `while` body throws its body's value away, so the
// `Map::set` ending that body updates nothing.
effect Ask {
  Get() -> Int
}

fn main() -> Int {
  let m: Map[String, Int] = Map::new()
  let mut i = 0
  while i < 2 {
    i = i + 1
    handle {
      Map::set(m, key = "a", value = i)
    } with {
      Ask::Get() => resume(i)
    }
  }
  Map::size(m)
}
