// #3360 (Codex on #3473): `MakeTag` returns `Tag`, so importing `Tag`
// brings it in without naming it, and its summary comes with it. It keeps
// the handle in its module's array.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { Tag }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let t: Tag = MakeTag(h)
    match t {
      TagA => 1,
      TagB => 2
    }
  })
  println("r=\{r}")
}
