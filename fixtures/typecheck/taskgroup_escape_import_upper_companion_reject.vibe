// #3360 (Codex on #3473): `MakeCell` returns `Cell`, so importing `Cell`
// brings it in without naming it. It keeps the handle in its module's array.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let c: Cell = MakeCell(h)
    c.n
  })
  println("r=\{r}")
}
