//# #3549: a generic `derive (Eq)` declaration satisfies `[T: Eq]` at every
//# instantiation, and at a function argument its comparator ends at the
//# function. Measured before the refusal, `eq2(b1, b1)` answered `true` and
//# `eq2(b1, b2)` `false` for two boxes of closures with the same body. The
//# bound is refused at the instantiation; `Box[Int]` still satisfies it.
struct Box[T] {
  v: T
} derive (Eq)

fn eq2[T: Eq](a: T, b: T) -> Bool {
  a == b
}

export fn main() -> Int {
  let b1: Box[(Int) -> Int] = Box::{ v: (x: Int) -> x + 1 }
  let b2: Box[(Int) -> Int] = Box::{ v: (x: Int) -> x + 1 }
  let n1: Box[Int] = Box::{ v: 1 }
  if eq2(b1, b2) && eq2(n1, n1) {
    1
  } else {
    0
  }
}
