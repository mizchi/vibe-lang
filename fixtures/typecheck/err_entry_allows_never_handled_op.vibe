// ADR-0124 decision 3 (#2656): an operation-level label is vacuous unless a
// handle in the entry has an arm naming that operation; a handle for another
// effect does not discharge it.
effect Db {
  Get(Int) -> Int
}

effect Log {
  Emit(Int) -> Unit
}

fn main allows Console + Db::Get {
  handle {
    perform Log::Emit(1)
  } with {
    Log::Emit(_) => resume(())
  }
  println("logged")
}
