// #2982: a throw whose kind resolves is reported with that kind, and the hint
// names the kinded row -- not the erased `Exception::Throw`, which it used to
// print whenever the declared row named no exception label yet.
enum IoErr {
  NotFound(String)
}

fn f() -> Int {
  throw(NotFound("x"))
}

fn main() -> Int {
  handle { f() } with { Exception::Throw(_) => 0 }
}
