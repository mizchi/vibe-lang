// #4050: a helper called inside the region is checked again with its
// argument's location; its loop variable over that argument is an outer element.
fn put_all(xs: Array[Array[MutList[Int]]], c: MutList[Int]) -> Unit {
  for a in xs {
    Array::push(a, value = c)
  }
  ()
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    put_all(xs = boxes, c = cell)
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
