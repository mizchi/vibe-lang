// #3589: a call through the field of a `Holder[q]` parameter runs the stored
// function, whose row is `q`, so `g1` must declare `q`. Before the fix it
// compiled, and a pure caller of `g1` ran the stored function's `Console`.
struct Holder[r] {
  run: () -> Int with r
}

fn g1[q](h: Holder[q]) -> Int {
  (h.run)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn main() -> Unit allows Console {
  println("\{g1(Holder::{ run: noisy })}")
}
