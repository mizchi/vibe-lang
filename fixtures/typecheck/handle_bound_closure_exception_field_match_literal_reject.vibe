// #3594: the same choice made by a `match`.
struct Box {
  f: () -> Int
}

let n = 1

let make: () -> Box with Exception[Int] = match n {
  0 => () -> Box::{ f: () -> 1 }
  _ => () -> Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let b = handle {
    make()
  } with { Exception[Int]::Throw(x) => Box::{ f: () -> x } }
  let f = b.f
  println("\{f()}")
}
