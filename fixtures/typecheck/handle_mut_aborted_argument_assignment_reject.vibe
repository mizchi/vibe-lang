effect Ask {
  Get() -> Int
}

fn consume2(x: Int, y: Int) -> Int {
  x + y
}

fn run() -> Int with Ask {
  let mut side = () -> Int {
    perform Ask::Get()
  }
  handle {
    consume2(throw("x"), {
      side = () -> Int {
        7
      }; 0
    })
  } with { Exception::Throw(_) => 0 }
  handle {
    side()
  } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle {
    run()
  } with { Ask::Get() => resume(1) }
}
