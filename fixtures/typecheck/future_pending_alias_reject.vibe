// #3163: `Future::pending` through a `let` alias is refused like
// `Future::ready`; the direct spelling is `future_pending_monotype_reject`.
fn read_it() -> Int with Async {
  let pending = Future::pending
  let f = pending()
  Future::resolve(f, 40)
  let s: String = await(f)
  String::length(s)
}
