// #2969: every tail of the arm must resume or leave. The `match` below
// resumes in one arm and yields a bare value in the other; the bare one is
// refused (with the same type in both branches, so this is the resume rule
// and not a branch type mismatch).
effect Ask {
  Get(Int) -> Int
}

fn twice() -> Int with Ask {
  perform Ask::Get(1) + perform Ask::Get(2)
}

fn main() -> Int {
  handle { twice() } with { Ask::Get(n) => match n {
    1 => resume(10),
    _ => 20
  } }
}
