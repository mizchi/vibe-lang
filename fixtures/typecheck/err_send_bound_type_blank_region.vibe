// #3549: a `Sender` at a `Send` bound is shown without the checker's region
// name (`Sender[#region_240, _, String]`).
import @vibe/concurrent { TaskGroup, TaskError, Channel, Sender, Receiver, SendError, ChannelConfigError }

fn need[T: Send](x: T) -> Int {
  0
}

fn main() -> Unit allows Console + Exception[TaskError] + Exception[SendError] + Exception[ChannelConfigError] {
  let total = TaskGroup::run((n) -> {
    let (tx, rx) = Channel::bounded(n, 4)
    let k = need(tx)
    Sender::send(tx, "x")
    Sender::release(tx)
    match Receiver::recv(rx) {
      Some(_) => k + 1,
      None => k
    }
  })
  println("total=\{total}")
}
