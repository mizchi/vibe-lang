// ADR-0120 Phase 4b control: the same values called positionally compile, and
// a local lambda still fills an omitted trailing optional slot.
struct Op { run: (Int, Int) -> Int }

fn apply(f: (Int, Int) -> Int) -> Int {
  f(10, 3)
}

fn make() -> (Int, Int) -> Int {
  (x, y) -> x - y
}

fn run() -> Int {
  let g = (x: Int, y?: Int) -> Int {
    match y {
      Some(v) => x - v,
      None => x
    }
  }
  let o = Op::{ run: (x, y) -> x - y }
  apply(f = (x, y) -> x - y) + g(10) + g(10, 3) + (o.run)(10, 3) + make()(10, 3)
}
