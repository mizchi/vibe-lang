// #3275 follow-up after #3304 (Codex on #3315): a kinded effect parameter
// takes the bare constructor the row names, so under `with Read[Array]` the
// payload of `Read::Put(F[Int])` is an `Array[Int]` and an `Option[Int]` is
// refused. Before #3304 the parameter was fresh: this checked clean and the
// arm read the option as an array (`r=4337725341286015266`). #3304 resolved
// `Array` as a complete type, which refused this program only because no
// payload matched `F[Int]` at all -- generic_effect_row_kinded_test.vibe holds
// the correct programs that refusal also hit.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

fn producer() -> Int with Read[Array] {
  perform Read::Put(Some(42))
}

fn main allows Console {
  let r = handle { producer() } with {
    Read::Put(xs) => {
      let a: Array[Int] = xs
      resume(Array::length(a) * 1000 + Array::get(a, 0))
    }
  }
  println("r=\{r}")
}
