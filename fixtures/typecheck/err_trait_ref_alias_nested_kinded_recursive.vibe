// #3995: refuse recursive higher-kinded expansion before secondary diagnostics.
type Apply[F[_], X] = F[X]
type Dup[T] = (T, T)
type A[T] = Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, A[T]]]]]]]]]]]]]
trait Mark[X] {
}
struct Note { n: Int }
impl Mark[Int] for Note {
}
fn main() -> Int {
  0
}
