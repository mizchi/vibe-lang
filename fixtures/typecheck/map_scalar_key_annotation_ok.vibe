// #2334: the builtin map takes `Int`, `Char` and `Bool` keys, in every place
// an annotation can name one -- a parameter, an alias, a nested container.
type IntMap = Map[Int, String]

fn by_id(m: IntMap, id: Int) -> String {
  Map::get(m, key = id)
}

fn counts(_ m: Map[Char, Int]) -> Int {
  Map::size(m)
}

fn flags(_ ms: Array[Map[Bool, String]]) -> Int {
  Array::length(ms)
}

fn main {
  ()
}
