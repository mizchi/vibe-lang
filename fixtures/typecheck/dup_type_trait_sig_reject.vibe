// #3036: `Probe::probe` takes dup_type_a_dep_ok's `Err` (its trait is
// declared in a module that imports `Err` without re-exporting it), and `Err`
// is imported from dup_type_b_dep_ok, a different declaration. The method
// would read b's `{ name: String }` through a's `{ code: Int }` layout.
import ./dup_type_trait_sig_mid_dep_ok.vibe { trait Probe }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> Int {
  Probe::probe(1, Err::{ name: "x" })
}
