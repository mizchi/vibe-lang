// #4091 (Codex on #4106): a helper that copies a module-level scalar into a
// fresh record returns no module storage. `main` answers the block's value.

let tag: Int = 7

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn make_box() -> Box {
  Box::{ tag: tag, items: [] }
}

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let b = make_box()
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  v
}
