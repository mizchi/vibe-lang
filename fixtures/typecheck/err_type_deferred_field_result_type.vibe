//# #2848 (Codex on #2864, round 2): a deferred field read's RESULT type
//# reaches its consumers. `p` is unsolved when `p.v` is checked, and the read
//# used to type as `CtUnknown`, which unifies with anything -- so the lambda
//# was accepted where `(Holder) -> String` was expected and the `Int` field
//# flowed on as a `String`. The read now types as a result variable; when
//# `p` resolves to `Holder` at the end of `go`'s body, that variable is
//# unified with `Int`, and the `String` its consumer fixed it to is a located
//# mismatch.
struct Holder {
  v: Int
}

fn apply(h: Holder, f: (Holder) -> String) -> String {
  f(h)
}

fn go(h: Holder) -> String {
  apply(h, (p) -> {
    p.v
  })
}

export fn main() -> Int {
  String::length(go(Holder::{ v: 8 }))
}
