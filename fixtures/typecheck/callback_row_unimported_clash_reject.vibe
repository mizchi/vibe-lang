// #3351: the callback row's `Pt` is the dependency's. A module whose own `Pt`
// is a different type is refused at the import, so the row is never read as
// this module's `Pt`.
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, run_pt
}

struct Pt {
  y: String
}

fn producer() -> Int with Box {
  run_pt(() -> {
    perform Box::Put(Pt::{ y: "s" })
  })
}
