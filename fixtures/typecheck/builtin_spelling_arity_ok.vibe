//# #2475 (Codex on #2819), the CONTROL: the refusal is arity-aware, and these
//# three are the shapes an over-wide rule would wrongly reject.
//#
//#   `Array` is hard-coded at arity 1 only, so a 2-parameter `Array` resolves
//#   through `find_typedef` and can be named.
//#   `Option` is absent from `resolve_builtin`, so a bare one can be named.
//#   The applied door never consults `resolve_builtin`, so `Int[T]` can be
//#   named even though a bare `Int` cannot.
struct Array[K, V] {
  k: K;
  v: V
}

struct Option {
  present: Bool
}

struct Int[T] {
  v: T
}

export fn main() -> Int {
  let a = Array::{ k: 1, v: "x" }
  let o = Option::{ present: true }
  let i = Int::{ v: 3 }
  a.k + i.v + (if o.present { 1 } else { 0 })
}
