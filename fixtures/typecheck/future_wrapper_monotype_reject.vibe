// #3112: a declared wrapper holding a `Future` is one cell too. The value
// restriction looks through the struct's fields, so `b` is not quantified:
// `resolve(b.f, 40)` makes its payload Int, and awaiting it into a String is a
// type error. Before, only a bare `Future` (and tuples, options and arrays of
// one) stayed monomorphic, and this compiled (Codex on #3091).
struct Box[T] {
  f: Future[T]
}

fn read_it() -> Int with Async {
  let b = Box::{ f: Future::pending() }
  Future::resolve(b.f, 40)
  let s: String = await(b.f)
  String::length(s)
}
