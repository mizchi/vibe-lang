// #3351: the callee's callback row names `Pt`, which this module does not
// import. The lambda's payload is still checked against `Pt`; it used to go
// unchecked, and the callee's arm read the Int as a `Pt`.
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, run_pt
}

fn producer() -> Int with Box {
  run_pt(() -> {
    perform Box::Put(41)
  })
}
