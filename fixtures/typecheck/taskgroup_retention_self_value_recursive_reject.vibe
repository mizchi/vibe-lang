// #4054: the recursive closure captures the task handle AND names itself as a
// value. Dropping its self-capture label must keep the handle's region.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}
fn main() -> Int allows Exception {
  let result = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, f = () -> 42)
    let rec f = (n: Int) -> Int with Exception {
      if n == 0 {
        TaskHandle::join(h)
      } else {
        let again = f
        again(n - 1)
      }
    }
    f
  })
  result(3)
}
