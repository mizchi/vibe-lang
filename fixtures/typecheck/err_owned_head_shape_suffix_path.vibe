// #3551 review: a relative import may name its target by any path, so a path
// that ends in `@vibe/concurrent/experimental/concurrent.vibe` is no evidence
// that the module is the shipped one. Read as the compiler's own declaration,
// the dependency's `TaskGroup[rg, e]` let a bare `TaskGroup` leave both
// formals unbound: this checked clean and printed the `Int` 7 as a fourteen-
// byte `String`. The dependency's declaration is refused.
import ./owned_head_shape_suffix_modules/@vibe/concurrent/experimental/concurrent.vibe {
  struct TaskGroup
}

fn as_str(g: TaskGroup) -> String {
  g.first
}

fn main() -> Unit allows Console {
  println(as_str(TaskGroup::{ first: 7, second: 8 }))
}
