// #3042 (Codex on #3063): the check covers every prelude constructor name,
// not only `Less`. An import that binds `Equal` to another enum left `Less`
// unbound, so the prelude was seeded over the imported `Equal`, while the
// lowering saw the foreign constructor and omitted the prelude declaration.
import ./ordering_foreign_equal_dep_ok.vibe { Match, match_of }

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = match_of(1)
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
