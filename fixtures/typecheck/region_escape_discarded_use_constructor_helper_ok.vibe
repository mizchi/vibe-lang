// #3862 control (Codex on #3872): a block that READS a parameter but discards
// it does not hold it. `held` is the block's value, `0`, so nothing escapes.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Int, B] {
  let held = {
    let ignored = first
    0
  }
  Pair(held, second)
}

fn main() -> Int {
  let kept = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(n, _) = kept
  n
}
