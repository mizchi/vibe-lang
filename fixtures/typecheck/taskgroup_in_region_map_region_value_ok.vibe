// Codex on #4057 control: inside `region r`, a `TaskGroup::run` body maps
// `boxes`, declared in `r`, storing `r`'s value in each element. The group's
// region is not involved, and `boxes` lives as long as `r`.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let outer: Array[MutList[Int]] = []
    let boxes = [outer]
    let got = TaskGroup::run((n) -> {
      let _ = Array::map(boxes, f = (a) -> {
        Array::push(a, value = cell)
        0
      })
      1
    })
    got + Array::length(outer)
  }
  println("v=\{v}")
}
