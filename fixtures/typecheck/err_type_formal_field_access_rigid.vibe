//# #2848, the RIGID spelling. An unbounded formal that takes part in a
//# higher-kinded application (`A` of `F[A]`) is bound in its body as
//# `CtNamed("#hktformal.A", [])` rather than as a unification variable, so it
//# reaches a different checker arm -- the one an unresolved cross-module name
//# also lands in -- and was tolerated there. The spelling can only come from a
//# binder (the parser refuses it in source), which is what lets that arm refuse
//# it without touching the import case. The message names the source
//# spelling, `A`, not the internal one.
struct Crate {
  payload: Int
}

fn read[F, A](xs: F[A], a: A) -> Int {
  a.payload
}

export fn main() -> Int {
  read([1], 7)
}
