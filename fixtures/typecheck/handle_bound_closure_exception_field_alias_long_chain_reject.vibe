// #3596: twenty aliases, each of the one before, bound before the handle.
// The chain is followed to its end however long it is, so `a20` stands for
// `mk`.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let a1 = mk
  let a2 = a1
  let a3 = a2
  let a4 = a3
  let a5 = a4
  let a6 = a5
  let a7 = a6
  let a8 = a7
  let a9 = a8
  let a10 = a9
  let a11 = a10
  let a12 = a11
  let a13 = a12
  let a14 = a13
  let a15 = a14
  let a16 = a15
  let a17 = a16
  let a18 = a17
  let a19 = a18
  let a20 = a19
  let b = handle {
    a20()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
