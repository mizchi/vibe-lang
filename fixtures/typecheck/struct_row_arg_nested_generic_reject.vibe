// #3589 (Codex review on #3594): a generic signature's row ties to a row
// argument that reaches the function row only through a nested struct.
// `Outer[e]` passes `e` to `Inner`'s row parameter, so `call`'s `with e` is
// the row of the function stored in `o.inner.run`, and a pure caller cannot
// run `noisy`'s `Console` through it.
struct Inner[r] {
  run: () -> Int with r
}

struct Outer[r] {
  inner: Inner[r]
}

fn noisy() -> Int with Console {
  println("hi")
  1
}

fn call[e](o: Outer[e]) -> Int with e {
  (o.inner.run)()
}

fn quiet() -> Int {
  call(Outer::{ inner: Inner::{ run: noisy } })
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
