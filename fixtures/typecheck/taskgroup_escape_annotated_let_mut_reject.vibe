// #3276: the annotated spelling of the `let mut` slot. Unannotated
// (`let mut slot = None`) it was already refused, because the slot's open
// element type picked up the region; annotated, it compiled and the handle
// was joined after its group closed. The assignment is refused now.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let mut slot: Option[TaskHandle[Int]] = None
  let r = TaskGroup::run((n) -> {
    slot = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  let after = match slot {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
