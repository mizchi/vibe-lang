export effect Box[T] {
  Put(T) -> Int
}
export fn make[T](_ x: T) -> () -> Int with Box[T] {
  () -> {
    42
  }
}
export fn consume_int(_ f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
export fn consume_string(_ f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s)) }
}
