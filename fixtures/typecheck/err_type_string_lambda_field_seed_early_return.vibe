// A struct field of type `(String) -> String` given a lambda with no written
// result type and an early `return 123`: no result seed checks that `return`,
// so the parameter is not seeded from the field either, and the literal is
// refused rather than storing a function that can return an `Int`.
struct H {
  f: (String) -> String
}

fn make(stop: Bool) -> H {
  H::{
    f: (s) -> {
      if stop {
        return 123
      }
      s + s
    }
  }
}
