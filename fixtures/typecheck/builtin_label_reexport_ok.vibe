// #3651 control (Codex on #3657): a plain re-export binds the name locally,
// so a labeled call to it reaches the program's function and is not refused
// as a builtin call.
export ./builtin_label_reexport_dep_ok.vibe { println }

fn main() -> Unit allows Console {
  let _ = println(x = 1)
  ()
}
