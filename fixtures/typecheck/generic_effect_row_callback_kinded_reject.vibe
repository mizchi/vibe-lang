// #3311: a kinded effect in the callback's row (`Read[Array]`) fixes the
// constructor of the lambda's payload, so an `Option[Int]` is refused where
// the handler reads an `Array[Int]`.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

fn run_read(f: () -> Int with Read[Array]) -> Int {
  handle {
    f()
  } with {
    Read::Put(xs) => {
      let a: Array[Int] = xs
      resume(Array::length(a))
    }
  }
}

fn producer() -> Int with Read {
  run_read(() -> {
    perform Read::Put(Some(1))
  })
}
