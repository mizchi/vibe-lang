// ADR-0120 D3 (#3681): `_` before a parameter makes its slot positional, in
// each declaration form. A `_` slot takes its argument by position, beside
// labels for the rest.
struct Point {
  x: Int
}

fn get(_ xs: Array[Int], at: Int) -> Int {
  Array::get(xs, at)
}

fn Point::shift(_ p: Point, by: Int) -> Int {
  p.x + by
}

let twice = (_ n: Int) -> Int { n * 2 }

fn main() -> Int {
  let p = Point::{ x: 1 }
  get([1, 2], at = 1) + Point::shift(p, by = 2) + p.shift(by = 3) + twice(4) + get([5], 0)
}
