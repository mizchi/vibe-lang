// #3537: `f` is bound to a call result, so it is not generalized: the closure
// `make` returned shares one array across every call and has one element type.
fn make[T]() -> (T) -> Array[T] {
  let a: Array[T] = []
  (x) -> {
    Array::push(a, x)
    a
  }
}
fn use_twice() -> Int {
  let f = make()
  let _ = f("hello")
  let r: Array[Int] = f(5)
  Array::get(r, 0) + 1
}
