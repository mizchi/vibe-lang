// #3311: a lambda passed to a parameter typed `() -> Int with Box[String]`
// performs at that row's instantiation, so `Box::Put(1)` is refused. Before,
// the lambda was checked with no expectation and its perform got a fresh
// `T`: this checked clean, and `run_cb`'s arm read the `Int` as a `String`
// (`String::length` of a payload `12345` answered `24690`).
effect Box[T] {
  Put(T) -> Int
}

fn run_cb(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(s) => resume(String::length(s))
  }
}

fn producer() -> Int with Box {
  run_cb(() -> {
    perform Box::Put(1)
  })
}
