// #3095 control: a lambda with no row of its own inherits the enclosing row,
// whose `N` is the imported alias `type N = String`; the lambda's `[N]` does
// not rebind it.
import ./generic_row_imported_alias_dep.vibe { State, get, N }

fn caller() -> Int with State[N] {
  let f = [N](v: N) -> Int {
    get("abc")
  }
  f(1)
}
