// #3540: `f`'s `Exception[Int] + e` pins `e` only while every carrier of `e`
// names an exception label. Here an array parameter carries `e` alone, so a
// caller fills it with `Exception[String]` through `fs`. Before the fix the
// pin held and this answered `274877906948`.
fn guarded[e](f: () -> Int with Exception[Int] + e, fs: Array[() -> Int with e]) -> Int with e {
  handle {
    f() + fs[0]()
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded(() -> 1, [thrower])
  } with { Exception[String]::Throw(m) => String::length(m) }
}
