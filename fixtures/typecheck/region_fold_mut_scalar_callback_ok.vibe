// Codex on #4057 control: a `let mut` callback over scalars handed to
// `Array::fold` inside a region. Its accumulator is an `Int`, which holds
// nothing of the region whatever it aliases, so the callback is not refused
// as untraceable.
fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mut add = (a: Int, b: Int) -> a + b
    add = (a: Int, b: Int) -> a + b + 0
    Array::fold([1, 2], init = MutList::length(cell), f = add)
  }
  println("v=\{v}")
}
