// #3036 (Codex on #3076): a method-local formal named `Err` in one method of
// `Probe2` used to be excluded for EVERY method, so `probe`'s concrete `Err`
// (dup_type_a_dep_ok's `{ code: Int }`) escaped the check beside
// dup_type_b_dep_ok's `Err { name: String }`.
import ./dup_type_trait_method_formal_mid_dep_ok.vibe { trait Probe2 }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> Int {
  Probe2::probe(1, Err::{ name: "x" })
}
