// #3862 control: a `let` that shadows a parameter hides it, so the region's
// callback passed as `first` never reaches the result, and nothing escapes.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Int, B] {
  let _ = first
  let first = 0
  Pair(first, second)
}

fn main() -> Int {
  let kept = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(n, _) = kept
  n
}
