// #3551 review: the accepted counterpart -- `wrap` declares the row its
// factory hands back, through every spelling of the call, and its caller
// holds `Console`.
fn factory(f: () -> Int with e) -> () -> Int with e {
  f
}

fn apply(f: () -> Int with e) -> Int with e {
  f()
}

fn wrap(f: () -> Int with e) -> Int with e {
  let g = factory(f)
  factory(f)() + (factory(f))() + g() + apply(factory(f)) + apply(g)
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn loud() -> Int with Console {
  wrap(noisy)
}
