// #3036 (Codex on #3076): `Holder[F[_]] { value: F[Int] }` and
// `Holder[G[_]] { value: G[Int] }` are one declaration: a constructor
// binder's spelling is not part of its identity either.
import ./dup_type_hkt_a_dep_ok.vibe { hold }
import ./dup_type_hkt_b_dep_ok.vibe { count }

fn read() -> Int {
  count(hold([1, 2, 3]))
}
