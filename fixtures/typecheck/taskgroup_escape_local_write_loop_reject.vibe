// #3343 (Codex on #3359): inside a loop, a body-local box is written into an
// outer cell BEFORE the handle is written into it -- on the second pass the
// outer cell holds the box that now holds the handle. Judged in program
// order, the box carried nothing where it was stored; this compiled and the
// handle was joined after its group closed. What a binding carries is the
// union of every write into it anywhere in its scope.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  mut h: Option[TaskHandle[Int]]
}

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[Box] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let b = Box::{ h: None }
    let mut i = 0
    while i < 2 {
      if i == 1 {
        c.v = Some(b)
      } else {
        ()
      }
      b.h = Some(TaskGroup::spawn(n, () -> { 41 }))
      i = i + 1
    }
    1
  })
  let after = match c.v {
    Some(b) => match b.h {
      Some(h) => TaskHandle::join(h),
      None => 0 - 2
    },
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
