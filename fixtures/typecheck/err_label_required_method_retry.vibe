// ADR-0120 Phase 4a (Codex on #3881): a bare call or pipe that resolves
// through the receiver-method retry passes its receiver as a written,
// positional argument, so a labeled receiver parameter needs its label just
// as `Meter::value(m)` does. The implicit receiver of a real dot call
// (`m.value()`) stays exempt.
struct Meter {
  n: Int
}

fn Meter::value(m: Meter) -> Int {
  m.n
}

fn main() -> Int {
  let m = Meter::{ n: 1 }
  m.value() + (m |> value)
}
