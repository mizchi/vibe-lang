// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It is handed to a function that pushes it into a module-level
// array. `g()` answered `6` from the dead handler after `vibe check` was
// clean. fixtures/handle_bound_closure_inside_test.vibe hands one to a
// function that only calls it.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Unit {
  Array::push(saved, f)
}

fn main() -> Unit allows Console {
  handle {
    keep(() -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(saved, 0)
  println("g=\{g()}")
}
