// #3417 controls: a binding whose row names the enclosing binder's formal, a
// row variable, an alias of the payload, or a generic function's own formal
// is reassigned at the same payload without a refusal.
effect Box[T] {
  Put(T) -> Int
}

fn run[T](a: () -> Int with Box[T], b: () -> Int with Box[T]) -> Int with Box[T] {
  let mut f = a
  f = b
  let mut k: () -> Int with Box[T] = b
  k = a
  k = () -> { f() }
  f() + k()
}

fn rowvar[e](a: () -> Int with e, b: () -> Int with e) -> Int with e {
  let mut f = a
  f = b
  f()
}

type Alias = String

fn h() -> Int with Box[String] {
  perform Box::Put("a")
}

fn ha() -> Int with Box[Alias] {
  perform Box::Put("a")
}

fn mk[U]() -> Int with Box[U] {
  0
}

fn al() -> Int with Box[String] {
  let mut f = h
  f = ha
  let mut g = ha
  g = h
  let mut m = mk
  m = h
  let mut n = h
  n = mk
  f() + g() + m() + n()
}
