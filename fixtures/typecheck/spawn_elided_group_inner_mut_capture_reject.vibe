// #3640: a spawn into a group written `TaskGroup` (region and row left to the
// call) is checked like any other. The check used to be skipped for it, so the
// task captured the helper's `let mut n` and saw the write made after the
// spawn (`w = 101`).
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup, k: Int) -> TaskHandle[Int] {
  let mut n = k
  let h = TaskGroup::spawn(g, () -> n + 1)
  n = 100
  h
}

fn main() -> Unit allows Console + Exception {
  let w = TaskGroup::run((g) -> {
    let h = start(g, 1)
    TaskHandle::join(h)
  })
  println("w = \{w}")
}
