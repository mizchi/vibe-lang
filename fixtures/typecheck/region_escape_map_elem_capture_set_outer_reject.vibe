// Codex on #4078: `Array::map` over `boxes`, declared in `r` and mapped in
// `s`. The callback pushes an `r` list into its element, then sets the next
// element to an outer array through the captured `boxes`, so the next
// iteration's push lands outside `r`. Refused because the element may hold a
// binding declared before the region (a narrowing that accepted it was
// withdrawn, #4101).
fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    let o1: Array[MutList[Int]] = []
    let o2: Array[MutList[Int]] = []
    let boxes = [o1, o2]
    region s {
      let _ = Array::map(boxes, f = (bx) -> {
        Array::push(bx, value = cell)
        Array::set(boxes, at = 1, value = sink)
        0
      })
      1
    }
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
