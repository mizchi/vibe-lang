// #3351: the callback row names the alias `Pts`, which this module does not
// import and cannot read. The perform is refused with the edit rather than
// left unchecked (importing `Pts` is callback_row_unimported_alias_ok).
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, run_pts
}

fn producer() -> Int with Box {
  run_pts(() -> {
    perform Box::Put(41)
  })
}
