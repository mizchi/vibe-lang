//# #4037: the field function's arity, once the receiver resolves. Before,
//# this checked clean and trapped at run time.
struct Holder {
  f: (Int) -> Int
}

fn apply(h: Holder, g: (Holder) -> Int) -> Int {
  g(h)
}

fn main() -> Int {
  let h = Holder::{ f: (x) -> x + 1 }
  apply(h = h, g = (v) -> v.f(1, 2))
}
