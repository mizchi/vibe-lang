// ADR-0124 (#2656): an `extern effect` declares operations the host
// provides. They are host functions on the capability track, called as
// `Kv::get(k)` the way `Fs::read_file(p)` is, and the effect is the row of
// every function that reaches one. Each call lowers to a core import of
// `vibe:effect:./Kv`, which the runner binds to a provider at launch.
extern effect Kv {
  get(String) -> String
  put(String, String) -> Unit
}

fn read_key(k: String) -> String with Kv {
  Kv::get(k)
}

fn copy_key(from: String, to: String) -> Unit with Kv {
  Kv::put(to, read_key(k = from))
}
