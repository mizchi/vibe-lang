// The same refusal for `x?` parameters (#1500): `c = 6` skips `b`, which no
// positional slot can express, so the label must survive to the order check
// instead of binding `b`.
fn g(a?: Int, b?: Int, c?: Int) -> Int {
  match c {
    Some(v) => v,
    None => 0
  }
}

fn main() -> Unit {
  let _ = g(a = 5, c = 6)
  ()
}
