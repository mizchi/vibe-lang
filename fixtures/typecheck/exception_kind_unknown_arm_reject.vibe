// #3018: an arm's exception kind must name a type in scope. No `IoError` is
// declared here; the arm used to bind `e` at that undeclared nominal type, and
// the host failure's String payload flowed through `String::length(e)`.
fn main() -> Unit allows Stdout + Fs {
  let r = handle {
    let s = Fs::read_file("/nonexistent/file.txt")
    String::length(s)
  } with { Exception[IoError]::Throw(e) => String::length(e) + 1000 }
  println("r=\{r}")
}
