effect Ask {
  Get() -> Int
}

fn run() -> Int with Ask {
  let mut side = () -> Int {
    perform Ask::Get()
  }
  (() -> Unit {
    side = () -> Int {
      7
    }
  })()
  handle {
    side()
  } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle {
    run()
  } with { Ask::Get() => resume(1) }
}
