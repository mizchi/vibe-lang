// #3343: a helper that keeps its argument in a top-level array. A top-level
// binding outlives every group, so the helper's push is refused under the
// caller's region. This compiled and the handle was joined after its group
// closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

let kept: Array[TaskHandle[Int]] = []

fn keep(h: TaskHandle[Int]) -> Unit {
  Array::push(kept, h)
}

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    keep(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r} after=\{TaskHandle::join(Array::get(kept, 0))}")
}
