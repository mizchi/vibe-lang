// #3368: the dependency's own `struct Task` reaches this module only through
// `make`'s result type, and was taken for the compiler's `Task`, whose
// exemption let an `Array[Int]` binding accept it: `Array::length` then read
// the struct as an array.
import ./compiler_owned_name_dep_ok.vibe { make }

fn f() -> Int {
  let x: Array[Int] = make()
  Array::length(x)
}
