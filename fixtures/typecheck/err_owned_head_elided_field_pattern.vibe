// #3572: the same field reached by destructuring the struct.
import @vibe/concurrent { TaskGroup, TaskError }

fn leak(g: TaskGroup) -> String {
  let TaskGroup::{ _region_witness } = g
  _region_witness(7)
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    leak(n)
  })
  println("len=\{String::length(r)}")
}
