// #3311 (Codex on #3340) control: `run_u`'s callback row names `U`, a formal
// no parameter mentions. Its published row marks it as a formal, so it is not
// read as this module's `struct U`: the callee is parametric in it, and either
// payload checks clean.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_u
}

struct U {
  name: String
}

fn producer() -> Int with Box {
  run_u(1, () -> {
    perform Box::Put(5)
  }) + run_u(2, () -> {
    perform Box::Put("x")
  })
}
