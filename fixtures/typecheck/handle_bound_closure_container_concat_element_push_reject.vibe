// #4088: `Array::concat` answers fresh outer storage holding the elements of
// both of its arguments, so a push into an element read out of it is a push
// into the array written in the second argument.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let inner: Array[() -> Int] = []
    let none: Array[Array[() -> Int]] = []
    let rows = [inner]
    let both = Array::concat(none, rows)
    Array::push(Array::get(both, at = 0), value = g)
    let _ = keep_arr(xs = inner)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()} \{plain()}")
}
