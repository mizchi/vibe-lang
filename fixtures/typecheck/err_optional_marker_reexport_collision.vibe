// #3432: collide_facade.vibe re-exports collide_a's `f(x?: Int)` as `foo`, then
// collide_b's `foo(x: Option[Int])`, which the checker types `foo` as. The
// earlier alias's optional parameter used to stay attached to `foo`, so
// `foo()` was accepted and padded with `None` (Codex on #3441). Refused now,
// as for any one-parameter function called with none.
import ../optional_param_import/collide_facade.vibe { foo }

fn call() -> Int {
  foo()
}
