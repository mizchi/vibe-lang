// #3589 (Codex review on #3594): a one-letter lowercase type name is not a
// row variable -- two distinct structs `t` and `u` still do not unify.
struct t {
  x: Int
}

struct u {
  y: String
}

fn get(v: t) -> Int {
  v.x
}

fn main() -> Unit allows Console {
  let w = u::{ y: "hello" }
  println("\{get(w)}")
}
