// #3432: a label an imported function does not declare is refused, as it is
// for a local callee. Before, `greet(typo = 1)` was padded with `None` and
// compiled, passing the `Int` where `name: String` goes (Codex on #3441).
import ../optional_param_import/lib.vibe { greet }

fn call() -> String {
  greet(typo = 1)
}
