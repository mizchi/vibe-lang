// #3612 review: a local spelled like a raw host builtin is still lowered
// straight to the host import, so the effect checker must not take the local
// for it (that would check clean and then exit the process). It stays refused
// for the builtin's row; `print` / `println` / `sh` / `sh_lines`, whose
// lowering yields to a local, are accepted (fixtures/builtin_name_local_shadow_test.vibe).
fn call_it(vibe_process_exit_raw: (Int) -> Int) -> Int {
  vibe_process_exit_raw(3)
}

fn main() -> Unit allows Console {
  println("\{call_it((n) -> n + 1)}")
}
