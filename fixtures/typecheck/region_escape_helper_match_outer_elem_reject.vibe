// #4050: the same for a helper's `match` over an outer argument.
fn put_some(o: Option[Array[MutList[Int]]], c: MutList[Int]) -> Unit {
  match o {
    Some(a) => Array::push(a, value = c),
    None => ()
  }
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    put_some(o = Some(outer), c = cell)
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
