// ADR-0124 decision 3 (#2656): an effect declared in an imported module may
// be named on the entry row when the entry handles it, exactly as a local
// declaration may.
import ./entry_allows_imported_dep_ok.vibe { effect Db, app }

fn main allows Console + Db {
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{v}")
}
