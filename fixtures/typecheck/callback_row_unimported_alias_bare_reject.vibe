// #3351: a zero-argument operation performed bare (`perform Get::Take`) at a
// callback row naming the unimported alias `Pts` is refused with the edit:
// its value would otherwise be read at whatever type the lambda liked.
import ./callback_row_unimported_dep_ok.vibe {
  effect Get, run_take_alias
}

fn producer() -> Int with Get {
  run_take_alias(() -> {
    let n = perform Get::Take
    n + 1
  })
}
