//# #2475 (Codex on #2819), a CONTROL: `Option` is absent from
//# `resolve_builtin`, so only the APPLIED door knows the spelling. A bare
//# `Option` therefore reaches `find_typedef` and this declaration can be
//# named -- and it is named below, in an annotation.
//#
//# `Option[T]` at arity 1 is the opposite case and is refused; see
//# err_type_builtin_spelling_applied_head.
struct Option {
  present: Bool
}

fn read(o: Option) -> Int {
  if o.present {
    5
  } else {
    0
  }
}

fn main() -> Int {
  read(Option::{ present: true })
}
