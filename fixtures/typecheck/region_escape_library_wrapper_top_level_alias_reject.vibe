// #3255: the same through a top-level alias of a library wrapper
// (`MutSet::add`).
import @vibe/core { MutSet }

let add_to = MutSet::add

fn aliased() -> Int {
  let outer: MutSet[MutList[Int]] = MutSet::new(hash_fn = (c) -> 0, eq_fn = (a, b) -> true)
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    add_to(outer, cell)
    1
  }
}
