// #3416: `mid` returns the closure, and its declared return type's row
// answers for it: whoever calls the result covers `Box[Int]`. `mid` itself
// does not perform `mk`'s `Box[Int]`, so a `Box[String]` caller is accepted.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> (() -> Int with Box[Int]) with Box {
  () -> mk()
}
fn top() -> Int with Box[String] {
  let f = mid()
  0
}
