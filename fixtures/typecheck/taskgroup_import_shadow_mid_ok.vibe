// #3360 control (Codex on #3473): this module imports the retaining `put`
// and publishes a `put` of its own that keeps nothing. Its importers read
// this module's `put`, not the import's summary.
import ./taskgroup_escape_import_dep_ok.vibe { put }

export fn put[T](c: Array[T], v: T) -> Unit {
  let _ = Array::length(c)
  let _ = v
}
