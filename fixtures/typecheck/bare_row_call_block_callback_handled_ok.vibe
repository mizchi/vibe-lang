// #3408 (Codex on #3409): the argument to `run` is a block whose result is a
// bound lambda. `run` handles the `Box` its callback parameter names, so the
// lambda is read under it, and `mid` does not take `mk`'s `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn run(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
fn mid() -> Int with Box {
  run({
    let cb = () -> mk()
    cb
  })
}
fn top() -> Int with Box[String] {
  mid()
}
