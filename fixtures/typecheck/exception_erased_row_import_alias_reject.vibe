// #3601: `fail_alias` is a top-level alias of the imported `fail`; it lets
// out what `fail` does.
import ../modules/exception_erased_row_mid.vibe {
  fail_alias
}

fn main() -> Unit allows Console {
  let r = handle {
    fail_alias()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
