// #2078: the inline-literal twin of generic_effect_missing_caller_effect.
// `apply`'s row variable is instantiated by the ARGUMENT, and here the argument
// is a closure literal declaring `with Ask` at the argument position. The row
// must reach `run` exactly as it does when the same function is named --
// otherwise this program performs an effect with no handler and no declared
// row anywhere, compiles clean, and traps at runtime.
//
// A user effect, not `Exception`: the exception row is row-transparent on the
// transitive path, so an `Exception` version of this fixture would pass for a
// reason unrelated to what it is testing.
effect Ask {
  Get(Int) -> Int
}

let apply = [T](f: (x: T) -> T with e, x: T) -> T with e { f(x) }

let run = (x: Int) -> Int {
  apply((y: Int) -> Int with Ask {
    perform Ask::Get(y)
  }, x)
}

fn main {
  let _ = run(1)
}
