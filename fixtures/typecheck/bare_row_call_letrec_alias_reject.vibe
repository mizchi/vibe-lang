// #3408 (Codex on #3409): `let rec h = mk` is an alias of `mk` like `let h
// = mk`, so `h()` is a call of `mk`, `mid` requires `Box[Int]`, and a
// `Box[String]` caller is refused with the row edit (it was refused only by
// the evidence pass).
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let rec h = mk
  h()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
