// A fold callback hands `acc` to a helper that points its first element at a
// module-level array; the next iteration's push lands there.
let kept: Array[MutList[Int]] = []

fn redirect(xs: Array[Array[MutList[Int]]]) -> Unit {
  Array::set(xs, at = 0, value = kept)
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let b = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    let _ = Array::fold([a, b], init = init, f = (acc, c) -> {
      Array::push(Array::get(acc, at = 0), value = c)
      redirect(xs = acc)
      acc
    })
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
