effect Ask {
  Get() -> Int
}

fn ask_once() -> Int with Ask {
  perform Ask::Get()
}

fn pure() -> Int { 7 }

fn run() -> Int with Ask {
  handle {
    let mut f: () -> Int with Ask = ask_once
    for f in [pure] {
      f()
    }
    perform Ask::Get()
  } with {
    Ask::Get() => resume(1)
  }
}

export fn main() -> Int {
  handle { run() } with {
    Ask::Get() => resume(2)
  }
}
