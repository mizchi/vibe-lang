// #4088: a program's own `fn Array::concat` is not the builtin, which stores
// into neither argument: this one stores an element of `a` into `b`, so
// `other` holds `g` after the call, and keeping it is refused.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn Array::concat(a: Array[() -> Int], b: Array[() -> Int]) -> Array[() -> Int] {
  Array::set(b, at = 0, value = Array::get(a, at = 1))
  b
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let arr = [plain]
    let other = [plain]
    Array::push(arr, value = g)
    let _ = Array::concat(a = arr, b = other)
    let _ = keep_arr(xs = other)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("k=\{k()}")
}
