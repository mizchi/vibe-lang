// Codex on #4100: an element of `next`'s `Some((element, rest))` that is a
// module-level array holds no part of the iterand, but it is not fresh
// either: it outlives every region. The binder is marked with every active
// region, so the write is refused (main before this printed `kept=true`).
trait Iterator[T] {
  next(Self) -> Option[(T, Self)]
}

let kept: Array[MutList[Int]] = []

struct Gen {
  left: Int
}

impl Iterator for Gen {
  next(self) -> Option[(T, Gen)] {
    if self.left > 0 {
      Some((kept, Gen::{ left: self.left - 1 }))
    } else {
      None
    }
  }
}

fn main() -> Unit allows Exception + Console {
  let xs = Gen::{ left: 1 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
