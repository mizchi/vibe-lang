// #3343 (Codex on #3359): a body-local array annotated without the group's
// region is filled with `Array::push` and returned. This compiled and the
// handle was joined after its group closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let hs = TaskGroup::run((n) -> {
    let hs: Array[TaskHandle[Int]] = []
    Array::push(hs, TaskGroup::spawn(n, () -> { 41 }))
    hs
  })
  println("after=\{TaskHandle::join(Array::get(hs, 0))}")
}
