// #3572: `TaskHandle[Int]` leaves the region and row to the call, and its
// three formals were then substituted by none of the one argument given, so
// `h.result` was a `ResCell[T]` with `T` unbound and its value read as a
// `String`. The read is refused.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn peek(h: TaskHandle[Int]) -> Option[String] {
  h.result.value
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> 7)
    peek(h)
  })
  match r {
    Some(s) => println("len=\{String::length(s)}"),
    None => println("none")
  }
}
