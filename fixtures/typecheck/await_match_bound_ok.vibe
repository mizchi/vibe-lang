// #3177: a match-bound `await` is the binding, so a row-free lambda calling
// it needs no `Async` (fixtures/await_match_bound_binding_test.vibe runs it).
fn read_it() -> Int {
  let picked: Option[(Future[Int]) -> String] = Some((f: Future[Int]) -> "hello")
  match picked {
    Some(await) => {
      let later = () -> await(Future::ready(5))
      String::length(later())
    },
    None => 0
  }
}
