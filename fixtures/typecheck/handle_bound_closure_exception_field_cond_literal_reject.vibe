// #3594: a top-level function binding that chooses between literals with
// an `if`. The escape check walks each literal it may be, so the struct
// `make` returns is known to hold a throwing closure.
struct Box {
  f: () -> Int
}

let c = true

let make: () -> Box with Exception[Int] = if c {
  () -> Box::{ f: () -> throw(7) }
} else {
  () -> Box::{ f: () -> 1 }
}

fn main() -> Unit allows Console {
  let b = handle {
    make()
  } with { Exception[Int]::Throw(x) => Box::{ f: () -> x } }
  let f = b.f
  println("\{f()}")
}
