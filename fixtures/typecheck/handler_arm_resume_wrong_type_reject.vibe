// #2962 / #2969: the resumed value is checked against the OPERATION's return
// type -- `resume(7)` for an operation returning String is refused, not read
// as a string by the body at run time.
effect Cfg {
  Get() -> String
}

fn body() -> Int with Cfg {
  let s = perform Cfg::Get()
  String::length(s) + 100
}

fn main() -> Int {
  handle { body() } with { Cfg::Get() => resume(7) }
}
