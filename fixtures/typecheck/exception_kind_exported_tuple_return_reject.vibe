// Codex on #3021: the exported-row refusal looks through tuples -- a callback
// returned inside a tuple is published with its row.
type Pair = (Int, Int)

export fn make() -> (() -> Int with Exception[Pair], Int) {
  (() -> Int with Exception[Pair] {
    let p: Pair = (1, 2)
    throw(p)
  }, 0)
}

fn main() -> Int {
  0
}
