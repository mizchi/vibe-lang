// ADR-0120 Phase 4b: a call through a fn-typed parameter is positional. The
// labels used to be ignored, so the arguments bound in written order:
// `f(y = 3, x = 10)` passed 3 first and `run()` answered -7.
fn apply(f: (Int, Int) -> Int) -> Int {
  f(y = 3, x = 10)
}

fn run() -> Int {
  apply(f = (x, y) -> x - y)
}
