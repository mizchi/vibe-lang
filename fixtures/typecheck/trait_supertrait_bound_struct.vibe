// #1503 follow-up: an impl of a SUBTRAIT satisfies a supertrait bound.
// `type_implements_trait` used to bail out when the BOUND trait had no
// supertraits of its own -- the wrong question, and `Base` being a root trait
// is the normal case -- so this reported `no impl `Base` for `P`` for every
// type, parameterized or not.
trait Base {
  base_m(Self) -> Int
}

trait Child: Base {
  child_m(Self) -> Int
}

struct P {
  x: Int
}

impl Child for P {
  base_m(self) -> Int {
    self.x
  }
  child_m(self) -> Int {
    1
  }
}

fn use_base[T: Base](x: T) -> T {
  x
}

export let v: () -> Int = () -> {
  use_base(P::{
    x: 7
  }).x
}
