// #3540: a kinded arm over a row variable reached through a function stored
// in an array parameter. The caller fills `e` with `Exception[String]`, and the
// `Exception[Int]` arm -- a catch-all at run time -- caught the String and
// read its pointer as an Int: this answered `274877906948` instead of
// reaching the caller's `Exception[String]` arm.
fn guarded(fs: Array[() -> Int with e]) -> Int with e {
  handle {
    fs[0]() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded([thrower])
  } with { Exception[String]::Throw(m) => String::length(m) }
}
