// #3198 review (Codex): an annotated `let` records its payload heads like an
// annotated parameter.
trait AIter[T] {
  next(Self) -> Future[Option[(T, Self)]]
}

struct Countdown {
  n: Int
}

impl AIter for Countdown {
  next(self) -> Future[Option[(Int, Countdown)]] {
    Future::ready(if self.n > 0 {
      Some((self.n, Countdown::{ n: self.n - 1 }))
    } else {
      None
    })
  }
}

fn total(n: Int) -> Int {
  let o: Option[Countdown] = Some(Countdown::{ n: n })
  let mut acc = 0
  match o {
    Some(c) => {
      for x in c {
        acc = acc + x
      }
      ()
    },
    None => ()
  }
  acc
}

fn main() -> Int {
  total(3)
}
