// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A `throw` inside the closure is caught by the handle's exception arm
// only while the body runs; called afterwards it trapped.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
fn main() -> Unit allows Console {
  let g = handle {
    let h = () -> {
      throw("x")
      1
    }
    h
  } with { Exception[String]::Throw(_) => () -> 0 }
  println("g=\{g()}")
}
