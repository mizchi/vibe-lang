//# #3549: every struct is compared field by field, and a function field by
//# identity. Measured before the refusal, two `S` values built from closures
//# with the same body answered `false`.
struct S {
  f: (Int) -> Int;
  n: Int
}

export fn main() -> Int {
  let a = S::{ f: (x: Int) -> x + 1, n: 1 }
  let b = S::{ f: (x: Int) -> x + 1, n: 1 }
  if a == b {
    1
  } else {
    0
  }
}
