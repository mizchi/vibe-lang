//# #2762, the multi-module half: the refusal must name the module that PROMISED
//# the name, not the module that believed it.
//#
//# That is the whole complaint in the issue. Measured on main before the fix,
//# with the dependency's `export { }` accepted, a consumer that imported the
//# promised name was told `line 3:3: <this file>: imported name '...' is not
//# exported by './dep.vibe'` -- a diagnostic pointing at its OWN import line,
//# with nothing at all said about the module whose export list is wrong.
//#
//# This file is clean. Its row records a rejection whose needle is the
//# DEPENDENCY's path, so an error that came back pointing here would fail it.

import ./export_aggregate_undeclared_refused.vibe {
  mk
}

export fn main() -> Int {
  mk()
}
