// #3568: a callback that RETURNS a `with r` callback binds the struct's row
// formal through its result, so calling the returned function charges `e`.
struct Holder[r] {
  make: () -> (() -> Int with r)
}

fn wrap(f: () -> Int with e) -> Int {
  let h = Holder::{ make: () -> f }
  ((h.make)())()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
