// #3642: a parameter typed with an alias of a type whose `next` returns a
// `Future` drives the await loop, so the function needs `Async` -- the effect
// check follows the alias the same way the loop classification does.
struct Ticks {
  n: Int
}

fn Ticks::next(t: Ticks) -> Future[Option[(Int, Ticks)]] {
  if t.n <= 0 {
    Future::ready(None)
  } else {
    Future::ready(Some((t.n, Ticks::{ n: t.n - 1 })))
  }
}

type T2 = Ticks

fn total(t: T2) -> Int {
  let mut acc = 0
  for x in t {
    acc = acc + x
  }
  acc
}

fn main allows Console + Async {
  println("total = \{total(Ticks::{ n: 3 })}")
}
