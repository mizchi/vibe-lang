// #3022 review: an effect known here only through an imported function's row
// (`Ask::Get`) does not authorize every other operation spelled on its head.
// `Ask::Typo` is refused rather than accepted on the strength of the head.
import ./imported_row_op_dep.vibe { ask }

fn both() -> Int with Ask::Get + Ask::Typo {
  ask()
}

fn main() -> Unit allows Stdout {
  println("ok")
}
