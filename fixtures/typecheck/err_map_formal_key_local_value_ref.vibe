// #2334: the same for a LOCAL generic helper, aliased and then called with an
// `Int`-keyed map. Its one lowered body compares the key as a `String`.
fn main {
  let look = [K, V](m: Map[K, V], k: K) -> V { Map::get(m, key = k) }
  let f = look
  let m: Map[Int, Int] = Map::set(Map::new(), key = 1, value = 10)
  let _ = f(m, 1)
  ()
}
