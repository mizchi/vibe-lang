// #3551 review: the applied spelling leaked the same way. `TaskHandle[Int]`
// against a program `struct TaskHandle[rg, e, T]` left `rg` unbound, so
// `h.tag` (an `Int`) was accepted as a `String`.
struct TaskHandle[rg, e, T] {
  tag: rg;
  v: T
}

fn tag_of(h: TaskHandle[Int]) -> String {
  h.tag
}

fn main() -> Unit allows Console {
  println(tag_of(TaskHandle::{ tag: 7, v: 1 }))
}
