// #2964: a throw whose payload is a pattern binder is not covered by a row
// that promises only `Exception[IoErr]`.
enum IoErr {
  NotFound(String)
}

enum ParseErr {
  Eof
}

fn f(x: Option[ParseErr]) -> Int with Exception[IoErr] {
  match x {
    Some(e) => throw(e)
    None => 0
  }
}

fn main() -> Int {
  handle { f(Some(Eof)) } with { Exception[IoErr]::Throw(_) => 0 }
}
