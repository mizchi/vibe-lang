// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A closure returned by a function whose row names the effect inherited
// that row from the call made inside the handle.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

fn mk() -> (() -> Int) with Ask {
  () -> perform Ask::Get() + 1
}

fn main() -> Unit allows Console {
  let g = handle {
    mk()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
