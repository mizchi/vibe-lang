// #3163: `Future::ready` passed where a declared function type is expected
// is refused too; the parameter type would not make the value form sound.
fn apply1(f: (Int) -> Future[Int], x: Int) -> Future[Int] {
  f(x)
}

fn read_it() -> Int with Async {
  let s: String = await(apply1(Future::ready, 5))
  String::length(s)
}
