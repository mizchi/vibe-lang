// #3408 (Codex on #3409): `pass` performs `Box` at `String` itself, so its
// bare row publishes `Box[String]`, and it also forwards its callback's
// performs. The callback's `Box[Int]` (through `mk`) still reaches `pass`'s
// caller, so `mid` requires it and a `Box[String]`-only caller is refused.
// Only a callee whose row does not name `Box` at all discharges it.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn pass(f: () -> Int with Box) -> Int with Box {
  perform Box::Put("abc") + f()
}
fn mid() -> Int with Box {
  pass(() -> mk())
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
