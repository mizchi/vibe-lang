// ADR-0120 D4: a pipe fills the first slot, so with labels on the rest that
// slot must be declared `_` -- through a bare method name as through the
// qualified one.
struct Meter {
  base: Int
}

fn Meter::shift(m: Meter, by: Int) -> Int {
  m.base - by
}

fn main() -> Int {
  let m = Meter::{ base: 100 }
  m |> shift(by = 7)
}
