// #3341: a lambda bound to a name and then passed to a callback parameter
// performs at that parameter's instantiation. It was checked at its `let`
// with a fresh one, so `perform Box::Put(1)` reached a handler at `String`.
effect Box[T] {
  Put(T) -> Int
}

fn run_cb(f: () -> Int with Box[String]) -> Int with Box[String] {
  f()
}

fn named_passed() -> Int with Box[String] {
  let g = () -> Int { perform Box::Put(1) }
  run_cb(g)
}
