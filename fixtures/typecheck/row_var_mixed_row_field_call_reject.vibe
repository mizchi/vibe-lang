// #3568 (Codex review on #3587): a field row holding a fixed label beside the
// struct's row formal (`with Exception + r`) binds `r` to the stored
// callback's row variable (`with Exception + e`), so a call through the field
// charges `e` as `f()` would. Before the fix only a row of exactly one label
// was bound, and `wrap` ran `f` without declaring `e`.
struct Holder[r] {
  run: () -> Int with Exception + r
}

fn wrap(f: () -> Int with Exception + e) -> Int with Exception {
  let h = Holder::{ run: f }
  (h.run)()
}
