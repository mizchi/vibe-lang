// A channel endpoint read out of `Channel::bounded`'s pair printed `s=1788`.
import @vibe/concurrent { TaskGroup, Channel, Sender, Receiver }

fn main() -> Unit allows Exception + Console {
  let _ = TaskGroup::run((n) -> {
    let p = Channel::bounded(n, 4)
    let s = p.0
    println("s=\{s}")
    0
  })
}
