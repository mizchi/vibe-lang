// #3036 (Codex on #3076): `Caps` is dup_type_effectset_op_mid_dep_ok's
// `{ Fail::Raise }`, and `Raise` takes dup_type_a_dep_ok's `Err { code: Int }`
// -- reached only through the qualified member's effect. `Err` here is
// dup_type_b_dep_ok's `{ name: String }`, so a handler for `Raise` would
// read one layout through the other.
import ./dup_type_effectset_op_mid_dep_ok.vibe { Caps, run }
import ./dup_type_b_dep_ok.vibe { Err }

fn call() -> Int with Caps {
  run(1)
}
