// #3179: the program declares its own `Array::get`, answering a `String`, and
// binds the direct call's result at that type. The checker used to type the
// call through the builtin's arm and refuse this binding (`expected String,
// got Int`) -- the refusal was the checker's error, not the program's.
fn Array::get(xs: Array[Int], i: Int) -> String {
  let _ = xs
  let _ = i
  "own"
}

fn main() -> Int {
  let v: String = Array::get([1, 2], 0)
  String::length(v)
}
