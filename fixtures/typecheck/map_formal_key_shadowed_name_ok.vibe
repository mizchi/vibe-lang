// #2334 control: a parameter that shares its name with a function keyed by
// its type parameter is a different binding, and using it as a value is fine.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn identity(look: Int) -> Int {
  look
}

fn main {
  let m = Map::from_pairs([("a", 1)])
  let _ = look(m, "a")
  let _ = identity(3)
  ()
}
