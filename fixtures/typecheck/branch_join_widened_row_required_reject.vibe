// #3598: an unannotated `if` whose later branch throws joins at the throwing
// type even when the pure branch comes first, so calling the value still
// needs the exception in the caller's row.
fn mk() -> Int with Exception[Int] {
  throw(7)
}

fn g(c: Bool) -> Int {
  let f = if c {
    () -> 1
  } else {
    mk
  }
  f()
}

fn main() -> Unit allows Console {
  println("\{g(false)}")
}
