// #3416: the loop calls `cb` before the assignment, so the second iteration
// runs the assigned lambda; `mid` requires `Box[Int]` and a `Box[String]`
// caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mut cb = () -> 0
  let mut i = 0
  while i < 2 {
    i = i + 1 + cb()
    cb = () -> mk()
  }
  i
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
