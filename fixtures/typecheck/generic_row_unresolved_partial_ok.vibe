// #3095 control: an open part never refuses. `get([])` may be `Array[Int]`,
// and `get(None)` may be `Option[S]`.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller() -> Int with State[Array[Int]] {
  get([])
}

fn caller2[S](x: S) -> Int with State[Option[S]] {
  get(None)
}
