// #2334: a generic function whose type parameter keys a builder is lowered
// once, with the String key operations, so a call at an `Int` key is refused.
fn put[K](b: MapBuilder[K, Int], k: K) -> Unit {
  MapBuilder::set(b, key = k, value = 1)
}

fn main() -> Unit {
  let b = MapBuilder::new()
  put(b = b, k = 3)
  ()
}
