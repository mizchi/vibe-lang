// #3073 control: a derive over a field whose declared type provides the
// operation still checks -- derived on the field's type, written by hand, or
// on a field that names the deriving type itself.
struct Inner {
  x: Int
} derive (Ord, Show)

struct Manual {
  y: Int
}

fn Manual::compare(a: Manual, b: Manual) -> Ordering {
  if a.y < b.y {
    Less
  } else if a.y > b.y {
    Greater
  } else {
    Equal
  }
}

enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
} derive (Ord, Show)

struct Outer {
  inner: Inner;
  manual: Manual;
  tree: Tree
} derive (Ord)

struct Shown {
  inner: Inner
} derive (Show)
