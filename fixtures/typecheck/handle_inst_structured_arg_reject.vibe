// #3022 review: a structured generic-effect argument spelled with builtin
// names is compared too. The handler resumes with `Array[Int]`; the callee
// declares `State[Array[String]]`.
effect State[S] {
  Get() -> S
}

fn get_strs() -> Array[String] with State[Array[String]] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let n = handle {
    Array::length(get_strs())
  } with { State::Get() => resume([1, 2]) }
  println("\{n}")
}
