// Codex on #3661: `b = ..` runs first and reassigns `g` to a lambda with the
// other parameter order, so `g(y = 3, x = 10)` in `a = ..` would be placed by
// the names `g` had before that assignment (answering -7 for 7). The checker
// types the arguments in declared order, so the call is refused with the edit.
fn f(a: Int, b: Int) -> Int {
  a + b
}

fn main() -> Int {
  let mut g = (x~: Int, y~: Int) -> Int { x - y }
  f(b = {
    g = (y~: Int, x~: Int) -> Int { x - y }
    0
  }, a = g(y = 3, x = 10))
}
