// #3036: `make_err` returns dup_type_a_dep_ok's `Err`, and the imported trait
// `Weigh` carries dup_trait_impl_dep_ok's `impl Weigh for Err` -- a different
// `Err`. The bare target would let that implementation read a's value
// through its own layout.
import ./dup_type_a_dep_ok.vibe { make_err }
import ./dup_trait_impl_dep_ok.vibe { trait Weigh }

fn read() -> Int {
  Weigh::weigh(make_err())
}
