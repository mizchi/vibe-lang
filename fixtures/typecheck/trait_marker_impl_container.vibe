// #1503: a MARKER trait (no methods) dispatches to the builtin `==` / `<`, and
// those are reference equality on `Array` (`[1, 2] == [1, 2]` is `false`,
// #1526). Honouring `impl Eq for Array[..]` as a bound would therefore make the
// comparison silently wrong, so the impl is declarable but refused as a bound.
// The diagnostic must SAY that the impl exists -- a bare `no impl` is false
// here, the program declares one two lines below.
trait Eq

impl Eq for Int

impl [T: Eq] Eq for Array[T]

fn keep[T: Eq](x: T) -> T {
  x
}

export let arr: () -> Array[Int] = () -> {
  keep([1, 2, 3])
}
