// A row-free callback can be called directly and also passed to a row-carrying parameter.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(_ f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 7
  drive(g) + g() + drive(tick)
}
