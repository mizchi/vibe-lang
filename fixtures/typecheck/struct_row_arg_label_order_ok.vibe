// #3589 (Codex review on #3594): two struct row arguments holding the same
// effects written in a different order are one type -- in the branches of an
// `if`, in an array, and as one generic `Holder[r]` -- because the labels
// are normalized before they reach the argument.
struct Holder[r] {
  run: () -> Int with r
}

fn a() -> Int with Console + Env {
  println("a")
  1
}

fn b() -> Int with Env + Console {
  println("b")
  2
}

fn both[r](x: Holder[r], y: Holder[r]) -> Int with r {
  (x.run)() + (y.run)()
}

fn pick(c: Bool) -> Int with Console + Env {
  let h = if c {
    Holder::{ run: () -> {
      println("a")
      let _ = Env::get("HOME")
      1
    } }
  } else {
    Holder::{ run: () -> {
      let _ = Env::get("HOME")
      println("b")
      2
    } }
  }
  (h.run)()
}
fn main() -> Unit allows Console + Env {
  let xs = [Holder::{ run: a }, Holder::{ run: b }]
  println("\{both(Holder::{ run: a }, Holder::{ run: b })} \{pick(true)} \{Array::length(xs)}")
}
