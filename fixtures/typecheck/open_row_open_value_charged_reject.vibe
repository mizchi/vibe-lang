// #3575: `Console + e` given `Console + Fs + f` binds `e := Fs + f`, so the
// call's row is `Console + Fs + f`; a caller declaring `Console + f` is
// refused for the `Fs` it drops.
fn call(f: () -> Int with Console + e) -> Int with Console + e {
  f()
}

fn drops_fs(g: () -> Int with Console + Fs + f) -> Int with Console + f {
  call(g)
}
