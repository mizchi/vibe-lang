// #3408 (Codex on #3409): a generic callee's row names its formal
// (`Box[T]`); it is not copied into `mid`, so a `Box[Int]` caller is not
// refused over a `T` nothing binds there. The row is written `with Box[T]`:
// a bare `with Box` on a generic whose body performs at `T` is refused
// (#3411).
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn mid() -> Int with Box {
  mk(1)
}
fn top() -> Int with Box[Int] {
  mid()
}
