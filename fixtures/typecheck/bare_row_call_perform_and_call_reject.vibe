// #3408 (Codex on #3409): `mid` performs `Box` at `Int` itself and calls
// `str`, which performs it at `String`. It must require both. When the
// published `Box[Int]` decided that the row was no longer bare, `str` was
// never read, an `Int`-only caller checked clean, and its handler received
// the string.
effect Box[T] {
  Put(T) -> Int
}
fn str() -> Int with Box {
  perform Box::Put("abc")
}
fn mid() -> Int with Box {
  perform Box::Put(1) + str()
}
fn caller() -> Int with Box[Int] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(n) => resume(n + 1) }
}
