// #4091: a container of the region body that holds an outer array as an
// element is still a local: a region value written into the container itself,
// rather than into that element, stays inside the region.

let sink: Array[MutList[Int]] = []

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let mine: Array[MutList[Int]] = []
    Array::push(mine, value = c)
    let init: Array[Array[MutList[Int]]] = []
    Array::push(init, value = sink)
    Array::push(init, value = mine)
    Array::length(init)
  }
  v * 10 + Array::length(sink)
}
