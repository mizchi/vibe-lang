//# #2807: a field read on an enum receiver is refused.
//#
//# `Crate` declares `payload`; `Parcel` does not have fields at all. Before the
//# fix the read was tolerated as `CtUnknown` and codegen resolved `.payload` by
//# SPELLING against the only struct declaring it, emitting a load at that
//# struct's offset. This compiled clean and answered `7` -- the enum's payload
//# read through an unrelated declaration.
struct Crate {
  payload: Int
}

enum Parcel {
  Empty;
  Full(Int)
}

export fn main() -> Int {
  let p = Full(7)
  p.payload
}
