// A block statement that assigns and then ends in a `for` throws the loop's
// values away, so the `Map::set` inside it updates nothing.
fn main() -> Int {
  let m: Map[String, Int] = Map::new()
  let mut n = 0
  {
    n = n + 1
    for k in ["a", "b"] {
      Map::set(m, key = k, value = n)
    }
  }
  Map::size(m) + n
}
