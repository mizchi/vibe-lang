// A labeled closure argument is passed after an omitted optional parameter,
// so its written index (0) is not its formal slot (1). Read at the written
// index, the closure took `safe`'s row -- `Ask + Log` -- and the `Log` it
// performs looked answered at a parameter that carries only `Ask`; the
// closure escaped the `handle` with no diagnostic (Codex on #3844).
effect Ask {
  Get() -> Int
}

effect Log {
  Put(n: Int) -> Unit
}

let kept: Array[() -> Int with Ask] = []

fn keep(safe?: () -> Int with Ask + Log, f: () -> Int with Ask) -> Unit {
  let _ = safe
  Array::push(kept, value = f)
}

fn main() -> Unit allows Console {
  let n = handle {
    keep(f = () -> {
      let v = perform Ask::Get()
      perform Log::Put(v)
      v
    })
    1
  } with {
    Ask::Get() => resume(5);
    Log::Put(_) => resume(())
  }
  println("\{n}")
}
