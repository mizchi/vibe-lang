// #3640: a spawn-shaped helper whose group parameter is written `TaskGroup`
// (region and row left to the call, #3536) is spawn-shaped like one written
// `TaskGroup[rg, e]`, so its callers' closures are checked. Only the complete
// spelling used to count: this program checked clean, and the task read the
// caller's `let mut n` across the spawn boundary (`w = 2`).
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup, f: () -> Int) -> TaskHandle[Int] {
  TaskGroup::spawn(g, f)
}

fn main() -> Unit allows Console + Exception {
  let mut n = 1
  let w = TaskGroup::run((g) -> {
    let h = start(g, () -> n + 1)
    TaskHandle::join(h)
  })
  println("w = \{w}")
}
