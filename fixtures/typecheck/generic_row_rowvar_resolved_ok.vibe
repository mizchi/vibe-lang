// #3102 review control: the row variable resolves to `State[String]` and the
// caller declares exactly that.
effect State[S] {
  Get() -> S
}

fn read() -> Int with State[String] {
  1
}

fn apply[e](f: () -> Int with e) -> Int with e {
  f()
}

fn caller[T](x: T) -> Int with State[String] {
  apply(read)
}
