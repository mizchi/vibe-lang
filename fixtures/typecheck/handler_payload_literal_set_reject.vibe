// #3371: a handler arm selects on the operation alone. Both effect lowerings
// bound the payload of `Pick::P(1)` to nothing and dispatched on `P`, so this
// arm ran for `perform Pick::P(3)` and `main` answered 100. A payload position
// is a name or `_`; the message names the arm to write instead.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn main() -> Int {
  handle {
    perform Pick::P(3)
  } with {
    Pick::P(1) => resume(100);
    Pick::Q(_) => resume(7)
  }
}
