// #3360: the closure handed to `Array::map` is bound by `let` and passed by
// its name. It stores its parameter -- each task handle of the group -- into
// an outer array, the write the same closure written at the call is refused
// for. The recheck read only a literal at the call, so this compiled.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, () -> { 41 })]
    let stash = (h) -> {
      Array::push(outer, h)
      0
    }
    let _ = Array::map(hs, stash)
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
