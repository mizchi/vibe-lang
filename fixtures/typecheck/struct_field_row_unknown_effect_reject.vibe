// A struct field's row naming no effect is refused at the declaration, as a
// function's row is. It was accepted, and the program was refused at `main`
// ("cannot discharge { Nope }") or, with no entry, not at all.
struct Holder {
  run: () -> Int with Nope
}

fn quiet() -> Int {
  1
}

fn main() -> Unit allows Console {
  let h = Holder::{ run: quiet }
  println("\{(h.run)()}")
}
