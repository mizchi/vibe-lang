// #3036 (Codex on #3076): dup_type_a_dep_ok's `Err` imported AS `Y`, after
// another module's own `Y`. The alias shadowed that `Y`, so a value made as
// `Y { name: String }` was read through `Err { code: Int }`'s layout.
import ./dup_type_alias_local_dep_ok.vibe { Y, make_y }
import ./dup_type_a_dep_ok.vibe { Err as Y }

fn read() -> Int {
  let v: Y = make_y()
  v.code
}
