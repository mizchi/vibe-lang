// #3371: a handler inside a lambda is checked by the same arm loop; its
// literal payload ran for `perform Pick::P(3)` and answered 100.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn run() -> Int {
  let f = () -> {
    handle {
      perform Pick::P(3)
    } with {
      Pick::P(1) => resume(100);
      Pick::Q(_) => resume(7)
    }
  }
  f()
}
