// ADR-0124 decision 3 (#2656): naming an imported effect on the entry row
// does not admit a call to its callee outside every handler; the call is
// refused at its site.
import ./entry_allows_imported_dep_ok.vibe { effect Db, app }

fn main allows Console + Db {
  let a = app()
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{v} \{a}")
}
