// #3095: a nested lambda's formal spelled `Int` is a formal inside it, so its
// `with State[Int]` does not cover `State[String]`.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn outer() -> Int {
  let f = [Int](v: Int) -> Int with State[Int] {
    get("abc")
  }
  0
}
