//# #3026: importing a TYPE projects its declaration closure. `Wrap`'s payload
//# names the dependency's `Err`, and a local declaration wins over a projected
//# one of the same name, so `Bad`'s payload would be read at this `Err`.
import ./foreign_type_name_dep.vibe { Wrap }

struct Err {
  name: String
}

fn main() -> Unit {
  let _ = Err::{ name: "x" }
}
