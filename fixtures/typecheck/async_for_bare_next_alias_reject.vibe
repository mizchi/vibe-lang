// #3641: `next` spelled with a `type` alias of `Future` is the same async
// iterator. The checker reads the resolved return type, and the desugar now
// follows the alias to the same answer, so the loop is charged here and
// awaited there (before, the desugar refused it as having no protocol once
// the row was added).
struct Countdown {
  n: Int
}

type Step = Future[Option[(Int, Countdown)]]

fn Countdown::next(c: Countdown) -> Step {
  if c.n <= 0 {
    Future::ready(None)
  } else {
    Future::ready(Some((c.n, Countdown::{ n: c.n - 1 })))
  }
}

fn sum_down(n: Int) -> Int {
  let mut acc = 0
  for x in Countdown::{ n: n } {
    acc = acc + x
  }
  acc
}

fn main allows Console + Async {
  println("sum = \{sum_down(4)}")
}
