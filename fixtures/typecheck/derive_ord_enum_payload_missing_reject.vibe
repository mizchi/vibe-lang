// #3073: `derive (Ord)` on `Outer` goes through `Inner::compare` for its payload of `Has`, and
// `Inner` neither derives `Ord` nor defines `compare`. `vibe check` reported this
// clean and the build stopped with an internal compiler error (`Inner::compare`
// reached code generation unresolved); it is refused at `Outer` now, naming the
// edit.
enum Inner {
  A;
  B
}

enum Outer {
  Has(Inner);
  Empty
} derive (Ord)
