// #3112: a `let` of `Future::pending()` is ONE cell, so its payload is not
// quantified: `resolve(f, 40)` makes it an Int future, and awaiting it into a
// String is a type error. Quantified, each use saw a fresh payload and this
// compiled.
fn read_it() -> Int with Async {
  let f = Future::pending()
  Future::resolve(f, 40)
  let s: String = await(f)
  String::length(s)
}
