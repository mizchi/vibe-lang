// #3862 control: a `match` whose arms hold no parameter keeps the region's
// callback out of the result, so nothing escapes.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Int, B] {
  match first {
    _ => Pair(0, second)
  }
}

fn main() -> Int {
  let kept = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(n, _) = kept
  n
}
