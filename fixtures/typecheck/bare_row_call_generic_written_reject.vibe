// #3408 (Codex on #3409): a generic callee's row names its formal
// (`Box[T]`). `mk(12345)` instantiates it at `Int`, so `mid` requires
// `Box[Int]`. This checked clean, and the handler's `String::length` of the
// `Int` answered 24690.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn mid() -> Int with Box {
  mk(12345)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
