// ADR-0124 decision 3 (#2656), r3: the handled effect reaches the handle
// through a callee's declared row, and the operation-level label is admitted
// by an arm naming that operation.
effect Db {
  Get(Int) -> Int
}

fn app() -> Int with Db {
  perform Db::Get(1)
}

fn main allows Console + Db::Get {
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{v}")
}
