// #3036 (Codex on #3076): names dup_type_a_dep_ok's `Err` only in retained
// implementations -- as an applied trait's argument, and in a generic
// implementation's bound. `Err` itself is not re-exported.
import ./dup_type_a_dep_ok.vibe { Err }

export trait Decoder[E] {
  decode(Self) -> E
}

export struct Token {
  n: Int
}

impl Decoder[Err] for Token {
  decode(self) -> Err {
    Err::{ code: self.n }
  }
}

export trait Builds[E] {
  build(Self) -> E
}

export trait Use {
  use_it(Self) -> Int
}

export struct Box[T] {
  v: T
}

impl [T: Builds[Err]] Use for Box[T] {
  use_it(self) -> Int {
    1
  }
}
