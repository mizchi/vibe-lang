// #3096 review: `N` in the outer row is the imported alias `type N = String`,
// so `with State[N]` covers a call requiring `State[String]`. A nested
// lambda's unrelated `[N]` binder is out of scope at the header and must not
// make the outer spelling a rigid formal.
import ./generic_row_imported_alias_dep.vibe { State, get, N }

fn caller() -> Int with State[N] {
  let id = [N](v: N) -> N {
    v
  }
  let _ = id(1)
  get("abc")
}
