let sink: Array[MutList[Int]] = []

struct Holder { flag: Bool }

fn Holder::make(self: Holder, flag: Bool) -> Array[Array[MutList[Int]]] {
  let local: Array[Array[MutList[Int]]] = [[]]
  Array::set(local, at = 0, value = sink)
  if flag && self.flag {
    return local
  }
  [[]]
}

fn wrap(holder: Holder, flag: Bool) -> Array[Array[MutList[Int]]] {
  holder.make(flag = flag)
}

fn main() -> Unit allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let holder = Holder::{ flag: true }
    let nested: Array[Array[MutList[Int]]] = wrap(holder = holder, flag = true)
    Array::push(Array::get(nested, at = 0), value = c)
    1
  }
  let _ = v
  ()
}
