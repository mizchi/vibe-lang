// #3595: once `m1` declares the `Console` its callback performs, a call site
// charges it to the caller, so the pure `q` is refused.
fn noisy() -> Int with Console {
  println("noisy")
  1
}

fn m1(f: () -> Int with Console + e) -> Int with Console + e {
  f()
}

fn q() -> Int {
  m1(noisy)
}

fn main() -> Unit allows Console {
  println("\{q()}")
}
