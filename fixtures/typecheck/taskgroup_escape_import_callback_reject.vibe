// #3360: an imported helper hands the group's task handle to a function it
// was passed. Which function that is is not known where the helper is
// checked, so the call is refused rather than trusted.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { apply_to }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    apply_to(h, (x) -> 0)
  })
  println("r=\{r}")
}
