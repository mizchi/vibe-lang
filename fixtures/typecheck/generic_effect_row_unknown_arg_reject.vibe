// #3319: a generic effect's type argument in a row names a type, so a name
// nothing declares is reported, as it is in a parameter annotation. Before,
// this checked clean and the perform kept a fresh instantiation, as under a
// bare `with Box`.
effect Box[T] {
  Put(T) -> Int
}

fn f() -> Int with Box[Nope] {
  perform Box::Put(1)
}
