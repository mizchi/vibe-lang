// #4049 (Codex on #4057): the accumulator starts as `mine`, declared in
// `region r`, but the callback returns `sink`, declared before `r`: from the
// second element on, the push stores `r`'s value in `sink`.
fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    region s {
      let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
        Array::push(acc, value = cell)
        sink
      })
      1
    }
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
