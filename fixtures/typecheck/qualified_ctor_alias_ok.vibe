// #2830 (ADR-0096): a type ALIAS qualifies a constructor just as the enum's
// own name does. One of the shapes the issue asks to re-measure, and the
// control that keeps `qualified_ctor_option_reject` from reading as "no
// qualifier resolves".
enum Color {
  Red;
  Green
}

type Alias = Color

fn main() -> Int {
  match Alias::Red {
    Color::Red => 1,
    Color::Green => 2
  }
}
