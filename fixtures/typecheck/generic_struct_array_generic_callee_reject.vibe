//# #3326: the generic-callee side of generic_struct_array_let_reject.vibe.
//
// `get`'s parameter `Cell[T]` is not fully concrete, so a check that asked
// for concrete arguments before trusting the head would let `get([7])`
// through. The HEAD `Cell` is certain whatever `T` becomes: no instantiation
// of `T` makes an `Array[Int]` into a `Cell[T]`.

struct Cell[T] {
  value: T
}

fn get[T](c: Cell[T]) -> T {
  c.value
}

fn main() -> Unit allows Console {
  println(__to_string(get([7])))
}
