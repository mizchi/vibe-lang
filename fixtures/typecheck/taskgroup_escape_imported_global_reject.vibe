// #3360 (Codex on #3467): `remember` stores the handle in a module array.
// A same-named fresh local inside one of its closures made the push read as
// a write into that local, so it published no summary and the call compiled.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_imported_global_dep_ok.vibe { remember }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    remember(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
