// ADR-0120 Phase 4 controls: what stays positional.
fn negate(_ n: Int) -> Int {
  0 - n
}

fn apply(f: (Int, Int) -> Int, x: Int) -> Int {
  // A call through a parameter (a value) is positional.
  f(x, 1)
}

fn main() -> Int {
  // A local lambda keeps positional calls (labels are optional there).
  let local = (a: Int, b: Int) -> Int {
    a - b
  }
  // A `_` parameter takes a positional argument; a pipe fills it.
  let n = negate(4) + (5 |> negate)
  local(10, 3) + n + apply(f = local, x = 2) + Array::get([7], at = 0)
}
