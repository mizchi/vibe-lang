// #3518 review: `T` occurs as `Option[() -> Int with Log]` and as
// `Option[() -> Int with Tick]`. Neither covers the other, and a union of a
// top-level function row could not reach below the `Option`, so `T` fell back
// to the stripped `Option[() -> Int]`. The rows are joined through the
// container, so `T` is `Option[() -> Int with Log + Tick]` and the pure
// annotation is refused.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn ticked() -> Int with Tick {
  perform Tick::Bump()
  2
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let x: Option[() -> Int] = second(() -> (Some(logged), Some(ticked)))
  0
}
