// #3042: `compare` answers the prelude `Ordering`, not an `Int`, so a match
// over its result is checked for exhaustiveness. With the old -1 / 0 / 1
// result this program compiled and fell through on two equal points.

struct Point { x: Int; y: Int } derive (Ord)

fn describe(a: Point, b: Point) -> String {
  match Point::compare(a, b) {
    Less => "before",
    Greater => "after"
  }
}

fn main() -> Unit {
  let _ = describe(Point::{ x: 1, y: 2 }, Point::{ x: 1, y: 2 })
}
