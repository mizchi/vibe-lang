//# #3026 control (Codex review on #3035): a spelled name that is a FORMAL is
//# not a type, so this module's `struct G` / `struct A` collide with nothing.
//# `read_g`'s row names its own constructor formal (`with Read[G]` under
//# `fn read_g[G[_]]()`), and `hold`'s `Holder[Pair]` carries the alias
//# constructor for `type Pair[A, B]`, whose binders `A` / `B` are metadata.
import ./foreign_type_name_dep.vibe { read_g, hold }

struct G {
  v: Int
}

struct A {
  v: Int
}

fn main() -> Unit {
  let _ = hold()
  let _ = G::{ v: 1 }
  let _ = A::{ v: 1 }
}
