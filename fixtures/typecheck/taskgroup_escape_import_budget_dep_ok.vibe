// #3360 (Codex on #3473): more than `retention_summary_budget` (256) private
// companions whose arguments may carry a region, beside one exported helper
// that keeps its argument. A private companion is not published, so it does
// not count against the budget, and the exported helper is still summarized.
struct Hidden {
  n: Int
}

