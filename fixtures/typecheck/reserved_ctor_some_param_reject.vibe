// #3086: `Some` is the built-in Option constructor, and every `Some` in an
// expression resolves to it in the checker. A function parameter named `Some` is refused
// at its own token, with the rename named, instead of being silently ignored.
struct B {
  v: Bool
}

fn apply(Some: (Bool) -> B) -> Unit {
  let _ = Some(false)
}

fn main() -> Unit {
  apply((x: Bool) -> B::{ v: x })
}
