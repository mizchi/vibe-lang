// #3542: a builtin operation imported under an ALIAS must keep its signature.
// The alias was bound to the publication's unknown marker, so this binding
// checked clean and the Double was read as a String at run time.
import @vibe/builtin {
  Double::floor as floor
}

fn main {
  let s: String = floor(2.5)
  let _t = s
  ()
}
