// #3360 controls: an imported helper that keeps nothing still takes the
// token, and one that keeps a parameter still takes a value with no region in
// it, or the token at a position it does not keep.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_helper_dep_ok.vibe { Cell, count, peek, put }

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let ints: Cell[Int] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let seen = peek(c, h)
    let k = count([h])
    put(ints, 7)
    let inner: Cell[TaskHandle[Int]] = Cell::{ v: None }
    put(inner, h)
    let v = TaskHandle::join(h)
    if seen {
      v + k
    } else {
      v
    }
  })
  println("r=\{r}")
}
