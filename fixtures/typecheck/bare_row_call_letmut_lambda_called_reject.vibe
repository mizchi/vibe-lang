// #3408: a `let mut` lambda that `mid` calls runs in `mid`, so `mid`
// requires `mk`'s `Box[Int]` and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mut cb = () -> 0
  cb = () -> mk()
  cb()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
