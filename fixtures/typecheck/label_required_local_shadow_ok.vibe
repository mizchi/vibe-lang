// ADR-0120 Phase 4a (Codex on #3881): a local lambda that shadows a
// declaration is a value, so its call stays positional -- even when its
// parameter names match the declaration's.
fn f(x: Int) -> Int {
  x
}

fn main() -> Int {
  let f = (x: Int) -> Int { x + 1 }
  f(1) + g()
}

fn g() -> Int {
  f(x = 1)
}
