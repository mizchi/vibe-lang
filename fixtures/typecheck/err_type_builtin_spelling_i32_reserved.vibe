//# #3727: `i32` stays reserved after it stopped being a type.
//#
//# A declaration named `i32` would quietly give the old alias a new meaning in
//# every annotation that still says `i32`, so it is refused (stable-surface
//# §5 reserves the lowercase builtin spellings).
struct i32 {
  value: Int
}

export fn main() -> Int {
  0
}
