// #3340: the imported callback's inferred payload is part of its contract.
import ./generic_effect_row_bare_review_dep_ok.vibe {
  effect Box, put_int_alias
}

fn run_str(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s)) }
}

fn producer() -> Int with Box {
  run_str(put_int_alias)
}
