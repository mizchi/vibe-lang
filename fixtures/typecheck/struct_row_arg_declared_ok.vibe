// #3589: the accepted side of `struct_row_arg_*_reject`: callers that declare
// what the stored function performs, a pure function stored and called from
// a pure caller, a `Holder[e]` forwarded by a signature that declares `e`, two
// calls instantiating `e` differently, and a callback stored by a signature
// that declares its row.
struct Holder[r] {
  run: () -> Int with r
}

fn early() -> Int with Console {
  call_holder(Holder::{ run: noisy })
}

fn noisy() -> Int with Console {
  println("noisy")
  1
}

fn reads() -> Int with Env {
  String::length(Env::get("STRUCT_ROW_ARG_UNSET"))
}

fn pure_one() -> Int {
  1
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn outer[e](h: Holder[e]) -> Int with e {
  call_holder(h) + (h.run)()
}

fn pure_caller() -> Int {
  let h = Holder::{ run: pure_one }
  call_holder(Holder::{ run: pure_one }) + call_holder(h) + outer(h) + (h.run)()
}

fn loud() -> Int with Console {
  let h = Holder::{ run: noisy }
  call_holder(h) + outer(Holder::{ run: noisy })
}

fn both() -> Int with Console + Env {
  call_holder(Holder::{ run: noisy }) + call_holder(Holder::{ run: reads })
}

fn wrap(f: () -> Int with e) -> Int with e {
  call_holder(Holder::{ run: f })
}

fn wrapped() -> Int with Console {
  wrap(noisy)
}

fn main() -> Unit allows Console + Env {
  println("\{early()} \{pure_caller()} \{loud()} \{both()} \{wrapped()}")
}
