// #3488 (Codex on #3492): a helper that hands back its parameter through
// an explicit `return` aliases its argument, as a tail does.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn same(c: Cell) -> Cell {
  return c
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: same(outer) }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
