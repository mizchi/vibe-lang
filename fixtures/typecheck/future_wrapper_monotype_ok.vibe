// #3112: the accepted side of future_wrapper_monotype_reject.vibe. A wrapper
// whose future is resolved and awaited at one payload type checks clean.
struct Box[T] {
  f: Future[T]
}

fn read_it() -> Int with Async {
  let b = Box::{ f: Future::pending() }
  Future::resolve(b.f, 40)
  let n: Int = await(b.f)
  n + 2
}
