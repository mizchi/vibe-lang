// #3551 review: under `write: [X](Self, X)` a caller through the trait
// chooses `X` with no bound, and the witness dispatches to the one impl
// method. Its own `[Y: Render]` was dropped before the signatures were
// compared, so the impl was accepted, and `T::write(t, plain)` asked for a
// `Render` witness nobody supplies. Measured on 22c039be1 with an `Array`
// receiver: a clean check, then a module the wasm validator rejected.
trait Render {
  render(Self) -> String
}

trait W {
  write: [X](Self, X) -> String
}

struct Plain {
  a: Int
}

impl [E] W for Array[E] {
  write[Y: Render](self, x: Y) -> String {
    Y::render(x)
  }
}

fn via[T: W](t: T) -> String {
  T::write(t, Plain::{ a: 7 })
}

fn main allows Console {
  let xs: Array[Int] = [1]
  println(via(xs))
}
