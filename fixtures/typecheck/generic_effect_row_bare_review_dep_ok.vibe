// #3340: inferred bare-row payloads must survive a module boundary.
export effect Box[T] {
  Put(T) -> Int
}

export fn put_int() -> Int with Box {
  perform Box::Put(1)
}

export fn put_string() -> Int with Box {
  perform Box::Put("abc")
}

export let put_int_alias = put_int
export let put_string_alias = put_string
