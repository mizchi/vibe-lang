// #3488 control (Codex on #3492): an outer scalar copied into a record
// literal does not make the literal an outer location. The cell is fresh,
// so the handle stays inside the body.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell;
  tag: Int
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer_tag = 7
  let r = TaskGroup::run((n) -> {
    let w = Wrap::{ cell: Cell::{ v: None }, tag: outer_tag }
    put(w, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
