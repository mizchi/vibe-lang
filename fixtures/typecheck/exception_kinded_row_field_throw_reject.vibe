// #2964: a throw whose payload kind does not resolve (a field projection) is
// not covered by a row that promises only `Exception[IoErr]`.
enum IoErr {
  NotFound(String)
}

enum ParseErr {
  Eof
}

struct Holder {
  cause: ParseErr
}

fn g(h: Holder) -> Int with Exception[IoErr] {
  throw(h.cause)
}

fn main() -> Int {
  handle { g(Holder::{ cause: Eof }) } with { Exception[IoErr]::Throw(_) => 0 }
}
