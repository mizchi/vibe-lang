// #3601: a function whose row names `Exception[Int]`, passed to a parameter
// typed with the erased `with Exception` row: the kind is not carried at run
// time, and `run`'s callers read only its erased row (`len=14`).
fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn bad() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Unit allows Console {
  let r = handle {
    run(bad)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
