// ADR-0124 (#2656): the host provides an `extern effect`, so a program
// cannot handle it; a test binds a mock provider instead.
extern effect Kv {
  get(String) -> String
}

fn read_key(k: String) -> String with Kv {
  Kv::get(k)
}

fn local() -> String {
  handle {
    read_key(k = "a")
  } with { Kv::get(k) => resume(k) }
}
