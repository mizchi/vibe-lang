// #4050 control: a `match` binder over a region-local value may be written.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    match Some(inner) {
      Some(a) => Array::push(a, value = cell),
      None => ()
    }
    1
  }
  v * 10 + Array::length(outer)
}
