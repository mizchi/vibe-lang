// #3601 (Codex on #3605, found while measuring the row-variable case): a
// let-bound closure whose erased row lets an `Int` out, passed as a value to
// a parameter typed with the erased row, in a module with no NAMED function
// that lets a kind out. The value-flow check ran only when such a named
// function existed, so this compiled and the erased arm read the `Int` 8 as a
// `String` (`len=16`).
fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn main() -> Unit allows Console {
  let local = () -> Int with Exception {
    throw(8)
  }
  let k = handle {
    run(local)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{k}")
}
