// The handle sits inside a derived generic's instantiation, inside an
// `Option`: the derived renderer of `Outer` renders `Box`'s field `v` at
// `Map[String, Int]`, which printed `Outer { b: Some(Box { v: <address> }) }`.
struct Box[T] {
  v: T
} derive (Show)

struct Outer {
  b: Option[Box[Map[String, Int]]]
} derive (Show)

fn show_outer() -> String {
  let o = Outer::{ b: Some(Box::{ v: Map::from_pairs([("a", 1)]) }) }
  "o=\{o}"
}
