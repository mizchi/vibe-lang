// #3360 (Codex on #3467): a helper that stores its argument in a module
// array, beside a closure that declares a fresh local of the same name. The
// inner binding is local to the closure; the outer push is not.
import @vibe/concurrent { TaskHandle }

let seen: Array[TaskHandle[Int]] = []

export fn remember(h: TaskHandle[Int]) -> Unit {
  let count = () -> {
    let seen = [0]
    Array::push(seen, 1)
    Array::length(seen)
  }
  let _ = count()
  Array::push(seen, h)
}
