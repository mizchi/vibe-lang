// #3387 (Codex on #3407): a function written into a `mut` field typed
// `() -> Int` performs at the `Box[String]` in scope, as one stored by the
// struct literal does.
effect Box[T] {
  Put(T) -> Int
}
struct Holder { mut f: () -> Int }
fn caller() -> Int with Box[String] {
  let h = Holder::{ f: () -> Int { 0 } }
  h.f = () -> Int { perform Box::Put(12345) }
  let g = h.f
  g()
}
