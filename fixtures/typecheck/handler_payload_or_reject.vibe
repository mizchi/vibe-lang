// #3371: each alternative of an or-pattern arm is checked like an arm of its
// own, so the literal payload of the SECOND alternative is refused although
// the first one is `_`. Before, the arm compiled and trapped at run time.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn run() -> Int {
  handle {
    perform Pick::P(3)
  } with Pick {
    P(_) | Q(2) => resume(100)
  }
}
