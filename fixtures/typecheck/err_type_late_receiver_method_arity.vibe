//# #4037: `c` is an unannotated parameter of the lambda handed to
//# `Array::fold`, so it is still an unsolved variable when `c.size(..)` is
//# checked; the fold unifies it with `Counter` only afterwards. The call named
//# no `T::method` then, and its arguments were compared with nothing: this
//# checked clean and the build failed with `unknown struct field: size`. The
//# call is now judged once `c` resolves, as `(acc, c: Counter)` is.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }, Counter::{ n: 2 }]
  Array::fold(xs, init = 0, f = (acc, c) -> acc + c.size(99, "x"))
}
