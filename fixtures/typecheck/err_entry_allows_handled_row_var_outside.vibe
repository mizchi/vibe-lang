// ADR-0124 decision 3 (#2656), r12: a row variable instantiated with `Db` by
// a named function, called outside every handler, is refused at the call.
effect Db {
  Get(Int) -> Int
}

fn get1() -> Int with Db {
  perform Db::Get(1)
}

fn run[e](g: () -> Int with e) -> Int with e {
  g()
}

fn main allows Console + Db {
  let a = run(g = get1)
  let v = handle {
    get1()
  } with {
    Db::Get(n) => resume(n)
  }
  println("\{a} \{v}")
}
