//# #2807, second spelling: an INSTANTIATED generic enum resolves to
//# `CtNamed(name, args)`, not to the bare `CtEnum(name)`, so it reached a
//# different checker arm and was tolerated there too. Measured before the fix:
//# this compiled clean and answered `7`.
struct Holder {
  payload: Int
}

enum Wrap[T] {
  Nothing;
  Just(T)
}

export fn main() -> Int {
  let w: Wrap[Int] = Just(7)
  w.payload
}
