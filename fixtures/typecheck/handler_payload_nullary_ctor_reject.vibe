// #3371: an uppercase name in a payload position is a constructor pattern,
// not a binder, even when it is the only variant. It is refused like any
// other constructor; bind a lowercase name instead.
enum Only {
  One
}

effect Use {
  It(Only) -> Int
}

fn run() -> Int {
  handle {
    perform Use::It(Only::One)
  } with {
    Use::It(One) => resume(1)
  }
}
