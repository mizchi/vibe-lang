// #3472: `direct` declares a row on the closure it returns, so its caller
// calls that closure with the handler. The closure comes from a call to
// `pure_factory`, whose declared result has no row, so it takes no handler
// argument -- measured, `drive(direct())` trapped with `null function or
// function signature mismatch`. The build refuses it with the edit (declare
// the row on `pure_factory`'s result); that edit, applied, is in
// fixtures/callback_row_slot_edits_test.vibe.
effect Box[T] {
  Put(T) -> Int
}

fn drive(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with {
    Box::Put(n) => resume(n + 1)
  }
}

fn pure_factory() -> (() -> Int) {
  () -> 8
}

fn direct() -> (() -> Int with Box[Int]) {
  pure_factory()
}

fn put_one() -> Int with Box[Int] {
  perform Box::Put(1)
}

fn main() -> Unit allows Console {
  println("\{drive(direct())} \{drive(() -> put_one())}")
}
