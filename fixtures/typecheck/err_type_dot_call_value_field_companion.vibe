// #3896: `s.size()` on a struct whose field `size` holds a value calls that
// field, which lowering did and which trapped ("null function"), while the
// checker typed the call as the companion. It is refused at the call; reading
// the field and calling `S::size(s)` stay legal.
struct S {
  size: Int
}

fn S::size(_ s: S) -> Int {
  s.size * 10
}

fn main() -> Unit {
  let s = S::{ size: 3 }
  let a = s.size
  let b = S::size(s)
  let c = s.size()
  ()
}
