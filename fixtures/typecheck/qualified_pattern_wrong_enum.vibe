// #1455 step 3: `Shape::Red` parses to the same PCtor("Red") the bare
// spelling does, so nothing downstream can catch the swapped qualifier —
// the parser's side channel plus the checker's enum table have to.
enum Color { Red; Green }

enum Shape { Circle(Int) }

fn describe(c: Color) -> String {
  match c {
    Shape::Red => "red"
    Green => "green"
  }
}
