// #3275 follow-up (Codex on #3315): the row-item check walks a function's own
// row, not a lambda nested in its body, so the checker reports a wrong-kinded
// row while binding it. A first cut of the kinded row arm left `F` fresh for
// an argument it could not bind, and this lambda checked clean.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

fn outer() -> Int {
  let inner = () -> Int with Read[Int] {
    perform Read::Put(Some(1))
  }
  0
}
