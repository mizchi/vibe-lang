// #3488 (Codex on #3492): a helper chain longer than the old cutoff of 8
// still hands its parameter back.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap0(c: Cell) -> Wrap {
  Wrap::{ cell: c }
}

fn wrap1(c: Cell) -> Wrap {
  wrap0(c)
}

fn wrap2(c: Cell) -> Wrap {
  wrap1(c)
}

fn wrap3(c: Cell) -> Wrap {
  wrap2(c)
}

fn wrap4(c: Cell) -> Wrap {
  wrap3(c)
}

fn wrap5(c: Cell) -> Wrap {
  wrap4(c)
}

fn wrap6(c: Cell) -> Wrap {
  wrap5(c)
}

fn wrap7(c: Cell) -> Wrap {
  wrap6(c)
}

fn wrap8(c: Cell) -> Wrap {
  wrap7(c)
}

fn wrap9(c: Cell) -> Wrap {
  wrap8(c)
}

fn wrap10(c: Cell) -> Wrap {
  wrap9(c)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap10(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
