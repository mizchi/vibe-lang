// #3601: a closure literal stored in a field typed with the erased
// `with Exception` row throws an `Int`, which a call through the field
// carried as a message (`len=14`).
struct Job {
  f: () -> Int with Exception
}

fn main() -> Unit allows Console {
  let j = Job::{ f: () -> throw(7) }
  let r = handle {
    let g = j.f
    g()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
