// #1525: a block-local `enum` used to be discarded and replaced by one
// `let <Variant> = <index>` per nullary variant. That left no constructors, so
// `match c { Red|Green => 1, _ => 3 }` matched NOTHING -- every value silently
// took the `_` arm (and trapped when there was none). Measured before the fix:
// `1 1 3` at top level vs `3 3 3` for the same enum declared in a block.
//
// The local form never had constructor semantics, so it is rejected outright
// rather than half-working.
export let v: () -> Int = () -> {
  enum Color {
    Red;
    Green;
    Blue
  }
  let c = Green
  match c {
    Red|Green => 1,
    _ => 3
  }
}
