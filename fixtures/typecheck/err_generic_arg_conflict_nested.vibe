// #3590: the conflicting argument nested inside an `Option`.
struct Pair[A, B] {
  a: A
  b: B
}

fn conv[x](h: Option[Pair[x, Int]]) -> Option[Pair[x, String]] {
  h
}

fn main() -> Unit allows Console {
  match conv(Some(Pair::{ a: 1, b: 7 })) {
    Some(p) => println("len=\{String::length(p.b)}"),
    None => println("none")
  }
}
