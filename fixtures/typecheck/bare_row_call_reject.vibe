// #3408: `mk`'s bare `with Box` leaves the payload to its body, which fixes
// it at `Int`. A caller whose row is `Box[String]` does not cover that. This
// checked clean, and the handler's `String::length` of the `Int` answered
// 24690.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn caller() -> Int with Box[String] {
  mk()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
