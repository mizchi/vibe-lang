// Codex on #3021: a throw whose kind the row grammar cannot spell (a tuple)
// is reported with the erased spelling, so the hint parses -- it used to
// suggest `with Exception[(Int, Int)]`, which is a parse error.
fn f() -> Int {
  throw((1, 2))
}

fn main() -> Int {
  handle { f() } with { Exception::Throw(_) => 0 }
}
