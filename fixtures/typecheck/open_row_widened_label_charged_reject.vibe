// #3575: a callback with fewer of the slot's concrete labels and one it does
// not name (`with Tick` given to `with Log + e`) widens `e` to `Tick`, which
// the caller is charged; a caller that declares only `Log` is refused.
effect Log {
  Emit(String) -> Unit
}

effect Tick {
  Step(Int) -> Int
}

fn call(f: () -> Int with Log + e) -> Int with Log + e {
  f()
}

fn ticks() -> Int with Tick {
  perform Tick::Step(10)
}

fn only_log() -> Int with Log {
  call(ticks)
}
