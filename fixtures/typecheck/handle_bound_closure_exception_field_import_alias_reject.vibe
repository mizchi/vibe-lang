// #3596: a local alias of a builder imported from another module. `g`
// stands for `mk`, whose module published that the closure it returns in a
// field throws.
import ../modules/handle_bound_closure_field_dep.vibe {
  fallback, mk
}

fn main() -> Unit allows Console {
  let g = mk
  let b = handle {
    g()
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  println("\{f()}")
}
