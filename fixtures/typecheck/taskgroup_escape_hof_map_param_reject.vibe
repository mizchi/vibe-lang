// #3360: a closure handed to `Array::map` stores its parameter -- each task
// handle of the group -- into an outer array. The closure was checked before
// the call fixed its parameter's type, so the write saw a type variable and no
// region; this compiled, where the same write in `for h in hs` is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, () -> { 41 })]
    let _ = Array::map(hs, (h) -> {
      Array::push(outer, h)
      0
    })
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
