// #3411: a generic function's bare `with Box` row published no payload, so a
// caller's `with Box[String]` covered `mk(12345)` and the handler read the
// `Int` as a string.
effect Box[T] {
  Put(T) -> Int
}

fn mk[T](x: T) -> Int with Box {
  perform Box::Put(x)
}

fn caller() -> Int with Box[String] {
  mk(12345)
}
