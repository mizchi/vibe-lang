// An `Array::map` callback over an `Array[Int32]` is handed no result type, so
// an early `return` in it would be checked against nothing. Its parameter is
// then not given the element type, and the callback is refused rather than
// returning 2147483648 as an `Int32`.
fn f(xs: Array[Int32]) -> Array[Int32] {
  Array::map(xs, f = (k) -> {
    if k == 0 {
      return 2147483648
    }
    k
  })
}
