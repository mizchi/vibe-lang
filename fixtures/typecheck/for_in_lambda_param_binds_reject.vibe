//# #3148: an unannotated lambda parameter used as a `for` iterand is bound to
//# `Array[_]`, so a Map argument is a type error at the call. It stayed open,
//# the loop read the map as an Array, and this answered 0 for a two-entry map.
export fn main() -> Int {
  let count = (c) -> {
    let mut n = 0
    for x in c {
      n = n + 1
    }
    n
  }
  let m: StringMap[Int] = Map::set(Map::set(Map::new(), "a", 1), "b", 2)
  count(m)
}
