// #4091 (Codex on #4106): a helper that copies a scalar FIELD of a
// module-level record (`state.tag`) into a fresh record returns no module
// storage: the projection's type is `Int`. `main` answers the block's value.

struct State {
  tag: Int;
  items: Array[MutList[Int]]
}

let state: State = State::{ tag: 7, items: [] }

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn make_box() -> Box {
  Box::{ tag: state.tag, items: [] }
}

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let b = make_box()
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  v
}
