// #3609: without an annotation, a generic constructor's payload is typed by
// the argument itself, so `bad` there keeps its erased `with Exception` row,
// which carries only messages. An erased arm would read its `Int` payload as
// a `String`, so `bad` is refused there.
fn bad() -> Int with Exception {
  throw(7)
}

enum Wrap[T] {
  W(T)
}

fn main() -> Unit allows Console {
  let w = W(bad)
  let r = match w {
    W(f) => handle {
      f()
    } with { Exception::Throw(m) => String::length(m) }
  }
  println("len=\{r}")
}
