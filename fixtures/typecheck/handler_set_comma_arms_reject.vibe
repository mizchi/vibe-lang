// #3072: handler-set arms separated by `,` are refused AT THE COMMA, not at
// the enclosing `fn`'s first line, and the message names the separator the
// grammar accepts.
effect Ask {
  Get() -> Int
  Put(Int) -> Unit
}

fn run() -> Int {
  let x = 1
  handle {
    perform Ask::Get() + x
  } with {
    Ask::Get() => resume(41), Ask::Put(_) => resume(())
  }
}
