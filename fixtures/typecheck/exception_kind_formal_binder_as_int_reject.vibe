// #2985 review (Codex P0): a kind that names a FORMAL of the enclosing
// declaration binds the payload at that formal's type variable, not at a
// rigid name. It used to resolve to `CtNamed("T")`, which `check_assignable`
// tolerates as an un-instantiated formal, so `let n: Int = Array::get(e, 0)`
// checked nothing and `catch_first("abc")` compiled and printed a pointer.
// Now the binder's element IS the function's `T`, so the annotation pins `T`
// to Int the way a body-level `let y: T = 42` does (#2130), and the String
// call site is refused.
fn raise_one[T](x: T) -> Int with Exception[Array[T]] {
  throw([x])
}

fn catch_first[T](x: T) -> Int {
  handle {
    raise_one(x)
  } with { Exception[Array[T]]::Throw(e) => {
    let n: Int = Array::get(e, 0)
    n
  } }
}

fn main() -> Int {
  catch_first("abc")
}
