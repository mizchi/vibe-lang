// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. `fac.mk()` performs `Ask` and returns a closure without the
// row, which inherited this call's -- the handle's. Reached as a method, the
// callee's type is the one the checker recorded at the call. `g()` answered
// `6` from the dead handler after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

struct Factory {
  k: Int
}

fn Factory::mk(self: Factory) -> (() -> Int) with Ask {
  () -> perform Ask::Get() + self.k
}

fn main() -> Unit allows Console {
  let fac = Factory::{ k: 1 }
  let g = handle {
    fac.mk()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
