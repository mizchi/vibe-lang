// #3637: the prelude's `num_add` stays refused at `Double`, with the
// concrete-type edit named. `+` on an erased `T` joins Strings and otherwise
// adds the raw representation, so `1.5 + 2.25` through the bound would add two
// boxes. Write `a + b` at the concrete type.

import @vibe/builtin { num_add }

fn main() -> Unit allows Console {
  println("\{num_add(1.5, 2.25)}")
}
