// #3621: a row-free closure literal bound by `let` takes a row-typed
// parameter's row at its binding only when every use of its name is such a
// parameter (#3424). Passed through a local alias (`let a = g`), the alias's
// binding is a use of `g` the compiler cannot give the row, so `g` kept the
// row-free calling convention while `drive` passed the handler (`tick`
// performs `Box`), and the call trapped ("indirect call type mismatch")
// after a clean `vibe check`. The build is refused with the edit; `g` passed
// by its own name answers (fixtures/named_fn_row_slot_test.vibe).
effect Box[T] {
  Put(T) -> Unit
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let a = g
  drive(a) + drive(tick)
}
