//# ADR-0122 (#3728): `Float64` is refused as a declaration name at any arity.
//# The parser reads it as `Double` in every type position, an applied head
//# (`Float64[Int]`) included, so even a generic `struct Float64[T]` could never
//# be named.
struct Float64[T] {
  value: T
}

export fn main() -> Int {
  0
}
