// #3408 (Codex on #3409): the argument to `run` is an `if` whose result is a
// lambda. `run` handles the `Box` its callback parameter names, so the
// lambdas are read under it, as an inline lambda argument is, and `mid` does
// not take `mk`'s `Box[Int]`. Accepted on main; refused by an earlier
// revision of this change.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn run(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
fn mid(c: Bool) -> Int with Box {
  run(if c {
    () -> mk()
  } else {
    () -> mk()
  })
}
fn top() -> Int with Box[String] {
  mid(true)
}
