// Codex on #3995: a local chain that doubles through an IMPORTED alias,
// `A1[T] = Dup[A0[T]]` .. `A24`. The size estimate for the canonical-key
// definitions counted only local aliases, so `A24` passed it and resolving
// the chain built a body of tens of millions of nodes before the checker's
// alias preflight could refuse the source. Imported aliases count too.
import ./trait_ref_alias_dup_dep_ok.vibe {
  Dup
}

type A0[T] = T

type A1[T] = Dup[A0[T]]

type A2[T] = Dup[A1[T]]

type A3[T] = Dup[A2[T]]

type A4[T] = Dup[A3[T]]

type A5[T] = Dup[A4[T]]

type A6[T] = Dup[A5[T]]

type A7[T] = Dup[A6[T]]

type A8[T] = Dup[A7[T]]

type A9[T] = Dup[A8[T]]

type A10[T] = Dup[A9[T]]

type A11[T] = Dup[A10[T]]

type A12[T] = Dup[A11[T]]

type A13[T] = Dup[A12[T]]

type A14[T] = Dup[A13[T]]

type A15[T] = Dup[A14[T]]

type A16[T] = Dup[A15[T]]

type A17[T] = Dup[A16[T]]

type A18[T] = Dup[A17[T]]

type A19[T] = Dup[A18[T]]

type A20[T] = Dup[A19[T]]

type A21[T] = Dup[A20[T]]

type A22[T] = Dup[A21[T]]

type A23[T] = Dup[A22[T]]

type A24[T] = Dup[A23[T]]

trait Mark[X] {}

struct Note {
  n: Int
}

impl Mark[Int] for Note {}

fn main allows Console {
  println("unreachable")
}
