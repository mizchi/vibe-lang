// #3518 review: `T` is fixed to `record { cb: Option[?u] }` by the first
// argument, and the retry meets `?u` inside that record's field against
// `Some(logged)`. The occurrence walk did not descend into record fields, so
// `?u` went unreached and, holding a function, the call was refused as having
// no single type. Fields are paired by name and walked, so `?u` is bound
// from the unstripped `() -> Int with Log` and the call is accepted.
effect Log {
  Emit(Int) -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn two[T, e](a: T, mk: () -> T with Exception + e) -> T with Exception + e {
  mk()
}

fn main() -> Int allows Exception {
  let r = two(record { cb: None }, () -> { record { cb: Some(logged) } })
  0
}
