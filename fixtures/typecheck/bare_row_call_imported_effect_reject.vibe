// #3408 (Codex on #3409): the generic effect is imported, and the chain
// through `mid` still fixes `Box` at `Int`.
import ./bare_row_call_imported_dep_ok.vibe { effect Box }
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  mk()
}
fn top() -> Int with Box[String] {
  mid()
}
