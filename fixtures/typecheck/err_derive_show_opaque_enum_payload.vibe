// An enum payload holding an `ArrayBuilder` reaches the derived renderer as
// an address, the same as a struct field.
enum Acc {
  Building(ArrayBuilder[Int])
  Done
} derive (Show)

fn show_acc() -> String {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, 1)
  let a = Acc::Building(b)
  "a=\{a}"
}
