// #3538: a trait method generic over its OWN type parameter
// (`write: [X](Self, X) -> X`) lets a caller through the trait choose `X`,
// and the witness dispatches to the one impl method. Written for `x: Int`,
// it was accepted, and a call with `X = String` handed it a string:
// `x + self.k` printed `hello` followed by two NUL bytes.
trait W {
  write: [X](Self, X) -> X
}

struct P {
  k: Int
}

impl W for P {
  write(self, x: Int) -> Int {
    x + self.k
  }
}

fn via[T: W](t: T, s: String) -> String {
  T::write(t, s)
}

fn main allows Console {
  println(via(P::{ k: 1 }, "hello"))
}
