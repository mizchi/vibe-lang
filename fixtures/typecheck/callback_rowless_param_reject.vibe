// #3387: `apply`'s parameter names no `Box`, so the lambda passed to it
// performs at the `Box[String]` of the function it is written in. This
// checked clean, and the handler's `String::length` of the `Int` answered
// 24690.
effect Box[T] {
  Put(T) -> Int
}
fn apply(f: () -> Int) -> Int {
  f()
}
fn caller() -> Int with Box[String] {
  apply(() -> {
    perform Box::Put(12345)
  })
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
