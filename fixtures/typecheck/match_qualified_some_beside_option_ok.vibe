// #3422: `Maybe::Some(n)` keeps its owner in the pattern, so a bare `Some(n)`
// on an `Option` elsewhere in the program is the builtin and is accepted. It
// was refused program-wide (#3420) because the qualifier was dropped.
enum Maybe {
  Some(Int);
  Nothing
}

fn g(m: Maybe) -> Int {
  match m {
    Maybe::Some(n) => n,
    Maybe::Nothing => 0
  }
}

fn h(o: Option[Int]) -> Int {
  match o {
    Some(n) => n,
    None => 0
  }
}

fn main() -> Unit {
  let _ = g(Maybe::Some(3)) + h(Some(4))
}
