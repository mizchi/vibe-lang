// #4050: a MutList of an enclosing region, reached through a loop variable,
// is a location the inner region's value must not be stored in.
fn main() -> Unit allows Exception + Console {
  let v = region r0 {
    let ml = MutList::empty(r0)
    let boxes = [ml]
    let w = region r {
      let cell = MutList::empty(r)
      MutList::push(cell, 3)
      for a in boxes {
        MutList::push(a, cell)
      }
      1
    }
    w + MutList::length(ml)
  }
  println("v=\{v}")
}
