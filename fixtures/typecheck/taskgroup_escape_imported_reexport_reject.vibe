// #3360: a helper reached through a re-export, renamed on the way, keeps
// what it kept where it was written.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_facade_dep_ok.vibe { Cell, store }

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    store(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
