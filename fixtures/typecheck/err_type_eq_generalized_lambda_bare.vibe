//# #3297: the bare spelling of the same comparison. `same` is generic in the
//# type of `a` and `b`, and the one lowered body compares them with the raw
//# `==`, which is content equality for an `Int` or a `String` but reference
//# identity for an aggregate. Measured before the refusal, `same([1, 2],
//# [1, 2])` answered `false` while `same(1, 1)` answered `true` -- the answer
//# depended on the caller, which is the case #2474 refuses for a declared
//# type parameter.
export fn main() -> Int {
  let same = (a, b) -> a == b
  if same([1, 2], [1, 2]) && same(1, 1) {
    1
  } else {
    0
  }
}
