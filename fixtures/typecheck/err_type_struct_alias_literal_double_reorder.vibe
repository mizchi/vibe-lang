// #3837: two reorderings cancel in the checker's expansion (`Undo[A, B]` is
// `Pair[A, B]`), but `Undo`'s written target reorders, so lowering has no
// name to rename the literal to and would lay it out by its field set alone.
struct Pair[A, B] {
  a: A;
  b: B
}

type Rev[A, B] = Pair[B, A]

type Undo[A, B] = Rev[B, A]

fn main() -> Unit {
  let u = Undo::{ a: 1, b: 2 }
  ()
}
