// #3568 (Codex review on #3587): a callback stored inside a TUPLE field
// binds the struct's row formal like a bare function field does, so a call
// through `(h.run.0)()` charges `e`. Before the fix the literal left `r`
// unbound and `quiet` printed from a function declared pure.
struct Holder[r] {
  run: (() -> Int with r, Int)
}

fn wrap(f: () -> Int with e) -> Int {
  let h = Holder::{ run: (f, 0) }
  (h.run.0)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
