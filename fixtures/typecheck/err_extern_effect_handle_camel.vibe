// ADR-0124 (#2656): whatever its operations are spelled, the host provides an
// `extern effect`, so the program cannot handle it.
extern effect Kv {
  Fetch(String) -> String
}

fn read_key(k: String) -> String with Kv {
  Kv::Fetch(k)
}

fn local() -> String {
  handle {
    read_key(k = "a")
  } with { Kv::Fetch(k) => resume(k) }
}
