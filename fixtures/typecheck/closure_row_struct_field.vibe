// #1451 (struct-field position): a closure literal stored into a field whose
// declared type carries a row. The literal has no row of its own, so the perform
// used to be charged to `mk`, which only assembles the record and never performs.
effect Log {
  Emit(String) -> Unit
}

struct Box {
  run: (String) -> Unit with Log::Emit
}

fn mk() -> Box {
  Box::{
    run: (s) -> {
      perform Log::Emit(s)
    }
  }
}
