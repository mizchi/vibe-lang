// #3536: a generic head written bare in an enum payload resolved to a
// wildcard, so the payload of `H(["hello"])` was matched out as an
// `Array[Int]`.
enum Holder {
  H(Array)
}

fn main allows Console {
  let n = match H(["hello"]) {
    H(xs) => {
      let ys: Array[Int] = xs
      Array::get(ys, 0) + 1
    }
  }
  println("\{n}")
}
