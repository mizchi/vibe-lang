// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. Kept by a helper that pushes into an array declared outside the
// handle.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

fn keep(arr: Array[() -> Int], f: () -> Int) -> Unit {
  Array::push(arr, f)
}

fn main() -> Unit allows Console {
  let arr: Array[() -> Int] = []
  let _ = handle {
    keep(arr, () -> perform Ask::Get() + 1)
    0
  } with { Ask::Get() => resume(5) }
  let g = Array::get(arr, 0)
  println("g=\{g()}")
}
