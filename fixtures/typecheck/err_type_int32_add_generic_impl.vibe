// #3825 (Codex review on #3857): a generic impl's `Add`-bounded parameter at
// `Int32` is refused. The impl's witness is built for the erased `Int`, so
// doubling `2147483647` answered `4294967294` instead of wrapping to `-2`.
trait Twice {
  twice(Self) -> Self
}

struct Box[T] {
  v: T
}

impl [T: Add] Twice for Box[T] {
  twice(self: Box[T]) -> Box[T] {
    Box::{ v: self.v + self.v }
  }
}

fn f[U: Twice](x: U) -> U {
  U::twice(x)
}

fn main() -> Int {
  let top: Int32 = 2147483647
  let b: Box[Int32] = Box::{ v: top }
  Int32::to_int(f(b).v)
}
