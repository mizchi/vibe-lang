//# #3549: the `Some` payload is compared too. Measured before the refusal,
//# `Some(f) == Some(f)` answered `true` and `Some(f) == Some(g)` `false`. The
//# message names `is None` / `is Some(_)`, the presence test such a comparison
//# usually means.
export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let o: Option[(Int) -> Int] = Some(f)
  if o == Some(f) {
    1
  } else {
    0
  }
}
