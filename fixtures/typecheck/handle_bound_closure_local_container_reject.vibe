// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It is pushed into an array the handled body declares, and
// the array is the handle's value: the value lives on in the array, so it
// goes wherever the array goes.
effect Ask {
  Get() -> Int
}

fn main() -> Unit allows Console {
  let fs = handle {
    let xs: Array[() -> Int] = []
    Array::push(xs, () -> perform Ask::Get() + 1)
    xs
  } with { Ask::Get() => resume(5) }
  let g = Array::get(fs, 0)
  println("g=\{g()}")
}
