// #3589 (Codex review on #3594): a nested struct with a `mut` field under
// the row parameter is not covariant in it: a `Pair[Console, Env]` could
// store `home` in `c.run`, which `c`, a `Cell[Console]`, then runs. Its row
// argument must match exactly, so the literal is refused.
struct Cell[r] {
  mut run: () -> Int with r
}

struct Pair[r] {
  a: Cell[r]
  b: Cell[r]
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn home() -> Int with Env {
  if Env::get("HOME") == "" {
    2
  } else {
    3
  }
}

fn run_b[r](p: Pair[r]) -> Int with r {
  (p.b.run)()
}

fn both() -> Int with Console + Env {
  let c = Cell::{ run: say }
  let p = Pair::{ a: c, b: Cell::{ run: home } }
  run_b(p)
}

fn main() -> Unit allows Console + Env {
  println("\{both()}")
}
