// #3536: a generic head written bare in a struct field resolved to a
// wildcard, so an `Array[String]` stored in the field came back as an
// `Array[Int]` and `+ 1` read the string's pointer.
struct Box {
  xs: Array
}

fn main allows Console {
  let b = Box::{ xs: ["hello"] }
  let ys: Array[Int] = b.xs
  println("\{Array::get(ys, 0) + 1}")
}
