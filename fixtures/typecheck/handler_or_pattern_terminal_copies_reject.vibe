// A terminal inner arm must count its own alternatives: 2 * 129 = 258.
// Its body has no handler at which a delayed limit check could fire.

effect Outer {
  A -> Int
  B -> Int
}

effect Inner {
  Op0 -> Int
  Op1 -> Int
  Op2 -> Int
  Op3 -> Int
  Op4 -> Int
  Op5 -> Int
