fn main() -> Int {
  handle {
    perform Outer::A
  } with {
    Outer::A|Outer::B => {
      let value = handle {
        perform Inner::Op0
      } with {
        Inner::Op0|Inner::Op1|Inner::Op2|Inner::Op3|Inner::Op4|Inner::Op5|Inner::Op6|Inner::Op7|Inner::Op8|Inner::Op9|Inner::Op10|Inner::Op11|Inner::Op12|Inner::Op13|Inner::Op14|Inner::Op15|Inner::Op16|Inner::Op17|Inner::Op18|Inner::Op19|Inner::Op20|Inner::Op21|Inner::Op22|Inner::Op23|Inner::Op24|Inner::Op25|Inner::Op26|Inner::Op27|Inner::Op28|Inner::Op29|Inner::Op30|Inner::Op31|Inner::Op32|Inner::Op33|Inner::Op34|Inner::Op35|Inner::Op36|Inner::Op37|Inner::Op38|Inner::Op39|Inner::Op40|Inner::Op41|Inner::Op42|Inner::Op43|Inner::Op44|Inner::Op45|Inner::Op46|Inner::Op47|Inner::Op48|Inner::Op49|Inner::Op50|Inner::Op51|Inner::Op52|Inner::Op53|Inner::Op54|Inner::Op55|Inner::Op56|Inner::Op57|Inner::Op58|Inner::Op59|Inner::Op60|Inner::Op61|Inner::Op62|Inner::Op63|Inner::Op64|Inner::Op65|Inner::Op66|Inner::Op67|Inner::Op68|Inner::Op69|Inner::Op70|Inner::Op71|Inner::Op72|Inner::Op73|Inner::Op74|Inner::Op75|Inner::Op76|Inner::Op77|Inner::Op78|Inner::Op79|Inner::Op80|Inner::Op81|Inner::Op82|Inner::Op83|Inner::Op84|Inner::Op85|Inner::Op86|Inner::Op87|Inner::Op88|Inner::Op89|Inner::Op90|Inner::Op91|Inner::Op92|Inner::Op93|Inner::Op94|Inner::Op95|Inner::Op96|Inner::Op97|Inner::Op98|Inner::Op99|Inner::Op100|Inner::Op101|Inner::Op102|Inner::Op103|Inner::Op104|Inner::Op105|Inner::Op106|Inner::Op107|Inner::Op108|Inner::Op109|Inner::Op110|Inner::Op111|Inner::Op112|Inner::Op113|Inner::Op114|Inner::Op115|Inner::Op116|Inner::Op117|Inner::Op118|Inner::Op119|Inner::Op120|Inner::Op121|Inner::Op122|Inner::Op123|Inner::Op124|Inner::Op125|Inner::Op126|Inner::Op127|Inner::Op128 => resume(1)
      }
      resume(value)
    }
  }
}
