// #3518 review: the control for `retry_binding_hkt_effectful_payload_reject`.
// `T`, bound through `F[T]` against `Option[() -> Int with Log]`, keeps its
// `Log` row, so an annotation that names it is accepted. A walk that could
// not cross the `CtApplied` bridge refused this program as having no single
// type.
effect Log {
  Emit(Int) -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn give[F[_], T, e](f: () -> F[T] with Exception + e) -> F[T] with Exception + e {
  f()
}

fn main() -> Int allows Exception {
  let x: Option[() -> Int with Log] = give(() -> Some(logged))
  0
}
