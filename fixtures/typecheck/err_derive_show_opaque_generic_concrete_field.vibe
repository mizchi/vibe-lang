// A generic struct whose handle field does not mention the type parameter.
// The interpolation check reads only the type arguments a nominal's fields
// read (`Int` here), so `"\{p}"` was accepted and printed the handle.
struct Pair[T] {
  v: T
  m: StringMap[Int]
} derive (Show)

fn show_pair() -> String {
  let p: Pair[Int] = Pair::{ v: 1, m: Map::from_pairs([("a", 1)]) }
  "p=\{p}"
}
