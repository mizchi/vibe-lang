// #3036 (Codex on #3076): declares both a trait `Builds[E]` and an
// unrelated struct also named `Builds`; traits and types are separate
// declaration channels. `run`'s bound names the TRAIT.
import ./dup_type_a_dep_ok.vibe { Err }

export trait Builds[E] {
  build(Self) -> E
}

struct Builds {
  code: Int
}

export fn run[T: Builds[Err]](x: T) -> Int {
  T::build(x).code
}
