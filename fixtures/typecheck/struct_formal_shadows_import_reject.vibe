// #3138 review: a generic struct's formal spelled like an IMPORTED struct.
// The declared field type `T` reads as a bare name, and the check that types a
// struct literal as its struct (#3138) counted a field ground when its name
// resolved to a declaration -- so it found the imported `T`, typed
// `Box::{ value: 42 }` as the monomorphic `Box`, and dropped the
// instantiation. `b.value` then read as the imported struct and this binding
// checked clean over an `Int`. The struct's own formals are excluded now, so
// the literal is `Box[Int]` and the binding is refused. (The same shadowing
// within one file is refused outright by #2141.)
import ./struct_formal_shadows_import_dep_ok.vibe { T }

struct Box[T] {
  value: T
}

fn main() -> Unit allows Console {
  let b = Box::{ value: 42 }
  let t: T = b.value
  println("\{t.a}")
}
