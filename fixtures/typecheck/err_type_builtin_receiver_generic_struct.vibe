// #3475: a generic struct passed where a builtin expects a String. A
// non-generic struct was refused here; `Q[Int]` checked clean and printed a
// number read from the struct's pointer.
struct Q[T] { x: T }

fn main() -> Unit allows Console {
  let q: Q[Int] = Q::{ x: 1 }
  let a: Int = String::length(q)
  println("\{a}")
}
