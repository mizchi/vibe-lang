// #3611: the field `f` is declared `with Box[T]`, a row naming the struct's
// type parameter. The literal below writes no type arguments and is bound
// under no annotation, so the compiler cannot give the closure the
// instantiated row (`Box[String]`), while `drive` calls it with that handler:
// it would trap ("null function or function signature mismatch") after a
// clean `vibe check`. The build is refused with the edit; both edits answer in
// fixtures/closure_field_generic_row_test.vibe.
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[T] {
  f: () -> Int with Box[T]
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(_) => resume(())
  }
}

fn main() -> Int {
  let h = Holder::{ f: () -> {
    perform Box::Put("x")
    1
  } }
  drive(h.f)
}
