// #3311 (Codex on #3340): a field of a generic struct names the struct's
// type parameter in its row. The row is read in the struct's declaration, so
// `T` is the receiver's type argument: in a `GRunner[String]` the lambda
// performs `Box` at `String`, and `perform Box::Put(1)` is refused.
effect Box[T] {
  Put(T) -> Int
}

struct GRunner[T] {
  run: (() -> Int with Box[T]) -> Int
}

fn producer(r: GRunner[String]) -> Int with Box[String] {
  r.run(() -> {
    perform Box::Put(1)
  })
}
