// #3599: a builder reached only through a call's result names no
// declaration the check can read, so a closure in a declared type's field of
// what it returns is taken to throw what the handle catches. `pick(3)` hands
// back `mk`, whose `Box` holds a closure that inherited `mk`'s throw;
// returned as the handle's value, `f()` threw with no handler around it and
// trapped after `vibe check` was clean.
// fixtures/handle_bound_closure_unread_callee_test.vibe holds the accepted
// controls.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn pick(n: Int) -> () -> Box with Exception[Int] {
  mk
}

fn main() -> Unit allows Console {
  let g = pick(3)
  let b = handle {
    g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
