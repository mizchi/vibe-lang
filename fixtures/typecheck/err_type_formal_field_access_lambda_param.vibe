//# #2848 (Codex on #2864): the formal reached through an UNANNOTATED
//# parameter of a `let`-bound lambda. At the read `p` is a fresh inference
//# variable no `[T]` header recorded, so the immediate refusal cannot see a
//# formal. Nor can any later pass: `let f = ...` GENERALIZES `f`, `p` is
//# quantified, and `f(m)` instantiates a fresh copy -- the recorded variable
//# never resolves. Measured on the stage2 that carried the immediate refusal
//# alone: this compiled clean and answered `0`, the tagged integer read through
//# `Crate`'s offset. A quantified receiver is an implicit type parameter of
//# the binding, so the `let` refuses the read as it quantifies, naming the
//# parameter to annotate (`p: T` then meets the formal refusal; `p: Crate`
//# makes the read mean something).
struct Crate {
  payload: Int
}

fn read[T](m: T) -> Int {
  let f = (p) -> {
    p.payload
  }
  f(m)
}

export fn main() -> Int {
  read(7)
}
