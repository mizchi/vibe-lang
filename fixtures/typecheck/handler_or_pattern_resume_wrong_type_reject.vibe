// #3301: each alternative of an or-pattern handler arm is typed against its
// own operation. Before the fix the arm was never type-checked, so resuming
// an Int operation with a String compiled.
effect Logger {
  A -> Int
  B -> Int
}

fn main() -> Int {
  handle {
    perform Logger::A + perform Logger::B
  } with Logger {
    A|B => resume("seven")
  }
}
