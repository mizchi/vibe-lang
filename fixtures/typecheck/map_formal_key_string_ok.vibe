// #2334 control: a generic function that keys a map by its type parameter
// still compiles, and calling it with a `String` key is accepted -- the body's
// String key operations are the right ones there.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, key = k)
}

fn main {
  let m = Map::from_pairs([("a", 1)])
  let _ = look(m = m, k = "a")
  ()
}
