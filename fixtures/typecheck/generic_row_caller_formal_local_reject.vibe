// #3053: the caller's own formal `S` is not the callee's. `get("abc")`
// requires `State[String]`, and `with State[S]` promises one type the body
// does not choose, so it does not cover the call. This compiled, because the
// open spelling `State[S]` matched any `State[..]` by base name.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int with State[S] {
  get("abc")
}
