// #3102 review: importing the dependency's `Box` as `RemoteBox` does not stop
// this module's own `struct Box` from being a nominal type, so the call that
// requires `State[Box[S]]` is still not covered by `with State[S]`.
import ./generic_row_nominal_dep.vibe { State, get, Box as RemoteBox }

struct Box[T] {
  v: T
}

fn caller[S](x: S) -> Int with State[S] {
  get(Box::{ v: x })
}
