// #3102 review: a local `struct Box` next to the dependency's `Box` imported as
// `RemoteBox`. The module is refused before any row is read (#3036: two types
// spelled `Box` would be treated as one), so the effect-row judge never has
// to decide which `Box` a row names.
import ./generic_row_nominal_dep.vibe { State, get, Box as RemoteBox }

struct Box[T] {
  v: T
}

fn caller[S](x: S) -> Int with State[S] {
  get(Box::{ v: x })
}
