//# #3026 control (Codex review on #3035): `struct Cell[A] { value: A }` names
//# its own parameter `A`, so importing `Cell` into a module that declares an
//# `A` collides with nothing. (A dependency that ALSO declared a type `A` is
//# refused on its own side by #2141, so the payload walk never meets one.)
import ./foreign_type_name_dep.vibe { Cell }

struct A {
  v: Int
}

fn main() -> Unit {
  let c: Cell[Int] = Cell::{ value: 1 }
  let _ = c.value
  let _ = A::{ v: 1 }
}
