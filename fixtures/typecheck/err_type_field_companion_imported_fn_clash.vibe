// #3915: a companion declared beside an imported struct's field of the same
// name that holds a function is refused on every lane, as it is when the
// struct is declared in the same file (#3896). The FS lane and `vibe check`
// used to accept it while the gc lane refused it.
import ../_field_companion_imported_dep.vibe {
  G
}

fn G::get(_ g: G) -> Int {
  41
}

fn main() -> Unit {
  let g = G::{ get: () -> "field", size: 1 }
  let n: Int = G::get(g)
  ()
}
