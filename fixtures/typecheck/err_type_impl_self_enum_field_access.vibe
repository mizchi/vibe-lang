//# #2848 (Codex on #2864, round 2): an impl method's unannotated `self` is
//# resolved against the impl's RECORDED target type, whatever its kind. Here
//# the target is an enum, so the read meets the #2807 enum refusal -- the
//# same verdict `p.payload` on an annotated `p: Parcel` gets -- rather than
//# being judged against a struct fabricated from the owner's name (which has
//# no typedef and would have tolerated the read). `Crate` declares `payload`,
//# which is what codegen resolved the read against by spelling.
struct Crate {
  payload: Int
}

enum Parcel {
  Empty;
  Full(Int)
}

trait Weigh {
  weigh(Self) -> Int
}

impl Weigh for Parcel {
  weigh(self) -> Int {
    self.payload
  }
}

export fn main() -> Int {
  Parcel::weigh(Full(7))
}
