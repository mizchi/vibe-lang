// #1445 guard: a HAND-WRITTEN `T::to_string` is a Show renderer just as much as
// `derive(Show)` is, so it must keep compiling. Also pins the negative side of
// the new error: the check is "no renderer", not "no derive".
struct Q {
  x: Int
}

fn Q::to_string(v: Q) -> String {
  "Q!"
}

fn show_it() -> String {
  let q = Q::{
    x: 1
  }
  "\{q}"
}
