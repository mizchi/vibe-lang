// #3015: a function declared `with Exception[String]` whose body calls a
// callback typed `with Exception` (any kind) raises whatever the callback
// throws while promising only `String`. Callers trust the declared row, so a
// kinded `String` arm read an Int thrown through it.
fn relabel(f: () -> Int with Exception) -> Int with Exception[String] {
  f()
}

fn child_int() -> Int with Exception[Int] {
  throw(7)
}

export fn main() -> Int {
  handle {
    relabel(child_int)
  } with { Exception[String]::Throw(s) => String::length(s) }
}
