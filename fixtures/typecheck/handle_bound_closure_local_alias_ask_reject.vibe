// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It performs `Ask` through a local alias of a `with Ask`
// function (`let f = ask`). The evidence lowering refused this program too,
// but only with "its evidence migration is not fully eligible", which names
// neither the closure nor the edit.
effect Ask {
  Get() -> Int
}

fn ask() -> Int with Ask {
  perform Ask::Get()
}

fn main() -> Unit allows Console {
  let g = handle {
    let f = ask
    () -> f() + 1
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
