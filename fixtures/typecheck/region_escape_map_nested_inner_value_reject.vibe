// #4050 (Codex on #4057): `boxes` is declared inside `region r` and mapped
// inside a nested `region s`; storing `s`'s value in an element keeps it
// past `s`.
fn main() -> Unit allows Exception + Console {
  let v = region r {
    let outer: Array[MutList[Int]] = []
    let boxes = [outer]
    let got = region s {
      let cell = MutList::empty(s)
      MutList::push(cell, 3)
      let _ = Array::map(boxes, f = (a) -> {
        Array::push(a, value = cell)
        0
      })
      1
    }
    got + Array::length(outer)
  }
  println("v=\{v}")
}
