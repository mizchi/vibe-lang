// #3488 (Codex on #3492): a record bound in the body over a conditional
// that may be the outer cell keeps that cell's provenance.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn fwd(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let flag = true
  let r = TaskGroup::run((n) -> {
    let w = Wrap::{ cell: if flag { c } else { Cell::{ v: None } } }
    fwd(w, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
