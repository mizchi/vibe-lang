// #3995: an enclosing substitution can replace a constructor binder. Count
// the surviving binders exactly as the resolver does before applying its body.
type Pair[X] = (X, X)
type B0[V] = V
type B1[V] = Pair[B0[V]]
type B2[V] = Pair[B1[V]]
type B3[V] = Pair[B2[V]]
type B4[V] = Pair[B3[V]]
type B5[V] = Pair[B4[V]]
type B6[V] = Pair[B5[V]]
type B7[V] = Pair[B6[V]]
type B8[V] = Pair[B7[V]]
type B9[V] = Pair[B8[V]]
type B10[V] = Pair[B9[V]]
type B11[V] = Pair[B10[V]]
type B12[V] = Pair[B11[V]]
type Spread[T, U] = B12[U]
type Keep[F[_, _]] = F
type Captured[T] = Keep[Spread]
type Apply[F[_], X] = F[X]
type Big = Pair[Pair[Pair[Pair[Pair[Pair[Pair[Pair[Pair[Pair[Pair[Pair[Int]]]]]]]]]]]]
type Bad = Apply[Captured[Int], Big]
trait Mark[X] {
}
struct Note { n: Int }
impl Mark[Int] for Note {
}
fn main() -> Int {
  0
}
