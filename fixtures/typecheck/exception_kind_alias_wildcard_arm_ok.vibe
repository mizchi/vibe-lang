// #2983: a wildcard arm names its kind through an alias; `E` is `IoErr`, so
// the arm catches exactly what `risky` throws (Codex on #3061).
struct IoErr {
  code: Int
}

type E = IoErr

fn risky() -> Int with Exception[IoErr] {
  throw(IoErr::{ code: 1 })
}

fn caught() -> Int {
  handle {
    risky()
  } with {
    Exception[E]::Throw(_) => 0
  }
}
