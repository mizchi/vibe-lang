// Codex on #4078: a fold callback pushes a region list into `acc` and returns
// `get_sink()`, a function returning a module-level array. The accumulator is
// then that array, so the second push stores the list outside the region.
// 55e4d06d6 read a call's result as local and printed `kept=true`.
let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc, value = cell)
      get_sink()
    })
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
