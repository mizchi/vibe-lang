// #3619 control: a closure literal is charged nothing only when its callee
// keeps every exception it raises. `pass` lets its callback's exceptions out
// through its own erased row, so the `Int` thrown here would reach the erased
// arm in `main`, which reads the payload as a `String`. It stays refused.
fn pass(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn t() -> Int with Exception {
  pass(() -> throw(7))
}

fn main() -> Unit allows Console {
  let r = handle {
    t()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
