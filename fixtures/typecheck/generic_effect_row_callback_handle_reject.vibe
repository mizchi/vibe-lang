// #3311: the callback's performs belong to the parameter's `Box[String]`
// row, which `run_cb` handles, not to the `handle` around the call. Before,
// the lambda took the enclosing handle's instantiation, so `Box::Put(1)` fixed
// it at `Int` and checked clean.
effect Box[T] {
  Put(T) -> Int
}

fn run_cb(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(s) => resume(String::length(s))
  }
}

fn producer() -> Int {
  handle {
    run_cb(() -> {
      perform Box::Put(1)
    })
  } with {
    Box::Put(n) => resume(n)
  }
}
