// #3518 review: `T` occurs as a function taking a `Log` callback and as one
// taking a pure callback. A parameter is contravariant, so `T` is their MEET:
// a function taking a pure callback, which both values can be called as. An
// annotation that takes a pure callback is accepted; this was refused when
// parameter rows had to be equal (Codex on #3531).
effect Log {
  Emit(Int) -> Unit
}

fn run_logged(cb: () -> Int with Log) -> Int {
  0
}

fn run_pure(cb: () -> Int) -> Int {
  cb()
}

fn pair() -> ((() -> Int with Log) -> Int, (() -> Int) -> Int) {
  (run_logged, run_pure)
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let f: (() -> Int) -> Int = second(pair)
  0
}
