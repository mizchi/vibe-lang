// #3589: the row a literal stores travels with its binding: `h` is a
// `Holder[Console]` wherever it is passed.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn via_let() -> Int {
  let h = Holder::{ run: noisy }
  call_holder(h)
}

fn main() -> Unit allows Console {
  println("\{via_let()}")
}
