//# #3549: `==` on two closures. A function has no content to compare, so the
//# comparison could only answer by identity: measured before the refusal,
//# `f == f` answered `true` and `f == g` `false` for two closures with the
//# same body, after a clean check.
export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let g = (x: Int) -> x + 1
  if f == g {
    1
  } else {
    0
  }
}
