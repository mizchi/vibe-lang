// #3595: the `Console + e` callback stored in a `Holder[r]` field and called
// through it performs `Console` exactly as calling `f` would, so `m1`, which
// declares only `e`, is refused. Before the fix the pure `quiet` printed.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

fn m1(f: () -> Int with Console + e) -> Int with e {
  let h = Holder::{ run: f }
  (h.run)()
}

fn quiet() -> Int {
  m1(noisy)
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
