// #1464: a type error ANYWHERE inside a `throw(...)` payload. The suberror
// fixtures cover the constructor case; this one pins that the hole was not
// specific to suberror constructors -- an ordinary function call with the
// wrong arity was equally invisible, at any nesting depth.
fn f(a: String) -> Int {
  1
}

let g = () -> Unit with Error {
  throw(f(f("x", 1)))
}
