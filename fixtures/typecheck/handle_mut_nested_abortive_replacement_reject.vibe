effect Ask { Get() -> Int }

fn consume(x: Int) -> Int { x }

fn run() -> Int with Ask {
  let mut side = () -> Int { perform Ask::Get() }
  handle {
    consume(throw("x"))
    side = () -> Int { 7 }
    0
  } with { Exception::Throw(_) => 0 }
  handle { side() } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle { run() } with { Ask::Get() => resume(1) }
}
