// #3947 (Codex on #3956): a trait method binder spelled like a module-level
// alias is that binder. With `type T = Int`, the trait's `run[T, U: Value[T]]`
// lets a caller pick `T = String` and supply only a `Value[String]` witness,
// so an impl demanding `U: Value[Int]` must still be refused; the canonical
// comparison of bound keys must not expand the formal `T` to `Int`.
type T = Int

trait Value[A] {
  value(Self) -> A
}

trait Run {
  run[T, U: Value[T]](Self, T, U) -> Int
}

struct Runner {
  k: Int
}

impl Run for Runner {
  run[X, U: Value[Int]](self, x: X, u: U) -> Int {
    self.k + U::value(u)
  }
}

fn main allows Console {
  println("unreachable")
}
