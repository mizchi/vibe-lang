// #3605 review: a `let rec` closure literal with its own erased row throws an
// `Int`. The recursive binding was hidden instead of charged what the row
// lets out, so the erased arm read the `Int` 7 as a `String` (`len=14`).
fn main() -> Unit allows Console {
  let rec f = (n: Int) -> Int with Exception {
    if n > 0 {
      f(n - 1)
    } else {
      throw(7)
    }
  }
  let r = handle {
    f(2)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
