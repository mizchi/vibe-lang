// #3563: a call above the trailing `trait Base[A]` (so a forward reference to
// the `Conv::conv` wrapper) gets the same verdict as the same call below it:
// `P` implements only `Conv[String]`, so asking for an `Int` is a return type
// mismatch. Before the fix the hoisted bound kept the formal's name and the
// message was ``no impl `Conv[A]` for `P` ``.
trait Conv[A] {
  conv(Self) -> A
}

struct P { x: Int }

impl Conv[String] for P {
  conv(self) -> String {
    "P(\{self.x})"
  }
}

fn wrong() -> Int {
  Conv::conv(P::{ x: 3 })
}

trait Base[A] {
  get(Self) -> A
}
