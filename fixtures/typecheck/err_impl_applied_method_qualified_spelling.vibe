//# #3573: an applied impl (`impl It[Int] for P`) binds its methods under its
//# own key, since a second applied impl may define the same method for `P`,
//# so `P::pass` is unbound. The message names the spelling that reaches it.
trait It[A] {
  pass(Self, A) -> A
}

struct P {
  k: Int
}

impl It[Int] for P {
  pass(self: Self, a: Int) -> Int {
    a + self.k
  }
}

export fn main() -> Int {
  P::pass(P::{ k: 1 }, 2)
}
