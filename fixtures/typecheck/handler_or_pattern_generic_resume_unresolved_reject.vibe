// #3301 (Codex on #3337): when nothing instantiates a generic effect's
// operations, `X -> A` and `Y -> B` stay two unresolved types, and an
// or-pattern arm naming `resume` is refused rather than trusted to agree.
effect E[A, B] {
  X -> A
  Y -> B
}

fn main() -> Int {
  handle {
    let _a = perform E::X
    let _b = perform E::Y
    3
  } with E {
    X|Y => {
      let k = resume
      0
    }
  }
}
