// ADR-0124 decision 2 (#4082): an `extern effect` takes the optional grade.
// A provider bound at launch is the grant, so `perform? Greeter::greet(..)`
// answers `Granted` with one and `NotGranted` without, in the shape
// `perform? Fs::read_file(..)` answers for a standard provider. Run by
// scripts/test_wasm_import_gate.sh as fixtures/wasm_import/
// extern_greeter_optional_main.vibex.
extern effect Greeter {
  greet(String) -> String
}

fn main() -> Unit allows Console + Greeter? {
  match perform? Greeter::greet("vibe") {
    Granted(s) => println("granted: \{s}"),
    NotGranted => println("not granted"),
    Errored(e) => println("errored: \{e}")
  }
}
