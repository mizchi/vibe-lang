// #3053 control: the same closed argument, and an argument the syntactic
// test does not judge (a callee formal), still authorize.
effect State[S] {
  Get() -> S
}

fn g(x: Array[Int]) -> Int with State[Array[Int]] {
  1
}

fn h[T](x: T) -> Int with State[T] {
  1
}

fn caller() -> Int with State[Array[Int]] {
  g([1]) + h([2])
}
