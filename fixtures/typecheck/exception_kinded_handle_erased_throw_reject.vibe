// #2985 review (Codex P0): a kinded handler arm catches EVERY exception at
// run time (the channel carries no kind), so a throw whose kind the checker
// cannot resolve must not sit under it: before, the array literal's throw was
// admitted through the erased gradual rule, `Exception[String]::Throw(s)`
// bound `s` at String, and `String::length(s)` on the array printed `473`.
fn main() -> Int {
  handle {
    throw([1])
  } with { Exception[String]::Throw(s) => String::length(s) }
}
