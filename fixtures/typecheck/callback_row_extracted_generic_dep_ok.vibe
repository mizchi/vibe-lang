// #3372: a generic callee retains callback row binders after value extraction.
export effect Box[T] {
  Put(T) -> Int
}
export struct Wrap[T] { v: T }
export fn mk_wrap[T](v: T) -> Wrap[T] {
  Wrap::{ v: v }
}
export fn run_wrap[T](x: T, f: () -> Int with Box[Wrap[T]], len: (T) -> Int) -> Int {
  handle {
    f()
  } with { Box::Put(w) => {
    let q: Wrap[T] = w; resume(len(q.v) + len(x) * 0)
  } }
}
export fn run_swapped[A, B](b: B, a: A, f: () -> Int with Box[Wrap[A]], len: (A) -> Int) -> Int {
  handle {
    f()
  } with { Box::Put(w) => {
    let q: Wrap[A] = w; resume(len(q.v) + len(a) * 0)
  } }
}

export fn first[A, B](a: A, b: B, f: () -> Int with Box[Wrap[A]]) -> Int {
  handle {
    f()
  } with { Box::Put(w) => {
    let q: Wrap[A] = w; resume(42)
  } }
}
export fn second[A, B](b: B, a: A, f: () -> Int with Box[Wrap[A]]) -> Int {
  handle {
    f()
  } with { Box::Put(w) => {
    let q: Wrap[A] = w; resume(42)
  } }
}
