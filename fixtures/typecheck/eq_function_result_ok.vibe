//# #3549 (accepted control): what the refusal asks for instead. Comparing the
//# values two closures compute, testing an optional function with `is` or
//# against `None` itself, comparing with a payload-less constructor of an enum
//# whose other variant holds a function (the variant decides, no payload is
//# compared), a struct that holds a function but writes its own `equals` over
//# an id field, and a phantom type argument (no value of it is compared) all
//# still check.
enum Step {
  Run((Int) -> Int);
  Stop
}
struct Handler {
  id: Int;
  run: (Int) -> Int
}

fn Handler::equals(a: Handler, b: Handler) -> Bool {
  a.id == b.id
}

struct Tagged[T] {
  n: Int
}

export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let g = (x: Int) -> x + 1
  let o: Option[(Int) -> Int] = Some(f)
  let h1 = Handler::{ id: 1, run: f }
  let h2 = Handler::{ id: 1, run: g }
  let t1: Tagged[(Int) -> Int] = Tagged::{ n: 1 }
  let t2: Tagged[(Int) -> Int] = Tagged::{ n: 1 }
  let st = Step::Run(f)
  if f(1) == g(1) && o is Some(_) && o != None && st != Step::Stop && h1 == h2 && t1 == t2 {
    1
  } else {
    0
  }
}
