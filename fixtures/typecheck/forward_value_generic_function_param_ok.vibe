// #3493: function parameters retain their declared abstraction.
// #3536: the abstraction is spelled `[T] ... Box[T]`; a bare `Box` in a
// signature is refused, since it resolved to a wildcard.
struct Box[T] { value: T }
fn go[T](box: Box[T], n: Int) -> Int {
  if n == 0 {
    0
  } else {
    go(box, n - 1)
  }
}
fn main() -> Int {
  go(Box::{ value: 5 }, 2)
}
