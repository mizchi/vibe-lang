// #3360 (Codex on #3473): an imported `TaskGroup::run` body returns a handle
// it spawned, declared `-> TaskHandle[Int]` so the type does not show the
// group. Its summary records that its group reaches its result, so the run's
// result is judged as carrying the group, as for a body of this module.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_import_dep_ok.vibe { spawn_body }

fn main() -> Unit allows Exception + Console {
  let h = TaskGroup::run(spawn_body)
  println("after=\{TaskHandle::join(h)}")
}
