// #3594: one branch names a declaration whose field closure throws, the
// other is a literal whose field closure does not; the declaration is
// followed.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

let c = true

let make: () -> Box with Exception[Int] = if c {
  mk
} else {
  () -> Box::{ f: () -> 1 }
}

fn main() -> Unit allows Console {
  let b = handle {
    make()
  } with { Exception[Int]::Throw(x) => Box::{ f: () -> x } }
  let f = b.f
  println("\{f()}")
}
