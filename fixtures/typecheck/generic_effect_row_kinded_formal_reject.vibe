// #3275 follow-up (Codex on #3315): a row that names the function's own
// constructor formal (`with Read[G]` in `fn producer[G[_]]`) fixes the payload
// of `Read::Put(F[Int])` at `G[Int]`, so an `Option[Int]` is refused here. A
// first cut of the kinded row arm left a formal fresh, which checked this
// clean; `producer([1, 2, 3])` then handed the option to a `Read[Array]` arm
// that read it as an array.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

fn producer[G[_]](xs: G[Int]) -> Int with Read[G] {
  perform Read::Put(Some(1))
}

fn main allows Console {
  let r = handle { producer([1, 2, 3]) } with {
    Read::Put(xs) => {
      let a: Array[Int] = xs
      resume(Array::length(a))
    }
  }
  println("r=\{r}")
}
