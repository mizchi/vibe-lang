// #4050 control: a loop over an outer container that only READS its
// elements inside the region is accepted.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in boxes {
      let _ = Array::length(a)
    }
    1
  }
  v * 10 + Array::length(outer)
}
