// #3036: the imported trait `Gauge` carries `impl Gauge for Err` on
// dup_type_a_dep_ok's `Err`, and `Err` is imported from dup_type_b_dep_ok, a
// different declaration. Dispatching on b's value would run a's
// implementation through a's layout.
import ./dup_type_trait_target_mid_dep_ok.vibe { trait Gauge }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> Int {
  Gauge::gauge(Err::{ name: "x" })
}
