// #3588: an `Int` task's handle passed where the elided `TaskHandle[String]`
// is declared. `spawn` returns the complete spelling, so the argument and the
// parameter differed in argument count and the payload went uncompared.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn take(h: TaskHandle[String]) -> String with Exception[TaskError] {
  TaskHandle::join(h)
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> 7)
    take(h)
  })
  println("len=\{String::length(r)}")
}
