//# #3326 review: an imported struct spelled like a compiler-owned head (here
// `Task`) is the dependency's struct, so it may not be passed where an
// `Array` is declared -- it would be read as one.

import ./user_owned_head_dep_ok.vibe {
  Task
}

fn total(xs: Array[Int]) -> Int {
  Array::length(xs)
}

fn main() -> Unit allows Console {
  println(__to_string(total(Task::{ v: 2 })))
}
