// #3551 review: an impl method may name its OWN target bare where the trait
// erases the target's formals, but a formal's spelling is no provenance.
// `Victim`'s formal shares the trait's `A`, so a bare `Victim` here got no
// arity diagnostic, unified with the trait's `Victim[Int]` by name, and
// `x.v` read the `Int` as a `String` (measured: `len=84`).
struct Victim[A] {
  v: A
}

trait Gen[A] {
  f(Self, Victim[Int]) -> String
}

struct P {
  n: Int
}

impl Gen for P {
  f(self, x: Victim) -> String {
    x.v
  }
}

fn main() -> Unit allows Console {
  let s = P::f(P::{ n: 1 }, Victim::{ v: 42 })
  println("len=\{Int::to_string(String::length(s))}")
}
