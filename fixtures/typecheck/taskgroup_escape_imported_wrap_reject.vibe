// #3498: an imported helper's result built over its parameter holds that
// parameter, as a helper declared in this module does
// (`taskgroup_escape_wrap_helper_reject`).
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_wrap_dep_ok.vibe { Cell, Wrap, wrap }

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
