// #3051: `g("x", 1)` binds `A` (f's first formal) to `Int`, so `g` requires
// `Slot[Int]`. The alias's markers must follow `A` into its re-generalized
// quantifier order, not keep `f`'s index (which would read `B`, i.e. String).
import ./generic_row_formal_reorder_dep_ok.vibe { Slot }
import ./generic_row_formal_reorder_mid_dep_ok.vibe { g }

fn caller() -> Int with Slot[String] {
  g("x", 1)
}
