// #3541: the erased `with Exception` row carries the thrown message, a
// `String`: that is what an erased `Exception::Throw(m)` arm reads. `h`
// threw an `Int` under it, and the caller's arm read 5 as a String
// (`len=10`). A payload of another type needs its kind in the row.
fn h() -> Int with Exception {
  throw(5)
}

fn main allows Console {
  let r = handle { h() } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
