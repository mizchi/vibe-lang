// #3408 (Codex on #3409): `mid`'s callees fix `Box` at both `Int` and
// `String`, so a caller must cover both; `Box[String]` alone does not.
effect Box[T] {
  Put(T) -> Int
}
fn int() -> Int with Box {
  perform Box::Put(12345)
}
fn str() -> Int with Box {
  perform Box::Put("abcd")
}
fn mid() -> Int with Box {
  int() + str()
}
fn top() -> Int with Box[String] {
  mid()
}
