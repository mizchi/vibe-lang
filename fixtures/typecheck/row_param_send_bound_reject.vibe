// #3518: not specific to the concurrency package. Any `[T: Send]` whose `T`
// appears under a parameter row the argument's row does not match exactly
// lost its binding, and the bound with it.
fn take[T: Send, e](f: () -> T with Exception + e) -> Int with e {
  0
}

fn main() -> Int {
  take(() -> Some([1, 2]))
}
