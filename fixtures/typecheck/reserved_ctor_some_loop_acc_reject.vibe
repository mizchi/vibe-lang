// #3086 (#3093 review): a `loop (acc = init)` accumulator is a value binder;
// its accumulators reach the check as `let` bindings, so one spelled like the
// built-in `Some` is refused as a binding, once.
fn main() -> Unit {
  let _ = loop (Some = 0) {
    if Some > 3 {
      break(Some)
    } else {
      continue(Some + 1)
    }
  }
}
