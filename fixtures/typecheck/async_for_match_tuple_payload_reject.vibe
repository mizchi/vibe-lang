// #3198 review (Codex): a tuple-annotated name destructured by a match arm
// hands each position's head to its binder.
trait AIter[T] {
  next(Self) -> Future[Option[(T, Self)]]
}

struct Countdown {
  n: Int
}

impl AIter for Countdown {
  next(self) -> Future[Option[(Int, Countdown)]] {
    Future::ready(if self.n > 0 {
      Some((self.n, Countdown::{ n: self.n - 1 }))
    } else {
      None
    })
  }
}

fn total(t: (Int, Countdown)) -> Int {
  let mut acc = 0
  match t {
    (k, c) => {
      for x in c {
        acc = acc + x + k
      }
      ()
    }
  }
  acc
}

fn main() -> Int {
  total((0, Countdown::{ n: 3 }))
}
