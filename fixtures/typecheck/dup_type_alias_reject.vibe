// #3036: an import alias is a synonym for the projected bare name, so it does
// not keep two same-named declarations apart -- measured on main, `B::{ .. }`
// was checked against `A`'s declaration (`B` is not a struct / wrong fields).
import ./dup_type_a_dep_ok.vibe { struct Err as A }
import ./dup_type_b_dep_ok.vibe { struct Err as B }

fn f() -> String {
  let b: B = B::{ name: "n" }
  b.name
}
