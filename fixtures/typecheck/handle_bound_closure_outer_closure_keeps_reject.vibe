// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It is handed to a closure declared before the handle, which
// pushes it into an array that closure captured; no argument of the call
// names that array. `g()` trapped after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

fn main() -> Unit allows Console {
  let saved: Array[() -> Int] = []
  let slot: (() -> Int) -> Unit with Ask = (f: () -> Int) -> Array::push(saved, f)
  handle {
    let h = () -> perform Ask::Get() + 1
    slot(h)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(saved, 0)
  println("g=\{g()}")
}
