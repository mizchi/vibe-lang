// #3625: `Float` carries every builtin impl `Double` does, `Add` included, but
// `+` on an erased formal lowers to `__generic_add`, which adds `Int`s and joins
// `String`s and nothing else: at `Float` it would add the raw representation
// and never round to f32. The bound is refused at `Float` exactly as at
// `Double`, and the message names the edit.
fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn check() -> Float {
  add2(16777216.0f, 1.0f)
}
