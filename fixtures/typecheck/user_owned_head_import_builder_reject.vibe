//# #3326 review: the compiler's own `ArrayBuilder[T]` may flow into an
// `Array` slot (it shares the layout). An imported struct that only shares
// the spelling may not: it is read as an array otherwise.

import ./user_owned_head_dep_ok.vibe {
  ArrayBuilder
}

fn total(xs: Array[Int]) -> Int {
  Array::length(xs)
}

fn main() -> Unit allows Console {
  println(__to_string(total(ArrayBuilder::{ v: 2 })))
}
