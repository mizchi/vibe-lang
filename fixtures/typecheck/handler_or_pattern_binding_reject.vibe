// #3301: an or-pattern handler arm cannot bind a payload, as a `match`
// or-pattern cannot. Before the fix the arm was never type-checked and the
// handle compiled to `unreachable`; the message names the edit.
effect Pay {
  P(Int) -> Int
  Q(Int) -> Int
}

fn main() -> Int {
  handle {
    perform Pay::P(1) + perform Pay::Q(2)
  } with Pay {
    P(x)|Q(x) => resume(x * 10)
  }
}
