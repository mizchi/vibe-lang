// #3599: a builder held in a function-typed field names no declaration the
// check can read, so a closure in a declared type's field of what it returns
// is taken to throw what the handle catches. `fac.mk` is `mk`, whose `Box`
// holds a closure that inherited `mk`'s throw; returned as the handle's
// value, `f()` threw with no handler around it.
struct Box {
  f: () -> Int
}

struct Fac {
  mk: () -> Box with Exception[Int]
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn run(fac: Fac) -> Box {
  handle {
    fac.mk()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
}

fn main() -> Unit allows Console {
  let b = run(Fac::{ mk: mk })
  let f = b.f
  println("\{f()}")
}
