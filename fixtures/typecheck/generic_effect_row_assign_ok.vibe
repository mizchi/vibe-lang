// #3417 controls: a reassignment at the binding's own payload is accepted.
effect Box[T] {
  Put(T) -> Int
}

fn g() -> Int with Box[Int] {
  perform Box::Put(12345)
}

fn h() -> Int with Box[String] {
  perform Box::Put("a")
}

fn h2() -> Int with Box[String] {
  perform Box::Put("b")
}

fn run() -> Int with Box[String] {
  let mut f = h
  f = h2
  f = () -> { perform Box::Put("c") }
  let mut k: () -> Int with Box[String] = h2
  k = h
  f() + k()
}
