// #3022 review: a type variable passed where a builtin takes a `Double` is
// bound to `Double`, so a generic wrapper is not instantiated at `Int` and
// then read through Double's boxed representation.
fn convert[T](x: T) -> Int {
  Double::to_int(x)
}

fn main() -> Unit allows Console {
  println("\{convert(1)}")
}
