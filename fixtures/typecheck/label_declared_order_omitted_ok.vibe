// ADR-0120 D2 control: labels in declared order compile, and an optional or
// defaulted slot may be left out anywhere in the list.
fn opt(a: Int, b?: Int, c?: Int) -> Int { a }

fn span(start: Int, mid: Int = 0, end: Int = 10) -> Int { end - start + mid }

fn run() -> Int {
  opt(a = 1, c = 3) + span(start = 2, end = 5) + span(start = 1)
}
