// #3371: every position of a multi-argument operation is a name or `_`.
// With two literals the message binds both and tests them together.
effect Two {
  Add(Int, Int) -> Int
}

fn run() -> Int {
  handle {
    perform Two::Add(1, 3)
  } with {
    Two::Add(1, 2) => resume(100);
    Two::Add(a, b) => resume(a - b)
  }
}
