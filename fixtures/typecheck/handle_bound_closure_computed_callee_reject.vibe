// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The closure-returning function is chosen by an expression
// (`(if c { mk } else { mk2 })()`); the callee's type is the one the
// checker recorded at the call.
effect Ask {
  Get() -> Int
}

fn mk() -> (() -> Int) with Ask {
  () -> perform Ask::Get() + 1
}

fn mk2() -> (() -> Int) with Ask {
  () -> perform Ask::Get() + 2
}

fn main() -> Unit allows Console {
  let c = true
  let g = handle {
    (if c {
      mk
    } else {
      mk2
    })()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
