// #3102 review: `apply`'s row variable `e` resolves at this call to `read`'s
// `State[String]`, which the caller's `with State[T]` does not cover -- `T` is
// the caller's rigid formal, not `String`.
effect State[S] {
  Get() -> S
}

fn read() -> Int with State[String] {
  1
}

fn apply[e](f: () -> Int with e) -> Int with e {
  f()
}

fn caller[T](x: T) -> Int with State[T] {
  apply(read)
}
