// #3276: a local alias of `TaskGroup::run` selects the same branch by type
// (#3153), so the body it is applied to is checked inside a fresh region as
// well, and the field write that leaks the handle is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let nursery = TaskGroup::run
  let r = nursery((g) -> {
    c.v = Some(TaskGroup::spawn(g, () -> { 41 }))
    1
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
