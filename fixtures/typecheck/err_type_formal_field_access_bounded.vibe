//# #2848: a trait bound does not rescue the read. No trait can promise a
//# field -- there is no `HasField` bound -- and a bounded formal is the same
//# unification variable with bounds attached, so it is refused the same way.
//# The message names the binder and the edit; it does not suggest a bound,
//# because there is none to suggest.
struct Crate {
  payload: Int
}

fn read[T: Eq](m: T) -> Int {
  m.payload
}

export fn main() -> Int {
  read(7)
}
