// #3488: a top-level cell wrapped in a record literal is still declared
// outside the body.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

let global_cell = Cell::{ v: None }

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    put(w = Wrap::{ cell: global_cell }, x = TaskGroup::spawn(n, f = () -> { 41 }))
    1
  })
  println("r=\{r}")
}
