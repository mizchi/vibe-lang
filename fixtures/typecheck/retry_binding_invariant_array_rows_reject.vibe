// #3518 review: `T` occurs as `Array[() -> Int with Log]` and as
// `Array[() -> Int with Tick]`. An array is mutable, so its element is
// invariant: typed as an array of `Log + Tick` functions, the `Tick` array
// would accept a `Log` function its holder never handles. No type covers
// both, and the argument is refused with the edit.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn ticked() -> Int with Tick {
  perform Tick::Bump()
  2
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let xs = second(() -> ([logged], [ticked]))
  0
}
