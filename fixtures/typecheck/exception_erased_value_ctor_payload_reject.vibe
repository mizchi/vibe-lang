// #3609: a constructor payload is judged against the annotation's matching
// type argument. A payload typed with the erased row alone carries only
// messages, so `bad`, which lets out an `Int`, is still refused there.
fn bad() -> Int with Exception {
  throw(7)
}

enum Wrap[T] {
  W(T)
}

fn main() -> Unit allows Console {
  let w: Wrap[() -> Int with Exception] = W(bad)
  let r = match w {
    W(f) => handle {
      f()
    } with { Exception::Throw(m) => String::length(m) }
  }
  println("len=\{r}")
}
