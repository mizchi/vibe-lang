// #3180: a `handle` whose body calls a local closure with no effect row, and
// that closure performs the handled effect. The handle is refused -- the
// closure's perform does not reach a handler around the call -- but the
// diagnostic used to say the handle "can never fire ... reaches no perform",
// which is false: it reaches one, through `side`. It now names the call and
// the edit. fixtures/handle_rowless_closure_row_edit_test.vibe runs the edit.
effect Ask {
  Get() -> Int
}

fn ask_once() -> Int with Ask {
  perform Ask::Get()
}

fn run() -> Int with Ask {
  let side = () -> Int {
    perform Ask::Get()
  }
  handle {
    side()
  } with {
    Ask::Get() => resume(42)
  }
}

fn main() -> Int {
  handle {
    run()
  } with {
    Ask::Get() => resume(1)
  }
}
