// #3551 review: an impl for one application of a generic type
// (`impl Hash for Box[Int]`) keys only that application. A `Box[String]`
// field has no key, and the derive refuses it rather than calling the
// `Box[Int]` method with a `Box[String]`.
import @vibe/core {
  has_by
}

struct Box[T] {
  v: T
} derive (Show)

impl Hash for Box[Int] {
  hash_key(self) -> {
    let b: Box[Int] = self
    "b" + Int::to_string(b.v)
  }
}

struct Outer {
  b: Box[String]
} derive (Hash)

fn main() -> Unit allows Console {
  println(Outer::hash_key(Outer::{ b: Box::{ v: "x" } }))
}
