// #3036 (Codex on #3076): `Left` is `Probe` re-exported under an alias, and
// its method takes dup_type_a_dep_ok's `Err`. `Err` is imported here from
// dup_type_b_dep_ok, a different declaration, so the method would read b's
// `{ name: String }` through a's `{ code: Int }` layout.
import ./dup_type_trait_alias_mid_dep_ok.vibe { trait Left }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> Int {
  Left::probe(1, Err::{ name: "x" })
}
