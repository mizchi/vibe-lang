// Codex on #3995: the parameterized form of
// err_trait_ref_alias_expansion_budget.vibe. `A1[T] = (A0[T], A0[T])` ..
// `A24` substitutes its argument into a body that doubles each step, so
// resolving the aliases while building the canonical-key definitions copied
// tens of millions of nodes before the checker's expansion preflight could
// refuse the source. Such an alias is left out of those definitions, so a key
// through it stays as written and the preflight reports it.
type A0[T] = T

type A1[T] = (A0[T], A0[T])

type A2[T] = (A1[T], A1[T])

type A3[T] = (A2[T], A2[T])

type A4[T] = (A3[T], A3[T])

type A5[T] = (A4[T], A4[T])

type A6[T] = (A5[T], A5[T])

type A7[T] = (A6[T], A6[T])

type A8[T] = (A7[T], A7[T])

type A9[T] = (A8[T], A8[T])

type A10[T] = (A9[T], A9[T])

type A11[T] = (A10[T], A10[T])

type A12[T] = (A11[T], A11[T])

type A13[T] = (A12[T], A12[T])

type A14[T] = (A13[T], A13[T])

type A15[T] = (A14[T], A14[T])

type A16[T] = (A15[T], A15[T])

type A17[T] = (A16[T], A16[T])

type A18[T] = (A17[T], A17[T])

type A19[T] = (A18[T], A18[T])

type A20[T] = (A19[T], A19[T])

type A21[T] = (A20[T], A20[T])

type A22[T] = (A21[T], A21[T])

type A23[T] = (A22[T], A22[T])

type A24[T] = (A23[T], A23[T])

trait Mark[A] {}

struct Note {
  n: Int
}

impl Mark[A24[Int]] for Note {}

fn main allows Console {
  println("unreachable")
}
