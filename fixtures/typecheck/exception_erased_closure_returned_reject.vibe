// #3601: a closure literal returned for a result typed with the erased
// `with Exception` row throws an `Int`. Its throw used to be charged to
// `make` itself, and a call of the returned closure carried it as a message.
fn make() -> () -> Int with Exception {
  () -> throw(7)
}

fn main() -> Unit allows Console {
  let f = make()
  let r = handle {
    f()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
