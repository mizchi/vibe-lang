// #3360: an imported helper stores the group's task handle into an array
// declared outside the body. The importer saw only the helper's type, so this
// compiled and the handle outlived its group; the helper's module now
// publishes that `put` keeps its second argument in its first.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_import_dep_ok.vibe { put }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    put(outer, h)
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
