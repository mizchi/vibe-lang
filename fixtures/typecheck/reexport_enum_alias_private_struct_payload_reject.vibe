// #3238 / #3371: the field binder `A` of a struct payload pattern is not a
// bare constructor `A`, so it does not compete with the private enum pattern
// `Api::A` (that used to be a false "rename one of the variants" refusal).
// The payload pattern itself is refused since #3371: neither effect lowering
// destructures a payload, so `A` bound nothing -- this arm never reads it,
// but one that did read an outer binding of the same name (measured: 100
// for a payload of 10). This row pins that the refusal is that one.
import ../import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

struct Payload { A: Int }

effect Logger {
  A(Payload) -> Int
}

fn handle_field() -> Int {
  handle {
    1
  } with { Logger::A(Payload::{ A }) => resume(7) }
}

fn pick() -> Int {
  match Api::A {
    Api::A => 1,
    Api::B => 2
  }
}
