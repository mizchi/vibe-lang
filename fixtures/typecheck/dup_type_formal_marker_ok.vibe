// #3036 control: `touch`'s row mentions its formal `Err`, not the `Err` its
// module re-exports, so importing a different `Err` beside it is no clash.
import ./dup_type_formal_marker_dep_ok.vibe { Probe, touch }
import ./dup_type_b_dep_ok.vibe { Err }

fn caller(e: Err) -> Int with Probe[Err] {
  touch(e)
}
