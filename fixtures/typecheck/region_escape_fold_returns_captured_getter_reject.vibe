// Codex on #4078: as with a top-level getter, a fold callback that returns
// `get()`, a closure over an array declared before the region, makes that
// array the accumulator. 55e4d06d6 printed `kept=true`.
fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let get = () -> sink
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc, value = cell)
      get()
    })
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
