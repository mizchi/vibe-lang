// #3036: `wrap_err` returns dup_type_a_dep_ok's `Err` (through a module that
// imported it), and `Err` is imported from dup_type_b_dep_ok, a different
// declaration. The hop must not make the two look like one.
import ./dup_type_transit_mid_dep_ok.vibe { wrap_err }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> String {
  let e: Err = wrap_err(3)
  e.name
}
