// #3589: an enum value does not carry its row argument (a constructor types
// as the bare enum), so `call_act[e](a: Act[e]) -> Int with e` charged a pure
// caller nothing for the `Console` that `Run(noisy)` performs. An enum row
// parameter is refused at the declaration, naming the struct spelling that
// is tracked.
enum Act[r] {
  Run(() -> Int with r)
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn call_act[e](a: Act[e]) -> Int with e {
  match a {
    Run(g) => g()
  }
}

fn quiet() -> Int {
  call_act(Run(noisy))
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
