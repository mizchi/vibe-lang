// #3518 review: `T` occurs as `Option[?u]` (a `None`) and as
// `Option[() -> Int with Log]`. The open `?u` hid the row, so the first was
// taken, and `?u` was then bound from the effect-stripped second: `T` was
// `Option[() -> Int]` and the pure annotation was accepted. The join gives way
// to the open variable, `?u` is bound from the unstripped join, and the
// annotation is refused.
effect Log {
  Emit(Int) -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let x: Option[() -> Int] = second(() -> (None, Some(logged)))
  0
}
