// #3567: an explicit call of the renderer `derive (Hash)` would imply, on a
// type whose field has no renderer. That renderer is not derived (it would
// call `Inner::to_string`, which does not exist), so the name is unknown at
// check time, rather than reaching code generation unresolved.
struct Inner {
  n: Int
}

impl Hash for Inner {
  hash_key(self: Inner) -> String {
    "i" + Int::to_string(self.n)
  }
}

struct Outer {
  i: Inner
} derive (Hash)

fn render(o: Outer) -> String {
  Outer::to_string(o)
}
