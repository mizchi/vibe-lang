// #3011: a body-level annotation naming an enclosing type formal (`let y: T`)
// resolves `T` to the FORMAL even when an import alias spells the same `T`.
// It resolved to the alias's `Hue`, so `hue_code(y)` type-checked, `f(41)` was
// admitted, and the program trapped inside `hue_code`.
import ./exception_kind_formal_alias_dep.vibe {
  Hue as T, hue_code
}

fn f[T](x: T) -> Int {
  let y: T = x
  hue_code(y)
}

export fn main() -> Int {
  f(41)
}
