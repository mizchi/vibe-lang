// #3275: a local binding's annotation is the lambda's row too, and it
// replaces the enclosing function's: under `() -> Int with Box[String]` the
// lambda's perform sends a `String`, whatever the function's own row says.
effect Box[T] {
  Put(T) -> Int
}

fn producer() -> Int with Box[Int] {
  let g: () -> Int with Box[String] = () -> perform Box::Put(1)
  perform Box::Put(2)
}
