// Sibling module for parse_import_trailing_comma.vibe, whose subject is the
// import list's trailing comma -- the import still has to RESOLVE for the
// parse to be the thing under test.
// #2475 renamed this from `Option`: a declaration at a builtin generic's
// spelling is refused now, and this module's subject is the importer's
// trailing comma, not the name.
export enum Opt[T] {
  Nothing;
  Just(T)
}

export trait Eq

export let value: Int = 1
