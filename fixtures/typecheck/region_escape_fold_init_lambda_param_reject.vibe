// Codex on #4078: a fold's `init` is a parameter of a closure written in the
// region and called with a getter's result. A parameter holds whatever its
// caller passed. b44deee8c printed `kept=true`; main refuses it.
let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let cells = [a]
    let fill = (s: Array[MutList[Int]]) -> {
      let _ = Array::fold(cells, init = s, f = (acc, c) -> {
        Array::push(acc, value = c)
        acc
      })
      1
    }
    fill(get_sink())
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
