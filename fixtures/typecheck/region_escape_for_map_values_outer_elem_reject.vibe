// #4050: iterating the values of an outer Map binds the values it holds.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let m = Map::set(Map::new(), key = "k", value = outer)
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in Map::values(m) {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
