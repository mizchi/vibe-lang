// As with a shadowed field, a fold callback that rebinds `f` to a getter of
// an outer array and returns `Holder::{ items: f() }`: the call was typed
// against the outer `f: () -> Int`. e55476738 printed `kept=true`.
struct Holder {
  items: Array[MutList[Int]]
}

fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let f = () -> 0
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine = Holder::{ items: [] }
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc.items, value = cell)
      let f = () -> sink
      Holder::{ items: f() }
    })
    f()
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
