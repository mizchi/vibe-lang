// #3311 (Codex on #3340): an imported generic callee's callback row naming a
// nominal type around its formal (`Box[Wrap[T]]`) fixes the payload at
// `Wrap[String]` for `run_wrap("abc", ..)`. Before, an imported callee's row
// was read with compiler-owned types only, so `Wrap` handed the lambda
// nothing and `Wrap::{ v: 12345 }` reached an arm measuring `w.v` with
// `String::length`.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_wrap, Wrap
}

fn producer() -> Int with Box {
  run_wrap("abc", () -> {
    perform Box::Put(Wrap::{ v: 12345 })
  }, (s) -> String::length(s))
}
